        1   define variable vss-revision    as character no-undo init "$Revision$":U .
        2   define variable vss-author      as character no-undo init "$Author$":U .
        3   define variable vss-date        as character no-undo init "$Date$":U .
        4   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        5   define variable vss-archive     as character no-undo init "$Archive$":U .
        6   define variable vss-description as character no-undo init "Проведение upgrade".
        7   procedure vss-get-info :
        8     define output parameter p-vss-revision    like vss-revision    no-undo .
        9     define output parameter p-vss-author      like vss-author      no-undo .
       10     define output parameter p-vss-date        like vss-date        no-undo .
       11     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       12     define output parameter p-vss-archive     like vss-archive     no-undo .
       13     define output parameter p-vss-description like vss-description no-undo .
       14     assign
       15       p-vss-revision    = vss-revision
       16       p-vss-author      = vss-author
       17       p-vss-date        = vss-date
       18       p-vss-workfile    = vss-workfile
       19       p-vss-archive     = vss-archive
       20       p-vss-description = vss-description
       21     .
       22   end procedure.
       23   procedure vss-get-parameters :
       24     define output parameter p-vss-parameters as character no-undo .
       25   end procedure.
       26   define new global shared variable g#vssrevis-logger as handle    no-undo .
       27   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       28   define variable v-vssrevis-logger                   as handle    no-undo .
       29   procedure vss-logevent :
       30     define input  parameter p-extra-paramters as character no-undo .
       31     define variable v-vssrevis-parameters as character no-undo .
       32     do
       33     on error undo, return error return-value
       34     :
       35       if  valid-handle(v-vssrevis-logger)
       36       and v-vssrevis-logger :get-signature("logevent") <> ""
       37       then do:
       38         run vss-get-parameters in this-procedure
       39           (output v-vssrevis-parameters
       40           ).
       41         run logevent in v-vssrevis-logger
       42           (input vss-workfile
       43           ,input vss-revision
       44           ,input v-vssrevis-parameters
       45           ,input p-extra-paramters
       46           ).
       47       end.
       48     end.
       49   end procedure.
       50   assign
       51     v-vssrevis-logger = g#vssrevis-logger
       52   .
       53   if  valid-handle(v-vssrevis-logger)
       54   and v-vssrevis-logger :get-signature("logevent") <> ""
       55   then do:
       56     assign
       57       v-vssrevis-logevent = true
       58     .
       59     run vss-logevent in this-procedure (input vss-description) .
       60   end.
       61   define new global shared variable g#language as character no-undo .
       62   if g#language <> '' and g#language <> 'rus':U then do:
       63     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       64   end.
       65   procedure proc-alt-shift-f2:
       66     if not ibs.th.gbl.gbl-var:rcode
       67   then
       68     run gbl\inidebug.p .
       69   end.
       70   procedure proc-alt-shift-f3:
       71     run gbl/prvssinf.p
       72       ( input this-procedure
       73       ) .
       74   end.
       75   define variable v-inform-launched as logical no-undo initial false .
       76   procedure proc-alt-shift-f4:
       77     define variable v-action as character no-undo .
       78     if v-inform-launched = false then do:
       79       assign
       80         v-inform-launched = true
       81       .
       82       run gbl/d-inform.w
       83         (  input self
       84         ,  input this-procedure
       85         , output v-action
       86         ) no-error .
       87       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       88       assign
       89         v-inform-launched = false
       90       .
       91     end.
       92   end.
       93   procedure proc-alt-f1:
       94     run gbl/corrhelp.p
       95       (input this-procedure
       96       ) .
       97   end .
       98   on alt-shift-f2 anywhere do:
       99     run proc-alt-shift-f2.
      100   end.
      101   on alt-shift-f3 anywhere do:
      102     run proc-alt-shift-f3 in this-procedure .
      103   end.
      104   on alt-shift-f4 anywhere do:
      105     run proc-alt-shift-f4 in this-procedure.
      106   end.
      107   on alt-f1 anywhere do:
      108     run proc-alt-f1 in this-procedure .
      109   end.
      110   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      111   procedure cur-time :
      112      define output parameter p-today as date      no-undo .
      113      define output parameter p-time  as integer   no-undo .
      114     do
      115     on error undo, return error
      116     :
      117       define variable v-date1 as date      no-undo .
      118       define variable v-date2 as date      no-undo .
      119       define variable v-time  as integer   no-undo .
      120       assign
      121         v-date1 = today
      122         v-time  = time
      123         v-date2 = today
      124       .
      125       if v-date1 <> v-date2
      126       then do:
      127         assign
      128           v-date1 = today
      129           v-time  = v-time
      130         .
      131       end.
      132       assign
      133         p-today = v-date1
      134         p-time  = v-time
      135       .
      136     end.
      137   end.
      138   function cur-time-date returns character
      139   :
      140     return string(today, '99/99/9999':U) .
      141   end.
      142   function cur-time-mjd returns decimal
      143   :
      144     define variable v-date as date      no-undo .
      145     define variable v-time as integer   no-undo .
      146     run cur-time in this-procedure
      147       (output v-date
      148       ,output v-time
      149       ) .
      150     return integer(v-date) - 2400002 + (v-time / 86400) .
      151   end.
      152   function cur-time-get-ending-index returns integer
      153   (input p-number as integer
      154   )
      155   :
      156     if p-number < 0
      157     or p-number = ?
      158     then do:
      159       return 1 .
      160     end.
      161     define variable v-rest as integer   no-undo .
      162     assign
      163       p-number = p-number modulo 100
      164     .
      165     if p-number < 20
      166     then do:
      167       assign
      168         v-rest = p-number
      169       .
      170     end.
      171     else do:
      172       assign
      173         v-rest = p-number modulo 10
      174       .
      175     end.
      176     case v-rest :
      177       when 1
      178       then do:
      179         return 2 .
      180       end.
      181       when 2 or
      182       when 3 or
      183       when 4
      184       then do:
      185         return 3 .
      186       end.
      187       otherwise do:
      188         return 1 .
      189       end.
      190     end case .
      191   end.
      192   procedure cur-time-mjd-to-date :
      193      define input  parameter i-mjd-diff as decimal no-undo.
      194      define output parameter o-Date     as date    no-undo.
      195      define output parameter o-Time     as integer no-undo.
      196      define variable v-day-number as integer   no-undo .
      197      if    i-mjd-diff < 0
      198         or i-mjd-diff = ?
      199      then do:
      200         return "?" .
      201      end.
      202      assign
      203         v-day-number = truncate(i-mjd-diff,0).
      204         o-Date = date(v-day-number + 2400002).
      205         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      206     .
      207   end.
      208   function cur-time-mjd-to-string returns character
      209   (input p-mjd-diff as decimal
      210   )
      211   :
      212     define variable v-day-number as integer   no-undo .
      213     define variable v-seconds    as integer   no-undo .
      214     define variable v-hour       as integer   no-undo .
      215     define variable v-min        as integer   no-undo .
      216     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      217     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      218     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      219     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      220     if p-mjd-diff < 0
      221     or p-mjd-diff = ?
      222     then do:
      223       return "?" .
      224     end.
      225     assign
      226       v-day-number = integer(truncate(p-mjd-diff,0))
      227       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      228     .
      229     if v-seconds > 86400
      230     then do:
      231       assign
      232         v-seconds = 86400 - 1
      233       .
      234     end.
      235     if v-seconds < 0
      236     then do:
      237       assign
      238         v-seconds = 0
      239       .
      240     end.
      241     assign
      242       v-hour = truncate(v-seconds / 3600, 0)
      243     .
      244     assign
      245       v-seconds = v-seconds modulo 3600
      246     .
      247     assign
      248       v-min = truncate(v-seconds / 60, 0)
      249     .
      250     assign
      251       v-seconds = v-seconds modulo 60
      252     .
      253     return
      254         (if v-day-number <> 0
      255           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      256           else ""
      257         )
      258       + (if v-day-number <> 0 or v-hour <> 0
      259           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      260           else ""
      261         )
      262       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      263           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      264           else ""
      265         )
      266       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      267       .
      268   end.
      269   function cur-time-string returns character
      270   :
      271     define variable v-date as date      no-undo .
      272     define variable v-time as integer   no-undo .
      273     run cur-time in this-procedure
      274       (output v-date
      275       ,output v-time
      276       ) .
      277     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      278   end.
      279   function cur-time-string-sec returns character
      280   :
      281     define variable v-date as date      no-undo .
      282     define variable v-time as integer   no-undo .
      283     run cur-time in this-procedure
      284       (output v-date
      285       ,output v-time
      286       ) .
      287     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      288   end.
      289   function cur-time-custom  returns character
      290   (input p-prefix as character
      291   ,input p-date-format as character
      292   ,input p-delimiter as character
      293   ,input p-time-format as character
      294   ,input p-suffix as character
      295   )
      296   :
      297     define variable v-date as date      no-undo .
      298     define variable v-time as integer   no-undo .
      299     run cur-time in this-procedure
      300       (output v-date
      301       ,output v-time
      302       ) .
      303     return
      304       p-prefix
      305       + string(v-date, p-date-format)
      306       + p-delimiter
      307       + string(v-time, p-time-format)
      308       + p-suffix
      309       .
      310   end.
      311   function cur-time-print  returns character
      312   :
      313     define variable v-date as date      no-undo .
      314     define variable v-time as integer   no-undo .
      315     run cur-time in this-procedure
      316       (output v-date
      317       ,output v-time
      318       ) .
      319     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      320   end.
      321   function cur-time-datetime returns datetime
      322   :
      323     define variable v-char as character no-undo .
      324     define variable v-datetime as datetime no-undo .
      325     v-char = cur-time-string().
      326     v-datetime = datetime(v-char).
      327     return  v-datetime.
      328   end.
      329   function cur-time-string-msec returns character
      330   :
      331     define variable v-date as datetime  no-undo .
      332     v-date = now.
      333     return string(v-date) .
      334   end.
      335   define variable log-exit as logical no-undo .
      336   DEFINE BUTTON b-help
      337        LABEL "Помо&щь"
      338        SIZE 10 BY 1
      339        BGCOLOR 8 .
      340   DEFINE BUTTON b-quit AUTO-END-KEY
      341        LABEL "&Выход"
      342        SIZE 10 BY 1
      343        BGCOLOR 8 .
      344   DEFINE BUTTON b-start AUTO-GO DEFAULT
      345        LABEL "&Запуск"
      346        SIZE 10 BY 1.
      347   DEFINE BUTTON b-unblock DEFAULT
      348        LABEL "&Разблокировка пользователей"
      349        SIZE 30 BY 1.
      350   DEFINE VARIABLE bp-date AS DATE FORMAT "99/99/9999":U
      351        LABEL "Дата"
      352         VIEW-AS TEXT
      353        SIZE 11 BY .67 NO-UNDO.
      354   DEFINE VARIABLE bp-step AS INTEGER FORMAT "9":U INITIAL 0
      355        LABEL "Шаг"
      356         VIEW-AS TEXT
      357        SIZE 2 BY .67 NO-UNDO.
      358   DEFINE VARIABLE bp-time AS CHARACTER FORMAT "X(5)":U
      359        LABEL "Время"
      360         VIEW-AS TEXT
      361        SIZE 6 BY .67 NO-UNDO.
      362   DEFINE RECTANGLE RECT-4
      363        EDGE-PIXELS 3 GRAPHIC-EDGE  NO-FILL
      364        SIZE 33.13 BY 3.58.
      365   DEFINE RECTANGLE RECT-5
      366        EDGE-PIXELS 3 GRAPHIC-EDGE  NO-FILL
      367        SIZE 33.13 BY 1.75.
      368   DEFINE FRAME upg-btpr
      369        b-quit AT ROW 1.17 COL 2
      370        b-help AT ROW 1.17 COL 12
      371        b-start AT ROW 2.96 COL 4.38
      372        b-unblock AT ROW 6.54 COL 3.38
      373        bp-date AT ROW 3 COL 21 COLON-ALIGNED
      374        bp-time AT ROW 4 COL 21 COLON-ALIGNED
      375        bp-step AT ROW 5.08 COL 21 COLON-ALIGNED
      376        RECT-5 AT ROW 6.13 COL 2.25
      377        RECT-4 AT ROW 2.54 COL 2.25
      378        SPACE(1.24) SKIP(2.25)
      379       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      380            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      381            TITLE "Запуск Upgrade"
      382            CANCEL-BUTTON b-quit.
      383   ASSIGN
      384          FRAME upg-btpr:SCROLLABLE       = FALSE.
      385   ON WINDOW-CLOSE OF FRAME upg-btpr
      386   DO:
      387     APPLY "END-ERROR":U TO SELF.
      388   END.
      389   ON CHOOSE OF b-quit IN FRAME upg-btpr
      390   DO:
      391     assign
      392       log-exit = true
      393     .
      394   END.
      395   ON CHOOSE OF b-start IN FRAME upg-btpr
      396   DO:
      397     define buffer buf_BatchProcess for ub.BatchProcess .
      398     define variable v-curr-date as date    no-undo .
      399     define variable v-curr-time as integer no-undo .
      400     define variable v-date      as date    no-undo .
      401     define variable v-time      as integer no-undo .
      402     run cur-time in this-procedure
      403       ( output v-curr-date
      404         ,output v-curr-time
      405       ) no-error.
      406     if error-status :error then do:
      407       message vss-workfile vss-revision vss-description skip
      408         "Ошибка при определении текущей даты!"
      409         view-as alert-box error.
      410       return no-apply.
      411     end.
      412     assign
      413       v-date = v-curr-date
      414       v-time = v-curr-time
      415     .
      416     do while true
      417     on error undo, return no-apply
      418     :
      419       run adm/d-ed-d-t.w ( input-output v-date
      420                       ,input-output v-time
      421                     ) no-error .
      422       if error-status :error then do:
      423         message vss-workfile vss-revision vss-description skip
      424           "Ошибка при редактировании даты!"
      425           view-as alert-box error.
      426         return no-apply.
      427       end.
      428       if v-date = ?
      429         or v-time = ?
      430       then do:
      431         message "Время запуска не изменено!"
      432           view-as alert-box information.
      433         return no-apply.
      434       end.
      435       if v-date > v-curr-date
      436         or ( v-date = v-curr-date
      437               and v-time >= v-curr-time
      438             )
      439       then do:
      440         assign
      441           v-curr-date = v-date
      442           v-curr-time = v-time
      443         .
      444         leave.
      445       end.
      446       else do:
      447         message vss-workfile vss-revision vss-description skip(1)
      448           "Время запуска не может быть меньше текущего!"
      449           view-as alert-box error.
      450       end.
      451     end.
      452     run upg/upg-edbp.p
      453       ( input "upg":U
      454        ,input 1
      455        ,input 0
      456        ,input "Run":U
      457        ,input "":U
      458        ,input v-curr-date
      459        ,input v-curr-time
      460       ) no-error .
      461     if error-status :error then do:
      462       message vss-workfile vss-revision vss-description skip(1)
      463         "Ошибка при записи времени запуска Upgrade!"
      464         view-as alert-box error.
      465     end.
      466     else do:
      467       message 'Команда на запуск Upgrade отправлена' skip
      468         "и должна быть обработана в течении минуты." skip
      469         view-as alert-box information.
      470     end.
      471   END.
      472   ON CHOOSE OF b-unblock IN FRAME upg-btpr
      473   DO:
      474     define buffer buf_BatchProcess for ub.BatchProcess .
      475     define variable v-curr-date as date    no-undo .
      476     define variable v-curr-time as integer no-undo .
      477     define variable v-log       as logical no-undo .
      478     message
      479       "Вы действительно хотите разблокировать пользователей и прекратить Upgrade?"
      480       view-as alert-box question buttons yes-no update v-log.
      481     if v-log = false then do:
      482       return no-apply.
      483     end.
      484     run cur-time in this-procedure
      485       ( output v-curr-date
      486        ,output v-curr-time
      487       ) no-error.
      488     if error-status :error then do:
      489       message vss-workfile vss-revision vss-description skip
      490         "Ошибка при определении текущей даты!"
      491         view-as alert-box error.
      492       return no-apply.
      493     end.
      494     run upg/upg-clbp.p no-error .
      495     if error-status :error then do:
      496       message vss-workfile vss-revision vss-description skip
      497         "Ошибка при удалении записей о времени запуска Upgrade !"
      498         view-as alert-box error.
      499       return no-apply.
      500     end.
      501     run upg/upg-edbp.p
      502       ( input "upg":U
      503        ,input 0
      504        ,input 0
      505        ,input "Run":U
      506        ,input "":U
      507        ,input v-curr-date
      508        ,input v-curr-time
      509       ) no-error .
      510     if error-status :error then do:
      511       message vss-workfile vss-revision vss-description skip(1)
      512         "Ошибка при записи времени запуска Upgrade!"
      513         view-as alert-box error.
      514     end.
      515     else do:
      516       message 'Команда отправлена' skip
      517         "и должна быть обработана в течении минуты." skip
      518         view-as alert-box information.
      519     end.
      520   END.
      521   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      522   on help of frame upg-btpr
      523   do:
      524     run gbl/app_help.p
      525       (input this-procedure :file-name
      526       ,input ''
      527       ,input ?
      528       ) no-error.
      529     if error-status :error then do:
      530       message
      531         "Ошибка при вызове помощи"
      532         error-status :get-message(1)
      533         view-as alert-box .
      534     end.
      535   end.
      536   run minbtn-set in this-procedure .
      537   on choose of b-help in frame upg-btpr
      538   do:
      539     apply "help":u to frame upg-btpr .
      540   end.
      541   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      542   procedure minbtn-set :
      543       do
      544           on error undo, return error return-value
      545           :
      546           define variable ii              as integer       no-undo .
      547           define variable fh              as widget-handle no-undo .
      548           define variable hh              as widget-handle no-undo .
      549           define variable v-h             as handle        extent 4 no-undo .
      550           define variable v-name-button   as character     no-undo .
      551           define variable v-help-old-x    as decimal       no-undo .
      552           define variable v-help-old-y    as decimal       no-undo .
      553           define variable v-help-old-size as decimal       no-undo .
      554           define variable v-frame-width   as decimal       no-undo .
      555           define variable jj              as integer       no-undo .
      556           do
      557               on error undo, return error
      558               :
      559               assign
      560                   v-frame-width = frame upg-btpr:width - 0.3
      561                   fh            = frame upg-btpr:first-child
      562                   hh            = fh:first-child
      563                   ii            = 1
      564                   .
      565               do while valid-handle(hh):
      566                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      567                   do:
      568                       case lc(hh:name) :
      569                           when "b-help" then
      570                               do:
      571                                   hh:load-image-up("cmp/b-help.bmp":u) .
      572                                   hh:load-image-down("cmp/b-help.bmp":u) .
      573                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      574                                   hh:TOOLTIP = "Помощь" .
      575                                   v-help-old-x = hh:column .
      576                                   v-help-old-y = hh:row    .
      577                                   v-help-old-size = hh:width .
      578                                   hh:width-chars = 2.5 .
      579                               end.
      580                           when "b-print" then
      581                               do:
      582                                   hh:load-image("cmp/b-print.bmp":u) .
      583                                   hh:TOOLTIP = "Печать" .
      584                                   v-h[ii] = hh:handle .
      585                                   ii = ii + 1 .
      586                                   hh:width-chars = 3 .
      587                               end.
      588                           when "b-history" or
      589                           when "b-hist" then
      590                               do:
      591                                   hh:load-image("cmp/b-hist.bmp":u) .
      592                                   hh:TOOLTIP = "История" .
      593                                   v-h[ii] = hh:handle .
      594                                   ii = ii + 1 .
      595                                   hh:width-chars = 3 .
      596                               end.
      597                           when "b-sch" then
      598                               do:
      599                                   hh:load-image("cmp/b-sch.bmp":u) .
      600                                   hh:TOOLTIP = "Установка Фильтра" .
      601                                   v-h[ii] = hh:handle .
      602                                   ii = ii + 1 .
      603                                   hh:width-chars = 3 .
      604                               end.
      605                           when "b-hist-user" then
      606                               do:
      607                                   hh:load-image("cmp/b-hist.bmp":u) .
      608                                   hh:TOOLTIP = "История пользователя" .
      609                                   ii = ii + 1 .
      610                               end.
      611                       end case.
      612                   end.
      613                   hh = hh:next-sibling.
      614               end.
      615               b-help:column = v-frame-width - b-help:width-chars.
      616               jj = 0.
      617               repeat ii = 4 to 1 by -1 :
      618                   if valid-handle (v-h[ii] ) then
      619                   do:
      620                       jj  = jj + 1 .
      621                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      622                       v-h[ii]:row    = v-help-old-y .
      623                   end.
      624               end.
      625           end.
      626       end.
      627   end procedure.
      628   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME upg-btpr:PARENT eq ?
      629   THEN FRAME upg-btpr:PARENT = ACTIVE-WINDOW.
      630   MAIN-BLOCK:
      631   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      632      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      633     RUN enable_UI.
      634     define buffer buf_BatchProcess for BatchProcess .
      635     define variable v-curr-date as date    no-undo .
      636     define variable v-curr-time as integer no-undo .
      637     assign
      638       log-exit = false
      639     .
      640     RUN enable_UI.
      641     do while not log-exit
      642     on error undo, return error
      643     :
      644       run cur-time in this-procedure
      645         ( output v-curr-date
      646          ,output v-curr-time
      647         ) no-error.
      648       if error-status :error then do:
      649         message vss-workfile vss-revision vss-description skip
      650           "Ошибка при определении текущей даты!"
      651           view-as alert-box error.
      652         next.
      653       end.
      654       find first buf_BatchProcess no-lock
      655         where buf_BatchProcess.BP_Type     = 'autoupg':U
      656           and buf_BatchProcess.Key#_One    = 0
      657           and buf_BatchProcess.CharKey_One = "upg":U
      658         no-error
      659       .
      660       if available buf_BatchProcess then do:
      661         if buf_BatchProcess.Key#_Three = 1 then do:
      662           enable b-unblock with frame upg-btpr.
      663         end.
      664         assign
      665           bp-date = buf_BatchProcess.BP_ExecSysDate
      666           bp-time = buf_BatchProcess.BP_ExecSysTime
      667           bp-step = buf_BatchProcess.Key#_Three
      668         .
      669         if buf_BatchProcess.BP_ExecSysDate < v-curr-date
      670           or ( buf_BatchProcess.BP_ExecSysDate = v-curr-date
      671                and buf_BatchProcess.BP_ExecSysTimeInt < v-curr-time
      672              )
      673         then do:
      674           disable b-start with frame upg-btpr.
      675         end.
      676       end.
      677       else do:
      678         assign
      679           bp-date = ?
      680           bp-time = ?
      681           bp-step = ?
      682         .
      683       end.
      684       display
      685         bp-date
      686         bp-time
      687         bp-step
      688         with frame upg-btpr
      689       .
      690       wait-for
      691         go of frame upg-btpr
      692         or close of this-procedure
      693         or choose of b-start in frame upg-btpr
      694         or choose of b-unblock in frame upg-btpr
      695         focus frame upg-btpr
      696         pause 1
      697       .
      698     end.
      699   END.
      700   RUN disable_UI.
      701   PROCEDURE disable_UI :
      702     HIDE FRAME upg-btpr.
      703   END PROCEDURE.
      704   PROCEDURE enable_UI :
      705     DISPLAY bp-date bp-time bp-step
      706         WITH FRAME upg-btpr.
      707     ENABLE RECT-5 RECT-4 b-quit b-help b-start b-unblock
      708         WITH FRAME upg-btpr.
      709   END PROCEDURE.
