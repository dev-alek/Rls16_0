        1   block-level on error undo, throw.
        2   define input parameter p-action   as character no-undo .
        3   define input parameter p-step     as integer   no-undo .
        4   define input parameter p-db-num   as integer   no-undo .
        5   define input parameter p-flag     as character no-undo .
        6   define input parameter p-msg      as character no-undo .
        7   define input parameter p-date     as date      no-undo .
        8   define input parameter p-time     as integer   no-undo .
        9   def var vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       10   def var vss-author      as character no-undo init "$Author: expertek $":U .
       11   def var vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       12   def var vss-workfile    as character no-undo init "$Workfile: upg-edbp.p $":U .
       13   def var vss-archive     as character no-undo init "$Archive: upg/upg-edbp.p $":U .
       14   def var vss-description as character no-undo init "создание и изменение BatchProcess с типом ".
       15   define new global shared variable g#language as character no-undo .
       16   if g#language <> '' and g#language <> 'rus':U then do:
       17     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       18   end.
       19   do
       20   on error undo, return error
       21   :
       22     define variable v-ret-val as character no-undo .
       23     define variable v-write   as logical   no-undo .
       24     define buffer buf_BatchProcess for ub.BatchProcess .
       25     assign
       26       v-write = true
       27     .
       28     if p-step <> 0 then do:
       29       find first buf_BatchProcess
       30         where buf_BatchProcess.BP_Type     = 'autoupg':U
       31           and buf_BatchProcess.BP_Status   = 'N':U
       32           and buf_BatchProcess.Key#_One    = p-db-num
       33           and buf_BatchProcess.Key#_Three  = 0
       34           and buf_BatchProcess.CharKey_One = p-action
       35         no-error
       36       .
       37       if available buf_BatchProcess then do:
       38         assign
       39           v-write = false
       40         .
       41       end.
       42     end.
       43     if v-write = true then do:
       44       find first buf_BatchProcess
       45         where buf_BatchProcess.BP_Type     = 'autoupg':U
       46           and buf_BatchProcess.BP_Status   = 'N':U
       47           and buf_BatchProcess.Key#_One    = p-db-num
       48           and buf_BatchProcess.Key#_Three  = p-step
       49           and buf_BatchProcess.CharKey_One = p-action
       50         no-error
       51       .
       52       if not available buf_BatchProcess
       53         and p-flag = "Run":U
       54       then do:
       55         create buf_BatchProcess.
       56         assign
       57           buf_BatchProcess.BatchProcess# = next-value (s-btpr, ub)
       58           buf_BatchProcess.BP_Type       = 'autoupg':U
       59           buf_BatchProcess.BP_Status     = 'N':U
       60           buf_BatchProcess.Key#_One      = p-db-num
       61           buf_BatchProcess.Key#_Three    = p-step
       62           buf_BatchProcess.CharKey_One   = p-action
       63         .
       64       end.
       65       if available buf_BatchProcess then do:
       66         assign
       67           buf_BatchProcess.Key#_Two          = ( if p-flag = "Ok":U then 1 else 0 )
       68           buf_BatchProcess.CharKey_Two       = p-flag
       69           buf_BatchProcess.User_ID           = p-msg
       70           buf_BatchProcess.BP_SysDate        = p-date
       71           buf_BatchProcess.BP_ExecSysDate    = p-date
       72           buf_BatchProcess.BP_SysTimeInt     = p-time
       73           buf_BatchProcess.BP_SysTime        = string(p-time, 'HH:MM:SS':U)
       74           buf_BatchProcess.BP_ExecSysTimeInt = p-time
       75           buf_BatchProcess.BP_ExecSysTime    = string(p-time, 'HH:MM:SS':U)
       76         .
       77         release buf_BatchProcess.
       78       end.
       79     end.
       80     case p-flag :
       81       when "Ok":U then do:
       82         assign
       83           v-ret-val = substitute( "Шаг &1 upgrade в БД &2 выполнен", p-step, p-db-num )
       84         .
       85       end.
       86       when "Err":U then do:
       87         assign
       88           v-ret-val = substitute( "Ошибка при выполнении шага &1 upgrade в БД &2", p-step, p-db-num )
       89         .
       90       end.
       91       when "Run":U then do:
       92         assign
       93           v-ret-val = substitute( "Получена команда на выполнение шага &1 upgrade в БД &2", p-step, p-db-num )
       94         .
       95       end.
       96     end case.
       97   end.
       98   return v-ret-val .
