        1   block-level on error undo, throw.
        2   def var vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        3   def var vss-author      as character no-undo init "$Author: expertek $":U .
        4   def var vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        5   def var vss-workfile    as character no-undo init "$Workfile: upg-clbp.p $":U .
        6   def var vss-archive     as character no-undo init "$Archive: upg/upg-clbp.p $":U .
        7   def var vss-description as character no-undo init "удаление всех записей BatchProcess с типом ".
        8   define new global shared variable g#language as character no-undo .
        9   if g#language <> '' and g#language <> 'rus':U then do:
       10     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       11   end.
       12   do
       13   on error undo, return error
       14   :
       15     define buffer buf_BatchProcess for BatchProcess.
       16     for each buf_BatchProcess
       17       where buf_BatchProcess.BP_Type = 'autoupg':U
       18     on error undo, return error
       19     :
       20       delete buf_BatchProcess .
       21     end.
       22   end.
