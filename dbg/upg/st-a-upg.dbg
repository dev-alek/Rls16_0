        1   block-level on error undo, throw.
        2   define input parameter p-action    as character no-undo .
        3   define input parameter p-step-num  as integer   no-undo .
        4   define input parameter p-db-num    as integer   no-undo .
        5   def var vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        6   def var vss-author      as character no-undo init "$Author: expertek $":U .
        7   def var vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        8   def var vss-workfile    as character no-undo init "$Workfile: st-a-upg.p $":U .
        9   def var vss-archive     as character no-undo init "$Archive: upg/st-a-upg.p $":U .
       10   def var vss-description as character no-undo init "Автоматический запуск выполнения шага upgrade".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       70   procedure cur-time :
       71      define output parameter p-today as date      no-undo .
       72      define output parameter p-time  as integer   no-undo .
       73     do
       74     on error undo, return error
       75     :
       76       define variable v-date1 as date      no-undo .
       77       define variable v-date2 as date      no-undo .
       78       define variable v-time  as integer   no-undo .
       79       assign
       80         v-date1 = today
       81         v-time  = time
       82         v-date2 = today
       83       .
       84       if v-date1 <> v-date2
       85       then do:
       86         assign
       87           v-date1 = today
       88           v-time  = v-time
       89         .
       90       end.
       91       assign
       92         p-today = v-date1
       93         p-time  = v-time
       94       .
       95     end.
       96   end.
       97   function cur-time-date returns character
       98   :
       99     return string(today, '99/99/9999':U) .
      100   end.
      101   function cur-time-mjd returns decimal
      102   :
      103     define variable v-date as date      no-undo .
      104     define variable v-time as integer   no-undo .
      105     run cur-time in this-procedure
      106       (output v-date
      107       ,output v-time
      108       ) .
      109     return integer(v-date) - 2400002 + (v-time / 86400) .
      110   end.
      111   function cur-time-get-ending-index returns integer
      112   (input p-number as integer
      113   )
      114   :
      115     if p-number < 0
      116     or p-number = ?
      117     then do:
      118       return 1 .
      119     end.
      120     define variable v-rest as integer   no-undo .
      121     assign
      122       p-number = p-number modulo 100
      123     .
      124     if p-number < 20
      125     then do:
      126       assign
      127         v-rest = p-number
      128       .
      129     end.
      130     else do:
      131       assign
      132         v-rest = p-number modulo 10
      133       .
      134     end.
      135     case v-rest :
      136       when 1
      137       then do:
      138         return 2 .
      139       end.
      140       when 2 or
      141       when 3 or
      142       when 4
      143       then do:
      144         return 3 .
      145       end.
      146       otherwise do:
      147         return 1 .
      148       end.
      149     end case .
      150   end.
      151   procedure cur-time-mjd-to-date :
      152      define input  parameter i-mjd-diff as decimal no-undo.
      153      define output parameter o-Date     as date    no-undo.
      154      define output parameter o-Time     as integer no-undo.
      155      define variable v-day-number as integer   no-undo .
      156      if    i-mjd-diff < 0
      157         or i-mjd-diff = ?
      158      then do:
      159         return "?" .
      160      end.
      161      assign
      162         v-day-number = truncate(i-mjd-diff,0).
      163         o-Date = date(v-day-number + 2400002).
      164         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      165     .
      166   end.
      167   function cur-time-mjd-to-string returns character
      168   (input p-mjd-diff as decimal
      169   )
      170   :
      171     define variable v-day-number as integer   no-undo .
      172     define variable v-seconds    as integer   no-undo .
      173     define variable v-hour       as integer   no-undo .
      174     define variable v-min        as integer   no-undo .
      175     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      176     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      177     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      178     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      179     if p-mjd-diff < 0
      180     or p-mjd-diff = ?
      181     then do:
      182       return "?" .
      183     end.
      184     assign
      185       v-day-number = integer(truncate(p-mjd-diff,0))
      186       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      187     .
      188     if v-seconds > 86400
      189     then do:
      190       assign
      191         v-seconds = 86400 - 1
      192       .
      193     end.
      194     if v-seconds < 0
      195     then do:
      196       assign
      197         v-seconds = 0
      198       .
      199     end.
      200     assign
      201       v-hour = truncate(v-seconds / 3600, 0)
      202     .
      203     assign
      204       v-seconds = v-seconds modulo 3600
      205     .
      206     assign
      207       v-min = truncate(v-seconds / 60, 0)
      208     .
      209     assign
      210       v-seconds = v-seconds modulo 60
      211     .
      212     return
      213         (if v-day-number <> 0
      214           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      215           else ""
      216         )
      217       + (if v-day-number <> 0 or v-hour <> 0
      218           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      219           else ""
      220         )
      221       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      222           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      223           else ""
      224         )
      225       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      226       .
      227   end.
      228   function cur-time-string returns character
      229   :
      230     define variable v-date as date      no-undo .
      231     define variable v-time as integer   no-undo .
      232     run cur-time in this-procedure
      233       (output v-date
      234       ,output v-time
      235       ) .
      236     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      237   end.
      238   function cur-time-string-sec returns character
      239   :
      240     define variable v-date as date      no-undo .
      241     define variable v-time as integer   no-undo .
      242     run cur-time in this-procedure
      243       (output v-date
      244       ,output v-time
      245       ) .
      246     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      247   end.
      248   function cur-time-custom  returns character
      249   (input p-prefix as character
      250   ,input p-date-format as character
      251   ,input p-delimiter as character
      252   ,input p-time-format as character
      253   ,input p-suffix as character
      254   )
      255   :
      256     define variable v-date as date      no-undo .
      257     define variable v-time as integer   no-undo .
      258     run cur-time in this-procedure
      259       (output v-date
      260       ,output v-time
      261       ) .
      262     return
      263       p-prefix
      264       + string(v-date, p-date-format)
      265       + p-delimiter
      266       + string(v-time, p-time-format)
      267       + p-suffix
      268       .
      269   end.
      270   function cur-time-print  returns character
      271   :
      272     define variable v-date as date      no-undo .
      273     define variable v-time as integer   no-undo .
      274     run cur-time in this-procedure
      275       (output v-date
      276       ,output v-time
      277       ) .
      278     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      279   end.
      280   function cur-time-datetime returns datetime
      281   :
      282     define variable v-char as character no-undo .
      283     define variable v-datetime as datetime no-undo .
      284     v-char = cur-time-string().
      285     v-datetime = datetime(v-char).
      286     return  v-datetime.
      287   end.
      288   function cur-time-string-msec returns character
      289   :
      290     define variable v-date as datetime  no-undo .
      291     v-date = now.
      292     return string(v-date) .
      293   end.
      294   do
      295   on error undo, return error
      296   :
      297     define variable v-str       as character no-undo .
      298     define variable v-curr-date as date      no-undo .
      299     define variable v-curr-time as integer   no-undo .
      300     define variable old-propath as character no-undo .
      301     define variable src-path    as character no-undo .
      302     define variable target-path as character no-undo .
      303     define variable prev-ver    as character no-undo .
      304     define variable ini-path    as character no-undo .
      305     if transaction then do:
      306       message
      307         substitute( "&1. Вызов данной процедуры невозможен при наличии транзакции", vss-workfile )
      308         view-as alert-box error .
      309       return error .
      310     end.
      311     if valid-handle( session :first-procedure) then do:
      312       message
      313         substitute( "&1. Вызов данной процедуры невозможен при наличии определений persistent prosedures", vss-workfile )
      314         view-as alert-box error .
      315       return error .
      316     end.
      317     run init-upgrade ( output src-path
      318                       ,output target-path
      319                       ,output prev-ver
      320                       ,output ini-path
      321                      ).
      322     assign
      323       old-propath = propath
      324       propath = ".,":U + src-path + chr(47) + "upg,":U + src-path + chr(47) + "cust":U
      325     .
      326     run startupg.w ( input p-action
      327                    ,input p-step-num
      328                    ,input prev-ver
      329                    ,input src-path
      330                    ,input target-path
      331                    ,input ini-path
      332                    ,input true
      333                   ) no-error.
      334     assign
      335       propath = old-propath
      336       v-str = return-value
      337     .
      338     if p-step-num = 2 then do:
      339       if error-status :error then do:
      340         message
      341           vss-workfile vss-revision skip
      342           substitute( "Ошибка выполнения шага &1 upgrade в БД", p-step-num, p-db-num ) skip
      343           v-str skip
      344           "Призовая игра"
      345           view-as alert-box error.
      346       end.
      347       else do:
      348         run upg/upg-clbp.p no-error .
      349         if error-status :error then do:
      350           message
      351             vss-workfile vss-revision skip
      352             "Ошибка при удалении записей о времени запуска Upgrade !"
      353             view-as alert-box error.
      354         end.
      355         message
      356           v-str skip
      357           "Необходимо запустить новую версию Автоматической Системы Передачи Новостей"
      358           view-as alert-box information.
      359       end.
      360       quit.
      361     end.
      362     else do:
      363       if error-status :error then do:
      364         return error v-str.
      365       end.
      366       else do:
      367         return v-str.
      368       end.
      369     end.
      370   end.
      371   procedure init-upgrade :
      372     define output parameter p-src-path    as character no-undo .
      373     define output parameter p-target-path as character no-undo .
      374     define output parameter p-prev-ver    as character no-undo .
      375     define output parameter p-ini-path    as character no-undo .
      376     do
      377     on error undo, return error
      378     :
      379       define variable err-msg as character no-undo .
      380       assign
      381         err-msg = "":U
      382       .
      383       get-key-value section "upgrade" key "upg-path" value p-src-path.
      384       if trim( p-src-path ) = "":U or p-src-path = ? then do:
      385         assign
      386           err-msg = (if err-msg = "":U then "":U else chr(10) )
      387                     + "Не задан каталог источник пакета upgrade"
      388         .
      389       end.
      390       get-key-value section "upgrade" key "dir-ver"  value p-target-path.
      391       if trim( p-target-path ) = "":U or p-target-path = ? then do:
      392         assign
      393           err-msg = (if err-msg = "":U then "":U else chr(10) )
      394                     + "Не задан корневой каталог версии"
      395         .
      396       end.
      397       get-key-value section "upgrade" key "prev-ver" value p-prev-ver.
      398       if trim( p-prev-ver ) = "":U or p-prev-ver = ? then do:
      399         assign
      400           err-msg = (if err-msg = "":U then "":U else chr(10) )
      401                     + "Не задан номер версии, с которой производится upgrade"
      402         .
      403       end.
      404       if err-msg <> "":U then do:
      405         run write-to-log( vss-workfile + chr(32)
      406                           + "Ошибка инициализации переменных upgrade" + chr(10)
      407                           + err-msg + chr(10)
      408                           + error-status:get-message(error-status:num-messages)
      409                         ) .
      410         return error.
      411       end.
      412     end.
      413     return.
      414   end procedure.
