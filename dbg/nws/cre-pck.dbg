      503     field dst_db-key      as character
      504     field ver-num         as character
      505     field prev-crc        as character
      506     field actual-date     as date
      507     field actual-time-int as integer
      508   .
      509   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      510   define new global shared variable g#attr-lib  as handle no-undo .
      511   define variable v-attr-lib-variable as handle no-undo .
      512   procedure db-attr-code :
      513     define input  parameter p-code           as character no-undo .
      514     define output parameter p-type           as character no-undo .
      515     define output parameter p-format         as character no-undo .
      516     define output parameter p-label          as character no-undo .
      517     define output parameter p-user-can-edit  as logical   no-undo .
      518     define output parameter p-output-display as logical   no-undo .
      519     define output parameter p-other          as character no-undo .
      520     do
      521     on error undo, return error
      522     :
      523           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run db-attr-code in g#attr-lib
      524         (input  p-code
      525         ,output p-type
      526         ,output p-format
      527         ,output p-label
      528         ,output p-user-can-edit
      529         ,output p-output-display
      530         ,output p-other
      531         ) no-error .
      532       if error-status :error
      533       then do:
      534         undo, return error return-value .
      535       end.
      536     end.
      537   end procedure.
      538   procedure db-attr-tooltip :
      539     define input  parameter p-code    as character no-undo .
      540     define output parameter p-tooltip as character no-undo .
      541     define output parameter p-label   as character no-undo .
      542     do
      543     on error undo, return error
      544     :
      545           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run db-attr-tooltip in g#attr-lib
      546         (input  p-code
      547         ,output p-tooltip
      548         ,output p-label
      549         ) no-error .
      550       if error-status :error
      551       then do:
      552         undo, return error return-value .
      553       end.
      554     end.
      555   end procedure.
      556   procedure db-attr-value :
      557     define input  parameter p-db-num    like ub.db-attr.db-num     no-undo .
      558     define input  parameter p-code      like ub.db-attr.attr-code  no-undo .
      559     define output parameter p-value     like ub.db-attr.attr-value no-undo .
      560     define output parameter p-type      as character no-undo .
      561     do
      562     on error undo, return error
      563     :
      564           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run db-attr-value in g#attr-lib
      565         (input  p-db-num
      566         ,input  p-code
      567         ,output p-value
      568         ,output p-type
      569         ) no-error .
