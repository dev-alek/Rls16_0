      677   end procedure.
      678   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      679   define temp-table temp-lock no-undo
      680     field lock-conn-id   as integer   label "Номер Подключения"
      681     field user-name      as character label "Пользователь"
      682     field lock-flag      as character label "Флаг"
      683     field trans-id       as integer   label "Транзакция"
      684     field trans-txtime   as character
      685     field trans-state    as character
      686     field trans-dur      as integer
      687     field connect-type   as character label "Подключение"
      688     field connect-time   as character format "x(20)"
      689     field connect-device as character format "x(40)" label "Устройство"
      690     .
      691   do
      692   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      693   on stop   undo, return error substitute( "&1. stop", vss-workfile )
      694   on endkey undo, return error substitute( "&1. endkey", vss-workfile )
      695   :
      696     define variable v-pack-num   as integer   no-undo .
      697     define variable v-pack-name  as character no-undo .
      698     define variable v-source-dir as character no-undo .
      699     define variable v-target-dir as character no-undo .
      700     define variable v-temp-dir   as character no-undo .
      701     define variable route-cnt       as integer no-undo .
      702     define variable rec-cnt         as integer no-undo .
      703     define variable qnty-of-cur-rec as integer no-undo .
      704     define variable v-max-pack-size as integer no-undo .
      705     define variable v-today        as date    no-undo .
      706     define variable v-time         as integer no-undo .
      707     define variable v-last-tbl-ord like ub.route.tbl-ord no-undo .
      708     define buffer buf_sys-ctrl for ub.sys-ctrl .
      709     define buffer buf-src_db   for ub.db.
      710     define buffer buf-dst_db   for ub.db.
      711     define buffer buf_route    for ub.route.
      712     define buffer buf_pck-sent for ub.pck-sent .
      713     define variable db-attr-value  as character no-undo .
      714     define variable db-attr-type   as character no-undo .
      715     define variable db-attr-exist  as logical   no-undo .
      716     define variable v-gen-new-pack as logical   no-undo .
      717     define variable v-fst-pck      as integer   no-undo .
      718     define variable v-sys-key  as character no-undo .
      719     define variable mFrameView      as logical   no-undo init yes.
      720     define frame inf
      721       p-db-num    label "для БД" format ">>>>>>>>9"
      722       v-pack-num  label "Пакет N" format ">>>>>>>>9"
      723       route-cnt   label "Основных записей"
      724       rec-cnt     label "Привязанных"
      725       with view-as dialog-box side-labels 1 columns three-d title "** Формирование пакета".
      726     define variable mFramHandle as handle no-undo.
      727     mFramHandle = frame inf:handle.
      728     if  log-manager:logfile-name ne ?
      729     then DO:
      730         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameNWSError").
      731         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameNWSError").
      732     end.
      733   define new global shared variable mBatchMode as logical no-undo init ?.
      734   define variable mFramBachModHandle as handle no-undo.
      735   mFramBachModHandle = frame inf:handle.
      736   define variable mFameOldVis as logical no-undo.
      737   define variable mVisCUrentVin as logical no-undo.
      738   if session:batch-mode
      739   then
      740      mBatchMode = yes.
      741   if mBatchMode = ? then do:
      742     mVisCUrentVin = current-window:visible.
      743     mFameOldVis = mFramBachModHandle:visible.
      744     mFramBachModHandle:visible  = yes.
      745     mBatchMode = mFramBachModHandle:visible ne yes.
      746     mFramBachModHandle:visible = mFameOldVis.
      747     current-window:visible = mVisCUrentVin.
      748   end.
      749    if  log-manager:logfile-name ne ?
      750     then DO:
      751         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      752         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      753         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      754     end.
      755     mFrameView = not mBatchMode.
      756     if transaction then do:
      757       message
      758         vss-workfile vss-revision vss-description skip
      759         substitute( "Вызов данной процедуры невозможен при наличии транзакции" )
      760         view-as alert-box error
      761       .
      762       return error .
      763     end.
      764     assign
      765       v-fst-pck = ?
      766       p-err-gen-pack = 0
      767       v-gen-new-pack = false
      768       p-cre-all-pck  = true
      769     .
      770   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile:currsysk.i $ $Revision: $".
      771   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run currsysk in g#library
      772     (output v-sys-key
      773     ) no-error .
      774     run nws/lock-nws.p
      775       ( input p-db-num
      776       ,buffer buf-dst_db
      777       ) no-error.
      778     if error-status:error then do:
      779       run write-to-log( substitute( "&1. &2", vss-workfile, return-value ) ).
      780       return .
      781     end.
      782     find last buf_route no-lock
      783       where buf_route.db-num = p-db-num
      784         and buf_route.last-pack = -1
      785       no-error
      786     .
      787     if available buf_route then do:
      788       assign
      789         v-last-tbl-ord = buf_route.tbl-ord
      790       .
      791     end.
      792     else do:
      793       assign
      794         v-last-tbl-ord = 0
      795       .
      796     end.
      797     if mFrameView
      798     then do:
      799        view frame inf.
      800        do with frame inf
      801        :
      802          assign
      803            p-db-num :screen-value   = string( p-db-num, p-db-num :format)
      804          .
      805        end.
      806     end.
      807     gen-pack:
      808     do while p-err-gen-pack = 0
      809     on error undo, return error
      810     :
      811       find first buf_route no-lock
      812         where buf_route.db-num = p-db-num
      813           and buf_route.last-pack = -1
      814         no-error
      815       .
      816       run db-attr-exist ( input p-db-num
      817                           ,input 'need-gen-new-pack':U
      818                           ,output db-attr-exist
      819                         ) no-error.
      820       if error-status :error then do:
      821         run write-to-log( substitute("&1. Ошибка при определении наличия атрибута формирования нового пакета для БД &2"
      822                                      ,vss-workfile
      823                                      ,p-db-num
      824                                     )
      825                         ) .
      826         undo, return error.
      827       end.
      828       run db-attr-value ( input p-db-num
      829                           ,input 'need-gen-new-pack':U
      830                           ,output db-attr-value
      831                           ,output db-attr-type
      832                         ) no-error.
      833       if error-status :error then do:
      834         run write-to-log( substitute("&1. Ошибка при чтении атрибута формирования нового пакета для БД &2"
      835                                      ,vss-workfile
      836                                      ,p-db-num
      837                                     )
      838                         ) .
      839         undo, return error.
      840       end.
      841       if ( available buf_route
      842            and buf_route.tbl-ord <= v-last-tbl-ord
      843          )
      844         or db-attr-exist = false
      845         or db-attr-value = "yes":U
      846       then do:
      847         assign
      848           v-pack-num     = -1
      849           v-gen-new-pack = true
      850         .
      851         run db-attr-write ( input p-db-num
      852                           ,input 'need-gen-new-pack':U
      853                           ,input "no":U
      854                           ) no-error.
      855         if error-status :error then do:
      856           run write-to-log( vss-workfile + chr(32)
      857                             + "Ошибка записи атрибута формирования нового пакета для БД" + chr(32)
      858                             + string( p-db-num )
      859                           ) .
      860           assign
      861             p-err-gen-pack = 2
      862           .
      863           undo, return error.
      864         end.
      865       end.
      866       else do:
      867         if v-gen-new-pack = false then do:
      868           run write-to-log( substitute( "Нет новой информации для отправки в БД &1", p-db-num ) ) .
      869         end.
      870         leave gen-pack .
      871       end.
      872       run nws/pck-num.p
      873         ( input "put":U
      874          ,input p-db-num
      875          ,input-output v-pack-num
      876          ,output v-pack-name
      877          ,output v-source-dir
      878          ,output v-target-dir
      879          ,output v-temp-dir
      880         ) no-error.
      881       if error-status:error then do:
      882         run write-to-log( vss-workfile + chr(32)
      883                           + "Ошибка при генерации номера пакета." + chr(10)
      884                           + substitute( "&1", error-status:get-message(error-status:num-messages) ) + chr(10)
      885                           + substitute( "&1", return-value )
      886                         ) .
      887         undo, return error.
      888       end.
      889       if v-fst-pck = ? then do:
      890         assign
      891           v-fst-pck = v-pack-num
      892         .
      893       end.
      894       else do:
      895         if v-pack-num = v-fst-pck + 30 then do:
      896           assign
      897             p-cre-all-pck = false
      898           .
      899           leave gen-pack .
      900         end.
      901       end.
      902       if mFrameView
      903       then do with frame inf:
      904         assign
      905           p-db-num :screen-value   = string( p-db-num, p-db-num :format)
      906           v-pack-num :screen-value = string( v-pack-num, v-pack-num :format)
      907         .
      908       end.
      909       run write-to-log( substitute("Подготовка пакета N &1 для БД N &2", v-pack-num, p-db-num ) ).
      910       find first buf-dst_db
      911         where buf-dst_db.db-num = p-db-num
      912         no-error
      913       .
      914       if not available buf-dst_db then do:
      915         run write-to-log( substitute( "&1. Подготовка пакета прервана. БД &2 не найдена.", vss-workfile, p-db-num ) ).
      916         assign
      917           p-err-gen-pack = 2
      918         .
      919         undo, return error.
      920       end.
      921       find first buf_sys-ctrl no-lock .
      922       find first buf-src_db
      923         where buf-src_db.db-num = buf_sys-ctrl.db-num
      924         no-error
      925       .
      926       if not available buf-src_db then do:
      927         run write-to-log( substitute( "&1. Подготовка пакета прервана. БД &2 не найдена.", vss-workfile, buf_sys-ctrl.db-num ) ).
      928         assign
      929           p-err-gen-pack = 2
      930         .
      931         undo, return error.
      932       end.
      933       if buf_sys-ctrl.db-num = 0 then do:
      934         assign
      935           v-max-pack-size = buf-dst_db.max-p-size
      936         .
      937       end.
      938       else do:
      939         assign
      940           v-max-pack-size = buf-src_db.max-p-size
      941         .
      942       end.
      943       run cur-time( output v-today
      944                    ,output v-time
      945                   ) no-error .
      946       if error-status :error then do:
      947         run write-to-log( vss-workfile + chr(32) + "Ошибка при определении текущей даты!" ) .
      948         assign
      949           p-err-gen-pack = 2
      950         .
      951         undo, return error.
      952       end.
      953       find first ub.pck-sent no-lock
      954         where ub.pck-sent.db-num   = p-db-num
      955           and ub.pck-sent.pack-num = v-pack-num
      956         no-error
      957       .
      958       if available ub.pck-sent then do:
      959         run write-to-log( substitute( "&1. Пакет с номером &2 уже существует.", vss-workfile, v-pack-num ) ) .
      960         assign
      961           p-err-gen-pack = 2
      962         .
      963         undo, return error.
      964       end.
      965       do transaction
      966       on error  undo, return error substitute( "&1 (pck-sent). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      967       on stop   undo, return error substitute( "&1 (pck-sent). stop", vss-workfile )
      968       on endkey undo, return error substitute( "&1 (pck-sent). endkey", vss-workfile )
      969       :
      970         create ub.pck-sent.
      971         assign
      972           ub.pck-sent.CreDate        = v-today
      973           ub.pck-sent.CreTimeInt     = v-time
      974           ub.pck-sent.CreTime        = string( v-time, "HH:MM:SS" )
      975           ub.pck-sent.db-num         = p-db-num
      976           ub.pck-sent.pack-num       = v-pack-num
      977           ub.pck-sent.rcvd           = no
      978           ub.pck-sent.total-recs     = ?
      979           ub.pck-sent.CreNum         = 0
      980           ub.pck-sent.SendTxtDate    = ?
      981           ub.pck-sent.SendTxtTimeInt = 0
      982           ub.pck-sent.SendTxtTime    = "":U
      983           ub.pck-sent.RcvdDate       = ?
      984           ub.pck-sent.RcvdTimeInt    = 0
      985           ub.pck-sent.RcvdTime       = "":U
      986           ub.pck-sent.CRC-pack       = substitute( "&1 &2 &3 &4", today, time, etime, DBTASKID( "ub":U ) )
      987         .
      988       end.
      989       assign
      990         route-cnt = 0
      991         rec-cnt   = 0
      992       .
      993       route-label:
      994       for each buf_route no-lock
      995         where buf_route.db-num    = p-db-num
      996           and buf_route.last-pack = -1
      997         by buf_route.tbl-ord
      998       on error   undo, return error
      999       on end-key undo, return error
     1000       :
     1001         if buf_route.tbl-ord > v-last-tbl-ord then do:
     1002           leave route-label.
     1003         end.
     1004         find ub.route exclusive-lock
     1005           where rowid( ub.route ) = rowid( buf_route )
     1006           no-wait no-error
     1007         .
     1008         if not available ub.route then do:
     1009           if locked ub.route then do:
     1010             run write-to-log( vss-workfile + chr(32)
     1011                               + substitute( "Подготовка пакета прервана на захваченной записи &1", buf_route.name-rec )
     1012                             ).
     1013             if v-sys-key = 'ExpertekIBS':U
     1014             then do:
     1015               run gbl/findlock.p
     1016                 (input  recid( buf_route )
     1017                 ,output table temp-lock
     1018                 ) .
     1019               for each temp-lock
     1020               :
     1021                 run write-to-log( substitute( "Запись захватил пользователь &1", temp-lock.user-name )
     1022                                   + chr(10) + substitute( "Номер подключения - &1":U, temp-lock.lock-conn-id )
     1023                                   + chr(10) + substitute( "Флаги             - &1":U, temp-lock.lock-flag )
     1024                                   + chr(10) + substitute( "Номер транзакции  - &1":U, temp-lock.trans-id )
     1025                                   + chr(10) + substitute( "Тип подключения   - &1":U, temp-lock.connect-type )
     1026                                   + chr(10) + substitute( "Устройство        - &1":U, temp-lock.connect-device )
     1027                                 ).
     1028               end.
     1029             end.
     1030           end.
     1031           else do:
     1032             run write-to-log( vss-workfile + chr(32)
     1033                               + substitute( "Подготовка пакета прервана на отсутствующей записи &1", buf_route.name-rec )
     1034                             ).
     1035           end.
     1036           assign
     1037             p-err-gen-pack = 1
     1038           .
     1039           leave route-label.
     1040         end.
     1041         if ub.route.num-dump = 0 then do:
     1042           assign
     1043             qnty-of-cur-rec = 1
     1044           .
     1045         end.
     1046         else do:
     1047           assign
     1048             qnty-of-cur-rec = ub.route.num-dump
     1049           .
     1050         end.
     1051         assign
     1052           route-cnt = route-cnt + 1
     1053           rec-cnt = rec-cnt + qnty-of-cur-rec
     1054         .
     1055         if rec-cnt <> qnty-of-cur-rec
     1056           and rec-cnt > v-max-pack-size
     1057         then do:
     1058           leave route-label.
     1059         end.
     1060         if mFrameView
     1061         then do with frame inf
     1062         :
     1063           assign
     1064             p-db-num :screen-value   = string( p-db-num, p-db-num :format)
     1065             v-pack-num :screen-value = string( v-pack-num, v-pack-num :format)
     1066             route-cnt :screen-value  = string( route-cnt, route-cnt :format)
     1067             rec-cnt :screen-value  = string( rec-cnt - route-cnt, rec-cnt :format)
     1068           .
     1069         end.
     1070         assign
     1071           ub.route.last-pack = v-pack-num
     1072         .
     1073       end.
     1074       do transaction
     1075       on error  undo, return error substitute( "&1 (pck-sent). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1076       on stop   undo, return error substitute( "&1 (pck-sent). stop", vss-workfile )
     1077       on endkey undo, return error substitute( "&1 (pck-sent). endkey", vss-workfile )
     1078       :
     1079         find first ub.pck-sent exclusive-lock
     1080           where ub.pck-sent.db-num   = p-db-num
     1081             and ub.pck-sent.pack-num = v-pack-num
     1082           no-error
     1083         .
     1084         if not available ub.pck-sent then do:
     1085           run write-to-log( substitute( "&1. Отсутствует шапка пакета с номером &2!", vss-workfile, v-pack-num ) ) .
     1086           assign
     1087             p-err-gen-pack = 2
     1088           .
     1089           undo, return error.
     1090         end.
     1091         assign
     1092           ub.pck-sent.total-recs = route-cnt
     1093         .
     1094       end.
     1095     end.
     1096     if mFrameView
     1097     then
     1098        hide frame inf.
     1099   end.
