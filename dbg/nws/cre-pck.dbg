      576   procedure db-attr-write :
      577     define input parameter p-db-num    like ub.db-attr.db-num     no-undo .
      578     define input parameter p-code      like ub.db-attr.attr-code  no-undo .
      579     define input parameter p-value     like ub.db-attr.attr-value no-undo .
      580     do
      581     on error undo, return error
      582     :
      583           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run db-attr-write in g#attr-lib
      584         (input p-db-num
      585         ,input p-code
      586         ,input p-value
      587         ) no-error .
      588       if error-status :error
      589       then do:
      590         undo, return error return-value .
