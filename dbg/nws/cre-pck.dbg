      596     define input  parameter p-code      like ub.db-attr.attr-code  no-undo .
      597     define output parameter p-exist    as logical  no-undo .
      598     do
      599     on error undo, return error
      600     :
      601           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run db-attr-exist in g#attr-lib
      602         (input  p-db-num
      603         ,input  p-code
