     2322           buf_pck-sent.SendTxtTime    = string( v-time, "HH:MM:SS" )
     2323           .
     2324   def var vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2325     export stream ddl substitute( "&1&2&3&2&4&2&5&2&6&2&7&2&8&2&9", 'pck-sent', chr(1), '', '', '', '', 0, 0, rec-cnt) .
     2326       run nws-exp in this-procedure
     2327         ( input (buffer buf_pck-sent:handle)
     2328         ) .
     2329       end.
     2330       assign
     2331         rec-cnt               = rec-cnt + 1
     2332         t-pck-conf.total-recs = rec-cnt
     2333         .
     2334   def var vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2335     export stream ddl substitute( "&1&2&3&2&4&2&5&2&6&2&7&2&8&2&9", 'pck-conf', chr(1), '', '', '', '', 0, 0, rec-cnt) .
     2336       run nws-exp in this-procedure
     2337         ( input (buffer t-pck-conf:handle)
     2338         ) .
     2339     end.
     2340     delete t-pck-conf.
     2341   def var vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2342     export stream ddl '**END OF PACKET**':U .
     2343     output stream ddl close.
     2344     if v-err <> 0 then do:
     2345       run all-gates-clear in this-procedure ( buffer buf_temp-xml-tables).
     2346       undo, return error.
     2347     end.
     2348     else do:
     2349       run gbl/ren-file.p
     2350         ( input v-tmp-file
     2351          ,input v-pck-full-name
     2352         ) no-error .
     2353       if error-status :error then do:
     2354         run write-to-log( vss-workfile + chr(32) + substitute( "&1", return-value ) ).
     2355         return error return-value .
     2356       end.
     2357       return .
     2358     end.
     2359   end.
     2360   if mFrameView
     2361   then
     2362      hide frame exp-pck.
