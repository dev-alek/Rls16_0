      680   def var vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      681     define stream ddl.
      682     procedure nws-exp :
      683       define input  parameter p-tbl-handle as handle    no-undo .
      684       do
      685       on error  undo, return error substitute( "&1 (nws-exp). &2&3&4", vss-include-info4, return-value, chr(10), error-status :get-message ( 1 ) )
      686       on stop   undo, return error substitute( "&1 (nws-exp). stop", vss-include-info4 )
      687       on endkey undo, return error substitute( "&1 (nws-exp). endkey", vss-include-info4 )
      688       :
      689         define variable v-num-fields as integer   no-undo .
      690         define variable v-ind        as integer   no-undo .
      691         define variable v-fh         as handle    no-undo .
      692         define variable v-str        as character no-undo .
      693         assign
      694           v-num-fields = p-tbl-handle:num-fields
      695         .
      696         put stream ddl unformatted substitute( '"<num-fields>" "&1" ':U, v-num-fields ).
      697         do v-ind = 1 to v-num-fields
      698         on error undo, return error substitute( "&1 (nws-exp). &2", vss-include-info4, error-status :get-message ( 1 ) )
      699         :
      700             assign
      701               v-fh = p-tbl-handle:buffer-field(v-ind).
      702             if v-fh:data-type = 'raw':U then do:
      703              v-str = string(v-fh:buffer-value).
      704             end.
      705             else do:
      706               v-str = replace( v-fh:buffer-value, '"':U, '""':U )
      707             .
      708             end.
      709           if v-fh:data-type = 'character':U
      710             and  v-fh:buffer-value = chr(63)
      711           then do:
      712             assign
      713               v-str = substitute( "'&1'", v-str )
      714             .
      715           end.
      716           put stream ddl unformatted substitute( '"<&1>" "&2" ':U, v-fh:name, v-str ).
      717         end.
      718         put stream ddl unformatted skip.
      719       end.
      720     end procedure.
      721   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      722   define temp-table temp-lock no-undo
      723     field lock-conn-id   as integer   label "Номер Подключения"
      724     field user-name      as character label "Пользователь"
      725     field lock-flag      as character label "Флаг"
      726     field trans-id       as integer   label "Транзакция"
      727     field trans-txtime   as character
      728     field trans-state    as character
      729     field trans-dur      as integer
      730     field connect-type   as character label "Подключение"
      731     field connect-time   as character format "x(20)"
      732     field connect-device as character format "x(40)" label "Устройство"
      733     .
      734   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      735   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      736   define variable tempcxml_v-num_ as integer no-undo .
      737   define  temp-table temp-xml-tables no-undo
      738   field order as integer
      739   field tbl-name as character
      740   field tbl-handle_ as handle
      741   field table-handle_ as handle
      742   field uniq-gate-rec as character
      743   field gate-name as character
      744   field gate-handle_ as handle
      745   field is-parent as logical
      746   index pi is unique primary
      747   uniq-gate-rec
      748   tbl-name
      749   index iorder
      750   order
      751   index gr
      752   uniq-gate-rec
      753   index gh
      754   gate-handle_
      755   index iparent
      756   is-parent
      757   .
      758   define  temp-table temp-xml-records no-undo
      759   field tbl-name as character
      760   field uniq-key-rec as character
      761   index pi is unique primary
      762   tbl-name
      763   uniq-key-rec
      764   .
      765   def var vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      766   procedure gen-key-rec :
      767     define input  parameter p-tbl-name    as character no-undo.
      768     define input  parameter p-bh_tbl-name as handle    no-undo.
      769     define output parameter p-key-rec     as character no-undo.
      770     do
      771     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      772     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      773     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      774     :
      775       define variable fh               as handle    no-undo .
      776       define variable v-ok             as logical   no-undo .
      777       define variable v-inform         as character no-undo .
      778       define variable v-ind            as integer   no-undo .
      779       define variable v-idx-field-qnty as integer   no-undo .
      780       if p-tbl-name = ?
      781         or p-tbl-name = "":U
      782       then do:
      783         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info8 ).
      784       end.
      785       if not p-bh_tbl-name:available then do:
      786         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info8, p-tbl-name ).
      787       end.
      788       assign
      789         p-key-rec = p-tbl-name
      790         v-inform  = p-bh_tbl-name:index-information(1)
      791         v-ind     = 2
      792       .
      793       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      794       on error undo, return error
      795       :
      796         assign
      797           v-inform = p-bh_tbl-name:index-information( v-ind )
      798           v-ind    = v-ind + 1
      799         .
      800       end.
      801       if v-inform = ?
      802         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      803         or entry( 3, v-inform, ",":U ) <> "1":U
      804       then do:
      805         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info8, p-tbl-name ).
      806       end.
      807       else do:
      808         assign
      809           v-idx-field-qnty = num-entries( v-inform ) - 4
      810         .
      811         if v-idx-field-qnty < 2 then do:
      812           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info8, v-inform, p-tbl-name ).
      813         end.
      814         do v-ind = 1 to v-idx-field-qnty by 2
      815         on error undo, return error
      816         :
      817           assign
      818             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      819             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      820           .
      821         end.
      822       end.
      823       if p-key-rec = ? then do:
      824         assign
      825           p-key-rec = "":U
      826         .
      827         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info8, p-tbl-name ).
      828       end.
      829     end.
      830     return.
      831   end procedure.
      832   procedure gen-where-keyr-tab :
      833     define input  parameter i-tableSerach as character no-undo.
      834     define input  parameter i-tablekey   as character  no-undo.
      835     define input  parameter p-key-rec    as character  no-undo.
      836     define input  parameter p-key-handle as handle     no-undo .
      837     define input  parameter p-db-name    as character  no-undo .
      838     define input  parameter p-tt-handle  as handle     no-undo .
      839     define output parameter o-Where      as character  no-undo.
      840     do
      841     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      842     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      843     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      844     :
      845       define variable v-full-tbl-name  as character no-undo .
      846       define variable bh_tbl-name      as handle    no-undo .
      847       define variable fh_key           as handle    no-undo .
      848       define variable fh_search        as handle    no-undo .
      849       define variable v-field-num      as integer   no-undo .
      850       define variable v-count-fld      as integer   no-undo .
      851       define variable v-inform         as character no-undo .
      852       define variable v-ind            as integer   no-undo .
      853       define variable v-idx-field-qnty as integer   no-undo .
      854       define variable v-field-name     as character no-undo .
      855       define variable v-field-val      as character no-undo .
      856       define variable v-word-link      as character no-undo .
      857       define variable vTable           as character no-undo.
      858       define variable bh_tbl-key       as handle    no-undo .
      859       assign
      860         p-key-rec = trim( p-key-rec )
      861       .
      862       if p-key-handle <> ? then do:
      863         if not valid-handle(p-key-handle)
      864            or p-key-handle:type <> "buffer"
      865         then do:
      866           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info8 ).
      867         end.
      868         if num-entries( p-key-rec, chr(3) ) > 1
      869           or p-key-rec = ?
      870           or p-key-rec = "":U
      871         then do:
      872           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info8, p-key-rec ).
      873         end.
      874       end.
      875       else do:
      876         if p-key-rec = ?
      877           or p-key-rec = "":U
      878         then do:
      879           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info8 ).
      880         end.
      881       end.
      882       assign
      883         vTable = entry( 1 , p-key-rec, chr(3) )
      884       .
      885       if p-tt-handle <> ?
      886         and ( not valid-handle(p-tt-handle)
      887               or p-tt-handle:type <> "buffer"
      888             )
      889       then do:
      890         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info8, vTable, chr(10) ).
      891       end.
      892       if p-tt-handle = ? then do:
      893         assign
      894           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      895         .
      896         create buffer bh_tbl-name for table v-full-tbl-name .
      897       end.
      898       else do:
      899         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      900       end.
      901       assign
      902         v-inform = bh_tbl-name:index-information(1)
      903         v-ind    = 2
      904       .
      905       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      906       on error undo, return error
      907       :
      908         assign
      909           v-inform = bh_tbl-name:index-information( v-ind )
      910           v-ind    = v-ind + 1
      911         .
      912       end.
      913       if v-inform = ?
      914         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      915         or entry( 3, v-inform, ",":U ) <> "1":U
      916       then do:
      917         delete object bh_tbl-name no-error.
      918         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info8, vTable ).
      919       end.
      920       assign
      921         v-idx-field-qnty = num-entries( v-inform ) - 4
      922       .
      923       if v-idx-field-qnty < 2 then do:
      924         delete object bh_tbl-name no-error.
      925         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info8, v-inform, vTable ).
      926       end.
      927       assign
      928         o-where     = "where":U
      929         v-word-link = "":U
      930         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      931         v-count-fld = 0
      932       .
      933       if i-tablekey ne "" and i-tablekey ne ?
      934       then do:
      935         assign
      936           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      937         .
      938         create buffer bh_tbl-key for table v-full-tbl-name .
      939       end.
      940       if i-tableSerach ne "" and i-tableSerach ne ?
      941       then do:
      942         delete object bh_tbl-name no-error.
      943         assign
      944           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      945         .
      946         create buffer bh_tbl-name for table v-full-tbl-name .
      947       end.
      948       block_where:
      949       do v-ind = 1 to v-idx-field-qnty by 2
      950       on error undo, return error
      951       :
      952         assign
      953           v-count-fld = v-count-fld + 1
      954         .
      955         if p-key-handle = ?
      956           and v-count-fld > v-field-num
      957         then do:
      958           leave block_where.
      959         end.
      960         define variable VfieldKeyTable as handle no-undo.
      961         assign
      962           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      963           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      964         .
      965         if     bh_tbl-key ne ?
      966         then do:
      967            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      968            if VfieldKeyTable eq ?
      969            then next block_where.
      970         end.
      971         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      972         then
      973            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      974         else
      975            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      976         if p-key-handle = ? then do:
      977           assign
      978             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      979           .
      980         end.
      981         else do:
      982           assign
      983             fh_key = p-key-handle:buffer-field( v-field-name )
      984           .
      985           if fh_key = ?
      986             or not valid-handle( fh_key )
      987           then do:
      988             delete object bh_tbl-name.
      989             if     bh_tbl-key ne ?
      990             then
      991                delete object bh_tbl-key.
      992             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info8, p-key-handle:name, v-field-name ).
      993           end.
      994           assign
      995             v-field-val = fh_key:buffer-value
      996           .
      997         end.
      998         if fh_search:data-type ="character":U then do:
      999           assign
     1000             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
     1001             v-field-val = replace( v-field-val, '"':U, '~~"':U )
     1002             v-field-val = replace( v-field-val, "'":U, "~~'":U )
     1003             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
     1004             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
     1005             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
     1006             v-field-val = replace( v-field-val, chr(10), '~~n':U )
     1007             v-field-val = replace( v-field-val, chr(9), '~~t':U )
     1008             v-field-val = replace( v-field-val, chr(13), '~~r':U )
     1009             v-field-val = replace( v-field-val, chr(27), '~~E':U )
     1010             v-field-val = replace( v-field-val, chr(8), '~~b':U )
     1011             v-field-val = replace( v-field-val, chr(12), '~~f':U )
     1012             v-field-val = substitute( '"&1"', v-field-val )
     1013           .
     1014         end.
     1015         assign
     1016           o-where = substitute( "&1 &2", o-where, v-field-val )
     1017         .
     1018         if v-word-link = "":U then do:
     1019           assign
     1020             v-word-link = "and":U
     1021           .
     1022         end.
     1023       end.
     1024       delete object bh_tbl-name.
     1025       if     bh_tbl-key ne ?
     1026       then
     1027          delete object bh_tbl-key.
     1028       if p-key-handle = ?
     1029         and v-count-fld <> v-field-num
     1030       then do:
     1031         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info8, vTable ).
     1032       end.
     1033     end.
     1034   end procedure.
     1035   procedure gen-hn-keyr-tab :
     1036     define input  parameter i-tableSerach as character no-undo.
     1037     define input  parameter i-tablekey   as character no-undo.
     1038     define input  parameter p-key-rec    as character no-undo.
     1039     define input  parameter p-key-handle as handle    no-undo .
     1040     define input  parameter p-db-name    as character no-undo .
     1041     define input  parameter p-tt-handle  as handle    no-undo .
     1042     define input  parameter p-stts-lock  as integer   no-undo .
     1043     define output parameter o-hn         as handle    no-undo.
     1044     define variable v-full-tbl-name as character no-undo.
     1045     define variable v-where         as character no-undo.
     1046     define variable bh_tbl-name     as handle    no-undo.
     1047     define variable vTable          as character no-undo.
     1048     do
     1049     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1050     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1051     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
     1052         run gen-where-keyr-tab(i-tableSerach,
     1053                                i-tablekey,
     1054                                p-key-rec,
     1055                                p-key-handle,
     1056                                p-db-name,
     1057                                p-tt-handle,
     1058                                output v-where).
     1059         if i-tableSerach ne "" and i-tableSerach ne ?
     1060         then do:
     1061            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
     1062            create buffer bh_tbl-name for table v-full-tbl-name .
     1063         end.
     1064         else do:
     1065            if p-tt-handle = ? then do:
     1066               assign
     1067                  vTable = entry( 1 , p-key-rec, chr(3) )
     1068               .
     1069               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
     1070               create buffer bh_tbl-name for table v-full-tbl-name .
     1071            end.
     1072            else do:
     1073               create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1074            end.
     1075         end.
     1076         if p-tt-handle = ? then do:
     1077            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
     1078         end.
     1079         else do:
     1080            bh_tbl-name:find-first( v-where ) no-error .
     1081         end.
     1082         o-hn = bh_tbl-name.
     1083      end.
     1084   end procedure.
     1085   procedure gen-hn-keyr :
     1086     define input  parameter p-key-rec    as character no-undo.
     1087     define input  parameter p-key-handle as handle    no-undo .
     1088     define input  parameter p-db-name    as character no-undo .
     1089     define input  parameter p-tt-handle  as handle    no-undo .
     1090     define input  parameter p-stts-lock  as integer   no-undo .
     1091     define output parameter o-hn         as handle    no-undo.
     1092     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
     1093   end.
     1094   procedure gen-row-keyr :
     1095     define input  parameter p-key-rec    as character no-undo.
     1096     define input  parameter p-key-handle as handle    no-undo .
     1097     define input  parameter p-db-name    as character no-undo .
     1098     define input  parameter p-tt-handle  as handle    no-undo .
     1099     define input  parameter p-stts-lock  as integer   no-undo .
     1100     define output parameter p-tbl-row    as rowid     no-undo.
     1101     define output parameter p-tbl-name   as character no-undo.
     1102     define variable vHn as handle no-undo.
     1103       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
     1104       p-tbl-row = if vHn:available then vHn:rowid else ?.
     1105       p-tbl-name =  vHn:table.
     1106       delete object vHn no-error.
     1107     if p-tbl-row = ? then do:
     1108       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info8, p-tbl-name, p-key-rec ).
     1109     end.
     1110     else do:
     1111       return.
     1112     end.
     1113   end procedure.
     1114   procedure gen-key-fv :
     1115     define input  parameter p-key-rec    as character no-undo .
     1116     define output parameter p-field-list as character no-undo .
     1117     define output parameter p-value-list as character no-undo.
     1118     do
     1119     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1120     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1121     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1122     :
     1123       define variable v-full-tbl-name  as character no-undo .
     1124       define variable bh_tbl-name      as handle    no-undo .
     1125       define variable v-tbl-name       as character no-undo .
     1126       define variable v-field-num      as integer   no-undo .
     1127       define variable v-count-fld      as integer   no-undo .
     1128       define variable v-inform         as character no-undo .
     1129       define variable v-ind            as integer   no-undo .
     1130       define variable v-idx-field-qnty as integer   no-undo .
     1131       define variable v-delim-key      as character no-undo .
     1132       if p-key-rec = ?
     1133         or p-key-rec = "":U
     1134       then do:
     1135         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info8 ).
     1136       end.
     1137       assign
     1138         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     1139         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1140       .
     1141       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1142       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info8 ).
     1143       assign
     1144         v-inform = bh_tbl-name:index-information(1)
     1145         v-ind    = 2
     1146       .
     1147       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1148       on error undo, return error
     1149       :
     1150         assign
     1151           v-inform = bh_tbl-name:index-information( v-ind )
     1152           v-ind    = v-ind + 1
     1153         .
     1154       end.
     1155       if v-inform = ?
     1156         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1157         or entry( 3, v-inform, ",":U ) <> "1":U
     1158       then do:
     1159         delete object bh_tbl-name no-error.
     1160         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info8, v-tbl-name ).
     1161       end.
     1162       assign
     1163         v-idx-field-qnty = num-entries( v-inform ) - 4
     1164       .
     1165       if v-idx-field-qnty < 2 then do:
     1166         delete object bh_tbl-name no-error.
     1167         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info8, v-inform, v-tbl-name ).
     1168       end.
     1169       assign
     1170         p-field-list = "":U
     1171         p-value-list = "":U
     1172         v-delim-key  = "":U
     1173         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     1174         v-count-fld  = 0
     1175       .
     1176       block_where:
     1177       do v-ind = 1 to v-idx-field-qnty by 2
     1178       on error undo, return error
     1179       :
     1180         assign
     1181           v-count-fld = v-count-fld + 1
     1182         .
     1183         if v-count-fld > v-field-num then do:
     1184           leave block_where.
     1185         end.
     1186         assign
     1187           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     1188           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     1189         .
     1190         if v-ind = 1 then do:
     1191           assign
     1192             v-delim-key = chr(3)
     1193           .
     1194         end.
     1195       end.
     1196       delete object bh_tbl-name.
     1197       if v-count-fld <> v-field-num then do:
     1198         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info8, v-tbl-name ).
     1199       end.
     1200     end.
     1201   end procedure.
     1202   procedure gen-key-field :
     1203     define input  parameter p-table      as character no-undo .
     1204     define output parameter p-field-list as character no-undo .
     1205     do
     1206     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1207     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1208     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1209     :
     1210       define variable v-full-tbl-name  as character no-undo .
     1211       define variable bh_tbl-name      as handle    no-undo .
     1212       define variable v-tbl-name       as character no-undo .
     1213       define variable v-field-num      as integer   no-undo .
     1214       define variable v-count-fld      as integer   no-undo .
     1215       define variable v-inform         as character no-undo .
     1216       define variable v-ind            as integer   no-undo .
     1217       define variable v-idx-field-qnty as integer   no-undo .
     1218       define variable v-delim-key      as character no-undo .
     1219       if p-table = ?
     1220         or p-table = "":U
     1221       then do:
     1222         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info8 ).
     1223       end.
     1224       assign
     1225         v-tbl-name      = p-table
     1226         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1227       .
     1228       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1229       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info8 ).
     1230       assign
     1231         v-inform = bh_tbl-name:index-information(1)
     1232         v-ind    = 2
     1233       .
     1234       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1235       on error undo, return error
     1236       :
     1237         assign
     1238           v-inform = bh_tbl-name:index-information( v-ind )
     1239           v-ind    = v-ind + 1
     1240         .
     1241       end.
     1242       if v-inform = ?
     1243         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1244         or entry( 3, v-inform, ",":U ) <> "1":U
     1245       then do:
     1246         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info8, v-tbl-name ).
     1247       end.
     1248       assign
     1249         v-idx-field-qnty = num-entries( v-inform ) - 4
     1250       .
     1251       if v-idx-field-qnty < 2 then do:
     1252         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info8, v-inform, v-tbl-name ).
     1253       end.
     1254       assign
     1255         p-field-list = "":U
     1256         v-delim-key  = "":U
     1257         v-count-fld  = 0
     1258       .
     1259       block_where:
     1260       do v-ind = 1 to v-idx-field-qnty by 2
     1261       on error undo, return error
     1262       :
     1263         assign
     1264           v-count-fld = v-count-fld + 1
     1265         .
     1266         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     1267         if v-ind = 1 then do:
     1268           assign
     1269             v-delim-key = chr(3)
     1270           .
     1271         end.
     1272       end.
     1273       delete object bh_tbl-name.
     1274     end.
     1275   end procedure.
     1276   procedure get-gate-file-name :
     1277   define input parameter p-gate-rec as character no-undo .
     1278   define output  parameter p-gate-file-name as character no-undo .
     1279   define buffer buf_clob-data for ub.clob-data.
     1280   define variable v-tbl-row as rowid no-undo .
     1281   define variable v-tbl-name as character no-undo .
     1282   run gen-row-keyr in this-procedure ( input p-gate-rec
     1283                                       ,input ?
     1284                                       ,input "ub"
     1285                                       ,input ?
     1286                                       ,input no-lock
     1287                                       ,output v-tbl-row
     1288                                       ,output v-tbl-name) no-error.
     1289   if error-status:error then undo, return error substitute("&1 (get-gate-name) Несуществующий gate &2"
     1290                                                           ,vss-include-info6
     1291                                                           ,p-gate-rec).
     1292   find first buf_clob-data no-lock where
     1293             rowid(buf_clob-data) = v-tbl-row no-error.
     1294   if not available buf_clob-data then do:
     1295     if error-status:error then undo, return error substitute("&1 (get-gate-name) Несуществующий gate &2"
     1296                                                             ,vss-include-info6
     1297                                                             ,p-gate-rec).
     1298   end.
     1299   p-gate-file-name = buf_clob-data.file-name.
     1300   end procedure.
     1301   procedure get-gate-rec :
     1302   define input  parameter p-gate-name as character no-undo .
     1303   define output parameter p-gate-rec as character no-undo .
     1304   define buffer buf_clob-bind for ub.clob-bind.
     1305   define buffer buf_clob-data for ub.clob-data.
     1306   main-block:
     1307   do
     1308   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info6, return-value, chr(10), error-status :get-message (1))
     1309   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info6 )
     1310   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info6 )
     1311   :
     1312       find first buf_clob-bind no-lock where
     1313                 buf_clob-bind.uniq-key-rec = p-gate-name
     1314             and buf_clob-bind.field-name = '':U
     1315             and buf_clob-bind.part-num = 1
     1316             and buf_clob-bind.resource-type = 'gate':U
     1317             no-error.
     1318       if not available buf_clob-bind then do:
     1319         undo, return error substitute("Неверная ссылка на XSD -файл &1 для gate"
     1320                                         , p-gate-name
     1321                                         ).
     1322       end.
     1323       find first buf_clob-data no-lock where
     1324                 buf_clob-data.db-num = buf_clob-bind.db-num
     1325             and buf_clob-data.int64-i= buf_clob-bind.int64-id no-error.
     1326       if not available buf_clob-data then do:
     1327         undo, return error substitute("Не найден CLOB c ДБ &1 id &2 - файл &3"
     1328                                         , buf_clob-bind.db-num
     1329                                         , buf_clob-bind.int64-id
     1330                                         , p-gate-name
     1331                                         ).
     1332       end.
     1333       run gen-key-rec in this-procedure ( input 'clob-data':U
     1334                                 ,input buffer buf_clob-data:handle
     1335                                 ,output p-gate-rec).
     1336   end.
     1337   end procedure.
     1338   procedure get-gate-by-name :
     1339   define input  parameter p-gate-name as character no-undo .
     1340   define output parameter p-gate-rec as character no-undo .
     1341   define output parameter p-dsh as handle no-undo .
     1342   define input-output  parameter p-xmlh as handle no-undo .
     1343   define variable v-ii as integer   no-undo .
     1344   define variable glog as logical   no-undo .
     1345   define variable v-longchar as longchar no-undo .
     1346   define variable v-txmlh as handle no-undo .
     1347   define variable v-db-num as integer no-undo .
     1348   define variable v-int64-id as int64 no-undo .
     1349   define buffer buf_clob-bind for ub.clob-bind.
     1350   define buffer buf_clob-data for ub.clob-data.
     1351   main-block:
     1352   do
     1353   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info6, return-value, chr(10), error-status :get-message (1))
     1354   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info6 )
     1355   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info6 )
     1356   :
     1357       find first buf_clob-bind no-lock where
     1358                 buf_clob-bind.uniq-key-rec = p-gate-name
     1359             and buf_clob-bind.field-name = '':U
     1360             and buf_clob-bind.part-num = 1
     1361             and buf_clob-bind.resource-type = 'gate':U
     1362             no-error.
     1363       if not available buf_clob-bind then do:
     1364         undo, return error substitute("Неверная ссылка на XSD -файл &1 для gate"
     1365                                         , p-gate-name
     1366                                         ).
     1367       end.
     1368       find first buf_clob-data no-lock where
     1369                 buf_clob-data.db-num = buf_clob-bind.db-num
     1370             and buf_clob-data.int64-i= buf_clob-bind.int64-id no-error.
     1371       if not available buf_clob-data then do:
     1372         undo, return error substitute("Не найден CLOB c ДБ &1 id &2 - файл &3"
     1373                                         , buf_clob-bind.db-num
     1374                                         , buf_clob-bind.int64-id
     1375                                         , p-gate-name
     1376                                         ).
     1377       end.
     1378       assign
     1379       v-longchar = buf_clob-data.cdata
     1380       .
     1381       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1382       if error-status :error then do:
     1383         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, buf_clob-data.file-name_, chr(10), error-status:get-message(1) , return-value ).
     1384       end.
     1385       create dataset p-dsh .
     1386       glog = p-dsh:READ-XMLSCHEMA( "LONGCHAR"
     1387                                     , v-longchar
     1388                                     , ?
     1389                                     , ?
     1390                                     , ?
     1391                                     ) no-error.
     1392       v-longchar = '':U.
     1393       if error-status :error
     1394       or not glog
     1395       then do:
     1396         undo, return error substitute("Не удалось прочитать XML-схему &1 из БД:&2&3", p-gate-name, chr(10), error-status:get-message(1) ).
     1397       end.
     1398       if not valid-handle(p-xmlh)
     1399       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     1400         create temp-table v-txmlh.
     1401         v-txmlh:create-like(buffer temp-xml-tables:handle).
     1402         v-txmlh:temp-table-prepare("temp-xml-tables").
     1403         p-xmlh = v-txmlh:default-buffer-handle.
     1404       end.
     1405       run gen-key-rec in this-procedure ( input 'clob-data':U
     1406                                 ,input buffer buf_clob-data:handle
     1407                                 ,output p-gate-rec).
     1408       do v-ii = 1 to p-dsh:num-buffers:
     1409         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     1410         if not p-xmlh:available then do:
     1411           p-xmlh:buffer-create().
     1412           assign
     1413           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     1414           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1415           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1416           p-xmlh::gate-handle_ = p-dsh
     1417           p-xmlh::uniq-gate-rec = p-gate-rec
     1418           p-xmlh::gate-name = p-dsh:name
     1419           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1420           .
     1421           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1422             assign
     1423             p-xmlh::order = -3.
     1424           end.
     1425         end.
     1426       end.
     1427   end.
     1428   end procedure.
     1429   procedure get-gate-by-rec :
     1430   define input  parameter p-gate-rec as character no-undo .
     1431   define output parameter p-dsh as handle no-undo .
     1432   define input-output  parameter p-xmlh as handle no-undo .
     1433   define input-output parameter p-longchar  as longchar no-undo .
     1434   define variable v-ii as integer   no-undo .
     1435   define variable glog as logical   no-undo .
     1436   define variable v-rowid as rowid no-undo .
     1437   define variable v-tbl-name as character no-undo .
     1438   define variable v-longchar as longchar no-undo .
     1439   define variable v-txmlh as handle no-undo .
     1440   define buffer buf_clob-data for ub.clob-data.
     1441   main-block:
     1442   do
     1443   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info6, return-value, chr(10), error-status :get-message (1))
     1444   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info6 )
     1445   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info6 )
     1446   :
     1447     run gen-row-keyr in this-procedure (
     1448                                           input  p-gate-rec
     1449                                           ,input  ?
     1450                                           ,input  "ub"
     1451                                           ,input  ?
     1452                                           ,input  NO-LOCK
     1453                                           ,output v-rowid
     1454                                           ,output v-tbl-name   ) no-error.
     1455       find first buf_clob-data no-lock where
     1456                 rowid(buf_clob-data) = v-rowid  no-error.
     1457       if not available buf_clob-data then do:
     1458         undo, return error substitute("Не найден CLOB  &1"
     1459                                         , p-gate-rec
     1460                                         ).
     1461       end.
     1462       assign
     1463       v-longchar = buf_clob-data.cdata
     1464       .
     1465       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1466       if error-status :error then do:
     1467         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, buf_clob-data.file-name_, chr(10), error-status:get-message(1) , return-value ).
     1468       end.
     1469       create dataset p-dsh .
     1470       glog = p-dsh:READ-XMLSCHEMA( "LONGCHAR"
     1471                                     , v-longchar
     1472                                     , ?
     1473                                     , ?
     1474                                     , ?
     1475                                     ) no-error.
     1476       define variable v-esm as character no-undo .
     1477       v-esm = error-status:get-message(1) .
     1478       if p-longchar <> ? then do:
     1479         p-longchar = v-longchar.
     1480       end.
     1481       v-longchar = '':U.
     1482       if error-status :error
     1483       or not glog
     1484       then do:
     1485         undo, return error substitute("Не удалось прочитать XML-схему &1 (&2) из БД&3&4"
     1486                                      , p-gate-rec
     1487                                      , p-gate-rec
     1488                                      , v-esm
     1489                                      ).
     1490       end.
     1491       p-dsh:private-data = buf_clob-data.file-name_ + chr(4) + p-gate-rec.
     1492       if not valid-handle(p-xmlh)
     1493       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     1494         create temp-table v-txmlh.
     1495         v-txmlh:create-like(buffer temp-xml-tables:handle).
     1496         v-txmlh:temp-table-prepare("temp-xml-tables").
     1497         p-xmlh = v-txmlh:default-buffer-handle.
     1498       end.
     1499       do v-ii = 1 to p-dsh:num-buffers:
     1500         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     1501         if not p-xmlh:available then do:
     1502           p-xmlh:buffer-create().
     1503           assign
     1504           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     1505           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1506           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1507           p-xmlh::gate-handle_ = p-dsh
     1508           p-xmlh::uniq-gate-rec = p-gate-rec
     1509           p-xmlh::gate-name = p-dsh:name
     1510           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1511           .
     1512           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1513             assign
     1514             p-xmlh::order = -3.
     1515           end.
     1516           p-xmlh:buffer-release().
     1517         end.
     1518       end.
     1519   end.
     1520   end procedure.
     1521   procedure get-gate-by-file :
     1522   define input  parameter p-schema-file-name as character no-undo .
     1523   define input  parameter p-gate-rec as character no-undo .
     1524   define output parameter p-dsh as handle no-undo .
     1525   define input-output  parameter p-xmlh as handle no-undo .
     1526   define variable v-ii as integer   no-undo .
     1527   define variable glog as logical   no-undo .
     1528   define variable v-rowid as rowid no-undo .
     1529   define variable v-tbl-name as character no-undo .
     1530   define variable v-longchar as longchar no-undo .
     1531   define variable v-txmlh as handle no-undo .
     1532   main-block:
     1533   do
     1534   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info6, return-value, chr(10), error-status :get-message (1))
     1535   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info6 )
     1536   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info6 )
     1537   :
     1538       COPY-LOB
     1539       FROM  FILE p-schema-file-name
     1540       TO  OBJECT v-longchar
     1541       no-convert
     1542       NO-ERROR .
     1543       if error-status :error then do:
     1544           undo, return error substitute("Не удалось считать файл схемы &1 в память&2&3"
     1545                                     , p-schema-file-name
     1546                                 , chr(10)
     1547                                 , error-status:get-message(1) ).
     1548       end.
     1549       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1550       if error-status :error then do:
     1551         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, p-schema-file-name, chr(10), error-status:get-message(1) , return-value ).
     1552       end.
     1553       create dataset p-dsh .
     1554       glog = p-dsh:READ-XMLSCHEMA( "longchar"
     1555                                     , v-longchar
     1556                                     , ?
     1557                                     , ?
     1558                                     , ?
     1559                                     ) no-error.
     1560       v-longchar = ''.
     1561       if error-status :error
     1562       or not glog
     1563       then do:
     1564         undo, return error substitute("Не удалось прочитать XML-схему из файла &1&2&3"
     1565                                      , p-schema-file-name
     1566                                      ,chr(10)
     1567                                      , error-status:get-message(1)
     1568                                      ).
     1569       end.
     1570       if not valid-handle(p-xmlh)
     1571       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     1572         create temp-table v-txmlh.
     1573         v-txmlh:create-like(buffer temp-xml-tables:handle).
     1574         v-txmlh:temp-table-prepare("temp-xml-tables").
     1575         p-xmlh = v-txmlh:default-buffer-handle.
     1576       end.
     1577       do v-ii = 1 to p-dsh:num-buffers:
     1578         p-xmlh:find-first(substitute(' where tbl-name = "&1" and  uniq-gate-rec = "&2" '
     1579                                      ,p-dsh:get-buffer-handle(v-ii):name
     1580                                      ,p-gate-rec
     1581                                      )) no-error.
     1582         if not p-xmlh:available then do:
     1583           p-xmlh:buffer-create().
     1584           assign
     1585           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):table
     1586           p-xmlh::uniq-gate-rec = p-gate-rec
     1587           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1588           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1589           p-xmlh::gate-handle_ = p-dsh
     1590           p-xmlh::gate-name = p-dsh:name
     1591           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1592           .
     1593           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1594             assign
     1595             p-xmlh::order = -3.
     1596           end.
     1597           p-xmlh:buffer-release().
     1598         end.
     1599       end.
     1600   end.
     1601   end procedure.
     1602   procedure gate-clear :
     1603   define input  parameter p-dsh as handle no-undo .
     1604   define input  parameter p-xmlh as handle no-undo .
     1605   define variable v-dsh as handle no-undo .
     1606   define variable v-th as handle no-undo .
     1607     do
     1608     on error undo, return error return-value
     1609     :
     1610       if valid-handle(p-dsh) then do:
     1611         delete object p-dsh.
     1612         v-dsh = p-dsh.
     1613         p-dsh = ?.
     1614       end.
     1615       repeat while true:
     1616         p-xmlh:find-first( substitute( " where gate-handle_ = &1 ", v-dsh)
     1617                            , share-lock) no-error.
     1618         if p-xmlh:available then do:
     1619           assign
     1620           v-th = p-xmlh:buffer-field("table-handle_"):buffer-value.
     1621           if valid-handle(p-xmlh:buffer-field("table-handle_"))
     1622           and valid-handle(v-th)
     1623           and v-th:dynamic = yes
     1624           then do:
     1625             delete object p-xmlh:buffer-field("table-handle_"):buffer-value.
     1626             p-xmlh:buffer-field("table-handle_"):buffer-value = ?.
     1627           end.
     1628           p-xmlh:buffer-delete().
     1629         end.
     1630         else do:
     1631           leave.
     1632         end.
     1633       end.
     1634       if p-xmlh:dynamic = yes
     1635       and valid-handle(p-xmlh)
     1636       then do:
     1637         delete object p-xmlh:table-handle.
     1638         p-xmlh = ?.
     1639       end.
     1640       v-dsh = ?.
     1641     end.
     1642   end procedure.
     1643   procedure all-gates-clear :
     1644   define parameter buffer buf_temp-xml-tables for temp-xml-tables.
     1645   do
     1646   on error undo, return error
     1647   :
     1648     for each buf_temp-xml-tables
     1649     break
     1650     by buf_temp-xml-tables.uniq-gate-rec
     1651     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1652     on stop   undo , return error substitute( "&1. stop", vss-workfile )
     1653     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     1654     :
     1655         if first-of(buf_temp-xml-tables.uniq-gate-rec) then do:
     1656           delete object buf_temp-xml-tables.gate-handle_.
     1657           buf_temp-xml-tables.gate-handle_ = ?.
     1658         end.
     1659         if valid-handle(buf_temp-xml-tables.table-handle_)
     1660         and buf_temp-xml-tables.table-handle_:dynamic = no
     1661         then do:
     1662           delete object buf_temp-xml-tables.table-handle_.
     1663           buf_temp-xml-tables.table-handle_ = ?.
     1664         end.
     1665         delete buf_temp-xml-tables.
     1666     end.
     1667   end.
     1668   end procedure.
     1669   procedure fix-schemalocation :
     1670   define input-output  parameter p-longchar as longchar no-undo .
     1671   DEFINE VARIABLE hdoc AS HANDLE.
     1672   DEFINE VARIABLE hroot AS HANDLE.
     1673   DEFINE VARIABLE hnode-child AS HANDLE.
     1674   DEFINE VARIABLE hnode-attr AS HANDLE.
     1675   define variable v-jj as integer   no-undo .
     1676   define variable ok as logical   no-undo .
     1677   define variable v-path1                    as character                no-undo .
     1678   DEFINE VARIABLE v-full-path1               as character                no-undo .
     1679   DEFINE VARIABLE v-file-name1               as character                no-undo .
     1680   DEFINE VARIABLE v-file-name-no-ext1        as character                no-undo .
     1681   DEFINE VARIABLE v-file-name-ext1           as character                no-undo .
     1682   define variable v-schema-location          as character                no-undo .
     1683   do
     1684   on error undo, return error return-value
     1685   :
     1686     CREATE X-DOCUMENT hdoc.
     1687     CREATE X-noderef hroot.
     1688     CREATE X-noderef hnode-child.
     1689     CREATE X-noderef hnode-attr.
     1690     hdoc:load("longchar", p-longchar, no) no-error.
     1691     iF ERROR-STATUS:GET-MESSAGE(1) <> '' THEN message ERROR-STATUS:GET-MESSAGE(1) view-as alert-box .
     1692     hdoc:get-document-element(hroot).
     1693     _repeat:
     1694     REPEAT v-jj = 1 TO hroot:NUM-CHILDREN:
     1695       ok = hroot:GET-CHILD(hNode-Child, v-jj).
     1696       if not ok then next.
     1697       if hNode-Child:local-name = "include"
     1698       then do:
     1699         ok = hNode-Child:GET-ATTRIBUTE-NODE( hnode-attr, "schemaLocation" ).
     1700           v-schema-location = hnode-attr:node-value.
     1701           run gbl/filename.p (
     1702                           input "exe/" + hnode-attr:node-value
     1703                         ,output v-full-path1
     1704                         ,output v-path1
     1705                         ,output v-file-name1
     1706                         ,output v-file-name-no-ext1
     1707                         ,output v-file-name-ext1
     1708                         ) no-error .
     1709           if error-status :error then do:
     1710             delete object hnode-attr.
     1711             delete object hnode-child.
     1712             delete object hroot.
     1713             delete object hdoc.
     1714             undo, return error substitute("Не удалось определить расположение схемы &1", v-schema-location).
     1715           end.
     1716         ok = hNode-Child:sET-ATTRIBUTE(  "schemaLocation", v-full-path1 ).
     1717         leave  _repeat.
     1718       end.
     1719     END.
     1720     hdoc:save("longchar", p-longchar).
     1721     delete object hnode-attr.
     1722     delete object hnode-child.
     1723     delete object hroot.
     1724     delete object hdoc.
     1725   end.
     1726   end procedure.
     1727   procedure gate-clb_fill-xml-tables :
     1728   define input parameter p-dsh as handle no-undo .
     1729   define input-output parameter p-xmlh as handle no-undo .
     1730   define variable v-ii as integer no-undo .
     1731     do
     1732     on error undo, return error
     1733     :
     1734       do v-ii = 1 to p-dsh:num-buffers:
     1735         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     1736         if not p-xmlh:available then do:
     1737           p-xmlh:buffer-create().
     1738           assign
     1739           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     1740           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1741           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1742           p-xmlh::gate-handle_ = p-dsh
     1743           p-xmlh::uniq-gate-rec = entry(2, p-dsh:private-data, chr(4))
     1744           p-xmlh::gate-name = p-dsh:name
     1745           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1746           .
     1747           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1748             assign
     1749             p-xmlh::order = -3.
     1750           end.
     1751           p-xmlh:buffer-release().
     1752         end.
     1753       end.
     1754     end.
     1755   end procedure.
     1756   procedure all-gates-empty :
     1757   define buffer buf_temp-xml-tables for temp-xml-tables.
     1758   do
     1759   on error undo, return error
     1760   :
     1761     for each buf_temp-xml-tables
     1762     break
     1763     by buf_temp-xml-tables.uniq-gate-rec
     1764     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1765     on stop   undo , return error substitute( "&1. stop", vss-workfile )
     1766     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     1767     :
     1768       if valid-handle(buf_temp-xml-tables.tbl-handle_) then do:
     1769         buf_temp-xml-tables.tbl-handle_:empty-temp-table().
     1770       end.
     1771     end.
     1772   end.
     1773   end procedure.
     1774   do
     1775   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1776   on stop   undo, return error substitute( "&1. stop", vss-workfile )
     1777   on endkey undo, return error substitute( "&1. endkey", vss-workfile )
     1778   :
     1779     define variable v-err    as integer no-undo .
     1780     define variable rec-cnt as integer no-undo .
     1781     define variable lin-cnt as integer no-undo .
     1782     define variable v-ver-num       as character no-undo .
     1783     define variable v-today         as date      no-undo .
     1784     define variable v-time          as integer   no-undo .
     1785     define variable v-prev-crc      as character no-undo .
     1786     define variable v-pck-full-name as character no-undo .
     1787     define variable v-tmp-file      as character no-undo .
     1788     define buffer buf-prev_pck-sent   for ub.pck-sent.
     1789     define buffer buf_pck-sent        for ub.pck-sent.
     1790     define buffer buf-dst_db          for ub.db.
     1791     define buffer buf-src_db          for ub.db.
     1792     define buffer buf_route           for ub.route.
     1793     define buffer buf_route-dump      for ub.route-dump.
     1794     define buffer buf_temp-xml-tables for temp-xml-tables.
     1795     define variable v-uniq-key-rt    as character no-undo .
     1796     define variable tt-name         as character no-undo .
     1797     define variable tth             as handle    no-undo .
     1798     define variable bh_tt           as handle    no-undo .
     1799     define variable bh_route-dump   as handle    no-undo .
     1800     define variable v-ok            as logical   no-undo .
     1801     define variable v-first-char    as character no-undo .
     1802     define variable v-dsh           as handle    no-undo .
     1803     define variable v-dsh-dump      as handle    no-undo .
     1804     define variable v-xmlh          as handle    no-undo .
     1805     define variable v-found-gate    as logical   no-undo .
     1806     define variable v-sys-key  as character no-undo .
     1807     define frame exp-pck
     1808       p-db-num     label "для БД" skip
     1809       p-source-dir label "Каталог" format "x(40)" skip
     1810       p-pack-name  label "Пакет"   format "x(40)" skip
     1811       rec-cnt      label "Записей в пакете"
     1812       lin-cnt      label "Строк в пакете"
     1813       with view-as dialog-box side-labels 1 columns three-d title "** Экспорт пакета".
     1814     define variable mFrameView      as logical   no-undo init yes.
     1815   define new global shared variable mBatchMode as logical no-undo init ?.
     1816   define variable mFramBachModHandle as handle no-undo.
     1817   mFramBachModHandle = frame exp-pck:handle.
     1818   define variable mFameOldVis as logical no-undo.
     1819   define variable mVisCUrentVin as logical no-undo.
     1820   if session:batch-mode
     1821   then
     1822      mBatchMode = yes.
     1823   if mBatchMode = ? then do:
     1824     mVisCUrentVin = current-window:visible.
     1825     mFameOldVis = mFramBachModHandle:visible.
     1826     mFramBachModHandle:visible  = yes.
     1827     mBatchMode = mFramBachModHandle:visible ne yes.
     1828     mFramBachModHandle:visible = mFameOldVis.
     1829     current-window:visible = mVisCUrentVin.
     1830   end.
     1831    if  log-manager:logfile-name ne ?
     1832     then DO:
     1833         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1834         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1835         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1836     end.
     1837     if  log-manager:logfile-name ne ?
     1838     then DO:
     1839         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameNWSError").
     1840         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameNWSError").
     1841     end.
     1842     mFrameView = not mBatchMode.
     1843     if transaction then do:
     1844       message
     1845         vss-workfile vss-revision vss-description skip
     1846         substitute( "Вызов данной процедуры невозможен при наличии транзакции" )
     1847         view-as alert-box error
     1848       .
     1849       return error .
     1850     end.
     1851     assign
     1852       v-xmlh          = buffer buf_temp-xml-tables:handle
     1853       v-pck-full-name = p-source-dir + chr(92) + p-pack-name
     1854       v-tmp-file      = p-source-dir + chr(92) + substring( p-pack-name, 1, r-index( p-pack-name, '.':u) ) + 'tmp':U
     1855     .
     1856   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile:currsysk.i $ $Revision: $".
     1857   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run currsysk in g#library
     1858     (output v-sys-key
     1859     ) no-error .
     1860   if mFrameView
     1861     then do:
     1862        view frame exp-pck.
     1863        assign
     1864          frame exp-pck:title = substitute( "&1 для БД &2", frame exp-pck:title, trim( string( p-db-num, ">>>>>>>>9" ) ) )
     1865        .
     1866     end.
