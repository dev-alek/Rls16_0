        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter p-parent-handle as handle no-undo .
        4   define input parameter p-log-handle as handle no-undo .
        5   define input parameter p-imp-handle as handle    no-undo .
        6   define input parameter p-uniq-key-rec as character no-undo .
        7   define input parameter p-counter  as integer   no-undo .
        8   define variable vss-revision    as character no-undo init "$Revision$":U .
        9   define variable vss-author      as character no-undo init "$Author$":U .
       10   define variable vss-date        as character no-undo init "$Date$":U .
       11   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       12   define variable vss-archive     as character no-undo init "$Archive$":U .
       13   define variable vss-description as character no-undo init "Обработка команды отсылки настроек машины правил (для объекта TH)".
       14   procedure vss-get-info :
       15     define output parameter p-vss-revision    like vss-revision    no-undo .
       16     define output parameter p-vss-author      like vss-author      no-undo .
       17     define output parameter p-vss-date        like vss-date        no-undo .
       18     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       19     define output parameter p-vss-archive     like vss-archive     no-undo .
       20     define output parameter p-vss-description like vss-description no-undo .
       21     assign
       22       p-vss-revision    = vss-revision
       23       p-vss-author      = vss-author
       24       p-vss-date        = vss-date
       25       p-vss-workfile    = vss-workfile
       26       p-vss-archive     = vss-archive
       27       p-vss-description = vss-description
       28     .
       29   end procedure.
       30   procedure vss-get-parameters :
       31     define output parameter p-vss-parameters as character no-undo .
       32   end procedure.
       33   define new global shared variable g#vssrevis-logger as handle    no-undo .
       34   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       35   define variable v-vssrevis-logger                   as handle    no-undo .
       36   procedure vss-logevent :
       37     define input  parameter p-extra-paramters as character no-undo .
       38     define variable v-vssrevis-parameters as character no-undo .
       39     do
       40     on error undo, return error return-value
       41     :
       42       if  valid-handle(v-vssrevis-logger)
       43       and v-vssrevis-logger :get-signature("logevent") <> ""
       44       then do:
       45         run vss-get-parameters in this-procedure
       46           (output v-vssrevis-parameters
       47           ).
       48         run logevent in v-vssrevis-logger
       49           (input vss-workfile
       50           ,input vss-revision
       51           ,input v-vssrevis-parameters
       52           ,input p-extra-paramters
       53           ).
       54       end.
       55     end.
       56   end procedure.
       57   assign
       58     v-vssrevis-logger = g#vssrevis-logger
       59   .
       60   if  valid-handle(v-vssrevis-logger)
       61   and v-vssrevis-logger :get-signature("logevent") <> ""
       62   then do:
       63     assign
       64       v-vssrevis-logevent = true
       65     .
       66     run vss-logevent in this-procedure (input vss-description) .
       67   end.
       68   define new global shared variable g#language as character no-undo .
       69   if g#language <> '' and g#language <> 'rus':U then do:
       70     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       71   end.
       72   define new global shared variable g#library  as handle no-undo .
       73   define new global shared variable g#library2 as handle no-undo .
       74   define   shared variable g#auto as logical no-undo.
       75   define   shared variable g#news as logical no-undo.
       76   define   shared variable g#oxml as logical no-undo.
       77   define   shared variable g#esys as logical no-undo.
       78   define   shared variable g#news-source-db as integer no-undo.
       79   define   shared variable g#esys-source-esys as integer no-undo.
       80   define   shared variable g#db-num as integer   no-undo .
       81   define   shared variable g#userid as character no-undo .
       82   define   shared variable g#passwd as character no-undo .
       83   def var vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       84   procedure gen-key-rec :
       85     define input  parameter p-tbl-name    as character no-undo.
       86     define input  parameter p-bh_tbl-name as handle    no-undo.
       87     define output parameter p-key-rec     as character no-undo.
       88     do
       89     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
       90     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
       91     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
       92     :
       93       define variable fh               as handle    no-undo .
       94       define variable v-ok             as logical   no-undo .
       95       define variable v-inform         as character no-undo .
       96       define variable v-ind            as integer   no-undo .
       97       define variable v-idx-field-qnty as integer   no-undo .
       98       if p-tbl-name = ?
       99         or p-tbl-name = "":U
      100       then do:
      101         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info0 ).
      102       end.
      103       if not p-bh_tbl-name:available then do:
      104         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info0, p-tbl-name ).
      105       end.
      106       assign
      107         p-key-rec = p-tbl-name
      108         v-inform  = p-bh_tbl-name:index-information(1)
      109         v-ind     = 2
      110       .
      111       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      112       on error undo, return error
      113       :
      114         assign
      115           v-inform = p-bh_tbl-name:index-information( v-ind )
      116           v-ind    = v-ind + 1
      117         .
      118       end.
      119       if v-inform = ?
      120         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      121         or entry( 3, v-inform, ",":U ) <> "1":U
      122       then do:
      123         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info0, p-tbl-name ).
      124       end.
      125       else do:
      126         assign
      127           v-idx-field-qnty = num-entries( v-inform ) - 4
      128         .
      129         if v-idx-field-qnty < 2 then do:
      130           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info0, v-inform, p-tbl-name ).
      131         end.
      132         do v-ind = 1 to v-idx-field-qnty by 2
      133         on error undo, return error
      134         :
      135           assign
      136             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      137             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      138           .
      139         end.
      140       end.
      141       if p-key-rec = ? then do:
      142         assign
      143           p-key-rec = "":U
      144         .
      145         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info0, p-tbl-name ).
      146       end.
      147     end.
      148     return.
      149   end procedure.
      150   procedure gen-where-keyr-tab :
      151     define input  parameter i-tableSerach as character no-undo.
      152     define input  parameter i-tablekey   as character  no-undo.
      153     define input  parameter p-key-rec    as character  no-undo.
      154     define input  parameter p-key-handle as handle     no-undo .
      155     define input  parameter p-db-name    as character  no-undo .
      156     define input  parameter p-tt-handle  as handle     no-undo .
      157     define output parameter o-Where      as character  no-undo.
      158     do
      159     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      160     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      161     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      162     :
      163       define variable v-full-tbl-name  as character no-undo .
      164       define variable bh_tbl-name      as handle    no-undo .
      165       define variable fh_key           as handle    no-undo .
      166       define variable fh_search        as handle    no-undo .
      167       define variable v-field-num      as integer   no-undo .
      168       define variable v-count-fld      as integer   no-undo .
      169       define variable v-inform         as character no-undo .
      170       define variable v-ind            as integer   no-undo .
      171       define variable v-idx-field-qnty as integer   no-undo .
      172       define variable v-field-name     as character no-undo .
      173       define variable v-field-val      as character no-undo .
      174       define variable v-word-link      as character no-undo .
      175       define variable vTable           as character no-undo.
      176       define variable bh_tbl-key       as handle    no-undo .
      177       assign
      178         p-key-rec = trim( p-key-rec )
      179       .
      180       if p-key-handle <> ? then do:
      181         if not valid-handle(p-key-handle)
      182            or p-key-handle:type <> "buffer"
      183         then do:
      184           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info0 ).
      185         end.
      186         if num-entries( p-key-rec, chr(3) ) > 1
      187           or p-key-rec = ?
      188           or p-key-rec = "":U
      189         then do:
      190           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info0, p-key-rec ).
      191         end.
      192       end.
      193       else do:
      194         if p-key-rec = ?
      195           or p-key-rec = "":U
      196         then do:
      197           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info0 ).
      198         end.
      199       end.
      200       assign
      201         vTable = entry( 1 , p-key-rec, chr(3) )
      202       .
      203       if p-tt-handle <> ?
      204         and ( not valid-handle(p-tt-handle)
      205               or p-tt-handle:type <> "buffer"
      206             )
      207       then do:
      208         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info0, vTable, chr(10) ).
      209       end.
      210       if p-tt-handle = ? then do:
      211         assign
      212           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      213         .
      214         create buffer bh_tbl-name for table v-full-tbl-name .
      215       end.
      216       else do:
      217         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      218       end.
      219       assign
      220         v-inform = bh_tbl-name:index-information(1)
      221         v-ind    = 2
      222       .
      223       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      224       on error undo, return error
      225       :
      226         assign
      227           v-inform = bh_tbl-name:index-information( v-ind )
      228           v-ind    = v-ind + 1
      229         .
      230       end.
      231       if v-inform = ?
      232         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      233         or entry( 3, v-inform, ",":U ) <> "1":U
      234       then do:
      235         delete object bh_tbl-name no-error.
      236         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info0, vTable ).
      237       end.
      238       assign
      239         v-idx-field-qnty = num-entries( v-inform ) - 4
      240       .
      241       if v-idx-field-qnty < 2 then do:
      242         delete object bh_tbl-name no-error.
      243         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info0, v-inform, vTable ).
      244       end.
      245       assign
      246         o-where     = "where":U
      247         v-word-link = "":U
      248         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      249         v-count-fld = 0
      250       .
      251       if i-tablekey ne "" and i-tablekey ne ?
      252       then do:
      253         assign
      254           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      255         .
      256         create buffer bh_tbl-key for table v-full-tbl-name .
      257       end.
      258       if i-tableSerach ne "" and i-tableSerach ne ?
      259       then do:
      260         delete object bh_tbl-name no-error.
      261         assign
      262           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      263         .
      264         create buffer bh_tbl-name for table v-full-tbl-name .
      265       end.
      266       block_where:
      267       do v-ind = 1 to v-idx-field-qnty by 2
      268       on error undo, return error
      269       :
      270         assign
      271           v-count-fld = v-count-fld + 1
      272         .
      273         if p-key-handle = ?
      274           and v-count-fld > v-field-num
      275         then do:
      276           leave block_where.
      277         end.
      278         define variable VfieldKeyTable as handle no-undo.
      279         assign
      280           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      281           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      282         .
      283         if     bh_tbl-key ne ?
      284         then do:
      285            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      286            if VfieldKeyTable eq ?
      287            then next block_where.
      288         end.
      289         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      290         then
      291            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      292         else
      293            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      294         if p-key-handle = ? then do:
      295           assign
      296             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      297           .
      298         end.
      299         else do:
      300           assign
      301             fh_key = p-key-handle:buffer-field( v-field-name )
      302           .
      303           if fh_key = ?
      304             or not valid-handle( fh_key )
      305           then do:
      306             delete object bh_tbl-name.
      307             if     bh_tbl-key ne ?
      308             then
      309                delete object bh_tbl-key.
      310             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info0, p-key-handle:name, v-field-name ).
      311           end.
      312           assign
      313             v-field-val = fh_key:buffer-value
      314           .
      315         end.
      316         if fh_search:data-type ="character":U then do:
      317           assign
      318             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      319             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      320             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      321             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      322             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      323             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      324             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      325             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      326             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      327             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      328             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      329             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      330             v-field-val = substitute( '"&1"', v-field-val )
      331           .
      332         end.
      333         assign
      334           o-where = substitute( "&1 &2", o-where, v-field-val )
      335         .
      336         if v-word-link = "":U then do:
      337           assign
      338             v-word-link = "and":U
      339           .
      340         end.
      341       end.
      342       delete object bh_tbl-name.
      343       if     bh_tbl-key ne ?
      344       then
      345          delete object bh_tbl-key.
      346       if p-key-handle = ?
      347         and v-count-fld <> v-field-num
      348       then do:
      349         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info0, vTable ).
      350       end.
      351     end.
      352   end procedure.
      353   procedure gen-hn-keyr-tab :
      354     define input  parameter i-tableSerach as character no-undo.
      355     define input  parameter i-tablekey   as character no-undo.
      356     define input  parameter p-key-rec    as character no-undo.
      357     define input  parameter p-key-handle as handle    no-undo .
      358     define input  parameter p-db-name    as character no-undo .
      359     define input  parameter p-tt-handle  as handle    no-undo .
      360     define input  parameter p-stts-lock  as integer   no-undo .
      361     define output parameter o-hn         as handle    no-undo.
      362     define variable v-full-tbl-name as character no-undo.
      363     define variable v-where         as character no-undo.
      364     define variable bh_tbl-name     as handle    no-undo.
      365     define variable vTable          as character no-undo.
      366     do
      367     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      368     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      369     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      370         run gen-where-keyr-tab(i-tableSerach,
      371                                i-tablekey,
      372                                p-key-rec,
      373                                p-key-handle,
      374                                p-db-name,
      375                                p-tt-handle,
      376                                output v-where).
      377         if i-tableSerach ne "" and i-tableSerach ne ?
      378         then do:
      379            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      380            create buffer bh_tbl-name for table v-full-tbl-name .
      381         end.
      382         else do:
      383            if p-tt-handle = ? then do:
      384               assign
      385                  vTable = entry( 1 , p-key-rec, chr(3) )
      386               .
      387               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      388               create buffer bh_tbl-name for table v-full-tbl-name .
      389            end.
      390            else do:
      391               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      392            end.
      393         end.
      394         if p-tt-handle = ? then do:
      395            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      396         end.
      397         else do:
      398            bh_tbl-name:find-first( v-where ) no-error .
      399         end.
      400         o-hn = bh_tbl-name.
      401      end.
      402   end procedure.
      403   procedure gen-hn-keyr :
      404     define input  parameter p-key-rec    as character no-undo.
      405     define input  parameter p-key-handle as handle    no-undo .
      406     define input  parameter p-db-name    as character no-undo .
      407     define input  parameter p-tt-handle  as handle    no-undo .
      408     define input  parameter p-stts-lock  as integer   no-undo .
      409     define output parameter o-hn         as handle    no-undo.
      410     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      411   end.
      412   procedure gen-row-keyr :
      413     define input  parameter p-key-rec    as character no-undo.
      414     define input  parameter p-key-handle as handle    no-undo .
      415     define input  parameter p-db-name    as character no-undo .
      416     define input  parameter p-tt-handle  as handle    no-undo .
      417     define input  parameter p-stts-lock  as integer   no-undo .
      418     define output parameter p-tbl-row    as rowid     no-undo.
      419     define output parameter p-tbl-name   as character no-undo.
      420     define variable vHn as handle no-undo.
      421       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      422       p-tbl-row = if vHn:available then vHn:rowid else ?.
      423       p-tbl-name =  vHn:table.
      424       delete object vHn no-error.
      425     if p-tbl-row = ? then do:
      426       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info0, p-tbl-name, p-key-rec ).
      427     end.
      428     else do:
      429       return.
      430     end.
      431   end procedure.
      432   procedure gen-key-fv :
      433     define input  parameter p-key-rec    as character no-undo .
      434     define output parameter p-field-list as character no-undo .
      435     define output parameter p-value-list as character no-undo.
      436     do
      437     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      438     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      439     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      440     :
      441       define variable v-full-tbl-name  as character no-undo .
      442       define variable bh_tbl-name      as handle    no-undo .
      443       define variable v-tbl-name       as character no-undo .
      444       define variable v-field-num      as integer   no-undo .
      445       define variable v-count-fld      as integer   no-undo .
      446       define variable v-inform         as character no-undo .
      447       define variable v-ind            as integer   no-undo .
      448       define variable v-idx-field-qnty as integer   no-undo .
      449       define variable v-delim-key      as character no-undo .
      450       if p-key-rec = ?
      451         or p-key-rec = "":U
      452       then do:
      453         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info0 ).
      454       end.
      455       assign
      456         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      457         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      458       .
      459       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      460       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info0 ).
      461       assign
      462         v-inform = bh_tbl-name:index-information(1)
      463         v-ind    = 2
      464       .
      465       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      466       on error undo, return error
      467       :
      468         assign
      469           v-inform = bh_tbl-name:index-information( v-ind )
      470           v-ind    = v-ind + 1
      471         .
      472       end.
      473       if v-inform = ?
      474         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      475         or entry( 3, v-inform, ",":U ) <> "1":U
      476       then do:
      477         delete object bh_tbl-name no-error.
      478         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info0, v-tbl-name ).
      479       end.
      480       assign
      481         v-idx-field-qnty = num-entries( v-inform ) - 4
      482       .
      483       if v-idx-field-qnty < 2 then do:
      484         delete object bh_tbl-name no-error.
      485         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info0, v-inform, v-tbl-name ).
      486       end.
      487       assign
      488         p-field-list = "":U
      489         p-value-list = "":U
      490         v-delim-key  = "":U
      491         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      492         v-count-fld  = 0
      493       .
      494       block_where:
      495       do v-ind = 1 to v-idx-field-qnty by 2
      496       on error undo, return error
      497       :
      498         assign
      499           v-count-fld = v-count-fld + 1
      500         .
      501         if v-count-fld > v-field-num then do:
      502           leave block_where.
      503         end.
      504         assign
      505           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      506           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      507         .
      508         if v-ind = 1 then do:
      509           assign
      510             v-delim-key = chr(3)
      511           .
      512         end.
      513       end.
      514       delete object bh_tbl-name.
      515       if v-count-fld <> v-field-num then do:
      516         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info0, v-tbl-name ).
      517       end.
      518     end.
      519   end procedure.
      520   procedure gen-key-field :
      521     define input  parameter p-table      as character no-undo .
      522     define output parameter p-field-list as character no-undo .
      523     do
      524     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      525     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      526     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      527     :
      528       define variable v-full-tbl-name  as character no-undo .
      529       define variable bh_tbl-name      as handle    no-undo .
      530       define variable v-tbl-name       as character no-undo .
      531       define variable v-field-num      as integer   no-undo .
      532       define variable v-count-fld      as integer   no-undo .
      533       define variable v-inform         as character no-undo .
      534       define variable v-ind            as integer   no-undo .
      535       define variable v-idx-field-qnty as integer   no-undo .
      536       define variable v-delim-key      as character no-undo .
      537       if p-table = ?
      538         or p-table = "":U
      539       then do:
      540         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info0 ).
      541       end.
      542       assign
      543         v-tbl-name      = p-table
      544         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      545       .
      546       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      547       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info0 ).
      548       assign
      549         v-inform = bh_tbl-name:index-information(1)
      550         v-ind    = 2
      551       .
      552       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      553       on error undo, return error
      554       :
      555         assign
      556           v-inform = bh_tbl-name:index-information( v-ind )
      557           v-ind    = v-ind + 1
      558         .
      559       end.
      560       if v-inform = ?
      561         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      562         or entry( 3, v-inform, ",":U ) <> "1":U
      563       then do:
      564         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info0, v-tbl-name ).
      565       end.
      566       assign
      567         v-idx-field-qnty = num-entries( v-inform ) - 4
      568       .
      569       if v-idx-field-qnty < 2 then do:
      570         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info0, v-inform, v-tbl-name ).
      571       end.
      572       assign
      573         p-field-list = "":U
      574         v-delim-key  = "":U
      575         v-count-fld  = 0
      576       .
      577       block_where:
      578       do v-ind = 1 to v-idx-field-qnty by 2
      579       on error undo, return error
      580       :
      581         assign
      582           v-count-fld = v-count-fld + 1
      583         .
      584         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      585         if v-ind = 1 then do:
      586           assign
      587             v-delim-key = chr(3)
      588           .
      589         end.
      590       end.
      591       delete object bh_tbl-name.
      592     end.
      593   end procedure.
      594   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      595   define variable v-waitfram-action01         as character   no-undo .
      596   define variable v-waitfram-action02         as character   no-undo .
      597   define variable v-waitfram-action03         as character   no-undo .
      598   define variable mWaitFramTextBeg            as character   no-undo.
      599   define variable mWaitFramTextEnd            as character   no-undo.
      600   define variable mWaitFramView               as logical     no-undo.
      601   define variable mWaitProcEvent              as logical     no-undo init yes.
      602   define variable mWaitFramInterval           as integer     no-undo init 1 .
      603   define variable mWaitFramStop               as logical     no-undo.
      604   define variable mWaitFramStopUser           as logical     no-undo.
      605   define variable mWaitFramStopTimeOut        as logical     no-undo.
      606   define variable mWaitFramStartProc          as datetime-tz no-undo.
      607   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      608   define button B-WaitFramStop auto-end-key
      609        label "Стоп"
      610        size 10 by 1 tooltip "Остоновить процесс".
      611   define button B-viewProcInfo
      612        label "Информация"
      613        size 15 by 1 tooltip "Информация о процесс".
      614   define frame waitfram
      615     v-waitfram-action01 format "x(72)" no-label skip
      616     v-waitfram-action02 format "x(72)" no-label skip
      617     v-waitfram-action03 format "x(72)" no-label skip
      618     B-viewProcInfo
      619     B-WaitFramStop at row 4 col 30
      620     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      621     .
      622   define new global shared variable mBatchMode as logical no-undo init ?.
      623   define variable mFramBachModHandle as handle no-undo.
      624   mFramBachModHandle = frame waitfram:handle.
      625   define variable mFameOldVis as logical no-undo.
      626   define variable mVisCUrentVin as logical no-undo.
      627   if session:batch-mode
      628   then
      629      mBatchMode = yes.
      630   if mBatchMode = ? then do:
      631     mVisCUrentVin = current-window:visible.
      632     mFameOldVis = mFramBachModHandle:visible.
      633     mFramBachModHandle:visible  = yes.
      634     mBatchMode = mFramBachModHandle:visible ne yes.
      635     mFramBachModHandle:visible = mFameOldVis.
      636     current-window:visible = mVisCUrentVin.
      637   end.
      638    if  log-manager:logfile-name ne ?
      639     then DO:
      640         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      641         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      642         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      643     end.
      644   on choose of B-WaitFramStop in frame waitfram
      645   do:
      646     mWaitFramStop = yes.
      647     mWaitFramStopUser = yes.
      648   end.
      649   function waitfram-check-timeout returns logical():
      650      define variable vtime as int64 no-undo.
      651      if mWaitFramStopTimeOut
      652      then
      653         return yes.
      654      vtime = ( now - mWaitFramStartProc ) / 1000 .
      655      if     mWaitFramTimeOut ne ?
      656         and mWaitFramTimeOut ne 0
      657         and mWaitFramTimeOut lt vtime
      658      then do:
      659         mWaitFramStopTimeOut = yes.
      660      end.
      661      return mWaitFramStopTimeOut.
      662   end.
      663   procedure waitfram-hide :
      664     if not session:batch-mode
      665     then do
      666     on error undo, return error return-value
      667     :
      668       pause 0 before-hide .
      669       if not mBatchMode then
      670         hide frame waitfram .
      671     if     not mWaitFramView
      672        and mWaitProcEvent
      673     then
      674       process events .
      675     end.
      676   end procedure.
      677   procedure waitfram-show :
      678     define input  parameter p-message as character no-undo .
      679     define variable v-left-margin as integer   no-undo .
      680     if not session:batch-mode
      681     then do
      682     on error undo, return error return-value
      683     :
      684       if length(p-message) <= 70 then do:
      685         assign
      686           v-left-margin = integer((70 - length(p-message)) / 2)
      687         .
      688         assign
      689           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      690         .
      691         assign
      692           v-waitfram-action01 = " "
      693           v-waitfram-action02 = " "
      694                                    + fill(" ", v-left-margin)
      695                                    + p-message
      696           v-waitfram-action03 = " "
      697         .
      698       end.
      699       else do:
      700         define variable vRindex1 as integer no-undo.
      701         define variable vRindex2 as integer no-undo.
      702         vRindex1 = r-index(p-message," ",70).
      703         if vRindex1 = 0
      704         then
      705            vRindex1 = 70.
      706         if length(p-message)  <= vRindex1 + 70 then do:
      707           assign
      708             v-waitfram-action01 = " "
      709             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      710             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      711           .
      712         end.
      713         else do:
      714           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      715           if vRindex2 <= vRindex1
      716           then
      717              vRindex2 = vRindex1 + 70.
      718           assign
      719             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      720             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      721             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      722           .
      723         end.
      724       end.
      725       B-viewProcInfo:visible   in frame waitfram = no.
      726       B-viewProcInfo:sensitive in frame waitfram = no.
      727       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      728       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      729       if  (   mWaitFramView
      730          or  mWaitProcEvent)
      731          and not mBatchMode
      732       then
      733          display
      734             v-waitfram-action01 skip
      735             v-waitfram-action02 skip
      736             v-waitfram-action03 skip
      737          with frame waitfram .
      738       if     mWaitFramView
      739          then do:
      740             if     mWaitFramInterval ne ?
      741                and not mBatchMode
      742             then
      743                wait-for go of frame waitfram pause mWaitFramInterval.
      744          end.
      745          else
      746             if     mWaitProcEvent
      747                and not mBatchMode
      748             then
      749                process events .
      750     end.
      751   end procedure.
      752      procedure waitfram-show-this:
      753         define input  parameter iInterval as int64 no-undo.
      754         define variable vtime as int64 no-undo.
      755         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      756         mWaitFramInterval = iInterval.
      757         run waitfram-show (substitute("&1&2 &3&4" ,
      758                                       mWaitFramTextBeg ,
      759                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      760                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      761                                       mWaitFramTextEnd
      762                                      )
      763                           ).
      764      end.
      765      procedure WaitFramRunPause:
      766         define input  parameter iInterval as dec no-undo.
      767         define variable vStart  as datetime-tz no-undo.
      768         define variable vend    as datetime-tz no-undo.
      769         define variable vint as int64 no-undo.
      770         define variable vOk as logical no-undo.
      771         vStart = now.
      772         vend   = vStart.
      773         publish "WaitFramPause" (iInterval,output vOk).
      774         vend   =  now.
      775         vint = vend - vStart.
      776         vint = iInterval - vint / 1000.
      777         if     not mWaitFramStop
      778            and (   vint > 0
      779                 or (    not vOk
      780                     and iInterval eq ?
      781                     )
      782                 )
      783         then
      784            run waitfram-show-this (iInterval).
      785         vend   =  now.
      786         vint = vend - vStart.
      787         vint = iInterval - vint / 1000.
      788         if     not mWaitFramStop
      789            and vint > 0
      790         then do:
      791            run gbl/pause.p (vint * 1000).
      792         end.
      793         if iInterval ne ?
      794         then
      795            publish "WaitFramStop".
      796         waitfram-check-timeout().
      797      end.
      798      procedure WaitFramWaitFor:
      799         define input  parameter iInterval as dec no-undo.
      800         assign
      801            mWaitFramStartProc   = now
      802            mWaitFramStopUser    = no
      803            mWaitFramStopTimeOut = no
      804         .
      805         block-wait:
      806         do while not mWaitFramStop:
      807            run WaitFramRunPause (iInterval).
      808            if  waitfram-check-timeout()
      809            then do:
      810               leave block-wait.
      811            end.
      812         end.
      813         run waitfram-hide.
      814      end.
      815   procedure waitfram-join :
      816     define input  parameter p-line-1  as character no-undo .
      817     define input  parameter p-line-2  as character no-undo .
      818     define input  parameter p-line-3  as character no-undo .
      819     define output parameter p-message as character no-undo .
      820     do
      821     on error undo, return error return-value
      822     :
      823       assign
      824         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      825                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      826                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      827       .
      828     end.
      829   end procedure.
      830   function waitfram-join-function returns character
      831     (input p-line-1 as character
      832     ,input p-line-2 as character
      833     ,input p-line-3 as character
      834     ).
      835     define variable v-message as character no-undo .
      836     run waitfram-join in this-procedure
      837       (input  p-line-1
      838       ,input  p-line-2
      839       ,input  p-line-3
      840       ,output v-message
      841       ) .
      842     return v-message .
      843   end function .
      844   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      845   function octal-to-char return character
      846   ( p-string as character ) :
      847     def var v-asc     as integer no-undo .
      848     def var v-new-asc as integer no-undo .
      849     def var ind       as integer no-undo .
      850     if length(p-string) <> 3 then do:
      851       return ? .
      852     end.
      853     assign
      854       v-asc = 0
      855     .
      856     do ind = 1 to length(p-string)
      857     :
      858       assign
      859         v-new-asc = asc(substring(p-string, ind, 1)) - asc('0')
      860       .
      861       if v-new-asc < 0 or v-new-asc >= 8 then do:
      862         return ? .
      863       end.
      864       assign
      865         v-asc = v-asc * 8 + v-new-asc
      866       .
      867     end.
      868     return chr(v-asc) .
      869   end function .
      870   function char-to-octal return character
      871   ( p-chr as character ) :
      872     def var v-asc    as integer   no-undo .
      873     def var ind      as integer   no-undo .
      874     def var v-string as character no-undo .
      875     if length(p-chr) <> 1 then do:
      876       return ? .
      877     end.
      878     assign
      879       v-asc    = asc(p-chr)
      880       v-string = ""
      881     .
      882     do ind = 1 to 3
      883     :
      884       assign
      885         v-string = chr( v-asc mod 8 + asc('0')) + v-string
      886       .
      887       assign
      888         v-asc = truncate(v-asc / 8, 0)
      889       .
      890     end.
      891     return v-string .
      892   end.
      893   function str-encode return character
      894   (   p-init-string       as character
      895     , p-encode-char       as character
      896     , p-special-char-list as character
      897   ) :
      898     def var p-encode-string as character no-undo .
      899     def var ind                as integer no-undo .
      900     def var v-num-special-char as integer no-undo .
      901     def var v-special-char     as character no-undo .
      902     if p-encode-char = ?
      903     or p-encode-char = "" then do:
      904       assign
      905         p-encode-char = "~~"
      906       .
      907     end.
      908     if p-init-string = ? then do:
      909       return "?" .
      910     end.
      911     if p-init-string = "?" then do:
      912       return p-encode-char + char-to-octal("?") .
      913     end.
      914     assign
      915       v-num-special-char = length(p-special-char-list)
      916       p-encode-string    = replace(p-init-string
      917                                   ,p-encode-char
      918                                   ,p-encode-char + char-to-octal(p-encode-char)
      919                                   )
      920     .
      921     do ind = 1 to v-num-special-char
      922     :
      923       assign
      924         v-special-char = substring(p-special-char-list, ind, 1)
      925       .
      926       if v-special-char <> p-encode-char then do:
      927         assign
      928           p-encode-string = replace (p-encode-string
      929                                     ,v-special-char
      930                                     ,p-encode-char + char-to-octal(v-special-char)
      931                                     )
      932         .
      933       end.
      934     end.
      935     return p-encode-string .
      936   end.
      937   function str-decode returns character
      938     (p-init-string   as character
      939     ,p-encode-char   as character
      940     ) :
      941     def var p-decode-string as character no-undo .
      942     def var ind                       as integer no-undo .
      943     def var v-num-entries-init-string as integer no-undo .
      944     def var v-sub-phrase              as character no-undo .
      945     def var v-special-char            as character no-undo .
      946     if p-encode-char = ?
      947     or p-encode-char = "" then do:
      948       assign
      949         p-encode-char = "~~"
      950       .
      951     end.
      952     if p-init-string = "?" then do:
      953       return ? .
      954     end.
      955     assign
      956       v-num-entries-init-string = num-entries(p-init-string, p-encode-char)
      957     .
      958     if v-num-entries-init-string > 1 then do:
      959       assign
      960         p-decode-string = entry(1, p-init-string, p-encode-char)
      961       .
      962       do ind = 2 to v-num-entries-init-string
      963       :
      964         assign
      965           v-sub-phrase = entry(ind, p-init-string, p-encode-char)
      966         .
      967         assign
      968           v-special-char = octal-to-char(substring(v-sub-phrase, 1, 3))
      969         .
      970         if v-special-char <> ? then do:
      971           assign
      972             p-decode-string = p-decode-string
      973                             + v-special-char
      974                             + substring(v-sub-phrase, 4)
      975           .
      976         end.
      977         else do:
      978           assign
      979             p-decode-string = p-decode-string
      980                             + p-encode-char
      981                             + v-sub-phrase
      982           .
      983         end.
      984       end.
      985     end.
      986     else do:
      987       assign
      988         p-decode-string = p-init-string
      989       .
      990     end.
      991     return p-decode-string .
      992   end.
      993   define variable counter    as integer   no-undo .
      994   define variable rec-full   as character no-undo .
      995   define variable v-rec-name as character no-undo .
      996   define variable log-file-name as character no-undo .
      997   define variable v-action as character no-undo .
      998   define variable v-curr-rowid as rowid no-undo .
      999   define variable v-tbl-row as rowid no-undo .
     1000   define variable v-tbl-name as character no-undo .
     1001   define variable v-db-list     as character no-undo .
     1002   define variable v-command     as character no-undo .
     1003   define variable v-cmd-code    as integer no-undo .
     1004   define variable v-cmd-proc-handle as handle no-undo .
     1005   define variable v-run-parovoz as logical no-undo .
     1006   define variable v-rec-ord as recid no-undo .
     1007   define variable v-is-obj as logical no-undo .
     1008   define variable v-obj-db-num as integer no-undo .
     1009   define buffer buf_schedule for ub.schedule.
     1010   define buffer buf_db for ub.db.
     1011   define temp-table temp-thbj-attr no-undo like ub.thbj-attr
     1012   field action  as integer
     1013   .
