     1035   define buffer buf_prop-ref-call for ub.prop-ref-call.
     1036   main-block:
     1037   do
     1038   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1039   on stop   undo, return error substitute( "&1. stop", vss-workfile )
     1040   on endkey undo, return error substitute( "&1. endkey", vss-workfile )
     1041   :
     1042     do counter = 1 to p-counter
     1043     on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1044     on stop   undo, return error substitute( "&1. stop", vss-workfile )
     1045     on endkey undo, return error substitute( "&1. endkey", vss-workfile )
     1046     :
     1047       run waitfram-show in this-procedure
     1048         (input substitute("Получение настроек машины правил. &1 Получено записей: &2"
     1049                           , p-uniq-key-rec
     1050                           , counter)
     1051         ) .
     1052       if counter = 1 then do:
     1053       run gen-row-keyr in this-procedure (
     1054                                              input  p-uniq-key-rec
     1055                                             ,input  ?
     1056                                             ,input  "ub"
     1057                                             ,input  ?
     1058                                             ,input  EXCLUSIVE-LOCK
     1059                                             ,output v-tbl-row
     1060                                             ,output v-tbl-name   ) .
     1061       end.
     1062       run nws-imps in p-imp-handle
     1063         ( input-output counter
     1064          ,output       rec-full
     1065         ) no-error.
     1066       if error-status :error then do:
     1067         return error return-value .
     1068       end.
     1069       assign
     1070         v-rec-name = entry( 1, rec-full, chr(1) )
     1071         v-action = entry(2, rec-full, chr(1))
     1072       .
     1073       CASE v-rec-name :
     1074         when 'thbj-attr':U
     1075         then do:
     1076           run proc-load-standart in p-imp-handle
     1077             ( input 'thbj-attr':U
     1078               ,input '':U
     1079               ,input (buffer buf_temp-thbj-attr:handle)
     1080               ,input p-imp-handle
     1081               ,input 0
     1082               ,output v-curr-rowid
     1083             ) no-error.
     1084           if error-status :error then do:
     1085             return error return-value .
     1086           end.
     1087           define variable v-field-list as character no-undo .
     1088           define variable v-value-list as character no-undo .
     1089           define variable v-obj-type as character no-undo .
     1090           define variable v-obj-code as integer no-undo .
     1091           run  gen-key-fv in this-procedure ( input p-uniq-key-rec
     1092                                             ,output v-field-list
     1093                                             ,output v-value-list).
     1094           if lookup("obj-type", v-field-list, chr(3)) > 0 then do:
     1095             assign
     1096             v-obj-type = entry(lookup("obj-type", v-field-list, chr(3)), v-value-list, chr(3))
     1097             v-obj-code = integer(entry(lookup("obj-code", v-field-list, chr(3)), v-value-list, chr(3)) )
     1098             v-is-obj = not (v-obj-type = '' and v-obj-code = 0)
     1099             .
     1100           end.
     1101         end.
     1102         when 'rule-call-param':U
     1103         then do:
     1104           run proc-load-standart in p-imp-handle
     1105             ( input 'rule-call-param':U
     1106               ,input '':U
     1107               ,input (buffer buf_temp-rule-call-param:handle)
     1108               ,input p-imp-handle
     1109               ,input 0
     1110               ,output v-curr-rowid
     1111             ) no-error.
     1112           if error-status :error then do:
     1113             return error return-value .
     1114           end.
     1115           if v-action = "+delete" then do:
     1116             find first buf_temp-rule-call-param where
     1117                       rowid(buf_temp-rule-call-param) = v-curr-rowid.
     1118             buf_temp-rule-call-param.action = integer('99':U).
     1119           end.
     1120         end.
     1121         when 'rule-by-call':U
     1122         then do:
     1123           run proc-load-standart in p-imp-handle
     1124             ( input 'rule-by-call':U
     1125               ,input '':U
     1126               ,input (buffer buf_temp-rule-by-call:handle)
     1127               ,input p-imp-handle
     1128               ,input 0
     1129               ,output v-curr-rowid
     1130             ) no-error.
     1131           if error-status :error then do:
     1132             return error return-value .
     1133           end.
     1134           if v-action = "+delete" then do:
     1135             find first buf_temp-rule-by-call where
     1136                       rowid(buf_temp-rule-by-call) = v-curr-rowid.
     1137             buf_temp-rule-by-call.action = integer('99':U).
     1138           end.
     1139         end.
     1140         when 'rp-by-call':U
