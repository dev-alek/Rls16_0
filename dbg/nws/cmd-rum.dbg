     1395               if v-run-parovoz then do : run add-dump in v-cmd-proc-handle                                                                              (input v-cmd-code                                                                                            ,input 'rule-call-param':U                                                                                          ,input '+update'                                                                                         ,input buffer buf_rule-call-param:handle                                                                                    ,input '':U                                                                                                  ,output v-rec-ord                                                                                            ) no-error .                                                                                               if error-status :error                                                                                       then do:                                                                                                     delete procedure v-cmd-proc-handle .                                                                           undo main-block, return error substitute("&1 &2 &3&4Ошибка при добавлении записи &5 в команду с кодом &6&4&8&4&9&4"                                       ,vss-workfile                                                                                                ,vss-revision                                                                                                ,vss-description                                                                                             ,chr(10)                                                                                               ,'rule-call-param':U                                                                                                ,v-cmd-code                                                                                                  ,error-status:get-message(1)                                                                                 ,return-value                                                                                                ) .                                                                    end.                                                                                                         end.
     1396       end.
     1397     end.
     1398     for each buf_temp-prop-ref-call
     1399     on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1400     on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     1401     on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     1402     :
     1403       find first buf_prop-ref-call where
     1404                 buf_prop-ref-call.call#_id = buf_temp-prop-ref-call.call#_id
     1405             and buf_prop-ref-call.dt-code = buf_temp-prop-ref-call.dt-code no-error .
     1406       if buf_temp-prop-ref-call.action = integer('99':U) then do:
     1407         if not available buf_prop-ref-call then do:
     1408         end.
     1409         else do:
     1410               if v-run-parovoz then do : run add-dump in v-cmd-proc-handle                                                                              (input v-cmd-code                                                                                            ,input 'prop-ref-call':U                                                                                          ,input '+delete'                                                                                         ,input buffer buf_prop-ref-call:handle                                                                                    ,input '':U                                                                                                  ,output v-rec-ord                                                                                            ) no-error .                                                                                               if error-status :error                                                                                       then do:                                                                                                     delete procedure v-cmd-proc-handle .                                                                           undo main-block, return error substitute("&1 &2 &3&4Ошибка при добавлении записи &5 в команду с кодом &6&4&8&4&9&4"                                       ,vss-workfile                                                                                                ,vss-revision                                                                                                ,vss-description                                                                                             ,chr(10)                                                                                               ,'prop-ref-call':U                                                                                                ,v-cmd-code                                                                                                  ,error-status:get-message(1)                                                                                 ,return-value                                                                                                ) .                                                                    end.                                                                                                         end.
     1411           delete buf_prop-ref-call.
     1412         end.
     1413       end.
     1414       else do:
     1415         if not available buf_prop-ref-call then do:
     1416             create buf_prop-ref-call.
     1417         end.
     1418         buffer-copy buf_temp-prop-ref-call to buf_prop-ref-call.
     1419               if v-run-parovoz then do : run add-dump in v-cmd-proc-handle                                                                              (input v-cmd-code                                                                                            ,input 'prop-ref-call':U                                                                                          ,input '+update'                                                                                         ,input buffer buf_prop-ref-call:handle                                                                                    ,input '':U                                                                                                  ,output v-rec-ord                                                                                            ) no-error .                                                                                               if error-status :error                                                                                       then do:                                                                                                     delete procedure v-cmd-proc-handle .                                                                           undo main-block, return error substitute("&1 &2 &3&4Ошибка при добавлении записи &5 в команду с кодом &6&4&8&4&9&4"                                       ,vss-workfile                                                                                                ,vss-revision                                                                                                ,vss-description                                                                                             ,chr(10)                                                                                               ,'prop-ref-call':U                                                                                                ,v-cmd-code                                                                                                  ,error-status:get-message(1)                                                                                 ,return-value                                                                                                ) .                                                                    end.                                                                                                         end.
     1420       end.
     1421     end.
     1422     for each buf_temp-thbj-attr
     1423     on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1424     on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     1425     on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     1426     :
     1427       find first buf_thbj-attr where
     1428                buf_thbj-attr.upper-prop-code = buf_temp-thbj-attr.upper-prop-code
     1429            and buf_thbj-attr.prop-code = buf_temp-thbj-attr.prop-code
     1430            and buf_thbj-attr.obj-type = buf_temp-thbj-attr.obj-type
     1431            and buf_thbj-attr.obj-code = buf_temp-thbj-attr.obj-code no-error.
     1432       if not available buf_thbj-attr then do:
     1433         create buf_thbj-attr.
     1434       end.
     1435       buffer-copy buf_temp-thbj-attr to buf_thbj-attr.
     1436               if v-run-parovoz then do : run add-dump in v-cmd-proc-handle                                                                              (input v-cmd-code                                                                                            ,input 'thbj-attr':U                                                                                          ,input '+update'                                                                                         ,input buffer buf_thbj-attr:handle                                                                                    ,input '':U                                                                                                  ,output v-rec-ord                                                                                            ) no-error .                                                                                               if error-status :error                                                                                       then do:                                                                                                     delete procedure v-cmd-proc-handle .                                                                           undo main-block, return error substitute("&1 &2 &3&4Ошибка при добавлении записи &5 в команду с кодом &6&4&8&4&9&4"                                       ,vss-workfile                                                                                                ,vss-revision                                                                                                ,vss-description                                                                                             ,chr(10)                                                                                               ,'thbj-attr':U                                                                                                ,v-cmd-code                                                                                                  ,error-status:get-message(1)                                                                                 ,return-value                                                                                                ) .                                                                    end.                                                                                                         end.
     1437     end.
     1438     if v-run-parovoz then do:
     1439       run send-command in v-cmd-proc-handle
     1440          ( input v-cmd-code
     1441           ,input v-db-list
     1442           ) no-error .
     1443       if error-status:error then do:
     1444         delete procedure v-cmd-proc-handle .
     1445         message
     1446         vss-workfile vss-revision vss-description skip
     1447         substitute( "Ошибка при отсылке команды &1", 'cmd-rum-send':U ) skip
     1448         error-status :get-message(1) skip
     1449         return-value skip
     1450         view-as alert-box error .
     1451         undo main-block, return error .
     1452       end.
     1453       delete procedure v-cmd-proc-handle .
     1454     end.
     1455     run waitfram-hide in this-procedure .
     1456     return ''.
     1457   end.
     1458   procedure write-to-log :
     1459   define input parameter p-mess as character no-undo .
     1460     do
     1461     on error undo, return error
     1462     :
     1463     run write-log-and-file in p-log-handle (
     1464           input 1
     1465         , input log-file-name
     1466         , input 1
     1467         , input p-mess).
     1468     end.
     1469   end procedure.
