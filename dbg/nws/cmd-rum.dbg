     1237               end.
     1238               else do:
     1239                 v-run-parovoz = no.
     1240               end.
     1241             end.
     1242           end.
     1243         end.
     1244       end.
     1245       if v-run-parovoz then do:
     1246         if not valid-handle(v-cmd-proc-handle ) then dO:
