     1276             v-db-list = trim(v-db-list, chr(1)).
     1277           end.
     1278         end.
     1279         else do:
     1280           assign
     1281           v-db-list = string(0)
     1282           .
     1283         end.
     1284         run begin-create-command in v-cmd-proc-handle
     1285           (input  v-command
