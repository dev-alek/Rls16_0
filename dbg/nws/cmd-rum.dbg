     1250             undo main-block, return error substitute("&1 &2 &3&4Ошибка при запуске процедуры cmd-bush.p&4" +
     1251                                                 "&5&4&6"
     1252                                                 ,vss-workfile
     1253                                                 ,vss-revision
     1254                                                 ,vss-description
     1255                                                 ,chr(10)
     1256                                                 ,error-status:get-message(1)
     1257                                                 ,return-value ).
     1258           end.
     1259         end.
