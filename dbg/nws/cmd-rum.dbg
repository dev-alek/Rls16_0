     1318               if v-run-parovoz then do : run add-dump in v-cmd-proc-handle                                                                              (input v-cmd-code                                                                                            ,input 'rp-by-call':U                                                                                          ,input '+delete'                                                                                         ,input buffer buf_rp-by-call:handle                                                                                    ,input '':U                                                                                                  ,output v-rec-ord                                                                                            ) no-error .                                                                                               if error-status :error                                                                                       then do:                                                                                                     delete procedure v-cmd-proc-handle .                                                                           undo main-block, return error substitute("&1 &2 &3&4Ошибка при добавлении записи &5 в команду с кодом &6&4&8&4&9&4"                                       ,vss-workfile                                                                                                ,vss-revision                                                                                                ,vss-description                                                                                             ,chr(10)                                                                                               ,'rp-by-call':U                                                                                                ,v-cmd-code                                                                                                  ,error-status:get-message(1)                                                                                 ,return-value                                                                                                ) .                                                                    end.                                                                                                         end.
