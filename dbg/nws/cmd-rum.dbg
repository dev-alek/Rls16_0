     1287           ,output v-cmd-code
     1288           ) no-error.
     1289         if error-status :error
     1290         then do:
     1291           delete procedure v-cmd-proc-handle .
     1292           undo main-block, return error substitute("&1 &2 &3&4Ошибка при создании команды &5&4" +
