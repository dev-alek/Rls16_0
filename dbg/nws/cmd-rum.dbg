     1262                               , chr(6)
     1263                               , 'cmd-rum-send':U
     1264                               ,  str-encode( p-uniq-key-rec
     1265                                             , ""
     1266                                             , chr(3))
     1267                               ).
     1268         if g#db-num = 0 then do:
