     1143             ( input 'rp-by-call':U
     1144               ,input '':U
     1145               ,input (buffer buf_temp-rp-by-call:handle)
     1146               ,input p-imp-handle
     1147               ,input 0
     1148               ,output v-curr-rowid
     1149             ) no-error.
     1150           if error-status :error then do:
     1151             return error return-value .
     1152           end.
     1153           if v-action = "+delete" then do:
     1154             find first buf_temp-rp-by-call where
     1155                       rowid(buf_temp-rp-by-call) = v-curr-rowid.
     1156             buf_temp-rp-by-call.action = integer('99':U).
     1157           end.
     1158         end.
     1159         when 'prop-ref-call':U
     1160         then do:
     1161           run proc-load-standart in p-imp-handle
     1162             ( input 'prop-ref-call':U
     1163               ,input '':U
     1164               ,input (buffer buf_temp-prop-ref-call:handle)
     1165               ,input p-imp-handle
     1166               ,input 0
     1167               ,output v-curr-rowid
     1168             ) no-error.
     1169           if error-status :error then do:
     1170             return error return-value .
     1171           end.
     1172           if v-action = "+delete" then do:
     1173             find first buf_temp-prop-ref-call where
     1174                       rowid(buf_temp-prop-ref-call) = v-curr-rowid.
     1175             buf_temp-prop-ref-call.action = integer('99':U).
     1176           end.
     1177         end.
     1178         otherwise do:
     1179           run waitfram-hide in this-procedure .
     1180           message
     1181             vss-workfile vss-revision vss-description skip
     1182             "Не предусмотрен прием таблицы " v-rec-name skip
     1183             "в составе команды" 'cmd-dct-send':U skip
     1184             view-as alert-box error .
     1185           return error .
     1186         end.
     1187       END CASE.
     1188     end.
     1189     run waitfram-show in this-procedure ( substitute("           Обновление информации по &1:"
     1190                                                      , p-uniq-key-rec
     1191                                                      )
     1192                                          ).
     1193     if p-uniq-key-rec begins 'schedule':U
     1194     or (p-uniq-key-rec begins 'thbj-attr':U and v-is-obj)
     1195     and p-counter > 0
     1196     then do:
     1197       case entry(1, p-uniq-key-rec, chr(3)):
     1198         when 'schedule':U then do:
