        1   block-level on error undo, throw.
        2   using ibs.th.gbl.sys.objsrv.
        3   def var vss-revision    as character no-undo init "$Revision$":U .
        4   def var vss-author      as character no-undo init "$Author$":U .
        5   def var vss-date        as character no-undo init "$Date$":U .
        6   def var vss-workfile    as character no-undo init "$Workfile$":U .
        7   def var vss-archive     as character no-undo init "$Archive$":U .
        8   def var vss-description as character no-undo init "Чистка marking с датой последнего изменения более 1 года".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define new global shared variable g#library  as handle no-undo .
       68   define new global shared variable g#library2 as handle no-undo .
       69   define   shared variable g#auto as logical no-undo.
       70   define   shared variable g#news as logical no-undo.
       71   define   shared variable g#oxml as logical no-undo.
       72   define   shared variable g#esys as logical no-undo.
       73   define   shared variable g#news-source-db as integer no-undo.
       74   define   shared variable g#esys-source-esys as integer no-undo.
       75   define   shared variable g#db-num as integer   no-undo .
       76   define   shared variable g#userid as character no-undo .
       77   define   shared variable g#passwd as character no-undo .
       78   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       79   define  shared variable g#auto-pid           as integer   no-undo .
       80   define  shared variable conn-par             as character no-undo .
       81   define  shared variable g#auto-user-id       as character no-undo .
       82   define  shared variable g#auto-user-login    as character no-undo .
       83   define  shared variable g#auto-user-password as character no-undo .
       84   define  shared variable v-socket             as logical   no-undo .
       85   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       86   define  shared variable auto-window-h     as handle    no-undo .
       87   define  shared variable auto-log-msg-h    as handle    no-undo .
       88   define  shared variable hand-log-msg-h    as handle    no-undo .
       89   define  shared variable log-file-name     as character no-undo initial ? .
       90   define  shared variable add-log-file-name as character no-undo initial ? .
       91   define  shared variable writelogvalue     as character no-undo initial ? .
       92   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       93   procedure cur-time :
       94      define output parameter p-today as date      no-undo .
       95      define output parameter p-time  as integer   no-undo .
       96     do
       97     on error undo, return error
       98     :
       99       define variable v-date1 as date      no-undo .
      100       define variable v-date2 as date      no-undo .
      101       define variable v-time  as integer   no-undo .
      102       assign
      103         v-date1 = today
      104         v-time  = time
      105         v-date2 = today
      106       .
      107       if v-date1 <> v-date2
      108       then do:
      109         assign
      110           v-date1 = today
      111           v-time  = v-time
      112         .
      113       end.
      114       assign
      115         p-today = v-date1
      116         p-time  = v-time
      117       .
      118     end.
      119   end.
      120   function cur-time-date returns character
      121   :
      122     return string(today, '99/99/9999':U) .
      123   end.
      124   function cur-time-mjd returns decimal
      125   :
      126     define variable v-date as date      no-undo .
      127     define variable v-time as integer   no-undo .
      128     run cur-time in this-procedure
      129       (output v-date
      130       ,output v-time
      131       ) .
      132     return integer(v-date) - 2400002 + (v-time / 86400) .
      133   end.
      134   function cur-time-get-ending-index returns integer
      135   (input p-number as integer
      136   )
      137   :
      138     if p-number < 0
      139     or p-number = ?
      140     then do:
      141       return 1 .
      142     end.
      143     define variable v-rest as integer   no-undo .
      144     assign
      145       p-number = p-number modulo 100
      146     .
      147     if p-number < 20
      148     then do:
      149       assign
      150         v-rest = p-number
      151       .
      152     end.
      153     else do:
      154       assign
      155         v-rest = p-number modulo 10
      156       .
      157     end.
      158     case v-rest :
      159       when 1
      160       then do:
      161         return 2 .
      162       end.
      163       when 2 or
      164       when 3 or
      165       when 4
      166       then do:
      167         return 3 .
      168       end.
      169       otherwise do:
      170         return 1 .
      171       end.
      172     end case .
      173   end.
      174   procedure cur-time-mjd-to-date :
      175      define input  parameter i-mjd-diff as decimal no-undo.
      176      define output parameter o-Date     as date    no-undo.
      177      define output parameter o-Time     as integer no-undo.
      178      define variable v-day-number as integer   no-undo .
      179      if    i-mjd-diff < 0
      180         or i-mjd-diff = ?
      181      then do:
      182         return "?" .
      183      end.
      184      assign
      185         v-day-number = truncate(i-mjd-diff,0).
      186         o-Date = date(v-day-number + 2400002).
      187         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      188     .
      189   end.
      190   function cur-time-mjd-to-string returns character
      191   (input p-mjd-diff as decimal
      192   )
      193   :
      194     define variable v-day-number as integer   no-undo .
      195     define variable v-seconds    as integer   no-undo .
      196     define variable v-hour       as integer   no-undo .
      197     define variable v-min        as integer   no-undo .
      198     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      199     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      200     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      201     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      202     if p-mjd-diff < 0
      203     or p-mjd-diff = ?
      204     then do:
      205       return "?" .
      206     end.
      207     assign
      208       v-day-number = integer(truncate(p-mjd-diff,0))
      209       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      210     .
      211     if v-seconds > 86400
      212     then do:
      213       assign
      214         v-seconds = 86400 - 1
      215       .
      216     end.
      217     if v-seconds < 0
      218     then do:
      219       assign
      220         v-seconds = 0
      221       .
      222     end.
      223     assign
      224       v-hour = truncate(v-seconds / 3600, 0)
      225     .
      226     assign
      227       v-seconds = v-seconds modulo 3600
      228     .
      229     assign
      230       v-min = truncate(v-seconds / 60, 0)
      231     .
      232     assign
      233       v-seconds = v-seconds modulo 60
      234     .
      235     return
      236         (if v-day-number <> 0
      237           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      238           else ""
      239         )
      240       + (if v-day-number <> 0 or v-hour <> 0
      241           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      242           else ""
      243         )
      244       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      245           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      246           else ""
      247         )
      248       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      249       .
      250   end.
      251   function cur-time-string returns character
      252   :
      253     define variable v-date as date      no-undo .
      254     define variable v-time as integer   no-undo .
      255     run cur-time in this-procedure
      256       (output v-date
      257       ,output v-time
      258       ) .
      259     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      260   end.
      261   function cur-time-string-sec returns character
      262   :
      263     define variable v-date as date      no-undo .
      264     define variable v-time as integer   no-undo .
      265     run cur-time in this-procedure
      266       (output v-date
      267       ,output v-time
      268       ) .
      269     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      270   end.
      271   function cur-time-custom  returns character
      272   (input p-prefix as character
      273   ,input p-date-format as character
      274   ,input p-delimiter as character
      275   ,input p-time-format as character
      276   ,input p-suffix as character
      277   )
      278   :
      279     define variable v-date as date      no-undo .
      280     define variable v-time as integer   no-undo .
      281     run cur-time in this-procedure
      282       (output v-date
      283       ,output v-time
      284       ) .
      285     return
      286       p-prefix
      287       + string(v-date, p-date-format)
      288       + p-delimiter
      289       + string(v-time, p-time-format)
      290       + p-suffix
      291       .
      292   end.
      293   function cur-time-print  returns character
      294   :
      295     define variable v-date as date      no-undo .
      296     define variable v-time as integer   no-undo .
      297     run cur-time in this-procedure
      298       (output v-date
      299       ,output v-time
      300       ) .
      301     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      302   end.
      303   function cur-time-datetime returns datetime
      304   :
      305     define variable v-char as character no-undo .
      306     define variable v-datetime as datetime no-undo .
      307     v-char = cur-time-string().
      308     v-datetime = datetime(v-char).
      309     return  v-datetime.
      310   end.
      311   function cur-time-string-msec returns character
      312   :
      313     define variable v-date as datetime  no-undo .
      314     v-date = now.
      315     return string(v-date) .
      316   end.
      317   define stream LogStream .
      318   define variable mNoTime as logical no-undo.
      319   procedure write-to-log-notime :
      320     define input param i-str as character no-undo .
      321     mNoTime = yes.
      322     run write-to-log (i-str).
      323     mNoTime = no.
      324   end.
      325   procedure write-to-log :
      326     define input param p-str as character no-undo .
      327     do
      328     on error  undo, return error substitute( "&1 (write-to-log). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      329     on stop   undo, return error substitute( "&1 (write-to-log). stop", vss-workfile )
      330     on endkey undo, return error substitute( "&1 (write-to-log). endkey", vss-workfile )
      331     :
      332       define variable log-res        as logical   no-undo .
      333       define variable v-jj           as integer   no-undo .
      334       if    mNoTime
      335          or writelogvalue eq "AsyncProc"
      336       then
      337          p-str = substitute( "&1 (pid: &2) &3&4"   , g#auto-user-id, g#auto-pid,                        p-str, chr(10) ).
      338       else
      339          p-str = substitute( "&1 (pid: &2) &3 &4&5", g#auto-user-id, g#auto-pid, cur-time-string-sec(), p-str, chr(10) ).
      340       if auto-log-msg-h <> ? then do:
      341         log-res = auto-log-msg-h:move-to-eof( ) .
      342         log-res = auto-log-msg-h:insert-string( p-str ).
      343       end.
      344       if hand-log-msg-h <> ? then do:
      345         log-res = hand-log-msg-h:move-to-eof( ) .
      346         log-res = hand-log-msg-h:insert-string( p-str ).
      347       end.
      348       assign
      349         p-str = replace(p-str, (chr(10) + chr(13)), chr(10) )
      350         p-str = replace(p-str, (chr(13) + chr(10)), chr(10) )
      351         p-str = replace(p-str, chr(10), (chr(13) + chr(10)) )
      352       .
      353       if add-log-file-name <> ? then do:
      354         do v-jj = 1 to num-entries(add-log-file-name, chr(1)):
      355           run gbl/fileapnd.p
      356             ( input entry(v-jj, add-log-file-name, chr(1) )
      357             ,input p-str
      358             ,input 20
      359             ) no-error .
      360           if error-status:error then do:
      361             return error return-value .
      362           end.
      363         end.
      364       end.
      365       if writelogvalue eq "AsyncProc"
      366       then do:
      367          p-str = trim(p-str, (chr(13) + chr(10)) )
      368       .
      369          Publish "WriteLogAsunc" (p-str,yes).
      370       end.
      371       else if writelogvalue <> "yes" then do:
      372         run gbl/fileapnd.p
      373           ( input log-file-name
      374           ,input p-str
      375           ,input 20
      376           ) no-error .
      377         if error-status:error then do:
      378           return error return-value .
      379         end.
      380       end.
      381     end.
      382   end procedure.
      383   procedure write-to-screen :
      384     define input param p-str as character no-undo .
      385     do
      386     on error  undo, return error substitute( "&1 (write-to-screen). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      387     on stop   undo, return error substitute( "&1 (write-to-screen). stop", vss-workfile )
      388     on endkey undo, return error substitute( "&1 (write-to-screen). endkey", vss-workfile )
      389     :
      390       define variable log-res as logical no-undo.
      391       assign
      392         p-str = substitute( "&1 (pid: &2) &3 &4&5", g#auto-user-id, g#auto-pid, cur-time-string-sec(), p-str, chr(10) )
      393       .
      394       if auto-log-msg-h <> ?
      395       then do:
      396         log-res = auto-log-msg-h:move-to-eof( ) .
      397         log-res = auto-log-msg-h:insert-string( p-str ).
      398       end.
      399       if hand-log-msg-h <> ?
      400       then do:
      401         log-res = hand-log-msg-h:move-to-eof( ) .
      402         log-res = hand-log-msg-h:insert-string( p-str ).
      403       end.
      404     end.
      405   end procedure.
      406   procedure send-msg-to-email :
      407     define input  parameter p-subject      as character no-undo .
      408     define input  parameter p-text-err     as character no-undo .
      409     define input  parameter p-attach-files as character no-undo .
      410     do
      411     on error  undo, return error substitute( "&1 (send-msg-to-email). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      412     on stop   undo, return error substitute( "&1 (send-msg-to-email). stop", vss-workfile )
      413     on endkey undo, return error substitute( "&1 (send-msg-to-email). endkey", vss-workfile )
      414     :
      415       define variable v-tth             as handle    no-undo .
      416       define variable v-value-character as character no-undo .
      417       define variable v-value-date      as date      no-undo .
      418       define variable v-value-decimal   as decimal   no-undo .
      419       define variable v-value-integer   as integer   no-undo .
      420       define variable v-value-logical   as logical   no-undo .
      421       define variable v-param-type      as character no-undo .
      422       define variable v-email       as character no-undo .
      423       define variable v-tmp-str     as character no-undo .
      424       define variable v-tmp1-str    as character no-undo .
      425       define variable v-ind         as integer   no-undo .
      426       define variable v-num-entries as integer   no-undo .
      427       delete object v-tth no-error.
      428       run adm/shattri.p
      429         ( input "get":U
      430          ,input  "":U
      431          ,input  0
      432          ,input  'auto-task':U
      433          ,input  'send-msg-to-email':U
      434          ,output v-value-character
      435          ,output v-value-date
      436          ,output v-value-decimal
      437          ,output v-value-integer
      438          ,output v-value-logical
      439          ,output v-param-type
      440          ,input-output table-handle v-tth
      441         ) no-error .
      442       if not error-status :error  then do:
      443         assign
      444           v-tmp-str = v-value-character
      445         .
      446       end.
      447       delete object v-tth no-error.
      448       assign
      449         v-tmp-str     = replace(v-tmp-str, (chr(10) + chr(13)), chr(44) )
      450         v-tmp-str     = replace(v-tmp-str, (chr(13) + chr(10)), chr(44) )
      451         v-tmp-str     = replace(v-tmp-str, chr(10), chr(44) )
      452         v-num-entries = num-entries( v-tmp-str, chr(44) )
      453         v-email       = "":U
      454       .
      455       do v-ind = 1 to v-num-entries
      456       :
      457         assign
      458           v-tmp1-str = entry( v-ind, v-tmp-str, chr(44) )
      459         .
      460         if trim( v-tmp1-str ) <> "":U then do:
      461           if v-email = "":U then do:
      462             assign
      463               v-email = v-tmp1-str
      464             .
      465           end.
      466           else do:
      467             assign
      468               v-email = v-email + chr(44) + v-tmp1-str
      469             .
      470           end.
      471         end.
      472       end.
      473       if v-email <> "":U then do:
      474         run gbl/sendmail.p
      475           ( input v-email
      476           , input p-subject
      477           , input p-text-err
      478           , input p-attach-files
      479           ) no-error .
      480         if error-status :error
      481           or return-value <> "":U
      482         then do:
      483           return error substitute( "&1 (send-msg-to-email). &2", vss-workfile, return-value ) .
      484         end.
      485       end.
      486     end.
      487   end procedure.
      488   define  shared variable nws-exch-dir as character no-undo .
      489   define  shared variable nws-heap-dir as character no-undo .
      490   define variable err-mess as character no-undo .
      491   define temp-table t-pck-conf no-undo
      492     field db-num-dst      as integer
      493     field db-num-src      as integer
      494     field pack-num        as integer
      495     field total-recs      as integer
      496     field sys-key         as character
      497     field src_db-key      as character
      498     field dst_db-key      as character
      499     field ver-num         as character
      500     field prev-crc        as character
      501     field actual-date     as date
      502     field actual-time-int as integer
      503   .
      504   def var vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      505   define variable vss-include-info4 as character format "X(65)" no-undo
      506   initial "@(#)$Workfile$ $Revision$".
      507   procedure xmlchar-test :
      508   define input parameter p-in-string          as character        no-undo.
      509   define output parameter p-out-string-enc    as character        no-undo.
      510   define output parameter p-out-string-dec    as character        no-undo.
      511   do
      512   on error undo, return error
      513   :
      514          run xmlchar-encode in this-procedure
      515       (
      516             input p-in-string
      517           , output p-out-string-enc
      518       ).
      519          run xmlchar-decode in this-procedure
      520       (
      521             input p-out-string-enc
      522           , output p-out-string-dec
      523       ).
      524   end.
      525   end .
      526   procedure xmlchar-encode :
      527   define input parameter p-in-string      as character        no-undo.
      528   define output parameter p-out-string    as character        no-undo.
      529       define variable v-position      as integer      no-undo.
      530       define variable v-current-char  as character    no-undo.
      531   do
      532   on error undo, return error
      533   :
      534       assign
      535           p-out-string = "":U
      536       .
      537       case p-in-string
      538       :
      539           when ?
      540           then do:
      541               assign
      542                   p-out-string = "?":U
      543               .
      544           end.
      545           when "?":U
      546           then do:
      547               assign
      548                   p-out-string = "&#63;":U
      549               .
      550           end.
      551           otherwise do:
      552               do v-position = 1 to length( p-in-string )
      553               :
      554                   assign
      555                       v-current-char = substring( p-in-string, v-position, 1 )
      556                   .
      557                   case v-current-char
      558                   :
      559                       when "&":U
      560                       then do:
      561                           assign
      562                               p-out-string = p-out-string + "&amp;":U
      563                           .
      564                       end.
      565                       when ">":U
      566                       then do:
      567                           assign
      568                               p-out-string = p-out-string + "&gt;":U
      569                           .
      570                       end.
      571                       when "<":U
      572                       then do:
      573                           assign
      574                               p-out-string = p-out-string + "&lt;":U
      575                           .
      576                       end.
      577                       when "'":U
      578                       then do:
      579                           assign
      580                               p-out-string = p-out-string + "&apos;":U
      581                           .
      582                       end.
      583                       when '"':U
      584                       then do:
      585                           assign
      586                               p-out-string = p-out-string + "&quot;":U
      587                           .
      588                       end.
      589                       when chr(1)
      590                       then do:
      591                           assign
      592                               p-out-string = p-out-string + "":U
      593                           .
      594                       end.
      595                       when chr(2)
      596                       then do:
      597                           assign
      598                               p-out-string = p-out-string + "":U
      599                           .
      600                       end.
      601                       when chr(3)
      602                       then do:
      603                           assign
      604                               p-out-string = p-out-string + "":U
      605                           .
      606                       end.
      607                       when chr(4)
      608                       then do:
      609                           assign
      610                               p-out-string = p-out-string + "":U
      611                           .
      612                       end.
      613                       when chr(5)
      614                       then do:
      615                           assign
      616                               p-out-string = p-out-string + "":U
      617                           .
      618                       end.
      619                       when chr(6)
      620                       then do:
      621                           assign
      622                               p-out-string = p-out-string + "":U
      623                           .
      624                       end.
      625                       when chr(7)
      626                       then do:
      627                           assign
      628                               p-out-string = p-out-string + "":U
      629                           .
      630                       end.
      631                       when chr(8)
      632                       then do:
      633                           assign
      634                               p-out-string = p-out-string + "":U
      635                           .
      636                       end.
      637                       when chr(9)
      638                       then do:
      639                           assign
      640                               p-out-string = p-out-string + "":U
      641                           .
      642                       end.
      643                       when chr(29)
      644                       then do:
      645                           assign
      646                               p-out-string = p-out-string + "":U
      647                           .
      648                       end.
      649                       when chr(10)
      650                       then do:
      651                           assign
      652                               p-out-string = p-out-string + "&#10;":U
      653                           .
      654                       end.
      655                       when chr(13)
      656                       then do:
      657                           assign
      658                               p-out-string = p-out-string + "&#13;":U
      659                           .
      660                       end.
      661                       otherwise do:
      662                           assign
      663                               p-out-string = p-out-string + v-current-char
      664                           .
      665                       end.
      666                   end case.
      667               end.
      668           end.
      669       end case.
      670   end.
      671   end .
      672   procedure xmlchar-encode-1c :
      673   define input parameter p-in-string      as character        no-undo.
      674   define output parameter p-out-string    as character        no-undo.
      675       define variable v-position      as integer      no-undo.
      676       define variable v-current-char  as character    no-undo.
      677   do
      678   on error undo, return error
      679   :
      680       assign
      681           p-out-string = "":U
      682       .
      683       case p-in-string
      684       :
      685           when ?
      686           then do:
      687               assign
      688                   p-out-string = "?":U
      689               .
      690           end.
      691           otherwise do:
      692               do v-position = 1 to length( p-in-string )
      693               :
      694                   assign
      695                       v-current-char = substring( p-in-string, v-position, 1 )
      696                   .
      697                   case v-current-char
      698                   :
      699                       when chr(1)
      700                       then do:
      701                           assign
      702                               p-out-string = p-out-string + " ":U
      703                           .
      704                       end.
      705                       when chr(2)
      706                       then do:
      707                           assign
      708                               p-out-string = p-out-string + " ":U
      709                           .
      710                       end.
      711                       when chr(3)
      712                       then do:
      713                           assign
      714                               p-out-string = p-out-string + " ":U
      715                           .
      716                       end.
      717                       when chr(4)
      718                       then do:
      719                           assign
      720                               p-out-string = p-out-string + " ":U
      721                           .
      722                       end.
      723                       when chr(5)
      724                       then do:
      725                           assign
      726                               p-out-string = p-out-string + " ":U
      727                           .
      728                       end.
      729                       when chr(6)
      730                       then do:
      731                           assign
      732                               p-out-string = p-out-string + " ":U
      733                           .
      734                       end.
      735                       when chr(7)
      736                       then do:
      737                           assign
      738                               p-out-string = p-out-string + " ":U
      739                           .
      740                       end.
      741                       when chr(8)
      742                       then do:
      743                           assign
      744                               p-out-string = p-out-string + " ":U
      745                           .
      746                       end.
      747                       when chr(9)
      748                       then do:
      749                           assign
      750                               p-out-string = p-out-string + " ":U
      751                           .
      752                       end.
      753                       when chr(29)
      754                       then do:
      755                           assign
      756                               p-out-string = p-out-string + " ":U
      757                           .
      758                       end.
      759                       when chr(10)
      760                       then do:
      761                           assign
      762                               p-out-string = p-out-string + " ":U
      763                           .
      764                       end.
      765                       when chr(13)
      766                       then do:
      767                           assign
      768                               p-out-string = p-out-string + " ":U
      769                           .
      770                       end.
      771                       otherwise do:
      772                           assign
      773                               p-out-string = p-out-string + v-current-char
      774                           .
      775                       end.
      776                   end case.
      777               end.
      778           end.
      779       end case.
      780   end.
      781   end .
      782   procedure xmlchar-decode :
      783   define input parameter p-in-string      as character        no-undo.
      784   define output parameter p-out-string    as character        no-undo.
      785       define variable v-position      as integer      no-undo.
      786       define variable v-last-position as integer      no-undo.
      787       define variable v-temp-integer  as integer      no-undo.
      788       define variable v-current-char  as character    no-undo.
      789       define variable v-next-char     as character    no-undo.
      790       define variable v-success       as logical      no-undo.
      791   do
      792   on error undo, return error
      793   :
      794       assign
      795           p-out-string = "":U
      796           v-position   = 0
      797       .
      798       replace-cycle:
      799       do while yes
      800       on error undo, return error
      801       :
      802           assign
      803               v-last-position = index( p-in-string, "&":U, v-position + 1 )
      804           .
      805           if v-last-position <= v-position
      806           then do:
      807               if v-position = 0
      808               then do:
      809                   assign
      810                       p-out-string = p-in-string
      811                   .
      812               end.
      813               else do:
      814                   assign
      815                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
      816                   .
      817               end.
      818               leave replace-cycle.
      819           end.
      820           else do:
      821               assign
      822                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
      823                   v-position      = v-last-position
      824                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
      825               .
      826               if v-current-char = "#":U
      827               then do:
      828                   assign
      829                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
      830                   .
      831                   if v-last-position > 0
      832                   then do:
      833                       run xmlchar-read-integer in this-procedure
      834                        (
      835                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
      836                           , output v-temp-integer
      837                           , output v-success
      838                       ).
      839                       if v-success = yes
      840                       and v-temp-integer >= 1
      841                       and v-temp-integer <= 255
      842                       then do:
      843                           assign
      844                               p-out-string = p-out-string + chr( v-temp-integer )
      845                               v-position   = v-last-position + 1
      846                           .
      847                       end.
      848                       else do:
      849                           assign
      850                               p-out-string = p-out-string + "&":U
      851                               v-position   = v-position   + 1
      852                           .
      853                       end.
      854                   end.
      855                   else do:
      856                       assign
      857                           p-out-string = p-out-string + "&":U
      858                           v-position   = v-position   + 1
      859                       .
      860                   end.
      861               end.
      862               else do:
      863                   case substring( p-in-string, v-position + 1, 3 )
      864                   :
      865                       when "lt;":U
      866                       then do:
      867                           assign
      868                               p-out-string = p-out-string + "<":U
      869                               v-position   = v-position   + 3
      870                           .
      871                       end.
      872                       when "gt;":U
      873                       then do:
      874                           assign
      875                               p-out-string = p-out-string + ">":U
      876                               v-position   = v-position   + 3
      877                           .
      878                       end.
      879                       otherwise do:
      880                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
      881                           then do:
      882                               assign
      883                                   p-out-string = p-out-string + "&":U
      884                                   v-position   = v-position   + 4
      885                               .
      886                           end.
      887                           else do:
      888                               case substring( p-in-string, v-position + 1, 5 )
      889                               :
      890                                   when "quot;":U
      891                                   then do:
      892                                       assign
      893                                           p-out-string = p-out-string + '"':U
      894                                           v-position   = v-position   + 5
      895                                       .
      896                                   end.
      897                                   when "apos;":U
      898                                   then do:
      899                                       assign
      900                                           p-out-string = p-out-string + "'":U
      901                                           v-position   = v-position   + 5
      902                                       .
      903                                   end.
      904                                   otherwise do:
      905                                       assign
      906                                           p-out-string = p-out-string + "&":U
      907                                       .
      908                                   end.
      909                               end case.
      910                           end.
      911                       end.
      912                   end case.
      913               end.
      914           end.
      915       end.
      916   end.
      917   end .
      918   procedure xmlchar-read-integer :
      919   define input parameter p-input-string      as character        no-undo.
      920   define output parameter p-output-integer   as integer          no-undo.
      921   define output parameter p-success       as logical          no-undo.
      922   do
      923   on error undo, return error
      924   :
      925       assign
      926           p-output-integer = integer( p-input-string )
      927       no-error.
      928       if error-status :error
      929       then do:
      930           assign
      931               p-success           = no
      932               p-output-integer    = 0
      933           .
      934       end.
      935       else do:
      936           assign
      937               p-success           = yes
      938           .
      939       end.
      940   end.
      941   end.
      942   def var objSrv as class ibs.th.gbl.sys.objsrv no-undo.
      943   run gbl/getobjsrvhndl.p (input-output ObjSrv).
      944   define new global shared variable g#attr-lib  as handle no-undo .
      945   define variable v-attr-lib-variable as handle no-undo .
      946   define variable mMRCCode  as logical    no-undo.
      947   define variable mTypeMark as character  no-undo.
      948   function IS-NeedMark returns logical
      949   ( input ib-code as integer  ,
      950     input ib-str as character ):
      951      define buffer buf_prod-bc-attr for ub.prod-bc-attr.
      952      find first buf_prod-bc-attr where buf_prod-bc-attr.b-code eq ib-code
      953                                    and buf_prod-bc-attr.b-str  eq ib-str
      954                                    and buf_prod-bc-attr.attr-code eq 'mark':U
      955        no-lock no-error.
      956      return if available buf_prod-bc-attr then logical(buf_prod-bc-attr.attr-value) else no .
      957   end.
      958   function repTegforDm return char
      959   (iDM as char ):
      960       define variable vTeglist as character no-undo init "01,02,11,13,17,21,8005,37".
      961       define variable vteg as character no-undo.
      962       define variable oDM as character no-undo.
      963       define variable vi as integer no-undo.
      964       oDM = iDm.
      965       do vi = 1 to num-entries(vTeglist):
      966          vTeg = entry(vi,vTeglist).
      967          oDM = replace(oDM,"(" + vTeg + ")",vTeg).
      968       end.
      969       return oDM.
      970   end.
      971   function repSpecSimbforDm return char
      972   (iDM as char ):
      973       define variable oDM as character no-undo.
      974     run
      975       xmlchar-decode(iDM, output oDM).
      976     return repTegforDm (oDM).
      977   end.
      978   function CheckGtin return logical
      979   (iGtin as char):
      980      define variable bar_code as character no-undo.
      981      define variable vGtin as logical no-undo init "yes".
      982      if length(iGtin) eq 14
      983      then do:
      984         bar_code = substr (iGtin, 1, length (iGtin) - 1).
      985         run str/chk-sum.p
      986          (input-output bar_code ) no-error .
      987         if iGtin ne  bar_code
      988         then
      989            vGtin = no.
      990      end.
      991      else
      992         vGtin = no.
      993      return vgtin.
      994   end.
      995   function repSpecSimbforXlm return char
      996   (iDM as char ):
      997       iDM = replace(iDM,chr(29),"").
      998       return iDM.
      999   end.
     1000   function getGtinByDM return char
     1001   (IDM as char):
     1002      define variable VTXT as char no-undo.
     1003      define variable vGtin as char no-undo.
     1004      vTXt = IdM.
     1005      vGtin = IDM.
     1006      if    length(vtxt) > 14
     1007      then do:
     1008         if   vtxt begins "(01)"
     1009                or vtxt begins "(02)"
     1010         then
     1011            vGtin = substring(vtxt,5,14).
     1012         else if   (vtxt begins "01"
     1013                or vtxt begins "02" )
     1014                and (   (    substring(iDm,17,2) eq "21"
     1015                         and length(vtxt) >= 21)
     1016                     or substring(iDm,17,2) eq "37"
     1017                     or substring(iDm,17,4) eq "(37)" )
     1018         then do:
     1019            vGtin = substring(vtxt,3,14).
     1020            if not checkGtin(vGtin)
     1021            then
     1022               vGtin = substring(vtxt,1,14).
     1023         end.
     1024         else if     length(vtxt) eq 14 + 7 + 4 + 4
     1025             or length(vtxt) eq 14 + 7 + 4
     1026             or length(vtxt) eq 14 + 7
     1027         then
     1028            vGtin = substring(vtxt,1,14).
     1029      end.
     1030      if not checkGtin(vGtin)
     1031      then
     1032         vGtin = "".
     1033      return vgtin.
     1034   end.
     1035   function getGdsCodeByGtin return int
     1036   (iGtin as char):
     1037      define buffer prod-bc  for ub.prod-bc.
     1038      define buffer bar-code for ub.bar-code.
     1039      find first prod-bc where prod-bc.b-str eq iGtin  and prod-bc.bc-on no-lock no-error.
     1040      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
     1041      return if avail bar-code then bar-code.gds-code else ?.
     1042   end.
     1043   function getQntyCodeByGtin return decimal
     1044   (iGtin as char):
     1045      define buffer prod-bc  for ub.prod-bc.
     1046      define buffer bar-code for ub.bar-code.
     1047      find first prod-bc where prod-bc.b-str eq iGtin no-lock no-error.
     1048      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
     1049      return if avail bar-code then bar-code.cli-base-rate else ?.
     1050   end.
     1051   function getGdsCodeByDM return int
     1052   (iDm as char):
     1053      define variable vGtin as char no-undo.
     1054      define buffer prod-bc for ub.prod-bc.
     1055      vGtin  = getGtinByDM (IDM ).
     1056      return getGdsCodeByGtin (vGtin).
     1057   end.
     1058   function ChekTypeMarkByGds return logical
     1059   (iGds-code as integer ):
     1060      define buffer goods-attr for ub.goods-attr.
     1061      find first goods-attr where goods-attr.gds-code   = iGds-code
     1062                              and goods-attr.attr-code  = 'mark-type':U
     1063      no-lock no-error.
     1064      if available goods-attr
     1065      then do:
     1066         mTypeMark = goods-attr.attr-value.
     1067         return goods-attr.attr-value = objsrv:Env:Marking:Types:tabak:NameProp
     1068           .
     1069      end.
     1070      else
     1071         return no.
     1072   end.
     1073   function ChekTypeMarkByDm return logical
     1074   (iDM as char ):
     1075      return ChekTypeMarkByGds(getGdsCodeByDM(idm)).
     1076   end.
     1077   function ChekTypeMarkByGtin return logical
     1078   (iGtin as char ):
     1079      return ChekTypeMarkByGds(getGdsCodeByGtin(iGtin)).
     1080   end.
     1081   function GetNextElement return character
     1082     (input iAllTeg        as logical
     1083     ,output oteg          as character
     1084     ,output otegval       as character
     1085     ,input-output pstr    as character
     1086      ):
     1087        define variable vlistElem   as character no-undo init "00,01,02,21,17,11,13,(01),(02),(21),(17),(11),(13)".
     1088        define variable vlistleng   as character no-undo init "27,14,14,13,06,06,06,0014,0014,0013,0006,0006,0006".
     1089        define variable vlistElemDop   as character no-undo init ",37,(37),(8005),8005,93,(93)".
     1090        define variable vlistlengDop   as character no-undo init ",08,0008,000006,0006,04,0004".
     1091        define variable vTeg as character no-undo.
     1092        define variable vLength as integer no-undo.
     1093        define variable vi as integer no-undo.
     1094        define variable vj as integer no-undo.
     1095        define buffer code for ub.code.
     1096        find first code where Code.parent eq "MarkType"
     1097                          and Code.CodeValue   eq mTypeMark
     1098                          no-lock no-error.
     1099        if     available code
     1100           and Code.misc1 ne ""
     1101           and Code.misc1 ne ?
     1102        then do:
     1103           integer (Code.misc1) no-error.
     1104           if not error-status:error
     1105           then
     1106             entry (4,vlistleng) = Code.misc1.
     1107        end.
     1108        if iAllTeg
     1109        then
     1110           assign
     1111              vlistElem     = vlistElem    + vlistElemDop
     1112              vlistleng     = vlistleng    + vlistlengDop
     1113           .
     1114        else if mMRCCode
     1115        then
     1116           assign
     1117              vlistElem     = vlistElem    + ",(8005),8005"
     1118              vlistleng     = vlistleng    + ",000006,0006"
     1119           .
     1120       block-elem:
     1121       do vi = 1 to num-entries(vlistElem):
     1122          vTeg = entry(vi,vlistElem).
     1123          if pstr begins vTeg
     1124          then do:
     1125             if    vTeg eq "21"
     1126             then
     1127                vLength = index(pstr,chr(29)) - 2 no-error.
     1128             if vLength  <= 0
     1129             then
     1130                vLength = int(entry(vi,vlistleng)).
     1131             otegval = substring (pstr,length(vteg) + 1, vLength).
     1132             oteg = replace(replace(vteg,")",""),"(","").
     1133             vTeg = vteg + otegval.
     1134             otegval = replace(otegval,chr(29),"").
     1135             oteg = replace(replace(oteg,")",""),"(","").
     1136             pstr = substring (pstr,length(vTeg)+ 1).
     1137             vTeg = replace(vTeg,chr(29),"").
     1138             leave block-elem.
     1139          end.
     1140          else
     1141             vTeg = "".
     1142       end.
     1143       return vteg.
     1144   end.
     1145   function GetCodeIdent return character
     1146   (iDm as char):
     1147      define variable Velement   as character no-undo init "first".
     1148      define variable oCodeIdent as character no-undo.
     1149      define variable vteg as character no-undo.
     1150      define variable vtegval as character no-undo.
     1151      define variable vGtin as character no-undo.
     1152      define buffer marking for ub.marking.
     1153      for first marking no-lock where
     1154                marking.mark eq iDm
     1155            and marking.unit-ext = "LEVEL2"
     1156      :
     1157        return iDm.
     1158      end.
     1159      vGtin  = getGtinByDM (iDm ).
     1160      ChekTypeMarkByDm(idm).
     1161      if iDm begins 'tech_':U
     1162      then
     1163         oCodeIdent = iDm.
     1164      else if length(iDm) < 21
     1165      then do:
     1166         find first marking where marking.mark eq idm
     1167         no-lock no-error.
     1168         oCodeIdent = if available marking then marking.mark else  ?.
     1169      end.
     1170      else if     length(iDm) eq 29
     1171         and not iDm begins "01"
     1172         and not iDm begins "02"
     1173      then
     1174         oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21 ).
     1175      else  if     length(iDm) >= 24
     1176               and (  iDm begins "01"
     1177                   or iDm begins "02")
     1178               and  substring(iDm,17,2) ne "21"
     1179      then do:
     1180         if checkGtin(substring(iDm,1,14)) and ( (length(idm) eq 25 and substring(iDm,22,1) eq "A")
     1181                                                   or (length(idm) eq 29 and substring(iDm,22,1) eq "A"))
     1182         then
     1183            oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21).
     1184         else
     1185            oCodeIdent = iDM.
     1186      end.
     1187      else  if     (   length(iDm) eq 25
     1188                    or length(iDm) eq 21)
     1189               and (not iDm begins "01"
     1190               and  not iDm begins "02")
     1191      then
     1192         oCodeIdent = substring(iDm,1,21).
     1193      else if vGtin = substring(iDm,1,14) and checkGtin(substring(iDm,1,14)) and ( length(idm) eq 21 or (length(idm) eq 25 and substring(iDm,22,1) eq "A"))
     1194      then
     1195         oCodeIdent = substring(iDm,1,21).
     1196      else do while Velement ne "" and idm ne "":
     1197         Velement = GetNextElement(no,output vteg, output vtegval, input-output idm).
     1198         oCodeIdent = oCodeIdent + Velement.
     1199      end.
     1200      return oCodeIdent.
     1201   end.
     1202   function GetTegCod return character
     1203   (icodeIdent as char, iTeg as char):
     1204      define variable Velement   as character no-undo init "first".
     1205      define variable oTeg as character no-undo init ?.
     1206      define variable vteg as character no-undo.
     1207      define variable vtegval as character no-undo.
     1208      if     ((length(icodeIdent) eq 21
     1209         and not icodeIdent begins "01"
     1210         and not icodeIdent begins "02")
     1211         or
     1212             ( length(icodeIdent) eq 25
     1213               and not icodeIdent begins "01"
     1214               and not icodeIdent begins "02"))
     1215      then do:
     1216         if iTeg eq "01" or iTeg eq "02"
     1217         then
     1218            oTeg = substring(icodeIdent,1,21).
     1219         else  if  iTeg eq "21"
     1220         then
     1221            oTeg = substring(icodeIdent,15,7).
     1222      end.
     1223      else do:
     1224         ChekTypeMarkByDm(icodeIdent).
     1225         block-teg:
     1226            do while Velement ne "" and icodeIdent ne "":
     1227            Velement = GetNextElement(yes,output vteg, output vtegval, input-output icodeIdent).
     1228            if    Velement begins iTeg
     1229               or Velement begins "(" + iTeg + ")"
     1230            then do:
     1231               oTeg = vtegval.
     1232               leave block-teg.
     1233            end.
     1234         end.
     1235      end.
     1236      return oTeg.
     1237   end.
     1238   function isOAD return logical
     1239   (icodeIdent as character):
     1240      return length(icodeIdent) > 18 and GetTegCod(icodeIdent,"37") ne ? and GetTegCod(icodeIdent,"02") ne ?.
     1241   end.
     1242   function isMark return logical
     1243   (icodeIdent as character):
     1244      define buffer buf_marking for ub.marking.
     1245      return can-find(first buf_marking where buf_marking.mark begins icodeIdent) or
     1246             (length(icodeIdent) > 20 and not isOAD(icodeIdent)).
     1247   end.
     1248   function addBracketForCode return character
     1249   (icodeIdent as char):
     1250      define variable Velement   as character no-undo init "first".
     1251      define variable oTeg as character no-undo.
     1252      define variable vteg as character no-undo.
     1253      define variable vtegval as character no-undo.
     1254      define buffer marking for ub.marking.
     1255      find first marking no-lock where
     1256                 marking.mark begins icodeIdent no-error.
     1257      if    not ChekTypeMarkByDm(icodeIdent)
     1258         or length(icodeIdent) le 24
     1259         or (avail marking and marking.unit-ext = "LEVEL2")
     1260      then
     1261         oTeg = icodeIdent.
     1262      else do:
     1263         if (  icodeIdent begins "01"
     1264            or icodeIdent begins "02"
     1265            ) and CheckGtin(substring (icodeIdent,3,14))
     1266            and substring (icodeIdent,17,2) eq "21"
     1267         then do:
     1268            mMRCCode = yes.
     1269            ChekTypeMarkByDm(icodeIdent).
     1270            block-teg:
     1271            do while Velement ne "" and icodeIdent ne "":
     1272               Velement = GetNextElement(no,output vteg, output vtegval, input-output icodeIdent).
     1273               if vteg ne ""
     1274               then
     1275                  oTeg = oTeg + "(" + vteg + ")" + vtegval .
     1276            end.
     1277            mMRCCode = no.
     1278         end.
     1279         else do:
     1280            oTeg = icodeIdent.
     1281         end.
     1282      end.
     1283      return oTeg.
     1284   end.
     1285   function getlevelByCodId return int
     1286   (iCode as char):
     1287      define variable vLength as int no-undo.
     1288      define variable vLevel  as int no-undo.
     1289      if not ChekTypeMarkByDM (icode) then return ?.
     1290      vLength = length(iCode).
     1291      if    vLength eq 18
     1292         or vLength eq 20
     1293      then
     1294         Vlevel = 4.
     1295      else if vLength eq 21
     1296      then
     1297         Vlevel = 1.
     1298      else if vLength eq 25
     1299      then do:
     1300         if  iCode begins "01"
     1301         then
     1302            Vlevel = 3.
     1303         else
     1304            Vlevel = 1.
     1305      end.
     1306      else if     vLength >= 26
     1307              and vLength <= 46
     1308      then do:
     1309         if    substring(iCode,17,2) eq "11"
     1310            or substring(iCode,17,2) eq "13"
     1311            or (    substring(iCode,17,2) eq "21"
     1312                and vLength >= 33
     1313                and substring(iCode,26,4) ne "8005")
     1314         then
     1315            Vlevel = 4.
     1316         else if    vLength eq 31
     1317                 or vLength eq 38
     1318                 or vLength eq 39
     1319                 or vLength eq 45
     1320         then
     1321            Vlevel = 1.
     1322         else if    vLength eq 35
     1323                 or vLength eq 43
     1324         then
     1325            Vlevel = 3.
     1326         else
     1327            Vlevel = ?.
     1328      end.
     1329      else
     1330         Vlevel = ?.
     1331      return Vlevel.
     1332   end.
     1333   function getLevelMotpBycodid return character
     1334   (iDm as char):
     1335      define variable vLevel as integer no-undo.
     1336      define variable vList as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     1337      vLevel = getlevelByCodId(iDm).
     1338      if    vLevel eq ?
     1339         or vLevel < 1
     1340         or vLevel > 6
     1341      then
     1342         return ?.
     1343      else
     1344         return entry(vlevel,vList).
     1345   end.
     1346   function getLevelUTDByLevelMotp return character
     1347   (iUnit as char):
     1348      define variable vLevel as integer no-undo.
     1349      define variable vListMOTP    as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     1350      define variable vListutd as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     1351      vLevel = lookup(iUnit,vListMOTP).
     1352      if    vLevel eq ?
     1353         or vLevel < 1
     1354         or vLevel > 4
     1355      then
     1356         return ?.
     1357      else
     1358         return entry(vlevel,vListutd).
     1359   end.
     1360   function getLevelMotpByDM return character
     1361   (iDm as char):
     1362      return getLevelMotpByCodId(GetCodeIdent(iDm)).
     1363   end.
     1364   function getLevelUTDByCodId return character
     1365   (iDm as char):
     1366      define variable vLevel as integer no-undo.
     1367      define variable vList as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     1368      vLevel = getlevelByCodId(iDm).
     1369      if    vLevel eq ?
     1370         or vLevel < 1
     1371         or vLevel > 4
     1372      then
     1373         return ?.
     1374      else
     1375         return entry(vlevel,vList).
     1376   end.
     1377   function getLevelUTDByDM return character
     1378   (iDm as char):
     1379      return getLevelUTDByCodId(GetCodeIdent(iDm)).
     1380   end.
     1381   define variable mNotMarkQnty as logical no-undo.
     1382   function getQntyUTDByCodId return decimal
     1383   (iDM as char):
     1384      define variable vLevel as integer no-undo.
     1385      define variable vList as character no-undo init "1,5,10,500".
     1386      define variable vGtin as character no-undo.
     1387      define variable vqnty as decimal no-undo init ?.
     1388      vqnty = dec(GetTegCod(iDM,"37")) no-error.
     1389      if vqnty eq ?
     1390      then do:
     1391         if not mNotMarkQnty
     1392         then do:
     1393            define buffer marking for ub.marking.
     1394            define variable vCodident as character no-undo.
     1395            vCodident = GetCodeIdent(idm).
     1396            find first marking where marking.mark begins vCodident no-lock no-error.
     1397            if     available marking
     1398               and marking.box-qnty ne ?
     1399            then
     1400               return marking.box-qnty.
     1401         end.
     1402         vGtin = getGtinByDm(iDM).
     1403         if ChekTypeMarkByGtin (vGtin)
     1404         then do:
     1405            vLevel = getlevelByCodId(iDM).
     1406            if     vLevel >= 1
     1407               and vLevel <= 4
     1408            then
     1409               vqnty = int(entry(vlevel,vList)).
     1410         end.
     1411         else
     1412            vqnty = getQntyCodeByGtin(vgtin).
     1413      end.
     1414      return vqnty.
     1415   end.
     1416   function getQntyUTDByDM return decimal
     1417   (iDm as char):
     1418      define variable vDM as character no-undo.
     1419      if     length (iDm) ne 25
     1420         and length (iDm) ne 29
     1421         and substring (iDm,length (iDm) - 6 + 1, 2 ) eq "93"
     1422      then
     1423         vDM = substring (iDm,1,length (iDm) - 6 ).
     1424      else
     1425         vDM = substring (iDm,1,length (iDm) - 4 ).
     1426      return getQntyUTDByCodId(vDM).
     1427   end.
     1428   function getMRC4 return decimal
     1429   (iMRC as char):
     1430      define variable oMrc     as decimal no-undo init ?.
     1431      define variable vAlphabet as character no-undo init "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!~"%&'*+-./_,:;=<>?".
     1432      define variable vi       as integer no-undo.
     1433      define variable vfound   as integer no-undo.
     1434      define variable vposStart   as integer no-undo.
     1435      do:
     1436      OMRc = 0.
     1437      do vi = 1 to 4:
     1438         define variable vsimb as character no-undo.
     1439         vsimb = substring(iMRC,vi,1).
     1440         vposStart = if keycode("Z") < keycode(vsimb) then 27 else 1.
     1441         vfound = index(vAlphabet,vsimb,vposStart) - 1.
     1442         if vfound > 0
     1443         then
     1444            OMRc = OMRc + exp (80,(4 - vi) ) * vfound  .
     1445         end.
     1446         OMRc = OMRc / 100.
     1447      end.
     1448      return OMRc.
     1449   end.
     1450   function getMRCByDM return decimal
     1451   (iDm as char):
     1452      define variable vMRC     as character no-undo.
     1453      define variable oMrc     as decimal no-undo init ?.
     1454      define variable Velement as character no-undo init "empty".
     1455      define variable vteg as character no-undo.
     1456      define variable vtegval as character no-undo.
     1457      if    length(idm) eq 14 + 7 + 4 + 4
     1458         or length(idm) eq 14 + 7 + 4
     1459      then do:
     1460         vMRC = substring(idm,22,4).
     1461         omrc = getMRC4(vMRC).
     1462      end.
     1463      else do:
     1464          ChekTypeMarkByDm(iDm).
     1465          block-mrc:
     1466          do while Velement ne "" and idm ne "":
     1467             Velement = GetNextElement(yes,output vteg, output vtegval, input-output idm).
     1468             if Velement begins "8005"
     1469             then do:
     1470                vMRC = substring(Velement,5,6).
     1471                leave block-mrc.
     1472             end.
     1473             else if Velement begins "(8005)"
     1474             then do:
     1475                vMRC = substring(Velement,7,6).
     1476                leave block-mrc.
     1477             end.
     1478          end.
     1479          if vMRC ne ""
     1480          then
     1481             OMRc = dec(vmrc) / 100 no-error.
     1482      end.
     1483      return OMRc.
     1484   end.
     1485   function MoveDate return Date
     1486   (idate as date,
     1487    iMonth as int64):
     1488      define variable vMonth   as int64 no-undo.
     1489      define variable vYear    as int64 no-undo.
     1490      define variable vDateNew as date  no-undo.
     1491       define variable vDay     as int64 no-undo.
     1492       vMonth = month(iDate) + iMonth.
     1493       vYear =  year(iDate).
     1494       if vMonth <= 0
     1495       then assign
     1496          vMonth = vMonth + 12
     1497           vYear  = vYear - 1
     1498       .
     1499       else if vMonth > 12
     1500       then assign
     1501          vMonth = vMonth - 12
     1502           vYear  = vYear + 1
     1503       .
     1504       vDateNew = date(vMonth,day(iDate),vYear) no-error.
     1505       do while error-status:error eq yes:
     1506          VDay = vDay + 1.
     1507          vDateNew = date(vMonth,day(iDate) - vDay,vYear) no-error.
     1508       end.
     1509       if VDay > 0
     1510       then
     1511          vDateNew + 1.
     1512       return vDateNew.
     1513   end.
     1514   procedure checkEMRC:
     1515   define input  parameter iDm as character no-undo.
     1516   define output parameter vok as logical   no-undo init yes.
     1517      define variable v-value-emrc as character no-undo.
     1518      define variable v-type-emrc  as character no-undo.
     1519      define variable vDateIso     as character no-undo.
     1520      define variable vMRC         as decimal no-undo.
     1521      define variable vqnty        as decimal no-undo.
     1522      define variable vPrice       as decimal no-undo.
     1523      define variable vparent      as character no-undo.
     1524      define variable vgds-code    as integer no-undo.
     1525      define buffer code for ub.code.
     1526      vMRC = getMRCByDM(iDm).
     1527      if vMRC > 0
     1528      then do:
     1529         vgds-code = getGdsCodeByDM(iDm).
     1530         vqnty     = getQntyUTDByDM(iDm).
     1531               if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     1532            (
     1533             input   vgds-code
     1534            ,input   'emrc-type':U
     1535            ,output   v-value-emrc
     1536            ,output   v-type-emrc
     1537          ) no-error.
     1538          if     v-value-emrc ne ""
     1539             and v-value-emrc ne ?
     1540          then do:
     1541             vDateIso = iso-date(today).
     1542             vPrice = vMRC / vqnty.
     1543             vparent ="emc" + chr(4) + v-value-emrc.
     1544             find last code where Code.parent      eq vparent
     1545                              and Code.code        le vDateIso
     1546                              and code.status_  eq 0
     1547             no-lock no-error.
     1548             if not available code or ( vPrice  >= dec(Code.CodeValue))
     1549             then
     1550                vOk = true .
     1551             else do:
     1552                 define variable vText      as character no-undo.
     1553                 define variable vDate      as date no-undo.
     1554                 define variable vDateLast  as character no-undo.
     1555                 define variable vDateFirst as character no-undo.
     1556                 define variable vDate3     as date no-undo.
     1557                 vdate = date(code.misc1).
     1558                 vDateLast = code.misc1.
     1559                 vDate3 = MoveDate(today, - 3 ).
     1560                 vText =  substitute ("ТОВАР ИМЕЕТ ОГРАНИЧЕННЫЙ СРОК РЕАЛИЗАЦИИ. Если товар произведен после &2, то его приемка и продажа запрещена.",
     1561                                      string(vDate3  , "99/99/9999"),
     1562                                      string(vDate   , "99/99/9999")
     1563                                      ).
     1564                 vdateIso = iso-date(vdate3).
     1565                 find last code  where Code.parent      eq vparent
     1566                                   and Code.code        le vDateIso
     1567                                   and code.status_  eq 0 no-lock no-error.
     1568                 if available code
     1569                 then
     1570                    vDateIso = code.code.
     1571                 vDateFirst = vDateIso.
     1572                 vDateLast = iso-date(vdate).
     1573                 define variable vGood as logical no-undo.
     1574                 define variable vDateSale as date no-undo.
     1575                 define buffer bcode for code.
     1576                 for last code where Code.parent   eq vparent
     1577                                 and code.status_  eq 0
     1578                                 and code.code     < vDateLast
     1579                                 and code.code     >= vDateFirst
     1580                 no-lock:
     1581                    find first bcode where bCode.parent   eq vparent
     1582                                       and bcode.status_  eq 0
     1583                                       and bcode.code     > code.code no-lock no-error.
     1584                    if available bcode
     1585                    then do:
     1586                       if vPrice < dec(Code.CodeValue)
     1587                       then
     1588                          vText = vtext + substitute ("&1Если товар произведен с &2 до &3, ТО ЕГО ПРИЕМКА И ПРОДАЖА ЗАПРЕЩЕНА",
     1589                                                     chr(10),
     1590                                                     string(    date( code.misc1)       ,"99/99/9999"),
     1591                                                     string(    date(bcode.misc1)       ,"99/99/9999")
     1592                                                     ).
     1593                       else do:
     1594                          vGood = yes.
     1595                          vDateSale = MoveDate(date(bcode.misc1), 3) - 1.
     1596                          vText = vtext + substitute ("&1Если товар произведен до &3, то продажа разрешена до &4.~Осталось &5 дней.",
     1597                                                     chr(10),
     1598                                                     string(    date( code.misc1)         ,"99/99/9999"),
     1599                                                     string(    date(bcode.misc1)         ,"99/99/9999"),
     1600                                                     string(         vDateSale            ,"99/99/9999"),
     1601                                                     string(vDateSale - today)
     1602                                                     ).
     1603                       end.
     1604                    end.
     1605                 end.
     1606                 if vgood
     1607                 then do:
     1608                    define variable choice as integer no-undo .
     1609                    run gbl/d-askw.w (input "Уточнение"
     1610                           ,input  vText
     1611                           ,input "|"
     1612                           ,input "Принять|Вернуть"
     1613                           ,input "Принять данный товар|Вернуть товар постащику"
     1614                           ,input 1
     1615                           ,input 2
     1616                           ,output choice) no-error.
     1617                    vok = choice eq 1.
     1618                 end.
     1619                 else
     1620                    vok =false.
     1621             end.
     1622          end.
     1623      end.
     1624   end.
     1625   function addGs2Mark return character
     1626   (iMark as char):
     1627      define variable vDM   as character no-undo.
     1628      define variable vIdx  as integer   no-undo.
     1629      if index(iMark,chr(29),1) > 0
     1630      then return iMark.
     1631      if substring(iMark,26,4) = "8005" then
     1632      do:
     1633        vIdx = index(iMark,"93",26 + 4 + 5).
     1634        if vIdx > 1 then do:
     1635          vDM = substitute("&1&4&2&4&3",
     1636                           substring(iMark,1,25),
     1637                           substring(iMark,26,vIdx - 25 - 1),
     1638                           substring(iMark,vIdx),
     1639                           chr(29)) no-error.
     1640          vIdx = index(vDm,"240",vIdx + 4).
     1641          if vIdx > 0 then
     1642          do:
     1643            vDM = substitute("&1&3&2",
     1644                             substring(vDm,1,vIdx - 1),
     1645                             substring(vDm,vIdx),
     1646                             chr(29)) no-error.
     1647          end.
     1648        end.
     1649        else
     1650          vDM = substitute("&1&3&2",
     1651                           substring(iMark,1,25),
     1652                           substring(iMark,26),
     1653                           chr(29)) no-error.
     1654      end.
     1655      else if substring(iMark,32,2) = "91" then
     1656      do:
     1657        vIdx = index(iMark,"92",32).
     1658        if vIdx > 1 then
     1659          vDM = substitute("&1&4&2&4&3",
     1660                           substring(iMark,1,31),
     1661                           substring(iMark,32,vIdx - 31 - 1),
     1662                           substring(iMark,vIdx),
     1663                           chr(29)) no-error.
     1664        else
     1665          vDM = substitute("&1&3&2",
     1666                           substring(iMark,1,31),
     1667                           substring(iMark,32),
     1668                           chr(29)) no-error.
     1669      end.
     1670      else if substring(iMark,39,2) = "91" then
     1671      do:
     1672        vIdx = index(iMark,"92",38).
     1673        if vIdx > 1 then
     1674          vDM = substitute("&1&4&2&4&3",
     1675                           substring(iMark,1,38),
     1676                           substring(iMark,39,vIdx - 38 - 1),
     1677                           substring(iMark,vIdx),
     1678                           chr(29)) no-error.
     1679        else
     1680          vDM = substitute("&1&3&2",
     1681                           substring(iMark,1,38),
     1682                           substring(iMark,39),
     1683                           chr(29)) no-error.
     1684      end.
     1685      else if substring(iMark,25,2) = "93" then
     1686      do:
     1687        vIdx = index(iMark,"92",25).
     1688        if vIdx > 1 then
     1689          vDM = substitute("&1&4&2&4&3",
     1690                           substring(iMark,1,24),
     1691                           substring(iMark,25,vIdx - 24 - 1),
     1692                           substring(iMark,vIdx),
     1693                           chr(29)) no-error.
     1694        else
     1695          vIdx = index(iMark,"3103",25).
     1696          if vIdx > 0 then
     1697          vDM = substitute("&1&4&2&4&3",
     1698                           substring(iMark,1,24),
     1699                           substring(iMark,25,vIdx - 24 - 1),
     1700                           substring(iMark,vIdx),
     1701                           chr(29)) no-error.
     1702          else
     1703            vDM = substitute("&1&3&2",
     1704                             substring(iMark,1,24),
     1705                             substring(iMark,25),
     1706                             chr(29)) no-error.
     1707      end.
     1708      else if substring(iMark,32,2) = "93" then
     1709      do:
     1710        vDM = substitute("&1&3&2",
     1711              substring(iMark,1,31),
     1712              substring(iMark,32),
     1713              chr(29)) no-error.
     1714      end.
     1715      return if vDM <> "" then vDm else iMark.
     1716   end.
     1717   define variable thMarkSts      as class ibs.th.str.marking.sts.mark no-undo.
     1718   define variable timeMunisYear  as datetime no-undo.
     1719   define variable datePlus2Year  as date     no-undo .
     1720   define variable maxDelMarks    as integer  no-undo.
     1721   define variable cntDelMarks    as integer  no-undo.
     1722   define variable currentTime    as character no-undo .
     1723   define variable v-tth             as handle    no-undo .
     1724   define variable v-value-character as character no-undo .
     1725   define variable v-value-date      as date      no-undo .
     1726   define variable v-value-decimal   as decimal   no-undo .
     1727   define variable v-value-integer   as integer   no-undo .
     1728   define variable v-value-logical   as logical   no-undo .
     1729   define variable v-param-type      as character no-undo .
     1730   define buffer buf_db      for ub.db.
     1731   define buffer buf_marking for ub.marking.
     1732   define buffer buf_marking_lock for ub.marking.
     1733   delete object v-tth no-error.
     1734   run adm/shattri.p
     1735     ( input "get":U
     1736      ,input  "":U
     1737      ,input  0
     1738      ,input  'auto-task':U
     1739      ,input  'maxColMarks':U
     1740      ,output v-value-character
     1741      ,output v-value-date
     1742      ,output v-value-decimal
     1743      ,output v-value-integer
     1744      ,output v-value-logical
     1745      ,output v-param-type
     1746      ,input-output table-handle v-tth
     1747     ) no-error .
     1748   maxDelMarks = if not error-status :error then v-value-integer else 1000.
     1749   delete object v-tth no-error.
     1750   assign
     1751     thMarkSts     = ObjSrv:Env:Marking:Sts:Mark
     1752     currentTime   = string(time,"HH:MM:SS")
     1753     datePlus2Year = 04/01/2026
     1754   .
     1755   if month(today) = 2 and day(today) = 29 then
     1756      timeMunisYear = datetime(month(today), 28, year(today) - 1,
     1757                              integer(entry(1,currentTime,":")),integer(entry(2,currentTime,":")),
     1758                              integer(entry(3,currentTime,":"))).
     1759   else timeMunisYear = datetime(month(today), day(today), year(today) - 1,
     1760                              integer(entry(1,currentTime,":")),integer(entry(2,currentTime,":")),
     1761                              integer(entry(3,currentTime,":"))).
     1762   run write-to-log( "Удаление марок, измененных до " +  string(timeMunisYear,"99/99/9999 HH:MM:SS")) .
     1763   if maxDelMarks > 0 then
     1764   do:
     1765     DEL_MARK_1:
     1766     for each buf_marking where
     1767              (buf_marking.sts = thMarkSts:SaleLock:KeyIntDB and
     1768               buf_marking.last-change < timeMunisYear) or
     1769              (buf_marking.sts = thMarkSts:OutZone:KeyIntDB and
     1770               buf_marking.last-change < timeMunisYear) or
     1771              (buf_marking.sts = thMarkSts:Ungrouped:KeyIntDB and
     1772               buf_marking.last-change < timeMunisYear)
     1773         no-lock:
     1774       find first buf_marking_lock where
     1775                  rowid(buf_marking_lock) = rowid(buf_marking)
     1776            exclusive-lock no-error.
     1777       if available buf_marking_lock then do:
     1778         delete buf_marking_lock.
     1779         cntDelMarks = cntDelMarks + 1.
     1780         if cntDelMarks >= maxDelMarks then leave DEL_MARK_1.
     1781       end.
     1782     end.
     1783   end.
     1784   run write-to-log( substitute("Удалено &1 марок.", cntDelMarks ) ) .
     1785   run write-to-log( "Удаление марок с пустой датой изменения" ) .
     1786   cntDelMarks = 0.
     1787   if maxDelMarks > 0 and today >= datePlus2Year then
     1788   do:
     1789     DEL_MARK_2:
     1790     for each buf_marking where
     1791              buf_marking.last-change = ?
     1792         no-lock:
     1793       find first buf_marking_lock where
     1794                  rowid(buf_marking_lock) = rowid(buf_marking)
     1795            exclusive-lock no-error.
     1796       if available buf_marking_lock then do:
     1797         delete buf_marking_lock.
     1798         cntDelMarks = cntDelMarks + 1.
     1799         if cntDelMarks >= maxDelMarks then leave DEL_MARK_2.
     1800       end.
     1801     end.
     1802   end.
     1803   run write-to-log( substitute("Удалено &1 марок.", cntDelMarks ) ) .
