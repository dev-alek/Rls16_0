        1   block-level on error undo, throw.
        2   define input  parameter p-imp-handle as handle    no-undo .
        3   define input  parameter p-counter    as integer   no-undo .
        4   define input  parameter p-obj-type   as character no-undo .
        5   define input  parameter p-obj-code   as integer   no-undo .
        6   define variable vss-revision    as character no-undo init "$Revision: a38042964324, 1747, rls $":U .
        7   define variable vss-author      as character no-undo init "$Author: ASMorozov $":U .
        8   define variable vss-date        as character no-undo init "$Date: Thu Jan 24 17:02:17 2019 +0300 $":U .
        9   define variable vss-workfile    as character no-undo init "$Workfile: cmdsndgd.p $":U .
       10   define variable vss-archive     as character no-undo init "$Archive: nws/cmdsndgd.p $":U .
       11   define variable vss-description as character no-undo init "Отправить в ГБД информацию обо всех товарах по указанному объекту".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30       assign
       31         p-vss-parameters = substitute('&1|&2|&3':u,p-counter,p-obj-type,p-obj-code)
       32       .
       33   end procedure.
       34   define new global shared variable g#vssrevis-logger as handle    no-undo .
       35   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       36   define variable v-vssrevis-logger                   as handle    no-undo .
       37   procedure vss-logevent :
       38     define input  parameter p-extra-paramters as character no-undo .
       39     define variable v-vssrevis-parameters as character no-undo .
       40     do
       41     on error undo, return error return-value
       42     :
       43       if  valid-handle(v-vssrevis-logger)
       44       and v-vssrevis-logger :get-signature("logevent") <> ""
       45       then do:
       46         run vss-get-parameters in this-procedure
       47           (output v-vssrevis-parameters
       48           ).
       49         run logevent in v-vssrevis-logger
       50           (input vss-workfile
       51           ,input vss-revision
       52           ,input v-vssrevis-parameters
       53           ,input p-extra-paramters
       54           ).
       55       end.
       56     end.
       57   end procedure.
       58   assign
       59     v-vssrevis-logger = g#vssrevis-logger
       60   .
       61   if  valid-handle(v-vssrevis-logger)
       62   and v-vssrevis-logger :get-signature("logevent") <> ""
       63   then do:
       64     assign
       65       v-vssrevis-logevent = true
       66     .
       67     run vss-logevent in this-procedure (input vss-description) .
       68   end.
       69   define new global shared variable g#language as character no-undo .
       70   if g#language <> '' and g#language <> 'rus':U then do:
       71     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       72   end.
       73   define new global shared variable g#library  as handle no-undo .
       74   define new global shared variable g#library2 as handle no-undo .
       75   define   shared variable g#auto as logical no-undo.
       76   define   shared variable g#news as logical no-undo.
       77   define   shared variable g#oxml as logical no-undo.
       78   define   shared variable g#esys as logical no-undo.
       79   define   shared variable g#news-source-db as integer no-undo.
       80   define   shared variable g#esys-source-esys as integer no-undo.
       81   define   shared variable g#db-num as integer   no-undo .
       82   define   shared variable g#userid as character no-undo .
       83   define   shared variable g#passwd as character no-undo .
       84   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       85   define variable v-waitfram-action01         as character   no-undo .
       86   define variable v-waitfram-action02         as character   no-undo .
       87   define variable v-waitfram-action03         as character   no-undo .
       88   define variable mWaitFramTextBeg            as character   no-undo.
       89   define variable mWaitFramTextEnd            as character   no-undo.
       90   define variable mWaitFramView               as logical     no-undo.
       91   define variable mWaitProcEvent              as logical     no-undo init yes.
       92   define variable mWaitFramInterval           as integer     no-undo init 1 .
       93   define variable mWaitFramStop               as logical     no-undo.
       94   define variable mWaitFramStopUser           as logical     no-undo.
       95   define variable mWaitFramStopTimeOut        as logical     no-undo.
       96   define variable mWaitFramStartProc          as datetime-tz no-undo.
       97   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       98   define button B-WaitFramStop auto-end-key
       99        label "Стоп"
      100        size 10 by 1 tooltip "Остоновить процесс".
      101   define button B-viewProcInfo
      102        label "Информация"
      103        size 15 by 1 tooltip "Информация о процесс".
      104   define frame waitfram
      105     v-waitfram-action01 format "x(72)" no-label skip
      106     v-waitfram-action02 format "x(72)" no-label skip
      107     v-waitfram-action03 format "x(72)" no-label skip
      108     B-viewProcInfo
      109     B-WaitFramStop at row 4 col 30
      110     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      111     .
      112   define new global shared variable mBatchMode as logical no-undo init ?.
      113   define variable mFramBachModHandle as handle no-undo.
      114   mFramBachModHandle = frame waitfram:handle.
      115   define variable mFameOldVis as logical no-undo.
      116   define variable mVisCUrentVin as logical no-undo.
      117   if session:batch-mode
      118   then
      119      mBatchMode = yes.
      120   if mBatchMode = ? then do:
      121     mVisCUrentVin = current-window:visible.
      122     mFameOldVis = mFramBachModHandle:visible.
      123     mFramBachModHandle:visible  = yes.
      124     mBatchMode = mFramBachModHandle:visible ne yes.
      125     mFramBachModHandle:visible = mFameOldVis.
      126     current-window:visible = mVisCUrentVin.
      127   end.
      128    if  log-manager:logfile-name ne ?
      129     then DO:
      130         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      131         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      132         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      133     end.
      134   on choose of B-WaitFramStop in frame waitfram
      135   do:
      136     mWaitFramStop = yes.
      137     mWaitFramStopUser = yes.
      138   end.
      139   function waitfram-check-timeout returns logical():
      140      define variable vtime as int64 no-undo.
      141      if mWaitFramStopTimeOut
      142      then
      143         return yes.
      144      vtime = ( now - mWaitFramStartProc ) / 1000 .
      145      if     mWaitFramTimeOut ne ?
      146         and mWaitFramTimeOut ne 0
      147         and mWaitFramTimeOut lt vtime
      148      then do:
      149         mWaitFramStopTimeOut = yes.
      150      end.
      151      return mWaitFramStopTimeOut.
      152   end.
      153   procedure waitfram-hide :
      154     if not session:batch-mode
      155     then do
      156     on error undo, return error return-value
      157     :
      158       pause 0 before-hide .
      159       if not mBatchMode then
      160         hide frame waitfram .
      161     if     not mWaitFramView
      162        and mWaitProcEvent
      163     then
      164       process events .
      165     end.
      166   end procedure.
      167   procedure waitfram-show :
      168     define input  parameter p-message as character no-undo .
      169     define variable v-left-margin as integer   no-undo .
      170     if not session:batch-mode
      171     then do
      172     on error undo, return error return-value
      173     :
      174       if length(p-message) <= 70 then do:
      175         assign
      176           v-left-margin = integer((70 - length(p-message)) / 2)
      177         .
      178         assign
      179           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      180         .
      181         assign
      182           v-waitfram-action01 = " "
      183           v-waitfram-action02 = " "
      184                                    + fill(" ", v-left-margin)
      185                                    + p-message
      186           v-waitfram-action03 = " "
      187         .
      188       end.
      189       else do:
      190         define variable vRindex1 as integer no-undo.
      191         define variable vRindex2 as integer no-undo.
      192         vRindex1 = r-index(p-message," ",70).
      193         if vRindex1 = 0
      194         then
      195            vRindex1 = 70.
      196         if length(p-message)  <= vRindex1 + 70 then do:
      197           assign
      198             v-waitfram-action01 = " "
      199             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      200             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      201           .
      202         end.
      203         else do:
      204           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      205           if vRindex2 <= vRindex1
      206           then
      207              vRindex2 = vRindex1 + 70.
      208           assign
      209             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      210             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      211             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      212           .
      213         end.
      214       end.
      215       B-viewProcInfo:visible   in frame waitfram = no.
      216       B-viewProcInfo:sensitive in frame waitfram = no.
      217       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      218       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      219       if  (   mWaitFramView
      220          or  mWaitProcEvent)
      221          and not mBatchMode
      222       then
      223          display
      224             v-waitfram-action01 skip
      225             v-waitfram-action02 skip
      226             v-waitfram-action03 skip
      227          with frame waitfram .
      228       if     mWaitFramView
      229          then do:
      230             if     mWaitFramInterval ne ?
      231                and not mBatchMode
      232             then
      233                wait-for go of frame waitfram pause mWaitFramInterval.
      234          end.
      235          else
      236             if     mWaitProcEvent
      237                and not mBatchMode
      238             then
      239                process events .
      240     end.
      241   end procedure.
      242      procedure waitfram-show-this:
      243         define input  parameter iInterval as int64 no-undo.
      244         define variable vtime as int64 no-undo.
      245         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      246         mWaitFramInterval = iInterval.
      247         run waitfram-show (substitute("&1&2 &3&4" ,
      248                                       mWaitFramTextBeg ,
      249                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      250                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      251                                       mWaitFramTextEnd
      252                                      )
      253                           ).
      254      end.
      255      procedure WaitFramRunPause:
      256         define input  parameter iInterval as dec no-undo.
      257         define variable vStart  as datetime-tz no-undo.
      258         define variable vend    as datetime-tz no-undo.
      259         define variable vint as int64 no-undo.
      260         define variable vOk as logical no-undo.
      261         vStart = now.
      262         vend   = vStart.
      263         publish "WaitFramPause" (iInterval,output vOk).
      264         vend   =  now.
      265         vint = vend - vStart.
      266         vint = iInterval - vint / 1000.
      267         if     not mWaitFramStop
      268            and (   vint > 0
      269                 or (    not vOk
      270                     and iInterval eq ?
      271                     )
      272                 )
      273         then
      274            run waitfram-show-this (iInterval).
      275         vend   =  now.
      276         vint = vend - vStart.
      277         vint = iInterval - vint / 1000.
      278         if     not mWaitFramStop
      279            and vint > 0
      280         then do:
      281            run gbl/pause.p (vint * 1000).
      282         end.
      283         if iInterval ne ?
      284         then
      285            publish "WaitFramStop".
      286         waitfram-check-timeout().
      287      end.
      288      procedure WaitFramWaitFor:
      289         define input  parameter iInterval as dec no-undo.
      290         assign
      291            mWaitFramStartProc   = now
      292            mWaitFramStopUser    = no
      293            mWaitFramStopTimeOut = no
      294         .
      295         block-wait:
      296         do while not mWaitFramStop:
      297            run WaitFramRunPause (iInterval).
      298            if  waitfram-check-timeout()
      299            then do:
      300               leave block-wait.
      301            end.
      302         end.
      303         run waitfram-hide.
      304      end.
      305   procedure waitfram-join :
      306     define input  parameter p-line-1  as character no-undo .
      307     define input  parameter p-line-2  as character no-undo .
      308     define input  parameter p-line-3  as character no-undo .
      309     define output parameter p-message as character no-undo .
      310     do
      311     on error undo, return error return-value
      312     :
      313       assign
      314         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      315                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      316                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      317       .
      318     end.
      319   end procedure.
      320   function waitfram-join-function returns character
      321     (input p-line-1 as character
      322     ,input p-line-2 as character
      323     ,input p-line-3 as character
      324     ).
      325     define variable v-message as character no-undo .
      326     run waitfram-join in this-procedure
      327       (input  p-line-1
      328       ,input  p-line-2
      329       ,input  p-line-3
      330       ,output v-message
      331       ) .
      332     return v-message .
      333   end function .
      334   define variable v-cmd-proc-handle as handle    no-undo .
      335   define variable v-cmd-code1       as integer   no-undo .
      336   define variable v-object-exist    as logical   no-undo .
      337   define variable v-rec-ord         as integer   no-undo .
      338   define buffer buf_gds-obj      for ub.gds-obj .
      339   define buffer buf_prt-obj      for ub.prt-obj .
      340   define buffer buf_parts        for ub.parts .
      341   define buffer buf_batchprocess for ub.batchprocess .
      342   do
      343   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      344   on stop   undo, return error substitute( "&1. stop", vss-workfile )
      345   on endkey undo, return error substitute( "&1. endkey", vss-workfile )
      346   :
      347     define variable conf-par as character no-undo.
      348     define variable mode-erprn as logical no-undo.
      349     define variable par-type as character no-undo.
      350   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
      351     (input  'is-erpRN'
      352     ,input  0
      353     ,input  ''
      354     ,input  0
      355     ,input  ''
      356     ,input  ''
      357     ,input  ''
      358     ,input  NO
      359     ,output conf-par
      360     ,output par-type
      361     ) no-error .
      362     if not error-status:error and conf-par = "yes":u then mode-erprn = yes.
      363     else mode-erprn = no.
      364     if mode-erprn
      365     then do:
      366       return.
      367     end.
      368     if p-obj-type = ?
      369     then do:
      370       message
      371         vss-workfile vss-revision vss-description skip
      372         "Ошибка задания входных параметров" skip
      373         "Неизвестное значение типа объекта" skip
      374         view-as alert-box error .
      375       undo, return error return-value .
      376     end.
      377     if p-obj-code = ?
      378     then do:
      379       message
      380         vss-workfile vss-revision vss-description skip
      381         "Ошибка задания входных параметров" skip
      382         "Неизвестное значение кода объекта" skip
      383         view-as alert-box error .
      384       undo, return error return-value .
      385     end.
      386   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      387   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      388     (input  p-obj-type
      389     ,input  p-obj-code
      390     ,input  'check-exist':u
      391     ,output v-object-exist
      392     ) no-error .
      393     if error-status :error
      394     then do:
      395       message
      396         vss-workfile vss-revision vss-description skip
      397         "Ошибка при проверке существования объекта" skip
      398         "Не найден объект" skip
      399         "Объект" p-obj-type p-obj-code skip
      400         error-status :get-message(1) skip
      401         return-value skip
      402         view-as alert-box error .
      403       undo, return error return-value .
      404     end.
      405     run gbl/lockgdoc.p
      406       (input  p-obj-type
      407       ,input  p-obj-code
      408       ,input  'gdoc':U
      409       ,input  'disable':U
      410       ,buffer buf_batchprocess
      411       ) no-error .
      412     if error-status :error
      413     then do:
      414       message
      415         vss-workfile vss-revision vss-description skip
      416         "Ошибка при проверке возможности создания записей товара на объекте" skip
      417         "Объект" p-obj-type p-obj-code skip
      418         error-status :get-message(1) skip
      419         return-value skip
      420         view-as alert-box error .
      421       undo, return error return-value .
      422     end.
      423     do transaction
      424     on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      425     on stop   undo, return error substitute( "&1. stop", vss-workfile )
      426     on endkey undo, return error substitute( "&1. endkey", vss-workfile )
      427     :
      428       define variable v-ind as integer   no-undo .
      429       assign
      430         v-ind = 0
      431       .
      432       for each buf_gds-obj exclusive-lock
      433       on error undo, return error return-value
      434       :
      435         assign
      436           v-ind = v-ind + 1
      437         .
      438         if v-ind modulo 10 = 0
      439         then do:
      440           run waitfram-show in this-procedure
      441             (input substitute("Блокировка товаров на объекте. Объект &1 &2. Заблокировано товаров &3. Артикул &4", p-obj-type, p-obj-code, v-ind, buf_gds-obj.artic)
      442             ) .
      443         end.
      444       end.
      445       run nws/cmd-bush.p persistent set v-cmd-proc-handle
      446         no-error .
      447       if error-status :error
      448       then do:
      449         message
      450           vss-workfile vss-revision vss-description skip
      451           substitute("Ошибка при запуске процедуры cmd-bush.p") skip
      452           error-status :get-message(1) skip
      453           return-value skip
      454           view-as alert-box error .
      455         delete procedure v-cmd-proc-handle .
      456         undo, return error return-value .
      457       end.
      458       run begin-create-command in v-cmd-proc-handle
      459         (input  'cmd-transfer-goods':U + chr(6) + string(p-obj-type) + chr(6) + string(p-obj-code)
      460         ,input "":U
      461         ,output v-cmd-code1
      462         ) no-error.
      463       if error-status :error
      464       then do:
      465         message
      466           vss-workfile vss-revision vss-description skip
      467           substitute( "Ошибка при создании команды &1", 'cmd-transfer-goods':U ) skip
      468           error-status :get-message(1) skip
      469           return-value skip
      470           view-as alert-box error .
      471         delete procedure v-cmd-proc-handle .
      472         undo, return error return-value .
      473       end.
      474       assign
      475         v-ind = 0
      476       .
      477       for each buf_gds-obj exclusive-lock
      478         where buf_gds-obj.obj-type = p-obj-type
      479           and buf_gds-obj.obj-code = p-obj-code
      480       on error undo, return error return-value
      481       :
      482         assign
      483           v-ind = v-ind + 1
      484         .
      485         if v-ind modulo 10 = 0
      486         then do:
      487           run waitfram-show in this-procedure
      488             (input substitute("Отправка информации о товарах на объекте в ГБД. Объект &1 &2. Отправлено товаров &3. Артикул &4", p-obj-type, p-obj-code, v-ind, buf_gds-obj.artic)
      489             ) .
      490         end.
      491         run add-dump in v-cmd-proc-handle
      492           (input v-cmd-code1
      493           ,input 'gds-obj':U
      494           ,input '+update':U
      495           ,input (buffer buf_gds-obj :handle)
      496           ,input '':U
      497           ,output v-rec-ord
      498           ) no-error .
      499         if error-status :error
      500         then do:
      501           message
      502             vss-workfile vss-revision vss-description skip
      503             substitute( "Ошибка при добавлении записи &1 в команду с кодом &2", 'gds-obj':U, v-cmd-code1 ) skip
      504             error-status :get-message(1) skip
      505             return-value skip
      506             view-as alert-box error .
      507           delete procedure v-cmd-proc-handle .
      508           undo, return error return-value .
      509         end.
      510         for each buf_prt-obj share-lock
      511           where buf_prt-obj.obj-type = p-obj-type
      512             and buf_prt-obj.obj-code = p-obj-code
      513             and buf_prt-obj.artic    = buf_gds-obj.artic
      514             and buf_prt-obj.prod-type = buf_gds-obj.prod-type
      515             and buf_prt-obj.prod-code = buf_gds-obj.prod-code
      516         on error undo, return error return-value
      517         :
      518           run add-dump in v-cmd-proc-handle
      519             (input v-cmd-code1
      520             ,input 'prt-obj':U
      521             ,input '+update':U
      522             ,input (buffer buf_prt-obj :handle)
      523             ,input '':U
      524             ,output v-rec-ord
      525             ) no-error .
      526           if error-status :error then do:
      527             message
      528               vss-workfile vss-revision vss-description skip
      529               substitute( "Ошибка при добавлении записи &1 в команду с кодом &2", 'prt-obj':U, v-cmd-code1 ) skip
      530               error-status :get-message(1) skip
      531               return-value skip
      532               view-as alert-box error .
      533             delete procedure v-cmd-proc-handle .
      534             undo, return error return-value .
      535           end.
      536         end.
      537         for each buf_parts share-lock
      538           where buf_parts.obj-type  = p-obj-type
      539             and buf_parts.obj-code  = p-obj-code
      540             and buf_parts.artic     = buf_gds-obj.artic
      541             and buf_parts.prod-type = buf_gds-obj.prod-type
      542             and buf_parts.prod-code = buf_gds-obj.prod-code
      543             and buf_parts.rsrv-free = yes
      544             and buf_parts.status_   = no
      545             and buf_parts.in-code   <> buf_parts.out-code
      546         on error undo, return error return-value
      547         :
      548           run add-dump in v-cmd-proc-handle
      549             (input v-cmd-code1
      550             ,input 'parts':U
      551             ,input '+update':U
      552             ,input (buffer buf_parts :handle)
      553             ,input '':U
      554             ,output v-rec-ord
      555             ) no-error .
      556           if error-status :error
      557           then do:
      558             message
      559               vss-workfile vss-revision vss-description skip
      560               substitute( "Ошибка при добавлении записи &1 в команду с кодом &2", 'parts':U, v-cmd-code1 ) skip
      561               error-status :get-message(1) skip
      562               return-value skip
      563               view-as alert-box error .
      564             delete procedure v-cmd-proc-handle .
      565             undo, return error return-value .
      566           end.
      567         end.
      568       end.
      569       run send-command in v-cmd-proc-handle
      570         ( input v-cmd-code1
      571         ,input "0"
      572         ) no-error .
      573       if error-status :error then do:
      574         message
      575           vss-workfile vss-revision vss-description skip
      576           substitute( "Ошибка при отправке в новости команды с кодом &1", v-cmd-code1 ) skip
      577           error-status :get-message(1) skip
      578           return-value skip
      579           view-as alert-box error .
      580         delete procedure v-cmd-proc-handle .
      581         undo, return error return-value .
      582       end.
      583     end.
      584     delete procedure v-cmd-proc-handle .
      585   end.
