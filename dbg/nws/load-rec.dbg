     2418   :
     2419     delete locb2-c-chk-pay.
     2420   end.
     2421   for each locb2-c-chk-discnt
     2422   on error  undo, return error
     2423   :
     2424     delete locb2-c-chk-discnt.
     2425   end.
     2426   for each locb2-c-chk-doc-attr
     2427   on error  undo, return error
     2428   :
     2429     delete locb2-c-chk-doc-attr.
     2430   end.
     2431       delete wt-c-chk-doc.
     2432     end.
     2433   END PROCEDURE.
     2434   define temp-table wt-clients no-undo like ub.clients.
     2435   PROCEDURE proc-load-clients:
     2436     define input parameter p-imp-handle as handle  no-undo.
     2437     define input parameter p-pck-num    as integer no-undo.
     2438     define input parameter l-counter    as integer no-undo.
     2439     do
     2440     on error  undo, return error substitute( "$proc-load-clients. &1&2&3", return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2441     on stop   undo, return error substitute( "$proc-load-clients. stop" )
     2442     on endkey undo, return error substitute( "$proc-load-clients. endkey" )
     2443     :
     2444       define buffer tb-clients for ub.clients.
     2445       define variable compare-log as logical no-undo.
     2446   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2447   define buffer buf_cli-grp  for ub.cli-grp .
     2448   define buffer buf_dis-card for ub.dis-card .
     2449   define variable v-l as logical no-undo .
     2450       for each wt-clients
     2451       on error undo, return error substitute( "$proc-load-clients(del-wt-). &1&2&3", return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2452       :
     2453         delete wt-clients .
     2454       end.
     2455       create wt-clients.
     2456       run nws-impl in p-imp-handle
     2457         ( input 'clients':U
     2458          ,input (buffer wt-clients:handle)
     2459         ) no-error.
     2460       if error-status :error then do:
     2461         return error return-value .
     2462       end.
     2463       find first tb-clients
     2464         where tb-clients.obj-type = wt-clients.obj-type
     2465           and tb-clients.obj-code = wt-clients.obj-code
     2466         exclusive-lock no-error.
     2467   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2468     if not can-find(buf_cli-grp where buf_cli-grp.node-code = wt-clients.grp-code)
     2469         and g#db-num = 0 then do:
     2470       run write-to-log in this-procedure (input " В БД нет группы для клиента " + wt-clients.obj-name + " ("
     2471                         + wt-clients.obj-type + " " + string( wt-clients.obj-code ) + ") "
     2472                       ).
     2473       return error.
     2474     end.
     2475     if can-find(buf_cli-grp where buf_cli-grp.upper-code = wt-clients.grp-code)
     2476         and g#db-num = 0 then do:
     2477       run write-to-log in this-procedure (input " В ГБД есть подгруппа в группе клиента " + wt-clients.obj-name + " ("
     2478                         + wt-clients.obj-type + " " + string( wt-clients.obj-code ) + ")."
     2479                       ).
     2480       return error.
     2481     end.
     2482   if not available tb-clients then do:
     2483     create tb-clients.
     2484     assign compare-log = no.
     2485   end.
     2486   else do:
     2487     buffer-compare tb-clients TO wt-clients case-sensitive save result in compare-log no-error.
     2488     buffer-compare tb-clients using obj-name TO wt-clients case-sensitive save result in v-l no-error.
     2489   end.
     2490   if not compare-log then do:
     2491     buffer-copy wt-clients TO tb-clients .
     2492     if
     2493     not (tb-clients.obj-type = 'маг':U or tb-clients.obj-type = 'скл':U)
     2494     and not v-l then do:
     2495       for each buf_dis-card where
     2496                buf_dis-card.cli-type = tb-clients.obj-type
     2497            AND buf_dis-card.cli-code = tb-clients.obj-code:
     2498         run fill-dc-list in p-imp-handle ( buffer buf_Dis-card) .
     2499       end.
     2500     end.
     2501   end.
     2502       delete wt-clients.
     2503     end.
     2504   END PROCEDURE.
     2505   define temp-table wt-clients-attr no-undo like ub.clients-attr.
     2506   PROCEDURE proc-load-clients-attr:
     2507     define input parameter p-imp-handle as handle  no-undo.
     2508     define input parameter p-pck-num    as integer no-undo.
     2509     define input parameter l-counter    as integer no-undo.
     2510     do
