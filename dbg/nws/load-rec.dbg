    13815    define  temp-table tmprecid
    13816       field Frecid as recid init ?
    13817       field fnum as character
    13818       field fTable as character
    13819    index num  fnum Frecid
    13820    index itable is primary unique fTable Frecid
    13821    .
    13822   define variable fSelect as logical no-undo format "*/" column-label "".
    13823   function isSelect return logical
    13824       (iBuffer as handle  ):
    13825       define buffer tmprecid for tmprecid.
    13826       if iBuffer:available
    13827       then
    13828          find first tmprecid where tmprecid.fTable = iBuffer:TABLE
    13829                                and tmprecid.Frecid = iBuffer:recid
    13830          no-lock no-error.
    13831       return available tmprecid.
    13832    end.
    13833   function setSelect return logical
    13834       (iBuffer as handle  ):
    13835       define buffer tmprecid for tmprecid.
    13836       if iBuffer:available
    13837       then do:
    13838          find first tmprecid where tmprecid.fTable = iBuffer:TABLE
    13839                                and tmprecid.Frecid = iBuffer:recid
    13840          no-lock no-error.
    13841          if available tmprecid
    13842          then
    13843             delete tmprecid.
    13844          else do:
    13845             create tmprecid.
    13846             assign
    13847                tmprecid.fTable = iBuffer:TABLE
    13848                tmprecid.Frecid = iBuffer:recid
    13849             .
    13850          end.
    13851       end.
    13852       return available tmprecid.
    13853    end.
    13854    procedure rid-keep :
    13855        run gbl/rid-keep.p (input table tmprecid) no-error.
    13856    end.
    13857    procedure rid-rest :
    13858         run gbl/rid-rest.p (output table tmprecid) no-error.
    13859    end.
