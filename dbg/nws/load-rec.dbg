    13469       create wt-c-rvs-doc.
    13470       run nws-impl in p-imp-handle
    13471         ( input 'c-rvs-doc':U
    13472          ,input (buffer wt-c-rvs-doc:handle)
    13473         ) no-error.
    13474       if error-status :error then do:
    13475         return error return-value .
    13476       end.
    13477       find first tb-c-rvs-doc
    13478         where tb-c-rvs-doc.rvs-code = wt-c-rvs-doc.rvs-code
    13479           and tb-c-rvs-doc.corr-user-db-num = wt-c-rvs-doc.corr-user-db-num
    13480           and tb-c-rvs-doc.chip-num = wt-c-rvs-doc.chip-num
    13481         exclusive-lock no-error.
    13482   define variable vss-include-info148 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    13483   DO counter = 1 TO l-counter
    13484   on error  undo, return error
    13485   on endkey undo, return error :
    13486   run nws-imps in p-imp-handle
    13487     ( input-output counter
    13488      ,output       rec-full
    13489     ) no-error.
    13490   if error-status :error then do:
    13491     return error substitute( "&1&2&3", return-value, chr(10), error-status :get-message(1) ) .
    13492   end.
    13493     assign
    13494       rec-name = entry( 1, rec-full, chr(1) )
    13495       .
    13496     CASE rec-name :
    13497       when "c-rvs-line" then do:
    13498         create locb-c-rvs-line.
    13499   run nws-impl in p-imp-handle
    13500     ( input "c-rvs-line":U
    13501      ,input (buffer locb-c-rvs-line:handle)
    13502     ) no-error.
    13503   if error-status :error then do:
    13504     return error substitute( "&1&2&3", return-value, chr(10), error-status :get-message(1) ) .
    13505   end.
    13506       end.
    13507       when "c-rvs-line-pump" then do:
    13508         create locb-c-rvs-line-pump.
    13509   run nws-impl in p-imp-handle
    13510     ( input "c-rvs-line-pump":U
    13511      ,input (buffer locb-c-rvs-line-pump:handle)
    13512     ) no-error.
    13513   if error-status :error then do:
    13514     return error substitute( "&1&2&3", return-value, chr(10), error-status :get-message(1) ) .
    13515   end.
    13516       end.
    13517       when "c-doc-attr" then do:
    13518         create locbr-c-doc-attr.
    13519   run nws-impl in p-imp-handle
    13520     ( input "c-doc-attr":U
    13521      ,input (buffer locbr-c-doc-attr:handle)
    13522     ) no-error.
    13523   if error-status :error then do:
    13524     return error substitute( "&1&2&3", return-value, chr(10), error-status :get-message(1) ) .
    13525   end.
    13526       end.
    13527       otherwise do:
    13528         message "Не предусмотрен прием таблицы " rec-name skip
    13529                 "в составе производства."
    13530                 view-as alert-box error.
    13531         return error.
    13532       end.
    13533     END CASE.
    13534   end.
    13535   for each buf_c-rvs-line where buf_c-rvs-line.rvs-code = wt-c-rvs-doc.rvs-code
    13536   on error  undo, return error
    13537   on stop   undo, return error
    13538   on endkey undo, return error :
    13539     delete buf_c-rvs-line.
    13540   end.
    13541   for each locb-c-rvs-line where locb-c-rvs-line.rvs-code = wt-c-rvs-doc.rvs-code
    13542                          no-lock
    13543   on error  undo, return error
    13544   on stop   undo, return error
    13545   on endkey undo, return error :
    13546     create buf_c-rvs-line.
    13547     buffer-copy locb-c-rvs-line to buf_c-rvs-line.
    13548   end.
    13549   for each buf_c-rvs-line-pump where buf_c-rvs-line-pump.rvs-code = wt-c-rvs-doc.rvs-code
    13550   on error  undo, return error
    13551   on stop   undo, return error
    13552   on endkey undo, return error :
    13553     delete buf_c-rvs-line-pump.
    13554   end.
    13555   for each locb-c-rvs-line-pump where locb-c-rvs-line-pump.rvs-code = wt-c-rvs-doc.rvs-code
    13556                          no-lock
    13557   on error  undo, return error
    13558   on stop   undo, return error
    13559   on endkey undo, return error :
    13560     create buf_c-rvs-line-pump.
    13561     buffer-copy locb-c-rvs-line-pump to buf_c-rvs-line-pump.
    13562   end.
    13563   for each buf_c-doc-attr where buf_c-doc-attr.doc-code = wt-c-rvs-doc.rvs-code
    13564   on error  undo, return error
    13565   on stop   undo, return error
    13566   on endkey undo, return error :
    13567     delete buf_c-doc-attr.
    13568   end.
    13569   for each locbr-c-doc-attr where locbr-c-doc-attr.doc-code = wt-c-rvs-doc.rvs-code
    13570                          no-lock
    13571   on error  undo, return error
    13572   on stop   undo, return error
    13573   on endkey undo, return error :
    13574     create buf_c-doc-attr.
    13575     buffer-copy locbr-c-doc-attr to buf_c-doc-attr.
    13576   end.
    13577   if not available tb-c-rvs-doc then do:
    13578     create tb-c-rvs-doc.
    13579   end.
    13580   buffer-copy wt-c-rvs-doc to tb-c-rvs-doc.
    13581   for each locb-c-rvs-line
    13582   on error  undo, return error
    13583   on stop   undo, return error
    13584   on endkey undo, return error :
    13585     delete locb-c-rvs-line.
    13586   end.
    13587   for each locb-c-rvs-line-pump
    13588   on error  undo, return error
    13589   on stop   undo, return error
    13590   on endkey undo, return error :
    13591     delete locb-c-rvs-line-pump.
    13592   end.
    13593   for each locbr-c-doc-attr
    13594   on error  undo, return error
    13595   on stop   undo, return error
    13596   on endkey undo, return error :
    13597     delete locbr-c-doc-attr.
    13598   end.
    13599       delete wt-c-rvs-doc.
    13600     end.
    13601   END PROCEDURE.
