    10915   on endkey undo, return error :
    10916     delete rcvlocb-ord-dtl.
    10917   end.
    10918   for each rcvlocb-ord-doc
    10919   on error  undo, return error
    10920   on stop   undo, return error
    10921   on endkey undo, return error :
    10922     delete rcvlocb-ord-doc.
    10923   end.
    10924   for each rcvlocb-ord-doc-attr
    10925   on error  undo, return error
    10926   on stop   undo, return error
    10927   on endkey undo, return error :
    10928     delete rcvlocb-ord-doc-attr.
    10929   end.
    10930       delete wt-ord-doc-rcv.
    10931     end.
    10932   END PROCEDURE.
    10933   define temp-table wt-person no-undo like ub.person.
    10934   PROCEDURE proc-load-person:
    10935     define input parameter p-imp-handle as handle  no-undo.
    10936     define input parameter p-pck-num    as integer no-undo.
    10937     define input parameter l-counter    as integer no-undo.
    10938     do
    10939     on error  undo, return error substitute( "$proc-load-person. &1&2&3", return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    10940     on stop   undo, return error substitute( "$proc-load-person. stop" )
    10941     on endkey undo, return error substitute( "$proc-load-person. endkey" )
    10942     :
    10943       define buffer tb-person for ub.person.
    10944       define variable compare-log as logical no-undo.
    10945   define variable vss-include-info119 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10946   define variable v-l as logical no-undo .
    10947   define buffer buf_dis-card for ub.dis-card .
    10948       for each wt-person
    10949       on error undo, return error substitute( "$proc-load-person(del-wt-). &1&2&3", return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    10950       :
    10951         delete wt-person .
    10952       end.
    10953       create wt-person.
    10954       run nws-impl in p-imp-handle
    10955         ( input 'person':U
    10956          ,input (buffer wt-person:handle)
    10957         ) no-error.
    10958       if error-status :error then do:
    10959         return error return-value .
    10960       end.
    10961       find first tb-person
    10962         where tb-person.psn-code = wt-person.psn-code
    10963         exclusive-lock no-error.
    10964   define variable vss-include-info120 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10965   if not available tb-person then do:
    10966     create tb-person.
    10967     assign compare-log = no.
    10968   end.
    10969   else do:
    10970     buffer-compare tb-person TO wt-person case-sensitive save result in compare-log no-error.
    10971   end.
    10972    buffer-compare tb-person using city ind address name1 name2 TO wt-person case-sensitive save result in v-l no-error.
    10973   if not compare-log then do:
    10974     buffer-copy wt-person TO tb-person.
    10975   end.
    10976   if not v-l then do:
    10977     for each buf_dis-card no-lock where
    10978              buf_dis-card.cli-type = 'чел':U
    10979          AND buf_dis-card.cli-code = tb-person.psn-code:
    10980       run fill-dc-list in p-imp-handle ( buffer buf_Dis-card) .
    10981     end.
    10982   end.
    10983       delete wt-person.
    10984     end.
    10985   END PROCEDURE.
    10986   define temp-table locb-price-list no-undo like ub.price-list.
    10987   define temp-table locb-doc-attr      no-undo like ub.doc-attr.
    10988   define temp-table locb-price-list-attr no-undo like ub.price-list-attr.
    10989   define temp-table wt-price-doc no-undo like ub.price-doc.
    10990   PROCEDURE proc-load-price-doc:
    10991     define input parameter p-imp-handle as handle  no-undo.
    10992     define input parameter p-pck-num    as integer no-undo.
    10993     define input parameter l-counter    as integer no-undo.
    10994     do
    10995     on error  undo, return error substitute( "$proc-load-price-doc. &1&2&3", return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    10996     on stop   undo, return error substitute( "$proc-load-price-doc. stop" )
    10997     on endkey undo, return error substitute( "$proc-load-price-doc. endkey" )
    10998     :
    10999       define buffer tb-price-doc for ub.price-doc.
    11000       define variable compare-log as logical no-undo.
    11001   define variable vss-include-info121 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    11002   define buffer buf_price-list      for ub.price-list.
    11003   define buffer buf_doc-attr        for ub.doc-attr.
    11004   define buffer buf_price-list-attr      for ub.price-list-attr.
    11005   def var counter  as   integer            no-undo.
    11006   def var rec-full as   character          no-undo.
    11007   def var rec-name as   character          no-undo.
    11008   def var bar_code like ub.bar-code.b-code no-undo .
    11009   define buffer buf_bar-code for ub.bar-code .
    11010   for each locb-price-list
    11011   on error  undo, return error
    11012   :
    11013     delete locb-price-list.
    11014   end.
    11015   for each locb-doc-attr
    11016   on error  undo, return error
    11017   :
    11018     delete locb-doc-attr.
    11019   end.
    11020   for each locb-price-list-attr
    11021   on error  undo, return error
    11022   :
    11023     delete locb-price-list-attr.
    11024   end.
    11025       for each wt-price-doc
    11026       on error undo, return error substitute( "$proc-load-price-doc(del-wt-). &1&2&3", return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    11027       :
    11028         delete wt-price-doc .
    11029       end.
    11030       create wt-price-doc.
    11031       run nws-impl in p-imp-handle
    11032         ( input 'price-doc':U
    11033          ,input (buffer wt-price-doc:handle)
    11034         ) no-error.
    11035       if error-status :error then do:
    11036         return error return-value .
    11037       end.
    11038       find first tb-price-doc
    11039         where tb-price-doc.doc-num = wt-price-doc.doc-num
    11040         exclusive-lock no-error.
    11041   define variable vss-include-info122 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    11042   DO counter = 1 TO l-counter
    11043   on error  undo, return error
    11044   on endkey undo, return error :
    11045   run nws-imps in p-imp-handle
    11046     ( input-output counter
    11047      ,output       rec-full
    11048     ) no-error.
    11049   if error-status :error then do:
    11050     return error substitute( "&1&2&3", return-value, chr(10), error-status :get-message(1) ) .
    11051   end.
    11052     assign
    11053       rec-name = entry( 1, rec-full, chr(1) )
    11054       .
    11055     CASE rec-name :
    11056       when "price-list" then do:
    11057         create locb-price-list.
    11058         run nws-impl-without-check in p-imp-handle
    11059           ( input (buffer locb-price-list:handle)
    11060           ) no-error.
    11061         if error-status :error then do:
    11062           return error return-value .
    11063         end.
    11064         run check-avail-artic in p-imp-handle
    11065           ( input locb-price-list.artic
    11066            ,input locb-price-list.prod-type
    11067            ,input locb-price-list.prod-code
    11068           ).
    11069         run check-avail-b-code in p-imp-handle
    11070           ( input-output locb-price-list.b-code
    11071           ) no-error.
    11072         if error-status :error then do:
    11073           find first buf_bar-code no-lock
    11074             where buf_bar-code.b-code = locb-price-list.b-code
    11075             no-error
    11076           .
    11077           if not available buf_bar-code
    11078             and locb-price-list.doc-qnty = ?
    11079           then do:
    11080             delete locb-price-list.
    11081           end.
    11082         end.
    11083       end.
    11084       when "doc-attr" then do:
    11085         create locb-doc-attr.
    11086   run nws-impl in p-imp-handle
    11087     ( input "doc-attr":U
    11088      ,input (buffer locb-doc-attr:handle)
    11089     ) no-error.
    11090   if error-status :error then do:
    11091     return error substitute( "&1&2&3", return-value, chr(10), error-status :get-message(1) ) .
    11092   end.
    11093       end.
    11094       when "price-list-attr" then do:
    11095         create locb-price-list-attr.
    11096   run nws-impl in p-imp-handle
    11097     ( input "price-list-attr":U
    11098      ,input (buffer locb-price-list-attr:handle)
    11099     ) no-error.
    11100   if error-status :error then do:
    11101     return error substitute( "&1&2&3", return-value, chr(10), error-status :get-message(1) ) .
    11102   end.
    11103       end.
    11104       otherwise do:
    11105         message "Не предусмотрен прием таблицы " rec-name skip
    11106                 "в составе переоценки."
    11107                 view-as alert-box error.
    11108         return error.
    11109       end.
    11110     END CASE.
    11111   end.
    11112   for each buf_price-list where buf_price-list.doc-num = wt-price-doc.doc-num
    11113   on error  undo, return error
    11114   :
    11115     delete buf_price-list.
    11116   end.
    11117   for each locb-price-list where locb-price-list.doc-num = wt-price-doc.doc-num
    11118                            no-lock
    11119   on error  undo, return error
    11120   :
    11121     create buf_price-list.
    11122     buffer-copy  locb-price-list to buf_price-list.
    11123   end.
    11124   for each buf_doc-attr where buf_doc-attr.doc-code = wt-price-doc.doc-num
    11125   on error  undo, return error
    11126   :
    11127     delete buf_doc-attr.
    11128   end.
    11129   for each locb-doc-attr where locb-doc-attr.doc-code = wt-price-doc.doc-num
    11130                          no-lock
    11131   on error  undo, return error
    11132   :
    11133     create buf_doc-attr.
    11134     buffer-copy locb-doc-attr to buf_doc-attr.
    11135   end.
    11136   for each buf_price-list-attr where buf_price-list-attr.doc-num = wt-price-doc.doc-num
    11137   on error  undo, return error
    11138   :
    11139     delete buf_price-list-attr.
    11140   end.
    11141   for each locb-price-list-attr where locb-price-list-attr.doc-num = wt-price-doc.doc-num
    11142                          no-lock
    11143   on error  undo, return error
    11144   :
    11145     create buf_price-list-attr.
    11146     buffer-copy locb-price-list-attr to buf_price-list-attr.
    11147   end.
    11148   if not available tb-price-doc then do:
    11149     create tb-price-doc.
    11150   end.
    11151   define variable v-old-price-doc-status as character no-undo .
    11152   define variable v-new-price-doc-status as character no-undo .
    11153   assign
    11154     v-old-price-doc-status = tb-price-doc.status_
    11155     v-new-price-doc-status = wt-price-doc.status_
    11156   .
    11157   run trg/nwsdochs.p
    11158     (input g#db-num
    11159     ,input 'update':U
    11160     ,input wt-price-doc.doc-num
    11161     ,input wt-price-doc.obj-type
    11162     ,input wt-price-doc.obj-code
    11163     ,input 'price-doc':U
    11164     ,input 'ot':U
    11165     ,input wt-price-doc.fact-date
    11166     ,input wt-price-doc.rest-qnty
    11167     ,input 0
    11168     ,input 0
    11169     ,input 0
    11170     ,input v-old-price-doc-status
    11171     ,input v-new-price-doc-status
    11172     ,input g#news-source-db
    11173     ,input p-pck-num
    11174     ,input wt-price-doc.user-db-num
    11175     ,input wt-price-doc.user-name
    11176     ,input wt-price-doc.sys-date
    11177     ,input wt-price-doc.sys-time
    11178     ,input wt-price-doc.sys-time-int
    11179     ) no-error .
    11180   if error-status :error then do:
    11181     run write-to-log in this-procedure
    11182       (input substitute("&1 &2", error-status :get-message(1), return-value )
    11183       ) .
    11184     undo, return error .
    11185   end.
    11186   buffer-copy wt-price-doc to tb-price-doc.
    11187   for each locb-price-list
    11188   on error  undo, return error
    11189   :
    11190     delete locb-price-list.
    11191   end.
    11192   for each locb-doc-attr
    11193   on error  undo, return error
    11194   :
    11195     delete locb-doc-attr.
