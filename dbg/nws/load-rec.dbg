    10138   on endkey undo, return error :
    10139     delete locb-ord-line-attr.
    10140   end.
    10141   for each locb-ord-doc-attr
    10142   on error  undo, return error
    10143   on stop   undo, return error
    10144   on endkey undo, return error :
    10145     delete locb-ord-doc-attr.
    10146   end.
    10147   for each locb-ord-dtl
    10148   on error  undo, return error
    10149   on stop   undo, return error
    10150   on endkey undo, return error :
    10151     delete locb-ord-dtl.
    10152   end.
    10153       for each wt-ord-doc
    10154       on error undo, return error substitute( "$proc-load-ord-doc(del-wt-). &1&2&3", return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    10155       :
    10156         delete wt-ord-doc .
    10157       end.
    10158       create wt-ord-doc.
    10159       run nws-impl in p-imp-handle
    10160         ( input 'ord-doc':U
    10161          ,input (buffer wt-ord-doc:handle)
    10162         ) no-error.
    10163       if error-status :error then do:
    10164         return error return-value .
    10165       end.
    10166       find first tb-ord-doc
    10167         where tb-ord-doc.doc-code = wt-ord-doc.doc-code
    10168         exclusive-lock no-error.
    10169   define variable vss-include-info114 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10170   DO counter = 1 TO l-counter
    10171   on error  undo, return error
    10172   on endkey undo, return error :
    10173   run nws-imps in p-imp-handle
    10174     ( input-output counter
    10175      ,output       rec-full
    10176     ) no-error.
    10177   if error-status :error then do:
    10178     return error substitute( "&1&2&3", return-value, chr(10), error-status :get-message(1) ) .
    10179   end.
    10180     assign
    10181       rec-name = entry( 1, rec-full, chr(1) )
    10182       .
    10183     CASE rec-name :
    10184       when "ord-line" then do:
    10185         create locb-ord-line.
    10186   run nws-impl in p-imp-handle
    10187     ( input "ord-line":U
    10188      ,input (buffer locb-ord-line:handle)
    10189     ) no-error.
    10190   if error-status :error then do:
    10191     return error substitute( "&1&2&3", return-value, chr(10), error-status :get-message(1) ) .
    10192   end.
    10193       end.
    10194       when "ord-line-attr" then do:
    10195         create locb-ord-line-attr.
    10196   run nws-impl in p-imp-handle
    10197     ( input "ord-line-attr":U
    10198      ,input (buffer locb-ord-line-attr:handle)
    10199     ) no-error.
    10200   if error-status :error then do:
    10201     return error substitute( "&1&2&3", return-value, chr(10), error-status :get-message(1) ) .
    10202   end.
    10203       end.
    10204       when "ord-doc-attr" then do:
    10205         create locb-ord-doc-attr.
    10206   run nws-impl in p-imp-handle
    10207     ( input "ord-doc-attr":U
    10208      ,input (buffer locb-ord-doc-attr:handle)
    10209     ) no-error.
    10210   if error-status :error then do:
    10211     return error substitute( "&1&2&3", return-value, chr(10), error-status :get-message(1) ) .
    10212   end.
    10213       end.
    10214       when "ord-dtl" then do:
    10215         create locb-ord-dtl.
    10216   run nws-impl in p-imp-handle
    10217     ( input "ord-dtl":U
    10218      ,input (buffer locb-ord-dtl:handle)
    10219     ) no-error.
    10220   if error-status :error then do:
    10221     return error substitute( "&1&2&3", return-value, chr(10), error-status :get-message(1) ) .
    10222   end.
    10223       end.
    10224       otherwise do:
    10225         message "Не предусмотрен прием таблицы " rec-name skip
    10226                 "в составе заказов."
    10227                 view-as alert-box error.
    10228         return error.
    10229       end.
    10230     END CASE.
    10231   end.
    10232   for each buf_ord-line where buf_ord-line.doc-code = wt-ord-doc.doc-code
    10233   on error  undo, return error
    10234   on stop   undo, return error
    10235   on endkey undo, return error :
    10236     delete buf_ord-line.
    10237   end.
    10238   for each locb-ord-line where locb-ord-line.doc-code = wt-ord-doc.doc-code
    10239                          no-lock
    10240   on error  undo, return error
    10241   on stop   undo, return error
