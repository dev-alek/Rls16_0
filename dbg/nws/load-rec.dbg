    18282   define temp-table wt-c-wth-doc no-undo like ub.c-wth-doc.
    18283   PROCEDURE proc-load-c-wth-doc:
    18284     define input parameter p-imp-handle as handle  no-undo.
    18285     define input parameter p-pck-num    as integer no-undo.
    18286     define input parameter l-counter    as integer no-undo.
    18287     do
    18288     on error  undo, return error substitute( "$proc-load-c-wth-doc. &1&2&3", return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    18289     on stop   undo, return error substitute( "$proc-load-c-wth-doc. stop" )
    18290     on endkey undo, return error substitute( "$proc-load-c-wth-doc. endkey" )
    18291     :
    18292       define buffer tb-c-wth-doc for ub.c-wth-doc.
    18293       define variable compare-log as logical no-undo.
    18294   define variable vss-include-info188 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    18295   define buffer buf_c-wth-line      for ub.c-wth-line.
    18296   define buffer buf_c-wth-dtl       for ub.c-wth-dtl.
    18297   define buffer buf_c-wth-parts     for ub.c-wth-parts.
    18298   define buffer buf_c-inkas-pay-wth for ub.c-inkas-pay-wth.
    18299   define variable counter  as integer   no-undo.
    18300   define variable rec-full as character no-undo.
    18301   define variable rec-name as character no-undo.
    18302   for each locb-c-wth-line
    18303   on error undo, return error error-status :get-message (1)
    18304   :
    18305     delete locb-c-wth-line.
    18306   end.
    18307   for each locb-c-wth-dtl
    18308   on error undo, return error error-status :get-message (1)
    18309   :
    18310     delete locb-c-wth-dtl.
    18311   end.
    18312   for each locb-c-wth-parts
    18313   on error undo, return error error-status :get-message (1)
    18314   :
    18315     delete locb-c-wth-parts.
    18316   end.
    18317   for each locbw-c-inkas-pay-wth
    18318   on error undo, return error error-status :get-message (1)
    18319   :
    18320     delete locbw-c-inkas-pay-wth.
    18321   end.
    18322       for each wt-c-wth-doc
    18323       on error undo, return error substitute( "$proc-load-c-wth-doc(del-wt-). &1&2&3", return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    18324       :
    18325         delete wt-c-wth-doc .
    18326       end.
    18327       create wt-c-wth-doc.
    18328       run nws-impl in p-imp-handle
    18329         ( input 'c-wth-doc':U
    18330          ,input (buffer wt-c-wth-doc:handle)
    18331         ) no-error.
    18332       if error-status :error then do:
    18333         return error return-value .
    18334       end.
    18335       find first tb-c-wth-doc
    18336         where tb-c-wth-doc.doc-code = wt-c-wth-doc.doc-code
    18337           and tb-c-wth-doc.corr-user-db-num = wt-c-wth-doc.corr-user-db-num
    18338           and tb-c-wth-doc.chip-num = wt-c-wth-doc.chip-num
    18339         exclusive-lock no-error.
    18340   define variable vss-include-info189 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    18341   DO counter = 1 TO l-counter
    18342   on error  undo, return error
    18343   on endkey undo, return error :
    18344   run nws-imps in p-imp-handle
    18345     ( input-output counter
    18346      ,output       rec-full
    18347     ) no-error.
    18348   if error-status :error then do:
    18349     return error substitute( "&1&2&3", return-value, chr(10), error-status :get-message(1) ) .
    18350   end.
    18351     assign
    18352       rec-name = entry( 1, rec-full, chr(1) )
    18353       .
    18354     CASE rec-name :
    18355       when "c-wth-line" then do:
    18356         create locb-c-wth-line.
    18357   run nws-impl in p-imp-handle
    18358     ( input "c-wth-line":U
    18359      ,input (buffer locb-c-wth-line:handle)
    18360     ) no-error.
    18361   if error-status :error then do:
    18362     return error substitute( "&1&2&3", return-value, chr(10), error-status :get-message(1) ) .
    18363   end.
    18364       end.
    18365       when "c-wth-dtl" then do:
    18366         create locb-c-wth-dtl.
    18367   run nws-impl in p-imp-handle
    18368     ( input "c-wth-dtl":U
    18369      ,input (buffer locb-c-wth-dtl:handle)
    18370     ) no-error.
    18371   if error-status :error then do:
    18372     return error substitute( "&1&2&3", return-value, chr(10), error-status :get-message(1) ) .
    18373   end.
    18374       end.
    18375       when "c-wth-parts" then do:
    18376         create locb-c-wth-parts.
    18377   run nws-impl in p-imp-handle
    18378     ( input "c-wth-parts":U
    18379      ,input (buffer locb-c-wth-parts:handle)
    18380     ) no-error.
    18381   if error-status :error then do:
    18382     return error substitute( "&1&2&3", return-value, chr(10), error-status :get-message(1) ) .
    18383   end.
    18384       end.
    18385       when "c-inkas-pay-wth" then do:
    18386         create locb2-c-inkas-pay-wth.
    18387   run nws-impl in p-imp-handle
    18388     ( input "c-inkas-pay-wth":U
    18389      ,input (buffer locb2-c-inkas-pay-wth:handle)
    18390     ) no-error.
    18391   if error-status :error then do:
    18392     return error substitute( "&1&2&3", return-value, chr(10), error-status :get-message(1) ) .
    18393   end.
    18394       end.
    18395       otherwise do:
    18396         message "Не предусмотрен прием таблицы " rec-name skip
    18397                 "в составе истории документа мат. ценностей"
    18398                 view-as alert-box error.
    18399         return error.
    18400       end.
    18401     END CASE.
    18402   end.
    18403   if not available tb-c-wth-doc then do:
    18404     create tb-c-wth-doc.
    18405   end.
    18406   buffer-copy wt-c-wth-doc to tb-c-wth-doc.
    18407   for each buf_c-wth-dtl where buf_c-wth-dtl.doc-code = wt-c-wth-doc.doc-code
    18408   on error  undo, return error
    18409   on stop   undo, return error
    18410   on endkey undo, return error :
    18411     delete buf_c-wth-dtl.
    18412   end.
    18413   for each locb-c-wth-dtl where locb-c-wth-dtl.doc-code = wt-c-wth-doc.doc-code
    18414                         no-lock
    18415   on error  undo, return error
    18416   on stop   undo, return error
    18417   on endkey undo, return error :
    18418     create buf_c-wth-dtl.
    18419     buffer-copy locb-c-wth-dtl to buf_c-wth-dtl.
    18420   end.
    18421   on delete of ub.c-wth-line override do: end.
    18422   for each buf_c-wth-line where buf_c-wth-line.doc-code = wt-c-wth-doc.doc-code
    18423   on error  undo, return error
    18424   on stop   undo, return error
    18425   on endkey undo, return error :
    18426     delete buf_c-wth-line.
    18427   end.
    18428   for each locb-c-wth-line where locb-c-wth-line.doc-code = wt-c-wth-doc.doc-code
    18429                          no-lock
    18430   on error  undo, return error
    18431   on stop   undo, return error
    18432   on endkey undo, return error :
    18433     create buf_c-wth-line.
    18434     buffer-copy locb-c-wth-line to buf_c-wth-line.
    18435   end.
    18436   on delete of ub.c-wth-parts override do: end.
    18437   for each buf_c-wth-parts where buf_c-wth-parts.out-code = wt-c-wth-doc.doc-code
    18438   on error  undo, return error
    18439   on stop   undo, return error
    18440   on endkey undo, return error :
    18441     delete buf_c-wth-parts.
    18442   end.
    18443   for each locb-c-wth-parts where locb-c-wth-parts.out-code = wt-c-wth-doc.doc-code
    18444                          no-lock
    18445   on error  undo, return error
    18446   on stop   undo, return error
    18447   on endkey undo, return error :
    18448     create buf_c-wth-parts.
    18449     buffer-copy locb-c-wth-parts to buf_c-wth-parts.
    18450   end.
    18451   for each buf_c-inkas-pay-wth where buf_c-inkas-pay-wth.inkas-code = wt-c-wth-doc.doc-code
    18452   on error  undo, return error
    18453   on stop   undo, return error
    18454   on endkey undo, return error :
    18455     delete buf_c-inkas-pay-wth.
    18456   end.
    18457   for each locbw2-c-inkas-pay-wth where locbw2-c-inkas-pay-wth.inkas-code = wt-c-wth-doc.doc-code
    18458                           no-lock
    18459   on error  undo, return error
    18460   on stop   undo, return error
    18461   on endkey undo, return error :
    18462     create buf_c-inkas-pay-wth.
    18463     buffer-copy locbw2-c-inkas-pay-wth to buf_c-inkas-pay-wth.
    18464   end.
    18465   for each locb-c-wth-line
    18466   on error  undo, return error
    18467   on stop   undo, return error
    18468   on endkey undo, return error :
    18469     delete locb-c-wth-line.
    18470   end.
    18471   for each locb-c-wth-dtl
    18472   on error  undo, return error
    18473   on stop   undo, return error
    18474   on endkey undo, return error :
    18475     delete locb-c-wth-dtl.
    18476   end.
    18477   for each locb-c-wth-parts
    18478   on error  undo, return error
    18479   on stop   undo, return error
    18480   on endkey undo, return error :
    18481     delete locb-c-wth-parts.
    18482   end.
    18483   for each locbw2-c-inkas-pay-wth
    18484   on error  undo, return error
    18485   on stop   undo, return error
    18486   on endkey undo, return error :
    18487     delete locbw2-c-inkas-pay-wth.
    18488   end.
    18489       delete wt-c-wth-doc.
    18490     end.
    18491   END PROCEDURE.
