    10116     on stop   undo, return error substitute( "$proc-load-ord-doc. stop" )
    10117     on endkey undo, return error substitute( "$proc-load-ord-doc. endkey" )
    10118     :
    10119       define buffer tb-ord-doc for ub.ord-doc.
    10120       define variable compare-log as logical no-undo.
    10121   define variable vss-include-info113 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10122   define buffer buf_ord-line      for ub.ord-line.
    10123   define buffer buf_ord-dtl       for ub.ord-dtl.
    10124   define buffer buf_ord-line-attr      for ub.ord-line-attr.
    10125   define buffer buf_ord-doc-attr       for ub.ord-doc-attr.
    10126   def var counter  as integer   no-undo.
