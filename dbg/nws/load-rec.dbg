     2591       end.
     2592       create wt-contract.
     2593       run nws-impl in p-imp-handle
     2594         ( input 'contract':U
     2595          ,input (buffer wt-contract:handle)
     2596         ) no-error.
     2597       if error-status :error then do:
     2598         return error return-value .
     2599       end.
     2600       find first tb-contract
     2601         where tb-contract.host-code = wt-contract.host-code
     2602           and tb-contract.contract-code = wt-contract.contract-code
     2603         exclusive-lock no-error.
     2604   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2605   DO counter = 1 TO l-counter
     2606   on error  undo, return error
     2607   on endkey undo, return error :
     2608   run nws-imps in p-imp-handle
     2609     ( input-output counter
     2610      ,output       rec-full
     2611     ) no-error.
     2612   if error-status :error then do:
     2613     return error substitute( "&1&2&3", return-value, chr(10), error-status :get-message(1) ) .
     2614   end.
     2615     assign
     2616       rec-name = entry( 1, rec-full, chr(1) )
     2617       .
     2618     CASE rec-name :
     2619       when "contract-line" then do:
     2620         create locb-contract-line.
     2621   run nws-impl in p-imp-handle
     2622     ( input "contract-line":U
     2623      ,input (buffer locb-contract-line:handle)
     2624     ) no-error.
     2625   if error-status :error then do:
     2626     return error substitute( "&1&2&3", return-value, chr(10), error-status :get-message(1) ) .
     2627   end.
     2628       end.
     2629       otherwise do:
     2630         message "Не предусмотрен прием таблицы " rec-name skip "в составе договора." view-as alert-box error.
     2631         return error.
     2632       end.
     2633     END CASE.
     2634   end.
     2635   for each buf_contract-line where buf_contract-line.contract-num = wt-contract.contract-code and
     2636                                 buf_contract-line.host-code = wt-contract.host-code
     2637   on error  undo, return error
     2638   on stop   undo, return error
     2639   on endkey undo, return error :
     2640     delete buf_contract-line.
     2641   end.
     2642   for each locb-contract-line where locb-contract-line.contract-num = wt-contract.contract-code and
     2643                                  locb-contract-line.host-code = wt-contract.host-code
     2644                          no-lock
     2645   on error  undo, return error
     2646   on stop   undo, return error
     2647   on endkey undo, return error :
     2648     create buf_contract-line.
     2649     buffer-copy locb-contract-line to buf_contract-line.
     2650   end.
     2651   if not available tb-contract then do:
     2652     create tb-contract.
     2653   end.
     2654   buffer-copy wt-contract to tb-contract.
     2655   for each locb-contract-line
     2656   on error  undo, return error
     2657   on stop   undo, return error
     2658   on endkey undo, return error :
     2659     delete locb-contract-line.
     2660   end.
     2661       delete wt-contract.
     2662     end.
     2663   END PROCEDURE.
