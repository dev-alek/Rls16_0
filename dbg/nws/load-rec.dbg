     4165   define temp-table locb-factur-connect-line no-undo like ub.factur-connect-line.
     4166   define temp-table wt-factur-connect no-undo like ub.factur-connect.
     4167   PROCEDURE proc-load-factur-connect:
     4168     define input parameter p-imp-handle as handle  no-undo.
     4169     define input parameter p-pck-num    as integer no-undo.
     4170     define input parameter l-counter    as integer no-undo.
     4171     do
     4172     on error  undo, return error substitute( "$proc-load-factur-connect. &1&2&3", return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     4173     on stop   undo, return error substitute( "$proc-load-factur-connect. stop" )
     4174     on endkey undo, return error substitute( "$proc-load-factur-connect. endkey" )
     4175     :
     4176       define buffer tb-factur-connect for ub.factur-connect.
     4177       define variable compare-log as logical no-undo.
     4178   define variable vss-include-info59 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4179   define buffer buf_factur-connect-line for ub.factur-connect-line.
     4180   def var counter  as integer   no-undo.
     4181   def var rec-full as character no-undo.
     4182   def var rec-name as character no-undo.
     4183   for each locb-factur-connect-line
     4184   on error undo, return error error-status :get-message (1)
     4185   :
     4186     delete locb-factur-connect-line.
     4187   end.
     4188       for each wt-factur-connect
     4189       on error undo, return error substitute( "$proc-load-factur-connect(del-wt-). &1&2&3", return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     4190       :
     4191         delete wt-factur-connect .
     4192       end.
     4193       create wt-factur-connect.
     4194       run nws-impl in p-imp-handle
     4195         ( input 'factur-connect':U
     4196          ,input (buffer wt-factur-connect:handle)
     4197         ) no-error.
     4198       if error-status :error then do:
     4199         return error return-value .
     4200       end.
     4201       find first tb-factur-connect
     4202         where tb-factur-connect.db-num = wt-factur-connect.db-num
     4203           and tb-factur-connect.connect-code = wt-factur-connect.connect-code
     4204         exclusive-lock no-error.
     4205   define variable vss-include-info60 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4206   DO counter = 1 TO l-counter
     4207   on error  undo, return error
     4208   on endkey undo, return error :
     4209   run nws-imps in p-imp-handle
     4210     ( input-output counter
     4211      ,output       rec-full
     4212     ) no-error.
     4213   if error-status :error then do:
     4214     return error substitute( "&1&2&3", return-value, chr(10), error-status :get-message(1) ) .
     4215   end.
     4216     assign
     4217       rec-name = entry( 1, rec-full, chr(1) )
     4218       .
     4219     CASE rec-name :
     4220       when "factur-connect-line" then do:
     4221         create locb-factur-connect-line.
     4222   run nws-impl in p-imp-handle
     4223     ( input "factur-connect-line":U
     4224      ,input (buffer locb-factur-connect-line:handle)
     4225     ) no-error.
     4226   if error-status :error then do:
     4227     return error substitute( "&1&2&3", return-value, chr(10), error-status :get-message(1) ) .
     4228   end.
     4229       end.
     4230       otherwise do:
     4231         message "Не предусмотрен прием таблицы " rec-name skip
     4232                 "в составе савокупных заявок."
     4233                 view-as alert-box error.
     4234         return error.
     4235       end.
     4236     END CASE.
     4237   end.
     4238   for each buf_factur-connect-line where buf_factur-connect-line.connect-code = wt-factur-connect.connect-code and
     4239                                          buf_factur-connect-line.db-num    = wt-factur-connect.db-num
     4240   on error  undo, return error
     4241   on stop   undo, return error
     4242   on endkey undo, return error :
     4243     delete buf_factur-connect-line.
     4244   end.
     4245   for each locb-factur-connect-line where locb-factur-connect-line.connect-code = wt-factur-connect.connect-code and
     4246                                           locb-factur-connect-line.db-num    = wt-factur-connect.db-num
     4247                          no-lock
     4248   on error  undo, return error
     4249   on stop   undo, return error
     4250   on endkey undo, return error :
     4251     create buf_factur-connect-line.
     4252     buffer-copy locb-factur-connect-line to buf_factur-connect-line.
     4253   end.
     4254   if not available tb-factur-connect then do:
     4255     create tb-factur-connect.
     4256   end.
     4257   buffer-copy wt-factur-connect to tb-factur-connect.
     4258   for each locb-factur-connect-line
     4259   on error  undo, return error
     4260   on stop   undo, return error
     4261   on endkey undo, return error :
     4262     delete locb-factur-connect-line.
     4263   end.
     4264       delete wt-factur-connect.
     4265     end.
     4266   END PROCEDURE.
