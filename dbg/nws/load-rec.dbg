    18951   define variable gtin as character no-undo.
    18952   define variable mySeqUtd as int64 no-undo init ?.
    18953   procedure MySeqForUtd:
    18954      define input  parameter iTable       as character no-undo.
    18955      define input  parameter iseqnamehist as character no-undo.
    18956      define input  parameter idb-name     as character no-undo.
    18957      define output parameter Oseq         as int64 no-undo.
    18958      if iTable begins "utd"
    18959      then do:
    18960         if myseqUtd eq ?
    18961         then
    18962            myseqUtd = dynamic-next-value(iseqnamehist,idb-name).
    18963         Oseq = myseqUtd.
    18964      end.
    18965      else
    18966         Oseq = ?.
    18967      return.
    18968   end.
