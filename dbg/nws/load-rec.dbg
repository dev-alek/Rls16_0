     2519       :
     2520         delete wt-clients-attr .
     2521       end.
     2522       create wt-clients-attr.
     2523       run nws-impl in p-imp-handle
     2524         ( input 'clients-attr':U
     2525          ,input (buffer wt-clients-attr:handle)
     2526         ) no-error.
     2527       if error-status :error then do:
     2528         return error return-value .
     2529       end.
     2530       find first tb-clients-attr
     2531         where tb-clients-attr.obj-type = wt-clients-attr.obj-type
     2532           and tb-clients-attr.obj-code = wt-clients-attr.obj-code
     2533           and tb-clients-attr.attr-code = wt-clients-attr.attr-code
     2534         exclusive-lock no-error.
     2535   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2536   if not available tb-clients-attr then do:
     2537      create tb-clients-attr.
     2538      assign compare-log = no.
     2539   end.
     2540   else do:
     2541      buffer-compare tb-clients-attr TO wt-clients-attr case-sensitive save result in compare-log no-error.
     2542   end.
     2543   if not compare-log then do:
     2544      buffer-copy wt-clients-attr TO tb-clients-attr.
     2545      if wt-clients-attr.attr-code = "envd" then do:
     2546         for each tax-rate-attr where
     2547                  tax-rate-attr.attr-code = wt-clients-attr.attr-code
     2548         no-lock,
     2549             each tax-rate-gds where
     2550                  tax-rate-gds.tax-code  = tax-rate-attr.tax-code
     2551              and tax-rate-gds.rate-code = tax-rate-attr.rate-code
     2552              and tax-rate-gds.fact-date <= today
     2553         no-lock:
     2554            run fill-g-list in p-imp-handle (tax-rate-gds.gds-code,
     2555                                             wt-clients-attr.obj-type,
     2556                                             wt-clients-attr.obj-code).
     2557         end.
     2558      end.
     2559   end.
     2560       delete wt-clients-attr.
     2561     end.
     2562   END PROCEDURE.
     2563   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2564   define temp-table locb-contract-line no-undo like ub.contract-line.
     2565   define temp-table wt-contract no-undo like ub.contract.
     2566   PROCEDURE proc-load-contract:
