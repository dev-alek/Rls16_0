    11617                                     ,input wt-price-doc-forming.plt-db-num
    11618                                     ,input wt-price-doc-forming.pdf-id
    11619                                     ,input wt-price-doc-forming.pdf-db
    11620                                     ,input (if wt-price-doc-forming.STTS = integer('1':U) then yes else no)
    11621                                     ).
    11622   end.
    11623       delete wt-price-doc-forming.
    11624     end.
    11625   END PROCEDURE.
