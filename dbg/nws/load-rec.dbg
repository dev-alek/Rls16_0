    15435   define temp-table locb-arh-trn-doc-contract no-undo like ub.arh-trn-doc-contract.
    15436   define temp-table tdlocb-chk-doc            no-undo like ub.chk-doc.
    15437   define temp-table tdlocb-c-chk-doc          no-undo like ub.c-chk-doc.
    15438   define temp-table tdlocb-chk-gds            no-undo like ub.chk-gds.
    15439   define temp-table tdlocb-chk-gds-attr       no-undo like ub.chk-gds-attr.
    15440   define temp-table tdlocb-c-chk-gds          no-undo like ub.c-chk-gds.
