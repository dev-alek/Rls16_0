    10730   on endkey undo, return error :
    10731     delete buf_ord-rcv-line-attr.
    10732   end.
    10733   for each locb-ord-rcv-line-attr where locb-ord-rcv-line-attr.rcv-code = wt-ord-doc-rcv.rcv-code and
    10734                                    locb-ord-rcv-line-attr.doc-code = wt-ord-doc-rcv.doc-code
    10735                          no-lock
    10736   on error  undo, return error
