    15189           and tb-tax-rate.rate-code = wt-tax-rate.rate-code
    15190         exclusive-lock no-error.
    15191   define variable vss-include-info168 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    15192   if not available tb-tax-rate then do:
    15193     create tb-tax-rate.
    15194     assign compare-log = no.
    15195   end.
    15196   else do:
    15197     buffer-compare tb-tax-rate TO wt-tax-rate case-sensitive save result in compare-log no-error.
    15198   end.
    15199   if not compare-log then do:
    15200     buffer-copy wt-tax-rate TO tb-tax-rate.
    15201     find buf_tax where buf_tax.tax-code = tb-tax-rate.tax-code no-lock no-error.
    15202     define variable v-host-code as integer   no-undo .
    15203     if available buf_tax
    15204     and buf_tax.to-cashdesk = yes
    15205     then do:
    15206       for each buf_clients no-lock
    15207         where buf_clients.obj-type = 'маг':U
    15208           and buf_clients.db-num = g#db-num
    15209       on error undo, return error return-value
    15210       :
    15211   define variable vss-include-info169 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    15212   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
    15213     (input  buf_clients.obj-type
    15214     ,input  buf_clients.obj-code
    15215     ,output v-host-code
    15216     )  .
    15217         run fill-cash-txr in p-imp-handle (
    15218                                              input tb-tax-rate.tax-code
    15219                                             ,input tb-tax-rate.rate-code
    15220                                             ,input tb-tax-rate.status_
    15221                                             ,input v-host-code
    15222                                             ,input buf_clients.obj-type
    15223                                             ,input buf_clients.obj-code
    15224                                             ,input buf_tax.tax-type
    15225                                             ,input ?
    15226                                             ,input tb-tax-rate.rate-code
    15227                                             ,input recid(tb-tax-rate)
    15228                                             ).
    15229       end.
    15230     end.
    15231   end.
    15232       delete wt-tax-rate.
    15233     end.
    15234   END PROCEDURE.
