     6871   :
     6872     delete locb-obj-grp-obj-price.
     6873   end.
     6874       delete wt-grp-obj-price.
     6875     end.
     6876   END PROCEDURE.
     6877   define temp-table locb-icnt-line     no-undo like ub.icnt-line.
     6878   define temp-table locbi-doc-attr      no-undo like ub.doc-attr.
     6879   define temp-table wt-icnt-doc no-undo like ub.icnt-doc.
     6880   PROCEDURE proc-load-icnt-doc:
     6881     define input parameter p-imp-handle as handle  no-undo.
     6882     define input parameter p-pck-num    as integer no-undo.
     6883     define input parameter l-counter    as integer no-undo.
     6884     do
     6885     on error  undo, return error substitute( "$proc-load-icnt-doc. &1&2&3", return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     6886     on stop   undo, return error substitute( "$proc-load-icnt-doc. stop" )
     6887     on endkey undo, return error substitute( "$proc-load-icnt-doc. endkey" )
     6888     :
     6889       define buffer tb-icnt-doc for ub.icnt-doc.
     6890       define variable compare-log as logical no-undo.
     6891   define variable vss-include-info99 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6892   define buffer buf_icnt-line      for ub.icnt-line.
     6893   define buffer buf_doc-attr       for ub.doc-attr.
     6894   define variable counter  as integer   no-undo.
     6895   define variable rec-full as character no-undo.
     6896   define variable rec-name as character no-undo.
     6897   for each locb-icnt-line
     6898   on error  undo, return error substitute( "&1. &2&3&4", vss-include-info99, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     6899   on stop   undo, return error substitute( "&1. stop", vss-include-info99 )
     6900   on endkey undo, return error substitute( "&1. endkey", vss-include-info99 )
     6901   :
     6902     delete locb-icnt-line.
     6903   end.
     6904   for each locbi-doc-attr
     6905   on error  undo, return error substitute( "&1. &2&3&4", vss-include-info99, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     6906   on stop   undo, return error substitute( "&1. stop", vss-include-info99 )
     6907   on endkey undo, return error substitute( "&1. endkey", vss-include-info99 )
     6908   :
     6909     delete locbi-doc-attr.
     6910   end.
     6911       for each wt-icnt-doc
     6912       on error undo, return error substitute( "$proc-load-icnt-doc(del-wt-). &1&2&3", return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     6913       :
     6914         delete wt-icnt-doc .
     6915       end.
     6916       create wt-icnt-doc.
     6917       run nws-impl in p-imp-handle
     6918         ( input 'icnt-doc':U
     6919          ,input (buffer wt-icnt-doc:handle)
     6920         ) no-error.
     6921       if error-status :error then do:
     6922         return error return-value .
     6923       end.
     6924       find first tb-icnt-doc
     6925         where tb-icnt-doc.doc-code = wt-icnt-doc.doc-code
     6926         exclusive-lock no-error.
     6927   define variable vss-include-info100 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6928   DO counter = 1 TO l-counter
     6929   on error  undo, return error
     6930   on endkey undo, return error :
     6931   run nws-imps in p-imp-handle
     6932     ( input-output counter
     6933      ,output       rec-full
     6934     ) no-error.
     6935   if error-status :error then do:
     6936     return error substitute( "&1&2&3", return-value, chr(10), error-status :get-message(1) ) .
     6937   end.
     6938     assign
     6939       rec-name = entry( 1, rec-full, chr(1) )
     6940       .
     6941     CASE rec-name :
     6942       when "icnt-line" then do:
     6943         create locb-icnt-line.
     6944   run nws-impl in p-imp-handle
     6945     ( input "icnt-line":U
     6946      ,input (buffer locb-icnt-line:handle)
     6947     ) no-error.
     6948   if error-status :error then do:
     6949     return error substitute( "&1&2&3", return-value, chr(10), error-status :get-message(1) ) .
     6950   end.
     6951       end.
     6952       when "doc-attr" then do:
     6953         create locbi-doc-attr.
     6954   run nws-impl in p-imp-handle
     6955     ( input "doc-attr":U
     6956      ,input (buffer locbi-doc-attr:handle)
     6957     ) no-error.
     6958   if error-status :error then do:
     6959     return error substitute( "&1&2&3", return-value, chr(10), error-status :get-message(1) ) .
     6960   end.
     6961       end.
     6962       otherwise do:
     6963         message "Не предусмотрен прием таблицы " rec-name skip
     6964                 "в составе документов инв. счетчиков ТРК."
     6965                 view-as alert-box error.
     6966         return error.
     6967       end.
     6968     END CASE.
     6969   end.
     6970   for each buf_icnt-line where buf_icnt-line.doc-code = wt-icnt-doc.doc-code
     6971   on error  undo, return error
     6972   on stop   undo, return error
     6973   on endkey undo, return error :
     6974     delete buf_icnt-line.
     6975   end.
     6976   for each locb-icnt-line where locb-icnt-line.doc-code = wt-icnt-doc.doc-code
     6977                          no-lock
     6978   on error  undo, return error
     6979   on stop   undo, return error
     6980   on endkey undo, return error :
     6981     create buf_icnt-line.
     6982     buffer-copy locb-icnt-line to buf_icnt-line.
     6983   end.
     6984   for each buf_doc-attr where buf_doc-attr.doc-code = wt-icnt-doc.doc-code
     6985   on error  undo, return error
     6986   on stop   undo, return error
     6987   on endkey undo, return error :
     6988     delete buf_doc-attr.
     6989   end.
     6990   for each locbi-doc-attr where locbi-doc-attr.doc-code = wt-icnt-doc.doc-code
     6991                          no-lock
     6992   on error  undo, return error
     6993   on stop   undo, return error
     6994   on endkey undo, return error :
     6995     create buf_doc-attr.
     6996     buffer-copy locbi-doc-attr to buf_doc-attr.
     6997   end.
     6998   if not available tb-icnt-doc then do:
     6999     create tb-icnt-doc.
     7000   end.
     7001   define variable v-old-icnt-doc-status as character no-undo .
     7002   define variable v-new-icnt-doc-status as character no-undo .
     7003   if tb-icnt-doc.status_ = ""
     7004   or tb-icnt-doc.status_ = ?
     7005   then do:
     7006     assign
     7007       v-old-icnt-doc-status = ""
     7008     .
     7009   end.
     7010   else do:
     7011     assign
     7012       v-old-icnt-doc-status = tb-icnt-doc.status_ + string(tb-icnt-doc.flag_, '+/-':u)
     7013     .
     7014   end.
     7015   assign
     7016     v-new-icnt-doc-status = wt-icnt-doc.status_ + string(wt-icnt-doc.flag_, '+/-':u)
     7017   .
     7018   run trg/nwsdochs.p
     7019     (input g#db-num
     7020     ,input 'update':U
     7021     ,input wt-icnt-doc.doc-code
     7022     ,input wt-icnt-doc.obj-type
     7023     ,input wt-icnt-doc.obj-code
     7024     ,input 'icnt-doc':U
     7025     ,input wt-icnt-doc.ext-doc-type
     7026     ,input wt-icnt-doc.fact-date
     7027     ,input wt-icnt-doc.state-mh-cnt
     7028     ,input 0
     7029     ,input 0
     7030     ,input 0
     7031     ,input v-old-icnt-doc-status
     7032     ,input v-new-icnt-doc-status
     7033     ,input g#news-source-db
     7034     ,input p-pck-num
     7035     ,input wt-icnt-doc.user-db-num
     7036     ,input wt-icnt-doc.user-name
     7037     ,input wt-icnt-doc.sys-date
     7038     ,input wt-icnt-doc.sys-time
     7039     ,input wt-icnt-doc.sys-time-int
     7040     ) no-error .
     7041   if error-status :error then do:
     7042     run write-to-log in this-procedure
     7043       (input substitute("&1 &2", error-status :get-message(1), return-value )
     7044       ) .
     7045     undo, return error .
     7046   end.
     7047   buffer-copy wt-icnt-doc to tb-icnt-doc.
     7048   for each locb-icnt-line
     7049   on error  undo, return error
     7050   on stop   undo, return error
     7051   on endkey undo, return error :
     7052     delete locb-icnt-line.
     7053   end.
     7054   for each locbi-doc-attr
     7055   on error  undo, return error
     7056   on stop   undo, return error
     7057   on endkey undo, return error :
     7058     delete locbi-doc-attr.
     7059   end.
     7060       delete wt-icnt-doc.
     7061     end.
     7062   END PROCEDURE.
