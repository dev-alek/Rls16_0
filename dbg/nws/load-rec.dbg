    19060       find first tb-utd
    19061         where tb-utd.db-num = wt-utd.db-num
    19062           and tb-utd.doc-id = wt-utd.doc-id
    19063         exclusive-lock no-error.
    19064   define variable vss-include-info194 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    19065   DO counter = 1 TO l-counter
    19066   on error  undo, return error
