    12616   end.
    12617   for each locb-qnty-in-qnty-group where locb-qnty-in-qnty-group.qgr-id     = wt-qnty-group.qgr-id
    12618                                       and locb-qnty-in-qnty-group.qgr-db-num = wt-qnty-group.qgr-db-num
