     7790   on error  undo, return error
     7791   :
     7792     delete buf_c-chk-doc.
     7793   end.
     7794   for each locb-c-chk-doc where locb-c-chk-doc.out-code = wt-inkas.inkas-code
     7795                         no-lock
     7796   on error  undo, return error
     7797   :
     7798     create buf_c-chk-doc.
     7799     buffer-copy locb-c-chk-doc to buf_c-chk-doc.
     7800   end.
     7801   for each buf_c-chk-gds where buf_c-chk-gds.out-code = wt-inkas.inkas-code
     7802   on error  undo, return error
     7803   :
     7804     delete buf_c-chk-gds.
     7805   end.
     7806   for each locb-c-chk-gds where locb-c-chk-gds.out-code = wt-inkas.inkas-code
     7807                         no-lock
     7808   on error  undo, return error
     7809   :
     7810     create buf_c-chk-gds.
     7811     buffer-copy locb-c-chk-gds to buf_c-chk-gds.
     7812   end.
     7813   for each buf_c-chk-pay where buf_c-chk-pay.out-code = wt-inkas.inkas-code
     7814   on error  undo, return error
     7815   :
     7816     delete buf_c-chk-pay.
     7817   end.
     7818   for each locb-c-chk-pay where locb-c-chk-pay.out-code = wt-inkas.inkas-code
     7819                         no-lock
     7820   on error  undo, return error
     7821   :
     7822     create buf_c-chk-pay.
     7823     buffer-copy locb-c-chk-pay to buf_c-chk-pay.
     7824   end.
     7825   for each buf_c-chk-discnt where buf_c-chk-discnt.out-code = wt-inkas.inkas-code
     7826   on error  undo, return error
     7827   :
     7828     delete buf_c-chk-discnt.
     7829   end.
     7830   for each locb-c-chk-discnt where locb-c-chk-discnt.out-code = wt-inkas.inkas-code
     7831                         no-lock
     7832   on error  undo, return error
     7833   :
     7834     create buf_c-chk-discnt.
     7835     buffer-copy locb-c-chk-discnt to buf_c-chk-discnt.
     7836   end.
     7837   if g#db-num = 0
     7838   and wt-inkas.status_ = 'факт':U
     7839   and v-need-saledc
     7840   then do:
     7841   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-wrt in g#trdcalib ( input wt-inkas.inkas-code ,
     7842                          input 'need-saledc':U ,
     7843                          input string(1) )  .
     7844   end.
     7845   for each locb-inkas-pay
     7846   on error  undo, return error
     7847   :
     7848     delete locb-inkas-pay.
     7849   end.
     7850   for each locb-c-inkas-pay
     7851   on error  undo, return error
     7852   :
