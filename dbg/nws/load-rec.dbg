     3231           and buf_dis-gds-rule.discnt-role = wt-dis-gds-rule.discnt-role
     3232           and buf_dis-gds-rule.pos-type = wt-dis-gds-rule.pos-type
     3233           and buf_dis-gds-rule.gds-code = wt-dis-gds-rule.gds-code no-error.
     3234     if available buf_dis-gds-rule then do:
     3235       if (wt-dis-gds-rule.nonunique = ''
     3236       and buf_dis-gds-rule.nonunique <> '') then do:
     3237         v-to-del = yes.
     3238       end.
     3239       if (wt-dis-gds-rule.nonunique <> ''
     3240       and buf_dis-gds-rule.nonunique = '') then do:
     3241         delete buf_dis-gds-rule.
     3242       end.
     3243     end.
     3244     create tb-dis-gds-rule.
     3245     assign compare-log = no.
     3246   end.
     3247   else do:
     3248     buffer-compare tb-dis-gds-rule TO wt-dis-gds-rule case-sensitive save result in compare-log no-error.
     3249   end.
     3250   if not compare-log then do:
     3251     buffer-copy wt-dis-gds-rule TO tb-dis-gds-rule.
     3252     if lookup(wt-dis-gds-rule.pos-type, 'IBM-XML,Autotank,IBM,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,r-keeper,InfoKiosk,pricecheck-Servis+,Emulator-NKT-IBM,MARIA':U) > 0 then do:
     3253         run fill-g-list in p-imp-handle ( input wt-dis-gds-rule.gds-code
     3254                                         ,input wt-dis-gds-rule.obj-type
     3255                                         ,input wt-dis-gds-rule.obj-code
     3256                                         ).
     3257     end.
     3258     if v-to-del then do:
     3259       delete tb-dis-gds-rule.
     3260     end.
     3261   end.
     3262       delete wt-dis-gds-rule.
     3263     end.
     3264   END PROCEDURE.
     3265   define temp-table locb1-dis-rule     no-undo like ub.dis-rule.
     3266   def var vss-include-info44 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3267   define temp-table temp-drt-prop no-undo like ub.drt-prop.
     3268   procedure disrules-fill-properties:
     3269   define input  parameter p-templ-rl-root as integer   no-undo .
     3270   define buffer buf_drt-prop for ub.drt-prop.
     3271   define buffer buf_temp-drt-prop for temp-drt-prop.
     3272   do
     3273   on error undo, return error return-value
     3274   :
     3275     for each buf_temp-drt-prop:
     3276       delete buf_temp-drt-prop.
