    15295   define temp-table wt-tax-rate-value no-undo like ub.tax-rate-value.
    15296   PROCEDURE proc-load-tax-rate-value:
    15297     define input parameter p-imp-handle as handle  no-undo.
    15298     define input parameter p-pck-num    as integer no-undo.
    15299     define input parameter l-counter    as integer no-undo.
    15300     do
    15301     on error  undo, return error substitute( "$proc-load-tax-rate-value. &1&2&3", return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    15302     on stop   undo, return error substitute( "$proc-load-tax-rate-value. stop" )
    15303     on endkey undo, return error substitute( "$proc-load-tax-rate-value. endkey" )
    15304     :
    15305       define buffer tb-tax-rate-value for ub.tax-rate-value.
    15306       define variable compare-log as logical no-undo.
    15307   define variable vss-include-info173 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    15308   define buffer buf_tax for ub.tax.
    15309       for each wt-tax-rate-value
    15310       on error undo, return error substitute( "$proc-load-tax-rate-value(del-wt-). &1&2&3", return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    15311       :
    15312         delete wt-tax-rate-value .
    15313       end.
    15314       create wt-tax-rate-value.
    15315       run nws-impl in p-imp-handle
    15316         ( input 'tax-rate-value':U
    15317          ,input (buffer wt-tax-rate-value:handle)
    15318         ) no-error.
    15319       if error-status :error then do:
    15320         return error return-value .
    15321       end.
    15322       find first tb-tax-rate-value
    15323         where tb-tax-rate-value.tax-code = wt-tax-rate-value.tax-code
    15324           and tb-tax-rate-value.rate-code = wt-tax-rate-value.rate-code
    15325           and tb-tax-rate-value.host-code = wt-tax-rate-value.host-code
    15326           and tb-tax-rate-value.obj-type = wt-tax-rate-value.obj-type
    15327           and tb-tax-rate-value.obj-code = wt-tax-rate-value.obj-code
    15328           and tb-tax-rate-value.fact-order = wt-tax-rate-value.fact-order
    15329         exclusive-lock no-error.
    15330   define variable vss-include-info174 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    15331   if not available tb-tax-rate-value then do:
    15332     create tb-tax-rate-value.
    15333     assign compare-log = no.
    15334   end.
    15335   else do:
    15336     buffer-compare tb-tax-rate-value TO wt-tax-rate-value case-sensitive save result in compare-log no-error.
    15337   end.
    15338   if not compare-log then do:
    15339     buffer-copy wt-tax-rate-value TO tb-tax-rate-value.
    15340     find buf_tax where buf_tax.tax-code = tb-tax-rate-value.tax-code no-lock no-error.
    15341     if available buf_tax and
    15342        buf_tax.to-cashdesk = yes AND
    15343        tb-tax-rate-value.fact-date <= today
    15344       then do:
    15345       run fill-cash-txr in p-imp-handle (
    15346                                            input buf_tax.tax-code
    15347                                           ,input tb-tax-rate-value.rate-code
    15348                                           ,input ?
    15349                                           ,input tb-tax-rate-value.host-code
    15350                                           ,input tb-tax-rate-value.obj-type
    15351                                           ,input tb-tax-rate-value.obj-code
    15352                                           ,input buf_tax.tax-type
    15353                                           ,input tb-tax-rate-value.rate-value
    15354                                           ,input integer( tb-tax-rate-value.fact-date)
    15355                                           ,input recid(tb-tax-rate-value)
    15356                                           ).
    15357     end.
    15358   end.
    15359       delete wt-tax-rate-value.
    15360     end.
    15361   END PROCEDURE.
    15362   define temp-table wt-thbj-attr no-undo like ub.thbj-attr.
    15363   PROCEDURE proc-load-thbj-attr:
    15364     define input parameter p-imp-handle as handle  no-undo.
    15365     define input parameter p-pck-num    as integer no-undo.
    15366     define input parameter l-counter    as integer no-undo.
