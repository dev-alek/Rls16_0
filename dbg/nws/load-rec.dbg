        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: b39224d84de3, 3188, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: EShklyar $":U .
        4   define variable vss-date        as character no-undo init "$Date: 2022/12/27 12:54:26 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: gen-imp.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: utl/gen-imp.p $":U .
        7   define variable vss-description as character no-undo init "загрузка в БД строки".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define new global shared variable g#library  as handle no-undo .
       67   define new global shared variable g#library2 as handle no-undo .
       68   define   shared variable g#auto as logical no-undo.
       69   define   shared variable g#news as logical no-undo.
       70   define   shared variable g#oxml as logical no-undo.
       71   define   shared variable g#esys as logical no-undo.
       72   define   shared variable g#news-source-db as integer no-undo.
       73   define   shared variable g#esys-source-esys as integer no-undo.
       74   define   shared variable g#db-num as integer   no-undo .
       75   define   shared variable g#userid as character no-undo .
       76   define   shared variable g#passwd as character no-undo .
       77   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       78   define  shared variable g#auto-pid           as integer   no-undo .
       79   define  shared variable conn-par             as character no-undo .
       80   define  shared variable g#auto-user-id       as character no-undo .
       81   define  shared variable g#auto-user-login    as character no-undo .
       82   define  shared variable g#auto-user-password as character no-undo .
       83   define  shared variable v-socket             as logical   no-undo .
       84   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       85   define  shared variable auto-window-h     as handle    no-undo .
       86   define  shared variable auto-log-msg-h    as handle    no-undo .
       87   define  shared variable hand-log-msg-h    as handle    no-undo .
       88   define  shared variable log-file-name     as character no-undo initial ? .
       89   define  shared variable add-log-file-name as character no-undo initial ? .
       90   define  shared variable writelogvalue     as character no-undo initial ? .
       91   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       92   procedure cur-time :
       93      define output parameter p-today as date      no-undo .
       94      define output parameter p-time  as integer   no-undo .
       95     do
       96     on error undo, return error
       97     :
       98       define variable v-date1 as date      no-undo .
       99       define variable v-date2 as date      no-undo .
      100       define variable v-time  as integer   no-undo .
      101       assign
      102         v-date1 = today
      103         v-time  = time
      104         v-date2 = today
      105       .
      106       if v-date1 <> v-date2
      107       then do:
      108         assign
      109           v-date1 = today
      110           v-time  = v-time
      111         .
      112       end.
      113       assign
      114         p-today = v-date1
      115         p-time  = v-time
      116       .
      117     end.
      118   end.
      119   function cur-time-date returns character
      120   :
      121     return string(today, '99/99/9999':U) .
      122   end.
      123   function cur-time-mjd returns decimal
      124   :
      125     define variable v-date as date      no-undo .
      126     define variable v-time as integer   no-undo .
      127     run cur-time in this-procedure
      128       (output v-date
      129       ,output v-time
      130       ) .
      131     return integer(v-date) - 2400002 + (v-time / 86400) .
      132   end.
      133   function cur-time-get-ending-index returns integer
      134   (input p-number as integer
      135   )
      136   :
      137     if p-number < 0
      138     or p-number = ?
      139     then do:
      140       return 1 .
      141     end.
      142     define variable v-rest as integer   no-undo .
      143     assign
      144       p-number = p-number modulo 100
      145     .
      146     if p-number < 20
      147     then do:
      148       assign
      149         v-rest = p-number
      150       .
      151     end.
      152     else do:
      153       assign
      154         v-rest = p-number modulo 10
      155       .
      156     end.
      157     case v-rest :
      158       when 1
      159       then do:
      160         return 2 .
      161       end.
      162       when 2 or
      163       when 3 or
      164       when 4
      165       then do:
      166         return 3 .
      167       end.
      168       otherwise do:
      169         return 1 .
      170       end.
      171     end case .
      172   end.
      173   procedure cur-time-mjd-to-date :
      174      define input  parameter i-mjd-diff as decimal no-undo.
      175      define output parameter o-Date     as date    no-undo.
      176      define output parameter o-Time     as integer no-undo.
      177      define variable v-day-number as integer   no-undo .
      178      if    i-mjd-diff < 0
      179         or i-mjd-diff = ?
      180      then do:
      181         return "?" .
      182      end.
      183      assign
      184         v-day-number = truncate(i-mjd-diff,0).
      185         o-Date = date(v-day-number + 2400002).
      186         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      187     .
      188   end.
      189   function cur-time-mjd-to-string returns character
      190   (input p-mjd-diff as decimal
      191   )
      192   :
      193     define variable v-day-number as integer   no-undo .
      194     define variable v-seconds    as integer   no-undo .
      195     define variable v-hour       as integer   no-undo .
      196     define variable v-min        as integer   no-undo .
      197     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      198     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      199     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      200     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      201     if p-mjd-diff < 0
      202     or p-mjd-diff = ?
      203     then do:
      204       return "?" .
      205     end.
      206     assign
      207       v-day-number = integer(truncate(p-mjd-diff,0))
      208       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      209     .
      210     if v-seconds > 86400
      211     then do:
      212       assign
      213         v-seconds = 86400 - 1
      214       .
      215     end.
      216     if v-seconds < 0
      217     then do:
      218       assign
      219         v-seconds = 0
      220       .
      221     end.
      222     assign
      223       v-hour = truncate(v-seconds / 3600, 0)
      224     .
      225     assign
      226       v-seconds = v-seconds modulo 3600
      227     .
      228     assign
      229       v-min = truncate(v-seconds / 60, 0)
      230     .
      231     assign
      232       v-seconds = v-seconds modulo 60
      233     .
      234     return
      235         (if v-day-number <> 0
      236           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      237           else ""
      238         )
      239       + (if v-day-number <> 0 or v-hour <> 0
      240           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      241           else ""
      242         )
      243       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      244           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      245           else ""
      246         )
      247       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      248       .
      249   end.
      250   function cur-time-string returns character
      251   :
      252     define variable v-date as date      no-undo .
      253     define variable v-time as integer   no-undo .
      254     run cur-time in this-procedure
      255       (output v-date
      256       ,output v-time
      257       ) .
      258     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      259   end.
      260   function cur-time-string-sec returns character
      261   :
      262     define variable v-date as date      no-undo .
      263     define variable v-time as integer   no-undo .
      264     run cur-time in this-procedure
      265       (output v-date
      266       ,output v-time
      267       ) .
      268     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      269   end.
      270   function cur-time-custom  returns character
      271   (input p-prefix as character
      272   ,input p-date-format as character
      273   ,input p-delimiter as character
      274   ,input p-time-format as character
      275   ,input p-suffix as character
      276   )
      277   :
      278     define variable v-date as date      no-undo .
      279     define variable v-time as integer   no-undo .
      280     run cur-time in this-procedure
      281       (output v-date
      282       ,output v-time
      283       ) .
      284     return
      285       p-prefix
      286       + string(v-date, p-date-format)
      287       + p-delimiter
      288       + string(v-time, p-time-format)
      289       + p-suffix
      290       .
      291   end.
      292   function cur-time-print  returns character
      293   :
      294     define variable v-date as date      no-undo .
      295     define variable v-time as integer   no-undo .
      296     run cur-time in this-procedure
      297       (output v-date
      298       ,output v-time
      299       ) .
      300     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      301   end.
      302   function cur-time-datetime returns datetime
      303   :
      304     define variable v-char as character no-undo .
      305     define variable v-datetime as datetime no-undo .
      306     v-char = cur-time-string().
      307     v-datetime = datetime(v-char).
      308     return  v-datetime.
      309   end.
      310   function cur-time-string-msec returns character
      311   :
      312     define variable v-date as datetime  no-undo .
      313     v-date = now.
      314     return string(v-date) .
      315   end.
      316   define stream LogStream .
      317   define variable mNoTime as logical no-undo.
      318   procedure write-to-log-notime :
      319     define input param i-str as character no-undo .
      320     mNoTime = yes.
      321     run write-to-log (i-str).
      322     mNoTime = no.
      323   end.
      324   procedure write-to-log :
      325     define input param p-str as character no-undo .
      326     do
      327     on error  undo, return error substitute( "&1 (write-to-log). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      328     on stop   undo, return error substitute( "&1 (write-to-log). stop", vss-workfile )
      329     on endkey undo, return error substitute( "&1 (write-to-log). endkey", vss-workfile )
      330     :
      331       define variable log-res        as logical   no-undo .
      332       define variable v-jj           as integer   no-undo .
      333       if    mNoTime
      334          or writelogvalue eq "AsyncProc"
      335       then
      336          p-str = substitute( "&1 (pid: &2) &3&4"   , g#auto-user-id, g#auto-pid,                        p-str, chr(10) ).
      337       else
      338          p-str = substitute( "&1 (pid: &2) &3 &4&5", g#auto-user-id, g#auto-pid, cur-time-string-sec(), p-str, chr(10) ).
      339       if auto-log-msg-h <> ? then do:
      340         log-res = auto-log-msg-h:move-to-eof( ) .
      341         log-res = auto-log-msg-h:insert-string( p-str ).
      342       end.
      343       if hand-log-msg-h <> ? then do:
      344         log-res = hand-log-msg-h:move-to-eof( ) .
      345         log-res = hand-log-msg-h:insert-string( p-str ).
      346       end.
      347       assign
      348         p-str = replace(p-str, (chr(10) + chr(13)), chr(10) )
      349         p-str = replace(p-str, (chr(13) + chr(10)), chr(10) )
      350         p-str = replace(p-str, chr(10), (chr(13) + chr(10)) )
      351       .
      352       if add-log-file-name <> ? then do:
      353         do v-jj = 1 to num-entries(add-log-file-name, chr(1)):
      354           run gbl/fileapnd.p
      355             ( input entry(v-jj, add-log-file-name, chr(1) )
      356             ,input p-str
      357             ,input 20
      358             ) no-error .
      359           if error-status:error then do:
      360             return error return-value .
      361           end.
      362         end.
      363       end.
      364       if writelogvalue eq "AsyncProc"
      365       then do:
      366          p-str = trim(p-str, (chr(13) + chr(10)) )
      367       .
      368          Publish "WriteLogAsunc" (p-str,yes).
      369       end.
      370       else if writelogvalue <> "yes" then do:
      371         run gbl/fileapnd.p
      372           ( input log-file-name
      373           ,input p-str
      374           ,input 20
      375           ) no-error .
      376         if error-status:error then do:
      377           return error return-value .
      378         end.
      379       end.
      380     end.
      381   end procedure.
      382   procedure write-to-screen :
      383     define input param p-str as character no-undo .
      384     do
      385     on error  undo, return error substitute( "&1 (write-to-screen). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      386     on stop   undo, return error substitute( "&1 (write-to-screen). stop", vss-workfile )
      387     on endkey undo, return error substitute( "&1 (write-to-screen). endkey", vss-workfile )
      388     :
      389       define variable log-res as logical no-undo.
      390       assign
      391         p-str = substitute( "&1 (pid: &2) &3 &4&5", g#auto-user-id, g#auto-pid, cur-time-string-sec(), p-str, chr(10) )
      392       .
      393       if auto-log-msg-h <> ?
      394       then do:
      395         log-res = auto-log-msg-h:move-to-eof( ) .
      396         log-res = auto-log-msg-h:insert-string( p-str ).
      397       end.
      398       if hand-log-msg-h <> ?
      399       then do:
      400         log-res = hand-log-msg-h:move-to-eof( ) .
      401         log-res = hand-log-msg-h:insert-string( p-str ).
      402       end.
      403     end.
      404   end procedure.
      405   procedure send-msg-to-email :
      406     define input  parameter p-subject      as character no-undo .
      407     define input  parameter p-text-err     as character no-undo .
      408     define input  parameter p-attach-files as character no-undo .
      409     do
      410     on error  undo, return error substitute( "&1 (send-msg-to-email). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      411     on stop   undo, return error substitute( "&1 (send-msg-to-email). stop", vss-workfile )
      412     on endkey undo, return error substitute( "&1 (send-msg-to-email). endkey", vss-workfile )
      413     :
      414       define variable v-tth             as handle    no-undo .
      415       define variable v-value-character as character no-undo .
      416       define variable v-value-date      as date      no-undo .
      417       define variable v-value-decimal   as decimal   no-undo .
      418       define variable v-value-integer   as integer   no-undo .
      419       define variable v-value-logical   as logical   no-undo .
      420       define variable v-param-type      as character no-undo .
      421       define variable v-email       as character no-undo .
      422       define variable v-tmp-str     as character no-undo .
      423       define variable v-tmp1-str    as character no-undo .
      424       define variable v-ind         as integer   no-undo .
      425       define variable v-num-entries as integer   no-undo .
      426       delete object v-tth no-error.
      427       run adm/shattri.p
      428         ( input "get":U
      429          ,input  "":U
      430          ,input  0
      431          ,input  'auto-task':U
      432          ,input  'send-msg-to-email':U
      433          ,output v-value-character
      434          ,output v-value-date
      435          ,output v-value-decimal
      436          ,output v-value-integer
      437          ,output v-value-logical
      438          ,output v-param-type
      439          ,input-output table-handle v-tth
      440         ) no-error .
      441       if not error-status :error  then do:
      442         assign
      443           v-tmp-str = v-value-character
      444         .
      445       end.
      446       delete object v-tth no-error.
      447       assign
      448         v-tmp-str     = replace(v-tmp-str, (chr(10) + chr(13)), chr(44) )
      449         v-tmp-str     = replace(v-tmp-str, (chr(13) + chr(10)), chr(44) )
      450         v-tmp-str     = replace(v-tmp-str, chr(10), chr(44) )
      451         v-num-entries = num-entries( v-tmp-str, chr(44) )
      452         v-email       = "":U
      453       .
      454       do v-ind = 1 to v-num-entries
      455       :
      456         assign
      457           v-tmp1-str = entry( v-ind, v-tmp-str, chr(44) )
      458         .
      459         if trim( v-tmp1-str ) <> "":U then do:
      460           if v-email = "":U then do:
      461             assign
      462               v-email = v-tmp1-str
      463             .
      464           end.
      465           else do:
      466             assign
      467               v-email = v-email + chr(44) + v-tmp1-str
      468             .
      469           end.
      470         end.
      471       end.
      472       if v-email <> "":U then do:
      473         run gbl/sendmail.p
      474           ( input v-email
      475           , input p-subject
      476           , input p-text-err
      477           , input p-attach-files
      478           ) no-error .
      479         if error-status :error
      480           or return-value <> "":U
      481         then do:
      482           return error substitute( "&1 (send-msg-to-email). &2", vss-workfile, return-value ) .
      483         end.
      484       end.
      485     end.
      486   end procedure.
      487   define  shared variable nws-exch-dir as character no-undo .
      488   define  shared variable nws-heap-dir as character no-undo .
      489   define variable err-mess as character no-undo .
      490   define temp-table t-pck-conf no-undo
      491     field db-num-dst      as integer
      492     field db-num-src      as integer
      493     field pack-num        as integer
      494     field total-recs      as integer
      495     field sys-key         as character
      496     field src_db-key      as character
      497     field dst_db-key      as character
      498     field ver-num         as character
      499     field prev-crc        as character
      500     field actual-date     as date
      501     field actual-time-int as integer
      502   .
      503   def var vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      504   procedure gen-key-rec :
      505     define input  parameter p-tbl-name    as character no-undo.
      506     define input  parameter p-bh_tbl-name as handle    no-undo.
      507     define output parameter p-key-rec     as character no-undo.
      508     do
      509     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      510     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      511     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      512     :
      513       define variable fh               as handle    no-undo .
      514       define variable v-ok             as logical   no-undo .
      515       define variable v-inform         as character no-undo .
      516       define variable v-ind            as integer   no-undo .
      517       define variable v-idx-field-qnty as integer   no-undo .
      518       if p-tbl-name = ?
      519         or p-tbl-name = "":U
      520       then do:
      521         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info3 ).
      522       end.
      523       if not p-bh_tbl-name:available then do:
      524         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info3, p-tbl-name ).
      525       end.
      526       assign
      527         p-key-rec = p-tbl-name
      528         v-inform  = p-bh_tbl-name:index-information(1)
      529         v-ind     = 2
      530       .
      531       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      532       on error undo, return error
      533       :
      534         assign
      535           v-inform = p-bh_tbl-name:index-information( v-ind )
      536           v-ind    = v-ind + 1
      537         .
      538       end.
      539       if v-inform = ?
      540         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      541         or entry( 3, v-inform, ",":U ) <> "1":U
      542       then do:
      543         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info3, p-tbl-name ).
      544       end.
      545       else do:
      546         assign
      547           v-idx-field-qnty = num-entries( v-inform ) - 4
      548         .
      549         if v-idx-field-qnty < 2 then do:
      550           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, p-tbl-name ).
      551         end.
      552         do v-ind = 1 to v-idx-field-qnty by 2
      553         on error undo, return error
      554         :
      555           assign
      556             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      557             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      558           .
      559         end.
      560       end.
      561       if p-key-rec = ? then do:
      562         assign
      563           p-key-rec = "":U
      564         .
      565         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info3, p-tbl-name ).
      566       end.
      567     end.
      568     return.
      569   end procedure.
      570   procedure gen-where-keyr-tab :
      571     define input  parameter i-tableSerach as character no-undo.
      572     define input  parameter i-tablekey   as character  no-undo.
      573     define input  parameter p-key-rec    as character  no-undo.
      574     define input  parameter p-key-handle as handle     no-undo .
      575     define input  parameter p-db-name    as character  no-undo .
      576     define input  parameter p-tt-handle  as handle     no-undo .
      577     define output parameter o-Where      as character  no-undo.
      578     do
      579     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      580     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      581     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      582     :
      583       define variable v-full-tbl-name  as character no-undo .
      584       define variable bh_tbl-name      as handle    no-undo .
      585       define variable fh_key           as handle    no-undo .
      586       define variable fh_search        as handle    no-undo .
      587       define variable v-field-num      as integer   no-undo .
      588       define variable v-count-fld      as integer   no-undo .
      589       define variable v-inform         as character no-undo .
      590       define variable v-ind            as integer   no-undo .
      591       define variable v-idx-field-qnty as integer   no-undo .
      592       define variable v-field-name     as character no-undo .
      593       define variable v-field-val      as character no-undo .
      594       define variable v-word-link      as character no-undo .
      595       define variable vTable           as character no-undo.
      596       define variable bh_tbl-key       as handle    no-undo .
      597       assign
      598         p-key-rec = trim( p-key-rec )
      599       .
      600       if p-key-handle <> ? then do:
      601         if not valid-handle(p-key-handle)
      602            or p-key-handle:type <> "buffer"
      603         then do:
      604           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info3 ).
      605         end.
      606         if num-entries( p-key-rec, chr(3) ) > 1
      607           or p-key-rec = ?
      608           or p-key-rec = "":U
      609         then do:
      610           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info3, p-key-rec ).
      611         end.
      612       end.
      613       else do:
      614         if p-key-rec = ?
      615           or p-key-rec = "":U
      616         then do:
      617           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info3 ).
      618         end.
      619       end.
      620       assign
      621         vTable = entry( 1 , p-key-rec, chr(3) )
      622       .
      623       if p-tt-handle <> ?
      624         and ( not valid-handle(p-tt-handle)
      625               or p-tt-handle:type <> "buffer"
      626             )
      627       then do:
      628         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info3, vTable, chr(10) ).
      629       end.
      630       if p-tt-handle = ? then do:
      631         assign
      632           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      633         .
      634         create buffer bh_tbl-name for table v-full-tbl-name .
      635       end.
      636       else do:
      637         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      638       end.
      639       assign
      640         v-inform = bh_tbl-name:index-information(1)
      641         v-ind    = 2
      642       .
      643       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      644       on error undo, return error
      645       :
      646         assign
      647           v-inform = bh_tbl-name:index-information( v-ind )
      648           v-ind    = v-ind + 1
      649         .
      650       end.
      651       if v-inform = ?
      652         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      653         or entry( 3, v-inform, ",":U ) <> "1":U
      654       then do:
      655         delete object bh_tbl-name no-error.
      656         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info3, vTable ).
      657       end.
      658       assign
      659         v-idx-field-qnty = num-entries( v-inform ) - 4
      660       .
      661       if v-idx-field-qnty < 2 then do:
      662         delete object bh_tbl-name no-error.
      663         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, vTable ).
      664       end.
      665       assign
      666         o-where     = "where":U
      667         v-word-link = "":U
      668         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      669         v-count-fld = 0
      670       .
      671       if i-tablekey ne "" and i-tablekey ne ?
      672       then do:
      673         assign
      674           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      675         .
      676         create buffer bh_tbl-key for table v-full-tbl-name .
      677       end.
      678       if i-tableSerach ne "" and i-tableSerach ne ?
      679       then do:
      680         delete object bh_tbl-name no-error.
      681         assign
      682           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      683         .
      684         create buffer bh_tbl-name for table v-full-tbl-name .
      685       end.
      686       block_where:
      687       do v-ind = 1 to v-idx-field-qnty by 2
      688       on error undo, return error
      689       :
      690         assign
      691           v-count-fld = v-count-fld + 1
      692         .
      693         if p-key-handle = ?
      694           and v-count-fld > v-field-num
      695         then do:
      696           leave block_where.
      697         end.
      698         define variable VfieldKeyTable as handle no-undo.
      699         assign
      700           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      701           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      702         .
      703         if     bh_tbl-key ne ?
      704         then do:
      705            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      706            if VfieldKeyTable eq ?
      707            then next block_where.
      708         end.
      709         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      710         then
      711            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      712         else
      713            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      714         if p-key-handle = ? then do:
      715           assign
      716             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      717           .
      718         end.
      719         else do:
      720           assign
      721             fh_key = p-key-handle:buffer-field( v-field-name )
      722           .
      723           if fh_key = ?
      724             or not valid-handle( fh_key )
      725           then do:
      726             delete object bh_tbl-name.
      727             if     bh_tbl-key ne ?
      728             then
      729                delete object bh_tbl-key.
      730             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info3, p-key-handle:name, v-field-name ).
      731           end.
      732           assign
      733             v-field-val = fh_key:buffer-value
      734           .
      735         end.
      736         if fh_search:data-type ="character":U then do:
      737           assign
      738             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      739             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      740             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      741             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      742             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      743             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      744             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      745             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      746             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      747             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      748             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      749             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      750             v-field-val = substitute( '"&1"', v-field-val )
      751           .
      752         end.
      753         assign
      754           o-where = substitute( "&1 &2", o-where, v-field-val )
      755         .
      756         if v-word-link = "":U then do:
      757           assign
      758             v-word-link = "and":U
      759           .
      760         end.
      761       end.
      762       delete object bh_tbl-name.
      763       if     bh_tbl-key ne ?
      764       then
      765          delete object bh_tbl-key.
      766       if p-key-handle = ?
      767         and v-count-fld <> v-field-num
      768       then do:
      769         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info3, vTable ).
      770       end.
      771     end.
      772   end procedure.
      773   procedure gen-hn-keyr-tab :
      774     define input  parameter i-tableSerach as character no-undo.
      775     define input  parameter i-tablekey   as character no-undo.
      776     define input  parameter p-key-rec    as character no-undo.
      777     define input  parameter p-key-handle as handle    no-undo .
      778     define input  parameter p-db-name    as character no-undo .
      779     define input  parameter p-tt-handle  as handle    no-undo .
      780     define input  parameter p-stts-lock  as integer   no-undo .
      781     define output parameter o-hn         as handle    no-undo.
      782     define variable v-full-tbl-name as character no-undo.
      783     define variable v-where         as character no-undo.
      784     define variable bh_tbl-name     as handle    no-undo.
      785     define variable vTable          as character no-undo.
      786     do
      787     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      788     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      789     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      790         run gen-where-keyr-tab(i-tableSerach,
      791                                i-tablekey,
      792                                p-key-rec,
      793                                p-key-handle,
      794                                p-db-name,
      795                                p-tt-handle,
      796                                output v-where).
      797         if i-tableSerach ne "" and i-tableSerach ne ?
      798         then do:
      799            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      800            create buffer bh_tbl-name for table v-full-tbl-name .
      801         end.
      802         else do:
      803            if p-tt-handle = ? then do:
      804               assign
      805                  vTable = entry( 1 , p-key-rec, chr(3) )
      806               .
      807               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      808               create buffer bh_tbl-name for table v-full-tbl-name .
      809            end.
      810            else do:
      811               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      812            end.
      813         end.
      814         if p-tt-handle = ? then do:
      815            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      816         end.
      817         else do:
      818            bh_tbl-name:find-first( v-where ) no-error .
      819         end.
      820         o-hn = bh_tbl-name.
      821      end.
      822   end procedure.
      823   procedure gen-hn-keyr :
      824     define input  parameter p-key-rec    as character no-undo.
      825     define input  parameter p-key-handle as handle    no-undo .
      826     define input  parameter p-db-name    as character no-undo .
      827     define input  parameter p-tt-handle  as handle    no-undo .
      828     define input  parameter p-stts-lock  as integer   no-undo .
      829     define output parameter o-hn         as handle    no-undo.
      830     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      831   end.
      832   procedure gen-row-keyr :
      833     define input  parameter p-key-rec    as character no-undo.
      834     define input  parameter p-key-handle as handle    no-undo .
      835     define input  parameter p-db-name    as character no-undo .
      836     define input  parameter p-tt-handle  as handle    no-undo .
      837     define input  parameter p-stts-lock  as integer   no-undo .
      838     define output parameter p-tbl-row    as rowid     no-undo.
      839     define output parameter p-tbl-name   as character no-undo.
      840     define variable vHn as handle no-undo.
      841       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      842       p-tbl-row = if vHn:available then vHn:rowid else ?.
      843       p-tbl-name =  vHn:table.
      844       delete object vHn no-error.
      845     if p-tbl-row = ? then do:
      846       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info3, p-tbl-name, p-key-rec ).
      847     end.
      848     else do:
      849       return.
      850     end.
      851   end procedure.
      852   procedure gen-key-fv :
      853     define input  parameter p-key-rec    as character no-undo .
      854     define output parameter p-field-list as character no-undo .
      855     define output parameter p-value-list as character no-undo.
      856     do
      857     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      858     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      859     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      860     :
      861       define variable v-full-tbl-name  as character no-undo .
      862       define variable bh_tbl-name      as handle    no-undo .
      863       define variable v-tbl-name       as character no-undo .
      864       define variable v-field-num      as integer   no-undo .
      865       define variable v-count-fld      as integer   no-undo .
      866       define variable v-inform         as character no-undo .
      867       define variable v-ind            as integer   no-undo .
      868       define variable v-idx-field-qnty as integer   no-undo .
      869       define variable v-delim-key      as character no-undo .
      870       if p-key-rec = ?
      871         or p-key-rec = "":U
      872       then do:
      873         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info3 ).
      874       end.
      875       assign
      876         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      877         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      878       .
      879       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      880       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info3 ).
      881       assign
      882         v-inform = bh_tbl-name:index-information(1)
      883         v-ind    = 2
      884       .
      885       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      886       on error undo, return error
      887       :
      888         assign
      889           v-inform = bh_tbl-name:index-information( v-ind )
      890           v-ind    = v-ind + 1
      891         .
      892       end.
      893       if v-inform = ?
      894         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      895         or entry( 3, v-inform, ",":U ) <> "1":U
      896       then do:
      897         delete object bh_tbl-name no-error.
      898         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info3, v-tbl-name ).
      899       end.
      900       assign
      901         v-idx-field-qnty = num-entries( v-inform ) - 4
      902       .
      903       if v-idx-field-qnty < 2 then do:
      904         delete object bh_tbl-name no-error.
      905         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, v-tbl-name ).
      906       end.
      907       assign
      908         p-field-list = "":U
      909         p-value-list = "":U
      910         v-delim-key  = "":U
      911         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      912         v-count-fld  = 0
      913       .
      914       block_where:
      915       do v-ind = 1 to v-idx-field-qnty by 2
      916       on error undo, return error
      917       :
      918         assign
      919           v-count-fld = v-count-fld + 1
      920         .
      921         if v-count-fld > v-field-num then do:
      922           leave block_where.
      923         end.
      924         assign
      925           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      926           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      927         .
      928         if v-ind = 1 then do:
      929           assign
      930             v-delim-key = chr(3)
      931           .
      932         end.
      933       end.
      934       delete object bh_tbl-name.
      935       if v-count-fld <> v-field-num then do:
      936         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info3, v-tbl-name ).
      937       end.
      938     end.
      939   end procedure.
      940   procedure gen-key-field :
      941     define input  parameter p-table      as character no-undo .
      942     define output parameter p-field-list as character no-undo .
      943     do
      944     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      945     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      946     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      947     :
      948       define variable v-full-tbl-name  as character no-undo .
      949       define variable bh_tbl-name      as handle    no-undo .
      950       define variable v-tbl-name       as character no-undo .
      951       define variable v-field-num      as integer   no-undo .
      952       define variable v-count-fld      as integer   no-undo .
      953       define variable v-inform         as character no-undo .
      954       define variable v-ind            as integer   no-undo .
      955       define variable v-idx-field-qnty as integer   no-undo .
      956       define variable v-delim-key      as character no-undo .
      957       if p-table = ?
      958         or p-table = "":U
      959       then do:
      960         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info3 ).
      961       end.
      962       assign
      963         v-tbl-name      = p-table
      964         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      965       .
      966       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      967       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info3 ).
      968       assign
      969         v-inform = bh_tbl-name:index-information(1)
      970         v-ind    = 2
      971       .
      972       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      973       on error undo, return error
      974       :
      975         assign
      976           v-inform = bh_tbl-name:index-information( v-ind )
      977           v-ind    = v-ind + 1
      978         .
      979       end.
      980       if v-inform = ?
      981         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      982         or entry( 3, v-inform, ",":U ) <> "1":U
      983       then do:
      984         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info3, v-tbl-name ).
      985       end.
      986       assign
      987         v-idx-field-qnty = num-entries( v-inform ) - 4
      988       .
      989       if v-idx-field-qnty < 2 then do:
      990         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, v-tbl-name ).
      991       end.
      992       assign
      993         p-field-list = "":U
      994         v-delim-key  = "":U
      995         v-count-fld  = 0
      996       .
      997       block_where:
      998       do v-ind = 1 to v-idx-field-qnty by 2
      999       on error undo, return error
     1000       :
     1001         assign
     1002           v-count-fld = v-count-fld + 1
     1003         .
     1004         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     1005         if v-ind = 1 then do:
     1006           assign
     1007             v-delim-key = chr(3)
     1008           .
     1009         end.
     1010       end.
     1011       delete object bh_tbl-name.
     1012     end.
     1013   end procedure.
     1014   define new global shared variable g#attr-lib  as handle no-undo .
