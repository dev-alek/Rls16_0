    10789     buffer-copy rcvlocb-ord-line to buf_ord-line.
    10790   end.
    10791   for each buf_ord-line-attr where buf_ord-line-attr.doc-code = wt-ord-doc-rcv.doc-code ,
    10792       first buf_ord-doc no-lock where buf_ord-doc.doc-code = wt-ord-doc-rcv.doc-code
    10793                                   and buf_ord-doc.doc-type <> 'ОР':U
    10794   on error  undo, return error
    10795   on stop   undo, return error
    10796   on endkey undo, return error :
    10797     delete buf_ord-line-attr.
    10798   end.
    10799   for each rcvlocb-ord-line-attr where rcvlocb-ord-line-attr.doc-code = wt-ord-doc-rcv.doc-code no-lock ,
    10800       first buf_ord-doc no-lock where buf_ord-doc.doc-code = wt-ord-doc-rcv.doc-code
    10801                                   and buf_ord-doc.doc-type <> 'ОР':U
    10802   on error  undo, return error
    10803   on stop   undo, return error
    10804   on endkey undo, return error :
    10805     create buf_ord-line-attr.
    10806     buffer-copy rcvlocb-ord-line-attr to buf_ord-line-attr.
    10807   end.
    10808   for each buf_ord-dtl where buf_ord-dtl.doc-code = wt-ord-doc-rcv.doc-code ,
    10809       first buf_ord-doc no-lock where buf_ord-doc.doc-code = wt-ord-doc-rcv.doc-code
    10810                                   and buf_ord-doc.doc-type <> 'ОР':U
    10811   on error  undo, return error
    10812   on stop   undo, return error
    10813   on endkey undo, return error :
    10814     delete buf_ord-dtl.
    10815   end.
    10816   for each rcvlocb-ord-dtl where rcvlocb-ord-dtl.doc-code = wt-ord-doc-rcv.doc-code
    10817                         no-lock ,
    10818       first buf_ord-doc no-lock where buf_ord-doc.doc-code = wt-ord-doc-rcv.doc-code
    10819                                   and buf_ord-doc.doc-type <> 'ОР':U
    10820   on error  undo, return error
    10821   on stop   undo, return error
    10822   on endkey undo, return error :
    10823     create buf_ord-dtl.
    10824     buffer-copy rcvlocb-ord-dtl to buf_ord-dtl.
    10825   end.
    10826   if not available tb-ord-doc-rcv then do:
    10827      create tb-ord-doc-rcv no-error.
    10828   end.
    10829   define variable v-old-ord-doc-rcv-status as character no-undo .
    10830   define variable v-new-ord-doc-rcv-status as character no-undo .
    10831   if tb-ord-doc-rcv.status_ = ""
    10832   or tb-ord-doc-rcv.status_ = ?
    10833   then do:
    10834     assign
    10835       v-old-ord-doc-rcv-status = ""
    10836     .
    10837   end.
    10838   else do:
    10839     assign
    10840       v-old-ord-doc-rcv-status = tb-ord-doc-rcv.status_ + string(tb-ord-doc-rcv.flag_, '+/-':u)
    10841     .
    10842   end.
    10843   assign
    10844     v-new-ord-doc-rcv-status = wt-ord-doc-rcv.status_ + string(wt-ord-doc-rcv.flag_, '+/-':u)
    10845   .
    10846   run trg/nwsdochs.p
    10847     (input g#db-num
    10848     ,input 'update':U
    10849     ,input wt-ord-doc-rcv.rcv-code
    10850     ,input wt-ord-doc-rcv.obj-type
    10851     ,input wt-ord-doc-rcv.obj-code
    10852     ,input 'ord-doc-rcv':U
    10853     ,input '':u
    10854     ,input wt-ord-doc-rcv.fact-date
    10855     ,input 0
    10856     ,input 0
    10857     ,input 0
    10858     ,input 0
    10859     ,input v-old-ord-doc-rcv-status
    10860     ,input v-new-ord-doc-rcv-status
    10861     ,input g#news-source-db
    10862     ,input p-pck-num
    10863     ,input wt-ord-doc-rcv.user-db-num
    10864     ,input wt-ord-doc-rcv.user-name
    10865     ,input wt-ord-doc-rcv.sys-date
    10866     ,input wt-ord-doc-rcv.sys-time
    10867     ,input wt-ord-doc-rcv.sys-time-int
    10868     ) no-error .
    10869   if error-status :error then do:
    10870     run write-to-log in this-procedure
    10871       (input substitute("&1 &2", error-status :get-message(1), return-value )
    10872       ) .
    10873     undo, return error .
    10874   end.
    10875   buffer-copy wt-ord-doc-rcv to tb-ord-doc-rcv no-error.
    10876   for each locb-ord-line-rcv
    10877   on error  undo, return error
    10878   on stop   undo, return error
    10879   on endkey undo, return error :
