    19492      no-lock no-error.
    19493      if not available tmprecid
    19494      then
    19495         delete buf_utd-marking-lines.
    19496   end.
    19497   empty temp-table tmprecid.
    19498   for each locb-utd-marking-lines-attr
    19499   where
    19500   locb-utd-marking-lines-attr.doc-id eq wt-utd.doc-id
    19501   and locb-utd-marking-lines-attr.db-num eq wt-utd.db-num
    19502   no-lock
    19503   on error  undo, return error
    19504   :
    19505    for first buf_utd-marking-lines-attr where buf_utd-marking-lines-attr.db-num eq locb-utd-marking-lines-attr.db-num
    19506   and buf_utd-marking-lines-attr.doc-id eq locb-utd-marking-lines-attr.doc-id
    19507   and buf_utd-marking-lines-attr.LineNum eq locb-utd-marking-lines-attr.LineNum
    19508   and buf_utd-marking-lines-attr.mark eq locb-utd-marking-lines-attr.mark
    19509   and buf_utd-marking-lines-attr.attr-code eq locb-utd-marking-lines-attr.attr-code
    19510      exclusive-lock: leave. end.
    19511      if not available buf_utd-marking-lines-attr
    19512      then do:
    19513         create buf_utd-marking-lines-attr.
    19514         buffer-copy locb-utd-marking-lines-attr to buf_utd-marking-lines-attr.
    19515      end.
    19516      else
    19517        buffer-copy locb-utd-marking-lines-attr  to buf_utd-marking-lines-attr.
    19518      validate buf_utd-marking-lines-attr no-error.
    19519      if error-status:error
    19520      then
    19521         return error return-value.
    19522      create tmprecid.
    19523      assign
    19524         tmprecid.fTable = "buf_utd-marking-lines-attr"
    19525         tmprecid.Frecid = recid(buf_utd-marking-lines-attr)
    19526      .
    19527   end.
    19528   for each buf_utd-marking-lines-attr where
    19529   buf_utd-marking-lines-attr.doc-id eq wt-utd.doc-id
    19530   and buf_utd-marking-lines-attr.db-num eq wt-utd.db-num
    19531   exclusive-lock
    19532   on error  undo, return error
    19533   :
    19534      find first tmprecid where tmprecid.fTable = "buf_utd-marking-lines-attr"
    19535                            and tmprecid.Frecid = recid(buf_utd-marking-lines-attr)
    19536      no-lock no-error.
    19537      if not available tmprecid
    19538      then
    19539         delete buf_utd-marking-lines-attr.
    19540   end.
    19541   empty temp-table tmprecid.
    19542   if not available tb-utd then do:
    19543     create tb-utd.
    19544   end.
    19545   buffer-copy wt-utd to tb-utd.
    19546   validate tb-utd no-error.
    19547     if error-status:error
    19548     then
    19549        return error return-value.
    19550   unsubscribe "getNextseq".
    19551   for each locb-utd-lines
    19552   on error  undo, return error
    19553   :
    19554     delete locb-utd-lines.
    19555   end.
    19556   for each locb-utd-err
    19557   on error  undo, return error
    19558   :
    19559     delete locb-utd-err.
    19560   end.
    19561   for each locb-marking
    19562   on error  undo, return error
    19563   :
    19564     delete locb-marking.
    19565   end.
    19566   for each locb-utd-marking-lines
    19567   on error  undo, return error
    19568   :
    19569     delete locb-utd-marking-lines.
    19570   end.
    19571   release tb-utd.
    19572   for each locb-utd-lines-attr
    19573   on error  undo, return error
    19574   :
    19575     delete locb-utd-lines-attr.
    19576   end.
    19577   for each locb-utd-err-attr
    19578   on error  undo, return error
    19579   :
    19580     delete locb-utd-err-attr.
    19581   end.
    19582   for each locb-marking-attr
    19583   on error  undo, return error
    19584   :
    19585     delete locb-marking-attr.
    19586   end.
    19587   for each locb-utd-marking-lines-attr
    19588   on error  undo, return error
    19589   :
    19590     delete locb-utd-marking-lines-attr.
    19591   end.
    19592   for each locb-utd-attr
    19593   on error  undo, return error
    19594   :
    19595     delete locb-utd-attr.
    19596   end.
    19597       delete wt-utd.
    19598     end.
    19599   END PROCEDURE.
    19600   define temp-table wt-chk-slip-head no-undo like ub.chk-slip-head.
    19601   PROCEDURE proc-load-chk-slip-head:
    19602     define input parameter p-imp-handle as handle  no-undo.
    19603     define input parameter p-pck-num    as integer no-undo.
    19604     define input parameter l-counter    as integer no-undo.
    19605     do
    19606     on error  undo, return error substitute( "$proc-load-chk-slip-head. &1&2&3", return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    19607     on stop   undo, return error substitute( "$proc-load-chk-slip-head. stop" )
    19608     on endkey undo, return error substitute( "$proc-load-chk-slip-head. endkey" )
    19609     :
    19610       define buffer tb-chk-slip-head for ub.chk-slip-head.
    19611       define variable compare-log as logical no-undo.
    19612   define variable vss-include-info195 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    19613   if true
    19614   then do :
    19615     run skip-rec in p-imp-handle no-error .
    19616     return .
    19617   end .
    19618   else do :
    19619   end .
    19620       for each wt-chk-slip-head
    19621       on error undo, return error substitute( "$proc-load-chk-slip-head(del-wt-). &1&2&3", return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    19622       :
    19623         delete wt-chk-slip-head .
    19624       end.
    19625       create wt-chk-slip-head.
    19626       run nws-impl in p-imp-handle
    19627         ( input 'chk-slip-head':U
    19628          ,input (buffer wt-chk-slip-head:handle)
    19629         ) no-error.
    19630       if error-status :error then do:
    19631         return error return-value .
    19632       end.
    19633       find first tb-chk-slip-head
    19634         where tb-chk-slip-head.db-num = wt-chk-slip-head.db-num
    19635           and tb-chk-slip-head.ID = wt-chk-slip-head.ID
    19636           and tb-chk-slip-head.CheckID = wt-chk-slip-head.CheckID
    19637           and tb-chk-slip-head.RRN = wt-chk-slip-head.RRN
    19638         exclusive-lock no-error.
    19639       if l-counter <> 0 then do:
    19640         return error substitute( "&1 &2. Ошибка обработки записи &3", vss-workfile, vss-revision, 'chk-slip-head':U )
    19641                      + chr(10) + "Есть привязанные записи, а обработка идет для одной".
    19642       end.
    19643       if not available tb-chk-slip-head then do:
    19644         create tb-chk-slip-head.
    19645         assign compare-log = no.
    19646       end.
    19647       else do:
    19648         buffer-compare tb-chk-slip-head TO wt-chk-slip-head case-sensitive save result in compare-log no-error.
    19649       end.
    19650       if not compare-log then do:
    19651         buffer-copy wt-chk-slip-head TO tb-chk-slip-head.
    19652       end.
    19653       delete wt-chk-slip-head.
    19654     end.
    19655   END PROCEDURE.
    19656   define temp-table wt-chk-slip-string no-undo like ub.chk-slip-string.
