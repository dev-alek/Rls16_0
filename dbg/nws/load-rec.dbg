    15442   define temp-table tdlocb-c-chk-doc-attr     no-undo like ub.c-chk-doc-attr.
    15443   define temp-table locb-ord-chain            no-undo like ub.ord-chain.
    15444   define temp-table tdlocb-marking-chk        no-undo like ub.marking-chk.
    15445   define buffer locb-rc-arh-trn-doc-contract for locb-arh-trn-doc-contract.
    15446   define new global shared variable g#libtfarh as handle no-undo .
    15447   define variable vss-include-info176 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    15448   PROCEDURE proc-load-trn-doc-inv-chk:
    15449     define input parameter p-doc-code as character no-undo.
    15450   define buffer buf_chk-doc                  for ub.chk-doc.
    15451   define buffer buf_c-chk-doc                for ub.c-chk-doc.
    15452   define buffer buf_chk-gds                  for ub.chk-gds.
    15453   define buffer buf_chk-gds-attr             for ub.chk-gds-attr.
    15454   define buffer buf_c-chk-gds                for ub.c-chk-gds.
    15455   define buffer buf_chk-doc-attr             for ub.chk-doc-attr.
    15456   define buffer buf_c-chk-doc-attr           for ub.c-chk-doc-attr.
    15457   define buffer buf_marking-chk              for ub.marking-chk.
    15458     do
    15459     on error  undo, return error substitute( "$proc-load-trn-doc-inv-chk-doc. &1&2&3", return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    15460     on stop   undo, return error substitute( "$proc-load-trn-doc-inv-chk-doc. stop" )
    15461     on endkey undo, return error substitute( "$proc-load-trn-doc-inv-chk-doc. endkey" )
    15462     :
    15463       for each buf_chk-doc-attr where buf_chk-doc-attr.out-code = p-doc-code
    15464       on error  undo, return error
    15465       :
    15466         delete buf_chk-doc-attr.
    15467       end.
    15468       for each tdlocb-chk-doc-attr where tdlocb-chk-doc-attr.out-code = p-doc-code
    15469                             no-lock
    15470       on error  undo, return error
    15471       :
    15472         create buf_chk-doc-attr.
    15473         buffer-copy tdlocb-chk-doc-attr to buf_chk-doc-attr.
    15474       end.
    15475       for each buf_chk-doc where buf_chk-doc.out-code = p-doc-code
    15476       on error  undo, return error
    15477       :
    15478         delete buf_chk-doc.
    15479       end.
    15480       for each tdlocb-chk-doc where tdlocb-chk-doc.out-code = p-doc-code
    15481                             no-lock
    15482       on error  undo, return error
    15483       :
    15484         create buf_chk-doc.
    15485         buffer-copy tdlocb-chk-doc to buf_chk-doc.
    15486       end.
    15487       for each buf_chk-gds where buf_chk-gds.out-code = p-doc-code
    15488       on error  undo, return error
    15489       :
    15490         for each buf_chk-gds-attr where buf_chk-gds-attr.doc-code = buf_chk-gds.doc-code and buf_chk-gds-attr.line-num = buf_chk-gds.line-num
    15491         on error  undo, return error
    15492         :
    15493           delete buf_chk-gds-attr.
    15494         end.
    15495         for each buf_marking-chk where buf_marking-chk.doc-code = buf_chk-gds.doc-code and buf_marking-chk.line-num = buf_chk-gds.line-num
    15496         on error  undo, return error
    15497         :
    15498           delete buf_marking-chk.
    15499         end.
    15500         delete buf_chk-gds.
    15501       end.
    15502       for each tdlocb-chk-gds where tdlocb-chk-gds.out-code = p-doc-code
    15503                             no-lock
    15504       on error  undo, return error
    15505       :
    15506         create buf_chk-gds.
    15507         buffer-copy tdlocb-chk-gds to buf_chk-gds.
    15508         for each tdlocb-chk-gds-attr where tdlocb-chk-gds-attr.doc-code = tdlocb-chk-gds.doc-code and tdlocb-chk-gds-attr.line-num = tdlocb-chk-gds.line-num
    15509                               no-lock
    15510         on error  undo, return error
    15511         :
    15512           create buf_chk-gds-attr.
    15513           buffer-copy tdlocb-chk-gds-attr to buf_chk-gds-attr.
    15514         end.
    15515         for each tdlocb-marking-chk where tdlocb-marking-chk.doc-code = tdlocb-chk-gds.doc-code and tdlocb-marking-chk.line-num = tdlocb-chk-gds.line-num
    15516                               no-lock
    15517         on error  undo, return error
    15518         :
    15519           create buf_marking-chk.
    15520           buffer-copy tdlocb-marking-chk to buf_marking-chk.
    15521         end.
    15522       end.
    15523       for each buf_c-chk-doc-attr where buf_c-chk-doc-attr.out-code = p-doc-code
    15524       on error  undo, return error
    15525       :
    15526         delete buf_c-chk-doc-attr.
    15527       end.
    15528       for each tdlocb-c-chk-doc-attr where tdlocb-c-chk-doc-attr.out-code = p-doc-code
    15529                             no-lock
    15530       on error  undo, return error
    15531       :
    15532         create buf_c-chk-doc-attr.
    15533         buffer-copy tdlocb-c-chk-doc-attr to buf_c-chk-doc-attr.
    15534       end.
    15535       for each tdlocb-c-chk-doc where tdlocb-c-chk-doc.out-code = p-doc-code
    15536                             no-lock,
    15537           first buf_c-chk-doc where buf_c-chk-doc.doc-code = tdlocb-c-chk-doc.doc-code
    15538                       and buf_c-chk-doc.out-code = ?
    15539       on error  undo, return error
    15540       :
    15541         for each buf_c-chk-gds where buf_c-chk-gds.doc-code = tdlocb-c-chk-doc.doc-code:
    15542           delete buf_c-chk-gds.
    15543         end.
    15544         for each buf_c-chk-doc-attr where buf_c-chk-doc-attr.doc-code = tdlocb-c-chk-doc.doc-code:
    15545           delete buf_c-chk-doc-attr.
    15546         end.
    15547         delete buf_c-chk-doc.
    15548       end.
    15549       for each buf_c-chk-doc where buf_c-chk-doc.out-code = p-doc-code
    15550       on error  undo, return error
    15551       :
    15552         delete buf_c-chk-doc.
    15553       end.
    15554       for each tdlocb-c-chk-doc where tdlocb-c-chk-doc.out-code = p-doc-code
    15555                             no-lock
    15556       on error  undo, return error
    15557       :
    15558         create buf_c-chk-doc.
    15559         buffer-copy tdlocb-c-chk-doc to buf_c-chk-doc.
    15560       end.
    15561       for each buf_c-chk-gds where buf_c-chk-gds.out-code = p-doc-code
    15562       on error  undo, return error
    15563       :
    15564         delete buf_c-chk-gds.
    15565       end.
    15566       for each tdlocb-c-chk-gds where tdlocb-c-chk-gds.out-code = p-doc-code
    15567                             no-lock
    15568       on error  undo, return error
    15569       :
    15570         create buf_c-chk-gds.
    15571         buffer-copy tdlocb-c-chk-gds to buf_c-chk-gds.
    15572       end.
    15573       for each tdlocb-chk-doc
    15574       on error  undo, return error
    15575       :
    15576         delete tdlocb-chk-doc.
    15577       end.
    15578       for each tdlocb-chk-doc-attr
    15579       on error  undo, return error
    15580       :
    15581         delete tdlocb-chk-doc-attr.
    15582       end.
    15583       for each tdlocb-chk-gds
    15584       on error  undo, return error
    15585       :
    15586         delete tdlocb-chk-gds.
    15587       end.
    15588       for each tdlocb-chk-gds-attr
    15589       on error  undo, return error
    15590       :
    15591         delete tdlocb-chk-gds-attr.
    15592       end.
    15593       for each tdlocb-marking-chk
    15594       on error  undo, return error
    15595       :
    15596         delete tdlocb-marking-chk.
    15597       end.
    15598       for each tdlocb-c-chk-doc
    15599       on error  undo, return error
    15600       :
    15601         delete tdlocb-c-chk-doc.
    15602       end.
    15603       for each tdlocb-c-chk-doc-attr
    15604       on error  undo, return error
    15605       :
    15606         delete tdlocb-c-chk-doc-attr.
    15607       end.
    15608       for each tdlocb-c-chk-gds
    15609       on error  undo, return error
    15610       :
    15611         delete tdlocb-c-chk-gds.
    15612       end.
    15613     end.
    15614   END PROCEDURE.
    15615   define temp-table wt-trn-doc no-undo like ub.trn-doc.
