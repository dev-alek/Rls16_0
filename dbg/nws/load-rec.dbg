    11607   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run a-nwspdf in g#library2
    11608     (input  wt-price-doc-forming.plt-id
    11609     ,input  wt-price-doc-forming.plt-db-num
    11610     ,input  wt-price-doc-forming.pdf-id
    11611     ,input  wt-price-doc-forming.pdf-db
    11612     ,output v-send-to-cash
    11613     ) no-error .
