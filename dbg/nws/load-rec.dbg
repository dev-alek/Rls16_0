     8259       buf_c-layout-elem-rule.mode-id = p-mode-id
     8260       buf_c-layout-elem-rule.widget-id = p-widget-id
     8261       .
     8262     end.
     8263     assign
     8264     buf_c-layout-elem-rule.subject = 'layout-elem-rule':U
     8265     buf_c-layout-elem-rule.action = (if p-mode = 'ДОБАВЛЕНИЕ':U
     8266                            then integer('1':U)
     8267                            else (if p-mode = 'ИЗМЕНЕНИЕ':U
     8268                                  then integer('2':U)
     8269                                  else integer('99':U)
     8270                                  )
     8271                           )
     8272     buf_c-layout-elem-rule.chip-num = p-chip-num
     8273     buf_c-layout-elem-rule.corr-user-db-num = g#db-num
     8274     buf_c-layout-elem-rule.corr-user-name = g#userid
     8275     buf_c-layout-elem-rule.corr-date = v-today
     8276     buf_c-layout-elem-rule.corr-time = v-time
     8277     .
     8278   end.
     8279   end procedure.
     8280   procedure layouth_create-rule-call-param_h :
     8281   define input parameter p-mode as character no-undo .
     8282   define input parameter p-call#-id as integer no-undo .
     8283   define input parameter p-codex-id as integer no-undo .
     8284   define input parameter p-ruleset-id as integer no-undo .
     8285   define input parameter p-order-id as integer no-undo .
     8286   define input parameter p-param-name as character no-undo .
     8287   define input parameter p-index as integer no-undo .
     8288   define input parameter p-call-id as character no-undo .
     8289   define parameter buffer buf_rule-call-param for ub.rule-call-param.
     8290   define input parameter p-chip-num as integer no-undo .
     8291   DEFINE VARIABLE v-today as date no-undo .
     8292   DEFINE VARIABLE v-time as integer no-undo .
     8293   define buffer buf_c-rule-call-param for ub.c-rule-call-param.
     8294   do
     8295   on error undo, return error
     8296   :
     8297     run cur-time in this-procedure ( output v-today, output v-time).
     8298     create buf_c-rule-call-param.
     8299     if available buf_rule-call-param
     8300     and p-mode <> 'ДОБАВЛЕНИЕ':U
     8301     then do:
     8302       buffer-copy buf_rule-call-param
     8303       to buf_c-rule-call-param.
     8304     end.
     8305     if p-mode = 'ДОБАВЛЕНИЕ':U then do:
     8306       assign
     8307       buf_c-rule-call-param.call#_id = p-call#-id
     8308       buf_c-rule-call-param.codex_id = p-codex-id
     8309       buf_c-rule-call-param.ruleset_id = p-ruleset-id
     8310       buf_c-rule-call-param.order_id = p-order-id
     8311       buf_c-rule-call-param.param-name = p-param-name
     8312       buf_c-rule-call-param.p-index = p-index
     8313       buf_c-rule-call-param.call_id = p-call-id
     8314       .
     8315     end.
     8316     assign
     8317     buf_c-rule-call-param.action = (if p-mode = 'ДОБАВЛЕНИЕ':U
     8318                                     then integer('1':U)
     8319                                     else (if p-mode = 'удаление':U
     8320                                           then integer('99':U)
     8321                                           else integer('2':U)
     8322                                           )
     8323                                     )
     8324     buf_c-rule-call-param.chip-num = p-chip-num
     8325     buf_c-rule-call-param.corr-user-db-num = g#db-num
     8326     buf_c-rule-call-param.corr-user-name = g#userid
     8327     buf_c-rule-call-param.corr-date = v-today
     8328     buf_c-rule-call-param.corr-time = v-time
     8329     .
     8330   end.
     8331   end procedure.
     8332   define temp-table locb-layout-elem-rule no-undo like ub.layout-elem-rule.
     8333   define temp-table locb-rule-call-param no-undo like ub.rule-call-param.
     8334   define temp-table locb-rule-by-call no-undo like ub.rule-by-call.
     8335   define temp-table wt-layout no-undo like ub.layout.
     8336   PROCEDURE proc-load-layout:
     8337     define input parameter p-imp-handle as handle  no-undo.
     8338     define input parameter p-pck-num    as integer no-undo.
     8339     define input parameter l-counter    as integer no-undo.
     8340     do
     8341     on error  undo, return error substitute( "$proc-load-layout. &1&2&3", return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     8342     on stop   undo, return error substitute( "$proc-load-layout. stop" )
     8343     on endkey undo, return error substitute( "$proc-load-layout. endkey" )
     8344     :
     8345       define buffer tb-layout for ub.layout.
     8346       define variable compare-log as logical no-undo.
     8347   define buffer buf_layout-elem-rule for ub.layout-elem-rule.
     8348   define buffer buf_rule-call-param for ub.rule-call-param.
     8349   define buffer buf_rule-by-call for ub.rule-by-call.
     8350   define buffer buf_layout-elem for ub.layout-elem.
     8351   define buffer buf_wi-mode for ub.wi-mode.
     8352   define buffer buf2_layout for ub.layout.
     8353   define buffer buf2_layout-elem-rule for ub.layout-elem-rule.
     8354   define variable counter  as integer   no-undo.
     8355   define variable rec-full as character no-undo.
     8356   define variable rec-name as character no-undo.
     8357   define variable v-chip-num as integer no-undo .
     8358   define variable v-cmp as logical   no-undo .
     8359       for each wt-layout
     8360       on error undo, return error substitute( "$proc-load-layout(del-wt-). &1&2&3", return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     8361       :
     8362         delete wt-layout .
     8363       end.
     8364       create wt-layout.
     8365       run nws-impl in p-imp-handle
     8366         ( input 'layout':U
     8367          ,input (buffer wt-layout:handle)
     8368         ) no-error.
     8369       if error-status :error then do:
     8370         return error return-value .
     8371       end.
     8372       find first tb-layout
     8373         where tb-layout.layout-id = wt-layout.layout-id
     8374         exclusive-lock no-error.
     8375   define variable vss-include-info108 as character format "X(65)" no-undo
     8376   initial "@(#)$Workfile$ $Revision$".
     8377   DO counter = 1 TO l-counter
     8378   on error  undo, return error
     8379   on endkey undo, return error :
     8380   run nws-imps in p-imp-handle
     8381     ( input-output counter
     8382      ,output       rec-full
     8383     ) no-error.
     8384   if error-status :error then do:
     8385     return error substitute( "&1&2&3", return-value, chr(10), error-status :get-message(1) ) .
     8386   end.
     8387     assign
     8388       rec-name = entry( 1, rec-full, chr(1) )
     8389       .
     8390     CASE rec-name :
     8391       when 'layout-elem-rule':U then do:
     8392         create locb-layout-elem-rule.
     8393   run nws-impl in p-imp-handle
     8394     ( input "layout-elem-rule":U
     8395      ,input (buffer locb-layout-elem-rule:handle)
     8396     ) no-error.
     8397   if error-status :error then do:
     8398     return error substitute( "&1&2&3", return-value, chr(10), error-status :get-message(1) ) .
     8399   end.
     8400       end.
     8401       when 'rule-by-call':U then do:
     8402         create locb-rule-by-call.
     8403   run nws-impl in p-imp-handle
     8404     ( input "rule-by-call":U
     8405      ,input (buffer locb-rule-by-call:handle)
     8406     ) no-error.
     8407   if error-status :error then do:
     8408     return error substitute( "&1&2&3", return-value, chr(10), error-status :get-message(1) ) .
     8409   end.
     8410       end.
     8411       when 'rule-call-param':U then do:
     8412         create locb-rule-call-param.
     8413   run nws-impl in p-imp-handle
     8414     ( input "rule-call-param":U
     8415      ,input (buffer locb-rule-call-param:handle)
     8416     ) no-error.
     8417   if error-status :error then do:
     8418     return error substitute( "&1&2&3", return-value, chr(10), error-status :get-message(1) ) .
     8419   end.
     8420       end.
     8421       otherwise do:
     8422         message "Не предусмотрен прием таблицы " rec-name skip
     8423                 "в составе раскалдки."
     8424                 view-as alert-box error.
     8425         return error.
     8426       end.
     8427     END CASE.
     8428   end.
     8429   run  layouth_create-layout_h  in this-procedure (
     8430                                                   input 'ИЗМЕНЕНИЕ':U
     8431                                                 ,input wt-layout.layout-id
     8432                                                 ,buffer tb-layout
     8433                                                 ,output v-chip-num).
     8434   if wt-layout.is-default = integer('0':U)
     8435   or wt-layout.is-default = integer('1':U)
     8436   then do:
     8437     find first buf2_layout share-lock where
     8438               buf2_layout.layout-type = wt-layout.layout-type
     8439           and buf2_layout.device-type = wt-layout.device-type
     8440           and buf2_layout.is-default = integer('-1':U) no-error.
     8441     if available buf2_layout then do:
     8442       for each buf2_layout-elem-rule no-lock where
     8443               buf2_layout-elem-rule.layout-id = buf2_layout.layout-id
     8444       on error  undo, return error:
     8445         find first locb-layout-elem-rule where
     8446                  locb-layout-elem-rule.layout-id = wt-layout.layout-id
     8447             and locb-layout-elem-rule.mode-id = buf2_layout-elem-rule.mode-id
     8448             and locb-layout-elem-rule.widget-id = buf2_layout-elem-rule.widget-id no-error.
     8449         if not available locb-layout-elem-rule
     8450         or locb-layout-elem-rule.rule_id <> buf2_layout-elem-rule.rule_id then do:
     8451           if available locb-layout-elem-rule then do:
     8452             assign
     8453             locb-layout-elem-rule.sts = integer('1':U)
     8454             .
     8455           end.
     8456           wt-layout.sts = (if wt-layout.sts <> integer('99':U)
     8457                           then integer('50':U)
     8458                           else wt-layout.sts).
     8459         end.
     8460       end.
     8461     end.
     8462   end.
     8463   for each locb-layout-elem-rule where locb-layout-elem-rule.layout-id = wt-layout.layout-id
     8464   on error  undo, return error:
     8465     find first buf_wi-mode no-lock where
     8466             buf_wi-mode.mode-type = 'cd-IBS-TH':U
     8467         and buf_wi-mode.mode-id = locb-layout-elem-rule.mode-id no-error.
     8468     if not available buf_wi-mode then do:
     8469       assign
     8470       locb-layout-elem-rule.sts = integer('1':U)
     8471       wt-layout.sts = (if wt-layout.sts <> integer('99':U)
     8472                        then integer('50':U)
     8473                        else wt-layout.sts)
     8474       .
     8475     end.
     8476     find first buf_layout-elem no-lock where
     8477             buf_layout-elem.layout-type = wt-layout.layout-type
     8478         and buf_layout-elem.device-type = wt-layout.device-type
     8479         and buf_layout-elem.mode-id = locb-layout-elem-rule.mode-id
     8480         and buf_layout-elem.widget-id = locb-layout-elem-rule.widget-id
     8481         no-error.
     8482     if not available buf_layout-elem
     8483     or (wt-layout.is-default = integer('0':U)
     8484         and
     8485         buf_layout-elem.elem-type = integer('0':U)
     8486         )
     8487     then do:
     8488       assign
     8489       locb-layout-elem-rule.sts = integer('1':U)
     8490       wt-layout.sts = (if wt-layout.sts <> integer('99':U)
     8491                        then integer('50':U)
     8492                        else wt-layout.sts)
     8493       .
     8494     end.
     8495     v-cmp = yes.
     8496     find first buf_layout-elem-rule where
     8497               buf_layout-elem-rule.layout-id = locb-layout-elem-rule.layout-id
     8498           and buf_layout-elem-rule.mode-id = locb-layout-elem-rule.mode-id
     8499           and buf_layout-elem-rule.widget-id = locb-layout-elem-rule.widget-id no-error.
     8500     if not available buf_layout-elem-rule then do:
     8501       v-cmp = no.
     8502       create buf_layout-elem-rule.
     8503     end.
     8504     else do:
     8505       buffer-compare buf_layout-elem-rule to locb-layout-elem-rule case-sensitive  save result in v-cmp.
     8506     end.
     8507     if not v-cmp then do:
     8508       run  layouth_create-layout-elem-rule_h  in this-procedure (
     8509                                                       input (if new (buf_layout-elem-rule) then 'ДОБАВЛЕНИЕ':U else 'ИЗМЕНЕНИЕ':U)
     8510                                                     ,input locb-layout-elem-rule.layout-id
     8511                                                     ,input locb-layout-elem-rule.mode-id
     8512                                                     ,input locb-layout-elem-rule.widget-id
     8513                                                     ,buffer buf_layout-elem-rule
     8514                                                     ,input v-chip-num).
     8515       buffer-copy locb-layout-elem-rule to buf_layout-elem-rule.
     8516     end.
     8517       for each locb-rule-by-call where
     8518            locb-rule-by-call.call_id = locb-layout-elem-rule.uniq-key-rec
     8519     on error  undo, return error:
     8520        v-cmp = yes.
     8521        find first buf_rule-by-call where
     8522                 buf_rule-by-call.call_id = locb-rule-by-call.call_id
     8523             and buf_rule-by-call.codex_id = locb-rule-by-call.codex_id
     8524             and buf_rule-by-call.ruleset_id = locb-rule-by-call.ruleset_id
     8525             and buf_rule-by-call.order_id = locb-rule-by-call.order_id no-error.
     8526        if not available buf_rule-by-call then do:
     8527          v-cmp = no.
     8528          create buf_rule-by-call.
     8529          buffer-copy locb-rule-by-call to buf_rule-by-call.
     8530        end.
     8531        else do:
     8532          buffer-compare locb-rule-by-call to buf_rule-by-call case-sensitive  save result in v-cmp.
     8533        end.
     8534        if v-cmp = no then do:
     8535           buffer-copy locb-rule-by-call to buf_rule-by-call.
     8536        end.
     8537     end.
     8538     for each locb-rule-call-param where
     8539            locb-rule-call-param.call_id = locb-layout-elem-rule.uniq-key-rec
     8540     on error  undo, return error:
     8541        v-cmp = yes.
     8542        find first buf_rule-call-param where
     8543                 buf_rule-call-param.call_id = locb-rule-call-param.call_id
     8544             and buf_rule-call-param.codex_id = locb-rule-call-param.codex_id
     8545             and buf_rule-call-param.ruleset_id = locb-rule-call-param.ruleset_id
     8546             and buf_rule-call-param.order_id = locb-rule-call-param.order_id
     8547             and buf_rule-call-param.param-name = locb-rule-call-param.param-name
     8548             and buf_rule-call-param.p-index = locb-rule-call-param.p-index
     8549             no-error.
     8550        if not available buf_rule-call-param then do:
     8551          v-cmp = no.
     8552          create buf_rule-call-param.
     8553          buffer-copy locb-rule-call-param to buf_rule-call-param.
     8554        end.
     8555        else do:
     8556          buffer-compare locb-rule-call-param to buf_rule-call-param case-sensitive  save result in v-cmp.
     8557        end.
     8558        if v-cmp = no then do:
     8559           run  layouth_create-rule-call-param_h  in this-procedure (
     8560                                                           input (if new(buf_rule-call-param)
     8561                                                                  then 'ДОБАВЛЕНИЕ':U
     8562                                                                  else 'ИЗМЕНЕНИЕ':U)
     8563                                                         ,input locb-rule-call-param.call#_id
     8564                                                         ,input locb-rule-call-param.codex_id
     8565                                                         ,input locb-rule-call-param.ruleset_id
     8566                                                         ,input locb-rule-call-param.order_id
     8567                                                         ,input locb-rule-call-param.param-name
     8568                                                         ,input locb-rule-call-param.p-index
     8569                                                         ,input locb-rule-call-param.call_id
     8570                                                         ,buffer buf_rule-call-param
     8571                                                         ,input v-chip-num).
     8572           buffer-copy locb-rule-call-param to buf_rule-call-param.
     8573        end.
     8574     end.
     8575     for each buf_rule-call-param where
     8576            buf_rule-call-param.call_id = locb-layout-elem-rule.uniq-key-rec
     8577     on error  undo, return error:
     8578        v-cmp = yes.
     8579        find first locb-rule-call-param where
     8580                 locb-rule-call-param.call_id = buf_rule-call-param.call_id
     8581             and locb-rule-call-param.codex_id = buf_rule-call-param.codex_id
     8582             and locb-rule-call-param.ruleset_id = buf_rule-call-param.ruleset_id
     8583             and locb-rule-call-param.order_id = buf_rule-call-param.order_id
     8584             and locb-rule-call-param.param-name = buf_rule-call-param.param-name
     8585             and locb-rule-call-param.p-index = buf_rule-call-param.p-index
     8586             no-error.
     8587        if not available locb-rule-call-param then do:
     8588           run  layouth_create-rule-call-param_h  in this-procedure (
     8589                                                           input 'удаление':U
     8590                                                         ,input buf_rule-call-param.call#_id
     8591                                                         ,input buf_rule-call-param.codex_id
     8592                                                         ,input buf_rule-call-param.ruleset_id
     8593                                                         ,input buf_rule-call-param.order_id
     8594                                                         ,input buf_rule-call-param.param-name
     8595                                                         ,input buf_rule-call-param.p-index
     8596                                                         ,input buf_rule-call-param.call_id
     8597                                                         ,buffer buf_rule-call-param
     8598                                                         ,input v-chip-num).
     8599        end.
     8600     end.
     8601   end.
     8602   for each buf_layout-elem-rule where buf_layout-elem-rule.layout-id = wt-layout.layout-id
     8603   on error  undo, return error
     8604   :
     8605     v-cmp = yes.
     8606     find first locb-layout-elem-rule where
     8607               locb-layout-elem-rule.layout-id = buf_layout-elem-rule.layout-id
     8608           and locb-layout-elem-rule.mode-id = buf_layout-elem-rule.mode-id
     8609           and locb-layout-elem-rule.widget-id = buf_layout-elem-rule.widget-id no-error.
     8610     if not available buf_layout-elem-rule then do:
     8611       run  layouth_create-layout-elem-rule_h  in this-procedure (
     8612                                                       input 'удаление':U
     8613                                                     ,input buf_layout-elem-rule.layout-id
     8614                                                     ,input buf_layout-elem-rule.mode-id
     8615                                                     ,input buf_layout-elem-rule.widget-id
     8616                                                     ,buffer buf_layout-elem-rule
     8617                                                     ,input v-chip-num).
     8618       for each buf_rule-by-call where
     8619               buf_rule-by-call.call_id = buf_layout-elem-rule.uniq-key-rec
     8620       on error  undo, return error:
     8621         delete buf_rule-by-call.
     8622       end.
     8623       for each buf_rule-call-param where
     8624               buf_rule-call-param.call_id = buf_layout-elem-rule.uniq-key-rec
     8625       on error  undo, return error:
     8626           run  layouth_create-rule-call-param_h  in this-procedure (
     8627                                                           input 'удаление':U
     8628                                                         ,input buf_rule-call-param.call#_id
     8629                                                         ,input buf_rule-call-param.codex_id
     8630                                                         ,input buf_rule-call-param.ruleset_id
     8631                                                         ,input buf_rule-call-param.order_id
     8632                                                         ,input buf_rule-call-param.param-name
     8633                                                         ,input buf_rule-call-param.p-index
     8634                                                         ,input buf_rule-call-param.call_id
     8635                                                         ,buffer buf_rule-call-param
     8636                                                         ,input v-chip-num).
     8637         delete buf_rule-by-call.
     8638       end.
     8639       delete buf_layout-elem-rule.
     8640     end.
     8641   end.
     8642   if not available tb-layout then do:
     8643     create tb-layout.
     8644   end.
     8645   buffer-copy wt-layout to tb-layout.
     8646   for each locb-layout-elem-rule
     8647   on error  undo, return error
     8648   :
     8649     delete locb-layout-elem-rule.
     8650   end.
     8651   for each locb-rule-call-param
     8652   on error  undo, return error
     8653   :
     8654     delete locb-rule-call-param.
     8655   end.
     8656   for each locb-rule-by-call
     8657   on error  undo, return error
     8658   :
     8659     delete locb-rule-by-call.
     8660   end.
     8661       delete wt-layout.
     8662     end.
     8663   END PROCEDURE.
     8664   def var vss-include-info109 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8665   define variable vss-include-info110 as character format "X(65)" no-undo
     8666   initial "@(#)$Workfile$ $Revision$".
     8667   procedure xmlchar-test :
     8668   define input parameter p-in-string          as character        no-undo.
     8669   define output parameter p-out-string-enc    as character        no-undo.
     8670   define output parameter p-out-string-dec    as character        no-undo.
     8671   do
     8672   on error undo, return error
     8673   :
     8674          run xmlchar-encode in this-procedure
     8675       (
     8676             input p-in-string
     8677           , output p-out-string-enc
     8678       ).
     8679          run xmlchar-decode in this-procedure
     8680       (
     8681             input p-out-string-enc
     8682           , output p-out-string-dec
     8683       ).
     8684   end.
     8685   end .
     8686   procedure xmlchar-encode :
     8687   define input parameter p-in-string      as character        no-undo.
     8688   define output parameter p-out-string    as character        no-undo.
     8689       define variable v-position      as integer      no-undo.
     8690       define variable v-current-char  as character    no-undo.
     8691   do
     8692   on error undo, return error
     8693   :
     8694       assign
     8695           p-out-string = "":U
     8696       .
     8697       case p-in-string
     8698       :
     8699           when ?
     8700           then do:
     8701               assign
     8702                   p-out-string = "?":U
     8703               .
     8704           end.
     8705           when "?":U
     8706           then do:
     8707               assign
     8708                   p-out-string = "&#63;":U
     8709               .
     8710           end.
     8711           otherwise do:
     8712               do v-position = 1 to length( p-in-string )
     8713               :
     8714                   assign
     8715                       v-current-char = substring( p-in-string, v-position, 1 )
     8716                   .
     8717                   case v-current-char
     8718                   :
     8719                       when "&":U
     8720                       then do:
     8721                           assign
     8722                               p-out-string = p-out-string + "&amp;":U
     8723                           .
     8724                       end.
     8725                       when ">":U
     8726                       then do:
     8727                           assign
     8728                               p-out-string = p-out-string + "&gt;":U
     8729                           .
     8730                       end.
     8731                       when "<":U
     8732                       then do:
     8733                           assign
     8734                               p-out-string = p-out-string + "&lt;":U
     8735                           .
     8736                       end.
     8737                       when "'":U
     8738                       then do:
     8739                           assign
     8740                               p-out-string = p-out-string + "&apos;":U
     8741                           .
     8742                       end.
     8743                       when '"':U
     8744                       then do:
     8745                           assign
     8746                               p-out-string = p-out-string + "&quot;":U
     8747                           .
     8748                       end.
     8749                       when chr(1)
     8750                       then do:
     8751                           assign
     8752                               p-out-string = p-out-string + "":U
     8753                           .
     8754                       end.
     8755                       when chr(2)
     8756                       then do:
     8757                           assign
     8758                               p-out-string = p-out-string + "":U
     8759                           .
     8760                       end.
     8761                       when chr(3)
     8762                       then do:
     8763                           assign
     8764                               p-out-string = p-out-string + "":U
     8765                           .
     8766                       end.
     8767                       when chr(4)
     8768                       then do:
     8769                           assign
     8770                               p-out-string = p-out-string + "":U
     8771                           .
     8772                       end.
     8773                       when chr(5)
     8774                       then do:
     8775                           assign
     8776                               p-out-string = p-out-string + "":U
     8777                           .
     8778                       end.
     8779                       when chr(6)
     8780                       then do:
     8781                           assign
     8782                               p-out-string = p-out-string + "":U
     8783                           .
     8784                       end.
     8785                       when chr(7)
     8786                       then do:
     8787                           assign
     8788                               p-out-string = p-out-string + "":U
     8789                           .
     8790                       end.
     8791                       when chr(8)
     8792                       then do:
     8793                           assign
     8794                               p-out-string = p-out-string + "":U
     8795                           .
     8796                       end.
     8797                       when chr(9)
     8798                       then do:
     8799                           assign
     8800                               p-out-string = p-out-string + "":U
     8801                           .
     8802                       end.
     8803                       when chr(29)
     8804                       then do:
     8805                           assign
     8806                               p-out-string = p-out-string + "":U
     8807                           .
     8808                       end.
     8809                       when chr(10)
     8810                       then do:
     8811                           assign
     8812                               p-out-string = p-out-string + "&#10;":U
     8813                           .
     8814                       end.
     8815                       when chr(13)
     8816                       then do:
     8817                           assign
     8818                               p-out-string = p-out-string + "&#13;":U
     8819                           .
     8820                       end.
     8821                       otherwise do:
     8822                           assign
     8823                               p-out-string = p-out-string + v-current-char
     8824                           .
     8825                       end.
     8826                   end case.
     8827               end.
     8828           end.
     8829       end case.
     8830   end.
     8831   end .
     8832   procedure xmlchar-encode-1c :
     8833   define input parameter p-in-string      as character        no-undo.
     8834   define output parameter p-out-string    as character        no-undo.
     8835       define variable v-position      as integer      no-undo.
     8836       define variable v-current-char  as character    no-undo.
     8837   do
     8838   on error undo, return error
     8839   :
     8840       assign
     8841           p-out-string = "":U
     8842       .
     8843       case p-in-string
     8844       :
     8845           when ?
     8846           then do:
     8847               assign
     8848                   p-out-string = "?":U
     8849               .
     8850           end.
     8851           otherwise do:
     8852               do v-position = 1 to length( p-in-string )
     8853               :
     8854                   assign
     8855                       v-current-char = substring( p-in-string, v-position, 1 )
     8856                   .
     8857                   case v-current-char
     8858                   :
     8859                       when chr(1)
     8860                       then do:
     8861                           assign
     8862                               p-out-string = p-out-string + " ":U
     8863                           .
     8864                       end.
     8865                       when chr(2)
     8866                       then do:
     8867                           assign
     8868                               p-out-string = p-out-string + " ":U
     8869                           .
     8870                       end.
     8871                       when chr(3)
     8872                       then do:
     8873                           assign
     8874                               p-out-string = p-out-string + " ":U
     8875                           .
     8876                       end.
     8877                       when chr(4)
     8878                       then do:
     8879                           assign
     8880                               p-out-string = p-out-string + " ":U
     8881                           .
     8882                       end.
     8883                       when chr(5)
     8884                       then do:
     8885                           assign
     8886                               p-out-string = p-out-string + " ":U
     8887                           .
     8888                       end.
     8889                       when chr(6)
     8890                       then do:
     8891                           assign
     8892                               p-out-string = p-out-string + " ":U
     8893                           .
     8894                       end.
     8895                       when chr(7)
     8896                       then do:
     8897                           assign
     8898                               p-out-string = p-out-string + " ":U
     8899                           .
     8900                       end.
     8901                       when chr(8)
     8902                       then do:
     8903                           assign
     8904                               p-out-string = p-out-string + " ":U
     8905                           .
     8906                       end.
     8907                       when chr(9)
     8908                       then do:
     8909                           assign
     8910                               p-out-string = p-out-string + " ":U
     8911                           .
     8912                       end.
     8913                       when chr(29)
     8914                       then do:
     8915                           assign
     8916                               p-out-string = p-out-string + " ":U
     8917                           .
     8918                       end.
     8919                       when chr(10)
     8920                       then do:
     8921                           assign
     8922                               p-out-string = p-out-string + " ":U
     8923                           .
     8924                       end.
     8925                       when chr(13)
     8926                       then do:
     8927                           assign
     8928                               p-out-string = p-out-string + " ":U
     8929                           .
     8930                       end.
     8931                       otherwise do:
     8932                           assign
     8933                               p-out-string = p-out-string + v-current-char
     8934                           .
     8935                       end.
     8936                   end case.
     8937               end.
     8938           end.
     8939       end case.
     8940   end.
     8941   end .
     8942   procedure xmlchar-decode :
     8943   define input parameter p-in-string      as character        no-undo.
     8944   define output parameter p-out-string    as character        no-undo.
     8945       define variable v-position      as integer      no-undo.
     8946       define variable v-last-position as integer      no-undo.
     8947       define variable v-temp-integer  as integer      no-undo.
     8948       define variable v-current-char  as character    no-undo.
     8949       define variable v-next-char     as character    no-undo.
     8950       define variable v-success       as logical      no-undo.
     8951   do
     8952   on error undo, return error
     8953   :
     8954       assign
     8955           p-out-string = "":U
     8956           v-position   = 0
     8957       .
     8958       replace-cycle:
     8959       do while yes
     8960       on error undo, return error
     8961       :
     8962           assign
     8963               v-last-position = index( p-in-string, "&":U, v-position + 1 )
     8964           .
     8965           if v-last-position <= v-position
     8966           then do:
     8967               if v-position = 0
     8968               then do:
     8969                   assign
     8970                       p-out-string = p-in-string
     8971                   .
     8972               end.
     8973               else do:
     8974                   assign
     8975                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
     8976                   .
     8977               end.
     8978               leave replace-cycle.
     8979           end.
     8980           else do:
     8981               assign
     8982                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
     8983                   v-position      = v-last-position
     8984                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
     8985               .
     8986               if v-current-char = "#":U
     8987               then do:
     8988                   assign
     8989                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
     8990                   .
     8991                   if v-last-position > 0
     8992                   then do:
     8993                       run xmlchar-read-integer in this-procedure
     8994                        (
     8995                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
     8996                           , output v-temp-integer
     8997                           , output v-success
     8998                       ).
     8999                       if v-success = yes
     9000                       and v-temp-integer >= 1
     9001                       and v-temp-integer <= 255
     9002                       then do:
     9003                           assign
     9004                               p-out-string = p-out-string + chr( v-temp-integer )
     9005                               v-position   = v-last-position + 1
     9006                           .
     9007                       end.
     9008                       else do:
     9009                           assign
     9010                               p-out-string = p-out-string + "&":U
     9011                               v-position   = v-position   + 1
     9012                           .
     9013                       end.
     9014                   end.
     9015                   else do:
     9016                       assign
     9017                           p-out-string = p-out-string + "&":U
     9018                           v-position   = v-position   + 1
     9019                       .
     9020                   end.
     9021               end.
     9022               else do:
     9023                   case substring( p-in-string, v-position + 1, 3 )
     9024                   :
     9025                       when "lt;":U
     9026                       then do:
     9027                           assign
     9028                               p-out-string = p-out-string + "<":U
     9029                               v-position   = v-position   + 3
     9030                           .
     9031                       end.
     9032                       when "gt;":U
     9033                       then do:
     9034                           assign
     9035                               p-out-string = p-out-string + ">":U
     9036                               v-position   = v-position   + 3
     9037                           .
     9038                       end.
     9039                       otherwise do:
     9040                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
     9041                           then do:
     9042                               assign
     9043                                   p-out-string = p-out-string + "&":U
     9044                                   v-position   = v-position   + 4
     9045                               .
     9046                           end.
     9047                           else do:
     9048                               case substring( p-in-string, v-position + 1, 5 )
     9049                               :
     9050                                   when "quot;":U
     9051                                   then do:
     9052                                       assign
     9053                                           p-out-string = p-out-string + '"':U
     9054                                           v-position   = v-position   + 5
     9055                                       .
     9056                                   end.
     9057                                   when "apos;":U
     9058                                   then do:
     9059                                       assign
     9060                                           p-out-string = p-out-string + "'":U
     9061                                           v-position   = v-position   + 5
     9062                                       .
     9063                                   end.
     9064                                   otherwise do:
     9065                                       assign
     9066                                           p-out-string = p-out-string + "&":U
     9067                                       .
     9068                                   end.
     9069                               end case.
     9070                           end.
     9071                       end.
     9072                   end case.
     9073               end.
     9074           end.
     9075       end.
     9076   end.
     9077   end .
     9078   procedure xmlchar-read-integer :
     9079   define input parameter p-input-string      as character        no-undo.
     9080   define output parameter p-output-integer   as integer          no-undo.
     9081   define output parameter p-success       as logical          no-undo.
     9082   do
     9083   on error undo, return error
     9084   :
     9085       assign
     9086           p-output-integer = integer( p-input-string )
     9087       no-error.
     9088       if error-status :error
     9089       then do:
     9090           assign
     9091               p-success           = no
     9092               p-output-integer    = 0
     9093           .
     9094       end.
     9095       else do:
     9096           assign
     9097               p-success           = yes
     9098           .
     9099       end.
     9100   end.
     9101   end.
     9102   def var objSrv as class ibs.th.gbl.sys.objsrv no-undo.
     9103   run gbl/getobjsrvhndl.p (input-output ObjSrv).
     9104   define variable mMRCCode  as logical    no-undo.
     9105   define variable mTypeMark as character  no-undo.
     9106   function IS-NeedMark returns logical
     9107   ( input ib-code as integer  ,
     9108     input ib-str as character ):
     9109      define buffer buf_prod-bc-attr for ub.prod-bc-attr.
     9110      find first buf_prod-bc-attr where buf_prod-bc-attr.b-code eq ib-code
     9111                                    and buf_prod-bc-attr.b-str  eq ib-str
     9112                                    and buf_prod-bc-attr.attr-code eq 'mark':U
     9113        no-lock no-error.
     9114      return if available buf_prod-bc-attr then logical(buf_prod-bc-attr.attr-value) else no .
     9115   end.
     9116   function repTegforDm return char
     9117   (iDM as char ):
     9118       define variable vTeglist as character no-undo init "01,02,11,13,17,21,8005,37".
     9119       define variable vteg as character no-undo.
     9120       define variable oDM as character no-undo.
     9121       define variable vi as integer no-undo.
     9122       oDM = iDm.
     9123       do vi = 1 to num-entries(vTeglist):
     9124          vTeg = entry(vi,vTeglist).
     9125          oDM = replace(oDM,"(" + vTeg + ")",vTeg).
     9126       end.
     9127       return oDM.
     9128   end.
     9129   function repSpecSimbforDm return char
     9130   (iDM as char ):
     9131       define variable oDM as character no-undo.
     9132     run
     9133       xmlchar-decode(iDM, output oDM).
     9134     return repTegforDm (oDM).
     9135   end.
     9136   function CheckGtin return logical
     9137   (iGtin as char):
     9138      define variable bar_code as character no-undo.
     9139      define variable vGtin as logical no-undo init "yes".
     9140      if length(iGtin) eq 14
     9141      then do:
     9142         bar_code = substr (iGtin, 1, length (iGtin) - 1).
     9143         run str/chk-sum.p
     9144          (input-output bar_code ) no-error .
     9145         if iGtin ne  bar_code
     9146         then
     9147            vGtin = no.
     9148      end.
     9149      else
     9150         vGtin = no.
     9151      return vgtin.
     9152   end.
     9153   function repSpecSimbforXlm return char
     9154   (iDM as char ):
     9155       iDM = replace(iDM,chr(29),"").
     9156       return iDM.
     9157   end.
     9158   function getGtinByDM return char
     9159   (IDM as char):
     9160      define variable VTXT as char no-undo.
     9161      define variable vGtin as char no-undo.
     9162      vTXt = IdM.
     9163      vGtin = IDM.
     9164      if    length(vtxt) > 14
     9165      then do:
     9166         if   vtxt begins "(01)"
     9167                or vtxt begins "(02)"
     9168         then
     9169            vGtin = substring(vtxt,5,14).
     9170         else if   (vtxt begins "01"
     9171                or vtxt begins "02" )
     9172                and (   (    substring(iDm,17,2) eq "21"
     9173                         and length(vtxt) >= 21)
     9174                     or substring(iDm,17,2) eq "37"
     9175                     or substring(iDm,17,4) eq "(37)" )
     9176         then do:
     9177            vGtin = substring(vtxt,3,14).
     9178            if not checkGtin(vGtin)
     9179            then
     9180               vGtin = substring(vtxt,1,14).
     9181         end.
     9182         else if     length(vtxt) eq 14 + 7 + 4 + 4
     9183             or length(vtxt) eq 14 + 7 + 4
     9184             or length(vtxt) eq 14 + 7
     9185         then
     9186            vGtin = substring(vtxt,1,14).
     9187      end.
     9188      if not checkGtin(vGtin)
     9189      then
     9190         vGtin = "".
     9191      return vgtin.
     9192   end.
     9193   function getGdsCodeByGtin return int
     9194   (iGtin as char):
     9195      define buffer prod-bc  for ub.prod-bc.
     9196      define buffer bar-code for ub.bar-code.
     9197      find first prod-bc where prod-bc.b-str eq iGtin  and prod-bc.bc-on no-lock no-error.
     9198      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
     9199      return if avail bar-code then bar-code.gds-code else ?.
     9200   end.
     9201   function getQntyCodeByGtin return decimal
     9202   (iGtin as char):
     9203      define buffer prod-bc  for ub.prod-bc.
     9204      define buffer bar-code for ub.bar-code.
     9205      find first prod-bc where prod-bc.b-str eq iGtin no-lock no-error.
     9206      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
     9207      return if avail bar-code then bar-code.cli-base-rate else ?.
     9208   end.
     9209   function getGdsCodeByDM return int
     9210   (iDm as char):
     9211      define variable vGtin as char no-undo.
     9212      define buffer prod-bc for ub.prod-bc.
     9213      vGtin  = getGtinByDM (IDM ).
     9214      return getGdsCodeByGtin (vGtin).
     9215   end.
     9216   function ChekTypeMarkByGds return logical
     9217   (iGds-code as integer ):
     9218      define buffer goods-attr for ub.goods-attr.
     9219      find first goods-attr where goods-attr.gds-code   = iGds-code
     9220                              and goods-attr.attr-code  = 'mark-type':U
     9221      no-lock no-error.
     9222      if available goods-attr
     9223      then do:
     9224         mTypeMark = goods-attr.attr-value.
     9225         return goods-attr.attr-value = objsrv:Env:Marking:Types:tabak:NameProp
     9226           .
     9227      end.
     9228      else
     9229         return no.
     9230   end.
     9231   function ChekTypeMarkByDm return logical
     9232   (iDM as char ):
     9233      return ChekTypeMarkByGds(getGdsCodeByDM(idm)).
     9234   end.
     9235   function ChekTypeMarkByGtin return logical
     9236   (iGtin as char ):
     9237      return ChekTypeMarkByGds(getGdsCodeByGtin(iGtin)).
     9238   end.
     9239   function GetNextElement return character
     9240     (input iAllTeg        as logical
     9241     ,output oteg          as character
     9242     ,output otegval       as character
     9243     ,input-output pstr    as character
     9244      ):
     9245        define variable vlistElem   as character no-undo init "00,01,02,21,17,11,13,(01),(02),(21),(17),(11),(13)".
     9246        define variable vlistleng   as character no-undo init "27,14,14,13,06,06,06,0014,0014,0013,0006,0006,0006".
     9247        define variable vlistElemDop   as character no-undo init ",37,(37),(8005),8005,93,(93)".
     9248        define variable vlistlengDop   as character no-undo init ",08,0008,000006,0006,04,0004".
     9249        define variable vTeg as character no-undo.
     9250        define variable vLength as integer no-undo.
     9251        define variable vi as integer no-undo.
     9252        define variable vj as integer no-undo.
     9253        define buffer code for ub.code.
     9254        find first code where Code.parent eq "MarkType"
     9255                          and Code.CodeValue   eq mTypeMark
     9256                          no-lock no-error.
     9257        if     available code
     9258           and Code.misc1 ne ""
     9259           and Code.misc1 ne ?
     9260        then do:
     9261           integer (Code.misc1) no-error.
     9262           if not error-status:error
     9263           then
     9264             entry (4,vlistleng) = Code.misc1.
     9265        end.
     9266        if iAllTeg
     9267        then
     9268           assign
     9269              vlistElem     = vlistElem    + vlistElemDop
     9270              vlistleng     = vlistleng    + vlistlengDop
     9271           .
     9272        else if mMRCCode
     9273        then
     9274           assign
     9275              vlistElem     = vlistElem    + ",(8005),8005"
     9276              vlistleng     = vlistleng    + ",000006,0006"
     9277           .
     9278       block-elem:
     9279       do vi = 1 to num-entries(vlistElem):
     9280          vTeg = entry(vi,vlistElem).
     9281          if pstr begins vTeg
     9282          then do:
     9283             if    vTeg eq "21"
     9284             then
     9285                vLength = index(pstr,chr(29)) - 2 no-error.
     9286             if vLength  <= 0
     9287             then
     9288                vLength = int(entry(vi,vlistleng)).
     9289             otegval = substring (pstr,length(vteg) + 1, vLength).
     9290             oteg = replace(replace(vteg,")",""),"(","").
     9291             vTeg = vteg + otegval.
     9292             otegval = replace(otegval,chr(29),"").
     9293             oteg = replace(replace(oteg,")",""),"(","").
     9294             pstr = substring (pstr,length(vTeg)+ 1).
     9295             vTeg = replace(vTeg,chr(29),"").
     9296             leave block-elem.
     9297          end.
     9298          else
     9299             vTeg = "".
     9300       end.
     9301       return vteg.
     9302   end.
     9303   function GetCodeIdent return character
     9304   (iDm as char):
     9305      define variable Velement   as character no-undo init "first".
     9306      define variable oCodeIdent as character no-undo.
     9307      define variable vteg as character no-undo.
     9308      define variable vtegval as character no-undo.
     9309      define variable vGtin as character no-undo.
     9310      define buffer marking for ub.marking.
     9311      for first marking no-lock where
     9312                marking.mark eq iDm
     9313            and marking.unit-ext = "LEVEL2"
     9314      :
     9315        return iDm.
     9316      end.
     9317      vGtin  = getGtinByDM (iDm ).
     9318      ChekTypeMarkByDm(idm).
     9319      if iDm begins 'tech_':U
     9320      then
     9321         oCodeIdent = iDm.
     9322      else if length(iDm) < 21
     9323      then do:
     9324         find first marking where marking.mark eq idm
     9325         no-lock no-error.
     9326         oCodeIdent = if available marking then marking.mark else  ?.
     9327      end.
     9328      else if     length(iDm) eq 29
     9329         and not iDm begins "01"
     9330         and not iDm begins "02"
     9331      then
     9332         oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21 ).
     9333      else  if     length(iDm) >= 24
     9334               and (  iDm begins "01"
     9335                   or iDm begins "02")
     9336               and  substring(iDm,17,2) ne "21"
     9337      then do:
     9338         if checkGtin(substring(iDm,1,14)) and ( (length(idm) eq 25 and substring(iDm,22,1) eq "A")
     9339                                                   or (length(idm) eq 29 and substring(iDm,22,1) eq "A"))
     9340         then
     9341            oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21).
     9342         else
     9343            oCodeIdent = iDM.
     9344      end.
     9345      else  if     (   length(iDm) eq 25
     9346                    or length(iDm) eq 21)
     9347               and (not iDm begins "01"
     9348               and  not iDm begins "02")
     9349      then
     9350         oCodeIdent = substring(iDm,1,21).
     9351      else if vGtin = substring(iDm,1,14) and checkGtin(substring(iDm,1,14)) and ( length(idm) eq 21 or (length(idm) eq 25 and substring(iDm,22,1) eq "A"))
     9352      then
     9353         oCodeIdent = substring(iDm,1,21).
     9354      else do while Velement ne "" and idm ne "":
     9355         Velement = GetNextElement(no,output vteg, output vtegval, input-output idm).
     9356         oCodeIdent = oCodeIdent + Velement.
     9357      end.
     9358      return oCodeIdent.
     9359   end.
     9360   function GetTegCod return character
     9361   (icodeIdent as char, iTeg as char):
     9362      define variable Velement   as character no-undo init "first".
     9363      define variable oTeg as character no-undo init ?.
     9364      define variable vteg as character no-undo.
     9365      define variable vtegval as character no-undo.
     9366      if     ((length(icodeIdent) eq 21
     9367         and not icodeIdent begins "01"
     9368         and not icodeIdent begins "02")
     9369         or
     9370             ( length(icodeIdent) eq 25
     9371               and not icodeIdent begins "01"
     9372               and not icodeIdent begins "02"))
     9373      then do:
     9374         if iTeg eq "01" or iTeg eq "02"
     9375         then
     9376            oTeg = substring(icodeIdent,1,21).
     9377         else  if  iTeg eq "21"
     9378         then
     9379            oTeg = substring(icodeIdent,15,7).
     9380      end.
     9381      else do:
     9382         ChekTypeMarkByDm(icodeIdent).
     9383         block-teg:
     9384            do while Velement ne "" and icodeIdent ne "":
     9385            Velement = GetNextElement(yes,output vteg, output vtegval, input-output icodeIdent).
     9386            if    Velement begins iTeg
     9387               or Velement begins "(" + iTeg + ")"
     9388            then do:
     9389               oTeg = vtegval.
     9390               leave block-teg.
     9391            end.
     9392         end.
     9393      end.
     9394      return oTeg.
     9395   end.
     9396   function isOAD return logical
     9397   (icodeIdent as character):
     9398      return length(icodeIdent) > 18 and GetTegCod(icodeIdent,"37") ne ? and GetTegCod(icodeIdent,"02") ne ?.
     9399   end.
     9400   function isMark return logical
     9401   (icodeIdent as character):
     9402      define buffer buf_marking for ub.marking.
     9403      return can-find(first buf_marking where buf_marking.mark begins icodeIdent) or
     9404             (length(icodeIdent) > 20 and not isOAD(icodeIdent)).
     9405   end.
     9406   function addBracketForCode return character
     9407   (icodeIdent as char):
     9408      define variable Velement   as character no-undo init "first".
     9409      define variable oTeg as character no-undo.
     9410      define variable vteg as character no-undo.
     9411      define variable vtegval as character no-undo.
     9412      define buffer marking for ub.marking.
     9413      find first marking no-lock where
     9414                 marking.mark begins icodeIdent no-error.
     9415      if    not ChekTypeMarkByDm(icodeIdent)
     9416         or length(icodeIdent) le 24
     9417         or (avail marking and marking.unit-ext = "LEVEL2")
     9418      then
     9419         oTeg = icodeIdent.
     9420      else do:
     9421         if (  icodeIdent begins "01"
     9422            or icodeIdent begins "02"
     9423            ) and CheckGtin(substring (icodeIdent,3,14))
     9424            and substring (icodeIdent,17,2) eq "21"
     9425         then do:
     9426            mMRCCode = yes.
     9427            ChekTypeMarkByDm(icodeIdent).
     9428            block-teg:
     9429            do while Velement ne "" and icodeIdent ne "":
     9430               Velement = GetNextElement(no,output vteg, output vtegval, input-output icodeIdent).
     9431               if vteg ne ""
     9432               then
     9433                  oTeg = oTeg + "(" + vteg + ")" + vtegval .
     9434            end.
     9435            mMRCCode = no.
     9436         end.
     9437         else do:
     9438            oTeg = icodeIdent.
     9439         end.
     9440      end.
     9441      return oTeg.
     9442   end.
     9443   function getlevelByCodId return int
     9444   (iCode as char):
     9445      define variable vLength as int no-undo.
     9446      define variable vLevel  as int no-undo.
     9447      if not ChekTypeMarkByDM (icode) then return ?.
     9448      vLength = length(iCode).
     9449      if    vLength eq 18
     9450         or vLength eq 20
     9451      then
     9452         Vlevel = 4.
     9453      else if vLength eq 21
     9454      then
     9455         Vlevel = 1.
     9456      else if vLength eq 25
     9457      then do:
     9458         if  iCode begins "01"
     9459         then
     9460            Vlevel = 3.
     9461         else
     9462            Vlevel = 1.
     9463      end.
     9464      else if     vLength >= 26
     9465              and vLength <= 46
     9466      then do:
     9467         if    substring(iCode,17,2) eq "11"
     9468            or substring(iCode,17,2) eq "13"
     9469            or (    substring(iCode,17,2) eq "21"
     9470                and vLength >= 33
     9471                and substring(iCode,26,4) ne "8005")
     9472         then
     9473            Vlevel = 4.
     9474         else if    vLength eq 31
     9475                 or vLength eq 38
     9476                 or vLength eq 39
     9477                 or vLength eq 45
     9478         then
     9479            Vlevel = 1.
     9480         else if    vLength eq 35
     9481                 or vLength eq 43
     9482         then
     9483            Vlevel = 3.
     9484         else
     9485            Vlevel = ?.
     9486      end.
     9487      else
     9488         Vlevel = ?.
     9489      return Vlevel.
     9490   end.
     9491   function getLevelMotpBycodid return character
     9492   (iDm as char):
     9493      define variable vLevel as integer no-undo.
     9494      define variable vList as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     9495      vLevel = getlevelByCodId(iDm).
     9496      if    vLevel eq ?
     9497         or vLevel < 1
     9498         or vLevel > 6
     9499      then
     9500         return ?.
     9501      else
     9502         return entry(vlevel,vList).
     9503   end.
     9504   function getLevelUTDByLevelMotp return character
     9505   (iUnit as char):
     9506      define variable vLevel as integer no-undo.
     9507      define variable vListMOTP    as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     9508      define variable vListutd as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     9509      vLevel = lookup(iUnit,vListMOTP).
     9510      if    vLevel eq ?
     9511         or vLevel < 1
     9512         or vLevel > 4
     9513      then
     9514         return ?.
     9515      else
     9516         return entry(vlevel,vListutd).
     9517   end.
     9518   function getLevelMotpByDM return character
     9519   (iDm as char):
     9520      return getLevelMotpByCodId(GetCodeIdent(iDm)).
     9521   end.
     9522   function getLevelUTDByCodId return character
     9523   (iDm as char):
     9524      define variable vLevel as integer no-undo.
     9525      define variable vList as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     9526      vLevel = getlevelByCodId(iDm).
     9527      if    vLevel eq ?
     9528         or vLevel < 1
     9529         or vLevel > 4
     9530      then
     9531         return ?.
     9532      else
     9533         return entry(vlevel,vList).
     9534   end.
     9535   function getLevelUTDByDM return character
     9536   (iDm as char):
     9537      return getLevelUTDByCodId(GetCodeIdent(iDm)).
     9538   end.
     9539   define variable mNotMarkQnty as logical no-undo.
     9540   function getQntyUTDByCodId return decimal
     9541   (iDM as char):
     9542      define variable vLevel as integer no-undo.
     9543      define variable vList as character no-undo init "1,5,10,500".
     9544      define variable vGtin as character no-undo.
     9545      define variable vqnty as decimal no-undo init ?.
     9546      vqnty = dec(GetTegCod(iDM,"37")) no-error.
     9547      if vqnty eq ?
     9548      then do:
     9549         if not mNotMarkQnty
     9550         then do:
     9551            define buffer marking for ub.marking.
     9552            define variable vCodident as character no-undo.
     9553            vCodident = GetCodeIdent(idm).
     9554            find first marking where marking.mark begins vCodident no-lock no-error.
     9555            if     available marking
     9556               and marking.box-qnty ne ?
     9557            then
     9558               return marking.box-qnty.
     9559         end.
     9560         vGtin = getGtinByDm(iDM).
     9561         if ChekTypeMarkByGtin (vGtin)
     9562         then do:
     9563            vLevel = getlevelByCodId(iDM).
     9564            if     vLevel >= 1
     9565               and vLevel <= 4
     9566            then
     9567               vqnty = int(entry(vlevel,vList)).
     9568         end.
     9569         else
     9570            vqnty = getQntyCodeByGtin(vgtin).
     9571      end.
     9572      return vqnty.
     9573   end.
     9574   function getQntyUTDByDM return decimal
     9575   (iDm as char):
     9576      define variable vDM as character no-undo.
     9577      if     length (iDm) ne 25
     9578         and length (iDm) ne 29
     9579         and substring (iDm,length (iDm) - 6 + 1, 2 ) eq "93"
     9580      then
     9581         vDM = substring (iDm,1,length (iDm) - 6 ).
     9582      else
     9583         vDM = substring (iDm,1,length (iDm) - 4 ).
     9584      return getQntyUTDByCodId(vDM).
     9585   end.
     9586   function getMRC4 return decimal
     9587   (iMRC as char):
     9588      define variable oMrc     as decimal no-undo init ?.
     9589      define variable vAlphabet as character no-undo init "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!~"%&'*+-./_,:;=<>?".
     9590      define variable vi       as integer no-undo.
     9591      define variable vfound   as integer no-undo.
     9592      define variable vposStart   as integer no-undo.
     9593      do:
     9594      OMRc = 0.
     9595      do vi = 1 to 4:
     9596         define variable vsimb as character no-undo.
     9597         vsimb = substring(iMRC,vi,1).
     9598         vposStart = if keycode("Z") < keycode(vsimb) then 27 else 1.
     9599         vfound = index(vAlphabet,vsimb,vposStart) - 1.
     9600         if vfound > 0
     9601         then
     9602            OMRc = OMRc + exp (80,(4 - vi) ) * vfound  .
     9603         end.
     9604         OMRc = OMRc / 100.
     9605      end.
     9606      return OMRc.
     9607   end.
     9608   function getMRCByDM return decimal
     9609   (iDm as char):
     9610      define variable vMRC     as character no-undo.
     9611      define variable oMrc     as decimal no-undo init ?.
     9612      define variable Velement as character no-undo init "empty".
     9613      define variable vteg as character no-undo.
     9614      define variable vtegval as character no-undo.
     9615      if    length(idm) eq 14 + 7 + 4 + 4
     9616         or length(idm) eq 14 + 7 + 4
     9617      then do:
     9618         vMRC = substring(idm,22,4).
     9619         omrc = getMRC4(vMRC).
     9620      end.
     9621      else do:
     9622          ChekTypeMarkByDm(iDm).
     9623          block-mrc:
     9624          do while Velement ne "" and idm ne "":
     9625             Velement = GetNextElement(yes,output vteg, output vtegval, input-output idm).
     9626             if Velement begins "8005"
     9627             then do:
     9628                vMRC = substring(Velement,5,6).
     9629                leave block-mrc.
     9630             end.
     9631             else if Velement begins "(8005)"
     9632             then do:
     9633                vMRC = substring(Velement,7,6).
     9634                leave block-mrc.
     9635             end.
     9636          end.
     9637          if vMRC ne ""
     9638          then
     9639             OMRc = dec(vmrc) / 100 no-error.
     9640      end.
     9641      return OMRc.
     9642   end.
     9643   function MoveDate return Date
     9644   (idate as date,
     9645    iMonth as int64):
     9646      define variable vMonth   as int64 no-undo.
     9647      define variable vYear    as int64 no-undo.
     9648      define variable vDateNew as date  no-undo.
     9649       define variable vDay     as int64 no-undo.
     9650       vMonth = month(iDate) + iMonth.
     9651       vYear =  year(iDate).
     9652       if vMonth <= 0
     9653       then assign
     9654          vMonth = vMonth + 12
     9655           vYear  = vYear - 1
     9656       .
     9657       else if vMonth > 12
     9658       then assign
     9659          vMonth = vMonth - 12
     9660           vYear  = vYear + 1
     9661       .
     9662       vDateNew = date(vMonth,day(iDate),vYear) no-error.
     9663       do while error-status:error eq yes:
     9664          VDay = vDay + 1.
     9665          vDateNew = date(vMonth,day(iDate) - vDay,vYear) no-error.
     9666       end.
     9667       if VDay > 0
     9668       then
     9669          vDateNew + 1.
     9670       return vDateNew.
     9671   end.
     9672   procedure checkEMRC:
     9673   define input  parameter iDm as character no-undo.
     9674   define output parameter vok as logical   no-undo init yes.
     9675      define variable v-value-emrc as character no-undo.
     9676      define variable v-type-emrc  as character no-undo.
     9677      define variable vDateIso     as character no-undo.
     9678      define variable vMRC         as decimal no-undo.
     9679      define variable vqnty        as decimal no-undo.
     9680      define variable vPrice       as decimal no-undo.
     9681      define variable vparent      as character no-undo.
     9682      define variable vgds-code    as integer no-undo.
     9683      define buffer code for ub.code.
     9684      vMRC = getMRCByDM(iDm).
     9685      if vMRC > 0
     9686      then do:
     9687         vgds-code = getGdsCodeByDM(iDm).
     9688         vqnty     = getQntyUTDByDM(iDm).
     9689               if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     9690            (
     9691             input   vgds-code
     9692            ,input   'emrc-type':U
     9693            ,output   v-value-emrc
     9694            ,output   v-type-emrc
     9695          ) no-error.
     9696          if     v-value-emrc ne ""
     9697             and v-value-emrc ne ?
     9698          then do:
     9699             vDateIso = iso-date(today).
     9700             vPrice = vMRC / vqnty.
     9701             vparent ="emc" + chr(4) + v-value-emrc.
     9702             find last code where Code.parent      eq vparent
     9703                              and Code.code        le vDateIso
     9704                              and code.status_  eq 0
     9705             no-lock no-error.
     9706             if not available code or ( vPrice  >= dec(Code.CodeValue))
     9707             then
     9708                vOk = true .
     9709             else do:
     9710                 define variable vText      as character no-undo.
     9711                 define variable vDate      as date no-undo.
     9712                 define variable vDateLast  as character no-undo.
     9713                 define variable vDateFirst as character no-undo.
     9714                 define variable vDate3     as date no-undo.
     9715                 vdate = date(code.misc1).
     9716                 vDateLast = code.misc1.
     9717                 vDate3 = MoveDate(today, - 3 ).
     9718                 vText =  substitute ("ТОВАР ИМЕЕТ ОГРАНИЧЕННЫЙ СРОК РЕАЛИЗАЦИИ. Если товар произведен после &2, то его приемка и продажа запрещена.",
     9719                                      string(vDate3  , "99/99/9999"),
     9720                                      string(vDate   , "99/99/9999")
     9721                                      ).
     9722                 vdateIso = iso-date(vdate3).
     9723                 find last code  where Code.parent      eq vparent
     9724                                   and Code.code        le vDateIso
     9725                                   and code.status_  eq 0 no-lock no-error.
     9726                 if available code
     9727                 then
     9728                    vDateIso = code.code.
     9729                 vDateFirst = vDateIso.
     9730                 vDateLast = iso-date(vdate).
     9731                 define variable vGood as logical no-undo.
     9732                 define variable vDateSale as date no-undo.
     9733                 define buffer bcode for code.
     9734                 for last code where Code.parent   eq vparent
     9735                                 and code.status_  eq 0
     9736                                 and code.code     < vDateLast
     9737                                 and code.code     >= vDateFirst
     9738                 no-lock:
     9739                    find first bcode where bCode.parent   eq vparent
     9740                                       and bcode.status_  eq 0
     9741                                       and bcode.code     > code.code no-lock no-error.
     9742                    if available bcode
     9743                    then do:
     9744                       if vPrice < dec(Code.CodeValue)
     9745                       then
     9746                          vText = vtext + substitute ("&1Если товар произведен с &2 до &3, ТО ЕГО ПРИЕМКА И ПРОДАЖА ЗАПРЕЩЕНА",
     9747                                                     chr(10),
     9748                                                     string(    date( code.misc1)       ,"99/99/9999"),
     9749                                                     string(    date(bcode.misc1)       ,"99/99/9999")
     9750                                                     ).
     9751                       else do:
     9752                          vGood = yes.
     9753                          vDateSale = MoveDate(date(bcode.misc1), 3) - 1.
     9754                          vText = vtext + substitute ("&1Если товар произведен до &3, то продажа разрешена до &4.~Осталось &5 дней.",
     9755                                                     chr(10),
     9756                                                     string(    date( code.misc1)         ,"99/99/9999"),
     9757                                                     string(    date(bcode.misc1)         ,"99/99/9999"),
     9758                                                     string(         vDateSale            ,"99/99/9999"),
     9759                                                     string(vDateSale - today)
     9760                                                     ).
     9761                       end.
     9762                    end.
     9763                 end.
     9764                 if vgood
     9765                 then do:
     9766                    define variable choice as integer no-undo .
     9767                    run gbl/d-askw.w (input "Уточнение"
     9768                           ,input  vText
     9769                           ,input "|"
     9770                           ,input "Принять|Вернуть"
     9771                           ,input "Принять данный товар|Вернуть товар постащику"
     9772                           ,input 1
     9773                           ,input 2
     9774                           ,output choice) no-error.
     9775                    vok = choice eq 1.
     9776                 end.
     9777                 else
     9778                    vok =false.
     9779             end.
     9780          end.
     9781      end.
     9782   end.
     9783   function addGs2Mark return character
     9784   (iMark as char):
     9785      define variable vDM   as character no-undo.
     9786      define variable vIdx  as integer   no-undo.
     9787      if index(iMark,chr(29),1) > 0
     9788      then return iMark.
     9789      if substring(iMark,26,4) = "8005" then
     9790      do:
     9791        vIdx = index(iMark,"93",26 + 4 + 5).
     9792        if vIdx > 1 then do:
     9793          vDM = substitute("&1&4&2&4&3",
     9794                           substring(iMark,1,25),
     9795                           substring(iMark,26,vIdx - 25 - 1),
     9796                           substring(iMark,vIdx),
     9797                           chr(29)) no-error.
     9798          vIdx = index(vDm,"240",vIdx + 4).
     9799          if vIdx > 0 then
     9800          do:
     9801            vDM = substitute("&1&3&2",
     9802                             substring(vDm,1,vIdx - 1),
     9803                             substring(vDm,vIdx),
     9804                             chr(29)) no-error.
     9805          end.
     9806        end.
     9807        else
     9808          vDM = substitute("&1&3&2",
     9809                           substring(iMark,1,25),
     9810                           substring(iMark,26),
     9811                           chr(29)) no-error.
     9812      end.
     9813      else if substring(iMark,32,2) = "91" then
     9814      do:
     9815        vIdx = index(iMark,"92",32).
     9816        if vIdx > 1 then
     9817          vDM = substitute("&1&4&2&4&3",
     9818                           substring(iMark,1,31),
     9819                           substring(iMark,32,vIdx - 31 - 1),
     9820                           substring(iMark,vIdx),
     9821                           chr(29)) no-error.
     9822        else
     9823          vDM = substitute("&1&3&2",
     9824                           substring(iMark,1,31),
     9825                           substring(iMark,32),
     9826                           chr(29)) no-error.
     9827      end.
     9828      else if substring(iMark,39,2) = "91" then
     9829      do:
     9830        vIdx = index(iMark,"92",38).
     9831        if vIdx > 1 then
     9832          vDM = substitute("&1&4&2&4&3",
     9833                           substring(iMark,1,38),
     9834                           substring(iMark,39,vIdx - 38 - 1),
     9835                           substring(iMark,vIdx),
     9836                           chr(29)) no-error.
     9837        else
     9838          vDM = substitute("&1&3&2",
     9839                           substring(iMark,1,38),
     9840                           substring(iMark,39),
     9841                           chr(29)) no-error.
     9842      end.
     9843      else if substring(iMark,25,2) = "93" then
     9844      do:
     9845        vIdx = index(iMark,"92",25).
     9846        if vIdx > 1 then
     9847          vDM = substitute("&1&4&2&4&3",
     9848                           substring(iMark,1,24),
     9849                           substring(iMark,25,vIdx - 24 - 1),
     9850                           substring(iMark,vIdx),
     9851                           chr(29)) no-error.
     9852        else
     9853          vIdx = index(iMark,"3103",25).
     9854          if vIdx > 0 then
     9855          vDM = substitute("&1&4&2&4&3",
     9856                           substring(iMark,1,24),
     9857                           substring(iMark,25,vIdx - 24 - 1),
     9858                           substring(iMark,vIdx),
     9859                           chr(29)) no-error.
     9860          else
     9861            vDM = substitute("&1&3&2",
     9862                             substring(iMark,1,24),
     9863                             substring(iMark,25),
     9864                             chr(29)) no-error.
     9865      end.
     9866      else if substring(iMark,32,2) = "93" then
     9867      do:
     9868        vDM = substitute("&1&3&2",
     9869              substring(iMark,1,31),
     9870              substring(iMark,32),
     9871              chr(29)) no-error.
     9872      end.
     9873      return if vDM <> "" then vDm else iMark.
     9874   end.
     9875   define temp-table wt-marking no-undo like ub.marking.
     9876   PROCEDURE proc-load-marking:
     9877     define input parameter p-imp-handle as handle  no-undo.
     9878     define input parameter p-pck-num    as integer no-undo.
     9879     define input parameter l-counter    as integer no-undo.
     9880     do
     9881     on error  undo, return error substitute( "$proc-load-marking. &1&2&3", return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     9882     on stop   undo, return error substitute( "$proc-load-marking. stop" )
     9883     on endkey undo, return error substitute( "$proc-load-marking. endkey" )
     9884     :
     9885       define buffer tb-marking for ub.marking.
     9886       define variable compare-log as logical no-undo.
     9887       define variable gtin as character no-undo.
     9888       for each wt-marking
     9889       on error undo, return error substitute( "$proc-load-marking(del-wt-). &1&2&3", return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     9890       :
     9891         delete wt-marking .
     9892       end.
     9893       create wt-marking.
     9894       run nws-impl in p-imp-handle
     9895         ( input 'marking':U
     9896          ,input (buffer wt-marking:handle)
     9897         ) no-error.
     9898       if error-status :error then do:
     9899         return error return-value .
     9900       end.
     9901       find first tb-marking
     9902         where tb-marking.mark = wt-marking.mark
     9903         exclusive-lock no-error.
     9904       if l-counter <> 0 then do:
     9905         return error substitute( "&1 &2. Ошибка обработки записи &3", vss-workfile, vss-revision, 'marking':U )
     9906                      + chr(10) + "Есть привязанные записи, а обработка идет для одной".
     9907       end.
     9908       if not available tb-marking then do:
     9909         create tb-marking.
     9910         assign compare-log = no.
     9911       end.
     9912       else do:
     9913         buffer-compare tb-marking TO wt-marking case-sensitive save result in compare-log no-error.
     9914       end.
     9915       if not compare-log then do:
     9916         buffer-copy wt-marking TO tb-marking.
     9917       end.
     9918       delete wt-marking.
     9919     end.
     9920   END PROCEDURE.
     9921   define temp-table locb-ord-gds-cons      no-undo like ub.ord-gds-cons.
     9922   define temp-table locb-ord-dtl-cons      no-undo like ub.ord-dtl-cons.
     9923   define temp-table wt-ord-cons no-undo like ub.ord-cons.
     9924   PROCEDURE proc-load-ord-cons:
     9925     define input parameter p-imp-handle as handle  no-undo.
     9926     define input parameter p-pck-num    as integer no-undo.
     9927     define input parameter l-counter    as integer no-undo.
     9928     do
     9929     on error  undo, return error substitute( "$proc-load-ord-cons. &1&2&3", return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     9930     on stop   undo, return error substitute( "$proc-load-ord-cons. stop" )
     9931     on endkey undo, return error substitute( "$proc-load-ord-cons. endkey" )
     9932     :
     9933       define buffer tb-ord-cons for ub.ord-cons.
     9934       define variable compare-log as logical no-undo.
     9935   define variable vss-include-info111 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9936   define buffer buf_ord-gds-cons      for ub.ord-gds-cons.
     9937   define buffer buf_ord-dtl-cons      for ub.ord-dtl-cons.
     9938   def var counter  as integer   no-undo.
     9939   def var rec-full as character no-undo.
     9940   def var rec-name as character no-undo.
     9941   for each locb-ord-gds-cons
     9942   on error  undo, return error
     9943   on stop   undo, return error
     9944   on endkey undo, return error :
     9945     delete locb-ord-gds-cons.
     9946   end.
     9947   for each locb-ord-dtl-cons
     9948   on error  undo, return error
     9949   on stop   undo, return error
     9950   on endkey undo, return error :
     9951     delete locb-ord-dtl-cons.
     9952   end.
     9953       for each wt-ord-cons
     9954       on error undo, return error substitute( "$proc-load-ord-cons(del-wt-). &1&2&3", return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     9955       :
     9956         delete wt-ord-cons .
     9957       end.
     9958       create wt-ord-cons.
     9959       run nws-impl in p-imp-handle
     9960         ( input 'ord-cons':U
     9961          ,input (buffer wt-ord-cons:handle)
     9962         ) no-error.
     9963       if error-status :error then do:
     9964         return error return-value .
     9965       end.
     9966       find first tb-ord-cons
     9967         where tb-ord-cons.cons-code = wt-ord-cons.cons-code
     9968         exclusive-lock no-error.
     9969   define variable vss-include-info112 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9970   DO counter = 1 TO l-counter
     9971   on error  undo, return error
     9972   on endkey undo, return error :
     9973   run nws-imps in p-imp-handle
     9974     ( input-output counter
     9975      ,output       rec-full
     9976     ) no-error.
     9977   if error-status :error then do:
     9978     return error substitute( "&1&2&3", return-value, chr(10), error-status :get-message(1) ) .
     9979   end.
     9980     assign
     9981       rec-name = entry( 1, rec-full, chr(1) )
     9982       .
     9983     CASE rec-name :
     9984       when "ord-gds-cons" then do:
     9985         create locb-ord-gds-cons.
     9986   run nws-impl in p-imp-handle
     9987     ( input "ord-gds-cons":U
     9988      ,input (buffer locb-ord-gds-cons:handle)
     9989     ) no-error.
     9990   if error-status :error then do:
     9991     return error substitute( "&1&2&3", return-value, chr(10), error-status :get-message(1) ) .
     9992   end.
     9993       end.
     9994       when "ord-dtl-cons" then do:
     9995         create locb-ord-dtl-cons.
     9996   run nws-impl in p-imp-handle
     9997     ( input "ord-dtl-cons":U
     9998      ,input (buffer locb-ord-dtl-cons:handle)
     9999     ) no-error.
    10000   if error-status :error then do:
    10001     return error substitute( "&1&2&3", return-value, chr(10), error-status :get-message(1) ) .
    10002   end.
    10003       end.
    10004       otherwise do:
    10005         message "Не предусмотрен прием таблицы " rec-name skip
    10006                 "в составе савокупных заявок."
    10007                 view-as alert-box error.
    10008         return error.
    10009       end.
    10010     END CASE.
    10011   end.
    10012   for each buf_ord-gds-cons where buf_ord-gds-cons.cons-code = wt-ord-cons.cons-code
    10013   on error  undo, return error
    10014   on stop   undo, return error
    10015   on endkey undo, return error :
    10016     delete buf_ord-gds-cons.
    10017   end.
    10018   for each locb-ord-gds-cons where locb-ord-gds-cons.cons-code = wt-ord-cons.cons-code
    10019                          no-lock
    10020   on error  undo, return error
    10021   on stop   undo, return error
    10022   on endkey undo, return error :
    10023     create buf_ord-gds-cons.
    10024     buffer-copy locb-ord-gds-cons to buf_ord-gds-cons.
    10025   end.
    10026   for each buf_ord-dtl-cons where buf_ord-dtl-cons.cons-code = wt-ord-cons.cons-code
    10027   on error  undo, return error
    10028   on stop   undo, return error
    10029   on endkey undo, return error :
    10030     delete buf_ord-dtl-cons.
    10031   end.
    10032   for each locb-ord-dtl-cons where locb-ord-dtl-cons.cons-code = wt-ord-cons.cons-code
    10033                         no-lock
    10034   on error  undo, return error
    10035   on stop   undo, return error
    10036   on endkey undo, return error :
    10037     create buf_ord-dtl-cons.
    10038     buffer-copy locb-ord-dtl-cons to buf_ord-dtl-cons.
    10039   end.
    10040   if not available tb-ord-cons then do:
    10041     create tb-ord-cons.
    10042   end.
    10043   define variable v-old-ord-cons-status as character no-undo .
    10044   define variable v-new-ord-cons-status as character no-undo .
    10045   if tb-ord-cons.status_ = ""
    10046   or tb-ord-cons.status_ = ?
    10047   then do:
    10048     assign
    10049       v-old-ord-cons-status = ""
    10050     .
    10051   end.
    10052   else do:
    10053     assign
    10054       v-old-ord-cons-status = tb-ord-cons.status_ + string(tb-ord-cons.flag_, '+/-':u)
    10055     .
    10056   end.
    10057   assign
    10058     v-new-ord-cons-status = wt-ord-cons.status_ + string(wt-ord-cons.flag_, '+/-':u)
    10059   .
    10060   run trg/nwsdochs.p
    10061     (input g#db-num
    10062     ,input 'update':U
    10063     ,input wt-ord-cons.cons-code
    10064     ,input wt-ord-cons.input-obj-type
    10065     ,input wt-ord-cons.input-obj-code
    10066     ,input 'ord-cons':U
    10067     ,input '':u
    10068     ,input wt-ord-cons.fact-date
    10069     ,input 0
    10070     ,input 0
    10071     ,input 0
    10072     ,input 0
    10073     ,input v-old-ord-cons-status
    10074     ,input v-new-ord-cons-status
    10075     ,input g#news-source-db
    10076     ,input p-pck-num
    10077     ,input wt-ord-cons.user-db-num
    10078     ,input wt-ord-cons.user-name
    10079     ,input wt-ord-cons.sys-date
    10080     ,input wt-ord-cons.sys-time
    10081     ,input wt-ord-cons.sys-time-int
    10082     ) no-error .
    10083   if error-status :error then do:
    10084     run write-to-log in this-procedure
    10085       (input substitute("&1 &2", error-status :get-message(1), return-value )
    10086       ) .
    10087     undo, return error .
    10088   end.
    10089   buffer-copy wt-ord-cons to tb-ord-cons.
    10090   for each locb-ord-gds-cons
    10091   on error  undo, return error
    10092   on stop   undo, return error
    10093   on endkey undo, return error :
    10094     delete locb-ord-gds-cons.
    10095   end.
    10096   for each locb-ord-dtl-cons
    10097   on error  undo, return error
    10098   on stop   undo, return error
    10099   on endkey undo, return error :
    10100     delete locb-ord-dtl-cons.
    10101   end.
    10102       delete wt-ord-cons.
    10103     end.
    10104   END PROCEDURE.
    10105   define temp-table locb-ord-line      no-undo like ub.ord-line.
    10106   define temp-table locb-ord-line-attr no-undo like ub.ord-line-attr.
