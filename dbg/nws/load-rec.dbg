     7780      for each buf_c-chk-discnt where buf_c-chk-discnt.doc-code = locb-c-chk-doc.doc-code:
     7781        delete buf_c-chk-discnt.
     7782      end.
     7783      for each buf_c-chk-doc-attr where buf_c-chk-doc-attr.doc-code = locb-c-chk-doc.doc-code:
