     4045   define temp-table wt-ext-classif no-undo like ub.ext-classif.
     4046   PROCEDURE proc-load-ext-classif:
     4047     define input parameter p-imp-handle as handle  no-undo.
     4048     define input parameter p-pck-num    as integer no-undo.
     4049     define input parameter l-counter    as integer no-undo.
     4050     do
     4051     on error  undo, return error substitute( "$proc-load-ext-classif. &1&2&3", return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     4052     on stop   undo, return error substitute( "$proc-load-ext-classif. stop" )
     4053     on endkey undo, return error substitute( "$proc-load-ext-classif. endkey" )
     4054     :
     4055       define buffer tb-ext-classif for ub.ext-classif.
     4056       define variable compare-log as logical no-undo.
     4057       for each wt-ext-classif
     4058       on error undo, return error substitute( "$proc-load-ext-classif(del-wt-). &1&2&3", return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     4059       :
     4060         delete wt-ext-classif .
     4061       end.
     4062       create wt-ext-classif.
     4063       run nws-impl in p-imp-handle
     4064         ( input 'ext-classif':U
     4065          ,input (buffer wt-ext-classif:handle)
     4066         ) no-error.
     4067       if error-status :error then do:
     4068         return error return-value .
     4069       end.
     4070       find first tb-ext-classif
     4071         where tb-ext-classif.classif-subject = wt-ext-classif.classif-subject
     4072           and tb-ext-classif.classif-name = wt-ext-classif.classif-name
     4073           and tb-ext-classif.db-num = wt-ext-classif.db-num
     4074           and tb-ext-classif.Key#_One = wt-ext-classif.Key#_One
     4075           and tb-ext-classif.Key#_Two = wt-ext-classif.Key#_Two
     4076           and tb-ext-classif.Key#_Three = wt-ext-classif.Key#_Three
     4077           and tb-ext-classif.CharKey_One = wt-ext-classif.CharKey_One
     4078           and tb-ext-classif.CharKey_Two = wt-ext-classif.CharKey_Two
     4079           and tb-ext-classif.CharKey_Three = wt-ext-classif.CharKey_Three
     4080           and tb-ext-classif.nonunique = wt-ext-classif.nonunique
     4081         exclusive-lock no-error.
     4082   define variable vss-include-info56 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4083   if not available tb-ext-classif then do:
     4084     create tb-ext-classif.
     4085     assign compare-log = no.
     4086   end.
     4087   else do:
     4088     buffer-compare tb-ext-classif TO wt-ext-classif case-sensitive save result in compare-log no-error.
     4089   end.
     4090   if not compare-log then do:
     4091     buffer-copy wt-ext-classif TO tb-ext-classif.
     4092      if wt-ext-classif.classif-subject = "goods" and wt-ext-classif.classif-name = "exp-esys-gds-code" then do:
     4093      run fill-ext-classif in p-imp-handle (input tb-ext-classif.db-num
     4094         ,input tb-ext-classif.Key#_One
     4095         ,input tb-ext-classif.Key#_Two
     4096         ,input tb-ext-classif.CharKey_One
     4097         ).
