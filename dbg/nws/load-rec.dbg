    17593   for each buf_tnv-in-turnover-group where buf_tnv-in-turnover-group.tog-id     = wt-turnover-group.tog-id
    17594                                     and buf_tnv-in-turnover-group.tog-db-num = wt-turnover-group.tog-db-num
    17595   on error  undo, return error
    17596   :
    17597     delete buf_tnv-in-turnover-group.
    17598   end.
    17599   for each locb-tnv-in-turnover-group where locb-tnv-in-turnover-group.tog-id     = wt-turnover-group.tog-id
    17600                                       and locb-tnv-in-turnover-group.tog-db-num = wt-turnover-group.tog-db-num
    17601   no-lock
    17602   on error  undo, return error
    17603   :
    17604     create buf_tnv-in-turnover-group.
    17605     buffer-copy locb-tnv-in-turnover-group to buf_tnv-in-turnover-group.
    17606   end.
    17607   for each buf_c-tnv-in-turnover-group where buf_c-tnv-in-turnover-group.tog-id     = wt-turnover-group.tog-id
    17608                                     and buf_c-tnv-in-turnover-group.tog-db-num = wt-turnover-group.tog-db-num
    17609   on error  undo, return error
    17610   :
    17611     delete buf_c-tnv-in-turnover-group.
    17612   end.
    17613   for each locb-c-tnv-in-turnover-group where locb-c-tnv-in-turnover-group.tog-id = wt-turnover-group.tog-id
    17614                                       and locb-c-tnv-in-turnover-group.tog-db-num = wt-turnover-group.tog-db-num
    17615   no-lock
    17616   on error  undo, return error
    17617   :
    17618     create buf_c-tnv-in-turnover-group.
    17619     buffer-copy locb-c-tnv-in-turnover-group to buf_c-tnv-in-turnover-group.
    17620   end.
    17621   if not available tb-turnover-group then do:
    17622     create tb-turnover-group.
    17623   end.
    17624   buffer-copy wt-turnover-group to tb-turnover-group.
    17625   for each locb-c-turnover-group
    17626   on error  undo, return error
    17627   :
    17628     delete locb-c-turnover-group.
    17629   end.
    17630   for each locb-tnv-in-turnover-group
    17631   on error  undo, return error
    17632   :
    17633     delete locb-tnv-in-turnover-group.
    17634   end.
    17635   for each locb-c-tnv-in-turnover-group
    17636   on error  undo, return error
    17637   :
    17638     delete locb-c-tnv-in-turnover-group.
    17639   end.
    17640       delete wt-turnover-group.
    17641     end.
    17642   END PROCEDURE.
    17643   define temp-table locb-wth-line      no-undo like ub.wth-line.
    17644   define temp-table locb-wth-dtl       no-undo like ub.wth-dtl.
    17645   define temp-table locb-wth-parts     no-undo like ub.wth-parts.
    17646   define temp-table locb-wth-doc-attr  no-undo like ub.wth-doc-attr.
    17647   define temp-table locbw-chk-doc       no-undo like ub.chk-doc.
    17648   define temp-table locbw-chk-pay       no-undo like ub.chk-pay.
    17649   define temp-table locbw-c-chk-doc     no-undo like ub.c-chk-doc.
    17650   define temp-table locbw-c-chk-pay     no-undo like ub.c-chk-pay.
    17651   define temp-table locbw-c-wth-doc    no-undo like ub.c-wth-doc.
    17652   define temp-table locbw-c-wth-line   no-undo like ub.c-wth-line.
    17653   define temp-table locbw-c-wth-dtl    no-undo like ub.c-wth-dtl.
    17654   define temp-table locbw-c-wth-parts  no-undo like ub.c-wth-parts.
    17655   define temp-table locbw-inkas-pay-wth  no-undo like ub.inkas-pay-wth.
    17656   define temp-table locbw-c-inkas-pay-wth  no-undo like ub.c-inkas-pay-wth.
    17657   define temp-table wt-wth-doc no-undo like ub.wth-doc.
    17658   PROCEDURE proc-load-wth-doc:
    17659     define input parameter p-imp-handle as handle  no-undo.
    17660     define input parameter p-pck-num    as integer no-undo.
    17661     define input parameter l-counter    as integer no-undo.
    17662     do
    17663     on error  undo, return error substitute( "$proc-load-wth-doc. &1&2&3", return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    17664     on stop   undo, return error substitute( "$proc-load-wth-doc. stop" )
    17665     on endkey undo, return error substitute( "$proc-load-wth-doc. endkey" )
    17666     :
    17667       define buffer tb-wth-doc for ub.wth-doc.
    17668       define variable compare-log as logical no-undo.
    17669   define variable vss-include-info186 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    17670   define buffer buf_wth-line      for ub.wth-line.
    17671   define buffer buf_wth-dtl       for ub.wth-dtl.
    17672   define buffer buf_chk-doc     for ub.chk-doc.
    17673   define buffer buf_chk-pay      for ub.chk-pay.
    17674   define buffer buf_wth-parts     for ub.wth-parts.
    17675   define buffer buf_wth-doc-attr  for ub.wth-doc-attr.
    17676   define buffer buf_c-chk-doc   for ub.c-chk-doc.
    17677   define buffer buf_c-chk-pay    for ub.c-chk-pay.
    17678   define buffer buf_c-wth-doc     for ub.c-wth-doc.
    17679   define buffer buf_c-wth-line    for ub.c-wth-line.
    17680   define buffer buf_c-wth-dtl     for ub.c-wth-dtl.
    17681   define buffer buf_c-wth-parts   for ub.c-wth-parts.
    17682   define buffer buf_inkas-pay-wth   for ub.inkas-pay-wth.
    17683   define buffer buf_c-inkas-pay-wth   for ub.c-inkas-pay-wth.
    17684   define variable counter  as integer   no-undo.
    17685   define variable rec-full as character no-undo.
    17686   define variable rec-name as character no-undo.
    17687   for each locb-wth-line
    17688   on error undo, return error error-status :get-message (1)
    17689   :
    17690     delete locb-wth-line.
    17691   end.
    17692   for each locb-wth-dtl
    17693   on error undo, return error error-status :get-message (1)
    17694   :
    17695     delete locb-wth-dtl.
    17696   end.
    17697   for each locb-wth-parts
    17698   on error undo, return error error-status :get-message (1)
    17699   :
    17700     delete locb-wth-parts.
    17701   end.
    17702   for each locb-wth-doc-attr
    17703   on error undo, return error error-status :get-message (1)
    17704   :
    17705     delete locb-wth-doc-attr.
    17706   end.
    17707   for each locb-chk-doc
    17708   on error undo, return error error-status :get-message (1)
    17709   :
    17710     delete locb-chk-doc.
    17711   end.
    17712   for each locb-chk-pay
    17713   on error undo, return error error-status :get-message (1)
    17714   :
    17715     delete locb-chk-pay.
    17716   end.
    17717   for each locb-c-chk-doc
    17718   on error undo, return error error-status :get-message (1)
    17719   :
    17720     delete locb-c-chk-doc.
    17721   end.
    17722   for each locb-c-chk-pay
    17723   on error undo, return error error-status :get-message (1)
    17724   :
    17725     delete locb-c-chk-pay.
    17726   end.
    17727   for each locbw-c-wth-doc
    17728   on error undo, return error error-status :get-message (1)
    17729   :
    17730     delete locbw-c-wth-doc.
    17731   end.
    17732   for each locbw-c-wth-line
    17733   on error undo, return error error-status :get-message (1)
    17734   :
    17735     delete locbw-c-wth-line.
    17736   end.
    17737   for each locbw-c-wth-dtl
    17738   on error undo, return error error-status :get-message (1)
    17739   :
    17740     delete locbw-c-wth-dtl.
    17741   end.
    17742   for each locbw-c-wth-parts
    17743   on error undo, return error error-status :get-message (1)
    17744   :
    17745     delete locbw-c-wth-parts.
    17746   end.
    17747   for each locbw-inkas-pay-wth
    17748   on error undo, return error error-status :get-message (1)
    17749   :
    17750     delete locbw-inkas-pay-wth.
    17751   end.
    17752   for each locbw-c-inkas-pay-wth
    17753   on error undo, return error error-status :get-message (1)
    17754   :
    17755     delete locbw-c-inkas-pay-wth.
    17756   end.
    17757       for each wt-wth-doc
    17758       on error undo, return error substitute( "$proc-load-wth-doc(del-wt-). &1&2&3", return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    17759       :
    17760         delete wt-wth-doc .
    17761       end.
    17762       create wt-wth-doc.
    17763       run nws-impl in p-imp-handle
    17764         ( input 'wth-doc':U
    17765          ,input (buffer wt-wth-doc:handle)
    17766         ) no-error.
    17767       if error-status :error then do:
    17768         return error return-value .
    17769       end.
    17770       find first tb-wth-doc
    17771         where tb-wth-doc.doc-code = wt-wth-doc.doc-code
    17772         exclusive-lock no-error.
    17773   define variable vss-include-info187 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    17774   DO counter = 1 TO l-counter
    17775   on error  undo, return error
    17776   on endkey undo, return error :
    17777   run nws-imps in p-imp-handle
    17778     ( input-output counter
    17779      ,output       rec-full
    17780     ) no-error.
    17781   if error-status :error then do:
    17782     return error substitute( "&1&2&3", return-value, chr(10), error-status :get-message(1) ) .
    17783   end.
    17784     assign
    17785       rec-name = entry( 1, rec-full, chr(1) )
    17786       .
    17787     CASE rec-name :
    17788       when "wth-line" then do:
    17789         create locb-wth-line.
    17790   run nws-impl in p-imp-handle
    17791     ( input "wth-line":U
    17792      ,input (buffer locb-wth-line:handle)
