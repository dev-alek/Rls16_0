    17803     ) no-error.
    17804   if error-status :error then do:
    17805     return error substitute( "&1&2&3", return-value, chr(10), error-status :get-message(1) ) .
    17806   end.
    17807       end.
    17808       when "wth-parts" then do:
    17809         create locb-wth-parts.
    17810   run nws-impl in p-imp-handle
    17811     ( input "wth-parts":U
    17812      ,input (buffer locb-wth-parts:handle)
    17813     ) no-error.
    17814   if error-status :error then do:
