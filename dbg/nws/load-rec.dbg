     6787   run nws-impl in p-imp-handle
     6788     ( input "host-grp-obj-price":U
     6789      ,input (buffer locb-host-grp-obj-price:handle)
     6790     ) no-error.
     6791   if error-status :error then do:
     6792     return error substitute( "&1&2&3", return-value, chr(10), error-status :get-message(1) ) .
     6793   end.
     6794       end.
     6795       when "obj-grp-obj-price" then do:
