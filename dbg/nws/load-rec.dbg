     1882       end.
     1883       create wt-bar-code.
     1884       run nws-impl in p-imp-handle
     1885         ( input 'bar-code':U
     1886          ,input (buffer wt-bar-code:handle)
     1887         ) no-error.
     1888       if error-status :error then do:
     1889         return error return-value .
     1890       end.
     1891       find first tb-bar-code
     1892         where tb-bar-code.b-code = wt-bar-code.b-code
     1893         exclusive-lock no-error.
     1894   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1895   run create-bar-code in p-imp-handle
     1896     ( input wt-bar-code.b-code
     1897      ,input wt-bar-code.cli-base-rate
     1898      ,input wt-bar-code.gds-code
     1899      ,input wt-bar-code.in-code
     1900      ,input wt-bar-code.node-code
     1901      ,input wt-bar-code.part-code
     1902      ,input wt-bar-code.unit-cli
     1903      ,input wt-bar-code.cr-db-num
     1904     ).
     1905       delete wt-bar-code.
     1906     end.
     1907   END PROCEDURE.
