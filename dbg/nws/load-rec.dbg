     5876     on stop   undo, return error substitute( "$proc-load-gds-obj. stop" )
     5877     on endkey undo, return error substitute( "$proc-load-gds-obj. endkey" )
     5878     :
     5879       define buffer tb-gds-obj for ub.gds-obj.
     5880       define variable compare-log as logical no-undo.
     5881       for each wt-gds-obj
     5882       on error undo, return error substitute( "$proc-load-gds-obj(del-wt-). &1&2&3", return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     5883       :
     5884         delete wt-gds-obj .
     5885       end.
     5886       create wt-gds-obj.
     5887       run nws-impl in p-imp-handle
     5888         ( input 'gds-obj':U
     5889          ,input (buffer wt-gds-obj:handle)
     5890         ) no-error.
     5891       if error-status :error then do:
     5892         return error return-value .
     5893       end.
     5894       find first tb-gds-obj
     5895         where tb-gds-obj.obj-type = wt-gds-obj.obj-type
     5896           and tb-gds-obj.obj-code = wt-gds-obj.obj-code
     5897           and tb-gds-obj.artic = wt-gds-obj.artic
     5898           and tb-gds-obj.prod-type = wt-gds-obj.prod-type
     5899           and tb-gds-obj.prod-code = wt-gds-obj.prod-code
     5900         exclusive-lock no-error.
     5901   define variable vss-include-info84 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5902   run update-service-price in this-procedure
     5903     (input wt-gds-obj.obj-type
     5904     ,input wt-gds-obj.obj-code
     5905     ,input wt-gds-obj.artic
     5906     ,input wt-gds-obj.prod-type
     5907     ,input wt-gds-obj.prod-code
     5908     ,input wt-gds-obj.price-base
     5909     ,input wt-gds-obj.price-rubl
     5910     ) .
     5911       delete wt-gds-obj.
     5912     end.
     5913   END PROCEDURE.
     5914   define variable vss-include-info85 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5915   define temp-table locb-gds-obj-attr      no-undo like ub.gds-obj-attr.
     5916   define temp-table wt-gds-obj-attr no-undo like ub.gds-obj-attr.
     5917   PROCEDURE proc-load-gds-obj-attr:
     5918     define input parameter p-imp-handle as handle  no-undo.
     5919     define input parameter p-pck-num    as integer no-undo.
     5920     define input parameter l-counter    as integer no-undo.
     5921     do
     5922     on error  undo, return error substitute( "$proc-load-gds-obj-attr. &1&2&3", return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     5923     on stop   undo, return error substitute( "$proc-load-gds-obj-attr. stop" )
     5924     on endkey undo, return error substitute( "$proc-load-gds-obj-attr. endkey" )
     5925     :
     5926       define buffer tb-gds-obj-attr for ub.gds-obj-attr.
     5927       define variable compare-log as logical no-undo.
     5928   define variable vss-include-info86 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5929   define variable v-type           as character no-undo .
     5930   define variable v-format         as character no-undo .
     5931   define variable v-label          as character no-undo .
     5932   define variable v-user-can-edit  as logical   no-undo .
     5933   define variable v-output-display as logical   no-undo .
     5934   define variable v-other          as character no-undo .
     5935   define variable jj as integer no-undo .
     5936   define variable v-dop1 as character no-undo .
     5937   define variable v-dop2 as character no-undo .
     5938   define buffer buf_goods for ub.goods.
     5939   for each locb-gds-obj-attr
     5940   on error undo, return error error-status :get-message (1)
     5941   :
     5942     delete locb-gds-obj-attr.
     5943   end.
     5944       for each wt-gds-obj-attr
     5945       on error undo, return error substitute( "$proc-load-gds-obj-attr(del-wt-). &1&2&3", return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     5946       :
     5947         delete wt-gds-obj-attr .
     5948       end.
     5949       create wt-gds-obj-attr.
     5950       run nws-impl in p-imp-handle
     5951         ( input 'gds-obj-attr':U
     5952          ,input (buffer wt-gds-obj-attr:handle)
     5953         ) no-error.
     5954       if error-status :error then do:
     5955         return error return-value .
     5956       end.
     5957       find first tb-gds-obj-attr
     5958         where tb-gds-obj-attr.obj-type = wt-gds-obj-attr.obj-type
     5959           and tb-gds-obj-attr.obj-code = wt-gds-obj-attr.obj-code
     5960           and tb-gds-obj-attr.gds-code = wt-gds-obj-attr.gds-code
     5961           and tb-gds-obj-attr.attr-code = wt-gds-obj-attr.attr-code
     5962         exclusive-lock no-error.
     5963   define variable vss-include-info87 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5964   if not available tb-gds-obj-attr then do:
     5965     create tb-gds-obj-attr.
     5966     assign compare-log = no.
     5967   end.
     5968   else do:
     5969     buffer-compare tb-gds-obj-attr TO wt-gds-obj-attr case-sensitive save result in compare-log no-error.
     5970   end.
     5971   if not compare-log then do:
     5972     buffer-copy wt-gds-obj-attr TO tb-gds-obj-attr.
     5973       run gdsoattr-name in p-imp-handle
     5974         ( input  tb-gds-obj-attr.attr-code
     5975           ,output v-type
     5976           ,output v-format
     5977           ,output v-label
     5978           ,output v-user-can-edit
     5979           ,output v-output-display
     5980           ,output v-other
     5981         ) .
     5982     _do:
     5983     do jj = 1 to num-entries(v-other, chr(47)):
     5984       assign
     5985       v-dop1 = entry(1, entry(jj, v-other, chr(47)), '=':U)
     5986       .
     5987       if v-dop1 = "cd":U then do:
     5988         run fill-g-list in p-imp-handle ( input tb-gds-obj-attr.gds-code
     5989                                         ,input tb-gds-obj-attr.obj-type
     5990                                         ,input tb-gds-obj-attr.obj-code
     5991                                         ).
     5992         LEAVE _do.
     5993       end.
     5994     end.
     5995   end.
     5996       delete wt-gds-obj-attr.
     5997     end.
     5998   END PROCEDURE.
     5999   define temp-table wt-assortment-matrix no-undo like ub.assortment-matrix.
     6000   PROCEDURE proc-load-assortment-matrix:
     6001     define input parameter p-imp-handle as handle  no-undo.
     6002     define input parameter p-pck-num    as integer no-undo.
     6003     define input parameter l-counter    as integer no-undo.
     6004     do
     6005     on error  undo, return error substitute( "$proc-load-assortment-matrix. &1&2&3", return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     6006     on stop   undo, return error substitute( "$proc-load-assortment-matrix. stop" )
     6007     on endkey undo, return error substitute( "$proc-load-assortment-matrix. endkey" )
     6008     :
     6009       define buffer tb-assortment-matrix for ub.assortment-matrix.
     6010       define variable compare-log as logical no-undo.
     6011   define variable vss-include-info88 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6012   define buffer buf_old_assortment-matrix for ub.assortment-matrix  .
     6013       for each wt-assortment-matrix
     6014       on error undo, return error substitute( "$proc-load-assortment-matrix(del-wt-). &1&2&3", return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     6015       :
     6016         delete wt-assortment-matrix .
     6017       end.
     6018       create wt-assortment-matrix.
     6019       run nws-impl in p-imp-handle
     6020         ( input 'assortment-matrix':U
     6021          ,input (buffer wt-assortment-matrix:handle)
     6022         ) no-error.
     6023       if error-status :error then do:
     6024         return error return-value .
     6025       end.
     6026       find first tb-assortment-matrix
     6027         where tb-assortment-matrix.asmt-id = wt-assortment-matrix.asmt-id
     6028           and tb-assortment-matrix.db-num = wt-assortment-matrix.db-num
     6029         exclusive-lock no-error.
     6030   define variable vss-include-info89 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6031     if l-counter <> 0 then do:
     6032     return error vss-workfile + chr(32)
     6033                 + vss-revision + chr(32)
     6034                 + vss-description + chr(10)
     6035                 + "Ошибка обработки записи" + chr(32)
     6036                 + 'assortment-matrix':U + chr(10)
     6037                 + "Есть привязанные записи, а обработка идет для одной".
     6038     end.
     6039     if g#news then do:
     6040        if wt-assortment-matrix.asmt-type = 'Объект':U and wt-assortment-matrix.asmt-status = 0  then do:
     6041           find first buf_old_assortment-matrix no-lock where
     6042                      buf_old_assortment-matrix.asmt-status = 0 and
     6043                      not
     6044                     ( buf_old_assortment-matrix.asmt-id    = wt-assortment-matrix.asmt-id  and
     6045                       buf_old_assortment-matrix.db-num     = wt-assortment-matrix.db-num )
     6046                       and
     6047                      buf_old_assortment-matrix.obj-type    = wt-assortment-matrix.obj-type and
     6048                      buf_old_assortment-matrix.obj-code    = wt-assortment-matrix.obj-code and
     6049                      buf_old_assortment-matrix.asmt-type    = wt-assortment-matrix.asmt-type no-error .
     6050           if available buf_old_assortment-matrix then do:
     6051           if g#db-num = 0  then
     6052              run write-to-log in p-imp-handle (
     6053              substitute(">> Пришедшая АМ: &1 по объекту &2&3 противоречит существующей АМ: &4 , АМ УБД будет принята в статусе УДАЛЕНа <<" ,
     6054              wt-assortment-matrix.asmt-id,
     6055              wt-assortment-matrix.obj-type,
     6056              wt-assortment-matrix.obj-code,
     6057              buf_old_assortment-matrix.asmt-id )) .
     6058            else
     6059              run write-to-log in p-imp-handle (
     6060              substitute(">> Пришедшая АМ: &1 по объекту &2&3 противоречит существующей АМ: &4 , статус АМ УБД в следующем сеансе связи будет изменен на УДАЛЕН <<" ,
     6061              wt-assortment-matrix.asmt-id,
     6062              wt-assortment-matrix.obj-type,
     6063              wt-assortment-matrix.obj-code,
     6064              buf_old_assortment-matrix.asmt-id )) .
     6065          end.
     6066        end.
     6067     end.
     6068     if not available tb-assortment-matrix then do:
     6069       create tb-assortment-matrix.
     6070       assign compare-log = no.
     6071     end.
     6072     else do:
     6073       buffer-compare tb-assortment-matrix TO wt-assortment-matrix case-sensitive save result in compare-log no-error.
     6074     end.
     6075     if not compare-log then do:
     6076       buffer-copy wt-assortment-matrix TO tb-assortment-matrix.
     6077     end.
     6078       delete wt-assortment-matrix.
     6079     end.
     6080   END PROCEDURE.
     6081   define temp-table wt-gds-grp-obj-attr no-undo like ub.gds-grp-obj-attr.
     6082   PROCEDURE proc-load-gds-grp-obj-attr:
     6083     define input parameter p-imp-handle as handle  no-undo.
     6084     define input parameter p-pck-num    as integer no-undo.
     6085     define input parameter l-counter    as integer no-undo.
     6086     do
     6087     on error  undo, return error substitute( "$proc-load-gds-grp-obj-attr. &1&2&3", return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     6088     on stop   undo, return error substitute( "$proc-load-gds-grp-obj-attr. stop" )
     6089     on endkey undo, return error substitute( "$proc-load-gds-grp-obj-attr. endkey" )
     6090     :
     6091       define buffer tb-gds-grp-obj-attr for ub.gds-grp-obj-attr.
     6092       define variable compare-log as logical no-undo.
     6093       for each wt-gds-grp-obj-attr
     6094       on error undo, return error substitute( "$proc-load-gds-grp-obj-attr(del-wt-). &1&2&3", return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     6095       :
     6096         delete wt-gds-grp-obj-attr .
     6097       end.
     6098       create wt-gds-grp-obj-attr.
     6099       run nws-impl in p-imp-handle
     6100         ( input 'gds-grp-obj-attr':U
     6101          ,input (buffer wt-gds-grp-obj-attr:handle)
     6102         ) no-error.
     6103       if error-status :error then do:
     6104         return error return-value .
     6105       end.
     6106       find first tb-gds-grp-obj-attr
     6107         where tb-gds-grp-obj-attr.node-code = wt-gds-grp-obj-attr.node-code
     6108           and tb-gds-grp-obj-attr.host-code = wt-gds-grp-obj-attr.host-code
     6109           and tb-gds-grp-obj-attr.obj-type = wt-gds-grp-obj-attr.obj-type
     6110           and tb-gds-grp-obj-attr.obj-code = wt-gds-grp-obj-attr.obj-code
     6111           and tb-gds-grp-obj-attr.attr-code = wt-gds-grp-obj-attr.attr-code
     6112         exclusive-lock no-error.
     6113   define variable vss-include-info90 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6114   define buffer bf_clients for ub.clients .
     6115   define variable v-obj-code as integer no-undo .
     6116     if l-counter <> 0 then do:
     6117     return error vss-workfile + chr(32)
     6118                 + vss-revision + chr(32)
     6119                 + vss-description + chr(10)
     6120                 + "Ошибка обработки записи" + chr(32)
     6121                 + 'gds-grp-obj-attr':U + chr(10)
     6122                 + "Есть привязанные записи, а обработка идет для одной".
     6123     end.
     6124       if wt-gds-grp-obj-attr.attr-code <> 'QntyAssMat':U  then do:
     6125       if not available tb-gds-grp-obj-attr then do:
     6126         create tb-gds-grp-obj-attr.
     6127         assign compare-log = no.
     6128       end.
     6129       else do:
     6130         buffer-compare tb-gds-grp-obj-attr TO wt-gds-grp-obj-attr case-sensitive save result in compare-log no-error.
     6131       end.
     6132       if not compare-log then do:
     6133         buffer-copy wt-gds-grp-obj-attr TO tb-gds-grp-obj-attr.
     6134         if   (    tb-gds-grp-obj-attr.attr-code  = 'ban-sales-via-cd':U
     6135               and tb-gds-grp-obj-attr.attr-value = "yes")
     6136            or tb-gds-grp-obj-attr.attr-code = 'emrc-type':U
     6137         then do:
     6138            for each ub.goods no-lock where ub.goods.grp-code = tb-gds-grp-obj-attr.node-code:
     6139                run fill-g-list in  p-imp-handle  ( input ub.goods.gds-code, input tb-gds-grp-obj-attr.obj-type, input tb-gds-grp-obj-attr.obj-code).
     6140            end.
     6141         end.
     6142       end.
     6143     end.
     6144       delete wt-gds-grp-obj-attr.
     6145     end.
     6146   END PROCEDURE.
     6147   define temp-table locb-global-state no-undo like ub.global-state.
     6148   define temp-table locb-global-state-attr no-undo like ub.global-state-attr.
     6149   define temp-table locb-c-global-state-attr no-undo like ub.c-global-state-attr.
     6150   define temp-table locb-c-global-state no-undo like ub.c-global-state.
     6151   define temp-table wt-global-state no-undo like ub.global-state.
     6152   PROCEDURE proc-load-global-state:
     6153     define input parameter p-imp-handle as handle  no-undo.
     6154     define input parameter p-pck-num    as integer no-undo.
     6155     define input parameter l-counter    as integer no-undo.
     6156     do
     6157     on error  undo, return error substitute( "$proc-load-global-state. &1&2&3", return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     6158     on stop   undo, return error substitute( "$proc-load-global-state. stop" )
     6159     on endkey undo, return error substitute( "$proc-load-global-state. endkey" )
     6160     :
     6161       define buffer tb-global-state for ub.global-state.
     6162       define variable compare-log as logical no-undo.
     6163   define variable vss-include-info91 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6164   define buffer buf_global-state        for ub.global-state.
     6165   define buffer buf_global-state-attr   for ub.global-state-attr.
     6166   define buffer buf_c-global-state      for ub.c-global-state.
     6167   define buffer buf_c-global-state-attr for ub.c-global-state-attr.
     6168   define variable counter  as   integer   no-undo.
     6169   define variable rec-full as   character no-undo.
     6170   define variable rec-name as   character no-undo.
     6171   for each locb-global-state
     6172   on error  undo, return error
     6173   :
     6174     delete locb-global-state.
     6175   end.
     6176   for each locb-c-global-state
     6177   on error  undo, return error
     6178   :
     6179     delete locb-c-global-state.
     6180   end.
     6181   for each locb-global-state-attr
     6182   on error  undo, return error
     6183   :
     6184     delete locb-global-state-attr.
     6185   end.
     6186   for each locb-c-global-state-attr
     6187   on error  undo, return error
     6188   :
     6189     delete locb-c-global-state-attr.
     6190   end.
     6191       for each wt-global-state
     6192       on error undo, return error substitute( "$proc-load-global-state(del-wt-). &1&2&3", return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     6193       :
     6194         delete wt-global-state .
     6195       end.
     6196       create wt-global-state.
     6197       run nws-impl in p-imp-handle
     6198         ( input 'global-state':U
     6199          ,input (buffer wt-global-state:handle)
     6200         ) no-error.
     6201       if error-status :error then do:
     6202         return error return-value .
     6203       end.
     6204       find first tb-global-state
     6205         where tb-global-state.gls-id = wt-global-state.gls-id
     6206         exclusive-lock no-error.
     6207   define variable vss-include-info92 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6208   DO counter = 1 TO l-counter
     6209   on error  undo, return error
     6210   on endkey undo, return error :
     6211   run nws-imps in p-imp-handle
     6212     ( input-output counter
     6213      ,output       rec-full
     6214     ) no-error.
     6215   if error-status :error then do:
     6216     return error substitute( "&1&2&3", return-value, chr(10), error-status :get-message(1) ) .
     6217   end.
     6218     assign
     6219       rec-name = entry( 1, rec-full, chr(1) )
     6220       .
     6221     CASE rec-name :
     6222       when "global-state-attr" then do:
     6223         create locb-global-state-attr.
     6224   run nws-impl in p-imp-handle
     6225     ( input "global-state-attr":U
     6226      ,input (buffer locb-global-state-attr:handle)
     6227     ) no-error.
     6228   if error-status :error then do:
     6229     return error substitute( "&1&2&3", return-value, chr(10), error-status :get-message(1) ) .
     6230   end.
     6231       end.
     6232       when "c-global-state" then do:
     6233         create locb-c-global-state.
     6234   run nws-impl in p-imp-handle
     6235     ( input "c-global-state":U
     6236      ,input (buffer locb-c-global-state:handle)
     6237     ) no-error.
     6238   if error-status :error then do:
     6239     return error substitute( "&1&2&3", return-value, chr(10), error-status :get-message(1) ) .
     6240   end.
     6241       end.
     6242       when "c-global-state-attr" then do:
     6243         create locb-c-global-state-attr.
     6244   run nws-impl in p-imp-handle
     6245     ( input "c-global-state-attr":U
     6246      ,input (buffer locb-c-global-state-attr:handle)
     6247     ) no-error.
     6248   if error-status :error then do:
     6249     return error substitute( "&1&2&3", return-value, chr(10), error-status :get-message(1) ) .
     6250   end.
     6251       end.
     6252       otherwise do:
     6253         message "Не предуcмотрен прием таблицы " rec-name skip
     6254                 "в cоcтаве куcта."
     6255                 view-as alert-box error.
     6256         return error.
     6257       end.
     6258     END CASE.
     6259   end.
     6260   for each buf_c-global-state where buf_c-global-state.gls-id = wt-global-state.gls-id
     6261   on error  undo, return error
     6262   :
     6263     delete buf_c-global-state.
     6264   end.
     6265   for each locb-c-global-state where locb-c-global-state.gls-id = wt-global-state.gls-id   no-lock
     6266   on error  undo, return error
     6267   :
     6268     create buf_c-global-state.
     6269     buffer-copy  locb-c-global-state to buf_c-global-state.
     6270   end.
     6271   for each buf_global-state-attr where buf_global-state-attr.gls-id = wt-global-state.gls-id
     6272   on error  undo, return error
     6273   :
     6274     delete buf_global-state-attr.
     6275   end.
     6276   for each locb-global-state-attr where locb-global-state-attr.gls-id = wt-global-state.gls-id
     6277   no-lock
     6278   on error  undo, return error
     6279   :
     6280     create buf_global-state-attr.
     6281     buffer-copy locb-global-state-attr to buf_global-state-attr.
     6282   end.
     6283   for each buf_c-global-state-attr where buf_c-global-state-attr.gls-id = wt-global-state.gls-id
     6284   on error  undo, return error
     6285   :
     6286     delete buf_c-global-state-attr.
     6287   end.
     6288   for each locb-c-global-state-attr where locb-c-global-state-attr.gls-id = wt-global-state.gls-id
     6289   no-lock
     6290   on error  undo, return error
     6291   :
     6292     create buf_c-global-state-attr.
     6293     buffer-copy locb-c-global-state-attr to buf_c-global-state-attr.
     6294   end.
     6295   if not available tb-global-state then do:
     6296     create tb-global-state.
     6297   end.
     6298   buffer-copy wt-global-state to tb-global-state.
     6299   for each locb-c-global-state
     6300   on error  undo, return error
     6301   :
     6302     delete locb-c-global-state.
     6303   end.
     6304   for each locb-global-state-attr
     6305   on error  undo, return error
     6306   :
     6307     delete locb-global-state-attr.
     6308   end.
     6309   for each locb-c-global-state-attr
     6310   on error  undo, return error
     6311   :
     6312     delete locb-c-global-state-attr.
     6313   end.
     6314       delete wt-global-state.
     6315     end.
     6316   END PROCEDURE.
     6317   def var vss-include-info93 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6318   define temp-table locb-bar-code     no-undo like ub.bar-code.
     6319   define temp-table locb-prod-bc      no-undo like ub.prod-bc.
     6320   define temp-table locb-tax-rate-gds      no-undo like ub.tax-rate-gds.
     6321   define temp-table wt-goods no-undo like ub.goods.
     6322   PROCEDURE proc-load-goods:
     6323     define input parameter p-imp-handle as handle  no-undo.
     6324     define input parameter p-pck-num    as integer no-undo.
     6325     define input parameter l-counter    as integer no-undo.
     6326     do
     6327     on error  undo, return error substitute( "$proc-load-goods. &1&2&3", return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     6328     on stop   undo, return error substitute( "$proc-load-goods. stop" )
     6329     on endkey undo, return error substitute( "$proc-load-goods. endkey" )
     6330     :
     6331       define buffer tb-goods for ub.goods.
     6332       define variable compare-log as logical no-undo.
     6333   define variable vss-include-info94 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6334   define buffer buf_bar-code     for ub.bar-code .
     6335   define buffer buf_prod-bc      for ub.prod-bc .
     6336   define buffer buf_tax-rate-gds      for ub.tax-rate-gds .
     6337   define buffer dst-units        for ub.units .
     6338   define buffer src-units        for ub.units .
     6339   define variable counter        as   integer           no-undo .
     6340   define variable rec-full       as   character         no-undo .
     6341   define variable rec-name       as   character         no-undo .
     6342   define variable the-same-goods as   logical           no-undo .
     6343   define variable imp-goods      as   logical           no-undo .
     6344   define variable load-tax       as   logical           no-undo .
     6345   define variable error-message  as   character         no-undo .
     6346   define variable old-gds-code   like ub.goods.gds-code no-undo .
     6347   define variable v-cmd          as   character         no-undo .
     6348   for each locb-bar-code
     6349   on error  undo, return error substitute( "&1. &2&3&4", vss-include-info94, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     6350   on stop   undo, return error substitute( "&1. stop", vss-include-info94 )
     6351   on endkey undo, return error substitute( "&1. endkey", vss-include-info94 )
     6352   :
     6353     delete locb-bar-code.
     6354   end.
     6355   for each locb-prod-bc
     6356   on error  undo, return error substitute( "&1. &2&3&4", vss-include-info94, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     6357   on stop   undo, return error substitute( "&1. stop", vss-include-info94 )
     6358   on endkey undo, return error substitute( "&1. endkey", vss-include-info94 )
     6359   :
     6360     delete locb-prod-bc.
     6361   end.
     6362   for each locb-tax-rate-gds
     6363   on error  undo, return error substitute( "&1. &2&3&4", vss-include-info94, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     6364   on stop   undo, return error substitute( "&1. stop", vss-include-info94 )
     6365   on endkey undo, return error substitute( "&1. endkey", vss-include-info94 )
     6366   :
     6367     delete locb-tax-rate-gds.
     6368   end.
     6369       for each wt-goods
     6370       on error undo, return error substitute( "$proc-load-goods(del-wt-). &1&2&3", return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     6371       :
     6372         delete wt-goods .
     6373       end.
     6374       create wt-goods.
     6375       run nws-impl in p-imp-handle
     6376         ( input 'goods':U
     6377          ,input (buffer wt-goods:handle)
     6378         ) no-error.
     6379       if error-status :error then do:
     6380         return error return-value .
     6381       end.
     6382       find first tb-goods
     6383         where tb-goods.gds-code = wt-goods.gds-code
     6384         exclusive-lock no-error.
     6385   define variable vss-include-info95 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6386   DO counter = 1 TO l-counter
     6387   on error  undo, return error
     6388   on stop   undo, return error
     6389   on endkey undo, return error :
     6390   run nws-imps in p-imp-handle
     6391     ( input-output counter
     6392      ,output       rec-full
     6393     ) no-error.
     6394   if error-status :error then do:
     6395     return error substitute( "&1&2&3", return-value, chr(10), error-status :get-message(1) ) .
     6396   end.
     6397     assign
     6398       rec-name = entry( 1, rec-full, chr(1) )
     6399       .
     6400     CASE rec-name :
     6401       when "bar-code" then do:
     6402         create locb-bar-code.
     6403         run nws-impl-without-check in p-imp-handle
     6404           ( input (buffer locb-bar-code:handle)
     6405           ) no-error.
     6406         if error-status :error then do:
     6407           return error return-value .
     6408         end.
     6409       end.
     6410       when "prod-bc" then do:
     6411         create locb-prod-bc.
     6412         run nws-impl-without-check in p-imp-handle
     6413           ( input (buffer locb-prod-bc:handle)
     6414           ) no-error.
     6415         if error-status :error then do:
     6416           return error return-value .
     6417         end.
     6418       end.
     6419       when "tax-rate-gds" then do:
     6420         create locb-tax-rate-gds.
     6421         run nws-impl-without-check in p-imp-handle
     6422           ( input (buffer locb-tax-rate-gds:handle)
     6423           ) no-error.
     6424         if error-status :error then do:
     6425           return error return-value .
     6426         end.
     6427       end.
     6428       otherwise do:
     6429         message "Не предусмотрен прием таблицы " rec-name skip
     6430                 "в составе товара."
     6431                 view-as alert-box error.
     6432         return error.
     6433       end.
     6434     END CASE.
     6435   end.
     6436   assign
     6437     imp-goods = FALSE
     6438     load-tax  = TRUE
     6439     .
     6440   do while imp-goods = FALSE
     6441   on error  undo, return error
     6442   on stop   undo, return error
     6443   on endkey undo, return error :
     6444     find tb-goods where tb-goods.gds-code = wt-goods.gds-code
     6445                   exclusive-lock no-error.
     6446     if available tb-goods then do:
     6447       if tb-goods.artic = wt-goods.artic
     6448          and tb-goods.prod-type = wt-goods.prod-type
     6449          and tb-goods.prod-code = wt-goods.prod-code
     6450       then do:
     6451         if g#db-num = 0 and lookup( string( tb-goods.stts ), '50,51' ) <> 0 then do:   buffer-copy wt-goods     except wt-goods.stts     to tb-goods. end. else do:   buffer-copy wt-goods to tb-goods. end.
     6452         assign imp-goods = TRUE.
     6453         run fill-g-list in  p-imp-handle  ( input tb-goods.gds-code, input '':U, input 0).
     6454       end.
     6455       else do:
     6456         run write-to-log in this-procedure (input "Системная ошибка!!! Не совпадает артикул или(и) производитель при совпадении кода товара." ).
     6457         return error.
     6458       end.
     6459     end.
     6460     else do:
     6461       find tb-goods where tb-goods.artic     = wt-goods.artic
     6462                       and tb-goods.prod-type = wt-goods.prod-type
     6463                       and tb-goods.prod-code = wt-goods.prod-code
     6464                     no-error.
     6465       if available tb-goods then do:
     6466         find current tb-goods exclusive-lock.
     6467   assign the-same-goods = FALSE.
     6468   if tb-goods.prt-root = wt-goods.prt-root
     6469   then do:
     6470     if tb-goods.unit-base = wt-goods.unit-base then do:
     6471       assign the-same-goods = TRUE.
     6472     end.
     6473   end.
     6474         if the-same-goods then do:
     6475           if g#db-num = 0 then do:
     6476             assign
     6477               v-cmd = string( "command" + chr(1) + "goods" + chr(1) + "ren-gds-code"
     6478                               + chr(1) + string( wt-goods.gds-code )
     6479                               + chr(1) + string( tb-goods.gds-code )
     6480                              )
     6481               .
     6482             run nws/cr-route.p ( input 'send-cmd':U, input v-cmd, input ?, input string( g#news-source-db ) ).
     6483             assign
     6484               load-tax = FALSE
     6485             .
     6486             run write-to-log in this-procedure (input "Пришедший товар (gds-code) " + string( wt-goods.gds-code )
     6487                               + " заменен на " + string( tb-goods.gds-code ) + "." ).
     6488           end.
     6489           else do:
     6490             assign
     6491               old-gds-code = tb-goods.gds-code
     6492             .
     6493             run utl/ren-gdsc.p
     6494               ( input old-gds-code
     6495                ,input wt-goods.gds-code
     6496               ) no-error .
     6497             if error-status :error then do:
     6498               run write-to-log in this-procedure
     6499                 (input "Не удалось заменить gds-code существовавшего товара " + string( old-gds-code )
     6500                        + " на " + string( wt-goods.gds-code ) + "." + chr(10)
     6501                        + return-value + chr(10) + error-status:get-message(1)
     6502                 ).
     6503               return error.
     6504             end.
     6505             run write-to-log in this-procedure (input "Существовавший товар (gds-code) " + string( old-gds-code )
     6506                               + " заменен на " + string( wt-goods.gds-code ) + "." ).
     6507             if g#db-num = 0 and lookup( string( tb-goods.stts ), '50,51' ) <> 0 then do:   buffer-copy wt-goods     except wt-goods.stts     to tb-goods. end. else do:   buffer-copy wt-goods to tb-goods. end.
     6508           end.
     6509           assign imp-goods = TRUE.
     6510         end.
     6511         else do:
     6512           if g#db-num = 0 then do:
     6513             if g#auto = true then do:
     6514               run write-to-log in this-procedure (input "Коллизия! Дождитесь разбора коллизий в УБД." ).
     6515               return error.
     6516             end.
     6517             else do:
     6518               run write-to-log in this-procedure (input "Коллизия! Дождитесь разбора коллизий в УБД и повторите прием пакета." ).
     6519               return error.
     6520             end.
     6521           end.
     6522           else do:
     6523             run write-to-log in this-procedure (input "Коллизия! Необходимо изменить артикул и(или) производителя у товара." + chr(10)
     6524                               + tb-goods.gds-name + chr(10)
     6525                               + tb-goods.artic + " " + tb-goods.prod-type + " " + string( tb-goods.prod-code ) + "." + chr(10)
     6526                             ).
     6527             if g#auto = true then do:
     6528               run write-to-log in this-procedure (input "Для этого запустите ручной разбор пакета." ).
     6529               return error.
     6530             end.
     6531             else do:
     6532               message "Коллизия! Необходимо изменить артикул и(или) производителя у товара." skip
     6533                       tb-goods.gds-name skip
     6534                       tb-goods.artic + " " + tb-goods.prod-type + " " + string( tb-goods.prod-code ) + "." skip
     6535                       view-as alert-box.
     6536               run utl/new-art.w ( input ?
     6537                              ,input tb-goods.artic
     6538                              ,input tb-goods.prod-type
     6539                              ,input tb-goods.prod-code
     6540                             ) no-error.
     6541               if return-value <> "" then do:
     6542                 run write-to-log in this-procedure (input "Артикул не изменен " + rec-full ).
     6543                 message "Артикул не изменен " + rec-full
     6544                         view-as alert-box.
     6545                 return error.
     6546               end.
     6547             end.
     6548           end.
     6549         end.
     6550       end.
     6551       else do:
     6552         create tb-goods.
     6553         buffer-copy wt-goods to tb-goods.
     6554         assign imp-goods = TRUE.
     6555       end.
     6556     end.
     6557   end.
     6558   for each locb-bar-code where locb-bar-code.gds-code = wt-goods.gds-code
     6559   on error  undo, return error
     6560   :
     6561     run check-avail-gds-code in p-imp-handle
     6562       ( input-output locb-bar-code.gds-code
     6563       ).
     6564     run create-bar-code in p-imp-handle
     6565       ( input locb-bar-code.b-code
     6566        ,input locb-bar-code.cli-base-rate
     6567        ,input locb-bar-code.gds-code
     6568        ,input locb-bar-code.in-code
     6569        ,input locb-bar-code.node-code
     6570        ,input locb-bar-code.part-code
     6571        ,input locb-bar-code.unit-cli
     6572        ,input locb-bar-code.cr-db-num
     6573       ).
     6574     for each locb-prod-bc where locb-prod-bc.b-code = locb-bar-code.b-code
     6575     on error  undo, return error
     6576     :
     6577       run check-avail-b-code in p-imp-handle
     6578         ( input-output locb-prod-bc.b-code
     6579         ).
     6580       run create-prod-bc in p-imp-handle
     6581         ( input locb-prod-bc.b-code
     6582          ,input locb-prod-bc.b-str
     6583          ,input yes
     6584          ,input locb-prod-bc.cr-db-num
     6585          ,input locb-prod-bc.bc-on-type
     6586         ).
     6587     end.
     6588   end.
     6589   if load-tax then do:
     6590     for each locb-tax-rate-gds no-lock
     6591       where locb-tax-rate-gds.gds-code     = wt-goods.gds-code
     6592     on error  undo, return error
     6593     :
     6594       find FIRST buf_tax-rate-gds where
     6595                 buf_tax-rate-gds.gds-code     = locb-tax-rate-gds.gds-code
     6596             and buf_tax-rate-gds.tax-code  = locb-tax-rate-gds.tax-code
     6597             AND buf_tax-rate-gds.host-code = locb-tax-rate-gds.host-code
     6598             AND buf_tax-rate-gds.obj-type  = locb-tax-rate-gds.obj-type
     6599             AND buf_tax-rate-gds.obj-code  = locb-tax-rate-gds.obj-code
     6600             AND buf_tax-rate-gds.fact-order  = locb-tax-rate-gds.fact-order
     6601                        exclusive-lock no-error.
     6602       if not available buf_tax-rate-gds then do:
     6603         create buf_tax-rate-gds.
     6604       end.
     6605       buffer-copy locb-tax-rate-gds to buf_tax-rate-gds.
     6606     end.
     6607   end.
     6608   for each locb-bar-code
     6609   on error  undo, return error
     6610   :
     6611     delete locb-bar-code.
     6612   end.
     6613   for each locb-prod-bc
     6614   on error  undo, return error
     6615   :
     6616     delete locb-prod-bc.
     6617   end.
     6618   for each locb-tax-rate-gds
     6619   on error  undo, return error
     6620   :
     6621     delete locb-tax-rate-gds.
     6622   end.
     6623       delete wt-goods.
     6624     end.
     6625   END PROCEDURE.
     6626   define temp-table wt-goods-attr no-undo like ub.goods-attr.
     6627   PROCEDURE proc-load-goods-attr:
     6628     define input parameter p-imp-handle as handle  no-undo.
     6629     define input parameter p-pck-num    as integer no-undo.
     6630     define input parameter l-counter    as integer no-undo.
     6631     do
     6632     on error  undo, return error substitute( "$proc-load-goods-attr. &1&2&3", return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     6633     on stop   undo, return error substitute( "$proc-load-goods-attr. stop" )
     6634     on endkey undo, return error substitute( "$proc-load-goods-attr. endkey" )
     6635     :
     6636       define buffer tb-goods-attr for ub.goods-attr.
     6637       define variable compare-log as logical no-undo.
     6638       for each wt-goods-attr
     6639       on error undo, return error substitute( "$proc-load-goods-attr(del-wt-). &1&2&3", return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     6640       :
     6641         delete wt-goods-attr .
     6642       end.
     6643       create wt-goods-attr.
     6644       run nws-impl in p-imp-handle
     6645         ( input 'goods-attr':U
     6646          ,input (buffer wt-goods-attr:handle)
     6647         ) no-error.
     6648       if error-status :error then do:
     6649         return error return-value .
     6650       end.
     6651       find first tb-goods-attr
     6652         where tb-goods-attr.gds-code = wt-goods-attr.gds-code
     6653           and tb-goods-attr.attr-code = wt-goods-attr.attr-code
     6654         exclusive-lock no-error.
     6655   define variable vss-include-info96 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6656   define variable v-type           as character no-undo .
     6657   define variable v-format         as character no-undo .
     6658   define variable v-label          as character no-undo .
     6659   define variable v-user-can-edit  as logical   no-undo .
     6660   define variable v-output-display as logical   no-undo .
     6661   define variable v-other          as character no-undo .
     6662   define variable jj as integer no-undo .
     6663   define variable v-dop1 as character no-undo .
     6664   if not available tb-goods-attr then do:
     6665     create tb-goods-attr.
     6666     assign compare-log = no.
     6667   end.
     6668   else do:
     6669     buffer-compare tb-goods-attr TO wt-goods-attr case-sensitive save result in compare-log no-error.
     6670   end.
     6671   if not compare-log then do:
     6672     buffer-copy wt-goods-attr TO tb-goods-attr.
     6673            if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-name in g#attr-lib
     6674           ( input  tb-goods-attr.attr-code
     6675           ,output v-type
     6676           ,output v-format
     6677           ,output v-label
     6678           ,output v-user-can-edit
     6679           ,output v-output-display
     6680           ,output v-other
     6681         ) .
     6682     _do:
     6683     do jj = 1 to num-entries(v-other, chr(47)):
     6684       assign
     6685       v-dop1 = entry(1, entry(jj, v-other, chr(47)), '=':U)
     6686       .
     6687       if v-dop1 = "cd":U then do:
     6688         run fill-g-list in p-imp-handle ( input tb-goods-attr.gds-code
     6689                                          ,input ""
     6690                                          ,input 0
     6691                                         ).
     6692         LEAVE _do.
     6693       end.
     6694     end.
     6695   end.
     6696       delete wt-goods-attr.
     6697     end.
     6698   END PROCEDURE.
     6699   define  temp-table locb-db-grp-obj-price   no-undo like  ub.db-grp-obj-price  .
     6700   define  temp-table locb-host-grp-obj-price no-undo like  ub.host-grp-obj-price.
     6701   define  temp-table locb-obj-grp-obj-price  no-undo like  ub.obj-grp-obj-price .
     6702   define  temp-table locb-grp-obj-price      no-undo like  ub.grp-obj-price     .
     6703   define temp-table wt-grp-obj-price no-undo like ub.grp-obj-price.
     6704   PROCEDURE proc-load-grp-obj-price:
     6705     define input parameter p-imp-handle as handle  no-undo.
     6706     define input parameter p-pck-num    as integer no-undo.
     6707     define input parameter l-counter    as integer no-undo.
     6708     do
     6709     on error  undo, return error substitute( "$proc-load-grp-obj-price. &1&2&3", return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     6710     on stop   undo, return error substitute( "$proc-load-grp-obj-price. stop" )
     6711     on endkey undo, return error substitute( "$proc-load-grp-obj-price. endkey" )
     6712     :
     6713       define buffer tb-grp-obj-price for ub.grp-obj-price.
     6714       define variable compare-log as logical no-undo.
     6715   define variable vss-include-info97 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6716   define buffer buf_db-grp-obj-price    for ub.db-grp-obj-price  .
     6717   define buffer buf_host-grp-obj-price  for ub.host-grp-obj-price.
     6718   define buffer buf_obj-grp-obj-price   for ub.obj-grp-obj-price .
     6719   define buffer buf_grp-obj-price       for ub.grp-obj-price     .
     6720   define variable counter  as   integer   no-undo.
     6721   define variable rec-full as   character no-undo.
     6722   define variable rec-name as   character no-undo.
     6723   for each locb-grp-obj-price
     6724   on error  undo, return error
     6725   :
     6726     delete locb-grp-obj-price.
     6727   end.
     6728   for each locb-db-grp-obj-price
     6729   on error  undo, return error
     6730   :
     6731     delete locb-db-grp-obj-price.
     6732   end.
     6733   for each locb-host-grp-obj-price
     6734   on error  undo, return error
     6735   :
     6736     delete locb-host-grp-obj-price.
     6737   end.
     6738   for each locb-obj-grp-obj-price
     6739   on error  undo, return error
     6740   :
     6741     delete locb-obj-grp-obj-price.
     6742   end.
     6743       for each wt-grp-obj-price
     6744       on error undo, return error substitute( "$proc-load-grp-obj-price(del-wt-). &1&2&3", return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     6745       :
     6746         delete wt-grp-obj-price .
     6747       end.
     6748       create wt-grp-obj-price.
     6749       run nws-impl in p-imp-handle
     6750         ( input 'grp-obj-price':U
     6751          ,input (buffer wt-grp-obj-price:handle)
     6752         ) no-error.
     6753       if error-status :error then do:
