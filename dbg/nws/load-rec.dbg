     1705       find first tb-add-doc
     1706         where tb-add-doc.doc-code = wt-add-doc.doc-code
     1707         exclusive-lock no-error.
     1708   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1709   DO counter = 1 TO l-counter
