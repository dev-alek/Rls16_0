    12444   define temp-table wt-prod-bc no-undo like ub.prod-bc.
    12445   PROCEDURE proc-load-prod-bc:
    12446     define input parameter p-imp-handle as handle  no-undo.
    12447     define input parameter p-pck-num    as integer no-undo.
    12448     define input parameter l-counter    as integer no-undo.
    12449     do
    12450     on error  undo, return error substitute( "$proc-load-prod-bc. &1&2&3", return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    12451     on stop   undo, return error substitute( "$proc-load-prod-bc. stop" )
    12452     on endkey undo, return error substitute( "$proc-load-prod-bc. endkey" )
    12453     :
    12454       define buffer tb-prod-bc for ub.prod-bc.
    12455       define variable compare-log as logical no-undo.
    12456       for each wt-prod-bc
    12457       on error undo, return error substitute( "$proc-load-prod-bc(del-wt-). &1&2&3", return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    12458       :
    12459         delete wt-prod-bc .
    12460       end.
    12461       create wt-prod-bc.
    12462       run nws-impl in p-imp-handle
    12463         ( input 'prod-bc':U
    12464          ,input (buffer wt-prod-bc:handle)
    12465         ) no-error.
    12466       if error-status :error then do:
    12467         return error return-value .
    12468       end.
    12469       find first tb-prod-bc
    12470         where tb-prod-bc.b-code = wt-prod-bc.b-code
    12471           and tb-prod-bc.b-str = wt-prod-bc.b-str
    12472         exclusive-lock no-error.
    12473   define variable vss-include-info134 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    12474   run check-avail-b-code in p-imp-handle
    12475     ( input-output wt-prod-bc.b-code
    12476     ).
    12477   run create-prod-bc in p-imp-handle
    12478     ( input wt-prod-bc.b-code, input wt-prod-bc.b-str, input wt-prod-bc.bc-on, input wt-prod-bc.cr-db-num, input wt-prod-bc.bc-on-type
    12479     ).
    12480       delete wt-prod-bc.
    12481     end.
    12482   END PROCEDURE.
