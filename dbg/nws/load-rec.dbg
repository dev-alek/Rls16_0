     8243   DEFINE VARIABLE v-time as integer no-undo .
     8244   define buffer buf_c-layout-elem-rule for ub.c-layout-elem-rule.
     8245   do
     8246   on error undo, return error
     8247   :
     8248     run cur-time in this-procedure ( output v-today, output v-time).
     8249     create buf_c-layout-elem-rule.
     8250     if available buf_layout-elem-rule
     8251     and p-mode <> 'ДОБАВЛЕНИЕ':U
     8252     then do:
     8253       buffer-copy buf_layout-elem-rule
     8254       to buf_c-layout-elem-rule.
