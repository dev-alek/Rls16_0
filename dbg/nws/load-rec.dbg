     3278     for each buf_drt-prop where buf_drt-prop.templ-rl-root = p-templ-rl-root:
     3279       create buf_temp-drt-prop.
     3280       buffer-copy buf_drt-prop to buf_temp-drt-prop.
     3281     end.
     3282   end.
     3283   end procedure.
     3284   ~
     3285   define temp-table wt-dis-rule no-undo like ub.dis-rule.
     3286   PROCEDURE proc-load-dis-rule:
     3287     define input parameter p-imp-handle as handle  no-undo.
     3288     define input parameter p-pck-num    as integer no-undo.
     3289     define input parameter l-counter    as integer no-undo.
     3290     do
     3291     on error  undo, return error substitute( "$proc-load-dis-rule. &1&2&3", return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     3292     on stop   undo, return error substitute( "$proc-load-dis-rule. stop" )
     3293     on endkey undo, return error substitute( "$proc-load-dis-rule. endkey" )
     3294     :
     3295       define buffer tb-dis-rule for ub.dis-rule.
     3296       define variable compare-log as logical no-undo.
     3297   define variable vss-include-info45 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3298   define variable v-ok as logical no-undo .
     3299   define buffer buf_dis-rule  for ub.dis-rule .
     3300   define buffer template_dis-rule for ub.dis-rule.
     3301   define variable h_wt-dis-rule as handle no-undo .
     3302   define variable h_buf_dis-rule as handle no-undo .
     3303   define variable jj as integer no-undo .
     3304   define variable v-uniq-field as character no-undo .
     3305   define variable v-curr-field as character no-undo .
     3306   define buffer buf1_dis-rule         for ub.dis-rule.
     3307   define variable counter  as integer   no-undo.
     3308   define variable rec-full as character no-undo.
     3309   define variable rec-name as character no-undo.
     3310   define buffer buf_dis-cfg-rule for ub.dis-cfg-rule.
     3311   define variable v-gds-send as logical no-undo .
     3312   define variable v-dc-send as logical no-undo .
     3313   define buffer buf_Dis-card for ub.dis-card.
     3314   define buffer buf_goods for ub.goods.
     3315   define buffer buf_dis-gds-rule for ub.dis-gds-rule.
     3316   define buffer buf_dis-dc-rule for ub.dis-dc-rule.
     3317   for each locb1-dis-rule
     3318   on error undo, return error error-status :get-message (1)
     3319   :
     3320     delete locb1-dis-rule.
     3321   end.
     3322       for each wt-dis-rule
     3323       on error undo, return error substitute( "$proc-load-dis-rule(del-wt-). &1&2&3", return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     3324       :
     3325         delete wt-dis-rule .
     3326       end.
     3327       create wt-dis-rule.
     3328       run nws-impl in p-imp-handle
     3329         ( input 'dis-rule':U
     3330          ,input (buffer wt-dis-rule:handle)
     3331         ) no-error.
     3332       if error-status :error then do:
     3333         return error return-value .
     3334       end.
     3335       find first tb-dis-rule
     3336         where tb-dis-rule.rule-num = wt-dis-rule.rule-num
     3337         exclusive-lock no-error.
     3338   define variable vss-include-info46 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3339   DO counter = 1 TO l-counter
     3340   on error  undo, return error
     3341   on endkey undo, return error :
     3342   run nws-imps in p-imp-handle
     3343     ( input-output counter
     3344      ,output       rec-full
     3345     ) no-error.
     3346   if error-status :error then do:
     3347     return error substitute( "&1&2&3", return-value, chr(10), error-status :get-message(1) ) .
     3348   end.
     3349     assign
     3350       rec-name = entry( 1, rec-full, chr(1) )
     3351       .
     3352     CASE rec-name :
     3353       when 'dis-rule':U then do:
     3354         create locb1-dis-rule.
     3355   run nws-impl in p-imp-handle
     3356     ( input "dis-rule":U
     3357      ,input (buffer locb1-dis-rule:handle)
     3358     ) no-error.
     3359   if error-status :error then do:
     3360     return error substitute( "&1&2&3", return-value, chr(10), error-status :get-message(1) ) .
     3361   end.
     3362       end.
     3363       otherwise do:
     3364         message "Не предусмотрен прием таблицы " rec-name skip
     3365                 "в составе истории чека"
     3366                 view-as alert-box error.
     3367         return error.
     3368       end.
     3369     END CASE.
     3370   end.
     3371   do
     3372   on error  undo, return error
     3373   on endkey undo, return error
     3374   on stop   undo, return error :
     3375     if (available tb-dis-rule
     3376         and tb-dis-rule.rule-num = wt-dis-rule.rule-num
     3377         and (tb-dis-rule.sts  = wt-dis-rule.sts
     3378             OR
     3379             wt-dis-rule.sts <> integer('0':U)
     3380             ))
     3381     or wt-dis-rule.lvl-num = 0
     3382     then do:
     3383       v-ok = yes.
     3384     end.
     3385     if not v-ok then do:
     3386       find first template_dis-rule no-lock where
     3387                 template_dis-rule.rule-num = wt-dis-rule.templ-rl-root no-error.
     3388       if not available template_dis-rule then do:
     3389         run write-to-log( substitute("Не найден шаблон №&1 для правила скидок №&2"
     3390                                     , wt-dis-rule.templ-rl-root
     3391                                     , wt-dis-rule.rule-num)).
     3392         return error .
     3393       end.
     3394       if not can-find(first ub.drt-prop no-lock where
     3395                            ub.drt-prop.templ-rl-root = template_dis-rule.templ-rl-root
     3396                        and ub.drt-prop.upper-prop-code = '':U
     3397                        and ub.drt-prop.prop-code = 'uniq':U) then do:
     3398         v-ok = yes.
     3399       end.
     3400       else do:
     3401         v-uniq-field = chr(32) .
     3402       end.
     3403     end.
     3404     if not v-ok then do:
     3405       do jj = 1 to num-entries("discnt-value"):
     3406         assign
     3407         v-curr-field = entry(jj, "discnt-value")
     3408         .
     3409         if can-find(first ub.drt-prop no-lock where
     3410                           ub.drt-prop.templ-rl-root = template_dis-rule.templ-rl-root
     3411                       and ub.drt-prop.upper-prop-code = '':U
     3412                       and ub.drt-prop.prop-code = v-curr-field + 'uniq=':U
     3413                       and ub.drt-prop.property-value  = "yes") then do:
     3414           assign
     3415           v-uniq-field = v-uniq-field + chr(44) + v-curr-field.
     3416         end.
     3417       end.
     3418       v-uniq-field = trim(v-uniq-field, chr(44)).
     3419       if wt-dis-rule.sts = integer('0':U) then do:
     3420         assign
     3421         h_wt-dis-rule = buffer wt-dis-rule:handle
     3422         h_buf_dis-rule = buffer buf_dis-rule:handle
     3423         .
     3424         _dis-rule:
     3425         for each buf_dis-rule where buf_dis-rule.upper-rule-num   = wt-dis-rule.upper-rule-num
     3426                                         and buf_dis-rule.host-code = wt-dis-rule.host-code
     3427                                         and buf_dis-rule.obj-type = wt-dis-rule.obj-type
     3428                                         and buf_dis-rule.obj-code = wt-dis-rule.obj-code
     3429                                         and buf_dis-rule.sts   = integer('0':U)
     3430           on error undo, return error return-value:
     3431           if buf_dis-rule.rule-num = wt-dis-rule.rule-num then next _dis-rule.
     3432           if buf_dis-rule.sts = integer('1':U) then nEXT _dis-rule.
     3433           if v-uniq-field = '':U then do:
     3434             if g#db-num = 0 then do:
     3435               assign
     3436               wt-dis-rule.sts = integer('1':U)
     3437               .
     3438               run write-to-log( substitute("Выключено полученное правило скидки №&1, так как имеется активное правило №&2&3" +                                         "Тип правила: &4"                                                                                                       , wt-dis-rule.rule-num                                                                                                  , buf_dis-rule.rule-num                                                                                                 , chr(10)                                                                                                         , template_dis-rule.des)).
     3439             end.
     3440             else do:
     3441               assign
     3442               buf_dis-rule.sts = integer('1':U)
     3443               .
     3444               run write-to-log( substitute("Выключено правило скидки №&1, так как получено новое активное правило №&2&3" +                                         "Тип правила: &4"                                                                                                       , buf_dis-rule.rule-num                                                                                                 , wt-dis-rule.rule-num                                                                                                  , chr(10)                                                                                                         , template_dis-rule.des)).
     3445             end.
     3446             leave _dis-rule.
     3447           end.
     3448           do jj = 1 to num-entries(v-uniq-field):
     3449             if h_wt-dis-rule:buffer-field(entry(jj, v-uniq-field)):buffer-value = h_buf_dis-rule:buffer-field(entry(jj, v-uniq-field)):buffer-value
     3450             then do:
     3451               if g#db-num = 0 then do:
     3452                 assign
     3453                 wt-dis-rule.sts = integer('1':U)
     3454                 .
     3455                 run write-to-log( substitute("Выключено полученное правило скидки №&1, так как имеется активное правило №&2&3" +                                         "Тип правила: &4"                                                                                                       , wt-dis-rule.rule-num                                                                                                  , buf_dis-rule.rule-num                                                                                                 , chr(10)                                                                                                         , template_dis-rule.des)).
     3456               end.
     3457               else do:
     3458                 assign
     3459                 buf_dis-rule.sts = integer('1':U)
     3460                 .
     3461                 run write-to-log( substitute("Выключено правило скидки №&1, так как получено новое активное правило №&2&3" +                                         "Тип правила: &4"                                                                                                       , buf_dis-rule.rule-num                                                                                                 , wt-dis-rule.rule-num                                                                                                  , chr(10)                                                                                                         , template_dis-rule.des)).
     3462               end.
     3463             end.
     3464           end.
     3465         end.
     3466       end.
     3467     end.
     3468     if not available tb-dis-rule then do:
     3469       create tb-dis-rule.
     3470     end.
     3471     buffer-copy wt-dis-rule to tb-dis-rule.
     3472   end.
     3473   if wt-dis-rule.rule-num > 99999 then do:
     3474     for each locb1-dis-rule where
     3475             locb1-dis-rule.upper-rule-num = wt-dis-rule.rule-num
     3476         no-lock
     3477     on error  undo, return error substitute( "&1&2&3", return-value, chr(10), error-status :get-message (1))
     3478     :
     3479       find first buf1_dis-rule exclusive-lock where
     3480                 buf1_dis-rule.rule-num = locb1-dis-rule.rule-num no-error.
     3481       if not available buf1_dis-rule then do:
     3482         create buf1_dis-rule.
     3483       end.
     3484       buffer-copy locb1-dis-rule to buf1_dis-rule.
     3485     end.
     3486     for each buf1_dis-rule where
     3487             buf1_dis-rule.upper-rule-num = wt-dis-rule.rule-num
     3488     on error  undo, return error substitute( "&1&2&3", return-value, chr(10), error-status :get-message (1))
     3489     :
     3490       find first locb1-dis-rule exclusive-lock where
     3491                 locb1-dis-rule.rule-num = buf1_dis-rule.rule-num no-error.
     3492       if not available locb1-dis-rule then do:
     3493         if wt-dis-rule.upper-rule-num <> 0 then do:
     3494           delete buf1_dis-rule.
     3495         end.
     3496       end.
     3497     end.
     3498   end.
     3499   for each locb1-dis-rule
     3500   on error  undo, return error
     3501   :
     3502     delete locb1-dis-rule.
     3503   end.
     3504   for each buf_dis-cfg-rule no-lock where
     3505           buf_dis-cfg-rule.templ-rl-root = tb-dis-rule.templ-rl-root
     3506       and buf_dis-cfg-rule.time-templ-rl-root = tb-dis-rule.time-templ-rl-root:
     3507     if buf_dis-cfg-rule.table-name = 'dis-gds-rule':U
     3508     and lookup(buf_dis-cfg-rule.pos-type, 'IBM-XML,Autotank,IBM,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,r-keeper,InfoKiosk,pricecheck-Servis+,Emulator-NKT-IBM,MARIA':U) > 0 then do:
     3509       v-gds-send = yes.
     3510     end.
     3511     if buf_dis-cfg-rule.table-name = 'dis-dc-rule':U
     3512     and lookup(buf_dis-cfg-rule.pos-type, 'IBM-XML,Autotank,IBM,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,r-keeper,InfoKiosk,pricecheck-Servis+,Emulator-NKT-IBM,MARIA':U) > 0 then do:
     3513       v-dc-send = yes.
     3514     end.
     3515     if v-gds-send
     3516     or v-dc-send then leave.
     3517   end.
     3518   if v-gds-send then do:
     3519     for each buf_dis-gds-rule no-lock where
     3520             buf_Dis-gds-rule.rule-num = tb-dis-rule.rule-num:
     3521       if lookup(buf_dis-gds-rule.pos-type, 'IBM-XML,Autotank,IBM,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,r-keeper,InfoKiosk,pricecheck-Servis+,Emulator-NKT-IBM,MARIA':U) > 0 then do:
     3522         run fill-g-list in p-imp-handle ( input buf_dis-gds-rule.gds-code
     3523                                         ,input buf_dis-gds-rule.obj-type
     3524                                         ,input buf_dis-gds-rule.obj-code
     3525                                         ).
     3526       end.
     3527     end.
     3528   end.
     3529   if v-dc-send then do:
     3530     for each buf_dis-dc-rule no-lock where
     3531             buf_dis-dc-rule.rule-num = tb-dis-rule.rule-num,
     3532         first buf_Dis-card no-lock where
     3533              buf_Dis-card.d-card = buf_dis-dc-rule.d-card:
     3534       run fill-dc-list in p-imp-handle ( buffer buf_Dis-card) .
     3535     end.
     3536   end.
     3537       delete wt-dis-rule.
     3538     end.
     3539   END PROCEDURE.
     3540   define temp-table locb1-dis-time-rule     no-undo like ub.dis-time-rule.
     3541   define temp-table wt-dis-time-rule no-undo like ub.dis-time-rule.
     3542   PROCEDURE proc-load-dis-time-rule:
     3543     define input parameter p-imp-handle as handle  no-undo.
     3544     define input parameter p-pck-num    as integer no-undo.
     3545     define input parameter l-counter    as integer no-undo.
     3546     do
     3547     on error  undo, return error substitute( "$proc-load-dis-time-rule. &1&2&3", return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     3548     on stop   undo, return error substitute( "$proc-load-dis-time-rule. stop" )
     3549     on endkey undo, return error substitute( "$proc-load-dis-time-rule. endkey" )
     3550     :
     3551       define buffer tb-dis-time-rule for ub.dis-time-rule.
     3552       define variable compare-log as logical no-undo.
     3553   define variable vss-include-info47 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3554   define buffer buf1_dis-time-rule         for ub.dis-time-rule.
     3555   define variable counter  as integer   no-undo.
     3556   define variable rec-full as character no-undo.
     3557   define variable rec-name as character no-undo.
     3558   def var vss-include-info48 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3559   for each locb1-dis-time-rule
     3560   on error undo, return error error-status :get-message (1)
     3561   :
     3562     delete locb1-dis-time-rule.
     3563   end.
     3564       for each wt-dis-time-rule
     3565       on error undo, return error substitute( "$proc-load-dis-time-rule(del-wt-). &1&2&3", return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     3566       :
     3567         delete wt-dis-time-rule .
     3568       end.
     3569       create wt-dis-time-rule.
     3570       run nws-impl in p-imp-handle
     3571         ( input 'dis-time-rule':U
     3572          ,input (buffer wt-dis-time-rule:handle)
     3573         ) no-error.
     3574       if error-status :error then do:
     3575         return error return-value .
     3576       end.
     3577       find first tb-dis-time-rule
     3578         where tb-dis-time-rule.time-rule-num = wt-dis-time-rule.time-rule-num
     3579         exclusive-lock no-error.
     3580   define variable vss-include-info49 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3581   DO counter = 1 TO l-counter
     3582   on error  undo, return error
     3583   on endkey undo, return error :
     3584   run nws-imps in p-imp-handle
     3585     ( input-output counter
     3586      ,output       rec-full
     3587     ) no-error.
     3588   if error-status :error then do:
     3589     return error substitute( "&1&2&3", return-value, chr(10), error-status :get-message(1) ) .
     3590   end.
     3591     assign
     3592       rec-name = entry( 1, rec-full, chr(1) )
     3593       .
     3594     CASE rec-name :
     3595       when "dis-time-rule" then do:
     3596         create locb1-dis-time-rule.
     3597   run nws-impl in p-imp-handle
     3598     ( input "dis-time-rule":U
     3599      ,input (buffer locb1-dis-time-rule:handle)
     3600     ) no-error.
     3601   if error-status :error then do:
     3602     return error substitute( "&1&2&3", return-value, chr(10), error-status :get-message(1) ) .
     3603   end.
     3604       end.
     3605       otherwise do:
     3606         message "Не предусмотрен прием таблицы " rec-name skip
     3607                 "в составе истории чека"
     3608                 view-as alert-box error.
     3609         return error.
     3610       end.
     3611     END CASE.
     3612   end.
     3613   if not available tb-dis-time-rule then do:
     3614     create tb-dis-time-rule.
     3615   end.
     3616   buffer-copy wt-dis-time-rule to tb-dis-time-rule.
     3617   if wt-dis-time-rule.time-rule-num > 99999 then do:
     3618   for each buf1_dis-time-rule where
     3619           buf1_dis-time-rule.upper-time-rule-num = wt-dis-time-rule.time-rule-num
     3620   on error  undo, return error
     3621   :
     3622       if wt-dis-time-rule.upper-time-rule-num <> 50000 then do:
     3623     delete buf1_dis-time-rule.
     3624   end.
     3625     end.
     3626   for each locb1-dis-time-rule where
     3627           locb1-dis-time-rule.upper-time-rule-num = wt-dis-time-rule.time-rule-num
     3628        no-lock
     3629   on error  undo, return error
     3630   :
     3631       find first buf1_dis-time-rule exclusive-lock where
     3632                 buf1_dis-time-rule.time-rule-num = locb1-dis-time-rule.time-rule-num no-error.
     3633       if not available buf1_dis-time-rule then do:
     3634     create buf1_dis-time-rule.
     3635       end.
     3636     buffer-copy locb1-dis-time-rule to buf1_dis-time-rule.
     3637   end.
     3638   end.
     3639   for each locb1-dis-time-rule
     3640   on error  undo, return error
     3641   :
     3642     delete locb1-dis-time-rule.
     3643   end.
     3644       delete wt-dis-time-rule.
     3645     end.
     3646   END PROCEDURE.
     3647   define temp-table locb-doc-abc-def-obj  no-undo like ub.doc-abc-def-obj.
     3648   define temp-table locb-doc-abc-def-doc  no-undo like ub.doc-abc-def-doc.
     3649   define temp-table wt-doc-abc-def no-undo like ub.doc-abc-def.
