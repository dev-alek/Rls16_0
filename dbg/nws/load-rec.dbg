     2369   on error  undo, return error
     2370   :
     2371     delete buf_c-chk-gds.
     2372   end.
     2373   for each locb2-c-chk-gds where
     2374           locb2-c-chk-gds.doc-code = wt-c-chk-doc.doc-code
     2375      AND  locb2-c-chk-gds.chip-num = wt-c-chk-doc.chip-num    no-lock
     2376   on error  undo, return error
     2377   :
     2378     create buf_c-chk-gds.
     2379     buffer-copy locb2-c-chk-gds to buf_c-chk-gds.
     2380   end.
     2381   for each buf_c-chk-pay where
     2382           buf_c-chk-pay.doc-code = wt-c-chk-doc.doc-code
     2383       AND buf_c-chk-pay.chip-num = wt-c-chk-doc.chip-num
     2384   on error  undo, return error
     2385   :
     2386     delete buf_c-chk-pay.
     2387   end.
     2388   for each locb2-c-chk-pay where
     2389           locb2-c-chk-pay.doc-code = wt-c-chk-doc.doc-code
     2390       AND locb2-c-chk-pay.chip-num = wt-c-chk-doc.chip-num   no-lock
     2391   on error  undo, return error
     2392   :
     2393     create buf_c-chk-pay.
     2394     buffer-copy locb2-c-chk-pay to buf_c-chk-pay.
     2395   end.
     2396   for each buf_c-chk-discnt where
     2397          buf_c-chk-discnt.doc-code = wt-c-chk-doc.doc-code
     2398      AND buf_c-chk-discnt.chip-num = wt-c-chk-doc.chip-num
     2399   on error  undo, return error
     2400   :
     2401     delete buf_c-chk-discnt.
     2402   end.
     2403   for each locb2-c-chk-discnt where
     2404           locb2-c-chk-discnt.doc-code = wt-c-chk-doc.doc-code
     2405       AND locb2-c-chk-discnt.chip-num = wt-c-chk-doc.chip-num  no-lock
     2406   on error  undo, return error
     2407   :
     2408     create buf_c-chk-discnt.
     2409     buffer-copy locb2-c-chk-discnt to buf_c-chk-discnt.
     2410   end.
     2411   for each locb2-c-chk-gds
     2412   on error  undo, return error
     2413   :
     2414     delete locb2-c-chk-gds.
     2415   end.
     2416   for each locb2-c-chk-pay
