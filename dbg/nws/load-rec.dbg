    19049       :
    19050         delete wt-utd .
    19051       end.
    19052       create wt-utd.
    19053       run nws-impl in p-imp-handle
    19054         ( input 'utd':U
    19055          ,input (buffer wt-utd:handle)
    19056         ) no-error.
    19057       if error-status :error then do:
    19058         return error return-value .
