     3978         where tb-esys-route.esys-id = wt-esys-route.esys-id
     3979           and tb-esys-route.db-num = wt-esys-route.db-num
     3980           and tb-esys-route.esr-cr-db-num = wt-esys-route.esr-cr-db-num
     3981           and tb-esys-route.esr-last-pack = wt-esys-route.esr-last-pack
     3982           and tb-esys-route.esr-tbl-ord = wt-esys-route.esr-tbl-ord
     3983         exclusive-lock no-error.
