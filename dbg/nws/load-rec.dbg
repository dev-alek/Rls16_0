    14082   and buf_shift-cash.obj-code eq wt-shift-obj.obj-code
    14083   and buf_shift-cash.shift-date eq wt-shift-obj.shift-date
    14084   and buf_shift-cash.shift-num eq wt-shift-obj.shift-num
    14085   exclusive-lock
    14086   on error  undo, return error
    14087   :
    14088      find first tmprecid where tmprecid.fTable = "buf_shift-cash"
    14089                            and tmprecid.Frecid = recid(buf_shift-cash)
    14090      no-lock no-error.
    14091      if not available tmprecid
    14092      then
    14093         delete buf_shift-cash.
    14094   end.
    14095   empty temp-table tmprecid.
    14096   for each locb-c-shift-staff
    14097   where
    14098   locb-c-shift-staff.obj-type eq wt-shift-obj.obj-type
    14099   and locb-c-shift-staff.obj-code eq wt-shift-obj.obj-code
    14100   and locb-c-shift-staff.shift-date eq wt-shift-obj.shift-date
    14101   and locb-c-shift-staff.shift-num eq wt-shift-obj.shift-num
    14102   no-lock
    14103   on error  undo, return error
    14104   :
    14105    for first buf_c-shift-staff where buf_c-shift-staff.obj-type eq locb-c-shift-staff.obj-type
    14106   and buf_c-shift-staff.obj-code eq locb-c-shift-staff.obj-code
    14107   and buf_c-shift-staff.shift-date eq locb-c-shift-staff.shift-date
    14108   and buf_c-shift-staff.shift-num eq locb-c-shift-staff.shift-num
    14109   and buf_c-shift-staff.next-shift eq locb-c-shift-staff.next-shift
    14110   and buf_c-shift-staff.psn-num eq locb-c-shift-staff.psn-num
    14111   and buf_c-shift-staff.corr-user-db-num eq locb-c-shift-staff.corr-user-db-num
    14112   and buf_c-shift-staff.chip-num eq locb-c-shift-staff.chip-num
    14113      exclusive-lock: leave. end.
    14114      if not available buf_c-shift-staff
    14115      then do:
    14116         create buf_c-shift-staff.
    14117         buffer-copy locb-c-shift-staff to buf_c-shift-staff.
    14118      end.
    14119      else
    14120        buffer-copy locb-c-shift-staff  to buf_c-shift-staff.
    14121      validate buf_c-shift-staff no-error.
    14122      if error-status:error
    14123      then
    14124         return error return-value.
    14125      create tmprecid.
    14126      assign
    14127         tmprecid.fTable = "buf_c-shift-staff"
    14128         tmprecid.Frecid = recid(buf_c-shift-staff)
    14129      .
    14130   end.
    14131   for each buf_c-shift-staff where
    14132   buf_c-shift-staff.obj-type eq wt-shift-obj.obj-type
    14133   and buf_c-shift-staff.obj-code eq wt-shift-obj.obj-code
    14134   and buf_c-shift-staff.shift-date eq wt-shift-obj.shift-date
    14135   and buf_c-shift-staff.shift-num eq wt-shift-obj.shift-num
    14136   exclusive-lock
    14137   on error  undo, return error
    14138   :
    14139      find first tmprecid where tmprecid.fTable = "buf_c-shift-staff"
    14140                            and tmprecid.Frecid = recid(buf_c-shift-staff)
    14141      no-lock no-error.
    14142      if not available tmprecid
    14143      then
    14144         delete buf_c-shift-staff.
    14145   end.
    14146   empty temp-table tmprecid.
    14147   for each locb-c-sht-hist
    14148   where
    14149   locb-c-sht-hist.obj-type eq wt-shift-obj.obj-type
    14150   and locb-c-sht-hist.obj-code eq wt-shift-obj.obj-code
    14151   and locb-c-sht-hist.shift-date eq wt-shift-obj.shift-date
    14152   and locb-c-sht-hist.shift-num eq wt-shift-obj.shift-num
    14153   no-lock
    14154   on error  undo, return error
    14155   :
    14156    for first buf_c-sht-hist where buf_c-sht-hist.obj-type eq locb-c-sht-hist.obj-type
    14157   and buf_c-sht-hist.obj-code eq locb-c-sht-hist.obj-code
    14158   and buf_c-sht-hist.shift-date eq locb-c-sht-hist.shift-date
    14159   and buf_c-sht-hist.shift-num eq locb-c-sht-hist.shift-num
    14160   and buf_c-sht-hist.corr-user-db-num eq locb-c-sht-hist.corr-user-db-num
    14161   and buf_c-sht-hist.chip-num eq locb-c-sht-hist.chip-num
    14162   and buf_c-sht-hist.subject eq locb-c-sht-hist.subject
    14163      exclusive-lock: leave. end.
    14164      if not available buf_c-sht-hist
    14165      then do:
    14166         create buf_c-sht-hist.
    14167         buffer-copy locb-c-sht-hist to buf_c-sht-hist.
    14168      end.
    14169      else
    14170        buffer-copy locb-c-sht-hist  to buf_c-sht-hist.
    14171      validate buf_c-sht-hist no-error.
    14172      if error-status:error
    14173      then
    14174         return error return-value.
    14175      create tmprecid.
    14176      assign
    14177         tmprecid.fTable = "buf_c-sht-hist"
    14178         tmprecid.Frecid = recid(buf_c-sht-hist)
    14179      .
    14180   end.
    14181   for each buf_c-sht-hist where
    14182   buf_c-sht-hist.obj-type eq wt-shift-obj.obj-type
    14183   and buf_c-sht-hist.obj-code eq wt-shift-obj.obj-code
    14184   and buf_c-sht-hist.shift-date eq wt-shift-obj.shift-date
    14185   and buf_c-sht-hist.shift-num eq wt-shift-obj.shift-num
    14186      and buf_c-sht-hist.corr-user-db-num = g#news-source-db
    14187   exclusive-lock
    14188   on error  undo, return error
    14189   :
    14190      find first tmprecid where tmprecid.fTable = "buf_c-sht-hist"
    14191                            and tmprecid.Frecid = recid(buf_c-sht-hist)
    14192      no-lock no-error.
    14193      if not available tmprecid
    14194      then
    14195         delete buf_c-sht-hist.
    14196   end.
    14197   empty temp-table tmprecid.
    14198   for each locb-c-shift-obj
    14199   where
    14200   locb-c-shift-obj.obj-type eq wt-shift-obj.obj-type
    14201   and locb-c-shift-obj.obj-code eq wt-shift-obj.obj-code
    14202   and locb-c-shift-obj.shift-date eq wt-shift-obj.shift-date
    14203   and locb-c-shift-obj.shift-num eq wt-shift-obj.shift-num
    14204   no-lock
    14205   on error  undo, return error
    14206   :
    14207    for first buf_c-shift-obj where buf_c-shift-obj.obj-type eq locb-c-shift-obj.obj-type
    14208   and buf_c-shift-obj.obj-code eq locb-c-shift-obj.obj-code
    14209   and buf_c-shift-obj.shift-date eq locb-c-shift-obj.shift-date
    14210   and buf_c-shift-obj.shift-num eq locb-c-shift-obj.shift-num
    14211   and buf_c-shift-obj.corr-user-db-num eq locb-c-shift-obj.corr-user-db-num
    14212   and buf_c-shift-obj.chip-num eq locb-c-shift-obj.chip-num
    14213      exclusive-lock: leave. end.
    14214      if not available buf_c-shift-obj
    14215      then do:
    14216         create buf_c-shift-obj.
    14217         buffer-copy locb-c-shift-obj to buf_c-shift-obj.
    14218      end.
    14219      else
    14220        buffer-copy locb-c-shift-obj  to buf_c-shift-obj.
    14221      validate buf_c-shift-obj no-error.
    14222      if error-status:error
    14223      then
    14224         return error return-value.
    14225      create tmprecid.
    14226      assign
    14227         tmprecid.fTable = "buf_c-shift-obj"
    14228         tmprecid.Frecid = recid(buf_c-shift-obj)
    14229      .
    14230   end.
    14231   for each buf_c-shift-obj where
    14232   buf_c-shift-obj.obj-type eq wt-shift-obj.obj-type
    14233   and buf_c-shift-obj.obj-code eq wt-shift-obj.obj-code
    14234   and buf_c-shift-obj.shift-date eq wt-shift-obj.shift-date
    14235   and buf_c-shift-obj.shift-num eq wt-shift-obj.shift-num
    14236      and buf_c-shift-obj.corr-user-db-num = g#news-source-db
    14237   exclusive-lock
    14238   on error  undo, return error
    14239   :
    14240      find first tmprecid where tmprecid.fTable = "buf_c-shift-obj"
    14241                            and tmprecid.Frecid = recid(buf_c-shift-obj)
    14242      no-lock no-error.
    14243      if not available tmprecid
    14244      then
    14245         delete buf_c-shift-obj.
    14246   end.
    14247   empty temp-table tmprecid.
    14248   if not available tb-shift-obj then do:
    14249     create tb-shift-obj.
    14250   end.
    14251   buffer-copy wt-shift-obj to tb-shift-obj.
    14252   for each locb-shift-staff
    14253   on error  undo, return error
    14254   on stop   undo, return error
    14255   on endkey undo, return error :
    14256     delete locb-shift-staff.
    14257   end.
    14258   for each locb-shift-cash
    14259   on error  undo, return error
    14260   on stop   undo, return error
    14261   on endkey undo, return error :
    14262     delete locb-shift-cash.
    14263   end.
    14264   for each locb-c-shift-staff
    14265   on error  undo, return error
    14266   on stop   undo, return error
    14267   on endkey undo, return error :
    14268     delete locb-c-shift-staff.
    14269   end.
    14270   for each locb-c-sht-hist
    14271   on error  undo, return error
    14272   on stop   undo, return error
    14273   on endkey undo, return error :
    14274     delete locb-c-sht-hist.
    14275   end.
    14276   for each locb-c-shift-obj
    14277   on error  undo, return error
    14278   on stop   undo, return error
    14279   on endkey undo, return error :
    14280     delete locb-c-shift-obj.
    14281   end.
    14282       delete wt-shift-obj.
    14283     end.
    14284   END PROCEDURE.
    14285   define temp-table locb2-shift-cash no-undo like ub.shift-cash.
    14286   define temp-table locb2-c-shift-staff no-undo like ub.c-shift-staff.
    14287   define temp-table locb2-c-sht-hist no-undo like ub.c-sht-hist.
    14288   define temp-table locb2-c-shift-obj no-undo like ub.c-shift-obj.
    14289   define temp-table wt-c-shift-obj no-undo like ub.c-shift-obj.
    14290   PROCEDURE proc-load-c-shift-obj:
    14291     define input parameter p-imp-handle as handle  no-undo.
    14292     define input parameter p-pck-num    as integer no-undo.
    14293     define input parameter l-counter    as integer no-undo.
    14294     do
    14295     on error  undo, return error substitute( "$proc-load-c-shift-obj. &1&2&3", return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    14296     on stop   undo, return error substitute( "$proc-load-c-shift-obj. stop" )
    14297     on endkey undo, return error substitute( "$proc-load-c-shift-obj. endkey" )
    14298     :
    14299       define buffer tb-c-shift-obj for ub.c-shift-obj.
    14300       define variable compare-log as logical no-undo.
    14301   define variable vss-include-info157 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    14302   define buffer buf_shift-cash for ub.shift-cash.
    14303   define buffer buf_c-shift-staff for ub.c-shift-staff.
    14304   define buffer buf_c-sht-hist for ub.c-sht-hist.
    14305   define buffer buf_c-shift-obj for ub.c-shift-obj.
    14306   define variable counter  as integer   no-undo.
    14307   define variable rec-full as character no-undo.
    14308   define variable rec-name as character no-undo.
    14309   for each locb2-shift-cash
    14310   on error undo, return error error-status :get-message (1)
    14311   :
    14312     delete locb2-shift-cash.
    14313   end.
    14314   for each locb2-c-shift-staff
    14315   on error undo, return error error-status :get-message (1)
    14316   :
    14317     delete locb2-c-shift-staff.
    14318   end.
    14319   for each locb2-c-sht-hist
    14320   on error undo, return error error-status :get-message (1)
    14321   :
    14322     delete locb2-c-sht-hist.
    14323   end.
    14324   for each locb2-c-shift-obj
    14325   on error undo, return error error-status :get-message (1)
    14326   :
    14327     delete locb2-c-shift-obj.
    14328   end.
    14329       for each wt-c-shift-obj
    14330       on error undo, return error substitute( "$proc-load-c-shift-obj(del-wt-). &1&2&3", return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    14331       :
    14332         delete wt-c-shift-obj .
    14333       end.
    14334       create wt-c-shift-obj.
    14335       run nws-impl in p-imp-handle
    14336         ( input 'c-shift-obj':U
    14337          ,input (buffer wt-c-shift-obj:handle)
    14338         ) no-error.
    14339       if error-status :error then do:
    14340         return error return-value .
    14341       end.
    14342       find first tb-c-shift-obj
    14343         where tb-c-shift-obj.obj-type = wt-c-shift-obj.obj-type
    14344           and tb-c-shift-obj.obj-code = wt-c-shift-obj.obj-code
    14345           and tb-c-shift-obj.shift-date = wt-c-shift-obj.shift-date
    14346           and tb-c-shift-obj.shift-num = wt-c-shift-obj.shift-num
    14347           and tb-c-shift-obj.corr-user-db-num = wt-c-shift-obj.corr-user-db-num
    14348           and tb-c-shift-obj.chip-num = wt-c-shift-obj.chip-num
    14349         exclusive-lock no-error.
    14350   define variable vss-include-info158 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    14351   DO counter = 1 TO l-counter
    14352   on error  undo, return error
    14353   on endkey undo, return error :
    14354   run nws-imps in p-imp-handle
    14355     ( input-output counter
    14356      ,output       rec-full
    14357     ) no-error.
    14358   if error-status :error then do:
    14359     return error substitute( "&1&2&3", return-value, chr(10), error-status :get-message(1) ) .
    14360   end.
    14361     assign
    14362       rec-name = entry( 1, rec-full, chr(1) )
    14363       .
    14364     CASE rec-name :
    14365       when "shift-cash" then do:
    14366         create locb2-shift-cash.
    14367   run nws-impl in p-imp-handle
    14368     ( input "shift-cash":U
    14369      ,input (buffer locb2-shift-cash:handle)
    14370     ) no-error.
    14371   if error-status :error then do:
    14372     return error substitute( "&1&2&3", return-value, chr(10), error-status :get-message(1) ) .
    14373   end.
    14374       end.
    14375       when "c-shift-staff" then do:
    14376         create locb2-c-shift-staff.
    14377   run nws-impl in p-imp-handle
    14378     ( input "c-shift-staff":U
    14379      ,input (buffer locb2-c-shift-staff:handle)
    14380     ) no-error.
    14381   if error-status :error then do:
    14382     return error substitute( "&1&2&3", return-value, chr(10), error-status :get-message(1) ) .
    14383   end.
    14384       end.
    14385       when "c-sht-hist" then do:
    14386         create locb2-c-sht-hist.
    14387   run nws-impl in p-imp-handle
    14388     ( input "c-sht-hist":U
    14389      ,input (buffer locb2-c-sht-hist:handle)
    14390     ) no-error.
    14391   if error-status :error then do:
    14392     return error substitute( "&1&2&3", return-value, chr(10), error-status :get-message(1) ) .
    14393   end.
    14394       end.
    14395       when "c-shift-obj" then do:
    14396         create locb2-c-shift-obj.
    14397   run nws-impl in p-imp-handle
    14398     ( input "c-shift-obj":U
    14399      ,input (buffer locb2-c-shift-obj:handle)
    14400     ) no-error.
    14401   if error-status :error then do:
    14402     return error substitute( "&1&2&3", return-value, chr(10), error-status :get-message(1) ) .
    14403   end.
    14404       end.
    14405       otherwise do:
    14406         message "Не предусмотрен прием таблицы " rec-name skip
    14407                 "в составе смен на объекте."
    14408                 view-as alert-box error.
    14409         return error.
    14410       end.
    14411     END CASE.
    14412   end.
    14413   for each buf_shift-cash where buf_shift-cash.obj-type   = wt-c-shift-obj.obj-type
    14414                              and buf_shift-cash.obj-code   = wt-c-shift-obj.obj-code
    14415                              and buf_shift-cash.shift-date = wt-c-shift-obj.shift-date
    14416                              and buf_shift-cash.shift-num  = wt-c-shift-obj.shift-num
    14417   on error  undo, return error
    14418   on stop   undo, return error
    14419   on endkey undo, return error :
    14420     delete buf_shift-cash.
    14421   end.
    14422   for each locb2-shift-cash where locb2-shift-cash.obj-type   = wt-c-shift-obj.obj-type
    14423                               and locb2-shift-cash.obj-code   = wt-c-shift-obj.obj-code
    14424                               and locb2-shift-cash.shift-date = wt-c-shift-obj.shift-date
    14425                               and locb2-shift-cash.shift-num  = wt-c-shift-obj.shift-num
    14426                          no-lock
    14427   on error  undo, return error
    14428   on stop   undo, return error
    14429   on endkey undo, return error :
    14430     create buf_shift-cash.
    14431     buffer-copy locb2-shift-cash to buf_shift-cash.
    14432   end.
    14433   _buf_c-sht-hist:
    14434   for each buf_c-sht-hist where buf_c-sht-hist.obj-type   = wt-c-shift-obj.obj-type
    14435                              and buf_c-sht-hist.obj-code   = wt-c-shift-obj.obj-code
    14436                              and buf_c-sht-hist.shift-date = wt-c-shift-obj.shift-date
    14437                              and buf_c-sht-hist.shift-num  = wt-c-shift-obj.shift-num
    14438                              and buf_c-sht-hist.corr-user-db-num  = wt-c-shift-obj.corr-user-db-num
    14439                              and buf_c-sht-hist.chip-num  <= wt-c-shift-obj.chip-num
    14440   on error  undo, return error
    14441   on stop   undo, return error
    14442   on endkey undo, return error :
    14443      CASE buf_c-sht-hist.subject:
    14444       when 'c-shift-staff':U then do:
    14445         find first buf_c-shift-staff where buf_c-shift-staff.obj-type      = buf_c-sht-hist.obj-type
    14446                                 and buf_c-shift-staff.obj-code         = buf_c-sht-hist.obj-code
    14447                                 and buf_c-shift-staff.shift-date       = buf_c-sht-hist.shift-date
    14448                                 and buf_c-shift-staff.shift-num        = buf_c-sht-hist.shift-num
    14449                                 and buf_c-shift-staff.corr-user-db-num = buf_c-sht-hist.corr-user-db-num
    14450                                 and buf_c-shift-staff.chip-num         = buf_c-sht-hist.chip-num exclusive-lock no-wait no-error .
    14451         if locked(buf_c-shift-staff) then do:
    14452           undo, return error.
    14453         end.
    14454         delete buf_c-shift-staff.
    14455       end.
    14456       when 'c-shift-obj':U then do:
    14457         if buf_c-sht-hist.chip-num  = wt-c-shift-obj.chip-num then NEXT _buf_c-sht-hist.
    14458         find first buf_c-shift-obj where buf_c-shift-obj.obj-type      = buf_c-sht-hist.obj-type
    14459                                 and buf_c-shift-obj.obj-code         = buf_c-sht-hist.obj-code
    14460                                 and buf_c-shift-obj.shift-date       = buf_c-sht-hist.shift-date
    14461                                 and buf_c-shift-obj.shift-num        = buf_c-sht-hist.shift-num
    14462                                 and buf_c-shift-obj.corr-user-db-num = buf_c-sht-hist.corr-user-db-num
    14463                                 and buf_c-shift-obj.chip-num         = buf_c-sht-hist.chip-num exclusive-lock no-wait no-error .
    14464         if locked(buf_c-shift-obj) then do:
    14465           undo, return error.
    14466         end.
    14467         delete buf_c-shift-obj.
    14468       end.
    14469     END CASE.
    14470     delete buf_c-sht-hist.
    14471   end.
    14472   _locb2-c-sht-hist:
    14473   for each locb2-c-sht-hist where locb2-c-sht-hist.obj-type   = wt-c-shift-obj.obj-type
    14474                               and locb2-c-sht-hist.obj-code   = wt-c-shift-obj.obj-code
    14475                               and locb2-c-sht-hist.shift-date = wt-c-shift-obj.shift-date
    14476                               and locb2-c-sht-hist.shift-num  = wt-c-shift-obj.shift-num
    14477                               and locb2-c-sht-hist.corr-user-db-num  = wt-c-shift-obj.corr-user-db-num
    14478                               and locb2-c-sht-hist.chip-num  <= wt-c-shift-obj.chip-num
    14479                          no-lock
    14480   on error  undo, return error
    14481   on stop   undo, return error
    14482   on endkey undo, return error :
    14483     CASE locb2-c-sht-hist.subject:
    14484       when 'shift-staff':U then dO:
    14485         find first locb2-c-shift-staff where locb2-c-shift-staff.obj-type = locb2-c-sht-hist.obj-type
    14486                                 and locb2-c-shift-staff.obj-code         = locb2-c-sht-hist.obj-code
    14487                                 and locb2-c-shift-staff.shift-date       = locb2-c-sht-hist.shift-date
    14488                                 and locb2-c-shift-staff.shift-num        = locb2-c-sht-hist.shift-num
    14489                                 and locb2-c-shift-staff.corr-user-db-num = locb2-c-sht-hist.corr-user-db-num
    14490                                 and locb2-c-shift-staff.chip-num         = locb2-c-sht-hist.chip-num
    14491                           no-lock no-error .
    14492         if available locb2-c-shift-staff then do:
    14493           create buf_c-shift-staff.
    14494           buffer-copy locb2-c-shift-staff to buf_c-shift-staff.
    14495         end.
    14496       end.
    14497       when 'shift-obj':U then dO:
    14498         if locb2-c-sht-hist.chip-num = wt-c-shift-obj.chip-num then NEXT _locb2-c-sht-hist.
    14499         find first locb2-c-shift-obj where locb2-c-shift-obj.obj-type = locb2-c-sht-hist.obj-type
    14500                                 and locb2-c-shift-obj.obj-code         = locb2-c-sht-hist.obj-code
    14501                                 and locb2-c-shift-obj.shift-date       = locb2-c-sht-hist.shift-date
    14502                                 and locb2-c-shift-obj.shift-num        = locb2-c-sht-hist.shift-num
    14503                                 and locb2-c-shift-obj.corr-user-db-num = locb2-c-sht-hist.corr-user-db-num
    14504                                 and locb2-c-shift-obj.chip-num         = locb2-c-sht-hist.chip-num
    14505                           no-lock no-error .
    14506         if available locb2-c-shift-obj then do:
    14507           create buf_c-shift-obj.
    14508           buffer-copy locb2-c-shift-obj to buf_c-shift-obj.
    14509         end.
    14510       end.
    14511     END CASE.
    14512     create buf_c-sht-hist.
    14513     buffer-copy locb2-c-sht-hist to buf_c-sht-hist.
    14514   end.
    14515   if not available tb-c-shift-obj then do:
    14516     create tb-c-shift-obj.
    14517   end.
    14518   buffer-copy wt-c-shift-obj to tb-c-shift-obj.
    14519   for each locb2-shift-cash
    14520   on error  undo, return error
    14521   on stop   undo, return error
    14522   on endkey undo, return error :
    14523     delete locb2-shift-cash.
    14524   end.
    14525   for each locb2-c-shift-staff
    14526   on error  undo, return error
    14527   on stop   undo, return error
    14528   on endkey undo, return error :
    14529     delete locb2-c-shift-staff.
    14530   end.
    14531   for each locb2-c-sht-hist
    14532   on error  undo, return error
    14533   on stop   undo, return error
    14534   on endkey undo, return error :
    14535     delete locb2-c-sht-hist.
    14536   end.
    14537   for each locb2-c-shift-obj
    14538   on error  undo, return error
    14539   on stop   undo, return error
    14540   on endkey undo, return error :
    14541     delete locb2-c-shift-obj.
    14542   end.
    14543       delete wt-c-shift-obj.
    14544     end.
    14545   END PROCEDURE.
    14546   define variable vss-include-info159 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    14547   define temp-table wt-staff no-undo like ub.staff.
    14548   PROCEDURE proc-load-staff:
    14549     define input parameter p-imp-handle as handle  no-undo.
    14550     define input parameter p-pck-num    as integer no-undo.
    14551     define input parameter l-counter    as integer no-undo.
    14552     do
    14553     on error  undo, return error substitute( "$proc-load-staff. &1&2&3", return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    14554     on stop   undo, return error substitute( "$proc-load-staff. stop" )
    14555     on endkey undo, return error substitute( "$proc-load-staff. endkey" )
    14556     :
    14557       define buffer tb-staff for ub.staff.
    14558       define variable compare-log as logical no-undo.
    14559   define variable vss-include-info160 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    14560   DEFINE VARIABLE v-today as date no-undo .
    14561   DEFINE VARIABLE v-time as integer no-undo .
    14562   define variable v-import as logical no-undo init yes.
    14563   define buffer buf_staff for ub.staff .
    14564       for each wt-staff
    14565       on error undo, return error substitute( "$proc-load-staff(del-wt-). &1&2&3", return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    14566       :
    14567         delete wt-staff .
    14568       end.
    14569       create wt-staff.
    14570       run nws-impl in p-imp-handle
    14571         ( input 'staff':U
    14572          ,input (buffer wt-staff:handle)
    14573         ) no-error.
    14574       if error-status :error then do:
    14575         return error return-value .
    14576       end.
    14577       find first tb-staff
    14578         where tb-staff.role = wt-staff.role
    14579           and tb-staff.role-level = wt-staff.role-level
    14580           and tb-staff.work-place = wt-staff.work-place
    14581           and tb-staff.staff-code = wt-staff.staff-code
    14582           and tb-staff.date-start = wt-staff.date-start
    14583         exclusive-lock no-error.
    14584   define variable vss-include-info161 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    14585   if available tb-staff
    14586   and tb-staff.psn-code <> wt-staff.psn-code
    14587   then do:
    14588     if wt-staff.db-num = g#news-source-db
    14589     or (wt-staff.obj-type <> '':U and wt-staff.obj-code <> 0
    14590         and can-find(first ub.clients no-lock where
    14591                           ub.clients.db-num = g#news-source-db
    14592                       and ub.clients.obj-type = wt-staff.obj-type
    14593                       and ub.clients.obj-code = wt-staff.obj-code)) then do:
    14594       if g#db-num = 0 then do:
    14595         delete tb-staff.
    14596       end.
    14597       else do:
    14598         v-import = no.
    14599       end.
    14600     end.
    14601     if wt-staff.db-num = g#db-num
    14602     or (wt-staff.obj-type <> '':U and wt-staff.obj-code <> 0
    14603         and can-find(first ub.clients no-lock where
    14604                           ub.clients.db-num = g#db-num
    14605                       and ub.clients.obj-type = wt-staff.obj-type
    14606                       and ub.clients.obj-code = wt-staff.obj-code)) then do:
    14607       v-import = no.
    14608     end.
    14609   end.
    14610   for each buf_staff where
    14611             buf_staff.role = wt-staff.role
    14612        and  buf_staff.role-level = wt-staff.role-level
    14613        and  buf_staff.work-place = wt-staff.work-place
    14614        and  buf_staff.staff-code = wt-staff.staff-code
    14615        and  buf_staff.date-end >= wt-staff.date-start
    14616    by buf_staff.date-start
    14617    on error undo, return error
    14618    on stop undo, return error
    14619    :
    14620     IF buf_staff.psn-code = wt-staff.psn-code then do:
    14621       if buf_staff.date-end = 12/31/9999
    14622       then do:
    14623         if buf_staff.date-start = wt-staff.date-start then do:
    14624         buf_staff.date-end = wt-staff.date-end.
    14625           v-import = no.
    14626           leave.
    14627       end.
    14628       else do:
    14629           v-import = no.
    14630           leave.
    14631         end.
    14632       end.
    14633       else do:
    14634         if buf_staff.date-start = wt-staff.date-start
    14635           and ( wt-staff.db-num = g#news-source-db
    14636                 or ( wt-staff.obj-type <> '':U
    14637                      and wt-staff.obj-code <> 0
    14638                      and can-find(first ub.clients no-lock where
    14639                                         ub.clients.db-num = g#news-source-db
    14640                                     and ub.clients.obj-type = wt-staff.obj-type
    14641                                     and ub.clients.obj-code = wt-staff.obj-code
    14642                                   )
    14643                    )
    14644               )
    14645         then do:
    14646           buf_staff.date-end = wt-staff.date-end.
    14647           v-import = no.
    14648           leave.
    14649         end.
    14650         else do:
    14651           v-import = no.
    14652         end.
    14653       end.
    14654       if buf_staff.date-end < wt-staff.date-end then do:
    14655         if buf_staff.date-start = wt-staff.date-start then do:
    14656           buf_staff.date-end = wt-staff.date-end.
    14657           v-import = yes.
    14658           leave.
    14659         end.
    14660       end.
    14661     end.
    14662     else do:
    14663       if buf_staff.date-start < wt-staff.date-start
    14664       and wt-staff.date-start >= v-today + 1 then do:
    14665         assign
    14666         buf_staff.date-end = (if buf_staff.date-end - wt-staff.date-start >= 1
    14667                               then wt-staff.date-start - 1
    14668                               else buf_staff.date-end)
    14669                               .
    14670       end.
    14671       else do:
    14672         if wt-staff.db-num = g#news-source-db
    14673         or (wt-staff.obj-type <> '':U and wt-staff.obj-code <> 0
    14674             and can-find(first ub.clients no-lock where
    14675                               ub.clients.db-num = g#news-source-db
    14676                           and ub.clients.obj-type = wt-staff.obj-type
    14677                           and ub.clients.obj-code = wt-staff.obj-code)) then do:
    14678           if g#db-num = 0 then do:
    14679             delete buf_staff.
    14680           end.
    14681           else do:
    14682             v-import = no.
    14683           end.
    14684         end.
    14685         if wt-staff.db-num = g#db-num
    14686         or (wt-staff.obj-type <> '':U and wt-staff.obj-code <> 0
    14687             and can-find(first ub.clients no-lock where
    14688                               ub.clients.db-num = g#db-num
    14689                           and ub.clients.obj-type = wt-staff.obj-type
    14690                           and ub.clients.obj-code = wt-staff.obj-code)) then do:
    14691           v-import = no.
    14692         end.
    14693       END.
    14694     end.
    14695   END.
    14696   if v-import = yes then do:
    14697     IF NOT AVAILABLE Tb-STAFF then DO:
    14698       CREATE TB-STAFF.
    14699     END.
    14700     BUFFER-COPY wt-staff to tb-staff.
    14701   end.
    14702   if v-import = no then do:
    14703     if available Tb-STAFF then do:
    14704         Tb-STAFF.password = wt-staff.password.
    14705     end.
    14706   end.
    14707       delete wt-staff.
    14708     end.
    14709   END PROCEDURE.
    14710   define temp-table locb-stop-list-line no-undo like ub.stop-list-line.
    14711   define temp-table locb-c-stop-list-line no-undo like ub.c-stop-list-line.
    14712   define temp-table locb-c-stop-list no-undo like ub.c-stop-list.
    14713   define temp-table wt-stop-list no-undo like ub.stop-list.
    14714   PROCEDURE proc-load-stop-list:
    14715     define input parameter p-imp-handle as handle  no-undo.
    14716     define input parameter p-pck-num    as integer no-undo.
    14717     define input parameter l-counter    as integer no-undo.
    14718     do
    14719     on error  undo, return error substitute( "$proc-load-stop-list. &1&2&3", return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    14720     on stop   undo, return error substitute( "$proc-load-stop-list. stop" )
    14721     on endkey undo, return error substitute( "$proc-load-stop-list. endkey" )
    14722     :
    14723       define buffer tb-stop-list for ub.stop-list.
    14724       define variable compare-log as logical no-undo.
    14725   define variable vss-include-info162 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    14726   define buffer buf_stop-list-line for ub.stop-list-line.
    14727   define buffer buf_c-stop-list-line for ub.c-stop-list-line.
    14728   define buffer buf_c-stop-list for ub.c-stop-list.
    14729   define variable counter  as integer   no-undo.
    14730   define variable rec-full as character no-undo.
    14731   define variable rec-name as character no-undo.
    14732   define variable v-to-send as logical no-undo .
    14733   for each locb-stop-list-line
    14734   on error undo, return error error-status :get-message (1)
    14735   :
    14736     delete locb-stop-list-line.
    14737   end.
    14738   for each locb-c-stop-list-line
    14739   on error undo, return error error-status :get-message (1)
    14740   :
    14741     delete locb-c-stop-list-line.
    14742   end.
    14743   for each locb-c-stop-list
    14744   on error undo, return error error-status :get-message (1)
    14745   :
    14746     delete locb-c-stop-list.
    14747   end.
    14748       for each wt-stop-list
    14749       on error undo, return error substitute( "$proc-load-stop-list(del-wt-). &1&2&3", return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    14750       :
    14751         delete wt-stop-list .
    14752       end.
    14753       create wt-stop-list.
    14754       run nws-impl in p-imp-handle
    14755         ( input 'stop-list':U
    14756          ,input (buffer wt-stop-list:handle)
    14757         ) no-error.
    14758       if error-status :error then do:
    14759         return error return-value .
    14760       end.
    14761       find first tb-stop-list
    14762         where tb-stop-list.classif-type = wt-stop-list.classif-type
    14763           and tb-stop-list.stop-list-code = wt-stop-list.stop-list-code
    14764         exclusive-lock no-error.
    14765   define variable vss-include-info163 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    14766   DO counter = 1 TO l-counter
    14767   on error  undo, return error
    14768   on endkey undo, return error :
    14769   run nws-imps in p-imp-handle
    14770     ( input-output counter
    14771      ,output       rec-full
    14772     ) no-error.
    14773   if error-status :error then do:
    14774     return error substitute( "&1&2&3", return-value, chr(10), error-status :get-message(1) ) .
    14775   end.
    14776     assign
    14777       rec-name = entry( 1, rec-full, chr(1) )
    14778       .
    14779     CASE rec-name :
    14780       when "stop-list-line" then do:
    14781         create locb-stop-list-line.
    14782   run nws-impl in p-imp-handle
    14783     ( input "stop-list-line":U
    14784      ,input (buffer locb-stop-list-line:handle)
    14785     ) no-error.
    14786   if error-status :error then do:
    14787     return error substitute( "&1&2&3", return-value, chr(10), error-status :get-message(1) ) .
    14788   end.
    14789       end.
    14790       when "c-stop-list-line" then do:
    14791         create locb-c-stop-list-line.
    14792   run nws-impl in p-imp-handle
    14793     ( input "c-stop-list-line":U
    14794      ,input (buffer locb-c-stop-list-line:handle)
    14795     ) no-error.
    14796   if error-status :error then do:
    14797     return error substitute( "&1&2&3", return-value, chr(10), error-status :get-message(1) ) .
    14798   end.
    14799       end.
    14800       when "c-stop-list" then do:
    14801         create locb-c-stop-list.
    14802   run nws-impl in p-imp-handle
    14803     ( input "c-stop-list":U
    14804      ,input (buffer locb-c-stop-list:handle)
    14805     ) no-error.
    14806   if error-status :error then do:
    14807     return error substitute( "&1&2&3", return-value, chr(10), error-status :get-message(1) ) .
    14808   end.
    14809       end.
    14810       otherwise do:
    14811         message "nws/inc/imp/stop-l.i: Не предусмотрен прием таблицы " rec-name skip
    14812                 "в составе накладной"
    14813                 view-as alert-box error.
    14814         return error "nws/inc/imp/stop-l.i: Не предусмотрен прием таблицы " + rec-name + chr(10) + "в составе накладной".
    14815       end.
    14816     END CASE.
    14817   end.
    14818   if not available tb-stop-list then do:
    14819     if wt-stop-list.status_ = 'факт':U then do:
    14820        v-to-send = yes.
    14821      end.
    14822     create tb-stop-list.
    14823   end.
    14824   else do:
    14825     if wt-stop-list.status_ = 'факт':U
    14826     and tb-stop-list.status_ <> 'факт':U then do:
    14827       v-to-send = yes.
    14828     end.
    14829   end.
    14830   define variable v-old-stop-list-status as character no-undo .
    14831   define variable v-new-stop-list-status as character no-undo .
    14832   assign
    14833     v-old-stop-list-status = tb-stop-list.status_
    14834     v-new-stop-list-status = wt-stop-list.status_
    14835   .
    14836   run trg/nwsdochs.p
    14837     (input g#db-num
    14838     ,input 'update':U
    14839     ,input wt-stop-list.stop-list-code
    14840     ,input wt-stop-list.obj-type
    14841     ,input wt-stop-list.obj-code
    14842     ,input 'stop-list':U
    14843     ,input wt-stop-list.list-type
    14844     ,input wt-stop-list.fact-date
    14845     ,input 0
    14846     ,input 0
    14847     ,input 0
    14848     ,input 0
    14849     ,input v-old-stop-list-status
    14850     ,input v-new-stop-list-status
    14851     ,input g#news-source-db
    14852     ,input p-pck-num
    14853     ,input wt-stop-list.user-db-num
    14854     ,input wt-stop-list.user-name
    14855     ,input wt-stop-list.sys-date
    14856     ,input wt-stop-list.sys-time
    14857     ,input wt-stop-list.sys-time-int
    14858     ) no-error .
    14859   if error-status :error then do:
    14860     run write-to-log in this-procedure
    14861       (input substitute("&1 &2", error-status :get-message(1), return-value )
    14862       ) .
    14863     undo, return error .
    14864   end.
    14865   buffer-copy wt-stop-list to tb-stop-list.
    14866   for each buf_stop-list-line where
    14867          buf_stop-list-line.classif-type = wt-stop-list.classif-type
    14868      and buf_stop-list-line.stop-list-code = wt-stop-list.stop-list-code
    14869   on error  undo, return error
    14870   :
    14871     delete buf_stop-list-line.
    14872   end.
    14873   for each buf_c-stop-list-line where
    14874          buf_c-stop-list-line.classif-type = wt-stop-list.classif-type
    14875      and buf_c-stop-list-line.stop-list-code = wt-stop-list.stop-list-code
    14876   on error  undo, return error
    14877   :
    14878     delete buf_c-stop-list-line.
    14879   end.
    14880   for each buf_c-stop-list where
    14881          buf_c-stop-list.classif-type = wt-stop-list.classif-type
    14882      and buf_c-stop-list.stop-list-code = wt-stop-list.stop-list-code
    14883   on error  undo, return error
    14884   :
    14885     delete buf_c-stop-list.
    14886   end.
    14887   for each locb-stop-list-line where
    14888           locb-stop-list-line.classif-type = wt-stop-list.classif-type
    14889       and locb-stop-list-line.stop-list-code = wt-stop-list.stop-list-code
    14890                           no-lock
    14891   on error  undo, return error
    14892   :
    14893     create buf_stop-list-line.
    14894     buffer-copy locb-stop-list-line to buf_stop-list-line.
    14895   end.
    14896   for each locb-c-stop-list-line where
    14897           locb-c-stop-list-line.classif-type = wt-stop-list.classif-type
    14898       and locb-c-stop-list-line.stop-list-code = wt-stop-list.stop-list-code
    14899                           no-lock
    14900   on error  undo, return error
    14901   :
    14902     create buf_c-stop-list-line.
    14903     buffer-copy locb-c-stop-list-line to buf_c-stop-list-line.
    14904   end.
    14905   for each locb-c-stop-list where
    14906           locb-c-stop-list.classif-type = wt-stop-list.classif-type
    14907       and locb-c-stop-list.stop-list-code = wt-stop-list.stop-list-code
    14908                           no-lock
    14909   on error  undo, return error
    14910   :
    14911     create buf_c-stop-list.
    14912     buffer-copy locb-c-stop-list to buf_c-stop-list.
    14913   end.
    14914   for each locb-stop-list-line
    14915   on error  undo, return error
    14916   :
    14917     delete locb-stop-list-line.
    14918   end.
    14919   for each locb-c-stop-list-line
    14920   on error  undo, return error
    14921   :
    14922     delete locb-c-stop-list-line.
    14923   end.
    14924   for each locb-c-stop-list
    14925   on error  undo, return error
    14926   :
    14927     delete locb-c-stop-list.
    14928   end.
    14929   if v-to-send then do:
    14930     run fill-stpl-list in p-imp-handle ( buffer tb-stop-list).
    14931   end.
    14932       delete wt-stop-list.
    14933     end.
    14934   END PROCEDURE.
    14935   define temp-table locb-sum-group           no-undo like  ub.sum-group.
    14936   define temp-table locb-sum-in-sum-group    no-undo like  ub.sum-in-sum-group.
    14937   define temp-table locb-c-sum-group         no-undo like  ub.c-sum-group.
    14938   define temp-table locb-c-sum-in-sum-group  no-undo like  ub.c-sum-in-sum-group.
    14939   define temp-table wt-sum-group no-undo like ub.sum-group.
    14940   PROCEDURE proc-load-sum-group:
    14941     define input parameter p-imp-handle as handle  no-undo.
    14942     define input parameter p-pck-num    as integer no-undo.
    14943     define input parameter l-counter    as integer no-undo.
    14944     do
    14945     on error  undo, return error substitute( "$proc-load-sum-group. &1&2&3", return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    14946     on stop   undo, return error substitute( "$proc-load-sum-group. stop" )
    14947     on endkey undo, return error substitute( "$proc-load-sum-group. endkey" )
    14948     :
    14949       define buffer tb-sum-group for ub.sum-group.
    14950       define variable compare-log as logical no-undo.
    14951   define variable vss-include-info164 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    14952   define buffer buf_sum-group          for ub.sum-group.
    14953   define buffer buf_sum-in-sum-group   for ub.sum-in-sum-group.
    14954   define buffer buf_c-sum-group        for ub.c-sum-group.
    14955   define buffer buf_c-sum-in-sum-group for ub.c-sum-in-sum-group.
    14956   define variable counter  as   integer   no-undo.
    14957   define variable rec-full as   character no-undo.
    14958   define variable rec-name as   character no-undo.
    14959   for each locb-sum-group
    14960   on error  undo, return error
    14961   :
    14962     delete locb-sum-group.
    14963   end.
    14964   for each locb-c-sum-group
    14965   on error  undo, return error
    14966   :
    14967     delete locb-c-sum-group.
    14968   end.
    14969   for each locb-sum-in-sum-group
    14970   on error  undo, return error
    14971   :
    14972     delete locb-sum-in-sum-group.
    14973   end.
    14974   for each locb-c-sum-in-sum-group
    14975   on error  undo, return error
    14976   :
    14977     delete locb-c-sum-in-sum-group.
    14978   end.
    14979       for each wt-sum-group
    14980       on error undo, return error substitute( "$proc-load-sum-group(del-wt-). &1&2&3", return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    14981       :
    14982         delete wt-sum-group .
    14983       end.
    14984       create wt-sum-group.
    14985       run nws-impl in p-imp-handle
    14986         ( input 'sum-group':U
    14987          ,input (buffer wt-sum-group:handle)
    14988         ) no-error.
    14989       if error-status :error then do:
    14990         return error return-value .
    14991       end.
    14992       find first tb-sum-group
    14993         where tb-sum-group.sgr-id = wt-sum-group.sgr-id
    14994           and tb-sum-group.sgr-db-num = wt-sum-group.sgr-db-num
    14995         exclusive-lock no-error.
    14996   define variable vss-include-info165 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    14997   DO counter = 1 TO l-counter
    14998   on error  undo, return error
    14999   on endkey undo, return error :
    15000   run nws-imps in p-imp-handle
    15001     ( input-output counter
    15002      ,output       rec-full
    15003     ) no-error.
    15004   if error-status :error then do:
    15005     return error substitute( "&1&2&3", return-value, chr(10), error-status :get-message(1) ) .
    15006   end.
    15007     assign
    15008       rec-name = entry( 1, rec-full, chr(1) )
    15009       .
    15010     CASE rec-name :
    15011       when "sum-in-sum-group" then do:
    15012         create locb-sum-in-sum-group.
    15013   run nws-impl in p-imp-handle
    15014     ( input "sum-in-sum-group":U
    15015      ,input (buffer locb-sum-in-sum-group:handle)
    15016     ) no-error.
    15017   if error-status :error then do:
    15018     return error substitute( "&1&2&3", return-value, chr(10), error-status :get-message(1) ) .
    15019   end.
    15020       end.
    15021       when "c-sum-group" then do:
    15022         create locb-c-sum-group.
    15023   run nws-impl in p-imp-handle
    15024     ( input "c-sum-group":U
    15025      ,input (buffer locb-c-sum-group:handle)
    15026     ) no-error.
    15027   if error-status :error then do:
    15028     return error substitute( "&1&2&3", return-value, chr(10), error-status :get-message(1) ) .
    15029   end.
    15030       end.
    15031       when "c-sum-in-sum-group" then do:
    15032         create locb-c-sum-in-sum-group.
    15033   run nws-impl in p-imp-handle
    15034     ( input "c-sum-in-sum-group":U
    15035      ,input (buffer locb-c-sum-in-sum-group:handle)
    15036     ) no-error.
    15037   if error-status :error then do:
    15038     return error substitute( "&1&2&3", return-value, chr(10), error-status :get-message(1) ) .
    15039   end.
    15040       end.
    15041       otherwise do:
    15042         message "Не предуcмотрен прием таблицы " rec-name skip
    15043                 "в cоcтаве куcта."
    15044                 view-as alert-box error.
    15045         return error.
    15046       end.
    15047     END CASE.
    15048   end.
    15049   for each buf_c-sum-group where buf_c-sum-group.sgr-id = wt-sum-group.sgr-id
    15050                              and buf_c-sum-group.sgr-db-num = wt-sum-group.sgr-db-num
    15051   on error  undo, return error
    15052   :
    15053     delete buf_c-sum-group.
    15054   end.
    15055   for each locb-c-sum-group where locb-c-sum-group.sgr-id     = wt-sum-group.sgr-id
    15056                               and locb-c-sum-group.sgr-db-num = wt-sum-group.sgr-db-num
    15057     no-lock
    15058   on error  undo, return error
    15059   :
    15060     create buf_c-sum-group.
    15061     buffer-copy  locb-c-sum-group to buf_c-sum-group.
    15062   end.
    15063   for each buf_sum-in-sum-group where buf_sum-in-sum-group.sgr-id     = wt-sum-group.sgr-id
    15064                                   and buf_sum-in-sum-group.sgr-db-num = wt-sum-group.sgr-db-num
    15065   on error  undo, return error
    15066   :
    15067     delete buf_sum-in-sum-group.
    15068   end.
    15069   for each locb-sum-in-sum-group where locb-sum-in-sum-group.sgr-id     = wt-sum-group.sgr-id
    15070                                     and locb-sum-in-sum-group.sgr-db-num = wt-sum-group.sgr-db-num
    15071   no-lock
    15072   on error  undo, return error
    15073   :
    15074     create buf_sum-in-sum-group.
    15075     buffer-copy locb-sum-in-sum-group to buf_sum-in-sum-group.
    15076   end.
    15077   for each buf_c-sum-in-sum-group where buf_c-sum-in-sum-group.sgr-id     = wt-sum-group.sgr-id
    15078                                     and buf_c-sum-in-sum-group.sgr-db-num = wt-sum-group.sgr-db-num
    15079   on error  undo, return error
    15080   :
    15081     delete buf_c-sum-in-sum-group.
    15082   end.
    15083   for each locb-c-sum-in-sum-group where locb-c-sum-in-sum-group.sgr-id = wt-sum-group.sgr-id
    15084                                       and locb-c-sum-in-sum-group.sgr-db-num = wt-sum-group.sgr-db-num
    15085   no-lock
    15086   on error  undo, return error
    15087   :
    15088     create buf_c-sum-in-sum-group.
    15089     buffer-copy locb-c-sum-in-sum-group to buf_c-sum-in-sum-group.
    15090   end.
    15091   if not available tb-sum-group then do:
    15092     create tb-sum-group.
    15093   end.
    15094   buffer-copy wt-sum-group to tb-sum-group.
    15095   for each locb-c-sum-group
    15096   on error  undo, return error
    15097   :
    15098     delete locb-c-sum-group.
    15099   end.
    15100   for each locb-sum-in-sum-group
    15101   on error  undo, return error
    15102   :
    15103     delete locb-sum-in-sum-group.
    15104   end.
    15105   for each locb-c-sum-in-sum-group
    15106   on error  undo, return error
    15107   :
    15108     delete locb-c-sum-in-sum-group.
    15109   end.
    15110       delete wt-sum-group.
    15111     end.
    15112   END PROCEDURE.
    15113   define temp-table wt-tax no-undo like ub.tax.
    15114   PROCEDURE proc-load-tax:
    15115     define input parameter p-imp-handle as handle  no-undo.
    15116     define input parameter p-pck-num    as integer no-undo.
    15117     define input parameter l-counter    as integer no-undo.
    15118     do
    15119     on error  undo, return error substitute( "$proc-load-tax. &1&2&3", return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    15120     on stop   undo, return error substitute( "$proc-load-tax. stop" )
    15121     on endkey undo, return error substitute( "$proc-load-tax. endkey" )
    15122     :
    15123       define buffer tb-tax for ub.tax.
    15124       define variable compare-log as logical no-undo.
    15125       for each wt-tax
    15126       on error undo, return error substitute( "$proc-load-tax(del-wt-). &1&2&3", return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    15127       :
    15128         delete wt-tax .
    15129       end.
    15130       create wt-tax.
    15131       run nws-impl in p-imp-handle
    15132         ( input 'tax':U
    15133          ,input (buffer wt-tax:handle)
    15134         ) no-error.
    15135       if error-status :error then do:
    15136         return error return-value .
    15137       end.
    15138       find first tb-tax
    15139         where tb-tax.tax-code = wt-tax.tax-code
    15140         exclusive-lock no-error.
    15141   define variable vss-include-info166 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    15142   if not available tb-tax then do:
    15143     create tb-tax.
    15144     assign compare-log = no.
    15145   end.
    15146   else do:
    15147     buffer-compare tb-tax TO wt-tax case-sensitive save result in compare-log no-error.
    15148   end.
    15149   if not compare-log then do:
    15150     buffer-copy wt-tax TO tb-tax.
    15151     if tb-tax.to-cashdesk = yes then do:
    15152       run fill-cash-txn in p-imp-handle ( buffer tb-tax).
    15153     end.
    15154   end.
    15155       delete wt-tax.
    15156     end.
    15157   END PROCEDURE.
    15158   define temp-table wt-tax-rate no-undo like ub.tax-rate.
