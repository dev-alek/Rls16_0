     1873     on stop   undo, return error substitute( "$proc-load-bar-code. stop" )
     1874     on endkey undo, return error substitute( "$proc-load-bar-code. endkey" )
     1875     :
     1876       define buffer tb-bar-code for ub.bar-code.
     1877       define variable compare-log as logical no-undo.
