     6797   run nws-impl in p-imp-handle
     6798     ( input "obj-grp-obj-price":U
     6799      ,input (buffer locb-obj-grp-obj-price:handle)
     6800     ) no-error.
     6801   if error-status :error then do:
     6802     return error substitute( "&1&2&3", return-value, chr(10), error-status :get-message(1) ) .
     6803   end.
     6804       end.
     6805       otherwise do:
     6806         message "Не предуcмотрен прием таблицы " rec-name skip
     6807                 "в cоcтаве куcта."
     6808                 view-as alert-box error.
     6809         return error.
     6810       end.
     6811     END CASE.
     6812   end.
     6813   for each buf_host-grp-obj-price where buf_host-grp-obj-price.gop-id = wt-grp-obj-price.gop-id
     6814                               and buf_host-grp-obj-price.gop-db-num = wt-grp-obj-price.gop-db-num
     6815   on error  undo, return error
     6816   :
     6817     delete buf_host-grp-obj-price.
     6818   end.
     6819   for each locb-host-grp-obj-price where locb-host-grp-obj-price.gop-id     = wt-grp-obj-price.gop-id
     6820                                and locb-host-grp-obj-price.gop-db-num = wt-grp-obj-price.gop-db-num
     6821     no-lock
