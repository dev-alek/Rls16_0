    18891   define temp-table wt-code no-undo like ub.code.
    18892   PROCEDURE proc-load-code:
    18893     define input parameter p-imp-handle as handle  no-undo.
    18894     define input parameter p-pck-num    as integer no-undo.
    18895     define input parameter l-counter    as integer no-undo.
    18896     do
    18897     on error  undo, return error substitute( "$proc-load-code. &1&2&3", return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    18898     on stop   undo, return error substitute( "$proc-load-code. stop" )
    18899     on endkey undo, return error substitute( "$proc-load-code. endkey" )
    18900     :
    18901       define buffer tb-code for ub.code.
    18902       define variable compare-log as logical no-undo.
    18903       for each wt-code
    18904       on error undo, return error substitute( "$proc-load-code(del-wt-). &1&2&3", return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    18905       :
    18906         delete wt-code .
    18907       end.
    18908       create wt-code.
    18909       run nws-impl in p-imp-handle
    18910         ( input 'Code':U
    18911          ,input (buffer wt-code:handle)
    18912         ) no-error.
    18913       if error-status :error then do:
    18914         return error return-value .
    18915       end.
    18916       find first tb-code
    18917         where tb-code.parent = wt-code.parent
    18918           and tb-code.code = wt-code.code
    18919         exclusive-lock no-error.
    18920   define variable vss-include-info192 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    18921   if not available tb-code then
    18922   do:
    18923      create tb-code.
    18924      assign
    18925         compare-log = no.
    18926   end.
    18927   else
    18928   do:
    18929      buffer-compare tb-code TO wt-code case-sensitive save result in compare-log no-error.
    18930   end.
    18931   if not compare-log then
    18932   do:
    18933      buffer-copy wt-code TO tb-code.
    18934      run fill-code in p-imp-handle (input tb-code.parent
    18935                                    ,input tb-code.code
    18936         ).
    18937   end.
    18938       delete wt-code.
    18939     end.
    18940   END PROCEDURE.
