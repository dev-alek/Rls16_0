     6756       find first tb-grp-obj-price
     6757         where tb-grp-obj-price.gop-id = wt-grp-obj-price.gop-id
     6758           and tb-grp-obj-price.gop-db-num = wt-grp-obj-price.gop-db-num
     6759         exclusive-lock no-error.
     6760   define variable vss-include-info98 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6761   DO counter = 1 TO l-counter
