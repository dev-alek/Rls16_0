     2817   on error  undo, return error
     2818   on endkey undo, return error :
     2819   run nws-imps in p-imp-handle
     2820     ( input-output counter
     2821      ,output       rec-full
     2822     ) no-error.
     2823   if error-status :error then do:
     2824     return error substitute( "&1&2&3", return-value, chr(10), error-status :get-message(1) ) .
     2825   end.
     2826     assign
     2827       rec-name = entry( 1, rec-full, chr(1) )
     2828       .
     2829     CASE rec-name :
     2830       when "contract-specif-attr" then do:
     2831         create locb-contract-specif-attr.
     2832   run nws-impl in p-imp-handle
     2833     ( input "contract-specif-attr":U
     2834      ,input (buffer locb-contract-specif-attr:handle)
     2835     ) no-error.
     2836   if error-status :error then do:
     2837     return error substitute( "&1&2&3", return-value, chr(10), error-status :get-message(1) ) .
     2838   end.
     2839       end.
     2840       otherwise do:
     2841         message "Не предусмотрен прием таблицы " rec-name skip "в составе договора." view-as alert-box error.
     2842         return error.
     2843       end.
     2844     END CASE.
     2845   end.
     2846   for each buf_contract-specif-attr
     2847     where buf_contract-specif-attr.contract-num = wt-contract-specif.contract-num
     2848       and buf_contract-specif-attr.host-code    = wt-contract-specif.host-code
     2849       and buf_contract-specif-attr.gds-code     = wt-contract-specif.gds-code
     2850   on error  undo, return error substitute( "&1. &2&3&4", vss-include-info31, return-value, chr(10), error-status :get-message ( 1 ) )
     2851   :
     2852     delete buf_contract-specif-attr.
     2853   end.
     2854   for each locb-contract-specif-attr no-lock
     2855     where locb-contract-specif-attr.contract-num = wt-contract-specif.contract-num
     2856       and locb-contract-specif-attr.host-code    = wt-contract-specif.host-code
     2857       and locb-contract-specif-attr.gds-code     = wt-contract-specif.gds-code
     2858   on error  undo, return error substitute( "&1. &2&3&4", vss-include-info31, return-value, chr(10), error-status :get-message ( 1 ) )
     2859   :
     2860     create buf_contract-specif-attr.
     2861     buffer-copy locb-contract-specif-attr to buf_contract-specif-attr.
     2862   end.
     2863   if not available tb-contract-specif then do:
     2864     create tb-contract-specif.
     2865   end.
     2866   buffer-copy wt-contract-specif to tb-contract-specif.
     2867   for each locb-contract-specif-attr
     2868   on error  undo, return error substitute( "&1. &2&3&4", vss-include-info31, return-value, chr(10), error-status :get-message ( 1 ) )
     2869   :
     2870     delete locb-contract-specif-attr.
     2871   end.
     2872       delete wt-contract-specif.
     2873     end.
