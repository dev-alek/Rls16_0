    17823     ) no-error.
    17824   if error-status :error then do:
    17825     return error substitute( "&1&2&3", return-value, chr(10), error-status :get-message(1) ) .
    17826   end.
    17827       end.
    17828       when "chk-doc" then do:
    17829         create locbw-chk-doc.
    17830   run nws-impl in p-imp-handle
    17831     ( input "chk-doc":U
    17832      ,input (buffer locbw-chk-doc:handle)
    17833     ) no-error.
    17834   if error-status :error then do:
    17835     return error substitute( "&1&2&3", return-value, chr(10), error-status :get-message(1) ) .
    17836   end.
    17837       end.
    17838       when "chk-pay" then do:
    17839         create locbw-chk-pay.
    17840   run nws-impl in p-imp-handle
    17841     ( input "chk-pay":U
    17842      ,input (buffer locbw-chk-pay:handle)
    17843     ) no-error.
    17844   if error-status :error then do:
    17845     return error substitute( "&1&2&3", return-value, chr(10), error-status :get-message(1) ) .
    17846   end.
    17847       end.
    17848       when "c-chk-doc" then do:
    17849         create locbw-c-chk-doc.
    17850   run nws-impl in p-imp-handle
    17851     ( input "c-chk-doc":U
    17852      ,input (buffer locbw-c-chk-doc:handle)
    17853     ) no-error.
    17854   if error-status :error then do:
    17855     return error substitute( "&1&2&3", return-value, chr(10), error-status :get-message(1) ) .
    17856   end.
    17857       end.
    17858       when "c-chk-pay" then do:
    17859         create locbw-c-chk-pay.
    17860   run nws-impl in p-imp-handle
    17861     ( input "c-chk-pay":U
    17862      ,input (buffer locbw-c-chk-pay:handle)
    17863     ) no-error.
    17864   if error-status :error then do:
    17865     return error substitute( "&1&2&3", return-value, chr(10), error-status :get-message(1) ) .
    17866   end.
    17867       end.
    17868       when "c-wth-doc" then do:
    17869         create locbw-c-wth-doc.
    17870   run nws-impl in p-imp-handle
    17871     ( input "c-wth-doc":U
    17872      ,input (buffer locbw-c-wth-doc:handle)
    17873     ) no-error.
    17874   if error-status :error then do:
    17875     return error substitute( "&1&2&3", return-value, chr(10), error-status :get-message(1) ) .
    17876   end.
    17877       end.
    17878       when "c-wth-line" then do:
    17879         create locbw-c-wth-line.
    17880   run nws-impl in p-imp-handle
    17881     ( input "c-wth-line":U
    17882      ,input (buffer locbw-c-wth-line:handle)
    17883     ) no-error.
    17884   if error-status :error then do:
    17885     return error substitute( "&1&2&3", return-value, chr(10), error-status :get-message(1) ) .
    17886   end.
    17887       end.
    17888       when "c-wth-dtl" then do:
    17889         create locbw-c-wth-dtl.
    17890   run nws-impl in p-imp-handle
    17891     ( input "c-wth-dtl":U
    17892      ,input (buffer locbw-c-wth-dtl:handle)
    17893     ) no-error.
    17894   if error-status :error then do:
    17895     return error substitute( "&1&2&3", return-value, chr(10), error-status :get-message(1) ) .
    17896   end.
    17897       end.
    17898       when "c-wth-parts" then do:
    17899         create locbw-c-wth-parts.
    17900   run nws-impl in p-imp-handle
    17901     ( input "c-wth-parts":U
    17902      ,input (buffer locbw-c-wth-parts:handle)
    17903     ) no-error.
    17904   if error-status :error then do:
    17905     return error substitute( "&1&2&3", return-value, chr(10), error-status :get-message(1) ) .
    17906   end.
    17907       end.
    17908       when "inkas-pay-wth" then do:
    17909         create locbw-inkas-pay-wth.
    17910   run nws-impl in p-imp-handle
    17911     ( input "inkas-pay-wth":U
    17912      ,input (buffer locbw-inkas-pay-wth:handle)
    17913     ) no-error.
    17914   if error-status :error then do:
    17915     return error substitute( "&1&2&3", return-value, chr(10), error-status :get-message(1) ) .
    17916   end.
    17917       end.
    17918       when "c-inkas-pay-wth" then do:
    17919         create locbw-c-inkas-pay-wth.
    17920   run nws-impl in p-imp-handle
    17921     ( input "c-inkas-pay-wth":U
    17922      ,input (buffer locbw-c-inkas-pay-wth:handle)
    17923     ) no-error.
    17924   if error-status :error then do:
    17925     return error substitute( "&1&2&3", return-value, chr(10), error-status :get-message(1) ) .
    17926   end.
    17927       end.
    17928       otherwise do:
    17929         message "Не предусмотрен прием таблицы " rec-name skip
    17930                 "в составе документа мат. ценностей"
    17931                 view-as alert-box error.
    17932         return error.
    17933       end.
    17934     END CASE.
    17935   end.
    17936   if not available tb-wth-doc then do:
    17937     create tb-wth-doc.
    17938   end.
    17939   else do:
    17940     if tb-wth-doc.status_ = 'факт':U then  return error substitute("Документ &1 уже закрыт на факт." ,tb-wth-doc.doc-code).
    17941   end.
    17942   define variable v-old-wth-doc-status as character no-undo .
    17943   define variable v-new-wth-doc-status as character no-undo .
    17944   assign
    17945     v-old-wth-doc-status = tb-wth-doc.status_
    17946     v-new-wth-doc-status = wt-wth-doc.status_
    17947   .
    17948   run trg/nwsdochs.p
    17949     (input g#db-num
    17950     ,input 'update':U
    17951     ,input wt-wth-doc.doc-code
    17952     ,input wt-wth-doc.obj-type
    17953     ,input wt-wth-doc.obj-code
    17954     ,input 'wth-doc':U
    17955     ,input ""
    17956     ,input wt-wth-doc.fact-date
    17957     ,input wt-wth-doc.fact-sum
    17958     ,input 0
    17959     ,input 0
    17960     ,input 0
    17961     ,input v-old-wth-doc-status
    17962     ,input v-new-wth-doc-status
    17963     ,input g#news-source-db
    17964     ,input p-pck-num
    17965     ,input wt-wth-doc.user-db-num
    17966     ,input wt-wth-doc.user-name
    17967     ,input wt-wth-doc.sys-date
    17968     ,input wt-wth-doc.sys-time
    17969     ,input wt-wth-doc.sys-time-int
    17970     ) no-error .
    17971   if error-status :error then do:
    17972     run write-to-log in this-procedure
    17973       (input substitute("&1 &2", error-status :get-message(1), return-value )
    17974       ) .
    17975     undo, return error .
    17976   end.
    17977   buffer-copy wt-wth-doc to tb-wth-doc.
    17978   on delete of ub.wth-dtl override do: end.
    17979   for each buf_wth-dtl where buf_wth-dtl.doc-code = wt-wth-doc.doc-code
    17980   on error  undo, return error
    17981   on stop   undo, return error
    17982   on endkey undo, return error :
    17983     delete buf_wth-dtl.
    17984   end.
    17985   for each locb-wth-dtl where locb-wth-dtl.doc-code = wt-wth-doc.doc-code
    17986                         no-lock
    17987   on error  undo, return error
    17988   on stop   undo, return error
    17989   on endkey undo, return error :
    17990     create buf_wth-dtl.
    17991     buffer-copy locb-wth-dtl to buf_wth-dtl.
    17992   end.
    17993   on delete of ub.wth-parts override do: end.
    17994   for each buf_wth-parts where buf_wth-parts.out-code = wt-wth-doc.doc-code
    17995   on error  undo, return error
    17996   on stop   undo, return error
    17997   on endkey undo, return error :
    17998     delete buf_wth-parts no-error.
    17999     if error-status:error then return error return-value.
    18000   end.
    18001   run trg/wthrspt.p (table locb-wth-parts
    18002                     , yes ) no-error.
    18003   if error-status :error
    18004   then do:
    18005     run write-to-log in this-procedure
    18006       (input substitute("&1 &2", error-status:get-message(1), return-value)
    18007       ) .
    18008     undo, return error
    18009       substitute("Ошибка при установке резервов по документу &1. &3 &4 " ,
    18010                   wt-wth-doc.doc-code  ,
    18011                   return-value ,
    18012                   error-status:get-message(1))
    18013       .
    18014   end.
    18015   for each locb-wth-parts where locb-wth-parts.out-code = wt-wth-doc.doc-code and locb-wth-parts.stts = 1
    18016                         no-lock
    18017   on error  undo, return error
    18018   on stop   undo, return error
    18019   on endkey undo, return error :
    18020     create buf_wth-parts.
    18021     buffer-copy locb-wth-parts to buf_wth-parts.
    18022   end.
    18023   on delete of ub.wth-line override do: end.
    18024   on delete of ub.c-chk-doc override do: end.
    18025   on delete of ub.c-chk-pay override do: end.
    18026   for each buf_wth-line where buf_wth-line.doc-code = wt-wth-doc.doc-code
    18027   on error  undo, return error
    18028   on stop   undo, return error
    18029   on endkey undo, return error :
    18030     delete buf_wth-line.
    18031   end.
    18032   for each locb-wth-line where locb-wth-line.doc-code = wt-wth-doc.doc-code
    18033                          no-lock
    18034   on error  undo, return error
    18035   on stop   undo, return error
    18036   on endkey undo, return error :
    18037     create buf_wth-line.
    18038     buffer-copy locb-wth-line to buf_wth-line.
    18039   end.
    18040   on delete of ub.wth-doc-attr override do: end.
    18041   for each buf_wth-doc-attr where buf_wth-doc-attr.doc-code = wt-wth-doc.doc-code
    18042   on error  undo, return error
    18043   on stop   undo, return error
    18044   on endkey undo, return error :
    18045     delete buf_wth-doc-attr.
    18046   end.
    18047   for each locb-wth-doc-attr where locb-wth-doc-attr.doc-code = wt-wth-doc.doc-code
    18048                          no-lock
    18049   on error  undo, return error
    18050   on stop   undo, return error
    18051   on endkey undo, return error :
    18052     create buf_wth-doc-attr.
    18053     buffer-copy locb-wth-doc-attr to buf_wth-doc-attr.
    18054   end.
