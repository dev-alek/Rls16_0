     5780   define temp-table wt-firm no-undo like ub.firm.
     5781   PROCEDURE proc-load-firm:
     5782     define input parameter p-imp-handle as handle  no-undo.
     5783     define input parameter p-pck-num    as integer no-undo.
     5784     define input parameter l-counter    as integer no-undo.
     5785     do
     5786     on error  undo, return error substitute( "$proc-load-firm. &1&2&3", return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     5787     on stop   undo, return error substitute( "$proc-load-firm. stop" )
     5788     on endkey undo, return error substitute( "$proc-load-firm. endkey" )
     5789     :
     5790       define buffer tb-firm for ub.firm.
     5791       define variable compare-log as logical no-undo.
     5792   define variable vss-include-info80 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5793   define variable v-l as logical no-undo .
     5794   define buffer buf_dis-card for ub.dis-card .
     5795       for each wt-firm
     5796       on error undo, return error substitute( "$proc-load-firm(del-wt-). &1&2&3", return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     5797       :
     5798         delete wt-firm .
     5799       end.
     5800       create wt-firm.
     5801       run nws-impl in p-imp-handle
     5802         ( input 'firm':U
     5803          ,input (buffer wt-firm:handle)
     5804         ) no-error.
     5805       if error-status :error then do:
     5806         return error return-value .
     5807       end.
     5808       find first tb-firm
     5809         where tb-firm.firm-code = wt-firm.firm-code
     5810         exclusive-lock no-error.
     5811   define variable vss-include-info81 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5812   if not available tb-firm then do:
     5813     create tb-firm.
     5814     assign compare-log = no.
     5815   end.
     5816   else do:
     5817     buffer-compare tb-firm TO wt-firm case-sensitive save result in compare-log no-error.
     5818   end.
     5819    buffer-compare tb-firm using city ind addres1 TO wt-firm case-sensitive save result in v-l no-error.
     5820   if not compare-log then do:
     5821     buffer-copy wt-firm TO tb-firm.
     5822   end.
     5823   if not v-l then do:
     5824     for each buf_dis-card no-lock where
     5825              buf_dis-card.cli-type = 'орг':U
     5826          AND buf_dis-card.cli-code = tb-firm.firm-code:
     5827       run fill-dc-list in p-imp-handle ( buffer buf_Dis-card).
     5828     end.
     5829   end.
     5830       delete wt-firm.
     5831     end.
     5832   END PROCEDURE.
     5833   define variable vss-include-info82 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5834   procedure update-service-price :
     5835     define input  parameter p-obj-type   as character no-undo .
     5836     define input  parameter p-obj-code   as integer   no-undo .
     5837     define input  parameter p-artic      as character no-undo .
     5838     define input  parameter p-prod-type  as character no-undo .
     5839     define input  parameter p-prod-code  as integer   no-undo .
     5840     define input  parameter p-price-base as decimal   no-undo .
     5841     define input  parameter p-price-rubl as decimal   no-undo .
     5842     define buffer buf_gds-obj for ub.gds-obj .
     5843     do
     5844     on error undo, return error return-value
     5845     :
     5846   define variable vss-include-info83 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5847   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     5848     (input  p-obj-type
     5849     ,input  p-obj-code
     5850     ,input  p-artic
     5851     ,input  p-prod-type
     5852     ,input  p-prod-code
     5853     ,buffer buf_gds-obj
     5854     ) no-error .
     5855       find current buf_gds-obj exclusive-lock .
     5856       assign
     5857         buf_gds-obj.price-base = p-price-base
     5858         buf_gds-obj.price-rubl = p-price-rubl
     5859       .
     5860       if g#db-num = 0
     5861       then do:
     5862         run str/callnews.p
     5863           (input 'gds-obj':U
     5864           ,input (buffer buf_gds-obj:handle)
     5865           ).
     5866       end.
     5867     end.
     5868   end procedure.
     5869   define temp-table wt-gds-obj no-undo like ub.gds-obj.
