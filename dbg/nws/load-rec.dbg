     7912   :
     7913     delete locb-chk-discnt.
     7914   end.
     7915   for each locb-chk-doc-attr
     7916   on error  undo, return error
     7917   :
     7918     delete locb-chk-doc-attr.
     7919   end.
     7920   for each locb-chk-gds-pay
     7921   on error  undo, return error
     7922   :
     7923     delete locb-chk-gds-pay.
     7924   end.
     7925   for each locb-c-chk-doc
     7926   on error  undo, return error
     7927   :
     7928     delete locb-c-chk-doc.
     7929   end.
     7930   for each locb-c-chk-gds
     7931   on error  undo, return error
     7932   :
     7933     delete locb-c-chk-gds.
     7934   end.
     7935   for each locb-c-chk-pay
     7936   on error  undo, return error
     7937   :
     7938     delete locb-c-chk-pay.
     7939   end.
     7940   for each locb-c-chk-discnt
     7941   on error  undo, return error
     7942   :
     7943     delete locb-c-chk-discnt.
     7944   end.
     7945   for each locb-c-chk-doc-attr
     7946   on error  undo, return error
     7947   :
     7948     delete locb-c-chk-doc-attr.
     7949   end.
     7950       delete wt-inkas.
     7951     end.
     7952   END PROCEDURE.
     7953   define temp-table locb2-c-inkas      no-undo like ub.c-inkas.
     7954   define temp-table locb2-c-inkas-pay      no-undo like ub.c-inkas-pay.
     7955   define temp-table locb2-c-inkas-pay-desk no-undo like ub.c-inkas-pay-desk.
     7956   define temp-table locb2-c-inkas-pay-wth no-undo like ub.c-inkas-pay-wth.
     7957   define temp-table locb2-c-sale-doc      no-undo like ub.c-sale-doc.
     7958   define temp-table wt-c-inkas no-undo like ub.c-inkas.
     7959   PROCEDURE proc-load-c-inkas:
     7960     define input parameter p-imp-handle as handle  no-undo.
     7961     define input parameter p-pck-num    as integer no-undo.
     7962     define input parameter l-counter    as integer no-undo.
     7963     do
     7964     on error  undo, return error substitute( "$proc-load-c-inkas. &1&2&3", return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     7965     on stop   undo, return error substitute( "$proc-load-c-inkas. stop" )
     7966     on endkey undo, return error substitute( "$proc-load-c-inkas. endkey" )
     7967     :
     7968       define buffer tb-c-inkas for ub.c-inkas.
     7969       define variable compare-log as logical no-undo.
     7970   define variable vss-include-info104 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7971   define buffer buf_c-inkas-pay      for ub.c-inkas-pay.
     7972   define buffer buf_c-sale-doc       for ub.c-sale-doc.
     7973   define buffer buf_c-inkas-pay-desk for ub.c-inkas-pay-desk.
     7974   define buffer buf_c-inkas-pay-wth  for ub.c-inkas-pay-wth.
     7975   define variable counter  as integer   no-undo.
     7976   define variable rec-full as character no-undo.
     7977   define variable rec-name as character no-undo.
     7978   for each locb2-c-inkas
     7979   on error undo, return error error-status :get-message (1)
     7980   :
     7981     delete locb2-c-inkas.
     7982   end.
     7983   for each locb2-c-inkas-pay
     7984   on error undo, return error error-status :get-message (1)
     7985   :
     7986     delete locb2-c-inkas-pay.
     7987   end.
     7988   for each locb2-c-inkas-pay-desk
     7989   on error undo, return error error-status :get-message (1)
     7990   :
     7991     delete locb2-c-inkas-pay-desk.
     7992   end.
     7993   for each locb2-c-inkas-pay-wth
     7994   on error undo, return error error-status :get-message (1)
     7995   :
     7996     delete locb2-c-inkas-pay-wth.
     7997   end.
     7998   for each locb2-c-sale-doc
     7999   on error undo, return error error-status :get-message (1)
     8000   :
     8001     delete locb2-c-sale-doc.
     8002   end.
     8003       for each wt-c-inkas
     8004       on error undo, return error substitute( "$proc-load-c-inkas(del-wt-). &1&2&3", return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     8005       :
     8006         delete wt-c-inkas .
     8007       end.
     8008       create wt-c-inkas.
     8009       run nws-impl in p-imp-handle
     8010         ( input 'c-inkas':U
     8011          ,input (buffer wt-c-inkas:handle)
     8012         ) no-error.
     8013       if error-status :error then do:
     8014         return error return-value .
     8015       end.
     8016       find first tb-c-inkas
     8017         where tb-c-inkas.inkas-code = wt-c-inkas.inkas-code
     8018           and tb-c-inkas.corr-user-db-num = wt-c-inkas.corr-user-db-num
     8019           and tb-c-inkas.chip-num = wt-c-inkas.chip-num
     8020         exclusive-lock no-error.
     8021   define variable vss-include-info105 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8022   DO counter = 1 TO l-counter
     8023   on error  undo, return error
     8024   on endkey undo, return error :
     8025   run nws-imps in p-imp-handle
     8026     ( input-output counter
     8027      ,output       rec-full
     8028     ) no-error.
     8029   if error-status :error then do:
     8030     return error substitute( "&1&2&3", return-value, chr(10), error-status :get-message(1) ) .
     8031   end.
     8032     assign
     8033       rec-name = entry( 1, rec-full, chr(1) )
     8034       .
     8035     CASE rec-name :
     8036       when "c-inkas-pay" then do:
     8037         create locb2-c-inkas-pay.
     8038   run nws-impl in p-imp-handle
     8039     ( input "c-inkas-pay":U
     8040      ,input (buffer locb2-c-inkas-pay:handle)
     8041     ) no-error.
     8042   if error-status :error then do:
     8043     return error substitute( "&1&2&3", return-value, chr(10), error-status :get-message(1) ) .
     8044   end.
     8045       end.
     8046       when "c-inkas-pay-desk" then do:
     8047         create locb2-c-inkas-pay-desk.
     8048   run nws-impl in p-imp-handle
     8049     ( input "c-inkas-pay-desk":U
     8050      ,input (buffer locb2-c-inkas-pay-desk:handle)
     8051     ) no-error.
     8052   if error-status :error then do:
     8053     return error substitute( "&1&2&3", return-value, chr(10), error-status :get-message(1) ) .
     8054   end.
     8055       end.
     8056       when "c-inkas-pay-wth" then do:
     8057         create locb2-c-inkas-pay-wth.
     8058   run nws-impl in p-imp-handle
     8059     ( input "c-inkas-pay-wth":U
     8060      ,input (buffer locb2-c-inkas-pay-wth:handle)
     8061     ) no-error.
     8062   if error-status :error then do:
     8063     return error substitute( "&1&2&3", return-value, chr(10), error-status :get-message(1) ) .
     8064   end.
     8065       end.
     8066       when "c-sale-doc" then do:
     8067         create locb2-c-sale-doc.
     8068   run nws-impl in p-imp-handle
     8069     ( input "c-sale-doc":U
     8070      ,input (buffer locb2-c-sale-doc:handle)
     8071     ) no-error.
     8072   if error-status :error then do:
     8073     return error substitute( "&1&2&3", return-value, chr(10), error-status :get-message(1) ) .
     8074   end.
     8075       end.
     8076       otherwise do:
     8077         message " nws/inc/imp/c-inkas.i: Не предусмотрен прием таблицы " rec-name skip
     8078                 "в составе накладной"
     8079                 view-as alert-box error.
     8080         return error " nws/inc/imp/c-inkas.i: Не предусмотрен прием таблицы " + rec-name + chr(10) + "в составе накладной".
     8081       end.
     8082     END CASE.
     8083   end.
     8084   if not available tb-c-inkas then do:
     8085     create tb-c-inkas.
     8086   end.
     8087   buffer-copy wt-c-inkas to tb-c-inkas.
     8088   for each buf_c-inkas-pay where buf_c-inkas-pay.inkas-code = wt-c-inkas.inkas-code
     8089   on error  undo, return error
     8090   on stop   undo, return error
     8091   on endkey undo, return error :
     8092     delete buf_c-inkas-pay.
     8093   end.
     8094   for each locb2-c-inkas-pay where locb2-c-inkas-pay.inkas-code = wt-c-inkas.inkas-code
     8095                           no-lock
     8096   on error  undo, return error
     8097   on stop   undo, return error
     8098   on endkey undo, return error :
     8099     create buf_c-inkas-pay.
     8100     buffer-copy locb2-c-inkas-pay to buf_c-inkas-pay.
     8101   end.
     8102   for each buf_c-inkas-pay-desk where buf_c-inkas-pay-desk.inkas-code = wt-c-inkas.inkas-code
     8103   on error  undo, return error
     8104   on stop   undo, return error
     8105   on endkey undo, return error :
     8106     delete buf_c-inkas-pay-desk.
     8107   end.
     8108   for each locb2-c-inkas-pay-desk where locb2-c-inkas-pay-desk.inkas-code = wt-c-inkas.inkas-code
     8109                           no-lock
     8110   on error  undo, return error
     8111   on stop   undo, return error
     8112   on endkey undo, return error :
     8113     create buf_c-inkas-pay-desk.
     8114     buffer-copy locb2-c-inkas-pay-desk to buf_c-inkas-pay-desk.
     8115   end.
     8116   for each buf_c-inkas-pay-wth where buf_c-inkas-pay-wth.inkas-code = wt-c-inkas.inkas-code
     8117   on error  undo, return error
     8118   on stop   undo, return error
     8119   on endkey undo, return error :
     8120     delete buf_c-inkas-pay-wth.
     8121   end.
     8122   for each locb2-c-inkas-pay-wth where locb2-c-inkas-pay-wth.inkas-code = wt-c-inkas.inkas-code
     8123                           no-lock
     8124   on error  undo, return error
     8125   on stop   undo, return error
     8126   on endkey undo, return error :
     8127     create buf_c-inkas-pay-wth.
     8128     buffer-copy locb2-c-inkas-pay-wth to buf_c-inkas-pay-wth.
     8129   end.
     8130   for each buf_c-sale-doc where buf_c-sale-doc.inkas-code = wt-c-inkas.inkas-code
     8131   on error  undo, return error
     8132   on stop   undo, return error
     8133   on endkey undo, return error :
     8134     delete buf_c-sale-doc.
     8135   end.
     8136   for each locb2-c-sale-doc where locb2-c-sale-doc.inkas-code = wt-c-inkas.inkas-code
     8137                           no-lock
     8138   on error  undo, return error
     8139   on stop   undo, return error
     8140   on endkey undo, return error :
     8141     create buf_c-sale-doc.
     8142     buffer-copy locb2-c-sale-doc to buf_c-sale-doc.
     8143   end.
     8144   for each locb2-c-inkas
     8145   on error  undo, return error
     8146   on stop   undo, return error
     8147   on endkey undo, return error :
     8148     delete locb2-c-inkas.
     8149   end.
     8150   for each locb2-c-inkas-pay
     8151   on error  undo, return error
     8152   on stop   undo, return error
     8153   on endkey undo, return error :
     8154     delete locb2-c-inkas-pay.
     8155   end.
     8156   for each locb2-c-inkas-pay-desk
     8157   on error  undo, return error
     8158   on stop   undo, return error
     8159   on endkey undo, return error :
     8160     delete locb2-c-inkas-pay-desk.
     8161   end.
     8162   for each locb2-c-inkas-pay-wth
     8163   on error  undo, return error
     8164   on stop   undo, return error
     8165   on endkey undo, return error :
     8166     delete locb2-c-inkas-pay-wth.
     8167   end.
     8168   for each locb2-c-sale-doc
     8169   on error  undo, return error
     8170   on stop   undo, return error
     8171   on endkey undo, return error :
     8172     delete locb2-c-sale-doc.
     8173   end.
     8174       delete wt-c-inkas.
     8175     end.
     8176   END PROCEDURE.
     8177   define variable vss-include-info106 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8178   define variable vss-include-info107 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8179   procedure layouth_create-layout_h :
     8180   define input parameter p-mode as character no-undo .
     8181   define input parameter p-layout-id as character no-undo .
     8182   define parameter buffer buf_layout for ub.layout.
     8183   define output parameter p-chip-num as integer no-undo .
     8184   define variable v-chip-num as integer no-undo .
     8185   DEFINE VARIABLE v-today as date no-undo .
     8186   DEFINE VARIABLE v-time as integer no-undo .
     8187   define buffer buf_c-layout for ub.c-layout.
     8188   do
     8189   on error undo, return error
     8190   :
     8191     run cur-time in this-procedure ( output v-today, output v-time).
     8192     find last buf_c-layout no-lock where
     8193               buf_c-layout.layout-id = p-layout-id
     8194          and  buf_c-layout.corr-user-db-num = g#db-num
     8195          use-index pi no-error.
     8196     assign
     8197     v-chip-num = (if available buf_c-layout
     8198                   then buf_c-layout.chip-num + 1
     8199                   else 0).
     8200     create buf_c-layout.
     8201     if available buf_layout
     8202     and p-mode <> 'ДОБАВЛЕНИЕ':U
     8203     then do:
     8204       buffer-copy buf_layout
     8205       to buf_c-layout.
     8206     end.
     8207     if not available buf_layout then do:
     8208       assign
     8209       buf_c-layout.layout-id = p-layout-id
     8210       .
     8211     end.
     8212     if p-mode = 'ДОБАВЛЕНИЕ':U then do:
     8213       assign
     8214       buf_c-layout.layout-id = p-layout-id
     8215       .
     8216     end.
     8217     assign
     8218     buf_c-layout.subject = 'layout':U
     8219     buf_c-layout.action = (if p-mode = 'ДОБАВЛЕНИЕ':U
     8220                            then integer('1':U)
     8221                            else (if p-mode = 'ИЗМЕНЕНИЕ':U
     8222                                  then integer('2':U)
     8223                                  else integer('99':U)
     8224                                  )
     8225                           )
     8226     buf_c-layout.chip-num = v-chip-num
     8227     buf_c-layout.corr-user-db-num = g#db-num
     8228     buf_c-layout.corr-user-name = g#userid
     8229     buf_c-layout.corr-date = v-today
     8230     buf_c-layout.corr-time = v-time
     8231     p-chip-num = v-chip-num
     8232     .
     8233   end.
     8234   end procedure.
     8235   procedure layouth_create-layout-elem-rule_h :
     8236   define input parameter p-mode as character no-undo .
     8237   define input parameter p-layout-id as character no-undo .
     8238   define input parameter p-mode-id as character no-undo .
     8239   define input parameter p-widget-id as character no-undo .
     8240   define parameter buffer buf_layout-elem-rule for ub.layout-elem-rule.
     8241   define input parameter p-chip-num as integer no-undo .
