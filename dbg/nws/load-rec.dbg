    10765   for each locb-ord-dtl-rcv where locb-ord-dtl-rcv.rcv-code = wt-ord-doc-rcv.rcv-code and
    10766                                   locb-ord-dtl-rcv.doc-code = wt-ord-doc-rcv.doc-code
    10767                         no-lock
