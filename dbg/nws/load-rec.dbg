    15269           and tb-tax-rate-gds.fact-order = wt-tax-rate-gds.fact-order
    15270         exclusive-lock no-error.
    15271   define variable vss-include-info172 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    15272   if not available tb-tax-rate-gds then do:
    15273     create tb-tax-rate-gds.
    15274     assign compare-log = no.
    15275   end.
    15276   else do:
    15277     buffer-compare tb-tax-rate-gds TO wt-tax-rate-gds case-sensitive save result in compare-log no-error.
    15278   end.
    15279   if not compare-log then do:
    15280     buffer-copy wt-tax-rate-gds TO tb-tax-rate-gds.
    15281     if num-entries(tb-tax-rate-gds.corr-user-name, chr(4)) > 1
    15282     and entry(2, tb-tax-rate-gds.corr-user-name, chr(4)) = 'upgrade':U then do:
    15283     end.
    15284     else do:
    15285       find buf_goods where buf_goods.gds-code = tb-tax-rate-gds.gds-code
    15286                     no-lock no-error.
