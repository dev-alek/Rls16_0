    19691           and tb-chk-slip-string.ID = wt-chk-slip-string.ID
    19692           and tb-chk-slip-string.CheckID = wt-chk-slip-string.CheckID
    19693           and tb-chk-slip-string.RRN = wt-chk-slip-string.RRN
    19694           and tb-chk-slip-string.str-num = wt-chk-slip-string.str-num
    19695         exclusive-lock no-error.
    19696       if l-counter <> 0 then do:
    19697         return error substitute( "&1 &2. Ошибка обработки записи &3", vss-workfile, vss-revision, 'chk-slip-string':U )
    19698                      + chr(10) + "Есть привязанные записи, а обработка идет для одной".
    19699       end.
    19700       if not available tb-chk-slip-string then do:
    19701         create tb-chk-slip-string.
    19702         assign compare-log = no.
    19703       end.
    19704       else do:
    19705         buffer-compare tb-chk-slip-string TO wt-chk-slip-string case-sensitive save result in compare-log no-error.
    19706       end.
    19707       if not compare-log then do:
    19708         buffer-copy wt-chk-slip-string TO tb-chk-slip-string.
    19709       end.
    19710       delete wt-chk-slip-string.
