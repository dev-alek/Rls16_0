     4119       end.
     4120       create wt-c-ext-classif.
     4121       run nws-impl in p-imp-handle
     4122         ( input 'c-ext-classif':U
     4123          ,input (buffer wt-c-ext-classif:handle)
     4124         ) no-error.
     4125       if error-status :error then do:
     4126         return error return-value .
     4127       end.
     4128       find first tb-c-ext-classif
     4129         where tb-c-ext-classif.classif-subject = wt-c-ext-classif.classif-subject
     4130           and tb-c-ext-classif.classif-name = wt-c-ext-classif.classif-name
     4131           and tb-c-ext-classif.db-num = wt-c-ext-classif.db-num
