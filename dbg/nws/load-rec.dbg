    10775       first buf_ord-doc no-lock where buf_ord-doc.doc-code = buf_ord-line.doc-code
    10776                                   and buf_ord-doc.doc-type <> 'ОР':U
    10777   on error  undo, return error
    10778   on stop   undo, return error
    10779   on endkey undo, return error :
    10780     delete buf_ord-line.
    10781   end.
    10782   for each rcvlocb-ord-line where rcvlocb-ord-line.doc-code = wt-ord-doc-rcv.doc-code no-lock,
    10783       first buf_ord-doc no-lock where buf_ord-doc.doc-code = wt-ord-doc-rcv.doc-code
    10784                                   and buf_ord-doc.doc-type <> 'ОР':U
    10785   on error  undo, return error
    10786   on stop   undo, return error
    10787   on endkey undo, return error :
