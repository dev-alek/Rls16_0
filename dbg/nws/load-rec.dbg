     4136           and tb-c-ext-classif.CharKey_Two = wt-c-ext-classif.CharKey_Two
     4137           and tb-c-ext-classif.CharKey_Three = wt-c-ext-classif.CharKey_Three
     4138           and tb-c-ext-classif.nonunique = wt-c-ext-classif.nonunique
     4139           and tb-c-ext-classif.corr-user-db-num = wt-c-ext-classif.corr-user-db-num
     4140           and tb-c-ext-classif.chip-num = wt-c-ext-classif.chip-num
     4141         exclusive-lock no-error.
     4142   define variable vss-include-info57 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4143   if not available tb-c-ext-classif then do:
