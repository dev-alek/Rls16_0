     1031       this-procedure :handle skip
     1032       this-procedure :type skip
     1033       this-procedure :file-name skip
     1034       valid-handle(this-procedure) skip
     1035       view-as alert-box error .
     1036     undo, return error return-value .
     1037   end.
     1038   else do:
     1039     assign
     1040       g#load-rec = this-procedure :handle
     1041     .
     1042   end.
     1043   if this-procedure :persistent <> true
