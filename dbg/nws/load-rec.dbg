    13425   PROCEDURE proc-load-c-rvs-doc:
    13426     define input parameter p-imp-handle as handle  no-undo.
    13427     define input parameter p-pck-num    as integer no-undo.
    13428     define input parameter l-counter    as integer no-undo.
    13429     do
    13430     on error  undo, return error substitute( "$proc-load-c-rvs-doc. &1&2&3", return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    13431     on stop   undo, return error substitute( "$proc-load-c-rvs-doc. stop" )
    13432     on endkey undo, return error substitute( "$proc-load-c-rvs-doc. endkey" )
    13433     :
    13434       define buffer tb-c-rvs-doc for ub.c-rvs-doc.
    13435       define variable compare-log as logical no-undo.
    13436   define variable vss-include-info147 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
