    10738   on endkey undo, return error :
    10739     create buf_ord-rcv-line-attr.
    10740     buffer-copy locb-ord-rcv-line-attr to buf_ord-rcv-line-attr.
    10741   end.
    10742   for each buf_ord-rcv-attr where buf_ord-rcv-attr.rcv-code = wt-ord-doc-rcv.rcv-code and
    10743                                   buf_ord-rcv-attr.doc-code = wt-ord-doc-rcv.doc-code
    10744   on error  undo, return error
    10745   on stop   undo, return error
    10746   on endkey undo, return error :
    10747     delete buf_ord-rcv-attr.
    10748   end.
    10749   for each locb-ord-rcv-attr where locb-ord-rcv-attr.rcv-code = wt-ord-doc-rcv.rcv-code and
    10750                                    locb-ord-rcv-attr.doc-code = wt-ord-doc-rcv.doc-code
    10751                          no-lock
