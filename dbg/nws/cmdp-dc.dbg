     2528   procedure get-db-list-for-d-card:
     2529   define input parameter p-d-card as character no-undo .
     2530   define variable v-current-db-processed as logical no-undo .
     2531   define buffer buf_clients  for ub.clients.
     2532   define buffer buf_dis-obj for ub.dis-obj.
     2533   define buffer buf_temp-smart-route for temp-smart-route.
     2534     do
     2535     on error undo, return error return-value
     2536     :
     2537       for each buf_dis-obj no-lock where
     2538               buf_dis-obj.d-card = p-d-card,
     2539          first buf_clients no-lock where
     2540               buf_clients.obj-type = buf_dis-obj.obj-type
     2541           and buf_clients.obj-code = buf_dis-obj.obj-code
     2542       break by
     2543       buf_clients.db-num:
     2544         if first-of(buf_Clients.db-num) then do:
     2545           find first buf_temp-smart-route no-lock where
     2546                 buf_temp-smart-route.key-field = p-d-card
     2547             and buf_temp-smart-route.db-num = buf_clients.db-num
     2548                 no-error.
     2549           if available buf_temp-smart-route then return.
     2550           create buf_temp-smart-route.
     2551           assign
     2552           buf_temp-smart-route.key-field = p-d-card
     2553           buf_temp-smart-route.db-num = buf_clients.db-num
     2554           .
     2555           if buf_clients.db-num = g#db-num then do:
     2556             v-current-db-processed = yes.
     2557           end.
     2558         end.
     2559       end.
     2560       if not v-current-db-processed then do:
     2561         find first buf_temp-smart-route no-lock where
     2562               buf_temp-smart-route.key-field = p-d-card
     2563           and buf_temp-smart-route.db-num = g#db-num  no-error.
     2564         if not available buf_temp-smart-route then do:
     2565           create buf_temp-smart-route.
     2566           assign
     2567           buf_temp-smart-route.key-field = p-d-card
     2568           buf_temp-smart-route.db-num = g#db-num
     2569           .
     2570         end.
     2571       end.
     2572     end.
     2573   end procedure.
