     1399       define buffer   in-vatp-goodso    for ub.goods   .
     1400       define buffer   in-vatp-sysconfo  for ub.sysconf .
     1401       define buffer   in-vatp_doc-attro for ub.doc-attr.
     1402       define variable in-vatp-have-vat-slto       as   logical initial yes    no-undo.
     1403       define variable vat-pc-loco                 like ub.doc-line.vat-pc     no-undo.
     1404       define variable varinvprbo                  as   character              no-undo.
     1405       define variable slt-pc-loco                 like ub.doc-line.slt-pc     no-undo.
     1406       define variable cli-base-rateo              as   decimal                no-undo.
     1407       define variable price-rubl-with-tax-loco    like ub.doc-line.price-rubl no-undo.
     1408       define variable price-base-with-tax-loco    like ub.doc-line.price-base no-undo.
     1409       define variable price-cli-with-tax-loco     like ub.doc-line.price-cli  no-undo.
     1410       define variable price-rubl-without-tax-loco like ub.doc-line.price-rubl no-undo.
     1411       define variable price-base-without-tax-loco like ub.doc-line.price-base no-undo.
     1412       define variable price-cli-without-tax-loco  like ub.doc-line.price-base no-undo.
     1413       define variable vat-base-loco               like ub.doc-line.price-base no-undo.
     1414       define variable vat-rubl-loco               like ub.doc-line.price-rubl no-undo.
     1415       define variable vat-cli-loco                like ub.doc-line.price-rubl no-undo.
     1416       define variable slt-base-loco               like ub.doc-line.price-base no-undo.
     1417       define variable slt-rubl-loco               like ub.doc-line.price-rubl no-undo.
     1418       define variable slt-cli-loco                like ub.doc-line.price-rubl no-undo.
     1419       define variable road-tax-base-loco          like ub.doc-line.road-tax   no-undo.
     1420       define variable road-tax-rubl-loco          like ub.doc-line.road-tax   no-undo.
     1421       define variable road-tax-cli-loco           like ub.doc-line.road-tax   no-undo.
     1422       define variable transport-base-loco         like ub.doc-line.price-base no-undo.
     1423       define variable transport-rubl-loco         like ub.doc-line.price-rubl no-undo.
     1424       define variable transport-cli-loco          like ub.doc-line.price-rubl no-undo.
     1425       define variable other-base-loco             like ub.doc-line.price-base no-undo.
     1426       define variable other-rubl-loco             like ub.doc-line.price-rubl no-undo.
     1427       define variable other-cli-loco              like ub.doc-line.price-rubl no-undo.
     1428       define variable exch-rate-cli-loco          like ub.trn-doc.exch-rate   no-undo.
     1429       define variable varinvatp-envdo             as   character              no-undo.
     1430       define variable varinvatp-typeo             as   character              no-undo.
     1431       define variable v-gds-dtl-fact-qnty as decimal no-undo .
     1432       define buffer buf_gds-dtl  for ub.gds-dtl .
     1433       define buffer buf_goods    for ub.goods .
     1434       define buffer buf_trn-doc  for ub.trn-doc .
     1435       define buffer buf_doc-line for ub.doc-line .
     1436       find first buf_doc-line no-lock
     1437         where buf_doc-line.doc-code  = p-doc-code
     1438           and buf_doc-line.artic     = p-artic
     1439           and buf_doc-line.prod-type = p-prod-type
     1440           and buf_doc-line.prod-code = p-prod-code
     1441         no-error .
     1442       if not available buf_doc-line then do:
     1443         message
     1444           vss-workfile vss-revision vss-description skip
     1445           vss-include-info13 skip
     1446           "Ошибка задания входных параметров" skip
     1447           "Не найдена строка документа" skip
     1448           "Документ" p-doc-code skip
     1449           "Артикул" p-artic p-prod-type p-prod-code skip
     1450           view-as alert-box error .
     1451         undo, return error .
     1452       end.
     1453       find first buf_trn-doc no-lock
     1454         where buf_trn-doc.doc-code = buf_doc-line.doc-code
     1455         no-error .
     1456       if not available buf_trn-doc then do:
     1457         message
     1458           vss-workfile vss-revision vss-description skip
     1459           vss-include-info13 skip
     1460           "Не найден документ" skip
     1461           "Документ" p-doc-code skip
     1462           "Артикул" p-artic p-prod-type p-prod-code skip
     1463           view-as alert-box error .
     1464         undo, return error .
     1465       end.
     1466       for each buf_gds-dtl no-lock
     1467         where buf_gds-dtl.doc-code  = buf_doc-line.doc-code
     1468           and buf_gds-dtl.artic     = buf_doc-line.artic
     1469           and buf_gds-dtl.prod-type = buf_doc-line.prod-type
     1470           and buf_gds-dtl.prod-code = buf_doc-line.prod-code
     1471       on error undo, return error
     1472       :
     1473           if buf_trn-doc.doc-type <> 'инв':U
     1474           then do:
     1475               if buf_trn-doc.doc-type = 'при':U
     1476               or buf_trn-doc.doc-type = 'возврат':U
     1477               then do:
     1478                   assign
     1479                       v-gds-dtl-fact-qnty = buf_gds-dtl.fact-qnty
     1480                   .
     1481               end.
     1482               else do:
     1483                   assign
     1484                       v-gds-dtl-fact-qnty = - buf_gds-dtl.fact-qnty
     1485                   .
     1486               end.
     1487           end.
     1488           else do:
     1489               assign
     1490                   v-gds-dtl-fact-qnty = buf_gds-dtl.doc-qnty
     1491               .
     1492           end.
     1493           if v-gds-dtl-fact-qnty <> 0
     1494           then do:
     1495   if buf_trn-doc.ext-doc-type = 'ot':U or
     1496      buf_trn-doc.ext-doc-type = ?                 then do:
     1497     assign
     1498      out-vatp-have-vat-slt = yes.
     1499   end.
     1500   else do:
     1501     find first out-vatp_doc-attr no-lock
     1502       where out-vatp_doc-attr.doc-code  = buf_trn-doc.doc-code
     1503         and out-vatp_doc-attr.attr-code = 'envd':U
     1504         no-error .
     1505     if not available out-vatp_doc-attr then do:
     1506       assign
     1507         out-vatp-have-vat-slt = yes.
     1508     end.
     1509     else do:
     1510        out-vatp-have-vat-slt = no.
     1511     end.
     1512   end.
     1513   find first out-vatp_goods where out-vatp_goods.artic     = buf_doc-line.artic     and
     1514                                      out-vatp_goods.prod-type = buf_doc-line.prod-type and
     1515                                      out-vatp_goods.prod-code = buf_doc-line.prod-code no-lock.
     1516   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1517   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rootnode in g#library
     1518     (input  buf_doc-line.artic
     1519     ,input  buf_doc-line.prod-type
     1520     ,input  buf_doc-line.prod-code
     1521     ,output varroot-node
     1522     ) no-error .
     1523   if error-status :error then do:
     1524     message
     1525       vss-workfile vss-revision vss-description skip
     1526       "Ошибка при определении корневого признака товара" skip
     1527       "Артикул" buf_doc-line.artic buf_doc-line.prod-type buf_doc-line.prod-code skip
     1528       error-status :get-message(1) skip
     1529       return-value skip
     1530       view-as alert-box error .
     1531     undo, return error .
     1532   end.
     1533   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prtat in g#library
     1534     (input  varroot-node
     1535     ,input  'empty-scale=request'
     1536     ,output varempty-scale
     1537     ) no-error .
     1538   if error-status :error then do:
     1539     message
     1540       vss-workfile vss-revision vss-description skip
     1541       "Ошибка при определении атрибута признака" skip
     1542       "Артикул" buf_doc-line.artic buf_doc-line.prod-type buf_doc-line.prod-code skip
     1543       "Признак" varroot-node skip
     1544       "Запрашивался атрибут" "empty-scale=request" skip
     1545       error-status :get-message(1) skip
     1546       return-value skip
     1547       view-as alert-box error .
     1548     undo, return error .
     1549   end.
     1550   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1551   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1552     (output varoutvprb
     1553     )  .
     1554   if varoutvprb = "base":u then do:
     1555     assign
     1556           road-tax-base-sale    =  (if buf_doc-line.road-tax = ? then 0 else buf_doc-line.road-tax * 1)
     1557       excise-base-sale      =  (if buf_doc-line.excise   = ? then 0 else buf_doc-line.excise   * 1)
     1558     .
     1559   end.
     1560   else do:
     1561     assign
     1562           road-tax-base-sale    =  (if buf_doc-line.road-tax = ? then 0 else buf_doc-line.road-tax / buf_trn-doc.base-rate * buf_trn-doc.base-scale)
     1563       excise-base-sale      =  (if buf_doc-line.excise   = ? then 0 else buf_doc-line.excise   / buf_trn-doc.base-rate * buf_trn-doc.base-scale)
     1564     .
     1565   end.
     1566   if varoutvprb = "rubl":u then do:
     1567     assign
     1568           road-tax-rubl-sale    = (if buf_doc-line.road-tax = ? then 0 else buf_doc-line.road-tax * 1)
     1569       excise-rubl-sale      = (if buf_doc-line.excise   = ? then 0 else buf_doc-line.excise   * 1) .
     1570   end.
     1571   else do:
     1572     assign
     1573           road-tax-rubl-sale    = (if buf_doc-line.road-tax = ? then 0 else buf_doc-line.road-tax * buf_trn-doc.base-rate / buf_trn-doc.base-scale)
     1574       excise-rubl-sale      = (if buf_doc-line.excise   = ? then 0 else buf_doc-line.excise   * buf_trn-doc.base-rate / buf_trn-doc.base-scale) .
     1575   end.
     1576   assign
     1577     varis-cons-parts-have =  no.
     1578   assign
     1579     varfact-qnty       = 0
     1580     varcons-qnty       = 0
     1581     varprice-base-cons = 0
     1582     varprice-rubl-cons = 0.
     1583   find first out-vatp_doc-line where
     1584              out-vatp_doc-line.doc-code   = buf_trn-doc.doc-code
     1585          and out-vatp_doc-line.artic      = buf_doc-line.artic
     1586          and out-vatp_doc-line.prod-type  = buf_doc-line.prod-type
     1587          and out-vatp_doc-line.prod-code  = buf_doc-line.prod-code no-lock no-error.
     1588   if available out-vatp_doc-line           and
     1589     (out-vatp_doc-line.status_ = 'запрос':U or out-vatp_goods.gds-type = 'у':U) then do:
     1590     assign
     1591       varfact-qnty = out-vatp_doc-line.fact-qnty.
     1592   end.
     1593   else do:
     1594     for each out-vatp_parts where out-vatp_parts.out-code   = buf_trn-doc.doc-code
     1595                                  and out-vatp_parts.obj-type   = buf_trn-doc.obj-type
     1596                                  and out-vatp_parts.obj-code   = buf_trn-doc.obj-code
     1597                                  and out-vatp_parts.artic      = buf_doc-line.artic
     1598                                  and out-vatp_parts.prod-type  = buf_doc-line.prod-type
     1599                                  and out-vatp_parts.prod-code  = buf_doc-line.prod-code no-lock :
     1600       if out-vatp_parts.purch-code = 2 then do:
     1601   assign
     1602     price-rubl-with-tax-loco = out-vatp_parts.price-rubl
     1603     price-base-with-tax-loco = out-vatp_parts.price-base
     1604   .
     1605   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1606   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1607     (output varinvprbo
     1608     )  .
     1609     if out-vatp_parts.out-code = 'free-zone':U     or
     1610        out-vatp_parts.out-code = 'out-zone':U   or
     1611        out-vatp_parts.doc-type = 'акт':U then do:
     1612       assign
     1613         in-vatp-have-vat-slto = yes.
     1614     end.
     1615     else do:
     1616       find first in-vatp_doc-attro no-lock
     1617         where in-vatp_doc-attro.doc-code  = out-vatp_parts.out-code
     1618           and in-vatp_doc-attro.attr-code = 'envd':U
     1619         no-error .
     1620       if not available in-vatp_doc-attro then do:
     1621         assign
     1622           in-vatp-have-vat-slto = yes.
     1623       end.
     1624       else do:
     1625            in-vatp-have-vat-slto = no.
     1626       end.
     1627     end.
     1628     assign
     1629      price-cli-with-tax-loco = out-vatp_parts.price-cli
     1630      cli-base-rateo          = out-vatp_parts.cli-base-rate.
     1631     ASSIGN   road-tax-base-loco  = (if out-vatp_parts.road-tax-base  = ? then 0 else out-vatp_parts.road-tax-base)
     1632              road-tax-rubl-loco  = (if out-vatp_parts.road-tax-rubl  = ? then 0 else out-vatp_parts.road-tax-rubl).
     1633     ASSIGN  transport-base-loco = (if out-vatp_parts.transport-base = ? then 0 else out-vatp_parts.transport-base)
     1634             transport-rubl-loco = (if out-vatp_parts.transport-rubl = ? then 0 else out-vatp_parts.transport-rubl)
     1635             other-base-loco     = (if out-vatp_parts.other-base     = ? then 0 else out-vatp_parts.other-base)
     1636             other-rubl-loco     = (if out-vatp_parts.other-rubl     = ? then 0 else out-vatp_parts.other-rubl)
     1637             vat-pc-loco         = (if out-vatp_parts.vat-pc         = ? then 0 else out-vatp_parts.vat-pc)
     1638             slt-pc-loco         = (if out-vatp_parts.slt-pc         = ? then 0 else out-vatp_parts.slt-pc).
     1639             ASSIGN   slt-base-loco    = (if in-vatp-have-vat-slto = no then 0 else (price-base-with-tax-loco - ((if road-tax-base-loco  = ? then 0 else road-tax-base-loco) + (if transport-base-loco = ? then 0 else transport-base-loco) + (if other-base-loco = ? then 0 else other-base-loco)))                           * slt-pc-loco / (100 + slt-pc-loco))                        vat-base-loco    = (if in-vatp-have-vat-slto = no then 0 else (price-base-with-tax-loco - ((if road-tax-base-loco  = ? then 0 else road-tax-base-loco) + (if transport-base-loco = ? then 0 else transport-base-loco) + (if other-base-loco = ? then 0 else other-base-loco))) * (1 - slt-pc-loco / (100 + slt-pc-loco)) * vat-pc-loco / (100 + vat-pc-loco)).
     1640       ASSIGN   slt-rubl-loco    = (if in-vatp-have-vat-slto = no then 0 else (price-rubl-with-tax-loco - ((if road-tax-rubl-loco  = ? then 0 else road-tax-rubl-loco) + (if transport-rubl-loco = ? then 0 else transport-rubl-loco) + (if other-rubl-loco = ? then 0 else other-rubl-loco)))                           * slt-pc-loco / (100 + slt-pc-loco))                        vat-rubl-loco    = (if in-vatp-have-vat-slto = no then 0 else (price-rubl-with-tax-loco - ((if road-tax-rubl-loco  = ? then 0 else road-tax-rubl-loco) + (if transport-rubl-loco = ? then 0 else transport-rubl-loco) + (if other-rubl-loco = ? then 0 else other-rubl-loco))) * (1 - slt-pc-loco / (100 + slt-pc-loco)) * vat-pc-loco / (100 + vat-pc-loco)).
     1641     assign
     1642       exch-rate-cli-loco = (out-vatp_parts.price-rubl - transport-rubl-loco - other-rubl-loco - road-tax-rubl-loco - (if out-vatp_parts.vat-type <> 'в т. ч.':U then vat-rubl-loco else 0) - (if out-vatp_parts.slt-type <> 'в т. ч.':U then slt-rubl-loco else 0)) / out-vatp_parts.price-cli .
     1643     assign
     1644       slt-cli-loco        = slt-rubl-loco       / exch-rate-cli-loco
     1645       vat-cli-loco        = vat-rubl-loco       / exch-rate-cli-loco
     1646       road-tax-cli-loco   = road-tax-rubl-loco  / exch-rate-cli-loco
     1647       transport-cli-loco  = 0
     1648       other-cli-loco      = 0
     1649     .
     1650   ASSIGN
     1651             price-base-without-tax-loco = price-base-with-tax-loco - vat-base-loco - slt-base-loco - ((if road-tax-base-loco  = ? then 0 else road-tax-base-loco) + (if transport-base-loco = ? then 0 else transport-base-loco) + (if other-base-loco = ? then 0 else other-base-loco))
     1652       price-rubl-without-tax-loco = price-rubl-with-tax-loco - vat-rubl-loco - slt-rubl-loco - ((if road-tax-rubl-loco  = ? then 0 else road-tax-rubl-loco) + (if transport-rubl-loco = ? then 0 else transport-rubl-loco) + (if other-rubl-loco = ? then 0 else other-rubl-loco))
     1653   .
     1654         assign
     1655           varprice-base-cons = varprice-base-cons + (price-base-with-tax-loco - (if road-tax-base-loco = ? then 0 else road-tax-base-loco))* out-vatp_parts.fact-qnty
     1656           varprice-rubl-cons = varprice-rubl-cons + (price-rubl-with-tax-loco - (if road-tax-rubl-loco = ? then 0 else road-tax-rubl-loco))* out-vatp_parts.fact-qnty.
     1657         assign
     1658           varis-cons-parts-have = yes
     1659           varcons-qnty          = varcons-qnty + out-vatp_parts.fact-qnty.
     1660       end.
     1661       assign
     1662         varfact-qnty = varfact-qnty + out-vatp_parts.fact-qnty.
     1663     end.
     1664   end.
     1665   assign
     1666     varprice-base-cons = varprice-base-cons / varcons-qnty
     1667     varprice-rubl-cons = varprice-rubl-cons / varcons-qnty.
     1668   if varprice-base-cons = ? then do:
     1669     assign
     1670       varprice-base-cons = 0.
     1671   end.
     1672   if varprice-rubl-cons = ? then do:
     1673     assign
     1674       varprice-rubl-cons = 0.
     1675   end.
     1676   assign
     1677       slt-base-sale               = (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc)
     1678     vat-base-buyer              = (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-base-sale) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc)
     1679     discnt-base-sale            = buf_gds-dtl.discnt-base
     1680     price-base-with-tax-sale    = (buf_gds-dtl.price-base - buf_gds-dtl.discnt-base)
     1681       slt-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc)
     1682     vat-rubl-buyer              = (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-rubl-sale) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc)
     1683     discnt-rubl-sale            = buf_gds-dtl.discnt-rubl
     1684     price-rubl-with-tax-sale    = (buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl)
     1685     .
     1686   if buf_trn-doc.doc-type = 'инв':U then do:
     1687     assign
     1688       varfact-qnty = buf_gds-dtl.doc-qnty.
     1689   end.
     1690   else do:
     1691     assign
     1692       varfact-qnty = buf_gds-dtl.fact-qnty.
     1693   end.
     1694   if varis-cons-parts-have = no then do:
     1695     assign
     1696           vat-base-sale               = (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-base-sale) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc)
     1697           vat-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-rubl-sale) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc).
     1698   end.
     1699   else do:
     1700     if buf_trn-doc.doc-type = 'инв':U then do:
     1701       assign
     1702               vat-base-sale               = (if out-vatp-have-vat-slt = no then 0 else (((buf_gds-dtl.price-base - buf_gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-base-sale - varprice-base-cons) * buf_doc-line.cons-vat-pc / (100 + buf_doc-line.cons-vat-pc) * buf_gds-dtl.doc-qnty * varcons-qnty / varfact-qnty + ((buf_gds-dtl.price-base - buf_gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-base-sale) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc) * buf_gds-dtl.doc-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     1703               vat-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else (((buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-rubl-sale - varprice-rubl-cons) * buf_doc-line.cons-vat-pc / (100 + buf_doc-line.cons-vat-pc) * buf_gds-dtl.doc-qnty * varcons-qnty / varfact-qnty + ((buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-rubl-sale) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc) * buf_gds-dtl.doc-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     1704        .
     1705     end.
     1706     else do:
     1707       assign
     1708               vat-base-sale               = (if out-vatp-have-vat-slt = no then 0 else (((buf_gds-dtl.price-base - buf_gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-base-sale - varprice-base-cons) * buf_doc-line.cons-vat-pc / (100 + buf_doc-line.cons-vat-pc) * buf_gds-dtl.fact-qnty * varcons-qnty / varfact-qnty + ((buf_gds-dtl.price-base - buf_gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - varprice-base-cons) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc) * buf_gds-dtl.fact-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     1709               vat-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else (((buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-rubl-sale - varprice-rubl-cons) * buf_doc-line.cons-vat-pc / (100 + buf_doc-line.cons-vat-pc) * buf_gds-dtl.fact-qnty * varcons-qnty / varfact-qnty + ((buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - varprice-rubl-cons) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc) * buf_gds-dtl.fact-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     1710        .
     1711     end.
     1712   end.
     1713   assign
     1714   price-base-without-tax-sale = price-base-with-tax-sale - vat-base-sale - slt-base-sale - road-tax-base-sale
     1715   price-rubl-without-tax-sale = price-rubl-with-tax-sale - vat-rubl-sale - slt-rubl-sale - road-tax-rubl-sale.
     1716               ASSIGN
     1717                   p-fact-qnty           = p-fact-qnty     + v-gds-dtl-fact-qnty
     1718                   p-sum-base            = p-sum-base      + price-base-with-tax-sale  * v-gds-dtl-fact-qnty
     1719                   p-sum-rubl            = p-sum-rubl      + price-rubl-with-tax-sale  * v-gds-dtl-fact-qnty
     1720                   p-vat-base            = p-vat-base      + vat-base-sale             * v-gds-dtl-fact-qnty
     1721                   p-vat-rubl            = p-vat-rubl      + vat-rubl-sale             * v-gds-dtl-fact-qnty
     1722                   p-slt-base            = p-slt-base      + slt-base-sale             * v-gds-dtl-fact-qnty
     1723                   p-slt-rubl            = p-slt-rubl      + slt-rubl-sale             * v-gds-dtl-fact-qnty
     1724                   p-road-tax-base       = p-road-tax-base + road-tax-base-sale        * v-gds-dtl-fact-qnty
     1725                   p-road-tax-rubl       = p-road-tax-rubl + road-tax-rubl-sale        * v-gds-dtl-fact-qnty
     1726                   p-excise-base         = p-excise-base   + excise-base-sale          * v-gds-dtl-fact-qnty
     1727                   p-excise-rubl         = p-excise-rubl   + excise-rubl-sale          * v-gds-dtl-fact-qnty
     1728                   p-other-base          = p-other-base    + discnt-base-sale          * v-gds-dtl-fact-qnty
     1729                   p-other-rubl          = p-other-rubl    + discnt-rubl-sale          * v-gds-dtl-fact-qnty
     1730               .
     1731           end.
     1732       end.
     1733       assign
     1734           p-transport-base      = 0
     1735           p-transport-rubl      = 0
     1736           p-vat-pc              = buf_doc-line.vat-pc
     1737           p-slt-pc              = buf_doc-line.slt-pc
     1738       .
     1739     end.
     1740     if p-fact-qnty      = ?
     1741     or p-vat-pc         = ?
     1742     or p-slt-pc         = ?
     1743     or p-sum-base       = ?
     1744     or p-sum-rubl       = ?
     1745     or p-vat-base       = ?
     1746     or p-vat-rubl       = ?
     1747     or p-slt-base       = ?
     1748     or p-slt-rubl       = ?
     1749     or p-road-tax-base  = ?
     1750     or p-road-tax-rubl  = ?
     1751     or p-transport-base = ?
     1752     or p-transport-rubl = ?
     1753     or p-other-base     = ?
     1754     or p-other-rubl     = ?
     1755     or p-excise-base    = ?
     1756     or p-excise-rubl    = ?
     1757     then do:
     1758       message
     1759         vss-workfile vss-revision vss-description skip
     1760         vss-include-info13 skip
     1761         "Получены неопределенные значения" skip
     1762         "Документ" p-doc-code skip
     1763         "Артикул" p-artic p-prod-type p-prod-code skip
     1764         "fact-qnty     " p-fact-qnty      skip
     1765         "vat-pc        " p-vat-pc         skip
     1766         "slt-pc        " p-slt-pc         skip
     1767         "sum-base      " p-sum-base       skip
     1768         "sum-rubl      " p-sum-rubl       skip
     1769         "vat-base      " p-vat-base       skip
     1770         "vat-rubl      " p-vat-rubl       skip
     1771         "slt-base      " p-slt-base       skip
     1772         "slt-rubl      " p-slt-rubl       skip
     1773         "road-tax-base " p-road-tax-base  skip
     1774         "road-tax-rubl " p-road-tax-rubl  skip
     1775         "transport-base" p-transport-base skip
     1776         "transport-rubl" p-transport-rubl skip
     1777         "other-base    " p-other-base     skip
     1778         "other-rubl    " p-other-rubl     skip
     1779         "excise-base   " p-excise-base    skip
     1780         "excise-rubl   " p-excise-rubl    skip
     1781         view-as alert-box error .
     1782       undo, return error .
     1783     end.
     1784   end procedure.
     1785   define variable vss-include-info17 as character format "X(65)" no-undo
     1786   initial "@(#)$Workfile$ $Revision$".
     1787   def var vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1788   procedure r-cost :
     1789     define input  parameter v-doc-code       like ub.doc-line.doc-code          no-undo .
     1790     define input  parameter v-artic          like ub.doc-line.artic             no-undo .
     1791     define input  parameter v-prod-type      like ub.doc-line.prod-type         no-undo .
     1792     define input  parameter v-prod-code      like ub.doc-line.prod-code         no-undo .
     1793     define output parameter v-fact-qnty      like ub.ot-line.fact-qnty       no-undo .
     1794     define output parameter v-vat-pc         like ub.doc-line.vat-pc         no-undo .
     1795     define output parameter v-slt-pc         like ub.doc-line.slt-pc         no-undo .
     1796     define output parameter v-sum-base       like ub.ot-line.sum-base        no-undo .
     1797     define output parameter v-sum-rubl       like ub.ot-line.sum-rubl        no-undo .
     1798     define output parameter v-vat-base       like ub.ot-line.vat-base        no-undo .
     1799     define output parameter v-vat-rubl       like ub.ot-line.vat-rubl        no-undo .
     1800     define output parameter v-slt-base       like ub.ot-line.slt-base        no-undo .
     1801     define output parameter v-slt-rubl       like ub.ot-line.slt-rubl        no-undo .
     1802     define output parameter v-road-tax-base  like ub.ot-line.road-tax-base   no-undo .
     1803     define output parameter v-road-tax-rubl  like ub.ot-line.road-tax-rubl   no-undo .
     1804     define output parameter v-transport-base like ub.ot-line.transport-base  no-undo .
     1805     define output parameter v-transport-rubl like ub.ot-line.transport-rubl  no-undo .
     1806     define output parameter v-other-base     like ub.ot-line.other-base      no-undo .
     1807     define output parameter v-other-rubl     like ub.ot-line.other-rubl      no-undo .
     1808     define output parameter v-excise-base    like ub.ot-line.excise-base     no-undo .
     1809     define output parameter v-excise-rubl    like ub.ot-line.excise-rubl     no-undo .
     1810     do
     1811     on error undo, return error
     1812     :
     1813       define buffer   in-vatp-trn-doc  for ub.trn-doc .
     1814       define buffer   in-vatp-parts    for ub.parts   .
     1815       define buffer   in-vatp-doc      for ub.trn-doc .
     1816       define buffer   in-vatp-goods    for ub.goods   .
     1817       define buffer   in-vatp-sysconf  for ub.sysconf .
     1818       define buffer   in-vatp_doc-attr for ub.doc-attr.
     1819       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
     1820       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
     1821       define variable varinvprb                  as   character              no-undo.
     1822       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
     1823       define variable cli-base-rate              as   decimal                no-undo.
     1824       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
     1825       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
     1826       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
     1827       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
     1828       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
     1829       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
     1830       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
     1831       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
     1832       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
     1833       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
     1834       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
     1835       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
     1836       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
     1837       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
     1838       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
     1839       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
     1840       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
     1841       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
     1842       define variable other-base-loc             like ub.doc-line.price-base no-undo.
     1843       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
     1844       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
     1845       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
     1846       define variable varinvatp-envd             as   character              no-undo.
     1847       define variable varinvatp-type             as   character              no-undo.
     1848       def var v-parts-fact-qnty as decimal   no-undo .
     1849       define buffer buf_parts    for ub.parts    .
     1850       define buffer buf_goods    for ub.goods    .
     1851       define buffer buf_trn-doc  for ub.trn-doc  .
     1852       define buffer buf_doc-line for ub.doc-line .
     1853       find first buf_doc-line no-lock
     1854         where buf_doc-line.doc-code  = v-doc-code
     1855           and buf_doc-line.artic     = v-artic
     1856           and buf_doc-line.prod-type = v-prod-type
     1857           and buf_doc-line.prod-code = v-prod-code
     1858         no-error .
     1859       if not available buf_doc-line then do:
     1860         message
     1861           vss-workfile vss-revision vss-description skip
     1862           vss-include-info18 skip
     1863           "Ошибка задания входных параметров" skip
     1864           "Не найдена строка документа"  skip
     1865           "Документ" v-doc-code skip
     1866           "Артикул" v-artic v-prod-type v-prod-code skip
     1867           view-as alert-box error .
     1868         return error .
     1869       end.
     1870       find first buf_trn-doc no-lock
     1871         where buf_trn-doc.doc-code = v-doc-code
     1872         no-error .
     1873       if not available buf_trn-doc then do:
     1874         message
     1875           vss-workfile vss-revision vss-description skip
     1876           vss-include-info18 skip
     1877           "Ошибка задания входных параметров" skip
     1878           "Не найден документ" skip
     1879           "Документ" v-doc-code skip
     1880           "Артикул" v-artic v-prod-type v-prod-code skip
     1881           view-as alert-box error .
     1882         undo, return error .
     1883       end.
     1884       find first buf_goods no-lock
     1885         where buf_goods.artic     = buf_doc-line.artic
     1886           and buf_goods.prod-type = buf_doc-line.prod-type
     1887           and buf_goods.prod-code = buf_doc-line.prod-code
     1888         no-error .
     1889       if not available buf_goods then do:
     1890         message
     1891           vss-workfile vss-revision vss-description skip
     1892           vss-include-info18 skip
     1893           "Ошибка задания входных параметров" skip
     1894           "Не найден товар" skip
     1895           "Документ" v-doc-code skip
     1896           "Артикул" v-artic v-prod-type v-prod-code skip
     1897           view-as alert-box error .
     1898         undo, return error .
     1899       end.
     1900       if buf_goods.gds-type = 'т':U then do:
     1901             for each buf_parts no-lock
     1902               where buf_parts.out-code  = buf_trn-doc.doc-code
     1903                 and buf_parts.obj-type  = buf_trn-doc.obj-type
     1904                 and buf_parts.obj-code  = buf_trn-doc.obj-code
     1905                 and buf_parts.artic     = buf_doc-line.artic
     1906                 and buf_parts.prod-type = buf_doc-line.prod-type
     1907                 and buf_parts.prod-code = buf_doc-line.prod-code
     1908             on error undo, return error
     1909             :
     1910   assign
     1911     price-rubl-with-tax-loc = buf_parts.price-rubl
     1912     price-base-with-tax-loc = buf_parts.price-base
     1913   .
     1914   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1915   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1916     (output varinvprb
     1917     )  .
     1918     if buf_parts.out-code = 'free-zone':U     or
     1919        buf_parts.out-code = 'out-zone':U   or
     1920        buf_parts.doc-type = 'акт':U then do:
     1921       assign
     1922         in-vatp-have-vat-slt = yes.
     1923     end.
     1924     else do:
     1925       find first in-vatp_doc-attr no-lock
     1926         where in-vatp_doc-attr.doc-code  = buf_parts.out-code
     1927           and in-vatp_doc-attr.attr-code = 'envd':U
     1928         no-error .
     1929       if not available in-vatp_doc-attr then do:
     1930         assign
     1931           in-vatp-have-vat-slt = yes.
     1932       end.
     1933       else do:
     1934            in-vatp-have-vat-slt = no.
     1935       end.
     1936     end.
     1937     assign
     1938      price-cli-with-tax-loc = buf_parts.price-cli
     1939      cli-base-rate          = buf_parts.cli-base-rate.
     1940     ASSIGN   road-tax-base-loc  = (if buf_parts.road-tax-base  = ? then 0 else buf_parts.road-tax-base)
     1941              road-tax-rubl-loc  = (if buf_parts.road-tax-rubl  = ? then 0 else buf_parts.road-tax-rubl).
     1942     ASSIGN  transport-base-loc = (if buf_parts.transport-base = ? then 0 else buf_parts.transport-base)
     1943             transport-rubl-loc = (if buf_parts.transport-rubl = ? then 0 else buf_parts.transport-rubl)
     1944             other-base-loc     = (if buf_parts.other-base     = ? then 0 else buf_parts.other-base)
     1945             other-rubl-loc     = (if buf_parts.other-rubl     = ? then 0 else buf_parts.other-rubl)
     1946             vat-pc-loc         = (if buf_parts.vat-pc         = ? then 0 else buf_parts.vat-pc)
     1947             slt-pc-loc         = (if buf_parts.slt-pc         = ? then 0 else buf_parts.slt-pc).
     1948             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     1949       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     1950     assign
     1951       exch-rate-cli-loc = (buf_parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if buf_parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if buf_parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / buf_parts.price-cli .
     1952     assign
     1953       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
     1954       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
     1955       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
     1956       transport-cli-loc  = 0
     1957       other-cli-loc      = 0
     1958     .
     1959   ASSIGN
