     2876   procedure get-db-list-for-d-card2 :
     2877   define input parameter p-d-card as character no-undo .
     2878   define variable v-current-db-processed as logical no-undo .
     2879   define buffer buf_clients  for ub.clients.
     2880   define buffer buf_dis-obj for ub.dis-obj.
     2881   define buffer buf_temp-smart-route for temp-smart-route.
     2882     do
     2883     on error undo, return error return-value
     2884     :
     2885       for each buf_dis-obj no-lock where
     2886               buf_dis-obj.d-card = p-d-card,
     2887          first buf_clients no-lock where
     2888               buf_clients.obj-type = buf_dis-obj.obj-type
     2889           and buf_clients.obj-code = buf_dis-obj.obj-code
     2890       break by
     2891       buf_clients.db-num:
     2892         if first-of(buf_Clients.db-num) then do:
     2893           find first buf_temp-smart-route no-lock where
     2894                 buf_temp-smart-route.key-field = p-d-card
     2895             and buf_temp-smart-route.db-num = buf_clients.db-num
     2896                 no-error.
     2897           if available buf_temp-smart-route then return.
     2898           create buf_temp-smart-route.
     2899           assign
     2900           buf_temp-smart-route.key-field = p-d-card
     2901           buf_temp-smart-route.db-num = buf_clients.db-num
     2902           .
     2903           if buf_clients.db-num = g#db-num then do:
     2904             v-current-db-processed = yes.
     2905           end.
     2906         end.
     2907       end.
     2908       if not v-current-db-processed then do:
     2909         find first buf_temp-smart-route no-lock where
     2910               buf_temp-smart-route.key-field = p-d-card
     2911           and buf_temp-smart-route.db-num = g#db-num  no-error.
     2912         if not available buf_temp-smart-route then do:
     2913           create buf_temp-smart-route.
     2914           assign
     2915           buf_temp-smart-route.key-field = p-d-card
     2916           buf_temp-smart-route.db-num = g#db-num
     2917           .
     2918         end.
     2919       end.
     2920     end.
     2921   end procedure.
