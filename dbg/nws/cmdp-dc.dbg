     5062                       dc-list.d-card = buf_dis-card.d-card no-lock no-error.
     5063             if not available dc-list then do:
     5064               create dc-list.
     5065             end.
     5066             buffer-copy buf_dis-card to dc-list.
     5067           end.
     5068           delete buf_temp-firm.
     5069         end.
     5070         when 'person':U then do:
     5071           v-h-action = integer('2':U).
     5072           create buf_temp-person.
     5073           run nws-impl-without-check in p-imp-handle
     5074             ( input (buffer buf_temp-person:handle)
     5075             ) no-error.
     5076           if error-status:error then do:
     5077             delete procedure v-cmd-proc-handle .
     5078             undo _main, return error return-value .
     5079           end.
     5080           find first buf_person exclusive-lock where
     5081                   buf_person.psn-code = buf_temp-person.psn-code no-error.
     5082           if not available buf_person then do:
     5083             create buf_person.
     5084             buffer-copy buf_temp-person
     5085             using psn-code
     5086             to buf_person.
     5087             v-h-action = integer('1':U).
     5088           end.
     5089           run clientsh_write-person-rul  in this-procedure (
     5090                                                     buffer buf_person
     5091                                                   ,input v-h-action).
     5092           buffer-copy buf_temp-person to buf_person.
     5093           if g#db-num = 0
     5094           and p-step = 1
     5095           then do:
     5096             run clientsh_send-person-rul  in this-procedure (
     5097                                                       buffer buf_person
     5098                                                     ,input v-h-action).
     5099           end.
     5100           for each buf_dis-card where
     5101                   buf_dis-card.cli-type = 'чел':U
     5102               AND buf_dis-card.cli-code = buf_person.psn-code
     5103           on error  undo _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     5104           on stop   undo _main, return error substitute( "&1. stop", vss-workfile )
     5105           on endkey undo _main, return error substitute( "&1. endkey", vss-workfile ) :
     5106             find first dc-list where
     5107                       dc-list.d-card = buf_dis-card.d-card no-lock no-error.
     5108             if not available dc-list then do:
     5109               create dc-list.
     5110             end.
     5111             buffer-copy buf_dis-card to dc-list.
     5112           end.
     5113           delete buf_temp-person.
     5114         end.
     5115         when 'c-dis-obj':U
     5116         or
     5117         when 'c-dis-host':U
     5118         or
     5119         when 'c-dc-hist':U
     5120         or
     5121         when 'c-dis-card-property':U
     5122         or
     5123         when 'c-clients':U
     5124         or
     5125         when 'c-cli-hist':U
     5126         or
     5127         when 'c-firm':U
     5128         or
     5129         when 'c-person':U
     5130         or
     5131         when 'c-dis-card':U
     5132         then do:
     5133           run proc-load-standart in p-imp-handle
     5134               (  input v-rec-name
     5135                 ,input '':U
     5136                 ,input ?
     5137                 ,input p-imp-handle
     5138                 ,input 0
     5139                 ,output v-curr-rowid
     5140                 ) no-error.
     5141           if error-status:error then do:
     5142             delete procedure v-cmd-proc-handle .
     5143             undo _main, return error return-value .
     5144           end.
     5145         end.
     5146         otherwise do:
     5147           message
     5148           vss-workfile vss-revision vss-description skip
     5149           substitute("НЕ ПРЕДУСМОТРЕН ПРИЕМ ТАБЛИЦЫ &1 В ПРОЦЕДУРЕ", v-rec-name)
     5150           view-as alert-box error .
     5151           delete procedure v-cmd-proc-handle .
     5152           undo _main, return error return-value .
     5153         end.
     5154       end case.
     5155     end.
     5156     run hide-counter in p-log-handle no-error .
     5157     if no then do:
     5158       run perproc-delete-from-parent  in this-procedure (
     5159                                                           input this-procedure:handle
     5160                                                           ,input '':U  ).
     5161     end.
     5162     if g#db-num = 0
     5163     and  p-step < 2
     5164     then do:
     5165       find first buf1_temp-cmd where buf1_temp-cmd.db-list = string(-1).
     5166     end.
     5167     _temp-cmd:
     5168     for each buf_temp-cmd
     5169     on error undo _main, return error :
     5170       if buf_temp-cmd.db-list = string(-1) then next _temp-cmd.
     5171       if g#db-num = 0 then do:
     5172         for each buf_temp-smart-link ,
     5173         first buf_temp-smart-route
     5174         where buf_temp-smart-route.key-field = buf_temp-smart-link.key-field
     5175           and (buf_temp-smart-link.is-smart = no
     5176                 or buf_temp-smart-route.db-num = integer(buf_temp-cmd.db-list))
     5177         by buf_temp-smart-link.rec-ord:
     5178           find first buf_temp-no-route where
     5179                     buf_temp-no-route.db-num = integer(buf_temp-cmd.db-list)
     5180                 and buf_temp-no-route.rec-ord = buf_temp-smart-link.rec-ord no-error .
     5181           if not available buf_temp-no-route then do:
     5182                                                               run copy-dump in v-cmd-proc-handle                                                                           (input buf1_temp-cmd.cmd-code                                                                                         ,input buf_temp-cmd.cmd-code                                                                                          ,input buf_temp-smart-link.rec-ord                                                                                    ,input buf_temp-smart-link.uniq-key-rec                                                                                    ) no-error .                                                                                               if error-status :error                                                                                       then do:                                                                                                     delete procedure v-cmd-proc-handle .                                                                        undo , return error substitute("&1 &2 &3&4Ошибка при копировании записи &5 из команды с кодом &6 в команду с кодом &7&4&8&4&9&4"                                       ,vss-workfile                                                                                                ,vss-revision                                                                                                ,vss-description                                                                                             ,chr(10)                                                                                               ,buf_temp-smart-link.uniq-key-rec                                                                                           ,buf1_temp-cmd.cmd-code                                                                                           ,buf_temp-cmd.cmd-code                                                                                           ,error-status:get-message(1)                                                                                 ,return-value                                                                                                ) .                                                                    end.
     5183           end.
     5184           else do:
     5185             delete buf_temp-no-route.
     5186           end.
     5187         end.
     5188         for each buf_temp-smart-route where
     5189                 buf_temp-smart-route.db-num = integer(buf_temp-cmd.db-list):
     5190           delete buf_temp-smart-route.
     5191         end.
     5192       end.
     5193       v-is-empty = no.
     5194       run is-almost-empty in v-cmd-proc-handle ( input buf_temp-cmd.cmd-code
     5195                                         ,output v-is-empty) no-error.
     5196       if v-is-empty then do:
     5197         run delete-command in v-cmd-proc-handle ( input buf_temp-cmd.cmd-code ).
     5198       end.
     5199       if not v-is-empty and not mode-erprn then do:
     5200         run send-command in v-cmd-proc-handle
     5201           ( input buf_temp-cmd.cmd-code
     5202             ,input buf_temp-cmd.db-list
     5203             ) no-error .
     5204         if error-status :error then do:
     5205           delete procedure v-cmd-proc-handle .
     5206           undo _main, return error substitute("&1 &2 &3&4Ошибка при отправке в новости команды с кодом &5 &8&4" +
     5207                                               "&6&4&7"
     5208                                               ,vss-workfile
     5209                                               ,vss-revision
     5210                                               ,vss-description
     5211                                               ,chr(10)
     5212                                               ,v-cmd-code
     5213                                               ,error-status:get-message(1)
     5214                                               ,return-value
     5215                                               ,(if buf_temp-cmd.db-list = '':u then '':u else substitute(" - БД № &1", buf_temp-cmd.db-list))
     5216                                               ).
     5217         end.
     5218       end.
     5219     end.
     5220     case p-cmd-doc-type:
     5221       when 'sale-close':U
     5222       or
     5223       when 'trn-doc-close':U
     5224       then do:
     5225         define variable v-deleted as logical no-undo .
     5226         if p-step = 1
     5227         and g#db-num = 0
     5228         then do:
     5229   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-del in g#trdcalib (  input p-cmd-doc-code ,
     5230                           input 'need-saledc':U ,
     5231                          output v-deleted ) no-error .
     5232          end.
     5233       end.
     5234       when 'sale-delete':U
     5235       or
     5236       when 'trn-doc-delete':U
     5237       then do:
     5238         if p-step = 1
     5239         and g#db-num = 0
     5240         then do:
     5241   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-wrt in g#trdcalib ( input p-cmd-doc-code ,
     5242                          input 'need-saledc':U ,
     5243                          input string(1) ) no-error .
     5244          end.
     5245       end.
     5246       otherwise do:
     5247       end.
     5248     end case.
     5249     if valid-handle(v-cmd-proc-handle) then do:
     5250       delete procedure v-cmd-proc-handle .
     5251     end.
     5252     run write-log-and-file in p-log-handle (
     5253           input 1
     5254         , input log-file-name
     5255         , input 1
     5256         , input substitute("Данные по ДК: &1 ЗАВЕРШЕНО ", p-cmd-doc-code)) no-error .
     5257   end.
     5258   procedure write-to-log :
     5259   define input parameter p-mess as character no-undo .
     5260     do
     5261     on error undo, return error
     5262     :
     5263     run write-log-and-file in p-log-handle (
     5264           input 1
     5265         , input log-file-name
     5266         , input 1
     5267         , input p-mess).
     5268     end.
     5269   end procedure.
     5270   procedure proc-verify-d-card :
     5271   define input parameter p-rec-name as character no-undo .
     5272   define input parameter p-d-card as character no-undo .
     5273   define input parameter p-dt-code as integer no-undo .
     5274   define output parameter p-type as character no-undo .
     5275   define output parameter p-emitent-host-code as integer no-undo .
     5276   define output parameter p-dtm-code as integer no-undo .
     5277   define variable v-call#-id as integer no-undo .
     5278   define buffer buf_temp-d-card for temp-d-card.
     5279   define buffer buf_temp-prop-ref for temp-prop-ref .
     5280   define buffer buf_dis-card for ub.dis-card.
     5281   define buffer buf_prop-ref for ub.prop-ref.
     5282   do
     5283   on error undo, return error
     5284   :
     5285   find first buf_temp-d-card no-lock where
     5286           buf_temp-d-card.d-card = p-d-card no-error .
     5287   if not available buf_temp-d-card then do:
     5288     find first buf_Dis-card no-lock where
     5289               buf_Dis-card.d-card = p-d-card no-error.
     5290     if not available buf_Dis-card
     5291     then do:
     5292       if p-cmd-doc-type = 'sale-xml-import':U then return.
     5293       undo, return error substitute("Ошибка при поиске ДК &1:Получена запись таблицы &2 для этой карты"
     5294                                         ,p-d-card
     5295                                         ,p-rec-name
     5296                                         ).
     5297     end.
     5298     assign
     5299     p-type = buf_dis-card.type
     5300     p-emitent-host-code = buf_dis-card.emitent-host-code
     5301     .
     5302   end.
     5303   else do:
     5304     assign
     5305     p-type = buf_temp-d-card.type
     5306     p-emitent-host-code = buf_temp-d-card.emitent-host-code
     5307     .
     5308   end.
     5309   if p-dt-code <> -1 then do:
     5310     find first buf_temp-prop-ref no-lock where
     5311               buf_temp-prop-ref.dt-code = p-dt-code no-error.
     5312     if not available buf_temp-prop-ref then do:
     5313       find first buf_prop-ref no-lock where
     5314                 buf_prop-ref.dt-code = p-dt-code no-error.
     5315       if not available buf_prop-ref then do:
     5316         undo, return error substitute("Ошибка при поиске ДК &1:Получена запись таблицы &2 для этой карты&3Неизвестный срез/итог &4"
     5317                                           ,p-d-card
     5318                                           ,p-rec-name
     5319                                           ,chr(10)
     5320                                           ,p-dt-code
     5321                                           ).
     5322       end.
     5323       create buf_temp-prop-ref.
     5324       buffer-copy buf_prop-ref to buf_temp-prop-ref.
     5325     end.
     5326     p-dtm-code  = buf_temp-prop-ref.dtm-code.
     5327     v-call-id = substitute("&2&1&3&1&4&1&5&1&6&1&7"
     5328                           , chr(3)
     5329                           , 'dis-card-type':U
     5330                           , p-emitent-host-code
     5331                           , p-type
     5332                           , 0
     5333                           , '':U
     5334                           , 0).
     5335   end.
     5336   end.
     5337   end procedure.
     5338   procedure set-stop-leave-status :
     5339   define input parameter p-stop-leave-status as character no-undo .
     5340   do
     5341   on error undo, return error
     5342   :
     5343     assign
     5344     v-stop-leave-status = p-stop-leave-status.
     5345   end.
     5346   end procedure.
     5347   procedure cb_create-dc-list :
     5348   define input parameter p-bh as handle no-undo .
     5349   define variable v-dch as handle no-undo .
     5350   do
     5351   on error undo, return error return-value
     5352   :
     5353   end.
     5354   end procedure.
