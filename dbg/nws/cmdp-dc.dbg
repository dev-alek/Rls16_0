      165   index iid
      166   id
      167   index ird
      168   rank-to-delete
      169   .
      170   define variable v-per-proc-num as integer no-undo .
      171   procedure perproc-create-proc :
      172   define input  parameter p-parent-handle as handle no-undo .
      173   define input  parameter p-proc-name as character no-undo .
      174   define input  parameter p-proc-handle  as handle no-undo .
      175   define input  parameter p-run        as logical no-undo .
      176   define input  parameter p-parameter as character no-undo .
      177   define input  parameter p-userid as character no-undo .
      178   define input  parameter p-rank-to-delete as integer no-undo .
      179   define output parameter p-id as integer   no-undo .
      180   define variable ii as integer   no-undo .
      181   define variable v-proc-handle as handle no-undo .
      182   define buffer buf_temp-pers-proc for temp-pers-proc.
      183   define buffer buf0_temp-pers-proc for temp-pers-proc.
      184     do
      185     on error undo, return error return-value
      186     :
      187       if v-per-proc-num > 100 then return error '>'.
      188       find first buf0_temp-pers-proc no-lock where
      189                 buf0_temp-pers-proc.proc-name = p-proc-name use-index pi    no-error.
      190       if not available buf0_temp-pers-proc then do:
      191         if p-run then do:
      192           run value(p-proc-name) persistent SET v-proc-handle (input p-parameter) no-error.
      193           if error-status :error then undo, return error return-value .
      194         end.
      195         else v-proc-handle = p-proc-handle.
      196         find last buf0_temp-pers-proc no-lock use-index iid  no-error.
      197         create buf_temp-pers-proc.
      198         assign
      199         buf_temp-pers-proc.proc-name = p-proc-name
      200         buf_temp-pers-proc.id = (if not available buf0_temp-pers-proc
      201                                   then  0
      202                                   else buf0_temp-pers-proc.id + 1)
      203         buf_temp-pers-proc.user-name = p-userid
      204         buf_temp-pers-proc.vpar      = p-parameter
      205         buf_temp-pers-proc.vparent-handle = p-parent-handle
      206         buf_temp-pers-proc.vproc-handle = v-proc-handle
      207         buf_temp-pers-proc.rank-to-delete = p-rank-to-delete
      208         p-id = buf_temp-pers-proc.id
      209         v-per-proc-num = v-per-proc-num + 1
      210         .
      211       end.
      212       else p-id = buf0_temp-pers-proc.id.
      213     end.
      214   end procedure.
      215   procedure perproc-delete-proc-user :
      216   define input  parameter p-proc-name as character no-undo .
      217   define input  parameter p-user-name as character no-undo .
      218   define buffer buf_temp-pers-proc for temp-pers-proc.
      219     do
      220     on error undo, return error return-value
      221     :
      222        for each buf_temp-pers-proc where
      223               buf_temp-pers-proc.proc-name = p-proc-name
      224          AND  buf_temp-pers-proc.user-name = p-user-name:
      225           APPLY "delete" to buf_temp-pers-proc.vproc-handle.
      226           delete procedure buf_temp-pers-proc.vproc-handle.
      227           delete buf_temp-pers-proc.
      228           v-per-proc-num = v-per-proc-num - 1.
      229        end.
      230     end.
      231   end procedure.
      232   procedure perproc-delete-proc-id :
      233   define input  parameter p-id        as integer   no-undo .
      234   define buffer buf_temp-pers-proc for temp-pers-proc.
      235     do
      236     on error undo, return error return-value
      237     :
      238        for each buf_temp-pers-proc where
      239           buf_temp-pers-proc.id        = p-id:
      240           APPLY "delete" to buf_temp-pers-proc.vproc-handle.
      241           delete procedure buf_temp-pers-proc.vproc-handle.
      242           delete buf_temp-pers-proc.
      243           v-per-proc-num = v-per-proc-num - 1.
      244        end.
      245     end.
      246   end procedure.
      247   procedure perproc-delete-by-rank :
      248   define buffer buf_temp-pers-proc for temp-pers-proc.
      249     do
      250     on error undo, return error return-value
      251     :
      252       for each buf_temp-pers-proc where
      253       by buf_temp-pers-proc.rank-to-delete:
      254         APPLY "delete" to buf_temp-pers-proc.vproc-handle.
      255         delete procedure buf_temp-pers-proc.vproc-handle.
      256         delete buf_temp-pers-proc.
      257         v-per-proc-num = v-per-proc-num - 1.
      258       end.
      259     end.
      260   end procedure.
      261   procedure perproc-delete-proc-name-id :
      262   define input  parameter p-proc-name as character no-undo .
      263   define input  parameter p-id        as integer   no-undo .
      264   define buffer buf_temp-pers-proc for temp-pers-proc.
      265     do
      266     on error undo, return error return-value
      267     :
      268        for each buf_temp-pers-proc where
      269               buf_temp-pers-proc.proc-name = p-proc-name
      270          AND  buf_temp-pers-proc.id        = p-id:
      271           APPLY "delete" to buf_temp-pers-proc.vproc-handle.
      272           delete procedure buf_temp-pers-proc.vproc-handle.
      273           delete buf_temp-pers-proc.
      274           v-per-proc-num = v-per-proc-num - 1.
      275        end.
      276     end.
      277   end procedure.
      278   procedure perproc-delete-par :
      279   define input  parameter p-proc-name as character no-undo .
      280   define input  parameter p-parameter as character no-undo .
      281   define buffer buf_temp-pers-proc for temp-pers-proc.
      282     do
      283     on error undo, return error return-value
      284     :
      285        for each buf_temp-pers-proc where
      286               buf_temp-pers-proc.proc-name = p-proc-name
      287          AND  buf_temp-pers-proc.vpar      = p-parameter:
      288           APPLY "delete" to buf_temp-pers-proc.vproc-handle.
      289           delete procedure buf_temp-pers-proc.vproc-handle.
      290           delete buf_temp-pers-proc.
      291           v-per-proc-num = v-per-proc-num - 1.
      292        end.
      293     end.
      294   end procedure.
      295   procedure perproc-delete-from-parent :
      296   define input  parameter p-parent-handle as handle no-undo .
      297   define input  parameter p-proc-name as character no-undo .
      298   define buffer buf_temp-pers-proc for temp-pers-proc.
      299     do
      300     on error undo, return error return-value
      301     :
      302        if p-proc-name = "":u then do:
      303         for each buf_temp-pers-proc where
      304            buf_temp-pers-proc.vparent-handle      = p-parent-handle:
      305             APPLY "delete" to buf_temp-pers-proc.vproc-handle.
      306             delete procedure buf_temp-pers-proc.vproc-handle.
      307             delete buf_temp-pers-proc.
      308             v-per-proc-num = v-per-proc-num - 1.
      309         end.
      310        end.
      311        else do:
      312         for each buf_temp-pers-proc where
      313                 buf_temp-pers-proc.proc-name = p-proc-name
      314           AND  buf_temp-pers-proc.vparent-handle      = p-parent-handle:
      315             APPLY "delete" to buf_temp-pers-proc.vproc-handle.
      316             delete procedure buf_temp-pers-proc.vproc-handle.
      317             delete buf_temp-pers-proc.
      318             v-per-proc-num = v-per-proc-num - 1.
      319         end.
      320       end.
      321     end.
      322   end procedure.
      323   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      324   define new global shared variable g#lib-nws as handle no-undo .
      325   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      326   def var vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      327   procedure gen-key-rec :
      328     define input  parameter p-tbl-name    as character no-undo.
      329     define input  parameter p-bh_tbl-name as handle    no-undo.
      330     define output parameter p-key-rec     as character no-undo.
      331     do
      332     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      333     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      334     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      335     :
      336       define variable fh               as handle    no-undo .
      337       define variable v-ok             as logical   no-undo .
      338       define variable v-inform         as character no-undo .
      339       define variable v-ind            as integer   no-undo .
      340       define variable v-idx-field-qnty as integer   no-undo .
      341       if p-tbl-name = ?
      342         or p-tbl-name = "":U
      343       then do:
      344         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info6 ).
      345       end.
      346       if not p-bh_tbl-name:available then do:
      347         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info6, p-tbl-name ).
      348       end.
      349       assign
      350         p-key-rec = p-tbl-name
      351         v-inform  = p-bh_tbl-name:index-information(1)
      352         v-ind     = 2
      353       .
      354       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      355       on error undo, return error
      356       :
      357         assign
      358           v-inform = p-bh_tbl-name:index-information( v-ind )
      359           v-ind    = v-ind + 1
      360         .
      361       end.
      362       if v-inform = ?
      363         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      364         or entry( 3, v-inform, ",":U ) <> "1":U
      365       then do:
      366         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info6, p-tbl-name ).
      367       end.
      368       else do:
      369         assign
      370           v-idx-field-qnty = num-entries( v-inform ) - 4
      371         .
      372         if v-idx-field-qnty < 2 then do:
      373           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info6, v-inform, p-tbl-name ).
      374         end.
      375         do v-ind = 1 to v-idx-field-qnty by 2
      376         on error undo, return error
      377         :
      378           assign
      379             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      380             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      381           .
      382         end.
      383       end.
      384       if p-key-rec = ? then do:
      385         assign
      386           p-key-rec = "":U
      387         .
      388         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info6, p-tbl-name ).
      389       end.
      390     end.
      391     return.
      392   end procedure.
      393   procedure gen-where-keyr-tab :
      394     define input  parameter i-tableSerach as character no-undo.
      395     define input  parameter i-tablekey   as character  no-undo.
      396     define input  parameter p-key-rec    as character  no-undo.
      397     define input  parameter p-key-handle as handle     no-undo .
      398     define input  parameter p-db-name    as character  no-undo .
      399     define input  parameter p-tt-handle  as handle     no-undo .
      400     define output parameter o-Where      as character  no-undo.
      401     do
      402     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      403     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      404     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      405     :
      406       define variable v-full-tbl-name  as character no-undo .
      407       define variable bh_tbl-name      as handle    no-undo .
      408       define variable fh_key           as handle    no-undo .
      409       define variable fh_search        as handle    no-undo .
      410       define variable v-field-num      as integer   no-undo .
      411       define variable v-count-fld      as integer   no-undo .
      412       define variable v-inform         as character no-undo .
      413       define variable v-ind            as integer   no-undo .
      414       define variable v-idx-field-qnty as integer   no-undo .
      415       define variable v-field-name     as character no-undo .
      416       define variable v-field-val      as character no-undo .
      417       define variable v-word-link      as character no-undo .
      418       define variable vTable           as character no-undo.
      419       define variable bh_tbl-key       as handle    no-undo .
      420       assign
      421         p-key-rec = trim( p-key-rec )
      422       .
      423       if p-key-handle <> ? then do:
      424         if not valid-handle(p-key-handle)
      425            or p-key-handle:type <> "buffer"
      426         then do:
      427           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info6 ).
      428         end.
      429         if num-entries( p-key-rec, chr(3) ) > 1
      430           or p-key-rec = ?
      431           or p-key-rec = "":U
      432         then do:
      433           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info6, p-key-rec ).
      434         end.
      435       end.
      436       else do:
      437         if p-key-rec = ?
      438           or p-key-rec = "":U
      439         then do:
      440           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info6 ).
      441         end.
      442       end.
      443       assign
      444         vTable = entry( 1 , p-key-rec, chr(3) )
      445       .
      446       if p-tt-handle <> ?
      447         and ( not valid-handle(p-tt-handle)
      448               or p-tt-handle:type <> "buffer"
      449             )
      450       then do:
      451         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info6, vTable, chr(10) ).
      452       end.
      453       if p-tt-handle = ? then do:
      454         assign
      455           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      456         .
      457         create buffer bh_tbl-name for table v-full-tbl-name .
      458       end.
      459       else do:
      460         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      461       end.
      462       assign
      463         v-inform = bh_tbl-name:index-information(1)
      464         v-ind    = 2
      465       .
      466       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      467       on error undo, return error
      468       :
      469         assign
      470           v-inform = bh_tbl-name:index-information( v-ind )
      471           v-ind    = v-ind + 1
      472         .
      473       end.
      474       if v-inform = ?
      475         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      476         or entry( 3, v-inform, ",":U ) <> "1":U
      477       then do:
      478         delete object bh_tbl-name no-error.
      479         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info6, vTable ).
      480       end.
      481       assign
      482         v-idx-field-qnty = num-entries( v-inform ) - 4
      483       .
      484       if v-idx-field-qnty < 2 then do:
      485         delete object bh_tbl-name no-error.
      486         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info6, v-inform, vTable ).
      487       end.
      488       assign
      489         o-where     = "where":U
      490         v-word-link = "":U
      491         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      492         v-count-fld = 0
      493       .
      494       if i-tablekey ne "" and i-tablekey ne ?
      495       then do:
      496         assign
      497           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      498         .
      499         create buffer bh_tbl-key for table v-full-tbl-name .
      500       end.
      501       if i-tableSerach ne "" and i-tableSerach ne ?
      502       then do:
      503         delete object bh_tbl-name no-error.
      504         assign
      505           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      506         .
      507         create buffer bh_tbl-name for table v-full-tbl-name .
      508       end.
      509       block_where:
      510       do v-ind = 1 to v-idx-field-qnty by 2
      511       on error undo, return error
      512       :
      513         assign
      514           v-count-fld = v-count-fld + 1
      515         .
      516         if p-key-handle = ?
      517           and v-count-fld > v-field-num
      518         then do:
      519           leave block_where.
      520         end.
      521         define variable VfieldKeyTable as handle no-undo.
      522         assign
      523           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      524           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      525         .
      526         if     bh_tbl-key ne ?
      527         then do:
      528            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      529            if VfieldKeyTable eq ?
      530            then next block_where.
      531         end.
      532         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      533         then
      534            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      535         else
      536            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      537         if p-key-handle = ? then do:
      538           assign
      539             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      540           .
      541         end.
      542         else do:
      543           assign
      544             fh_key = p-key-handle:buffer-field( v-field-name )
      545           .
      546           if fh_key = ?
      547             or not valid-handle( fh_key )
      548           then do:
      549             delete object bh_tbl-name.
      550             if     bh_tbl-key ne ?
      551             then
      552                delete object bh_tbl-key.
      553             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info6, p-key-handle:name, v-field-name ).
      554           end.
      555           assign
      556             v-field-val = fh_key:buffer-value
      557           .
      558         end.
      559         if fh_search:data-type ="character":U then do:
      560           assign
      561             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      562             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      563             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      564             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      565             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      566             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      567             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      568             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      569             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      570             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      571             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      572             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      573             v-field-val = substitute( '"&1"', v-field-val )
      574           .
      575         end.
      576         assign
      577           o-where = substitute( "&1 &2", o-where, v-field-val )
      578         .
      579         if v-word-link = "":U then do:
      580           assign
      581             v-word-link = "and":U
      582           .
      583         end.
      584       end.
      585       delete object bh_tbl-name.
      586       if     bh_tbl-key ne ?
      587       then
      588          delete object bh_tbl-key.
      589       if p-key-handle = ?
      590         and v-count-fld <> v-field-num
      591       then do:
      592         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info6, vTable ).
      593       end.
      594     end.
      595   end procedure.
      596   procedure gen-hn-keyr-tab :
      597     define input  parameter i-tableSerach as character no-undo.
      598     define input  parameter i-tablekey   as character no-undo.
      599     define input  parameter p-key-rec    as character no-undo.
      600     define input  parameter p-key-handle as handle    no-undo .
      601     define input  parameter p-db-name    as character no-undo .
      602     define input  parameter p-tt-handle  as handle    no-undo .
      603     define input  parameter p-stts-lock  as integer   no-undo .
      604     define output parameter o-hn         as handle    no-undo.
      605     define variable v-full-tbl-name as character no-undo.
      606     define variable v-where         as character no-undo.
      607     define variable bh_tbl-name     as handle    no-undo.
      608     define variable vTable          as character no-undo.
      609     do
      610     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      611     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      612     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      613         run gen-where-keyr-tab(i-tableSerach,
      614                                i-tablekey,
      615                                p-key-rec,
      616                                p-key-handle,
      617                                p-db-name,
      618                                p-tt-handle,
      619                                output v-where).
      620         if i-tableSerach ne "" and i-tableSerach ne ?
      621         then do:
      622            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      623            create buffer bh_tbl-name for table v-full-tbl-name .
      624         end.
      625         else do:
      626            if p-tt-handle = ? then do:
      627               assign
      628                  vTable = entry( 1 , p-key-rec, chr(3) )
      629               .
      630               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      631               create buffer bh_tbl-name for table v-full-tbl-name .
      632            end.
      633            else do:
      634               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      635            end.
      636         end.
      637         if p-tt-handle = ? then do:
      638            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      639         end.
      640         else do:
      641            bh_tbl-name:find-first( v-where ) no-error .
      642         end.
      643         o-hn = bh_tbl-name.
      644      end.
      645   end procedure.
      646   procedure gen-hn-keyr :
      647     define input  parameter p-key-rec    as character no-undo.
      648     define input  parameter p-key-handle as handle    no-undo .
      649     define input  parameter p-db-name    as character no-undo .
      650     define input  parameter p-tt-handle  as handle    no-undo .
      651     define input  parameter p-stts-lock  as integer   no-undo .
      652     define output parameter o-hn         as handle    no-undo.
      653     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      654   end.
      655   procedure gen-row-keyr :
      656     define input  parameter p-key-rec    as character no-undo.
      657     define input  parameter p-key-handle as handle    no-undo .
      658     define input  parameter p-db-name    as character no-undo .
      659     define input  parameter p-tt-handle  as handle    no-undo .
      660     define input  parameter p-stts-lock  as integer   no-undo .
      661     define output parameter p-tbl-row    as rowid     no-undo.
      662     define output parameter p-tbl-name   as character no-undo.
      663     define variable vHn as handle no-undo.
      664       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      665       p-tbl-row = if vHn:available then vHn:rowid else ?.
      666       p-tbl-name =  vHn:table.
      667       delete object vHn no-error.
      668     if p-tbl-row = ? then do:
      669       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info6, p-tbl-name, p-key-rec ).
      670     end.
      671     else do:
      672       return.
      673     end.
      674   end procedure.
      675   procedure gen-key-fv :
      676     define input  parameter p-key-rec    as character no-undo .
      677     define output parameter p-field-list as character no-undo .
      678     define output parameter p-value-list as character no-undo.
      679     do
      680     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      681     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      682     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      683     :
      684       define variable v-full-tbl-name  as character no-undo .
      685       define variable bh_tbl-name      as handle    no-undo .
      686       define variable v-tbl-name       as character no-undo .
      687       define variable v-field-num      as integer   no-undo .
      688       define variable v-count-fld      as integer   no-undo .
      689       define variable v-inform         as character no-undo .
      690       define variable v-ind            as integer   no-undo .
      691       define variable v-idx-field-qnty as integer   no-undo .
      692       define variable v-delim-key      as character no-undo .
      693       if p-key-rec = ?
      694         or p-key-rec = "":U
      695       then do:
      696         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info6 ).
      697       end.
      698       assign
      699         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      700         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      701       .
      702       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      703       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info6 ).
      704       assign
      705         v-inform = bh_tbl-name:index-information(1)
      706         v-ind    = 2
      707       .
      708       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      709       on error undo, return error
      710       :
      711         assign
      712           v-inform = bh_tbl-name:index-information( v-ind )
      713           v-ind    = v-ind + 1
      714         .
      715       end.
      716       if v-inform = ?
      717         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      718         or entry( 3, v-inform, ",":U ) <> "1":U
      719       then do:
      720         delete object bh_tbl-name no-error.
      721         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info6, v-tbl-name ).
      722       end.
      723       assign
      724         v-idx-field-qnty = num-entries( v-inform ) - 4
      725       .
      726       if v-idx-field-qnty < 2 then do:
      727         delete object bh_tbl-name no-error.
      728         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info6, v-inform, v-tbl-name ).
      729       end.
      730       assign
      731         p-field-list = "":U
      732         p-value-list = "":U
      733         v-delim-key  = "":U
      734         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      735         v-count-fld  = 0
      736       .
      737       block_where:
      738       do v-ind = 1 to v-idx-field-qnty by 2
      739       on error undo, return error
      740       :
      741         assign
      742           v-count-fld = v-count-fld + 1
      743         .
      744         if v-count-fld > v-field-num then do:
      745           leave block_where.
      746         end.
      747         assign
      748           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      749           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      750         .
      751         if v-ind = 1 then do:
      752           assign
      753             v-delim-key = chr(3)
      754           .
      755         end.
      756       end.
      757       delete object bh_tbl-name.
      758       if v-count-fld <> v-field-num then do:
      759         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info6, v-tbl-name ).
      760       end.
      761     end.
      762   end procedure.
      763   procedure gen-key-field :
      764     define input  parameter p-table      as character no-undo .
      765     define output parameter p-field-list as character no-undo .
      766     do
      767     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      768     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      769     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      770     :
      771       define variable v-full-tbl-name  as character no-undo .
      772       define variable bh_tbl-name      as handle    no-undo .
      773       define variable v-tbl-name       as character no-undo .
      774       define variable v-field-num      as integer   no-undo .
      775       define variable v-count-fld      as integer   no-undo .
      776       define variable v-inform         as character no-undo .
      777       define variable v-ind            as integer   no-undo .
      778       define variable v-idx-field-qnty as integer   no-undo .
      779       define variable v-delim-key      as character no-undo .
      780       if p-table = ?
      781         or p-table = "":U
      782       then do:
      783         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info6 ).
      784       end.
      785       assign
      786         v-tbl-name      = p-table
      787         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      788       .
      789       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      790       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info6 ).
      791       assign
      792         v-inform = bh_tbl-name:index-information(1)
      793         v-ind    = 2
      794       .
      795       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      796       on error undo, return error
      797       :
      798         assign
      799           v-inform = bh_tbl-name:index-information( v-ind )
      800           v-ind    = v-ind + 1
      801         .
      802       end.
      803       if v-inform = ?
      804         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      805         or entry( 3, v-inform, ",":U ) <> "1":U
      806       then do:
      807         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info6, v-tbl-name ).
      808       end.
      809       assign
      810         v-idx-field-qnty = num-entries( v-inform ) - 4
      811       .
      812       if v-idx-field-qnty < 2 then do:
      813         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info6, v-inform, v-tbl-name ).
      814       end.
      815       assign
      816         p-field-list = "":U
      817         v-delim-key  = "":U
      818         v-count-fld  = 0
      819       .
      820       block_where:
      821       do v-ind = 1 to v-idx-field-qnty by 2
      822       on error undo, return error
      823       :
      824         assign
      825           v-count-fld = v-count-fld + 1
      826         .
      827         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      828         if v-ind = 1 then do:
      829           assign
      830             v-delim-key = chr(3)
      831           .
      832         end.
      833       end.
      834       delete object bh_tbl-name.
      835     end.
      836   end procedure.
      837   define NEW SHARED temp-table temp-cmd no-undo
      838   field cmd-code as integer
      839   field db-list as character
      840   index pi is unique primary
      841   db-list
      842   index icmd
      843   cmd-code
      844   .
      845   define NEW SHARED temp-table temp-smart-route no-undo
      846   field key-field as character
      847   field db-num as integer
      848   index pi is unique primary
      849   key-field
      850   db-num
      851   .
      852   define NEW SHARED temp-table temp-no-route no-undo
      853   field rec-ord as integer
      854   field db-num as integer
      855   index pi is unique primary
      856   db-num
      857   rec-ord
      858   index iro
      859   rec-ord
      860   .
      861   define NEW SHARED temp-table temp-smart-link no-undo
      862   field uniq-key-rec as character
      863   field key-field as character
      864   field rec-ord as integer
      865   field is-smart as logical
      866   index pi is unique primary
      867   key-field
      868   uniq-key-rec
      869   rec-ord
      870   index iu
      871   uniq-key-rec
      872   index iro
      873   rec-ord
      874   .
      875   define NEW SHARED temp-table temp-nws-outline no-undo
      876   like ub.nws-outline.
      877   procedure create-smart-route :
      878   define input parameter p-key-field as character no-undo .
      879   define input parameter p-db-num as integer no-undo .
      880   define buffer buf_temp-smart-route for temp-smart-route.
      881     do
      882     on error undo, return error
      883     :
      884       find first buf_temp-smart-route where
      885                 buf_temp-smart-route.key-field = p-key-field
      886             and buf_temp-smart-route.db-num = p-db-num no-error.
      887       if not available buf_temp-smart-route then do:
      888         create buf_temp-smart-route.
      889         assign
      890         buf_temp-smart-route.key-field = p-key-field
      891         buf_temp-smart-route.db-num = p-db-num
      892         .
      893       end.
      894     end.
      895   end procedure.
      896   procedure create-smart-route-link :
      897   define input parameter p-tbl-name as character no-undo .
      898   define input parameter p-bh_tbl-name as handle no-undo .
      899   define input parameter p-key-field as character no-undo .
      900   define input parameter p-rec-ord as integer no-undo .
      901   define input parameter p-is-smart as logical no-undo .
      902   define variable v-key-rec as character no-undo .
      903   define buffer buf_temp-smart-link for temp-smart-link.
      904     do
      905     on error undo, return error
      906     :
      907       run gen-key-rec in this-procedure ( input p-tbl-name
      908                                          ,input p-bh_tbl-name
      909                                          ,output v-key-rec     ).
      910      find first buf_temp-smart-link where
      911                 buf_temp-smart-link.uniq-key-rec = v-key-rec
      912              and buf_temp-smart-link.key-field = p-key-field
      913              and buf_temp-smart-link.rec-ord = p-rec-ord
      914              no-error .
      915      if not available buf_temp-smart-link then do:
      916        create buf_temp-smart-link.
      917        assign
      918        buf_temp-smart-link.uniq-key-rec = v-key-rec
      919        buf_temp-smart-link.key-field = p-key-field
      920        buf_temp-smart-link.rec-ord = p-rec-ord
      921        buf_temp-smart-link.is-smart = p-is-smart
      922        .
      923      end.
      924     end.
      925   end procedure.
      926   procedure create-nws-outline :
      927   define input parameter p-cmd-proc-handle as handle no-undo .
      928   define input parameter p-cmd-code as integer no-undo .
      929   define input parameter p-outline-type as character no-undo .
      930   define input parameter p-charkey_one as character no-undo .
      931   define input parameter p-charkey_two as character no-undo .
      932   define input parameter p-charkey_three as character no-undo .
      933   define input parameter p-key#_one as integer no-undo .
      934   define input parameter p-key#_two as integer no-undo .
      935   define input parameter p-key#_three as integer no-undo .
      936   define variable v-no-id as integer no-undo .
      937   define variable v-rec-ord as integer no-undo .
      938     do
      939     on error undo, return error return-value
      940     :
      941       find last temp-nws-outline use-index pi no-error .
      942       v-no-id = (if available temp-nws-outline
      943                  then (temp-nws-outline.no-id  + 1)
      944                  else 1).
      945       create temp-nws-outline.
      946       assign
      947       temp-nws-outline.charkeY_one = p-charkey_one
      948       temp-nws-outline.charkeY_two = p-charkey_two
      949       temp-nws-outline.charkeY_three = p-charkey_three
      950       temp-nws-outline.key#_one = p-key#_one
      951       temp-nws-outline.key#_two = p-key#_two
      952       temp-nws-outline.key#_three = p-key#_three
      953       temp-nws-outline.no-id = v-no-id
      954       temp-nws-outline.outline-type = p-outline-type
      955       .
      956                                   run add-dump in p-cmd-proc-handle                                                                           (input p-cmd-code                                                                                         ,input 'nws-outline':U                                                                                          ,input '+update'                                                                                         ,input (buffer temp-nws-outline:handle)                                                                                    ,input ''                                                                                         ,output v-rec-ord                                                                                         ) no-error .                                                                                               if error-status :error                                                                                       then do:                                                                                                     delete procedure p-cmd-proc-handle .                                                                        undo , return error substitute("&1 &2 &3&4Ошибка при добавлении записи &5 в команду с кодом &6&4&8&4&9&4"                                       ,vss-workfile                                                                                                ,vss-revision                                                                                                ,vss-description                                                                                             ,chr(10)                                                                                               ,'nws-outline':U                                                                                                ,p-cmd-code                                                                                               ,error-status:get-message(1)                                                                                 ,return-value                                                                                                ) .                                                                    end.
      957       run  create-smart-route in this-procedure (
      958                                                   input ('nws-outline':U + chr(4) + string(temp-nws-outline.no-id))
      959                                                  ,input -1).
      960       run create-smart-route-link in this-procedure (
      961                                                      input 'nws-outline':U
      962                                                     ,input (buffer temp-nws-outline:handle)
      963                                                     ,input ('nws-outline':U + chr(4) + string(temp-nws-outline.no-id))
      964                                                     ,input v-rec-ord
      965                                                     ,input no
      966                                                     ).
      967     end.
      968   end procedure.
      969   procedure create-no-route :
      970   define input parameter p-rec-ord as integer no-undo .
      971   define input parameter p-db-num as integer no-undo .
      972   define buffer buf_temp-no-route for temp-no-route.
      973   do
      974   on error undo, return error
      975   :
      976      find first buf_temp-no-route where
      977                 buf_temp-no-route.rec-ord = p-rec-ord
      978              and buf_temp-no-route.db-num = p-db-num no-error .
      979      if not available buf_temp-no-route then do:
      980        create buf_temp-no-route.
      981        assign
      982        buf_temp-no-route.rec-ord = p-rec-ord
      983        buf_temp-no-route.db-num = p-db-num
      984        .
      985      end.
      986   end.
      987   end procedure.
      988   procedure clear-from-rec-ord :
      989   define input parameter p-rec-ord as integer no-undo .
      990   define buffer buf_temp-no-route for temp-no-route.
      991   define buffer buf_temp-smart-link for temp-smart-link.
      992   do
      993   on error undo, return error
      994   :
      995   for each buf_temp-no-route where
      996           buf_temp-no-route.rec-ord > p-rec-ord:
      997     delete buf_temp-no-route.
      998   end.
      999   for each buf_temp-smart-link where
     1000           buf_temp-smart-link.rec-ord > p-rec-ord:
     1001      delete buf_temp-smart-link.
     1002   end.
     1003   end.
     1004   end procedure.
     1005   define buffer buf_temp-cmd  for temp-cmd.
     1006   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1007   procedure cur-time :
     1008      define output parameter p-today as date      no-undo .
     1009      define output parameter p-time  as integer   no-undo .
     1010     do
     1011     on error undo, return error
     1012     :
     1013       define variable v-date1 as date      no-undo .
     1014       define variable v-date2 as date      no-undo .
     1015       define variable v-time  as integer   no-undo .
     1016       assign
     1017         v-date1 = today
     1018         v-time  = time
     1019         v-date2 = today
     1020       .
     1021       if v-date1 <> v-date2
     1022       then do:
     1023         assign
     1024           v-date1 = today
     1025           v-time  = v-time
     1026         .
     1027       end.
     1028       assign
     1029         p-today = v-date1
     1030         p-time  = v-time
     1031       .
     1032     end.
     1033   end.
     1034   function cur-time-date returns character
     1035   :
     1036     return string(today, '99/99/9999':U) .
     1037   end.
     1038   function cur-time-mjd returns decimal
     1039   :
     1040     define variable v-date as date      no-undo .
     1041     define variable v-time as integer   no-undo .
     1042     run cur-time in this-procedure
     1043       (output v-date
     1044       ,output v-time
     1045       ) .
     1046     return integer(v-date) - 2400002 + (v-time / 86400) .
     1047   end.
     1048   function cur-time-get-ending-index returns integer
     1049   (input p-number as integer
     1050   )
     1051   :
     1052     if p-number < 0
     1053     or p-number = ?
     1054     then do:
     1055       return 1 .
     1056     end.
     1057     define variable v-rest as integer   no-undo .
     1058     assign
     1059       p-number = p-number modulo 100
     1060     .
     1061     if p-number < 20
     1062     then do:
     1063       assign
     1064         v-rest = p-number
     1065       .
     1066     end.
     1067     else do:
     1068       assign
     1069         v-rest = p-number modulo 10
     1070       .
     1071     end.
     1072     case v-rest :
     1073       when 1
     1074       then do:
     1075         return 2 .
     1076       end.
     1077       when 2 or
     1078       when 3 or
     1079       when 4
     1080       then do:
     1081         return 3 .
     1082       end.
     1083       otherwise do:
     1084         return 1 .
     1085       end.
     1086     end case .
     1087   end.
     1088   procedure cur-time-mjd-to-date :
     1089      define input  parameter i-mjd-diff as decimal no-undo.
     1090      define output parameter o-Date     as date    no-undo.
     1091      define output parameter o-Time     as integer no-undo.
     1092      define variable v-day-number as integer   no-undo .
     1093      if    i-mjd-diff < 0
     1094         or i-mjd-diff = ?
     1095      then do:
     1096         return "?" .
     1097      end.
     1098      assign
     1099         v-day-number = truncate(i-mjd-diff,0).
     1100         o-Date = date(v-day-number + 2400002).
     1101         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     1102     .
     1103   end.
     1104   function cur-time-mjd-to-string returns character
     1105   (input p-mjd-diff as decimal
     1106   )
     1107   :
     1108     define variable v-day-number as integer   no-undo .
     1109     define variable v-seconds    as integer   no-undo .
     1110     define variable v-hour       as integer   no-undo .
     1111     define variable v-min        as integer   no-undo .
     1112     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     1113     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     1114     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     1115     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1116     if p-mjd-diff < 0
     1117     or p-mjd-diff = ?
     1118     then do:
     1119       return "?" .
     1120     end.
     1121     assign
     1122       v-day-number = integer(truncate(p-mjd-diff,0))
     1123       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1124     .
     1125     if v-seconds > 86400
     1126     then do:
     1127       assign
     1128         v-seconds = 86400 - 1
     1129       .
     1130     end.
     1131     if v-seconds < 0
     1132     then do:
     1133       assign
     1134         v-seconds = 0
     1135       .
     1136     end.
     1137     assign
     1138       v-hour = truncate(v-seconds / 3600, 0)
     1139     .
     1140     assign
     1141       v-seconds = v-seconds modulo 3600
     1142     .
     1143     assign
     1144       v-min = truncate(v-seconds / 60, 0)
     1145     .
     1146     assign
     1147       v-seconds = v-seconds modulo 60
     1148     .
     1149     return
     1150         (if v-day-number <> 0
     1151           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1152           else ""
     1153         )
     1154       + (if v-day-number <> 0 or v-hour <> 0
     1155           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1156           else ""
     1157         )
     1158       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1159           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1160           else ""
     1161         )
     1162       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1163       .
     1164   end.
     1165   function cur-time-string returns character
     1166   :
     1167     define variable v-date as date      no-undo .
     1168     define variable v-time as integer   no-undo .
     1169     run cur-time in this-procedure
     1170       (output v-date
     1171       ,output v-time
     1172       ) .
     1173     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1174   end.
     1175   function cur-time-string-sec returns character
     1176   :
     1177     define variable v-date as date      no-undo .
     1178     define variable v-time as integer   no-undo .
     1179     run cur-time in this-procedure
     1180       (output v-date
     1181       ,output v-time
     1182       ) .
     1183     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1184   end.
     1185   function cur-time-custom  returns character
     1186   (input p-prefix as character
     1187   ,input p-date-format as character
     1188   ,input p-delimiter as character
     1189   ,input p-time-format as character
     1190   ,input p-suffix as character
     1191   )
     1192   :
     1193     define variable v-date as date      no-undo .
     1194     define variable v-time as integer   no-undo .
     1195     run cur-time in this-procedure
     1196       (output v-date
     1197       ,output v-time
     1198       ) .
     1199     return
     1200       p-prefix
     1201       + string(v-date, p-date-format)
     1202       + p-delimiter
     1203       + string(v-time, p-time-format)
     1204       + p-suffix
     1205       .
     1206   end.
     1207   function cur-time-print  returns character
     1208   :
     1209     define variable v-date as date      no-undo .
     1210     define variable v-time as integer   no-undo .
     1211     run cur-time in this-procedure
     1212       (output v-date
     1213       ,output v-time
     1214       ) .
     1215     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1216   end.
     1217   function cur-time-datetime returns datetime
     1218   :
     1219     define variable v-char as character no-undo .
     1220     define variable v-datetime as datetime no-undo .
     1221     v-char = cur-time-string().
     1222     v-datetime = datetime(v-char).
     1223     return  v-datetime.
     1224   end.
     1225   function cur-time-string-msec returns character
     1226   :
     1227     define variable v-date as datetime  no-undo .
     1228     v-date = now.
     1229     return string(v-date) .
     1230   end.
