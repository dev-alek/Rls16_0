       19   define variable vss-revision    as character no-undo init "$Revision: 8f531171ff56, 1872, rls $":U .
       20   define variable vss-author      as character no-undo init "$Author: SSlivenko $":U .
       21   define variable vss-date        as character no-undo init "$Date: Thu May 16 15:50:49 2019 +0300 $":U .
       22   define variable vss-workfile    as character no-undo init "$Workfile: cmdp-dc.p $":U .
