     3323   procedure get-db-list-for-d-card3 :
     3324   define input parameter p-d-card as character no-undo .
     3325   define variable v-current-db-processed as logical no-undo .
     3326   define buffer buf_clients  for ub.clients.
     3327   define buffer buf_dis-obj for ub.dis-obj.
     3328   define buffer buf_temp-smart-route for temp-smart-route.
     3329     do
     3330     on error undo, return error return-value
     3331     :
     3332       for each buf_dis-obj no-lock where
     3333               buf_dis-obj.d-card = p-d-card,
     3334          first buf_clients no-lock where
     3335               buf_clients.obj-type = buf_dis-obj.obj-type
     3336           and buf_clients.obj-code = buf_dis-obj.obj-code
     3337       break by
     3338       buf_clients.db-num:
     3339         if first-of(buf_Clients.db-num) then do:
     3340           find first buf_temp-smart-route no-lock where
     3341                 buf_temp-smart-route.key-field = p-d-card
     3342             and buf_temp-smart-route.db-num = buf_clients.db-num
     3343                 no-error.
     3344           if available buf_temp-smart-route then return.
     3345           create buf_temp-smart-route.
     3346           assign
     3347           buf_temp-smart-route.key-field = p-d-card
     3348           buf_temp-smart-route.db-num = buf_clients.db-num
     3349           .
     3350           if buf_clients.db-num = g#db-num then do:
     3351             v-current-db-processed = yes.
     3352           end.
     3353         end.
     3354       end.
     3355       if not v-current-db-processed then do:
     3356         find first buf_temp-smart-route no-lock where
     3357               buf_temp-smart-route.key-field = p-d-card
     3358           and buf_temp-smart-route.db-num = g#db-num
     3359               no-error.
     3360         if not available buf_temp-smart-route then do:
     3361           create buf_temp-smart-route.
     3362           assign
     3363           buf_temp-smart-route.key-field = p-d-card
     3364           buf_temp-smart-route.db-num = g#db-num
     3365           .
     3366         end.
     3367       end.
     3368     end.
     3369   end procedure.
