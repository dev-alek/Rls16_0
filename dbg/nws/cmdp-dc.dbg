      144   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      145   define   temp-table temp-pers-proc no-undo
      146   field proc-name as character
      147   field vproc-handle as handle
      148   field vparent-handle as handle
      149   field user-name as character
      150   field id as integer
      151   field vpar as character
      152   field rank-to-delete as integer
      153   index pi is unique primary
      154   proc-name
      155   id
      156   index puser
      157   proc-name
      158   user-name
      159   index ppar
      160   proc-name
      161   vpar
