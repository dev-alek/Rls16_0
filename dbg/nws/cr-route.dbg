     3320   def var vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3321   define temp-table temp-drt-prop no-undo like ub.drt-prop.
     3322   procedure disrules-fill-properties:
     3323   define input  parameter p-templ-rl-root as integer   no-undo .
     3324   define buffer buf_drt-prop for ub.drt-prop.
     3325   define buffer buf_temp-drt-prop for temp-drt-prop.
     3326   do
     3327   on error undo, return error return-value
     3328   :
     3329     for each buf_temp-drt-prop:
     3330       delete buf_temp-drt-prop.
     3331     end.
     3332     for each buf_drt-prop where buf_drt-prop.templ-rl-root = p-templ-rl-root:
     3333       create buf_temp-drt-prop.
     3334       buffer-copy buf_drt-prop to buf_temp-drt-prop.
     3335     end.
     3336   end.
     3337   end procedure.
     3338   ~
     3339   PROCEDURE cre-dump-dis-rule:
     3340     define input        parameter p-act-name  as   character no-undo .
     3341     define input        parameter tbl-row     as   rowid                  no-undo.
     3342     define input        parameter dmp-ord     like ub.route-dump.dump-ord no-undo.
     3343     define input-output parameter rc-ord      like ub.route-dump.rec-ord  no-undo.
     3344     do transaction
     3345     on error  undo, return error substitute( "&1 (cre-dump-dis-rule). &2&3&4", vss-include-info4, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     3346     on stop   undo, return error substitute( "&1 (cre-dump-dis-rule). stop", vss-include-info4 )
     3347     on endkey undo, return error substitute( "&1 (cre-dump-dis-rule). endkey", vss-include-info4 )
     3348     :
     3349       define buffer buf_dis-rule     for ub.dis-rule.
     3350       define buffer buf2_dis-rule     for ub.dis-rule.
     3351       find buf_dis-rule where rowid(buf_dis-rule) = tbl-row.
     3352       if buf_dis-rule.rule-num > 99999 then do:
     3353       for each buf2_dis-rule
     3354          where buf2_dis-rule.upper-rule-num = buf_dis-rule.rule-num
     3355       on error undo, return error return-value :
     3356         run cre-route-dump( p-act-name, 'dis-rule':U, (buffer buf2_dis-rule:handle), dmp-ord, input-output rc-ord ).
     3357       end.
     3358     end.
     3359     end.
     3360   END PROCEDURE.
