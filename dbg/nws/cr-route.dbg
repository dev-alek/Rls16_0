     2450             run cre-route-dump( p-act-name, 'chk-pay':U, (buffer buf_chk-pay:handle), dmp-ord, input-output rc-ord ).
     2451           end.
     2452           if p-act-name <> 'send-tbl':U or g#db-num = 0 or not can-do(v-custom-except-list,"c-chk-doc") then
