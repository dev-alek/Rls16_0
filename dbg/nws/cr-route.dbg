     3184            and buf_ord-rcv-attr.rcv-code = buf_ord-doc-rcv.rcv-code
     3185       on error undo, return error substitute( "&1. &2&3&4", vss-include-info4, return-value, chr(10), error-status :get-message ( error-status :num-messages ) ) :
     3186         run cre-route-dump( p-act-name, 'ord-rcv-attr':U, (buffer buf_ord-rcv-attr:handle), dmp-ord, input-output rc-ord ).
