     4253   PROCEDURE cre-dump-rule:
     4254     define input        parameter p-act-name  as   character no-undo .
     4255     define input        parameter tbl-row     as   rowid                  no-undo.
     4256     define input        parameter dmp-ord     like ub.route-dump.dump-ord no-undo.
     4257     define input-output parameter rc-ord      like ub.route-dump.rec-ord  no-undo.
     4258     define input        parameter chk-go-news as   logical                no-undo.
     4259     do transaction
     4260     on error  undo, return error substitute( "&1 (cre-dump-rule). &2&3&4", vss-include-info4, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     4261     on stop   undo, return error substitute( "&1 (cre-dump-rule). stop", vss-include-info4 )
     4262     on endkey undo, return error substitute( "&1 (cre-dump-rule). endkey", vss-include-info4 )
     4263     :
     4264       define buffer buf_rule            for ub.rule.
     4265       define buffer buf_rule-script     for ub.rule-script.
     4266       define buffer buf_rule-i-script   for ub.rule-i-script.
     4267       find buf_rule where rowid(buf_rule) = tbl-row.
     4268       for each  buf_rule-script where buf_rule-script.rule_id = buf_rule.rule_id
     4269       on error undo, return error substitute( "&1. &2&3&4", vss-include-info4, return-value, chr(10), error-status :get-message ( error-status :num-messages ) ) :
     4270         run cre-route-dump( p-act-name, 'rule-script':U, (buffer buf_rule-script:handle), dmp-ord, input-output rc-ord ).
     4271       end.
     4272       for each buf_rule-i-script where
     4273                 buf_rule-i-script.root_rule_id = buf_rule-script.rule_id
     4274         on error undo, return error substitute( "&1. &2&3&4", vss-include-info4, return-value, chr(10), error-status :get-message ( error-status :num-messages ) ) :
     4275           run cre-route-dump( p-act-name, 'rule-i-script':U, (buffer buf_rule-i-script:handle), dmp-ord, input-output rc-ord ).
     4276       end.
     4277     end.
     4278   END PROCEDURE.
     4279   PROCEDURE cre-dump-stop-list:
     4280     define input        parameter p-act-name  as   character no-undo .
     4281     define input        parameter tbl-row     as   rowid                  no-undo.
     4282     define input        parameter dmp-ord     like ub.route-dump.dump-ord no-undo.
     4283     define input-output parameter rc-ord      like ub.route-dump.rec-ord  no-undo.
     4284     do transaction
     4285     on error  undo, return error substitute( "&1 (cre-dump-stop-list). &2&3&4", vss-include-info4, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     4286     on stop   undo, return error substitute( "&1 (cre-dump-stop-list). stop", vss-include-info4 )
     4287     on endkey undo, return error substitute( "&1 (cre-dump-stop-list). endkey", vss-include-info4 )
     4288     :
     4289       define buffer buf_stop-list            for ub.stop-list.
     4290       define buffer buf_stop-list-line       for ub.stop-list-line.
     4291       define buffer buf_c-stop-list          for ub.c-stop-list.
     4292       define buffer buf_c-stop-list-line     for ub.c-stop-list-line.
     4293       find buf_stop-list where rowid(buf_stop-list) = tbl-row.
     4294       for each  buf_stop-list-line where
     4295                buf_stop-list-line.classif-type = buf_stop-list.classif-type
     4296            and buf_stop-list-line.stop-list-code = buf_stop-list.stop-list-code
     4297       on error undo, return error substitute( "&1. &2&3&4", vss-include-info4, return-value, chr(10), error-status :get-message ( error-status :num-messages ) ) :
     4298         run cre-route-dump( p-act-name, 'stop-list-line':U, (buffer buf_stop-list-line:handle), dmp-ord, input-output rc-ord ).
     4299       end.
     4300       if p-act-name <> 'send-tbl':U or g#db-num = 0 or not can-do(v-custom-except-list,"c-stop-list-line") then
     4301       do:
     4302         for each buf_c-stop-list-line where
     4303                  buf_c-stop-list-line.classif-type = buf_stop-list.classif-type
     4304              and buf_c-stop-list-line.stop-list-code = buf_stop-list.stop-list-code
     4305         on error undo, return error substitute( "&1. &2&3&4", vss-include-info4, return-value, chr(10), error-status :get-message ( error-status :num-messages ) ) :
     4306           run cre-route-dump( p-act-name, 'c-stop-list-line':U, (buffer buf_c-stop-list-line:handle), dmp-ord, input-output rc-ord ).
     4307         end.
     4308       end.
     4309       if p-act-name <> 'send-tbl':U or g#db-num = 0 or not can-do(v-custom-except-list,"c-stop-list") then
     4310       do:
     4311         for each  buf_c-stop-list where
     4312                  buf_c-stop-list.classif-type = buf_stop-list.classif-type
     4313              and buf_c-stop-list.stop-list-code = buf_stop-list.stop-list-code
     4314         on error undo, return error substitute( "&1. &2&3&4", vss-include-info4, return-value, chr(10), error-status :get-message ( error-status :num-messages ) ) :
     4315           run cre-route-dump( p-act-name, 'c-stop-list':U, (buffer buf_c-stop-list:handle), dmp-ord, input-output rc-ord ).
     4316         end.
     4317       end.
     4318     end.
     4319   END PROCEDURE.
