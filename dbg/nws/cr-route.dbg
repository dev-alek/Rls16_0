     3172                                       and buf_ord-doc.doc-type <> 'ОР':U
     3173       on error undo, return error substitute( "&1. &2&3&4", vss-include-info4, return-value, chr(10), error-status :get-message ( error-status :num-messages ) ) :
     3174         run cre-route-dump( p-act-name, 'ord-doc-attr':U, (buffer buf_ord-doc-attr:handle), dmp-ord, input-output rc-ord ).
     3175       end.
     3176       for each buf_ord-rcv-line-attr
     3177          where buf_ord-rcv-line-attr.doc-code = buf_ord-doc-rcv.doc-code
     3178            and buf_ord-rcv-line-attr.rcv-code = buf_ord-doc-rcv.rcv-code
