     4416       define buffer buf_utd-marking-lines for ub.utd-marking-lines.
     4417       define buffer buf_utd-marking-lines-attr for ub.utd-marking-lines-attr.
     4418       define buffer buf_utd-err for ub.utd-err.
     4419       define buffer buf_utd-err-attr for ub.utd-err-attr.
     4420       define buffer buf_marking for ub.marking.
     4421       define buffer buf_marking-attr for ub.marking-attr.
     4422       find buf_utd where rowid(buf_utd) = tbl-row.
     4423       for each buf_utd-attr where buf_utd-attr.db-num = buf_utd.db-num and buf_utd-attr.doc-id = buf_utd.doc-id
     4424       on error undo, return error substitute( "&1. &2&3&4", vss-include-info4, return-value, chr(10), error-status :get-message ( error-status :num-messages ) ) :
     4425         run cre-route-dump( p-act-name, 'utd-attr':U, (buffer buf_utd-attr:handle), dmp-ord, input-output rc-ord ).
     4426       end.
     4427       for each buf_utd-lines where buf_utd-lines.db-num = buf_utd.db-num and buf_utd-lines.doc-id = buf_utd.doc-id
     4428       on error undo, return error substitute( "&1. &2&3&4", vss-include-info4, return-value, chr(10), error-status :get-message ( error-status :num-messages ) ) :
     4429         run cre-route-dump( p-act-name, 'utd-lines':U, (buffer buf_utd-lines:handle), dmp-ord, input-output rc-ord ).
     4430       end.
     4431       for each buf_utd-lines-attr where buf_utd-lines-attr.db-num = buf_utd.db-num and buf_utd-lines-attr.doc-id = buf_utd.doc-id
     4432       on error undo, return error substitute( "&1. &2&3&4", vss-include-info4, return-value, chr(10), error-status :get-message ( error-status :num-messages ) ) :
     4433         run cre-route-dump( p-act-name, 'utd-lines-attr':U, (buffer buf_utd-lines-attr:handle), dmp-ord, input-output rc-ord ).
     4434       end.
     4435       for each buf_utd-marking-lines where buf_utd-marking-lines.db-num = buf_utd.db-num and buf_utd-marking-lines.doc-id = buf_utd.doc-id
     4436       on error undo, return error substitute( "&1. &2&3&4", vss-include-info4, return-value, chr(10), error-status :get-message ( error-status :num-messages ) ) :
     4437         run cre-route-dump( p-act-name, 'utd-marking-lines':U, (buffer buf_utd-marking-lines:handle), dmp-ord, input-output rc-ord ).
     4438         for first buf_marking where buf_marking.mark = buf_utd-marking-lines.mark
     4439         on error undo, return error substitute( "&1. &2&3&4", vss-include-info4, return-value, chr(10), error-status :get-message ( error-status :num-messages ) ) :
     4440           run cre-route-dump( p-act-name, 'marking':U, (buffer buf_marking:handle), dmp-ord, input-output rc-ord ).
     4441           for each buf_marking-attr where buf_marking-attr.mark = buf_marking.mark
     4442           on error undo, return error substitute( "&1. &2&3&4", vss-include-info4, return-value, chr(10), error-status :get-message ( error-status :num-messages ) ) :
     4443             run cre-route-dump( p-act-name, 'marking-attr':U, (buffer buf_marking-attr:handle), dmp-ord, input-output rc-ord ).
     4444           end.
     4445         end.
     4446       end.
     4447       for each buf_utd-marking-lines-attr where buf_utd-marking-lines-attr.db-num = buf_utd.db-num and buf_utd-marking-lines-attr.doc-id = buf_utd.doc-id
     4448       on error undo, return error substitute( "&1. &2&3&4", vss-include-info4, return-value, chr(10), error-status :get-message ( error-status :num-messages ) ) :
     4449         run cre-route-dump( p-act-name, 'utd-marking-lines-attr':U, (buffer buf_utd-marking-lines-attr:handle), dmp-ord, input-output rc-ord ).
     4450       end.
     4451       for each buf_utd-err where buf_utd-err.db-num = buf_utd.db-num and buf_utd-err.doc-id = buf_utd.doc-id
     4452       on error undo, return error substitute( "&1. &2&3&4", vss-include-info4, return-value, chr(10), error-status :get-message ( error-status :num-messages ) ) :
     4453         run cre-route-dump( p-act-name, 'utd-err':U, (buffer buf_utd-err:handle), dmp-ord, input-output rc-ord ).
     4454       end.
     4455       for each buf_utd-err-attr where buf_utd-err-attr.db-num = buf_utd.db-num and buf_utd-err-attr.doc-id = buf_utd.doc-id
     4456       on error undo, return error substitute( "&1. &2&3&4", vss-include-info4, return-value, chr(10), error-status :get-message ( error-status :num-messages ) ) :
     4457         run cre-route-dump( p-act-name, 'utd-err-attr':U, (buffer buf_utd-err-attr:handle), dmp-ord, input-output rc-ord ).
     4458       end.
     4459     end.
     4460   END PROCEDURE.
     4461   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4462   procedure cur-time :
     4463      define output parameter p-today as date      no-undo .
     4464      define output parameter p-time  as integer   no-undo .
     4465     do
     4466     on error undo, return error
     4467     :
     4468       define variable v-date1 as date      no-undo .
     4469       define variable v-date2 as date      no-undo .
     4470       define variable v-time  as integer   no-undo .
     4471       assign
     4472         v-date1 = today
     4473         v-time  = time
     4474         v-date2 = today
     4475       .
     4476       if v-date1 <> v-date2
     4477       then do:
     4478         assign
     4479           v-date1 = today
     4480           v-time  = v-time
     4481         .
     4482       end.
     4483       assign
     4484         p-today = v-date1
     4485         p-time  = v-time
     4486       .
     4487     end.
     4488   end.
     4489   function cur-time-date returns character
     4490   :
     4491     return string(today, '99/99/9999':U) .
     4492   end.
     4493   function cur-time-mjd returns decimal
     4494   :
     4495     define variable v-date as date      no-undo .
     4496     define variable v-time as integer   no-undo .
     4497     run cur-time in this-procedure
     4498       (output v-date
     4499       ,output v-time
     4500       ) .
     4501     return integer(v-date) - 2400002 + (v-time / 86400) .
     4502   end.
     4503   function cur-time-get-ending-index returns integer
     4504   (input p-number as integer
     4505   )
     4506   :
     4507     if p-number < 0
     4508     or p-number = ?
     4509     then do:
     4510       return 1 .
     4511     end.
     4512     define variable v-rest as integer   no-undo .
     4513     assign
     4514       p-number = p-number modulo 100
     4515     .
     4516     if p-number < 20
     4517     then do:
     4518       assign
     4519         v-rest = p-number
     4520       .
     4521     end.
     4522     else do:
     4523       assign
     4524         v-rest = p-number modulo 10
     4525       .
     4526     end.
     4527     case v-rest :
     4528       when 1
     4529       then do:
     4530         return 2 .
     4531       end.
     4532       when 2 or
     4533       when 3 or
     4534       when 4
     4535       then do:
     4536         return 3 .
     4537       end.
     4538       otherwise do:
     4539         return 1 .
     4540       end.
     4541     end case .
     4542   end.
     4543   procedure cur-time-mjd-to-date :
     4544      define input  parameter i-mjd-diff as decimal no-undo.
     4545      define output parameter o-Date     as date    no-undo.
     4546      define output parameter o-Time     as integer no-undo.
     4547      define variable v-day-number as integer   no-undo .
     4548      if    i-mjd-diff < 0
     4549         or i-mjd-diff = ?
     4550      then do:
     4551         return "?" .
     4552      end.
     4553      assign
     4554         v-day-number = truncate(i-mjd-diff,0).
     4555         o-Date = date(v-day-number + 2400002).
     4556         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     4557     .
     4558   end.
     4559   function cur-time-mjd-to-string returns character
     4560   (input p-mjd-diff as decimal
     4561   )
     4562   :
     4563     define variable v-day-number as integer   no-undo .
     4564     define variable v-seconds    as integer   no-undo .
     4565     define variable v-hour       as integer   no-undo .
     4566     define variable v-min        as integer   no-undo .
     4567     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     4568     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     4569     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     4570     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     4571     if p-mjd-diff < 0
     4572     or p-mjd-diff = ?
     4573     then do:
     4574       return "?" .
     4575     end.
     4576     assign
     4577       v-day-number = integer(truncate(p-mjd-diff,0))
     4578       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     4579     .
     4580     if v-seconds > 86400
     4581     then do:
     4582       assign
     4583         v-seconds = 86400 - 1
     4584       .
     4585     end.
     4586     if v-seconds < 0
     4587     then do:
     4588       assign
     4589         v-seconds = 0
     4590       .
     4591     end.
     4592     assign
     4593       v-hour = truncate(v-seconds / 3600, 0)
     4594     .
     4595     assign
     4596       v-seconds = v-seconds modulo 3600
     4597     .
     4598     assign
     4599       v-min = truncate(v-seconds / 60, 0)
     4600     .
     4601     assign
     4602       v-seconds = v-seconds modulo 60
     4603     .
     4604     return
     4605         (if v-day-number <> 0
     4606           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     4607           else ""
     4608         )
     4609       + (if v-day-number <> 0 or v-hour <> 0
     4610           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     4611           else ""
     4612         )
     4613       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     4614           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     4615           else ""
     4616         )
     4617       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     4618       .
     4619   end.
     4620   function cur-time-string returns character
     4621   :
     4622     define variable v-date as date      no-undo .
     4623     define variable v-time as integer   no-undo .
     4624     run cur-time in this-procedure
     4625       (output v-date
     4626       ,output v-time
     4627       ) .
     4628     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     4629   end.
     4630   function cur-time-string-sec returns character
     4631   :
     4632     define variable v-date as date      no-undo .
     4633     define variable v-time as integer   no-undo .
     4634     run cur-time in this-procedure
     4635       (output v-date
     4636       ,output v-time
     4637       ) .
     4638     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     4639   end.
     4640   function cur-time-custom  returns character
     4641   (input p-prefix as character
     4642   ,input p-date-format as character
     4643   ,input p-delimiter as character
     4644   ,input p-time-format as character
     4645   ,input p-suffix as character
     4646   )
     4647   :
     4648     define variable v-date as date      no-undo .
     4649     define variable v-time as integer   no-undo .
     4650     run cur-time in this-procedure
     4651       (output v-date
     4652       ,output v-time
     4653       ) .
     4654     return
     4655       p-prefix
     4656       + string(v-date, p-date-format)
     4657       + p-delimiter
     4658       + string(v-time, p-time-format)
     4659       + p-suffix
     4660       .
     4661   end.
     4662   function cur-time-print  returns character
     4663   :
     4664     define variable v-date as date      no-undo .
     4665     define variable v-time as integer   no-undo .
     4666     run cur-time in this-procedure
     4667       (output v-date
     4668       ,output v-time
     4669       ) .
     4670     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     4671   end.
     4672   function cur-time-datetime returns datetime
     4673   :
     4674     define variable v-char as character no-undo .
     4675     define variable v-datetime as datetime no-undo .
     4676     v-char = cur-time-string().
     4677     v-datetime = datetime(v-char).
     4678     return  v-datetime.
     4679   end.
     4680   function cur-time-string-msec returns character
     4681   :
     4682     define variable v-date as datetime  no-undo .
     4683     v-date = now.
     4684     return string(v-date) .
     4685   end.
     4686   block_cre-route:
     4687   do
     4688   on error  undo block_cre-route, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     4689   on stop   undo block_cre-route, return error substitute( "&1. stop", vss-workfile )
     4690   on endkey undo block_cre-route, return error substitute( "&1. endkey", vss-workfile )
     4691   :
     4692     define variable v-tbl-row      as rowid               no-undo.
     4693     define variable v-dmp-ord      like ub.route.dump-ord no-undo .
     4694     define variable v-rc-ord       as integer             no-undo .
     4695     define variable v-ind          as integer             no-undo .
     4696     define variable v-loc-key-rec  as character           no-undo .
     4697     define variable v-send-checks  as logical             no-undo .
     4698     define variable v-param-checks as logical             no-undo .
     4699     define variable v-bush-rec     as logical             no-undo .
     4700     define variable v-cre-time     as integer             no-undo .
     4701     define variable v-cre-date     as date                no-undo .
     4702     define variable v-cre-user     as character           no-undo .
     4703     define variable v-act-name     as character           no-undo.
     4704     define variable v-esr-act-name as character           no-undo.
     4705     define variable v-send-list    as character no-undo .
     4706     define variable v-rt-count     as integer   no-undo .
     4707     define buffer buf_sys-ctrl for ub.sys-ctrl .
     4708     define buffer buf_db       for ub.db .
     4709     if p-act-name = 'send-tbl':U
     4710     or p-act-name = 'send-cmd':U
     4711     then do:
     4712       assign
     4713           v-act-name = p-act-name
     4714       .
     4715     end.
     4716     else do:
     4717       if num-entries( p-act-name ) < 2
     4718       then do:
     4719         message
     4720           vss-workfile vss-revision vss-description skip
     4721           "Ошибка задания входных параметров" skip
     4722           "Передано неверное действие OXML"   skip
     4723           "Действие"         p-act-name        skip
     4724           "Таблица"          p-tbl-name        skip
     4725           "Список рассылки"  p-send-list       skip
     4726           view-as alert-box error .
     4727         undo block_cre-route, return error return-value .
     4728       end.
     4729       else do:
     4730           assign
     4731               v-act-name      = entry( 1, p-act-name )
     4732               v-esr-act-name  = entry( 2, p-act-name )
     4733           .
     4734           if v-esr-act-name <> 'update':U
     4735           and v-esr-act-name <> 'delete':U
     4736           then do:
     4737               message
     4738                   vss-workfile vss-revision vss-description skip
     4739                   "Ошибка задания входных параметров" skip
     4740                   "Передано неверное действие OXML"   skip
     4741                   "Действие"         p-act-name        skip
     4742                   "Таблица"          p-tbl-name        skip
     4743                   "Список рассылки"  p-send-list       skip
     4744                   view-as alert-box error .
     4745               undo block_cre-route, return error return-value .
     4746           end.
     4747       end.
     4748     end.
     4749     if v-act-name = 'send-tbl':U
     4750       or v-act-name = 'send-tbl-oxml':U
     4751     then do:
     4752       if not p-tbl-handle:available then do:
     4753         message
     4754           vss-workfile vss-revision vss-description skip
     4755           "Ошибка задания входных параметров" skip
     4756           "Передана ссылка на не доступный буффер" skip
     4757           "Действие"         p-act-name        skip
     4758           "Таблица"          p-tbl-name        skip
     4759           "Список рассылки"  p-send-list       skip
     4760           view-as alert-box error .
     4761         undo block_cre-route, return error return-value .
     4762       end.
     4763       else do:
     4764         assign
     4765           v-tbl-row       = p-tbl-handle :rowid
     4766         .
     4767       end.
     4768     end.
     4769     if v-act-name <> 'send-tbl':U
     4770       and v-act-name <> 'send-cmd':U
     4771       and v-act-name <> 'send-tbl-oxml':U
     4772     then do:
     4773       message
     4774         vss-workfile vss-revision vss-description skip
     4775         "Ошибка задания входных параметров" skip
     4776         "Неизвестное значение параметра Действие" skip
     4777         "Действие"         p-act-name        skip
     4778         "Таблица"          p-tbl-name        skip
     4779         "Код записи"       string(v-tbl-row) skip
     4780         "Список рассылки"  p-send-list       skip
     4781         view-as alert-box error .
     4782       undo block_cre-route, return error return-value .
     4783     end.
     4784     if p-tbl-name = ?
     4785     or p-tbl-name = "":U
     4786     then do:
     4787       message
     4788         vss-workfile vss-revision vss-description skip
     4789         "Ошибка задания входных параметров" skip
     4790         "Не задан параметр таблица" skip
     4791         "Действие"         p-act-name        skip
     4792         "Таблица"          p-tbl-name        skip
     4793         "Код записи"       string(v-tbl-row) skip
     4794         "Список рассылки"  p-send-list       skip
     4795         view-as alert-box error .
     4796       undo block_cre-route, return error return-value .
     4797     end.
     4798     if trim( p-send-list ) = "":U
     4799       or p-send-list = ?
     4800     then do:
     4801       if v-act-name = 'send-tbl-oxml':U
     4802         or v-act-name = 'send-cmd-oxml':U
     4803       then do:
     4804         message
     4805           vss-workfile vss-revision vss-description skip
     4806           "Ошибка задания входных параметров" skip
     4807           "Не задан список рассылки" skip
     4808           "Действие"         p-act-name        skip
     4809           "Таблица"          p-tbl-name        skip
     4810           "Код записи"       string(v-tbl-row) skip
     4811           "Список рассылки"  p-send-list       skip
     4812           view-as alert-box error .
     4813         undo block_cre-route, return error return-value .
     4814       end.
     4815       else do:
     4816         assign
     4817           v-send-list = "":U
     4818         .
     4819         find first buf_sys-ctrl no-lock .
     4820         if buf_sys-ctrl.db-num = 0 then do:
     4821           for each buf_db no-lock
     4822             where buf_db.db-num > 0
     4823               and buf_db.db-num <> g#news-source-db
     4824         on error undo block_cre-route, return error
     4825           :
     4826             assign
     4827               v-send-list = v-send-list + chr(1) + string( buf_db.db-num )
     4828             .
     4829           end.
     4830           assign
     4831             v-send-list = left-trim( v-send-list, chr(1) )
     4832           .
     4833         end.
     4834         else do:
     4835           assign
     4836             v-send-list = "0":U
     4837           .
     4838         end.
     4839       end.
     4840     end.
     4841     else do:
     4842       assign
     4843         v-send-list = p-send-list
     4844       .
     4845     end.
     4846     if v-act-name = 'send-tbl':U
     4847       or v-act-name = 'send-cmd':U
     4848     then do:
     4849       assign
     4850         v-send-checks = false
     4851       .
     4852       if g#db-num = 0 then do:
     4853         do v-ind = 1 to num-entries( v-send-list, chr(1) )
     4854         on error  undo block_cre-route, return error substitute( "&1. (send-checks) &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     4855         on stop   undo block_cre-route, return error substitute( "&1. (send-checks) stop", vss-workfile )
     4856         on endkey undo block_cre-route, return error substitute( "&1. (send-checks) endkey", vss-workfile )
     4857         :
     4858           find buf_db no-lock
     4859             where buf_db.db-num = integer( entry( v-ind, v-send-list, chr(1) ) )
     4860           .
     4861           if buf_db.send-check = true then do:
     4862             assign
     4863               v-send-checks = buf_db.send-check
     4864             .
     4865           end.
     4866         end.
     4867       end.
     4868       else do:
     4869         find buf_db no-lock
     4870           where buf_db.db-num = g#db-num
     4871         .
     4872         assign
     4873           v-send-checks = buf_db.send-check
     4874         .
     4875       end.
     4876     end.
     4877     else do:
     4878       assign
     4879         v-send-checks = true
     4880       .
     4881     end.
     4882     assign
     4883       v-dmp-ord = next-value( s-news-dord, ub )
     4884     .
     4885     case p-act-name :
     4886       when 'send-tbl':U
     4887       or when substitute( "&1,&2", 'send-tbl-oxml':U, 'update':U )
     4888       then do:
     4889         assign
     4890           v-rc-ord  = -1
     4891         .
     4892         RUN gen-key-rec in this-procedure
     4893           ( input p-tbl-name
     4894            ,input p-tbl-handle
     4895            ,output v-loc-key-rec
     4896           ) no-error.
     4897         if error-status :error then do:
     4898           undo  block_cre-route, return error substitute( "&1. Ошибка при генерации уникального ключа. &2. Имя таблицы &3. Код таблицы &4.", vss-workfile, return-value, p-tbl-name, string(v-tbl-row) ).
     4899         end.
     4900         if v-loc-key-rec = ?
     4901           or v-loc-key-rec = ""
     4902         then do:
     4903           undo  block_cre-route, return error substitute( "&1. Уникальный ключ имеет неопределенное значение. Имя таблицы &2. Код таблицы &3.", vss-workfile, p-tbl-name, string(v-tbl-row) ).
     4904         end.
     4905         case p-tbl-name:
     4906           when 'c-trn-doc':U
     4907           or when 'add-doc':U
     4908           or when 'price-doc':U
     4909           or when 'c-price-doc':U
     4910           or when 'contract':U
     4911           or when 'contract-specif':U
     4912           or when 'c-contract':U
     4913           or when 'fbr-doc':U
     4914           or when 'fbr-pln':U
     4915           or when 'recipe':U
     4916           or when 'c-fbr-doc':U
     4917           or when 'c-recipe':U
     4918           or when 'c-fbr-pln':U
     4919           or when 'rvs-doc':U
     4920           or when 'c-rvs-doc':U
     4921           or when 'icnt-doc':U
     4922           or when 'ord-doc':U
     4923           or when 'ord-doc-rcv':U
     4924           or when 'ord-cons':U
     4925           or when 'goods':U
     4926           or when 'shift-obj':U
     4927           or when 'c-shift-obj':U
     4928           or when 'fin-ob':U
     4929           or when 'c-fin-ob':U
     4930           or when 'fin-ob-before':U
     4931           or when 'fin-doc':U
     4932           or when 'c-fin-doc':U
     4933           or when 'dis-rule':U
     4934           or when 'dis-time-rule':U
     4935           or when 'abc-analysis':U
     4936           or when 'abcxyz-analysis':U
     4937           or when 'xyz-analysis':U
     4938           or when 'rang-abc-def':U
     4939           or when 'rang-xyz-def':U
     4940           or when 'doc-abc-def':U
     4941           or when 'doc-xyz-def':U
     4942           or when 'fin-statement':U
     4943           or when 'c-fin-statement':U
     4944           or when 'schet-fact-doc':U
     4945           or when 'c-schet-fact-doc':U
     4946           or when 'factur-connect':U
     4947           or when 'global-state':U
     4948           or when 'sum-group':U
     4949           or when 'qnty-group':U
     4950           or when 'turnover-group':U
     4951           or when 'buyer-group':U
     4952           or when 'buyer-in-buyer-group':U
     4953           or when 'grp-obj-price':U
     4954           or when 'turnover-buyer-main':U
     4955           or when 'price-list-type':U
     4956           or when 'price-doc-forming':U
     4957           or when 'c-price-list-type':U
     4958           or when 'c-price-doc-forming':U
     4959           or when 'stop-list':U
     4960           or when 'esys-route':U
     4961           or when 'layout':U
     4962           or when 'utd':U
     4963           then do:
     4964             assign
     4965               v-bush-rec     = true
     4966               v-param-checks = false
     4967             .
     4968           end.
     4969           when 'trn-doc':U
     4970           or when 'wth-doc':U
     4971           or when 'c-wth-doc':U
     4972           or when 'inkas':U
     4973           or when 'c-inkas':U
     4974           or when 'c-chk-doc':U
     4975           then do:
     4976             assign
     4977               v-bush-rec     = true
     4978               v-param-checks = true
     4979             .
     4980           end.
     4981           otherwise do:
     4982             assign
     4983               v-bush-rec     = false
     4984               v-param-checks = false
     4985             .
     4986           end.
     4987         end case.
     4988         run cre-route-dump in this-procedure
     4989           ( input v-act-name
     4990            ,input p-tbl-name
     4991            ,input p-tbl-handle
     4992            ,input v-dmp-ord
     4993            ,input-output v-rc-ord
     4994           ).
     4995         if v-bush-rec = true then do:
     4996           if v-param-checks = true then do:
     4997             run value("cre-dump-":U + p-tbl-name) in this-procedure
     4998               ( input v-act-name
     4999                ,input v-tbl-row
     5000                ,input v-dmp-ord
     5001                ,input-output v-rc-ord
     5002                ,input v-send-checks
     5003               ).
     5004           end.
     5005           else do:
     5006             run value("cre-dump-":U + p-tbl-name) in this-procedure
     5007               ( input v-act-name
     5008                ,input v-tbl-row
     5009                ,input v-dmp-ord
     5010                ,input-output v-rc-ord
     5011               ).
     5012           end.
     5013         end.
     5014       end.
     5015       when substitute( "&1,&2", 'send-tbl-oxml':U, 'delete':U )
     5016       then do:
     5017         assign
     5018           v-rc-ord  = -1
     5019         .
     5020         RUN gen-key-rec in this-procedure
     5021           ( input p-tbl-name
     5022            ,input p-tbl-handle
     5023            ,output v-loc-key-rec
     5024           ) no-error.
     5025         if error-status :error then do:
     5026           undo  block_cre-route, return error substitute( "&1. Ошибка при генерации уникального ключа. &2. Имя таблицы &3. Код таблицы &4.", vss-workfile, return-value, p-tbl-name, string(v-tbl-row) ).
     5027         end.
     5028         if v-loc-key-rec = ?
     5029           or v-loc-key-rec = ""
     5030         then do:
     5031           undo  block_cre-route, return error substitute( "&1. Уникальный ключ имеет неопределенное значение. Имя таблицы &2. Код таблицы &3.", vss-workfile, p-tbl-name, string(v-tbl-row) ).
     5032         end.
     5033         run cre-route-dump in this-procedure
     5034            ( input v-act-name
     5035             ,input p-tbl-name
     5036             ,input p-tbl-handle
     5037             ,input v-dmp-ord
     5038             ,input-output v-rc-ord
     5039            ).
     5040       end.
     5041       when 'send-cmd':U
     5042       then do:
     5043         assign
     5044           v-rc-ord  = 0
     5045           v-loc-key-rec = "":U
     5046         .
     5047       end.
     5048     end case.
     5049     run cur-time in this-procedure
     5050       ( output v-cre-date
     5051        ,output v-cre-time
     5052       ) no-error.
     5053     if error-status :error then do:
     5054       undo block_cre-route, return error substitute( "&1. Ошибка при определении текущего времени", vss-workfile ) .
     5055     end.
     5056     if g#news then do:
     5057       assign
     5058         v-cre-user = substitute( "News (&1)":U, g#userid )
     5059       .
     5060       if g#news-source-db > 0 then do:
     5061         assign
     5062           v-cre-user = substitute( "&1 from BD &2":U, v-cre-user, g#news-source-db )
     5063         .
     5064       end.
     5065     end.
     5066     else do:
     5067       assign
     5068         v-cre-user = g#userid
     5069       .
     5070     end.
     5071     if v-act-name = 'send-tbl':U
     5072       or v-act-name = 'send-cmd':U
     5073     then do:
     5074       assign
     5075         v-rt-count = 0
     5076       .
     5077       do v-ind = 1 to num-entries( v-send-list, chr(1) )
     5078       on error  undo block_cre-route, return error substitute( "&1. (cr-rt) &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     5079       on stop   undo block_cre-route, return error substitute( "&1. (cr-rt) stop", vss-workfile )
     5080       on endkey undo block_cre-route, return error substitute( "&1. (cr-rt) endkey", vss-workfile )
     5081       :
     5082   def var vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5083   define buffer buf8_db    for ub.db .
     5084   define buffer buf8_route for ub.route .
     5085   define variable v-msg#8    as character no-undo .
     5086   define variable v-lock#8   as logical   no-undo .
     5087   define variable v-ok#8     as logical   no-undo .
     5088   find first buf8_db no-lock
     5089     where buf8_db.db-num = integer(entry(v-ind,v-send-list,chr(1)))
     5090     no-error
     5091   .
     5092   if not available buf8_db then do:
     5093     message
     5094       vss-include-info8 skip
     5095       vss-workfile vss-revision vss-description skip
     5096       substitute( "Попытка создать маршрутизацию на несуществующую БД &1", integer(entry(v-ind,v-send-list,chr(1))) ) skip
     5097       return-value skip
     5098       error-status :get-message ( error-status :num-messages )
     5099       view-as alert-box error
     5100     .
     5101   end.
     5102   if "ub":U <> "ub":U
     5103      or ( trim( buf8_db.db-key ) <> "":U
     5104           and buf8_db.db-key <> ?
     5105         )
     5106   then do:
     5107     create buf8_route .
     5108     assign
     5109       buf8_route.last-pack    = -1
     5110       buf8_route.name-rec     = p-tbl-name
     5111       buf8_route.db-num       = integer(entry(v-ind,v-send-list,chr(1)))
     5112       buf8_route.uniq-key-rec = v-loc-key-rec
     5113       buf8_route.num-dump     = v-rc-ord
     5114       buf8_route.tbl-ord      = dynamic-next-value( "s-news-ord":U, "ub":U )
     5115       .
     5116       assign
     5117         buf8_route.dump-ord = v-dmp-ord
     5118       .
     5119       assign
     5120         buf8_route.CreDate      = v-cre-date
     5121       .
     5122       assign
     5123         buf8_route.CreTimeInt   = v-cre-time
     5124         buf8_route.CreTime      = string(v-cre-time,"HH:MM:SS":U)
     5125       .
     5126       assign
     5127         buf8_route.CreUserName  = v-cre-user
     5128       .
     5129       assign
     5130         v-rt-count = v-rt-count + 1
     5131       .
     5132   end.
     5133   else do:
     5134   define variable vss-include-info9 as character format "X(65)":U no-undo initial "@(#)$Workfile$ $Revision$".
     5135   if (valid-handle(g#lib-nws) <> true) then do:   run nws/lib-nws.p persistent no-error .   if error-status :error or (valid-handle(g#lib-nws) <> true) then do:     message       "Error starting nws/lib-nws.p" skip       g#lib-nws skip       g#lib-nws :type skip       g#lib-nws :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-nws_lock-route in g#lib-nws
     5136     ( input  'check'
     5137     , input  integer(entry(v-ind,v-send-list,chr(1)))
     5138     , input  0
     5139     , input  ''
     5140     , output v-msg#8
     5141     , output v-lock#8
     5142     , output v-ok#8
     5143     ) no-error .
     5144     if error-status :error
     5145       or v-lock#8 = true
     5146       or v-ok#8   = false
     5147     then do:
     5148       return error substitute( "&1. Маршрутизация записи &2.&3Ключ записи: &4&3&3"
     5149                                ,vss-include-info8
     5150                                ,p-tbl-name
     5151                                ,chr(10)
     5152                                ,v-loc-key-rec
     5153                              )
     5154                   + substitute( "&1&2&2&3&2&2&4"
     5155                                 ,v-msg#8
     5156                                 ,chr(10)
     5157                                 ,return-value
     5158                                 ,error-status :get-message( error-status :num-messages )
     5159                               ) .
     5160     end.
     5161   end.
     5162       end.
     5163       if v-rt-count = 0 then do:
     5164         do v-ind = 1 to num-entries( v-send-list, chr(1) )
     5165         on error  undo block_cre-route, return error substitute( "&1. (check-db-list) &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     5166         on stop   undo block_cre-route, return error substitute( "&1. (check-db-list) stop", vss-workfile )
     5167         on endkey undo block_cre-route, return error substitute( "&1. (check-db-list) endkey", vss-workfile )
     5168         :
     5169           find buf_db no-lock
     5170             where buf_db.db-num = integer( entry( v-ind, v-send-list, chr(1) ) )
     5171           .
     5172           if buf_db.db-key <> ?
     5173             and buf_db.db-key <> "":U
     5174           then do:
     5175             undo block_cre-route, return error substitute( "&1. Есть список БД для отправки, но ни одна запись не маршрутизировалась!!!", vss-workfile ) .
     5176           end.
     5177         end.
     5178         undo block_cre-route, return .
     5179       end.
     5180     end.
     5181     if v-act-name = 'send-tbl-oxml':U then do:
     5182       do v-ind = 1 to num-entries( v-send-list, chr(1) )
     5183       on error  undo block_cre-route, return error substitute( "&1. (cr-rto) &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     5184       on stop   undo block_cre-route, return error substitute( "&1. (cr-rto) stop", vss-workfile )
     5185       on endkey undo block_cre-route, return error substitute( "&1. (cr-rto) endkey", vss-workfile )
     5186       :
     5187   def var vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5188   define variable v-msg#10         as character no-undo .
     5189   define variable v-lock#10        as logical   no-undo .
     5190   define variable v-ok#10          as logical   no-undo .
     5191   define variable v-cur-db-num#10  as integer      no-undo.
     5192   define buffer buf10_ext-system for ub.ext-system .
     5193   find first buf10_ext-system no-lock
     5194     where buf10_ext-system.esys-id = integer(entry(v-ind,v-send-list,chr(1)))
     5195       and buf10_ext-system.db-num = g#db-num
     5196     no-error
     5197   .
     5198   if not available buf10_ext-system then do:
     5199     message
     5200       vss-include-info10 skip
     5201       vss-workfile vss-revision vss-description skip
     5202       substitute( "Попытка создать маршрутизацию на несуществующую внешнюю систему &1 для БД &2", integer(entry(v-ind,v-send-list,chr(1))), g#db-num ) skip
     5203       return-value skip
     5204       error-status :get-message ( error-status :num-messages )
     5205       view-as alert-box error
     5206     .
     5207   end.
     5208   if g#db-num <> buf10_ext-system.esys-db-num-exp and buf10_ext-system.esys-db-num-exp <> 0 then do:
     5209     message
     5210       vss-include-info10 skip
     5211       vss-workfile vss-revision vss-description skip
     5212       substitute( "Попытка создать маршрутизацию на ВС &1 для БД &2,&3" +
     5213                   "в БД &4,&3" +
     5214                   "как БД экспорта указана БД &5"
     5215                   , integer(entry(v-ind,v-send-list,chr(1)))
     5216                   , g#db-num
     5217                   , chr(10)
     5218                   , g#db-num
     5219                   , buf10_ext-system.esys-db-num-exp
     5220                   ) skip
     5221       return-value skip
     5222       error-status :get-message ( error-status :num-messages )
     5223       view-as alert-box error
     5224     .
     5225   end.
     5226     create ub.esys-route .
     5227     assign
     5228       ub.esys-route.esr-name-rec     = p-tbl-name
     5229         ub.esys-route.esr-tbl-ord = next-value( s-news-ord, ub )
     5230       ub.esys-route.esr-last-pack    = -1
     5231       ub.esys-route.esys-id          = integer(entry(v-ind,v-send-list,chr(1)))
     5232       ub.esys-route.db-num           = g#db-num
     5233       ub.esys-route.esr-status       = 0
     5234       ub.esys-route.esr-cr-db-num    = g#db-num
     5235       ub.esys-route.esr-dump-ord     = v-dmp-ord
     5236       ub.esys-route.esr-uniq-key-rec = v-loc-key-rec
     5237       ub.esys-route.uniq-gate-rec    = ''
     5238       ub.esys-route.esr-num-dump     = v-rc-ord
     5239       ub.esys-route.esr-action       = v-esr-act-name
     5240       ub.esys-route.esr-oper         = ''
     5241       .
     5242       assign
     5243         ub.esys-route.esr-CreDate      = v-cre-date
     5244       .
     5245       assign
     5246         ub.esys-route.esr-CreTimeInt   = v-cre-time
     5247         ub.esys-route.esr-CreTime      = string(v-cre-time,"HH:MM:SS":U)
     5248       .
     5249       assign
     5250         ub.esys-route.esr-CreUserName  = v-cre-user
     5251       .
     5252       end.
