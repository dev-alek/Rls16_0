     2256   PROCEDURE cre-dump-rvs-doc :
     2257     define input        parameter p-act-name   as character no-undo .
     2258     define input        parameter tbl-row      as   rowid                  no-undo.
     2259     define input        parameter dmp-ord      like ub.route-dump.dump-ord no-undo.
     2260     define input-output parameter rc-ord       like ub.route-dump.rec-ord  no-undo.
     2261     do transaction
     2262     on error  undo, return error substitute( "&1 (cre-dump-rvs-doc). &2&3&4", vss-include-info4, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2263     on stop   undo, return error substitute( "&1 (cre-dump-rvs-doc). stop", vss-include-info4 )
     2264     on endkey undo, return error substitute( "&1 (cre-dump-rvs-doc). endkey", vss-include-info4 )
     2265     :
     2266       define buffer buf_rvs-doc       for ub.rvs-doc.
     2267       define buffer buf_rvs-line      for ub.rvs-line.
     2268       define buffer buf_rvs-line-attr for ub.rvs-line-attr.
     2269       define buffer buf_rvs-line-pump for ub.rvs-line-pump.
     2270       define buffer buf_rvs-pump      for ub.rvs-pump.
     2271       define buffer buf_doc-attr      for ub.doc-attr.
     2272       define buffer buf_doc-line-attr for ub.doc-line-attr.
     2273       find first buf_rvs-doc
     2274         where rowid( buf_rvs-doc ) = tbl-row
     2275       .
     2276       for each buf_rvs-line
     2277         where buf_rvs-line.rvs-code = buf_rvs-doc.rvs-code
     2278       on error undo, return error return-value
     2279       :
     2280         run cre-route-dump( p-act-name, 'rvs-line':U, (buffer buf_rvs-line:handle), dmp-ord, input-output rc-ord ) .
     2281       end.
     2282       for each buf_rvs-line-pump
     2283         where buf_rvs-line-pump.rvs-code = buf_rvs-doc.rvs-code
     2284       on error undo, return error return-value
     2285       :
     2286         run cre-route-dump( p-act-name, 'rvs-line-pump':U, (buffer buf_rvs-line-pump:handle), dmp-ord, input-output rc-ord ) .
     2287       end.
     2288       for each buf_rvs-pump
     2289         where buf_rvs-pump.rvs-code = buf_rvs-doc.rvs-code
     2290       on error undo, return error return-value
     2291       :
     2292         run cre-route-dump( p-act-name, 'rvs-pump':U, (buffer buf_rvs-pump:handle), dmp-ord, input-output rc-ord ) .
     2293       end.
     2294       for each buf_doc-attr
     2295         where buf_doc-attr.doc-code = buf_rvs-doc.rvs-code
     2296       on error undo, return error return-value
     2297       :
     2298         run cre-route-dump( p-act-name, 'doc-attr':U, (buffer buf_doc-attr:handle), dmp-ord, input-output rc-ord ) .
     2299       end.
     2300       for each buf_doc-line-attr
     2301         where buf_doc-line-attr.doc-code = buf_rvs-doc.rvs-code
     2302       on error undo, return error return-value :
     2303         run cre-route-dump( p-act-name, 'doc-line-attr':U, ( buffer buf_doc-line-attr:handle ), dmp-ord, input-output rc-ord ) .
     2304       end.
     2305       for each buf_rvs-line-attr
     2306         where buf_rvs-line-attr.rvs-code = buf_rvs-doc.rvs-code
     2307       on error undo, return error return-value
     2308       :
     2309         run cre-route-dump( p-act-name, 'rvs-line-attr':U, (buffer buf_rvs-line-attr:handle), dmp-ord, input-output rc-ord ) .
     2310       end.
     2311     end.
     2312   END PROCEDURE.
     2313   PROCEDURE cre-dump-c-rvs-doc :
     2314     define input        parameter p-act-name   as character no-undo .
