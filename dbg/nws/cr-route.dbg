     2590       on error undo, return error substitute( "&1. &2&3&4", vss-include-info4, return-value, chr(10), error-status :get-message ( error-status :num-messages ) ) :
     2591         run cre-route-dump( p-act-name, 'gds-dtl':U, (buffer buf_gds-dtl:handle), dmp-ord, input-output rc-ord ).
     2592       end.
     2593       for each  buf_parts where buf_parts.out-code = buf_trn-doc.doc-code
     2594       on error undo, return error substitute( "&1. &2&3&4", vss-include-info4, return-value, chr(10), error-status :get-message ( error-status :num-messages ) ) :
     2595         run cre-route-dump( p-act-name, 'parts':U, (buffer buf_parts:handle), dmp-ord, input-output rc-ord ).
     2596         define variable v-gds-code as integer   no-undo .
     2597   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pargocod in g#library
     2598     (input  recid(buf_parts)
     2599     ,output v-gds-code
     2600     )  .
     2601         for each buf_parts-attr
     2602           where buf_parts-attr.in-code   = buf_parts.in-code
     2603             and buf_parts-attr.gds-code  = v-gds-code
     2604             and buf_parts-attr.part-code = buf_parts.part-code
     2605         on error undo, return error substitute( "&1. &2&3&4", vss-include-info4, return-value, chr(10), error-status :get-message ( error-status :num-messages ) ) :
     2606           run cre-route-dump( p-act-name, 'parts-attr':U, (buffer buf_parts-attr:handle), dmp-ord, input-output rc-ord ).
     2607         end.
     2608         run gen-key-rec IN THIS-PROCEDURE (  input 'parts':U
     2609                                           ,input (buffer buf_parts:handle)
     2610                                           ,output v-parts-uniq-key-rec).
     2611         for each buf_gen-attr
     2612            where buf_gen-attr.table-name = 'excise-mark':U
     2613              and buf_gen-attr.p-key = v-parts-uniq-key-rec
     2614         on error undo, return error substitute( "&1. &2&3&4", vss-include-info4, return-value, chr(10), error-status :get-message ( error-status :num-messages ) ) :
     2615           run cre-route-dump( p-act-name, 'gen-attr':U, (buffer buf_gen-attr:handle), dmp-ord, input-output rc-ord ).
     2616         end.
     2617         for each buf_marking-lines where
     2618               buf_marking-lines.obj-type = buf_parts.obj-type
     2619           and buf_marking-lines.obj-code = buf_parts.obj-code
     2620           and buf_marking-lines.in-code = buf_parts.in-code
     2621           and buf_marking-lines.out-code = buf_parts.out-code
     2622           and buf_marking-lines.part-code = buf_parts.part-code
     2623           and buf_marking-lines.prt-code = buf_parts.prt-code
     2624           and buf_marking-lines.gds-code = v-gds-code
     2625         on error undo, return error substitute( "&1. &2&3&4", vss-include-info4, return-value, chr(10), error-status :get-message ( error-status :num-messages ) ) :
     2626           run cre-route-dump( p-act-name, 'marking-lines':U, (buffer buf_marking-lines:handle), dmp-ord, input-output rc-ord ).
     2627         end.
     2628       end.
     2629       for each  buf_parts-root where buf_parts-root.doc-code = buf_trn-doc.doc-code
     2630       on error undo, return error substitute( "&1. &2&3&4", vss-include-info4, return-value, chr(10), error-status :get-message ( error-status :num-messages ) ) :
     2631         run cre-route-dump( p-act-name, 'parts-root':U, (buffer buf_parts-root:handle), dmp-ord, input-output rc-ord ).
     2632       end.
     2633       for each buf_doc-attr where buf_doc-attr.doc-code = buf_trn-doc.doc-code
     2634       on error undo, return error substitute( "&1. &2&3&4", vss-include-info4, return-value, chr(10), error-status :get-message ( error-status :num-messages ) ) :
     2635         run cre-route-dump( p-act-name, 'doc-attr':U, (buffer buf_doc-attr:handle), dmp-ord, input-output rc-ord ).
     2636       end.
     2637       for each  buf_doc-prts where buf_doc-prts.out-code = buf_trn-doc.doc-code
     2638       on error undo, return error substitute( "&1. &2&3&4", vss-include-info4, return-value, chr(10), error-status :get-message ( error-status :num-messages ) ) :
     2639         run cre-route-dump( p-act-name, 'doc-prts':U, (buffer buf_doc-prts:handle), dmp-ord, input-output rc-ord ).
     2640       end.
     2641       for each  buf_doc-pl where buf_doc-pl.out-code = buf_trn-doc.doc-code
     2642       on error undo, return error substitute( "&1. &2&3&4", vss-include-info4, return-value, chr(10), error-status :get-message ( error-status :num-messages ) ) :
     2643         run cre-route-dump( p-act-name, 'doc-pl':U, (buffer buf_doc-pl:handle), dmp-ord, input-output rc-ord ).
     2644       end.
     2645       for each  buf_doc-pl-attr where buf_doc-pl-attr.out-code = buf_trn-doc.doc-code
     2646       on error undo, return error substitute( "&1. &2&3&4", vss-include-info4, return-value, chr(10), error-status :get-message ( error-status :num-messages ) ) :
     2647         run cre-route-dump( p-act-name, 'doc-pl-attr':U, (buffer buf_doc-pl-attr:handle), dmp-ord, input-output rc-ord ).
     2648       end.
     2649       for each  buf_doc-pl-pump where buf_doc-pl-pump.out-code = buf_trn-doc.doc-code
     2650       on error undo, return error substitute( "&1. &2&3&4", vss-include-info4, return-value, chr(10), error-status :get-message ( error-status :num-messages ) ) :
     2651         run cre-route-dump( p-act-name, 'doc-pl-pump':U, (buffer buf_doc-pl-pump:handle), dmp-ord, input-output rc-ord ).
     2652       end.
     2653       for each  buf_doc-fbr-gds where buf_doc-fbr-gds.out-code = buf_trn-doc.doc-code
     2654       on error undo, return error substitute( "&1. &2&3&4", vss-include-info4, return-value, chr(10), error-status :get-message ( error-status :num-messages ) ) :
     2655         run cre-route-dump( p-act-name, 'doc-fbr-gds':U, (buffer buf_doc-fbr-gds:handle), dmp-ord, input-output rc-ord ).
     2656       end.
     2657      for each buf_arh-trn-doc-contract where buf_arh-trn-doc-contract.doc-code  = buf_trn-doc.doc-code
     2658      on error undo, return error substitute( "&1. &2&3&4", vss-include-info4, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )  :
     2659        for each buf-rc_arh-trn-doc-contract where buf-rc_arh-trn-doc-contract.host-code     = buf_arh-trn-doc-contract.host-code     and
     2660                                                   buf-rc_arh-trn-doc-contract.contract-code = buf_arh-trn-doc-contract.contract-code and
     2661                                                   buf-rc_arh-trn-doc-contract.cli-type      = buf_arh-trn-doc-contract.cli-type      and
     2662                                                   buf-rc_arh-trn-doc-contract.cli-code      = buf_arh-trn-doc-contract.cli-code      and
     2663                                                   buf-rc_arh-trn-doc-contract.obj-type      = buf_arh-trn-doc-contract.obj-type      and
     2664                                                   buf-rc_arh-trn-doc-contract.obj-code      = buf_arh-trn-doc-contract.obj-code      and
     2665                                                   buf-rc_arh-trn-doc-contract.ext-doc-type  = buf_arh-trn-doc-contract.ext-doc-type  and
     2666                                                   buf-rc_arh-trn-doc-contract.sum-type      = buf_arh-trn-doc-contract.sum-type      and
     2667                                                   buf-rc_arh-trn-doc-contract.fact-order    > buf_arh-trn-doc-contract.fact-order
     2668        on error undo, return error substitute( "&1. &2&3&4", vss-include-info4, return-value, chr(10), error-status :get-message ( error-status :num-messages ) ) :
     2669          run cre-route-dump( p-act-name, 'arh-trn-doc-contract':U, (buffer buf-rc_arh-trn-doc-contract:handle), dmp-ord, input-output rc-ord ).
     2670        end.
     2671        run cre-route-dump( p-act-name, 'arh-trn-doc-contract':U, (buffer buf_arh-trn-doc-contract:handle), dmp-ord, input-output rc-ord ).
     2672      end.
     2673      if buf_trn-doc.ext-doc-type = 'vt':U
     2674      and buf_trn-doc.status_ = 'факт':U
     2675      and chk-go-news
     2676      then do:
     2677         for each  buf_chk-doc where buf_chk-doc.out-code = buf_trn-doc.doc-code
     2678         on error undo, return error return-value :
     2679           run cre-route-dump( p-act-name, 'chk-doc':U, (buffer buf_chk-doc:handle), dmp-ord, input-output rc-ord ).
     2680           for each  buf_chk-gds where buf_chk-gds.doc-code = buf_chk-doc.doc-code
     2681           on error undo, return error return-value :
     2682             run cre-route-dump( p-act-name, 'chk-gds':U, (buffer buf_chk-gds:handle), dmp-ord, input-output rc-ord ).
     2683           end.
     2684           for each  buf_chk-doc-attr where buf_chk-doc-attr.doc-code = buf_chk-doc.doc-code
     2685           on error undo, return error return-value :
     2686             run cre-route-dump( p-act-name, 'chk-doc-attr':U, (buffer buf_chk-doc-attr:handle), dmp-ord, input-output rc-ord ).
     2687           end.
     2688           if p-act-name <> 'send-tbl':U or g#db-num = 0 or not can-do(v-custom-except-list,"c-chk-doc-attr") then
     2689           do:
     2690             for each  buf_c-chk-doc-attr where buf_c-chk-doc-attr.doc-code = buf_chk-doc.doc-code
     2691             on error undo, return error return-value :
     2692               run cre-route-dump( p-act-name, 'c-chk-doc-attr':U, (buffer buf_c-chk-doc-attr:handle), dmp-ord, input-output rc-ord ).
     2693             end.
     2694           end.
     2695           if p-act-name <> 'send-tbl':U or g#db-num = 0 or not can-do(v-custom-except-list,"c-chk-doc") then
     2696           do:
     2697             for each  buf_c-chk-doc where buf_c-chk-doc.doc-code = buf_chk-doc.doc-code
     2698             on error undo, return error return-value :
     2699               run cre-route-dump( p-act-name, 'c-chk-doc':U, (buffer buf_c-chk-doc:handle), dmp-ord, input-output rc-ord ).
     2700             end.
     2701           end.
     2702           if p-act-name <> 'send-tbl':U or g#db-num = 0 or not can-do(v-custom-except-list,"c-chk-gds") then
     2703           do:
     2704             for each  buf_c-chk-gds where buf_c-chk-gds.doc-code = buf_chk-doc.doc-code
     2705             on error undo, return error return-value :
     2706               run cre-route-dump( p-act-name, 'c-chk-gds':U, (buffer buf_c-chk-gds:handle), dmp-ord, input-output rc-ord ).
     2707             end.
     2708           end.
     2709         end.
     2710       end.
     2711     end.
     2712   END PROCEDURE.
     2713   PROCEDURE cre-dump-c-trn-doc:
     2714     define input        parameter p-act-name  as   character no-undo .
     2715     define input        parameter tbl-row     as   rowid                  no-undo.
     2716     define input        parameter dmp-ord     like ub.route-dump.dump-ord no-undo.
     2717     define input-output parameter rc-ord      like ub.route-dump.rec-ord  no-undo.
     2718     do transaction
     2719     on error  undo, return error substitute( "&1 (cre-dump-c-trn-doc). &2&3&4", vss-include-info4, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2720     on stop   undo, return error substitute( "&1 (cre-dump-c-trn-doc). stop", vss-include-info4 )
     2721     on endkey undo, return error substitute( "&1 (cre-dump-c-trn-doc). endkey", vss-include-info4 )
     2722     :
     2723     end.
     2724   END PROCEDURE.
     2725   PROCEDURE cre-dump-inkas:
     2726     define input        parameter p-act-name  as   character no-undo .
     2727     define input        parameter tbl-row     as   rowid                  no-undo.
     2728     define input        parameter dmp-ord     like ub.route-dump.dump-ord no-undo.
     2729     define input-output parameter rc-ord      like ub.route-dump.rec-ord  no-undo.
     2730     define input        parameter chk-go-news as   logical                no-undo.
     2731     do transaction
     2732     on error  undo, return error substitute( "&1 (cre-dump-inkas). &2&3&4", vss-include-info4, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2733     on stop   undo, return error substitute( "&1 (cre-dump-inkas). stop", vss-include-info4 )
     2734     on endkey undo, return error substitute( "&1 (cre-dump-inkas). endkey", vss-include-info4 )
     2735     :
     2736       define buffer buf_inkas-pay      for ub.inkas-pay.
     2737       define buffer buf_inkas-pay-desk for ub.inkas-pay-desk.
     2738       define buffer buf_inkas-pay-wth  for ub.inkas-pay-wth.
     2739       define buffer buf_sale-doc       for ub.sale-doc.
     2740       define buffer buf_c-sale-doc     for ub.c-sale-doc.
     2741       define buffer buf_inkas          for ub.inkas.
     2742       define buffer buf_chk-doc        for ub.chk-doc.
     2743       define buffer buf_chk-gds        for ub.chk-gds.
     2744       define buffer buf_chk-gds-attr   for ub.chk-gds-attr.
     2745       define buffer buf_chk-pay        for ub.chk-pay.
     2746       define buffer buf_chk-pay-attr   for ub.chk-pay-attr .
     2747       define buffer buf_chk-discnt     for ub.chk-discnt.
     2748       define buffer buf_chk-discnt-attr     for ub.chk-discnt-attr.
     2749       define buffer buf_chk-doc-attr   for ub.chk-doc-attr.
     2750       define buffer buf_chk-gds-pay      for ub.chk-gds-pay.
     2751       define buffer buf_c-chk-doc        for ub.c-chk-doc.
     2752       define buffer buf_c-chk-gds        for ub.c-chk-gds.
     2753       define buffer buf_c-chk-pay        for ub.c-chk-pay.
     2754       define buffer buf_c-chk-discnt     for ub.c-chk-discnt.
     2755       define buffer buf_c-chk-doc-attr   for ub.c-chk-doc-attr.
     2756       define buffer buf_marking-chk      for ub.marking-chk .
     2757       find buf_inkas where rowid(buf_inkas) = tbl-row.
     2758       for each  buf_inkas-pay where buf_inkas-pay.inkas-code = buf_inkas.inkas-code
     2759       on error undo, return error substitute( "&1. &2&3&4", vss-include-info4, return-value, chr(10), error-status :get-message ( error-status :num-messages ) ) :
     2760         run cre-route-dump( p-act-name, 'inkas-pay':U, (buffer buf_inkas-pay:handle), dmp-ord, input-output rc-ord ).
     2761         for each buf_inkas-pay-desk where
     2762                  buf_inkas-pay-desk.inkas-code = buf_inkas-pay.inkas-code AND
     2763                  buf_inkas-pay-desk.pay-code   = buf_inkas-pay.pay-code   AND
     2764                  buf_inkas-pay-desk.curr-code  = buf_inkas-pay.curr-code
     2765          on error undo, return error substitute( "&1. &2&3&4", vss-include-info4, return-value, chr(10), error-status :get-message ( error-status :num-messages ) ) :
     2766            run cre-route-dump( p-act-name, 'inkas-pay-desk':U, (buffer buf_inkas-pay-desk:handle), dmp-ord, input-output rc-ord ).
     2767          end.
     2768         for each buf_inkas-pay-wth where
     2769                  buf_inkas-pay-wth.inkas-code = buf_inkas-pay.inkas-code AND
     2770                  buf_inkas-pay-wth.pay-code   = buf_inkas-pay.pay-code   AND
     2771                  buf_inkas-pay-wth.curr-code  = buf_inkas-pay.curr-code
     2772          on error undo, return error substitute( "&1. &2&3&4", vss-include-info4, return-value, chr(10), error-status :get-message ( error-status :num-messages ) ) :
     2773            run cre-route-dump( p-act-name, 'inkas-pay-wth':U, (buffer buf_inkas-pay-wth:handle), dmp-ord, input-output rc-ord ).
     2774          end.
     2775       end.
     2776       for each  buf_sale-doc where buf_sale-doc.inkas-code = buf_inkas.inkas-code
     2777       on error undo, return error substitute( "&1. &2&3&4", vss-include-info4, return-value, chr(10), error-status :get-message ( error-status :num-messages ) ) :
     2778         run cre-route-dump( p-act-name, 'sale-doc':U, (buffer buf_sale-doc:handle), dmp-ord, input-output rc-ord ).
     2779         if p-act-name <> 'send-tbl':U or g#db-num = 0 or not can-do(v-custom-except-list,"c-sale-doc") then
     2780         do:
     2781           for each buf_c-sale-doc where
     2782                    buf_c-sale-doc.inkas-code = buf_sale-doc.inkas-code
     2783                AND buf_c-sale-doc.doc-code   = buf_sale-doc.doc-code
     2784           on error undo, return error substitute( "&1. &2&3&4", vss-include-info4, return-value, chr(10), error-status :get-message ( error-status :num-messages ) ) :
     2785             run cre-route-dump( p-act-name, 'c-sale-doc':U, (buffer buf_c-sale-doc:handle), dmp-ord, input-output rc-ord ).
     2786           end.
     2787         end.
     2788       end.
     2789       for each  buf_chk-doc where buf_chk-doc.out-code = buf_inkas.inkas-code
     2790                             and ( chk-go-news = TRUE
     2791                                   or buf_chk-doc.d-card <> ""
     2792                                 )
     2793       on error undo, return error substitute( "&1. &2&3&4", vss-include-info4, return-value, chr(10), error-status :get-message ( error-status :num-messages ) ) :
     2794         run cre-route-dump( p-act-name, 'chk-doc':U, (buffer buf_chk-doc:handle), dmp-ord, input-output rc-ord ).
     2795         for each  buf_chk-gds where buf_chk-gds.doc-code = buf_chk-doc.doc-code
     2796         on error undo, return error substitute( "&1. &2&3&4", vss-include-info4, return-value, chr(10), error-status :get-message ( error-status :num-messages ) ) :
     2797           run cre-route-dump( p-act-name, 'chk-gds':U, (buffer buf_chk-gds:handle), dmp-ord, input-output rc-ord ).
     2798         end.
     2799         for each  buf_chk-gds-attr where buf_chk-gds-attr.doc-code = buf_chk-doc.doc-code
     2800         on error undo, return error substitute( "&1. &2&3&4", vss-include-info4, return-value, chr(10), error-status :get-message ( error-status :num-messages ) ) :
     2801           run cre-route-dump( p-act-name, 'chk-gds-attr':U, (buffer buf_chk-gds-attr:handle), dmp-ord, input-output rc-ord ).
     2802         end.
     2803         for each buf_marking-chk where buf_marking-chk.doc-code = buf_chk-doc.doc-code
     2804         on error undo, return error substitute( "&1. &2&3&4", vss-include-info4, return-value, chr(10), error-status :get-message ( error-status :num-messages ) ) :
     2805           run cre-route-dump( p-act-name, 'marking-chk':U, (buffer buf_marking-chk:handle), dmp-ord, input-output rc-ord ).
     2806         end.
     2807         for each  buf_chk-pay where buf_chk-pay.doc-code = buf_chk-doc.doc-code
     2808         on error undo, return error substitute( "&1. &2&3&4", vss-include-info4, return-value, chr(10), error-status :get-message ( error-status :num-messages ) ) :
     2809           run cre-route-dump( p-act-name, 'chk-pay':U, (buffer buf_chk-pay:handle), dmp-ord, input-output rc-ord ).
     2810         end.
     2811         for each  buf_chk-pay-attr where buf_chk-pay-attr.doc-code = buf_chk-doc.doc-code
     2812         on error undo, return error substitute( "&1. &2&3&4", vss-include-info4, return-value, chr(10), error-status :get-message ( error-status :num-messages ) ) :
     2813           run cre-route-dump( p-act-name, 'chk-pay-attr':U, (buffer buf_chk-pay-attr:handle), dmp-ord, input-output rc-ord ).
     2814         end.
     2815         for each  buf_chk-discnt where buf_chk-discnt.doc-code = buf_chk-doc.doc-code
     2816         on error undo, return error substitute( "&1. &2&3&4", vss-include-info4, return-value, chr(10), error-status :get-message ( error-status :num-messages ) ) :
     2817           run cre-route-dump( p-act-name, 'chk-discnt':U, (buffer buf_chk-discnt:handle), dmp-ord, input-output rc-ord ).
     2818         end.
     2819         for each  buf_chk-discnt-attr where buf_chk-discnt-attr.doc-code = buf_chk-doc.doc-code
     2820         on error undo, return error substitute( "&1. &2&3&4", vss-include-info4, return-value, chr(10), error-status :get-message ( error-status :num-messages ) ) :
     2821           run cre-route-dump( p-act-name, 'chk-discnt-attr':U, (buffer buf_chk-discnt-attr:handle), dmp-ord, input-output rc-ord ).
     2822         end.
     2823         for each  buf_chk-doc-attr where buf_chk-doc-attr.doc-code = buf_chk-doc.doc-code
     2824         on error undo, return error substitute( "&1. &2&3&4", vss-include-info4, return-value, chr(10), error-status :get-message ( error-status :num-messages ) ) :
     2825           run cre-route-dump( p-act-name, 'chk-doc-attr':U, (buffer buf_chk-doc-attr:handle), dmp-ord, input-output rc-ord ).
     2826         end.
     2827         if p-act-name <> 'send-tbl':U or g#db-num = 0 or not can-do(v-custom-except-list,"c-chk-doc") then
     2828         do:
     2829           for each  buf_c-chk-doc where buf_c-chk-doc.doc-code = buf_chk-doc.doc-code
     2830           on error undo, return error substitute( "&1. &2&3&4", vss-include-info4, return-value, chr(10), error-status :get-message ( error-status :num-messages ) ) :
     2831             run cre-route-dump( p-act-name, 'c-chk-doc':U, (buffer buf_c-chk-doc:handle), dmp-ord, input-output rc-ord ).
     2832           end.
     2833         end.
     2834         if p-act-name <> 'send-tbl':U or g#db-num = 0 or not can-do(v-custom-except-list,"c-chk-gds") then
     2835         do:
     2836           for each  buf_c-chk-gds where buf_c-chk-gds.doc-code = buf_chk-doc.doc-code
     2837           on error undo, return error substitute( "&1. &2&3&4", vss-include-info4, return-value, chr(10), error-status :get-message ( error-status :num-messages ) ) :
     2838             run cre-route-dump( p-act-name, 'c-chk-gds':U, (buffer buf_c-chk-gds:handle), dmp-ord, input-output rc-ord ).
     2839           end.
     2840         end.
     2841         if p-act-name <> 'send-tbl':U or g#db-num = 0 or not can-do(v-custom-except-list,"c-chk-pay") then
     2842         do:
     2843           for each  buf_c-chk-pay where buf_c-chk-pay.doc-code = buf_chk-doc.doc-code
     2844           on error undo, return error substitute( "&1. &2&3&4", vss-include-info4, return-value, chr(10), error-status :get-message ( error-status :num-messages ) ) :
     2845             run cre-route-dump( p-act-name, 'c-chk-pay':U, (buffer buf_c-chk-pay:handle), dmp-ord, input-output rc-ord ).
     2846           end.
     2847         end.
     2848         if p-act-name <> 'send-tbl':U or g#db-num = 0 or not can-do(v-custom-except-list,"c-chk-discnt") then
     2849         do:
     2850           for each  buf_c-chk-discnt where buf_c-chk-discnt.doc-code = buf_chk-doc.doc-code
     2851           on error undo, return error substitute( "&1. &2&3&4", vss-include-info4, return-value, chr(10), error-status :get-message ( error-status :num-messages ) ) :
     2852             run cre-route-dump( p-act-name, 'c-chk-discnt':U, (buffer buf_c-chk-discnt:handle), dmp-ord, input-output rc-ord ).
     2853           end.
     2854         end.
     2855         if p-act-name <> 'send-tbl':U or g#db-num = 0 or not can-do(v-custom-except-list,"c-chk-doc-attr") then
     2856         do:
     2857           for each  buf_c-chk-doc-attr where buf_c-chk-doc-attr.doc-code = buf_chk-doc.doc-code
     2858           on error undo, return error substitute( "&1. &2&3&4", vss-include-info4, return-value, chr(10), error-status :get-message ( error-status :num-messages ) ) :
     2859             run cre-route-dump( p-act-name, 'c-chk-doc-attr':U, (buffer buf_c-chk-doc-attr:handle), dmp-ord, input-output rc-ord ).
     2860           end.
     2861         end.
     2862       end.
     2863       if chk-go-news = TRUE then do:
     2864         for each  buf_chk-gds-pay where buf_chk-gds-pay.out-code = buf_inkas.inkas-code
     2865         on error undo, return error substitute( "&1. &2&3&4", vss-include-info4, return-value, chr(10), error-status :get-message ( error-status :num-messages ) ) :
     2866           run cre-route-dump( p-act-name, 'chk-gds-pay':U, (buffer buf_chk-gds-pay:handle), dmp-ord, input-output rc-ord ).
     2867         end.
     2868       end.
     2869     end.
     2870   END PROCEDURE.
     2871   PROCEDURE cre-dump-c-inkas:
     2872     define input        parameter p-act-name  as   character no-undo .
     2873     define input        parameter tbl-row     as   rowid                  no-undo.
     2874     define input        parameter dmp-ord     like ub.route-dump.dump-ord no-undo.
     2875     define input-output parameter rc-ord      like ub.route-dump.rec-ord  no-undo.
     2876     define input        parameter chk-go-news as   logical                no-undo.
     2877     do transaction
     2878     on error  undo, return error substitute( "&1 (cre-dump-c-inkas). &2&3&4", vss-include-info4, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2879     on stop   undo, return error substitute( "&1 (cre-dump-c-inkas). stop", vss-include-info4 )
     2880     on endkey undo, return error substitute( "&1 (cre-dump-c-inkas). endkey", vss-include-info4 )
     2881     :
     2882       define buffer buf_c-inkas-pay      for ub.c-inkas-pay.
     2883       define buffer buf_c-inkas-pay-desk for ub.c-inkas-pay-desk.
     2884       define buffer buf_c-inkas-pay-wth  for ub.c-inkas-pay-wth.
     2885       define buffer buf_c-inkas          for ub.c-inkas.
     2886       define buffer buf_c-sale-doc       for ub.c-sale-doc.
     2887       find buf_c-inkas where rowid(buf_c-inkas) = tbl-row.
     2888       for each  buf_c-inkas-pay where buf_c-inkas-pay.inkas-code = buf_c-inkas.inkas-code
     2889       on error undo, return error substitute( "&1. &2&3&4", vss-include-info4, return-value, chr(10), error-status :get-message ( error-status :num-messages ) ) :
     2890         run cre-route-dump( p-act-name, 'c-inkas-pay':U, (buffer buf_c-inkas-pay:handle), dmp-ord, input-output rc-ord ).
     2891         for each buf_c-inkas-pay-desk where
     2892                  buf_c-inkas-pay-desk.inkas-code = buf_c-inkas-pay.inkas-code AND
     2893                  buf_c-inkas-pay-desk.pay-code   = buf_c-inkas-pay.pay-code   AND
     2894                  buf_c-inkas-pay-desk.curr-code  = buf_c-inkas-pay.curr-code
     2895          on error undo, return error substitute( "&1. &2&3&4", vss-include-info4, return-value, chr(10), error-status :get-message ( error-status :num-messages ) ) :
     2896            run cre-route-dump( p-act-name, 'c-inkas-pay-desk':U, (buffer buf_c-inkas-pay-desk:handle), dmp-ord, input-output rc-ord ).
     2897          end.
     2898         for each buf_c-inkas-pay-wth where
     2899                  buf_c-inkas-pay-wth.inkas-code = buf_c-inkas-pay.inkas-code AND
     2900                  buf_c-inkas-pay-wth.pay-code   = buf_c-inkas-pay.pay-code   AND
     2901                  buf_c-inkas-pay-wth.curr-code  = buf_c-inkas-pay.curr-code
     2902          on error undo, return error substitute( "&1. &2&3&4", vss-include-info4, return-value, chr(10), error-status :get-message ( error-status :num-messages ) ) :
     2903            run cre-route-dump( p-act-name, 'c-inkas-pay-wth':U, (buffer buf_c-inkas-pay-wth:handle), dmp-ord, input-output rc-ord ).
     2904          end.
     2905       end.
     2906       for each  buf_c-sale-doc where buf_c-sale-doc.inkas-code = buf_c-inkas.inkas-code
     2907       on error undo, return error substitute( "&1. &2&3&4", vss-include-info4, return-value, chr(10), error-status :get-message ( error-status :num-messages ) ) :
     2908         run cre-route-dump( p-act-name, 'c-sale-doc':U, (buffer buf_c-sale-doc:handle), dmp-ord, input-output rc-ord ).
     2909       end.
     2910     end.
     2911   END PROCEDURE.
     2912   PROCEDURE cre-dump-c-chk-doc:
     2913     define input        parameter p-act-name  as   character no-undo .
     2914     define input        parameter tbl-row     as   rowid                  no-undo.
     2915     define input        parameter dmp-ord     like ub.route-dump.dump-ord no-undo.
     2916     define input-output parameter rc-ord      like ub.route-dump.rec-ord  no-undo.
     2917     define input        parameter chk-go-news as   logical                no-undo.
     2918     do transaction
     2919     on error  undo, return error substitute( "&1 (cre-dump-c-chk-doc). &2&3&4", vss-include-info4, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2920     on stop   undo, return error substitute( "&1 (cre-dump-c-chk-doc). stop", vss-include-info4 )
     2921     on endkey undo, return error substitute( "&1 (cre-dump-c-chk-doc). endkey", vss-include-info4 )
     2922     :
     2923       define buffer buf_c-chk-doc        for ub.c-chk-doc.
     2924       define buffer buf_c-chk-gds        for ub.c-chk-gds.
     2925       define buffer buf_c-chk-pay        for ub.c-chk-pay.
     2926       define buffer buf_c-chk-discnt     for ub.c-chk-discnt.
     2927       define buffer buf_c-chk-doc-attr   for ub.c-chk-doc-attr.
     2928       find buf_c-chk-doc where rowid(buf_c-chk-doc) = tbl-row.
     2929       for each  buf_c-chk-gds where buf_c-chk-gds.doc-code = buf_c-chk-doc.doc-code
     2930                                AND  buf_c-chk-gds.chip-num = buf_c-chk-doc.chip-num
     2931       on error undo, return error substitute( "&1. &2&3&4", vss-include-info4, return-value, chr(10), error-status :get-message ( error-status :num-messages ) ) :
     2932         run cre-route-dump( p-act-name, 'c-chk-gds':U, (buffer buf_c-chk-gds:handle), dmp-ord, input-output rc-ord ).
     2933       end.
     2934       for each  buf_c-chk-pay where buf_c-chk-pay.doc-code = buf_c-chk-doc.doc-code
     2935                                AND  buf_c-chk-pay.chip-num = buf_c-chk-doc.chip-num
     2936       on error undo, return error substitute( "&1. &2&3&4", vss-include-info4, return-value, chr(10), error-status :get-message ( error-status :num-messages ) ) :
     2937         run cre-route-dump( p-act-name, 'c-chk-pay':U, (buffer buf_c-chk-pay:handle), dmp-ord, input-output rc-ord ).
     2938       end.
     2939       for each  buf_c-chk-discnt where buf_c-chk-discnt.doc-code = buf_c-chk-doc.doc-code
     2940                                   AND  buf_c-chk-discnt.chip-num = buf_c-chk-doc.chip-num
     2941       on error undo, return error substitute( "&1. &2&3&4", vss-include-info4, return-value, chr(10), error-status :get-message ( error-status :num-messages ) ) :
     2942         run cre-route-dump( p-act-name, 'c-chk-discnt':U, (buffer buf_c-chk-discnt:handle), dmp-ord, input-output rc-ord ).
     2943       end.
     2944       for each  buf_c-chk-doc-attr where buf_c-chk-doc-attr.doc-code = buf_c-chk-doc.doc-code
     2945                                     AND  buf_c-chk-doc-attr.chip-num = buf_c-chk-doc.chip-num
     2946       on error undo, return error substitute( "&1. &2&3&4", vss-include-info4, return-value, chr(10), error-status :get-message ( error-status :num-messages ) ) :
     2947         run cre-route-dump( p-act-name, 'c-chk-doc-attr':U, (buffer buf_c-chk-doc-attr:handle), dmp-ord, input-output rc-ord ).
     2948       end.
     2949     end.
     2950   END PROCEDURE.
     2951   PROCEDURE cre-dump-shift-obj:
     2952     define input        parameter p-act-name  as   character no-undo .
     2953     define input        parameter tbl-row     as   rowid                  no-undo.
     2954     define input        parameter dmp-ord     like ub.route-dump.dump-ord no-undo.
     2955     define input-output parameter rc-ord      like ub.route-dump.rec-ord  no-undo.
     2956     do transaction
     2957     on error  undo, return error substitute( "&1 (cre-dump-shift-obj). &2&3&4", vss-include-info4, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2958     on stop   undo, return error substitute( "&1 (cre-dump-shift-obj). stop", vss-include-info4 )
     2959     on endkey undo, return error substitute( "&1 (cre-dump-shift-obj). endkey", vss-include-info4 )
     2960     :
     2961       define buffer buf_shift-obj   for ub.shift-obj.
     2962       define buffer buf_shift-staff for ub.shift-staff.
     2963       define buffer buf_shift-cash  for ub.shift-cash.
     2964       define buffer buf_c-shift-staff for ub.c-shift-staff.
     2965       define buffer buf_c-sht-hist for ub.c-sht-hist.
     2966       define buffer buf_c-shift-obj   for ub.c-shift-obj.
     2967       find buf_shift-obj where rowid(buf_shift-obj) = tbl-row.
     2968       for each buf_shift-staff where buf_shift-staff.obj-type   = buf_shift-obj.obj-type
     2969                                and buf_shift-staff.obj-code   = buf_shift-obj.obj-code
     2970                                and buf_shift-staff.shift-date = buf_shift-obj.shift-date
     2971                                and buf_shift-staff.shift-num  = buf_shift-obj.shift-num
     2972       on error undo, return error substitute( "&1. &2&3&4", vss-include-info4, return-value, chr(10), error-status :get-message ( error-status :num-messages ) ) :
     2973         run cre-route-dump( p-act-name, 'shift-staff':U, (buffer buf_shift-staff:handle), dmp-ord, input-output rc-ord ).
     2974       end.
     2975       if buf_shift-obj.status_ = 'зкр':U then do:
     2976         for each buf_shift-cash where buf_shift-cash.obj-type   = buf_shift-obj.obj-type
     2977                                 and buf_shift-cash.obj-code   = buf_shift-obj.obj-code
     2978                                 and buf_shift-cash.shift-date = buf_shift-obj.shift-date
     2979                                 and buf_shift-cash.shift-num  = buf_shift-obj.shift-num
     2980         on error undo, return error substitute( "&1. &2&3&4", vss-include-info4, return-value, chr(10), error-status :get-message ( error-status :num-messages ) ) :
     2981           run cre-route-dump( p-act-name, 'shift-cash':U, (buffer buf_shift-cash:handle), dmp-ord, input-output rc-ord ).
     2982         end.
     2983         if p-act-name <> 'send-tbl':U or g#db-num = 0 or not can-do(v-custom-except-list,"c-shift-staff") then
     2984         do:
     2985           for each buf_c-shift-staff where buf_c-shift-staff.obj-type   = buf_shift-obj.obj-type
     2986                                   and buf_c-shift-staff.obj-code   = buf_shift-obj.obj-code
     2987                                   and buf_c-shift-staff.shift-date = buf_shift-obj.shift-date
     2988                                   and buf_c-shift-staff.shift-num  = buf_shift-obj.shift-num
     2989           on error undo, return error substitute( "&1. &2&3&4", vss-include-info4, return-value, chr(10), error-status :get-message ( error-status :num-messages ) ) :
     2990             run cre-route-dump( p-act-name, 'c-shift-staff':U, (buffer buf_c-shift-staff:handle), dmp-ord, input-output rc-ord ).
     2991           end.
     2992         end.
     2993         if p-act-name <> 'send-tbl':U or g#db-num = 0 or not can-do(v-custom-except-list,"c-sht-hist") then
     2994         do:
     2995           for each buf_c-sht-hist where buf_c-sht-hist.obj-type   = buf_shift-obj.obj-type
     2996                                   and buf_c-sht-hist.obj-code   = buf_shift-obj.obj-code
     2997                                   and buf_c-sht-hist.shift-date = buf_shift-obj.shift-date
     2998                                   and buf_c-sht-hist.shift-num  = buf_shift-obj.shift-num
     2999           on error undo, return error substitute( "&1. &2&3&4", vss-include-info4, return-value, chr(10), error-status :get-message ( error-status :num-messages ) ) :
     3000             run cre-route-dump( p-act-name, 'c-sht-hist':U, (buffer buf_c-sht-hist:handle), dmp-ord, input-output rc-ord ).
     3001           end.
     3002         end.
     3003         if p-act-name <> 'send-tbl':U or g#db-num = 0 or not can-do(v-custom-except-list,"c-shift-obj") then
     3004         do:
     3005           for each buf_c-shift-obj where buf_c-shift-obj.obj-type   = buf_shift-obj.obj-type
     3006                                   and buf_c-shift-obj.obj-code   = buf_shift-obj.obj-code
     3007                                   and buf_c-shift-obj.shift-date = buf_shift-obj.shift-date
     3008                                   and buf_c-shift-obj.shift-num  = buf_shift-obj.shift-num
     3009           on error undo, return error substitute( "&1. &2&3&4", vss-include-info4, return-value, chr(10), error-status :get-message ( error-status :num-messages ) ) :
     3010             run cre-route-dump( p-act-name, 'c-shift-obj':U, (buffer buf_c-shift-obj:handle), dmp-ord, input-output rc-ord ).
     3011           end.
     3012         end.
     3013       end.
     3014     end.
     3015   END PROCEDURE.
     3016   PROCEDURE cre-dump-c-shift-obj:
     3017     define input        parameter p-act-name  as   character no-undo .
     3018     define input        parameter tbl-row     as   rowid                  no-undo.
     3019     define input        parameter dmp-ord     like ub.route-dump.dump-ord no-undo.
     3020     define input-output parameter rc-ord      like ub.route-dump.rec-ord  no-undo.
     3021     do transaction
     3022     on error  undo, return error substitute( "&1 (cre-dump-c-shift-obj). &2&3&4", vss-include-info4, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     3023     on stop   undo, return error substitute( "&1 (cre-dump-c-shift-obj). stop", vss-include-info4 )
     3024     on endkey undo, return error substitute( "&1 (cre-dump-c-shift-obj). endkey", vss-include-info4 )
     3025     :
     3026       define buffer buf_c-shift-obj   for ub.c-shift-obj.
     3027       define buffer buf_c-shift-staff for ub.c-shift-staff.
     3028       define buffer buf_shift-cash  for ub.shift-cash.
     3029       define buffer buf_c-sht-hist for ub.c-sht-hist.
     3030       define buffer buf_old_c-shift-obj   for ub.c-shift-obj.
     3031       find buf_c-shift-obj where rowid(buf_c-shift-obj) = tbl-row.
     3032       for each buf_shift-cash where buf_shift-cash.obj-type   = buf_c-shift-obj.obj-type
     3033                               and buf_shift-cash.obj-code   = buf_c-shift-obj.obj-code
     3034                               and buf_shift-cash.shift-date = buf_c-shift-obj.shift-date
     3035                               and buf_shift-cash.shift-num  = buf_c-shift-obj.shift-num
     3036       on error undo, return error substitute( "&1. &2&3&4", vss-include-info4, return-value, chr(10), error-status :get-message ( error-status :num-messages ) ) :
     3037         run cre-route-dump( p-act-name, 'shift-cash':U, (buffer buf_shift-cash:handle), dmp-ord, input-output rc-ord ).
     3038       end.
     3039       _buf_c-sht-hist:
     3040       for each buf_c-sht-hist where buf_c-sht-hist.obj-type   = buf_c-shift-obj.obj-type
     3041                               and buf_c-sht-hist.obj-code   = buf_c-shift-obj.obj-code
     3042                               and buf_c-sht-hist.shift-date = buf_c-shift-obj.shift-date
     3043                               and buf_c-sht-hist.shift-num  = buf_c-shift-obj.shift-num
     3044                               and buf_c-sht-hist.corr-user-db-num  = buf_c-shift-obj.corr-user-db-num
     3045                               and buf_c-sht-hist.chip-num  <= buf_c-shift-obj.chip-num
     3046       on error undo, return error substitute( "&1. &2&3&4", vss-include-info4, return-value, chr(10), error-status :get-message ( error-status :num-messages ) ) :
     3047         CASE buf_c-sht-hist.subject:
     3048           when 'shift-staff':U then do:
     3049             if buf_c-sht-hist.chip-num = buf_c-shift-obj.chip-num then next _buf_c-sht-hist.
     3050             find first buf_c-shift-staff where buf_c-shift-staff.obj-type   = buf_c-sht-hist.obj-type
     3051                                 and buf_c-shift-staff.obj-code   = buf_c-sht-hist.obj-code
     3052                                 and buf_c-shift-staff.shift-date = buf_c-sht-hist.shift-date
     3053                                 and buf_c-shift-staff.shift-num  = buf_c-sht-hist.shift-num
     3054                                 and buf_c-shift-staff.corr-user-db-num  = buf_c-sht-hist.corr-user-db-num
     3055                                 and buf_c-shift-staff.chip-num  = buf_c-sht-hist.chip-num no-error .
     3056             if not available buf_c-shift-staff then do:
     3057                 undo, return error substitute( "&1. &2&3&4", vss-include-info4, return-value, chr(10), error-status :get-message ( error-status :num-messages ) ).
     3058             end.
     3059             run cre-route-dump( p-act-name, 'c-shift-staff':U, (buffer buf_c-shift-staff:handle), dmp-ord, input-output rc-ord ).
     3060           end.
     3061           when 'shift-obj':U then do:
     3062             find first buf_old_c-shift-obj where buf_old_c-shift-obj.obj-type   = buf_c-sht-hist.obj-type
     3063                                 and buf_old_c-shift-obj.obj-code   = buf_c-sht-hist.obj-code
     3064                                 and buf_old_c-shift-obj.shift-date = buf_c-sht-hist.shift-date
     3065                                 and buf_old_c-shift-obj.shift-num  = buf_c-sht-hist.shift-num
     3066                                 and buf_old_c-shift-obj.corr-user-db-num  = buf_c-sht-hist.corr-user-db-num
     3067                                 and buf_old_c-shift-obj.chip-num  = buf_c-sht-hist.chip-num no-error .
     3068             if not available buf_old_c-shift-obj then do:
     3069                 undo, return error substitute( "&1. &2&3&4", vss-include-info4, return-value, chr(10), error-status :get-message ( error-status :num-messages ) ).
     3070             end.
     3071             run cre-route-dump( p-act-name, 'c-shift-obj':U, (buffer buf_old_c-shift-obj:handle), dmp-ord, input-output rc-ord ).
     3072           end.
     3073         END CASE.
     3074         run cre-route-dump( p-act-name, 'c-sht-hist':U, (buffer buf_c-sht-hist:handle), dmp-ord, input-output rc-ord ).
     3075       end.
     3076     end.
     3077   END PROCEDURE.
     3078   PROCEDURE cre-dump-ord-doc:
     3079     define input        parameter p-act-name  as   character no-undo .
     3080     define input        parameter tbl-row     as   rowid                  no-undo.
     3081     define input        parameter dmp-ord     like ub.route-dump.dump-ord no-undo.
     3082     define input-output parameter rc-ord      like ub.route-dump.rec-ord  no-undo.
     3083     do transaction
     3084     on error  undo, return error substitute( "&1 (cre-dump-ord-doc). &2&3&4", vss-include-info4, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     3085     on stop   undo, return error substitute( "&1 (cre-dump-ord-doc). stop", vss-include-info4 )
     3086     on endkey undo, return error substitute( "&1 (cre-dump-ord-doc). endkey", vss-include-info4 )
     3087     :
     3088       define buffer buf_ord-doc  for ub.ord-doc.
     3089       define buffer buf_ord-line for ub.ord-line.
     3090       define buffer buf_ord-dtl  for ub.ord-dtl.
     3091       define buffer buf_ord-doc-attr  for ub.ord-doc-attr.
     3092       define buffer buf_ord-line-attr for ub.ord-line-attr.
     3093       find buf_ord-doc where rowid(buf_ord-doc) = tbl-row.
     3094       for each buf_ord-line where buf_ord-line.doc-code = buf_ord-doc.doc-code
     3095       on error undo, return error substitute( "&1. &2&3&4", vss-include-info4, return-value, chr(10), error-status :get-message ( error-status :num-messages ) ) :
     3096         run cre-route-dump( p-act-name, 'ord-line':U, (buffer buf_ord-line:handle), dmp-ord, input-output rc-ord ).
     3097       end.
     3098       for each buf_ord-line-attr where buf_ord-line-attr.doc-code = buf_ord-doc.doc-code
