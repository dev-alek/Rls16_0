     3131       define buffer buf_ord-line-attr for ub.ord-line-attr.
     3132       find buf_ord-doc-rcv where rowid(buf_ord-doc-rcv) = tbl-row.
     3133       for each buf_ord-line-rcv
     3134          where buf_ord-line-rcv.doc-code = buf_ord-doc-rcv.doc-code
     3135            and buf_ord-line-rcv.rcv-code = buf_ord-doc-rcv.rcv-code
     3136       on error undo, return error substitute( "&1. &2&3&4", vss-include-info4, return-value, chr(10), error-status :get-message ( error-status :num-messages ) ) :
     3137         run cre-route-dump( p-act-name, 'ord-line-rcv':U, (buffer buf_ord-line-rcv:handle), dmp-ord, input-output rc-ord ).
     3138       end.
     3139       for each buf_ord-dtl-rcv
     3140          where buf_ord-dtl-rcv.doc-code = buf_ord-doc-rcv.doc-code
     3141            and buf_ord-dtl-rcv.rcv-code = buf_ord-doc-rcv.rcv-code
     3142       on error undo, return error substitute( "&1. &2&3&4", vss-include-info4, return-value, chr(10), error-status :get-message ( error-status :num-messages ) ) :
     3143         run cre-route-dump( p-act-name, 'ord-dtl-rcv':U, (buffer buf_ord-dtl-rcv:handle), dmp-ord, input-output rc-ord ).
     3144       end.
     3145       for each buf_ord-line where buf_ord-line.doc-code = buf_ord-doc-rcv.doc-code ,
     3146           first buf_ord-doc no-lock where buf_ord-doc.doc-code = buf_ord-doc-rcv.doc-code
     3147                                       and buf_ord-doc.doc-type <> 'ОР':U
     3148           on error undo, return error substitute( "&1. &2&3&4", vss-include-info4, return-value, chr(10), error-status :get-message ( error-status :num-messages ) ) :
     3149         run cre-route-dump( p-act-name, 'ord-line':U, (buffer buf_ord-line:handle), dmp-ord, input-output rc-ord ).
     3150       end.
