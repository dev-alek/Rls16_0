     3154                                       and buf_ord-doc.doc-type <> 'ОР':U
     3155       on error undo, return error substitute( "&1. &2&3&4", vss-include-info4, return-value, chr(10), error-status :get-message ( error-status :num-messages ) ) :
     3156         run cre-route-dump( p-act-name, 'ord-dtl':U, (buffer buf_ord-dtl:handle), dmp-ord, input-output rc-ord ).
     3157       end.
