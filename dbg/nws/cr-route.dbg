     2054         run cre-route-dump( p-act-name, 'c-doc-attr':U, (buffer buf_c-doc-attr:handle), dmp-ord, input-output rc-ord ).
     2055       end.
     2056       for each buf_c-price-list-attr where
     2057                buf_c-price-list-attr.chip-num         = buf_c-price-doc.chip-num and
     2058                buf_c-price-list-attr.corr-user-db-num = buf_c-price-doc.corr-user-db-num and
