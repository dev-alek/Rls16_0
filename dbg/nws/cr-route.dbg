     2047         run cre-route-dump(  p-act-name, 'c-price-list':U, (buffer buf_c-price-list:handle), dmp-ord, input-output rc-ord ).
     2048       end.
     2049       for each buf_c-doc-attr where
     2050                buf_c-doc-attr.chip-num         = buf_c-price-doc.chip-num and
     2051                buf_c-doc-attr.corr-user-db-num = buf_c-price-doc.corr-user-db-num and
