     1130   ":U.
     1131   def var vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1132   procedure gen-key-rec :
     1133     define input  parameter p-tbl-name    as character no-undo.
     1134     define input  parameter p-bh_tbl-name as handle    no-undo.
     1135     define output parameter p-key-rec     as character no-undo.
     1136     do
     1137     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1138     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
     1139     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
     1140     :
     1141       define variable fh               as handle    no-undo .
     1142       define variable v-ok             as logical   no-undo .
     1143       define variable v-inform         as character no-undo .
     1144       define variable v-ind            as integer   no-undo .
     1145       define variable v-idx-field-qnty as integer   no-undo .
     1146       if p-tbl-name = ?
     1147         or p-tbl-name = "":U
     1148       then do:
     1149         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info1 ).
     1150       end.
     1151       if not p-bh_tbl-name:available then do:
     1152         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info1, p-tbl-name ).
     1153       end.
     1154       assign
     1155         p-key-rec = p-tbl-name
     1156         v-inform  = p-bh_tbl-name:index-information(1)
     1157         v-ind     = 2
     1158       .
     1159       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1160       on error undo, return error
     1161       :
     1162         assign
     1163           v-inform = p-bh_tbl-name:index-information( v-ind )
     1164           v-ind    = v-ind + 1
     1165         .
     1166       end.
     1167       if v-inform = ?
     1168         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1169         or entry( 3, v-inform, ",":U ) <> "1":U
     1170       then do:
     1171         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, p-tbl-name ).
     1172       end.
     1173       else do:
     1174         assign
     1175           v-idx-field-qnty = num-entries( v-inform ) - 4
     1176         .
     1177         if v-idx-field-qnty < 2 then do:
     1178           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, p-tbl-name ).
     1179         end.
     1180         do v-ind = 1 to v-idx-field-qnty by 2
     1181         on error undo, return error
     1182         :
     1183           assign
     1184             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
     1185             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
     1186           .
     1187         end.
     1188       end.
     1189       if p-key-rec = ? then do:
     1190         assign
     1191           p-key-rec = "":U
     1192         .
     1193         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info1, p-tbl-name ).
     1194       end.
     1195     end.
     1196     return.
     1197   end procedure.
     1198   procedure gen-where-keyr-tab :
     1199     define input  parameter i-tableSerach as character no-undo.
     1200     define input  parameter i-tablekey   as character  no-undo.
     1201     define input  parameter p-key-rec    as character  no-undo.
     1202     define input  parameter p-key-handle as handle     no-undo .
     1203     define input  parameter p-db-name    as character  no-undo .
     1204     define input  parameter p-tt-handle  as handle     no-undo .
     1205     define output parameter o-Where      as character  no-undo.
     1206     do
     1207     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1208     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1209     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
     1210     :
     1211       define variable v-full-tbl-name  as character no-undo .
     1212       define variable bh_tbl-name      as handle    no-undo .
     1213       define variable fh_key           as handle    no-undo .
     1214       define variable fh_search        as handle    no-undo .
     1215       define variable v-field-num      as integer   no-undo .
     1216       define variable v-count-fld      as integer   no-undo .
     1217       define variable v-inform         as character no-undo .
     1218       define variable v-ind            as integer   no-undo .
     1219       define variable v-idx-field-qnty as integer   no-undo .
     1220       define variable v-field-name     as character no-undo .
     1221       define variable v-field-val      as character no-undo .
     1222       define variable v-word-link      as character no-undo .
     1223       define variable vTable           as character no-undo.
     1224       define variable bh_tbl-key       as handle    no-undo .
     1225       assign
     1226         p-key-rec = trim( p-key-rec )
     1227       .
     1228       if p-key-handle <> ? then do:
     1229         if not valid-handle(p-key-handle)
     1230            or p-key-handle:type <> "buffer"
     1231         then do:
     1232           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info1 ).
     1233         end.
     1234         if num-entries( p-key-rec, chr(3) ) > 1
     1235           or p-key-rec = ?
     1236           or p-key-rec = "":U
     1237         then do:
     1238           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info1, p-key-rec ).
     1239         end.
     1240       end.
     1241       else do:
     1242         if p-key-rec = ?
     1243           or p-key-rec = "":U
     1244         then do:
     1245           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info1 ).
     1246         end.
     1247       end.
     1248       assign
     1249         vTable = entry( 1 , p-key-rec, chr(3) )
     1250       .
     1251       if p-tt-handle <> ?
     1252         and ( not valid-handle(p-tt-handle)
     1253               or p-tt-handle:type <> "buffer"
     1254             )
     1255       then do:
     1256         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info1, vTable, chr(10) ).
     1257       end.
     1258       if p-tt-handle = ? then do:
     1259         assign
     1260           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
     1261         .
     1262         create buffer bh_tbl-name for table v-full-tbl-name .
     1263       end.
     1264       else do:
     1265         create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1266       end.
     1267       assign
     1268         v-inform = bh_tbl-name:index-information(1)
     1269         v-ind    = 2
     1270       .
     1271       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1272       on error undo, return error
     1273       :
     1274         assign
     1275           v-inform = bh_tbl-name:index-information( v-ind )
     1276           v-ind    = v-ind + 1
     1277         .
     1278       end.
     1279       if v-inform = ?
     1280         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1281         or entry( 3, v-inform, ",":U ) <> "1":U
     1282       then do:
     1283         delete object bh_tbl-name no-error.
     1284         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info1, vTable ).
     1285       end.
     1286       assign
     1287         v-idx-field-qnty = num-entries( v-inform ) - 4
     1288       .
     1289       if v-idx-field-qnty < 2 then do:
     1290         delete object bh_tbl-name no-error.
     1291         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, vTable ).
     1292       end.
     1293       assign
     1294         o-where     = "where":U
     1295         v-word-link = "":U
     1296         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
     1297         v-count-fld = 0
     1298       .
     1299       if i-tablekey ne "" and i-tablekey ne ?
     1300       then do:
     1301         assign
     1302           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
     1303         .
     1304         create buffer bh_tbl-key for table v-full-tbl-name .
     1305       end.
     1306       if i-tableSerach ne "" and i-tableSerach ne ?
     1307       then do:
     1308         delete object bh_tbl-name no-error.
     1309         assign
     1310           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
     1311         .
     1312         create buffer bh_tbl-name for table v-full-tbl-name .
     1313       end.
     1314       block_where:
     1315       do v-ind = 1 to v-idx-field-qnty by 2
     1316       on error undo, return error
     1317       :
     1318         assign
     1319           v-count-fld = v-count-fld + 1
     1320         .
     1321         if p-key-handle = ?
     1322           and v-count-fld > v-field-num
     1323         then do:
     1324           leave block_where.
     1325         end.
     1326         define variable VfieldKeyTable as handle no-undo.
     1327         assign
     1328           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     1329           fh_search    = bh_tbl-name:buffer-field( v-field-name )
     1330         .
     1331         if     bh_tbl-key ne ?
     1332         then do:
     1333            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
     1334            if VfieldKeyTable eq ?
     1335            then next block_where.
     1336         end.
     1337         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
     1338         then
     1339            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
     1340         else
     1341            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
     1342         if p-key-handle = ? then do:
     1343           assign
     1344             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
     1345           .
     1346         end.
     1347         else do:
     1348           assign
     1349             fh_key = p-key-handle:buffer-field( v-field-name )
     1350           .
     1351           if fh_key = ?
     1352             or not valid-handle( fh_key )
     1353           then do:
     1354             delete object bh_tbl-name.
     1355             if     bh_tbl-key ne ?
     1356             then
     1357                delete object bh_tbl-key.
     1358             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info1, p-key-handle:name, v-field-name ).
     1359           end.
     1360           assign
     1361             v-field-val = fh_key:buffer-value
     1362           .
     1363         end.
     1364         if fh_search:data-type ="character":U then do:
     1365           assign
     1366             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
     1367             v-field-val = replace( v-field-val, '"':U, '~~"':U )
     1368             v-field-val = replace( v-field-val, "'":U, "~~'":U )
     1369             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
     1370             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
     1371             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
     1372             v-field-val = replace( v-field-val, chr(10), '~~n':U )
     1373             v-field-val = replace( v-field-val, chr(9), '~~t':U )
     1374             v-field-val = replace( v-field-val, chr(13), '~~r':U )
     1375             v-field-val = replace( v-field-val, chr(27), '~~E':U )
     1376             v-field-val = replace( v-field-val, chr(8), '~~b':U )
     1377             v-field-val = replace( v-field-val, chr(12), '~~f':U )
     1378             v-field-val = substitute( '"&1"', v-field-val )
     1379           .
     1380         end.
     1381         assign
     1382           o-where = substitute( "&1 &2", o-where, v-field-val )
     1383         .
     1384         if v-word-link = "":U then do:
     1385           assign
     1386             v-word-link = "and":U
     1387           .
     1388         end.
     1389       end.
     1390       delete object bh_tbl-name.
     1391       if     bh_tbl-key ne ?
     1392       then
     1393          delete object bh_tbl-key.
     1394       if p-key-handle = ?
     1395         and v-count-fld <> v-field-num
     1396       then do:
     1397         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info1, vTable ).
     1398       end.
     1399     end.
     1400   end procedure.
     1401   procedure gen-hn-keyr-tab :
     1402     define input  parameter i-tableSerach as character no-undo.
     1403     define input  parameter i-tablekey   as character no-undo.
     1404     define input  parameter p-key-rec    as character no-undo.
     1405     define input  parameter p-key-handle as handle    no-undo .
     1406     define input  parameter p-db-name    as character no-undo .
     1407     define input  parameter p-tt-handle  as handle    no-undo .
     1408     define input  parameter p-stts-lock  as integer   no-undo .
     1409     define output parameter o-hn         as handle    no-undo.
     1410     define variable v-full-tbl-name as character no-undo.
     1411     define variable v-where         as character no-undo.
     1412     define variable bh_tbl-name     as handle    no-undo.
     1413     define variable vTable          as character no-undo.
     1414     do
     1415     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1416     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1417     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
     1418         run gen-where-keyr-tab(i-tableSerach,
     1419                                i-tablekey,
     1420                                p-key-rec,
     1421                                p-key-handle,
     1422                                p-db-name,
     1423                                p-tt-handle,
     1424                                output v-where).
     1425         if i-tableSerach ne "" and i-tableSerach ne ?
     1426         then do:
     1427            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
     1428            create buffer bh_tbl-name for table v-full-tbl-name .
     1429         end.
     1430         else do:
     1431            if p-tt-handle = ? then do:
     1432               assign
     1433                  vTable = entry( 1 , p-key-rec, chr(3) )
     1434               .
     1435               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
     1436               create buffer bh_tbl-name for table v-full-tbl-name .
     1437            end.
     1438            else do:
     1439               create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1440            end.
     1441         end.
     1442         if p-tt-handle = ? then do:
     1443            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
     1444         end.
     1445         else do:
     1446            bh_tbl-name:find-first( v-where ) no-error .
     1447         end.
     1448         o-hn = bh_tbl-name.
     1449      end.
     1450   end procedure.
     1451   procedure gen-hn-keyr :
     1452     define input  parameter p-key-rec    as character no-undo.
     1453     define input  parameter p-key-handle as handle    no-undo .
     1454     define input  parameter p-db-name    as character no-undo .
     1455     define input  parameter p-tt-handle  as handle    no-undo .
     1456     define input  parameter p-stts-lock  as integer   no-undo .
     1457     define output parameter o-hn         as handle    no-undo.
     1458     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
     1459   end.
     1460   procedure gen-row-keyr :
     1461     define input  parameter p-key-rec    as character no-undo.
     1462     define input  parameter p-key-handle as handle    no-undo .
     1463     define input  parameter p-db-name    as character no-undo .
     1464     define input  parameter p-tt-handle  as handle    no-undo .
     1465     define input  parameter p-stts-lock  as integer   no-undo .
     1466     define output parameter p-tbl-row    as rowid     no-undo.
     1467     define output parameter p-tbl-name   as character no-undo.
     1468     define variable vHn as handle no-undo.
     1469       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
     1470       p-tbl-row = if vHn:available then vHn:rowid else ?.
     1471       p-tbl-name =  vHn:table.
     1472       delete object vHn no-error.
     1473     if p-tbl-row = ? then do:
     1474       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info1, p-tbl-name, p-key-rec ).
     1475     end.
     1476     else do:
     1477       return.
     1478     end.
     1479   end procedure.
     1480   procedure gen-key-fv :
     1481     define input  parameter p-key-rec    as character no-undo .
     1482     define output parameter p-field-list as character no-undo .
     1483     define output parameter p-value-list as character no-undo.
     1484     do
     1485     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1486     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1487     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1488     :
     1489       define variable v-full-tbl-name  as character no-undo .
     1490       define variable bh_tbl-name      as handle    no-undo .
     1491       define variable v-tbl-name       as character no-undo .
     1492       define variable v-field-num      as integer   no-undo .
     1493       define variable v-count-fld      as integer   no-undo .
     1494       define variable v-inform         as character no-undo .
     1495       define variable v-ind            as integer   no-undo .
     1496       define variable v-idx-field-qnty as integer   no-undo .
     1497       define variable v-delim-key      as character no-undo .
     1498       if p-key-rec = ?
     1499         or p-key-rec = "":U
     1500       then do:
     1501         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info1 ).
     1502       end.
     1503       assign
     1504         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     1505         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1506       .
     1507       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1508       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info1 ).
     1509       assign
     1510         v-inform = bh_tbl-name:index-information(1)
     1511         v-ind    = 2
     1512       .
     1513       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1514       on error undo, return error
     1515       :
     1516         assign
     1517           v-inform = bh_tbl-name:index-information( v-ind )
     1518           v-ind    = v-ind + 1
     1519         .
     1520       end.
     1521       if v-inform = ?
     1522         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1523         or entry( 3, v-inform, ",":U ) <> "1":U
     1524       then do:
     1525         delete object bh_tbl-name no-error.
     1526         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, v-tbl-name ).
     1527       end.
     1528       assign
     1529         v-idx-field-qnty = num-entries( v-inform ) - 4
     1530       .
     1531       if v-idx-field-qnty < 2 then do:
     1532         delete object bh_tbl-name no-error.
     1533         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, v-tbl-name ).
     1534       end.
     1535       assign
     1536         p-field-list = "":U
     1537         p-value-list = "":U
     1538         v-delim-key  = "":U
     1539         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     1540         v-count-fld  = 0
     1541       .
     1542       block_where:
     1543       do v-ind = 1 to v-idx-field-qnty by 2
     1544       on error undo, return error
     1545       :
     1546         assign
     1547           v-count-fld = v-count-fld + 1
     1548         .
     1549         if v-count-fld > v-field-num then do:
     1550           leave block_where.
     1551         end.
     1552         assign
     1553           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     1554           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     1555         .
     1556         if v-ind = 1 then do:
     1557           assign
     1558             v-delim-key = chr(3)
     1559           .
     1560         end.
     1561       end.
     1562       delete object bh_tbl-name.
     1563       if v-count-fld <> v-field-num then do:
     1564         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info1, v-tbl-name ).
     1565       end.
     1566     end.
     1567   end procedure.
     1568   procedure gen-key-field :
     1569     define input  parameter p-table      as character no-undo .
     1570     define output parameter p-field-list as character no-undo .
     1571     do
     1572     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1573     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1574     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1575     :
     1576       define variable v-full-tbl-name  as character no-undo .
     1577       define variable bh_tbl-name      as handle    no-undo .
     1578       define variable v-tbl-name       as character no-undo .
     1579       define variable v-field-num      as integer   no-undo .
     1580       define variable v-count-fld      as integer   no-undo .
     1581       define variable v-inform         as character no-undo .
     1582       define variable v-ind            as integer   no-undo .
     1583       define variable v-idx-field-qnty as integer   no-undo .
     1584       define variable v-delim-key      as character no-undo .
     1585       if p-table = ?
     1586         or p-table = "":U
     1587       then do:
     1588         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info1 ).
     1589       end.
     1590       assign
     1591         v-tbl-name      = p-table
     1592         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1593       .
     1594       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1595       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info1 ).
     1596       assign
     1597         v-inform = bh_tbl-name:index-information(1)
     1598         v-ind    = 2
     1599       .
     1600       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1601       on error undo, return error
     1602       :
     1603         assign
     1604           v-inform = bh_tbl-name:index-information( v-ind )
     1605           v-ind    = v-ind + 1
     1606         .
     1607       end.
     1608       if v-inform = ?
     1609         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1610         or entry( 3, v-inform, ",":U ) <> "1":U
     1611       then do:
     1612         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, v-tbl-name ).
     1613       end.
     1614       assign
     1615         v-idx-field-qnty = num-entries( v-inform ) - 4
     1616       .
     1617       if v-idx-field-qnty < 2 then do:
     1618         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, v-tbl-name ).
     1619       end.
     1620       assign
     1621         p-field-list = "":U
     1622         v-delim-key  = "":U
     1623         v-count-fld  = 0
     1624       .
     1625       block_where:
     1626       do v-ind = 1 to v-idx-field-qnty by 2
     1627       on error undo, return error
     1628       :
     1629         assign
     1630           v-count-fld = v-count-fld + 1
     1631         .
     1632         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     1633         if v-ind = 1 then do:
     1634           assign
     1635             v-delim-key = chr(3)
     1636           .
     1637         end.
     1638       end.
     1639       delete object bh_tbl-name.
     1640     end.
     1641   end procedure.
     1642   def var vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1643   define temp-table t-raw no-undo
     1644     field t-raw-field as raw
     1645   .
     1646   procedure cre-raw :
     1647     define input  parameter p-tbl-name   as character no-undo.
     1648     define input  parameter p-tbl-handle as handle    no-undo.
     1649     define output parameter p-raw        as raw       no-undo.
     1650     define variable bh_t-raw        as handle    no-undo .
     1651     define variable v-ok            as logical   no-undo .
     1652     define variable v-msg           as character no-undo .
     1653       define variable tth             as handle    no-undo .
     1654       define variable tt-name         as character no-undo .
     1655       define variable bh_tt           as handle    no-undo .
     1656     do
     1657     on error  undo, throw
     1658     :
     1659       create temp-table tth.
     1660       assign
     1661         tth:undo = false
     1662         tt-name  = "tt_" + p-tbl-handle:table
     1663       .
     1664       v-ok = tth:create-like( p-tbl-handle ) .
     1665       v-ok = tth:temp-table-prepare( tt-name ) .
     1666       bh_tt = tth:default-buffer-handle .
     1667       v-ok = bh_tt:buffer-create .
     1668       v-ok = bh_tt:buffer-copy( p-tbl-handle ) .
     1669       empty temp-table t-raw .
     1670       create t-raw.
     1671       bh_t-raw = buffer t-raw:handle .
     1672       v-ok =        bh_tt:raw-transfer ( true, bh_t-raw:buffer-field("t-raw-field":U) ) .
     1673       p-raw = t-raw.t-raw-field .
     1674     catch exAppErrors as class Progress.Lang.AppError :
     1675       v-msg = substitute( "&1 (cre-raw). raw-transfer не прошел для таблицы &2&3&4&3&5",
     1676         vss-include-info2,
     1677         p-tbl-name,
     1678         chr(10),
     1679         error-status:get-message (error-status:num-messages),
     1680         exAppErrors:CallStack
     1681       ) .
     1682       undo, throw new Progress.Lang.AppError(v-msg)  .
     1683     end catch .
     1684     catch exProErrors as class Progress.Lang.ProError :
     1685       undo, throw exProErrors .
     1686     end catch .
     1687     catch exAnyErrors as class Progress.Lang.Error:
     1688       undo, throw exAnyErrors .
     1689     end catch .
     1690     finally :
     1691       empty temp-table t-raw .
     1692       v-ok = tth:clear() no-error .
     1693       delete object tth.
     1694     end finally .
     1695     end.
     1696   end procedure.
     1697   procedure cre-raw-delta :
     1698     define input  parameter p-tbl-name       as character no-undo.
     1699     define input  parameter p-old-raw        as raw       no-undo.
     1700     define input  parameter p-new-buf-handle as handle    no-undo.
     1701     define output parameter p-raw            as raw       no-undo.
     1702     do
     1703     on error  undo, return error substitute( "&1 (cre-raw-delta). &2&3&4", vss-include-info2, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1704     on stop   undo, return error substitute( "&1 (cre-raw-delta). stop", vss-include-info2 )
     1705     on endkey undo, return error substitute( "&1 (cre-raw-delta). endkey", vss-include-info2 )
     1706     :
     1707       define variable tt-name         as character no-undo .
     1708       define variable tth             as handle    no-undo .
     1709       define variable bh-dlt_tt       as handle    no-undo .
     1710       define variable bh-old_tt       as handle    no-undo .
     1711       define variable bh_t-raw        as handle    no-undo .
     1712       define variable v-num-fields    as integer   no-undo .
     1713       define variable v-ind           as integer   no-undo .
     1714       define variable v-name-field    as character no-undo .
     1715       define variable v-fh-tt         as handle    no-undo .
     1716       define variable v-fh-old        as handle    no-undo .
     1717       define variable v-fh-new        as handle    no-undo .
     1718       define variable v-ok            as logical   no-undo .
     1719       if not p-new-buf-handle:available then do:
     1720         return error substitute( "&1 (cre-raw-delta). Переданый буфер с новым значением таблицы &2 не доступен", vss-include-info2, p-tbl-name ).
     1721       end.
     1722       if p-old-raw = ?
     1723       then do:
     1724         return error substitute( "&1 (cre-raw-delta). Переданый буфер со старым значением таблицы &2 не доступен", vss-include-info2, p-tbl-name ).
     1725       end.
     1726       create temp-table tth.
     1727       assign
     1728         tth:undo = false
     1729         tt-name  = "tt_" + p-tbl-name
     1730       .
     1731       assign
     1732         v-ok = tth:create-like( p-new-buf-handle ) no-error
     1733       .
     1734       if v-ok <> true then do:
     1735         return error substitute( "&1 (cre-raw-delta). Ошибка при создании временной таблицы &2 (1)", vss-include-info2, tt-name ) .
     1736       end.
     1737       assign
     1738         v-ok = tth:temp-table-prepare( tt-name ) no-error
     1739       .
     1740       if v-ok <> true then do:
     1741         return error substitute( "&1 (cre-raw-delta). Ошибка при создании временной таблицы &2 (2)", vss-include-info2, tt-name ) .
     1742       end.
     1743       assign
     1744         bh-dlt_tt = tth:default-buffer-handle
     1745       .
     1746       assign
     1747         v-ok = bh-dlt_tt:buffer-create no-error
     1748       .
     1749       if v-ok <> true then do:
     1750         return error substitute( "&1 (cre-raw-delta). Ошибка при создании буфера временной таблицы для новых значений.", vss-include-info2, p-tbl-name ).
     1751       end.
     1752       create buffer bh-old_tt for table tth.
     1753       assign
     1754         v-ok = bh-old_tt:buffer-create no-error
     1755       .
     1756       if v-ok <> true then do:
     1757         return error substitute( "&1 (cre-raw-delta). Ошибка при создании буфера временной таблицы для старых значений.", vss-include-info2, p-tbl-name ).
     1758       end.
     1759       create t-raw.
     1760       assign
     1761         t-raw.t-raw-field = p-old-raw
     1762         bh_t-raw          = buffer t-raw:handle
     1763       .
     1764       assign
     1765         v-ok = bh-old_tt:raw-transfer ( false, bh_t-raw:buffer-field("t-raw-field":U) ) no-error
     1766       .
     1767       delete t-raw.
     1768       if v-ok <> true then do:
     1769         return error substitute( "&1 (cre-raw-delta). raw-transfer не прошел для таблицы &2 со старыми значениями", vss-include-info2, p-tbl-name ).
     1770       end.
     1771       assign
     1772         v-num-fields = p-new-buf-handle:num-fields
     1773       .
     1774       do v-ind = 1 to v-num-fields
     1775       on error undo, return error substitute( "&1 (cre-raw-delta). &2", vss-include-info2, error-status :get-message ( 1 ) )
     1776       :
     1777         assign
     1778           v-fh-new     = p-new-buf-handle:buffer-field( v-ind )
     1779           v-name-field = v-fh-new:name
     1780           v-fh-old     = bh-old_tt:buffer-field( v-name-field )
     1781           v-fh-tt      = bh-dlt_tt:buffer-field( v-name-field )
     1782         .
     1783         if v-fh-new:buffer-value <> v-fh-old:buffer-value then do:
     1784           assign
     1785             bh-dlt_tt:buffer-field( v-name-field ):buffer-value = v-fh-new:buffer-value
     1786           .
     1787         end.
     1788       end.
     1789       create t-raw.
     1790       assign
     1791         bh_t-raw = buffer t-raw:handle
     1792       .
     1793       assign
     1794         v-ok = bh-dlt_tt:raw-transfer ( true, bh_t-raw:buffer-field("t-raw-field":U) ) no-error
     1795       .
     1796       assign
     1797         p-raw = t-raw.t-raw-field
     1798       .
     1799       delete t-raw.
     1800       if v-ok <> true then do:
     1801         return error substitute( "&1. raw-transfer не прошел для таблицы &2", vss-include-info2, p-tbl-name ).
     1802       end.
     1803       assign
     1804         v-ok = tth:clear() no-error
     1805       .
     1806       if v-ok <> true then do:
     1807         return error substitute( "&1. Ошибка при очистке временной таблицы &2", vss-include-info2, tt-name ) .
     1808       end.
     1809       delete object bh-old_tt no-error .
     1810       if error-status:error then do:
     1811         return error substitute( "&1. Ошибка при удалении ссылки на буфер временной таблицы &2", vss-include-info2, tt-name ).
     1812       end.
     1813       delete object tth no-error .
     1814       if error-status:error then do:
     1815         return error substitute( "&1. Ошибка при удалении временной таблицы для &2", vss-include-info2, tt-name ).
     1816       end.
     1817     end.
     1818   end procedure.
     1819   PROCEDURE cre-route-dump :
     1820     define input        parameter p-act-name   as character           no-undo .
     1821     define input        parameter p-tbl-name   as character           no-undo.
     1822     define input        parameter p-tbl-handle as handle              no-undo.
     1823     define input        parameter p-dmp-ord    like ub.route.dump-ord no-undo.
     1824     define input-output parameter p-rc-ord     as integer             no-undo.
     1825     do transaction
     1826     on error  undo, return error substitute( "&1 (cre-route-dump). &2&3&4", vss-include-info2, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1827     on stop   undo, return error substitute( "&1 (cre-route-dump). stop", vss-include-info2 )
     1828     on endkey undo, return error substitute( "&1 (cre-route-dump). endkey", vss-include-info2 )
     1829     :
     1830       define variable loc-key-rec like ub.route.uniq-key-rec   no-undo .
     1831       define variable v-value-rec like ub.route-dump.value-rec no-undo .
     1832       define variable bh_tbl-name  as handle    no-undo .
     1833       define variable fh_tbl-name  as handle    no-undo .
     1834       define variable v-ok         as logical   no-undo .
     1835       define buffer buf_sys-ctrl for ub.sys-ctrl .
     1836       if not p-tbl-handle:available then do:
     1837         return error substitute( "&1. Переданый буфер таблицы &2 не доступен", vss-include-info2, p-tbl-name ).
     1838       end.
     1839       assign
     1840         p-rc-ord = p-rc-ord + 1
     1841       .
     1842       run gen-key-rec in this-procedure
     1843         ( input p-tbl-name
     1844          ,input p-tbl-handle
     1845          ,output loc-key-rec
     1846         ) no-error.
     1847       if error-status :error then do:
     1848         return error substitute( "&1. Ошибка при генерации уникального ключа по таблице &2. &3"
     1849                                  ,vss-include-info2
     1850                                  ,p-tbl-name
     1851                                  ,return-value
     1852                                ).
     1853       end.
     1854       run cre-raw in this-procedure
     1855         ( input p-tbl-name
     1856          ,input p-tbl-handle
     1857          ,output v-value-rec
     1858         ) no-error.
     1859       if error-status :error then do:
     1860         return error substitute( "&1. Ошибка при сжатии записи по таблице &2. &3"
     1861                                  ,vss-include-info2
     1862                                  ,p-tbl-name
     1863                                  ,return-value
     1864                                ).
     1865       end.
     1866       case p-act-name :
     1867         when 'send-tbl':U then do:
     1868           create buffer bh_tbl-name for table "ub.route-dump":U .
     1869         end.
     1870         when 'send-tbl-oxml':U
     1871         then do:
     1872           create buffer bh_tbl-name for table "ub.esys-route-dump":U .
     1873         end.
     1874       end case.
     1875       assign
     1876         v-ok = bh_tbl-name:buffer-create no-error
     1877       .
     1878       if v-ok <> true
     1879         or error-status :error
     1880       then do:
     1881         return error substitute( "&1. Ошибка при создании буфера таблицы маршрутизации &2&3&4.", vss-include-info2, p-tbl-name, chr(10), error-status :get-message(1) ).
     1882       end.
     1883       case p-act-name :
     1884         when 'send-tbl':U then do:
     1885           assign
     1886             fh_tbl-name              = bh_tbl-name:buffer-field("dump-name":U)
     1887             fh_tbl-name:buffer-value = p-tbl-name
     1888           .
     1889           assign
     1890             fh_tbl-name              = bh_tbl-name:buffer-field("dump-ord":U)
     1891             fh_tbl-name:buffer-value = p-dmp-ord
     1892           .
     1893           assign
     1894             fh_tbl-name              = bh_tbl-name:buffer-field("rec-ord":U)
     1895             fh_tbl-name:buffer-value = p-rc-ord
     1896           .
     1897           assign
     1898             fh_tbl-name              = bh_tbl-name:buffer-field("uniq-key-rec":U)
     1899             fh_tbl-name:buffer-value = loc-key-rec
     1900           .
     1901           assign
     1902             fh_tbl-name              = bh_tbl-name:buffer-field("value-rec":U)
     1903             fh_tbl-name:buffer-value = v-value-rec
     1904           .
     1905   define variable vss-include-info3 as character format "X(65)":U no-undo initial "@(#)$Workfile$ $Revision$".
     1906   if (valid-handle(g#lib-nws) <> true) then do:   run nws/lib-nws.p persistent no-error .   if error-status :error or (valid-handle(g#lib-nws) <> true) then do:     message       "Error starting nws/lib-nws.p" skip       g#lib-nws skip       g#lib-nws :type skip       g#lib-nws :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-nws_route-dump-write in g#lib-nws
     1907     ( input p-tbl-name
     1908     , input bh_tbl-name
     1909     , input p-tbl-handle
     1910     , input p-dmp-ord
     1911     , input p-rc-ord
     1912     ) no-error .
     1913           if error-status :error then do:
     1914             return error substitute( "&1. &2&3&4", vss-include-info2, return-value, chr(10), error-status :get-message ( error-status :num-messages ) ).
     1915           end.
     1916         end.
     1917         when 'send-tbl-oxml':U
     1918         then do:
     1919           find first buf_sys-ctrl no-lock .
     1920           assign
     1921             fh_tbl-name              = bh_tbl-name:buffer-field("esrd-cr-db-num":U)
     1922             fh_tbl-name:buffer-value = buf_sys-ctrl.db-num
     1923             .
     1924           assign
     1925             fh_tbl-name              = bh_tbl-name:buffer-field("esrd-dump-name":U)
     1926             fh_tbl-name:buffer-value = p-tbl-name
     1927           .
     1928           assign
     1929             fh_tbl-name              = bh_tbl-name:buffer-field("esrd-dump-ord":U)
     1930             fh_tbl-name:buffer-value = p-dmp-ord
     1931           .
     1932           assign
     1933             fh_tbl-name              = bh_tbl-name:buffer-field("esrd-rec-ord":U)
     1934             fh_tbl-name:buffer-value = p-rc-ord
     1935           .
     1936           assign
     1937             fh_tbl-name              = bh_tbl-name:buffer-field("esrd-uniq-key-rec":U)
     1938             fh_tbl-name:buffer-value = loc-key-rec
     1939           .
     1940           assign
     1941             fh_tbl-name              = bh_tbl-name:buffer-field("esrd-value-rec":U)
     1942             fh_tbl-name:buffer-value = v-value-rec
     1943           .
     1944         end.
     1945       end case.
     1946       delete object bh_tbl-name.
     1947     end.
     1948   END PROCEDURE.
     1949   define variable vss-include-info4 as character format "X(65)":U no-undo initial "@(#)$Workfile$ $Revision$".
     1950   v-custom-except-list = v-custom-except-list-erprn.
     1951   PROCEDURE cre-dump-goods:
     1952     define input        parameter p-act-name   as character no-undo .
     1953     define input        parameter tbl-row      as   rowid                  no-undo.
     1954     define input        parameter dmp-ord      like ub.route-dump.dump-ord no-undo.
     1955     define input-output parameter rc-ord       like ub.route-dump.rec-ord  no-undo.
     1956     do transaction
     1957     on error  undo, return error substitute( "&1 (cre-dump-goods). &2&3&4", vss-include-info4, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1958     on stop   undo, return error substitute( "&1 (cre-dump-goods). stop", vss-include-info4 )
     1959     on endkey undo, return error substitute( "&1 (cre-dump-goods). endkey", vss-include-info4 )
     1960     :
     1961       define buffer buf_goods        for ub.goods.
     1962       define buffer buf_tax-rate-gds      for ub.tax-rate-gds.
     1963       define buffer buf_bar-code     for ub.bar-code.
     1964       define buffer buf_prod-bc      for ub.prod-bc.
     1965       define variable prod-bc-gl as logical no-undo .
     1966       find buf_goods where rowid( buf_goods ) = tbl-row.
     1967       if new(buf_goods) then do:
     1968         for each buf_tax-rate-gds where buf_tax-rate-gds.gds-code     = buf_goods.gds-code
     1969         on error undo, return error substitute( "&1. &2&3&4", vss-include-info4, return-value, chr(10), error-status :get-message ( error-status :num-messages ) ) :
     1970           run cre-route-dump( p-act-name, 'tax-rate-gds':U, (buffer buf_tax-rate-gds:handle), dmp-ord, input-output rc-ord ).
     1971         end.
     1972         for each buf_bar-code where buf_bar-code.unit-cli  = buf_goods.unit-base
     1973                               and buf_bar-code.gds-code  = buf_goods.gds-code
     1974                               and buf_bar-code.part-code = ""
     1975                               and buf_bar-code.in-code   = ""
     1976         on error undo, return error substitute( "&1. &2&3&4", vss-include-info4, return-value, chr(10), error-status :get-message ( error-status :num-messages ) ) :
     1977           run cre-route-dump( p-act-name, 'bar-code':U, (buffer buf_bar-code:handle), dmp-ord, input-output rc-ord ).
     1978           for each buf_prod-bc where buf_prod-bc.b-code = buf_bar-code.b-code
     1979           on error undo, return error substitute( "&1. &2&3&4", vss-include-info4, return-value, chr(10), error-status :get-message ( error-status :num-messages ) ) :
     1980   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1981   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prodbcat in g#library
     1982     (buffer buf_prod-bc
     1983     ,input  'global=request':u
     1984     ,output prod-bc-gl
     1985     ) no-error .
     1986             if error-status :error then do:
     1987               return error substitute( "&1. &2&3&4", vss-include-info4, return-value, chr(10), error-status :get-message ( error-status :num-messages ) ) .
     1988             end.
     1989             if prod-bc-gl then
     1990             do on error undo, return error substitute( "&1. &2&3&4", vss-include-info4, return-value, chr(10), error-status :get-message ( error-status :num-messages ) ) :
     1991               run cre-route-dump( p-act-name, 'prod-bc':U, (buffer buf_prod-bc:handle), dmp-ord, input-output rc-ord ).
     1992             end.
     1993           end.
     1994         end.
     1995       end.
     1996     end.
     1997   END PROCEDURE.
     1998   PROCEDURE cre-dump-price-doc:
     1999     define input        parameter p-act-name   as character no-undo .
     2000     define input        parameter tbl-row      as   rowid                  no-undo.
     2001     define input        parameter dmp-ord      like ub.route-dump.dump-ord no-undo.
     2002     define input-output parameter rc-ord       like ub.route-dump.rec-ord  no-undo.
     2003     do transaction
     2004     on error  undo, return error substitute( "&1 (cre-dump-price-doc). &2&3&4", vss-include-info4, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2005     on stop   undo, return error substitute( "&1 (cre-dump-price-doc). stop", vss-include-info4 )
     2006     on endkey undo, return error substitute( "&1 (cre-dump-price-doc). endkey", vss-include-info4 )
     2007     :
     2008       define buffer buf_price-doc  for ub.price-doc.
     2009       define buffer buf_price-list for ub.price-list.
     2010       define buffer buf_price-list-attr for ub.price-list-attr.
     2011       define buffer buf_doc-attr   for ub.doc-attr.
     2012       find buf_price-doc where rowid(buf_price-doc) = tbl-row.
     2013       for each buf_price-list where buf_price-list.doc-num = buf_price-doc.doc-num
     2014       on error undo, return error substitute( "&1. &2&3&4", vss-include-info4, return-value, chr(10), error-status :get-message ( error-status :num-messages ) ) :
     2015         run cre-route-dump(  p-act-name, 'price-list':U, (buffer buf_price-list:handle), dmp-ord, input-output rc-ord ).
     2016       end.
     2017       for each buf_doc-attr where buf_doc-attr.doc-code = buf_price-doc.doc-num
     2018       on error undo, return error substitute( "&1. &2&3&4", vss-include-info4, return-value, chr(10), error-status :get-message ( error-status :num-messages ) ) :
     2019         run cre-route-dump( p-act-name, 'doc-attr':U, (buffer buf_doc-attr:handle), dmp-ord, input-output rc-ord ).
     2020       end.
     2021       for each buf_price-list-attr where buf_price-list-attr.doc-num = buf_price-doc.doc-num
     2022       on error undo, return error substitute( "&1. &2&3&4", vss-include-info4, return-value, chr(10), error-status :get-message ( error-status :num-messages ) ) :
     2023         run cre-route-dump( p-act-name, 'price-list-attr':U, (buffer buf_price-list-attr:handle), dmp-ord, input-output rc-ord ).
     2024       end.
     2025     end.
     2026   END PROCEDURE.
     2027   PROCEDURE cre-dump-c-price-doc:
     2028     define input        parameter p-act-name   as character no-undo .
     2029     define input        parameter tbl-row      as   rowid                  no-undo.
     2030     define input        parameter dmp-ord      like ub.route-dump.dump-ord no-undo.
     2031     define input-output parameter rc-ord       like ub.route-dump.rec-ord  no-undo.
     2032     do transaction
     2033     on error  undo, return error substitute( "&1 (cre-dump-c-price-doc). &2&3&4", vss-include-info4, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2034     on stop   undo, return error substitute( "&1 (cre-dump-c-price-doc). stop", vss-include-info4 )
