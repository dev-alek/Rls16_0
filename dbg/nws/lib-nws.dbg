        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo initial "$Revision: aea5316774be, 0, rls $":U .
        3   define variable vss-author      as character no-undo initial "$Author: expertek $":U .
        4   define variable vss-date        as character no-undo initial "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        5   define variable vss-workfile    as character no-undo initial "$Workfile: lib-nws.p $":U .
        6   define variable vss-archive     as character no-undo initial "$Archive: nws/lib-nws.p $":U .
        7   define variable vss-description as character no-undo initial "Библиотека процедур для работы в СПН":U .
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define new global shared variable g#library  as handle no-undo .
       67   define new global shared variable g#library2 as handle no-undo .
       68   define   shared variable g#auto as logical no-undo.
       69   define   shared variable g#news as logical no-undo.
       70   define   shared variable g#oxml as logical no-undo.
       71   define   shared variable g#esys as logical no-undo.
       72   define   shared variable g#news-source-db as integer no-undo.
       73   define   shared variable g#esys-source-esys as integer no-undo.
       74   define   shared variable g#db-num as integer   no-undo .
       75   define   shared variable g#userid as character no-undo .
       76   define   shared variable g#passwd as character no-undo .
       77   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       78   define new global shared variable g#lib-nws as handle no-undo .
       79   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       80   procedure cur-time :
       81      define output parameter p-today as date      no-undo .
       82      define output parameter p-time  as integer   no-undo .
       83     do
       84     on error undo, return error
       85     :
       86       define variable v-date1 as date      no-undo .
       87       define variable v-date2 as date      no-undo .
       88       define variable v-time  as integer   no-undo .
       89       assign
       90         v-date1 = today
       91         v-time  = time
       92         v-date2 = today
       93       .
       94       if v-date1 <> v-date2
       95       then do:
       96         assign
       97           v-date1 = today
       98           v-time  = v-time
       99         .
      100       end.
      101       assign
      102         p-today = v-date1
      103         p-time  = v-time
      104       .
      105     end.
      106   end.
      107   function cur-time-date returns character
      108   :
      109     return string(today, '99/99/9999':U) .
      110   end.
      111   function cur-time-mjd returns decimal
      112   :
      113     define variable v-date as date      no-undo .
      114     define variable v-time as integer   no-undo .
      115     run cur-time in this-procedure
      116       (output v-date
      117       ,output v-time
      118       ) .
      119     return integer(v-date) - 2400002 + (v-time / 86400) .
      120   end.
      121   function cur-time-get-ending-index returns integer
      122   (input p-number as integer
      123   )
      124   :
      125     if p-number < 0
      126     or p-number = ?
      127     then do:
      128       return 1 .
      129     end.
      130     define variable v-rest as integer   no-undo .
      131     assign
      132       p-number = p-number modulo 100
      133     .
      134     if p-number < 20
      135     then do:
      136       assign
      137         v-rest = p-number
      138       .
      139     end.
      140     else do:
      141       assign
      142         v-rest = p-number modulo 10
      143       .
      144     end.
      145     case v-rest :
      146       when 1
      147       then do:
      148         return 2 .
      149       end.
      150       when 2 or
      151       when 3 or
      152       when 4
      153       then do:
      154         return 3 .
      155       end.
      156       otherwise do:
      157         return 1 .
      158       end.
      159     end case .
      160   end.
      161   procedure cur-time-mjd-to-date :
      162      define input  parameter i-mjd-diff as decimal no-undo.
      163      define output parameter o-Date     as date    no-undo.
      164      define output parameter o-Time     as integer no-undo.
      165      define variable v-day-number as integer   no-undo .
      166      if    i-mjd-diff < 0
      167         or i-mjd-diff = ?
      168      then do:
      169         return "?" .
      170      end.
      171      assign
      172         v-day-number = truncate(i-mjd-diff,0).
      173         o-Date = date(v-day-number + 2400002).
      174         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      175     .
      176   end.
      177   function cur-time-mjd-to-string returns character
      178   (input p-mjd-diff as decimal
      179   )
      180   :
      181     define variable v-day-number as integer   no-undo .
      182     define variable v-seconds    as integer   no-undo .
      183     define variable v-hour       as integer   no-undo .
      184     define variable v-min        as integer   no-undo .
      185     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      186     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      187     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      188     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      189     if p-mjd-diff < 0
      190     or p-mjd-diff = ?
      191     then do:
      192       return "?" .
      193     end.
      194     assign
      195       v-day-number = integer(truncate(p-mjd-diff,0))
      196       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      197     .
      198     if v-seconds > 86400
      199     then do:
      200       assign
      201         v-seconds = 86400 - 1
      202       .
      203     end.
      204     if v-seconds < 0
      205     then do:
      206       assign
      207         v-seconds = 0
      208       .
      209     end.
      210     assign
      211       v-hour = truncate(v-seconds / 3600, 0)
      212     .
      213     assign
      214       v-seconds = v-seconds modulo 3600
      215     .
      216     assign
      217       v-min = truncate(v-seconds / 60, 0)
      218     .
      219     assign
      220       v-seconds = v-seconds modulo 60
      221     .
      222     return
      223         (if v-day-number <> 0
      224           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      225           else ""
      226         )
      227       + (if v-day-number <> 0 or v-hour <> 0
      228           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      229           else ""
      230         )
      231       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      232           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      233           else ""
      234         )
      235       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      236       .
      237   end.
      238   function cur-time-string returns character
      239   :
      240     define variable v-date as date      no-undo .
      241     define variable v-time as integer   no-undo .
      242     run cur-time in this-procedure
      243       (output v-date
      244       ,output v-time
      245       ) .
      246     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      247   end.
      248   function cur-time-string-sec returns character
      249   :
      250     define variable v-date as date      no-undo .
      251     define variable v-time as integer   no-undo .
      252     run cur-time in this-procedure
      253       (output v-date
      254       ,output v-time
      255       ) .
      256     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      257   end.
      258   function cur-time-custom  returns character
      259   (input p-prefix as character
      260   ,input p-date-format as character
      261   ,input p-delimiter as character
      262   ,input p-time-format as character
      263   ,input p-suffix as character
      264   )
      265   :
      266     define variable v-date as date      no-undo .
      267     define variable v-time as integer   no-undo .
      268     run cur-time in this-procedure
      269       (output v-date
      270       ,output v-time
      271       ) .
      272     return
      273       p-prefix
      274       + string(v-date, p-date-format)
      275       + p-delimiter
      276       + string(v-time, p-time-format)
      277       + p-suffix
      278       .
      279   end.
      280   function cur-time-print  returns character
      281   :
      282     define variable v-date as date      no-undo .
      283     define variable v-time as integer   no-undo .
      284     run cur-time in this-procedure
      285       (output v-date
      286       ,output v-time
      287       ) .
      288     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      289   end.
      290   function cur-time-datetime returns datetime
      291   :
      292     define variable v-char as character no-undo .
      293     define variable v-datetime as datetime no-undo .
      294     v-char = cur-time-string().
      295     v-datetime = datetime(v-char).
      296     return  v-datetime.
      297   end.
      298   function cur-time-string-msec returns character
      299   :
      300     define variable v-date as datetime  no-undo .
      301     v-date = now.
      302     return string(v-date) .
      303   end.
      304   define variable vss-include-info2 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      305   function usrnickf returns character ( input p-user-id as character):
      306      define variable v-nick      as character    no-undo.
      307      if p-user-id = ?
      308      OR p-user-id = "":U
      309      then do:
      310         return '':U .
      311      end.
      312   define variable vss-include-info3 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      313   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usrnick in g#library
      314     (input  p-user-id
      315     ,output v-nick
      316     ) no-error .
      317      if error-status :error
      318      then do:
      319         return p-user-id.
      320      end.
      321      else do:
      322         return v-nick.
      323      end.
      324   end function.
      325   def var vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      326   procedure gen-key-rec :
      327     define input  parameter p-tbl-name    as character no-undo.
      328     define input  parameter p-bh_tbl-name as handle    no-undo.
      329     define output parameter p-key-rec     as character no-undo.
      330     do
      331     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      332     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      333     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      334     :
      335       define variable fh               as handle    no-undo .
      336       define variable v-ok             as logical   no-undo .
      337       define variable v-inform         as character no-undo .
      338       define variable v-ind            as integer   no-undo .
      339       define variable v-idx-field-qnty as integer   no-undo .
      340       if p-tbl-name = ?
      341         or p-tbl-name = "":U
      342       then do:
      343         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info4 ).
      344       end.
      345       if not p-bh_tbl-name:available then do:
      346         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info4, p-tbl-name ).
      347       end.
      348       assign
      349         p-key-rec = p-tbl-name
      350         v-inform  = p-bh_tbl-name:index-information(1)
      351         v-ind     = 2
      352       .
      353       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      354       on error undo, return error
      355       :
      356         assign
      357           v-inform = p-bh_tbl-name:index-information( v-ind )
      358           v-ind    = v-ind + 1
      359         .
      360       end.
      361       if v-inform = ?
      362         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      363         or entry( 3, v-inform, ",":U ) <> "1":U
      364       then do:
      365         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info4, p-tbl-name ).
      366       end.
      367       else do:
      368         assign
      369           v-idx-field-qnty = num-entries( v-inform ) - 4
      370         .
      371         if v-idx-field-qnty < 2 then do:
      372           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info4, v-inform, p-tbl-name ).
      373         end.
      374         do v-ind = 1 to v-idx-field-qnty by 2
      375         on error undo, return error
      376         :
      377           assign
      378             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      379             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      380           .
      381         end.
      382       end.
      383       if p-key-rec = ? then do:
      384         assign
      385           p-key-rec = "":U
      386         .
      387         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info4, p-tbl-name ).
      388       end.
      389     end.
      390     return.
      391   end procedure.
      392   procedure gen-where-keyr-tab :
      393     define input  parameter i-tableSerach as character no-undo.
      394     define input  parameter i-tablekey   as character  no-undo.
      395     define input  parameter p-key-rec    as character  no-undo.
      396     define input  parameter p-key-handle as handle     no-undo .
      397     define input  parameter p-db-name    as character  no-undo .
      398     define input  parameter p-tt-handle  as handle     no-undo .
      399     define output parameter o-Where      as character  no-undo.
      400     do
      401     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      402     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      403     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      404     :
      405       define variable v-full-tbl-name  as character no-undo .
      406       define variable bh_tbl-name      as handle    no-undo .
      407       define variable fh_key           as handle    no-undo .
      408       define variable fh_search        as handle    no-undo .
      409       define variable v-field-num      as integer   no-undo .
      410       define variable v-count-fld      as integer   no-undo .
      411       define variable v-inform         as character no-undo .
      412       define variable v-ind            as integer   no-undo .
      413       define variable v-idx-field-qnty as integer   no-undo .
      414       define variable v-field-name     as character no-undo .
      415       define variable v-field-val      as character no-undo .
      416       define variable v-word-link      as character no-undo .
      417       define variable vTable           as character no-undo.
      418       define variable bh_tbl-key       as handle    no-undo .
      419       assign
      420         p-key-rec = trim( p-key-rec )
      421       .
      422       if p-key-handle <> ? then do:
      423         if not valid-handle(p-key-handle)
      424            or p-key-handle:type <> "buffer"
      425         then do:
      426           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info4 ).
      427         end.
      428         if num-entries( p-key-rec, chr(3) ) > 1
      429           or p-key-rec = ?
      430           or p-key-rec = "":U
      431         then do:
      432           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info4, p-key-rec ).
      433         end.
      434       end.
      435       else do:
      436         if p-key-rec = ?
      437           or p-key-rec = "":U
      438         then do:
      439           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info4 ).
      440         end.
      441       end.
      442       assign
      443         vTable = entry( 1 , p-key-rec, chr(3) )
      444       .
      445       if p-tt-handle <> ?
      446         and ( not valid-handle(p-tt-handle)
      447               or p-tt-handle:type <> "buffer"
      448             )
      449       then do:
      450         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info4, vTable, chr(10) ).
      451       end.
      452       if p-tt-handle = ? then do:
      453         assign
      454           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      455         .
      456         create buffer bh_tbl-name for table v-full-tbl-name .
      457       end.
      458       else do:
      459         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      460       end.
      461       assign
      462         v-inform = bh_tbl-name:index-information(1)
      463         v-ind    = 2
      464       .
      465       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      466       on error undo, return error
      467       :
      468         assign
      469           v-inform = bh_tbl-name:index-information( v-ind )
      470           v-ind    = v-ind + 1
      471         .
      472       end.
      473       if v-inform = ?
      474         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      475         or entry( 3, v-inform, ",":U ) <> "1":U
      476       then do:
      477         delete object bh_tbl-name no-error.
      478         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info4, vTable ).
      479       end.
      480       assign
      481         v-idx-field-qnty = num-entries( v-inform ) - 4
      482       .
      483       if v-idx-field-qnty < 2 then do:
      484         delete object bh_tbl-name no-error.
      485         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info4, v-inform, vTable ).
      486       end.
      487       assign
      488         o-where     = "where":U
      489         v-word-link = "":U
      490         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      491         v-count-fld = 0
      492       .
      493       if i-tablekey ne "" and i-tablekey ne ?
      494       then do:
      495         assign
      496           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      497         .
      498         create buffer bh_tbl-key for table v-full-tbl-name .
      499       end.
      500       if i-tableSerach ne "" and i-tableSerach ne ?
      501       then do:
      502         delete object bh_tbl-name no-error.
      503         assign
      504           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      505         .
      506         create buffer bh_tbl-name for table v-full-tbl-name .
      507       end.
      508       block_where:
      509       do v-ind = 1 to v-idx-field-qnty by 2
      510       on error undo, return error
      511       :
      512         assign
      513           v-count-fld = v-count-fld + 1
      514         .
      515         if p-key-handle = ?
      516           and v-count-fld > v-field-num
      517         then do:
      518           leave block_where.
      519         end.
      520         define variable VfieldKeyTable as handle no-undo.
      521         assign
      522           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      523           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      524         .
      525         if     bh_tbl-key ne ?
      526         then do:
      527            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      528            if VfieldKeyTable eq ?
      529            then next block_where.
      530         end.
      531         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      532         then
      533            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      534         else
      535            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      536         if p-key-handle = ? then do:
      537           assign
      538             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      539           .
      540         end.
      541         else do:
      542           assign
      543             fh_key = p-key-handle:buffer-field( v-field-name )
      544           .
      545           if fh_key = ?
      546             or not valid-handle( fh_key )
      547           then do:
      548             delete object bh_tbl-name.
      549             if     bh_tbl-key ne ?
      550             then
      551                delete object bh_tbl-key.
      552             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info4, p-key-handle:name, v-field-name ).
      553           end.
      554           assign
      555             v-field-val = fh_key:buffer-value
      556           .
      557         end.
      558         if fh_search:data-type ="character":U then do:
      559           assign
      560             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      561             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      562             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      563             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      564             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      565             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      566             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      567             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      568             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      569             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      570             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      571             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      572             v-field-val = substitute( '"&1"', v-field-val )
      573           .
      574         end.
      575         assign
      576           o-where = substitute( "&1 &2", o-where, v-field-val )
      577         .
      578         if v-word-link = "":U then do:
      579           assign
      580             v-word-link = "and":U
      581           .
      582         end.
      583       end.
      584       delete object bh_tbl-name.
      585       if     bh_tbl-key ne ?
      586       then
      587          delete object bh_tbl-key.
      588       if p-key-handle = ?
      589         and v-count-fld <> v-field-num
      590       then do:
      591         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info4, vTable ).
      592       end.
      593     end.
      594   end procedure.
      595   procedure gen-hn-keyr-tab :
      596     define input  parameter i-tableSerach as character no-undo.
      597     define input  parameter i-tablekey   as character no-undo.
      598     define input  parameter p-key-rec    as character no-undo.
      599     define input  parameter p-key-handle as handle    no-undo .
      600     define input  parameter p-db-name    as character no-undo .
      601     define input  parameter p-tt-handle  as handle    no-undo .
      602     define input  parameter p-stts-lock  as integer   no-undo .
      603     define output parameter o-hn         as handle    no-undo.
      604     define variable v-full-tbl-name as character no-undo.
      605     define variable v-where         as character no-undo.
      606     define variable bh_tbl-name     as handle    no-undo.
      607     define variable vTable          as character no-undo.
      608     do
      609     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      610     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      611     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      612         run gen-where-keyr-tab(i-tableSerach,
      613                                i-tablekey,
      614                                p-key-rec,
      615                                p-key-handle,
      616                                p-db-name,
      617                                p-tt-handle,
      618                                output v-where).
      619         if i-tableSerach ne "" and i-tableSerach ne ?
      620         then do:
      621            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      622            create buffer bh_tbl-name for table v-full-tbl-name .
      623         end.
      624         else do:
      625            if p-tt-handle = ? then do:
      626               assign
      627                  vTable = entry( 1 , p-key-rec, chr(3) )
      628               .
      629               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      630               create buffer bh_tbl-name for table v-full-tbl-name .
      631            end.
      632            else do:
      633               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      634            end.
      635         end.
      636         if p-tt-handle = ? then do:
      637            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      638         end.
      639         else do:
      640            bh_tbl-name:find-first( v-where ) no-error .
      641         end.
      642         o-hn = bh_tbl-name.
      643      end.
      644   end procedure.
      645   procedure gen-hn-keyr :
      646     define input  parameter p-key-rec    as character no-undo.
      647     define input  parameter p-key-handle as handle    no-undo .
      648     define input  parameter p-db-name    as character no-undo .
      649     define input  parameter p-tt-handle  as handle    no-undo .
      650     define input  parameter p-stts-lock  as integer   no-undo .
      651     define output parameter o-hn         as handle    no-undo.
      652     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      653   end.
      654   procedure gen-row-keyr :
      655     define input  parameter p-key-rec    as character no-undo.
      656     define input  parameter p-key-handle as handle    no-undo .
      657     define input  parameter p-db-name    as character no-undo .
      658     define input  parameter p-tt-handle  as handle    no-undo .
      659     define input  parameter p-stts-lock  as integer   no-undo .
      660     define output parameter p-tbl-row    as rowid     no-undo.
      661     define output parameter p-tbl-name   as character no-undo.
      662     define variable vHn as handle no-undo.
      663       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      664       p-tbl-row = if vHn:available then vHn:rowid else ?.
      665       p-tbl-name =  vHn:table.
      666       delete object vHn no-error.
      667     if p-tbl-row = ? then do:
      668       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info4, p-tbl-name, p-key-rec ).
      669     end.
      670     else do:
      671       return.
      672     end.
      673   end procedure.
      674   procedure gen-key-fv :
      675     define input  parameter p-key-rec    as character no-undo .
      676     define output parameter p-field-list as character no-undo .
      677     define output parameter p-value-list as character no-undo.
      678     do
      679     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      680     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      681     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      682     :
      683       define variable v-full-tbl-name  as character no-undo .
      684       define variable bh_tbl-name      as handle    no-undo .
      685       define variable v-tbl-name       as character no-undo .
      686       define variable v-field-num      as integer   no-undo .
      687       define variable v-count-fld      as integer   no-undo .
      688       define variable v-inform         as character no-undo .
      689       define variable v-ind            as integer   no-undo .
      690       define variable v-idx-field-qnty as integer   no-undo .
      691       define variable v-delim-key      as character no-undo .
      692       if p-key-rec = ?
      693         or p-key-rec = "":U
      694       then do:
      695         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info4 ).
      696       end.
      697       assign
      698         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      699         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      700       .
      701       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      702       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info4 ).
      703       assign
      704         v-inform = bh_tbl-name:index-information(1)
      705         v-ind    = 2
      706       .
      707       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      708       on error undo, return error
      709       :
      710         assign
      711           v-inform = bh_tbl-name:index-information( v-ind )
      712           v-ind    = v-ind + 1
      713         .
      714       end.
      715       if v-inform = ?
      716         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      717         or entry( 3, v-inform, ",":U ) <> "1":U
      718       then do:
      719         delete object bh_tbl-name no-error.
      720         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info4, v-tbl-name ).
      721       end.
      722       assign
      723         v-idx-field-qnty = num-entries( v-inform ) - 4
      724       .
      725       if v-idx-field-qnty < 2 then do:
      726         delete object bh_tbl-name no-error.
      727         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info4, v-inform, v-tbl-name ).
      728       end.
      729       assign
      730         p-field-list = "":U
      731         p-value-list = "":U
      732         v-delim-key  = "":U
      733         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      734         v-count-fld  = 0
      735       .
      736       block_where:
      737       do v-ind = 1 to v-idx-field-qnty by 2
      738       on error undo, return error
      739       :
      740         assign
      741           v-count-fld = v-count-fld + 1
      742         .
      743         if v-count-fld > v-field-num then do:
      744           leave block_where.
      745         end.
      746         assign
      747           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      748           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      749         .
      750         if v-ind = 1 then do:
      751           assign
      752             v-delim-key = chr(3)
      753           .
      754         end.
      755       end.
      756       delete object bh_tbl-name.
      757       if v-count-fld <> v-field-num then do:
      758         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info4, v-tbl-name ).
      759       end.
      760     end.
      761   end procedure.
      762   procedure gen-key-field :
      763     define input  parameter p-table      as character no-undo .
      764     define output parameter p-field-list as character no-undo .
      765     do
      766     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      767     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      768     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      769     :
      770       define variable v-full-tbl-name  as character no-undo .
      771       define variable bh_tbl-name      as handle    no-undo .
      772       define variable v-tbl-name       as character no-undo .
      773       define variable v-field-num      as integer   no-undo .
      774       define variable v-count-fld      as integer   no-undo .
      775       define variable v-inform         as character no-undo .
      776       define variable v-ind            as integer   no-undo .
      777       define variable v-idx-field-qnty as integer   no-undo .
      778       define variable v-delim-key      as character no-undo .
      779       if p-table = ?
      780         or p-table = "":U
      781       then do:
      782         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info4 ).
      783       end.
      784       assign
      785         v-tbl-name      = p-table
      786         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      787       .
      788       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      789       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info4 ).
      790       assign
      791         v-inform = bh_tbl-name:index-information(1)
      792         v-ind    = 2
      793       .
      794       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      795       on error undo, return error
      796       :
      797         assign
      798           v-inform = bh_tbl-name:index-information( v-ind )
      799           v-ind    = v-ind + 1
      800         .
      801       end.
      802       if v-inform = ?
      803         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      804         or entry( 3, v-inform, ",":U ) <> "1":U
      805       then do:
      806         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info4, v-tbl-name ).
      807       end.
      808       assign
      809         v-idx-field-qnty = num-entries( v-inform ) - 4
      810       .
      811       if v-idx-field-qnty < 2 then do:
      812         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info4, v-inform, v-tbl-name ).
      813       end.
      814       assign
      815         p-field-list = "":U
      816         v-delim-key  = "":U
      817         v-count-fld  = 0
      818       .
      819       block_where:
      820       do v-ind = 1 to v-idx-field-qnty by 2
      821       on error undo, return error
      822       :
      823         assign
      824           v-count-fld = v-count-fld + 1
      825         .
      826         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      827         if v-ind = 1 then do:
      828           assign
      829             v-delim-key = chr(3)
      830           .
      831         end.
      832       end.
      833       delete object bh_tbl-name.
      834     end.
      835   end procedure.
      836   define variable vss-include-info5 as character no-undo format "x(65)":U initial "@(#)$Workfile$ $Revision$":U.
      837   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      838   procedure valid-ren-art-tbl-list :
      839     do
      840     on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      841     on stop   undo, return error substitute( "&1. stop", vss-workfile )
      842     on endkey undo, return error substitute( "&1. endkey", vss-workfile )
      843     :
      844       define variable v-std-list        as character no-undo .
      845       define variable v-ignore-list     as character no-undo .
      846       define variable v-special-list    as character no-undo .
      847       assign
      848         v-std-list     = "cli-gds,cli-gds-attr,cli-art,cli-art-attr,contract-specif,c-contract-specif,doc-line,c-doc-line,fbr-line,c-fbr-line,fbr-recipe,fbr-recipe-gds,fbr-pln-line,c-fbr-pln-line,gds-dtl,c-gds-dtl,gds-dtl-attr,c-gds-dtl-attr,gds-obj,inv-line,inv-line-attr,c-inv-line,ot-supp-line,ot-supp-line-attr,ot-line-attr,ord-line,c-ord-line,ord-line-rcv,ord-dtl,c-ord-dtl,ord-dtl-attr,ord-dtl-rcv,ord-dtl-cons,ord-gds-cons,prt-obj,prt-obj-attr,parts,c-parts,parts-supp,parts-supp-attr,price-list,c-price-list,price-doc-forming-gds,c-price-doc-forming-gds,price-doc-forming-gds-qnty,c-price-doc-forming-gds-qnty,price-doc-forming-gds-sum,c-price-doc-forming-gds-sum,price-doc-forming-gds-tnv,c-price-doc-forming-gds-tnv,recipe,recipe-gds,c-recipe,c-recipe-gds,c-recipe-hist,stk-supp-line,stk-supp-line-attr,stk-line-attr,tmp-sale-dtl,tmp-sale-dtl-attr,tmp-sale-gds,tmp-sale-gds-attr":U
      849         v-ignore-list  = "c-goods,c-order-line":U
      850         v-special-list = "goods,ot-line,stk-line,order-line":U
      851       .
      852   def var vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      853       define variable v-ind         as integer   no-undo .
      854       define variable v-num-entries as integer   no-undo .
      855       define variable v-inform      as character no-undo .
      856       define variable bh_tbl-name   as handle    no-undo .
      857       define variable v-tbl-not-idx as character no-undo .
      858       define variable v-idx-avail   as logical   no-undo .
      859       define variable new-tbl-list  as character no-undo .
      860       define variable old-tbl-list  as character no-undo .
      861       define variable old-tbl-avail as logical   no-undo .
      862       define variable v-double-tbl  as character no-undo .
      863       define variable v-tbl-name    as character no-undo .
      864       define variable v-msg         as character no-undo .
      865       assign
      866         v-msg         = "":U
      867         v-tbl-not-idx = "":U
      868         new-tbl-list  = "":U
      869       .
      870       for each ub._Field no-lock
      871         where ub._Field._Field-Name = 'artic':U
      872       ,first ub._File of ub._Field
      873       on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      874       :
      875         if  lookup( ub._File._File-Name, v-std-list     ) = 0
      876         and lookup( ub._File._File-Name, v-ignore-list  ) = 0
      877         and lookup( ub._File._File-Name, v-special-list ) = 0
      878         then do:
      879           assign
      880             new-tbl-list = new-tbl-list + chr(10) + ub._File._File-Name
      881           .
      882         end.
      883         if lookup( ub._File._File-Name, v-std-list ) <> 0
      884           or lookup( ub._File._File-Name, new-tbl-list, chr(10) ) <> 0
      885         then do:
      886           create buffer bh_tbl-name for table substitute( "ub.&1":U, ub._File._File-Name ) .
      887           assign
      888             v-idx-avail = false
      889             v-inform    = bh_tbl-name:index-information(1)
      890             v-ind       = 2
      891           .
      892           block_chk-idx:
      893           do while v-inform <> ?
      894           on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      895           :
      896             if v-inform <> ?
      897                 and lookup( entry( 5, v-inform, ",":U ), "artic,prod-type,prod-code":U ) > 0
      898                 and lookup( entry( 7, v-inform, ",":U ), "artic,prod-type,prod-code":U ) > 0
      899                 and lookup( entry( 9, v-inform, ",":U ), "artic,prod-type,prod-code":U ) > 0
      900             then do:
      901               assign
      902                 v-idx-avail = true
      903               .
      904               leave block_chk-idx.
      905             end.
      906             assign
      907               v-inform = bh_tbl-name:index-information( v-ind )
      908               v-ind    = v-ind + 1
      909             .
      910           end.
      911           if v-idx-avail = false then do:
      912             if lookup( ub._File._File-Name, new-tbl-list, chr(10) ) <> 0 then do:
      913               assign
      914                 new-tbl-list = new-tbl-list + " (индекса нет)"
      915               .
      916             end.
      917             else do:
      918               assign
      919                 v-tbl-not-idx = v-tbl-not-idx + chr(10) + ub._File._File-Name
      920               .
      921             end.
      922           end.
      923           delete object bh_tbl-name.
      924         end.
      925       end.
      926       assign
      927         old-tbl-list  = "":U
      928         v-double-tbl  = "":U
      929         v-num-entries = num-entries( v-std-list )
      930       .
      931       do v-ind = 1 to v-num-entries
      932       on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      933       :
      934         assign
      935           v-tbl-name    = entry( v-ind, v-std-list )
      936           old-tbl-avail = false
      937         .
      938         find first ub._File no-lock
      939           where ub._File._File-Name = v-tbl-name
      940           no-error .
      941         if not available ub._File then do:
      942           assign
      943             old-tbl-avail = true
      944           .
      945         end.
      946         else do:
      947           find first ub._Field no-lock
      948             where ub._Field._File-recid = recid( ub._File )
      949               and ub._Field._Field-Name = 'artic':U
      950             no-error .
      951           if not available ub._Field then do:
      952             assign
      953               old-tbl-avail = true
      954             .
      955           end.
      956             find first ub._Field no-lock
      957               where ub._Field._File-recid = recid( ub._File )
      958                 and ub._Field._Field-Name = "prod-type"
      959               no-error .
      960             if not available ub._Field then do:
      961               assign
      962                 old-tbl-avail = true
      963               .
      964             end.
      965             find first ub._Field no-lock
      966               where ub._Field._File-recid = recid( ub._File )
      967                 and ub._Field._Field-Name = "prod-code"
      968               no-error .
      969             if not available ub._Field then do:
      970               assign
      971                 old-tbl-avail = true
      972               .
      973             end.
      974         end.
      975         if old-tbl-avail = true then do:
      976           assign
      977             old-tbl-list = old-tbl-list + chr(10) + v-tbl-name
      978           .
      979         end.
      980         if ( lookup( v-tbl-name, v-std-list ) > v-ind
      981              or lookup( v-tbl-name, v-ignore-list ) > 0
      982              or lookup( v-tbl-name, v-special-list ) > 0
      983            )
      984           and lookup( v-tbl-name, v-double-tbl, chr(10) ) = 0
      985         then do:
      986           assign
      987             v-double-tbl = v-double-tbl + chr(10) + v-tbl-name
      988           .
      989         end.
      990       end.
      991       assign
      992         v-num-entries = num-entries( v-ignore-list )
      993       .
      994       do v-ind = 1 to v-num-entries
      995       on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      996       :
      997         assign
      998           v-tbl-name = entry( v-ind, v-ignore-list )
      999           old-tbl-avail = false
     1000         .
     1001         find first ub._File no-lock
     1002           where ub._File._File-Name = v-tbl-name
     1003           no-error .
     1004         if not available ub._File then do:
     1005           assign
     1006             old-tbl-avail = true
     1007           .
     1008         end.
     1009         else do:
     1010           find first ub._Field no-lock
     1011             where ub._Field._File-recid = recid( ub._File )
     1012               and ub._Field._Field-Name = 'artic':U
     1013             no-error .
     1014           if not available ub._Field then do:
     1015             assign
     1016               old-tbl-avail = true
     1017             .
     1018           end.
     1019             find first ub._Field no-lock
     1020               where ub._Field._File-recid = recid( ub._File )
     1021                 and ub._Field._Field-Name = "prod-type"
     1022               no-error .
     1023             if not available ub._Field then do:
     1024               assign
     1025                 old-tbl-avail = true
     1026               .
     1027             end.
     1028             find first ub._Field no-lock
     1029               where ub._Field._File-recid = recid( ub._File )
     1030                 and ub._Field._Field-Name = "prod-code"
     1031               no-error .
     1032             if not available ub._Field then do:
     1033               assign
     1034                 old-tbl-avail = true
     1035               .
     1036             end.
     1037         end.
     1038         if old-tbl-avail = true then do:
     1039           assign
     1040             old-tbl-list = old-tbl-list + chr(10) + v-tbl-name
     1041           .
     1042         end.
     1043         if ( lookup( v-tbl-name, v-std-list ) > 0
     1044              or lookup( v-tbl-name, v-ignore-list ) > v-ind
     1045              or lookup( v-tbl-name, v-special-list ) > 0
     1046            )
     1047           and lookup( v-tbl-name, v-double-tbl, chr(10) ) = 0
     1048         then do:
     1049           assign
     1050             v-double-tbl = v-double-tbl + chr(10) + v-tbl-name
     1051           .
     1052         end.
     1053       end.
     1054       assign
     1055         v-num-entries = num-entries( v-special-list )
     1056       .
     1057       do v-ind = 1 to v-num-entries
     1058       on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1059       :
     1060         assign
     1061           v-tbl-name = entry( v-ind, v-special-list )
     1062         .
     1063         find first ub._File no-lock
     1064           where ub._File._File-Name = v-tbl-name
     1065           no-error .
     1066         if available ub._File then do:
     1067           find first ub._Field no-lock
     1068             where ub._Field._File-recid = recid( ub._File )
     1069               and ub._Field._Field-Name = 'artic':U
     1070             no-error .
     1071         end.
     1072         if not available ub._File
     1073           or ( available ub._File
     1074                and not available ub._Field
     1075              )
     1076         then do:
     1077           assign
     1078             old-tbl-list = old-tbl-list + chr(10) + v-tbl-name
     1079           .
     1080         end.
     1081         if ( lookup( v-tbl-name, v-std-list ) > 0
     1082              or lookup( v-tbl-name, v-ignore-list ) > 0
     1083              or lookup( v-tbl-name, v-special-list ) > v-ind
     1084            )
     1085           and lookup( v-tbl-name, v-double-tbl, chr(10) ) = 0
     1086         then do:
     1087           assign
     1088             v-double-tbl = v-double-tbl + chr(10) + v-tbl-name
     1089           .
     1090         end.
     1091       end.
     1092       if v-tbl-not-idx <> "" then do:
     1093         assign
     1094           v-msg = v-msg + substitute( "Таблицы не имеют индекса с полями &3 на первом месте и нет спецобработки: &2&1&1", chr(10), v-tbl-not-idx, 'artic, prod-type, prod-code':U )
     1095         .
     1096       end.
     1097       if new-tbl-list <> "":U then do:
     1098         assign
     1099           v-msg = v-msg + substitute( "Нет обработки таблиц: &2&1&1", chr(10), new-tbl-list )
     1100         .
     1101       end.
     1102       if v-double-tbl <> "":U then do:
     1103         assign
     1104           v-msg = v-msg + substitute( "В списках есть задублированные таблицы: &2&1&1", chr(10), v-double-tbl )
     1105         .
     1106       end.
     1107       if old-tbl-list <> "":U then do:
     1108         assign
     1109           v-msg = v-msg + substitute( "В списках есть несуществующие таблицы или таблицы в которых отсутствуют переименовываемые поля: &2&1&1", chr(10), old-tbl-list )
     1110         .
     1111       end.
     1112       if v-msg <> "":U then do:
     1113         return error substitute( "Утилита переименования &3 не корректна.&1&1&2", chr(10), v-msg, 'artic, prod-type, prod-code':U ) .
     1114       end.
     1115     end.
     1116   end procedure.
     1117   procedure check-use-artic :
     1118     define input  parameter p-tbl-name  as   character                      no-undo .
     1119     define input  parameter p-artic     like ub.goods.artic     no-undo .
     1120     define input  parameter p-prod-type like ub.goods.prod-type no-undo .
     1121     define input  parameter p-prod-code like ub.goods.prod-code no-undo .
     1122     do
     1123     on error  undo, return error substitute( "&1. &2&3&4", vss-include-info5, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1124     on stop   undo, return error substitute( "&1. stop",   vss-include-info5 )
     1125     on endkey undo, return error substitute( "&1. endkey", vss-include-info5 )
     1126     :
     1127       define buffer buf_goods for ub.goods .
     1128       if lookup( p-tbl-name, "c-goods,c-order-line":U ) = 0 then do:
     1129         find first buf_goods no-lock
     1130           where buf_goods.artic     = p-artic
     1131             and buf_goods.prod-type = p-prod-type
     1132             and buf_goods.prod-code = p-prod-code
     1133           no-error .
     1134         if not available buf_goods then do:
     1135           return error substitute( "&1 (check-use-artic). Не найден товар с артикулом &2 и производителем &3 &4", vss-include-info5, p-artic, p-prod-type, p-prod-code ) .
     1136         end.
     1137         if buf_goods.stts = integer('51':U) then do:
     1138           return error substitute( "&1 (check-use-artic). Нельзя использовать товар с артикулом &2 и производителем &3 &4&5"
     1139                                   + "Выполняется переименование артикула и(или) производителя"
     1140                                   ,vss-include-info5
     1141                                   ,p-artic
     1142                                   ,p-prod-type
     1143                                   ,p-prod-code
     1144                                   ,chr(10)
     1145                                 ) .
     1146         end.
     1147       end.
     1148       return .
     1149     end.
     1150   end procedure.
     1151   if valid-handle (g#lib-nws)
     1152   and g#lib-nws <> this-procedure :handle
     1153   and g#lib-nws :get-signature('lib-nws_clear-fill-option':u) <> ""
     1154   then do:
     1155     message
     1156       vss-workfile vss-revision vss-description skip
     1157       "Попытка повторной загрузки библиотеки для работы с СПН" skip
     1158       g#lib-nws skip
     1159       g#lib-nws :type skip
     1160       g#lib-nws :file-name skip
     1161       valid-handle(g#lib-nws) skip
     1162       this-procedure :handle skip
     1163       this-procedure :type skip
     1164       this-procedure :file-name skip
     1165       valid-handle(this-procedure) skip
     1166       view-as alert-box error .
     1167     undo, return error .
     1168   end.
     1169   else do:
     1170     assign
     1171       g#lib-nws = this-procedure :handle
     1172     .
     1173   end.
     1174   define temp-table temp-hist-nws-option no-undo like ub.hist-nws-option.
     1175   define buffer locked_hist-nws-option for ub.hist-nws-option.
     1176   define variable v-lock-type as integer no-undo .
     1177   define variable v-prev-lock-type as integer no-undo .
     1178   define variable v-cashed-version as character no-undo .
     1179   define variable v-cashed-time as int64 no-undo .
     1180   on delete of this-procedure do:
     1181     for each temp-hist-nws-option:
     1182       delete temp-hist-nws-option.
     1183     end.
     1184     assign
     1185       g#lib-nws = ?
     1186     .
     1187   end.
     1188   define stream str-err.
     1189   procedure lib-nws_clear-fill-option:
     1190   define input parameter p-fill-option as character no-undo .
     1191   define buffer buf_temp-hist-nws-option for temp-hist-nws-option.
     1192     do
     1193     on error undo, return error return-value
     1194     :
     1195       for each buf_temp-hist-nws-option where
     1196               buf_temp-hist-nws-option.db-num = g#db-num
     1197           and buf_temp-hist-nws-option.fill-option = p-fill-option
     1198       on error undo, return error :
     1199         delete buf_temp-hist-nws-option.
     1200       end.
     1201       assign
     1202       v-lock-type = v-prev-lock-type
     1203       v-cashed-version = '':U
     1204       v-cashed-time = 0
     1205       .
     1206     end.
     1207   end procedure.
     1208   procedure lib-nws_fill-dct:
     1209   define input parameter p-fill-option as character no-undo .
     1210   define buffer buf_dis-card-type for ub.dis-card-type.
     1211   define buffer buf_temp-hist-nws-option for temp-hist-nws-option.
     1212   define buffer buf_hist-nws-option for ub.hist-nws-option.
     1213     do
     1214     on error undo, return error return-value
     1215     :
     1216       v-prev-lock-type = v-lock-type.
     1217       run lib-nws_clear-fill-option in this-procedure ( input 'c-dc-hist':U).
     1218       if v-lock-type = 0 then do:
     1219         find first locked_hist-nws-option no-lock where
     1220                   locked_hist-nws-option.db-num = g#db-num
     1221               and locked_hist-nws-option.hn-id = 0 .
     1222         assign
     1223         v-lock-type = NO-LOCK
     1224         .
     1225       end.
     1226       for each buf_hist-nws-option no-lock where
     1227                buf_hist-nws-option.db-num = g#db-num
     1228            and buf_hist-nws-option.hn-id > 0
     1229            and buf_hist-nws-option.subject-group = 'c-dc-hist':U
     1230       on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1231       :
     1232         create buf_temp-hist-nws-option.
     1233         buffer-copy buf_hist-nws-option to buf_temp-hist-nws-option.
     1234         assign
     1235         buf_temp-hist-nws-option.fill-option = p-fill-option
     1236         .
     1237       end.
     1238     end.
     1239   end procedure.
     1240   procedure lib-nws_fill-hn-option-table :
     1241   define input parameter p-lock-type as integer no-undo .
     1242   define buffer buf_hist-nws-option for ub.hist-nws-option.
     1243   define buffer buf_temp-hist-nws-option for temp-hist-nws-option.
     1244     do
     1245     on error undo, return error return-value
     1246     :
     1247       find first locked_hist-nws-option share-lock where
     1248         locked_hist-nws-option.db-num = g#db-num
     1249         and locked_hist-nws-option.hn-id = 0 .
     1250       if v-cashed-version = locked_hist-nws-option.option-descr then do:
     1251         release locked_hist-nws-option.
     1252         return.
     1253       end.
     1254       assign
     1255       v-lock-type = p-lock-type
     1256       v-cashed-version = locked_hist-nws-option.option-descr
     1257       v-cashed-time = etime
     1258       .
     1259       for each buf_temp-hist-nws-option:
     1260         if buf_temp-hist-nws-option.charkey_one <> '':U
     1261         or buf_temp-hist-nws-option.charkey_two <> '':U
     1262         or buf_temp-hist-nws-option.charkey_three <> '':U
     1263         or buf_temp-hist-nws-option.key#_one <> 0
     1264         or buf_temp-hist-nws-option.key#_two <> 0
     1265         or buf_temp-hist-nws-option.key#_three <> 0
     1266         or buf_temp-hist-nws-option.host-code <> 0
     1267         or buf_temp-hist-nws-option.obj-type <> '':U
     1268         or buf_temp-hist-nws-option.obj-code <> 0 then next.
     1269         delete buf_temp-hist-nws-option.
     1270       end.
     1271       for each buf_hist-nws-option no-lock where
     1272                buf_hist-nws-option.db-num = g#db-num
     1273            and buf_hist-nws-option.hn-id > 0
     1274       on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1275       :
     1276         if buf_hist-nws-option.charkey_one <> '':U
     1277         or buf_hist-nws-option.charkey_two <> '':U
     1278         or buf_hist-nws-option.charkey_three <> '':U
     1279         or buf_hist-nws-option.key#_one <> 0
     1280         or buf_hist-nws-option.key#_two <> 0
     1281         or buf_hist-nws-option.key#_three <> 0
     1282         or buf_hist-nws-option.host-code <> 0
     1283         or buf_hist-nws-option.obj-type <> '':U
     1284         or buf_hist-nws-option.obj-code <> 0 then next.
     1285         create buf_temp-hist-nws-option.
     1286         buffer-copy buf_hist-nws-option to buf_temp-hist-nws-option.
     1287       end.
     1288       case p-lock-type:
     1289         when no-lock then do:
     1290           release locked_hist-nws-option.
     1291         end.
     1292         when share-lock then do:
     1293           find current locked_hist-nws-option share-lock .
     1294         end.
     1295         when exclusive-lock then do:
     1296           find current locked_hist-nws-option exclusive-lock .
     1297         end.
     1298       end case.
     1299     end.
     1300   end procedure.
     1301   procedure lib-nws_get-hn-option :
     1302   define input parameter p-db-num as integer no-undo .
     1303   define input parameter p-table-name as character no-undo .
     1304   define input parameter p-host-code as integer no-undo .
     1305   define input parameter p-obj-type as character no-undo .
     1306   define input parameter p-obj-code as integer no-undo .
     1307   define input parameter p-CHarkey_one as character no-undo .
     1308   define input parameter p-CHarkey_two as character no-undo .
     1309   define input parameter p-CHarkey_three as character no-undo .
     1310   define input parameter p-key#_one as integer no-undo .
     1311   define input parameter p-key#_two as integer no-undo .
     1312   define input parameter p-key#_three as integer no-undo .
     1313   define input parameter p-option-name as character no-undo .
     1314   define output parameter p-option-value as integer no-undo .
     1315   define buffer buf_temp-hist-nws-option for temp-hist-nws-option.
     1316     main-block:
     1317     do
     1318     on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1319     :
     1320       if v-cashed-version = '':U
     1321       or  (etime - v-cashed-time > 1800000)
     1322       or etime < v-cashed-time
     1323       then do:
     1324         run lib-nws_fill-hn-option-table  in this-procedure ( input no-lock) no-error .
     1325         if error-status:error then do:
     1326           undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)).
     1327         end.
     1328       end.
     1329       if p-option-name = 'smart-nws' then do:
     1330         p-option-value = integer('-1':U).
     1331       end.
     1332       else do:
     1333         p-option-value = integer('0':U).
     1334       end.
     1335       find first buf_temp-hist-nws-option where
     1336                 buf_temp-hist-nws-option.db-num = p-db-num
     1337             and buf_temp-hist-nws-option.table-name = p-table-name
     1338             and buf_temp-hist-nws-option.CHarkey_one = p-CHarkey_one
     1339             and buf_temp-hist-nws-option.CHarkey_two = p-CHarkey_two
     1340             and buf_temp-hist-nws-option.CHarkey_three = p-CHarkey_three
     1341             and buf_temp-hist-nws-option.key#_one = p-key#_one
     1342             and buf_temp-hist-nws-option.key#_two = p-key#_two
     1343             and buf_temp-hist-nws-option.key#_three = p-key#_three
     1344             and buf_temp-hist-nws-option.host-code = p-host-code
     1345             and buf_temp-hist-nws-option.obj-type = p-obj-type
     1346             and buf_temp-hist-nws-option.obj-code = p-obj-code
     1347             no-error.
     1348       if not available buf_temp-hist-nws-option then return.
     1349       assign
     1350       p-option-value = buffer buf_temp-hist-nws-option:buffer-field(p-option-name):buffer-value
     1351       no-error .
     1352     end.
     1353   end procedure.
     1354   procedure lib-nws_get-hn-option-record :
     1355   define input parameter p-db-num as integer no-undo .
     1356   define input parameter p-bh as handle no-undo.
     1357   define variable v-bh as handle no-undo .
     1358   define variable v-tbh as handle no-undo .
     1359   define variable v-phrase as character no-undo .
     1360   define variable glog as logical no-undo .
     1361   define buffer buf_temp-hist-nws-option for temp-hist-nws-option.
     1362   define buffer buf_hist-nws-option for ub.hist-nws-option.
     1363     main-block:
     1364     do
     1365     on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1366     :
     1367       if v-cashed-version = '':U
     1368       or  (etime - v-cashed-time > 1800000)
     1369       or etime < v-cashed-time
     1370       then do:
     1371         run lib-nws_fill-hn-option-table  in this-procedure ( input no-lock) no-error .
     1372         if error-status:error then do:
     1373           undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)).
     1374         end.
     1375       end.
     1376       glog = p-bh:find-first('':U, v-lock-type).
     1377       v-tbh = buffer buf_temp-hist-nws-option:handle.
     1378       v-bh = buffer buf_hist-nws-option:handle.
     1379       v-phrase =  substitute( 'where db-num = &1 ' +
     1380                              'and table-name = "&2" ' +
     1381                              'and CHarkey_one = "&3" ' +
     1382                              'and CHarkey_two = "&4" ' +
     1383                              'and CHarkey_three = "&5" ' +
     1384                              'and key#_one = &6 ' +
     1385                              'and key#_two = &7 ' +
     1386                              'and key#_three = &8 ' +
     1387                              'and host-code = &9 '
     1388                              ,p-db-num
     1389                              ,p-bh:buffer-field('table-name'):buffer-value
     1390                              ,p-bh:buffer-field('charkey_one'):buffer-value
     1391                              ,p-bh:buffer-field('charkey_two'):buffer-value
     1392                              ,p-bh:buffer-field('charkey_three'):buffer-value
     1393                              ,p-bh:buffer-field('key#_one'):buffer-value
     1394                              ,p-bh:buffer-field('key#_two'):buffer-value
     1395                              ,p-bh:buffer-field('key#_three'):buffer-value
     1396                              ,p-bh:buffer-field('host-code'):buffer-value)
     1397                  + substitute('and obj-type = "&1" ' +
     1398                               'and obj-code = &2 '
     1399                               ,p-bh:buffer-field('obj-type'):buffer-value
     1400                               ,p-bh:buffer-field('obj-code'):buffer-value).
     1401       glog = v-tbh:find-first( v-phrase, no-lock) no-error .
     1402       if not glog then do:
     1403         glog = v-bh:find-first( v-phrase, no-lock) no-error .
     1404         if glog then do:
     1405           glog = p-bh:buffer-copy ( v-bh) no-error .
     1406         end.
     1407       end.
     1408       else do:
     1409         glog = p-bh:buffer-copy ( v-tbh) no-error .
     1410       end.
     1411     end.
     1412   end procedure.
     1413   procedure lib-nws_lock-route :
     1414     define input  parameter p-action as character no-undo .
     1415     define input  parameter p-db-num as integer   no-undo .
     1416     define input  parameter p-esys-id as integer  no-undo.
     1417     define input  parameter p-descr  as character no-undo .
     1418     define output parameter p-msg    as character no-undo .
     1419     define output parameter p-lock   as logical   no-undo .
     1420     define output parameter p-ok     as logical   no-undo .
     1421     do
     1422     on error  undo, return error substitute( "&1 (lib-nws_lock-route). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1423     on stop   undo, return error substitute( "&1 (lib-nws_lock-route). stop", vss-workfile )
     1424     on endkey undo, return error substitute( "&1 (lib-nws_lock-route). endkey", vss-workfile )
     1425     :
     1426       define variable v-date as date    no-undo .
     1427       define variable v-time as integer no-undo .
     1428       define variable v-CharKey_One    as character    no-undo.
     1429       define variable v-BP_Type        as character    no-undo.
     1430       define buffer buf_BatchProcess for ub.BatchProcess .
     1431         if p-esys-id = 0
     1432         then do:
     1433             assign
     1434                 v-CharKey_One = substitute( "&1&2", p-db-num
     1435                                                 , ( if p-esys-id = 0 then "":U else ",":U + string( p-esys-id ) ) )
     1436                 v-BP_Type     = 'lkrt':U
     1437             .
     1438         end.
     1439         else do:
     1440             assign
     1441                 v-CharKey_One = substitute( "&1&2", p-db-num
     1442                                                 , ( if p-esys-id = 0 then "":U else ",":U + string( p-esys-id ) ) )
     1443                 v-BP_Type     = 'lkes':U
     1444             .
     1445         end.
     1446       find first buf_BatchProcess no-lock
     1447         where buf_BatchProcess.BP_Status   = 'N':U
     1448           and buf_BatchProcess.BP_Type     = v-BP_Type
     1449           and buf_BatchProcess.CharKey_One = v-CharKey_One
     1450         no-error .
     1451       assign
     1452         p-ok = true
     1453       .
     1454       case p-action :
     1455         when "lockfull":U
     1456         or when "lockwnws":U
     1457         then do:
     1458           assign
     1459             p-lock = true
     1460           .
     1461           if available buf_BatchProcess then do:
     1462             assign
     1463               p-ok  = false
     1464               p-msg = substitute( "Блокировка маршрутизации для БД &1 уже установлена пользователем &2 (&3) &4 в &5 (&6)"
     1465                                   ,v-CharKey_One
     1466                                   ,usrnickf( buf_BatchProcess.User_ID )
     1467                                   ,buf_BatchProcess.User_ID
     1468                                   ,string( buf_BatchProcess.BP_SysDate, "99.99.9999" )
     1469                                   ,buf_BatchProcess.BP_SysTime
     1470                                   ,buf_BatchProcess.CharKey_Three
     1471                                 ).
     1472             .
     1473           end.
     1474           else do:
     1475             run cur-time ( output v-date
     1476                           ,output v-time
     1477                         ) no-error .
     1478             if error-status :error then do:
     1479               return error substitute( "&1. Ошибка при определении текущего времени", vss-workfile ) .
     1480             end.
     1481             create buf_BatchProcess .
     1482             assign
     1483               p-msg = substitute( "БД &1 заблокировка маршрутизации (&2)"
     1484                                   ,v-CharKey_One
     1485                                   ,p-descr
     1486                                 )
     1487               buf_BatchProcess.BatchProcess#     = next-value (s-btpr, ub)
     1488               buf_BatchProcess.BP_Status         = 'N':U
     1489               buf_BatchProcess.BP_Type           = v-BP_Type
     1490               buf_BatchProcess.User_ID           = g#userid
     1491               buf_BatchProcess.BP_SysDate        = v-date
     1492               buf_BatchProcess.BP_SysTimeInt     = v-time
     1493               buf_BatchProcess.BP_SysTime        = string(v-time, 'HH:MM:SS':U)
     1494               buf_BatchProcess.CharKey_One       = v-CharKey_One
     1495               buf_BatchProcess.CharKey_Two       = p-action
     1496               buf_BatchProcess.CharKey_Three     = p-descr
     1497             .
     1498           end.
     1499         end.
     1500         when "unlock":U then do:
     1501           assign
     1502             p-lock = false
     1503           .
     1504           if available buf_BatchProcess then do:
     1505             find first buf_BatchProcess
     1506               where buf_BatchProcess.BP_Status   = 'N':U
     1507                 and buf_BatchProcess.BP_Type     = v-BP_Type
     1508                 and buf_BatchProcess.CharKey_One = v-CharKey_One
     1509               no-error .
     1510             delete buf_BatchProcess .
     1511             assign
     1512               p-msg = "Блокировка снята"
     1513             .
     1514           end.
     1515           else do:
     1516             assign
     1517               p-msg = "Блокировка не установлена"
     1518             .
     1519           end.
     1520         end.
     1521         when "check":U then do:
     1522           if available buf_BatchProcess
     1523             and ( buf_BatchProcess.CharKey_Two <> "lockwnws":U
     1524                   or
     1525                   ( buf_BatchProcess.CharKey_Two = "lockwnws":U
     1526                     and g#news <> true
     1527                   )
     1528                 )
     1529           then do:
     1530             assign
     1531               p-msg = substitute( "Маршрутизация в БД &1 заблокирована пользователем &2 (&3) &4 в &5 (&6)"
     1532                                   ,v-CharKey_One
     1533                                   ,usrnickf( buf_BatchProcess.User_ID )
     1534                                   ,buf_BatchProcess.User_ID
     1535                                   ,string( buf_BatchProcess.BP_SysDate, "99.99.9999" )
     1536                                   ,buf_BatchProcess.BP_SysTime
     1537                                   ,buf_BatchProcess.CharKey_Three
     1538                                 ).
     1539               p-lock = true
     1540             .
     1541           end.
     1542           else do:
     1543             assign
     1544               p-msg  = "Блокировка не установлена"
     1545               p-lock = false
     1546             .
     1547           end.
     1548         end.
     1549         otherwise do:
     1550           return error substitute( "&1. Нет обработки операции &2", vss-workfile, p-action ) .
     1551         end.
     1552       end case.
     1553     end.
     1554   end procedure.
     1555   procedure lib-nws_route-dump-write :
     1556     define input parameter p-tbl-name   as character           no-undo .
     1557     define input parameter p-bh_rtd     as handle              no-undo .
     1558     define input parameter p-bh         as handle              no-undo .
     1559     define input parameter p-dmp-ord    like ub.route.dump-ord no-undo .
     1560     define input parameter p-rc-ord     as integer             no-undo .
     1561     do
     1562     on error  undo, return error substitute( "&1 (lib-nws_route-dump-write). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1563     on stop   undo, return error substitute( "&1 (lib-nws_route-dump-write). stop", vss-workfile )
     1564     on endkey undo, return error substitute( "&1 (lib-nws_route-dump-write). endkey", vss-workfile )
     1565     :
     1566       define buffer buf-rtdl_goods           for ub.goods .
     1567       define buffer buf-rtdl_route-dump-link for ub.route-dump-link .
     1568       define variable tt-name         as character no-undo .
     1569       define variable tth             as handle    no-undo .
     1570       define variable bh_tt           as handle    no-undo .
     1571       define variable v-num-fields     as integer no-undo .
     1572       define variable v-ind            as integer no-undo .
     1573       define variable v-avail-gds-code as logical no-undo .
     1574       define variable v-avail-artic    as logical no-undo .
     1575       define variable fh_tbl-name      as handle  no-undo .
     1576       define variable fh_gds-code      as handle  no-undo .
     1577       define variable fh_artic         as handle  no-undo .
     1578       define variable fh_prod-type     as handle  no-undo .
     1579       define variable fh_prod-code     as handle  no-undo .
     1580       define variable v-ok             as logical   no-undo .
     1581       define variable v-loc-key-rec like ub.route-dump-link.uniq-key-rec no-undo.
     1582       create temp-table tth.
     1583       assign
     1584         tth:undo = false
     1585         tt-name  = "tt_" + p-tbl-name
     1586       .
     1587       if valid-handle(p-bh) then do:
     1588         assign
     1589           v-ok = tth:create-like( p-bh ) no-error
     1590         .
     1591       end.
     1592       else do:
     1593         assign
     1594           v-ok = tth:create-like( p-tbl-name ) no-error
     1595         .
     1596       end.
     1597       if v-ok <> true then do:
     1598         return error substitute( "&1. Ошибка при создании временной таблицы &2 (1)", vss-workfile, tt-name ) .
     1599       end.
     1600       assign
     1601         v-ok = tth:temp-table-prepare( tt-name ) no-error
     1602       .
     1603       if v-ok <> true then do:
     1604         return error substitute( "&1. Ошибка при создании временной таблицы &2 (2)", vss-workfile, tt-name ) .
     1605       end.
     1606       assign
     1607         bh_tt = tth:default-buffer-handle
     1608       .
     1609       assign
     1610         v-ok = bh_tt:buffer-create no-error
     1611       .
     1612       if v-ok <> true then do:
     1613         return error substitute( "&1. Ошибка при создании буфера временной таблицы.", vss-workfile, p-tbl-name ).
     1614       end.
     1615       assign
     1616         v-ok = bh_tt:raw-transfer ( false, p-bh_rtd:buffer-field("value-rec") ) no-error
     1617       .
     1618       if v-ok <> true then do:
     1619         return error substitute( "&1. RAW-TRANSFER не прошел для таблицы &2", vss-workfile, p-tbl-name ).
     1620       end.
     1621       assign
     1622         fh_artic      = bh_tt:buffer-field( "artic":U )
     1623         fh_prod-type  = bh_tt:buffer-field( "prod-type":U )
     1624         fh_prod-code  = bh_tt:buffer-field( "prod-code":U )
     1625         fh_gds-code   = bh_tt:buffer-field( "gds-code":U )
     1626         no-error
     1627       .
     1628       if fh_artic <> ? then do:
     1629         assign
     1630           v-avail-artic = true
     1631         .
     1632       end.
     1633       if fh_gds-code <> ? then do:
     1634         assign
     1635           v-avail-gds-code = true
     1636         .
     1637       end.
     1638       if v-avail-gds-code = true
     1639         or v-avail-artic = true
     1640       then do:
     1641         if v-avail-gds-code = true then do:
     1642           if fh_gds-code:buffer-value() > 0 then do:
     1643             find first buf-rtdl_goods no-lock
     1644               where buf-rtdl_goods.gds-code = fh_gds-code:buffer-value()
     1645             no-error .
     1646             if not available buf-rtdl_goods then do:
     1647               return error substitute( "&1. Товар с кодом &2 не найден по таблице &3"
     1648                                       ,vss-workfile
     1649                                       ,fh_gds-code:buffer-value()
     1650                                       ,p-tbl-name
     1651                                     ).
     1652             end.
     1653           end.
     1654         end.
     1655         else do:
     1656             find first buf-rtdl_goods no-lock
     1657               where buf-rtdl_goods.artic     = fh_artic:buffer-value()
     1658                 and buf-rtdl_goods.prod-type = fh_prod-type:buffer-value()
     1659                 and buf-rtdl_goods.prod-code = fh_prod-code:buffer-value()
     1660             no-error .
     1661             if not available buf-rtdl_goods then do:
     1662               return error substitute( "&1. Товар с артикулом &2 производителя &3 &4 не найден по таблице &5"
     1663                                       ,vss-workfile
     1664                                       ,fh_artic:buffer-value()
     1665                                       ,fh_prod-type:buffer-value()
     1666                                       ,fh_prod-code:buffer-value()
     1667                                       ,p-tbl-name
     1668                                       ).
     1669             end.
     1670         end.
     1671         if available buf-rtdl_goods then do:
     1672           if v-avail-artic = true then do:
     1673             run check-use-artic in this-procedure
     1674               ( input p-tbl-name
     1675               ,input fh_artic:buffer-value()
     1676               ,input fh_prod-type:buffer-value()
     1677               ,input fh_prod-code:buffer-value()
     1678               ) no-error .
     1679             if error-status :error then do:
     1680               undo, return error return-value.
     1681             end.
     1682           end.
     1683           run gen-key-rec( input 'goods':U
     1684                           ,input (buffer buf-rtdl_goods:handle)
     1685                           ,output v-loc-key-rec
     1686                         ) no-error.
     1687           if error-status :error then do:
     1688             return error substitute( "&1. Ошибка при генерации уникального ключа по таблице &2 для &3. &4"
     1689                                     ,vss-workfile
     1690                                     ,'goods':U
     1691                                     ,p-tbl-name
     1692                                     ,return-value
     1693                                   ).
     1694           end.
     1695           create buf-rtdl_route-dump-link .
     1696           assign
     1697             buf-rtdl_route-dump-link.dump-ord     = p-dmp-ord
     1698             buf-rtdl_route-dump-link.rec-ord      = p-rc-ord
     1699             buf-rtdl_route-dump-link.uniq-key-rec = v-loc-key-rec
     1700             buf-rtdl_route-dump-link.dump-name    = p-tbl-name
     1701           .
     1702         end.
     1703       end.
     1704       assign
     1705         v-ok = tth:clear() no-error
     1706       .
     1707       if v-ok <> true then do:
     1708         return error substitute( "&1. Ошибка при очистке временной таблицы &2", vss-workfile, tt-name ) .
     1709       end.
     1710       delete object tth no-error .
     1711       if error-status:error then do:
     1712         return error substitute( "&1. Ошибка при удалении временной таблицы для &2", vss-workfile, tt-name ).
     1713       end.
     1714     end.
     1715   end procedure.
