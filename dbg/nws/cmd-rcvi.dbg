        1   block-level on error undo, throw.
        2   define input  parameter p-imp-handle as handle    no-undo .
        3   define input  parameter p-counter  as integer   no-undo .
        4   define input  parameter p-type as character no-undo .
        5   define input  parameter p-doc-code as character no-undo .
        6   define input  parameter p-rcv-code as character no-undo .
        7   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        8   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        9   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       10   define variable vss-workfile    as character no-undo init "$Workfile: cmd-rcvi.p $":U .
       11   define variable vss-archive     as character no-undo init "$Archive: nws/cmd-rcvi.p $":U .
       12   define variable vss-description as character no-undo init "Обработка команды по шапке поставки в статусе ПОСТАВКА".
       13   procedure vss-get-info :
       14     define output parameter p-vss-revision    like vss-revision    no-undo .
       15     define output parameter p-vss-author      like vss-author      no-undo .
       16     define output parameter p-vss-date        like vss-date        no-undo .
       17     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       18     define output parameter p-vss-archive     like vss-archive     no-undo .
       19     define output parameter p-vss-description like vss-description no-undo .
       20     assign
       21       p-vss-revision    = vss-revision
       22       p-vss-author      = vss-author
       23       p-vss-date        = vss-date
       24       p-vss-workfile    = vss-workfile
       25       p-vss-archive     = vss-archive
       26       p-vss-description = vss-description
       27     .
       28   end procedure.
       29   procedure vss-get-parameters :
       30     define output parameter p-vss-parameters as character no-undo .
       31       assign
       32         p-vss-parameters = substitute('&1|&2|&3':u,p-counter,p-type,p-doc-code)
       33       .
       34   end procedure.
       35   define new global shared variable g#vssrevis-logger as handle    no-undo .
       36   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       37   define variable v-vssrevis-logger                   as handle    no-undo .
       38   procedure vss-logevent :
       39     define input  parameter p-extra-paramters as character no-undo .
       40     define variable v-vssrevis-parameters as character no-undo .
       41     do
       42     on error undo, return error return-value
       43     :
       44       if  valid-handle(v-vssrevis-logger)
       45       and v-vssrevis-logger :get-signature("logevent") <> ""
       46       then do:
       47         run vss-get-parameters in this-procedure
       48           (output v-vssrevis-parameters
       49           ).
       50         run logevent in v-vssrevis-logger
       51           (input vss-workfile
       52           ,input vss-revision
       53           ,input v-vssrevis-parameters
       54           ,input p-extra-paramters
       55           ).
       56       end.
       57     end.
       58   end procedure.
       59   assign
       60     v-vssrevis-logger = g#vssrevis-logger
       61   .
       62   if  valid-handle(v-vssrevis-logger)
       63   and v-vssrevis-logger :get-signature("logevent") <> ""
       64   then do:
       65     assign
       66       v-vssrevis-logevent = true
       67     .
       68     run vss-logevent in this-procedure (input vss-description) .
       69   end.
       70   define new global shared variable g#language as character no-undo .
       71   if g#language <> '' and g#language <> 'rus':U then do:
       72     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       73   end.
       74   define new global shared variable g#library  as handle no-undo .
       75   define new global shared variable g#library2 as handle no-undo .
       76   define   shared variable g#auto as logical no-undo.
       77   define   shared variable g#news as logical no-undo.
       78   define   shared variable g#oxml as logical no-undo.
       79   define   shared variable g#esys as logical no-undo.
       80   define   shared variable g#news-source-db as integer no-undo.
       81   define   shared variable g#esys-source-esys as integer no-undo.
       82   define   shared variable g#db-num as integer   no-undo .
       83   define   shared variable g#userid as character no-undo .
       84   define   shared variable g#passwd as character no-undo .
       85   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       86   define variable v-waitfram-action01         as character   no-undo .
       87   define variable v-waitfram-action02         as character   no-undo .
       88   define variable v-waitfram-action03         as character   no-undo .
       89   define variable mWaitFramTextBeg            as character   no-undo.
       90   define variable mWaitFramTextEnd            as character   no-undo.
       91   define variable mWaitFramView               as logical     no-undo.
       92   define variable mWaitProcEvent              as logical     no-undo init yes.
       93   define variable mWaitFramInterval           as integer     no-undo init 1 .
       94   define variable mWaitFramStop               as logical     no-undo.
       95   define variable mWaitFramStopUser           as logical     no-undo.
       96   define variable mWaitFramStopTimeOut        as logical     no-undo.
       97   define variable mWaitFramStartProc          as datetime-tz no-undo.
       98   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       99   define button B-WaitFramStop auto-end-key
      100        label "Стоп"
      101        size 10 by 1 tooltip "Остоновить процесс".
      102   define button B-viewProcInfo
      103        label "Информация"
      104        size 15 by 1 tooltip "Информация о процесс".
      105   define frame waitfram
      106     v-waitfram-action01 format "x(72)" no-label skip
      107     v-waitfram-action02 format "x(72)" no-label skip
      108     v-waitfram-action03 format "x(72)" no-label skip
      109     B-viewProcInfo
      110     B-WaitFramStop at row 4 col 30
      111     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      112     .
      113   define new global shared variable mBatchMode as logical no-undo init ?.
      114   define variable mFramBachModHandle as handle no-undo.
      115   mFramBachModHandle = frame waitfram:handle.
      116   define variable mFameOldVis as logical no-undo.
      117   define variable mVisCUrentVin as logical no-undo.
      118   if session:batch-mode
      119   then
      120      mBatchMode = yes.
      121   if mBatchMode = ? then do:
      122     mVisCUrentVin = current-window:visible.
      123     mFameOldVis = mFramBachModHandle:visible.
      124     mFramBachModHandle:visible  = yes.
      125     mBatchMode = mFramBachModHandle:visible ne yes.
      126     mFramBachModHandle:visible = mFameOldVis.
      127     current-window:visible = mVisCUrentVin.
      128   end.
      129    if  log-manager:logfile-name ne ?
      130     then DO:
      131         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      132         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      133         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      134     end.
      135   on choose of B-WaitFramStop in frame waitfram
      136   do:
      137     mWaitFramStop = yes.
      138     mWaitFramStopUser = yes.
      139   end.
      140   function waitfram-check-timeout returns logical():
      141      define variable vtime as int64 no-undo.
      142      if mWaitFramStopTimeOut
      143      then
      144         return yes.
      145      vtime = ( now - mWaitFramStartProc ) / 1000 .
      146      if     mWaitFramTimeOut ne ?
      147         and mWaitFramTimeOut ne 0
      148         and mWaitFramTimeOut lt vtime
      149      then do:
      150         mWaitFramStopTimeOut = yes.
      151      end.
      152      return mWaitFramStopTimeOut.
      153   end.
      154   procedure waitfram-hide :
      155     if not session:batch-mode
      156     then do
      157     on error undo, return error return-value
      158     :
      159       pause 0 before-hide .
      160       if not mBatchMode then
      161         hide frame waitfram .
      162     if     not mWaitFramView
      163        and mWaitProcEvent
      164     then
      165       process events .
      166     end.
      167   end procedure.
      168   procedure waitfram-show :
      169     define input  parameter p-message as character no-undo .
      170     define variable v-left-margin as integer   no-undo .
      171     if not session:batch-mode
      172     then do
      173     on error undo, return error return-value
      174     :
      175       if length(p-message) <= 70 then do:
      176         assign
      177           v-left-margin = integer((70 - length(p-message)) / 2)
      178         .
      179         assign
      180           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      181         .
      182         assign
      183           v-waitfram-action01 = " "
      184           v-waitfram-action02 = " "
      185                                    + fill(" ", v-left-margin)
      186                                    + p-message
      187           v-waitfram-action03 = " "
      188         .
      189       end.
      190       else do:
      191         define variable vRindex1 as integer no-undo.
      192         define variable vRindex2 as integer no-undo.
      193         vRindex1 = r-index(p-message," ",70).
      194         if vRindex1 = 0
      195         then
      196            vRindex1 = 70.
      197         if length(p-message)  <= vRindex1 + 70 then do:
      198           assign
      199             v-waitfram-action01 = " "
      200             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      201             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      202           .
      203         end.
      204         else do:
      205           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      206           if vRindex2 <= vRindex1
      207           then
      208              vRindex2 = vRindex1 + 70.
      209           assign
      210             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      211             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      212             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      213           .
      214         end.
      215       end.
      216       B-viewProcInfo:visible   in frame waitfram = no.
      217       B-viewProcInfo:sensitive in frame waitfram = no.
      218       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      219       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      220       if  (   mWaitFramView
      221          or  mWaitProcEvent)
      222          and not mBatchMode
      223       then
      224          display
      225             v-waitfram-action01 skip
      226             v-waitfram-action02 skip
      227             v-waitfram-action03 skip
      228          with frame waitfram .
      229       if     mWaitFramView
      230          then do:
      231             if     mWaitFramInterval ne ?
      232                and not mBatchMode
      233             then
      234                wait-for go of frame waitfram pause mWaitFramInterval.
      235          end.
      236          else
      237             if     mWaitProcEvent
      238                and not mBatchMode
      239             then
      240                process events .
      241     end.
      242   end procedure.
      243      procedure waitfram-show-this:
      244         define input  parameter iInterval as int64 no-undo.
      245         define variable vtime as int64 no-undo.
      246         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      247         mWaitFramInterval = iInterval.
      248         run waitfram-show (substitute("&1&2 &3&4" ,
      249                                       mWaitFramTextBeg ,
      250                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      251                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      252                                       mWaitFramTextEnd
      253                                      )
      254                           ).
      255      end.
      256      procedure WaitFramRunPause:
      257         define input  parameter iInterval as dec no-undo.
      258         define variable vStart  as datetime-tz no-undo.
      259         define variable vend    as datetime-tz no-undo.
      260         define variable vint as int64 no-undo.
      261         define variable vOk as logical no-undo.
      262         vStart = now.
      263         vend   = vStart.
      264         publish "WaitFramPause" (iInterval,output vOk).
      265         vend   =  now.
      266         vint = vend - vStart.
      267         vint = iInterval - vint / 1000.
      268         if     not mWaitFramStop
      269            and (   vint > 0
      270                 or (    not vOk
      271                     and iInterval eq ?
      272                     )
      273                 )
      274         then
      275            run waitfram-show-this (iInterval).
      276         vend   =  now.
      277         vint = vend - vStart.
      278         vint = iInterval - vint / 1000.
      279         if     not mWaitFramStop
      280            and vint > 0
      281         then do:
      282            run gbl/pause.p (vint * 1000).
      283         end.
      284         if iInterval ne ?
      285         then
      286            publish "WaitFramStop".
      287         waitfram-check-timeout().
      288      end.
      289      procedure WaitFramWaitFor:
      290         define input  parameter iInterval as dec no-undo.
      291         assign
      292            mWaitFramStartProc   = now
      293            mWaitFramStopUser    = no
      294            mWaitFramStopTimeOut = no
      295         .
      296         block-wait:
      297         do while not mWaitFramStop:
      298            run WaitFramRunPause (iInterval).
      299            if  waitfram-check-timeout()
      300            then do:
      301               leave block-wait.
      302            end.
      303         end.
      304         run waitfram-hide.
      305      end.
      306   procedure waitfram-join :
      307     define input  parameter p-line-1  as character no-undo .
      308     define input  parameter p-line-2  as character no-undo .
      309     define input  parameter p-line-3  as character no-undo .
      310     define output parameter p-message as character no-undo .
      311     do
      312     on error undo, return error return-value
      313     :
      314       assign
      315         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      316                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      317                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      318       .
      319     end.
      320   end procedure.
      321   function waitfram-join-function returns character
      322     (input p-line-1 as character
      323     ,input p-line-2 as character
      324     ,input p-line-3 as character
      325     ).
      326     define variable v-message as character no-undo .
      327     run waitfram-join in this-procedure
      328       (input  p-line-1
      329       ,input  p-line-2
      330       ,input  p-line-3
      331       ,output v-message
      332       ) .
      333     return v-message .
      334   end function .
      335   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      336   procedure cur-time :
      337      define output parameter p-today as date      no-undo .
      338      define output parameter p-time  as integer   no-undo .
      339     do
      340     on error undo, return error
      341     :
      342       define variable v-date1 as date      no-undo .
      343       define variable v-date2 as date      no-undo .
      344       define variable v-time  as integer   no-undo .
      345       assign
      346         v-date1 = today
      347         v-time  = time
      348         v-date2 = today
      349       .
      350       if v-date1 <> v-date2
      351       then do:
      352         assign
      353           v-date1 = today
      354           v-time  = v-time
      355         .
      356       end.
      357       assign
      358         p-today = v-date1
      359         p-time  = v-time
      360       .
      361     end.
      362   end.
      363   function cur-time-date returns character
      364   :
      365     return string(today, '99/99/9999':U) .
      366   end.
      367   function cur-time-mjd returns decimal
      368   :
      369     define variable v-date as date      no-undo .
      370     define variable v-time as integer   no-undo .
      371     run cur-time in this-procedure
      372       (output v-date
      373       ,output v-time
      374       ) .
      375     return integer(v-date) - 2400002 + (v-time / 86400) .
      376   end.
      377   function cur-time-get-ending-index returns integer
      378   (input p-number as integer
      379   )
      380   :
      381     if p-number < 0
      382     or p-number = ?
      383     then do:
      384       return 1 .
      385     end.
      386     define variable v-rest as integer   no-undo .
      387     assign
      388       p-number = p-number modulo 100
      389     .
      390     if p-number < 20
      391     then do:
      392       assign
      393         v-rest = p-number
      394       .
      395     end.
      396     else do:
      397       assign
      398         v-rest = p-number modulo 10
      399       .
      400     end.
      401     case v-rest :
      402       when 1
      403       then do:
      404         return 2 .
      405       end.
      406       when 2 or
      407       when 3 or
      408       when 4
      409       then do:
      410         return 3 .
      411       end.
      412       otherwise do:
      413         return 1 .
      414       end.
      415     end case .
      416   end.
      417   procedure cur-time-mjd-to-date :
      418      define input  parameter i-mjd-diff as decimal no-undo.
      419      define output parameter o-Date     as date    no-undo.
      420      define output parameter o-Time     as integer no-undo.
      421      define variable v-day-number as integer   no-undo .
      422      if    i-mjd-diff < 0
      423         or i-mjd-diff = ?
      424      then do:
      425         return "?" .
      426      end.
      427      assign
      428         v-day-number = truncate(i-mjd-diff,0).
      429         o-Date = date(v-day-number + 2400002).
      430         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      431     .
      432   end.
      433   function cur-time-mjd-to-string returns character
      434   (input p-mjd-diff as decimal
      435   )
      436   :
      437     define variable v-day-number as integer   no-undo .
      438     define variable v-seconds    as integer   no-undo .
      439     define variable v-hour       as integer   no-undo .
      440     define variable v-min        as integer   no-undo .
      441     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      442     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      443     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      444     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      445     if p-mjd-diff < 0
      446     or p-mjd-diff = ?
      447     then do:
      448       return "?" .
      449     end.
      450     assign
      451       v-day-number = integer(truncate(p-mjd-diff,0))
      452       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      453     .
      454     if v-seconds > 86400
      455     then do:
      456       assign
      457         v-seconds = 86400 - 1
      458       .
      459     end.
      460     if v-seconds < 0
      461     then do:
      462       assign
      463         v-seconds = 0
      464       .
      465     end.
      466     assign
      467       v-hour = truncate(v-seconds / 3600, 0)
      468     .
      469     assign
      470       v-seconds = v-seconds modulo 3600
      471     .
      472     assign
      473       v-min = truncate(v-seconds / 60, 0)
      474     .
      475     assign
      476       v-seconds = v-seconds modulo 60
      477     .
      478     return
      479         (if v-day-number <> 0
      480           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      481           else ""
      482         )
      483       + (if v-day-number <> 0 or v-hour <> 0
      484           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      485           else ""
      486         )
      487       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      488           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      489           else ""
      490         )
      491       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      492       .
      493   end.
      494   function cur-time-string returns character
      495   :
      496     define variable v-date as date      no-undo .
      497     define variable v-time as integer   no-undo .
      498     run cur-time in this-procedure
      499       (output v-date
      500       ,output v-time
      501       ) .
      502     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      503   end.
      504   function cur-time-string-sec returns character
      505   :
      506     define variable v-date as date      no-undo .
      507     define variable v-time as integer   no-undo .
      508     run cur-time in this-procedure
      509       (output v-date
      510       ,output v-time
      511       ) .
      512     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      513   end.
      514   function cur-time-custom  returns character
      515   (input p-prefix as character
      516   ,input p-date-format as character
      517   ,input p-delimiter as character
      518   ,input p-time-format as character
      519   ,input p-suffix as character
      520   )
      521   :
      522     define variable v-date as date      no-undo .
      523     define variable v-time as integer   no-undo .
      524     run cur-time in this-procedure
      525       (output v-date
      526       ,output v-time
      527       ) .
      528     return
      529       p-prefix
      530       + string(v-date, p-date-format)
      531       + p-delimiter
      532       + string(v-time, p-time-format)
      533       + p-suffix
      534       .
      535   end.
      536   function cur-time-print  returns character
      537   :
      538     define variable v-date as date      no-undo .
      539     define variable v-time as integer   no-undo .
      540     run cur-time in this-procedure
      541       (output v-date
      542       ,output v-time
      543       ) .
      544     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      545   end.
      546   function cur-time-datetime returns datetime
      547   :
      548     define variable v-char as character no-undo .
      549     define variable v-datetime as datetime no-undo .
      550     v-char = cur-time-string().
      551     v-datetime = datetime(v-char).
      552     return  v-datetime.
      553   end.
      554   function cur-time-string-msec returns character
      555   :
      556     define variable v-date as datetime  no-undo .
      557     v-date = now.
      558     return string(v-date) .
      559   end.
      560   define variable counter    as integer   no-undo .
      561   define variable rec-full   as character no-undo .
      562   define variable v-rec-name as character no-undo .
      563   define variable v-today    as date      no-undo .
      564   define variable v-time     as integer   no-undo .
      565   define temp-table buf_temp-ord-doc-rcv no-undo like ub.ord-doc-rcv.
      566   on WRITE of ub.ord-doc-rcv override do: end.
      567   do
      568   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      569   on stop   undo, return error substitute( "&1. stop", vss-workfile )
      570   on endkey undo, return error substitute( "&1. endkey", vss-workfile )
      571   :
      572     do counter = 1 to p-counter
      573     on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      574     on stop   undo, return error substitute( "&1. stop", vss-workfile )
      575     on endkey undo, return error substitute( "&1. endkey", vss-workfile )
      576     :
      577       if counter modulo 10 = 0
      578       then do:
      579         run waitfram-show in this-procedure
      580           (input substitute("Получение изменений шапки поставки в статусе ПОСТАВКА Получено &1", counter)
      581           ) .
      582       end.
      583       run nws-imps in p-imp-handle
      584         ( input-output counter
      585          ,output       rec-full
      586         ) no-error.
      587       if error-status :error then do:
      588         return error return-value .
      589       end.
      590       assign
      591         v-rec-name = entry( 1, rec-full, chr(1) )
      592       .
      593       CASE entry(1, v-rec-name, chr(4)) :
      594         when 'ord-doc-rcv':U
      595         then do:
      596           create buf_temp-ord-doc-rcv .
      597           run nws-impl in p-imp-handle
      598             ( input 'ord-doc-rcv':U
      599              ,input (buffer buf_temp-ord-doc-rcv:handle)
      600             ) no-error.
      601           if error-status :error then do:
      602             return error return-value .
      603           end.
      604         end.
      605         otherwise do:
      606           message
      607             vss-workfile vss-revision vss-description skip
      608             "Не предусмотрен прием таблицы " v-rec-name skip
      609             view-as alert-box error .
      610           return error .
      611         end.
      612       end case.
      613     end.
      614     run waitfram-hide .
      615     define variable v-ind as integer   no-undo .
      616     do transaction
      617     on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      618     on stop   undo, return error substitute( "&1. stop",   vss-workfile )
      619     on endkey undo, return error substitute( "&1. endkey", vss-workfile )
      620     :
      621     define buffer buf_ord-doc-rcv for ub.ord-doc-rcv  .
      622      for each buf_temp-ord-doc-rcv where buf_temp-ord-doc-rcv.doc-code = p-doc-code and buf_temp-ord-doc-rcv.rcv-code = p-rcv-code :
      623          find first buf_ord-doc-rcv exclusive-lock
      624                 where buf_ord-doc-rcv.doc-code = p-doc-code and buf_ord-doc-rcv.rcv-code = p-rcv-code  no-error .
      625                   if  not available buf_ord-doc-rcv then do:
      626                         message
      627                           vss-workfile vss-revision vss-description skip
      628                           error-status :get-message(1)
      629                           "При поиске поставки №" p-rcv-code p-doc-code
      630                           view-as alert-box error .
      631                         return error .
      632                   end.
      633           assign
      634             buf_ord-doc-rcv.ship-date      = buf_temp-ord-doc-rcv.ship-date
      635             buf_ord-doc-rcv.ship-time      = buf_temp-ord-doc-rcv.ship-time
      636             buf_ord-doc-rcv.fact-ship-time = buf_temp-ord-doc-rcv.fact-ship-time
      637           .
      638       end.
      639      end.
      640   end.
