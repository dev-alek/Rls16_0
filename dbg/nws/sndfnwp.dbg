        1   define input parameter parparentproc as widget-handle no-undo .
        2   define input parameter p-mode as character no-undo .
        3   define input parameter p-list-mode as character no-undo .
        4   define input parameter p-db-num as integer no-undo .
        5   define input parameter p-from-db-num as integer no-undo .
        6   define input parameter p-file-num as integer no-undo .
        7   DEFINE variable vss-revision    as character no-undo init "$Revision$":U .
        8   DEFINE variable vss-author      as character no-undo init "$Author$":U .
        9   DEFINE variable vss-date        as character no-undo init "$Date$":U .
       10   DEFINE variable vss-workfile    as character no-undo init "$Workfile$":U .
       11   DEFINE variable vss-archive     as character no-undo init "$Archive$":U .
       12   DEFINE variable vss-description as character no-undo init "Окно ввода параметров".
       13   procedure vss-get-info :
       14     define output parameter p-vss-revision    like vss-revision    no-undo .
       15     define output parameter p-vss-author      like vss-author      no-undo .
       16     define output parameter p-vss-date        like vss-date        no-undo .
       17     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       18     define output parameter p-vss-archive     like vss-archive     no-undo .
       19     define output parameter p-vss-description like vss-description no-undo .
       20     assign
       21       p-vss-revision    = vss-revision
       22       p-vss-author      = vss-author
       23       p-vss-date        = vss-date
       24       p-vss-workfile    = vss-workfile
       25       p-vss-archive     = vss-archive
       26       p-vss-description = vss-description
       27     .
       28   end procedure.
       29   procedure vss-get-parameters :
       30     define output parameter p-vss-parameters as character no-undo .
       31   end procedure.
       32   define new global shared variable g#vssrevis-logger as handle    no-undo .
       33   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       34   define variable v-vssrevis-logger                   as handle    no-undo .
       35   procedure vss-logevent :
       36     define input  parameter p-extra-paramters as character no-undo .
       37     define variable v-vssrevis-parameters as character no-undo .
       38     do
       39     on error undo, return error return-value
       40     :
       41       if  valid-handle(v-vssrevis-logger)
       42       and v-vssrevis-logger :get-signature("logevent") <> ""
       43       then do:
       44         run vss-get-parameters in this-procedure
       45           (output v-vssrevis-parameters
       46           ).
       47         run logevent in v-vssrevis-logger
       48           (input vss-workfile
       49           ,input vss-revision
       50           ,input v-vssrevis-parameters
       51           ,input p-extra-paramters
       52           ).
       53       end.
       54     end.
       55   end procedure.
       56   assign
       57     v-vssrevis-logger = g#vssrevis-logger
       58   .
       59   if  valid-handle(v-vssrevis-logger)
       60   and v-vssrevis-logger :get-signature("logevent") <> ""
       61   then do:
       62     assign
       63       v-vssrevis-logevent = true
       64     .
       65     run vss-logevent in this-procedure (input vss-description) .
       66   end.
       67   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       68   define variable v-waitfram-action01         as character   no-undo .
       69   define variable v-waitfram-action02         as character   no-undo .
       70   define variable v-waitfram-action03         as character   no-undo .
       71   define variable mWaitFramTextBeg            as character   no-undo.
       72   define variable mWaitFramTextEnd            as character   no-undo.
       73   define variable mWaitFramView               as logical     no-undo.
       74   define variable mWaitProcEvent              as logical     no-undo init yes.
       75   define variable mWaitFramInterval           as integer     no-undo init 1 .
       76   define variable mWaitFramStop               as logical     no-undo.
       77   define variable mWaitFramStopUser           as logical     no-undo.
       78   define variable mWaitFramStopTimeOut        as logical     no-undo.
       79   define variable mWaitFramStartProc          as datetime-tz no-undo.
       80   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       81   define button B-WaitFramStop auto-end-key
       82        label "Стоп"
       83        size 10 by 1 tooltip "Остоновить процесс".
       84   define button B-viewProcInfo
       85        label "Информация"
       86        size 15 by 1 tooltip "Информация о процесс".
       87   define frame waitfram
       88     v-waitfram-action01 format "x(72)" no-label skip
       89     v-waitfram-action02 format "x(72)" no-label skip
       90     v-waitfram-action03 format "x(72)" no-label skip
       91     B-viewProcInfo
       92     B-WaitFramStop at row 4 col 30
       93     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
       94     .
       95   define new global shared variable mBatchMode as logical no-undo init ?.
       96   define variable mFramBachModHandle as handle no-undo.
       97   mFramBachModHandle = frame waitfram:handle.
       98   define variable mFameOldVis as logical no-undo.
       99   define variable mVisCUrentVin as logical no-undo.
      100   if session:batch-mode
      101   then
      102      mBatchMode = yes.
      103   if mBatchMode = ? then do:
      104     mVisCUrentVin = current-window:visible.
      105     mFameOldVis = mFramBachModHandle:visible.
      106     mFramBachModHandle:visible  = yes.
      107     mBatchMode = mFramBachModHandle:visible ne yes.
      108     mFramBachModHandle:visible = mFameOldVis.
      109     current-window:visible = mVisCUrentVin.
      110   end.
      111    if  log-manager:logfile-name ne ?
      112     then DO:
      113         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      114         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      115         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      116     end.
      117   on choose of B-WaitFramStop in frame waitfram
      118   do:
      119     mWaitFramStop = yes.
      120     mWaitFramStopUser = yes.
      121   end.
      122   function waitfram-check-timeout returns logical():
      123      define variable vtime as int64 no-undo.
      124      if mWaitFramStopTimeOut
      125      then
      126         return yes.
      127      vtime = ( now - mWaitFramStartProc ) / 1000 .
      128      if     mWaitFramTimeOut ne ?
      129         and mWaitFramTimeOut ne 0
      130         and mWaitFramTimeOut lt vtime
      131      then do:
      132         mWaitFramStopTimeOut = yes.
      133      end.
      134      return mWaitFramStopTimeOut.
      135   end.
      136   procedure waitfram-hide :
      137     if not session:batch-mode
      138     then do
      139     on error undo, return error return-value
      140     :
      141       pause 0 before-hide .
      142       if not mBatchMode then
      143         hide frame waitfram .
      144     if     not mWaitFramView
      145        and mWaitProcEvent
      146     then
      147       process events .
      148     end.
      149   end procedure.
      150   procedure waitfram-show :
      151     define input  parameter p-message as character no-undo .
      152     define variable v-left-margin as integer   no-undo .
      153     if not session:batch-mode
      154     then do
      155     on error undo, return error return-value
      156     :
      157       if length(p-message) <= 70 then do:
      158         assign
      159           v-left-margin = integer((70 - length(p-message)) / 2)
      160         .
      161         assign
      162           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      163         .
      164         assign
      165           v-waitfram-action01 = " "
      166           v-waitfram-action02 = " "
      167                                    + fill(" ", v-left-margin)
      168                                    + p-message
      169           v-waitfram-action03 = " "
      170         .
      171       end.
      172       else do:
      173         define variable vRindex1 as integer no-undo.
      174         define variable vRindex2 as integer no-undo.
      175         vRindex1 = r-index(p-message," ",70).
      176         if vRindex1 = 0
      177         then
      178            vRindex1 = 70.
      179         if length(p-message)  <= vRindex1 + 70 then do:
      180           assign
      181             v-waitfram-action01 = " "
      182             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      183             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      184           .
      185         end.
      186         else do:
      187           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      188           if vRindex2 <= vRindex1
      189           then
      190              vRindex2 = vRindex1 + 70.
      191           assign
      192             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      193             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      194             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      195           .
      196         end.
      197       end.
      198       B-viewProcInfo:visible   in frame waitfram = no.
      199       B-viewProcInfo:sensitive in frame waitfram = no.
      200       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      201       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      202       if  (   mWaitFramView
      203          or  mWaitProcEvent)
      204          and not mBatchMode
      205       then
      206          display
      207             v-waitfram-action01 skip
      208             v-waitfram-action02 skip
      209             v-waitfram-action03 skip
      210          with frame waitfram .
      211       if     mWaitFramView
      212          then do:
      213             if     mWaitFramInterval ne ?
      214                and not mBatchMode
      215             then
      216                wait-for go of frame waitfram pause mWaitFramInterval.
      217          end.
      218          else
      219             if     mWaitProcEvent
      220                and not mBatchMode
      221             then
      222                process events .
      223     end.
      224   end procedure.
      225      procedure waitfram-show-this:
      226         define input  parameter iInterval as int64 no-undo.
      227         define variable vtime as int64 no-undo.
      228         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      229         mWaitFramInterval = iInterval.
      230         run waitfram-show (substitute("&1&2 &3&4" ,
      231                                       mWaitFramTextBeg ,
      232                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      233                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      234                                       mWaitFramTextEnd
      235                                      )
      236                           ).
      237      end.
      238      procedure WaitFramRunPause:
      239         define input  parameter iInterval as dec no-undo.
      240         define variable vStart  as datetime-tz no-undo.
      241         define variable vend    as datetime-tz no-undo.
      242         define variable vint as int64 no-undo.
      243         define variable vOk as logical no-undo.
      244         vStart = now.
      245         vend   = vStart.
      246         publish "WaitFramPause" (iInterval,output vOk).
      247         vend   =  now.
      248         vint = vend - vStart.
      249         vint = iInterval - vint / 1000.
      250         if     not mWaitFramStop
      251            and (   vint > 0
      252                 or (    not vOk
      253                     and iInterval eq ?
      254                     )
      255                 )
      256         then
      257            run waitfram-show-this (iInterval).
      258         vend   =  now.
      259         vint = vend - vStart.
      260         vint = iInterval - vint / 1000.
      261         if     not mWaitFramStop
      262            and vint > 0
      263         then do:
      264            run gbl/pause.p (vint * 1000).
      265         end.
      266         if iInterval ne ?
      267         then
      268            publish "WaitFramStop".
      269         waitfram-check-timeout().
      270      end.
      271      procedure WaitFramWaitFor:
      272         define input  parameter iInterval as dec no-undo.
      273         assign
      274            mWaitFramStartProc   = now
      275            mWaitFramStopUser    = no
      276            mWaitFramStopTimeOut = no
      277         .
      278         block-wait:
      279         do while not mWaitFramStop:
      280            run WaitFramRunPause (iInterval).
      281            if  waitfram-check-timeout()
      282            then do:
      283               leave block-wait.
      284            end.
      285         end.
      286         run waitfram-hide.
      287      end.
      288   procedure waitfram-join :
      289     define input  parameter p-line-1  as character no-undo .
      290     define input  parameter p-line-2  as character no-undo .
      291     define input  parameter p-line-3  as character no-undo .
      292     define output parameter p-message as character no-undo .
      293     do
      294     on error undo, return error return-value
      295     :
      296       assign
      297         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      298                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      299                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      300       .
      301     end.
      302   end procedure.
      303   function waitfram-join-function returns character
      304     (input p-line-1 as character
      305     ,input p-line-2 as character
      306     ,input p-line-3 as character
      307     ).
      308     define variable v-message as character no-undo .
      309     run waitfram-join in this-procedure
      310       (input  p-line-1
      311       ,input  p-line-2
      312       ,input  p-line-3
      313       ,output v-message
      314       ) .
      315     return v-message .
      316   end function .
      317   define new global shared variable g#language as character no-undo .
      318   if g#language <> '' and g#language <> 'rus':U then do:
      319     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      320   end.
      321   define new global shared variable g#library  as handle no-undo .
      322   define new global shared variable g#library2 as handle no-undo .
      323   procedure proc-alt-shift-f2:
      324     if not ibs.th.gbl.gbl-var:rcode
      325   then
      326     run gbl\inidebug.p .
      327   end.
      328   procedure proc-alt-shift-f3:
      329     run gbl/prvssinf.p
      330       ( input this-procedure
      331       ) .
      332   end.
      333   define variable v-inform-launched as logical no-undo initial false .
      334   procedure proc-alt-shift-f4:
      335     define variable v-action as character no-undo .
      336     if v-inform-launched = false then do:
      337       assign
      338         v-inform-launched = true
      339       .
      340       run gbl/d-inform.w
      341         (  input self
      342         ,  input this-procedure
      343         , output v-action
      344         ) no-error .
      345       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      346       assign
      347         v-inform-launched = false
      348       .
      349     end.
      350   end.
      351   procedure proc-alt-f1:
      352     run gbl/corrhelp.p
      353       (input this-procedure
      354       ) .
      355   end .
      356   on alt-shift-f2 anywhere do:
      357     run proc-alt-shift-f2.
      358   end.
      359   on alt-shift-f3 anywhere do:
      360     run proc-alt-shift-f3 in this-procedure .
      361   end.
      362   on alt-shift-f4 anywhere do:
      363     run proc-alt-shift-f4 in this-procedure.
      364   end.
      365   on alt-f1 anywhere do:
      366     run proc-alt-f1 in this-procedure .
      367   end.
      368   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      369   define  shared temp-table tt-ext-file-par no-undo like ub.ext-file-par.
      370   procedure ext-file-par-clear-temp :
      371     define buffer buf_tt-ext-file-par for tt-ext-file-par .
      372     do
      373     on error undo, return error return-value
      374     :
      375       for each buf_tt-ext-file-par
      376       on error undo, return error
      377       :
      378         delete buf_tt-ext-file-par .
      379       end.
      380     end.
      381   end procedure.
      382   procedure ext-file-par-write-temp :
      383     define input  parameter p-db-num      as integer no-undo .
      384     define input  parameter p-from-db-num      as integer no-undo .
      385     define input  parameter p-file-num      as integer no-undo .
      386     define input  parameter p-param-num      as integer no-undo .
      387     define input  parameter p-value-type as character no-undo .
      388     define input  parameter p-value-name as character no-undo .
      389     define input  parameter p-value-char as character no-undo .
      390     define input  parameter p-value-date as date      no-undo .
      391     define input  parameter p-value-integer as integer      no-undo .
      392     define input  parameter p-value-decimal as decimal      no-undo .
      393     define input  parameter p-value-logical as logical      no-undo .
      394     define buffer buf_tt-ext-file-par for tt-ext-file-par .
      395     do
      396     on error undo, return error return-value
      397     :
      398       find first buf_tt-ext-file-par
      399         where buf_tt-ext-file-par.db-num        = p-db-num
      400           and buf_tt-ext-file-par.file-num      = p-file-num
      401           and buf_tt-ext-file-par.from-db-num   = p-from-db-num
      402           and buf_tt-ext-file-par.param-type    = p-value-type
      403           and buf_tt-ext-file-par.param-name    = p-value-name
      404         no-error .
      405       if not available buf_tt-ext-file-par then do:
      406         create buf_tt-ext-file-par .
      407         assign
      408           buf_tt-ext-file-par.db-num         = p-db-num
      409           buf_tt-ext-file-par.from-db-num    = p-from-db-num
      410           buf_tt-ext-file-par.file-num       = p-file-num
      411           buf_tt-ext-file-par.param-num      = p-param-num
      412           buf_tt-ext-file-par.param-type     = p-value-type
      413           buf_tt-ext-file-par.user-db-num    = p-db-num
      414                 .
      415       end.
      416       CASE p-value-type:
      417         when 'C':U
      418         or when 'uniq-key-rec':U
      419         then do:
      420           assign
      421           buf_tt-ext-file-par.param-name = p-value-name
      422           buf_tt-ext-file-par.param-value = p-value-char
      423           .
      424         end.
      425         when 'T':U then do:
      426           assign
      427           buf_tt-ext-file-par.param-date-name = p-value-name
      428           buf_tt-ext-file-par.param-date-value = p-value-date
      429           .
      430         end.
      431         when 'I':U then do:
      432           assign
      433           buf_tt-ext-file-par.param-int-name = p-value-name
      434           buf_tt-ext-file-par.param-int-value = p-value-integer
      435           .
      436         end.
      437         when 'L':U then do:
      438           assign
      439           buf_tt-ext-file-par.param-log-name = p-value-name
      440           buf_tt-ext-file-par.param-log-value = p-value-logical
      441           .
      442         end.
      443         when 'D':U then do:
      444           assign
      445           buf_tt-ext-file-par.param-decimal-name = p-value-name
      446           buf_tt-ext-file-par.param-decimal-value = p-value-decimal
      447           .
      448         end.
      449       END CASE.
      450     end.
      451   end procedure.
      452   procedure ext-file-par-write-and-send :
      453     define input  parameter p-db-num      as integer no-undo .
      454     define input  parameter p-from-db-num      as integer no-undo .
      455     define input  parameter p-file-num      as integer no-undo .
      456     define input  parameter p-param-num      as integer no-undo .
      457     define input  parameter p-value-type as character no-undo .
      458     define input  parameter p-value-name as character no-undo .
      459     define input  parameter p-value-char as character no-undo .
      460     define input  parameter p-value-date as date      no-undo .
      461     define input  parameter p-value-integer as integer      no-undo .
      462     define input  parameter p-value-decimal as decimal      no-undo .
      463     define input  parameter p-value-logical as logical      no-undo .
      464     define input  parameter p-send        as logical no-undo .
      465     define input  parameter p-list-db-num as character no-undo .
      466     define buffer buf_ext-file-par for ub.ext-file-par .
      467     do
      468     on error undo, return error return-value
      469     :
      470       find first buf_ext-file-par
      471         where buf_ext-file-par.db-num         = p-db-num
      472           and buf_ext-file-par.from-db-num    = p-from-db-num
      473           and buf_ext-file-par.file-num       = p-file-num
      474           and buf_ext-file-par.param-num      = p-param-num
      475         no-error .
      476       if not available buf_ext-file-par then do:
      477         create buf_ext-file-par .
      478         assign
      479           buf_ext-file-par.db-num    = p-db-num
      480           buf_ext-file-par.from-db-num    = p-from-db-num
      481           buf_ext-file-par.file-num    = p-file-num
      482           buf_ext-file-par.param-num    = p-param-num
      483           buf_ext-file-par.param-type   = p-value-type
      484           buf_ext-file-par.user-db-num    = p-db-num
      485         .
      486       end.
      487       CASE p-value-type:
      488         when 'C':U
      489         or when ''
      490         or when 'uniq-key-rec':U
      491         then do:
      492           assign
      493           buf_ext-file-par.param-name = p-value-name
      494           buf_ext-file-par.param-value = p-value-char
      495           .
      496           if p-value-type = ''
      497           and p-param-num = 0 then do:
      498             buf_ext-file-par.param-log-value = p-value-logical.
      499           end.
      500         end.
      501         when 'T':U then do:
      502           assign
      503           buf_ext-file-par.param-date-name = p-value-name
      504           buf_ext-file-par.param-date-value = p-value-date
      505           .
      506         end.
      507         when 'I':U then do:
      508           assign
      509           buf_ext-file-par.param-int-name = p-value-name
      510           buf_ext-file-par.param-int-value = p-value-integer
      511           .
      512         end.
      513         when 'D':U then do:
      514           assign
      515           buf_ext-file-par.param-decimal-name = p-value-name
      516           buf_ext-file-par.param-decimal-value = p-value-decimal
      517           .
      518         end.
      519         when 'L':U then do:
      520           assign
      521           buf_ext-file-par.param-log-name = p-value-name
      522           buf_ext-file-par.param-log-value = p-value-logical
      523           .
      524         end.
      525       END CASE.
      526       if p-send then do:
      527         run nws/cr-route.p (
      528                         input 'send-tbl':U
      529                       , input 'ext-file-par':U
      530                       , input buffer buf_ext-file-par:handle
      531                       , input p-list-db-num) no-error.
      532       end.
      533     end.
      534   end procedure.
      535   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      536   DEF VAR BLACK_COLOR        AS INTEGER NO-UNDO INIT  0.
      537   DEF VAR DARK_BLUE_COLOR    AS INTEGER NO-UNDO INIT  1.
      538   DEF VAR DARK_GREEN_COLOR   AS INTEGER NO-UNDO INIT  2.
      539   DEF VAR CYAN_COLOR         AS INTEGER NO-UNDO INIT  3.
      540   DEF VAR BROWN_COLOR        AS INTEGER NO-UNDO INIT  4.
      541   DEF VAR DARK_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
      542   DEF VAR DARK_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
      543   DEF VAR VERY_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
      544   DEF VAR VERY_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
      545   DEF VAR GRAY_COLOR         AS INTEGER NO-UNDO INIT  8.
      546   DEF VAR GREY_COLOR         AS INTEGER NO-UNDO INIT  8.
      547   DEF VAR BLUE_COLOR         AS INTEGER NO-UNDO INIT  9.
      548   DEF VAR GREEN_COLOR        AS INTEGER NO-UNDO INIT 10.
      549   DEF VAR RED_COLOR          AS INTEGER NO-UNDO INIT 12.
      550   DEF VAR LIGHT_RED_COLOR    AS INTEGER NO-UNDO INIT 13.
      551   DEF VAR YELLOW_COLOR       AS INTEGER NO-UNDO INIT 14.
      552   DEF VAR WHITE_COLOR        AS INTEGER NO-UNDO INIT 15.
      553   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      554   procedure cur-time :
      555      define output parameter p-today as date      no-undo .
      556      define output parameter p-time  as integer   no-undo .
      557     do
      558     on error undo, return error
      559     :
      560       define variable v-date1 as date      no-undo .
      561       define variable v-date2 as date      no-undo .
      562       define variable v-time  as integer   no-undo .
      563       assign
      564         v-date1 = today
      565         v-time  = time
      566         v-date2 = today
      567       .
      568       if v-date1 <> v-date2
      569       then do:
      570         assign
      571           v-date1 = today
      572           v-time  = v-time
      573         .
      574       end.
      575       assign
      576         p-today = v-date1
      577         p-time  = v-time
      578       .
      579     end.
      580   end.
      581   function cur-time-date returns character
      582   :
      583     return string(today, '99/99/9999':U) .
      584   end.
      585   function cur-time-mjd returns decimal
      586   :
      587     define variable v-date as date      no-undo .
      588     define variable v-time as integer   no-undo .
      589     run cur-time in this-procedure
      590       (output v-date
      591       ,output v-time
      592       ) .
      593     return integer(v-date) - 2400002 + (v-time / 86400) .
      594   end.
      595   function cur-time-get-ending-index returns integer
      596   (input p-number as integer
      597   )
      598   :
      599     if p-number < 0
      600     or p-number = ?
      601     then do:
      602       return 1 .
      603     end.
      604     define variable v-rest as integer   no-undo .
      605     assign
      606       p-number = p-number modulo 100
      607     .
      608     if p-number < 20
      609     then do:
      610       assign
      611         v-rest = p-number
      612       .
      613     end.
      614     else do:
      615       assign
      616         v-rest = p-number modulo 10
      617       .
      618     end.
      619     case v-rest :
      620       when 1
      621       then do:
      622         return 2 .
      623       end.
      624       when 2 or
      625       when 3 or
      626       when 4
      627       then do:
      628         return 3 .
      629       end.
      630       otherwise do:
      631         return 1 .
      632       end.
      633     end case .
      634   end.
      635   procedure cur-time-mjd-to-date :
      636      define input  parameter i-mjd-diff as decimal no-undo.
      637      define output parameter o-Date     as date    no-undo.
      638      define output parameter o-Time     as integer no-undo.
      639      define variable v-day-number as integer   no-undo .
      640      if    i-mjd-diff < 0
      641         or i-mjd-diff = ?
      642      then do:
      643         return "?" .
      644      end.
      645      assign
      646         v-day-number = truncate(i-mjd-diff,0).
      647         o-Date = date(v-day-number + 2400002).
      648         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      649     .
      650   end.
      651   function cur-time-mjd-to-string returns character
      652   (input p-mjd-diff as decimal
      653   )
      654   :
      655     define variable v-day-number as integer   no-undo .
      656     define variable v-seconds    as integer   no-undo .
      657     define variable v-hour       as integer   no-undo .
      658     define variable v-min        as integer   no-undo .
      659     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      660     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      661     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      662     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      663     if p-mjd-diff < 0
      664     or p-mjd-diff = ?
      665     then do:
      666       return "?" .
      667     end.
      668     assign
      669       v-day-number = integer(truncate(p-mjd-diff,0))
      670       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      671     .
      672     if v-seconds > 86400
      673     then do:
      674       assign
      675         v-seconds = 86400 - 1
      676       .
      677     end.
      678     if v-seconds < 0
      679     then do:
      680       assign
      681         v-seconds = 0
      682       .
      683     end.
      684     assign
      685       v-hour = truncate(v-seconds / 3600, 0)
      686     .
      687     assign
      688       v-seconds = v-seconds modulo 3600
      689     .
      690     assign
      691       v-min = truncate(v-seconds / 60, 0)
      692     .
      693     assign
      694       v-seconds = v-seconds modulo 60
      695     .
      696     return
      697         (if v-day-number <> 0
      698           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      699           else ""
      700         )
      701       + (if v-day-number <> 0 or v-hour <> 0
      702           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      703           else ""
      704         )
      705       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      706           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      707           else ""
      708         )
      709       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      710       .
      711   end.
      712   function cur-time-string returns character
      713   :
      714     define variable v-date as date      no-undo .
      715     define variable v-time as integer   no-undo .
      716     run cur-time in this-procedure
      717       (output v-date
      718       ,output v-time
      719       ) .
      720     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      721   end.
      722   function cur-time-string-sec returns character
      723   :
      724     define variable v-date as date      no-undo .
      725     define variable v-time as integer   no-undo .
      726     run cur-time in this-procedure
      727       (output v-date
      728       ,output v-time
      729       ) .
      730     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      731   end.
      732   function cur-time-custom  returns character
      733   (input p-prefix as character
      734   ,input p-date-format as character
      735   ,input p-delimiter as character
      736   ,input p-time-format as character
      737   ,input p-suffix as character
      738   )
      739   :
      740     define variable v-date as date      no-undo .
      741     define variable v-time as integer   no-undo .
      742     run cur-time in this-procedure
      743       (output v-date
      744       ,output v-time
      745       ) .
      746     return
      747       p-prefix
      748       + string(v-date, p-date-format)
      749       + p-delimiter
      750       + string(v-time, p-time-format)
      751       + p-suffix
      752       .
      753   end.
      754   function cur-time-print  returns character
      755   :
      756     define variable v-date as date      no-undo .
      757     define variable v-time as integer   no-undo .
      758     run cur-time in this-procedure
      759       (output v-date
      760       ,output v-time
      761       ) .
      762     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      763   end.
      764   function cur-time-datetime returns datetime
      765   :
      766     define variable v-char as character no-undo .
      767     define variable v-datetime as datetime no-undo .
      768     v-char = cur-time-string().
      769     v-datetime = datetime(v-char).
      770     return  v-datetime.
      771   end.
      772   function cur-time-string-msec returns character
      773   :
      774     define variable v-date as datetime  no-undo .
      775     v-date = now.
      776     return string(v-date) .
      777   end.
      778   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      779   function prepare-path returns character ( input p-nonprepared-path as character ):
      780   define variable v-prepared-path as character no-undo .
      781   assign
      782   v-prepared-path = replace(p-nonprepared-path, chr(92), chr(47))
      783   v-prepared-path = right-trim(v-prepared-path, chr(47))
      784   .
      785   return v-prepared-path.
      786   END FUNCTION.
      787   function prepare-path2 returns character ( input p-nonprepared-path as character ):
      788   define variable v-prepared-path as character no-undo .
      789   assign
      790   v-prepared-path = replace(p-nonprepared-path, chr(47), chr(92))
      791   v-prepared-path = right-trim(v-prepared-path, chr(92))
      792   .
      793   return v-prepared-path.
      794   END FUNCTION.
      795   function quote-spaces returns character ( input p-full-path as character):
      796   define variable v-ii as integer no-undo .
      797   define variable v-result as character no-undo .
      798   do v-ii = 1 to num-entries(p-full-path, chr(92)):
      799     v-result = v-result + (if v-ii = 1 then '' else chr(92)) +
      800                (if index(entry(v-ii, p-full-path, chr(92)), chr(32)) > 0
      801                then  substitute("&1&2&1", chr(34), entry(v-ii, p-full-path, chr(92)))
      802                else entry(v-ii, p-full-path, chr(92))
      803                )
      804     .
      805   end.
      806   return v-result.
      807   end function.
      808   def var vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      809   procedure gen-key-rec :
      810     define input  parameter p-tbl-name    as character no-undo.
      811     define input  parameter p-bh_tbl-name as handle    no-undo.
      812     define output parameter p-key-rec     as character no-undo.
      813     do
      814     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      815     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      816     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      817     :
      818       define variable fh               as handle    no-undo .
      819       define variable v-ok             as logical   no-undo .
      820       define variable v-inform         as character no-undo .
      821       define variable v-ind            as integer   no-undo .
      822       define variable v-idx-field-qnty as integer   no-undo .
      823       if p-tbl-name = ?
      824         or p-tbl-name = "":U
      825       then do:
      826         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info5 ).
      827       end.
      828       if not p-bh_tbl-name:available then do:
      829         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info5, p-tbl-name ).
      830       end.
      831       assign
      832         p-key-rec = p-tbl-name
      833         v-inform  = p-bh_tbl-name:index-information(1)
      834         v-ind     = 2
      835       .
      836       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      837       on error undo, return error
      838       :
      839         assign
      840           v-inform = p-bh_tbl-name:index-information( v-ind )
      841           v-ind    = v-ind + 1
      842         .
      843       end.
      844       if v-inform = ?
      845         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      846         or entry( 3, v-inform, ",":U ) <> "1":U
      847       then do:
      848         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info5, p-tbl-name ).
      849       end.
      850       else do:
      851         assign
      852           v-idx-field-qnty = num-entries( v-inform ) - 4
      853         .
      854         if v-idx-field-qnty < 2 then do:
      855           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info5, v-inform, p-tbl-name ).
      856         end.
      857         do v-ind = 1 to v-idx-field-qnty by 2
      858         on error undo, return error
      859         :
      860           assign
      861             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      862             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      863           .
      864         end.
      865       end.
      866       if p-key-rec = ? then do:
      867         assign
      868           p-key-rec = "":U
      869         .
      870         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info5, p-tbl-name ).
      871       end.
      872     end.
      873     return.
      874   end procedure.
      875   procedure gen-where-keyr-tab :
      876     define input  parameter i-tableSerach as character no-undo.
      877     define input  parameter i-tablekey   as character  no-undo.
      878     define input  parameter p-key-rec    as character  no-undo.
      879     define input  parameter p-key-handle as handle     no-undo .
      880     define input  parameter p-db-name    as character  no-undo .
      881     define input  parameter p-tt-handle  as handle     no-undo .
      882     define output parameter o-Where      as character  no-undo.
      883     do
      884     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      885     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      886     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      887     :
      888       define variable v-full-tbl-name  as character no-undo .
      889       define variable bh_tbl-name      as handle    no-undo .
      890       define variable fh_key           as handle    no-undo .
      891       define variable fh_search        as handle    no-undo .
      892       define variable v-field-num      as integer   no-undo .
      893       define variable v-count-fld      as integer   no-undo .
      894       define variable v-inform         as character no-undo .
      895       define variable v-ind            as integer   no-undo .
      896       define variable v-idx-field-qnty as integer   no-undo .
      897       define variable v-field-name     as character no-undo .
      898       define variable v-field-val      as character no-undo .
      899       define variable v-word-link      as character no-undo .
      900       define variable vTable           as character no-undo.
      901       define variable bh_tbl-key       as handle    no-undo .
      902       assign
      903         p-key-rec = trim( p-key-rec )
      904       .
      905       if p-key-handle <> ? then do:
      906         if not valid-handle(p-key-handle)
      907            or p-key-handle:type <> "buffer"
      908         then do:
      909           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info5 ).
      910         end.
      911         if num-entries( p-key-rec, chr(3) ) > 1
      912           or p-key-rec = ?
      913           or p-key-rec = "":U
      914         then do:
      915           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info5, p-key-rec ).
      916         end.
      917       end.
      918       else do:
      919         if p-key-rec = ?
      920           or p-key-rec = "":U
      921         then do:
      922           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info5 ).
      923         end.
      924       end.
      925       assign
      926         vTable = entry( 1 , p-key-rec, chr(3) )
      927       .
      928       if p-tt-handle <> ?
      929         and ( not valid-handle(p-tt-handle)
      930               or p-tt-handle:type <> "buffer"
      931             )
      932       then do:
      933         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info5, vTable, chr(10) ).
      934       end.
      935       if p-tt-handle = ? then do:
      936         assign
      937           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      938         .
      939         create buffer bh_tbl-name for table v-full-tbl-name .
      940       end.
      941       else do:
      942         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      943       end.
      944       assign
      945         v-inform = bh_tbl-name:index-information(1)
      946         v-ind    = 2
      947       .
      948       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      949       on error undo, return error
      950       :
      951         assign
      952           v-inform = bh_tbl-name:index-information( v-ind )
      953           v-ind    = v-ind + 1
      954         .
      955       end.
      956       if v-inform = ?
      957         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      958         or entry( 3, v-inform, ",":U ) <> "1":U
      959       then do:
      960         delete object bh_tbl-name no-error.
      961         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info5, vTable ).
      962       end.
      963       assign
      964         v-idx-field-qnty = num-entries( v-inform ) - 4
      965       .
      966       if v-idx-field-qnty < 2 then do:
      967         delete object bh_tbl-name no-error.
      968         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info5, v-inform, vTable ).
      969       end.
      970       assign
      971         o-where     = "where":U
      972         v-word-link = "":U
      973         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      974         v-count-fld = 0
      975       .
      976       if i-tablekey ne "" and i-tablekey ne ?
      977       then do:
      978         assign
      979           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      980         .
      981         create buffer bh_tbl-key for table v-full-tbl-name .
      982       end.
      983       if i-tableSerach ne "" and i-tableSerach ne ?
      984       then do:
      985         delete object bh_tbl-name no-error.
      986         assign
      987           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      988         .
      989         create buffer bh_tbl-name for table v-full-tbl-name .
      990       end.
      991       block_where:
      992       do v-ind = 1 to v-idx-field-qnty by 2
      993       on error undo, return error
      994       :
      995         assign
      996           v-count-fld = v-count-fld + 1
      997         .
      998         if p-key-handle = ?
      999           and v-count-fld > v-field-num
     1000         then do:
     1001           leave block_where.
     1002         end.
     1003         define variable VfieldKeyTable as handle no-undo.
     1004         assign
     1005           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     1006           fh_search    = bh_tbl-name:buffer-field( v-field-name )
     1007         .
     1008         if     bh_tbl-key ne ?
     1009         then do:
     1010            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
     1011            if VfieldKeyTable eq ?
     1012            then next block_where.
     1013         end.
     1014         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
     1015         then
     1016            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
     1017         else
     1018            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
     1019         if p-key-handle = ? then do:
     1020           assign
     1021             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
     1022           .
     1023         end.
     1024         else do:
     1025           assign
     1026             fh_key = p-key-handle:buffer-field( v-field-name )
     1027           .
     1028           if fh_key = ?
     1029             or not valid-handle( fh_key )
     1030           then do:
     1031             delete object bh_tbl-name.
     1032             if     bh_tbl-key ne ?
     1033             then
     1034                delete object bh_tbl-key.
     1035             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info5, p-key-handle:name, v-field-name ).
     1036           end.
     1037           assign
     1038             v-field-val = fh_key:buffer-value
     1039           .
     1040         end.
     1041         if fh_search:data-type ="character":U then do:
     1042           assign
     1043             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
     1044             v-field-val = replace( v-field-val, '"':U, '~~"':U )
     1045             v-field-val = replace( v-field-val, "'":U, "~~'":U )
     1046             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
     1047             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
     1048             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
     1049             v-field-val = replace( v-field-val, chr(10), '~~n':U )
     1050             v-field-val = replace( v-field-val, chr(9), '~~t':U )
     1051             v-field-val = replace( v-field-val, chr(13), '~~r':U )
     1052             v-field-val = replace( v-field-val, chr(27), '~~E':U )
     1053             v-field-val = replace( v-field-val, chr(8), '~~b':U )
     1054             v-field-val = replace( v-field-val, chr(12), '~~f':U )
     1055             v-field-val = substitute( '"&1"', v-field-val )
     1056           .
     1057         end.
     1058         assign
     1059           o-where = substitute( "&1 &2", o-where, v-field-val )
     1060         .
     1061         if v-word-link = "":U then do:
     1062           assign
     1063             v-word-link = "and":U
     1064           .
     1065         end.
     1066       end.
     1067       delete object bh_tbl-name.
     1068       if     bh_tbl-key ne ?
     1069       then
     1070          delete object bh_tbl-key.
     1071       if p-key-handle = ?
     1072         and v-count-fld <> v-field-num
     1073       then do:
     1074         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info5, vTable ).
     1075       end.
     1076     end.
     1077   end procedure.
     1078   procedure gen-hn-keyr-tab :
     1079     define input  parameter i-tableSerach as character no-undo.
     1080     define input  parameter i-tablekey   as character no-undo.
     1081     define input  parameter p-key-rec    as character no-undo.
     1082     define input  parameter p-key-handle as handle    no-undo .
     1083     define input  parameter p-db-name    as character no-undo .
     1084     define input  parameter p-tt-handle  as handle    no-undo .
     1085     define input  parameter p-stts-lock  as integer   no-undo .
     1086     define output parameter o-hn         as handle    no-undo.
     1087     define variable v-full-tbl-name as character no-undo.
     1088     define variable v-where         as character no-undo.
     1089     define variable bh_tbl-name     as handle    no-undo.
     1090     define variable vTable          as character no-undo.
     1091     do
     1092     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1093     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1094     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
     1095         run gen-where-keyr-tab(i-tableSerach,
     1096                                i-tablekey,
     1097                                p-key-rec,
     1098                                p-key-handle,
     1099                                p-db-name,
     1100                                p-tt-handle,
     1101                                output v-where).
     1102         if i-tableSerach ne "" and i-tableSerach ne ?
     1103         then do:
     1104            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
     1105            create buffer bh_tbl-name for table v-full-tbl-name .
     1106         end.
     1107         else do:
     1108            if p-tt-handle = ? then do:
     1109               assign
     1110                  vTable = entry( 1 , p-key-rec, chr(3) )
     1111               .
     1112               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
     1113               create buffer bh_tbl-name for table v-full-tbl-name .
     1114            end.
     1115            else do:
     1116               create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1117            end.
     1118         end.
     1119         if p-tt-handle = ? then do:
     1120            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
     1121         end.
     1122         else do:
     1123            bh_tbl-name:find-first( v-where ) no-error .
     1124         end.
     1125         o-hn = bh_tbl-name.
     1126      end.
     1127   end procedure.
     1128   procedure gen-hn-keyr :
     1129     define input  parameter p-key-rec    as character no-undo.
     1130     define input  parameter p-key-handle as handle    no-undo .
     1131     define input  parameter p-db-name    as character no-undo .
     1132     define input  parameter p-tt-handle  as handle    no-undo .
     1133     define input  parameter p-stts-lock  as integer   no-undo .
     1134     define output parameter o-hn         as handle    no-undo.
     1135     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
     1136   end.
     1137   procedure gen-row-keyr :
     1138     define input  parameter p-key-rec    as character no-undo.
     1139     define input  parameter p-key-handle as handle    no-undo .
     1140     define input  parameter p-db-name    as character no-undo .
     1141     define input  parameter p-tt-handle  as handle    no-undo .
     1142     define input  parameter p-stts-lock  as integer   no-undo .
     1143     define output parameter p-tbl-row    as rowid     no-undo.
     1144     define output parameter p-tbl-name   as character no-undo.
     1145     define variable vHn as handle no-undo.
     1146       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
     1147       p-tbl-row = if vHn:available then vHn:rowid else ?.
     1148       p-tbl-name =  vHn:table.
     1149       delete object vHn no-error.
     1150     if p-tbl-row = ? then do:
     1151       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info5, p-tbl-name, p-key-rec ).
     1152     end.
     1153     else do:
     1154       return.
     1155     end.
     1156   end procedure.
     1157   procedure gen-key-fv :
     1158     define input  parameter p-key-rec    as character no-undo .
     1159     define output parameter p-field-list as character no-undo .
     1160     define output parameter p-value-list as character no-undo.
     1161     do
     1162     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1163     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1164     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1165     :
     1166       define variable v-full-tbl-name  as character no-undo .
     1167       define variable bh_tbl-name      as handle    no-undo .
     1168       define variable v-tbl-name       as character no-undo .
     1169       define variable v-field-num      as integer   no-undo .
     1170       define variable v-count-fld      as integer   no-undo .
     1171       define variable v-inform         as character no-undo .
     1172       define variable v-ind            as integer   no-undo .
     1173       define variable v-idx-field-qnty as integer   no-undo .
     1174       define variable v-delim-key      as character no-undo .
     1175       if p-key-rec = ?
     1176         or p-key-rec = "":U
     1177       then do:
     1178         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info5 ).
     1179       end.
     1180       assign
     1181         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     1182         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1183       .
     1184       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1185       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info5 ).
     1186       assign
     1187         v-inform = bh_tbl-name:index-information(1)
     1188         v-ind    = 2
     1189       .
     1190       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1191       on error undo, return error
     1192       :
     1193         assign
     1194           v-inform = bh_tbl-name:index-information( v-ind )
     1195           v-ind    = v-ind + 1
     1196         .
     1197       end.
     1198       if v-inform = ?
     1199         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1200         or entry( 3, v-inform, ",":U ) <> "1":U
     1201       then do:
     1202         delete object bh_tbl-name no-error.
     1203         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info5, v-tbl-name ).
     1204       end.
     1205       assign
     1206         v-idx-field-qnty = num-entries( v-inform ) - 4
     1207       .
     1208       if v-idx-field-qnty < 2 then do:
     1209         delete object bh_tbl-name no-error.
     1210         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info5, v-inform, v-tbl-name ).
     1211       end.
     1212       assign
     1213         p-field-list = "":U
     1214         p-value-list = "":U
     1215         v-delim-key  = "":U
     1216         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     1217         v-count-fld  = 0
     1218       .
     1219       block_where:
     1220       do v-ind = 1 to v-idx-field-qnty by 2
     1221       on error undo, return error
     1222       :
     1223         assign
     1224           v-count-fld = v-count-fld + 1
     1225         .
     1226         if v-count-fld > v-field-num then do:
     1227           leave block_where.
     1228         end.
     1229         assign
     1230           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     1231           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     1232         .
     1233         if v-ind = 1 then do:
     1234           assign
     1235             v-delim-key = chr(3)
     1236           .
     1237         end.
     1238       end.
     1239       delete object bh_tbl-name.
     1240       if v-count-fld <> v-field-num then do:
     1241         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info5, v-tbl-name ).
     1242       end.
     1243     end.
     1244   end procedure.
     1245   procedure gen-key-field :
     1246     define input  parameter p-table      as character no-undo .
     1247     define output parameter p-field-list as character no-undo .
     1248     do
     1249     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1250     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1251     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1252     :
     1253       define variable v-full-tbl-name  as character no-undo .
     1254       define variable bh_tbl-name      as handle    no-undo .
     1255       define variable v-tbl-name       as character no-undo .
     1256       define variable v-field-num      as integer   no-undo .
     1257       define variable v-count-fld      as integer   no-undo .
     1258       define variable v-inform         as character no-undo .
     1259       define variable v-ind            as integer   no-undo .
     1260       define variable v-idx-field-qnty as integer   no-undo .
     1261       define variable v-delim-key      as character no-undo .
     1262       if p-table = ?
     1263         or p-table = "":U
     1264       then do:
     1265         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info5 ).
     1266       end.
     1267       assign
     1268         v-tbl-name      = p-table
     1269         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1270       .
     1271       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1272       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info5 ).
     1273       assign
     1274         v-inform = bh_tbl-name:index-information(1)
     1275         v-ind    = 2
     1276       .
     1277       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1278       on error undo, return error
     1279       :
     1280         assign
     1281           v-inform = bh_tbl-name:index-information( v-ind )
     1282           v-ind    = v-ind + 1
     1283         .
     1284       end.
     1285       if v-inform = ?
     1286         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1287         or entry( 3, v-inform, ",":U ) <> "1":U
     1288       then do:
     1289         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info5, v-tbl-name ).
     1290       end.
     1291       assign
     1292         v-idx-field-qnty = num-entries( v-inform ) - 4
     1293       .
     1294       if v-idx-field-qnty < 2 then do:
     1295         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info5, v-inform, v-tbl-name ).
     1296       end.
     1297       assign
     1298         p-field-list = "":U
     1299         v-delim-key  = "":U
     1300         v-count-fld  = 0
     1301       .
     1302       block_where:
     1303       do v-ind = 1 to v-idx-field-qnty by 2
     1304       on error undo, return error
     1305       :
     1306         assign
     1307           v-count-fld = v-count-fld + 1
     1308         .
     1309         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     1310         if v-ind = 1 then do:
     1311           assign
     1312             v-delim-key = chr(3)
     1313           .
     1314         end.
     1315       end.
     1316       delete object bh_tbl-name.
     1317     end.
     1318   end procedure.
     1319   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1320   def var vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1321   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1322   FUNCTION get-region RETURNS CHARACTER
     1323     ( input parhost-code as integer, input parobj-type as character, input parobj-code as integer ) :
     1324     define variable par-region as character no-undo.
     1325     if parhost-code = 0 and
     1326          parobj-type = "":U and
     1327          parobj-code = 0 then do:
     1328          par-region = "Глобально".
     1329          return par-region.
     1330       end.
     1331       if parobj-type = 'орг':U then do:
     1332          par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parhost-code).
     1333          return par-region.
     1334       end.
     1335       if parobj-type = 'регион':U
     1336       then do:
     1337          par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
     1338          return par-region.
     1339       end.
     1340       par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
     1341       return par-region.
     1342   END FUNCTION.
     1343   FUNCTION get-objregion RETURNS CHARACTER
     1344     (  input parobj-type as character, input parobj-code as integer ) :
     1345     define variable par-region as character no-undo.
     1346     if  parobj-type = "":U and
     1347         parobj-code = 0
     1348     then do:
     1349        par-region = "Глобально".
     1350     end.
     1351     else if parobj-type = 'орг':U
     1352     then do:
     1353        par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parobj-code).
     1354     end.
     1355     else if parobj-type = 'регион':U
     1356     then do:
     1357        par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
     1358     end.
     1359     else
     1360        par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
     1361     return par-region.
     1362   END FUNCTION.
     1363   FUNCTION calldscr returns character ( input p-call-id as character):
     1364   define variable v-descr as character no-undo .
     1365   define variable v-field-list as character no-undo .
     1366   define variable v-value-list as character no-undo.
     1367   define variable v-prop-label as character no-undo .
     1368   define variable v-node-label as character no-undo .
     1369   define variable v-dt-code as integer no-undo .
     1370   define variable v-host-code as integer no-undo .
     1371   define variable v-obj-type as character no-undo .
     1372   define variable v-obj-code as integer no-undo .
     1373   define variable v-label as character no-undo .
     1374   define variable v-node-code as integer no-undo .
     1375   define buffer buf_prop-head for ub.prop-head.
     1376   define buffer buf_prop-ref for ub.prop-ref.
     1377   define buffer buf_prop-map for ub.prop-map.
     1378   run gen-key-fv in this-procedure ( input p-call-id
     1379                                     ,output v-field-list
     1380                                     ,output v-value-list) no-error .
     1381   if error-status:error then return p-call-id.
     1382   CASE entry(1, p-call-id, chr(3)):
     1383     when 'dis-card-type':U then do:
     1384       v-descr = substitute("Тип ДК: эмитент &1 тип: &2"
     1385                            ,integer(entry(lookup("emitent-host-code", v-field-list, chr(3)), v-value-list, chr(3)) )
     1386                            ,entry(lookup("type", v-field-list, chr(3)), v-value-list, chr(3))
     1387                            ).
     1388     end.
     1389     when 'dis-card':U then do:
     1390       v-descr = substitute("ДК: № &1"
     1391                            ,entry(lookup("d-card", v-field-list, chr(3)), v-value-list, chr(3))
     1392                            ).
     1393     end.
     1394     when 'dis-card-property':U then do:
     1395       v-dt-code = integer(entry(lookup("dt-code", v-field-list, chr(3)), v-value-list, chr(3)) ).
     1396       v-node-code = integer(entry(lookup("node-code", v-field-list, chr(3)), v-value-list, chr(3)) ).
     1397       v-host-code = integer(entry(lookup("host-code", v-field-list, chr(3)), v-value-list, chr(3)) ).
     1398       v-obj-type = entry(lookup("obj-type", v-field-list, chr(3)), v-value-list, chr(3)) .
     1399       v-obj-code = integer(entry(lookup("obj-code", v-field-list, chr(3)), v-value-list, chr(3)) ).
     1400       find first buf_prop-ref no-lock where
     1401                 buf_prop-ref.dt-code = v-dt-code no-error .
     1402       if available buf_prop-ref then do:
     1403         find first buf_prop-head no-lock where
     1404                   buf_prop-head.dtm-code = buf_prop-ref.dtm-code no-error .
     1405         v-prop-label = buf_prop-head.prop-label.
     1406         find first buf_prop-map no-lock where
     1407                   buf_prop-map.dtm-code = buf_prop-ref.dtm-code
     1408               and buf_prop-map.node-code = v-node-code no-error .
     1409         if available buf_prop-map then do:
     1410           v-label = buf_prop-map.node-label.
     1411         end.
     1412       end.
     1413       v-descr = substitute("ДК: № &1 &2:&3 &4"
     1414                            ,entry(lookup("d-card", v-field-list, chr(3)), v-value-list, chr(3))
     1415                            ,v-prop-label
     1416                            ,v-label
     1417                            ,get-region(v-host-code, v-obj-type, v-obj-code)
     1418                            ).
     1419     end.
     1420     when 'clients':U then do:
     1421       v-descr = substitute("&1&2"
     1422                            ,entry(lookup("obj-type", v-field-list, chr(3)), v-value-list, chr(3))
     1423                            ,integer(entry(lookup("obj-code", v-field-list, chr(3)), v-value-list, chr(3)) )
     1424                            ).
     1425     end.
     1426     when 'ext-system':U then do:
     1427       v-descr = substitute("Внешняя система &1"
     1428                            ,integer(entry(lookup("esys-id", v-field-list, chr(3)), v-value-list, chr(3)))
     1429                            ).
     1430     end.
     1431     WHEN 'thbj-attr':U then do:
     1432       if entry(lookup("upper-prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'rum':U
     1433       or entry(lookup("upper-prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'rum_obj':U
     1434       then do:
     1435         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'goods':U then do:
     1436           v-descr = "Операции с товарами".
     1437         end.
     1438         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'clients':U then do:
     1439           v-descr = "Операции с клиентами".
     1440         end.
     1441         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'gds-grp':U then do:
     1442           v-descr = "Операции с группами товаров".
     1443         end.
     1444         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'cli-grp':U then do:
     1445           v-descr = "Операции с группами клиентов".
     1446         end.
     1447         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'chk-doc_ibs-th':U then do:
     1448           v-descr = "Операции с чеками на POS IBS-TH".
     1449         end.
     1450         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'chk-doc_ibs-th-mob':U then do:
     1451           v-descr = "Операции с чеками на POS IBS-TH-MOB".
     1452         end.
     1453         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'edoc':U then do:
     1454           v-descr = "Операции в системе электронного документооборота".
     1455         end.
     1456         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'thref':U then do:
     1457           v-descr = "Операции со справочниками".
     1458         end.
     1459         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'pdf':U then do:
     1460           v-descr = "Операции с ДНЦ и переоценками".
     1461         end.
     1462         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'rep':U then do:
     1463           v-descr = "Отчеты".
     1464         end.
     1465         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'ord':U then do:
     1466           v-descr = "Операции с заказами".
     1467         end.
     1468       end.
     1469     end.
     1470     when 'cash-desk':U then do:
     1471       v-descr = substitute("БД &1 Маг &2 Касса № &4 &3"
     1472                            ,entry(lookup("db-num", v-field-list, chr(3)), v-value-list, chr(3))
     1473                            ,entry(lookup("obj-code", v-field-list, chr(3)), v-value-list, chr(3))
     1474                            ,entry(lookup("cash-num", v-field-list, chr(3)), v-value-list, chr(3))
     1475                            ,entry(lookup("pos-type", v-field-list, chr(3)), v-value-list, chr(3))
     1476                            ).
     1477     end.
     1478     when 'ext-file':U then do:
     1479       v-descr = substitute("БД &1 Файл № &3 (из БД &2)"
     1480                            ,entry(lookup("db-num", v-field-list, chr(3)), v-value-list, chr(3))
     1481                            ,entry(lookup("from-db-num", v-field-list, chr(3)), v-value-list, chr(3))
     1482                            ,entry(lookup("file-num", v-field-list, chr(3)), v-value-list, chr(3))
     1483                            ).
     1484     end.
     1485   end case.
     1486   return v-descr.
     1487   end function.
     1488   DEFINE VARIABLE add-option AS CHARACTER NO-UNDO.
     1489   DEFINE VARIABLE v-num-params AS INTEGER NO-UNDO.
     1490   DEFINE VARIABLE v-run-name AS CHARACTER NO-UNDO.
     1491   DEFINE VARIABLE v-ibm-xml-mode AS logical NO-UNDO.
     1492   DEFINE BUFFER buf_Ext-file FOR ub.ext-file.
     1493   DEFINE QUERY external_tables FOR ub.ext-file-par.
     1494   DEFINE MENU MENU-B-add
     1495          MENU-ITEM m_character    LABEL "Символьный"
     1496          MENU-ITEM m_date         LABEL "Дата"
     1497          MENU-ITEM m_integer      LABEL "Целый"
     1498          MENU-ITEM m_logical      LABEL "Логический"    .
     1499   DEFINE BUTTON B-add
     1500        LABEL "&Добавить"
     1501        SIZE 10 BY 1.
     1502   DEFINE BUTTON B-del
     1503        LABEL "&Удалить"
     1504        SIZE 10 BY 1.
     1505   DEFINE BUTTON B-Help
     1506        LABEL "Помо&щь"
     1507        SIZE 10 BY 1
     1508        BGCOLOR 8 .
     1509   DEFINE BUTTON b-lkp
     1510        LABEL "&Просмотр"
     1511        SIZE 10 BY 1.
     1512   DEFINE BUTTON b-quit AUTO-GO
     1513        LABEL "&Выход"
     1514        SIZE 10 BY 1
     1515        BGCOLOR 8 .
     1516   DEFINE QUERY Br-params FOR
     1517         tt-ext-file-par SCROLLING.
     1518   DEFINE BROWSE Br-params
     1519     QUERY Br-params NO-LOCK DISPLAY
     1520         tt-ext-file-par.param-name COLUMN-LABEL "Имя симв.!пар-ра" FORMAT "X(40)":U
     1521       WIDTH 10
     1522   calldscr(tt-ext-file-par.param-name) COLUMN-LABEL "Касса" FORMAT "X(255)":U
     1523       WIDTH 40
     1524   tt-ext-file-par.param-value COLUMN-LABEL "Значение!симв. пар-ра" FORMAT "X(255)":U
     1525       WIDTH 20
     1526   calldscr(tt-ext-file-par.param-value) COLUMN-LABEL "Файл" FORMAT "X(255)":U
     1527       WIDTH 40
     1528   tt-ext-file-par.param-date-name COLUMN-LABEL "Имя пар-ра!типа ДАТА" FORMAT "X(40)":U
     1529       WIDTH 10
     1530   tt-ext-file-par.param-date-value COLUMN-LABEL "Знач.пар-ра!типа ДАТА" FORMAT "99/99/9999":U
     1531       WIDTH 10
     1532   tt-ext-file-par.param-int-name COLUMN-LABEL "Имя целого!пар-ра" FORMAT "X(40)":U
     1533       WIDTH 10
     1534   tt-ext-file-par.param-int-value COLUMN-LABEL "Знач.целого!пар-ра" FORMAT "->,>>>,>>>,>>9":U
     1535       WIDTH 15
     1536   tt-ext-file-par.param-log-name COLUMN-LABEL "Имя лог.!пар-ра" FORMAT "X(40)":U
     1537       WIDTH 8
     1538   tt-ext-file-par.param-log-value COLUMN-LABEL "Знач.лог.!пар-ра" FORMAT "yes/no":U
     1539       WIDTH 9
     1540   ENABLE
     1541   tt-ext-file-par.param-value
     1542   tt-ext-file-par.param-date-value
     1543   tt-ext-file-par.param-int-value
     1544   tt-ext-file-par.param-log-value
     1545       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 15.47 FIT-LAST-COLUMN.
     1546   DEFINE FRAME Dialog-Frame
     1547        b-quit AT ROW 1 COL 1
     1548        B-add AT ROW 1 COL 41
     1549        B-del AT ROW 1 COL 51
     1550        b-lkp AT ROW 1 COL 61 WIDGET-ID 2
     1551        B-Help AT ROW 1 COL 88
     1552        Br-params AT ROW 3 COL 1
     1553        SPACE(0.59) SKIP(0.09)
     1554       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1555            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1556            TITLE "Параметры"
     1557            CANCEL-BUTTON b-quit.
     1558   ASSIGN
     1559          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1560          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1561   ASSIGN
     1562          B-add:POPUP-MENU IN FRAME Dialog-Frame       = MENU MENU-B-add:HANDLE.
     1563   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1564   DO:
     1565     APPLY "END-ERROR":U TO SELF.
     1566   END.
     1567   ON CHOOSE OF B-add IN FRAME Dialog-Frame
     1568   DO:
     1569   define variable vss-include-info9 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1570   if lookup(self :type
     1571            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     1572            ) = 0
     1573   then do:
     1574     message
     1575       "$Workfile$"
     1576       "Указанному интерфейсному элементу фокус не может быть передан" skip
     1577       "Интерфейсный элемент" self :name  skip
     1578       "Тип" self :type  skip
     1579       "Процедура" this-procedure :file-name skip
     1580       view-as alert-box .
     1581   end.
     1582   else do:
     1583     apply "entry":u to self  .
     1584     if focus :handle <> self :handle  then do:
     1585       return no-apply .
     1586     end.
     1587   end.
     1588     IF add-option = '':U THEN DO:
     1589       run gbl/pop-up.p ( input self :handle, input no ) no-error.
     1590       if error-status :error then do: return no-apply. end.
     1591     END.
     1592     run proc-b-add IN THIS-PROCEDURE ( INPUT add-option) NO-ERROR.
     1593     IF ERROR-STATUS:ERROR THEN do:
     1594       add-option = ''.
     1595       RETURN NO-APPLY.
     1596     END.
     1597   END.
     1598   ON CHOOSE OF B-del IN FRAME Dialog-Frame
     1599   DO:
     1600   define variable vss-include-info10 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1601   if lookup(self :type
     1602            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     1603            ) = 0
     1604   then do:
     1605     message
     1606       "$Workfile$"
     1607       "Указанному интерфейсному элементу фокус не может быть передан" skip
     1608       "Интерфейсный элемент" self :name  skip
     1609       "Тип" self :type  skip
     1610       "Процедура" this-procedure :file-name skip
     1611       view-as alert-box .
     1612   end.
     1613   else do:
     1614     apply "entry":u to self  .
     1615     if focus :handle <> self :handle  then do:
     1616       return no-apply .
     1617     end.
     1618   end.
     1619     DEFINE BUFFER buf_tt-ext-file-par FOR tt-ext-file-par.
     1620     IF NOT AVAILABLE tt-ext-file-par THEN RETURN NO-APPLY.
     1621     FIND FIRST buf_tt-ext-file-par WHERE
     1622               recid(buf_tt-ext-file-par) = RECID(tt-ext-file-par).
     1623     DELETE buf_tt-ext-file-par.
     1624     run OpenBr in this-procedure.
     1625   END.
     1626   ON CHOOSE OF b-lkp IN FRAME Dialog-Frame
     1627   DO:
     1628     IF NOT AVAILABLE tt-ext-file-par THEN RETURN NO-APPLY.
     1629     run proc-lkp IN THIS-PROCEDURE NO-ERROR.
     1630     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1631   END.
     1632   ON CHOOSE OF b-quit IN FRAME Dialog-Frame
     1633   DO:
     1634   define variable vss-include-info11 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1635   if lookup(self :type
     1636            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     1637            ) = 0
