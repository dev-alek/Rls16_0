     1730   END.
     1731   ON ROW-ENTRY OF Br-params IN FRAME Dialog-Frame
     1732   OR VALUE-CHANGED OF br-params DO:
     1733     IF p-mode = 'ИЗМЕНЕНИЕ':U THEN DO:
     1734      CASE tt-ext-file-par.param-type:
     1735       WHEN 'C':U THEN DO:
     1736         assign
     1737         tt-ext-file-par.param-value :read-only in browse Br-params = no
     1738         tt-ext-file-par.param-date-value :read-only  in browse Br-params = yes
     1739         tt-ext-file-par.param-int-value :read-only  in browse Br-params = yes
     1740         tt-ext-file-par.param-log-value:read-only  in browse Br-params = yes
     1741         .
     1742       END.
     1743       WHEN 'T':U THEN DO:
     1744         assign
     1745         tt-ext-file-par.param-value :read-only in browse Br-params = yes
     1746         tt-ext-file-par.param-date-value :read-only  in browse Br-params = no
     1747         tt-ext-file-par.param-int-value :read-only  in browse Br-params = yes
     1748         tt-ext-file-par.param-log-value:read-only  in browse Br-params = yes
     1749         .
     1750       END.
     1751       WHEN 'I':U THEN DO:
     1752         assign
     1753         tt-ext-file-par.param-value :read-only in browse Br-params = yes
     1754         tt-ext-file-par.param-date-value :read-only  in browse Br-params = yes
     1755         tt-ext-file-par.param-int-value :read-only  in browse Br-params = no
     1756         tt-ext-file-par.param-log-value:read-only  in browse Br-params = yes
     1757         .
     1758       end.
     1759       WHEN 'L':U THEN DO:
     1760         assign
     1761         tt-ext-file-par.param-value :read-only in browse Br-params = yes
     1762         tt-ext-file-par.param-date-value :read-only  in browse Br-params = yes
     1763         tt-ext-file-par.param-int-value :read-only  in browse Br-params = yes
     1764         tt-ext-file-par.param-log-value:read-only  in browse Br-params = no
     1765         .
     1766       END.
     1767     END CASE.
     1768     END.
     1769   END.
     1770   ON ROW-LEAVE OF Br-params IN FRAME Dialog-Frame
     1771   DO:
     1772    IF p-mode = 'ИЗМЕНЕНИЕ':U THEN DO:
     1773    CASE tt-ext-file-par.param-type:
     1774       WHEN 'C':U then do:
     1775          ASSIGN
     1776          tt-ext-file-par.param-value = INPUT BROWSE br-params  tt-ext-file-par.param-value
     1777          .
     1778       END.
     1779       WHEN 'T':U then do:
     1780          ASSIGN
     1781          tt-ext-file-par.param-date-value = INPUT BROWSE br-params tt-ext-file-par.param-date-value
     1782          .
     1783       END.
     1784       WHEN 'I':U then do:
     1785          ASSIGN
     1786          tt-ext-file-par.param-int-value = INPUT BROWSE br-params tt-ext-file-par.param-int-value
     1787          .
     1788       END.
     1789       WHEN 'L':U then do:
     1790          ASSIGN
     1791          tt-ext-file-par.param-log-value = INPUT BROWSE br-params tt-ext-file-par.param-log-value
     1792          .
     1793       END.
     1794     END CASE.
     1795     END.
     1796   END.
