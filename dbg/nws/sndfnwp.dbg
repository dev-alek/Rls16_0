     1723           tt-ext-file-par.param-date-name :fgcolor in browse Br-params = GREY_COLOR
     1724           tt-ext-file-par.param-date-value :fgcolor in browse Br-params = GREY_COLOR
     1725           tt-ext-file-par.param-int-name :fgcolor in browse Br-params = GREY_COLOR
     1726           tt-ext-file-par.param-int-value :fgcolor in browse Br-params = GREY_COLOR
     1727           .
     1728         END.
