     1661         tt-ext-file-par.param-date-name :bgcolor in browse Br-params = GREY_COLOR
     1662         tt-ext-file-par.param-date-value :bgcolor in browse Br-params = GREY_COLOR
     1663         tt-ext-file-par.param-int-name :bgcolor in browse Br-params = GREY_COLOR
     1664         tt-ext-file-par.param-int-value :bgcolor in browse Br-params = GREY_COLOR
     1665         tt-ext-file-par.param-log-name :bgcolor in browse Br-params = GREY_COLOR
     1666         tt-ext-file-par.param-log-value:bgcolor in browse Br-params = GREY_COLOR
     1667         tt-ext-file-par.param-date-name :fgcolor in browse Br-params = GREY_COLOR
     1668         tt-ext-file-par.param-date-value :fgcolor in browse Br-params = GREY_COLOR
     1669         tt-ext-file-par.param-int-name :fgcolor in browse Br-params = GREY_COLOR
     1670         tt-ext-file-par.param-int-value :fgcolor in browse Br-params = GREY_COLOR
     1671         tt-ext-file-par.param-log-name :fgcolor in browse Br-params = GREY_COLOR
     1672         tt-ext-file-par.param-log-value:fgcolor in browse Br-params = GREY_COLOR
