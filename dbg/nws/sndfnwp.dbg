     1676           ASSIGN
     1677           tt-ext-file-par.param-name :bgcolor in browse Br-params = GREY_COLOR
     1678           tt-ext-file-par.param-value :bgcolor in browse Br-params = GREY_COLOR
     1679           tt-ext-file-par.param-date-name :bgcolor in browse Br-params = white_COLOR
     1680           tt-ext-file-par.param-date-value :bgcolor in browse Br-params = white_COLOR
     1681           tt-ext-file-par.param-int-name :bgcolor in browse Br-params = GREY_COLOR
     1682           tt-ext-file-par.param-int-value :bgcolor in browse Br-params = GREY_COLOR
     1683           tt-ext-file-par.param-log-name :bgcolor in browse Br-params = GREY_COLOR
     1684           tt-ext-file-par.param-log-value:bgcolor in browse Br-params = GREY_COLOR
     1685           tt-ext-file-par.param-name :fgcolor in browse Br-params = GREY_COLOR
     1686           tt-ext-file-par.param-value :fgcolor in browse Br-params = GREY_COLOR
     1687           tt-ext-file-par.param-int-name :fgcolor in browse Br-params = GREY_COLOR
     1688           tt-ext-file-par.param-int-value :fgcolor in browse Br-params = GREY_COLOR
     1689           tt-ext-file-par.param-log-name :fgcolor in browse Br-params = GREY_COLOR
     1690           tt-ext-file-par.param-log-value:fgcolor in browse Br-params = GREY_COLOR
     1691           .
     1692         END.
     1693         WHEN 'I':U THEN DO:
     1694           ASSIGN
     1695           tt-ext-file-par.param-name :bgcolor in browse Br-params = GREY_COLOR
     1696           tt-ext-file-par.param-value :bgcolor in browse Br-params = GREY_COLOR
     1697           tt-ext-file-par.param-date-name :bgcolor in browse Br-params = GREY_COLOR
     1698           tt-ext-file-par.param-date-value :bgcolor in browse Br-params = GREY_COLOR
     1699           tt-ext-file-par.param-int-name :bgcolor in browse Br-params = white_COLOR
     1700           tt-ext-file-par.param-int-value :bgcolor in browse Br-params = white_COLOR
     1701           tt-ext-file-par.param-log-name :bgcolor in browse Br-params = GREY_COLOR
     1702           tt-ext-file-par.param-log-value:bgcolor in browse Br-params = GREY_COLOR
     1703           tt-ext-file-par.param-name :fgcolor in browse Br-params = GREY_COLOR
     1704           tt-ext-file-par.param-value :fgcolor in browse Br-params = GREY_COLOR
     1705           tt-ext-file-par.param-date-name :fgcolor in browse Br-params = GREY_COLOR
     1706           tt-ext-file-par.param-date-value :fgcolor in browse Br-params = GREY_COLOR
     1707           tt-ext-file-par.param-log-name :fgcolor in browse Br-params = GREY_COLOR
     1708           tt-ext-file-par.param-log-value:fgcolor in browse Br-params = GREY_COLOR
     1709           .
     1710         END.
     1711         WHEN 'L':U THEN DO:
