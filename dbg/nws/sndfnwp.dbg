     1872   ON CHOOSE OF MENU-ITEM m_logical
     1873   DO:
     1874   define variable vss-include-info15 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1875   if lookup(b-add :type in frame Dialog-Frame
     1876            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     1877            ) = 0
     1878   then do:
     1879     message
     1880       "$Workfile$"
     1881       "Указанному интерфейсному элементу фокус не может быть передан" skip
     1882       "Интерфейсный элемент" self :name in frame Dialog-Frame skip
     1883       "Тип" self :type in frame Dialog-Frame skip
     1884       "Процедура" this-procedure :file-name skip
     1885       view-as alert-box .
     1886   end.
     1887   else do:
     1888     apply "entry":u to b-add in frame Dialog-Frame .
     1889     if focus :handle <> b-add :handle in frame Dialog-Frame then do:
     1890       return no-apply .
     1891     end.
     1892   end.
     1893     ASSIGN
     1894     add-option = 'L':U.
     1895     APPLY "CHOOSE" TO b-add in frame Dialog-Frame .
     1896   END.
     1897   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1898   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1899   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1900   on help of frame Dialog-Frame
     1901   do:
     1902     run gbl/app_help.p
     1903       (input this-procedure :file-name
     1904       ,input ''
     1905       ,input ?
     1906       ) no-error.
     1907     if error-status :error then do:
     1908       message
     1909         "Ошибка при вызове помощи"
     1910         error-status :get-message(1)
     1911         view-as alert-box .
     1912     end.
     1913   end.
     1914   run minbtn-set in this-procedure .
     1915   on choose of b-help in frame Dialog-Frame
     1916   do:
     1917     apply "help":u to frame Dialog-Frame .
     1918   end.
     1919   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1920   procedure minbtn-set :
     1921       do
     1922           on error undo, return error return-value
     1923           :
     1924           define variable ii              as integer       no-undo .
     1925           define variable fh              as widget-handle no-undo .
     1926           define variable hh              as widget-handle no-undo .
     1927           define variable v-h             as handle        extent 4 no-undo .
     1928           define variable v-name-button   as character     no-undo .
     1929           define variable v-help-old-x    as decimal       no-undo .
     1930           define variable v-help-old-y    as decimal       no-undo .
     1931           define variable v-help-old-size as decimal       no-undo .
     1932           define variable v-frame-width   as decimal       no-undo .
     1933           define variable jj              as integer       no-undo .
     1934           do
     1935               on error undo, return error
     1936               :
     1937               assign
     1938                   v-frame-width = frame Dialog-Frame:width - 0.3
     1939                   fh            = frame Dialog-Frame:first-child
     1940                   hh            = fh:first-child
     1941                   ii            = 1
     1942                   .
     1943               do while valid-handle(hh):
     1944                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1945                   do:
     1946                       case lc(hh:name) :
     1947                           when "b-help" then
     1948                               do:
     1949                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1950                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1951                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1952                                   hh:TOOLTIP = "Помощь" .
     1953                                   v-help-old-x = hh:column .
     1954                                   v-help-old-y = hh:row    .
     1955                                   v-help-old-size = hh:width .
     1956                                   hh:width-chars = 2.5 .
     1957                               end.
     1958                           when "b-print" then
     1959                               do:
     1960                                   hh:load-image("cmp/b-print.bmp":u) .
     1961                                   hh:TOOLTIP = "Печать" .
     1962                                   v-h[ii] = hh:handle .
     1963                                   ii = ii + 1 .
     1964                                   hh:width-chars = 3 .
     1965                               end.
     1966                           when "b-history" or
     1967                           when "b-hist" then
     1968                               do:
     1969                                   hh:load-image("cmp/b-hist.bmp":u) .
     1970                                   hh:TOOLTIP = "История" .
     1971                                   v-h[ii] = hh:handle .
     1972                                   ii = ii + 1 .
     1973                                   hh:width-chars = 3 .
     1974                               end.
     1975                           when "b-sch" then
     1976                               do:
     1977                                   hh:load-image("cmp/b-sch.bmp":u) .
     1978                                   hh:TOOLTIP = "Установка Фильтра" .
     1979                                   v-h[ii] = hh:handle .
     1980                                   ii = ii + 1 .
     1981                                   hh:width-chars = 3 .
     1982                               end.
     1983                           when "b-hist-user" then
     1984                               do:
     1985                                   hh:load-image("cmp/b-hist.bmp":u) .
     1986                                   hh:TOOLTIP = "История пользователя" .
     1987                                   ii = ii + 1 .
     1988                               end.
     1989                       end case.
     1990                   end.
     1991                   hh = hh:next-sibling.
     1992               end.
     1993               b-help:column = v-frame-width - b-help:width-chars.
     1994               jj = 0.
     1995               repeat ii = 4 to 1 by -1 :
     1996                   if valid-handle (v-h[ii] ) then
     1997                   do:
     1998                       jj  = jj + 1 .
     1999                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     2000                       v-h[ii]:row    = v-help-old-y .
     2001                   end.
     2002               end.
     2003           end.
     2004       end.
     2005   end procedure.
     2006   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     2007   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     2008   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     2009   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     2010   define variable v-diasize-current-frame-width  as decimal   no-undo .
     2011   define variable v-diasize-current-frame-height as decimal   no-undo .
     2012   define variable v-diasize-change-size          as logical   no-undo .
     2013   define variable v-diasize-resize-button        as handle    no-undo .
     2014   define variable v-diasize-wndmax               as logical   no-undo .
     2015   define variable v-diasize-wndstore             as logical   no-undo .
     2016   define variable v-diasize-proc-name            as character no-undo .
     2017   define variable v-diasize-browse-handle        as handle    no-undo .
     2018   define variable v-diasize-browse-number        as integer   no-undo .
     2019   define variable v-diasize-need-full-display    as logical   no-undo init false .
     2020   define temp-table temp-diasize-handle no-undo
     2021     field handle-value  as handle
     2022     field save-position as decimal
     2023     index xpk is primary unique handle-value
     2024     .
     2025   define temp-table temp-browse-handle no-undo
     2026     field browse-type   as character
     2027     field browse-number as integer
     2028     field browse-handle as handle
     2029     field original-size as decimal
     2030     index xpk is primary unique browse-type browse-number
     2031     index xie browse-type browse-handle
     2032   .
     2033   procedure diasize_change-height :
     2034     define input  parameter p-change-value  as decimal   no-undo .
     2035     define input  parameter p-move-resize   as logical   no-undo .
     2036     define variable v-field-group-handle    as handle    no-undo .
     2037     define variable v-object-handle         as handle    no-undo .
     2038     define variable v-frame-height          as decimal   no-undo .
     2039     define variable v-frame-virtual-height  as decimal   no-undo .
     2040     define variable v-browse-height         as decimal   no-undo .
     2041     define variable v-window-height         as decimal   no-undo .
     2042     define variable v-window-virtual-height as decimal   no-undo .
     2043     define variable v-change-sign           as integer   no-undo .
     2044     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2045     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2046     if p-change-value > 0
     2047     then do:
     2048       if frame Dialog-Frame :height + p-change-value
     2049           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     2050       then do:
     2051         assign
     2052           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     2053                           - (frame Dialog-Frame :height-chars)
     2054         .
     2055         if p-change-value <= 0
     2056         then do:
     2057           run diasize_position-resize-button in this-procedure .
     2058           return .
     2059         end.
     2060       end.
     2061     end.
     2062     if p-change-value < 0
     2063     then do:
     2064       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     2065       then do:
     2066         assign
     2067           p-change-value = v-diasize-orig-frame-height
     2068                          - (frame Dialog-Frame :height-chars)
     2069         .
     2070         if p-change-value >= 0
     2071         then do:
     2072           run diasize_position-resize-button in this-procedure .
     2073           return .
     2074         end.
     2075       end.
     2076     end.
     2077     if p-change-value >= 0
     2078     then do:
     2079       assign
     2080         v-change-sign = 1
     2081       .
     2082     end.
     2083     else do:
     2084       assign
     2085         v-change-sign = -1
     2086       .
     2087     end.
     2088     assign
     2089       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2090     .
     2091     if p-change-value = 0
     2092     then do:
     2093       run diasize_position-resize-button in this-procedure .
     2094       return .
     2095     end.
     2096     move_block:
     2097     do
     2098     on error undo move_block, retry move_block
     2099     :
     2100       if retry
     2101       then do:
     2102         do
     2103         on error undo move_block, leave move_block
     2104         :
     2105           if p-change-value > 0
     2106           then do:
     2107             for each buf_temp-diasize-handle
     2108             on error undo, next
     2109             :
     2110               assign
     2111                 v-object-handle = buf_temp-diasize-handle.handle-value
     2112               .
     2113               if v-object-handle <> v-diasize-resize-button
     2114               then do:
     2115                 assign
     2116                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2117                 .
     2118               end.
     2119             end.
     2120             assign
     2121               v-diasize-browse-handle :height = v-browse-height
     2122             .
     2123             for each buf_temp-browse-handle
     2124               where buf_temp-browse-handle.browse-type = 'height':u
     2125             on error undo, next
     2126             :
     2127               assign
     2128                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2129               .
     2130             end.
     2131             assign
     2132               frame Dialog-Frame :height = v-frame-height
     2133             .
     2134             if frame Dialog-Frame :scrollable = true
     2135             then do:
     2136               assign
     2137                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2138               .
     2139             end.
     2140             run diasize_position-resize-button in this-procedure .
     2141           end.
     2142           else do:
     2143             if frame Dialog-Frame :scrollable = true
     2144             then do:
     2145               assign
     2146                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2147               .
     2148             end.
     2149             assign
     2150               frame Dialog-Frame :height = v-frame-height
     2151             .
     2152             assign
     2153               v-diasize-browse-handle :height = v-browse-height
     2154             .
     2155             for each buf_temp-browse-handle
     2156               where buf_temp-browse-handle.browse-type = 'height':u
     2157             on error undo, next
     2158             :
     2159               assign
     2160                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2161               .
     2162             end.
     2163             for each buf_temp-diasize-handle
     2164             on error undo, next
     2165             :
     2166               assign
     2167                 v-object-handle = buf_temp-diasize-handle.handle-value
     2168               .
     2169               if v-object-handle <> v-diasize-resize-button
     2170               then do:
     2171                 assign
     2172                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2173                 .
     2174               end.
     2175             end.
     2176             run diasize_position-resize-button in this-procedure .
     2177           end.
     2178           assign
     2179             v-diasize-change-size = false
     2180           .
     2181           leave move_block .
     2182         end.
     2183       end.
     2184       assign
     2185         v-diasize-need-full-display = true
     2186       .
     2187       if v-diasize-change-size = false
     2188       then do:
     2189         assign
     2190           v-diasize-change-size = true
     2191         .
     2192       end.
     2193       else do:
     2194         return .
     2195       end.
     2196       assign
     2197         v-frame-height = frame Dialog-Frame :height
     2198         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     2199         v-browse-height = v-diasize-browse-handle :height
     2200       .
     2201       for each buf_temp-browse-handle
     2202         where buf_temp-browse-handle.browse-type = 'height':u
     2203       :
     2204         assign
     2205           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     2206         .
     2207       end.
     2208       for each buf_temp-diasize-handle
     2209       :
     2210         delete buf_temp-diasize-handle .
     2211       end.
     2212       assign
     2213         v-field-group-handle = frame Dialog-Frame :first-child
     2214       .
     2215       do while valid-handle(v-field-group-handle)
     2216       :
     2217         assign
     2218           v-object-handle = v-field-group-handle :first-child
     2219         .
     2220         do while valid-handle(v-object-handle)
     2221         :
     2222           if  v-object-handle <> v-diasize-browse-handle :handle
     2223           and can-query(v-object-handle, "row")
     2224           and can-query(v-object-handle, "height")
     2225           and ( v-object-handle :row > v-diasize-browse-handle :row )
     2226           then do:
     2227             find first buf_temp-browse-handle
     2228               where buf_temp-browse-handle.browse-type   = 'height':u
     2229                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2230               no-error .
     2231             if available buf_temp-browse-handle
     2232             then do:
     2233             end.
     2234             else do:
     2235               create buf_temp-diasize-handle .
     2236               assign
     2237                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2238                 buf_temp-diasize-handle.save-position = v-object-handle :row
     2239               .
     2240             end.
     2241           end.
     2242           assign
     2243             v-object-handle = v-object-handle :next-sibling
     2244           .
     2245         end.
     2246         assign
     2247           v-field-group-handle = v-field-group-handle :next-sibling
     2248         .
     2249       end.
     2250       do with frame Dialog-Frame
     2251       :
     2252         hide v-diasize-resize-button .
     2253         assign
     2254           v-diasize-resize-button :row    = 1
     2255           v-diasize-resize-button :column = 1
     2256         .
     2257       end.
     2258       if p-change-value > 0
     2259       then do:
     2260         if frame Dialog-Frame :scrollable = true
     2261         then do:
     2262           assign
     2263             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2264             no-error .
     2265           if error-status :error
     2266           or error-status :get-message(1) <> ""
     2267           then do:
     2268             undo move_block, retry move_block .
     2269           end.
     2270         end.
     2271         assign
     2272           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2273           no-error .
     2274         if error-status :error
     2275         or error-status :get-message(1) <> ""
     2276         then do:
     2277           undo move_block, retry move_block .
     2278         end.
     2279         assign
     2280           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2281           no-error .
     2282         if error-status :error
     2283         or error-status :get-message(1) <> ""
     2284         then do:
     2285           undo move_block, retry move_block .
     2286         end.
     2287         for each buf_temp-browse-handle
     2288           where buf_temp-browse-handle.browse-type = 'height':u
     2289         on error undo move_block, retry move_block
     2290         :
     2291           assign
     2292             buf_temp-browse-handle.browse-handle :height
     2293               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2294             no-error .
     2295           if error-status :error
     2296           or error-status :get-message(1) <> ""
     2297           then do:
     2298             undo move_block, retry move_block .
     2299           end.
     2300         end.
     2301         for each buf_temp-diasize-handle
     2302         on error undo move_block, retry move_block
     2303         :
     2304           assign
     2305             v-object-handle = buf_temp-diasize-handle.handle-value
     2306           .
     2307           if v-object-handle <> v-diasize-resize-button
     2308           then do:
     2309             assign
     2310               v-object-handle :row = v-object-handle :row + p-change-value
     2311               no-error .
     2312             if error-status :error
     2313             or error-status :get-message(1) <> ""
     2314             then do:
     2315               undo move_block, retry move_block .
     2316             end.
     2317           end.
     2318         end.
     2319       end.
     2320       else do:
     2321         for each buf_temp-diasize-handle
     2322         on error undo move_block, retry move_block
     2323         :
     2324           assign
     2325             v-object-handle = buf_temp-diasize-handle.handle-value
     2326           .
     2327           if v-object-handle <> v-diasize-resize-button
     2328           then do:
     2329             assign
     2330               v-object-handle :row = v-object-handle :row + p-change-value
     2331               no-error .
     2332             if error-status :error
     2333             or error-status :get-message(1) <> ""
     2334             then do:
     2335               undo move_block, retry move_block .
     2336             end.
     2337           end.
     2338         end.
     2339         assign
     2340           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2341           no-error .
     2342         if error-status :error
     2343         or error-status :get-message(1) <> ""
     2344         then do:
     2345           undo move_block, retry move_block .
     2346         end.
     2347         for each buf_temp-browse-handle
     2348           where buf_temp-browse-handle.browse-type = 'height':u
     2349         on error undo move_block, retry move_block
     2350         :
     2351           assign
     2352             buf_temp-browse-handle.browse-handle :height
     2353               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2354             no-error .
     2355           if error-status :error
     2356           or error-status :get-message(1) <> ""
     2357           then do:
     2358             undo move_block, retry move_block .
     2359           end.
     2360         end.
     2361         assign
     2362           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2363           no-error .
     2364         if error-status :error
     2365         or error-status :get-message(1) <> ""
     2366         then do:
     2367           undo move_block, retry move_block .
     2368         end.
     2369         if frame Dialog-Frame :scrollable = true
     2370         then do:
     2371           assign
     2372             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2373             no-error .
     2374           if error-status :error
     2375           or error-status :get-message(1) <> ""
     2376           then do:
     2377             undo move_block, retry move_block .
     2378           end.
     2379         end.
     2380       end.
     2381       if p-move-resize = true
     2382       then do:
     2383         run diasize_position-resize-button in this-procedure .
     2384       end.
     2385       if v-diasize-wndstore = true
     2386       then do:
     2387         if connected("ub") = true
     2388         then do:
     2389           define variable v-cntxt-db-num        as integer   no-undo .
     2390           define variable v-cntxt-userid        as character no-undo .
     2391           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2392                                             , OUTPUT v-cntxt-userid
     2393                                             ) .
     2394           run gbl/wndsizew.p
     2395             (input  v-cntxt-db-num
     2396             ,input  v-cntxt-userid
     2397             ,input  v-diasize-proc-name
     2398             ,input  'height':u
     2399             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     2400             ) .
     2401         end.
     2402       end.
     2403     end.
     2404     assign
     2405       v-diasize-change-size = false
     2406     .
     2407   end procedure.
     2408   procedure diasize_set-height :
     2409     define input  parameter p-new-height  as decimal   no-undo .
     2410     define input  parameter p-move-resize as logical   no-undo .
     2411     do
     2412     on error undo, return error return-value
     2413     :
     2414       run diasize_change-height in this-procedure
     2415         (input  (p-new-height - frame Dialog-Frame :height)
     2416         ,input  p-move-resize
     2417         ) .
     2418     end.
     2419   end procedure.
     2420   procedure diasize_change-width :
     2421     define input  parameter p-change-value as decimal   no-undo .
     2422     define input  parameter p-move-resize  as logical   no-undo .
     2423     define variable v-field-group-handle   as handle    no-undo .
     2424     define variable v-object-handle        as handle    no-undo .
     2425     define variable v-frame-width          as decimal   no-undo .
     2426     define variable v-frame-virtual-width  as decimal   no-undo .
     2427     define variable v-browse-width         as decimal   no-undo .
     2428     define variable v-window-width         as decimal   no-undo .
     2429     define variable v-window-virtual-width as decimal   no-undo .
     2430     define variable v-change-sign          as integer   no-undo .
     2431     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2432     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2433     if p-change-value > 0
     2434     then do:
     2435       if frame Dialog-Frame :width + p-change-value >
     2436           session :width-chars
     2437       then do:
     2438         assign
     2439           p-change-value = session :width-chars - frame Dialog-Frame :width
     2440         .
     2441         if p-change-value <= 0
     2442         then do:
     2443           run diasize_position-resize-button in this-procedure .
     2444           return .
     2445         end.
     2446       end.
     2447     end.
     2448     if p-change-value < 0
     2449     then do:
     2450       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2451       then do:
     2452         assign
     2453           p-change-value = v-diasize-orig-frame-width
     2454                          - frame Dialog-Frame :width
     2455         .
     2456         if p-change-value >= 0
     2457         then do:
     2458           run diasize_position-resize-button in this-procedure .
     2459           return .
     2460         end.
     2461       end.
     2462     end.
     2463     if p-change-value >= 0
     2464     then do:
     2465       assign
     2466         v-change-sign = 1
     2467       .
     2468     end.
     2469     else do:
     2470       assign
     2471         v-change-sign = -1
     2472       .
     2473     end.
     2474     assign
     2475       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2476     .
     2477     if p-change-value = 0
     2478     then do:
     2479       run diasize_position-resize-button in this-procedure .
     2480       return .
     2481     end.
     2482     move_block:
     2483     do
     2484     on error undo move_block, leave move_block
     2485     :
     2486       if retry
     2487       then do:
     2488         do
     2489         on error undo move_block, leave move_block
     2490         :
     2491           if p-change-value > 0
     2492           then do:
     2493             for each buf_temp-diasize-handle
     2494             on error undo, next
     2495             :
     2496               assign
     2497                 v-object-handle = buf_temp-diasize-handle.handle-value
     2498               .
     2499               if v-object-handle <> v-diasize-resize-button
     2500               then do:
     2501                 assign
     2502                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2503                 .
     2504               end.
     2505             end.
     2506             assign
     2507               v-diasize-browse-handle :width = v-browse-width
     2508             .
     2509             for each buf_temp-browse-handle
     2510               where buf_temp-browse-handle.browse-type = 'width':u
     2511             on error undo, next
     2512             :
     2513               assign
     2514                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2515               .
     2516             end.
     2517             assign
     2518               frame Dialog-Frame :width = v-frame-width
     2519             .
     2520             if frame Dialog-Frame :scrollable = true
     2521             then do:
     2522               assign
     2523                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2524               .
     2525             end.
     2526             run diasize_position-resize-button in this-procedure .
     2527           end.
     2528           else do:
     2529             if frame Dialog-Frame :scrollable = true
     2530             then do:
     2531               assign
     2532                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2533               .
     2534             end.
     2535             assign
     2536               frame Dialog-Frame :width = v-frame-width
     2537             .
     2538             for each buf_temp-browse-handle
     2539               where buf_temp-browse-handle.browse-type = 'width':u
     2540             on error undo, next
     2541             :
     2542               assign
     2543                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2544               .
     2545             end.
     2546             assign
     2547               v-diasize-browse-handle :width = v-browse-width
     2548             .
     2549             for each buf_temp-diasize-handle
     2550             on error undo, next
     2551             :
     2552               assign
     2553                 v-object-handle = buf_temp-diasize-handle.handle-value
     2554               .
     2555               if v-object-handle <> v-diasize-resize-button
     2556               then do:
     2557                 assign
     2558                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2559                 .
     2560               end.
     2561             end.
     2562             run diasize_position-resize-button in this-procedure .
     2563           end.
     2564           assign
     2565             v-diasize-change-size = false
     2566           .
     2567           leave move_block .
     2568         end.
     2569       end.
     2570       assign
     2571         v-diasize-need-full-display = true
     2572       .
     2573       if v-diasize-change-size = false
     2574       then do:
     2575         assign
     2576           v-diasize-change-size = true
     2577         .
     2578       end.
     2579       else do:
     2580         return .
     2581       end.
     2582       assign
     2583         v-frame-width = frame Dialog-Frame :width
     2584         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2585         v-browse-width = v-diasize-browse-handle :width
     2586       .
     2587       for each buf_temp-browse-handle
     2588         where buf_temp-browse-handle.browse-type = 'width':u
     2589       :
     2590         assign
     2591           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2592         .
     2593       end.
     2594       for each buf_temp-diasize-handle
     2595       :
     2596         delete buf_temp-diasize-handle .
     2597       end.
     2598       assign
     2599         v-field-group-handle = frame Dialog-Frame :first-child
     2600       .
     2601       do while valid-handle(v-field-group-handle)
     2602       :
     2603         assign
     2604           v-object-handle = v-field-group-handle :first-child
     2605         .
     2606         do while valid-handle(v-object-handle)
     2607         :
     2608           if  v-object-handle <> v-diasize-browse-handle :handle
     2609           and v-object-handle <> v-diasize-resize-button
     2610           and can-query(v-object-handle, "row")
     2611           and can-query(v-object-handle, "height")
     2612           and ( v-object-handle :col + v-object-handle :width
     2613                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2614               )
     2615           then do:
     2616             find first buf_temp-browse-handle
     2617               where buf_temp-browse-handle.browse-type   = 'width':u
     2618                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2619               no-error .
     2620             if available buf_temp-browse-handle
     2621             then do:
     2622             end.
     2623             else do:
     2624               create buf_temp-diasize-handle .
     2625               assign
     2626                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2627                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2628               .
     2629             end.
     2630           end.
     2631           assign
     2632             v-object-handle = v-object-handle :next-sibling
     2633           .
     2634         end.
     2635         assign
     2636           v-field-group-handle = v-field-group-handle :next-sibling
     2637         .
     2638       end.
     2639       do with frame Dialog-Frame
     2640       :
     2641         hide v-diasize-resize-button .
     2642         v-diasize-resize-button :row = 1.
     2643         v-diasize-resize-button :column = 1.
     2644       end.
     2645       if p-change-value > 0
     2646       then do:
     2647         if frame Dialog-Frame :scrollable = true
     2648         then do:
     2649           assign
     2650             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2651             no-error .
     2652           if error-status :error
     2653           or error-status :get-message(1) <> ""
     2654           then do:
     2655             undo move_block, retry move_block.
     2656           end.
     2657         end.
     2658         assign
     2659           frame Dialog-Frame :width = v-frame-width + p-change-value
     2660           no-error .
     2661         if error-status :error
     2662         or error-status :get-message(1) <> ""
     2663         then do:
     2664           undo move_block, retry move_block.
     2665         end.
     2666         assign
     2667           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2668         no-error .
     2669         if error-status :error
     2670         or error-status :get-message(1) <> ""
     2671         then do:
     2672           undo move_block, retry move_block.
     2673         end.
     2674         for each buf_temp-browse-handle
     2675           where buf_temp-browse-handle.browse-type = 'width':u
     2676         on error undo move_block, retry move_block
     2677         :
     2678           assign
     2679             buf_temp-browse-handle.browse-handle :width
     2680               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2681             no-error .
     2682           if error-status :error
     2683           or error-status :get-message(1) <> ""
     2684           then do:
     2685             undo move_block, retry move_block .
     2686           end.
     2687         end.
     2688         for each buf_temp-diasize-handle
     2689         on error undo move_block, retry move_block
     2690         :
     2691           assign
     2692             v-object-handle = buf_temp-diasize-handle.handle-value
     2693           .
     2694           if v-object-handle <> v-diasize-resize-button
     2695           then do:
     2696             assign
     2697               v-object-handle :col = v-object-handle :col + p-change-value
     2698               no-error .
     2699             if error-status :error
     2700             or error-status :get-message(1) <> ""
     2701             then do:
     2702               undo move_block, retry move_block .
     2703             end.
     2704           end.
     2705         end.
     2706       end.
     2707       else do:
     2708         for each buf_temp-diasize-handle
     2709         on error undo move_block, retry move_block
     2710         :
     2711           assign
     2712             v-object-handle = buf_temp-diasize-handle.handle-value
     2713           .
     2714           if v-object-handle <> v-diasize-resize-button
     2715           then do:
     2716             assign
     2717               v-object-handle :col = v-object-handle :col + p-change-value
     2718               no-error .
     2719             if error-status :error
     2720             or error-status :get-message(1) <> ""
     2721             then do:
     2722               undo move_block, retry move_block .
     2723             end.
     2724           end.
     2725         end.
     2726         for each buf_temp-browse-handle
     2727           where buf_temp-browse-handle.browse-type = 'width':u
     2728         on error undo move_block, retry move_block
     2729         :
     2730           assign
     2731             buf_temp-browse-handle.browse-handle :width
     2732               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2733             no-error .
     2734           if error-status :error
     2735           or error-status :get-message(1) <> ""
     2736           then do:
     2737             undo move_block, retry move_block .
     2738           end.
     2739         end.
     2740         assign
     2741           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2742           no-error .
     2743         if error-status :error
     2744         or error-status :get-message(1) <> ""
     2745         then do:
     2746           undo move_block, retry move_block.
     2747         end.
     2748         assign
     2749           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2750         no-error .
     2751         if error-status :error
     2752         or error-status :get-message(1) <> ""
     2753         then do:
     2754           undo move_block, retry move_block.
     2755         end.
     2756         if frame Dialog-Frame :scrollable = true
     2757         then do:
     2758           assign
     2759             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2760           no-error .
     2761           if error-status :error
     2762           or error-status :get-message(1) <> ""
     2763           then do:
     2764             undo move_block, retry move_block.
     2765           end.
     2766         end.
     2767       end.
     2768       if p-move-resize
     2769       then do:
     2770         run diasize_position-resize-button in this-procedure .
     2771       end.
     2772       if v-diasize-wndstore = true
     2773       then do:
     2774         if connected("ub") = true
     2775         then do:
     2776           define variable v-cntxt-db-num        as integer   no-undo .
     2777           define variable v-cntxt-userid        as character no-undo .
     2778           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2779                                             , OUTPUT v-cntxt-userid
     2780                                             ) .
     2781           run gbl/wndsizew.p
     2782             (input  v-cntxt-db-num
     2783             ,input  v-cntxt-userid
     2784             ,input  v-diasize-proc-name
     2785             ,input  'width':u
     2786             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2787             ) .
     2788         end.
     2789       end.
     2790     end.
     2791     assign
     2792       v-diasize-change-size = false
     2793     .
     2794   end procedure.
     2795   procedure diasize_set-width :
     2796     define input  parameter p-new-width  as decimal   no-undo .
     2797     define input  parameter p-move-resize as logical   no-undo .
     2798     do
     2799     on error undo, return error return-value
     2800     :
     2801       run diasize_change-width in this-procedure
     2802         (input  (p-new-width - frame Dialog-Frame :width)
     2803         ,input  p-move-resize
     2804         ) .
     2805     end.
     2806   end procedure.
     2807   procedure diasize_position-resize-button :
     2808     do with frame Dialog-Frame
     2809     :
     2810       hide v-diasize-resize-button .
     2811       assign
     2812         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2813                     - 1
     2814                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2815         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2816                     - 1
     2817                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2818       .
     2819       view v-diasize-resize-button .
     2820     end.
     2821   end procedure.
     2822   on alt-right anywhere
     2823   do:
     2824     run diasize_change-width in this-procedure
     2825       (input 1
     2826       ,input true
     2827       ) .
     2828     return no-apply .
     2829   end.
     2830   on alt-left anywhere
     2831   do:
     2832     run diasize_change-width in this-procedure
     2833       (input -1
     2834       ,input true
     2835       ) .
     2836     return no-apply .
     2837   end.
     2838   on alt-down anywhere
     2839   do:
     2840     run diasize_change-height in this-procedure
     2841       (input 1
     2842       ,input true
     2843       ) .
     2844     return no-apply .
     2845   end.
     2846   on alt-up anywhere
     2847   do:
     2848     run diasize_change-height in this-procedure
     2849       (input -1
     2850       ,input true
     2851       ) .
     2852     return no-apply .
     2853   end.
     2854   on alt-enter of frame Dialog-Frame
     2855   do:
     2856     run diasize_maximize in this-procedure
     2857       (input  ?
     2858       ).
     2859     return no-apply .
     2860   end.
     2861   procedure diasize_end-move :
     2862     do
     2863     on error undo, return error return-value
     2864     :
     2865       define variable v-row-delta as decimal   no-undo .
     2866       define variable v-col-delta as decimal   no-undo .
     2867       define variable v-new-row as decimal   no-undo .
     2868       define variable v-new-col as decimal   no-undo .
     2869       assign
     2870         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2871         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2872       .
     2873       assign
     2874         v-row-delta = v-new-row - frame Dialog-Frame :height
     2875         v-col-delta = v-new-col - frame Dialog-Frame :width
     2876       .
     2877       run diasize_change-height in this-procedure
     2878         (input v-row-delta
     2879         ,input true
     2880         ) .
     2881       run diasize_change-width in this-procedure
     2882         (input v-col-delta
     2883         ,input true
     2884         ) .
     2885     end.
     2886   end procedure.
     2887   procedure diasize_maximize :
     2888     define input  parameter p-action as logical   no-undo .
     2889     do
     2890     on error undo, return error return-value
     2891     :
     2892       if p-action = ?
     2893       then do:
     2894         if v-diasize-need-maximize = true
     2895         then do:
     2896           assign
     2897             p-action = true
     2898           .
     2899         end.
     2900         else do:
     2901           assign
     2902             p-action = false
     2903           .
     2904         end.
     2905       end.
     2906       if p-action = true
     2907       then do:
     2908         run diasize_change-height in this-procedure
     2909           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2910               - frame Dialog-Frame :height-chars
     2911           ,input true
     2912           ) .
     2913         run diasize_change-width in this-procedure
     2914           (input session :width-chars
     2915               - frame Dialog-Frame :width-chars
     2916           ,input true
     2917           ) .
     2918         assign
     2919           v-diasize-need-maximize = false
     2920         .
     2921       end.
     2922       else do:
     2923         run diasize_change-width in this-procedure
     2924           (input v-diasize-orig-frame-width
     2925               - frame Dialog-Frame :width-chars
     2926           ,input true
     2927           ) .
     2928         run diasize_change-height in this-procedure
     2929           (input v-diasize-orig-frame-height
     2930               - frame Dialog-Frame :height-chars
     2931           ,input true
     2932           ) .
     2933         assign
     2934           v-diasize-need-maximize = true
     2935         .
     2936       end.
     2937     end.
     2938   end procedure.
     2939   procedure diasize_restore-orig-size :
     2940     do
     2941     on error undo, return error return-value
     2942     :
     2943       assign
     2944         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2945         v-diasize-current-frame-height = frame Dialog-Frame :height
     2946       .
     2947       run diasize_set-height in this-procedure
     2948         (input  v-diasize-orig-frame-height
     2949         ,input  true
     2950         ) .
     2951       run diasize_set-width in this-procedure
     2952         (input  v-diasize-orig-frame-width
     2953         ,input  true
     2954         ) .
     2955     end.
     2956   end procedure.
     2957   procedure diasize_restore-current-size :
     2958     do
     2959     on error undo, return error return-value
     2960     :
     2961       run diasize_set-height in this-procedure
     2962         (input  v-diasize-current-frame-height
     2963         ,input  true
     2964         ) .
     2965       run diasize_set-width in this-procedure
     2966         (input  v-diasize-current-frame-width
     2967         ,input  true
     2968         ) .
     2969     end.
     2970   end procedure.
     2971   procedure diasize_set-browse-handle :
     2972     define input  parameter p-browse-handle as handle   no-undo .
     2973     define buffer buf_temp-browse-handle for temp-browse-handle .
     2974     do
     2975     on error undo, return error return-value
     2976     :
     2977       assign
     2978         v-diasize-browse-handle = p-browse-handle
     2979       .
     2980       for each buf_temp-browse-handle
     2981       on error undo, return error return-value
     2982       :
     2983         delete buf_temp-browse-handle .
     2984       end.
     2985     end.
     2986   end procedure.
     2987   procedure diasize_add_browse :
     2988     define input  parameter p-browse-type   as character no-undo .
     2989     define input  parameter p-browse-handle as handle    no-undo .
     2990     define buffer buf_temp-browse-handle for temp-browse-handle .
     2991     do
     2992     on error undo, return error return-value
     2993     :
     2994       assign
     2995         v-diasize-browse-number = v-diasize-browse-number + 1
     2996       .
     2997       create buf_temp-browse-handle .
     2998       assign
     2999         buf_temp-browse-handle.browse-type   = p-browse-type
     3000         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     3001         buf_temp-browse-handle.browse-handle = p-browse-handle
     3002       .
     3003     end.
     3004   end procedure.
     3005   procedure diasize_init :
     3006     define variable v-default-value    as logical   no-undo .
     3007     define variable v-restore-saved    as logical   no-undo .
     3008     define variable v-resize-value-str as character no-undo .
     3009     do
     3010     on error undo, return error return-value
     3011     :
     3012       do with frame Dialog-Frame
     3013       :
     3014         assign
     3015           v-diasize-orig-frame-height = frame Dialog-Frame :height
     3016           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     3017           v-diasize-browse-handle     = browse Br-params :handle
     3018         .
     3019         create button v-diasize-resize-button
     3020         assign
     3021           parent        = frame Dialog-Frame :first-child
     3022           label         = "s"
     3023           height-pixels = 16
     3024           width-pixels  = 16
     3025           visible       = true
     3026           sensitive     = true
     3027           movable       = true
     3028           triggers:
     3029             on end-move persistent run diasize_end-move in this-procedure .
     3030           end triggers.
     3031         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     3032         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     3033         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     3034         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     3035         assign
     3036           v-diasize-wndmax = false
     3037         .
     3038         if connected("ub") = true
     3039         then do:
     3040           define variable v-cntxt-db-num        as integer   no-undo .
     3041           define variable v-cntxt-userid        as character no-undo .
     3042           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3043                                             , OUTPUT v-cntxt-userid
     3044                                             ) .
     3045           run gbl/wndpar_r.p
     3046             (input  v-cntxt-db-num
     3047             ,input  v-cntxt-userid
     3048             ,input  'wndmax':U
     3049             ,output v-diasize-wndmax
     3050             ,output v-default-value
     3051             ) .
     3052         end.
     3053         assign
     3054           v-diasize-wndstore = false
     3055         .
     3056         if connected("ub") = true
     3057         then do:
     3058           run gbl/wndpar_r.p
     3059             (input  v-cntxt-db-num
     3060             ,input  v-cntxt-userid
     3061             ,input  'wndstore':U
     3062             ,output v-diasize-wndstore
     3063             ,output v-default-value
     3064             ) .
     3065         end.
     3066         assign
     3067           v-diasize-proc-name = entry(1, program-name(2), '.')
     3068         .
     3069         if v-diasize-wndstore = true
     3070         then do:
     3071           assign
     3072             v-restore-saved = false
     3073           .
     3074           if connected("ub") = true
     3075           then do:
     3076             run gbl/wndsizer.p
     3077               (input  v-cntxt-db-num
     3078               ,input  v-cntxt-userid
     3079               ,input  v-diasize-proc-name
     3080               ,input  'height':u
     3081               ,output v-resize-value-str
     3082               ) .
     3083             if v-resize-value-str <> '':U
     3084             then do:
     3085               run diasize_change-height in this-procedure
     3086                 (input  integer(v-resize-value-str)
     3087                 ,input  true
     3088                 ) .
     3089               assign
     3090                 v-restore-saved = true
     3091               .
     3092             end.
     3093           end.
     3094           if connected("ub") = true
     3095           then do:
     3096             run gbl/wndsizer.p
     3097               (input  v-cntxt-db-num
     3098               ,input  v-cntxt-userid
     3099               ,input  v-diasize-proc-name
     3100               ,input  'width':u
     3101               ,output v-resize-value-str
     3102               ) .
     3103             if v-resize-value-str <> '':U
     3104             then do:
     3105               run diasize_change-width in this-procedure
     3106                 (input  integer(v-resize-value-str)
     3107                 ,input  true
     3108                 ) .
     3109               assign
     3110                 v-restore-saved = true
     3111               .
     3112             end.
     3113           end.
     3114           if v-restore-saved <> true
     3115           then do:
     3116             if v-diasize-wndmax = true
     3117             then do:
     3118               run diasize_maximize in this-procedure
     3119                 (input  true
     3120                 ) .
     3121             end.
     3122           end.
     3123         end.
     3124         else do:
     3125           if v-diasize-wndmax = true
     3126           then do:
     3127             run diasize_maximize in this-procedure
     3128               (input  true
     3129               ) .
     3130           end.
     3131         end.
     3132       end.
     3133     end.
     3134   end procedure.
     3135   procedure diasize_need-full-display :
     3136     define output parameter p-need-full-display as logical   no-undo .
     3137     do
     3138     on error undo, return error return-value
     3139     :
     3140       assign
     3141         p-need-full-display = v-diasize-need-full-display
     3142       .
     3143       assign
     3144         v-diasize-need-full-display = false
     3145       .
     3146     end.
     3147   end procedure.
     3148   procedure get-context :
     3149      define output parameter p-db-num as integer          no-undo.
     3150      define output parameter p-user-id as character        no-undo.
     3151      define variable v-login               as character    no-undo.
     3152      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     3153      define buffer buf_user-login  for ub.user-login .
     3154      do
     3155      on error undo, return error
     3156      :
     3157            FIND FIRST buf_sys-ctrl no-lock.
     3158            ASSIGN
     3159               v-login = USERID("ub")
     3160               p-db-num = buf_sys-ctrl.db-num
     3161            .
     3162            FIND FIRST buf_user-login
     3163                 WHERE buf_user-login.db-num = p-db-num
     3164                   AND buf_user-login.user-login = v-login
     3165                 no-lock
     3166                 no-error
     3167                 .
     3168            IF AVAILABLE buf_user-login
     3169            THEN DO:
     3170               assign
     3171                  p-user-id = buf_user-login.user-id
     3172               .
     3173            END.
     3174      end.
     3175   end procedure.
     3176       run diasize_init in this-procedure .
     3177   MAIN-BLOCK:
     3178   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3179      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     3180     if p-mode = 'ПРОСМОТР':U then do:
     3181       FIND FIRST buf_ext-file no-lock WHERE
     3182                buf_Ext-file.db-num = p-db-num
     3183            AND buf_Ext-file.file-num = p-file-num NO-ERROR.
     3184       IF NOT AVAILABLE buf_Ext-file THEN DO:
     3185           MESSAGE
     3186           vss-workfile vss-revision vss-description skip
     3187           "Неверно заданы входные параметры p-db-num, p-file-num" SKIP
     3188           "В БД не хранится такой файл"
     3189            VIEW-AS ALERT-BOX ERROR.
     3190            RETURN .
     3191       END.
     3192       ASSIGN
     3193       v-run-name = prepare-path(ENTRY(1, buf_ext-file.FILE-NAME, ">"))
     3194       v-run-name = ENTRY(NUM-ENTRIES(v-run-name, chr(47)) ,v-run-name, chr(47)).
     3195       run fill-table in this-procedure .
     3196     end.
     3197     run Myenable in this-procedure .
     3198     WAIT-FOR GO OF FRAME Dialog-Frame.
     3199   END.
     3200   RUN disable_UI.
     3201   PROCEDURE disable_UI :
     3202     HIDE FRAME Dialog-Frame.
     3203   END PROCEDURE.
     3204   PROCEDURE enable_UI :
     3205     ENABLE b-quit B-add B-del b-lkp B-Help Br-params
     3206         WITH FRAME Dialog-Frame.
     3207     VIEW FRAME Dialog-Frame.
     3208     OPEN QUERY Br-params FOR EACH tt-ext-file-par  INDEXED-REPOSITION.
     3209   END PROCEDURE.
     3210   PROCEDURE fill-table :
     3211   DEFINE buffer buf_ext-file-par FOR ub.ext-file-par.
     3212   DEFINE buffer buf_tt-ext-file-par FOR tt-ext-file-par.
     3213   run ext-file-par-clear-temp IN THIS-PROCEDURE.
     3214   CASE p-list-mode:
     3215     WHEN "input" THEN DO:
     3216       FOR EACH buf_ext-file-par NO-LOCK WHERE
     3217               buf_ext-file-par.db-num = p-db-num
     3218           and buf_ext-file-par.from-db-num = p-from-db-num
     3219          AND buf_ext-file-par.file-num = p-file-num
     3220          and buf_ext-file-par.param-num > 0
     3221          :
     3222         CREATE buf_tt-ext-file-par.
     3223         BUFFER-COPY buf_ext-file-par TO buf_tt-ext-file-par.
     3224       END.
     3225     END.
     3226     WHEN "output" THEN DO:
     3227       FOR EACH buf_ext-file-par NO-LOCK WHERE
     3228               buf_ext-file-par.db-num = p-db-num
     3229           and buf_ext-file-par.from-db-num = p-from-db-num
     3230          AND buf_ext-file-par.file-num = p-file-num
     3231          and buf_ext-file-par.param-num <= 0
     3232          :
     3233         CREATE buf_tt-ext-file-par.
     3234         BUFFER-COPY buf_ext-file-par TO buf_tt-ext-file-par.
     3235       END.
     3236     END.
     3237   END CASE.
     3238   END PROCEDURE.
     3239   PROCEDURE MyEnable :
     3240   DEFINE VARIABLE v-ch0 AS WIDGET-HANDLE NO-UNDO.
     3241   DEFINE VARIABLE v-ch-cd AS WIDGET-HANDLE NO-UNDO.
     3242   DEFINE VARIABLE v-ch-file AS WIDGET-HANDLE NO-UNDO.
     3243   IF available buf_ext-file
     3244   and buf_ext-file.FILE-TYPE BEGINS ('cash-desk':U + chr(3) )
     3245   AND p-mode = 'ПРОСМОТР':U    THEN DO:
     3246     v-ibm-xml-mode = YES.
     3247   END.
     3248   ASSIGN
     3249   v-ch0 = br-params:FIRST-COLUMN IN FRAME Dialog-Frame.
     3250   REPEAT WHILE valid-handle(v-ch0):
     3251      IF v-ch0:LABEL = "Касса" THEN DO:
     3252        v-ch-cd = v-ch0.
     3253        v-ch-cd:resizable = yes.
     3254      END.
     3255      IF v-ch0:LABEL = "Файл" THEN DO:
     3256         v-ch-file = v-ch0.
     3257        v-ch-file:resizable = yes.
     3258      END.
     3259     v-ch0 = v-ch0:NEXT-COLUMN.
     3260   END.
     3261   assign
     3262   b-add:menu-mouse in frame Dialog-Frame = 1
     3263   tt-ext-file-par.param-name:resizable in browse br-params = yes
     3264   tt-ext-file-par.param-value:resizable in browse br-params = yes
     3265   tt-ext-file-par.param-date-name:resizable in browse br-params = yes
     3266   tt-ext-file-par.param-int-name:resizable in browse br-params = yes
     3267   tt-ext-file-par.param-log-name:resizable in browse br-params = yes
     3268   .
     3269   IF v-ibm-xml-mode THEN DO:
     3270     ASSIGN
     3271     tt-ext-file-par.param-name:visible  IN BROWSE br-params = no
     3272     tt-ext-file-par.param-value:visible  IN BROWSE br-params = no
     3273     tt-ext-file-par.param-date-name:visible  IN BROWSE br-params = no
     3274     tt-ext-file-par.param-date-value:visible  IN BROWSE br-params = no
     3275     tt-ext-file-par.param-int-name:visible  IN BROWSE br-params = no
     3276     tt-ext-file-par.param-int-value:visible  IN BROWSE br-params = no
     3277     tt-ext-file-par.param-log-name:visible  IN BROWSE br-params = no
     3278     tt-ext-file-par.param-log-value:visible  IN BROWSE br-params = no
     3279     .
     3280   END.
     3281   ELSE DO:
     3282     v-ch-cd:VISIBLE = NO.
     3283     v-ch-file:VISIBLE = NO.
     3284   END.
     3285   ENABLE
     3286   b-quit
     3287   B-add  WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     3288   B-del WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     3289   B-Help
     3290   Br-params
     3291   b-lkp WHEN v-ibm-xml-mode
     3292   WITH FRAME Dialog-Frame .
     3293   CASE p-mode:
     3294     WHEN 'ПРОСМОТР':U THEN DO:
     3295       IF p-list-mode = "Input" THEN DO:
     3296         FRAME Dialog-Frame:TITLE = substitute("Входные параметры для файла &1 (БД &2, № файла &3): ПРОСМОТР"
     3297                                               , v-run-name
     3298                                               , p-db-num
     3299                                               , p-file-num).
     3300       END.
     3301       IF p-list-mode = "output" THEN DO:
     3302         FRAME Dialog-Frame:TITLE = substitute("Результаты работы файла &1 (№ &2) на БД &3: ПРОСМОТР"
     3303                                               , v-run-name
     3304                                               , p-file-num
     3305                                               , p-db-num).
     3306       END.
     3307     END.
     3308     WHEN 'ИЗМЕНЕНИЕ':U THEN DO:
     3309         FRAME Dialog-Frame:TITLE = substitute("Входные параметры для запуска файла: РЕДАКТИРОВАНИЕ").
     3310     END.
     3311   END CASE.
     3312   VIEW FRAME Dialog-Frame .
     3313   run OpenBr IN THIS-PROCEDURE.
     3314   END PROCEDURE.
     3315   PROCEDURE OpenBr :
     3316   CASE p-mode:
     3317     WHEN 'ИЗМЕНЕНИЕ':U THEN DO:
     3318       OPEN QUERY Br-params
     3319           FOR EACH tt-ext-file-par .
     3320     END.
     3321     WHEN 'ПРОСМОТР':U THEN DO:
     3322        OPEN QUERY Br-params
     3323             FOR EACH tt-ext-file-par NO-LOCK  .
     3324     END.
     3325   END CASE.
     3326   END PROCEDURE.
     3327   PROCEDURE proc-b-add :
     3328   DEFINE INPUT PARAMETER p-option AS CHARACTER NO-UNDO.
     3329   define variable v-value-name as character no-undo .
     3330   define variable v-value as character no-undo .
     3331   DEFINE VARIABLE v-today as date no-undo .
     3332   DEFINE VARIABLE v-time as integer no-undo .
     3333   DEFINE BUFFER buf_tt-ext-file-par FOR tt-ext-file-par.
     3334   FIND LAST buf_tt-ext-file-par WHERE
     3335          buf_tt-ext-file-par.db-num = - 1
     3336      and buf_tt-ext-file-par.from-db-num = - 1
     3337      and buf_tt-ext-file-par.file-num = - 1  NO-ERROR.
     3338   IF NOT AVAILABLE buf_tt-ext-file-par THEN DO:
     3339       v-num-params = 1.
     3340   END.
     3341   ELSE DO:
     3342       v-num-params = buf_tt-ext-file-par.param-num + 1.
     3343   END.
     3344       run gbl/d-prompt.w (
     3345         'title=':u + "Введите Название параметра" + '\':u
     3346       + 'text1=':u + "(реком. исп. короткие слова на латин. раскладке)" + '\':u
     3347       + 'format=' + "X(40)" + '\':u
     3348       + 'type=' + 'C':U + '\':u
     3349       + 'fillin_row=3\':u
     3350       + 'fillin_col=4\':u
     3351       + 'fillin_width=42\':u
     3352       + 'fillin_height=1\':u
     3353       + 'max-chars=10\':u
     3354       + 'readonly=no\':u
     3355       , input-output v-value
     3356       ).
     3357   run cur-time in this-procedure(output v-today, output v-time).
     3358   run ext-file-par-write-temp in this-procedure (
     3359                                           input - 1
     3360                                         , input - 1
     3361                                         , input - 1
     3362                                         , input  string(v-num-params)
     3363                                         , input  p-option
     3364                                         , input  v-value
     3365                                         , input  '':U
     3366                                         , input  v-today
     3367                                         , input  0
     3368                                         , input  0.0
     3369                                         , input  no).
     3370   run OpenBr in this-procedure.
     3371   END PROCEDURE.
     3372   PROCEDURE proc-b-lkp :
     3373   END PROCEDURE.
     3374   PROCEDURE proc-lkp :
     3375   DEFINE VARIABLE glog AS LOGICAL NO-UNDO.
     3376   DEFINE VARIABLE v-override AS INTEGER no-UNDO.
     3377   DEFINE VARIABLE v-temp-file-name AS CHARACTER NO-UNDO.
     3378   define variable v-tbl-row as rowid no-undo .
     3379   define variable v-tbl-name as character no-undo .
     3380   define buffer par_ext-file for ub.ext-file.
     3381   run gen-row-keyr in this-procedure (
     3382      input  tt-ext-file-par.param-value
     3383     ,input  ?
     3384     ,input  "ub"
     3385     ,input  ?
     3386     ,input  no-lock
     3387     ,output v-tbl-row
     3388     ,output v-tbl-name  ) no-error.
     3389   if not error-status:error then do:
     3390     find first par_ext-file no-lock where
     3391               rowid(par_ext-file) = v-tbl-row.
     3392   end.
     3393   else do:
     3394     message
     3395     "Не найден в хранилище БД файл." skip
     3396     "Возможно он уже удален или не существовал"
     3397     view-as alert-box error.
     3398     undo, return error .
     3399   end.
     3400   run gbl/_tmpfile.p (
     3401          input  't':U
     3402         ,input  "." + entry( num-entries(par_ext-file.file-name, "."), par_ext-file.FILE-NAME, ".")
     3403         ,output v-temp-file-name
     3404         ) .
     3405   run adm/extfsavd.p (
     3406                INPUT par_ext-file.db-num
     3407               ,INPUT par_ext-file.from-db-num
     3408               ,INPUT par_ext-file.file-num
     3409               ,INPUT v-temp-file-name
     3410               ,INPUT-OUTPUT v-override) NO-ERROR.
     3411   IF ERROR-STATUS:ERROR THEN DO:
     3412     MESSAGE
     3413     SUBSTITUTE("Ошибка при сохранении файла &1 на диск во временный файл&2&3&2&4&2"
     3414             , par_ext-file.FILE-NAME
     3415             , chr(10)
     3416             ,error-status:get-message(1)
     3417             , RETURN-VALUE)
     3418     VIEW-AS ALERT-BOX ERROR.
     3419     RETURN ERROR.
     3420   END.
     3421   os-command  value ('start /wait /b ' + v-temp-file-name).
     3422   OS-DELETE VALUE(v-temp-file-name).
     3423   END PROCEDURE.
