        1   block-level on error undo, throw.
        2   define input parameter p-source-db    as integer   no-undo .
        3   define input parameter p-full-command as character no-undo .
        4   define variable vss-revision    as character no-undo init "$Revision$":U .
        5   define variable vss-author      as character no-undo init "$Author$":U .
        6   define variable vss-date        as character no-undo init "$Date$":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        8   define variable vss-archive     as character no-undo init "$Archive$":U .
        9   define variable vss-description as character no-undo init "Обработка команды two-commit".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   def var vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       69   procedure progs-name :
       70     define input  parameter p-action-code         as character no-undo .
       71     define output parameter p-main-prog-name      as character no-undo .
       72     define output parameter p-list-db-proc-name   as character no-undo .
       73     define output parameter p-commit-proc-name    as character no-undo .
       74     define output parameter p-execution-proc-name as character no-undo .
       75     define output parameter p-recover-proc-name   as character no-undo .
       76     define output parameter p-after-proc-name     as character no-undo .
       77     do
       78     on error undo, return error
       79     :
       80       case p-action-code :
       81               when 'crush_code-range':U then do:     assign       p-main-prog-name      = 'trg/code-rgt.p':U       p-list-db-proc-name   = 'utl/cdrg-dbl.p':U       p-commit-proc-name    = 'comm-crush-cdrg':U       p-execution-proc-name = 'exec-crush-cdrg':U       p-recover-proc-name   = 'rcvr-crush-cdrg':U       p-after-proc-name     = '':U     .   end.
       82               when 'delete_code-range':U then do:     assign       p-main-prog-name      = 'trg/code-rgt.p':U       p-list-db-proc-name   = 'utl/cdrg-dbl.p':U       p-commit-proc-name    = 'comm-del-cdrg':U       p-execution-proc-name = 'exec-del-cdrg':U       p-recover-proc-name   = 'rcvr-del-cdrg':U       p-after-proc-name     = '':U     .   end.
       83               when 'delete_nu-prt-bar-code':U then do:     assign       p-main-prog-name      = 'trg/bar-codt.p':U       p-list-db-proc-name   = 'str/barcddb.p':U       p-commit-proc-name    = 'block-del-prt-bar-code':U       p-execution-proc-name = 'delete-prt-bar-code':U       p-recover-proc-name   = 'undo-delete-prt-bar-code':U       p-after-proc-name     = '':U     .   end.
       84               when 'delete_nu-part-bar-code':U then do:     assign       p-main-prog-name      = 'trg/bar-codt.p':U       p-list-db-proc-name   = 'str/barcddb.p':U       p-commit-proc-name    = 'block-del-part-bar-code':U       p-execution-proc-name = 'delete-part-bar-code':U       p-recover-proc-name   = 'undo-delete-part-bar-code':U       p-after-proc-name     = '':U     .   end.
       85               when 'delete_nu-ucli-bar-code':U then do:     assign       p-main-prog-name      = 'trg/bar-codt.p':U       p-list-db-proc-name   = 'str/barcddb.p':U       p-commit-proc-name    = 'block-del-ucli-bar-code':U       p-execution-proc-name = 'delete-ucli-bar-code':U       p-recover-proc-name   = 'undo-delete-ucli-bar-code':U       p-after-proc-name     = '':U     .   end.
       86               when 'delete_nu-dis-card':U then do:     assign       p-main-prog-name      = 'trg/discardt.p':U       p-list-db-proc-name   = 'trg/discardb.p':U       p-commit-proc-name    = 'block-del-dis-card':U       p-execution-proc-name = 'delete-dis-card':U       p-recover-proc-name   = 'undo-delete-dis-card':U       p-after-proc-name     = '':U     .   end.
       87               when 'chown-dis-card':U then do:     assign       p-main-prog-name      = 'trg/discardt.p':U       p-list-db-proc-name   = 'trg/discardb.p':U       p-commit-proc-name    = 'block-chown-dis-card':U       p-execution-proc-name = 'chown-dis-card':U       p-recover-proc-name   = 'undo-chown-dis-card':U       p-after-proc-name     = 'after-chown-dis-card':U     .   end.
       88               when 'delete_nu-dis-rule':U then do:     assign       p-main-prog-name      = 'trg/dis-rult.p':U       p-list-db-proc-name   = 'trg/disruldb.p':U       p-commit-proc-name    = 'block-del-dis-rule':U       p-execution-proc-name = 'delete-dis-rule':U       p-recover-proc-name   = 'undo-delete-dis-rule':U       p-after-proc-name     = '':U     .   end.
       89               when 'ren-art':U then do:     assign       p-main-prog-name      = 'trg/goodst.p':U       p-list-db-proc-name   = 'utl/renartcd.p':U       p-commit-proc-name    = 'comm-ren-art':U       p-execution-proc-name = 'exec-ren-art':U       p-recover-proc-name   = 'rcvr-ren-art':U       p-after-proc-name     = 'after-ren-art':U     .   end.
       90               when 'delete_nu-clob-data':U then do:     assign       p-main-prog-name      = 'trg/clobdatt.p':U       p-list-db-proc-name   = 'trg/clbdatdb.p':U       p-commit-proc-name    = 'block-del-clob-data':U       p-execution-proc-name = 'delete-clob-data':U       p-recover-proc-name   = 'undo-delete-clob-data':U       p-after-proc-name     = '':U     .   end.
       91               when 'delete_nu-layout':U then do:     assign       p-main-prog-name      = 'trg/layoutt.p':U       p-list-db-proc-name   = 'trg/layoutdb.p':U       p-commit-proc-name    = 'block-del-layout':U       p-execution-proc-name = 'delete-layout':U       p-recover-proc-name   = 'undo-delete-layout':U       p-after-proc-name     = '':U     .   end.
       92               otherwise do:
       93           return error substitute( "&1. Неизвестный тип операции: &2", vss-include-info0, p-action-code ).
       94         end.
       95       end case.
       96     end.
       97     return.
       98   end procedure.
       99   procedure progs-title :
      100     define input  parameter p-action-code         as character no-undo .
      101     define output parameter p-action-title      as character no-undo .
      102     do
      103     on error undo, return error
      104     :
      105       case p-action-code :
      106               when 'crush_code-range':U then do:     assign       p-action-title        = "Разбиение диапазона кодов (code-range)"     .   end.
      107               when 'delete_code-range':U then do:     assign       p-action-title        = "Удаление диапазона кодов (code-range)"     .   end.
      108               when 'delete_nu-prt-bar-code':U then do:     assign       p-action-title        = "Удаление неисп. бар-кода признака"     .   end.
      109               when 'delete_nu-part-bar-code':U then do:     assign       p-action-title        = "Удаление неисп. бар-кода партиии"     .   end.
      110               when 'delete_nu-ucli-bar-code':U then do:     assign       p-action-title        = "Удаление неисп.бар-кода на доп ед.изм."     .   end.
      111               when 'delete_nu-dis-card':U then do:     assign       p-action-title        = "Удаление неиспользуемой ДК"     .   end.
      112               when 'chown-dis-card':U then do:     assign       p-action-title        = "Смена владельца ДК"     .   end.
      113               when 'delete_nu-dis-rule':U then do:     assign       p-action-title        = "Удаление правила скидки по фирме и глобального правила скидки"     .   end.
      114               when 'ren-art':U then do:     assign       p-action-title        = "Изм. артикула и(или) произв. товара"     .   end.
      115               when 'delete_nu-clob-data':U then do:     assign       p-action-title        = "Удаление неиспользуемой clob-data"     .   end.
      116               when 'delete_nu-layout':U then do:     assign       p-action-title        = "Удаление РАСКЛАДКИ"     .   end.
      117               otherwise do:
      118           return error substitute( "&1. Неизвестный тип операции: &2", vss-include-info0, p-action-code ).
      119         end.
      120       end case.
      121     end.
      122     return.
      123   end procedure.
      124   FUNCTION progs-title-function returns character(
      125      input  p-action-code         as character):
      126   define variable p-action-title      as character no-undo .
      127     do
      128     on error undo, return error
      129     :
      130       case p-action-code :
      131               when 'crush_code-range':U then do:     assign       p-action-title        = "Разбиение диапазона кодов (code-range)"     .   end.
      132               when 'delete_code-range':U then do:     assign       p-action-title        = "Удаление диапазона кодов (code-range)"     .   end.
      133               when 'delete_nu-prt-bar-code':U then do:     assign       p-action-title        = "Удаление неисп. бар-кода признака"     .   end.
      134               when 'delete_nu-part-bar-code':U then do:     assign       p-action-title        = "Удаление неисп. бар-кода партиии"     .   end.
      135               when 'delete_nu-ucli-bar-code':U then do:     assign       p-action-title        = "Удаление неисп.бар-кода на доп ед.изм."     .   end.
      136               when 'delete_nu-dis-card':U then do:     assign       p-action-title        = "Удаление неиспользуемой ДК"     .   end.
      137               when 'chown-dis-card':U then do:     assign       p-action-title        = "Смена владельца ДК"     .   end.
      138               when 'delete_nu-dis-rule':U then do:     assign       p-action-title        = "Удаление правила скидки по фирме и глобального правила скидки"     .   end.
      139               when 'ren-art':U then do:     assign       p-action-title        = "Изм. артикула и(или) произв. товара"     .   end.
      140               when 'delete_nu-clob-data':U then do:     assign       p-action-title        = "Удаление неиспользуемой clob-data"     .   end.
      141               when 'delete_nu-layout':U then do:     assign       p-action-title        = "Удаление РАСКЛАДКИ"     .   end.
      142               otherwise do:
      143           return error substitute( "&1. Неизвестный тип операции: &2", vss-include-info0, p-action-code ).
      144         end.
      145       end case.
      146     end.
      147     return p-action-title.
      148   end FUNCTION.
      149   procedure get-row-keyr-string :
      150    define input  parameter p-key-rec  as character no-undo.
      151    define output parameter p-tbl-title as character no-undo.
      152    define output parameter p-rec-string  as character no-undo.
      153     do
      154     on error undo, return error
      155     :
      156       define variable v-full-tbl-name as character no-undo .
      157       define variable bh_tbl-name     as handle    no-undo .
      158       define variable fh              as handle    no-undo .
      159       define variable v-ok            as logical   no-undo .
      160       define variable v-field-num     as integer   no-undo .
      161       define variable v-count-fld     as integer   no-undo .
      162       define variable v-tbl-name as character no-undo.
      163       if p-key-rec = ?
      164         or p-key-rec = "":U
      165       then do:
      166         return error substitute( "&1 (get-row-keyr-string). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info0 ).
      167       end.
      168       assign
      169         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      170         v-full-tbl-name = "ub.":U + v-tbl-name
      171         v-field-num     = num-entries( p-key-rec, chr(3) ) - 1
      172         p-rec-string         = "":U
      173         v-count-fld     = 0
      174       .
      175       find ub._file
      176         where ub._file._file-name = v-tbl-name
      177         no-error.
      178       if not available ub._file then do:
      179         return error substitute( "&1. Таблица &2 отсутствует в БД", vss-include-info0, v-tbl-name ).
      180       end.
      181       assign
      182       p-tbl-title = ub._file._file-label
      183       .
      184       find ub._index
      185         where recid( ub._index  ) = ub._file._prime-index
      186         no-error.
      187       if not available ub._index
      188         or LC( ub._index._index-name ) = "default":U
      189       then do:
      190         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info0, v-tbl-name ).
      191       end.
      192       block_where :
      193       for each ub._index-field of ub._index  ,
      194           each ub._field of _index-field
      195           break by _index-seq
      196       on error undo, return error
      197       :
      198         assign
      199           v-count-fld = v-count-fld + 1
      200         .
      201         if v-count-fld > v-field-num then do:
      202           leave block_where.
      203         end.
      204         if p-rec-string = "":U then do:
      205           assign
      206             p-rec-string = "":U
      207           .
      208         end.
      209         else do:
      210           assign
      211             p-rec-string = p-rec-string + chr(32) + chr(44)
      212           .
      213         end.
      214         assign
      215           p-rec-string = p-rec-string + (if p-rec-string = "":u then "":U else chr(32)) + substitute( "&1 = &2":U, ub._field._label, entry( v-count-fld + 1 , p-key-rec, chr(3) ) )
      216         .
      217       end.
      218       if v-count-fld <> v-field-num then do:
      219         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info0, v-tbl-name ).
      220       end.
      221     end.
      222     return.
      223   end procedure.
      224   FUNCTION uniq-key-rec-string-f returns character(
      225      input  p-uniq-key-rec         as character):
      226   define variable v-tbl-title as character no-undo .
      227   define variable v-rec-string as character no-undo .
      228     do
      229     on error undo, return error
      230     :
      231       run get-row-keyr-string in this-procedure (
      232                                                 input p-uniq-key-rec
      233                                                 ,output v-tbl-title
      234                                                 ,output v-rec-string).
      235       assign
      236       v-rec-string = (if v-tbl-title <> ? and
      237                       v-tbl-title <> "":U
      238                       then (v-tbl-title + ":")
      239                      else "":U) + chr(32) + v-rec-string
      240       .
      241     end.
      242     return v-rec-string.
      243   end FUNCTION.
      244   procedure create_db-rec_route :
      245     define input parameter p1-uniq-key-rec as character no-undo .
      246     define input parameter p1-action       as character no-undo .
      247     define input parameter p1-operation    as character no-undo .
      248     define input parameter p1-send-db-list as character no-undo .
      249     define input parameter p1-db-init      as integer   no-undo .
      250     define input parameter p1-parameters   as character no-undo .
      251     define input parameter p1-answer-code  as integer   no-undo .
      252     define input parameter p1-answer-msg   as character no-undo .
      253     do
      254     on error undo, return error
      255     :
      256       define variable v-command     as character no-undo .
      257       define variable v-ind         as integer   no-undo .
      258       define variable v-num-entries as integer   no-undo .
      259       define variable v-curr-db     as integer   no-undo .
      260       define variable v-db-for-send as character no-undo .
      261       define variable v-db-num      as integer   no-undo .
      262       define variable v-db-num-char as character no-undo .
      263       define buffer buf_sys-ctrl    for ub.sys-ctrl .
      264       find first buf_sys-ctrl no-lock .
      265       assign
      266         v-curr-db     = buf_sys-ctrl.db-num
      267         v-db-for-send = "":U
      268       .
      269       if v-curr-db = 0 then do:
      270         if p1-answer-code >= 0 then do:
      271           if v-curr-db <> p1-db-init then do:
      272             assign
      273               v-db-for-send = string( p1-db-init )
      274             .
      275           end.
      276         end.
      277         else do:
      278           assign
      279             v-num-entries = num-entries( p1-send-db-list, chr(44) )
      280           .
      281           do v-ind = 1 to v-num-entries:
      282             assign
      283               v-db-num-char = entry( v-ind, p1-send-db-list, chr(44) )
      284               v-db-num      = integer( v-db-num-char )
      285             .
      286             if v-db-num <> v-curr-db
      287               and v-db-num <> p1-db-init
      288             then do:
      289               if v-db-for-send = "":U then do:
      290                 assign
      291                   v-db-for-send = v-db-num-char
      292                 .
      293               end.
      294               else do:
      295                 assign
      296                   v-db-for-send =  v-db-for-send + chr(1) + v-db-num-char
      297                 .
      298               end.
      299             end.
      300           end.
      301         end.
      302       end.
      303       else do:
      304         assign
      305           v-db-for-send = "0":U
      306         .
      307       end.
      308       if v-db-for-send <> "":U then do:
      309         assign
      310           v-command = "command":U + chr(1)
      311                       + "two-commit":U + chr(1)
      312                       + p1-action + chr(1)
      313                       + p1-operation + chr(1)
      314                       + p1-uniq-key-rec + chr(1)
      315                       + string( p1-db-init ) + chr(1)
      316                       + p1-parameters + chr(1)
      317                       + string( p1-answer-code ) + chr(1)
      318                       + p1-answer-msg
      319         .
      320         run nws/cr-route.p ( input 'send-cmd':U
      321                       ,input v-command
      322                       ,input ?
      323                       ,input v-db-for-send
      324                       ) no-error .
      325         if error-status :error then do:
      326           return error return-value.
      327         end.
      328       end.
      329     end.
      330     return.
      331   end procedure.
      332   procedure create_msg_route :
      333     define input parameter p2-send-db-list as character no-undo .
      334     define input parameter p2-msg          as character no-undo .
      335     do
      336     on error undo, return error
      337     :
      338       define variable v-msg-command as character no-undo .
      339       define variable v-ind         as integer   no-undo .
      340       define variable v-num-entries as integer   no-undo .
      341       define variable v-curr-db     as integer   no-undo .
      342       define variable v-db-for-send as character no-undo .
      343       define variable v-db-num      as integer   no-undo .
      344       define variable v-db-num-char as character no-undo .
      345       define buffer buf_sys-ctrl    for ub.sys-ctrl .
      346       find first buf_sys-ctrl no-lock .
      347       assign
      348         v-curr-db     = buf_sys-ctrl.db-num
      349         v-db-for-send = "":U
      350       .
      351       if v-curr-db = 0 then do:
      352         assign
      353           v-num-entries = num-entries( p2-send-db-list, chr(44) )
      354         .
      355         do v-ind = 1 to v-num-entries:
      356           assign
      357             v-db-num-char = entry( v-ind, p2-send-db-list, chr(44) )
      358             v-db-num      = integer( v-db-num-char )
      359           .
      360           if v-db-num <> v-curr-db then do:
      361             if v-db-for-send = "":U then do:
      362               assign
      363                 v-db-for-send = v-db-num-char
      364               .
      365             end.
      366             else do:
      367               assign
      368                 v-db-for-send =  v-db-for-send + chr(1) + v-db-num-char
      369               .
      370             end.
      371           end.
      372         end.
      373       end.
      374       else do:
      375         assign
      376           v-db-for-send = "0":U
      377         .
      378       end.
      379       if v-db-for-send <> "":U then do:
      380         assign
      381           v-msg-command = "command":U + chr(1)
      382                           + "message-to-log":U + chr(1)
      383                           + p2-msg
      384         .
      385         run nws/cr-route.p ( input 'send-cmd':U
      386                       ,input v-msg-command
      387                       ,input ?
      388                       ,input v-db-for-send
      389                       ) no-error .
      390         if error-status :error then do:
      391           return error substitute( "&1&2&3"
      392                                     , return-value
      393                                     , chr(10)
      394                                     , error-status :get-message(1)
      395                                   ).
      396         end.
      397       end.
      398     end.
      399     return.
      400   end procedure.
      401   function get-send-db-list returns character
      402     ( input p-curr-db     as integer
      403      ,input p-all-db-list as character
      404     )
      405   :
      406     define variable v-send-db-list as character no-undo .
      407     if p-curr-db = 0 then do:
      408       assign
      409         v-send-db-list = p-all-db-list
      410       .
      411     end.
      412     else do:
      413       assign
      414         v-send-db-list = string(p-curr-db)
      415       .
      416     end.
      417     return v-send-db-list .
      418   end function .
      419   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      420   define  shared variable g#auto-pid           as integer   no-undo .
      421   define  shared variable conn-par             as character no-undo .
      422   define  shared variable g#auto-user-id       as character no-undo .
      423   define  shared variable g#auto-user-login    as character no-undo .
      424   define  shared variable g#auto-user-password as character no-undo .
      425   define  shared variable v-socket             as logical   no-undo .
      426   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      427   define  shared variable auto-window-h     as handle    no-undo .
      428   define  shared variable auto-log-msg-h    as handle    no-undo .
      429   define  shared variable hand-log-msg-h    as handle    no-undo .
      430   define  shared variable log-file-name     as character no-undo initial ? .
      431   define  shared variable add-log-file-name as character no-undo initial ? .
      432   define  shared variable writelogvalue     as character no-undo initial ? .
      433   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      434   procedure cur-time :
      435      define output parameter p-today as date      no-undo .
      436      define output parameter p-time  as integer   no-undo .
      437     do
      438     on error undo, return error
      439     :
      440       define variable v-date1 as date      no-undo .
      441       define variable v-date2 as date      no-undo .
      442       define variable v-time  as integer   no-undo .
      443       assign
      444         v-date1 = today
      445         v-time  = time
      446         v-date2 = today
      447       .
      448       if v-date1 <> v-date2
      449       then do:
      450         assign
      451           v-date1 = today
      452           v-time  = v-time
      453         .
      454       end.
      455       assign
      456         p-today = v-date1
      457         p-time  = v-time
      458       .
      459     end.
      460   end.
      461   function cur-time-date returns character
      462   :
      463     return string(today, '99/99/9999':U) .
      464   end.
      465   function cur-time-mjd returns decimal
      466   :
      467     define variable v-date as date      no-undo .
      468     define variable v-time as integer   no-undo .
      469     run cur-time in this-procedure
      470       (output v-date
      471       ,output v-time
      472       ) .
      473     return integer(v-date) - 2400002 + (v-time / 86400) .
      474   end.
      475   function cur-time-get-ending-index returns integer
      476   (input p-number as integer
      477   )
      478   :
      479     if p-number < 0
      480     or p-number = ?
      481     then do:
      482       return 1 .
      483     end.
      484     define variable v-rest as integer   no-undo .
      485     assign
      486       p-number = p-number modulo 100
      487     .
      488     if p-number < 20
      489     then do:
      490       assign
      491         v-rest = p-number
      492       .
      493     end.
      494     else do:
      495       assign
      496         v-rest = p-number modulo 10
      497       .
      498     end.
      499     case v-rest :
      500       when 1
      501       then do:
      502         return 2 .
      503       end.
      504       when 2 or
      505       when 3 or
      506       when 4
      507       then do:
      508         return 3 .
      509       end.
      510       otherwise do:
      511         return 1 .
      512       end.
      513     end case .
      514   end.
      515   procedure cur-time-mjd-to-date :
      516      define input  parameter i-mjd-diff as decimal no-undo.
      517      define output parameter o-Date     as date    no-undo.
      518      define output parameter o-Time     as integer no-undo.
      519      define variable v-day-number as integer   no-undo .
      520      if    i-mjd-diff < 0
      521         or i-mjd-diff = ?
      522      then do:
      523         return "?" .
      524      end.
      525      assign
      526         v-day-number = truncate(i-mjd-diff,0).
      527         o-Date = date(v-day-number + 2400002).
      528         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      529     .
      530   end.
      531   function cur-time-mjd-to-string returns character
      532   (input p-mjd-diff as decimal
      533   )
      534   :
      535     define variable v-day-number as integer   no-undo .
      536     define variable v-seconds    as integer   no-undo .
      537     define variable v-hour       as integer   no-undo .
      538     define variable v-min        as integer   no-undo .
      539     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      540     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      541     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      542     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      543     if p-mjd-diff < 0
      544     or p-mjd-diff = ?
      545     then do:
      546       return "?" .
      547     end.
      548     assign
      549       v-day-number = integer(truncate(p-mjd-diff,0))
      550       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      551     .
      552     if v-seconds > 86400
      553     then do:
      554       assign
      555         v-seconds = 86400 - 1
      556       .
      557     end.
      558     if v-seconds < 0
      559     then do:
      560       assign
      561         v-seconds = 0
      562       .
      563     end.
      564     assign
      565       v-hour = truncate(v-seconds / 3600, 0)
      566     .
      567     assign
      568       v-seconds = v-seconds modulo 3600
      569     .
      570     assign
      571       v-min = truncate(v-seconds / 60, 0)
      572     .
      573     assign
      574       v-seconds = v-seconds modulo 60
      575     .
      576     return
      577         (if v-day-number <> 0
      578           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      579           else ""
      580         )
      581       + (if v-day-number <> 0 or v-hour <> 0
      582           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      583           else ""
      584         )
      585       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      586           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      587           else ""
      588         )
      589       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      590       .
      591   end.
      592   function cur-time-string returns character
      593   :
      594     define variable v-date as date      no-undo .
      595     define variable v-time as integer   no-undo .
      596     run cur-time in this-procedure
      597       (output v-date
      598       ,output v-time
      599       ) .
      600     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      601   end.
      602   function cur-time-string-sec returns character
      603   :
      604     define variable v-date as date      no-undo .
      605     define variable v-time as integer   no-undo .
      606     run cur-time in this-procedure
      607       (output v-date
      608       ,output v-time
      609       ) .
      610     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      611   end.
      612   function cur-time-custom  returns character
      613   (input p-prefix as character
      614   ,input p-date-format as character
      615   ,input p-delimiter as character
      616   ,input p-time-format as character
      617   ,input p-suffix as character
      618   )
      619   :
      620     define variable v-date as date      no-undo .
      621     define variable v-time as integer   no-undo .
      622     run cur-time in this-procedure
      623       (output v-date
      624       ,output v-time
      625       ) .
      626     return
      627       p-prefix
      628       + string(v-date, p-date-format)
      629       + p-delimiter
      630       + string(v-time, p-time-format)
      631       + p-suffix
      632       .
      633   end.
      634   function cur-time-print  returns character
      635   :
      636     define variable v-date as date      no-undo .
      637     define variable v-time as integer   no-undo .
      638     run cur-time in this-procedure
      639       (output v-date
      640       ,output v-time
      641       ) .
      642     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      643   end.
      644   function cur-time-datetime returns datetime
      645   :
      646     define variable v-char as character no-undo .
      647     define variable v-datetime as datetime no-undo .
      648     v-char = cur-time-string().
      649     v-datetime = datetime(v-char).
      650     return  v-datetime.
      651   end.
      652   function cur-time-string-msec returns character
      653   :
      654     define variable v-date as datetime  no-undo .
      655     v-date = now.
      656     return string(v-date) .
      657   end.
      658   define stream LogStream .
      659   define variable mNoTime as logical no-undo.
      660   procedure write-to-log-notime :
      661     define input param i-str as character no-undo .
      662     mNoTime = yes.
      663     run write-to-log (i-str).
      664     mNoTime = no.
      665   end.
      666   procedure write-to-log :
      667     define input param p-str as character no-undo .
      668     do
      669     on error  undo, return error substitute( "&1 (write-to-log). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      670     on stop   undo, return error substitute( "&1 (write-to-log). stop", vss-workfile )
      671     on endkey undo, return error substitute( "&1 (write-to-log). endkey", vss-workfile )
      672     :
      673       define variable log-res        as logical   no-undo .
      674       define variable v-jj           as integer   no-undo .
      675       if    mNoTime
      676          or writelogvalue eq "AsyncProc"
      677       then
      678          p-str = substitute( "&1 (pid: &2) &3&4"   , g#auto-user-id, g#auto-pid,                        p-str, chr(10) ).
      679       else
      680          p-str = substitute( "&1 (pid: &2) &3 &4&5", g#auto-user-id, g#auto-pid, cur-time-string-sec(), p-str, chr(10) ).
      681       if auto-log-msg-h <> ? then do:
      682         log-res = auto-log-msg-h:move-to-eof( ) .
      683         log-res = auto-log-msg-h:insert-string( p-str ).
      684       end.
      685       if hand-log-msg-h <> ? then do:
      686         log-res = hand-log-msg-h:move-to-eof( ) .
      687         log-res = hand-log-msg-h:insert-string( p-str ).
      688       end.
      689       assign
      690         p-str = replace(p-str, (chr(10) + chr(13)), chr(10) )
      691         p-str = replace(p-str, (chr(13) + chr(10)), chr(10) )
      692         p-str = replace(p-str, chr(10), (chr(13) + chr(10)) )
      693       .
      694       if add-log-file-name <> ? then do:
      695         do v-jj = 1 to num-entries(add-log-file-name, chr(1)):
      696           run gbl/fileapnd.p
      697             ( input entry(v-jj, add-log-file-name, chr(1) )
      698             ,input p-str
      699             ,input 20
      700             ) no-error .
      701           if error-status:error then do:
      702             return error return-value .
      703           end.
      704         end.
      705       end.
      706       if writelogvalue eq "AsyncProc"
      707       then do:
      708          p-str = trim(p-str, (chr(13) + chr(10)) )
      709       .
      710          Publish "WriteLogAsunc" (p-str,yes).
      711       end.
      712       else if writelogvalue <> "yes" then do:
      713         run gbl/fileapnd.p
      714           ( input log-file-name
      715           ,input p-str
      716           ,input 20
      717           ) no-error .
      718         if error-status:error then do:
      719           return error return-value .
      720         end.
      721       end.
      722     end.
      723   end procedure.
      724   procedure write-to-screen :
      725     define input param p-str as character no-undo .
      726     do
      727     on error  undo, return error substitute( "&1 (write-to-screen). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      728     on stop   undo, return error substitute( "&1 (write-to-screen). stop", vss-workfile )
      729     on endkey undo, return error substitute( "&1 (write-to-screen). endkey", vss-workfile )
      730     :
      731       define variable log-res as logical no-undo.
      732       assign
      733         p-str = substitute( "&1 (pid: &2) &3 &4&5", g#auto-user-id, g#auto-pid, cur-time-string-sec(), p-str, chr(10) )
      734       .
      735       if auto-log-msg-h <> ?
      736       then do:
      737         log-res = auto-log-msg-h:move-to-eof( ) .
      738         log-res = auto-log-msg-h:insert-string( p-str ).
      739       end.
      740       if hand-log-msg-h <> ?
      741       then do:
      742         log-res = hand-log-msg-h:move-to-eof( ) .
      743         log-res = hand-log-msg-h:insert-string( p-str ).
      744       end.
      745     end.
      746   end procedure.
      747   procedure send-msg-to-email :
      748     define input  parameter p-subject      as character no-undo .
      749     define input  parameter p-text-err     as character no-undo .
      750     define input  parameter p-attach-files as character no-undo .
      751     do
      752     on error  undo, return error substitute( "&1 (send-msg-to-email). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      753     on stop   undo, return error substitute( "&1 (send-msg-to-email). stop", vss-workfile )
      754     on endkey undo, return error substitute( "&1 (send-msg-to-email). endkey", vss-workfile )
      755     :
      756       define variable v-tth             as handle    no-undo .
      757       define variable v-value-character as character no-undo .
      758       define variable v-value-date      as date      no-undo .
      759       define variable v-value-decimal   as decimal   no-undo .
      760       define variable v-value-integer   as integer   no-undo .
      761       define variable v-value-logical   as logical   no-undo .
      762       define variable v-param-type      as character no-undo .
      763       define variable v-email       as character no-undo .
      764       define variable v-tmp-str     as character no-undo .
      765       define variable v-tmp1-str    as character no-undo .
      766       define variable v-ind         as integer   no-undo .
      767       define variable v-num-entries as integer   no-undo .
      768       delete object v-tth no-error.
      769       run adm/shattri.p
      770         ( input "get":U
      771          ,input  "":U
      772          ,input  0
      773          ,input  'auto-task':U
      774          ,input  'send-msg-to-email':U
      775          ,output v-value-character
      776          ,output v-value-date
      777          ,output v-value-decimal
      778          ,output v-value-integer
      779          ,output v-value-logical
      780          ,output v-param-type
      781          ,input-output table-handle v-tth
      782         ) no-error .
      783       if not error-status :error  then do:
      784         assign
      785           v-tmp-str = v-value-character
      786         .
      787       end.
      788       delete object v-tth no-error.
      789       assign
      790         v-tmp-str     = replace(v-tmp-str, (chr(10) + chr(13)), chr(44) )
      791         v-tmp-str     = replace(v-tmp-str, (chr(13) + chr(10)), chr(44) )
      792         v-tmp-str     = replace(v-tmp-str, chr(10), chr(44) )
      793         v-num-entries = num-entries( v-tmp-str, chr(44) )
      794         v-email       = "":U
      795       .
      796       do v-ind = 1 to v-num-entries
      797       :
      798         assign
      799           v-tmp1-str = entry( v-ind, v-tmp-str, chr(44) )
      800         .
      801         if trim( v-tmp1-str ) <> "":U then do:
      802           if v-email = "":U then do:
      803             assign
      804               v-email = v-tmp1-str
      805             .
      806           end.
      807           else do:
      808             assign
      809               v-email = v-email + chr(44) + v-tmp1-str
      810             .
      811           end.
      812         end.
      813       end.
      814       if v-email <> "":U then do:
      815         run gbl/sendmail.p
      816           ( input v-email
      817           , input p-subject
      818           , input p-text-err
      819           , input p-attach-files
      820           ) no-error .
      821         if error-status :error
      822           or return-value <> "":U
      823         then do:
      824           return error substitute( "&1 (send-msg-to-email). &2", vss-workfile, return-value ) .
      825         end.
      826       end.
      827     end.
      828   end procedure.
      829   do
      830   on error undo, return error
      831   :
      832     define variable v-action            as character no-undo .
      833     define variable v-operation         as character no-undo .
      834     define variable v-uniq-key-rec      as character no-undo .
      835     define variable v-curr-db           as integer   no-undo .
      836     define variable v-db-init           as integer   no-undo .
      837     define variable v-parameters        as character no-undo .
      838     define variable v-answer-code       as integer   no-undo .
      839     define variable v-answer-msg        as character no-undo .
      840     define variable v-send-db-list      as character no-undo .
      841     define variable v-all-db-list       as character no-undo .
      842     define variable v-need-send-inquiry as logical   no-undo .
      843     define variable v-send-news         as logical   no-undo .
      844     define variable v-global-recover    as logical   no-undo .
      845     define variable v-main-prog-name      as character no-undo .
      846     define variable v-list-db-proc-name   as character no-undo .
      847     define variable v-commit-proc-name    as character no-undo .
      848     define variable v-execution-proc-name as character no-undo .
      849     define variable v-recover-proc-name   as character no-undo .
      850     define variable v-after-proc-name     as character no-undo .
      851     define variable v-db-num       as integer   no-undo .
      852     define variable v-ind          as integer   no-undo .
      853     define variable v-num-entries  as integer   no-undo .
      854     define variable v-change-oper  as logical   no-undo .
      855     define variable v-new-oper     as character no-undo .
      856     define variable v-after-command as character no-undo .
      857     define variable v-message       as character no-undo .
      858     define variable v-err-stts      as character no-undo .
      859     define buffer buf_sys-ctrl        for ub.sys-ctrl .
      860     define buffer buf_db              for ub.db .
      861     define buffer buf_db-rec-attr     for ub.db-rec-attr .
      862     define buffer buf-all_db-rec-attr for ub.db-rec-attr .
      863     find first buf_sys-ctrl no-lock .
      864     assign
      865       v-curr-db      = buf_sys-ctrl.db-num
      866       v-action       = entry(3, p-full-command, chr(1))
      867       v-operation    = entry(4, p-full-command, chr(1))
      868       v-uniq-key-rec = entry(5, p-full-command, chr(1))
      869       v-db-init      = integer( entry(6, p-full-command, chr(1)) )
      870       v-parameters   = entry(7, p-full-command, chr(1))
      871       v-answer-code  = integer( entry(8, p-full-command, chr(1)) )
      872       v-answer-msg   = entry(9, p-full-command, chr(1))
      873     .
      874     run progs-name( input v-action
      875                    ,output v-main-prog-name
      876                    ,output v-list-db-proc-name
      877                    ,output v-commit-proc-name
      878                    ,output v-execution-proc-name
      879                    ,output v-recover-proc-name
      880                    ,output v-after-proc-name
      881                   ) no-error .
      882     if error-status :error then do:
      883       return error substitute( "&1. Ошибка при определении имен процедур. &2", vss-workfile, return-value ).
      884     end.
      885     run value( v-list-db-proc-name )
      886       ( input v-action
      887        ,input v-uniq-key-rec
      888        ,output v-all-db-list
      889       ) no-error .
      890     if error-status :error then do:
      891       return error substitute( "&1. Ошибка при определении списка БД. &2", vss-workfile, return-value ).
      892     end.
      893     assign
      894       v-send-db-list = get-send-db-list( v-curr-db, v-all-db-list )
      895     .
      896     assign
      897       v-global-recover = TRUE
      898     .
      899     if v-answer-code >= 0
      900       and ( v-curr-db = 0
      901             or v-curr-db = v-db-init
      902           )
      903     then do:
      904       find first buf_db-rec-attr exclusive-lock
      905         where buf_db-rec-attr.db-num             = p-source-db
      906           and buf_db-rec-attr.uniq-key-rec       = v-uniq-key-rec
      907           and buf_db-rec-attr.attr-code          = v-action
      908           and buf_db-rec-attr.attr-value-decimal = v-db-init
      909       no-error.
      910       if not avail buf_db-rec-attr then
      911       do:
      912         run write-to-log( substitute( 'Для БД &1 не найдена запись об операции "&2(&3)" над записью &4'
      913                                       ,p-source-db
      914                                       ,v-action
      915                                       ,v-operation
      916                                       ,v-uniq-key-rec
      917                                     )
      918                         ).
      919         return.
      920       end.
      921       if v-answer-code = 0 then do:
      922         run write-to-log( substitute( 'Получен ответ из БД &1 об успешном выполнении шага "&2" операции "&3" над записью &4'
      923                                       ,p-source-db
      924                                       ,v-operation
      925                                       ,v-action
      926                                       ,v-uniq-key-rec
      927                                     )
      928                         ).
      929         if buf_db-rec-attr.attr-type = v-operation then do:
      930           assign
      931             buf_db-rec-attr.attr-value-logical = TRUE
      932             v-change-oper = TRUE
      933           .
      934           assign
      935             v-num-entries = num-entries( v-send-db-list, chr(44) )
      936           .
      937           ALL_DB_REC:
      938           do v-ind = 1 to v-num-entries
      939           on error undo, return error
      940           :
      941             assign
      942               v-db-num = integer( entry( v-ind, v-send-db-list, chr(44) ) )
      943             .
      944             if v-curr-db = 0 then do:
      945               if v-db-num = v-db-init
      946                 and v-db-num <> 0
      947               then do:
      948                 next.
      949               end.
      950               find first buf_db no-lock
      951                 where buf_db.db-num = v-db-num
      952                 no-error
      953               .
      954               if not available buf_db
      955                 or buf_db.db-key = "":U
      956               then do:
      957                 next.
      958               end.
      959             end.
      960             find first buf-all_db-rec-attr no-lock
      961               where buf-all_db-rec-attr.db-num             = v-db-num
      962                 and buf-all_db-rec-attr.uniq-key-rec       = v-uniq-key-rec
      963                 and buf-all_db-rec-attr.attr-code          = v-action
      964                 and buf-all_db-rec-attr.attr-value-decimal = v-db-init
      965               no-error
      966             .
      967             if not available buf-all_db-rec-attr then do:
      968                next ALL_DB_REC.
      969             end.
      970             if buf-all_db-rec-attr.attr-type <> v-operation
      971               or ( buf-all_db-rec-attr.attr-type = v-operation
      972                   and buf-all_db-rec-attr.attr-value-logical = FALSE
      973                 )
      974             then do:
      975               assign
      976                 v-change-oper = FALSE
      977               .
      978             end.
      979           end.
      980           if v-change-oper = TRUE then do:
      981             if buf_db-rec-attr.attr-type = "commit":U then do:
      982               assign
      983                 v-new-oper = "execution":U
      984               .
      985             end.
      986             else do:
      987               assign
      988                 v-new-oper = "":U
      989               .
      990             end.
      991           end.
      992         end.
      993         else do:
      994           run write-to-log( substitute( 'Для БД &1 уже начато выполнение шага "&2" операции "&3" над записью &4'
      995                                         ,p-source-db
      996                                         ,buf_db-rec-attr.attr-type
      997                                         ,v-action
      998                                         ,v-uniq-key-rec
      999                                       )
     1000                           ).
     1001           assign
     1002             v-change-oper = FALSE
     1003           .
     1004         end.
     1005       end.
     1006       else do:
     1007         assign
     1008           v-message = substitute( 'БД &1, шаг "&2", оп. "&3", запись &4.&5Ошибка: &6.&5Операция откатывается.'
     1009                                   ,p-source-db
     1010                                   ,v-operation
     1011                                   ,v-action
     1012                                   ,v-uniq-key-rec
     1013                                   ,chr(10)
     1014                                   ,v-answer-msg
     1015                                 )
     1016         .
     1017         run write-to-log( v-message ).
     1018         run create_msg_route in this-procedure
     1019           ( input v-send-db-list
     1020            ,input v-message
     1021           ) no-error .
     1022         if error-status :error then do:
     1023           return error substitute( "&1. Ошибка при отправке сообщения по СПН. &2", vss-workfile, return-value ).
     1024         end.
     1025         if buf_db-rec-attr.attr-type = v-operation then do:
     1026           if v-curr-db <> 0
     1027             and v-curr-db = v-db-init
     1028             and v-answer-code = 10
     1029           then do:
     1030             assign
     1031               v-global-recover = FALSE
     1032             .
     1033           end.
     1034           else do:
     1035             assign
     1036               v-global-recover = TRUE
     1037               v-answer-code    = 1
     1038             .
     1039           end.
     1040           assign
     1041             v-change-oper = TRUE
     1042             v-new-oper = "recover":U
     1043           .
     1044         end.
     1045         else do:
     1046           assign
     1047             v-change-oper = FALSE
     1048           .
     1049         end.
     1050       end.
     1051       if v-change-oper = TRUE then do:
     1052         if v-new-oper = "":U then do:
     1053           for each buf_db-rec-attr
     1054             where buf_db-rec-attr.uniq-key-rec       = v-uniq-key-rec
     1055               and buf_db-rec-attr.attr-code          = v-action
     1056               and buf_db-rec-attr.attr-value-decimal = v-db-init
     1057           on error undo, return error
     1058           :
     1059             delete buf_db-rec-attr.
     1060           end.
     1061           if v-operation = "execution":U then do:
     1062             assign
     1063               v-message = substitute( 'Операция "&1" над записью &2 успешно завершена.'
     1064                                       ,v-action
     1065                                       ,v-uniq-key-rec
     1066                                     )
     1067             .
     1068             run write-to-log( v-message ).
     1069             run create_msg_route in this-procedure
     1070               ( input v-send-db-list
     1071               ,input v-message
     1072               ) no-error .
     1073             if error-status :error then do:
     1074               return error substitute( "&1. Ошибка при отправке сообщения по СПН. &2", vss-workfile, return-value ).
     1075             end.
     1076           end.
     1077           else do:
     1078             assign
     1079               v-message = substitute( 'Откат операции "&1" над записью &2 завершен.'
     1080                                       ,v-action
     1081                                       ,v-uniq-key-rec
     1082                                     )
     1083             .
     1084             run write-to-log( v-message ).
     1085             run create_msg_route in this-procedure
     1086               ( input v-send-db-list
     1087               ,input v-message
     1088               ) no-error .
     1089             if error-status :error then do:
     1090               return error substitute( "&1. Ошибка при отправке сообщения по СПН. &2", vss-workfile, return-value ).
     1091             end.
     1092           end.
     1093           if v-curr-db = v-db-init then do:
     1094             assign
     1095               v-after-command = "command":U + chr(1)
     1096                                 + "after-two-commit":U + chr(1)
     1097                                 + v-action + chr(1)
     1098                                 + v-uniq-key-rec + chr(1)
     1099                                 + string( v-db-init ) + chr(1)
     1100                                 + v-parameters
     1101             .
     1102             run nws/dbrecaft.p
     1103               ( input ?
     1104                ,input v-after-command
     1105               ) no-error .
     1106             if error-status :error then do:
     1107               return error substitute( "&1. Ошибка при выполнении команды (after) по СПН. &2", vss-workfile, return-value ).
     1108             end.
     1109           end.
     1110         end.
     1111         if v-curr-db = v-db-init then do:
     1112           if v-new-oper <> "":U then do:
     1113             if v-new-oper = "recover":U
     1114               and v-global-recover = FALSE
     1115             then do:
     1116               for each buf_db-rec-attr
     1117                 where buf_db-rec-attr.uniq-key-rec       = v-uniq-key-rec
     1118                   and buf_db-rec-attr.attr-code          = v-action
     1119                   and buf_db-rec-attr.attr-value-decimal = v-db-init
     1120               on error undo, return error
     1121               :
     1122                 if buf_db-rec-attr.db-num = v-curr-db then do:
     1123                   assign
     1124                     buf_db-rec-attr.attr-type          = v-new-oper
     1125                     buf_db-rec-attr.attr-value-logical = FALSE
     1126                   .
     1127                 end.
     1128                 else do:
     1129                   delete buf_db-rec-attr .
     1130                 end.
     1131               end.
     1132             end.
     1133             else do:
     1134               for each buf_db-rec-attr
     1135                 where buf_db-rec-attr.uniq-key-rec       = v-uniq-key-rec
     1136                   and buf_db-rec-attr.attr-code          = v-action
     1137                   and buf_db-rec-attr.attr-value-decimal = v-db-init
     1138               on error undo, return error
     1139               :
     1140                 assign
     1141                   buf_db-rec-attr.attr-type          = v-new-oper
     1142                   buf_db-rec-attr.attr-value-logical = FALSE
     1143                 .
     1144               end.
     1145             end.
     1146             assign
     1147               v-operation   = v-new-oper
     1148               v-answer-code = -1
     1149               v-answer-msg  = "":U
     1150             .
     1151           end.
     1152         end.
     1153         else do:
     1154         end.
     1155       end.
     1156     end.
     1157     if v-answer-code < 0 then do:
     1158       if lookup( string( v-curr-db ), v-send-db-list, chr(44) ) <> 0 then do:
     1159         find first buf_db-rec-attr
     1160           where buf_db-rec-attr.db-num       = v-curr-db
     1161             and buf_db-rec-attr.uniq-key-rec = v-uniq-key-rec
     1162             and buf_db-rec-attr.attr-code    = v-action
     1163           no-error.
     1164         if available buf_db-rec-attr
     1165           and buf_db-rec-attr.attr-value-decimal <> v-db-init
     1166         then do:
     1167           assign
     1168             v-answer-msg = substitute( "Операцию &1 над записью &2 уже производит БД &3"
     1169                                        , v-action, v-uniq-key-rec, buf_db-rec-attr.attr-value-decimal
     1170                                      )
     1171             v-answer-code = 10
     1172           .
     1173         end.
     1174         else do:
     1175           if available buf_db-rec-attr
     1176             and buf_db-rec-attr.attr-type = v-operation
     1177             and buf_db-rec-attr.attr-value-logical = TRUE
     1178           then do:
     1179             assign
     1180               v-answer-msg = "":U
     1181             .
     1182           end.
     1183           else do:
     1184             assign
     1185               v-message = substitute( 'Начинается выполнение шага "&1" операции "&2" над записью &3'
     1186                                       ,v-operation
     1187                                       ,v-action
     1188                                       ,v-uniq-key-rec
     1189                                      )
     1190             .
     1191             run write-to-log( v-message ).
     1192             if not available buf_db-rec-attr then do:
     1193               create buf_db-rec-attr.
     1194               assign
     1195                 buf_db-rec-attr.db-num             = v-curr-db
     1196                 buf_db-rec-attr.uniq-key-rec       = v-uniq-key-rec
     1197                 buf_db-rec-attr.attr-code          = v-action
     1198               .
     1199             end.
     1200             assign
     1201               buf_db-rec-attr.attr-type          = v-operation
     1202               buf_db-rec-attr.attr-value         = v-parameters
     1203               buf_db-rec-attr.attr-value-decimal = v-db-init
     1204               buf_db-rec-attr.attr-value-date    = TODAY
     1205               buf_db-rec-attr.attr-value-logical = FALSE
     1206               v-err-stts = "":U
     1207             .
     1208             run nws/db-rec.p
     1209               ( input substitute( "&1&2not-begin":U, v-action, chr(1) )
     1210                ,input v-uniq-key-rec
     1211                ,input v-parameters
     1212               ) no-error .
     1213             if error-status :error then do:
     1214               assign
     1215                 v-err-stts = return-value
     1216               .
     1217             end.
     1218             assign
     1219               v-message = substitute( 'Завершилось выполнение шага "&1" операции "&2" над записью &3'
     1220                                       ,v-operation
     1221                                       ,v-action
     1222                                       ,v-uniq-key-rec
     1223                                     )
     1224             .
     1225             run write-to-log( v-message ).
     1226             if v-err-stts <> "":U then do:
     1227               return error v-err-stts.
     1228             end.
     1229             assign
     1230               v-answer-msg = return-value
     1231             .
     1232             if v-answer-msg = "":U
     1233               and ( v-operation = "execution":U
     1234                     or v-operation = "recover":U
     1235                   )
     1236               and v-curr-db <> 0
     1237               and ( v-curr-db <> v-db-init
     1238                     or
     1239                     ( v-operation = "recover":U and v-global-recover = FALSE )
     1240                   )
     1241             then do:
     1242               for each buf_db-rec-attr
     1243                 where buf_db-rec-attr.uniq-key-rec = v-uniq-key-rec
     1244                   and buf_db-rec-attr.attr-code    = v-action
     1245               on error undo, return error
     1246               :
     1247                 delete buf_db-rec-attr.
     1248               end.
     1249             end.
     1250           end.
     1251         end.
     1252       end.
     1253       assign
     1254         v-send-news = TRUE
     1255       .
     1256       if v-curr-db = v-db-init then do:
     1257         if v-operation = "recover":U
     1258           and v-global-recover = FALSE
     1259         then do:
     1260           assign
     1261             v-need-send-inquiry = FALSE
     1262             v-send-news         = FALSE
     1263           .
     1264         end.
     1265         else do:
     1266           assign
     1267             v-need-send-inquiry = TRUE
     1268           .
     1269         end.
     1270       end.
     1271       else do:
     1272         assign
     1273           v-need-send-inquiry = FALSE
     1274         .
     1275         if v-curr-db = 0 then do:
     1276           assign
     1277             v-num-entries = num-entries( v-send-db-list, chr(44) )
     1278           .
     1279           do v-ind = 1 to v-num-entries
     1280           :
     1281             assign
     1282               v-db-num = integer( entry( v-ind, v-send-db-list, chr(44) ) )
     1283             .
     1284             if v-db-num = 0
     1285               or v-db-num = v-db-init
     1286             then do:
     1287               next.
     1288             end.
     1289             assign
     1290               v-need-send-inquiry = TRUE
     1291             .
     1292           end.
     1293         end.
     1294       end.
     1295       if v-send-news = TRUE then do:
     1296         if v-answer-msg = "":U
     1297           and v-need-send-inquiry = TRUE
     1298         then do:
     1299           assign
     1300             v-answer-code = -1
     1301           .
     1302           if v-curr-db = 0
     1303           then do:
     1304             assign
     1305               v-num-entries = num-entries( v-send-db-list, chr(44) )
     1306             .
     1307             do v-ind = 1 to v-num-entries
     1308             :
     1309               assign
     1310                 v-db-num = integer( entry( v-ind, v-send-db-list, chr(44) ) )
     1311               .
     1312               if v-db-num = 0
     1313               then do:
     1314                 next.
     1315               end.
     1316               find first buf_db-rec-attr
     1317                 where buf_db-rec-attr.db-num       = v-db-num
     1318                   and buf_db-rec-attr.uniq-key-rec = v-uniq-key-rec
     1319                   and buf_db-rec-attr.attr-code    = v-action
     1320                 no-error.
     1321               if not available buf_db-rec-attr then do:
     1322                 create buf_db-rec-attr.
     1323                 assign
     1324                   buf_db-rec-attr.db-num             = v-db-num
     1325                   buf_db-rec-attr.uniq-key-rec       = v-uniq-key-rec
     1326                   buf_db-rec-attr.attr-code          = v-action
     1327                 .
     1328               end.
     1329               assign
     1330                 buf_db-rec-attr.attr-type          = v-operation
     1331                 buf_db-rec-attr.attr-value         = v-parameters
     1332                 buf_db-rec-attr.attr-value-decimal = v-db-init
     1333                 buf_db-rec-attr.attr-value-date    = TODAY
     1334                 buf_db-rec-attr.attr-value-logical = FALSE
     1335               .
     1336             end.
     1337           end.
     1338         end.
     1339         else do:
     1340           if v-answer-msg = "":U then do:
     1341             assign
     1342               v-answer-code = 0
     1343             .
     1344           end.
     1345           else do:
     1346             if v-answer-code <> 10 then do:
     1347               assign
     1348                 v-answer-code = 1
     1349               .
     1350             end.
     1351           end.
     1352         end.
     1353         run create_db-rec_route in this-procedure
     1354           ( input v-uniq-key-rec
     1355           ,input v-action
     1356           ,input v-operation
     1357           ,input v-send-db-list
     1358           ,input v-db-init
     1359           ,input v-parameters
     1360           ,input v-answer-code
     1361           ,input v-answer-msg
     1362           ) no-error .
     1363         if error-status :error then do:
     1364           return error substitute( "&1. Ошибка при отправке команды по СПН. &2", vss-workfile, return-value ).
     1365         end.
     1366       end.
     1367     end.
     1368     return.
     1369   end.
