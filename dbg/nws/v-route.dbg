     2561         then do:
     2562           assign
     2563             frame v-route :virtual-width = frame v-route :virtual-width + p-change-value
     2564           no-error .
     2565           if error-status :error
     2566           or error-status :get-message(1) <> ""
     2567           then do:
     2568             undo move_block, retry move_block.
     2569           end.
     2570         end.
     2571       end.
     2572       if p-move-resize
     2573       then do:
     2574         run diasize_position-resize-button in this-procedure .
     2575       end.
     2576       if v-diasize-wndstore = true
     2577       then do:
     2578         if connected("ub") = true
     2579         then do:
     2580           define variable v-cntxt-db-num        as integer   no-undo .
     2581           define variable v-cntxt-userid        as character no-undo .
     2582           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2583                                             , OUTPUT v-cntxt-userid
     2584                                             ) .
     2585           run gbl/wndsizew.p
     2586             (input  v-cntxt-db-num
     2587             ,input  v-cntxt-userid
     2588             ,input  v-diasize-proc-name
     2589             ,input  'width':u
     2590             ,input  string(frame v-route :width - v-diasize-orig-frame-width)
     2591             ) .
     2592         end.
     2593       end.
     2594     end.
     2595     assign
     2596       v-diasize-change-size = false
     2597     .
     2598   end procedure.
     2599   procedure diasize_set-width :
     2600     define input  parameter p-new-width  as decimal   no-undo .
     2601     define input  parameter p-move-resize as logical   no-undo .
     2602     do
     2603     on error undo, return error return-value
     2604     :
     2605       run diasize_change-width in this-procedure
     2606         (input  (p-new-width - frame v-route :width)
     2607         ,input  p-move-resize
     2608         ) .
     2609     end.
     2610   end procedure.
     2611   procedure diasize_position-resize-button :
     2612     do with frame v-route
     2613     :
     2614       hide v-diasize-resize-button .
     2615       assign
     2616         v-diasize-resize-button :row = frame v-route :height - v-diasize-resize-button :height
     2617                     - 1
     2618                     - (frame v-route :border-bottom-pixels / session :pixels-per-row)
     2619         v-diasize-resize-button :col = frame v-route :width - v-diasize-resize-button :width
     2620                     - 1
     2621                     - (frame v-route :border-right-pixels / session :pixels-per-column)
     2622       .
     2623       view v-diasize-resize-button .
     2624     end.
     2625   end procedure.
     2626   on alt-right anywhere
     2627   do:
     2628     run diasize_change-width in this-procedure
     2629       (input 1
     2630       ,input true
     2631       ) .
     2632     return no-apply .
     2633   end.
     2634   on alt-left anywhere
     2635   do:
     2636     run diasize_change-width in this-procedure
     2637       (input -1
     2638       ,input true
     2639       ) .
     2640     return no-apply .
     2641   end.
     2642   on alt-down anywhere
     2643   do:
     2644     run diasize_change-height in this-procedure
     2645       (input 1
     2646       ,input true
     2647       ) .
     2648     return no-apply .
     2649   end.
     2650   on alt-up anywhere
     2651   do:
     2652     run diasize_change-height in this-procedure
     2653       (input -1
     2654       ,input true
     2655       ) .
     2656     return no-apply .
     2657   end.
     2658   on alt-enter of frame v-route
     2659   do:
     2660     run diasize_maximize in this-procedure
     2661       (input  ?
     2662       ).
     2663     return no-apply .
     2664   end.
     2665   procedure diasize_end-move :
     2666     do
     2667     on error undo, return error return-value
     2668     :
     2669       define variable v-row-delta as decimal   no-undo .
     2670       define variable v-col-delta as decimal   no-undo .
     2671       define variable v-new-row as decimal   no-undo .
     2672       define variable v-new-col as decimal   no-undo .
     2673       assign
     2674         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2675         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2676       .
     2677       assign
     2678         v-row-delta = v-new-row - frame v-route :height
     2679         v-col-delta = v-new-col - frame v-route :width
     2680       .
     2681       run diasize_change-height in this-procedure
     2682         (input v-row-delta
     2683         ,input true
     2684         ) .
     2685       run diasize_change-width in this-procedure
     2686         (input v-col-delta
     2687         ,input true
     2688         ) .
     2689     end.
     2690   end procedure.
     2691   procedure diasize_maximize :
     2692     define input  parameter p-action as logical   no-undo .
     2693     do
     2694     on error undo, return error return-value
     2695     :
     2696       if p-action = ?
     2697       then do:
     2698         if v-diasize-need-maximize = true
     2699         then do:
     2700           assign
     2701             p-action = true
     2702           .
     2703         end.
     2704         else do:
     2705           assign
     2706             p-action = false
     2707           .
     2708         end.
     2709       end.
     2710       if p-action = true
     2711       then do:
     2712         run diasize_change-height in this-procedure
     2713           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2714               - frame v-route :height-chars
     2715           ,input true
     2716           ) .
     2717         run diasize_change-width in this-procedure
     2718           (input session :width-chars
     2719               - frame v-route :width-chars
     2720           ,input true
     2721           ) .
     2722         assign
     2723           v-diasize-need-maximize = false
     2724         .
     2725       end.
     2726       else do:
     2727         run diasize_change-width in this-procedure
     2728           (input v-diasize-orig-frame-width
     2729               - frame v-route :width-chars
     2730           ,input true
     2731           ) .
     2732         run diasize_change-height in this-procedure
     2733           (input v-diasize-orig-frame-height
     2734               - frame v-route :height-chars
     2735           ,input true
     2736           ) .
     2737         assign
     2738           v-diasize-need-maximize = true
     2739         .
     2740       end.
     2741     end.
     2742   end procedure.
     2743   procedure diasize_restore-orig-size :
     2744     do
     2745     on error undo, return error return-value
     2746     :
     2747       assign
     2748         v-diasize-current-frame-width  = frame v-route :width
     2749         v-diasize-current-frame-height = frame v-route :height
     2750       .
     2751       run diasize_set-height in this-procedure
     2752         (input  v-diasize-orig-frame-height
     2753         ,input  true
     2754         ) .
     2755       run diasize_set-width in this-procedure
     2756         (input  v-diasize-orig-frame-width
     2757         ,input  true
     2758         ) .
     2759     end.
     2760   end procedure.
     2761   procedure diasize_restore-current-size :
     2762     do
     2763     on error undo, return error return-value
     2764     :
     2765       run diasize_set-height in this-procedure
     2766         (input  v-diasize-current-frame-height
     2767         ,input  true
     2768         ) .
     2769       run diasize_set-width in this-procedure
     2770         (input  v-diasize-current-frame-width
     2771         ,input  true
     2772         ) .
     2773     end.
     2774   end procedure.
     2775   procedure diasize_set-browse-handle :
     2776     define input  parameter p-browse-handle as handle   no-undo .
     2777     define buffer buf_temp-browse-handle for temp-browse-handle .
     2778     do
     2779     on error undo, return error return-value
     2780     :
     2781       assign
     2782         v-diasize-browse-handle = p-browse-handle
     2783       .
     2784       for each buf_temp-browse-handle
     2785       on error undo, return error return-value
     2786       :
     2787         delete buf_temp-browse-handle .
     2788       end.
     2789     end.
     2790   end procedure.
     2791   procedure diasize_add_browse :
     2792     define input  parameter p-browse-type   as character no-undo .
     2793     define input  parameter p-browse-handle as handle    no-undo .
     2794     define buffer buf_temp-browse-handle for temp-browse-handle .
     2795     do
     2796     on error undo, return error return-value
     2797     :
     2798       assign
     2799         v-diasize-browse-number = v-diasize-browse-number + 1
     2800       .
     2801       create buf_temp-browse-handle .
     2802       assign
     2803         buf_temp-browse-handle.browse-type   = p-browse-type
     2804         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2805         buf_temp-browse-handle.browse-handle = p-browse-handle
     2806       .
     2807     end.
     2808   end procedure.
     2809   procedure diasize_init :
     2810     define variable v-default-value    as logical   no-undo .
     2811     define variable v-restore-saved    as logical   no-undo .
     2812     define variable v-resize-value-str as character no-undo .
     2813     do
     2814     on error undo, return error return-value
     2815     :
     2816       do with frame v-route
     2817       :
     2818         assign
     2819           v-diasize-orig-frame-height = frame v-route :height
     2820           v-diasize-orig-frame-width  = frame v-route :width
     2821           v-diasize-browse-handle     = browse br-route :handle
     2822         .
     2823         create button v-diasize-resize-button
     2824         assign
     2825           parent        = frame v-route :first-child
     2826           label         = "s"
     2827           height-pixels = 16
     2828           width-pixels  = 16
     2829           visible       = true
     2830           sensitive     = true
     2831           movable       = true
     2832           triggers:
     2833             on end-move persistent run diasize_end-move in this-procedure .
     2834           end triggers.
     2835         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2836         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2837         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2838         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2839         assign
     2840           v-diasize-wndmax = false
     2841         .
     2842         if connected("ub") = true
     2843         then do:
     2844           define variable v-cntxt-db-num        as integer   no-undo .
     2845           define variable v-cntxt-userid        as character no-undo .
     2846           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2847                                             , OUTPUT v-cntxt-userid
     2848                                             ) .
     2849           run gbl/wndpar_r.p
     2850             (input  v-cntxt-db-num
     2851             ,input  v-cntxt-userid
     2852             ,input  'wndmax':U
     2853             ,output v-diasize-wndmax
     2854             ,output v-default-value
     2855             ) .
     2856         end.
     2857         assign
     2858           v-diasize-wndstore = false
     2859         .
     2860         if connected("ub") = true
     2861         then do:
     2862           run gbl/wndpar_r.p
     2863             (input  v-cntxt-db-num
     2864             ,input  v-cntxt-userid
     2865             ,input  'wndstore':U
     2866             ,output v-diasize-wndstore
     2867             ,output v-default-value
     2868             ) .
     2869         end.
     2870         assign
     2871           v-diasize-proc-name = entry(1, program-name(2), '.')
     2872         .
     2873         if v-diasize-wndstore = true
     2874         then do:
     2875           assign
     2876             v-restore-saved = false
     2877           .
     2878           if connected("ub") = true
     2879           then do:
     2880             run gbl/wndsizer.p
     2881               (input  v-cntxt-db-num
     2882               ,input  v-cntxt-userid
     2883               ,input  v-diasize-proc-name
     2884               ,input  'height':u
     2885               ,output v-resize-value-str
     2886               ) .
     2887             if v-resize-value-str <> '':U
     2888             then do:
     2889               run diasize_change-height in this-procedure
     2890                 (input  integer(v-resize-value-str)
     2891                 ,input  true
     2892                 ) .
     2893               assign
     2894                 v-restore-saved = true
     2895               .
     2896             end.
     2897           end.
     2898           if connected("ub") = true
     2899           then do:
     2900             run gbl/wndsizer.p
     2901               (input  v-cntxt-db-num
     2902               ,input  v-cntxt-userid
     2903               ,input  v-diasize-proc-name
     2904               ,input  'width':u
     2905               ,output v-resize-value-str
     2906               ) .
     2907             if v-resize-value-str <> '':U
     2908             then do:
     2909               run diasize_change-width in this-procedure
     2910                 (input  integer(v-resize-value-str)
     2911                 ,input  true
     2912                 ) .
     2913               assign
     2914                 v-restore-saved = true
     2915               .
     2916             end.
     2917           end.
     2918           if v-restore-saved <> true
     2919           then do:
     2920             if v-diasize-wndmax = true
     2921             then do:
     2922               run diasize_maximize in this-procedure
     2923                 (input  true
     2924                 ) .
     2925             end.
     2926           end.
     2927         end.
     2928         else do:
     2929           if v-diasize-wndmax = true
     2930           then do:
     2931             run diasize_maximize in this-procedure
     2932               (input  true
     2933               ) .
     2934           end.
     2935         end.
     2936       end.
     2937     end.
     2938   end procedure.
     2939   procedure diasize_need-full-display :
     2940     define output parameter p-need-full-display as logical   no-undo .
     2941     do
     2942     on error undo, return error return-value
     2943     :
     2944       assign
     2945         p-need-full-display = v-diasize-need-full-display
     2946       .
     2947       assign
     2948         v-diasize-need-full-display = false
     2949       .
     2950     end.
     2951   end procedure.
     2952   procedure get-context :
     2953      define output parameter p-db-num as integer          no-undo.
     2954      define output parameter p-user-id as character        no-undo.
     2955      define variable v-login               as character    no-undo.
     2956      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2957      define buffer buf_user-login  for ub.user-login .
     2958      do
     2959      on error undo, return error
     2960      :
     2961            FIND FIRST buf_sys-ctrl no-lock.
     2962            ASSIGN
     2963               v-login = USERID("ub")
     2964               p-db-num = buf_sys-ctrl.db-num
     2965            .
     2966            FIND FIRST buf_user-login
     2967                 WHERE buf_user-login.db-num = p-db-num
     2968                   AND buf_user-login.user-login = v-login
     2969                 no-lock
     2970                 no-error
     2971                 .
     2972            IF AVAILABLE buf_user-login
     2973            THEN DO:
     2974               assign
     2975                  p-user-id = buf_user-login.user-id
     2976               .
     2977            END.
     2978      end.
     2979   end procedure.
     2980       run diasize_init in this-procedure .
     2981   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME v-route:PARENT eq ?
     2982   THEN FRAME v-route:PARENT = ACTIVE-WINDOW.
     2983   MAIN-BLOCK:
     2984   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2985      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2986   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2987   on f5 of frame v-route anywhere
     2988   do:
     2989     run reopen-query in this-procedure ( input true, input false, input '' ) .
     2990       apply "VALUE-CHANGED" to br-route.
     2991   end.
     2992   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2993   procedure set-filter-name :
     2994   define input parameter p-filter-name as character no-undo .
     2995     do with frame v-route:
     2996       if p-filter-name > "" then do:
     2997         assign
     2998           frame v-route:title
     2999             = frame v-route:title + "   ФИЛЬТР: " + p-filter-name.
     3000         .
     3001         assign
     3002           b-sch :tooltip = "Установлен фильтр " + p-filter-name
     3003         .
     3004       end.
     3005       else do:
     3006         assign
     3007           b-sch :tooltip = ""
     3008         .
     3009       end.
     3010     end.
     3011   end procedure.
     3012     assign
     3013       v-title0 = substitute("Недошедшая информация для БД &1", p-db-num )
     3014     .
     3015     RUN Myenable .
     3016     WAIT-FOR GO OF FRAME v-route focus br-route.
     3017   END.
     3018   RUN disable_UI.
     3019   PROCEDURE disable_UI :
     3020     HIDE FRAME v-route.
     3021   END PROCEDURE.
     3022   PROCEDURE enable_UI :
     3023     ENABLE b-quit b-sch b-help br-route
     3024         WITH FRAME v-route.
     3025     VIEW FRAME v-route.
     3026     OPEN QUERY br-route for each X_route no-lock   WHERE X_route.db-num = p-db-num   by X_route.tbl-ord .
     3027   END PROCEDURE.
     3028   PROCEDURE MyEnable :
     3029     assign
     3030       X_route.name-rec:resizable in browse br-route = yes
     3031       X_route.name-rec:width = 30
     3032       X_route.uniq-key-rec:resizable in browse br-route = yes
     3033       X_route.uniq-key-rec:width = 70
     3034       X_route.uniq-gate-rec:resizable in browse br-route = yes
     3035       X_route.uniq-gate-rec:width = 40
     3036       X_route.CreUserName:resizable in browse br-route = yes
     3037       X_route.CreUserName:width = 19
     3038     .
     3039     ENABLE
     3040       b-quit
     3041       b-help
     3042       b-sch
     3043       br-route
     3044       WITH FRAME v-route.
     3045     VIEW FRAME v-route.
     3046     run reopen-query in this-procedure
     3047       ( input true
     3048       , input false
     3049       , input '':U
     3050       ) .
     3051   END PROCEDURE.
     3052   PROCEDURE proc-b-sch :
     3053     assign
     3054       tbl = 'route'
     3055       join-tbl = 'X_route'
     3056       fld = ""
     3057       lab = ""
     3058       spr = ""
     3059       dim = '0'
     3060       .
     3061     run fltfield-add in this-procedure('name-rec', 'Таблица/команда', '',
     3062                                         input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3063     run fltfield-add in this-procedure('CreDate', 'Дата создания', '',
     3064                                         input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3065     run fltfield-add in this-procedure('CreUserName', 'Создал', 'usr',
     3066                                         input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3067     run fltfield-add in this-procedure('last-pack', 'Пакет', '',
     3068                                         input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3069     run fltfield-add in this-procedure('CreTimeInt', 'Время создания', 'time',
     3070                                         input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3071     run fltfield-add in this-procedure('Dump-ord', 'Dump-ord', '',
     3072                                         input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3073     Filter-Block:
     3074     DO
     3075     ON STOP    UNDO Filter-Block, LEAVE Filter-Block
     3076     ON ERROR   UNDO Filter-Block, LEAVE Filter-Block
     3077     ON END-KEY UNDO Filter-Block, LEAVE Filter-Block
     3078     :
     3079       run gbl/filter.w ( INPUT parparentproc, INPUT v-filter-point, INPUT tbl, INPUT join-tbl, INPUT fld, INPUT lab, INPUT spr, INPUT dim ).
     3080       run reopen-query in this-procedure
     3081         ( input true
     3082         , input false
     3083         , input '':U
     3084         ).
     3085     END.
     3086   END PROCEDURE.
     3087   PROCEDURE reopen-query :
     3088     define input  parameter p-open-query     as logical   no-undo .
     3089     define input  parameter p-find-next      as logical   no-undo .
     3090     define input  parameter p-find-condition as character no-undo .
     3091     define variable l-query-was-opened   as logical   no-undo .
     3092     define variable v-sort-column-phrase as character no-undo .
     3093     run waitfram-show in this-procedure ( input "Ждите...").
     3094     case v-sort-column-name :
     3095       when "" then do:
     3096         assign
     3097           v-sort-column-phrase = "":u
     3098         .
     3099       end.
     3100       otherwise do:
     3101         assign
     3102           v-sort-column-phrase = substitute( "by &1", v-sort-column-name )
     3103         .
     3104       end.
     3105     end case.
     3106     assign
     3107       v-filter-point = v-filter-point0 + chr(4) + v-filter-pointr
     3108       frame v-route:title = substitute( "&1", v-title0 )
     3109     .
     3110   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3111   define variable  l-disable-where-16  as logical   no-undo .
     3112   define variable  l-filter-open-16    as logical   .
     3113   define variable  flt-rec-16       as recid     no-undo .
     3114   define variable  filter-name-16      as character no-undo .
     3115   define variable  where-phrase-16     as character no-undo .
     3116   define variable  sort-phrase-16      as character no-undo .
     3117   define variable  where-phrase-rus-16 as character no-undo .
     3118   define variable  sort-phrase-rus-16  as character no-undo .
     3119     run waitfram-show in this-procedure
     3120       (input "ЖДИТЕ ..."
     3121       ).
     3122   run gbl/flt-get.p
     3123     (input v-filter-point
     3124     ,output flt-rec-16
     3125     ,output filter-name-16
     3126     ,output where-phrase-16
     3127     ,output sort-phrase-16
     3128     ,output where-phrase-rus-16
     3129     ,output sort-phrase-rus-16
     3130     ).
     3131   if p-open-query then do:
     3132       run set-filter-name in this-procedure
     3133         (INPUT filter-name-16
     3134         ) no-error .
     3135     assign
     3136       l-filter-open-16 = false
     3137     .
     3138     if flt-rec-16 <> ?
     3139       or v-sort-column-phrase > ""
     3140     then do:
     3141       define variable  parameter-2-16 as character no-undo .
     3142       define variable  parameter-3-16 as character no-undo .
     3143       define variable  parameter-4-16 as character no-undo .
     3144       define variable  parameter-5-16 as character no-undo .
     3145       define variable  parameter-6-16 as character no-undo .
     3146       define variable  parameter-7-16 as character no-undo .
     3147         assign
     3148         parameter-3-16 =
     3149                                 "for each x_route"
     3150         parameter-4-16 =
     3151           (
     3152             if ("x_route.db-num = p-db-num                         " + " " + where-phrase-16) <> ""
     3153             then substitute( 'x_route.db-num = &2                                       '                                       ,chr(34)                                       ,p-db-num                                     )                          + " " + where-phrase-16
     3154             else "true"
     3155           )
     3156         parameter-5-16 = (" " + "" + " " + "")
     3157         parameter-6-16 = if sort-phrase-16 = ''
     3158                              then
     3159           (
     3160           " " + " " +
     3161             " " + v-sort-column-phrase +
     3162           " " + "by x_route.tbl-ord"
     3163           )
     3164                              else
     3165           (
     3166           " " + " " +
     3167             " " + v-sort-column-phrase +
     3168           " " + sort-phrase-16
     3169           )
     3170         parameter-7-16 =
     3171           " indexed-reposition  "
     3172       .
     3173       do
     3174       on stop undo, leave
     3175       on error undo, leave
     3176       :
     3177         assign
     3178           l-disable-where-16 =
     3179             ("x_route.db-num = p-db-num                         " + " " + where-phrase-16 = "")
     3180         .
     3181         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     3182                             ,input query br-route :handle
     3183                             ,input parameter-3-16
     3184                             ,input parameter-4-16
     3185                             ,input parameter-5-16
     3186                             ,input parameter-6-16
     3187                             ,input parameter-7-16
     3188                             )
     3189         .
     3190         assign
     3191           l-filter-open-16 = true
     3192         .
     3193       end.
     3194       if l-filter-open-16 = false then do:
     3195         message
     3196           "Ошибка при фильтрации / сортировке" skip
     3197           "Будут показаны записи без учета фильтра" skip
     3198           view-as alert-box .
     3199       end.
     3200       else do:
     3201           assign
     3202             l-query-was-opened = true
     3203           .
     3204       end.
     3205     end.
     3206     if l-filter-open-16 = false then do:
     3207       open query br-route for each x_route
     3208         where x_route.db-num = p-db-num
     3209         by x_route.tbl-ord
     3210         indexed-reposition
     3211     .
     3212         assign
     3213           l-query-was-opened = true
     3214         .
     3215     end.
     3216   end.
     3217   else do:
     3218     assign
     3219       v-recid = recid( x_route )
     3220     .
     3221     do
     3222     on stop undo, leave
     3223     on error undo, leave
     3224     :
     3225       if query br-route :handle:get-buffer-handle(1) = (buffer x_route:handle) then do:
     3226         assign
     3227         parameter-2-16 = (if p-find-next then "true":u else "false":u )
     3228         parameter-4-16 =
     3229           "where ":u + substitute( 'x_route.db-num = &2                                       '                                       ,chr(34)                                       ,p-db-num                                     )                          + " ":u + where-phrase-16 + " ":u + p-find-condition + " " + ""
     3230         parameter-5-16 = " "
     3231       .
     3232         run fltopend_fltfindd in this-procedure  (
     3233                             input this-procedure:handle
     3234                             ,input query br-route :handle
     3235                             ,input rowid(x_route)
     3236                             ,input logical(parameter-2-16)
     3237                             ,input no-lock
     3238                             ,input (buffer x_route:handle)
     3239                             ,input parameter-4-16
     3240                             ,input parameter-5-16
     3241                             ) no-error.
     3242         .
     3243         assign
     3244           v-recid = integer(return-value)
     3245           v-fltopend-rowid[1] = ?
     3246         .
     3247       end.
     3248       else do:
     3249         assign
     3250         parameter-2-16 = (if p-find-next then "true":u else "false":u )
     3251         parameter-3-16 =  "for each x_route"
     3252         parameter-4-16 =
     3253           (
     3254             if ("x_route.db-num = p-db-num                         " + " " + where-phrase-16) <> ""
     3255             then substitute( 'x_route.db-num = &2                                       '                                       ,chr(34)                                       ,p-db-num                                     )                          + " " + where-phrase-16
     3256             else "true"
     3257           )
     3258         parameter-5-16 = (" " + "" + " " + "" + " " + p-find-condition)
     3259         parameter-6-16 = if sort-phrase-16 = ''
     3260                              then
     3261           (
     3262           " " + " " +
     3263             " " + v-sort-column-phrase +
     3264           " " + "by x_route.tbl-ord"
     3265           )
     3266                              else
     3267           (
     3268           " " + " " +
     3269             " " + v-sort-column-phrase +
     3270           " " + sort-phrase-16
     3271           )
     3272         parameter-7-16 =
     3273           " indexed-reposition  "
     3274       .
     3275         run fltopend_fltfindq in this-procedure  (
     3276                             input this-procedure:handle
     3277                             ,input query br-route :handle
     3278                             ,input logical(parameter-2-16)
     3279                             ,input no-lock
     3280                             ,input parameter-3-16
     3281                             ,input parameter-4-16
     3282                             ,input parameter-5-16
     3283                             ,input parameter-6-16
     3284                             ,input parameter-7-16
     3285                             ,output v-fltopend-rowid
     3286                             ) no-error.
     3287         .
     3288         v-recid = ?.
     3289       end.
     3290       assign
     3291         l-query-was-opened = true
     3292       .
     3293     end.
     3294   end.
     3295     run waitfram-hide in this-procedure .
     3296     if p-open-query = false then do:
     3297       if v-recid <> ? then do:
     3298         reposition br-route to recid v-recid no-error .
     3299       end.
     3300       else do:
     3301         message
     3302           substitute("!") skip
     3303           view-as alert-box information .
     3304       end.
     3305       if v-fltopend-rowid[1] <> ? then do:
     3306         query br-route:handle:reposition-to-rowid(v-fltopend-rowid) no-error.
     3307       end.
     3308     end.
     3309     apply "value-changed" to br-route in frame v-route.
     3310     apply "entry" to br-route in frame v-route.
     3311     run waitfram-hide in this-procedure .
     3312   end procedure.
     3313   FUNCTION conv-pck-num returns character
     3314     ( input p-pack-num as integer ) :
     3315     define variable p-ret-val as character no-undo.
     3316     if p-pack-num = -1 then do:
     3317       assign
     3318         p-ret-val = "Нет номера"
     3319       .
     3320     end.
     3321     else do:
     3322       assign
     3323         p-ret-val = substitute( "&1", p-pack-num )
     3324       .
     3325     end.
     3326     return p-ret-val.
     3327   end function.
     3328   FUNCTION get-descr-route returns character
     3329     ( input p-name-rec as character, input p-uniq-key-rec as character ) :
     3330     define variable v-key-rec     like ub.route.uniq-key-rec no-undo .
     3331     define variable v-delim-key   as   character             no-undo .
     3332     define variable v-route-descr as   character             no-undo .
     3333     case entry( 1, p-name-rec, chr(1) ):
     3334       when "delete":u then do:
     3335         assign
     3336           v-route-descr = "(удаление)" + chr(32)
     3337           v-delim-key   = chr(1)
     3338           v-key-rec     = substring( p-name-rec, index( p-name-rec, chr(1) ) + 1 )
     3339         .
     3340       end.
     3341       when "command":u then do:
     3342         case entry( 2, p-name-rec, chr(1) ):
     3343           when "delete":u then do:
     3344             assign
     3345               v-route-descr = "(удаление)" + chr(32)
     3346               v-delim-key   = chr(3)
     3347               v-key-rec     = entry( 3, p-name-rec, chr(1) )
     3348             .
     3349           end.
     3350           otherwise do:
     3351             assign
     3352               v-route-descr = "команда" + chr(32)
     3353               v-delim-key   = chr(1)
     3354               v-key-rec     = "":u
     3355             .
     3356           end.
     3357         end.
     3358       end.
     3359       otherwise do:
     3360         assign
     3361           v-route-descr = "":u
     3362           v-delim-key   = chr(3)
     3363           v-key-rec     = p-uniq-key-rec
     3364         .
     3365       end.
     3366     end case.
     3367     if v-key-rec <> "":u then do:
     3368       case entry( 1, v-key-rec, v-delim-key ) :
     3369         when 'trn-doc':U then do:
     3370           assign
     3371             v-route-descr = v-route-descr
     3372                             + "складской документ n" + chr(32) + entry( 2, v-key-rec, v-delim-key )
     3373           .
     3374         end.
     3375         when 'price-doc':U then do:
     3376           assign
     3377             v-route-descr = v-route-descr
     3378                             + "переоценка n" + chr(32) + entry( 2, v-key-rec, v-delim-key )
     3379           .
     3380         end.
     3381         when 'fbr-doc':U then do:
     3382           assign
     3383             v-route-descr = v-route-descr
     3384                             + "документ производства n" + chr(32) + entry( 2, v-key-rec, v-delim-key )
     3385           .
     3386         end.
     3387         when 'rvs-doc':U then do:
     3388           assign
     3389             v-route-descr = v-route-descr
     3390                             + "сверка n" + chr(32) + entry( 2, v-key-rec, v-delim-key )
     3391           .
     3392         end.
     3393         when 'inkas':U then do:
     3394           assign
     3395             v-route-descr = v-route-descr
     3396                             + "продажа n" + chr(32) + entry( 2, v-key-rec, v-delim-key )
     3397           .
     3398         end.
     3399         when 'shift-obj':U then do:
     3400           assign
     3401             v-route-descr = v-route-descr
     3402                             + "смена n" + chr(32) + entry( 5, v-key-rec, v-delim-key ) + chr(32)
     3403                             + "от" + chr(32) + entry( 4, v-key-rec, v-delim-key ) + chr(32)
     3404                             + "на объекте тип:" + chr(32) + entry( 2, v-key-rec, v-delim-key ) + chr(32)
     3405                             + "код:" + chr(32) + entry( 3, v-key-rec, v-delim-key )
     3406           .
     3407         end.
     3408         when 'clients':U then do:
     3409           assign
     3410             v-route-descr = v-route-descr
     3411                             + "контрагент" + chr(32)
     3412                             + "тип:" + chr(32) + entry( 2, v-key-rec, v-delim-key ) + chr(32)
     3413                             + "код:" + chr(32) + entry( 3, v-key-rec, v-delim-key )
     3414           .
     3415         end.
     3416         when 'goods':U then do:
     3417           assign
     3418             v-route-descr = v-route-descr
     3419                             + "товар код:" + chr(32) + entry( 2, v-key-rec, v-delim-key )
     3420           .
     3421         end.
     3422         when 'bar-code':U then do:
     3423           assign
     3424             v-route-descr = v-route-descr
     3425                             + "бар-код" + chr(32) + entry( 2, v-key-rec, v-delim-key )
     3426           .
     3427         end.
     3428         when 'prod-bc':U then do:
     3429           assign
     3430             v-route-descr = v-route-descr
     3431                             + "доп. код" + chr(32) + entry( 3, v-key-rec, v-delim-key ) + chr(32)
     3432                             + "для бар-кода" + chr(32) + entry( 2, v-key-rec, v-delim-key )
     3433           .
     3434         end.
     3435         when 'gds-grp':U then do:
     3436           assign
     3437             v-route-descr = v-route-descr
     3438                             + "группа товаров код:" + chr(32) + entry( 2, v-key-rec, v-delim-key )
     3439           .
     3440         end.
     3441         when 'cli-grp':U then do:
     3442           assign
     3443             v-route-descr = v-route-descr
     3444                             + "группа клиентов код:" + chr(32) + entry( 2, v-key-rec, v-delim-key )
     3445           .
     3446         end.
     3447         when 'db':U then do:
     3448           assign
     3449             v-route-descr = v-route-descr
     3450                             + "УБД" + chr(32) + entry( 2, v-key-rec, v-delim-key )
     3451           .
     3452         end.
     3453         when 'recipe':U then do:
     3454           assign
     3455             v-route-descr = v-route-descr
     3456                             + "рецепт" + chr(32) + entry( 2, v-key-rec, v-delim-key )
     3457           .
     3458         end.
     3459         when 'config':U then do:
     3460           assign
     3461             v-route-descr = v-route-descr
     3462                             + "настроечный параметр" + chr(32) + entry( 2, v-key-rec, v-delim-key )
     3463           .
     3464         end.
     3465         otherwise do:
     3466           assign
     3467             v-route-descr = "Без расшифровки --->"
     3468           .
     3469         end.
     3470       end case.
     3471     end.
     3472     else do:
     3473       case entry( 2, p-name-rec, v-delim-key ) :
     3474         when "goods":u then do:
     3475           if entry( 3, p-name-rec, v-delim-key ) = "ren-art":u then do:
     3476             assign
     3477               v-route-descr = v-route-descr
     3478                               + "переименование товара" + chr(32)
     3479                               + entry( 4, p-name-rec, v-delim-key ) + chr(32)
     3480                               + "ст. арт." + chr(32) + entry( 5, p-name-rec, v-delim-key ) + chr(32)
     3481                               + "ст. тип пр." + chr(32) + entry( 6, p-name-rec, v-delim-key ) + chr(32)
     3482                               + "ст. код пр." + chr(32) + entry( 7, p-name-rec, v-delim-key ) + chr(32)
     3483                               + "н. арт." + chr(32) + entry( 8, p-name-rec, v-delim-key ) + chr(32)
     3484                               + "н. тип пр." + chr(32) + entry( 9, p-name-rec, v-delim-key ) + chr(32)
     3485                               + "н. код пр." + chr(32) + entry( 10, p-name-rec, v-delim-key )
     3486             .
     3487           end.
     3488         end.
     3489         otherwise do:
     3490           assign
     3491             v-route-descr = "Без расшифровки --->"
     3492           .
     3493         end.
     3494       end case.
     3495     end.
     3496     return v-route-descr .
     3497   end function.
     3498   FUNCTION get-gate-file-name-f returns character
     3499     ( p-gate-rec as character ) :
     3500     define variable v-gate-file-name as character no-undo.
     3501     if p-gate-rec > '':u then do:
     3502       run get-gate-file-name in this-procedure ( input p-gate-rec
     3503                                               ,output v-gate-file-name) no-error.
     3504       if error-status:error then do:
     3505         v-gate-file-name = "!!!???? ?? ??????".
     3506       end.
     3507     end.
     3508     return v-gate-file-name.
     3509   end function.
