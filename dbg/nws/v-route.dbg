     2236     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2237     if p-change-value > 0
     2238     then do:
     2239       if frame v-route :width + p-change-value >
     2240           session :width-chars
     2241       then do:
     2242         assign
     2243           p-change-value = session :width-chars - frame v-route :width
     2244         .
     2245         if p-change-value <= 0
     2246         then do:
     2247           run diasize_position-resize-button in this-procedure .
     2248           return .
     2249         end.
     2250       end.
     2251     end.
     2252     if p-change-value < 0
     2253     then do:
     2254       if frame v-route :width + p-change-value < v-diasize-orig-frame-width
     2255       then do:
     2256         assign
     2257           p-change-value = v-diasize-orig-frame-width
     2258                          - frame v-route :width
     2259         .
     2260         if p-change-value >= 0
     2261         then do:
     2262           run diasize_position-resize-button in this-procedure .
     2263           return .
     2264         end.
     2265       end.
     2266     end.
     2267     if p-change-value >= 0
     2268     then do:
     2269       assign
     2270         v-change-sign = 1
     2271       .
     2272     end.
     2273     else do:
     2274       assign
     2275         v-change-sign = -1
     2276       .
     2277     end.
     2278     assign
     2279       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2280     .
     2281     if p-change-value = 0
     2282     then do:
     2283       run diasize_position-resize-button in this-procedure .
     2284       return .
     2285     end.
