        1   DEFINE BUFFER X_route FOR ub.route.
        2   define input parameter parparentproc as   widget-handle no-undo .
        3   define input parameter p-db-num      like ub.db.db-num  no-undo.
        4   def var vss-revision    as character no-undo init "$Revision$":U .
        5   def var vss-author      as character no-undo init "$Author$":U .
        6   def var vss-date        as character no-undo init "$Date$":U .
        7   def var vss-workfile    as character no-undo init "$Workfile$":U .
        8   def var vss-archive     as character no-undo init "$Archive$":U .
        9   def var vss-description as character no-undo init "Просмотр маршрутизации по заданой БД".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   procedure proc-alt-shift-f2:
       69     if not ibs.th.gbl.gbl-var:rcode
       70   then
       71     run gbl\inidebug.p .
       72   end.
       73   procedure proc-alt-shift-f3:
       74     run gbl/prvssinf.p
       75       ( input this-procedure
       76       ) .
       77   end.
       78   define variable v-inform-launched as logical no-undo initial false .
       79   procedure proc-alt-shift-f4:
       80     define variable v-action as character no-undo .
       81     if v-inform-launched = false then do:
       82       assign
       83         v-inform-launched = true
       84       .
       85       run gbl/d-inform.w
       86         (  input self
       87         ,  input this-procedure
       88         , output v-action
       89         ) no-error .
       90       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       91       assign
       92         v-inform-launched = false
       93       .
       94     end.
       95   end.
       96   procedure proc-alt-f1:
       97     run gbl/corrhelp.p
       98       (input this-procedure
       99       ) .
      100   end .
      101   on alt-shift-f2 anywhere do:
      102     run proc-alt-shift-f2.
      103   end.
      104   on alt-shift-f3 anywhere do:
      105     run proc-alt-shift-f3 in this-procedure .
      106   end.
      107   on alt-shift-f4 anywhere do:
      108     run proc-alt-shift-f4 in this-procedure.
      109   end.
      110   on alt-f1 anywhere do:
      111     run proc-alt-f1 in this-procedure .
      112   end.
      113   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      114   define variable v-waitfram-action01         as character   no-undo .
      115   define variable v-waitfram-action02         as character   no-undo .
      116   define variable v-waitfram-action03         as character   no-undo .
      117   define variable mWaitFramTextBeg            as character   no-undo.
      118   define variable mWaitFramTextEnd            as character   no-undo.
      119   define variable mWaitFramView               as logical     no-undo.
      120   define variable mWaitProcEvent              as logical     no-undo init yes.
      121   define variable mWaitFramInterval           as integer     no-undo init 1 .
      122   define variable mWaitFramStop               as logical     no-undo.
      123   define variable mWaitFramStopUser           as logical     no-undo.
      124   define variable mWaitFramStopTimeOut        as logical     no-undo.
      125   define variable mWaitFramStartProc          as datetime-tz no-undo.
      126   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      127   define button B-WaitFramStop auto-end-key
      128        label "Стоп"
      129        size 10 by 1 tooltip "Остоновить процесс".
      130   define button B-viewProcInfo
      131        label "Информация"
      132        size 15 by 1 tooltip "Информация о процесс".
      133   define frame waitfram
      134     v-waitfram-action01 format "x(72)" no-label skip
      135     v-waitfram-action02 format "x(72)" no-label skip
      136     v-waitfram-action03 format "x(72)" no-label skip
      137     B-viewProcInfo
      138     B-WaitFramStop at row 4 col 30
      139     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      140     .
      141   define new global shared variable mBatchMode as logical no-undo init ?.
      142   define variable mFramBachModHandle as handle no-undo.
      143   mFramBachModHandle = frame waitfram:handle.
      144   define variable mFameOldVis as logical no-undo.
      145   define variable mVisCUrentVin as logical no-undo.
      146   if session:batch-mode
      147   then
      148      mBatchMode = yes.
      149   if mBatchMode = ? then do:
      150     mVisCUrentVin = current-window:visible.
      151     mFameOldVis = mFramBachModHandle:visible.
      152     mFramBachModHandle:visible  = yes.
      153     mBatchMode = mFramBachModHandle:visible ne yes.
      154     mFramBachModHandle:visible = mFameOldVis.
      155     current-window:visible = mVisCUrentVin.
      156   end.
      157    if  log-manager:logfile-name ne ?
      158     then DO:
      159         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      160         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      161         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      162     end.
      163   on choose of B-WaitFramStop in frame waitfram
      164   do:
      165     mWaitFramStop = yes.
      166     mWaitFramStopUser = yes.
      167   end.
      168   function waitfram-check-timeout returns logical():
      169      define variable vtime as int64 no-undo.
      170      if mWaitFramStopTimeOut
      171      then
      172         return yes.
      173      vtime = ( now - mWaitFramStartProc ) / 1000 .
      174      if     mWaitFramTimeOut ne ?
      175         and mWaitFramTimeOut ne 0
      176         and mWaitFramTimeOut lt vtime
      177      then do:
      178         mWaitFramStopTimeOut = yes.
      179      end.
      180      return mWaitFramStopTimeOut.
      181   end.
      182   procedure waitfram-hide :
      183     if not session:batch-mode
      184     then do
      185     on error undo, return error return-value
      186     :
      187       pause 0 before-hide .
      188       if not mBatchMode then
      189         hide frame waitfram .
      190     if     not mWaitFramView
      191        and mWaitProcEvent
      192     then
      193       process events .
      194     end.
      195   end procedure.
      196   procedure waitfram-show :
      197     define input  parameter p-message as character no-undo .
      198     define variable v-left-margin as integer   no-undo .
      199     if not session:batch-mode
      200     then do
      201     on error undo, return error return-value
      202     :
      203       if length(p-message) <= 70 then do:
      204         assign
      205           v-left-margin = integer((70 - length(p-message)) / 2)
      206         .
      207         assign
      208           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      209         .
      210         assign
      211           v-waitfram-action01 = " "
      212           v-waitfram-action02 = " "
      213                                    + fill(" ", v-left-margin)
      214                                    + p-message
      215           v-waitfram-action03 = " "
      216         .
      217       end.
      218       else do:
      219         define variable vRindex1 as integer no-undo.
      220         define variable vRindex2 as integer no-undo.
      221         vRindex1 = r-index(p-message," ",70).
      222         if vRindex1 = 0
      223         then
      224            vRindex1 = 70.
      225         if length(p-message)  <= vRindex1 + 70 then do:
      226           assign
      227             v-waitfram-action01 = " "
      228             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      229             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      230           .
      231         end.
      232         else do:
      233           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      234           if vRindex2 <= vRindex1
      235           then
      236              vRindex2 = vRindex1 + 70.
      237           assign
      238             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      239             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      240             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      241           .
      242         end.
      243       end.
      244       B-viewProcInfo:visible   in frame waitfram = no.
      245       B-viewProcInfo:sensitive in frame waitfram = no.
      246       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      247       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      248       if  (   mWaitFramView
      249          or  mWaitProcEvent)
      250          and not mBatchMode
      251       then
      252          display
      253             v-waitfram-action01 skip
      254             v-waitfram-action02 skip
      255             v-waitfram-action03 skip
      256          with frame waitfram .
      257       if     mWaitFramView
      258          then do:
      259             if     mWaitFramInterval ne ?
      260                and not mBatchMode
      261             then
      262                wait-for go of frame waitfram pause mWaitFramInterval.
      263          end.
      264          else
      265             if     mWaitProcEvent
      266                and not mBatchMode
      267             then
      268                process events .
      269     end.
      270   end procedure.
      271      procedure waitfram-show-this:
      272         define input  parameter iInterval as int64 no-undo.
      273         define variable vtime as int64 no-undo.
      274         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      275         mWaitFramInterval = iInterval.
      276         run waitfram-show (substitute("&1&2 &3&4" ,
      277                                       mWaitFramTextBeg ,
      278                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      279                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      280                                       mWaitFramTextEnd
      281                                      )
      282                           ).
      283      end.
      284      procedure WaitFramRunPause:
      285         define input  parameter iInterval as dec no-undo.
      286         define variable vStart  as datetime-tz no-undo.
      287         define variable vend    as datetime-tz no-undo.
      288         define variable vint as int64 no-undo.
      289         define variable vOk as logical no-undo.
      290         vStart = now.
      291         vend   = vStart.
      292         publish "WaitFramPause" (iInterval,output vOk).
      293         vend   =  now.
      294         vint = vend - vStart.
      295         vint = iInterval - vint / 1000.
      296         if     not mWaitFramStop
      297            and (   vint > 0
      298                 or (    not vOk
      299                     and iInterval eq ?
      300                     )
      301                 )
      302         then
      303            run waitfram-show-this (iInterval).
      304         vend   =  now.
      305         vint = vend - vStart.
      306         vint = iInterval - vint / 1000.
      307         if     not mWaitFramStop
      308            and vint > 0
      309         then do:
      310            run gbl/pause.p (vint * 1000).
      311         end.
      312         if iInterval ne ?
      313         then
      314            publish "WaitFramStop".
      315         waitfram-check-timeout().
      316      end.
      317      procedure WaitFramWaitFor:
      318         define input  parameter iInterval as dec no-undo.
      319         assign
      320            mWaitFramStartProc   = now
      321            mWaitFramStopUser    = no
      322            mWaitFramStopTimeOut = no
      323         .
      324         block-wait:
      325         do while not mWaitFramStop:
      326            run WaitFramRunPause (iInterval).
      327            if  waitfram-check-timeout()
      328            then do:
      329               leave block-wait.
      330            end.
      331         end.
      332         run waitfram-hide.
      333      end.
      334   procedure waitfram-join :
      335     define input  parameter p-line-1  as character no-undo .
      336     define input  parameter p-line-2  as character no-undo .
      337     define input  parameter p-line-3  as character no-undo .
      338     define output parameter p-message as character no-undo .
      339     do
      340     on error undo, return error return-value
      341     :
      342       assign
      343         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      344                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      345                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      346       .
      347     end.
      348   end procedure.
      349   function waitfram-join-function returns character
      350     (input p-line-1 as character
      351     ,input p-line-2 as character
      352     ,input p-line-3 as character
      353     ).
      354     define variable v-message as character no-undo .
      355     run waitfram-join in this-procedure
      356       (input  p-line-1
      357       ,input  p-line-2
      358       ,input  p-line-3
      359       ,output v-message
      360       ) .
      361     return v-message .
      362   end function .
      363   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      364   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      365   define variable tempcxml_v-num_ as integer no-undo .
      366   define  temp-table temp-xml-tables no-undo
      367   field order as integer
      368   field tbl-name as character
      369   field tbl-handle_ as handle
      370   field table-handle_ as handle
      371   field uniq-gate-rec as character
      372   field gate-name as character
      373   field gate-handle_ as handle
      374   field is-parent as logical
      375   index pi is unique primary
      376   uniq-gate-rec
      377   tbl-name
      378   index iorder
      379   order
      380   index gr
      381   uniq-gate-rec
      382   index gh
      383   gate-handle_
      384   index iparent
      385   is-parent
      386   .
      387   define  temp-table temp-xml-records no-undo
      388   field tbl-name as character
      389   field uniq-key-rec as character
      390   index pi is unique primary
      391   tbl-name
      392   uniq-key-rec
      393   .
      394   def var vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      395   procedure gen-key-rec :
      396     define input  parameter p-tbl-name    as character no-undo.
      397     define input  parameter p-bh_tbl-name as handle    no-undo.
      398     define output parameter p-key-rec     as character no-undo.
      399     do
      400     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      401     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      402     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      403     :
      404       define variable fh               as handle    no-undo .
      405       define variable v-ok             as logical   no-undo .
      406       define variable v-inform         as character no-undo .
      407       define variable v-ind            as integer   no-undo .
      408       define variable v-idx-field-qnty as integer   no-undo .
      409       if p-tbl-name = ?
      410         or p-tbl-name = "":U
      411       then do:
      412         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info3 ).
      413       end.
      414       if not p-bh_tbl-name:available then do:
      415         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info3, p-tbl-name ).
      416       end.
      417       assign
      418         p-key-rec = p-tbl-name
      419         v-inform  = p-bh_tbl-name:index-information(1)
      420         v-ind     = 2
      421       .
      422       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      423       on error undo, return error
      424       :
      425         assign
      426           v-inform = p-bh_tbl-name:index-information( v-ind )
      427           v-ind    = v-ind + 1
      428         .
      429       end.
      430       if v-inform = ?
      431         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      432         or entry( 3, v-inform, ",":U ) <> "1":U
      433       then do:
      434         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info3, p-tbl-name ).
      435       end.
      436       else do:
      437         assign
      438           v-idx-field-qnty = num-entries( v-inform ) - 4
      439         .
      440         if v-idx-field-qnty < 2 then do:
      441           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, p-tbl-name ).
      442         end.
      443         do v-ind = 1 to v-idx-field-qnty by 2
      444         on error undo, return error
      445         :
      446           assign
      447             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      448             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      449           .
      450         end.
      451       end.
      452       if p-key-rec = ? then do:
      453         assign
      454           p-key-rec = "":U
      455         .
      456         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info3, p-tbl-name ).
      457       end.
      458     end.
      459     return.
      460   end procedure.
      461   procedure gen-where-keyr-tab :
      462     define input  parameter i-tableSerach as character no-undo.
      463     define input  parameter i-tablekey   as character  no-undo.
      464     define input  parameter p-key-rec    as character  no-undo.
      465     define input  parameter p-key-handle as handle     no-undo .
      466     define input  parameter p-db-name    as character  no-undo .
      467     define input  parameter p-tt-handle  as handle     no-undo .
      468     define output parameter o-Where      as character  no-undo.
      469     do
      470     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      471     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      472     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      473     :
      474       define variable v-full-tbl-name  as character no-undo .
      475       define variable bh_tbl-name      as handle    no-undo .
      476       define variable fh_key           as handle    no-undo .
      477       define variable fh_search        as handle    no-undo .
      478       define variable v-field-num      as integer   no-undo .
      479       define variable v-count-fld      as integer   no-undo .
      480       define variable v-inform         as character no-undo .
      481       define variable v-ind            as integer   no-undo .
      482       define variable v-idx-field-qnty as integer   no-undo .
      483       define variable v-field-name     as character no-undo .
      484       define variable v-field-val      as character no-undo .
      485       define variable v-word-link      as character no-undo .
      486       define variable vTable           as character no-undo.
      487       define variable bh_tbl-key       as handle    no-undo .
      488       assign
      489         p-key-rec = trim( p-key-rec )
      490       .
      491       if p-key-handle <> ? then do:
      492         if not valid-handle(p-key-handle)
      493            or p-key-handle:type <> "buffer"
      494         then do:
      495           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info3 ).
      496         end.
      497         if num-entries( p-key-rec, chr(3) ) > 1
      498           or p-key-rec = ?
      499           or p-key-rec = "":U
      500         then do:
      501           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info3, p-key-rec ).
      502         end.
      503       end.
      504       else do:
      505         if p-key-rec = ?
      506           or p-key-rec = "":U
      507         then do:
      508           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info3 ).
      509         end.
      510       end.
      511       assign
      512         vTable = entry( 1 , p-key-rec, chr(3) )
      513       .
      514       if p-tt-handle <> ?
      515         and ( not valid-handle(p-tt-handle)
      516               or p-tt-handle:type <> "buffer"
      517             )
      518       then do:
      519         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info3, vTable, chr(10) ).
      520       end.
      521       if p-tt-handle = ? then do:
      522         assign
      523           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      524         .
      525         create buffer bh_tbl-name for table v-full-tbl-name .
      526       end.
      527       else do:
      528         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      529       end.
      530       assign
      531         v-inform = bh_tbl-name:index-information(1)
      532         v-ind    = 2
      533       .
      534       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      535       on error undo, return error
      536       :
      537         assign
      538           v-inform = bh_tbl-name:index-information( v-ind )
      539           v-ind    = v-ind + 1
      540         .
      541       end.
      542       if v-inform = ?
      543         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      544         or entry( 3, v-inform, ",":U ) <> "1":U
      545       then do:
      546         delete object bh_tbl-name no-error.
      547         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info3, vTable ).
      548       end.
      549       assign
      550         v-idx-field-qnty = num-entries( v-inform ) - 4
      551       .
      552       if v-idx-field-qnty < 2 then do:
      553         delete object bh_tbl-name no-error.
      554         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, vTable ).
      555       end.
      556       assign
      557         o-where     = "where":U
      558         v-word-link = "":U
      559         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      560         v-count-fld = 0
      561       .
      562       if i-tablekey ne "" and i-tablekey ne ?
      563       then do:
      564         assign
      565           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      566         .
      567         create buffer bh_tbl-key for table v-full-tbl-name .
      568       end.
      569       if i-tableSerach ne "" and i-tableSerach ne ?
      570       then do:
      571         delete object bh_tbl-name no-error.
      572         assign
      573           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      574         .
      575         create buffer bh_tbl-name for table v-full-tbl-name .
      576       end.
      577       block_where:
      578       do v-ind = 1 to v-idx-field-qnty by 2
      579       on error undo, return error
      580       :
      581         assign
      582           v-count-fld = v-count-fld + 1
      583         .
      584         if p-key-handle = ?
      585           and v-count-fld > v-field-num
      586         then do:
      587           leave block_where.
      588         end.
      589         define variable VfieldKeyTable as handle no-undo.
      590         assign
      591           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      592           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      593         .
      594         if     bh_tbl-key ne ?
      595         then do:
      596            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      597            if VfieldKeyTable eq ?
      598            then next block_where.
      599         end.
      600         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      601         then
      602            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      603         else
      604            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      605         if p-key-handle = ? then do:
      606           assign
      607             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      608           .
      609         end.
      610         else do:
      611           assign
      612             fh_key = p-key-handle:buffer-field( v-field-name )
      613           .
      614           if fh_key = ?
      615             or not valid-handle( fh_key )
      616           then do:
      617             delete object bh_tbl-name.
      618             if     bh_tbl-key ne ?
      619             then
      620                delete object bh_tbl-key.
      621             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info3, p-key-handle:name, v-field-name ).
      622           end.
      623           assign
      624             v-field-val = fh_key:buffer-value
      625           .
      626         end.
      627         if fh_search:data-type ="character":U then do:
      628           assign
      629             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      630             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      631             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      632             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      633             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      634             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      635             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      636             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      637             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      638             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      639             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      640             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      641             v-field-val = substitute( '"&1"', v-field-val )
      642           .
      643         end.
      644         assign
      645           o-where = substitute( "&1 &2", o-where, v-field-val )
      646         .
      647         if v-word-link = "":U then do:
      648           assign
      649             v-word-link = "and":U
      650           .
      651         end.
      652       end.
      653       delete object bh_tbl-name.
      654       if     bh_tbl-key ne ?
      655       then
      656          delete object bh_tbl-key.
      657       if p-key-handle = ?
      658         and v-count-fld <> v-field-num
      659       then do:
      660         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info3, vTable ).
      661       end.
      662     end.
      663   end procedure.
      664   procedure gen-hn-keyr-tab :
      665     define input  parameter i-tableSerach as character no-undo.
      666     define input  parameter i-tablekey   as character no-undo.
      667     define input  parameter p-key-rec    as character no-undo.
      668     define input  parameter p-key-handle as handle    no-undo .
      669     define input  parameter p-db-name    as character no-undo .
      670     define input  parameter p-tt-handle  as handle    no-undo .
      671     define input  parameter p-stts-lock  as integer   no-undo .
      672     define output parameter o-hn         as handle    no-undo.
      673     define variable v-full-tbl-name as character no-undo.
      674     define variable v-where         as character no-undo.
      675     define variable bh_tbl-name     as handle    no-undo.
      676     define variable vTable          as character no-undo.
      677     do
      678     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      679     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      680     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      681         run gen-where-keyr-tab(i-tableSerach,
      682                                i-tablekey,
      683                                p-key-rec,
      684                                p-key-handle,
      685                                p-db-name,
      686                                p-tt-handle,
      687                                output v-where).
      688         if i-tableSerach ne "" and i-tableSerach ne ?
      689         then do:
      690            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      691            create buffer bh_tbl-name for table v-full-tbl-name .
      692         end.
      693         else do:
      694            if p-tt-handle = ? then do:
      695               assign
      696                  vTable = entry( 1 , p-key-rec, chr(3) )
      697               .
      698               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      699               create buffer bh_tbl-name for table v-full-tbl-name .
      700            end.
      701            else do:
      702               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      703            end.
      704         end.
      705         if p-tt-handle = ? then do:
      706            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      707         end.
      708         else do:
      709            bh_tbl-name:find-first( v-where ) no-error .
      710         end.
      711         o-hn = bh_tbl-name.
      712      end.
      713   end procedure.
      714   procedure gen-hn-keyr :
      715     define input  parameter p-key-rec    as character no-undo.
      716     define input  parameter p-key-handle as handle    no-undo .
      717     define input  parameter p-db-name    as character no-undo .
      718     define input  parameter p-tt-handle  as handle    no-undo .
      719     define input  parameter p-stts-lock  as integer   no-undo .
      720     define output parameter o-hn         as handle    no-undo.
      721     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      722   end.
      723   procedure gen-row-keyr :
      724     define input  parameter p-key-rec    as character no-undo.
      725     define input  parameter p-key-handle as handle    no-undo .
      726     define input  parameter p-db-name    as character no-undo .
      727     define input  parameter p-tt-handle  as handle    no-undo .
      728     define input  parameter p-stts-lock  as integer   no-undo .
      729     define output parameter p-tbl-row    as rowid     no-undo.
      730     define output parameter p-tbl-name   as character no-undo.
      731     define variable vHn as handle no-undo.
      732       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      733       p-tbl-row = if vHn:available then vHn:rowid else ?.
      734       p-tbl-name =  vHn:table.
      735       delete object vHn no-error.
      736     if p-tbl-row = ? then do:
      737       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info3, p-tbl-name, p-key-rec ).
      738     end.
      739     else do:
      740       return.
      741     end.
      742   end procedure.
      743   procedure gen-key-fv :
      744     define input  parameter p-key-rec    as character no-undo .
      745     define output parameter p-field-list as character no-undo .
      746     define output parameter p-value-list as character no-undo.
      747     do
      748     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      749     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      750     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      751     :
      752       define variable v-full-tbl-name  as character no-undo .
      753       define variable bh_tbl-name      as handle    no-undo .
      754       define variable v-tbl-name       as character no-undo .
      755       define variable v-field-num      as integer   no-undo .
      756       define variable v-count-fld      as integer   no-undo .
      757       define variable v-inform         as character no-undo .
      758       define variable v-ind            as integer   no-undo .
      759       define variable v-idx-field-qnty as integer   no-undo .
      760       define variable v-delim-key      as character no-undo .
      761       if p-key-rec = ?
      762         or p-key-rec = "":U
      763       then do:
      764         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info3 ).
      765       end.
      766       assign
      767         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      768         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      769       .
      770       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      771       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info3 ).
      772       assign
      773         v-inform = bh_tbl-name:index-information(1)
      774         v-ind    = 2
      775       .
      776       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      777       on error undo, return error
      778       :
      779         assign
      780           v-inform = bh_tbl-name:index-information( v-ind )
      781           v-ind    = v-ind + 1
      782         .
      783       end.
      784       if v-inform = ?
      785         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      786         or entry( 3, v-inform, ",":U ) <> "1":U
      787       then do:
      788         delete object bh_tbl-name no-error.
      789         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info3, v-tbl-name ).
      790       end.
      791       assign
      792         v-idx-field-qnty = num-entries( v-inform ) - 4
      793       .
      794       if v-idx-field-qnty < 2 then do:
      795         delete object bh_tbl-name no-error.
      796         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, v-tbl-name ).
      797       end.
      798       assign
      799         p-field-list = "":U
      800         p-value-list = "":U
      801         v-delim-key  = "":U
      802         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      803         v-count-fld  = 0
      804       .
      805       block_where:
      806       do v-ind = 1 to v-idx-field-qnty by 2
      807       on error undo, return error
      808       :
      809         assign
      810           v-count-fld = v-count-fld + 1
      811         .
      812         if v-count-fld > v-field-num then do:
      813           leave block_where.
      814         end.
      815         assign
      816           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      817           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      818         .
      819         if v-ind = 1 then do:
      820           assign
      821             v-delim-key = chr(3)
      822           .
      823         end.
      824       end.
      825       delete object bh_tbl-name.
      826       if v-count-fld <> v-field-num then do:
      827         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info3, v-tbl-name ).
      828       end.
      829     end.
      830   end procedure.
      831   procedure gen-key-field :
      832     define input  parameter p-table      as character no-undo .
      833     define output parameter p-field-list as character no-undo .
      834     do
      835     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      836     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      837     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      838     :
      839       define variable v-full-tbl-name  as character no-undo .
      840       define variable bh_tbl-name      as handle    no-undo .
      841       define variable v-tbl-name       as character no-undo .
      842       define variable v-field-num      as integer   no-undo .
      843       define variable v-count-fld      as integer   no-undo .
      844       define variable v-inform         as character no-undo .
      845       define variable v-ind            as integer   no-undo .
      846       define variable v-idx-field-qnty as integer   no-undo .
      847       define variable v-delim-key      as character no-undo .
      848       if p-table = ?
      849         or p-table = "":U
      850       then do:
      851         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info3 ).
      852       end.
      853       assign
      854         v-tbl-name      = p-table
      855         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      856       .
      857       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      858       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info3 ).
      859       assign
      860         v-inform = bh_tbl-name:index-information(1)
      861         v-ind    = 2
      862       .
      863       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      864       on error undo, return error
      865       :
      866         assign
      867           v-inform = bh_tbl-name:index-information( v-ind )
      868           v-ind    = v-ind + 1
      869         .
      870       end.
      871       if v-inform = ?
      872         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      873         or entry( 3, v-inform, ",":U ) <> "1":U
      874       then do:
      875         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info3, v-tbl-name ).
      876       end.
      877       assign
      878         v-idx-field-qnty = num-entries( v-inform ) - 4
      879       .
      880       if v-idx-field-qnty < 2 then do:
      881         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, v-tbl-name ).
      882       end.
      883       assign
      884         p-field-list = "":U
      885         v-delim-key  = "":U
      886         v-count-fld  = 0
      887       .
      888       block_where:
      889       do v-ind = 1 to v-idx-field-qnty by 2
      890       on error undo, return error
      891       :
      892         assign
      893           v-count-fld = v-count-fld + 1
      894         .
      895         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      896         if v-ind = 1 then do:
      897           assign
      898             v-delim-key = chr(3)
      899           .
      900         end.
      901       end.
      902       delete object bh_tbl-name.
      903     end.
      904   end procedure.
      905   procedure get-gate-file-name :
      906   define input parameter p-gate-rec as character no-undo .
      907   define output  parameter p-gate-file-name as character no-undo .
      908   define buffer buf_clob-data for ub.clob-data.
      909   define variable v-tbl-row as rowid no-undo .
      910   define variable v-tbl-name as character no-undo .
      911   run gen-row-keyr in this-procedure ( input p-gate-rec
      912                                       ,input ?
      913                                       ,input "ub"
      914                                       ,input ?
      915                                       ,input no-lock
      916                                       ,output v-tbl-row
      917                                       ,output v-tbl-name) no-error.
      918   if error-status:error then undo, return error substitute("&1 (get-gate-name) Несуществующий gate &2"
      919                                                           ,vss-include-info1
      920                                                           ,p-gate-rec).
      921   find first buf_clob-data no-lock where
      922             rowid(buf_clob-data) = v-tbl-row no-error.
      923   if not available buf_clob-data then do:
      924     if error-status:error then undo, return error substitute("&1 (get-gate-name) Несуществующий gate &2"
      925                                                             ,vss-include-info1
      926                                                             ,p-gate-rec).
      927   end.
      928   p-gate-file-name = buf_clob-data.file-name.
      929   end procedure.
      930   procedure get-gate-rec :
      931   define input  parameter p-gate-name as character no-undo .
      932   define output parameter p-gate-rec as character no-undo .
      933   define buffer buf_clob-bind for ub.clob-bind.
      934   define buffer buf_clob-data for ub.clob-data.
      935   main-block:
      936   do
      937   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info1, return-value, chr(10), error-status :get-message (1))
      938   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info1 )
      939   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info1 )
      940   :
      941       find first buf_clob-bind no-lock where
      942                 buf_clob-bind.uniq-key-rec = p-gate-name
      943             and buf_clob-bind.field-name = '':U
      944             and buf_clob-bind.part-num = 1
      945             and buf_clob-bind.resource-type = 'gate':U
      946             no-error.
      947       if not available buf_clob-bind then do:
      948         undo, return error substitute("Неверная ссылка на XSD -файл &1 для gate"
      949                                         , p-gate-name
      950                                         ).
      951       end.
      952       find first buf_clob-data no-lock where
      953                 buf_clob-data.db-num = buf_clob-bind.db-num
      954             and buf_clob-data.int64-i= buf_clob-bind.int64-id no-error.
      955       if not available buf_clob-data then do:
      956         undo, return error substitute("Не найден CLOB c ДБ &1 id &2 - файл &3"
      957                                         , buf_clob-bind.db-num
      958                                         , buf_clob-bind.int64-id
      959                                         , p-gate-name
      960                                         ).
      961       end.
      962       run gen-key-rec in this-procedure ( input 'clob-data':U
      963                                 ,input buffer buf_clob-data:handle
      964                                 ,output p-gate-rec).
      965   end.
      966   end procedure.
      967   procedure get-gate-by-name :
      968   define input  parameter p-gate-name as character no-undo .
      969   define output parameter p-gate-rec as character no-undo .
      970   define output parameter p-dsh as handle no-undo .
      971   define input-output  parameter p-xmlh as handle no-undo .
      972   define variable v-ii as integer   no-undo .
      973   define variable glog as logical   no-undo .
      974   define variable v-longchar as longchar no-undo .
      975   define variable v-txmlh as handle no-undo .
      976   define variable v-db-num as integer no-undo .
      977   define variable v-int64-id as int64 no-undo .
      978   define buffer buf_clob-bind for ub.clob-bind.
      979   define buffer buf_clob-data for ub.clob-data.
      980   main-block:
      981   do
      982   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info1, return-value, chr(10), error-status :get-message (1))
      983   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info1 )
      984   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info1 )
      985   :
      986       find first buf_clob-bind no-lock where
      987                 buf_clob-bind.uniq-key-rec = p-gate-name
      988             and buf_clob-bind.field-name = '':U
      989             and buf_clob-bind.part-num = 1
      990             and buf_clob-bind.resource-type = 'gate':U
      991             no-error.
      992       if not available buf_clob-bind then do:
      993         undo, return error substitute("Неверная ссылка на XSD -файл &1 для gate"
      994                                         , p-gate-name
      995                                         ).
      996       end.
      997       find first buf_clob-data no-lock where
      998                 buf_clob-data.db-num = buf_clob-bind.db-num
      999             and buf_clob-data.int64-i= buf_clob-bind.int64-id no-error.
     1000       if not available buf_clob-data then do:
     1001         undo, return error substitute("Не найден CLOB c ДБ &1 id &2 - файл &3"
     1002                                         , buf_clob-bind.db-num
     1003                                         , buf_clob-bind.int64-id
     1004                                         , p-gate-name
     1005                                         ).
     1006       end.
     1007       assign
     1008       v-longchar = buf_clob-data.cdata
     1009       .
     1010       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1011       if error-status :error then do:
     1012         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, buf_clob-data.file-name_, chr(10), error-status:get-message(1) , return-value ).
     1013       end.
     1014       create dataset p-dsh .
     1015       glog = p-dsh:READ-XMLSCHEMA( "LONGCHAR"
     1016                                     , v-longchar
     1017                                     , ?
     1018                                     , ?
     1019                                     , ?
     1020                                     ) no-error.
     1021       v-longchar = '':U.
     1022       if error-status :error
     1023       or not glog
     1024       then do:
     1025         undo, return error substitute("Не удалось прочитать XML-схему &1 из БД:&2&3", p-gate-name, chr(10), error-status:get-message(1) ).
     1026       end.
     1027       if not valid-handle(p-xmlh)
     1028       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     1029         create temp-table v-txmlh.
     1030         v-txmlh:create-like(buffer temp-xml-tables:handle).
     1031         v-txmlh:temp-table-prepare("temp-xml-tables").
     1032         p-xmlh = v-txmlh:default-buffer-handle.
     1033       end.
     1034       run gen-key-rec in this-procedure ( input 'clob-data':U
     1035                                 ,input buffer buf_clob-data:handle
     1036                                 ,output p-gate-rec).
     1037       do v-ii = 1 to p-dsh:num-buffers:
     1038         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     1039         if not p-xmlh:available then do:
     1040           p-xmlh:buffer-create().
     1041           assign
     1042           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     1043           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1044           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1045           p-xmlh::gate-handle_ = p-dsh
     1046           p-xmlh::uniq-gate-rec = p-gate-rec
     1047           p-xmlh::gate-name = p-dsh:name
     1048           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1049           .
     1050           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1051             assign
     1052             p-xmlh::order = -3.
     1053           end.
     1054         end.
     1055       end.
     1056   end.
     1057   end procedure.
     1058   procedure get-gate-by-rec :
     1059   define input  parameter p-gate-rec as character no-undo .
     1060   define output parameter p-dsh as handle no-undo .
     1061   define input-output  parameter p-xmlh as handle no-undo .
     1062   define input-output parameter p-longchar  as longchar no-undo .
     1063   define variable v-ii as integer   no-undo .
     1064   define variable glog as logical   no-undo .
     1065   define variable v-rowid as rowid no-undo .
     1066   define variable v-tbl-name as character no-undo .
     1067   define variable v-longchar as longchar no-undo .
     1068   define variable v-txmlh as handle no-undo .
     1069   define buffer buf_clob-data for ub.clob-data.
     1070   main-block:
     1071   do
     1072   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info1, return-value, chr(10), error-status :get-message (1))
     1073   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info1 )
     1074   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info1 )
     1075   :
     1076     run gen-row-keyr in this-procedure (
     1077                                           input  p-gate-rec
     1078                                           ,input  ?
     1079                                           ,input  "ub"
     1080                                           ,input  ?
     1081                                           ,input  NO-LOCK
     1082                                           ,output v-rowid
     1083                                           ,output v-tbl-name   ) no-error.
     1084       find first buf_clob-data no-lock where
     1085                 rowid(buf_clob-data) = v-rowid  no-error.
     1086       if not available buf_clob-data then do:
     1087         undo, return error substitute("Не найден CLOB  &1"
     1088                                         , p-gate-rec
     1089                                         ).
     1090       end.
     1091       assign
     1092       v-longchar = buf_clob-data.cdata
     1093       .
     1094       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1095       if error-status :error then do:
     1096         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, buf_clob-data.file-name_, chr(10), error-status:get-message(1) , return-value ).
     1097       end.
     1098       create dataset p-dsh .
     1099       glog = p-dsh:READ-XMLSCHEMA( "LONGCHAR"
     1100                                     , v-longchar
     1101                                     , ?
     1102                                     , ?
     1103                                     , ?
     1104                                     ) no-error.
     1105       define variable v-esm as character no-undo .
     1106       v-esm = error-status:get-message(1) .
     1107       if p-longchar <> ? then do:
     1108         p-longchar = v-longchar.
     1109       end.
     1110       v-longchar = '':U.
     1111       if error-status :error
     1112       or not glog
     1113       then do:
     1114         undo, return error substitute("Не удалось прочитать XML-схему &1 (&2) из БД&3&4"
     1115                                      , p-gate-rec
     1116                                      , p-gate-rec
     1117                                      , v-esm
     1118                                      ).
     1119       end.
     1120       p-dsh:private-data = buf_clob-data.file-name_ + chr(4) + p-gate-rec.
     1121       if not valid-handle(p-xmlh)
     1122       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     1123         create temp-table v-txmlh.
     1124         v-txmlh:create-like(buffer temp-xml-tables:handle).
     1125         v-txmlh:temp-table-prepare("temp-xml-tables").
     1126         p-xmlh = v-txmlh:default-buffer-handle.
     1127       end.
     1128       do v-ii = 1 to p-dsh:num-buffers:
     1129         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     1130         if not p-xmlh:available then do:
     1131           p-xmlh:buffer-create().
     1132           assign
     1133           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     1134           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1135           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1136           p-xmlh::gate-handle_ = p-dsh
     1137           p-xmlh::uniq-gate-rec = p-gate-rec
     1138           p-xmlh::gate-name = p-dsh:name
     1139           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1140           .
     1141           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1142             assign
     1143             p-xmlh::order = -3.
     1144           end.
     1145           p-xmlh:buffer-release().
     1146         end.
     1147       end.
     1148   end.
     1149   end procedure.
     1150   procedure get-gate-by-file :
     1151   define input  parameter p-schema-file-name as character no-undo .
     1152   define input  parameter p-gate-rec as character no-undo .
     1153   define output parameter p-dsh as handle no-undo .
     1154   define input-output  parameter p-xmlh as handle no-undo .
     1155   define variable v-ii as integer   no-undo .
     1156   define variable glog as logical   no-undo .
     1157   define variable v-rowid as rowid no-undo .
     1158   define variable v-tbl-name as character no-undo .
     1159   define variable v-longchar as longchar no-undo .
     1160   define variable v-txmlh as handle no-undo .
     1161   main-block:
     1162   do
     1163   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info1, return-value, chr(10), error-status :get-message (1))
     1164   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info1 )
     1165   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info1 )
     1166   :
     1167       COPY-LOB
     1168       FROM  FILE p-schema-file-name
     1169       TO  OBJECT v-longchar
     1170       no-convert
     1171       NO-ERROR .
     1172       if error-status :error then do:
     1173           undo, return error substitute("Не удалось считать файл схемы &1 в память&2&3"
     1174                                     , p-schema-file-name
     1175                                 , chr(10)
     1176                                 , error-status:get-message(1) ).
     1177       end.
     1178       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1179       if error-status :error then do:
     1180         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, p-schema-file-name, chr(10), error-status:get-message(1) , return-value ).
     1181       end.
     1182       create dataset p-dsh .
     1183       glog = p-dsh:READ-XMLSCHEMA( "longchar"
     1184                                     , v-longchar
     1185                                     , ?
     1186                                     , ?
     1187                                     , ?
     1188                                     ) no-error.
     1189       v-longchar = ''.
     1190       if error-status :error
     1191       or not glog
     1192       then do:
     1193         undo, return error substitute("Не удалось прочитать XML-схему из файла &1&2&3"
     1194                                      , p-schema-file-name
     1195                                      ,chr(10)
     1196                                      , error-status:get-message(1)
     1197                                      ).
     1198       end.
     1199       if not valid-handle(p-xmlh)
     1200       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     1201         create temp-table v-txmlh.
     1202         v-txmlh:create-like(buffer temp-xml-tables:handle).
     1203         v-txmlh:temp-table-prepare("temp-xml-tables").
     1204         p-xmlh = v-txmlh:default-buffer-handle.
     1205       end.
     1206       do v-ii = 1 to p-dsh:num-buffers:
     1207         p-xmlh:find-first(substitute(' where tbl-name = "&1" and  uniq-gate-rec = "&2" '
     1208                                      ,p-dsh:get-buffer-handle(v-ii):name
     1209                                      ,p-gate-rec
     1210                                      )) no-error.
     1211         if not p-xmlh:available then do:
     1212           p-xmlh:buffer-create().
     1213           assign
     1214           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):table
     1215           p-xmlh::uniq-gate-rec = p-gate-rec
     1216           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1217           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1218           p-xmlh::gate-handle_ = p-dsh
     1219           p-xmlh::gate-name = p-dsh:name
     1220           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1221           .
     1222           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1223             assign
     1224             p-xmlh::order = -3.
     1225           end.
     1226           p-xmlh:buffer-release().
     1227         end.
     1228       end.
     1229   end.
     1230   end procedure.
     1231   procedure gate-clear :
     1232   define input  parameter p-dsh as handle no-undo .
     1233   define input  parameter p-xmlh as handle no-undo .
     1234   define variable v-dsh as handle no-undo .
     1235   define variable v-th as handle no-undo .
     1236     do
     1237     on error undo, return error return-value
     1238     :
     1239       if valid-handle(p-dsh) then do:
     1240         delete object p-dsh.
     1241         v-dsh = p-dsh.
     1242         p-dsh = ?.
     1243       end.
     1244       repeat while true:
     1245         p-xmlh:find-first( substitute( " where gate-handle_ = &1 ", v-dsh)
     1246                            , share-lock) no-error.
     1247         if p-xmlh:available then do:
     1248           assign
     1249           v-th = p-xmlh:buffer-field("table-handle_"):buffer-value.
     1250           if valid-handle(p-xmlh:buffer-field("table-handle_"))
     1251           and valid-handle(v-th)
     1252           and v-th:dynamic = yes
     1253           then do:
     1254             delete object p-xmlh:buffer-field("table-handle_"):buffer-value.
     1255             p-xmlh:buffer-field("table-handle_"):buffer-value = ?.
     1256           end.
     1257           p-xmlh:buffer-delete().
     1258         end.
     1259         else do:
     1260           leave.
     1261         end.
     1262       end.
     1263       if p-xmlh:dynamic = yes
     1264       and valid-handle(p-xmlh)
     1265       then do:
     1266         delete object p-xmlh:table-handle.
     1267         p-xmlh = ?.
     1268       end.
     1269       v-dsh = ?.
     1270     end.
     1271   end procedure.
     1272   procedure all-gates-clear :
     1273   define parameter buffer buf_temp-xml-tables for temp-xml-tables.
     1274   do
     1275   on error undo, return error
     1276   :
     1277     for each buf_temp-xml-tables
     1278     break
     1279     by buf_temp-xml-tables.uniq-gate-rec
     1280     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1281     on stop   undo , return error substitute( "&1. stop", vss-workfile )
     1282     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     1283     :
     1284         if first-of(buf_temp-xml-tables.uniq-gate-rec) then do:
     1285           delete object buf_temp-xml-tables.gate-handle_.
     1286           buf_temp-xml-tables.gate-handle_ = ?.
     1287         end.
     1288         if valid-handle(buf_temp-xml-tables.table-handle_)
     1289         and buf_temp-xml-tables.table-handle_:dynamic = no
     1290         then do:
     1291           delete object buf_temp-xml-tables.table-handle_.
     1292           buf_temp-xml-tables.table-handle_ = ?.
     1293         end.
     1294         delete buf_temp-xml-tables.
     1295     end.
     1296   end.
     1297   end procedure.
     1298   procedure fix-schemalocation :
     1299   define input-output  parameter p-longchar as longchar no-undo .
     1300   DEFINE VARIABLE hdoc AS HANDLE.
     1301   DEFINE VARIABLE hroot AS HANDLE.
     1302   DEFINE VARIABLE hnode-child AS HANDLE.
     1303   DEFINE VARIABLE hnode-attr AS HANDLE.
     1304   define variable v-jj as integer   no-undo .
     1305   define variable ok as logical   no-undo .
     1306   define variable v-path1                    as character                no-undo .
     1307   DEFINE VARIABLE v-full-path1               as character                no-undo .
     1308   DEFINE VARIABLE v-file-name1               as character                no-undo .
     1309   DEFINE VARIABLE v-file-name-no-ext1        as character                no-undo .
     1310   DEFINE VARIABLE v-file-name-ext1           as character                no-undo .
     1311   define variable v-schema-location          as character                no-undo .
     1312   do
     1313   on error undo, return error return-value
     1314   :
     1315     CREATE X-DOCUMENT hdoc.
     1316     CREATE X-noderef hroot.
     1317     CREATE X-noderef hnode-child.
     1318     CREATE X-noderef hnode-attr.
     1319     hdoc:load("longchar", p-longchar, no) no-error.
     1320     iF ERROR-STATUS:GET-MESSAGE(1) <> '' THEN message ERROR-STATUS:GET-MESSAGE(1) view-as alert-box .
     1321     hdoc:get-document-element(hroot).
     1322     _repeat:
     1323     REPEAT v-jj = 1 TO hroot:NUM-CHILDREN:
     1324       ok = hroot:GET-CHILD(hNode-Child, v-jj).
     1325       if not ok then next.
     1326       if hNode-Child:local-name = "include"
     1327       then do:
     1328         ok = hNode-Child:GET-ATTRIBUTE-NODE( hnode-attr, "schemaLocation" ).
     1329           v-schema-location = hnode-attr:node-value.
     1330           run gbl/filename.p (
     1331                           input "exe/" + hnode-attr:node-value
     1332                         ,output v-full-path1
     1333                         ,output v-path1
     1334                         ,output v-file-name1
     1335                         ,output v-file-name-no-ext1
     1336                         ,output v-file-name-ext1
     1337                         ) no-error .
     1338           if error-status :error then do:
     1339             delete object hnode-attr.
     1340             delete object hnode-child.
     1341             delete object hroot.
     1342             delete object hdoc.
     1343             undo, return error substitute("Не удалось определить расположение схемы &1", v-schema-location).
     1344           end.
     1345         ok = hNode-Child:sET-ATTRIBUTE(  "schemaLocation", v-full-path1 ).
     1346         leave  _repeat.
     1347       end.
     1348     END.
     1349     hdoc:save("longchar", p-longchar).
     1350     delete object hnode-attr.
     1351     delete object hnode-child.
     1352     delete object hroot.
     1353     delete object hdoc.
     1354   end.
     1355   end procedure.
     1356   procedure gate-clb_fill-xml-tables :
     1357   define input parameter p-dsh as handle no-undo .
     1358   define input-output parameter p-xmlh as handle no-undo .
     1359   define variable v-ii as integer no-undo .
     1360     do
     1361     on error undo, return error
     1362     :
     1363       do v-ii = 1 to p-dsh:num-buffers:
     1364         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     1365         if not p-xmlh:available then do:
     1366           p-xmlh:buffer-create().
     1367           assign
     1368           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     1369           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1370           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1371           p-xmlh::gate-handle_ = p-dsh
     1372           p-xmlh::uniq-gate-rec = entry(2, p-dsh:private-data, chr(4))
     1373           p-xmlh::gate-name = p-dsh:name
     1374           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1375           .
     1376           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1377             assign
     1378             p-xmlh::order = -3.
     1379           end.
     1380           p-xmlh:buffer-release().
     1381         end.
     1382       end.
     1383     end.
     1384   end procedure.
     1385   procedure all-gates-empty :
     1386   define buffer buf_temp-xml-tables for temp-xml-tables.
     1387   do
     1388   on error undo, return error
     1389   :
     1390     for each buf_temp-xml-tables
     1391     break
     1392     by buf_temp-xml-tables.uniq-gate-rec
     1393     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1394     on stop   undo , return error substitute( "&1. stop", vss-workfile )
     1395     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     1396     :
     1397       if valid-handle(buf_temp-xml-tables.tbl-handle_) then do:
     1398         buf_temp-xml-tables.tbl-handle_:empty-temp-table().
     1399       end.
     1400     end.
     1401   end.
     1402   end procedure.
     1403   define new global shared variable g#library  as handle no-undo .
     1404   define new global shared variable g#library2 as handle no-undo .
     1405   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1406   function usrfulnf returns character ( input p-user-id as character):
     1407   define variable v-user-name as character no-undo .
     1408   define variable vss-include-info5 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1409   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usrfulnm in g#library
     1410     (input  p-user-id
     1411     ,output v-user-name
     1412     ) no-error .
     1413   if error-status:error
     1414   or v-user-name = ""
     1415   then do:
     1416     return p-user-id.
     1417   end.
     1418   else do:
     1419     return v-user-name.
     1420   end.
     1421   end function.
     1422   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1423   define variable c-point  as character no-undo .
     1424   define variable tbl      as character no-undo .
     1425   define variable join-tbl as character no-undo .
     1426   define variable fld      as character no-undo .
     1427   define variable lab      as character no-undo .
     1428   define variable spr      as character no-undo .
     1429   define variable dim      as character no-undo .
     1430   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1431   procedure fltfield-clear :
     1432     define output parameter loc-fld as character no-undo.
     1433     define output parameter loc-lab as character no-undo .
     1434     define output parameter loc-spr as character no-undo .
     1435     define output parameter loc-dim as character no-undo .
     1436     assign
     1437       loc-fld = ""
     1438       loc-lab = ""
     1439       loc-spr = ""
     1440       loc-dim = "0"
     1441     .
     1442   end procedure .
     1443   procedure fltfield-add :
     1444     define input        parameter par-fld as character no-undo.
     1445     define input        parameter par-lab as character no-undo .
     1446     define input        parameter par-spr as character no-undo .
     1447     define input-output parameter loc-fld as character no-undo.
     1448     define input-output parameter loc-lab as character no-undo .
     1449     define input-output parameter loc-spr as character no-undo .
     1450     define input-output parameter loc-dim as character no-undo .
     1451     do
     1452     on error undo, return error
     1453     :
     1454       assign
     1455       loc-fld = if loc-dim = '0'
     1456                 then par-fld
     1457                 else (loc-fld + chr(44) + par-fld)
     1458       loc-lab = if loc-dim = '0'
     1459                 then par-lab
     1460                 else (loc-lab + chr(44) + par-lab)
     1461       loc-spr = if loc-dim = '0'
     1462                 then par-spr
     1463                 else (loc-spr + chr(44) + par-spr)
     1464       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
     1465                 string(integer(if num-entries(loc-dim) > 1
     1466                               then entry(2, loc-dim)
     1467                               else entry(1, loc-dim)
     1468                               ) + 1)
     1469       no-error
     1470       .
     1471     end.
     1472   end procedure.
     1473   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1474   define variable v-fltopend-rowid as rowid extent 18 no-undo .
     1475   procedure fltopend_fltopend :
     1476   define input parameter p-parent-handle as handle no-undo .
     1477   define input parameter p-qh as handle no-undo .
     1478   define input parameter p-flt-open-open-query  as character no-undo .
     1479   define input parameter p-where-cond as character no-undo .
     1480   define input parameter p-use-indFIRST-query-tail as character no-undo .
     1481   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     1482   define input parameter p-indexed-reposition as character no-undo .
     1483     do
     1484     on error undo, return error
     1485     :
     1486   define variable v-prepare-string as character no-undo .
     1487   define variable glog as logical no-undo .
     1488   assign
     1489   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1490                      p-where-cond + chr(32)  +
     1491                      p-use-indFIRST-query-tail + chr(32) +
     1492                      p-use-ind-sort-clmn-by + chr(32) +
     1493                      p-indexed-reposition
     1494   .
     1495   assign
     1496   glog = p-qh:query-prepare(v-prepare-string) no-error .
     1497   if not glog
     1498   or error-status:error then do:
     1499     message error-status:get-message(1) view-as alert-box .
     1500     undo, return error .
     1501   end.
     1502   assign
     1503   glog = p-qh:query-open no-error .
     1504   if not glog
     1505   or error-status:error then do:
     1506     message error-status:get-message(1) view-as alert-box .
     1507     undo, return error .
     1508   end.
     1509     end.
     1510   end procedure.
     1511   procedure fltopend_fltfindd :
     1512   define input parameter p-parent-handle as handle no-undo .
     1513   define input parameter p-qh as handle no-undo .
     1514   define input parameter p-rowid as rowid no-undo .
     1515   define input parameter p-next as logical no-undo .
     1516   define input parameter p-lock as integer no-undo .
     1517   define input parameter p-bh as handle no-undo .
     1518   define input parameter p-where-cond as character no-undo .
     1519   define input parameter p-use-index-phrase as character no-undo .
     1520   define variable glog as logical no-undo .
     1521   define variable v-qh as handle no-undo .
     1522   define variable v-bh as handle no-undo .
     1523   define variable v-recid as recid no-undo .
     1524   define variable v-prepare-string as character no-undo .
     1525   do
     1526   on error undo, return error
     1527   on stop undo, return error
     1528   :
     1529     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
     1530     create buffer v-bh for table p-bh buffer-name p-bh:name.
     1531     create query v-qh.
     1532     v-qh:set-buffers(v-bh).
     1533     v-prepare-string = substitute("for each &1 &2 &3"
     1534                                     ,v-bh:name
     1535                                     ,p-where-cond
     1536                                     ,p-use-index-phrase).
     1537     glog = v-qh:query-prepare(v-prepare-string) no-error.
     1538     if not glog then do:
     1539       delete object v-qh.
     1540       delete object v-bh.
     1541       undo, return error .
     1542     end.
     1543     glog = v-qh:query-open no-error .
     1544     if not glog then do:
     1545       delete object v-qh.
     1546       delete object v-bh.
     1547       undo, return error .
     1548     end.
     1549     if p-next then do:
     1550       v-qh:reposition-to-rowid(p-rowid) no-error .
     1551       glog = v-qh:get-next( p-lock) no-error .
     1552       glog = v-qh:get-next( p-lock) no-error .
     1553       if not glog or v-qh:query-off-end = yes then do:
     1554         glog = v-qh:get-first( p-lock) no-error .
     1555       end.
     1556     end.
     1557     else do:
     1558       glog = v-qh:get-first( p-lock) no-error .
     1559     end.
     1560     v-recid = v-bh:recid no-error .
     1561     delete object v-qh.
     1562     delete object v-bh.
     1563     return string(v-recid) .
     1564   end.
     1565   end procedure.
     1566   procedure fltopend_fltfindq :
     1567   define input parameter p-parent-handle as handle no-undo .
     1568   define input parameter p-qh as handle no-undo .
     1569   define input parameter p-next as logical no-undo .
     1570   define input parameter p-lock as integer no-undo .
     1571   define input parameter p-flt-open-open-query  as character no-undo .
     1572   define input parameter p-where-cond as character no-undo .
     1573   define input parameter p-use-indFIRST-query-tail as character no-undo .
     1574   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     1575   define input parameter p-indexed-reposition as character no-undo .
     1576   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
     1577   define variable glog as logical no-undo .
     1578   define variable v-qh as handle no-undo .
     1579   define variable v-bh as handle no-undo extent 18.
     1580   define variable v-rowid as rowid no-undo extent 18.
     1581   define variable v-ii as integer no-undo .
     1582   define variable v-prepare-string as character no-undo .
     1583   do
     1584   on error undo, return error
     1585   on stop undo, return error
     1586   :
     1587     create query v-qh.
     1588     do v-ii = 1 to p-qh:num-buffers:
     1589       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
     1590       assign
     1591       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
     1592       no-error.
     1593       v-qh:add-buffer(v-bh[v-ii]).
     1594     end.
     1595     assign
     1596     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1597                       p-where-cond + chr(32)  +
     1598                       p-use-indFIRST-query-tail + chr(32) +
     1599                       p-use-ind-sort-clmn-by + chr(32) +
     1600                       p-indexed-reposition
     1601     .
     1602     glog = v-qh:query-prepare( v-prepare-string) no-error .
     1603     if not glog then do:
     1604       delete object v-qh.
     1605       do v-ii = 1 to p-qh:num-buffers:
     1606         delete object v-bh[v-ii].
     1607       end.
     1608       undo, return error .
     1609     end.
     1610     glog = v-qh:query-open no-error .
     1611     if not glog then do:
     1612       delete object v-qh.
     1613       do v-ii = 1 to p-qh:num-buffers:
     1614         delete object v-bh[v-ii].
     1615       end.
     1616       undo, return error .
     1617     end.
     1618     if p-next then do:
     1619       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
     1620       glog = v-qh:get-next( p-lock) no-error .
     1621       glog = v-qh:get-next( p-lock) no-error .
     1622       if not glog or v-qh:query-off-end = yes then do:
     1623         glog = v-qh:get-first( p-lock) no-error .
     1624       end.
     1625     end.
     1626     else do:
     1627       glog = v-qh:get-first( p-lock) no-error .
     1628     end.
     1629     do v-ii = 1 to p-qh:num-buffers:
     1630       assign
     1631       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     1632       no-error.
     1633     end.
     1634     delete object v-qh.
     1635     do v-ii = 1 to p-qh:num-buffers:
     1636       delete object v-bh[v-ii].
     1637     end.
     1638   end.
     1639   end procedure.
     1640   define variable v-recid            as recid     no-undo .
     1641   define variable v-title0           as character no-undo .
     1642   define variable v-sort-column-name as character no-undo .
     1643   define variable v-filter-pointr    as character no-undo init "Маршрутизация СПН" .
     1644   define variable v-filter-point0    as character no-undo init "v-route" .
     1645   define variable v-filter-point     as character no-undo .
     1646   FUNCTION conv-pck-num returns character
     1647     ( input p-pack-num as integer )  FORWARD.
     1648   FUNCTION get-descr-route returns character
     1649     ( input p-name-rec as character, input p-uniq-key-rec as character )  FORWARD.
     1650   FUNCTION get-gate-file-name-f returns character
     1651     ( p-gate-rec as character )  FORWARD.
     1652   DEFINE BUTTON b-help DEFAULT
     1653        LABEL "Помо&щь"
     1654        SIZE 3 BY 1
     1655        BGCOLOR 8 .
     1656   DEFINE BUTTON b-quit AUTO-END-KEY DEFAULT
     1657        LABEL "&Выход"
     1658        SIZE 10 BY 1
     1659        BGCOLOR 8 .
     1660   DEFINE BUTTON b-sch
     1661        LABEL "&Фильтр"
     1662        SIZE 3 BY 1.
     1663   DEFINE QUERY br-route FOR
     1664         X_route SCROLLING.
     1665   DEFINE BROWSE br-route
     1666     QUERY br-route NO-LOCK DISPLAY
     1667         conv-pck-num( X_route.last-pack ) FORMAT "X(10)" column-label "Пакет"
     1668   get-descr-route( X_route.name-rec, X_route.uniq-key-rec ) WIDTH 70 format "X(255)" column-label "Описание"
     1669   X_route.name-rec format "X(255)"
     1670   X_route.uniq-key-rec format "X(255)"
     1671   X_route.CreUserName column-label "Создал" format "X(255)"
     1672   usrfulnf(X_route.CreUserName) column-label "Создал" FORMAT "x(18)":U
     1673   X_route.CreDate
     1674   X_route.CreTime
     1675   X_route.uniq-gate-rec format "X(255)" column-label "Гейт"
     1676   get-gate-file-name-f(X_route.uniq-gate-rec) format "X(32)" column-label "Имя Гейта"
     1677   X_route.dump-ord
     1678       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 19.75.
     1679   DEFINE FRAME v-route
     1680        b-quit AT ROW 1 COL 1
     1681        b-sch AT ROW 1 COL 92.5 WIDGET-ID 2
     1682        b-help AT ROW 1 COL 95.5
     1683        br-route AT ROW 2.25 COL 1
     1684        SPACE(0.12) SKIP(0.24)
     1685       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1686            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1687            TITLE "Просмотр маршрутизации"
     1688            CANCEL-BUTTON b-quit.
     1689   ASSIGN
     1690          FRAME v-route:SCROLLABLE       = FALSE
     1691          FRAME v-route:HIDDEN           = TRUE.
     1692   ON WINDOW-CLOSE OF FRAME v-route
     1693   DO:
     1694     APPLY "END-ERROR":U TO SELF.
     1695   END.
     1696   ON CHOOSE OF b-sch IN FRAME v-route
     1697   DO:
     1698     RUN proc-b-sch IN this-procedure NO-ERROR.
     1699   END.
     1700   ON VALUE-CHANGED OF br-route IN FRAME v-route
     1701   DO:
     1702   END.
     1703   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1704   on help of frame v-route
     1705   do:
     1706     run gbl/app_help.p
     1707       (input this-procedure :file-name
     1708       ,input ''
     1709       ,input ?
     1710       ) no-error.
     1711     if error-status :error then do:
     1712       message
     1713         "Ошибка при вызове помощи"
     1714         error-status :get-message(1)
     1715         view-as alert-box .
     1716     end.
     1717   end.
     1718   run minbtn-set in this-procedure .
     1719   on choose of b-help in frame v-route
     1720   do:
     1721     apply "help":u to frame v-route .
     1722   end.
     1723   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1724   procedure minbtn-set :
     1725       do
     1726           on error undo, return error return-value
     1727           :
     1728           define variable ii              as integer       no-undo .
     1729           define variable fh              as widget-handle no-undo .
     1730           define variable hh              as widget-handle no-undo .
     1731           define variable v-h             as handle        extent 4 no-undo .
     1732           define variable v-name-button   as character     no-undo .
     1733           define variable v-help-old-x    as decimal       no-undo .
     1734           define variable v-help-old-y    as decimal       no-undo .
     1735           define variable v-help-old-size as decimal       no-undo .
     1736           define variable v-frame-width   as decimal       no-undo .
     1737           define variable jj              as integer       no-undo .
     1738           do
     1739               on error undo, return error
     1740               :
     1741               assign
     1742                   v-frame-width = frame v-route:width - 0.3
     1743                   fh            = frame v-route:first-child
     1744                   hh            = fh:first-child
     1745                   ii            = 1
     1746                   .
     1747               do while valid-handle(hh):
     1748                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1749                   do:
     1750                       case lc(hh:name) :
     1751                           when "b-help" then
     1752                               do:
     1753                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1754                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1755                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1756                                   hh:TOOLTIP = "Помощь" .
     1757                                   v-help-old-x = hh:column .
     1758                                   v-help-old-y = hh:row    .
     1759                                   v-help-old-size = hh:width .
     1760                                   hh:width-chars = 2.5 .
     1761                               end.
     1762                           when "b-print" then
     1763                               do:
     1764                                   hh:load-image("cmp/b-print.bmp":u) .
     1765                                   hh:TOOLTIP = "Печать" .
     1766                                   v-h[ii] = hh:handle .
     1767                                   ii = ii + 1 .
     1768                                   hh:width-chars = 3 .
     1769                               end.
     1770                           when "b-history" or
     1771                           when "b-hist" then
     1772                               do:
     1773                                   hh:load-image("cmp/b-hist.bmp":u) .
     1774                                   hh:TOOLTIP = "История" .
     1775                                   v-h[ii] = hh:handle .
     1776                                   ii = ii + 1 .
     1777                                   hh:width-chars = 3 .
     1778                               end.
     1779                           when "b-sch" then
     1780                               do:
     1781                                   hh:load-image("cmp/b-sch.bmp":u) .
     1782                                   hh:TOOLTIP = "Установка Фильтра" .
     1783                                   v-h[ii] = hh:handle .
     1784                                   ii = ii + 1 .
     1785                                   hh:width-chars = 3 .
     1786                               end.
     1787                           when "b-hist-user" then
     1788                               do:
     1789                                   hh:load-image("cmp/b-hist.bmp":u) .
     1790                                   hh:TOOLTIP = "История пользователя" .
     1791                                   ii = ii + 1 .
     1792                               end.
     1793                       end case.
     1794                   end.
     1795                   hh = hh:next-sibling.
     1796               end.
     1797               b-help:column = v-frame-width - b-help:width-chars.
     1798               jj = 0.
     1799               repeat ii = 4 to 1 by -1 :
     1800                   if valid-handle (v-h[ii] ) then
     1801                   do:
     1802                       jj  = jj + 1 .
     1803                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1804                       v-h[ii]:row    = v-help-old-y .
     1805                   end.
     1806               end.
     1807           end.
     1808       end.
     1809   end procedure.
     1810   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1811   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1812   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1813   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1814   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1815   define variable v-diasize-current-frame-height as decimal   no-undo .
     1816   define variable v-diasize-change-size          as logical   no-undo .
     1817   define variable v-diasize-resize-button        as handle    no-undo .
     1818   define variable v-diasize-wndmax               as logical   no-undo .
     1819   define variable v-diasize-wndstore             as logical   no-undo .
     1820   define variable v-diasize-proc-name            as character no-undo .
     1821   define variable v-diasize-browse-handle        as handle    no-undo .
     1822   define variable v-diasize-browse-number        as integer   no-undo .
     1823   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1824   define temp-table temp-diasize-handle no-undo
     1825     field handle-value  as handle
     1826     field save-position as decimal
     1827     index xpk is primary unique handle-value
     1828     .
     1829   define temp-table temp-browse-handle no-undo
     1830     field browse-type   as character
     1831     field browse-number as integer
     1832     field browse-handle as handle
     1833     field original-size as decimal
     1834     index xpk is primary unique browse-type browse-number
     1835     index xie browse-type browse-handle
     1836   .
     1837   procedure diasize_change-height :
     1838     define input  parameter p-change-value  as decimal   no-undo .
     1839     define input  parameter p-move-resize   as logical   no-undo .
     1840     define variable v-field-group-handle    as handle    no-undo .
     1841     define variable v-object-handle         as handle    no-undo .
     1842     define variable v-frame-height          as decimal   no-undo .
     1843     define variable v-frame-virtual-height  as decimal   no-undo .
     1844     define variable v-browse-height         as decimal   no-undo .
     1845     define variable v-window-height         as decimal   no-undo .
     1846     define variable v-window-virtual-height as decimal   no-undo .
     1847     define variable v-change-sign           as integer   no-undo .
     1848     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1849     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1850     if p-change-value > 0
     1851     then do:
     1852       if frame v-route :height + p-change-value
     1853           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1854       then do:
     1855         assign
     1856           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1857                           - (frame v-route :height-chars)
     1858         .
     1859         if p-change-value <= 0
     1860         then do:
     1861           run diasize_position-resize-button in this-procedure .
     1862           return .
     1863         end.
     1864       end.
     1865     end.
     1866     if p-change-value < 0
     1867     then do:
     1868       if frame v-route :height + p-change-value < v-diasize-orig-frame-height
     1869       then do:
     1870         assign
     1871           p-change-value = v-diasize-orig-frame-height
     1872                          - (frame v-route :height-chars)
     1873         .
     1874         if p-change-value >= 0
     1875         then do:
     1876           run diasize_position-resize-button in this-procedure .
     1877           return .
     1878         end.
     1879       end.
     1880     end.
     1881     if p-change-value >= 0
     1882     then do:
     1883       assign
     1884         v-change-sign = 1
     1885       .
     1886     end.
     1887     else do:
     1888       assign
     1889         v-change-sign = -1
     1890       .
     1891     end.
     1892     assign
     1893       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1894     .
     1895     if p-change-value = 0
     1896     then do:
     1897       run diasize_position-resize-button in this-procedure .
     1898       return .
     1899     end.
     1900     move_block:
     1901     do
     1902     on error undo move_block, retry move_block
     1903     :
     1904       if retry
     1905       then do:
     1906         do
     1907         on error undo move_block, leave move_block
     1908         :
     1909           if p-change-value > 0
     1910           then do:
     1911             for each buf_temp-diasize-handle
     1912             on error undo, next
     1913             :
     1914               assign
     1915                 v-object-handle = buf_temp-diasize-handle.handle-value
     1916               .
     1917               if v-object-handle <> v-diasize-resize-button
     1918               then do:
     1919                 assign
     1920                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1921                 .
     1922               end.
     1923             end.
     1924             assign
     1925               v-diasize-browse-handle :height = v-browse-height
     1926             .
     1927             for each buf_temp-browse-handle
     1928               where buf_temp-browse-handle.browse-type = 'height':u
     1929             on error undo, next
     1930             :
     1931               assign
     1932                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1933               .
     1934             end.
     1935             assign
     1936               frame v-route :height = v-frame-height
     1937             .
     1938             if frame v-route :scrollable = true
     1939             then do:
     1940               assign
     1941                 frame v-route :virtual-height = v-frame-virtual-height
     1942               .
     1943             end.
     1944             run diasize_position-resize-button in this-procedure .
