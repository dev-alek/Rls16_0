        1   block-level on error undo, throw.
        2   define input  parameter parparentproc   as   widget-handle        no-undo .
        3   define input  parameter p-action        as   character            no-undo .
        4   define input  parameter p-db-num        like ub.db.db-num         no-undo .
        5   define input  parameter p-pack-num      like ub.pck-sent.pack-num no-undo.
        6   def var vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        7   def var vss-author      as character no-undo init "$Author: expertek $":U .
        8   def var vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        9   def var vss-workfile    as character no-undo init "$Workfile: send-nws.p $":U .
       10   def var vss-archive     as character no-undo init "$Archive: nws/send-nws.p $":U .
       11   def var vss-description as character no-undo init "Отправка новостей в указанную БД".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define new global shared variable g#library  as handle no-undo .
       71   define new global shared variable g#library2 as handle no-undo .
       72   define   shared variable g#auto as logical no-undo.
       73   define   shared variable g#news as logical no-undo.
       74   define   shared variable g#oxml as logical no-undo.
       75   define   shared variable g#esys as logical no-undo.
       76   define   shared variable g#news-source-db as integer no-undo.
       77   define   shared variable g#esys-source-esys as integer no-undo.
       78   define   shared variable g#db-num as integer   no-undo .
       79   define   shared variable g#userid as character no-undo .
       80   define   shared variable g#passwd as character no-undo .
       81   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       82   define  shared variable g#auto-pid           as integer   no-undo .
       83   define  shared variable conn-par             as character no-undo .
       84   define  shared variable g#auto-user-id       as character no-undo .
       85   define  shared variable g#auto-user-login    as character no-undo .
       86   define  shared variable g#auto-user-password as character no-undo .
       87   define  shared variable v-socket             as logical   no-undo .
       88   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       89   define  shared variable auto-window-h     as handle    no-undo .
       90   define  shared variable auto-log-msg-h    as handle    no-undo .
       91   define  shared variable hand-log-msg-h    as handle    no-undo .
       92   define  shared variable log-file-name     as character no-undo initial ? .
       93   define  shared variable add-log-file-name as character no-undo initial ? .
       94   define  shared variable writelogvalue     as character no-undo initial ? .
       95   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       96   procedure cur-time :
       97      define output parameter p-today as date      no-undo .
       98      define output parameter p-time  as integer   no-undo .
       99     do
      100     on error undo, return error
      101     :
      102       define variable v-date1 as date      no-undo .
      103       define variable v-date2 as date      no-undo .
      104       define variable v-time  as integer   no-undo .
      105       assign
      106         v-date1 = today
      107         v-time  = time
      108         v-date2 = today
      109       .
      110       if v-date1 <> v-date2
      111       then do:
      112         assign
      113           v-date1 = today
      114           v-time  = v-time
      115         .
      116       end.
      117       assign
      118         p-today = v-date1
      119         p-time  = v-time
      120       .
      121     end.
      122   end.
      123   function cur-time-date returns character
      124   :
      125     return string(today, '99/99/9999':U) .
      126   end.
      127   function cur-time-mjd returns decimal
      128   :
      129     define variable v-date as date      no-undo .
      130     define variable v-time as integer   no-undo .
      131     run cur-time in this-procedure
      132       (output v-date
      133       ,output v-time
      134       ) .
      135     return integer(v-date) - 2400002 + (v-time / 86400) .
      136   end.
      137   function cur-time-get-ending-index returns integer
      138   (input p-number as integer
      139   )
      140   :
      141     if p-number < 0
      142     or p-number = ?
      143     then do:
      144       return 1 .
      145     end.
      146     define variable v-rest as integer   no-undo .
      147     assign
      148       p-number = p-number modulo 100
      149     .
      150     if p-number < 20
      151     then do:
      152       assign
      153         v-rest = p-number
      154       .
      155     end.
      156     else do:
      157       assign
      158         v-rest = p-number modulo 10
      159       .
      160     end.
      161     case v-rest :
      162       when 1
      163       then do:
      164         return 2 .
      165       end.
      166       when 2 or
      167       when 3 or
      168       when 4
      169       then do:
      170         return 3 .
      171       end.
      172       otherwise do:
      173         return 1 .
      174       end.
      175     end case .
      176   end.
      177   procedure cur-time-mjd-to-date :
      178      define input  parameter i-mjd-diff as decimal no-undo.
      179      define output parameter o-Date     as date    no-undo.
      180      define output parameter o-Time     as integer no-undo.
      181      define variable v-day-number as integer   no-undo .
      182      if    i-mjd-diff < 0
      183         or i-mjd-diff = ?
      184      then do:
      185         return "?" .
      186      end.
      187      assign
      188         v-day-number = truncate(i-mjd-diff,0).
      189         o-Date = date(v-day-number + 2400002).
      190         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      191     .
      192   end.
      193   function cur-time-mjd-to-string returns character
      194   (input p-mjd-diff as decimal
      195   )
      196   :
      197     define variable v-day-number as integer   no-undo .
      198     define variable v-seconds    as integer   no-undo .
      199     define variable v-hour       as integer   no-undo .
      200     define variable v-min        as integer   no-undo .
      201     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      202     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      203     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      204     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      205     if p-mjd-diff < 0
      206     or p-mjd-diff = ?
      207     then do:
      208       return "?" .
      209     end.
      210     assign
      211       v-day-number = integer(truncate(p-mjd-diff,0))
      212       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      213     .
      214     if v-seconds > 86400
      215     then do:
      216       assign
      217         v-seconds = 86400 - 1
      218       .
      219     end.
      220     if v-seconds < 0
      221     then do:
      222       assign
      223         v-seconds = 0
      224       .
      225     end.
      226     assign
      227       v-hour = truncate(v-seconds / 3600, 0)
      228     .
      229     assign
      230       v-seconds = v-seconds modulo 3600
      231     .
      232     assign
      233       v-min = truncate(v-seconds / 60, 0)
      234     .
      235     assign
      236       v-seconds = v-seconds modulo 60
      237     .
      238     return
      239         (if v-day-number <> 0
      240           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      241           else ""
      242         )
      243       + (if v-day-number <> 0 or v-hour <> 0
      244           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      245           else ""
      246         )
      247       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      248           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      249           else ""
      250         )
      251       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      252       .
      253   end.
      254   function cur-time-string returns character
      255   :
      256     define variable v-date as date      no-undo .
      257     define variable v-time as integer   no-undo .
      258     run cur-time in this-procedure
      259       (output v-date
      260       ,output v-time
      261       ) .
      262     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      263   end.
      264   function cur-time-string-sec returns character
      265   :
      266     define variable v-date as date      no-undo .
      267     define variable v-time as integer   no-undo .
      268     run cur-time in this-procedure
      269       (output v-date
      270       ,output v-time
      271       ) .
      272     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      273   end.
      274   function cur-time-custom  returns character
      275   (input p-prefix as character
      276   ,input p-date-format as character
      277   ,input p-delimiter as character
      278   ,input p-time-format as character
      279   ,input p-suffix as character
      280   )
      281   :
      282     define variable v-date as date      no-undo .
      283     define variable v-time as integer   no-undo .
      284     run cur-time in this-procedure
      285       (output v-date
      286       ,output v-time
      287       ) .
      288     return
      289       p-prefix
      290       + string(v-date, p-date-format)
      291       + p-delimiter
      292       + string(v-time, p-time-format)
      293       + p-suffix
      294       .
      295   end.
      296   function cur-time-print  returns character
      297   :
      298     define variable v-date as date      no-undo .
      299     define variable v-time as integer   no-undo .
      300     run cur-time in this-procedure
      301       (output v-date
      302       ,output v-time
      303       ) .
      304     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      305   end.
      306   function cur-time-datetime returns datetime
      307   :
      308     define variable v-char as character no-undo .
      309     define variable v-datetime as datetime no-undo .
      310     v-char = cur-time-string().
      311     v-datetime = datetime(v-char).
      312     return  v-datetime.
      313   end.
      314   function cur-time-string-msec returns character
      315   :
      316     define variable v-date as datetime  no-undo .
      317     v-date = now.
      318     return string(v-date) .
      319   end.
      320   define stream LogStream .
      321   define variable mNoTime as logical no-undo.
      322   procedure write-to-log-notime :
      323     define input param i-str as character no-undo .
      324     mNoTime = yes.
      325     run write-to-log (i-str).
      326     mNoTime = no.
      327   end.
      328   procedure write-to-log :
      329     define input param p-str as character no-undo .
      330     do
      331     on error  undo, return error substitute( "&1 (write-to-log). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      332     on stop   undo, return error substitute( "&1 (write-to-log). stop", vss-workfile )
      333     on endkey undo, return error substitute( "&1 (write-to-log). endkey", vss-workfile )
      334     :
      335       define variable log-res        as logical   no-undo .
      336       define variable v-jj           as integer   no-undo .
      337       if    mNoTime
      338          or writelogvalue eq "AsyncProc"
      339       then
      340          p-str = substitute( "&1 (pid: &2) &3&4"   , g#auto-user-id, g#auto-pid,                        p-str, chr(10) ).
      341       else
      342          p-str = substitute( "&1 (pid: &2) &3 &4&5", g#auto-user-id, g#auto-pid, cur-time-string-sec(), p-str, chr(10) ).
      343       if auto-log-msg-h <> ? then do:
      344         log-res = auto-log-msg-h:move-to-eof( ) .
      345         log-res = auto-log-msg-h:insert-string( p-str ).
      346       end.
      347       if hand-log-msg-h <> ? then do:
      348         log-res = hand-log-msg-h:move-to-eof( ) .
      349         log-res = hand-log-msg-h:insert-string( p-str ).
      350       end.
      351       assign
      352         p-str = replace(p-str, (chr(10) + chr(13)), chr(10) )
      353         p-str = replace(p-str, (chr(13) + chr(10)), chr(10) )
      354         p-str = replace(p-str, chr(10), (chr(13) + chr(10)) )
      355       .
      356       if add-log-file-name <> ? then do:
      357         do v-jj = 1 to num-entries(add-log-file-name, chr(1)):
      358           run gbl/fileapnd.p
      359             ( input entry(v-jj, add-log-file-name, chr(1) )
      360             ,input p-str
      361             ,input 20
      362             ) no-error .
      363           if error-status:error then do:
      364             return error return-value .
      365           end.
      366         end.
      367       end.
      368       if writelogvalue eq "AsyncProc"
      369       then do:
      370          p-str = trim(p-str, (chr(13) + chr(10)) )
      371       .
      372          Publish "WriteLogAsunc" (p-str,yes).
      373       end.
      374       else if writelogvalue <> "yes" then do:
      375         run gbl/fileapnd.p
      376           ( input log-file-name
      377           ,input p-str
      378           ,input 20
      379           ) no-error .
      380         if error-status:error then do:
      381           return error return-value .
      382         end.
      383       end.
      384     end.
      385   end procedure.
      386   procedure write-to-screen :
      387     define input param p-str as character no-undo .
      388     do
      389     on error  undo, return error substitute( "&1 (write-to-screen). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      390     on stop   undo, return error substitute( "&1 (write-to-screen). stop", vss-workfile )
      391     on endkey undo, return error substitute( "&1 (write-to-screen). endkey", vss-workfile )
      392     :
      393       define variable log-res as logical no-undo.
      394       assign
      395         p-str = substitute( "&1 (pid: &2) &3 &4&5", g#auto-user-id, g#auto-pid, cur-time-string-sec(), p-str, chr(10) )
      396       .
      397       if auto-log-msg-h <> ?
      398       then do:
      399         log-res = auto-log-msg-h:move-to-eof( ) .
      400         log-res = auto-log-msg-h:insert-string( p-str ).
      401       end.
      402       if hand-log-msg-h <> ?
      403       then do:
      404         log-res = hand-log-msg-h:move-to-eof( ) .
      405         log-res = hand-log-msg-h:insert-string( p-str ).
      406       end.
      407     end.
      408   end procedure.
      409   procedure send-msg-to-email :
      410     define input  parameter p-subject      as character no-undo .
      411     define input  parameter p-text-err     as character no-undo .
      412     define input  parameter p-attach-files as character no-undo .
      413     do
      414     on error  undo, return error substitute( "&1 (send-msg-to-email). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      415     on stop   undo, return error substitute( "&1 (send-msg-to-email). stop", vss-workfile )
      416     on endkey undo, return error substitute( "&1 (send-msg-to-email). endkey", vss-workfile )
      417     :
      418       define variable v-tth             as handle    no-undo .
      419       define variable v-value-character as character no-undo .
      420       define variable v-value-date      as date      no-undo .
      421       define variable v-value-decimal   as decimal   no-undo .
      422       define variable v-value-integer   as integer   no-undo .
      423       define variable v-value-logical   as logical   no-undo .
      424       define variable v-param-type      as character no-undo .
      425       define variable v-email       as character no-undo .
      426       define variable v-tmp-str     as character no-undo .
      427       define variable v-tmp1-str    as character no-undo .
      428       define variable v-ind         as integer   no-undo .
      429       define variable v-num-entries as integer   no-undo .
      430       delete object v-tth no-error.
      431       run adm/shattri.p
      432         ( input "get":U
      433          ,input  "":U
      434          ,input  0
      435          ,input  'auto-task':U
      436          ,input  'send-msg-to-email':U
      437          ,output v-value-character
      438          ,output v-value-date
      439          ,output v-value-decimal
      440          ,output v-value-integer
      441          ,output v-value-logical
      442          ,output v-param-type
      443          ,input-output table-handle v-tth
      444         ) no-error .
      445       if not error-status :error  then do:
      446         assign
      447           v-tmp-str = v-value-character
      448         .
      449       end.
      450       delete object v-tth no-error.
      451       assign
      452         v-tmp-str     = replace(v-tmp-str, (chr(10) + chr(13)), chr(44) )
      453         v-tmp-str     = replace(v-tmp-str, (chr(13) + chr(10)), chr(44) )
      454         v-tmp-str     = replace(v-tmp-str, chr(10), chr(44) )
      455         v-num-entries = num-entries( v-tmp-str, chr(44) )
      456         v-email       = "":U
      457       .
      458       do v-ind = 1 to v-num-entries
      459       :
      460         assign
      461           v-tmp1-str = entry( v-ind, v-tmp-str, chr(44) )
      462         .
      463         if trim( v-tmp1-str ) <> "":U then do:
      464           if v-email = "":U then do:
      465             assign
      466               v-email = v-tmp1-str
      467             .
      468           end.
      469           else do:
      470             assign
      471               v-email = v-email + chr(44) + v-tmp1-str
      472             .
      473           end.
      474         end.
      475       end.
      476       if v-email <> "":U then do:
      477         run gbl/sendmail.p
      478           ( input v-email
      479           , input p-subject
      480           , input p-text-err
      481           , input p-attach-files
      482           ) no-error .
      483         if error-status :error
      484           or return-value <> "":U
      485         then do:
      486           return error substitute( "&1 (send-msg-to-email). &2", vss-workfile, return-value ) .
      487         end.
      488       end.
      489     end.
      490   end procedure.
      491   define  shared variable nws-exch-dir as character no-undo .
      492   define  shared variable nws-heap-dir as character no-undo .
      493   define variable err-mess as character no-undo .
      494   define temp-table t-pck-conf no-undo
      495     field db-num-dst      as integer
      496     field db-num-src      as integer
      497     field pack-num        as integer
      498     field total-recs      as integer
      499     field sys-key         as character
      500     field src_db-key      as character
      501     field dst_db-key      as character
      502     field ver-num         as character
      503     field prev-crc        as character
      504     field actual-date     as date
      505     field actual-time-int as integer
      506   .
      507   do
      508   on error undo, return error
      509   :
      510     define buffer buf-dst_db   for ub.db .
      511     define buffer buf-src_db   for ub.db .
      512     define buffer buf_sys-ctrl for ub.sys-ctrl .
      513     define buffer buf_pck-sent for ub.pck-sent.
      514     define buffer buf_route    for ub.route .
      515     define variable v-ver-num      as character no-undo .
      516     define variable v-pack-num     as integer   no-undo .
      517     define variable v-pack-name    as character no-undo .
      518     define variable v-source-dir   as character no-undo .
      519     define variable v-target-dir   as character no-undo .
      520     define variable v-temp-dir     as character no-undo .
      521     define variable v-err-gen-pack as integer   no-undo .
      522     define variable v-ind          as integer   no-undo .
      523     define variable v-max-p-queue  as integer   no-undo .
      524     define variable v-max-p-time   as integer   no-undo .
      525     define variable v-err-msg      as character no-undo .
      526     define variable v-send-1       as logical no-undo initial false.
      527     define variable v-sent-count   as integer no-undo initial 0.
      528     define temp-table t-list-pack no-undo
      529       field pack-num    like ub.pck-sent.pack-num
      530       field re-gen-time as   logical                 initial false
      531       field SendTxtDate like ub.pck-sent.SendTxtDate initial ?
      532       index pi is unique primary pack-num ascending
      533       index iregen re-gen-time SendTxtDate
      534     .
      535     define variable v-today        as date      no-undo .
      536     define variable v-time         as integer   no-undo .
      537     define variable v-time-wait    as integer   no-undo .
      538     find first buf_sys-ctrl no-lock .
      539     run get-version-num in parparentproc
      540       ( output v-ver-num
      541       ).
      542     find first buf-src_db no-lock
      543       where buf-src_db.db-num = buf_sys-ctrl.db-num
      544       no-error
      545     .
      546     if not available buf-src_db then do:
      547       run write-to-log( substitute( "&1. БД &2 не найдена", vss-workfile, buf_sys-ctrl.db-num ) ) .
      548       return error.
      549     end.
      550     find first buf-dst_db no-lock
      551       where buf-dst_db.db-num = p-db-num
      552       no-error
      553     .
      554     if not available buf-dst_db then do:
      555       run write-to-log( substitute( "&1. БД &2 не найдена", vss-workfile, p-db-num ) ) .
      556       return error.
      557     end.
      558     if buf_sys-ctrl.db-num = 0 then do:
      559       assign
      560         v-max-p-queue = buf-dst_db.max-p-queue
      561         v-max-p-time  = buf-dst_db.max-p-time
      562       .
      563     end.
      564     else do:
      565       assign
      566         v-max-p-queue = buf-src_db.max-p-queue
      567         v-max-p-time  = buf-src_db.max-p-time
      568       .
      569     end.
      570      if buf-dst_db.max-p-queue = 0 and p-db-num > 0  then do:
      571         run write-to-log( substitute( "Отправка в БД &1 отключена ", p-db-num ) ) .
      572         return .
      573      end.
      574      if buf-dst_db.max-p-queue = -1 then do:
      575       v-send-1 = true.
      576      end.
      577     case p-action:
      578       when "one-pack":U then do:
      579         run write-to-log( substitute("Отправка одного пакета новостей в БД &1", p-db-num ) ) .
      580       end.
      581       when "all-unconf":U then do:
      582         run write-to-log( substitute("Отправка всех неподтвержденных пакетов новостей в БД &1", p-db-num ) ) .
      583       end.
      584       when "all":U then do:
      585         run write-to-log( substitute("Отправка новостей в БД &1", p-db-num ) ) .
      586       end.
      587       otherwise do:
      588         message vss-workfile vss-revision vss-description skip
      589                 substitute( "Не предусмотрена операция &1", p-action )
      590                 view-as alert-box error.
      591         return error.
      592       end.
      593     end case.
      594     assign
      595       g#news-source-db = -1
      596     .
      597     run nws/lock-nws.p
      598       ( input p-db-num
      599        ,buffer buf-dst_db
      600       ) no-error.
      601     if error-status:error then do:
      602       run write-to-log( substitute( "&1. &2", vss-workfile, return-value ) ).
      603       return .
      604     end.
      605     assign
      606       v-err-gen-pack = 0
      607     .
      608     for each t-list-pack
      609     on error undo, return error
      610     :
      611       delete t-list-pack .
      612     end.
      613     if p-action = "one-pack":U then do:
      614       create t-list-pack .
      615       assign
      616         t-list-pack.pack-num = p-pack-num
      617       .
      618     end.
      619     else do:
      620       run cur-time in this-procedure
      621         ( output v-today
      622          ,output v-time
      623         ) no-error .
      624       if error-status :error then do:
      625         run write-to-log( substitute( "&1. Ошибка при определении текущего времени. &2&3&2&4", vss-workfile, chr(10), error-status :get-message(1) , return-value )
      626                         ) .
      627         return error.
      628       end.
      629       assign
      630         v-time-wait    = -1
      631       .
      632       for each buf_pck-sent no-lock
      633         where buf_pck-sent.db-num = p-db-num
      634           and buf_pck-sent.rcvd = no
      635       on error undo, leave
      636       :
      637         find first t-list-pack no-lock
      638           where t-list-pack.pack-num = buf_pck-sent.pack-num
      639           no-error
      640         .
      641         if not available t-list-pack then do:
      642           create t-list-pack .
      643           assign
      644             t-list-pack.pack-num    = buf_pck-sent.pack-num
      645             t-list-pack.SendTxtDate = buf_pck-sent.SendTxtDate
      646             v-ind = v-ind + 1
      647           .
      648         end.
      649         if v-max-p-time <> 0
      650           and buf_pck-sent.SendTxtDate <> ?
      651           and buf_pck-sent.SendTxtTimeInt <> 0
      652           and ( buf_pck-sent.SendTxtDate < v-today
      653                 or ( buf_pck-sent.SendTxtDate = v-today
      654                      and buf_pck-sent.SendTxtTimeInt <= v-time
      655                    )
      656               )
      657         then do:
      658           assign
      659             v-time-wait = ( v-today - buf_pck-sent.SendTxtDate ) * 24 * 60 * 60
      660                           + ( v-time - buf_pck-sent.SendTxtTimeInt )
      661           .
      662         end.
      663         if v-time-wait >= v-max-p-time * 60 then do:
      664           assign
      665             t-list-pack.re-gen-time = true
      666           .
      667         end.
      668       end.
      669       if p-action = "all":U
      670          and v-send-1 = false
      671          and v-ind < v-max-p-queue
      672       then do:
      673         for each t-list-pack
      674           where t-list-pack.re-gen-time = false
      675             and t-list-pack.SendTxtDate <> ?
      676         on error undo, return error
      677         :
      678           delete t-list-pack .
      679         end.
      680       end.
      681     end.
      682     gen-pack:
      683     for each t-list-pack
      684       by t-list-pack.pack-num
      685     on error undo, return error
      686     :
      687       assign
      688         v-pack-num = t-list-pack.pack-num
      689       .
      690       delete t-list-pack .
      691       run nws/pck-num.p
      692         ( input "put":U
      693          ,input p-db-num
      694          ,input-output v-pack-num
      695          ,output v-pack-name
      696          ,output v-source-dir
      697          ,output v-target-dir
      698          ,output v-temp-dir
      699         ) no-error.
      700       if error-status:error then do:
      701         assign
      702           v-err-msg = substitute( "&1. Ошибка при генерации номера пакета. &2&3&2&4", vss-workfile, chr(10), error-status:get-message(1), return-value )
      703         .
      704         run write-to-log( v-err-msg ) .
      705         return error.
      706       end.
      707       run nws/exp-pck.p
      708         ( input parparentproc
      709         , input p-db-num
      710         , input v-pack-num
      711         , input v-source-dir
      712         , input v-pack-name
      713         ) no-error.
      714       if error-status:error then do:
      715         assign
      716           v-err-msg = substitute( "&1. Ошибка при формировании пакета. &2&3&2&4", vss-workfile, chr(10), error-status:get-message(1), return-value )
      717         .
      718         run write-to-log( v-err-msg ) .
      719         run send-msg-to-email in parparentproc
      720           ( input substitute( "ТН (ver &1) БД &2. Ошибка СПН при формировании пакета для БД &3", v-ver-num, buf_sys-ctrl.db-num, p-db-num )
      721            ,input v-err-msg
      722            ,input "":U
      723           ) no-error .
      724         if error-status :error then do:
      725           run write-to-log( substitute( "&1. &3&2&4", vss-workfile, chr(10), error-status:get-message(1), return-value )
      726                           ) .
      727         end.
      728         return error.
      729       end.
      730       if v-err-gen-pack <> 2 then do:
      731         run nws/s-g-pack.p
      732           ( input "put":U
      733            ,input "7zip":U
      734            ,input v-pack-name
      735            ,input v-source-dir
      736            ,input v-target-dir
      737            ,input v-temp-dir
      738           ) no-error.
      739         if error-status:error then do:
      740           run write-to-log( substitute( "&1. Ошибка при отправке пакета. &2&3&2&4", vss-workfile, chr(10), error-status:get-message(1), return-value )
      741                           ) .
      742           return error.
      743         end.
      744         v-sent-count = v-sent-count + 1.
      745       end.
      746       if v-err-gen-pack <> 0 then do:
      747         leave gen-pack.
      748       end.
      749     end.
      750     if v-send-1 = true then do:
      751     do transaction:
      752       find first buf-dst_db exclusive-lock
      753           where buf-dst_db.db-num = p-db-num
      754           no-error.
      755       if not available buf-dst_db then do:
      756           run write-to-log(substitute("&1. Не удалось обновить кол-во неподтвержденных пакетов для БД &2 ", vss-workfile, p-db-num)).
      757           return error.
      758       end.
      759       assign buf-dst_db.max-p-queue = v-sent-count + 1.
      760     end.
      761       run write-to-log(substitute("отправлено &1 пакетов, кол-во неподтвержденных пакетов для БД &2", v-sent-count, buf-dst_db.max-p-queue)).
      762     end.
      763     for each t-list-pack
      764     on error undo, return error
      765     :
      766       delete t-list-pack .
      767     end.
      768     run gbl/del-file.p
      769       ( input v-temp-dir
      770       ) no-error .
      771     if error-status:error then do:
      772       run write-to-log( substitute( "&1. Ошибка при удалении временного файла. &2&3&2&4", vss-workfile, chr(10), error-status:get-message(1), return-value )
      773                       ) .
      774     end.
      775     case p-action:
      776       when "one-pack":U then do:
      777         run write-to-log( substitute("Завершена отправка одного пакета новостей в БД &1", p-db-num ) ) .
      778       end.
      779       when "all-unconf":U then do:
      780         run write-to-log( substitute("Завершена отправка всех неподтвержденных пакетов новостей в БД &1", p-db-num ) ) .
      781       end.
      782       when "all":U then do:
      783         run write-to-log( substitute("Завершена отправка новостей в БД &1", p-db-num ) ) .
      784       end.
      785     end case.
      786   end.
