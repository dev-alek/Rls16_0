        1   block-level on error undo, throw.
        2   define input  parameter p-obj-type as character no-undo .
        3   define input  parameter p-obj-code as integer   no-undo .
        4   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        5   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        6   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile: cmdreqgd.p $":U .
        8   define variable vss-archive     as character no-undo init "$Archive: nws/cmdreqgd.p $":U .
        9   define variable vss-description as character no-undo init "Запросить информацию обо всех товарах по указанному объекту".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28       assign
       29         p-vss-parameters = substitute('&1|&2':u,p-obj-type,p-obj-code)
       30       .
       31   end procedure.
       32   define new global shared variable g#vssrevis-logger as handle    no-undo .
       33   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       34   define variable v-vssrevis-logger                   as handle    no-undo .
       35   procedure vss-logevent :
       36     define input  parameter p-extra-paramters as character no-undo .
       37     define variable v-vssrevis-parameters as character no-undo .
       38     do
       39     on error undo, return error return-value
       40     :
       41       if  valid-handle(v-vssrevis-logger)
       42       and v-vssrevis-logger :get-signature("logevent") <> ""
       43       then do:
       44         run vss-get-parameters in this-procedure
       45           (output v-vssrevis-parameters
       46           ).
       47         run logevent in v-vssrevis-logger
       48           (input vss-workfile
       49           ,input vss-revision
       50           ,input v-vssrevis-parameters
       51           ,input p-extra-paramters
       52           ).
       53       end.
       54     end.
       55   end procedure.
       56   assign
       57     v-vssrevis-logger = g#vssrevis-logger
       58   .
       59   if  valid-handle(v-vssrevis-logger)
       60   and v-vssrevis-logger :get-signature("logevent") <> ""
       61   then do:
       62     assign
       63       v-vssrevis-logevent = true
       64     .
       65     run vss-logevent in this-procedure (input vss-description) .
       66   end.
       67   define new global shared variable g#language as character no-undo .
       68   if g#language <> '' and g#language <> 'rus':U then do:
       69     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       70   end.
       71   define new global shared variable g#library  as handle no-undo .
       72   define new global shared variable g#library2 as handle no-undo .
       73   define   shared variable g#auto as logical no-undo.
       74   define   shared variable g#news as logical no-undo.
       75   define   shared variable g#oxml as logical no-undo.
       76   define   shared variable g#esys as logical no-undo.
       77   define   shared variable g#news-source-db as integer no-undo.
       78   define   shared variable g#esys-source-esys as integer no-undo.
       79   define   shared variable g#db-num as integer   no-undo .
       80   define   shared variable g#userid as character no-undo .
       81   define   shared variable g#passwd as character no-undo .
       82   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       83   procedure cur-time :
       84      define output parameter p-today as date      no-undo .
       85      define output parameter p-time  as integer   no-undo .
       86     do
       87     on error undo, return error
       88     :
       89       define variable v-date1 as date      no-undo .
       90       define variable v-date2 as date      no-undo .
       91       define variable v-time  as integer   no-undo .
       92       assign
       93         v-date1 = today
       94         v-time  = time
       95         v-date2 = today
       96       .
       97       if v-date1 <> v-date2
       98       then do:
       99         assign
      100           v-date1 = today
      101           v-time  = v-time
      102         .
      103       end.
      104       assign
      105         p-today = v-date1
      106         p-time  = v-time
      107       .
      108     end.
      109   end.
      110   function cur-time-date returns character
      111   :
      112     return string(today, '99/99/9999':U) .
      113   end.
      114   function cur-time-mjd returns decimal
      115   :
      116     define variable v-date as date      no-undo .
      117     define variable v-time as integer   no-undo .
      118     run cur-time in this-procedure
      119       (output v-date
      120       ,output v-time
      121       ) .
      122     return integer(v-date) - 2400002 + (v-time / 86400) .
      123   end.
      124   function cur-time-get-ending-index returns integer
      125   (input p-number as integer
      126   )
      127   :
      128     if p-number < 0
      129     or p-number = ?
      130     then do:
      131       return 1 .
      132     end.
      133     define variable v-rest as integer   no-undo .
      134     assign
      135       p-number = p-number modulo 100
      136     .
      137     if p-number < 20
      138     then do:
      139       assign
      140         v-rest = p-number
      141       .
      142     end.
      143     else do:
      144       assign
      145         v-rest = p-number modulo 10
      146       .
      147     end.
      148     case v-rest :
      149       when 1
      150       then do:
      151         return 2 .
      152       end.
      153       when 2 or
      154       when 3 or
      155       when 4
      156       then do:
      157         return 3 .
      158       end.
      159       otherwise do:
      160         return 1 .
      161       end.
      162     end case .
      163   end.
      164   procedure cur-time-mjd-to-date :
      165      define input  parameter i-mjd-diff as decimal no-undo.
      166      define output parameter o-Date     as date    no-undo.
      167      define output parameter o-Time     as integer no-undo.
      168      define variable v-day-number as integer   no-undo .
      169      if    i-mjd-diff < 0
      170         or i-mjd-diff = ?
      171      then do:
      172         return "?" .
      173      end.
      174      assign
      175         v-day-number = truncate(i-mjd-diff,0).
      176         o-Date = date(v-day-number + 2400002).
      177         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      178     .
      179   end.
      180   function cur-time-mjd-to-string returns character
      181   (input p-mjd-diff as decimal
      182   )
      183   :
      184     define variable v-day-number as integer   no-undo .
      185     define variable v-seconds    as integer   no-undo .
      186     define variable v-hour       as integer   no-undo .
      187     define variable v-min        as integer   no-undo .
      188     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      189     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      190     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      191     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      192     if p-mjd-diff < 0
      193     or p-mjd-diff = ?
      194     then do:
      195       return "?" .
      196     end.
      197     assign
      198       v-day-number = integer(truncate(p-mjd-diff,0))
      199       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      200     .
      201     if v-seconds > 86400
      202     then do:
      203       assign
      204         v-seconds = 86400 - 1
      205       .
      206     end.
      207     if v-seconds < 0
      208     then do:
      209       assign
      210         v-seconds = 0
      211       .
      212     end.
      213     assign
      214       v-hour = truncate(v-seconds / 3600, 0)
      215     .
      216     assign
      217       v-seconds = v-seconds modulo 3600
      218     .
      219     assign
      220       v-min = truncate(v-seconds / 60, 0)
      221     .
      222     assign
      223       v-seconds = v-seconds modulo 60
      224     .
      225     return
      226         (if v-day-number <> 0
      227           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      228           else ""
      229         )
      230       + (if v-day-number <> 0 or v-hour <> 0
      231           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      232           else ""
      233         )
      234       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      235           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      236           else ""
      237         )
      238       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      239       .
      240   end.
      241   function cur-time-string returns character
      242   :
      243     define variable v-date as date      no-undo .
      244     define variable v-time as integer   no-undo .
      245     run cur-time in this-procedure
      246       (output v-date
      247       ,output v-time
      248       ) .
      249     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      250   end.
      251   function cur-time-string-sec returns character
      252   :
      253     define variable v-date as date      no-undo .
      254     define variable v-time as integer   no-undo .
      255     run cur-time in this-procedure
      256       (output v-date
      257       ,output v-time
      258       ) .
      259     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      260   end.
      261   function cur-time-custom  returns character
      262   (input p-prefix as character
      263   ,input p-date-format as character
      264   ,input p-delimiter as character
      265   ,input p-time-format as character
      266   ,input p-suffix as character
      267   )
      268   :
      269     define variable v-date as date      no-undo .
      270     define variable v-time as integer   no-undo .
      271     run cur-time in this-procedure
      272       (output v-date
      273       ,output v-time
      274       ) .
      275     return
      276       p-prefix
      277       + string(v-date, p-date-format)
      278       + p-delimiter
      279       + string(v-time, p-time-format)
      280       + p-suffix
      281       .
      282   end.
      283   function cur-time-print  returns character
      284   :
      285     define variable v-date as date      no-undo .
      286     define variable v-time as integer   no-undo .
      287     run cur-time in this-procedure
      288       (output v-date
      289       ,output v-time
      290       ) .
      291     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      292   end.
      293   function cur-time-datetime returns datetime
      294   :
      295     define variable v-char as character no-undo .
      296     define variable v-datetime as datetime no-undo .
      297     v-char = cur-time-string().
      298     v-datetime = datetime(v-char).
      299     return  v-datetime.
      300   end.
      301   function cur-time-string-msec returns character
      302   :
      303     define variable v-date as datetime  no-undo .
      304     v-date = now.
      305     return string(v-date) .
      306   end.
      307   define variable v-db-num          as integer   no-undo .
      308   define variable v-cur-db-num      as integer   no-undo .
      309   define variable v-object-exist    as logical   no-undo .
      310   define variable v-cmd-proc-handle as handle    no-undo .
      311   define variable v-cmd-code1       as integer   no-undo .
      312   do
      313   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      314   on stop   undo, return error substitute( "&1. stop", vss-workfile )
      315   on endkey undo, return error substitute( "&1. endkey", vss-workfile )
      316   :
      317     if p-obj-type = ?
      318     then do:
      319       message
      320         vss-workfile vss-revision vss-description skip
      321         "Ошибка задания входных параметров" skip
      322         "Неизвестное значение типа объекта" skip
      323         "Объект" p-obj-type p-obj-code skip
      324         view-as alert-box error .
      325       undo, return error return-value .
      326     end.
      327     if p-obj-code = ?
      328     then do:
      329       message
      330         vss-workfile vss-revision vss-description skip
      331         "Ошибка задания входных параметров" skip
      332         "Неизвестное значение кода объекта" skip
      333         "Объект" p-obj-type p-obj-code skip
      334         view-as alert-box error .
      335       undo, return error return-value .
      336     end.
      337   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      338   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      339     (input  p-obj-type
      340     ,input  p-obj-code
      341     ,input  'check-exist':u
      342     ,output v-object-exist
      343     ) no-error .
      344     if error-status :error
      345     then do:
      346       message
      347         vss-workfile vss-revision vss-description skip
      348         "Ошибка при проверке существования объекта" skip
      349         "Не найден объект" skip
      350         "Объект" p-obj-type p-obj-code skip
      351         error-status :get-message(1) skip
      352         return-value skip
      353         view-as alert-box error .
      354       undo, return error return-value .
      355     end.
      356   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      357   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
      358     (input  p-obj-type
      359     ,input  p-obj-code
      360     ,output v-db-num
      361     ) no-error .
      362     if error-status :error
      363     then do:
      364       message
      365         vss-workfile vss-revision vss-description skip
      366         "Ошибка при определении номер базы данных" skip
      367         "Объект" p-obj-type p-obj-code skip
      368         error-status :get-message(1) skip
      369         return-value skip
      370         view-as alert-box error .
      371       undo, return error return-value .
      372     end.
      373     if v-db-num = 0
      374     then do:
      375       message
      376         vss-workfile vss-revision vss-description skip
      377         "Ошибка задания входных параметров" skip
      378         "Нельзя запросить информацию у объекта, принадлежащего ГБД"
      379         "Объект" p-obj-type p-obj-code skip
      380         "База данных" v-db-num skip
      381         error-status :get-message(1) skip
      382         return-value skip
      383         view-as alert-box error .
      384       undo, return error return-value .
      385     end.
      386   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      387   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
      388     (output v-cur-db-num
      389     )  .
      390     if v-cur-db-num <> 0
      391     then do:
      392       message
      393         vss-workfile vss-revision vss-description skip
      394         "Ошибка задания входных параметров" skip
      395         "Запрос на отправку информации о товарах из УБД может быть сформирован только в ГБД" skip
      396         "Объект" p-obj-type p-obj-code skip
      397         "База данных" v-db-num skip
      398         "Текущая база данных" v-cur-db-num skip
      399         error-status :get-message(1) skip
      400         return-value skip
      401         view-as alert-box error .
      402       undo, return error return-value .
      403     end.
      404     run nws/cmd-bush.p persistent set v-cmd-proc-handle
      405       no-error .
      406     if error-status :error
      407     then do:
      408       message
      409         vss-workfile vss-revision vss-description skip
      410         substitute("Ошибка при запуске библиотеки отправки команд cmd-bush.p") skip
      411         error-status :get-message(1) skip
      412         return-value skip
      413         view-as alert-box error .
      414       delete procedure v-cmd-proc-handle .
      415       undo, return error return-value .
      416     end.
      417     run begin-create-command in v-cmd-proc-handle
      418       (input  'cmd-request-goods':U + chr(6) + string(p-obj-type) + chr(6) + string(p-obj-code)
      419       ,input "":U
      420       ,output v-cmd-code1
      421       ) no-error.
      422     if error-status :error
      423     then do:
      424       message
      425         vss-workfile vss-revision vss-description skip
      426         substitute( "Ошибка при создании команды test (1)!" ) skip
      427         error-status :get-message(1) skip
      428         return-value skip
      429         view-as alert-box error .
      430       delete procedure v-cmd-proc-handle .
      431       undo, return error return-value .
      432     end.
      433     run send-command in v-cmd-proc-handle
      434       (input v-cmd-code1
      435       ,input string(v-db-num)
      436       ) no-error .
      437     if error-status :error
      438     then do:
      439       message
      440         vss-workfile vss-revision vss-description skip
      441         substitute( "Ошибка при отправке в новости команды с кодом &1", v-cmd-code1 ) skip
      442         error-status :get-message(1) skip
      443         return-value skip
      444         view-as alert-box error .
      445       delete procedure v-cmd-proc-handle .
      446       undo, return error return-value .
      447     end.
      448     delete procedure v-cmd-proc-handle .
      449     define variable v-today         as date      no-undo .
      450     define variable v-time          as integer   no-undo .
      451     define variable v-log-file-name as character no-undo .
      452     define variable v-log-message   as character no-undo .
      453     run cur-time in this-procedure
      454       (output v-today
      455       ,output v-time
      456       ) .
      457     assign
      458       v-log-file-name = 'cmdcmpgd.log':u
      459       v-log-message   = substitute("__ &1 &2 объект &3 &4 отправлен_запрос_на_передачу_остатков_из_УБД"
      460                                   ,string(v-today,'99/99/9999':u)
      461                                   ,string(v-time,'HH:MM:SS':U)
      462                                   ,p-obj-type
      463                                   ,p-obj-code
      464                                   )
      465                       + chr(10)
      466     .
      467   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      468   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run file-wr in g#library
      469     (input v-log-file-name
      470     ,input v-log-message
      471     )  .
      472   end.
