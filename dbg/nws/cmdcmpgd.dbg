        1   block-level on error undo, throw.
        2   define input  parameter p-imp-handle as handle    no-undo .
        3   define input  parameter p-counter    as integer   no-undo .
        4   define input  parameter p-obj-type   as character no-undo .
        5   define input  parameter p-obj-code   as integer   no-undo .
        6   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        7   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        8   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        9   define variable vss-workfile    as character no-undo init "$Workfile: cmdcmpgd.p $":U .
       10   define variable vss-archive     as character no-undo init "$Archive: nws/cmdcmpgd.p $":U .
       11   define variable vss-description as character no-undo init "Распределённая проверка целостности остатков по товару".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30       assign
       31         p-vss-parameters = substitute('&1|&2|&3':u,p-counter,p-obj-type,p-obj-code)
       32       .
       33   end procedure.
       34   define new global shared variable g#vssrevis-logger as handle    no-undo .
       35   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       36   define variable v-vssrevis-logger                   as handle    no-undo .
       37   procedure vss-logevent :
       38     define input  parameter p-extra-paramters as character no-undo .
       39     define variable v-vssrevis-parameters as character no-undo .
       40     do
       41     on error undo, return error return-value
       42     :
       43       if  valid-handle(v-vssrevis-logger)
       44       and v-vssrevis-logger :get-signature("logevent") <> ""
       45       then do:
       46         run vss-get-parameters in this-procedure
       47           (output v-vssrevis-parameters
       48           ).
       49         run logevent in v-vssrevis-logger
       50           (input vss-workfile
       51           ,input vss-revision
       52           ,input v-vssrevis-parameters
       53           ,input p-extra-paramters
       54           ).
       55       end.
       56     end.
       57   end procedure.
       58   assign
       59     v-vssrevis-logger = g#vssrevis-logger
       60   .
       61   if  valid-handle(v-vssrevis-logger)
       62   and v-vssrevis-logger :get-signature("logevent") <> ""
       63   then do:
       64     assign
       65       v-vssrevis-logevent = true
       66     .
       67     run vss-logevent in this-procedure (input vss-description) .
       68   end.
       69   define new global shared variable g#language as character no-undo .
       70   if g#language <> '' and g#language <> 'rus':U then do:
       71     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       72   end.
       73   define new global shared variable g#library  as handle no-undo .
       74   define new global shared variable g#library2 as handle no-undo .
       75   define   shared variable g#auto as logical no-undo.
       76   define   shared variable g#news as logical no-undo.
       77   define   shared variable g#oxml as logical no-undo.
       78   define   shared variable g#esys as logical no-undo.
       79   define   shared variable g#news-source-db as integer no-undo.
       80   define   shared variable g#esys-source-esys as integer no-undo.
       81   define   shared variable g#db-num as integer   no-undo .
       82   define   shared variable g#userid as character no-undo .
       83   define   shared variable g#passwd as character no-undo .
       84   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       85   define variable v-waitfram-action01         as character   no-undo .
       86   define variable v-waitfram-action02         as character   no-undo .
       87   define variable v-waitfram-action03         as character   no-undo .
       88   define variable mWaitFramTextBeg            as character   no-undo.
       89   define variable mWaitFramTextEnd            as character   no-undo.
       90   define variable mWaitFramView               as logical     no-undo.
       91   define variable mWaitProcEvent              as logical     no-undo init yes.
       92   define variable mWaitFramInterval           as integer     no-undo init 1 .
       93   define variable mWaitFramStop               as logical     no-undo.
       94   define variable mWaitFramStopUser           as logical     no-undo.
       95   define variable mWaitFramStopTimeOut        as logical     no-undo.
       96   define variable mWaitFramStartProc          as datetime-tz no-undo.
       97   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       98   define button B-WaitFramStop auto-end-key
       99        label "Стоп"
      100        size 10 by 1 tooltip "Остоновить процесс".
      101   define button B-viewProcInfo
      102        label "Информация"
      103        size 15 by 1 tooltip "Информация о процесс".
      104   define frame waitfram
      105     v-waitfram-action01 format "x(72)" no-label skip
      106     v-waitfram-action02 format "x(72)" no-label skip
      107     v-waitfram-action03 format "x(72)" no-label skip
      108     B-viewProcInfo
      109     B-WaitFramStop at row 4 col 30
      110     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      111     .
      112   define new global shared variable mBatchMode as logical no-undo init ?.
      113   define variable mFramBachModHandle as handle no-undo.
      114   mFramBachModHandle = frame waitfram:handle.
      115   define variable mFameOldVis as logical no-undo.
      116   define variable mVisCUrentVin as logical no-undo.
      117   if session:batch-mode
      118   then
      119      mBatchMode = yes.
      120   if mBatchMode = ? then do:
      121     mVisCUrentVin = current-window:visible.
      122     mFameOldVis = mFramBachModHandle:visible.
      123     mFramBachModHandle:visible  = yes.
      124     mBatchMode = mFramBachModHandle:visible ne yes.
      125     mFramBachModHandle:visible = mFameOldVis.
      126     current-window:visible = mVisCUrentVin.
      127   end.
      128    if  log-manager:logfile-name ne ?
      129     then DO:
      130         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      131         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      132         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      133     end.
      134   on choose of B-WaitFramStop in frame waitfram
      135   do:
      136     mWaitFramStop = yes.
      137     mWaitFramStopUser = yes.
      138   end.
      139   function waitfram-check-timeout returns logical():
      140      define variable vtime as int64 no-undo.
      141      if mWaitFramStopTimeOut
      142      then
      143         return yes.
      144      vtime = ( now - mWaitFramStartProc ) / 1000 .
      145      if     mWaitFramTimeOut ne ?
      146         and mWaitFramTimeOut ne 0
      147         and mWaitFramTimeOut lt vtime
      148      then do:
      149         mWaitFramStopTimeOut = yes.
      150      end.
      151      return mWaitFramStopTimeOut.
      152   end.
      153   procedure waitfram-hide :
      154     if not session:batch-mode
      155     then do
      156     on error undo, return error return-value
      157     :
      158       pause 0 before-hide .
      159       if not mBatchMode then
      160         hide frame waitfram .
      161     if     not mWaitFramView
      162        and mWaitProcEvent
      163     then
      164       process events .
      165     end.
      166   end procedure.
      167   procedure waitfram-show :
      168     define input  parameter p-message as character no-undo .
      169     define variable v-left-margin as integer   no-undo .
      170     if not session:batch-mode
      171     then do
      172     on error undo, return error return-value
      173     :
      174       if length(p-message) <= 70 then do:
      175         assign
      176           v-left-margin = integer((70 - length(p-message)) / 2)
      177         .
      178         assign
      179           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      180         .
      181         assign
      182           v-waitfram-action01 = " "
      183           v-waitfram-action02 = " "
      184                                    + fill(" ", v-left-margin)
      185                                    + p-message
      186           v-waitfram-action03 = " "
      187         .
      188       end.
      189       else do:
      190         define variable vRindex1 as integer no-undo.
      191         define variable vRindex2 as integer no-undo.
      192         vRindex1 = r-index(p-message," ",70).
      193         if vRindex1 = 0
      194         then
      195            vRindex1 = 70.
      196         if length(p-message)  <= vRindex1 + 70 then do:
      197           assign
      198             v-waitfram-action01 = " "
      199             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      200             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      201           .
      202         end.
      203         else do:
      204           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      205           if vRindex2 <= vRindex1
      206           then
      207              vRindex2 = vRindex1 + 70.
      208           assign
      209             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      210             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      211             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      212           .
      213         end.
      214       end.
      215       B-viewProcInfo:visible   in frame waitfram = no.
      216       B-viewProcInfo:sensitive in frame waitfram = no.
      217       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      218       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      219       if  (   mWaitFramView
      220          or  mWaitProcEvent)
      221          and not mBatchMode
      222       then
      223          display
      224             v-waitfram-action01 skip
      225             v-waitfram-action02 skip
      226             v-waitfram-action03 skip
      227          with frame waitfram .
      228       if     mWaitFramView
      229          then do:
      230             if     mWaitFramInterval ne ?
      231                and not mBatchMode
      232             then
      233                wait-for go of frame waitfram pause mWaitFramInterval.
      234          end.
      235          else
      236             if     mWaitProcEvent
      237                and not mBatchMode
      238             then
      239                process events .
      240     end.
      241   end procedure.
      242      procedure waitfram-show-this:
      243         define input  parameter iInterval as int64 no-undo.
      244         define variable vtime as int64 no-undo.
      245         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      246         mWaitFramInterval = iInterval.
      247         run waitfram-show (substitute("&1&2 &3&4" ,
      248                                       mWaitFramTextBeg ,
      249                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      250                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      251                                       mWaitFramTextEnd
      252                                      )
      253                           ).
      254      end.
      255      procedure WaitFramRunPause:
      256         define input  parameter iInterval as dec no-undo.
      257         define variable vStart  as datetime-tz no-undo.
      258         define variable vend    as datetime-tz no-undo.
      259         define variable vint as int64 no-undo.
      260         define variable vOk as logical no-undo.
      261         vStart = now.
      262         vend   = vStart.
      263         publish "WaitFramPause" (iInterval,output vOk).
      264         vend   =  now.
      265         vint = vend - vStart.
      266         vint = iInterval - vint / 1000.
      267         if     not mWaitFramStop
      268            and (   vint > 0
      269                 or (    not vOk
      270                     and iInterval eq ?
      271                     )
      272                 )
      273         then
      274            run waitfram-show-this (iInterval).
      275         vend   =  now.
      276         vint = vend - vStart.
      277         vint = iInterval - vint / 1000.
      278         if     not mWaitFramStop
      279            and vint > 0
      280         then do:
      281            run gbl/pause.p (vint * 1000).
      282         end.
      283         if iInterval ne ?
      284         then
      285            publish "WaitFramStop".
      286         waitfram-check-timeout().
      287      end.
      288      procedure WaitFramWaitFor:
      289         define input  parameter iInterval as dec no-undo.
      290         assign
      291            mWaitFramStartProc   = now
      292            mWaitFramStopUser    = no
      293            mWaitFramStopTimeOut = no
      294         .
      295         block-wait:
      296         do while not mWaitFramStop:
      297            run WaitFramRunPause (iInterval).
      298            if  waitfram-check-timeout()
      299            then do:
      300               leave block-wait.
      301            end.
      302         end.
      303         run waitfram-hide.
      304      end.
      305   procedure waitfram-join :
      306     define input  parameter p-line-1  as character no-undo .
      307     define input  parameter p-line-2  as character no-undo .
      308     define input  parameter p-line-3  as character no-undo .
      309     define output parameter p-message as character no-undo .
      310     do
      311     on error undo, return error return-value
      312     :
      313       assign
      314         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      315                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      316                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      317       .
      318     end.
      319   end procedure.
      320   function waitfram-join-function returns character
      321     (input p-line-1 as character
      322     ,input p-line-2 as character
      323     ,input p-line-3 as character
      324     ).
      325     define variable v-message as character no-undo .
      326     run waitfram-join in this-procedure
      327       (input  p-line-1
      328       ,input  p-line-2
      329       ,input  p-line-3
      330       ,output v-message
      331       ) .
      332     return v-message .
      333   end function .
      334   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      335   procedure cur-time :
      336      define output parameter p-today as date      no-undo .
      337      define output parameter p-time  as integer   no-undo .
      338     do
      339     on error undo, return error
      340     :
      341       define variable v-date1 as date      no-undo .
      342       define variable v-date2 as date      no-undo .
      343       define variable v-time  as integer   no-undo .
      344       assign
      345         v-date1 = today
      346         v-time  = time
      347         v-date2 = today
      348       .
      349       if v-date1 <> v-date2
      350       then do:
      351         assign
      352           v-date1 = today
      353           v-time  = v-time
      354         .
      355       end.
      356       assign
      357         p-today = v-date1
      358         p-time  = v-time
      359       .
      360     end.
      361   end.
      362   function cur-time-date returns character
      363   :
      364     return string(today, '99/99/9999':U) .
      365   end.
      366   function cur-time-mjd returns decimal
      367   :
      368     define variable v-date as date      no-undo .
      369     define variable v-time as integer   no-undo .
      370     run cur-time in this-procedure
      371       (output v-date
      372       ,output v-time
      373       ) .
      374     return integer(v-date) - 2400002 + (v-time / 86400) .
      375   end.
      376   function cur-time-get-ending-index returns integer
      377   (input p-number as integer
      378   )
      379   :
      380     if p-number < 0
      381     or p-number = ?
      382     then do:
      383       return 1 .
      384     end.
      385     define variable v-rest as integer   no-undo .
      386     assign
      387       p-number = p-number modulo 100
      388     .
      389     if p-number < 20
      390     then do:
      391       assign
      392         v-rest = p-number
      393       .
      394     end.
      395     else do:
      396       assign
      397         v-rest = p-number modulo 10
      398       .
      399     end.
      400     case v-rest :
      401       when 1
      402       then do:
      403         return 2 .
      404       end.
      405       when 2 or
      406       when 3 or
      407       when 4
      408       then do:
      409         return 3 .
      410       end.
      411       otherwise do:
      412         return 1 .
      413       end.
      414     end case .
      415   end.
      416   procedure cur-time-mjd-to-date :
      417      define input  parameter i-mjd-diff as decimal no-undo.
      418      define output parameter o-Date     as date    no-undo.
      419      define output parameter o-Time     as integer no-undo.
      420      define variable v-day-number as integer   no-undo .
      421      if    i-mjd-diff < 0
      422         or i-mjd-diff = ?
      423      then do:
      424         return "?" .
      425      end.
      426      assign
      427         v-day-number = truncate(i-mjd-diff,0).
      428         o-Date = date(v-day-number + 2400002).
      429         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      430     .
      431   end.
      432   function cur-time-mjd-to-string returns character
      433   (input p-mjd-diff as decimal
      434   )
      435   :
      436     define variable v-day-number as integer   no-undo .
      437     define variable v-seconds    as integer   no-undo .
      438     define variable v-hour       as integer   no-undo .
      439     define variable v-min        as integer   no-undo .
      440     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      441     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      442     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      443     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      444     if p-mjd-diff < 0
      445     or p-mjd-diff = ?
      446     then do:
      447       return "?" .
      448     end.
      449     assign
      450       v-day-number = integer(truncate(p-mjd-diff,0))
      451       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      452     .
      453     if v-seconds > 86400
      454     then do:
      455       assign
      456         v-seconds = 86400 - 1
      457       .
      458     end.
      459     if v-seconds < 0
      460     then do:
      461       assign
      462         v-seconds = 0
      463       .
      464     end.
      465     assign
      466       v-hour = truncate(v-seconds / 3600, 0)
      467     .
      468     assign
      469       v-seconds = v-seconds modulo 3600
      470     .
      471     assign
      472       v-min = truncate(v-seconds / 60, 0)
      473     .
      474     assign
      475       v-seconds = v-seconds modulo 60
      476     .
      477     return
      478         (if v-day-number <> 0
      479           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      480           else ""
      481         )
      482       + (if v-day-number <> 0 or v-hour <> 0
      483           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      484           else ""
      485         )
      486       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      487           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      488           else ""
      489         )
      490       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      491       .
      492   end.
      493   function cur-time-string returns character
      494   :
      495     define variable v-date as date      no-undo .
      496     define variable v-time as integer   no-undo .
      497     run cur-time in this-procedure
      498       (output v-date
      499       ,output v-time
      500       ) .
      501     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      502   end.
      503   function cur-time-string-sec returns character
      504   :
      505     define variable v-date as date      no-undo .
      506     define variable v-time as integer   no-undo .
      507     run cur-time in this-procedure
      508       (output v-date
      509       ,output v-time
      510       ) .
      511     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      512   end.
      513   function cur-time-custom  returns character
      514   (input p-prefix as character
      515   ,input p-date-format as character
      516   ,input p-delimiter as character
      517   ,input p-time-format as character
      518   ,input p-suffix as character
      519   )
      520   :
      521     define variable v-date as date      no-undo .
      522     define variable v-time as integer   no-undo .
      523     run cur-time in this-procedure
      524       (output v-date
      525       ,output v-time
      526       ) .
      527     return
      528       p-prefix
      529       + string(v-date, p-date-format)
      530       + p-delimiter
      531       + string(v-time, p-time-format)
      532       + p-suffix
      533       .
      534   end.
      535   function cur-time-print  returns character
      536   :
      537     define variable v-date as date      no-undo .
      538     define variable v-time as integer   no-undo .
      539     run cur-time in this-procedure
      540       (output v-date
      541       ,output v-time
      542       ) .
      543     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      544   end.
      545   function cur-time-datetime returns datetime
      546   :
      547     define variable v-char as character no-undo .
      548     define variable v-datetime as datetime no-undo .
      549     v-char = cur-time-string().
      550     v-datetime = datetime(v-char).
      551     return  v-datetime.
      552   end.
      553   function cur-time-string-msec returns character
      554   :
      555     define variable v-date as datetime  no-undo .
      556     v-date = now.
      557     return string(v-date) .
      558   end.
      559   define temp-table temp-gds-obj no-undo like ub.gds-obj .
      560   define temp-table temp-prt-obj no-undo like ub.prt-obj .
      561   define temp-table temp-parts   no-undo like ub.parts .
      562   define temp-table temp-cmp-gds-obj no-undo
      563     field gds-code          as integer
      564     field current-fact-qnty as decimal
      565     field current-free-qnty as decimal
      566     field remote-fact-qnty  as decimal
      567     field remote-free-qnty  as decimal
      568     field error-qnty        as logical
      569     index xpk is primary unique gds-code
      570     index xie1 error-qnty
      571     .
      572   define temp-table temp-cmp-prt-obj no-undo
      573     field gds-code          as integer
      574     field prt-code          as integer
      575     field current-fact-qnty as decimal
      576     field current-free-qnty as decimal
      577     field remote-fact-qnty  as decimal
      578     field remote-free-qnty  as decimal
      579     index xpk is primary unique gds-code prt-code
      580     .
      581   define temp-table temp-cmp-parts no-undo
      582     field gds-code          as integer
      583     field in-code           as character
      584     field out-code          as character
      585     field part-code         as character
      586     field current-fact-qnty as decimal
      587     field remote-fact-qnty  as decimal
      588     index xpk is primary unique gds-code in-code out-code part-code
      589     .
      590   define variable counter    as integer   no-undo .
      591   define variable rec-full   as character no-undo .
      592   define variable v-rec-name as character no-undo .
      593   define variable v-today    as date      no-undo .
      594   define variable v-time     as integer   no-undo .
      595   define buffer buf_batchprocess     for ub.batchprocess .
      596   define buffer buf_temp-gds-obj     for temp-gds-obj .
      597   define buffer buf_temp-prt-obj     for temp-prt-obj .
      598   define buffer buf_temp-parts       for temp-parts .
      599   define buffer buf_gds-obj          for ub.gds-obj .
      600   define buffer buf_prt-obj          for ub.prt-obj .
      601   define buffer buf_parts            for ub.parts .
      602   define buffer buf_temp-cmp-gds-obj for temp-cmp-gds-obj .
      603   define buffer buf_temp-cmp-prt-obj for temp-cmp-prt-obj .
      604   define buffer buf_temp-cmp-parts   for temp-cmp-parts .
      605   do
      606   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      607   on stop   undo, return error substitute( "&1. stop", vss-workfile )
      608   on endkey undo, return error substitute( "&1. endkey", vss-workfile )
      609   :
      610     do counter = 1 to p-counter
      611     on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      612     on stop   undo, return error substitute( "&1. stop", vss-workfile )
      613     on endkey undo, return error substitute( "&1. endkey", vss-workfile )
      614     :
      615       if counter modulo 10 = 0
      616       then do:
      617         run waitfram-show in this-procedure
      618           (input substitute("Получение остатков по товарам из УБД. Объект УБД &1 &2. Получено &3", p-obj-type, p-obj-code, counter)
      619           ) .
      620       end.
      621       run nws-imps in p-imp-handle
      622         ( input-output counter
      623          ,output       rec-full
      624         ) no-error.
      625       if error-status :error then do:
      626         return error return-value .
      627       end.
      628       assign
      629         v-rec-name = entry( 1, rec-full, chr(1) )
      630       .
      631       CASE entry(1, v-rec-name, chr(4)) :
      632         when 'gds-obj':U
      633         then do:
      634           create buf_temp-gds-obj .
      635           run nws-impl in p-imp-handle
      636             ( input 'gds-obj':U
      637              ,input (buffer buf_temp-gds-obj:handle)
      638             ) no-error.
      639           if error-status :error then do:
      640             return error return-value .
      641           end.
      642         end.
      643         when 'prt-obj':U
      644         then do:
      645           create buf_temp-prt-obj .
      646           run nws-impl in p-imp-handle
      647             ( input 'prt-obj':U
      648              ,input (buffer buf_temp-prt-obj:handle)
      649             ) no-error.
      650           if error-status :error then do:
      651             return error return-value .
      652           end.
      653         end.
      654         when 'parts':U
      655         then do:
      656           create buf_temp-parts .
      657           run nws-impl in p-imp-handle
      658             ( input 'parts':U
      659               ,input (buffer buf_temp-parts:handle)
      660             ) no-error.
      661           if error-status :error then do:
      662             return error return-value .
      663           end.
      664         end.
      665         otherwise do:
      666           message
      667             vss-workfile vss-revision vss-description skip
      668             "Не предусмотрен прием таблицы " v-rec-name skip
      669             "в составе команды" 'cmd-transfer-goods':U skip
      670             view-as alert-box error .
      671           return error .
      672         end.
      673       end case.
      674     end.
      675     run waitfram-hide .
      676     run gbl/lockgdoc.p
      677       (input  p-obj-type
      678       ,input  p-obj-code
      679       ,input  'gdoc':U
      680       ,input  'disable':U
      681       ,buffer buf_batchprocess
      682       ) no-error .
      683     if error-status :error
      684     then do:
      685       message
      686         vss-workfile vss-revision vss-description skip
      687         "Ошибка при проверке возможности создания записей товара на объекте" skip
      688         "Объект" p-obj-type p-obj-code skip
      689         error-status :get-message(1) skip
      690         return-value skip
      691         view-as alert-box error .
      692       undo, return error .
      693     end.
      694     define variable v-ind as integer   no-undo .
      695     do transaction
      696     on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      697     on stop   undo, return error substitute( "&1. stop", vss-workfile )
      698     on endkey undo, return error substitute( "&1. endkey", vss-workfile )
      699     :
      700       for each buf_gds-obj exclusive-lock
      701         where buf_gds-obj.obj-type = p-obj-type
      702           and buf_gds-obj.obj-code = p-obj-code
      703       on error undo, return error return-value
      704       :
      705         assign
      706           v-ind = v-ind + 1
      707         .
      708         if v-ind modulo 10 = 0
      709         then do:
      710           run waitfram-show in this-procedure
      711             (input substitute("Блокировка товаров на объекте. Объект УБД &1 &2. Заблокировано &3", p-obj-type, p-obj-code, v-ind)
      712             ) .
      713         end.
      714         create buf_temp-cmp-gds-obj .
      715         assign
      716           buf_temp-cmp-gds-obj.gds-code          = buf_gds-obj.gds-code
      717           buf_temp-cmp-gds-obj.current-fact-qnty = buf_gds-obj.fact-qnty
      718           buf_temp-cmp-gds-obj.current-free-qnty = buf_gds-obj.free-qnty
      719         .
      720         for each buf_prt-obj share-lock
      721           where buf_prt-obj.obj-type  = buf_gds-obj.obj-type
      722             and buf_prt-obj.obj-code  = buf_gds-obj.obj-code
      723             and buf_prt-obj.artic     = buf_gds-obj.artic
      724             and buf_prt-obj.prod-type = buf_gds-obj.prod-type
      725             and buf_prt-obj.prod-code = buf_gds-obj.prod-code
      726         on error undo, return error return-value
      727         :
      728           create buf_temp-cmp-prt-obj .
      729           assign
      730             buf_temp-cmp-prt-obj.gds-code          = buf_gds-obj.gds-code
      731             buf_temp-cmp-prt-obj.prt-code          = buf_prt-obj.prt-code
      732             buf_temp-cmp-prt-obj.current-fact-qnty = buf_prt-obj.fact-qnty
      733             buf_temp-cmp-prt-obj.current-free-qnty = buf_prt-obj.free-qnty
      734           .
      735         end.
      736         for each buf_parts share-lock
      737           where buf_parts.obj-type  = buf_gds-obj.obj-type
      738             and buf_parts.obj-code  = buf_gds-obj.obj-code
      739             and buf_parts.artic     = buf_gds-obj.artic
      740             and buf_parts.prod-type = buf_gds-obj.prod-type
      741             and buf_parts.prod-code = buf_gds-obj.prod-code
      742             and buf_parts.rsrv-free = yes
      743             and buf_parts.status_   = no
      744             and buf_parts.in-code   <> buf_parts.out-code
      745         on error undo, return error return-value
      746         :
      747           create buf_temp-cmp-parts .
      748           assign
      749             buf_temp-cmp-parts.gds-code          = buf_gds-obj.gds-code
      750             buf_temp-cmp-parts.in-code           = buf_parts.in-code
      751             buf_temp-cmp-parts.out-code          = buf_parts.out-code
      752             buf_temp-cmp-parts.part-code         = buf_parts.part-code
      753             buf_temp-cmp-parts.current-fact-qnty = buf_parts.fact-qnty
      754           .
      755         end.
      756       end.
      757       run waitfram-hide in this-procedure .
      758     end.
      759     for each buf_temp-gds-obj
      760     on error undo, return error return-value
      761     :
      762       find first buf_temp-cmp-gds-obj
      763         where buf_temp-cmp-gds-obj.gds-code = buf_temp-gds-obj.gds-code
      764         no-error .
      765       if not available buf_temp-cmp-gds-obj
      766       then do:
      767         create buf_temp-cmp-gds-obj .
      768         assign
      769           buf_temp-cmp-gds-obj.gds-code = buf_temp-gds-obj.gds-code
      770         .
      771       end.
      772       assign
      773         buf_temp-cmp-gds-obj.remote-fact-qnty = buf_temp-gds-obj.fact-qnty
      774         buf_temp-cmp-gds-obj.remote-free-qnty = buf_temp-gds-obj.free-qnty
      775       .
      776       for each buf_temp-prt-obj
      777         where buf_temp-prt-obj.obj-type  = buf_temp-gds-obj.obj-type
      778           and buf_temp-prt-obj.obj-code  = buf_temp-gds-obj.obj-code
      779           and buf_temp-prt-obj.artic     = buf_temp-gds-obj.artic
      780           and buf_temp-prt-obj.prod-type = buf_temp-gds-obj.prod-type
      781           and buf_temp-prt-obj.prod-code = buf_temp-gds-obj.prod-code
      782       on error undo, return error return-value
      783       :
      784         find first buf_temp-cmp-prt-obj
      785           where buf_temp-cmp-prt-obj.gds-code = buf_temp-gds-obj.gds-code
      786             and buf_temp-cmp-prt-obj.prt-code = buf_temp-prt-obj.prt-code
      787           no-error .
      788         if not available buf_temp-cmp-prt-obj
      789         then do:
      790           create buf_temp-cmp-prt-obj .
      791           assign
      792             buf_temp-cmp-prt-obj.gds-code = buf_temp-gds-obj.gds-code
      793             buf_temp-cmp-prt-obj.prt-code = buf_temp-prt-obj.prt-code
      794           .
      795         end.
      796         assign
      797           buf_temp-cmp-prt-obj.remote-fact-qnty = buf_temp-prt-obj.fact-qnty
      798           buf_temp-cmp-prt-obj.remote-free-qnty = buf_temp-prt-obj.free-qnty
      799         .
      800       end.
      801       for each buf_temp-parts
      802         where buf_temp-parts.obj-type  = buf_temp-gds-obj.obj-type
      803           and buf_temp-parts.obj-code  = buf_temp-gds-obj.obj-code
      804           and buf_temp-parts.artic     = buf_temp-gds-obj.artic
      805           and buf_temp-parts.prod-type = buf_temp-gds-obj.prod-type
      806           and buf_temp-parts.prod-code = buf_temp-gds-obj.prod-code
      807       on error undo, return error return-value
      808       :
      809         find first buf_temp-cmp-parts
      810           where buf_temp-cmp-parts.gds-code  = buf_temp-gds-obj.gds-code
      811             and buf_temp-cmp-parts.in-code   = buf_temp-parts.in-code
      812             and buf_temp-cmp-parts.out-code  = buf_temp-parts.out-code
      813             and buf_temp-cmp-parts.part-code = buf_temp-parts.part-code
      814           no-error .
      815         if not available buf_temp-cmp-parts
      816         then do:
      817           create buf_temp-cmp-parts .
      818           assign
      819             buf_temp-cmp-parts.gds-code  = buf_temp-gds-obj.gds-code
      820             buf_temp-cmp-parts.in-code   = buf_temp-parts.in-code
      821             buf_temp-cmp-parts.out-code  = buf_temp-parts.out-code
      822             buf_temp-cmp-parts.part-code = buf_temp-parts.part-code
      823           .
      824         end.
      825         assign
      826           buf_temp-cmp-parts.remote-fact-qnty = buf_temp-parts.fact-qnty
      827         .
      828       end.
      829     end.
      830     define variable v-error-file-name as character no-undo .
      831     define variable v-log-file-name   as character no-undo .
      832     define variable v-error-exist     as logical   no-undo .
      833     define variable v-error-message   as character no-undo .
      834     define variable v-log-message     as character no-undo .
      835     assign
      836       v-error-exist     = false
      837       v-error-file-name = 'cmdcmpgd.err':u
      838       v-log-file-name   = 'cmdcmpgd.log':u
      839     .
      840     for each buf_temp-cmp-gds-obj
      841     on error undo, return error return-value
      842     :
      843       if buf_temp-cmp-gds-obj.current-fact-qnty <> buf_temp-cmp-gds-obj.remote-fact-qnty
      844       then do:
      845         assign
      846           buf_temp-cmp-gds-obj.error-qnty = true
      847         .
      848       end.
      849       for each buf_temp-cmp-prt-obj
      850         where buf_temp-cmp-prt-obj.gds-code = buf_temp-cmp-gds-obj.gds-code
      851       on error undo, return error return-value
      852       :
      853         if buf_temp-cmp-prt-obj.current-fact-qnty <> buf_temp-cmp-prt-obj.remote-fact-qnty
      854         then do:
      855           assign
      856             buf_temp-cmp-gds-obj.error-qnty = true
      857           .
      858         end.
      859       end.
      860     end.
      861     for each buf_temp-cmp-gds-obj
      862       where buf_temp-cmp-gds-obj.error-qnty = true
      863     on error undo, return error return-value
      864     :
      865       run cur-time in this-procedure
      866         (output v-today
      867         ,output v-time
      868         ) .
      869       assign
      870         v-error-exist   = true
      871         v-error-message = substitute("&1 товар_на_объекте код_товара &2 факт_количество_в_ГБД &3 факт_количество_в_УБД &4 свободное_количество_в_ГБД &5 свободное_количество_в_УБД &6"
      872                                     ,substitute('&1 &2 &3 &4':u
      873                                                ,string(v-today, '99/99/9999':u)
      874                                                ,string(v-time, 'HH:MM:SS':u)
      875                                                ,p-obj-type
      876                                                ,p-obj-code
      877                                                )
      878                                     ,buf_temp-cmp-gds-obj.gds-code
      879                                     ,buf_temp-cmp-gds-obj.current-fact-qnty
      880                                     ,buf_temp-cmp-gds-obj.remote-fact-qnty
      881                                     ,buf_temp-cmp-gds-obj.current-free-qnty
      882                                     ,buf_temp-cmp-gds-obj.remote-free-qnty
      883                                     )
      884                         + chr(10)
      885       .
      886   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      887   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run file-wr in g#library
      888     (input v-error-file-name
      889     ,input v-error-message
      890     )  .
      891       for each buf_temp-cmp-prt-obj
      892         where buf_temp-cmp-prt-obj.gds-code = buf_temp-cmp-gds-obj.gds-code
      893       on error undo, return error return-value
      894       :
      895         run cur-time in this-procedure
      896           (output v-today
      897           ,output v-time
      898           ) .
      899         assign
      900           v-error-message = substitute("  признак_на_объекте код_товара &1 код_признака &2 факт_количество_в_ГБД &3 факт_количество_в_УБД &4 свободное_количество_в_ГБД &5 свободное_количество_в_УБД &6"
      901                                       ,buf_temp-cmp-prt-obj.gds-code
      902                                       ,buf_temp-cmp-prt-obj.prt-code
      903                                       ,buf_temp-cmp-prt-obj.current-fact-qnty
      904                                       ,buf_temp-cmp-prt-obj.remote-fact-qnty
      905                                       ,buf_temp-cmp-prt-obj.current-free-qnty
      906                                       ,buf_temp-cmp-prt-obj.remote-free-qnty
      907                                       )
      908                           + chr(10)
      909         .
      910   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      911   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run file-wr in g#library
      912     (input v-error-file-name
      913     ,input v-error-message
      914     )  .
      915       end.
      916       for each buf_temp-cmp-parts
      917         where buf_temp-cmp-parts.gds-code = buf_temp-cmp-gds-obj.gds-code
      918       on error undo, return error return-value
      919       :
      920         assign
      921           v-error-exist   = true
      922           v-error-message = substitute("  партия код_товара &1 документ &2 резерв &3 код_партии &4 факт_количество_в_ГБД &5 факт_количество_в_УБД &6"
      923                                       ,buf_temp-cmp-parts.gds-code
      924                                       ,buf_temp-cmp-parts.in-code
      925                                       ,buf_temp-cmp-parts.out-code
      926                                       ,buf_temp-cmp-parts.part-code
      927                                       ,buf_temp-cmp-parts.current-fact-qnty
      928                                       ,buf_temp-cmp-parts.remote-fact-qnty
      929                                       )
      930                           + chr(10)
      931         .
      932   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      933   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run file-wr in g#library
      934     (input v-error-file-name
      935     ,input v-error-message
      936     )  .
      937       end.
      938     end.
      939     run cur-time in this-procedure
      940       (output v-today
      941       ,output v-time
      942       ) .
      943     if v-error-exist = true
      944     then do:
      945       assign
      946         v-log-message = substitute("** &1 &2 объект &3 &4 найдены_ошибки_при_сравнении_товаров"
      947                                   ,string(v-today,'99/99/9999':u)
      948                                   ,string(v-time,'HH:MM:SS':U)
      949                                   ,p-obj-type
      950                                   ,p-obj-code
      951                                   )
      952                       + chr(10)
      953       .
      954     end.
      955     else do:
      956       assign
      957         v-log-message = substitute("__ &1 &2 объект &3 &4 сравнение_остатков_прошло_успешно"
      958                                   ,string(v-today,'99/99/9999':u)
      959                                   ,string(v-time,'HH:MM:SS':U)
      960                                   ,p-obj-type
      961                                   ,p-obj-code
      962                                   )
      963                       + chr(10)
      964       .
      965     end.
      966   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      967   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run file-wr in g#library
      968     (input v-log-file-name
      969     ,input v-log-message
      970     )  .
      971   end.
