        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter p-parent-handle as handle no-undo .
        4   define input parameter p-log-handle as handle no-undo .
        5   define input parameter p-imp-handle as handle    no-undo .
        6   define input parameter p-counter  as integer   no-undo .
        7   define input parameter p-table-name as character no-undo .
        8   define input parameter p-db-num as integer   no-undo .
        9   define input  parameter p-int64-id as int64 no-undo .
       10   define output parameter p-ok as logical no-undo .
       11   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       12   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       13   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       14   define variable vss-workfile    as character no-undo init "$Workfile: lob-i.p $":U .
       15   define variable vss-archive     as character no-undo init "$Archive: nws/lob-i.p $":U .
       16   define variable vss-description as character no-undo init "Прием CLOB или BLOB".
       17   procedure vss-get-info :
       18     define output parameter p-vss-revision    like vss-revision    no-undo .
       19     define output parameter p-vss-author      like vss-author      no-undo .
       20     define output parameter p-vss-date        like vss-date        no-undo .
       21     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       22     define output parameter p-vss-archive     like vss-archive     no-undo .
       23     define output parameter p-vss-description like vss-description no-undo .
       24     assign
       25       p-vss-revision    = vss-revision
       26       p-vss-author      = vss-author
       27       p-vss-date        = vss-date
       28       p-vss-workfile    = vss-workfile
       29       p-vss-archive     = vss-archive
       30       p-vss-description = vss-description
       31     .
       32   end procedure.
       33   procedure vss-get-parameters :
       34     define output parameter p-vss-parameters as character no-undo .
       35   end procedure.
       36   define new global shared variable g#vssrevis-logger as handle    no-undo .
       37   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       38   define variable v-vssrevis-logger                   as handle    no-undo .
       39   procedure vss-logevent :
       40     define input  parameter p-extra-paramters as character no-undo .
       41     define variable v-vssrevis-parameters as character no-undo .
       42     do
       43     on error undo, return error return-value
       44     :
       45       if  valid-handle(v-vssrevis-logger)
       46       and v-vssrevis-logger :get-signature("logevent") <> ""
       47       then do:
       48         run vss-get-parameters in this-procedure
       49           (output v-vssrevis-parameters
       50           ).
       51         run logevent in v-vssrevis-logger
       52           (input vss-workfile
       53           ,input vss-revision
       54           ,input v-vssrevis-parameters
       55           ,input p-extra-paramters
       56           ).
       57       end.
       58     end.
       59   end procedure.
       60   assign
       61     v-vssrevis-logger = g#vssrevis-logger
       62   .
       63   if  valid-handle(v-vssrevis-logger)
       64   and v-vssrevis-logger :get-signature("logevent") <> ""
       65   then do:
       66     assign
       67       v-vssrevis-logevent = true
       68     .
       69     run vss-logevent in this-procedure (input vss-description) .
       70   end.
       71   define new global shared variable g#language as character no-undo .
       72   if g#language <> '' and g#language <> 'rus':U then do:
       73     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       74   end.
       75   define new global shared variable g#library  as handle no-undo .
       76   define new global shared variable g#library2 as handle no-undo .
       77   define   shared variable g#auto as logical no-undo.
       78   define   shared variable g#news as logical no-undo.
       79   define   shared variable g#oxml as logical no-undo.
       80   define   shared variable g#esys as logical no-undo.
       81   define   shared variable g#news-source-db as integer no-undo.
       82   define   shared variable g#esys-source-esys as integer no-undo.
       83   define   shared variable g#db-num as integer   no-undo .
       84   define   shared variable g#userid as character no-undo .
       85   define   shared variable g#passwd as character no-undo .
       86   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       87   define temp-table temp-nws-outline no-undo like ub.nws-outline.
       88   define temp-table temp-ext-file-line no-undo like ub.ext-file-line.
       89   procedure lob_clear :
       90     define buffer buf_temp-nws-outline  for temp-nws-outline .
       91     define buffer buf_temp-ext-file-line  for temp-ext-file-line .
       92     do
       93     on error undo, return error return-value
       94     :
       95       for each buf_temp-nws-outline
       96       on error undo, return error return-value
       97       :
       98         delete buf_temp-nws-outline .
       99       end.
      100       for each buf_temp-ext-file-line
      101       on error undo, return error return-value
      102       :
      103         delete buf_temp-ext-file-line .
      104       end.
      105     end.
      106   end procedure.
      107   procedure lob_read :
      108     define input  parameter p-lob-bh      as handle no-undo .
      109     define variable v-read-line             as character no-undo format "X(255)".
      110     define variable v-line-num              as integer   no-undo .
      111     define variable v-size                  as int64     no-undo .
      112     define variable v-cursor                as int64     no-undo .
      113     define variable v-longchar              as longchar  no-undo .
      114     define variable v-memptr                as memptr    no-undo .
      115     define buffer buf_temp-ext-file-line for temp-ext-file-line .
      116     do
      117     on error undo, return error return-value
      118     :
      119       run lob_clear in this-procedure       .
      120       if p-lob-bh:table = 'blob-data':U then do:
      121         COPY-LOB
      122         from object p-lob-bh:buffer-field("bdata"):buffer-value
      123         to v-memptr.
      124       end.
      125       else do:
      126         COPY-LOB
      127         from object p-lob-bh:buffer-field("cdata"):buffer-value
      128         to v-memptr.
      129       end.
      130        v-longchar = BASE64-ENCODE(v-memptr).
      131        COPY-LOB
      132        from v-longchar
      133        to v-memptr.
      134        v-size = get-size(v-memptr).
      135        v-longchar = '':U.
      136       assign
      137         v-line-num = 0
      138       .
      139       repeat while v-cursor < v-size
      140       :
      141         assign
      142           v-read-line = '':U
      143         .
      144         v-read-line = GET-STRING ( v-memptr , v-cursor + 1, (if v-line-num * 2048 <= v-size
      145                                                              then 2048
      146                                                              else (v-size - (v-line-num - 1)* 2048) ) ).
      147         create buf_temp-ext-file-line.
      148         assign
      149         v-line-num = v-line-num + 1
      150         v-cursor = v-cursor + length(v-read-line)
      151         buf_temp-ext-file-line.db-num         = -1
      152         buf_temp-ext-file-line.file-num       = -1
      153         buf_temp-ext-file-line.from-db-num    = -1
      154         buf_temp-ext-file-line.line-num       = v-line-num
      155         buf_temp-ext-file-line.line-text      = v-read-line
      156         .
      157       end.
      158       set-size(v-memptr) = 0.
      159     end.
      160   end procedure.
      161   procedure lob_write :
      162     define input  parameter p-lob-bh        as handle no-undo .
      163     define variable v-memptr as memptr no-undo .
      164     define variable v-memptr1 as memptr no-undo .
      165     define variable v-read-line             as character no-undo format "X(255)".
      166     define variable v-line-num              as integer   no-undo .
      167     define variable v-size                  as int64     no-undo .
      168     define variable v-cursor                as int64     no-undo .
      169     define variable v-longchar              as longchar  no-undo .
      170     define buffer buf_temp-ext-file-line for temp-ext-file-line .
      171     do
      172     on error undo, return error return-value
      173     :
      174       for each buf_temp-ext-file-line
      175       by buf_temp-ext-file-line.db-num
      176       by buf_temp-ext-file-line.file-num
      177       by buf_temp-ext-file-line.from-db-num
      178       by buf_temp-ext-file-line.line-num
      179       on error undo, return error return-value
      180       :
      181         assign
      182         v-size = v-size + length(buf_temp-ext-file-line.line-text).
      183       end.
      184       if v-size = 0 then return.
      185       set-size(v-memptr) = v-size.
      186       set-size(v-memptr1) = integer(8 / 6 * v-size) + 1.
      187       for each buf_temp-ext-file-line
      188       by buf_temp-ext-file-line.db-num
      189       by buf_temp-ext-file-line.file-num
      190       by buf_temp-ext-file-line.from-db-num
      191       by buf_temp-ext-file-line.line-num
      192       on error undo, return error return-value
      193       :
      194         PUT-STRING ( v-memptr , v-cursor + 1, length(buf_temp-ext-file-line.line-text) ) = buf_temp-ext-file-line.line-text.
      195         assign
      196         v-cursor = v-cursor + length(buf_temp-ext-file-line.line-text).
      197       end.
      198       COPY-LOB
      199       from v-memptr
      200       to v-longchar.
      201       v-memptr1 = BASE64-DECODE(v-longchar).
      202       v-longchar = '':U.
      203       if p-lob-bh:table = 'blob-data':U then do:
      204         COPY-LOB
      205         from v-memptr1
      206         to object p-lob-bh:buffer-field("bdata"):buffer-value
      207         .
      208       end.
      209       else do:
      210         COPY-LOB
      211         from v-memptr1
      212         to object p-lob-bh:buffer-field("cdata"):buffer-value
      213         .
      214       end.
      215       set-size(v-memptr) = 0.
      216       set-size(v-memptr1) = 0.
      217     end.
      218   end procedure.
      219   define variable counter    as integer   no-undo .
      220   define variable rec-full   as character no-undo .
      221   define variable v-rec-name as character no-undo .
      222   define variable log-file-name as character no-undo init "":U.
      223   define variable v-md5-signature as character no-undo .
      224   define variable v-lob-bh as handle no-undo .
      225   define variable v-ii as integer   no-undo .
      226   define variable v-jj as integer   no-undo .
      227   define buffer buf_temp-nws-outline for temp-nws-outline .
      228   define buffer buf_temp-ext-file-line for temp-ext-file-line .
      229   define buffer buf_clob-data for ub.clob-data.
      230   define buffer buf_blob-data for ub.blob-data.
      231   define temp-table temp-clob-data no-undo like ub.clob-data.
      232   define temp-table temp-blob-data no-undo like ub.blob-data.
      233   define buffer buf_temp-clob-data for temp-clob-data.
      234   define buffer buf_temp-blob-data for temp-blob-data.
      235   main-block:
      236   do
      237   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      238   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      239   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      240   :
      241     run write-to-log in p-log-handle (
      242           input substitute("Получение &1: БД &2 id &3"
      243                           , p-table-name
      244                           , p-db-num
      245                           , p-int64-id
      246                             )).
      247     do counter = 1 to p-counter
      248     on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      249     on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      250     on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      251     :
      252       if counter modulo 10 = 0
      253       then do:
      254         run write-to-screen in p-log-handle (substitute("Получено записей &1", counter)) no-error.
      255       end.
      256       run nws-imps in p-imp-handle
      257         ( input-output counter
      258          ,output       rec-full
      259         ) no-error.
      260       if error-status :error then do:
      261         undo main-block, return error return-value .
      262       end.
      263       assign
      264         v-rec-name = entry( 1, rec-full, chr(1) )
      265       .
      266       CASE entry(1, v-rec-name, chr(4)) :
      267         when 'nws-outline':U then do:
      268           create buf_temp-nws-outline.
      269           run nws-impl in p-imp-handle
      270             ( input 'nws-outline':U
      271              ,input buffer buf_temp-nws-outline:handle
      272             ) no-error.
      273           if error-status :error then do:
      274             delete buf_temp-nws-outline.
      275             undo main-block, return error return-value .
      276           end.
      277           case p-table-name:
      278             when 'clob-data':U then do:
      279               create buf_temp-clob-data.
      280               assign
      281               v-lob-bh = buffer buf_temp-clob-data:handle.
      282             end.
      283             when 'blob-data':U then do:
      284               create buf_temp-blob-data.
      285               assign
      286               v-lob-bh = buffer buf_temp-blob-data:handle.
      287             end.
      288           end case.
      289           do v-ii = 1 to v-lob-bh:handle:num-fields:
      290             if not (v-lob-bh:buffer-field(v-ii):data-type = 'clob':U
      291                     or
      292                     v-lob-bh:buffer-field(v-ii):data-type = 'blob':U) then do:
      293                 v-jj = v-jj + 1.
      294                 case v-lob-bh:buffer-field(v-ii):data-type:
      295                   when 'character':U then do:
      296                   assign
      297                   v-lob-bh:buffer-field(v-ii):buffer-value = entry(v-jj, buf_temp-nws-outline.charkey_one, chr(3))
      298                   .
      299                   end.
      300                   when 'int64':U then do:
      301                   assign
      302                   v-lob-bh:buffer-field(v-ii):buffer-value = int64(entry(v-jj, buf_temp-nws-outline.charkey_one, chr(3)))
      303                   .
      304                   end.
      305                   when 'integer':U then do:
      306                   assign
      307                   v-lob-bh:buffer-field(v-ii):buffer-value = integer(entry(v-jj, buf_temp-nws-outline.charkey_one, chr(3)))
      308                   .
      309                   end.
      310                   when 'date':U then do:
      311                   assign
      312                   v-lob-bh:buffer-field(v-ii):buffer-value = date(entry(v-jj, buf_temp-nws-outline.charkey_one, chr(3)))
      313                   .
      314                   end.
      315                   when 'logical':U then do:
      316                   assign
      317                   v-lob-bh:buffer-field(v-ii):buffer-value = logical(entry(v-jj, buf_temp-nws-outline.charkey_one, chr(3)))
      318                   .
      319                   end.
      320                 end case.
      321             end.
      322           end.
      323           case p-table-name:
      324             when 'clob-data':U then do:
      325               find first buf_clob-data where
      326                         buf_clob-data.db-num = buf_temp-clob-data.db-num
      327                     and buf_clob-data.int64-id = buf_temp-clob-data.int64-id  no-error.
      328               if not available buf_clob-data then do:
      329                 create buf_clob-data.
      330               end.
      331               buffer-copy buf_temp-clob-data
      332               to buf_clob-data no-lobs.
      333               v-lob-bh = buffer buf_clob-data:handle.
      334             end.
      335             when 'blob-data':U then do:
      336               find first buf_blob-data where
      337                         buf_blob-data.db-num = buf_temp-blob-data.db-num
      338                     and buf_blob-data.int64-id = buf_temp-blob-data.int64-id  no-error.
      339               if not available buf_blob-data then do:
      340                 create buf_blob-data.
      341               end.
      342               buffer-copy buf_temp-blob-data
      343               to buf_blob-data no-lobs.
      344               v-lob-bh = buffer buf_blob-data:handle.
      345             end.
      346           end case.
      347         end.
      348         when 'ext-file-line':U then do:
      349           create buf_temp-ext-file-line.
      350           run nws-impl in p-imp-handle
      351             ( input 'ext-file-line':U
      352              ,input buffer buf_temp-ext-file-line:handle
      353             ) no-error.
      354           if error-status :error then do:
      355             undo main-block, return error return-value .
      356           end.
      357           release buf_temp-ext-file-line.
      358         end.
      359       END CASE.
      360     end.
      361     run lob_write in this-procedure ( input v-lob-bh) .
      362     case p-table-name:
      363       when 'clob-data':U then do:
      364         if v-md5-signature <> buf_temp-clob-data.crc-field then do:
      365           run write-to-log in p-log-handle (
      366                                               substitute("!!!"
      367                                                     )).
      368         end.
      369       end.
      370       when 'blob-data':U then do:
      371         if v-md5-signature <> buf_temp-blob-data.crc-field then do:
      372           run write-to-log in p-log-handle (
      373                                               substitute("!!!"
      374                                                     )).
      375         end.
      376       end.
      377     end case.
      378     p-ok = yes.
      379     return '':U.
      380   end.
      381   procedure write-to-log :
      382   define input parameter p-message as character no-undo .
      383     do
      384     on error undo, return error return-value
      385     :
      386        run write-to-log in p-parent-handle (input p-message) .
      387     end.
      388   end procedure.
