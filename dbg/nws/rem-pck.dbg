        1   block-level on error undo, throw.
        2   define input parameter parparentproc as   widget-handle        no-undo .
        3   define input parameter p-db-num      like ub.db.db-num         no-undo .
        4   def var vss-revision    as character no-undo init "$Revision: 4e080738a7b9, 3543, rls $":U .
        5   def var vss-author      as character no-undo init "$Author: Ostroukhov $":U .
        6   def var vss-date        as character no-undo init "$Date: 2023/11/27 08:31:17 $":U .
        7   def var vss-workfile    as character no-undo init "$Workfile: rem-pck.p $":U .
        8   def var vss-archive     as character no-undo init "$Archive: nws/rem-pck.p $":U .
        9   def var vss-description as character no-undo init "Удаление пакетов СПН по указанной БД".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define new global shared variable g#library  as handle no-undo .
       69   define new global shared variable g#library2 as handle no-undo .
       70   define   shared variable g#auto as logical no-undo.
       71   define   shared variable g#news as logical no-undo.
       72   define   shared variable g#oxml as logical no-undo.
       73   define   shared variable g#esys as logical no-undo.
       74   define   shared variable g#news-source-db as integer no-undo.
       75   define   shared variable g#esys-source-esys as integer no-undo.
       76   define   shared variable g#db-num as integer   no-undo .
       77   define   shared variable g#userid as character no-undo .
       78   define   shared variable g#passwd as character no-undo .
       79   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       80   define  shared variable g#auto-pid           as integer   no-undo .
       81   define  shared variable conn-par             as character no-undo .
       82   define  shared variable g#auto-user-id       as character no-undo .
       83   define  shared variable g#auto-user-login    as character no-undo .
       84   define  shared variable g#auto-user-password as character no-undo .
       85   define  shared variable v-socket             as logical   no-undo .
       86   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       87   define  shared variable auto-window-h     as handle    no-undo .
       88   define  shared variable auto-log-msg-h    as handle    no-undo .
       89   define  shared variable hand-log-msg-h    as handle    no-undo .
       90   define  shared variable log-file-name     as character no-undo initial ? .
       91   define  shared variable add-log-file-name as character no-undo initial ? .
       92   define  shared variable writelogvalue     as character no-undo initial ? .
       93   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       94   procedure cur-time :
       95      define output parameter p-today as date      no-undo .
       96      define output parameter p-time  as integer   no-undo .
       97     do
       98     on error undo, return error
       99     :
      100       define variable v-date1 as date      no-undo .
      101       define variable v-date2 as date      no-undo .
      102       define variable v-time  as integer   no-undo .
      103       assign
      104         v-date1 = today
      105         v-time  = time
      106         v-date2 = today
      107       .
      108       if v-date1 <> v-date2
      109       then do:
      110         assign
      111           v-date1 = today
      112           v-time  = v-time
      113         .
      114       end.
      115       assign
      116         p-today = v-date1
      117         p-time  = v-time
      118       .
      119     end.
      120   end.
      121   function cur-time-date returns character
      122   :
      123     return string(today, '99/99/9999':U) .
      124   end.
      125   function cur-time-mjd returns decimal
      126   :
      127     define variable v-date as date      no-undo .
      128     define variable v-time as integer   no-undo .
      129     run cur-time in this-procedure
      130       (output v-date
      131       ,output v-time
      132       ) .
      133     return integer(v-date) - 2400002 + (v-time / 86400) .
      134   end.
      135   function cur-time-get-ending-index returns integer
      136   (input p-number as integer
      137   )
      138   :
      139     if p-number < 0
      140     or p-number = ?
      141     then do:
      142       return 1 .
      143     end.
      144     define variable v-rest as integer   no-undo .
      145     assign
      146       p-number = p-number modulo 100
      147     .
      148     if p-number < 20
      149     then do:
      150       assign
      151         v-rest = p-number
      152       .
      153     end.
      154     else do:
      155       assign
      156         v-rest = p-number modulo 10
      157       .
      158     end.
      159     case v-rest :
      160       when 1
      161       then do:
      162         return 2 .
      163       end.
      164       when 2 or
      165       when 3 or
      166       when 4
      167       then do:
      168         return 3 .
      169       end.
      170       otherwise do:
      171         return 1 .
      172       end.
      173     end case .
      174   end.
      175   procedure cur-time-mjd-to-date :
      176      define input  parameter i-mjd-diff as decimal no-undo.
      177      define output parameter o-Date     as date    no-undo.
      178      define output parameter o-Time     as integer no-undo.
      179      define variable v-day-number as integer   no-undo .
      180      if    i-mjd-diff < 0
      181         or i-mjd-diff = ?
      182      then do:
      183         return "?" .
      184      end.
      185      assign
      186         v-day-number = truncate(i-mjd-diff,0).
      187         o-Date = date(v-day-number + 2400002).
      188         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      189     .
      190   end.
      191   function cur-time-mjd-to-string returns character
      192   (input p-mjd-diff as decimal
      193   )
      194   :
      195     define variable v-day-number as integer   no-undo .
      196     define variable v-seconds    as integer   no-undo .
      197     define variable v-hour       as integer   no-undo .
      198     define variable v-min        as integer   no-undo .
      199     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      200     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      201     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      202     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      203     if p-mjd-diff < 0
      204     or p-mjd-diff = ?
      205     then do:
      206       return "?" .
      207     end.
      208     assign
      209       v-day-number = integer(truncate(p-mjd-diff,0))
      210       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      211     .
      212     if v-seconds > 86400
      213     then do:
      214       assign
      215         v-seconds = 86400 - 1
      216       .
      217     end.
      218     if v-seconds < 0
      219     then do:
      220       assign
      221         v-seconds = 0
      222       .
      223     end.
      224     assign
      225       v-hour = truncate(v-seconds / 3600, 0)
      226     .
      227     assign
      228       v-seconds = v-seconds modulo 3600
      229     .
      230     assign
      231       v-min = truncate(v-seconds / 60, 0)
      232     .
      233     assign
      234       v-seconds = v-seconds modulo 60
      235     .
      236     return
      237         (if v-day-number <> 0
      238           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      239           else ""
      240         )
      241       + (if v-day-number <> 0 or v-hour <> 0
      242           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      243           else ""
      244         )
      245       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      246           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      247           else ""
      248         )
      249       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      250       .
      251   end.
      252   function cur-time-string returns character
      253   :
      254     define variable v-date as date      no-undo .
      255     define variable v-time as integer   no-undo .
      256     run cur-time in this-procedure
      257       (output v-date
      258       ,output v-time
      259       ) .
      260     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      261   end.
      262   function cur-time-string-sec returns character
      263   :
      264     define variable v-date as date      no-undo .
      265     define variable v-time as integer   no-undo .
      266     run cur-time in this-procedure
      267       (output v-date
      268       ,output v-time
      269       ) .
      270     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      271   end.
      272   function cur-time-custom  returns character
      273   (input p-prefix as character
      274   ,input p-date-format as character
      275   ,input p-delimiter as character
      276   ,input p-time-format as character
      277   ,input p-suffix as character
      278   )
      279   :
      280     define variable v-date as date      no-undo .
      281     define variable v-time as integer   no-undo .
      282     run cur-time in this-procedure
      283       (output v-date
      284       ,output v-time
      285       ) .
      286     return
      287       p-prefix
      288       + string(v-date, p-date-format)
      289       + p-delimiter
      290       + string(v-time, p-time-format)
      291       + p-suffix
      292       .
      293   end.
      294   function cur-time-print  returns character
      295   :
      296     define variable v-date as date      no-undo .
      297     define variable v-time as integer   no-undo .
      298     run cur-time in this-procedure
      299       (output v-date
      300       ,output v-time
      301       ) .
      302     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      303   end.
      304   function cur-time-datetime returns datetime
      305   :
      306     define variable v-char as character no-undo .
      307     define variable v-datetime as datetime no-undo .
      308     v-char = cur-time-string().
      309     v-datetime = datetime(v-char).
      310     return  v-datetime.
      311   end.
      312   function cur-time-string-msec returns character
      313   :
      314     define variable v-date as datetime  no-undo .
      315     v-date = now.
      316     return string(v-date) .
      317   end.
      318   define stream LogStream .
      319   define variable mNoTime as logical no-undo.
      320   procedure write-to-log-notime :
      321     define input param i-str as character no-undo .
      322     mNoTime = yes.
      323     run write-to-log (i-str).
      324     mNoTime = no.
      325   end.
      326   procedure write-to-log :
      327     define input param p-str as character no-undo .
      328     do
      329     on error  undo, return error substitute( "&1 (write-to-log). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      330     on stop   undo, return error substitute( "&1 (write-to-log). stop", vss-workfile )
      331     on endkey undo, return error substitute( "&1 (write-to-log). endkey", vss-workfile )
      332     :
      333       define variable log-res        as logical   no-undo .
      334       define variable v-jj           as integer   no-undo .
      335       if    mNoTime
      336          or writelogvalue eq "AsyncProc"
      337       then
      338          p-str = substitute( "&1 (pid: &2) &3&4"   , g#auto-user-id, g#auto-pid,                        p-str, chr(10) ).
      339       else
      340          p-str = substitute( "&1 (pid: &2) &3 &4&5", g#auto-user-id, g#auto-pid, cur-time-string-sec(), p-str, chr(10) ).
      341       if auto-log-msg-h <> ? then do:
      342         log-res = auto-log-msg-h:move-to-eof( ) .
      343         log-res = auto-log-msg-h:insert-string( p-str ).
      344       end.
      345       if hand-log-msg-h <> ? then do:
      346         log-res = hand-log-msg-h:move-to-eof( ) .
      347         log-res = hand-log-msg-h:insert-string( p-str ).
      348       end.
      349       assign
      350         p-str = replace(p-str, (chr(10) + chr(13)), chr(10) )
      351         p-str = replace(p-str, (chr(13) + chr(10)), chr(10) )
      352         p-str = replace(p-str, chr(10), (chr(13) + chr(10)) )
      353       .
      354       if add-log-file-name <> ? then do:
      355         do v-jj = 1 to num-entries(add-log-file-name, chr(1)):
      356           run gbl/fileapnd.p
      357             ( input entry(v-jj, add-log-file-name, chr(1) )
      358             ,input p-str
      359             ,input 20
      360             ) no-error .
      361           if error-status:error then do:
      362             return error return-value .
      363           end.
      364         end.
      365       end.
      366       if writelogvalue eq "AsyncProc"
      367       then do:
      368          p-str = trim(p-str, (chr(13) + chr(10)) )
      369       .
      370          Publish "WriteLogAsunc" (p-str,yes).
      371       end.
      372       else if writelogvalue <> "yes" then do:
      373         run gbl/fileapnd.p
      374           ( input log-file-name
      375           ,input p-str
      376           ,input 20
      377           ) no-error .
      378         if error-status:error then do:
      379           return error return-value .
      380         end.
      381       end.
      382     end.
      383   end procedure.
      384   procedure write-to-screen :
      385     define input param p-str as character no-undo .
      386     do
      387     on error  undo, return error substitute( "&1 (write-to-screen). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      388     on stop   undo, return error substitute( "&1 (write-to-screen). stop", vss-workfile )
      389     on endkey undo, return error substitute( "&1 (write-to-screen). endkey", vss-workfile )
      390     :
      391       define variable log-res as logical no-undo.
      392       assign
      393         p-str = substitute( "&1 (pid: &2) &3 &4&5", g#auto-user-id, g#auto-pid, cur-time-string-sec(), p-str, chr(10) )
      394       .
      395       if auto-log-msg-h <> ?
      396       then do:
      397         log-res = auto-log-msg-h:move-to-eof( ) .
      398         log-res = auto-log-msg-h:insert-string( p-str ).
      399       end.
      400       if hand-log-msg-h <> ?
      401       then do:
      402         log-res = hand-log-msg-h:move-to-eof( ) .
      403         log-res = hand-log-msg-h:insert-string( p-str ).
      404       end.
      405     end.
      406   end procedure.
      407   procedure send-msg-to-email :
      408     define input  parameter p-subject      as character no-undo .
      409     define input  parameter p-text-err     as character no-undo .
      410     define input  parameter p-attach-files as character no-undo .
      411     do
      412     on error  undo, return error substitute( "&1 (send-msg-to-email). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      413     on stop   undo, return error substitute( "&1 (send-msg-to-email). stop", vss-workfile )
      414     on endkey undo, return error substitute( "&1 (send-msg-to-email). endkey", vss-workfile )
      415     :
      416       define variable v-tth             as handle    no-undo .
      417       define variable v-value-character as character no-undo .
      418       define variable v-value-date      as date      no-undo .
      419       define variable v-value-decimal   as decimal   no-undo .
      420       define variable v-value-integer   as integer   no-undo .
      421       define variable v-value-logical   as logical   no-undo .
      422       define variable v-param-type      as character no-undo .
      423       define variable v-email       as character no-undo .
      424       define variable v-tmp-str     as character no-undo .
      425       define variable v-tmp1-str    as character no-undo .
      426       define variable v-ind         as integer   no-undo .
      427       define variable v-num-entries as integer   no-undo .
      428       delete object v-tth no-error.
      429       run adm/shattri.p
      430         ( input "get":U
      431          ,input  "":U
      432          ,input  0
      433          ,input  'auto-task':U
      434          ,input  'send-msg-to-email':U
      435          ,output v-value-character
      436          ,output v-value-date
      437          ,output v-value-decimal
      438          ,output v-value-integer
      439          ,output v-value-logical
      440          ,output v-param-type
      441          ,input-output table-handle v-tth
      442         ) no-error .
      443       if not error-status :error  then do:
      444         assign
      445           v-tmp-str = v-value-character
      446         .
      447       end.
      448       delete object v-tth no-error.
      449       assign
      450         v-tmp-str     = replace(v-tmp-str, (chr(10) + chr(13)), chr(44) )
      451         v-tmp-str     = replace(v-tmp-str, (chr(13) + chr(10)), chr(44) )
      452         v-tmp-str     = replace(v-tmp-str, chr(10), chr(44) )
      453         v-num-entries = num-entries( v-tmp-str, chr(44) )
      454         v-email       = "":U
      455       .
      456       do v-ind = 1 to v-num-entries
      457       :
      458         assign
      459           v-tmp1-str = entry( v-ind, v-tmp-str, chr(44) )
      460         .
      461         if trim( v-tmp1-str ) <> "":U then do:
      462           if v-email = "":U then do:
      463             assign
      464               v-email = v-tmp1-str
      465             .
      466           end.
      467           else do:
      468             assign
      469               v-email = v-email + chr(44) + v-tmp1-str
      470             .
      471           end.
      472         end.
      473       end.
      474       if v-email <> "":U then do:
      475         run gbl/sendmail.p
      476           ( input v-email
      477           , input p-subject
      478           , input p-text-err
      479           , input p-attach-files
      480           ) no-error .
      481         if error-status :error
      482           or return-value <> "":U
      483         then do:
      484           return error substitute( "&1 (send-msg-to-email). &2", vss-workfile, return-value ) .
      485         end.
      486       end.
      487     end.
      488   end procedure.
      489   define  shared variable nws-exch-dir as character no-undo .
      490   define  shared variable nws-heap-dir as character no-undo .
      491   define variable err-mess as character no-undo .
      492   define temp-table t-pck-conf no-undo
      493     field db-num-dst      as integer
      494     field db-num-src      as integer
      495     field pack-num        as integer
      496     field total-recs      as integer
      497     field sys-key         as character
      498     field src_db-key      as character
      499     field dst_db-key      as character
      500     field ver-num         as character
      501     field prev-crc        as character
      502     field actual-date     as date
      503     field actual-time-int as integer
      504   .
      505   do
      506   on error undo, return error
      507   :
      508     define stream dir-stream .
      509     define buffer buf_db       for ub.db .
      510     define buffer buf_pck-sent for ub.pck-sent.
      511     define buffer buf_pck-rcvd for ub.pck-rcvd .
      512     define variable v-pck-for-db    as integer   no-undo .
      513     define variable v-add-to-list  as logical   no-undo .
      514     define variable v-list-action  as character no-undo .
      515     define variable v-action       as character no-undo .
      516     define variable v-dir-name     as character no-undo .
      517     define variable v-pack-num     as integer   no-undo .
      518     define variable v-pack-name    as character no-undo .
      519     define variable v-source-dir   as character no-undo .
      520     define variable v-target-dir   as character no-undo .
      521     define variable v-temp-dir     as character no-undo .
      522     define variable v-ind          as integer   no-undo .
      523     define variable v-filename     as character no-undo .
      524     define variable v-fullfilename as character no-undo .
      525     define variable v-file-cnt     as integer   no-undo .
      526     define variable v-count-del      as integer   no-undo .
      527     define variable v-count-need-del as integer   no-undo .
      528     define variable v-today        as date      no-undo .
      529     define variable v-time         as integer   no-undo .
      530     find first buf_db no-lock
      531       where buf_db.db-num = p-db-num
      532       no-error
      533     .
      534     if not available buf_db then do:
      535       run write-to-log( substitute( "&1. БД &2 не найдена", vss-workfile, p-db-num ) ) .
      536       return error.
      537     end.
      538     if buf_db.save-packs = ? then do:
      539       return .
      540     end.
      541     if g#db-num = 0 then do:
      542       assign
      543         v-pck-for-db = buf_db.db-num
      544       .
      545     end.
      546     else do:
      547       assign
      548         v-pck-for-db = 0
      549       .
      550     end.
      551     run write-to-log( substitute("Анализ необходимости удаления пакетов СПН по БД &1", v-pck-for-db ) ) .
      552     run nws/lock-nws.p
      553       ( input buf_db.db-num
      554        ,buffer buf_db
      555       ) no-error.
      556     if error-status:error then do:
      557       run write-to-log( substitute( "&1. &2", vss-workfile, return-value ) ).
      558       return .
      559     end.
      560     run cur-time in this-procedure
      561       ( output v-today
      562        ,output v-time
      563       ) no-error .
      564     if error-status :error then do:
      565       run write-to-log( substitute( "&1. Ошибка при определении текущего времени. &2&3&2&4", vss-workfile, chr(10), error-status :get-message(1) , return-value )
      566                       ) .
      567       return error.
      568     end.
      569     assign
      570       v-list-action    = "put,get":U
      571       v-file-cnt       = 0
      572       v-count-del      = 0
      573       v-count-need-del = 0
      574     .
      575     do v-ind = 1 to 2
      576     :
      577       assign
      578         v-action   = entry( v-ind, v-list-action )
      579         v-pack-num = ?
      580       .
      581       run nws/pck-num.p
      582         ( input v-action
      583          ,input v-pck-for-db
      584          ,input-output v-pack-num
      585          ,output v-pack-name
      586          ,output v-source-dir
      587          ,output v-target-dir
      588          ,output v-temp-dir
      589         ) no-error.
      590       if error-status:error then do:
      591         run write-to-log( substitute( "&1. Ошибка при генерации номера пакета. &2&3&2&4", vss-workfile, chr(10), error-status:get-message(1), return-value ) ) .
      592       end.
      593       if v-action = "put":U  then do:
      594         assign
      595           v-dir-name = v-source-dir
      596         .
      597       end.
      598       else do:
      599         assign
      600           v-dir-name = v-target-dir
      601         .
      602       end.
      603       assign
      604         file-info :file-name = v-dir-name
      605       .
      606       if file-info :full-pathname = ""
      607       or file-info :full-pathname = ?  then do:
      608         message
      609           vss-workfile vss-revision vss-description skip
      610           substitute( "Каталог: &1 ('heap') не найден !!!", v-dir-name ) skip
      611           return-value skip
      612           error-status :get-message ( error-status :num-messages )
      613           view-as alert-box error
      614         .
      615         undo, return error .
      616       end.
      617       assign
      618         v-dir-name = file-info :full-pathname
      619       .
      620       input stream dir-stream from os-dir ( v-dir-name ) no-attr-list no-echo .
      621       repeat:
      622         import stream dir-stream v-filename v-fullfilename .
      623         assign
      624           file-info :file-name = v-fullfilename
      625         .
      626         if caps( file-info :file-type ) begins "F":U then do:
      627           assign
      628             v-file-cnt = v-file-cnt + 1
      629           .
      630           if     file-info :file-mod-date + buf_db.save-packs < v-today
      631              and num-entries( v-filename, "." ) > 1
      632              and lookup(entry( num-entries( v-filename, ".":U ), v-filename, ".":U ), "txt":U) > 0
      633              and v-filename begins "p":U
      634           then do:
      635             assign
      636               v-pack-num    = integer( substring( v-filename, 2, r-index(v-filename, '.':U) - 1 ) )
      637               v-add-to-list = true
      638             no-error.
      639             if not error-status:error
      640             then do:
      641               case v-action :
      642                 when "put":U then do:
      643                   find first buf_pck-sent no-lock
      644                     where buf_pck-sent.db-num   = v-pck-for-db
      645                       and buf_pck-sent.pack-num = v-pack-num
      646                   no-error .
      647                   if   not available buf_pck-sent
      648                     or buf_pck-sent.rcvd <> true
      649                   then do:
      650                     assign
      651                       v-add-to-list = false
      652                     .
      653                   end.
      654                 end.
      655                 when "get":U then do:
      656                   find first buf_pck-rcvd no-lock
      657                     where buf_pck-rcvd.db-num   = v-pck-for-db
      658                       and buf_pck-rcvd.pack-num = v-pack-num
      659                   no-error .
      660                   if not available buf_pck-rcvd then do:
      661                     assign
      662                       v-add-to-list = false
      663                     .
      664                   end.
      665                 end.
      666               end case.
      667               if v-add-to-list = true then do:
      668                 if v-count-need-del = 0 then do:
      669                   run write-to-log( substitute("Удаление пакетов СПН по БД &1", v-pck-for-db ) ) .
      670                 end.
      671                 assign
      672                   v-count-need-del = v-count-need-del + 1
      673                 .
      674                 run gbl/del-file.p
      675                   ( input file-info :full-pathname
      676                   ) no-error .
      677                 if error-status:error then do:
      678                   run write-to-log( substitute( "&1. Ошибка при удалении пакета. &2&3&2&4", vss-workfile, chr(10), error-status:get-message(1), return-value )
      679                                 ) .
      680                 end.
      681                 else do:
      682                   assign
      683                     v-count-del = v-count-del + 1
      684                   .
      685                 end.
      686               end.
      687             end.
      688           end.
      689         end.
      690       end.
      691       input stream dir-stream close.
      692     end.
      693     if v-count-need-del > 0 then do:
      694       run write-to-log( substitute("Анализ пакетов по БД &1 завершен. Просмотрено &2 файлов. Удалено &3 из &4 старых пакетов.", v-pck-for-db, v-file-cnt, v-count-del, v-count-need-del ) ) .
      695     end.
      696     else do:
      697       run write-to-log( substitute("Анализ пакетов по БД &1 завершен. Просмотрено &2 файлов. Старых пакетов не обнаружено.", v-pck-for-db, v-file-cnt ) ) .
      698     end.
      699   end.
