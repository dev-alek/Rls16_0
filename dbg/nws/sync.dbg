      498     field dst_db-key      as character
      499     field ver-num         as character
      500     field prev-crc        as character
      501     field actual-date     as date
      502     field actual-time-int as integer
      503   .
      504   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      505   define new global shared variable g#attr-lib  as handle no-undo .
      506   define variable v-attr-lib-variable as handle no-undo .
      507   procedure db-attr-code :
      508     define input  parameter p-code           as character no-undo .
      509     define output parameter p-type           as character no-undo .
      510     define output parameter p-format         as character no-undo .
      511     define output parameter p-label          as character no-undo .
      512     define output parameter p-user-can-edit  as logical   no-undo .
      513     define output parameter p-output-display as logical   no-undo .
      514     define output parameter p-other          as character no-undo .
      515     do
      516     on error undo, return error
      517     :
      518           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run db-attr-code in g#attr-lib
      519         (input  p-code
      520         ,output p-type
      521         ,output p-format
      522         ,output p-label
      523         ,output p-user-can-edit
      524         ,output p-output-display
      525         ,output p-other
      526         ) no-error .
      527       if error-status :error
      528       then do:
      529         undo, return error return-value .
      530       end.
      531     end.
      532   end procedure.
      533   procedure db-attr-tooltip :
      534     define input  parameter p-code    as character no-undo .
      535     define output parameter p-tooltip as character no-undo .
      536     define output parameter p-label   as character no-undo .
      537     do
