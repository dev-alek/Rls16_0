     1128   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1129   define variable v-waitfram-action01         as character   no-undo .
     1130   define variable v-waitfram-action02         as character   no-undo .
     1131   define variable v-waitfram-action03         as character   no-undo .
     1132   define variable mWaitFramTextBeg            as character   no-undo.
     1133   define variable mWaitFramTextEnd            as character   no-undo.
     1134   define variable mWaitFramView               as logical     no-undo.
     1135   define variable mWaitProcEvent              as logical     no-undo init yes.
     1136   define variable mWaitFramInterval           as integer     no-undo init 1 .
     1137   define variable mWaitFramStop               as logical     no-undo.
     1138   define variable mWaitFramStopUser           as logical     no-undo.
     1139   define variable mWaitFramStopTimeOut        as logical     no-undo.
     1140   define variable mWaitFramStartProc          as datetime-tz no-undo.
     1141   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     1142   define button B-WaitFramStop auto-end-key
     1143        label "Стоп"
     1144        size 10 by 1 tooltip "Остоновить процесс".
     1145   define button B-viewProcInfo
     1146        label "Информация"
     1147        size 15 by 1 tooltip "Информация о процесс".
     1148   define frame waitfram
     1149     v-waitfram-action01 format "x(72)" no-label skip
     1150     v-waitfram-action02 format "x(72)" no-label skip
     1151     v-waitfram-action03 format "x(72)" no-label skip
     1152     B-viewProcInfo
     1153     B-WaitFramStop at row 4 col 30
     1154     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1155     .
     1156   define new global shared variable mBatchMode as logical no-undo init ?.
     1157   define variable mFramBachModHandle as handle no-undo.
     1158   mFramBachModHandle = frame waitfram:handle.
     1159   define variable mFameOldVis as logical no-undo.
     1160   define variable mVisCUrentVin as logical no-undo.
     1161   if session:batch-mode
     1162   then
     1163      mBatchMode = yes.
     1164   if mBatchMode = ? then do:
     1165     mVisCUrentVin = current-window:visible.
     1166     mFameOldVis = mFramBachModHandle:visible.
     1167     mFramBachModHandle:visible  = yes.
     1168     mBatchMode = mFramBachModHandle:visible ne yes.
     1169     mFramBachModHandle:visible = mFameOldVis.
     1170     current-window:visible = mVisCUrentVin.
     1171   end.
     1172    if  log-manager:logfile-name ne ?
     1173     then DO:
     1174         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1175         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1176         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1177     end.
     1178   on choose of B-WaitFramStop in frame waitfram
     1179   do:
     1180     mWaitFramStop = yes.
     1181     mWaitFramStopUser = yes.
     1182   end.
     1183   function waitfram-check-timeout returns logical():
     1184      define variable vtime as int64 no-undo.
     1185      if mWaitFramStopTimeOut
     1186      then
     1187         return yes.
     1188      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1189      if     mWaitFramTimeOut ne ?
     1190         and mWaitFramTimeOut ne 0
     1191         and mWaitFramTimeOut lt vtime
     1192      then do:
     1193         mWaitFramStopTimeOut = yes.
     1194      end.
     1195      return mWaitFramStopTimeOut.
     1196   end.
     1197   procedure waitfram-hide :
     1198     if not session:batch-mode
     1199     then do
     1200     on error undo, return error return-value
     1201     :
     1202       pause 0 before-hide .
     1203       if not mBatchMode then
     1204         hide frame waitfram .
     1205     if     not mWaitFramView
     1206        and mWaitProcEvent
     1207     then
     1208       process events .
     1209     end.
     1210   end procedure.
     1211   procedure waitfram-show :
     1212     define input  parameter p-message as character no-undo .
     1213     define variable v-left-margin as integer   no-undo .
     1214     if not session:batch-mode
     1215     then do
     1216     on error undo, return error return-value
     1217     :
     1218       if length(p-message) <= 70 then do:
     1219         assign
     1220           v-left-margin = integer((70 - length(p-message)) / 2)
     1221         .
     1222         assign
     1223           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1224         .
     1225         assign
     1226           v-waitfram-action01 = " "
     1227           v-waitfram-action02 = " "
     1228                                    + fill(" ", v-left-margin)
     1229                                    + p-message
     1230           v-waitfram-action03 = " "
     1231         .
     1232       end.
     1233       else do:
     1234         define variable vRindex1 as integer no-undo.
     1235         define variable vRindex2 as integer no-undo.
     1236         vRindex1 = r-index(p-message," ",70).
     1237         if vRindex1 = 0
     1238         then
     1239            vRindex1 = 70.
     1240         if length(p-message)  <= vRindex1 + 70 then do:
     1241           assign
     1242             v-waitfram-action01 = " "
     1243             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1244             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1245           .
     1246         end.
     1247         else do:
     1248           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1249           if vRindex2 <= vRindex1
     1250           then
     1251              vRindex2 = vRindex1 + 70.
     1252           assign
     1253             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1254             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1255             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1256           .
     1257         end.
     1258       end.
     1259       B-viewProcInfo:visible   in frame waitfram = no.
     1260       B-viewProcInfo:sensitive in frame waitfram = no.
     1261       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1262       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1263       if  (   mWaitFramView
     1264          or  mWaitProcEvent)
     1265          and not mBatchMode
     1266       then
     1267          display
     1268             v-waitfram-action01 skip
     1269             v-waitfram-action02 skip
     1270             v-waitfram-action03 skip
     1271          with frame waitfram .
     1272       if     mWaitFramView
     1273          then do:
     1274             if     mWaitFramInterval ne ?
     1275                and not mBatchMode
     1276             then
     1277                wait-for go of frame waitfram pause mWaitFramInterval.
     1278          end.
     1279          else
     1280             if     mWaitProcEvent
     1281                and not mBatchMode
     1282             then
     1283                process events .
     1284     end.
     1285   end procedure.
     1286      procedure waitfram-show-this:
     1287         define input  parameter iInterval as int64 no-undo.
     1288         define variable vtime as int64 no-undo.
     1289         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1290         mWaitFramInterval = iInterval.
     1291         run waitfram-show (substitute("&1&2 &3&4" ,
     1292                                       mWaitFramTextBeg ,
     1293                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1294                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1295                                       mWaitFramTextEnd
     1296                                      )
     1297                           ).
     1298      end.
     1299      procedure WaitFramRunPause:
     1300         define input  parameter iInterval as dec no-undo.
     1301         define variable vStart  as datetime-tz no-undo.
     1302         define variable vend    as datetime-tz no-undo.
     1303         define variable vint as int64 no-undo.
     1304         define variable vOk as logical no-undo.
     1305         vStart = now.
     1306         vend   = vStart.
     1307         publish "WaitFramPause" (iInterval,output vOk).
     1308         vend   =  now.
     1309         vint = vend - vStart.
     1310         vint = iInterval - vint / 1000.
     1311         if     not mWaitFramStop
     1312            and (   vint > 0
     1313                 or (    not vOk
     1314                     and iInterval eq ?
     1315                     )
     1316                 )
     1317         then
     1318            run waitfram-show-this (iInterval).
     1319         vend   =  now.
     1320         vint = vend - vStart.
     1321         vint = iInterval - vint / 1000.
     1322         if     not mWaitFramStop
     1323            and vint > 0
     1324         then do:
     1325            run gbl/pause.p (vint * 1000).
     1326         end.
     1327         if iInterval ne ?
     1328         then
     1329            publish "WaitFramStop".
     1330         waitfram-check-timeout().
     1331      end.
     1332      procedure WaitFramWaitFor:
     1333         define input  parameter iInterval as dec no-undo.
     1334         assign
     1335            mWaitFramStartProc   = now
     1336            mWaitFramStopUser    = no
     1337            mWaitFramStopTimeOut = no
     1338         .
     1339         block-wait:
     1340         do while not mWaitFramStop:
     1341            run WaitFramRunPause (iInterval).
     1342            if  waitfram-check-timeout()
     1343            then do:
     1344               leave block-wait.
     1345            end.
     1346         end.
     1347         run waitfram-hide.
     1348      end.
     1349   procedure waitfram-join :
     1350     define input  parameter p-line-1  as character no-undo .
     1351     define input  parameter p-line-2  as character no-undo .
     1352     define input  parameter p-line-3  as character no-undo .
     1353     define output parameter p-message as character no-undo .
     1354     do
     1355     on error undo, return error return-value
     1356     :
     1357       assign
     1358         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1359                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1360                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1361       .
     1362     end.
     1363   end procedure.
     1364   function waitfram-join-function returns character
     1365     (input p-line-1 as character
     1366     ,input p-line-2 as character
     1367     ,input p-line-3 as character
     1368     ).
     1369     define variable v-message as character no-undo .
     1370     run waitfram-join in this-procedure
     1371       (input  p-line-1
     1372       ,input  p-line-2
     1373       ,input  p-line-3
     1374       ,output v-message
     1375       ) .
     1376     return v-message .
     1377   end function .
     1378   define variable p-news as logical no-undo.
     1379   define variable v-real-last-sent-pck as integer no-undo .
     1380   define variable v-real-last-rcv-pck as integer no-undo .
     1381   define variable v-curr-obj-type as character no-undo .
     1382   define variable v-curr-obj-code as integer no-undo .
     1383   define variable v-corr-date             as date         no-undo.
     1384   define variable v-corr-time             as integer      no-undo.
     1385   define variable v-cmd-proc-handle as handle no-undo .
     1386   define variable v-command as character no-undo .
     1387   define variable v-cmd-code as integer no-undo .
     1388   define variable v-db-list as character no-undo .
     1389   define buffer buf_c-user-log for c-user-log .
     1390   DEFINE BUTTON b-cancel AUTO-END-KEY
     1391        LABEL "Отмена"
     1392        SIZE 15 BY 1.14
     1393        BGCOLOR 8 .
     1394   DEFINE BUTTON b-ok AUTO-GO
     1395        LABEL "Синхронизация"
     1396        SIZE 15 BY 1.14
     1397        BGCOLOR 8 .
     1398   DEFINE VARIABLE v-last-rcv-pack AS INTEGER FORMAT ">>>>>>9":U INITIAL 0
     1399        LABEL "Номер последнего принятого пакета в БД "
     1400        VIEW-AS FILL-IN
     1401        SIZE 10 BY 1 NO-UNDO.
     1402   DEFINE VARIABLE v-last-sent-pack AS INTEGER FORMAT ">>>>>>9":U INITIAL 0
     1403        LABEL "Номер последнего отправленного пакета из БД "
     1404        VIEW-AS FILL-IN
     1405        SIZE 10 BY 1 NO-UNDO.
     1406   DEFINE FRAME Dialog-Frame
     1407        b-cancel AT ROW 1.24 COL 2
     1408        b-ok AT ROW 1.24 COL 17
     1409        v-last-rcv-pack AT ROW 3.14 COL 49 COLON-ALIGNED WIDGET-ID 2
     1410        v-last-sent-pack AT ROW 4.33 COL 49 COLON-ALIGNED WIDGET-ID 4
     1411        SPACE(1.79) SKIP(0.95)
     1412       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1413            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1414            TITLE "Синхронизация новостей для БД " + string(p-dbnum)
     1415            DEFAULT-BUTTON b-ok CANCEL-BUTTON b-cancel WIDGET-ID 100.
     1416   ASSIGN
     1417          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1418          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1419   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1420   DO:
     1421     APPLY "END-ERROR":U TO SELF.
     1422   END.
     1423   ON CHOOSE OF b-ok IN FRAME Dialog-Frame
     1424   DO:
     1425     assign
     1426       v-last-rcv-pack
     1427       v-last-sent-pack
     1428     .
     1429     for each pck-sent no-lock where pck-sent.db-num = p-dbnum :
     1430       v-real-last-sent-pck = max(v-real-last-sent-pck, pck-sent.pack-num) .
     1431     end.
     1432     for each pck-rcvd no-lock where pck-rcvd.db-num = p-dbnum :
     1433       v-real-last-rcv-pck = max(v-real-last-rcv-pck, pck-rcvd.pack-num) .
     1434     end.
     1435     if v-last-rcv-pack > v-real-last-sent-pck
     1436     then do :
     1437       message "Номер последнего принятого пакета в УБД больше номера последнего отправленного пакета в ГБД!" view-as alert-box .
     1438       return no-apply .
     1439     end.
     1440     if v-last-sent-pack > v-real-last-rcv-pck
     1441     then do :
     1442       message "Номер последнего отправленного пакета из УБД больше номера последнего принятого пакета в ГБД!" view-as alert-box .
     1443       return no-apply .
     1444     end.
     1445     if v-last-rcv-pack = v-real-last-sent-pck
     1446     and v-last-sent-pack = v-real-last-rcv-pck
     1447     then do :
     1448       message "Номера последних пакетов в ГБД и УБД совпадают. Синхронизация не требуется." view-as alert-box .
     1449       return no-apply .
     1450     end.
     1451     find first ub.clients no-lock where ub.clients.obj-type = 'маг':U
     1452                                     and ub.clients.stts = 0
     1453                                     and ub.clients.db-num = p-dbnum
     1454                                     no-error.
     1455     if not available ub.clients
     1456     then do :
     1457       message ("Не найден магазин в УБД " + string(p-dbnum)) view-as alert-box.
     1458       return no-apply .
     1459     end.
     1460     for each pck-sent exclusive-lock where pck-sent.db-num = p-dbnum and pck-sent.pack-num > v-last-rcv-pack :
     1461       for each route exclusive-lock where route.db-num = p-dbnum and route.last-pack = pck-sent.pack-num :
     1462         delete route .
     1463       end.
     1464       delete pck-sent .
     1465     end.
     1466     for each pck-rcvd exclusive-lock where pck-rcvd.db-num = p-dbnum and pck-rcvd.pack-num > v-last-sent-pack :
     1467       delete pck-rcvd .
     1468     end.
     1469     for each route exclusive-lock where route.db-num = p-dbnum and route.last-pack = -1 :
     1470       delete route .
     1471     end.
     1472     v-curr-obj-type = ub.clients.obj-type .
     1473     v-curr-obj-code = ub.clients.obj-code .
     1474     run waitfram-show in this-procedure ("Формирование данных для синхронизации. Ждите...").
     1475     run create-routes no-error.
     1476     if error-status :error then do:
     1477       run write-to-log in this-procedure ( input  return-value ) .
     1478       run waitfram-hide in this-procedure .
     1479       return no-apply .
     1480     end.
     1481     run waitfram-hide in this-procedure .
     1482     run trg/userlog.p (
     1483           input 'utl'
     1484           , input ( ("Синхронизация новостей с УБД " +
     1485                   string(p-dbnum) +
     1486                   substitute("; получ_до: &1; получ_после: &2; отпр_до: &3; отпр_после: 4", v-real-last-sent-pck, v-last-rcv-pack, v-real-last-rcv-pck, v-last-sent-pack) ) +
     1487                   chr(3) +
     1488                   "nws/sync.w")
     1489           , input ?
     1490           , input ?
     1491           , input ""
     1492           ) no-error.
     1493     if error-status :error
     1494     then do:
     1495         message return-value + error-status:get-message(1) view-as alert-box title "Ошибка записи истории действий пользователя".
     1496     end.
     1497     run write-to-log in this-procedure
     1498     ( input  substitute ("Произведена синхронизация новостей с УБД &1.&2Идентификатор пользователя: &3&2Номер последнего принятого пакета в УБД до синхронизации: &4&2Номер последнего принятого пакета в УБД после синхронизации: &5&2Номер последнего отправленного пакета из УБД до синхронизации: &6&2Номер последнего отправленного пакета из УБД после синхронизации: &7&2",
     1499                           string(p-dbnum),
     1500                           chr(10),
     1501                           g#auto-user-id,
     1502                           v-real-last-sent-pck,
     1503                           v-last-rcv-pack,
     1504                           v-real-last-rcv-pck,
     1505                           v-last-sent-pack
     1506                            ) ) .
     1507     message "Формирование данных для синхронизации закончено. Подготовьте новые пакеты и отправьте их в УБД." view-as alert-box .
     1508   END.
     1509   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1510   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1511   MAIN-BLOCK:
     1512   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1513      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1514     RUN enable_UI.
     1515     WAIT-FOR GO OF FRAME Dialog-Frame.
     1516   END.
     1517   RUN disable_UI.
     1518   procedure create-routes :
     1519     find first ub.db no-lock where ub.db.db-num = p-dbnum .
     1520     run nws/cr-route.p ( input 'send-tbl':U, input 'db':U, input (buffer ub.db:handle), input string(p-dbnum) ) no-error.
     1521     if error-status :error then do:
     1522       return error return-value.
     1523     end.
     1524     for each ub.db-attr no-lock where ub.db-attr.db-num = ub.db.db-num :
     1525       run db-attr-news in this-procedure
     1526         ( input ub.db-attr.attr-code
     1527          ,output p-news
     1528         ) no-error.
     1529       if p-news = true then do:
     1530         run nws/cr-route.p ( input 'send-tbl':U, input 'db-attr':U, input (buffer ub.db-attr:handle), input string(p-dbnum) ) no-error.
     1531         if error-status :error then do:
     1532           return error return-value.
     1533         end.
     1534       end.
     1535     end.
     1536     find first ub.clients no-lock where ub.clients.obj-type = v-curr-obj-type
     1537                                     and ub.clients.obj-code = v-curr-obj-code .
     1538     run nws/cr-route.p ( input 'send-tbl':U, input 'clients':U, input (buffer ub.clients:handle), input string(p-dbnum) ) no-error.
     1539     if error-status :error then do:
     1540       return error return-value.
     1541     end.
     1542     find first ub.shop no-lock where ub.shop.obj-code = ub.clients.obj-code .
     1543     run nws/cr-route.p ( input 'send-tbl':U, input 'shop':U, input (buffer ub.shop:handle), input string(p-dbnum) ) no-error.
     1544     if error-status :error then do:
     1545       return error return-value.
     1546     end.
     1547     for each ub.clients-attr no-lock where  ub.clients-attr.obj-type = ub.clients.obj-type
     1548                                         and ub.clients-attr.obj-code = ub.clients.obj-code :
     1549       run clntattr-news in this-procedure(input ub.clients-attr.attr-code,
     1550                                           output p-news) no-error.
     1551       if  p-news then do:
     1552         run nws/cr-route.p ( input 'send-tbl':U, input 'clients-attr':U, input (buffer ub.clients-attr:handle), input string(p-dbnum) ) no-error.
     1553         if error-status :error then do:
     1554           return error return-value.
     1555         end.
     1556       end.
     1557     end.
     1558     for each ub.ext-system no-lock where ub.ext-system.esys-db-num-exp = p-dbnum or ub.ext-system.esys-db-num-imp = p-dbnum :
     1559       run nws/cr-route.p ( input 'send-tbl':U, input 'ext-system':U, input (buffer ub.ext-system:handle), input string(p-dbnum) ) no-error.
     1560       if error-status :error then do:
     1561         return error return-value.
     1562       end.
     1563       for each ub.ext-system-attr no-lock where ub.ext-system-attr.esys-id  = ub.ext-system.esys-id
     1564                                             and ub.ext-system-attr.db-num   = ub.ext-system.db-num :
     1565         run ext-system-attr-news in this-procedure ( input ub.Ext-system-attr.esya-attr-code
     1566                                                     ,output p-news).
     1567         if  p-news then do:
     1568           run nws/cr-route.p ( input 'send-tbl':U, input 'ext-system-attr':U, input (buffer ub.ext-system-attr:handle), input string(p-dbnum) ) no-error.
     1569           if error-status :error then do:
     1570             return error return-value.
     1571           end.
     1572         end.
     1573       end.
     1574     end.
     1575     for each ub.user-login-action-role no-lock where ub.user-login-action-role.db-num = p-dbnum :
     1576       run nws/cr-route.p ( input 'send-tbl':U, input 'user-login-action-role':U, input (buffer ub.user-login-action-role:handle), input string(p-dbnum) ) no-error.
     1577       if error-status :error then do:
     1578         return error return-value.
     1579       end.
     1580     end.
     1581     for each ub.action-role no-lock where ub.action-role.db-num = p-dbnum :
     1582       run nws/cr-route.p ( input 'send-tbl':U, input 'action-role':U, input (buffer ub.action-role:handle), input string(p-dbnum) ) no-error.
     1583       if error-status :error then do:
     1584         return error return-value.
     1585       end.
     1586     end.
     1587     for each ub.action-role-item no-lock where ub.action-role-item.db-num = p-dbnum :
     1588       run nws/cr-route.p ( input 'send-tbl':U, input 'action-role-item':U, input (buffer ub.action-role-item:handle), input string(p-dbnum) ) no-error.
     1589       if error-status :error then do:
     1590         return error return-value.
     1591       end.
     1592     end.
     1593     for each ub.schedule no-lock :
     1594       run nws/cr-route.p ( input 'send-tbl':U, input 'schedule':U, input (buffer ub.schedule:handle), input string(p-dbnum) ) no-error.
     1595       if error-status :error then do:
     1596         return error return-value.
     1597       end.
     1598       for each ub.schedule-attr no-lock where ub.schedule-attr.cre-db-num = ub.schedule.cre-db-num
     1599                                           and ub.schedule-attr.task-type  = ub.schedule.task-type
     1600                                           and ub.schedule-attr.task-num   = ub.schedule.task-num
     1601                                           and ub.schedule-attr.task-num  <> -1 :
     1602         run nws/cr-route.p ( input 'send-tbl':U, input 'schedule-attr':U, input (buffer ub.schedule-attr:handle), input string(p-dbnum) ) no-error.
     1603         if error-status :error then do:
     1604           return error return-value.
     1605         end.
     1606       end.
     1607     end.
     1608     for each ub.config no-lock where ub.config.db-num = p-dbnum :
     1609       run nws/cr-route.p ( input 'send-tbl':U, input 'config':U, input (buffer ub.config:handle), input string(p-dbnum) ) no-error.
     1610       if error-status :error then do:
     1611         return error return-value.
     1612       end.
     1613     end.
     1614     for each ub.thbj-attr no-lock :
     1615       run nws/cr-route.p ( input 'send-tbl':U, input 'thbj-attr':U, input (buffer ub.thbj-attr:handle), input string(p-dbnum) ) no-error.
     1616       if error-status :error then do:
     1617         return error return-value.
     1618       end.
     1619     end.
     1620     for each ub.clients no-lock :
     1621       if ub.clients.obj-type = v-curr-obj-type and ub.clients.obj-code = v-curr-obj-code
     1622       then next .
     1623       run nws/cr-route.p ( input 'send-tbl':U, input 'clients':U, input (buffer ub.clients:handle), input string(p-dbnum) ) no-error.
     1624       if error-status :error then do:
     1625         return error return-value.
     1626       end.
     1627       for each ub.clients-attr no-lock where  ub.clients-attr.obj-type = ub.clients.obj-type
     1628                                           and ub.clients-attr.obj-code = ub.clients.obj-code :
     1629         run clntattr-news in this-procedure(input ub.clients-attr.attr-code,
     1630                                             output p-news) no-error.
     1631         if  p-news then do:
     1632           run nws/cr-route.p ( input 'send-tbl':U, input 'clients-attr':U, input (buffer ub.clients-attr:handle), input string(p-dbnum) ) no-error.
     1633           if error-status :error then do:
     1634             return error return-value.
     1635           end.
     1636         end.
     1637       end.
     1638     end.
     1639     for each ub.pay-type no-lock :
     1640       run nws/cr-route.p ( input 'send-tbl':U, input 'pay-type':U, input (buffer ub.pay-type:handle), input string(p-dbnum) ) no-error.
     1641       if error-status :error then do:
     1642         return error return-value.
     1643       end.
     1644     end.
     1645     for each ub.cash-pay no-lock :
     1646       run nws/cr-route.p ( input 'send-tbl':U, input 'cash-pay':U, input (buffer ub.cash-pay:handle), input string(p-dbnum) ) no-error.
     1647       if error-status :error then do:
     1648         return error return-value.
     1649       end.
     1650     end.
     1651     for each ub.cash-pay-attr no-lock :
     1652       run nws/cr-route.p ( input 'send-tbl':U, input 'cash-pay-attr':U, input (buffer ub.cash-pay-attr:handle), input string(p-dbnum) ) no-error.
     1653       if error-status :error then do:
     1654         return error return-value.
     1655       end.
     1656     end.
     1657     for each ub.tax no-lock :
     1658       run nws/cr-route.p ( input 'send-tbl':U, input 'tax':U, input (buffer ub.tax:handle), input string(p-dbnum) ) no-error.
     1659       if error-status :error then do:
     1660         return error return-value.
     1661       end.
     1662     end.
     1663     for each ub.tax-rate no-lock :
     1664       run nws/cr-route.p ( input 'send-tbl':U, input 'tax-rate':U, input (buffer ub.tax-rate:handle), input string(p-dbnum) ) no-error.
     1665       if error-status :error then do:
     1666         return error return-value.
     1667       end.
     1668     end.
     1669     for each ub.tax-rate-value no-lock :
     1670       run nws/cr-route.p ( input 'send-tbl':U, input 'tax-rate-value':U, input (buffer ub.tax-rate-value:handle), input string(p-dbnum) ) no-error.
     1671       if error-status :error then do:
     1672         return error return-value.
     1673       end.
     1674     end.
     1675     for each ub.tax-units no-lock :
     1676       run nws/cr-route.p ( input 'send-tbl':U, input 'tax-units':U, input (buffer ub.tax-units:handle), input string(p-dbnum) ) no-error.
     1677       if error-status :error then do:
     1678         return error return-value.
     1679       end.
     1680     end.
     1681     for each ub.currency no-lock :
     1682       run nws/cr-route.p ( input 'send-tbl':U, input 'currency':U, input (buffer ub.currency:handle), input string(p-dbnum) ) no-error.
     1683       if error-status :error then do:
     1684         return error return-value.
     1685       end.
     1686     end.
     1687     for each ub.curr-bank no-lock :
     1688       run nws/cr-route.p ( input 'send-tbl':U, input 'curr-bank':U, input (buffer ub.curr-bank:handle), input string(p-dbnum) ) no-error.
     1689       if error-status :error then do:
     1690         return error return-value.
     1691       end.
     1692     end.
     1693     for each ub.curr-shop no-lock where ub.curr-shop.obj-type = v-curr-obj-type
     1694                                     and ub.curr-shop.obj-code = v-curr-obj-code :
     1695       if Year(ub.curr-shop.exch-date ) <> 9999 then do:
     1696         run nws/cr-route.p ( input 'send-tbl':U, input 'curr-shop':U, input (buffer ub.curr-shop:handle), input string(p-dbnum) ) no-error.
     1697         if error-status :error then do:
     1698           return error return-value.
     1699         end.
     1700       end.
     1701     end.
     1702     for each ub.country no-lock :
     1703       run nws/cr-route.p ( input 'send-tbl':U, input 'country':U, input (buffer ub.country:handle), input string(p-dbnum) ) no-error.
     1704       if error-status :error then do:
     1705         return error return-value.
     1706       end.
     1707     end.
     1708     for each ub.regions no-lock :
     1709       run nws/cr-route.p ( input 'send-tbl':U, input 'regions':U, input (buffer ub.regions:handle), input string(p-dbnum) ) no-error.
     1710       if error-status :error then do:
     1711         return error return-value.
     1712       end.
     1713     end.
     1714     for each ub.cash-desk no-lock where ub.cash-desk.db-num = p-dbnum :
     1715       run nws/cr-route.p ( input 'send-tbl':U, input 'cash-desk':U, input (buffer ub.cash-desk:handle), input string(p-dbnum) ) no-error.
     1716       if error-status :error then do:
     1717         return error return-value.
     1718       end.
     1719     end.
     1720     for each ub.cash-desk-attr no-lock where ub.cash-desk-attr.db-num = p-dbnum :
     1721       run nws/cr-route.p ( input 'send-tbl':U, input 'cash-desk-attr':U, input (buffer ub.cash-desk-attr:handle), input string(p-dbnum) ) no-error.
     1722       if error-status :error then do:
     1723         return error return-value.
     1724       end.
     1725     end.
     1726     for each ub.cashbookrule no-lock where ub.CashBookRule.Obj-type = v-curr-obj-type
     1727                                        and ub.CashBookRule.Obj-code = v-curr-obj-code :
     1728       run nws/cr-route.p ( input 'send-tbl':U, input 'CashBookRule':U, input (buffer ub.cashbookrule:handle), input string(p-dbnum) ) no-error.
     1729       if error-status :error then do:
     1730         return error return-value.
     1731       end.
     1732     end.
     1733     for each ub.OperServ no-lock :
     1734       run nws/cr-route.p ( input 'send-tbl':U, input 'OperServ':U, input (buffer ub.OperServ:handle), input string(p-dbnum) ) no-error.
     1735       if error-status :error then do:
     1736         return error return-value.
     1737       end.
     1738       for each ub.goods-attr exclusive-lock where ub.goods-attr.attr-code = 'oper-serv-idd':U
     1739                                               and ub.goods-attr.attr-value = string(ub.OperServ.id):
     1740         run nws/cr-route.p ( input 'send-tbl':U, input 'goods-attr':U, input (buffer ub.goods-attr:handle), input string(p-dbnum) ) no-error.
     1741         if error-status :error then do:
     1742           return error return-value.
     1743         end.
     1744       end.
     1745     end.
     1746     for each ub.OperServAttr no-lock :
     1747       run nws/cr-route.p ( input 'send-tbl':U, input 'OperServAttr':U, input (buffer ub.OperServAttr:handle), input string(p-dbnum) ) no-error.
     1748       if error-status :error then do:
     1749         return error return-value.
     1750       end.
     1751     end.
     1752     run nws/cmd-bush.p persistent set v-cmd-proc-handle no-error .
     1753     if error-status :error
     1754     then do:
     1755       delete procedure v-cmd-proc-handle .
     1756       return error substitute("&1 &2 &3&4Ошибка при запуске процедуры cmd-bush.p&4" +
     1757                                           "&5&4&6"
     1758                                           ,vss-workfile
     1759                                           ,vss-revision
     1760                                           ,vss-description
     1761                                           ,chr(10)
     1762                                           ,error-status:get-message(1)
     1763                                           ,return-value ).
     1764     end.
     1765     define buffer buf_rp-by-call for ub.rp-by-call.
     1766     define buffer buf_rule-by-call for ub.rule-by-call.
     1767     define buffer buf_rule-call-param for ub.rule-call-param.
     1768     for each db no-lock
     1769     where db.db-num > 0
     1770     :
     1771       assign
     1772       v-db-list = v-db-list + chr(1) + string(db.db-num).
     1773     end.
     1774     v-db-list = trim(v-db-list, chr(1)).
     1775     for each ub.dis-card-type no-lock :
     1776       run nws/cr-route.p ( input 'send-tbl':U, input 'dis-card-type':U, input (buffer ub.dis-card-type:handle), input string(p-dbnum) ) no-error.
     1777       if error-status :error then do:
     1778         return error return-value.
     1779       end.
     1780       assign
     1781       v-command =  substitute("&2&1&3&1&4"
     1782                              , chr(6)
     1783                              , 'cmd-dct-send':U
     1784                              , ub.dis-card-type.emitent-host-code
     1785                              , ub.dis-card-type.type
     1786                              ).
     1787       run begin-create-command in v-cmd-proc-handle
     1788         (input v-command
     1789         ,input "":U
     1790         ,output v-cmd-code
     1791         ) no-error.
     1792       if error-status :error
     1793       then do:
     1794         message
     1795           vss-workfile vss-revision vss-description skip
     1796           substitute( "Ошибка при создании команды &1", 'cmd-dct-send':U ) skip
     1797           error-status :get-message(1) skip
     1798           return-value skip
     1799           view-as alert-box error .
     1800         delete procedure v-cmd-proc-handle .
     1801         return error return-value .
     1802       end.
     1803       run send-command in v-cmd-proc-handle
     1804         ( input v-cmd-code
     1805           ,input v-db-list
     1806           ) no-error .
     1807       if error-status:error then do:
     1808         delete procedure v-cmd-proc-handle .
     1809         message
     1810         vss-workfile vss-revision vss-description skip
     1811         substitute( "Ошибка при отсылке команды &1", 'cmd-dct-send':U ) skip
     1812         error-status :get-message(1) skip
     1813         return-value skip
     1814         view-as alert-box error .
     1815         return error return-value .
     1816       end.
     1817       for each buf_rp-by-call where buf_rp-by-call.call_id = ub.dis-card-type.uniq-key-rec :
     1818         run nws/cr-route.p ( input 'send-tbl':U, input 'rp-by-call':U, input (buffer buf_rp-by-call:handle), input string(p-dbnum) ) no-error.
     1819         if error-status :error then do:
     1820           return error return-value.
     1821         end.
     1822       end.
     1823       for each buf_rule-by-call where buf_rule-by-call.call_id = ub.dis-card-type.uniq-key-rec :
     1824         run nws/cr-route.p ( input 'send-tbl':U, input 'rule-by-call':U, input (buffer buf_rule-by-call:handle), input string(p-dbnum) ) no-error.
     1825         if error-status :error then do:
     1826           return error return-value.
     1827         end.
     1828       end.
     1829       for each buf_rule-call-param where buf_rule-call-param.call_id = ub.dis-card-type.uniq-key-rec :
     1830         run nws/cr-route.p ( input 'send-tbl':U, input 'rule-call-param':U, input (buffer buf_rule-call-param:handle), input string(p-dbnum) ) no-error.
     1831         if error-status :error then do:
     1832           return error return-value.
     1833         end.
     1834       end.
     1835     end.
     1836     delete procedure v-cmd-proc-handle no-error .
     1837     for each ub.dis-card-mask no-lock :
     1838       run nws/cr-route.p ( input 'send-tbl':U, input 'dis-card-mask':U, input (buffer ub.dis-card-mask:handle), input string(p-dbnum) ) no-error.
     1839       if error-status :error then do:
     1840         return error return-value.
     1841       end.
     1842     end.
     1843     for each ub.dis-card no-lock :
     1844       run nws/cr-route.p ( input 'send-tbl':U, input 'dis-card':U, input (buffer ub.dis-card:handle), input string(p-dbnum) ) no-error.
     1845       if error-status :error then do:
     1846         return error return-value.
     1847       end.
     1848       run str/saledc.p
     1849           (
     1850             input parparentproc
     1851           ,input this-procedure :handle
     1852           ,input ?
     1853           ,input 'one-card-add':U
     1854           ,input ?
     1855           ,input '':U
     1856           ,input 0
     1857           ,input 0
     1858           ,input 0
     1859           ,input g#db-num
     1860           ,input ub.dis-card.d-card
     1861           ,input ?
     1862           ,input ?
     1863           ,input ?
     1864           ,input 1
     1865           ,input 1
     1866           ,input yes
     1867           ) no-error .
     1868       if error-status:error then do:
     1869         return error return-value .
     1870       end.
     1871     end.
     1872     for each ub.dis-host no-lock :
     1873       run nws/cr-route.p ( input 'send-tbl':U, input 'dis-host':U, input (buffer ub.dis-host:handle), input string(p-dbnum) ) no-error.
     1874       if error-status :error then do:
     1875         return error return-value.
     1876       end.
     1877     end.
     1878     for each ub.dis-card-property no-lock :
     1879       run nws/cr-route.p ( input 'send-tbl':U, input 'dis-card-property':U, input (buffer ub.dis-card-property:handle), input string(p-dbnum) ) no-error.
     1880       if error-status :error then do:
     1881         return error return-value.
     1882       end.
     1883     end.
     1884     for each ub.dis-rule no-lock :
     1885       run nws/cr-route.p ( input 'send-tbl':U, input 'dis-rule':U, input (buffer ub.dis-rule:handle), input string(p-dbnum) ) no-error.
     1886       if error-status :error then do:
     1887         return error return-value.
     1888       end.
     1889     end.
     1890     for each ub.dis-gds-rule no-lock :
     1891       run nws/cr-route.p ( input 'send-tbl':U, input 'dis-gds-rule':U, input (buffer ub.dis-gds-rule:handle), input string(p-dbnum) ) no-error.
     1892       if error-status :error then do:
     1893         return error return-value.
     1894       end.
     1895     end.
     1896     for each ub.dis-time-rule no-lock :
     1897       run nws/cr-route.p ( input 'send-tbl':U, input 'dis-time-rule':U, input (buffer ub.dis-time-rule:handle), input string(p-dbnum) ) no-error.
     1898       if error-status :error then do:
     1899         return error return-value.
     1900       end.
     1901     end.
     1902   end procedure .
     1903   PROCEDURE disable_UI :
     1904     HIDE FRAME Dialog-Frame.
     1905   END PROCEDURE.
     1906   PROCEDURE enable_UI :
     1907     v-last-rcv-pack:label in FRAME Dialog-Frame = "Номер последнего принятого пакета в БД " + string(p-dbnum) .
     1908     v-last-sent-pack:label in FRAME Dialog-Frame = "Номер последнего отправленного пакета из БД " + string(p-dbnum).
     1909     DISPLAY v-last-rcv-pack v-last-sent-pack
     1910         WITH FRAME Dialog-Frame.
     1911     ENABLE b-cancel b-ok v-last-rcv-pack v-last-sent-pack
     1912         WITH FRAME Dialog-Frame.
     1913     VIEW FRAME Dialog-Frame.
     1914   END PROCEDURE.
