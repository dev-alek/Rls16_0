        1   block-level on error undo, throw.
        2   define input parameter p-del-key-rec as character no-undo .
        3   define input parameter p-find-msg    as logical   no-undo .
        4   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        5   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        6   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile: del-rec.p $":U .
        8   define variable vss-archive     as character no-undo init "$Archive: nws/del-rec.p $":U .
        9   define variable vss-description as character no-undo init "удаление записи в базе данных".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   def var vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       69   procedure gen-key-rec :
       70     define input  parameter p-tbl-name    as character no-undo.
       71     define input  parameter p-bh_tbl-name as handle    no-undo.
       72     define output parameter p-key-rec     as character no-undo.
       73     do
       74     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
       75     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
       76     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
       77     :
       78       define variable fh               as handle    no-undo .
       79       define variable v-ok             as logical   no-undo .
       80       define variable v-inform         as character no-undo .
       81       define variable v-ind            as integer   no-undo .
       82       define variable v-idx-field-qnty as integer   no-undo .
       83       if p-tbl-name = ?
       84         or p-tbl-name = "":U
       85       then do:
       86         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info0 ).
       87       end.
       88       if not p-bh_tbl-name:available then do:
       89         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info0, p-tbl-name ).
       90       end.
       91       assign
       92         p-key-rec = p-tbl-name
       93         v-inform  = p-bh_tbl-name:index-information(1)
       94         v-ind     = 2
       95       .
       96       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
       97       on error undo, return error
       98       :
       99         assign
      100           v-inform = p-bh_tbl-name:index-information( v-ind )
      101           v-ind    = v-ind + 1
      102         .
      103       end.
      104       if v-inform = ?
      105         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      106         or entry( 3, v-inform, ",":U ) <> "1":U
      107       then do:
      108         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info0, p-tbl-name ).
      109       end.
      110       else do:
      111         assign
      112           v-idx-field-qnty = num-entries( v-inform ) - 4
      113         .
      114         if v-idx-field-qnty < 2 then do:
      115           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info0, v-inform, p-tbl-name ).
      116         end.
      117         do v-ind = 1 to v-idx-field-qnty by 2
      118         on error undo, return error
      119         :
      120           assign
      121             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      122             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      123           .
      124         end.
      125       end.
      126       if p-key-rec = ? then do:
      127         assign
      128           p-key-rec = "":U
      129         .
      130         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info0, p-tbl-name ).
      131       end.
      132     end.
      133     return.
      134   end procedure.
      135   procedure gen-where-keyr-tab :
      136     define input  parameter i-tableSerach as character no-undo.
      137     define input  parameter i-tablekey   as character  no-undo.
      138     define input  parameter p-key-rec    as character  no-undo.
      139     define input  parameter p-key-handle as handle     no-undo .
      140     define input  parameter p-db-name    as character  no-undo .
      141     define input  parameter p-tt-handle  as handle     no-undo .
      142     define output parameter o-Where      as character  no-undo.
      143     do
      144     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      145     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      146     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      147     :
      148       define variable v-full-tbl-name  as character no-undo .
      149       define variable bh_tbl-name      as handle    no-undo .
      150       define variable fh_key           as handle    no-undo .
      151       define variable fh_search        as handle    no-undo .
      152       define variable v-field-num      as integer   no-undo .
      153       define variable v-count-fld      as integer   no-undo .
      154       define variable v-inform         as character no-undo .
      155       define variable v-ind            as integer   no-undo .
      156       define variable v-idx-field-qnty as integer   no-undo .
      157       define variable v-field-name     as character no-undo .
      158       define variable v-field-val      as character no-undo .
      159       define variable v-word-link      as character no-undo .
      160       define variable vTable           as character no-undo.
      161       define variable bh_tbl-key       as handle    no-undo .
      162       assign
      163         p-key-rec = trim( p-key-rec )
      164       .
      165       if p-key-handle <> ? then do:
      166         if not valid-handle(p-key-handle)
      167            or p-key-handle:type <> "buffer"
      168         then do:
      169           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info0 ).
      170         end.
      171         if num-entries( p-key-rec, chr(3) ) > 1
      172           or p-key-rec = ?
      173           or p-key-rec = "":U
      174         then do:
      175           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info0, p-key-rec ).
      176         end.
      177       end.
      178       else do:
      179         if p-key-rec = ?
      180           or p-key-rec = "":U
      181         then do:
      182           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info0 ).
      183         end.
      184       end.
      185       assign
      186         vTable = entry( 1 , p-key-rec, chr(3) )
      187       .
      188       if p-tt-handle <> ?
      189         and ( not valid-handle(p-tt-handle)
      190               or p-tt-handle:type <> "buffer"
      191             )
      192       then do:
      193         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info0, vTable, chr(10) ).
      194       end.
      195       if p-tt-handle = ? then do:
      196         assign
      197           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      198         .
      199         create buffer bh_tbl-name for table v-full-tbl-name .
      200       end.
      201       else do:
      202         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      203       end.
      204       assign
      205         v-inform = bh_tbl-name:index-information(1)
      206         v-ind    = 2
      207       .
      208       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      209       on error undo, return error
      210       :
      211         assign
      212           v-inform = bh_tbl-name:index-information( v-ind )
      213           v-ind    = v-ind + 1
      214         .
      215       end.
      216       if v-inform = ?
      217         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      218         or entry( 3, v-inform, ",":U ) <> "1":U
      219       then do:
      220         delete object bh_tbl-name no-error.
      221         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info0, vTable ).
      222       end.
      223       assign
      224         v-idx-field-qnty = num-entries( v-inform ) - 4
      225       .
      226       if v-idx-field-qnty < 2 then do:
      227         delete object bh_tbl-name no-error.
      228         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info0, v-inform, vTable ).
      229       end.
      230       assign
      231         o-where     = "where":U
      232         v-word-link = "":U
      233         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      234         v-count-fld = 0
      235       .
      236       if i-tablekey ne "" and i-tablekey ne ?
      237       then do:
      238         assign
      239           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      240         .
      241         create buffer bh_tbl-key for table v-full-tbl-name .
      242       end.
      243       if i-tableSerach ne "" and i-tableSerach ne ?
      244       then do:
      245         delete object bh_tbl-name no-error.
      246         assign
      247           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      248         .
      249         create buffer bh_tbl-name for table v-full-tbl-name .
      250       end.
      251       block_where:
      252       do v-ind = 1 to v-idx-field-qnty by 2
      253       on error undo, return error
      254       :
      255         assign
      256           v-count-fld = v-count-fld + 1
      257         .
      258         if p-key-handle = ?
      259           and v-count-fld > v-field-num
      260         then do:
      261           leave block_where.
      262         end.
      263         define variable VfieldKeyTable as handle no-undo.
      264         assign
      265           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      266           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      267         .
      268         if     bh_tbl-key ne ?
      269         then do:
      270            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      271            if VfieldKeyTable eq ?
      272            then next block_where.
      273         end.
      274         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      275         then
      276            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      277         else
      278            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      279         if p-key-handle = ? then do:
      280           assign
      281             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      282           .
      283         end.
      284         else do:
      285           assign
      286             fh_key = p-key-handle:buffer-field( v-field-name )
      287           .
      288           if fh_key = ?
      289             or not valid-handle( fh_key )
      290           then do:
      291             delete object bh_tbl-name.
      292             if     bh_tbl-key ne ?
      293             then
      294                delete object bh_tbl-key.
      295             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info0, p-key-handle:name, v-field-name ).
      296           end.
      297           assign
      298             v-field-val = fh_key:buffer-value
      299           .
      300         end.
      301         if fh_search:data-type ="character":U then do:
      302           assign
      303             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      304             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      305             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      306             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      307             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      308             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      309             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      310             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      311             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      312             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      313             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      314             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      315             v-field-val = substitute( '"&1"', v-field-val )
      316           .
      317         end.
      318         assign
      319           o-where = substitute( "&1 &2", o-where, v-field-val )
      320         .
      321         if v-word-link = "":U then do:
      322           assign
      323             v-word-link = "and":U
      324           .
      325         end.
      326       end.
      327       delete object bh_tbl-name.
      328       if     bh_tbl-key ne ?
      329       then
      330          delete object bh_tbl-key.
      331       if p-key-handle = ?
      332         and v-count-fld <> v-field-num
      333       then do:
      334         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info0, vTable ).
      335       end.
      336     end.
      337   end procedure.
      338   procedure gen-hn-keyr-tab :
      339     define input  parameter i-tableSerach as character no-undo.
      340     define input  parameter i-tablekey   as character no-undo.
      341     define input  parameter p-key-rec    as character no-undo.
      342     define input  parameter p-key-handle as handle    no-undo .
      343     define input  parameter p-db-name    as character no-undo .
      344     define input  parameter p-tt-handle  as handle    no-undo .
      345     define input  parameter p-stts-lock  as integer   no-undo .
      346     define output parameter o-hn         as handle    no-undo.
      347     define variable v-full-tbl-name as character no-undo.
      348     define variable v-where         as character no-undo.
      349     define variable bh_tbl-name     as handle    no-undo.
      350     define variable vTable          as character no-undo.
      351     do
      352     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      353     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      354     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      355         run gen-where-keyr-tab(i-tableSerach,
      356                                i-tablekey,
      357                                p-key-rec,
      358                                p-key-handle,
      359                                p-db-name,
      360                                p-tt-handle,
      361                                output v-where).
      362         if i-tableSerach ne "" and i-tableSerach ne ?
      363         then do:
      364            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      365            create buffer bh_tbl-name for table v-full-tbl-name .
      366         end.
      367         else do:
      368            if p-tt-handle = ? then do:
      369               assign
      370                  vTable = entry( 1 , p-key-rec, chr(3) )
      371               .
      372               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      373               create buffer bh_tbl-name for table v-full-tbl-name .
      374            end.
      375            else do:
      376               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      377            end.
      378         end.
      379         if p-tt-handle = ? then do:
      380            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      381         end.
      382         else do:
      383            bh_tbl-name:find-first( v-where ) no-error .
      384         end.
      385         o-hn = bh_tbl-name.
      386      end.
      387   end procedure.
      388   procedure gen-hn-keyr :
      389     define input  parameter p-key-rec    as character no-undo.
      390     define input  parameter p-key-handle as handle    no-undo .
      391     define input  parameter p-db-name    as character no-undo .
      392     define input  parameter p-tt-handle  as handle    no-undo .
      393     define input  parameter p-stts-lock  as integer   no-undo .
      394     define output parameter o-hn         as handle    no-undo.
      395     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      396   end.
      397   procedure gen-row-keyr :
      398     define input  parameter p-key-rec    as character no-undo.
      399     define input  parameter p-key-handle as handle    no-undo .
      400     define input  parameter p-db-name    as character no-undo .
      401     define input  parameter p-tt-handle  as handle    no-undo .
      402     define input  parameter p-stts-lock  as integer   no-undo .
      403     define output parameter p-tbl-row    as rowid     no-undo.
      404     define output parameter p-tbl-name   as character no-undo.
      405     define variable vHn as handle no-undo.
      406       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      407       p-tbl-row = if vHn:available then vHn:rowid else ?.
      408       p-tbl-name =  vHn:table.
      409       delete object vHn no-error.
      410     if p-tbl-row = ? then do:
      411       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info0, p-tbl-name, p-key-rec ).
      412     end.
      413     else do:
      414       return.
      415     end.
      416   end procedure.
      417   procedure gen-key-fv :
      418     define input  parameter p-key-rec    as character no-undo .
      419     define output parameter p-field-list as character no-undo .
      420     define output parameter p-value-list as character no-undo.
      421     do
      422     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      423     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      424     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      425     :
      426       define variable v-full-tbl-name  as character no-undo .
      427       define variable bh_tbl-name      as handle    no-undo .
      428       define variable v-tbl-name       as character no-undo .
      429       define variable v-field-num      as integer   no-undo .
      430       define variable v-count-fld      as integer   no-undo .
      431       define variable v-inform         as character no-undo .
      432       define variable v-ind            as integer   no-undo .
      433       define variable v-idx-field-qnty as integer   no-undo .
      434       define variable v-delim-key      as character no-undo .
      435       if p-key-rec = ?
      436         or p-key-rec = "":U
      437       then do:
      438         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info0 ).
      439       end.
      440       assign
      441         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      442         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      443       .
      444       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      445       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info0 ).
      446       assign
      447         v-inform = bh_tbl-name:index-information(1)
      448         v-ind    = 2
      449       .
      450       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      451       on error undo, return error
      452       :
      453         assign
      454           v-inform = bh_tbl-name:index-information( v-ind )
      455           v-ind    = v-ind + 1
      456         .
      457       end.
      458       if v-inform = ?
      459         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      460         or entry( 3, v-inform, ",":U ) <> "1":U
      461       then do:
      462         delete object bh_tbl-name no-error.
      463         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info0, v-tbl-name ).
      464       end.
      465       assign
      466         v-idx-field-qnty = num-entries( v-inform ) - 4
      467       .
      468       if v-idx-field-qnty < 2 then do:
      469         delete object bh_tbl-name no-error.
      470         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info0, v-inform, v-tbl-name ).
      471       end.
      472       assign
      473         p-field-list = "":U
      474         p-value-list = "":U
      475         v-delim-key  = "":U
      476         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      477         v-count-fld  = 0
      478       .
      479       block_where:
      480       do v-ind = 1 to v-idx-field-qnty by 2
      481       on error undo, return error
      482       :
      483         assign
      484           v-count-fld = v-count-fld + 1
      485         .
      486         if v-count-fld > v-field-num then do:
      487           leave block_where.
      488         end.
      489         assign
      490           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      491           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      492         .
      493         if v-ind = 1 then do:
      494           assign
      495             v-delim-key = chr(3)
      496           .
      497         end.
      498       end.
      499       delete object bh_tbl-name.
      500       if v-count-fld <> v-field-num then do:
      501         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info0, v-tbl-name ).
      502       end.
      503     end.
      504   end procedure.
      505   procedure gen-key-field :
      506     define input  parameter p-table      as character no-undo .
      507     define output parameter p-field-list as character no-undo .
      508     do
      509     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      510     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      511     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      512     :
      513       define variable v-full-tbl-name  as character no-undo .
      514       define variable bh_tbl-name      as handle    no-undo .
      515       define variable v-tbl-name       as character no-undo .
      516       define variable v-field-num      as integer   no-undo .
      517       define variable v-count-fld      as integer   no-undo .
      518       define variable v-inform         as character no-undo .
      519       define variable v-ind            as integer   no-undo .
      520       define variable v-idx-field-qnty as integer   no-undo .
      521       define variable v-delim-key      as character no-undo .
      522       if p-table = ?
      523         or p-table = "":U
      524       then do:
      525         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info0 ).
      526       end.
      527       assign
      528         v-tbl-name      = p-table
      529         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      530       .
      531       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      532       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info0 ).
      533       assign
      534         v-inform = bh_tbl-name:index-information(1)
      535         v-ind    = 2
      536       .
      537       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      538       on error undo, return error
      539       :
      540         assign
      541           v-inform = bh_tbl-name:index-information( v-ind )
      542           v-ind    = v-ind + 1
      543         .
      544       end.
      545       if v-inform = ?
      546         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      547         or entry( 3, v-inform, ",":U ) <> "1":U
      548       then do:
      549         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info0, v-tbl-name ).
      550       end.
      551       assign
      552         v-idx-field-qnty = num-entries( v-inform ) - 4
      553       .
      554       if v-idx-field-qnty < 2 then do:
      555         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info0, v-inform, v-tbl-name ).
      556       end.
      557       assign
      558         p-field-list = "":U
      559         v-delim-key  = "":U
      560         v-count-fld  = 0
      561       .
      562       block_where:
      563       do v-ind = 1 to v-idx-field-qnty by 2
      564       on error undo, return error
      565       :
      566         assign
      567           v-count-fld = v-count-fld + 1
      568         .
      569         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      570         if v-ind = 1 then do:
      571           assign
      572             v-delim-key = chr(3)
      573           .
      574         end.
      575       end.
      576       delete object bh_tbl-name.
      577     end.
      578   end procedure.
      579   do
      580   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      581   on stop   undo, return error substitute( "&1. stop", vss-workfile )
      582   on endkey undo, return error substitute( "&1. endkey", vss-workfile )
      583   :
      584     define variable v-tbl-name  as character no-undo .
      585     define variable v-tbl-row   as row       no-undo .
      586     define variable bh_tbl-name as handle    no-undo .
      587     define variable v-deleted   as logical   no-undo .
      588     define variable v-rec-av    as logical   no-undo .
      589     define variable v-msg       as character no-undo .
      590     assign
      591       v-rec-av  = true
      592       v-deleted = false
      593       v-msg     = "":U
      594     .
      595     run gen-row-keyr in this-procedure
      596       ( input p-del-key-rec
      597        ,input ?
      598        ,input "ub":U
      599        ,input ?
      600        ,input share-lock
      601        ,output v-tbl-row
      602        ,output v-tbl-name
      603       ) no-error .
      604     if error-status :error then do:
      605       return error substitute( "&1. Ошибка при поиске записи по уникальному ключу &2.&3&4&3&5"
      606                                ,vss-workfile
      607                                ,p-del-key-rec
      608                                ,chr(10)
      609                                ,return-value
      610                                ,error-status :get-message ( error-status :num-messages )
      611                              ).
      612     end.
      613     create buffer bh_tbl-name for table "ub.":U + v-tbl-name .
      614     bh_tbl-name:find-by-rowid( v-tbl-row, exclusive-lock ) no-error .
      615     if bh_tbl-name:available then do:
      616       assign
      617         v-deleted = bh_tbl-name:buffer-delete() no-error
      618       .
      619       if error-status :error
      620         or v-deleted = false
      621       then do:
      622         assign
      623           v-msg     = substitute( "&1&2&3&2&4", vss-workfile, chr(10), return-value, error-status :get-message( error-status :num-messages )  )
      624           v-deleted = false
      625         .
      626       end.
      627     end.
      628     else do:
      629       assign
      630         v-rec-av  = false
      631         v-msg     = substitute( "&1. Не найдена запись таблицы по ключу &2", vss-workfile, p-del-key-rec )
      632         v-deleted = false
      633       .
      634     end.
      635     delete object bh_tbl-name.
      636     if v-deleted = true then do:
      637       return .
      638     end.
      639     else do:
      640       if p-find-msg = true
      641         or v-rec-av = true
      642       then do:
      643         return error v-msg .
      644       end.
      645       else do:
      646         return .
      647       end.
      648     end.
      649   end.
