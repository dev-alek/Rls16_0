        1   block-level on error undo, throw.
        2   define input parameter p-action       as character no-undo .
        3   define input parameter p-uniq-key-rec as character no-undo .
        4   define input parameter p-parameters   as character no-undo .
        5   def var vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        6   def var vss-author      as character no-undo init "$Author: expertek $":U .
        7   def var vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        8   def var vss-workfile    as character no-undo init "$Workfile: db-rec.p $":U .
        9   def var vss-archive     as character no-undo init "$Archive: nws/db-rec.p $":U .
       10   def var vss-description as character no-undo init "Выполнение (удаленное) операций над записями".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   define new global shared variable g#library  as handle no-undo .
       70   define new global shared variable g#library2 as handle no-undo .
       71   define   shared variable g#auto as logical no-undo.
       72   define   shared variable g#news as logical no-undo.
       73   define   shared variable g#oxml as logical no-undo.
       74   define   shared variable g#esys as logical no-undo.
       75   define   shared variable g#news-source-db as integer no-undo.
       76   define   shared variable g#esys-source-esys as integer no-undo.
       77   define   shared variable g#db-num as integer   no-undo .
       78   define   shared variable g#userid as character no-undo .
       79   define   shared variable g#passwd as character no-undo .
       80   def var vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       81   procedure progs-name :
       82     define input  parameter p-action-code         as character no-undo .
       83     define output parameter p-main-prog-name      as character no-undo .
       84     define output parameter p-list-db-proc-name   as character no-undo .
       85     define output parameter p-commit-proc-name    as character no-undo .
       86     define output parameter p-execution-proc-name as character no-undo .
       87     define output parameter p-recover-proc-name   as character no-undo .
       88     define output parameter p-after-proc-name     as character no-undo .
       89     do
       90     on error undo, return error
       91     :
       92       case p-action-code :
       93               when 'crush_code-range':U then do:     assign       p-main-prog-name      = 'trg/code-rgt.p':U       p-list-db-proc-name   = 'utl/cdrg-dbl.p':U       p-commit-proc-name    = 'comm-crush-cdrg':U       p-execution-proc-name = 'exec-crush-cdrg':U       p-recover-proc-name   = 'rcvr-crush-cdrg':U       p-after-proc-name     = '':U     .   end.
       94               when 'delete_code-range':U then do:     assign       p-main-prog-name      = 'trg/code-rgt.p':U       p-list-db-proc-name   = 'utl/cdrg-dbl.p':U       p-commit-proc-name    = 'comm-del-cdrg':U       p-execution-proc-name = 'exec-del-cdrg':U       p-recover-proc-name   = 'rcvr-del-cdrg':U       p-after-proc-name     = '':U     .   end.
       95               when 'delete_nu-prt-bar-code':U then do:     assign       p-main-prog-name      = 'trg/bar-codt.p':U       p-list-db-proc-name   = 'str/barcddb.p':U       p-commit-proc-name    = 'block-del-prt-bar-code':U       p-execution-proc-name = 'delete-prt-bar-code':U       p-recover-proc-name   = 'undo-delete-prt-bar-code':U       p-after-proc-name     = '':U     .   end.
       96               when 'delete_nu-part-bar-code':U then do:     assign       p-main-prog-name      = 'trg/bar-codt.p':U       p-list-db-proc-name   = 'str/barcddb.p':U       p-commit-proc-name    = 'block-del-part-bar-code':U       p-execution-proc-name = 'delete-part-bar-code':U       p-recover-proc-name   = 'undo-delete-part-bar-code':U       p-after-proc-name     = '':U     .   end.
       97               when 'delete_nu-ucli-bar-code':U then do:     assign       p-main-prog-name      = 'trg/bar-codt.p':U       p-list-db-proc-name   = 'str/barcddb.p':U       p-commit-proc-name    = 'block-del-ucli-bar-code':U       p-execution-proc-name = 'delete-ucli-bar-code':U       p-recover-proc-name   = 'undo-delete-ucli-bar-code':U       p-after-proc-name     = '':U     .   end.
       98               when 'delete_nu-dis-card':U then do:     assign       p-main-prog-name      = 'trg/discardt.p':U       p-list-db-proc-name   = 'trg/discardb.p':U       p-commit-proc-name    = 'block-del-dis-card':U       p-execution-proc-name = 'delete-dis-card':U       p-recover-proc-name   = 'undo-delete-dis-card':U       p-after-proc-name     = '':U     .   end.
       99               when 'chown-dis-card':U then do:     assign       p-main-prog-name      = 'trg/discardt.p':U       p-list-db-proc-name   = 'trg/discardb.p':U       p-commit-proc-name    = 'block-chown-dis-card':U       p-execution-proc-name = 'chown-dis-card':U       p-recover-proc-name   = 'undo-chown-dis-card':U       p-after-proc-name     = 'after-chown-dis-card':U     .   end.
      100               when 'delete_nu-dis-rule':U then do:     assign       p-main-prog-name      = 'trg/dis-rult.p':U       p-list-db-proc-name   = 'trg/disruldb.p':U       p-commit-proc-name    = 'block-del-dis-rule':U       p-execution-proc-name = 'delete-dis-rule':U       p-recover-proc-name   = 'undo-delete-dis-rule':U       p-after-proc-name     = '':U     .   end.
      101               when 'ren-art':U then do:     assign       p-main-prog-name      = 'trg/goodst.p':U       p-list-db-proc-name   = 'utl/renartcd.p':U       p-commit-proc-name    = 'comm-ren-art':U       p-execution-proc-name = 'exec-ren-art':U       p-recover-proc-name   = 'rcvr-ren-art':U       p-after-proc-name     = 'after-ren-art':U     .   end.
      102               when 'delete_nu-clob-data':U then do:     assign       p-main-prog-name      = 'trg/clobdatt.p':U       p-list-db-proc-name   = 'trg/clbdatdb.p':U       p-commit-proc-name    = 'block-del-clob-data':U       p-execution-proc-name = 'delete-clob-data':U       p-recover-proc-name   = 'undo-delete-clob-data':U       p-after-proc-name     = '':U     .   end.
      103               when 'delete_nu-layout':U then do:     assign       p-main-prog-name      = 'trg/layoutt.p':U       p-list-db-proc-name   = 'trg/layoutdb.p':U       p-commit-proc-name    = 'block-del-layout':U       p-execution-proc-name = 'delete-layout':U       p-recover-proc-name   = 'undo-delete-layout':U       p-after-proc-name     = '':U     .   end.
      104               otherwise do:
      105           return error substitute( "&1. Неизвестный тип операции: &2", vss-include-info0, p-action-code ).
      106         end.
      107       end case.
      108     end.
      109     return.
      110   end procedure.
      111   procedure progs-title :
      112     define input  parameter p-action-code         as character no-undo .
      113     define output parameter p-action-title      as character no-undo .
      114     do
      115     on error undo, return error
      116     :
      117       case p-action-code :
      118               when 'crush_code-range':U then do:     assign       p-action-title        = "Разбиение диапазона кодов (code-range)"     .   end.
      119               when 'delete_code-range':U then do:     assign       p-action-title        = "Удаление диапазона кодов (code-range)"     .   end.
      120               when 'delete_nu-prt-bar-code':U then do:     assign       p-action-title        = "Удаление неисп. бар-кода признака"     .   end.
      121               when 'delete_nu-part-bar-code':U then do:     assign       p-action-title        = "Удаление неисп. бар-кода партиии"     .   end.
      122               when 'delete_nu-ucli-bar-code':U then do:     assign       p-action-title        = "Удаление неисп.бар-кода на доп ед.изм."     .   end.
      123               when 'delete_nu-dis-card':U then do:     assign       p-action-title        = "Удаление неиспользуемой ДК"     .   end.
      124               when 'chown-dis-card':U then do:     assign       p-action-title        = "Смена владельца ДК"     .   end.
      125               when 'delete_nu-dis-rule':U then do:     assign       p-action-title        = "Удаление правила скидки по фирме и глобального правила скидки"     .   end.
      126               when 'ren-art':U then do:     assign       p-action-title        = "Изм. артикула и(или) произв. товара"     .   end.
      127               when 'delete_nu-clob-data':U then do:     assign       p-action-title        = "Удаление неиспользуемой clob-data"     .   end.
      128               when 'delete_nu-layout':U then do:     assign       p-action-title        = "Удаление РАСКЛАДКИ"     .   end.
      129               otherwise do:
      130           return error substitute( "&1. Неизвестный тип операции: &2", vss-include-info0, p-action-code ).
      131         end.
      132       end case.
      133     end.
      134     return.
      135   end procedure.
      136   FUNCTION progs-title-function returns character(
      137      input  p-action-code         as character):
      138   define variable p-action-title      as character no-undo .
      139     do
      140     on error undo, return error
      141     :
      142       case p-action-code :
      143               when 'crush_code-range':U then do:     assign       p-action-title        = "Разбиение диапазона кодов (code-range)"     .   end.
      144               when 'delete_code-range':U then do:     assign       p-action-title        = "Удаление диапазона кодов (code-range)"     .   end.
      145               when 'delete_nu-prt-bar-code':U then do:     assign       p-action-title        = "Удаление неисп. бар-кода признака"     .   end.
      146               when 'delete_nu-part-bar-code':U then do:     assign       p-action-title        = "Удаление неисп. бар-кода партиии"     .   end.
      147               when 'delete_nu-ucli-bar-code':U then do:     assign       p-action-title        = "Удаление неисп.бар-кода на доп ед.изм."     .   end.
      148               when 'delete_nu-dis-card':U then do:     assign       p-action-title        = "Удаление неиспользуемой ДК"     .   end.
      149               when 'chown-dis-card':U then do:     assign       p-action-title        = "Смена владельца ДК"     .   end.
      150               when 'delete_nu-dis-rule':U then do:     assign       p-action-title        = "Удаление правила скидки по фирме и глобального правила скидки"     .   end.
      151               when 'ren-art':U then do:     assign       p-action-title        = "Изм. артикула и(или) произв. товара"     .   end.
      152               when 'delete_nu-clob-data':U then do:     assign       p-action-title        = "Удаление неиспользуемой clob-data"     .   end.
      153               when 'delete_nu-layout':U then do:     assign       p-action-title        = "Удаление РАСКЛАДКИ"     .   end.
      154               otherwise do:
      155           return error substitute( "&1. Неизвестный тип операции: &2", vss-include-info0, p-action-code ).
      156         end.
      157       end case.
      158     end.
      159     return p-action-title.
      160   end FUNCTION.
      161   procedure get-row-keyr-string :
      162    define input  parameter p-key-rec  as character no-undo.
      163    define output parameter p-tbl-title as character no-undo.
      164    define output parameter p-rec-string  as character no-undo.
      165     do
      166     on error undo, return error
      167     :
      168       define variable v-full-tbl-name as character no-undo .
      169       define variable bh_tbl-name     as handle    no-undo .
      170       define variable fh              as handle    no-undo .
      171       define variable v-ok            as logical   no-undo .
      172       define variable v-field-num     as integer   no-undo .
      173       define variable v-count-fld     as integer   no-undo .
      174       define variable v-tbl-name as character no-undo.
      175       if p-key-rec = ?
      176         or p-key-rec = "":U
      177       then do:
      178         return error substitute( "&1 (get-row-keyr-string). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info0 ).
      179       end.
      180       assign
      181         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      182         v-full-tbl-name = "ub.":U + v-tbl-name
      183         v-field-num     = num-entries( p-key-rec, chr(3) ) - 1
      184         p-rec-string         = "":U
      185         v-count-fld     = 0
      186       .
      187       find ub._file
      188         where ub._file._file-name = v-tbl-name
      189         no-error.
      190       if not available ub._file then do:
      191         return error substitute( "&1. Таблица &2 отсутствует в БД", vss-include-info0, v-tbl-name ).
      192       end.
      193       assign
      194       p-tbl-title = ub._file._file-label
      195       .
      196       find ub._index
      197         where recid( ub._index  ) = ub._file._prime-index
      198         no-error.
      199       if not available ub._index
      200         or LC( ub._index._index-name ) = "default":U
      201       then do:
      202         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info0, v-tbl-name ).
      203       end.
      204       block_where :
      205       for each ub._index-field of ub._index  ,
      206           each ub._field of _index-field
      207           break by _index-seq
      208       on error undo, return error
      209       :
      210         assign
      211           v-count-fld = v-count-fld + 1
      212         .
      213         if v-count-fld > v-field-num then do:
      214           leave block_where.
      215         end.
      216         if p-rec-string = "":U then do:
      217           assign
      218             p-rec-string = "":U
      219           .
      220         end.
      221         else do:
      222           assign
      223             p-rec-string = p-rec-string + chr(32) + chr(44)
      224           .
      225         end.
      226         assign
      227           p-rec-string = p-rec-string + (if p-rec-string = "":u then "":U else chr(32)) + substitute( "&1 = &2":U, ub._field._label, entry( v-count-fld + 1 , p-key-rec, chr(3) ) )
      228         .
      229       end.
      230       if v-count-fld <> v-field-num then do:
      231         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info0, v-tbl-name ).
      232       end.
      233     end.
      234     return.
      235   end procedure.
      236   FUNCTION uniq-key-rec-string-f returns character(
      237      input  p-uniq-key-rec         as character):
      238   define variable v-tbl-title as character no-undo .
      239   define variable v-rec-string as character no-undo .
      240     do
      241     on error undo, return error
      242     :
      243       run get-row-keyr-string in this-procedure (
      244                                                 input p-uniq-key-rec
      245                                                 ,output v-tbl-title
      246                                                 ,output v-rec-string).
      247       assign
      248       v-rec-string = (if v-tbl-title <> ? and
      249                       v-tbl-title <> "":U
      250                       then (v-tbl-title + ":")
      251                      else "":U) + chr(32) + v-rec-string
      252       .
      253     end.
      254     return v-rec-string.
      255   end FUNCTION.
      256   procedure create_db-rec_route :
      257     define input parameter p1-uniq-key-rec as character no-undo .
      258     define input parameter p1-action       as character no-undo .
      259     define input parameter p1-operation    as character no-undo .
      260     define input parameter p1-send-db-list as character no-undo .
      261     define input parameter p1-db-init      as integer   no-undo .
      262     define input parameter p1-parameters   as character no-undo .
      263     define input parameter p1-answer-code  as integer   no-undo .
      264     define input parameter p1-answer-msg   as character no-undo .
      265     do
      266     on error undo, return error
      267     :
      268       define variable v-command     as character no-undo .
      269       define variable v-ind         as integer   no-undo .
      270       define variable v-num-entries as integer   no-undo .
      271       define variable v-curr-db     as integer   no-undo .
      272       define variable v-db-for-send as character no-undo .
      273       define variable v-db-num      as integer   no-undo .
      274       define variable v-db-num-char as character no-undo .
      275       define buffer buf_sys-ctrl    for ub.sys-ctrl .
      276       find first buf_sys-ctrl no-lock .
      277       assign
      278         v-curr-db     = buf_sys-ctrl.db-num
      279         v-db-for-send = "":U
      280       .
      281       if v-curr-db = 0 then do:
      282         if p1-answer-code >= 0 then do:
      283           if v-curr-db <> p1-db-init then do:
      284             assign
      285               v-db-for-send = string( p1-db-init )
      286             .
      287           end.
      288         end.
      289         else do:
      290           assign
      291             v-num-entries = num-entries( p1-send-db-list, chr(44) )
      292           .
      293           do v-ind = 1 to v-num-entries:
      294             assign
      295               v-db-num-char = entry( v-ind, p1-send-db-list, chr(44) )
      296               v-db-num      = integer( v-db-num-char )
      297             .
      298             if v-db-num <> v-curr-db
      299               and v-db-num <> p1-db-init
      300             then do:
      301               if v-db-for-send = "":U then do:
      302                 assign
      303                   v-db-for-send = v-db-num-char
      304                 .
      305               end.
      306               else do:
      307                 assign
      308                   v-db-for-send =  v-db-for-send + chr(1) + v-db-num-char
      309                 .
      310               end.
      311             end.
      312           end.
      313         end.
      314       end.
      315       else do:
      316         assign
      317           v-db-for-send = "0":U
      318         .
      319       end.
      320       if v-db-for-send <> "":U then do:
      321         assign
      322           v-command = "command":U + chr(1)
      323                       + "two-commit":U + chr(1)
      324                       + p1-action + chr(1)
      325                       + p1-operation + chr(1)
      326                       + p1-uniq-key-rec + chr(1)
      327                       + string( p1-db-init ) + chr(1)
      328                       + p1-parameters + chr(1)
      329                       + string( p1-answer-code ) + chr(1)
      330                       + p1-answer-msg
      331         .
      332         run nws/cr-route.p ( input 'send-cmd':U
      333                       ,input v-command
      334                       ,input ?
      335                       ,input v-db-for-send
      336                       ) no-error .
      337         if error-status :error then do:
      338           return error return-value.
      339         end.
      340       end.
      341     end.
      342     return.
      343   end procedure.
      344   procedure create_msg_route :
      345     define input parameter p2-send-db-list as character no-undo .
      346     define input parameter p2-msg          as character no-undo .
      347     do
      348     on error undo, return error
      349     :
      350       define variable v-msg-command as character no-undo .
      351       define variable v-ind         as integer   no-undo .
      352       define variable v-num-entries as integer   no-undo .
      353       define variable v-curr-db     as integer   no-undo .
      354       define variable v-db-for-send as character no-undo .
      355       define variable v-db-num      as integer   no-undo .
      356       define variable v-db-num-char as character no-undo .
      357       define buffer buf_sys-ctrl    for ub.sys-ctrl .
      358       find first buf_sys-ctrl no-lock .
      359       assign
      360         v-curr-db     = buf_sys-ctrl.db-num
      361         v-db-for-send = "":U
      362       .
      363       if v-curr-db = 0 then do:
      364         assign
      365           v-num-entries = num-entries( p2-send-db-list, chr(44) )
      366         .
      367         do v-ind = 1 to v-num-entries:
      368           assign
      369             v-db-num-char = entry( v-ind, p2-send-db-list, chr(44) )
      370             v-db-num      = integer( v-db-num-char )
      371           .
      372           if v-db-num <> v-curr-db then do:
      373             if v-db-for-send = "":U then do:
      374               assign
      375                 v-db-for-send = v-db-num-char
      376               .
      377             end.
      378             else do:
      379               assign
      380                 v-db-for-send =  v-db-for-send + chr(1) + v-db-num-char
      381               .
      382             end.
      383           end.
      384         end.
      385       end.
      386       else do:
      387         assign
      388           v-db-for-send = "0":U
      389         .
      390       end.
      391       if v-db-for-send <> "":U then do:
      392         assign
      393           v-msg-command = "command":U + chr(1)
      394                           + "message-to-log":U + chr(1)
      395                           + p2-msg
      396         .
      397         run nws/cr-route.p ( input 'send-cmd':U
      398                       ,input v-msg-command
      399                       ,input ?
      400                       ,input v-db-for-send
      401                       ) no-error .
      402         if error-status :error then do:
      403           return error substitute( "&1&2&3"
      404                                     , return-value
      405                                     , chr(10)
      406                                     , error-status :get-message(1)
      407                                   ).
      408         end.
      409       end.
      410     end.
      411     return.
      412   end procedure.
      413   function get-send-db-list returns character
      414     ( input p-curr-db     as integer
      415      ,input p-all-db-list as character
      416     )
      417   :
      418     define variable v-send-db-list as character no-undo .
      419     if p-curr-db = 0 then do:
      420       assign
      421         v-send-db-list = p-all-db-list
      422       .
      423     end.
      424     else do:
      425       assign
      426         v-send-db-list = string(p-curr-db)
      427       .
      428     end.
      429     return v-send-db-list .
      430   end function .
      431   do
      432   on error  undo, return error substitute("&1. error &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      433   on endkey undo, return error substitute("&1. endkey")
      434   on stop   undo, return error substitute("&1. stop")
      435   :
      436     define variable v-main-prog-name      as character no-undo .
      437     define variable v-list-db-proc-name   as character no-undo .
      438     define variable v-commit-proc-name    as character no-undo .
      439     define variable v-execution-proc-name as character no-undo .
      440     define variable v-recover-proc-name   as character no-undo .
      441     define variable v-after-proc-name     as character no-undo .
      442     define variable v-ext-prg-handle      as handle    no-undo .
      443     define variable v-err-msg      as character no-undo .
      444     define variable v-ind          as integer   no-undo .
      445     define variable v-num-entries  as integer   no-undo .
      446     define variable v-send-db-list as character no-undo .
      447     define variable v-all-db-list  as character no-undo .
      448     define variable v-curr-db      as integer   no-undo .
      449     define variable v-db-init      as integer   no-undo .
      450     define variable v-operation    as character no-undo .
      451     define variable v-answer-code  as integer   no-undo .
      452     define variable v-answer-msg   as character no-undo .
      453     define variable v-is-begin     as logical   no-undo .
      454     define variable v-run-proc     as logical   no-undo .
      455     define variable v-command      as character no-undo .
      456     define buffer buf_sys-ctrl    for ub.sys-ctrl .
      457     define buffer buf_db          for ub.db .
      458     define buffer buf_db-rec-attr for ub.db-rec-attr .
      459     if num-entries( p-action, chr(1) ) = 2 then do:
      460       if entry( 2, p-action, chr(1) ) = "not-begin":U then do:
      461         assign
      462           p-action   = entry( 1, p-action, chr(1) )
      463           v-is-begin = false
      464         .
      465       end.
      466       else do:
      467         undo, return error substitute( "Недопустимый тип операции &1 над записью &2", p-action, p-uniq-key-rec ).
      468       end.
      469     end.
      470     else do:
      471       assign
      472         v-is-begin = true
      473       .
      474     end.
      475     find first buf_sys-ctrl no-lock .
      476     assign
      477       v-curr-db  = buf_sys-ctrl.db-num
      478       v-run-proc = true
      479     .
      480     run progs-name( input p-action
      481                    ,output v-main-prog-name
      482                    ,output v-list-db-proc-name
      483                    ,output v-commit-proc-name
      484                    ,output v-execution-proc-name
      485                    ,output v-recover-proc-name
      486                    ,output v-after-proc-name
      487                   ) no-error .
      488     if error-status :error then do:
      489       undo, return error substitute( "&1. Ошибка при определении имен процедур. &2", vss-workfile, return-value ).
      490     end.
      491     run value( v-list-db-proc-name )
      492       ( input p-action
      493        ,input p-uniq-key-rec
      494        ,output v-all-db-list
      495       ) no-error .
      496     if error-status :error then do:
      497       undo, return error substitute( "&1. Ошибка при определении списка БД. &2", vss-workfile, return-value ).
      498     end.
      499     assign
      500       v-send-db-list = get-send-db-list( v-curr-db, v-all-db-list )
      501     .
      502     find first buf_db-rec-attr exclusive-lock
      503       where buf_db-rec-attr.db-num       = v-curr-db
      504         and buf_db-rec-attr.uniq-key-rec = p-uniq-key-rec
      505         and buf_db-rec-attr.attr-code    = p-action
      506       no-wait no-error.
      507     if available buf_db-rec-attr
      508       or ( not available buf_db-rec-attr
      509            and locked buf_db-rec-attr
      510          )
      511     then do:
      512       if v-is-begin = true then do:
      513         if g#news = true then do:
      514           return substitute( "Операция &1 над записью &2 уже производится"
      515                               , p-action, p-uniq-key-rec
      516                             ).
      517         end.
      518         else do:
      519           undo, return error substitute( "Операция &1 над записью &2 уже производится", p-action, p-uniq-key-rec ).
      520         end.
      521       end.
      522     end.
      523     else do:
      524       if v-is-begin = false then do:
      525         undo, return error substitute( "Недопустимо начинать выполнять операцию &1 над записью &2 без ее инициализации", p-action, p-uniq-key-rec ).
      526       end.
      527       find first buf_db-rec-attr exclusive-lock
      528         where buf_db-rec-attr.uniq-key-rec = p-uniq-key-rec
      529           and buf_db-rec-attr.attr-code    = p-action
      530         no-wait no-error.
      531       if available buf_db-rec-attr
      532         or ( not available buf_db-rec-attr
      533             and locked buf_db-rec-attr
      534           )
      535       then do:
      536         undo, return error substitute( "&1. Уже есть запрос с кодом &2 для записи &3.", vss-workfile, p-action, p-uniq-key-rec ).
      537       end.
      538       assign
      539         v-db-init     = 0
      540         v-num-entries = num-entries( v-send-db-list, chr(44) )
      541       .
      542       if not ( ( v-num-entries = 1
      543                   and v-send-db-list <> "0":U
      544                 )
      545                 or v-num-entries >= 2
      546               )
      547       then do:
      548         message
      549           vss-workfile vss-revision vss-description skip
      550           "Данная процедура предназначена только для работы с" skip
      551           "несколькими БД, а запускается для работы с одной!!!" skip
      552           "Список БД:" v-send-db-list
      553           view-as alert-box error.
      554         undo, return error.
      555       end.
      556       if v-curr-db <> 0 then do:
      557         assign
      558           v-run-proc = false
      559           v-command = "command":U + chr(1)
      560                       + "inquiry-two-commit":U + chr(1)
      561                       + p-action + chr(1)
      562                       + p-uniq-key-rec + chr(1)
      563                       + p-parameters
      564         .
      565         run nws/cr-route.p ( input 'send-cmd':U
      566                         ,input v-command
      567                         ,input ?
      568                         ,input "0":U
      569                       ) no-error .
      570         if error-status :error then do:
      571           undo, return error substitute( "&1. Ошибка при отправке команды на выполнение операции над записью &2.&3&4&5&6"
      572                                          , vss-workfile
      573                                          , p-uniq-key-rec
      574                                          , chr(10)
      575                                          , return-value
      576                                          , chr(10)
      577                                          , error-status :get-message(1)
      578                                        ).
      579         end.
      580       end.
      581       else do:
      582         do v-ind = 1 to v-num-entries
      583         :
      584           create buf_db-rec-attr.
      585           assign
      586             buf_db-rec-attr.db-num             = integer( entry( v-ind, v-send-db-list, chr(44) ) )
      587             buf_db-rec-attr.uniq-key-rec       = p-uniq-key-rec
      588             buf_db-rec-attr.attr-code          = p-action
      589             buf_db-rec-attr.attr-type          = "commit":U
      590             buf_db-rec-attr.attr-value         = p-parameters
      591             buf_db-rec-attr.attr-value-decimal = v-db-init
      592             buf_db-rec-attr.attr-value-date    = TODAY
      593             buf_db-rec-attr.attr-value-logical = FALSE
      594           .
      595           release buf_db-rec-attr.
      596         end.
      597         run create_msg_route in this-procedure
      598           ( input v-send-db-list
      599            ,input substitute( "Начинается выполнение операции &1 над записью &2"
      600                               ,p-action
      601                               ,p-uniq-key-rec
      602                             )
      603           ) no-error .
      604         if error-status :error then do:
      605           undo, return error substitute( "&1. Ошибка при отправке сообщения по СПН. &2", vss-workfile, return-value ).
      606         end.
      607       end.
      608     end.
      609     if v-run-proc = true then do:
      610       find first buf_db-rec-attr exclusive-lock
      611         where buf_db-rec-attr.db-num       = v-curr-db
      612           and buf_db-rec-attr.uniq-key-rec = p-uniq-key-rec
      613           and buf_db-rec-attr.attr-code    = p-action
      614       .
      615       assign
      616         v-db-init   = buf_db-rec-attr.attr-value-decimal
      617         v-operation = buf_db-rec-attr.attr-type
      618       .
      619       run value( v-main-prog-name ) persistent
      620           set v-ext-prg-handle .
      621       case buf_db-rec-attr.attr-type :
      622         when "commit":U then do:
      623           if v-run-proc = true then do:
      624             run value( v-commit-proc-name ) in v-ext-prg-handle
      625               ( input buf_db-rec-attr.db-num
      626               , input buf_db-rec-attr.uniq-key-rec
      627               , input buf_db-rec-attr.attr-code
      628               , input buf_db-rec-attr.attr-value
      629               , output v-err-msg
      630               ) no-error .
      631             if error-status :error then do:
      632               undo, return error substitute( "&1. Ошибка при блокировке записи &2.&3&4&5&6"
      633                                              , vss-workfile
      634                                              , buf_db-rec-attr.uniq-key-rec
      635                                              , chr(10)
      636                                              , return-value
      637                                              , chr(10)
      638                                              , error-status :get-message(1)
      639                                            ).
      640             end.
      641           end.
      642           if v-is-begin = true then do:
      643             if v-err-msg = "":U then do:
      644               run create_db-rec_route in this-procedure
      645                 ( input p-uniq-key-rec
      646                 , input p-action
      647                 , input "commit":U
      648                 , input v-send-db-list
      649                 , input v-db-init
      650                 , input p-parameters
      651                 , input -1
      652                 , input ""
      653                 ) no-error .
      654               if error-status :error then do:
      655                 undo, return error substitute( "&1. Ошибка при отправке команды по СПН. &2", vss-workfile, return-value ).
      656               end.
      657             end.
      658             else do:
      659               for each buf_db-rec-attr
      660                 where buf_db-rec-attr.uniq-key-rec = p-uniq-key-rec
      661                   and buf_db-rec-attr.attr-code    = p-action
      662               on error  undo, return error substitute("&1. error buf_db-rec-attr &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      663               on endkey undo, return error substitute("&1. endkey buf_db-rec-attr")
      664               on stop   undo, return error substitute("&1. stop buf_db-rec-attr")
      665               :
      666                 delete buf_db-rec-attr.
      667               end.
      668             end.
      669           end.
      670         end.
      671         when "execution":U then do:
      672           run value( v-execution-proc-name ) in v-ext-prg-handle
      673             ( input buf_db-rec-attr.db-num
      674             , input buf_db-rec-attr.uniq-key-rec
      675             , input buf_db-rec-attr.attr-code
      676             , input buf_db-rec-attr.attr-value
      677             , output v-err-msg
      678             ) no-error .
      679           if error-status :error then do:
      680             undo, return error substitute( "&1. Ошибка при выполнении операции над записью &2.&3&4&5&6"
      681                                            , vss-workfile
      682                                            , buf_db-rec-attr.uniq-key-rec
      683                                            , chr(10)
      684                                            , return-value
      685                                            , chr(10)
      686                                            , error-status :get-message(1)
      687                                          ).
      688           end.
      689         end.
      690         when "recover":U then do:
      691           run value( v-recover-proc-name ) in v-ext-prg-handle
      692             ( input buf_db-rec-attr.db-num
      693             , input buf_db-rec-attr.uniq-key-rec
      694             , input buf_db-rec-attr.attr-code
      695             , input buf_db-rec-attr.attr-value
      696             , output v-err-msg
      697             ) no-error .
      698           if error-status :error then do:
      699             undo, return error substitute( "&1. Ошибка при выполнении отката операции над записью &2.&3&4&5&6"
      700                                            , vss-workfile
      701                                            , buf_db-rec-attr.uniq-key-rec
      702                                            , chr(10)
      703                                            , return-value
      704                                            , chr(10)
      705                                            , error-status :get-message(1)
      706                                          ).
      707           end.
      708         end.
      709       end case.
      710       delete procedure v-ext-prg-handle .
      711       if v-err-msg <> "":U then do:
      712         return v-err-msg .
      713       end.
      714       else do:
      715         assign
      716           buf_db-rec-attr.attr-value-date    = TODAY
      717           buf_db-rec-attr.attr-value-logical = TRUE
      718         .
      719       end.
      720     end.
      721     return.
      722   end.
