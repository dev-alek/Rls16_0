      380   function diff-list returns character (
      381     input parfirst-list  as character,
      382     input parsecond-list as character,
      383     input pardelim       as character).
      384     if pardelim = ""
      385     or pardelim = ?
      386     then do:
      387       assign
      388         pardelim = ","
      389       .
      390     end.
      391     def var ind as integer no-undo .
      392     def var v-elem as character no-undo .
      393     def var v-result-list as character no-undo init "".
      394     def var v-num-parfirst-list as integer no-undo .
      395     assign
      396       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      397     .
      398     do ind = 1 to v-num-parfirst-list
      399     :
      400       assign
      401         v-elem = entry(ind, parfirst-list, pardelim)
      402       .
      403       if lookup(v-elem, parsecond-list, pardelim) = 0 then do:
      404         assign
      405           v-result-list = v-result-list
      406                         + (if v-result-list > "" then pardelim else "")
      407                         + v-elem
      408         .
      409       end.
      410     end.
      411     return v-result-list .
      412   end function.
      413   function add-list returns character (
      414    input parfirst-list  as character,
      415    input parsecond-list as character,
      416    input pardelim       as character).
      417     if pardelim = ""
      418     or pardelim = ?
      419     then do:
      420       assign
      421         pardelim = ","
      422       .
      423     end.
      424     def var ind as integer no-undo .
      425     def var v-elem as character no-undo .
      426     def var v-result-list as character no-undo init "".
      427     def var v-num-parfirst-list as integer no-undo .
      428     assign
      429       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      430     .
      431     do ind = 1 to v-num-parfirst-list
      432     :
      433       assign
      434         v-elem = entry(ind, parfirst-list, pardelim)
      435       .
      436       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      437         assign
      438           v-result-list = v-result-list
      439                         + (if v-result-list > "" then pardelim else "")
      440                         + v-elem
      441         .
      442       end.
      443     end.
      444     def var v-num-parsecond-list as integer no-undo .
      445     assign
      446       v-num-parsecond-list = num-entries(parsecond-list, pardelim)
      447     .
      448     do ind = 1 to v-num-parsecond-list
      449     :
      450       assign
      451         v-elem = entry(ind, parsecond-list, pardelim)
      452       .
      453       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      454         assign
      455           v-result-list = v-result-list
      456                         + (if v-result-list > "" then pardelim else "")
      457                         + v-elem
      458         .
      459       end.
      460     end.
      461     return v-result-list .
      462   end function.
      463   function cross-list returns character (
      464    input parfirst-list  as character,
      465    input parsecond-list as character,
      466    input pardelim       as character).
      467     if pardelim = ""
      468     or pardelim = ?
      469     then do:
      470       assign
      471         pardelim = ","
      472       .
      473     end.
      474     def var ind as integer no-undo .
      475     def var v-elem as character no-undo .
      476     def var v-result-list as character no-undo init "".
      477     def var v-num-parfirst-list as integer no-undo .
      478     assign
      479       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      480     .
      481     do ind = 1 to v-num-parfirst-list
      482     :
      483       assign
      484         v-elem = entry(ind, parfirst-list, pardelim)
      485       .
      486       if lookup(v-elem, v-result-list, pardelim) = 0
      487       and lookup(v-elem, parsecond-list, pardelim) > 0
      488       then do:
      489         assign
      490           v-result-list = v-result-list
      491                         + (if v-result-list > "" then pardelim else "")
      492                         + v-elem
      493         .
      494       end.
      495     end.
      496     return v-result-list .
      497   end function.
      498   function radio-label returns character (
      499    input par-rs-value  as character,
      500    input par-rs-radio-buttons as character)
      501    .
      502    DEFINE variable v-result-label as character no-undo.
      503    assign
      504    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons) MODULO 2 = 0)
      505                              then (LOOKUP(par-rs-value, par-rs-radio-buttons) - 1)
      506                              else LOOKUP(par-rs-value, par-rs-radio-buttons)
      507                             ), par-rs-radio-buttons
      508                           )
      509    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      510    .
      511   return v-result-label.
      512   end function.
      513   function m-radio-label returns character (
      514    input par-rs-value  as character,
      515    input par-rs-radio-buttons as character,
      516    input par-delim as character
      517    )
      518    .
      519    DEFINE variable v-result-label as character no-undo.
      520    assign
      521    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) MODULO 2 = 0)
      522                              then (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) - 1)
      523                              else LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim)
      524                             ), par-rs-radio-buttons, par-delim
      525                           )
      526    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      527    .
      528   return v-result-label.
      529   end function.
      530   FUNCTION mixlist returns character
      531   (
      532    input parfirst-list  as character
      533    ,input parsecond-list as character
      534    ,input pardelim       as character
      535    ,input pardelim-result as character ) :
      536     if pardelim = ""
      537     or pardelim = ?
      538     then do:
      539       assign
      540         pardelim = ","
      541       .
      542     end.
      543     def var ind as integer no-undo .
      544     def var v-elem1 as character no-undo .
      545     def var v-elem2 as character no-undo .
      546     def var v-result-list as character no-undo init "".
      547     do ind = 1 to num-entries(parfirst-list, pardelim)
      548     :
      549       assign
      550         v-elem1 = entry(ind, parfirst-list, pardelim)
      551         v-elem2 = entry(ind, parsecond-list, pardelim)
      552       .
      553         assign
      554           v-result-list = v-result-list
      555                         + (if v-result-list > "" then pardelim-result else "")
      556                         + v-elem1 + pardelim-result + v-elem2
      557         .
      558     end.
      559     return v-result-list .
      560   END FUNCTION.
      561   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      562   function prepare-path returns character ( input p-nonprepared-path as character ):
      563   define variable v-prepared-path as character no-undo .
      564   assign
      565   v-prepared-path = replace(p-nonprepared-path, chr(92), chr(47))
      566   v-prepared-path = right-trim(v-prepared-path, chr(47))
      567   .
      568   return v-prepared-path.
      569   END FUNCTION.
      570   function prepare-path2 returns character ( input p-nonprepared-path as character ):
      571   define variable v-prepared-path as character no-undo .
      572   assign
      573   v-prepared-path = replace(p-nonprepared-path, chr(47), chr(92))
      574   v-prepared-path = right-trim(v-prepared-path, chr(92))
      575   .
      576   return v-prepared-path.
      577   END FUNCTION.
      578   function quote-spaces returns character ( input p-full-path as character):
      579   define variable v-ii as integer no-undo .
      580   define variable v-result as character no-undo .
      581   do v-ii = 1 to num-entries(p-full-path, chr(92)):
      582     v-result = v-result + (if v-ii = 1 then '' else chr(92)) +
      583                (if index(entry(v-ii, p-full-path, chr(92)), chr(32)) > 0
      584                then  substitute("&1&2&1", chr(34), entry(v-ii, p-full-path, chr(92)))
      585                else entry(v-ii, p-full-path, chr(92))
      586                )
      587     .
      588   end.
      589   return v-result.
      590   end function.
      591   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      592   procedure cur-time :
      593      define output parameter p-today as date      no-undo .
      594      define output parameter p-time  as integer   no-undo .
      595     do
      596     on error undo, return error
      597     :
      598       define variable v-date1 as date      no-undo .
      599       define variable v-date2 as date      no-undo .
      600       define variable v-time  as integer   no-undo .
      601       assign
      602         v-date1 = today
      603         v-time  = time
      604         v-date2 = today
      605       .
      606       if v-date1 <> v-date2
      607       then do:
      608         assign
      609           v-date1 = today
      610           v-time  = v-time
      611         .
      612       end.
      613       assign
      614         p-today = v-date1
      615         p-time  = v-time
      616       .
      617     end.
      618   end.
      619   function cur-time-date returns character
      620   :
      621     return string(today, '99/99/9999':U) .
      622   end.
      623   function cur-time-mjd returns decimal
      624   :
      625     define variable v-date as date      no-undo .
      626     define variable v-time as integer   no-undo .
      627     run cur-time in this-procedure
      628       (output v-date
      629       ,output v-time
      630       ) .
      631     return integer(v-date) - 2400002 + (v-time / 86400) .
      632   end.
      633   function cur-time-get-ending-index returns integer
      634   (input p-number as integer
      635   )
      636   :
      637     if p-number < 0
      638     or p-number = ?
      639     then do:
      640       return 1 .
      641     end.
      642     define variable v-rest as integer   no-undo .
      643     assign
      644       p-number = p-number modulo 100
      645     .
      646     if p-number < 20
      647     then do:
      648       assign
      649         v-rest = p-number
      650       .
      651     end.
      652     else do:
      653       assign
      654         v-rest = p-number modulo 10
      655       .
      656     end.
      657     case v-rest :
      658       when 1
      659       then do:
      660         return 2 .
      661       end.
      662       when 2 or
      663       when 3 or
      664       when 4
      665       then do:
      666         return 3 .
      667       end.
      668       otherwise do:
      669         return 1 .
      670       end.
      671     end case .
      672   end.
      673   procedure cur-time-mjd-to-date :
      674      define input  parameter i-mjd-diff as decimal no-undo.
      675      define output parameter o-Date     as date    no-undo.
      676      define output parameter o-Time     as integer no-undo.
      677      define variable v-day-number as integer   no-undo .
      678      if    i-mjd-diff < 0
      679         or i-mjd-diff = ?
      680      then do:
      681         return "?" .
      682      end.
      683      assign
      684         v-day-number = truncate(i-mjd-diff,0).
      685         o-Date = date(v-day-number + 2400002).
      686         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      687     .
      688   end.
      689   function cur-time-mjd-to-string returns character
      690   (input p-mjd-diff as decimal
      691   )
      692   :
      693     define variable v-day-number as integer   no-undo .
      694     define variable v-seconds    as integer   no-undo .
      695     define variable v-hour       as integer   no-undo .
      696     define variable v-min        as integer   no-undo .
      697     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      698     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      699     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      700     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      701     if p-mjd-diff < 0
      702     or p-mjd-diff = ?
      703     then do:
      704       return "?" .
      705     end.
      706     assign
      707       v-day-number = integer(truncate(p-mjd-diff,0))
      708       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      709     .
      710     if v-seconds > 86400
      711     then do:
      712       assign
      713         v-seconds = 86400 - 1
      714       .
      715     end.
      716     if v-seconds < 0
      717     then do:
      718       assign
      719         v-seconds = 0
      720       .
      721     end.
      722     assign
      723       v-hour = truncate(v-seconds / 3600, 0)
      724     .
      725     assign
      726       v-seconds = v-seconds modulo 3600
      727     .
      728     assign
      729       v-min = truncate(v-seconds / 60, 0)
      730     .
      731     assign
      732       v-seconds = v-seconds modulo 60
      733     .
      734     return
      735         (if v-day-number <> 0
      736           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      737           else ""
      738         )
      739       + (if v-day-number <> 0 or v-hour <> 0
      740           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      741           else ""
      742         )
      743       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      744           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      745           else ""
      746         )
      747       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      748       .
      749   end.
      750   function cur-time-string returns character
      751   :
      752     define variable v-date as date      no-undo .
      753     define variable v-time as integer   no-undo .
      754     run cur-time in this-procedure
      755       (output v-date
      756       ,output v-time
      757       ) .
      758     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      759   end.
      760   function cur-time-string-sec returns character
      761   :
      762     define variable v-date as date      no-undo .
      763     define variable v-time as integer   no-undo .
      764     run cur-time in this-procedure
      765       (output v-date
      766       ,output v-time
      767       ) .
      768     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      769   end.
      770   function cur-time-custom  returns character
      771   (input p-prefix as character
      772   ,input p-date-format as character
      773   ,input p-delimiter as character
      774   ,input p-time-format as character
      775   ,input p-suffix as character
      776   )
      777   :
      778     define variable v-date as date      no-undo .
      779     define variable v-time as integer   no-undo .
      780     run cur-time in this-procedure
      781       (output v-date
      782       ,output v-time
      783       ) .
      784     return
      785       p-prefix
      786       + string(v-date, p-date-format)
      787       + p-delimiter
      788       + string(v-time, p-time-format)
      789       + p-suffix
      790       .
      791   end.
      792   function cur-time-print  returns character
      793   :
      794     define variable v-date as date      no-undo .
      795     define variable v-time as integer   no-undo .
      796     run cur-time in this-procedure
      797       (output v-date
      798       ,output v-time
      799       ) .
      800     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      801   end.
      802   function cur-time-datetime returns datetime
      803   :
      804     define variable v-char as character no-undo .
      805     define variable v-datetime as datetime no-undo .
      806     v-char = cur-time-string().
      807     v-datetime = datetime(v-char).
      808     return  v-datetime.
      809   end.
      810   function cur-time-string-msec returns character
      811   :
      812     define variable v-date as datetime  no-undo .
      813     v-date = now.
      814     return string(v-date) .
      815   end.
      816   DEFINE VARIABLE v-file-num AS INTEGER NO-UNDO.
      817   define variable glog as logical no-undo .
      818   DEFINE BUTTON b-add
      819        LABEL "&Добавить"
      820        SIZE 10 BY 1.
      821   DEFINE BUTTON B-all-deselect
      822        LABEL "&-Все"
      823        SIZE 10 BY 1.
      824   DEFINE BUTTON B-all-select
      825        LABEL "&+Все"
      826        SIZE 10 BY 1.
      827   DEFINE BUTTON b-del
      828        LABEL "&Удалить"
      829        SIZE 10 BY 1.
      830   DEFINE BUTTON B-exit AUTO-GO
      831        LABEL "&Ввод"
      832        SIZE 10 BY 1
      833        BGCOLOR 8 .
      834   DEFINE BUTTON B-Help
      835        LABEL "Помо&щь"
      836        SIZE 10 BY 1
      837        BGCOLOR 8 .
      838   DEFINE BUTTON b-mark
      839        LABEL "&*"
      840        SIZE 4 BY 1.
      841   DEFINE BUTTON B-params
      842        LABEL "&Пар-тры"
      843        SIZE 10 BY 1.
      844   DEFINE BUTTON b-quit AUTO-END-KEY
      845        LABEL "&Отмена"
      846        SIZE 10 BY 1
      847        BGCOLOR 8 .
      848   DEFINE VARIABLE f-path AS CHARACTER FORMAT "X(256)":U
      849        LABEL "Путь"
      850        VIEW-AS FILL-IN
      851        SIZE 55.5 BY 1 TOOLTIP "Абс. путь, относ. путь или настройка ini-файла (секция,параметр)" NO-UNDO.
      852   DEFINE VARIABLE Rs-mode AS CHARACTER
      853        VIEW-AS RADIO-SET VERTICAL
      854        RADIO-BUTTONS
      855             "Сохранить в текущей БД", "save-this-db",
      856   "Выложить на диск другой БД", "save-disk",
      857   "Сохранить в другой БД", "save-db",
      858   "Пакет обновления", "save-install",
      859   "Выложить на диск другой БД и запустить", "save-disk-and-run",
      860   "Сохранить в другой БД и запустить", "save-DB-and-run"
      861        SIZE 45 BY 4.27 NO-UNDO.
      862   DEFINE VARIABLE rs-path-type AS INTEGER
      863        VIEW-AS RADIO-SET VERTICAL
      864        RADIO-BUTTONS
      865             "Относительный", 0,
      866   "Абсолютный", 1,
      867   "Настройки из ini-файла IBS TH", 2
      868        SIZE 39.5 BY 2.7 NO-UNDO.
      869   DEFINE QUERY BR-db FOR
      870         X_db,
      871         tt-db SCROLLING.
      872   DEFINE QUERY BR-files FOR
      873         tt-ext-file SCROLLING.
      874   DEFINE BROWSE BR-db
      875     QUERY BR-db NO-LOCK DISPLAY
      876         (if available tt-db then "*" else "":U) FORMAT "X(1)":U WIDTH 2
      877         X_db.db-num FORMAT ">>>>9":U WIDTH 6
      878         X_db.db-name FORMAT "X(40)":U WIDTH 22
      879       WITH NO-ROW-MARKERS SEPARATORS SIZE 33.3 BY 8.67
      880            TITLE "Список БД" ROW-HEIGHT-CHARS .67 FIT-LAST-COLUMN.
      881   DEFINE BROWSE BR-files
      882     QUERY BR-files NO-LOCK DISPLAY
      883         tt-ext-file.file-name COLUMN-LABEL "Имя и путь к файлу - на компьютере источнике" FORMAT "X(255)":U
      884               WIDTH 74
      885         tt-ext-file.file-size COLUMN-LABEL "Размер (б)" FORMAT ">>>>>>>>9":U
      886         tt-ext-file.update-sys-date COLUMN-LABEL "Дата изм." FORMAT "99/99/9999":U
      887               WIDTH 11
      888         tt-ext-file.update-sys-time COLUMN-LABEL "Время изм." FORMAT "X(8)":U
      889               WIDTH 9
      890         tt-ext-file.create-sys-date COLUMN-LABEL "Дата созд." FORMAT "99/99/9999":U
      891         tt-ext-file.create-sys-time COLUMN-LABEL "Время созд." FORMAT "X(8)":U
      892               WIDTH 9
      893       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 7.07 FIT-LAST-COLUMN.
      894   DEFINE FRAME Dialog-Frame
      895        B-exit AT ROW 1 COL 1
      896        b-quit AT ROW 1 COL 11
      897        B-Help AT ROW 1 COL 88
      898        b-mark AT ROW 2 COL 66.5
      899        B-all-select AT ROW 2 COL 70.5
      900        B-all-deselect AT ROW 2 COL 80.5
      901        BR-db AT ROW 3 COL 66.5
      902        Rs-mode AT ROW 3.13 COL 2.5 NO-LABEL
      903        rs-path-type AT ROW 9 COL 2.5 NO-LABEL
      904        f-path AT ROW 11.8 COL 6.5 COLON-ALIGNED
      905        b-add AT ROW 12 COL 66.5
      906        b-del AT ROW 12 COL 76.5
      907        B-params AT ROW 12 COL 86.5
      908        BR-files AT ROW 13 COL 1
      909        "Тип пути к файлу - (на компьютере-приемнике)" VIEW-AS TEXT
      910             SIZE 44 BY .8 AT ROW 8 COL 2.5
      911             FGCOLOR 4
      912        "Режим передачи файла" VIEW-AS TEXT
      913             SIZE 44 BY .8 AT ROW 2 COL 2.5
      914             FGCOLOR 4
      915        SPACE(53.30) SKIP(17.28)
      916       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      917            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      918            TITLE "Опции пересылки файлов чере СПН и/или регистрации пакетов обновлений"
      919            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
      920   ASSIGN
      921          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      922          FRAME Dialog-Frame:HIDDEN           = TRUE.
      923   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      924   DO:
      925     APPLY "END-ERROR":U TO SELF.
      926   END.
      927   ON CHOOSE OF b-add IN FRAME Dialog-Frame
      928   DO:
      929     run proc-add-file IN THIS-PROCEDURE NO-ERROR.
      930     IF ERROR-STATUS:ERROR  THEN RETURN NO-APPLY.
      931   END.
      932   ON CHOOSE OF B-all-deselect IN FRAME Dialog-Frame
      933   DO:
      934     run proc-b-all-deselect IN THIS-PROCEDURE NO-ERROR.
      935     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      936   END.
      937   ON CHOOSE OF B-all-select IN FRAME Dialog-Frame
      938   DO:
      939     run proc-b-all-select IN THIS-PROCEDURE NO-ERROR.
      940     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      941   END.
      942   ON CHOOSE OF b-del IN FRAME Dialog-Frame
      943   DO:
      944     DEFINE BUFFER buf_tt-ext-file FOR tt-ext-file.
      945     IF NOT AVAILABLE tt-ext-file THEN RETURN NO-APPLY.
      946     FIND FIRST buf_tt-ext-file WHERE
      947               recid(buf_tt-ext-file) = RECID(tt-ext-file).
      948     DELETE buf_tt-ext-file.
      949     OPEN QUERY BR-files FOR EACH tt-ext-file NO-LOCK INDEXED-REPOSITION.
      950     find FIRST buf_tt-ext-file NO-LOCK NO-ERROR.
      951     IF NOT AVAILABLE buf_tt-ext-file
      952     and p-mode = 'save-install':U
      953     THEN DO:
      954         rs-mode:ENABLE(radio-label('save-install':U, RS-mode:RADIO-BUTTONS IN FRAME Dialog-Frame)) IN FRAME Dialog-Frame.
      955     END.
      956     IF NOT AVAILABLE buf_tt-ext-file
      957     and p-mode = 'save-this-db':U
      958     THEN DO:
      959         rs-mode:ENABLE(radio-label('save-this-db':U, RS-mode:RADIO-BUTTONS IN FRAME Dialog-Frame)) IN FRAME Dialog-Frame.
      960     END.
      961   END.
      962   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
      963   DO:
      964     DEFINE VARIABLE glog AS LOGICAL NO-UNDO.
      965     define buffer buf_tt-ext-file for tt-ext-file.
      966     ASSIGN
      967     rs-mode
      968     rs-path-type
      969     f-path.
      970     find first buf_tt-ext-file no-lock no-error.
      971     if not available buf_tt-ext-file then do:
      972       message
      973       "Вы не выбрали ни одного файла для пересылки/сохранения"
      974       view-as alert-box error .
      975       return no-apply.
      976     end.
      977     IF rs-path-type > 0
      978     AND f-path = '':U
      979     AND rs-mode <> 'save-db':U    THEN DO:
      980        MESSAGE
      981        substitute("Для типа пути АБСОЛЮТНЫЙ или НАСТРОЙКИ ИЗ INI-ФАЙЛА IBS TH&1" +
      982                   "необходимо указать ПУТЬ"
      983                   , chr(10)
      984                   )
      985        VIEW-AS ALERT-BOX ERROR .
      986        RETURN NO-APPLY.
      987     END.
      988     IF rs-path-type = 0
      989      AND f-path = '':U
      990     AND not (rs-mode = 'save-db':U
      991             or
      992             rs-mode = 'save-db-and-run':U
      993             or
      994             rs-mode = 'save-this-db':U
      995             or
      996             rs-mode = 'save-install':U)
      997     THEN DO:
      998         MESSAGE
      999         substitute("Файлы будут установлены в директорию R-кодов IBS TH&1" +
     1000                    "Вы уверены в Вашем решении?"
     1001                    , chr(10)
     1002                    )
     1003         VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE glog .
     1004         IF NOT glog  THEN RETURN NO-APPLY.
     1005     END.
     1006     run proc-run IN THIS-PROCEDURE NO-ERROR.
     1007     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1008   END.
     1009   ON CHOOSE OF b-mark IN FRAME Dialog-Frame
     1010   DO:
     1011     run proc-mark-db IN THIS-PROCEDURE NO-ERROR.
     1012     IF ERROR-STATUS:ERROR  THEN RETURN NO-APPLY.
     1013   END.
     1014   ON CHOOSE OF B-params IN FRAME Dialog-Frame
     1015   DO:
     1016     IF rs-mode <> 'save-disk-and-run':U
     1017     AND rs-mode <> 'save-db-and-run':U THEN DO:
     1018       RETURN NO-APPLY.
     1019     END.
     1020     run nws/sndfnwp.w (
     1021                     input parparentproc
     1022                    ,input 'ИЗМЕНЕНИЕ':U
     1023                    ,input "input"
     1024                    ,input 0
     1025                    ,input 0
     1026                    ,input 0
     1027                    ) NO-ERROR.
     1028     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1029   END.
     1030   ON VALUE-CHANGED OF Rs-mode IN FRAME Dialog-Frame
     1031   DO:
     1032   DEFINE VARIABLE v_manifest-file AS CHARACTER NO-UNDO.
     1033   DEFINE VARIABLE ll_commit AS logical NO-UNDO.
     1034   DEFINE VARIABLE old-rs-mode AS CHARACTER NO-UNDO.
     1035   DEFINE VARIABLE glog AS logical NO-UNDO.
     1036   DEFINE BUFFER buf_tt-ext-file FOR tt-ext-file.
     1037     ASSIGN
     1038     old-rs-mode = rs-mode
     1039     rs-mode
     1040     .
     1041     CASE rs-mode:
     1042       WHEN 'save-this-db':U THEN DO:
     1043         ASSIGN
     1044         f-path = '':U
     1045         rs-path-type = 0.
     1046         DISPLAY
     1047         rs-path-type
     1048         f-path
     1049         WITH FRAME Dialog-Frame.
     1050         DISABLE
     1051         rs-path-type
     1052         f-path
     1053         b-params
     1054         WITH FRAME Dialog-Frame.
     1055       END.
     1056       WHEN 'save-db':U THEN DO:
     1057         ASSIGN
     1058         f-path = '':U
     1059         rs-path-type = 0.
     1060         DISPLAY
     1061         rs-path-type
     1062         f-path
     1063         WITH FRAME Dialog-Frame.
     1064         DISABLE
     1065         rs-path-type
     1066         f-path
     1067         b-params
     1068         WITH FRAME Dialog-Frame.
     1069       END.
     1070       WHEN 'save-install':U THEN DO:
     1071         FIND FIRST buf_tt-ext-file NO-LOCK  no-error.
     1072         IF AVAILABLE buf_tt-ext-file THEN DO:
     1073            MESSAGE
     1074            "Уже есть выбранные файлы для пересылки" SKIP
     1075            "Невозможно переключиться в режим пересылки ПАКЕТА ОБНОВЛЕНИЙ"
     1076             VIEW-AS ALERT-BOX ERROR.
     1077             UNDO, RETURN NO-APPLY.
     1078         END.
     1079         ASSIGN
     1080         f-path = '':U
     1081         rs-path-type = 0.
     1082         DISPLAY
     1083         rs-path-type
     1084         f-path
     1085         WITH FRAME Dialog-Frame.
     1086         DISABLE
     1087         rs-path-type
     1088         f-path
     1089         b-params
     1090         WITH FRAME Dialog-Frame.
     1091         SYSTEM-DIALOG GET-FILE v_manifest-file
     1092         TITLE "Выберите файл манифеста данного пакета обновлений"
     1093         FILTERS
     1094           " Файлы манифеста пакета обновлений (*.mf) " "*.mf"
     1095         INITIAL-FILTER 1
     1096         DEFAULT-EXTENSION ".mf"
     1097         USE-FILENAME
     1098         MUST-EXIST
     1099         UPDATE ll_commit
     1100         .
     1101         IF ll_commit <> YES THEN do:
     1102            RETURN NO-APPLY.
     1103         end.
     1104         run nws/sndpckp.p ( INPUT v_manifest-file) NO-ERROR.
     1105         IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1106         DISPLAY
     1107         entry(1, v_manifest-file, ".") @ f-path
     1108         with frame Dialog-Frame.
     1109         OPEN QUERY BR-files FOR EACH tt-ext-file NO-LOCK INDEXED-REPOSITION.
     1110       END.
     1111       WHEN 'save-disk':U THEN DO:
     1112         ENABLE
     1113         rs-path-type
     1114         f-path
     1115         WITH FRAME Dialog-Frame.
     1116         DISABLE
     1117         b-params
     1118         WITH FRAME Dialog-Frame.
     1119       END.
     1120       WHEN 'save-db-and-run':U THEN DO:
     1121         ASSIGN
     1122         f-path = '':U
     1123         rs-path-type = 0.
     1124         DISPLAY
     1125         rs-path-type
     1126         f-path
     1127         WITH FRAME Dialog-Frame.
     1128         DISABLE
     1129         rs-path-type
     1130         f-path
     1131         WITH FRAME Dialog-Frame.
     1132         ENABLE
     1133         b-params
     1134         WITH FRAME Dialog-Frame.
     1135       END.
     1136       WHEN 'save-disk-and-run':U THEN DO:
     1137         ENABLE
     1138         rs-path-type
     1139         f-path
     1140         b-params
     1141         WITH FRAME Dialog-Frame.
     1142       END.
     1143     END CASE.
     1144   END.
     1145   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1146   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1147   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1148   on help of frame Dialog-Frame
     1149   do:
     1150     run gbl/app_help.p
     1151       (input this-procedure :file-name
     1152       ,input ''
     1153       ,input ?
     1154       ) no-error.
     1155     if error-status :error then do:
     1156       message
     1157         "Ошибка при вызове помощи"
     1158         error-status :get-message(1)
     1159         view-as alert-box .
     1160     end.
     1161   end.
     1162   run minbtn-set in this-procedure .
     1163   on choose of b-help in frame Dialog-Frame
     1164   do:
     1165     apply "help":u to frame Dialog-Frame .
     1166   end.
     1167   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1168   procedure minbtn-set :
     1169       do
     1170           on error undo, return error return-value
     1171           :
     1172           define variable ii              as integer       no-undo .
     1173           define variable fh              as widget-handle no-undo .
     1174           define variable hh              as widget-handle no-undo .
     1175           define variable v-h             as handle        extent 4 no-undo .
     1176           define variable v-name-button   as character     no-undo .
     1177           define variable v-help-old-x    as decimal       no-undo .
     1178           define variable v-help-old-y    as decimal       no-undo .
     1179           define variable v-help-old-size as decimal       no-undo .
     1180           define variable v-frame-width   as decimal       no-undo .
     1181           define variable jj              as integer       no-undo .
     1182           do
     1183               on error undo, return error
     1184               :
     1185               assign
     1186                   v-frame-width = frame Dialog-Frame:width - 0.3
     1187                   fh            = frame Dialog-Frame:first-child
     1188                   hh            = fh:first-child
     1189                   ii            = 1
     1190                   .
     1191               do while valid-handle(hh):
     1192                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1193                   do:
     1194                       case lc(hh:name) :
     1195                           when "b-help" then
     1196                               do:
     1197                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1198                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1199                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1200                                   hh:TOOLTIP = "Помощь" .
     1201                                   v-help-old-x = hh:column .
     1202                                   v-help-old-y = hh:row    .
     1203                                   v-help-old-size = hh:width .
     1204                                   hh:width-chars = 2.5 .
     1205                               end.
     1206                           when "b-print" then
     1207                               do:
     1208                                   hh:load-image("cmp/b-print.bmp":u) .
     1209                                   hh:TOOLTIP = "Печать" .
     1210                                   v-h[ii] = hh:handle .
     1211                                   ii = ii + 1 .
     1212                                   hh:width-chars = 3 .
     1213                               end.
     1214                           when "b-history" or
     1215                           when "b-hist" then
     1216                               do:
     1217                                   hh:load-image("cmp/b-hist.bmp":u) .
     1218                                   hh:TOOLTIP = "История" .
     1219                                   v-h[ii] = hh:handle .
     1220                                   ii = ii + 1 .
     1221                                   hh:width-chars = 3 .
     1222                               end.
     1223                           when "b-sch" then
     1224                               do:
     1225                                   hh:load-image("cmp/b-sch.bmp":u) .
     1226                                   hh:TOOLTIP = "Установка Фильтра" .
     1227                                   v-h[ii] = hh:handle .
     1228                                   ii = ii + 1 .
     1229                                   hh:width-chars = 3 .
     1230                               end.
     1231                           when "b-hist-user" then
     1232                               do:
     1233                                   hh:load-image("cmp/b-hist.bmp":u) .
     1234                                   hh:TOOLTIP = "История пользователя" .
     1235                                   ii = ii + 1 .
     1236                               end.
     1237                       end case.
     1238                   end.
     1239                   hh = hh:next-sibling.
     1240               end.
     1241               b-help:column = v-frame-width - b-help:width-chars.
     1242               jj = 0.
     1243               repeat ii = 4 to 1 by -1 :
     1244                   if valid-handle (v-h[ii] ) then
     1245                   do:
     1246                       jj  = jj + 1 .
     1247                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1248                       v-h[ii]:row    = v-help-old-y .
     1249                   end.
     1250               end.
     1251           end.
     1252       end.
     1253   end procedure.
     1254   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1255   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1256   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1257   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1258   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1259   define variable v-diasize-current-frame-height as decimal   no-undo .
     1260   define variable v-diasize-change-size          as logical   no-undo .
     1261   define variable v-diasize-resize-button        as handle    no-undo .
     1262   define variable v-diasize-wndmax               as logical   no-undo .
     1263   define variable v-diasize-wndstore             as logical   no-undo .
     1264   define variable v-diasize-proc-name            as character no-undo .
     1265   define variable v-diasize-browse-handle        as handle    no-undo .
     1266   define variable v-diasize-browse-number        as integer   no-undo .
     1267   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1268   define temp-table temp-diasize-handle no-undo
     1269     field handle-value  as handle
     1270     field save-position as decimal
     1271     index xpk is primary unique handle-value
     1272     .
     1273   define temp-table temp-browse-handle no-undo
     1274     field browse-type   as character
     1275     field browse-number as integer
     1276     field browse-handle as handle
     1277     field original-size as decimal
     1278     index xpk is primary unique browse-type browse-number
     1279     index xie browse-type browse-handle
     1280   .
     1281   procedure diasize_change-height :
     1282     define input  parameter p-change-value  as decimal   no-undo .
     1283     define input  parameter p-move-resize   as logical   no-undo .
     1284     define variable v-field-group-handle    as handle    no-undo .
     1285     define variable v-object-handle         as handle    no-undo .
     1286     define variable v-frame-height          as decimal   no-undo .
     1287     define variable v-frame-virtual-height  as decimal   no-undo .
     1288     define variable v-browse-height         as decimal   no-undo .
     1289     define variable v-window-height         as decimal   no-undo .
     1290     define variable v-window-virtual-height as decimal   no-undo .
     1291     define variable v-change-sign           as integer   no-undo .
     1292     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1293     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1294     if p-change-value > 0
     1295     then do:
     1296       if frame Dialog-Frame :height + p-change-value
     1297           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1298       then do:
     1299         assign
     1300           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1301                           - (frame Dialog-Frame :height-chars)
     1302         .
     1303         if p-change-value <= 0
     1304         then do:
     1305           run diasize_position-resize-button in this-procedure .
     1306           return .
     1307         end.
     1308       end.
     1309     end.
     1310     if p-change-value < 0
     1311     then do:
     1312       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1313       then do:
     1314         assign
     1315           p-change-value = v-diasize-orig-frame-height
     1316                          - (frame Dialog-Frame :height-chars)
     1317         .
     1318         if p-change-value >= 0
     1319         then do:
     1320           run diasize_position-resize-button in this-procedure .
     1321           return .
     1322         end.
     1323       end.
     1324     end.
     1325     if p-change-value >= 0
     1326     then do:
     1327       assign
     1328         v-change-sign = 1
     1329       .
     1330     end.
     1331     else do:
     1332       assign
     1333         v-change-sign = -1
     1334       .
     1335     end.
     1336     assign
     1337       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1338     .
     1339     if p-change-value = 0
     1340     then do:
     1341       run diasize_position-resize-button in this-procedure .
     1342       return .
     1343     end.
     1344     move_block:
     1345     do
     1346     on error undo move_block, retry move_block
     1347     :
     1348       if retry
     1349       then do:
     1350         do
     1351         on error undo move_block, leave move_block
     1352         :
     1353           if p-change-value > 0
     1354           then do:
     1355             for each buf_temp-diasize-handle
     1356             on error undo, next
     1357             :
     1358               assign
     1359                 v-object-handle = buf_temp-diasize-handle.handle-value
     1360               .
     1361               if v-object-handle <> v-diasize-resize-button
     1362               then do:
     1363                 assign
     1364                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1365                 .
     1366               end.
     1367             end.
     1368             assign
     1369               v-diasize-browse-handle :height = v-browse-height
     1370             .
     1371             for each buf_temp-browse-handle
     1372               where buf_temp-browse-handle.browse-type = 'height':u
     1373             on error undo, next
     1374             :
     1375               assign
     1376                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1377               .
     1378             end.
     1379             assign
     1380               frame Dialog-Frame :height = v-frame-height
     1381             .
     1382             if frame Dialog-Frame :scrollable = true
     1383             then do:
     1384               assign
     1385                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1386               .
     1387             end.
     1388             run diasize_position-resize-button in this-procedure .
     1389           end.
     1390           else do:
     1391             if frame Dialog-Frame :scrollable = true
     1392             then do:
     1393               assign
     1394                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1395               .
     1396             end.
     1397             assign
     1398               frame Dialog-Frame :height = v-frame-height
     1399             .
     1400             assign
     1401               v-diasize-browse-handle :height = v-browse-height
     1402             .
     1403             for each buf_temp-browse-handle
     1404               where buf_temp-browse-handle.browse-type = 'height':u
     1405             on error undo, next
     1406             :
     1407               assign
     1408                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1409               .
     1410             end.
     1411             for each buf_temp-diasize-handle
     1412             on error undo, next
     1413             :
     1414               assign
     1415                 v-object-handle = buf_temp-diasize-handle.handle-value
     1416               .
     1417               if v-object-handle <> v-diasize-resize-button
     1418               then do:
     1419                 assign
     1420                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1421                 .
     1422               end.
     1423             end.
     1424             run diasize_position-resize-button in this-procedure .
     1425           end.
     1426           assign
     1427             v-diasize-change-size = false
     1428           .
     1429           leave move_block .
     1430         end.
     1431       end.
     1432       assign
     1433         v-diasize-need-full-display = true
     1434       .
     1435       if v-diasize-change-size = false
     1436       then do:
     1437         assign
     1438           v-diasize-change-size = true
     1439         .
     1440       end.
     1441       else do:
     1442         return .
     1443       end.
     1444       assign
     1445         v-frame-height = frame Dialog-Frame :height
     1446         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1447         v-browse-height = v-diasize-browse-handle :height
     1448       .
     1449       for each buf_temp-browse-handle
     1450         where buf_temp-browse-handle.browse-type = 'height':u
     1451       :
     1452         assign
     1453           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1454         .
     1455       end.
     1456       for each buf_temp-diasize-handle
     1457       :
     1458         delete buf_temp-diasize-handle .
     1459       end.
     1460       assign
     1461         v-field-group-handle = frame Dialog-Frame :first-child
     1462       .
     1463       do while valid-handle(v-field-group-handle)
     1464       :
     1465         assign
     1466           v-object-handle = v-field-group-handle :first-child
     1467         .
     1468         do while valid-handle(v-object-handle)
     1469         :
     1470           if  v-object-handle <> v-diasize-browse-handle :handle
     1471           and can-query(v-object-handle, "row")
     1472           and can-query(v-object-handle, "height")
     1473           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1474           then do:
     1475             find first buf_temp-browse-handle
     1476               where buf_temp-browse-handle.browse-type   = 'height':u
     1477                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1478               no-error .
     1479             if available buf_temp-browse-handle
     1480             then do:
     1481             end.
     1482             else do:
     1483               create buf_temp-diasize-handle .
     1484               assign
     1485                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1486                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1487               .
     1488             end.
     1489           end.
     1490           assign
     1491             v-object-handle = v-object-handle :next-sibling
     1492           .
     1493         end.
     1494         assign
     1495           v-field-group-handle = v-field-group-handle :next-sibling
     1496         .
     1497       end.
     1498       do with frame Dialog-Frame
     1499       :
     1500         hide v-diasize-resize-button .
     1501         assign
     1502           v-diasize-resize-button :row    = 1
     1503           v-diasize-resize-button :column = 1
     1504         .
     1505       end.
     1506       if p-change-value > 0
     1507       then do:
     1508         if frame Dialog-Frame :scrollable = true
     1509         then do:
     1510           assign
     1511             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1512             no-error .
     1513           if error-status :error
     1514           or error-status :get-message(1) <> ""
     1515           then do:
     1516             undo move_block, retry move_block .
     1517           end.
     1518         end.
     1519         assign
     1520           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1521           no-error .
     1522         if error-status :error
     1523         or error-status :get-message(1) <> ""
     1524         then do:
     1525           undo move_block, retry move_block .
     1526         end.
     1527         assign
     1528           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1529           no-error .
     1530         if error-status :error
     1531         or error-status :get-message(1) <> ""
     1532         then do:
     1533           undo move_block, retry move_block .
     1534         end.
     1535         for each buf_temp-browse-handle
     1536           where buf_temp-browse-handle.browse-type = 'height':u
     1537         on error undo move_block, retry move_block
     1538         :
     1539           assign
     1540             buf_temp-browse-handle.browse-handle :height
     1541               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1542             no-error .
     1543           if error-status :error
     1544           or error-status :get-message(1) <> ""
     1545           then do:
     1546             undo move_block, retry move_block .
     1547           end.
     1548         end.
     1549         for each buf_temp-diasize-handle
     1550         on error undo move_block, retry move_block
     1551         :
     1552           assign
     1553             v-object-handle = buf_temp-diasize-handle.handle-value
     1554           .
     1555           if v-object-handle <> v-diasize-resize-button
     1556           then do:
     1557             assign
     1558               v-object-handle :row = v-object-handle :row + p-change-value
     1559               no-error .
     1560             if error-status :error
     1561             or error-status :get-message(1) <> ""
     1562             then do:
     1563               undo move_block, retry move_block .
     1564             end.
     1565           end.
     1566         end.
     1567       end.
     1568       else do:
     1569         for each buf_temp-diasize-handle
     1570         on error undo move_block, retry move_block
     1571         :
     1572           assign
     1573             v-object-handle = buf_temp-diasize-handle.handle-value
     1574           .
     1575           if v-object-handle <> v-diasize-resize-button
     1576           then do:
     1577             assign
     1578               v-object-handle :row = v-object-handle :row + p-change-value
     1579               no-error .
     1580             if error-status :error
     1581             or error-status :get-message(1) <> ""
     1582             then do:
     1583               undo move_block, retry move_block .
     1584             end.
     1585           end.
     1586         end.
     1587         assign
     1588           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1589           no-error .
     1590         if error-status :error
     1591         or error-status :get-message(1) <> ""
     1592         then do:
     1593           undo move_block, retry move_block .
     1594         end.
     1595         for each buf_temp-browse-handle
     1596           where buf_temp-browse-handle.browse-type = 'height':u
     1597         on error undo move_block, retry move_block
     1598         :
     1599           assign
     1600             buf_temp-browse-handle.browse-handle :height
     1601               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1602             no-error .
     1603           if error-status :error
     1604           or error-status :get-message(1) <> ""
     1605           then do:
     1606             undo move_block, retry move_block .
     1607           end.
     1608         end.
     1609         assign
     1610           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1611           no-error .
     1612         if error-status :error
     1613         or error-status :get-message(1) <> ""
     1614         then do:
     1615           undo move_block, retry move_block .
     1616         end.
     1617         if frame Dialog-Frame :scrollable = true
     1618         then do:
     1619           assign
     1620             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1621             no-error .
     1622           if error-status :error
     1623           or error-status :get-message(1) <> ""
     1624           then do:
     1625             undo move_block, retry move_block .
     1626           end.
     1627         end.
     1628       end.
     1629       if p-move-resize = true
     1630       then do:
     1631         run diasize_position-resize-button in this-procedure .
     1632       end.
     1633       if v-diasize-wndstore = true
     1634       then do:
     1635         if connected("ub") = true
     1636         then do:
     1637           define variable v-cntxt-db-num        as integer   no-undo .
     1638           define variable v-cntxt-userid        as character no-undo .
     1639           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1640                                             , OUTPUT v-cntxt-userid
     1641                                             ) .
     1642           run gbl/wndsizew.p
     1643             (input  v-cntxt-db-num
     1644             ,input  v-cntxt-userid
     1645             ,input  v-diasize-proc-name
     1646             ,input  'height':u
     1647             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1648             ) .
     1649         end.
     1650       end.
     1651     end.
     1652     assign
     1653       v-diasize-change-size = false
     1654     .
     1655   end procedure.
     1656   procedure diasize_set-height :
     1657     define input  parameter p-new-height  as decimal   no-undo .
     1658     define input  parameter p-move-resize as logical   no-undo .
     1659     do
     1660     on error undo, return error return-value
     1661     :
     1662       run diasize_change-height in this-procedure
     1663         (input  (p-new-height - frame Dialog-Frame :height)
     1664         ,input  p-move-resize
     1665         ) .
     1666     end.
     1667   end procedure.
     1668   procedure diasize_change-width :
     1669     define input  parameter p-change-value as decimal   no-undo .
     1670     define input  parameter p-move-resize  as logical   no-undo .
     1671     define variable v-field-group-handle   as handle    no-undo .
     1672     define variable v-object-handle        as handle    no-undo .
     1673     define variable v-frame-width          as decimal   no-undo .
     1674     define variable v-frame-virtual-width  as decimal   no-undo .
     1675     define variable v-browse-width         as decimal   no-undo .
     1676     define variable v-window-width         as decimal   no-undo .
     1677     define variable v-window-virtual-width as decimal   no-undo .
     1678     define variable v-change-sign          as integer   no-undo .
     1679     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1680     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1681     if p-change-value > 0
     1682     then do:
     1683       if frame Dialog-Frame :width + p-change-value >
     1684           session :width-chars
     1685       then do:
     1686         assign
     1687           p-change-value = session :width-chars - frame Dialog-Frame :width
     1688         .
     1689         if p-change-value <= 0
     1690         then do:
     1691           run diasize_position-resize-button in this-procedure .
     1692           return .
     1693         end.
     1694       end.
     1695     end.
     1696     if p-change-value < 0
     1697     then do:
     1698       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1699       then do:
     1700         assign
     1701           p-change-value = v-diasize-orig-frame-width
     1702                          - frame Dialog-Frame :width
     1703         .
     1704         if p-change-value >= 0
     1705         then do:
     1706           run diasize_position-resize-button in this-procedure .
     1707           return .
     1708         end.
     1709       end.
     1710     end.
     1711     if p-change-value >= 0
     1712     then do:
     1713       assign
     1714         v-change-sign = 1
     1715       .
     1716     end.
     1717     else do:
     1718       assign
     1719         v-change-sign = -1
     1720       .
     1721     end.
     1722     assign
     1723       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1724     .
     1725     if p-change-value = 0
     1726     then do:
     1727       run diasize_position-resize-button in this-procedure .
     1728       return .
     1729     end.
     1730     move_block:
     1731     do
     1732     on error undo move_block, leave move_block
     1733     :
     1734       if retry
     1735       then do:
     1736         do
     1737         on error undo move_block, leave move_block
     1738         :
     1739           if p-change-value > 0
     1740           then do:
     1741             for each buf_temp-diasize-handle
     1742             on error undo, next
     1743             :
     1744               assign
     1745                 v-object-handle = buf_temp-diasize-handle.handle-value
     1746               .
     1747               if v-object-handle <> v-diasize-resize-button
     1748               then do:
     1749                 assign
     1750                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1751                 .
     1752               end.
     1753             end.
     1754             assign
     1755               v-diasize-browse-handle :width = v-browse-width
     1756             .
     1757             for each buf_temp-browse-handle
     1758               where buf_temp-browse-handle.browse-type = 'width':u
     1759             on error undo, next
     1760             :
     1761               assign
     1762                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1763               .
     1764             end.
     1765             assign
     1766               frame Dialog-Frame :width = v-frame-width
     1767             .
     1768             if frame Dialog-Frame :scrollable = true
     1769             then do:
     1770               assign
     1771                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1772               .
     1773             end.
     1774             run diasize_position-resize-button in this-procedure .
     1775           end.
     1776           else do:
     1777             if frame Dialog-Frame :scrollable = true
     1778             then do:
     1779               assign
     1780                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1781               .
     1782             end.
     1783             assign
     1784               frame Dialog-Frame :width = v-frame-width
     1785             .
     1786             for each buf_temp-browse-handle
     1787               where buf_temp-browse-handle.browse-type = 'width':u
     1788             on error undo, next
     1789             :
     1790               assign
     1791                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1792               .
     1793             end.
     1794             assign
     1795               v-diasize-browse-handle :width = v-browse-width
     1796             .
     1797             for each buf_temp-diasize-handle
     1798             on error undo, next
     1799             :
     1800               assign
     1801                 v-object-handle = buf_temp-diasize-handle.handle-value
     1802               .
     1803               if v-object-handle <> v-diasize-resize-button
     1804               then do:
     1805                 assign
     1806                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1807                 .
     1808               end.
     1809             end.
     1810             run diasize_position-resize-button in this-procedure .
     1811           end.
     1812           assign
     1813             v-diasize-change-size = false
     1814           .
     1815           leave move_block .
     1816         end.
     1817       end.
     1818       assign
     1819         v-diasize-need-full-display = true
     1820       .
     1821       if v-diasize-change-size = false
     1822       then do:
     1823         assign
     1824           v-diasize-change-size = true
     1825         .
     1826       end.
     1827       else do:
     1828         return .
     1829       end.
     1830       assign
     1831         v-frame-width = frame Dialog-Frame :width
     1832         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1833         v-browse-width = v-diasize-browse-handle :width
     1834       .
     1835       for each buf_temp-browse-handle
     1836         where buf_temp-browse-handle.browse-type = 'width':u
     1837       :
     1838         assign
     1839           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1840         .
     1841       end.
     1842       for each buf_temp-diasize-handle
     1843       :
     1844         delete buf_temp-diasize-handle .
     1845       end.
     1846       assign
     1847         v-field-group-handle = frame Dialog-Frame :first-child
     1848       .
     1849       do while valid-handle(v-field-group-handle)
     1850       :
     1851         assign
     1852           v-object-handle = v-field-group-handle :first-child
     1853         .
     1854         do while valid-handle(v-object-handle)
     1855         :
     1856           if  v-object-handle <> v-diasize-browse-handle :handle
     1857           and v-object-handle <> v-diasize-resize-button
     1858           and can-query(v-object-handle, "row")
     1859           and can-query(v-object-handle, "height")
     1860           and ( v-object-handle :col + v-object-handle :width
     1861                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1862               )
     1863           then do:
     1864             find first buf_temp-browse-handle
     1865               where buf_temp-browse-handle.browse-type   = 'width':u
     1866                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1867               no-error .
     1868             if available buf_temp-browse-handle
     1869             then do:
     1870             end.
     1871             else do:
     1872               create buf_temp-diasize-handle .
     1873               assign
     1874                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1875                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1876               .
     1877             end.
     1878           end.
     1879           assign
     1880             v-object-handle = v-object-handle :next-sibling
     1881           .
     1882         end.
     1883         assign
     1884           v-field-group-handle = v-field-group-handle :next-sibling
     1885         .
     1886       end.
     1887       do with frame Dialog-Frame
     1888       :
     1889         hide v-diasize-resize-button .
     1890         v-diasize-resize-button :row = 1.
     1891         v-diasize-resize-button :column = 1.
     1892       end.
     1893       if p-change-value > 0
     1894       then do:
     1895         if frame Dialog-Frame :scrollable = true
     1896         then do:
     1897           assign
     1898             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1899             no-error .
     1900           if error-status :error
     1901           or error-status :get-message(1) <> ""
     1902           then do:
     1903             undo move_block, retry move_block.
     1904           end.
     1905         end.
     1906         assign
     1907           frame Dialog-Frame :width = v-frame-width + p-change-value
     1908           no-error .
     1909         if error-status :error
     1910         or error-status :get-message(1) <> ""
     1911         then do:
     1912           undo move_block, retry move_block.
     1913         end.
     1914         assign
     1915           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1916         no-error .
     1917         if error-status :error
     1918         or error-status :get-message(1) <> ""
     1919         then do:
     1920           undo move_block, retry move_block.
     1921         end.
     1922         for each buf_temp-browse-handle
     1923           where buf_temp-browse-handle.browse-type = 'width':u
     1924         on error undo move_block, retry move_block
     1925         :
     1926           assign
     1927             buf_temp-browse-handle.browse-handle :width
     1928               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1929             no-error .
     1930           if error-status :error
     1931           or error-status :get-message(1) <> ""
     1932           then do:
     1933             undo move_block, retry move_block .
     1934           end.
     1935         end.
     1936         for each buf_temp-diasize-handle
     1937         on error undo move_block, retry move_block
     1938         :
     1939           assign
     1940             v-object-handle = buf_temp-diasize-handle.handle-value
     1941           .
     1942           if v-object-handle <> v-diasize-resize-button
     1943           then do:
     1944             assign
     1945               v-object-handle :col = v-object-handle :col + p-change-value
     1946               no-error .
     1947             if error-status :error
     1948             or error-status :get-message(1) <> ""
     1949             then do:
     1950               undo move_block, retry move_block .
     1951             end.
     1952           end.
     1953         end.
     1954       end.
     1955       else do:
     1956         for each buf_temp-diasize-handle
     1957         on error undo move_block, retry move_block
     1958         :
     1959           assign
     1960             v-object-handle = buf_temp-diasize-handle.handle-value
     1961           .
     1962           if v-object-handle <> v-diasize-resize-button
     1963           then do:
     1964             assign
     1965               v-object-handle :col = v-object-handle :col + p-change-value
     1966               no-error .
     1967             if error-status :error
     1968             or error-status :get-message(1) <> ""
     1969             then do:
     1970               undo move_block, retry move_block .
     1971             end.
     1972           end.
     1973         end.
     1974         for each buf_temp-browse-handle
     1975           where buf_temp-browse-handle.browse-type = 'width':u
     1976         on error undo move_block, retry move_block
     1977         :
     1978           assign
     1979             buf_temp-browse-handle.browse-handle :width
     1980               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1981             no-error .
     1982           if error-status :error
     1983           or error-status :get-message(1) <> ""
     1984           then do:
     1985             undo move_block, retry move_block .
     1986           end.
     1987         end.
     1988         assign
     1989           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1990           no-error .
     1991         if error-status :error
     1992         or error-status :get-message(1) <> ""
     1993         then do:
     1994           undo move_block, retry move_block.
     1995         end.
     1996         assign
     1997           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1998         no-error .
     1999         if error-status :error
     2000         or error-status :get-message(1) <> ""
     2001         then do:
     2002           undo move_block, retry move_block.
     2003         end.
     2004         if frame Dialog-Frame :scrollable = true
     2005         then do:
     2006           assign
     2007             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2008           no-error .
     2009           if error-status :error
     2010           or error-status :get-message(1) <> ""
     2011           then do:
     2012             undo move_block, retry move_block.
     2013           end.
     2014         end.
     2015       end.
     2016       if p-move-resize
     2017       then do:
     2018         run diasize_position-resize-button in this-procedure .
     2019       end.
     2020       if v-diasize-wndstore = true
     2021       then do:
     2022         if connected("ub") = true
     2023         then do:
     2024           define variable v-cntxt-db-num        as integer   no-undo .
     2025           define variable v-cntxt-userid        as character no-undo .
     2026           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2027                                             , OUTPUT v-cntxt-userid
     2028                                             ) .
     2029           run gbl/wndsizew.p
     2030             (input  v-cntxt-db-num
     2031             ,input  v-cntxt-userid
     2032             ,input  v-diasize-proc-name
     2033             ,input  'width':u
     2034             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2035             ) .
     2036         end.
     2037       end.
     2038     end.
     2039     assign
     2040       v-diasize-change-size = false
     2041     .
     2042   end procedure.
     2043   procedure diasize_set-width :
     2044     define input  parameter p-new-width  as decimal   no-undo .
     2045     define input  parameter p-move-resize as logical   no-undo .
     2046     do
     2047     on error undo, return error return-value
     2048     :
     2049       run diasize_change-width in this-procedure
     2050         (input  (p-new-width - frame Dialog-Frame :width)
     2051         ,input  p-move-resize
     2052         ) .
     2053     end.
     2054   end procedure.
     2055   procedure diasize_position-resize-button :
     2056     do with frame Dialog-Frame
     2057     :
     2058       hide v-diasize-resize-button .
     2059       assign
     2060         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2061                     - 1
     2062                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2063         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2064                     - 1
     2065                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2066       .
     2067       view v-diasize-resize-button .
     2068     end.
     2069   end procedure.
     2070   on alt-right anywhere
     2071   do:
     2072     run diasize_change-width in this-procedure
     2073       (input 1
     2074       ,input true
     2075       ) .
     2076     return no-apply .
     2077   end.
     2078   on alt-left anywhere
     2079   do:
     2080     run diasize_change-width in this-procedure
     2081       (input -1
     2082       ,input true
     2083       ) .
     2084     return no-apply .
     2085   end.
     2086   on alt-down anywhere
     2087   do:
     2088     run diasize_change-height in this-procedure
     2089       (input 1
     2090       ,input true
     2091       ) .
     2092     return no-apply .
     2093   end.
     2094   on alt-up anywhere
     2095   do:
     2096     run diasize_change-height in this-procedure
     2097       (input -1
     2098       ,input true
     2099       ) .
     2100     return no-apply .
     2101   end.
     2102   on alt-enter of frame Dialog-Frame
     2103   do:
     2104     run diasize_maximize in this-procedure
     2105       (input  ?
     2106       ).
     2107     return no-apply .
     2108   end.
     2109   procedure diasize_end-move :
     2110     do
     2111     on error undo, return error return-value
     2112     :
     2113       define variable v-row-delta as decimal   no-undo .
     2114       define variable v-col-delta as decimal   no-undo .
     2115       define variable v-new-row as decimal   no-undo .
     2116       define variable v-new-col as decimal   no-undo .
     2117       assign
     2118         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2119         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2120       .
     2121       assign
     2122         v-row-delta = v-new-row - frame Dialog-Frame :height
     2123         v-col-delta = v-new-col - frame Dialog-Frame :width
     2124       .
     2125       run diasize_change-height in this-procedure
     2126         (input v-row-delta
     2127         ,input true
     2128         ) .
     2129       run diasize_change-width in this-procedure
     2130         (input v-col-delta
     2131         ,input true
     2132         ) .
     2133     end.
     2134   end procedure.
     2135   procedure diasize_maximize :
     2136     define input  parameter p-action as logical   no-undo .
     2137     do
     2138     on error undo, return error return-value
     2139     :
     2140       if p-action = ?
     2141       then do:
     2142         if v-diasize-need-maximize = true
     2143         then do:
     2144           assign
     2145             p-action = true
     2146           .
     2147         end.
     2148         else do:
     2149           assign
     2150             p-action = false
     2151           .
     2152         end.
     2153       end.
     2154       if p-action = true
     2155       then do:
     2156         run diasize_change-height in this-procedure
     2157           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2158               - frame Dialog-Frame :height-chars
     2159           ,input true
     2160           ) .
     2161         run diasize_change-width in this-procedure
     2162           (input session :width-chars
     2163               - frame Dialog-Frame :width-chars
     2164           ,input true
     2165           ) .
     2166         assign
     2167           v-diasize-need-maximize = false
     2168         .
     2169       end.
     2170       else do:
     2171         run diasize_change-width in this-procedure
     2172           (input v-diasize-orig-frame-width
     2173               - frame Dialog-Frame :width-chars
     2174           ,input true
     2175           ) .
     2176         run diasize_change-height in this-procedure
     2177           (input v-diasize-orig-frame-height
     2178               - frame Dialog-Frame :height-chars
     2179           ,input true
     2180           ) .
     2181         assign
     2182           v-diasize-need-maximize = true
     2183         .
     2184       end.
     2185     end.
     2186   end procedure.
     2187   procedure diasize_restore-orig-size :
     2188     do
     2189     on error undo, return error return-value
     2190     :
     2191       assign
     2192         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2193         v-diasize-current-frame-height = frame Dialog-Frame :height
     2194       .
     2195       run diasize_set-height in this-procedure
     2196         (input  v-diasize-orig-frame-height
     2197         ,input  true
     2198         ) .
     2199       run diasize_set-width in this-procedure
     2200         (input  v-diasize-orig-frame-width
     2201         ,input  true
     2202         ) .
     2203     end.
     2204   end procedure.
     2205   procedure diasize_restore-current-size :
     2206     do
     2207     on error undo, return error return-value
     2208     :
     2209       run diasize_set-height in this-procedure
     2210         (input  v-diasize-current-frame-height
     2211         ,input  true
     2212         ) .
     2213       run diasize_set-width in this-procedure
     2214         (input  v-diasize-current-frame-width
     2215         ,input  true
     2216         ) .
     2217     end.
     2218   end procedure.
     2219   procedure diasize_set-browse-handle :
     2220     define input  parameter p-browse-handle as handle   no-undo .
     2221     define buffer buf_temp-browse-handle for temp-browse-handle .
     2222     do
     2223     on error undo, return error return-value
     2224     :
     2225       assign
     2226         v-diasize-browse-handle = p-browse-handle
     2227       .
     2228       for each buf_temp-browse-handle
     2229       on error undo, return error return-value
     2230       :
     2231         delete buf_temp-browse-handle .
     2232       end.
     2233     end.
     2234   end procedure.
     2235   procedure diasize_add_browse :
     2236     define input  parameter p-browse-type   as character no-undo .
     2237     define input  parameter p-browse-handle as handle    no-undo .
     2238     define buffer buf_temp-browse-handle for temp-browse-handle .
     2239     do
     2240     on error undo, return error return-value
     2241     :
     2242       assign
     2243         v-diasize-browse-number = v-diasize-browse-number + 1
     2244       .
     2245       create buf_temp-browse-handle .
     2246       assign
     2247         buf_temp-browse-handle.browse-type   = p-browse-type
     2248         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2249         buf_temp-browse-handle.browse-handle = p-browse-handle
     2250       .
     2251     end.
     2252   end procedure.
     2253   procedure diasize_init :
     2254     define variable v-default-value    as logical   no-undo .
     2255     define variable v-restore-saved    as logical   no-undo .
     2256     define variable v-resize-value-str as character no-undo .
     2257     do
     2258     on error undo, return error return-value
     2259     :
     2260       do with frame Dialog-Frame
     2261       :
     2262         assign
     2263           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2264           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2265           v-diasize-browse-handle     = browse BR-db :handle
     2266         .
     2267         create button v-diasize-resize-button
     2268         assign
     2269           parent        = frame Dialog-Frame :first-child
     2270           label         = "s"
     2271           height-pixels = 16
     2272           width-pixels  = 16
     2273           visible       = true
     2274           sensitive     = true
     2275           movable       = true
     2276           triggers:
     2277             on end-move persistent run diasize_end-move in this-procedure .
     2278           end triggers.
     2279         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2280         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2281         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2282         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2283         assign
     2284           v-diasize-wndmax = false
     2285         .
     2286         if connected("ub") = true
     2287         then do:
     2288           define variable v-cntxt-db-num        as integer   no-undo .
     2289           define variable v-cntxt-userid        as character no-undo .
     2290           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2291                                             , OUTPUT v-cntxt-userid
     2292                                             ) .
     2293           run gbl/wndpar_r.p
     2294             (input  v-cntxt-db-num
     2295             ,input  v-cntxt-userid
     2296             ,input  'wndmax':U
     2297             ,output v-diasize-wndmax
     2298             ,output v-default-value
     2299             ) .
     2300         end.
     2301         assign
     2302           v-diasize-wndstore = false
     2303         .
     2304         if connected("ub") = true
     2305         then do:
     2306           run gbl/wndpar_r.p
     2307             (input  v-cntxt-db-num
     2308             ,input  v-cntxt-userid
     2309             ,input  'wndstore':U
     2310             ,output v-diasize-wndstore
     2311             ,output v-default-value
     2312             ) .
     2313         end.
     2314         assign
     2315           v-diasize-proc-name = entry(1, program-name(2), '.')
     2316         .
     2317         if v-diasize-wndstore = true
     2318         then do:
     2319           assign
     2320             v-restore-saved = false
     2321           .
     2322           if connected("ub") = true
     2323           then do:
     2324             run gbl/wndsizer.p
     2325               (input  v-cntxt-db-num
     2326               ,input  v-cntxt-userid
     2327               ,input  v-diasize-proc-name
     2328               ,input  'height':u
     2329               ,output v-resize-value-str
     2330               ) .
     2331             if v-resize-value-str <> '':U
     2332             then do:
     2333               run diasize_change-height in this-procedure
     2334                 (input  integer(v-resize-value-str)
     2335                 ,input  true
     2336                 ) .
     2337               assign
     2338                 v-restore-saved = true
     2339               .
     2340             end.
     2341           end.
     2342           if connected("ub") = true
     2343           then do:
     2344             run gbl/wndsizer.p
     2345               (input  v-cntxt-db-num
     2346               ,input  v-cntxt-userid
     2347               ,input  v-diasize-proc-name
     2348               ,input  'width':u
     2349               ,output v-resize-value-str
     2350               ) .
     2351             if v-resize-value-str <> '':U
     2352             then do:
     2353               run diasize_change-width in this-procedure
     2354                 (input  integer(v-resize-value-str)
     2355                 ,input  true
     2356                 ) .
     2357               assign
     2358                 v-restore-saved = true
     2359               .
     2360             end.
     2361           end.
     2362           if v-restore-saved <> true
     2363           then do:
     2364             if v-diasize-wndmax = true
     2365             then do:
     2366               run diasize_maximize in this-procedure
     2367                 (input  true
     2368                 ) .
     2369             end.
     2370           end.
     2371         end.
     2372         else do:
     2373           if v-diasize-wndmax = true
     2374           then do:
     2375             run diasize_maximize in this-procedure
     2376               (input  true
     2377               ) .
     2378           end.
     2379         end.
     2380       end.
     2381     end.
     2382   end procedure.
     2383   procedure diasize_need-full-display :
     2384     define output parameter p-need-full-display as logical   no-undo .
     2385     do
     2386     on error undo, return error return-value
     2387     :
     2388       assign
     2389         p-need-full-display = v-diasize-need-full-display
     2390       .
     2391       assign
     2392         v-diasize-need-full-display = false
     2393       .
     2394     end.
     2395   end procedure.
     2396   procedure get-context :
     2397      define output parameter p-db-num as integer          no-undo.
     2398      define output parameter p-user-id as character        no-undo.
     2399      define variable v-login               as character    no-undo.
     2400      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2401      define buffer buf_user-login  for ub.user-login .
     2402      do
     2403      on error undo, return error
     2404      :
     2405            FIND FIRST buf_sys-ctrl no-lock.
     2406            ASSIGN
     2407               v-login = USERID("ub")
     2408               p-db-num = buf_sys-ctrl.db-num
     2409            .
     2410            FIND FIRST buf_user-login
     2411                 WHERE buf_user-login.db-num = p-db-num
     2412                   AND buf_user-login.user-login = v-login
     2413                 no-lock
     2414                 no-error
     2415                 .
     2416            IF AVAILABLE buf_user-login
     2417            THEN DO:
     2418               assign
     2419                  p-user-id = buf_user-login.user-id
     2420               .
     2421            END.
     2422      end.
     2423   end procedure.
     2424       run diasize_init in this-procedure .
     2425   MAIN-BLOCK:
     2426   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2427      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2428   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2429     run mainmenu_getcntxt in parparentproc
     2430       (output v-cntxt-db-num
     2431       ,output v-cntxt-userid
     2432       ,output v-cntxt-level
     2433       ,output v-cntxt-host-code-obj
     2434       ,output v-cntxt-obj-type
     2435       ,output v-cntxt-obj-code
     2436       ,output v-cntxt-db-num-obj
     2437       ,output v-cntxt-is-admin
     2438       ) .
     2439     RUN Myenable IN THIS-PROCEDURE.
     2440     WAIT-FOR GO OF FRAME Dialog-Frame.
     2441   END.
     2442   run disable_UI.
     2443   PROCEDURE confirm-password :
     2444   DEFINE INPUT PARAMETER p-file-name AS CHARACTER NO-UNDO.
     2445   DEFINE INPUT PARAMETER p-today AS date NO-UNDO.
     2446   DEFINE OUTPUT PARAMETER p-ok AS LOGICAL no-undo.
     2447   DEFINE VARIABLE v-psw-buf AS CHARACTER NO-UNDO.
     2448   DEFINE VARIABLE v-need-password AS CHARACTER NO-UNDO.
     2449   DEFINE VARIABLE v-need-password-int AS INTEGER NO-UNDO.
     2450   DEFINE VARIABLE v-ii AS INTEGER NO-UNDO.
     2451   p-ok = YES.
     2452   END PROCEDURE.
     2453   PROCEDURE disable_UI :
     2454     HIDE FRAME Dialog-Frame.
     2455   END PROCEDURE.
     2456   PROCEDURE enable_UI :
     2457     DISPLAY Rs-mode rs-path-type f-path
     2458         WITH FRAME Dialog-Frame.
     2459     ENABLE B-exit b-quit B-Help b-mark B-all-select B-all-deselect BR-db Rs-mode
     2460            rs-path-type f-path b-add b-del B-params BR-files
     2461         WITH FRAME Dialog-Frame.
     2462     VIEW FRAME Dialog-Frame.
     2463     IF p-db-num = ? THEN DO:   IF v-cntxt-db-num = 0 THEN DO:      OPEN QUERY BR-db FOR EACH X_db NO-LOCK WHERE X_db.db-num > 0,                  EACH tt-db OF X_db OUTER-JOIN NO-LOCK .   END.   ELSE DO:     OPEN QUERY BR-db FOR EACH X_db NO-LOCK WHERE X_db.db-num = 0,                  EACH tt-db OF X_db OUTER-JOIN NO-LOCK .    END. END. ELSE DO:     IF v-cntxt-db-num = 0 THEN DO:        OPEN QUERY BR-db FOR EACH X_db NO-LOCK WHERE X_db.db-num = p-db-num,                    EACH tt-db OF X_db OUTER-JOIN NO-LOCK .     END. END.    OPEN QUERY BR-files FOR EACH tt-ext-file NO-LOCK INDEXED-REPOSITION.
     2464   END PROCEDURE.
     2465   PROCEDURE MyEnable :
     2466   assign
     2467   rs-mode:radio-buttons in frame Dialog-Frame =
     2468   "Сохранить в текущей БД" + chr(44) + 'save-this-db':U + chr(44) +
     2469   "Выложить на диск другой БД" + chr(44) + 'save-disk':U + chr(44) +
     2470   "Сохранить в другой БД" + chr(44) + 'save-db':U  + chr(44) +
     2471   "Пакет обновления" + chr(44) + 'save-install':U + chr(44) +
     2472   "Выложить на диск другой БД и запустить" + chr(44) + 'save-disk-and-run':U + chr(44) +
     2473   "Сохранить в другой БД и запустить" + chr(44) + 'save-db-and-run':U.
     2474   IF p-mode <> "":U THEN DO:
     2475     assign
     2476     rs-mode = p-mode.
     2477     .
     2478   END.
     2479   DISPLAY
     2480   Rs-mode
     2481   rs-path-type
     2482   f-path
     2483   WITH FRAME Dialog-Frame.
     2484   ENABLE
     2485   B-exit
     2486   b-quit
     2487   B-Help
     2488   b-mark
     2489   B-all-select WHEN p-db-num = ?
     2490   B-all-deselect WHEN p-db-num = ?
     2491   BR-db
     2492   Rs-mode WHEN (p-mode = "":U)
     2493   rs-path-type
     2494   f-path
     2495   b-add
     2496   b-del
     2497   BR-files
     2498   WITH FRAME Dialog-Frame.
     2499   VIEW FRAME Dialog-Frame.
     2500   if p-mode = 'save-install':U
     2501   or p-mode = 'save-this-db':U
     2502   then do:
     2503     rs-mode:disable(radio-label('save-db':U, RS-mode:RADIO-BUTTONS IN FRAME Dialog-Frame)) IN FRAME Dialog-Frame.
     2504     rs-mode:disable(radio-label('save-disk':U, RS-mode:RADIO-BUTTONS IN FRAME Dialog-Frame)) IN FRAME Dialog-Frame.
     2505     rs-mode:disable(radio-label('save-disk-and-run':U, RS-mode:RADIO-BUTTONS IN FRAME Dialog-Frame)) IN FRAME Dialog-Frame.
     2506     rs-mode:disable(radio-label('save-disk-and-run':U, RS-mode:RADIO-BUTTONS IN FRAME Dialog-Frame)) IN FRAME Dialog-Frame.
     2507     if p-mode = 'save-install':U then
     2508     rs-mode:disable(radio-label('save-this-db':U, RS-mode:RADIO-BUTTONS IN FRAME Dialog-Frame)) IN FRAME Dialog-Frame.
     2509     if p-mode = 'save-this-db':U then
     2510     rs-mode:disable(radio-label('save-install':U, RS-mode:RADIO-BUTTONS IN FRAME Dialog-Frame)) IN FRAME Dialog-Frame.
     2511   end.
     2512   else do:
     2513      rs-mode:disable(radio-label('save-install':U, RS-mode:RADIO-BUTTONS IN FRAME Dialog-Frame)) IN FRAME Dialog-Frame.
     2514      rs-mode:disable(radio-label('save-this-db':U, RS-mode:RADIO-BUTTONS IN FRAME Dialog-Frame)) IN FRAME Dialog-Frame.
     2515   end.
     2516   APPLY "value-changed" TO rs-mode IN FRAME Dialog-Frame.
     2517   IF p-db-num = ? THEN DO:   IF v-cntxt-db-num = 0 THEN DO:      OPEN QUERY BR-db FOR EACH X_db NO-LOCK WHERE X_db.db-num > 0,                  EACH tt-db OF X_db OUTER-JOIN NO-LOCK .   END.   ELSE DO:     OPEN QUERY BR-db FOR EACH X_db NO-LOCK WHERE X_db.db-num = 0,                  EACH tt-db OF X_db OUTER-JOIN NO-LOCK .    END. END. ELSE DO:     IF v-cntxt-db-num = 0 THEN DO:        OPEN QUERY BR-db FOR EACH X_db NO-LOCK WHERE X_db.db-num = p-db-num,                    EACH tt-db OF X_db OUTER-JOIN NO-LOCK .     END. END.    OPEN QUERY BR-files FOR EACH tt-ext-file NO-LOCK INDEXED-REPOSITION.
     2518   END PROCEDURE.
     2519   PROCEDURE proc-add-file :
     2520   define variable v_os-file   AS CHAR NO-UNDO INIT "".
     2521   define variable ll_commit AS LOG    NO-UNDO INIT NO.
     2522   define variable v-full-path        as character no-undo .
     2523   define variable v-path             as character no-undo .
     2524   define variable v-file-name        as character no-undo .
     2525   define variable v-file-name-no-ext as character no-undo .
     2526   define variable v-file-name-ext    as character no-undo .
     2527   DEFINE VARIABLE v-md5-signature AS CHARACTER NO-undo.
     2528   DEFINE VARIABLE ii AS INTEGER NO-UNDO.
     2529   DEFINE VARIABLE v-today as date no-undo .
     2530   DEFINE VARIABLE v-time as integer no-undo .
     2531   DEFINE BUFFER buf_tt-ext-file FOR tt-ext-file.
     2532   run gbl/dm-file.p ( INPUT (" Файлы Progress (*.i, *.r, *.p, *.w, *.d) " + "|" + "*.i;*.r;*.p;*.w;*.d"
     2533                   + "|" + " Текстовые файлы (*.txt) " + "|" + "*.txt"
     2534                   + "|" + " Все файлы (*.*) "  + "|" +  "*.*")
     2535                   ,INPUT "."
     2536                   ,INPUT "Выберите один или несколько файлов"
     2537                   ,input frame Dialog-Frame:hwnd
     2538                   ,OUTPUT v_os-file
     2539                   ,OUTPUT ll_commit
     2540                               ).
     2541   IF ll_commit <> YES THEN do:
     2542      RETURN error.
     2543   end.
     2544   _ii:
     2545   DO ii = 1 TO NUM-ENTRIES (v_os-file, "|"):
     2546       run gbl/filename.p (
     2547                        input  entry(ii, v_os-file, '|')
     2548                       ,output v-full-path
     2549                       ,output v-path
     2550                       ,output v-file-name
     2551                       ,output v-file-name-no-ext
     2552                       ,output v-file-name-ext
     2553                       ) no-error .
     2554       if error-status:error  = ? then do:
     2555         message
     2556         substitute("Ошибка при поиске файла файла &1&2" +
     2557                    "возможно файл уже удален"
     2558                    , v-full-path
     2559                    , chr(10))
     2560        view-as alert-box error .
     2561        next _ii.
     2562       end.
     2563       assign
     2564       v-full-path = prepare-path(v-full-path).
     2565       FIND FIRST buf_tt-ext-file NO-LOCK WHERE
     2566                 buf_tt-ext-file.FILE-NAME = v-full-path NO-ERROR.
     2567       IF AVAILABLE buf_tt-ext-file THEN DO:
     2568          MESSAGE
     2569          substitute("В списке выбранных файлов уже есть файл &1&2&1" +
     2570                     "Дата файла &3, время файла &4")
     2571          VIEW-AS ALERT-BOX.
     2572       END.
     2573       file-info:FILE-NAME = v-full-path.
     2574       run gbl/md5.p (
     2575          input  v-full-path
     2576         ,output v-md5-signature
     2577         ) no-error.
     2578       if error-status:error then do:
     2579         message
     2580         substitute("Ошибка при выполнении подсчета КС файла &1&2" +
     2581                    "&3&2&4"
     2582                    , v-full-path
     2583                    , chr(10)
     2584                    , error-status:get-message(1)
     2585                    , return-value )
     2586        view-as alert-box error .
     2587        next _ii.
     2588       end.
     2589       run cur-time in this-procedure ( output v-today, output v-time).
     2590       CREATE buf_tt-ext-file.
     2591       ASSIGN
     2592       buf_tt-ext-file.FILE-NAME = v-full-path
     2593       buf_tt-ext-file.file-num = v-file-num + 1
     2594       v-file-num = v-file-num + 1
     2595       buf_tt-ext-file.create-sys-date      = file-info:FILE-mod-DATE
     2596       buf_tt-ext-file.create-sys-time      = STRING(file-info:FILE-mod-TIME, "HH:MM:SS")
     2597       buf_tt-ext-file.create-sys-time-INT  = file-info:FILE-mod-TIME
     2598       buf_tt-ext-file.update-sys-date      = v-today
     2599       buf_tt-ext-file.update-sys-time      = STRING(v-time, "HH:MM:SS")
     2600       buf_tt-ext-file.update-sys-time-INT  = file-info:FILE-MOD-TIME
     2601       buf_tt-ext-file.file-size            = FILE-INFO:FILE-SIZE
     2602       buf_tt-ext-file.crc-field            = v-md5-signature
     2603       .
     2604       rs-mode:DISABLE(radio-label('save-install':U, RS-mode:RADIO-BUTTONS IN FRAME Dialog-Frame)) IN FRAME Dialog-Frame.
     2605       RELEASE buf_tt-ext-file.
     2606       OPEN QUERY BR-files FOR EACH tt-ext-file NO-LOCK INDEXED-REPOSITION.
     2607   END.
     2608   END PROCEDURE.
     2609   PROCEDURE proc-b-all-deselect :
     2610   DEFINE BUFFER buf_tt-db FOR tt-db.
     2611   FOR EACH buf_tt-db:
     2612      DELETE buf_tt-db.
     2613   END.
     2614   IF p-db-num = ? THEN DO:   IF v-cntxt-db-num = 0 THEN DO:      OPEN QUERY BR-db FOR EACH X_db NO-LOCK WHERE X_db.db-num > 0,                  EACH tt-db OF X_db OUTER-JOIN NO-LOCK .   END.   ELSE DO:     OPEN QUERY BR-db FOR EACH X_db NO-LOCK WHERE X_db.db-num = 0,                  EACH tt-db OF X_db OUTER-JOIN NO-LOCK .    END. END. ELSE DO:     IF v-cntxt-db-num = 0 THEN DO:        OPEN QUERY BR-db FOR EACH X_db NO-LOCK WHERE X_db.db-num = p-db-num,                    EACH tt-db OF X_db OUTER-JOIN NO-LOCK .     END. END.
     2615   END PROCEDURE.
     2616   PROCEDURE proc-b-all-select :
     2617   DEFINE BUFFER buf_tt-db FOR tt-db.
     2618   GET first br-db no-lock.
     2619   DO WHILE available X_db :
     2620       GET prev br-db no-lock.
     2621   END.
     2622   GET next br-db no-lock.
     2623   DO WHILE available X_db :
     2624      FIND FIRST buf_tt-db NO-LOCK WHERE
     2625                buf_tt-db.db-num = X_db.db-num NO-ERROR.
     2626      IF NOT AVAILABLE buf_tt-db THEN DO:
     2627          CREATE buf_tt-db.
     2628          BUFFER-COPY X_db TO buf_tt-db.
     2629          RELEASE buf_Tt-db.
     2630      END.
     2631      GET next br-db no-lock.
     2632   END.
     2633   GET first br-db no-lock.
     2634   IF p-db-num = ? THEN DO:   IF v-cntxt-db-num = 0 THEN DO:      OPEN QUERY BR-db FOR EACH X_db NO-LOCK WHERE X_db.db-num > 0,                  EACH tt-db OF X_db OUTER-JOIN NO-LOCK .   END.   ELSE DO:     OPEN QUERY BR-db FOR EACH X_db NO-LOCK WHERE X_db.db-num = 0,                  EACH tt-db OF X_db OUTER-JOIN NO-LOCK .    END. END. ELSE DO:     IF v-cntxt-db-num = 0 THEN DO:        OPEN QUERY BR-db FOR EACH X_db NO-LOCK WHERE X_db.db-num = p-db-num,                    EACH tt-db OF X_db OUTER-JOIN NO-LOCK .     END. END.
     2635   END PROCEDURE.
     2636   PROCEDURE proc-mark-db :
     2637   DEFINE VARIABLE v-deleted-db-num AS INTEGER NO-UNDO.
     2638   DEFINE VARIABLE v-new-db-num AS INTEGER NO-UNDO.
     2639   DEFINE BUFFER buf_tt-db FOR tt-db.
     2640   DEFINE BUFFER buf_db FOR ub.db.
     2641   IF NOT AVAILABLE X_db THEN RETURN.
     2642   IF AVAILABLE tt-db THEN DO:
     2643     FIND FIRST buf_tt-db WHERE
     2644            RECID(buf_tt-db) = RECID(tt-db).
     2645     v-deleted-db-num = tt-db.db-num.
     2646     DELETE buf_tt-db.
     2647     IF p-db-num = ? THEN DO:   IF v-cntxt-db-num = 0 THEN DO:      OPEN QUERY BR-db FOR EACH X_db NO-LOCK WHERE X_db.db-num > 0,                  EACH tt-db OF X_db OUTER-JOIN NO-LOCK .   END.   ELSE DO:     OPEN QUERY BR-db FOR EACH X_db NO-LOCK WHERE X_db.db-num = 0,                  EACH tt-db OF X_db OUTER-JOIN NO-LOCK .    END. END. ELSE DO:     IF v-cntxt-db-num = 0 THEN DO:        OPEN QUERY BR-db FOR EACH X_db NO-LOCK WHERE X_db.db-num = p-db-num,                    EACH tt-db OF X_db OUTER-JOIN NO-LOCK .     END. END.
     2648     FIND first buf_db NO-LOCK WHERE
     2649               buf_db.db-num > v-deleted-db-num NO-ERROR.
     2650     IF AVAILABLE buf_db THEN DO:
     2651       REPOSITION br-db TO RECID RECID(buf_db).
     2652     END.
     2653     else do:
     2654       FIND first buf_db NO-LOCK WHERE
     2655                 buf_db.db-num = v-deleted-db-num NO-ERROR.
     2656       IF AVAILABLE buf_db THEN DO:
     2657         REPOSITION br-db TO RECID RECID(buf_db).
     2658       END.
     2659       else do:
     2660         FIND first buf_db NO-LOCK NO-ERROR.
     2661         REPOSITION br-db TO RECID RECID(buf_db).
     2662       end.
     2663     end.
     2664   END.
     2665   ELSE DO:
     2666       CREATE buf_tt-db.
     2667       BUFFER-COPY X_db TO buf_tt-db.
     2668       v-new-db-num = X_db.db-num.
     2669       RELEASE buf_tt-db.
     2670       IF p-db-num = ? THEN DO:   IF v-cntxt-db-num = 0 THEN DO:      OPEN QUERY BR-db FOR EACH X_db NO-LOCK WHERE X_db.db-num > 0,                  EACH tt-db OF X_db OUTER-JOIN NO-LOCK .   END.   ELSE DO:     OPEN QUERY BR-db FOR EACH X_db NO-LOCK WHERE X_db.db-num = 0,                  EACH tt-db OF X_db OUTER-JOIN NO-LOCK .    END. END. ELSE DO:     IF v-cntxt-db-num = 0 THEN DO:        OPEN QUERY BR-db FOR EACH X_db NO-LOCK WHERE X_db.db-num = p-db-num,                    EACH tt-db OF X_db OUTER-JOIN NO-LOCK .     END. END.
     2671       FIND FIRST buf_db NO-LOCK WHERE
     2672                 buf_db.db-num > v-new-db-num NO-ERROR.
     2673       IF AVAILABLE buf_db THEN DO:
     2674         REPOSITION br-db TO RECID RECID(buf_db).
     2675       END.
     2676       else do:
     2677         FIND first buf_db NO-LOCK WHERE
     2678                   buf_db.db-num = v-new-db-num NO-ERROR.
     2679         IF AVAILABLE buf_db THEN DO:
     2680           REPOSITION br-db TO RECID RECID(buf_db).
     2681         END.
     2682       end.
     2683   END.
     2684   END PROCEDURE.
     2685   PROCEDURE proc-run :
     2686   DEFINE VARIABLE glog AS LOGICAL NO-UNDO.
     2687   DEFINE VARIABLE v-today as date no-undo .
     2688   DEFINE VARIABLE v-time as integer no-undo .
     2689   DEFINE VARIABLE v-ok AS LOGICAL NO-UNDO.
     2690   define buffer buf_db for ub.db.
     2691   define buffer buf_tt-db for tt-db.
     2692   define buffer buf_tt-ext-file for tt-ext-file.
     2693   define buffer buf_tt-ext-file-par for tt-ext-file-par.
     2694   find first tt-db no-lock no-error.
     2695   if not available tt-db then do:
     2696     if p-mode = 'save-this-db':U then do:
     2697       find first buf_db no-lock where buf_db.db-num = v-cntxt-db-num.
     2698       create buf_tt-db.
     2699       buffer-copy buf_db to buf_tt-db.
     2700       release buf_tt-db.
     2701     end.
     2702     else do:
     2703       if v-cntxt-db-num = 0 then do:
     2704         message
     2705         "Не выбрана ни одна БД для пересылки"
     2706         view-as alert-box error .
     2707         return error.
     2708       end.
     2709       else do:
     2710         find first buf_db no-lock where buf_db.db-num = 0.
     2711         create buf_tt-db.
     2712         buffer-copy buf_db to buf_tt-db.
     2713         release buf_tt-db.
     2714       end.
     2715     end.
     2716   end.
     2717   IF rs-mode = 'save-disk-and-run':U
     2718   OR rs-mode = 'save-db-and-run':U THEN DO:
     2719     DEFINE VARIABLE v-ii AS INTEGER NO-UNDO.
     2720     DEFINE VARIABLE v-file-name AS character NO-UNDO.
     2721     v-ii = 0.
     2722     FOR EACH buf_tt-ext-file NO-LOCK:
     2723       v-ii = v-ii + 1.
     2724       IF v-ii = 2 THEN DO:
     2725         MESSAGE
     2726         "В данном режиме для пересылки можно выбрать только ОДИН файл"
     2727         VIEW-AS ALERT-BOX ERROR.
     2728         RETURN error.
     2729       END.
     2730     END.
     2731     FIND FIRST buf_tt-ext-file.
     2732     ASSIGN
     2733     v-file-name = prepare-path(buf_tt-ext-file.FILE-NAME)
     2734     v-file-name = entry(num-entries(v-file-name, chr(47))
     2735                              , v-file-name
     2736                              , chr(47)
     2737                             ).
     2738     run cur-time in THIS-PROCEDURE ( output v-today, output v-time).
     2739     for each buf_tt-ext-file-par no-lock:
     2740       if (buf_tt-ext-file-par.param-type = 'C':U
     2741          AND buf_tt-ext-file-par.param-name = '':U)
     2742       or (buf_tt-ext-file-par.param-type= 'T':U
     2743          AND buf_tt-ext-file-par.param-date-name = '':U)
     2744       or (buf_tt-ext-file-par.param-type = 'I':U
     2745          AND buf_tt-ext-file-par.param-int-name = '':U)
     2746       or (buf_tt-ext-file-par.param-type = 'D':U
     2747          AND buf_tt-ext-file-par.param-decimal-name = '':U)
     2748       or (buf_tt-ext-file-par.param-type = 'L':U
     2749           AND buf_tt-ext-file-par.param-log-name = '':U) then do:
     2750          message
     2751          "Не всем входным параметрам присвоены имена"
     2752          view-as alert-box error.
     2753          undo, return error .
     2754       end.
     2755     end.
     2756     message "ЕЩЕ РАЗ ПРОВЕРЬТЕ ВХОДНЫЕ ПАРАМЕТРЫ!!!!"
     2757     view-as alert-box .
     2758     run nws/sndfnwp.w (
     2759                     input parparentproc
     2760                    ,input 'ИЗМЕНЕНИЕ':U
     2761                    ,input "input"
     2762                    ,input 0
     2763                    ,input 0
     2764                    ,input 0
     2765                    ) NO-ERROR.
     2766     MESSAGE
     2767     substitute("ПРОДОЛЖИТЬ ВЫПОЛНЕНИЕ ОПЕРАЦИИ &1 над выбранным файлом с выбранными параметрами?"
     2768                , rs-mode)
     2769     VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE glog.
     2770     IF glog = NO THEN RETURN ERROR.
     2771   END.
     2772   else do:
     2773     run cur-time in THIS-PROCEDURE ( output v-today, output v-time).
     2774     RUN confirm-password IN THIS-PROCEDURE (
     2775                                             INPUT '':U
     2776                                             ,INPUT v-today
     2777                                             ,OUTPUT v-ok) NO-ERROR.
     2778     IF NOT v-ok
     2779     THEN DO:
     2780         MESSAGE
     2781         "Пароль неверный"
     2782         VIEW-AS ALERT-BOX ERROR.
     2783         UNDO, RETURN ERROR.
     2784     END.
     2785   end.
     2786   run str/diallog.w (
     2787               INPUT parparentproc
     2788             , INPUT this-procedure:HANDLE
     2789             , INPUT 'nws/sndfnwr.p':U
     2790             , INPUT (rs-mode + chr(4) +
     2791                      string(rs-path-TYPE) + chr(4) +
     2792                      f-path + chr(4) +
     2793                      p-status_)
     2794             , INPUT no
     2795             , input 'Прервать'
     2796             , INPUT (if p-mode = 'save-this-db':U then 'Сохранение файлов в текущей БД' else 'Пересылка файлов через СПН')) no-error .
     2797   END PROCEDURE.
