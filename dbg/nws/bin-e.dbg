      217         file-info :file-name    = v-binfile-converter-program
      218         v-convert-full-pathname = file-info :full-pathname
      219       .
      220       assign
      221         file-info :file-name    = v-temp-file-name
      222         v-temp-full-pathname    = file-info :full-pathname
      223       .
