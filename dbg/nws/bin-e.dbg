      116     on error undo, return error return-value
      117     :
      118       run binfile_clear in this-procedure
      119         (input p-db-num
      120         ,input p-from-db-num
      121         ,input p-file-num
      122         ) .
      123       run gbl/_tmpfile.p
      124         (input  't':U
      125         ,input  '.b64':U
      126         ,output v-temp-file-name
      127         ) .
      128   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      129   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run file-wr in g#library
      130     (input v-temp-file-name
      131     ,input '':U
      132     )  .
      133       assign
      134         file-info :file-name    = v-binfile-converter-program
      135         v-convert-full-pathname = file-info :full-pathname
      136       .
      137       assign
