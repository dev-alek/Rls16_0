      143         v-temp-full-pathname    = file-info :full-pathname
      144       .
      145       assign
      146         v-command-line = substitute('&1 -e "&2" &3':U
      147                                         ,v-convert-full-pathname
      148                                         ,v-input-full-pathname
      149                                         ,v-temp-full-pathname
      150                                         )
      151       .
      152       os-command silent value(v-command-line) .
      153       input stream sinp from value(v-temp-full-pathname) .
      154       assign
      155         v-line-num = 0
      156       .
      157       repeat
      158       :
      159         assign
      160           v-read-line = '':U
      161         .
      162         import stream sinp unformatted v-read-line .
      163         if v-read-line <> '':U
      164         then do:
      165           assign
      166             v-line-num  = v-line-num + 1
      167           .
      168           create buf_temp-ext-file-line .
      169           assign
      170             buf_temp-ext-file-line.db-num       = p-db-num
      171             buf_temp-ext-file-line.from-db-num  = p-from-db-num
      172             buf_temp-ext-file-line.file-num     = p-file-num
      173             buf_temp-ext-file-line.line-num     = v-line-num
      174             buf_temp-ext-file-line.sub-line-num = 0
      175             buf_temp-ext-file-line.line-text    = v-read-line
      176           .
      177         end.
      178       end.
      179       input stream sinp close .
      180       os-delete value(v-temp-full-pathname) .
      181     end.
      182   end procedure.
      183   procedure binfile_write :
      184     define input  parameter p-db-num        as integer   no-undo .
      185     define input  parameter p-from-db-num   as integer   no-undo .
      186     define input  parameter p-file-num      as integer   no-undo .
