      191     define variable v-convert-full-pathname as character no-undo .
      192     define variable v-command-line          as character no-undo .
      193     define buffer buf_temp-ext-file-line for temp-ext-file-line .
      194     do
      195     on error undo, return error return-value
      196     :
      197       run gbl/_tmpfile.p
      198         (input  't':U
      199         ,input  '.b64':U
      200         ,output v-temp-file-name
      201         ) .
      202       output stream sinp to value(v-temp-file-name) .
      203       for each buf_temp-ext-file-line
      204         where buf_temp-ext-file-line.db-num   = p-db-num
      205           and buf_temp-ext-file-line.from-db-num = p-from-db-num
      206           and buf_temp-ext-file-line.file-num = p-file-num
      207       by buf_temp-ext-file-line.line-num
      208       by buf_temp-ext-file-line.sub-line-num
      209       on error undo, return error return-value
      210       :
