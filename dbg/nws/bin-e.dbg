      404   define variable v-cmd-proc-handle as handle no-undo .
      405   define variable v-cmd-code as integer no-undo .
      406   define variable v-md5-signature as character no-undo .
      407   define variable v-path                    as character                no-undo .
      408   DEFINE VARIABLE v-full-path               as character                no-undo .
      409   DEFINE VARIABLE v-file-name               as character                no-undo .
      410   DEFINE VARIABLE v-file-name-no-ext        as character                no-undo .
      411   DEFINE VARIABLE v-file-name-ext           as character                no-undo .
      412   define variable v-rec-ord                 as integer                  no-undo .
      413   define buffer buf_temp-ext-file-line for temp-ext-file-line .
      414   define buffer buf_tt-ext-file-par for tt-ext-file-par.
      415   define buffer buf_ext-file-par for ub.ext-file-par.
      416   define buffer buf_ext-file-line for ub.ext-file-line.
      417   main-block:
      418   do
      419   on error undo, return error return-value
      420   :
      421     run gbl/filename.p (
      422                     input p-full-path-name
      423                   ,output v-full-path
      424                   ,output v-path
      425                   ,output v-file-name
      426                   ,output v-file-name-no-ext
      427                   ,output v-file-name-ext
      428                   ) no-error .
      429     if error-status:error then do:
      430       undo main-block, return error substitute("&1 &2 &3&4Ошибка при определении имени файла &5&4" +
      431                                           "&6&4&7"
      432                                           ,vss-workfile
      433                                           ,vss-revision
      434                                           ,vss-description
      435                                           ,chr(10)
      436                                           ,p-full-path-name
      437                                           ,error-status:get-message(1)
      438                                           ,return-value ).
      439     end.
      440     if p-mode = 'save-this-db':U then do:
      441       run binfile_read-to-db in this-procedure (
      442         input  p-db-num
      443         ,input p-from-db-num
      444         ,input  p-file-num
      445         ,input  p-full-path-name
      446         ) .
      447       if buf_ext-file.file-type begins ('cash-desk':U + chr(3))
      448       then do:
      449         for each buf_tt-ext-file-par no-lock:
      450             find first buf_ext-file-par where
      451                       buf_ext-file-par.db-num = 0
      452                   and buf_ext-file-par.from-db-num = 0
      453                   and buf_ext-file-par.file-num = 0
      454                   and buf_ext-file-par.param-num = buf_tt-ext-file-par.param-num  no-error.
      455             if not available buf_ext-file-par then do:
      456               create buf_ext-file-par.
      457             end.
      458             buffer-copy buf_tt-ext-file-par except db-num from-db-num file-num
      459             to buf_ext-file-par
      460             assign
      461             buf_ext-file-par.from-db-num = p-from-db-num
      462             buf_ext-file-par.db-num = p-db-num
      463             buf_ext-file-par.file-num = buf_Ext-file.file-num
      464             buf_ext-file-par.user-db-num = p-from-db-num
      465             .
      466         end.
      467       end.
      468       return.
      469     end.
      470     else do:
      471       if p-md5-signature = '':U then do:
      472         run gbl/md5.p (
      473           input  p-full-path-name
      474           ,output p-md5-signature
      475           ) .
      476       end.
      477       run binfile_read in this-procedure (
      478          input  p-db-num
      479         ,input  p-from-db-num
      480         ,input  p-file-num
      481         ,input  p-full-path-name
      482         ) .
      483     end.
      484     if not valid-handle(v-cmd-proc-handle ) then dO:
      485       run nws/cmd-bush.p persistent set v-cmd-proc-handle no-error .
      486       if error-status :error
      487       then do:
      488         delete procedure v-cmd-proc-handle .
      489         undo main-block, return error substitute("&1 &2 &3&4Ошибка при запуске процедуры cmd-bush.p&4" +
      490                                             "&5&4&6"
      491                                             ,vss-workfile
      492                                             ,vss-revision
      493                                             ,vss-description
      494                                             ,chr(10)
      495                                             ,error-status:get-message(1)
      496                                             ,return-value ).
      497       end.
      498     end.
      499     run begin-create-command in v-cmd-proc-handle (
      500                                                   input  ('cmd-send-binary':U + chr(6)
      501                                                         + p-mode  + chr(6)
      502                                                         + string(p-file-num) + chr(6)
      503                                                         + v-file-name + chr(6)
      504                                                         + string(p-path-type) + chr(6)
      505                                                         + p-path + chr(6)
      506                                                         + p-md5-signature  )
      507                                                   ,INPUT  string(if p-db-num > 0 then p-db-num else 0)
      508                                                   ,output v-cmd-code
      509       ) no-error.
      510     if error-status :error
      511     then do:
      512       delete procedure v-cmd-proc-handle .
      513       undo main-block, return error substitute("&1 &2 &3&4Ошибка при создании команды &5&4" +
      514                                           "&6&4&7"
      515                                           ,vss-workfile
      516                                           ,vss-revision
      517                                           ,vss-description
      518                                           ,chr(10)
      519                                           ,'cmd-send-binary':U
      520                                           ,error-status:get-message(1)
      521                                           ,return-value ).
      522     end.
      523     run add-dump in v-cmd-proc-handle
      524       (input v-cmd-code
      525       ,input 'ext-file':U
      526       ,input '+update'
      527       ,input (buffer buf_ext-file:handle)
      528       ,input '':U
      529       ,output v-rec-ord
      530       ) no-error .
      531     if error-status :error
      532     then do:
      533       delete procedure v-cmd-proc-handle .
      534       undo main-block, return error substitute("&1 &2 &3Ошибка при добавлении записи &4 в команду с кодом &5 &6&3" +
      535                                           "&7&3БД"
      536                                           ,vss-workfile
      537                                           ,vss-revision
      538                                           ,chr(10)
      539                                           ,'ext-file':U
      540                                           ,v-cmd-code
      541                                           ,error-status:get-message(1)
      542                                           ,return-value
      543                                           ).                                                       ~
      544     end.
      545     for each buf_temp-ext-file-line no-lock:
      546         find first buf_ext-file-line where
      547                   buf_ext-file-line.db-num = p-db-num
      548               and buf_ext-file-line.from-db-num = p-from-db-num
      549               and buf_ext-file-line.file-num = p-file-num
      550               and buf_ext-file-line.line-num = buf_temp-ext-file-line.line-num
      551               and buf_ext-file-line.sub-line-num = buf_temp-ext-file-line.sub-line-num
      552               no-error.
      553         if not available buf_ext-file-line then do:
      554           create buf_ext-file-line.
      555         end.
      556         buffer-copy buf_temp-ext-file-line except db-num from-db-num file-num
      557         to buf_ext-file-line
      558         assign
      559         buf_ext-file-line.from-db-num = p-from-db-num
      560         buf_ext-file-line.db-num = p-db-num
      561         buf_ext-file-line.file-num = p-file-num
      562         .
      563       run add-dump in v-cmd-proc-handle
      564         (input v-cmd-code
      565         ,input 'ext-file-line':U
      566         ,input '+update'
      567         ,input (buffer buf_temp-ext-file-line:handle)
      568         ,input '':U
      569         ,output v-rec-ord
      570         ) no-error .
      571       if error-status :error
      572       then do:
      573         delete procedure v-cmd-proc-handle .
      574         undo main-block, return error substitute("&1 &2 &3Ошибка при добавлении записи &4 в команду с кодом &5 &6&3" +
      575                                             "&7&3БД"
      576                                             ,vss-workfile
      577                                             ,vss-revision
      578                                             ,chr(10)
      579                                             ,'ext-file-line':U
      580                                             ,v-cmd-code
      581                                             ,error-status:get-message(1)
      582                                             ,return-value
      583                                             ).                                                       ~
      584       end.
      585     end.
      586     if p-mode = 'save-disk-and-run':U
      587     or p-mode = 'save-db-and-run':U
      588     or buf_ext-file.file-type begins ('cash-desk':U + chr(3))
      589     then do:
      590     for each buf_tt-ext-file-par no-lock:
      591         find first buf_ext-file-par where
      592                   buf_ext-file-par.db-num = 0
      593               and buf_ext-file-par.from-db-num = 0
      594               and buf_ext-file-par.file-num = 0
      595               and buf_ext-file-par.param-num = buf_tt-ext-file-par.param-num  no-error.
      596         if not available buf_ext-file-par then do:
      597           create buf_ext-file-par.
      598         end.
      599         buffer-copy buf_tt-ext-file-par except db-num from-db-num file-num
      600         to buf_ext-file-par
      601         assign
      602         buf_ext-file-par.from-db-num = p-from-db-num
      603         buf_ext-file-par.db-num = p-db-num
      604         buf_ext-file-par.file-num = buf_Ext-file.file-num
      605         buf_ext-file-par.user-db-num = p-from-db-num
      606         .
      607         run add-dump in v-cmd-proc-handle
      608           (input v-cmd-code
      609           ,input 'ext-file-par':U
      610           ,input '+update'
      611           ,input (buffer buf_ext-file-par:handle)
      612           ,input '':U
      613           ,output v-rec-ord
      614           ) no-error .
      615         if error-status :error
      616         then do:
      617           delete procedure v-cmd-proc-handle .
      618           undo main-block, return error substitute("&1 &2 &3Ошибка при добавлении записи &4 в команду с кодом &5 &6&3" +
      619                                               "&7&3БД"
      620                                               ,vss-workfile
      621                                               ,vss-revision
      622                                               ,chr(10)
      623                                               ,'ext-file-par':U
      624                                               ,v-cmd-code
      625                                               ,error-status:get-message(1)
      626                                               ,return-value
      627                                               ).                                                       ~
      628         end.
      629       end.
      630     end.
      631     run send-command in v-cmd-proc-handle
      632       ( input v-cmd-code
      633         ,input string(if p-db-num > 0 then p-db-num else 0)
      634         ) no-error .
      635     if error-status :error then do:
      636       delete procedure v-cmd-proc-handle .
      637       undo main-block, return error substitute("&1 &2 &3&4Ошибка при отправке в новости команды с кодом &5 БД &8&4" +
      638                                           "&6&4&7"
      639                                           ,vss-workfile
      640                                           ,vss-revision
      641                                           ,vss-description
      642                                           ,chr(10)
      643                                           ,v-cmd-code
      644                                           ,error-status:get-message(1)
      645                                           ,return-value
      646                                           ,p-db-num
      647                                           ).
      648     end.
      649     delete procedure v-cmd-proc-handle .
      650   end.
