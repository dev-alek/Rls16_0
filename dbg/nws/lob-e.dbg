        1   block-level on error undo, throw.
        2   define input parameter p-lob-bh as handle no-undo .
        3   define input  parameter p-db-list as character no-undo .
        4   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        5   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        6   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile: lob-e.p $":U .
        8   define variable vss-archive     as character no-undo init "$Archive: nws/lob-e.p $":U .
        9   define variable vss-description as character no-undo init "Отсылка CLOB-DATA или BLOB-DATA по СПН".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define new global shared variable g#library  as handle no-undo .
       69   define new global shared variable g#library2 as handle no-undo .
       70   define   shared variable g#auto as logical no-undo.
       71   define   shared variable g#news as logical no-undo.
       72   define   shared variable g#oxml as logical no-undo.
       73   define   shared variable g#esys as logical no-undo.
       74   define   shared variable g#news-source-db as integer no-undo.
       75   define   shared variable g#esys-source-esys as integer no-undo.
       76   define   shared variable g#db-num as integer   no-undo .
       77   define   shared variable g#userid as character no-undo .
       78   define   shared variable g#passwd as character no-undo .
       79   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       80   define temp-table temp-nws-outline no-undo like ub.nws-outline.
       81   define temp-table temp-ext-file-line no-undo like ub.ext-file-line.
       82   procedure lob_clear :
       83     define buffer buf_temp-nws-outline  for temp-nws-outline .
       84     define buffer buf_temp-ext-file-line  for temp-ext-file-line .
       85     do
       86     on error undo, return error return-value
       87     :
       88       for each buf_temp-nws-outline
       89       on error undo, return error return-value
       90       :
       91         delete buf_temp-nws-outline .
       92       end.
       93       for each buf_temp-ext-file-line
       94       on error undo, return error return-value
       95       :
       96         delete buf_temp-ext-file-line .
       97       end.
       98     end.
       99   end procedure.
      100   procedure lob_read :
      101     define input  parameter p-lob-bh      as handle no-undo .
      102     define variable v-read-line             as character no-undo format "X(255)".
      103     define variable v-line-num              as integer   no-undo .
      104     define variable v-size                  as int64     no-undo .
      105     define variable v-cursor                as int64     no-undo .
      106     define variable v-longchar              as longchar  no-undo .
      107     define variable v-memptr                as memptr    no-undo .
      108     define buffer buf_temp-ext-file-line for temp-ext-file-line .
      109     do
      110     on error undo, return error return-value
      111     :
      112       run lob_clear in this-procedure       .
      113       if p-lob-bh:table = 'blob-data':U then do:
      114         COPY-LOB
      115         from object p-lob-bh:buffer-field("bdata"):buffer-value
      116         to v-memptr.
      117       end.
      118       else do:
      119         COPY-LOB
      120         from object p-lob-bh:buffer-field("cdata"):buffer-value
      121         to v-memptr.
      122       end.
      123        v-longchar = BASE64-ENCODE(v-memptr).
      124        COPY-LOB
      125        from v-longchar
      126        to v-memptr.
      127        v-size = get-size(v-memptr).
      128        v-longchar = '':U.
      129       assign
      130         v-line-num = 0
      131       .
      132       repeat while v-cursor < v-size
      133       :
      134         assign
      135           v-read-line = '':U
      136         .
      137         v-read-line = GET-STRING ( v-memptr , v-cursor + 1, (if v-line-num * 2048 <= v-size
      138                                                              then 2048
      139                                                              else (v-size - (v-line-num - 1)* 2048) ) ).
      140         create buf_temp-ext-file-line.
      141         assign
      142         v-line-num = v-line-num + 1
      143         v-cursor = v-cursor + length(v-read-line)
      144         buf_temp-ext-file-line.db-num         = -1
      145         buf_temp-ext-file-line.file-num       = -1
      146         buf_temp-ext-file-line.from-db-num    = -1
      147         buf_temp-ext-file-line.line-num       = v-line-num
      148         buf_temp-ext-file-line.line-text      = v-read-line
      149         .
      150       end.
      151       set-size(v-memptr) = 0.
      152     end.
      153   end procedure.
      154   procedure lob_write :
      155     define input  parameter p-lob-bh        as handle no-undo .
      156     define variable v-memptr as memptr no-undo .
      157     define variable v-memptr1 as memptr no-undo .
      158     define variable v-read-line             as character no-undo format "X(255)".
      159     define variable v-line-num              as integer   no-undo .
      160     define variable v-size                  as int64     no-undo .
      161     define variable v-cursor                as int64     no-undo .
      162     define variable v-longchar              as longchar  no-undo .
      163     define buffer buf_temp-ext-file-line for temp-ext-file-line .
      164     do
      165     on error undo, return error return-value
      166     :
      167       for each buf_temp-ext-file-line
      168       by buf_temp-ext-file-line.db-num
      169       by buf_temp-ext-file-line.file-num
      170       by buf_temp-ext-file-line.from-db-num
      171       by buf_temp-ext-file-line.line-num
      172       on error undo, return error return-value
      173       :
      174         assign
      175         v-size = v-size + length(buf_temp-ext-file-line.line-text).
      176       end.
      177       if v-size = 0 then return.
      178       set-size(v-memptr) = v-size.
      179       set-size(v-memptr1) = integer(8 / 6 * v-size) + 1.
      180       for each buf_temp-ext-file-line
      181       by buf_temp-ext-file-line.db-num
      182       by buf_temp-ext-file-line.file-num
      183       by buf_temp-ext-file-line.from-db-num
      184       by buf_temp-ext-file-line.line-num
      185       on error undo, return error return-value
      186       :
      187         PUT-STRING ( v-memptr , v-cursor + 1, length(buf_temp-ext-file-line.line-text) ) = buf_temp-ext-file-line.line-text.
      188         assign
      189         v-cursor = v-cursor + length(buf_temp-ext-file-line.line-text).
      190       end.
      191       COPY-LOB
      192       from v-memptr
      193       to v-longchar.
      194       v-memptr1 = BASE64-DECODE(v-longchar).
      195       v-longchar = '':U.
      196       if p-lob-bh:table = 'blob-data':U then do:
      197         COPY-LOB
      198         from v-memptr1
      199         to object p-lob-bh:buffer-field("bdata"):buffer-value
      200         .
      201       end.
      202       else do:
      203         COPY-LOB
      204         from v-memptr1
      205         to object p-lob-bh:buffer-field("cdata"):buffer-value
      206         .
      207       end.
      208       set-size(v-memptr) = 0.
      209       set-size(v-memptr1) = 0.
      210     end.
      211   end procedure.
      212   define variable v-cmd-proc-handle as handle no-undo .
      213   define variable v-cmd-code as integer no-undo .
      214   define variable v-rec-ord as integer   no-undo .
      215   define variable v-ii as integer   no-undo .
      216   define buffer buf_db for ub.db.
      217   define buffer buf_temp-nws-outline for temp-nws-outline.
      218   define buffer buf_temp-ext-file-line for temp-ext-file-line.
      219   main-block:
      220   do
      221   on error undo, return error return-value
      222   :
      223     if p-lob-bh:available = no then do:
      224        message
      225        vss-workfile vss-revision vss-description skip
      226        "Передан буфер без записи"
      227        view-as alert-box error .
      228        undo main-block, return error .
      229     end.
      230     if not (p-lob-bh:table = 'clob-data':U
      231             or
      232             p-lob-bh:table = 'blob-data':U) then do:
      233        message
      234        vss-workfile vss-revision vss-description skip
      235        substitute("Работает только для &1 или &2", 'clob-data':U, 'blob-data':U)
      236        view-as alert-box error .
      237        undo main-block, return error .
      238     end.
      239     if p-db-list = '':U then do:
      240       if g#db-num > 0 then do:
      241          assign
      242          p-db-list = string(0).
      243       end.
      244       else do:
      245         for each buf_db where buf_db.db-num > 0 no-lock
      246         on error  undo,  return  error :
      247           assign p-db-list = p-db-list + chr(1) + string(buf_db.db-num).
      248         end.
      249         assign
      250         p-db-list = trim(p-db-list, chr(1))
      251         .
      252       end.
      253     end.
      254     run lob_read in this-procedure (
      255        input  p-lob-bh
      256       ) .
      257     if not valid-handle(v-cmd-proc-handle ) then dO:
      258       run nws/cmd-bush.p persistent set v-cmd-proc-handle no-error .
      259       if error-status :error
      260       then do:
      261         delete procedure v-cmd-proc-handle .
      262         undo main-block, return error substitute("&1 &2 &3&4Ошибка при запуске процедуры cmd-bush.p&4" +
      263                                             "&5&4&6"
      264                                             ,vss-workfile
      265                                             ,vss-revision
      266                                             ,vss-description
      267                                             ,chr(10)
      268                                             ,error-status:get-message(1)
      269                                             ,return-value ).
      270       end.
      271     end.
      272     run begin-create-command in v-cmd-proc-handle (
      273                                                   input  ('cmd-send-lob':U  + chr(6)
      274                                                         + p-lob-bh:table + chr(6)
      275                                                         + string(p-lob-bh::db-num) + chr(6)
      276                                                         + string(p-lob-bh::int64-id) )
      277                                                   ,INPUT  p-db-list
      278                                                   ,output v-cmd-code
      279       ) no-error.
      280     if error-status :error
      281     then do:
      282       delete procedure v-cmd-proc-handle .
      283       undo main-block, return error substitute("&1 &2 &3&4Ошибка при создании команды &5&4" +
      284                                           "&6&4&7"
      285                                           ,vss-workfile
      286                                           ,vss-revision
      287                                           ,vss-description
      288                                           ,chr(10)
      289                                           ,'cmd-send-binary':U
      290                                           ,error-status:get-message(1)
      291                                           ,return-value ).
      292     end.
      293     create buf_temp-nws-outline.
      294     assign
      295     buf_temp-nws-outline.outline-type = p-lob-bh:table
      296     buf_temp-nws-outline.no-id = 0
      297     .
      298     do v-ii = 1 to p-lob-bh:num-fields:
      299       if not (p-lob-bh:buffer-field(v-ii):data-type = 'clob':U
      300               or
      301               p-lob-bh:buffer-field(v-ii):data-type = 'blob':U) then do:
      302         assign
      303         buf_temp-nws-outline.charkey_one = buf_temp-nws-outline.charkey_one +
      304                                            (if v-ii = 1 then '':U else chr(3)) +
      305                                            string((if p-lob-bh:buffer-field(v-ii):buffer-value = ? then chr(63) else p-lob-bh:buffer-field(v-ii):buffer-value)).
      306       end.
      307     end.
      308     run add-dump in v-cmd-proc-handle
      309       (input v-cmd-code
      310       ,input 'nws-outline':U
      311       ,input '+update'
      312       ,input buffer buf_temp-nws-outline:handle
      313       ,input '':U
      314       ,output v-rec-ord
      315       ) no-error .
      316     if error-status :error
      317     then do:
      318       delete procedure v-cmd-proc-handle .
      319       undo main-block, return error substitute("&1 &2 &3Ошибка при добавлении записи &4 в команду с кодом &5 &6&3" +
      320                                           "&7&3БД"
      321                                           ,vss-workfile
      322                                           ,vss-revision
      323                                           ,chr(10)
      324                                           ,p-lob-bh:table
      325                                           ,v-cmd-code
      326                                           ,error-status:get-message(1)
      327                                           ,return-value
      328                                           ).                                                       ~
      329     end.
      330     for each buf_temp-ext-file-line
      331     by buf_temp-ext-file-line.db-num
      332     by buf_temp-ext-file-line.file-num
      333     by buf_temp-ext-file-line.from-db-num
      334     by buf_temp-ext-file-line.line-num:
      335       run add-dump in v-cmd-proc-handle
      336         (input v-cmd-code
      337         ,input 'ext-file-line':U
      338         ,input '+update'
      339         ,input (buffer buf_temp-ext-file-line:handle)
      340         ,input '':U
      341         ,output v-rec-ord
      342         ) no-error .
      343       if error-status :error
      344       then do:
      345         delete procedure v-cmd-proc-handle .
      346         undo main-block, return error substitute("&1 &2 &3Ошибка при добавлении записи &4 в команду с кодом &5 &6&3" +
      347                                             "&7&3БД"
      348                                             ,vss-workfile
      349                                             ,vss-revision
      350                                             ,chr(10)
      351                                             ,p-lob-bh:table
      352                                             ,v-cmd-code
      353                                             ,error-status:get-message(1)
      354                                             ,return-value
      355                                             ).                                                       ~
      356       end.
      357     end.
      358     run send-command in v-cmd-proc-handle
      359       ( input v-cmd-code
      360         ,input p-db-list
      361         ) no-error .
      362     if error-status :error then do:
      363       delete procedure v-cmd-proc-handle .
      364       undo main-block, return error substitute("&1 &2 &3&4Ошибка при отправке в новости команды с кодом &5 БД &8&4" +
      365                                           "&6&4&7"
      366                                           ,vss-workfile
      367                                           ,vss-revision
      368                                           ,vss-description
      369                                           ,chr(10)
      370                                           ,v-cmd-code
      371                                           ,error-status:get-message(1)
      372                                           ,return-value
      373                                           ,p-lob-bh::db-num
      374                                           ).
      375     end.
      376     delete procedure v-cmd-proc-handle .
      377   end.
