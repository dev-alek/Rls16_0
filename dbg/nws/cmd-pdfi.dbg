        1   block-level on error undo, throw.
        2   define input  parameter p-imp-handle as handle    no-undo .
        3   define input  parameter p-counter  as integer   no-undo .
        4   define input  parameter p-type as character no-undo .
        5   define input  parameter p-par1 as integer   no-undo .
        6   define input  parameter p-par2 as integer   no-undo .
        7   define input  parameter p-par3 as integer   no-undo .
        8   define input  parameter p-par4 as integer   no-undo .
        9   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       10   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       11   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       12   define variable vss-workfile    as character no-undo init "$Workfile: cmd-pdfi.p $":U .
       13   define variable vss-archive     as character no-undo init "$Archive: nws/cmd-pdfi.p $":U .
       14   define variable vss-description as character no-undo init "Обработка команды по закрытой шапке ДНЦ".
       15   procedure vss-get-info :
       16     define output parameter p-vss-revision    like vss-revision    no-undo .
       17     define output parameter p-vss-author      like vss-author      no-undo .
       18     define output parameter p-vss-date        like vss-date        no-undo .
       19     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       20     define output parameter p-vss-archive     like vss-archive     no-undo .
       21     define output parameter p-vss-description like vss-description no-undo .
       22     assign
       23       p-vss-revision    = vss-revision
       24       p-vss-author      = vss-author
       25       p-vss-date        = vss-date
       26       p-vss-workfile    = vss-workfile
       27       p-vss-archive     = vss-archive
       28       p-vss-description = vss-description
       29     .
       30   end procedure.
       31   procedure vss-get-parameters :
       32     define output parameter p-vss-parameters as character no-undo .
       33       assign
       34         p-vss-parameters = substitute('&1|&2|':u,p-counter,p-type)
       35       .
       36   end procedure.
       37   define new global shared variable g#vssrevis-logger as handle    no-undo .
       38   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       39   define variable v-vssrevis-logger                   as handle    no-undo .
       40   procedure vss-logevent :
       41     define input  parameter p-extra-paramters as character no-undo .
       42     define variable v-vssrevis-parameters as character no-undo .
       43     do
       44     on error undo, return error return-value
       45     :
       46       if  valid-handle(v-vssrevis-logger)
       47       and v-vssrevis-logger :get-signature("logevent") <> ""
       48       then do:
       49         run vss-get-parameters in this-procedure
       50           (output v-vssrevis-parameters
       51           ).
       52         run logevent in v-vssrevis-logger
       53           (input vss-workfile
       54           ,input vss-revision
       55           ,input v-vssrevis-parameters
       56           ,input p-extra-paramters
       57           ).
       58       end.
       59     end.
       60   end procedure.
       61   assign
       62     v-vssrevis-logger = g#vssrevis-logger
       63   .
       64   if  valid-handle(v-vssrevis-logger)
       65   and v-vssrevis-logger :get-signature("logevent") <> ""
       66   then do:
       67     assign
       68       v-vssrevis-logevent = true
       69     .
       70     run vss-logevent in this-procedure (input vss-description) .
       71   end.
       72   define new global shared variable g#language as character no-undo .
       73   if g#language <> '' and g#language <> 'rus':U then do:
       74     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       75   end.
       76   define new global shared variable g#library  as handle no-undo .
       77   define new global shared variable g#library2 as handle no-undo .
       78   define   shared variable g#auto as logical no-undo.
       79   define   shared variable g#news as logical no-undo.
       80   define   shared variable g#oxml as logical no-undo.
       81   define   shared variable g#esys as logical no-undo.
       82   define   shared variable g#news-source-db as integer no-undo.
       83   define   shared variable g#esys-source-esys as integer no-undo.
       84   define   shared variable g#db-num as integer   no-undo .
       85   define   shared variable g#userid as character no-undo .
       86   define   shared variable g#passwd as character no-undo .
       87   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       88   define variable v-waitfram-action01         as character   no-undo .
       89   define variable v-waitfram-action02         as character   no-undo .
       90   define variable v-waitfram-action03         as character   no-undo .
       91   define variable mWaitFramTextBeg            as character   no-undo.
       92   define variable mWaitFramTextEnd            as character   no-undo.
       93   define variable mWaitFramView               as logical     no-undo.
       94   define variable mWaitProcEvent              as logical     no-undo init yes.
       95   define variable mWaitFramInterval           as integer     no-undo init 1 .
       96   define variable mWaitFramStop               as logical     no-undo.
       97   define variable mWaitFramStopUser           as logical     no-undo.
       98   define variable mWaitFramStopTimeOut        as logical     no-undo.
       99   define variable mWaitFramStartProc          as datetime-tz no-undo.
      100   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      101   define button B-WaitFramStop auto-end-key
      102        label "Стоп"
      103        size 10 by 1 tooltip "Остоновить процесс".
      104   define button B-viewProcInfo
      105        label "Информация"
      106        size 15 by 1 tooltip "Информация о процесс".
      107   define frame waitfram
      108     v-waitfram-action01 format "x(72)" no-label skip
      109     v-waitfram-action02 format "x(72)" no-label skip
      110     v-waitfram-action03 format "x(72)" no-label skip
      111     B-viewProcInfo
      112     B-WaitFramStop at row 4 col 30
      113     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      114     .
      115   define new global shared variable mBatchMode as logical no-undo init ?.
      116   define variable mFramBachModHandle as handle no-undo.
      117   mFramBachModHandle = frame waitfram:handle.
      118   define variable mFameOldVis as logical no-undo.
      119   define variable mVisCUrentVin as logical no-undo.
      120   if session:batch-mode
      121   then
      122      mBatchMode = yes.
      123   if mBatchMode = ? then do:
      124     mVisCUrentVin = current-window:visible.
      125     mFameOldVis = mFramBachModHandle:visible.
      126     mFramBachModHandle:visible  = yes.
      127     mBatchMode = mFramBachModHandle:visible ne yes.
      128     mFramBachModHandle:visible = mFameOldVis.
      129     current-window:visible = mVisCUrentVin.
      130   end.
      131    if  log-manager:logfile-name ne ?
      132     then DO:
      133         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      134         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      135         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      136     end.
      137   on choose of B-WaitFramStop in frame waitfram
      138   do:
      139     mWaitFramStop = yes.
      140     mWaitFramStopUser = yes.
      141   end.
      142   function waitfram-check-timeout returns logical():
      143      define variable vtime as int64 no-undo.
      144      if mWaitFramStopTimeOut
      145      then
      146         return yes.
      147      vtime = ( now - mWaitFramStartProc ) / 1000 .
      148      if     mWaitFramTimeOut ne ?
      149         and mWaitFramTimeOut ne 0
      150         and mWaitFramTimeOut lt vtime
      151      then do:
      152         mWaitFramStopTimeOut = yes.
      153      end.
      154      return mWaitFramStopTimeOut.
      155   end.
      156   procedure waitfram-hide :
      157     if not session:batch-mode
      158     then do
      159     on error undo, return error return-value
      160     :
      161       pause 0 before-hide .
      162       if not mBatchMode then
      163         hide frame waitfram .
      164     if     not mWaitFramView
      165        and mWaitProcEvent
      166     then
      167       process events .
      168     end.
      169   end procedure.
      170   procedure waitfram-show :
      171     define input  parameter p-message as character no-undo .
      172     define variable v-left-margin as integer   no-undo .
      173     if not session:batch-mode
      174     then do
      175     on error undo, return error return-value
      176     :
      177       if length(p-message) <= 70 then do:
      178         assign
      179           v-left-margin = integer((70 - length(p-message)) / 2)
      180         .
      181         assign
      182           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      183         .
      184         assign
      185           v-waitfram-action01 = " "
      186           v-waitfram-action02 = " "
      187                                    + fill(" ", v-left-margin)
      188                                    + p-message
      189           v-waitfram-action03 = " "
      190         .
      191       end.
      192       else do:
      193         define variable vRindex1 as integer no-undo.
      194         define variable vRindex2 as integer no-undo.
      195         vRindex1 = r-index(p-message," ",70).
      196         if vRindex1 = 0
      197         then
      198            vRindex1 = 70.
      199         if length(p-message)  <= vRindex1 + 70 then do:
      200           assign
      201             v-waitfram-action01 = " "
      202             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      203             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      204           .
      205         end.
      206         else do:
      207           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      208           if vRindex2 <= vRindex1
      209           then
      210              vRindex2 = vRindex1 + 70.
      211           assign
      212             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      213             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      214             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      215           .
      216         end.
      217       end.
      218       B-viewProcInfo:visible   in frame waitfram = no.
      219       B-viewProcInfo:sensitive in frame waitfram = no.
      220       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      221       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      222       if  (   mWaitFramView
      223          or  mWaitProcEvent)
      224          and not mBatchMode
      225       then
      226          display
      227             v-waitfram-action01 skip
      228             v-waitfram-action02 skip
      229             v-waitfram-action03 skip
      230          with frame waitfram .
      231       if     mWaitFramView
      232          then do:
      233             if     mWaitFramInterval ne ?
      234                and not mBatchMode
      235             then
      236                wait-for go of frame waitfram pause mWaitFramInterval.
      237          end.
      238          else
      239             if     mWaitProcEvent
      240                and not mBatchMode
      241             then
      242                process events .
      243     end.
      244   end procedure.
      245      procedure waitfram-show-this:
      246         define input  parameter iInterval as int64 no-undo.
      247         define variable vtime as int64 no-undo.
      248         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      249         mWaitFramInterval = iInterval.
      250         run waitfram-show (substitute("&1&2 &3&4" ,
      251                                       mWaitFramTextBeg ,
      252                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      253                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      254                                       mWaitFramTextEnd
      255                                      )
      256                           ).
      257      end.
      258      procedure WaitFramRunPause:
      259         define input  parameter iInterval as dec no-undo.
      260         define variable vStart  as datetime-tz no-undo.
      261         define variable vend    as datetime-tz no-undo.
      262         define variable vint as int64 no-undo.
      263         define variable vOk as logical no-undo.
      264         vStart = now.
      265         vend   = vStart.
      266         publish "WaitFramPause" (iInterval,output vOk).
      267         vend   =  now.
      268         vint = vend - vStart.
      269         vint = iInterval - vint / 1000.
      270         if     not mWaitFramStop
      271            and (   vint > 0
      272                 or (    not vOk
      273                     and iInterval eq ?
      274                     )
      275                 )
      276         then
      277            run waitfram-show-this (iInterval).
      278         vend   =  now.
      279         vint = vend - vStart.
      280         vint = iInterval - vint / 1000.
      281         if     not mWaitFramStop
      282            and vint > 0
      283         then do:
      284            run gbl/pause.p (vint * 1000).
      285         end.
      286         if iInterval ne ?
      287         then
      288            publish "WaitFramStop".
      289         waitfram-check-timeout().
      290      end.
      291      procedure WaitFramWaitFor:
      292         define input  parameter iInterval as dec no-undo.
      293         assign
      294            mWaitFramStartProc   = now
      295            mWaitFramStopUser    = no
      296            mWaitFramStopTimeOut = no
      297         .
      298         block-wait:
      299         do while not mWaitFramStop:
      300            run WaitFramRunPause (iInterval).
      301            if  waitfram-check-timeout()
      302            then do:
      303               leave block-wait.
      304            end.
      305         end.
      306         run waitfram-hide.
      307      end.
      308   procedure waitfram-join :
      309     define input  parameter p-line-1  as character no-undo .
      310     define input  parameter p-line-2  as character no-undo .
      311     define input  parameter p-line-3  as character no-undo .
      312     define output parameter p-message as character no-undo .
      313     do
      314     on error undo, return error return-value
      315     :
      316       assign
      317         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      318                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      319                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      320       .
      321     end.
      322   end procedure.
      323   function waitfram-join-function returns character
      324     (input p-line-1 as character
      325     ,input p-line-2 as character
      326     ,input p-line-3 as character
      327     ).
      328     define variable v-message as character no-undo .
      329     run waitfram-join in this-procedure
      330       (input  p-line-1
      331       ,input  p-line-2
      332       ,input  p-line-3
      333       ,output v-message
      334       ) .
      335     return v-message .
      336   end function .
      337   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      338   procedure cur-time :
      339      define output parameter p-today as date      no-undo .
      340      define output parameter p-time  as integer   no-undo .
      341     do
      342     on error undo, return error
      343     :
      344       define variable v-date1 as date      no-undo .
      345       define variable v-date2 as date      no-undo .
      346       define variable v-time  as integer   no-undo .
      347       assign
      348         v-date1 = today
      349         v-time  = time
      350         v-date2 = today
      351       .
      352       if v-date1 <> v-date2
      353       then do:
      354         assign
      355           v-date1 = today
      356           v-time  = v-time
      357         .
      358       end.
      359       assign
      360         p-today = v-date1
      361         p-time  = v-time
      362       .
      363     end.
      364   end.
      365   function cur-time-date returns character
      366   :
      367     return string(today, '99/99/9999':U) .
      368   end.
      369   function cur-time-mjd returns decimal
      370   :
      371     define variable v-date as date      no-undo .
      372     define variable v-time as integer   no-undo .
      373     run cur-time in this-procedure
      374       (output v-date
      375       ,output v-time
      376       ) .
      377     return integer(v-date) - 2400002 + (v-time / 86400) .
      378   end.
      379   function cur-time-get-ending-index returns integer
      380   (input p-number as integer
      381   )
      382   :
      383     if p-number < 0
      384     or p-number = ?
      385     then do:
      386       return 1 .
      387     end.
      388     define variable v-rest as integer   no-undo .
      389     assign
      390       p-number = p-number modulo 100
      391     .
      392     if p-number < 20
      393     then do:
      394       assign
      395         v-rest = p-number
      396       .
      397     end.
      398     else do:
      399       assign
      400         v-rest = p-number modulo 10
      401       .
      402     end.
      403     case v-rest :
      404       when 1
      405       then do:
      406         return 2 .
      407       end.
      408       when 2 or
      409       when 3 or
      410       when 4
      411       then do:
      412         return 3 .
      413       end.
      414       otherwise do:
      415         return 1 .
      416       end.
      417     end case .
      418   end.
      419   procedure cur-time-mjd-to-date :
      420      define input  parameter i-mjd-diff as decimal no-undo.
      421      define output parameter o-Date     as date    no-undo.
      422      define output parameter o-Time     as integer no-undo.
      423      define variable v-day-number as integer   no-undo .
      424      if    i-mjd-diff < 0
      425         or i-mjd-diff = ?
      426      then do:
      427         return "?" .
      428      end.
      429      assign
      430         v-day-number = truncate(i-mjd-diff,0).
      431         o-Date = date(v-day-number + 2400002).
      432         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      433     .
      434   end.
      435   function cur-time-mjd-to-string returns character
      436   (input p-mjd-diff as decimal
      437   )
      438   :
      439     define variable v-day-number as integer   no-undo .
      440     define variable v-seconds    as integer   no-undo .
      441     define variable v-hour       as integer   no-undo .
      442     define variable v-min        as integer   no-undo .
      443     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      444     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      445     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      446     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      447     if p-mjd-diff < 0
      448     or p-mjd-diff = ?
      449     then do:
      450       return "?" .
      451     end.
      452     assign
      453       v-day-number = integer(truncate(p-mjd-diff,0))
      454       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      455     .
      456     if v-seconds > 86400
      457     then do:
      458       assign
      459         v-seconds = 86400 - 1
      460       .
      461     end.
      462     if v-seconds < 0
      463     then do:
      464       assign
      465         v-seconds = 0
      466       .
      467     end.
      468     assign
      469       v-hour = truncate(v-seconds / 3600, 0)
      470     .
      471     assign
      472       v-seconds = v-seconds modulo 3600
      473     .
      474     assign
      475       v-min = truncate(v-seconds / 60, 0)
      476     .
      477     assign
      478       v-seconds = v-seconds modulo 60
      479     .
      480     return
      481         (if v-day-number <> 0
      482           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      483           else ""
      484         )
      485       + (if v-day-number <> 0 or v-hour <> 0
      486           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      487           else ""
      488         )
      489       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      490           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      491           else ""
      492         )
      493       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      494       .
      495   end.
      496   function cur-time-string returns character
      497   :
      498     define variable v-date as date      no-undo .
      499     define variable v-time as integer   no-undo .
      500     run cur-time in this-procedure
      501       (output v-date
      502       ,output v-time
      503       ) .
      504     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      505   end.
      506   function cur-time-string-sec returns character
      507   :
      508     define variable v-date as date      no-undo .
      509     define variable v-time as integer   no-undo .
      510     run cur-time in this-procedure
      511       (output v-date
      512       ,output v-time
      513       ) .
      514     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      515   end.
      516   function cur-time-custom  returns character
      517   (input p-prefix as character
      518   ,input p-date-format as character
      519   ,input p-delimiter as character
      520   ,input p-time-format as character
      521   ,input p-suffix as character
      522   )
      523   :
      524     define variable v-date as date      no-undo .
      525     define variable v-time as integer   no-undo .
      526     run cur-time in this-procedure
      527       (output v-date
      528       ,output v-time
      529       ) .
      530     return
      531       p-prefix
      532       + string(v-date, p-date-format)
      533       + p-delimiter
      534       + string(v-time, p-time-format)
      535       + p-suffix
      536       .
      537   end.
      538   function cur-time-print  returns character
      539   :
      540     define variable v-date as date      no-undo .
      541     define variable v-time as integer   no-undo .
      542     run cur-time in this-procedure
      543       (output v-date
      544       ,output v-time
      545       ) .
      546     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      547   end.
      548   function cur-time-datetime returns datetime
      549   :
      550     define variable v-char as character no-undo .
      551     define variable v-datetime as datetime no-undo .
      552     v-char = cur-time-string().
      553     v-datetime = datetime(v-char).
      554     return  v-datetime.
      555   end.
      556   function cur-time-string-msec returns character
      557   :
      558     define variable v-date as datetime  no-undo .
      559     v-date = now.
      560     return string(v-date) .
      561   end.
      562   define variable counter    as integer   no-undo .
      563   define variable rec-full   as character no-undo .
      564   define variable v-rec-name as character no-undo .
      565   define variable v-today    as date      no-undo .
      566   define variable v-time     as integer   no-undo .
      567   define temp-table buf_temp-PDF no-undo like ub.price-doc-forming.
      568   do
      569   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      570   on stop   undo, return error substitute( "&1. stop", vss-workfile )
      571   on endkey undo, return error substitute( "&1. endkey", vss-workfile )
      572   :
      573     do counter = 1 to p-counter
      574     on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      575     on stop   undo, return error substitute( "&1. stop", vss-workfile )
      576     on endkey undo, return error substitute( "&1. endkey", vss-workfile )
      577     :
      578       if counter modulo 10 = 0
      579       then do:
      580         run waitfram-show in this-procedure
      581           (input substitute("Получение изменений шапки накладной Получено &1", counter)
      582           ) .
      583       end.
      584       run nws-imps in p-imp-handle
      585         ( input-output counter
      586          ,output       rec-full
      587         ) no-error.
      588       if error-status :error then do:
      589         return error return-value .
      590       end.
      591       assign
      592         v-rec-name = entry( 1, rec-full, chr(1) )
      593       .
      594       CASE entry(1, v-rec-name, chr(4)) :
      595         when 'price-doc-forming':U
      596         then do:
      597           create buf_temp-PDF .
      598           run nws-impl in p-imp-handle
      599             ( input 'price-doc-forming':U
      600              ,input (buffer buf_temp-PDF:handle)
      601             ) no-error.
      602           if error-status :error then do:
      603             return error return-value .
      604           end.
      605         end.
      606         otherwise do:
      607           message
      608             vss-workfile vss-revision vss-description skip
      609             "Не предусмотрен прием таблицы " v-rec-name skip
      610             view-as alert-box error .
      611           return error .
      612         end.
      613       end case.
      614     end.
      615     run waitfram-hide .
      616     define variable v-ind as integer   no-undo .
      617     do transaction
      618     on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      619     on stop   undo, return error substitute( "&1. stop", vss-workfile )
      620     on endkey undo, return error substitute( "&1. endkey", vss-workfile )
      621     :
      622     define buffer buf_price-doc-forming for ub.price-doc-forming  .
      623      for each buf_temp-PDF where
      624               buf_temp-PDF.pdf-id     = p-par1 AND
      625               buf_temp-PDF.pdf-db     = p-par2 AND
      626               buf_temp-PDF.plt-id     = p-par3 AND
      627               buf_temp-PDF.plt-db-num = p-par4
      628               :
      629          find first buf_price-doc-forming exclusive-lock
      630                 where
      631                 buf_price-doc-forming.pdf-id     = p-par1 AND
      632                 buf_price-doc-forming.pdf-db     = p-par2 AND
      633                 buf_price-doc-forming.plt-id     = p-par3 AND
      634                 buf_price-doc-forming.plt-db-num = p-par4
      635                 no-error .
      636                   if  not available buf_price-doc-forming then do:
      637                       return  .
      638                   end.
      639                   case p-type :
      640                     when "status" then do:
      641                         assign
      642                           buf_price-doc-forming.stts = buf_temp-PDF.stts
      643                         .
      644                     end .
      645                     otherwise do:
      646                       message "Неизвестный тип команды" p-type .
      647                     end.
      648                   end case.
      649       end.
      650      end.
      651   end.
