     2161         then do:
     2162           if valid-handle(v_dataseth) then do:                    run gate-clear in this-procedure ( input v_dataseth                                                     , input (buffer buf_temp-xml-tables:handle)).                   end.
     2163           return error substitute( "&1. ошибка при вызове процедуры cmdsndgd.p! &2&3&2&4", vss-workfile, chr(10), return-value, error-status :get-message( error-status :num-messages )  ).
     2164         end.
     2165       end.
     2166       when 'cmd-transfer-goods':U
     2167       then do:
     2168         assign
