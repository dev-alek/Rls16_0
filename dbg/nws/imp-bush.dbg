     2455           return error substitute( "&1. ошибка при вызове процедуры cmd-dct.p! &2&3&2&4", vss-workfile, chr(10), return-value, error-status :get-message( error-status :num-messages )  ).
     2456         end.
     2457       end.
     2458       when 'cmd-rum-send':U
     2459       then do:
     2460         define variable v-uniq-key-rec as character no-undo .
     2461         v-uniq-key-rec = str-decode(entry(2, p-full-cmd, chr(6))
     2462                                    ,"").
     2463         run nws/cmd-rum.p
     2464           ( input auto-window-h
     2465            ,input this-procedure:handle
     2466            ,input this-procedure:handle
     2467            ,input p-imp-handle
     2468            ,input v-uniq-key-rec
     2469            ,input p-counter
     2470           ) no-error .
     2471         if error-status :error
     2472         then do:
     2473           if valid-handle(v_dataseth) then do:                    run gate-clear in this-procedure ( input v_dataseth                                                     , input (buffer buf_temp-xml-tables:handle)).                   end.
     2474           return error substitute( "&1. ошибка при вызове процедуры cmd-rum.p! &2&3&2&4", vss-workfile, chr(10), return-value, error-status :get-message( error-status :num-messages )  ).
     2475         end.
     2476       end.
     2477       when 'cmd-nws2esys-general':U
     2478       then do:
     2479         define variable v-esys-id as integer no-undo .
     2480         define variable v-db-num-exp as integer no-undo .
     2481         define variable v-esys-uniq-gate-rec as character no-undo .
     2482         assign
     2483         v-esys-id = integer(entry(2, p-full-cmd, chr(6)))
     2484         v-db-num-exp = integer(entry(3, p-full-cmd, chr(6)))
     2485         v-esys-uniq-gate-rec = str-decode(entry(4, p-full-cmd, chr(6)) , '')
     2486         .
     2487         run nws/cmdnw2es.p
     2488           ( input auto-window-h
     2489            ,input this-procedure:handle
     2490            ,input this-procedure:handle
     2491            ,input p-imp-handle
     2492            ,input v-esys-id
     2493            ,input v-db-num-exp
     2494            ,input p-uniq-gate-rec
     2495            ,input v-esys-uniq-gate-rec
     2496            ,input p-counter
     2497           ) no-error .
     2498         if error-status :error
     2499         then do:
     2500           if valid-handle(v_dataseth) then do:                    run gate-clear in this-procedure ( input v_dataseth                                                     , input (buffer buf_temp-xml-tables:handle)).                   end.
     2501           return error substitute( "&1. ошибка при вызове процедуры cmdnw2es.p! &2&3&2&4", vss-workfile, chr(10), return-value, error-status :get-message( error-status :num-messages )  ).
     2502         end.
     2503       end.
     2504       when 'cmd-chg-utd-sts':U
     2505       then do:
     2506         define buffer buf_utd for ub.utd.
     2507         define variable v-db-num-utd   as integer   no-undo .
     2508         define variable v-doc-id       as integer   no-undo .
     2509         define variable v-sts          as integer   no-undo .
     2510         define variable v-sts-edi      as integer   no-undo .
     2511         define variable v-trn-doc-code as character no-undo .
     2512   def var objSrv as class ibs.th.gbl.sys.objsrv no-undo.
     2513   run gbl/getobjsrvhndl.p (input-output ObjSrv).
     2514         assign
     2515           v-db-num-utd = integer (entry( 2, p-full-cmd, chr(6) ))
     2516           v-doc-id     = integer (entry( 3, p-full-cmd, chr(6) ))
     2517           v-sts        = integer (entry( 4, p-full-cmd, chr(6) ))
     2518           v-sts-edi    = integer (entry( 5, p-full-cmd, chr(6) ))
     2519           v-doc-code   = (entry( 6, p-full-cmd, chr(6) ))
     2520         no-error.
     2521         if error-status:error
     2522           then
     2523         do:
     2524           if valid-handle(v_dataseth) then do:                    run gate-clear in this-procedure ( input v_dataseth                                                     , input (buffer buf_temp-xml-tables:handle)).                   end.
     2525           return error substitute( "&1. ошибка при обработке комманды на изменения статуса УТД! &2&3&2&4", vss-workfile, chr(10), return-value, error-status :get-message( error-status :num-messages )  ).
     2526         end.
     2527         find first buf_utd exclusive-lock where buf_utd.db-num = v-db-num-utd
     2528           and buf_utd.doc-id = v-doc-id no-error.
     2529         if not available (buf_utd)
     2530           then
     2531         do:
     2532           if valid-handle(v_dataseth) then do:                    run gate-clear in this-procedure ( input v_dataseth                                                     , input (buffer buf_temp-xml-tables:handle)).                   end.
     2533           return error substitute( "&1. ошибка при обработке комманды на изменения статуса УТД! &2&3&2&4", vss-workfile, chr(10), return-value, error-status :get-message( error-status :num-messages )  ).
     2534         end.
     2535         assign
     2536           buf_utd.sts = v-sts
     2537           buf_utd.sts-edi = v-sts-edi
     2538           buf_utd.doc-code = v-trn-doc-code
     2539         .
     2540       end.
     2541       otherwise do:
     2542         if valid-handle(v_dataseth) then do:                    run gate-clear in this-procedure ( input v_dataseth                                                     , input (buffer buf_temp-xml-tables:handle)).                   end.
     2543         return error substitute( "&1. Нет обработки команды &2", vss-workfile, v-command ).
     2544       end.
     2545     end case.
     2546     if valid-handle(v_dataseth) then do:                    run gate-clear in this-procedure ( input v_dataseth                                                     , input (buffer buf_temp-xml-tables:handle)).                   end.
     2547   end.
     2548   procedure cmd-imp-rec-without-trg :
     2549     define input parameter p-imp-handle as handle    no-undo .
     2550     define input parameter p-counter    as integer   no-undo .
     2551     do
     2552     on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2553     on stop   undo, return error substitute( "&1. stop", vss-workfile )
     2554     on endkey undo, return error substitute( "&1. endkey", vss-workfile )
     2555     :
     2556       define variable counter    as integer   no-undo .
     2557       define variable rec-full   as character no-undo .
     2558       define variable v-rec-name as character no-undo .
     2559       define variable v-key-rec  as character no-undo .
     2560       do counter = 1 to p-counter
     2561       on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2562       on stop   undo, return error substitute( "&1. stop", vss-workfile )
     2563       on endkey undo, return error substitute( "&1. endkey", vss-workfile )
     2564       :
     2565         if counter modulo 10 = 0
     2566         then do:
     2567           run waitfram-show in this-procedure
     2568             (input substitute("Загрузка записей с отключением триггеров. Получено записей &1", counter)
     2569             ) .
     2570         end.
     2571         run nws-imps in p-imp-handle
     2572           ( input-output counter
     2573            ,output       rec-full
     2574           ) no-error.
     2575         if error-status :error then do:
     2576           return error return-value .
     2577         end.
     2578         assign
     2579           v-rec-name = entry( 1, rec-full, chr(1) )
     2580           v-key-rec  = entry( 3, rec-full, chr(1) )
     2581         .
     2582         run nws/cmd-itrg.p
     2583           ( input p-imp-handle
     2584            ,input this-procedure :handle
     2585            ,input v-key-rec
     2586            ,input v-rec-name
     2587           )
     2588           no-error .
     2589         if error-status :error
     2590         then do:
     2591           return error substitute( "&1. ошибка при вызове процедуры cmdintrg.p! &2&3&2&4", vss-workfile, chr(10), return-value, error-status :get-message( error-status :num-messages )  ).
     2592         end.
     2593       end.
     2594       run waitfram-hide .
     2595     end.
     2596   end procedure.
     2597   procedure cmd-del-rec-without-trg :
     2598     define input parameter p-imp-handle as handle    no-undo .
     2599     define input parameter p-counter    as integer   no-undo .
     2600     do
     2601     on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2602     on stop   undo, return error substitute( "&1. stop", vss-workfile )
     2603     on endkey undo, return error substitute( "&1. endkey", vss-workfile )
     2604     :
     2605       define variable counter    as integer   no-undo .
     2606       define variable rec-full   as character no-undo .
     2607       define variable v-rec-name as character no-undo .
     2608       define variable v-key-rec  as character no-undo .
     2609       do counter = 1 to p-counter
     2610       on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2611       on stop   undo, return error substitute( "&1. stop", vss-workfile )
     2612       on endkey undo, return error substitute( "&1. endkey", vss-workfile )
     2613       :
     2614         if counter modulo 10 = 0
     2615         then do:
     2616           run waitfram-show in this-procedure
     2617             (input substitute("Удаление записей с отключением триггеров. Удаляется записей &1", counter)
     2618             ) .
     2619         end.
     2620         run nws-imps in p-imp-handle
     2621           ( input-output counter
     2622            ,output       rec-full
     2623           ) no-error.
     2624         if error-status :error then do:
     2625           return error return-value .
     2626         end.
     2627         assign
     2628           v-rec-name = entry( 1, rec-full, chr(1) )
     2629           v-key-rec  = entry( 3, rec-full, chr(1) )
     2630         .
     2631         run nws/cmd-dtrg.p
     2632           ( input p-imp-handle
     2633            ,input this-procedure :handle
     2634            ,input v-key-rec
     2635            ,input v-rec-name
     2636           )
     2637           no-error .
     2638         if error-status :error
     2639         then do:
     2640           return error substitute( "&1. ошибка при вызове процедуры cmd-dtrg.p! &2&3&2&4", vss-workfile, chr(10), return-value, error-status :get-message( error-status :num-messages )  ).
     2641         end.
     2642       end.
     2643       run waitfram-hide .
     2644     end.
     2645   end procedure.
