     2170           v-obj-code = integer(entry( 3, p-full-cmd, chr(6) ))
     2171         .
     2172         run nws/cmdcmpgd.p
     2173           ( input p-imp-handle
     2174            ,input p-counter
     2175            ,input v-obj-type
     2176            ,input v-obj-code
     2177           ) no-error .
     2178         if error-status :error
     2179         then do:
     2180           if valid-handle(v_dataseth) then do:                    run gate-clear in this-procedure ( input v_dataseth                                                     , input (buffer buf_temp-xml-tables:handle)).                   end.
     2181           return error substitute( "&1. ошибка при вызове процедуры cmdcmpgd.p! &2&3&2&4", vss-workfile, chr(10), return-value, error-status :get-message( error-status :num-messages )  ).
     2182         end.
