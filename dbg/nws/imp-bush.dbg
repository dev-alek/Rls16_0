        1   block-level on error undo, throw.
        2   define input  parameter p-imp-handle as handle    no-undo .
        3   define input  parameter p-full-cmd   as character no-undo .
        4   define input  parameter p-uniq-gate-rec as character no-undo .
        5   define input  parameter p-counter    as integer   no-undo .
        6   define input  parameter p-db-source  as integer   no-undo .
        7   define variable vss-revision    as character no-undo init "$Revision: f29df1d5f130, 3104, rls $":U .
        8   define variable vss-author      as character no-undo init "$Author: DRuban $":U .
        9   define variable vss-date        as character no-undo init "$Date: Вт авг 09 09:15:01 2022 +0300 $":U .
       10   define variable vss-workfile    as character no-undo init "$Workfile: imp-bush.p $":U .
       11   define variable vss-archive     as character no-undo init "$Archive: nws/imp-bush.p $":U .
       12   define variable vss-description as character no-undo init "Прием кустовых команд".
       13   procedure vss-get-info :
       14     define output parameter p-vss-revision    like vss-revision    no-undo .
       15     define output parameter p-vss-author      like vss-author      no-undo .
       16     define output parameter p-vss-date        like vss-date        no-undo .
       17     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       18     define output parameter p-vss-archive     like vss-archive     no-undo .
       19     define output parameter p-vss-description like vss-description no-undo .
       20     assign
       21       p-vss-revision    = vss-revision
       22       p-vss-author      = vss-author
       23       p-vss-date        = vss-date
       24       p-vss-workfile    = vss-workfile
       25       p-vss-archive     = vss-archive
       26       p-vss-description = vss-description
       27     .
       28   end procedure.
       29   procedure vss-get-parameters :
       30     define output parameter p-vss-parameters as character no-undo .
       31       assign
       32         p-vss-parameters = substitute('&1|&2|&3':u,p-full-cmd,p-counter,p-db-source)
       33       .
       34   end procedure.
       35   define new global shared variable g#vssrevis-logger as handle    no-undo .
       36   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       37   define variable v-vssrevis-logger                   as handle    no-undo .
       38   procedure vss-logevent :
       39     define input  parameter p-extra-paramters as character no-undo .
       40     define variable v-vssrevis-parameters as character no-undo .
       41     do
       42     on error undo, return error return-value
       43     :
       44       if  valid-handle(v-vssrevis-logger)
       45       and v-vssrevis-logger :get-signature("logevent") <> ""
       46       then do:
       47         run vss-get-parameters in this-procedure
       48           (output v-vssrevis-parameters
       49           ).
       50         run logevent in v-vssrevis-logger
       51           (input vss-workfile
       52           ,input vss-revision
       53           ,input v-vssrevis-parameters
       54           ,input p-extra-paramters
       55           ).
       56       end.
       57     end.
       58   end procedure.
       59   assign
       60     v-vssrevis-logger = g#vssrevis-logger
       61   .
       62   if  valid-handle(v-vssrevis-logger)
       63   and v-vssrevis-logger :get-signature("logevent") <> ""
       64   then do:
       65     assign
       66       v-vssrevis-logevent = true
       67     .
       68     run vss-logevent in this-procedure (input vss-description) .
       69   end.
       70   define new global shared variable g#language as character no-undo .
       71   if g#language <> '' and g#language <> 'rus':U then do:
       72     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       73   end.
       74   define new global shared variable g#library  as handle no-undo .
       75   define new global shared variable g#library2 as handle no-undo .
       76   define   shared variable g#auto as logical no-undo.
       77   define   shared variable g#news as logical no-undo.
       78   define   shared variable g#oxml as logical no-undo.
       79   define   shared variable g#esys as logical no-undo.
       80   define   shared variable g#news-source-db as integer no-undo.
       81   define   shared variable g#esys-source-esys as integer no-undo.
       82   define   shared variable g#db-num as integer   no-undo .
       83   define   shared variable g#userid as character no-undo .
       84   define   shared variable g#passwd as character no-undo .
       85   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       86   define  shared variable g#auto-pid           as integer   no-undo .
       87   define  shared variable conn-par             as character no-undo .
       88   define  shared variable g#auto-user-id       as character no-undo .
       89   define  shared variable g#auto-user-login    as character no-undo .
       90   define  shared variable g#auto-user-password as character no-undo .
       91   define  shared variable v-socket             as logical   no-undo .
       92   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       93   define  shared variable auto-window-h     as handle    no-undo .
       94   define  shared variable auto-log-msg-h    as handle    no-undo .
       95   define  shared variable hand-log-msg-h    as handle    no-undo .
       96   define  shared variable log-file-name     as character no-undo initial ? .
       97   define  shared variable add-log-file-name as character no-undo initial ? .
       98   define  shared variable writelogvalue     as character no-undo initial ? .
       99   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      100   procedure cur-time :
      101      define output parameter p-today as date      no-undo .
      102      define output parameter p-time  as integer   no-undo .
      103     do
      104     on error undo, return error
      105     :
      106       define variable v-date1 as date      no-undo .
      107       define variable v-date2 as date      no-undo .
      108       define variable v-time  as integer   no-undo .
      109       assign
      110         v-date1 = today
      111         v-time  = time
      112         v-date2 = today
      113       .
      114       if v-date1 <> v-date2
      115       then do:
      116         assign
      117           v-date1 = today
      118           v-time  = v-time
      119         .
      120       end.
      121       assign
      122         p-today = v-date1
      123         p-time  = v-time
      124       .
      125     end.
      126   end.
      127   function cur-time-date returns character
      128   :
      129     return string(today, '99/99/9999':U) .
      130   end.
      131   function cur-time-mjd returns decimal
      132   :
      133     define variable v-date as date      no-undo .
      134     define variable v-time as integer   no-undo .
      135     run cur-time in this-procedure
      136       (output v-date
      137       ,output v-time
      138       ) .
      139     return integer(v-date) - 2400002 + (v-time / 86400) .
      140   end.
      141   function cur-time-get-ending-index returns integer
      142   (input p-number as integer
      143   )
      144   :
      145     if p-number < 0
      146     or p-number = ?
      147     then do:
      148       return 1 .
      149     end.
      150     define variable v-rest as integer   no-undo .
      151     assign
      152       p-number = p-number modulo 100
      153     .
      154     if p-number < 20
      155     then do:
      156       assign
      157         v-rest = p-number
      158       .
      159     end.
      160     else do:
      161       assign
      162         v-rest = p-number modulo 10
      163       .
      164     end.
      165     case v-rest :
      166       when 1
      167       then do:
      168         return 2 .
      169       end.
      170       when 2 or
      171       when 3 or
      172       when 4
      173       then do:
      174         return 3 .
      175       end.
      176       otherwise do:
      177         return 1 .
      178       end.
      179     end case .
      180   end.
      181   procedure cur-time-mjd-to-date :
      182      define input  parameter i-mjd-diff as decimal no-undo.
      183      define output parameter o-Date     as date    no-undo.
      184      define output parameter o-Time     as integer no-undo.
      185      define variable v-day-number as integer   no-undo .
      186      if    i-mjd-diff < 0
      187         or i-mjd-diff = ?
      188      then do:
      189         return "?" .
      190      end.
      191      assign
      192         v-day-number = truncate(i-mjd-diff,0).
      193         o-Date = date(v-day-number + 2400002).
      194         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      195     .
      196   end.
      197   function cur-time-mjd-to-string returns character
      198   (input p-mjd-diff as decimal
      199   )
      200   :
      201     define variable v-day-number as integer   no-undo .
      202     define variable v-seconds    as integer   no-undo .
      203     define variable v-hour       as integer   no-undo .
      204     define variable v-min        as integer   no-undo .
      205     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      206     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      207     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      208     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      209     if p-mjd-diff < 0
      210     or p-mjd-diff = ?
      211     then do:
      212       return "?" .
      213     end.
      214     assign
      215       v-day-number = integer(truncate(p-mjd-diff,0))
      216       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      217     .
      218     if v-seconds > 86400
      219     then do:
      220       assign
      221         v-seconds = 86400 - 1
      222       .
      223     end.
      224     if v-seconds < 0
      225     then do:
      226       assign
      227         v-seconds = 0
      228       .
      229     end.
      230     assign
      231       v-hour = truncate(v-seconds / 3600, 0)
      232     .
      233     assign
      234       v-seconds = v-seconds modulo 3600
      235     .
      236     assign
      237       v-min = truncate(v-seconds / 60, 0)
      238     .
      239     assign
      240       v-seconds = v-seconds modulo 60
      241     .
      242     return
      243         (if v-day-number <> 0
      244           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      245           else ""
      246         )
      247       + (if v-day-number <> 0 or v-hour <> 0
      248           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      249           else ""
      250         )
      251       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      252           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      253           else ""
      254         )
      255       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      256       .
      257   end.
      258   function cur-time-string returns character
      259   :
      260     define variable v-date as date      no-undo .
      261     define variable v-time as integer   no-undo .
      262     run cur-time in this-procedure
      263       (output v-date
      264       ,output v-time
      265       ) .
      266     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      267   end.
      268   function cur-time-string-sec returns character
      269   :
      270     define variable v-date as date      no-undo .
      271     define variable v-time as integer   no-undo .
      272     run cur-time in this-procedure
      273       (output v-date
      274       ,output v-time
      275       ) .
      276     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      277   end.
      278   function cur-time-custom  returns character
      279   (input p-prefix as character
      280   ,input p-date-format as character
      281   ,input p-delimiter as character
      282   ,input p-time-format as character
      283   ,input p-suffix as character
      284   )
      285   :
      286     define variable v-date as date      no-undo .
      287     define variable v-time as integer   no-undo .
      288     run cur-time in this-procedure
      289       (output v-date
      290       ,output v-time
      291       ) .
      292     return
      293       p-prefix
      294       + string(v-date, p-date-format)
      295       + p-delimiter
      296       + string(v-time, p-time-format)
      297       + p-suffix
      298       .
      299   end.
      300   function cur-time-print  returns character
      301   :
      302     define variable v-date as date      no-undo .
      303     define variable v-time as integer   no-undo .
      304     run cur-time in this-procedure
      305       (output v-date
      306       ,output v-time
      307       ) .
      308     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      309   end.
      310   function cur-time-datetime returns datetime
      311   :
      312     define variable v-char as character no-undo .
      313     define variable v-datetime as datetime no-undo .
      314     v-char = cur-time-string().
      315     v-datetime = datetime(v-char).
      316     return  v-datetime.
      317   end.
      318   function cur-time-string-msec returns character
      319   :
      320     define variable v-date as datetime  no-undo .
      321     v-date = now.
      322     return string(v-date) .
      323   end.
      324   define stream LogStream .
      325   define variable mNoTime as logical no-undo.
      326   procedure write-to-log-notime :
      327     define input param i-str as character no-undo .
      328     mNoTime = yes.
      329     run write-to-log (i-str).
      330     mNoTime = no.
      331   end.
      332   procedure write-to-log :
      333     define input param p-str as character no-undo .
      334     do
      335     on error  undo, return error substitute( "&1 (write-to-log). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      336     on stop   undo, return error substitute( "&1 (write-to-log). stop", vss-workfile )
      337     on endkey undo, return error substitute( "&1 (write-to-log). endkey", vss-workfile )
      338     :
      339       define variable log-res        as logical   no-undo .
      340       define variable v-jj           as integer   no-undo .
      341       if    mNoTime
      342          or writelogvalue eq "AsyncProc"
      343       then
      344          p-str = substitute( "&1 (pid: &2) &3&4"   , g#auto-user-id, g#auto-pid,                        p-str, chr(10) ).
      345       else
      346          p-str = substitute( "&1 (pid: &2) &3 &4&5", g#auto-user-id, g#auto-pid, cur-time-string-sec(), p-str, chr(10) ).
      347       if auto-log-msg-h <> ? then do:
      348         log-res = auto-log-msg-h:move-to-eof( ) .
      349         log-res = auto-log-msg-h:insert-string( p-str ).
      350       end.
      351       if hand-log-msg-h <> ? then do:
      352         log-res = hand-log-msg-h:move-to-eof( ) .
      353         log-res = hand-log-msg-h:insert-string( p-str ).
      354       end.
      355       assign
      356         p-str = replace(p-str, (chr(10) + chr(13)), chr(10) )
      357         p-str = replace(p-str, (chr(13) + chr(10)), chr(10) )
      358         p-str = replace(p-str, chr(10), (chr(13) + chr(10)) )
      359       .
      360       if add-log-file-name <> ? then do:
      361         do v-jj = 1 to num-entries(add-log-file-name, chr(1)):
      362           run gbl/fileapnd.p
      363             ( input entry(v-jj, add-log-file-name, chr(1) )
      364             ,input p-str
      365             ,input 20
      366             ) no-error .
      367           if error-status:error then do:
      368             return error return-value .
      369           end.
      370         end.
      371       end.
      372       if writelogvalue eq "AsyncProc"
      373       then do:
      374          p-str = trim(p-str, (chr(13) + chr(10)) )
      375       .
      376          Publish "WriteLogAsunc" (p-str,yes).
      377       end.
      378       else if writelogvalue <> "yes" then do:
      379         run gbl/fileapnd.p
      380           ( input log-file-name
      381           ,input p-str
      382           ,input 20
      383           ) no-error .
      384         if error-status:error then do:
      385           return error return-value .
      386         end.
      387       end.
      388     end.
      389   end procedure.
      390   procedure write-to-screen :
      391     define input param p-str as character no-undo .
      392     do
      393     on error  undo, return error substitute( "&1 (write-to-screen). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      394     on stop   undo, return error substitute( "&1 (write-to-screen). stop", vss-workfile )
      395     on endkey undo, return error substitute( "&1 (write-to-screen). endkey", vss-workfile )
      396     :
      397       define variable log-res as logical no-undo.
      398       assign
      399         p-str = substitute( "&1 (pid: &2) &3 &4&5", g#auto-user-id, g#auto-pid, cur-time-string-sec(), p-str, chr(10) )
      400       .
      401       if auto-log-msg-h <> ?
      402       then do:
      403         log-res = auto-log-msg-h:move-to-eof( ) .
      404         log-res = auto-log-msg-h:insert-string( p-str ).
      405       end.
      406       if hand-log-msg-h <> ?
      407       then do:
      408         log-res = hand-log-msg-h:move-to-eof( ) .
      409         log-res = hand-log-msg-h:insert-string( p-str ).
      410       end.
      411     end.
      412   end procedure.
      413   procedure send-msg-to-email :
      414     define input  parameter p-subject      as character no-undo .
      415     define input  parameter p-text-err     as character no-undo .
      416     define input  parameter p-attach-files as character no-undo .
      417     do
      418     on error  undo, return error substitute( "&1 (send-msg-to-email). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      419     on stop   undo, return error substitute( "&1 (send-msg-to-email). stop", vss-workfile )
      420     on endkey undo, return error substitute( "&1 (send-msg-to-email). endkey", vss-workfile )
      421     :
      422       define variable v-tth             as handle    no-undo .
      423       define variable v-value-character as character no-undo .
      424       define variable v-value-date      as date      no-undo .
      425       define variable v-value-decimal   as decimal   no-undo .
      426       define variable v-value-integer   as integer   no-undo .
      427       define variable v-value-logical   as logical   no-undo .
      428       define variable v-param-type      as character no-undo .
      429       define variable v-email       as character no-undo .
      430       define variable v-tmp-str     as character no-undo .
      431       define variable v-tmp1-str    as character no-undo .
      432       define variable v-ind         as integer   no-undo .
      433       define variable v-num-entries as integer   no-undo .
      434       delete object v-tth no-error.
      435       run adm/shattri.p
      436         ( input "get":U
      437          ,input  "":U
      438          ,input  0
      439          ,input  'auto-task':U
      440          ,input  'send-msg-to-email':U
      441          ,output v-value-character
      442          ,output v-value-date
      443          ,output v-value-decimal
      444          ,output v-value-integer
      445          ,output v-value-logical
      446          ,output v-param-type
      447          ,input-output table-handle v-tth
      448         ) no-error .
      449       if not error-status :error  then do:
      450         assign
      451           v-tmp-str = v-value-character
      452         .
      453       end.
      454       delete object v-tth no-error.
      455       assign
      456         v-tmp-str     = replace(v-tmp-str, (chr(10) + chr(13)), chr(44) )
      457         v-tmp-str     = replace(v-tmp-str, (chr(13) + chr(10)), chr(44) )
      458         v-tmp-str     = replace(v-tmp-str, chr(10), chr(44) )
      459         v-num-entries = num-entries( v-tmp-str, chr(44) )
      460         v-email       = "":U
      461       .
      462       do v-ind = 1 to v-num-entries
      463       :
      464         assign
      465           v-tmp1-str = entry( v-ind, v-tmp-str, chr(44) )
      466         .
      467         if trim( v-tmp1-str ) <> "":U then do:
      468           if v-email = "":U then do:
      469             assign
      470               v-email = v-tmp1-str
      471             .
      472           end.
      473           else do:
      474             assign
      475               v-email = v-email + chr(44) + v-tmp1-str
      476             .
      477           end.
      478         end.
      479       end.
      480       if v-email <> "":U then do:
      481         run gbl/sendmail.p
      482           ( input v-email
      483           , input p-subject
      484           , input p-text-err
      485           , input p-attach-files
      486           ) no-error .
      487         if error-status :error
      488           or return-value <> "":U
      489         then do:
      490           return error substitute( "&1 (send-msg-to-email). &2", vss-workfile, return-value ) .
      491         end.
      492       end.
      493     end.
      494   end procedure.
      495   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      496   define variable v-loc-counter as integer no-undo .
      497   define variable v-counter-visible as logical no-undo .
      498   define variable v-view-log as logical no-undo .
      499   define stream auto2dia.
      500   PROCEDURE write-log-and-file :
      501   do
      502   on error undo, return error
      503   :
      504     define input parameter p-tab-position   as integer   no-undo.
      505     define input parameter p-file-name      as character no-undo .
      506     define input parameter p-log-level      as integer   no-undo .
      507     define input parameter p-log-string     AS CHARacter NO-UNDO.
      508     define variable v-jj as integer   no-undo .
      509     run write-to-screen in this-procedure( input ( fill( chr(32), p-tab-position) + p-log-string)) .
      510     if p-file-name <> '':U then do:
      511       do v-jj = 1 to num-entries(p-file-name, chr(1)):
      512         run  auto2dia-writefile in this-procedure (
      513                                         input entry(v-jj, p-file-name, chr(1))
      514                                         ,input p-log-level
      515                                         ,input (p-log-string + chr(10))
      516                                       ) no-error .
      517       end.
      518     end.
      519     if writelogvalue eq "AsyncProc"
      520     then
      521        run write-to-log in this-procedure( p-log-string) .
      522   end.
      523   END PROCEDURE.
      524   PROCEDURE get-title :
      525   do
      526   on error undo, return error
      527   :
      528   define output parameter p-title     as character    no-undo.
      529   end.
      530   END PROCEDURE.
      531   PROCEDURE set-title :
      532   do
      533   on error undo, return error
      534   :
      535   define input parameter p-title     as character    no-undo.
      536   run write-to-log in this-procedure( input ( fill( chr(32), 15) + p-title)) .
      537   end.
      538   END PROCEDURE.
      539   PROCEDURE get-counter-value :
      540   do
      541   on error undo, return error
      542   :
      543   define output parameter p-counter     as integer    no-undo.
      544       assign
      545       p-counter  = v-loc-counter
      546       .
      547   end.
      548   END PROCEDURE.
      549   PROCEDURE set-counter-value :
      550   do
      551   on error undo, return error
      552   :
      553   define input parameter p-counter     as integer    no-undo.
      554       assign
      555       v-loc-counter = p-counter
      556       .
      557   end.
      558   END PROCEDURE.
      559   PROCEDURE show-counter :
      560   do
      561   on error undo, return error
      562   :
      563       assign
      564       v-counter-visible = true
      565       .
      566       process events.
      567   end.
      568   END PROCEDURE.
      569   PROCEDURE hide-counter :
      570   do
      571   on error undo, return error
      572   :
      573       assign
      574       v-counter-visible = false
      575       .
      576       run hide-message in auto-window-h .
      577       process events.
      578   end.
      579   END PROCEDURE.
      580   PROCEDURE write-counter :
      581   do
      582   on error undo, return error
      583   :
      584   define input parameter p-counter-string     as character    no-undo.
      585   if v-counter-visible then
      586   run write-message in auto-window-h ( input p-counter-string) .
      587   process events.
      588   end.
      589   END PROCEDURE.
      590   PROCEDURE get-stop-state :
      591   do
      592   on error undo, return error
      593   :
      594   define output parameter p-stop-state    as logical      no-undo.
      595   end.
      596   END PROCEDURE.
      597   PROCEDURE set-view-log :
      598   do
      599   on error undo, return error
      600   :
      601   define input parameter p-view-log     as logical    no-undo.
      602       assign
      603       v-view-log = p-view-log
      604       .
      605   end.
      606   END PROCEDURE.
      607   PROCEDURE get-view-log :
      608   do
      609   on error undo, return error
      610   :
      611   define output parameter p-view-log     as logical    no-undo.
      612       assign
      613       p-view-log = v-view-log
      614       .
      615   end.
      616   END PROCEDURE.
      617   PROCEDURE write-log :
      618   do
      619   on error undo, return error
      620   :
      621   define input parameter p-tab-position   as integer      no-undo.
      622   define input parameter p-log-string     as character    no-undo.
      623   run write-to-log in this-procedure( input ( fill( chr(32), 1  * p-tab-position)  +
      624                                       (IF p-log-string = "&Line" THEN FILL("-", 80)
      625                                       ELSE IF p-log-string = "&DLine" THEN FILL("=", 80)
      626                                       ELSE p-log-string))).
      627   end.
      628   END PROCEDURE.
      629   procedure writelog :
      630   do
      631   on error undo, return error
      632   :
      633   define input parameter p-file-name AS CHAR     NO-UNDO.
      634   define input parameter p-log-level AS INTEGER  NO-UNDO.
      635   define input parameter p-log-string  AS CHAR     NO-UNDO.
      636     if p-file-name <> "" then
      637     run  auto2dia-Writefile in this-procedure (
      638                                       input p-file-name
      639                                     ,input p-log-level
      640                                     ,input p-log-string
      641                                   ) no-error .
      642      process events.
      643   end.
      644   end procedure.
      645   PROCEDURE auto2dia-writefile:
      646     define input parameter sFileName AS CHAR     NO-UNDO.
      647     define input parameter iLogLevel AS INTEGER  NO-UNDO.
      648     define input parameter sToWrite  AS CHAR     NO-UNDO.
      649     define variable v-SlashPos  as integer no-undo .
      650     define variable v-lDirName  as character no-undo .
      651     define variable v-lDirName2 as character no-undo .
      652     v-SlashPos  = maximum (  r-index(sFileName, "\"),  r-index(sFileName, "/")  ) .
      653     v-lDirName  = if v-SlashPos > 0 then substring (sFileName, 1, v-SlashPos - 1) else "".
      654     FILE-INFO:FILE-NAME = v-lDirName .
      655     v-lDirName2 = FILE-INFO:FULL-PATHNAME .
      656     if v-lDirName2 <> ? then do :
      657   OUTPUT STREAM auto2dia TO VALUE(sFileName) APPEND.
      658       PUT STREAM auto2dia UNFORMATTED chr(10).
      659       PUT STREAM auto2dia UNFORMATTED (IF (iLogLevel = 0 OR sToWrite = "&DLine"
      660                                         OR sToWrite = "&Line") THEN "" ELSE
      661                                         cur-time-string-sec() + " ").
      662       PUT STREAM auto2dia UNFORMATTED
      663               (IF sToWrite = "&Line" THEN FILL("-", 80)
      664                ELSE IF sToWrite = "&DLine" THEN FILL("=", 80)
      665                ELSE sToWrite).
      666   OUTPUT STREAM auto2dia CLOSE.
      667     end .
      668   END PROCEDURE.
      669   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      670   define variable v-waitfram-action01         as character   no-undo .
      671   define variable v-waitfram-action02         as character   no-undo .
      672   define variable v-waitfram-action03         as character   no-undo .
      673   define variable mWaitFramTextBeg            as character   no-undo.
      674   define variable mWaitFramTextEnd            as character   no-undo.
      675   define variable mWaitFramView               as logical     no-undo.
      676   define variable mWaitProcEvent              as logical     no-undo init yes.
      677   define variable mWaitFramInterval           as integer     no-undo init 1 .
      678   define variable mWaitFramStop               as logical     no-undo.
      679   define variable mWaitFramStopUser           as logical     no-undo.
      680   define variable mWaitFramStopTimeOut        as logical     no-undo.
      681   define variable mWaitFramStartProc          as datetime-tz no-undo.
      682   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      683   define button B-WaitFramStop auto-end-key
      684        label "Стоп"
      685        size 10 by 1 tooltip "Остоновить процесс".
      686   define button B-viewProcInfo
      687        label "Информация"
      688        size 15 by 1 tooltip "Информация о процесс".
      689   define frame waitfram
      690     v-waitfram-action01 format "x(72)" no-label skip
      691     v-waitfram-action02 format "x(72)" no-label skip
      692     v-waitfram-action03 format "x(72)" no-label skip
      693     B-viewProcInfo
      694     B-WaitFramStop at row 4 col 30
      695     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      696     .
      697   define new global shared variable mBatchMode as logical no-undo init ?.
      698   define variable mFramBachModHandle as handle no-undo.
      699   mFramBachModHandle = frame waitfram:handle.
      700   define variable mFameOldVis as logical no-undo.
      701   define variable mVisCUrentVin as logical no-undo.
      702   if session:batch-mode
      703   then
      704      mBatchMode = yes.
      705   if mBatchMode = ? then do:
      706     mVisCUrentVin = current-window:visible.
      707     mFameOldVis = mFramBachModHandle:visible.
      708     mFramBachModHandle:visible  = yes.
      709     mBatchMode = mFramBachModHandle:visible ne yes.
      710     mFramBachModHandle:visible = mFameOldVis.
      711     current-window:visible = mVisCUrentVin.
      712   end.
      713    if  log-manager:logfile-name ne ?
      714     then DO:
      715         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      716         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      717         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      718     end.
      719   on choose of B-WaitFramStop in frame waitfram
      720   do:
      721     mWaitFramStop = yes.
      722     mWaitFramStopUser = yes.
      723   end.
      724   function waitfram-check-timeout returns logical():
      725      define variable vtime as int64 no-undo.
      726      if mWaitFramStopTimeOut
      727      then
      728         return yes.
      729      vtime = ( now - mWaitFramStartProc ) / 1000 .
      730      if     mWaitFramTimeOut ne ?
      731         and mWaitFramTimeOut ne 0
      732         and mWaitFramTimeOut lt vtime
      733      then do:
      734         mWaitFramStopTimeOut = yes.
      735      end.
      736      return mWaitFramStopTimeOut.
      737   end.
      738   procedure waitfram-hide :
      739     if not session:batch-mode
      740     then do
      741     on error undo, return error return-value
      742     :
      743       pause 0 before-hide .
      744       if not mBatchMode then
      745         hide frame waitfram .
      746     if     not mWaitFramView
      747        and mWaitProcEvent
      748     then
      749       process events .
      750     end.
      751   end procedure.
      752   procedure waitfram-show :
      753     define input  parameter p-message as character no-undo .
      754     define variable v-left-margin as integer   no-undo .
      755     if not session:batch-mode
      756     then do
      757     on error undo, return error return-value
      758     :
      759       if length(p-message) <= 70 then do:
      760         assign
      761           v-left-margin = integer((70 - length(p-message)) / 2)
      762         .
      763         assign
      764           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      765         .
      766         assign
      767           v-waitfram-action01 = " "
      768           v-waitfram-action02 = " "
      769                                    + fill(" ", v-left-margin)
      770                                    + p-message
      771           v-waitfram-action03 = " "
      772         .
      773       end.
      774       else do:
      775         define variable vRindex1 as integer no-undo.
      776         define variable vRindex2 as integer no-undo.
      777         vRindex1 = r-index(p-message," ",70).
      778         if vRindex1 = 0
      779         then
      780            vRindex1 = 70.
      781         if length(p-message)  <= vRindex1 + 70 then do:
      782           assign
      783             v-waitfram-action01 = " "
      784             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      785             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      786           .
      787         end.
      788         else do:
      789           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      790           if vRindex2 <= vRindex1
      791           then
      792              vRindex2 = vRindex1 + 70.
      793           assign
      794             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      795             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      796             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      797           .
      798         end.
      799       end.
      800       B-viewProcInfo:visible   in frame waitfram = no.
      801       B-viewProcInfo:sensitive in frame waitfram = no.
      802       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      803       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      804       if  (   mWaitFramView
      805          or  mWaitProcEvent)
      806          and not mBatchMode
      807       then
      808          display
      809             v-waitfram-action01 skip
      810             v-waitfram-action02 skip
      811             v-waitfram-action03 skip
      812          with frame waitfram .
      813       if     mWaitFramView
      814          then do:
      815             if     mWaitFramInterval ne ?
      816                and not mBatchMode
      817             then
      818                wait-for go of frame waitfram pause mWaitFramInterval.
      819          end.
      820          else
      821             if     mWaitProcEvent
      822                and not mBatchMode
      823             then
      824                process events .
      825     end.
      826   end procedure.
      827      procedure waitfram-show-this:
      828         define input  parameter iInterval as int64 no-undo.
      829         define variable vtime as int64 no-undo.
      830         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      831         mWaitFramInterval = iInterval.
      832         run waitfram-show (substitute("&1&2 &3&4" ,
      833                                       mWaitFramTextBeg ,
      834                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      835                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      836                                       mWaitFramTextEnd
      837                                      )
      838                           ).
      839      end.
      840      procedure WaitFramRunPause:
      841         define input  parameter iInterval as dec no-undo.
      842         define variable vStart  as datetime-tz no-undo.
      843         define variable vend    as datetime-tz no-undo.
      844         define variable vint as int64 no-undo.
      845         define variable vOk as logical no-undo.
      846         vStart = now.
      847         vend   = vStart.
      848         publish "WaitFramPause" (iInterval,output vOk).
      849         vend   =  now.
      850         vint = vend - vStart.
      851         vint = iInterval - vint / 1000.
      852         if     not mWaitFramStop
      853            and (   vint > 0
      854                 or (    not vOk
      855                     and iInterval eq ?
      856                     )
      857                 )
      858         then
      859            run waitfram-show-this (iInterval).
      860         vend   =  now.
      861         vint = vend - vStart.
      862         vint = iInterval - vint / 1000.
      863         if     not mWaitFramStop
      864            and vint > 0
      865         then do:
      866            run gbl/pause.p (vint * 1000).
      867         end.
      868         if iInterval ne ?
      869         then
      870            publish "WaitFramStop".
      871         waitfram-check-timeout().
      872      end.
      873      procedure WaitFramWaitFor:
      874         define input  parameter iInterval as dec no-undo.
      875         assign
      876            mWaitFramStartProc   = now
      877            mWaitFramStopUser    = no
      878            mWaitFramStopTimeOut = no
      879         .
      880         block-wait:
      881         do while not mWaitFramStop:
      882            run WaitFramRunPause (iInterval).
      883            if  waitfram-check-timeout()
      884            then do:
      885               leave block-wait.
      886            end.
      887         end.
      888         run waitfram-hide.
      889      end.
      890   procedure waitfram-join :
      891     define input  parameter p-line-1  as character no-undo .
      892     define input  parameter p-line-2  as character no-undo .
      893     define input  parameter p-line-3  as character no-undo .
      894     define output parameter p-message as character no-undo .
      895     do
      896     on error undo, return error return-value
      897     :
      898       assign
      899         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      900                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      901                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      902       .
      903     end.
      904   end procedure.
      905   function waitfram-join-function returns character
      906     (input p-line-1 as character
      907     ,input p-line-2 as character
      908     ,input p-line-3 as character
      909     ).
      910     define variable v-message as character no-undo .
      911     run waitfram-join in this-procedure
      912       (input  p-line-1
      913       ,input  p-line-2
      914       ,input  p-line-3
      915       ,output v-message
      916       ) .
      917     return v-message .
      918   end function .
      919   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      920   define variable tempcxml_v-num_ as integer no-undo .
      921   define new shared temp-table temp-xml-tables no-undo
      922   field order as integer
      923   field tbl-name as character
      924   field tbl-handle_ as handle
      925   field table-handle_ as handle
      926   field uniq-gate-rec as character
      927   field gate-name as character
      928   field gate-handle_ as handle
      929   field is-parent as logical
      930   index pi is unique primary
      931   uniq-gate-rec
      932   tbl-name
      933   index iorder
      934   order
      935   index gr
      936   uniq-gate-rec
      937   index gh
      938   gate-handle_
      939   index iparent
      940   is-parent
      941   .
      942   define new shared temp-table temp-xml-records no-undo
      943   field tbl-name as character
      944   field uniq-key-rec as character
      945   index pi is unique primary
      946   tbl-name
      947   uniq-key-rec
      948   .
      949   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      950   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      951   def var vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      952   procedure gen-key-rec :
      953     define input  parameter p-tbl-name    as character no-undo.
      954     define input  parameter p-bh_tbl-name as handle    no-undo.
      955     define output parameter p-key-rec     as character no-undo.
      956     do
      957     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      958     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      959     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      960     :
      961       define variable fh               as handle    no-undo .
      962       define variable v-ok             as logical   no-undo .
      963       define variable v-inform         as character no-undo .
      964       define variable v-ind            as integer   no-undo .
      965       define variable v-idx-field-qnty as integer   no-undo .
      966       if p-tbl-name = ?
      967         or p-tbl-name = "":U
      968       then do:
      969         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info8 ).
      970       end.
      971       if not p-bh_tbl-name:available then do:
      972         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info8, p-tbl-name ).
      973       end.
      974       assign
      975         p-key-rec = p-tbl-name
      976         v-inform  = p-bh_tbl-name:index-information(1)
      977         v-ind     = 2
      978       .
      979       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      980       on error undo, return error
      981       :
      982         assign
      983           v-inform = p-bh_tbl-name:index-information( v-ind )
      984           v-ind    = v-ind + 1
      985         .
      986       end.
      987       if v-inform = ?
      988         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      989         or entry( 3, v-inform, ",":U ) <> "1":U
      990       then do:
      991         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info8, p-tbl-name ).
      992       end.
      993       else do:
      994         assign
      995           v-idx-field-qnty = num-entries( v-inform ) - 4
      996         .
      997         if v-idx-field-qnty < 2 then do:
      998           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info8, v-inform, p-tbl-name ).
      999         end.
     1000         do v-ind = 1 to v-idx-field-qnty by 2
     1001         on error undo, return error
     1002         :
     1003           assign
     1004             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
     1005             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
     1006           .
     1007         end.
     1008       end.
     1009       if p-key-rec = ? then do:
     1010         assign
     1011           p-key-rec = "":U
     1012         .
     1013         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info8, p-tbl-name ).
     1014       end.
     1015     end.
     1016     return.
     1017   end procedure.
     1018   procedure gen-where-keyr-tab :
     1019     define input  parameter i-tableSerach as character no-undo.
     1020     define input  parameter i-tablekey   as character  no-undo.
     1021     define input  parameter p-key-rec    as character  no-undo.
     1022     define input  parameter p-key-handle as handle     no-undo .
     1023     define input  parameter p-db-name    as character  no-undo .
     1024     define input  parameter p-tt-handle  as handle     no-undo .
     1025     define output parameter o-Where      as character  no-undo.
     1026     do
     1027     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1028     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1029     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
     1030     :
     1031       define variable v-full-tbl-name  as character no-undo .
     1032       define variable bh_tbl-name      as handle    no-undo .
     1033       define variable fh_key           as handle    no-undo .
     1034       define variable fh_search        as handle    no-undo .
     1035       define variable v-field-num      as integer   no-undo .
     1036       define variable v-count-fld      as integer   no-undo .
     1037       define variable v-inform         as character no-undo .
     1038       define variable v-ind            as integer   no-undo .
     1039       define variable v-idx-field-qnty as integer   no-undo .
     1040       define variable v-field-name     as character no-undo .
     1041       define variable v-field-val      as character no-undo .
     1042       define variable v-word-link      as character no-undo .
     1043       define variable vTable           as character no-undo.
     1044       define variable bh_tbl-key       as handle    no-undo .
     1045       assign
     1046         p-key-rec = trim( p-key-rec )
     1047       .
     1048       if p-key-handle <> ? then do:
     1049         if not valid-handle(p-key-handle)
     1050            or p-key-handle:type <> "buffer"
     1051         then do:
     1052           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info8 ).
     1053         end.
     1054         if num-entries( p-key-rec, chr(3) ) > 1
     1055           or p-key-rec = ?
     1056           or p-key-rec = "":U
     1057         then do:
     1058           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info8, p-key-rec ).
     1059         end.
     1060       end.
     1061       else do:
     1062         if p-key-rec = ?
     1063           or p-key-rec = "":U
     1064         then do:
     1065           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info8 ).
     1066         end.
     1067       end.
     1068       assign
     1069         vTable = entry( 1 , p-key-rec, chr(3) )
     1070       .
     1071       if p-tt-handle <> ?
     1072         and ( not valid-handle(p-tt-handle)
     1073               or p-tt-handle:type <> "buffer"
     1074             )
     1075       then do:
     1076         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info8, vTable, chr(10) ).
     1077       end.
     1078       if p-tt-handle = ? then do:
     1079         assign
     1080           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
     1081         .
     1082         create buffer bh_tbl-name for table v-full-tbl-name .
     1083       end.
     1084       else do:
     1085         create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1086       end.
     1087       assign
     1088         v-inform = bh_tbl-name:index-information(1)
     1089         v-ind    = 2
     1090       .
     1091       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1092       on error undo, return error
     1093       :
     1094         assign
     1095           v-inform = bh_tbl-name:index-information( v-ind )
     1096           v-ind    = v-ind + 1
     1097         .
     1098       end.
     1099       if v-inform = ?
     1100         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1101         or entry( 3, v-inform, ",":U ) <> "1":U
     1102       then do:
     1103         delete object bh_tbl-name no-error.
     1104         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info8, vTable ).
     1105       end.
     1106       assign
     1107         v-idx-field-qnty = num-entries( v-inform ) - 4
     1108       .
     1109       if v-idx-field-qnty < 2 then do:
     1110         delete object bh_tbl-name no-error.
     1111         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info8, v-inform, vTable ).
     1112       end.
     1113       assign
     1114         o-where     = "where":U
     1115         v-word-link = "":U
     1116         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
     1117         v-count-fld = 0
     1118       .
     1119       if i-tablekey ne "" and i-tablekey ne ?
     1120       then do:
     1121         assign
     1122           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
     1123         .
     1124         create buffer bh_tbl-key for table v-full-tbl-name .
     1125       end.
     1126       if i-tableSerach ne "" and i-tableSerach ne ?
     1127       then do:
     1128         delete object bh_tbl-name no-error.
     1129         assign
     1130           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
     1131         .
     1132         create buffer bh_tbl-name for table v-full-tbl-name .
     1133       end.
     1134       block_where:
     1135       do v-ind = 1 to v-idx-field-qnty by 2
     1136       on error undo, return error
     1137       :
     1138         assign
     1139           v-count-fld = v-count-fld + 1
     1140         .
     1141         if p-key-handle = ?
     1142           and v-count-fld > v-field-num
     1143         then do:
     1144           leave block_where.
     1145         end.
     1146         define variable VfieldKeyTable as handle no-undo.
     1147         assign
     1148           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     1149           fh_search    = bh_tbl-name:buffer-field( v-field-name )
     1150         .
     1151         if     bh_tbl-key ne ?
     1152         then do:
     1153            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
     1154            if VfieldKeyTable eq ?
     1155            then next block_where.
     1156         end.
     1157         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
     1158         then
     1159            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
     1160         else
     1161            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
     1162         if p-key-handle = ? then do:
     1163           assign
     1164             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
     1165           .
     1166         end.
     1167         else do:
     1168           assign
     1169             fh_key = p-key-handle:buffer-field( v-field-name )
     1170           .
     1171           if fh_key = ?
     1172             or not valid-handle( fh_key )
     1173           then do:
     1174             delete object bh_tbl-name.
     1175             if     bh_tbl-key ne ?
     1176             then
     1177                delete object bh_tbl-key.
     1178             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info8, p-key-handle:name, v-field-name ).
     1179           end.
     1180           assign
     1181             v-field-val = fh_key:buffer-value
     1182           .
     1183         end.
     1184         if fh_search:data-type ="character":U then do:
     1185           assign
     1186             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
     1187             v-field-val = replace( v-field-val, '"':U, '~~"':U )
     1188             v-field-val = replace( v-field-val, "'":U, "~~'":U )
     1189             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
     1190             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
     1191             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
     1192             v-field-val = replace( v-field-val, chr(10), '~~n':U )
     1193             v-field-val = replace( v-field-val, chr(9), '~~t':U )
     1194             v-field-val = replace( v-field-val, chr(13), '~~r':U )
     1195             v-field-val = replace( v-field-val, chr(27), '~~E':U )
     1196             v-field-val = replace( v-field-val, chr(8), '~~b':U )
     1197             v-field-val = replace( v-field-val, chr(12), '~~f':U )
     1198             v-field-val = substitute( '"&1"', v-field-val )
     1199           .
     1200         end.
     1201         assign
     1202           o-where = substitute( "&1 &2", o-where, v-field-val )
     1203         .
     1204         if v-word-link = "":U then do:
     1205           assign
     1206             v-word-link = "and":U
     1207           .
     1208         end.
     1209       end.
     1210       delete object bh_tbl-name.
     1211       if     bh_tbl-key ne ?
     1212       then
     1213          delete object bh_tbl-key.
     1214       if p-key-handle = ?
     1215         and v-count-fld <> v-field-num
     1216       then do:
     1217         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info8, vTable ).
     1218       end.
     1219     end.
     1220   end procedure.
     1221   procedure gen-hn-keyr-tab :
     1222     define input  parameter i-tableSerach as character no-undo.
     1223     define input  parameter i-tablekey   as character no-undo.
     1224     define input  parameter p-key-rec    as character no-undo.
     1225     define input  parameter p-key-handle as handle    no-undo .
     1226     define input  parameter p-db-name    as character no-undo .
     1227     define input  parameter p-tt-handle  as handle    no-undo .
     1228     define input  parameter p-stts-lock  as integer   no-undo .
     1229     define output parameter o-hn         as handle    no-undo.
     1230     define variable v-full-tbl-name as character no-undo.
     1231     define variable v-where         as character no-undo.
     1232     define variable bh_tbl-name     as handle    no-undo.
     1233     define variable vTable          as character no-undo.
     1234     do
     1235     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1236     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1237     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
     1238         run gen-where-keyr-tab(i-tableSerach,
     1239                                i-tablekey,
     1240                                p-key-rec,
     1241                                p-key-handle,
     1242                                p-db-name,
     1243                                p-tt-handle,
     1244                                output v-where).
     1245         if i-tableSerach ne "" and i-tableSerach ne ?
     1246         then do:
     1247            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
     1248            create buffer bh_tbl-name for table v-full-tbl-name .
     1249         end.
     1250         else do:
     1251            if p-tt-handle = ? then do:
     1252               assign
     1253                  vTable = entry( 1 , p-key-rec, chr(3) )
     1254               .
     1255               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
     1256               create buffer bh_tbl-name for table v-full-tbl-name .
     1257            end.
     1258            else do:
     1259               create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1260            end.
     1261         end.
     1262         if p-tt-handle = ? then do:
     1263            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
     1264         end.
     1265         else do:
     1266            bh_tbl-name:find-first( v-where ) no-error .
     1267         end.
     1268         o-hn = bh_tbl-name.
     1269      end.
     1270   end procedure.
     1271   procedure gen-hn-keyr :
     1272     define input  parameter p-key-rec    as character no-undo.
     1273     define input  parameter p-key-handle as handle    no-undo .
     1274     define input  parameter p-db-name    as character no-undo .
     1275     define input  parameter p-tt-handle  as handle    no-undo .
     1276     define input  parameter p-stts-lock  as integer   no-undo .
     1277     define output parameter o-hn         as handle    no-undo.
     1278     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
     1279   end.
     1280   procedure gen-row-keyr :
     1281     define input  parameter p-key-rec    as character no-undo.
     1282     define input  parameter p-key-handle as handle    no-undo .
     1283     define input  parameter p-db-name    as character no-undo .
     1284     define input  parameter p-tt-handle  as handle    no-undo .
     1285     define input  parameter p-stts-lock  as integer   no-undo .
     1286     define output parameter p-tbl-row    as rowid     no-undo.
     1287     define output parameter p-tbl-name   as character no-undo.
     1288     define variable vHn as handle no-undo.
     1289       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
     1290       p-tbl-row = if vHn:available then vHn:rowid else ?.
     1291       p-tbl-name =  vHn:table.
     1292       delete object vHn no-error.
     1293     if p-tbl-row = ? then do:
     1294       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info8, p-tbl-name, p-key-rec ).
     1295     end.
     1296     else do:
     1297       return.
     1298     end.
     1299   end procedure.
     1300   procedure gen-key-fv :
     1301     define input  parameter p-key-rec    as character no-undo .
     1302     define output parameter p-field-list as character no-undo .
     1303     define output parameter p-value-list as character no-undo.
     1304     do
     1305     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1306     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1307     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1308     :
     1309       define variable v-full-tbl-name  as character no-undo .
     1310       define variable bh_tbl-name      as handle    no-undo .
     1311       define variable v-tbl-name       as character no-undo .
     1312       define variable v-field-num      as integer   no-undo .
     1313       define variable v-count-fld      as integer   no-undo .
     1314       define variable v-inform         as character no-undo .
     1315       define variable v-ind            as integer   no-undo .
     1316       define variable v-idx-field-qnty as integer   no-undo .
     1317       define variable v-delim-key      as character no-undo .
     1318       if p-key-rec = ?
     1319         or p-key-rec = "":U
     1320       then do:
     1321         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info8 ).
     1322       end.
     1323       assign
     1324         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     1325         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1326       .
     1327       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1328       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info8 ).
     1329       assign
     1330         v-inform = bh_tbl-name:index-information(1)
     1331         v-ind    = 2
     1332       .
     1333       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1334       on error undo, return error
     1335       :
     1336         assign
     1337           v-inform = bh_tbl-name:index-information( v-ind )
     1338           v-ind    = v-ind + 1
     1339         .
     1340       end.
     1341       if v-inform = ?
     1342         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1343         or entry( 3, v-inform, ",":U ) <> "1":U
     1344       then do:
     1345         delete object bh_tbl-name no-error.
     1346         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info8, v-tbl-name ).
     1347       end.
     1348       assign
     1349         v-idx-field-qnty = num-entries( v-inform ) - 4
     1350       .
     1351       if v-idx-field-qnty < 2 then do:
     1352         delete object bh_tbl-name no-error.
     1353         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info8, v-inform, v-tbl-name ).
     1354       end.
     1355       assign
     1356         p-field-list = "":U
     1357         p-value-list = "":U
     1358         v-delim-key  = "":U
     1359         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     1360         v-count-fld  = 0
     1361       .
     1362       block_where:
     1363       do v-ind = 1 to v-idx-field-qnty by 2
     1364       on error undo, return error
     1365       :
     1366         assign
     1367           v-count-fld = v-count-fld + 1
     1368         .
     1369         if v-count-fld > v-field-num then do:
     1370           leave block_where.
     1371         end.
     1372         assign
     1373           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     1374           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     1375         .
     1376         if v-ind = 1 then do:
     1377           assign
     1378             v-delim-key = chr(3)
     1379           .
     1380         end.
     1381       end.
     1382       delete object bh_tbl-name.
     1383       if v-count-fld <> v-field-num then do:
     1384         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info8, v-tbl-name ).
     1385       end.
     1386     end.
     1387   end procedure.
     1388   procedure gen-key-field :
     1389     define input  parameter p-table      as character no-undo .
     1390     define output parameter p-field-list as character no-undo .
     1391     do
     1392     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1393     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1394     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1395     :
     1396       define variable v-full-tbl-name  as character no-undo .
     1397       define variable bh_tbl-name      as handle    no-undo .
     1398       define variable v-tbl-name       as character no-undo .
     1399       define variable v-field-num      as integer   no-undo .
     1400       define variable v-count-fld      as integer   no-undo .
     1401       define variable v-inform         as character no-undo .
     1402       define variable v-ind            as integer   no-undo .
     1403       define variable v-idx-field-qnty as integer   no-undo .
     1404       define variable v-delim-key      as character no-undo .
     1405       if p-table = ?
     1406         or p-table = "":U
     1407       then do:
     1408         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info8 ).
     1409       end.
     1410       assign
     1411         v-tbl-name      = p-table
     1412         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1413       .
     1414       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1415       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info8 ).
     1416       assign
     1417         v-inform = bh_tbl-name:index-information(1)
     1418         v-ind    = 2
     1419       .
     1420       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1421       on error undo, return error
     1422       :
     1423         assign
     1424           v-inform = bh_tbl-name:index-information( v-ind )
     1425           v-ind    = v-ind + 1
     1426         .
     1427       end.
     1428       if v-inform = ?
     1429         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1430         or entry( 3, v-inform, ",":U ) <> "1":U
     1431       then do:
     1432         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info8, v-tbl-name ).
     1433       end.
     1434       assign
     1435         v-idx-field-qnty = num-entries( v-inform ) - 4
     1436       .
     1437       if v-idx-field-qnty < 2 then do:
     1438         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info8, v-inform, v-tbl-name ).
     1439       end.
     1440       assign
     1441         p-field-list = "":U
     1442         v-delim-key  = "":U
     1443         v-count-fld  = 0
     1444       .
     1445       block_where:
     1446       do v-ind = 1 to v-idx-field-qnty by 2
     1447       on error undo, return error
     1448       :
     1449         assign
     1450           v-count-fld = v-count-fld + 1
     1451         .
     1452         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     1453         if v-ind = 1 then do:
     1454           assign
     1455             v-delim-key = chr(3)
     1456           .
     1457         end.
     1458       end.
     1459       delete object bh_tbl-name.
     1460     end.
     1461   end procedure.
     1462   procedure get-gate-file-name :
     1463   define input parameter p-gate-rec as character no-undo .
     1464   define output  parameter p-gate-file-name as character no-undo .
     1465   define buffer buf_clob-data for ub.clob-data.
     1466   define variable v-tbl-row as rowid no-undo .
     1467   define variable v-tbl-name as character no-undo .
     1468   run gen-row-keyr in this-procedure ( input p-gate-rec
     1469                                       ,input ?
     1470                                       ,input "ub"
     1471                                       ,input ?
     1472                                       ,input no-lock
     1473                                       ,output v-tbl-row
     1474                                       ,output v-tbl-name) no-error.
     1475   if error-status:error then undo, return error substitute("&1 (get-gate-name) Несуществующий gate &2"
     1476                                                           ,vss-include-info6
     1477                                                           ,p-gate-rec).
     1478   find first buf_clob-data no-lock where
     1479             rowid(buf_clob-data) = v-tbl-row no-error.
     1480   if not available buf_clob-data then do:
     1481     if error-status:error then undo, return error substitute("&1 (get-gate-name) Несуществующий gate &2"
     1482                                                             ,vss-include-info6
     1483                                                             ,p-gate-rec).
     1484   end.
     1485   p-gate-file-name = buf_clob-data.file-name.
     1486   end procedure.
     1487   procedure get-gate-rec :
     1488   define input  parameter p-gate-name as character no-undo .
     1489   define output parameter p-gate-rec as character no-undo .
     1490   define buffer buf_clob-bind for ub.clob-bind.
     1491   define buffer buf_clob-data for ub.clob-data.
     1492   main-block:
     1493   do
     1494   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info6, return-value, chr(10), error-status :get-message (1))
     1495   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info6 )
     1496   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info6 )
     1497   :
     1498       find first buf_clob-bind no-lock where
     1499                 buf_clob-bind.uniq-key-rec = p-gate-name
     1500             and buf_clob-bind.field-name = '':U
     1501             and buf_clob-bind.part-num = 1
     1502             and buf_clob-bind.resource-type = 'gate':U
     1503             no-error.
     1504       if not available buf_clob-bind then do:
     1505         undo, return error substitute("Неверная ссылка на XSD -файл &1 для gate"
     1506                                         , p-gate-name
     1507                                         ).
     1508       end.
     1509       find first buf_clob-data no-lock where
     1510                 buf_clob-data.db-num = buf_clob-bind.db-num
     1511             and buf_clob-data.int64-i= buf_clob-bind.int64-id no-error.
     1512       if not available buf_clob-data then do:
     1513         undo, return error substitute("Не найден CLOB c ДБ &1 id &2 - файл &3"
     1514                                         , buf_clob-bind.db-num
     1515                                         , buf_clob-bind.int64-id
     1516                                         , p-gate-name
     1517                                         ).
     1518       end.
     1519       run gen-key-rec in this-procedure ( input 'clob-data':U
     1520                                 ,input buffer buf_clob-data:handle
     1521                                 ,output p-gate-rec).
     1522   end.
     1523   end procedure.
     1524   procedure get-gate-by-name :
     1525   define input  parameter p-gate-name as character no-undo .
     1526   define output parameter p-gate-rec as character no-undo .
     1527   define output parameter p-dsh as handle no-undo .
     1528   define input-output  parameter p-xmlh as handle no-undo .
     1529   define variable v-ii as integer   no-undo .
     1530   define variable glog as logical   no-undo .
     1531   define variable v-longchar as longchar no-undo .
     1532   define variable v-txmlh as handle no-undo .
     1533   define variable v-db-num as integer no-undo .
     1534   define variable v-int64-id as int64 no-undo .
     1535   define buffer buf_clob-bind for ub.clob-bind.
     1536   define buffer buf_clob-data for ub.clob-data.
     1537   main-block:
     1538   do
     1539   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info6, return-value, chr(10), error-status :get-message (1))
     1540   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info6 )
     1541   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info6 )
     1542   :
     1543       find first buf_clob-bind no-lock where
     1544                 buf_clob-bind.uniq-key-rec = p-gate-name
     1545             and buf_clob-bind.field-name = '':U
     1546             and buf_clob-bind.part-num = 1
     1547             and buf_clob-bind.resource-type = 'gate':U
     1548             no-error.
     1549       if not available buf_clob-bind then do:
     1550         undo, return error substitute("Неверная ссылка на XSD -файл &1 для gate"
     1551                                         , p-gate-name
     1552                                         ).
     1553       end.
     1554       find first buf_clob-data no-lock where
     1555                 buf_clob-data.db-num = buf_clob-bind.db-num
     1556             and buf_clob-data.int64-i= buf_clob-bind.int64-id no-error.
     1557       if not available buf_clob-data then do:
     1558         undo, return error substitute("Не найден CLOB c ДБ &1 id &2 - файл &3"
     1559                                         , buf_clob-bind.db-num
     1560                                         , buf_clob-bind.int64-id
     1561                                         , p-gate-name
     1562                                         ).
     1563       end.
     1564       assign
     1565       v-longchar = buf_clob-data.cdata
     1566       .
     1567       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1568       if error-status :error then do:
     1569         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, buf_clob-data.file-name_, chr(10), error-status:get-message(1) , return-value ).
     1570       end.
     1571       create dataset p-dsh .
     1572       glog = p-dsh:READ-XMLSCHEMA( "LONGCHAR"
     1573                                     , v-longchar
     1574                                     , ?
     1575                                     , ?
     1576                                     , ?
     1577                                     ) no-error.
     1578       v-longchar = '':U.
     1579       if error-status :error
     1580       or not glog
     1581       then do:
     1582         undo, return error substitute("Не удалось прочитать XML-схему &1 из БД:&2&3", p-gate-name, chr(10), error-status:get-message(1) ).
     1583       end.
     1584       if not valid-handle(p-xmlh)
     1585       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     1586         create temp-table v-txmlh.
     1587         v-txmlh:create-like(buffer temp-xml-tables:handle).
     1588         v-txmlh:temp-table-prepare("temp-xml-tables").
     1589         p-xmlh = v-txmlh:default-buffer-handle.
     1590       end.
     1591       run gen-key-rec in this-procedure ( input 'clob-data':U
     1592                                 ,input buffer buf_clob-data:handle
     1593                                 ,output p-gate-rec).
     1594       do v-ii = 1 to p-dsh:num-buffers:
     1595         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     1596         if not p-xmlh:available then do:
     1597           p-xmlh:buffer-create().
     1598           assign
     1599           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     1600           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1601           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1602           p-xmlh::gate-handle_ = p-dsh
     1603           p-xmlh::uniq-gate-rec = p-gate-rec
     1604           p-xmlh::gate-name = p-dsh:name
     1605           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1606           .
     1607           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1608             assign
     1609             p-xmlh::order = -3.
     1610           end.
     1611         end.
     1612       end.
     1613   end.
     1614   end procedure.
     1615   procedure get-gate-by-rec :
     1616   define input  parameter p-gate-rec as character no-undo .
     1617   define output parameter p-dsh as handle no-undo .
     1618   define input-output  parameter p-xmlh as handle no-undo .
     1619   define input-output parameter p-longchar  as longchar no-undo .
     1620   define variable v-ii as integer   no-undo .
     1621   define variable glog as logical   no-undo .
     1622   define variable v-rowid as rowid no-undo .
     1623   define variable v-tbl-name as character no-undo .
     1624   define variable v-longchar as longchar no-undo .
     1625   define variable v-txmlh as handle no-undo .
     1626   define buffer buf_clob-data for ub.clob-data.
     1627   main-block:
     1628   do
     1629   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info6, return-value, chr(10), error-status :get-message (1))
     1630   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info6 )
     1631   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info6 )
     1632   :
     1633     run gen-row-keyr in this-procedure (
     1634                                           input  p-gate-rec
     1635                                           ,input  ?
     1636                                           ,input  "ub"
     1637                                           ,input  ?
     1638                                           ,input  NO-LOCK
     1639                                           ,output v-rowid
     1640                                           ,output v-tbl-name   ) no-error.
     1641       find first buf_clob-data no-lock where
     1642                 rowid(buf_clob-data) = v-rowid  no-error.
     1643       if not available buf_clob-data then do:
     1644         undo, return error substitute("Не найден CLOB  &1"
     1645                                         , p-gate-rec
     1646                                         ).
     1647       end.
     1648       assign
     1649       v-longchar = buf_clob-data.cdata
     1650       .
     1651       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1652       if error-status :error then do:
     1653         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, buf_clob-data.file-name_, chr(10), error-status:get-message(1) , return-value ).
     1654       end.
     1655       create dataset p-dsh .
     1656       glog = p-dsh:READ-XMLSCHEMA( "LONGCHAR"
     1657                                     , v-longchar
     1658                                     , ?
     1659                                     , ?
     1660                                     , ?
     1661                                     ) no-error.
     1662       define variable v-esm as character no-undo .
     1663       v-esm = error-status:get-message(1) .
     1664       if p-longchar <> ? then do:
     1665         p-longchar = v-longchar.
     1666       end.
     1667       v-longchar = '':U.
     1668       if error-status :error
     1669       or not glog
     1670       then do:
     1671         undo, return error substitute("Не удалось прочитать XML-схему &1 (&2) из БД&3&4"
     1672                                      , p-gate-rec
     1673                                      , p-gate-rec
     1674                                      , v-esm
     1675                                      ).
     1676       end.
     1677       p-dsh:private-data = buf_clob-data.file-name_ + chr(4) + p-gate-rec.
     1678       if not valid-handle(p-xmlh)
     1679       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     1680         create temp-table v-txmlh.
     1681         v-txmlh:create-like(buffer temp-xml-tables:handle).
     1682         v-txmlh:temp-table-prepare("temp-xml-tables").
     1683         p-xmlh = v-txmlh:default-buffer-handle.
     1684       end.
     1685       do v-ii = 1 to p-dsh:num-buffers:
     1686         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     1687         if not p-xmlh:available then do:
     1688           p-xmlh:buffer-create().
     1689           assign
     1690           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     1691           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1692           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1693           p-xmlh::gate-handle_ = p-dsh
     1694           p-xmlh::uniq-gate-rec = p-gate-rec
     1695           p-xmlh::gate-name = p-dsh:name
     1696           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1697           .
     1698           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1699             assign
     1700             p-xmlh::order = -3.
     1701           end.
     1702           p-xmlh:buffer-release().
     1703         end.
     1704       end.
     1705   end.
     1706   end procedure.
     1707   procedure get-gate-by-file :
     1708   define input  parameter p-schema-file-name as character no-undo .
     1709   define input  parameter p-gate-rec as character no-undo .
     1710   define output parameter p-dsh as handle no-undo .
     1711   define input-output  parameter p-xmlh as handle no-undo .
     1712   define variable v-ii as integer   no-undo .
     1713   define variable glog as logical   no-undo .
     1714   define variable v-rowid as rowid no-undo .
     1715   define variable v-tbl-name as character no-undo .
     1716   define variable v-longchar as longchar no-undo .
     1717   define variable v-txmlh as handle no-undo .
     1718   main-block:
     1719   do
     1720   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info6, return-value, chr(10), error-status :get-message (1))
     1721   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info6 )
     1722   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info6 )
     1723   :
     1724       COPY-LOB
     1725       FROM  FILE p-schema-file-name
     1726       TO  OBJECT v-longchar
     1727       no-convert
     1728       NO-ERROR .
     1729       if error-status :error then do:
     1730           undo, return error substitute("Не удалось считать файл схемы &1 в память&2&3"
     1731                                     , p-schema-file-name
     1732                                 , chr(10)
     1733                                 , error-status:get-message(1) ).
     1734       end.
     1735       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1736       if error-status :error then do:
     1737         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, p-schema-file-name, chr(10), error-status:get-message(1) , return-value ).
     1738       end.
     1739       create dataset p-dsh .
     1740       glog = p-dsh:READ-XMLSCHEMA( "longchar"
     1741                                     , v-longchar
     1742                                     , ?
     1743                                     , ?
     1744                                     , ?
     1745                                     ) no-error.
     1746       v-longchar = ''.
     1747       if error-status :error
     1748       or not glog
     1749       then do:
     1750         undo, return error substitute("Не удалось прочитать XML-схему из файла &1&2&3"
     1751                                      , p-schema-file-name
     1752                                      ,chr(10)
     1753                                      , error-status:get-message(1)
     1754                                      ).
     1755       end.
     1756       if not valid-handle(p-xmlh)
     1757       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     1758         create temp-table v-txmlh.
     1759         v-txmlh:create-like(buffer temp-xml-tables:handle).
     1760         v-txmlh:temp-table-prepare("temp-xml-tables").
     1761         p-xmlh = v-txmlh:default-buffer-handle.
     1762       end.
     1763       do v-ii = 1 to p-dsh:num-buffers:
     1764         p-xmlh:find-first(substitute(' where tbl-name = "&1" and  uniq-gate-rec = "&2" '
     1765                                      ,p-dsh:get-buffer-handle(v-ii):name
     1766                                      ,p-gate-rec
     1767                                      )) no-error.
     1768         if not p-xmlh:available then do:
     1769           p-xmlh:buffer-create().
     1770           assign
     1771           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):table
     1772           p-xmlh::uniq-gate-rec = p-gate-rec
     1773           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1774           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1775           p-xmlh::gate-handle_ = p-dsh
     1776           p-xmlh::gate-name = p-dsh:name
     1777           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1778           .
     1779           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1780             assign
     1781             p-xmlh::order = -3.
     1782           end.
     1783           p-xmlh:buffer-release().
     1784         end.
     1785       end.
     1786   end.
     1787   end procedure.
     1788   procedure gate-clear :
     1789   define input  parameter p-dsh as handle no-undo .
     1790   define input  parameter p-xmlh as handle no-undo .
     1791   define variable v-dsh as handle no-undo .
     1792   define variable v-th as handle no-undo .
     1793     do
     1794     on error undo, return error return-value
     1795     :
     1796       if valid-handle(p-dsh) then do:
     1797         delete object p-dsh.
     1798         v-dsh = p-dsh.
     1799         p-dsh = ?.
     1800       end.
     1801       repeat while true:
     1802         p-xmlh:find-first( substitute( " where gate-handle_ = &1 ", v-dsh)
     1803                            , share-lock) no-error.
     1804         if p-xmlh:available then do:
     1805           assign
     1806           v-th = p-xmlh:buffer-field("table-handle_"):buffer-value.
     1807           if valid-handle(p-xmlh:buffer-field("table-handle_"))
     1808           and valid-handle(v-th)
     1809           and v-th:dynamic = yes
     1810           then do:
     1811             delete object p-xmlh:buffer-field("table-handle_"):buffer-value.
     1812             p-xmlh:buffer-field("table-handle_"):buffer-value = ?.
     1813           end.
     1814           p-xmlh:buffer-delete().
     1815         end.
     1816         else do:
     1817           leave.
     1818         end.
     1819       end.
     1820       if p-xmlh:dynamic = yes
     1821       and valid-handle(p-xmlh)
     1822       then do:
     1823         delete object p-xmlh:table-handle.
     1824         p-xmlh = ?.
     1825       end.
     1826       v-dsh = ?.
     1827     end.
     1828   end procedure.
     1829   procedure all-gates-clear :
     1830   define parameter buffer buf_temp-xml-tables for temp-xml-tables.
     1831   do
     1832   on error undo, return error
     1833   :
     1834     for each buf_temp-xml-tables
     1835     break
     1836     by buf_temp-xml-tables.uniq-gate-rec
     1837     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1838     on stop   undo , return error substitute( "&1. stop", vss-workfile )
     1839     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     1840     :
     1841         if first-of(buf_temp-xml-tables.uniq-gate-rec) then do:
     1842           delete object buf_temp-xml-tables.gate-handle_.
     1843           buf_temp-xml-tables.gate-handle_ = ?.
     1844         end.
     1845         if valid-handle(buf_temp-xml-tables.table-handle_)
     1846         and buf_temp-xml-tables.table-handle_:dynamic = no
     1847         then do:
     1848           delete object buf_temp-xml-tables.table-handle_.
     1849           buf_temp-xml-tables.table-handle_ = ?.
     1850         end.
     1851         delete buf_temp-xml-tables.
     1852     end.
     1853   end.
     1854   end procedure.
     1855   procedure fix-schemalocation :
     1856   define input-output  parameter p-longchar as longchar no-undo .
     1857   DEFINE VARIABLE hdoc AS HANDLE.
     1858   DEFINE VARIABLE hroot AS HANDLE.
     1859   DEFINE VARIABLE hnode-child AS HANDLE.
     1860   DEFINE VARIABLE hnode-attr AS HANDLE.
     1861   define variable v-jj as integer   no-undo .
     1862   define variable ok as logical   no-undo .
     1863   define variable v-path1                    as character                no-undo .
     1864   DEFINE VARIABLE v-full-path1               as character                no-undo .
     1865   DEFINE VARIABLE v-file-name1               as character                no-undo .
     1866   DEFINE VARIABLE v-file-name-no-ext1        as character                no-undo .
     1867   DEFINE VARIABLE v-file-name-ext1           as character                no-undo .
     1868   define variable v-schema-location          as character                no-undo .
     1869   do
     1870   on error undo, return error return-value
     1871   :
     1872     CREATE X-DOCUMENT hdoc.
     1873     CREATE X-noderef hroot.
     1874     CREATE X-noderef hnode-child.
     1875     CREATE X-noderef hnode-attr.
     1876     hdoc:load("longchar", p-longchar, no) no-error.
     1877     iF ERROR-STATUS:GET-MESSAGE(1) <> '' THEN message ERROR-STATUS:GET-MESSAGE(1) view-as alert-box .
     1878     hdoc:get-document-element(hroot).
     1879     _repeat:
     1880     REPEAT v-jj = 1 TO hroot:NUM-CHILDREN:
     1881       ok = hroot:GET-CHILD(hNode-Child, v-jj).
     1882       if not ok then next.
     1883       if hNode-Child:local-name = "include"
     1884       then do:
     1885         ok = hNode-Child:GET-ATTRIBUTE-NODE( hnode-attr, "schemaLocation" ).
     1886           v-schema-location = hnode-attr:node-value.
     1887           run gbl/filename.p (
     1888                           input "exe/" + hnode-attr:node-value
     1889                         ,output v-full-path1
     1890                         ,output v-path1
     1891                         ,output v-file-name1
     1892                         ,output v-file-name-no-ext1
     1893                         ,output v-file-name-ext1
     1894                         ) no-error .
     1895           if error-status :error then do:
     1896             delete object hnode-attr.
     1897             delete object hnode-child.
     1898             delete object hroot.
     1899             delete object hdoc.
     1900             undo, return error substitute("Не удалось определить расположение схемы &1", v-schema-location).
     1901           end.
     1902         ok = hNode-Child:sET-ATTRIBUTE(  "schemaLocation", v-full-path1 ).
     1903         leave  _repeat.
     1904       end.
     1905     END.
     1906     hdoc:save("longchar", p-longchar).
     1907     delete object hnode-attr.
     1908     delete object hnode-child.
     1909     delete object hroot.
     1910     delete object hdoc.
     1911   end.
     1912   end procedure.
     1913   procedure gate-clb_fill-xml-tables :
     1914   define input parameter p-dsh as handle no-undo .
     1915   define input-output parameter p-xmlh as handle no-undo .
     1916   define variable v-ii as integer no-undo .
     1917     do
     1918     on error undo, return error
     1919     :
     1920       do v-ii = 1 to p-dsh:num-buffers:
     1921         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     1922         if not p-xmlh:available then do:
     1923           p-xmlh:buffer-create().
     1924           assign
     1925           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     1926           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1927           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1928           p-xmlh::gate-handle_ = p-dsh
     1929           p-xmlh::uniq-gate-rec = entry(2, p-dsh:private-data, chr(4))
     1930           p-xmlh::gate-name = p-dsh:name
     1931           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1932           .
     1933           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1934             assign
     1935             p-xmlh::order = -3.
     1936           end.
     1937           p-xmlh:buffer-release().
     1938         end.
     1939       end.
     1940     end.
     1941   end procedure.
     1942   procedure all-gates-empty :
     1943   define buffer buf_temp-xml-tables for temp-xml-tables.
     1944   do
     1945   on error undo, return error
     1946   :
     1947     for each buf_temp-xml-tables
     1948     break
     1949     by buf_temp-xml-tables.uniq-gate-rec
     1950     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1951     on stop   undo , return error substitute( "&1. stop", vss-workfile )
     1952     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     1953     :
     1954       if valid-handle(buf_temp-xml-tables.tbl-handle_) then do:
     1955         buf_temp-xml-tables.tbl-handle_:empty-temp-table().
     1956       end.
     1957     end.
     1958   end.
     1959   end procedure.
     1960   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1961   function octal-to-char return character
     1962   ( p-string as character ) :
     1963     def var v-asc     as integer no-undo .
     1964     def var v-new-asc as integer no-undo .
     1965     def var ind       as integer no-undo .
     1966     if length(p-string) <> 3 then do:
     1967       return ? .
     1968     end.
     1969     assign
     1970       v-asc = 0
     1971     .
     1972     do ind = 1 to length(p-string)
     1973     :
     1974       assign
     1975         v-new-asc = asc(substring(p-string, ind, 1)) - asc('0')
     1976       .
     1977       if v-new-asc < 0 or v-new-asc >= 8 then do:
     1978         return ? .
     1979       end.
     1980       assign
     1981         v-asc = v-asc * 8 + v-new-asc
     1982       .
     1983     end.
     1984     return chr(v-asc) .
     1985   end function .
     1986   function char-to-octal return character
     1987   ( p-chr as character ) :
     1988     def var v-asc    as integer   no-undo .
     1989     def var ind      as integer   no-undo .
     1990     def var v-string as character no-undo .
     1991     if length(p-chr) <> 1 then do:
     1992       return ? .
     1993     end.
     1994     assign
     1995       v-asc    = asc(p-chr)
     1996       v-string = ""
     1997     .
     1998     do ind = 1 to 3
     1999     :
     2000       assign
     2001         v-string = chr( v-asc mod 8 + asc('0')) + v-string
     2002       .
     2003       assign
     2004         v-asc = truncate(v-asc / 8, 0)
     2005       .
     2006     end.
     2007     return v-string .
     2008   end.
     2009   function str-encode return character
     2010   (   p-init-string       as character
     2011     , p-encode-char       as character
     2012     , p-special-char-list as character
     2013   ) :
     2014     def var p-encode-string as character no-undo .
     2015     def var ind                as integer no-undo .
     2016     def var v-num-special-char as integer no-undo .
     2017     def var v-special-char     as character no-undo .
     2018     if p-encode-char = ?
     2019     or p-encode-char = "" then do:
     2020       assign
     2021         p-encode-char = "~~"
     2022       .
     2023     end.
     2024     if p-init-string = ? then do:
     2025       return "?" .
     2026     end.
     2027     if p-init-string = "?" then do:
     2028       return p-encode-char + char-to-octal("?") .
     2029     end.
     2030     assign
     2031       v-num-special-char = length(p-special-char-list)
     2032       p-encode-string    = replace(p-init-string
     2033                                   ,p-encode-char
     2034                                   ,p-encode-char + char-to-octal(p-encode-char)
     2035                                   )
     2036     .
     2037     do ind = 1 to v-num-special-char
     2038     :
     2039       assign
     2040         v-special-char = substring(p-special-char-list, ind, 1)
     2041       .
     2042       if v-special-char <> p-encode-char then do:
     2043         assign
     2044           p-encode-string = replace (p-encode-string
     2045                                     ,v-special-char
     2046                                     ,p-encode-char + char-to-octal(v-special-char)
     2047                                     )
     2048         .
     2049       end.
     2050     end.
     2051     return p-encode-string .
     2052   end.
     2053   function str-decode returns character
     2054     (p-init-string   as character
     2055     ,p-encode-char   as character
     2056     ) :
     2057     def var p-decode-string as character no-undo .
     2058     def var ind                       as integer no-undo .
     2059     def var v-num-entries-init-string as integer no-undo .
     2060     def var v-sub-phrase              as character no-undo .
     2061     def var v-special-char            as character no-undo .
     2062     if p-encode-char = ?
     2063     or p-encode-char = "" then do:
     2064       assign
     2065         p-encode-char = "~~"
     2066       .
     2067     end.
     2068     if p-init-string = "?" then do:
     2069       return ? .
     2070     end.
     2071     assign
     2072       v-num-entries-init-string = num-entries(p-init-string, p-encode-char)
     2073     .
     2074     if v-num-entries-init-string > 1 then do:
     2075       assign
     2076         p-decode-string = entry(1, p-init-string, p-encode-char)
     2077       .
     2078       do ind = 2 to v-num-entries-init-string
     2079       :
     2080         assign
     2081           v-sub-phrase = entry(ind, p-init-string, p-encode-char)
     2082         .
     2083         assign
     2084           v-special-char = octal-to-char(substring(v-sub-phrase, 1, 3))
     2085         .
     2086         if v-special-char <> ? then do:
     2087           assign
     2088             p-decode-string = p-decode-string
     2089                             + v-special-char
     2090                             + substring(v-sub-phrase, 4)
     2091           .
     2092         end.
     2093         else do:
     2094           assign
     2095             p-decode-string = p-decode-string
     2096                             + p-encode-char
     2097                             + v-sub-phrase
     2098           .
     2099         end.
     2100       end.
     2101     end.
     2102     else do:
     2103       assign
     2104         p-decode-string = p-init-string
     2105       .
     2106     end.
     2107     return p-decode-string .
     2108   end.
     2109   define variable v-obj-type   as character no-undo .
     2110   define variable v-obj-code   as integer   no-undo .
     2111   define variable v-command    as character no-undo .
     2112   define variable v-source-db-num as integer no-undo .
