     2124   define buffer buf_temp-xml-tables for temp-xml-tables.
     2125   v-xmlh = buffer buf_temp-xml-tables:handle.
     2126   do
     2127   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2128   on stop   undo, return error substitute( "&1. stop", vss-workfile )
     2129   on endkey undo, return error substitute( "&1. endkey", vss-workfile )
     2130   :
