     2140                                               ,input-output v-longchar
     2141                                               ) no-error.
     2142       if error-status:error then do:
     2143           return error substitute( "&1 (imp-bush). Ошибка при создании временных таблиц (1)", vss-workfile ) .
     2144       end.
     2145     end.
     2146     case v-command
