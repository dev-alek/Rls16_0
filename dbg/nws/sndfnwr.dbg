        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter p-parent-handle  as widget-handle no-undo .
        4   define input parameter p-log-handle  as handle no-undo .
        5   define input parameter p-parameter   as character no-undo .
        6   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        7   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        8   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        9   define variable vss-workfile    as character no-undo init "$Workfile: sndfnwr.p $":U .
       10   define variable vss-archive     as character no-undo init "$Archive: nws/sndfnwr.p $":U .
       11   define variable vss-description as character no-undo init "Пересылка масива файлов на массив БД".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define new global shared variable g#library  as handle no-undo .
       71   define new global shared variable g#library2 as handle no-undo .
       72   define   shared variable g#auto as logical no-undo.
       73   define   shared variable g#news as logical no-undo.
       74   define   shared variable g#oxml as logical no-undo.
       75   define   shared variable g#esys as logical no-undo.
       76   define   shared variable g#news-source-db as integer no-undo.
       77   define   shared variable g#esys-source-esys as integer no-undo.
       78   define   shared variable g#db-num as integer   no-undo .
       79   define   shared variable g#userid as character no-undo .
       80   define   shared variable g#passwd as character no-undo .
       81   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       82   function prepare-path returns character ( input p-nonprepared-path as character ):
       83   define variable v-prepared-path as character no-undo .
       84   assign
       85   v-prepared-path = replace(p-nonprepared-path, chr(92), chr(47))
       86   v-prepared-path = right-trim(v-prepared-path, chr(47))
       87   .
       88   return v-prepared-path.
       89   END FUNCTION.
       90   function prepare-path2 returns character ( input p-nonprepared-path as character ):
       91   define variable v-prepared-path as character no-undo .
       92   assign
       93   v-prepared-path = replace(p-nonprepared-path, chr(47), chr(92))
       94   v-prepared-path = right-trim(v-prepared-path, chr(92))
       95   .
       96   return v-prepared-path.
       97   END FUNCTION.
       98   function quote-spaces returns character ( input p-full-path as character):
       99   define variable v-ii as integer no-undo .
      100   define variable v-result as character no-undo .
      101   do v-ii = 1 to num-entries(p-full-path, chr(92)):
      102     v-result = v-result + (if v-ii = 1 then '' else chr(92)) +
      103                (if index(entry(v-ii, p-full-path, chr(92)), chr(32)) > 0
      104                then  substitute("&1&2&1", chr(34), entry(v-ii, p-full-path, chr(92)))
      105                else entry(v-ii, p-full-path, chr(92))
      106                )
      107     .
      108   end.
      109   return v-result.
      110   end function.
      111   define variable v-view-log as logical no-undo .
      112   define variable log-file-name as character no-undo init "sndfrnwr.txt".
      113   define shared temp-table tt-ext-file no-undo like ub.ext-file.
      114   define shared temp-table tt-db       no-undo like ub.db.
      115   define shared temp-table tt-ext-file-par no-undo like ub.ext-file-par.
      116   define buffer buf_tt-db for tt-db.
      117   define buffer buf_tt-ext-file for tt-ext-file.
      118   define buffer locked_ext-file for ub.ext-file.
      119   define buffer buf_ext-file for ub.ext-file.
      120   define buffer last_ext-file for ub.ext-file.
      121   define variable p-mode as character no-undo .
      122   define variable p-path-type as integer no-undo.
      123   define variable p-path as character no-undo .
      124   define variable p-status_  as character no-undo .
      125   define variable v-file-num as integer no-undo .
      126   define variable v-start as logical no-undo .
      127   define variable v-cycled as logical no-undo .
      128   define variable v-start-search as integer no-undo .
      129   define variable v-current-db-num as integer no-undo .
      130   define variable v-file-num-sign as integer no-undo .
      131   FUNCTION get-char-path-type  returns CHARACTER ( input p-path-type as integer, input p-mode as character):
      132   if p-mode = 'save-db':U
      133   or p-mode = 'save-db-and-run':U
      134   or p-mode = 'save-this-db':U
      135   then do:
      136     return '':U.
      137   end.
      138   CASE p-path-type:
      139     when 0 then do:
      140       return "Относительный".
      141     end.
      142     when 1 then do:
      143       return "Абсолютный".
      144     end.
      145     when 2 then do:
      146       return "По настройкам ini-файла IBS TH".
      147     end.
      148   END CASE.
      149   END FUNCTION.
      150   assign
      151   p-mode          = entry(1, p-parameter, chr(4))
      152   p-path-type     = integer(entry(2, p-parameter, chr(4)))
      153   p-path          = entry(3, p-parameter, chr(4))
      154   p-status_        = entry(4, p-parameter, chr(4))
      155   no-error
      156   .
      157   if error-status:error then do:
      158     run write-log-and-file in p-log-handle (
      159           input 1
      160         , input log-file-name
      161         , input 1
      162         , input substitute("!!!Ошибка входных параметров &1:&2&3&4"
      163                            , p-parameter
      164                            , chr(10)
      165                            , error-status:get-message(1)
      166                            , return-value
      167                            )).
      168     assign
      169     v-view-log = yes.
      170   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      171   if v-view-log
      172   and not g#news
      173   and not g#auto
      174   then do:
      175     message
      176     '!!!При пересылке/сохранении файлов произошли ошибки!!!'  skip
      177     "!!!Внимательно прочитайте Log-file!!"
      178     view-as alert-box error .
      179        define variable v-user-action2   as character no-undo .
      180     define variable v-printed2       as logical   no-undo .
      181     run gbl/prnfilen.w
      182       (input  ('!!!При пересылке/сохранении файлов произошли ошибки!!!')
      183       ,input  0
      184       ,input  (string("./":U) + 'sndfrnwr.txt')
      185       ,input  7
      186       ,output v-user-action2
      187       ,output v-printed2
      188       ) .
      189   end.
      190   if v-view-log = true
      191   and (g#news
      192   or g#auto)
      193   and valid-handle(p-parent-handle) and lookup("cb_set-view-log", p-parent-handle:internal-entries) > 0
      194   then do:
      195      run cb_set-view-log in p-parent-handle ( input yes).
      196   end.
      197   if not v-view-log and search("cdviewlg_do-not-delete-log-file.txt") = ? then do:
      198     OS-DELETE value(string("./":U) + 'sndfrnwr.txt').
      199   end.
      200                           return.
      201   end.
      202   v-current-db-num = - 1.
      203   if (p-mode = 'save-this-db':U
      204           or
      205           (p-mode = 'save-install':U
      206           and
      207           p-status_ = 'manual':U)
      208      ) then do:
      209     run write-log-and-file in p-log-handle (
      210           input 1
      211         , input log-file-name
      212         , input 1
      213         , input substitute("Сохранение файлов&1" +
      214                             "режим &2&1"
      215                           , chr(10)
      216                           , p-mode
      217                           )).
      218   end.
      219   else do:
      220     run write-log-and-file in p-log-handle (
      221           input 1
      222         , input log-file-name
      223         , input 1
      224         , input substitute("Пересылка файлов&1" +
      225                             "режим &2, тип пути к файлу на удаленном компьютере &3,&1" +
      226                             "Путь &4"
      227                           , chr(10)
      228                           , p-mode
      229                           , get-char-path-type ( input p-path-type, p-mode)
      230                           , p-path
      231                           )).
      232   end.
      233   for EACH buf_tt-db NO-LOCK,
      234       EACH buf_tt-ext-file NO-LOCK:
      235     if buf_tt-db.db-num <> v-current-db-num then do:
      236         run write-log-and-file in p-log-handle (
      237               input 1
      238             , input log-file-name
      239             , input 1
      240             , input substitute("------------БД &2&1"
      241                               , chr(10)
      242                               , buf_tt-db.db-num
      243                               )).
      244      end.
      245      v-current-db-num = buf_tt-db.db-num.
      246      main-block:
      247      do
      248      on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      249      on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      250      on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      251      :
      252       v-file-num = next-value(s-sost, ub).
      253         if p-mode = 'save-this-db':U
      254         or (p-mode = 'save-install':U
      255             and
      256             p-status_ = 'manual':U) then do:
      257           v-file-num-sign = - 1.
      258         end.
      259         else do:
      260           v-file-num-sign = 1.
      261       end.
      262       v-file-num = v-file-num * v-file-num-sign.
      263       create buf_ext-file.
      264       buffer-copy buf_tt-ext-file except status_ db-num from-db-num file-num to buf_ext-file
      265       assign
      266       buf_Ext-file.status_ = (if p-status_ = '':U then p-mode else p-status_)
      267       buf_ext-file.db-num = buf_tt-db.db-num
      268       buf_ext-file.from-db-num = g#db-num
      269       buf_ext-file.file-num = v-file-num
      270       buf_Ext-file.update-user-name = g#userid
      271       .
      272         run write-log-and-file in p-log-handle (
      273               input 1
      274             , input log-file-name
      275             , input 1
      276             , input substitute("Файл &1"
      277                               , buf_tt-ext-file.file-name
      278                               )).
      279       if p-status_ = 'auto':U
      280       or p-status_ = ""
      281       then do:
      282         run nws/bin-e.p (
      283                        input buf_ext-file.db-num
      284                       ,input buf_ext-file.from-db-num
      285                       ,INPUT v-file-num
      286                       ,input buf_tt-ext-file.file-name
      287                       ,input p-path-type
      288                       ,input p-path
      289                       ,input p-mode
      290                       ,input buf_tt-ext-file.status_
      291                       ,buffer buf_ext-file
      292                       ,input table tt-ext-file-par
      293                       ) no-error.
      294         if error-status:error then do:
      295             run write-log-and-file in p-log-handle (
      296                   input 1
      297                 , input log-file-name
      298                 , input 1
      299                 , input substitute("!!!Ошибка при пересылке файла на БД &8&1" +
      300                                   "режим &2, тип пути к файлу на удаленном компьютере &3,&1" +
      301                                   "Путь &4,&1" +
      302                                   "Файл &5,&1&6&1БД &7 (от БД &8)"
      303                                   , chr(10)
      304                                   , p-mode
      305                                   , get-char-path-type ( input p-path-type, p-mode)
      306                                   , p-path
      307                                   , buf_tt-ext-file.file-name
      308                                   , error-status:get-message(1)
      309                                   , return-value
      310                                   , buf_tt-db.db-num
      311                                   , g#db-num
      312                                   )).
      313             assign
      314             v-view-log = yes.
      315         end.
      316         else do:
      317           if valid-handle(p-parent-handle)
      318           and lookup("cb_set-ext-file_file-num", p-parent-handle:internal-entries) > 0 then do:
      319             run cb_set-ext-file_file-num in p-parent-handle ( input buf_ext-file.db-num
      320                                                              ,input buf_ext-file.from-db-num
      321                                                              ,input v-file-num) no-error.
      322           end.
      323         end.
      324         if p-mode <> 'save-db':U
      325         and p-mode <> 'save-db-and-run':U
      326         and p-mode <> 'save-this-db':U then do:
      327         assign
      328         buf_ext-file.file-name = buf_ext-file.file-name  + '>' + prepare-path(p-path).
      329       end.
      330       end.
      331     end.
      332   END.
      333   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      334   if v-view-log
      335   and not g#news
      336   and not g#auto
      337   then do:
      338     message
      339     '!!!При пересылке/сохранении файлов произошли ошибки!!!'  skip
      340     "!!!Внимательно прочитайте Log-file!!"
      341     view-as alert-box error .
      342        define variable v-user-action4   as character no-undo .
      343     define variable v-printed4       as logical   no-undo .
      344     run gbl/prnfilen.w
      345       (input  ('!!!При пересылке/сохранении файлов произошли ошибки!!!')
      346       ,input  0
      347       ,input  (string("./":U) + 'sndfrnwr.txt')
      348       ,input  7
      349       ,output v-user-action4
      350       ,output v-printed4
      351       ) .
      352   end.
      353   if v-view-log = true
      354   and (g#news
      355   or g#auto)
      356   and valid-handle(p-parent-handle) and lookup("cb_set-view-log", p-parent-handle:internal-entries) > 0
      357   then do:
      358      run cb_set-view-log in p-parent-handle ( input yes).
      359   end.
      360   if not v-view-log and search("cdviewlg_do-not-delete-log-file.txt") = ? then do:
      361     OS-DELETE value(string("./":U) + 'sndfrnwr.txt').
      362   end.
      363                           return.
