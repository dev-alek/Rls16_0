        1   block-level on error undo, throw.
        2   define input  parameter p-db-list  as character no-undo .
        3   define output parameter p-err-code as integer no-undo .
        4   def var vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        5   def var vss-author      as character no-undo init "$Author: expertek $":U .
        6   def var vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        7   def var vss-workfile    as character no-undo init "$Workfile: cnew-pck.p $":U .
        8   def var vss-archive     as character no-undo init "$Archive: nws/cnew-pck.p $":U .
        9   def var vss-description as character no-undo init "Нарезка новых пакетов".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       69   define  shared variable g#auto-pid           as integer   no-undo .
       70   define  shared variable conn-par             as character no-undo .
       71   define  shared variable g#auto-user-id       as character no-undo .
       72   define  shared variable g#auto-user-login    as character no-undo .
       73   define  shared variable g#auto-user-password as character no-undo .
       74   define  shared variable v-socket             as logical   no-undo .
       75   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       76   define  shared variable auto-window-h     as handle    no-undo .
       77   define  shared variable auto-log-msg-h    as handle    no-undo .
       78   define  shared variable hand-log-msg-h    as handle    no-undo .
       79   define  shared variable log-file-name     as character no-undo initial ? .
       80   define  shared variable add-log-file-name as character no-undo initial ? .
       81   define  shared variable writelogvalue     as character no-undo initial ? .
       82   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       83   procedure cur-time :
       84      define output parameter p-today as date      no-undo .
       85      define output parameter p-time  as integer   no-undo .
       86     do
       87     on error undo, return error
       88     :
       89       define variable v-date1 as date      no-undo .
       90       define variable v-date2 as date      no-undo .
       91       define variable v-time  as integer   no-undo .
       92       assign
       93         v-date1 = today
       94         v-time  = time
       95         v-date2 = today
       96       .
       97       if v-date1 <> v-date2
       98       then do:
       99         assign
      100           v-date1 = today
      101           v-time  = v-time
      102         .
      103       end.
      104       assign
      105         p-today = v-date1
      106         p-time  = v-time
      107       .
      108     end.
      109   end.
      110   function cur-time-date returns character
      111   :
      112     return string(today, '99/99/9999':U) .
      113   end.
      114   function cur-time-mjd returns decimal
      115   :
      116     define variable v-date as date      no-undo .
      117     define variable v-time as integer   no-undo .
      118     run cur-time in this-procedure
      119       (output v-date
      120       ,output v-time
      121       ) .
      122     return integer(v-date) - 2400002 + (v-time / 86400) .
      123   end.
      124   function cur-time-get-ending-index returns integer
      125   (input p-number as integer
      126   )
      127   :
      128     if p-number < 0
      129     or p-number = ?
      130     then do:
      131       return 1 .
      132     end.
      133     define variable v-rest as integer   no-undo .
      134     assign
      135       p-number = p-number modulo 100
      136     .
      137     if p-number < 20
      138     then do:
      139       assign
      140         v-rest = p-number
      141       .
      142     end.
      143     else do:
      144       assign
      145         v-rest = p-number modulo 10
      146       .
      147     end.
      148     case v-rest :
      149       when 1
      150       then do:
      151         return 2 .
      152       end.
      153       when 2 or
      154       when 3 or
      155       when 4
      156       then do:
      157         return 3 .
      158       end.
      159       otherwise do:
      160         return 1 .
      161       end.
      162     end case .
      163   end.
      164   procedure cur-time-mjd-to-date :
      165      define input  parameter i-mjd-diff as decimal no-undo.
      166      define output parameter o-Date     as date    no-undo.
      167      define output parameter o-Time     as integer no-undo.
      168      define variable v-day-number as integer   no-undo .
      169      if    i-mjd-diff < 0
      170         or i-mjd-diff = ?
      171      then do:
      172         return "?" .
      173      end.
      174      assign
      175         v-day-number = truncate(i-mjd-diff,0).
      176         o-Date = date(v-day-number + 2400002).
      177         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      178     .
      179   end.
      180   function cur-time-mjd-to-string returns character
      181   (input p-mjd-diff as decimal
      182   )
      183   :
      184     define variable v-day-number as integer   no-undo .
      185     define variable v-seconds    as integer   no-undo .
      186     define variable v-hour       as integer   no-undo .
      187     define variable v-min        as integer   no-undo .
      188     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      189     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      190     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      191     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      192     if p-mjd-diff < 0
      193     or p-mjd-diff = ?
      194     then do:
      195       return "?" .
      196     end.
      197     assign
      198       v-day-number = integer(truncate(p-mjd-diff,0))
      199       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      200     .
      201     if v-seconds > 86400
      202     then do:
      203       assign
      204         v-seconds = 86400 - 1
      205       .
      206     end.
      207     if v-seconds < 0
      208     then do:
      209       assign
      210         v-seconds = 0
      211       .
      212     end.
      213     assign
      214       v-hour = truncate(v-seconds / 3600, 0)
      215     .
      216     assign
      217       v-seconds = v-seconds modulo 3600
      218     .
      219     assign
      220       v-min = truncate(v-seconds / 60, 0)
      221     .
      222     assign
      223       v-seconds = v-seconds modulo 60
      224     .
      225     return
      226         (if v-day-number <> 0
      227           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      228           else ""
      229         )
      230       + (if v-day-number <> 0 or v-hour <> 0
      231           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      232           else ""
      233         )
      234       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      235           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      236           else ""
      237         )
      238       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      239       .
      240   end.
      241   function cur-time-string returns character
      242   :
      243     define variable v-date as date      no-undo .
      244     define variable v-time as integer   no-undo .
      245     run cur-time in this-procedure
      246       (output v-date
      247       ,output v-time
      248       ) .
      249     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      250   end.
      251   function cur-time-string-sec returns character
      252   :
      253     define variable v-date as date      no-undo .
      254     define variable v-time as integer   no-undo .
      255     run cur-time in this-procedure
      256       (output v-date
      257       ,output v-time
      258       ) .
      259     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      260   end.
      261   function cur-time-custom  returns character
      262   (input p-prefix as character
      263   ,input p-date-format as character
      264   ,input p-delimiter as character
      265   ,input p-time-format as character
      266   ,input p-suffix as character
      267   )
      268   :
      269     define variable v-date as date      no-undo .
      270     define variable v-time as integer   no-undo .
      271     run cur-time in this-procedure
      272       (output v-date
      273       ,output v-time
      274       ) .
      275     return
      276       p-prefix
      277       + string(v-date, p-date-format)
      278       + p-delimiter
      279       + string(v-time, p-time-format)
      280       + p-suffix
      281       .
      282   end.
      283   function cur-time-print  returns character
      284   :
      285     define variable v-date as date      no-undo .
      286     define variable v-time as integer   no-undo .
      287     run cur-time in this-procedure
      288       (output v-date
      289       ,output v-time
      290       ) .
      291     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      292   end.
      293   function cur-time-datetime returns datetime
      294   :
      295     define variable v-char as character no-undo .
      296     define variable v-datetime as datetime no-undo .
      297     v-char = cur-time-string().
      298     v-datetime = datetime(v-char).
      299     return  v-datetime.
      300   end.
      301   function cur-time-string-msec returns character
      302   :
      303     define variable v-date as datetime  no-undo .
      304     v-date = now.
      305     return string(v-date) .
      306   end.
      307   define stream LogStream .
      308   define variable mNoTime as logical no-undo.
      309   procedure write-to-log-notime :
      310     define input param i-str as character no-undo .
      311     mNoTime = yes.
      312     run write-to-log (i-str).
      313     mNoTime = no.
      314   end.
      315   procedure write-to-log :
      316     define input param p-str as character no-undo .
      317     do
      318     on error  undo, return error substitute( "&1 (write-to-log). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      319     on stop   undo, return error substitute( "&1 (write-to-log). stop", vss-workfile )
      320     on endkey undo, return error substitute( "&1 (write-to-log). endkey", vss-workfile )
      321     :
      322       define variable log-res        as logical   no-undo .
      323       define variable v-jj           as integer   no-undo .
      324       if    mNoTime
      325          or writelogvalue eq "AsyncProc"
      326       then
      327          p-str = substitute( "&1 (pid: &2) &3&4"   , g#auto-user-id, g#auto-pid,                        p-str, chr(10) ).
      328       else
      329          p-str = substitute( "&1 (pid: &2) &3 &4&5", g#auto-user-id, g#auto-pid, cur-time-string-sec(), p-str, chr(10) ).
      330       if auto-log-msg-h <> ? then do:
      331         log-res = auto-log-msg-h:move-to-eof( ) .
      332         log-res = auto-log-msg-h:insert-string( p-str ).
      333       end.
      334       if hand-log-msg-h <> ? then do:
      335         log-res = hand-log-msg-h:move-to-eof( ) .
      336         log-res = hand-log-msg-h:insert-string( p-str ).
      337       end.
      338       assign
      339         p-str = replace(p-str, (chr(10) + chr(13)), chr(10) )
      340         p-str = replace(p-str, (chr(13) + chr(10)), chr(10) )
      341         p-str = replace(p-str, chr(10), (chr(13) + chr(10)) )
      342       .
      343       if add-log-file-name <> ? then do:
      344         do v-jj = 1 to num-entries(add-log-file-name, chr(1)):
      345           run gbl/fileapnd.p
      346             ( input entry(v-jj, add-log-file-name, chr(1) )
      347             ,input p-str
      348             ,input 20
      349             ) no-error .
      350           if error-status:error then do:
      351             return error return-value .
      352           end.
      353         end.
      354       end.
      355       if writelogvalue eq "AsyncProc"
      356       then do:
      357          p-str = trim(p-str, (chr(13) + chr(10)) )
      358       .
      359          Publish "WriteLogAsunc" (p-str,yes).
      360       end.
      361       else if writelogvalue <> "yes" then do:
      362         run gbl/fileapnd.p
      363           ( input log-file-name
      364           ,input p-str
      365           ,input 20
      366           ) no-error .
      367         if error-status:error then do:
      368           return error return-value .
      369         end.
      370       end.
      371     end.
      372   end procedure.
      373   procedure write-to-screen :
      374     define input param p-str as character no-undo .
      375     do
      376     on error  undo, return error substitute( "&1 (write-to-screen). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      377     on stop   undo, return error substitute( "&1 (write-to-screen). stop", vss-workfile )
      378     on endkey undo, return error substitute( "&1 (write-to-screen). endkey", vss-workfile )
      379     :
      380       define variable log-res as logical no-undo.
      381       assign
      382         p-str = substitute( "&1 (pid: &2) &3 &4&5", g#auto-user-id, g#auto-pid, cur-time-string-sec(), p-str, chr(10) )
      383       .
      384       if auto-log-msg-h <> ?
      385       then do:
      386         log-res = auto-log-msg-h:move-to-eof( ) .
      387         log-res = auto-log-msg-h:insert-string( p-str ).
      388       end.
      389       if hand-log-msg-h <> ?
      390       then do:
      391         log-res = hand-log-msg-h:move-to-eof( ) .
      392         log-res = hand-log-msg-h:insert-string( p-str ).
      393       end.
      394     end.
      395   end procedure.
      396   procedure send-msg-to-email :
      397     define input  parameter p-subject      as character no-undo .
      398     define input  parameter p-text-err     as character no-undo .
      399     define input  parameter p-attach-files as character no-undo .
      400     do
      401     on error  undo, return error substitute( "&1 (send-msg-to-email). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      402     on stop   undo, return error substitute( "&1 (send-msg-to-email). stop", vss-workfile )
      403     on endkey undo, return error substitute( "&1 (send-msg-to-email). endkey", vss-workfile )
      404     :
      405       define variable v-tth             as handle    no-undo .
      406       define variable v-value-character as character no-undo .
      407       define variable v-value-date      as date      no-undo .
      408       define variable v-value-decimal   as decimal   no-undo .
      409       define variable v-value-integer   as integer   no-undo .
      410       define variable v-value-logical   as logical   no-undo .
      411       define variable v-param-type      as character no-undo .
      412       define variable v-email       as character no-undo .
      413       define variable v-tmp-str     as character no-undo .
      414       define variable v-tmp1-str    as character no-undo .
      415       define variable v-ind         as integer   no-undo .
      416       define variable v-num-entries as integer   no-undo .
      417       delete object v-tth no-error.
      418       run adm/shattri.p
      419         ( input "get":U
      420          ,input  "":U
      421          ,input  0
      422          ,input  'auto-task':U
      423          ,input  'send-msg-to-email':U
      424          ,output v-value-character
      425          ,output v-value-date
      426          ,output v-value-decimal
      427          ,output v-value-integer
      428          ,output v-value-logical
      429          ,output v-param-type
      430          ,input-output table-handle v-tth
      431         ) no-error .
      432       if not error-status :error  then do:
      433         assign
      434           v-tmp-str = v-value-character
      435         .
      436       end.
      437       delete object v-tth no-error.
      438       assign
      439         v-tmp-str     = replace(v-tmp-str, (chr(10) + chr(13)), chr(44) )
      440         v-tmp-str     = replace(v-tmp-str, (chr(13) + chr(10)), chr(44) )
      441         v-tmp-str     = replace(v-tmp-str, chr(10), chr(44) )
      442         v-num-entries = num-entries( v-tmp-str, chr(44) )
      443         v-email       = "":U
      444       .
      445       do v-ind = 1 to v-num-entries
      446       :
      447         assign
      448           v-tmp1-str = entry( v-ind, v-tmp-str, chr(44) )
      449         .
      450         if trim( v-tmp1-str ) <> "":U then do:
      451           if v-email = "":U then do:
      452             assign
      453               v-email = v-tmp1-str
      454             .
      455           end.
      456           else do:
      457             assign
      458               v-email = v-email + chr(44) + v-tmp1-str
      459             .
      460           end.
      461         end.
      462       end.
      463       if v-email <> "":U then do:
      464         run gbl/sendmail.p
      465           ( input v-email
      466           , input p-subject
      467           , input p-text-err
      468           , input p-attach-files
      469           ) no-error .
      470         if error-status :error
      471           or return-value <> "":U
      472         then do:
      473           return error substitute( "&1 (send-msg-to-email). &2", vss-workfile, return-value ) .
      474         end.
      475       end.
      476     end.
      477   end procedure.
      478   def var vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      479   procedure check-need-onlinebkp :
      480     define output parameter p-need-bkp as logical   no-undo .
      481     do
      482     on error  undo, return error substitute( "&1. &2&3&4", vss-include-info3, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      483     on stop   undo, return error substitute( "&1. stop", vss-include-info3 )
      484     on endkey undo, return error substitute( "&1. endkey", vss-include-info3 )
      485     :
      486       define variable v-run-bkp-str as character no-undo .
      487       get-key-value section "onlinebkp"
      488                         key "run-bkp"
      489                       value v-run-bkp-str.
      490       if v-run-bkp-str = ?
      491         or CAPS( v-run-bkp-str ) = "FALSE":U
      492         or CAPS( v-run-bkp-str ) = "NO":U
      493       then do:
      494         assign
      495           p-need-bkp = false
      496         .
      497       end.
      498       else do:
      499         assign
      500           p-need-bkp = true
      501         .
      502       end.
      503       return .
      504     end.
      505   end procedure.
      506   define temp-table tt-db-pck-cr no-undo
      507     field db-num      as integer
      508     field cre-all-pck as logical
      509     index pi as unique primary db-num
      510     index cr cre-all-pck
      511     .
      512   do
      513   on error undo, return error
      514   :
      515     define variable v-ind                    as integer   no-undo .
      516     define variable num-entries-pres-db-list as integer   no-undo .
      517     define variable v-pres-db-list           as character no-undo .
      518     define variable v-err-gen-pack           as integer   no-undo .
      519     define variable v-message                as character no-undo .
      520     define variable v-msg                    as character no-undo .
      521     define variable v-need-bkp               as logical   no-undo .
      522     define variable v-db-num                 as integer   no-undo .
      523     define variable v-all-pck-cre            as logical   no-undo .
      524     define buffer buf_sys-ctrl for ub.sys-ctrl .
      525     find first buf_sys-ctrl no-lock .
      526     assign
      527       p-err-code = 0
      528     .
      529     if p-db-list <> ?
      530       and trim( p-db-list ) <> "":U
      531     then do:
      532       run check-need-onlinebkp in this-procedure
      533         ( output v-need-bkp
      534         ) no-error .
      535       if error-status :error then do:
      536         message
      537           vss-workfile vss-revision vss-description skip
      538           "Ошибка при определении необходимости проведения onlinebkp" skip
      539           error-status :get-message(1) skip
      540           return-value skip
      541           view-as alert-box error .
      542       end.
      543     end.
      544     else do:
      545       assign
      546         v-need-bkp = true
      547       .
      548     end.
      549     if buf_sys-ctrl.db-num = 0 then do:
      550       run nws/pres-db.p
      551         ( output v-pres-db-list
      552          ,output v-msg
      553         ) no-error .
      554       if error-status :error then do:
      555         assign
      556           v-pres-db-list = "":U
      557           p-err-code     = 1
      558         .
      559         return error substitute( "&1. Ошибка при подготовке списка действующих УБД &2&3&4"
      560                                  ,vss-workfile
      561                                  ,chr(10)
      562                                  ,error-status:get-message(error-status:num-messages)
      563                                  ,chr(10)
      564                                  ,return-value
      565                                ) .
      566       end.
      567       if v-msg <> "":U  then do:
      568         if v-message = "":U then do:
      569           assign
      570             v-message = v-msg
      571           .
      572         end.
      573         else do:
      574           assign
      575             v-message = v-message + chr(10) + v-msg
      576           .
      577         end.
      578       end.
      579     end.
      580     else do:
      581       assign
      582         v-pres-db-list = "0":U
      583       .
      584     end.
      585     for each tt-db-pck-cr
      586     on error undo, return error return-value
      587     :
      588       delete tt-db-pck-cr.
      589     end.
      590     assign
      591       num-entries-pres-db-list = num-entries( v-pres-db-list )
      592     .
      593     do v-ind = 1 to num-entries-pres-db-list
      594     on error undo, return error
      595     :
      596       assign
      597         v-db-num = integer( entry( v-ind, v-pres-db-list ) )
      598       .
      599       if v-need-bkp = true
      600         or ( v-need-bkp = false
      601              and lookup( string( v-db-num ), p-db-list ) > 0
      602            )
      603       then do:
      604         find first tt-db-pck-cr
      605           where tt-db-pck-cr.db-num = v-db-num
      606           no-error .
      607         if not available tt-db-pck-cr then do:
      608           create tt-db-pck-cr.
      609           assign
      610             tt-db-pck-cr.db-num      = v-db-num
      611             tt-db-pck-cr.cre-all-pck = false
      612             .
      613         end.
      614       end.
      615     end.
      616     assign
      617       v-all-pck-cre = false
      618     .
      619     do while v-all-pck-cre <> true
      620     on error undo, return error
      621     :
      622       for each tt-db-pck-cr
      623         where tt-db-pck-cr.cre-all-pck = false
      624       on error undo, return error
      625       :
      626         if tt-db-pck-cr.cre-all-pck = false then do:
      627           if buf_sys-ctrl.db-num = 0 then do:
      628             assign
      629               add-log-file-name = substring( log-file-name, 1, r-index( log-file-name, '.':u) - 1 ) + substitute( "-&1.log", tt-db-pck-cr.db-num )
      630             .
      631           end.
      632           run nws/cre-pck.p
      633             ( input  tt-db-pck-cr.db-num
      634              ,output v-err-gen-pack
      635              ,output tt-db-pck-cr.cre-all-pck
      636             ) no-error .
      637           if error-status :error
      638             or v-err-gen-pack = 2
      639           then do:
      640             assign
      641               add-log-file-name = ?
      642               p-err-code = 1
      643             .
      644             return error substitute( "&1. Ошибка при подготовке нового(ых) пакета(ов) для БД &2&3&4&5&6"
      645                                     ,vss-workfile
      646                                     ,tt-db-pck-cr.db-num
      647                                     ,chr(10)
      648                                     ,error-status:get-message(error-status:num-messages)
      649                                     ,chr(10)
      650                                     ,return-value
      651                                   ) .
      652           end.
      653           assign
      654             add-log-file-name = ?
      655           .
      656         end.
      657       end.
      658       run adm/onlinbkp.p
      659         ( output v-msg )
      660         no-error .
      661       if error-status :error then do:
      662         assign
      663           p-err-code = 2
      664         .
      665         return error substitute( "&1. Ошибка при проведении backup &2&3&4&5"
      666                                   ,vss-workfile
      667                                   ,chr(10)
      668                                   ,error-status:get-message(error-status:num-messages)
      669                                   ,chr(10)
      670                                   ,return-value
      671                                 ) .
      672       end.
      673       if v-msg <> "":U then do:
      674         if v-message = "":U then do:
      675           assign
      676             v-message = v-msg
      677           .
      678         end.
      679         else do:
      680           assign
      681             v-message = v-message + chr(10) + v-msg
      682           .
      683         end.
      684       end.
      685       find first tt-db-pck-cr
      686         where tt-db-pck-cr.cre-all-pck = false
      687         no-error .
      688       if not available tt-db-pck-cr then do:
      689         assign
      690           v-all-pck-cre = true
      691         .
      692       end.
      693     end.
      694     return v-message .
      695   end.
