     2179       on error undo, return error substitute( "&1 (send-command). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     2180       :
     2181         delete for-route-dump .
     2182       end.
     2183       delete for-route .
     2184       run gate-clear in this-procedure
     2185         ( input v_dataseth
     2186         , input v-xmlh
     2187         ) no-error.
