     2190   end procedure.
     2191   procedure send-command-esys :
     2192     define input parameter p-command-code as integer   no-undo .
     2193     define input parameter p-esys-id-list      as character no-undo .
     2194     define input parameter p-user-name    as character no-undo .
     2195     define output parameter p-dmp-ord as int64 no-undo .
     2196     do
     2197     on error  undo, return error substitute( "&1 (send-command-esys). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     2198     on stop   undo, return error substitute( "&1 (send-command-esys). stop", vss-workfile )
     2199     on endkey undo, return error substitute( "&1 (send-command-esys). endkey", vss-workfile )
     2200     :
     2201       define buffer buf_esys-route      for ub.esys-route .
     2202       define buffer buf_esys-route-dump for ub.esys-route-dump .
     2203       define variable v-ind as integer no-undo .
     2204       define variable v-dmp-ord      like ub.esys-route.esr-dump-ord .
     2205       define variable v-rec-ord      like ub.esys-route-dump.esrd-rec-ord .
     2206       define variable v-command-name like ub.esys-route.esr-name-rec .
     2207       DEFINE VARIABLE v-cre-date as date no-undo .
     2208       DEFINE VARIABLE v-cre-time as integer no-undo .
     2209       define variable v-cre-user as character no-undo .
     2210       define variable v-act-name as character no-undo .
     2211       define variable v-oper     as character no-undo .
     2212       define buffer buf_sys-ctrl for ub.sys-ctrl.
     2213       define buffer buf_esys-all-attr for ub.esys-all-attr.
     2214       find first for-route
     2215         where for-route.dump-ord = p-command-code
     2216         no-error
     2217       .
     2218       if not available for-route then do:
     2219         return error substitute( "&1 (send-command-esys). Команда с номером &2 не создана!", vss-workfile, p-command-code ) .
     2220       end.
     2221       find first buf_sys-ctrl no-lock.
     2222       if trim( for-route.db-list ) <> "":U then do:
     2223         assign
     2224           p-esys-id-list = for-route.db-list
     2225         .
     2226       end.
     2227       do transaction
     2228       on error  undo, return error substitute( "&1 (send-command-esys). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     2229       on stop   undo, return error substitute( "&1 (send-command-esys). stop", vss-workfile )
     2230       on endkey undo, return error substitute( "&1 (send-command-esys). endkey", vss-workfile )
     2231       :
     2232         assign
     2233           v-dmp-ord = next-value( s-news-dord, ub )
     2234           v-rec-ord = 0
     2235           v-oper = ""
     2236         .
