     2004       v-xmlh = buffer buf_temp-xml-tables:handle.
     2005       find first for-route
     2006         where for-route.dump-ord = p-command-code
     2007         no-error
     2008       .
     2009       if not available for-route then do:
     2010         return error substitute( "&1 (send-command). Команда с номером &2 не создана!", vss-workfile, p-command-code ) .
     2011       end.
     2012       if trim( for-route.db-list ) <> "":U then do:
     2013         assign
     2014           p-db-list = for-route.db-list
     2015         .
     2016       end.
     2017       block_cre-route:
     2018       do transaction
     2019       on error  undo block_cre-route, return error substitute( "&1 (send-command). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     2020       on stop   undo block_cre-route, return error substitute( "&1 (send-command). stop", vss-workfile )
     2021       on endkey undo block_cre-route, return error substitute( "&1 (send-command). endkey", vss-workfile )
     2022       :
     2023         assign
     2024           v-dmp-ord = next-value( s-news-dord, ub )
     2025           v-rec-ord = 0
     2026         .
     2027         if for-route.uniq-gate-rec <> '':U then do:
     2028           define variable v-longchar as longchar no-undo .
     2029           v-longchar = ?.
     2030           run get-gate-by-rec in this-procedure ( input for-route.uniq-gate-rec
     2031                                                  ,output v_dataseth
     2032                                                  ,input-output v-xmlh
     2033                                                  ,input-output v-longchar
     2034                                                  ) no-error.
     2035           if error-status:error
     2036           then do:
     2037             return error substitute( "&1 (send-command) Ошибка при создании структуры маршрутизируемых данных согласно гейту: &2. &4&5&6"
     2038                                       , vss-workfile
     2039                                       , for-route.uniq-gate-rec
     2040                                       , return-value
     2041                                       , chr(10)
     2042                                       , error-status :get-message ( 1 ) ).
     2043           end.
     2044         end.
     2045         for each for-route-dump
     2046           where for-route-dump.dump-ord = for-route.dump-ord
     2047         on error undo, return error substitute( "&1 (send-command). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     2048         :
     2049           assign
     2050             v-rec-ord = v-rec-ord + 1
     2051           .
     2052           create buf_route-dump .
     2053           buffer-copy for-route-dump to buf_route-dump
     2054             assign
     2055               buf_route-dump.dump-ord     = v-dmp-ord
     2056               buf_route-dump.rec-ord      = v-rec-ord
     2057           .
     2058           if for-route-dump.uniq-gate-rec <> '':u then do:
     2059             find first buf_temp-xml-tables where
     2060                       buf_temp-xml-tables.tbl-name = for-route-dump.dump-name.
     2061             v-h = buf_temp-xml-tables.tbl-handle_.
     2062           end.
     2063           else do:
     2064             v-h = ?.
     2065           end.
     2066   define variable vss-include-info9 as character format "X(65)":U no-undo initial "@(#)$Workfile$ $Revision$".
     2067   if (valid-handle(g#lib-nws) <> true) then do:   run nws/lib-nws.p persistent no-error .   if error-status :error or (valid-handle(g#lib-nws) <> true) then do:     message       "Error starting nws/lib-nws.p" skip       g#lib-nws skip       g#lib-nws :type skip       g#lib-nws :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-nws_route-dump-write in g#lib-nws
     2068     ( input for-route-dump.dump-name
     2069     , input (buffer buf_route-dump:handle)
