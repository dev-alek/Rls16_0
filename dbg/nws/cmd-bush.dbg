     2076           end.
     2077         end.
     2078         assign
     2079           v-command-name = "command":U + chr(1) + "bush":U + chr(1) + for-route.name-rec
     2080           v-rt-count     = 0
     2081         .
     2082         do v-ind = 1 to num-entries(p-db-list, chr(1) )
     2083         on error undo block_cre-route, return error substitute( "&1 (send-command). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     2084         :
     2085   def var vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2086   define buffer buf10_db    for ub.db .
