     2289       vss-workfile vss-revision vss-description skip
     2290       substitute( "Попытка создать маршрутизацию на несуществующую внешнюю систему &1 для БД &2", integer(entry(v-ind,p-esys-id-list,chr(1))), 0 ) skip
     2291       return-value skip
     2292       error-status :get-message ( error-status :num-messages )
     2293       view-as alert-box error
     2294     .
     2295   end.
     2296   if buf_sys-ctrl.db-num <> buf12_ext-system.esys-db-num-exp and buf12_ext-system.esys-db-num-exp <> 0 then do:
     2297     message
     2298       vss-include-info12 skip
     2299       vss-workfile vss-revision vss-description skip
     2300       substitute( "Попытка создать маршрутизацию на ВС &1 для БД &2,&3" +
     2301                   "в БД &4,&3" +
     2302                   "как БД экспорта указана БД &5"
     2303                   , integer(entry(v-ind,p-esys-id-list,chr(1)))
     2304                   , 0
     2305                   , chr(10)
     2306                   , buf_sys-ctrl.db-num
     2307                   , buf12_ext-system.esys-db-num-exp
     2308                   ) skip
     2309       return-value skip
     2310       error-status :get-message ( error-status :num-messages )
     2311       view-as alert-box error
     2312     .
     2313   end.
     2314     create ub.esys-route .
     2315     assign
     2316       ub.esys-route.esr-name-rec     = v-command-name
     2317         ub.esys-route.esr-tbl-ord = next-value( s-news-ord, ub )
     2318       ub.esys-route.esr-last-pack    = -1
     2319       ub.esys-route.esys-id          = integer(entry(v-ind,p-esys-id-list,chr(1)))
     2320       ub.esys-route.db-num           = 0
     2321       ub.esys-route.esr-status       = 0
     2322       ub.esys-route.esr-cr-db-num    = buf_sys-ctrl.db-num
     2323       ub.esys-route.esr-dump-ord     = v-dmp-ord
     2324       ub.esys-route.esr-uniq-key-rec = '':U
     2325       ub.esys-route.uniq-gate-rec    = for-route.uniq-gate-rec
     2326       ub.esys-route.esr-num-dump     = v-rec-ord
     2327       ub.esys-route.esr-action       = (if for-route.action = '' then 'command-bush':U else for-route.action)
     2328       ub.esys-route.esr-oper         = v-oper
     2329       .
     2330       assign
     2331         ub.esys-route.esr-CreDate      = v-cre-date
     2332       .
     2333       assign
     2334         ub.esys-route.esr-CreTimeInt   = v-cre-time
     2335         ub.esys-route.esr-CreTime      = string(v-cre-time,"HH:MM:SS":U)
     2336       .
     2337       assign
     2338         ub.esys-route.esr-CreUserName  = v-cre-user
     2339       .
     2340           if for-route.custom-pck-name > '' then do:
     2341             create buf_esys-all-attr.
     2342             assign
     2343             buf_esys-all-attr.attr-code = 'route-custom-pack-name':U
     2344             buf_esys-all-attr.table-name = 'esys-route':U
     2345             buf_esys-all-attr.key1 = v-dmp-ord
     2346             buf_esys-all-attr.key2 = integer(entry(v-ind,p-esys-id-list,chr(1)))
     2347             buf_esys-all-attr.key5 = 0
     2348             buf_esys-all-attr.attr-value  = for-route.custom-pck-name
     2349             buf_esys-all-attr.key6 = buf_sys-ctrl.db-num
     2350             .
     2351           end.
     2352         end.
     2353       end.
     2354       for each for-route-dump
     2355         where for-route-dump.dump-ord = for-route.dump-ord
     2356       on error undo, return error substitute( "&1 (send-command-esys). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     2357       :
     2358         delete for-route-dump .
     2359       end.
     2360       delete for-route .
     2361       p-dmp-ord = v-dmp-ord.
     2362       for each buf_esys-route where buf_esys-route.esr-dump-ord = v-dmp-ord and buf_esys-route.whole-send-news = 1:
     2363         delete buf_esys-route.
     2364         for each buf_esys-all-attr where buf_esys-all-attr.table-name = 'esys-route':U and buf_esys-all-attr.key1 = v-dmp-ord:
     2365           delete buf_esys-all-attr.
     2366         end.
     2367       end.
     2368     end.
     2369     return.
     2370   end procedure.
     2371   procedure set-custom-esys-pck-name :
     2372     define input parameter p-command-code as integer   no-undo .
     2373     define input parameter p-custom-pck-name as character no-undo .
     2374     do
     2375     on error  undo, return error substitute( "&1 (set-custom-esys-pck-name). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     2376     on stop   undo, return error substitute( "&1 (set-custom-esys-pck-name). stop", vss-workfile )
     2377     on endkey undo, return error substitute( "&1 (set-custom-esys-pck-name). endkey", vss-workfile )
     2378     :
     2379       find first for-route
     2380         where for-route.dump-ord = p-command-code
     2381         no-error
     2382       .
     2383       if not available for-route then do:
     2384         return error substitute( "&1 (set-custom-esys-pck-name). Команда с номером &2 не создана!", vss-workfile, p-command-code ) .
     2385       end.
     2386       assign
     2387       for-route.custom-pck-name = p-custom-pck-name.
     2388     end.
     2389     return.
     2390   end procedure.
     2391   procedure get-db-list :
     2392     define input  parameter p-command-code as integer   no-undo .
     2393     define output parameter p-db-list      as character no-undo .
     2394     do
     2395     on error  undo, return error substitute( "&1 (get-db-list). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     2396     on stop   undo, return error substitute( "&1 (get-db-list). stop", vss-workfile )
     2397     on endkey undo, return error substitute( "&1 (get-db-list). endkey", vss-workfile )
     2398     :
     2399       find first for-route
     2400         where for-route.dump-ord = p-command-code
     2401         no-error
     2402       .
     2403       if not available for-route then do:
     2404         return error substitute( "&1 (get-db-list). Команда с номером &2 не создана!", vss-workfile, p-command-code ) .
     2405       end.
     2406       assign
     2407         p-db-list = for-route.db-list
     2408       .
     2409     end.
     2410   end procedure.
     2411   procedure copy-dump :
     2412     define input parameter p-src-command-code as integer   no-undo .
     2413     define input parameter p-trg-command-code as integer   no-undo .
     2414     define input parameter p-rec-ord          as integer   no-undo .
     2415     define input parameter p-uniq-key-rec     as character no-undo .
     2416     do
     2417     on error  undo, return error substitute( "&1 (copy-dump). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     2418     on stop   undo, return error substitute( "&1 (copy-dump). stop", vss-workfile )
     2419     on endkey undo, return error substitute( "&1 (copy-dump). endkey", vss-workfile )
     2420     :
     2421       define variable v-rec-ord      like ub.route-dump.rec-ord .
     2422       define variable v-uniq-key-rec like ub.route-dump.uniq-key-rec .
     2423       define variable v-value-rec    like ub.route-dump.value-rec .
     2424       define buffer buf_src-route for for-route.
     2425       define buffer buf_trg-route for for-route.
     2426       define buffer buf_src-route-dump for for-route-dump.
     2427       define buffer buf_trg-route-dump for for-route-dump.
     2428       find first buf_src-route-dump
     2429         where buf_src-route-dump.dump-ord = p-src-command-code
     2430           and buf_src-route-dump.rec-ord = p-rec-ord
     2431         no-error .
     2432       if not available buf_src-route-dump then do:
     2433         return error substitute( "&1 (copy-dump). Запись-источник (код команды &2, код записи &3) еще не создана!", vss-workfile, p-trg-command-code, p-rec-ord ) .
     2434       end.
     2435       find first buf_trg-route-dump
     2436         where buf_trg-route-dump.dump-ord = p-trg-command-code
     2437           and buf_trg-route-dump.rec-ord = p-rec-ord
     2438         no-error .
     2439       if not available buf_trg-route-dump then do:
     2440         create buf_trg-route-dump.
     2441         assign
     2442         buf_trg-route-dump.dump-ord = p-trg-command-code
     2443         buf_trg-route-dump.rec-ord = p-rec-ord
     2444         .
     2445       end.
     2446       buffer-copy buf_src-route-dump except dump-ord
     2447       to buf_trg-route-dump.
     2448     end.
     2449     return.
     2450   end procedure.
     2451   procedure is-almost-empty :
     2452   define input parameter p-cmd-code as integer no-undo .
     2453   define output parameter p-is-empty as logical no-undo .
     2454   define buffer buf_for-route-dump for for-route-dump.
     2455     do
     2456     on error undo, return error
     2457     :
     2458       find first buf_for-route-dump no-lock where
     2459                 buf_for-route-dump.dump-ord = p-cmd-code
     2460            and  buf_for-route-dump.dump-name < 'nws-outline':U
     2461                 no-error.
     2462       if not available buf_for-route-dump then do:
     2463         find first buf_for-route-dump no-lock where
     2464                   buf_for-route-dump.dump-ord = p-cmd-code
     2465             and  buf_for-route-dump.dump-name > 'nws-outline':U  no-error.
     2466         if not available buf_for-route-dump then do:
     2467           assign
     2468           p-is-empty = yes.
     2469         end.
     2470       end.
     2471     end.
     2472   end procedure.
     2473   procedure is-empty :
     2474   define input parameter p-cmd-code as integer no-undo .
     2475   define output parameter p-is-empty as logical no-undo .
     2476   define buffer buf_for-route-dump for for-route-dump.
     2477     do
     2478     on error undo, return error
     2479     :
     2480       find first buf_for-route-dump no-lock where
     2481                 buf_for-route-dump.dump-ord = p-cmd-code no-error.
     2482       if not available buf_for-route-dump then do:
     2483         assign
     2484         p-is-empty = yes.
     2485       end.
     2486     end.
     2487   end procedure.
     2488   procedure get-last-rec-ord :
     2489   define input parameter p-cmd-code as integer no-undo .
     2490   define output parameter p-last-rec-ord as integer no-undo .
     2491     do
     2492     on error  undo, return error substitute( "&1 (get-last-rec-ord). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     2493     on stop   undo, return error substitute( "&1 (get-last-rec-ord). stop", vss-workfile )
     2494     on endkey undo, return error substitute( "&1 (get-last-rec-ord). endkey", vss-workfile )
     2495     :
     2496       find last for-route-dump
     2497         where for-route-dump.dump-ord = p-cmd-code
     2498         no-error
     2499       .
     2500       if not available for-route-dump then do:
     2501         p-last-rec-ord = 0.
     2502       end.
     2503       else do:
     2504         p-last-rec-ord = for-route-dump.rec-ord.
     2505       end.
     2506     end.
     2507   end procedure.
     2508   procedure undo-from-rec-ord :
     2509   define input parameter p-cmd-code as integer no-undo .
     2510   define input parameter p-last-rec-ord as integer no-undo .
     2511     do
     2512     on error undo, return error
     2513     :
     2514       for each for-route-dump where
     2515               for-route-dump.dump-ord = p-cmd-code
     2516           and for-route-dump.rec-ord > p-last-rec-ord
     2517       on error  undo, return error substitute( "&1 (undo-from-rec-ord). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     2518       on stop   undo, return error substitute( "&1 (undo-from-rec-ord). stop", vss-workfile )
     2519       on endkey undo, return error substitute( "&1 (undo-from-rec-ord). endkey", vss-workfile ):
     2520          delete for-route-dump.
     2521       end.
     2522     end.
     2523   end procedure.
     2524   procedure set-esys-command-action :
     2525   define input parameter p-command-code as integer   no-undo .
     2526   define input parameter p-action as character no-undo .
     2527     do
     2528     on error  undo, return error substitute( "&1 (set-esys-command-action ). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     2529     on stop   undo, return error substitute( "&1 (set-esys-command-action ). stop", vss-workfile )
     2530     on endkey undo, return error substitute( "&1 (set-esys-command-action ). endkey", vss-workfile )
     2531     :
     2532       find first for-route
     2533         where for-route.dump-ord = p-command-code
     2534         no-error
     2535       .
     2536       if not available for-route then do:
     2537         return error substitute( "&1 (set-esys-command-action ). Команда с номером &2 не создана!", vss-workfile, p-command-code ) .
     2538       end.
     2539       assign
     2540       for-route.action = p-action.
     2541     end.
     2542   end procedure.
