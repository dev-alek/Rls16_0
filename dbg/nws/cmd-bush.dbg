     2273         on error  undo, return error substitute( "&1 (send-command-esys). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     2274         :
     2275   def var vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2276   define variable v-msg#12         as character no-undo .
     2277   define variable v-lock#12        as logical   no-undo .
     2278   define variable v-ok#12          as logical   no-undo .
     2279   define variable v-cur-db-num#12  as integer      no-undo.
     2280   define buffer buf12_ext-system for ub.ext-system .
     2281   find first buf12_ext-system no-lock
     2282     where buf12_ext-system.esys-id = integer(entry(v-ind,p-esys-id-list,chr(1)))
     2283       and buf12_ext-system.db-num = 0
     2284     no-error
     2285   .
     2286   if not available buf12_ext-system then do:
     2287     message
