        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision$":U .
        3   define variable vss-author      as character no-undo init "$Author$":U .
        4   define variable vss-date        as character no-undo init "$Date$":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        6   define variable vss-archive     as character no-undo init "$Archive$":U .
        7   define variable vss-description as character no-undo init "Создание и обработка кустовых команд".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       67   define new global shared variable g#lib-nws as handle no-undo .
       68   def var vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       69   procedure gen-key-rec :
       70     define input  parameter p-tbl-name    as character no-undo.
       71     define input  parameter p-bh_tbl-name as handle    no-undo.
       72     define output parameter p-key-rec     as character no-undo.
       73     do
       74     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
       75     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
       76     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
       77     :
       78       define variable fh               as handle    no-undo .
       79       define variable v-ok             as logical   no-undo .
       80       define variable v-inform         as character no-undo .
       81       define variable v-ind            as integer   no-undo .
       82       define variable v-idx-field-qnty as integer   no-undo .
       83       if p-tbl-name = ?
       84         or p-tbl-name = "":U
       85       then do:
       86         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info1 ).
       87       end.
       88       if not p-bh_tbl-name:available then do:
       89         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info1, p-tbl-name ).
       90       end.
       91       assign
       92         p-key-rec = p-tbl-name
       93         v-inform  = p-bh_tbl-name:index-information(1)
       94         v-ind     = 2
       95       .
       96       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
       97       on error undo, return error
       98       :
       99         assign
      100           v-inform = p-bh_tbl-name:index-information( v-ind )
      101           v-ind    = v-ind + 1
      102         .
      103       end.
      104       if v-inform = ?
      105         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      106         or entry( 3, v-inform, ",":U ) <> "1":U
      107       then do:
      108         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, p-tbl-name ).
      109       end.
      110       else do:
      111         assign
      112           v-idx-field-qnty = num-entries( v-inform ) - 4
      113         .
      114         if v-idx-field-qnty < 2 then do:
      115           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, p-tbl-name ).
      116         end.
      117         do v-ind = 1 to v-idx-field-qnty by 2
      118         on error undo, return error
      119         :
      120           assign
      121             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      122             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      123           .
      124         end.
      125       end.
      126       if p-key-rec = ? then do:
      127         assign
      128           p-key-rec = "":U
      129         .
      130         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info1, p-tbl-name ).
      131       end.
      132     end.
      133     return.
      134   end procedure.
      135   procedure gen-where-keyr-tab :
      136     define input  parameter i-tableSerach as character no-undo.
      137     define input  parameter i-tablekey   as character  no-undo.
      138     define input  parameter p-key-rec    as character  no-undo.
      139     define input  parameter p-key-handle as handle     no-undo .
      140     define input  parameter p-db-name    as character  no-undo .
      141     define input  parameter p-tt-handle  as handle     no-undo .
      142     define output parameter o-Where      as character  no-undo.
      143     do
      144     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      145     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      146     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      147     :
      148       define variable v-full-tbl-name  as character no-undo .
      149       define variable bh_tbl-name      as handle    no-undo .
      150       define variable fh_key           as handle    no-undo .
      151       define variable fh_search        as handle    no-undo .
      152       define variable v-field-num      as integer   no-undo .
      153       define variable v-count-fld      as integer   no-undo .
      154       define variable v-inform         as character no-undo .
      155       define variable v-ind            as integer   no-undo .
      156       define variable v-idx-field-qnty as integer   no-undo .
      157       define variable v-field-name     as character no-undo .
      158       define variable v-field-val      as character no-undo .
      159       define variable v-word-link      as character no-undo .
      160       define variable vTable           as character no-undo.
      161       define variable bh_tbl-key       as handle    no-undo .
      162       assign
      163         p-key-rec = trim( p-key-rec )
      164       .
      165       if p-key-handle <> ? then do:
      166         if not valid-handle(p-key-handle)
      167            or p-key-handle:type <> "buffer"
      168         then do:
      169           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info1 ).
      170         end.
      171         if num-entries( p-key-rec, chr(3) ) > 1
      172           or p-key-rec = ?
      173           or p-key-rec = "":U
      174         then do:
      175           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info1, p-key-rec ).
      176         end.
      177       end.
      178       else do:
      179         if p-key-rec = ?
      180           or p-key-rec = "":U
      181         then do:
      182           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info1 ).
      183         end.
      184       end.
      185       assign
      186         vTable = entry( 1 , p-key-rec, chr(3) )
      187       .
      188       if p-tt-handle <> ?
      189         and ( not valid-handle(p-tt-handle)
      190               or p-tt-handle:type <> "buffer"
      191             )
      192       then do:
      193         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info1, vTable, chr(10) ).
      194       end.
      195       if p-tt-handle = ? then do:
      196         assign
      197           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      198         .
      199         create buffer bh_tbl-name for table v-full-tbl-name .
      200       end.
      201       else do:
      202         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      203       end.
      204       assign
      205         v-inform = bh_tbl-name:index-information(1)
      206         v-ind    = 2
      207       .
      208       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      209       on error undo, return error
      210       :
      211         assign
      212           v-inform = bh_tbl-name:index-information( v-ind )
      213           v-ind    = v-ind + 1
      214         .
      215       end.
      216       if v-inform = ?
      217         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      218         or entry( 3, v-inform, ",":U ) <> "1":U
      219       then do:
      220         delete object bh_tbl-name no-error.
      221         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info1, vTable ).
      222       end.
      223       assign
      224         v-idx-field-qnty = num-entries( v-inform ) - 4
      225       .
      226       if v-idx-field-qnty < 2 then do:
      227         delete object bh_tbl-name no-error.
      228         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, vTable ).
      229       end.
      230       assign
      231         o-where     = "where":U
      232         v-word-link = "":U
      233         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      234         v-count-fld = 0
      235       .
      236       if i-tablekey ne "" and i-tablekey ne ?
      237       then do:
      238         assign
      239           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      240         .
      241         create buffer bh_tbl-key for table v-full-tbl-name .
      242       end.
      243       if i-tableSerach ne "" and i-tableSerach ne ?
      244       then do:
      245         delete object bh_tbl-name no-error.
      246         assign
      247           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      248         .
      249         create buffer bh_tbl-name for table v-full-tbl-name .
      250       end.
      251       block_where:
      252       do v-ind = 1 to v-idx-field-qnty by 2
      253       on error undo, return error
      254       :
      255         assign
      256           v-count-fld = v-count-fld + 1
      257         .
      258         if p-key-handle = ?
      259           and v-count-fld > v-field-num
      260         then do:
      261           leave block_where.
      262         end.
      263         define variable VfieldKeyTable as handle no-undo.
      264         assign
      265           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      266           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      267         .
      268         if     bh_tbl-key ne ?
      269         then do:
      270            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      271            if VfieldKeyTable eq ?
      272            then next block_where.
      273         end.
      274         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      275         then
      276            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      277         else
      278            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      279         if p-key-handle = ? then do:
      280           assign
      281             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      282           .
      283         end.
      284         else do:
      285           assign
      286             fh_key = p-key-handle:buffer-field( v-field-name )
      287           .
      288           if fh_key = ?
      289             or not valid-handle( fh_key )
      290           then do:
      291             delete object bh_tbl-name.
      292             if     bh_tbl-key ne ?
      293             then
      294                delete object bh_tbl-key.
      295             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info1, p-key-handle:name, v-field-name ).
      296           end.
      297           assign
      298             v-field-val = fh_key:buffer-value
      299           .
      300         end.
      301         if fh_search:data-type ="character":U then do:
      302           assign
      303             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      304             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      305             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      306             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      307             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      308             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      309             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      310             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      311             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      312             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      313             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      314             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      315             v-field-val = substitute( '"&1"', v-field-val )
      316           .
      317         end.
      318         assign
      319           o-where = substitute( "&1 &2", o-where, v-field-val )
      320         .
      321         if v-word-link = "":U then do:
      322           assign
      323             v-word-link = "and":U
      324           .
      325         end.
      326       end.
      327       delete object bh_tbl-name.
      328       if     bh_tbl-key ne ?
      329       then
      330          delete object bh_tbl-key.
      331       if p-key-handle = ?
      332         and v-count-fld <> v-field-num
      333       then do:
      334         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info1, vTable ).
      335       end.
      336     end.
      337   end procedure.
      338   procedure gen-hn-keyr-tab :
      339     define input  parameter i-tableSerach as character no-undo.
      340     define input  parameter i-tablekey   as character no-undo.
      341     define input  parameter p-key-rec    as character no-undo.
      342     define input  parameter p-key-handle as handle    no-undo .
      343     define input  parameter p-db-name    as character no-undo .
      344     define input  parameter p-tt-handle  as handle    no-undo .
      345     define input  parameter p-stts-lock  as integer   no-undo .
      346     define output parameter o-hn         as handle    no-undo.
      347     define variable v-full-tbl-name as character no-undo.
      348     define variable v-where         as character no-undo.
      349     define variable bh_tbl-name     as handle    no-undo.
      350     define variable vTable          as character no-undo.
      351     do
      352     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      353     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      354     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      355         run gen-where-keyr-tab(i-tableSerach,
      356                                i-tablekey,
      357                                p-key-rec,
      358                                p-key-handle,
      359                                p-db-name,
      360                                p-tt-handle,
      361                                output v-where).
      362         if i-tableSerach ne "" and i-tableSerach ne ?
      363         then do:
      364            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      365            create buffer bh_tbl-name for table v-full-tbl-name .
      366         end.
      367         else do:
      368            if p-tt-handle = ? then do:
      369               assign
      370                  vTable = entry( 1 , p-key-rec, chr(3) )
      371               .
      372               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      373               create buffer bh_tbl-name for table v-full-tbl-name .
      374            end.
      375            else do:
      376               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      377            end.
      378         end.
      379         if p-tt-handle = ? then do:
      380            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      381         end.
      382         else do:
      383            bh_tbl-name:find-first( v-where ) no-error .
      384         end.
      385         o-hn = bh_tbl-name.
      386      end.
      387   end procedure.
      388   procedure gen-hn-keyr :
      389     define input  parameter p-key-rec    as character no-undo.
      390     define input  parameter p-key-handle as handle    no-undo .
      391     define input  parameter p-db-name    as character no-undo .
      392     define input  parameter p-tt-handle  as handle    no-undo .
      393     define input  parameter p-stts-lock  as integer   no-undo .
      394     define output parameter o-hn         as handle    no-undo.
      395     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      396   end.
      397   procedure gen-row-keyr :
      398     define input  parameter p-key-rec    as character no-undo.
      399     define input  parameter p-key-handle as handle    no-undo .
      400     define input  parameter p-db-name    as character no-undo .
      401     define input  parameter p-tt-handle  as handle    no-undo .
      402     define input  parameter p-stts-lock  as integer   no-undo .
      403     define output parameter p-tbl-row    as rowid     no-undo.
      404     define output parameter p-tbl-name   as character no-undo.
      405     define variable vHn as handle no-undo.
      406       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      407       p-tbl-row = if vHn:available then vHn:rowid else ?.
      408       p-tbl-name =  vHn:table.
      409       delete object vHn no-error.
      410     if p-tbl-row = ? then do:
      411       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info1, p-tbl-name, p-key-rec ).
      412     end.
      413     else do:
      414       return.
      415     end.
      416   end procedure.
      417   procedure gen-key-fv :
      418     define input  parameter p-key-rec    as character no-undo .
      419     define output parameter p-field-list as character no-undo .
      420     define output parameter p-value-list as character no-undo.
      421     do
      422     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      423     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      424     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      425     :
      426       define variable v-full-tbl-name  as character no-undo .
      427       define variable bh_tbl-name      as handle    no-undo .
      428       define variable v-tbl-name       as character no-undo .
      429       define variable v-field-num      as integer   no-undo .
      430       define variable v-count-fld      as integer   no-undo .
      431       define variable v-inform         as character no-undo .
      432       define variable v-ind            as integer   no-undo .
      433       define variable v-idx-field-qnty as integer   no-undo .
      434       define variable v-delim-key      as character no-undo .
      435       if p-key-rec = ?
      436         or p-key-rec = "":U
      437       then do:
      438         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info1 ).
      439       end.
      440       assign
      441         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      442         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      443       .
      444       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      445       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info1 ).
      446       assign
      447         v-inform = bh_tbl-name:index-information(1)
      448         v-ind    = 2
      449       .
      450       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      451       on error undo, return error
      452       :
      453         assign
      454           v-inform = bh_tbl-name:index-information( v-ind )
      455           v-ind    = v-ind + 1
      456         .
      457       end.
      458       if v-inform = ?
      459         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      460         or entry( 3, v-inform, ",":U ) <> "1":U
      461       then do:
      462         delete object bh_tbl-name no-error.
      463         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, v-tbl-name ).
      464       end.
      465       assign
      466         v-idx-field-qnty = num-entries( v-inform ) - 4
      467       .
      468       if v-idx-field-qnty < 2 then do:
      469         delete object bh_tbl-name no-error.
      470         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, v-tbl-name ).
      471       end.
      472       assign
      473         p-field-list = "":U
      474         p-value-list = "":U
      475         v-delim-key  = "":U
      476         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      477         v-count-fld  = 0
      478       .
      479       block_where:
      480       do v-ind = 1 to v-idx-field-qnty by 2
      481       on error undo, return error
      482       :
      483         assign
      484           v-count-fld = v-count-fld + 1
      485         .
      486         if v-count-fld > v-field-num then do:
      487           leave block_where.
      488         end.
      489         assign
      490           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      491           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      492         .
      493         if v-ind = 1 then do:
      494           assign
      495             v-delim-key = chr(3)
      496           .
      497         end.
      498       end.
      499       delete object bh_tbl-name.
      500       if v-count-fld <> v-field-num then do:
      501         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info1, v-tbl-name ).
      502       end.
      503     end.
      504   end procedure.
      505   procedure gen-key-field :
      506     define input  parameter p-table      as character no-undo .
      507     define output parameter p-field-list as character no-undo .
      508     do
      509     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      510     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      511     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      512     :
      513       define variable v-full-tbl-name  as character no-undo .
      514       define variable bh_tbl-name      as handle    no-undo .
      515       define variable v-tbl-name       as character no-undo .
      516       define variable v-field-num      as integer   no-undo .
      517       define variable v-count-fld      as integer   no-undo .
      518       define variable v-inform         as character no-undo .
      519       define variable v-ind            as integer   no-undo .
      520       define variable v-idx-field-qnty as integer   no-undo .
      521       define variable v-delim-key      as character no-undo .
      522       if p-table = ?
      523         or p-table = "":U
      524       then do:
      525         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info1 ).
      526       end.
      527       assign
      528         v-tbl-name      = p-table
      529         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      530       .
      531       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      532       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info1 ).
      533       assign
      534         v-inform = bh_tbl-name:index-information(1)
      535         v-ind    = 2
      536       .
      537       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      538       on error undo, return error
      539       :
      540         assign
      541           v-inform = bh_tbl-name:index-information( v-ind )
      542           v-ind    = v-ind + 1
      543         .
      544       end.
      545       if v-inform = ?
      546         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      547         or entry( 3, v-inform, ",":U ) <> "1":U
      548       then do:
      549         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, v-tbl-name ).
      550       end.
      551       assign
      552         v-idx-field-qnty = num-entries( v-inform ) - 4
      553       .
      554       if v-idx-field-qnty < 2 then do:
      555         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, v-tbl-name ).
      556       end.
      557       assign
      558         p-field-list = "":U
      559         v-delim-key  = "":U
      560         v-count-fld  = 0
      561       .
      562       block_where:
      563       do v-ind = 1 to v-idx-field-qnty by 2
      564       on error undo, return error
      565       :
      566         assign
      567           v-count-fld = v-count-fld + 1
      568         .
      569         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      570         if v-ind = 1 then do:
      571           assign
      572             v-delim-key = chr(3)
      573           .
      574         end.
      575       end.
      576       delete object bh_tbl-name.
      577     end.
      578   end procedure.
      579   def var vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      580   define temp-table t-raw no-undo
      581     field t-raw-field as raw
      582   .
      583   procedure cre-raw :
      584     define input  parameter p-tbl-name   as character no-undo.
      585     define input  parameter p-tbl-handle as handle    no-undo.
      586     define output parameter p-raw        as raw       no-undo.
      587     define variable bh_t-raw        as handle    no-undo .
      588     define variable v-ok            as logical   no-undo .
      589     define variable v-msg           as character no-undo .
      590       define variable tth             as handle    no-undo .
      591       define variable tt-name         as character no-undo .
      592       define variable bh_tt           as handle    no-undo .
      593     do
      594     on error  undo, throw
      595     :
      596       create temp-table tth.
      597       assign
      598         tth:undo = false
      599         tt-name  = "tt_" + p-tbl-handle:table
      600       .
      601       v-ok = tth:create-like( p-tbl-handle ) .
      602       v-ok = tth:temp-table-prepare( tt-name ) .
      603       bh_tt = tth:default-buffer-handle .
      604       v-ok = bh_tt:buffer-create .
      605       v-ok = bh_tt:buffer-copy( p-tbl-handle ) .
      606       empty temp-table t-raw .
      607       create t-raw.
      608       bh_t-raw = buffer t-raw:handle .
      609       v-ok =        bh_tt:raw-transfer ( true, bh_t-raw:buffer-field("t-raw-field":U) ) .
      610       p-raw = t-raw.t-raw-field .
      611     catch exAppErrors as class Progress.Lang.AppError :
      612       v-msg = substitute( "&1 (cre-raw). raw-transfer не прошел для таблицы &2&3&4&3&5",
      613         vss-include-info2,
      614         p-tbl-name,
      615         chr(10),
      616         error-status:get-message (error-status:num-messages),
      617         exAppErrors:CallStack
      618       ) .
      619       undo, throw new Progress.Lang.AppError(v-msg)  .
      620     end catch .
      621     catch exProErrors as class Progress.Lang.ProError :
      622       undo, throw exProErrors .
      623     end catch .
      624     catch exAnyErrors as class Progress.Lang.Error:
      625       undo, throw exAnyErrors .
      626     end catch .
      627     finally :
      628       empty temp-table t-raw .
      629       v-ok = tth:clear() no-error .
      630       delete object tth.
      631     end finally .
      632     end.
      633   end procedure.
      634   procedure cre-raw-delta :
      635     define input  parameter p-tbl-name       as character no-undo.
      636     define input  parameter p-old-raw        as raw       no-undo.
      637     define input  parameter p-new-buf-handle as handle    no-undo.
      638     define output parameter p-raw            as raw       no-undo.
      639     do
      640     on error  undo, return error substitute( "&1 (cre-raw-delta). &2&3&4", vss-include-info2, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      641     on stop   undo, return error substitute( "&1 (cre-raw-delta). stop", vss-include-info2 )
      642     on endkey undo, return error substitute( "&1 (cre-raw-delta). endkey", vss-include-info2 )
      643     :
      644       define variable tt-name         as character no-undo .
      645       define variable tth             as handle    no-undo .
      646       define variable bh-dlt_tt       as handle    no-undo .
      647       define variable bh-old_tt       as handle    no-undo .
      648       define variable bh_t-raw        as handle    no-undo .
      649       define variable v-num-fields    as integer   no-undo .
      650       define variable v-ind           as integer   no-undo .
      651       define variable v-name-field    as character no-undo .
      652       define variable v-fh-tt         as handle    no-undo .
      653       define variable v-fh-old        as handle    no-undo .
      654       define variable v-fh-new        as handle    no-undo .
      655       define variable v-ok            as logical   no-undo .
      656       if not p-new-buf-handle:available then do:
      657         return error substitute( "&1 (cre-raw-delta). Переданый буфер с новым значением таблицы &2 не доступен", vss-include-info2, p-tbl-name ).
      658       end.
      659       if p-old-raw = ?
      660       then do:
      661         return error substitute( "&1 (cre-raw-delta). Переданый буфер со старым значением таблицы &2 не доступен", vss-include-info2, p-tbl-name ).
      662       end.
      663       create temp-table tth.
      664       assign
      665         tth:undo = false
      666         tt-name  = "tt_" + p-tbl-name
      667       .
      668       assign
      669         v-ok = tth:create-like( p-new-buf-handle ) no-error
      670       .
      671       if v-ok <> true then do:
      672         return error substitute( "&1 (cre-raw-delta). Ошибка при создании временной таблицы &2 (1)", vss-include-info2, tt-name ) .
      673       end.
      674       assign
      675         v-ok = tth:temp-table-prepare( tt-name ) no-error
      676       .
      677       if v-ok <> true then do:
      678         return error substitute( "&1 (cre-raw-delta). Ошибка при создании временной таблицы &2 (2)", vss-include-info2, tt-name ) .
      679       end.
      680       assign
      681         bh-dlt_tt = tth:default-buffer-handle
      682       .
      683       assign
      684         v-ok = bh-dlt_tt:buffer-create no-error
      685       .
      686       if v-ok <> true then do:
      687         return error substitute( "&1 (cre-raw-delta). Ошибка при создании буфера временной таблицы для новых значений.", vss-include-info2, p-tbl-name ).
      688       end.
      689       create buffer bh-old_tt for table tth.
      690       assign
      691         v-ok = bh-old_tt:buffer-create no-error
      692       .
      693       if v-ok <> true then do:
      694         return error substitute( "&1 (cre-raw-delta). Ошибка при создании буфера временной таблицы для старых значений.", vss-include-info2, p-tbl-name ).
      695       end.
      696       create t-raw.
      697       assign
      698         t-raw.t-raw-field = p-old-raw
      699         bh_t-raw          = buffer t-raw:handle
      700       .
      701       assign
      702         v-ok = bh-old_tt:raw-transfer ( false, bh_t-raw:buffer-field("t-raw-field":U) ) no-error
      703       .
      704       delete t-raw.
      705       if v-ok <> true then do:
      706         return error substitute( "&1 (cre-raw-delta). raw-transfer не прошел для таблицы &2 со старыми значениями", vss-include-info2, p-tbl-name ).
      707       end.
      708       assign
      709         v-num-fields = p-new-buf-handle:num-fields
      710       .
      711       do v-ind = 1 to v-num-fields
      712       on error undo, return error substitute( "&1 (cre-raw-delta). &2", vss-include-info2, error-status :get-message ( 1 ) )
      713       :
      714         assign
      715           v-fh-new     = p-new-buf-handle:buffer-field( v-ind )
      716           v-name-field = v-fh-new:name
      717           v-fh-old     = bh-old_tt:buffer-field( v-name-field )
      718           v-fh-tt      = bh-dlt_tt:buffer-field( v-name-field )
      719         .
      720         if v-fh-new:buffer-value <> v-fh-old:buffer-value then do:
      721           assign
      722             bh-dlt_tt:buffer-field( v-name-field ):buffer-value = v-fh-new:buffer-value
      723           .
      724         end.
      725       end.
      726       create t-raw.
      727       assign
      728         bh_t-raw = buffer t-raw:handle
      729       .
      730       assign
      731         v-ok = bh-dlt_tt:raw-transfer ( true, bh_t-raw:buffer-field("t-raw-field":U) ) no-error
      732       .
      733       assign
      734         p-raw = t-raw.t-raw-field
      735       .
      736       delete t-raw.
      737       if v-ok <> true then do:
      738         return error substitute( "&1. raw-transfer не прошел для таблицы &2", vss-include-info2, p-tbl-name ).
      739       end.
      740       assign
      741         v-ok = tth:clear() no-error
      742       .
      743       if v-ok <> true then do:
      744         return error substitute( "&1. Ошибка при очистке временной таблицы &2", vss-include-info2, tt-name ) .
      745       end.
      746       delete object bh-old_tt no-error .
      747       if error-status:error then do:
      748         return error substitute( "&1. Ошибка при удалении ссылки на буфер временной таблицы &2", vss-include-info2, tt-name ).
      749       end.
      750       delete object tth no-error .
      751       if error-status:error then do:
      752         return error substitute( "&1. Ошибка при удалении временной таблицы для &2", vss-include-info2, tt-name ).
      753       end.
      754     end.
      755   end procedure.
      756   PROCEDURE cre-route-dump :
      757     define input        parameter p-act-name   as character           no-undo .
      758     define input        parameter p-tbl-name   as character           no-undo.
      759     define input        parameter p-tbl-handle as handle              no-undo.
      760     define input        parameter p-dmp-ord    like ub.route.dump-ord no-undo.
      761     define input-output parameter p-rc-ord     as integer             no-undo.
      762     do transaction
      763     on error  undo, return error substitute( "&1 (cre-route-dump). &2&3&4", vss-include-info2, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      764     on stop   undo, return error substitute( "&1 (cre-route-dump). stop", vss-include-info2 )
      765     on endkey undo, return error substitute( "&1 (cre-route-dump). endkey", vss-include-info2 )
      766     :
      767       define variable loc-key-rec like ub.route.uniq-key-rec   no-undo .
      768       define variable v-value-rec like ub.route-dump.value-rec no-undo .
      769       define variable bh_tbl-name  as handle    no-undo .
      770       define variable fh_tbl-name  as handle    no-undo .
      771       define variable v-ok         as logical   no-undo .
      772       define buffer buf_sys-ctrl for ub.sys-ctrl .
      773       if not p-tbl-handle:available then do:
      774         return error substitute( "&1. Переданый буфер таблицы &2 не доступен", vss-include-info2, p-tbl-name ).
      775       end.
      776       assign
      777         p-rc-ord = p-rc-ord + 1
      778       .
      779       run gen-key-rec in this-procedure
      780         ( input p-tbl-name
      781          ,input p-tbl-handle
      782          ,output loc-key-rec
      783         ) no-error.
      784       if error-status :error then do:
      785         return error substitute( "&1. Ошибка при генерации уникального ключа по таблице &2. &3"
      786                                  ,vss-include-info2
      787                                  ,p-tbl-name
      788                                  ,return-value
      789                                ).
      790       end.
      791       run cre-raw in this-procedure
      792         ( input p-tbl-name
      793          ,input p-tbl-handle
      794          ,output v-value-rec
      795         ) no-error.
      796       if error-status :error then do:
      797         return error substitute( "&1. Ошибка при сжатии записи по таблице &2. &3"
      798                                  ,vss-include-info2
      799                                  ,p-tbl-name
      800                                  ,return-value
      801                                ).
      802       end.
      803       case p-act-name :
      804         when 'send-tbl':U then do:
      805           create buffer bh_tbl-name for table "ub.route-dump":U .
      806         end.
      807         when 'send-tbl-oxml':U
      808         then do:
      809           create buffer bh_tbl-name for table "ub.esys-route-dump":U .
      810         end.
      811       end case.
      812       assign
      813         v-ok = bh_tbl-name:buffer-create no-error
      814       .
      815       if v-ok <> true
      816         or error-status :error
      817       then do:
      818         return error substitute( "&1. Ошибка при создании буфера таблицы маршрутизации &2&3&4.", vss-include-info2, p-tbl-name, chr(10), error-status :get-message(1) ).
      819       end.
      820       case p-act-name :
      821         when 'send-tbl':U then do:
      822           assign
      823             fh_tbl-name              = bh_tbl-name:buffer-field("dump-name":U)
      824             fh_tbl-name:buffer-value = p-tbl-name
      825           .
      826           assign
      827             fh_tbl-name              = bh_tbl-name:buffer-field("dump-ord":U)
      828             fh_tbl-name:buffer-value = p-dmp-ord
      829           .
      830           assign
      831             fh_tbl-name              = bh_tbl-name:buffer-field("rec-ord":U)
      832             fh_tbl-name:buffer-value = p-rc-ord
      833           .
      834           assign
      835             fh_tbl-name              = bh_tbl-name:buffer-field("uniq-key-rec":U)
      836             fh_tbl-name:buffer-value = loc-key-rec
      837           .
      838           assign
      839             fh_tbl-name              = bh_tbl-name:buffer-field("value-rec":U)
      840             fh_tbl-name:buffer-value = v-value-rec
      841           .
      842   define variable vss-include-info3 as character format "X(65)":U no-undo initial "@(#)$Workfile$ $Revision$".
      843   if (valid-handle(g#lib-nws) <> true) then do:   run nws/lib-nws.p persistent no-error .   if error-status :error or (valid-handle(g#lib-nws) <> true) then do:     message       "Error starting nws/lib-nws.p" skip       g#lib-nws skip       g#lib-nws :type skip       g#lib-nws :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-nws_route-dump-write in g#lib-nws
      844     ( input p-tbl-name
      845     , input bh_tbl-name
      846     , input p-tbl-handle
      847     , input p-dmp-ord
      848     , input p-rc-ord
      849     ) no-error .
      850           if error-status :error then do:
      851             return error substitute( "&1. &2&3&4", vss-include-info2, return-value, chr(10), error-status :get-message ( error-status :num-messages ) ).
      852           end.
      853         end.
      854         when 'send-tbl-oxml':U
      855         then do:
      856           find first buf_sys-ctrl no-lock .
      857           assign
      858             fh_tbl-name              = bh_tbl-name:buffer-field("esrd-cr-db-num":U)
      859             fh_tbl-name:buffer-value = buf_sys-ctrl.db-num
      860             .
      861           assign
      862             fh_tbl-name              = bh_tbl-name:buffer-field("esrd-dump-name":U)
      863             fh_tbl-name:buffer-value = p-tbl-name
      864           .
      865           assign
      866             fh_tbl-name              = bh_tbl-name:buffer-field("esrd-dump-ord":U)
      867             fh_tbl-name:buffer-value = p-dmp-ord
      868           .
      869           assign
      870             fh_tbl-name              = bh_tbl-name:buffer-field("esrd-rec-ord":U)
      871             fh_tbl-name:buffer-value = p-rc-ord
      872           .
      873           assign
      874             fh_tbl-name              = bh_tbl-name:buffer-field("esrd-uniq-key-rec":U)
      875             fh_tbl-name:buffer-value = loc-key-rec
      876           .
      877           assign
      878             fh_tbl-name              = bh_tbl-name:buffer-field("esrd-value-rec":U)
      879             fh_tbl-name:buffer-value = v-value-rec
      880           .
      881         end.
      882       end case.
      883       delete object bh_tbl-name.
      884     end.
      885   END PROCEDURE.
      886   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      887   procedure cur-time :
      888      define output parameter p-today as date      no-undo .
      889      define output parameter p-time  as integer   no-undo .
      890     do
      891     on error undo, return error
      892     :
      893       define variable v-date1 as date      no-undo .
      894       define variable v-date2 as date      no-undo .
      895       define variable v-time  as integer   no-undo .
      896       assign
      897         v-date1 = today
      898         v-time  = time
      899         v-date2 = today
      900       .
      901       if v-date1 <> v-date2
      902       then do:
      903         assign
      904           v-date1 = today
      905           v-time  = v-time
      906         .
      907       end.
      908       assign
      909         p-today = v-date1
      910         p-time  = v-time
      911       .
      912     end.
      913   end.
      914   function cur-time-date returns character
      915   :
      916     return string(today, '99/99/9999':U) .
      917   end.
      918   function cur-time-mjd returns decimal
      919   :
      920     define variable v-date as date      no-undo .
      921     define variable v-time as integer   no-undo .
      922     run cur-time in this-procedure
      923       (output v-date
      924       ,output v-time
      925       ) .
      926     return integer(v-date) - 2400002 + (v-time / 86400) .
      927   end.
      928   function cur-time-get-ending-index returns integer
      929   (input p-number as integer
      930   )
      931   :
      932     if p-number < 0
      933     or p-number = ?
      934     then do:
      935       return 1 .
      936     end.
      937     define variable v-rest as integer   no-undo .
      938     assign
      939       p-number = p-number modulo 100
      940     .
      941     if p-number < 20
      942     then do:
      943       assign
      944         v-rest = p-number
      945       .
      946     end.
      947     else do:
      948       assign
      949         v-rest = p-number modulo 10
      950       .
      951     end.
      952     case v-rest :
      953       when 1
      954       then do:
      955         return 2 .
      956       end.
      957       when 2 or
      958       when 3 or
      959       when 4
      960       then do:
      961         return 3 .
      962       end.
      963       otherwise do:
      964         return 1 .
      965       end.
      966     end case .
      967   end.
      968   procedure cur-time-mjd-to-date :
      969      define input  parameter i-mjd-diff as decimal no-undo.
      970      define output parameter o-Date     as date    no-undo.
      971      define output parameter o-Time     as integer no-undo.
      972      define variable v-day-number as integer   no-undo .
      973      if    i-mjd-diff < 0
      974         or i-mjd-diff = ?
      975      then do:
      976         return "?" .
      977      end.
      978      assign
      979         v-day-number = truncate(i-mjd-diff,0).
      980         o-Date = date(v-day-number + 2400002).
      981         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      982     .
      983   end.
      984   function cur-time-mjd-to-string returns character
      985   (input p-mjd-diff as decimal
      986   )
      987   :
      988     define variable v-day-number as integer   no-undo .
      989     define variable v-seconds    as integer   no-undo .
      990     define variable v-hour       as integer   no-undo .
      991     define variable v-min        as integer   no-undo .
      992     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      993     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      994     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      995     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      996     if p-mjd-diff < 0
      997     or p-mjd-diff = ?
      998     then do:
      999       return "?" .
     1000     end.
     1001     assign
     1002       v-day-number = integer(truncate(p-mjd-diff,0))
     1003       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1004     .
     1005     if v-seconds > 86400
     1006     then do:
     1007       assign
     1008         v-seconds = 86400 - 1
     1009       .
     1010     end.
     1011     if v-seconds < 0
     1012     then do:
     1013       assign
     1014         v-seconds = 0
     1015       .
     1016     end.
     1017     assign
     1018       v-hour = truncate(v-seconds / 3600, 0)
     1019     .
     1020     assign
     1021       v-seconds = v-seconds modulo 3600
     1022     .
     1023     assign
     1024       v-min = truncate(v-seconds / 60, 0)
     1025     .
     1026     assign
     1027       v-seconds = v-seconds modulo 60
     1028     .
     1029     return
     1030         (if v-day-number <> 0
     1031           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1032           else ""
     1033         )
     1034       + (if v-day-number <> 0 or v-hour <> 0
     1035           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1036           else ""
     1037         )
     1038       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1039           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1040           else ""
     1041         )
     1042       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1043       .
     1044   end.
     1045   function cur-time-string returns character
     1046   :
     1047     define variable v-date as date      no-undo .
     1048     define variable v-time as integer   no-undo .
     1049     run cur-time in this-procedure
     1050       (output v-date
     1051       ,output v-time
     1052       ) .
     1053     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1054   end.
     1055   function cur-time-string-sec returns character
     1056   :
     1057     define variable v-date as date      no-undo .
     1058     define variable v-time as integer   no-undo .
     1059     run cur-time in this-procedure
     1060       (output v-date
     1061       ,output v-time
     1062       ) .
     1063     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1064   end.
     1065   function cur-time-custom  returns character
     1066   (input p-prefix as character
     1067   ,input p-date-format as character
     1068   ,input p-delimiter as character
     1069   ,input p-time-format as character
     1070   ,input p-suffix as character
     1071   )
     1072   :
     1073     define variable v-date as date      no-undo .
     1074     define variable v-time as integer   no-undo .
     1075     run cur-time in this-procedure
     1076       (output v-date
     1077       ,output v-time
     1078       ) .
     1079     return
     1080       p-prefix
     1081       + string(v-date, p-date-format)
     1082       + p-delimiter
     1083       + string(v-time, p-time-format)
     1084       + p-suffix
     1085       .
     1086   end.
     1087   function cur-time-print  returns character
     1088   :
     1089     define variable v-date as date      no-undo .
     1090     define variable v-time as integer   no-undo .
     1091     run cur-time in this-procedure
     1092       (output v-date
     1093       ,output v-time
     1094       ) .
     1095     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1096   end.
     1097   function cur-time-datetime returns datetime
     1098   :
     1099     define variable v-char as character no-undo .
     1100     define variable v-datetime as datetime no-undo .
     1101     v-char = cur-time-string().
     1102     v-datetime = datetime(v-char).
     1103     return  v-datetime.
     1104   end.
     1105   function cur-time-string-msec returns character
     1106   :
     1107     define variable v-date as datetime  no-undo .
     1108     v-date = now.
     1109     return string(v-date) .
     1110   end.
     1111   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1112   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1113   define variable tempcxml_v-num_ as integer no-undo .
     1114   define  temp-table temp-xml-tables no-undo
     1115   field order as integer
     1116   field tbl-name as character
     1117   field tbl-handle_ as handle
     1118   field table-handle_ as handle
     1119   field uniq-gate-rec as character
     1120   field gate-name as character
     1121   field gate-handle_ as handle
     1122   field is-parent as logical
     1123   index pi is unique primary
     1124   uniq-gate-rec
     1125   tbl-name
     1126   index iorder
     1127   order
     1128   index gr
     1129   uniq-gate-rec
     1130   index gh
     1131   gate-handle_
     1132   index iparent
     1133   is-parent
     1134   .
     1135   define  temp-table temp-xml-records no-undo
     1136   field tbl-name as character
     1137   field uniq-key-rec as character
     1138   index pi is unique primary
     1139   tbl-name
     1140   uniq-key-rec
     1141   .
     1142   def var vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1143   procedure get-gate-file-name :
     1144   define input parameter p-gate-rec as character no-undo .
     1145   define output  parameter p-gate-file-name as character no-undo .
     1146   define buffer buf_clob-data for ub.clob-data.
     1147   define variable v-tbl-row as rowid no-undo .
     1148   define variable v-tbl-name as character no-undo .
     1149   run gen-row-keyr in this-procedure ( input p-gate-rec
     1150                                       ,input ?
     1151                                       ,input "ub"
     1152                                       ,input ?
     1153                                       ,input no-lock
     1154                                       ,output v-tbl-row
     1155                                       ,output v-tbl-name) no-error.
     1156   if error-status:error then undo, return error substitute("&1 (get-gate-name) Несуществующий gate &2"
     1157                                                           ,vss-include-info5
     1158                                                           ,p-gate-rec).
     1159   find first buf_clob-data no-lock where
     1160             rowid(buf_clob-data) = v-tbl-row no-error.
     1161   if not available buf_clob-data then do:
     1162     if error-status:error then undo, return error substitute("&1 (get-gate-name) Несуществующий gate &2"
     1163                                                             ,vss-include-info5
     1164                                                             ,p-gate-rec).
     1165   end.
     1166   p-gate-file-name = buf_clob-data.file-name.
     1167   end procedure.
     1168   procedure get-gate-rec :
     1169   define input  parameter p-gate-name as character no-undo .
     1170   define output parameter p-gate-rec as character no-undo .
     1171   define buffer buf_clob-bind for ub.clob-bind.
     1172   define buffer buf_clob-data for ub.clob-data.
     1173   main-block:
     1174   do
     1175   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info5, return-value, chr(10), error-status :get-message (1))
     1176   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info5 )
     1177   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info5 )
     1178   :
     1179       find first buf_clob-bind no-lock where
     1180                 buf_clob-bind.uniq-key-rec = p-gate-name
     1181             and buf_clob-bind.field-name = '':U
     1182             and buf_clob-bind.part-num = 1
     1183             and buf_clob-bind.resource-type = 'gate':U
     1184             no-error.
     1185       if not available buf_clob-bind then do:
     1186         undo, return error substitute("Неверная ссылка на XSD -файл &1 для gate"
     1187                                         , p-gate-name
     1188                                         ).
     1189       end.
     1190       find first buf_clob-data no-lock where
     1191                 buf_clob-data.db-num = buf_clob-bind.db-num
     1192             and buf_clob-data.int64-i= buf_clob-bind.int64-id no-error.
     1193       if not available buf_clob-data then do:
     1194         undo, return error substitute("Не найден CLOB c ДБ &1 id &2 - файл &3"
     1195                                         , buf_clob-bind.db-num
     1196                                         , buf_clob-bind.int64-id
     1197                                         , p-gate-name
     1198                                         ).
     1199       end.
     1200       run gen-key-rec in this-procedure ( input 'clob-data':U
     1201                                 ,input buffer buf_clob-data:handle
     1202                                 ,output p-gate-rec).
     1203   end.
     1204   end procedure.
     1205   procedure get-gate-by-name :
     1206   define input  parameter p-gate-name as character no-undo .
     1207   define output parameter p-gate-rec as character no-undo .
     1208   define output parameter p-dsh as handle no-undo .
     1209   define input-output  parameter p-xmlh as handle no-undo .
     1210   define variable v-ii as integer   no-undo .
     1211   define variable glog as logical   no-undo .
     1212   define variable v-longchar as longchar no-undo .
     1213   define variable v-txmlh as handle no-undo .
     1214   define variable v-db-num as integer no-undo .
     1215   define variable v-int64-id as int64 no-undo .
     1216   define buffer buf_clob-bind for ub.clob-bind.
     1217   define buffer buf_clob-data for ub.clob-data.
     1218   main-block:
     1219   do
     1220   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info5, return-value, chr(10), error-status :get-message (1))
     1221   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info5 )
     1222   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info5 )
     1223   :
     1224       find first buf_clob-bind no-lock where
     1225                 buf_clob-bind.uniq-key-rec = p-gate-name
     1226             and buf_clob-bind.field-name = '':U
     1227             and buf_clob-bind.part-num = 1
     1228             and buf_clob-bind.resource-type = 'gate':U
     1229             no-error.
     1230       if not available buf_clob-bind then do:
     1231         undo, return error substitute("Неверная ссылка на XSD -файл &1 для gate"
     1232                                         , p-gate-name
     1233                                         ).
     1234       end.
     1235       find first buf_clob-data no-lock where
     1236                 buf_clob-data.db-num = buf_clob-bind.db-num
     1237             and buf_clob-data.int64-i= buf_clob-bind.int64-id no-error.
     1238       if not available buf_clob-data then do:
     1239         undo, return error substitute("Не найден CLOB c ДБ &1 id &2 - файл &3"
     1240                                         , buf_clob-bind.db-num
     1241                                         , buf_clob-bind.int64-id
     1242                                         , p-gate-name
     1243                                         ).
     1244       end.
     1245       assign
     1246       v-longchar = buf_clob-data.cdata
     1247       .
     1248       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1249       if error-status :error then do:
     1250         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, buf_clob-data.file-name_, chr(10), error-status:get-message(1) , return-value ).
     1251       end.
     1252       create dataset p-dsh .
     1253       glog = p-dsh:READ-XMLSCHEMA( "LONGCHAR"
     1254                                     , v-longchar
     1255                                     , ?
     1256                                     , ?
     1257                                     , ?
     1258                                     ) no-error.
     1259       v-longchar = '':U.
     1260       if error-status :error
     1261       or not glog
     1262       then do:
     1263         undo, return error substitute("Не удалось прочитать XML-схему &1 из БД:&2&3", p-gate-name, chr(10), error-status:get-message(1) ).
     1264       end.
     1265       if not valid-handle(p-xmlh)
     1266       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     1267         create temp-table v-txmlh.
     1268         v-txmlh:create-like(buffer temp-xml-tables:handle).
     1269         v-txmlh:temp-table-prepare("temp-xml-tables").
     1270         p-xmlh = v-txmlh:default-buffer-handle.
     1271       end.
     1272       run gen-key-rec in this-procedure ( input 'clob-data':U
     1273                                 ,input buffer buf_clob-data:handle
     1274                                 ,output p-gate-rec).
     1275       do v-ii = 1 to p-dsh:num-buffers:
     1276         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     1277         if not p-xmlh:available then do:
     1278           p-xmlh:buffer-create().
     1279           assign
     1280           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     1281           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1282           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1283           p-xmlh::gate-handle_ = p-dsh
     1284           p-xmlh::uniq-gate-rec = p-gate-rec
     1285           p-xmlh::gate-name = p-dsh:name
     1286           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1287           .
     1288           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1289             assign
     1290             p-xmlh::order = -3.
     1291           end.
     1292         end.
     1293       end.
     1294   end.
     1295   end procedure.
     1296   procedure get-gate-by-rec :
     1297   define input  parameter p-gate-rec as character no-undo .
     1298   define output parameter p-dsh as handle no-undo .
     1299   define input-output  parameter p-xmlh as handle no-undo .
     1300   define input-output parameter p-longchar  as longchar no-undo .
     1301   define variable v-ii as integer   no-undo .
     1302   define variable glog as logical   no-undo .
     1303   define variable v-rowid as rowid no-undo .
     1304   define variable v-tbl-name as character no-undo .
     1305   define variable v-longchar as longchar no-undo .
     1306   define variable v-txmlh as handle no-undo .
     1307   define buffer buf_clob-data for ub.clob-data.
     1308   main-block:
     1309   do
     1310   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info5, return-value, chr(10), error-status :get-message (1))
     1311   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info5 )
     1312   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info5 )
     1313   :
     1314     run gen-row-keyr in this-procedure (
     1315                                           input  p-gate-rec
     1316                                           ,input  ?
     1317                                           ,input  "ub"
     1318                                           ,input  ?
     1319                                           ,input  NO-LOCK
     1320                                           ,output v-rowid
     1321                                           ,output v-tbl-name   ) no-error.
     1322       find first buf_clob-data no-lock where
     1323                 rowid(buf_clob-data) = v-rowid  no-error.
     1324       if not available buf_clob-data then do:
     1325         undo, return error substitute("Не найден CLOB  &1"
     1326                                         , p-gate-rec
     1327                                         ).
     1328       end.
     1329       assign
     1330       v-longchar = buf_clob-data.cdata
     1331       .
     1332       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1333       if error-status :error then do:
     1334         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, buf_clob-data.file-name_, chr(10), error-status:get-message(1) , return-value ).
     1335       end.
     1336       create dataset p-dsh .
     1337       glog = p-dsh:READ-XMLSCHEMA( "LONGCHAR"
     1338                                     , v-longchar
     1339                                     , ?
     1340                                     , ?
     1341                                     , ?
     1342                                     ) no-error.
     1343       define variable v-esm as character no-undo .
     1344       v-esm = error-status:get-message(1) .
     1345       if p-longchar <> ? then do:
     1346         p-longchar = v-longchar.
     1347       end.
     1348       v-longchar = '':U.
     1349       if error-status :error
     1350       or not glog
     1351       then do:
     1352         undo, return error substitute("Не удалось прочитать XML-схему &1 (&2) из БД&3&4"
     1353                                      , p-gate-rec
     1354                                      , p-gate-rec
     1355                                      , v-esm
     1356                                      ).
     1357       end.
     1358       p-dsh:private-data = buf_clob-data.file-name_ + chr(4) + p-gate-rec.
     1359       if not valid-handle(p-xmlh)
     1360       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     1361         create temp-table v-txmlh.
     1362         v-txmlh:create-like(buffer temp-xml-tables:handle).
     1363         v-txmlh:temp-table-prepare("temp-xml-tables").
     1364         p-xmlh = v-txmlh:default-buffer-handle.
     1365       end.
     1366       do v-ii = 1 to p-dsh:num-buffers:
     1367         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     1368         if not p-xmlh:available then do:
     1369           p-xmlh:buffer-create().
     1370           assign
     1371           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     1372           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1373           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1374           p-xmlh::gate-handle_ = p-dsh
     1375           p-xmlh::uniq-gate-rec = p-gate-rec
     1376           p-xmlh::gate-name = p-dsh:name
     1377           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1378           .
     1379           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1380             assign
     1381             p-xmlh::order = -3.
     1382           end.
     1383           p-xmlh:buffer-release().
     1384         end.
     1385       end.
     1386   end.
     1387   end procedure.
     1388   procedure get-gate-by-file :
     1389   define input  parameter p-schema-file-name as character no-undo .
     1390   define input  parameter p-gate-rec as character no-undo .
     1391   define output parameter p-dsh as handle no-undo .
     1392   define input-output  parameter p-xmlh as handle no-undo .
     1393   define variable v-ii as integer   no-undo .
     1394   define variable glog as logical   no-undo .
     1395   define variable v-rowid as rowid no-undo .
     1396   define variable v-tbl-name as character no-undo .
     1397   define variable v-longchar as longchar no-undo .
     1398   define variable v-txmlh as handle no-undo .
     1399   main-block:
     1400   do
     1401   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info5, return-value, chr(10), error-status :get-message (1))
     1402   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info5 )
     1403   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info5 )
     1404   :
     1405       COPY-LOB
     1406       FROM  FILE p-schema-file-name
     1407       TO  OBJECT v-longchar
     1408       no-convert
     1409       NO-ERROR .
     1410       if error-status :error then do:
     1411           undo, return error substitute("Не удалось считать файл схемы &1 в память&2&3"
     1412                                     , p-schema-file-name
     1413                                 , chr(10)
     1414                                 , error-status:get-message(1) ).
     1415       end.
     1416       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1417       if error-status :error then do:
     1418         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, p-schema-file-name, chr(10), error-status:get-message(1) , return-value ).
     1419       end.
     1420       create dataset p-dsh .
     1421       glog = p-dsh:READ-XMLSCHEMA( "longchar"
     1422                                     , v-longchar
     1423                                     , ?
     1424                                     , ?
     1425                                     , ?
     1426                                     ) no-error.
     1427       v-longchar = ''.
     1428       if error-status :error
     1429       or not glog
     1430       then do:
     1431         undo, return error substitute("Не удалось прочитать XML-схему из файла &1&2&3"
     1432                                      , p-schema-file-name
     1433                                      ,chr(10)
     1434                                      , error-status:get-message(1)
     1435                                      ).
     1436       end.
     1437       if not valid-handle(p-xmlh)
     1438       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     1439         create temp-table v-txmlh.
     1440         v-txmlh:create-like(buffer temp-xml-tables:handle).
     1441         v-txmlh:temp-table-prepare("temp-xml-tables").
     1442         p-xmlh = v-txmlh:default-buffer-handle.
     1443       end.
     1444       do v-ii = 1 to p-dsh:num-buffers:
     1445         p-xmlh:find-first(substitute(' where tbl-name = "&1" and  uniq-gate-rec = "&2" '
     1446                                      ,p-dsh:get-buffer-handle(v-ii):name
     1447                                      ,p-gate-rec
     1448                                      )) no-error.
     1449         if not p-xmlh:available then do:
     1450           p-xmlh:buffer-create().
     1451           assign
     1452           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):table
     1453           p-xmlh::uniq-gate-rec = p-gate-rec
     1454           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1455           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1456           p-xmlh::gate-handle_ = p-dsh
     1457           p-xmlh::gate-name = p-dsh:name
     1458           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1459           .
     1460           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1461             assign
     1462             p-xmlh::order = -3.
     1463           end.
     1464           p-xmlh:buffer-release().
     1465         end.
     1466       end.
     1467   end.
     1468   end procedure.
     1469   procedure gate-clear :
     1470   define input  parameter p-dsh as handle no-undo .
     1471   define input  parameter p-xmlh as handle no-undo .
     1472   define variable v-dsh as handle no-undo .
     1473   define variable v-th as handle no-undo .
     1474     do
     1475     on error undo, return error return-value
     1476     :
     1477       if valid-handle(p-dsh) then do:
     1478         delete object p-dsh.
     1479         v-dsh = p-dsh.
     1480         p-dsh = ?.
     1481       end.
     1482       repeat while true:
     1483         p-xmlh:find-first( substitute( " where gate-handle_ = &1 ", v-dsh)
     1484                            , share-lock) no-error.
     1485         if p-xmlh:available then do:
     1486           assign
     1487           v-th = p-xmlh:buffer-field("table-handle_"):buffer-value.
     1488           if valid-handle(p-xmlh:buffer-field("table-handle_"))
     1489           and valid-handle(v-th)
     1490           and v-th:dynamic = yes
     1491           then do:
     1492             delete object p-xmlh:buffer-field("table-handle_"):buffer-value.
     1493             p-xmlh:buffer-field("table-handle_"):buffer-value = ?.
     1494           end.
     1495           p-xmlh:buffer-delete().
     1496         end.
     1497         else do:
     1498           leave.
     1499         end.
     1500       end.
     1501       if p-xmlh:dynamic = yes
     1502       and valid-handle(p-xmlh)
     1503       then do:
     1504         delete object p-xmlh:table-handle.
     1505         p-xmlh = ?.
     1506       end.
     1507       v-dsh = ?.
     1508     end.
     1509   end procedure.
     1510   procedure all-gates-clear :
     1511   define parameter buffer buf_temp-xml-tables for temp-xml-tables.
     1512   do
     1513   on error undo, return error
     1514   :
     1515     for each buf_temp-xml-tables
     1516     break
     1517     by buf_temp-xml-tables.uniq-gate-rec
     1518     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1519     on stop   undo , return error substitute( "&1. stop", vss-workfile )
     1520     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     1521     :
     1522         if first-of(buf_temp-xml-tables.uniq-gate-rec) then do:
     1523           delete object buf_temp-xml-tables.gate-handle_.
     1524           buf_temp-xml-tables.gate-handle_ = ?.
     1525         end.
     1526         if valid-handle(buf_temp-xml-tables.table-handle_)
     1527         and buf_temp-xml-tables.table-handle_:dynamic = no
     1528         then do:
     1529           delete object buf_temp-xml-tables.table-handle_.
     1530           buf_temp-xml-tables.table-handle_ = ?.
     1531         end.
     1532         delete buf_temp-xml-tables.
     1533     end.
     1534   end.
     1535   end procedure.
     1536   procedure fix-schemalocation :
     1537   define input-output  parameter p-longchar as longchar no-undo .
     1538   DEFINE VARIABLE hdoc AS HANDLE.
     1539   DEFINE VARIABLE hroot AS HANDLE.
     1540   DEFINE VARIABLE hnode-child AS HANDLE.
     1541   DEFINE VARIABLE hnode-attr AS HANDLE.
     1542   define variable v-jj as integer   no-undo .
     1543   define variable ok as logical   no-undo .
     1544   define variable v-path1                    as character                no-undo .
     1545   DEFINE VARIABLE v-full-path1               as character                no-undo .
     1546   DEFINE VARIABLE v-file-name1               as character                no-undo .
     1547   DEFINE VARIABLE v-file-name-no-ext1        as character                no-undo .
     1548   DEFINE VARIABLE v-file-name-ext1           as character                no-undo .
     1549   define variable v-schema-location          as character                no-undo .
     1550   do
     1551   on error undo, return error return-value
     1552   :
     1553     CREATE X-DOCUMENT hdoc.
     1554     CREATE X-noderef hroot.
     1555     CREATE X-noderef hnode-child.
     1556     CREATE X-noderef hnode-attr.
     1557     hdoc:load("longchar", p-longchar, no) no-error.
     1558     iF ERROR-STATUS:GET-MESSAGE(1) <> '' THEN message ERROR-STATUS:GET-MESSAGE(1) view-as alert-box .
     1559     hdoc:get-document-element(hroot).
     1560     _repeat:
     1561     REPEAT v-jj = 1 TO hroot:NUM-CHILDREN:
     1562       ok = hroot:GET-CHILD(hNode-Child, v-jj).
     1563       if not ok then next.
     1564       if hNode-Child:local-name = "include"
     1565       then do:
     1566         ok = hNode-Child:GET-ATTRIBUTE-NODE( hnode-attr, "schemaLocation" ).
     1567           v-schema-location = hnode-attr:node-value.
     1568           run gbl/filename.p (
     1569                           input "exe/" + hnode-attr:node-value
     1570                         ,output v-full-path1
     1571                         ,output v-path1
     1572                         ,output v-file-name1
     1573                         ,output v-file-name-no-ext1
     1574                         ,output v-file-name-ext1
     1575                         ) no-error .
     1576           if error-status :error then do:
     1577             delete object hnode-attr.
     1578             delete object hnode-child.
     1579             delete object hroot.
     1580             delete object hdoc.
     1581             undo, return error substitute("Не удалось определить расположение схемы &1", v-schema-location).
     1582           end.
     1583         ok = hNode-Child:sET-ATTRIBUTE(  "schemaLocation", v-full-path1 ).
     1584         leave  _repeat.
     1585       end.
     1586     END.
     1587     hdoc:save("longchar", p-longchar).
     1588     delete object hnode-attr.
     1589     delete object hnode-child.
     1590     delete object hroot.
     1591     delete object hdoc.
     1592   end.
     1593   end procedure.
     1594   procedure gate-clb_fill-xml-tables :
     1595   define input parameter p-dsh as handle no-undo .
     1596   define input-output parameter p-xmlh as handle no-undo .
     1597   define variable v-ii as integer no-undo .
     1598     do
     1599     on error undo, return error
     1600     :
     1601       do v-ii = 1 to p-dsh:num-buffers:
     1602         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     1603         if not p-xmlh:available then do:
     1604           p-xmlh:buffer-create().
     1605           assign
     1606           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     1607           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1608           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1609           p-xmlh::gate-handle_ = p-dsh
     1610           p-xmlh::uniq-gate-rec = entry(2, p-dsh:private-data, chr(4))
     1611           p-xmlh::gate-name = p-dsh:name
     1612           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1613           .
     1614           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1615             assign
     1616             p-xmlh::order = -3.
     1617           end.
     1618           p-xmlh:buffer-release().
     1619         end.
     1620       end.
     1621     end.
     1622   end procedure.
     1623   procedure all-gates-empty :
     1624   define buffer buf_temp-xml-tables for temp-xml-tables.
     1625   do
     1626   on error undo, return error
     1627   :
     1628     for each buf_temp-xml-tables
     1629     break
     1630     by buf_temp-xml-tables.uniq-gate-rec
     1631     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1632     on stop   undo , return error substitute( "&1. stop", vss-workfile )
     1633     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     1634     :
     1635       if valid-handle(buf_temp-xml-tables.tbl-handle_) then do:
     1636         buf_temp-xml-tables.tbl-handle_:empty-temp-table().
     1637       end.
     1638     end.
     1639   end.
     1640   end procedure.
     1641   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1642   procedure esallatr-name :
     1643   do
     1644     on error undo, return error
     1645     :
     1646     define input  parameter p-code           as character no-undo .
     1647     define output parameter p-type           as character no-undo .
     1648     define output parameter p-format         as character no-undo .
     1649     define output parameter p-label          as character no-undo .
     1650     define output parameter p-user-can-edit  as logical   no-undo .
     1651     define output parameter p-output-display as logical   no-undo .
     1652     define output parameter p-other          as character no-undo .
     1653       case p-code :
     1654               when 'custom-pack-name':U then do:     assign     p-label = "Имя файла в ВС"     p-type = 'C':U      p-format = "X(255)"     p-label = "Имя файла в ВС"     p-user-can-edit  = false     p-output-display = false     p-other = ""      .   end.
     1655               when 'route-custom-pack-name':U then do:     assign     p-label = "Иям файла в ВС"     p-type = 'C':U      p-format = "X(255)"     p-label = "Иям файла в ВС"     p-user-can-edit  = false     p-output-display = false     p-other = ""      .   end.
     1656         otherwise do:
     1657           undo, return error substitute("неизвестный атрибут ВС &1", p-code) .
     1658         end.
     1659       end.
     1660     end.
     1661   end procedure.
     1662   procedure esallatr-value :
     1663   do
     1664     on error undo, return error
     1665     :
     1666     define input  parameter p-table-name as character no-undo .
     1667     define input  parameter p-key1     as int64 no-undo .
     1668     define input  parameter p-key2     as int64 no-undo .
     1669     define input  parameter p-key3     as character no-undo .
     1670     define input  parameter p-key4     as character no-undo .
     1671     define input  parameter p-key5     as int64 no-undo .
     1672     define input  parameter p-key6     as int64 no-undo .
     1673     define input  parameter p-key7     as character no-undo .
     1674     define input  parameter p-key8     as character no-undo .
     1675     define input  parameter p-code     as character no-undo .
     1676     define output parameter p-value    as character no-undo .
     1677     define output parameter p-type     as character no-undo .
     1678     define buffer buf_esys-all-attr for ub.esys-all-attr.
     1679     define variable v-format         as character no-undo .
     1680     define variable v-label          as character no-undo .
     1681     define variable v-user-can-edit  as logical   no-undo .
     1682     define variable v-output-display as logical   no-undo .
     1683     define variable v-other          as character no-undo .
     1684       run esallatr-name in this-procedure
     1685         (input  p-code
     1686         ,output p-type
     1687         ,output v-format
     1688         ,output v-label
     1689         ,output v-user-can-edit
     1690         ,output v-output-display
     1691         ,output v-other
     1692         ) no-error .
     1693       if error-status :error then do:
     1694         undo, return error return-value .
     1695       end.
     1696       Find first  buf_esys-all-attr no-lock where
     1697                   buf_esys-all-attr.attr-code = p-code
     1698              and  buf_esys-all-attr.table-name  = p-table-name
     1699              and  buf_esys-all-attr.key1  = p-key1
     1700              and  buf_esys-all-attr.key2  = p-key2
     1701              and  buf_esys-all-attr.key3  = p-key3
     1702              and  buf_esys-all-attr.key4  = p-key4
     1703              and  buf_esys-all-attr.key5  = p-key5
     1704              and  buf_esys-all-attr.key6  = p-key6
     1705              and  buf_esys-all-attr.key7  = p-key7
     1706              and  buf_esys-all-attr.key8  = p-key8  no-error .
     1707      if avail buf_esys-all-attr then do:
     1708       assign
     1709       p-value = buf_esys-all-attr.attr-value.
     1710      end.
     1711      else do:
     1712       assign
     1713       p-value = if p-type = 'L':U then "no":U else "".
     1714      end.
     1715   end.
     1716   end procedure.
     1717   define temp-table for-route no-undo
     1718     field name-rec as character
     1719     field db-list  as character
     1720     field dump-ord like ub.route.dump-ord
     1721     field uniq-gate-rec like ub.route.uniq-gate-rec
     1722     field custom-pck-name as character
     1723     field action as character
     1724     index pi is primary unique dump-ord
     1725   .
     1726   define temp-table for-route-dump no-undo like ub.route-dump
     1727       field blob-value-rec as blob.
     1728   on delete of this-procedure do:
     1729     for each for-route
     1730     :
     1731       delete for-route.
     1732     end.
     1733     for each for-route-dump
     1734     :
     1735       delete for-route-dump.
     1736     end.
     1737   end.
     1738   procedure begin-create-command :
     1739     define input  parameter p-command-name as character no-undo .
     1740     define input  parameter p-db-list      as character no-undo .
     1741     define output parameter p-command-code as integer   no-undo .
     1742     do
     1743     on error  undo, return error substitute( "&1 (begin-create-command). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1744     on stop   undo, return error substitute( "&1 (begin-create-command). stop", vss-workfile )
     1745     on endkey undo, return error substitute( "&1 (begin-create-command). endkey", vss-workfile )
     1746     :
     1747       if num-entries( p-command-name, chr(1) ) > 1
     1748         or num-entries( p-command-name, chr(3) ) > 1
     1749       then do:
     1750         return error substitute( "&1 (begin-create-command). Название команды не может содержать символы chr(1), chr(3)!!!", vss-workfile ) .
     1751       end.
     1752       if trim( p-command-name ) = "":U
     1753         or p-command-name = ?
     1754       then do:
     1755         return error substitute( "&1 (begin-create-command). Команда должна иметь название!!!", vss-workfile ) .
     1756       end.
     1757       find last for-route
     1758         no-error .
     1759       if available for-route then do:
     1760         assign
     1761           p-command-code = for-route.dump-ord + 1
     1762         .
     1763       end.
     1764       else do:
     1765         assign
     1766           p-command-code = 1
     1767         .
     1768       end.
     1769       create for-route .
     1770       assign
     1771         for-route.name-rec = p-command-name
     1772         for-route.db-list  = p-db-list
     1773         for-route.dump-ord = p-command-code
     1774       .
     1775     end.
     1776     return.
     1777   end procedure.
     1778   procedure add-dump :
     1779     define input  parameter p-command-code as integer   no-undo .
     1780     define input  parameter p-dump-name    as character no-undo .
     1781     define input  parameter p-action       as character no-undo .
     1782     define input  parameter p-tbl-handle   as handle    no-undo .
     1783     define input  parameter p-uniq-gate-rec as character no-undo .
     1784     define output parameter p-rec-ord      as integer   no-undo .
     1785     do
     1786     on error  undo, return error substitute( "&1 (add-dump). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1787     on stop   undo, return error substitute( "&1 (add-dump). stop", vss-workfile )
     1788     on endkey undo, return error substitute( "&1 (add-dump). endkey", vss-workfile )
     1789     :
     1790       define variable v-rec-ord      like ub.route-dump.rec-ord .
     1791       define variable v-uniq-key-rec like ub.route-dump.uniq-key-rec .
     1792       define variable v-value-rec    like ub.route-dump.value-rec .
     1793       define variable v-first-char as character no-undo .
     1794       define variable v-cre-raw    as logical   no-undo .
     1795       find first for-route
     1796         where for-route.dump-ord = p-command-code
     1797         no-error .
     1798       if not available for-route then do:
     1799         return error substitute( "&1 (add-dump). Команда с кодом &2 еще не создана!", vss-workfile, p-command-code ) .
     1800       end.
     1801       if p-uniq-gate-rec <> '' then do:
     1802         if for-route.uniq-gate-rec = '':U then do:
     1803           for-route.uniq-gate-rec = p-uniq-gate-rec.
     1804         end.
     1805         else do:
     1806           if for-route.uniq-gate-rec <> p-uniq-gate-rec then do:
     1807               undo, return error
     1808               substitute( "&1 (add-dump). &2&3&4"
     1809                           , vss-workfile
     1810                           , return-value
     1811                           , chr(10)
     1812                           , substitute("в route-dump указан непустой gate &1 отличный от gate route (&2)"
     1813                                        , for-route-dump.uniq-gate-rec
     1814                                        , for-route.uniq-gate-rec)
     1815                           ).
     1816           end.
     1817         end.
     1818       end.
     1819       assign
     1820         v-first-char = substring( p-action, 1, 1 )
     1821         v-cre-raw    = true
     1822       .
     1823       if trim( p-action ) <> "":U then do:
     1824         if lookup( v-first-char, "+,-,_":U, ",":U ) = 0 then do:
     1825           return error substitute( "&1 (add-dump). Ошибка задания входных параметров! &2"
     1826                                   + "Задан параметр action. Первый его символ должен быть '+' или '-' или '_'. "
     1827                                   + "Текущее значение: &3"
     1828                                   ,vss-workfile
     1829                                   ,chr(10)
     1830                                   ,p-action
     1831                                 ) .
     1832         end.
     1833         else do:
     1834           if v-first-char = "-":U
     1835           or v-first-char = "_":U
     1836           then do:
     1837             assign
     1838               v-cre-raw = false
     1839             .
     1840           end.
     1841         end.
     1842       end.
     1843       find last for-route-dump
     1844         where for-route-dump.dump-ord = p-command-code
     1845         no-error .
     1846       if available for-route-dump then do:
     1847         assign
     1848           v-rec-ord = for-route-dump.rec-ord + 1
     1849         .
     1850       end.
     1851       else do:
     1852         assign
     1853           v-rec-ord = 1
     1854         .
     1855       end.
     1856       if v-first-char <> '_' then do:
     1857       run gen-key-rec in this-procedure
     1858         ( input  p-dump-name
     1859          ,input  p-tbl-handle
     1860          ,output v-uniq-key-rec
     1861         ) no-error.
     1862       if error-status :error then do:
     1863         return error substitute( "&1 (add-dump). Ошибка при генерации уникального ключа по таблице &2 для команды с кодом &3.&4&5&4&6"
     1864                                  ,vss-workfile
     1865                                  ,p-dump-name
     1866                                  ,p-command-code
     1867                                  ,chr(10)
     1868                                  ,return-value
     1869                                  ,error-status :get-message ( 1 )
     1870                                 ) .
     1871       end.
     1872       end.
     1873       if v-cre-raw = true then do:
     1874         run cre-raw in this-procedure
     1875           ( input  p-dump-name
     1876            ,input  p-tbl-handle
     1877            ,output v-value-rec
     1878           ) no-error.
     1879         if error-status :error then do:
     1880           return error substitute( "&1 (add-dump). Ошибка при сжатии записи по таблице &2 в команду с кодом &3.&4&5&4&6"
     1881                                   ,vss-workfile
     1882                                   ,p-dump-name
     1883                                   ,p-command-code
     1884                                   ,chr(10)
     1885                                   ,return-value
     1886                                   ,error-status :get-message ( 1 )
     1887                                   ) .
     1888         end.
     1889       end.
     1890       create for-route-dump .
     1891       assign
     1892         for-route-dump.dump-name    = entry(1, p-dump-name, chr(4))
     1893         for-route-dump.action       = p-action
     1894         for-route-dump.dump-ord     = p-command-code
     1895         for-route-dump.rec-ord      = v-rec-ord
     1896         for-route-dump.uniq-key-rec = v-uniq-key-rec
     1897         for-route-dump.value-rec    = v-value-rec
     1898         for-route-dump.uniq-gate-rec = p-uniq-gate-rec
     1899         p-rec-ord                   = v-rec-ord
     1900       .
     1901     end.
     1902     return.
     1903   end procedure.
     1904   procedure add-dump-data :
     1905     define input  parameter p-command-code as integer   no-undo .
     1906     define input  parameter p-dump-name    as character no-undo .
     1907     define input  parameter p-action       as character no-undo .
     1908     define input  parameter p-data         as memptr    no-undo .
     1909     define output parameter p-rec-ord      as integer   no-undo .
     1910     do
     1911     on error  undo, return error substitute( "&1 (add-dump). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1912     on stop   undo, return error substitute( "&1 (add-dump). stop", vss-workfile )
     1913     on endkey undo, return error substitute( "&1 (add-dump). endkey", vss-workfile )
     1914     :
     1915       define variable v-rec-ord      like ub.route-dump.rec-ord .
     1916       define variable v-first-char as character no-undo .
     1917       find first for-route
     1918         where for-route.dump-ord = p-command-code
     1919         no-error .
     1920       if not available for-route then do:
     1921         return error substitute( "&1 (add-dump). Команда с кодом &2 еще не создана!", vss-workfile, p-command-code ) .
     1922       end.
     1923       assign
     1924         v-first-char = substring( p-action, 1, 1 ).
     1925       if trim( p-action ) <> "":U then do:
     1926         if lookup( v-first-char, "+,-,_":U, ",":U ) = 0 then do:
     1927           return error substitute( "&1 (add-dump). Ошибка задания входных параметров! &2"
     1928                                   + "Задан параметр action. Первый его символ должен быть '+' или '-' или '_'. "
     1929                                   + "Текущее значение: &3"
     1930                                   ,vss-workfile
     1931                                   ,chr(10)
     1932                                   ,p-action
     1933                                 ) .
     1934         end.
     1935       end.
     1936       find last for-route-dump
     1937         where for-route-dump.dump-ord = p-command-code
     1938         no-error .
     1939       if available for-route-dump then do:
     1940         assign
     1941           v-rec-ord = for-route-dump.rec-ord + 1
     1942         .
     1943       end.
     1944       else do:
     1945         assign
     1946           v-rec-ord = 1
     1947         .
     1948       end.
     1949       create for-route-dump .
     1950       assign
     1951         for-route-dump.dump-name    = entry(1, p-dump-name, chr(4))
     1952         for-route-dump.uniq-key-rec = if num-entries(p-dump-name, chr(4)) > 1 then  entry(2, p-dump-name, chr(4)) else ""
     1953         for-route-dump.action       = p-action
     1954         for-route-dump.dump-ord     = p-command-code
     1955         for-route-dump.rec-ord      = v-rec-ord
     1956         for-route-dump.blob-value-rec    = p-data
     1957         p-rec-ord                   = v-rec-ord
     1958       .
     1959     end.
     1960     return.
     1961   end procedure.
     1962   procedure delete-command :
     1963     define input parameter p-command-code as integer   no-undo .
     1964     do
     1965     on error  undo, return error substitute( "&1 (delete-command). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1966     on stop   undo, return error substitute( "&1 (delete-command). stop", vss-workfile )
     1967     on endkey undo, return error substitute( "&1 (delete-command). endkey", vss-workfile )
     1968     :
     1969       for each for-route
     1970         where for-route.dump-ord = p-command-code
     1971       on error undo, return error substitute( "&1 (delete-command). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1972       :
     1973         delete for-route.
     1974       end.
     1975       for each for-route-dump
     1976         where for-route-dump.dump-ord = p-command-code
     1977       on error undo, return error substitute( "&1 (delete-command). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1978       :
     1979         delete for-route-dump.
     1980       end.
     1981     end.
     1982     return.
     1983   end procedure.
     1984   procedure send-command :
     1985     define input parameter p-command-code as integer   no-undo .
     1986     define input parameter p-db-list      as character no-undo .
     1987     do
     1988     on error  undo, return error substitute( "&1 (send-command). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
