     2239         on error undo, return error substitute( "&1 (send-command-esys). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     2240         :
     2241           assign
     2242             v-rec-ord = v-rec-ord + 1
     2243           .
     2244           create buf_esys-route-dump .
     2245           assign
     2246           buf_esys-route-dump.esrd-action       = for-route-dump.action
     2247           buf_esys-route-dump.esrd-cr-db-num    = buf_sys-ctrl.db-num
     2248           buf_esys-route-dump.esrd-dump-name    = for-route-dump.dump-name
     2249           buf_esys-route-dump.esrd-dump-ord     = v-dmp-ord
     2250           buf_esys-route-dump.esrd-rec-ord      = v-rec-ord
     2251           buf_esys-route-dump.esrd-uniq-key-rec = for-route-dump.uniq-key-rec
     2252           buf_esys-route-dump.uniq-gate-rec     = for-route-dump.uniq-gate-rec
     2253           buf_esys-route-dump.esrd-value-rec    = for-route-dump.value-rec
     2254           .
     2255           buf_esys-route-dump.esrd-blob-value-rec = for-route-dump.blob-value-rec .
     2256           v-oper = buf_esys-route-dump.esrd-dump-name .
     2257         end.
     2258         assign
     2259           v-command-name = "command":U + chr(1) + "bush":U + chr(1) + for-route.name-rec
     2260         .
     2261         run cur-time in this-procedure
