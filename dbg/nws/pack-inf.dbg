        1   define input parameter p-action   as character no-undo .
        2   define input parameter p-db-num   like ub.pck-sent.db-num   no-undo.
        3   define input parameter p-pack-num like ub.pck-sent.pack-num no-undo.
        4   define variable vss-revision    as character no-undo init "$Revision$":U .
        5   define variable vss-author      as character no-undo init "$Author$":U .
        6   define variable vss-date        as character no-undo init "$Date$":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        8   define variable vss-archive     as character no-undo init "$Archive$":U .
        9   define variable vss-description as character no-undo init "Информация по пакету".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   procedure proc-alt-shift-f2:
       65     if not ibs.th.gbl.gbl-var:rcode
       66   then
       67     run gbl\inidebug.p .
       68   end.
       69   procedure proc-alt-shift-f3:
       70     run gbl/prvssinf.p
       71       ( input this-procedure
       72       ) .
       73   end.
       74   define variable v-inform-launched as logical no-undo initial false .
       75   procedure proc-alt-shift-f4:
       76     define variable v-action as character no-undo .
       77     if v-inform-launched = false then do:
       78       assign
       79         v-inform-launched = true
       80       .
       81       run gbl/d-inform.w
       82         (  input self
       83         ,  input this-procedure
       84         , output v-action
       85         ) no-error .
       86       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       87       assign
       88         v-inform-launched = false
       89       .
       90     end.
       91   end.
       92   procedure proc-alt-f1:
       93     run gbl/corrhelp.p
       94       (input this-procedure
       95       ) .
       96   end .
       97   on alt-shift-f2 anywhere do:
       98     run proc-alt-shift-f2.
       99   end.
      100   on alt-shift-f3 anywhere do:
      101     run proc-alt-shift-f3 in this-procedure .
      102   end.
      103   on alt-shift-f4 anywhere do:
      104     run proc-alt-shift-f4 in this-procedure.
      105   end.
      106   on alt-f1 anywhere do:
      107     run proc-alt-f1 in this-procedure .
      108   end.
      109   DEFINE BUTTON b-exit AUTO-END-KEY DEFAULT
      110        LABEL "&Выход"
      111        SIZE 10 BY 1
      112        BGCOLOR 8 .
      113   DEFINE BUTTON b-help
      114        LABEL "Помо&щь"
      115        SIZE 10 BY 1
      116        BGCOLOR 8 .
      117   DEFINE VARIABLE f_CreDate AS DATE FORMAT "99/99/9999"
      118        LABEL "Дата создания"
      119        VIEW-AS FILL-IN
      120        SIZE 11 BY 1.
      121   DEFINE VARIABLE f_CreNum AS INTEGER FORMAT "->,>>>,>>9" INITIAL 0
      122        LABEL "Кол-во формирований"
      123        VIEW-AS FILL-IN
      124        SIZE 11 BY 1.
      125   DEFINE VARIABLE f_CreTime AS CHARACTER FORMAT "X(8)"
      126        LABEL "Время создания"
      127        VIEW-AS FILL-IN
      128        SIZE 9 BY 1.
      129   DEFINE VARIABLE f_db-num AS INTEGER FORMAT ">>>>9" INITIAL ?
      130        LABEL "Номер БД"
      131        VIEW-AS FILL-IN
      132        SIZE 6 BY 1.
      133   DEFINE VARIABLE f_pack-num AS INTEGER FORMAT ">>>>>>>>>9" INITIAL ?
      134        LABEL "Номер пакета"
      135        VIEW-AS FILL-IN
      136        SIZE 11 BY 1.
      137   DEFINE VARIABLE f_RcvdDate AS DATE FORMAT "99/99/9999"
      138        LABEL "Дата"
      139        VIEW-AS FILL-IN
      140        SIZE 11 BY 1.
      141   DEFINE VARIABLE f_RcvdTime AS CHARACTER FORMAT "X(8)"
      142        LABEL "Время"
      143        VIEW-AS FILL-IN
      144        SIZE 9 BY 1.
      145   DEFINE VARIABLE f_SendTxtDate AS DATE FORMAT "99/99/9999"
      146        LABEL "Дата последнего"
      147        VIEW-AS FILL-IN
      148        SIZE 11 BY 1.
      149   DEFINE VARIABLE f_SendTxtTime AS CHARACTER FORMAT "X(8)"
      150        LABEL "Время последнего"
      151        VIEW-AS FILL-IN
      152        SIZE 9 BY 1.
      153   DEFINE RECTANGLE RECT-1
      154        EDGE-PIXELS 3 GRAPHIC-EDGE  NO-FILL
      155        SIZE 35 BY 4.5.
      156   DEFINE RECTANGLE RECT-2
      157        EDGE-PIXELS 3 GRAPHIC-EDGE  NO-FILL
      158        SIZE 35 BY 4.54.
      159   DEFINE RECTANGLE RECT-3
      160        EDGE-PIXELS 3 GRAPHIC-EDGE  NO-FILL
      161        SIZE 35 BY 3.5.
      162   DEFINE FRAME pack-inf
      163        b-help AT ROW 1.17 COL 27
      164        b-exit AT ROW 1.25 COL 1.75
      165        f_db-num AT ROW 2.67 COL 21.5 COLON-ALIGNED
      166        f_pack-num AT ROW 3.67 COL 21.5 COLON-ALIGNED
      167        f_CreDate AT ROW 4.67 COL 21.5 COLON-ALIGNED
      168        f_CreTime AT ROW 5.67 COL 21.5 COLON-ALIGNED
      169        f_CreNum AT ROW 8.17 COL 21.5 COLON-ALIGNED
      170        f_SendTxtDate AT ROW 9.17 COL 21.5 COLON-ALIGNED
      171        f_SendTxtTime AT ROW 10.17 COL 21.5 COLON-ALIGNED
      172        f_RcvdDate AT ROW 12.67 COL 21.5 COLON-ALIGNED
      173        f_RcvdTime AT ROW 13.67 COL 21.5 COLON-ALIGNED
      174        "Создание файла пакета" VIEW-AS TEXT
      175             SIZE 22.75 BY .71 AT ROW 7.17 COL 3
      176        "Получение подтверждения" VIEW-AS TEXT
      177             SIZE 25.13 BY .79 AT ROW 11.67 COL 3
      178        RECT-1 AT ROW 2.38 COL 1.88
      179        RECT-2 AT ROW 6.88 COL 1.88
      180        RECT-3 AT ROW 11.42 COL 1.88
      181        SPACE(0.49) SKIP(0.28)
      182       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      183            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      184            TITLE "Дополнительная информация о пакете"
      185            DEFAULT-BUTTON b-exit.
      186   ASSIGN
      187          FRAME pack-inf:SCROLLABLE       = FALSE
      188          FRAME pack-inf:HIDDEN           = TRUE.
      189   ON WINDOW-CLOSE OF FRAME pack-inf
      190   DO:
      191     APPLY "END-ERROR":U TO SELF.
      192   END.
      193   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      194   on help of frame pack-inf
      195   do:
      196     run gbl/app_help.p
      197       (input this-procedure :file-name
      198       ,input ''
      199       ,input ?
      200       ) no-error.
      201     if error-status :error then do:
      202       message
      203         "Ошибка при вызове помощи"
      204         error-status :get-message(1)
      205         view-as alert-box .
      206     end.
      207   end.
      208   run minbtn-set in this-procedure .
      209   on choose of b-help in frame pack-inf
      210   do:
      211     apply "help":u to frame pack-inf .
      212   end.
      213   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      214   procedure minbtn-set :
      215       do
      216           on error undo, return error return-value
      217           :
      218           define variable ii              as integer       no-undo .
      219           define variable fh              as widget-handle no-undo .
      220           define variable hh              as widget-handle no-undo .
      221           define variable v-h             as handle        extent 4 no-undo .
      222           define variable v-name-button   as character     no-undo .
      223           define variable v-help-old-x    as decimal       no-undo .
      224           define variable v-help-old-y    as decimal       no-undo .
      225           define variable v-help-old-size as decimal       no-undo .
      226           define variable v-frame-width   as decimal       no-undo .
      227           define variable jj              as integer       no-undo .
      228           do
      229               on error undo, return error
      230               :
      231               assign
      232                   v-frame-width = frame pack-inf:width - 0.3
      233                   fh            = frame pack-inf:first-child
      234                   hh            = fh:first-child
      235                   ii            = 1
      236                   .
      237               do while valid-handle(hh):
      238                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      239                   do:
      240                       case lc(hh:name) :
      241                           when "b-help" then
      242                               do:
      243                                   hh:load-image-up("cmp/b-help.bmp":u) .
      244                                   hh:load-image-down("cmp/b-help.bmp":u) .
      245                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      246                                   hh:TOOLTIP = "Помощь" .
      247                                   v-help-old-x = hh:column .
      248                                   v-help-old-y = hh:row    .
      249                                   v-help-old-size = hh:width .
      250                                   hh:width-chars = 2.5 .
      251                               end.
      252                           when "b-print" then
      253                               do:
      254                                   hh:load-image("cmp/b-print.bmp":u) .
      255                                   hh:TOOLTIP = "Печать" .
      256                                   v-h[ii] = hh:handle .
      257                                   ii = ii + 1 .
      258                                   hh:width-chars = 3 .
      259                               end.
      260                           when "b-history" or
      261                           when "b-hist" then
      262                               do:
      263                                   hh:load-image("cmp/b-hist.bmp":u) .
      264                                   hh:TOOLTIP = "История" .
      265                                   v-h[ii] = hh:handle .
      266                                   ii = ii + 1 .
      267                                   hh:width-chars = 3 .
      268                               end.
      269                           when "b-sch" then
      270                               do:
      271                                   hh:load-image("cmp/b-sch.bmp":u) .
      272                                   hh:TOOLTIP = "Установка Фильтра" .
      273                                   v-h[ii] = hh:handle .
      274                                   ii = ii + 1 .
      275                                   hh:width-chars = 3 .
      276                               end.
      277                           when "b-hist-user" then
      278                               do:
      279                                   hh:load-image("cmp/b-hist.bmp":u) .
      280                                   hh:TOOLTIP = "История пользователя" .
      281                                   ii = ii + 1 .
      282                               end.
      283                       end case.
      284                   end.
      285                   hh = hh:next-sibling.
      286               end.
      287               b-help:column = v-frame-width - b-help:width-chars.
      288               jj = 0.
      289               repeat ii = 4 to 1 by -1 :
      290                   if valid-handle (v-h[ii] ) then
      291                   do:
      292                       jj  = jj + 1 .
      293                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      294                       v-h[ii]:row    = v-help-old-y .
      295                   end.
      296               end.
      297           end.
      298       end.
      299   end procedure.
      300   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME pack-inf:PARENT eq ?
      301   THEN FRAME pack-inf:PARENT = ACTIVE-WINDOW.
      302   MAIN-BLOCK:
      303   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      304      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      305       define buffer buf_pck-sent for ub.pck-sent .
      306       define buffer buf_pck-rcvd for ub.pck-rcvd .
      307       case p-action :
      308         when "send":U then do:
      309           find first buf_pck-sent no-lock
      310             where buf_pck-sent.db-num   = p-db-num
      311               and buf_pck-sent.pack-num = p-pack-num
      312             no-error
      313           .
      314           if not available buf_pck-sent then do:
      315             message
      316               vss-workfile vss-revision vss-description skip
      317               substitute( "Пакет N &1 для БД &2 не найден.", p-pack-num, p-db-num )
      318               view-as alert-box error
      319             .
      320             return error .
      321           end.
      322           assign
      323             f_db-num      = p-db-num
      324             f_pack-num    = p-pack-num
      325             f_CreDate     = buf_pck-sent.CreDate
      326             f_CreTime     = buf_pck-sent.CreTime
      327             f_CreNum      = buf_pck-sent.CreNum
      328             f_SendTxtDate = buf_pck-sent.SendTxtDate
      329             f_SendTxtTime = buf_pck-sent.SendTxtTime
      330             f_RcvdDate    = buf_pck-sent.RcvdDate
      331             f_RcvdTime    = buf_pck-sent.RcvdTime
      332           .
      333         end.
      334         when "rcvd":U then do:
      335           find first buf_pck-rcvd no-lock
      336             where buf_pck-rcvd.db-num   = p-db-num
      337               and buf_pck-rcvd.pack-num = p-pack-num
      338             no-error
      339           .
      340           if not available buf_pck-rcvd then do:
      341             message
      342               vss-workfile vss-revision vss-description skip
      343               substitute( "Пакет N &1 от БД &2 не найден.", p-pack-num, p-db-num )
      344               view-as alert-box error
      345             .
      346             return error .
      347           end.
      348           assign
      349             f_db-num      = p-db-num
      350             f_pack-num    = p-pack-num
      351             f_CreDate     = buf_pck-rcvd.CreDate
      352             f_CreTime     = buf_pck-rcvd.CreTime
      353             f_CreNum      = buf_pck-rcvd.CreNum
      354             f_SendTxtDate = buf_pck-rcvd.SendTxtDate
      355             f_SendTxtTime = buf_pck-rcvd.SendTxtTime
      356             f_RcvdDate    = buf_pck-rcvd.RcvdDate
      357             f_RcvdTime    = buf_pck-rcvd.RcvdTime
      358           .
      359         end.
      360       end case.
      361     RUN enable_UI.
      362     WAIT-FOR GO OF FRAME pack-inf.
      363   END.
      364   RUN disable_UI.
      365   PROCEDURE disable_UI :
      366     HIDE FRAME pack-inf.
      367   END PROCEDURE.
      368   PROCEDURE enable_UI :
      369     DISPLAY f_db-num f_pack-num f_CreDate f_CreTime f_CreNum f_SendTxtDate
      370             f_SendTxtTime f_RcvdDate f_RcvdTime
      371         WITH FRAME pack-inf.
      372     ENABLE b-help b-exit RECT-1 RECT-2 RECT-3
      373         WITH FRAME pack-inf.
      374     VIEW FRAME pack-inf.
      375   END PROCEDURE.
