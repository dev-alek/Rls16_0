        1   block-level on error undo, throw.
        2   define input parameter p-db-source as integer   no-undo .
        3   define input parameter p-command   as character no-undo .
        4   def var vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        5   def var vss-author      as character no-undo init "$Author: expertek $":U .
        6   def var vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        7   def var vss-workfile    as character no-undo init "$Workfile: dbrecaft.p $":U .
        8   def var vss-archive     as character no-undo init "$Archive: nws/dbrecaft.p $":U .
        9   def var vss-description as character no-undo init "Запуск процедуры выполняемой после окончания two-commit".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   def var vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       69   procedure progs-name :
       70     define input  parameter p-action-code         as character no-undo .
       71     define output parameter p-main-prog-name      as character no-undo .
       72     define output parameter p-list-db-proc-name   as character no-undo .
       73     define output parameter p-commit-proc-name    as character no-undo .
       74     define output parameter p-execution-proc-name as character no-undo .
       75     define output parameter p-recover-proc-name   as character no-undo .
       76     define output parameter p-after-proc-name     as character no-undo .
       77     do
       78     on error undo, return error
       79     :
       80       case p-action-code :
       81               when 'crush_code-range':U then do:     assign       p-main-prog-name      = 'trg/code-rgt.p':U       p-list-db-proc-name   = 'utl/cdrg-dbl.p':U       p-commit-proc-name    = 'comm-crush-cdrg':U       p-execution-proc-name = 'exec-crush-cdrg':U       p-recover-proc-name   = 'rcvr-crush-cdrg':U       p-after-proc-name     = '':U     .   end.
       82               when 'delete_code-range':U then do:     assign       p-main-prog-name      = 'trg/code-rgt.p':U       p-list-db-proc-name   = 'utl/cdrg-dbl.p':U       p-commit-proc-name    = 'comm-del-cdrg':U       p-execution-proc-name = 'exec-del-cdrg':U       p-recover-proc-name   = 'rcvr-del-cdrg':U       p-after-proc-name     = '':U     .   end.
       83               when 'delete_nu-prt-bar-code':U then do:     assign       p-main-prog-name      = 'trg/bar-codt.p':U       p-list-db-proc-name   = 'str/barcddb.p':U       p-commit-proc-name    = 'block-del-prt-bar-code':U       p-execution-proc-name = 'delete-prt-bar-code':U       p-recover-proc-name   = 'undo-delete-prt-bar-code':U       p-after-proc-name     = '':U     .   end.
       84               when 'delete_nu-part-bar-code':U then do:     assign       p-main-prog-name      = 'trg/bar-codt.p':U       p-list-db-proc-name   = 'str/barcddb.p':U       p-commit-proc-name    = 'block-del-part-bar-code':U       p-execution-proc-name = 'delete-part-bar-code':U       p-recover-proc-name   = 'undo-delete-part-bar-code':U       p-after-proc-name     = '':U     .   end.
       85               when 'delete_nu-ucli-bar-code':U then do:     assign       p-main-prog-name      = 'trg/bar-codt.p':U       p-list-db-proc-name   = 'str/barcddb.p':U       p-commit-proc-name    = 'block-del-ucli-bar-code':U       p-execution-proc-name = 'delete-ucli-bar-code':U       p-recover-proc-name   = 'undo-delete-ucli-bar-code':U       p-after-proc-name     = '':U     .   end.
       86               when 'delete_nu-dis-card':U then do:     assign       p-main-prog-name      = 'trg/discardt.p':U       p-list-db-proc-name   = 'trg/discardb.p':U       p-commit-proc-name    = 'block-del-dis-card':U       p-execution-proc-name = 'delete-dis-card':U       p-recover-proc-name   = 'undo-delete-dis-card':U       p-after-proc-name     = '':U     .   end.
       87               when 'chown-dis-card':U then do:     assign       p-main-prog-name      = 'trg/discardt.p':U       p-list-db-proc-name   = 'trg/discardb.p':U       p-commit-proc-name    = 'block-chown-dis-card':U       p-execution-proc-name = 'chown-dis-card':U       p-recover-proc-name   = 'undo-chown-dis-card':U       p-after-proc-name     = 'after-chown-dis-card':U     .   end.
       88               when 'delete_nu-dis-rule':U then do:     assign       p-main-prog-name      = 'trg/dis-rult.p':U       p-list-db-proc-name   = 'trg/disruldb.p':U       p-commit-proc-name    = 'block-del-dis-rule':U       p-execution-proc-name = 'delete-dis-rule':U       p-recover-proc-name   = 'undo-delete-dis-rule':U       p-after-proc-name     = '':U     .   end.
       89               when 'ren-art':U then do:     assign       p-main-prog-name      = 'trg/goodst.p':U       p-list-db-proc-name   = 'utl/renartcd.p':U       p-commit-proc-name    = 'comm-ren-art':U       p-execution-proc-name = 'exec-ren-art':U       p-recover-proc-name   = 'rcvr-ren-art':U       p-after-proc-name     = 'after-ren-art':U     .   end.
       90               when 'delete_nu-clob-data':U then do:     assign       p-main-prog-name      = 'trg/clobdatt.p':U       p-list-db-proc-name   = 'trg/clbdatdb.p':U       p-commit-proc-name    = 'block-del-clob-data':U       p-execution-proc-name = 'delete-clob-data':U       p-recover-proc-name   = 'undo-delete-clob-data':U       p-after-proc-name     = '':U     .   end.
       91               when 'delete_nu-layout':U then do:     assign       p-main-prog-name      = 'trg/layoutt.p':U       p-list-db-proc-name   = 'trg/layoutdb.p':U       p-commit-proc-name    = 'block-del-layout':U       p-execution-proc-name = 'delete-layout':U       p-recover-proc-name   = 'undo-delete-layout':U       p-after-proc-name     = '':U     .   end.
       92               otherwise do:
       93           return error substitute( "&1. Неизвестный тип операции: &2", vss-include-info0, p-action-code ).
       94         end.
       95       end case.
       96     end.
       97     return.
       98   end procedure.
       99   procedure progs-title :
      100     define input  parameter p-action-code         as character no-undo .
      101     define output parameter p-action-title      as character no-undo .
      102     do
      103     on error undo, return error
      104     :
      105       case p-action-code :
      106               when 'crush_code-range':U then do:     assign       p-action-title        = "Разбиение диапазона кодов (code-range)"     .   end.
      107               when 'delete_code-range':U then do:     assign       p-action-title        = "Удаление диапазона кодов (code-range)"     .   end.
      108               when 'delete_nu-prt-bar-code':U then do:     assign       p-action-title        = "Удаление неисп. бар-кода признака"     .   end.
      109               when 'delete_nu-part-bar-code':U then do:     assign       p-action-title        = "Удаление неисп. бар-кода партиии"     .   end.
      110               when 'delete_nu-ucli-bar-code':U then do:     assign       p-action-title        = "Удаление неисп.бар-кода на доп ед.изм."     .   end.
      111               when 'delete_nu-dis-card':U then do:     assign       p-action-title        = "Удаление неиспользуемой ДК"     .   end.
      112               when 'chown-dis-card':U then do:     assign       p-action-title        = "Смена владельца ДК"     .   end.
      113               when 'delete_nu-dis-rule':U then do:     assign       p-action-title        = "Удаление правила скидки по фирме и глобального правила скидки"     .   end.
      114               when 'ren-art':U then do:     assign       p-action-title        = "Изм. артикула и(или) произв. товара"     .   end.
      115               when 'delete_nu-clob-data':U then do:     assign       p-action-title        = "Удаление неиспользуемой clob-data"     .   end.
      116               when 'delete_nu-layout':U then do:     assign       p-action-title        = "Удаление РАСКЛАДКИ"     .   end.
      117               otherwise do:
      118           return error substitute( "&1. Неизвестный тип операции: &2", vss-include-info0, p-action-code ).
      119         end.
      120       end case.
      121     end.
      122     return.
      123   end procedure.
      124   FUNCTION progs-title-function returns character(
      125      input  p-action-code         as character):
      126   define variable p-action-title      as character no-undo .
      127     do
      128     on error undo, return error
      129     :
      130       case p-action-code :
      131               when 'crush_code-range':U then do:     assign       p-action-title        = "Разбиение диапазона кодов (code-range)"     .   end.
      132               when 'delete_code-range':U then do:     assign       p-action-title        = "Удаление диапазона кодов (code-range)"     .   end.
      133               when 'delete_nu-prt-bar-code':U then do:     assign       p-action-title        = "Удаление неисп. бар-кода признака"     .   end.
      134               when 'delete_nu-part-bar-code':U then do:     assign       p-action-title        = "Удаление неисп. бар-кода партиии"     .   end.
      135               when 'delete_nu-ucli-bar-code':U then do:     assign       p-action-title        = "Удаление неисп.бар-кода на доп ед.изм."     .   end.
      136               when 'delete_nu-dis-card':U then do:     assign       p-action-title        = "Удаление неиспользуемой ДК"     .   end.
      137               when 'chown-dis-card':U then do:     assign       p-action-title        = "Смена владельца ДК"     .   end.
      138               when 'delete_nu-dis-rule':U then do:     assign       p-action-title        = "Удаление правила скидки по фирме и глобального правила скидки"     .   end.
      139               when 'ren-art':U then do:     assign       p-action-title        = "Изм. артикула и(или) произв. товара"     .   end.
      140               when 'delete_nu-clob-data':U then do:     assign       p-action-title        = "Удаление неиспользуемой clob-data"     .   end.
      141               when 'delete_nu-layout':U then do:     assign       p-action-title        = "Удаление РАСКЛАДКИ"     .   end.
      142               otherwise do:
      143           return error substitute( "&1. Неизвестный тип операции: &2", vss-include-info0, p-action-code ).
      144         end.
      145       end case.
      146     end.
      147     return p-action-title.
      148   end FUNCTION.
      149   procedure get-row-keyr-string :
      150    define input  parameter p-key-rec  as character no-undo.
      151    define output parameter p-tbl-title as character no-undo.
      152    define output parameter p-rec-string  as character no-undo.
      153     do
      154     on error undo, return error
      155     :
      156       define variable v-full-tbl-name as character no-undo .
      157       define variable bh_tbl-name     as handle    no-undo .
      158       define variable fh              as handle    no-undo .
      159       define variable v-ok            as logical   no-undo .
      160       define variable v-field-num     as integer   no-undo .
      161       define variable v-count-fld     as integer   no-undo .
      162       define variable v-tbl-name as character no-undo.
      163       if p-key-rec = ?
      164         or p-key-rec = "":U
      165       then do:
      166         return error substitute( "&1 (get-row-keyr-string). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info0 ).
      167       end.
      168       assign
      169         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      170         v-full-tbl-name = "ub.":U + v-tbl-name
      171         v-field-num     = num-entries( p-key-rec, chr(3) ) - 1
      172         p-rec-string         = "":U
      173         v-count-fld     = 0
      174       .
      175       find ub._file
      176         where ub._file._file-name = v-tbl-name
      177         no-error.
      178       if not available ub._file then do:
      179         return error substitute( "&1. Таблица &2 отсутствует в БД", vss-include-info0, v-tbl-name ).
      180       end.
      181       assign
      182       p-tbl-title = ub._file._file-label
      183       .
      184       find ub._index
      185         where recid( ub._index  ) = ub._file._prime-index
      186         no-error.
      187       if not available ub._index
      188         or LC( ub._index._index-name ) = "default":U
      189       then do:
      190         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info0, v-tbl-name ).
      191       end.
      192       block_where :
      193       for each ub._index-field of ub._index  ,
      194           each ub._field of _index-field
      195           break by _index-seq
      196       on error undo, return error
      197       :
      198         assign
      199           v-count-fld = v-count-fld + 1
      200         .
      201         if v-count-fld > v-field-num then do:
      202           leave block_where.
      203         end.
      204         if p-rec-string = "":U then do:
      205           assign
      206             p-rec-string = "":U
      207           .
      208         end.
      209         else do:
      210           assign
      211             p-rec-string = p-rec-string + chr(32) + chr(44)
      212           .
      213         end.
      214         assign
      215           p-rec-string = p-rec-string + (if p-rec-string = "":u then "":U else chr(32)) + substitute( "&1 = &2":U, ub._field._label, entry( v-count-fld + 1 , p-key-rec, chr(3) ) )
      216         .
      217       end.
      218       if v-count-fld <> v-field-num then do:
      219         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info0, v-tbl-name ).
      220       end.
      221     end.
      222     return.
      223   end procedure.
      224   FUNCTION uniq-key-rec-string-f returns character(
      225      input  p-uniq-key-rec         as character):
      226   define variable v-tbl-title as character no-undo .
      227   define variable v-rec-string as character no-undo .
      228     do
      229     on error undo, return error
      230     :
      231       run get-row-keyr-string in this-procedure (
      232                                                 input p-uniq-key-rec
      233                                                 ,output v-tbl-title
      234                                                 ,output v-rec-string).
      235       assign
      236       v-rec-string = (if v-tbl-title <> ? and
      237                       v-tbl-title <> "":U
      238                       then (v-tbl-title + ":")
      239                      else "":U) + chr(32) + v-rec-string
      240       .
      241     end.
      242     return v-rec-string.
      243   end FUNCTION.
      244   procedure create_db-rec_route :
      245     define input parameter p1-uniq-key-rec as character no-undo .
      246     define input parameter p1-action       as character no-undo .
      247     define input parameter p1-operation    as character no-undo .
      248     define input parameter p1-send-db-list as character no-undo .
      249     define input parameter p1-db-init      as integer   no-undo .
      250     define input parameter p1-parameters   as character no-undo .
      251     define input parameter p1-answer-code  as integer   no-undo .
      252     define input parameter p1-answer-msg   as character no-undo .
      253     do
      254     on error undo, return error
      255     :
      256       define variable v-command     as character no-undo .
      257       define variable v-ind         as integer   no-undo .
      258       define variable v-num-entries as integer   no-undo .
      259       define variable v-curr-db     as integer   no-undo .
      260       define variable v-db-for-send as character no-undo .
      261       define variable v-db-num      as integer   no-undo .
      262       define variable v-db-num-char as character no-undo .
      263       define buffer buf_sys-ctrl    for ub.sys-ctrl .
      264       find first buf_sys-ctrl no-lock .
      265       assign
      266         v-curr-db     = buf_sys-ctrl.db-num
      267         v-db-for-send = "":U
      268       .
      269       if v-curr-db = 0 then do:
      270         if p1-answer-code >= 0 then do:
      271           if v-curr-db <> p1-db-init then do:
      272             assign
      273               v-db-for-send = string( p1-db-init )
      274             .
      275           end.
      276         end.
      277         else do:
      278           assign
      279             v-num-entries = num-entries( p1-send-db-list, chr(44) )
      280           .
      281           do v-ind = 1 to v-num-entries:
      282             assign
      283               v-db-num-char = entry( v-ind, p1-send-db-list, chr(44) )
      284               v-db-num      = integer( v-db-num-char )
      285             .
      286             if v-db-num <> v-curr-db
      287               and v-db-num <> p1-db-init
      288             then do:
      289               if v-db-for-send = "":U then do:
      290                 assign
      291                   v-db-for-send = v-db-num-char
      292                 .
      293               end.
      294               else do:
      295                 assign
      296                   v-db-for-send =  v-db-for-send + chr(1) + v-db-num-char
      297                 .
      298               end.
      299             end.
      300           end.
      301         end.
      302       end.
      303       else do:
      304         assign
      305           v-db-for-send = "0":U
      306         .
      307       end.
      308       if v-db-for-send <> "":U then do:
      309         assign
      310           v-command = "command":U + chr(1)
      311                       + "two-commit":U + chr(1)
      312                       + p1-action + chr(1)
      313                       + p1-operation + chr(1)
      314                       + p1-uniq-key-rec + chr(1)
      315                       + string( p1-db-init ) + chr(1)
      316                       + p1-parameters + chr(1)
      317                       + string( p1-answer-code ) + chr(1)
      318                       + p1-answer-msg
      319         .
      320         run nws/cr-route.p ( input 'send-cmd':U
      321                       ,input v-command
      322                       ,input ?
      323                       ,input v-db-for-send
      324                       ) no-error .
      325         if error-status :error then do:
      326           return error return-value.
      327         end.
      328       end.
      329     end.
      330     return.
      331   end procedure.
      332   procedure create_msg_route :
      333     define input parameter p2-send-db-list as character no-undo .
      334     define input parameter p2-msg          as character no-undo .
      335     do
      336     on error undo, return error
      337     :
      338       define variable v-msg-command as character no-undo .
      339       define variable v-ind         as integer   no-undo .
      340       define variable v-num-entries as integer   no-undo .
      341       define variable v-curr-db     as integer   no-undo .
      342       define variable v-db-for-send as character no-undo .
      343       define variable v-db-num      as integer   no-undo .
      344       define variable v-db-num-char as character no-undo .
      345       define buffer buf_sys-ctrl    for ub.sys-ctrl .
      346       find first buf_sys-ctrl no-lock .
      347       assign
      348         v-curr-db     = buf_sys-ctrl.db-num
      349         v-db-for-send = "":U
      350       .
      351       if v-curr-db = 0 then do:
      352         assign
      353           v-num-entries = num-entries( p2-send-db-list, chr(44) )
      354         .
      355         do v-ind = 1 to v-num-entries:
      356           assign
      357             v-db-num-char = entry( v-ind, p2-send-db-list, chr(44) )
      358             v-db-num      = integer( v-db-num-char )
      359           .
      360           if v-db-num <> v-curr-db then do:
      361             if v-db-for-send = "":U then do:
      362               assign
      363                 v-db-for-send = v-db-num-char
      364               .
      365             end.
      366             else do:
      367               assign
      368                 v-db-for-send =  v-db-for-send + chr(1) + v-db-num-char
      369               .
      370             end.
      371           end.
      372         end.
      373       end.
      374       else do:
      375         assign
      376           v-db-for-send = "0":U
      377         .
      378       end.
      379       if v-db-for-send <> "":U then do:
      380         assign
      381           v-msg-command = "command":U + chr(1)
      382                           + "message-to-log":U + chr(1)
      383                           + p2-msg
      384         .
      385         run nws/cr-route.p ( input 'send-cmd':U
      386                       ,input v-msg-command
      387                       ,input ?
      388                       ,input v-db-for-send
      389                       ) no-error .
      390         if error-status :error then do:
      391           return error substitute( "&1&2&3"
      392                                     , return-value
      393                                     , chr(10)
      394                                     , error-status :get-message(1)
      395                                   ).
      396         end.
      397       end.
      398     end.
      399     return.
      400   end procedure.
      401   function get-send-db-list returns character
      402     ( input p-curr-db     as integer
      403      ,input p-all-db-list as character
      404     )
      405   :
      406     define variable v-send-db-list as character no-undo .
      407     if p-curr-db = 0 then do:
      408       assign
      409         v-send-db-list = p-all-db-list
      410       .
      411     end.
      412     else do:
      413       assign
      414         v-send-db-list = string(p-curr-db)
      415       .
      416     end.
      417     return v-send-db-list .
      418   end function .
      419   do
      420   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      421   on stop   undo, return error substitute( "&1. stop", vss-workfile )
      422   on endkey undo, return error substitute( "&1. endkey", vss-workfile )
      423   :
      424     define variable v-action            as character no-undo .
      425     define variable v-uniq-key-rec      as character no-undo .
      426     define variable v-db-init           as integer   no-undo .
      427     define variable v-parameters        as character no-undo .
      428     define variable v-ext-prg-handle      as handle    no-undo .
      429     define variable v-main-prog-name      as character no-undo .
      430     define variable v-list-db-proc-name   as character no-undo .
      431     define variable v-commit-proc-name    as character no-undo .
      432     define variable v-execution-proc-name as character no-undo .
      433     define variable v-recover-proc-name   as character no-undo .
      434     define variable v-after-proc-name     as character no-undo .
      435     define variable v-err-msg as character no-undo .
      436     define variable v-ind          as integer   no-undo .
      437     define variable v-num-entries  as integer   no-undo .
      438     define variable v-send-db-list as character no-undo .
      439     define variable v-all-db-list  as character no-undo .
      440     define variable v-db-for-send  as character no-undo .
      441     define variable v-curr-db      as integer   no-undo .
      442     define variable v-db-num-char  as character no-undo .
      443     define buffer buf_sys-ctrl for ub.sys-ctrl .
      444     find first buf_sys-ctrl no-lock .
      445     assign
      446       v-curr-db      = buf_sys-ctrl.db-num
      447       v-action       = entry(3, p-command, chr(1))
      448       v-uniq-key-rec = entry(4, p-command, chr(1))
      449       v-db-init      = integer( entry(5, p-command, chr(1)) )
      450       v-parameters   = entry(6, p-command, chr(1))
      451     .
      452     run progs-name( input v-action
      453                    ,output v-main-prog-name
      454                    ,output v-list-db-proc-name
      455                    ,output v-commit-proc-name
      456                    ,output v-execution-proc-name
      457                    ,output v-recover-proc-name
      458                    ,output v-after-proc-name
      459                   ) no-error .
      460     if error-status :error then do:
      461       return error substitute( "&1. Ошибка при определении имен процедур. &2", vss-workfile, return-value ).
      462     end.
      463     if trim( v-after-proc-name ) = "":U then do:
      464       return .
      465     end.
      466     run value( v-list-db-proc-name )
      467       ( input v-action
      468        ,input v-uniq-key-rec
      469        ,output v-all-db-list
      470       ) no-error .
      471     if error-status :error then do:
      472       return error substitute( "&1. Ошибка при определении списка БД. &2", vss-workfile, return-value ).
      473     end.
      474     assign
      475       v-send-db-list = get-send-db-list( v-curr-db, v-all-db-list )
      476       v-db-for-send  = "":U
      477     .
      478     if v-curr-db = 0 then do:
      479       assign
      480         v-num-entries = num-entries( v-send-db-list, chr(44) )
      481       .
      482       do v-ind = 1 to v-num-entries
      483       :
      484         assign
      485           v-db-num-char = entry( v-ind, v-send-db-list, chr(44) )
      486         .
      487         if v-db-num-char = "0":U
      488             or ( p-db-source <> ?
      489                  and v-db-num-char = string( p-db-source )
      490                )
      491         then do:
      492           next.
      493         end.
      494         if v-db-for-send = "":U then do:
      495           assign
      496             v-db-for-send = v-db-num-char
      497           .
      498         end.
      499         else do:
      500           assign
      501             v-db-for-send =  v-db-for-send + chr(1) + v-db-num-char
      502           .
      503         end.
      504       end.
      505     end.
      506     else do:
      507       if v-curr-db = v-db-init
      508         and p-db-source = ?
      509       then do:
      510         assign
      511           v-db-for-send = "0":U
      512         .
      513       end.
      514     end.
      515     if v-db-for-send <> "":U then do:
      516       run nws/cr-route.p ( input 'send-cmd':U
      517                      ,input p-command
      518                      ,input ?
      519                      ,input v-db-for-send
      520                     ) no-error .
      521       if error-status :error then do:
      522         return error return-value.
      523       end.
      524     end.
      525     run value( v-main-prog-name ) persistent
      526         set v-ext-prg-handle .
      527     run value( v-after-proc-name ) in v-ext-prg-handle
      528       ( input v-action
      529        ,input v-uniq-key-rec
      530        ,input v-db-init
      531        ,input v-parameters
      532        ,output v-err-msg
      533       ) no-error .
      534     if error-status :error then do:
      535       return error substitute( "&1. Ошибка при выполнении команды после операции над записью &2.&3&4&5&6"
      536                                 , vss-workfile
      537                                 , v-uniq-key-rec
      538                                 , chr(10)
      539                                 , return-value
      540                                 , chr(10)
      541                                 , error-status :get-message(1)
      542                               ).
      543     end.
      544     if v-err-msg <> "":U then do:
      545       return v-err-msg.
      546     end.
      547     delete procedure v-ext-prg-handle .
      548   end.
