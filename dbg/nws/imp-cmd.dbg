      628   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      629   function octal-to-char return character
      630   ( p-string as character ) :
      631     def var v-asc     as integer no-undo .
      632     def var v-new-asc as integer no-undo .
      633     def var ind       as integer no-undo .
      634     if length(p-string) <> 3 then do:
      635       return ? .
      636     end.
      637     assign
      638       v-asc = 0
      639     .
      640     do ind = 1 to length(p-string)
      641     :
      642       assign
      643         v-new-asc = asc(substring(p-string, ind, 1)) - asc('0')
      644       .
      645       if v-new-asc < 0 or v-new-asc >= 8 then do:
      646         return ? .
      647       end.
      648       assign
      649         v-asc = v-asc * 8 + v-new-asc
      650       .
      651     end.
      652     return chr(v-asc) .
      653   end function .
      654   function char-to-octal return character
      655   ( p-chr as character ) :
      656     def var v-asc    as integer   no-undo .
      657     def var ind      as integer   no-undo .
      658     def var v-string as character no-undo .
      659     if length(p-chr) <> 1 then do:
      660       return ? .
      661     end.
      662     assign
      663       v-asc    = asc(p-chr)
      664       v-string = ""
      665     .
      666     do ind = 1 to 3
      667     :
      668       assign
      669         v-string = chr( v-asc mod 8 + asc('0')) + v-string
      670       .
      671       assign
      672         v-asc = truncate(v-asc / 8, 0)
      673       .
      674     end.
      675     return v-string .
      676   end.
      677   function str-encode return character
      678   (   p-init-string       as character
      679     , p-encode-char       as character
      680     , p-special-char-list as character
      681   ) :
      682     def var p-encode-string as character no-undo .
      683     def var ind                as integer no-undo .
      684     def var v-num-special-char as integer no-undo .
      685     def var v-special-char     as character no-undo .
      686     if p-encode-char = ?
      687     or p-encode-char = "" then do:
      688       assign
      689         p-encode-char = "~~"
      690       .
      691     end.
      692     if p-init-string = ? then do:
      693       return "?" .
      694     end.
      695     if p-init-string = "?" then do:
      696       return p-encode-char + char-to-octal("?") .
      697     end.
      698     assign
      699       v-num-special-char = length(p-special-char-list)
      700       p-encode-string    = replace(p-init-string
      701                                   ,p-encode-char
      702                                   ,p-encode-char + char-to-octal(p-encode-char)
      703                                   )
      704     .
      705     do ind = 1 to v-num-special-char
      706     :
      707       assign
      708         v-special-char = substring(p-special-char-list, ind, 1)
      709       .
      710       if v-special-char <> p-encode-char then do:
      711         assign
      712           p-encode-string = replace (p-encode-string
      713                                     ,v-special-char
      714                                     ,p-encode-char + char-to-octal(v-special-char)
      715                                     )
      716         .
      717       end.
      718     end.
      719     return p-encode-string .
      720   end.
      721   function str-decode returns character
      722     (p-init-string   as character
      723     ,p-encode-char   as character
      724     ) :
      725     def var p-decode-string as character no-undo .
      726     def var ind                       as integer no-undo .
      727     def var v-num-entries-init-string as integer no-undo .
      728     def var v-sub-phrase              as character no-undo .
      729     def var v-special-char            as character no-undo .
      730     if p-encode-char = ?
      731     or p-encode-char = "" then do:
      732       assign
      733         p-encode-char = "~~"
      734       .
      735     end.
      736     if p-init-string = "?" then do:
      737       return ? .
      738     end.
      739     assign
      740       v-num-entries-init-string = num-entries(p-init-string, p-encode-char)
      741     .
      742     if v-num-entries-init-string > 1 then do:
      743       assign
      744         p-decode-string = entry(1, p-init-string, p-encode-char)
      745       .
      746       do ind = 2 to v-num-entries-init-string
      747       :
      748         assign
      749           v-sub-phrase = entry(ind, p-init-string, p-encode-char)
      750         .
      751         assign
      752           v-special-char = octal-to-char(substring(v-sub-phrase, 1, 3))
      753         .
      754         if v-special-char <> ? then do:
      755           assign
      756             p-decode-string = p-decode-string
      757                             + v-special-char
      758                             + substring(v-sub-phrase, 4)
      759           .
      760         end.
      761         else do:
      762           assign
      763             p-decode-string = p-decode-string
      764                             + p-encode-char
      765                             + v-sub-phrase
      766           .
      767         end.
      768       end.
      769     end.
      770     else do:
      771       assign
      772         p-decode-string = p-init-string
      773       .
      774     end.
      775     return p-decode-string .
      776   end.
      777   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      778   procedure gen-b-code :
      779     define input  parameter type-code like ub.code-range.range-type no-undo .
      780     define output parameter p-b-code  like ub.bar-code.b-code       no-undo .
      781     do
      782     on error  undo, return error substitute( "&1 (gen-b-code). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      783     on stop   undo, return error substitute( "&1 (gen-b-code). stop", vss-workfile )
      784     on endkey undo, return error substitute( "&1 (gen-b-code). endkey", vss-workfile )
      785     :
      786       define buffer buf_thbj-attr     for ub.thbj-attr .
      787       define buffer buf_sys-ctrl   for ub.sys-ctrl .
      788       define buffer buf_code-range for ub.code-range .
      789       define variable l-code         as   integer              no-undo .
      790       define variable v-db-num       like ub.db.db-num         no-undo .
      791       define variable cfg-param-code like ub.thbj-attr.prop-code no-undo .
      792       if type-code = 'sslc':U
      793       or type-code = 'ssgb':U
      794       then do:
      795         message
      796           "Нельзя генерировать локальный или глобальный взвешиваемый код." skip
      797           "Обратитесь к администратору системы."
      798           view-as alert-box error .
      799         undo, return error (if type-code = 'sslc':U then "loc-ss-code":U else "gbl-ss-code" ) .
      800       end.
      801       run trg/getpcode.p ( input  type-code
      802                      ,output cfg-param-code
      803                     ).
      804       run get-next-seq( input  type-code,
      805                         output l-code
      806                       ).
      807       find first buf_sys-ctrl no-lock.
      808       if type-code = 'sclc':U
      809       or type-code = 'pglc':U
      810       then do:
      811         assign
      812           v-db-num = 0
      813         .
      814       end.
      815       else do:
      816         assign
      817           v-db-num = buf_sys-ctrl.db-num
      818         .
      819       end.
      820       find first buf_code-range no-lock
      821         where buf_code-range.db-num     = v-db-num
      822           and buf_code-range.range-type = type-code
      823           and buf_code-range.stts       = "a"
      824         use-index stts
      825         no-error .
      826       if available buf_code-range
      827          and l-code <= buf_code-range.last-code
      828          and l-code >= buf_code-range.first-code then do:
      829         assign
      830           p-b-code = l-code
      831         .
      832       end.
      833       else do:
      834         if available buf_code-range
      835            and l-code < buf_code-range.last-code then do:
      836           message
      837             substitute( "Последовательность для создания кодов с типом &1 имеет неверное значение.", type-code ) skip
      838             "Обратитесь к администратору системы."
      839             view-as alert-box error .
      840           undo, return error "sequence":U .
      841         end.
      842         do transaction
      843         on error undo, return error
      844         :
      845           find first buf_thbj-attr exclusive-lock
      846             where buf_thbj-attr.upper-prop-code = 'code-range':U
      847               and buf_thbj-attr.prop-code = cfg-param-code
      848               and buf_thbj-attr.obj-type   = 'БД':U
      849               and buf_thbj-attr.obj-code   = v-db-num
      850             no-error .
      851           if not available buf_thbj-attr then do:
      852             find first buf_thbj-attr exclusive-lock
      853               where buf_thbj-attr.upper-prop-code = 'code-range':U
      854                 and buf_thbj-attr.prop-code = cfg-param-code
      855                 and buf_thbj-attr.obj-type   = ''
      856                 and buf_thbj-attr.obj-code   = 0
      857               no-error .
      858             if not available buf_thbj-attr then do:
      859               if not locked buf_thbj-attr then do:
      860                 message
      861                   substitute( "Отсутствует параметр 'длина диапазона кодов' (&1) для БД &2.", cfg-param-code, buf_sys-ctrl.db-num ) skip
      862                   "Обратитесь к администратору системы."
      863                   view-as alert-box error .
      864               end.
      865               undo, return error "config":U .
      866             end.
      867           end.
      868           run get-next-seq( input type-code,
      869                             output l-code
      870                           ).
      871           find first buf_code-range
      872             where buf_code-range.db-num     = v-db-num
      873               and buf_code-range.range-type = type-code
      874               and buf_code-range.stts       = "a"
      875             use-index stts
      876             no-error .
      877           if available buf_code-range
      878           and l-code <= buf_code-range.last-code
      879           and l-code >= buf_code-range.first-code
      880           then do:
      881             assign
      882               p-b-code = l-code
      883             .
      884           end.
      885           else do:
      886             if available buf_code-range then do:
      887               assign
      888                 buf_code-range.stts = "u"
      889               .
      890             end.
      891             find first buf_code-range
      892               where buf_code-range.db-num     = v-db-num
      893                 and buf_code-range.range-type = type-code
      894                 and buf_code-range.stts       = "f"
      895               use-index stts
      896               no-error .
      897             if not available buf_code-range then do:
      898               message
      899                 substitute( "Отсутствует свободный диапазон для кодов с типом &1.", type-code ) skip
      900                 "Обратитесь к администратору системы"
      901                 view-as alert-box error .
      902               undo, return error "code-range":U .
      903             end.
      904             assign
      905               buf_code-range.stts           = "a"
      906             .
      907             if buf_code-range.first-code = 1 then do:
      908               run set-seq-cr( input type-code,
      909                               input buf_code-range.first-code
      910                             ).
      911               assign
      912                 p-b-code = 1
      913               .
      914             end.
      915             else do:
      916               run set-seq-cr( input type-code,
      917                               input ( buf_code-range.first-code - 1 )
      918                             ).
      919               run get-next-seq( input type-code,
      920                                 output p-b-code
      921                               ).
      922             end.
      923           end.
      924         end.
      925       end.
      926     end.
      927   end procedure.
      928   procedure get-next-seq :
      929     define input  parameter type-code like ub.code-range.range-type no-undo .
      930     define output parameter next-seq  as   integer                  no-undo .
      931     do
      932     on error  undo, return error substitute( "&1 (get-next-seq). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      933     on stop   undo, return error substitute( "&1 (get-next-seq). stop", vss-workfile )
      934     on endkey undo, return error substitute( "&1 (get-next-seq). endkey", vss-workfile )
      935     :
      936       case type-code:
      937         when 'bcgb':U then do:
      938           assign
      939             next-seq = next-value(s-bcgb-code, ub)
      940           .
      941         end.
      942         when 'scgb':U then do:
      943           assign
      944             next-seq = next-value(s-scgb-code, ub)
      945           .
      946         end.
      947         when 'sclc':U then do:
      948           assign
      949             next-seq = next-value(s-sclc-code, ub)
      950           .
      951         end.
      952         when 'pglc':U then do:
      953           assign
      954             next-seq = next-value(s-pglc-code, ub)
      955           .
      956         end.
      957         when 'dcgb':U then do:
      958           assign
      959             next-seq = next-value(s-dcgb-code, ub)
      960           .
      961         end.
      962         when 'ctgb':U then do:
      963           assign
      964             next-seq = next-value(s-ctgb-code, ub)
      965           .
      966         end.
      967         when 'drgb':U then do:
      968           assign
      969             next-seq = next-value(s-drgb-code, ub)
      970           .
      971         end.
      972         when 'fmgb':U then do:
      973           assign
      974             next-seq = next-value(s-fmgb-code, ub)
      975           .
      976         end.
      977         when 'pngb':U then do:
      978           assign
      979             next-seq = next-value(s-pngb-code, ub)
      980           .
      981         end.
      982         when 'cagb':U then do:
      983           assign
      984             next-seq = next-value(s-cagb-code, ub)
      985           .
      986         end.
      987         when 'fdgb':U then do:
      988           assign
      989             next-seq = next-value(s-fin-doc, ub)
      990           .
      991         end.
      992       end case.
      993     end.
      994   end procedure.
      995   procedure set-seq-cr :
      996     define input parameter type-code like ub.code-range.range-type no-undo .
      997     define input parameter set-val   like ub.code-range.first-code no-undo .
      998     do
      999     on error  undo, return error substitute( "&1 (set-seq-cr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1000     on stop   undo, return error substitute( "&1 (set-seq-cr). stop", vss-workfile )
     1001     on endkey undo, return error substitute( "&1 (set-seq-cr). endkey", vss-workfile )
     1002     :
     1003       case type-code:
     1004         when 'bcgb':U then do:
     1005           assign
     1006             current-value(s-bcgb-code, ub) = set-val
     1007           .
     1008         end.
     1009         when 'scgb':U then do:
     1010           assign
     1011             current-value(s-scgb-code, ub) = set-val
     1012           .
     1013         end.
     1014         when 'sclc':U then do:
     1015           assign
     1016             current-value(s-sclc-code, ub) = set-val
     1017           .
     1018         end.
     1019         when 'pglc':U then do:
     1020           assign
     1021             current-value(s-pglc-code, ub) = set-val
     1022           .
     1023         end.
     1024         when 'dcgb':U then do:
     1025           assign
     1026             current-value(s-dcgb-code, ub) = set-val
     1027           .
     1028         end.
     1029         when 'ctgb':U then do:
     1030           assign
     1031             current-value(s-ctgb-code, ub) = set-val
     1032           .
     1033         end.
     1034         when 'drgb':U then do:
     1035           assign
     1036             current-value(s-drgb-code, ub) = set-val
     1037           .
     1038         end.
     1039         when 'fmgb':U then do:
     1040           assign
     1041             current-value(s-fmgb-code, ub) = set-val
     1042           .
     1043         end.
     1044         when 'pngb':U then do:
     1045           assign
     1046             current-value(s-pngb-code, ub) = set-val
     1047           .
     1048         end.
     1049         when 'cagb':U then do:
     1050           assign
     1051             current-value(s-cagb-code, ub) = set-val
     1052           .
     1053         end.
     1054         when 'fdgb':U then do:
     1055           assign
     1056             current-value(s-fin-doc, ub) = set-val
     1057           .
     1058         end.
     1059       end case.
     1060     end.
     1061   end procedure.
     1062   procedure new-bcod-gen-code-range :
     1063     do
     1064     on error  undo, return error substitute( "&1 (new-bcod-gen-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1065     on stop   undo, return error substitute( "&1 (new-bcod-gen-code-range). stop", vss-workfile )
     1066     on endkey undo, return error substitute( "&1 (new-bcod-gen-code-range). endkey", vss-workfile )
     1067     :
     1068       define input parameter p-db-num  like ub.db.db-num             no-undo .
     1069       define input parameter type-code like ub.code-range.range-type no-undo .
     1070       define buffer buf_code-range      for ub.code-range .
     1071       define buffer last_code-range     for ub.code-range .
     1072       define buffer last-1_code-range   for ub.code-range .
     1073       define buffer last-2_code-range   for ub.code-range .
     1074       define buffer last-3_code-range   for ub.code-range .
     1075       define buffer buf_sys-ctrl        for ub.sys-ctrl .
     1076       define variable conf-par       as character no-undo .
     1077       define variable par-type       as character no-undo .
     1078       define variable cfg-param-code like ub.thbj-attr.prop-code no-undo .
     1079       define variable v-cre-cdrg as logical   no-undo .
     1080       define variable v-cre-str  as character no-undo .
     1081       define variable v-cr1      as integer no-undo .
     1082       define variable v-cr2      as integer no-undo .
     1083       define variable v-cr3      as integer no-undo .
     1084       define variable v-cmax     as integer no-undo .
     1085       find first buf_sys-ctrl no-lock .
     1086       if buf_sys-ctrl.db-num <> 0 and type-code <> 'cagb':U then do:
     1087         undo, return error substitute("&1 &2 &3&4Диапазоны кодов можно создавать только в ГБД&4База данных &5"
     1088                                       ,vss-workfile
     1089                                       ,vss-revision
     1090                                       ,vss-description
     1091                                       ,chr(10)
     1092                                       , p-db-num
     1093                                      ).
     1094       end.
     1095       run trg/getpcode.p ( input  type-code
     1096                      ,output cfg-param-code
     1097                     ).
     1098       for each buf_code-range
     1099         where buf_code-range.db-num     = -1
     1100           and buf_code-range.range-type = type-code
     1101           and buf_code-range.stts       = "f"
     1102       by buf_code-range.first-code
     1103       on error  undo, return error substitute( "&1 (new-bcod-gen-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1104       on stop   undo, return error substitute( "&1 (new-bcod-gen-code-range). stop", vss-workfile )
     1105       on endkey undo, return error substitute( "&1 (new-bcod-gen-code-range). endkey", vss-workfile )
     1106       :
     1107         assign
     1108           buf_code-range.db-num = p-db-num
     1109         .
     1110         return .
     1111       end.
     1112       assign
     1113         v-cre-cdrg = TRUE
     1114       .
     1115       case type-code:
     1116         when 'sclc':U
     1117         or when 'scgb':U
     1118         or when 'pglc':U
     1119         then do:
     1120           find last last-1_code-range no-lock
     1121             where last-1_code-range.range-type = 'sclc':U
     1122             no-error .
     1123           if available last-1_code-range then do:
     1124             v-cr1 = last-1_code-range.last-code.
     1125           end.
     1126           find last last-2_code-range no-lock
     1127             where last-2_code-range.range-type = 'scgb':U
     1128             no-error .
     1129           if available last-2_code-range then do:
     1130             v-cr2 = last-2_code-range.last-code.
     1131             end.
     1132           find last last-3_code-range no-lock
     1133             where last-3_code-range.range-type = 'pglc':U
     1134             no-error .
     1135           if available last-3_code-range then do:
     1136             v-cr3 = last-3_code-range.last-code.
     1137           end.
     1138           v-cmax = maximum(v-cr1, v-cr2, v-cr3)
     1139           .
     1140           if v-cmax = v-cr1  then do:
     1141               find last last_code-range no-lock
     1142                 where recid( last_code-range ) = recid( last-1_code-range )
     1143                 .
     1144             end.
     1145           if v-cmax = v-cr2  then do:
     1146               find last last_code-range no-lock
     1147                 where recid( last_code-range ) = recid( last-2_code-range )
     1148                 .
     1149             end.
     1150           if v-cmax = v-cr3  then do:
     1151             find last last_code-range no-lock
     1152               where recid( last_code-range ) = recid( last-3_code-range )
     1153               .
     1154           end.
     1155           if last_code-range.last-code + 1 > 99999 then do:
     1156             assign
     1157               v-cre-cdrg = FALSE
     1158             .
     1159           end.
     1160         end.
     1161         when 'bcgb':U
     1162         or when 'sslc':U
     1163         or when 'ssgb':U
     1164         then do:
     1165           find last last-1_code-range no-lock
     1166             where last-1_code-range.range-type = 'sslc':U
     1167             no-error .
     1168           if available last-1_code-range then do:
     1169             v-cr1 = last-1_code-range.last-code.
     1170           end.
     1171           find last last-2_code-range no-lock
     1172             where last-2_code-range.range-type = 'bcgb':U
     1173             no-error .
     1174           if available last-2_code-range then do:
     1175             v-cr2 = last-2_code-range.last-code.
     1176             end.
     1177           find last last-3_code-range no-lock
     1178             where last-3_code-range.range-type = 'ssgb':U
     1179             no-error .
     1180           if available last-3_code-range then do:
     1181             v-cr3 = last-3_code-range.last-code.
     1182           end.
     1183           v-cmax = maximum(v-cr1, v-cr2, v-cr3)
     1184           .
     1185           if v-cmax = v-cr1  then do:
     1186               find last last_code-range no-lock
     1187                 where recid( last_code-range ) = recid( last-1_code-range )
     1188                 .
     1189             end.
     1190           if v-cmax = v-cr2  then do:
     1191               find last last_code-range no-lock
     1192                 where recid( last_code-range ) = recid( last-2_code-range )
     1193                 .
     1194             end.
     1195           if v-cmax = v-cr3  then do:
     1196             find last last_code-range no-lock
     1197               where recid( last_code-range ) = recid( last-3_code-range )
     1198               .
     1199           end.
     1200         end.
     1201         otherwise do:
     1202           find last last_code-range no-lock
     1203             where last_code-range.range-type = type-code
     1204             no-error .
     1205         end.
     1206       end case.
     1207       if not available last_code-range then do:
     1208         undo, return error substitute("&1 &2 &3&4В БД нет ни одного диапазона с типом &5&4Не была проведена инициализация диапазонов!"
     1209                                       ,vss-workfile
     1210                                       ,vss-revision
     1211                                       ,vss-description
     1212                                       , chr(10)
     1213                                       , type-code
     1214                                      ) .
     1215       end.
     1216       define variable v-mes13 as character no-undo .
     1217       define variable v-param-type13 as character no-undo .
     1218       define variable v-value-character13 as INTEGER no-undo .
     1219       define variable v-value-date13 as date no-undo .
     1220       define variable v-value-decimal13 as decimal no-undo .
     1221       define variable v-value-integer13 AS integer no-undo .
     1222       define variable v-value-logical13 AS LOGICAL no-undo .
     1223       define variable v-tth13 as handle no-undo .
     1224       run adm/shattri.p (
     1225           input "get":U
     1226           ,input  'БД':U
     1227           ,input  p-db-num
     1228           ,input  'code-range':U
     1229           ,input  cfg-param-code
     1230           ,output v-value-character13
     1231           ,output v-value-date13
     1232           ,output v-value-decimal13
     1233           ,output v-value-integer13
     1234           ,output v-value-logical13
     1235           ,output v-param-type13
     1236           ,INPUT-OUTPUT table-handle v-tth13
     1237           ) no-error .
     1238       if error-status :error then do:
     1239         delete object v-tth13.
     1240         v-mes13 = substitute("Ошибка при получении размера диапазона собственных глобальных кодов&2&1&2&3"
     1241                            , error-status:get-message(1)
     1242                            , chr(10)
     1243                            , return-value ).
     1244         undo, return error v-mes13.
     1245       end.
     1246       delete object v-tth13.
     1247       if v-cre-cdrg = TRUE then do:
     1248         create buf_code-range .
     1249         assign
     1250           buf_code-range.db-num     = p-db-num
     1251           buf_code-range.range-type = type-code
     1252           buf_code-range.stts       = "f"
     1253           buf_code-range.first-code = last_code-range.last-code + 1
     1254           buf_code-range.last-code  = last_code-range.last-code + integer(v-value-integer13)
     1255           v-cre-str = "Свободный диапазон успешно создан"
     1256         .
     1257       end.
     1258       else do:
     1259         assign
     1260           v-cre-str = "Нет возможности создать свободный диапазон." + chr(10)
     1261                       + substitute( "Превышен предел диапазонов c типом &1", type-code )
     1262         .
     1263       end.
     1264     end.
     1265     return v-cre-str .
     1266   end procedure.
     1267   procedure gen-new-code-range-if-neces :
     1268     define input parameter v-db-num           like ub.db.db-num             no-undo .
     1269     define input parameter v-range-type       like ub.code-range.range-type no-undo .
     1270     define input parameter v-cur-code         as   integer                  no-undo .
     1271     define input parameter v-g#news           as   logical                  no-undo .
     1272     define input parameter v-g#db-num         like ub.db.db-num             no-undo .
     1273     define input parameter v-g#news-source-db like ub.db.db-num             no-undo .
     1274     do
     1275     on error  undo, return error substitute( "&1 (gen-new-code-range-if-neces). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1276     on stop   undo, return error substitute( "&1 (gen-new-code-range-if-neces). stop", vss-workfile )
     1277     on endkey undo, return error substitute( "&1 (gen-new-code-range-if-neces). endkey", vss-workfile )
     1278     :
     1279       define variable l-code-range-exist as logical   no-undo init false .
     1280       define variable v-db-for-send      as character no-undo .
     1281       define buffer buf_code-range  for ub.code-range .
     1282       define buffer buf1_code-range for ub.code-range .
     1283       define buffer buf_db          for ub.db .
     1284       find first buf_code-range
     1285         where buf_code-range.range-type = v-range-type
     1286           and buf_code-range.last-code >= v-cur-code
     1287         use-index last-codei
     1288         no-error .
     1289       if
     1290       (
     1291          available buf_code-range
     1292          and
     1293         (buf_code-range.db-num = v-db-num
     1294           and
     1295         buf_code-range.first-code <= v-cur-code
     1296         )
     1297       or
     1298         (
     1299           v-range-type = 'drgb':U
     1300           AND
     1301           v-cur-code = 0
     1302         )
     1303      )
     1304      then do:
     1305         assign
     1306           l-code-range-exist = true
     1307         .
     1308         if v-g#news
     1309         and buf_code-range.stts = "f" then do:
     1310           assign
     1311             buf_code-range.stts = "u"
     1312           .
     1313         end.
     1314       end.
     1315       if not l-code-range-exist
     1316          and v-g#news-source-db <> 0
     1317       then do:
     1318         undo, return error substitute("&1 &2 &3&4Отсутствует диапазон кодов для БД &5 Тип диапазона кодов &6 Код &7"
     1319                                       ,vss-workfile
     1320                                       ,vss-revision
     1321                                       ,vss-description
     1322                                       ,chr(10)
     1323                                       ,v-db-num
     1324                                       ,v-range-type
     1325                                       ,v-cur-code
     1326                                      ).
     1327       end.
     1328       if (not l-code-range-exist
     1329           or ( v-cur-code >= int( (buf_code-range.first-code + buf_code-range.last-code) / 2 ) )
     1330          )
     1331       and ( not can-find (first buf1_code-range no-lock
     1332                           where buf1_code-range.db-num = v-db-num
     1333                             and buf1_code-range.range-type = v-range-type
     1334                             and buf1_code-range.stts = "f"
     1335                          )
     1336           )
     1337       then do:
     1338         if v-g#db-num = 0 then do:
     1339           run new-bcod-gen-code-range in this-procedure
     1340             (input v-db-num,
     1341              input v-range-type
     1342             ) no-error .
     1343           if error-status :error then do:
     1344             undo, return error substitute("Ошибка при создании нового свободного диапазона &1 Тип диапазона кодов &2 Код &3:&4&5 &6"
     1345                                           , substitute("&1 &2 &3", vss-workfile, vss-revision, vss-description)
     1346                                           ,v-db-num
     1347                                           ,v-range-type
     1348                                           ,v-cur-code
     1349                                           ,chr(10)
     1350                                           ,error-status:get-message(1)
     1351                                           ,return-value
     1352                                          ).
     1353           end.
     1354         end.
     1355         else do:
     1356           if v-range-type = 'sclc':U
     1357           or v-range-type = 'pglc':U
     1358           then do:
     1359             assign
     1360               v-db-for-send = "":U
     1361             .
     1362             if v-g#db-num = 0 then do:
     1363               for each buf_db no-lock
     1364                 where buf_db.db-num > 0
     1365                   and buf_db.db-num <> v-g#news-source-db
     1366               on error  undo, return error substitute( "&1 (gen-new-code-range-if-neces). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1367               :
     1368                 assign
     1369                   v-db-for-send = v-db-for-send + chr(1) + string( buf_db.db-num )
     1370                 .
     1371               end.
     1372               assign
     1373                 v-db-for-send = right-trim( v-db-for-send, chr(1) )
     1374               .
     1375             end.
     1376             else do:
     1377               if not v-g#news then do:
     1378                 assign
     1379                   v-db-for-send = "0":U
     1380                 .
     1381               end.
     1382             end.
     1383             run nws/cr-route.p ( input 'send-cmd':U
     1384                           ,input ("command":U + chr(1) + "create":U + chr(1) +
     1385                                  "code-range":U + chr(1) +
     1386                                  (if v-range-type = 'sclc':U
     1387                                   then string( current-value(s-sclc-code, ub))
     1388                                   else string( current-value(s-pglc-code, ub))
     1389                                   ) + chr(1) +
     1390                                   v-range-type)
     1391                           ,input ?
     1392                           ,input v-db-for-send
     1393                           ) no-error .
     1394             if error-status :error then do:
     1395               undo, return error return-value.
     1396             end.
     1397           end.
     1398         end.
     1399       end.
     1400     end.
     1401   end procedure.
     1402   procedure cre-loc-sc-code-range :
     1403     define input parameter v-cur-code as integer no-undo .
     1404   define input parameter p-cdrg-type as character no-undo .
     1405     do
     1406     on error  undo, return error substitute( "&1 (cre-loc-sc-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1407     on stop   undo, return error substitute( "&1 (cre-loc-sc-code-range). stop", vss-workfile )
     1408     on endkey undo, return error substitute( "&1 (cre-loc-sc-code-range). endkey", vss-workfile )
     1409     :
     1410       define buffer buf_code-range for ub.code-range .
     1411       find first buf_code-range
     1412            where buf_code-range.range-type = p-cdrg-type
     1413              and buf_code-range.first-code >= v-cur-code
     1414            no-error .
     1415       if not available buf_code-range then do:
     1416         run new-bcod-gen-code-range in this-procedure
     1417           ( input 0,
     1418             input p-cdrg-type
     1419           ) no-error .
     1420         if error-status :error then do:
     1421           undo, return error substitute( "Ошибка при создании нового свободного диапазона локальных весовых или штучных кодов&1"
     1422                                          + "Код &2&1&3 &4"
     1423                                         , chr(10)
     1424                                         , v-cur-code
     1425                                         , error-status:get-message(1)
     1426                                         , return-value
     1427                                        ) .
     1428         end.
     1429       end.
     1430     end.
     1431   end procedure.
     1432   procedure mark-used-if-need :
     1433   define input parameter p-cur-code as integer no-undo .
     1434   define input parameter p-range-type like ub.code-range.range-type no-undo .
     1435   define input parameter p-db-num like ub.code-range.db-num no-undo .
     1436     do
     1437     on error  undo, return error substitute( "&1 (mark-used-if-need). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1438     on stop   undo, return error substitute( "&1 (mark-used-if-need). stop", vss-workfile )
     1439     on endkey undo, return error substitute( "&1 (mark-used-if-need). endkey", vss-workfile )
     1440     :
     1441       DEFINE VARIABLE v-db-num like ub.code-range.db-num no-undo .
     1442       define buffer buf_code-range for ub.code-range .
     1443       assign
     1444       v-db-num = if p-range-type = 'sclc':U
     1445                  then 0
     1446                  else p-db-num
     1447       .
     1448   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1449   define buffer locK-batchprocess14 for ub.batchprocess.
     1450   run gbl/lock-prc.p
     1451       (input 'lscc':U
     1452       ,input 0
     1453       ,input 0
     1454       ,input 0
     1455       ,input ""
     1456       ,input ""
     1457       ,input ""
     1458       ,input (
     1459               ",,,Вкл/выкл лок. вес. кодов"
     1460              )
     1461       ,input true
     1462       ,buffer lock-batchprocess14
     1463       ) no-error .
     1464     if error-status :error then do:
     1465       message
     1466         vss-workfile vss-revision vss-description skip
     1467         "В данный момент идет процесс вкл/выкл лок. вес. кодов" skip
     1468         view-as alert-box error .
     1469       undo, return error .
     1470     end.
     1471       find first buf_code-range
     1472            where buf_code-range.range-type = p-range-type
     1473              and buf_code-range.first-code >= p-cur-code
     1474              and buf_code-range.last-code <= p-cur-code
     1475              and buf_code-range.db-num = v-db-num
     1476            no-error .
     1477       if not available buf_code-range then do:
     1478         message
     1479           vss-workfile vss-revision vss-description skip
     1480           "Ошибка при создании поиске диапазона" skip
     1481           "База данных" p-db-num skip
     1482           "Код" p-cur-code skip
     1483           "Тип" p-range-type
     1484           error-status :get-message(1) skip
     1485           return-value skip
     1486           view-as alert-box error .
     1487         undo, return error .
     1488       end.
     1489       if buf_code-range.stts = "f":U then do:
     1490         assign
     1491         buf_code-range.stts = "u":U
     1492         .
     1493       end.
     1494     end.
     1495   end procedure.
     1496   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1497   define new global shared variable g#attr-lib  as handle no-undo .
     1498   define variable v-attr-lib-variable as handle no-undo .
     1499   procedure gdsoattr-name :
     1500     define input  parameter p-code           as character no-undo .
     1501     define output parameter p-type           as character no-undo .
     1502     define output parameter p-format         as character no-undo .
     1503     define output parameter p-label          as character no-undo .
     1504     define output parameter p-user-can-edit  as logical   no-undo .
     1505     define output parameter p-output-display as logical   no-undo .
     1506     define output parameter p-other          as character no-undo .
     1507     do
     1508     on error undo, return error
     1509     :
     1510           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsoattr-name in g#attr-lib
     1511         (input  p-code
     1512         ,output p-type
     1513         ,output p-format
     1514         ,output p-label
     1515         ,output p-user-can-edit
     1516         ,output p-output-display
     1517         ,output p-other
     1518         ) no-error .
     1519       if error-status :error
     1520       then do:
     1521         undo, return error return-value .
     1522       end.
     1523     end.
     1524   end.
     1525   procedure gdsoattr-tooltip :
     1526     define input  parameter p-code    as character no-undo .
     1527     define output parameter p-tooltip as character no-undo .
     1528     define output parameter p-label   as character no-undo .
     1529     do
     1530     on error undo, return error
     1531     :
     1532           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsoattr-tooltip in g#attr-lib
     1533         (input  p-code
     1534         ,output p-tooltip
     1535         ,output p-label
     1536         ) no-error .
     1537       if error-status :error
     1538       then do:
     1539         undo, return error return-value .
     1540       end.
     1541     end.
     1542   end.
     1543   procedure gdsoattr-value :
     1544     define input  parameter p-code     like ub.gds-obj-attr.attr-code  no-undo .
     1545     define input  parameter p-gds-code like ub.gds-obj-attr.gds-code   no-undo .
     1546     define input  parameter p-obj-type like ub.gds-obj-attr.obj-type   no-undo .
     1547     define input  parameter p-obj-code like ub.gds-obj-attr.obj-code   no-undo .
     1548     define output parameter p-value    like ub.gds-obj-attr.attr-value no-undo .
     1549     define output parameter p-type     as character no-undo .
     1550     do
     1551     on error undo, return error
     1552     :
     1553           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsoattr-value in g#attr-lib
     1554         (input  p-code
     1555         ,input  p-gds-code
     1556         ,input  p-obj-type
     1557         ,input  p-obj-code
     1558         ,output p-value
     1559         ,output p-type
     1560         ) no-error .
     1561       if error-status :error
     1562       then do:
     1563         undo, return error return-value .
     1564       end.
     1565     end.
     1566   end.
     1567   procedure gdsoattr-gds-code :
     1568     define input  parameter p-code     like ub.gds-obj-attr.attr-code  no-undo .
     1569     define input  parameter p-value    like ub.gds-obj-attr.attr-value no-undo .
     1570     define input  parameter p-obj-type like ub.gds-obj-attr.obj-type   no-undo .
     1571     define input  parameter p-obj-code like ub.gds-obj-attr.obj-code   no-undo .
     1572     define output parameter p-gds-code like ub.gds-obj-attr.gds-code   no-undo .
     1573     do
     1574     on error undo, return error
     1575     :
     1576           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsoattr-gds-code in g#attr-lib
     1577         (input  p-code
     1578         ,input  p-value
     1579         ,input  p-obj-type
     1580         ,input  p-obj-code
     1581         ,output p-gds-code
     1582         ) no-error .
     1583       if error-status :error
     1584       then do:
     1585         undo, return error return-value .
     1586       end.
     1587     end.
