     1835   def var vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1836   procedure gen-key-rec :
     1837     define input  parameter p-tbl-name    as character no-undo.
     1838     define input  parameter p-bh_tbl-name as handle    no-undo.
     1839     define output parameter p-key-rec     as character no-undo.
     1840     do
     1841     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1842     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
     1843     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
     1844     :
     1845       define variable fh               as handle    no-undo .
     1846       define variable v-ok             as logical   no-undo .
     1847       define variable v-inform         as character no-undo .
     1848       define variable v-ind            as integer   no-undo .
     1849       define variable v-idx-field-qnty as integer   no-undo .
     1850       if p-tbl-name = ?
     1851         or p-tbl-name = "":U
     1852       then do:
     1853         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info16 ).
     1854       end.
     1855       if not p-bh_tbl-name:available then do:
     1856         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info16, p-tbl-name ).
     1857       end.
     1858       assign
     1859         p-key-rec = p-tbl-name
     1860         v-inform  = p-bh_tbl-name:index-information(1)
     1861         v-ind     = 2
     1862       .
     1863       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1864       on error undo, return error
     1865       :
     1866         assign
     1867           v-inform = p-bh_tbl-name:index-information( v-ind )
     1868           v-ind    = v-ind + 1
     1869         .
     1870       end.
     1871       if v-inform = ?
     1872         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1873         or entry( 3, v-inform, ",":U ) <> "1":U
     1874       then do:
     1875         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info16, p-tbl-name ).
     1876       end.
     1877       else do:
     1878         assign
     1879           v-idx-field-qnty = num-entries( v-inform ) - 4
     1880         .
     1881         if v-idx-field-qnty < 2 then do:
     1882           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info16, v-inform, p-tbl-name ).
     1883         end.
     1884         do v-ind = 1 to v-idx-field-qnty by 2
     1885         on error undo, return error
     1886         :
     1887           assign
     1888             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
     1889             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
     1890           .
     1891         end.
     1892       end.
     1893       if p-key-rec = ? then do:
     1894         assign
     1895           p-key-rec = "":U
     1896         .
     1897         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info16, p-tbl-name ).
     1898       end.
     1899     end.
     1900     return.
     1901   end procedure.
     1902   procedure gen-where-keyr-tab :
     1903     define input  parameter i-tableSerach as character no-undo.
     1904     define input  parameter i-tablekey   as character  no-undo.
     1905     define input  parameter p-key-rec    as character  no-undo.
     1906     define input  parameter p-key-handle as handle     no-undo .
     1907     define input  parameter p-db-name    as character  no-undo .
     1908     define input  parameter p-tt-handle  as handle     no-undo .
     1909     define output parameter o-Where      as character  no-undo.
     1910     do
     1911     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1912     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1913     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
     1914     :
     1915       define variable v-full-tbl-name  as character no-undo .
     1916       define variable bh_tbl-name      as handle    no-undo .
     1917       define variable fh_key           as handle    no-undo .
     1918       define variable fh_search        as handle    no-undo .
     1919       define variable v-field-num      as integer   no-undo .
     1920       define variable v-count-fld      as integer   no-undo .
     1921       define variable v-inform         as character no-undo .
     1922       define variable v-ind            as integer   no-undo .
     1923       define variable v-idx-field-qnty as integer   no-undo .
     1924       define variable v-field-name     as character no-undo .
     1925       define variable v-field-val      as character no-undo .
     1926       define variable v-word-link      as character no-undo .
     1927       define variable vTable           as character no-undo.
     1928       define variable bh_tbl-key       as handle    no-undo .
     1929       assign
     1930         p-key-rec = trim( p-key-rec )
     1931       .
     1932       if p-key-handle <> ? then do:
     1933         if not valid-handle(p-key-handle)
     1934            or p-key-handle:type <> "buffer"
     1935         then do:
     1936           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info16 ).
     1937         end.
     1938         if num-entries( p-key-rec, chr(3) ) > 1
     1939           or p-key-rec = ?
     1940           or p-key-rec = "":U
     1941         then do:
     1942           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info16, p-key-rec ).
     1943         end.
     1944       end.
     1945       else do:
     1946         if p-key-rec = ?
     1947           or p-key-rec = "":U
     1948         then do:
     1949           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info16 ).
     1950         end.
     1951       end.
     1952       assign
     1953         vTable = entry( 1 , p-key-rec, chr(3) )
     1954       .
     1955       if p-tt-handle <> ?
     1956         and ( not valid-handle(p-tt-handle)
     1957               or p-tt-handle:type <> "buffer"
     1958             )
     1959       then do:
     1960         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info16, vTable, chr(10) ).
     1961       end.
     1962       if p-tt-handle = ? then do:
     1963         assign
     1964           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
     1965         .
     1966         create buffer bh_tbl-name for table v-full-tbl-name .
     1967       end.
     1968       else do:
     1969         create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1970       end.
     1971       assign
     1972         v-inform = bh_tbl-name:index-information(1)
     1973         v-ind    = 2
     1974       .
     1975       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1976       on error undo, return error
     1977       :
     1978         assign
     1979           v-inform = bh_tbl-name:index-information( v-ind )
     1980           v-ind    = v-ind + 1
     1981         .
     1982       end.
     1983       if v-inform = ?
     1984         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1985         or entry( 3, v-inform, ",":U ) <> "1":U
     1986       then do:
     1987         delete object bh_tbl-name no-error.
     1988         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info16, vTable ).
     1989       end.
     1990       assign
     1991         v-idx-field-qnty = num-entries( v-inform ) - 4
     1992       .
     1993       if v-idx-field-qnty < 2 then do:
     1994         delete object bh_tbl-name no-error.
     1995         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info16, v-inform, vTable ).
     1996       end.
     1997       assign
     1998         o-where     = "where":U
     1999         v-word-link = "":U
     2000         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
     2001         v-count-fld = 0
     2002       .
     2003       if i-tablekey ne "" and i-tablekey ne ?
     2004       then do:
     2005         assign
     2006           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
     2007         .
     2008         create buffer bh_tbl-key for table v-full-tbl-name .
     2009       end.
     2010       if i-tableSerach ne "" and i-tableSerach ne ?
     2011       then do:
     2012         delete object bh_tbl-name no-error.
     2013         assign
     2014           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
     2015         .
     2016         create buffer bh_tbl-name for table v-full-tbl-name .
     2017       end.
     2018       block_where:
     2019       do v-ind = 1 to v-idx-field-qnty by 2
     2020       on error undo, return error
     2021       :
     2022         assign
     2023           v-count-fld = v-count-fld + 1
     2024         .
     2025         if p-key-handle = ?
     2026           and v-count-fld > v-field-num
     2027         then do:
     2028           leave block_where.
     2029         end.
     2030         define variable VfieldKeyTable as handle no-undo.
     2031         assign
     2032           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     2033           fh_search    = bh_tbl-name:buffer-field( v-field-name )
     2034         .
     2035         if     bh_tbl-key ne ?
     2036         then do:
     2037            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
     2038            if VfieldKeyTable eq ?
     2039            then next block_where.
     2040         end.
     2041         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
     2042         then
     2043            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
     2044         else
     2045            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
     2046         if p-key-handle = ? then do:
     2047           assign
     2048             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
     2049           .
     2050         end.
     2051         else do:
     2052           assign
     2053             fh_key = p-key-handle:buffer-field( v-field-name )
     2054           .
     2055           if fh_key = ?
     2056             or not valid-handle( fh_key )
     2057           then do:
     2058             delete object bh_tbl-name.
     2059             if     bh_tbl-key ne ?
     2060             then
     2061                delete object bh_tbl-key.
     2062             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info16, p-key-handle:name, v-field-name ).
     2063           end.
     2064           assign
     2065             v-field-val = fh_key:buffer-value
     2066           .
     2067         end.
     2068         if fh_search:data-type ="character":U then do:
     2069           assign
     2070             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
     2071             v-field-val = replace( v-field-val, '"':U, '~~"':U )
     2072             v-field-val = replace( v-field-val, "'":U, "~~'":U )
     2073             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
     2074             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
     2075             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
     2076             v-field-val = replace( v-field-val, chr(10), '~~n':U )
     2077             v-field-val = replace( v-field-val, chr(9), '~~t':U )
     2078             v-field-val = replace( v-field-val, chr(13), '~~r':U )
     2079             v-field-val = replace( v-field-val, chr(27), '~~E':U )
     2080             v-field-val = replace( v-field-val, chr(8), '~~b':U )
     2081             v-field-val = replace( v-field-val, chr(12), '~~f':U )
     2082             v-field-val = substitute( '"&1"', v-field-val )
     2083           .
     2084         end.
     2085         assign
     2086           o-where = substitute( "&1 &2", o-where, v-field-val )
     2087         .
     2088         if v-word-link = "":U then do:
     2089           assign
     2090             v-word-link = "and":U
     2091           .
     2092         end.
     2093       end.
     2094       delete object bh_tbl-name.
     2095       if     bh_tbl-key ne ?
     2096       then
     2097          delete object bh_tbl-key.
     2098       if p-key-handle = ?
     2099         and v-count-fld <> v-field-num
     2100       then do:
     2101         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info16, vTable ).
     2102       end.
     2103     end.
     2104   end procedure.
     2105   procedure gen-hn-keyr-tab :
     2106     define input  parameter i-tableSerach as character no-undo.
     2107     define input  parameter i-tablekey   as character no-undo.
     2108     define input  parameter p-key-rec    as character no-undo.
     2109     define input  parameter p-key-handle as handle    no-undo .
     2110     define input  parameter p-db-name    as character no-undo .
     2111     define input  parameter p-tt-handle  as handle    no-undo .
     2112     define input  parameter p-stts-lock  as integer   no-undo .
     2113     define output parameter o-hn         as handle    no-undo.
     2114     define variable v-full-tbl-name as character no-undo.
     2115     define variable v-where         as character no-undo.
     2116     define variable bh_tbl-name     as handle    no-undo.
     2117     define variable vTable          as character no-undo.
     2118     do
     2119     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2120     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     2121     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
     2122         run gen-where-keyr-tab(i-tableSerach,
     2123                                i-tablekey,
     2124                                p-key-rec,
     2125                                p-key-handle,
     2126                                p-db-name,
     2127                                p-tt-handle,
     2128                                output v-where).
     2129         if i-tableSerach ne "" and i-tableSerach ne ?
     2130         then do:
     2131            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
     2132            create buffer bh_tbl-name for table v-full-tbl-name .
     2133         end.
     2134         else do:
     2135            if p-tt-handle = ? then do:
     2136               assign
     2137                  vTable = entry( 1 , p-key-rec, chr(3) )
     2138               .
     2139               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
     2140               create buffer bh_tbl-name for table v-full-tbl-name .
     2141            end.
     2142            else do:
     2143               create buffer bh_tbl-name for table p-tt-handle:table-handle .
     2144            end.
     2145         end.
     2146         if p-tt-handle = ? then do:
     2147            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
     2148         end.
     2149         else do:
     2150            bh_tbl-name:find-first( v-where ) no-error .
     2151         end.
     2152         o-hn = bh_tbl-name.
     2153      end.
     2154   end procedure.
     2155   procedure gen-hn-keyr :
     2156     define input  parameter p-key-rec    as character no-undo.
     2157     define input  parameter p-key-handle as handle    no-undo .
     2158     define input  parameter p-db-name    as character no-undo .
     2159     define input  parameter p-tt-handle  as handle    no-undo .
     2160     define input  parameter p-stts-lock  as integer   no-undo .
     2161     define output parameter o-hn         as handle    no-undo.
     2162     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
     2163   end.
     2164   procedure gen-row-keyr :
     2165     define input  parameter p-key-rec    as character no-undo.
     2166     define input  parameter p-key-handle as handle    no-undo .
     2167     define input  parameter p-db-name    as character no-undo .
     2168     define input  parameter p-tt-handle  as handle    no-undo .
     2169     define input  parameter p-stts-lock  as integer   no-undo .
     2170     define output parameter p-tbl-row    as rowid     no-undo.
     2171     define output parameter p-tbl-name   as character no-undo.
     2172     define variable vHn as handle no-undo.
     2173       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
     2174       p-tbl-row = if vHn:available then vHn:rowid else ?.
     2175       p-tbl-name =  vHn:table.
     2176       delete object vHn no-error.
     2177     if p-tbl-row = ? then do:
     2178       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info16, p-tbl-name, p-key-rec ).
     2179     end.
     2180     else do:
     2181       return.
     2182     end.
     2183   end procedure.
     2184   procedure gen-key-fv :
     2185     define input  parameter p-key-rec    as character no-undo .
     2186     define output parameter p-field-list as character no-undo .
     2187     define output parameter p-value-list as character no-undo.
     2188     do
     2189     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2190     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     2191     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     2192     :
     2193       define variable v-full-tbl-name  as character no-undo .
     2194       define variable bh_tbl-name      as handle    no-undo .
     2195       define variable v-tbl-name       as character no-undo .
     2196       define variable v-field-num      as integer   no-undo .
     2197       define variable v-count-fld      as integer   no-undo .
     2198       define variable v-inform         as character no-undo .
     2199       define variable v-ind            as integer   no-undo .
     2200       define variable v-idx-field-qnty as integer   no-undo .
     2201       define variable v-delim-key      as character no-undo .
     2202       if p-key-rec = ?
     2203         or p-key-rec = "":U
     2204       then do:
     2205         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info16 ).
     2206       end.
     2207       assign
     2208         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     2209         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     2210       .
     2211       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     2212       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info16 ).
     2213       assign
     2214         v-inform = bh_tbl-name:index-information(1)
     2215         v-ind    = 2
     2216       .
     2217       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     2218       on error undo, return error
     2219       :
     2220         assign
     2221           v-inform = bh_tbl-name:index-information( v-ind )
     2222           v-ind    = v-ind + 1
     2223         .
     2224       end.
     2225       if v-inform = ?
     2226         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     2227         or entry( 3, v-inform, ",":U ) <> "1":U
     2228       then do:
     2229         delete object bh_tbl-name no-error.
     2230         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info16, v-tbl-name ).
     2231       end.
     2232       assign
     2233         v-idx-field-qnty = num-entries( v-inform ) - 4
     2234       .
     2235       if v-idx-field-qnty < 2 then do:
     2236         delete object bh_tbl-name no-error.
     2237         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info16, v-inform, v-tbl-name ).
     2238       end.
     2239       assign
     2240         p-field-list = "":U
     2241         p-value-list = "":U
     2242         v-delim-key  = "":U
     2243         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     2244         v-count-fld  = 0
     2245       .
     2246       block_where:
     2247       do v-ind = 1 to v-idx-field-qnty by 2
     2248       on error undo, return error
     2249       :
     2250         assign
     2251           v-count-fld = v-count-fld + 1
     2252         .
     2253         if v-count-fld > v-field-num then do:
     2254           leave block_where.
     2255         end.
     2256         assign
     2257           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     2258           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     2259         .
     2260         if v-ind = 1 then do:
     2261           assign
     2262             v-delim-key = chr(3)
     2263           .
     2264         end.
     2265       end.
     2266       delete object bh_tbl-name.
     2267       if v-count-fld <> v-field-num then do:
     2268         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info16, v-tbl-name ).
     2269       end.
     2270     end.
     2271   end procedure.
     2272   procedure gen-key-field :
     2273     define input  parameter p-table      as character no-undo .
     2274     define output parameter p-field-list as character no-undo .
     2275     do
     2276     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2277     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     2278     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     2279     :
     2280       define variable v-full-tbl-name  as character no-undo .
     2281       define variable bh_tbl-name      as handle    no-undo .
     2282       define variable v-tbl-name       as character no-undo .
     2283       define variable v-field-num      as integer   no-undo .
     2284       define variable v-count-fld      as integer   no-undo .
     2285       define variable v-inform         as character no-undo .
     2286       define variable v-ind            as integer   no-undo .
     2287       define variable v-idx-field-qnty as integer   no-undo .
     2288       define variable v-delim-key      as character no-undo .
     2289       if p-table = ?
     2290         or p-table = "":U
     2291       then do:
     2292         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info16 ).
     2293       end.
     2294       assign
     2295         v-tbl-name      = p-table
     2296         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     2297       .
     2298       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     2299       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info16 ).
     2300       assign
     2301         v-inform = bh_tbl-name:index-information(1)
     2302         v-ind    = 2
     2303       .
     2304       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     2305       on error undo, return error
     2306       :
     2307         assign
     2308           v-inform = bh_tbl-name:index-information( v-ind )
     2309           v-ind    = v-ind + 1
     2310         .
     2311       end.
     2312       if v-inform = ?
     2313         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     2314         or entry( 3, v-inform, ",":U ) <> "1":U
     2315       then do:
     2316         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info16, v-tbl-name ).
     2317       end.
     2318       assign
     2319         v-idx-field-qnty = num-entries( v-inform ) - 4
     2320       .
     2321       if v-idx-field-qnty < 2 then do:
     2322         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info16, v-inform, v-tbl-name ).
     2323       end.
     2324       assign
     2325         p-field-list = "":U
     2326         v-delim-key  = "":U
     2327         v-count-fld  = 0
     2328       .
     2329       block_where:
     2330       do v-ind = 1 to v-idx-field-qnty by 2
     2331       on error undo, return error
     2332       :
     2333         assign
     2334           v-count-fld = v-count-fld + 1
     2335         .
     2336         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     2337         if v-ind = 1 then do:
     2338           assign
     2339             v-delim-key = chr(3)
     2340           .
     2341         end.
     2342       end.
     2343       delete object bh_tbl-name.
     2344     end.
     2345   end procedure.
     2346   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2347   procedure db-attr-code :
     2348     define input  parameter p-code           as character no-undo .
     2349     define output parameter p-type           as character no-undo .
     2350     define output parameter p-format         as character no-undo .
     2351     define output parameter p-label          as character no-undo .
     2352     define output parameter p-user-can-edit  as logical   no-undo .
     2353     define output parameter p-output-display as logical   no-undo .
     2354     define output parameter p-other          as character no-undo .
     2355     do
     2356     on error undo, return error
     2357     :
     2358           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run db-attr-code in g#attr-lib
     2359         (input  p-code
     2360         ,output p-type
     2361         ,output p-format
     2362         ,output p-label
     2363         ,output p-user-can-edit
     2364         ,output p-output-display
     2365         ,output p-other
     2366         ) no-error .
     2367       if error-status :error
     2368       then do:
     2369         undo, return error return-value .
     2370       end.
     2371     end.
     2372   end procedure.
