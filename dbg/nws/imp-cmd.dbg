     2391   procedure db-attr-value :
     2392     define input  parameter p-db-num    like ub.db-attr.db-num     no-undo .
     2393     define input  parameter p-code      like ub.db-attr.attr-code  no-undo .
     2394     define output parameter p-value     like ub.db-attr.attr-value no-undo .
     2395     define output parameter p-type      as character no-undo .
     2396     do
     2397     on error undo, return error
     2398     :
     2399           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run db-attr-value in g#attr-lib
     2400         (input  p-db-num
     2401         ,input  p-code
     2402         ,output p-value
     2403         ,output p-type
     2404         ) no-error .
