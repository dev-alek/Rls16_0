      532   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      533   define shared temp-table dc-list no-undo like ub.dis-card
      534     field to-del as logical
      535     field order-num as integer
      536     field fdec as decimal
      537     field fint as integer
      538     field flog as logical
      539     field fchar as character
      540     index pi  is primary unique d-card
      541     index cn      card-num
