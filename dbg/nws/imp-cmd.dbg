     2513   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2514   define variable v-loc-counter as integer no-undo .
     2515   define variable v-counter-visible as logical no-undo .
     2516   define variable v-view-log as logical no-undo .
     2517   define stream auto2dia.
     2518   PROCEDURE write-log-and-file :
     2519   do
     2520   on error undo, return error
     2521   :
     2522     define input parameter p-tab-position   as integer   no-undo.
     2523     define input parameter p-file-name      as character no-undo .
     2524     define input parameter p-log-level      as integer   no-undo .
     2525     define input parameter p-log-string     AS CHARacter NO-UNDO.
     2526     define variable v-jj as integer   no-undo .
     2527     run write-to-screen in this-procedure( input ( fill( chr(32), p-tab-position) + p-log-string)) .
     2528     if p-file-name <> '':U then do:
     2529       do v-jj = 1 to num-entries(p-file-name, chr(1)):
     2530         run  auto2dia-writefile in this-procedure (
     2531                                         input entry(v-jj, p-file-name, chr(1))
     2532                                         ,input p-log-level
     2533                                         ,input (p-log-string + chr(10))
     2534                                       ) no-error .
     2535       end.
     2536     end.
     2537     if writelogvalue eq "AsyncProc"
     2538     then
     2539        run write-to-log in this-procedure( p-log-string) .
     2540   end.
     2541   END PROCEDURE.
     2542   PROCEDURE get-title :
     2543   do
     2544   on error undo, return error
     2545   :
