     2621       v-view-log = p-view-log
     2622       .
     2623   end.
     2624   END PROCEDURE.
     2625   PROCEDURE get-view-log :
     2626   do
     2627   on error undo, return error
     2628   :
     2629   define output parameter p-view-log     as logical    no-undo.
     2630       assign
     2631       p-view-log = v-view-log
     2632       .
     2633   end.
