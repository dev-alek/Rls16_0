     2577   PROCEDURE show-counter :
     2578   do
     2579   on error undo, return error
     2580   :
     2581       assign
     2582       v-counter-visible = true
     2583       .
     2584       process events.
     2585   end.
     2586   END PROCEDURE.
     2587   PROCEDURE hide-counter :
     2588   do
     2589   on error undo, return error
     2590   :
     2591       assign
     2592       v-counter-visible = false
     2593       .
     2594       run hide-message in auto-window-h .
     2595       process events.
     2596   end.
     2597   END PROCEDURE.
     2598   PROCEDURE write-counter :
     2599   do
     2600   on error undo, return error
     2601   :
     2602   define input parameter p-counter-string     as character    no-undo.
     2603   if v-counter-visible then
     2604   run write-message in auto-window-h ( input p-counter-string) .
     2605   process events.
     2606   end.
     2607   END PROCEDURE.
     2608   PROCEDURE get-stop-state :
     2609   do
     2610   on error undo, return error
     2611   :
