     2411   procedure db-attr-write :
     2412     define input parameter p-db-num    like ub.db-attr.db-num     no-undo .
     2413     define input parameter p-code      like ub.db-attr.attr-code  no-undo .
     2414     define input parameter p-value     like ub.db-attr.attr-value no-undo .
     2415     do
     2416     on error undo, return error
     2417     :
     2418           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run db-attr-write in g#attr-lib
     2419         (input p-db-num
     2420         ,input p-code
     2421         ,input p-value
     2422         ) no-error .
     2423       if error-status :error
