     2929             i-par = substr(i-par, index(i-par, chr(1)) + 1)
     2930             i-par = substr(i-par, index(i-par, chr(1)) + 1)
     2931             .
     2932             do rf-ii = 1 to 5:
     2933               i-par = (if r-index(i-par, chr(1))  > 1
     2934                       then  substr(i-par, 1, r-index(i-par, chr(1)) - 1)
     2935                       else i-par)
     2936               .
     2937             end.
