     3827                             tax-rate-gds.tax-code  = tax-rate-attr.tax-code
     3828                         and tax-rate-gds.rate-code = tax-rate-attr.rate-code
     3829                         and tax-rate-gds.fact-date <= today
     3830                    no-lock:
     3831                       run fill-g-list in p-imp-handle (tax-rate-gds.gds-code,
     3832                                                        v-obj-type,
     3833                                                        v-obj-code).
     3834                    end.
     3835                 end.
     3836               end.
     3837               when 'Code':U then
     3838               do:
     3839                  find first ub.code
     3840                         where rowid( ub.code ) = v-tbl-row
     3841                   no-error.
     3842                   if available ub.code then
     3843                   do:
     3844                      run fill-code in p-imp-handle (ub.code.parent,
     3845                                                     ub.code.code).
     3846                      delete ub.code.
     3847                  end.
     3848               end.
