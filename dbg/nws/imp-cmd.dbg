     4071                   ( input v-key-rec
     4072                    ,input false
     4073                   ) no-error .
     4074                 if error-status :error then do:
     4075                   run write-to-log( substitute( "&1&2&3&2&4", vss-workfile, chr(10), return-value, error-status:get-message( 1 ) ) ).
     4076                   return error.
     4077                 end.
     4078               end.
     4079               when 'ext-system':U then do:
     4080                 find first ub.ext-system no-lock where
     4081                           rowid(ub.ext-system) = v-tbl-row no-error.
     4082                 if available ub.ext-system
     4083                 and ub.ext-system.esys-type > integer('0':U) then do:
     4084                   run bge/extsyss3.p ( input yes
     4085                                       ,input recid(ub.ext-system)) no-error.
     4086                 end.
     4087                 else do:
     4088                   run nws/del-rec.p
     4089                     ( input v-key-rec
     4090                     ,input false
     4091                     ) no-error .
     4092                 end.
     4093                 if error-status :error then do:
     4094                   run write-to-log( substitute( "&1&2&3&2&4", vss-workfile, chr(10), return-value, error-status:get-message( 1 ) ) ).
     4095                   return error.
     4096                 end.
     4097               end.
     4098               otherwise do:
     4099                 run write-to-log ( substitute( "&1. Нет обработки команды на удаление для таблицы &2", vss-workfile, v-tbl-name ) ).
     4100                 return error.
     4101               end.
     4102             end case.
     4103           end.
     4104           when "cut-doc":U then do:
     4105             p-stop  = false .
     4106             run gbl/btprcver.p ( output p-stop ) no-error .
     4107             if error-status :error then do:
     4108               run write-to-log ( substitute( "Ошибка при проверке отложенных заданий расчета переоценок &1&2&1&3", chr(10), return-value, error-status :get-message(1) ) ).
     4109               return error.
     4110             end.
     4111             if p-stop  then do:
     4112               run write-to-log ( substitute( "Обнаружены отложенные задания расчета переоценок . &1 ПЕРЕСЧИТАЙТЕ АРХИВ !!!", chr(10) )).
     4113               return error.
     4114             end.
     4115             run db-attr-write in this-procedure
     4116               ( input g#db-num
     4117                ,input 'cut-date':U
     4118                ,input entry(3,rec-full,chr(1))
     4119               ) no-error .
     4120             if error-status :error then do:
     4121               run write-to-log ( substitute( "Ошибка при записи даты усечения документов&1&2&1&3", chr(10), return-value, error-status :get-message(1) ) ).
     4122               return error.
     4123             end.
     4124             run db-attr-write in this-procedure
     4125               ( input g#db-num
     4126                ,input 'cut-fin-date':U
     4127                ,input entry(4,rec-full,chr(1))
     4128               ) no-error .
     4129             if error-status :error then do:
     4130               run write-to-log( substitute( "Ошибка при записи даты усечения документов&1&2&1&3", chr(10), return-value, error-status :get-message(1) ) ).
     4131               return error.
     4132             end.
     4133           end.
     4134           when "delete-object":U then do:
     4135             run utl/del-obj.p
     4136               (input entry(3,rec-full,chr(1)) + chr(44) + entry(4,rec-full,chr(1))
     4137               ,input no
     4138               ,input ""
     4139               ,input ""
     4140               ) .
     4141           end.
     4142           when "r-file" then do:
     4143           end.
     4144           otherwise do:
     4145             run write-to-log(substitute( "&1. Отсутствует обработка команды &2", vss-workfile, rec-full ) ).
     4146             return error.
     4147           end.
     4148         end case.
     4149       end.
     4150       when "get-seq" then do:
     4151           case entry(2, rec-full, chr(1)):
     4152             when "s-sclc-code" then do:
     4153               run nws/cr-route.p ( input 'send-cmd':U
     4154                              ,input "put-seq" + chr(1) + "s-sclc-code" + chr(1)
     4155                                     + string( current-value( s-sclc-code, ub ) ) + chr(1) + string( g#db-num )
     4156                              ,input ?
     4157                              ,input "0":U
     4158                             ).
     4159             end.
     4160             otherwise do:
     4161               run write-to-log(substitute( "&1. Отсутствует обработка команды &2", vss-workfile, rec-full ) ).
     4162               return error.
     4163             end.
     4164           end case.
     4165       end.
     4166       when "dlcr" then do:
     4167         run nws/dlcr.p ( entry(2, rec-full, chr(1)), entry(3, rec-full, chr(1)) ) no-error.
     4168         if error-status:error then do:
     4169           run write-to-log( "ошибка при работе утилиты dlcr" ).
     4170           return error.
     4171         end.
     4172       end.
     4173       when "put-seq" then do:
     4174           case entry(2, rec-full, chr(1)):
     4175             when "s-sclc-code" then do:
     4176               create ub.rep .
     4177               assign
     4178                 ub.rep.doc-num = -27091997
     4179                 ub.rep.gr      = integer( entry(4, rec-full, chr(1)) )
     4180                 ub.rep.num     = integer( entry(3, rec-full, chr(1)) )
     4181               .
     4182             end.
     4183             otherwise do:
     4184               run write-to-log(substitute( "&1. Отсутствует обработка команды &2", vss-workfile, rec-full ) ).
     4185               return error.
     4186             end.
     4187           end case.
     4188       end.
     4189       otherwise do:
     4190         run write-to-log(substitute( "&1. Отсутствует обработка команды &2", vss-workfile, rec-full ) ).
     4191         return error.
     4192       end.
     4193     end case.
     4194   end.
