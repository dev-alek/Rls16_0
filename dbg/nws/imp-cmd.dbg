     2635   PROCEDURE write-log :
     2636   do
     2637   on error undo, return error
     2638   :
     2639   define input parameter p-tab-position   as integer      no-undo.
     2640   define input parameter p-log-string     as character    no-undo.
     2641   run write-to-log in this-procedure( input ( fill( chr(32), 1  * p-tab-position)  +
     2642                                       (IF p-log-string = "&Line" THEN FILL("-", 80)
     2643                                       ELSE IF p-log-string = "&DLine" THEN FILL("=", 80)
     2644                                       ELSE p-log-string))).
     2645   end.
     2646   END PROCEDURE.
     2647   procedure writelog :
     2648   do
     2649   on error undo, return error
     2650   :
     2651   define input parameter p-file-name AS CHAR     NO-UNDO.
     2652   define input parameter p-log-level AS INTEGER  NO-UNDO.
     2653   define input parameter p-log-string  AS CHAR     NO-UNDO.
     2654     if p-file-name <> "" then
     2655     run  auto2dia-Writefile in this-procedure (
     2656                                       input p-file-name
     2657                                     ,input p-log-level
     2658                                     ,input p-log-string
     2659                                   ) no-error .
     2660      process events.
     2661   end.
     2662   end procedure.
     2663   PROCEDURE auto2dia-writefile:
     2664     define input parameter sFileName AS CHAR     NO-UNDO.
     2665     define input parameter iLogLevel AS INTEGER  NO-UNDO.
     2666     define input parameter sToWrite  AS CHAR     NO-UNDO.
     2667     define variable v-SlashPos  as integer no-undo .
     2668     define variable v-lDirName  as character no-undo .
     2669     define variable v-lDirName2 as character no-undo .
     2670     v-SlashPos  = maximum (  r-index(sFileName, "\"),  r-index(sFileName, "/")  ) .
     2671     v-lDirName  = if v-SlashPos > 0 then substring (sFileName, 1, v-SlashPos - 1) else "".
     2672     FILE-INFO:FILE-NAME = v-lDirName .
     2673     v-lDirName2 = FILE-INFO:FULL-PATHNAME .
     2674     if v-lDirName2 <> ? then do :
     2675   OUTPUT STREAM auto2dia TO VALUE(sFileName) APPEND.
     2676       PUT STREAM auto2dia UNFORMATTED chr(10).
     2677       PUT STREAM auto2dia UNFORMATTED (IF (iLogLevel = 0 OR sToWrite = "&DLine"
     2678                                         OR sToWrite = "&Line") THEN "" ELSE
     2679                                         cur-time-string-sec() + " ").
     2680       PUT STREAM auto2dia UNFORMATTED
     2681               (IF sToWrite = "&Line" THEN FILL("-", 80)
     2682                ELSE IF sToWrite = "&DLine" THEN FILL("=", 80)
     2683                ELSE sToWrite).
     2684   OUTPUT STREAM auto2dia CLOSE.
     2685     end .
     2686   END PROCEDURE.
     2687   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2688   define new global shared variable g#lib-nws as handle no-undo .
     2689     define new global shared variable g#lib-rvs as handle no-undo.
     2690   do
     2691   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     2692   on stop   undo, return error substitute( "&1. stop", vss-workfile )
     2693   on endkey undo, return error substitute( "&1. endkey", vss-workfile )
     2694   :
     2695     define buffer buf_clients for ub.clients.
     2696     define buffer buf_shop for ub.shop.
     2697     define buffer buf_dis-card for ub.dis-card.
     2698     define buffer buf_db for ub.db .
     2699     define buffer buf_db-rec-attr for ub.db-rec-attr .
     2700     define buffer buf_goods for ub.goods.
     2701     define buffer buf_gds-obj for ub.gds-obj .
     2702     define buffer buf_esys-route for ub.esys-route .
     2703     DEFINE VARIABLE var-rate-value like ub.tax-rate-value.rate-value no-undo .
     2704     define variable i-f-name        as character no-undo.
     2705     define variable i-par as character no-undo .
     2706     define variable v-error-message as character no-undo.
     2707     define variable v-curr-date as date    no-undo.
     2708     define variable v-curr-time as integer no-undo .
     2709     define variable v-step      as integer no-undo .
     2710     define variable v-type           as character no-undo .
     2711     define variable v-format         as character no-undo .
     2712     define variable v-label          as character no-undo .
     2713     define variable v-range          as integer   no-undo .
     2714     define variable v-user-can-edit  as logical   no-undo .
     2715     define variable v-output-display as logical   no-undo .
     2716     define variable v-other          as character no-undo .
     2717     define variable v-key-rec        as character no-undo .
     2718     define variable v-tbl-row        as rowid     no-undo .
     2719     define variable v-tbl-name       as character no-undo .
     2720     define variable v-uniq-gate-rec  as character no-undo .
     2721     define variable jj as integer no-undo .
     2722     define variable v-dop1 as character no-undo .
     2723     define variable v-dop2 as character no-undo .
     2724     define variable v-chip-num like ub.c-trn-doc.chip-num no-undo .
     2725     define variable v-action       as character no-undo .
     2726     define variable v-uniq-key-rec as character no-undo .
     2727     define variable v-parameters   as character no-undo .
     2728     define variable v-doc-code     as character no-undo .
     2729     define variable v-host-code    as integer   no-undo .
     2730     define variable v-db-num       as integer   no-undo .
     2731     define variable v-obj-type     as character no-undo .
     2732     define variable v-obj-code     as integer   no-undo .
     2733     define variable v-artic        as character no-undo .
     2734     define variable v-prod-type    as character no-undo .
     2735     define variable v-prod-code    as integer   no-undo .
     2736     define variable v-on-line-rest as decimal   no-undo .
     2737     define variable v-cash-parts   as logical   no-undo .
     2738     define variable v-insalepr     as integer   no-undo .
     2739     define variable p-stop         as logical   no-undo .
     2740     define variable v-factur-date like ub.trn-doc.factur-date .
     2741     define variable v-cr-factur   like ub.trn-doc.cr-factur   .
     2742     define variable v-need-factur like ub.trn-doc.need-factur .
     2743     define variable v-nws-to-cd as integer no-undo .
     2744     DEFINE VARIABLE v-prn-doc-code as character no-undo .
     2745     define variable v-last-pack as integer   no-undo .
     2746     define variable v-attr-code as character no-undo.
     2747     case entry(1,rec-full,chr(1)):
     2748       when "command" then do:
     2749         case entry(2,rec-full,chr(1)):
     2750           when 'goods':U then do:
     2751             case entry(3,rec-full,chr(1)) :
     2752               when "ren-gds-code":U then do:
     2753                 run utl/ren-gdsc.p
     2754                   ( integer( entry( 4, rec-full, chr(1) ) )
     2755                    ,integer( entry( 5, rec-full, chr(1) ) )
     2756                   ) no-error.
     2757                 if error-status :error then do:
     2758                   run write-to-log in this-procedure
     2759                     (input "Не удалось заменить gds-code существовавшего товара " + entry( 4, rec-full, chr(1) )
     2760                           + " на " + entry( 5, rec-full, chr(1) ) + "." + chr(10)
     2761                           + return-value + chr(10) + error-status:get-message(1) + chr(10) + rec-full
     2762                     ).
     2763                   return error.
     2764                 end.
     2765               end.
     2766               otherwise do:
     2767                 run write-to-log(substitute( "&1. Отсутствует обработка команды &2", vss-workfile, rec-full ) ).
     2768                 return error.
     2769               end.
     2770             end case.
     2771           end.
     2772           when "message-to-log":U then do:
     2773             run write-to-log( substitute( "<MESSAGE> &1", entry(3,rec-full,chr(1)) ) ).
     2774           end.
     2775           when "inquiry-two-commit":U then do:
     2776             assign
     2777               v-action       = entry(3,rec-full,chr(1))
     2778               v-uniq-key-rec = entry(4,rec-full,chr(1))
     2779               v-parameters   = entry(5,rec-full,chr(1))
     2780             .
     2781             run write-to-log( substitute( "Получен запрос из БД &1 на выполнение операции &2 над записью &3"
     2782                                           ,g#news-source-db
     2783                                           ,v-action
     2784                                           ,v-uniq-key-rec
     2785                                         )
     2786                             ).
     2787             run nws/db-rec.p
     2788               ( input v-action
     2789                ,input v-uniq-key-rec
     2790                ,input v-parameters
     2791               ) no-error .
     2792             if error-status :error then do:
     2793               run write-to-log( substitute( "&1 (inquiry-two-commit). &2&3&4", vss-workfile, return-value, chr(10), error-status:get-message( 1 ) ) ).
     2794               return error.
     2795             end.
     2796             if return-value <> "":U then do:
     2797               run write-to-log( substitute( "Ошибка при выполнении операции &1 над записью &2&3&4"
     2798                                             ,v-action
     2799                                             ,v-uniq-key-rec
     2800                                             ,chr(10)
     2801                                             ,return-value
     2802                                            )
     2803                               ).
     2804             end.
     2805             else do:
     2806               run write-to-log( substitute( "Начинается выполнение операции &1 над записью &2"
     2807                                             ,v-action
     2808                                             ,v-uniq-key-rec
     2809                                           )
     2810                               ).
     2811             end.
     2812           end.
     2813           when "two-commit":U then do:
     2814             run nws/dbreccmd.p
     2815               ( input g#news-source-db
     2816                ,input rec-full
     2817               ) no-error .
     2818             if error-status :error then do:
     2819               run write-to-log( substitute( "&1 (two-commit). &2&3&4", vss-workfile, return-value, chr(10), error-status:get-message( 1 ) ) ).
     2820               return error.
     2821             end.
     2822           end.
     2823           when "after-two-commit":U then do:
     2824             run nws/dbrecaft.p
     2825               ( input g#news-source-db
     2826                ,input rec-full
     2827               ) no-error .
     2828             if error-status :error then do:
     2829               run write-to-log( substitute( "&1 (after-two-commit). &2&3&4", vss-workfile, return-value, chr(10), error-status:get-message( 1 ) ) ).
     2830               return error.
     2831             end.
     2832           end.
     2833           when "get-inf-dbs":U then do:
     2834             if g#db-num = 0 then do:
     2835               for each buf_db no-lock
     2836               on error undo, return error substitute( "&1 &2", return-value, error-status :get-message(1) )
     2837               :
     2838                 run str/callnews.p
     2839                   ( input 'db':U
     2840                    ,input (buffer buf_db:handle)
     2841                   ) .
     2842               end.
     2843             end.
     2844           end.
     2845           when "fill-contract":U then do:
     2846             run utl/fill-cnt.p
     2847               ( input integer(entry(3,rec-full,chr(1)))
     2848                ,input entry(4,rec-full,chr(1))
     2849               )  no-error .
     2850             if error-status :error then do:
     2851               run write-to-log( vss-workfile + chr(32) + "Ошибка при привязке партий и складских документов к договору поставщика на удаленке !"  ).
     2852               return error.
     2853             end.
     2854           end.
     2855           when "place-attr":U then do:
     2856             run utl/fill-pl-attr.p
     2857               ( input entry(3,rec-full,chr(1))
     2858                ,input integer(entry(4,rec-full,chr(1)))
     2859                ,input integer(entry(5,rec-full,chr(1)))
     2860                ,input entry(6,rec-full,chr(1))
     2861                ,input entry(7,rec-full,chr(1))
     2862               )  no-error .
     2863             if error-status :error then do:
     2864               run write-to-log( vss-workfile + chr(32) + "Ошибка при установке атрибута резервуара на удаленке !"  ).
     2865               return error.
     2866             end.
     2867           end.
     2868           when "fin-ob-factur-date":U then do:
     2869             assign v-doc-code    = entry(3,rec-full,chr(1)) no-error .
     2870             assign v-host-code   = int(entry(4,rec-full,chr(1))) no-error .
     2871             assign v-factur-date = date(entry(5,rec-full,chr(1))) no-error .
     2872             assign v-cr-factur   = logical(entry(6,rec-full,chr(1))) no-error .
     2873             assign v-need-factur = int(entry(7,rec-full,chr(1))) no-error .
     2874             define buffer buf_fin-ob for ub.fin-ob .
     2875             find first buf_fin-ob exclusive-lock where buf_fin-ob.doc-code = v-doc-code and buf_fin-ob.host-code = v-host-code  no-error .
     2876             if available buf_fin-ob then do:
     2877               assign
     2878                 buf_fin-ob.factur-date = v-factur-date
     2879                 buf_fin-ob.cr-factur   = v-cr-factur
     2880                 buf_fin-ob.need-factur = v-need-factur
     2881               .
     2882             end.
     2883           end.
     2884           when "fin-doc-factur-date":U then do:
     2885             assign v-doc-code    = entry(3,rec-full,chr(1)) no-error .
     2886             assign v-host-code   = int(entry(4,rec-full,chr(1))) no-error .
     2887             assign v-factur-date = date(entry(5,rec-full,chr(1))) no-error .
     2888             assign v-cr-factur   = logical(entry(6,rec-full,chr(1))) no-error .
     2889             assign v-need-factur = int(entry(7,rec-full,chr(1))) no-error .
