        1   block-level on error undo, throw.
        2   using ibs.th.adm.upd.*.
        3   define input parameter p-tbl-name   as character no-undo .
        4   define input parameter p-tbl-handle as handle    no-undo .
        5   define input parameter p-db-list    as character no-undo .
        6   define variable vss-revision    as character no-undo init "$Revision: 4988c214daa5, 1646, rls $":U .
        7   define variable vss-author      as character no-undo init "$Author: EShklyar $":U .
        8   define variable vss-date        as character no-undo init "$Date: Mon Nov 19 15:15:35 2018 +0300 $":U .
        9   define variable vss-workfile    as character no-undo init "$Workfile: cmd-del.p $":U .
       10   define variable vss-archive     as character no-undo init "$Archive: nws/cmd-del.p $":U .
       11   define variable vss-description as character no-undo init "создание маршрутизации с командой на удаление записи".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define new global shared variable g#library  as handle no-undo .
       71   define new global shared variable g#library2 as handle no-undo .
       72   define   shared variable g#auto as logical no-undo.
       73   define   shared variable g#news as logical no-undo.
       74   define   shared variable g#oxml as logical no-undo.
       75   define   shared variable g#esys as logical no-undo.
       76   define   shared variable g#news-source-db as integer no-undo.
       77   define   shared variable g#esys-source-esys as integer no-undo.
       78   define   shared variable g#db-num as integer   no-undo .
       79   define   shared variable g#userid as character no-undo .
       80   define   shared variable g#passwd as character no-undo .
       81   def var vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       82   procedure gen-key-rec :
       83     define input  parameter p-tbl-name    as character no-undo.
       84     define input  parameter p-bh_tbl-name as handle    no-undo.
       85     define output parameter p-key-rec     as character no-undo.
       86     do
       87     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
       88     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
       89     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
       90     :
       91       define variable fh               as handle    no-undo .
       92       define variable v-ok             as logical   no-undo .
       93       define variable v-inform         as character no-undo .
       94       define variable v-ind            as integer   no-undo .
       95       define variable v-idx-field-qnty as integer   no-undo .
       96       if p-tbl-name = ?
       97         or p-tbl-name = "":U
       98       then do:
       99         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info0 ).
      100       end.
      101       if not p-bh_tbl-name:available then do:
      102         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info0, p-tbl-name ).
      103       end.
      104       assign
      105         p-key-rec = p-tbl-name
      106         v-inform  = p-bh_tbl-name:index-information(1)
      107         v-ind     = 2
      108       .
      109       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      110       on error undo, return error
      111       :
      112         assign
      113           v-inform = p-bh_tbl-name:index-information( v-ind )
      114           v-ind    = v-ind + 1
      115         .
      116       end.
      117       if v-inform = ?
      118         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      119         or entry( 3, v-inform, ",":U ) <> "1":U
      120       then do:
      121         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info0, p-tbl-name ).
      122       end.
      123       else do:
      124         assign
      125           v-idx-field-qnty = num-entries( v-inform ) - 4
      126         .
      127         if v-idx-field-qnty < 2 then do:
      128           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info0, v-inform, p-tbl-name ).
      129         end.
      130         do v-ind = 1 to v-idx-field-qnty by 2
      131         on error undo, return error
      132         :
      133           assign
      134             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      135             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      136           .
      137         end.
      138       end.
      139       if p-key-rec = ? then do:
      140         assign
      141           p-key-rec = "":U
      142         .
      143         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info0, p-tbl-name ).
      144       end.
      145     end.
      146     return.
      147   end procedure.
      148   procedure gen-where-keyr-tab :
      149     define input  parameter i-tableSerach as character no-undo.
      150     define input  parameter i-tablekey   as character  no-undo.
      151     define input  parameter p-key-rec    as character  no-undo.
      152     define input  parameter p-key-handle as handle     no-undo .
      153     define input  parameter p-db-name    as character  no-undo .
      154     define input  parameter p-tt-handle  as handle     no-undo .
      155     define output parameter o-Where      as character  no-undo.
      156     do
      157     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      158     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      159     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      160     :
      161       define variable v-full-tbl-name  as character no-undo .
      162       define variable bh_tbl-name      as handle    no-undo .
      163       define variable fh_key           as handle    no-undo .
      164       define variable fh_search        as handle    no-undo .
      165       define variable v-field-num      as integer   no-undo .
      166       define variable v-count-fld      as integer   no-undo .
      167       define variable v-inform         as character no-undo .
      168       define variable v-ind            as integer   no-undo .
      169       define variable v-idx-field-qnty as integer   no-undo .
      170       define variable v-field-name     as character no-undo .
      171       define variable v-field-val      as character no-undo .
      172       define variable v-word-link      as character no-undo .
      173       define variable vTable           as character no-undo.
      174       define variable bh_tbl-key       as handle    no-undo .
      175       assign
      176         p-key-rec = trim( p-key-rec )
      177       .
      178       if p-key-handle <> ? then do:
      179         if not valid-handle(p-key-handle)
      180            or p-key-handle:type <> "buffer"
      181         then do:
      182           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info0 ).
      183         end.
      184         if num-entries( p-key-rec, chr(3) ) > 1
      185           or p-key-rec = ?
      186           or p-key-rec = "":U
      187         then do:
      188           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info0, p-key-rec ).
      189         end.
      190       end.
      191       else do:
      192         if p-key-rec = ?
      193           or p-key-rec = "":U
      194         then do:
      195           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info0 ).
      196         end.
      197       end.
      198       assign
      199         vTable = entry( 1 , p-key-rec, chr(3) )
      200       .
      201       if p-tt-handle <> ?
      202         and ( not valid-handle(p-tt-handle)
      203               or p-tt-handle:type <> "buffer"
      204             )
      205       then do:
      206         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info0, vTable, chr(10) ).
      207       end.
      208       if p-tt-handle = ? then do:
      209         assign
      210           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      211         .
      212         create buffer bh_tbl-name for table v-full-tbl-name .
      213       end.
      214       else do:
      215         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      216       end.
      217       assign
      218         v-inform = bh_tbl-name:index-information(1)
      219         v-ind    = 2
      220       .
      221       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      222       on error undo, return error
      223       :
      224         assign
      225           v-inform = bh_tbl-name:index-information( v-ind )
      226           v-ind    = v-ind + 1
      227         .
      228       end.
      229       if v-inform = ?
      230         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      231         or entry( 3, v-inform, ",":U ) <> "1":U
      232       then do:
      233         delete object bh_tbl-name no-error.
      234         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info0, vTable ).
      235       end.
      236       assign
      237         v-idx-field-qnty = num-entries( v-inform ) - 4
      238       .
      239       if v-idx-field-qnty < 2 then do:
      240         delete object bh_tbl-name no-error.
      241         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info0, v-inform, vTable ).
      242       end.
      243       assign
      244         o-where     = "where":U
      245         v-word-link = "":U
      246         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      247         v-count-fld = 0
      248       .
      249       if i-tablekey ne "" and i-tablekey ne ?
      250       then do:
      251         assign
      252           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      253         .
      254         create buffer bh_tbl-key for table v-full-tbl-name .
      255       end.
      256       if i-tableSerach ne "" and i-tableSerach ne ?
      257       then do:
      258         delete object bh_tbl-name no-error.
      259         assign
      260           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      261         .
      262         create buffer bh_tbl-name for table v-full-tbl-name .
      263       end.
      264       block_where:
      265       do v-ind = 1 to v-idx-field-qnty by 2
      266       on error undo, return error
      267       :
      268         assign
      269           v-count-fld = v-count-fld + 1
      270         .
      271         if p-key-handle = ?
      272           and v-count-fld > v-field-num
      273         then do:
      274           leave block_where.
      275         end.
      276         define variable VfieldKeyTable as handle no-undo.
      277         assign
      278           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      279           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      280         .
      281         if     bh_tbl-key ne ?
      282         then do:
      283            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      284            if VfieldKeyTable eq ?
      285            then next block_where.
      286         end.
      287         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      288         then
      289            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      290         else
      291            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      292         if p-key-handle = ? then do:
      293           assign
      294             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      295           .
      296         end.
      297         else do:
      298           assign
      299             fh_key = p-key-handle:buffer-field( v-field-name )
      300           .
      301           if fh_key = ?
      302             or not valid-handle( fh_key )
      303           then do:
      304             delete object bh_tbl-name.
      305             if     bh_tbl-key ne ?
      306             then
      307                delete object bh_tbl-key.
      308             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info0, p-key-handle:name, v-field-name ).
      309           end.
      310           assign
      311             v-field-val = fh_key:buffer-value
      312           .
      313         end.
      314         if fh_search:data-type ="character":U then do:
      315           assign
      316             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      317             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      318             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      319             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      320             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      321             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      322             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      323             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      324             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      325             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      326             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      327             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      328             v-field-val = substitute( '"&1"', v-field-val )
      329           .
      330         end.
      331         assign
      332           o-where = substitute( "&1 &2", o-where, v-field-val )
      333         .
      334         if v-word-link = "":U then do:
      335           assign
      336             v-word-link = "and":U
      337           .
      338         end.
      339       end.
      340       delete object bh_tbl-name.
      341       if     bh_tbl-key ne ?
      342       then
      343          delete object bh_tbl-key.
      344       if p-key-handle = ?
      345         and v-count-fld <> v-field-num
      346       then do:
      347         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info0, vTable ).
      348       end.
      349     end.
      350   end procedure.
      351   procedure gen-hn-keyr-tab :
      352     define input  parameter i-tableSerach as character no-undo.
      353     define input  parameter i-tablekey   as character no-undo.
      354     define input  parameter p-key-rec    as character no-undo.
      355     define input  parameter p-key-handle as handle    no-undo .
      356     define input  parameter p-db-name    as character no-undo .
      357     define input  parameter p-tt-handle  as handle    no-undo .
      358     define input  parameter p-stts-lock  as integer   no-undo .
      359     define output parameter o-hn         as handle    no-undo.
      360     define variable v-full-tbl-name as character no-undo.
      361     define variable v-where         as character no-undo.
      362     define variable bh_tbl-name     as handle    no-undo.
      363     define variable vTable          as character no-undo.
      364     do
      365     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      366     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      367     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      368         run gen-where-keyr-tab(i-tableSerach,
      369                                i-tablekey,
      370                                p-key-rec,
      371                                p-key-handle,
      372                                p-db-name,
      373                                p-tt-handle,
      374                                output v-where).
      375         if i-tableSerach ne "" and i-tableSerach ne ?
      376         then do:
      377            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      378            create buffer bh_tbl-name for table v-full-tbl-name .
      379         end.
      380         else do:
      381            if p-tt-handle = ? then do:
      382               assign
      383                  vTable = entry( 1 , p-key-rec, chr(3) )
      384               .
      385               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      386               create buffer bh_tbl-name for table v-full-tbl-name .
      387            end.
      388            else do:
      389               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      390            end.
      391         end.
      392         if p-tt-handle = ? then do:
      393            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      394         end.
      395         else do:
      396            bh_tbl-name:find-first( v-where ) no-error .
      397         end.
      398         o-hn = bh_tbl-name.
      399      end.
      400   end procedure.
      401   procedure gen-hn-keyr :
      402     define input  parameter p-key-rec    as character no-undo.
      403     define input  parameter p-key-handle as handle    no-undo .
      404     define input  parameter p-db-name    as character no-undo .
      405     define input  parameter p-tt-handle  as handle    no-undo .
      406     define input  parameter p-stts-lock  as integer   no-undo .
      407     define output parameter o-hn         as handle    no-undo.
      408     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      409   end.
      410   procedure gen-row-keyr :
      411     define input  parameter p-key-rec    as character no-undo.
      412     define input  parameter p-key-handle as handle    no-undo .
      413     define input  parameter p-db-name    as character no-undo .
      414     define input  parameter p-tt-handle  as handle    no-undo .
      415     define input  parameter p-stts-lock  as integer   no-undo .
      416     define output parameter p-tbl-row    as rowid     no-undo.
      417     define output parameter p-tbl-name   as character no-undo.
      418     define variable vHn as handle no-undo.
      419       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      420       p-tbl-row = if vHn:available then vHn:rowid else ?.
      421       p-tbl-name =  vHn:table.
      422       delete object vHn no-error.
      423     if p-tbl-row = ? then do:
      424       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info0, p-tbl-name, p-key-rec ).
      425     end.
      426     else do:
      427       return.
      428     end.
      429   end procedure.
      430   procedure gen-key-fv :
      431     define input  parameter p-key-rec    as character no-undo .
      432     define output parameter p-field-list as character no-undo .
      433     define output parameter p-value-list as character no-undo.
      434     do
      435     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      436     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      437     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      438     :
      439       define variable v-full-tbl-name  as character no-undo .
      440       define variable bh_tbl-name      as handle    no-undo .
      441       define variable v-tbl-name       as character no-undo .
      442       define variable v-field-num      as integer   no-undo .
      443       define variable v-count-fld      as integer   no-undo .
      444       define variable v-inform         as character no-undo .
      445       define variable v-ind            as integer   no-undo .
      446       define variable v-idx-field-qnty as integer   no-undo .
      447       define variable v-delim-key      as character no-undo .
      448       if p-key-rec = ?
      449         or p-key-rec = "":U
      450       then do:
      451         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info0 ).
      452       end.
      453       assign
      454         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      455         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      456       .
      457       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      458       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info0 ).
      459       assign
      460         v-inform = bh_tbl-name:index-information(1)
      461         v-ind    = 2
      462       .
      463       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      464       on error undo, return error
      465       :
      466         assign
      467           v-inform = bh_tbl-name:index-information( v-ind )
      468           v-ind    = v-ind + 1
      469         .
      470       end.
      471       if v-inform = ?
      472         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      473         or entry( 3, v-inform, ",":U ) <> "1":U
      474       then do:
      475         delete object bh_tbl-name no-error.
      476         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info0, v-tbl-name ).
      477       end.
      478       assign
      479         v-idx-field-qnty = num-entries( v-inform ) - 4
      480       .
      481       if v-idx-field-qnty < 2 then do:
      482         delete object bh_tbl-name no-error.
      483         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info0, v-inform, v-tbl-name ).
      484       end.
      485       assign
      486         p-field-list = "":U
      487         p-value-list = "":U
      488         v-delim-key  = "":U
      489         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      490         v-count-fld  = 0
      491       .
      492       block_where:
      493       do v-ind = 1 to v-idx-field-qnty by 2
      494       on error undo, return error
      495       :
      496         assign
      497           v-count-fld = v-count-fld + 1
      498         .
      499         if v-count-fld > v-field-num then do:
      500           leave block_where.
      501         end.
      502         assign
      503           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      504           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      505         .
      506         if v-ind = 1 then do:
      507           assign
      508             v-delim-key = chr(3)
      509           .
      510         end.
      511       end.
      512       delete object bh_tbl-name.
      513       if v-count-fld <> v-field-num then do:
      514         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info0, v-tbl-name ).
      515       end.
      516     end.
      517   end procedure.
      518   procedure gen-key-field :
      519     define input  parameter p-table      as character no-undo .
      520     define output parameter p-field-list as character no-undo .
      521     do
      522     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      523     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      524     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      525     :
      526       define variable v-full-tbl-name  as character no-undo .
      527       define variable bh_tbl-name      as handle    no-undo .
      528       define variable v-tbl-name       as character no-undo .
      529       define variable v-field-num      as integer   no-undo .
      530       define variable v-count-fld      as integer   no-undo .
      531       define variable v-inform         as character no-undo .
      532       define variable v-ind            as integer   no-undo .
      533       define variable v-idx-field-qnty as integer   no-undo .
      534       define variable v-delim-key      as character no-undo .
      535       if p-table = ?
      536         or p-table = "":U
      537       then do:
      538         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info0 ).
      539       end.
      540       assign
      541         v-tbl-name      = p-table
      542         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      543       .
      544       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      545       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info0 ).
      546       assign
      547         v-inform = bh_tbl-name:index-information(1)
      548         v-ind    = 2
      549       .
      550       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      551       on error undo, return error
      552       :
      553         assign
      554           v-inform = bh_tbl-name:index-information( v-ind )
      555           v-ind    = v-ind + 1
      556         .
      557       end.
      558       if v-inform = ?
      559         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      560         or entry( 3, v-inform, ",":U ) <> "1":U
      561       then do:
      562         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info0, v-tbl-name ).
      563       end.
      564       assign
      565         v-idx-field-qnty = num-entries( v-inform ) - 4
      566       .
      567       if v-idx-field-qnty < 2 then do:
      568         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info0, v-inform, v-tbl-name ).
      569       end.
      570       assign
      571         p-field-list = "":U
      572         v-delim-key  = "":U
      573         v-count-fld  = 0
      574       .
      575       block_where:
      576       do v-ind = 1 to v-idx-field-qnty by 2
      577       on error undo, return error
      578       :
      579         assign
      580           v-count-fld = v-count-fld + 1
      581         .
      582         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      583         if v-ind = 1 then do:
      584           assign
      585             v-delim-key = chr(3)
      586           .
      587         end.
      588       end.
      589       delete object bh_tbl-name.
      590     end.
      591   end procedure.
      592   do
      593   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      594   on stop   undo, return error substitute( "&1. stop", vss-workfile )
      595   on endkey undo, return error substitute( "&1. endkey", vss-workfile )
      596   :
      597     define variable v-key-rec as character no-undo .
      598     define variable v-global-action as logical  no-undo .
      599     define buffer buf_sys-ctrl for ub.sys-ctrl .
      600     define buffer buf_db       for ub.db .
      601     run gen-key-rec in this-procedure
      602       ( input p-tbl-name
      603        ,input p-tbl-handle
      604        ,output v-key-rec
      605       ) no-error .
      606     if error-status :error then do:
      607       return error substitute( "&1. Ошибка при генерации уникального ключа по таблице &2. &3&4&3&5"
      608                                ,vss-workfile
      609                                ,p-tbl-name
      610                                ,chr(10)
      611                                ,return-value
      612                                ,error-status :get-message ( error-status :num-messages )
      613                              ).
      614     end.
      615     find first buf_sys-ctrl no-lock .
      616     if buf_sys-ctrl.db-num = 0
      617       or ( buf_sys-ctrl.db-num <> 0
      618            and g#news <> true
      619           )
      620     then do:
      621     find first ub.global-state-attr no-lock where ub.global-state-attr.attr-code = "action-gbl" and ub.global-state-attr.attr-value = "yes" and ub.global-state-attr.gls-id = buf_sys-ctrl.db-num no-error .
      622     if available (ub.global-state-attr) then
      623     do:
      624       v-global-action = yes .
      625     end.
      626       if trim( p-db-list ) = "":U
      627         or p-db-list = ?
      628         or (p-db-list = "0" and v-global-action = yes)
      629       then do:
      630         assign
      631           p-db-list = "":U
      632         .
      633         if buf_sys-ctrl.db-num = 0 then do:
      634           for each buf_db no-lock
      635             where buf_db.db-num > 0
      636           on error undo, return error
      637           :
      638             assign
      639               p-db-list = p-db-list + chr(1) + string( buf_db.db-num )
      640             .
      641           end.
      642           assign
      643             p-db-list = left-trim( p-db-list, chr(1) )
      644           .
      645         end.
      646         else do:
      647           assign
      648             p-db-list = "0":U
      649           .
      650         end.
      651       end.
      652       define variable observupdObj as class observupd no-undo.
      653       if g#db-num = 0
      654       then do:
      655         observupdObj = new observupd ().
      656         observupdObj:dbexcept(input-output p-db-list, input p-tbl-name).
      657         delete object observupdObj no-error.
      658         if p-db-list = "NULL"
      659           then return.
      660       end.
      661       run nws/cr-route.p
      662         ( input 'send-cmd':U
      663          ,input "command":U + chr(1) + "delete":U + chr(1) + v-key-rec
      664          ,input ?
      665          ,input p-db-list
      666         ) no-error .
      667       if error-status :error then do:
      668         return error substitute( "&1. Ошибка при маршрутизации команды на удаление записи &2. &3&4&3&5"
      669                                 ,vss-workfile
      670                                 ,v-key-rec
      671                                 ,chr(10)
      672                                 ,return-value
      673                                 ,error-status :get-message ( error-status :num-messages )
      674                               ).
      675       end.
      676     end.
      677   end.
