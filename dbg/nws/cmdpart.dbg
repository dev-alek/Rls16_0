        1   block-level on error undo, throw.
        2   define input  parameter p-imp-handle as handle    no-undo .
        3   define input  parameter p-counter  as integer   no-undo .
        4   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        5   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        6   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile: cmdpart.p $":U .
        8   define variable vss-archive     as character no-undo init "$Archive: nws/cmdpart.p $":U .
        9   define variable vss-description as character no-undo init "Распределённая проверка целостности остатков по товару".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28       assign
       29         p-vss-parameters = substitute('&1|&2|&3':u,p-counter)
       30       .
       31   end procedure.
       32   define new global shared variable g#vssrevis-logger as handle    no-undo .
       33   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       34   define variable v-vssrevis-logger                   as handle    no-undo .
       35   procedure vss-logevent :
       36     define input  parameter p-extra-paramters as character no-undo .
       37     define variable v-vssrevis-parameters as character no-undo .
       38     do
       39     on error undo, return error return-value
       40     :
       41       if  valid-handle(v-vssrevis-logger)
       42       and v-vssrevis-logger :get-signature("logevent") <> ""
       43       then do:
       44         run vss-get-parameters in this-procedure
       45           (output v-vssrevis-parameters
       46           ).
       47         run logevent in v-vssrevis-logger
       48           (input vss-workfile
       49           ,input vss-revision
       50           ,input v-vssrevis-parameters
       51           ,input p-extra-paramters
       52           ).
       53       end.
       54     end.
       55   end procedure.
       56   assign
       57     v-vssrevis-logger = g#vssrevis-logger
       58   .
       59   if  valid-handle(v-vssrevis-logger)
       60   and v-vssrevis-logger :get-signature("logevent") <> ""
       61   then do:
       62     assign
       63       v-vssrevis-logevent = true
       64     .
       65     run vss-logevent in this-procedure (input vss-description) .
       66   end.
       67   define new global shared variable g#language as character no-undo .
       68   if g#language <> '' and g#language <> 'rus':U then do:
       69     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       70   end.
       71   define new global shared variable g#library  as handle no-undo .
       72   define new global shared variable g#library2 as handle no-undo .
       73   define   shared variable g#auto as logical no-undo.
       74   define   shared variable g#news as logical no-undo.
       75   define   shared variable g#oxml as logical no-undo.
       76   define   shared variable g#esys as logical no-undo.
       77   define   shared variable g#news-source-db as integer no-undo.
       78   define   shared variable g#esys-source-esys as integer no-undo.
       79   define   shared variable g#db-num as integer   no-undo .
       80   define   shared variable g#userid as character no-undo .
       81   define   shared variable g#passwd as character no-undo .
       82   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       83   define variable v-waitfram-action01         as character   no-undo .
       84   define variable v-waitfram-action02         as character   no-undo .
       85   define variable v-waitfram-action03         as character   no-undo .
       86   define variable mWaitFramTextBeg            as character   no-undo.
       87   define variable mWaitFramTextEnd            as character   no-undo.
       88   define variable mWaitFramView               as logical     no-undo.
       89   define variable mWaitProcEvent              as logical     no-undo init yes.
       90   define variable mWaitFramInterval           as integer     no-undo init 1 .
       91   define variable mWaitFramStop               as logical     no-undo.
       92   define variable mWaitFramStopUser           as logical     no-undo.
       93   define variable mWaitFramStopTimeOut        as logical     no-undo.
       94   define variable mWaitFramStartProc          as datetime-tz no-undo.
       95   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       96   define button B-WaitFramStop auto-end-key
       97        label "Стоп"
       98        size 10 by 1 tooltip "Остоновить процесс".
       99   define button B-viewProcInfo
      100        label "Информация"
      101        size 15 by 1 tooltip "Информация о процесс".
      102   define frame waitfram
      103     v-waitfram-action01 format "x(72)" no-label skip
      104     v-waitfram-action02 format "x(72)" no-label skip
      105     v-waitfram-action03 format "x(72)" no-label skip
      106     B-viewProcInfo
      107     B-WaitFramStop at row 4 col 30
      108     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      109     .
      110   define new global shared variable mBatchMode as logical no-undo init ?.
      111   define variable mFramBachModHandle as handle no-undo.
      112   mFramBachModHandle = frame waitfram:handle.
      113   define variable mFameOldVis as logical no-undo.
      114   define variable mVisCUrentVin as logical no-undo.
      115   if session:batch-mode
      116   then
      117      mBatchMode = yes.
      118   if mBatchMode = ? then do:
      119     mVisCUrentVin = current-window:visible.
      120     mFameOldVis = mFramBachModHandle:visible.
      121     mFramBachModHandle:visible  = yes.
      122     mBatchMode = mFramBachModHandle:visible ne yes.
      123     mFramBachModHandle:visible = mFameOldVis.
      124     current-window:visible = mVisCUrentVin.
      125   end.
      126    if  log-manager:logfile-name ne ?
      127     then DO:
      128         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      129         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      130         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      131     end.
      132   on choose of B-WaitFramStop in frame waitfram
      133   do:
      134     mWaitFramStop = yes.
      135     mWaitFramStopUser = yes.
      136   end.
      137   function waitfram-check-timeout returns logical():
      138      define variable vtime as int64 no-undo.
      139      if mWaitFramStopTimeOut
      140      then
      141         return yes.
      142      vtime = ( now - mWaitFramStartProc ) / 1000 .
      143      if     mWaitFramTimeOut ne ?
      144         and mWaitFramTimeOut ne 0
      145         and mWaitFramTimeOut lt vtime
      146      then do:
      147         mWaitFramStopTimeOut = yes.
      148      end.
      149      return mWaitFramStopTimeOut.
      150   end.
      151   procedure waitfram-hide :
      152     if not session:batch-mode
      153     then do
      154     on error undo, return error return-value
      155     :
      156       pause 0 before-hide .
      157       if not mBatchMode then
      158         hide frame waitfram .
      159     if     not mWaitFramView
      160        and mWaitProcEvent
      161     then
      162       process events .
      163     end.
      164   end procedure.
      165   procedure waitfram-show :
      166     define input  parameter p-message as character no-undo .
      167     define variable v-left-margin as integer   no-undo .
      168     if not session:batch-mode
      169     then do
      170     on error undo, return error return-value
      171     :
      172       if length(p-message) <= 70 then do:
      173         assign
      174           v-left-margin = integer((70 - length(p-message)) / 2)
      175         .
      176         assign
      177           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      178         .
      179         assign
      180           v-waitfram-action01 = " "
      181           v-waitfram-action02 = " "
      182                                    + fill(" ", v-left-margin)
      183                                    + p-message
      184           v-waitfram-action03 = " "
      185         .
      186       end.
      187       else do:
      188         define variable vRindex1 as integer no-undo.
      189         define variable vRindex2 as integer no-undo.
      190         vRindex1 = r-index(p-message," ",70).
      191         if vRindex1 = 0
      192         then
      193            vRindex1 = 70.
      194         if length(p-message)  <= vRindex1 + 70 then do:
      195           assign
      196             v-waitfram-action01 = " "
      197             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      198             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      199           .
      200         end.
      201         else do:
      202           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      203           if vRindex2 <= vRindex1
      204           then
      205              vRindex2 = vRindex1 + 70.
      206           assign
      207             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      208             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      209             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      210           .
      211         end.
      212       end.
      213       B-viewProcInfo:visible   in frame waitfram = no.
      214       B-viewProcInfo:sensitive in frame waitfram = no.
      215       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      216       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      217       if  (   mWaitFramView
      218          or  mWaitProcEvent)
      219          and not mBatchMode
      220       then
      221          display
      222             v-waitfram-action01 skip
      223             v-waitfram-action02 skip
      224             v-waitfram-action03 skip
      225          with frame waitfram .
      226       if     mWaitFramView
      227          then do:
      228             if     mWaitFramInterval ne ?
      229                and not mBatchMode
      230             then
      231                wait-for go of frame waitfram pause mWaitFramInterval.
      232          end.
      233          else
      234             if     mWaitProcEvent
      235                and not mBatchMode
      236             then
      237                process events .
      238     end.
      239   end procedure.
      240      procedure waitfram-show-this:
      241         define input  parameter iInterval as int64 no-undo.
      242         define variable vtime as int64 no-undo.
      243         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      244         mWaitFramInterval = iInterval.
      245         run waitfram-show (substitute("&1&2 &3&4" ,
      246                                       mWaitFramTextBeg ,
      247                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      248                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      249                                       mWaitFramTextEnd
      250                                      )
      251                           ).
      252      end.
      253      procedure WaitFramRunPause:
      254         define input  parameter iInterval as dec no-undo.
      255         define variable vStart  as datetime-tz no-undo.
      256         define variable vend    as datetime-tz no-undo.
      257         define variable vint as int64 no-undo.
      258         define variable vOk as logical no-undo.
      259         vStart = now.
      260         vend   = vStart.
      261         publish "WaitFramPause" (iInterval,output vOk).
      262         vend   =  now.
      263         vint = vend - vStart.
      264         vint = iInterval - vint / 1000.
      265         if     not mWaitFramStop
      266            and (   vint > 0
      267                 or (    not vOk
      268                     and iInterval eq ?
      269                     )
      270                 )
      271         then
      272            run waitfram-show-this (iInterval).
      273         vend   =  now.
      274         vint = vend - vStart.
      275         vint = iInterval - vint / 1000.
      276         if     not mWaitFramStop
      277            and vint > 0
      278         then do:
      279            run gbl/pause.p (vint * 1000).
      280         end.
      281         if iInterval ne ?
      282         then
      283            publish "WaitFramStop".
      284         waitfram-check-timeout().
      285      end.
      286      procedure WaitFramWaitFor:
      287         define input  parameter iInterval as dec no-undo.
      288         assign
      289            mWaitFramStartProc   = now
      290            mWaitFramStopUser    = no
      291            mWaitFramStopTimeOut = no
      292         .
      293         block-wait:
      294         do while not mWaitFramStop:
      295            run WaitFramRunPause (iInterval).
      296            if  waitfram-check-timeout()
      297            then do:
      298               leave block-wait.
      299            end.
      300         end.
      301         run waitfram-hide.
      302      end.
      303   procedure waitfram-join :
      304     define input  parameter p-line-1  as character no-undo .
      305     define input  parameter p-line-2  as character no-undo .
      306     define input  parameter p-line-3  as character no-undo .
      307     define output parameter p-message as character no-undo .
      308     do
      309     on error undo, return error return-value
      310     :
      311       assign
      312         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      313                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      314                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      315       .
      316     end.
      317   end procedure.
      318   function waitfram-join-function returns character
      319     (input p-line-1 as character
      320     ,input p-line-2 as character
      321     ,input p-line-3 as character
      322     ).
      323     define variable v-message as character no-undo .
      324     run waitfram-join in this-procedure
      325       (input  p-line-1
      326       ,input  p-line-2
      327       ,input  p-line-3
      328       ,output v-message
      329       ) .
      330     return v-message .
      331   end function .
      332   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      333   procedure cur-time :
      334      define output parameter p-today as date      no-undo .
      335      define output parameter p-time  as integer   no-undo .
      336     do
      337     on error undo, return error
      338     :
      339       define variable v-date1 as date      no-undo .
      340       define variable v-date2 as date      no-undo .
      341       define variable v-time  as integer   no-undo .
      342       assign
      343         v-date1 = today
      344         v-time  = time
      345         v-date2 = today
      346       .
      347       if v-date1 <> v-date2
      348       then do:
      349         assign
      350           v-date1 = today
      351           v-time  = v-time
      352         .
      353       end.
      354       assign
      355         p-today = v-date1
      356         p-time  = v-time
      357       .
      358     end.
      359   end.
      360   function cur-time-date returns character
      361   :
      362     return string(today, '99/99/9999':U) .
      363   end.
      364   function cur-time-mjd returns decimal
      365   :
      366     define variable v-date as date      no-undo .
      367     define variable v-time as integer   no-undo .
      368     run cur-time in this-procedure
      369       (output v-date
      370       ,output v-time
      371       ) .
      372     return integer(v-date) - 2400002 + (v-time / 86400) .
      373   end.
      374   function cur-time-get-ending-index returns integer
      375   (input p-number as integer
      376   )
      377   :
      378     if p-number < 0
      379     or p-number = ?
      380     then do:
      381       return 1 .
      382     end.
      383     define variable v-rest as integer   no-undo .
      384     assign
      385       p-number = p-number modulo 100
      386     .
      387     if p-number < 20
      388     then do:
      389       assign
      390         v-rest = p-number
      391       .
      392     end.
      393     else do:
      394       assign
      395         v-rest = p-number modulo 10
      396       .
      397     end.
      398     case v-rest :
      399       when 1
      400       then do:
      401         return 2 .
      402       end.
      403       when 2 or
      404       when 3 or
      405       when 4
      406       then do:
      407         return 3 .
      408       end.
      409       otherwise do:
      410         return 1 .
      411       end.
      412     end case .
      413   end.
      414   procedure cur-time-mjd-to-date :
      415      define input  parameter i-mjd-diff as decimal no-undo.
      416      define output parameter o-Date     as date    no-undo.
      417      define output parameter o-Time     as integer no-undo.
      418      define variable v-day-number as integer   no-undo .
      419      if    i-mjd-diff < 0
      420         or i-mjd-diff = ?
      421      then do:
      422         return "?" .
      423      end.
      424      assign
      425         v-day-number = truncate(i-mjd-diff,0).
      426         o-Date = date(v-day-number + 2400002).
      427         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      428     .
      429   end.
      430   function cur-time-mjd-to-string returns character
      431   (input p-mjd-diff as decimal
      432   )
      433   :
      434     define variable v-day-number as integer   no-undo .
      435     define variable v-seconds    as integer   no-undo .
      436     define variable v-hour       as integer   no-undo .
      437     define variable v-min        as integer   no-undo .
      438     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      439     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      440     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      441     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      442     if p-mjd-diff < 0
      443     or p-mjd-diff = ?
      444     then do:
      445       return "?" .
      446     end.
      447     assign
      448       v-day-number = integer(truncate(p-mjd-diff,0))
      449       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      450     .
      451     if v-seconds > 86400
      452     then do:
      453       assign
      454         v-seconds = 86400 - 1
      455       .
      456     end.
      457     if v-seconds < 0
      458     then do:
      459       assign
      460         v-seconds = 0
      461       .
      462     end.
      463     assign
      464       v-hour = truncate(v-seconds / 3600, 0)
      465     .
      466     assign
      467       v-seconds = v-seconds modulo 3600
      468     .
      469     assign
      470       v-min = truncate(v-seconds / 60, 0)
      471     .
      472     assign
      473       v-seconds = v-seconds modulo 60
      474     .
      475     return
      476         (if v-day-number <> 0
      477           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      478           else ""
      479         )
      480       + (if v-day-number <> 0 or v-hour <> 0
      481           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      482           else ""
      483         )
      484       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      485           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      486           else ""
      487         )
      488       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      489       .
      490   end.
      491   function cur-time-string returns character
      492   :
      493     define variable v-date as date      no-undo .
      494     define variable v-time as integer   no-undo .
      495     run cur-time in this-procedure
      496       (output v-date
      497       ,output v-time
      498       ) .
      499     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      500   end.
      501   function cur-time-string-sec returns character
      502   :
      503     define variable v-date as date      no-undo .
      504     define variable v-time as integer   no-undo .
      505     run cur-time in this-procedure
      506       (output v-date
      507       ,output v-time
      508       ) .
      509     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      510   end.
      511   function cur-time-custom  returns character
      512   (input p-prefix as character
      513   ,input p-date-format as character
      514   ,input p-delimiter as character
      515   ,input p-time-format as character
      516   ,input p-suffix as character
      517   )
      518   :
      519     define variable v-date as date      no-undo .
      520     define variable v-time as integer   no-undo .
      521     run cur-time in this-procedure
      522       (output v-date
      523       ,output v-time
      524       ) .
      525     return
      526       p-prefix
      527       + string(v-date, p-date-format)
      528       + p-delimiter
      529       + string(v-time, p-time-format)
      530       + p-suffix
      531       .
      532   end.
      533   function cur-time-print  returns character
      534   :
      535     define variable v-date as date      no-undo .
      536     define variable v-time as integer   no-undo .
      537     run cur-time in this-procedure
      538       (output v-date
      539       ,output v-time
      540       ) .
      541     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      542   end.
      543   function cur-time-datetime returns datetime
      544   :
      545     define variable v-char as character no-undo .
      546     define variable v-datetime as datetime no-undo .
      547     v-char = cur-time-string().
      548     v-datetime = datetime(v-char).
      549     return  v-datetime.
      550   end.
      551   function cur-time-string-msec returns character
      552   :
      553     define variable v-date as datetime  no-undo .
      554     v-date = now.
      555     return string(v-date) .
      556   end.
      557   define temp-table temp-gds-obj no-undo like ub.gds-obj .
      558   define temp-table temp-parts   no-undo like ub.parts .
      559   define variable counter    as integer   no-undo .
      560   define variable rec-full   as character no-undo .
      561   define variable v-rec-name as character no-undo .
      562   define variable v-today    as date      no-undo .
      563   define variable v-time     as integer   no-undo .
      564   define buffer buf_temp-gds-obj     for temp-gds-obj .
      565   define buffer buf_temp-parts       for temp-parts .
      566   define buffer buf_gds-obj          for ub.gds-obj .
      567   define buffer buf_parts            for ub.parts .
      568   do
      569   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      570   on stop   undo, return error substitute( "&1. stop", vss-workfile )
      571   on endkey undo, return error substitute( "&1. endkey", vss-workfile )
      572   :
      573     do counter = 1 to p-counter
      574     on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      575     on stop   undo, return error substitute( "&1. stop", vss-workfile )
      576     on endkey undo, return error substitute( "&1. endkey", vss-workfile )
      577     :
      578       if counter modulo 10 = 0
      579       then do:
      580         run waitfram-show in this-procedure
      581           (input substitute("Получение команды на разбиение партий. Получено записей &1", counter)
      582           ) .
      583       end.
      584       run nws-imps in p-imp-handle
      585         ( input-output counter
      586          ,output       rec-full
      587         ) no-error.
      588       if error-status :error then do:
      589         return error return-value .
      590       end.
      591       assign
      592         v-rec-name = entry( 1, rec-full, chr(1) )
      593       .
      594       CASE entry(1, v-rec-name, chr(4)) :
      595         when 'gds-obj':U
      596         then do:
      597           create buf_temp-gds-obj .
      598           run nws-impl in p-imp-handle
      599             ( input 'gds-obj':U
      600              ,input (buffer buf_temp-gds-obj:handle)
      601             ) no-error.
      602           if error-status :error then do:
      603             return error return-value .
      604           end.
      605         end.
      606         when 'parts':U
      607         then do:
      608           create buf_temp-parts .
      609           run nws-impl in p-imp-handle
      610             ( input 'parts':U
      611               ,input (buffer buf_temp-parts:handle)
      612             ) no-error.
      613           if error-status :error then do:
      614             return error return-value .
      615           end.
      616         end.
      617         otherwise do:
      618           message
      619             vss-workfile vss-revision vss-description skip
      620             "Не предусмотрен прием таблицы " v-rec-name skip
      621             "в составе команды" 'cmd-parts-split':U skip
      622             view-as alert-box error .
      623           return error .
      624         end.
      625       end case.
      626     end.
      627     run waitfram-hide .
      628     find first buf_temp-gds-obj
      629       no-error .
      630     if not available buf_temp-gds-obj
      631     then do:
      632       undo, return error substitute( "&2&1В пакете отсутствует запись gds-obj.&1"
      633                             , chr(10)
      634                             , vss-workfile
      635                             ) .
      636     end.
      637     find first buf_gds-obj
      638       where buf_gds-obj.obj-type  = buf_temp-gds-obj.obj-type
      639         and buf_gds-obj.obj-code  = buf_temp-gds-obj.obj-code
      640         and buf_gds-obj.artic     = buf_temp-gds-obj.artic
      641         and buf_gds-obj.prod-type = buf_temp-gds-obj.prod-type
      642         and buf_gds-obj.prod-code = buf_temp-gds-obj.prod-code
      643       no-error .
      644     if not available buf_gds-obj
      645     then do:
      646       undo, return error substitute( "&2&1На объекте не найдена запись gds-obj.&1Объект &3 &4 Артикул &5 &6 &7"
      647               ,chr(10)
      648               ,vss-workfile
      649               ,buf_temp-gds-obj.obj-type
      650               ,buf_temp-gds-obj.obj-code
      651               ,buf_temp-gds-obj.artic
      652               ,buf_temp-gds-obj.prod-type
      653               ,buf_temp-gds-obj.prod-code
      654                ) .
      655     end.
      656   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      657   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdscheck in g#library
      658     (input buf_gds-obj.obj-type
      659     ,input buf_gds-obj.obj-code
      660     ,input buf_gds-obj.artic
      661     ,input buf_gds-obj.prod-type
      662     ,input buf_gds-obj.prod-code
      663     ,input ?
      664     ,input ''
      665     ) no-error .
      666     if error-status :error
      667     then do:
      668       undo, return error substitute( "&2&1Ошибка при проверке целостности товара на объекте&1Объект &3 &4 Артикул &5 &6 &7&1&8 &9"
      669               ,chr(10)
      670               ,vss-workfile
      671               ,buf_temp-gds-obj.obj-type
      672               ,buf_temp-gds-obj.obj-code
      673               ,buf_temp-gds-obj.artic
      674               ,buf_temp-gds-obj.prod-type
      675               ,buf_temp-gds-obj.prod-code
      676               ,return-value
      677               ,error-status :get-message(1)
      678                ) .
      679     end.
      680     for each buf_temp-parts
      681       where buf_temp-parts.obj-type  = buf_temp-gds-obj.obj-type
      682         and buf_temp-parts.obj-code  = buf_temp-gds-obj.obj-code
      683         and buf_temp-parts.artic     = buf_temp-gds-obj.artic
      684         and buf_temp-parts.prod-type = buf_temp-gds-obj.prod-type
      685         and buf_temp-parts.prod-code = buf_temp-gds-obj.prod-code
      686     on error undo, return error return-value
      687     :
      688       find first buf_parts exclusive-lock
      689         where buf_parts.obj-type  = buf_temp-parts.obj-type
      690           and buf_parts.obj-code  = buf_temp-parts.obj-code
      691           and buf_parts.artic     = buf_temp-parts.artic
      692           and buf_parts.prod-type = buf_temp-parts.prod-type
      693           and buf_parts.prod-code = buf_temp-parts.prod-code
      694           and buf_parts.in-code   = buf_temp-parts.in-code
      695           and buf_parts.out-code  = buf_temp-parts.out-code
      696           and buf_parts.part-code = buf_temp-parts.part-code
      697         no-error.
      698       if not available buf_parts
      699       then do:
      700         create buf_parts .
      701         buffer-copy buf_temp-parts to buf_parts
      702         assign
      703           buf_parts.qnty      = 0
      704           buf_parts.fact-qnty = 0
      705           buf_parts.real-qnty = 0
      706           buf_parts.cli-qnty  = 0
      707         .
      708       end.
      709       assign
      710         buf_parts.qnty      = buf_parts.qnty      + buf_temp-parts.qnty
      711         buf_parts.fact-qnty = buf_parts.fact-qnty + buf_temp-parts.fact-qnty
      712         buf_parts.cli-qnty  = buf_parts.cli-qnty  + buf_temp-parts.cli-qnty
      713       .
      714       if  buf_parts.qnty      = 0
      715       and buf_parts.fact-qnty = 0
      716       and buf_parts.cli-qnty  = 0
      717       then do:
      718         delete buf_parts .
      719       end.
      720       else do:
      721         if buf_parts.qnty      = 0
      722         or buf_parts.fact-qnty = 0
      723         or buf_parts.cli-qnty  = 0
      724         then do:
      725           undo, return error substitute( "&2&1Ошибка при удалении партии. Объект &3 &4. Артикул &5 &6 &7.&1 В партии имеются количества отличные от нуля &8"
      726                   ,chr(10)
      727                   ,vss-workfile
      728                   ,buf_temp-gds-obj.obj-type
      729                   ,buf_temp-gds-obj.obj-code
      730                   ,buf_temp-gds-obj.artic
      731                   ,buf_temp-gds-obj.prod-type
      732                   ,buf_temp-gds-obj.prod-code
      733                   ,substitute("qnty &1 fact-qnty &2 cli-qnty &3", buf_parts.qnty, buf_parts.fact-qnty, buf_parts.cli-qnty)
      734                   ) .
      735         end.
      736       end.
      737     end.
      738   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      739   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdscheck in g#library
      740     (input buf_gds-obj.obj-type
      741     ,input buf_gds-obj.obj-code
      742     ,input buf_gds-obj.artic
      743     ,input buf_gds-obj.prod-type
      744     ,input buf_gds-obj.prod-code
      745     ,input ?
      746     ,input ''
      747     ) no-error .
      748     if error-status :error
      749     then do:
      750       undo, return error substitute( "&2&1Ошибка при проверке целостности товара после обновления партия на объекте &3 &4 Артикул &5 &6 &7&1&8 &9"
      751               ,chr(10)
      752               ,vss-workfile
      753               ,buf_temp-gds-obj.obj-type
      754               ,buf_temp-gds-obj.obj-code
      755               ,buf_temp-gds-obj.artic
      756               ,buf_temp-gds-obj.prod-type
      757               ,buf_temp-gds-obj.prod-code
      758               ,return-value
      759               ,error-status :get-message(1)
      760                ) .
      761     end.
      762   end.
