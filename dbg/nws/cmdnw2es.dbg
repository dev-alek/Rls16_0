        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter p-parent-handle as handle no-undo .
        4   define input parameter p-log-handle as handle no-undo .
        5   define input parameter p-imp-handle as handle    no-undo .
        6   define input parameter p-esys-id as integer   no-undo .
        7   define input parameter p-db-num-exp as integer   no-undo .
        8   define input parameter p-uniq-gate-rec as character no-undo .
        9   define input parameter p-esys-uniq-gate-rec as character no-undo .
       10   define input parameter p-counter  as integer   no-undo .
       11   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       12   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       13   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       14   define variable vss-workfile    as character no-undo init "$Workfile: cmdnw2es.p $":U .
       15   define variable vss-archive     as character no-undo init "$Archive: nws/cmdnw2es.p $":U .
       16   define variable vss-description as character no-undo init "Обработка команды отсылки настроек машины правил (для объекта TH)".
       17   procedure vss-get-info :
       18     define output parameter p-vss-revision    like vss-revision    no-undo .
       19     define output parameter p-vss-author      like vss-author      no-undo .
       20     define output parameter p-vss-date        like vss-date        no-undo .
       21     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       22     define output parameter p-vss-archive     like vss-archive     no-undo .
       23     define output parameter p-vss-description like vss-description no-undo .
       24     assign
       25       p-vss-revision    = vss-revision
       26       p-vss-author      = vss-author
       27       p-vss-date        = vss-date
       28       p-vss-workfile    = vss-workfile
       29       p-vss-archive     = vss-archive
       30       p-vss-description = vss-description
       31     .
       32   end procedure.
       33   procedure vss-get-parameters :
       34     define output parameter p-vss-parameters as character no-undo .
       35   end procedure.
       36   define new global shared variable g#vssrevis-logger as handle    no-undo .
       37   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       38   define variable v-vssrevis-logger                   as handle    no-undo .
       39   procedure vss-logevent :
       40     define input  parameter p-extra-paramters as character no-undo .
       41     define variable v-vssrevis-parameters as character no-undo .
       42     do
       43     on error undo, return error return-value
       44     :
       45       if  valid-handle(v-vssrevis-logger)
       46       and v-vssrevis-logger :get-signature("logevent") <> ""
       47       then do:
       48         run vss-get-parameters in this-procedure
       49           (output v-vssrevis-parameters
       50           ).
       51         run logevent in v-vssrevis-logger
       52           (input vss-workfile
       53           ,input vss-revision
       54           ,input v-vssrevis-parameters
       55           ,input p-extra-paramters
       56           ).
       57       end.
       58     end.
       59   end procedure.
       60   assign
       61     v-vssrevis-logger = g#vssrevis-logger
       62   .
       63   if  valid-handle(v-vssrevis-logger)
       64   and v-vssrevis-logger :get-signature("logevent") <> ""
       65   then do:
       66     assign
       67       v-vssrevis-logevent = true
       68     .
       69     run vss-logevent in this-procedure (input vss-description) .
       70   end.
       71   define new global shared variable g#language as character no-undo .
       72   if g#language <> '' and g#language <> 'rus':U then do:
       73     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       74   end.
       75   define new global shared variable g#library  as handle no-undo .
       76   define new global shared variable g#library2 as handle no-undo .
       77   define   shared variable g#auto as logical no-undo.
       78   define   shared variable g#news as logical no-undo.
       79   define   shared variable g#oxml as logical no-undo.
       80   define   shared variable g#esys as logical no-undo.
       81   define   shared variable g#news-source-db as integer no-undo.
       82   define   shared variable g#esys-source-esys as integer no-undo.
       83   define   shared variable g#db-num as integer   no-undo .
       84   define   shared variable g#userid as character no-undo .
       85   define   shared variable g#passwd as character no-undo .
       86   def var vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       87   procedure gen-key-rec :
       88     define input  parameter p-tbl-name    as character no-undo.
       89     define input  parameter p-bh_tbl-name as handle    no-undo.
       90     define output parameter p-key-rec     as character no-undo.
       91     do
       92     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
       93     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
       94     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
       95     :
       96       define variable fh               as handle    no-undo .
       97       define variable v-ok             as logical   no-undo .
       98       define variable v-inform         as character no-undo .
       99       define variable v-ind            as integer   no-undo .
      100       define variable v-idx-field-qnty as integer   no-undo .
      101       if p-tbl-name = ?
      102         or p-tbl-name = "":U
      103       then do:
      104         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info0 ).
      105       end.
      106       if not p-bh_tbl-name:available then do:
      107         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info0, p-tbl-name ).
      108       end.
      109       assign
      110         p-key-rec = p-tbl-name
      111         v-inform  = p-bh_tbl-name:index-information(1)
      112         v-ind     = 2
      113       .
      114       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      115       on error undo, return error
      116       :
      117         assign
      118           v-inform = p-bh_tbl-name:index-information( v-ind )
      119           v-ind    = v-ind + 1
      120         .
      121       end.
      122       if v-inform = ?
      123         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      124         or entry( 3, v-inform, ",":U ) <> "1":U
      125       then do:
      126         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info0, p-tbl-name ).
      127       end.
      128       else do:
      129         assign
      130           v-idx-field-qnty = num-entries( v-inform ) - 4
      131         .
      132         if v-idx-field-qnty < 2 then do:
      133           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info0, v-inform, p-tbl-name ).
      134         end.
      135         do v-ind = 1 to v-idx-field-qnty by 2
      136         on error undo, return error
      137         :
      138           assign
      139             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      140             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      141           .
      142         end.
      143       end.
      144       if p-key-rec = ? then do:
      145         assign
      146           p-key-rec = "":U
      147         .
      148         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info0, p-tbl-name ).
      149       end.
      150     end.
      151     return.
      152   end procedure.
      153   procedure gen-where-keyr-tab :
      154     define input  parameter i-tableSerach as character no-undo.
      155     define input  parameter i-tablekey   as character  no-undo.
      156     define input  parameter p-key-rec    as character  no-undo.
      157     define input  parameter p-key-handle as handle     no-undo .
      158     define input  parameter p-db-name    as character  no-undo .
      159     define input  parameter p-tt-handle  as handle     no-undo .
      160     define output parameter o-Where      as character  no-undo.
      161     do
      162     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      163     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      164     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      165     :
      166       define variable v-full-tbl-name  as character no-undo .
      167       define variable bh_tbl-name      as handle    no-undo .
      168       define variable fh_key           as handle    no-undo .
      169       define variable fh_search        as handle    no-undo .
      170       define variable v-field-num      as integer   no-undo .
      171       define variable v-count-fld      as integer   no-undo .
      172       define variable v-inform         as character no-undo .
      173       define variable v-ind            as integer   no-undo .
      174       define variable v-idx-field-qnty as integer   no-undo .
      175       define variable v-field-name     as character no-undo .
      176       define variable v-field-val      as character no-undo .
      177       define variable v-word-link      as character no-undo .
      178       define variable vTable           as character no-undo.
      179       define variable bh_tbl-key       as handle    no-undo .
      180       assign
      181         p-key-rec = trim( p-key-rec )
      182       .
      183       if p-key-handle <> ? then do:
      184         if not valid-handle(p-key-handle)
      185            or p-key-handle:type <> "buffer"
      186         then do:
      187           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info0 ).
      188         end.
      189         if num-entries( p-key-rec, chr(3) ) > 1
      190           or p-key-rec = ?
      191           or p-key-rec = "":U
      192         then do:
      193           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info0, p-key-rec ).
      194         end.
      195       end.
      196       else do:
      197         if p-key-rec = ?
      198           or p-key-rec = "":U
      199         then do:
      200           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info0 ).
      201         end.
      202       end.
      203       assign
      204         vTable = entry( 1 , p-key-rec, chr(3) )
      205       .
      206       if p-tt-handle <> ?
      207         and ( not valid-handle(p-tt-handle)
      208               or p-tt-handle:type <> "buffer"
      209             )
      210       then do:
      211         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info0, vTable, chr(10) ).
      212       end.
      213       if p-tt-handle = ? then do:
      214         assign
      215           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      216         .
      217         create buffer bh_tbl-name for table v-full-tbl-name .
      218       end.
      219       else do:
      220         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      221       end.
      222       assign
      223         v-inform = bh_tbl-name:index-information(1)
      224         v-ind    = 2
      225       .
      226       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      227       on error undo, return error
      228       :
      229         assign
      230           v-inform = bh_tbl-name:index-information( v-ind )
      231           v-ind    = v-ind + 1
      232         .
      233       end.
      234       if v-inform = ?
      235         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      236         or entry( 3, v-inform, ",":U ) <> "1":U
      237       then do:
      238         delete object bh_tbl-name no-error.
      239         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info0, vTable ).
      240       end.
      241       assign
      242         v-idx-field-qnty = num-entries( v-inform ) - 4
      243       .
      244       if v-idx-field-qnty < 2 then do:
      245         delete object bh_tbl-name no-error.
      246         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info0, v-inform, vTable ).
      247       end.
      248       assign
      249         o-where     = "where":U
      250         v-word-link = "":U
      251         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      252         v-count-fld = 0
      253       .
      254       if i-tablekey ne "" and i-tablekey ne ?
      255       then do:
      256         assign
      257           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      258         .
      259         create buffer bh_tbl-key for table v-full-tbl-name .
      260       end.
      261       if i-tableSerach ne "" and i-tableSerach ne ?
      262       then do:
      263         delete object bh_tbl-name no-error.
      264         assign
      265           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      266         .
      267         create buffer bh_tbl-name for table v-full-tbl-name .
      268       end.
      269       block_where:
      270       do v-ind = 1 to v-idx-field-qnty by 2
      271       on error undo, return error
      272       :
      273         assign
      274           v-count-fld = v-count-fld + 1
      275         .
      276         if p-key-handle = ?
      277           and v-count-fld > v-field-num
      278         then do:
      279           leave block_where.
      280         end.
      281         define variable VfieldKeyTable as handle no-undo.
      282         assign
      283           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      284           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      285         .
      286         if     bh_tbl-key ne ?
      287         then do:
      288            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      289            if VfieldKeyTable eq ?
      290            then next block_where.
      291         end.
      292         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      293         then
      294            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      295         else
      296            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      297         if p-key-handle = ? then do:
      298           assign
      299             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      300           .
      301         end.
      302         else do:
      303           assign
      304             fh_key = p-key-handle:buffer-field( v-field-name )
      305           .
      306           if fh_key = ?
      307             or not valid-handle( fh_key )
      308           then do:
      309             delete object bh_tbl-name.
      310             if     bh_tbl-key ne ?
      311             then
      312                delete object bh_tbl-key.
      313             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info0, p-key-handle:name, v-field-name ).
      314           end.
      315           assign
      316             v-field-val = fh_key:buffer-value
      317           .
      318         end.
      319         if fh_search:data-type ="character":U then do:
      320           assign
      321             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      322             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      323             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      324             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      325             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      326             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      327             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      328             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      329             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      330             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      331             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      332             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      333             v-field-val = substitute( '"&1"', v-field-val )
      334           .
      335         end.
      336         assign
      337           o-where = substitute( "&1 &2", o-where, v-field-val )
      338         .
      339         if v-word-link = "":U then do:
      340           assign
      341             v-word-link = "and":U
      342           .
      343         end.
      344       end.
      345       delete object bh_tbl-name.
      346       if     bh_tbl-key ne ?
      347       then
      348          delete object bh_tbl-key.
      349       if p-key-handle = ?
      350         and v-count-fld <> v-field-num
      351       then do:
      352         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info0, vTable ).
      353       end.
      354     end.
      355   end procedure.
      356   procedure gen-hn-keyr-tab :
      357     define input  parameter i-tableSerach as character no-undo.
      358     define input  parameter i-tablekey   as character no-undo.
      359     define input  parameter p-key-rec    as character no-undo.
      360     define input  parameter p-key-handle as handle    no-undo .
      361     define input  parameter p-db-name    as character no-undo .
      362     define input  parameter p-tt-handle  as handle    no-undo .
      363     define input  parameter p-stts-lock  as integer   no-undo .
      364     define output parameter o-hn         as handle    no-undo.
      365     define variable v-full-tbl-name as character no-undo.
      366     define variable v-where         as character no-undo.
      367     define variable bh_tbl-name     as handle    no-undo.
      368     define variable vTable          as character no-undo.
      369     do
      370     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      371     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      372     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      373         run gen-where-keyr-tab(i-tableSerach,
      374                                i-tablekey,
      375                                p-key-rec,
      376                                p-key-handle,
      377                                p-db-name,
      378                                p-tt-handle,
      379                                output v-where).
      380         if i-tableSerach ne "" and i-tableSerach ne ?
      381         then do:
      382            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      383            create buffer bh_tbl-name for table v-full-tbl-name .
      384         end.
      385         else do:
      386            if p-tt-handle = ? then do:
      387               assign
      388                  vTable = entry( 1 , p-key-rec, chr(3) )
      389               .
      390               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      391               create buffer bh_tbl-name for table v-full-tbl-name .
      392            end.
      393            else do:
      394               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      395            end.
      396         end.
      397         if p-tt-handle = ? then do:
      398            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      399         end.
      400         else do:
      401            bh_tbl-name:find-first( v-where ) no-error .
      402         end.
      403         o-hn = bh_tbl-name.
      404      end.
      405   end procedure.
      406   procedure gen-hn-keyr :
      407     define input  parameter p-key-rec    as character no-undo.
      408     define input  parameter p-key-handle as handle    no-undo .
      409     define input  parameter p-db-name    as character no-undo .
      410     define input  parameter p-tt-handle  as handle    no-undo .
      411     define input  parameter p-stts-lock  as integer   no-undo .
      412     define output parameter o-hn         as handle    no-undo.
      413     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      414   end.
      415   procedure gen-row-keyr :
      416     define input  parameter p-key-rec    as character no-undo.
      417     define input  parameter p-key-handle as handle    no-undo .
      418     define input  parameter p-db-name    as character no-undo .
      419     define input  parameter p-tt-handle  as handle    no-undo .
      420     define input  parameter p-stts-lock  as integer   no-undo .
      421     define output parameter p-tbl-row    as rowid     no-undo.
      422     define output parameter p-tbl-name   as character no-undo.
      423     define variable vHn as handle no-undo.
      424       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      425       p-tbl-row = if vHn:available then vHn:rowid else ?.
      426       p-tbl-name =  vHn:table.
      427       delete object vHn no-error.
      428     if p-tbl-row = ? then do:
      429       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info0, p-tbl-name, p-key-rec ).
      430     end.
      431     else do:
      432       return.
      433     end.
      434   end procedure.
      435   procedure gen-key-fv :
      436     define input  parameter p-key-rec    as character no-undo .
      437     define output parameter p-field-list as character no-undo .
      438     define output parameter p-value-list as character no-undo.
      439     do
      440     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      441     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      442     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      443     :
      444       define variable v-full-tbl-name  as character no-undo .
      445       define variable bh_tbl-name      as handle    no-undo .
      446       define variable v-tbl-name       as character no-undo .
      447       define variable v-field-num      as integer   no-undo .
      448       define variable v-count-fld      as integer   no-undo .
      449       define variable v-inform         as character no-undo .
      450       define variable v-ind            as integer   no-undo .
      451       define variable v-idx-field-qnty as integer   no-undo .
      452       define variable v-delim-key      as character no-undo .
      453       if p-key-rec = ?
      454         or p-key-rec = "":U
      455       then do:
      456         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info0 ).
      457       end.
      458       assign
      459         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      460         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      461       .
      462       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      463       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info0 ).
      464       assign
      465         v-inform = bh_tbl-name:index-information(1)
      466         v-ind    = 2
      467       .
      468       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      469       on error undo, return error
      470       :
      471         assign
      472           v-inform = bh_tbl-name:index-information( v-ind )
      473           v-ind    = v-ind + 1
      474         .
      475       end.
      476       if v-inform = ?
      477         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      478         or entry( 3, v-inform, ",":U ) <> "1":U
      479       then do:
      480         delete object bh_tbl-name no-error.
      481         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info0, v-tbl-name ).
      482       end.
      483       assign
      484         v-idx-field-qnty = num-entries( v-inform ) - 4
      485       .
      486       if v-idx-field-qnty < 2 then do:
      487         delete object bh_tbl-name no-error.
      488         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info0, v-inform, v-tbl-name ).
      489       end.
      490       assign
      491         p-field-list = "":U
      492         p-value-list = "":U
      493         v-delim-key  = "":U
      494         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      495         v-count-fld  = 0
      496       .
      497       block_where:
      498       do v-ind = 1 to v-idx-field-qnty by 2
      499       on error undo, return error
      500       :
      501         assign
      502           v-count-fld = v-count-fld + 1
      503         .
      504         if v-count-fld > v-field-num then do:
      505           leave block_where.
      506         end.
      507         assign
      508           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      509           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      510         .
      511         if v-ind = 1 then do:
      512           assign
      513             v-delim-key = chr(3)
      514           .
      515         end.
      516       end.
      517       delete object bh_tbl-name.
      518       if v-count-fld <> v-field-num then do:
      519         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info0, v-tbl-name ).
      520       end.
      521     end.
      522   end procedure.
      523   procedure gen-key-field :
      524     define input  parameter p-table      as character no-undo .
      525     define output parameter p-field-list as character no-undo .
      526     do
      527     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      528     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      529     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      530     :
      531       define variable v-full-tbl-name  as character no-undo .
      532       define variable bh_tbl-name      as handle    no-undo .
      533       define variable v-tbl-name       as character no-undo .
      534       define variable v-field-num      as integer   no-undo .
      535       define variable v-count-fld      as integer   no-undo .
      536       define variable v-inform         as character no-undo .
      537       define variable v-ind            as integer   no-undo .
      538       define variable v-idx-field-qnty as integer   no-undo .
      539       define variable v-delim-key      as character no-undo .
      540       if p-table = ?
      541         or p-table = "":U
      542       then do:
      543         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info0 ).
      544       end.
      545       assign
      546         v-tbl-name      = p-table
      547         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      548       .
      549       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      550       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info0 ).
      551       assign
      552         v-inform = bh_tbl-name:index-information(1)
      553         v-ind    = 2
      554       .
      555       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      556       on error undo, return error
      557       :
      558         assign
      559           v-inform = bh_tbl-name:index-information( v-ind )
      560           v-ind    = v-ind + 1
      561         .
      562       end.
      563       if v-inform = ?
      564         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      565         or entry( 3, v-inform, ",":U ) <> "1":U
      566       then do:
      567         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info0, v-tbl-name ).
      568       end.
      569       assign
      570         v-idx-field-qnty = num-entries( v-inform ) - 4
      571       .
      572       if v-idx-field-qnty < 2 then do:
      573         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info0, v-inform, v-tbl-name ).
      574       end.
      575       assign
      576         p-field-list = "":U
      577         v-delim-key  = "":U
      578         v-count-fld  = 0
      579       .
      580       block_where:
      581       do v-ind = 1 to v-idx-field-qnty by 2
      582       on error undo, return error
      583       :
      584         assign
      585           v-count-fld = v-count-fld + 1
      586         .
      587         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      588         if v-ind = 1 then do:
      589           assign
      590             v-delim-key = chr(3)
      591           .
      592         end.
      593       end.
      594       delete object bh_tbl-name.
      595     end.
      596   end procedure.
      597   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      598   define variable v-waitfram-action01         as character   no-undo .
      599   define variable v-waitfram-action02         as character   no-undo .
      600   define variable v-waitfram-action03         as character   no-undo .
      601   define variable mWaitFramTextBeg            as character   no-undo.
      602   define variable mWaitFramTextEnd            as character   no-undo.
      603   define variable mWaitFramView               as logical     no-undo.
      604   define variable mWaitProcEvent              as logical     no-undo init yes.
      605   define variable mWaitFramInterval           as integer     no-undo init 1 .
      606   define variable mWaitFramStop               as logical     no-undo.
      607   define variable mWaitFramStopUser           as logical     no-undo.
      608   define variable mWaitFramStopTimeOut        as logical     no-undo.
      609   define variable mWaitFramStartProc          as datetime-tz no-undo.
      610   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      611   define button B-WaitFramStop auto-end-key
      612        label "Стоп"
      613        size 10 by 1 tooltip "Остоновить процесс".
      614   define button B-viewProcInfo
      615        label "Информация"
      616        size 15 by 1 tooltip "Информация о процесс".
      617   define frame waitfram
      618     v-waitfram-action01 format "x(72)" no-label skip
      619     v-waitfram-action02 format "x(72)" no-label skip
      620     v-waitfram-action03 format "x(72)" no-label skip
      621     B-viewProcInfo
      622     B-WaitFramStop at row 4 col 30
      623     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      624     .
      625   define new global shared variable mBatchMode as logical no-undo init ?.
      626   define variable mFramBachModHandle as handle no-undo.
      627   mFramBachModHandle = frame waitfram:handle.
      628   define variable mFameOldVis as logical no-undo.
      629   define variable mVisCUrentVin as logical no-undo.
      630   if session:batch-mode
      631   then
      632      mBatchMode = yes.
      633   if mBatchMode = ? then do:
      634     mVisCUrentVin = current-window:visible.
      635     mFameOldVis = mFramBachModHandle:visible.
      636     mFramBachModHandle:visible  = yes.
      637     mBatchMode = mFramBachModHandle:visible ne yes.
      638     mFramBachModHandle:visible = mFameOldVis.
      639     current-window:visible = mVisCUrentVin.
      640   end.
      641    if  log-manager:logfile-name ne ?
      642     then DO:
      643         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      644         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      645         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      646     end.
      647   on choose of B-WaitFramStop in frame waitfram
      648   do:
      649     mWaitFramStop = yes.
      650     mWaitFramStopUser = yes.
      651   end.
      652   function waitfram-check-timeout returns logical():
      653      define variable vtime as int64 no-undo.
      654      if mWaitFramStopTimeOut
      655      then
      656         return yes.
      657      vtime = ( now - mWaitFramStartProc ) / 1000 .
      658      if     mWaitFramTimeOut ne ?
      659         and mWaitFramTimeOut ne 0
      660         and mWaitFramTimeOut lt vtime
      661      then do:
      662         mWaitFramStopTimeOut = yes.
      663      end.
      664      return mWaitFramStopTimeOut.
      665   end.
      666   procedure waitfram-hide :
      667     if not session:batch-mode
      668     then do
      669     on error undo, return error return-value
      670     :
      671       pause 0 before-hide .
      672       if not mBatchMode then
      673         hide frame waitfram .
      674     if     not mWaitFramView
      675        and mWaitProcEvent
      676     then
      677       process events .
      678     end.
      679   end procedure.
      680   procedure waitfram-show :
      681     define input  parameter p-message as character no-undo .
      682     define variable v-left-margin as integer   no-undo .
      683     if not session:batch-mode
      684     then do
      685     on error undo, return error return-value
      686     :
      687       if length(p-message) <= 70 then do:
      688         assign
      689           v-left-margin = integer((70 - length(p-message)) / 2)
      690         .
      691         assign
      692           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      693         .
      694         assign
      695           v-waitfram-action01 = " "
      696           v-waitfram-action02 = " "
      697                                    + fill(" ", v-left-margin)
      698                                    + p-message
      699           v-waitfram-action03 = " "
      700         .
      701       end.
      702       else do:
      703         define variable vRindex1 as integer no-undo.
      704         define variable vRindex2 as integer no-undo.
      705         vRindex1 = r-index(p-message," ",70).
      706         if vRindex1 = 0
      707         then
      708            vRindex1 = 70.
      709         if length(p-message)  <= vRindex1 + 70 then do:
      710           assign
      711             v-waitfram-action01 = " "
      712             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      713             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      714           .
      715         end.
      716         else do:
      717           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      718           if vRindex2 <= vRindex1
      719           then
      720              vRindex2 = vRindex1 + 70.
      721           assign
      722             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      723             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      724             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      725           .
      726         end.
      727       end.
      728       B-viewProcInfo:visible   in frame waitfram = no.
      729       B-viewProcInfo:sensitive in frame waitfram = no.
      730       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      731       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      732       if  (   mWaitFramView
      733          or  mWaitProcEvent)
      734          and not mBatchMode
      735       then
      736          display
      737             v-waitfram-action01 skip
      738             v-waitfram-action02 skip
      739             v-waitfram-action03 skip
      740          with frame waitfram .
      741       if     mWaitFramView
      742          then do:
      743             if     mWaitFramInterval ne ?
      744                and not mBatchMode
      745             then
      746                wait-for go of frame waitfram pause mWaitFramInterval.
      747          end.
      748          else
      749             if     mWaitProcEvent
      750                and not mBatchMode
      751             then
      752                process events .
      753     end.
      754   end procedure.
      755      procedure waitfram-show-this:
      756         define input  parameter iInterval as int64 no-undo.
      757         define variable vtime as int64 no-undo.
      758         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      759         mWaitFramInterval = iInterval.
      760         run waitfram-show (substitute("&1&2 &3&4" ,
      761                                       mWaitFramTextBeg ,
      762                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      763                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      764                                       mWaitFramTextEnd
      765                                      )
      766                           ).
      767      end.
      768      procedure WaitFramRunPause:
      769         define input  parameter iInterval as dec no-undo.
      770         define variable vStart  as datetime-tz no-undo.
      771         define variable vend    as datetime-tz no-undo.
      772         define variable vint as int64 no-undo.
      773         define variable vOk as logical no-undo.
      774         vStart = now.
      775         vend   = vStart.
      776         publish "WaitFramPause" (iInterval,output vOk).
      777         vend   =  now.
      778         vint = vend - vStart.
      779         vint = iInterval - vint / 1000.
      780         if     not mWaitFramStop
      781            and (   vint > 0
      782                 or (    not vOk
      783                     and iInterval eq ?
      784                     )
      785                 )
      786         then
      787            run waitfram-show-this (iInterval).
      788         vend   =  now.
      789         vint = vend - vStart.
      790         vint = iInterval - vint / 1000.
      791         if     not mWaitFramStop
      792            and vint > 0
      793         then do:
      794            run gbl/pause.p (vint * 1000).
      795         end.
      796         if iInterval ne ?
      797         then
      798            publish "WaitFramStop".
      799         waitfram-check-timeout().
      800      end.
      801      procedure WaitFramWaitFor:
      802         define input  parameter iInterval as dec no-undo.
      803         assign
      804            mWaitFramStartProc   = now
      805            mWaitFramStopUser    = no
      806            mWaitFramStopTimeOut = no
      807         .
      808         block-wait:
      809         do while not mWaitFramStop:
      810            run WaitFramRunPause (iInterval).
      811            if  waitfram-check-timeout()
      812            then do:
      813               leave block-wait.
      814            end.
      815         end.
      816         run waitfram-hide.
      817      end.
      818   procedure waitfram-join :
      819     define input  parameter p-line-1  as character no-undo .
      820     define input  parameter p-line-2  as character no-undo .
      821     define input  parameter p-line-3  as character no-undo .
      822     define output parameter p-message as character no-undo .
      823     do
      824     on error undo, return error return-value
      825     :
      826       assign
      827         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      828                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      829                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      830       .
      831     end.
      832   end procedure.
      833   function waitfram-join-function returns character
      834     (input p-line-1 as character
      835     ,input p-line-2 as character
      836     ,input p-line-3 as character
      837     ).
      838     define variable v-message as character no-undo .
      839     run waitfram-join in this-procedure
      840       (input  p-line-1
      841       ,input  p-line-2
      842       ,input  p-line-3
      843       ,output v-message
      844       ) .
      845     return v-message .
      846   end function .
      847   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      848   function octal-to-char return character
      849   ( p-string as character ) :
      850     def var v-asc     as integer no-undo .
      851     def var v-new-asc as integer no-undo .
      852     def var ind       as integer no-undo .
      853     if length(p-string) <> 3 then do:
      854       return ? .
      855     end.
      856     assign
      857       v-asc = 0
      858     .
      859     do ind = 1 to length(p-string)
      860     :
      861       assign
      862         v-new-asc = asc(substring(p-string, ind, 1)) - asc('0')
      863       .
      864       if v-new-asc < 0 or v-new-asc >= 8 then do:
      865         return ? .
      866       end.
      867       assign
      868         v-asc = v-asc * 8 + v-new-asc
      869       .
      870     end.
      871     return chr(v-asc) .
      872   end function .
      873   function char-to-octal return character
      874   ( p-chr as character ) :
      875     def var v-asc    as integer   no-undo .
      876     def var ind      as integer   no-undo .
      877     def var v-string as character no-undo .
      878     if length(p-chr) <> 1 then do:
      879       return ? .
      880     end.
      881     assign
      882       v-asc    = asc(p-chr)
      883       v-string = ""
      884     .
      885     do ind = 1 to 3
      886     :
      887       assign
      888         v-string = chr( v-asc mod 8 + asc('0')) + v-string
      889       .
      890       assign
      891         v-asc = truncate(v-asc / 8, 0)
      892       .
      893     end.
      894     return v-string .
      895   end.
      896   function str-encode return character
      897   (   p-init-string       as character
      898     , p-encode-char       as character
      899     , p-special-char-list as character
      900   ) :
      901     def var p-encode-string as character no-undo .
      902     def var ind                as integer no-undo .
      903     def var v-num-special-char as integer no-undo .
      904     def var v-special-char     as character no-undo .
      905     if p-encode-char = ?
      906     or p-encode-char = "" then do:
      907       assign
      908         p-encode-char = "~~"
      909       .
      910     end.
      911     if p-init-string = ? then do:
      912       return "?" .
      913     end.
      914     if p-init-string = "?" then do:
      915       return p-encode-char + char-to-octal("?") .
      916     end.
      917     assign
      918       v-num-special-char = length(p-special-char-list)
      919       p-encode-string    = replace(p-init-string
      920                                   ,p-encode-char
      921                                   ,p-encode-char + char-to-octal(p-encode-char)
      922                                   )
      923     .
      924     do ind = 1 to v-num-special-char
      925     :
      926       assign
      927         v-special-char = substring(p-special-char-list, ind, 1)
      928       .
      929       if v-special-char <> p-encode-char then do:
      930         assign
      931           p-encode-string = replace (p-encode-string
      932                                     ,v-special-char
      933                                     ,p-encode-char + char-to-octal(v-special-char)
      934                                     )
      935         .
      936       end.
      937     end.
      938     return p-encode-string .
      939   end.
      940   function str-decode returns character
      941     (p-init-string   as character
      942     ,p-encode-char   as character
      943     ) :
      944     def var p-decode-string as character no-undo .
      945     def var ind                       as integer no-undo .
      946     def var v-num-entries-init-string as integer no-undo .
      947     def var v-sub-phrase              as character no-undo .
      948     def var v-special-char            as character no-undo .
      949     if p-encode-char = ?
      950     or p-encode-char = "" then do:
      951       assign
      952         p-encode-char = "~~"
      953       .
      954     end.
      955     if p-init-string = "?" then do:
      956       return ? .
      957     end.
      958     assign
      959       v-num-entries-init-string = num-entries(p-init-string, p-encode-char)
      960     .
      961     if v-num-entries-init-string > 1 then do:
      962       assign
      963         p-decode-string = entry(1, p-init-string, p-encode-char)
      964       .
      965       do ind = 2 to v-num-entries-init-string
      966       :
      967         assign
      968           v-sub-phrase = entry(ind, p-init-string, p-encode-char)
      969         .
      970         assign
      971           v-special-char = octal-to-char(substring(v-sub-phrase, 1, 3))
      972         .
      973         if v-special-char <> ? then do:
      974           assign
      975             p-decode-string = p-decode-string
      976                             + v-special-char
      977                             + substring(v-sub-phrase, 4)
      978           .
      979         end.
      980         else do:
      981           assign
      982             p-decode-string = p-decode-string
      983                             + p-encode-char
      984                             + v-sub-phrase
      985           .
      986         end.
      987       end.
      988     end.
      989     else do:
      990       assign
      991         p-decode-string = p-init-string
      992       .
      993     end.
      994     return p-decode-string .
      995   end.
      996   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      997   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      998   define variable tempcxml_v-num_ as integer no-undo .
      999   define  temp-table temp-xml-tables no-undo
     1000   field order as integer
     1001   field tbl-name as character
     1002   field tbl-handle_ as handle
     1003   field table-handle_ as handle
     1004   field uniq-gate-rec as character
     1005   field gate-name as character
     1006   field gate-handle_ as handle
     1007   field is-parent as logical
     1008   index pi is unique primary
     1009   uniq-gate-rec
     1010   tbl-name
     1011   index iorder
     1012   order
     1013   index gr
     1014   uniq-gate-rec
     1015   index gh
     1016   gate-handle_
     1017   index iparent
     1018   is-parent
     1019   .
     1020   define  temp-table temp-xml-records no-undo
     1021   field tbl-name as character
     1022   field uniq-key-rec as character
     1023   index pi is unique primary
     1024   tbl-name
     1025   uniq-key-rec
     1026   .
     1027   def var vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1028   procedure get-gate-file-name :
     1029   define input parameter p-gate-rec as character no-undo .
     1030   define output  parameter p-gate-file-name as character no-undo .
     1031   define buffer buf_clob-data for ub.clob-data.
     1032   define variable v-tbl-row as rowid no-undo .
     1033   define variable v-tbl-name as character no-undo .
     1034   run gen-row-keyr in this-procedure ( input p-gate-rec
     1035                                       ,input ?
     1036                                       ,input "ub"
     1037                                       ,input ?
     1038                                       ,input no-lock
     1039                                       ,output v-tbl-row
     1040                                       ,output v-tbl-name) no-error.
     1041   if error-status:error then undo, return error substitute("&1 (get-gate-name) Несуществующий gate &2"
     1042                                                           ,vss-include-info3
     1043                                                           ,p-gate-rec).
     1044   find first buf_clob-data no-lock where
     1045             rowid(buf_clob-data) = v-tbl-row no-error.
     1046   if not available buf_clob-data then do:
     1047     if error-status:error then undo, return error substitute("&1 (get-gate-name) Несуществующий gate &2"
     1048                                                             ,vss-include-info3
     1049                                                             ,p-gate-rec).
     1050   end.
     1051   p-gate-file-name = buf_clob-data.file-name.
     1052   end procedure.
     1053   procedure get-gate-rec :
     1054   define input  parameter p-gate-name as character no-undo .
     1055   define output parameter p-gate-rec as character no-undo .
     1056   define buffer buf_clob-bind for ub.clob-bind.
     1057   define buffer buf_clob-data for ub.clob-data.
     1058   main-block:
     1059   do
     1060   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info3, return-value, chr(10), error-status :get-message (1))
     1061   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info3 )
     1062   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info3 )
     1063   :
     1064       find first buf_clob-bind no-lock where
     1065                 buf_clob-bind.uniq-key-rec = p-gate-name
     1066             and buf_clob-bind.field-name = '':U
     1067             and buf_clob-bind.part-num = 1
     1068             and buf_clob-bind.resource-type = 'gate':U
     1069             no-error.
     1070       if not available buf_clob-bind then do:
     1071         undo, return error substitute("Неверная ссылка на XSD -файл &1 для gate"
     1072                                         , p-gate-name
     1073                                         ).
     1074       end.
     1075       find first buf_clob-data no-lock where
     1076                 buf_clob-data.db-num = buf_clob-bind.db-num
     1077             and buf_clob-data.int64-i= buf_clob-bind.int64-id no-error.
     1078       if not available buf_clob-data then do:
     1079         undo, return error substitute("Не найден CLOB c ДБ &1 id &2 - файл &3"
     1080                                         , buf_clob-bind.db-num
     1081                                         , buf_clob-bind.int64-id
     1082                                         , p-gate-name
     1083                                         ).
     1084       end.
     1085       run gen-key-rec in this-procedure ( input 'clob-data':U
     1086                                 ,input buffer buf_clob-data:handle
     1087                                 ,output p-gate-rec).
     1088   end.
     1089   end procedure.
     1090   procedure get-gate-by-name :
     1091   define input  parameter p-gate-name as character no-undo .
     1092   define output parameter p-gate-rec as character no-undo .
     1093   define output parameter p-dsh as handle no-undo .
     1094   define input-output  parameter p-xmlh as handle no-undo .
     1095   define variable v-ii as integer   no-undo .
     1096   define variable glog as logical   no-undo .
     1097   define variable v-longchar as longchar no-undo .
     1098   define variable v-txmlh as handle no-undo .
     1099   define variable v-db-num as integer no-undo .
     1100   define variable v-int64-id as int64 no-undo .
     1101   define buffer buf_clob-bind for ub.clob-bind.
     1102   define buffer buf_clob-data for ub.clob-data.
     1103   main-block:
     1104   do
     1105   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info3, return-value, chr(10), error-status :get-message (1))
     1106   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info3 )
     1107   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info3 )
     1108   :
     1109       find first buf_clob-bind no-lock where
     1110                 buf_clob-bind.uniq-key-rec = p-gate-name
     1111             and buf_clob-bind.field-name = '':U
     1112             and buf_clob-bind.part-num = 1
     1113             and buf_clob-bind.resource-type = 'gate':U
     1114             no-error.
     1115       if not available buf_clob-bind then do:
     1116         undo, return error substitute("Неверная ссылка на XSD -файл &1 для gate"
     1117                                         , p-gate-name
     1118                                         ).
     1119       end.
     1120       find first buf_clob-data no-lock where
     1121                 buf_clob-data.db-num = buf_clob-bind.db-num
     1122             and buf_clob-data.int64-i= buf_clob-bind.int64-id no-error.
     1123       if not available buf_clob-data then do:
     1124         undo, return error substitute("Не найден CLOB c ДБ &1 id &2 - файл &3"
     1125                                         , buf_clob-bind.db-num
     1126                                         , buf_clob-bind.int64-id
     1127                                         , p-gate-name
     1128                                         ).
     1129       end.
     1130       assign
     1131       v-longchar = buf_clob-data.cdata
     1132       .
     1133       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1134       if error-status :error then do:
     1135         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, buf_clob-data.file-name_, chr(10), error-status:get-message(1) , return-value ).
     1136       end.
     1137       create dataset p-dsh .
     1138       glog = p-dsh:READ-XMLSCHEMA( "LONGCHAR"
     1139                                     , v-longchar
     1140                                     , ?
     1141                                     , ?
     1142                                     , ?
     1143                                     ) no-error.
     1144       v-longchar = '':U.
     1145       if error-status :error
     1146       or not glog
     1147       then do:
     1148         undo, return error substitute("Не удалось прочитать XML-схему &1 из БД:&2&3", p-gate-name, chr(10), error-status:get-message(1) ).
     1149       end.
     1150       if not valid-handle(p-xmlh)
     1151       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     1152         create temp-table v-txmlh.
     1153         v-txmlh:create-like(buffer temp-xml-tables:handle).
     1154         v-txmlh:temp-table-prepare("temp-xml-tables").
     1155         p-xmlh = v-txmlh:default-buffer-handle.
     1156       end.
     1157       run gen-key-rec in this-procedure ( input 'clob-data':U
     1158                                 ,input buffer buf_clob-data:handle
     1159                                 ,output p-gate-rec).
     1160       do v-ii = 1 to p-dsh:num-buffers:
     1161         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     1162         if not p-xmlh:available then do:
     1163           p-xmlh:buffer-create().
     1164           assign
     1165           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     1166           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1167           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1168           p-xmlh::gate-handle_ = p-dsh
     1169           p-xmlh::uniq-gate-rec = p-gate-rec
     1170           p-xmlh::gate-name = p-dsh:name
     1171           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1172           .
     1173           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1174             assign
     1175             p-xmlh::order = -3.
     1176           end.
     1177         end.
     1178       end.
     1179   end.
     1180   end procedure.
     1181   procedure get-gate-by-rec :
     1182   define input  parameter p-gate-rec as character no-undo .
     1183   define output parameter p-dsh as handle no-undo .
     1184   define input-output  parameter p-xmlh as handle no-undo .
     1185   define input-output parameter p-longchar  as longchar no-undo .
     1186   define variable v-ii as integer   no-undo .
     1187   define variable glog as logical   no-undo .
     1188   define variable v-rowid as rowid no-undo .
     1189   define variable v-tbl-name as character no-undo .
     1190   define variable v-longchar as longchar no-undo .
     1191   define variable v-txmlh as handle no-undo .
     1192   define buffer buf_clob-data for ub.clob-data.
     1193   main-block:
     1194   do
     1195   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info3, return-value, chr(10), error-status :get-message (1))
     1196   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info3 )
     1197   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info3 )
     1198   :
     1199     run gen-row-keyr in this-procedure (
     1200                                           input  p-gate-rec
     1201                                           ,input  ?
     1202                                           ,input  "ub"
     1203                                           ,input  ?
     1204                                           ,input  NO-LOCK
     1205                                           ,output v-rowid
     1206                                           ,output v-tbl-name   ) no-error.
     1207       find first buf_clob-data no-lock where
     1208                 rowid(buf_clob-data) = v-rowid  no-error.
     1209       if not available buf_clob-data then do:
     1210         undo, return error substitute("Не найден CLOB  &1"
     1211                                         , p-gate-rec
     1212                                         ).
     1213       end.
     1214       assign
     1215       v-longchar = buf_clob-data.cdata
     1216       .
     1217       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1218       if error-status :error then do:
     1219         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, buf_clob-data.file-name_, chr(10), error-status:get-message(1) , return-value ).
     1220       end.
     1221       create dataset p-dsh .
     1222       glog = p-dsh:READ-XMLSCHEMA( "LONGCHAR"
     1223                                     , v-longchar
     1224                                     , ?
     1225                                     , ?
     1226                                     , ?
     1227                                     ) no-error.
     1228       define variable v-esm as character no-undo .
     1229       v-esm = error-status:get-message(1) .
     1230       if p-longchar <> ? then do:
     1231         p-longchar = v-longchar.
     1232       end.
     1233       v-longchar = '':U.
     1234       if error-status :error
     1235       or not glog
     1236       then do:
     1237         undo, return error substitute("Не удалось прочитать XML-схему &1 (&2) из БД&3&4"
     1238                                      , p-gate-rec
     1239                                      , p-gate-rec
     1240                                      , v-esm
     1241                                      ).
     1242       end.
     1243       p-dsh:private-data = buf_clob-data.file-name_ + chr(4) + p-gate-rec.
     1244       if not valid-handle(p-xmlh)
     1245       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     1246         create temp-table v-txmlh.
     1247         v-txmlh:create-like(buffer temp-xml-tables:handle).
     1248         v-txmlh:temp-table-prepare("temp-xml-tables").
     1249         p-xmlh = v-txmlh:default-buffer-handle.
     1250       end.
     1251       do v-ii = 1 to p-dsh:num-buffers:
     1252         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     1253         if not p-xmlh:available then do:
     1254           p-xmlh:buffer-create().
     1255           assign
     1256           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     1257           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1258           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1259           p-xmlh::gate-handle_ = p-dsh
     1260           p-xmlh::uniq-gate-rec = p-gate-rec
     1261           p-xmlh::gate-name = p-dsh:name
     1262           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1263           .
     1264           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1265             assign
     1266             p-xmlh::order = -3.
     1267           end.
     1268           p-xmlh:buffer-release().
     1269         end.
     1270       end.
     1271   end.
     1272   end procedure.
     1273   procedure get-gate-by-file :
     1274   define input  parameter p-schema-file-name as character no-undo .
     1275   define input  parameter p-gate-rec as character no-undo .
     1276   define output parameter p-dsh as handle no-undo .
     1277   define input-output  parameter p-xmlh as handle no-undo .
     1278   define variable v-ii as integer   no-undo .
     1279   define variable glog as logical   no-undo .
     1280   define variable v-rowid as rowid no-undo .
     1281   define variable v-tbl-name as character no-undo .
     1282   define variable v-longchar as longchar no-undo .
     1283   define variable v-txmlh as handle no-undo .
     1284   main-block:
     1285   do
     1286   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info3, return-value, chr(10), error-status :get-message (1))
     1287   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info3 )
     1288   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info3 )
     1289   :
     1290       COPY-LOB
     1291       FROM  FILE p-schema-file-name
     1292       TO  OBJECT v-longchar
     1293       no-convert
     1294       NO-ERROR .
     1295       if error-status :error then do:
     1296           undo, return error substitute("Не удалось считать файл схемы &1 в память&2&3"
     1297                                     , p-schema-file-name
     1298                                 , chr(10)
     1299                                 , error-status:get-message(1) ).
     1300       end.
     1301       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1302       if error-status :error then do:
     1303         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, p-schema-file-name, chr(10), error-status:get-message(1) , return-value ).
     1304       end.
     1305       create dataset p-dsh .
     1306       glog = p-dsh:READ-XMLSCHEMA( "longchar"
     1307                                     , v-longchar
     1308                                     , ?
     1309                                     , ?
     1310                                     , ?
     1311                                     ) no-error.
     1312       v-longchar = ''.
     1313       if error-status :error
     1314       or not glog
     1315       then do:
     1316         undo, return error substitute("Не удалось прочитать XML-схему из файла &1&2&3"
     1317                                      , p-schema-file-name
     1318                                      ,chr(10)
     1319                                      , error-status:get-message(1)
     1320                                      ).
     1321       end.
     1322       if not valid-handle(p-xmlh)
     1323       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     1324         create temp-table v-txmlh.
     1325         v-txmlh:create-like(buffer temp-xml-tables:handle).
     1326         v-txmlh:temp-table-prepare("temp-xml-tables").
     1327         p-xmlh = v-txmlh:default-buffer-handle.
     1328       end.
     1329       do v-ii = 1 to p-dsh:num-buffers:
     1330         p-xmlh:find-first(substitute(' where tbl-name = "&1" and  uniq-gate-rec = "&2" '
     1331                                      ,p-dsh:get-buffer-handle(v-ii):name
     1332                                      ,p-gate-rec
     1333                                      )) no-error.
     1334         if not p-xmlh:available then do:
     1335           p-xmlh:buffer-create().
     1336           assign
     1337           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):table
     1338           p-xmlh::uniq-gate-rec = p-gate-rec
     1339           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1340           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1341           p-xmlh::gate-handle_ = p-dsh
     1342           p-xmlh::gate-name = p-dsh:name
     1343           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1344           .
     1345           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1346             assign
     1347             p-xmlh::order = -3.
     1348           end.
     1349           p-xmlh:buffer-release().
     1350         end.
     1351       end.
     1352   end.
     1353   end procedure.
     1354   procedure gate-clear :
     1355   define input  parameter p-dsh as handle no-undo .
     1356   define input  parameter p-xmlh as handle no-undo .
     1357   define variable v-dsh as handle no-undo .
     1358   define variable v-th as handle no-undo .
     1359     do
     1360     on error undo, return error return-value
     1361     :
     1362       if valid-handle(p-dsh) then do:
     1363         delete object p-dsh.
     1364         v-dsh = p-dsh.
     1365         p-dsh = ?.
     1366       end.
     1367       repeat while true:
     1368         p-xmlh:find-first( substitute( " where gate-handle_ = &1 ", v-dsh)
     1369                            , share-lock) no-error.
     1370         if p-xmlh:available then do:
     1371           assign
     1372           v-th = p-xmlh:buffer-field("table-handle_"):buffer-value.
     1373           if valid-handle(p-xmlh:buffer-field("table-handle_"))
     1374           and valid-handle(v-th)
     1375           and v-th:dynamic = yes
     1376           then do:
     1377             delete object p-xmlh:buffer-field("table-handle_"):buffer-value.
     1378             p-xmlh:buffer-field("table-handle_"):buffer-value = ?.
     1379           end.
     1380           p-xmlh:buffer-delete().
     1381         end.
     1382         else do:
     1383           leave.
     1384         end.
     1385       end.
     1386       if p-xmlh:dynamic = yes
     1387       and valid-handle(p-xmlh)
     1388       then do:
     1389         delete object p-xmlh:table-handle.
     1390         p-xmlh = ?.
     1391       end.
     1392       v-dsh = ?.
     1393     end.
     1394   end procedure.
     1395   procedure all-gates-clear :
     1396   define parameter buffer buf_temp-xml-tables for temp-xml-tables.
     1397   do
     1398   on error undo, return error
     1399   :
     1400     for each buf_temp-xml-tables
     1401     break
     1402     by buf_temp-xml-tables.uniq-gate-rec
     1403     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1404     on stop   undo , return error substitute( "&1. stop", vss-workfile )
     1405     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     1406     :
     1407         if first-of(buf_temp-xml-tables.uniq-gate-rec) then do:
     1408           delete object buf_temp-xml-tables.gate-handle_.
     1409           buf_temp-xml-tables.gate-handle_ = ?.
     1410         end.
     1411         if valid-handle(buf_temp-xml-tables.table-handle_)
     1412         and buf_temp-xml-tables.table-handle_:dynamic = no
     1413         then do:
     1414           delete object buf_temp-xml-tables.table-handle_.
     1415           buf_temp-xml-tables.table-handle_ = ?.
     1416         end.
     1417         delete buf_temp-xml-tables.
     1418     end.
     1419   end.
     1420   end procedure.
     1421   procedure fix-schemalocation :
     1422   define input-output  parameter p-longchar as longchar no-undo .
     1423   DEFINE VARIABLE hdoc AS HANDLE.
     1424   DEFINE VARIABLE hroot AS HANDLE.
     1425   DEFINE VARIABLE hnode-child AS HANDLE.
     1426   DEFINE VARIABLE hnode-attr AS HANDLE.
     1427   define variable v-jj as integer   no-undo .
     1428   define variable ok as logical   no-undo .
     1429   define variable v-path1                    as character                no-undo .
     1430   DEFINE VARIABLE v-full-path1               as character                no-undo .
     1431   DEFINE VARIABLE v-file-name1               as character                no-undo .
     1432   DEFINE VARIABLE v-file-name-no-ext1        as character                no-undo .
     1433   DEFINE VARIABLE v-file-name-ext1           as character                no-undo .
     1434   define variable v-schema-location          as character                no-undo .
     1435   do
     1436   on error undo, return error return-value
     1437   :
     1438     CREATE X-DOCUMENT hdoc.
     1439     CREATE X-noderef hroot.
     1440     CREATE X-noderef hnode-child.
     1441     CREATE X-noderef hnode-attr.
     1442     hdoc:load("longchar", p-longchar, no) no-error.
     1443     iF ERROR-STATUS:GET-MESSAGE(1) <> '' THEN message ERROR-STATUS:GET-MESSAGE(1) view-as alert-box .
     1444     hdoc:get-document-element(hroot).
     1445     _repeat:
     1446     REPEAT v-jj = 1 TO hroot:NUM-CHILDREN:
     1447       ok = hroot:GET-CHILD(hNode-Child, v-jj).
     1448       if not ok then next.
     1449       if hNode-Child:local-name = "include"
     1450       then do:
     1451         ok = hNode-Child:GET-ATTRIBUTE-NODE( hnode-attr, "schemaLocation" ).
     1452           v-schema-location = hnode-attr:node-value.
     1453           run gbl/filename.p (
     1454                           input "exe/" + hnode-attr:node-value
     1455                         ,output v-full-path1
     1456                         ,output v-path1
     1457                         ,output v-file-name1
     1458                         ,output v-file-name-no-ext1
     1459                         ,output v-file-name-ext1
     1460                         ) no-error .
     1461           if error-status :error then do:
     1462             delete object hnode-attr.
     1463             delete object hnode-child.
     1464             delete object hroot.
     1465             delete object hdoc.
     1466             undo, return error substitute("Не удалось определить расположение схемы &1", v-schema-location).
     1467           end.
     1468         ok = hNode-Child:sET-ATTRIBUTE(  "schemaLocation", v-full-path1 ).
     1469         leave  _repeat.
     1470       end.
     1471     END.
     1472     hdoc:save("longchar", p-longchar).
     1473     delete object hnode-attr.
     1474     delete object hnode-child.
     1475     delete object hroot.
     1476     delete object hdoc.
     1477   end.
     1478   end procedure.
     1479   procedure gate-clb_fill-xml-tables :
     1480   define input parameter p-dsh as handle no-undo .
     1481   define input-output parameter p-xmlh as handle no-undo .
     1482   define variable v-ii as integer no-undo .
     1483     do
     1484     on error undo, return error
     1485     :
     1486       do v-ii = 1 to p-dsh:num-buffers:
     1487         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     1488         if not p-xmlh:available then do:
     1489           p-xmlh:buffer-create().
     1490           assign
     1491           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     1492           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1493           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1494           p-xmlh::gate-handle_ = p-dsh
     1495           p-xmlh::uniq-gate-rec = entry(2, p-dsh:private-data, chr(4))
     1496           p-xmlh::gate-name = p-dsh:name
     1497           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1498           .
     1499           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1500             assign
     1501             p-xmlh::order = -3.
     1502           end.
     1503           p-xmlh:buffer-release().
     1504         end.
     1505       end.
     1506     end.
     1507   end procedure.
     1508   procedure all-gates-empty :
     1509   define buffer buf_temp-xml-tables for temp-xml-tables.
     1510   do
     1511   on error undo, return error
     1512   :
     1513     for each buf_temp-xml-tables
     1514     break
     1515     by buf_temp-xml-tables.uniq-gate-rec
     1516     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1517     on stop   undo , return error substitute( "&1. stop", vss-workfile )
     1518     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     1519     :
     1520       if valid-handle(buf_temp-xml-tables.tbl-handle_) then do:
     1521         buf_temp-xml-tables.tbl-handle_:empty-temp-table().
     1522       end.
     1523     end.
     1524   end.
     1525   end procedure.
     1526   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1527   define variable counter    as integer   no-undo .
     1528   define variable rec-full   as character no-undo .
     1529   define variable v-rec-name as character no-undo .
     1530   define variable log-file-name as character no-undo .
     1531   define variable v-action as character no-undo .
     1532   define variable v-curr-rowid as rowid no-undo .
     1533   define variable v-tbl-row as rowid no-undo .
     1534   define variable v-tbl-name as character no-undo .
     1535   define variable v-dst-list     as character no-undo .
     1536   define variable v-command     as character no-undo .
     1537   define variable v-cmd-code    as integer no-undo .
     1538   define variable v-cmd-proc-handle as handle no-undo .
     1539   define variable v-rec-ord as recid no-undo .
     1540   define variable v-ignore as logical   no-undo .
     1541   define variable v-xmlh as handle no-undo .
     1542   define variable v-dataseth as handle no-undo .
     1543   define variable v-longchar as longchar no-undo .
     1544   define variable v-dmp-ord as int64 no-undo .
     1545   define variable v-uniq-gate-rec-dump as character no-undo .
     1546   define buffer buf_temp-xml-tables for temp-xml-tables.
     1547   define buffer buf_ext-system for ub.ext-system.
     1548   v-xmlh = buffer buf_temp-xml-tables:handle.
     1549   main-block:
     1550   do
     1551   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1552   on stop   undo, return error substitute( "&1. stop", vss-workfile )
     1553   on endkey undo, return error substitute( "&1. endkey", vss-workfile )
     1554   :
     1555     _counter:
     1556     do counter = 1 to p-counter
     1557     on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1558     on stop   undo, return error substitute( "&1. stop", vss-workfile )
     1559     on endkey undo, return error substitute( "&1. endkey", vss-workfile )
     1560     :
     1561       run waitfram-show in this-procedure
     1562         (input substitute("Получение команды на маршрутизацию во внешнюю систему &1. Получено записей: &2"
     1563                           , p-esys-id
     1564                           , counter)
     1565         ) .
     1566       if counter = 1 then do:
     1567         find first buf_ext-system no-lock where
     1568                   buf_ext-system.esys-id = p-esys-id
     1569               and buf_ext-system.db-num = 0 no-error.
     1570         if not available buf_ext-system then do:
     1571           undo main-block, return error substitute("&1. &2&3&4Нет ВС &5"
     1572                                                    , vss-workfile
     1573                                                    , return-value
     1574                                                    , chr(10)
     1575                                                    , error-status :get-message ( error-status :num-messages )
     1576                                                    , p-esys-id).
     1577         end.
     1578         if not buf_ext-system.esys-have-export then do:
     1579           run waitfram-show in this-procedure
     1580             (input substitute("Нет экспорта в ВС &1. Игнорируем команду"
     1581                               , p-esys-id
     1582                               )
     1583             ) .
     1584           v-ignore = yes.
     1585         end.
     1586         if not v-ignore then do:
     1587           if buf_ext-system.esys-db-num-exp <> p-db-num-exp then do:
     1588             p-db-num-exp = buf_ext-system.esys-db-num-exp.
     1589           end.
     1590           if not valid-handle(v-cmd-proc-handle ) then do:
     1591             run nws/cmd-bush.p persistent set v-cmd-proc-handle no-error .
     1592             if error-status:error then do:
     1593               delete procedure v-cmd-proc-handle.
     1594               undo main-block, return error substitute("&1 &2 &3&4Ошибка при запуске процедуры cmd-bush.p&4" +
     1595                                                   "&5&4&6"
     1596                                                   ,vss-workfile
     1597                                                   ,vss-revision
     1598                                                   ,vss-description
     1599                                                   ,chr(10)
     1600                                                   ,error-status:get-message(1)
     1601                                                   ,return-value ).
     1602             end.
     1603           end.
     1604           if p-db-num-exp = g#db-num then do:
     1605             v-command = 'cmd-esys-general':U.
     1606             v-dst-list = string(p-esys-id).
     1607           end.
     1608           else do:
     1609             assign
     1610             v-command = substitute("&2&1&3&1&4&1&5"
     1611                                         ,chr(6)
     1612                                         ,'cmd-nws2esys-general':U
     1613                                         ,p-esys-id
     1614                                         ,p-db-num-exp
     1615                                         ,str-encode( p-uniq-gate-rec
     1616                                                 , ""
     1617                                                 , chr(3))
     1618                                         ).
     1619           end.
     1620           run begin-create-command in v-cmd-proc-handle
     1621             (input  v-command
     1622             ,INPUT  v-dst-list
     1623             ,output v-cmd-code
     1624             ) no-error.
     1625           if error-status:error then do:
     1626             delete procedure v-cmd-proc-handle .
     1627             run  gate-clear in this-procedure (
     1628                                                 input v-dataseth
     1629                                                 ,input v-xmlh) no-error.
     1630             undo main-block, return error substitute("&1 &2 &3&4Ошибка при создании команды &5&4" +
     1631                                                 "&6&4&7"
     1632                                                 ,vss-workfile
     1633                                                 ,vss-revision
     1634                                                 ,vss-description
     1635                                                 ,chr(10)
     1636                                                 ,'cmd-nws2esys-general':U
     1637                                                 ,error-status:get-message(1)
     1638                                                 ,return-value ).
     1639           end.
     1640           v-longchar = ?.
     1641           run get-gate-by-rec in this-procedure ( input p-uniq-gate-rec
     1642                                                 ,output v-dataseth
     1643                                                 ,input-output v-xmlh
     1644                                                 ,input-output v-longchar) no-error.
     1645         end.
     1646       end.
     1647       run nws-imps in p-imp-handle
     1648         ( input-output counter
     1649          ,output       rec-full
     1650         ) no-error.
     1651       if error-status :error then do:
     1652         return error return-value .
     1653       end.
     1654       assign
     1655         v-rec-name = entry( 1, rec-full, chr(1) )
     1656         v-action = entry(2, rec-full, chr(1))
     1657         v-uniq-gate-rec-dump = entry(4, rec-full, chr(1))
     1658       .
     1659       if v-ignore then next _counter.
     1660       find first buf_temp-xml-tables no-lock where
     1661                 buf_temp-xml-tables.tbl-name = v-rec-name no-error.
     1662       if available buf_temp-xml-tables then do:
     1663         run proc-load-standart in p-imp-handle
     1664           ( input v-rec-name
     1665             ,input v-uniq-gate-rec-dump
     1666             ,input buf_temp-xml-tables.tbl-handle
     1667             ,input p-imp-handle
     1668             ,input 0
     1669             ,output v-curr-rowid
     1670           ) no-error.
     1671         if error-status :error then do:
     1672           return error return-value .
     1673         end.
     1674         buf_temp-xml-tables.tbl-handle:find-by-rowid( v-curr-rowid) no-error.
     1675         if error-status:error then do:
     1676           delete procedure v-cmd-proc-handle .
     1677           run  gate-clear in this-procedure (
     1678                                               input v-dataseth
     1679                                               ,input v-xmlh) no-error.
     1680           undo main-block, return error substitute("&1 &2 &3&4Ошибка при чтении записи № &8 команды &5&4" +
     1681                                               "&6&4&7"
     1682                                               ,vss-workfile
     1683                                               ,vss-revision
     1684                                               ,vss-description
     1685                                               ,chr(10)
     1686                                               ,'cmd-nws2esys-general':U
     1687                                               ,error-status:get-message(1)
     1688                                               ,return-value
     1689                                               ,counter
     1690                                               ).
     1691         end.
     1692                                 run add-dump in v-cmd-proc-handle                                                                              (input v-cmd-code                                                                                            ,input v-rec-name                                                                                          ,input v-action                                                                                         ,input buf_temp-xml-tables.tbl-handle                                                                                    ,input v-uniq-gate-rec-dump                                                                               ,output v-rec-ord                                                                                            ) no-error .                                                                                               if error-status :error                                                                                       then do:                                                                                                     delete procedure v-cmd-proc-handle .                                                                           undo main-block, return error substitute("&1 &2 &3&4Ошибка при добавлении записи &5 в команду с кодом &6&4&8&4&9&4"                                       ,vss-workfile                                                                                                ,vss-revision                                                                                                ,vss-description                                                                                             ,chr(10)                                                                                               ,v-rec-name                                                                                                ,v-cmd-code                                                                                                  ,error-status:get-message(1)                                                                                 ,return-value                                                                                                ) .                                                                    end.
     1693      end.
     1694      else do:
     1695         run waitfram-hide in this-procedure .
     1696         message
     1697           vss-workfile vss-revision vss-description skip
     1698           "Не предусмотрен прием таблицы " v-rec-name skip
     1699           "в составе команды" 'cmd-dct-send':U skip
     1700           view-as alert-box error .
     1701         if not v-ignore then do:
     1702           delete procedure v-cmd-proc-handle .
     1703           run  gate-clear in this-procedure (
     1704                                               input v-dataseth
     1705                                             ,input v-xmlh) no-error.
     1706         end.
     1707         return error .
     1708      end.
     1709     end.
     1710     if not v-ignore then do:
     1711       if v-command begins 'cmd-nws2esys-general':U then do:
     1712         run send-command in v-cmd-proc-handle
     1713           ( input v-cmd-code
     1714             ,input v-dst-list
     1715             ) no-error .
     1716       end.
     1717       else do:
     1718         run send-command-esys in v-cmd-proc-handle
     1719           ( input v-cmd-code
     1720             ,input v-dst-list
     1721             ,input g#userid
     1722             ,output v-dmp-ord
     1723             ) no-error .
     1724       end.
     1725       if error-status:error then do:
     1726         delete procedure v-cmd-proc-handle .
     1727         run  gate-clear in this-procedure (
     1728                                             input v-dataseth
     1729                                           ,input v-xmlh) no-error.
     1730         message
     1731         vss-workfile vss-revision vss-description skip
     1732         substitute( "Ошибка при отсылке команды &1", 'cmd-rum-send':U ) skip
     1733         error-status :get-message(1) skip
     1734         return-value skip
     1735         view-as alert-box error .
     1736         undo main-block, return error .
     1737       end.
     1738       delete procedure v-cmd-proc-handle .
     1739     end.
     1740     run  gate-clear in this-procedure (
     1741                                         input v-dataseth
     1742                                        ,input v-xmlh) no-error.
     1743     run waitfram-hide in this-procedure .
     1744     return ''.
     1745   end.
     1746   procedure write-to-log :
     1747   define input parameter p-mess as character no-undo .
     1748     do
     1749     on error undo, return error
     1750     :
     1751     run write-log-and-file in p-log-handle (
     1752           input 1
     1753         , input log-file-name
     1754         , input 1
     1755         , input p-mess).
     1756     end.
     1757   end procedure.
