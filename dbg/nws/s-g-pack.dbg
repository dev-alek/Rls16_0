        1   block-level on error undo, throw.
        2   define input parameter p0-action     as character no-undo .
        3   define input parameter p0-arch-type  as character no-undo .
        4   define input parameter p0-file-name  as character no-undo .
        5   define input parameter p0-source-dir as character no-undo .
        6   define input parameter p0-target-dir as character no-undo .
        7   define input parameter p0-temp-dir   as character no-undo .
        8   def var vss-revision    as character no-undo init "$Revision: 0913db48c0a8, 1234, rls $":U .
        9   def var vss-author      as character no-undo init "$Author: SSlivenko $":U .
       10   def var vss-date        as character no-undo init "$Date: Mon Feb 26 19:29:32 2018 +0300 $":U .
       11   def var vss-workfile    as character no-undo init "$Workfile: s-g-pack.p $":U .
       12   def var vss-archive     as character no-undo init "$Archive: nws/s-g-pack.p $":U .
       13   def var vss-description as character no-undo init "отправка и прием пакета новостей (файла)".
       14   procedure vss-get-info :
       15     define output parameter p-vss-revision    like vss-revision    no-undo .
       16     define output parameter p-vss-author      like vss-author      no-undo .
       17     define output parameter p-vss-date        like vss-date        no-undo .
       18     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       19     define output parameter p-vss-archive     like vss-archive     no-undo .
       20     define output parameter p-vss-description like vss-description no-undo .
       21     assign
       22       p-vss-revision    = vss-revision
       23       p-vss-author      = vss-author
       24       p-vss-date        = vss-date
       25       p-vss-workfile    = vss-workfile
       26       p-vss-archive     = vss-archive
       27       p-vss-description = vss-description
       28     .
       29   end procedure.
       30   procedure vss-get-parameters :
       31     define output parameter p-vss-parameters as character no-undo .
       32   end procedure.
       33   define new global shared variable g#vssrevis-logger as handle    no-undo .
       34   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       35   define variable v-vssrevis-logger                   as handle    no-undo .
       36   procedure vss-logevent :
       37     define input  parameter p-extra-paramters as character no-undo .
       38     define variable v-vssrevis-parameters as character no-undo .
       39     do
       40     on error undo, return error return-value
       41     :
       42       if  valid-handle(v-vssrevis-logger)
       43       and v-vssrevis-logger :get-signature("logevent") <> ""
       44       then do:
       45         run vss-get-parameters in this-procedure
       46           (output v-vssrevis-parameters
       47           ).
       48         run logevent in v-vssrevis-logger
       49           (input vss-workfile
       50           ,input vss-revision
       51           ,input v-vssrevis-parameters
       52           ,input p-extra-paramters
       53           ).
       54       end.
       55     end.
       56   end procedure.
       57   assign
       58     v-vssrevis-logger = g#vssrevis-logger
       59   .
       60   if  valid-handle(v-vssrevis-logger)
       61   and v-vssrevis-logger :get-signature("logevent") <> ""
       62   then do:
       63     assign
       64       v-vssrevis-logevent = true
       65     .
       66     run vss-logevent in this-procedure (input vss-description) .
       67   end.
       68   define new global shared variable g#language as character no-undo .
       69   if g#language <> '' and g#language <> 'rus':U then do:
       70     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       71   end.
       72   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       73   define  shared variable g#auto-pid           as integer   no-undo .
       74   define  shared variable conn-par             as character no-undo .
       75   define  shared variable g#auto-user-id       as character no-undo .
       76   define  shared variable g#auto-user-login    as character no-undo .
       77   define  shared variable g#auto-user-password as character no-undo .
       78   define  shared variable v-socket             as logical   no-undo .
       79   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       80   define  shared variable auto-window-h     as handle    no-undo .
       81   define  shared variable auto-log-msg-h    as handle    no-undo .
       82   define  shared variable hand-log-msg-h    as handle    no-undo .
       83   define  shared variable log-file-name     as character no-undo initial ? .
       84   define  shared variable add-log-file-name as character no-undo initial ? .
       85   define  shared variable writelogvalue     as character no-undo initial ? .
       86   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       87   procedure cur-time :
       88      define output parameter p-today as date      no-undo .
       89      define output parameter p-time  as integer   no-undo .
       90     do
       91     on error undo, return error
       92     :
       93       define variable v-date1 as date      no-undo .
       94       define variable v-date2 as date      no-undo .
       95       define variable v-time  as integer   no-undo .
       96       assign
       97         v-date1 = today
       98         v-time  = time
       99         v-date2 = today
      100       .
      101       if v-date1 <> v-date2
      102       then do:
      103         assign
      104           v-date1 = today
      105           v-time  = v-time
      106         .
      107       end.
      108       assign
      109         p-today = v-date1
      110         p-time  = v-time
      111       .
      112     end.
      113   end.
      114   function cur-time-date returns character
      115   :
      116     return string(today, '99/99/9999':U) .
      117   end.
      118   function cur-time-mjd returns decimal
      119   :
      120     define variable v-date as date      no-undo .
      121     define variable v-time as integer   no-undo .
      122     run cur-time in this-procedure
      123       (output v-date
      124       ,output v-time
      125       ) .
      126     return integer(v-date) - 2400002 + (v-time / 86400) .
      127   end.
      128   function cur-time-get-ending-index returns integer
      129   (input p-number as integer
      130   )
      131   :
      132     if p-number < 0
      133     or p-number = ?
      134     then do:
      135       return 1 .
      136     end.
      137     define variable v-rest as integer   no-undo .
      138     assign
      139       p-number = p-number modulo 100
      140     .
      141     if p-number < 20
      142     then do:
      143       assign
      144         v-rest = p-number
      145       .
      146     end.
      147     else do:
      148       assign
      149         v-rest = p-number modulo 10
      150       .
      151     end.
      152     case v-rest :
      153       when 1
      154       then do:
      155         return 2 .
      156       end.
      157       when 2 or
      158       when 3 or
      159       when 4
      160       then do:
      161         return 3 .
      162       end.
      163       otherwise do:
      164         return 1 .
      165       end.
      166     end case .
      167   end.
      168   procedure cur-time-mjd-to-date :
      169      define input  parameter i-mjd-diff as decimal no-undo.
      170      define output parameter o-Date     as date    no-undo.
      171      define output parameter o-Time     as integer no-undo.
      172      define variable v-day-number as integer   no-undo .
      173      if    i-mjd-diff < 0
      174         or i-mjd-diff = ?
      175      then do:
      176         return "?" .
      177      end.
      178      assign
      179         v-day-number = truncate(i-mjd-diff,0).
      180         o-Date = date(v-day-number + 2400002).
      181         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      182     .
      183   end.
      184   function cur-time-mjd-to-string returns character
      185   (input p-mjd-diff as decimal
      186   )
      187   :
      188     define variable v-day-number as integer   no-undo .
      189     define variable v-seconds    as integer   no-undo .
      190     define variable v-hour       as integer   no-undo .
      191     define variable v-min        as integer   no-undo .
      192     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      193     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      194     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      195     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      196     if p-mjd-diff < 0
      197     or p-mjd-diff = ?
      198     then do:
      199       return "?" .
      200     end.
      201     assign
      202       v-day-number = integer(truncate(p-mjd-diff,0))
      203       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      204     .
      205     if v-seconds > 86400
      206     then do:
      207       assign
      208         v-seconds = 86400 - 1
      209       .
      210     end.
      211     if v-seconds < 0
      212     then do:
      213       assign
      214         v-seconds = 0
      215       .
      216     end.
      217     assign
      218       v-hour = truncate(v-seconds / 3600, 0)
      219     .
      220     assign
      221       v-seconds = v-seconds modulo 3600
      222     .
      223     assign
      224       v-min = truncate(v-seconds / 60, 0)
      225     .
      226     assign
      227       v-seconds = v-seconds modulo 60
      228     .
      229     return
      230         (if v-day-number <> 0
      231           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      232           else ""
      233         )
      234       + (if v-day-number <> 0 or v-hour <> 0
      235           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      236           else ""
      237         )
      238       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      239           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      240           else ""
      241         )
      242       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      243       .
      244   end.
      245   function cur-time-string returns character
      246   :
      247     define variable v-date as date      no-undo .
      248     define variable v-time as integer   no-undo .
      249     run cur-time in this-procedure
      250       (output v-date
      251       ,output v-time
      252       ) .
      253     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      254   end.
      255   function cur-time-string-sec returns character
      256   :
      257     define variable v-date as date      no-undo .
      258     define variable v-time as integer   no-undo .
      259     run cur-time in this-procedure
      260       (output v-date
      261       ,output v-time
      262       ) .
      263     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      264   end.
      265   function cur-time-custom  returns character
      266   (input p-prefix as character
      267   ,input p-date-format as character
      268   ,input p-delimiter as character
      269   ,input p-time-format as character
      270   ,input p-suffix as character
      271   )
      272   :
      273     define variable v-date as date      no-undo .
      274     define variable v-time as integer   no-undo .
      275     run cur-time in this-procedure
      276       (output v-date
      277       ,output v-time
      278       ) .
      279     return
      280       p-prefix
      281       + string(v-date, p-date-format)
      282       + p-delimiter
      283       + string(v-time, p-time-format)
      284       + p-suffix
      285       .
      286   end.
      287   function cur-time-print  returns character
      288   :
      289     define variable v-date as date      no-undo .
      290     define variable v-time as integer   no-undo .
      291     run cur-time in this-procedure
      292       (output v-date
      293       ,output v-time
      294       ) .
      295     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      296   end.
      297   function cur-time-datetime returns datetime
      298   :
      299     define variable v-char as character no-undo .
      300     define variable v-datetime as datetime no-undo .
      301     v-char = cur-time-string().
      302     v-datetime = datetime(v-char).
      303     return  v-datetime.
      304   end.
      305   function cur-time-string-msec returns character
      306   :
      307     define variable v-date as datetime  no-undo .
      308     v-date = now.
      309     return string(v-date) .
      310   end.
      311   define stream LogStream .
      312   define variable mNoTime as logical no-undo.
      313   procedure write-to-log-notime :
      314     define input param i-str as character no-undo .
      315     mNoTime = yes.
      316     run write-to-log (i-str).
      317     mNoTime = no.
      318   end.
      319   procedure write-to-log :
      320     define input param p-str as character no-undo .
      321     do
      322     on error  undo, return error substitute( "&1 (write-to-log). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      323     on stop   undo, return error substitute( "&1 (write-to-log). stop", vss-workfile )
      324     on endkey undo, return error substitute( "&1 (write-to-log). endkey", vss-workfile )
      325     :
      326       define variable log-res        as logical   no-undo .
      327       define variable v-jj           as integer   no-undo .
      328       if    mNoTime
      329          or writelogvalue eq "AsyncProc"
      330       then
      331          p-str = substitute( "&1 (pid: &2) &3&4"   , g#auto-user-id, g#auto-pid,                        p-str, chr(10) ).
      332       else
      333          p-str = substitute( "&1 (pid: &2) &3 &4&5", g#auto-user-id, g#auto-pid, cur-time-string-sec(), p-str, chr(10) ).
      334       if auto-log-msg-h <> ? then do:
      335         log-res = auto-log-msg-h:move-to-eof( ) .
      336         log-res = auto-log-msg-h:insert-string( p-str ).
      337       end.
      338       if hand-log-msg-h <> ? then do:
      339         log-res = hand-log-msg-h:move-to-eof( ) .
      340         log-res = hand-log-msg-h:insert-string( p-str ).
      341       end.
      342       assign
      343         p-str = replace(p-str, (chr(10) + chr(13)), chr(10) )
      344         p-str = replace(p-str, (chr(13) + chr(10)), chr(10) )
      345         p-str = replace(p-str, chr(10), (chr(13) + chr(10)) )
      346       .
      347       if add-log-file-name <> ? then do:
      348         do v-jj = 1 to num-entries(add-log-file-name, chr(1)):
      349           run gbl/fileapnd.p
      350             ( input entry(v-jj, add-log-file-name, chr(1) )
      351             ,input p-str
      352             ,input 20
      353             ) no-error .
      354           if error-status:error then do:
      355             return error return-value .
      356           end.
      357         end.
      358       end.
      359       if writelogvalue eq "AsyncProc"
      360       then do:
      361          p-str = trim(p-str, (chr(13) + chr(10)) )
      362       .
      363          Publish "WriteLogAsunc" (p-str,yes).
      364       end.
      365       else if writelogvalue <> "yes" then do:
      366         run gbl/fileapnd.p
      367           ( input log-file-name
      368           ,input p-str
      369           ,input 20
      370           ) no-error .
      371         if error-status:error then do:
      372           return error return-value .
      373         end.
      374       end.
      375     end.
      376   end procedure.
      377   procedure write-to-screen :
      378     define input param p-str as character no-undo .
      379     do
      380     on error  undo, return error substitute( "&1 (write-to-screen). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      381     on stop   undo, return error substitute( "&1 (write-to-screen). stop", vss-workfile )
      382     on endkey undo, return error substitute( "&1 (write-to-screen). endkey", vss-workfile )
      383     :
      384       define variable log-res as logical no-undo.
      385       assign
      386         p-str = substitute( "&1 (pid: &2) &3 &4&5", g#auto-user-id, g#auto-pid, cur-time-string-sec(), p-str, chr(10) )
      387       .
      388       if auto-log-msg-h <> ?
      389       then do:
      390         log-res = auto-log-msg-h:move-to-eof( ) .
      391         log-res = auto-log-msg-h:insert-string( p-str ).
      392       end.
      393       if hand-log-msg-h <> ?
      394       then do:
      395         log-res = hand-log-msg-h:move-to-eof( ) .
      396         log-res = hand-log-msg-h:insert-string( p-str ).
      397       end.
      398     end.
      399   end procedure.
      400   procedure send-msg-to-email :
      401     define input  parameter p-subject      as character no-undo .
      402     define input  parameter p-text-err     as character no-undo .
      403     define input  parameter p-attach-files as character no-undo .
      404     do
      405     on error  undo, return error substitute( "&1 (send-msg-to-email). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      406     on stop   undo, return error substitute( "&1 (send-msg-to-email). stop", vss-workfile )
      407     on endkey undo, return error substitute( "&1 (send-msg-to-email). endkey", vss-workfile )
      408     :
      409       define variable v-tth             as handle    no-undo .
      410       define variable v-value-character as character no-undo .
      411       define variable v-value-date      as date      no-undo .
      412       define variable v-value-decimal   as decimal   no-undo .
      413       define variable v-value-integer   as integer   no-undo .
      414       define variable v-value-logical   as logical   no-undo .
      415       define variable v-param-type      as character no-undo .
      416       define variable v-email       as character no-undo .
      417       define variable v-tmp-str     as character no-undo .
      418       define variable v-tmp1-str    as character no-undo .
      419       define variable v-ind         as integer   no-undo .
      420       define variable v-num-entries as integer   no-undo .
      421       delete object v-tth no-error.
      422       run adm/shattri.p
      423         ( input "get":U
      424          ,input  "":U
      425          ,input  0
      426          ,input  'auto-task':U
      427          ,input  'send-msg-to-email':U
      428          ,output v-value-character
      429          ,output v-value-date
      430          ,output v-value-decimal
      431          ,output v-value-integer
      432          ,output v-value-logical
      433          ,output v-param-type
      434          ,input-output table-handle v-tth
      435         ) no-error .
      436       if not error-status :error  then do:
      437         assign
      438           v-tmp-str = v-value-character
      439         .
      440       end.
      441       delete object v-tth no-error.
      442       assign
      443         v-tmp-str     = replace(v-tmp-str, (chr(10) + chr(13)), chr(44) )
      444         v-tmp-str     = replace(v-tmp-str, (chr(13) + chr(10)), chr(44) )
      445         v-tmp-str     = replace(v-tmp-str, chr(10), chr(44) )
      446         v-num-entries = num-entries( v-tmp-str, chr(44) )
      447         v-email       = "":U
      448       .
      449       do v-ind = 1 to v-num-entries
      450       :
      451         assign
      452           v-tmp1-str = entry( v-ind, v-tmp-str, chr(44) )
      453         .
      454         if trim( v-tmp1-str ) <> "":U then do:
      455           if v-email = "":U then do:
      456             assign
      457               v-email = v-tmp1-str
      458             .
      459           end.
      460           else do:
      461             assign
      462               v-email = v-email + chr(44) + v-tmp1-str
      463             .
      464           end.
      465         end.
      466       end.
      467       if v-email <> "":U then do:
      468         run gbl/sendmail.p
      469           ( input v-email
      470           , input p-subject
      471           , input p-text-err
      472           , input p-attach-files
      473           ) no-error .
      474         if error-status :error
      475           or return-value <> "":U
      476         then do:
      477           return error substitute( "&1 (send-msg-to-email). &2", vss-workfile, return-value ) .
      478         end.
      479       end.
      480     end.
      481   end procedure.
      482   do
      483   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      484   on stop   undo, return error substitute( "&1. stop", vss-workfile )
      485   on endkey undo, return error substitute( "&1. endkey", vss-workfile )
      486   :
      487     define stream FLStream.
      488     define variable v-filename         as character no-undo .
      489     define variable v-fullfilename     as character no-undo .
      490     define variable v-filetype         as character no-undo .
      491     assign
      492       file-info:file-name = p0-temp-dir
      493     .
      494     if file-info:file-type = ?
      495       or not ( file-info:file-type begins "D":U )
      496     then do:
      497       os-create-dir value( p0-temp-dir ).
      498       if os-error <> 0 then do:
      499         return error substitute( "&1. Каталог &2 отсутствует, а создать его не удалось.", vss-workfile, p0-temp-dir ).
      500       end.
      501     end.
      502     if p0-file-name <> ? then do:
      503       run file-s-g ( input p0-action
      504                     ,input p0-arch-type
      505                     ,input p0-file-name
      506                     ,input p0-source-dir
      507                     ,input p0-target-dir
      508                     ,input p0-temp-dir
      509                    ) no-error.
      510       if error-status :error then do:
      511         return error return-value.
      512       end.
      513     end.
      514     else do:
      515       input stream FLStream from os-dir ( p0-source-dir ) .
      516       repeat
      517       on error  undo, return error substitute( "&1 (repeat). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      518       on stop   undo, return error substitute( "&1 (repeat). stop", vss-workfile )
      519       :
      520         import stream FLStream v-filename v-fullfilename v-filetype.
      521         if v-filetype begins "F"
      522           and num-entries( v-filename, "." ) > 1
      523         then do:
      524           assign
      525             file-info:file-name = v-fullfilename
      526           .
      527           if lookup(entry( num-entries( v-filename, "." ), v-filename, "." ), "$$$") = 0
      528             and file-info:file-type MATCHES "*W*":U
      529             and file-info:file-type MATCHES "*R*":U
      530             and not ( file-info:file-type MATCHES "*H*":U )
      531           then do:
      532             run file-s-g ( input p0-action
      533                           ,input p0-arch-type
      534                           ,input v-filename
      535                           ,input p0-source-dir
      536                           ,input p0-target-dir
      537                           ,input p0-temp-dir
      538                         ) no-error.
      539             if error-status :error then do:
      540               return error return-value.
      541             end.
      542           end.
      543         end.
      544       END.
      545       input stream FLStream close.
      546     end.
      547     return .
      548   end.
      549   procedure file-s-g :
      550     define input parameter p-action     as character no-undo .
      551     define input parameter p-arch-type  as character no-undo .
      552     define input parameter p-file-name  as character no-undo .
      553     define input parameter p-source-dir as character no-undo .
      554     define input parameter p-target-dir as character no-undo .
      555     define input parameter p-temp-dir   as character no-undo .
      556     do
      557     on error  undo, return error substitute( "&1 (file-s-g). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      558     on stop   undo, return error substitute( "&1 (file-s-g). stop", vss-workfile )
      559     on endkey undo, return error substitute( "&1 (file-s-g). endkey", vss-workfile )
      560     :
      561       define variable v-arch-type        as character no-undo .
      562       define variable v-arh-name         as character no-undo .
      563       define variable v-file-source      as character no-undo .
      564       define variable v-file-source-arj  as character no-undo .
      565       define variable v-file-temp        as character no-undo .
      566       define variable v-file-target      as character no-undo .
      567       define variable v-file-hash        as character no-undo .
      568       define variable v-file-name-no-ext as character no-undo .
      569       define variable v-ext-name         as character no-undo .
      570       define variable v-err-mess         as character no-undo .
      571           if p-file-name BEGINS "RC_":U or p-file-name BEGINS "update_":U or p-file-name BEGINS "UFO-":U then do:
      572         assign
      573           p-arch-type = "":U
      574         .
      575       end.
      576       if r-index( p-file-name, '.':u) > 0 then do:
      577         assign
      578           v-file-name-no-ext = substring( p-file-name, 1, r-index( p-file-name, '.':u) - 1 )
      579           v-ext-name         = entry( num-entries( p-file-name, "." ), p-file-name, "." )
      580         .
      581       end.
      582       else do:
      583         assign
      584           v-file-name-no-ext = p-file-name
      585           v-ext-name         = "":U
      586         .
      587       end.
      588       assign
      589         v-file-source     = p-source-dir + chr(92) + p-file-name
      590         v-file-temp       = p-temp-dir   + chr(92) + p-file-name
      591         v-file-target     = p-target-dir + chr(92) + p-file-name
      592       .
      593       assign
      594         file-info:file-name = v-file-source
      595       .
      596       if file-info:file-type = ?
      597         or not ( file-info:file-type begins "F":U )
      598       then do:
      599         return error substitute( "&1. Исходный файл &2 не найден.", vss-workfile, v-file-source ).
      600       end.
      601       run gbl/md5.p(v-file-source, output v-file-hash).
      602       run write-to-log( substitute("Файл: &1; Контрольная сумма: &2.", v-file-source,  v-file-hash) ) .
      603       if p-action = "put":U then do:
      604         if p-arch-type <> "":U then do:
      605           case p-arch-type :
      606             when "7zip":U then do:
      607               assign
      608                 v-arh-name = search( "exe/7z.exe":U )
      609               .
      610               if v-arh-name = ? then do:
      611                 assign
      612                   v-arh-name = search( "exe/7za.exe":U )
      613                 .
      614               end.
      615             end.
      616             when "arj":U then do:
      617               assign
      618                 v-arh-name = search( "exe/arj32.exe":U )
      619               .
      620               if v-arh-name = ? then do:
      621                 assign
      622                   v-arh-name = search( "exe/arj.exe":U )
      623                 .
      624               end.
      625             end.
      626           end case.
      627           if v-arh-name = ? then do:
      628             return error substitute( "&1. Программа архиватор не найдена!", vss-workfile ).
      629           end.
      630           run write-to-log( substitute( "Отправка файла &1 (&2)", v-file-source, v-arh-name ) ).
      631           assign
      632             v-file-source-arj = p-source-dir + chr(92) + v-file-name-no-ext
      633             v-file-temp       = p-temp-dir   + chr(92) + v-file-name-no-ext
      634             v-file-target     = p-target-dir + chr(92) + v-file-name-no-ext
      635           .
      636           case p-arch-type :
      637             when "7zip":U then do:
      638               assign
      639                 v-file-source-arj = v-file-source-arj + ".zip":U
      640                 v-file-temp       = v-file-temp       + ".zip":U
      641                 v-file-target     = v-file-target     + ".zip":U
      642               .
      643               os-command silent
      644                 value( substitute( "&1 a -tzip -y &2 &3":U, v-arh-name, v-file-source-arj, v-file-source ) )
      645               .
      646             end.
      647             when "arj":U then do:
      648               assign
      649                 v-file-source-arj = v-file-source-arj + ".arj":U
      650                 v-file-temp       = v-file-temp       + ".arj":U
      651                 v-file-target     = v-file-target     + ".arj":U
      652               .
      653               os-command silent
      654                 value( substitute( "&1 a -e -y &2 &3":U, v-arh-name, v-file-source-arj, v-file-source ) )
      655               .
      656             end.
      657           end case.
      658         end.
      659         else do:
      660           run write-to-log( substitute( "Отправка файла &1 (copy)", v-file-source ) ).
      661           assign
      662             v-file-source-arj = v-file-source
      663           .
      664         end.
      665         run del-file in this-procedure
      666           ( input v-file-temp
      667           ) no-error .
      668         if error-status :error then do:
      669           return error return-value .
      670         end.
      671         os-copy
      672           value( v-file-source-arj )
      673           value( v-file-temp )
      674           .
      675         if os-error <> 0 then do:
      676           run adm/os-err.p
      677             ( output v-err-mess
      678             ).
      679           return error substitute( "&1. Невозможно скопировать файл &2 в каталог &3&4&5", vss-workfile, v-file-temp, p-target-dir, chr(10), v-err-mess ) .
      680         end.
      681         if p-arch-type <> "":U then do:
      682           run del-file in this-procedure
      683             ( input v-file-source-arj
      684             ) no-error .
      685           if error-status :error then do:
      686             return error return-value .
      687           end.
      688         end.
      689         run ren-file in this-procedure
      690           ( input v-file-temp
      691           , input v-file-target
      692           ) no-error .
      693         if error-status :error then do:
      694           assign
      695             v-err-mess = return-value
      696           .
      697           run del-file in this-procedure
      698             ( input v-file-temp
      699             ) no-error .
      700           if error-status :error then do:
      701             assign
      702               v-err-mess = v-err-mess + chr(10) + return-value
      703             .
      704           end.
      705           return error v-err-mess .
      706         end.
      707       end.
      708       else do:
      709               if p-file-name BEGINS "RC_":U or p-file-name BEGINS "update_":U or p-file-name BEGINS "UFO-":U then do:
      710           run write-to-log( substitute( "Прием и обработка пакетов update", v-file-source ) ) .
      711           run adm/upd-rc.p
      712             ( input p-source-dir
      713             ) no-error .
      714           if error-status :error then do:
      715             run write-to-log( substitute( "&1. Ошибка приема и(или) обработки пакетов update!&2&3&2&4", vss-workfile, chr(10), return-value, error-status :get-message(1) ) ).
      716           end.
      717         end.
      718         else do:
      719           if v-ext-name = "zip":U then do:
      720             assign
      721               v-arch-type = "7zip":U
      722               v-arh-name  = search( "exe/7z.exe":U )
      723             .
      724             if v-arh-name = ? then do:
      725               assign
      726                 v-arh-name = search( "exe/7za.exe":U )
      727               .
      728             end.
      729           end.
      730           else do:
      731             if lookup( v-ext-name, "arj") <> 0 then do:
      732               assign
      733                 v-arch-type = "arj":U
      734                 v-arh-name  = search( "exe/arj32.exe":U )
      735               .
      736               if v-arh-name = ? then do:
      737                 assign
      738                   v-arh-name = search( "exe/arj.exe":U )
      739                 .
      740               end.
      741             end.
      742             else do:
      743               assign
      744                 v-arch-type = "":U
      745                 v-arh-name  = "copy":U
      746               .
      747             end.
      748           end.
      749           if v-arch-type <> "":U
      750             and v-arh-name = ?
      751           then do:
      752             return error substitute( "&1. Программа архиватор не найдена для файла с расширением &2!", vss-workfile, v-ext-name ).
      753           end.
      754           run write-to-log( substitute( "Прием файла &1 (&2)", v-file-source, v-arh-name ) ) .
      755           run ren-file in this-procedure
      756             ( input v-file-source
      757             , input v-file-temp
      758             ) no-error .
      759           if error-status :error then do:
      760             return error return-value .
      761           end.
      762           run del-file in this-procedure
      763             ( input v-file-target
      764             ) no-error .
      765           if error-status :error then do:
      766             return error return-value .
      767           end.
      768           os-copy
      769             value( v-file-temp )
      770             value( v-file-target )
      771             .
      772           if os-error <> 0 then do:
      773             run adm/os-err.p
      774               ( output v-err-mess
      775               ).
      776             return error substitute( "&1. Невозможно скопировать файл &2 в каталог &3&4&5", vss-workfile, v-file-temp, p-target-dir, chr(10), v-err-mess ).
      777           end.
      778           run del-file in this-procedure
      779             ( input v-file-temp
      780             ) no-error .
      781           if error-status :error then do:
      782             return error return-value .
      783           end.
      784           if v-arch-type <> "":U then do:
      785             case v-arch-type :
      786               when "7zip":U then do:
      787                 os-command silent
      788                   value( substitute( "&1 e -y &2 -o&3":U, v-arh-name, v-file-target, p-target-dir ) )
      789                 .
      790               end.
      791               when "arj":U then do:
      792                 os-command silent
      793                   value( substitute( "&1 e -y &2 &3":U, v-arh-name, v-file-target, p-target-dir ) )
      794                 .
      795               end.
      796             end case.
      797             run del-file in this-procedure
      798               ( input v-file-target
      799               ) no-error .
      800             if error-status :error then do:
      801               return error return-value .
      802             end.
      803           end.
      804         end.
      805       end.
      806     end.
      807   end procedure.
      808   procedure del-file :
      809     define input parameter p-del-file-name as character no-undo .
      810     do
      811     on error  undo, return error substitute( "&1 (del-file). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      812     on stop   undo, return error substitute( "&1 (del-file). stop", vss-workfile )
      813     on endkey undo, return error substitute( "&1 (del-file). endkey", vss-workfile )
      814     :
      815       define variable v-ind      as integer   no-undo .
      816       define variable v-err-code as integer   no-undo .
      817       define variable v-err-mess as character no-undo .
      818       define variable v-str      as character no-undo .
      819       assign
      820         file-info:file-name = p-del-file-name
      821       .
      822       if file-info:file-type <> ? then do:
      823         if file-info:file-type begins "F":U then do:
      824           assign
      825             v-str = "файл"
      826           .
      827         end.
      828         else do:
      829           if file-info:file-type begins "D":U then do:
      830             assign
      831               v-str = "каталог"
      832             .
      833           end.
      834           else do:
      835             assign
      836               v-str = "не знаю что"
      837             .
      838           end.
      839         end.
      840         bl1:
      841         do v-ind = 1 to 60 :
      842           os-delete value( p-del-file-name ).
      843           assign
      844             v-err-code = os-error
      845             file-info:file-name = p-del-file-name
      846           .
      847           if v-err-code = 0
      848             or file-info:file-type = ?
      849           then do:
      850             leave bl1 .
      851           end.
      852           pause 1 no-message .
      853         end.
      854         if os-error <> 0 then do:
      855           run adm/os-err.p ( output v-err-mess ).
      856           return error substitute( "&1. Невозможно удалить &2 &3&4&5", vss-workfile, v-str, p-del-file-name, chr(10), v-err-mess ).
      857         end.
      858       end.
      859     end.
      860     return.
      861   end procedure.
      862   procedure ren-file :
      863     define input parameter p-file-source as character no-undo .
      864     define input parameter p-file-target as character no-undo .
      865     do
      866     on error  undo, return error substitute( "&1 (ren-file). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      867     on stop   undo, return error substitute( "&1 (ren-file). stop", vss-workfile )
      868     on endkey undo, return error substitute( "&1 (ren-file). endkey", vss-workfile )
      869     :
      870       define variable v-ind      as integer   no-undo .
      871       define variable v-err-code as integer   no-undo .
      872       define variable v-err-mess as character no-undo .
      873       run del-file ( input p-file-target ) no-error .
      874       if error-status :error then do:
      875         return error return-value .
      876       end.
      877       bl1:
      878       do v-ind = 1 to 60 :
      879         os-rename value( p-file-source ) value( p-file-target ).
      880         assign
      881           v-err-code = os-error
      882           file-info:file-name = p-file-source
      883         .
      884         if v-err-code = 0
      885           or file-info:file-type = ?
      886         then do:
      887           leave bl1 .
      888         end.
      889         pause 1 no-message .
      890       end.
      891       if v-err-code <> 0 then do:
      892         run adm/os-err.p ( output v-err-mess ).
      893         return error substitute( "&1. Невозможно переименовать файл &2 в &3&4&5", vss-workfile, p-file-source, p-file-target, chr(10), v-err-mess ).
      894       end.
      895     end.
      896   end procedure.
