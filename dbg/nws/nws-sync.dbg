     1452     then do:
     1453       delete procedure v-cmd-proc-handle .
     1454       return error substitute("&1 &2 &3&4Ошибка при запуске процедуры cmd-bush.p&4" +
     1455                                           "&5&4&6"
     1456                                           ,vss-workfile
     1457                                           ,vss-revision
     1458                                           ,vss-description
     1459                                           ,chr(10)
     1460                                           ,error-status:get-message(1)
     1461                                           ,return-value ).
     1462     end.
     1463     define buffer buf_rp-by-call for ub.rp-by-call.
     1464     define buffer buf_rule-by-call for ub.rule-by-call.
     1465     define buffer buf_rule-call-param for ub.rule-call-param.
     1466     for each db no-lock
     1467     where db.db-num > 0
     1468     :
     1469       assign
     1470       v-db-list = v-db-list + chr(1) + string(db.db-num).
     1471     end.
     1472     v-db-list = trim(v-db-list, chr(1)).
     1473     for each ub.dis-card-type no-lock :
     1474       run nws/cr-route.p ( input 'send-tbl':U, input 'dis-card-type':U, input (buffer ub.dis-card-type:handle), input string(p-db-num) ) no-error.
     1475       if error-status :error then do:
     1476         return error return-value.
     1477       end.
     1478       assign
     1479       v-command =  substitute("&2&1&3&1&4"
     1480                              , chr(6)
     1481                              , 'cmd-dct-send':U
     1482                              , ub.dis-card-type.emitent-host-code
     1483                              , ub.dis-card-type.type
     1484                              ).
     1485       run begin-create-command in v-cmd-proc-handle
     1486         (input v-command
     1487         ,input "":U
     1488         ,output v-cmd-code
     1489         ) no-error.
     1490       if error-status :error
     1491       then do:
     1492         message
     1493           vss-workfile vss-revision vss-description skip
     1494           substitute( "Ошибка при создании команды &1", 'cmd-dct-send':U ) skip
     1495           error-status :get-message(1) skip
     1496           return-value skip
     1497           view-as alert-box error .
     1498         delete procedure v-cmd-proc-handle .
     1499         return error return-value .
     1500       end.
     1501       run send-command in v-cmd-proc-handle
     1502         ( input v-cmd-code
     1503           ,input v-db-list
     1504           ) no-error .
     1505       if error-status:error then do:
     1506         delete procedure v-cmd-proc-handle .
     1507         message
     1508         vss-workfile vss-revision vss-description skip
     1509         substitute( "Ошибка при отсылке команды &1", 'cmd-dct-send':U ) skip
     1510         error-status :get-message(1) skip
     1511         return-value skip
