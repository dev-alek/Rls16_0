      506     field actual-time-int as integer
      507   .
      508   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      509   define new global shared variable g#attr-lib  as handle no-undo .
      510   define variable v-attr-lib-variable as handle no-undo .
      511   procedure db-attr-code :
      512     define input  parameter p-code           as character no-undo .
      513     define output parameter p-type           as character no-undo .
      514     define output parameter p-format         as character no-undo .
      515     define output parameter p-label          as character no-undo .
      516     define output parameter p-user-can-edit  as logical   no-undo .
      517     define output parameter p-output-display as logical   no-undo .
      518     define output parameter p-other          as character no-undo .
      519     do
      520     on error undo, return error
      521     :
      522           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run db-attr-code in g#attr-lib
      523         (input  p-code
      524         ,output p-type
      525         ,output p-format
      526         ,output p-label
      527         ,output p-user-can-edit
      528         ,output p-output-display
      529         ,output p-other
      530         ) no-error .
      531       if error-status :error
      532       then do:
      533         undo, return error return-value .
      534       end.
      535     end.
      536   end procedure.
      537   procedure db-attr-tooltip :
      538     define input  parameter p-code    as character no-undo .
      539     define output parameter p-tooltip as character no-undo .
      540     define output parameter p-label   as character no-undo .
      541     do
