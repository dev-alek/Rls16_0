       96   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       97   procedure cur-time :
       98      define output parameter p-today as date      no-undo .
       99      define output parameter p-time  as integer   no-undo .
      100     do
      101     on error undo, return error
      102     :
      103       define variable v-date1 as date      no-undo .
      104       define variable v-date2 as date      no-undo .
      105       define variable v-time  as integer   no-undo .
      106       assign
      107         v-date1 = today
      108         v-time  = time
      109         v-date2 = today
      110       .
      111       if v-date1 <> v-date2
      112       then do:
      113         assign
      114           v-date1 = today
      115           v-time  = v-time
      116         .
      117       end.
      118       assign
      119         p-today = v-date1
      120         p-time  = v-time
      121       .
      122     end.
      123   end.
      124   function cur-time-date returns character
      125   :
      126     return string(today, '99/99/9999':U) .
      127   end.
      128   function cur-time-mjd returns decimal
      129   :
      130     define variable v-date as date      no-undo .
      131     define variable v-time as integer   no-undo .
      132     run cur-time in this-procedure
      133       (output v-date
      134       ,output v-time
      135       ) .
      136     return integer(v-date) - 2400002 + (v-time / 86400) .
      137   end.
      138   function cur-time-get-ending-index returns integer
      139   (input p-number as integer
      140   )
      141   :
      142     if p-number < 0
      143     or p-number = ?
      144     then do:
      145       return 1 .
      146     end.
      147     define variable v-rest as integer   no-undo .
      148     assign
      149       p-number = p-number modulo 100
      150     .
      151     if p-number < 20
      152     then do:
      153       assign
      154         v-rest = p-number
      155       .
      156     end.
      157     else do:
      158       assign
      159         v-rest = p-number modulo 10
      160       .
      161     end.
      162     case v-rest :
      163       when 1
      164       then do:
      165         return 2 .
      166       end.
      167       when 2 or
      168       when 3 or
      169       when 4
      170       then do:
      171         return 3 .
      172       end.
      173       otherwise do:
      174         return 1 .
      175       end.
      176     end case .
      177   end.
      178   procedure cur-time-mjd-to-date :
      179      define input  parameter i-mjd-diff as decimal no-undo.
      180      define output parameter o-Date     as date    no-undo.
      181      define output parameter o-Time     as integer no-undo.
      182      define variable v-day-number as integer   no-undo .
      183      if    i-mjd-diff < 0
      184         or i-mjd-diff = ?
      185      then do:
      186         return "?" .
      187      end.
      188      assign
      189         v-day-number = truncate(i-mjd-diff,0).
      190         o-Date = date(v-day-number + 2400002).
      191         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      192     .
      193   end.
      194   function cur-time-mjd-to-string returns character
      195   (input p-mjd-diff as decimal
      196   )
      197   :
      198     define variable v-day-number as integer   no-undo .
      199     define variable v-seconds    as integer   no-undo .
      200     define variable v-hour       as integer   no-undo .
      201     define variable v-min        as integer   no-undo .
      202     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      203     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      204     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      205     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      206     if p-mjd-diff < 0
      207     or p-mjd-diff = ?
      208     then do:
      209       return "?" .
      210     end.
      211     assign
      212       v-day-number = integer(truncate(p-mjd-diff,0))
      213       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      214     .
      215     if v-seconds > 86400
      216     then do:
      217       assign
      218         v-seconds = 86400 - 1
      219       .
      220     end.
      221     if v-seconds < 0
      222     then do:
      223       assign
      224         v-seconds = 0
      225       .
      226     end.
      227     assign
      228       v-hour = truncate(v-seconds / 3600, 0)
      229     .
      230     assign
      231       v-seconds = v-seconds modulo 3600
      232     .
      233     assign
      234       v-min = truncate(v-seconds / 60, 0)
      235     .
      236     assign
      237       v-seconds = v-seconds modulo 60
      238     .
      239     return
      240         (if v-day-number <> 0
      241           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      242           else ""
      243         )
      244       + (if v-day-number <> 0 or v-hour <> 0
      245           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      246           else ""
      247         )
      248       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      249           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      250           else ""
      251         )
      252       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      253       .
      254   end.
      255   function cur-time-string returns character
      256   :
      257     define variable v-date as date      no-undo .
      258     define variable v-time as integer   no-undo .
      259     run cur-time in this-procedure
      260       (output v-date
      261       ,output v-time
      262       ) .
      263     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      264   end.
      265   function cur-time-string-sec returns character
      266   :
      267     define variable v-date as date      no-undo .
      268     define variable v-time as integer   no-undo .
      269     run cur-time in this-procedure
      270       (output v-date
      271       ,output v-time
      272       ) .
      273     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      274   end.
      275   function cur-time-custom  returns character
      276   (input p-prefix as character
      277   ,input p-date-format as character
      278   ,input p-delimiter as character
      279   ,input p-time-format as character
      280   ,input p-suffix as character
      281   )
      282   :
      283     define variable v-date as date      no-undo .
      284     define variable v-time as integer   no-undo .
      285     run cur-time in this-procedure
      286       (output v-date
      287       ,output v-time
      288       ) .
      289     return
      290       p-prefix
      291       + string(v-date, p-date-format)
      292       + p-delimiter
      293       + string(v-time, p-time-format)
      294       + p-suffix
      295       .
      296   end.
      297   function cur-time-print  returns character
      298   :
      299     define variable v-date as date      no-undo .
      300     define variable v-time as integer   no-undo .
      301     run cur-time in this-procedure
      302       (output v-date
      303       ,output v-time
      304       ) .
      305     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      306   end.
      307   function cur-time-datetime returns datetime
      308   :
      309     define variable v-char as character no-undo .
      310     define variable v-datetime as datetime no-undo .
      311     v-char = cur-time-string().
      312     v-datetime = datetime(v-char).
      313     return  v-datetime.
      314   end.
      315   function cur-time-string-msec returns character
      316   :
      317     define variable v-date as datetime  no-undo .
      318     v-date = now.
      319     return string(v-date) .
      320   end.
      321   define stream LogStream .
      322   define variable mNoTime as logical no-undo.
      323   procedure write-to-log-notime :
      324     define input param i-str as character no-undo .
      325     mNoTime = yes.
      326     run write-to-log (i-str).
      327     mNoTime = no.
      328   end.
      329   procedure write-to-log :
      330     define input param p-str as character no-undo .
      331     do
      332     on error  undo, return error substitute( "&1 (write-to-log). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      333     on stop   undo, return error substitute( "&1 (write-to-log). stop", vss-workfile )
      334     on endkey undo, return error substitute( "&1 (write-to-log). endkey", vss-workfile )
      335     :
      336       define variable log-res        as logical   no-undo .
      337       define variable v-jj           as integer   no-undo .
      338       if    mNoTime
      339          or writelogvalue eq "AsyncProc"
      340       then
      341          p-str = substitute( "&1 (pid: &2) &3&4"   , g#auto-user-id, g#auto-pid,                        p-str, chr(10) ).
      342       else
      343          p-str = substitute( "&1 (pid: &2) &3 &4&5", g#auto-user-id, g#auto-pid, cur-time-string-sec(), p-str, chr(10) ).
      344       if auto-log-msg-h <> ? then do:
      345         log-res = auto-log-msg-h:move-to-eof( ) .
      346         log-res = auto-log-msg-h:insert-string( p-str ).
      347       end.
      348       if hand-log-msg-h <> ? then do:
      349         log-res = hand-log-msg-h:move-to-eof( ) .
      350         log-res = hand-log-msg-h:insert-string( p-str ).
      351       end.
      352       assign
      353         p-str = replace(p-str, (chr(10) + chr(13)), chr(10) )
      354         p-str = replace(p-str, (chr(13) + chr(10)), chr(10) )
      355         p-str = replace(p-str, chr(10), (chr(13) + chr(10)) )
      356       .
      357       if add-log-file-name <> ? then do:
      358         do v-jj = 1 to num-entries(add-log-file-name, chr(1)):
      359           run gbl/fileapnd.p
      360             ( input entry(v-jj, add-log-file-name, chr(1) )
      361             ,input p-str
      362             ,input 20
      363             ) no-error .
      364           if error-status:error then do:
      365             return error return-value .
      366           end.
      367         end.
      368       end.
      369       if writelogvalue eq "AsyncProc"
      370       then do:
      371          p-str = trim(p-str, (chr(13) + chr(10)) )
      372       .
      373          Publish "WriteLogAsunc" (p-str,yes).
      374       end.
      375       else if writelogvalue <> "yes" then do:
      376         run gbl/fileapnd.p
      377           ( input log-file-name
      378           ,input p-str
      379           ,input 20
      380           ) no-error .
      381         if error-status:error then do:
      382           return error return-value .
      383         end.
      384       end.
      385     end.
      386   end procedure.
      387   procedure write-to-screen :
      388     define input param p-str as character no-undo .
      389     do
      390     on error  undo, return error substitute( "&1 (write-to-screen). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      391     on stop   undo, return error substitute( "&1 (write-to-screen). stop", vss-workfile )
      392     on endkey undo, return error substitute( "&1 (write-to-screen). endkey", vss-workfile )
      393     :
      394       define variable log-res as logical no-undo.
      395       assign
      396         p-str = substitute( "&1 (pid: &2) &3 &4&5", g#auto-user-id, g#auto-pid, cur-time-string-sec(), p-str, chr(10) )
      397       .
      398       if auto-log-msg-h <> ?
      399       then do:
      400         log-res = auto-log-msg-h:move-to-eof( ) .
      401         log-res = auto-log-msg-h:insert-string( p-str ).
      402       end.
      403       if hand-log-msg-h <> ?
      404       then do:
      405         log-res = hand-log-msg-h:move-to-eof( ) .
      406         log-res = hand-log-msg-h:insert-string( p-str ).
      407       end.
      408     end.
      409   end procedure.
      410   procedure send-msg-to-email :
      411     define input  parameter p-subject      as character no-undo .
      412     define input  parameter p-text-err     as character no-undo .
      413     define input  parameter p-attach-files as character no-undo .
      414     do
      415     on error  undo, return error substitute( "&1 (send-msg-to-email). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      416     on stop   undo, return error substitute( "&1 (send-msg-to-email). stop", vss-workfile )
      417     on endkey undo, return error substitute( "&1 (send-msg-to-email). endkey", vss-workfile )
      418     :
      419       define variable v-tth             as handle    no-undo .
      420       define variable v-value-character as character no-undo .
      421       define variable v-value-date      as date      no-undo .
      422       define variable v-value-decimal   as decimal   no-undo .
      423       define variable v-value-integer   as integer   no-undo .
      424       define variable v-value-logical   as logical   no-undo .
      425       define variable v-param-type      as character no-undo .
      426       define variable v-email       as character no-undo .
      427       define variable v-tmp-str     as character no-undo .
      428       define variable v-tmp1-str    as character no-undo .
      429       define variable v-ind         as integer   no-undo .
      430       define variable v-num-entries as integer   no-undo .
      431       delete object v-tth no-error.
      432       run adm/shattri.p
      433         ( input "get":U
      434          ,input  "":U
      435          ,input  0
      436          ,input  'auto-task':U
      437          ,input  'send-msg-to-email':U
      438          ,output v-value-character
      439          ,output v-value-date
      440          ,output v-value-decimal
      441          ,output v-value-integer
      442          ,output v-value-logical
      443          ,output v-param-type
      444          ,input-output table-handle v-tth
      445         ) no-error .
      446       if not error-status :error  then do:
      447         assign
      448           v-tmp-str = v-value-character
      449         .
      450       end.
      451       delete object v-tth no-error.
      452       assign
      453         v-tmp-str     = replace(v-tmp-str, (chr(10) + chr(13)), chr(44) )
      454         v-tmp-str     = replace(v-tmp-str, (chr(13) + chr(10)), chr(44) )
      455         v-tmp-str     = replace(v-tmp-str, chr(10), chr(44) )
      456         v-num-entries = num-entries( v-tmp-str, chr(44) )
      457         v-email       = "":U
      458       .
      459       do v-ind = 1 to v-num-entries
      460       :
      461         assign
      462           v-tmp1-str = entry( v-ind, v-tmp-str, chr(44) )
      463         .
      464         if trim( v-tmp1-str ) <> "":U then do:
      465           if v-email = "":U then do:
      466             assign
      467               v-email = v-tmp1-str
      468             .
      469           end.
      470           else do:
      471             assign
      472               v-email = v-email + chr(44) + v-tmp1-str
      473             .
      474           end.
      475         end.
      476       end.
      477       if v-email <> "":U then do:
      478         run gbl/sendmail.p
      479           ( input v-email
      480           , input p-subject
      481           , input p-text-err
      482           , input p-attach-files
      483           ) no-error .
      484         if error-status :error
      485           or return-value <> "":U
      486         then do:
      487           return error substitute( "&1 (send-msg-to-email). &2", vss-workfile, return-value ) .
      488         end.
      489       end.
      490     end.
      491   end procedure.
      492   define  shared variable nws-exch-dir as character no-undo .
      493   define  shared variable nws-heap-dir as character no-undo .
      494   define variable err-mess as character no-undo .
