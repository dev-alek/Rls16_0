     1116   procedure ext-system-attr-batch-edit :
     1117     define input  parameter p-code           as character no-undo .
     1118     define output parameter p-section-num    as integer no-undo .
     1119     do
     1120     on error undo, return error
     1121     :
     1122           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run ext-system-attr-batch-edit in g#attr-lib
     1123         (input  p-code
     1124         ,output p-section-num
     1125         ) no-error .
     1126       if error-status :error
     1127       then do:
     1128         undo, return error return-value .
     1129       end.
     1130     end.
     1131   end procedure.
     1132   define variable p-news as logical no-undo.
     1133   define variable v-real-last-sent-pck as integer no-undo .
     1134   define variable v-real-last-rcv-pck as integer no-undo .
     1135   define variable v-curr-obj-type as character no-undo .
     1136   define variable v-curr-obj-code as integer no-undo .
     1137   define variable v-cmd-proc-handle as handle no-undo .
     1138   define variable v-command as character no-undo .
     1139   define variable v-cmd-code as integer no-undo .
     1140   define variable v-db-list as character no-undo .
     1141   do
     1142   on error undo, return error
     1143   :
     1144     for each pck-sent no-lock where pck-sent.db-num = p-db-num :
     1145       v-real-last-sent-pck = max(v-real-last-sent-pck, pck-sent.pack-num) .
     1146     end.
     1147     for each pck-rcvd no-lock where pck-rcvd.db-num = p-db-num :
     1148       v-real-last-rcv-pck = max(v-real-last-rcv-pck, pck-rcvd.pack-num) .
     1149     end.
     1150     if p-last-rcv-pck > v-real-last-sent-pck
     1151     then do :
     1152       return error "Номер последнего принятого пакета в УБД больше номера последнего отправленного пакета в ГБД!" .
     1153     end.
     1154     if p-last-sent-pck > v-real-last-rcv-pck
     1155     then do :
     1156       return error "Номер последнего отправленного пакета из УБД больше номера последнего принятого пакета в ГБД!" .
     1157     end.
     1158     if p-last-rcv-pck = v-real-last-sent-pck
     1159     and p-last-sent-pck = v-real-last-rcv-pck
     1160     then do :
     1161       return error "Номера последних пакетов в ГБД и УБД совпадают. Синхронизация не требуется." .
     1162     end.
     1163     find first ub.clients no-lock where ub.clients.obj-type = 'маг':U
     1164                                     and ub.clients.stts = 0
     1165                                     and ub.clients.db-num = p-db-num
     1166                                     no-error.
     1167     if not available ub.clients
     1168     then do :
     1169       return error  ("Не найден магазин в УБД " + string(p-db-num)) .
     1170     end.
     1171     for each pck-sent exclusive-lock where pck-sent.db-num = p-db-num and pck-sent.pack-num > p-last-rcv-pck :
     1172       for each route exclusive-lock where route.db-num = p-db-num and route.last-pack = pck-sent.pack-num :
     1173         delete route .
     1174       end.
     1175       delete pck-sent .
     1176     end.
     1177     for each pck-rcvd exclusive-lock where pck-rcvd.db-num = p-db-num and pck-rcvd.pack-num > p-last-sent-pck :
     1178       delete pck-rcvd .
     1179     end.
     1180     for each route exclusive-lock where route.db-num = p-db-num and route.last-pack = -1 :
     1181       delete route .
     1182     end.
     1183     v-curr-obj-type = ub.clients.obj-type .
     1184     v-curr-obj-code = ub.clients.obj-code .
     1185     run create-routes no-error.
     1186     if error-status :error then do:
     1187       return error return-value .
     1188     end.
     1189     assign pOk = yes .
     1190     run trg/userlog.p (
     1191           input 'utl'
     1192           , input ( ("Синхронизация новостей с УБД " +
     1193                   string(p-db-num) +
     1194                   substitute("; получ_до: &1; получ_после: &2; отпр_до: &3; отпр_после: 4", v-real-last-sent-pck, p-last-rcv-pck, v-real-last-rcv-pck, p-last-sent-pck) ) +
     1195                   chr(3) +
     1196                   "nws/nws-sync.p")
     1197           , input ?
     1198           , input ?
     1199           , input ""
     1200           ) no-error.
     1201     if error-status :error
     1202     then do:
     1203       return error ("Ошибка записи истории действий пользователя" + chr(10) + return-value + error-status:get-message(1)) .
     1204     end.
     1205     run write-to-log in this-procedure
     1206     ( input  substitute ("Произведена синхронизация новостей с УБД &1.&2Идентификатор пользователя: &3&2Номер последнего принятого пакета в УБД до синхронизации: &4&2Номер последнего принятого пакета в УБД после синхронизации: &5&2Номер последнего отправленного пакета из УБД до синхронизации: &6&2Номер последнего отправленного пакета из УБД после синхронизации: &7&2",
     1207                           string(p-db-num),
     1208                           chr(10),
     1209                           g#auto-user-id,
     1210                           v-real-last-sent-pck,
     1211                           p-last-rcv-pck,
     1212                           v-real-last-rcv-pck,
     1213                           p-last-sent-pck
     1214                            ) ) .
     1215   end .
     1216   procedure create-routes :
     1217     find first ub.db no-lock where ub.db.db-num = p-db-num .
     1218     run nws/cr-route.p ( input 'send-tbl':U, input 'db':U, input (buffer ub.db:handle), input string(p-db-num) ) no-error.
     1219     if error-status :error then do:
     1220       return error return-value.
     1221     end.
     1222     for each ub.db-attr no-lock where ub.db-attr.db-num = ub.db.db-num :
     1223       run db-attr-news in this-procedure
     1224         ( input ub.db-attr.attr-code
     1225          ,output p-news
     1226         ) no-error.
     1227       if p-news = true then do:
     1228         run nws/cr-route.p ( input 'send-tbl':U, input 'db-attr':U, input (buffer ub.db-attr:handle), input string(p-db-num) ) no-error.
     1229         if error-status :error then do:
     1230           return error return-value.
     1231         end.
     1232       end.
     1233     end.
     1234     find first ub.clients no-lock where ub.clients.obj-type = v-curr-obj-type
     1235                                     and ub.clients.obj-code = v-curr-obj-code .
     1236     run nws/cr-route.p ( input 'send-tbl':U, input 'clients':U, input (buffer ub.clients:handle), input string(p-db-num) ) no-error.
     1237     if error-status :error then do:
     1238       return error return-value.
     1239     end.
     1240     find first ub.shop no-lock where ub.shop.obj-code = ub.clients.obj-code .
     1241     run nws/cr-route.p ( input 'send-tbl':U, input 'shop':U, input (buffer ub.shop:handle), input string(p-db-num) ) no-error.
     1242     if error-status :error then do:
     1243       return error return-value.
     1244     end.
     1245     for each ub.clients-attr no-lock where  ub.clients-attr.obj-type = ub.clients.obj-type
     1246                                         and ub.clients-attr.obj-code = ub.clients.obj-code :
     1247       run clntattr-news in this-procedure(input ub.clients-attr.attr-code,
     1248                                           output p-news) no-error.
     1249       if  p-news then do:
     1250         run nws/cr-route.p ( input 'send-tbl':U, input 'clients-attr':U, input (buffer ub.clients-attr:handle), input string(p-db-num) ) no-error.
     1251         if error-status :error then do:
     1252           return error return-value.
     1253         end.
     1254       end.
     1255     end.
     1256     for each ub.ext-system no-lock where ub.ext-system.esys-db-num-exp = p-db-num or ub.ext-system.esys-db-num-imp = p-db-num :
     1257       run nws/cr-route.p ( input 'send-tbl':U, input 'ext-system':U, input (buffer ub.ext-system:handle), input string(p-db-num) ) no-error.
     1258       if error-status :error then do:
     1259         return error return-value.
     1260       end.
     1261       for each ub.ext-system-attr no-lock where ub.ext-system-attr.esys-id  = ub.ext-system.esys-id
     1262                                             and ub.ext-system-attr.db-num   = ub.ext-system.db-num :
     1263         run ext-system-attr-news in this-procedure ( input ub.Ext-system-attr.esya-attr-code
     1264                                                     ,output p-news).
     1265         if  p-news then do:
     1266           run nws/cr-route.p ( input 'send-tbl':U, input 'ext-system-attr':U, input (buffer ub.ext-system-attr:handle), input string(p-db-num) ) no-error.
     1267           if error-status :error then do:
     1268             return error return-value.
     1269           end.
     1270         end.
     1271       end.
     1272     end.
     1273     for each ub.user-login-action-role no-lock where ub.user-login-action-role.db-num = p-db-num :
     1274       run nws/cr-route.p ( input 'send-tbl':U, input 'user-login-action-role':U, input (buffer ub.user-login-action-role:handle), input string(p-db-num) ) no-error.
     1275       if error-status :error then do:
     1276         return error return-value.
     1277       end.
     1278     end.
     1279     for each ub.action-role no-lock where ub.action-role.db-num = p-db-num :
     1280       run nws/cr-route.p ( input 'send-tbl':U, input 'action-role':U, input (buffer ub.action-role:handle), input string(p-db-num) ) no-error.
     1281       if error-status :error then do:
     1282         return error return-value.
     1283       end.
     1284     end.
     1285     for each ub.action-role-item no-lock where ub.action-role-item.db-num = p-db-num :
     1286       run nws/cr-route.p ( input 'send-tbl':U, input 'action-role-item':U, input (buffer ub.action-role-item:handle), input string(p-db-num) ) no-error.
     1287       if error-status :error then do:
     1288         return error return-value.
     1289       end.
     1290     end.
     1291     for each ub.schedule no-lock :
     1292       run nws/cr-route.p ( input 'send-tbl':U, input 'schedule':U, input (buffer ub.schedule:handle), input string(p-db-num) ) no-error.
     1293       if error-status :error then do:
     1294         return error return-value.
     1295       end.
     1296       for each ub.schedule-attr no-lock where ub.schedule-attr.cre-db-num = ub.schedule.cre-db-num
     1297                                           and ub.schedule-attr.task-type  = ub.schedule.task-type
     1298                                           and ub.schedule-attr.task-num   = ub.schedule.task-num
     1299                                           and ub.schedule-attr.task-num  <> -1 :
     1300         run nws/cr-route.p ( input 'send-tbl':U, input 'schedule-attr':U, input (buffer ub.schedule-attr:handle), input string(p-db-num) ) no-error.
     1301         if error-status :error then do:
     1302           return error return-value.
     1303         end.
     1304       end.
     1305     end.
     1306     for each ub.config no-lock where ub.config.db-num = p-db-num :
     1307       run nws/cr-route.p ( input 'send-tbl':U, input 'config':U, input (buffer ub.config:handle), input string(p-db-num) ) no-error.
     1308       if error-status :error then do:
     1309         return error return-value.
     1310       end.
     1311     end.
     1312     for each ub.thbj-attr no-lock :
     1313       run nws/cr-route.p ( input 'send-tbl':U, input 'thbj-attr':U, input (buffer ub.thbj-attr:handle), input string(p-db-num) ) no-error.
     1314       if error-status :error then do:
     1315         return error return-value.
     1316       end.
     1317     end.
     1318     for each ub.clients no-lock :
     1319       if ub.clients.obj-type = v-curr-obj-type and ub.clients.obj-code = v-curr-obj-code
     1320       then next .
     1321       run nws/cr-route.p ( input 'send-tbl':U, input 'clients':U, input (buffer ub.clients:handle), input string(p-db-num) ) no-error.
     1322       if error-status :error then do:
     1323         return error return-value.
     1324       end.
     1325       for each ub.clients-attr no-lock where  ub.clients-attr.obj-type = ub.clients.obj-type
