     1100   procedure ext-system-attr-manual-edit :
     1101     define input  parameter p-code           as character no-undo .
     1102     define output parameter p-section-num    as integer no-undo .
     1103     do
     1104     on error undo, return error
     1105     :
     1106           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run ext-system-attr-manual-edit in g#attr-lib
