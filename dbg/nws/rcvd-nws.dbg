      850   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      851   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      852   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
      853   define variable par-type          as character no-undo.
      854   define variable v-value-character as character no-undo .
      855   define variable v-value-date      as date      no-undo .
      856   define variable v-value-decimal   as decimal   no-undo .
      857   define variable v-value-integer   as integer   no-undo .
      858   define variable v-value-logical   as logical   no-undo .
      859   do
      860   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      861   on stop   undo, return error substitute( "&1. stop", vss-workfile )
      862   on endkey undo, return error substitute( "&1. endkey", vss-workfile )
      863   :
      864     define buffer buf_db       for ub.db .
      865     define buffer buf_sys-ctrl for ub.sys-ctrl .
      866     define buffer buf_db-attr  for ub.db-attr .
      867     define variable v-ver-num      as character no-undo .
      868     define variable v-pack-num     as integer   no-undo .
      869     define variable v-pack-name    as character no-undo .
      870     define variable v-source-dir   as character no-undo .
      871     define variable v-target-dir   as character no-undo .
      872     define variable v-temp-dir     as character no-undo .
      873     define variable v-rcvd-pack    as logical   no-undo .
      874     define variable v-err-msg      as character no-undo .
      875     define variable v-mem as memptr no-undo .
      876     define variable v-str as longchar no-undo .
      877     define variable v-last-rcv-pck as integer no-undo .
      878     define variable v-last-sent-pck as integer no-undo .
      879     define variable vOk as logical no-undo .
      880     define variable apusharh as logical   no-undo .
      881     find first buf_sys-ctrl no-lock .
      882     run get-version-num in parparentproc
      883       ( output v-ver-num
      884       ).
      885     find first buf_db no-lock
      886       where buf_db.db-num = p-db-num
      887       no-error
      888     .
      889     if not available buf_db then do:
      890       run write-to-log( substitute( "&1. БД &2 не найдена", vss-workfile, p-db-num ) ) .
      891       return error.
      892     end.
      893     if buf_db.db-key = "":U
      894       or buf_db.db-key = ?
      895     then do:
      896       run write-to-log( substitute("СПН для БД &1 отключена. Пакеты новостей не принимаются.", p-db-num ) ) .
      897       return.
      898     end.
      899     case p-action:
      900       when "take":U then do:
      901         run write-to-log( substitute("Прием пакетов новостей из БД &1", p-db-num ) ) .
      902       end.
      903       when "analys":U then do:
      904         run write-to-log( substitute("Разбор пакетов новостей из БД &1", p-db-num ) ) .
      905       end.
      906       when "take+analys":U then do:
      907         run write-to-log( substitute("Прием и разбор пакетов новостей из БД &1", p-db-num ) ) .
      908       end.
      909       otherwise do:
      910         message vss-workfile vss-revision vss-description skip
      911                 substitute( "Не предусмотрена операция &1", p-action )
      912                 view-as alert-box error.
      913         return error.
      914       end.
      915     end case.
      916     assign
      917       g#news-source-db = p-db-num
      918     .
      919     run nws/lock-nws.p
      920       ( input p-db-num
      921        ,buffer buf_db
      922       ) no-error.
      923     if error-status:error then do:
      924       run write-to-log( substitute( "&1. &2", vss-workfile, return-value ) ).
      925       return .
      926     end.
      927     assign
      928       v-pack-num = -1
      929       v-rcvd-pack = false
      930     .
      931     run nws/pck-num.p
      932       ( input "get":U
      933        ,input p-db-num
      934        ,input-output v-pack-num
      935        ,output v-pack-name
      936        ,output v-source-dir
      937        ,output v-target-dir
      938        ,output v-temp-dir
      939       ) no-error.
      940     if error-status:error then do:
      941       run write-to-log( substitute( "&1. Ошибка при генерации номера пакета. &2&3&2&4", vss-workfile, chr(10), error-status:get-message(1), return-value )
      942                       ) .
      943       return error.
      944     end.
      945     if lookup( p-action, "take,take+analys":U ) <> 0 then do:
      946       run nws/s-g-pack.p
      947         ( input "get":U
      948          ,input ?
      949          ,input ?
      950          ,input v-source-dir
      951          ,input v-target-dir
      952          ,input v-temp-dir
      953         ) no-error.
      954       if error-status:error then do:
      955         run write-to-log( substitute( "&1. &2", vss-workfile, return-value ) ).
      956         return error.
      957       end.
      958     end.
      959     if lookup( p-action, "analys,take+analys":U ) <> 0
      960     then do:
      961       if p-db-num > 0
      962       then do transaction :
      963         assign
      964           file-info:file-name = v-target-dir + chr(92) + "p9999999.txt"
      965         .
      966         if file-info:file-type <> ?
      967         and file-info:file-type begins "F":U
      968         then do :
      969           copy-lob from file (v-target-dir + chr(92) + "p9999999.txt") to v-str .
      970           v-mem = base64-decode (v-str) no-error .
      971           copy-lob from v-mem to v-str no-error .
      972           if v-str begins "needsync"
      973           and num-entries(v-str, chr(4)) = 5
      974           then do :
      975             os-delete value (v-target-dir + chr(92) + "p9999999.txt") no-error .
      976             os-delete value (v-source-dir + chr(92) + "p9999999.zip") no-error .
      977             find first buf_db-attr no-lock where buf_db-attr.db-num = p-db-num
      978                                              and buf_db-attr.attr-code = "last-nws-sync"
      979             no-error .
      980             if integer(entry(2, v-str, chr(4))) = p-db-num
      981             and (not available buf_db-attr
      982                  or (available buf_db-attr and datetime-tz(buf_db-attr.attr-value) < datetime-tz(entry(5, v-str, chr(4))))
      983                  )
      984             then do :
      985               run write-to-log( substitute( "Получен запрос на синхронизацию обмена СПН с БД &1", p-db-num ) ) .
      986               run nws/pck-num.p
      987                 ( input "put":U
      988                  ,input p-db-num
      989                  ,input-output v-pack-num
      990                  ,output v-pack-name
      991                  ,output v-source-dir
      992                  ,output v-target-dir
      993                  ,output v-temp-dir
      994                 ) no-error.
      995               if error-status:error then do:
      996                 run write-to-log( substitute( "&1. Ошибка при генерации номера пакета. &2&3&2&4", vss-workfile, chr(10), error-status:get-message(1), return-value )
      997                                 ) .
      998                 return error.
      999               end.
     1000               os-delete value (v-source-dir) recursive .
     1001               os-delete value (v-target-dir) recursive .
     1002               os-delete value (v-temp-dir)   recursive .
     1003               assign
     1004                 file-info:file-name = v-source-dir
     1005               .
     1006               if file-info:file-type = ?
     1007               or not ( file-info:file-type begins "D":U )
     1008               then do:
     1009                 os-create-dir value( v-source-dir ).
     1010                 if os-error <> 0 then do:
     1011                   return error string( vss-workfile + chr(32)
     1012                                        + "Каталог" + chr(32) + v-source-dir
     1013                                        + chr(32) + "отсутствует, а создать его не удалось." ).
     1014                 end.
     1015               end.
     1016               assign
     1017                 file-info:file-name = v-target-dir
     1018               .
     1019               if file-info:file-type = ?
     1020               or not ( file-info:file-type begins "D":U )
     1021               then do:
     1022                 os-create-dir value( v-target-dir ).
     1023                 if os-error <> 0 then do:
     1024                   return error string( vss-workfile + chr(32)
     1025                                        + "Каталог" + chr(32) + v-target-dir
     1026                                        + chr(32) + "отсутствует, а создать его не удалось." ).
     1027                 end.
     1028               end.
     1029               assign
     1030                 v-last-rcv-pck  = integer(entry(3, v-str, chr(4)))
     1031                 v-last-sent-pck = integer(entry(4, v-str, chr(4)))
     1032               .
     1033               run nws/nws-sync.p (input parparentproc,
     1034                                   input p-db-num,
     1035                                   input v-last-rcv-pck,
     1036                                   input v-last-sent-pck,
     1037                                   output vOk)
     1038                                   no-error .
     1039               if not vOk
     1040               or error-status:error
     1041               then do :
     1042                 run write-to-log( substitute( "Ошибка при синхронизация обмена СПН с БД &1&2&3", p-db-num, chr(10), return-value ) ) .
     1043               end .
     1044               if vOk
     1045               then do :
     1046                 run db-attr-write in this-procedure
     1047                 ( input p-db-num
     1048                  ,input "last-nws-sync"
     1049                  ,input entry(5, v-str, chr(4))
     1050                 ) no-error.
     1051                 return .
     1052               end .
     1053             end .
     1054           end .
     1055         end .
     1056       end .
     1057       rcvd-pack:
     1058       do while TRUE
     1059       on error  undo, return error substitute( "&1 (rcvd-pack). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1060       on stop   undo, return error substitute( "&1 (rcvd-pack). stop", vss-workfile )
     1061       on endkey undo, return error substitute( "&1 (rcvd-pack). endkey", vss-workfile )
     1062       :
     1063         run nws/pck-num.p
     1064           ( input "get":U
     1065            ,input p-db-num
     1066            ,input-output v-pack-num
     1067            ,output v-pack-name
     1068            ,output v-source-dir
     1069            ,output v-target-dir
     1070            ,output v-temp-dir
     1071           ) no-error.
     1072         if error-status:error then do:
     1073           run write-to-log( substitute( "&1. Ошибка при генерации номера пакета. &2&3&2&4", vss-workfile, chr(10), error-status:get-message(1), return-value )
     1074                           ) .
     1075           return error.
     1076         end.
     1077         assign
     1078           file-info:file-name = v-target-dir + chr(92) + v-pack-name
     1079         .
     1080         if file-info:file-type = ?
     1081           or not ( file-info:file-type begins "F":U ) then do:
     1082           leave rcvd-pack.
     1083         end.
     1084         run nws/imp-pck.p
     1085           ( input parparentproc
     1086           , input p-db-num
     1087           , input v-pack-num
     1088           , input v-target-dir + chr(92) + v-pack-name
     1089           ) no-error.
     1090         if error-status:error then do:
     1091           assign
     1092             v-err-msg = substitute("&1. Ошибка импорта пакета &3\&4&2&5&2&6", vss-workfile, chr(10), v-target-dir, v-pack-name, error-status :get-message( 1 ), return-value )
     1093           .
     1094           run write-to-log( v-err-msg ) .
     1095           run send-msg-to-email in parparentproc
     1096             ( input substitute( "ТН (ver &1) БД &2. Ошибка СПН при импорте пакета из БД &2", v-ver-num, buf_sys-ctrl.db-num, p-db-num )
     1097              ,input v-err-msg
     1098              ,input "":U
     1099             ) no-error .
     1100           if error-status :error then do:
     1101             run write-to-log( substitute( "&1. &3&2&4", vss-workfile, chr(10), error-status:get-message(1), return-value )
     1102                             ) .
     1103           end.
     1104           return error.
     1105         end.
     1106         assign
     1107           v-rcvd-pack = true
     1108           v-pack-num = v-pack-num + 1
     1109         .
     1110         if ( p-pack-num <> -1
     1111              and v-pack-num > p-pack-num
     1112            )
     1113         then do:
     1114           leave rcvd-pack.
     1115         end.
     1116       end.
     1117       if v-rcvd-pack = true then do:
     1118   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1119   empty temp-table thbjattr_thbj-attr.
     1120   run adm/shattri.p (
     1121      input "get":U
     1122     ,input ''
     1123     ,input 0
     1124     ,input 'arh-global':U
     1125     ,input  ""
     1126     ,output v-value-character
     1127     ,output v-value-date
     1128     ,output v-value-decimal
     1129     ,output v-value-integer
     1130     ,output v-value-logical
     1131     ,output par-type
     1132     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     1133     ) no-error .
     1134         for each thbjattr_thbj-attr :
     1135             if thbjattr_thbj-attr.prop-code = 'apusharh'  then apusharh = thbjattr_thbj-attr.property-value-logical.
     1136         end.
     1137         empty temp-table thbjattr_thbj-attr.
     1138         if apusharh then do:
     1139           run push-abtpr in this-procedure
     1140             ( input auto-window-h
     1141              ,input p-db-num
     1142              ,input 'autoarh':U
     1143              ,input "news-push":U
     1144              ,input ?
     1145              ,input ?
     1146             ) no-error .
     1147           if error-status :error then do:
     1148             run write-to-log( substitute( "&1. Ошибка при изменении времени запуска автоматического расчета архивов. &2&3&2&4"
     1149                                           , vss-workfile
     1150                                           , chr(10)
     1151                                           , error-status:get-message(1)
     1152                                           , return-value
     1153                                         )
     1154                             ) .
     1155           end.
     1156         end.
     1157       end.
     1158     end.
     1159     run gbl/del-file.p
     1160       ( input v-temp-dir
     1161       ) no-error .
     1162     if error-status:error then do:
     1163       run write-to-log(  substitute( "&1. &2", vss-workfile, return-value ) ).
     1164     end.
     1165     case p-action:
     1166       when "take":U then do:
     1167         run write-to-log( substitute( "Завершен прием пакетов новостей из БД &1", p-db-num ) ) .
     1168       end.
     1169       when "analys":U then do:
     1170         run write-to-log( substitute( "Завершен разбор пакетов новостей из БД &1", p-db-num ) ) .
     1171       end.
     1172       when "take+analys":U then do:
     1173         run write-to-log( substitute( "Завершен прием и разбор пакетов новостей из БД &1", p-db-num ) ) .
     1174       end.
     1175     end case.
     1176     return.
     1177   end.
