     1511   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftaxval in g#library
     1512     (input  recid(ub.tax-rate)
     1513     ,input  0
     1514     ,input  0
     1515     ,input  ?
     1516     ,input  p-host-code
     1517     ,input  p-obj-type
     1518     ,input  p-obj-code
     1519     ,output cash-txr.rate-value
     1520     ) no-error .
     1521                           if error-status:error then next _tax-rate2.
     1522          END.
     1523       end.
     1524       find first cash-txr where
     1525             cash-txr.tax-code = p-tax-code
     1526         AND cash-txr.rate-code = p-rate-code
     1527         no-error .
     1528       if not avail cash-txr and  p-status_ <> 'удал':U
     1529       then do:
     1530          create cash-txr.
     1531          assign
     1532          cash-txr.tax-code  = p-tax-code
     1533          cash-txr.rate-code = p-rate-code
     1534          cash-txr.host-code = p-host-code
     1535          cash-txr.obj-type  = p-obj-type
     1536          cash-txr.obj-code  = p-obj-code
     1537          cash-txr.tax-type  = p-tax-type
     1538          cash-txr.crf       = p-crf
     1539          cash-txr.rc        = p-rec
     1540          cash-txr.status_   = (if p-status_ = ? then 'тек':U else p-status_)
     1541          .
     1542       end.
     1543       if  avail cash-txr
     1544       then do:
     1545          if p-status_ eq 'удал':U
     1546          then
     1547             delete cash-txr.
     1548          else assign
     1549          cash-txr.tax-code  = p-tax-code
     1550          cash-txr.rate-code = p-rate-code
     1551          cash-txr.host-code = p-host-code
     1552          cash-txr.obj-type  = p-obj-type
     1553          cash-txr.obj-code  = p-obj-code
     1554          cash-txr.tax-type  = p-tax-type
     1555          cash-txr.crf       = p-crf
     1556          cash-txr.rc        = p-rec
     1557          cash-txr.status_   = (if p-status_ = ? then 'тек':U else p-status_)
     1558          .
     1559       end.
     1560       release cash-txr.
     1561     end.
     1562   end.
     1563   end procedure.
     1564   procedure fill-stpl-list :
     1565   define parameter buffer buf_stop-list for ub.stop-list.
     1566   do
     1567   on error undo, return error
     1568   :
     1569     find first stpl-list where
     1570               stpl-list.classif-type =  buf_stop-list.classif-type
     1571           and stpl-list.stop-list-code = buf_stop-list.stop-list-code no-error .
     1572     if not avail stpl-list then do:
     1573       create stpl-list.
     1574       buffer-copy buf_stop-list
     1575       to stpl-list.
     1576       release stpl-list.
     1577     end.
     1578   end.
     1579   end procedure.
     1580   procedure fill-pbc-list :
     1581   define input parameter p-rc as recid no-undo .
     1582   define input parameter p-gds-code as integer no-undo .
     1583   define input parameter p-b-code as integer no-undo .
     1584   define input parameter p-b-str as character no-undo .
     1585   define input parameter p-bc-on as logical no-undo .
     1586   define input parameter p-del as logical no-undo .
     1587   do
     1588   on error undo, return error
     1589   :
     1590     if p-bc-on = false
     1591     or p-del = yes
     1592     or not can-find(gds-list where gds-list.gds-code     = p-gds-code
     1593                               no-lock ) then do:
     1594       find first pbc-list where pbc-list.rc = p-rc no-error.
     1595       if not available pbc-list then do:
     1596         create pbc-list.
     1597       end.
     1598       assign
     1599       pbc-list.b-code = p-b-code
     1600       pbc-list.b-str = p-b-str
     1601       pbc-list.rc = p-rc
     1602       pbc-list.bc-on = p-bc-on
     1603       pbc-list.del = p-del
     1604       .
     1605       release pbc-list .
     1606     end.
     1607   end.
     1608   end procedure.
     1609   procedure fill-bar-code :
     1610   define input parameter p-b-code as integer no-undo .
     1611   define input parameter p-gds-code as integer no-undo .
     1612   define input parameter p-del as logical no-undo .
     1613   define input parameter p-node-code as integer no-undo .
     1614   define input parameter p-in-code as character no-undo .
     1615   define input parameter p-part-code as character no-undo .
     1616   define input parameter p-cli-base-rate as decimal no-undo .
     1617   define input parameter p-unit-cli as character no-undo .
     1618   do
     1619   on error undo, return error
     1620   :
     1621     if p-del = yes
     1622     or not can-find(gds-list where gds-list.gds-code     = p-gds-code
     1623                               no-lock ) then do:
     1624       find first bc-list where
     1625               bc-list.b-code = p-b-code and bc-list.del = p-del no-error.
     1626       if not avail bc-list then do:
     1627         create bc-list.
     1628         assign
     1629         bc-list.gds-code = p-gds-code
     1630         bc-list.b-code = p-b-code
     1631         bc-list.node-code = p-node-code
     1632         bc-list.in-code = p-in-code
     1633         bc-list.part-code = p-part-code
     1634         bc-list.cli-base-rate = p-cli-base-rate
     1635         bc-list.unit-cli = p-unit-cli
     1636         bc-list.del = p-del
     1637         .
     1638       end.
     1639     end.
     1640   end.
     1641   end procedure.
     1642   procedure fill-pdf :
     1643   define input parameter p-plt-id as integer no-undo .
     1644   define input parameter p-plt-db-num as integer no-undo .
     1645   define input parameter p-pdf-id as integer no-undo .
     1646   define input parameter p-pdf-db-num as integer no-undo .
     1647   define input parameter p-del as logical no-undo .
     1648   define buffer buf_pdf-list for pdf-list.
     1649   do
     1650   on error undo, return error
     1651   :
     1652     find first pdf-list where
     1653              pdf-list.plt-id = p-plt-id
     1654          and pdf-list.plt-db-num = p-plt-db-num
     1655          and pdf-list.pdf-id = p-pdf-id
     1656          and pdf-list.pdf-db = p-pdf-db-num no-error.
     1657     if not available pdf-list then do:
     1658       find last buf_pdf-list use-index oi no-error.
     1659       create pdf-list.
     1660       assign
     1661       pdf-list.plt-id = p-plt-id
     1662       pdf-list.plt-db-num = p-plt-db-num
     1663       pdf-list.pdf-id = p-pdf-id
     1664       pdf-list.pdf-db = p-pdf-db-num
     1665       pdf-list.to-del = p-del
     1666       pdf-list.order-num = (if available buf_pdf-list then buf_pdf-list.order-num + 1 else 1)
     1667       .
     1668       release pdf-list.
     1669     end.
     1670   end.
     1671   end procedure.
     1672   def var vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1673   procedure check-avail-artic:
     1674     define input parameter chg-artic     like ub.goods.artic     no-undo.
     1675     define input parameter chg-prod-type like ub.goods.prod-type no-undo.
     1676     define input parameter chg-prod-code like ub.goods.prod-code no-undo.
     1677     do
     1678     on error  undo, return error
     1679     on stop   undo, return error
     1680     on endkey undo, return error :
     1681       define buffer buf_goods for ub.goods .
     1682       if not can-find( buf_goods where buf_goods.artic     = chg-artic
     1683                                    and buf_goods.prod-type = chg-prod-type
     1684                                    and buf_goods.prod-code = chg-prod-code
     1685                                  no-lock )
     1686       then do:
     1687           run write-to-log ( "Не найден товар: артикул" + chr(32) + chg-artic + chr(32)
     1688                              + "производитель" + chr(32) + chg-prod-type + chr(32)
     1689                              + string( chg-prod-code )
     1690                              + chr(10) + "Возможно этот товар был переименован."
     1691                              + chr(10) + "Обменяйтесь новостями и повторите прием пакета."
     1692                            ).
     1693         return error.
     1694       end.
     1695     end.
     1696     return.
     1697   end procedure.
     1698   procedure check-avail-gds-code:
     1699     define input-output parameter chg-gds-code like ub.goods.gds-code no-undo.
     1700     do
     1701     on error  undo, return error
     1702     on stop   undo, return error
     1703     on endkey undo, return error :
     1704       define buffer buf_goods for ub.goods .
     1705       define buffer buf_route for ub.route .
     1706       find buf_goods where buf_goods.gds-code = chg-gds-code
     1707                     no-lock no-error.
     1708       if not available buf_goods then do:
     1709         do-sch:
     1710         for each buf_route no-lock
     1711           where buf_route.name-rec begins ("command" + chr(1)
     1712                                            + "goods" + chr(1)
     1713                                            + "ren-gds-code" + chr(1)
     1714                                            + string(chg-gds-code)
     1715                                           )
     1716         on error  undo, return error
     1717         :
     1718           assign
     1719             chg-gds-code = int(entry(5,buf_route.name-rec,chr(1)))
     1720             .
     1721           leave do-sch.
     1722         end.
     1723       end.
     1724     end.
     1725     return.
     1726   end procedure.
     1727   PROCEDURE check-avail-b-code :
     1728     define input-output parameter loc-b-code like ub.bar-code.b-code no-undo.
     1729     do
     1730     on error  undo, return error
     1731     on endkey undo, return error
     1732     on stop   undo, return error :
     1733       define variable sought-b-code  like ub.bar-code.b-code no-undo.
     1734       define variable bar_code      like ub.prod-bc.b-str   no-undo .
     1735       define buffer buf_bar-code for ub.bar-code .
     1736       define buffer buf_prod-bc  for ub.prod-bc .
     1737       assign sought-b-code = loc-b-code .
     1738       find buf_bar-code where buf_bar-code.b-code = sought-b-code no-lock no-error.
     1739       if available buf_bar-code then do:
     1740         assign loc-b-code = buf_bar-code.b-code.
     1741       end.
     1742       else do :
     1743         run gen-bc( input sought-b-code, output bar_code ).
     1744         find first buf_prod-bc where buf_prod-bc.b-str = bar_code no-lock no-error.
     1745         if available buf_prod-bc then do:
     1746           assign loc-b-code = buf_prod-bc.b-code .
     1747           find next buf_prod-bc where buf_prod-bc.b-str = bar_code no-lock no-error.
     1748           if available buf_prod-bc then do:
     1749             assign loc-b-code = ? .
     1750               run write-to-log ( "Системная ошибка!!! При перепривязке к собственному коду найдено несколько Доп.БК с одинаковыми кодами" ).
     1751             return error.
     1752           end.
     1753         end.
     1754         else do:
     1755           assign loc-b-code = ?.
     1756             run write-to-log ( substitute( "Системная ошибка!!! Нет собственного кода (&1), к которому можно перепривязать Доп.БК или строку переоценки", sought-b-code ) ).
     1757           return error.
     1758         end.
     1759       end.
     1760     end.
     1761   END PROCEDURE.
