     1476   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftaxval in g#library
     1477     (input  recid(ub.tax-rate)
     1478     ,input  0
     1479     ,input  0
     1480     ,input  ?
     1481     ,input  p-host-code
     1482     ,input  p-obj-type
     1483     ,input  p-obj-code
     1484     ,output cash-txr.rate-value
     1485     ) no-error .
     1486                           if error-status:error then next _tax-rate.
     1487          END.
     1488       end.
     1489       else do:
     1490          for each cash-txr where cash-txr.tax-code = tax-rate.tax-code:
     1491             delete cash-txr.
     1492          end.
     1493          _tax-rate2:
     1494           FOR EACH ub.tax-rate NO-LOCK WHERE
     1495                             ub.tax-rate.tax-code = buf_tax.tax-code
     1496                         and ub.tax-rate.status_  <>   'удал':U:
     1497                           create cash-txr.
     1498                           assign
     1499                           cash-txr.tax-code = tax-rate.tax-code
     1500                           cash-txr.rate-code = tax-rate.rate-code
     1501                           cash-txr.tax-type = buf_tax.tax-type
     1502                           cash-txr.host-code = p-host-code
     1503                           cash-txr.obj-type = p-obj-type
     1504                           cash-txr.obj-code = p-obj-code
     1505                           cash-txr.status_ = tax-rate.status_
     1506                           cash-txr.rc = RECID(tax-rate)
     1507                           cash-txr.crf = ii
     1508                           ii = ii + 1
     1509                           .
