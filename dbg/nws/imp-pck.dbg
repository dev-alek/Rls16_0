      976   field order-num as integer
      977   field obj-type like ub.clients.obj-type
      978   field obj-code like ub.clients.obj-code
      979   index art  is primary unique artic prod-type prod-code obj-type obj-code
      980   index code is         unique gds-code obj-type obj-code
      981   index oi order-num
      982   index iobj obj-type obj-code gds-code
      983   .
      984   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      985   DEFINE new shared TEMP-TABLE cash-txn no-undo
      986   FIELD tax-code like ub.tax.tax-code
      987   FIELD tax-name like ub.tax.tax-name
      988   FIELD news-action as logical
      989   index pi IS UNIQUE PRIMARY tax-code.
      990   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      991   define new shared temp-table cash-txr no-undo
      992     field tax-code    like ub.tax.tax-code
      993     field rate-code   like ub.tax-rate.rate-code
      994     field host-code   like ub.sysconf.host-code
      995     field obj-type    like ub.clients.obj-type
      996     field obj-code    like ub.clients.obj-code
      997     field tax-type    like ub.tax.tax-type
      998     field status_     like ub.tax-rate-value.status_
      999     field rate-value  as decimal
     1000     field rc          as recid
     1001     field crf         as integer
     1002     field news-action as logical
     1003     index pi is unique primary tax-code host-code obj-type obj-code status_ rc
     1004     index crf-i  crf host-code obj-type obj-code rc
     1005   .
     1006   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1007   define new shared temp-table pdf-list no-undo like ub.price-doc-forming
     1008   field to-del     as logical
     1009   field order-num  as integer
     1010   index pi  is primary unique plt-id plt-db-num pdf-id pdf-db
     1011   index oi order-num
     1012   .
     1013   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1014   DEFINE new shared TEMP-TABLE cash-pay-list no-undo
     1015   FIELD cdpay-code as integer
     1016   FIELD curr-code as integer
     1017   index pi IS PRIMARY unique cdpay-code curr-code
     1018   .
     1019   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1020   DEFINE new shared TEMP-TABLE ext-classif-list no-undo
     1021      FIELD db-num as integer
     1022      field Key#One as integer
     1023      field Key#Two as integer
     1024      field CharKey_One as character
     1025   index pi IS PRIMARY unique db-num Key#Two Key#One CharKey_One
     1026   .
     1027   DEFINE new shared TEMP-TABLE c-ext-classif-list no-undo
     1028      FIELD db-num as integer
     1029      field Key#One as integer
     1030      field Key#Two as integer
     1031      field CharKey_One as character
     1032      field chip-num as integer
     1033   index pi IS PRIMARY unique db-num Key#Two Key#One CharKey_One chip-num
     1034   .
     1035   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1036   DEFINE new shared TEMP-TABLE PromoAction-list no-undo
     1037   FIELD ID as int64
     1038   FIELD db-num as integer
     1039   FIELD del_ as logical
     1040   index pi IS PRIMARY unique ID db-num
     1041   .
     1042   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1043   DEFINE new shared TEMP-TABLE thbjattr-list no-undo like ub.thbj-attr .
     1044   define new shared var sendEMRC   as logical no-undo.
     1045   define new shared var settingUpd as logical no-undo.
     1046   define new shared var sendMarkType as logical no-undo.
     1047   define new shared var sendGisMt as logical no-undo.
     1048   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1049   procedure send-to-cash:
     1050     if not can-find(first ub.cash-desk where
     1051                     ub.cash-desk.db-num = ibs.th.gbl.gbl-var:g#db-num AND
     1052                     ub.cash-desk.cash-on = yes) then return.
     1053     do
     1054     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1055     on stop   undo , return error substitute( "&1. stop", vss-workfile )
     1056     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     1057     :
     1058       if can-find(first gds-list no-lock)
     1059       or can-find(first gdsolist no-lock)
     1060       or can-find(first bc-list no-lock)
     1061       or can-find(first pbc-list no-lock)
     1062       or can-find(first cash-txn no-lock)
     1063       or can-find(first cash-txr no-lock)
     1064       or can-find(first dc-list no-lock)
     1065       or can-find(first dc-dis-card-mask no-lock)
     1066       or can-find(first stpl-list no-lock)
     1067       or can-find(first pdf-list no-lock)
     1068       or can-find(first cash-pay-list no-lock)
     1069       or can-find(first ext-classif-list no-lock)
     1070       or can-find(first c-ext-classif-list no-lock)
     1071       or can-find(first PromoAction-list no-lock)
     1072       or can-find(first thbjattr-list no-lock)
     1073       or sendEMRC
     1074       or settingUpd
     1075       or sendMarkType
     1076       then do:
     1077         run str/diallog.w (
     1078                            input ?
     1079                           ,input ?
     1080                           ,input 'str/sendnall.p':U
     1081                           ,input string(ibs.th.gbl.gbl-var:g#db-num)
     1082                           ,input yes
     1083                           ,input '':U
     1084                           ,input 'Отправка информации на кассу') no-error .
     1085       end.
     1086     end.
     1087   end procedure.
     1088   procedure fill-setting :
     1089      define input parameter i-obj      as character no-undo .
     1090      define input parameter i-obj-type as character no-undo .
     1091      define input parameter i-obj-code as integer   no-undo .
     1092      define input parameter i-parent   as character no-undo .
     1093      define input parameter i-code     as character no-undo .
     1094      define buffer buf_thbj-attr for ub.thbj-attr.
     1095      define buffer buf_sys-ctrl for ub.sys-ctrl.
     1096      define buffer buf_clients for ub.clients.
     1097      define variable v-db-num    as integer no-undo.
     1098      define variable v-shop-code as integer no-undo.
     1099      define variable v-reg-code  as integer no-undo.
     1100      settingUpd = yes.
     1101      sendGisMt = no.
     1102      if i-obj = "thbj-attr"
     1103      then do:
     1104         v-db-num  = ibs.th.gbl.gbl-var:g#db-num.
     1105         if v-db-num <> 0 then do:
     1106             find first buf_clients no-lock
     1107                  where buf_clients.obj-type = 'маг':U
     1108                    and buf_clients.db-num   = v-db-num
     1109                no-error.
     1110             if available buf_clients then v-shop-code = buf_clients.obj-code.
     1111         end.
     1112      end.
     1113      if i-obj = "thbj-attr" and
     1114         (i-parent = 'gisMT':U or i-parent = 'marking':U)
     1115      then do:
     1116         if i-parent = 'gisMT':U and i-obj-type = "" and i-obj-code = 0 then do:
     1117             if not can-find(first buf_thbj-attr no-lock where
     1118                                   buf_thbj-attr.obj-type = 'БД':U
     1119                               and buf_thbj-attr.obj-code = v-db-num
     1120                               and buf_thbj-attr.upper-prop-code = i-parent
     1121                               and buf_thbj-attr.prop-code = i-code)
     1122             then sendGisMt = yes.
     1123         end.
     1124         if i-parent = 'gisMT':U and i-obj-type = 'регион':U then do:
     1125             sendGisMt = yes.
     1126         end.
     1127         else if (i-parent = 'gisMT':U and i-obj-type = 'БД':U and i-obj-code = v-db-num)
     1128            then sendGisMt = yes.
     1129         else if i-parent = 'marking':U and i-obj-type = 'маг':U and i-obj-code = v-shop-code
     1130            then sendGisMt = yes.
     1131         else if i-parent = 'marking':U and i-obj-type = "" then do:
     1132             if not can-find(first buf_thbj-attr no-lock where
     1133                                   buf_thbj-attr.obj-type = 'маг':U
     1134                               and buf_thbj-attr.obj-code = v-shop-code
     1135                               and buf_thbj-attr.upper-prop-code = i-parent
     1136                               and buf_thbj-attr.prop-code = i-code)
     1137             then sendGisMt = yes.
     1138         end.
     1139         if sendGisMt = yes then do:
     1140             if not can-find(first thbjattr-list where
     1141                                   thbjattr-list.obj-type = i-obj-type
     1142                               and thbjattr-list.obj-code = i-obj-code
     1143                               and thbjattr-list.upper-prop-code = i-parent
     1144                               and thbjattr-list.prop-code = i-code)
     1145             then do:
     1146                 create thbjattr-list.
     1147                 assign
     1148                    thbjattr-list.obj-type = i-obj-type
     1149                    thbjattr-list.obj-code = i-obj-code
     1150                    thbjattr-list.upper-prop-code = i-parent
     1151                    thbjattr-list.prop-code = i-code
     1152                    .
     1153             end.
     1154         end.
     1155      end.
     1156   end procedure.
     1157   procedure fill-code :
     1158      define input parameter i-parent as character no-undo .
     1159      define input parameter i-code   as character no-undo .
     1160      if i-parent begins "EMC"
     1161      then
     1162         sendEMRC = yes.
     1163      if i-parent begins "MarkType"
     1164      then
     1165         sendMarkType = yes.
     1166   end procedure.
     1167   procedure fill-gds-list :
     1168   define parameter buffer buf_goods for ub.goods.
     1169   do
     1170   on error undo, return error
     1171   :
     1172     for first gds-list where gds-list.gds-code = buf_goods.gds-code:
     1173       delete gds-list.
     1174     end.
     1175     create gds-list.
     1176     buffer-copy buf_goods to gds-list no-error.
     1177     if error-status:error then message error-status:get-message(1) view-as alert-box.
     1178     release gds-list.
     1179   end.
     1180   end procedure.
     1181   procedure fill-dc-list :
     1182   define parameter buffer buf_dis-card for ub.dis-card .
     1183   do
     1184   on error undo, return error
     1185   :
     1186     find first dc-list where
     1187               dc-list.d-card = buf_dis-card.d-card no-lock no-error.
     1188     if not available dc-list then do:
     1189       create dc-list.
     1190       buffer-copy buf_dis-card to dc-list.
     1191       release dc-list.
     1192     end.
     1193   end.
     1194   end procedure.
     1195   procedure fill-dc-list-mask :
     1196   define parameter buffer buf_dis-card-mask for ub.dis-card-mask .
     1197   do
     1198   on error undo, return error
     1199   :
     1200      find first dc-list where
     1201               dc-list.d-card = buf_dis-card-mask.mask no-lock no-error.
     1202      if not available dc-list
     1203      then do:
     1204         find first ub.dis-card no-lock where
     1205                    ub.dis-card.d-card = buf_dis-card-mask.mask no-error .
     1206         if  available dis-card
     1207         then
     1208            run fill-dc-list(buffer dis-card) .
     1209      end.
     1210     find first dc-dis-card-mask where
     1211                dc-dis-card-mask.mask-num = buf_dis-card-mask.mask-num no-lock no-error.
     1212     buffer-copy buf_dis-card-mask to dc-dis-card-mask.
     1213     release dc-dis-card-mask.
     1214   end.
     1215   end procedure.
     1216   procedure fill-dc-list-mask-attr :
     1217   define parameter buffer buf_dis-card-mask-attr for ub.dis-card-mask-attr .
     1218   define buffer dis-card-mask for ub.dis-card-mask .
     1219   do
     1220   on error undo, return error
     1221   :
     1222     find first dc-dis-card-mask where
     1223                dc-dis-card-mask.mask-num = buf_dis-card-mask-attr.mask-num no-lock no-error.
     1224     if not available dc-dis-card-mask
     1225     then do:
     1226        find first dis-card-mask where dis-card-mask.mask-num eq buf_dis-card-mask-attr.mask-num no-lock no-error.
     1227        if available dis-card-mask
     1228        then
     1229           run  fill-dc-list-mask (buffer dis-card-mask).
     1230     end.
     1231     find first dc-dis-card-mask-attr where
     1232               dc-dis-card-mask-attr.mask-num  = buf_dis-card-mask-attr.mask-num
     1233          and  dc-dis-card-mask-attr.attr-code = buf_dis-card-mask-attr.attr-code
     1234               no-lock no-error.
     1235     buffer-copy buf_dis-card-mask-attr to dc-dis-card-mask-attr.
     1236     release dc-dis-card-mask-attr.
     1237   end.
     1238   end procedure.
     1239   procedure fill-dc-list-attr :
     1240   define input parameter p-d-card as character no-undo .
     1241   define input parameter p-emitent-host-code as integer no-undo .
     1242   do
     1243   on error undo, return error
     1244   :
     1245     find first dc-list where
     1246               dc-list.d-card = p-d-card no-error .
     1247     if not avail dc-list then do:
     1248       create dc-list.
     1249       assign
     1250       dc-list.d-card = p-d-card
     1251       dc-list.emitent-host-code = p-emitent-host-code
     1252       .
     1253       release dc-list.
     1254     end.
     1255   end.
     1256   end procedure.
     1257   procedure fill-cash-pay :
     1258   define input parameter p-cdpay-code as integer no-undo .
     1259   define input parameter p-curr-code  as integer no-undo .
     1260   do
     1261   on error undo, return error
     1262   :
     1263     if not can-find( cash-pay-list where cash-pay-list.cdpay-code = p-cdpay-code
     1264                                      and cash-pay-list.curr-code  = p-curr-code )
     1265     then do:
     1266       create cash-pay-list.
     1267       assign
     1268          cash-pay-list.cdpay-code = p-cdpay-code
     1269          cash-pay-list.curr-code  = p-curr-code
     1270       .
     1271       release cash-pay-list.
     1272     end.
     1273   end.
     1274   end procedure.
     1275   procedure fill-PromoAction :
     1276   define input parameter p-id as int64 no-undo .
     1277   define input parameter p-db-num  as integer no-undo .
     1278   do
     1279   on error undo, return error
     1280   :
     1281     if not can-find( PromoAction-list where PromoAction-list.id = p-id
     1282                                         and PromoAction-list.db-num  = p-db-num )
     1283     then do:
     1284       create PromoAction-list.
     1285       assign
     1286          PromoAction-list.id = p-id
     1287          PromoAction-list.db-num  = p-db-num
     1288       .
     1289       release PromoAction-list.
     1290     end.
     1291   end.
     1292   end procedure.
     1293   procedure fill-ext-classif:
     1294   define input parameter p-db-num as integer no-undo .
     1295   define input parameter p-Key#One  as integer no-undo .
     1296   define input parameter p-Key#Two  as integer no-undo .
     1297   define input parameter p-CharKey_One  as character no-undo .
     1298   do
     1299   on error undo, return error
     1300   :
     1301     if not can-find( ext-classif-list where ext-classif-list.db-num = p-db-num
     1302                                      and ext-classif-list.Key#One  = p-Key#One
     1303                                      and ext-classif-list.Key#Two = p-Key#Two
     1304                                      and ext-classif-list.CharKey_One = p-CharKey_One )
     1305     then do:
     1306       create ext-classif-list.
     1307       assign
     1308       ext-classif-list.db-num = p-db-num
     1309       ext-classif-list.Key#One  = p-Key#One
     1310       ext-classif-list.Key#Two = p-Key#Two
     1311       ext-classif-list.CharKey_One = p-CharKey_One
     1312       .
     1313       release ext-classif-list.
     1314     end.
     1315   end.
     1316   end procedure.
     1317   procedure fill-c-ext-classif:
     1318   define input parameter p-db-num as integer no-undo .
     1319   define input parameter p-Key#One  as integer no-undo .
     1320   define input parameter p-Key#Two  as integer no-undo .
     1321   define input parameter p-CharKey_One  as character no-undo .
     1322   define input parameter p-chip-num as integer no-undo .
     1323   do
     1324   on error undo, return error
     1325   :
     1326     if not can-find( c-ext-classif-list where c-ext-classif-list.db-num = p-db-num
     1327                                      and c-ext-classif-list.Key#One  = p-Key#One
     1328                                      and c-ext-classif-list.Key#Two = p-Key#Two
     1329                                      and c-ext-classif-list.CharKey_One = p-CharKey_One
     1330                                      and c-ext-classif-list.chip-num = p-chip-num )
     1331     then do:
     1332       create c-ext-classif-list.
     1333       assign
     1334           c-ext-classif-list.db-num = p-db-num
     1335           c-ext-classif-list.Key#One  = p-Key#One
     1336           c-ext-classif-list.Key#Two = p-Key#Two
     1337           c-ext-classif-list.CharKey_One = p-CharKey_One
     1338           c-ext-classif-list.chip-num = p-chip-num
     1339       .
     1340       release c-ext-classif-list.
     1341     end.
     1342   end.
     1343   end procedure.
     1344   procedure fill-g-list :
     1345   define input parameter p-gds-code as integer no-undo .
     1346   define input parameter p-obj-type as character no-undo .
     1347   define input parameter p-obj-code as integer no-undo .
     1348   define buffer buf_goods for ub.goods.
     1349   do
     1350   on error undo, return error
     1351   :
     1352     find first gds-list where
     1353               gds-list.gds-code = p-gds-code no-error .
     1354     if not avail gds-list then do:
     1355       if p-obj-type = 'маг':U then do:
     1356         find first gdsolist where
     1357                   gdsolist.gds-code = p-gds-code
     1358             AND  gdsolist.obj-type = p-obj-type
     1359             AND  gdsolist.obj-code = p-obj-code   no-error .
     1360       end.
     1361       else do:
     1362         find first buf_goods no-lock where
     1363                     buf_goods.gds-code = p-gds-code no-error .
     1364         create gds-list.
     1365         buffer-copy buf_goods to gds-list.
     1366       end.
     1367     end.
     1368     if p-obj-type = 'маг':U and not avail gdsolist then do:
     1369       find first gdsolist where
     1370                 gdsolist.gds-code = p-gds-code
     1371           AND  gdsolist.obj-type = p-obj-type
     1372           AND  gdsolist.obj-code = p-obj-code   no-error .
     1373       if not available gdsolist then do:
     1374         find first buf_goods no-lock where
     1375                     buf_goods.gds-code = p-gds-code no-error .
     1376         if avail buf_goods then do:
     1377           create gdsolist.
     1378           buffer-copy buf_goods to gdsolist
     1379           assign
     1380           gdsolist.obj-type = p-obj-type
     1381           gdsolist.obj-code = p-obj-code
     1382           .
     1383         end.
     1384       end.
     1385     end.
     1386     if avail gdsolist then do:
     1387       assign
     1388       gdsolist.to-del = no
     1389       .
     1390       release gdsolist.
     1391     end.
     1392     if avail gds-list then do:
     1393       assign
     1394       gds-list.to-del = no
     1395       .
     1396       release gds-list.
     1397     end.
     1398   end.
     1399   end procedure.
     1400   procedure fill-cash-txn :
     1401   define parameter buffer buf_tax for ub.tax.
     1402   do
     1403   on error undo, return error
     1404   :
     1405     if not can-find( cash-txn where
     1406                     cash-txn.tax-code = buf_tax.tax-code
     1407                 and cash-txn.tax-name = buf_tax.tax-name
     1408                    ) then do:
     1409       create cash-txn.
     1410       assign
     1411       cash-txn.tax-code = buf_tax.tax-code
     1412       cash-txn.tax-name = buf_tax.tax-name
     1413       .
     1414       release cash-txn.
     1415     end.
     1416   end.
     1417   end procedure.
     1418   procedure fill-cash-txr :
     1419   define input parameter p-tax-code as integer no-undo .
     1420   define input parameter p-rate-code as integer no-undo .
     1421   define input parameter p-status_ as character no-undo .
     1422   define input parameter p-host-code as integer no-undo .
     1423   define input parameter p-obj-type as character no-undo .
     1424   define input parameter p-obj-code as integer no-undo .
     1425   define input parameter p-tax-type as character no-undo .
     1426   define input parameter p-value as decimal no-undo .
     1427   define input parameter p-crf as integer no-undo .
     1428   define input parameter p-rec as recid no-undo .
     1429   define buffer buf_tax for ub.tax.
     1430   do
     1431   on error undo, return error
     1432   :
     1433     find first cash-txr where
     1434             cash-txr.tax-code = p-tax-code
     1435         AND cash-txr.host-code = p-host-code
     1436         AND cash-txr.rate-code = p-rate-code
     1437         AND cash-txr.obj-type = p-obj-type
     1438         AND cash-txr.obj-code = p-obj-code
     1439         AND cash-txr.rc = p-rec no-error .
     1440     if not avail cash-txr then do:
     1441       find first  cash-txn where
     1442                       cash-txn.tax-code = p-tax-code no-error .
     1443       if not available cash-txn then do:
     1444         find first buf_tax no-lock where buf_tax.tax-code = p-tax-code.
     1445         create cash-txn.
     1446         assign
     1447         cash-txn.tax-code = buf_tax.tax-code
     1448         cash-txn.tax-name = buf_tax.tax-name
     1449         .
     1450         release cash-txn.
     1451         define variable II as integer no-undo.
     1452         find last  cash-txr where cash-txr.crf > 0 no-error.
     1453         if available cash-txr
     1454         then
     1455            II = cash-txr.crf + 1.
     1456         else
     1457            II = 1.
     1458            _tax-rate:
     1459         FOR EACH ub.tax-rate NO-LOCK WHERE
     1460                             ub.tax-rate.tax-code = buf_tax.tax-code
     1461                         and ub.tax-rate.status_  <>   'удал':U:
     1462                           create cash-txr.
     1463                           assign
     1464                           cash-txr.tax-code = tax-rate.tax-code
     1465                           cash-txr.rate-code = tax-rate.rate-code
     1466                           cash-txr.tax-type = buf_tax.tax-type
     1467                           cash-txr.host-code = p-host-code
     1468                           cash-txr.obj-type = p-obj-type
     1469                           cash-txr.obj-code = p-obj-code
     1470                           cash-txr.status_ = tax-rate.status_
     1471                           cash-txr.rc = RECID(tax-rate)
     1472                           cash-txr.crf = ii
     1473                           ii = ii + 1
     1474                           .
