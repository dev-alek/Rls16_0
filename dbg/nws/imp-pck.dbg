     2379   def new shared var bc-frmt as character no-undo .
     2380   def new shared var bc-pfx  as character no-undo .
     2381   def var bc-par-type as character no-undo .
     2382       run gbl/conf-rd.p ("bc-frmt", "", "", 0, "", "", "",  no , output bc-frmt, output bc-par-type) no-error.
     2383       if "new" = "bc" AND ( error-status:error OR bc-par-type <> "C":U OR not can-do ("EAN8,EAN13", bc-frmt) ) then
     2384           do:
     2385               message "Не задан или не верно задан ТИП собственного бар-кода!"
     2386                   view-as alert-box ERROR TITLE "".
     2387               return error.
     2388           end.
     2389       run gbl/conf-rd.p ("bc-pfx", "", "", 0, "", "", "",  no , output bc-pfx, output bc-par-type) no-error.
     2390       if "new" = "bc" AND ( error-status:error OR bc-par-type <> "C":U ) then
     2391           do:
     2392               message "Не задан или не верно задан ПРЕФИКС бар-кода складского места!"
     2393                   view-as alert-box ERROR TITLE "".
     2394               return error.
     2395           end.
     2396   PROCEDURE gen-bc:
     2397     def input  parameter internal-b-code like ub.bar-code.b-code no-undo .
     2398     def output parameter full-b-code     as character init ""    no-undo .
     2399   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2400     define variable tmp-str28  as character no-undo.
     2401     define variable tmp-num28  as character no-undo.
     2402     define variable i28        as integer   no-undo.
     2403     define variable sum28      as integer   no-undo.
     2404     define variable len-code28 as integer   no-undo.
     2405     define variable varcont28  as logical   initial yes no-undo.
     2406     CASE bc-frmt :
     2407       WHEN "EAN13" THEN do:
     2408         assign
     2409           tmp-str28 = string( internal-b-code, "999999999999" )
     2410         .
     2411       end.
     2412       WHEN "EAN8" THEN do:
     2413         assign
     2414           tmp-str28 = string( internal-b-code, "9999999" )
     2415         .
     2416       end.
     2417       OTHERWISE DO:
     2418           message "Неизвестный тип генерации бар-кода процедурой bc-gnrti.i: " bc-frmt " ."
     2419           view-as alert-box error.
     2420           return error.
     2421       END.
     2422     END CASE.
     2423     if varcont28 = yes then do:
     2424       if integer( substring( tmp-str28, 1, length( bc-pfx ) ) ) <> 0
     2425       then do:
     2426         message
     2427           "Невозможно сформировать бар-код" SKIP
     2428           "для товара с кодом: " internal-b-code
     2429           view-as alert-box error title "подрезание кода".
     2430         return error.
     2431       end.
     2432       else do:
     2433         assign
     2434           full-b-code = bc-pfx + substring( tmp-str28, length( bc-pfx ) + 1, length( tmp-str28 ) - length( bc-pfx ) )
     2435           len-code28    = length( full-b-code )
     2436         .
     2437         define variable v-sum-char28 as character no-undo .
     2438         assign
     2439           sum28 = 0
     2440         .
     2441         do i28 = 1 to len-code28 by 2
     2442         :
     2443           assign
     2444             v-sum-char28 = substr(full-b-code, len-code28 - i28 + 1, 1)
     2445           .
     2446           if v-sum-char28 < "0"
     2447           or v-sum-char28 > "9"
     2448           then do:
     2449             message
     2450               "Невозможно сформировать бар-код" skip
     2451               "для товара с кодом: " internal-b-code skip
     2452               view-as alert-box error title "подсчет контрольной суммы".
     2453             return error.
     2454           end.
     2455           assign
     2456             sum28 = sum28 + integer(v-sum-char28)
     2457           .
     2458         end.
     2459         if varcont28 = yes then do:
     2460           assign
     2461             sum28 = sum28 * 3
     2462           .
     2463           do i28 = 2 to len-code28 by 2
     2464           :
     2465             assign
     2466               v-sum-char28 = substr(full-b-code, len-code28 - i28 + 1, 1)
     2467             .
     2468             if v-sum-char28 < "0"
     2469             or v-sum-char28 > "9"
     2470             then do:
     2471               message
     2472                 "Невозможно сформировать бар-код" skip
     2473                 "для товара с кодом: " internal-b-code skip
     2474                 view-as alert-box error title "подсчет контрольной суммы".
     2475               return error.
     2476             end.
     2477             assign
     2478               sum28 = sum28 + integer(v-sum-char28)
     2479             .
     2480           end.
     2481           if varcont28 = yes then do:
     2482              if sum28 mod 10 = 0 then do:
     2483                assign
     2484                  full-b-code = full-b-code + '0'
     2485                .
     2486              end.
     2487              else do:
     2488                assign
     2489                  full-b-code = full-b-code + string(10 - sum28 mod 10)
     2490                .
     2491              end.
     2492           end.
     2493         end.
     2494       end.
     2495     end.
     2496   END PROCEDURE.
     2497   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2498   procedure valid-ren-bcod-tbl-list :
     2499     do
     2500     on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2501     on stop   undo, return error substitute( "&1. stop", vss-workfile )
     2502     on endkey undo, return error substitute( "&1. endkey", vss-workfile )
     2503     :
     2504       define variable v-std-list        as character no-undo .
     2505       define variable v-ignore-list     as character no-undo .
     2506       define variable v-special-list    as character no-undo .
     2507       assign
     2508         v-std-list     = "bar-code-attr,c-bar-code-attr,bar-code-obj-attr,c-bar-code-obj-attr,chk-gds,c-chk-gds,chk-gds-pay,doc-prts,doc-prts-attr,cd-doc-line,c-cd-doc-line,cd-plu,c-cd-plu,c-doc-prts,c-price-list,prod-bc-attr,c-prod-bc-attr,prod-bc-db,prod-bc-db-attr,c-prod-bc-db-attr,price-all,price-doc-forming-gds,price-doc-forming-gdsattr,price-doc-forming-gds-tnv,price-doc-forming-gds-sum,price-doc-forming-gds-qnty,c-price-doc-forming-gds,c-price-doc-forming-gdsattr,c-price-doc-forming-gds-tnv,c-price-doc-forming-gds-sum,c-price-doc-forming-gds-qnty,scales-gds,c-scales-gds,sert-join,c-sert,sert-join-attr":U
     2509         v-ignore-list  = "c-bar-code,c-prod-bc,c-gds-hist,rcs-retail1barcode":U
     2510         v-special-list = "bar-code,prod-bc,price-list,price-list-attr,c-price-list-attr":U
     2511       .
     2512   def var vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2513       define variable v-ind         as integer   no-undo .
     2514       define variable v-num-entries as integer   no-undo .
     2515       define variable v-inform      as character no-undo .
     2516       define variable bh_tbl-name   as handle    no-undo .
     2517       define variable v-tbl-not-idx as character no-undo .
     2518       define variable v-idx-avail   as logical   no-undo .
     2519       define variable new-tbl-list  as character no-undo .
     2520       define variable old-tbl-list  as character no-undo .
     2521       define variable old-tbl-avail as logical   no-undo .
     2522       define variable v-double-tbl  as character no-undo .
     2523       define variable v-tbl-name    as character no-undo .
     2524       define variable v-msg         as character no-undo .
     2525       assign
     2526         v-msg         = "":U
     2527         v-tbl-not-idx = "":U
     2528         new-tbl-list  = "":U
     2529       .
     2530       for each ub._Field no-lock
     2531         where ub._Field._Field-Name = 'b-code':U
     2532       ,first ub._File of ub._Field
     2533       on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2534       :
     2535         if  lookup( ub._File._File-Name, v-std-list     ) = 0
     2536         and lookup( ub._File._File-Name, v-ignore-list  ) = 0
     2537         and lookup( ub._File._File-Name, v-special-list ) = 0
     2538         then do:
     2539           assign
     2540             new-tbl-list = new-tbl-list + chr(10) + ub._File._File-Name
     2541           .
     2542         end.
     2543         if lookup( ub._File._File-Name, v-std-list ) <> 0
     2544           or lookup( ub._File._File-Name, new-tbl-list, chr(10) ) <> 0
     2545         then do:
     2546           create buffer bh_tbl-name for table substitute( "ub.&1":U, ub._File._File-Name ) .
     2547           assign
     2548             v-idx-avail = false
     2549             v-inform    = bh_tbl-name:index-information(1)
     2550             v-ind       = 2
     2551           .
     2552           block_chk-idx:
     2553           do while v-inform <> ?
     2554           on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2555           :
     2556             if v-inform <> ?
     2557                 and lookup( entry( 5, v-inform, ",":U ), 'b-code':U ) > 0
     2558             then do:
     2559               assign
     2560                 v-idx-avail = true
     2561               .
     2562               leave block_chk-idx.
     2563             end.
     2564             assign
     2565               v-inform = bh_tbl-name:index-information( v-ind )
     2566               v-ind    = v-ind + 1
     2567             .
     2568           end.
     2569           if v-idx-avail = false then do:
     2570             if lookup( ub._File._File-Name, new-tbl-list, chr(10) ) <> 0 then do:
     2571               assign
     2572                 new-tbl-list = new-tbl-list + " (индекса нет)"
     2573               .
     2574             end.
     2575             else do:
     2576               assign
     2577                 v-tbl-not-idx = v-tbl-not-idx + chr(10) + ub._File._File-Name
     2578               .
     2579             end.
     2580           end.
     2581           delete object bh_tbl-name.
     2582         end.
     2583       end.
     2584       assign
     2585         old-tbl-list  = "":U
     2586         v-double-tbl  = "":U
     2587         v-num-entries = num-entries( v-std-list )
     2588       .
     2589       do v-ind = 1 to v-num-entries
     2590       on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2591       :
     2592         assign
     2593           v-tbl-name    = entry( v-ind, v-std-list )
     2594           old-tbl-avail = false
     2595         .
     2596         find first ub._File no-lock
     2597           where ub._File._File-Name = v-tbl-name
     2598           no-error .
     2599         if not available ub._File then do:
     2600           assign
     2601             old-tbl-avail = true
     2602           .
     2603         end.
     2604         else do:
     2605           find first ub._Field no-lock
     2606             where ub._Field._File-recid = recid( ub._File )
     2607               and ub._Field._Field-Name = 'b-code':U
     2608             no-error .
     2609           if not available ub._Field then do:
     2610             assign
     2611               old-tbl-avail = true
     2612             .
     2613           end.
     2614         end.
     2615         if old-tbl-avail = true then do:
     2616           assign
     2617             old-tbl-list = old-tbl-list + chr(10) + v-tbl-name
     2618           .
     2619         end.
     2620         if ( lookup( v-tbl-name, v-std-list ) > v-ind
     2621              or lookup( v-tbl-name, v-ignore-list ) > 0
     2622              or lookup( v-tbl-name, v-special-list ) > 0
     2623            )
     2624           and lookup( v-tbl-name, v-double-tbl, chr(10) ) = 0
     2625         then do:
     2626           assign
     2627             v-double-tbl = v-double-tbl + chr(10) + v-tbl-name
     2628           .
     2629         end.
     2630       end.
     2631       assign
     2632         v-num-entries = num-entries( v-ignore-list )
     2633       .
     2634       do v-ind = 1 to v-num-entries
     2635       on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2636       :
     2637         assign
     2638           v-tbl-name = entry( v-ind, v-ignore-list )
     2639           old-tbl-avail = false
     2640         .
     2641         find first ub._File no-lock
     2642           where ub._File._File-Name = v-tbl-name
     2643           no-error .
     2644         if not available ub._File then do:
     2645           assign
     2646             old-tbl-avail = true
     2647           .
     2648         end.
     2649         else do:
     2650           find first ub._Field no-lock
     2651             where ub._Field._File-recid = recid( ub._File )
     2652               and ub._Field._Field-Name = 'b-code':U
     2653             no-error .
     2654           if not available ub._Field then do:
     2655             assign
     2656               old-tbl-avail = true
     2657             .
     2658           end.
     2659         end.
     2660         if old-tbl-avail = true then do:
     2661           assign
     2662             old-tbl-list = old-tbl-list + chr(10) + v-tbl-name
     2663           .
     2664         end.
     2665         if ( lookup( v-tbl-name, v-std-list ) > 0
     2666              or lookup( v-tbl-name, v-ignore-list ) > v-ind
     2667              or lookup( v-tbl-name, v-special-list ) > 0
     2668            )
     2669           and lookup( v-tbl-name, v-double-tbl, chr(10) ) = 0
     2670         then do:
     2671           assign
     2672             v-double-tbl = v-double-tbl + chr(10) + v-tbl-name
     2673           .
     2674         end.
     2675       end.
     2676       assign
     2677         v-num-entries = num-entries( v-special-list )
     2678       .
     2679       do v-ind = 1 to v-num-entries
     2680       on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2681       :
     2682         assign
     2683           v-tbl-name = entry( v-ind, v-special-list )
     2684         .
     2685         find first ub._File no-lock
     2686           where ub._File._File-Name = v-tbl-name
     2687           no-error .
     2688         if available ub._File then do:
     2689           find first ub._Field no-lock
     2690             where ub._Field._File-recid = recid( ub._File )
     2691               and ub._Field._Field-Name = 'b-code':U
     2692             no-error .
     2693         end.
     2694         if not available ub._File
     2695           or ( available ub._File
     2696                and not available ub._Field
     2697              )
     2698         then do:
     2699           assign
     2700             old-tbl-list = old-tbl-list + chr(10) + v-tbl-name
     2701           .
     2702         end.
     2703         if ( lookup( v-tbl-name, v-std-list ) > 0
     2704              or lookup( v-tbl-name, v-ignore-list ) > 0
     2705              or lookup( v-tbl-name, v-special-list ) > v-ind
     2706            )
     2707           and lookup( v-tbl-name, v-double-tbl, chr(10) ) = 0
     2708         then do:
     2709           assign
     2710             v-double-tbl = v-double-tbl + chr(10) + v-tbl-name
     2711           .
     2712         end.
     2713       end.
     2714       if v-tbl-not-idx <> "" then do:
     2715         assign
     2716           v-msg = v-msg + substitute( "Таблицы не имеют индекса с полями &3 на первом месте и нет спецобработки: &2&1&1", chr(10), v-tbl-not-idx, 'b-code':U )
     2717         .
     2718       end.
     2719       if new-tbl-list <> "":U then do:
     2720         assign
     2721           v-msg = v-msg + substitute( "Нет обработки таблиц: &2&1&1", chr(10), new-tbl-list )
     2722         .
     2723       end.
     2724       if v-double-tbl <> "":U then do:
     2725         assign
     2726           v-msg = v-msg + substitute( "В списках есть задублированные таблицы: &2&1&1", chr(10), v-double-tbl )
     2727         .
     2728       end.
     2729       if old-tbl-list <> "":U then do:
     2730         assign
     2731           v-msg = v-msg + substitute( "В списках есть несуществующие таблицы или таблицы в которых отсутствуют переименовываемые поля: &2&1&1", chr(10), old-tbl-list )
     2732         .
     2733       end.
     2734       if v-msg <> "":U then do:
     2735         return error substitute( "Утилита переименования &3 не корректна.&1&1&2", chr(10), v-msg, 'b-code':U ) .
     2736       end.
     2737     end.
     2738   end procedure.
     2739   PROCEDURE create-bar-code:
     2740     define input parameter loc-b-code        like ub.bar-code.b-code        no-undo .
     2741     define input parameter loc-cli-base-rate like ub.bar-code.cli-base-rate no-undo .
     2742     define input parameter loc-gds-code      like ub.bar-code.gds-code      no-undo .
     2743     define input parameter loc-in-code       like ub.bar-code.in-code       no-undo .
     2744     define input parameter loc-node-code     like ub.bar-code.node-code     no-undo .
     2745     define input parameter loc-part-code     like ub.bar-code.part-code     no-undo .
     2746     define input parameter loc-unit-cli      like ub.bar-code.unit-cli      no-undo .
     2747     define input parameter loc-cr-db-num     like ub.bar-code.cr-db-num     no-undo .
     2748     do
     2749     on error  undo, return error substitute( "&1. &2&3&4", vss-include-info25, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2750     on stop   undo, return error substitute( "&1. stop", vss-include-info25 )
     2751     on endkey undo, return error substitute( "&1. endkey", vss-include-info25 )
     2752     :
     2753       define buffer buf_bar-code   for ub.bar-code .
     2754       define buffer buf_goods      for ub.goods .
     2755       define buffer buf_prod-bc    for ub.prod-bc .
     2756       define buffer buf_price-list for ub.price-list.
     2757       define buffer buf_db         for ub.db.
     2758       define buffer buf_clients    for ub.clients.
     2759       define variable src-b-code       like ub.bar-code.b-code no-undo .
     2760       define variable attach-to-b-code like ub.bar-code.b-code no-undo .
     2761       define variable bar_code         like ub.prod-bc.b-str   no-undo .
     2762       define variable load-bc          as   logical            no-undo .
     2763       define variable cre-prod-bc      as   logical            no-undo .
     2764       DEFINE VARIABLE var-rate-value   like ub.tax-rate-value.rate-value no-undo .
     2765       define variable prod_bc_cr-db-num like ub.prod-bc.cr-db-num no-undo .
     2766       find buf_bar-code exclusive-lock
     2767         where buf_bar-code.b-code = loc-b-code
     2768         no-error.
     2769       if available buf_bar-code
     2770          and buf_bar-code.b-code        = loc-b-code
     2771          and buf_bar-code.gds-code      = loc-gds-code
     2772          and buf_bar-code.node-code     = loc-node-code
     2773          and buf_bar-code.part-code     = loc-part-code
     2774          and buf_bar-code.in-code       = loc-in-code
     2775          and buf_bar-code.unit-cli      = loc-unit-cli
     2776          and buf_bar-code.cli-base-rate = loc-cli-base-rate
     2777       then do:
     2778         return.
     2779       end.
     2780       if available buf_bar-code
     2781         and ( buf_bar-code.gds-code     <> loc-gds-code
     2782               or buf_bar-code.node-code <> loc-node-code
     2783               or buf_bar-code.part-code <> loc-part-code
     2784               or buf_bar-code.in-code   <> loc-in-code
     2785               or buf_bar-code.unit-cli  <> loc-unit-cli
     2786             )
     2787       then do:
     2788         run write-to-log( "ОШИБКА! Принимается ошибочный бар-код " + string( loc-b-code )
     2789                           + " для товара " + string( loc-gds-code ) + "." ).
     2790         return error.
     2791       end.
     2792       find buf_bar-code exclusive-lock
     2793         where buf_bar-code.gds-code  = loc-gds-code
     2794           and buf_bar-code.node-code = loc-node-code
     2795           and buf_bar-code.part-code = loc-part-code
     2796           and buf_bar-code.in-code   = loc-in-code
     2797           and buf_bar-code.unit-cli  = loc-unit-cli
     2798       no-error.
     2799       find buf_goods no-lock
     2800         where buf_goods.gds-code = buf_bar-code.gds-code
     2801         no-error.
     2802       assign
     2803         load-bc      = TRUE
     2804         cre-prod-bc  = FALSE
     2805         .
     2806       if available buf_bar-code and buf_bar-code.b-code <> loc-b-code then do:
     2807         if g#db-num = 0 then do:
     2808           assign
     2809             src-b-code       = loc-b-code
     2810             attach-to-b-code = buf_bar-code.b-code
     2811             load-bc          = FALSE
     2812             .
     2813         end.
     2814         else do:
     2815           assign
     2816             src-b-code       = buf_bar-code.b-code
     2817             attach-to-b-code = loc-b-code
     2818             load-bc          = TRUE
     2819             .
     2820           run ren-b-code in this-procedure
     2821             ( input src-b-code
     2822              ,input attach-to-b-code
     2823             ) no-error .
     2824           if error-status :error then do:
     2825             run write-to-log ( substitute("Ошибка при переименовании бар-кода &1.&2&3&2&4", src-b-code, chr(10), return-value, error-status :get-message(1) ) ).
     2826             return error.
     2827           end.
     2828           run write-to-log ( "Существовавший бар-код" + chr(32) + string( src-b-code ) + chr(32)
     2829                              + "заменен на пришедший" + chr(32) + string( loc-b-code )
     2830                            ).
     2831         end.
     2832         assign
     2833           cre-prod-bc = TRUE
     2834           prod_bc_cr-db-num = buf_bar-code.cr-db-num
     2835           .
     2836       end.
     2837       if load-bc then do:
     2838         if not available buf_bar-code then do:
     2839           create buf_bar-code.
     2840         end.
     2841         else do:
     2842           find first bc-list where bc-list.b-code = buf_bar-code.b-code no-error.
     2843           if not available bc-list then do:
     2844             create bc-list.
     2845             buffer-copy buf_bar-code to bc-list
     2846               assign
     2847                 bc-list.del = yes
     2848             .
     2849           end.
     2850           else do:
     2851             for each bc-list
     2852               where bc-list.b-code = buf_bar-code.b-code
     2853             on error undo, return error
     2854             :
     2855               assign
     2856                 bc-list.del = yes
     2857               .
     2858             end.
     2859           end.
     2860         end.
     2861         assign
     2862           buf_bar-code.b-code        = loc-b-code
     2863           buf_bar-code.cli-base-rate = loc-cli-base-rate
     2864           buf_bar-code.gds-code      = loc-gds-code
     2865           buf_bar-code.in-code       = loc-in-code
     2866           buf_bar-code.node-code     = loc-node-code
     2867           buf_bar-code.part-code     = loc-part-code
     2868           buf_bar-code.unit-cli      = loc-unit-cli
     2869           buf_bar-code.cr-db-num     = loc-cr-db-num
     2870           .
     2871         if not can-find(gds-list where gds-list.gds-code = buf_bar-code.gds-code no-lock) then do:
     2872             find first bc-list where bc-list.b-code = buf_bar-code.b-code no-error.
     2873             if not available bc-list then do:
     2874               create bc-list.
     2875               buffer-copy buf_bar-code to bc-list
     2876                 assign
     2877                   bc-list.del = no
     2878                 .
     2879             end.
     2880         end.
     2881       end.
     2882       if cre-prod-bc = true then do:
     2883         run gen-bc in this-procedure
     2884           ( input src-b-code
     2885            ,output bar_code
     2886           ).
     2887         if can-find( first buf_prod-bc where buf_prod-bc.b-str = bar_code no-lock ) then do:
     2888           run write-to-log ( "Системная ошибка!!! При перемещении собственного кода в Доп.БК обнаружен повторный Доп.БК код" ).
     2889           return error.
     2890         end.
     2891         run create-prod-bc in this-procedure
     2892           ( input attach-to-b-code
     2893            ,input bar_code
     2894            ,input yes
     2895            ,input prod_bc_cr-db-num
     2896            ,input ''
     2897           ).
     2898         run write-to-log ( substitute( "Вместо бар-кода &1 создан Доп.БК &2", src-b-code, bar_code ) ).
     2899       end.
     2900     end.
     2901   END PROCEDURE.
     2902   PROCEDURE create-prod-bc:
     2903     define input parameter loc-b-code like ub.prod-bc.b-code no-undo.
     2904     define input parameter loc-b-str  like ub.prod-bc.b-str  no-undo.
     2905     define input parameter loc-bc-on  like ub.prod-bc.bc-on  no-undo.
     2906     define input parameter loc-cr-db-num like ub.prod-bc.cr-db-num no-undo .
     2907     define input parameter loc-bc-on-type like ub.prod-bc.bc-on-type no-undo .
     2908     do
     2909     on error  undo, return error substitute( "&1. &2&3&4", vss-include-info25, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2910     on stop   undo, return error substitute( "&1. stop", vss-include-info25 )
     2911     on endkey undo, return error substitute( "&1. endkey", vss-include-info25 )
     2912     :
     2913       define variable v-param-type                as character                no-undo.
     2914       define variable v-value-character           as character                no-undo.
     2915       define variable v-value-date                as date                     no-undo.
     2916       define variable v-value-decimal             as decimal                  no-undo.
     2917       define variable v-value-integer             as INTEGER                  no-undo.
     2918       define variable v-value-logical             AS LOGICAL                  no-undo.
     2919       define variable v-tth                       as handle                   no-undo.
     2920       define variable dpl-off as logical no-undo .
     2921       define buffer buf_bar-code for ub.bar-code .
     2922       define buffer buf_prod-bc  for ub.prod-bc .
     2923       define buffer buf_goods    for ub.goods .
     2924       define buffer cre_prod-bc  for ub.prod-bc.
     2925       find cre_prod-bc where cre_prod-bc.b-code = loc-b-code
     2926                          and cre_prod-bc.b-str  = loc-b-str
     2927                       exclusive-lock no-error.
     2928       if available cre_prod-bc
     2929          and cre_prod-bc.b-code = loc-b-code
     2930          and cre_prod-bc.b-str  = loc-b-str
     2931          and cre_prod-bc.bc-on  = loc-bc-on
     2932       then do:
     2933         return.
     2934       end.
     2935       find buf_bar-code where buf_bar-code.b-code = loc-b-code no-lock no-error.
     2936       if not available buf_bar-code then do:
     2937         return error.
     2938       end.
     2939       find buf_goods where buf_goods.gds-code = buf_bar-code.gds-code no-lock no-error.
     2940       if not available buf_goods then do:
     2941         return error.
     2942       end.
     2943       if loc-bc-on = yes
     2944         and can-find(first buf_prod-bc where buf_prod-bc.b-str   = loc-b-str
     2945                                          and buf_prod-bc.b-code <> loc-b-code
     2946                                          and buf_prod-bc.bc-on   = yes no-lock ) then do:
     2947         run adm/shattri.p (
     2948             input "get":U
     2949             ,input  '':U
     2950             ,input  0
     2951             ,input  'gds-ref':U
     2952             ,input  'dpl-off':U
     2953             ,output v-value-character
     2954             ,output v-value-date
     2955             ,output v-value-decimal
     2956             ,output v-value-integer
     2957             ,output dpl-off
     2958             ,output v-param-type
     2959             ,INPUT-OUTPUT table-handle v-tth
     2960             ) no-error.
     2961         delete object v-tth.
     2962         if dpl-off = yes then do:
     2963           for each buf_prod-bc exclusive-lock
     2964             where buf_prod-bc.b-str   = loc-b-str
     2965               and buf_prod-bc.b-code <> loc-b-code
     2966               and buf_prod-bc.bc-on   = yes
     2967           on error undo, return error return-value
     2968           :
     2969             assign buf_prod-bc.bc-on = no.
     2970             if not can-find(gds-list where gds-list.artic     = buf_goods.artic
     2971                                        and gds-list.prod-type = buf_goods.prod-type
     2972                                        and gds-list.prod-code = buf_goods.prod-code
     2973                                      no-lock ) then do:
     2974               find first pbc-list where pbc-list.rc = recid(buf_prod-bc) no-error.
     2975               if not available pbc-list then do:
     2976                 create pbc-list.
     2977               end.
     2978               buffer-copy buf_prod-bc to pbc-list
     2979                 assign
     2980                   pbc-list.rc = recid( buf_prod-bc )
     2981                 .
     2982               release pbc-list .
     2983             end.
     2984             run write-to-log( "Исходя из настроек, выключен существующий доп. бар-код" + chr(32) + buf_prod-bc.b-str
     2985                               + chr(32) + "для кода" + chr(32) + string( buf_prod-bc.b-code ) ).
     2986           end.
     2987         end.
     2988         assign loc-bc-on = no.
     2989         run write-to-log( "Выключен пришедший доп. бар-код" + chr(32) + loc-b-str
     2990                           + chr(32) + "для кода" + chr(32) + string( loc-b-code ) ).
     2991       end.
     2992       if not available cre_prod-bc then do:
     2993         create cre_prod-bc.
     2994       end.
     2995       assign
     2996         cre_prod-bc.b-code = loc-b-code
     2997         cre_prod-bc.b-str  = loc-b-str
     2998         cre_prod-bc.bc-on  = loc-bc-on
     2999         cre_prod-bc.cr-db-num = loc-cr-db-num
     3000         cre_prod-bc.bc-on-type = loc-bc-on-type
     3001         .
     3002       if not can-find(gds-list where gds-list.artic     = buf_goods.artic
     3003                                  and gds-list.prod-type = buf_goods.prod-type
     3004                                  and gds-list.prod-code = buf_goods.prod-code
     3005                                no-lock ) then do:
     3006         find first pbc-list where pbc-list.rc = recid(cre_prod-bc) no-error.
     3007         if not available pbc-list then do:
     3008           create pbc-list.
     3009         end.
     3010         buffer-copy cre_prod-bc to pbc-list
     3011           assign
     3012             pbc-list.rc = recid( cre_prod-bc )
     3013           .
     3014         release pbc-list .
     3015       end.
     3016     end.
     3017   END PROCEDURE.
     3018   procedure ren-b-code :
     3019     define input parameter p-old-b-code as integer no-undo .
     3020     define input parameter p-new-b-code as integer no-undo .
     3021     do
     3022     on error  undo, return error substitute( "ren-b-code. &1&2&3", return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     3023     on stop   undo, return error substitute( "ren-b-code. stop" )
     3024     on endkey undo, return error substitute( "ren-b-code. endkey" )
     3025     :
     3026       define variable v-ind         as integer   no-undo .
     3027       define variable v-num-entries as integer   no-undo .
     3028       define variable v-tbl-name    as character no-undo .
     3029       define variable fh            as handle    no-undo .
     3030       define variable bh            as handle    no-undo .
     3031       define variable qh            as handle    no-undo .
     3032       define variable v-query       as character no-undo .
     3033       define buffer buf-ren_bar-code        for ub.bar-code .
     3034       define buffer buf-ren_goods           for ub.goods .
     3035       define buffer buf-ren_prod-bc         for ub.prod-bc .
     3036       define buffer buf-ren_db              for ub.db .
     3037       define buffer buf-ren_clients         for ub.clients .
     3038       define buffer buf-ren_price-list      for ub.price-list .
     3039       define buffer buf-ren_price-list-attr for ub.price-list-attr .
     3040       run valid-ren-bcod-tbl-list in this-procedure
     3041         no-error .
     3042       if error-status :error then do:
     3043         message
     3044           vss-workfile vss-revision vss-description skip
     3045           "Ошибка при проверке списка таблиц для обработки." skip
     3046           error-status :get-message(1) skip
     3047           return-value skip
     3048           view-as alert-box error .
     3049         undo, return error return-value .
     3050       end.
     3051       do transaction
     3052       on error  undo, return error substitute( "ren-b-code (1.err). &1&2&3", return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     3053       on stop   undo, return error substitute( "ren-b-code (1.stop). &1&2&3", return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     3054       on quit   undo, return error substitute( "ren-b-code (1.quit). &1&2&3", return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     3055       on endkey undo, return error substitute( "ren-b-code (1.endkey). &1&2&3", return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     3056       :
     3057         find first buf-ren_bar-code exclusive-lock
     3058           where buf-ren_bar-code.b-code  = p-old-b-code
     3059           .
     3060         find first buf-ren_goods no-lock
     3061           where buf-ren_goods.gds-code = buf-ren_bar-code.gds-code
     3062           .
     3063         assign
     3064           buf-ren_bar-code.b-code  = p-new-b-code
     3065         .
     3066         for each buf-ren_prod-bc exclusive-lock
     3067             where buf-ren_prod-bc.b-code = p-old-b-code
     3068         on error undo, return error substitute( "ren-b-code. &1&2&3", return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     3069         :
     3070           assign
     3071             buf-ren_prod-bc.b-code = p-new-b-code
     3072             .
     3073           if not can-find(gds-list where gds-list.artic     = buf-ren_goods.artic
     3074                                     and gds-list.prod-type = buf-ren_goods.prod-type
     3075                                     and gds-list.prod-code = buf-ren_goods.prod-code
     3076                                     no-lock ) then do:
     3077             find first pbc-list where pbc-list.rc = recid( buf-ren_prod-bc ) no-error.
     3078             if not available pbc-list then do:
     3079               create pbc-list.
     3080             end.
     3081             buffer-copy buf-ren_prod-bc to pbc-list
     3082               assign
     3083                 pbc-list.rc = recid( buf-ren_prod-bc )
     3084                 pbc-list.del = no
     3085               .
     3086             release pbc-list .
     3087           end.
     3088         end.
     3089         for each buf-ren_db no-lock
     3090         on error undo, return error substitute( "ren-b-code. &1&2&3", return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     3091         :
     3092           for each buf-ren_clients no-lock
     3093             where buf-ren_clients.db-num = buf-ren_db.db-num
     3094           on error undo, return error substitute( "ren-b-code. &1&2&3", return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     3095           :
     3096             for each buf-ren_price-list exclusive-lock
     3097               where buf-ren_price-list.obj-type = buf-ren_clients.obj-type
     3098                 and buf-ren_price-list.obj-code = buf-ren_clients.obj-code
     3099                 and buf-ren_price-list.b-code   = p-old-b-code
     3100             on error undo, return error substitute( "ren-b-code. &1&2&3", return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     3101             :
     3102               assign
     3103                 buf-ren_price-list.b-code = p-new-b-code
     3104                 .
     3105               for each buf-ren_price-list-attr exclusive-lock
     3106                 where buf-ren_price-list-attr.doc-num    = buf-ren_price-list.doc-num
     3107                   and buf-ren_price-list-attr.price-type = buf-ren_price-list.price-type
     3108                   and buf-ren_price-list-attr.b-code     = buf-ren_price-list.b-code
     3109                 on error undo, return error substitute( "ren-b-code. &1&2&3", return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     3110                 :
     3111                   assign
     3112                     buf-ren_price-list-attr.b-code = p-new-b-code
     3113                     .
     3114                 end.
     3115             end.
     3116           end.
     3117         end.
     3118         assign
     3119           v-num-entries = num-entries( "bar-code-attr,c-bar-code-attr,bar-code-obj-attr,c-bar-code-obj-attr,chk-gds,c-chk-gds,chk-gds-pay,doc-prts,doc-prts-attr,cd-doc-line,c-cd-doc-line,cd-plu,c-cd-plu,c-doc-prts,c-price-list,prod-bc-attr,c-prod-bc-attr,prod-bc-db,prod-bc-db-attr,c-prod-bc-db-attr,price-all,price-doc-forming-gds,price-doc-forming-gdsattr,price-doc-forming-gds-tnv,price-doc-forming-gds-sum,price-doc-forming-gds-qnty,c-price-doc-forming-gds,c-price-doc-forming-gdsattr,c-price-doc-forming-gds-tnv,c-price-doc-forming-gds-sum,c-price-doc-forming-gds-qnty,scales-gds,c-scales-gds,sert-join,c-sert,sert-join-attr":U )
     3120         .
     3121         do v-ind = 1 to v-num-entries
     3122         on error undo, return error substitute( "ren-b-code. &1&2&3", return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     3123         :
     3124           assign
     3125             v-tbl-name = substitute( "ub.&1":U, trim( entry( v-ind, "bar-code-attr,c-bar-code-attr,bar-code-obj-attr,c-bar-code-obj-attr,chk-gds,c-chk-gds,chk-gds-pay,doc-prts,doc-prts-attr,cd-doc-line,c-cd-doc-line,cd-plu,c-cd-plu,c-doc-prts,c-price-list,prod-bc-attr,c-prod-bc-attr,prod-bc-db,prod-bc-db-attr,c-prod-bc-db-attr,price-all,price-doc-forming-gds,price-doc-forming-gdsattr,price-doc-forming-gds-tnv,price-doc-forming-gds-sum,price-doc-forming-gds-qnty,c-price-doc-forming-gds,c-price-doc-forming-gdsattr,c-price-doc-forming-gds-tnv,c-price-doc-forming-gds-sum,c-price-doc-forming-gds-qnty,scales-gds,c-scales-gds,sert-join,c-sert,sert-join-attr":U ) ) )
     3126             v-query    = substitute( "for each &1 where &1.b-code = &2":U, v-tbl-name, p-old-b-code )
     3127           .
     3128           create buffer bh for table v-tbl-name .
     3129           create query qh .
     3130           qh:set-buffers( bh ).
     3131           qh:query-prepare( v-query ).
     3132           qh:query-open() .
     3133           qh:get-first( exclusive-lock ).
     3134           do while qh:query-off-end <> true
     3135           on error  undo, return error substitute( "ren-b-code (2.err). &1&2&3", return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     3136           on stop   undo, return error substitute( "ren-b-code (2.stop). &1&2&3", return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     3137           on quit   undo, return error substitute( "ren-b-code (2.quit). &1&2&3", return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     3138           on endkey undo, return error substitute( "ren-b-code (2.endkey). &1&2&3", return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     3139           :
     3140             assign
     3141               fh = bh:buffer-field( "b-code":U )
     3142               fh:buffer-value = p-new-b-code .
     3143             .
     3144             bh:buffer-release() no-error .
     3145             qh:get-next( exclusive-lock ).
     3146           END.
     3147           qh:query-close() .
     3148           delete object qh.
     3149           delete object bh.
     3150         end.
     3151       END.
     3152     end.
     3153     return.
     3154   end procedure.
     3155   def var vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3156   procedure gen-key-rec :
     3157     define input  parameter p-tbl-name    as character no-undo.
     3158     define input  parameter p-bh_tbl-name as handle    no-undo.
     3159     define output parameter p-key-rec     as character no-undo.
     3160     do
     3161     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     3162     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
     3163     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
     3164     :
     3165       define variable fh               as handle    no-undo .
     3166       define variable v-ok             as logical   no-undo .
     3167       define variable v-inform         as character no-undo .
     3168       define variable v-ind            as integer   no-undo .
     3169       define variable v-idx-field-qnty as integer   no-undo .
     3170       if p-tbl-name = ?
     3171         or p-tbl-name = "":U
     3172       then do:
     3173         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info31 ).
     3174       end.
     3175       if not p-bh_tbl-name:available then do:
     3176         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info31, p-tbl-name ).
     3177       end.
     3178       assign
     3179         p-key-rec = p-tbl-name
     3180         v-inform  = p-bh_tbl-name:index-information(1)
     3181         v-ind     = 2
     3182       .
     3183       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     3184       on error undo, return error
     3185       :
     3186         assign
     3187           v-inform = p-bh_tbl-name:index-information( v-ind )
     3188           v-ind    = v-ind + 1
     3189         .
     3190       end.
     3191       if v-inform = ?
     3192         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     3193         or entry( 3, v-inform, ",":U ) <> "1":U
     3194       then do:
     3195         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info31, p-tbl-name ).
     3196       end.
     3197       else do:
     3198         assign
     3199           v-idx-field-qnty = num-entries( v-inform ) - 4
     3200         .
     3201         if v-idx-field-qnty < 2 then do:
     3202           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info31, v-inform, p-tbl-name ).
     3203         end.
     3204         do v-ind = 1 to v-idx-field-qnty by 2
     3205         on error undo, return error
     3206         :
     3207           assign
     3208             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
     3209             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
     3210           .
     3211         end.
     3212       end.
     3213       if p-key-rec = ? then do:
     3214         assign
     3215           p-key-rec = "":U
     3216         .
     3217         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info31, p-tbl-name ).
     3218       end.
     3219     end.
     3220     return.
     3221   end procedure.
     3222   procedure gen-where-keyr-tab :
     3223     define input  parameter i-tableSerach as character no-undo.
     3224     define input  parameter i-tablekey   as character  no-undo.
     3225     define input  parameter p-key-rec    as character  no-undo.
     3226     define input  parameter p-key-handle as handle     no-undo .
     3227     define input  parameter p-db-name    as character  no-undo .
     3228     define input  parameter p-tt-handle  as handle     no-undo .
     3229     define output parameter o-Where      as character  no-undo.
     3230     do
     3231     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     3232     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     3233     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
     3234     :
     3235       define variable v-full-tbl-name  as character no-undo .
     3236       define variable bh_tbl-name      as handle    no-undo .
     3237       define variable fh_key           as handle    no-undo .
     3238       define variable fh_search        as handle    no-undo .
     3239       define variable v-field-num      as integer   no-undo .
     3240       define variable v-count-fld      as integer   no-undo .
     3241       define variable v-inform         as character no-undo .
     3242       define variable v-ind            as integer   no-undo .
     3243       define variable v-idx-field-qnty as integer   no-undo .
     3244       define variable v-field-name     as character no-undo .
     3245       define variable v-field-val      as character no-undo .
     3246       define variable v-word-link      as character no-undo .
     3247       define variable vTable           as character no-undo.
     3248       define variable bh_tbl-key       as handle    no-undo .
     3249       assign
     3250         p-key-rec = trim( p-key-rec )
     3251       .
     3252       if p-key-handle <> ? then do:
     3253         if not valid-handle(p-key-handle)
     3254            or p-key-handle:type <> "buffer"
     3255         then do:
     3256           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info31 ).
     3257         end.
     3258         if num-entries( p-key-rec, chr(3) ) > 1
     3259           or p-key-rec = ?
     3260           or p-key-rec = "":U
     3261         then do:
     3262           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info31, p-key-rec ).
     3263         end.
     3264       end.
     3265       else do:
     3266         if p-key-rec = ?
     3267           or p-key-rec = "":U
     3268         then do:
     3269           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info31 ).
     3270         end.
     3271       end.
     3272       assign
     3273         vTable = entry( 1 , p-key-rec, chr(3) )
     3274       .
     3275       if p-tt-handle <> ?
     3276         and ( not valid-handle(p-tt-handle)
     3277               or p-tt-handle:type <> "buffer"
     3278             )
     3279       then do:
     3280         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info31, vTable, chr(10) ).
     3281       end.
     3282       if p-tt-handle = ? then do:
     3283         assign
     3284           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
     3285         .
     3286         create buffer bh_tbl-name for table v-full-tbl-name .
     3287       end.
     3288       else do:
     3289         create buffer bh_tbl-name for table p-tt-handle:table-handle .
     3290       end.
     3291       assign
     3292         v-inform = bh_tbl-name:index-information(1)
     3293         v-ind    = 2
     3294       .
     3295       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     3296       on error undo, return error
     3297       :
     3298         assign
     3299           v-inform = bh_tbl-name:index-information( v-ind )
     3300           v-ind    = v-ind + 1
     3301         .
     3302       end.
     3303       if v-inform = ?
     3304         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     3305         or entry( 3, v-inform, ",":U ) <> "1":U
     3306       then do:
     3307         delete object bh_tbl-name no-error.
     3308         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info31, vTable ).
     3309       end.
     3310       assign
     3311         v-idx-field-qnty = num-entries( v-inform ) - 4
     3312       .
     3313       if v-idx-field-qnty < 2 then do:
     3314         delete object bh_tbl-name no-error.
     3315         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info31, v-inform, vTable ).
     3316       end.
     3317       assign
     3318         o-where     = "where":U
     3319         v-word-link = "":U
     3320         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
     3321         v-count-fld = 0
     3322       .
     3323       if i-tablekey ne "" and i-tablekey ne ?
     3324       then do:
     3325         assign
     3326           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
     3327         .
     3328         create buffer bh_tbl-key for table v-full-tbl-name .
     3329       end.
     3330       if i-tableSerach ne "" and i-tableSerach ne ?
     3331       then do:
     3332         delete object bh_tbl-name no-error.
     3333         assign
     3334           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
     3335         .
     3336         create buffer bh_tbl-name for table v-full-tbl-name .
     3337       end.
     3338       block_where:
     3339       do v-ind = 1 to v-idx-field-qnty by 2
     3340       on error undo, return error
     3341       :
     3342         assign
     3343           v-count-fld = v-count-fld + 1
     3344         .
     3345         if p-key-handle = ?
     3346           and v-count-fld > v-field-num
     3347         then do:
     3348           leave block_where.
     3349         end.
     3350         define variable VfieldKeyTable as handle no-undo.
     3351         assign
     3352           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     3353           fh_search    = bh_tbl-name:buffer-field( v-field-name )
     3354         .
     3355         if     bh_tbl-key ne ?
     3356         then do:
     3357            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
     3358            if VfieldKeyTable eq ?
     3359            then next block_where.
     3360         end.
     3361         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
     3362         then
     3363            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
     3364         else
     3365            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
     3366         if p-key-handle = ? then do:
     3367           assign
     3368             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
     3369           .
     3370         end.
     3371         else do:
     3372           assign
     3373             fh_key = p-key-handle:buffer-field( v-field-name )
     3374           .
     3375           if fh_key = ?
     3376             or not valid-handle( fh_key )
     3377           then do:
     3378             delete object bh_tbl-name.
     3379             if     bh_tbl-key ne ?
     3380             then
     3381                delete object bh_tbl-key.
     3382             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info31, p-key-handle:name, v-field-name ).
     3383           end.
     3384           assign
     3385             v-field-val = fh_key:buffer-value
     3386           .
     3387         end.
     3388         if fh_search:data-type ="character":U then do:
     3389           assign
     3390             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
     3391             v-field-val = replace( v-field-val, '"':U, '~~"':U )
     3392             v-field-val = replace( v-field-val, "'":U, "~~'":U )
     3393             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
     3394             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
     3395             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
     3396             v-field-val = replace( v-field-val, chr(10), '~~n':U )
     3397             v-field-val = replace( v-field-val, chr(9), '~~t':U )
     3398             v-field-val = replace( v-field-val, chr(13), '~~r':U )
     3399             v-field-val = replace( v-field-val, chr(27), '~~E':U )
     3400             v-field-val = replace( v-field-val, chr(8), '~~b':U )
     3401             v-field-val = replace( v-field-val, chr(12), '~~f':U )
     3402             v-field-val = substitute( '"&1"', v-field-val )
     3403           .
     3404         end.
     3405         assign
     3406           o-where = substitute( "&1 &2", o-where, v-field-val )
     3407         .
     3408         if v-word-link = "":U then do:
     3409           assign
     3410             v-word-link = "and":U
     3411           .
     3412         end.
     3413       end.
     3414       delete object bh_tbl-name.
     3415       if     bh_tbl-key ne ?
     3416       then
     3417          delete object bh_tbl-key.
     3418       if p-key-handle = ?
     3419         and v-count-fld <> v-field-num
     3420       then do:
     3421         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info31, vTable ).
     3422       end.
     3423     end.
     3424   end procedure.
     3425   procedure gen-hn-keyr-tab :
     3426     define input  parameter i-tableSerach as character no-undo.
     3427     define input  parameter i-tablekey   as character no-undo.
     3428     define input  parameter p-key-rec    as character no-undo.
     3429     define input  parameter p-key-handle as handle    no-undo .
     3430     define input  parameter p-db-name    as character no-undo .
     3431     define input  parameter p-tt-handle  as handle    no-undo .
     3432     define input  parameter p-stts-lock  as integer   no-undo .
     3433     define output parameter o-hn         as handle    no-undo.
     3434     define variable v-full-tbl-name as character no-undo.
     3435     define variable v-where         as character no-undo.
     3436     define variable bh_tbl-name     as handle    no-undo.
     3437     define variable vTable          as character no-undo.
     3438     do
     3439     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     3440     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     3441     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
     3442         run gen-where-keyr-tab(i-tableSerach,
     3443                                i-tablekey,
     3444                                p-key-rec,
     3445                                p-key-handle,
     3446                                p-db-name,
     3447                                p-tt-handle,
     3448                                output v-where).
     3449         if i-tableSerach ne "" and i-tableSerach ne ?
     3450         then do:
     3451            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
     3452            create buffer bh_tbl-name for table v-full-tbl-name .
     3453         end.
     3454         else do:
     3455            if p-tt-handle = ? then do:
     3456               assign
     3457                  vTable = entry( 1 , p-key-rec, chr(3) )
     3458               .
     3459               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
     3460               create buffer bh_tbl-name for table v-full-tbl-name .
     3461            end.
     3462            else do:
     3463               create buffer bh_tbl-name for table p-tt-handle:table-handle .
     3464            end.
     3465         end.
     3466         if p-tt-handle = ? then do:
     3467            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
     3468         end.
     3469         else do:
     3470            bh_tbl-name:find-first( v-where ) no-error .
     3471         end.
     3472         o-hn = bh_tbl-name.
     3473      end.
     3474   end procedure.
     3475   procedure gen-hn-keyr :
     3476     define input  parameter p-key-rec    as character no-undo.
     3477     define input  parameter p-key-handle as handle    no-undo .
     3478     define input  parameter p-db-name    as character no-undo .
     3479     define input  parameter p-tt-handle  as handle    no-undo .
     3480     define input  parameter p-stts-lock  as integer   no-undo .
     3481     define output parameter o-hn         as handle    no-undo.
     3482     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
     3483   end.
     3484   procedure gen-row-keyr :
     3485     define input  parameter p-key-rec    as character no-undo.
     3486     define input  parameter p-key-handle as handle    no-undo .
     3487     define input  parameter p-db-name    as character no-undo .
     3488     define input  parameter p-tt-handle  as handle    no-undo .
     3489     define input  parameter p-stts-lock  as integer   no-undo .
     3490     define output parameter p-tbl-row    as rowid     no-undo.
     3491     define output parameter p-tbl-name   as character no-undo.
     3492     define variable vHn as handle no-undo.
     3493       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
     3494       p-tbl-row = if vHn:available then vHn:rowid else ?.
     3495       p-tbl-name =  vHn:table.
     3496       delete object vHn no-error.
     3497     if p-tbl-row = ? then do:
     3498       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info31, p-tbl-name, p-key-rec ).
     3499     end.
     3500     else do:
     3501       return.
     3502     end.
     3503   end procedure.
     3504   procedure gen-key-fv :
     3505     define input  parameter p-key-rec    as character no-undo .
     3506     define output parameter p-field-list as character no-undo .
     3507     define output parameter p-value-list as character no-undo.
     3508     do
     3509     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     3510     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     3511     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     3512     :
     3513       define variable v-full-tbl-name  as character no-undo .
     3514       define variable bh_tbl-name      as handle    no-undo .
     3515       define variable v-tbl-name       as character no-undo .
     3516       define variable v-field-num      as integer   no-undo .
     3517       define variable v-count-fld      as integer   no-undo .
     3518       define variable v-inform         as character no-undo .
     3519       define variable v-ind            as integer   no-undo .
     3520       define variable v-idx-field-qnty as integer   no-undo .
     3521       define variable v-delim-key      as character no-undo .
     3522       if p-key-rec = ?
     3523         or p-key-rec = "":U
     3524       then do:
     3525         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info31 ).
     3526       end.
     3527       assign
     3528         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     3529         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     3530       .
     3531       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     3532       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info31 ).
     3533       assign
     3534         v-inform = bh_tbl-name:index-information(1)
     3535         v-ind    = 2
     3536       .
     3537       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     3538       on error undo, return error
     3539       :
     3540         assign
     3541           v-inform = bh_tbl-name:index-information( v-ind )
     3542           v-ind    = v-ind + 1
     3543         .
     3544       end.
     3545       if v-inform = ?
     3546         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     3547         or entry( 3, v-inform, ",":U ) <> "1":U
     3548       then do:
     3549         delete object bh_tbl-name no-error.
     3550         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info31, v-tbl-name ).
     3551       end.
     3552       assign
     3553         v-idx-field-qnty = num-entries( v-inform ) - 4
     3554       .
     3555       if v-idx-field-qnty < 2 then do:
     3556         delete object bh_tbl-name no-error.
     3557         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info31, v-inform, v-tbl-name ).
     3558       end.
     3559       assign
     3560         p-field-list = "":U
     3561         p-value-list = "":U
     3562         v-delim-key  = "":U
     3563         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     3564         v-count-fld  = 0
     3565       .
     3566       block_where:
     3567       do v-ind = 1 to v-idx-field-qnty by 2
     3568       on error undo, return error
     3569       :
     3570         assign
     3571           v-count-fld = v-count-fld + 1
     3572         .
     3573         if v-count-fld > v-field-num then do:
     3574           leave block_where.
     3575         end.
     3576         assign
     3577           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     3578           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     3579         .
     3580         if v-ind = 1 then do:
     3581           assign
     3582             v-delim-key = chr(3)
     3583           .
     3584         end.
     3585       end.
     3586       delete object bh_tbl-name.
     3587       if v-count-fld <> v-field-num then do:
     3588         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info31, v-tbl-name ).
     3589       end.
     3590     end.
     3591   end procedure.
     3592   procedure gen-key-field :
     3593     define input  parameter p-table      as character no-undo .
     3594     define output parameter p-field-list as character no-undo .
     3595     do
     3596     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     3597     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     3598     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     3599     :
     3600       define variable v-full-tbl-name  as character no-undo .
     3601       define variable bh_tbl-name      as handle    no-undo .
     3602       define variable v-tbl-name       as character no-undo .
     3603       define variable v-field-num      as integer   no-undo .
     3604       define variable v-count-fld      as integer   no-undo .
     3605       define variable v-inform         as character no-undo .
     3606       define variable v-ind            as integer   no-undo .
     3607       define variable v-idx-field-qnty as integer   no-undo .
     3608       define variable v-delim-key      as character no-undo .
     3609       if p-table = ?
     3610         or p-table = "":U
     3611       then do:
     3612         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info31 ).
     3613       end.
     3614       assign
     3615         v-tbl-name      = p-table
     3616         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     3617       .
     3618       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     3619       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info31 ).
     3620       assign
     3621         v-inform = bh_tbl-name:index-information(1)
     3622         v-ind    = 2
     3623       .
     3624       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     3625       on error undo, return error
     3626       :
     3627         assign
     3628           v-inform = bh_tbl-name:index-information( v-ind )
     3629           v-ind    = v-ind + 1
     3630         .
     3631       end.
     3632       if v-inform = ?
     3633         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     3634         or entry( 3, v-inform, ",":U ) <> "1":U
     3635       then do:
     3636         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info31, v-tbl-name ).
     3637       end.
     3638       assign
     3639         v-idx-field-qnty = num-entries( v-inform ) - 4
     3640       .
     3641       if v-idx-field-qnty < 2 then do:
     3642         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info31, v-inform, v-tbl-name ).
     3643       end.
     3644       assign
     3645         p-field-list = "":U
     3646         v-delim-key  = "":U
     3647         v-count-fld  = 0
     3648       .
     3649       block_where:
     3650       do v-ind = 1 to v-idx-field-qnty by 2
     3651       on error undo, return error
     3652       :
     3653         assign
     3654           v-count-fld = v-count-fld + 1
     3655         .
     3656         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     3657         if v-ind = 1 then do:
     3658           assign
     3659             v-delim-key = chr(3)
     3660           .
     3661         end.
     3662       end.
     3663       delete object bh_tbl-name.
     3664     end.
     3665   end procedure.
     3666   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3667   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3668   define variable tempcxml_v-num_ as integer no-undo .
     3669   define  temp-table temp-xml-tables no-undo
     3670   field order as integer
     3671   field tbl-name as character
     3672   field tbl-handle_ as handle
     3673   field table-handle_ as handle
     3674   field uniq-gate-rec as character
     3675   field gate-name as character
     3676   field gate-handle_ as handle
     3677   field is-parent as logical
     3678   index pi is unique primary
     3679   uniq-gate-rec
     3680   tbl-name
     3681   index iorder
     3682   order
     3683   index gr
     3684   uniq-gate-rec
     3685   index gh
     3686   gate-handle_
     3687   index iparent
     3688   is-parent
     3689   .
     3690   define  temp-table temp-xml-records no-undo
     3691   field tbl-name as character
     3692   field uniq-key-rec as character
     3693   index pi is unique primary
     3694   tbl-name
     3695   uniq-key-rec
     3696   .
     3697   def var vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3698   procedure get-gate-file-name :
     3699   define input parameter p-gate-rec as character no-undo .
     3700   define output  parameter p-gate-file-name as character no-undo .
     3701   define buffer buf_clob-data for ub.clob-data.
     3702   define variable v-tbl-row as rowid no-undo .
     3703   define variable v-tbl-name as character no-undo .
     3704   run gen-row-keyr in this-procedure ( input p-gate-rec
     3705                                       ,input ?
     3706                                       ,input "ub"
     3707                                       ,input ?
     3708                                       ,input no-lock
     3709                                       ,output v-tbl-row
     3710                                       ,output v-tbl-name) no-error.
     3711   if error-status:error then undo, return error substitute("&1 (get-gate-name) Несуществующий gate &2"
     3712                                                           ,vss-include-info32
     3713                                                           ,p-gate-rec).
     3714   find first buf_clob-data no-lock where
     3715             rowid(buf_clob-data) = v-tbl-row no-error.
     3716   if not available buf_clob-data then do:
     3717     if error-status:error then undo, return error substitute("&1 (get-gate-name) Несуществующий gate &2"
     3718                                                             ,vss-include-info32
     3719                                                             ,p-gate-rec).
     3720   end.
     3721   p-gate-file-name = buf_clob-data.file-name.
     3722   end procedure.
     3723   procedure get-gate-rec :
     3724   define input  parameter p-gate-name as character no-undo .
     3725   define output parameter p-gate-rec as character no-undo .
     3726   define buffer buf_clob-bind for ub.clob-bind.
     3727   define buffer buf_clob-data for ub.clob-data.
     3728   main-block:
     3729   do
     3730   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info32, return-value, chr(10), error-status :get-message (1))
     3731   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info32 )
     3732   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info32 )
     3733   :
     3734       find first buf_clob-bind no-lock where
     3735                 buf_clob-bind.uniq-key-rec = p-gate-name
     3736             and buf_clob-bind.field-name = '':U
     3737             and buf_clob-bind.part-num = 1
     3738             and buf_clob-bind.resource-type = 'gate':U
     3739             no-error.
     3740       if not available buf_clob-bind then do:
     3741         undo, return error substitute("Неверная ссылка на XSD -файл &1 для gate"
     3742                                         , p-gate-name
     3743                                         ).
     3744       end.
     3745       find first buf_clob-data no-lock where
     3746                 buf_clob-data.db-num = buf_clob-bind.db-num
     3747             and buf_clob-data.int64-i= buf_clob-bind.int64-id no-error.
     3748       if not available buf_clob-data then do:
     3749         undo, return error substitute("Не найден CLOB c ДБ &1 id &2 - файл &3"
     3750                                         , buf_clob-bind.db-num
     3751                                         , buf_clob-bind.int64-id
     3752                                         , p-gate-name
     3753                                         ).
     3754       end.
     3755       run gen-key-rec in this-procedure ( input 'clob-data':U
     3756                                 ,input buffer buf_clob-data:handle
     3757                                 ,output p-gate-rec).
     3758   end.
     3759   end procedure.
     3760   procedure get-gate-by-name :
     3761   define input  parameter p-gate-name as character no-undo .
     3762   define output parameter p-gate-rec as character no-undo .
     3763   define output parameter p-dsh as handle no-undo .
     3764   define input-output  parameter p-xmlh as handle no-undo .
     3765   define variable v-ii as integer   no-undo .
     3766   define variable glog as logical   no-undo .
     3767   define variable v-longchar as longchar no-undo .
     3768   define variable v-txmlh as handle no-undo .
     3769   define variable v-db-num as integer no-undo .
     3770   define variable v-int64-id as int64 no-undo .
     3771   define buffer buf_clob-bind for ub.clob-bind.
     3772   define buffer buf_clob-data for ub.clob-data.
     3773   main-block:
     3774   do
     3775   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info32, return-value, chr(10), error-status :get-message (1))
     3776   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info32 )
     3777   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info32 )
     3778   :
     3779       find first buf_clob-bind no-lock where
     3780                 buf_clob-bind.uniq-key-rec = p-gate-name
     3781             and buf_clob-bind.field-name = '':U
     3782             and buf_clob-bind.part-num = 1
     3783             and buf_clob-bind.resource-type = 'gate':U
     3784             no-error.
     3785       if not available buf_clob-bind then do:
     3786         undo, return error substitute("Неверная ссылка на XSD -файл &1 для gate"
     3787                                         , p-gate-name
     3788                                         ).
     3789       end.
     3790       find first buf_clob-data no-lock where
     3791                 buf_clob-data.db-num = buf_clob-bind.db-num
     3792             and buf_clob-data.int64-i= buf_clob-bind.int64-id no-error.
     3793       if not available buf_clob-data then do:
     3794         undo, return error substitute("Не найден CLOB c ДБ &1 id &2 - файл &3"
     3795                                         , buf_clob-bind.db-num
     3796                                         , buf_clob-bind.int64-id
     3797                                         , p-gate-name
     3798                                         ).
     3799       end.
     3800       assign
     3801       v-longchar = buf_clob-data.cdata
     3802       .
     3803       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     3804       if error-status :error then do:
     3805         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, buf_clob-data.file-name_, chr(10), error-status:get-message(1) , return-value ).
     3806       end.
     3807       create dataset p-dsh .
     3808       glog = p-dsh:READ-XMLSCHEMA( "LONGCHAR"
     3809                                     , v-longchar
     3810                                     , ?
     3811                                     , ?
     3812                                     , ?
     3813                                     ) no-error.
     3814       v-longchar = '':U.
     3815       if error-status :error
     3816       or not glog
     3817       then do:
     3818         undo, return error substitute("Не удалось прочитать XML-схему &1 из БД:&2&3", p-gate-name, chr(10), error-status:get-message(1) ).
     3819       end.
     3820       if not valid-handle(p-xmlh)
     3821       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     3822         create temp-table v-txmlh.
     3823         v-txmlh:create-like(buffer temp-xml-tables:handle).
     3824         v-txmlh:temp-table-prepare("temp-xml-tables").
     3825         p-xmlh = v-txmlh:default-buffer-handle.
     3826       end.
     3827       run gen-key-rec in this-procedure ( input 'clob-data':U
     3828                                 ,input buffer buf_clob-data:handle
     3829                                 ,output p-gate-rec).
     3830       do v-ii = 1 to p-dsh:num-buffers:
     3831         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     3832         if not p-xmlh:available then do:
     3833           p-xmlh:buffer-create().
     3834           assign
     3835           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     3836           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     3837           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     3838           p-xmlh::gate-handle_ = p-dsh
     3839           p-xmlh::uniq-gate-rec = p-gate-rec
     3840           p-xmlh::gate-name = p-dsh:name
     3841           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     3842           .
     3843           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     3844             assign
     3845             p-xmlh::order = -3.
     3846           end.
     3847         end.
     3848       end.
     3849   end.
     3850   end procedure.
     3851   procedure get-gate-by-rec :
     3852   define input  parameter p-gate-rec as character no-undo .
     3853   define output parameter p-dsh as handle no-undo .
     3854   define input-output  parameter p-xmlh as handle no-undo .
     3855   define input-output parameter p-longchar  as longchar no-undo .
     3856   define variable v-ii as integer   no-undo .
     3857   define variable glog as logical   no-undo .
     3858   define variable v-rowid as rowid no-undo .
     3859   define variable v-tbl-name as character no-undo .
     3860   define variable v-longchar as longchar no-undo .
     3861   define variable v-txmlh as handle no-undo .
     3862   define buffer buf_clob-data for ub.clob-data.
     3863   main-block:
     3864   do
     3865   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info32, return-value, chr(10), error-status :get-message (1))
     3866   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info32 )
     3867   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info32 )
     3868   :
     3869     run gen-row-keyr in this-procedure (
     3870                                           input  p-gate-rec
     3871                                           ,input  ?
     3872                                           ,input  "ub"
     3873                                           ,input  ?
     3874                                           ,input  NO-LOCK
     3875                                           ,output v-rowid
     3876                                           ,output v-tbl-name   ) no-error.
     3877       find first buf_clob-data no-lock where
     3878                 rowid(buf_clob-data) = v-rowid  no-error.
     3879       if not available buf_clob-data then do:
     3880         undo, return error substitute("Не найден CLOB  &1"
     3881                                         , p-gate-rec
     3882                                         ).
     3883       end.
     3884       assign
     3885       v-longchar = buf_clob-data.cdata
     3886       .
     3887       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     3888       if error-status :error then do:
     3889         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, buf_clob-data.file-name_, chr(10), error-status:get-message(1) , return-value ).
     3890       end.
     3891       create dataset p-dsh .
     3892       glog = p-dsh:READ-XMLSCHEMA( "LONGCHAR"
     3893                                     , v-longchar
     3894                                     , ?
     3895                                     , ?
     3896                                     , ?
     3897                                     ) no-error.
     3898       define variable v-esm as character no-undo .
     3899       v-esm = error-status:get-message(1) .
     3900       if p-longchar <> ? then do:
     3901         p-longchar = v-longchar.
     3902       end.
     3903       v-longchar = '':U.
     3904       if error-status :error
     3905       or not glog
     3906       then do:
     3907         undo, return error substitute("Не удалось прочитать XML-схему &1 (&2) из БД&3&4"
     3908                                      , p-gate-rec
     3909                                      , p-gate-rec
     3910                                      , v-esm
     3911                                      ).
     3912       end.
     3913       p-dsh:private-data = buf_clob-data.file-name_ + chr(4) + p-gate-rec.
     3914       if not valid-handle(p-xmlh)
     3915       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     3916         create temp-table v-txmlh.
     3917         v-txmlh:create-like(buffer temp-xml-tables:handle).
     3918         v-txmlh:temp-table-prepare("temp-xml-tables").
     3919         p-xmlh = v-txmlh:default-buffer-handle.
     3920       end.
     3921       do v-ii = 1 to p-dsh:num-buffers:
     3922         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     3923         if not p-xmlh:available then do:
     3924           p-xmlh:buffer-create().
     3925           assign
     3926           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     3927           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     3928           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     3929           p-xmlh::gate-handle_ = p-dsh
     3930           p-xmlh::uniq-gate-rec = p-gate-rec
     3931           p-xmlh::gate-name = p-dsh:name
     3932           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     3933           .
     3934           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     3935             assign
     3936             p-xmlh::order = -3.
     3937           end.
     3938           p-xmlh:buffer-release().
     3939         end.
     3940       end.
     3941   end.
     3942   end procedure.
     3943   procedure get-gate-by-file :
     3944   define input  parameter p-schema-file-name as character no-undo .
     3945   define input  parameter p-gate-rec as character no-undo .
     3946   define output parameter p-dsh as handle no-undo .
     3947   define input-output  parameter p-xmlh as handle no-undo .
     3948   define variable v-ii as integer   no-undo .
     3949   define variable glog as logical   no-undo .
     3950   define variable v-rowid as rowid no-undo .
     3951   define variable v-tbl-name as character no-undo .
     3952   define variable v-longchar as longchar no-undo .
     3953   define variable v-txmlh as handle no-undo .
     3954   main-block:
     3955   do
     3956   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info32, return-value, chr(10), error-status :get-message (1))
     3957   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info32 )
     3958   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info32 )
     3959   :
     3960       COPY-LOB
     3961       FROM  FILE p-schema-file-name
     3962       TO  OBJECT v-longchar
     3963       no-convert
     3964       NO-ERROR .
     3965       if error-status :error then do:
     3966           undo, return error substitute("Не удалось считать файл схемы &1 в память&2&3"
     3967                                     , p-schema-file-name
     3968                                 , chr(10)
     3969                                 , error-status:get-message(1) ).
     3970       end.
     3971       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     3972       if error-status :error then do:
     3973         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, p-schema-file-name, chr(10), error-status:get-message(1) , return-value ).
     3974       end.
     3975       create dataset p-dsh .
     3976       glog = p-dsh:READ-XMLSCHEMA( "longchar"
     3977                                     , v-longchar
     3978                                     , ?
     3979                                     , ?
     3980                                     , ?
     3981                                     ) no-error.
     3982       v-longchar = ''.
     3983       if error-status :error
     3984       or not glog
     3985       then do:
     3986         undo, return error substitute("Не удалось прочитать XML-схему из файла &1&2&3"
     3987                                      , p-schema-file-name
     3988                                      ,chr(10)
     3989                                      , error-status:get-message(1)
     3990                                      ).
     3991       end.
     3992       if not valid-handle(p-xmlh)
     3993       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     3994         create temp-table v-txmlh.
     3995         v-txmlh:create-like(buffer temp-xml-tables:handle).
     3996         v-txmlh:temp-table-prepare("temp-xml-tables").
     3997         p-xmlh = v-txmlh:default-buffer-handle.
     3998       end.
     3999       do v-ii = 1 to p-dsh:num-buffers:
     4000         p-xmlh:find-first(substitute(' where tbl-name = "&1" and  uniq-gate-rec = "&2" '
     4001                                      ,p-dsh:get-buffer-handle(v-ii):name
     4002                                      ,p-gate-rec
     4003                                      )) no-error.
     4004         if not p-xmlh:available then do:
     4005           p-xmlh:buffer-create().
     4006           assign
     4007           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):table
     4008           p-xmlh::uniq-gate-rec = p-gate-rec
     4009           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     4010           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     4011           p-xmlh::gate-handle_ = p-dsh
     4012           p-xmlh::gate-name = p-dsh:name
     4013           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     4014           .
     4015           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     4016             assign
     4017             p-xmlh::order = -3.
     4018           end.
     4019           p-xmlh:buffer-release().
     4020         end.
     4021       end.
     4022   end.
     4023   end procedure.
     4024   procedure gate-clear :
     4025   define input  parameter p-dsh as handle no-undo .
     4026   define input  parameter p-xmlh as handle no-undo .
     4027   define variable v-dsh as handle no-undo .
     4028   define variable v-th as handle no-undo .
     4029     do
     4030     on error undo, return error return-value
     4031     :
     4032       if valid-handle(p-dsh) then do:
     4033         delete object p-dsh.
     4034         v-dsh = p-dsh.
     4035         p-dsh = ?.
     4036       end.
     4037       repeat while true:
     4038         p-xmlh:find-first( substitute( " where gate-handle_ = &1 ", v-dsh)
     4039                            , share-lock) no-error.
     4040         if p-xmlh:available then do:
     4041           assign
     4042           v-th = p-xmlh:buffer-field("table-handle_"):buffer-value.
     4043           if valid-handle(p-xmlh:buffer-field("table-handle_"))
     4044           and valid-handle(v-th)
     4045           and v-th:dynamic = yes
     4046           then do:
     4047             delete object p-xmlh:buffer-field("table-handle_"):buffer-value.
     4048             p-xmlh:buffer-field("table-handle_"):buffer-value = ?.
     4049           end.
     4050           p-xmlh:buffer-delete().
     4051         end.
     4052         else do:
     4053           leave.
     4054         end.
     4055       end.
     4056       if p-xmlh:dynamic = yes
     4057       and valid-handle(p-xmlh)
     4058       then do:
     4059         delete object p-xmlh:table-handle.
     4060         p-xmlh = ?.
     4061       end.
     4062       v-dsh = ?.
     4063     end.
     4064   end procedure.
     4065   procedure all-gates-clear :
     4066   define parameter buffer buf_temp-xml-tables for temp-xml-tables.
     4067   do
     4068   on error undo, return error
     4069   :
     4070     for each buf_temp-xml-tables
     4071     break
     4072     by buf_temp-xml-tables.uniq-gate-rec
     4073     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     4074     on stop   undo , return error substitute( "&1. stop", vss-workfile )
     4075     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     4076     :
     4077         if first-of(buf_temp-xml-tables.uniq-gate-rec) then do:
     4078           delete object buf_temp-xml-tables.gate-handle_.
     4079           buf_temp-xml-tables.gate-handle_ = ?.
     4080         end.
     4081         if valid-handle(buf_temp-xml-tables.table-handle_)
     4082         and buf_temp-xml-tables.table-handle_:dynamic = no
     4083         then do:
     4084           delete object buf_temp-xml-tables.table-handle_.
     4085           buf_temp-xml-tables.table-handle_ = ?.
     4086         end.
     4087         delete buf_temp-xml-tables.
     4088     end.
     4089   end.
     4090   end procedure.
     4091   procedure fix-schemalocation :
     4092   define input-output  parameter p-longchar as longchar no-undo .
     4093   DEFINE VARIABLE hdoc AS HANDLE.
     4094   DEFINE VARIABLE hroot AS HANDLE.
     4095   DEFINE VARIABLE hnode-child AS HANDLE.
     4096   DEFINE VARIABLE hnode-attr AS HANDLE.
     4097   define variable v-jj as integer   no-undo .
     4098   define variable ok as logical   no-undo .
     4099   define variable v-path1                    as character                no-undo .
     4100   DEFINE VARIABLE v-full-path1               as character                no-undo .
     4101   DEFINE VARIABLE v-file-name1               as character                no-undo .
     4102   DEFINE VARIABLE v-file-name-no-ext1        as character                no-undo .
     4103   DEFINE VARIABLE v-file-name-ext1           as character                no-undo .
     4104   define variable v-schema-location          as character                no-undo .
     4105   do
     4106   on error undo, return error return-value
     4107   :
     4108     CREATE X-DOCUMENT hdoc.
     4109     CREATE X-noderef hroot.
     4110     CREATE X-noderef hnode-child.
     4111     CREATE X-noderef hnode-attr.
     4112     hdoc:load("longchar", p-longchar, no) no-error.
     4113     iF ERROR-STATUS:GET-MESSAGE(1) <> '' THEN message ERROR-STATUS:GET-MESSAGE(1) view-as alert-box .
     4114     hdoc:get-document-element(hroot).
     4115     _repeat:
     4116     REPEAT v-jj = 1 TO hroot:NUM-CHILDREN:
     4117       ok = hroot:GET-CHILD(hNode-Child, v-jj).
     4118       if not ok then next.
     4119       if hNode-Child:local-name = "include"
     4120       then do:
     4121         ok = hNode-Child:GET-ATTRIBUTE-NODE( hnode-attr, "schemaLocation" ).
     4122           v-schema-location = hnode-attr:node-value.
     4123           run gbl/filename.p (
     4124                           input "exe/" + hnode-attr:node-value
     4125                         ,output v-full-path1
     4126                         ,output v-path1
     4127                         ,output v-file-name1
     4128                         ,output v-file-name-no-ext1
     4129                         ,output v-file-name-ext1
     4130                         ) no-error .
     4131           if error-status :error then do:
     4132             delete object hnode-attr.
     4133             delete object hnode-child.
     4134             delete object hroot.
     4135             delete object hdoc.
     4136             undo, return error substitute("Не удалось определить расположение схемы &1", v-schema-location).
     4137           end.
     4138         ok = hNode-Child:sET-ATTRIBUTE(  "schemaLocation", v-full-path1 ).
     4139         leave  _repeat.
     4140       end.
     4141     END.
     4142     hdoc:save("longchar", p-longchar).
     4143     delete object hnode-attr.
     4144     delete object hnode-child.
     4145     delete object hroot.
     4146     delete object hdoc.
     4147   end.
     4148   end procedure.
     4149   procedure gate-clb_fill-xml-tables :
     4150   define input parameter p-dsh as handle no-undo .
     4151   define input-output parameter p-xmlh as handle no-undo .
     4152   define variable v-ii as integer no-undo .
     4153     do
     4154     on error undo, return error
     4155     :
     4156       do v-ii = 1 to p-dsh:num-buffers:
     4157         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     4158         if not p-xmlh:available then do:
     4159           p-xmlh:buffer-create().
     4160           assign
     4161           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     4162           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     4163           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     4164           p-xmlh::gate-handle_ = p-dsh
     4165           p-xmlh::uniq-gate-rec = entry(2, p-dsh:private-data, chr(4))
     4166           p-xmlh::gate-name = p-dsh:name
     4167           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     4168           .
     4169           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     4170             assign
     4171             p-xmlh::order = -3.
     4172           end.
     4173           p-xmlh:buffer-release().
     4174         end.
     4175       end.
     4176     end.
     4177   end procedure.
     4178   procedure all-gates-empty :
     4179   define buffer buf_temp-xml-tables for temp-xml-tables.
     4180   do
     4181   on error undo, return error
     4182   :
     4183     for each buf_temp-xml-tables
     4184     break
     4185     by buf_temp-xml-tables.uniq-gate-rec
     4186     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     4187     on stop   undo , return error substitute( "&1. stop", vss-workfile )
     4188     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     4189     :
     4190       if valid-handle(buf_temp-xml-tables.tbl-handle_) then do:
     4191         buf_temp-xml-tables.tbl-handle_:empty-temp-table().
     4192       end.
     4193     end.
     4194   end.
     4195   end procedure.
     4196   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4197   define new global shared variable g#lib-nws as handle no-undo .
     4198   define variable vss-include-info36 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4199   define variable v-proc-name  as character no-undo .
     4200   define variable v-proc-avail as logical   no-undo .
     4201   define new global shared variable g#load-rec  as handle no-undo .
     4202   define stream imp-stream.
     4203   define temp-table tt_pck-rcvd      no-undo like ub.pck-rcvd .
     4204   define temp-table tt_pck-rcvd-attr no-undo like ub.pck-rcvd-attr .
     4205   define temp-table tt_pck-sent      no-undo like ub.pck-sent .
     4206   define variable v-sub-rec-cnt as integer   no-undo.
     4207   define variable v-rec-cnt     as integer   no-undo.
     4208   define variable v-file-hash   as character no-undo .
     4209   define frame imp-pck
     4210     p-db-src        label "БД" skip
     4211     p-pck-num       label "Пакет" format ">>>>>>>>>9" skip
     4212     p-file-pck-name label "Файл пакета" format "x(50)" skip
     4213     v-rec-cnt       label "Основных записей" format ">>>>>>>>>9" skip
     4214     v-sub-rec-cnt   label "Привязанных" format ">>>>>>>>>9" skip
     4215     with view-as dialog-box side-labels 1 columns three-d title "** Разбор пакета"
     4216   .
     4217     define variable mFrameView      as logical   no-undo init yes.
     4218   define new global shared variable mBatchMode as logical no-undo init ?.
     4219   define variable mFramBachModHandle as handle no-undo.
     4220   mFramBachModHandle = frame imp-pck:handle.
     4221   define variable mFameOldVis as logical no-undo.
     4222   define variable mVisCUrentVin as logical no-undo.
     4223   if session:batch-mode
     4224   then
     4225      mBatchMode = yes.
     4226   if mBatchMode = ? then do:
     4227     mVisCUrentVin = current-window:visible.
     4228     mFameOldVis = mFramBachModHandle:visible.
     4229     mFramBachModHandle:visible  = yes.
     4230     mBatchMode = mFramBachModHandle:visible ne yes.
     4231     mFramBachModHandle:visible = mFameOldVis.
     4232     current-window:visible = mVisCUrentVin.
     4233   end.
     4234    if  log-manager:logfile-name ne ?
     4235     then DO:
     4236         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     4237         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     4238         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     4239     end.
     4240     if  log-manager:logfile-name ne ?
     4241     then DO:
     4242         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameNWSError").
     4243         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameNWSError").
     4244     end.
     4245     mFrameView = not mBatchMode.
     4246   if transaction then do:
     4247     message
     4248       vss-workfile vss-revision vss-description skip
     4249       substitute( "Вызов данной процедуры невозможен при наличии транзакции" )
     4250       view-as alert-box error
     4251     .
     4252     return error .
     4253   end.
     4254   run str/imp2cdseth.p(this-procedure).
     4255   main_block:
     4256   do
     4257   on error  undo, return error substitute("&1. error main_block. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     4258   on endkey undo, return error substitute("&1. endkey main_block")
     4259   on stop   undo, return error substitute("&1. stop main_block")
     4260   :
     4261     define variable v-err-msg as character no-undo .
     4262     for each gds-list:
     4263       delete gds-list.
     4264     end.
     4265     for each gdsolist:
     4266       delete gdsolist.
     4267     end.
     4268     for each bc-list:
     4269       delete bc-list.
     4270     end.
     4271     for each pbc-list:
     4272       delete pbc-list.
     4273     end.
     4274     for each dc-list:
     4275       delete dc-list.
     4276     end.
     4277     for each cash-txn:
     4278       delete cash-txn.
     4279     end.
     4280     for each cash-txr:
     4281       delete cash-txr.
     4282     end.
     4283     for each stpl-list:
     4284       delete stpl-list.
     4285     end.
     4286     for each cash-pay-list:
     4287       delete cash-pay-list.
     4288     end.
     4289     for each PromoAction-list:
     4290       delete PromoAction-list.
     4291     end.
     4292      for each ext-classif-list:
     4293         delete ext-classif-list.
     4294      end.
     4295      for each c-ext-classif-list:
     4296         delete c-ext-classif-list.
     4297      end.
     4298     assign
     4299       v-err-msg = "":U .
     4300     .
     4301     run gbl/md5.p(p-file-pck-name, output v-file-hash).
     4302     run write-to-log( substitute("Файл: &1; Контрольная сумма: &2.", p-file-pck-name,  v-file-hash) ) .
     4303     input stream imp-stream from value( p-file-pck-name ).
     4304     run local-imp-pck in this-procedure
     4305        no-error .
     4306     if error-status :error then do:
     4307       assign
     4308         v-err-msg = substitute( "Ошибка приема пакета &1&2&3", p-file-pck-name, chr(10), return-value ).
     4309       .
     4310     end.
     4311     input stream imp-stream close .
     4312   define variable vss-include-info37 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4313     run send-to-cash no-error.
     4314     if error-status:error then do:
     4315       run write-to-log("Ошибка при отправке на кассу" + chr(10)
     4316                        + return-value
     4317                       ) no-error.
     4318     end.
     4319     assign
     4320       g#news-source-db = -1
     4321     .
     4322     if v-err-msg <> "":U then do:
     4323       undo, return error v-err-msg .
     4324     end.
     4325   end.
     4326   return .
     4327   procedure local-imp-pck :
     4328     do
     4329     on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     4330     on stop   undo, return error substitute( "&1. stop", vss-workfile )
     4331     on endkey undo, return error substitute( "&1. endkey", vss-workfile )
     4332     :
     4333       define buffer buf_sys-ctrl          for ub.sys-ctrl .
     4334       define buffer buf_pck-sent          for ub.pck-sent .
     4335       define buffer buf_pck-rcvd          for ub.pck-rcvd .
     4336       define buffer buf-src_db            for ub.db .
     4337       define buffer buf-dst_db            for ub.db .
     4338       define buffer buf-for-sent_pck-rcvd for ub.pck-rcvd.
     4339       define buffer buf-for-rcvd_pck-sent for ub.pck-sent .
     4340       define buffer buf_route             for ub.route .
     4341       define variable v-ver-num     as character no-undo .
     4342       define variable v-rec-full       as character no-undo.
     4343       define variable v-rec-name       as character no-undo.
     4344       define variable v-sub-rec-num    as integer   no-undo.
     4345       define variable v-curr-rowid     as rowid     no-undo .
     4346       define variable v-uniq-gate-rec  as character no-undo .
     4347       define variable v-uniq-key-rt    as character no-undo .
     4348       define variable Ok               as logical   no-undo.
     4349       define variable pck-name-bad     as character no-undo.
     4350       define variable v-present        as logical   no-undo .
     4351       define variable v-ind            as integer   no-undo.
     4352       define variable v-qnty-skip      as integer   no-undo.
     4353       define variable v-today          as date      no-undo .
     4354       define variable v-time           as integer   no-undo .
     4355       define variable v-prev-crc       as character no-undo .
     4356       define variable v-pos            as integer   no-undo .
     4357       define variable v-temp-str       as character no-undo .
     4358       define variable v-temp-all       as character extent 1000 no-undo .
     4359       define variable v-beg-date      as character no-undo .
     4360       define variable v-beg-time      as character no-undo .
     4361       define variable v-type          as character no-undo .
     4362       define variable v-deleted       as logical   no-undo .
     4363       define variable v-pck-attr-exist as logical   no-undo .
     4364       define variable v-del-pck-num    as integer   no-undo.
     4365       define variable v-del-cnt        as integer   no-undo.
     4366       define frame del-route
     4367         v-del-pck-num   label "Пакет N" format ">>>>>>>>>9" skip
     4368         v-del-cnt       label "Записей" format ">>>>>>>>>9"
     4369         with view-as dialog-box side-labels 1 columns three-d title "Удаление маршрутизации"
     4370       .
     4371       find buf-src_db no-lock
     4372         where buf-src_db.db-num = p-db-src
     4373       .
     4374       if trim( buf-src_db.db-key ) = "":U
     4375         or buf-src_db.db-key = ?
     4376       then do:
     4377         run write-to-log( substitute("СПН для БД &1 отключена. Пакеты не принимаются.", p-db-src ) ) .
     4378         undo, return error.
     4379       end.
     4380       find first buf_sys-ctrl no-lock .
     4381       find buf-dst_db no-lock
     4382         where buf-dst_db.db-num = buf_sys-ctrl.db-num
     4383       .
     4384       run write-to-log( substitute("Разбор пакета N &1 из БД N &2", p-pck-num, p-db-src ) ) no-error.
     4385       if mFrameView
     4386       then do:
     4387          view frame imp-pck.
     4388          assign
     4389            frame imp-pck:title = substitute( "&1 из БД &2", frame imp-pck:title, trim( string( p-db-src, ">>>>>>>>9" ) ) )
     4390          .
     4391          do with frame imp-pck
     4392          :
     4393             assign
     4394                p-db-src :screen-value        = string( p-db-src, p-db-src :format)
     4395                p-pck-num :screen-value       = string( p-pck-num, p-pck-num :format)
     4396                p-file-pck-name :screen-value = string( p-file-pck-name, p-file-pck-name :format)
     4397             .
     4398          end.
     4399       end.
     4400       run cur-time in this-procedure
     4401         ( output v-today
     4402         , output v-time
     4403         ) no-error .
     4404       if error-status :error then do:
     4405         run write-to-log( vss-workfile + chr(32)
     4406                           + "Ошибка при определении текущей даты!"
     4407                         ).
     4408         undo, return error.
     4409       end.
     4410       run pck-attr-exist
     4411         ( input "pck-rcvd":U
     4412         , input p-db-src
     4413         , input p-pck-num
     4414         , input 'beg-imp-date':U
     4415         , output v-pck-attr-exist
     4416         ) no-error.
     4417       if error-status :error then do:
     4418         run write-to-log( substitute( "&1. Ошибка при определении наличия атрибута начала разбора пакета &2 из БД &3"
     4419                                       ,vss-workfile
     4420                                       ,p-pck-num
     4421                                       ,p-db-src
     4422                                     )
     4423                         ) .
     4424       end.
     4425       if v-pck-attr-exist <> true then do:
     4426         run pck-attr-write in this-procedure
     4427           ( input "pck-rcvd":U
     4428           , input p-db-src
     4429           , input p-pck-num
     4430           , input 'beg-imp-date':U
     4431           , input string( v-today, "99/99/9999" )
     4432           ) no-error.
     4433         if error-status :error then do:
     4434           run write-to-log( substitute( "&1. Ошибка записи атрибута даты начала разбора пакета &2 из БД &3"
     4435                                         ,vss-workfile
     4436                                         ,p-pck-num
     4437                                         ,p-db-src
     4438                                       )
     4439                           ) .
     4440           undo, return error.
     4441         end.
     4442         run pck-attr-write in this-procedure
     4443           ( input "pck-rcvd":U
     4444           , input p-db-src
     4445           , input p-pck-num
     4446           , input 'beg-imp-time':U
     4447           , input string( v-time, ">>>>>>>>>9" )
     4448           ) no-error.
     4449         if error-status :error then do:
     4450           run write-to-log( substitute( "&1. Ошибка записи атрибута времени начала разбора пакета &2 из БД &3"
     4451                                         ,vss-workfile
     4452                                         ,p-pck-num
     4453                                         ,p-db-src
     4454                                       )
     4455                           ) .
     4456           undo, return error.
     4457         end.
     4458         run db-attr-write in this-procedure
     4459           ( input p-db-src
     4460           ,input 'need-gen-new-pack':U
     4461           ,input "yes":U
     4462           ) no-error.
     4463         if error-status :error then do:
     4464           run write-to-log( substitute( "&1. Ошибка записи атрибута формирования нового пакета для БД &2"
     4465                                         ,vss-workfile
     4466                                         ,p-db-src
     4467                                       )
     4468                           ) .
     4469           undo, return error.
     4470         end.
     4471       end.
     4472       find first buf_pck-rcvd no-lock
     4473         where buf_pck-rcvd.db-num   = p-db-src
     4474           and buf_pck-rcvd.pack-num = p-pck-num - 1
     4475         no-error
     4476       .
     4477       if available buf_pck-rcvd then do:
     4478         assign
     4479           v-prev-crc = buf_pck-rcvd.crc-pack
     4480         .
     4481       end.
     4482       else do:
     4483         assign
     4484           v-prev-crc = "":U
     4485         .
     4486       end.
     4487       assign
     4488         Ok = FALSE
     4489         .
     4490       assign
     4491         g#news-source-db = p-db-src
     4492         v-rec-cnt = 0
     4493         v-sub-rec-cnt = 0
     4494       .
     4495       run nws-imps in this-procedure
     4496         ( input-output v-sub-rec-cnt
     4497          ,output       v-rec-full
     4498         ) no-error.
     4499       if error-status :error
     4500         or v-rec-full = ?
     4501       then do:
     4502         undo, return error substitute( "Ошибка приема записи N &1&2&3", v-rec-cnt, chr(10), return-value ).
     4503       end.
     4504       else do:
     4505         assign
     4506           v-rec-name = trim( entry( 1, v-rec-full, chr(1) ) )
     4507         .
     4508       end.
     4509       if v-rec-name <> "pck-conf":U then do:
     4510         run write-to-log( substitute( "&1. Ошибка пакета! Первая запись должна быть конфигурацией пакета ( pck-conf )"
     4511                                       ,vss-workfile
     4512                                     )
     4513                         ).
     4514         undo, return error.
     4515       end.
     4516       create t-pck-conf.
     4517       run nws-impl-without-check in this-procedure
     4518         ( input (buffer t-pck-conf:handle)
     4519         ) no-error.
     4520       if error-status :error then do:
     4521         return error return-value .
     4522       end.
     4523       run get-version-num in parparentproc
     4524         ( output v-ver-num
     4525         ).
     4526       if t-pck-conf.db-num-dst <> g#db-num then do:
     4527         run write-to-log( substitute( "&1. Ошибка приема! Ожидается прием пакета для БД № &2, а данный пакет для БД № &3"
     4528                                       ,vss-workfile
     4529                                       ,g#db-num
     4530                                       ,t-pck-conf.db-num-dst
     4531                                     )
     4532                         ).
     4533         undo, return error.
     4534       end.
     4535       if t-pck-conf.db-num-src <> p-db-src then do:
     4536         run write-to-log( substitute( "&1. Ошибка приема! Ожидается прием пакета из БД № &2, а данный пакет из БД № &3"
     4537                                       ,vss-workfile
     4538                                       ,p-db-src
     4539                                       ,t-pck-conf.db-num-src
     4540                                     )
     4541                         ).
     4542         undo, return error.
     4543       end.
     4544       if t-pck-conf.src_db-key <> buf-src_db.db-key then do:
     4545         run write-to-log( substitute( "&1. Ошибка приема! Ожидается прием пакета из БД с ключем &2, а данный пакет из БД с ключем &3"
     4546                                       ,vss-workfile
     4547                                       ,buf-src_db.db-key
     4548                                       ,t-pck-conf.src_db-key
     4549                                     )
     4550                         ).
     4551         undo, return error.
     4552       end.
     4553       if t-pck-conf.dst_db-key <> buf-dst_db.db-key then do:
     4554         run write-to-log( substitute( "&1. Ошибка приема! Ожидается прием пакета для БД с ключем &2, а данный пакет для БД с ключем &3"
     4555                                       ,vss-workfile
     4556                                       ,buf-dst_db.db-key
     4557                                       ,t-pck-conf.dst_db-key
     4558                                     )
     4559                         ).
     4560         undo, return error.
     4561       end.
     4562       if t-pck-conf.pack-num <> p-pck-num then do:
     4563         run write-to-log( substitute( "&1. Ошибка приема! Ожидается пакет № &2, а данный пакет № &3"
     4564                                     ,vss-workfile
     4565                                     ,p-pck-num
     4566                                     ,t-pck-conf.pack-num
     4567                                     )
     4568                         ).
     4569         undo, return error.
     4570       end.
     4571       if t-pck-conf.prev-crc <> v-prev-crc then do:
     4572         run write-to-log( substitute("&1. Ошибка приема! Пакет &2 сформирован в некорректной БД", vss-workfile, p-pck-num) ).
     4573         undo, return error.
     4574       end.
     4575       run trg/db-stat.p
     4576         (input p-db-src
     4577         ,input t-pck-conf.actual-date
     4578         ,input t-pck-conf.actual-time-int
     4579         ) no-error .
     4580       if error-status :error
     4581       then do:
     4582         undo, return error substitute( "Ошибка при вызове сохранении даты актуальности остатков &1 &2 запись N &3 ", chr(10), return-value, v-rec-cnt ) .
     4583       end.
     4584       beg-imp:
     4585       repeat
     4586       on error  undo, return error substitute("&1. error beg-imp. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     4587       on endkey undo, return error substitute("&1. endkey beg-imp")
     4588       on stop   undo, return error substitute("&1. stop beg-imp")
     4589       :
     4590         assign
     4591           v-sub-rec-cnt = 0
     4592         .
     4593         run nws-imps in this-procedure
     4594           ( input-output v-sub-rec-cnt
     4595            ,output       v-rec-full
     4596           ) no-error.
     4597         if error-status :error
     4598           or v-rec-full = ?
     4599         then do:
     4600           undo, return error substitute( "Ошибка приема записи N &1&2&3", v-rec-cnt, chr(10), return-value ).
     4601         end.
     4602         assign
     4603           v-rec-name    = trim( entry( 1, v-rec-full, chr(1) ) )
     4604         .
     4605         if v-rec-name <> '**END OF PACKET**':U then do:
     4606           assign
     4607             v-uniq-gate-rec = entry( num-entries( v-rec-full, chr(1) ) - 4, v-rec-full, chr(1) )
     4608             v-uniq-key-rt   = entry( num-entries( v-rec-full, chr(1) ) - 3, v-rec-full, chr(1) )
     4609             v-sub-rec-num   = integer( entry( num-entries( v-rec-full, chr(1) ) - 2, v-rec-full, chr(1) ) )
     4610           .
     4611         end.
     4612         CASE v-rec-name:
     4613           when "pck-conf":U then do :
     4614             run nws-impl-without-check in this-procedure
     4615               ( input (buffer t-pck-conf:handle)
     4616               ) no-error.
     4617             if error-status :error then do:
     4618               return error return-value .
     4619             end.
     4620           end.
     4621           when 'pck-sent':U then do :
     4622             transaction_block_pck-sent:
     4623             do transaction
     4624             on error  undo, return error substitute("&1. error transaction_block_pck-sent. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     4625             on endkey undo, return error substitute("&1. endkey transaction_block_pck-sent")
     4626             on stop   undo, return error substitute("&1. stop transaction_block_pck-sent")
     4627             :
     4628               create tt_pck-sent.
     4629               assign
     4630                 v-pos = seek( imp-stream )
     4631               .
     4632               run nws-impl-without-check in this-procedure
     4633                 ( input (buffer tt_pck-sent:handle)
     4634                 ) no-error.
     4635               if error-status :error then do:
     4636                 return error return-value .
     4637               end.
     4638               if tt_pck-sent.pack-num = p-pck-num then do:
     4639                 if trim( tt_pck-sent.crc-pack ) = "" then do:
     4640                   seek stream imp-stream to v-pos .
     4641                   import stream imp-stream UNFORMATTED v-temp-str .
     4642                   run write-to-log( vss-workfile + chr(32)
     4643                                     + substitute( "Ошибка обработки пакета: пакет N &1 не имеет ключа!!!", p-pck-num ) + chr(10)
     4644                                     + substitute(" Позиция в файле &1", seek(imp-stream) ) + chr(10)
     4645                                     + substitute("&1", v-temp-str ) + chr(10)
     4646                                     ).
     4647                   undo, return error.
     4648                 end.
     4649                 if num-entries( tt_pck-sent.crc-pack, chr(32) ) < 4 then do:
     4650                   seek stream imp-stream to v-pos .
     4651                   import stream imp-stream UNFORMATTED v-temp-str .
     4652                   run write-to-log( vss-workfile + chr(32)
     4653                                     + substitute( "Ошибка обработки пакета: некорректный ключ (&1) пакета N &2 !!!", tt_pck-sent.crc-pack, p-pck-num ) + chr(10)
     4654                                     + substitute(" Позиция в файле &1", seek(imp-stream) ) + chr(10)
     4655                                     + substitute("&1", v-temp-str ) + chr(10)
     4656                                     ).
     4657                   undo, return error.
     4658                 end.
     4659               end.
     4660               else do:
     4661                 find first buf-for-sent_pck-rcvd exclusive-lock
     4662                   where buf-for-sent_pck-rcvd.db-num   = p-db-src
     4663                     and buf-for-sent_pck-rcvd.pack-num = tt_pck-sent.pack-num
     4664                   no-error.
     4665                 if not available buf-for-sent_pck-rcvd then do:
     4666                   create buf-for-sent_pck-rcvd.
     4667                   buffer-copy tt_pck-sent to buf-for-sent_pck-rcvd
     4668                     assign
     4669                       buf-for-sent_pck-rcvd.db-num     = p-db-src
     4670                       buf-for-sent_pck-rcvd.rcvd-recs  = 0
     4671                   .
     4672                 end.
     4673               end.
     4674             end.
     4675           end.
     4676           when 'pck-rcvd':U then do :
     4677             create tt_pck-rcvd.
     4678             run nws-impl-without-check in this-procedure
     4679               ( input (buffer tt_pck-rcvd:handle)
     4680               ) no-error.
     4681             if error-status :error then do:
     4682               return error return-value .
     4683             end.
     4684             find first buf-for-rcvd_pck-sent no-lock
     4685               where buf-for-rcvd_pck-sent.db-num   = p-db-src
     4686                 and buf-for-rcvd_pck-sent.pack-num = tt_pck-rcvd.pack-num
     4687               no-error.
     4688             if available buf-for-rcvd_pck-sent then do:
     4689               assign
     4690                 v-del-cnt = 0
     4691               .
     4692               if mFrameView
     4693               then
     4694                  view frame del-route .
     4695               for each buf_route exclusive-lock
     4696                 where buf_route.db-num    = buf-for-rcvd_pck-sent.db-num
     4697                   and buf_route.last-pack = tt_pck-rcvd.pack-num
     4698               on error  undo, return error substitute("&1. error buf_route &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     4699               on endkey undo, return error substitute("&1. endkey buf_route")
     4700               on stop   undo, return error substitute("&1. stop buf_route")
     4701               :
     4702                 assign
     4703                   v-del-cnt = v-del-cnt + 1
     4704                 .
     4705                 if mFrameView
     4706                 then do with frame del-route
     4707                 :
     4708                   assign
     4709                     v-del-pck-num :screen-value   = string( buf_route.last-pack, v-del-pck-num :format)
     4710                     v-del-cnt :screen-value       = string( v-del-cnt, v-del-cnt :format)
     4711                   .
     4712                 end.
     4713                 delete buf_route.
     4714               end.
     4715               if mFrameView
     4716               then
     4717                  hide frame del-route .
     4718               transaction_block_pck-rcvd:
     4719               do transaction
     4720               on error  undo, return error substitute("&1. error transaction_block_pck-rcvd &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     4721               on endkey undo, return error substitute("&1. endkey transaction_block_pck-rcvd")
     4722               on stop   undo, return error substitute("&1. stop transaction_block_pck-rcvd")
     4723               :
     4724                 run cur-time in this-procedure
     4725                   ( output v-today
     4726                   , output v-time
     4727                   ) no-error .
     4728                 if error-status :error then do:
     4729                   run write-to-log( vss-workfile + chr(32)
     4730                                     + "Ошибка при определении текущей даты!"
     4731                                   ).
     4732                   undo, return error.
     4733                 end.
     4734                 find first buf-for-rcvd_pck-sent exclusive-lock
     4735                   where buf-for-rcvd_pck-sent.db-num   = p-db-src
     4736                     and buf-for-rcvd_pck-sent.pack-num = tt_pck-rcvd.pack-num
     4737                   .
     4738                 if buf-for-rcvd_pck-sent.BegImpDate = ? then do:
     4739                   assign
     4740                     buf-for-rcvd_pck-sent.BegImpDate    = tt_pck-rcvd.BegImpDate
     4741                     buf-for-rcvd_pck-sent.BegImpTimeInt = tt_pck-rcvd.BegImpTimeInt
     4742                     buf-for-rcvd_pck-sent.BegImpTime    = tt_pck-rcvd.BegImpTime
     4743                   .
     4744                 end.
     4745                 assign
     4746                   buf-for-rcvd_pck-sent.rcvd          = yes
     4747                   buf-for-rcvd_pck-sent.EndImpDate    = tt_pck-rcvd.EndImpDate
     4748                   buf-for-rcvd_pck-sent.EndImpTimeInt = tt_pck-rcvd.EndImpTimeInt
     4749                   buf-for-rcvd_pck-sent.EndImpTime    = tt_pck-rcvd.EndImpTime
     4750                   buf-for-rcvd_pck-sent.RcvdDate      = v-today
     4751                   buf-for-rcvd_pck-sent.RcvdTimeInt   = v-time
     4752                   buf-for-rcvd_pck-sent.RcvdTime      = string( v-time, "HH:MM:SS" )
     4753                 .
     4754               end.
     4755             end.
     4756             delete tt_pck-rcvd.
     4757           end.
     4758           when 'pck-rcvd-attr':U then do :
     4759             create tt_pck-rcvd-attr.
     4760             run nws-impl-without-check in this-procedure
     4761               ( input (buffer tt_pck-rcvd-attr:handle)
     4762               ) no-error.
     4763             if error-status :error then do:
     4764               return error return-value .
     4765             end.
     4766             transaction_block_pck-rcvd-attr:
     4767             do transaction
     4768             on error  undo, return error substitute("&1. error transaction_block_pck-rcvd-attr &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     4769             on endkey undo, return error substitute("&1. endkey transaction_block_pck-rcvd-attr")
     4770             on stop   undo, return error substitute("&1. stop transaction_block_pck-rcvd-attr")
     4771             :
     4772               find first buf-for-rcvd_pck-sent exclusive-lock
     4773                 where buf-for-rcvd_pck-sent.db-num   = p-db-src
     4774                   and buf-for-rcvd_pck-sent.pack-num = tt_pck-rcvd-attr.pack-num
     4775                 no-error.
     4776               if available buf-for-rcvd_pck-sent then do:
     4777                 case tt_pck-rcvd-attr.attr-code :
     4778                   when 'beg-imp-date':U then do:
     4779                     assign
     4780                       buf-for-rcvd_pck-sent.BegImpDate    = date( tt_pck-rcvd-attr.attr-value )
     4781                     .
     4782                   end.
     4783                   when 'beg-imp-time':U then do:
     4784                     assign
     4785                       buf-for-rcvd_pck-sent.BegImpTimeInt = integer( tt_pck-rcvd-attr.attr-value )
     4786                       buf-for-rcvd_pck-sent.BegImpTime    = string( buf-for-rcvd_pck-sent.BegImpTimeInt, "HH:MM:SS" )
     4787                     .
     4788                   end.
     4789                 end case.
     4790               end.
     4791             end.
     4792             delete tt_pck-rcvd-attr.
     4793           end.
     4794           when '**END OF PACKET**':U then do:
     4795             assign
     4796               v-rec-cnt = v-rec-cnt - 1
     4797               OK = yes
     4798               .
     4799             leave beg-imp.
     4800           end.
     4801           when      "delete"
     4802             or when "create"
     4803             or when "command"
     4804             or when "get-seq"
     4805             or when "put-seq"
     4806             or when "dlcr"
     4807           then do :
     4808             transaction_block_command:
     4809             do transaction
     4810             on error  undo, return error substitute("&1. error transaction_block_command&3&2&3&4&3запись N &5&3привязанная запись &6", vss-workfile, return-value, chr(10), error-status :get-message(1), v-rec-cnt, v-sub-rec-cnt )
     4811             on endkey undo, return error substitute("&1. endkey transaction_block_command&2запись N &3&2привязанная запись &4", vss-workfile, chr(10), v-rec-cnt, v-sub-rec-cnt )
     4812             on stop   undo, return error substitute("&1. stop transaction_block_command&2запись N &3&2привязанная запись &4", vss-workfile, chr(10), v-rec-cnt, v-sub-rec-cnt )
     4813             :
     4814               run check-imp-rec in this-procedure
     4815                 ( input  "create":U
     4816                  ,input  p-db-src
     4817                  ,input  p-pck-num
     4818                  ,input  v-uniq-key-rt
     4819                  ,output v-present
     4820                 ) no-error .
     4821               if error-status :error then do:
     4822                 undo, return error substitute( "&1 запись N &2&3Позиция в файле &4", return-value, v-rec-cnt, chr(10), seek(imp-stream) ) .
     4823               end.
     4824               if v-present = true then do:
     4825                 assign
     4826                   v-qnty-skip  = v-sub-rec-num * 2
     4827                 .
     4828                 do v-ind = 1 to v-qnty-skip :
     4829                   import stream imp-stream v-temp-all .
     4830                 end.
     4831               end.
     4832               else do:
     4833                 run nws/imp-cmd.p
     4834                   ( input this-procedure
     4835                    ,input v-rec-full
     4836                    ,input v-sub-rec-num
     4837                    ,input p-db-src
     4838                   ).
     4839               end.
     4840             end.
     4841           end.
     4842           otherwise do :
     4843             transaction_block_otherwise:
     4844             do transaction
     4845             on error  undo, return error substitute("&1. error transaction_block_otherwise&3&2&3&4&3запись N &5&3привязанная запись &6", vss-workfile, return-value, chr(10), error-status :get-message(1), v-rec-cnt, v-sub-rec-cnt )
     4846             on endkey undo, return error substitute("&1. endkey transaction_block_otherwise&2запись N &3&2привязанная запись &4", vss-workfile, chr(10), v-rec-cnt, v-sub-rec-cnt )
     4847             on stop   undo, return error substitute("&1. stop transaction_block_otherwise&2запись N &3&2привязанная запись &4", vss-workfile, chr(10), v-rec-cnt, v-sub-rec-cnt )
     4848             :
     4849               run check-imp-rec in this-procedure
     4850                 ( input  "create":U
     4851                  ,input  p-db-src
     4852                  ,input  p-pck-num
     4853                  ,input  v-uniq-key-rt
     4854                  ,output v-present
     4855                 ) no-error .
     4856               if error-status :error then do:
     4857                 undo, return error substitute( "&1 запись N &2&3Позиция в файле &4", return-value, v-rec-cnt, chr(10), seek(imp-stream) ) .
     4858               end.
     4859               if v-present = true then do:
     4860                 assign
     4861                   v-qnty-skip  = v-sub-rec-num * 2 + 1
     4862                 .
     4863                 do v-ind = 1 to v-qnty-skip :
     4864                   import stream imp-stream v-temp-all .
     4865                 end.
     4866               end.
     4867               else do:
     4868   define variable vss-include-info38 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4869   assign
     4870     v-proc-name = substitute( "proc-load-&1", v-rec-name )
     4871     v-proc-avail = FALSE
     4872   .
     4873   if (valid-handle(g#load-rec) <> true) then do:
     4874     run nws/load-rec.p persistent no-error .
     4875     if error-status :error or (valid-handle(g#load-rec) <> true) then do:
     4876       message
     4877         "Error starting nws/load-rec.p" skip
     4878         error-status :get-message(1) skip
     4879         return-value skip
     4880         view-as alert-box error .
     4881       stop .
     4882     end.
     4883   end.
     4884   if lookup( v-proc-name, g#load-rec:internal-entries ) > 0 then do:
     4885     if v-proc-avail = TRUE then do:
     4886       return error substitute( "&1. Рассогласованы библиотеки приема новостей для таблицы &2"
     4887                                ,vss-workfile
     4888                                ,v-rec-name
     4889                              ).
     4890     end.
     4891     run value(v-proc-name) in g#load-rec
     4892         ( input this-procedure
     4893          ,input p-pck-num
     4894          ,input v-sub-rec-num
     4895         ).
     4896     assign
     4897       v-proc-avail = TRUE
     4898     .
     4899   end.
     4900   if v-proc-avail = FALSE then do:
     4901     run proc-load-standart in this-procedure
     4902         ( input v-rec-name
     4903          ,input v-uniq-gate-rec
     4904          ,input ?
     4905          ,input this-procedure
     4906          ,input v-sub-rec-num
     4907          ,output v-curr-rowid
     4908         ) .
     4909   end.
     4910               end.
     4911             end.
     4912           end.
     4913         END CASE.
     4914       end.
     4915       if t-pck-conf.total-recs <> v-rec-cnt then do:
     4916         run write-to-log( vss-workfile + chr(32)
     4917                           + "Не совпадает количество считанных записей и ожидаемое количество :" + chr(10)
     4918                           + "принято: " + string( v-rec-cnt ) + chr(10)
     4919                           + "должно быть:" + string( t-pck-conf.total-recs )
     4920                         ).
     4921         undo, return error.
     4922       end.
     4923       transaction_block_end:
     4924       do transaction
     4925       on error  undo, return error substitute("&1. error transaction_block_end &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     4926       on endkey undo, return error substitute("&1. endkey transaction_block_end")
     4927       on stop   undo, return error substitute("&1. stop transaction_block_end")
     4928       :
     4929         find first tt_pck-sent no-lock
     4930           where tt_pck-sent.db-num   = g#db-num
     4931             and tt_pck-sent.pack-num = p-pck-num
     4932           no-error
     4933         .
     4934         if not available tt_pck-sent then do:
     4935           run write-to-log( substitute( "&1. Отсутствует полная информация о пакете &2 для БД &3"
     4936                                         ,vss-workfile
     4937                                         ,p-pck-num
     4938                                         ,p-db-src
     4939                                       )
     4940                           ) .
     4941           undo, return error.
     4942         end.
     4943         run cur-time in this-procedure
     4944           ( output v-today
     4945           , output v-time
     4946           ) no-error .
     4947         if error-status :error then do:
     4948           run write-to-log( vss-workfile + chr(32)
     4949                             + "Ошибка при определении текущей даты!"
     4950                           ).
     4951           undo, return error.
     4952         end.
     4953         find first buf_pck-rcvd exclusive-lock
     4954           where buf_pck-rcvd.db-num   = p-db-src
     4955             and buf_pck-rcvd.pack-num = p-pck-num
     4956           no-error.
     4957         if not available buf_pck-rcvd then do:
     4958           create buf_pck-rcvd.
     4959           buffer-copy tt_pck-sent to buf_pck-rcvd
     4960             assign
     4961               buf_pck-rcvd.db-num     = p-db-src
     4962           .
     4963           run pck-attr-exist
     4964             ( input "pck-rcvd":U
     4965             , input p-db-src
     4966             , input p-pck-num
     4967             , input 'beg-imp-date':U
     4968             , output v-pck-attr-exist
     4969             ) no-error.
     4970           if error-status :error then do:
     4971             run write-to-log( substitute( "&1. Ошибка при определении наличия атрибута начала разбора пакета &2 из БД &3"
     4972                                           ,vss-workfile
     4973                                           ,p-pck-num
     4974                                           ,p-db-src
     4975                                         )
     4976                             ) .
     4977           end.
     4978           if v-pck-attr-exist = true then do:
     4979             run pck-attr-value in this-procedure
     4980               ( input "pck-rcvd":U
     4981               , input p-db-src
     4982               , input p-pck-num
     4983               , input 'beg-imp-date':U
     4984               , output v-beg-date
     4985               , output v-type
     4986               ) no-error.
     4987             if error-status :error then do:
     4988               run write-to-log( substitute( "&1. Ошибка получения атрибута даты начала разбора пакета &2 из БД &3"
     4989                                             ,vss-workfile
     4990                                             ,p-pck-num
     4991                                             ,p-db-src
     4992                                           )
     4993                               ) .
     4994               undo, return error.
     4995             end.
     4996             run pck-attr-delete in this-procedure
     4997               ( input "pck-rcvd":U
     4998               , input p-db-src
     4999               , input p-pck-num
     5000               , input 'beg-imp-date':U
     5001               , output v-deleted
     5002               ) no-error.
     5003             if error-status :error then do:
     5004               run write-to-log( substitute( "&1. Ошибка при удалении атрибута даты начала разбора пакета &2 из БД &3"
     5005                                             ,vss-workfile
     5006                                             ,p-pck-num
     5007                                             ,p-db-src
     5008                                           )
     5009                               ) .
     5010               undo, return error.
     5011             end.
     5012             run pck-attr-value in this-procedure
     5013               ( input "pck-rcvd":U
     5014               , input p-db-src
     5015               , input p-pck-num
     5016               , input 'beg-imp-time':U
     5017               , output v-beg-time
     5018               , output v-type
     5019               ) no-error.
     5020             if error-status :error then do:
     5021               run write-to-log( substitute( "&1. Ошибка получения атрибута времени начала разбора пакета &2 из БД &3"
     5022                                             ,vss-workfile
     5023                                             ,p-pck-num
     5024                                             ,p-db-src
     5025                                           )
     5026                               ) .
     5027               undo, return error.
     5028             end.
     5029             run pck-attr-delete in this-procedure
     5030               ( input "pck-rcvd":U
     5031               , input p-db-src
     5032               , input p-pck-num
     5033               , input 'beg-imp-time':U
     5034               , output v-deleted
     5035               ) no-error.
     5036             if error-status :error then do:
     5037               run write-to-log( substitute( "&1. Ошибка при удалении атрибута времени начала разбора пакета &2 из БД &3"
     5038                                             ,vss-workfile
     5039                                             ,p-pck-num
     5040                                             ,p-db-src
     5041                                           )
     5042                               ) .
     5043               undo, return error.
     5044             end.
     5045             assign
     5046               buf_pck-rcvd.BegImpDate    = date( v-beg-date )
     5047               buf_pck-rcvd.BegImpTimeInt = integer( v-beg-time )
     5048               buf_pck-rcvd.BegImpTime    = string( buf_pck-rcvd.BegImpTimeInt, "HH:MM:SS" )
     5049             .
     5050           end.
     5051         end.
     5052         assign
     5053           buf_pck-rcvd.rcvd-recs     = v-rec-cnt
     5054           buf_pck-rcvd.EndImpDate    = v-today
     5055           buf_pck-rcvd.EndImpTimeInt = v-time
     5056           buf_pck-rcvd.EndImpTime    = string( v-time, "HH:MM:SS" )
     5057         .
     5058         for each buf_pck-rcvd exclusive-lock
     5059           where buf_pck-rcvd.db-num = p-db-src
     5060             and buf_pck-rcvd.rcvd   = no
     5061         on error  undo, return error substitute("&1. error buf_pck-rcvd &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     5062         on endkey undo, return error substitute("&1. endkey buf_pck-rcvd")
     5063         on stop   undo, return error substitute("&1. stop buf_pck-rcvd")
     5064         :
     5065           find first tt_pck-sent no-lock
     5066             where tt_pck-sent.db-num   = g#db-num
     5067               and tt_pck-sent.pack-num = buf_pck-rcvd.pack-num
     5068             no-error .
     5069           if not available tt_pck-sent then do:
     5070             assign
     5071               buf_pck-rcvd.rcvd = yes
     5072             .
     5073           end.
     5074         end.
     5075         run check-imp-rec in this-procedure
     5076           ( input  "delete":U
     5077           ,input  p-db-src
     5078           ,input  p-pck-num
     5079           ,input  ?
     5080           ,output v-present
     5081           ) no-error .
     5082         if error-status :error then do:
     5083           run write-to-log( substitute( "&1. Ошибка при удалении уникальных ключей строк пакета. &2", vss-workfile, return-value ) ).
     5084           undo, return error.
     5085         end.
     5086         run db-attr-write in this-procedure
     5087           ( input p-db-src
     5088           ,input 'need-gen-new-pack':U
     5089           ,input "yes":U
     5090           ) no-error.
     5091         if error-status :error then do:
     5092           run write-to-log( substitute( "&1. Ошибка записи атрибута формирования нового пакета для БД &2"
     5093                                         ,vss-workfile
     5094                                         ,p-db-src
     5095                                       )
     5096                           ) .
     5097           undo, return error.
     5098         end.
     5099       end.
     5100       for each tt_pck-sent :
     5101         delete tt_pck-sent.
     5102       end.
     5103       delete t-pck-conf.
     5104       if not OK then do:
     5105         run write-to-log ( "Пакет принят не полностью!.." + chr(10)
     5106                           + "Вероятно была ошибка ( передачи по модему," + chr(10)
     5107                           + "копирование с дискеты, ... )" + chr(10)
     5108                           + "Повторите прием пакета по модему, " + chr(10)
     5109                           + "замените дискету; либо обратитесь" + chr(10)
     5110                           + "к администратору системы."
     5111                         ).
     5112         pck-name-bad = substr( p-file-pck-name, 1, r-index( p-file-pck-name, ".txt" )) + "bad".
     5113         os-delete value( pck-name-bad ).
     5114         if os-error <> 0 then do:
     5115           run adm/os-err.p ( output err-mess ).
     5116           run write-to-log( "Удаление файла: " + pck-name-bad + chr(10) + err-mess ).
     5117         end.
     5118         os-rename value( p-file-pck-name ) value( pck-name-bad ).
     5119         if os-error <> 0 then do:
     5120           run adm/os-err.p ( output err-mess ).
     5121           run write-to-log( "Переименование файла: " + p-file-pck-name
     5122                             + "в файл: " + pck-name-bad + chr(10)
     5123                             + err-mess ).
     5124         end.
     5125         undo, return error.
     5126       end.
     5127       if mFrameView
     5128       then
     5129          hide frame imp-pck.
     5130     end.
     5131   end procedure.
     5132   procedure nws-imps :
     5133     define input-output parameter p-counter  as integer   no-undo .
     5134     define output       parameter p-rec-full as character no-undo .
     5135     do
     5136     on error  undo, return error substitute( "&1 (nws-imps). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     5137     on stop   undo, return error substitute( "&1 (nws-imps). stop", vss-workfile )
     5138     on endkey undo, return error substitute( "&1 (nws-imps). endkey", vss-workfile )
     5139     :
     5140       define variable v-imps-rec-name   as character no-undo .
     5141       define variable v-rec-num         as integer   no-undo.
     5142       define variable v-skip-rec        as logical   no-undo .
     5143       assign
     5144         v-skip-rec = false
     5145       .
     5146       block_imp-head-rec:
     5147       repeat
     5148       on error  undo, return error substitute("&1. error block_imp-head-rec. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     5149       on endkey undo, return error substitute("&1. endkey block_imp-head-rec")
     5150       on stop   undo, return error substitute("&1. stop block_imp-head-rec")
     5151       :
     5152         if v-skip-rec = false then do:
     5153           if p-counter = 0 then do:
     5154             assign
     5155               v-rec-cnt = v-rec-cnt + 1
     5156             .
     5157           end.
     5158         end.
     5159         else do:
     5160           assign
     5161             v-skip-rec = false
     5162           .
     5163         end.
     5164         import stream imp-stream p-rec-full .
     5165         assign
     5166           v-imps-rec-name = trim( entry( 1, p-rec-full, chr(1) ) )
     5167         .
     5168         if v-imps-rec-name begins "pck-null-rec":U then do:
     5169           if p-counter > 0 then do:
     5170             assign
     5171               p-counter = p-counter + 1
     5172             .
     5173           end.
     5174         end.
     5175         else do:
     5176           if v-imps-rec-name begins "pck-pause":U then do:
     5177             assign
     5178               v-skip-rec = true
     5179             .
     5180             message
     5181               "Просили паузу? Получите..."  skip
     5182               substitute( "&1", p-rec-full ) skip
     5183               "После нажатия OK все продолжится." skip
     5184               view-as alert-box.
     5185           end.
     5186           else do:
     5187             if v-imps-rec-name begins "pck-log-write":U then do:
     5188               assign
     5189                 v-skip-rec = true
     5190               .
     5191               run write-to-log( substitute( ">>> &1", p-rec-full ) ).
     5192             end.
     5193             else do:
     5194               leave block_imp-head-rec .
     5195             end.
     5196           end.
     5197         end.
     5198       end.
     5199       if v-imps-rec-name <> '**END OF PACKET**':U then do:
     5200         if p-counter = 0 then do:
     5201           assign
     5202             v-rec-num  = integer( entry( num-entries( p-rec-full, chr(1) ), p-rec-full, chr(1) ) )
     5203           .
     5204           if v-rec-cnt <> v-rec-num then do:
     5205             undo, return error substitute( "&1. Ошибка обработки пакета: читается запись N &2, а должна быть N &3. Позиция в файле &4"
     5206                                            ,vss-workfile
     5207                                            ,v-rec-num
     5208                                            ,v-rec-cnt
     5209                                            ,seek(imp-stream)
     5210                                          ).
     5211           end.
     5212         end.
     5213         assign
     5214           v-sub-rec-cnt = integer( entry( num-entries( p-rec-full, chr(1) ) - 1, p-rec-full, chr(1) ) )
     5215         .
     5216         if p-counter <> v-sub-rec-cnt then do:
     5217           undo, return error substitute( "Ошибка пакета. Запись &1&2Принимается привязанная запись N &3, а должна быть N &4. Позиция в файле &5"
     5218                                           ,v-rec-cnt
     5219                                           ,chr(10)
     5220                                           ,v-sub-rec-cnt
     5221                                           ,p-counter
     5222                                           ,seek(imp-stream)
     5223                                         ) .
     5224         end.
     5225         if mFrameView
     5226         then
     5227         do with frame imp-pck
     5228         :
     5229           assign
     5230             p-db-src :screen-value        = string( p-db-src, p-db-src :format)
     5231             p-pck-num :screen-value       = string( p-pck-num, p-pck-num :format)
     5232             p-file-pck-name :screen-value = string( p-file-pck-name, p-file-pck-name :format)
     5233             v-rec-cnt :screen-value       = string( v-rec-cnt, v-rec-cnt :format)
     5234             v-sub-rec-cnt :screen-value   = string( v-sub-rec-cnt, v-sub-rec-cnt :format)
     5235           .
     5236         end.
     5237       end.
     5238     end.
     5239     return .
     5240   end procedure.
     5241   procedure nws-impl :
     5242     define input  parameter p-tbl-name   as character no-undo .
     5243     define input  parameter p-buf-handle as handle    no-undo .
     5244     do
     5245     on error  undo, return error substitute( "&1 (nws-impl). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     5246     on stop   undo, return error substitute( "&1 (nws-impl). stop", vss-workfile )
     5247     on endkey undo, return error substitute( "&1 (nws-impl). endkey", vss-workfile )
     5248     :
     5249       define variable v-fh-artic     as handle    no-undo .
     5250       define variable v-fh-prod-type as handle    no-undo .
     5251       define variable v-fh-prod-code as handle    no-undo .
     5252       define variable v-fh-gds-code  as handle    no-undo .
     5253       define variable v-fh-b-code    as handle    no-undo .
     5254       define variable v-gds-code     as integer   no-undo .
     5255       define variable v-b-code       as integer   no-undo .
     5256       define variable v-old-b-code   as integer no-undo .
     5257       run nws-impl-without-check in this-procedure
     5258         ( input p-buf-handle
     5259         ) no-error .
     5260       if error-status :error then do:
     5261         return error return-value .
     5262       end.
     5263       assign
     5264         v-fh-artic    = p-buf-handle:buffer-field( 'artic':U )
     5265         v-fh-gds-code = p-buf-handle:buffer-field( 'gds-code':U )
     5266         v-fh-b-code   = p-buf-handle:buffer-field( 'b-code':U )
     5267         no-error
     5268       .
     5269       if v-fh-artic <> ?
     5270         and lookup( p-tbl-name, 'goods,c-goods':U) = 0
     5271       then do:
     5272         assign
     5273           v-fh-prod-type = p-buf-handle:buffer-field( 'prod-type':U )
     5274           v-fh-prod-code = p-buf-handle:buffer-field( 'prod-code':U )
     5275           no-error
     5276         .
     5277         if v-fh-prod-type = ? then do:
     5278           return error substitute( "(nws-impl) &1&2Поле &3 не найдено в таблице &4, а поле artic есть!"
     5279                                     ,vss-workfile
     5280                                     ,chr(10)
     5281                                     ,'prod-type':U
     5282                                     ,p-buf-handle:name
     5283                                   ).
     5284         end.
     5285         if v-fh-prod-code = ? then do:
     5286           return error substitute( "(nws-impl) &1&2Поле &3 не найдено в таблице &4, а поле artic есть!"
     5287                                     ,vss-workfile
     5288                                     ,chr(10)
     5289                                     ,'prod-code':U
     5290                                     ,p-buf-handle:name
     5291                                   ).
     5292         end.
     5293         run check-avail-artic in this-procedure
     5294           ( input v-fh-artic:buffer-value
     5295            ,input v-fh-prod-type:buffer-value
     5296            ,input integer( v-fh-prod-code:buffer-value )
     5297           ) no-error.
     5298         if error-status :error then do:
     5299           return error return-value .
     5300         end.
     5301       end.
     5302       if v-fh-gds-code <> ?
     5303       then do:
     5304         assign
     5305           v-gds-code = integer( v-fh-gds-code:buffer-value )
     5306         .
     5307         run check-avail-gds-code in this-procedure
     5308           ( input-output v-gds-code
     5309           ) no-error.
     5310         if error-status :error then do:
     5311           return error return-value .
     5312         end.
     5313         assign
     5314           v-fh-gds-code:buffer-value = v-gds-code
     5315         .
     5316       end.
     5317       if v-fh-b-code <> ?
     5318         and lookup( p-tbl-name, 'bar-code,c-bar-code,c-gds-hist,c-prod-bc,c-chk-gds,chk-gds,c-sert':U) = 0
     5319       then do:
     5320         assign
     5321           v-old-b-code = integer( v-fh-b-code:buffer-value )
     5322           v-b-code = integer( v-fh-b-code:buffer-value )
     5323         .
     5324         define variable v-ok-b-code as logical no-undo .
     5325         v-ok-b-code = no.
     5326         run check-avail-b-code in this-procedure
     5327           ( input-output v-b-code
     5328           ) no-error.
     5329         if error-status :error then do:
     5330           case p-tbl-name:
     5331             when 'chk-gds':U then do:
     5332             if v-old-b-code = 0
     5333             and p-buf-handle:buffer-field("out-code"):buffer-value <> ? then do:
     5334                 v-ok-b-code = yes.
     5335             end.
     5336             end.
     5337             when 'doc-prts':U
     5338             or when 'c-doc-prts':U
     5339             then do:
     5340               if v-fh-b-code:buffer-value  < 0
     5341               then do:
     5342                 v-ok-b-code = yes.
     5343               end.
     5344             end.
     5345           end case.
     5346           if v-ok-b-code = no then do:
     5347             return error return-value .
     5348           end.
     5349         end.
     5350         assign
     5351           v-fh-b-code:buffer-value = v-b-code
     5352         .
     5353       end.
     5354     end.
     5355     return .
     5356   end procedure.
     5357   procedure nws-impl-without-check :
     5358     define input  parameter p-buf-handle as handle    no-undo .
     5359     do
     5360     on error  undo, return error substitute( "&1 (nws-impl-without-check). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     5361     on stop   undo, return error substitute( "&1 (nws-impl-without-check). stop", vss-workfile )
     5362     on endkey undo, return error substitute( "&1 (nws-impl-without-check). endkey", vss-workfile )
     5363     :
     5364       define variable v-imp-str    as character extent 1000 no-undo .
     5365       define variable v-num-fields as integer   no-undo .
     5366       define variable v-ind        as integer   no-undo .
     5367       define variable v-fld-name   as character no-undo .
     5368       define variable v-fld-value  as character no-undo .
     5369       define variable v-fh         as handle    no-undo .
     5370       if not p-buf-handle:available then do:
     5371         return error substitute( "(nws-impl-without-check) &1&2Buffer таблицы &3 еще не создан!"
     5372                                   ,vss-workfile
     5373                                   ,chr(10)
     5374                                   ,p-buf-handle:name
     5375                                 ).
     5376       end.
     5377       import stream imp-stream v-imp-str.
     5378       if v-imp-str[1] <> "<num-fields>" then do:
     5379         return error substitute( "(nws-impl-without-check) &1&2Неверный формат строки для импорта записи&2Строка должна начинаться с <num-fields> а начинается с &3!"
     5380                                   ,vss-workfile
     5381                                   ,chr(10)
     5382                                   ,v-imp-str[1]
     5383                                 ).
     5384       end.
     5385       assign
     5386         v-fld-name   = "":U
     5387         v-fld-value  = "":U
     5388         v-num-fields = integer( v-imp-str[2] )
     5389       .
     5390       block_read:
     5391       do v-ind = 3 to v-num-fields * 2 + 2 by 2
     5392       on error undo, return error
     5393       :
     5394         assign
     5395           v-fld-name  = v-imp-str[v-ind]
     5396         .
     5397         if v-fld-name <> "":U then do:
     5398           assign
     5399             v-fld-name  = substring( v-fld-name, 2, length(v-fld-name) - 2)
     5400             v-fld-value = v-imp-str[v-ind + 1]
     5401           .
     5402           assign
     5403             v-fh = p-buf-handle:buffer-field( v-fld-name ) no-error
     5404           .
     5405           if (error-status :error
     5406             or v-fh = ?)
     5407             and p-buf-handle:name <> "locb-marking"
     5408           then do:
     5409             return error substitute( "(nws-impl-without-check) &1&2Поле &3 не найдено в таблице &4&2&5"
     5410                                       ,vss-workfile
     5411                                       ,chr(10)
     5412                                       ,v-fld-name
     5413                                       ,p-buf-handle:name
     5414                                       ,error-status :get-message ( 1 )
     5415                                     ).
     5416           end.
     5417           if v-fh <> ? then do:
     5418             v-fh:buffer-value = v-fld-value.
     5419           end.
     5420         end.
     5421         else do:
     5422           leave block_read.
     5423         end.
     5424       end.
     5425     end.
     5426     return .
     5427   end procedure.
     5428   procedure check-imp-rec :
     5429     define input  parameter p-action   as character no-undo .
     5430     define input  parameter p-db-num   as integer   no-undo .
     5431     define input  parameter p-pack-num as integer   no-undo .
     5432     define input  parameter p-uniq-key as character no-undo .
     5433     define output parameter p-present  as logical   no-undo .
     5434     do
     5435     on error  undo, return error substitute( "&1 (check-imp-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     5436     on stop   undo, return error substitute( "&1 (check-imp-rec). stop", vss-workfile )
     5437     on endkey undo, return error substitute( "&1 (check-imp-rec). endkey", vss-workfile )
     5438     :
     5439       define buffer buf_pck-keys for ub.pck-keys .
     5440       case p-action :
     5441         when "create":U then do:
     5442           if not transaction then do:
     5443             message
     5444               vss-workfile vss-revision vss-description skip
     5445               substitute( "Вызов процедуры check-imp-rec( create ) возможен только в одной транзакции с приемом записи!" )
     5446               view-as alert-box error
     5447             .
     5448             return error .
     5449           end.
     5450           find first buf_pck-keys
     5451             where buf_pck-keys.db-num   = p-db-num
     5452               and buf_pck-keys.pack-num = p-pack-num
     5453               and buf_pck-keys.uniq-key = p-uniq-key
     5454             no-error .
     5455           if available buf_pck-keys then do:
     5456             assign
     5457               p-present = true
     5458             .
     5459           end.
     5460           else do:
     5461             do transaction
     5462             on error undo, return error
     5463             :
     5464               create buf_pck-keys .
     5465               assign
     5466                 buf_pck-keys.db-num   = p-db-num
     5467                 buf_pck-keys.pack-num = p-pack-num
     5468                 buf_pck-keys.uniq-key = p-uniq-key
     5469                 p-present = false
     5470               .
     5471             end.
     5472           end.
     5473         end.
     5474         when "delete":U then do:
     5475           for each buf_pck-keys exclusive-lock
     5476             where buf_pck-keys.db-num   = p-db-num
     5477               and buf_pck-keys.pack-num = p-pack-num
     5478           on error  undo, return error substitute( "&1 (check-imp-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     5479           on stop   undo, return error substitute( "&1 (check-imp-rec). stop", vss-workfile )
     5480           on endkey undo, return error substitute( "&1 (check-imp-rec). endkey", vss-workfile )
     5481           :
     5482             delete buf_pck-keys.
     5483           end.
     5484         end.
     5485       end case.
     5486     end.
     5487     return.
     5488   end procedure.
     5489   procedure proc-load-standart :
     5490     define input parameter p-tbl-name   as character no-undo.
     5491     define input parameter p-uniq-gate-rec as character no-undo .
     5492     define input parameter p-bh-handle  as handle    no-undo.
     5493     define input parameter p-imp-handle as handle    no-undo.
     5494     define input parameter l-counter    as integer   no-undo.
     5495     define output parameter p-curr-rowid as rowid    no-undo.
     5496     do
     5497     on error  undo, return error substitute( "&1 (proc-load-standart). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     5498     on stop   undo, return error substitute( "&1 (proc-load-standart). stop", vss-workfile )
     5499     on endkey undo, return error substitute( "&1 (proc-load-standart). endkey", vss-workfile )
     5500     :
     5501       define variable v-full-tbl-name as character no-undo .
     5502       define variable bh_tbl-name     as handle    no-undo .
     5503       define variable fh_tbl-name     as handle    no-undo .
     5504       define variable tt-name         as character no-undo .
     5505       define variable tth             as handle    no-undo .
     5506       define variable bh_tt           as handle    no-undo .
     5507       define variable fh_tt           as handle    no-undo .
     5508       define variable v-ok            as logical   no-undo .
     5509       define variable v-rowid         as rowid     no-undo .
     5510       define variable v-tbl-name      as character no-undo .
     5511       define variable compare-log     as logical   no-undo.
     5512       define variable v_dataseth      as handle    no-undo.
     5513       define variable v-xmlh          as handle    no-undo.
     5514       define variable v-table-ready   as logical   no-undo.
     5515       define buffer buf_temp-xml-tables for temp-xml-tables.
     5516       v-xmlh = buffer buf_temp-xml-tables:handle.
     5517       if l-counter <> 0 then do:
     5518         return error substitute( "&1 (proc-load-standart). Ошибка обработки записи &2&3Есть привязанные записи, а обработка идет для одной", vss-workfile, p-tbl-name, chr(10) ).
     5519       end.
     5520       if p-bh-handle <> ?
     5521       and (not valid-handle(p-bh-handle)
     5522            or p-bh-handle:type <> "buffer") then do:
     5523         return error substitute( "&1 (proc-load-standart). Ошибка обработки записи &2&3Передан невалидный handle или hanlde не типа BUFFER", vss-workfile, p-tbl-name, chr(10) ).
     5524       end.
     5525       assign
     5526         v-full-tbl-name = substitute( "ub.&1":U, p-tbl-name )
     5527       .
     5528       create temp-table tth.
     5529       assign
     5530         tt-name = "wt-" + p-tbl-name
     5531         tth:undo = no
     5532         v-ok = false
     5533       .
     5534       if p-bh-handle = ? then do:
     5535         if p-uniq-gate-rec = '':U then do:
     5536           assign
     5537             v-ok = tth:create-like( v-full-tbl-name ) no-error
     5538           .
     5539         end.
     5540         else do:
     5541           define variable v-longchar as longchar no-undo .
     5542           v-longchar = ?.
     5543           run get-gate-by-rec in this-procedure ( input p-uniq-gate-rec
     5544                                                   ,output v_dataseth
     5545                                                   ,input-output v-xmlh
     5546                                                   ,input-output v-longchar
     5547                                                   ) no-error.
     5548           if error-status:error then do:
     5549              return error substitute( "&1 (proc-load-standart). Ошибка при создании временной таблицы &2 (3)", vss-workfile, tt-name ) .
     5550           end.
     5551           find first buf_temp-xml-tables where
     5552                     buf_temp-xml-tables.uniq-gate-rec = p-uniq-gate-rec
     5553                 and buf_temp-xml-tables.tbl-name = p-tbl-name no-error.
     5554           if not available buf_temp-xml-tables then do:
     5555              if valid-handle(v_dataseth) then do:                    run gate-clear in this-procedure ( input v_dataseth                                                     , input buffer buf_temp-xml-tables:handle).                   end.
     5556              return error substitute( "&1 (proc-load-standart). Ошибка при создании временной таблицы &2 (4)", vss-workfile, tt-name ) .
     5557           end.
     5558           bh_tt = buf_temp-xml-tables.tbl-handle_.
     5559           v-ok = yes.
     5560           v-table-ready = yes.
     5561         end.
     5562       end.
     5563       else do:
     5564         assign
     5565           v-ok = tth:create-like( p-bh-handle ) no-error
     5566         .
     5567       end.
     5568       if v-ok <> true then do:
     5569         return error substitute( "&1 (proc-load-standart). Ошибка при создании временной таблицы &2 (1)", vss-workfile, tt-name ) .
     5570       end.
     5571       if not v-table-ready then do:
     5572         assign
     5573           v-ok = false
     5574         .
     5575         assign
     5576           v-ok = tth:temp-table-prepare( tt-name ) no-error
     5577         .
     5578         if v-ok <> true then do:
     5579         if valid-handle(v_dataseth) then do:                    run gate-clear in this-procedure ( input v_dataseth                                                     , input buffer buf_temp-xml-tables:handle).                   end.
     5580           return error substitute( "&1 (proc-load-standart). Ошибка при создании временной таблицы &2 (2)", vss-workfile, tt-name ) .
     5581         end.
     5582         assign
     5583           bh_tt = tth:default-buffer-handle
     5584         .
     5585       end.
     5586       assign
     5587         v-ok = false
     5588       .
     5589       assign
     5590         v-ok = bh_tt:buffer-create no-error
     5591       .
     5592       if v-ok <> true then do:
     5593         if valid-handle(v_dataseth) then do:                    run gate-clear in this-procedure ( input v_dataseth                                                     , input buffer buf_temp-xml-tables:handle).                   end.
     5594         return error substitute( "&1 (proc-load-standart). Ошибка при создании буфера временной таблицы.", vss-workfile ).
     5595       end.
     5596       run nws-impl in p-imp-handle
     5597         ( input p-tbl-name
     5598          ,input bh_tt
     5599         ) no-error.
     5600       if error-status :error then do:
     5601         if valid-handle(v_dataseth) then do:                    run gate-clear in this-procedure ( input v_dataseth                                                     , input buffer buf_temp-xml-tables:handle).                   end.
     5602         return error return-value .
     5603       end.
     5604       if p-bh-handle = ? then do:
     5605         run gen-row-keyr in this-procedure
     5606           ( input p-tbl-name
     5607            ,input bh_tt
     5608            ,input "ub":U
     5609            ,input ?
     5610            ,input exclusive-lock
     5611            ,output v-rowid
     5612            ,output v-tbl-name
     5613           ) no-error .
     5614         if error-status :error then do:
     5615           if valid-handle(v_dataseth) then do:                    run gate-clear in this-procedure ( input v_dataseth                                                     , input buffer buf_temp-xml-tables:handle).                   end.
     5616           return error substitute( "&1 (proc-load-standart). Ошибка при определении в БД rowid для записи &2.&3&4", vss-workfile, p-tbl-name, chr(10), return-value ).
     5617         end.
     5618         create buffer bh_tbl-name for table v-full-tbl-name .
     5619       end.
     5620       else do:
     5621         run gen-row-keyr in this-procedure
     5622           ( input p-tbl-name
     5623            ,input bh_tt
     5624            ,input ?
     5625            ,input p-bh-handle
     5626            ,input ?
     5627            ,output v-rowid
     5628            ,output v-tbl-name
     5629           ) no-error .
     5630         if error-status :error then do:
     5631           if valid-handle(v_dataseth) then do:                    run gate-clear in this-procedure ( input v_dataseth                                                     , input buffer buf_temp-xml-tables:handle).                   end.
     5632           return error substitute( "&1 (proc-load-standart). Ошибка при определении в Temp-table rowid записи для ключа &2.&3&4", vss-workfile, p-tbl-name, chr(10), return-value ).
     5633         end.
     5634         create buffer bh_tbl-name for table p-bh-handle:table-handle .
     5635       end.
     5636       bh_tbl-name:find-by-rowid( v-rowid, exclusive-lock ) no-error .
     5637       if not bh_tbl-name:available then do:
     5638         assign
     5639           v-ok = false
     5640         .
     5641         assign
     5642           v-ok = bh_tbl-name:buffer-create no-error
     5643         .
     5644         if v-ok <> true then do:
     5645           if valid-handle(v_dataseth) then do:                    run gate-clear in this-procedure ( input v_dataseth                                                     , input buffer buf_temp-xml-tables:handle).                   end.
     5646           return error substitute( "&1 (proc-load-standart). Ошибка при создании буфера временной таблицы.", vss-workfile, p-tbl-name ).
     5647         end.
     5648         assign
     5649           compare-log = false
     5650         .
     5651       end.
     5652       else do:
     5653         assign
     5654           compare-log = bh_tbl-name:buffer-compare( bh_tt, 'case-sensitive':U )
     5655         .
     5656       end.
     5657       if compare-log = false then do:
     5658         assign
     5659           v-ok = false
     5660         .
     5661         assign
     5662           v-ok = bh_tbl-name:buffer-copy( bh_tt ) no-error
     5663         .
     5664         if v-ok <> true then do:
     5665           if valid-handle(v_dataseth) then do:                    run gate-clear in this-procedure ( input v_dataseth                                                     , input buffer buf_temp-xml-tables:handle).                   end.
     5666           return error substitute( "&1 (proc-load-standart). BUFFER-COPY не прошел для таблицы &2", vss-workfile, p-tbl-name ).
     5667         end.
     5668       end.
     5669       assign
     5670         v-ok = false
     5671         p-curr-rowid = bh_tbl-name:rowid
     5672       .
     5673       assign
     5674         v-ok = bh_tbl-name:buffer-release() no-error
     5675       .
     5676       if v-ok <> true then do:
     5677         if valid-handle(v_dataseth) then do:                    run gate-clear in this-procedure ( input v_dataseth                                                     , input buffer buf_temp-xml-tables:handle).                   end.
     5678         return error substitute( "&1 (proc-load-standart). buffer-release не прошел для таблицы &2", vss-workfile, p-tbl-name ).
     5679       end.
     5680       assign
     5681         v-ok = false
     5682       .
     5683       assign
     5684         v-ok = tth:clear() no-error
     5685       .
     5686       if v-ok <> true then do:
     5687         return error substitute( "&1 (proc-load-standart). Ошибка при очистке временной таблицы &2", vss-workfile, tt-name ) .
     5688       end.
     5689       delete object bh_tbl-name .
     5690       delete object tth .
     5691       if valid-handle(v_dataseth) then do:                    run gate-clear in this-procedure ( input v_dataseth                                                     , input buffer buf_temp-xml-tables:handle).                   end.
     5692       assign
     5693         fh_tbl-name  = ?
     5694         fh_tt        = ?
     5695         bh_tt        = ?
     5696         v_dataseth   = ?
     5697         v-xmlh       = ?
     5698       .
     5699     end.
     5700     return .
     5701   end procedure.
     5702   procedure skip-rec :
     5703     do
     5704     on error  undo, return error substitute( "&1 (skip-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     5705     on stop   undo, return error substitute( "&1 (skip-rec). stop", vss-workfile )
     5706     on endkey undo, return error substitute( "&1 (skip-rec). endkey", vss-workfile )
     5707     :
     5708       define variable v-skip-str    as character extent 1000 no-undo .
     5709       import stream imp-stream v-skip-str.
     5710     end.
     5711     return .
     5712   end procedure.
