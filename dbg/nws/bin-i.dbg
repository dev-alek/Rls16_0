        7   define input parameter p-mode as character no-undo .
        8   define input parameter p-file-num as integer no-undo .
        9   define input parameter p-file-name as character no-undo .
       10   define input parameter p-path-type as integer no-undo .
       11   define input parameter p-path as character no-undo .
       12   define input parameter p-md5-signature as character no-undo .
       13   define output parameter p-ok as logical no-undo .
