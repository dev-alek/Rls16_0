       15   define variable vss-author      as character no-undo init "$Author: ASMorozov $":U .
       16   define variable vss-date        as character no-undo init "$Date: Mon Aug 08 15:24:07 2016 +0300 $":U .
       17   define variable vss-workfile    as character no-undo init "$Workfile: bin-i.p $":U .
