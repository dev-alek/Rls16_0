       94   procedure binfile_clear :
       95     define input  parameter p-db-num      as integer   no-undo .
       96     define input  parameter p-from-db-num as integer   no-undo .
       97     define input  parameter p-file-num    as integer   no-undo .
       98     define buffer buf_temp-ext-file-line  for temp-ext-file-line .
       99     do
      100     on error undo, return error return-value
      101     :
      102       for each buf_temp-ext-file-line
      103         where buf_temp-ext-file-line.db-num   = p-db-num
      104           and buf_temp-ext-file-line.from-db-num = p-from-db-num
      105           and buf_temp-ext-file-line.file-num = p-file-num
