      149         v-input-full-pathname   = file-info :full-pathname
      150       .
      151       assign
      152         file-info :file-name    = v-temp-file-name
      153         v-temp-full-pathname    = file-info :full-pathname
      154       .
      155       assign
      156         v-command-line = substitute('&1 -e "&2" &3':U
      157                                         ,v-convert-full-pathname
      158                                         ,v-input-full-pathname
      159                                         ,v-temp-full-pathname
      160                                         )
      161       .
      162       os-command silent value(v-command-line) .
      163       input stream sinp from value(v-temp-full-pathname) .
      164       assign
      165         v-line-num = 0
      166       .
      167       repeat
      168       :
      169         assign
      170           v-read-line = '':U
      171         .
      172         import stream sinp unformatted v-read-line .
      173         if v-read-line <> '':U
      174         then do:
      175           assign
      176             v-line-num  = v-line-num + 1
      177           .
      178           create buf_temp-ext-file-line .
      179           assign
      180             buf_temp-ext-file-line.db-num       = p-db-num
      181             buf_temp-ext-file-line.from-db-num  = p-from-db-num
      182             buf_temp-ext-file-line.file-num     = p-file-num
      183             buf_temp-ext-file-line.line-num     = v-line-num
      184             buf_temp-ext-file-line.sub-line-num = 0
      185             buf_temp-ext-file-line.line-text    = v-read-line
      186           .
      187         end.
      188       end.
      189       input stream sinp close .
      190       os-delete value(v-temp-full-pathname) .
      191     end.
      192   end procedure.
      193   procedure binfile_write :
      194     define input  parameter p-db-num        as integer   no-undo .
