      414   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      415   PROCEDURE verify-ini-entry:
      416   DEFINE INPUT  PARAMETER ini-key-name     as character no-undo.
      417   DEFINE INPUT  PARAMETER ini-section-name as character no-undo.
      418   DEFINE INPUT  PARAMETER error-msg-text   as character no-undo.
      419   DEFINE INPUT  PARAMETER silence          as logical no-undo.
      420   DEFINE OUTPUT PARAMETER ini-entry-value  as character no-undo INIt ?.
      421   define variable v-mess as character no-undo .
      422   get-key-value section ini-section-name key ini-key-name value ini-entry-value.
      423   if ini-entry-value = ? and ini-key-name begins "spl"
      424   then
      425   get-key-value section ini-section-name key "splall" value ini-entry-value.
      426   if ini-entry-value = ? and ini-key-name begins "sav"
      427   then
      428   get-key-value section ini-section-name key "savall" value ini-entry-value.
      429   if ini-entry-value = ? then do:
      430     assign
      431     v-mess = substitute("Ошибка ini - файла:&1Секция &2&1Ключ &3&1&4"
      432                       , chr(10)
      433                       , ini-section-name
      434                       , ini-key-name
      435                       , error-msg-text).
      436       if not silence then do:
      437         message
      438         v-mess
      439         view-as alert-box ERROR  .
      440         return error.
      441       end.
      442       else do:
      443         return error v-mess.
      444       end.
      445   end.
      446   END PROCEDURE.
      447   PROCEDURE verify-file:
      448   DEFINE INPUT  PARAMETER filename       as character no-undo.
      449   DEFINE INPUT  PARAMETER error-msg-text as character no-undo.
      450   DEFINE INPUT  PARAMETER silence        as logical no-undo.
      451   DEFINE OUTPUT PARAMETER found          as logical no-undo.
      452   file-info:file-name = filename.
      453   found = NOT (file-info:full-pathname = ?).
      454   if NOT found  then do:
      455     if not silence then do:
      456       message error-msg-text
      457       view-as alert-box ERROR.
      458       return error.
      459     end.
      460     else return error error-msg-text.
      461   end.
      462   END PROCEDURE.
      463   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      464   function prepare-path returns character ( input p-nonprepared-path as character ):
      465   define variable v-prepared-path as character no-undo .
      466   assign
      467   v-prepared-path = replace(p-nonprepared-path, chr(92), chr(47))
      468   v-prepared-path = right-trim(v-prepared-path, chr(47))
      469   .
      470   return v-prepared-path.
      471   END FUNCTION.
      472   function prepare-path2 returns character ( input p-nonprepared-path as character ):
      473   define variable v-prepared-path as character no-undo .
      474   assign
      475   v-prepared-path = replace(p-nonprepared-path, chr(47), chr(92))
      476   v-prepared-path = right-trim(v-prepared-path, chr(92))
      477   .
      478   return v-prepared-path.
      479   END FUNCTION.
      480   function quote-spaces returns character ( input p-full-path as character):
      481   define variable v-ii as integer no-undo .
      482   define variable v-result as character no-undo .
      483   do v-ii = 1 to num-entries(p-full-path, chr(92)):
      484     v-result = v-result + (if v-ii = 1 then '' else chr(92)) +
      485                (if index(entry(v-ii, p-full-path, chr(92)), chr(32)) > 0
      486                then  substitute("&1&2&1", chr(34), entry(v-ii, p-full-path, chr(92)))
      487                else entry(v-ii, p-full-path, chr(92))
      488                )
      489     .
      490   end.
      491   return v-result.
      492   end function.
      493   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      494   define  temp-table tt-ext-file-par no-undo like ub.ext-file-par.
      495   procedure ext-file-par-clear-temp :
      496     define buffer buf_tt-ext-file-par for tt-ext-file-par .
      497     do
      498     on error undo, return error return-value
      499     :
      500       for each buf_tt-ext-file-par
      501       on error undo, return error
      502       :
      503         delete buf_tt-ext-file-par .
      504       end.
      505     end.
      506   end procedure.
      507   procedure ext-file-par-write-temp :
      508     define input  parameter p-db-num      as integer no-undo .
      509     define input  parameter p-from-db-num      as integer no-undo .
      510     define input  parameter p-file-num      as integer no-undo .
      511     define input  parameter p-param-num      as integer no-undo .
      512     define input  parameter p-value-type as character no-undo .
      513     define input  parameter p-value-name as character no-undo .
      514     define input  parameter p-value-char as character no-undo .
      515     define input  parameter p-value-date as date      no-undo .
      516     define input  parameter p-value-integer as integer      no-undo .
      517     define input  parameter p-value-decimal as decimal      no-undo .
      518     define input  parameter p-value-logical as logical      no-undo .
      519     define buffer buf_tt-ext-file-par for tt-ext-file-par .
      520     do
      521     on error undo, return error return-value
      522     :
      523       find first buf_tt-ext-file-par
      524         where buf_tt-ext-file-par.db-num        = p-db-num
      525           and buf_tt-ext-file-par.file-num      = p-file-num
      526           and buf_tt-ext-file-par.from-db-num   = p-from-db-num
      527           and buf_tt-ext-file-par.param-type    = p-value-type
      528           and buf_tt-ext-file-par.param-name    = p-value-name
      529         no-error .
      530       if not available buf_tt-ext-file-par then do:
      531         create buf_tt-ext-file-par .
      532         assign
      533           buf_tt-ext-file-par.db-num         = p-db-num
      534           buf_tt-ext-file-par.from-db-num    = p-from-db-num
      535           buf_tt-ext-file-par.file-num       = p-file-num
      536           buf_tt-ext-file-par.param-num      = p-param-num
      537           buf_tt-ext-file-par.param-type     = p-value-type
      538           buf_tt-ext-file-par.user-db-num    = p-db-num
      539                 .
      540       end.
      541       CASE p-value-type:
      542         when 'C':U
      543         or when 'uniq-key-rec':U
      544         then do:
      545           assign
      546           buf_tt-ext-file-par.param-name = p-value-name
      547           buf_tt-ext-file-par.param-value = p-value-char
      548           .
      549         end.
      550         when 'T':U then do:
      551           assign
      552           buf_tt-ext-file-par.param-date-name = p-value-name
      553           buf_tt-ext-file-par.param-date-value = p-value-date
      554           .
      555         end.
      556         when 'I':U then do:
      557           assign
      558           buf_tt-ext-file-par.param-int-name = p-value-name
      559           buf_tt-ext-file-par.param-int-value = p-value-integer
      560           .
      561         end.
      562         when 'L':U then do:
      563           assign
      564           buf_tt-ext-file-par.param-log-name = p-value-name
      565           buf_tt-ext-file-par.param-log-value = p-value-logical
      566           .
      567         end.
      568         when 'D':U then do:
      569           assign
      570           buf_tt-ext-file-par.param-decimal-name = p-value-name
      571           buf_tt-ext-file-par.param-decimal-value = p-value-decimal
      572           .
      573         end.
      574       END CASE.
      575     end.
      576   end procedure.
      577   procedure ext-file-par-write-and-send :
      578     define input  parameter p-db-num      as integer no-undo .
      579     define input  parameter p-from-db-num      as integer no-undo .
      580     define input  parameter p-file-num      as integer no-undo .
      581     define input  parameter p-param-num      as integer no-undo .
      582     define input  parameter p-value-type as character no-undo .
      583     define input  parameter p-value-name as character no-undo .
      584     define input  parameter p-value-char as character no-undo .
      585     define input  parameter p-value-date as date      no-undo .
      586     define input  parameter p-value-integer as integer      no-undo .
      587     define input  parameter p-value-decimal as decimal      no-undo .
      588     define input  parameter p-value-logical as logical      no-undo .
      589     define input  parameter p-send        as logical no-undo .
      590     define input  parameter p-list-db-num as character no-undo .
      591     define buffer buf_ext-file-par for ub.ext-file-par .
      592     do
      593     on error undo, return error return-value
      594     :
      595       find first buf_ext-file-par
      596         where buf_ext-file-par.db-num         = p-db-num
      597           and buf_ext-file-par.from-db-num    = p-from-db-num
      598           and buf_ext-file-par.file-num       = p-file-num
      599           and buf_ext-file-par.param-num      = p-param-num
      600         no-error .
      601       if not available buf_ext-file-par then do:
      602         create buf_ext-file-par .
      603         assign
      604           buf_ext-file-par.db-num    = p-db-num
      605           buf_ext-file-par.from-db-num    = p-from-db-num
      606           buf_ext-file-par.file-num    = p-file-num
      607           buf_ext-file-par.param-num    = p-param-num
      608           buf_ext-file-par.param-type   = p-value-type
      609           buf_ext-file-par.user-db-num    = p-db-num
      610         .
      611       end.
      612       CASE p-value-type:
      613         when 'C':U
      614         or when ''
      615         or when 'uniq-key-rec':U
      616         then do:
      617           assign
      618           buf_ext-file-par.param-name = p-value-name
      619           buf_ext-file-par.param-value = p-value-char
      620           .
      621           if p-value-type = ''
      622           and p-param-num = 0 then do:
      623             buf_ext-file-par.param-log-value = p-value-logical.
      624           end.
      625         end.
      626         when 'T':U then do:
      627           assign
      628           buf_ext-file-par.param-date-name = p-value-name
      629           buf_ext-file-par.param-date-value = p-value-date
      630           .
      631         end.
      632         when 'I':U then do:
      633           assign
      634           buf_ext-file-par.param-int-name = p-value-name
      635           buf_ext-file-par.param-int-value = p-value-integer
      636           .
      637         end.
      638         when 'D':U then do:
      639           assign
      640           buf_ext-file-par.param-decimal-name = p-value-name
      641           buf_ext-file-par.param-decimal-value = p-value-decimal
      642           .
      643         end.
      644         when 'L':U then do:
      645           assign
      646           buf_ext-file-par.param-log-name = p-value-name
      647           buf_ext-file-par.param-log-value = p-value-logical
      648           .
      649         end.
      650       END CASE.
      651       if p-send then do:
      652         run nws/cr-route.p (
      653                         input 'send-tbl':U
      654                       , input 'ext-file-par':U
      655                       , input buffer buf_ext-file-par:handle
      656                       , input p-list-db-num) no-error.
      657       end.
      658     end.
      659   end procedure.
      660   define variable counter    as integer   no-undo .
      661   define variable rec-full   as character no-undo .
      662   define variable v-rec-name as character no-undo .
      663   define variable v-full-path-name as character no-undo .
      664   define variable log-file-name as character no-undo init "":U.
      665   define variable v-path as character no-undo .
      666   define variable v-md5-signature as character no-undo .
      667   DEFINE VARIABLE v-full-path               as character                no-undo .
      668   DEFINE VARIABLE v-file-name               as character                no-undo .
      669   DEFINE VARIABLE v-file-name-no-ext        as character                no-undo .
      670   DEFINE VARIABLE v-file-name-ext           as character                no-undo .
      671   define variable v-can-write               as logical no-undo .
      672   define variable v-dir-name                as character no-undo .
      673   define variable v-ini-section as character no-undo .
      674   define variable v-ini-key as character no-undo .
      675   define variable v-ini-path-dir as character no-undo .
      676   define variable v-file-num as integer no-undo .
      677   define variable v-temp-file-name as character no-undo .
      678   define variable v-run-name as character no-undo .
      679   define variable v-res-message as character no-undo .
      680   define variable v-err-num as integer no-undo .
      681   define variable v-err-mess as character no-undo .
      682   define buffer buf_temp-ext-file-line for temp-ext-file-line .
      683   define buffer buf_ext-file-line for ub.ext-file-line.
      684   define buffer buf_ext-file for ub.ext-file.
      685   define temp-table temp-ext-file no-undo like ub.ext-file.
      686   define buffer buf_temp-ext-file for temp-ext-file.
      687   define temp-table temp-ext-file-par no-undo like ub.ext-file-par.
      688   define buffer buf_ext-file-par for ub.ext-file-par .
      689   define buffer buf_temp-ext-file-par for temp-ext-file-par .
      690   main-block:
      691   do
      692   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      693   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      694   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      695   :
      696     run write-to-log in p-log-handle (
      697           input substitute("Получение бинарного файла &1: режим &2"
      698                            , p-file-name
      699                            , p-mode )).
      700     _counter:
      701     do counter = 1 to p-counter
      702     on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      703     on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      704     on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      705     :
      706       if counter modulo 10 = 0
      707       then do:
      708         run write-to-screen in p-log-handle (substitute("Получено записей &1", counter)) no-error.
      709       end.
      710       run nws-imps in p-imp-handle
      711         ( input-output counter
      712          ,output       rec-full
      713         ) no-error.
      714       if error-status :error then do:
      715         undo main-block, return error return-value .
      716       end.
      717       assign
      718         v-rec-name = entry( 1, rec-full, chr(1) )
      719       .
      720       CASE entry(1, v-rec-name, chr(4)) :
      721         when 'ext-file':U then do:
      722           create buf_temp-ext-file .
      723           run nws-impl in p-imp-handle
      724             ( input 'ext-file':U
      725              ,input (buffer buf_temp-ext-file:handle)
      726             ) no-error.
      727           if error-status :error then do:
      728             undo main-block, return error return-value .
      729           end.
      730           if v-err-num > 0 then do:
      731             delete buf_temp-ext-file.
      732             next _counter.
      733           end.
      734           if p-mode = 'save-install':U then do:
      735             if entry(2, buf_temp-ext-file.file-type, ".") <> "mf":U then do:
      736               v-err-num = 1.
      737               v-err-mess = substitute( "!!!Ошибки при приеме файла &1 (режим &2)&3" +
      738                                                   "неверная ссылка на манифест пакета обновления&3" +
      739                                                   "Файл обновления принят не будет"
      740                                                   , p-file-name
      741                                                   , p-mode
      742                                                   , chr(10)).
      743             end.
      744             if buf_temp-ext-file.file-type <> buf_temp-ext-file.file-name then do:
      745               find first buf_ext-file no-lock where
      746                       buf_Ext-file.db-num = buf_temp-ext-file.db-num
      747                   and buf_Ext-file.from-db-num = buf_temp-ext-file.from-db-num
      748                   and  buf_Ext-file.file-name = buf_temp-ext-file.file-type no-error.
      749               if not available buf_Ext-file then do:
      750                 v-err-num = 2.
      751                 v-err-mess = substitute( "!!!Ошибки при приеме файла &1 (режим &2)&3" +
      752                                                     "в БД отсутствует манифест пакета обновления &4&3" +
      753                                                     "Файл обновления принят не будет"
      754                                                     , p-file-name
      755                                                     , p-mode
      756                                                     , chr(10)
      757                                                     , buf_temp-ext-file.file-type
      758                                                     ).
      759               end.
      760             end.
      761           end.
      762           if buf_temp-Ext-file.file-num <> p-file-num
      763           and (p-mode = 'save-db':U
      764               or
      765               p-mode = 'save-install':U
      766               or
      767               p-mode = 'save-db-and-run':U
      768               )
      769           then do:
      770             v-err-num = 3.
      771             v-err-mess = substitute("!!!Ошибки при приеме файла &1 (режим &2)&3" +
      772                                                 "номер файла &4 в шапке файла не совпадает с номером файла в команде  - &5&3" +
      773                                                 "Бинарный файл принят/запущен не будет"
      774                                                       , p-file-name
      775                                                       , p-mode
      776                                                       , chr(10)
      777                                                       , buf_temp-Ext-file.file-num
      778                                                       , p-file-num
      779                                                     ).
      780           end.
      781           find first buf_ext-file where
      782                     buf_Ext-file.db-num = buf_temp-ext-file.db-num
      783                 and buf_Ext-file.from-db-num = buf_temp-ext-file.from-db-num
      784                 and buf_Ext-file.file-num = buf_temp-ext-file.file-num  no-error.
      785           if not available buf_Ext-file then do:
      786             create buf_ext-file.
      787           end.
      788           buffer-copy
      789           buf_temp-ext-file to
      790           buf_ext-file .
      791         end.
      792         when 'ext-file-line':U then do:
      793           create buf_temp-ext-file-line .
      794           run nws-impl in p-imp-handle
      795             ( input 'ext-file-line':U
      796              ,input (buffer buf_temp-ext-file-line:handle)
      797             ) no-error.
      798           if error-status :error then do:
      799             undo main-block, return error return-value .
      800           end.
      801           if v-err-num > 0 then do:
      802             delete buf_temp-ext-file-line.
      803             next _counter.
      804           end.
      805           if buf_temp-Ext-file-line.file-num <> p-file-num then do:
      806              v-err-num = 4.
      807              v-err-mess =  substitute("!!!Ошибки при приеме файла &1 (режим &2)&3" +
      808                                                 "номер файла &4 в строке файла не совпадает с номером файла в команде  - &5&3" +
      809                                                 "Бинарный файл принят/запущен не будет"
      810                                                       , p-file-name
      811                                                       , p-mode
      812                                                       , chr(10)
      813                                                       , buf_temp-Ext-file-line.file-num
      814                                                       , p-file-num
      815                                                     ).
      816           end.
      817           if p-mode = 'save-db':U
      818           or p-mode = 'save-db-and-run':U
      819           then do:
      820             find first buf_ext-file-line where
      821                      buf_Ext-file-line.db-num = buf_temp-ext-file-line.db-num
      822                  and buf_Ext-file-line.from-db-num = buf_temp-ext-file-line.from-db-num
      823                  and buf_Ext-file-line.file-num = buf_temp-ext-file-line.file-num
      824                  and buf_Ext-file-line.line-num = buf_temp-ext-file-line.line-num
      825                  and buf_Ext-file-line.sub-line-num = buf_temp-ext-file-line.sub-line-num no-error.
      826             if not available buf_Ext-file-line then do:
      827               create buf_Ext-file-line.
      828             end.
      829             buffer-copy
      830             buf_temp-ext-file-line to
      831             buf_ext-file-line .
      832           end.
      833         end.
      834         when 'ext-file-par':U then do:
      835             create buf_temp-ext-file-par .
      836             run nws-impl in p-imp-handle
      837               ( input 'ext-file-par':U
      838                ,input (buffer buf_temp-ext-file-par:handle)
      839               ) no-error.
      840             if error-status :error then do:
      841               undo main-block, return error return-value .
      842             end.
      843             if v-err-num > 0 then do:
      844               delete buf_temp-ext-file-par.
      845               next _counter.
      846             end.
      847             if buf_temp-ext-file-par.file-num <> p-file-num then do:
      848               v-err-num = 5.
      849               v-err-mess = substitute("!!!Ошибки при приеме файла &1 (режим &2)&3" +
      850                                                 "номер файла &4 в строке параметров не совпадает с номером файла в команде  - &5&3" +
      851                                                 "Бинарный файл принят/запущен не будет"
      852                                                         , p-file-name
      853                                                         , p-mode
      854                                                         , chr(10)
      855                                                         , buf_temp-ext-file-par.file-num
      856                                                         , p-file-num
      857                                                       ).
      858             end.
      859             find first buf_ext-file-par where
      860                       buf_ext-file-par.db-num = buf_temp-ext-file-par.db-num
      861                   and buf_ext-file-par.from-db-num = buf_temp-ext-file-par.from-db-num
      862                   and buf_ext-file-par.file-num = buf_temp-ext-file-par.file-num
      863                   and buf_ext-file-par.param-num = buf_temp-ext-file-par.param-num no-error.
      864             if not available buf_ext-file-par then do:
      865               create buf_ext-file-par.
      866             end.
      867             buffer-copy
      868             buf_temp-ext-file-par to
      869             buf_ext-file-par .
      870         end.
      871       END CASE.
      872     end.
      873     if v-err-num > 0 then do:
      874       run write-to-log in p-log-handle ( input v-err-mess).
      875       undo main-block.
      876     end.
      877       if (p-mode = 'save-install':U
      878     or p-mode = 'save-disk':U
      879     or p-mode = 'save-disk-and-run':U
      880     )
      881     and p-path-type = 1 then do:
      882       assign
      883       v-full-path-name = prepare-path(p-path) + chr(47) + p-file-name
      884       v-dir-name = p-path
      885       .
      886     end.
      887     if p-mode = 'save-db-and-run':U
      888     then do:
      889       run gbl/_tmpfile.p (
      890                         input  't':U
      891                       ,input  (if num-entries(p-file-name, ".") > 1
      892                                then entry(num-entries(p-file-name, "."), p-file-name, ".")
      893                                else  "p")
      894                       ,output v-temp-file-name
      895                       ) .
      896       assign
      897       v-full-path-name = v-temp-file-name
      898       .
      899     end.
      900     if (p-mode = 'save-install':U
      901     or p-mode = 'save-disk':U
      902     or p-mode = 'save-disk-and-run':U
      903     )
      904     and p-path-type = 0
      905     then do:
      906       run gbl/filename.p (
      907                      input replace(this-procedure:filename, ".p", ".r")
      908                     ,output v-full-path
      909                     ,output v-path
      910                     ,output v-file-name
      911                     ,output v-file-name-no-ext
      912                     ,output v-file-name-ext
      913                     ) no-error .
      914       if error-status:error then do:
      915         run gbl/filename.p (
      916                      input (this-procedure:filename)
      917                     ,output v-full-path
      918                     ,output v-path
      919                     ,output v-file-name
      920                     ,output v-file-name-no-ext
      921                     ,output v-file-name-ext
      922                     ) no-error .
      923       if error-status:error then do:
      924          v-err-mess =  substitute("&1 &2 &3&4Ошибка при определении имени файла &5&4" +
      925                                             "&6&4&7&4" +
      926                                             "для определения рабочей директории&4" +
      927                                             "Бинарный файл принят/запущен не будет"
      928                                             ,vss-workfile
      929                                             ,vss-revision
      930                                             ,vss-description
      931                                             ,chr(10)
      932                                             ,(this-procedure:filename)
      933                                             ,error-status:get-message(1)
      934                                             ,return-value ).
      935        run write-to-log in p-log-handle ( input v-err-mess).
      936         undo main-block, return.
      937       end.
      938       end.
      939       assign
      940       v-full-path-name = v-path +  chr(47) +
      941                         prepare-path (p-path) +  chr(47) +
      942                         p-file-name
      943       v-dir-name =   v-path + chr(47) +
      944                     prepare-path (p-path)
      945       .
      946     end.
      947     if (p-mode = 'save-install':U
      948     or p-mode = 'save-disk':U
      949     or p-mode = 'save-disk-and-run':U
      950     )
      951     and p-path-type = 2 then do:
      952       assign
      953       v-ini-section = entry(1, p-path)
      954       v-ini-key = entry(2, p-path)
      955       .
      956       RUN verify-ini-entry in this-procedure (
      957                              input v-ini-key
      958                             ,input v-ini-section
      959                             ,input substitute("не удалось определить значение параметра ini-файла&1" +
      960                                               "секция &2 ключ &3"
      961                                             , chr(10)
      962                                             , v-ini-section
      963                                             , v-ini-key
      964                                             )
      965                             ,input yes
      966                             ,output v-ini-path-dir) no-error.
      967       if error-status:error then do:
      968         v-err-mess =  substitute("&2&1&3&1&4&1&5&1&6&1" +
      969                                            "Бинарный файл принят/запущен не будет"
      970                   ,chr(10)
      971                   ,vss-workfile
      972                   ,vss-revision
      973                   ,vss-description
      974                   , error-status:get-message(1)
      975                   , return-value
      976                   ).
      977         run write-to-log in p-log-handle ( input v-err-mess).
      978         undo main-block, return ''.
      979       end.
      980       assign
      981       v-full-path-name =  prepare-path ( v-ini-path-dir) + chr(47) + p-file-name
      982       v-dir-name = v-ini-path-dir
      983       .
      984     end.
      985     if not (p-mode = 'save-db':U
      986             or
      987             p-mode = 'save-db-and-run':U
      988             )
      989     then do:
      990       FILE-INFO:FILE-NAME = v-dir-name.
      991       if index(FILE-INFO:file-type, 'F') > 0 then do:
      992         v-err-mess = substitute("&1 &2 &3&4Путь, указанный как директория для пересылаемого файла &5 - является файлом&6&4" +
      993                                            "Бинарный файл принят/запущен не будет"
      994                                             ,vss-workfile
      995                                             ,vss-revision
      996                                             ,vss-description
      997                                             ,chr(10)
      998                                             ,p-file-name
      999                                             ,v-dir-name).
     1000         run write-to-log in p-log-handle ( input v-err-mess).
     1001         undo main-block, return ''.
     1002       end.
     1003       if file-info:FULL-pathname = ? then do:
     1004         run gbl/dir-cre.p ( input v-dir-name)  no-error.
     1005         if error-status:error then do:
     1006           v-err-mess = substitute("&1 &2 &3&4Ошибка при создании директории &5&4" +
     1007                                               "&6&4&7&4" +
     1008                                               "Бинарный файл принят/запущен не будет"
     1009                                                 ,vss-workfile
     1010                                                 ,vss-revision
     1011                                                 ,vss-description
     1012                                                 ,chr(10)
     1013                                                 ,v-dir-name
     1014                                                 , error-status:get-message(1)
     1015                                                 , return-value
     1016                                                 ).
     1017           run write-to-log in p-log-handle ( input v-err-mess).
     1018           undo main-block, return ''.
     1019         end.
     1020       end.
     1021       v-can-write = index(FILE-INFO:file-type, 'W') > 0.
     1022       if not v-can-write then do:
     1023         v-err-mess = substitute("&1 &2 &3&4Отсутствуют права на запись в директорию &5&4" +
     1024                                              "Бинарный файл принят/запущен не будет"
     1025                                               ,vss-workfile
     1026                                               ,vss-revision
     1027                                               ,vss-description
     1028                                               ,chr(10)
     1029                                               ,v-dir-name).
     1030         run write-to-log in p-log-handle ( input v-err-mess).
     1031         undo main-block, return ''.
     1032       end.
     1033     end.
     1034     if p-mode = 'save-db':U
     1035     or p-mode = 'save-db-and-run':U
     1036     then do:
     1037       ASSIGN
     1038       v-run-name = prepare-path(buf_ext-file.FILE-NAME)
     1039       v-run-name = entry(num-entries(v-run-name, chr(47))
     1040                               , v-run-name
     1041                               , chr(47)
     1042                               ).
     1043     end.
     1044     if p-mode = 'save-disk':U
     1045     or p-mode = 'save-install':U
     1046     or p-mode = 'save-disk-and-run':U
     1047     or p-mode = 'save-db-and-run':U
     1048     then do:
     1049       run binfile_write in this-procedure (
     1050          input  buf_temp-ext-file.db-num
     1051         ,input  buf_temp-ext-file.from-db-num
     1052         ,input  p-file-num
     1053         ,input  v-full-path-name
     1054         ) .
     1055       run gbl/md5.p (
     1056           input  v-full-path-name
     1057         ,output v-md5-signature
     1058         ) .
     1059       if v-md5-signature <> p-md5-signature then do:
     1060         os-delete value(v-full-path-name).
     1061         run write-to-log in p-log-handle (
     1062                                            substitute("!!!Принятый файл &1 (режим &2) имеет неверную сигнатуру md5 - удаляется"
     1063                                                   , p-file-name
     1064                                                   , p-mode
     1065                                                   )).
     1066       end.
     1067       assign
     1068       buf_ext-file.file-name = buf_ext-file.file-name + ">" + prepare-path(p-path) + chr(47).
     1069     end.
     1070     if p-mode = 'save-db-and-run':U
     1071     or p-mode = 'save-disk-and-run':U
     1072     then do:
     1073       define variable v-stop as logical no-undo init yes.
     1074       do on stop undo, next:
     1075         run write-to-log in p-log-handle (
     1076                                            substitute("Запускается принятый файл &1 (режим &2)"
     1077                                                   , p-file-name
     1078                                                   , p-mode
     1079                                                   )).
     1080         run value (v-full-path-name ) (
     1081                                         INPUT parparentproc
     1082                                       , INPUT p-parent-handle
     1083                                       , INPUT p-log-handle
     1084                                       , input (string(buf_ext-file.db-num) + chr(4) +
     1085                                                string(buf_ext-file.from-db-num) + chr(4) +
     1086                                                string(buf_Ext-file.file-num))
     1087                                     )
     1088         no-error.
     1089         v-stop = no.
     1090       end.
     1091       if error-status:error
     1092       or v-stop then do:
     1093         assign
     1094         v-res-message =  substitute("!!!Ошибка при запуске принятого файла &1 (режим &2)&3&4&3&5&3"
     1095                                                                                     , p-file-name
     1096                                                                                     , p-mode
     1097                                                                                     , chr(10)
     1098                                                                                     , error-status:get-message(1)
     1099                                                                                     , return-value).
     1100         run write-to-log in p-log-handle (
     1101                                           substitute("!!!Ошибка при запуске принятого файла &1 (режим &2)&3&4&3&5&3"
     1102                                                                                     , p-file-name
     1103                                                                                     , p-mode
     1104                                                                                     , chr(10)
     1105                                                                                     , error-status:get-message(1)
     1106                                                                                     , return-value)
     1107                                            ).
     1108       end.
     1109       else do:
     1110         assign
     1111         v-res-message =  if return-value = "" then  substitute("OK запуске принятого файла &1 (режим &2)"
     1112                                                                , p-file-name
     1113                                                                , p-mode
     1114                                                               )
     1115                          else return-value.
     1116       end.
     1117       find first buf_ext-file-par where
     1118                 buf_ext-file-par.db-num = buf_Ext-file.db-num
     1119             and buf_ext-file-par.from-db-num = buf_Ext-file.from-db-num
     1120             and buf_ext-file-par.file-num = buf_Ext-file.file-num
     1121             and buf_ext-file-par.param-num = 0  no-error.
     1122       if not available buf_ext-file-par then do:
     1123         create  buf_ext-file-par.
     1124         assign
     1125         buf_ext-file-par.db-num = buf_Ext-file.db-num
     1126         buf_ext-file-par.from-db-num = buf_Ext-file.from-db-num
     1127         buf_ext-file-par.file-num = buf_Ext-file.file-num
     1128         buf_ext-file-par.param-num = 0
     1129         buf_ext-file-par.param-type = '':U
     1130         buf_ext-file-par.param-name = v-run-name
     1131         buf_ext-file-par.user-db-num = g#db-num
     1132         .
     1133       end .
     1134       else do:
     1135           run clear-record in this-procedure ( buffer buf_ext-file-par).
     1136       end.
     1137       assign
     1138       buf_ext-file-par.param-name  =  substitute("Результат выполнения принятого файла  &1 (режим &2)"
     1139                                                 , p-file-name
     1140                                                 , p-mode)
     1141       buf_ext-file-par.param-value =  v-res-message
     1142       .
     1143       run nws/cr-route.p (
     1144                         input 'send-tbl':U
     1145                       , input 'ext-file-par':U
     1146                       , input buffer buf_ext-file-par:handle
     1147                       , input string(g#news-source-db)) no-error.
     1148     end.
     1149     p-ok = yes.
     1150     return '':U.
     1151   end.
     1152   procedure write-to-log :
     1153   define input parameter p-message as character no-undo .
     1154     do
     1155     on error undo, return error return-value
     1156     :
     1157        run write-to-log in p-parent-handle (input p-message) .
     1158     end.
     1159   end procedure.
     1160   procedure clear-record :
     1161   define parameter buffer buf_ext-file-par for ub.ext-file-par.
     1162     do
     1163     on error undo, return error return-value
     1164     :
     1165        assign
     1166        buf_ext-file-par.param-name         = '':U
     1167        buf_ext-file-par.param-value        = '':U
     1168        buf_ext-file-par.param-date-name    = '':U
     1169        buf_ext-file-par.param-date-value   = ?
     1170        buf_ext-file-par.param-int-name     = '':U
     1171        buf_ext-file-par.param-int-value    = 0
     1172        buf_ext-file-par.param-log-name     = '':U
     1173        buf_ext-file-par.param-log-value    = no
     1174        buf_ext-file-par.param-decimal-name     = '':U
     1175        buf_ext-file-par.param-decimal-value    = 0.0
     1176        .
     1177     end.
     1178   end procedure.
