      141   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      142   procedure cur-time :
      143      define output parameter p-today as date      no-undo .
      144      define output parameter p-time  as integer   no-undo .
      145     do
      146     on error undo, return error
      147     :
      148       define variable v-date1 as date      no-undo .
      149       define variable v-date2 as date      no-undo .
      150       define variable v-time  as integer   no-undo .
      151       assign
      152         v-date1 = today
      153         v-time  = time
      154         v-date2 = today
      155       .
      156       if v-date1 <> v-date2
      157       then do:
      158         assign
      159           v-date1 = today
      160           v-time  = v-time
      161         .
      162       end.
      163       assign
      164         p-today = v-date1
      165         p-time  = v-time
      166       .
      167     end.
      168   end.
      169   function cur-time-date returns character
      170   :
      171     return string(today, '99/99/9999':U) .
      172   end.
      173   function cur-time-mjd returns decimal
      174   :
      175     define variable v-date as date      no-undo .
      176     define variable v-time as integer   no-undo .
      177     run cur-time in this-procedure
      178       (output v-date
      179       ,output v-time
      180       ) .
      181     return integer(v-date) - 2400002 + (v-time / 86400) .
      182   end.
      183   function cur-time-get-ending-index returns integer
      184   (input p-number as integer
      185   )
      186   :
      187     if p-number < 0
      188     or p-number = ?
      189     then do:
      190       return 1 .
      191     end.
      192     define variable v-rest as integer   no-undo .
      193     assign
      194       p-number = p-number modulo 100
      195     .
      196     if p-number < 20
      197     then do:
      198       assign
      199         v-rest = p-number
      200       .
      201     end.
      202     else do:
      203       assign
      204         v-rest = p-number modulo 10
      205       .
      206     end.
      207     case v-rest :
      208       when 1
      209       then do:
      210         return 2 .
      211       end.
      212       when 2 or
      213       when 3 or
      214       when 4
      215       then do:
      216         return 3 .
      217       end.
      218       otherwise do:
      219         return 1 .
      220       end.
      221     end case .
      222   end.
      223   procedure cur-time-mjd-to-date :
      224      define input  parameter i-mjd-diff as decimal no-undo.
      225      define output parameter o-Date     as date    no-undo.
      226      define output parameter o-Time     as integer no-undo.
      227      define variable v-day-number as integer   no-undo .
      228      if    i-mjd-diff < 0
      229         or i-mjd-diff = ?
      230      then do:
      231         return "?" .
      232      end.
      233      assign
      234         v-day-number = truncate(i-mjd-diff,0).
      235         o-Date = date(v-day-number + 2400002).
      236         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      237     .
      238   end.
      239   function cur-time-mjd-to-string returns character
      240   (input p-mjd-diff as decimal
      241   )
      242   :
      243     define variable v-day-number as integer   no-undo .
      244     define variable v-seconds    as integer   no-undo .
      245     define variable v-hour       as integer   no-undo .
      246     define variable v-min        as integer   no-undo .
      247     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      248     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      249     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      250     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      251     if p-mjd-diff < 0
      252     or p-mjd-diff = ?
      253     then do:
      254       return "?" .
      255     end.
      256     assign
      257       v-day-number = integer(truncate(p-mjd-diff,0))
      258       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      259     .
      260     if v-seconds > 86400
      261     then do:
      262       assign
      263         v-seconds = 86400 - 1
      264       .
      265     end.
      266     if v-seconds < 0
      267     then do:
      268       assign
      269         v-seconds = 0
      270       .
      271     end.
      272     assign
      273       v-hour = truncate(v-seconds / 3600, 0)
      274     .
      275     assign
      276       v-seconds = v-seconds modulo 3600
      277     .
      278     assign
      279       v-min = truncate(v-seconds / 60, 0)
      280     .
      281     assign
      282       v-seconds = v-seconds modulo 60
      283     .
      284     return
      285         (if v-day-number <> 0
      286           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      287           else ""
      288         )
      289       + (if v-day-number <> 0 or v-hour <> 0
      290           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      291           else ""
      292         )
      293       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      294           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      295           else ""
      296         )
      297       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      298       .
      299   end.
      300   function cur-time-string returns character
      301   :
      302     define variable v-date as date      no-undo .
      303     define variable v-time as integer   no-undo .
      304     run cur-time in this-procedure
      305       (output v-date
      306       ,output v-time
      307       ) .
      308     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      309   end.
      310   function cur-time-string-sec returns character
      311   :
      312     define variable v-date as date      no-undo .
      313     define variable v-time as integer   no-undo .
      314     run cur-time in this-procedure
      315       (output v-date
      316       ,output v-time
      317       ) .
      318     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      319   end.
      320   function cur-time-custom  returns character
      321   (input p-prefix as character
      322   ,input p-date-format as character
      323   ,input p-delimiter as character
      324   ,input p-time-format as character
      325   ,input p-suffix as character
      326   )
      327   :
      328     define variable v-date as date      no-undo .
      329     define variable v-time as integer   no-undo .
      330     run cur-time in this-procedure
      331       (output v-date
      332       ,output v-time
      333       ) .
      334     return
      335       p-prefix
      336       + string(v-date, p-date-format)
      337       + p-delimiter
      338       + string(v-time, p-time-format)
      339       + p-suffix
      340       .
      341   end.
      342   function cur-time-print  returns character
      343   :
      344     define variable v-date as date      no-undo .
      345     define variable v-time as integer   no-undo .
      346     run cur-time in this-procedure
      347       (output v-date
      348       ,output v-time
      349       ) .
      350     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      351   end.
      352   function cur-time-datetime returns datetime
      353   :
      354     define variable v-char as character no-undo .
      355     define variable v-datetime as datetime no-undo .
      356     v-char = cur-time-string().
      357     v-datetime = datetime(v-char).
      358     return  v-datetime.
      359   end.
      360   function cur-time-string-msec returns character
      361   :
      362     define variable v-date as datetime  no-undo .
      363     v-date = now.
      364     return string(v-date) .
      365   end.
      366   define stream LogStream .
      367   define variable mNoTime as logical no-undo.
      368   procedure write-to-log-notime :
      369     define input param i-str as character no-undo .
      370     mNoTime = yes.
      371     run write-to-log (i-str).
      372     mNoTime = no.
      373   end.
      374   procedure write-to-log :
      375     define input param p-str as character no-undo .
      376     do
      377     on error  undo, return error substitute( "&1 (write-to-log). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      378     on stop   undo, return error substitute( "&1 (write-to-log). stop", vss-workfile )
      379     on endkey undo, return error substitute( "&1 (write-to-log). endkey", vss-workfile )
      380     :
      381       define variable log-res        as logical   no-undo .
      382       define variable v-jj           as integer   no-undo .
      383       if    mNoTime
      384          or writelogvalue eq "AsyncProc"
      385       then
      386          p-str = substitute( "&1 (pid: &2) &3&4"   , g#auto-user-id, g#auto-pid,                        p-str, chr(10) ).
      387       else
      388          p-str = substitute( "&1 (pid: &2) &3 &4&5", g#auto-user-id, g#auto-pid, cur-time-string-sec(), p-str, chr(10) ).
      389       if auto-log-msg-h <> ? then do:
      390         log-res = auto-log-msg-h:move-to-eof( ) .
      391         log-res = auto-log-msg-h:insert-string( p-str ).
      392       end.
      393       if hand-log-msg-h <> ? then do:
      394         log-res = hand-log-msg-h:move-to-eof( ) .
      395         log-res = hand-log-msg-h:insert-string( p-str ).
      396       end.
      397       assign
      398         p-str = replace(p-str, (chr(10) + chr(13)), chr(10) )
      399         p-str = replace(p-str, (chr(13) + chr(10)), chr(10) )
      400         p-str = replace(p-str, chr(10), (chr(13) + chr(10)) )
      401       .
      402       if add-log-file-name <> ? then do:
      403         do v-jj = 1 to num-entries(add-log-file-name, chr(1)):
      404           run gbl/fileapnd.p
      405             ( input entry(v-jj, add-log-file-name, chr(1) )
      406             ,input p-str
      407             ,input 20
      408             ) no-error .
      409           if error-status:error then do:
      410             return error return-value .
      411           end.
      412         end.
      413       end.
      414       if writelogvalue eq "AsyncProc"
      415       then do:
      416          p-str = trim(p-str, (chr(13) + chr(10)) )
      417       .
      418          Publish "WriteLogAsunc" (p-str,yes).
      419       end.
      420       else if writelogvalue <> "yes" then do:
      421         run gbl/fileapnd.p
      422           ( input log-file-name
      423           ,input p-str
      424           ,input 20
      425           ) no-error .
      426         if error-status:error then do:
      427           return error return-value .
      428         end.
      429       end.
      430     end.
      431   end procedure.
      432   procedure write-to-screen :
      433     define input param p-str as character no-undo .
      434     do
      435     on error  undo, return error substitute( "&1 (write-to-screen). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      436     on stop   undo, return error substitute( "&1 (write-to-screen). stop", vss-workfile )
      437     on endkey undo, return error substitute( "&1 (write-to-screen). endkey", vss-workfile )
      438     :
      439       define variable log-res as logical no-undo.
      440       assign
      441         p-str = substitute( "&1 (pid: &2) &3 &4&5", g#auto-user-id, g#auto-pid, cur-time-string-sec(), p-str, chr(10) )
      442       .
      443       if auto-log-msg-h <> ?
      444       then do:
      445         log-res = auto-log-msg-h:move-to-eof( ) .
      446         log-res = auto-log-msg-h:insert-string( p-str ).
      447       end.
      448       if hand-log-msg-h <> ?
      449       then do:
      450         log-res = hand-log-msg-h:move-to-eof( ) .
      451         log-res = hand-log-msg-h:insert-string( p-str ).
      452       end.
      453     end.
      454   end procedure.
      455   procedure send-msg-to-email :
      456     define input  parameter p-subject      as character no-undo .
      457     define input  parameter p-text-err     as character no-undo .
      458     define input  parameter p-attach-files as character no-undo .
      459     do
      460     on error  undo, return error substitute( "&1 (send-msg-to-email). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      461     on stop   undo, return error substitute( "&1 (send-msg-to-email). stop", vss-workfile )
      462     on endkey undo, return error substitute( "&1 (send-msg-to-email). endkey", vss-workfile )
      463     :
      464       define variable v-tth             as handle    no-undo .
      465       define variable v-value-character as character no-undo .
      466       define variable v-value-date      as date      no-undo .
      467       define variable v-value-decimal   as decimal   no-undo .
      468       define variable v-value-integer   as integer   no-undo .
      469       define variable v-value-logical   as logical   no-undo .
      470       define variable v-param-type      as character no-undo .
      471       define variable v-email       as character no-undo .
      472       define variable v-tmp-str     as character no-undo .
      473       define variable v-tmp1-str    as character no-undo .
      474       define variable v-ind         as integer   no-undo .
      475       define variable v-num-entries as integer   no-undo .
      476       delete object v-tth no-error.
      477       run adm/shattri.p
      478         ( input "get":U
      479          ,input  "":U
      480          ,input  0
      481          ,input  'auto-task':U
      482          ,input  'send-msg-to-email':U
      483          ,output v-value-character
      484          ,output v-value-date
      485          ,output v-value-decimal
      486          ,output v-value-integer
      487          ,output v-value-logical
      488          ,output v-param-type
      489          ,input-output table-handle v-tth
      490         ) no-error .
      491       if not error-status :error  then do:
      492         assign
      493           v-tmp-str = v-value-character
      494         .
      495       end.
      496       delete object v-tth no-error.
      497       assign
      498         v-tmp-str     = replace(v-tmp-str, (chr(10) + chr(13)), chr(44) )
      499         v-tmp-str     = replace(v-tmp-str, (chr(13) + chr(10)), chr(44) )
      500         v-tmp-str     = replace(v-tmp-str, chr(10), chr(44) )
      501         v-num-entries = num-entries( v-tmp-str, chr(44) )
      502         v-email       = "":U
      503       .
      504       do v-ind = 1 to v-num-entries
      505       :
      506         assign
      507           v-tmp1-str = entry( v-ind, v-tmp-str, chr(44) )
      508         .
      509         if trim( v-tmp1-str ) <> "":U then do:
      510           if v-email = "":U then do:
      511             assign
      512               v-email = v-tmp1-str
      513             .
      514           end.
      515           else do:
      516             assign
      517               v-email = v-email + chr(44) + v-tmp1-str
      518             .
      519           end.
      520         end.
      521       end.
      522       if v-email <> "":U then do:
      523         run gbl/sendmail.p
      524           ( input v-email
      525           , input p-subject
      526           , input p-text-err
      527           , input p-attach-files
      528           ) no-error .
      529         if error-status :error
      530           or return-value <> "":U
      531         then do:
      532           return error substitute( "&1 (send-msg-to-email). &2", vss-workfile, return-value ) .
      533         end.
      534       end.
      535     end.
      536   end procedure.
      537   define  shared variable nws-exch-dir as character no-undo .
      538   define  shared variable nws-heap-dir as character no-undo .
      539   define variable err-mess as character no-undo .
      540   define temp-table t-pck-conf no-undo
      541     field db-num-dst      as integer
      542     field db-num-src      as integer
      543     field pack-num        as integer
      544     field total-recs      as integer
      545     field sys-key         as character
      546     field src_db-key      as character
      547     field dst_db-key      as character
      548     field ver-num         as character
      549     field prev-crc        as character
      550     field actual-date     as date
      551     field actual-time-int as integer
      552   .
      553   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      554   FUNCTION mark-string RETURNS CHARACTER
      555     ( input p-recid as recid, input mark-list as character  ) :
      556     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
      557   END FUNCTION.
      558   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      559   DEF VAR BLACK_COLOR        AS INTEGER NO-UNDO INIT  0.
      560   DEF VAR DARK_BLUE_COLOR    AS INTEGER NO-UNDO INIT  1.
      561   DEF VAR DARK_GREEN_COLOR   AS INTEGER NO-UNDO INIT  2.
      562   DEF VAR CYAN_COLOR         AS INTEGER NO-UNDO INIT  3.
      563   DEF VAR BROWN_COLOR        AS INTEGER NO-UNDO INIT  4.
      564   DEF VAR DARK_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
      565   DEF VAR DARK_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
      566   DEF VAR VERY_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
      567   DEF VAR VERY_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
      568   DEF VAR GRAY_COLOR         AS INTEGER NO-UNDO INIT  8.
      569   DEF VAR GREY_COLOR         AS INTEGER NO-UNDO INIT  8.
      570   DEF VAR BLUE_COLOR         AS INTEGER NO-UNDO INIT  9.
      571   DEF VAR GREEN_COLOR        AS INTEGER NO-UNDO INIT 10.
      572   DEF VAR RED_COLOR          AS INTEGER NO-UNDO INIT 12.
      573   DEF VAR LIGHT_RED_COLOR    AS INTEGER NO-UNDO INIT 13.
      574   DEF VAR YELLOW_COLOR       AS INTEGER NO-UNDO INIT 14.
      575   DEF VAR WHITE_COLOR        AS INTEGER NO-UNDO INIT 15.
      576   define variable log-res as logical no-undo .
      577   define buffer buf_db for ub.db .
      578   define variable v-rid-list     as   character    no-undo .
      579   define variable v-rid-list-new as   character    no-undo .
      580   define variable v-ind          as   integer      no-undo .
      581   define variable v-num-entries  as   integer      no-undo .
      582   define variable v-db-list      as   character    no-undo .
      583   define variable v-db-num       like ub.db.db-num no-undo .
      584   define variable v-one-db       as   logical      no-undo .
      585   define variable v-cur-db-num as integer no-undo .
      586   define variable v-have-rights    as logical        no-undo.
      587   FUNCTION get-turn-on RETURNS LOGICAL
      588     ( INPUT v-db-key AS CHARACTER )  FORWARD.
      589   DEFINE BUTTON b-create DEFAULT
      590        LABEL "Под&готовить новые"
      591        SIZE 20 BY 1 TOOLTIP "Подготовка новых пакетов для всех БД"
      592        BGCOLOR 8 .
      593   DEFINE BUTTON b-sync DEFAULT
      594        LABEL "&Синхронизация"
      595        SIZE 20 BY 1 TOOLTIP "Синхронизация УБД, восстановленной из бэкапа, с ТБД"
      596        BGCOLOR 8 .
      597   DEFINE BUTTON b-exit AUTO-GO DEFAULT
      598        LABEL "Вы&ход "
      599        SIZE 10 BY 1 TOOLTIP "Выход из новостей"
      600        BGCOLOR 8 .
      601   DEFINE BUTTON b-get DEFAULT
      602        LABEL "При&нять"
      603        SIZE 10 BY 1 TOOLTIP "Принять почту не разбирая пакет".
      604   DEFINE BUTTON b-get-pck DEFAULT
      605        LABEL "&Принять/Разобрать"
      606        SIZE 20 BY 1 TOOLTIP "Принять и затем разобрать пришедшую почту".
      607   DEFINE BUTTON b-help
      608        LABEL "Помо&щь"
      609        SIZE 3 BY 1
      610        BGCOLOR 8 .
      611   DEFINE BUTTON b-info-all DEFAULT
      612        LABEL "Информ. о пакетах"
      613        SIZE 20 BY 1 TOOLTIP "Детальная информация о пакетах по БД"
      614        BGCOLOR 8 .
      615   DEFINE BUTTON b-mark
      616        LABEL "&*"
      617        SIZE 3 BY 1.
      618   DEFINE BUTTON b-proc-pck DEFAULT
      619        LABEL "&Разобрать"
      620        SIZE 10 BY 1 TOOLTIP "Только разобрать пакет, не принимая новых".
      621   DEFINE BUTTON b-send DEFAULT
      622        LABEL "&Отправить"
      623        SIZE 10 BY 1 TOOLTIP "Отправить конкретный пакет с его переформированием".
      624   DEFINE BUTTON b-send-all DEFAULT
      625        LABEL "Отпр. в&cе"
      626        SIZE 10 BY 1 TOOLTIP "Отправить все неподтвержденные пакеты с их переформированием".
      627   DEFINE BUTTON b-send-new DEFAULT
      628        LABEL "Отпр&авить новые"
      629        SIZE 20 BY 1 TOOLTIP "Отправка новых и некоторых неподтвержденных пакетов"
      630        BGCOLOR 8 .
      631   DEFINE BUTTON b-unsend DEFAULT
      632        LABEL "&Без подтвержд."
      633        SIZE 20 BY 1 TOOLTIP "Неотправленнная или неподтвержденая информация".
      634   DEFINE BUTTON bt-not-sel-all
      635        LABEL "+"
      636        SIZE 3 BY 1 TOOLTIP "Выбрать все".
      637   DEFINE BUTTON bt-not-sel-desel-all
      638        LABEL "-"
      639        SIZE 3 BY 1 TOOLTIP "Отменить выбор".
      640   DEFINE VARIABLE news-log AS CHARACTER INITIAL ?
      641        VIEW-AS EDITOR NO-WORD-WRAP SCROLLBAR-HORIZONTAL SCROLLBAR-VERTICAL LARGE
      642        SIZE 97 BY 6.5 TOOLTIP "Просмотр файла с сообщениями о работе новостей" NO-UNDO.
      643   DEFINE VARIABLE f-not-rcvd AS INTEGER FORMAT ">>>>>9":U INITIAL 0
      644        LABEL "без подтверждения"
      645         VIEW-AS TEXT
      646        SIZE 7 BY .67 TOOLTIP "кол-во пакетов без подтверждения" NO-UNDO.
      647   DEFINE VARIABLE mark-num AS INTEGER FORMAT ">>>9":U INITIAL 0
      648         VIEW-AS TEXT
      649        SIZE 4 BY 1
      650        FGCOLOR 7  NO-UNDO.
      651   DEFINE RECTANGLE RECT-3
      652        EDGE-PIXELS 3 GRAPHIC-EDGE  NO-FILL
      653        SIZE 97 BY 13.5.
      654   DEFINE QUERY br-db FOR
      655         X_db SCROLLING.
      656   DEFINE QUERY br-pck-rcvd FOR
      657         X_pck-rcvd SCROLLING.
      658   DEFINE QUERY br-pck-sent FOR
      659         X_pck-sent SCROLLING.
      660   DEFINE BROWSE br-db
      661     QUERY br-db DISPLAY
      662         mark-string( input recid(X_db), input v-rid-list) column-label "*" format "X(1)":U
      663         get-turn-on(X_db.db-key) FORMAT "+/-":U COLUMN-LABEL "A":U
      664         X_db.db-num FORMAT ">>>>9":U
      665         X_db.db-name
      666       WITH SEPARATORS SIZE 61.5 BY 13
      667            TITLE "Список БД" FIT-LAST-COLUMN TOOLTIP "Рабочие БД".
      668   DEFINE BROWSE br-pck-rcvd
      669     QUERY br-pck-rcvd NO-LOCK DISPLAY
      670         X_pck-rcvd.pack-num COLUMN-LABEL "Номер" FORMAT ">>>>>>9":U
      671         X_pck-rcvd.rcvd COLUMN-LABEL "Подтв." FORMAT "yes/no":U
      672         X_pck-rcvd.total-recs COLUMN-LABEL "Записей в пакете" FORMAT ">>>>>>>>>9":U
      673               WIDTH 16.25
      674       WITH NO-ASSIGN NO-ROW-MARKERS SEPARATORS SIZE 33 BY 6
      675            TITLE "Полученные пакеты" FIT-LAST-COLUMN TOOLTIP "Полученные пакеты от данной БД".
      676   DEFINE BROWSE br-pck-sent
      677     QUERY br-pck-sent NO-LOCK DISPLAY
      678         X_pck-sent.pack-num COLUMN-LABEL "Номер" FORMAT ">>>>>>9":U
      679         X_pck-sent.rcvd COLUMN-LABEL "Подтв." FORMAT "yes/no":U
      680         X_pck-sent.total-recs COLUMN-LABEL "Записей в пакете" FORMAT ">>>>>>>>>9":U
      681               WIDTH 16.25
      682       WITH NO-ASSIGN NO-ROW-MARKERS SEPARATORS SIZE 33 BY 6
      683            TITLE "Отправленные пакеты" FIT-LAST-COLUMN TOOLTIP "Отправленные пакеты в данную БД".
      684   DEFINE FRAME nws-hand
      685        b-exit AT ROW 1 COL 2
      686        b-get-pck AT ROW 1 COL 15
      687        b-create AT ROW 1 COL 35
      688        b-send-new AT ROW 1 COL 55
      689        b-info-all AT ROW 1 COL 75 WIDGET-ID 2
      690        b-help AT ROW 1 COL 95.5
      691        bt-not-sel-all AT ROW 2 COL 6 WIDGET-ID 10 NO-TAB-STOP
      692        bt-not-sel-desel-all AT ROW 2 COL 9 WIDGET-ID 12 NO-TAB-STOP
      693        b-mark AT ROW 2 COL 12 WIDGET-ID 4
      694        b-get AT ROW 2 COL 15
      695        b-proc-pck AT ROW 2 COL 25
      696        b-sync at row 2 col 35
      697        b-send AT ROW 2 COL 55
      698        b-send-all AT ROW 2 COL 65
      699        b-unsend AT ROW 2 COL 75
      700        br-db AT ROW 3.5 COL 2.5
      701        br-pck-sent AT ROW 3.5 COL 65
      702        br-pck-rcvd AT ROW 10.5 COL 65
      703        news-log AT ROW 17 COL 2 NO-LABEL
      704        mark-num AT ROW 2 COL 2 NO-LABEL WIDGET-ID 8
      705        f-not-rcvd AT ROW 9.5 COL 86.5 COLON-ALIGNED
      706        RECT-3 AT ROW 3.25 COL 2
      707        SPACE(0.87) SKIP(7.01)
      708       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      709            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      710            TITLE "".
      711   ASSIGN
      712          FRAME nws-hand:SCROLLABLE       = FALSE.
      713   ASSIGN
      714          f-not-rcvd:READ-ONLY IN FRAME nws-hand        = TRUE.
      715   ASSIGN
      716          news-log:READ-ONLY IN FRAME nws-hand        = TRUE.
      717   ON WINDOW-CLOSE OF FRAME nws-hand
      718   DO:
      719     APPLY "END-ERROR":U TO SELF.
      720   END.
      721   ON CHOOSE OF b-create IN FRAME nws-hand
      722   DO:
      723     define variable v-message  as character no-undo .
      724     define variable v-err-code as integer   no-undo .
      725     assign     v-one-db = false   .   if trim( v-rid-list ) = "":U     and available X_db   then do:     assign       v-rid-list = string( recid ( X_db ) )       v-one-db   = true     .    end.   if trim( v-rid-list ) = "":U then do:     message       "Не выбрана БД."       view-as alert-box information.     return no-apply.   end.   assign     v-num-entries = num-entries( v-rid-list)     v-rid-list-new = "":U     v-db-list = "":U   .   do v-ind = 1 to v-num-entries   :     find first buf_db no-lock       where recid( buf_db ) = integer( entry( v-ind, v-rid-list ) )       no-error .     if not available buf_db then do:       message         substitute( "БД &1 удалена.", integer( entry( v-ind, v-rid-list ) ) )         view-as alert-box information.     end.     else do:       if v-one-db <> true then do:         assign           v-rid-list-new = v-rid-list-new + (if v-rid-list-new = "":U then "":U else chr(44)) + entry( v-ind, v-rid-list )         .       end.       assign         v-db-list = v-db-list + (if v-db-list = "":U then "":U else chr(44)) + string( buf_db.db-num )       .     end.   end.   assign     v-rid-list = v-rid-list-new   .   run refresh-brws in this-procedure     ( input yes ) .
      726     run write-to-log in this-procedure
      727       ( substitute( "Подготовка новых пакетов." )
      728       ).
      729     run nws/cnew-pck.p
      730       ( input v-db-list
      731       , output v-err-code
      732       ) no-error .
      733     if error-status:error then do:
      734       run write-to-log( substitute( "&1. ERROR!!! Ошибка при подготовке пакетов новостей &2&3&4"
      735                                     ,vss-workfile
      736                                     ,error-status:get-message(error-status:num-messages)
      737                                     ,chr(10)
      738                                     ,return-value
      739                                   )
      740                       ) .
      741     end.
      742     else do:
      743       assign
      744         v-message = return-value
      745       .
      746       if v-message <> "":U then do:
      747         run write-to-log in this-procedure
      748           ( substitute( "&1", v-message )
      749           ).
      750       end.
      751       run write-to-log in this-procedure
      752         ( substitute( "Завершена подготовка новых пакетов." )
      753         ).
      754     end.
      755     run refresh-brws in this-procedure
      756       ( input yes
      757       ).
      758   END.
      759   ON CHOOSE OF b-sync IN FRAME nws-hand
      760   DO:
      761     define variable v-user-id as character no-undo .
      762     define variable vOk as logical no-undo .
      763     v-user-id = g#auto-user-id + chr(4) + 'yes' .
      764     if not available X_db then return no-apply .
      765   define variable vss-include-info5 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      766   do:
      767     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      768       (input  g#db-num
      769       ,input  v-user-id
      770       ,input  0
      771       ,input  'actn_news-sync':U
      772       ,input  'global':U
      773       ,input  0
      774       ,input  '':U
      775       ,input  0
      776       ,input  0
      777       ,input  0
      778       ,input  0
      779       ,input  no
      780       ,output v-have-rights
      781       )  .
      782   end.
      783     if not v-have-rights
      784     then do :
      785       if v-cur-db-num = 0
      786       then do :
      787         message "Недостаточно прав для выполнения Cинхронизации БД " string(x_db.db-num) " с ТБД" view-as alert-box error.
      788       end .
      789       else do :
      790         message "Недостаточно прав для отправки запроса на Синхронизацию УБД с ТБД" view-as alert-box error.
      791       end .
      792       return no-apply .
      793     end.
      794     if v-cur-db-num = 0
      795     then do :
      796       run nws/sync.w (input parparentproc,
      797                       input X_db.db-num)
      798                       no-error .
      799       if error-status:error
      800       then do :
      801         run write-to-log( substitute( "&1. ERROR!!! Ошибка при синхронизации пакетов с БД &5&3&2&3&4"
      802                                       ,vss-workfile
      803                                       ,error-status:get-message(error-status:num-messages)
      804                                       ,chr(10)
      805                                       ,return-value
      806                                       ,string(X_db.db-num)
      807                                     )
      808                         ) .
      809       end.
      810     end .
      811     else do :
      812       message "Вы уверены что хотите отправить запрос в ТБД на Синхронизацию обмена СПН? Каталоги новостей будут очищены!" view-as alert-box question buttons yes-no update vOk .
      813       if not vOk
      814       then
      815         return no-apply .
      816       run nws/send-sync-request.p (input parparentproc,
      817                                    input X_db.db-num)
      818                                    no-error .
      819       if error-status:error
      820       then do :
      821         run write-to-log( substitute( "&1. ERROR!!! Ошибка при отправке запроса на Синхронизацию обмена СПН &3&2&3&4"
      822                                       ,vss-workfile
      823                                       ,error-status:get-message(error-status:num-messages)
      824                                       ,chr(10)
      825                                       ,return-value
      826                                     )
      827                         ) .
      828       end.
      829     end .
      830     OPEN QUERY br-pck-rcvd FOR EACH X_pck-rcvd       WHERE X_pck-rcvd.db-num = X_db.db-num  NO-LOCK     BY X_pck-rcvd.db-num DESCENDING        BY X_pck-rcvd.pack-num DESCENDING INDEXED-REPOSITION.
      831     OPEN QUERY br-pck-sent FOR EACH X_pck-sent       WHERE X_pck-sent.db-num = X_db.db-num NO-LOCK     BY X_pck-sent.db-num DESCENDING        BY X_pck-sent.pack-num DESCENDING INDEXED-REPOSITION.
      832   END.
      833   ON CHOOSE OF b-get IN FRAME nws-hand
      834   DO:
      835       assign     v-one-db = false   .   if trim( v-rid-list ) = "":U     and available X_db   then do:     assign       v-rid-list = string( recid ( X_db ) )       v-one-db   = true     .    end.   if trim( v-rid-list ) = "":U then do:     message       "Не выбрана БД."       view-as alert-box information.     return no-apply.   end.   assign     v-num-entries = num-entries( v-rid-list)     v-rid-list-new = "":U     v-db-list = "":U   .   do v-ind = 1 to v-num-entries   :     find first buf_db no-lock       where recid( buf_db ) = integer( entry( v-ind, v-rid-list ) )       no-error .     if not available buf_db then do:       message         substitute( "БД &1 удалена.", integer( entry( v-ind, v-rid-list ) ) )         view-as alert-box information.     end.     else do:       if v-one-db <> true then do:         assign           v-rid-list-new = v-rid-list-new + (if v-rid-list-new = "":U then "":U else chr(44)) + entry( v-ind, v-rid-list )         .       end.       assign         v-db-list = v-db-list + (if v-db-list = "":U then "":U else chr(44)) + string( buf_db.db-num )       .     end.   end.   assign     v-rid-list = v-rid-list-new   .   run refresh-brws in this-procedure     ( input yes ) .
      836     assign
      837       v-num-entries = num-entries( v-db-list )
      838     .
      839     do v-ind = 1 to v-num-entries
      840     :
      841       assign
      842         v-db-num = integer( entry( v-ind, v-db-list ) )
      843       .
      844       if g#db-num = 0 then do:
      845         assign
      846           add-log-file-name = substring( log-file-name, 1, r-index( log-file-name, '.':u) - 1 ) + substitute( "-&1.log", v-db-num )
      847         .
      848       end.
      849       run nws/rcvd-nws.p
      850         ( input parparentproc
      851         , input "take":U
      852         , input v-db-num
      853         , input ?
      854         ) no-error.
      855       if error-status:error then do:
      856         run write-to-log in this-procedure
      857           ( vss-workfile + chr(32)
      858             + substitute( "ERROR!!! Ошибка при приеме пакетов новостей из БД &1", v-db-num ) + chr(10)
      859             + substitute( "&1", error-status:get-message(error-status:num-messages) ) + chr(10)
      860             + substitute( "&1", return-value )
      861           ).
      862       end.
      863       assign
      864         add-log-file-name = ?
      865       .
      866     end.
      867     run refresh-brws in this-procedure
      868       ( input yes
      869       ).
      870   END.
      871   ON CHOOSE OF b-get-pck IN FRAME nws-hand
      872   DO:
      873       assign     v-one-db = false   .   if trim( v-rid-list ) = "":U     and available X_db   then do:     assign       v-rid-list = string( recid ( X_db ) )       v-one-db   = true     .    end.   if trim( v-rid-list ) = "":U then do:     message       "Не выбрана БД."       view-as alert-box information.     return no-apply.   end.   assign     v-num-entries = num-entries( v-rid-list)     v-rid-list-new = "":U     v-db-list = "":U   .   do v-ind = 1 to v-num-entries   :     find first buf_db no-lock       where recid( buf_db ) = integer( entry( v-ind, v-rid-list ) )       no-error .     if not available buf_db then do:       message         substitute( "БД &1 удалена.", integer( entry( v-ind, v-rid-list ) ) )         view-as alert-box information.     end.     else do:       if v-one-db <> true then do:         assign           v-rid-list-new = v-rid-list-new + (if v-rid-list-new = "":U then "":U else chr(44)) + entry( v-ind, v-rid-list )         .       end.       assign         v-db-list = v-db-list + (if v-db-list = "":U then "":U else chr(44)) + string( buf_db.db-num )       .     end.   end.   assign     v-rid-list = v-rid-list-new   .   run refresh-brws in this-procedure     ( input yes ) .
      874     assign
      875       v-num-entries = num-entries( v-db-list )
      876     .
      877     do v-ind = 1 to v-num-entries
      878     :
      879       assign
      880         v-db-num = integer( entry( v-ind, v-db-list ) )
      881       .
      882       if g#db-num = 0 then do:
      883         assign
      884           add-log-file-name = substring( log-file-name, 1, r-index( log-file-name, '.':u) - 1 ) + substitute( "-&1.log", v-db-num )
      885         .
      886       end.
      887       run nws/rcvd-nws.p
      888        ( input parparentproc
      889        , input "take+analys":U
      890        , input v-db-num
      891        , input ?
      892        ) no-error.
      893       if error-status:error then do:
      894         run write-to-log in this-procedure
      895           ( vss-workfile + chr(32)
      896             + substitute( "ERROR!!! Ошибка при приеме и(или) разборе пакетов новостей из БД &1", v-db-num ) + chr(10)
      897             + substitute( "&1", error-status:get-message(error-status:num-messages) ) + chr(10)
      898             + substitute( "&1", return-value )
      899           ).
      900       end.
      901       assign
      902         add-log-file-name = ?
      903       .
      904     end.
      905     run refresh-brws in this-procedure
      906       ( input yes
      907       ).
      908   END.
      909   ON CHOOSE OF b-info-all IN FRAME nws-hand
      910   DO:
      911     if not available X_db then do:     message       "Не выбрана БД."       view-as alert-box information.     return no-apply.   end.   find first buf_db no-lock     where buf_db.db-num = X_db.db-num     no-error .   if not available buf_db then do:     message       substitute( "БД &1 удалена.", X_db.db-num )       view-as alert-box information.     run refresh-brws in this-procedure       ( input yes ) .     return no-apply .   end.
      912     run nws/packsinf.w
      913       ( input X_db.db-num
      914       ).
      915     run refresh-brws in this-procedure
      916       ( input yes
      917       ).
      918   END.
      919   ON CHOOSE OF b-mark IN FRAME nws-hand
      920   DO:
      921     define variable loc#log as logical no-undo .
      922     if available X_db then do:
      923   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      924   define variable v-str-recid7 as character no-undo .
      925   define variable v-num-entry7 as integer   no-undo .
      926   assign
      927     v-str-recid7 = trim( string( recid( X_db ) , "->>>>>>>>>>>9":U ) )
      928     v-num-entry7 = lookup( v-str-recid7 , v-rid-list )
      929   .
      930   if v-num-entry7 > 0 then do:
      931     assign
      932       entry( v-num-entry7, v-rid-list ) = "":U
      933       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
      934     .
      935   end.
      936   else do:
      937     assign
      938       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid7
      939     .
      940   end.
      941       loc#log = br-db:refresh() .
      942       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
      943           loc#log = br-db:select-next-row ().
      944           apply "VALUE-CHANGED" to br-db in frame nws-hand.
      945       end.
      946       if num-entries( v-rid-list ) = 0 then do:
      947         hide mark-num in frame nws-hand.
      948       end.
      949       else do:
      950         display
      951           num-entries( v-rid-list ) @ mark-num
      952           with frame nws-hand.
      953       end.
      954     end.
      955     apply "entry" to br-db in frame nws-hand.
      956   END.
      957   ON CHOOSE OF b-proc-pck IN FRAME nws-hand
      958   DO:
      959     assign     v-one-db = false   .   if trim( v-rid-list ) = "":U     and available X_db   then do:     assign       v-rid-list = string( recid ( X_db ) )       v-one-db   = true     .    end.   if trim( v-rid-list ) = "":U then do:     message       "Не выбрана БД."       view-as alert-box information.     return no-apply.   end.   assign     v-num-entries = num-entries( v-rid-list)     v-rid-list-new = "":U     v-db-list = "":U   .   do v-ind = 1 to v-num-entries   :     find first buf_db no-lock       where recid( buf_db ) = integer( entry( v-ind, v-rid-list ) )       no-error .     if not available buf_db then do:       message         substitute( "БД &1 удалена.", integer( entry( v-ind, v-rid-list ) ) )         view-as alert-box information.     end.     else do:       if v-one-db <> true then do:         assign           v-rid-list-new = v-rid-list-new + (if v-rid-list-new = "":U then "":U else chr(44)) + entry( v-ind, v-rid-list )         .       end.       assign         v-db-list = v-db-list + (if v-db-list = "":U then "":U else chr(44)) + string( buf_db.db-num )       .     end.   end.   assign     v-rid-list = v-rid-list-new   .   run refresh-brws in this-procedure     ( input yes ) .
      960     assign
      961       v-num-entries = num-entries( v-db-list )
      962     .
      963     do v-ind = 1 to v-num-entries
      964     :
      965       assign
      966         v-db-num = integer( entry( v-ind, v-db-list ) )
      967       .
      968       if g#db-num = 0 then do:
      969         assign
      970           add-log-file-name = substring( log-file-name, 1, r-index( log-file-name, '.':u) - 1 ) + substitute( "-&1.log", v-db-num )
      971         .
      972       end.
      973       run nws/rcvd-nws.p
      974         ( input parparentproc
      975         , input "analys":U
      976         , input v-db-num
      977         , input ?
      978         ) no-error.
      979       if error-status:error then do:
      980         run write-to-log in this-procedure
      981           ( vss-workfile + chr(32)
      982             + substitute( "ERROR!!! Ошибка при разборе пакетов новостей из БД &1", v-db-num ) + chr(10)
      983             + substitute( "&1", error-status:get-message(error-status:num-messages) ) + chr(10)
      984             + substitute( "&1", return-value )
      985           ) .
      986       end.
      987       assign
      988         add-log-file-name = ?
      989       .
      990     end.
      991     run refresh-brws in this-procedure
      992       ( input yes
      993       ).
      994   END.
      995   ON CHOOSE OF b-send IN FRAME nws-hand
      996   DO:
      997       if not available X_db then do:     message       "Не выбрана БД."       view-as alert-box information.     return no-apply.   end.   find first buf_db no-lock     where buf_db.db-num = X_db.db-num     no-error .   if not available buf_db then do:     message       substitute( "БД &1 удалена.", X_db.db-num )       view-as alert-box information.     run refresh-brws in this-procedure       ( input yes ) .     return no-apply .   end.
      998       if not available X_pck-sent THEN do:
      999           message "Не выбран пакет для отправки." view-as alert-box .
     1000           return no-apply.
     1001       end.
     1002       if X_pck-sent.rcvd = no then do:
     1003         if g#db-num = 0 then do:
     1004           assign
     1005             add-log-file-name = substring( log-file-name, 1, r-index( log-file-name, '.':u) - 1 ) + substitute( "-&1.log", X_db.db-num )
     1006           .
     1007         end.
     1008         run nws/send-nws.p
     1009           ( input parparentproc
     1010           , input "one-pack":U
     1011           , input X_db.db-num
     1012           , input X_pck-sent.pack-num
     1013           ) no-error.
     1014         if error-status:error then do:
     1015           run write-to-log in this-procedure
     1016             ( vss-workfile + chr(32)
     1017               + substitute( "ERROR!!! Ошибка при отправке одного пакета новостей в БД &1", X_db.db-num ) + chr(10)
     1018               + substitute( "&1", error-status:get-message(error-status:num-messages) ) + chr(10)
     1019               + substitute( "&1", return-value )
     1020             ) .
     1021         end.
     1022         assign
     1023           add-log-file-name = ?
     1024         .
     1025         run refresh-brws in this-procedure
     1026           ( input yes
     1027           ).
     1028       end.
     1029       else do:
     1030         message
     1031           vss-workfile vss-revision vss-description skip
     1032           substitute( "Отправить пакет &1 нельзя.", X_pck-sent.pack-num ) skip
     1033           substitute( "Получено подтверждение о его приеме." )
     1034           view-as alert-box information
     1035         .
     1036       end.
     1037   END.
     1038   ON CHOOSE OF b-send-all IN FRAME nws-hand
     1039   DO:
     1040     assign     v-one-db = false   .   if trim( v-rid-list ) = "":U     and available X_db   then do:     assign       v-rid-list = string( recid ( X_db ) )       v-one-db   = true     .    end.   if trim( v-rid-list ) = "":U then do:     message       "Не выбрана БД."       view-as alert-box information.     return no-apply.   end.   assign     v-num-entries = num-entries( v-rid-list)     v-rid-list-new = "":U     v-db-list = "":U   .   do v-ind = 1 to v-num-entries   :     find first buf_db no-lock       where recid( buf_db ) = integer( entry( v-ind, v-rid-list ) )       no-error .     if not available buf_db then do:       message         substitute( "БД &1 удалена.", integer( entry( v-ind, v-rid-list ) ) )         view-as alert-box information.     end.     else do:       if v-one-db <> true then do:         assign           v-rid-list-new = v-rid-list-new + (if v-rid-list-new = "":U then "":U else chr(44)) + entry( v-ind, v-rid-list )         .       end.       assign         v-db-list = v-db-list + (if v-db-list = "":U then "":U else chr(44)) + string( buf_db.db-num )       .     end.   end.   assign     v-rid-list = v-rid-list-new   .   run refresh-brws in this-procedure     ( input yes ) .
     1041     assign
     1042       v-num-entries = num-entries( v-db-list )
     1043     .
     1044     do v-ind = 1 to v-num-entries
     1045     :
     1046       assign
     1047         v-db-num = integer( entry( v-ind, v-db-list ) )
     1048       .
     1049       if g#db-num = 0 then do:
     1050         assign
     1051           add-log-file-name = substring( log-file-name, 1, r-index( log-file-name, '.':u) - 1 ) + substitute( "-&1.log", v-db-num )
     1052         .
     1053       end.
     1054       run nws/send-nws.p
     1055         ( input parparentproc
     1056         , input "all-unconf":U
     1057         , input v-db-num
     1058         , input ?
     1059         ) no-error.
     1060       if error-status:error then do:
     1061         run write-to-log in this-procedure
     1062           ( vss-workfile + chr(32)
     1063             + substitute( "ERROR!!! Ошибка при отправке всех неподтвержденных пакетов новостей в БД &1", v-db-num ) + chr(10)
     1064             + substitute( "&1", error-status:get-message(error-status:num-messages) ) + chr(10)
     1065             + substitute( "&1", return-value )
     1066           ).
     1067       end.
     1068       assign
     1069         add-log-file-name = ?
     1070       .
     1071     end.
     1072     run refresh-brws in this-procedure
     1073       ( input yes
     1074       ).
     1075   END.
     1076   ON CHOOSE OF b-send-new IN FRAME nws-hand
     1077   DO:
     1078     assign     v-one-db = false   .   if trim( v-rid-list ) = "":U     and available X_db   then do:     assign       v-rid-list = string( recid ( X_db ) )       v-one-db   = true     .    end.   if trim( v-rid-list ) = "":U then do:     message       "Не выбрана БД."       view-as alert-box information.     return no-apply.   end.   assign     v-num-entries = num-entries( v-rid-list)     v-rid-list-new = "":U     v-db-list = "":U   .   do v-ind = 1 to v-num-entries   :     find first buf_db no-lock       where recid( buf_db ) = integer( entry( v-ind, v-rid-list ) )       no-error .     if not available buf_db then do:       message         substitute( "БД &1 удалена.", integer( entry( v-ind, v-rid-list ) ) )         view-as alert-box information.     end.     else do:       if v-one-db <> true then do:         assign           v-rid-list-new = v-rid-list-new + (if v-rid-list-new = "":U then "":U else chr(44)) + entry( v-ind, v-rid-list )         .       end.       assign         v-db-list = v-db-list + (if v-db-list = "":U then "":U else chr(44)) + string( buf_db.db-num )       .     end.   end.   assign     v-rid-list = v-rid-list-new   .   run refresh-brws in this-procedure     ( input yes ) .
     1079     assign
     1080       v-num-entries = num-entries( v-db-list )
     1081     .
     1082     do v-ind = 1 to v-num-entries
     1083     :
     1084       assign
     1085         v-db-num = integer( entry( v-ind, v-db-list ) )
     1086       .
     1087       if g#db-num = 0 then do:
     1088         assign
     1089           add-log-file-name = substring( log-file-name, 1, r-index( log-file-name, '.':u) - 1 ) + substitute( "-&1.log", v-db-num )
     1090         .
     1091       end.
     1092       run nws/send-nws.p
     1093         ( input parparentproc
     1094         , input "all":U
     1095         , input v-db-num
