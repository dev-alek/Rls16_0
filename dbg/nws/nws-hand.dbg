     1113   ON CHOOSE OF b-unsend IN FRAME nws-hand
     1114   DO:
     1115     if not available X_db then do:     message       "Не выбрана БД."       view-as alert-box information.     return no-apply.   end.   find first buf_db no-lock     where buf_db.db-num = X_db.db-num     no-error .   if not available buf_db then do:     message       substitute( "БД &1 удалена.", X_db.db-num )       view-as alert-box information.     run refresh-brws in this-procedure       ( input yes ) .     return no-apply .   end.
     1116     run nws/v-route.w
     1117       ( input parparentproc
     1118       , input X_db.db-num
     1119       ).
     1120   END.
     1121   ON VALUE-CHANGED OF br-db IN FRAME nws-hand
     1122   DO:
     1123     run refresh-brws in this-procedure
     1124       ( input no
     1125       ).
     1126   END.
     1127   ON CHOOSE OF bt-not-sel-all IN FRAME nws-hand
     1128   DO:
     1129     define variable loc#log as logical no-undo .
     1130     if available X_db then do:
     1131       v-rid-list = "" .
     1132       for each X_db where X_db.db-num <> 0 :
     1133   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1134   define variable v-str-recid9 as character no-undo .
     1135   define variable v-num-entry9 as integer   no-undo .
     1136   assign
     1137     v-str-recid9 = trim( string( recid( X_db ) , "->>>>>>>>>>>9":U ) )
     1138     v-num-entry9 = lookup( v-str-recid9 , v-rid-list )
     1139   .
     1140   if v-num-entry9 > 0 then do:
     1141     assign
     1142       entry( v-num-entry9, v-rid-list ) = "":U
     1143       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1144     .
     1145   end.
     1146   else do:
     1147     assign
     1148       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid9
     1149     .
     1150   end.
     1151         loc#log = br-db:refresh() .
     1152       end.
     1153     end.
     1154     if num-entries( v-rid-list ) <> 0 then do:
     1155       display
     1156         num-entries( v-rid-list ) @ mark-num
     1157         with frame nws-hand.
     1158     end.
     1159   END.
     1160   ON CHOOSE OF bt-not-sel-desel-all IN FRAME nws-hand
     1161   DO:
     1162     define variable loc#log as logical no-undo .
     1163     v-rid-list = "" .
     1164     loc#log = br-db:refresh() .
     1165     hide mark-num in frame nws-hand.
     1166   END.
     1167   define variable vss-include-info10 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1168   on INS of frame nws-hand anywhere do:
     1169     if b-mark :sensitive then DO: apply "CHOOSE":U to b-mark in frame nws-hand. END.
     1170     return no-apply.
     1171   end.
     1172   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME nws-hand:PARENT eq ?
     1173   THEN FRAME nws-hand:PARENT = ACTIVE-WINDOW.
     1174   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1175   on help of frame nws-hand
     1176   do:
     1177     run gbl/app_help.p
     1178       (input this-procedure :file-name
     1179       ,input ''
     1180       ,input ?
     1181       ) no-error.
     1182     if error-status :error then do:
     1183       message
     1184         "Ошибка при вызове помощи"
     1185         error-status :get-message(1)
     1186         view-as alert-box .
     1187     end.
     1188   end.
     1189   run minbtn-set in this-procedure .
     1190   on choose of b-help in frame nws-hand
     1191   do:
     1192     apply "help":u to frame nws-hand .
     1193   end.
     1194   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1195   procedure minbtn-set :
     1196       do
     1197           on error undo, return error return-value
     1198           :
     1199           define variable ii              as integer       no-undo .
     1200           define variable fh              as widget-handle no-undo .
     1201           define variable hh              as widget-handle no-undo .
     1202           define variable v-h             as handle        extent 4 no-undo .
     1203           define variable v-name-button   as character     no-undo .
     1204           define variable v-help-old-x    as decimal       no-undo .
     1205           define variable v-help-old-y    as decimal       no-undo .
     1206           define variable v-help-old-size as decimal       no-undo .
     1207           define variable v-frame-width   as decimal       no-undo .
     1208           define variable jj              as integer       no-undo .
     1209           do
     1210               on error undo, return error
     1211               :
     1212               assign
     1213                   v-frame-width = frame nws-hand:width - 0.3
     1214                   fh            = frame nws-hand:first-child
     1215                   hh            = fh:first-child
     1216                   ii            = 1
     1217                   .
     1218               do while valid-handle(hh):
     1219                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1220                   do:
     1221                       case lc(hh:name) :
     1222                           when "b-help" then
     1223                               do:
     1224                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1225                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1226                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1227                                   hh:TOOLTIP = "Помощь" .
     1228                                   v-help-old-x = hh:column .
     1229                                   v-help-old-y = hh:row    .
     1230                                   v-help-old-size = hh:width .
     1231                                   hh:width-chars = 2.5 .
     1232                               end.
     1233                           when "b-print" then
     1234                               do:
     1235                                   hh:load-image("cmp/b-print.bmp":u) .
     1236                                   hh:TOOLTIP = "Печать" .
     1237                                   v-h[ii] = hh:handle .
     1238                                   ii = ii + 1 .
     1239                                   hh:width-chars = 3 .
     1240                               end.
     1241                           when "b-history" or
     1242                           when "b-hist" then
     1243                               do:
     1244                                   hh:load-image("cmp/b-hist.bmp":u) .
     1245                                   hh:TOOLTIP = "История" .
     1246                                   v-h[ii] = hh:handle .
     1247                                   ii = ii + 1 .
     1248                                   hh:width-chars = 3 .
     1249                               end.
     1250                           when "b-sch" then
     1251                               do:
     1252                                   hh:load-image("cmp/b-sch.bmp":u) .
     1253                                   hh:TOOLTIP = "Установка Фильтра" .
     1254                                   v-h[ii] = hh:handle .
     1255                                   ii = ii + 1 .
     1256                                   hh:width-chars = 3 .
     1257                               end.
     1258                           when "b-hist-user" then
     1259                               do:
     1260                                   hh:load-image("cmp/b-hist.bmp":u) .
     1261                                   hh:TOOLTIP = "История пользователя" .
     1262                                   ii = ii + 1 .
     1263                               end.
     1264                       end case.
     1265                   end.
     1266                   hh = hh:next-sibling.
     1267               end.
     1268               b-help:column = v-frame-width - b-help:width-chars.
     1269               jj = 0.
     1270               repeat ii = 4 to 1 by -1 :
     1271                   if valid-handle (v-h[ii] ) then
     1272                   do:
     1273                       jj  = jj + 1 .
     1274                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1275                       v-h[ii]:row    = v-help-old-y .
     1276                   end.
     1277               end.
     1278           end.
     1279       end.
     1280   end procedure.
     1281   MAIN-BLOCK:
     1282   DO
     1283   ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1284   ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1285   :
     1286     run gbl/set-gbl.p
     1287       ( input false
     1288        ,input p-user-login
     1289        ,input p-user-password
     1290       ) no-error.
     1291     if error-status:error then do:
     1292       return error substitute( "&1. Ошибка при инициализации переменных g#...&2&3"
     1293                                ,vss-workfile
     1294                                ,chr(10)
     1295                                ,error-status:get-message(error-status:num-messages)
     1296                              ).
     1297     end.
     1298     assign
     1299       hand-log-msg-h = news-log:handle
     1300       g#news = true
     1301     .
     1302     define variable mDBInfo as character no-undo.
     1303     run adm/db-info.p
     1304       ( output v-cur-db-num
     1305       , output mDBInfo
     1306       ) no-error .
     1307     if error-status:error then do:
     1308       return error substitute( "&1. &2&3&4"
     1309                                ,vss-workfile
     1310                                ,mDBInfo
     1311                                ,chr(10)
     1312                                ,error-status:get-message(error-status:num-messages)
     1313                               ).
     1314     end.
     1315     assign
     1316       frame nws-hand:title = "СПН" + chr(32) + mDBInfo
     1317       browse br-db :num-locked-columns = 1
     1318     .
     1319     RUN enable_UI.
     1320     run refresh-brws in this-procedure
     1321       ( input no
     1322       ).
     1323     do
     1324     on ERROR  undo, leave
     1325     on ENDKEY undo, leave
     1326     on STOP   undo, retry
     1327     :
     1328       wait-for go of frame nws-hand.
     1329     end.
     1330   END.
     1331   RUN disable_UI.
     1332   PROCEDURE disable_UI :
     1333     HIDE FRAME nws-hand.
     1334   END PROCEDURE.
     1335   PROCEDURE enable_UI :
     1336     DISPLAY news-log mark-num f-not-rcvd
     1337         WITH FRAME nws-hand.
     1338     ENABLE RECT-3 b-exit b-get-pck b-create b-sync b-send-new b-info-all b-help b-mark
     1339            b-get b-proc-pck b-send b-send-all b-unsend br-db br-pck-sent
     1340            br-pck-rcvd news-log mark-num bt-not-sel-all bt-not-sel-desel-all
     1341         WITH FRAME nws-hand.
     1342     if v-cur-db-num <> 0 then do :
     1343       disable bt-not-sel-all bt-not-sel-desel-all
     1344         WITH FRAME nws-hand.
     1345     end.
     1346     if g#db-num = 0 then     OPEN QUERY br-db FOR EACH X_db where X_db.db-num > 0 NO-LOCK INDEXED-REPOSITION. else     OPEN QUERY br-db FOR EACH X_db where X_db.db-num = 0 NO-LOCK INDEXED-REPOSITION.
     1347   END PROCEDURE.
     1348   PROCEDURE refresh-brws :
     1349     define input parameter p-with-db as logical no-undo .
     1350     define variable v-rowid as rowid no-undo .
     1351     define buffer buf_pck-sent for ub.pck-sent .
     1352     assign
     1353       v-rowid = ?
     1354     .
     1355     if p-with-db = true then do:
     1356       if available X_db then do:
     1357         assign
     1358           v-rowid = rowid( X_db )
     1359           log-res = browse br-db :set-repositioned-row( browse br-db :focused-row, 'CONDITIONAL':u)
     1360         .
     1361       end.
     1362       if g#db-num = 0 then     OPEN QUERY br-db FOR EACH X_db where X_db.db-num > 0 NO-LOCK INDEXED-REPOSITION. else     OPEN QUERY br-db FOR EACH X_db where X_db.db-num = 0 NO-LOCK INDEXED-REPOSITION.
     1363       reposition br-db to rowid v-rowid no-error .
     1364     end.
     1365     OPEN QUERY br-pck-rcvd FOR EACH X_pck-rcvd       WHERE X_pck-rcvd.db-num = X_db.db-num  NO-LOCK     BY X_pck-rcvd.db-num DESCENDING        BY X_pck-rcvd.pack-num DESCENDING INDEXED-REPOSITION.
     1366     OPEN QUERY br-pck-sent FOR EACH X_pck-sent       WHERE X_pck-sent.db-num = X_db.db-num NO-LOCK     BY X_pck-sent.db-num DESCENDING        BY X_pck-sent.pack-num DESCENDING INDEXED-REPOSITION.
     1367     if available X_pck-sent then do:
     1368       assign
     1369         log-res = browse br-pck-sent :select-row( 1 )
     1370       .
     1371     end.
     1372     if available X_pck-rcvd then do:
     1373       assign
     1374         log-res = browse br-pck-rcvd :select-row( 1 )
     1375       .
     1376     end.
     1377     assign
     1378       f-not-rcvd = 0
     1379     .
     1380     for each buf_pck-sent no-lock
     1381       where buf_pck-sent.db-num = X_db.db-num
     1382         and buf_pck-sent.rcvd   = false
     1383     on error undo, return error
     1384     :
     1385       assign
     1386         f-not-rcvd = f-not-rcvd + 1
     1387         f-not-rcvd :screen-value in frame nws-hand = string( f-not-rcvd, f-not-rcvd :format in frame nws-hand)
     1388       .
     1389     end.
     1390     if f-not-rcvd > 10 then do:
     1391       assign
     1392         f-not-rcvd:fgcolor = RED_COLOR
     1393       .
     1394     end.
     1395     else do:
     1396       assign
     1397         f-not-rcvd:fgcolor = ?
     1398       .
     1399     end.
     1400     display f-not-rcvd with frame nws-hand.
     1401     if num-entries( v-rid-list ) = 0 then do:
     1402       hide mark-num in frame nws-hand.
     1403     end.
     1404     else do:
     1405       display
     1406         num-entries( v-rid-list ) @ mark-num
     1407         with frame nws-hand.
     1408     end.
     1409   END PROCEDURE.
     1410   FUNCTION get-turn-on RETURNS LOGICAL
     1411     ( INPUT v-db-key AS CHARACTER ) :
     1412     RETURN (v-db-key <> "":U AND v-db-key <> ? ).
     1413   END FUNCTION.
