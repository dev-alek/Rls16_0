     1097         ) no-error.
     1098       if error-status:error then do:
     1099         run write-to-log( vss-workfile + chr(32)
     1100                           + substitute( "ERROR!!! Ошибка при отправке новостей в БД &1", v-db-num )  + chr(10)
     1101                           + substitute( "&1", error-status:get-message(error-status:num-messages) ) + chr(10)
     1102                           + substitute( "&1", return-value )
     1103                         ).
     1104       end.
     1105       assign
