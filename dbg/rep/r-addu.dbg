     1000   procedure lineattr-delete-flora-all :
     1001     do
     1002     on error undo, return error return-value
     1003     :
     1004       define input  parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
     1005       define input  parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
     1006       define input  parameter p-prt-code    as integer   no-undo .
     1007       define buffer buf_doc-line-attr for ub.doc-line-attr .
     1008       for each buf_doc-line-attr exclusive-lock
     1009         where buf_doc-line-attr.doc-code  = p-doc-code
     1010           and buf_doc-line-attr.gds-code  = p-gds-code
     1011           and buf_doc-line-attr.attr-code begins 'fl_gds-code':U + chr(44) + string(p-prt-code)  + chr(44)
     1012        :
     1013         delete buf_doc-line-attr.
     1014       end.
     1015    end.
     1016   end procedure.
