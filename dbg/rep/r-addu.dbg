     1460           Sym4 column-label ":!:" format "X(1)" space(0)
     1461           B-val COLUMN-LABEL "Вал!юта " format "X(3)" space(0)
     1462           sym5 column-label ":!:" format "X(1)" space(0)
     1463           B-val-rate COLUMN-LABEL "Курс ! " format "->>>>>>>9.<<<" space(0)
