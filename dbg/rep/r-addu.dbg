     1197           buf_doc-line-attr.gds-code  = p-gds-code
     1198           buf_doc-line-attr.attr-code = p-code  + chr(4)  + trim(p-part-code)  + chr(4) + trim(p_in-code)
     1199         .
     1200       end.
     1201       assign
     1202         buf_doc-line-attr.attr-value = string( p-value )
