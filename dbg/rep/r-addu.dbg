      975   procedure lineattr-delete-flora-gds :
      976     do
      977     on error undo, return error return-value
      978     :
      979       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      980       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      981       define input  parameter p-prt-code    as integer   no-undo .
      982       define input parameter p-bk-gds-code like ub.doc-line-attr.gds-code   no-undo .
      983       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
      984       define output parameter p-deleted  as logical no-undo.
      985       define buffer buf_doc-line-attr for ub.doc-line-attr .
      986       find first buf_doc-line-attr exclusive-lock
      987         where buf_doc-line-attr.doc-code  = p-doc-code
      988           and buf_doc-line-attr.gds-code  = p-gds-code
      989           and buf_doc-line-attr.attr-code = p-code + chr(44) + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
      990         no-error NO-WAIT.
