     1206   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1207   FUNCTION alg-name RETURNS CHARACTER
     1208     ( buffer loc-table for ub.gds-add-charges ) :
     1209   if not available  loc-table  then return "678" .
     1210   if loc-table.cost-include = no then return "".
     1211   case loc-table.algoritm :
     1212     when "1" then do:
     1213       return "сумме приходных цен".
     1214     end.
     1215     when "2" then do:
     1216       return "количеству(в баз. ед.изм.)".
     1217     end.
     1218     when "3" then do:
     1219       return "количеству(в пост. ед.изм.)" .
     1220     end.
     1221     when "4" then do:
     1222       return "весу".
     1223     end.
     1224   end case.
     1225   END FUNCTION.
     1226   define variable base-abbr    as character no-undo .
     1227   define variable v-exch-code  as integer   no-undo .
     1228   define variable v-exch-rate  as integer   no-undo .
     1229   define variable v-exch-scale as decimal   no-undo .
     1230   define variable v-sum-cli    as decimal   no-undo .
     1231   define variable v-sum-vat    as decimal   no-undo .
     1232   define variable base-type as character no-undo .
     1233   define variable base-code as integer   no-undo .
     1234   define variable g#report-num as integer   no-undo .
     1235   define variable g#gds-engl as logical   no-undo .
     1236   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1237     run mainmenu_getcntxt in parparentproc
     1238       (output v-cntxt-db-num
     1239       ,output v-cntxt-userid
     1240       ,output v-cntxt-level
     1241       ,output v-cntxt-host-code-obj
     1242       ,output v-cntxt-obj-type
     1243       ,output v-cntxt-obj-code
     1244       ,output v-cntxt-db-num-obj
     1245       ,output v-cntxt-is-admin
     1246       ) .
     1247   define variable v-cntxt-host-name-obj as character no-undo .
     1248   define buffer buf_rep_currency for ub.currency.
     1249   define buffer buf_clients for ub.clients  .
     1250   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1251   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostname in g#library
     1252     (input  v-cntxt-obj-type
     1253     ,input  v-cntxt-obj-code
     1254     ,output v-cntxt-host-code-obj
     1255     ,output v-cntxt-host-name-obj
     1256     )  .
     1257   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1258   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     1259     (input  v-cntxt-host-code-obj
     1260     ,output base-code
     1261     )  .
     1262   find first buf_rep_currency no-lock
     1263     where buf_rep_currency.curr-code = base-code
     1264     no-error .
     1265     if available buf_rep_currency then base-type = buf_rep_currency.curr-abbr .
     1266                  else base-type = "б.в." .
     1267   run get-report-num in parParentProc ( output g#report-num ).
     1268   run get-gds-engl in parParentProc ( output g#gds-engl ) .
     1269   FUNCTION RedLine RETURNS CHARACTER ( INPUT i-str AS CHARACTER ) :
     1270     DEFINE VARIABLE v-str AS CHARACTER NO-UNDO.
     1271     RUN get-red-line IN THIS-PROCEDURE ( INPUT i-str, OUTPUT v-str ) NO-ERROR.
     1272     RETURN ( IF ERROR-STATUS :ERROR THEN i-str ELSE v-str ).
     1273   END FUNCTION.
     1274   PROCEDURE get-red-line :
     1275     DEFINE  INPUT PARAMETER p-str AS CHARACTER NO-UNDO.
     1276     DEFINE OUTPUT PARAMETER p-res AS CHARACTER NO-UNDO.
     1277     DO ON ERROR UNDO, RETURN ERROR :
     1278       ASSIGN p-res = CAPS( SUBSTRING( p-str, 1, 1 ) ) + LC( SUBSTRING( p-str, 2 ) ).
     1279     END.
     1280   END PROCEDURE.
     1281   FUNCTION get-decade-word RETURNS CHARACTER ( INPUT i-dec AS INTEGER, INPUT i-num AS INTEGER ) :
     1282     DEFINE VARIABLE v-grade AS CHARACTER NO-UNDO.
     1283     RUN get-number-grade IN THIS-PROCEDURE ( INPUT i-dec, INPUT i-num, OUTPUT v-grade ) NO-ERROR.
     1284     RETURN ( IF ERROR-STATUS :ERROR THEN "":U ELSE v-grade ).
     1285   END FUNCTION.
     1286   FUNCTION Word-Sum RETURNS CHARACTER ( INPUT i-sum AS DECIMAL ) :
     1287     DEFINE VARIABLE OutSum AS CHARACTER NO-UNDO.
     1288     RUN conv-sum-to-word IN THIS-PROCEDURE ( INPUT i-sum, OUTPUT OutSum ) NO-ERROR.
     1289     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE OutSum ).
     1290   END FUNCTION.
     1291   PROCEDURE get-number-grade :
     1292     DEFINE  INPUT PARAMETER p-dec AS INTEGER   NO-UNDO.
     1293     DEFINE  INPUT PARAMETER p-num AS INTEGER   NO-UNDO.
     1294     DEFINE OUTPUT PARAMETER p-res AS CHARACTER NO-UNDO.
     1295     DEFINE VARIABLE v-list AS CHARACTER NO-UNDO.
     1296     DO ON ERROR UNDO, RETURN ERROR :
     1297       IF      p-dec = 1 THEN DO: ASSIGN v-list = ",один,два,три,четыре,пять,шесть,семь,восемь,девять".    END.
     1298       ELSE IF p-dec = 2 THEN DO: ASSIGN v-list = "десять,одиннадцать,двенадцать,тринадцать,четырнадцать,пятнадцать,шестнадцать,семнадцать,восемнадцать,девятнадцать".    END.
     1299       ELSE IF p-dec = 3 THEN DO: ASSIGN v-list = ",,двадцать,тридцать,сорок,пятьдесят,шестьдесят,семьдесят,восемьдесят,девяносто".   END.
     1300       ELSE IF p-dec = 4 THEN DO: ASSIGN v-list = ",сто,двести,триста,четыреста,пятьсот,шестьсот,семьсот,восемьсот,девятьсот".  END.
     1301                         ELSE DO: ASSIGN v-list = ",,,,,,,,,". END.
     1302       ASSIGN p-res = ENTRY( p-num + 1, v-list ).
     1303     END.
     1304   END PROCEDURE.
     1305   PROCEDURE conv-sum-to-word :
     1306     DEFINE  INPUT PARAMETER p-sum AS DECIMAL   NO-UNDO.
     1307     DEFINE OUTPUT PARAMETER p-res AS CHARACTER NO-UNDO.
     1308     DEFINE VARIABLE Formatted  AS CHARACTER NO-UNDO.
     1309     DEFINE VARIABLE Word       AS CHARACTER NO-UNDO.
     1310     DEFINE VARIABLE OutSum     AS CHARACTER NO-UNDO.
     1311     DEFINE VARIABLE jj         AS INTEGER   NO-UNDO.
     1312     DO ON ERROR UNDO, RETURN ERROR :
     1313       ASSIGN Formatted = STRING( ABS( p-sum ), "999999999999999.99":U ) NO-ERROR.
     1314       IF ERROR-STATUS :ERROR THEN DO:
     1315         ASSIGN p-res = ?.
     1316         UNDO, RETURN ERROR.
     1317       END.
     1318       DO jj = ( LENGTH( Formatted ) - 3 ) TO 3 BY -3 :
     1319         IF SUBSTRING( Formatted, jj - 2, 3 ) = "000" THEN DO: NEXT. END.
     1320         IF jj < 15 THEN DO:
     1321           ASSIGN Word = ENTRY( jj, ",,триллион,,,миллиард,,,миллион,,,тысяч" ).
     1322           IF SUBSTRING( Formatted, jj,     1 )  = "1" AND
     1323              SUBSTRING( Formatted, jj - 1, 1 ) <> "1" AND jj = 12 THEN DO: ASSIGN Word = TRIM( Word ) + "а". END.
     1324           IF SUBSTRING( Formatted, jj, 1 ) = "2" OR
     1325              SUBSTRING( Formatted, jj, 1 ) = "3" OR
     1326              SUBSTRING( Formatted, jj, 1 ) = "4" THEN DO:
     1327             IF jj = 12 THEN DO:
     1328               IF SUBSTRING( Formatted, jj - 1, 1 ) <> "1" THEN DO: ASSIGN Word = TRIM( Word ) + "и". END.
     1329             END.       ELSE DO:
     1330               IF SUBSTRING( Formatted, jj - 1, 1 ) <> "1" THEN DO: ASSIGN Word = TRIM( Word ) + "а". END.
     1331             END.
     1332           END.
     1333           IF ( SUBSTRING( Formatted, jj,     1 ) <> "1" AND
     1334                SUBSTRING( Formatted, jj,     1 ) <> "2" AND
     1335                SUBSTRING( Formatted, jj,     1 ) <> "3" AND
     1336                SUBSTRING( Formatted, jj,     1 ) <> "4" AND jj <> 12 ) OR
     1337              ( SUBSTRING( Formatted, jj - 1, 1 )  = "1" AND jj <  12 ) THEN DO: ASSIGN Word = TRIM( Word ) + "ов". END.
     1338           IF Word <> "":U THEN DO: ASSIGN OutSum = TRIM( Word ) + " ":U + TRIM( OutSum ). END.
     1339         END.
     1340         IF SUBSTRING( Formatted, jj - 1, 1 ) <> "1" THEN DO:
     1341           IF      jj = 12 AND SUBSTRING( Formatted, jj, 1 ) = "1" THEN DO: ASSIGN Word = "одна". END.
     1342           ELSE IF jj = 12 AND SUBSTRING( Formatted, jj, 1 ) = "2" THEN DO: ASSIGN Word = "две".  END.
     1343           ELSE DO: ASSIGN Word = get-decade-word( 1, INTEGER( SUBSTRING( Formatted, jj, 1 ) ) ). END.
     1344           IF Word <> "":U THEN DO: ASSIGN OutSum = TRIM( Word ) + " ":U + TRIM( OutSum ). END.
     1345           ASSIGN Word = get-decade-word( 3, INTEGER( SUBSTRING( Formatted, jj - 1, 1 ) ) ).
     1346         END.                                        ELSE DO:
     1347           ASSIGN Word = get-decade-word( 2, INTEGER( SUBSTRING( Formatted, jj,     1 ) ) ).
     1348         END.
     1349         IF Word <> "":U THEN DO: ASSIGN OutSum = TRIM( Word ) + " ":U + TRIM( OutSum ). END.
     1350         ASSIGN Word = get-decade-word( 4, INTEGER( SUBSTRING( Formatted, jj - 2, 1 ) ) ).
     1351         IF Word <> "":U THEN DO: ASSIGN OutSum = TRIM( Word ) + " ":U + TRIM( OutSum ). END.
     1352       END.
     1353       ASSIGN OutSum = CAPS( SUBSTRING( OutSum, 1, 1 ) ) + SUBSTRING( OutSum, 2 ).
     1354       IF OutSum = "":U AND TRUNCATE( p-sum, 0 ) = 0 THEN DO: ASSIGN OutSum = "Ноль". END.
     1355       ASSIGN p-res = TRIM( OutSum ).
     1356     END.
     1357   END PROCEDURE.
     1358   FUNCTION Total-Word RETURNS CHARACTER ( INPUT i-sum AS DECIMAL, INPUT i-curr AS CHARACTER, INPUT i-part AS CHARACTER ) :
     1359     DEFINE VARIABLE word_sum AS CHARACTER NO-UNDO.
     1360     RUN get-total-word IN THIS-PROCEDURE ( INPUT i-sum, INPUT i-curr, INPUT i-part, OUTPUT word_sum ) NO-ERROR.
     1361     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE word_sum ).
     1362   END FUNCTION.
     1363   PROCEDURE get-total-word :
     1364     DEFINE  INPUT PARAMETER p-sum  AS DECIMAL   NO-UNDO.
     1365     DEFINE  INPUT PARAMETER p-curr AS CHARACTER NO-UNDO.
     1366     DEFINE  INPUT PARAMETER p-part AS CHARACTER NO-UNDO.
     1367     DEFINE OUTPUT PARAMETER p-word AS CHARACTER NO-UNDO.
     1368     DO ON ERROR UNDO, RETURN ERROR :
     1369       ASSIGN p-word = Word-Sum( p-sum ).
     1370                  ASSIGN p-word = ( IF p-sum < 0 THEN "- " ELSE "":U ) + TRIM(
     1371                         RedLine( p-word )
     1372                  ) +
     1373                         " ":U + p-curr + " ":U +
     1374                         SUBSTRING( STRING( ABS( p-sum ), "999999999999999999999999999999.99" ), 32, 2 ) +
     1375                         " ":U + p-part + ".".
     1376                           END.
     1377   END PROCEDURE.
     1378   DEFINE  SHARED VARIABLE Sort-gr AS LOGICAL
