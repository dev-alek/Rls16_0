      399   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      400   define variable v-waitfram-action01         as character   no-undo .
      401   define variable v-waitfram-action02         as character   no-undo .
      402   define variable v-waitfram-action03         as character   no-undo .
      403   define variable mWaitFramTextBeg            as character   no-undo.
      404   define variable mWaitFramTextEnd            as character   no-undo.
      405   define variable mWaitFramView               as logical     no-undo.
      406   define variable mWaitProcEvent              as logical     no-undo init yes.
      407   define variable mWaitFramInterval           as integer     no-undo init 1 .
      408   define variable mWaitFramStop               as logical     no-undo.
      409   define variable mWaitFramStopUser           as logical     no-undo.
      410   define variable mWaitFramStopTimeOut        as logical     no-undo.
      411   define variable mWaitFramStartProc          as datetime-tz no-undo.
      412   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      413   define button B-WaitFramStop auto-end-key
      414        label "Стоп"
      415        size 10 by 1 tooltip "Остоновить процесс".
      416   define button B-viewProcInfo
      417        label "Информация"
      418        size 15 by 1 tooltip "Информация о процесс".
      419   define frame waitfram
      420     v-waitfram-action01 format "x(72)" no-label skip
      421     v-waitfram-action02 format "x(72)" no-label skip
      422     v-waitfram-action03 format "x(72)" no-label skip
      423     B-viewProcInfo
      424     B-WaitFramStop at row 4 col 30
      425     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      426     .
      427   define new global shared variable mBatchMode as logical no-undo init ?.
      428   define variable mFramBachModHandle as handle no-undo.
      429   mFramBachModHandle = frame waitfram:handle.
      430   define variable mFameOldVis as logical no-undo.
      431   define variable mVisCUrentVin as logical no-undo.
      432   if session:batch-mode
      433   then
      434      mBatchMode = yes.
      435   if mBatchMode = ? then do:
      436     mVisCUrentVin = current-window:visible.
      437     mFameOldVis = mFramBachModHandle:visible.
      438     mFramBachModHandle:visible  = yes.
      439     mBatchMode = mFramBachModHandle:visible ne yes.
      440     mFramBachModHandle:visible = mFameOldVis.
      441     current-window:visible = mVisCUrentVin.
      442   end.
      443    if  log-manager:logfile-name ne ?
      444     then DO:
      445         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      446         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      447         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      448     end.
      449   on choose of B-WaitFramStop in frame waitfram
      450   do:
      451     mWaitFramStop = yes.
      452     mWaitFramStopUser = yes.
      453   end.
      454   function waitfram-check-timeout returns logical():
      455      define variable vtime as int64 no-undo.
      456      if mWaitFramStopTimeOut
      457      then
      458         return yes.
      459      vtime = ( now - mWaitFramStartProc ) / 1000 .
      460      if     mWaitFramTimeOut ne ?
      461         and mWaitFramTimeOut ne 0
      462         and mWaitFramTimeOut lt vtime
      463      then do:
      464         mWaitFramStopTimeOut = yes.
      465      end.
      466      return mWaitFramStopTimeOut.
      467   end.
      468   procedure waitfram-hide :
      469     if not session:batch-mode
      470     then do
      471     on error undo, return error return-value
      472     :
      473       pause 0 before-hide .
      474       if not mBatchMode then
      475         hide frame waitfram .
      476     if     not mWaitFramView
      477        and mWaitProcEvent
      478     then
      479       process events .
      480     end.
      481   end procedure.
      482   procedure waitfram-show :
      483     define input  parameter p-message as character no-undo .
      484     define variable v-left-margin as integer   no-undo .
      485     if not session:batch-mode
      486     then do
      487     on error undo, return error return-value
      488     :
      489       if length(p-message) <= 70 then do:
      490         assign
      491           v-left-margin = integer((70 - length(p-message)) / 2)
      492         .
      493         assign
      494           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      495         .
      496         assign
      497           v-waitfram-action01 = " "
      498           v-waitfram-action02 = " "
      499                                    + fill(" ", v-left-margin)
      500                                    + p-message
      501           v-waitfram-action03 = " "
      502         .
      503       end.
      504       else do:
      505         define variable vRindex1 as integer no-undo.
      506         define variable vRindex2 as integer no-undo.
      507         vRindex1 = r-index(p-message," ",70).
      508         if vRindex1 = 0
      509         then
      510            vRindex1 = 70.
      511         if length(p-message)  <= vRindex1 + 70 then do:
      512           assign
      513             v-waitfram-action01 = " "
      514             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      515             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      516           .
      517         end.
      518         else do:
      519           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      520           if vRindex2 <= vRindex1
      521           then
      522              vRindex2 = vRindex1 + 70.
      523           assign
      524             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      525             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      526             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      527           .
      528         end.
      529       end.
      530       B-viewProcInfo:visible   in frame waitfram = no.
      531       B-viewProcInfo:sensitive in frame waitfram = no.
      532       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      533       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      534       if  (   mWaitFramView
      535          or  mWaitProcEvent)
      536          and not mBatchMode
      537       then
      538          display
      539             v-waitfram-action01 skip
      540             v-waitfram-action02 skip
      541             v-waitfram-action03 skip
      542          with frame waitfram .
      543       if     mWaitFramView
      544          then do:
      545             if     mWaitFramInterval ne ?
      546                and not mBatchMode
      547             then
      548                wait-for go of frame waitfram pause mWaitFramInterval.
      549          end.
      550          else
      551             if     mWaitProcEvent
      552                and not mBatchMode
      553             then
      554                process events .
      555     end.
      556   end procedure.
      557      procedure waitfram-show-this:
      558         define input  parameter iInterval as int64 no-undo.
      559         define variable vtime as int64 no-undo.
      560         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      561         mWaitFramInterval = iInterval.
      562         run waitfram-show (substitute("&1&2 &3&4" ,
      563                                       mWaitFramTextBeg ,
      564                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      565                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      566                                       mWaitFramTextEnd
      567                                      )
      568                           ).
      569      end.
      570      procedure WaitFramRunPause:
      571         define input  parameter iInterval as dec no-undo.
      572         define variable vStart  as datetime-tz no-undo.
      573         define variable vend    as datetime-tz no-undo.
      574         define variable vint as int64 no-undo.
      575         define variable vOk as logical no-undo.
      576         vStart = now.
      577         vend   = vStart.
      578         publish "WaitFramPause" (iInterval,output vOk).
      579         vend   =  now.
      580         vint = vend - vStart.
      581         vint = iInterval - vint / 1000.
      582         if     not mWaitFramStop
      583            and (   vint > 0
      584                 or (    not vOk
      585                     and iInterval eq ?
      586                     )
      587                 )
      588         then
      589            run waitfram-show-this (iInterval).
      590         vend   =  now.
      591         vint = vend - vStart.
      592         vint = iInterval - vint / 1000.
      593         if     not mWaitFramStop
      594            and vint > 0
      595         then do:
      596            run gbl/pause.p (vint * 1000).
      597         end.
      598         if iInterval ne ?
      599         then
      600            publish "WaitFramStop".
      601         waitfram-check-timeout().
      602      end.
      603      procedure WaitFramWaitFor:
      604         define input  parameter iInterval as dec no-undo.
      605         assign
      606            mWaitFramStartProc   = now
      607            mWaitFramStopUser    = no
      608            mWaitFramStopTimeOut = no
      609         .
      610         block-wait:
      611         do while not mWaitFramStop:
      612            run WaitFramRunPause (iInterval).
      613            if  waitfram-check-timeout()
      614            then do:
      615               leave block-wait.
      616            end.
      617         end.
      618         run waitfram-hide.
      619      end.
      620   procedure waitfram-join :
      621     define input  parameter p-line-1  as character no-undo .
      622     define input  parameter p-line-2  as character no-undo .
      623     define input  parameter p-line-3  as character no-undo .
      624     define output parameter p-message as character no-undo .
      625     do
      626     on error undo, return error return-value
      627     :
      628       assign
      629         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      630                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      631                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      632       .
      633     end.
      634   end procedure.
      635   function waitfram-join-function returns character
      636     (input p-line-1 as character
      637     ,input p-line-2 as character
      638     ,input p-line-3 as character
      639     ).
      640     define variable v-message as character no-undo .
      641     run waitfram-join in this-procedure
      642       (input  p-line-1
      643       ,input  p-line-2
      644       ,input  p-line-3
      645       ,output v-message
      646       ) .
      647     return v-message .
      648   end function .
      649   procedure proc-alt-shift-f2:
      650     if not ibs.th.gbl.gbl-var:rcode
      651   then
      652     run gbl\inidebug.p .
      653   end.
      654   procedure proc-alt-shift-f3:
      655     run gbl/prvssinf.p
      656       ( input this-procedure
      657       ) .
      658   end.
      659   define variable v-inform-launched as logical no-undo initial false .
      660   procedure proc-alt-shift-f4:
      661     define variable v-action as character no-undo .
      662     if v-inform-launched = false then do:
      663       assign
      664         v-inform-launched = true
      665       .
      666       run gbl/d-inform.w
      667         (  input self
      668         ,  input this-procedure
      669         , output v-action
      670         ) no-error .
      671       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      672       assign
      673         v-inform-launched = false
      674       .
      675     end.
      676   end.
      677   procedure proc-alt-f1:
      678     run gbl/corrhelp.p
      679       (input this-procedure
      680       ) .
      681   end .
      682   on alt-shift-f2 anywhere do:
      683     run proc-alt-shift-f2.
      684   end.
      685   on alt-shift-f3 anywhere do:
      686     run proc-alt-shift-f3 in this-procedure .
      687   end.
      688   on alt-shift-f4 anywhere do:
      689     run proc-alt-shift-f4 in this-procedure.
      690   end.
      691   on alt-f1 anywhere do:
      692     run proc-alt-f1 in this-procedure .
      693   end.
      694   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      695     define variable v-cntxt-db-num        as integer   no-undo .
      696     define variable v-cntxt-userid        as character no-undo .
      697     define variable v-cntxt-level         as character no-undo .
      698     define variable v-cntxt-host-code-obj as integer   no-undo .
      699     define variable v-cntxt-obj-type      as character no-undo .
      700     define variable v-cntxt-obj-code      as integer   no-undo .
      701     define variable v-cntxt-db-num-obj    as integer   no-undo .
      702     define variable v-cntxt-is-admin      as logical   no-undo .
      703   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      704   procedure lineattr-value :
      705     do
      706     on error undo, return error return-value
      707     :
      708       define input  parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      709       define input  parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      710       define input  parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
      711       define output parameter p-value    like ub.doc-line-attr.attr-value no-undo .
      712       define output parameter p-type     as character no-undo .
      713       define buffer buf_doc-line-attr for ub.doc-line-attr .
      714       def var v-format         as character no-undo .
      715       def var v-fillin_width   as integer   no-undo .
      716       def var v-fillin_height  as integer   no-undo .
      717       def var v-label          as character no-undo .
      718       def var v-user-can-edit  as logical   no-undo .
      719       def var v-output-display as logical   no-undo .
      720       def var v-other          as character no-undo .
      721       run lineattr-code in this-procedure
      722         (input  p-code
      723         ,output p-type
      724         ,output v-format
      725         ,output v-fillin_width
      726         ,output v-fillin_height
      727         ,output v-label
      728         ,output v-user-can-edit
      729         ,output v-output-display
      730         ,output v-other
      731         ) no-error .
      732       if error-status :error then do:
      733         undo, return error return-value .
      734       end.
      735       find first buf_doc-line-attr no-lock
      736         where buf_doc-line-attr.doc-code  = p-doc-code
      737           and buf_doc-line-attr.gds-code  = p-gds-code
      738           and buf_doc-line-attr.attr-code = p-code
      739         no-error .
      740       if avail buf_doc-line-attr then do:
      741         assign
      742           p-value =  buf_doc-line-attr.attr-value
      743         .
      744       end.
      745       else do:
      746         assign
      747           p-value = if p-type = 'L':U then "no":U else ""
      748         .
      749       end.
      750     end.
      751   end procedure.
      752   procedure lineattr-write :
      753     do
      754     on error undo, return error return-value
      755     :
      756       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      757       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      758       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
      759       define input parameter p-value    like ub.doc-line-attr.attr-value no-undo .
      760       define buffer buf_doc-line-attr for ub.doc-line-attr .
      761       def var v-type           as character no-undo .
      762       def var v-format         as character no-undo .
      763       def var v-fillin_width   as integer   no-undo .
      764       def var v-fillin_height  as integer   no-undo .
      765       def var v-label          as character no-undo .
      766       def var v-user-can-edit  as logical   no-undo .
      767       def var v-output-display as logical   no-undo .
      768       def var v-other          as character no-undo .
      769       run lineattr-code in this-procedure
      770         (input  p-code
      771         ,output v-type
      772         ,output v-format
      773         ,output v-fillin_width
      774         ,output v-fillin_height
      775         ,output v-label
      776         ,output v-user-can-edit
      777         ,output v-output-display
      778         ,output v-other
      779         ) no-error .
      780       if error-status :error then do:
      781         undo, return error return-value .
      782       end.
      783       find first buf_doc-line-attr exclusive-lock
      784         where buf_doc-line-attr.doc-code  = p-doc-code
      785           and buf_doc-line-attr.gds-code  = p-gds-code
      786           and buf_doc-line-attr.attr-code = p-code
      787         no-error .
      788       if not available buf_doc-line-attr then do:
      789         create buf_doc-line-attr .
      790         assign
      791           buf_doc-line-attr.doc-code  = p-doc-code
      792           buf_doc-line-attr.gds-code = p-gds-code
      793           buf_doc-line-attr.attr-code = p-code
      794         .
      795       end.
      796       assign
      797         buf_doc-line-attr.attr-value = p-value
      798       .
      799        release buf_doc-line-attr.
      800     end.
      801   end procedure.
      802   procedure lineattr-exist :
      803     do
      804     on error undo, return error return-value
      805     :
      806       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      807       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      808       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
      809       define output parameter p-exist   as logical  no-undo .
      810       define buffer buf_doc-line-attr for ub.doc-line-attr .
      811       def var v-type           as character no-undo .
      812       def var v-format         as character no-undo .
      813       def var v-fillin_width   as integer   no-undo .
      814       def var v-fillin_height  as integer   no-undo .
      815       def var v-label          as character no-undo .
      816       def var v-user-can-edit  as logical   no-undo .
      817       def var v-output-display as logical   no-undo .
      818       def var v-other          as character no-undo .
      819       run lineattr-code in this-procedure
      820         (input  p-code
      821         ,output v-type
      822         ,output v-format
      823         ,output v-fillin_width
      824         ,output v-fillin_height
      825         ,output v-label
      826         ,output v-user-can-edit
      827         ,output v-output-display
      828         ,output v-other
      829         ) no-error .
      830       if error-status :error then do:
      831         undo, return error return-value .
      832       end.
      833       find first buf_doc-line-attr no-lock
      834         where buf_doc-line-attr.doc-code  = p-doc-code
      835           and buf_doc-line-attr.gds-code = p-gds-code
      836           and buf_doc-line-attr.attr-code = p-code
      837         no-error .
      838       if  available buf_doc-line-attr then do:
      839         p-exist = yes.
      840       end.
      841     end.
      842   end procedure.
      843   procedure lineattr-delete :
      844     do
      845     on error undo, return error return-value
      846     :
      847       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      848       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      849       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
      850       define output parameter p-deleted  as logical no-undo.
      851       define buffer buf_doc-line-attr for ub.doc-line-attr .
      852       def var v-type           as character no-undo .
      853       def var v-format         as character no-undo .
      854       def var v-fillin_width   as integer   no-undo .
      855       def var v-fillin_height  as integer   no-undo .
      856       def var v-label          as character no-undo .
      857       def var v-user-can-edit  as logical   no-undo .
      858       def var v-output-display as logical   no-undo .
      859       def var v-other          as character no-undo .
      860       run lineattr-code in this-procedure
      861         (input  p-code
      862         ,output v-type
      863         ,output v-format
      864         ,output v-fillin_width
      865         ,output v-fillin_height
      866         ,output v-label
      867         ,output v-user-can-edit
      868         ,output v-output-display
      869         ,output v-other
      870         ) no-error .
      871       if error-status :error then do:
      872         undo, return error return-value .
      873       end.
      874       find first buf_doc-line-attr exclusive-lock
      875         where buf_doc-line-attr.doc-code  = p-doc-code
      876           and buf_doc-line-attr.gds-code  = p-gds-code
      877           and buf_doc-line-attr.attr-code = p-code
      878         no-error NO-WAIT.
      879       if not available buf_doc-line-attr then do:
      880         p-deleted = no.
      881       end.
      882       else do:
      883         delete buf_doc-line-attr.
      884         p-deleted = yes.
      885       end.
      886     end.
      887   end procedure.
      888   procedure lineattr-code :
      889     do on error undo, return error return-value
      890     :
      891       define input  parameter p-code           as character no-undo .
      892       define output parameter p-type           as character no-undo .
      893       define output parameter p-format         as character no-undo .
      894       define output parameter p-fillin_width   as integer   no-undo .
      895       define output parameter p-fillin_height  as integer   no-undo .
      896       define output parameter p-label          as character no-undo .
      897       define output parameter p-user-can-edit  as logical   no-undo .
      898       define output parameter p-output-display as logical   no-undo .
      899       define output parameter p-other          as character no-undo .
      900       case p-code :
      901               when 'parts_price-sale':U then do:     assign     p-label          = "Продажная цена партии"     p-type           = 'C':U      p-format         = "x(70)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Продажная цена партии"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      902               when 'fl_gds-code':U then do:     assign     p-label          = "Количество по букету"     p-type           = 'C':U      p-format         = "x(70)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Количество по букету"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      903               when 'old_other-ras':U then do:     assign     p-label          = " Первым способом из ПН Сумма дополнительных расходов по строке rubl base"     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = " Первым способом из ПН Сумма дополнительных расходов по строке rubl base"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      904               when 'new_other-ras':U then do:     assign     p-label          = " Способом из ДопРасх Сумма дополнительных расходов по строке rubl base"     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = " Способом из ДопРасх Сумма дополнительных расходов по строке rubl base"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      905               when 'flora_ps':U then do:     assign     p-label          = "Описание не товарной позиции"     p-type           = 'C':U      p-format         = "x(70)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Описание не товарной позиции"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
      906               when 'country-code':U then do:     assign     p-label          = "Страна"     p-type           = 'I':U      p-format         = "->>>>>>>>9"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Страна"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      907               when 'add-line-cli':U then do:     assign     p-label          = "Курс . шкала . сумма . НДС "     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Курс . шкала . сумма . НДС "     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      908               when 'corr-price-sale':U then do:     assign     p-label          = "Продажная цена в строке ПН"     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Продажная цена в строке ПН"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      909               when 'reason-code':U then do:     assign     p-label          = "Причина отклонения"     p-type           = 'I':U      p-format         = "->>>>>>>>9"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Причина отклонения"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
      910               when 'price-prod':U then do:     assign     p-label          = "Цена производителя Без НДС"     p-type           = 'D':U      p-format         = ">>>>>>>>9.99"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Цена производителя Без НДС"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
      911               when 'price-prodvat':U then do:     assign     p-label          = "Цена производителя c НДС"     p-type           = 'D':U      p-format         = ">>>>>>>>9.99"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Цена производителя c НДС"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
      912         otherwise do:
      913           undo, return error "неизвестный атрибут строки документа" + " " + p-code .
      914         end.
      915       end.
      916     end.
      917   end procedure.
      918   procedure lineattr-value-flora-gds :
      919     do
      920     on error undo, return error return-value
      921     :
      922       define input  parameter p-doc-code    like  ub.doc-line-attr.doc-code   no-undo .
      923       define input  parameter p-gds-code    like  ub.doc-line-attr.gds-code   no-undo .
      924       define input  parameter p-prt-code    as integer   no-undo .
      925       define input  parameter p-bk-gds-code like  ub.doc-line-attr.gds-code   no-undo .
      926       define input  parameter p-code        like  ub.doc-line-attr.attr-code  no-undo .
      927       define output parameter p-value       as    decimal   no-undo .
