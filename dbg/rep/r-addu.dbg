     1158       define output parameter p-value       as    decimal   no-undo .
     1159       define buffer buf_doc-line-attr for ub.doc-line-attr .
     1160       find first buf_doc-line-attr no-lock
     1161         where buf_doc-line-attr.doc-code  = p-doc-code
     1162           and buf_doc-line-attr.gds-code  = p-gds-code
     1163           and buf_doc-line-attr.attr-code = p-code  + chr(4) + trim(p-part-code)  + chr(4) + trim(p_in-code)
     1164         no-error .
     1165       if avail buf_doc-line-attr then do:
     1166         assign
     1167           p-value = decimal( buf_doc-line-attr.attr-value)
     1168         .
     1169       end.
     1170       else do:
     1171         assign
     1172           p-value = 0
     1173         .
     1174       end.
     1175     end.
     1176   end procedure.
