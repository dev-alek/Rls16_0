     1473           b-sum-base COLUMN-LABEL "В баз.вал.  ! " format ">>>>>>>>>9.99" space(0)
     1474           sym11 column-label ":!:" format "X(1)" space(0)
     1475           B-method COLUMN-LABEL "Метод включения !в учетную цену  " format "x(35)" space(0)
     1476           sym12 column-label ":!:" format "X(1)" space(0)
     1477          HEADER
     1478           string( cur-time-print() ) AT 5 format "X(35)"
     1479           string( "ДопРасход N " + tdoc-code + "  от  " + string ( tdoc-date , "99/99/9999" ) ) AT 47 format "X(63)"
     1480           string( pp ) AT 90 format "X(19)"
     1481           string( " Лист " + string( PAGE-NUMBER(OutStream) , ">>9") ) format "X(13)" SKIP
     1482           UndLine format "X(199)" AT 1
     1483           with width 232 down stream-io use-text NO-BOX.
     1484   find first ub.add-doc where ub.add-doc.doc-code = p-doc-code no-lock no-error .
     1485   if error-status :error then do:
     1486      message "Документ еще не сохранен в БД !" view-as alert-box information .
     1487      return .
     1488   end.
     1489   assign
     1490       tdoc-date = (if ub.add-doc.status_ <> 'факт':U then ub.add-doc.doc-date else ub.add-doc.fact-date)
     1491       tdoc-code = ub.add-doc.doc-code .
     1492   if session:set-wait-state("compiler") then.
     1493   output STREAM OutStream to value( string( session:temp-directory +
     1494                                        "rpt" + string( g#report-num ) ) )
     1495                                        page-size  value(43) .
     1496   assign
     1497     Line    = fill("-", 199 )
     1498     UndLine = fill("_", 199 )
     1499     LineBuf = fill("_", 199 )
     1500     .
     1501   run waitfram-show in this-procedure ( 'Подождите ...' ) .
     1502   find this_object  where this_object.obj-type = v-cntxt-obj-type
     1503                       and this_object.obj-code = v-cntxt-obj-code
     1504                       no-lock.
     1505   find ub.clients  where ub.clients.obj-type = 'орг':U
     1506                   and ub.clients.obj-code = ub.add-doc.host-code
     1507                   no-lock.
     1508    FORM with frame sl .
     1509   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1510   form header
     1511     line format "X(199)" at 1 skip
     1512     "Продолжение - на следующей странице" at 30 skip
     1513     with frame bottomframe width 232 page-bottom no-labels no-box .
     1514   view stream outstream frame bottomframe .
     1515      run waitfram-show in this-procedure( 'Подождите ...' ) .
     1516   for each ub.add-line where ub.add-line.doc-code = ub.add-doc.doc-code no-lock ,
     1517           first ub.goods where ub.goods.gds-code = ub.add-line.gds-code no-lock break by (if sort-gr then  ub.goods.grp-name else ub.goods.artic) by ub.goods.artic :
     1518        run lineattr-value-add-line-cli (
     1519             input  ub.add-line.doc-code      ,
     1520             input  ub.add-line.gds-code      ,
     1521             input  ub.add-line.cli-type      ,
     1522             input  ub.add-line.cli-code      ,
     1523             input  ub.add-line.contract-code ,
     1524             input  ub.add-line.host-code     ,
     1525             output v-exch-code    ,
     1526             output v-exch-rate    ,
     1527             output v-exch-scale   ,
     1528             output v-sum-cli      ,
     1529             output v-sum-vat      )
     1530             no-error .
     1531             if error-status :error then  v-exch-code = 0 .
     1532      find first  ub.currency NO-LOCK WHERE ub.currency.curr-code = v-exch-code no-error .
     1533      assign
     1534       b-contr          = if ub.add-line.contract-code = 0 then "" else  string ( ub.add-line.contract-code )
     1535       b-val            = ub.currency.curr-abbr
     1536       b-val-rate       = v-exch-rate
     1537       lines_counter    = lines_counter + 1
     1538       b-sum-cli        = v-sum-cli
     1539       b-sum-rubl       = ub.add-line.sum-rubl
     1540       b-sum-base       = ub.add-line.sum-base
     1541       .
     1542      find first buf_clients no-lock where
     1543                 buf_clients.obj-type = ub.add-line.cli-type and
     1544                 buf_clients.obj-code = ub.add-line.cli-code
     1545                 no-error .
     1546       b-cli-name = buf_clients.obj-type + string ( buf_clients.obj-code ) + "(" + buf_clients.obj-name + ")".
     1547       find first ub.gds-add-charges no-lock where
     1548                  ub.gds-add-charges.gds-code = ub.add-line.gds-code
     1549                  no-error .
     1550                  if available   ub.gds-add-charges then do:
     1551       B-method = alg-name( buffer ub.gds-add-charges) .
     1552       end.
     1553       else do:
     1554       B-method = "" .
     1555       end.
     1556       accumulate
     1557        ( ub.add-line.sum-rubl ) ( total )
     1558        ( ub.add-line.sum-base ) ( total )
     1559          ub.goods.artic ( count )
     1560      .
     1561       display stream outstream
     1562         sym1
     1563         lines_counter
     1564         sym2
     1565         ub.goods.artic
     1566         sym3
     1567         ub.goods.gds-name
     1568         sym4
     1569         b-val
     1570         sym5
     1571         b-val-rate
     1572         sym6
     1573         b-contr
     1574         sym7
     1575         b-cli-name
     1576         sym8
     1577         b-sum-cli
     1578         sym9
     1579         b-sum-rubl
     1580         sym10
     1581         b-sum-base
     1582         sym11
     1583         b-method
     1584         sym12
     1585         with frame sl.
     1586         down stream outstream 1 with frame sl .
     1587       if ( ( ( accum count ub.goods.artic ) modulo 10 ) = 0 ) and
     1588            ( ( accum count ub.goods.artic ) >= 10 ) then
     1589           run waitfram-show in this-procedure ( "Обработано строк : " + string( accum count ub.goods.artic ) ) .
     1590   end.
     1591   assign
     1592   b-sum-base1 = accum total ( ub.add-line.sum-base)
     1593   b-sum-rubl1 = accum total ( ub.add-line.sum-rubl)
     1594   .
     1595       display stream outstream
     1596         "Итого " @ b-sum-cli
     1597         b-sum-rubl1  @ b-sum-rubl
     1598         b-sum-base1  @ b-sum-base
     1599         sym9  sym10  sym7 sym12
     1600         with frame sl.
     1601      down stream outstream 1 with frame sl .
     1602   define variable v-p-rubl as decimal   no-undo .
     1603   define variable v-p-base as decimal   no-undo .
     1604   define variable v-s-rubl as decimal   no-undo .
     1605   define variable v-s-base as decimal   no-undo .
     1606   define variable v-kol as integer   no-undo .
     1607   v-kol = 0 .
     1608    run on-same-page in this-procedure (input 1) .
     1609    HIDE stream OutStream FRAME BottomFrame .
     1610    PUT  STREAM OutStream
     1611        "Суммы в учетных ценах в национальной и базовой валютах "
     1612        skip
     1613        .
     1614    for each ub.add-trn no-lock where
     1615       ub.add-trn.doc-code = p-doc-code :
     1616       find first ub.trn-doc no-lock
     1617       where ub.trn-doc.doc-code = ub.add-trn.trn-doc-code  no-error .
     1618       if available ub.trn-doc then do:
     1619       v-p-rubl = 0 .
     1620       v-p-base = 0 .
     1621       v-kol = v-kol + 1 .
     1622       for each ub.parts no-lock where
     1623                ub.parts.out-code = ub.add-trn.trn-doc-code and
     1624                ub.parts.in-code = ub.add-trn.trn-doc-code
     1625                :
     1626       v-p-rubl = v-p-rubl + ub.parts.qnty * ub.parts.price-rubl .
     1627       v-p-base = v-p-base + ub.parts.qnty * ub.parts.price-base .
     1628       v-s-rubl = v-s-rubl + ub.parts.qnty * ub.parts.price-rubl .
     1629       v-s-base = v-s-base + ub.parts.qnty * ub.parts.price-base .
     1630       end.
     1631        PUT  STREAM OutStream
     1632        "По ПН "
     1633        ub.add-trn.trn-doc-code
     1634        v-p-rubl at 20
     1635        v-p-base
     1636        skip
     1637        .
     1638       end.
     1639    end.
     1640    if v-kol > 1 then do:
     1641       put  stream outstream
     1642           "Итого "
     1643           v-s-rubl at 20
     1644           v-s-base
     1645           skip
     1646           .
     1647    end.
     1648    if v-kol = 0 then do:
     1649       put  stream outstream
     1650           "Нет привязанных ПН "
     1651           skip
     1652           .
     1653    end.
     1654   output stream OutStream CLOSE .
     1655   run waitfram-hide in this-procedure  .
     1656   define variable v-user-action as character no-undo .
     1657   define variable v-printed as logical   no-undo .
     1658   define variable DisabledOptions as integer   no-undo .
     1659   DisabledOptions = 8 .
     1660   run gbl/prnfilen.w
     1661     (input  ""
     1662     ,input  DisabledOptions
     1663     ,input  string(session :temp-directory) + "rpt" + string( g#report-num )
     1664     ,input  7
     1665     ,output v-user-action
     1666     ,output v-printed
     1667     ) .
     1668   procedure calc-sl :
     1669   define input parameter tt as character no-undo .
     1670   if tt = "artic":U THEN DO:
     1671   End.
     1672   if tt = "scala":U THEN DO:
     1673   End.
     1674   end procedure.
     1675   PROCEDURE on-same-page :
     1676     define input parameter p-line-number as integer  no-undo .
     1677     if p-line-number > page-size( OutStream ) then do:
     1678       return .
     1679     end.
     1680     if line-counter( OutStream ) + p-line-number > page-size( OutStream ) then do:
     1681       page stream OutStream .
     1682     end.
     1683   end procedure.
