     1428   define variable  PropiscountP      as  char no-undo.
     1429   define variable  abbr              as  char no-undo.
     1430   define variable tt    as int no-undo.
     1431   define variable sym1 as char  init ":"   no-undo.
     1432   define variable sym2 as char  init ":"   no-undo.
     1433   define variable sym3 as char  init ":"   no-undo.
     1434   define variable sym4 as char  init ":"   no-undo.
     1435   define variable sym5 as char  init ":"   no-undo.
     1436   define variable sym6 as char  init ":"   no-undo.
     1437   define variable sym7 as char  init ":"   no-undo.
     1438   define variable sym8 as char  init ":"   no-undo.
     1439   define variable sym9 as char  init ":"   no-undo.
     1440   define variable sym10 as char init ":"   no-undo.
     1441   define variable sym11 as char init ":"   no-undo.
     1442   define variable sym12 as char init ":"   no-undo.
     1443   define variable sym13 as char init ":"   no-undo.
     1444   define variable sym14 as char init ":"   no-undo.
     1445   define variable tb-code       as char    no-undo.
     1446   define variable Price         as decimal no-undo.
     1447   define variable UBL           as decimal no-undo .
