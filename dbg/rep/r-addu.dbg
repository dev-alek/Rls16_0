     1413   define variable  PropisQnty        as  char no-undo.
     1414   define variable  PropisSum         as  char no-undo.
     1415   define variable  PropisQnty-b      as  char no-undo.
     1416   define variable  PropisSum-b       as  char no-undo.
     1417   define variable b-sum-base1             as decimal no-undo .
     1418   define variable B-Sum              as decimal no-undo .
