     1452   define variable pp as character no-undo .
     1453   DEFINE FRAME sl
     1454           sym1 column-label ":!:"  format "X(1)" space(0)
     1455           Lines_Counter COLUMN-LABEL "N!п/п " format ">>9" space(0)
