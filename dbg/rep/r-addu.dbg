     1465           b-contr COLUMN-LABEL "Вн.Код!договора  " format "x(10)" space(0)
     1466           sym7 column-label ":!:" format "X(1)" space(0)
     1467           B-cli-name COLUMN-LABEL "Поставщик ! " format "x(34)" space(0)
     1468           sym8 column-label ":!:" format "X(1)" space(0)
     1469           b-sum-cli COLUMN-LABEL "По док-ту  ! " format ">>>>>>>>>9.99" space(0)
     1470           sym9 column-label ":!:" format "X(1)" space(0)
     1471           b-sum-rubl COLUMN-LABEL "В нац.вал. ! " format ">>>>>>>>>9.99" space(0)
