     1040   procedure lineattr-write-add-line-cli :
     1041   define input  parameter p-doc-code      like  ub.doc-line-attr.doc-code   no-undo .
     1042   define input  parameter p-gds-code      like  ub.doc-line-attr.gds-code   no-undo .
     1043   define input  parameter p-cli-type      as character no-undo .
     1044   define input  parameter p-cli-code      as integer   no-undo .
     1045   define input  parameter p-contract-code as integer   no-undo .
     1046   define input  parameter p-host-code     as integer   no-undo .
     1047   define input  parameter p-exch-code     as integer   no-undo .
     1048   define input  parameter p-exch-rate     as decimal   no-undo .
     1049   define input  parameter p-exch-scale    as integer   no-undo .
     1050   define input  parameter p-sum-cli       as decimal   no-undo .
     1051   define input  parameter p-sum-vat       as decimal   no-undo .
     1052   define buffer buf_doc-line-attr for ub.doc-line-attr .
     1053     do
     1054     on error undo, return error return-value
     1055     :
     1056       find first buf_doc-line-attr exclusive-lock
     1057         where buf_doc-line-attr.doc-code  = p-doc-code
     1058           and buf_doc-line-attr.gds-code  = p-gds-code
     1059           and buf_doc-line-attr.attr-code = 'add-line-cli':U +
     1060                                             chr(4) + p-cli-type +
     1061                                             chr(4) + string(p-cli-code) +
     1062                                             chr(4) + string(p-contract-code) +
     1063                                             chr(4) + string(p-host-code)
     1064         no-error .
     1065       if not available buf_doc-line-attr then do:
     1066         create buf_doc-line-attr .
     1067         assign
     1068           buf_doc-line-attr.doc-code  = p-doc-code
     1069           buf_doc-line-attr.gds-code  = p-gds-code
     1070           buf_doc-line-attr.attr-code = 'add-line-cli':U  +
     1071                                         chr(4) + p-cli-type +
     1072                                         chr(4) + string(p-cli-code) +
     1073                                         chr(4) + string(p-contract-code) +
     1074                                         chr(4) + string(p-host-code)
     1075         .
     1076       end.
     1077       assign
     1078         buf_doc-line-attr.attr-value =
     1079         string(p-exch-code)  + chr(4) +
     1080         string(p-exch-rate)  + chr(4) +
     1081         string(p-exch-scale) + chr(4) +
     1082         string(p-sum-cli)    + chr(4) +
     1083         string(p-sum-vat)
     1084         .
     1085     end.
     1086   end procedure.
     1087   procedure lineattr-value-add-line-cli :
     1088   define input   parameter p-doc-code      like  ub.doc-line-attr.doc-code   no-undo .
     1089   define input   parameter p-gds-code      like  ub.doc-line-attr.gds-code   no-undo .
     1090   define input   parameter p-cli-type      as character no-undo .
     1091   define input   parameter p-cli-code      as integer   no-undo .
     1092   define input   parameter p-contract-code as integer   no-undo .
     1093   define input   parameter p-host-code     as integer   no-undo .
     1094   define output  parameter p-exch-code     as integer   no-undo .
     1095   define output  parameter p-exch-rate     as decimal   no-undo .
     1096   define output  parameter p-exch-scale    as integer   no-undo .
     1097   define output  parameter p-sum-cli       as decimal   no-undo .
     1098   define output  parameter p-sum-vat       as decimal   no-undo .
     1099   define buffer buf_doc-line-attr for ub.doc-line-attr .
     1100     do
     1101     on error undo, return error return-value
     1102     :
     1103       find first buf_doc-line-attr exclusive-lock
     1104         where buf_doc-line-attr.doc-code  = p-doc-code
     1105           and buf_doc-line-attr.gds-code  = p-gds-code
     1106           and buf_doc-line-attr.attr-code = 'add-line-cli':U +
     1107                                             chr(4) + p-cli-type +
     1108                                             chr(4) + string(p-cli-code) +
     1109                                             chr(4) + string(p-contract-code) +
     1110                                             chr(4) + string(p-host-code)
     1111         no-error .
     1112       if available buf_doc-line-attr then do:
     1113        assign
     1114           p-exch-code  = integer ( entry (1 , buf_doc-line-attr.attr-value,  chr(4) ))
     1115           p-exch-rate  = decimal ( entry (2 , buf_doc-line-attr.attr-value, chr(4) ))
     1116           p-exch-scale = integer ( entry (3 , buf_doc-line-attr.attr-value, chr(4) ))
     1117           p-sum-cli    = decimal ( entry (4 , buf_doc-line-attr.attr-value, chr(4) ))
     1118           p-sum-vat    = decimal ( entry (5 , buf_doc-line-attr.attr-value, chr(4) ))
     1119          .
     1120        end.
     1121     end.
     1122   end procedure.
     1123   function lineattr-get-reason returns character ( buffer local-doc-line for ub.doc-line ) :
     1124     define variable v-code as character no-undo .
     1125     define variable v-type as character no-undo .
     1126     define variable v-gds-code as integer   no-undo .
     1127   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1128   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
     1129     (input  local-doc-line.artic
     1130     ,input  local-doc-line.prod-type
     1131     ,input  local-doc-line.prod-code
     1132     ,output v-gds-code
     1133     )  .
     1134     run lineattr-value (
     1135         input   local-doc-line.doc-code ,
     1136         input   v-gds-code              ,
     1137         input   'reason-code':U ,
     1138         output  v-code                  ,
     1139         output  v-type ) .
     1140     find first ub.trn-reason no-lock where
     1141                ub.trn-reason.reason-code = integer ( v-code ) no-error.
     1142     if not available ub.trn-reason then do:
     1143        return "" .
     1144     end.
     1145     else do:
     1146        return ub.trn-reason.reason-name .
     1147     end.
     1148   end function.
     1149   procedure lineattr-value-parts :
