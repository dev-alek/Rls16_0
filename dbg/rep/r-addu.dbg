     1189         where buf_doc-line-attr.doc-code  = p-doc-code
     1190           and buf_doc-line-attr.gds-code  = p-gds-code
     1191           and buf_doc-line-attr.attr-code = p-code + chr(4)  + trim(p-part-code)  + chr(4) + trim(p_in-code)
     1192         no-error .
