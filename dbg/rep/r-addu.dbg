      931           and buf_doc-line-attr.gds-code  = p-gds-code
      932           and buf_doc-line-attr.attr-code = p-code  + chr(44) + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
      933         no-error .
      934       if avail buf_doc-line-attr then do:
      935         assign
      936           p-value = decimal( buf_doc-line-attr.attr-value)
      937         .
      938       end.
      939       else do:
      940         assign
      941           p-value = 0
      942         .
      943       end.
      944     end.
      945   end procedure.
