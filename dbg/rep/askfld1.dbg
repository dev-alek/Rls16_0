     1470            TITLE "Выбор колонок для печати"
     1471            DEFAULT-BUTTON B-exit CANCEL-BUTTON B-quit.
     1472   ASSIGN
     1473          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1474          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1475   ASSIGN
     1476          A-3:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     1477   ASSIGN
     1478          B-help:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     1479   ASSIGN
     1480          B-unmark:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     1481   ASSIGN
     1482          only-text-exel:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     1483   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1484   DO:
     1485     APPLY "END-ERROR":U TO SELF.
     1486   END.
     1487   ON CHOOSE OF A-3 IN FRAME Dialog-Frame
     1488   DO:
     1489     Display a3  with frame Dialog-Frame.
     1490     Hide  A4-port  a4-lansc  only-file  in frame Dialog-Frame.
     1491     print-o = "A3-lansc":U.
     1492   END.
     1493   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
     1494   DO:
     1495     define variable l-ind as integer no-undo .
     1496     run eq-frame.
     1497    find first ubflt.usr-flt share-lock
     1498      where ubflt.usr-flt.user-name  = g#userid
     1499        and ubflt.usr-flt.call-point = "e-obort1":U
     1500      no-error .
     1501    if NOT avail ubflt.usr-flt then  create ubflt.usr-flt.
     1502    Assign
     1503      ubflt.usr-flt.user-name = g#userid
     1504      ubflt.usr-flt.call-point   = "e-obort1":U
     1505      ubflt.usr-flt.list_ = "" .
     1506      repeat l-ind = 1 to 120 :
     1507        if   use-column[ l-ind ] =  true then ubflt.usr-flt.list_ = ubflt.usr-flt.list_  + string( l-ind ) + "," .
     1508      End.
     1509      ubflt.usr-flt.list_ = ubflt.usr-flt.list_  + string( "print-o=" + print-o ) + ",prod-zen=" + string( prod-zen ) + "," .
     1510   END.
