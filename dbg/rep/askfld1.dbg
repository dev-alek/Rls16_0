      565   define new global shared variable g#library  as handle no-undo .
      566   define new global shared variable g#library2 as handle no-undo .
      567   define variable var-report-r-b as character no-undo .
      568   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      569   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      570     (output var-report-r-b
      571     )  .
      572   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      573   procedure proc-alt-shift-f2:
      574     if not ibs.th.gbl.gbl-var:rcode
      575   then
      576     run gbl\inidebug.p .
      577   end.
      578   procedure proc-alt-shift-f3:
      579     run gbl/prvssinf.p
      580       ( input this-procedure
      581       ) .
      582   end.
      583   define variable v-inform-launched as logical no-undo initial false .
      584   procedure proc-alt-shift-f4:
      585     define variable v-action as character no-undo .
      586     if v-inform-launched = false then do:
      587       assign
      588         v-inform-launched = true
      589       .
      590       run gbl/d-inform.w
      591         (  input self
      592         ,  input this-procedure
      593         , output v-action
      594         ) no-error .
      595       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      596       assign
      597         v-inform-launched = false
      598       .
      599     end.
      600   end.
      601   procedure proc-alt-f1:
      602     run gbl/corrhelp.p
      603       (input this-procedure
      604       ) .
      605   end .
      606   on alt-shift-f2 anywhere do:
      607     run proc-alt-shift-f2.
      608   end.
      609   on alt-shift-f3 anywhere do:
      610     run proc-alt-shift-f3 in this-procedure .
      611   end.
      612   on alt-shift-f4 anywhere do:
      613     run proc-alt-shift-f4 in this-procedure.
      614   end.
      615   on alt-f1 anywhere do:
      616     run proc-alt-f1 in this-procedure .
      617   end.
      618   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      619     define variable v-cntxt-db-num        as integer   no-undo .
      620     define variable v-cntxt-userid        as character no-undo .
