     2211   PROCEDURE Show-format :
     2212   define variable ij as integer no-undo .
     2213     run eq-frame.
     2214     col-size = 0.
     2215     repeat ij = 1 to 120 :
     2216       if use-column[ij] then col-size = col-size + s-column[ij] + 1 .
     2217     End.
     2218     F-col-size:screen-value in frame Dialog-Frame = string( col-size).
     2219     F-col-size = string(col-size).
     2220     Display F-col-size with frame Dialog-Frame.
     2221     If col-size >= 1 and col-size <= 136 Then DO:
     2222       Display A4-port a-3  with frame Dialog-Frame.
     2223       Hide a4-lansc a3 only-file only-text-exel in frame Dialog-Frame.
     2224       print-o = "A4-port":U.
     2225     End.
     2226     If col-size > 136 and col-size <= 198 Then DO:
     2227       Display  a4-lansc a-3  with frame Dialog-Frame.
     2228       Hide A4-port a3 only-file only-text-exel in frame Dialog-Frame.
     2229       print-o = "A4-lansc":U.
     2230     End.
     2231     If col-size > 198 and col-size <= 235 Then DO:
     2232       Display a3 a-3  with frame Dialog-Frame.
     2233       Hide A4-port a4-lansc only-text-exel  only-file in frame Dialog-Frame.
     2234       print-o = "A3-lansc":U.
     2235     End.
     2236     If col-size > 235 Then DO:
     2237       Display only-file a-3 with frame Dialog-Frame.
     2238       Hide A4-port a4-lansc a3 only-text-exel in frame Dialog-Frame.
     2239       print-o = "to-file":U.
     2240     End.
     2241     If col-size > 550 Then DO:
     2242       Display  only-text-exel  with frame Dialog-Frame.
     2243       Hide only-file a-3 A4-port a4-lansc a3 in frame Dialog-Frame.
     2244       print-o = "to-file":U.
     2245     End.
     2246   END PROCEDURE.
     2247   procedure eq-frame:
     2248     Assign frame Dialog-Frame  TOG-1 TOG-12 TOG-31 TOG-50 TOG-2 TOG-13 TOG-51 TOG-32 TOG-3 TOG-89 TOG-90 TOG-91 TOG-4 TOG-92 TOG-93 TOG-94 TOG-95 TOG-96 TOG-5 TOG-6 TOG-14 TOG-33 TOG-15 TOG-34 TOG-7 TOG-16 TOG-35 TOG-52 TOG-68 TOG-77 TOG-8 TOG-17 TOG-36 TOG-53 TOG-69 TOG-78 TOG-9 TOG-18 TOG-37 TOG-54 TOG-70 TOG-79 TOG-10 TOG-19 TOG-55 TOG-71 TOG-80 TOG-38 TOG-11 TOG-20 TOG-56 TOG-72 TOG-82 TOG-39 TOG-73 TOG-21 TOG-40 TOG-57 TOG-81 TOG-58 TOG-74 TOG-83 TOG-22 TOG-41 TOG-42 TOG-59 TOG-75 TOG-84 TOG-23 TOG-24 TOG-60 TOG-76 TOG-85 TOG-43 TOG-25 TOG-61 TOG-44 TOG-26 TOG-45 TOG-62 TOG-46 TOG-27 TOG-63 TOG-47 TOG-28 TOG-64 TOG-48 TOG-29 TOG-65 TOG-30 TOG-66 TOG-49 TOG-86 TOG-87 TOG-88 TOG-67 .
     2249     Assign RADIO-SET-2.
     2250     if RADIO-SET-2 = 1 then prod-zen = yes .
     2251     else prod-zen = no .
