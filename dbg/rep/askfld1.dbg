     1777   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1778   procedure minbtn-set :
     1779       do
     1780           on error undo, return error return-value
     1781           :
     1782           define variable ii              as integer       no-undo .
     1783           define variable fh              as widget-handle no-undo .
     1784           define variable hh              as widget-handle no-undo .
     1785           define variable v-h             as handle        extent 4 no-undo .
     1786           define variable v-name-button   as character     no-undo .
     1787           define variable v-help-old-x    as decimal       no-undo .
     1788           define variable v-help-old-y    as decimal       no-undo .
     1789           define variable v-help-old-size as decimal       no-undo .
     1790           define variable v-frame-width   as decimal       no-undo .
     1791           define variable jj              as integer       no-undo .
     1792           do
     1793               on error undo, return error
     1794               :
     1795               assign
     1796                   v-frame-width = frame Dialog-Frame:width - 0.3
     1797                   fh            = frame Dialog-Frame:first-child
     1798                   hh            = fh:first-child
     1799                   ii            = 1
     1800                   .
     1801               do while valid-handle(hh):
     1802                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1803                   do:
     1804                       case lc(hh:name) :
     1805                           when "b-help" then
     1806                               do:
     1807                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1808                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1809                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1810                                   hh:TOOLTIP = "Помощь" .
     1811                                   v-help-old-x = hh:column .
     1812                                   v-help-old-y = hh:row    .
     1813                                   v-help-old-size = hh:width .
     1814                                   hh:width-chars = 2.5 .
     1815                               end.
     1816                           when "b-print" then
     1817                               do:
     1818                                   hh:load-image("cmp/b-print.bmp":u) .
     1819                                   hh:TOOLTIP = "Печать" .
     1820                                   v-h[ii] = hh:handle .
     1821                                   ii = ii + 1 .
     1822                                   hh:width-chars = 3 .
     1823                               end.
     1824                           when "b-history" or
     1825                           when "b-hist" then
     1826                               do:
     1827                                   hh:load-image("cmp/b-hist.bmp":u) .
     1828                                   hh:TOOLTIP = "История" .
     1829                                   v-h[ii] = hh:handle .
     1830                                   ii = ii + 1 .
     1831                                   hh:width-chars = 3 .
     1832                               end.
     1833                           when "b-sch" then
     1834                               do:
     1835                                   hh:load-image("cmp/b-sch.bmp":u) .
     1836                                   hh:TOOLTIP = "Установка Фильтра" .
     1837                                   v-h[ii] = hh:handle .
     1838                                   ii = ii + 1 .
     1839                                   hh:width-chars = 3 .
     1840                               end.
     1841                           when "b-hist-user" then
     1842                               do:
     1843                                   hh:load-image("cmp/b-hist.bmp":u) .
     1844                                   hh:TOOLTIP = "История пользователя" .
     1845                                   ii = ii + 1 .
     1846                               end.
     1847                       end case.
     1848                   end.
     1849                   hh = hh:next-sibling.
     1850               end.
     1851               b-help:column = v-frame-width - b-help:width-chars.
     1852               jj = 0.
     1853               repeat ii = 4 to 1 by -1 :
     1854                   if valid-handle (v-h[ii] ) then
     1855                   do:
     1856                       jj  = jj + 1 .
     1857                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1858                       v-h[ii]:row    = v-help-old-y .
     1859                   end.
     1860               end.
     1861           end.
     1862       end.
     1863   end procedure.
     1864   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
