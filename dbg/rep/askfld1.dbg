      627   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      628     run mainmenu_getcntxt in my-handle
      629       (output v-cntxt-db-num
      630       ,output v-cntxt-userid
      631       ,output v-cntxt-level
      632       ,output v-cntxt-host-code-obj
      633       ,output v-cntxt-obj-type
