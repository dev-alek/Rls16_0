      569   define variable var-report-r-b as character no-undo .
      570   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      571   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      572     (output var-report-r-b
      573     )  .
      574   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      575   define  shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      576   define  shared variable RepPathName        as character no-undo .
      577   define  shared variable PrintRubl          as logical   no-undo .
      578   define variable vss-include-info8 as character format "X(65)" no-undo
      579   initial "@(#)$Workfile$ $Revision$".
      580   define temp-table temp_p-fmt_string-part no-undo
      581       field str-key       as integer
      582       field string-part   as character
      583       index pi is primary unique
      584           str-key
      585   .
      586   define variable v-p-fmt-8-str-key    as integer      no-undo.
      587   FUNCTION center-field RETURNS INTEGER (INPUT iStartPix AS INTEGER, iEndPix AS INTEGER,
      588                                     iInput AS INTEGER).
      589     def var v-start-print as integer no-undo .
      590     if (iStartPix < 0) or (iEndPix < iStartPix) then return 0.
      591     assign
      592       v-start-print = INTEGER(iStartPix + ((iEndPix - iStartPix) / 2) - (iInput / 2))
      593     .
      594     RETURN v-start-print .
      595   END FUNCTION.
      596   FUNCTION right-field RETURNS INTEGER ( iEndPix AS INTEGER,
      597                                     iInput AS INTEGER).
      598     def var v-start-print as integer no-undo .
      599     assign
      600       v-start-print = INTEGER(iEndPix - 1 - iInput)
      601     .
      602     if v-start-print < 0 then return 0.
      603     RETURN v-start-print .
      604   END FUNCTION.
      605   function p-fmt-align-string returns character (
      606         p-in-string      as character
      607       , p-page-width     as integer
      608       , p-align-type     as character
      609   ).
      610       define variable v-string-length     as integer      no-undo.
      611       define variable v-out-string        as character    no-undo.
      612       assign
      613           v-string-length = length( trim( p-in-string ) )
      614       .
      615       if v-string-length >= p-page-width
      616       then do:
      617           assign
      618               v-out-string = trim( p-in-string )
      619           .
      620       end.
      621       else do:
      622           case p-align-type
      623           :
      624               when 'left':U
      625               then do:
      626                   assign
      627                       v-out-string = trim( p-in-string )
      628                   .
      629               end.
      630               when 'right':U
      631               then do:
      632                   assign
      633                       v-out-string = fill( " ":U, p-page-width - v-string-length ) + trim( p-in-string )
      634                   .
      635               end.
      636               when 'center':U
      637               then do:
      638                   assign
      639                       v-out-string = fill( " ":U, integer( ( p-page-width - v-string-length ) / 2 ) ) + trim( p-in-string )
      640                   .
      641               end.
      642           end case.
      643       end.
      644       return v-out-string .
      645   end function.
      646   procedure p-fmt-split-string :
      647   define input parameter p-source-string  as character        no-undo.
      648   define input parameter p-split-length   as integer          no-undo.
      649   define output parameter p-string-1      as character        no-undo.
      650   define output parameter p-string-2      as character        no-undo.
      651   do
      652   on error undo, return error
      653   :
      654       define variable v-space-pos    as integer      no-undo.
      655       if length( p-source-string ) <= p-split-length
      656       then do:
      657           assign
      658               p-string-1 = p-source-string
      659           .
      660       end.
      661       else do:
      662           assign
      663               v-space-pos = r-index( p-source-string, " ":U, p-split-length )
      664           .
      665           if v-space-pos = 0
      666           then do:
      667               assign
      668                   v-space-pos = index( p-source-string, " ":U )
      669               .
      670           end.
      671           if v-space-pos = 0
      672           then do:
      673               assign
      674                   p-string-1 = substring( p-source-string, 1, p-split-length )
      675                   p-string-2 = trim( substring( p-source-string, p-split-length, p-split-length ) )
      676               .
      677           end.
      678           else do:
      679               assign
      680                   p-string-1 = substring( p-source-string, 1, v-space-pos )
      681                   p-string-2 = trim( substring( p-source-string, v-space-pos ) )
      682               .
      683           end.
      684       end.
      685   end.
      686   end procedure.
      687   procedure p-fmt-round :
      688   define input parameter p-qnty               as decimal          no-undo.
      689   define input parameter p-price-no-VAT       as decimal          no-undo.
      690   define input parameter p-VAT                as decimal          no-undo.
      691   define input parameter p-SLT                as decimal          no-undo.
      692   define input parameter p-road-tax           as decimal          no-undo.
      693   define output parameter p-new-price-no-VAT  as decimal          no-undo.
      694   define output parameter p-new-VAT           as decimal          no-undo.
      695   define output parameter p-new-SLT           as decimal          no-undo.
      696   define output parameter p-new-sum-VAT       as decimal          no-undo.
      697   define output parameter p-new-sum-SLT       as decimal          no-undo.
      698   define output parameter p-new-sum-road-tax  as decimal          no-undo.
      699   define output parameter p-new-sum-no-VAT    as decimal          no-undo.
      700   define output parameter p-new-sum-full      as decimal          no-undo.
      701       define variable v-vat-pc    as decimal      no-undo.
      702       define variable v-slt-pc    as decimal      no-undo.
      703   do
      704   on error undo, return error
      705   :
      706       if p-price-no-VAT = 0
      707       then do:
      708           assign
      709               p-new-price-no-VAT = 0.0
      710               p-new-VAT          = ?
      711               p-new-SLT          = ?
      712               p-new-sum-VAT      = 0.0
      713               p-new-sum-SLT      = 0.0
      714               p-new-sum-no-VAT   = 0.0
      715               p-new-sum-road-tax = 0.0
      716               p-new-sum-full     = 0.0
      717           .
      718       end.
      719       else do:
      720           assign
      721               v-vat-pc            = p-VAT / p-price-no-VAT
      722               v-slt-pc            = p-SLT / ( p-price-no-VAT + p-VAT )
      723               p-new-price-no-VAT  = round( p-price-no-VAT, 2 )
      724               p-new-VAT           = round( p-new-price-no-VAT * v-vat-pc, 2 )
      725               p-new-SLT           = round( ( p-new-price-no-VAT + p-new-VAT ) * v-slt-pc, 2 )
      726               p-new-sum-VAT       = round( p-new-VAT          * p-qnty, 2 )
      727               p-new-sum-SLT       = round( ( p-new-price-no-VAT + p-new-VAT ) * p-qnty * v-slt-pc, 2 )
      728               p-new-sum-no-VAT    = round( p-new-price-no-VAT * p-qnty, 2 )
      729               p-new-sum-road-tax  = round( p-road-tax * p-qnty, 2 )
      730               p-new-sum-full      = round( ( p-new-price-no-VAT + p-new-VAT + p-new-SLT + p-road-tax ) * p-qnty, 2 )
      731           .
      732       end.
      733   end.
      734   end procedure.
      735   procedure p-fmt-split :
      736   define input parameter p-in-string      as character        no-undo.
      737   define input parameter p-split-length   as integer          no-undo.
      738       define variable v-start-pos     as integer      no-undo.
      739       define variable v-end-pos       as integer      no-undo.
      740       define buffer buf_temp_p-fmt_string-part        for temp_p-fmt_string-part.
      741   do
      742   for buf_temp_p-fmt_string-part
      743   on error undo, return error
      744   :
      745       empty temp-table buf_temp_p-fmt_string-part.
      746       if p-split-length < 1
      747       then do:
      748           undo, return error substitute( "p-fmt-split: Строка не может быть разбита на &1 частей", p-split-length ).
      749       end.
      750       assign
      751           p-in-string                 = trim( p-in-string )
      752           v-p-fmt-8-str-key   = 0
      753           v-start-pos                 = 1
      754           v-end-pos                   = length( p-in-string )
      755       .
      756       run p-fmt-get-string-range in this-procedure (
      757             input p-in-string
      758           , input p-split-length
      759           , input v-start-pos
      760           , output v-start-pos
      761           , output v-end-pos
      762       ).
      763       do while v-end-pos <> 0
      764       :
      765           create buf_temp_p-fmt_string-part.
      766           assign
      767               v-p-fmt-8-str-key = v-p-fmt-8-str-key + 1
      768           .
      769           assign
      770               buf_temp_p-fmt_string-part.str-key      = v-p-fmt-8-str-key
      771               buf_temp_p-fmt_string-part.string-part  = substring( p-in-string, v-start-pos, v-end-pos - v-start-pos )
      772           .
      773           assign
      774               v-start-pos = v-end-pos + 1
      775           .
      776           run p-fmt-get-string-range in this-procedure (
      777                 input p-in-string
      778               , input p-split-length
      779               , input v-start-pos
      780               , output v-start-pos
      781               , output v-end-pos
      782           ).
      783       end.
      784   end.
      785   end procedure.
      786   procedure p-fmt-get-string-range :
      787   define input parameter p-in-string      as character        no-undo.
      788   define input parameter p-split-length   as integer          no-undo.
      789   define input parameter p-old-start-pos  as integer          no-undo.
      790   define output parameter p-start-pos     as integer          no-undo.
      791   define output parameter p-end-pos       as integer          no-undo.
      792       define variable v-init-string    as character    no-undo.
      793       define variable v-temp-char      as character    no-undo.
      794       define variable v-temp-pos       as integer      no-undo.
      795       define variable v-counter        as integer      no-undo.
      796   do
      797   on error undo, return error
      798   :
      799       assign
      800           p-start-pos   = p-old-start-pos
      801           v-init-string = substring( p-in-string, p-start-pos )
      802       no-error.
      803       if error-status :error
      804       or trim( v-init-string ) = "":U
      805       then do:
      806           assign
      807               p-end-pos = 0
      808           .
      809           undo, return .
      810       end.
      811       assign
      812           v-temp-char   = substring( v-init-string, 1, 1 )
      813       .
      814       do
      815       while trim( v-temp-char ) = "":U
      816       :
      817           assign
      818               p-start-pos     = p-start-pos + 1
      819               v-init-string   = substring( p-in-string, p-start-pos )
      820               v-temp-char     = substring( v-init-string, 1, 1 )
      821           .
      822       end.
      823       assign
      824           v-temp-pos  = p-split-length
      825           v-temp-char = substring( v-init-string, v-temp-pos, 1 )
      826           v-counter   = 0
      827       .
      828       search-word-end:
      829       do
      830       while trim( v-temp-char ) <> "":U
      831       :
      832           assign
      833               v-counter   = v-counter + 1
      834           .
      835           if v-counter > 20
      836           then do:
      837               assign
      838                   v-temp-pos  = p-split-length
      839               .
      840               leave search-word-end.
      841           end.
      842           assign
      843               v-temp-pos  = v-temp-pos - 1
      844               v-temp-char = substring( v-init-string, v-temp-pos, 1 )
      845           .
      846       end.
      847       assign
      848           p-end-pos = p-start-pos + v-temp-pos - 1
      849       .
      850   end.
      851   end procedure.
      852   function excel-format-dec-to-char returns char (input p-dec as decimal ).
      853     if num-entries(string(p-dec), '.') = 2
      854       then return( entry(1, string(p-dec), '.') + v-delim + entry(2, string(p-dec), '.')) .
      855       else return( string(p-dec)) .
      856   end function.
      857   function format-point-to-comma returns char (input orig as char ) .
      858   define variable rtext as character no-undo .
      859   define variable strt as integer no-undo .
      860   define variable leng as integer no-undo .
      861   assign rtext = orig .
      862   repeat:
      863     strt =  index(rtext,'.').
      864     if strt = 0 then leave.
      865     leng = 1.
      866     substring(rtext,strt,leng,"character") = v-delim .
      867   end.
      868   return rtext.
      869   end function.
      870   function format-excel-text returns char ( input start-text as char ) :
      871   def var  i    as int no-undo.
      872   def var  ch   as char no-undo.
      873   def var  n    as int no-undo.
      874   def var  ipos as int no-undo.
      875     n = num-entries(trim(start-text), chr(10)) - 1 .
      876     do i = 1 to n :
      877       ipos = index( start-text, chr(10)).
      878       if ipos > 0 then
      879         substr( start-text, ipos, 1 ) = ' '.
      880     end.
      881     n = num-entries(trim(start-text), chr(13)) - 1 .
      882     do i = 1 to n :
      883       ipos = index( start-text, chr(13)).
      884       if ipos > 0 then
      885         substr( start-text, ipos, 1 ) = ' '.
      886     end.
      887     if index( start-text, '"' ) = 0 then
      888       start-text =  '="'   + trim( start-text) + '"'   .
      889       else do:
      890         n = num-entries(trim(start-text), '"') - 1.
      891         do i = 1 to n :
      892           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
      893         end.
      894         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
      895         start-text = '="'  + ch  + '"' .
      896       end.
      897     return start-text.
      898   end.
      899   function excel-sum returns char (input p-dec as decimal ).
      900     return(format-excel-text(excel-format-dec-to-char(round(p-dec,2)))) .
      901   end function.
      902   function excel-qnty returns char (input p-dec as decimal ).
      903     return(format-excel-text(excel-format-dec-to-char(round(p-dec,3)))) .
      904   end function.
      905   function format-excel-text-macr returns char ( input start-text as char ) :
      906   def var  i    as int no-undo.
      907   def var  ch   as char no-undo.
      908   def var  n    as int no-undo.
      909   def var  ipos as int no-undo.
      910     n = num-entries(trim(start-text), chr(10)) - 1 .
      911     do i = 1 to n :
      912       ipos = index( start-text, chr(10)).
      913       if ipos > 0 then
      914         substring( start-text, ipos , 1 ) = ' '.
      915     end.
      916     n = num-entries(trim(start-text), chr(13)) - 1 .
      917     do i = 1 to n :
      918       ipos = index( start-text, chr(13)).
      919       if ipos > 0 then
      920         substring( start-text, ipos, 1 ) = ' '.
      921     end.
      922     if index( start-text, '"' ) = 0 then
      923       start-text =  '"'   + trim( start-text) + '"'   .
      924       else do:
      925         n = num-entries(trim(start-text), '"') - 1.
      926         do i = 1 to n :
      927           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
      928         end.
      929         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
      930         start-text = '"'  + ch  + '"' .
      931       end.
      932     n = num-entries(trim(start-text), chr(10)) - 1 .
      933     do i = 1 to n :
      934       ipos = index( start-text, chr(10)).
      935       if ipos > 0 then
      936         substring( start-text, ipos , 1 ) = ' '.
      937     end.
      938       if num-entries(trim(start-text), chr(10)) > 1 then  message num-entries(trim(start-text), chr(10)) start-text.
      939     return start-text.
      940   end.
      941   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      942   define temp-table temp-parts no-undo   like ub.parts   field free-qnty as decimal   field free-cli-qnty as decimal .
      943   procedure partslib-clear-temp-parts :
      944     define buffer buf_temp-parts for temp-parts .
      945     do
      946     on error undo, return error
      947     :
      948       for each buf_temp-parts
      949       on error undo, return error
      950       :
      951         delete buf_temp-parts .
      952       end.
      953     end.
      954   end procedure.
      955   procedure partslib-create-temp-parts :
      956     define parameter buffer buf_parts       for ub.parts .
      957     define parameter buffer buf_temp-parts  for temp-parts .
      958     define input  parameter p-goods-twounit as logical   no-undo .
      959     define variable v-base-part-code as character no-undo .
      960     do
      961     on error undo, return error
      962     :
      963       if p-goods-twounit = true
      964       then do:
      965         assign
      966           v-base-part-code = entry(1, buf_parts.part-code, '#':U)
      967         .
      968       end.
      969       else do:
      970         assign
      971           v-base-part-code = buf_parts.part-code
      972         .
      973       end.
      974       find first buf_temp-parts exclusive-lock
      975         where buf_temp-parts.obj-type  = buf_parts.obj-type
      976           and buf_temp-parts.obj-code  = buf_parts.obj-code
      977           and buf_temp-parts.artic     = buf_parts.artic
      978           and buf_temp-parts.prod-type = buf_parts.prod-type
      979           and buf_temp-parts.prod-code = buf_parts.prod-code
      980           and buf_temp-parts.in-code   = buf_parts.in-code
      981           and buf_temp-parts.out-code  = 'free-zone':U
      982           and buf_temp-parts.part-code = v-base-part-code
      983         no-error.
      984       if not available buf_temp-parts
      985       then do:
      986         create buf_temp-parts .
      987         buffer-copy buf_parts to buf_temp-parts
      988         assign
      989           buf_temp-parts.out-code  = 'free-zone':U
      990           buf_temp-parts.part-code = v-base-part-code
      991           buf_temp-parts.rsrv-free = yes
      992           buf_temp-parts.status_   = no
      993           buf_temp-parts.qnty      = 0
      994           buf_temp-parts.fact-qnty = 0
      995           buf_temp-parts.real-qnty = 0
      996           buf_temp-parts.cli-qnty  = 0
      997         .
      998       end.
      999     end.
     1000   end procedure.
     1001   procedure partslib-init-temp-parts :
     1002     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
     1003     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
     1004     define input parameter p-artic           like ub.parts.artic     no-undo .
     1005     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
     1006     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
     1007     define buffer buf_parts      for ub.parts .
     1008     define buffer buf_temp-parts for temp-parts .
     1009     define variable v-goods-twounit    as logical   no-undo .
     1010     do
     1011     on error undo, return error
     1012     :
     1013   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1014   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     1015     (input  p-artic
     1016     ,input  p-prod-type
     1017     ,input  p-prod-code
     1018     ,input  'twounit=request':u
     1019     ,output v-goods-twounit
     1020     ) no-error .
     1021       if error-status :error
     1022       then do:
     1023         message
     1024           vss-workfile vss-revision vss-description skip
     1025           vss-include-info9 skip
     1026           "Ошибка при определении атрибута товара" skip
     1027           "Артикул" p-artic p-prod-type p-prod-code skip
     1028           "twounit=request" skip
     1029           error-status :get-message(1) skip
     1030           return-value skip
     1031           view-as alert-box error .
     1032         undo, return error return-value .
     1033       end.
     1034       run partslib-clear-temp-parts in this-procedure .
     1035       for each buf_parts
     1036         where buf_parts.obj-type  = p-obj-type
     1037           and buf_parts.obj-code  = p-obj-code
     1038           and buf_parts.artic     = p-artic
     1039           and buf_parts.prod-type = p-prod-type
     1040           and buf_parts.prod-code = p-prod-code
     1041           and buf_parts.rsrv-free = yes
     1042           and buf_parts.status_   = no
     1043           and buf_parts.in-code   <> buf_parts.out-code
     1044       on error undo, return error
     1045       :
     1046         run partslib-create-temp-parts in this-procedure
     1047           (buffer buf_parts
     1048           ,buffer buf_temp-parts
     1049           ,input  v-goods-twounit
     1050           ) .
     1051         define variable v-parts-qnty          as decimal   no-undo .
     1052         define variable v-parts-cli-qnty      as decimal   no-undo .
     1053         define variable v-parts-free-qnty     as decimal   no-undo .
     1054         define variable v-parts-free-cli-qnty as decimal   no-undo .
     1055         if buf_parts.out-code = 'free-zone':U
     1056         then do:
     1057           assign
     1058             v-parts-qnty          = buf_parts.qnty
     1059             v-parts-cli-qnty      = buf_parts.cli-qnty
     1060             v-parts-free-qnty     = buf_parts.qnty
     1061             v-parts-free-cli-qnty = buf_parts.cli-qnty
     1062           .
     1063         end.
     1064         else do:
     1065           assign
     1066             v-parts-qnty          = abs(buf_parts.qnty)
     1067             v-parts-cli-qnty      = abs(buf_parts.cli-qnty)
     1068             v-parts-free-qnty     = 0
     1069             v-parts-free-cli-qnty = 0
     1070           .
     1071         end.
     1072         assign
     1073           buf_temp-parts.qnty          = buf_temp-parts.qnty          + v-parts-qnty
     1074           buf_temp-parts.fact-qnty     = buf_temp-parts.fact-qnty     + v-parts-qnty
     1075           buf_temp-parts.real-qnty     = 0
     1076           buf_temp-parts.cli-qnty      = buf_temp-parts.cli-qnty      + v-parts-cli-qnty
     1077           buf_temp-parts.free-qnty     = buf_temp-parts.free-qnty     + v-parts-free-qnty
     1078           buf_temp-parts.free-cli-qnty = buf_temp-parts.free-cli-qnty + v-parts-free-cli-qnty
     1079         .
     1080       end.
     1081     end.
     1082   end procedure.
     1083   procedure partslib-init-temp-parts-by-factord :
     1084     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
     1085     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
     1086     define input parameter p-artic              like ub.parts.artic     no-undo .
     1087     define input parameter p-prod-type          like ub.parts.prod-type no-undo .
     1088     define input parameter p-prod-code          like ub.parts.prod-code no-undo .
     1089     define input parameter p-fact-order         as decimal   no-undo .
     1090     define input parameter p-include-fact-order as logical   no-undo .
     1091     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-factord: определение партий свободной зоны на любую дату".
     1092     define buffer buf_gds-obj  for ub.gds-obj .
     1093     do
     1094     on error undo, return error
     1095     :
     1096       do transaction
     1097       on error undo, return error
     1098       :
     1099   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1100   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     1101     (input  p-obj-type
     1102     ,input  p-obj-code
     1103     ,input  p-artic
     1104     ,input  p-prod-type
     1105     ,input  p-prod-code
     1106     ,buffer buf_gds-obj
     1107     ) no-error .
     1108         if error-status :error
     1109         then do:
     1110           message
     1111             vss-workfile vss-revision vss-description skip
     1112             vss-include-info9 skip
     1113             "Невозможно найти товар на объекте" skip
     1114             "Объект" p-obj-type p-obj-code skip
     1115             "Артикул" p-artic p-prod-type p-prod-code skip
     1116             error-status :get-message(1) skip
     1117             return-value skip
     1118             view-as alert-box error .
     1119           undo, return error .
     1120         end.
     1121         find current buf_gds-obj exclusive-lock .
     1122       end.
     1123       run partslib-init-temp-parts in this-procedure
     1124         (input p-obj-type
     1125         ,input p-obj-code
     1126         ,input p-artic
     1127         ,input p-prod-type
     1128         ,input p-prod-code
     1129         ) no-error .
     1130       if error-status :error
     1131       then do:
     1132         message
     1133           vss-workfile vss-revision vss-description skip
     1134           vss-include-info9 skip
     1135           "Ошибка при инициализации текущего остатка по партиям свободной зоны" skip
     1136           "Объект" p-obj-type p-obj-code skip
     1137           "Артикул" p-artic p-prod-type p-prod-code skip
     1138           "p-fact-order" p-fact-order skip
     1139           view-as alert-box error .
     1140         undo, return error .
     1141       end.
     1142       if p-include-fact-order = true
     1143       then do:
     1144         assign
     1145           p-fact-order = p-fact-order - 0.0000000001
     1146         .
     1147       end.
     1148       define variable v-max-fact-order as character no-undo .
     1149       run factord-max-fact-order in this-procedure
     1150         (output v-max-fact-order
     1151         ) no-error .
     1152       if error-status :error
     1153       then do:
     1154         message
     1155           vss-workfile vss-revision vss-description skip
     1156           vss-include-info9 skip
     1157           "Ошибка при вызове процедуры factord-max-fact-order" skip
     1158           "Объект" p-obj-type p-obj-code skip
     1159           "Артикул" p-artic p-prod-type p-prod-code skip
     1160           "p-fact-order" p-fact-order skip
     1161           view-as alert-box error .
     1162         undo, return error .
     1163       end.
     1164       run partslib-update-by-factord in this-procedure
     1165         (input p-obj-type
     1166         ,input p-obj-code
     1167         ,input p-artic
     1168         ,input p-prod-type
     1169         ,input p-prod-code
     1170         ,input p-fact-order
     1171         ,input v-max-fact-order
     1172         ,input false
     1173         ) no-error .
     1174       if error-status :error
     1175       then do:
     1176         message
     1177           vss-workfile vss-revision vss-description skip
     1178           vss-include-info9 skip
     1179           "Ошибка при вызове процедуры partslib-update-by-factord" skip
     1180           "Объект" p-obj-type p-obj-code skip
     1181           "Артикул" p-artic p-prod-type p-prod-code skip
     1182           "p-fact-order" p-fact-order skip
     1183           "v-max-fact-order" v-max-fact-order skip
     1184           view-as alert-box error .
     1185         undo, return error .
     1186       end.
     1187     end.
     1188   end procedure.
     1189   procedure partslib-update-by-factord :
     1190     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
     1191     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
     1192     define input parameter p-artic              like ub.parts.artic     no-undo .
     1193     define input parameter p-prod-type          like ub.parts.prod-type no-undo .
     1194     define input parameter p-prod-code          like ub.parts.prod-code no-undo .
     1195     define input parameter p-start-fact-order   as decimal   no-undo .
     1196     define input parameter p-end-fact-order     as decimal   no-undo .
     1197     define input parameter p-lock-gds-obj       as logical   no-undo .
     1198     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-factord: определение партий свободной зоны на любую дату".
     1199     define buffer buf_gds-obj  for ub.gds-obj .
     1200     define buffer buf_doc-line for ub.doc-line .
     1201     define variable v-total-parts-qnty as decimal   no-undo .
     1202     define variable v-goods-gds-goods  as logical   no-undo .
     1203     define variable v-goods-twounit    as logical   no-undo .
     1204     do
     1205     on error undo, return error
     1206     :
     1207       if p-start-fact-order > p-end-fact-order
     1208       then do:
     1209         message
     1210           vss-workfile vss-revision vss-description skip
     1211           vss-include-info9 skip
     1212           "Ошибка задания входных параметров" skip
     1213           "Начало интервала превышает конец интервала" skip
     1214           "Объект" p-obj-type p-obj-code skip
     1215           "Артикул" p-artic p-prod-type p-prod-code skip
     1216           "p-start-fact-order" p-start-fact-order skip
     1217           "p-end-fact-order"   p-end-fact-order skip
     1218           view-as alert-box error .
     1219         undo, return error .
     1220       end.
     1221       if p-lock-gds-obj = true
     1222       then do:
     1223         do transaction
     1224         on error undo, return error
     1225         :
     1226   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1227   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     1228     (input  p-obj-type
     1229     ,input  p-obj-code
     1230     ,input  p-artic
     1231     ,input  p-prod-type
     1232     ,input  p-prod-code
     1233     ,buffer buf_gds-obj
     1234     ) no-error .
     1235           if error-status :error
     1236           then do:
     1237             message
     1238               vss-workfile vss-revision vss-description skip
     1239               vss-include-info9 skip
     1240               "Невозможно найти gds-obj" skip
     1241               error-status :get-message(1) skip
     1242               return-value skip
     1243               view-as alert-box error .
     1244             undo, return error .
     1245           end.
     1246           find current buf_gds-obj exclusive-lock .
     1247         end.
     1248       end.
     1249   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1250   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     1251     (input  p-artic
     1252     ,input  p-prod-type
     1253     ,input  p-prod-code
     1254     ,input  'gds-goods=request':u
     1255     ,output v-goods-gds-goods
     1256     ) no-error .
     1257       if error-status :error
     1258       then do:
     1259         message
     1260           vss-workfile vss-revision vss-description skip
     1261           vss-include-info9 skip
     1262           "Ошибка при определении атрибута товара" skip
     1263           "Артикул" p-artic p-prod-type p-prod-code skip
     1264           "gds-goods=request" skip
     1265           error-status :get-message(1) skip
     1266           return-value skip
     1267           view-as alert-box error .
     1268         undo, return error return-value .
     1269       end.
     1270   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1271   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     1272     (input  p-artic
     1273     ,input  p-prod-type
     1274     ,input  p-prod-code
     1275     ,input  'twounit=request':u
     1276     ,output v-goods-twounit
     1277     ) no-error .
     1278       if error-status :error
     1279       then do:
     1280         message
     1281           vss-workfile vss-revision vss-description skip
     1282           vss-include-info9 skip
     1283           "Ошибка при определении атрибута товара" skip
     1284           "Артикул" p-artic p-prod-type p-prod-code skip
     1285           "twounit=request" skip
     1286           error-status :get-message(1) skip
     1287           return-value skip
     1288           view-as alert-box error .
     1289         undo, return error return-value .
     1290       end.
     1291       for each buf_doc-line no-lock
     1292         where buf_doc-line.obj-type   = p-obj-type
     1293           and buf_doc-line.obj-code   = p-obj-code
     1294           and buf_doc-line.artic      = p-artic
     1295           and buf_doc-line.prod-type  = p-prod-type
     1296           and buf_doc-line.prod-code  = p-prod-code
     1297           and buf_doc-line.status_    = 'факт':U
     1298           and buf_doc-line.fact-order > p-start-fact-order
     1299           and buf_doc-line.fact-order <= p-end-fact-order
     1300       on error undo, return error
     1301       :
     1302         run partslib-process-document in this-procedure
     1303           (input  buf_doc-line.doc-code
     1304           ,input  p-obj-type
     1305           ,input  p-obj-code
     1306           ,input  p-artic
     1307           ,input  p-prod-type
     1308           ,input  p-prod-code
     1309           ,input  v-goods-gds-goods
     1310           ,input  v-goods-twounit
     1311           ,output v-total-parts-qnty
     1312           ) no-error .
     1313         if error-status :error
     1314         then do:
     1315           message
     1316             vss-workfile vss-revision vss-description skip
     1317             vss-include-info9 skip
     1318             "Ошибка при вызове процедуры partslib-process-document" skip
     1319             "Документ" buf_doc-line.doc-code skip
     1320             "Объект" p-obj-type p-obj-code skip
     1321             "Артикул" p-artic p-prod-type p-prod-code skip
     1322             "p-start-fact-order" p-start-fact-order skip
     1323             "p-end-fact-order" p-end-fact-order skip
     1324             error-status :get-message(1) skip
     1325             return-value skip
     1326             view-as alert-box error .
     1327           undo, return error return-value .
     1328         end.
     1329       end.
     1330     end.
     1331   end procedure.
     1332   procedure partslib-process-document :
     1333     define input  parameter p-doc-code         as character no-undo .
     1334     define input  parameter p-obj-type         as character no-undo .
     1335     define input  parameter p-obj-code         as integer   no-undo .
     1336     define input  parameter p-artic            as character no-undo .
     1337     define input  parameter p-prod-type        as character no-undo .
     1338     define input  parameter p-prod-code        as integer   no-undo .
     1339     define input  parameter p-goods-gds-goods  as logical   no-undo .
     1340     define input  parameter p-goods-twounit    as logical   no-undo .
     1341     define output parameter p-total-parts-qnty as decimal   no-undo .
     1342     define variable v-parts-sign as integer   no-undo .
     1343     define buffer buf_trn-doc    for ub.trn-doc .
     1344     define buffer buf_doc-line   for ub.doc-line .
     1345     define buffer buf_parts      for ub.parts .
     1346     define buffer buf_temp-parts for temp-parts .
     1347     do
     1348     on error undo, return error return-value
     1349     :
     1350       find first buf_trn-doc no-lock
     1351         where buf_trn-doc.doc-code = p-doc-code
     1352         no-error .
     1353       if not available buf_trn-doc
     1354       then do:
     1355         undo, return error substitute("Ошибка при поиске документа. Документ &1"
     1356                                      ,p-doc-code
     1357                                      ) .
     1358       end.
     1359       case buf_trn-doc.doc-type
     1360       :
     1361         when 'при':U or
     1362         when 'возврат':U or
     1363         when 'инв':U
     1364         then do:
     1365           assign
     1366             v-parts-sign = -1
     1367           .
     1368         end.
     1369         when 'рас':U or
     1370         when 'спи':U
     1371         then do:
     1372           assign
     1373             v-parts-sign = 1
     1374           .
     1375         end.
     1376         otherwise do:
     1377           undo, return error substitute("Неизвестный тип документа &1"
     1378                                       ,buf_trn-doc.doc-type
     1379                                       ) .
     1380         end.
     1381       end.
     1382       find first buf_doc-line no-lock
     1383         where buf_doc-line.doc-code  = p-doc-code
     1384           and buf_doc-line.artic     = p-artic
     1385           and buf_doc-line.prod-type = p-prod-type
     1386           and buf_doc-line.prod-code = p-prod-code
     1387         no-error .
     1388       if not available buf_doc-line
     1389       then do:
     1390         undo, return error substitute("Ошибка при поиске строки документа. Документ &1. Артикул &2 &3 &4"
     1391                                      ,p-doc-code
     1392                                      ,artic
     1393                                      ,prod-type
     1394                                      ,prod-code
     1395                                      ) .
     1396       end.
     1397       assign
     1398         p-total-parts-qnty = 0
     1399       .
     1400       if p-goods-gds-goods = true
     1401       then do:
     1402         for each buf_parts no-lock
     1403           where buf_parts.out-code  = p-doc-code
     1404             and buf_parts.obj-type  = p-obj-type
     1405             and buf_parts.obj-code  = p-obj-code
     1406             and buf_parts.artic     = p-artic
     1407             and buf_parts.prod-type = p-prod-type
     1408             and buf_parts.prod-code = p-prod-code
     1409         on error undo, return error
     1410         :
     1411           run partslib-create-temp-parts in this-procedure
     1412             (buffer buf_parts
     1413             ,buffer buf_temp-parts
     1414             ,input  p-goods-twounit
     1415             ) .
     1416           assign
     1417             p-total-parts-qnty        = p-total-parts-qnty
     1418                                       + v-parts-sign * buf_parts.fact-qnty
     1419             buf_temp-parts.qnty       = buf_temp-parts.qnty
     1420                                       + v-parts-sign * buf_parts.fact-qnty
     1421             buf_temp-parts.fact-qnty  = buf_temp-parts.fact-qnty
     1422                                       + v-parts-sign * buf_parts.fact-qnty
     1423             buf_temp-parts.cli-qnty   = buf_temp-parts.cli-qnty
     1424                                       + v-parts-sign * buf_parts.cli-qnty
     1425           .
     1426           if buf_temp-parts.qnty = 0
     1427           then do:
     1428             delete buf_temp-parts .
     1429           end.
     1430         end.
     1431       end.
     1432       else do:
     1433         assign
     1434           p-total-parts-qnty = p-total-parts-qnty
     1435                              + v-parts-sign * buf_doc-line.fact-qnty
     1436         .
     1437       end.
     1438     end.
     1439   end procedure.
     1440   procedure partslib-init-temp-parts-by-date :
     1441     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
     1442     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
     1443     define input parameter p-artic           like ub.parts.artic     no-undo .
     1444     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
     1445     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
     1446     define input parameter p-fact-date       as date      no-undo .
     1447     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-date: определение партий свободной зоны на любую дату".
     1448     do
     1449     on error undo, return error
     1450     :
     1451       define variable v-fact-order                as decimal   no-undo .
     1452       define variable v-shift-end-fact-order      as decimal   no-undo .
     1453       define variable v-day-end-fact-order        as decimal   no-undo .
     1454       run factord in this-procedure
     1455         (input  p-fact-date
     1456         ,input  1
     1457         ,input  1
     1458         ,input  ?
     1459         ,input  0
     1460         ,input  false
     1461         ,output v-fact-order
     1462         ,output v-shift-end-fact-order
     1463         ,output v-day-end-fact-order
     1464         ) no-error .
     1465       if error-status :error
     1466       then do:
     1467         message
     1468           vss-workfile vss-revision vss-description skip
     1469           vss-include-info9 skip
     1470           "Ошибка при определении момента времени, на который требуется остаток" skip
     1471           "Объект" p-obj-type p-obj-code skip
     1472           "Артикул" p-artic p-prod-type p-prod-code skip
     1473           "Дата" p-fact-date skip
     1474           view-as alert-box error .
     1475         undo, return error .
     1476       end.
     1477       run partslib-init-temp-parts-by-factord in this-procedure
     1478         (input p-obj-type
     1479         ,input p-obj-code
     1480         ,input p-artic
     1481         ,input p-prod-type
     1482         ,input p-prod-code
     1483         ,input v-day-end-fact-order
     1484         ,input false
     1485         ) no-error .
     1486       if error-status :error
     1487       then do:
     1488         message
     1489           vss-workfile vss-revision vss-description skip
     1490           vss-include-info9 skip
     1491           "Ошибка при вызове метода partslib-init-temp-parts-by-factord" skip
     1492           "Объект" p-obj-type p-obj-code skip
     1493           "Артикул" p-artic p-prod-type p-prod-code skip
     1494           "Дата" p-fact-date skip
     1495           view-as alert-box error .
     1496         undo, return error .
     1497       end.
     1498     end.
     1499   end procedure.
     1500   procedure partslib-calc-cost :
     1501     define output parameter p-fact-qnty      as decimal   no-undo .
     1502     define output parameter p-vat-pc         as decimal   no-undo .
     1503     define output parameter p-slt-pc         as decimal   no-undo .
     1504     define output parameter p-sum-base       as decimal   no-undo .
     1505     define output parameter p-sum-rubl       as decimal   no-undo .
     1506     define output parameter p-vat-base       as decimal   no-undo .
     1507     define output parameter p-vat-rubl       as decimal   no-undo .
     1508     define output parameter p-slt-base       as decimal   no-undo .
     1509     define output parameter p-slt-rubl       as decimal   no-undo .
     1510     define output parameter p-road-tax-base  as decimal   no-undo .
     1511     define output parameter p-road-tax-rubl  as decimal   no-undo .
     1512     define output parameter p-transport-base as decimal   no-undo .
     1513     define output parameter p-transport-rubl as decimal   no-undo .
     1514     define output parameter p-other-base     as decimal   no-undo .
     1515     define output parameter p-other-rubl     as decimal   no-undo .
     1516     define output parameter p-excise-base    as decimal   no-undo .
     1517     define output parameter p-excise-rubl    as decimal   no-undo .
     1518     define variable vss-description as character no-undo init "partslib-calc-cost: расчет сумм в учетных ценах".
     1519     do
     1520     on error undo, return error return-value
     1521     :
     1522       define buffer buf_temp-parts for temp-parts .
     1523       define buffer   in-vatp-trn-doc  for ub.trn-doc .
     1524       define buffer   in-vatp-parts    for ub.parts   .
     1525       define buffer   in-vatp-doc      for ub.trn-doc .
     1526       define buffer   in-vatp-goods    for ub.goods   .
     1527       define buffer   in-vatp-sysconf  for ub.sysconf .
     1528       define buffer   in-vatp_doc-attr for ub.doc-attr.
     1529       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
     1530       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
     1531       define variable varinvprb                  as   character              no-undo.
     1532       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
     1533       define variable cli-base-rate              as   decimal                no-undo.
     1534       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
     1535       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
     1536       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
     1537       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
     1538       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
     1539       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
     1540       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
     1541       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
     1542       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
     1543       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
     1544       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
     1545       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
     1546       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
     1547       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
     1548       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
     1549       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
     1550       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
     1551       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
     1552       define variable other-base-loc             like ub.doc-line.price-base no-undo.
     1553       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
     1554       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
     1555       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
     1556       define variable varinvatp-envd             as   character              no-undo.
     1557       define variable varinvatp-type             as   character              no-undo.
     1558       for each buf_temp-parts
     1559       on error undo, return error
     1560       :
     1561   assign
     1562     price-rubl-with-tax-loc = buf_temp-parts.price-rubl
     1563     price-base-with-tax-loc = buf_temp-parts.price-base
     1564   .
     1565   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1566   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1567     (output varinvprb
     1568     )  .
     1569     if buf_temp-parts.out-code = 'free-zone':U     or
     1570        buf_temp-parts.out-code = 'out-zone':U   or
     1571        buf_temp-parts.doc-type = 'акт':U then do:
     1572       assign
     1573         in-vatp-have-vat-slt = yes.
     1574     end.
     1575     else do:
     1576       find first in-vatp_doc-attr no-lock
     1577         where in-vatp_doc-attr.doc-code  = buf_temp-parts.out-code
     1578           and in-vatp_doc-attr.attr-code = 'envd':U
     1579         no-error .
     1580       if not available in-vatp_doc-attr then do:
     1581         assign
     1582           in-vatp-have-vat-slt = yes.
     1583       end.
     1584       else do:
     1585            in-vatp-have-vat-slt = no.
     1586       end.
     1587     end.
     1588     assign
     1589      price-cli-with-tax-loc = buf_temp-parts.price-cli
     1590      cli-base-rate          = buf_temp-parts.cli-base-rate.
     1591     ASSIGN   road-tax-base-loc  = (if buf_temp-parts.road-tax-base  = ? then 0 else buf_temp-parts.road-tax-base)
     1592              road-tax-rubl-loc  = (if buf_temp-parts.road-tax-rubl  = ? then 0 else buf_temp-parts.road-tax-rubl).
     1593     ASSIGN  transport-base-loc = (if buf_temp-parts.transport-base = ? then 0 else buf_temp-parts.transport-base)
     1594             transport-rubl-loc = (if buf_temp-parts.transport-rubl = ? then 0 else buf_temp-parts.transport-rubl)
     1595             other-base-loc     = (if buf_temp-parts.other-base     = ? then 0 else buf_temp-parts.other-base)
     1596             other-rubl-loc     = (if buf_temp-parts.other-rubl     = ? then 0 else buf_temp-parts.other-rubl)
     1597             vat-pc-loc         = (if buf_temp-parts.vat-pc         = ? then 0 else buf_temp-parts.vat-pc)
     1598             slt-pc-loc         = (if buf_temp-parts.slt-pc         = ? then 0 else buf_temp-parts.slt-pc).
     1599             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     1600       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     1601     assign
     1602       exch-rate-cli-loc = (buf_temp-parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if buf_temp-parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if buf_temp-parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / buf_temp-parts.price-cli .
     1603     assign
     1604       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
     1605       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
     1606       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
     1607       transport-cli-loc  = 0
     1608       other-cli-loc      = 0
     1609     .
     1610   ASSIGN
     1611             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     1612       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     1613   .
     1614         assign
     1615           p-fact-qnty      = p-fact-qnty      + buf_temp-parts.fact-qnty
     1616           p-vat-pc         = p-vat-pc         + vat-pc-loc
     1617           p-slt-pc         = p-slt-pc         + slt-pc-loc
     1618           p-sum-base       = p-sum-base       + price-base-with-tax-loc * buf_temp-parts.fact-qnty
     1619           p-sum-rubl       = p-sum-rubl       + price-rubl-with-tax-loc * buf_temp-parts.fact-qnty
     1620           p-vat-base       = p-vat-base       + vat-base-loc            * buf_temp-parts.fact-qnty
     1621           p-vat-rubl       = p-vat-rubl       + vat-rubl-loc            * buf_temp-parts.fact-qnty
     1622           p-slt-base       = p-slt-base       + slt-base-loc            * buf_temp-parts.fact-qnty
     1623           p-slt-rubl       = p-slt-rubl       + slt-rubl-loc            * buf_temp-parts.fact-qnty
     1624           p-road-tax-base  = p-road-tax-base  + road-tax-base-loc       * buf_temp-parts.fact-qnty
     1625           p-road-tax-rubl  = p-road-tax-rubl  + road-tax-rubl-loc       * buf_temp-parts.fact-qnty
     1626           p-transport-base = p-transport-base + transport-base-loc      * buf_temp-parts.fact-qnty
     1627           p-transport-rubl = p-transport-rubl + transport-rubl-loc      * buf_temp-parts.fact-qnty
     1628           p-other-base     = p-other-base     + other-base-loc          * buf_temp-parts.fact-qnty
     1629           p-other-rubl     = p-other-rubl     + other-rubl-loc          * buf_temp-parts.fact-qnty
     1630           p-excise-base    = p-excise-base    + 0
     1631           p-excise-rubl    = p-excise-rubl    + 0
     1632         .
     1633       end.
     1634       if p-fact-qnty      = ?
     1635       or p-sum-base       = ?
     1636       or p-sum-rubl       = ?
     1637       or p-vat-base       = ?
     1638       or p-vat-rubl       = ?
     1639       or p-slt-base       = ?
     1640       or p-slt-rubl       = ?
     1641       or p-road-tax-base  = ?
     1642       or p-road-tax-rubl  = ?
     1643       or p-transport-base = ?
     1644       or p-transport-rubl = ?
     1645       or p-other-base     = ?
     1646       or p-other-rubl     = ?
     1647       or p-excise-base    = ?
     1648       or p-excise-rubl    = ?
     1649       then do:
     1650         message
     1651           vss-workfile vss-revision vss-description skip
     1652           vss-include-info9 skip
     1653           "Программа in-vatp.i вернула неопределенные значения" skip
     1654           "p-fact-qnty"      p-fact-qnty      skip
     1655           "p-sum-base"       p-sum-base       skip
     1656           "p-sum-rubl"       p-sum-rubl       skip
     1657           "p-vat-base"       p-vat-base       skip
     1658           "p-vat-rubl"       p-vat-rubl       skip
     1659           "p-slt-base"       p-slt-base       skip
     1660           "p-slt-rubl"       p-slt-rubl       skip
     1661           "p-road-tax-base"  p-road-tax-base  skip
     1662           "p-road-tax-rubl"  p-road-tax-rubl  skip
     1663           "p-transport-base" p-transport-base skip
     1664           "p-transport-rubl" p-transport-rubl skip
     1665           "p-other-base"     p-other-base     skip
     1666           "p-other-rubl"     p-other-rubl     skip
     1667           "p-excise-base"    p-excise-base    skip
     1668           "p-excise-rubl"    p-excise-rubl    skip
     1669           view-as alert-box error .
     1670         undo, return error .
     1671       end.
     1672     end.
     1673   end procedure.
     1674   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1675   procedure cur-time :
     1676      define output parameter p-today as date      no-undo .
     1677      define output parameter p-time  as integer   no-undo .
     1678     do
     1679     on error undo, return error
     1680     :
     1681       define variable v-date1 as date      no-undo .
     1682       define variable v-date2 as date      no-undo .
     1683       define variable v-time  as integer   no-undo .
     1684       assign
     1685         v-date1 = today
     1686         v-time  = time
     1687         v-date2 = today
     1688       .
     1689       if v-date1 <> v-date2
     1690       then do:
     1691         assign
     1692           v-date1 = today
     1693           v-time  = v-time
     1694         .
     1695       end.
     1696       assign
     1697         p-today = v-date1
     1698         p-time  = v-time
     1699       .
     1700     end.
     1701   end.
     1702   function cur-time-date returns character
     1703   :
     1704     return string(today, '99/99/9999':U) .
     1705   end.
     1706   function cur-time-mjd returns decimal
     1707   :
     1708     define variable v-date as date      no-undo .
     1709     define variable v-time as integer   no-undo .
     1710     run cur-time in this-procedure
     1711       (output v-date
     1712       ,output v-time
     1713       ) .
     1714     return integer(v-date) - 2400002 + (v-time / 86400) .
     1715   end.
     1716   function cur-time-get-ending-index returns integer
     1717   (input p-number as integer
     1718   )
     1719   :
     1720     if p-number < 0
     1721     or p-number = ?
     1722     then do:
     1723       return 1 .
     1724     end.
     1725     define variable v-rest as integer   no-undo .
     1726     assign
     1727       p-number = p-number modulo 100
     1728     .
     1729     if p-number < 20
     1730     then do:
     1731       assign
     1732         v-rest = p-number
     1733       .
     1734     end.
     1735     else do:
     1736       assign
     1737         v-rest = p-number modulo 10
     1738       .
     1739     end.
     1740     case v-rest :
     1741       when 1
     1742       then do:
     1743         return 2 .
     1744       end.
     1745       when 2 or
     1746       when 3 or
     1747       when 4
     1748       then do:
     1749         return 3 .
     1750       end.
     1751       otherwise do:
     1752         return 1 .
     1753       end.
     1754     end case .
     1755   end.
     1756   procedure cur-time-mjd-to-date :
     1757      define input  parameter i-mjd-diff as decimal no-undo.
     1758      define output parameter o-Date     as date    no-undo.
     1759      define output parameter o-Time     as integer no-undo.
     1760      define variable v-day-number as integer   no-undo .
     1761      if    i-mjd-diff < 0
     1762         or i-mjd-diff = ?
     1763      then do:
     1764         return "?" .
     1765      end.
     1766      assign
     1767         v-day-number = truncate(i-mjd-diff,0).
     1768         o-Date = date(v-day-number + 2400002).
     1769         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     1770     .
     1771   end.
     1772   function cur-time-mjd-to-string returns character
     1773   (input p-mjd-diff as decimal
     1774   )
     1775   :
     1776     define variable v-day-number as integer   no-undo .
     1777     define variable v-seconds    as integer   no-undo .
     1778     define variable v-hour       as integer   no-undo .
     1779     define variable v-min        as integer   no-undo .
     1780     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     1781     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     1782     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     1783     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1784     if p-mjd-diff < 0
     1785     or p-mjd-diff = ?
     1786     then do:
     1787       return "?" .
     1788     end.
     1789     assign
     1790       v-day-number = integer(truncate(p-mjd-diff,0))
     1791       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1792     .
     1793     if v-seconds > 86400
     1794     then do:
     1795       assign
     1796         v-seconds = 86400 - 1
     1797       .
     1798     end.
     1799     if v-seconds < 0
     1800     then do:
     1801       assign
     1802         v-seconds = 0
     1803       .
     1804     end.
     1805     assign
     1806       v-hour = truncate(v-seconds / 3600, 0)
     1807     .
     1808     assign
     1809       v-seconds = v-seconds modulo 3600
     1810     .
     1811     assign
     1812       v-min = truncate(v-seconds / 60, 0)
     1813     .
     1814     assign
     1815       v-seconds = v-seconds modulo 60
     1816     .
     1817     return
     1818         (if v-day-number <> 0
     1819           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1820           else ""
     1821         )
     1822       + (if v-day-number <> 0 or v-hour <> 0
     1823           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1824           else ""
     1825         )
     1826       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1827           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1828           else ""
     1829         )
     1830       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1831       .
     1832   end.
     1833   function cur-time-string returns character
     1834   :
     1835     define variable v-date as date      no-undo .
     1836     define variable v-time as integer   no-undo .
     1837     run cur-time in this-procedure
     1838       (output v-date
     1839       ,output v-time
     1840       ) .
     1841     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1842   end.
     1843   function cur-time-string-sec returns character
     1844   :
     1845     define variable v-date as date      no-undo .
     1846     define variable v-time as integer   no-undo .
     1847     run cur-time in this-procedure
     1848       (output v-date
     1849       ,output v-time
     1850       ) .
     1851     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1852   end.
     1853   function cur-time-custom  returns character
     1854   (input p-prefix as character
     1855   ,input p-date-format as character
     1856   ,input p-delimiter as character
     1857   ,input p-time-format as character
     1858   ,input p-suffix as character
     1859   )
     1860   :
     1861     define variable v-date as date      no-undo .
     1862     define variable v-time as integer   no-undo .
     1863     run cur-time in this-procedure
     1864       (output v-date
     1865       ,output v-time
     1866       ) .
     1867     return
     1868       p-prefix
     1869       + string(v-date, p-date-format)
     1870       + p-delimiter
     1871       + string(v-time, p-time-format)
     1872       + p-suffix
     1873       .
     1874   end.
     1875   function cur-time-print  returns character
     1876   :
     1877     define variable v-date as date      no-undo .
     1878     define variable v-time as integer   no-undo .
     1879     run cur-time in this-procedure
     1880       (output v-date
     1881       ,output v-time
     1882       ) .
     1883     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1884   end.
     1885   function cur-time-datetime returns datetime
