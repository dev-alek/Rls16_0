     2050   define temp-table temp-font no-undo
     2051     field fontnum  as integer
     2052     field fontname as character
     2053     field fontsize as character
     2054     field fonttype as character
     2055     field font-h   as integer
     2056     field font-w   as integer
     2057     field v-row    as integer
     2058     field v-col    as integer
     2059     field v-row-lans as integer
     2060     field v-col-lans as integer
     2061   index pi fontnum
     2062   .
     2063   procedure get-font-ini :
     2064     do
     2065     on error undo, return error return-value
     2066     :
     2067   define variable ii as integer   no-undo .
     2068   define variable v-font7 as character no-undo .
     2069   define variable v-font as character no-undo .
     2070   define variable loc-name as character no-undo .
     2071   define variable loc-size as character no-undo .
     2072   define variable loc-type as character no-undo .
     2073   define variable old_H as integer   no-undo .
     2074   define variable old_w as integer   no-undo .
     2075   define variable old-row  as integer   no-undo .
     2076   define variable old-col  as integer   no-undo .
     2077   define variable old-row-lans  as integer   no-undo .
     2078   define variable old-col-lans  as integer   no-undo .
     2079   define variable vv as integer   no-undo .
     2080   empty temp-table temp-font.
     2081     GET-KEY-VALUE SECTION "fonts" KEY "font7" VALUE v-font7 .
     2082       case num-entries (v-font7) :
     2083         when 4 then do:
     2084             assign
     2085               loc-name = entry ( 1 , v-font7 )
     2086               loc-size = entry ( 2 , v-font7 )
     2087               loc-type = entry ( 3 , v-font7 ) + "," +  entry ( 4 , v-font7 )
     2088             .
     2089         end.
     2090         when 3 then do:
     2091             assign
     2092               loc-name = entry ( 1 , v-font7 )
     2093               loc-size = entry ( 2 , v-font7 )
     2094               loc-type = entry ( 3 , v-font7 )
     2095             .
     2096         end.
     2097         when 2 then  do:
     2098             assign
     2099               loc-name = entry ( 1 , v-font7 )
     2100               loc-size = entry ( 2 , v-font7 )
     2101               loc-type = ""
     2102             .
     2103         end.
     2104         when 1 then do:
     2105             assign
     2106               loc-name = trim(entry ( 1 , v-font7 ))
     2107               loc-size = ""
     2108               loc-type = ""
     2109             .
     2110         end.
     2111       end case.
     2112     create temp-font.
     2113     assign
     2114       temp-font.fontnum  = 7
     2115       temp-font.fontname = trim(loc-name)
     2116       temp-font.fontsize = trim(loc-size)
     2117       temp-font.fonttype = trim(loc-type)
     2118       temp-font.v-row    = 62
     2119       temp-font.v-col    = 136
     2120       temp-font.v-row-lans = 43
     2121       temp-font.v-col-lans = 198
     2122     .
     2123     repeat ii = 16 to 100 :
     2124       get-key-value section 'fonts' key 'font' + string(ii)   value v-font  .
     2125       if v-font = "" or v-font = ? then leave.
     2126       case num-entries (v-font) :
     2127         when 4 then do:
     2128             assign
     2129               loc-name = entry ( 1 , v-font )
     2130               loc-size = entry ( 2 , v-font )
     2131               loc-type = entry ( 3 , v-font ) + "," +  entry ( 4 , v-font )
     2132             .
     2133         end.
     2134         when 3 then do:
     2135             assign
     2136               loc-name = entry ( 1 , v-font )
     2137               loc-size = entry ( 2 , v-font )
     2138               loc-type = entry ( 3 , v-font )
     2139             .
     2140         end.
     2141         when 2 then do:
     2142             assign
     2143               loc-name = entry ( 1 , v-font )
     2144               loc-size = entry ( 2 , v-font )
     2145               loc-type = ""
     2146             .
     2147         end.
     2148         when 1 then do:
     2149             assign
     2150               loc-name = trim(entry ( 1 , v-font ))
     2151               loc-size = ""
     2152               loc-type = ""
     2153             .
     2154         end.
     2155       end case.
     2156     create temp-font.
     2157     assign
     2158       temp-font.fontnum  = ii
     2159       temp-font.fontname = trim(loc-name)
     2160       temp-font.fontsize = trim(loc-size)
     2161       temp-font.fonttype = trim(loc-type)
     2162     .
     2163     end.
     2164       for each temp-font :
     2165          vv = integer(entry(2,temp-font.fontsize, "=" )) no-error .
     2166          if  vv = ? then vv =  0 .
     2167           run rep/exfont.p (
     2168             input   temp-font.fontname ,
     2169             input   vv ,
     2170             input   temp-font.fonttype ,
     2171             output  temp-font.font-h   ,
     2172             output  temp-font.font-w   )
     2173           .
     2174       end.
     2175   find first temp-font where  temp-font.fontnum  = 7  .
     2176   old_H = temp-font.font-H .
     2177   old_w = temp-font.font-W .
     2178   old-row = temp-font.v-row .
     2179   old-col = temp-font.v-col .
     2180   old-row-lans = temp-font.v-row-lans .
     2181   old-col-lans = temp-font.v-col-lans .
     2182       for each temp-font where
     2183                temp-font.fontnum  <> 7 :
     2184           assign
     2185               temp-font.v-row    = old_H * old-row / temp-font.font-h
     2186               temp-font.v-col    = old_W * old-col / temp-font.font-W
     2187               temp-font.v-row-lans    = old_H * old-row-lans / temp-font.font-h
     2188               temp-font.v-col-lans    = old_W * old-col-lans / temp-font.font-W
     2189           .
     2190       end.
     2191     end.
     2192   end procedure.
     2193   PROCEDURE How-name :
     2194   define input  parameter h as integer no-undo .
     2195   define input  parameter w as integer no-undo .
     2196   define output parameter n as character  no-undo .
     2197   define variable A4port-H as integer   no-undo init 63.
     2198   define variable A4port-W as integer   no-undo init 136.
     2199   define variable A4lans-H as integer   no-undo init 43.
     2200   define variable A4lans-W as integer   no-undo init 198.
     2201   define variable Strim-W  as integer   no-undo init 278.
     2202   run define-a4-size (
     2203        input ReportFontNum
     2204       ,output A4port-H
     2205       ,output A4port-W
     2206       ,output A4lans-H
     2207       ,output A4lans-W ).
     2208   If w >= 1 and w <= A4port-W Then DO:
     2209     If h >= 1  and h <= A4lans-H Then n = "A4-lans":U.
     2210     If h > A4lans-H  and h <= A4port-H Then n = "A4-port":U.
     2211     If h > A4port-H              Then n = "to-file":U.
     2212   End.
     2213   If w > A4port-W and w <= A4lans-W Then DO:
     2214     If h >= 1  and h <= A4lans-H Then n = "A4-lans":U.
     2215     If h > A4lans-H  and h <= A4port-H Then n = "A3-lans":U.
     2216     If h > A4port-H              Then n = "to-file":U.
     2217   End.
     2218   If w > A4lans-W and w <= Strim-W Then DO:
     2219     If h >= 1  and h <= A4lans-H Then n = "to-file":U.
     2220     If h > A4lans-H  and h <= A4port-H Then n = "A3-lans":U.
     2221     If h > A4port-H              Then n = "to-file":U.
     2222   End.
     2223   If w > Strim-W Then DO:
     2224      n = "to-file":U.
     2225   End.
     2226   END PROCEDURE.
     2227   PROCEDURE define-a4-size :
     2228   define input  parameter p-ReportFontNum as integer   no-undo .
     2229   define output parameter A4port-H as integer   no-undo .
     2230   define output parameter A4port-W as integer   no-undo .
     2231   define output parameter A4lans-H as integer   no-undo .
     2232   define output parameter A4lans-W as integer   no-undo .
     2233   if not can-find (first temp-font ) then do:
     2234      run get-font-ini .
     2235   end.
     2236   find first temp-font where temp-font.fontnum = p-ReportFontNum no-error .
     2237   if available temp-font then do:
     2238   assign
     2239     A4port-H = temp-font.v-row
     2240     A4port-W = temp-font.v-col
     2241     A4lans-H = temp-font.v-row-lans
     2242     A4lans-W = temp-font.v-col-lans
     2243   .
     2244   end.
     2245   else do:
     2246   assign
     2247     A4port-H = 63
     2248     A4port-W = 136
     2249     A4lans-H = 43
     2250     A4lans-W = 198
     2251   .
     2252   end.
     2253   END PROCEDURE.
