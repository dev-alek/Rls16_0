     1900   procedure godendo-date-to-offset :
     1901     define input  parameter p-today  as date      no-undo .
     1902     define input  parameter p-date   as date      no-undo .
     1903     define output parameter p-offset as integer   no-undo .
     1904     do
     1905     on error undo, return error return-value
     1906     :
     1907       if p-date  = ?
     1908       or p-today = ?
     1909       then do:
     1910         assign
     1911           p-offset = ?
     1912         .
     1913       end.
     1914       else do:
     1915         assign
     1916           p-offset = p-date - p-today + 1
     1917         .
     1918       end.
     1919     end.
     1920   end procedure.
     1921   procedure godendo-offset-to-date :
     1922     define input  parameter p-today  as date      no-undo .
     1923     define input  parameter p-offset as integer   no-undo .
     1924     define output parameter p-date   as date      no-undo .
     1925     do
     1926     on error undo, return error return-value
     1927     :
     1928       if p-today  = ?
     1929       or p-offset = ?
     1930       then do:
     1931         assign
     1932           p-date = ?
     1933         .
     1934       end.
     1935       else do:
     1936         assign
     1937           p-date = p-offset + p-today - 1
     1938         .
     1939       end.
     1940     end.
     1941   end procedure.
