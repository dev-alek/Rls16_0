     1225   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1226   FUNCTION fnc-base-price RETURN decimal (local-bc      as integer,
     1227                                           local-doc-num as char).
     1228   define buffer base-price        for ub.price-list.
     1229   define variable local-main-code like ub.bar-code.b-code no-undo.
     1230   define variable local-base-code like ub.bar-code.b-code no-undo.
     1231     run prc-base-code (input local-bc, output local-base-code).
     1232     find base-price no-lock where
     1233          base-price.doc-num = local-doc-num and
     1234          base-price.b-code  = local-base-code and
     1235          base-price.price-type = "" no-error.
     1236     if not available base-price then do:
     1237       run prc-main-code (input local-bc, output local-main-code).
     1238       find  base-price no-lock where
     1239             base-price.doc-num = local-doc-num and
     1240             base-price.b-code  = local-main-code and
     1241             base-price.price-type = "" no-error.
     1242     end.
     1243     if available base-price then
     1244       return (base-price.price-sale).
     1245     else
     1246       return (?).
     1247   END FUNCTION.
     1248   procedure prc-main-code:
     1249   define input  parameter local-bc        like ub.bar-code.b-code no-undo.
     1250   define output parameter local-main-code like ub.bar-code.b-code no-undo.
     1251   define buffer local-bar-code        for ub.bar-code.
     1252   define buffer local-goods           for ub.goods.
     1253   define buffer main-code             for ub.bar-code.
     1254   define buffer main-prt              for ub.gds-prt.
     1255     local-main-code = ?.
     1256     find local-bar-code no-lock where
     1257          local-bar-code.b-code = local-bc no-error.
     1258     if not available local-bar-code then
     1259       return.
     1260     find local-goods no-lock where
     1261          local-goods.gds-code = local-bar-code.gds-code.
     1262     find first  main-prt no-lock where
     1263                 main-prt.upper-code = local-goods.prt-root.
     1264     find  main-code no-lock where
     1265           main-code.gds-code  = local-bar-code.gds-code and
     1266           main-code.in-code   = "" and
     1267           main-code.part-code = "" and
     1268           main-code.unit-cli  = local-goods.unit-base and
     1269           main-code.node-code = main-prt.node-code.
     1270     local-main-code = main-code.b-code.
     1271   end procedure.
     1272   procedure prc-base-code:
     1273   define input  parameter local-bc        like ub.bar-code.b-code no-undo.
     1274   define output parameter local-base-code like ub.bar-code.b-code no-undo.
     1275   define buffer local-bar-code for ub.bar-code.
     1276   define buffer local-goods    for ub.goods.
     1277   define buffer base-code      for ub.bar-code.
     1278     local-base-code = ?.
     1279     find local-bar-code no-lock where
     1280          local-bar-code.b-code = local-bc no-error.
     1281     if not available local-bar-code then
     1282       return.
     1283     find local-goods no-lock where
     1284          local-goods.gds-code = local-bar-code.gds-code.
     1285     find base-code no-lock where
     1286          base-code.gds-code  = local-bar-code.gds-code and
     1287          base-code.node-code = local-bar-code.node-code and
     1288          base-code.in-code   = local-bar-code.in-code and
     1289          base-code.part-code = local-bar-code.part-code and
     1290          base-code.unit-cli  = local-goods.unit-base.
     1291     local-base-code = base-code.b-code.
     1292   end procedure.
     1293   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1294   procedure dr-katp :
     1295   define input parameter p-gds-code as integer no-undo .
     1296   define input parameter p-b-code as integer no-undo .
     1297   define input parameter p-obj-type as character no-undo .
     1298   define input parameter p-obj-code as integer no-undo .
     1299   define input parameter p-dflt-cd as character no-undo .
     1300   define input parameter p-base-price as decimal no-undo .
     1301   define input parameter p-how-kat-disc as character no-undo .
     1302   define input parameter p-fact-order as decimal no-undo .
     1303   define output parameter p-netto-price as decimal no-undo .
     1304   define variable v-d-value as decimal no-undo .
     1305   define variable v-type as character no-undo .
     1306   define variable v-value-type as integer no-undo .
     1307   define variable v-discnt-type as integer no-undo .
     1308   define variable v-rule-num as integer no-undo .
     1309   define variable v-disc-price-sale as decimal no-undo .
     1310   define variable v-pdf-id as integer no-undo .
     1311   define variable v-pdf-db-num as integer no-undo .
     1312   define buffer buf_dis-gds-rule for ub.dis-gds-rule.
     1313   define buffer buf_Dis-rule for ub.dis-rule.
     1314   define buffer term_dis-rule for ub.dis-rule.
     1315   main-block:
     1316   do
     1317   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info5, return-value, chr(10), error-status :get-message (1))
     1318   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info5 )
     1319   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info5 )
     1320   :
     1321     if p-base-price = ?
     1322     or p-base-price  <= 0
     1323     then do:
     1324       undo main-block, return error substitute("Неверно задана базовая цена (&1) для товара &2 на &3&4"
     1325                                     , p-base-price
     1326                                     , p-gds-code
     1327                                     , p-obj-type
     1328                                     , p-obj-code).
     1329     end.
     1330     case entry(1, how-pcnt-kat, "="):
     1331       when 'pcnt-kat':U then do:
     1332     find first  buf_dis-gds-rule No-LOCK  where
     1333               buf_dis-gds-rule.gds-code = p-gds-code
     1334           AND  buf_dis-gds-rule.obj-code = p-obj-code
     1335           AND  buf_dis-gds-rule.obj-type = p-obj-type
     1336           and  buf_dis-gds-rule.pos-type = p-dflt-cd
     1337           and  buf_dis-gds-rule.discnt-role = 'pcnt-kat':U
     1338           no-error .
     1339         if available buf_dis-gds-rule
     1340         and buf_dis-gds-rule.nonunique <> ''
     1341         and buf_dis-gds-rule.nonunique <> string(p-b-code) then do:
     1342           find first  buf_dis-gds-rule No-LOCK  where
     1343                     buf_dis-gds-rule.gds-code = p-gds-code
     1344                 AND  buf_dis-gds-rule.obj-code = p-obj-code
     1345                 AND  buf_dis-gds-rule.obj-type = p-obj-type
     1346                 and  buf_dis-gds-rule.pos-type = p-dflt-cd
     1347                 and  buf_dis-gds-rule.discnt-role = 'pcnt-kat':U
     1348                 and  buf_dis-gds-rule.nonunique = string(p-b-code)
     1349                 no-error .
     1350         end.
     1351     if not available buf_Dis-gds-rule then do:
     1352       p-netto-price = p-base-price.
     1353       return.
     1354     end.
     1355     find first buf_dis-rule no-lock where
     1356               buf_dis-rule.rule-num = buf_dis-gds-rule.rule-num no-error.
     1357     if not available buf_dis-rule
     1358     or not (buf_dis-rule.obj-type = p-obj-type
     1359             and
     1360             buf_dis-rule.obj-code = p-obj-code)
     1361     then do:
     1362        undo main-block, return error substitute("Не найдено правило категорийной скидки &1 для товара &2 на &3&4 с местом действия &5"
     1363                                     , buf_dis-gds-rule.rule-num
     1364                                     , p-gds-code
     1365                                     , p-obj-type
     1366                                     , p-obj-code
     1367                                     , p-dflt-cd
     1368                                                                       ).
     1369     end.
     1370     if buf_dis-rule.templ-rl-root = 34
     1371     then do:
     1372        undo main-block, return error substitute("Нельзя найти категорийную скидку - правило категорийной скидки &1 для товара &2 на &3&4 имеет шаблон &5"
     1373                                     , buf_dis-gds-rule.rule-num
     1374                                     , p-gds-code
     1375                                     , p-obj-type
     1376                                     , p-obj-code
     1377                                     , buf_dis-rule.templ-rl-root
     1378                                                                       ).
     1379     end.
     1380     if buf_dis-rule.is-term = no then do:
     1381       find  term_dis-rule no-lock where
     1382                       term_dis-rule.upper-rule-num = buf_dis-rule.rule-num no-error.
     1383       if not available term_dis-rule
     1384       or ambiguous term_dis-rule then do:
     1385        undo main-block, return error substitute("Не удается однозначно определить тип и значение категорийной скидки (правило &1) для товара &2 на &3&4"
     1386                                     , buf_dis-gds-rule.rule-num
     1387                                     , p-gds-code
     1388                                     , p-obj-type
     1389                                     , p-obj-code
     1390                                                                       ).
     1391       end.
     1392       assign
     1393       v-value-type = term_Dis-rule.value-type
     1394       v-d-value = term_dis-rule.discnt-value
     1395       v-discnt-type = term_dis-rule.discnt-type
     1396       .
     1397     end.
     1398     else do:
     1399       assign
     1400       v-value-type = buf_Dis-rule.value-type
     1401       v-d-value = buf_dis-rule.discnt-value
     1402       v-discnt-type = buf_Dis-rule.discnt-type
     1403       .
     1404     end.
     1405       if v-discnt-type <> 12 then do:
     1406        undo main-block, return error substitute("Нельзя найти категорийную скидку - правило категорийной скидки &1 для товара &2 на &3&4 привязано к расписанию"
     1407                                     , buf_dis-gds-rule.rule-num
     1408                                     , p-gds-code
     1409                                     , p-obj-type
     1410                                     , p-obj-code
     1411                                                                       ).
     1412     end.
     1413     case v-value-type:
     1414       when integer('2':U) then do:
     1415         assign
     1416         p-netto-price = p-base-price - v-d-value
     1417         .
     1418       end.
     1419       when integer('1':U) then do:
     1420         assign
     1421         p-netto-price = p-base-price * (1 - v-d-value / 100)
     1422         .
     1423       end.
     1424       when integer('3':U) then do:
     1425         assign
     1426         p-netto-price = v-d-value
     1427         .
     1428       end.
     1429     end.
     1430       end.
     1431       when 'pcnt-kat-pdf':U then do:
     1432         if num-entries(how-pcnt-kat, "=") > 1
     1433         and integer(entry(2, how-pcnt-kat, "=")) > 0 then do:
     1434         v-rule-num = integer(entry(2, how-pcnt-kat, "=")).
     1435         for each buf_dis-rule no-lock where
     1436               buf_dis-rule.rule-num = v-rule-num
     1437           or buf_dis-rule.upper-rule-num = v-rule-num  :
     1438           if buf_dis-rule.is-term then do:
     1439             run mpl-tpl-auto in this-procedure ( input p-b-code
     1440                                                 ,input p-obj-type
     1441                                                 ,input p-obj-code
     1442                                                 ,input integer(entry(1, buf_dis-rule.charkey_one,"-"))
     1443                                                 ,input integer(entry(2, buf_dis-rule.charkey_one,"-"))
     1444                                                 ,input p-fact-order
     1445                                                 ,output v-disc-price-sale
     1446                                                 ,output v-pdf-id
     1447                                                 ,output v-pdf-db-num ) no-error.
     1448             if error-status:error
     1449             or v-disc-price-sale = 0
     1450             or v-disc-price-sale = ?
     1451             then do:
     1452               p-netto-price = p-base-price.
     1453             end.
     1454             else do:
     1455               p-netto-price = v-disc-price-sale.
     1456             end.
     1457             leave.
     1458           end.
     1459           end.
     1460         end.
     1461       end .
     1462     end case.
     1463   end.
     1464   end procedure.
     1465   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1466   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1467   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1468   procedure cur-time :
     1469      define output parameter p-today as date      no-undo .
     1470      define output parameter p-time  as integer   no-undo .
     1471     do
     1472     on error undo, return error
     1473     :
     1474       define variable v-date1 as date      no-undo .
     1475       define variable v-date2 as date      no-undo .
     1476       define variable v-time  as integer   no-undo .
     1477       assign
     1478         v-date1 = today
     1479         v-time  = time
     1480         v-date2 = today
     1481       .
     1482       if v-date1 <> v-date2
     1483       then do:
     1484         assign
     1485           v-date1 = today
     1486           v-time  = v-time
     1487         .
     1488       end.
     1489       assign
     1490         p-today = v-date1
     1491         p-time  = v-time
     1492       .
     1493     end.
     1494   end.
     1495   function cur-time-date returns character
     1496   :
     1497     return string(today, '99/99/9999':U) .
     1498   end.
     1499   function cur-time-mjd returns decimal
     1500   :
     1501     define variable v-date as date      no-undo .
     1502     define variable v-time as integer   no-undo .
     1503     run cur-time in this-procedure
     1504       (output v-date
     1505       ,output v-time
     1506       ) .
     1507     return integer(v-date) - 2400002 + (v-time / 86400) .
     1508   end.
     1509   function cur-time-get-ending-index returns integer
     1510   (input p-number as integer
     1511   )
     1512   :
     1513     if p-number < 0
     1514     or p-number = ?
     1515     then do:
     1516       return 1 .
     1517     end.
     1518     define variable v-rest as integer   no-undo .
     1519     assign
     1520       p-number = p-number modulo 100
     1521     .
     1522     if p-number < 20
     1523     then do:
     1524       assign
     1525         v-rest = p-number
     1526       .
     1527     end.
     1528     else do:
     1529       assign
     1530         v-rest = p-number modulo 10
     1531       .
     1532     end.
     1533     case v-rest :
     1534       when 1
     1535       then do:
     1536         return 2 .
     1537       end.
     1538       when 2 or
     1539       when 3 or
     1540       when 4
     1541       then do:
     1542         return 3 .
     1543       end.
     1544       otherwise do:
     1545         return 1 .
     1546       end.
     1547     end case .
     1548   end.
     1549   procedure cur-time-mjd-to-date :
     1550      define input  parameter i-mjd-diff as decimal no-undo.
     1551      define output parameter o-Date     as date    no-undo.
     1552      define output parameter o-Time     as integer no-undo.
     1553      define variable v-day-number as integer   no-undo .
     1554      if    i-mjd-diff < 0
     1555         or i-mjd-diff = ?
     1556      then do:
     1557         return "?" .
     1558      end.
     1559      assign
     1560         v-day-number = truncate(i-mjd-diff,0).
     1561         o-Date = date(v-day-number + 2400002).
     1562         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     1563     .
     1564   end.
     1565   function cur-time-mjd-to-string returns character
     1566   (input p-mjd-diff as decimal
     1567   )
     1568   :
     1569     define variable v-day-number as integer   no-undo .
     1570     define variable v-seconds    as integer   no-undo .
     1571     define variable v-hour       as integer   no-undo .
     1572     define variable v-min        as integer   no-undo .
     1573     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     1574     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     1575     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     1576     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1577     if p-mjd-diff < 0
     1578     or p-mjd-diff = ?
     1579     then do:
     1580       return "?" .
     1581     end.
     1582     assign
     1583       v-day-number = integer(truncate(p-mjd-diff,0))
     1584       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1585     .
     1586     if v-seconds > 86400
     1587     then do:
     1588       assign
     1589         v-seconds = 86400 - 1
     1590       .
     1591     end.
     1592     if v-seconds < 0
     1593     then do:
     1594       assign
     1595         v-seconds = 0
     1596       .
     1597     end.
     1598     assign
     1599       v-hour = truncate(v-seconds / 3600, 0)
     1600     .
     1601     assign
     1602       v-seconds = v-seconds modulo 3600
     1603     .
     1604     assign
     1605       v-min = truncate(v-seconds / 60, 0)
     1606     .
     1607     assign
     1608       v-seconds = v-seconds modulo 60
     1609     .
     1610     return
     1611         (if v-day-number <> 0
     1612           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1613           else ""
     1614         )
     1615       + (if v-day-number <> 0 or v-hour <> 0
     1616           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1617           else ""
     1618         )
     1619       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1620           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1621           else ""
     1622         )
     1623       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1624       .
     1625   end.
     1626   function cur-time-string returns character
     1627   :
     1628     define variable v-date as date      no-undo .
     1629     define variable v-time as integer   no-undo .
     1630     run cur-time in this-procedure
     1631       (output v-date
     1632       ,output v-time
     1633       ) .
     1634     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1635   end.
     1636   function cur-time-string-sec returns character
     1637   :
     1638     define variable v-date as date      no-undo .
     1639     define variable v-time as integer   no-undo .
     1640     run cur-time in this-procedure
     1641       (output v-date
     1642       ,output v-time
     1643       ) .
     1644     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1645   end.
     1646   function cur-time-custom  returns character
     1647   (input p-prefix as character
     1648   ,input p-date-format as character
     1649   ,input p-delimiter as character
     1650   ,input p-time-format as character
     1651   ,input p-suffix as character
     1652   )
     1653   :
     1654     define variable v-date as date      no-undo .
     1655     define variable v-time as integer   no-undo .
     1656     run cur-time in this-procedure
     1657       (output v-date
     1658       ,output v-time
     1659       ) .
     1660     return
     1661       p-prefix
     1662       + string(v-date, p-date-format)
     1663       + p-delimiter
     1664       + string(v-time, p-time-format)
     1665       + p-suffix
     1666       .
     1667   end.
     1668   function cur-time-print  returns character
     1669   :
     1670     define variable v-date as date      no-undo .
     1671     define variable v-time as integer   no-undo .
     1672     run cur-time in this-procedure
     1673       (output v-date
     1674       ,output v-time
     1675       ) .
     1676     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1677   end.
     1678   function cur-time-datetime returns datetime
     1679   :
     1680     define variable v-char as character no-undo .
     1681     define variable v-datetime as datetime no-undo .
     1682     v-char = cur-time-string().
     1683     v-datetime = datetime(v-char).
     1684     return  v-datetime.
     1685   end.
     1686   function cur-time-string-msec returns character
     1687   :
     1688     define variable v-date as datetime  no-undo .
     1689     v-date = now.
     1690     return string(v-date) .
     1691   end.
     1692   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1693   procedure factord :
     1694     define input  parameter p-fact-date            as date    no-undo .
     1695     define input  parameter p-fact-time            as integer no-undo .
     1696     define input  parameter p-fact-num             as integer no-undo .
     1697     define input  parameter p-shift-date           as date    no-undo .
     1698     define input  parameter p-shift-num            as integer no-undo .
     1699     define input  parameter p-shift-on             as logical no-undo .
     1700     define output parameter p-fact-order           as decimal no-undo .
     1701     define output parameter p-shift-end-fact-order as decimal no-undo .
     1702     define output parameter p-day-end-fact-order   as decimal no-undo .
     1703     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
     1704     if p-fact-date = ?
     1705     then do:
     1706       return error "Не указана фактическая дата" .
     1707     end.
     1708     define variable v-fact-date-num as integer no-undo .
     1709     assign
     1710       v-fact-date-num = integer(p-fact-date)
     1711     .
     1712     if p-fact-num = ?
     1713     or p-fact-num = 0
     1714     then do:
     1715       return error "Не задан p-fact-num " + string(p-fact-num) .
     1716     end.
     1717     if p-fact-num < 0
     1718     then do:
     1719       return error "Отрицательный fact-num " + string(p-fact-num) .
     1720     end.
     1721     if p-fact-num >= 100000000
     1722     then do:
     1723       return error "Недопустимо большой fact-num " + string(p-fact-num) .
     1724     end.
     1725     if p-shift-on = true
     1726     then do:
     1727       if p-shift-date = ?
     1728       then do:
     1729         return error "Не задана дата смены" .
     1730       end.
     1731       if p-shift-num = ?
     1732       or p-shift-num = 0
     1733       then do:
     1734         return error "Не задан номер смены" .
     1735       end.
     1736     end.
     1737     else do:
     1738       assign
     1739         p-shift-date = p-fact-date
     1740         p-shift-num  = 24
     1741       .
     1742     end.
     1743     define variable v-shift-offset as integer no-undo .
     1744     if p-shift-date = p-fact-date
     1745     then do:
     1746       assign
     1747         v-shift-offset = 1
     1748       .
     1749     end.
     1750     if p-shift-date < p-fact-date
     1751     then do:
     1752       assign
     1753         v-shift-offset = 0
     1754       .
     1755     end.
     1756     if p-shift-date > p-fact-date
     1757     then do:
     1758       message
     1759         vss-workfile vss-revision vss-description skip
     1760         "Неправильная дата закрытия смены" skip
     1761         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
     1762         view-as alert-box error .
     1763       undo, return error
     1764         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
     1765           ,string(p-fact-date, '99/99/9999':U)
     1766           ,string(p-shift-date, '99/99/9999':U)
     1767           )
     1768       .
     1769     end.
     1770     if p-shift-num < 1
     1771     or p-shift-num > 24
     1772     then do:
     1773       message
     1774         vss-workfile vss-revision vss-description skip
     1775         "Неправильный номер смены" skip
     1776         "p-shift-num" p-shift-num skip
     1777         view-as alert-box error .
     1778       undo, return error return-value .
     1779     end.
     1780     assign
     1781       p-fact-order           = v-fact-date-num
     1782                              + v-shift-offset * 0.5
     1783                              + p-shift-num    * 0.02 - 0.01
     1784                              + p-fact-num     * 0.0000000001
     1785       p-shift-end-fact-order = v-fact-date-num
     1786                              + v-shift-offset * 0.5
     1787                              + p-shift-num    * 0.02
     1788       p-day-end-fact-order   = v-fact-date-num
     1789                              + 0.99
     1790     .
     1791     if p-fact-order           <= v-fact-date-num
     1792     or p-shift-end-fact-order <= v-fact-date-num
     1793     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
     1794     or p-shift-end-fact-order >= p-day-end-fact-order
     1795     then do:
     1796       message
     1797         vss-workfile vss-revision vss-description skip
     1798         "Внутренняя ошибка при генерации фактического номера" skip
     1799         "p-fact-date"            p-fact-date            skip
     1800         "p-fact-time"            p-fact-time            skip
     1801         "p-fact-num"             p-fact-num             skip
     1802         "p-shift-date"           p-shift-date           skip
     1803         "p-shift-num"            p-shift-num            skip
     1804         "p-shift-on"             p-shift-on             skip
     1805         "p-shift-end-fact-order" p-shift-end-fact-order skip
     1806         "p-day-end-fact-order"   p-day-end-fact-order   skip
     1807         "v-fact-date-num"        v-fact-date-num        skip
     1808         view-as alert-box error .
     1809       undo, return error return-value .
     1810     end.
     1811   end procedure.
     1812   procedure day-begin-fact-order :
     1813     define input  parameter p-fact-date            as date    no-undo .
     1814     define output parameter p-day-begin-fact-order as decimal no-undo .
     1815     do
     1816     on error undo, return error return-value
     1817     :
     1818       if p-fact-date = ?
     1819       then do:
     1820         assign
     1821           p-day-begin-fact-order = 0
     1822         .
     1823       end.
     1824       else do:
     1825         assign
     1826           p-day-begin-fact-order = integer(p-fact-date)
     1827         .
     1828       end.
     1829     end.
     1830   end procedure.
     1831   procedure factord-max-fact-order :
     1832     define output parameter p-max-fact-order as decimal   no-undo .
     1833     do
     1834     on error undo, return error return-value
     1835     :
     1836       run day-begin-fact-order in this-procedure
     1837         (input  date(1, 1, 5000)
     1838         ,output p-max-fact-order
     1839         ) .
     1840     end.
     1841   end procedure.
     1842   procedure factord-cut-archive :
     1843     define input  parameter p-obj-type             as character no-undo .
     1844     define input  parameter p-obj-code             as integer   no-undo .
     1845     define input  parameter p-fact-date            as date      no-undo .
     1846     define output parameter p-shift-on             as logical   no-undo .
     1847     define output parameter p-shift-date           as date      no-undo .
     1848     define output parameter p-shift-num            as integer   no-undo .
     1849     define output parameter p-day-end-fact-order   as decimal   no-undo .
     1850     define output parameter p-shift-end-fact-order as decimal   no-undo .
     1851     define variable v-fact-order as decimal   no-undo .
     1852     define buffer buf_shift-obj for ub.shift-obj .
     1853     do
     1854     on error undo, return error return-value
     1855     :
     1856   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1857   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1858     (input  p-obj-type
     1859     ,input  p-obj-code
     1860     ,input  'shift-on=request'
     1861     ,output p-shift-on
     1862     ) no-error .
     1863       if error-status :error
     1864       then do:
     1865         message
     1866           vss-workfile vss-revision vss-description skip
     1867           "Ошибка при определении атрибута объекта" skip
     1868           "Объект" p-obj-type p-obj-code skip
     1869           error-status :get-message(1) skip
     1870           return-value skip
     1871           view-as alert-box error .
     1872         undo, return error return-value .
     1873       end.
     1874       if p-shift-on = false
     1875       then do:
     1876         assign
     1877           p-shift-date               = ?
     1878           p-shift-num                = 0
     1879         .
     1880       end.
     1881       else do:
     1882         find first buf_shift-obj share-lock
     1883           where buf_shift-obj.obj-type   = p-obj-type
     1884             and buf_shift-obj.obj-code   = p-obj-code
     1885             and buf_shift-obj.shift-date > p-fact-date
     1886           use-index pi
     1887           no-error .
     1888         if not available buf_shift-obj
     1889         or buf_shift-obj.status_ <> 'зкр':U
     1890         then do:
     1891           message
     1892             vss-workfile vss-revision vss-description skip
     1893             "Невозможно вычислить последнюю смену" skip
     1894             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
     1895             "Объект" p-obj-type p-obj-code skip
     1896             "Дата" p-fact-date skip
     1897             view-as alert-box error .
     1898           undo, return error return-value .
     1899         end.
     1900         find last buf_shift-obj share-lock
     1901           where buf_shift-obj.obj-type = p-obj-type
     1902             and buf_shift-obj.obj-code = p-obj-code
     1903             and buf_shift-obj.shift-date <= p-fact-date
     1904           use-index pi
     1905           no-error .
     1906         if available buf_shift-obj
     1907         then do:
     1908           if  buf_shift-obj.status_ = 'зкр':U
     1909           then do:
     1910             assign
     1911               p-shift-date = buf_shift-obj.shift-date
     1912               p-shift-num  = buf_shift-obj.shift-num
     1913             .
     1914           end.
     1915           else do:
     1916             message
     1917               vss-workfile vss-revision vss-description skip
     1918               "Невозможно вычислить последнюю смену" skip
     1919               "Статус смены отличен от статуса" 'зкр':U skip
     1920               "Объект" p-obj-type p-obj-code skip
     1921               "Дата" p-fact-date skip
     1922               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     1923               view-as alert-box error .
     1924             undo, return error return-value .
     1925           end.
     1926         end.
     1927         else do:
     1928           assign
     1929             p-shift-date = p-fact-date - 1
     1930             p-shift-num  = 1
     1931           .
     1932         end.
     1933       end.
     1934       run factord in this-procedure
     1935         (input  p-fact-date
     1936         ,input  1
     1937         ,input  1
     1938         ,input  p-shift-date
     1939         ,input  p-shift-num
     1940         ,input  p-shift-on
     1941         ,output v-fact-order
     1942         ,output p-shift-end-fact-order
     1943         ,output p-day-end-fact-order
     1944         ) no-error .
     1945       if error-status :error
     1946       then do:
     1947         message
     1948           vss-workfile vss-revision vss-description skip
     1949           "Ошибка при вызове процедуры factord"
     1950           error-status :get-message(1) skip
     1951           return-value skip
     1952           view-as alert-box error .
     1953         undo, return error return-value .
     1954       end.
     1955     end.
     1956   end procedure.
     1957   procedure factord-lock-shift :
     1958     define input  parameter p-obj-type  as character no-undo .
     1959     define input  parameter p-obj-code  as integer   no-undo .
     1960     define input  parameter p-fact-date as date      no-undo .
     1961     define parameter buffer buf_shift-obj for ub.shift-obj .
     1962     define variable v-shift-on      as logical   no-undo .
     1963     define variable v-extra-message as character no-undo .
     1964     define variable v-error as character no-undo .
     1965     do
     1966     on error undo, return error return-value
     1967     :
     1968   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1969   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1970     (input  p-obj-type
     1971     ,input  p-obj-code
     1972     ,input  'shift-on=request'
     1973     ,output v-shift-on
     1974     ) no-error .
     1975       if error-status :error
     1976       then do:
     1977         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     1978         undo, return error v-error .
     1979       end.
     1980       if v-shift-on = true
     1981       then do:
     1982         find first buf_shift-obj share-lock
     1983           where buf_shift-obj.obj-type   = p-obj-type
     1984             and buf_shift-obj.obj-code   = p-obj-code
     1985             and buf_shift-obj.shift-date > p-fact-date
     1986           use-index pi
     1987           no-error .
     1988         if not available buf_shift-obj
     1989         or buf_shift-obj.status_ <> 'зкр':U
     1990         then do:
     1991           find last buf_shift-obj
     1992             where buf_shift-obj.obj-type = p-obj-type
     1993               and buf_shift-obj.obj-code = p-obj-code
     1994               and buf_shift-obj.status_  = 'зкр':U
     1995             use-index stts
     1996             no-error .
     1997           if available buf_shift-obj
     1998           then do:
     1999             assign
     2000               v-extra-message =
     2001                     substitute("Дата начала последеней закрытой смены на объекте &1"
     2002                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     2003                               )
     2004             .
     2005           end.
     2006           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     2007           undo, return error v-error .
     2008         end.
     2009       end.
     2010     end.
     2011   end procedure.
     2012   procedure factord-end-day :
     2013     define input  parameter p-fact-date            as date    no-undo .
     2014     define output parameter p-day-end-fact-order   as decimal no-undo .
     2015     do
     2016     on error undo, return error return-value
     2017     :
     2018       if p-fact-date = ?
     2019       then do:
     2020         return error "Не указана фактическая дата" .
     2021       end.
     2022       assign
     2023         p-day-end-fact-order = integer(p-fact-date) + 0.99
     2024       .
     2025     end.
     2026   end procedure.
     2027   procedure factord-to-date :
     2028     define input  parameter p-fact-order as decimal no-undo .
     2029     define output parameter p-fact-date  as date    no-undo .
     2030     define variable v-ref-date  as date      no-undo .
     2031     define variable v-ref-delta as integer   no-undo .
     2032     do
     2033     on error undo, return error return-value
     2034     :
     2035       if p-fact-order = ?
     2036       or p-fact-order = 0
     2037       then do:
     2038         return error "Не указан fact-order" .
     2039       end.
     2040       assign
     2041         v-ref-date  = date(1, 1, 2000)
     2042       .
     2043       assign
     2044         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     2045       .
     2046       assign
     2047         p-fact-date = v-ref-date + v-ref-delta
     2048       .
     2049     end.
     2050   end procedure.
     2051   procedure factord-to-fact-num :
     2052     define input  parameter p-fact-order as decimal no-undo .
     2053     define output parameter p-fact-num   as integer no-undo .
     2054     define variable v-fact-order-trunc as decimal no-undo .
     2055     do
     2056     on error undo, return error return-value
     2057     :
     2058       if p-fact-order = ?
     2059       or p-fact-order = 0
     2060       then do:
     2061         return error "Не указан fact-order" .
     2062       end.
     2063       assign
     2064        v-fact-order-trunc = truncate(p-fact-order, 2)
     2065       .
     2066       assign
     2067         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     2068       .
     2069     end.
     2070   end procedure.
     2071   procedure factord-to-shift-num :
     2072     define input  parameter p-fact-order as decimal no-undo .
     2073     define output parameter p-shift-num   as integer no-undo .
     2074     define variable  p-shift-numd  as decimal   no-undo .
     2075     define variable v-fact-order-trunc as decimal no-undo .
     2076     do
     2077     on error undo, return error return-value
     2078     :
     2079       if p-fact-order = ?
     2080       or p-fact-order = 0
     2081       then do:
     2082         return error "Не указан fact-order" .
     2083       end.
     2084       assign
     2085        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     2086       .
     2087       if v-fact-order-trunc < 0.5 then do:
     2088         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     2089       end.
     2090       assign
     2091         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     2092         .
     2093        assign
     2094         p-shift-num = truncate (p-shift-numd , 0)
     2095       .
     2096     end.
     2097   end procedure.
     2098   procedure fact-order-mpl :
     2099     do
     2100     on error undo, return error return-value
     2101     :
     2102   define input  parameter p-doc-date as date     no-undo .
     2103   define input  parameter p-obj-type as character no-undo .
     2104   define input  parameter p-obj-code as integer   no-undo .
     2105   define output parameter p-fact-order as decimal   no-undo .
     2106   define variable v-fact-date            as date    no-undo .
     2107   define variable v-fact-time            as integer no-undo .
     2108   define variable v-fact-order           as decimal no-undo .
     2109   define variable v-shift-end-fact-order as decimal no-undo .
     2110   define variable v-day-end-fact-order   as decimal no-undo .
     2111   define variable l-shift-on as logical no-undo .
     2112   define variable l-date as date      no-undo .
     2113   define variable l-time as integer   no-undo .
     2114   define variable shift-date as date      no-undo .
     2115   define variable shift-num  as integer   no-undo .
     2116   define variable shift-name as character no-undo .
     2117   define variable max-fact-order as decimal   no-undo .
     2118   define buffer buf_global-state for ub.global-state  .
     2119   find first buf_global-state no-lock no-error .
     2120   if not available buf_global-state then do:
     2121      message
     2122        "Не заданы параметры ценообразования!"
     2123        view-as alert-box error
     2124      .
     2125      return error return-value .
     2126   end.
     2127     run cur-time in this-procedure
     2128     ( output v-fact-date ,
     2129       output v-fact-time  ).
     2130   if p-doc-date = ? then do:
     2131   if buf_global-state.pl-use-sys-date-time  = true then do:
     2132         run factord in this-procedure
     2133           (input  v-fact-date
     2134           ,input  v-fact-time
     2135           ,input  v-fact-time
     2136           ,input  ?
     2137           ,input  ?
     2138           ,input  false
     2139           ,output v-fact-order
     2140           ,output v-shift-end-fact-order
     2141           ,output v-day-end-fact-order
     2142           ) no-error .
     2143         if error-status :error
     2144         or v-fact-order = ?
     2145         or v-fact-order = 0 then do:
     2146           undo, return error "Не определен факт-ордер " + return-value + error-status :get-message(1) .
     2147         end.
     2148         p-fact-order = v-fact-order .
     2149   end.
     2150   else do:
     2151   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2152   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     2153     (input  p-obj-type
     2154     ,input  p-obj-code
     2155     ,input  'shift-on=request'
     2156     ,output l-shift-on
     2157     ) no-error .
     2158         if error-status :error then return error "Неопределена дата на объекте " + return-value .
     2159         if p-doc-date <> ? then do:
     2160         end.
     2161          run gbl/factdate.p
     2162          ( input        p-obj-type  ,
     2163            input        p-obj-code  ,
     2164            input-output v-fact-date ,
     2165            input-output v-fact-time ,
     2166            input-output shift-date      ,
     2167            input-output shift-num       ,
     2168            input-output shift-name      ,
     2169            input        yes
     2170            ) no-error .
     2171         if error-status :error then return error substitute(" Ошибка из factdate.p: &1 &2"  , return-value , error-status :get-message(1)   ) .
     2172         run factord in this-procedure
     2173           (input  v-fact-date
     2174           ,input  v-fact-time
     2175           ,input  v-fact-time
     2176           ,input  shift-date
     2177           ,input  shift-num
     2178           ,input  l-shift-on
     2179           ,output v-fact-order
     2180           ,output v-shift-end-fact-order
     2181           ,output v-day-end-fact-order
     2182           ) no-error .
     2183         if error-status :error
     2184         or v-fact-order = ?
     2185         or v-fact-order = 0 then do:
     2186           undo, return error "Не определен факт-ордер " + return-value + error-status :get-message(1) .
     2187         end.
     2188         p-fact-order = v-fact-order .
     2189   end.
     2190   end.
     2191   else do:
     2192          run gbl/factdate.p
     2193          ( input        p-obj-type  ,
     2194            input        p-obj-code  ,
     2195            input-output v-fact-date ,
     2196            input-output v-fact-time ,
     2197            input-output shift-date      ,
     2198            input-output shift-num       ,
     2199            input-output shift-name      ,
     2200            input        yes
     2201            ) no-error .
     2202         if error-status :error then return error "Ошибка factdate.p " + return-value .
     2203         v-fact-date = p-doc-date .
     2204         run factord in this-procedure
     2205           (input  v-fact-date
     2206           ,input  v-fact-time
     2207           ,input  v-fact-time
     2208           ,input  shift-date
     2209           ,input  shift-num
     2210           ,input  l-shift-on
     2211           ,output v-fact-order
     2212           ,output v-shift-end-fact-order
     2213           ,output v-day-end-fact-order
     2214           ) no-error .
     2215         if error-status :error
     2216         or v-fact-order = ?
     2217         or v-fact-order = 0 then do:
     2218           undo, return error "Не определен факт-ордер " + return-value + error-status :get-message(1) .
     2219         end.
     2220         p-fact-order = v-fact-order .
     2221   end.
     2222     end.
     2223   end procedure.
