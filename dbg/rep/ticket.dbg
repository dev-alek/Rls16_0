     3129   procedure nutro_get-nutrition-info :
     3130     define input  parameter p-artic         as character no-undo .
     3131     define input  parameter p-prod-type     as character no-undo .
     3132     define input  parameter p-prod-code     as integer   no-undo .
     3133     define input  parameter p-obj-type      as character no-undo .
     3134     define input  parameter p-obj-code      as integer   no-undo .
     3135     define output parameter p-calories      as decimal   no-undo .
     3136     define output parameter p-protein       as decimal   no-undo .
     3137     define output parameter p-carbohydrate  as decimal   no-undo .
     3138     define output parameter p-fat           as decimal   no-undo .
     3139     define buffer buf_goods    for ub.goods .
     3140     define variable v-attr-value    as character no-undo .
     3141     define variable v-attr-type     as character no-undo .
     3142     define variable v-attr-code     as character no-undo .
     3143     define variable v-exist         as logical   no-undo .
     3144     define variable v-is-global     as logical   no-undo .
     3145     define variable v-nutro-value   as decimal   no-undo .
     3146     define buffer buf_fbr-gds-obj  for ub.fbr-gds-obj.
     3147     define buffer buf_recipe       for ub.recipe.
     3148   do
     3149   on error undo, return error return-value
     3150   :
