      267         end.
      268         if varcont1 = yes then do:
      269           assign
      270             sum1 = sum1 * 3
      271           .
      272           do i1 = 2 to len-code1 by 2
      273           :
      274             assign
      275               v-sum-char1 = substr(full-b-code, len-code1 - i1 + 1, 1)
      276             .
      277             if v-sum-char1 < "0"
      278             or v-sum-char1 > "9"
      279             then do:
      280               message
      281                 "Невозможно сформировать бар-код" skip
      282                 "для товара с кодом: " internal-b-code skip
      283                 view-as alert-box error title "подсчет контрольной суммы".
      284               return error.
      285             end.
      286             assign
      287               sum1 = sum1 + integer(v-sum-char1)
      288             .
      289           end.
      290           if varcont1 = yes then do:
      291              if sum1 mod 10 = 0 then do:
      292                assign
      293                  full-b-code = full-b-code + '0'
      294                .
      295              end.
      296              else do:
      297                assign
      298                  full-b-code = full-b-code + string(10 - sum1 mod 10)
      299                .
      300              end.
      301           end.
      302         end.
      303       end.
      304     end.
      305   END PROCEDURE.
