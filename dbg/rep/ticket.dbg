     3859   run dr-katp in this-procedure
     3860     ( input buf-par_goods.gds-code
     3861      ,input buf-par_bar-code.b-code
     3862      ,input p-obj-type
     3863      ,input p-obj-code
     3864      ,input dflt-cd
     3865      ,input price
     3866      ,input how-pcnt-kat
     3867      ,input (if v-fact-order = 0 then ? else v-fact-order)
     3868      ,output price-cd
     3869     ) no-error.
     3870   if error-status:error then do:
     3871   end.
     3872   define variable v-calories      as decimal   no-undo .
     3873   define variable v-protein       as decimal   no-undo .
     3874   define variable v-carbohydrate  as decimal   no-undo .
     3875   define variable v-fat           as decimal   no-undo .
     3876   run nutro_get-nutrition-info
     3877     ( input  buf-par_goods.artic
     3878     , input  buf-par_goods.prod-type
     3879     , input  buf-par_goods.prod-code
     3880     , input  p-obj-type
     3881     , input  p-obj-code
     3882     , output v-calories
     3883     , output v-protein
     3884     , output v-carbohydrate
     3885     , output v-fat
     3886     ) .
     3887   define variable v-last-pri-doc as character no-undo .
     3888   define buffer buf_parts for ub.parts .
     3889   define variable v-cash-parts as logical no-undo .
     3890   find first gds-obj no-lock
     3891        where gds-obj.artic     = buf-par_goods.artic
     3892          and gds-obj.prod-type = buf-par_goods.prod-type
     3893          and gds-obj.prod-code = buf-par_goods.prod-code
     3894          and gds-obj.obj-code  = p-obj-code
     3895          and gds-obj.obj-type  = p-obj-type no-error.
     3896   if available gds-obj then assign v-cash-parts = gds-obj.cash-parts .
     3897   assign
     3898     v-last-pri-doc = ""
     3899   .
     3900   if v-cash-parts then do :
     3901    for each buf-t_doc-line no-lock
     3902       where buf-t_doc-line.obj-type     = p-obj-type
     3903         and buf-t_doc-line.obj-code     = p-obj-code
     3904         and buf-t_doc-line.prod-type    = buf-par_goods.prod-type
     3905         and buf-t_doc-line.prod-code    = buf-par_goods.prod-code
     3906         and buf-t_doc-line.artic        = buf-par_goods.artic
     3907         and (buf-t_doc-line.ext-doc-type = 'ie':U
     3908         or buf-t_doc-line.ext-doc-type = 'iv':U)
     3909         and buf-t_doc-line.status_      = 'факт':U
     3910         by buf-t_doc-line.fact-order descending
     3911         :
     3912        if buf-par_bar-code.part-code <> "" then do :
     3913          find first buf_parts no-lock
     3914              where buf_parts.part-code = buf-par_bar-code.part-code
     3915                and buf_parts.artic = buf-par_goods.artic
     3916                and buf_parts.prod-type = buf-par_goods.prod-type
     3917                and buf_parts.prod-code = buf-par_goods.prod-code
     3918                and buf_parts.obj-code = p-obj-code
     3919                and buf_parts.obj-type = p-obj-type
     3920                and buf_parts.out-code = buf-t_doc-line.doc-code
     3921                no-error.
     3922          if available buf_parts then do :
     3923          v-last-pri-doc = buf_parts.out-code.
     3924          leave.
     3925          end.
     3926        end.
     3927        else do :
     3928          find first buf_parts no-lock
     3929               where buf_parts.artic = buf-par_goods.artic
     3930                 and buf_parts.prod-type = buf-par_goods.prod-type
     3931                 and buf_parts.prod-code = buf-par_goods.prod-code
     3932                 and buf_parts.obj-code = p-obj-code
     3933                 and buf_parts.obj-type = p-obj-type
     3934                 and buf_parts.out-code = buf-t_doc-line.doc-code
     3935                 no-error.
     3936           if available buf_parts then do :
     3937             v-last-pri-doc = buf_parts.out-code.
     3938             leave.
     3939           end.
     3940        end.
     3941    end.
     3942   end.
     3943   else do:
     3944     for last buf-t_doc-line no-lock
     3945       where buf-t_doc-line.obj-type     = p-obj-type
     3946         and buf-t_doc-line.obj-code     = p-obj-code
     3947         and buf-t_doc-line.prod-type    = buf-par_goods.prod-type
     3948         and buf-t_doc-line.prod-code    = buf-par_goods.prod-code
     3949         and buf-t_doc-line.artic        = buf-par_goods.artic
     3950         and (buf-t_doc-line.ext-doc-type = 'ie':U
     3951         or  buf-t_doc-line.ext-doc-type = 'iv':U)
     3952         and buf-t_doc-line.status_      = 'факт':U
     3953       by buf-t_doc-line.fact-order descending
     3954       :
     3955       v-last-pri-doc = buf-t_doc-line.doc-code.
     3956     end.
     3957   end.
     3958   define variable v-doc-date         as character initial "":U no-undo .
     3959   define variable v-short-doc-code   as character no-undo .
     3960   define variable v-ser_on_pack      as character no-undo .
     3961   define variable v-ser_on_pack-type as character no-undo .
     3962   if p-doc-code <> "":U then do:
     3963     find first buf_trn-doc no-lock
     3964       where buf_trn-doc.doc-code = p-doc-code
     3965       no-error .
     3966     if available buf_trn-doc then do:
     3967       assign
     3968         v-doc-date       = string( buf_trn-doc.fact-date, "99/99/9999" )
     3969         v-short-doc-code = string( get-doc-code-int64( p-doc-code ) )
     3970       .
     3971   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input buf_trn-doc.doc-code ,
     3972                           input 'ser_on_pack':U ,
     3973                          output v-ser_on_pack ,
     3974                          output v-ser_on_pack-type )  .
     3975     end.
     3976   end.
     3977   define variable v-promo-name      as character no-undo .
     3978   define variable v-type-sale-promo as character no-undo .
     3979   define variable v-sale-promo      as character   no-undo .
     3980   define variable v-promo-price     as decimal   no-undo .
     3981   if p-ActionId <> 0 and p-ActionId <> ? then
     3982   do:
     3983      find first ub.PromoAction no-lock where ub.PromoAction.id = p-ActionId and
     3984         ub.PromoAction.db-num = p-db-num no-error .
     3985      if available (ub.PromoAction) then
     3986      do:
     3987         v-promo-name = ub.PromoAction.nameAction .
     3988         find first ub.PromoGoods no-lock where ub.PromoGoods.db-num = ub.PromoAction.db-num and
     3989            ub.PromoGoods.idAction = ub.PromoAction.id and
     3990            ub.PromoGoods.gds-code = buf-par_goods.gds-code
     3991            no-error .
     3992            find first ub.PromoCriterion no-lock where ub.PromoCriterion.db-num = ub.PromoAction.db-num and
     3993                 ub.PromoCriterion.idAction = ub.PromoAction.id no-error .
     3994         case ub.PromoAction.methodCalc:
     3995            when 2 then
     3996               do:
     3997                  v-type-sale-promo = " руб." .
     3998                  if available (ub.PromoCriterion) then
     3999                  do:
     4000                     v-sale-promo = string(ub.PromoCriterion.discont) + v-type-sale-promo .
     4001                     v-promo-price = price - ub.PromoCriterion.discont .
     4002                  end.
     4003               end.
     4004            when 1 then
     4005               do:
     4006                  v-type-sale-promo = "%" .
     4007                  if available (ub.PromoCriterion) then
     4008                  do:
     4009                     v-sale-promo = string(ub.PromoCriterion.discont) + v-type-sale-promo .
     4010                     v-promo-price = price - price * (ub.PromoCriterion.discont / 100) .
     4011                  end.
     4012               end.
     4013            when 5 then
     4014               do:
     4015                  v-type-sale-promo = " руб." .
     4016                  if available (ub.PromoGoods) then
     4017                  do:
     4018                     v-sale-promo = string(ub.PromoGoods.price) + v-type-sale-promo .
     4019                     v-promo-price = ub.PromoGoods.price .
     4020                  end.
     4021               end.
     4022         end case.
     4023      end.
     4024   end.
     4025   PUT STREAM OutStream UNFORMATTED
     4026      (if buf-par_bar-code.unit-cli <> buf-par_goods.unit-base
     4027             and ((qntytype = "список" and action = "list")
     4028                        or
     4029                        (qntytype = "документ" and action = "document"))
     4030                   then integer(round(gds-qnty / buf-par_bar-code.cli-base-rate, 0))
     4031                   else gds-qnty) "|"
     4032         replace( OurHost.obj-name, "|":U, "/":U )  "|":U
     4033         replace( OurObj.obj-name, "|":U, "/":U ) "|":U
