     2250   date-1 DESCENDING
     2251   time-1 DESCENDING
     2252   date-2 DESCENDING
     2253   time-2 DESCENDING
     2254   type-price DESCENDING
     2255   .
     2256   procedure mpl-autoprice :
     2257   define input  parameter p-only-b-code as logical   no-undo .
     2258   define input  parameter p-cli-type    as character no-undo .
     2259   define input  parameter p-cli-code    as integer   no-undo .
     2260   define input  parameter p-main-b-code as integer   no-undo .
     2261   define input  parameter p-b-code      as integer   no-undo .
     2262   define input  parameter p-obj-type    as character no-undo .
     2263   define input  parameter p-obj-code    as integer   no-undo .
     2264   define input  parameter p-qnty-doc    as decimal   no-undo .
     2265   define input  parameter p-sum-doc     as decimal   no-undo .
     2266   define input  parameter p-vid-pay        as character no-undo .
     2267   define input  parameter p-cash-pay-type  as character no-undo .
     2268   define input  parameter p-fact-order  as decimal   no-undo .
     2269   define output parameter p-plt-id          as integer   no-undo .
     2270   define output parameter p-plt-db-num      as integer   no-undo .
     2271   define output parameter p-pdf-id          as integer   no-undo .
     2272   define output parameter p-pdf-db-num      as integer   no-undo .
     2273   define output parameter p-sale-price-base as decimal   no-undo .
     2274   define output parameter p-sale-price-rubl as decimal   no-undo .
     2275   define output parameter p-road-tax-base as decimal   no-undo .
     2276   define output parameter p-road-tax-rubl as decimal   no-undo .
     2277   define output parameter p-excise-base   as decimal   no-undo .
     2278   define output parameter p-excise-rubl   as decimal   no-undo .
     2279   define variable v-cli-oborot-ALL as decimal   no-undo .
     2280   define buffer buf_buyer-in-buyer-group   for ub.buyer-in-buyer-group  .
     2281   define buffer buf_turnover-buyer-main    for ub.turnover-buyer-main  .
     2282   define buffer buf1_tnv-in-turnover-group for ub.tnv-in-turnover-group  .
     2283   define buffer buf2_tnv-in-turnover-group for ub.tnv-in-turnover-group  .
     2284   define buffer buf_price-all              for ub.price-all  .
     2285   define buffer buf_goods                  for ub.goods      .
     2286   define buffer buf_global-state           for ub.global-state  .
     2287   define buffer buf_buyer-group            for ub.buyer-group  .
     2288   define buffer buf_turnover-group         for ub.turnover-group  .
     2289   define buffer buf_main-code              for ub.bar-code  .
     2290   define buffer buf_bar-code               for ub.bar-code  .
     2291   define buffer buf_pay-type               for ub.pay-type  .
     2292   define buffer buf_cash-pay               for ub.cash-pay  .
     2293   define variable to-day          as date      no-undo .
     2294   define variable v-base-rate0    as decimal   no-undo .
     2295   define variable v-base-scale0   as decimal   no-undo .
     2296   define variable v-exch-rate0    as decimal   no-undo .
     2297   define variable v-exch-scale0   as decimal   no-undo .
     2298   define variable v-base-rate     as decimal   no-undo .
     2299   define variable v-base-scale    as decimal   no-undo .
     2300   define variable v-exch-rate     as decimal   no-undo .
     2301   define variable v-exch-scale    as decimal   no-undo .
     2302   define variable v-host-code     as integer   no-undo .
     2303   define variable v-curr-abbr     as character no-undo .
     2304   define variable v-grp-name      as character no-undo .
     2305   define variable v-date-1        as date      no-undo .
     2306   define variable v-date-2        as date      no-undo .
     2307   define variable v-interv        as character no-undo .
     2308   define variable v-pay-name      as character no-undo .
     2309   define variable v-cli-oborot    as decimal   no-undo .
     2310   define variable v-trn-pay-code  as integer   no-undo .
     2311   define variable v-cash-pay-curr as integer   no-undo .
     2312   define variable v-cash-pay-code as integer   no-undo .
     2313   do
     2314   on error undo, return error return-value
     2315   :
     2316   find first buf_main-code no-lock where buf_main-code.b-code = p-main-b-code .
     2317   find first buf_goods no-lock where buf_goods.gds-code = buf_main-code.gds-code.
     2318   if p-fact-order = ? then do:
     2319     run fact-order-mpl (
     2320         input   today       ,
     2321         input   p-obj-type  ,
     2322         input   p-obj-code  ,
     2323         output  p-fact-order ).
     2324   end.
     2325   if p-vid-pay <> "" then do:
     2326      find first buf_pay-type no-lock where  buf_pay-type.obj-code = integer(p-vid-pay) no-error .
     2327      if available buf_pay-type
     2328         then v-trn-pay-code = buf_pay-type.obj-code.
     2329         else v-trn-pay-code =  0.
     2330   end.
     2331   else v-trn-pay-code = 0 .
     2332   if p-cash-pay-type <> "" then do:
     2333      find first buf_cash-pay no-lock where  recid(buf_cash-pay) = integer(p-cash-pay-type) no-error .
     2334      if available buf_pay-type
     2335         then
     2336           assign
     2337             v-cash-pay-curr = buf_cash-pay.curr-code
     2338             v-cash-pay-code = buf_cash-pay.cdpay-code
     2339           .
     2340         else
     2341           assign
     2342             v-cash-pay-curr = 0
     2343             v-cash-pay-code = 0
     2344             .
     2345   end.
     2346   else
     2347     assign
     2348       v-cash-pay-curr = 0
     2349       v-cash-pay-code = 0
     2350       .
     2351   for each tt_price-all  : delete tt_price-all . end.
     2352   assign
     2353     p-plt-id             = ?
     2354     p-plt-db-num         = ?
     2355     p-pdf-id             = ?
     2356     p-pdf-db-num         = ?
     2357     p-sale-price-base    = ?
     2358     p-sale-price-rubl    = ?
     2359     v-cli-oborot         = 0
     2360   .
     2361   find first buf_global-state no-lock no-error .
     2362   if not available buf_global-state then do:
     2363      message
     2364        "Не заданы параметры ценообразования!"
     2365        view-as alert-box error
     2366      .
     2367      return error return-value .
     2368   end.
     2369   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2370   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
     2371     (input  p-obj-type
     2372     ,input  p-obj-code
     2373     ,output to-day
     2374     )  .
     2375   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2376   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2377     (input  p-obj-type
     2378     ,input  p-obj-code
     2379     ,output v-host-code
     2380     )  .
     2381   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2382   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run baserate in g#library
     2383     (input  v-host-code
     2384     ,input  to-day
     2385     ,output v-base-rate0
     2386     ,output v-base-scale0
     2387     )  .
     2388     v-cli-oborot-ALL  = 0 .
     2389     for each buf_turnover-buyer-main no-lock  where
     2390              buf_turnover-buyer-main.cli-type = p-cli-type  and
     2391              buf_turnover-buyer-main.cli-code = p-cli-code
     2392              :
     2393              v-cli-oborot-ALL = v-cli-oborot-ALL + buf_turnover-buyer-main.sum-doc-rubl-itog .
     2394     end.
     2395   for each buf_price-all no-lock where
     2396            buf_price-all.obj-type = p-obj-type and
     2397            buf_price-all.obj-code = p-obj-code and
     2398            buf_price-all.gds-code = buf_goods.gds-code and
     2399            buf_price-all.status_  = 'акт':U  and
     2400          ( p-only-b-code = false   or
     2401          ( buf_price-all.b-code = p-main-b-code or
     2402            buf_price-all.b-code = p-b-code))    and
     2403           ( p-only-b-code = true  or
     2404             buf_price-all.b-code = p-b-code)
     2405             and
     2406             buf_price-all.fact-order-sys-from  <= p-fact-order  and
     2407           ( buf_price-all.fact-order-sys-to = ? or
     2408             buf_price-all.fact-order-sys-to    >= p-fact-order)
     2409           :
     2410            v-interv   = "" .
     2411            v-grp-name = "" .
     2412            v-pay-name = "" .
     2413            if buf_price-all.fact-order = 0  and buf_price-all.plt-priority = 0  then next.
     2414            if buf_price-all.bgr-id > 0 then do:
     2415               find first buf_buyer-group no-lock where
     2416                          buf_buyer-group.bgr-id     = buf_price-all.bgr-id  and
     2417                          buf_buyer-group.bgr-db-num = buf_price-all.bgr-db-num  no-error .
     2418               if available buf_buyer-group then do:
     2419                  if p-cli-type <> "" and p-cli-type <> ? then do:
     2420                  find first buf_buyer-in-buyer-group no-lock where
     2421                             buf_buyer-in-buyer-group.stts         = 0 and
     2422                             buf_buyer-in-buyer-group.bgr-id       = buf_buyer-group.bgr-id     and
     2423                             buf_buyer-in-buyer-group.bgr-db-num   = buf_buyer-group.bgr-db-num  and
     2424                             buf_buyer-in-buyer-group.bbg-obj-type = p-cli-type and
     2425                             buf_buyer-in-buyer-group.bbg-obj-code = p-cli-code
     2426                             no-error .
     2427                             if not available buf_buyer-in-buyer-group then do:
     2428                                v-grp-name = "".
     2429                                next.
     2430                             end.
     2431                             v-grp-name = buf_buyer-group.name .
     2432                  end.
     2433               end.
     2434               else do:
     2435                    v-grp-name = "".
     2436                    next.
     2437               end.
     2438            end.
     2439            if buf_price-all.tog-id > 0 then do:
     2440               find first buf_turnover-group no-lock where
     2441                          buf_turnover-group.tog-id     = buf_price-all.tog-id      and
     2442                          buf_turnover-group.tog-db-num = buf_price-all.tog-db-num  no-error .
     2443               if available buf_turnover-group then do:
     2444                  if p-cli-type <> "" and p-cli-type <> ? then do:
     2445                     v-cli-oborot = v-cli-oborot-all  .
     2446                     find first buf1_tnv-in-turnover-group no-lock where
     2447                                buf1_tnv-in-turnover-group.stts       =  0     and
     2448                                buf1_tnv-in-turnover-group.tog-id     =  buf_turnover-group.tog-id     and
     2449                                buf1_tnv-in-turnover-group.tog-db-num =  buf_turnover-group.tog-db-num and
     2450                                buf1_tnv-in-turnover-group.ttg-summa  <=  v-cli-oborot no-error .
     2451                     find first buf2_tnv-in-turnover-group no-lock where
     2452                                buf2_tnv-in-turnover-group.stts       =  0     and
     2453                                buf2_tnv-in-turnover-group.tog-id     =  buf_turnover-group.tog-id     and
     2454                                buf2_tnv-in-turnover-group.tog-db-num =  buf_turnover-group.tog-db-num and
     2455                                buf2_tnv-in-turnover-group.ttg-summa  >=  v-cli-oborot no-error .
     2456                     if not (available buf1_tnv-in-turnover-group and
     2457                             available buf2_tnv-in-turnover-group ) then do:
     2458                             v-grp-name = "".
     2459                             next .
     2460                     end.
     2461                     v-grp-name = buf_turnover-group.name.
     2462                  end.
     2463               end.
     2464               else do:
     2465                    v-grp-name = "".
     2466                    next.
     2467               end.
     2468            end.
     2469            if buf_price-all.plt-fix-cource-crc-base = true then
     2470               assign
     2471                 v-base-rate  = buf_price-all.pdf-base-rate
     2472                 v-base-scale = buf_price-all.pdf-base-scale
     2473               .
     2474               else
     2475               assign
     2476                 v-base-rate  = v-base-rate0
     2477                 v-base-scale = v-base-scale0
     2478               .
     2479            if buf_price-all.plt-fix-cource-crc-doc = true then
     2480               assign
     2481                 v-exch-rate  = buf_price-all.pdf-exch-rate
     2482                 v-exch-scale = buf_price-all.pdf-exch-scale
     2483               .
     2484               else do:
     2485   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2486   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run exchrate in g#library
     2487     (input  buf_price-all.curr-code
     2488     ,input  to-day
     2489     ,output v-exch-rate0
     2490     ,output v-exch-scale0
     2491     ,output v-curr-abbr
     2492     )  .
     2493               assign
     2494                 v-exch-rate  = v-exch-rate0
     2495                 v-exch-scale = v-exch-scale0
     2496                 .
     2497              end.
     2498              v-date-1 = date ( "" )  .
     2499              if buf_price-all.fact-order-sys-from > 0 then do:
     2500                 if buf_price-all.start-sys-date <> ?   then  v-date-1 = buf_price-all.start-sys-date.
     2501                 if buf_price-all.start-shift-date <> ? then  v-date-1 = buf_price-all.start-shift-date.
     2502                 if buf_price-all.start-date <> ?       then  v-date-1 = buf_price-all.start-date.
     2503              end.
     2504              v-date-2 =  date ( "" )  .
     2505              if buf_price-all.fact-order-sys-to > 0 then do:
     2506                 if buf_price-all.end-sys-date <> ?     then  v-date-2 = buf_price-all.end-sys-date.
     2507                 if buf_price-all.end-shift-date <> ?   then  v-date-2 = buf_price-all.end-shift-date.
     2508                 if buf_price-all.end-date <> ?         then  v-date-2 = buf_price-all.end-date.
     2509              end.
     2510              if buf_price-all.qnty-from <> ? then do :
     2511                 if not (
     2512                 ( p-qnty-doc  >= buf_price-all.qnty-from and buf_price-all.qnty-to = ? ) or
     2513                 ( p-qnty-doc  >= buf_price-all.qnty-from and p-qnty-doc <= buf_price-all.qnty-to and buf_price-all.qnty-to <> ?)
     2514                 ) then do:
     2515                        v-interv = "".
     2516                        next.
     2517                 end.
     2518                 v-interv = "К: " + string(buf_price-all.qnty-from) + " - " + ( if buf_price-all.qnty-to = ? then "и более" else string(buf_price-all.qnty-to)) .
     2519              end.
     2520              if buf_price-all.sum-from <> ? then do :
     2521                 if not (
     2522                 ( p-sum-doc  >= buf_price-all.sum-from and buf_price-all.sum-to = ? ) or
     2523                 ( p-sum-doc  >= buf_price-all.sum-from and p-sum-doc <= buf_price-all.sum-to and buf_price-all.sum-to <> ?)
     2524                 ) then do:
     2525                    v-interv = "".
     2526                    next.
     2527                 end.
     2528                 v-interv = "C: " +  string(buf_price-all.sum-from) + " - " + ( if buf_price-all.sum-to = ? then "и более" else string(buf_price-all.sum-to)) .
     2529              end.
     2530              if buf_price-all.turnover-from <> ? then do :
     2531                 if not (
     2532                 ( v-cli-oborot-ALL  >= buf_price-all.turnover-from and buf_price-all.turnover-to = ? ) or
     2533                 ( v-cli-oborot-ALL  >= buf_price-all.turnover-from and v-cli-oborot-ALL <= buf_price-all.turnover-to and buf_price-all.turnover-to <> ?)
     2534                 ) then do:
     2535                    v-interv = "".
     2536                    next.
     2537                 end.
     2538                 v-interv = "O: " +  string(buf_price-all.turnover-from) + " - " + ( if buf_price-all.turnover-to = ? then "и более" else string(buf_price-all.turnover-to)) .
     2539              end.
     2540              if buf_price-all.use-pay-type = 1 then do :
     2541                 if buf_price-all.pay-code <> v-trn-pay-code then do:
     2542                    v-pay-name = "" .
     2543                    next.
     2544                  end.
     2545                  v-pay-name = 'Оплата':U +  ":" + string(buf_price-all.pay-code) .
     2546              end.
     2547              if buf_price-all.use-cash-pay = 1 then do :
     2548                 if v-cash-pay-code <> 0 and  not ( buf_price-all.curr-pay-code = v-cash-pay-curr and
     2549                                                    buf_price-all.cdpay-code    = v-cash-pay-code ) then do:
     2550                   v-pay-name = "" .
     2551                   next.
     2552                 end.
     2553                 v-pay-name = 'Касс.платеж':U + ":" + string(buf_price-all.cdpay-code) + "_" + string(buf_price-all.curr-pay-code).
     2554              end.
     2555             find first buf_bar-code no-lock where buf_bar-code.b-code = buf_price-all.b-code no-error .
     2556             create tt_price-all .
     2557             buffer-copy buf_price-all to tt_price-all
     2558             assign
     2559               tt_price-all.price-sale-rubl = buf_price-all.price-sale  * v-exch-rate / v-exch-scale
     2560               tt_price-all.road-tax-rubl   = buf_price-all.road-tax    * v-exch-rate / v-exch-scale
     2561               tt_price-all.excise-rubl     = buf_price-all.excise      * v-exch-rate / v-exch-scale
     2562               tt_price-all.price-sale-base = tt_price-all.price-sale-rubl  / v-base-rate * v-base-scale
     2563               tt_price-all.road-tax-base   = tt_price-all.road-tax-rubl    / v-base-rate * v-base-scale
     2564               tt_price-all.excise-base     = tt_price-all.excise-rubl      / v-base-rate * v-base-scale
     2565               tt_price-all.price-sale     = buf_price-all.price-sale
     2566               tt_price-all.road-tax       = buf_price-all.road-tax
     2567               tt_price-all.excise         = buf_price-all.excise
     2568               tt_price-all.pdf-exch-rate   = v-exch-rate
     2569               tt_price-all.pdf-exch-scale  = v-exch-scale
     2570               tt_price-all.pdf-base-rate   = v-base-rate
     2571               tt_price-all.pdf-base-scale  = v-base-scale
     2572               tt_price-all.grp-name        = v-grp-name
     2573               tt_price-all.date-1          = v-date-1
     2574               tt_price-all.shift-1         = buf_price-all.start-shift-num
     2575               tt_price-all.time-1          = buf_price-all.start-sys-time
     2576               tt_price-all.date-2          = v-date-2
     2577               tt_price-all.shift-2         = buf_price-all.end-shift-num
     2578               tt_price-all.time-2          = buf_price-all.end-sys-time
     2579               tt_price-all.interv-name     = v-interv
     2580               tt_price-all.pay-name        = v-pay-name
     2581               tt_price-all.unit-cli        = buf_bar-code.unit-cli
     2582             .
     2583   end.
     2584   define variable vt-plt-id as integer   no-undo .
     2585   define variable vt-plt-db as integer   no-undo .
     2586   define variable vt-pdf-id as integer   no-undo .
     2587   define variable vt-pdf-db as integer   no-undo .
     2588   define buffer neos_price-all for tt_price-all  .
     2589   find first tt_price-all where tt_price-all.b-code = p-main-b-code use-index pi no-error .
     2590       if available tt_price-all then do:
     2591        assign
     2592          vt-plt-id = tt_price-all.plt-id
     2593          vt-plt-db = tt_price-all.plt-db-num
     2594          vt-pdf-id = tt_price-all.pdf-id
     2595          vt-pdf-db = tt_price-all.pdf-db
     2596        .
     2597        if tt_price-all.b-code = p-b-code then do:
     2598             assign
     2599               p-plt-id           = tt_price-all.plt-id
     2600               p-plt-db-num       = tt_price-all.plt-db-num
     2601               p-pdf-id           = tt_price-all.pdf-id
     2602               p-pdf-db-num       = tt_price-all.pdf-db
     2603               p-sale-price-base  = tt_price-all.price-sale-base
     2604               p-sale-price-rubl  = tt_price-all.price-sale-rubl
     2605               p-road-tax-base    = tt_price-all.road-tax-base
     2606               p-road-tax-rubl    = tt_price-all.road-tax-rubl
     2607               p-excise-base      = tt_price-all.excise-base
     2608               p-excise-rubl      = tt_price-all.excise-rubl
     2609               .
     2610        end.
     2611        else do:
     2612          find first neos_price-all where
     2613                     neos_price-all.b-code     = p-b-code  and
     2614                     neos_price-all.plt-id     = vt-plt-id and
     2615                     neos_price-all.plt-db-num = vt-plt-db and
     2616                     neos_price-all.pdf-id     = vt-pdf-id and
     2617                     neos_price-all.pdf-db     = vt-pdf-db
     2618                     use-index pi no-error .
     2619            if available neos_price-all then do:
     2620             assign
     2621               p-plt-id           = tt_price-all.plt-id
     2622               p-plt-db-num       = tt_price-all.plt-db-num
     2623               p-pdf-id           = tt_price-all.pdf-id
     2624               p-pdf-db-num       = tt_price-all.pdf-db
     2625               p-sale-price-base  = neos_price-all.price-sale-base
     2626               p-sale-price-rubl  = neos_price-all.price-sale-rubl
     2627               p-road-tax-base    = neos_price-all.road-tax-base
     2628               p-road-tax-rubl    = neos_price-all.road-tax-rubl
     2629               p-excise-base      = neos_price-all.excise-base
     2630               p-excise-rubl      = neos_price-all.excise-rubl
     2631               .
     2632            end.
     2633            else do:
     2634                 find first buf_bar-code no-lock where buf_bar-code.b-code = p-b-code no-error .
     2635                 if error-status :error    then do:
     2636                   message "Не найден бар-код" p-b-code view-as alert-box error .
     2637                   return error return-value .
     2638                 end.
     2639             assign
     2640               p-plt-id           = tt_price-all.plt-id
     2641               p-plt-db-num       = tt_price-all.plt-db-num
     2642               p-pdf-id           = tt_price-all.pdf-id
     2643               p-pdf-db-num       = tt_price-all.pdf-db
     2644               p-sale-price-base  = tt_price-all.price-sale-base
     2645               p-sale-price-rubl  = tt_price-all.price-sale-rubl
     2646               p-road-tax-base    = tt_price-all.road-tax-base
     2647               p-road-tax-rubl    = tt_price-all.road-tax-rubl
     2648               p-excise-base      = tt_price-all.excise-base
     2649               p-excise-rubl      = tt_price-all.excise-rubl * buf_bar-code.cli-base-rate
     2650               .
     2651            end.
     2652        end.
     2653     end.
     2654   end.
     2655   end procedure.
     2656   procedure mpl-tpl-auto :
     2657   define input  parameter p-b-code     as integer   no-undo .
     2658   define input  parameter p-obj-type   as character no-undo .
     2659   define input  parameter p-obj-code   as integer   no-undo .
     2660   define input  parameter p-plt-id     as integer   no-undo .
     2661   define input  parameter p-plt-db-num as integer   no-undo .
     2662   define input  parameter p-fact-order as decimal   no-undo .
     2663   define output parameter p-sale-price as decimal   no-undo .
     2664   define output parameter p-pdf-id     as integer   no-undo .
     2665   define output parameter p-pdf-db-num as integer   no-undo .
     2666     do
     2667     on error undo, return error return-value
     2668     :
     2669   if p-fact-order = ? then do:
     2670     run fact-order-mpl (
     2671         input   today       ,
     2672         input   p-obj-type  ,
     2673         input   p-obj-code  ,
     2674         output  p-fact-order ) .
     2675   end.
     2676   assign
     2677     p-pdf-id      = ?
     2678     p-pdf-db-num  = ?
     2679     p-sale-price  = ?
     2680   .
     2681   define buffer buf_bar-code for ub.bar-code  .
     2682   define buffer buf_goods for ub.goods  .
     2683   find first buf_bar-code no-lock where
     2684              buf_bar-code.b-code = p-b-code
     2685              no-error .
     2686   if error-status :error then return error return-value .
     2687   find first buf_goods no-lock where
     2688              buf_goods.gds-code = buf_bar-code.gds-code
     2689              no-error .
     2690   if error-status :error then return error return-value .
     2691   define variable v-main-b-code as integer   no-undo .
     2692   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     2693     (input  buf_goods.gds-code
     2694     ,input  ?
     2695     ,output v-main-b-code
     2696     )  .
     2697   define buffer buf_price-all for ub.price-all  .
     2698   for each tt_price-all : delete tt_price-all. end.
     2699       for each buf_price-all no-lock where
     2700               buf_price-all.plt-id     = p-plt-id                 and
     2701               buf_price-all.plt-db-num = p-plt-db-num             and
     2702               buf_price-all.obj-type   = p-obj-type               and
     2703               buf_price-all.obj-code   = p-obj-code               and
     2704               buf_price-all.gds-code   = buf_goods.gds-code       and
     2705             ( buf_price-all.b-code = v-main-b-code or
     2706               buf_price-all.b-code = p-b-code)    and
     2707               buf_price-all.status_    = 'акт':U         and
     2708               buf_price-all.fact-order-sys-from  <= p-fact-order  and
     2709             ( buf_price-all.fact-order-sys-to = ? or
     2710               buf_price-all.fact-order-sys-to >=  p-fact-order)
     2711               :
     2712                 create tt_price-all .
     2713                 buffer-copy buf_price-all to tt_price-all
     2714                 assign
     2715                   tt_price-all.price-sale  = buf_price-all.price-sale
     2716                 .
     2717       end.
     2718   define variable vt-plt-id as integer   no-undo .
     2719   define variable vt-plt-db as integer   no-undo .
     2720   define variable vt-pdf-id as integer   no-undo .
     2721   define variable vt-pdf-db as integer   no-undo .
     2722   define buffer neos_price-all for tt_price-all  .
     2723   find first tt_price-all where tt_price-all.b-code = v-main-b-code use-index pi no-error .
     2724       if available tt_price-all then do:
     2725        assign
     2726          vt-plt-id = tt_price-all.plt-id
     2727          vt-plt-db = tt_price-all.plt-db-num
     2728          vt-pdf-id = tt_price-all.pdf-id
     2729          vt-pdf-db = tt_price-all.pdf-db
     2730        .
     2731        if tt_price-all.b-code = p-b-code then do:
     2732             assign
     2733               p-plt-id           = tt_price-all.plt-id
     2734               p-plt-db-num       = tt_price-all.plt-db-num
     2735               p-pdf-id           = tt_price-all.pdf-id
     2736               p-pdf-db-num       = tt_price-all.pdf-db
     2737               p-sale-price       = tt_price-all.price-sale
     2738               .
     2739        end.
     2740        else do:
     2741          find first neos_price-all where
     2742                     neos_price-all.b-code     = p-b-code  and
     2743                     neos_price-all.plt-id     = vt-plt-id and
     2744                     neos_price-all.plt-db-num = vt-plt-db and
     2745                     neos_price-all.pdf-id     = vt-pdf-id and
     2746                     neos_price-all.pdf-db     = vt-pdf-db
     2747                     use-index pi no-error .
     2748            if available neos_price-all then do:
     2749             assign
     2750               p-plt-id           = tt_price-all.plt-id
     2751               p-plt-db-num       = tt_price-all.plt-db-num
     2752               p-pdf-id           = tt_price-all.pdf-id
     2753               p-pdf-db-num       = tt_price-all.pdf-db
     2754               p-sale-price       = neos_price-all.price-sale
     2755               .
     2756            end.
     2757            else do:
     2758           find first buf_bar-code no-lock where buf_bar-code.b-code = p-b-code no-error .
     2759           if error-status :error    then do:
     2760              message "Не найден бар-код" p-b-code view-as alert-box error .
     2761              return error return-value .
     2762           end.
     2763             assign
     2764               p-plt-id           = tt_price-all.plt-id
     2765               p-plt-db-num       = tt_price-all.plt-db-num
     2766               p-pdf-id           = tt_price-all.pdf-id
     2767               p-pdf-db-num       = tt_price-all.pdf-db
     2768               p-sale-price       = tt_price-all.price-sale * buf_bar-code.cli-base-rate
     2769               .
     2770            end.
     2771        end.
     2772     end.
     2773     end.
     2774   end procedure.
     2775   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2776   procedure doc-code:
     2777   define input  parameter parmode          as   character           no-undo.
     2778   define input  parameter parobj-type      like ub.clients.obj-type no-undo.
     2779   define input  parameter parobj-code      like ub.clients.obj-code no-undo.
     2780   define input  parameter parroot-doc-code like ub.trn-doc.doc-code no-undo.
     2781   define output parameter pardoc-code      like ub.trn-doc.doc-code no-undo.
     2782   define buffer buf_sys-ctrl for ub.sys-ctrl  .
     2783   define variable vardb-remote     as   logical             no-undo.
     2784   define variable vartemp-doc-code like ub.trn-doc.doc-code no-undo.
     2785   define variable v-delimiter as character no-undo .
     2786   do
     2787   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     2788   :
     2789   find first buf_sys-ctrl no-lock .
     2790   vardb-remote = buf_sys-ctrl.db-num <> 0 .
     2791     CASE parmode:
     2792       when "main":u then do:
     2793         if vardb-remote then do:
     2794           assign
     2795             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (parobj-code, ">>>>9")) + substring (parobj-type, (if g#language = "RUS" then 1 else 2), 1).
     2796         end.
     2797         else do:
     2798           assign
     2799             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-".
     2800         end.
     2801       end.
     2802       when "trio" then do:
     2803         assign
     2804           pardoc-code = replace (parroot-doc-code, "=", "*").
     2805       end.
     2806       otherwise do:
     2807         assign
     2808         v-delimiter = entry(lookup(entry(1, parmode), "main,chip,pair,flora,trio-m,quadro,stock-up,stock-down,stock-fix," +                          "main_s,chip_s,pair_s,trio-m_s,quadro_s,stock-up_s,stock-down_s,stock-fix_s":U), ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)))
     2809         no-error
     2810         .
     2811         if error-status:error  then do:
     2812           undo, return error substitute("Ошибка при генерации номера документа&1Неверное значение параметра parmode &2"
     2813                                         ,chr(10)
     2814                                         ,parmode
     2815                                         ).
     2816         end.
     2817         if num-entries(parmode) = 1
     2818         and parmode <> "chip":U
     2819         and parmode <> "chip_s":U
     2820         then do:
     2821           assign
     2822           pardoc-code = replace (parroot-doc-code, "-", v-delimiter).
     2823         end.
     2824         else if (lookup("chip":U, parmode) > 0
     2825                  or
     2826                  lookup("chip_s":U, parmode) > 0) then do:
     2827           assign
     2828             vartemp-doc-code = parroot-doc-code.
     2829           do while true:
     2830             if index (vartemp-doc-code , ".") = 0 then
     2831               vartemp-doc-code  = replace (vartemp-doc-code , v-delimiter, v-delimiter + "1.").
     2832             else
     2833               vartemp-doc-code  =
     2834               substring (vartemp-doc-code , 1, index (vartemp-doc-code, v-delimiter)) +
     2835               string (integer (substring (vartemp-doc-code, index (vartemp-doc-code, v-delimiter) + 1, index (vartemp-doc-code, ".") - index (vartemp-doc-code, v-delimiter) - 1)) + 1) +
     2836               substring (vartemp-doc-code, index (vartemp-doc-code, ".")).
     2837             if not can-find (ub.trn-doc where ub.trn-doc.doc-code = vartemp-doc-code no-lock) then leave.
     2838           end.
     2839           assign
     2840             pardoc-code = vartemp-doc-code.
     2841         end.
     2842       end.
     2843     end CASE.
     2844     if pardoc-code = '':U
     2845     or (parroot-doc-code <> '':U
     2846     and pardoc-code = parroot-doc-code) then do:
     2847       undo, return error substitute("Ошибка при генерации номера документа&1"
     2848                                     ,chr(10)).
     2849     end.
     2850   end.
     2851   end. // procedure/method
     2852   function get-doc-code-int64 returns int64
     2853     ( input p-doc-code as character ) :
     2854     define variable v-ind              as integer   no-undo .
     2855     define variable v-num-entries      as integer   no-undo .
     2856     define variable v-doc-code-int64   as int64     no-undo .
     2857     define variable v-canonic-doc-code as character no-undo .
     2858     assign
     2859       v-num-entries      = num-entries( ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) )
     2860       v-canonic-doc-code = p-doc-code
     2861     .
     2862     do v-ind = 1 to v-num-entries
     2863     :
     2864       assign
     2865         v-canonic-doc-code = entry(1, v-canonic-doc-code, entry( v-ind, ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) ) )
     2866       .
     2867     end.
     2868     assign
     2869       v-doc-code-int64 = int64(v-canonic-doc-code) no-error
     2870     .
     2871     return v-doc-code-int64 .
     2872   end. // function/method
