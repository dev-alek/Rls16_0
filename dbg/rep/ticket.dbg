     3155       p-calories      = ?
     3156     .
     3157     find first buf_goods no-lock
     3158       where buf_goods.artic     = p-artic
     3159         and buf_goods.prod-type = p-prod-type
     3160         and buf_goods.prod-code = p-prod-code
     3161     no-error .
     3162     if not available buf_goods
     3163     then do:
     3164       return .
     3165     end.
     3166     assign
     3167       v-is-global = yes
     3168     .
     3169     find first buf_fbr-gds-obj no-lock
     3170       where buf_fbr-gds-obj.obj-type = p-obj-type
     3171         and buf_fbr-gds-obj.obj-code = p-obj-code
     3172         and buf_fbr-gds-obj.gds-code = buf_goods.gds-code
     3173     no-error .
     3174     if available buf_fbr-gds-obj
     3175     then do:
     3176       if  buf_fbr-gds-obj.is-semi-finished or
     3177           buf_fbr-gds-obj.is-menu
     3178       then do:
     3179         assign
     3180           v-is-global = no
     3181         .
     3182         find first buf_recipe no-lock
     3183           where buf_recipe.recipe-code = buf_fbr-gds-obj.default-recipe-code
     3184         no-error .
     3185         if available buf_recipe
     3186         then do:
     3187           assign
     3188             v-is-global = ( buf_recipe.host-code = 0    ) and
     3189                           ( buf_recipe.obj-type  = "":U ) and
     3190                           ( buf_recipe.obj-code  = 0    )
     3191           .
     3192         end.
     3193       end.
     3194     end.
     3195     if v-is-global = yes
     3196     then do:
     3197       assign
     3198         v-attr-code = 'calories':U
     3199       .
     3200       assign                       v-nutro-value = ?                     .                     run gds-attr-exist in this-procedure ( input  buf_goods.gds-code                                                          , input  v-attr-code                                                          , output v-exist                                                          ) no-error .                     if error-status :error = yes or                         v-exist = no                     then do:                       assign                         v-nutro-value = ?                       .                     end.                     else do:                       run gds-attr-value in this-procedure ( input  buf_goods.gds-code                                                           , input  v-attr-code                                                           , output v-attr-value                                                           , output v-attr-type                                                           ) no-error .                       if error-status :error                       then do:                         assign                           v-nutro-value = ?                         .                       end.                       assign                         v-nutro-value = decimal( v-attr-value )                       no-error .                       if error-status :error = yes                       then do:                         assign                           v-nutro-value = ?                         .                       end.                     end.
