     3267   DEFINE VARIABLE price-rb-old like ub.price-list.price-prev no-undo.
     3268   DEFINE VARIABLE str-price-rb-old as character no-undo.
     3269   DEFINE VARIABLE price-alt-rb like ub.price-list.price-sale no-undo.
     3270   DEFINE VARIABLE str-price-alt-rb as character no-undo.
     3271   DEFINE VARIABLE price-alt-rb-old like ub.price-list.price-prev no-undo.
     3272   DEFINE VARIABLE str-price-alt-rb-old as character no-undo.
     3273   DEFINE VARIABLE rt-b-code           like ub.bar-code.b-code     no-undo .
     3274   DEFINE VARIABLE rt-price-list-recid as   recid                  no-undo.
     3275   DEFINE VARIABLE rt-cli-base-rate    like ub.bar-code.cli-base-rate no-undo.
     3276   DEFINE VARIABLE v-price-list-recid  as   recid                  no-undo.
     3277   DEFINE VARIABLE v-cli-base-rate     like ub.bar-code.cli-base-rate no-undo.
     3278   define variable v-base-code like ub.sysconf.base-code no-undo .
     3279   DEFINE buffer OurObj for ub.clients.
     3280   DEFINE buffer OurHost for ub.clients.
     3281   define buffer buf_price-list for ub.price-list.
     3282   define buffer b-root_price-list for ub.price-list.
     3283   define buffer buf_trn-doc for ub.trn-doc .
     3284   define shared Stream OutStream.
     3285   define variable v-sys-key      as character no-undo .
     3286   define variable par-type     as character no-undo .
     3287   define variable v-rb-is-base as logical no-undo .
     3288   define variable cur-pr like ub.price-list.price-sale no-undo.
     3289   define variable cur-rt like ub.price-list.road-tax   no-undo.
     3290   define variable cur-ex like ub.price-list.excise     no-undo.
     3291   define variable cur-dn like ub.price-list.doc-num    no-undo.
     3292   define variable v-mrtr-code as character no-undo .
     3293   define variable v-ticket-vat-pc        like ub.doc-line.vat-pc    no-undo.
     3294   define variable v-ticket-slt-pc        like ub.doc-line.slt-pc    no-undo.
     3295   define variable v-ticket-host-code     like ub.sysconf.host-code  no-undo.
     3296   define variable v-ticket-today         as date                 no-undo.
     3297   define variable v-dflt-cd as character no-undo .
     3298   define variable l-prod-bc-pgweight as logical no-undo .
     3299   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile:currsysk.i $ $Revision: $".
     3300   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run currsysk in g#library
     3301     (output v-sys-key
     3302     ) no-error .
     3303   find ub.gds-grp where ub.gds-grp.node-code = buf-par_goods.grp-code no-lock.
     3304   find ub.gds-prt where ub.gds-prt.node-code = buf-par_bar-code.node-code no-lock.
     3305   if ub.gds-prt.node-code <> rootnode_code then
     3306       assign
     3307           gds-prt_node-name = ub.gds-prt.node-name
     3308           gds-prt_f-name = ub.gds-prt.f-name
     3309           .
     3310   else
     3311       assign
     3312           gds-prt_node-name = ""
     3313           gds-prt_f-name = ""
     3314           .
     3315   find first ub.country no-lock
     3316     where ub.country.alpha1 = buf-par_goods.alpha1
     3317     no-error.
     3318   if available ub.country then do:
     3319     assign
     3320       country_name = ub.country.short-name
     3321     .
     3322   end.
     3323   else do:
     3324     assign
     3325       country_name = ""
     3326     .
     3327   end.
     3328   find first ub.clients no-lock
     3329     where ub.clients.obj-type = buf-par_goods.prod-type
     3330       and ub.clients.obj-code = buf-par_goods.prod-code
     3331     .
     3332   assign
     3333     prod_name = ub.clients.obj-name
     3334   .
     3335   if available buf-par_scales-gds then do:
     3336     find first ub.scales-gds no-lock
     3337       where rowid( ub.scales-gds ) = rowid( buf-par_scales-gds )
     3338       .
     3339     release buf-par_scales-gds.
     3340   end.
     3341   else do:
     3342     if TickOnW = true then do:
     3343       find first ub.scales-gds no-lock
     3344         where ub.scales-gds.b-code   = buf-par_bar-code.b-code
     3345           and ub.scales-gds.obj-type = p-obj-type
     3346           and ub.scales-gds.obj-code = p-obj-code
     3347         no-error.
     3348     end.
     3349   end.
     3350   if available ub.scales-gds then do:
     3351     assign
     3352         bar_code = ""
     3353         ListProdBc = (if Action <> "PROD-BC"
     3354                       and not (action = "LIST-bb"
     3355                       and listprodbc <> '')
     3356                       then "":U else ListProdBc)
     3357         .
     3358     FIND OurObj WHERE OurObj.obj-type = ub.scales-gds.obj-type
     3359                   AND OurObj.obj-code = ub.scales-gds.obj-code NO-LOCK.
     3360     varattr-value = "":U.
     3361     run gdsoattr-value in this-procedure(
     3362                                           input 'scales-code':U
     3363                                           ,input buf-par_bar-code.gds-code
     3364                                           ,input OurObj.obj-type
     3365                                           ,input OurObj.obj-code
     3366                                           ,output varattr-value
     3367                                           ,output varattr-type
     3368                                           ) no-error.
     3369     if varattr-value = "":U then do:
     3370       message "Товар ~"" buf-par_goods.gds-name "~" (арт.: " buf-par_goods.artic " произв.:" buf-par_goods.prod-type " " buf-par_goods.prod-code ") " SKIP
     3371               "весовой, но не имеет весового кода." SKIP
     3372               "Ценник не может быть распечатан !"
     3373               view-as alert-box INFORMATION TITLE "".
     3374       NEXT.
     3375     end.
     3376   end.
     3377   else do:
     3378     FIND ub.units WHERE ub.units.unit-name = buf-par_bar-code.unit-cli NO-LOCK.
     3379     if lookup('вес':U, ub.units.type) > 0
     3380       and NOT TickOnW
     3381     then do:
     3382       message "Товар ~"" buf-par_goods.gds-name "~" (арт.: " buf-par_goods.artic " произв.:" buf-par_goods.prod-type " " buf-par_goods.prod-code ") "
     3383                       "весовой." SKIP
     3384                       "Ценник не может быть распечатан ! Воспользуйтесь справочником весов."
     3385                       view-as alert-box INFORMATION TITLE "".
     3386       NEXT.
     3387     end.
     3388     RUN gen-bc( input ( if v-sys-key = "Trg" then integer( buf-par_goods.artic ) else buf-par_bar-code.b-code ), output bar_code ).
     3389     FIND OurObj WHERE OurObj.obj-type = p-obj-type
     3390                   AND OurObj.obj-code = p-obj-code
     3391                 NO-LOCK.
     3392     if action <> "PROD-BC":U
     3393     and not (action = "LIST-bb"
     3394     and listprodbc <> '')
     3395     then do:
     3396       assign ListProdBc = "":U .
     3397       _prod-bc:
     3398       FOR EACH ub.prod-bc WHERE ub.prod-bc.b-code = buf-par_bar-code.b-code
     3399                         AND ub.prod-bc.bc-on = TRUE
     3400                       NO-LOCK :
     3401         if lookup('шту':U, units.type) > 0 then do:
     3402           l-prod-bc-pgweight = yes.
     3403   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3404   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prodbcat in g#library
     3405     (buffer ub.prod-bc
     3406     ,input  'pgweight=request':u
     3407     ,output l-prod-bc-pgweight
     3408     ) no-error .
     3409           if l-prod-bc-pgweight then do:
     3410             next _prod-bc.
     3411           end.
     3412         end.
     3413           assign ListProdBc = ListProdBc + prod-bc.b-str + ",":U.
     3414       END.
     3415       assign
     3416           ListProdBc = SUBSTRING( ListProdBc, 1, 200 )
     3417           ListProdBc = RIGHT-TRIM( ListProdBc, ",":U )
     3418           .
     3419     end.
     3420   end.
     3421   CASE OurObj.obj-type:
     3422       WHEN 'скл':U THEN
     3423           do:
     3424               FIND ub.store WHERE ub.store.obj-code = OurObj.obj-code NO-LOCK.
     3425               FIND OurHost WHERE OurHost.obj-type = 'орг':U
     3426                              AND OurHost.obj-code = ub.store.host-code
     3427                            NO-LOCK.
     3428   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3429   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     3430     (input  ub.store.host-code
     3431     ,output v-base-code
     3432     )  .
     3433           end.
     3434       WHEN 'маг':U THEN
     3435           do:
     3436               FIND ub.shop WHERE ub.shop.obj-code = OurObj.obj-code NO-LOCK.
     3437               FIND OurHost WHERE OurHost.obj-type = 'орг':U
     3438                                                  AND OurHost.obj-code = ub.shop.host-code NO-LOCK.
     3439   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3440   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     3441     (input  ub.shop.host-code
     3442     ,output v-base-code
     3443     )  .
     3444           end.
     3445   END CASE.
     3446   CASE QntyType:
     3447       WHEN "один" THEN
     3448           assign gds-qnty = 1.
     3449       WHEN "остаток" THEN
     3450           do:
     3451             assign gds-qnty = 0.
     3452             FIND ub.prt-obj WHERE ub.prt-obj.obj-type  = OurObj.obj-type
     3453                            AND ub.prt-obj.obj-code  = OurObj.obj-code
     3454                            AND ub.prt-obj.artic     = buf-par_goods.artic
     3455                            AND ub.prt-obj.prod-type = buf-par_goods.prod-type
     3456                            AND ub.prt-obj.prod-code = buf-par_goods.prod-code
     3457                            AND ub.prt-obj.prt-code  = buf-par_bar-code.node-code
     3458                          NO-LOCK NO-ERROR.
     3459             if available ub.prt-obj then
     3460                 assign gds-qnty = ub.prt-obj.fact-qnty.
     3461           end.
     3462       WHEN "список" THEN
     3463           assign gds-qnty = list-qnty.
     3464       WHEN "документ" THEN
     3465           assign gds-qnty = nakl-qnty.
     3466   END CASE.
     3467   if gds-qnty <= 0 then
     3468       NEXT.
     3469   assign
     3470       price = 0
     3471       price-old = 0
     3472       price-alt = 0
     3473       price-alt-old = 0
     3474       price-rb = 0
     3475       price-rb-old = 0
     3476       price-alt-rb = 0
     3477       price-alt-rb-old = 0
     3478       .
     3479   if PriceType <> "doc" and PriceType <> "doc-pr" then do:
     3480     assign v-fact-order = 0.
