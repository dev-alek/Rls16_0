     4063         (if buf-par_bar-code.cli-base-rate = 1 then buf-par_goods.qnty-cart else buf-par_bar-code.cli-base-rate) " " buf-par_goods.unit-base "|":U
     4064         buf-par_bar-code.b-code "|":U
