     4045         (if available ub.scales-gds then string("(" + string(ub.scales-gds.scales-num) + ")") else "" ) "|":U
     4046         "Цена за " replace( trim(buf-par_bar-code.unit-cli), "|":U, "/":U ) " (" buf-par_bar-code.cli-base-rate " " replace( buf-par_goods.unit-base, "|":U, "/":U ) "):" "|":U
     4047         str-price-alt "|":U
