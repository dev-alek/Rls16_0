       98   def   shared var bc-frmt as character no-undo .
       99   def   shared var bc-pfx  as character no-undo .
      100   def var bc-par-type as character no-undo .
      101   PROCEDURE gen-bc:
      102     def input  parameter internal-b-code like ub.bar-code.b-code no-undo .
      103     def output parameter full-b-code     as character init ""    no-undo .
      104   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      105     define variable tmp-str0  as character no-undo.
      106     define variable tmp-num0  as character no-undo.
      107     define variable i0        as integer   no-undo.
      108     define variable sum0      as integer   no-undo.
      109     define variable len-code0 as integer   no-undo.
      110     define variable varcont0  as logical   initial yes no-undo.
      111     CASE bc-frmt :
      112       WHEN "EAN13" THEN do:
      113         assign
      114           tmp-str0 = string( internal-b-code, "999999999999" )
      115         .
      116       end.
      117       WHEN "EAN8" THEN do:
      118         assign
      119           tmp-str0 = string( internal-b-code, "9999999" )
      120         .
      121       end.
      122       OTHERWISE DO:
      123           message "Неизвестный тип генерации бар-кода процедурой bc-gnrti.i: " bc-frmt " ."
      124           view-as alert-box error.
      125           return error.
      126       END.
      127     END CASE.
      128     if varcont0 = yes then do:
      129       if integer( substring( tmp-str0, 1, length( bc-pfx ) ) ) <> 0
      130       then do:
      131         message
      132           "Невозможно сформировать бар-код" SKIP
      133           "для товара с кодом: " internal-b-code
      134           view-as alert-box error title "подрезание кода".
      135         return error.
      136       end.
      137       else do:
      138         assign
      139           full-b-code = bc-pfx + substring( tmp-str0, length( bc-pfx ) + 1, length( tmp-str0 ) - length( bc-pfx ) )
      140           len-code0    = length( full-b-code )
      141         .
      142         define variable v-sum-char0 as character no-undo .
      143         assign
      144           sum0 = 0
      145         .
      146         do i0 = 1 to len-code0 by 2
      147         :
      148           assign
      149             v-sum-char0 = substr(full-b-code, len-code0 - i0 + 1, 1)
      150           .
      151           if v-sum-char0 < "0"
      152           or v-sum-char0 > "9"
      153           then do:
      154             message
      155               "Невозможно сформировать бар-код" skip
      156               "для товара с кодом: " internal-b-code skip
      157               view-as alert-box error title "подсчет контрольной суммы".
      158             return error.
      159           end.
      160           assign
      161             sum0 = sum0 + integer(v-sum-char0)
      162           .
      163         end.
      164         if varcont0 = yes then do:
      165           assign
      166             sum0 = sum0 * 3
      167           .
      168           do i0 = 2 to len-code0 by 2
      169           :
      170             assign
      171               v-sum-char0 = substr(full-b-code, len-code0 - i0 + 1, 1)
      172             .
      173             if v-sum-char0 < "0"
      174             or v-sum-char0 > "9"
      175             then do:
      176               message
      177                 "Невозможно сформировать бар-код" skip
      178                 "для товара с кодом: " internal-b-code skip
      179                 view-as alert-box error title "подсчет контрольной суммы".
      180               return error.
      181             end.
      182             assign
      183               sum0 = sum0 + integer(v-sum-char0)
      184             .
      185           end.
      186           if varcont0 = yes then do:
      187              if sum0 mod 10 = 0 then do:
      188                assign
      189                  full-b-code = full-b-code + '0'
      190                .
      191              end.
      192              else do:
      193                assign
      194                  full-b-code = full-b-code + string(10 - sum0 mod 10)
      195                .
      196              end.
      197           end.
      198         end.
      199       end.
      200     end.
      201   END PROCEDURE.
      202   def   shared var pl-frmt as character no-undo .
      203   def   shared var pl-pfx  as character no-undo .
      204   def var pl-par-type as character no-undo .
      205   PROCEDURE gen-pl:
