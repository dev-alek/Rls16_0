      438       DEF STREAM stm-log.
      439       PROCEDURE writelog:
      440       DEF INPUT PARAMETER p-file-name AS CHAR     NO-UNDO.
      441       DEF INPUT PARAMETER p-log-level AS INTEGER  NO-UNDO.
      442       DEF INPUT PARAMETER p-log-string  AS CHAR     NO-UNDO.
      443       if p-file-name <> ""
      444       then do:
      445       OUTPUT STREAM stm-log TO VALUE(p-file-name) APPEND.
      446           PUT STREAM stm-log UNFORMATTED chr(10).
      447           PUT STREAM stm-log UNFORMATTED (IF (p-log-level = 0 OR p-log-string = "&DLine"
      448                                           OR p-log-string = "&Line") THEN "" ELSE
      449                                           cur-time-string-sec() + " ").
      450           PUT STREAM stm-log UNFORMATTED
      451                   (IF p-log-string = "&Line" THEN FILL("-", 80)
      452                   ELSE IF p-log-string = "&DLine" THEN FILL("=", 80)
      453                   ELSE fill(" ", p-log-level * 2) + p-log-string).
      454       OUTPUT STREAM stm-log CLOSE.
      455       end.
      456       END PROCEDURE.
