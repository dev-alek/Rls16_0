     6252       .
     6253   end.
     6254   else do:
     6255   define variable vss-include-info36 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6256   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     6257     (input  v-host-code
     6258     ,output v-curr-code
     6259     )  .
     6260   end.
     6261   run torgconf-read in this-procedure (
     6262         input "torg12n"
     6263       , input v-host-code
     6264       , input t-doc.obj-type
     6265       , input t-doc.obj-code
     6266   ) no-error.
     6267   if error-status :error
     6268   then do:
     6269       message
     6270       vss-workfile vss-revision vss-description
     6271       skip "Ошибка чтения параметров печати формы."
     6272       skip "Форма будет напечатана с параметрами по умолчанию."
     6273       skip return-value
     6274       skip trim(error-status :get-message(1))
     6275           trim(error-status :get-message(2))
     6276           trim(error-status :get-message(3))
     6277       view-as alert-box error.
     6278   end.
     6279   run torgconf-get-self-param in this-procedure (
     6280         input t-doc.obj-type
     6281       , input t-doc.obj-code
     6282       , input v-curr-code
     6283   ) no-error.
     6284   if error-status :error
     6285   then do:
     6286       message
     6287       vss-workfile vss-revision vss-description
     6288       skip "Ошибка чтения параметров объекта документа."
     6289       skip return-value
     6290       skip trim(error-status :get-message(1))
     6291           trim(error-status :get-message(2))
     6292           trim(error-status :get-message(3))
     6293       view-as alert-box warning.
     6294   end.
     6295   run torgconf-get-cli-param in this-procedure (
     6296         input t-doc.host-code
     6297       , input t-doc.cli-type
     6298       , input t-doc.cli-code
     6299       , input v-curr-code
     6300   ) no-error.
     6301   if error-status :error
     6302   then do:
     6303       message
     6304       vss-workfile vss-revision vss-description
     6305       skip "Ошибка чтения параметров объекта клиента документа."
     6306       skip return-value
     6307       skip trim(error-status :get-message(1))
     6308           trim(error-status :get-message(2))
     6309           trim(error-status :get-message(3))
     6310       view-as alert-box warning.
     6311   end.
     6312   run torgconf-get-form-header in this-procedure (
     6313         input no
     6314       , input t-doc.doc-code
     6315       , input ( v-print-doc = "yes" )
     6316       , input t-doc.doc-date
     6317       , input t-doc.fact-date
     6318       , input t-doc.doc-type
     6319       , input t-doc.status_
     6320       , input no
     6321       , input no
     6322   ).
     6323   define frame f-doc
     6324           sym1 column-label ":!:!:!:!:" format "X(1)" space(0)
     6325           v-doc-line-counter COLUMN-LABEL "N!п/п! ! ! " format ">>9" space(0)
     6326           sym2 column-label ":!:!:!:!:" format "X(1)" space(0)
     6327           goods.artic COLUMN-LABEL "Артикул! ! ! ! " format "X(17)" space(0)
     6328           sym3 column-label ":!:!:!:!:" format "X(1)" space(0)
     6329           goods.gds-name COLUMN-LABEL "Наименование товара! ! ! ! " format "X(29)" space(0)
     6330           sym4 column-label ":!:!:!:!:" format "X(1)" space(0)
     6331           v-b-code COLUMN-LABEL "Код товара! ! ! ! " format "X(13)" space(0)
     6332           sym5 column-label ":!:!:!:!:" format "X(1)" space(0)
     6333           v-price-kg COLUMN-LABEL "Цена!реал-ии!за кг! ! " format "->>>>>9.99" space(0)
     6334           sym6 column-label ":!:!:!:!:" format "X(1)" space(0)
     6335           v-price COLUMN-LABEL "Цена!реал-ии!за литр! ! " format "->>>>>>>9.99" space(0)
     6336           sym7 column-label ":!:!:!:!:" format "X(1)" space(0)
     6337           doc-line.fact-qnty COLUMN-LABEL "Количество!в литрах! ! ! " format "->>>>>9.<<<" space(0)
     6338           sym8 column-label ":!:!:!:!:" format "X(1)" space(0)
     6339           doc-line.fact-density COLUMN-LABEL "Плотность!по замеру!в автоцист.!кг/л! " format "9.999" space(0)
     6340           sym9 column-label ":!:!:!:!:" format "X(1)" space(0)
     6341           doc-line.temperature COLUMN-LABEL "Температура!по замеру!в автоцист.!град! " format "->9.999" space(0)
     6342           sym10 column-label ":!:!:!:!:" format "X(1)" space(0)
     6343           v-qnty-kg COLUMN-LABEL "Количество!в кг! ! ! " format "->>>>>9.<<<" space(0)
     6344           sym11 column-label ":!:!:!:!:" format "X(1)" space(0)
     6345           doc-line.VAT-pc column-label "Став-!ка!НДС!%! " format ">9.9<" space(0)
     6346           sym12 column-label ":!:!:!:!:" format "X(1)" space(0)
     6347           v-sum-without-vat-slt column-label "Сумма!без!НДС! ! " format "->>,>>>,>>9.99" space(0)
     6348           sym13 column-label ":!:!:!:!:" format "X(1)" space(0)
     6349           v-sum-vat column-label "Сумма!НДС! ! ! " format "->>,>>>,>>9.99" space(0)
     6350           sym14 column-label ":!:!:!:!:" format "X(1)" space(0)
     6351           v-sum-without-slt column-label "Сумма!с учетом!  НДС! ! " format "->>>,>>>,>>9.99" space(0)
     6352           sym15 column-label ":!:!:!:!:" format "X(1)" space(0)
     6353            header
     6354           string( "Цены и суммы указаны в " + trim( val-str ) ) format "X(30)"
     6355           string( "Документ N: " + tdoc-code + " от " + string(tdoc-date, "99/99/9999") ) at 40 format "X(50)"
     6356               ( if t-doc.status_ <> 'факт':U then
     6357                     string( "Статус документа: " + t-doc.status_ + " " + string( t-doc.flag_, "+/-" ) )
     6358                 else
     6359                     " " ) at 100 format "X(30)"
     6360               string( "Страница " + string( PAGE-NUMBER( out-stream ), ">>9" ) ) at 180 format "X(13)" SKIP
     6361           v-single-line format "X(189)" at 1
     6362       with width 235 down stream-io.
     6363   assign
     6364       v-single-line = fill("-", 221)
     6365       v-underline = fill("_", 221)
     6366       v-line-counter = 1
     6367       v-doc-line-counter = 0
     6368   .
     6369   assign
     6370       val-str = ( if PrintRubl then "рублях" else "баз.вал" )
     6371   .
     6372   assign tdoc-code = t-doc.doc-code.
     6373   assign tdoc-date =  ( if t-doc.status_ <> 'факт':U or v-print-doc = "yes"
     6374                       then t-doc.doc-date
     6375                       else t-doc.fact-date
     6376                       )
     6377   .
     6378   find first buf_clients where buf_clients.obj-type = t-doc.obj-type and
     6379                                buf_clients.obj-code = t-doc.obj-code no-lock no-error.
     6380   find first pay-type no-lock
     6381        where pay-type.obj-code = t-doc.pay-code no-error .
     6382   if session :set-wait-state( "compiler" ) then.
     6383   os-delete log-file-name.
     6384   run writelog in this-procedure (log-file-name, 0, "&Line").
     6385   output stream out-stream to value( string( session:temp-directory +
     6386                                        "rpt" + string( g#report-num ) ) )
     6387                                        page-size  value(43) .
     6388   form header
     6389       v-single-line format "X(198)" at 1 SKIP
     6390       "Продолжение - на следующей странице" at 30 SKIP
     6391       with frame BottomFrame width 235 PAGE-BOTTOM NO-LABELS NO-BOX .
     6392   view stream out-stream frame BottomFrame .
     6393   find first clients no-lock
     6394        where clients.obj-type = 'орг':U
     6395          and clients.obj-code = t-doc.host-code
     6396   .
     6397       case clients.obj-type:
     6398          when 'орг':U
     6399          then do:
     6400               FIND ub.firm WHERE ub.firm.firm-code = clients.obj-code NO-LOCK .
     6401               if available ub.firm
     6402               then do:
     6403                   assign
     6404                       t-addres = ( if ub.firm.ind = 0 or ub.firm.ind = ? then "" else string( ub.firm.ind ) )
     6405                       t-addres = t-addres
     6406                           + ( if ub.firm.city = ? or trim(ub.firm.city) = ""
     6407                               then ""
     6408                               else ( (if t-addres = "" then "" else ", ") + trim( ub.firm.city ) )
     6409                             )
     6410                       t-temp-address = ( if ub.firm.addres1 = ? then "" else trim( substring( ub.firm.addres1, 1, 50 ) ) )
     6411                       t-addres = t-addres + ( if t-addres = "" or t-temp-address = "" then "" else ", " )
     6412                           + ( if t-temp-address = "" then "" else ( trim( t-temp-address ) ) )
     6413                           + ( if  ub.firm.addres2 = ? or trim(ub.firm.addres2) = "" then "" else ( ", " + trim( ub.firm.addres2 ) ) )
     6414                       t-temp-address = ( if ub.firm.addres1 = ? then "" else trim( substring( ub.firm.addres1, 51, 50 ) ) )
     6415                       t-addres = t-addres + ( if t-addres = "" or t-temp-address = "" then "" else ", " )
     6416                           + ( if t-temp-address = "" then "" else ( trim( t-temp-address ) ) )
     6417                       t-temp-address = ( if ub.firm.addres1 = ? then "" else trim( substring( ub.firm.addres1, 101, 50 ) ) )
     6418                       t-addres = t-addres + ( if t-addres = "" or t-temp-address = "" then "" else ", " )
     6419                           + ( if t-temp-address = "" then "" else ( trim( t-temp-address ) ) )
     6420                       t-phone = ub.firm.phone
     6421                       t-inn   = ub.firm.inn
     6422                       t-okpo  = ub.firm.okpo
     6423                   .
     6424               end.
     6425          end.
     6426          when 'маг':U
     6427          then do:
     6428               FIND ub.shop WHERE ub.shop.obj-code = clients.obj-code NO-LOCK .
     6429               if available ub.shop
     6430               then do:
     6431                   assign
     6432                       t-addres = ( if trim( shop.addres1 ) <> "" then ( trim( shop.addres1 ) ) else "" )
     6433                               + ( if trim( shop.addres2 ) <> "" then ( ", " + trim( shop.addres2 ) ) else "" )
     6434                       t-phone = shop.phone
     6435                       t-inn = ""
     6436                       t-okpo = ""
     6437                   .
     6438               end.
     6439          end.
     6440          when 'скл':U
     6441          then do:
     6442               FIND ub.store WHERE ub.store.obj-code = clients.obj-code NO-LOCK .
     6443               if available ub.store
     6444               then do:
     6445                   assign
     6446                       t-addres = ( if trim( ub.store.addres1 ) <> "" then ( trim( ub.store.addres1 ) ) else "" )
     6447                               + ( if trim( ub.store.addres2 ) <> "" then ( ", " + trim( ub.store.addres2 ) ) else "" )
     6448                       t-phone = ub.store.phone
     6449                       t-inn = ""
     6450                       t-okpo = ""
     6451                   .
     6452               end.
     6453          end.
     6454          when 'чел':U
     6455          then do:
     6456               find ub.person where ub.person.psn-code = clients.obj-code no-lock .
     6457               if available ub.person
     6458               then do:
     6459                   assign
     6460                       t-addres = ( if ub.person.ind <> 0 and ub.person.ind <> ? then string( ub.person.ind ) else "" )
     6461                                   + ( if  ub.person.city <> ? and trim(ub.person.city) <> "" then ( ", " + trim( ub.person.city ) ) else "" )
     6462                                   + ( if  ub.person.address <> ? and trim(ub.person.address) <> "" then ( ", " + trim( ub.person.address ) ) else "" )
     6463                       t-phone = ub.person.phone1
     6464                       t-inn = ub.person.inn
     6465                       t-okpo = ub.person.okpo
     6466                   .
     6467               end.
     6468          end.
     6469       end case.
     6470   put stream out-stream
     6471       space(5) v-single-line format  "X(19)" at 180 skip
     6472       space(5) "| " at 180 'код':U at 188 "|" at 198 skip
     6473       space(5) "Форма по ОКУД" format "X(14)" at 166 "| " at 180 "       " "|" at 198 skip
     6474       space(5) string( "ИНН " + t-inn + " " + CAPS( clients.obj-name ) + " (" + string(clients.obj-code) + ")"
     6475                                 + t-addres + t-phone) format "X(160)"
     6476                      "по ОКПО" format "X(7)" at 172 "| " at 180 t-okpo format "X(16)" "|" at 198 skip
     6477       space(5) ( if t-doc.doc-type <> 'при':U then
     6478                          string( CAPS( buf_clients.obj-name ) + " (" + string(buf_clients.obj-code) + ")" )
     6479                        else
     6480                           " "
     6481                       ) format "X(160)" "| " at 180  "|" at 198 skip
     6482       space(5) "Вид деятельности по ОКДП" format "X(25)" at 155 "| " at 180 "|" at 198 skip
     6483       .
     6484       put stream out-stream
     6485           space(5) v-torgconf-torg12-cargo-string    format "X(160)"
     6486                   "по ОКПО"                          format "X(7)"       at 172
     6487                   "| "                                                   at 180
     6488                   t-okpo                             format "X(16)"
     6489                   "|"                                                    at 198
     6490           skip
     6491       .
     6492       define variable v-supplier    as character    no-undo.
     6493       run fmtcli-get-bank in this-procedure (
     6494             input v-host-code
     6495           , input clients.obj-type
     6496           , input clients.obj-code
     6497           , input v-curr-code
     6498       ).
     6499       assign
     6500           v-supplier = clients.obj-name
     6501       .
     6502       if v-fmtcli-schet-exists = yes
     6503       then do:
     6504           assign
     6505               v-supplier = v-supplier
     6506                   + substitute( ", р/с &1 к/с &2"
     6507                               , v-fmtcli-bank-r-schet
     6508                               , v-fmtcli-bank-c-schet
     6509                               )
     6510           .
     6511           if v-fmtcli-bank-exists = yes
     6512           then do:
     6513               assign
     6514                   v-supplier = v-supplier
     6515                       + substitute( " БИК &1 в &2, &3"
     6516                                   , v-fmtcli-bank-bik
     6517                                   , v-fmtcli-bank-name
     6518                                   , v-fmtcli-bank-addres
     6519                                   )
     6520               .
     6521           end.
     6522       end.
     6523       put stream out-stream
     6524           space(5)
     6525               substitute( "Поставщик: &1", v-supplier ) format "X(160)"
     6526               "по ОКПО" format "X(7)" at 172 "| " at 180 t-okpo format "X(16)" "|" at 198
     6527           skip
     6528       .
     6529   define variable v-attr-value  as character no-undo .
     6530   define variable v-attr-type   as character no-undo .
     6531   define variable v-osnov       as character initial "" no-undo .
     6532   if t-doc.doc-type = 'при':U then  do:
     6533   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input t-doc.doc-code ,
     6534                           input 'nids':U ,
     6535                          output v-attr-value ,
     6536                          output v-attr-type )  .
     6537     assign v-osnov = v-attr-value .
     6538   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input t-doc.doc-code ,
     6539                           input 'dids':U ,
     6540                          output v-attr-value ,
     6541                          output v-attr-type )  .
     6542     assign v-osnov = v-osnov + " от " + v-attr-value .
     6543   end.
     6544   find first clients no-lock
     6545        where clients.obj-type = t-doc.cli-type
     6546          and clients.obj-code = t-doc.cli-code
     6547   .
     6548   define variable v-saler    as character    no-undo.
     6549       run fmtcli-get-bank in this-procedure (
     6550             input v-host-code
     6551           , input clients.obj-type
     6552           , input clients.obj-code
     6553           , input v-curr-code
     6554       ).
     6555       assign
     6556           v-saler = clients.obj-name
     6557       .
     6558       if v-fmtcli-schet-exists = yes
     6559       then do:
     6560           assign
     6561               v-saler = v-saler
     6562                   + substitute( ", р/с &1 к/с &2"
     6563                               , v-fmtcli-bank-r-schet
     6564                               , v-fmtcli-bank-c-schet
     6565                               )
     6566           .
     6567           if v-fmtcli-bank-exists = yes
     6568           then do:
     6569               assign
     6570                   v-saler = v-saler
     6571                       + substitute( " БИК &1 в &2, &3"
     6572                                   , v-fmtcli-bank-bik
     6573                                   , v-fmtcli-bank-name
     6574                                   , v-fmtcli-bank-addres
     6575                                   )
     6576               .
     6577           end.
     6578       end.
     6579   put stream out-stream
     6580       space(5) substitute( "Плательщик: &1", v-saler ) format "X(160)"
     6581                       "по ОКПО" format "X(7)" at 172 "| " at 180 t-okpo format "X(16)" "|" at 198 skip
     6582       space(5) string( "Основание: " + v-osnov ) format "X(160)"
     6583                       "номер" format "X(5)" at 174 "| " at 180  "|" at 198 skip
     6584       space(5) string( "Примечание: " + (if not( t-doc.PS BEGINS "@" ) then t-doc.PS else "" ) ) format "X(160)"
     6585                       "дата" format "X(4)" at 175 "| " at 180 "|" at 198 skip
     6586       space(5) string( "Вид оплаты: " + ( if available pay-type then pay-type.obj-name else "?" ) ) format "X(130)"
     6587                       string( "Накладная на перемещение" ) format "X(24)" at 147
     6588                       "номер" format "X(5)" at 174 "| " at 180 tdoc-code format "X(16)" "|" at 198 skip
     6589       space(5) "дата" format "X(4)" at 175 "| " at 180 (if t-doc.status_ = 'факт':U then t-doc.fact-date else ? ) format "99/99/9999" "|" at 198 skip
     6590       space(5) "Вид операции" format "X(12)" at 167 "| " at 180 "расход" "|" at 198 skip
     6591       space(5) v-single-line format  "X(19)" at 180 skip
     6592       space(65) v-single-line format "X(33)" skip
     6593       space(45) string( "РАСХОДНАЯ НАКЛАДНАЯ | "
     6594                                   + string( tdoc-code, "X(16)") + " | "
     6595                                   + string( tdoc-date, "99/99/9999")
     6596                                   + " | " + (if t-doc.status_ <> 'факт':U then string( "(" + CAPS(t-doc.status_) + ")" ) else "")
     6597                                   ) format "X(100)" skip
     6598       space(65) v-single-line format "X(33)"
     6599       .
     6600   form with frame f-doc .
     6601   assign
     6602     v-itogo-qnty                 = 0
     6603     v-itogo-qnty-kg              = 0
     6604     v-itogo-sum-without-vat-slt  = 0
     6605     v-itogo-sum-vat              = 0
     6606     v-itogo-sum-without-slt      = 0
     6607   .
     6608   if sort-gr = yes
     6609   then do:
     6610       down stream out-stream 1 with frame f-doc .
     6611   end.
     6612   if sort-name = yes
     6613   then do:
     6614       if sort-gr = yes
     6615       then do:
     6616         run writelog in this-procedure (log-file-name, 1, "Сортировка по имени и группе").
     6617         for each doc-line no-lock
     6618             where doc-line.doc-code = t-doc.doc-code,
     6619               each goods no-lock
     6620             where goods.artic     = doc-line.artic
     6621               and goods.prod-type = doc-line.prod-type
     6622               and goods.prod-code = doc-line.prod-code
     6623           break by goods.grp-name
     6624                 by goods.gds-name
     6625           :
     6626               if first-of (goods.grp-name)
     6627               then do:
     6628                   run print-group-line in this-procedure.
     6629               end.
     6630               assign v-doc-line-counter = v-doc-line-counter + 1.
     6631               run print-line in this-procedure.
     6632               assign
     6633                 v-itogo-qnty                = v-itogo-qnty                + doc-line.fact-qnty
     6634                 v-itogo-qnty-kg             = v-itogo-qnty-kg             + v-qnty-kg
     6635                 v-itogo-sum-without-vat-slt = v-itogo-sum-without-vat-slt + v-sum-without-vat-slt
     6636                 v-itogo-sum-vat             = v-itogo-sum-vat             + v-sum-vat
     6637                 v-itogo-sum-without-slt     = v-itogo-sum-without-slt     + v-sum-without-slt
     6638               .
     6639           end.
     6640       end.
     6641       else do:
     6642           run writelog in this-procedure (log-file-name, 1, "Сортировка по имени (по группе нет)").
     6643           for each doc-line no-lock
     6644             where doc-line.doc-code = t-doc.doc-code,
     6645               each goods no-lock
     6646             where goods.artic     = doc-line.artic
     6647               and goods.prod-type = doc-line.prod-type
     6648               and goods.prod-code = doc-line.prod-code
     6649           break by goods.gds-name
     6650           :
     6651               assign v-doc-line-counter = v-doc-line-counter + 1.
     6652               run print-line in this-procedure.
     6653               assign
     6654                 v-itogo-qnty                = v-itogo-qnty                + doc-line.fact-qnty
     6655                 v-itogo-qnty-kg             = v-itogo-qnty-kg             + v-qnty-kg
     6656                 v-itogo-sum-without-vat-slt = v-itogo-sum-without-vat-slt + v-sum-without-vat-slt
     6657                 v-itogo-sum-vat             = v-itogo-sum-vat             + v-sum-vat
     6658                 v-itogo-sum-without-slt     = v-itogo-sum-without-slt     + v-sum-without-slt
     6659               .
     6660           end.
     6661       end.
     6662   end.
     6663   else do:
     6664       if sort-gr = yes
     6665       then do:
     6666           run writelog in this-procedure (log-file-name, 1, "Сортировка по группе (по имени нет)").
     6667           for each doc-line no-lock
     6668             where doc-line.doc-code = t-doc.doc-code,
     6669               each goods no-lock
     6670             where goods.artic     = doc-line.artic
     6671               and goods.prod-type = doc-line.prod-type
     6672               and goods.prod-code = doc-line.prod-code
     6673             break by goods.grp-name
     6674                   by doc-line.artic
     6675           :
     6676               if first-of (goods.grp-name)
     6677               then do:
     6678                   run print-group-line in this-procedure.
     6679               end.
     6680               assign v-doc-line-counter = v-doc-line-counter + 1.
     6681               run print-line in this-procedure.
     6682               assign
     6683                 v-itogo-qnty                = v-itogo-qnty                + doc-line.fact-qnty
     6684                 v-itogo-qnty-kg             = v-itogo-qnty-kg             + v-qnty-kg
     6685                 v-itogo-sum-without-vat-slt = v-itogo-sum-without-vat-slt + v-sum-without-vat-slt
     6686                 v-itogo-sum-vat             = v-itogo-sum-vat             + v-sum-vat
     6687                 v-itogo-sum-without-slt     = v-itogo-sum-without-slt     + v-sum-without-slt
     6688               .
     6689           end.
     6690       end.
     6691       else do:
     6692           run writelog in this-procedure (log-file-name, 1, "Сортировок по группе и по имени нет").
     6693           for each doc-line no-lock
     6694             where doc-line.doc-code = t-doc.doc-code,
     6695               each goods no-lock
     6696             where goods.artic     = doc-line.artic
     6697               and goods.prod-type = doc-line.prod-type
     6698               and goods.prod-code = doc-line.prod-code
     6699             break by doc-line.line-num
     6700           :
     6701               assign v-doc-line-counter = v-doc-line-counter + 1.
     6702               run print-line in this-procedure.
     6703               assign
     6704                 v-itogo-qnty                = v-itogo-qnty                + doc-line.fact-qnty
     6705                 v-itogo-qnty-kg             = v-itogo-qnty-kg             + v-qnty-kg
     6706                 v-itogo-sum-without-vat-slt = v-itogo-sum-without-vat-slt + v-sum-without-vat-slt
     6707                 v-itogo-sum-vat             = v-itogo-sum-vat             + v-sum-vat
     6708                 v-itogo-sum-without-slt     = v-itogo-sum-without-slt     + v-sum-without-slt
     6709               .
     6710           end.
     6711       end.
     6712   end.
     6713   if line-counter( out-stream ) + 2 > page-size( out-stream ) then
     6714   do:
     6715   define variable vss-include-info37 as character format "X(65)" no-undo
     6716   initial "@(#)$Workfile$ $Revision$".
     6717   if page-number( out-stream ) > prevpage then
     6718       assign
     6719         v-page-qnty                 = 0
     6720         v-page-qnty-kg              = 0
     6721         v-page-sum-without-vat-slt  = 0
     6722         v-page-sum-vat              = 0
     6723         v-page-sum-without-slt      = 0
     6724           .
     6725   do:
     6726       put stream out-stream v-single-line format "x(189)" skip.
     6727       display stream out-stream
     6728           "Итого" @ goods.gds-name
     6729           v-page-qnty                 @ doc-line.fact-qnty
     6730           v-page-qnty-kg              @ v-qnty-kg
     6731           v-page-sum-without-vat-slt  @ v-sum-without-vat-slt
     6732           v-page-sum-vat              @ v-sum-vat
     6733           v-page-sum-without-slt      @ v-sum-without-slt
     6734           with frame f-doc .
     6735       down stream out-stream 1 with frame f-doc .
     6736       prevpage = prevpage + 1.
     6737   end.
     6738     page stream out-stream .
     6739   end.
     6740   define variable vss-include-info38 as character format "X(65)" no-undo
     6741   initial "@(#)$Workfile$ $Revision$".
     6742   if page-number( out-stream ) > prevpage then
     6743       assign
     6744         v-page-qnty                 = 0
     6745         v-page-qnty-kg              = 0
     6746         v-page-sum-without-vat-slt  = 0
     6747         v-page-sum-vat              = 0
     6748         v-page-sum-without-slt      = 0
     6749           .
     6750   do:
     6751       put stream out-stream v-single-line format "x(189)" skip.
     6752       display stream out-stream
     6753           "Итого" @ goods.gds-name
     6754           v-page-qnty                 @ doc-line.fact-qnty
     6755           v-page-qnty-kg              @ v-qnty-kg
     6756           v-page-sum-without-vat-slt  @ v-sum-without-vat-slt
     6757           v-page-sum-vat              @ v-sum-vat
     6758           v-page-sum-without-slt      @ v-sum-without-slt
     6759           with frame f-doc .
     6760       down stream out-stream 1 with frame f-doc .
     6761       prevpage = prevpage + 1.
     6762   end.
     6763   hide stream out-stream frame BottomFrame .
     6764   display stream out-stream
     6765       "Всего по накладной" @ goods.gds-name
     6766       with frame f-doc .
     6767   down stream out-stream 2 with frame f-doc .
     6768   if PrintRubl then
     6769       run rep/wp-rub.p ( v-itogo-sum, output s1, output s2 ) .
     6770   else
     6771       run rep/wp.p ( input p-mainmenu-handle, v-itogo-sum , output s1, output s2 ) .
     6772   run rep/wp-qnty.p ( input ( v-doc-line-counter - 1 ), output txt-LC).
     6773   put stream out-stream
     6774       space(10) "  Всего на сумму:        "
     6775            trim( string( v-itogo-sum ), "->>>,>>>,>>>,>>>,>>9.99" ) format "X(25)"
     6776            " ("
     6777            ( if PrintRubl then "РУБ" else "баз.вал" ) format "X(6)"
     6778            ")"
     6779   .
     6780   if v-no-print-discnt = "no"
     6781   then do:
     6782       put stream out-stream
     6783                           string( if (if PrintRubl then t-doc.discnt-rubl else t-doc.tot-calc ) < 0
     6784                           then ", наценка: "
     6785                           else ", скидка: "
     6786                           )
     6787                           + (trim( string( ABS( ( if PrintRubl
     6788                                                       then t-doc.discnt-rubl
     6789                                                       else t-doc.tot-calc
     6790                                                       )
     6791                                                   ), ">>>,>>>,>>>,>>>,>>9.99"
     6792                                               )
     6793                                       )
     6794                             )
     6795                           + " (" + trim( ( if PrintRubl then "РУБ" else "баз.вал" ) ) + ")"
     6796                                                                                               format "X(100)"
     6797       .
     6798   end.
     6799   put stream out-stream
     6800       skip
     6801       space(15) string( "В том числе: " ) format "X(160)"
     6802       skip
     6803   .
     6804   put stream out-stream
     6805       skip
     6806       space(30) string( "НДС: " + trim( string( (v-itogo-sum-vat), "->>>,>>>,>>>,>>>,>>9.99") ) +
     6807                                   " (" + trim( ( if PrintRubl then "РУБ" else "баз.вал" ) ) + ")" ) format "X(160)" skip
     6808   .
     6809   run print-footer in this-procedure ( input v-host-code, input v-underline ).
     6810   if session :set-wait-state( "" ) then.
     6811   output stream out-stream close.
     6812   if g#quest-print = false
     6813   then do:
     6814     run adecomm/_osprint.p ( ?, string( session:temp-directory + "rpt" + string( g#report-num ) ),
     6815                                         7, (if 8 >= 8 then 2 else 0), 0, 0,
     6816                                         OUTPUT g#log ).
     6817   end.
     6818   else do:
     6819     os-command silent
     6820       value( "COPY /b " +
     6821         string( session:temp-directory) +  "$" + string( g#report-num ) + " + " +
     6822         string( session:temp-directory) + "rpt" + string( g#report-num ) + " " +
     6823         string( session:temp-directory) +  "$" + string( g#report-num )
     6824                 ) .
     6825     os-command silent
     6826       value( "COPY /b " +
     6827         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl" + " + " +
     6828         string( session:temp-directory) + "rpt" + string( g#report-num ) + ".txl" + " " +
     6829         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl"
     6830                 ) .
     6831   end.
     6832   procedure print-line :
     6833   def var v-rootnode-code     as integer                          no-undo.
     6834   do
     6835   on error undo, return error return-value
     6836   :
     6837   run writelog in this-procedure (log-file-name, 1, "Печать строки товара").
     6838   if FullGdsName
     6839   then do:
     6840       gds-str1 = breakstr(goods.gds-name, 29, input-output gds-str1, input-output gds-str2).
     6841       assign v-char-counter = 0.
     6842       do while gds-str2 <> "" :
     6843           assign
     6844               gds-str = gds-str2
     6845               gds-str1 = breakstr(gds-str, 29, input-output gds-str1, input-output gds-str2)
     6846               v-char-counter = v-char-counter + 1
     6847           .
     6848       end.
     6849       if line-counter( out-stream ) + v-char-counter > page-size( out-stream )
     6850       then do:
     6851   define variable vss-include-info39 as character format "X(65)" no-undo
     6852   initial "@(#)$Workfile$ $Revision$".
     6853   if page-number( out-stream ) > prevpage then
     6854       assign
     6855         v-page-qnty                 = 0
     6856         v-page-qnty-kg              = 0
     6857         v-page-sum-without-vat-slt  = 0
     6858         v-page-sum-vat              = 0
     6859         v-page-sum-without-slt      = 0
     6860           .
     6861   do:
     6862       put stream out-stream v-single-line format "x(189)" skip.
     6863       display stream out-stream
     6864           "Итого" @ goods.gds-name
     6865           v-page-qnty                 @ doc-line.fact-qnty
     6866           v-page-qnty-kg              @ v-qnty-kg
     6867           v-page-sum-without-vat-slt  @ v-sum-without-vat-slt
     6868           v-page-sum-vat              @ v-sum-vat
     6869           v-page-sum-without-slt      @ v-sum-without-slt
     6870           with frame f-doc .
     6871       down stream out-stream 1 with frame f-doc .
     6872       prevpage = prevpage + 1.
     6873   end.
     6874           PAGE stream out-stream.
     6875       end.
     6876       assign
     6877           gds-str1 = breakstr(goods.gds-name, 29, input-output gds-str1, input-output gds-str2)
     6878       .
     6879   end.
     6880   else do:
     6881       assign
     6882           gds-str1 = goods.gds-name
     6883       .
     6884   end.
     6885   find first gds-prt no-lock
     6886            where gds-prt.upper-code = goods.prt-root
     6887       .
     6888   assign
     6889     v-rootnode-code = gds-prt.node-code .
     6890   find first bar-code no-lock
     6891        where bar-code.gds-code = goods.gds-code
     6892          and bar-code.unit-cli = goods.unit-base
     6893          and bar-code.node-code = v-rootnode-code
     6894          and bar-code.part-code = ""
     6895          and bar-code.in-code = ""
     6896   .
     6897   for each tt-allsum-line :
     6898     delete tt-allsum-line.
     6899   end.
     6900   for each tt-allsum :
     6901     delete tt-allsum.
     6902   end.
     6903   run clcprtsl_calc-line (recid(doc-line)).
     6904   find first tt-allsum-line where tt-allsum-line.sum-type = 'основная_сумма':U no-error.
     6905   if available tt-allsum-line then do:
     6906     if PrintRubl then do:
     6907       display stream out-stream
     6908       v-doc-line-counter
     6909       goods.artic
     6910       gds-str1 @ goods.gds-name
     6911       string( bar-code.b-code ) @ v-b-code
     6912       tt-allsum-line.sum-dsc-rubl-doc / tt-allsum-line.fact-qnty / doc-line.fact-density               @ v-price-kg
     6913       tt-allsum-line.sum-dsc-rubl-doc / tt-allsum-line.fact-qnty                                       @ v-price
     6914       tt-allsum-line.fact-qnty                                                                         @ doc-line.fact-qnty
     6915       doc-line.fact-density
     6916       doc-line.temperature
     6917       tt-allsum-line.fact-qnty * doc-line.fact-density                                                 @ v-qnty-kg
     6918       doc-line.VAT-pc
     6919       tt-allsum-line.sum-dsc-rubl-doc - tt-allsum-line.vat-rubl-doc - tt-allsum-line.slt-rubl-doc @ v-sum-without-vat-slt
     6920       tt-allsum-line.vat-rubl-doc                                                                 @ v-sum-vat
     6921       tt-allsum-line.sum-dsc-rubl-doc - tt-allsum-line.slt-rubl-doc                               @ v-sum-without-slt
     6922       sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12 sym13 sym14 sym15
     6923       with frame f-doc
     6924       .
     6925       assign
     6926         v-itogo-qnty                = v-itogo-qnty                 + tt-allsum-line.fact-qnty
     6927         v-itogo-qnty-kg             = v-itogo-qnty-kg              + tt-allsum-line.fact-qnty * doc-line.fact-density
     6928         v-itogo-sum-without-vat-slt = v-itogo-sum-without-vat-slt  + tt-allsum-line.sum-dsc-rubl-doc - tt-allsum-line.vat-rubl-doc - tt-allsum-line.slt-rubl-doc
     6929         v-itogo-sum-vat             = v-itogo-sum-vat              + tt-allsum-line.vat-rubl-doc
     6930         v-itogo-sum-without-slt     = v-itogo-sum-without-slt      + tt-allsum-line.sum-dsc-rubl-doc - tt-allsum-line.slt-rubl-doc
     6931         v-itogo-sum                 = v-itogo-sum                  + tt-allsum-line.sum-dsc-rubl-doc
     6932         v-page-qnty                 = v-page-qnty                  + tt-allsum-line.fact-qnty
     6933         v-page-qnty-kg              = v-page-qnty-kg               + tt-allsum-line.fact-qnty * doc-line.fact-density
     6934         v-page-sum-without-vat-slt  = v-page-sum-without-vat-slt   + tt-allsum-line.sum-dsc-rubl-doc - tt-allsum-line.vat-rubl-doc - tt-allsum-line.slt-rubl-doc
     6935         v-page-sum-vat              = v-page-sum-vat               + tt-allsum-line.vat-rubl-doc
     6936         v-page-sum-without-slt      = v-page-sum-without-slt       + tt-allsum-line.sum-dsc-rubl-doc - tt-allsum-line.slt-rubl-doc
     6937       .
     6938     end.
     6939     else do:
     6940       display stream out-stream
     6941       v-doc-line-counter
     6942       goods.artic
     6943       gds-str1 @ goods.gds-name
     6944       string( bar-code.b-code ) @ v-b-code
     6945       tt-allsum-line.sum-dsc-base-doc / tt-allsum-line.fact-qnty / doc-line.fact-density               @ v-price-kg
     6946       tt-allsum-line.sum-dsc-base-doc / tt-allsum-line.fact-qnty                                       @ v-price
     6947       tt-allsum-line.fact-qnty                                                                         @ doc-line.fact-qnty
     6948       doc-line.fact-density
     6949       doc-line.temperature
     6950       tt-allsum-line.fact-qnty * doc-line.fact-density                                                 @ v-qnty-kg
     6951       doc-line.VAT-pc
     6952       tt-allsum-line.sum-dsc-base-doc - tt-allsum-line.vat-base-doc - tt-allsum-line.slt-base-doc @ v-sum-without-vat-slt
     6953       tt-allsum-line.vat-base-doc                                                                 @ v-sum-vat
     6954       tt-allsum-line.sum-dsc-base-doc - tt-allsum-line.slt-base-doc                               @ v-sum-without-slt
     6955       sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12 sym13 sym14 sym15
     6956       with frame f-doc
     6957       .
     6958       assign
     6959         v-itogo-qnty                = v-itogo-qnty                 + tt-allsum-line.fact-qnty
     6960         v-itogo-qnty-kg             = v-itogo-qnty-kg              + tt-allsum-line.fact-qnty * doc-line.fact-density
     6961         v-itogo-sum-without-vat-slt = v-itogo-sum-without-vat-slt  + tt-allsum-line.sum-dsc-base-doc - tt-allsum-line.vat-base-doc - tt-allsum-line.slt-base-doc
     6962         v-itogo-sum-vat             = v-itogo-sum-vat              + tt-allsum-line.vat-base-doc
     6963         v-itogo-sum-without-slt     = v-itogo-sum-without-slt      + tt-allsum-line.sum-dsc-base-doc - tt-allsum-line.slt-base-doc
     6964         v-itogo-sum                 = v-itogo-sum                  + tt-allsum-line.sum-dsc-base-doc
     6965         v-page-qnty                 = v-page-qnty                  + tt-allsum-line.fact-qnty
     6966         v-page-qnty-kg              = v-page-qnty-kg               + tt-allsum-line.fact-qnty * doc-line.fact-density
     6967         v-page-sum-without-vat-slt  = v-page-sum-without-vat-slt   + tt-allsum-line.sum-dsc-base-doc - tt-allsum-line.vat-base-doc - tt-allsum-line.slt-base-doc
     6968         v-page-sum-vat              = v-page-sum-vat               + tt-allsum-line.vat-base-doc
     6969         v-page-sum-without-slt      = v-page-sum-without-slt       + tt-allsum-line.sum-dsc-base-doc - tt-allsum-line.slt-base-doc
     6970       .
     6971     end.
     6972     down stream out-stream 1 with frame f-doc .
     6973   end.
     6974   end.
     6975   end procedure.
     6976   procedure print-footer :
     6977   do
     6978   on error undo, return error
     6979   :
     6980   define input parameter p-host-code   as integer    no-undo.
     6981   define input parameter p-underline   as character    no-undo.
     6982       define buffer buf_clients   for clients.
     6983       define buffer buf_firm      for firm.
     6984       define buffer buf_sysconf       for sysconf.
     6985       define variable v-main-boss  as character     no-undo.
     6986       define variable v-main-buh   as character     no-undo.
     6987       find first buf_clients no-lock
     6988            where buf_clients.obj-type = 'орг':U
     6989              and buf_clients.obj-code = p-host-code
     6990       .
     6991       find first buf_firm no-lock
     6992            where buf_firm.firm-code = buf_clients.obj-code
     6993       .
     6994       assign
     6995           v-main-boss = buf_firm.director
     6996           v-main-buh  = buf_firm.gen-acct
     6997       .
     6998       find first buf_sysconf no-lock
     6999               where buf_sysconf.host-code = p-host-code
     7000       .
     7001       assign
     7002           v-main-buh  = buf_sysconf.snr-accnt
     7003       .
     7004       put stream out-stream
     7005           "|" at 97 string( "Груз принял " + p-underline ) format "X(100)" at 99 skip
     7006           "|" at 97 string( "М.П. " ) format "X(100)" at 99 skip
     7007           string( "Отпуск разрешил_________________________________________________________________________________|" ) format "X(97)" skip
     7008           "(менеджер по обеспечению нефтепродуктами)" at 40  "|" at 97 string( "Груз получил " + p-underline ) format "X(100)" at 99 skip
     7009           string( "________________________________________________________________________________________________|" ) format "X(97)" skip
     7010           "М.П." at 15  "|" at 97 "М.П." at 99 skip
     7011      .
     7012   end.
     7013   end procedure.
     7014   procedure print-group-line :
     7015   do
     7016   on error undo, return error
     7017   :
     7018     run writelog in this-procedure (log-file-name, 2, "Печать имени группы ( " + dtm-char(goods.grp-name) + " )" ).
     7019     put stream out-stream
     7020         skip
     7021         ":" space(5)
     7022         "Группа:" space(2)
     7023         goods.grp-name
     7024     .
     7025   end.
     7026   end procedure.
