     2396        input parcur-road-tax,
     2397        input parcur-excise,
     2398        input parcur-vat-pc,
     2399        input parcurcons-vat-pc,
     2400        input parcurslt-pc
     2401        ) no-error.
     2402     if error-status:error then do:
     2403       message
