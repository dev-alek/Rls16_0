     6225     ,output v-value-decimal
     6226     ,output v-value-integer
     6227     ,output v-value-logical
     6228     ,output par-type
     6229     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     6230     ) no-error .
     6231   for each thbjattr_thbj-attr :
     6232       if thbjattr_thbj-attr.prop-code = 'FGdsNinD' then tmp-var =  string(thbjattr_thbj-attr.property-value-logical) .
     6233   end.
     6234   FullGdsName = (tmp-var = "yes") .
     6235   run gbl/conf-rd.p ( "factur02", "", "", 0, "", "", "", no, output v-no-print-discnt, output type-par ) no-error.
     6236   if error-status :error
