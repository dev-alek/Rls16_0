     4031               v-torgconf-sup-host-egrip-date     = "":U
     4032               v-torgconf-sup-host-egrip-num      = "":U
     4033           .
     4034       end.
     4035       else do:
     4036           run fmtcli-get-client in this-procedure (
     4037                 input 'орг':U
     4038               , input v-torgconf-sup-host-code
     4039           ).
     4040           assign
     4041               v-torgconf-sup-host-name        = v-fmtcli-name
     4042               v-torgconf-sup-host-engl-name   = v-fmtcli-engl-name
     4043               v-torgconf-sup-host-addres      = v-fmtcli-full-addres
     4044               v-torgconf-sup-host-post-addres = v-fmtcli-post-addres
     4045               v-torgconf-sup-host-phone       = v-fmtcli-phone
     4046               v-torgconf-sup-host-inn         = v-fmtcli-inn
     4047               v-torgconf-sup-host-kpp         = v-fmtcli-kpp
     4048               v-torgconf-sup-host-okpo        = v-fmtcli-okpo
     4049           .
     4050           run gbl/clntat-v.p (
     4051                 input 'орг':U
     4052               , input v-torgconf-sup-host-code
     4053               , input 'egrip-date':U
     4054               , output v-torgconf-sup-host-egrip-date
     4055               , output v-par-type
     4056           ).
     4057           run gbl/clntat-v.p (
     4058                 input 'орг':U
     4059               , input v-torgconf-sup-host-code
     4060               , input 'egrip-num':U
     4061               , output v-torgconf-sup-host-egrip-num
     4062               , output v-par-type
     4063           ).
     4064           run fmtcli-get-bank in this-procedure (
     4065                 input v-host-code
     4066               , input 'орг':U
     4067               , input v-torgconf-sup-host-code
     4068               , input p-curr-code
     4069           ).
     4070       end.
     4071       assign
     4072           v-torgconf-sup-schet-exists = v-fmtcli-schet-exists
     4073           v-torgconf-sup-bank-exists  = v-fmtcli-bank-exists
     4074           v-torgconf-sup-bank-r-schet = v-fmtcli-bank-r-schet
     4075           v-torgconf-sup-bank-c-schet = v-fmtcli-bank-c-schet
     4076           v-torgconf-sup-bank-bik     = v-fmtcli-bank-bik
     4077           v-torgconf-sup-bank-name    = v-fmtcli-bank-name
     4078           v-torgconf-sup-bank-addres  = v-fmtcli-bank-addres
     4079           v-torgconf-sup-bank-city    = v-fmtcli-bank-city
     4080       .
     4081       assign
     4082           v-torgconf-sup-obj-type = p-obj-type
     4083           v-torgconf-sup-obj-code = p-obj-code
     4084       .
     4085       if trim(p-obj-type) <> ""
     4086       and p-obj-code <> 0
     4087       then do:
     4088       run fmtcli-get-client in this-procedure (
     4089             input p-obj-type
     4090           , input p-obj-code
     4091       ).
     4092       assign
     4093           v-torgconf-sup-obj-name        = v-fmtcli-name
     4094           v-torgconf-sup-obj-engl-name   = v-fmtcli-engl-name
     4095           v-torgconf-sup-obj-addres      = v-fmtcli-full-addres
     4096           v-torgconf-temp-post-addres    = v-fmtcli-post-addres
     4097           v-torgconf-sup-obj-phone       = v-fmtcli-phone
     4098           v-torgconf-sup-obj-inn         = v-fmtcli-inn
     4099           v-torgconf-sup-obj-okpo        = v-fmtcli-okpo
     4100       .
     4101      end.
     4102      end.
     4103   end procedure.
     4104   procedure torgconf-get-cli-param :
     4105   define input parameter p-host-obj-code      as integer          no-undo.
     4106   define input parameter p-obj-type           as character        no-undo.
     4107   define input parameter p-obj-code           as integer          no-undo.
     4108   define input parameter p-curr-code          as integer          no-undo.
     4109       define variable v-host-code    as integer      no-undo.
     4110   do
     4111   on error undo, return error
     4112   :
     4113       assign
     4114           v-torgconf-cli-type = p-obj-type
     4115           v-torgconf-cli-code = p-obj-code
     4116       .
     4117       run fmtcli-get-client in this-procedure (
     4118             input p-obj-type
     4119           , input p-obj-code
     4120       ).
     4121       assign
     4122           v-torgconf-cli-name         = trim( v-fmtcli-name          )
     4123           v-torgconf-cli-engl-name    = trim( v-fmtcli-engl-name          )
     4124           v-torgconf-cli-addres       = trim( v-fmtcli-full-addres   )
     4125           v-torgconf-cli-post-addres  = trim( v-fmtcli-post-addres   )
     4126           v-torgconf-cli-phone        = trim( v-fmtcli-phone         )
     4127           v-torgconf-cli-inn          = trim( v-fmtcli-inn           )
     4128           v-torgconf-cli-kpp          = trim( v-fmtcli-kpp           )
     4129           v-torgconf-cli-okpo         = trim( v-fmtcli-okpo          )
     4130       .
     4131      run fmtcli-get-bank in this-procedure (
     4132             input p-host-obj-code
     4133           , input p-obj-type
     4134           , input p-obj-code
     4135           , input p-curr-code
     4136       ).
     4137       assign
     4138           v-torgconf-cli-schet-exists = v-fmtcli-schet-exists
     4139           v-torgconf-cli-bank-exists  = v-fmtcli-bank-exists
     4140           v-torgconf-cli-bank-r-schet = v-fmtcli-bank-r-schet
     4141           v-torgconf-cli-bank-c-schet = v-fmtcli-bank-c-schet
     4142           v-torgconf-cli-bank-bik     = v-fmtcli-bank-bik
     4143           v-torgconf-cli-bank-name    = v-fmtcli-bank-name
     4144           v-torgconf-cli-bank-addres  = v-fmtcli-bank-addres
     4145           v-torgconf-cli-bank-city    = v-fmtcli-bank-city
     4146       .
     4147   end.
     4148   end procedure.
     4149   procedure torgconf-get-ship-param :
     4150   define input parameter p-host-obj-code      as integer          no-undo.
     4151   define input parameter p-obj-type           as character        no-undo.
     4152   define input parameter p-obj-code           as integer          no-undo.
     4153   define input parameter p-curr-code          as integer          no-undo.
     4154       define variable v-host-code    as integer      no-undo.
     4155   do
     4156   on error undo, return error
     4157   :
     4158       assign
     4159           v-torgconf-ship-type = p-obj-type
     4160           v-torgconf-ship-code = p-obj-code
     4161       .
     4162       if trim(p-obj-type) = ""
     4163       and p-obj-code = 0
     4164       then do:
     4165       assign
     4166           v-torgconf-ship-name         = "":U
     4167           v-torgconf-ship-addres       = "":U
     4168           v-torgconf-ship-post-addres  = "":U
     4169           v-torgconf-ship-phone        = "":U
     4170           v-torgconf-ship-inn          = "":U
     4171           v-torgconf-ship-kpp          = "":U
     4172           v-torgconf-ship-okpo         = "":U
     4173       .
     4174       end.
     4175       else do:
     4176       run fmtcli-get-client in this-procedure (
     4177             input p-obj-type
     4178           , input p-obj-code
     4179       ).
     4180       assign
     4181           v-torgconf-ship-name         = trim( v-fmtcli-name          )
     4182           v-torgconf-ship-engl-name    = trim( v-fmtcli-engl-name          )
     4183           v-torgconf-ship-addres       = trim( v-fmtcli-full-addres   )
     4184           v-torgconf-ship-post-addres  = trim( v-fmtcli-post-addres   )
     4185           v-torgconf-ship-phone        = trim( v-fmtcli-phone         )
     4186           v-torgconf-ship-inn          = trim( v-fmtcli-inn           )
     4187           v-torgconf-ship-kpp          = trim( v-fmtcli-kpp           )
     4188           v-torgconf-ship-okpo         = trim( v-fmtcli-okpo          )
     4189       .
     4190       end.
     4191           run fmtcli-get-bank in this-procedure (
     4192             input p-host-obj-code
     4193           , input p-obj-type
     4194           , input p-obj-code
     4195           , input p-curr-code
     4196       ).
     4197       assign
     4198           v-torgconf-ship-schet-exists = v-fmtcli-schet-exists
     4199           v-torgconf-ship-bank-exists  = v-fmtcli-bank-exists
     4200           v-torgconf-ship-bank-r-schet = v-fmtcli-bank-r-schet
     4201           v-torgconf-ship-bank-c-schet = v-fmtcli-bank-c-schet
     4202           v-torgconf-ship-bank-bik     = v-fmtcli-bank-bik
     4203           v-torgconf-ship-bank-name    = v-fmtcli-bank-name
     4204           v-torgconf-ship-bank-addres  = v-fmtcli-bank-addres
     4205           v-torgconf-ship-bank-city    = v-fmtcli-bank-city
     4206       .
     4207   end.
     4208   end procedure.
     4209   procedure torgconf-get-holdfirm-code :
     4210   define input parameter p-obj-type   as character        no-undo.
     4211   define input parameter p-obj-code   as integer          no-undo.
     4212   define output parameter p-firm-code as integer          no-undo.
     4213       define variable v-firm-code-str     as character    no-undo.
     4214       define variable v-par-type          as character    no-undo.
     4215       define buffer buf_clients       for ub.clients.
     4216   do
     4217   for buf_clients
     4218   on error undo, return error
     4219   :
     4220       run gbl/clntat-v.p (
     4221             input p-obj-type
     4222           , input p-obj-code
     4223           , input 'holdfirm-code':U
     4224           , output v-firm-code-str
     4225           , output v-par-type
     4226       ).
     4227       assign
     4228           p-firm-code = integer( v-firm-code-str )
     4229       no-error.
     4230       if error-status :error
     4231       then do:
     4232           message
     4233               "Неверно задан код фирмы для печати накладных."
     4234           view-as alert-box warning.
     4235           assign
     4236               p-firm-code = 0
     4237           .
     4238       end.
     4239       else do:
     4240           find first buf_clients no-lock
     4241                where buf_clients.obj-type = 'орг':U
     4242                  and buf_clients.obj-code = p-firm-code
     4243           no-error.
     4244           if not available buf_clients
     4245           then do:
     4246               message
     4247                   "Включен параметр 'Список печатных форм, для которых должна быть задана фирма для печати накладных' (outhold)" skip
     4248                   "Не найдена фирма по заданному коду фирмы для печати накладных."
     4249               view-as alert-box warning.
     4250               assign
     4251                   p-firm-code = 0
     4252               .
     4253           end.
     4254       end.
     4255   end.
     4256   end procedure.
     4257   procedure torgconf-get-post-head:
     4258   define input  parameter p-obj-type             as character        no-undo.
     4259   define input  parameter p-obj-code             as integer          no-undo.
     4260   define output parameter p-torgconf-post-head   as character        no-undo.
     4261      define variable v-host-code         as integer      no-undo.
     4262      define buffer buf_sysconf     for ub.sysconf.
     4263        assign
     4264         p-torgconf-post-head  = ""
     4265        .
     4266   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4267   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     4268     (input  p-obj-type
     4269     ,input  p-obj-code
     4270     ,output v-host-code
     4271     )  .
     4272      find first buf_sysconf no-lock
     4273      where buf_sysconf.host-code = v-host-code
     4274      no-error.
     4275      if available buf_sysconf
     4276      then do:
     4277         assign
     4278            p-torgconf-post-head = buf_sysconf.head-position
     4279         .
     4280      end.
     4281   end procedure.
     4282   procedure torgconf-get-storekeeper:
     4283   define input  parameter p-wrkr                   as integer          no-undo.
     4284   define output parameter p-torgconf-wrkr-name     as character        no-undo.
     4285   define output parameter p-torgconf-post          as character        no-undo.
     4286      define buffer buf_sysconf     for ub.sysconf.
     4287      define buffer buf_person      for ub.person.
     4288      define buffer buf_shop        for ub.shop .
     4289      define buffer buf_store       for ub.store .
     4290      if v-torgconf-outC = "no_print"
     4291      then do:
     4292         assign p-torgconf-post = ""
     4293                p-torgconf-wrkr-name = ""
     4294                .
     4295      end.
     4296      if v-torgconf-outC = "clad_doc"
     4297      then do:
     4298         run rep/get-psn.p
     4299               (input  p-wrkr
     4300               ,output p-torgconf-wrkr-name
     4301               ) .
     4302         find first buf_person no-lock
     4303         where buf_person.psn-code = p-wrkr
     4304         no-error.
     4305         if available buf_person
     4306         then do:
     4307           p-torgconf-post = buf_person.position.
     4308         end.
     4309         if p-torgconf-post = "?":U then p-torgconf-post = "".
     4310         if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     4311      end.
     4312      if v-torgconf-outC = "clad_obj"
     4313      then do:
     4314         CASE v-torgconf-self-obj-type:
     4315         WHEN 'маг':U
     4316         THEN DO:
     4317            find first buf_shop no-lock
     4318            where buf_shop.obj-code = v-torgconf-self-obj-code
     4319            .
     4320            assign
     4321               p-torgconf-wrkr-name = buf_shop.store-man
     4322               p-torgconf-post = ""
     4323            .
     4324            if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     4325         END.
     4326         WHEN 'скл':U
     4327         THEN DO:
     4328            find first buf_store no-lock
     4329            where buf_store.obj-code = v-torgconf-self-obj-code
     4330            .
     4331            assign
     4332               p-torgconf-wrkr-name = buf_store.store-man
     4333               p-torgconf-post = ""
     4334            .
     4335            if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     4336         END.
     4337         OTHERWISE DO:
     4338            assign
     4339               p-torgconf-post = "":U
     4340               p-torgconf-wrkr-name = "":U
     4341            .
     4342         END.
     4343         END CASE.
     4344      end.
     4345    end procedure.
     4346   procedure torgconf-get-form-header :
     4347   define input parameter p-for-inverse    as logical          no-undo.
     4348   define input parameter p-doc-code       as character        no-undo.
     4349   define input parameter p-print-doc      as logical          no-undo.
     4350   define input parameter p-doc-date       as date             no-undo.
     4351   define input parameter p-fact-date      as date             no-undo.
     4352   define input parameter p-doc-type       as character        no-undo.
     4353   define input parameter p-status_        as character        no-undo.
     4354   define input parameter p-reverse        as logical          no-undo.
     4355   define input parameter p-sf-par         as logical          no-undo.
     4356       define variable v-attr-type         as character    no-undo.
     4357       define variable v-doc-code-standard as logical      no-undo.
     4358       define variable v-doc-date-standard as logical      no-undo.
     4359       define variable v-par-consignee-addres  as character    no-undo.
     4360       define variable v-host-code         as integer      no-undo.
     4361       define variable v-dcode-attr        as character    no-undo.
     4362       define variable v-ddate-attr        as character    no-undo.
     4363       define variable v-doc-date          as character    no-undo.
     4364       define variable v-doc-code          as character    no-undo.
     4365       define variable v-par-type          as character    no-undo.
     4366       define variable v-attr              as character    no-undo.
     4367       define buffer buf_firm          for ub.firm .
     4368       define buffer buf_clients       for ub.clients .
     4369       define buffer buf_sysconf       for ub.sysconf .
     4370       define buffer buf_shop          for ub.shop .
     4371       define buffer buf_store         for ub.store .
     4372       define buffer buf_person        for ub.person .
     4373       define buffer buf_trn-doc       for ub.trn-doc .
     4374       define buffer buf_wth-doc       for ub.wth-doc .
     4375       do
     4376   for buf_firm
     4377     , buf_clients
     4378     , buf_sysconf
     4379     , buf_shop
     4380     , buf_trn-doc
     4381     , buf_person
     4382     , buf_wth-doc
     4383   on error undo, return error
     4384   :
     4385       if p-doc-type = 'при':U
     4386       or p-doc-type = 'возврат':U
     4387       then do:
     4388           assign
     4389               v-torgconf-supplier         = substitute( "&1&2&3&4&5", v-torgconf-cli-name, ( if v-torgconf-cli-addres = "":U then "":U else ", " ),
     4390                                             v-torgconf-cli-addres, ( if v-torgconf-cli-phone = "":U then "":U else ", " ), v-torgconf-cli-phone )
     4391               v-torgconf-suppi            = substitute( "&1&2&3&4&5", v-torgconf-cli-name, ( if v-torgconf-cli-addres = "":U then "":U else ", " ),
     4392                                             v-torgconf-cli-addres, ( if v-torgconf-cli-phone = "":U then "":U else ", " ), v-torgconf-cli-phone )
     4393               v-torgconf-saler            = substitute( "&1&2&3&4&5", v-torgconf-self-host-name, ( if v-torgconf-self-host-addres = "":U then "":U else ", " ),
     4394                                             v-torgconf-self-host-addres, ( if v-torgconf-self-host-phone = "":U then "":U else ", " ),v-torgconf-self-host-phone )
     4395               v-torgconf-consignee        = substitute( "&1&2&3&4&5", v-torgconf-sup-host-name, ( if v-torgconf-sup-host-addres = "":U then "":U else ", " ),
     4396                                             v-torgconf-sup-host-addres, ( if v-torgconf-sup-host-phone = "":U then "":U else ", " ), v-torgconf-sup-host-phone  )
     4397               v-torgconf-supplier-okpo    = v-torgconf-cli-okpo
     4398               v-torgconf-saler-okpo       = v-torgconf-self-host-okpo
     4399               v-torgconf-consignee-okpo   = v-torgconf-sup-host-okpo
     4400               v-torgconf-supplier-code    = substitute( "&1", v-torgconf-cli-code         )
     4401               v-torgconf-supplier-type    = v-torgconf-cli-type
     4402               v-torgconf-saler-code       = substitute( "&1", v-torgconf-self-host-code   )
     4403               v-torgconf-saler-type       = v-torgconf-self-host-type
     4404               v-torgconf-consignee-code   = substitute( "&1", v-torgconf-sup-host-code   )
     4405               v-torgconf-consignee-type   = v-torgconf-sup-host-type
     4406               v-torgconf-supplier-name    = substitute( "&1", v-torgconf-cli-name         )
     4407               v-torgconf-saler-name       = substitute( "&1", v-torgconf-self-host-name   )
     4408               v-torgconf-consignee-name   = substitute( "&1", v-torgconf-sup-host-name   )
     4409               v-torgconf-supplier-addr    = substitute( "&1", v-torgconf-cli-addres       )
     4410               v-torgconf-saler-addr       = substitute( "&1", v-torgconf-self-host-addres )
     4411               v-torgconf-consignee-addr   = substitute( "&1", v-torgconf-sup-host-addres )
     4412               v-torgconf-supplier-inn     = substitute( "&1", v-torgconf-cli-inn          )
     4413               v-torgconf-supplier-engl-name     = substitute( "&1", v-torgconf-cli-engl-name          )
     4414               v-torgconf-saler-inn        = substitute( "&1", v-torgconf-self-host-inn    )
     4415               v-torgconf-consignee-inn    = substitute( "&1", v-torgconf-sup-host-inn    )
     4416               v-torgconf-supplier-kpp     = substitute( "&1", v-torgconf-cli-kpp          )
     4417               v-torgconf-saler-kpp        = substitute( "&1", v-torgconf-self-host-kpp    )
     4418               v-torgconf-consignee-kpp    = substitute( "&1", v-torgconf-sup-host-kpp    )
     4419           .
     4420           if v-torgconf-cli-schet-exists = yes
     4421           AND v-form-name                  = "torg12":U
     4422           then do:
     4423               assign
     4424                   v-torgconf-supplier = v-torgconf-supplier
     4425                       + substitute( ", р/с &1 к/с &2"
     4426                                   , v-torgconf-cli-bank-r-schet
     4427                                   , v-torgconf-cli-bank-c-schet
     4428                                   )
     4429                   v-torgconf-suppi = v-torgconf-supplier
     4430                       + substitute( ", р/с &1 к/с &2"
     4431                                   , v-torgconf-cli-bank-r-schet
     4432                                   , v-torgconf-cli-bank-c-schet
     4433                                   )
     4434               .
     4435               if v-torgconf-cli-bank-exists = yes
     4436               then do:
     4437                   assign
     4438                       v-torgconf-supplier = v-torgconf-supplier
     4439                           + substitute( " БИК &1 в &2 &3"
     4440                                       , v-torgconf-cli-bank-bik
     4441                                       , v-torgconf-cli-bank-name
     4442                                       ,(if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) )
     4443                                       )
     4444                      v-torgconf-suppi = v-torgconf-supplier
     4445                           + substitute( " БИК &1 в &2 &3"
     4446                                       , v-torgconf-cli-bank-bik
     4447                                       , v-torgconf-cli-bank-name
     4448                                       ,(if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) )
     4449                                       )
     4450                   .
     4451               end.
     4452           end.
     4453           if v-torgconf-self-schet-exists = yes
     4454           AND v-form-name                  = "torg12":U
     4455           then do:
     4456               assign
     4457                   v-torgconf-saler = v-torgconf-saler
     4458                       + substitute( ", р/с &1 к/с &2"
     4459                                   , v-torgconf-self-bank-r-schet
     4460                                   , v-torgconf-self-bank-c-schet
     4461                                   )
     4462               .
     4463               if v-torgconf-self-bank-exists = yes
