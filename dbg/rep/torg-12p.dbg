     2211                 varprice-sale = 0
     2212                 varroad-tax   = 0
     2213                 varexcise     = 0
     2214               .
     2215             end.
     2216             assign
     2217               varlastcur-base     = varprice-sale
     2218               varlastcur-road-tax = varroad-tax
     2219               varlastcur-excise   = varexcise
     2220               varcur-base         = varcur-base      + varprice-sale * bf_gds-dtl.fact-qnty
     2221               varcur-road-tax     = varcur-road-tax  + varroad-tax   * bf_gds-dtl.fact-qnty
     2222               varcur-excise       = varcur-excise    + varexcise     * bf_gds-dtl.fact-qnty
     2223               varcur-fact-qnty    = varcur-fact-qnty + bf_gds-dtl.fact-qnty
     2224             .
     2225         end.
     2226       end.
     2227       if varcur-fact-qnty = 0 then do:
     2228         assign
     2229           varcur-base      = varlastcur-base
     2230           varcur-road-tax  = varlastcur-road-tax
     2231           varcur-excise    = varlastcur-excise
     2232         .
     2233       end.
     2234       else do:
     2235         assign
     2236           varcur-base      = varcur-base      / varcur-fact-qnty
     2237           varcur-road-tax  = varcur-road-tax  / varcur-fact-qnty
     2238           varcur-excise    = varcur-excise    / varcur-fact-qnty
     2239         .
     2240       end.
