     6206     ,output v-value-integer
     6207     ,output v-value-logical
     6208     ,output par-type
     6209     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     6210     ) no-error .
     6211   for each thbjattr_thbj-attr :
     6212       if thbjattr_thbj-attr.prop-code = 'factur01' then v-print-doc =  string(thbjattr_thbj-attr.property-value-logical) .
     6213   end.
     6214   if v-print-doc <> 'yes'  then assign v-print-doc = "no"  .
     6215   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6216   empty temp-table thbjattr_thbj-attr.
     6217   run adm/shattri.p (
     6218      input "get":U
     6219     ,input t-doc.obj-type
     6220     ,input t-doc.obj-code
     6221     ,input 'prt-obj':U
