     6155   define variable v-no-print-discnt           as   character             no-undo.
     6156   define variable prevpage                    as   integer initial 1     no-undo.
     6157   def var sym1                as char     init ":" no-undo.
     6158   def var sym2                as char     init ":" no-undo.
