      425   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      426       def var log-file-name as char no-undo.
      427       assign
      428           log-file-name = ''
      429       .
      430       if log-file-name <> "":U
