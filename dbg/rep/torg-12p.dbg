     3352   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3353   procedure wthcattr-sprcli :
     3354   define input parameter parparentproc  as widget-handle no-undo.
     3355   define input parameter p-mode  as character no-undo.
     3356   define input-output parameter p-value as character no-undo .
     3357   define output parameter p-setted as logical no-undo .
     3358     DEFINE VARIABLE v-value as character no-undo .
     3359     define variable v-cli-type as character no-undo .
     3360     define variable v-cli-code as integer no-undo .
     3361     define buffer buf_clients   for ub.clients.
     3362     define variable v_rid as character no-undo.
     3363     define variable ref-rec as recid no-undo .
     3364     do
     3365     on error undo, return error
     3366     :
     3367         v-value = p-value.
     3368      if p-value <> '':U then do:
     3369       assign
     3370       v-cli-type = substring(p-value, 1, 3)
     3371       v-cli-code = integer(substring(p-value, 4))
     3372       no-error.
     3373       if error-status:error then do:
     3374         assign
     3375         v-cli-type = '':U
     3376         v-cli-code = 0
     3377         .
     3378       end.
     3379      end.
     3380      FIND FIRST buf_clients NO-LOCK WHERE
     3381               buf_clients.obj-type = v-cli-type AND
     3382               buf_clients.obj-code = v-cli-code  NO-ERROR.
     3383      IF available(buf_clients) then do:
     3384       run ref/cli-all.w (
     3385                   input parparentproc
     3386                  ,input if p-mode = 'ИЗМЕНЕНИЕ':U then "b-sel":U else "":U
     3387                  ,input v-cli-type
     3388                  ,input 'все':U
     3389                  ,input 'все':U
     3390                  ,input RECID( buf_clients )
     3391                  ,input ",,,,,,NO"
     3392                  ,input ?
     3393                  ,OUTPUT v_rid ).
     3394     END.
     3395     ELSE if p-mode = 'ИЗМЕНЕНИЕ':U then DO:
     3396       run ref/cli-all.w (
     3397                    input parparentproc
     3398                   ,INPUT "b-sel":U
     3399                  ,input  v-cli-type
     3400                  ,input 'все':U
     3401                  ,input 'текущие':U
     3402                  ,input ?
     3403                  ,input ",,,,,,NO"
     3404                  ,input ?
     3405                  ,OUTPUT v_rid ).
     3406     END.
     3407     else do:
     3408       message
     3409       if p-value = "":U then 'Атрибут не задан!'
     3410       else substitute('Не найден клиент &1',p-value)
     3411       view-as alert-box warning.
     3412     end.
     3413     IF v_rid <> ? AND v_rid <> "":U THEN DO:
     3414       ASSIGN ref-rec = INT( v_rid ) NO-ERROR.
     3415       IF ERROR-STATUS:ERROR THEN DO:
     3416           RETURN NO-APPLY.
     3417       END.
     3418       FIND FIRST buf_clients NO-LOCK WHERE
     3419                  RECID( buf_clients ) = ref-rec NO-ERROR.
     3420       IF AVAIL buf_clients THEN DO:
     3421         v-value = buf_clients.obj-type + string(buf_clients.obj-code, ">>>>>>>>9").
     3422       end.
     3423     end.
     3424     if v-value <> p-value then do:
     3425       p-value = v-value.
     3426       p-setted = yes.
     3427     end.
     3428     end.
     3429   end procedure.
     3430     define new global shared variable g#wthcalib as handle no-undo.
     3431   procedure torgconf-read :
     3432   do
     3433   on error undo, return error
     3434   :
     3435       define input parameter p-form-name  as character    no-undo.
     3436       define input parameter p-host-code  as integer      no-undo.
     3437       define input parameter p-obj-type   as character    no-undo.
     3438       define input parameter p-obj-code   as integer      no-undo.
     3439       define variable v-outdate   as character     no-undo.
     3440       define variable v-outares   as character     no-undo.
     3441       define variable v-outsend   as character     no-undo.
     3442       define variable v-outasend  as character     no-undo.
     3443       define variable v-outprops  as character     no-undo.
     3444       define variable v-outnum    as character     no-undo.
     3445       define variable v-outprim   as character     no-undo.
     3446       define variable v-outdisc   as character     no-undo.
     3447       define variable v-outsubs   as character     no-undo.
     3448       define variable v-outrecv   as character     no-undo.
     3449       define variable v-outegrp   as character     no-undo.
     3450       define variable v-outt12    as character     no-undo.
     3451       define variable v-outappr   as character     no-undo.
     3452       define variable v-outrubl   as character     no-undo.
     3453       define variable v-outhold   as character     no-undo.
     3454       define variable v-outobj    as character     no-undo.
     3455       define variable v-outexlst  as character     no-undo.
     3456       define variable v-outprncd  as character     no-undo.
     3457       define variable v-par-type  as character     no-undo.
     3458       define variable v-outogr    as character     no-undo.
     3459       define variable v-outR      as character     no-undo.
     3460       define variable v-outB      as character     no-undo.
     3461       define variable v-outC      as character     no-undo.
     3462       assign
     3463           v-torgconf-outdate  = no
     3464           v-torgconf-outnum   = no
     3465           v-torgconf-outprim  = no
     3466           v-torgconf-outdisc  = no
     3467           v-torgconf-outsubs  = no
     3468           v-torgconf-outrecv  = no
     3469           v-torgconf-outegrp  = no
     3470           v-torgconf-outt12   = no
     3471           v-torgconf-outappr  = no
     3472           v-torgconf-outrubl  = no
     3473           v-torgconf-outhold  = no
     3474           v-torgconf-outobj   = no
     3475           v-torgconf-outexlst = no
     3476           v-torgconf-outexpas = "":U
     3477           v-torgconf-outprncd = yes
     3478           v-torgconf-outares  = no
     3479           v-torgconf-outsend  = no
     3480           v-torgconf-outasend  = no
     3481           v-torgconf-outprops  = no
     3482           v-form-name          = p-form-name
     3483       .
     3484   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3485   empty temp-table thbjattr_thbj-attr.
     3486   run adm/shattri.p (
     3487      input "get":U
     3488     ,input ''
     3489     ,input 0
     3490     ,input 'prt-glob':U
     3491     ,input  ""
     3492     ,output v-value-character
     3493     ,output v-value-date
     3494     ,output v-value-decimal
     3495     ,output v-value-integer
     3496     ,output v-value-logical
     3497     ,output par-type
     3498     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     3499     ) no-error .
     3500   for each thbjattr_thbj-attr :
     3501       if thbjattr_thbj-attr.prop-code = 'outprncd':U then v-outprncd =  string(thbjattr_thbj-attr.property-value-logical) .
     3502       if thbjattr_thbj-attr.prop-code = 'outrecv':U  then v-outrecv  =  thbjattr_thbj-attr.property-value-character .
     3503       if thbjattr_thbj-attr.prop-code = 'outprops':U then v-outprops =  thbjattr_thbj-attr.property-value-character .
     3504   end.
     3505   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3506   empty temp-table thbjattr_thbj-attr.
     3507   run adm/shattri.p (
     3508      input "get":U
     3509     ,input p-obj-type
     3510     ,input p-obj-code
     3511     ,input 'prt-obj':U
     3512     ,input  ""
     3513     ,output v-value-character
     3514     ,output v-value-date
     3515     ,output v-value-decimal
     3516     ,output v-value-integer
     3517     ,output v-value-logical
     3518     ,output par-type
     3519     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     3520     ) no-error .
     3521   for each thbjattr_thbj-attr :
     3522       if thbjattr_thbj-attr.prop-code = 'outdate':U  then v-outdate  =  thbjattr_thbj-attr.property-value-character .
     3523       if thbjattr_thbj-attr.prop-code = 'outares':U  then v-outares  =  thbjattr_thbj-attr.property-value-character .
     3524       if thbjattr_thbj-attr.prop-code = 'outnum':U   then v-outnum   =  thbjattr_thbj-attr.property-value-character .
     3525       if thbjattr_thbj-attr.prop-code = 'outprim':U  then v-outprim  =  thbjattr_thbj-attr.property-value-character .
     3526       if thbjattr_thbj-attr.prop-code = 'outdisc':U  then v-outdisc  =  thbjattr_thbj-attr.property-value-character .
     3527       if thbjattr_thbj-attr.prop-code = 'outsubs':U  then v-outsubs  =  thbjattr_thbj-attr.property-value-character .
     3528       if thbjattr_thbj-attr.prop-code = 'outegrp':U  then v-outegrp  =  thbjattr_thbj-attr.property-value-character .
     3529       if thbjattr_thbj-attr.prop-code = 'outt12':U   then v-outt12   =  thbjattr_thbj-attr.property-value-character .
     3530       if thbjattr_thbj-attr.prop-code = 'outappr':U  then v-outappr  =  thbjattr_thbj-attr.property-value-character .
     3531       if thbjattr_thbj-attr.prop-code = 'outrubl':U  then v-outrubl  =  thbjattr_thbj-attr.property-value-character .
     3532       if thbjattr_thbj-attr.prop-code = 'outhold':U  then v-outhold  =  thbjattr_thbj-attr.property-value-character .
     3533       if thbjattr_thbj-attr.prop-code = 'outobj':U   then v-outobj   =  thbjattr_thbj-attr.property-value-character .
     3534       if thbjattr_thbj-attr.prop-code = 'outsend':U  then v-outsend  =  thbjattr_thbj-attr.property-value-character .
     3535       if thbjattr_thbj-attr.prop-code = 'outasend':U then v-outasend =  thbjattr_thbj-attr.property-value-character .
     3536       if thbjattr_thbj-attr.prop-code = 'outogr':U   then v-torgconf-outogr   =  thbjattr_thbj-attr.property-value-character .
     3537       if thbjattr_thbj-attr.prop-code = 'outR':U     then v-torgconf-outR     =  thbjattr_thbj-attr.property-value-character .
     3538       if thbjattr_thbj-attr.prop-code = 'outB':U     then v-torgconf-outB     =  thbjattr_thbj-attr.property-value-character .
     3539       if thbjattr_thbj-attr.prop-code = 'outssdoc':U then v-torgconf-outssdoc =  thbjattr_thbj-attr.property-value-character .
     3540       if thbjattr_thbj-attr.prop-code = 'outC':U     then v-torgconf-outC     =  thbjattr_thbj-attr.property-value-character .
     3541   end.
     3542       run gbl/conf-rd.p ("outexpas", "":U, "":U, 0, "":U, "":U, "":U, no, output v-torgconf-outexpas, output v-par-type) no-error.
     3543       if error-status :error
     3544       then do:
     3545           assign
     3546               v-torgconf-outexpas = "":U
     3547           .
     3548       end.
     3549       assign
     3550           v-torgconf-outprncd = ( v-outprncd = "yes":U )
     3551       .
     3552       if p-form-name <> ""
     3553       and p-form-name <> ?
     3554       then do:
     3555           run gbl/conf-rd.p ("outexlst" , p-host-code, p-obj-type, p-obj-code, "", "", "", no, output v-outexlst , output v-par-type) no-error.
     3556           if error-status :error
     3557           then do:
     3558               assign
     3559                   v-outexlst           = ""
     3560               .
     3561           end.
     3562           if lookup( p-form-name, v-outdate ) <> 0
     3563           then do:
     3564               assign
     3565                   v-torgconf-outdate  = yes
     3566               .
     3567           end.
     3568           if lookup( p-form-name, v-outares ) <> 0
     3569           then do:
     3570               assign
     3571                   v-torgconf-outares  = yes
     3572               .
     3573           end.
     3574           if lookup( p-form-name, v-outnum  ) <> 0
     3575           then do:
     3576               assign
     3577                   v-torgconf-outnum   = yes
     3578               .
     3579           end.
     3580           if lookup( p-form-name, v-outprim ) <> 0
     3581           then do:
     3582               assign
     3583                   v-torgconf-outprim  = yes
     3584               .
     3585           end.
     3586           if lookup( p-form-name, v-outdisc ) <> 0
     3587           then do:
     3588               assign
     3589                   v-torgconf-outdisc  = yes
     3590               .
     3591           end.
     3592           if lookup( p-form-name, v-outsubs ) <> 0
     3593           then do:
     3594               assign
     3595                   v-torgconf-outsubs  = yes
     3596               .
     3597           end.
     3598           if lookup( p-form-name, v-outrecv ) <> 0
     3599           then do:
     3600               assign
     3601                   v-torgconf-outrecv  = yes
     3602               .
     3603           end.
     3604           if lookup( p-form-name, v-outegrp ) <> 0
     3605           then do:
     3606               assign
     3607                   v-torgconf-outegrp  = yes
     3608               .
     3609           end.
     3610           if lookup( p-form-name, v-outt12  ) <> 0
     3611           then do:
     3612               assign
     3613                   v-torgconf-outt12   = yes
     3614               .
     3615           end.
     3616           if lookup( p-form-name, v-outappr  ) <> 0
     3617           then do:
     3618               assign
     3619                   v-torgconf-outappr   = yes
     3620               .
     3621           end.
     3622           if lookup( p-form-name, v-outrubl  ) <> 0
     3623           then do:
     3624               assign
     3625                   v-torgconf-outrubl   = yes
     3626               .
     3627           end.
     3628           if lookup( p-form-name, v-outhold  ) <> 0
     3629           then do:
     3630               assign
     3631                   v-torgconf-outhold   = yes
     3632               .
     3633           end.
     3634           if lookup( p-form-name, v-outobj   ) <> 0
     3635           then do:
     3636               assign
     3637                   v-torgconf-outobj    = yes
     3638               .
     3639           end.
     3640           if lookup( p-form-name, v-outsend   ) <> 0
     3641           then do:
     3642               assign
     3643                   v-torgconf-outsend    = yes
     3644               .
     3645           end.
     3646           if lookup( p-form-name, v-outasend   ) <> 0
     3647           then do:
     3648               assign
     3649                   v-torgconf-outasend    = yes
     3650               .
     3651           end.
     3652           if lookup( p-form-name, v-outprops   ) <> 0
     3653           then do:
     3654               assign
     3655                   v-torgconf-outprops    = yes
     3656               .
     3657           end.
     3658           if lookup( p-form-name, v-outexlst ) <> 0
     3659           then do:
     3660               assign
     3661                   v-torgconf-outexlst  = yes
     3662               .
     3663           end.
     3664        assign
     3665         v-name = p-form-name.
     3666   end.
     3667   end.
     3668   end procedure.
     3669   procedure torgconf-get-self-param :
     3670   define input parameter p-obj-type           as character        no-undo.
     3671   define input parameter p-obj-code           as integer          no-undo.
     3672   define input parameter p-curr-code          as integer          no-undo.
     3673       define variable v-host-code    as integer      no-undo.
     3674       define variable v-par-type     as character    no-undo.
     3675   do
     3676   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message(1))
     3677   :
     3678   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3679   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     3680     (input  p-obj-type
     3681     ,input  p-obj-code
     3682     ,output v-host-code
     3683     )  .
     3684       if v-torgconf-outhold = yes
     3685       then do:
     3686           run torgconf-get-holdfirm-code in this-procedure (
     3687                 input p-obj-type
