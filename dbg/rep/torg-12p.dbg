     4016   on error undo, return error
     4017   :
     4018       assign
     4019          v-torgconf-sup-host-code = v-host-code
     4020       .
     4021       if v-torgconf-sup-host-code = 0
     4022       then do:
     4023           assign
     4024               v-torgconf-sup-host-name           = "":U
     4025               v-torgconf-sup-host-addres         = "":U
     4026               v-torgconf-sup-host-post-addres    = "":U
     4027               v-torgconf-sup-host-phone          = "":U
