     5811               END CASE.
     5812            end.
     5813      if v-torgconf-outogr = "manag_doc"
     5814         then do:
     5815            find first buf_trn-doc no-lock
     5816            where buf_trn-doc.doc-code = p-doc-code
     5817            no-error.
     5818            if available buf_trn-doc
     5819            then do:
     5820               run rep/get-psn.p
     5821               (input buf_trn-doc.boss
     5822               ,output v-torgconf-ogr-name
     5823               ) .
     5824            end.
     5825            find first buf_person no-lock
     5826            where buf_person.psn-code = buf_trn-doc.boss
     5827            no-error.
     5828            if available buf_person
     5829            then do:
     5830               v-torgconf-ogr-post = buf_person.position.
     5831            end.
     5832            if v-torgconf-ogr-name = "?":U then v-torgconf-ogr-name = "".
     5833            if v-torgconf-ogr-post = ? then  v-torgconf-ogr-post = "".
     5834         end.
     5835      end.
     5836      else do:
     5837      find first buf_wth-doc no-lock
     5838         where buf_wth-doc.doc-code = p-doc-code
     5839         no-error.
     5840         if available buf_wth-doc
     5841            then do:
     5842   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5843   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     5844     (input  buf_wth-doc.obj-type
     5845     ,input  buf_wth-doc.obj-code
     5846     ,output v-host-code
     5847     )  .
     5848            end.
     5849         if v-torgconf-outogr = "no_print"
     5850            then do:
     5851               assign
     5852                  v-torgconf-ogr-name = ""
     5853                  v-torgconf-ogr-post = ""
     5854               .
     5855            end.
     5856         if v-torgconf-outogr  = "ruk_firm"
     5857               then do:
     5858               find first buf_sysconf no-lock
     5859               where buf_sysconf.host-code = v-host-code
     5860               no-error.
     5861               if available buf_sysconf
     5862               then do:
     5863                  assign
     5864                     v-torgconf-ogr-post = buf_sysconf.head-position
     5865                  .
     5866               end.
     5867               find first buf_clients no-lock
     5868                  where buf_clients.obj-type = 'орг':U
     5869                  and buf_clients.obj-code = v-host-code
     5870               .
     5871               find first buf_firm no-lock
     5872                  where buf_firm.firm-code = buf_clients.obj-code
     5873               .
     5874               assign
     5875                  v-torgconf-ogr-name = buf_firm.director
     5876               .
     5877            end.
     5878            if v-torgconf-outogr = "dir_obj"
     5879               then do:
     5880               find first buf_wth-doc no-lock
     5881               where buf_wth-doc.doc-code = p-doc-code
     5882               no-error.
     5883                  find first buf_shop no-lock
     5884                  where buf_shop.obj-code = buf_wth-doc.obj-code
     5885                  .
     5886                  assign
     5887                     v-torgconf-ogr-name = buf_shop.director
     5888                     v-torgconf-ogr-post = "Директор"
     5889                  .
     5890               end.
     5891         if v-torgconf-outogr = "manag_doc"
     5892            then do:
     5893               find first buf_wth-doc no-lock
     5894               where buf_wth-doc.doc-code = p-doc-code
     5895               no-error.
     5896               if available buf_wth-doc
     5897               then do:
     5898                  run rep/get-psn.p
     5899                  (input buf_wth-doc.deliver
     5900                  ,output v-torgconf-ogr-name
     5901                  ) .
     5902               end.
     5903               find first buf_person no-lock
     5904               where buf_person.psn-code = buf_wth-doc.deliver
     5905               no-error.
     5906               if available buf_person
     5907               then do:
     5908                  v-torgconf-ogr-post = buf_person.position.
     5909               end.
     5910               if v-torgconf-ogr-name = "?":U then v-torgconf-ogr-name = "".
     5911               if v-torgconf-ogr-post = ? then  v-torgconf-ogr-post = "".
     5912            end.
     5913      end.
     5914   end.
     5915   end procedure.
     5916   procedure torgconf-get-outogr-param:
     5917       define input parameter p-form-name  as character    no-undo.
     5918       define input parameter p-host-code  as integer      no-undo.
     5919       define input parameter p-obj-type   as character    no-undo.
     5920       define input parameter p-obj-code   as integer      no-undo.
     5921       define input parameter p-doc-code   as character      no-undo.
     5922       define buffer buf_firm          for ub.firm .
     5923       define buffer buf_clients       for ub.clients .
     5924       define buffer buf_sysconf       for ub.sysconf .
     5925       define buffer buf_shop          for ub.shop .
     5926       define buffer buf_store         for ub.store .
     5927       define buffer buf_person        for ub.person .
     5928       define buffer buf_trn-doc       for ub.trn-doc .
     5929       define buffer buf_wth-doc       for ub.wth-doc .
     5930      if  p-form-name <> 'wthtrg12':U
     5931      and p-form-name <> 'wthfct':U
     5932      and p-form-name <> 'wthm11':U
     5933      then do:
     5934       find first buf_trn-doc no-lock
     5935       where buf_trn-doc.doc-code = p-doc-code
     5936       no-error.
     5937       if v-torgconf-outogr = "no_print"
     5938         then do:
     5939            assign
     5940               v-torgconf-ogr-name = ""
     5941               v-torgconf-ogr-post = ""
     5942            .
     5943         end.
     5944      if v-torgconf-outogr  = "ruk_firm"
     5945            then do:
     5946            find first buf_sysconf no-lock
     5947            where buf_sysconf.host-code = p-host-code
     5948            no-error.
     5949            if available buf_sysconf
     5950            then do:
     5951               assign
     5952                  v-torgconf-ogr-post = buf_sysconf.head-position
     5953               .
     5954            end.
     5955            find first buf_clients no-lock
     5956                where buf_clients.obj-type = 'орг':U
     5957                and buf_clients.obj-code = p-host-code
     5958            .
     5959            find first buf_firm no-lock
     5960                where buf_firm.firm-code = buf_clients.obj-code
     5961            .
     5962            assign
     5963                v-torgconf-ogr-name = buf_firm.director
     5964            .
     5965         end.
     5966         if v-torgconf-outogr = "dir_obj"
     5967            then do:
     5968            find first buf_trn-doc no-lock
     5969            where buf_trn-doc.doc-code = p-doc-code
     5970            no-error.
     5971               CASE buf_trn-doc.obj-type:
     5972               WHEN 'маг':U
     5973               THEN DO:
     5974                  find first buf_shop no-lock
     5975                  where buf_shop.obj-code = buf_trn-doc.obj-code
     5976                  .
     5977                  assign
     5978                     v-torgconf-ogr-name = buf_shop.director
     5979                     v-torgconf-ogr-post = "Директор"
     5980                  .
     5981               END.
     5982               WHEN 'скл':U
     5983               THEN DO:
     5984                  find first buf_store no-lock
     5985                  where buf_store.obj-code = buf_trn-doc.obj-code
     5986                  .
     5987                  assign
     5988                     v-torgconf-ogr-name = buf_store.store-boss
     5989                     v-torgconf-ogr-post = "Директор"
     5990                  .
     5991               END.
     5992               OTHERWISE DO:
     5993                  assign
     5994                     v-torgconf-ogr-name = "":U
     5995                     v-torgconf-ogr-post = "":U
     5996                  .
     5997               END.
     5998               END CASE.
     5999            end.
     6000      if v-torgconf-outogr = "manag_doc"
     6001         then do:
     6002            find first buf_trn-doc no-lock
     6003            where buf_trn-doc.doc-code = p-doc-code
     6004            no-error.
     6005            if available buf_trn-doc
     6006            then do:
     6007               run rep/get-psn.p
     6008               (input buf_trn-doc.boss
     6009               ,output v-torgconf-ogr-name
     6010               ) .
     6011            end.
     6012            find first buf_person no-lock
     6013            where buf_person.psn-code = buf_trn-doc.boss
     6014            no-error.
     6015            if available buf_person
     6016            then do:
     6017               v-torgconf-ogr-post = buf_person.position.
     6018            end.
     6019            if v-torgconf-ogr-name = "?":U then v-torgconf-ogr-name = "".
     6020            if v-torgconf-ogr-post = ? then  v-torgconf-ogr-post = "".
     6021         end.
     6022      end.
     6023      else do:
     6024      find first buf_wth-doc no-lock
     6025         where buf_wth-doc.doc-code = p-doc-code
     6026         no-error.
     6027         if v-torgconf-outogr = "no_print"
     6028            then do:
     6029               assign
     6030                  v-torgconf-ogr-name = ""
     6031                  v-torgconf-ogr-post = ""
     6032               .
     6033            end.
     6034         if v-torgconf-outogr  = "ruk_firm"
     6035               then do:
     6036               find first buf_sysconf no-lock
     6037               where buf_sysconf.host-code = p-host-code
     6038               no-error.
     6039               if available buf_sysconf
     6040               then do:
     6041                  assign
     6042                     v-torgconf-ogr-post = buf_sysconf.head-position
     6043                  .
     6044               end.
     6045               find first buf_clients no-lock
     6046                  where buf_clients.obj-type = 'орг':U
     6047                  and buf_clients.obj-code = p-host-code
     6048               .
     6049               find first buf_firm no-lock
     6050                  where buf_firm.firm-code = buf_clients.obj-code
     6051               .
     6052               assign
     6053                  v-torgconf-ogr-name = buf_firm.director
     6054               .
     6055            end.
     6056            if v-torgconf-outogr = "dir_obj"
     6057               then do:
     6058               find first buf_wth-doc no-lock
     6059               where buf_wth-doc.doc-code = p-doc-code
     6060               no-error.
     6061                  find first buf_shop no-lock
     6062                  where buf_shop.obj-code = buf_wth-doc.obj-code
     6063                  .
     6064                  assign
     6065                     v-torgconf-ogr-name = buf_shop.director
     6066                     v-torgconf-ogr-post = "Директор"
     6067                  .
     6068               end.
     6069         if v-torgconf-outogr = "manag_doc"
     6070            then do:
     6071               find first buf_wth-doc no-lock
     6072               where buf_wth-doc.doc-code = p-doc-code
     6073               no-error.
     6074               if available buf_wth-doc
     6075               then do:
     6076                  run rep/get-psn.p
     6077                  (input buf_wth-doc.deliver
     6078                  ,output v-torgconf-ogr-name
     6079                  ) .
     6080               end.
     6081               find first buf_person no-lock
     6082               where buf_person.psn-code = buf_wth-doc.deliver
     6083               no-error.
     6084               if available buf_person
     6085               then do:
     6086                  v-torgconf-ogr-post = buf_person.position.
     6087               end.
     6088               if v-torgconf-ogr-name = "?":U then v-torgconf-ogr-name = "".
     6089               if v-torgconf-ogr-post = ? then  v-torgconf-ogr-post = "".
     6090            end.
     6091      end.
     6092   end.
     6093   procedure torgconf-get-reason  :
     6094   define input parameter  p-doc-code       as character        no-undo.
     6095   define input parameter  p-reason-code    as integer          no-undo .
     6096   define input parameter  p-doc-type       as character        no-undo.
     6097       if p-reason-code > 0
     6098       then do:
     6099           define buffer buf_trn-reason for ub.trn-reason.
     6100           find first buf_trn-reason no-lock where buf_trn-reason.reason-code = p-reason-code no-error .
     6101           if available buf_trn-reason then assign v-torgconf-reason =  buf_trn-reason.reason-name .
     6102       end.
     6103       else do:
     6104           if p-doc-type = 'при':U
     6105           then  do:
     6106               define variable v-attr-type     as character    no-undo.
     6107               define variable v-attr-value    as character    no-undo.
     6108               run gbl/trdcat-v.p (input p-doc-code,input 'nids':U,output v-attr-value,output v-attr-type) .
     6109               assign v-torgconf-reason = v-attr-value .
     6110               run gbl/trdcat-v.p (input p-doc-code,input 'dids':U,output v-attr-value,output v-attr-type) .
     6111               assign v-torgconf-reason = v-torgconf-reason + " от " + v-attr-value .
     6112           end.
     6113       end.
     6114   end procedure.
     6115   def buffer t-doc            for trn-doc.
     6116   def buffer buf_tax_parts    for parts.
     6117   def buffer buf_goods        for goods.
     6118   def stream out-stream .
     6119   def shared var sort-name    as logical                          no-undo.
