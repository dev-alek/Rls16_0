     2337   procedure clcprtsl_calc-ttable :
     2338   define input parameter paris-doc           as   logical                 no-undo.
     2339   define input parameter paris-cur           as   logical                 no-undo.
     2340   define input parameter parroad-tax         like ub.doc-line.road-tax    no-undo.
     2341   define input parameter parexcise           like ub.doc-line.excise      no-undo.
     2342   define input parameter parvat-pc           like ub.doc-line.vat-pc      no-undo.
     2343   define input parameter parcons-vat-pc      like ub.doc-line.cons-vat-pc no-undo.
     2344   define input parameter parslt-pc           like ub.doc-line.slt-pc      no-undo.
     2345   define input parameter parbase-rate        like ub.trn-doc.base-rate    no-undo.
     2346   define input parameter parbase-scale       like ub.trn-doc.base-scale   no-undo.
     2347   define input parameter parr-b              as   character               no-undo.
     2348   define input parameter parcur-base         like ub.gds-dtl.cur-base     no-undo.
     2349   define input parameter parcur-road-tax     like ub.doc-line.road-tax    no-undo.
     2350   define input parameter parcur-excise       like ub.doc-line.excise      no-undo.
     2351   define input parameter parcur-vat-pc       like ub.doc-line.vat-pc      no-undo.
     2352   define input parameter parcurcons-vat-pc   like ub.doc-line.cons-vat-pc no-undo.
     2353   define input parameter parcurslt-pc        like ub.doc-line.slt-pc      no-undo.
     2354   define buffer bf_tt-allsum      for tt-allsum.
     2355   define buffer bf_tt-clcparts    for tt-clcparts.
     2356   define buffer bf_tt-allsum-line for tt-allsum-line.
     2357   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     2358   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     2359   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     2360   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     2361   define variable varexcise          like ub.price-list.excise     no-undo.
     2362   do on error undo, return error return-value :
     2363   for each bf_tt-allsum-line
     2364   on error undo, return error return-value
     2365    :
     2366     delete bf_tt-allsum-line.
     2367   end.
     2368   for each bf_tt-allsum
     2369   on error undo, return error return-value
     2370   :
     2371     delete bf_tt-allsum.
     2372   end.
     2373   for each bf_tt-clcparts
     2374   on error undo, return error return-value
     2375   :
     2376   if v-calcbypart then do:
     2377             assign
     2378             parcur-base =   bf_tt-clcparts.part-cur-base
     2379             parcur-road-tax = bf_tt-clcparts.part-cur-road-tax
     2380             parcur-excise =   bf_tt-clcparts.part-cur-excise
     2381             .
     2382   end.
     2383      run clcprtsl_calc-parts in this-procedure (
     2384        input recid(bf_tt-clcparts),
