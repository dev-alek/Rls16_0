     3780   procedure torgconf-get-recepient-param :
     3781   define input parameter torgconfdoc-code   as character                  no-undo.
     3782   define output parameter v-code-rec        as integer                    no-undo .
     3783   define output parameter v-type-rec        as character                  no-undo initial 'C':U.
     3784   define output parameter v-codefirm-rec    as integer                    no-undo .
     3785   define output parameter v-curcode-rec     as integer                    no-undo .
     3786        define variable  v-recipient-code  as character                  no-undo .
     3787        define variable  v-recipient       like ub.doc-attr.attr-value   no-undo.
     3788        define variable  v-trdcattr-type   as character                  no-undo initial 'C':U.
     3789   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input torgconfdoc-code ,
     3790                           input 'Recipient':U ,
     3791                          output v-recipient-code ,
     3792                          output v-trdcattr-type ) no-error .
     3793       if error-status :error then do:
     3794        message
     3795         vss-workfile vss-revision vss-description skip
     3796         "Ошибка при вызове процедуры tdat-val":U skip
     3797         "Документ: " torgconfdoc-code skip
     3798         "Атрибут: " 'Recipient':U skip
     3799         "Значение: " v-recipient skip
     3800         trim( error-status :get-message (1) ) skip
     3801         return-value skip
     3802         view-as alert-box error.
     3803       undo, return error return-value.
     3804       end.
     3805     assign
     3806       v-recipient  = v-recipient-code
     3807       v-type-rec = substring(v-recipient-code,1,3)
     3808       v-code-rec  = int(substring(v-recipient-code,4,15))
     3809       no-error
     3810     .
     3811     if v-type-rec = ? then v-type-rec = "" .
     3812     if v-code-rec  = ? then v-code-rec  =  0 .
     3813     end procedure.
