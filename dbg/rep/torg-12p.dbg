     2441         bf_tt-allsum-line.sum-dsc-rubl-cur       = bf_tt-allsum-line.sum-dsc-rubl-cur     + bf_tt-allsum.sum-dsc-rubl-cur
     2442         bf_tt-allsum-line.dsc-base-cur           = bf_tt-allsum-line.dsc-base-cur         + bf_tt-allsum.dsc-base-cur
     2443         bf_tt-allsum-line.dsc-rubl-cur           = bf_tt-allsum-line.dsc-rubl-cur         + bf_tt-allsum.dsc-rubl-cur
     2444         bf_tt-allsum-line.vat-base-cur           = bf_tt-allsum-line.vat-base-cur         + bf_tt-allsum.vat-base-cur
     2445         bf_tt-allsum-line.vat-rubl-cur           = bf_tt-allsum-line.vat-rubl-cur         + bf_tt-allsum.vat-rubl-cur
     2446         bf_tt-allsum-line.vat-base-buyer-cur     = bf_tt-allsum-line.vat-base-buyer-cur   + bf_tt-allsum.vat-base-buyer-cur
     2447         bf_tt-allsum-line.vat-rubl-buyer-cur     = bf_tt-allsum-line.vat-rubl-buyer-cur   + bf_tt-allsum.vat-rubl-buyer-cur
     2448         bf_tt-allsum-line.slt-base-cur           = bf_tt-allsum-line.slt-base-cur         + bf_tt-allsum.slt-base-cur
     2449         bf_tt-allsum-line.slt-rubl-cur           = bf_tt-allsum-line.slt-rubl-cur         + bf_tt-allsum.slt-rubl-cur
     2450         bf_tt-allsum-line.road-tax-base-cur      = bf_tt-allsum-line.road-tax-base-cur    + bf_tt-allsum.road-tax-base-cur
     2451         bf_tt-allsum-line.road-tax-rubl-cur      = bf_tt-allsum-line.road-tax-rubl-cur    + bf_tt-allsum.road-tax-rubl-cur
     2452         bf_tt-allsum-line.excise-base-cur        = bf_tt-allsum-line.excise-base-cur      + bf_tt-allsum.excise-base-cur
     2453         bf_tt-allsum-line.excise-rubl-cur        = bf_tt-allsum-line.excise-rubl-cur      + bf_tt-allsum.excise-rubl-cur
     2454         bf_tt-allsum-line.sum-dsc-base-acc       = bf_tt-allsum-line.sum-dsc-base-acc     + bf_tt-allsum.sum-dsc-base-acc
     2455         bf_tt-allsum-line.sum-dsc-rubl-acc       = bf_tt-allsum-line.sum-dsc-rubl-acc     + bf_tt-allsum.sum-dsc-rubl-acc
     2456         bf_tt-allsum-line.sum-dsc-cli-acc        = bf_tt-allsum-line.sum-dsc-cli-acc      + bf_tt-allsum.sum-dsc-cli-acc
     2457         bf_tt-allsum-line.dsc-base-acc           = bf_tt-allsum-line.dsc-base-acc         + bf_tt-allsum.dsc-base-acc
     2458         bf_tt-allsum-line.dsc-rubl-acc           = bf_tt-allsum-line.dsc-rubl-acc         + bf_tt-allsum.dsc-rubl-acc
     2459         bf_tt-allsum-line.dsc-cli-acc            = bf_tt-allsum-line.dsc-cli-acc          + bf_tt-allsum.dsc-cli-acc
     2460         bf_tt-allsum-line.vat-base-acc           = bf_tt-allsum-line.vat-base-acc         + bf_tt-allsum.vat-base-acc
     2461         bf_tt-allsum-line.vat-rubl-acc           = bf_tt-allsum-line.vat-rubl-acc         + bf_tt-allsum.vat-rubl-acc
     2462         bf_tt-allsum-line.vat-cli-acc            = bf_tt-allsum-line.vat-cli-acc          + bf_tt-allsum.vat-cli-acc
     2463         bf_tt-allsum-line.slt-base-acc           = bf_tt-allsum-line.slt-base-acc         + bf_tt-allsum.slt-base-acc
     2464         bf_tt-allsum-line.slt-rubl-acc           = bf_tt-allsum-line.slt-rubl-acc         + bf_tt-allsum.slt-rubl-acc
     2465         bf_tt-allsum-line.slt-cli-acc            = bf_tt-allsum-line.slt-cli-acc          + bf_tt-allsum.slt-cli-acc
     2466         bf_tt-allsum-line.road-tax-base-acc      = bf_tt-allsum-line.road-tax-base-acc    + bf_tt-allsum.road-tax-base-acc
     2467         bf_tt-allsum-line.road-tax-rubl-acc      = bf_tt-allsum-line.road-tax-rubl-acc    + bf_tt-allsum.road-tax-rubl-acc
     2468         bf_tt-allsum-line.road-tax-cli-acc       = bf_tt-allsum-line.road-tax-cli-acc     + bf_tt-allsum.road-tax-cli-acc
     2469         bf_tt-allsum-line.excise-base-acc        = bf_tt-allsum-line.excise-base-acc      + bf_tt-allsum.excise-base-acc
     2470         bf_tt-allsum-line.excise-rubl-acc        = bf_tt-allsum-line.excise-rubl-acc      + bf_tt-allsum.excise-rubl-acc
     2471         bf_tt-allsum-line.excise-cli-acc         = bf_tt-allsum-line.excise-cli-acc       + bf_tt-allsum.excise-cli-acc
     2472         bf_tt-allsum-line.transport-base-acc     = bf_tt-allsum-line.transport-base-acc   + bf_tt-allsum.transport-base-acc
     2473         bf_tt-allsum-line.transport-rubl-acc     = bf_tt-allsum-line.transport-rubl-acc   + bf_tt-allsum.transport-rubl-acc
     2474         bf_tt-allsum-line.transport-cli-acc      = bf_tt-allsum-line.transport-cli-acc    + bf_tt-allsum.transport-cli-acc
     2475         bf_tt-allsum-line.other-base-acc         = bf_tt-allsum-line.other-base-acc       + bf_tt-allsum.other-base-acc
     2476         bf_tt-allsum-line.other-rubl-acc         = bf_tt-allsum-line.other-rubl-acc       + bf_tt-allsum.other-rubl-acc
     2477         bf_tt-allsum-line.other-cli-acc          = bf_tt-allsum-line.other-cli-acc        + bf_tt-allsum.other-cli-acc
     2478         .
     2479     end.
     2480   end.
     2481   end.
     2482   end procedure.
     2483   define variable vss-include-info21 as character format "X(65)" no-undo
     2484   initial "@(#)$Workfile$ $Revision$".
     2485   define variable v-fmtcli-name          as character    no-undo.
     2486   define variable v-fmtcli-engl-name     as character    no-undo.
     2487   define variable v-fmtcli-addres        as character    no-undo.
     2488   define variable v-fmtcli-post-addres   as character    no-undo.
     2489   define variable v-fmtcli-full-addres   as character    no-undo.
     2490   define variable v-fmtcli-phone         as character    no-undo.
     2491   define variable v-fmtcli-inn           as character    no-undo.
     2492   define variable v-fmtcli-kpp           as character    no-undo.
     2493   define variable v-fmtcli-okpo          as character    no-undo.
     2494   define variable v-fmtcli-country       as character    no-undo.
     2495   define variable v-fmtcli-city          as character    no-undo.
     2496   define variable v-fmtcli-index         as character    no-undo.
     2497   define variable v-fmtcli-schet-exists  as logical      no-undo.
     2498   define variable v-fmtcli-bank-exists   as logical      no-undo.
     2499   define variable v-fmtcli-bank-r-schet  as character    no-undo.
     2500   define variable v-fmtcli-bank-c-schet  as character    no-undo.
     2501   define variable v-fmtcli-bank-bik      as character    no-undo.
     2502   define variable v-fmtcli-bank-name     as character    no-undo.
     2503   define variable v-fmtcli-bank-addres   as character    no-undo.
     2504   define variable v-fmtcli-bank-city     as character    no-undo.
     2505   procedure fmtcli-get-bank :
     2506   define input parameter p-host-code      as integer          no-undo.
     2507   define input parameter p-obj-type       as character        no-undo.
     2508   define input parameter p-obj-code       as integer          no-undo.
     2509   define input parameter p-curr-code      as integer          no-undo.
     2510       define buffer buf_fin-schet     for ub.fin-schet.
     2511       define buffer buf_fin-bank      for ub.fin-bank.
     2512   do
     2513   for buf_fin-schet
     2514     , buf_fin-bank
     2515   on error undo, return error
     2516   :
     2517       assign
     2518           v-fmtcli-schet-exists       = no
     2519           v-fmtcli-bank-exists        = no
     2520           v-fmtcli-bank-r-schet       = "":U
     2521           v-fmtcli-bank-c-schet       = "":U
     2522           v-fmtcli-bank-bik           = "":U
     2523           v-fmtcli-bank-name          = "":U
     2524           v-fmtcli-bank-addres        = "":U
     2525           v-fmtcli-bank-city          = "":U
     2526       .
     2527       search-for-schet:
     2528       for each buf_fin-schet no-lock
     2529          where buf_fin-schet.host-code = p-host-code
     2530            and buf_fin-schet.cli-type  = p-obj-type
     2531            and buf_fin-schet.cli-code  = p-obj-code
     2532            and buf_fin-schet.curr-code = p-curr-code
     2533       on error undo, return error
     2534       :
     2535           if buf_fin-schet.status_   = 'удал':U
     2536           then do:
     2537           end.
     2538           else do:
     2539               assign
     2540                   v-fmtcli-schet-exists   = yes
     2541                   v-fmtcli-bank-r-schet   = trim( buf_fin-schet.r-schet )
     2542                   v-fmtcli-bank-c-schet   = trim( buf_fin-schet.c-schet )
     2543               .
     2544               find first buf_fin-bank no-lock
     2545                    where buf_fin-bank.host-code = p-host-code
     2546                      and buf_fin-bank.code-bank = buf_fin-schet.code-bank
     2547               no-error.
     2548               if available buf_fin-bank
     2549               then do:
     2550                   assign
     2551                       v-fmtcli-bank-exists      = yes
     2552                       v-fmtcli-bank-bik         = trim( buf_fin-bank.bik )
     2553                       v-fmtcli-bank-name        = trim( buf_fin-bank.bank-name )
     2554                       v-fmtcli-bank-addres      = trim(buf_fin-bank.addres)
     2555                       v-fmtcli-bank-city      = trim(buf_fin-bank.bank-city)
     2556                   .
     2557               end.
     2558               else do:
     2559                   assign
     2560                       v-fmtcli-bank-exists    = no
     2561                       v-fmtcli-bank-bik       = "":U
     2562                       v-fmtcli-bank-name      = "":U
     2563                       v-fmtcli-bank-addres    = "":U
     2564                       v-fmtcli-bank-city      = "":U
     2565                   .
     2566               end.
     2567               leave search-for-schet.
     2568           end.
     2569       end.
     2570   end.
     2571   end procedure.
     2572   procedure fmtcli-get-client :
     2573   define input parameter p-obj-type       as character    no-undo.
     2574   define input parameter p-obj-code       as integer      no-undo.
     2575       define variable v-temp-fmtcli-address      as character     no-undo.
     2576       define variable v-num-country-city    as integer      no-undo.
     2577       define buffer buf_clients   for ub.clients.
     2578       define buffer buf_firm      for ub.firm.
     2579       define buffer buf_store     for ub.store.
     2580       define buffer buf_shop      for ub.shop.
     2581       define buffer buf_person    for ub.person.
     2582   do
     2583   for buf_clients
     2584     , buf_firm
     2585     , buf_store
     2586     , buf_shop
     2587     , buf_person
     2588   on error undo, return error
     2589   :
     2590       assign
     2591           v-fmtcli-name           = "":U
     2592           v-fmtcli-addres         = "":U
     2593           v-fmtcli-post-addres    = "":U
     2594           v-fmtcli-full-addres    = "":U
     2595           v-fmtcli-phone          = "":U
     2596           v-fmtcli-inn            = "":U
     2597           v-fmtcli-kpp            = "":U
     2598           v-fmtcli-okpo           = "":U
     2599           v-fmtcli-city           = "":U
     2600           v-fmtcli-index          = "":U
     2601           v-fmtcli-country        = "":U
     2602       .
     2603       find first buf_clients no-lock
     2604            where buf_clients.obj-type = p-obj-type
     2605              and buf_clients.obj-code = p-obj-code
     2606       .
     2607       assign
     2608           v-fmtcli-name = buf_clients.obj-name
     2609       .
     2610       case buf_clients.obj-type:
     2611          when 'орг':U
     2612          then do:
     2613               find first buf_firm no-lock
     2614                    where buf_firm.firm-code = buf_clients.obj-code
     2615                    no-error
     2616               .
     2617               if available buf_firm
     2618               then do:
     2619                   assign
     2620                       v-num-country-city = num-entries( buf_firm.city )
     2621                       v-fmtcli-engl-name = buf_firm.engl-name
     2622                   .
     2623                   if v-num-country-city > 0
     2624                   then do:
     2625                       assign
     2626                           v-fmtcli-country    = trim( entry( 1, buf_firm.city ) )
     2627                       .
     2628                   end.
     2629                   if v-num-country-city > 1
     2630                   then do:
     2631                       assign
     2632                           v-fmtcli-city       = trim( entry( 2, buf_firm.city ) )
     2633                       .
     2634                   end.
     2635                   run fmtcli-concatenate-strings in this-procedure (
     2636                         input v-fmtcli-full-addres
     2637                       , input v-fmtcli-country
     2638                       , input ", ":U
     2639                       , input 50
     2640                       , output v-fmtcli-full-addres
     2641                   ).
     2642                   run fmtcli-concatenate-strings in this-procedure (
     2643                         input v-fmtcli-full-addres
     2644                       , input v-fmtcli-city
     2645                       , input ", ":U
     2646                       , input 50
     2647                       , output v-fmtcli-full-addres
     2648                   ).
     2649                   run fmtcli-concatenate-strings in this-procedure (
     2650                         input v-fmtcli-full-addres
     2651                       , input IF buf_firm.ind = 0 THEN "" ELSE string( buf_firm.ind )
     2652                       , input ", ":U
     2653                       , input 50
     2654                       , output v-fmtcli-full-addres
     2655                   ).
     2656                   run fmtcli-concatenate-strings in this-procedure (
     2657                         input v-fmtcli-post-addres
     2658                       , input v-fmtcli-country
     2659                       , input ", ":U
     2660                       , input 50
     2661                       , output v-fmtcli-post-addres
     2662                   ).
     2663                   run fmtcli-concatenate-strings in this-procedure (
     2664                         input v-fmtcli-post-addres
     2665                       , input v-fmtcli-city
     2666                       , input ", ":U
     2667                       , input 50
     2668                       , output v-fmtcli-post-addres
     2669                   ).
     2670                   run fmtcli-concatenate-strings in this-procedure (
     2671                         input v-fmtcli-post-addres
     2672                       , input string( buf_firm.ind )
     2673                       , input ", ":U
     2674                       , input 50
     2675                       , output v-fmtcli-post-addres
     2676                   ).
     2677                   run fmtcli-concatenate-strings in this-procedure (
     2678                         input substring( buf_firm.addres1, 1, 50 )
     2679                       , input buf_firm.addres2
     2680                       , input " ":U
     2681                       , input 50
     2682                       , output v-temp-fmtcli-address
     2683                   ).
     2684                   run fmtcli-concatenate-strings in this-procedure (
     2685                         input v-temp-fmtcli-address
     2686                       , input substring( buf_firm.addres1, 51, 50 )
     2687                       , input " ":U
     2688                       , input 50
     2689                       , output v-temp-fmtcli-address
     2690                   ).
     2691                   run fmtcli-concatenate-strings in this-procedure (
     2692                         input v-temp-fmtcli-address
     2693                       , input substring( buf_firm.addres1, 101, 50 )
     2694                       , input " ":U
     2695                       , input 50
     2696                       , output v-temp-fmtcli-address
     2697                   ).
     2698                   assign
     2699                       v-fmtcli-addres = v-temp-fmtcli-address
     2700                   .
     2701                   if buf_firm.addres1 <> ?
     2702                   then do:
     2703                       run fmtcli-concatenate-strings in this-procedure (
     2704                             input v-fmtcli-full-addres
     2705                           , input v-fmtcli-addres
     2706                           , input ", ":U
     2707                           , input 0
     2708                           , output v-fmtcli-full-addres
     2709                       ).
     2710                   end.
     2711                   run fmtcli-concatenate-strings in this-procedure (
     2712                         input substring( buf_firm.post-addr1, 1, 50 )
     2713                       , input buf_firm.post-addr2
     2714                       , input " ":U
     2715                       , input 50
     2716                       , output v-fmtcli-post-addres
     2717                   ).
     2718                   run fmtcli-concatenate-strings in this-procedure (
     2719                         input v-fmtcli-post-addres
     2720                       , input substring( buf_firm.post-addr1, 51, 50 )
     2721                       , input " ":U
     2722                       , input 50
     2723                       , output v-fmtcli-post-addres
     2724                   ).
     2725                   run fmtcli-concatenate-strings in this-procedure (
     2726                         input v-fmtcli-post-addres
     2727                       , input substring( buf_firm.post-addr1, 101, 50 )
     2728                       , input " ":U
     2729                       , input 50
     2730                       , output v-fmtcli-post-addres
     2731                   ).
     2732                   assign
     2733                       v-fmtcli-phone         = buf_firm.phone
     2734                       v-fmtcli-inn           = buf_firm.inn
     2735                       v-fmtcli-kpp           = buf_firm.kpp
     2736                       v-fmtcli-okpo          = buf_firm.okpo
     2737                       v-fmtcli-index         = string( buf_firm.ind )
     2738                   .
     2739               end.
     2740          end.
     2741          when 'маг':U
     2742          then do:
     2743               find first buf_shop no-lock
     2744                    where buf_shop.obj-code = buf_clients.obj-code
     2745               .
     2746               if available buf_shop
     2747               then do:
     2748                   run fmtcli-concatenate-strings in this-procedure (
     2749                         input buf_shop.addres1
     2750                       , input buf_shop.addres2
     2751                       , input " ":U
     2752                       , input 50
     2753                       , output v-fmtcli-addres
     2754                   ).
     2755                   assign
     2756                       v-fmtcli-full-addres = v-fmtcli-addres
     2757                       v-fmtcli-post-addres = v-fmtcli-addres
     2758                       v-fmtcli-phone       = buf_shop.phone
     2759                       v-fmtcli-inn         = "":U
     2760                       v-fmtcli-kpp         = "":U
     2761                       v-fmtcli-okpo        = "":U
     2762                       v-fmtcli-city        = "":U
     2763                       v-fmtcli-index       = "":U
     2764                   .
     2765               end.
     2766          end.
     2767          when 'скл':U
     2768          then do:
     2769               find first buf_store no-lock
     2770                    where buf_store.obj-code = buf_clients.obj-code
     2771               .
     2772               if available buf_store
     2773               then do:
     2774                   run fmtcli-concatenate-strings in this-procedure (
     2775                         input buf_store.addres1
     2776                       , input buf_store.addres2
     2777                       , input " ":U
     2778                       , input 50
     2779                       , output v-fmtcli-addres
     2780                   ).
     2781                   assign
     2782                       v-fmtcli-full-addres = v-fmtcli-addres
     2783                       v-fmtcli-phone       = buf_store.phone
     2784                       v-fmtcli-inn         = "":U
     2785                       v-fmtcli-kpp         = "":U
     2786                       v-fmtcli-okpo        = "":U
     2787                       v-fmtcli-city        = "":U
     2788                       v-fmtcli-index       = "":U
     2789                   .
     2790               end.
     2791          end.
     2792          when 'чел':U
     2793          then do:
     2794               find first buf_person no-lock
     2795                    where buf_person.psn-code = buf_clients.obj-code
     2796               .
     2797               if available buf_person
     2798               then do:
     2799                   run fmtcli-concatenate-strings in this-procedure (
     2800                         input ( if buf_person.ind = 0 or buf_person.ind = ?
     2801                                 then "":U
     2802                                 else string( buf_person.ind, "999999")
     2803                                 )
     2804                       , input buf_person.city
     2805                       , input ", ":U
     2806                       , input 0
     2807                       , output v-fmtcli-full-addres
     2808                   ).
     2809                   assign
     2810                       v-fmtcli-addres = buf_person.address
     2811                   .
     2812                   run fmtcli-concatenate-strings in this-procedure (
     2813                         input v-fmtcli-full-addres
     2814                       , input v-fmtcli-addres
     2815                       , input ", ":U
     2816                       , input 0
     2817                       , output v-fmtcli-full-addres
     2818                   ).
     2819                   assign
     2820                       v-fmtcli-phone     = buf_person.phone1
     2821                       v-fmtcli-inn       = buf_person.inn
     2822                       v-fmtcli-kpp       = buf_person.kpp
     2823                       v-fmtcli-okpo      = buf_person.okpo
     2824                       v-fmtcli-city      = buf_person.city
     2825                       v-fmtcli-index     = string( buf_person.ind )
     2826                   .
     2827               end.
     2828          end.
     2829       end case.
     2830   end.
     2831   end procedure.
     2832   procedure fmtcli-concatenate-strings :
     2833   define input parameter p-string-1       as character        no-undo.
     2834   define input parameter p-string-2       as character        no-undo.
     2835   define input parameter p-delimiter      as character        no-undo.
     2836   define input parameter p-length         as integer          no-undo.
     2837   define output parameter p-out-string    as character        no-undo.
     2838   do
     2839   on error undo, return error
     2840   :
     2841       assign
     2842           p-out-string = ( if p-string-1 = ?
     2843                            then "":U
     2844                            else trim( p-string-1 ) )
     2845       .
     2846       assign
     2847           p-out-string = p-out-string
     2848                        + ( if p-out-string = "":U
     2849                            or length( p-out-string ) = p-length
     2850                            or p-string-2 = ?
     2851                            or trim( p-string-2 ) = "":U
     2852                            then "":U
     2853                            else p-delimiter )
     2854                        + ( if p-string-2 = ?
     2855                            or trim( p-string-2 ) = "":U
     2856                            then "":U
     2857                            else trim( p-string-2 ) )
     2858       .
     2859   end.
     2860   end procedure.
     2861   def var vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2862   define new global shared variable g#attr-lib  as handle no-undo .
     2863   define variable v-attr-lib-variable as handle no-undo .
     2864   procedure clntattr-code :
     2865     define input  parameter p-code           as character no-undo .
     2866     define output parameter p-type           as character no-undo .
     2867     define output parameter p-format         as character no-undo .
     2868     define output parameter p-label          as character no-undo .
     2869     define output parameter p-user-can-edit  as logical   no-undo .
     2870     define output parameter p-output-display as logical   no-undo .
     2871     define output parameter p-other          as character no-undo .
     2872     do
     2873     on error undo, return error return-value
     2874     :
     2875           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run clntattr-code in g#attr-lib
     2876         (input  p-code
     2877         ,output p-type
     2878         ,output p-format
     2879         ,output p-label
     2880         ,output p-user-can-edit
     2881         ,output p-output-display
     2882         ,output p-other
     2883         ) no-error .
     2884       if error-status :error
     2885       then do:
     2886         undo, return error return-value .
     2887       end.
     2888     end.
     2889   end procedure.
     2890   procedure clntattr-tooltip :
     2891     define input  parameter p-code    as character no-undo .
     2892     define output parameter p-tooltip as character no-undo .
     2893     define output parameter p-label   as character no-undo .
     2894     do
     2895     on error undo, return error return-value
     2896     :
     2897           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run clntattr-tooltip in g#attr-lib
     2898         (input  p-code
     2899         ,output p-tooltip
     2900         ,output p-label
     2901         ) no-error .
     2902       if error-status :error
     2903       then do:
     2904         undo, return error return-value .
     2905       end.
     2906     end.
     2907   end procedure.
     2908   procedure clntattr-value :
     2909     define input  parameter p-obj-type like ub.clients-attr.obj-type   no-undo .
     2910     define input  parameter p-obj-code like ub.clients-attr.obj-code   no-undo .
     2911     define input  parameter p-code     like ub.clients-attr.attr-code  no-undo .
     2912     define output parameter p-value    like ub.clients-attr.attr-value no-undo .
     2913     define output parameter p-type     as character no-undo .
     2914     do
