     1875       bfsacc_tt-allsum.dsc-rubl-acc        = bfs_tt-allsum.dsc-rubl-acc
     1876       bfsacc_tt-allsum.dsc-cli-acc         = bfs_tt-allsum.dsc-cli-acc
     1877       bfsacc_tt-allsum.vat-base-acc        = bfs_tt-allsum.vat-base-acc
     1878       bfsacc_tt-allsum.vat-rubl-acc        = bfs_tt-allsum.vat-rubl-acc
     1879       bfsacc_tt-allsum.vat-cli-acc         = bfs_tt-allsum.vat-cli-acc
     1880       bfsacc_tt-allsum.slt-base-acc        = bfs_tt-allsum.slt-base-acc
     1881       bfsacc_tt-allsum.slt-rubl-acc        = bfs_tt-allsum.slt-rubl-acc
     1882       bfsacc_tt-allsum.slt-cli-acc         = bfs_tt-allsum.slt-cli-acc
     1883       bfsacc_tt-allsum.excise-base-acc     = bfs_tt-allsum.excise-base-acc
     1884       bfsacc_tt-allsum.excise-rubl-acc     = bfs_tt-allsum.excise-rubl-acc
     1885       bfsacc_tt-allsum.excise-cli-acc      = bfs_tt-allsum.excise-cli-acc
     1886       bfsacc_tt-allsum.road-tax-base-acc   = bfs_tt-allsum.road-tax-base-acc
     1887       bfsacc_tt-allsum.road-tax-rubl-acc   = bfs_tt-allsum.road-tax-rubl-acc
     1888       bfsacc_tt-allsum.road-tax-cli-acc    = bfs_tt-allsum.road-tax-cli-acc
     1889       bfsacc_tt-allsum.transport-base-acc  = bfs_tt-allsum.transport-base-acc
     1890       bfsacc_tt-allsum.transport-rubl-acc  = bfs_tt-allsum.transport-rubl-acc
     1891       bfsacc_tt-allsum.transport-cli-acc   = bfs_tt-allsum.transport-cli-acc
     1892       bfsacc_tt-allsum.other-base-acc      = bfs_tt-allsum.other-base-acc
     1893       bfsacc_tt-allsum.other-rubl-acc      = bfs_tt-allsum.other-rubl-acc
     1894       bfsacc_tt-allsum.other-cli-acc       = bfs_tt-allsum.other-cli-acc
     1895       .
     1896   end.
     1897   otherwise do:
     1898     return error substitute ("Неизвестный тип приобретения &1 по партии с кодом &2 по документу &3, порожденную документом &4 по товару &5 &6 &7.",
     1899                              cl_tt-clcparts.purch-code,
     1900                              cl_tt-clcparts.part-code,
     1901                              cl_tt-clcparts.out-code,
     1902                              cl_tt-clcparts.in-code,
     1903                              cl_tt-clcparts.artic,
     1904                              cl_tt-clcparts.prod-type,
     1905                              cl_tt-clcparts.prod-code).
     1906   end.
     1907   end case.
     1908   end.
     1909   end procedure.
     1910   procedure clcprtsl_calc-line :
     1911   define input  parameter parrec-line as recid no-undo.
     1912   define variable v-tax-date         as   date                     no-undo.
     1913   define variable v-vat-pc           like ub.doc-line.vat-pc       no-undo.
     1914   define variable varr-b             as   character                no-undo.
     1915   define variable varr-btype         as   character                no-undo.
     1916   define variable varcur-base        like ub.gds-dtl.price-base    no-undo.
     1917   define variable varcur-road-tax    like ub.doc-line.road-tax     no-undo.
     1918   define variable varcur-excise      like ub.doc-line.excise       no-undo.
     1919   define variable varcur-vat-pc      like ub.doc-line.vat-pc       no-undo.
     1920   define variable varcur-cons-vat-pc like ub.doc-line.cons-vat-pc  no-undo.
     1921   define variable varcur-slt-pc      like ub.doc-line.slt-pc       no-undo.
     1922   define variable varcur-fact-qnty   like ub.gds-dtl.fact-qnty     no-undo.
     1923   define variable varb-code          like ub.bar-code.b-code       no-undo.
     1924   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     1925   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     1926   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     1927   define variable varexcise          like ub.price-list.excise     no-undo.
     1928   define variable varlastcur-base        like ub.gds-dtl.price-base no-undo.
     1929   define variable varlastcur-road-tax    like ub.gds-dtl.price-base no-undo.
     1930   define variable varlastcur-excise      like ub.gds-dtl.price-base     no-undo.
     1931   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     1932   define variable v-varsum           as decimal                  no-undo.
     1933   define variable varprice-salef as decimal   no-undo .
     1934   define buffer bf_trn-doc             for ub.trn-doc.
     1935   define buffer bf_doc-line            for ub.doc-line.
     1936   define buffer bf_gds-dtl             for ub.gds-dtl.
     1937   define buffer bf_goods               for ub.goods.
     1938   define buffer bf_parts               for ub.parts.
     1939   define buffer bf_sysconf             for ub.sysconf.
     1940   define buffer bf_tt-allsum-line      for tt-allsum-line.
     1941   define buffer bfs_tt-allsum-line     for tt-allsum-line.
     1942   define buffer bfo_tt-allsum-line     for tt-allsum-line.
     1943   define buffer bfos_tt-allsum-line    for tt-allsum-line.
     1944   define buffer buf_parts        for ub.parts.
     1945   v-calcbypart = no.
     1946   do on error undo, return error return-value :
     1947   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1948   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1949     (output varr-b
     1950     )  .
     1951     find first bf_doc-line where recid (bf_doc-line) = parrec-line no-lock.
     1952     find first bf_trn-doc where bf_trn-doc.doc-code = bf_doc-line.doc-code no-lock.
     1953     find first bf_goods where bf_goods.artic     = bf_doc-line.artic     and
     1954                               bf_goods.prod-type = bf_doc-line.prod-type and
     1955                               bf_goods.prod-code = bf_doc-line.prod-code no-lock.
     1956     if bf_trn-doc.fact-date <> ?        then do:
     1957       assign v-tax-date = bf_trn-doc.fact-date.
     1958     end.
     1959     else do:
     1960       assign v-tax-date = ?.
     1961     end.
     1962   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1963   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     1964     (input  bf_goods.gds-code
     1965     ,input  '1':U
     1966     ,input  v-tax-date
     1967     ,input  bf_trn-doc.host-code
     1968     ,input  bf_trn-doc.obj-type
     1969     ,input  bf_trn-doc.obj-code
     1970     ,output v-vat-pc
     1971     ) no-error .
     1972     if error-status :error
     1973     or v-vat-pc = ? then do:
     1974        return error substitute ("Ошибка при поиске НДС для товара &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     1975     end.
     1976     if bf_goods.gds-type = 'у':U or
     1977        bf_trn-doc.status_ = 'запрос':U then do:
     1978       for each bf_tt-allsum-line
     1979       on error undo, return error return-value
     1980        :
     1981         delete bf_tt-allsum-line.
     1982       end.
     1983       create bf_tt-allsum-line.
     1984       assign
     1985        bf_tt-allsum-line.sum-type = 'основная_сумма':U.
     1986       for each bf_gds-dtl where bf_gds-dtl.doc-code  = bf_doc-line.doc-code  and
     1987                                 bf_gds-dtl.artic     = bf_doc-line.artic     and
     1988                                 bf_gds-dtl.prod-type = bf_doc-line.prod-type and
     1989                                 bf_gds-dtl.prod-code = bf_doc-line.prod-code no-lock on error undo, return error return-value :
     1990         assign
     1991           bf_tt-allsum-line.fact-qnty            =  bf_tt-allsum-line.fact-qnty        + bf_gds-dtl.fact-qnty
     1992           bf_tt-allsum-line.sum-dsc-base-doc     =  bf_tt-allsum-line.sum-dsc-base-doc + (bf_gds-dtl.price-base - bf_gds-dtl.discnt-base) * bf_gds-dtl.fact-qnty
     1993           bf_tt-allsum-line.sum-dsc-rubl-doc     =  bf_tt-allsum-line.sum-dsc-rubl-doc + (bf_gds-dtl.price-rubl - bf_gds-dtl.discnt-rubl) * bf_gds-dtl.fact-qnty
     1994           bf_tt-allsum-line.dsc-base-doc         =  bf_tt-allsum-line.dsc-base-doc     + bf_gds-dtl.discnt-base * bf_gds-dtl.fact-qnty
     1995           bf_tt-allsum-line.dsc-rubl-doc         =  bf_tt-allsum-line.dsc-rubl-doc     + bf_gds-dtl.discnt-rubl * bf_gds-dtl.fact-qnty
     1996           bf_tt-allsum-line.sum-dsc-base-cur     =  bf_tt-allsum-line.sum-dsc-base-cur + (if varr-b = "base" then bf_gds-dtl.cur-base else bf_gds-dtl.cur-base / bf_trn-doc.exch-rate * bf_trn-doc.exch-scale) * bf_gds-dtl.fact-qnty
     1997           bf_tt-allsum-line.sum-dsc-rubl-cur     =  bf_tt-allsum-line.sum-dsc-rubl-cur + (if varr-b = "rubl" then bf_gds-dtl.cur-base else bf_gds-dtl.cur-base * bf_trn-doc.exch-rate / bf_trn-doc.exch-scale) * bf_gds-dtl.fact-qnty
     1998           bf_tt-allsum-line.sum-dsc-base-acc     =  bf_tt-allsum-line.sum-dsc-base-acc + bf_doc-line.price-base * bf_gds-dtl.fact-qnty
     1999           bf_tt-allsum-line.sum-dsc-rubl-acc     =  bf_tt-allsum-line.sum-dsc-rubl-acc + bf_doc-line.price-rubl * bf_gds-dtl.fact-qnty
     2000           bf_tt-allsum-line.sum-dsc-cli-acc      =  ?
     2001           bf_tt-allsum-line.vat-base-acc         =  bf_tt-allsum-line.vat-base-acc     + bf_doc-line.price-base * v-vat-pc / (100 + v-vat-pc) * bf_gds-dtl.fact-qnty
     2002           bf_tt-allsum-line.vat-rubl-acc         =  bf_tt-allsum-line.vat-rubl-acc     + bf_doc-line.price-rubl * v-vat-pc / (100 + v-vat-pc) * bf_gds-dtl.fact-qnty
     2003           bf_tt-allsum-line.vat-cli-acc          =  ?
     2004           .
     2005       end.
     2006       assign
     2007         bf_tt-allsum-line.cli-qnty             =  ?
     2008         bf_tt-allsum-line.slt-base-doc         =  bf_tt-allsum-line.sum-dsc-base-doc * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     2009         bf_tt-allsum-line.slt-rubl-doc         =  bf_tt-allsum-line.sum-dsc-rubl-doc * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     2010         bf_tt-allsum-line.vat-base-buyer-doc   =  (bf_tt-allsum-line.sum-dsc-base-doc - bf_tt-allsum-line.slt-base-doc) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     2011         bf_tt-allsum-line.vat-rubl-buyer-doc   =  (bf_tt-allsum-line.sum-dsc-rubl-doc - bf_tt-allsum-line.slt-rubl-doc) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     2012         bf_tt-allsum-line.road-tax-base-doc    =  0
     2013         bf_tt-allsum-line.road-tax-rubl-doc    =  0
     2014         bf_tt-allsum-line.excise-base-doc      =  0
     2015         bf_tt-allsum-line.excise-rubl-doc      =  0
     2016         bf_tt-allsum-line.vat-base-doc         =  bf_tt-allsum-line.vat-base-buyer-doc
     2017         bf_tt-allsum-line.vat-rubl-doc         =  bf_tt-allsum-line.vat-rubl-buyer-doc
     2018         bf_tt-allsum-line.dsc-base-cur         =  0
     2019         bf_tt-allsum-line.dsc-rubl-cur         =  0
     2020         bf_tt-allsum-line.slt-base-cur         =  bf_tt-allsum-line.sum-dsc-base-cur * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     2021         bf_tt-allsum-line.slt-rubl-cur         =  bf_tt-allsum-line.sum-dsc-rubl-cur * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     2022         bf_tt-allsum-line.vat-base-buyer-cur   =  (bf_tt-allsum-line.sum-dsc-base-cur - bf_tt-allsum-line.slt-base-cur) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     2023         bf_tt-allsum-line.vat-rubl-buyer-cur   =  (bf_tt-allsum-line.sum-dsc-rubl-cur - bf_tt-allsum-line.slt-rubl-cur) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     2024         bf_tt-allsum-line.road-tax-base-cur    =  0
     2025         bf_tt-allsum-line.road-tax-rubl-cur    =  0
     2026         bf_tt-allsum-line.excise-base-cur      =  0
     2027         bf_tt-allsum-line.excise-rubl-cur      =  0
     2028         bf_tt-allsum-line.vat-base-cur         =  bf_tt-allsum-line.vat-base-buyer-cur
     2029         bf_tt-allsum-line.vat-rubl-cur         =  bf_tt-allsum-line.vat-rubl-buyer-cur
     2030         bf_tt-allsum-line.dsc-base-acc         =  0
     2031         bf_tt-allsum-line.dsc-rubl-acc         =  0
     2032         bf_tt-allsum-line.dsc-cli-acc          =  0
     2033         bf_tt-allsum-line.slt-base-acc         =  0
     2034         bf_tt-allsum-line.slt-rubl-acc         =  0
     2035         bf_tt-allsum-line.slt-cli-acc          =  0
     2036         bf_tt-allsum-line.road-tax-base-acc    =  0
     2037         bf_tt-allsum-line.road-tax-rubl-acc    =  0
     2038         bf_tt-allsum-line.road-tax-cli-acc     =  0
     2039         bf_tt-allsum-line.excise-base-acc      =  0
     2040         bf_tt-allsum-line.excise-rubl-acc      =  0
     2041         bf_tt-allsum-line.excise-cli-acc       =  0
     2042         bf_tt-allsum-line.transport-base-acc   =  0
     2043         bf_tt-allsum-line.transport-rubl-acc   =  0
     2044         bf_tt-allsum-line.transport-cli-acc    =  0
     2045         bf_tt-allsum-line.other-base-acc       =  0
     2046         bf_tt-allsum-line.other-rubl-acc       =  0
     2047         bf_tt-allsum-line.other-cli-acc        =  0
     2048         .
     2049       create bfs_tt-allsum-line.
     2050       assign
     2051       bfs_tt-allsum-line.sum-type = 'основная_сумма_со_знаком':U.
     2052       if bf_trn-doc.doc-type = 'инв':U or
     2053          bf_trn-doc.doc-type = 'при':U    or
     2054          bf_trn-doc.doc-type = 'возврат':U    then do:
     2055          buffer-copy bf_tt-allsum-line except bf_tt-allsum-line.sum-type to bfs_tt-allsum-line.
     2056       end.
     2057       else do:
     2058         assign
     2059           bfs_tt-allsum-line.fact-qnty           =  - bf_tt-allsum-line.fact-qnty
     2060           bfs_tt-allsum-line.cli-qnty            =  - bf_tt-allsum-line.cli-qnty
     2061           bfs_tt-allsum-line.sum-dsc-base-doc    =  - bf_tt-allsum-line.sum-dsc-base-doc
     2062           bfs_tt-allsum-line.sum-dsc-rubl-doc    =  - bf_tt-allsum-line.sum-dsc-rubl-doc
     2063           bfs_tt-allsum-line.dsc-base-doc        =  - bf_tt-allsum-line.dsc-base-doc
     2064           bfs_tt-allsum-line.dsc-rubl-doc        =  - bf_tt-allsum-line.dsc-rubl-doc
     2065           bfs_tt-allsum-line.vat-base-doc        =  - bf_tt-allsum-line.vat-base-doc
     2066           bfs_tt-allsum-line.vat-rubl-doc        =  - bf_tt-allsum-line.vat-rubl-doc
     2067           bfs_tt-allsum-line.vat-base-buyer-doc  =  - bf_tt-allsum-line.vat-base-buyer-doc
     2068           bfs_tt-allsum-line.vat-rubl-buyer-doc  =  - bf_tt-allsum-line.vat-rubl-buyer-doc
     2069           bfs_tt-allsum-line.slt-base-doc        =  - bf_tt-allsum-line.slt-base-doc
     2070           bfs_tt-allsum-line.slt-rubl-doc        =  - bf_tt-allsum-line.slt-rubl-doc
     2071           bfs_tt-allsum-line.road-tax-base-doc   =  - bf_tt-allsum-line.road-tax-base-doc
     2072           bfs_tt-allsum-line.road-tax-rubl-doc   =  - bf_tt-allsum-line.road-tax-rubl-doc
     2073           bfs_tt-allsum-line.excise-base-doc     =  - bf_tt-allsum-line.excise-base-doc
     2074           bfs_tt-allsum-line.excise-rubl-doc     =  - bf_tt-allsum-line.excise-rubl-doc
     2075           bfs_tt-allsum-line.sum-dsc-base-cur    =  - bf_tt-allsum-line.sum-dsc-base-cur
     2076           bfs_tt-allsum-line.sum-dsc-rubl-cur    =  - bf_tt-allsum-line.sum-dsc-rubl-cur
     2077           bfs_tt-allsum-line.dsc-base-cur        =  - bf_tt-allsum-line.dsc-base-cur
     2078           bfs_tt-allsum-line.dsc-rubl-cur        =  - bf_tt-allsum-line.dsc-rubl-cur
     2079           bfs_tt-allsum-line.vat-base-cur        =  - bf_tt-allsum-line.vat-base-cur
     2080           bfs_tt-allsum-line.vat-rubl-cur        =  - bf_tt-allsum-line.vat-rubl-cur
     2081           bfs_tt-allsum-line.vat-base-buyer-cur  =  - bf_tt-allsum-line.vat-base-buyer-cur
     2082           bfs_tt-allsum-line.vat-rubl-buyer-cur  =  - bf_tt-allsum-line.vat-rubl-buyer-cur
     2083           bfs_tt-allsum-line.slt-base-cur        =  - bf_tt-allsum-line.slt-base-cur
     2084           bfs_tt-allsum-line.slt-rubl-cur        =  - bf_tt-allsum-line.slt-rubl-cur
     2085           bfs_tt-allsum-line.road-tax-base-cur   =  - bf_tt-allsum-line.road-tax-base-cur
     2086           bfs_tt-allsum-line.road-tax-rubl-cur   =  - bf_tt-allsum-line.road-tax-rubl-cur
     2087           bfs_tt-allsum-line.excise-base-cur     =  - bf_tt-allsum-line.excise-base-cur
     2088           bfs_tt-allsum-line.excise-rubl-cur     =  - bf_tt-allsum-line.excise-rubl-cur
     2089           bfs_tt-allsum-line.sum-dsc-base-acc    =  - bf_tt-allsum-line.sum-dsc-base-acc
     2090           bfs_tt-allsum-line.sum-dsc-rubl-acc    =  - bf_tt-allsum-line.sum-dsc-rubl-acc
     2091           bfs_tt-allsum-line.sum-dsc-cli-acc     =  - bf_tt-allsum-line.sum-dsc-cli-acc
     2092           bfs_tt-allsum-line.dsc-base-acc        =  - bf_tt-allsum-line.dsc-base-acc
     2093           bfs_tt-allsum-line.dsc-rubl-acc        =  - bf_tt-allsum-line.dsc-rubl-acc
     2094           bfs_tt-allsum-line.dsc-cli-acc         =  - bf_tt-allsum-line.dsc-cli-acc
     2095           bfs_tt-allsum-line.vat-base-acc        =  - bf_tt-allsum-line.vat-base-acc
     2096           bfs_tt-allsum-line.vat-rubl-acc        =  - bf_tt-allsum-line.vat-rubl-acc
     2097           bfs_tt-allsum-line.vat-cli-acc         =  - bf_tt-allsum-line.vat-cli-acc
     2098           bfs_tt-allsum-line.slt-base-acc        =  - bf_tt-allsum-line.slt-base-acc
     2099           bfs_tt-allsum-line.slt-rubl-acc        =  - bf_tt-allsum-line.slt-rubl-acc
     2100           bfs_tt-allsum-line.slt-cli-acc         =  - bf_tt-allsum-line.slt-cli-acc
     2101           bfs_tt-allsum-line.road-tax-base-acc   =  - bf_tt-allsum-line.road-tax-base-acc
     2102           bfs_tt-allsum-line.road-tax-rubl-acc   =  - bf_tt-allsum-line.road-tax-rubl-acc
     2103           bfs_tt-allsum-line.road-tax-cli-acc    =  - bf_tt-allsum-line.road-tax-cli-acc
     2104           bfs_tt-allsum-line.excise-base-acc     =  - bf_tt-allsum-line.excise-base-acc
     2105           bfs_tt-allsum-line.excise-rubl-acc     =  - bf_tt-allsum-line.excise-rubl-acc
     2106           bfs_tt-allsum-line.excise-cli-acc      =  - bf_tt-allsum-line.excise-cli-acc
     2107           bfs_tt-allsum-line.transport-base-acc  =  - bf_tt-allsum-line.transport-base-acc
     2108           bfs_tt-allsum-line.transport-rubl-acc  =  - bf_tt-allsum-line.transport-rubl-acc
     2109           bfs_tt-allsum-line.transport-cli-acc   =  - bf_tt-allsum-line.transport-cli-acc
     2110           bfs_tt-allsum-line.other-base-acc      =  - bf_tt-allsum-line.other-base-acc
     2111           bfs_tt-allsum-line.other-rubl-acc      =  - bf_tt-allsum-line.other-rubl-acc
     2112           bfs_tt-allsum-line.other-cli-acc       =  - bf_tt-allsum-line.other-cli-acc
     2113           .
     2114       end.
     2115       create bfo_tt-allsum-line.
     2116       assign
