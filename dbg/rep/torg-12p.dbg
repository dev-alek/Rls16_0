        1   block-level on error undo, throw.
        2   define input parameter p-mainmenu-handle    as handle           no-undo.
        3   define input parameter rec_id               as recid            no-undo.
        4   define variable vss-revision    as character no-undo initial "$Revision: aea5316774be, 0, rls $":U .
        5   define variable vss-author      as character no-undo initial "$Author: expertek $":U .
        6   define variable vss-date        as character no-undo initial "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        7   define variable vss-workfile    as character no-undo initial "$Workfile: torg-12p.p $":U .
        8   define variable vss-archive     as character no-undo initial "$Archive: rep/torg-12p.p $":U .
        9   define variable vss-description as character no-undo initial "Топливная накладная.":U .
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define new global shared variable g#library  as handle no-undo .
       69   define new global shared variable g#library2 as handle no-undo .
       70   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       71   define  shared variable PrintCopiesCounter as integer   no-undo initial 1 .
       72   define  shared variable RepPathName        as character no-undo .
       73   define  shared variable PrintRubl          as logical   no-undo .
       74   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       75   function breakstr returns character ( input        for-name    as character,
       76                                         input        line-length as integer,
       77                                         input-output line1       as character,
       78                                         input-output line2       as character ) :
       79     define variable ii as integer no-undo.
       80     if length( for-name ) > line-length then do:
       81       assign ii    = 1
       82              line1 = "":u
       83              line2 = "":u.
       84       if length( entry( ii, for-name , " ":u ) ) > line-length then do:
       85         assign line1 =       substring( for-name, 1, line-length     )
       86                line2 = trim( substring( for-name,    line-length + 1 ) ).
       87       end.                                                     else do:
       88         do while length( line1 + entry( ii, for-name, " ":u ) ) < ( line-length + 1 ) :
       89           assign line1 = line1 + entry( ii, for-name, " ":u ) + " ":u
       90                  ii    = ii    + 1.
       91           if length( entry( ii, for-name, " ":u ) ) > line-length then do:
       92             assign line1 = line1 + substring( for-name, length( line1 ), line-length - length( line1 ) + 1 ).
       93           end.
       94         end.
       95         assign line2 = trim( substring( for-name, length( line1 ) ) ).
       96       end.
       97     end.                                else do:
       98       assign line1 = for-name
       99              line2 = "":u.
      100     end.
      101     return ( line1 ).
      102   end function.
      103   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      104   procedure cur-time :
      105      define output parameter p-today as date      no-undo .
      106      define output parameter p-time  as integer   no-undo .
      107     do
      108     on error undo, return error
      109     :
      110       define variable v-date1 as date      no-undo .
      111       define variable v-date2 as date      no-undo .
      112       define variable v-time  as integer   no-undo .
      113       assign
      114         v-date1 = today
      115         v-time  = time
      116         v-date2 = today
      117       .
      118       if v-date1 <> v-date2
      119       then do:
      120         assign
      121           v-date1 = today
      122           v-time  = v-time
      123         .
      124       end.
      125       assign
      126         p-today = v-date1
      127         p-time  = v-time
      128       .
      129     end.
      130   end.
      131   function cur-time-date returns character
      132   :
      133     return string(today, '99/99/9999':U) .
      134   end.
      135   function cur-time-mjd returns decimal
      136   :
      137     define variable v-date as date      no-undo .
      138     define variable v-time as integer   no-undo .
      139     run cur-time in this-procedure
      140       (output v-date
      141       ,output v-time
      142       ) .
      143     return integer(v-date) - 2400002 + (v-time / 86400) .
      144   end.
      145   function cur-time-get-ending-index returns integer
      146   (input p-number as integer
      147   )
      148   :
      149     if p-number < 0
      150     or p-number = ?
      151     then do:
      152       return 1 .
      153     end.
      154     define variable v-rest as integer   no-undo .
      155     assign
      156       p-number = p-number modulo 100
      157     .
      158     if p-number < 20
      159     then do:
      160       assign
      161         v-rest = p-number
      162       .
      163     end.
      164     else do:
      165       assign
      166         v-rest = p-number modulo 10
      167       .
      168     end.
      169     case v-rest :
      170       when 1
      171       then do:
      172         return 2 .
      173       end.
      174       when 2 or
      175       when 3 or
      176       when 4
      177       then do:
      178         return 3 .
      179       end.
      180       otherwise do:
      181         return 1 .
      182       end.
      183     end case .
      184   end.
      185   procedure cur-time-mjd-to-date :
      186      define input  parameter i-mjd-diff as decimal no-undo.
      187      define output parameter o-Date     as date    no-undo.
      188      define output parameter o-Time     as integer no-undo.
      189      define variable v-day-number as integer   no-undo .
      190      if    i-mjd-diff < 0
      191         or i-mjd-diff = ?
      192      then do:
      193         return "?" .
      194      end.
      195      assign
      196         v-day-number = truncate(i-mjd-diff,0).
      197         o-Date = date(v-day-number + 2400002).
      198         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      199     .
      200   end.
      201   function cur-time-mjd-to-string returns character
      202   (input p-mjd-diff as decimal
      203   )
      204   :
      205     define variable v-day-number as integer   no-undo .
      206     define variable v-seconds    as integer   no-undo .
      207     define variable v-hour       as integer   no-undo .
      208     define variable v-min        as integer   no-undo .
      209     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      210     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      211     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      212     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      213     if p-mjd-diff < 0
      214     or p-mjd-diff = ?
      215     then do:
      216       return "?" .
      217     end.
      218     assign
      219       v-day-number = integer(truncate(p-mjd-diff,0))
      220       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      221     .
      222     if v-seconds > 86400
      223     then do:
      224       assign
      225         v-seconds = 86400 - 1
      226       .
      227     end.
      228     if v-seconds < 0
      229     then do:
      230       assign
      231         v-seconds = 0
      232       .
      233     end.
      234     assign
      235       v-hour = truncate(v-seconds / 3600, 0)
      236     .
      237     assign
      238       v-seconds = v-seconds modulo 3600
      239     .
      240     assign
      241       v-min = truncate(v-seconds / 60, 0)
      242     .
      243     assign
      244       v-seconds = v-seconds modulo 60
      245     .
      246     return
      247         (if v-day-number <> 0
      248           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      249           else ""
      250         )
      251       + (if v-day-number <> 0 or v-hour <> 0
      252           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      253           else ""
      254         )
      255       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      256           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      257           else ""
      258         )
      259       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      260       .
      261   end.
      262   function cur-time-string returns character
      263   :
      264     define variable v-date as date      no-undo .
      265     define variable v-time as integer   no-undo .
      266     run cur-time in this-procedure
      267       (output v-date
      268       ,output v-time
      269       ) .
      270     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      271   end.
      272   function cur-time-string-sec returns character
      273   :
      274     define variable v-date as date      no-undo .
      275     define variable v-time as integer   no-undo .
      276     run cur-time in this-procedure
      277       (output v-date
      278       ,output v-time
      279       ) .
      280     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      281   end.
      282   function cur-time-custom  returns character
      283   (input p-prefix as character
      284   ,input p-date-format as character
      285   ,input p-delimiter as character
      286   ,input p-time-format as character
      287   ,input p-suffix as character
      288   )
      289   :
      290     define variable v-date as date      no-undo .
      291     define variable v-time as integer   no-undo .
      292     run cur-time in this-procedure
      293       (output v-date
      294       ,output v-time
      295       ) .
      296     return
      297       p-prefix
      298       + string(v-date, p-date-format)
      299       + p-delimiter
      300       + string(v-time, p-time-format)
      301       + p-suffix
      302       .
      303   end.
      304   function cur-time-print  returns character
      305   :
      306     define variable v-date as date      no-undo .
      307     define variable v-time as integer   no-undo .
      308     run cur-time in this-procedure
      309       (output v-date
      310       ,output v-time
      311       ) .
      312     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      313   end.
      314   function cur-time-datetime returns datetime
      315   :
      316     define variable v-char as character no-undo .
      317     define variable v-datetime as datetime no-undo .
      318     v-char = cur-time-string().
      319     v-datetime = datetime(v-char).
      320     return  v-datetime.
      321   end.
      322   function cur-time-string-msec returns character
      323   :
      324     define variable v-date as datetime  no-undo .
      325     v-date = now.
      326     return string(v-date) .
      327   end.
      328   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      329   FUNCTION determined RETURNS DECIMAL (INPUT parundefine-var AS DECIMAL):
      330      IF parundefine-var = ? THEN RETURN 0.00.
      331                             ELSE RETURN parundefine-var.
      332   END FUNCTION.
      333   FUNCTION dtm-char RETURNS CHARACTER (INPUT p-undef-char AS CHARACTER):
      334      IF p-undef-char = ? THEN do:
      335        RETURN "?".
      336      end.
      337      ELSE do:
      338        RETURN p-undef-char .
      339      end.
      340   END FUNCTION.
      341   function cross-list returns logical (
      342     input parfirst-stream  as character,
      343     input parsecond-stream as character,
      344     input pardelim         as character).
      345     if pardelim = ""
      346     or pardelim = ?
      347     then do:
      348       assign
      349         pardelim = ","
      350       .
      351     end.
      352     define variable vari            as integer no-undo .
      353     define variable varresult-cross as logical no-undo .
      354     assign
      355       varresult-cross = no
      356     .
      357     def var v-num-parfirst-stream as integer no-undo .
      358     assign
      359       v-num-parfirst-stream = num-entries(parfirst-stream, pardelim)
      360     .
      361     do vari = 1 to v-num-parfirst-stream
      362     :
      363       if lookup(entry(vari, parfirst-stream, pardelim)
      364                ,parsecond-stream
      365                ,pardelim
      366                ) > 0 then do:
      367         assign
      368           varresult-cross = yes
      369         .
      370         leave.
      371       end.
      372     end.
      373     return varresult-cross .
      374   end function.
      375   function hvrdtax return logical (input parrecid as recid):
      376   define variable varresult as logical no-undo.
      377   run hvrdtax-proc (input parrecid, output varresult).
      378   return varresult.
      379   end function.
      380   procedure hvrdtax-proc:
      381   define input  parameter parrecid  as recid   no-undo.
      382   define output parameter parresult as logical no-undo.
      383   define buffer bf_goods for ub.goods.
      384   define buffer bf_units for ub.units.
      385   define buffer rt_tax   for ub.tax.
      386   find first rt_tax   where rt_tax.tax-code    = integer('3':U) no-lock no-error.
      387   find first bf_goods where recid(bf_goods)    = parrecid              no-lock.
      388   find first bf_units where bf_units.unit-name = bf_goods.unit-base    no-lock.
      389   if available rt_tax and
      390       can-find(first ub.tax-units No-LOCK WHERE
      391                      ub.tax-units.tax-code = rt_tax.tax-code AND
      392                      LOOKUP(ub.tax-units.type, bf_units.type) > 0) then assign parresult = yes.
      393                                                       else assign parresult = no.
      394   end procedure.
      395   def var vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      396   procedure tax-name:
      397   define input  parameter pardef-tax  as character           no-undo.
      398   define output parameter parname-tax as character initial ? no-undo.
      399   define buffer bf_tax for ub.tax.
      400   do on error undo, return error :
      401      case pardef-tax:
      402         when 'vat':U then do:
      403                     find first bf_tax where bf_tax.tax-code = integer('1':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '1':U(не задействован)".
      404         end.
      405         when 'slt':U then do:
      406                     find first bf_tax where bf_tax.tax-code = integer('2':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '2':U(не задействован)".
      407         end.
      408         when 'rdt':U then do:
      409                     find first bf_tax where bf_tax.tax-code = integer('3':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '3':U(не задействован)".
      410         end.
      411         when 'exc':U then do:
      412                     find first bf_tax where bf_tax.tax-code = integer('4':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '4':U(не задействован)".
      413         end.
      414         otherwise do:
      415            return error "Задан неверный параметр " + pardef-tax + " .".
      416         end.
      417      end case.
      418   end.
      419   end procedure.
      420       def var t-addres        like ub.firm.addres1   no-undo.
