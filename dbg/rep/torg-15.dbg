     5451   end.
     5452   else do:
     5453     for each out-vatp_parts where out-vatp_parts.out-code   = t-doc.doc-code
     5454                                  and out-vatp_parts.obj-type   = t-doc.obj-type
     5455                                  and out-vatp_parts.obj-code   = t-doc.obj-code
     5456                                  and out-vatp_parts.artic      = doc-line.artic
     5457                                  and out-vatp_parts.prod-type  = doc-line.prod-type
     5458                                  and out-vatp_parts.prod-code  = doc-line.prod-code no-lock :
     5459       if out-vatp_parts.purch-code = 2 then do:
     5460   assign
     5461     price-rubl-with-tax-loco = out-vatp_parts.price-rubl
     5462     price-base-with-tax-loco = out-vatp_parts.price-base
     5463   .
     5464   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     5465   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     5466     (output varinvprbo
     5467     )  .
     5468     if out-vatp_parts.out-code = 'free-zone':U     or
     5469        out-vatp_parts.out-code = 'out-zone':U   or
     5470        out-vatp_parts.doc-type = 'акт':U then do:
     5471       assign
     5472         in-vatp-have-vat-slto = yes.
     5473     end.
     5474     else do:
     5475       find first in-vatp_doc-attro no-lock
     5476         where in-vatp_doc-attro.doc-code  = out-vatp_parts.out-code
     5477           and in-vatp_doc-attro.attr-code = 'envd':U
     5478         no-error .
     5479       if not available in-vatp_doc-attro then do:
     5480         assign
     5481           in-vatp-have-vat-slto = yes.
     5482       end.
     5483       else do:
     5484            in-vatp-have-vat-slto = no.
     5485       end.
     5486     end.
     5487     assign
     5488      price-cli-with-tax-loco = out-vatp_parts.price-cli
     5489      cli-base-rateo          = out-vatp_parts.cli-base-rate.
     5490     ASSIGN   road-tax-base-loco  = (if out-vatp_parts.road-tax-base  = ? then 0 else out-vatp_parts.road-tax-base)
     5491              road-tax-rubl-loco  = (if out-vatp_parts.road-tax-rubl  = ? then 0 else out-vatp_parts.road-tax-rubl).
     5492     ASSIGN  transport-base-loco = (if out-vatp_parts.transport-base = ? then 0 else out-vatp_parts.transport-base)
     5493             transport-rubl-loco = (if out-vatp_parts.transport-rubl = ? then 0 else out-vatp_parts.transport-rubl)
     5494             other-base-loco     = (if out-vatp_parts.other-base     = ? then 0 else out-vatp_parts.other-base)
     5495             other-rubl-loco     = (if out-vatp_parts.other-rubl     = ? then 0 else out-vatp_parts.other-rubl)
     5496             vat-pc-loco         = (if out-vatp_parts.vat-pc         = ? then 0 else out-vatp_parts.vat-pc)
     5497             slt-pc-loco         = (if out-vatp_parts.slt-pc         = ? then 0 else out-vatp_parts.slt-pc).
     5498             ASSIGN   slt-base-loco    = (if in-vatp-have-vat-slto = no then 0 else (price-base-with-tax-loco - ((if road-tax-base-loco  = ? then 0 else road-tax-base-loco) + (if transport-base-loco = ? then 0 else transport-base-loco) + (if other-base-loco = ? then 0 else other-base-loco)))                           * slt-pc-loco / (100 + slt-pc-loco))                        vat-base-loco    = (if in-vatp-have-vat-slto = no then 0 else (price-base-with-tax-loco - ((if road-tax-base-loco  = ? then 0 else road-tax-base-loco) + (if transport-base-loco = ? then 0 else transport-base-loco) + (if other-base-loco = ? then 0 else other-base-loco))) * (1 - slt-pc-loco / (100 + slt-pc-loco)) * vat-pc-loco / (100 + vat-pc-loco)).
     5499       ASSIGN   slt-rubl-loco    = (if in-vatp-have-vat-slto = no then 0 else (price-rubl-with-tax-loco - ((if road-tax-rubl-loco  = ? then 0 else road-tax-rubl-loco) + (if transport-rubl-loco = ? then 0 else transport-rubl-loco) + (if other-rubl-loco = ? then 0 else other-rubl-loco)))                           * slt-pc-loco / (100 + slt-pc-loco))                        vat-rubl-loco    = (if in-vatp-have-vat-slto = no then 0 else (price-rubl-with-tax-loco - ((if road-tax-rubl-loco  = ? then 0 else road-tax-rubl-loco) + (if transport-rubl-loco = ? then 0 else transport-rubl-loco) + (if other-rubl-loco = ? then 0 else other-rubl-loco))) * (1 - slt-pc-loco / (100 + slt-pc-loco)) * vat-pc-loco / (100 + vat-pc-loco)).
     5500     assign
     5501       exch-rate-cli-loco = (out-vatp_parts.price-rubl - transport-rubl-loco - other-rubl-loco - road-tax-rubl-loco - (if out-vatp_parts.vat-type <> 'в т. ч.':U then vat-rubl-loco else 0) - (if out-vatp_parts.slt-type <> 'в т. ч.':U then slt-rubl-loco else 0)) / out-vatp_parts.price-cli .
     5502     assign
     5503       slt-cli-loco        = slt-rubl-loco       / exch-rate-cli-loco
     5504       vat-cli-loco        = vat-rubl-loco       / exch-rate-cli-loco
     5505       road-tax-cli-loco   = road-tax-rubl-loco  / exch-rate-cli-loco
     5506       transport-cli-loco  = 0
     5507       other-cli-loco      = 0
     5508     .
     5509   ASSIGN
     5510             price-base-without-tax-loco = price-base-with-tax-loco - vat-base-loco - slt-base-loco - ((if road-tax-base-loco  = ? then 0 else road-tax-base-loco) + (if transport-base-loco = ? then 0 else transport-base-loco) + (if other-base-loco = ? then 0 else other-base-loco))
     5511       price-rubl-without-tax-loco = price-rubl-with-tax-loco - vat-rubl-loco - slt-rubl-loco - ((if road-tax-rubl-loco  = ? then 0 else road-tax-rubl-loco) + (if transport-rubl-loco = ? then 0 else transport-rubl-loco) + (if other-rubl-loco = ? then 0 else other-rubl-loco))
     5512   .
     5513         assign
     5514           varprice-base-cons = varprice-base-cons + (price-base-with-tax-loco - (if road-tax-base-loco = ? then 0 else road-tax-base-loco))* out-vatp_parts.fact-qnty
     5515           varprice-rubl-cons = varprice-rubl-cons + (price-rubl-with-tax-loco - (if road-tax-rubl-loco = ? then 0 else road-tax-rubl-loco))* out-vatp_parts.fact-qnty.
     5516         assign
     5517           varis-cons-parts-have = yes
     5518           varcons-qnty          = varcons-qnty + out-vatp_parts.fact-qnty.
     5519       end.
     5520       assign
     5521         varfact-qnty = varfact-qnty + out-vatp_parts.fact-qnty.
     5522     end.
     5523   end.
     5524   assign
     5525     varprice-base-cons = varprice-base-cons / varcons-qnty
     5526     varprice-rubl-cons = varprice-rubl-cons / varcons-qnty.
     5527   if varprice-base-cons = ? then do:
     5528     assign
     5529       varprice-base-cons = 0.
     5530   end.
     5531   if varprice-rubl-cons = ? then do:
     5532     assign
     5533       varprice-rubl-cons = 0.
     5534   end.
     5535   assign
     5536       slt-base-sale               = (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-base - gds-dtl.discnt-base                - road-tax-base-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc)
     5537     vat-base-buyer              = (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-base - gds-dtl.discnt-base - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-base - gds-dtl.discnt-base                - road-tax-base-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - road-tax-base-sale) * doc-line.vat-pc / (100 + doc-line.vat-pc)
     5538     discnt-base-sale            = gds-dtl.discnt-base
     5539     price-base-with-tax-sale    = (gds-dtl.price-base - gds-dtl.discnt-base)
     5540       slt-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-rubl - gds-dtl.discnt-rubl                - road-tax-rubl-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc)
     5541     vat-rubl-buyer              = (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-rubl - gds-dtl.discnt-rubl - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-rubl - gds-dtl.discnt-rubl                - road-tax-rubl-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - road-tax-rubl-sale) * doc-line.vat-pc / (100 + doc-line.vat-pc)
     5542     discnt-rubl-sale            = gds-dtl.discnt-rubl
     5543     price-rubl-with-tax-sale    = (gds-dtl.price-rubl - gds-dtl.discnt-rubl)
     5544     .
     5545   if t-doc.doc-type = 'инв':U then do:
     5546     assign
     5547       varfact-qnty = gds-dtl.doc-qnty.
     5548   end.
     5549   else do:
     5550     assign
     5551       varfact-qnty = gds-dtl.fact-qnty.
     5552   end.
     5553   if varis-cons-parts-have = no then do:
     5554     assign
     5555           vat-base-sale               = (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-base - gds-dtl.discnt-base - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-base - gds-dtl.discnt-base                - road-tax-base-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - road-tax-base-sale) * doc-line.vat-pc / (100 + doc-line.vat-pc)
     5556           vat-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-rubl - gds-dtl.discnt-rubl - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-rubl - gds-dtl.discnt-rubl                - road-tax-rubl-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - road-tax-rubl-sale) * doc-line.vat-pc / (100 + doc-line.vat-pc).
     5557   end.
     5558   else do:
     5559     if t-doc.doc-type = 'инв':U then do:
     5560       assign
     5561               vat-base-sale               = (if out-vatp-have-vat-slt = no then 0 else (((gds-dtl.price-base - gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-base - gds-dtl.discnt-base                - road-tax-base-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - road-tax-base-sale - varprice-base-cons) * doc-line.cons-vat-pc / (100 + doc-line.cons-vat-pc) * gds-dtl.doc-qnty * varcons-qnty / varfact-qnty + ((gds-dtl.price-base - gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-base - gds-dtl.discnt-base                - road-tax-base-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - road-tax-base-sale) * doc-line.vat-pc / (100 + doc-line.vat-pc) * gds-dtl.doc-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     5562               vat-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else (((gds-dtl.price-rubl - gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-rubl - gds-dtl.discnt-rubl                - road-tax-rubl-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - road-tax-rubl-sale - varprice-rubl-cons) * doc-line.cons-vat-pc / (100 + doc-line.cons-vat-pc) * gds-dtl.doc-qnty * varcons-qnty / varfact-qnty + ((gds-dtl.price-rubl - gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-rubl - gds-dtl.discnt-rubl                - road-tax-rubl-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - road-tax-rubl-sale) * doc-line.vat-pc / (100 + doc-line.vat-pc) * gds-dtl.doc-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     5563        .
     5564     end.
     5565     else do:
     5566       assign
     5567               vat-base-sale               = (if out-vatp-have-vat-slt = no then 0 else (((gds-dtl.price-base - gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-base - gds-dtl.discnt-base                - road-tax-base-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - road-tax-base-sale - varprice-base-cons) * doc-line.cons-vat-pc / (100 + doc-line.cons-vat-pc) * gds-dtl.fact-qnty * varcons-qnty / varfact-qnty + ((gds-dtl.price-base - gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-base - gds-dtl.discnt-base                - road-tax-base-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - varprice-base-cons) * doc-line.vat-pc / (100 + doc-line.vat-pc) * gds-dtl.fact-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     5568               vat-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else (((gds-dtl.price-rubl - gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-rubl - gds-dtl.discnt-rubl                - road-tax-rubl-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - road-tax-rubl-sale - varprice-rubl-cons) * doc-line.cons-vat-pc / (100 + doc-line.cons-vat-pc) * gds-dtl.fact-qnty * varcons-qnty / varfact-qnty + ((gds-dtl.price-rubl - gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-rubl - gds-dtl.discnt-rubl                - road-tax-rubl-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - varprice-rubl-cons) * doc-line.vat-pc / (100 + doc-line.vat-pc) * gds-dtl.fact-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     5569        .
     5570     end.
     5571   end.
     5572   assign
     5573   price-base-without-tax-sale = price-base-with-tax-sale - vat-base-sale - slt-base-sale - road-tax-base-sale
     5574   price-rubl-without-tax-sale = price-rubl-with-tax-sale - vat-rubl-sale - slt-rubl-sale - road-tax-rubl-sale.
