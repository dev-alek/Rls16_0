     5439     varcons-qnty       = 0
     5440     varprice-base-cons = 0
     5441     varprice-rubl-cons = 0.
     5442   find first out-vatp_doc-line where
     5443              out-vatp_doc-line.doc-code   = t-doc.doc-code
     5444          and out-vatp_doc-line.artic      = doc-line.artic
     5445          and out-vatp_doc-line.prod-type  = doc-line.prod-type
     5446          and out-vatp_doc-line.prod-code  = doc-line.prod-code no-lock no-error.
     5447   if available out-vatp_doc-line           and
     5448     (out-vatp_doc-line.status_ = 'запрос':U or out-vatp_goods.gds-type = 'у':U) then do:
     5449     assign
