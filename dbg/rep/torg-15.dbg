     4979       excise-rubl-sale      = (if doc-line.excise   = ? then 0 else doc-line.excise   * t-doc.base-rate / t-doc.base-scale) .
     4980   end.
     4981   assign
     4982     varis-cons-parts-have =  no.
     4983   assign
     4984     varfact-qnty       = 0
     4985     varcons-qnty       = 0
     4986     varprice-base-cons = 0
     4987     varprice-rubl-cons = 0.
     4988   find first out-vatp_doc-line where
     4989              out-vatp_doc-line.doc-code   = t-doc.doc-code
     4990          and out-vatp_doc-line.artic      = doc-line.artic
     4991          and out-vatp_doc-line.prod-type  = doc-line.prod-type
     4992          and out-vatp_doc-line.prod-code  = doc-line.prod-code no-lock no-error.
     4993   if available out-vatp_doc-line           and
     4994     (out-vatp_doc-line.status_ = 'запрос':U or out-vatp_goods.gds-type = 'у':U) then do:
     4995     assign
