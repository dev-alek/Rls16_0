     1870           v-torgconf-cli-bank-exists  = v-fmtcli-bank-exists
     1871           v-torgconf-cli-bank-r-schet = v-fmtcli-bank-r-schet
     1872           v-torgconf-cli-bank-c-schet = v-fmtcli-bank-c-schet
     1873           v-torgconf-cli-bank-bik     = v-fmtcli-bank-bik
     1874           v-torgconf-cli-bank-name    = v-fmtcli-bank-name
     1875           v-torgconf-cli-bank-addres  = v-fmtcli-bank-addres
     1876           v-torgconf-cli-bank-city    = v-fmtcli-bank-city
     1877       .
     1878   end.
