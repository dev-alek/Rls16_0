     5098   end.
     5099   if varis-cons-parts-have = no then do:
     5100     assign
     5101           vat-base-sale               = (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-base - gds-dtl.discnt-base - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-base - gds-dtl.discnt-base                - road-tax-base-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - road-tax-base-sale) * doc-line.vat-pc / (100 + doc-line.vat-pc)
     5102           vat-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-rubl - gds-dtl.discnt-rubl - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-rubl - gds-dtl.discnt-rubl                - road-tax-rubl-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - road-tax-rubl-sale) * doc-line.vat-pc / (100 + doc-line.vat-pc).
     5103   end.
     5104   else do:
     5105     if t-doc.doc-type = 'инв':U then do:
     5106       assign
     5107               vat-base-sale               = (if out-vatp-have-vat-slt = no then 0 else (((gds-dtl.price-base - gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-base - gds-dtl.discnt-base                - road-tax-base-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - road-tax-base-sale - varprice-base-cons) * doc-line.cons-vat-pc / (100 + doc-line.cons-vat-pc) * gds-dtl.doc-qnty * varcons-qnty / varfact-qnty + ((gds-dtl.price-base - gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-base - gds-dtl.discnt-base                - road-tax-base-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - road-tax-base-sale) * doc-line.vat-pc / (100 + doc-line.vat-pc) * gds-dtl.doc-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     5108               vat-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else (((gds-dtl.price-rubl - gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-rubl - gds-dtl.discnt-rubl                - road-tax-rubl-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - road-tax-rubl-sale - varprice-rubl-cons) * doc-line.cons-vat-pc / (100 + doc-line.cons-vat-pc) * gds-dtl.doc-qnty * varcons-qnty / varfact-qnty + ((gds-dtl.price-rubl - gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-rubl - gds-dtl.discnt-rubl                - road-tax-rubl-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - road-tax-rubl-sale) * doc-line.vat-pc / (100 + doc-line.vat-pc) * gds-dtl.doc-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     5109        .
     5110     end.
     5111     else do:
     5112       assign
     5113               vat-base-sale               = (if out-vatp-have-vat-slt = no then 0 else (((gds-dtl.price-base - gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-base - gds-dtl.discnt-base                - road-tax-base-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - road-tax-base-sale - varprice-base-cons) * doc-line.cons-vat-pc / (100 + doc-line.cons-vat-pc) * gds-dtl.fact-qnty * varcons-qnty / varfact-qnty + ((gds-dtl.price-base - gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-base - gds-dtl.discnt-base                - road-tax-base-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - varprice-base-cons) * doc-line.vat-pc / (100 + doc-line.vat-pc) * gds-dtl.fact-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     5114               vat-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else (((gds-dtl.price-rubl - gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-rubl - gds-dtl.discnt-rubl                - road-tax-rubl-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - road-tax-rubl-sale - varprice-rubl-cons) * doc-line.cons-vat-pc / (100 + doc-line.cons-vat-pc) * gds-dtl.fact-qnty * varcons-qnty / varfact-qnty + ((gds-dtl.price-rubl - gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-rubl - gds-dtl.discnt-rubl                - road-tax-rubl-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - varprice-rubl-cons) * doc-line.vat-pc / (100 + doc-line.vat-pc) * gds-dtl.fact-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     5115        .
     5116     end.
     5117   end.
     5118   assign
     5119   price-base-without-tax-sale = price-base-with-tax-sale - vat-base-sale - slt-base-sale - road-tax-base-sale
     5120   price-rubl-without-tax-sale = price-rubl-with-tax-sale - vat-rubl-sale - slt-rubl-sale - road-tax-rubl-sale.
     5121                       assign
     5122                           price = ( if PrintRubl then price-rubl-with-tax-sale else price-base-with-tax-sale )
     5123                           price-Vat = ( if PrintRubl then vat-rubl-sale else vat-base-sale )
     5124                       .
     5125                       if first (gds-dtl.artic)
     5126                       then do:
     5127                           assign
     5128                               v-prices-are-different  = no
     5129                               v-old-price             = price
     5130                           .
     5131                       end.
     5132                       else do:
     5133                           if v-prices-are-different  = no
     5134                               and price <> v-old-price
     5135                           then do:
     5136                               assign
     5137                                   v-prices-are-different = yes
     5138                               .
     5139                           end.
     5140                           else do:
     5141                               assign
     5142                                   v-old-price             = price
     5143                               .
     5144                           end.
     5145                       end.
     5146                       if no-vat then do:
     5147                           assign
     5148                               price = price - price-Vat
     5149                           .
     5150                       end.
     5151                   end.
     5152                   assign
     5153                       prt-tqnty =  gds-dtl.fact-qnty
     5154                       prt-stoim = price * prt-tqnty
     5155                   .
     5156                   accumulate
     5157                       prt-tqnty (total)
     5158                       prt-stoim ( total )
     5159                   .
     5160                   if PrintScale = yes
     5161                   then do:
     5162                       find first bar-code no-lock
     5163                            where bar-code.gds-code = goods.gds-code
     5164                              and bar-code.unit-cli = goods.unit-base
     5165                              and bar-code.node-code = gds-dtl.prt-code
     5166                              and bar-code.part-code = ""
     5167                              and bar-code.in-code = ""
     5168                       .
     5169                       assign
     5170                           PrtName = ""
     5171                       .
     5172                       do while available gds-prt:
     5173                           if available gds-prt
     5174                           then do:
     5175                               assign
     5176                                   PrtName = "\" + string( gds-prt.node-name, "x(10)" ) + PrtName
     5177                                   PrtNameXL = "\" + gds-prt.node-name + PrtNameXl
     5178                               .
     5179                           end.
     5180                           assign
     5181                               Node_Code = gds-prt.upper-code
     5182                           .
     5183                           find first gds-prt no-lock
     5184                                   where gds-prt.node-code = Node_Code
     5185                                   and gds-prt.root <> yes
     5186                           no-error.
     5187                       end.
     5188                       if no-vat then do:
     5189                           put stream OutStr-html unformatted
     5190                             substitute (
     5191                             '<tr>
     5192                                   <td colspan="2" style="text-align: center;">&1</td>
     5193                                   <td style="text-align: center; border-left: 2px solid black; border-right: 2px solid black;">&2</td>
     5194                                   <td style="text-align: center;">&3</td>
     5195                                   <td style="text-align: center; border-left: 2px solid black;">&4</td>
     5196                                   <td style="text-align: center;">&5</td>
     5197                                   <td style="text-align: center;"></td>
     5198                                   <td colspan="2" style="text-align: center;">&6</td>
     5199                                   <td colspan="2" style="text-align: center;">&7</td>
     5200                                   <td style="text-align: center;">&8</td>
     5201                                   <td colspan="2" style="text-align: center;"></td>
