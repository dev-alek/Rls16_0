     4299        where recid( t-doc ) = rec_id
     4300   .
     4301   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4302   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     4303     (input  t-doc.obj-type
     4304     ,input  t-doc.obj-code
     4305     ,output v-host-code
     4306     )  .
     4307   run torgconf-read in this-procedure (
     4308         input "torg15"
     4309       , input v-host-code
     4310       , input t-doc.obj-type
     4311       , input t-doc.obj-code
     4312   ) no-error.
     4313   if error-status :error
     4314   then do:
     4315       message
     4316       vss-workfile vss-revision vss-description
     4317       skip "Ошибка чтения параметров печати формы."
     4318       skip "Форма будет напечатана с параметрами по умолчанию."
     4319       skip return-value
     4320       skip trim(error-status :get-message(1))
     4321           trim(error-status :get-message(2))
     4322           trim(error-status :get-message(3))
     4323       view-as alert-box error.
     4324   end.
     4325   if v-torgconf-outnum = yes
     4326   then do:
     4327       assign
     4328           tdoc-code = fill( " ", 10 )
     4329       .
     4330   end.
     4331   else do:
     4332       assign
     4333           tdoc-code = t-doc.doc-code
     4334       .
     4335   end.
     4336   if v-torgconf-outdate = yes
     4337   then do:
     4338       assign
     4339           v-doc-date-string = fill( " ", 10 )
     4340       .
     4341   end.
     4342   else do:
     4343       assign
     4344           v-doc-date-string = ( if t-doc.status_ <> 'факт':U
     4345                               then string( t-doc.doc-date,  "99/99/9999" )
     4346                               else string( t-doc.fact-date, "99/99/9999" )
     4347                               )
     4348       .
     4349   end.
     4350   find first OurObject no-lock
     4351        where OurObject.obj-type = t-doc.obj-type
     4352          and OurObject.obj-code = t-doc.obj-code
     4353   no-error.
     4354   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4355   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     4356     (input  t-doc.host-code
     4357     ,output v-base-code
     4358     )  .
     4359   find first currency no-lock
     4360        where currency.curr-code = v-base-code
     4361   no-error.
     4362   assign val-str = ( if PrintRubl then "рублях" else (if available currency then currency.curr-abbr else "?") ) .
     4363   find first clients no-lock
     4364        where clients.obj-type = 'орг':U
     4365          and clients.obj-code = t-doc.host-code
     4366   .
     4367       case clients.obj-type:
     4368          when 'орг':U
     4369          then do:
     4370               FIND ub.firm WHERE ub.firm.firm-code = clients.obj-code NO-LOCK .
     4371               if available ub.firm
     4372               then do:
     4373                   assign
     4374                       t-addres = ( if ub.firm.ind = 0 or ub.firm.ind = ? then "" else string( ub.firm.ind ) )
     4375                       t-addres = t-addres
     4376                           + ( if ub.firm.city = ? or trim(ub.firm.city) = ""
     4377                               then ""
     4378                               else ( (if t-addres = "" then "" else ", ") + trim( ub.firm.city ) )
     4379                             )
     4380                       t-temp-address = ( if ub.firm.addres1 = ? then "" else trim( substring( ub.firm.addres1, 1, 50 ) ) )
     4381                       t-addres = t-addres + ( if t-addres = "" or t-temp-address = "" then "" else ", " )
     4382                           + ( if t-temp-address = "" then "" else ( trim( t-temp-address ) ) )
     4383                           + ( if  ub.firm.addres2 = ? or trim(ub.firm.addres2) = "" then "" else ( ", " + trim( ub.firm.addres2 ) ) )
     4384                       t-temp-address = ( if ub.firm.addres1 = ? then "" else trim( substring( ub.firm.addres1, 51, 50 ) ) )
     4385                       t-addres = t-addres + ( if t-addres = "" or t-temp-address = "" then "" else ", " )
     4386                           + ( if t-temp-address = "" then "" else ( trim( t-temp-address ) ) )
     4387                       t-temp-address = ( if ub.firm.addres1 = ? then "" else trim( substring( ub.firm.addres1, 101, 50 ) ) )
     4388                       t-addres = t-addres + ( if t-addres = "" or t-temp-address = "" then "" else ", " )
     4389                           + ( if t-temp-address = "" then "" else ( trim( t-temp-address ) ) )
     4390                       t-phone = ub.firm.phone
     4391                       t-inn   = ub.firm.inn
     4392                       t-okpo  = ub.firm.okpo
     4393                   .
     4394               end.
     4395          end.
     4396          when 'маг':U
     4397          then do:
     4398               FIND ub.shop WHERE ub.shop.obj-code = clients.obj-code NO-LOCK .
     4399               if available ub.shop
     4400               then do:
     4401                   assign
     4402                       t-addres = ( if trim( shop.addres1 ) <> "" then ( trim( shop.addres1 ) ) else "" )
     4403                               + ( if trim( shop.addres2 ) <> "" then ( ", " + trim( shop.addres2 ) ) else "" )
     4404                       t-phone = shop.phone
     4405                       t-inn = ""
     4406                       t-okpo = ""
     4407                   .
     4408               end.
     4409          end.
     4410          when 'скл':U
     4411          then do:
     4412               FIND ub.store WHERE ub.store.obj-code = clients.obj-code NO-LOCK .
     4413               if available ub.store
     4414               then do:
     4415                   assign
     4416                       t-addres = ( if trim( ub.store.addres1 ) <> "" then ( trim( ub.store.addres1 ) ) else "" )
     4417                               + ( if trim( ub.store.addres2 ) <> "" then ( ", " + trim( ub.store.addres2 ) ) else "" )
     4418                       t-phone = ub.store.phone
     4419                       t-inn = ""
     4420                       t-okpo = ""
     4421                   .
     4422               end.
     4423          end.
     4424          when 'чел':U
     4425          then do:
     4426               find ub.person where ub.person.psn-code = clients.obj-code no-lock .
     4427               if available ub.person
     4428               then do:
     4429                   assign
     4430                       t-addres = ( if ub.person.ind <> 0 and ub.person.ind <> ? then string( ub.person.ind ) else "" )
     4431                                   + ( if  ub.person.city <> ? and trim(ub.person.city) <> "" then ( ", " + trim( ub.person.city ) ) else "" )
     4432                                   + ( if  ub.person.address <> ? and trim(ub.person.address) <> "" then ( ", " + trim( ub.person.address ) ) else "" )
     4433                       t-phone = ub.person.phone1
     4434                       t-inn = ub.person.inn
     4435                       t-okpo = ub.person.okpo
     4436                   .
     4437               end.
     4438          end.
     4439       end case.
     4440   find first b-trn-doc no-lock
     4441        where b-trn-doc.doc-code = t-doc.doc-code no-error.
     4442           if available b-trn-doc then do:
     4443               assign
