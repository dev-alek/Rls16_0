     4208   def var vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4209   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
     4210   procedure paramls-clear :
     4211     define buffer buf_temp-param for temp-param .
     4212     do
     4213     on error undo, return error return-value
     4214     :
     4215       for each buf_temp-param
     4216       on error undo, return error
     4217       :
     4218         delete buf_temp-param .
     4219       end.
     4220     end.
     4221   end procedure.
     4222   procedure paramls-write :
     4223     define input  parameter p-code     as character no-undo .
     4224     define input  parameter p-sub-code as character no-undo .
     4225     define input  parameter p-value    as character no-undo .
     4226     define buffer buf_temp-param for temp-param .
     4227     do
     4228     on error undo, return error return-value
     4229     :
     4230       find first buf_temp-param
     4231         where buf_temp-param.param-code     = p-code
     4232           and buf_temp-param.param-sub-code = p-sub-code
     4233         no-error .
     4234       if not available buf_temp-param then do:
     4235         create buf_temp-param .
     4236         assign
     4237           buf_temp-param.param-code     = p-code
     4238           buf_temp-param.param-sub-code = p-sub-code
     4239         .
     4240       end.
     4241       assign
     4242         buf_temp-param.param-value = p-value
     4243       .
     4244     end.
     4245   end procedure.
     4246   procedure paramls-read :
     4247     define input  parameter p-code          as character no-undo .
     4248     define input  parameter p-sub-code      as character no-undo .
     4249     define input  parameter p-default-value as character no-undo .
     4250     define output parameter p-value         as character no-undo .
     4251     define buffer buf_temp-param for temp-param .
     4252     do
     4253     on error undo, return error return-value
     4254     :
     4255       find first buf_temp-param
     4256         where buf_temp-param.param-code     = p-code
     4257           and buf_temp-param.param-sub-code = p-sub-code
     4258         no-error .
     4259       if available buf_temp-param then do:
     4260         assign
     4261           p-value = buf_temp-param.param-value
     4262         .
     4263       end.
     4264       else do:
     4265         assign
     4266           p-value = p-default-value
     4267         .
     4268       end.
     4269     end.
     4270   end procedure.
     4271   procedure paramls-append :
     4272     define input  parameter p-code     as character no-undo .
     4273     define input  parameter p-sub-code as character no-undo .
     4274     define input  parameter p-value    as character no-undo .
     4275     define buffer buf_temp-param for temp-param .
     4276     do
     4277     on error undo, return error return-value
     4278     :
     4279       find first buf_temp-param
     4280            where buf_temp-param.param-code     = p-code
     4281              and buf_temp-param.param-sub-code = p-sub-code
     4282         no-error .
     4283       if not available buf_temp-param then do:
     4284         create buf_temp-param .
     4285         assign
     4286           buf_temp-param.param-code     = p-code
     4287           buf_temp-param.param-sub-code = p-sub-code
     4288           buf_temp-param.param-value    = p-value
     4289         .
     4290       end.
     4291       else do:
     4292           assign
     4293               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
     4294           .
     4295       end.
     4296     end.
     4297   end procedure.
