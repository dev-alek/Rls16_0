     1740   procedure torgconf-get-sup-param :
     1741   define input parameter p-obj-type           as character        no-undo.
     1742   define input parameter p-obj-code           as integer          no-undo.
     1743   define input parameter p-curr-code          as integer          no-undo.
     1744       define variable v-host-code    as integer      no-undo.
     1745       define variable v-par-type     as character    no-undo.
     1746   do
     1747   on error undo, return error
     1748   :
     1749       assign
     1750          v-torgconf-sup-host-code = v-host-code
     1751       .
     1752       if v-torgconf-sup-host-code = 0
     1753       then do:
     1754           assign
     1755               v-torgconf-sup-host-name           = "":U
     1756               v-torgconf-sup-host-addres         = "":U
     1757               v-torgconf-sup-host-post-addres    = "":U
     1758               v-torgconf-sup-host-phone          = "":U
     1759               v-torgconf-sup-host-inn            = "":U
     1760               v-torgconf-sup-host-kpp            = "":U
     1761               v-torgconf-sup-host-okpo           = "":U
     1762               v-torgconf-sup-host-egrip-date     = "":U
     1763               v-torgconf-sup-host-egrip-num      = "":U
     1764           .
     1765       end.
     1766       else do:
     1767           run fmtcli-get-client in this-procedure (
     1768                 input 'орг':U
     1769               , input v-torgconf-sup-host-code
     1770           ).
     1771           assign
     1772               v-torgconf-sup-host-name        = v-fmtcli-name
     1773               v-torgconf-sup-host-engl-name   = v-fmtcli-engl-name
     1774               v-torgconf-sup-host-addres      = v-fmtcli-full-addres
     1775               v-torgconf-sup-host-post-addres = v-fmtcli-post-addres
     1776               v-torgconf-sup-host-phone       = v-fmtcli-phone
     1777               v-torgconf-sup-host-inn         = v-fmtcli-inn
     1778               v-torgconf-sup-host-kpp         = v-fmtcli-kpp
     1779               v-torgconf-sup-host-okpo        = v-fmtcli-okpo
     1780           .
     1781           run gbl/clntat-v.p (
     1782                 input 'орг':U
     1783               , input v-torgconf-sup-host-code
     1784               , input 'egrip-date':U
     1785               , output v-torgconf-sup-host-egrip-date
     1786               , output v-par-type
     1787           ).
     1788           run gbl/clntat-v.p (
     1789                 input 'орг':U
     1790               , input v-torgconf-sup-host-code
     1791               , input 'egrip-num':U
     1792               , output v-torgconf-sup-host-egrip-num
     1793               , output v-par-type
     1794           ).
     1795           run fmtcli-get-bank in this-procedure (
     1796                 input v-host-code
     1797               , input 'орг':U
     1798               , input v-torgconf-sup-host-code
     1799               , input p-curr-code
     1800           ).
     1801       end.
     1802       assign
     1803           v-torgconf-sup-schet-exists = v-fmtcli-schet-exists
     1804           v-torgconf-sup-bank-exists  = v-fmtcli-bank-exists
     1805           v-torgconf-sup-bank-r-schet = v-fmtcli-bank-r-schet
     1806           v-torgconf-sup-bank-c-schet = v-fmtcli-bank-c-schet
     1807           v-torgconf-sup-bank-bik     = v-fmtcli-bank-bik
     1808           v-torgconf-sup-bank-name    = v-fmtcli-bank-name
     1809           v-torgconf-sup-bank-addres  = v-fmtcli-bank-addres
     1810           v-torgconf-sup-bank-city    = v-fmtcli-bank-city
     1811       .
     1812       assign
     1813           v-torgconf-sup-obj-type = p-obj-type
     1814           v-torgconf-sup-obj-code = p-obj-code
     1815       .
     1816       if trim(p-obj-type) <> ""
     1817       and p-obj-code <> 0
     1818       then do:
     1819       run fmtcli-get-client in this-procedure (
     1820             input p-obj-type
     1821           , input p-obj-code
     1822       ).
     1823       assign
     1824           v-torgconf-sup-obj-name        = v-fmtcli-name
     1825           v-torgconf-sup-obj-engl-name   = v-fmtcli-engl-name
     1826           v-torgconf-sup-obj-addres      = v-fmtcli-full-addres
     1827           v-torgconf-temp-post-addres    = v-fmtcli-post-addres
     1828           v-torgconf-sup-obj-phone       = v-fmtcli-phone
     1829           v-torgconf-sup-obj-inn         = v-fmtcli-inn
     1830           v-torgconf-sup-obj-okpo        = v-fmtcli-okpo
     1831       .
     1832      end.
     1833      end.
     1834   end procedure.
     1835   procedure torgconf-get-cli-param :
     1836   define input parameter p-host-obj-code      as integer          no-undo.
     1837   define input parameter p-obj-type           as character        no-undo.
