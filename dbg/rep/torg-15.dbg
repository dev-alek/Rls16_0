     6027   output stream OutStr-html close.
     6028       run prn-lib-reportviewer in this-procedure (
     6029           input p-mainmenu-handle
     6030           ,input v-report-name-html
     6031           ,input ""
     6032           ) no-error.
     6033       if error-status:error then
     6034       do:
     6035           message return-value view-as alert-box.
     6036           return .
     6037       end.
     6038   end.
     6039   procedure get-okei :
     6040   define input parameter p-unit-base as character        no-undo.
     6041   define output parameter p-okei as character        no-undo.
     6042       define buffer buf_units         for units.
     6043   do
     6044   for buf_units
     6045   on error undo, return error
     6046   :
     6047       find first buf_units no-lock
     6048            where buf_units.unit-name = p-unit-base
     6049       no-error.
     6050       if available buf_units
     6051       and buf_units.OKEI <> 0
     6052       then do:
     6053           assign
     6054               p-okei = string( buf_units.OKEI, ">999":U )
     6055           .
     6056       end.
     6057       else do:
     6058           assign
     6059               p-okei = "":U
     6060           .
     6061       end.
     6062   end.
     6063   end procedure.
