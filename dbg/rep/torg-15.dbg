        1   block-level on error undo, throw.
        2   do
        3   on error undo, return error
        4   :
        5   define input parameter p-mainmenu-handle    as handle           no-undo.
        6   define input parameter rec_id               as recid            no-undo.
        7   define variable vss-revision    as character no-undo init "$Revision: 992a74a9441b, 3581, rls $":U .
        8   define variable vss-author      as character no-undo init "$Author: VSpiridonov $":U .
        9   define variable vss-date        as character no-undo init "$Date: 2023/12/14 13:36:13 $":U .
       10   define variable vss-workfile    as character no-undo init "$Workfile: torg-15.p $":U .
       11   define variable vss-archive     as character no-undo init "$Archive: rep/torg-15.p $":U .
