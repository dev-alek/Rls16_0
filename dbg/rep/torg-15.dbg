     5410   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     5411     (output varoutvprb
     5412     )  .
     5413   if varoutvprb = "base":u then do:
     5414     assign
     5415           road-tax-base-sale    =  (if doc-line.road-tax = ? then 0 else doc-line.road-tax * 1)
     5416       excise-base-sale      =  (if doc-line.excise   = ? then 0 else doc-line.excise   * 1)
     5417     .
     5418   end.
     5419   else do:
     5420     assign
     5421           road-tax-base-sale    =  (if doc-line.road-tax = ? then 0 else doc-line.road-tax / t-doc.base-rate * t-doc.base-scale)
     5422       excise-base-sale      =  (if doc-line.excise   = ? then 0 else doc-line.excise   / t-doc.base-rate * t-doc.base-scale)
     5423     .
     5424   end.
     5425   if varoutvprb = "rubl":u then do:
     5426     assign
     5427           road-tax-rubl-sale    = (if doc-line.road-tax = ? then 0 else doc-line.road-tax * 1)
     5428       excise-rubl-sale      = (if doc-line.excise   = ? then 0 else doc-line.excise   * 1) .
     5429   end.
     5430   else do:
     5431     assign
     5432           road-tax-rubl-sale    = (if doc-line.road-tax = ? then 0 else doc-line.road-tax * t-doc.base-rate / t-doc.base-scale)
     5433       excise-rubl-sale      = (if doc-line.excise   = ? then 0 else doc-line.excise   * t-doc.base-rate / t-doc.base-scale) .
     5434   end.
     5435   assign
     5436     varis-cons-parts-have =  no.
     5437   assign
