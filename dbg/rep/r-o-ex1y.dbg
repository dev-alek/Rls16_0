     3017   PROCEDURE CalcItog :
     3018       run ostatok (
     3019           input x-store-code  ,
     3020           input x-store-type  , x-TOG-Shift,
     3021           input x-date-start - 1 ,
     3022           input date('')      ,  x-Shift-Start,x-Shift-End,
     3023           input 'crsa':U   ,
     3024           input '##,##':U,
     3025           input xTog-obj ,
     3026           output  Quantity1  ,
     3027           output  Coast_R1   ,
     3028           output  Coast_V1   ,
     3029           output  VAT_R1     ,
     3030           output  VAT_V1     ,
     3031           output  Fact-order-1 ).
     3032       run ostatok (
     3033           input x-store-code  ,
     3034           input x-store-type  , x-TOG-Shift,
     3035           input x-date-start  ,
     3036           input x-date-end    , x-Shift-Start,x-Shift-End,
     3037           input 'crsa':U   ,
     3038           input '##,##':U,
     3039           input xTog-obj ,
     3040           output  Quantity1  ,
     3041           output  Coast_R1   ,
     3042           output  Coast_V1   ,
     3043           output  VAT_R1     ,
     3044           output  VAT_V1     ,
     3045           output  Fact-order-2 ).
     3046             Quantity1  = 0.
     3047             Coast_R1   = 0.
     3048             Coast_V1   = 0.
     3049             VAT_R1     = 0.
     3050             VAT_V1     = 0.
     3051   END PROCEDURE.
     3052   PROCEDURE display-str1  :
     3053   define variable jjj as integer no-undo init 0.
     3054   if show-cost and show-sale then
     3055      assign
     3056         eff[1] = Summ[3]  - Summ[1]
     3057         eff[3] = if Summ[1] <> 0 then ((Summ[3]  - Summ[1]) * 100 / Summ[1] )  else 0
     3058       .
     3059              if show-cost then DO:  Run di (1,"учет", 1, gds-zap-b-code,gds-zap-artic,gds-zap-gds-name,gds-zap-unit-base,"").  jjj = jjj + 1. End.
     3060              if show-crsa then DO:
     3061                if jjj = 0
     3062                   then   Run di (2,"прод", 1, gds-zap-b-code,gds-zap-artic,gds-zap-gds-name,gds-zap-unit-base,"").
     3063                   Else   Run di (2,"прод", 1, "","","","","").
     3064                  jjj = jjj + 1. End.
     3065              if show-sale then DO:  if jjj = 0
     3066                 then Run di (3,"док.", 1, gds-zap-b-code,gds-zap-artic,gds-zap-gds-name,gds-zap-unit-base,"").
     3067                 Else Run di (3,"док.", 1, "","","","","").
     3068                 jjj = jjj + 1. End.
     3069   END PROCEDURE.
     3070   PROCEDURE display-Bi  :
     3071   if show-cost and show-sale then
     3072      assign
     3073         bi-eff[1] = bi-Summ [3]  - bi-Summ  [1]
     3074         bi-eff[3] = if bi-Summ  [1] <> 0 then ((bi-Summ [3]  - bi-Summ  [1]) * 100 / bi-Summ  [1] )
     3075                                   else 0
     3076       .
     3077              if show-cost then run di(1,"учет",1,  "", gds-zap-artic ,"" ,"", "BI":U).
     3078              if show-crsa then run di(2,"прод",1,  "", gds-zap-artic ,"" ,"", "BI":U).
     3079              if show-sale then run di(3,"док.",1,  "", gds-zap-artic ,"" ,"", "BI":U).
     3080   END PROCEDURE.
     3081   PROCEDURE display-B1  :
     3082   IF  NOT (NOT Show-Negativ  AND
     3083    (
     3084   b1-qnty     [1]    = 0 and  b1-qnty     [2]    = 0 and b1-qnty     [3]    = 0  and
     3085   b1-Summ     [1]    = 0 and  b1-Summ     [2]    = 0 and  b1-Summ     [3]    = 0 and
     3086   b1-Vat      [1]    = 0 and  b1-Vat      [2]    = 0 and  b1-Vat      [3]    = 0 and
     3087   b1-excise   [1]    = 0 and  b1-excise   [2]    = 0 and  b1-excise   [3]    = 0 and
     3088   b1-road-tax [1]    = 0 and  b1-road-tax [2]    = 0 and  b1-road-tax [3]    = 0 and
     3089   b1-transport[1]    = 0 and  b1-transport[2]    = 0 and  b1-transport[3]    = 0 and
     3090   b1-Other    [1]    = 0 and  b1-Other    [2]    = 0 and  b1-Other    [3]    = 0 )) Then DO:
     3091     if Sums-Only THEN do:
     3092         if fr0 = true then do:
     3093             PUT stream  OutStream  tmp#stroka0 format "X(100)" SKIP.
     3094             if Make-Excel then  put   stream ForExcel unformatted String(tmp#stroka0) skip.
     3095             fr0 = false .
     3096           end.
     3097       end.
     3098       assign
     3099        gds-zap-artic = "Итого"
     3100        gds-zap-gds-name = temp-str
     3101       .
     3102           if show-cost and show-sale then
     3103             assign
     3104                 b1-eff[1] = b1-Summ [3]  - b1-Summ  [1]
     3105                 b1-eff[3] = if b1-Summ  [1] <> 0 then ((b1-Summ [3]  - b1-Summ  [1]) * 100 / b1-Summ  [1] )
     3106                                           else 0
     3107               .
     3108            if show-cost then  Run di(1,"учет"  ,1, "", gds-zap-artic, gds-zap-gds-name ,"","B1":U).
     3109            if show-crsa then  Run di(2,"прод"  ,1, "", gds-zap-artic, gds-zap-gds-name ,"","B1":U).
     3110            if show-sale then  Run di(3,"док."  ,1, "", gds-zap-artic, gds-zap-gds-name ,"","B1":U).
     3111     Run u-line.
     3112     End.
     3113   END PROCEDURE.
     3114   PROCEDURE display-B2  :
     3115   IF  NOT (NOT Show-Negativ  AND
     3116     ( b2-qnty     [1]    = 0 and  b2-qnty     [2]    = 0 and  b2-qnty     [3]    = 0 and
     3117       b2-Summ     [1]    = 0 and  b2-Summ     [2]    = 0 and  b2-Summ     [3]    = 0 and
     3118       b2-Vat      [1]    = 0 and  b2-Vat      [2]    = 0 and  b2-Vat      [3]    = 0 and
     3119       b2-excise   [1]    = 0 and  b2-excise   [2]    = 0 and  b2-excise   [3]    = 0 and
     3120       b2-road-tax [1]    = 0 and  b2-road-tax [2]    = 0 and  b2-road-tax [3]    = 0 and
     3121       b2-transport[1]    = 0 and  b2-transport[2]    = 0 and  b2-transport[3]    = 0 and
     3122       b2-Other    [1]    = 0 and  b2-Other    [2]    = 0 and  b2-Other    [3]    = 0 ) )Then dO:
     3123       assign
     3124        gds-zap-artic = ""
     3125        gds-zap-gds-name = tmp#stroka0
     3126       .
     3127           if show-cost and show-sale then
     3128           assign
     3129               b2-eff[1] = b2-Summ [3]  - b2-Summ  [1]
     3130               b2-eff[3] = if b2-Summ  [1] <> 0 then ((b2-Summ [3]  - b2-Summ  [1]) * 100 / b2-Summ  [1] )
     3131                                         else 0
     3132             .
     3133          if show-cost then  Run di (1, "учет", 1 ,"Итого",gds-zap-artic, gds-zap-gds-name,"", "B2":U).
     3134          if show-crsa then  Run di (2, "прод", 1 ,"Итого",gds-zap-artic, gds-zap-gds-name,"", "B2":U).
     3135          if show-sale then  Run di (3, "док.", 1 ,"Итого",gds-zap-artic, gds-zap-gds-name,"", "B2":U).
     3136          Run u-line.
     3137   end.
     3138   END PROCEDURE.
     3139   PROCEDURE Clear--B1  :
