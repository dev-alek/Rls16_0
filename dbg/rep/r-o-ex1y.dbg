     3175   PROCEDURE Display-title :
     3176      PUT stream  OutStream  UNFORMATTED  string( v-cntxt-host-name-obj +  " , " + x-store-type  +  " " + ObjName) AT 50 format "X(85)" SKIP(2)
     3177             REPORTNAME  AT 20 format "X(170)" SKIP
     3178             Trim(str1)  AT 35 format "X(75)" SKIP.
     3179        Repeat i = 1 to NUM-ENTRIES(str2,chr(10)) :
     3180         PUT stream  OutStream  UNFORMATTED  Entry(i,str2,chr(10))  AT 1 format "X(170)" SKIP.
     3181        End.
     3182       i=0.
     3183        Repeat i = 1 to NUM-ENTRIES(str3,chr(10)) :
     3184         PUT stream  OutStream  UNFORMATTED  Entry(i,str3,chr(10))  AT 1 format "X(170)" SKIP.
     3185        End.
     3186       i=0.
     3187        Repeat i = 1 to NUM-ENTRIES(str4,chr(10)) :
     3188         PUT stream  OutStream  UNFORMATTED  Entry(i,str4,chr(10))  AT 1 format "X(170)" SKIP.
     3189        End.
     3190       i=0.
     3191        Repeat i = 1 to NUM-ENTRIES(ReportHeader,chr(10)) :
     3192         PUT stream  OutStream  UNFORMATTED  Entry(i,ReportHeader,chr(10))  AT 1 format "X(170)" SKIP.
     3193        End.
     3194       i=0.
     3195   END PROCEDURE.
     3196   PROCEDURE ob-line  :
     3197   define input  parameter x-store-code     like ub.clients.obj-code     no-undo.
     3198   define input  parameter x-store-type     like ub.clients.obj-type     no-undo.
     3199   define INPUT  parameter x-artic          like ub.ot-line.artic        no-undo.
     3200   define INPUT  parameter x-prod-code      like ub.ot-line.prod-code    no-undo.
     3201   define INPUT  parameter x-prod-type      like ub.ot-line.prod-type    no-undo.
     3202   define INPUT  parameter x-Fact-order-1   like ub.ot-line.Fact-order   no-undo.
     3203   define INPUT  parameter x-Fact-order-2   like ub.ot-line.Fact-order   no-undo.
     3204   define input  parameter x-sum-type       like ub.ot-line.sum-type     no-undo.
     3205   define input  parameter x-cat-id         like ub.ot-line.cat-id       no-undo.
     3206   define input  parameter x-ext-doc-type   like ub.ot-line.ext-doc-type no-undo.
     3207   define input  parameter xTog-obj         as   log                  no-undo.
     3208   define variable  tt#          as   int                 no-undo.
     3209    if x-sum-type = 'cost':U  OR x-sum-type = 'cssr':U  then tt# = 1.
     3210     if x-sum-type = 'crsa':U  OR x-sum-type = 'cgsr':U  then tt# = 2.
     3211     if x-sum-type = 'sale':U  OR x-sum-type = 'sasr':U  then tt# = 3.
     3212     For EAch obj-list no-lock:
     3213      if  xTog-obj THEN
     3214          if   NOT(    x-store-type     = obj-list.obj-type
     3215               AND    x-store-code      = obj-list.obj-code ) Then NEXT.
     3216        IF x-ext-doc-type = 'rs':U + ',' + 'es':U  Then DO:
     3217          FOR each ub.ot-line where
     3218                           ub.ot-line.artic         = x-artic
     3219                     AND   ub.ot-line.fact-order   <= x-fact-order-2
     3220                     AND   ub.ot-line.fact-order   >= x-fact-order-1
     3221                     AND   ub.ot-line.obj-code     = obj-list.obj-code
     3222                     AND   ub.ot-line.obj-type     = obj-list.obj-type
     3223                     AND   ub.ot-line.prod-code    = x-prod-code
     3224                     AND   ub.ot-line.prod-type    = x-prod-type
     3225                     AND   ub.ot-line.sum-type     = x-sum-type
     3226                     And   (ot-line.ext-doc-type = 'rs':U
     3227                            OR ub.ot-line.ext-doc-type = 'es':U)
     3228                       no-lock :
     3229              If tPrintRubl = yes Then
     3230              ASSIGN qnty       [tt#]     = qnty     [tt#]        +  ub.ot-line.fact-qnty
     3231                     Summ     [tt#]     = Summ      [tt#]      +  ub.ot-line.sum-rubl
     3232                     Vat      [tt#]     = Vat       [tt#]      +  ub.ot-line.VAT-rubl
     3233                     excise   [tt#]     = excise    [tt#]      +  ub.ot-line.excise-rubl
     3234                     road-tax [tt#]     = road-tax  [tt#]      +  ub.ot-line.road-tax-rubl
     3235                     transport[tt#]     = transport [tt#]      +  ub.ot-line.transport-rubl
     3236                     Other    [tt#]     = Other     [tt#]      +  ub.ot-line.Other-rubl           .
     3237              Else
     3238              ASSIGN qnty       [tt#]     = qnty       [tt#]      +  ub.ot-line.fact-qnty
     3239                     Summ      [tt#]     = Summ        [tt#]    +  ub.ot-line.sum-base
     3240                     Vat       [tt#]     = Vat         [tt#]    +  ub.ot-line.VAT-base
     3241                     excise    [tt#]     = excise      [tt#]    +  ub.ot-line.excise-base
     3242                     road-tax  [tt#]     = road-tax    [tt#]    +  ub.ot-line.road-tax-base
     3243                     transport [tt#]     = transport   [tt#]    +  ub.ot-line.transport-base
     3244                     Other     [tt#]     = Other       [tt#]    +  ub.ot-line.Other-base           .
     3245           End.
     3246        End.
     3247        Else DO:
     3248          FOR each ub.ot-line where
     3249                           ub.ot-line.artic         = x-artic
     3250                     AND   ub.ot-line.fact-order   <= x-fact-order-2
     3251                     AND   ub.ot-line.fact-order   >= x-fact-order-1
     3252                     AND   ub.ot-line.obj-code     = obj-list.obj-code
     3253                     AND   ub.ot-line.obj-type     = obj-list.obj-type
     3254                     AND   ub.ot-line.prod-code    = x-prod-code
     3255                     AND   ub.ot-line.prod-type    = x-prod-type
     3256                     AND   ub.ot-line.sum-type     = x-sum-type
     3257                     And   ub.ot-line.ext-doc-type = x-ext-doc-type
     3258                       no-lock :
     3259              If tPrintRubl = yes Then
     3260              ASSIGN qnty  [tt#]          = qnty    [tt#]         +  ub.ot-line.fact-qnty
     3261                     Summ       [tt#]    = Summ       [tt#]     +  ub.ot-line.sum-rubl
     3262                     Vat        [tt#]    = Vat        [tt#]     +  ub.ot-line.VAT-rubl
     3263                     excise     [tt#]    = excise     [tt#]     +  ub.ot-line.excise-rubl
     3264                     road-tax   [tt#]    = road-tax   [tt#]     +  ub.ot-line.road-tax-rubl
     3265                     transport  [tt#]    = transport  [tt#]     +  ub.ot-line.transport-rubl
     3266                     Other      [tt#]    = Other      [tt#]     +  ub.ot-line.Other-rubl           .
     3267              Else
     3268              ASSIGN qnty    [tt#]        = qnty     [tt#]        +  ub.ot-line.fact-qnty
     3269                     Summ       [tt#]    = Summ        [tt#]    +  ub.ot-line.sum-base
     3270                     Vat        [tt#]    = Vat         [tt#]    +  ub.ot-line.VAT-base
     3271                     excise     [tt#]    = excise      [tt#]    +  ub.ot-line.excise-base
     3272                     road-tax   [tt#]    = road-tax    [tt#]    +  ub.ot-line.road-tax-base
     3273                     transport  [tt#]    = transport   [tt#]    +  ub.ot-line.transport-base
     3274                     Other      [tt#]    = Other       [tt#]    +  ub.ot-line.Other-base           .
     3275           End.
     3276         End.
     3277     END.
     3278   END PROCEDURE.
     3279   PROCEDURE ostatok :
     3280   def input parameter x-store-code  like ub.clients.obj-code    no-undo.
     3281   def input parameter x-store-type  like ub.clients.obj-type    no-undo.
     3282   def input parameter x-tog-shift   as   logical             no-undo.
     3283   def input parameter x-date-start  like ub.stk-tot.Fact-date   no-undo.
     3284   def input parameter x-date-end    like ub.stk-tot.Fact-date   no-undo.
     3285   def input parameter x-shift-start as integer               no-undo.
     3286   def input parameter x-shift-end   as integer               no-undo.
     3287   def input parameter x-sum-type    like ub.stk-tot.sum-type    no-undo.
     3288   def input parameter x-cat-id      like ub.stk-tot.cat-id      no-undo.
     3289   def input parameter xTog-obj   as log no-undo.
     3290   def output parameter Quantity    like ub.stk-tot.fact-qnty   no-undo.
     3291   def output parameter Coast_R     like ub.stk-tot.sum-rubl    no-undo.
     3292   def output parameter Coast_V     like ub.stk-tot.sum-rubl    no-undo.
     3293   def output parameter VAT_R       like ub.stk-tot.sum-rubl    no-undo.
     3294   def output parameter VAT_V       like ub.stk-tot.sum-rubl    no-undo.
     3295   def output parameter Fact-order  like ub.stk-tot.Fact-order  no-undo.
     3296   def var              Fact-order#   like ub.stk-tot.Fact-order  no-undo.
     3297   def var              Fact-orderS   as char  no-undo.
     3298   def var x-date-start-t  like ub.stk-tot.shift-date   no-undo.
     3299      Assign
     3300         Fact-order   = 0
     3301         Quantity     = 0
     3302         Coast_R      = 0
     3303         Coast_V      = 0
     3304         VAT_R        = 0
     3305         VAT_V        = 0 .
     3306    x-date-start-t  = x-date-start + 1 .
     3307   IF x-date-end = date('') then DO:
     3308      Fact-order = 0 .
     3309      for each obj-list
     3310          where  ( not xtog-obj or
     3311                 ( x-store-type = obj-list.obj-type and x-store-code = obj-list.obj-code ))
     3312                 no-lock :
     3313         if  x-tog-shift = false then do:
     3314                          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     3315                               ub.stk-tot.Fact-date <=  x-date-start
     3316                               and ub.stk-tot.shift-num = 0
     3317                               USE-INDEX fact-date no-lock no-error .
     3318              if Available ub.stk-tot THEN  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     3319         End.
     3320         Else  DO :
     3321             find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     3322              (ub.stk-tot.shift-date  = x-date-start-t and
     3323               ub.stk-tot.shift-num  < x-shift-start or
     3324               ub.stk-tot.shift-date  < x-date-start-t  )
     3325               and ub.stk-tot.shift-num  > 0
     3326               USE-INDEX Shift-num no-lock no-error .
     3327            If Available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     3328           END.
     3329       If Fact-order < Fact-order#  and Fact-order# <> 0  THEN  Fact-order = Fact-order# .
     3330     End.
     3331   End.
     3332   Else DO:
     3333     For each obj-list  WHERE
     3334        (NOT xTog-obj OR (x-store-type = obj-list.obj-type AND x-store-code = obj-list.obj-code))
     3335         no-lock :
     3336      IF  x-TOG-Shift = False Then DO:
     3337          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     3338               ub.stk-tot.Fact-date <= x-date-end
     3339               and ub.stk-tot.shift-num = 0
     3340               USE-INDEX fact-date no-lock no-error.
     3341          if available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     3342      END.
     3343      Else DO:
     3344           find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     3345               (ub.stk-tot.shift-date  = x-date-end and
     3346               ub.stk-tot.shift-num  <= x-shift-end or
     3347               ub.stk-tot.shift-date  < x-date-end       ) and
     3348               ub.stk-tot.shift-num   > 0      use-index shift-num no-lock no-error.
     3349               if Available ub.stk-tot THEN Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     3350       End.
     3351       if Fact-order < Fact-order#  THEN  Fact-order = Fact-order#.
     3352     End.
     3353   End.
     3354   END PROCEDURE.
     3355     PROCEDURE Calc-Sub-itog :
     3356     define input parameter tt#          as   int                 no-undo.
     3357     Assign
     3358     B1-qnty     [tt#] = B1-qnty       [tt#] + qnty            [tt#]
     3359     B1-Summ     [tt#]  = B1-Summ     [tt#]    + Summ          [tt#]
     3360     B1-Vat      [tt#]  = B1-Vat      [tt#]    + Vat           [tt#]
     3361     B1-excise   [tt#]  = B1-excise   [tt#]    + excise        [tt#]
     3362     B1-road-tax [tt#]  = B1-road-tax [tt#]    + road-tax      [tt#]
     3363     B1-transport[tt#]  = B1-transport[tt#]    + transport     [tt#]
     3364     B1-Other    [tt#]  = B1-Other    [tt#]    + Other         [tt#]
     3365     B2-qnty     [tt#]   = B2-qnty      [tt#]  + qnty        [tt#]
     3366     B2-Summ     [tt#]  = B2-Summ       [tt#]  + Summ       [tt#]
     3367     B2-Vat      [tt#]  = B2-Vat        [tt#]  + Vat        [tt#]
     3368     B2-excise   [tt#]  = B2-excise     [tt#]  + excise     [tt#]
     3369     B2-road-tax [tt#]  = B2-road-tax   [tt#]  + road-tax   [tt#]
     3370     B2-transport[tt#]  = B2-transport  [tt#]  + transport  [tt#]
     3371     B2-Other    [tt#]  = B2-Other      [tt#]  + Other      [tt#]
     3372     Bi-qnty     [tt#]  = Bi-qnty      [tt#]   + qnty     [tt#]
     3373     Bi-Summ     [tt#]  = Bi-Summ      [tt#]   + Summ     [tt#]
     3374     Bi-Vat      [tt#]  = Bi-Vat       [tt#]   + Vat      [tt#]
     3375     Bi-excise   [tt#]  = Bi-excise    [tt#]   + excise   [tt#]
     3376     Bi-road-tax [tt#]  = Bi-road-tax  [tt#]   + road-tax [tt#]
     3377     Bi-transport[tt#]  = Bi-transport [tt#]   + transport[tt#]
     3378     Bi-Other    [tt#]  = Bi-Other     [tt#]   + Other    [tt#]    .
     3379   END PROCEDURE.
     3380   PROCEDURE Clear-item :
     3381    define input parameter tt#          as   int                 no-undo.
     3382    Assign
     3383     Qnty      [tt#]   = 0
     3384     Summ      [tt#]  = 0
     3385     Vat       [tt#]  = 0
     3386     eff       [tt#]  = 0
     3387     Excise    [tt#]  = 0
     3388     Road-tax  [tt#]  = 0
     3389     Transport [tt#]  = 0
     3390     Other     [tt#]  = 0 .
     3391    END PROCEDURE.
     3392   PROCEDURE Item-Goods :
     3393    define input parameter  par-3 as char no-undo.
     3394    define input parameter  par-4 as char no-undo.
     3395    define variable v-vat-pc        like ub.doc-line.vat-pc    no-undo.
     3396    define variable v-host-code     like ub.sysconf.host-code  no-undo.
     3397    define variable v-gds-code      like ub.goods.gds-code     no-undo.
     3398        if par-4 = "goods":U  Then DO:
     3399             FIND FIRST clients WHERE clients.obj-type = Goods.prod-type AND
     3400                                 clients.obj-code = Goods.prod-code use-index pi NO-LOCK .
     3401                                   assign
     3402                                       gds-zap-unit-base  = Goods.unit-base
     3403                                       gds-zap-prt-root   = Goods.prt-root
     3404                                       gds-zap-prod-type  = Goods.prod-type
     3405                                       gds-zap-prod-code  = Goods.prod-code
     3406                                       gds-zap-artic      = Goods.artic
     3407                                       gds-zap-type       = Goods.gds-type
     3408                                       gds-zap-grp-name   = Goods.grp-name
     3409                                       gds-zap-b-code     = Goods.gds-code
     3410                                       gds-zap-prod-name  = clients.obj-name .
     3411                                   if g#gds-engl then
     3412                                       assign gds-zap-gds-name = Goods.engl-name.
     3413                                   else
     3414                                       assign gds-zap-gds-name = Goods.gds-name.
     3415                               End.
     3416        if par-4 = "gds-list":U  Then DO:
     3417             FIND FIRST clients WHERE clients.obj-type = gds-list.prod-type AND
     3418                                 clients.obj-code = gds-list.prod-code use-index pi NO-LOCK .
     3419                                   assign
     3420                                       gds-zap-unit-base  = gds-list.unit-base
     3421                                       gds-zap-prt-root   = gds-list.prt-root
     3422                                       gds-zap-prod-type  = gds-list.prod-type
     3423                                       gds-zap-prod-code  = gds-list.prod-code
     3424                                       gds-zap-type       = gds-list.gds-type
     3425                                       gds-zap-artic      = gds-list.artic
     3426                                       gds-zap-grp-name   = gds-list.grp-name
     3427                                       gds-zap-b-code     = gds-list.gds-code
     3428                                       gds-zap-prod-name  = clients.obj-name .
     3429                                   if g#gds-engl then
     3430                                       assign gds-zap-gds-name = gds-list.engl-name.
     3431                                   else
     3432                                       assign gds-zap-gds-name = gds-list.gds-name.
     3433                               End.
     3434       Run foreach .
     3435         If  break_group = true and par-3 <> "1"  then DO:
     3436                        If break_group1 = True THEN  DO:
     3437                                  if (par-3 = "3"  OR  par-3 = "5" ) and  par-3 <> "6"
     3438                                     then temp-str = string("ГРУППА : " + gds-zap-grp-name ).
     3439                                     else temp-str = string("ПРОИЗВОДИТЕЛЬ : " + gds-zap-prod-name ) .
     3440                                  if par-3 = "6"  then do:
     3441                                     assign
     3442                                         v-gds-code = ( if par-4 = "gds-list" then Gds-list.gds-code
     3443                                                                              else goods.gds-code )
     3444                                     .
     3445   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3446   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     3447     (input  x-store-type
     3448     ,input  x-store-code
     3449     ,output v-host-code
     3450     )  .
     3451   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3452   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     3453     (input  v-gds-code
     3454     ,input  '1':U
     3455     ,input  ?
     3456     ,input  v-host-code
     3457     ,input  x-store-type
     3458     ,input  x-store-code
     3459     ,output v-vat-pc
     3460     ) no-error .
     3461                                     assign
     3462                                       temp-str = string( "СТАВКА НДС : " + string(v-vat-pc) + "%" )
     3463                                     .
     3464                                  end.
     3465                                fr0 = true .
     3466                                tmp#stroka0 = temp-str.
     3467                        End.
     3468                        IF  (par-3 = "4"  OR  par-3 = "5")  THEN DO:
     3469                            temp-str =
     3470                                ( if par-3 = "4"
     3471                                     then string("ГРУППА : " + gds-zap-grp-name )
     3472                                     else string("ПРОИЗВОДИТЕЛЬ : " + gds-zap-prod-name ) ).
     3473                                 if NOT xSumsOnly THEN DO :
     3474                                 tmp#stroka = temp-str.
     3475                                 fr = true .
     3476                                 end.
     3477                                 break_group1 = false.
     3478                        END.
     3479                         break_group = false.
     3480       End.
     3481             Run display-line.
     3482    END PROCEDURE.
     3483   PROCEDURE Di :
     3484   define input parameter tt# as int no-undo.
     3485   define input parameter p1 as char no-undo.
     3486   define input parameter p2 as int no-undo.
     3487   define input parameter p3 as char no-undo.
     3488   define input parameter p4 as char no-undo.
     3489   define input parameter p5 as char no-undo.
     3490   define input parameter p6 as char no-undo.
     3491   define input parameter p7 as char no-undo.
     3492    CASE CAPS(p7) :
     3493      WHEN "B1":U  Then  DO:
     3494      IF  NOT (NOT Show-Negativ  AND
     3495        (b1-qnty  [tt#]           = 0 and
     3496          b1-Summ     [tt#] = 0 and
     3497          b1-Vat      [tt#] = 0 and
     3498          b1-excise   [tt#] = 0 and
     3499          b1-road-tax [tt#] = 0 and
     3500          b1-transport[tt#] = 0 and
     3501          b1-Other    [tt#] = 0 ))  THEN DO:
     3502                DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     3503                   p1   @ type-Sum
     3504                   p3 @ gds-zap-b-code
     3505                   p4 @ gds-zap-artic
     3506                   p5 @ gds-zap-gds-name
     3507                   p6 @ gds-zap-unit-base
     3508                   b1-qnty      @ F-qnty
     3509                   b1-Summ     [tt#]  @ F-Summ
     3510                   b1-Vat      [tt#]  @ F-Vat
     3511                   b1-eff      [tt#] when b1-eff[tt#] <> 0  @ F-eff
     3512                   b1-excise   [tt#]  @ F-excise
     3513                   b1-road-tax [tt#]  @ F-road-tax
     3514                   b1-transport[tt#]  @ F-transport
     3515                   b1-Other    [tt#]  @ F-Other
     3516                  with FRAME ZAPAS .          DOWN stream   OutStream 1 with FRAME ZAPAS. End.
     3517       End.
     3518      WHEN "B2":U  Then do:
     3519      IF  NOT (NOT Show-Negativ  AND
     3520      (b2-qnty  [tt#]           = 0 and
     3521          b2-Summ     [tt#] = 0 and
     3522          b2-Vat      [tt#] = 0 and
     3523          b2-excise   [tt#] = 0 and
     3524          b2-road-tax [tt#] = 0 and
     3525          b2-transport[tt#] = 0 and
     3526          b2-Other    [tt#] = 0 ))  THEN  DO:
     3527         DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     3528                   p1 @ type-Sum
     3529                   p3 @ gds-zap-b-code
     3530                   p4 @ gds-zap-artic
     3531                   p5 @ gds-zap-gds-name
     3532                   p6 @ gds-zap-unit-base
     3533                   b2-qnty    [tt#]    @ F-qnty
     3534                   b2-Summ     [tt#]  @ F-Summ
     3535                   b2-Vat      [tt#]  @ F-Vat
     3536                   b2-eff      [tt#] when b2-eff[tt#] <> 0  @ F-eff
     3537                   b2-excise   [tt#]  @ F-excise
     3538                   b2-road-tax [tt#]  @ F-road-tax
     3539                   b2-transport[tt#]  @ F-transport
     3540                   b2-Other    [tt#]  @ F-Other
     3541                   with FRAME ZAPAS .          DOWN stream   OutStream 1 with FRAME ZAPAS. End.
     3542          End.
     3543      WHEN "BI":U Then DO:
     3544                DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     3545                   p1   @ type-Sum
     3546                   p3 @ gds-zap-b-code
     3547                   p4 @ gds-zap-artic
     3548                   p5 @ gds-zap-gds-name
     3549                   p6 @ gds-zap-unit-base
     3550                   bi-qnty    [tt#]    @ F-qnty
     3551                   bi-Summ     [tt#]  @ F-Summ
     3552                   bi-Vat      [tt#]  @ F-Vat
     3553                   bi-eff      [tt#] when bi-eff[tt#] <> 0 @ F-eff
     3554                   bi-excise   [tt#]  @ F-excise
     3555                   bi-road-tax [tt#]  @ F-road-tax
     3556                   bi-transport[tt#]  @ F-transport
     3557                   bi-Other    [tt#]  @ F-Other
     3558                  with FRAME ZAPAS .        DOWN stream   OutStream 1 with FRAME ZAPAS.
     3559               End.
     3560      WHEN ""  Then DO:
     3561                DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     3562                   p1   @ type-Sum
     3563                   p3   @ gds-zap-b-code
     3564                   p4 @ gds-zap-artic
     3565                   p5 @ gds-zap-gds-name
     3566                   p6 @ gds-zap-unit-base
     3567                   qnty     [tt#]  @ F-qnty
     3568                   Summ     [tt#]  @ F-Summ
     3569                   Vat      [tt#]  @ F-Vat
     3570                   eff      [tt#]  when eff[tt#] <> 0   @ F-eff
     3571                   excise   [tt#]  @ F-excise
     3572                   road-tax [tt#]  @ F-road-tax
     3573                   transport[tt#]  @ F-transport
     3574                   Other    [tt#]  @ F-Other
     3575                  with FRAME ZAPAS .        DOWN stream   OutStream 1 with FRAME ZAPAS.
     3576                End.
     3577      End case.
     3578    END PROCEDURE.
     3579   PROCEDURE Clear-B1  :
     3580   define variable tt#          as   int                 no-undo.
     3581   repeat tt# = 1 to 3 :
     3582    Assign
     3583       b1-qnty      = 0
     3584       b1-Summ     [tt#]    = 0
     3585       b1-Vat      [tt#]    = 0
     3586       b1-eff      [tt#]    = 0
     3587       b1-excise   [tt#]    = 0
     3588       b1-road-tax [tt#]    = 0
     3589       b1-transport[tt#]    = 0
     3590       b1-Other    [tt#]    = 0  .
     3591      End.
     3592    END PROCEDURE.
     3593   PROCEDURE Clear-B2  :
     3594   define variable tt#          as   int                 no-undo.
     3595   repeat tt# = 1 to 3 :
     3596    Assign
     3597       b2-qnty         = 0
     3598       b2-Summ        [tt#]  = 0
     3599       b2-Vat         [tt#]  = 0
     3600       b2-eff         [tt#]  = 0
     3601       b2-excise      [tt#]  = 0
     3602       b2-road-tax    [tt#]  = 0
     3603       b2-transport   [tt#]  = 0
     3604       b2-Other       [tt#]  = 0  .
     3605       End.
     3606   END PROCEDURE.
     3607   PROCEDURE Clear-Bi  :
     3608   define variable tt#          as   int                 no-undo.
     3609   repeat tt# = 1 to 3 :
     3610    Assign
     3611       bi-qnty         = 0
     3612       bi-Summ        [tt#]  = 0
     3613       bi-Vat         [tt#]  = 0
     3614       bi-eff         [tt#]  = 0
     3615       bi-excise      [tt#]  = 0
     3616       bi-road-tax    [tt#]  = 0
     3617       bi-transport   [tt#]  = 0
     3618       bi-Other       [tt#]  = 0  .
     3619       End.
     3620   END PROCEDURE.
