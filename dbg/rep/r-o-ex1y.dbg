     3141    Assign
     3142       b1-qnty     [tt#]   = 0
     3143       b1-Summ     [tt#]    = 0
     3144       b1-Vat      [tt#]    = 0
     3145       b1-eff      [tt#]    = 0
     3146       b1-excise   [tt#]    = 0
     3147       b1-road-tax [tt#]    = 0
     3148       b1-transport[tt#]    = 0
     3149       b1-Other    [tt#]    = 0  .
