      771   def var vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      772   procedure tax-name:
      773   define input  parameter pardef-tax  as character           no-undo.
      774   define output parameter parname-tax as character initial ? no-undo.
      775   define buffer bf_tax for ub.tax.
      776   do on error undo, return error :
      777      case pardef-tax:
      778         when 'vat':U then do:
      779                     find first bf_tax where bf_tax.tax-code = integer('1':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '1':U(не задействован)".
      780         end.
      781         when 'slt':U then do:
      782                     find first bf_tax where bf_tax.tax-code = integer('2':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '2':U(не задействован)".
      783         end.
      784         when 'rdt':U then do:
      785                     find first bf_tax where bf_tax.tax-code = integer('3':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '3':U(не задействован)".
      786         end.
      787         when 'exc':U then do:
      788                     find first bf_tax where bf_tax.tax-code = integer('4':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '4':U(не задействован)".
      789         end.
      790         otherwise do:
      791            return error "Задан неверный параметр " + pardef-tax + " .".
      792         end.
      793      end case.
      794   end.
      795   end procedure.
      796   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      797   procedure cur-time :
      798      define output parameter p-today as date      no-undo .
      799      define output parameter p-time  as integer   no-undo .
      800     do
      801     on error undo, return error
      802     :
      803       define variable v-date1 as date      no-undo .
      804       define variable v-date2 as date      no-undo .
      805       define variable v-time  as integer   no-undo .
      806       assign
      807         v-date1 = today
      808         v-time  = time
      809         v-date2 = today
      810       .
      811       if v-date1 <> v-date2
      812       then do:
      813         assign
      814           v-date1 = today
      815           v-time  = v-time
      816         .
      817       end.
      818       assign
      819         p-today = v-date1
      820         p-time  = v-time
      821       .
      822     end.
      823   end.
      824   function cur-time-date returns character
      825   :
      826     return string(today, '99/99/9999':U) .
      827   end.
      828   function cur-time-mjd returns decimal
      829   :
      830     define variable v-date as date      no-undo .
      831     define variable v-time as integer   no-undo .
      832     run cur-time in this-procedure
      833       (output v-date
      834       ,output v-time
      835       ) .
      836     return integer(v-date) - 2400002 + (v-time / 86400) .
      837   end.
      838   function cur-time-get-ending-index returns integer
      839   (input p-number as integer
      840   )
      841   :
      842     if p-number < 0
      843     or p-number = ?
      844     then do:
      845       return 1 .
      846     end.
      847     define variable v-rest as integer   no-undo .
      848     assign
      849       p-number = p-number modulo 100
      850     .
      851     if p-number < 20
      852     then do:
      853       assign
      854         v-rest = p-number
      855       .
      856     end.
      857     else do:
      858       assign
      859         v-rest = p-number modulo 10
      860       .
      861     end.
      862     case v-rest :
      863       when 1
      864       then do:
      865         return 2 .
      866       end.
      867       when 2 or
      868       when 3 or
      869       when 4
      870       then do:
      871         return 3 .
      872       end.
      873       otherwise do:
      874         return 1 .
      875       end.
      876     end case .
      877   end.
      878   procedure cur-time-mjd-to-date :
      879      define input  parameter i-mjd-diff as decimal no-undo.
      880      define output parameter o-Date     as date    no-undo.
      881      define output parameter o-Time     as integer no-undo.
      882      define variable v-day-number as integer   no-undo .
      883      if    i-mjd-diff < 0
      884         or i-mjd-diff = ?
      885      then do:
      886         return "?" .
      887      end.
      888      assign
      889         v-day-number = truncate(i-mjd-diff,0).
      890         o-Date = date(v-day-number + 2400002).
      891         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      892     .
      893   end.
      894   function cur-time-mjd-to-string returns character
      895   (input p-mjd-diff as decimal
      896   )
      897   :
      898     define variable v-day-number as integer   no-undo .
      899     define variable v-seconds    as integer   no-undo .
      900     define variable v-hour       as integer   no-undo .
      901     define variable v-min        as integer   no-undo .
      902     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      903     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      904     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      905     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      906     if p-mjd-diff < 0
      907     or p-mjd-diff = ?
      908     then do:
      909       return "?" .
      910     end.
      911     assign
      912       v-day-number = integer(truncate(p-mjd-diff,0))
      913       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      914     .
      915     if v-seconds > 86400
      916     then do:
      917       assign
      918         v-seconds = 86400 - 1
      919       .
      920     end.
      921     if v-seconds < 0
      922     then do:
      923       assign
      924         v-seconds = 0
      925       .
      926     end.
      927     assign
      928       v-hour = truncate(v-seconds / 3600, 0)
      929     .
      930     assign
      931       v-seconds = v-seconds modulo 3600
      932     .
      933     assign
      934       v-min = truncate(v-seconds / 60, 0)
      935     .
      936     assign
      937       v-seconds = v-seconds modulo 60
      938     .
      939     return
      940         (if v-day-number <> 0
      941           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      942           else ""
      943         )
      944       + (if v-day-number <> 0 or v-hour <> 0
      945           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      946           else ""
      947         )
      948       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      949           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      950           else ""
      951         )
      952       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      953       .
      954   end.
      955   function cur-time-string returns character
      956   :
      957     define variable v-date as date      no-undo .
      958     define variable v-time as integer   no-undo .
      959     run cur-time in this-procedure
      960       (output v-date
      961       ,output v-time
      962       ) .
      963     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      964   end.
      965   function cur-time-string-sec returns character
      966   :
      967     define variable v-date as date      no-undo .
      968     define variable v-time as integer   no-undo .
      969     run cur-time in this-procedure
      970       (output v-date
      971       ,output v-time
      972       ) .
      973     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      974   end.
      975   function cur-time-custom  returns character
      976   (input p-prefix as character
      977   ,input p-date-format as character
      978   ,input p-delimiter as character
      979   ,input p-time-format as character
      980   ,input p-suffix as character
      981   )
      982   :
      983     define variable v-date as date      no-undo .
      984     define variable v-time as integer   no-undo .
      985     run cur-time in this-procedure
      986       (output v-date
      987       ,output v-time
      988       ) .
      989     return
      990       p-prefix
      991       + string(v-date, p-date-format)
      992       + p-delimiter
      993       + string(v-time, p-time-format)
      994       + p-suffix
      995       .
      996   end.
      997   function cur-time-print  returns character
      998   :
      999     define variable v-date as date      no-undo .
     1000     define variable v-time as integer   no-undo .
     1001     run cur-time in this-procedure
     1002       (output v-date
     1003       ,output v-time
     1004       ) .
     1005     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1006   end.
     1007   function cur-time-datetime returns datetime
     1008   :
     1009     define variable v-char as character no-undo .
     1010     define variable v-datetime as datetime no-undo .
     1011     v-char = cur-time-string().
     1012     v-datetime = datetime(v-char).
     1013     return  v-datetime.
     1014   end.
     1015   function cur-time-string-msec returns character
     1016   :
     1017     define variable v-date as datetime  no-undo .
     1018     v-date = now.
     1019     return string(v-date) .
     1020   end.
     1021   function func-vat returns decimal (
     1022       input p-gds-code as integer  ,
     1023       input p-obj-type as character ,
     1024       input p-obj-code as integer  ).
     1025   define variable i-vat-pc as decimal no-undo .
     1026   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1027   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     1028     (input  p-gds-code
     1029     ,input  '1':U
     1030     ,input  x-Date-End
     1031     ,input  v-cntxt-host-code-obj
     1032     ,input  p-obj-type
     1033     ,input  p-obj-code
     1034     ,output i-vat-pc
     1035     ) no-error .
     1036   if error-status :error then return 0 .
     1037   else return i-vat-pc.
     1038   end function .
     1039   define temp-table temp-font no-undo
     1040     field fontnum  as integer
     1041     field fontname as character
     1042     field fontsize as character
     1043     field fonttype as character
     1044     field font-h   as integer
     1045     field font-w   as integer
     1046     field v-row    as integer
     1047     field v-col    as integer
     1048     field v-row-lans as integer
     1049     field v-col-lans as integer
     1050   index pi fontnum
     1051   .
     1052   procedure get-font-ini :
     1053     do
     1054     on error undo, return error return-value
     1055     :
     1056   define variable ii as integer   no-undo .
     1057   define variable v-font7 as character no-undo .
     1058   define variable v-font as character no-undo .
     1059   define variable loc-name as character no-undo .
     1060   define variable loc-size as character no-undo .
     1061   define variable loc-type as character no-undo .
     1062   define variable old_H as integer   no-undo .
     1063   define variable old_w as integer   no-undo .
     1064   define variable old-row  as integer   no-undo .
     1065   define variable old-col  as integer   no-undo .
     1066   define variable old-row-lans  as integer   no-undo .
     1067   define variable old-col-lans  as integer   no-undo .
     1068   define variable vv as integer   no-undo .
     1069   empty temp-table temp-font.
     1070     GET-KEY-VALUE SECTION "fonts" KEY "font7" VALUE v-font7 .
     1071       case num-entries (v-font7) :
     1072         when 4 then do:
     1073             assign
     1074               loc-name = entry ( 1 , v-font7 )
     1075               loc-size = entry ( 2 , v-font7 )
     1076               loc-type = entry ( 3 , v-font7 ) + "," +  entry ( 4 , v-font7 )
     1077             .
     1078         end.
     1079         when 3 then do:
     1080             assign
     1081               loc-name = entry ( 1 , v-font7 )
     1082               loc-size = entry ( 2 , v-font7 )
     1083               loc-type = entry ( 3 , v-font7 )
     1084             .
     1085         end.
     1086         when 2 then  do:
     1087             assign
     1088               loc-name = entry ( 1 , v-font7 )
     1089               loc-size = entry ( 2 , v-font7 )
     1090               loc-type = ""
     1091             .
     1092         end.
     1093         when 1 then do:
     1094             assign
     1095               loc-name = trim(entry ( 1 , v-font7 ))
     1096               loc-size = ""
     1097               loc-type = ""
     1098             .
     1099         end.
     1100       end case.
     1101     create temp-font.
     1102     assign
     1103       temp-font.fontnum  = 7
     1104       temp-font.fontname = trim(loc-name)
     1105       temp-font.fontsize = trim(loc-size)
     1106       temp-font.fonttype = trim(loc-type)
     1107       temp-font.v-row    = 62
     1108       temp-font.v-col    = 136
     1109       temp-font.v-row-lans = 43
     1110       temp-font.v-col-lans = 198
     1111     .
     1112     repeat ii = 16 to 100 :
     1113       get-key-value section 'fonts' key 'font' + string(ii)   value v-font  .
     1114       if v-font = "" or v-font = ? then leave.
     1115       case num-entries (v-font) :
     1116         when 4 then do:
     1117             assign
     1118               loc-name = entry ( 1 , v-font )
     1119               loc-size = entry ( 2 , v-font )
     1120               loc-type = entry ( 3 , v-font ) + "," +  entry ( 4 , v-font )
     1121             .
     1122         end.
     1123         when 3 then do:
     1124             assign
     1125               loc-name = entry ( 1 , v-font )
     1126               loc-size = entry ( 2 , v-font )
     1127               loc-type = entry ( 3 , v-font )
     1128             .
     1129         end.
     1130         when 2 then do:
     1131             assign
     1132               loc-name = entry ( 1 , v-font )
     1133               loc-size = entry ( 2 , v-font )
     1134               loc-type = ""
     1135             .
     1136         end.
     1137         when 1 then do:
     1138             assign
     1139               loc-name = trim(entry ( 1 , v-font ))
     1140               loc-size = ""
     1141               loc-type = ""
     1142             .
     1143         end.
     1144       end case.
     1145     create temp-font.
     1146     assign
     1147       temp-font.fontnum  = ii
     1148       temp-font.fontname = trim(loc-name)
     1149       temp-font.fontsize = trim(loc-size)
     1150       temp-font.fonttype = trim(loc-type)
     1151     .
     1152     end.
     1153       for each temp-font :
     1154          vv = integer(entry(2,temp-font.fontsize, "=" )) no-error .
     1155          if  vv = ? then vv =  0 .
     1156           run rep/exfont.p (
     1157             input   temp-font.fontname ,
     1158             input   vv ,
     1159             input   temp-font.fonttype ,
     1160             output  temp-font.font-h   ,
     1161             output  temp-font.font-w   )
     1162           .
     1163       end.
     1164   find first temp-font where  temp-font.fontnum  = 7  .
     1165   old_H = temp-font.font-H .
     1166   old_w = temp-font.font-W .
     1167   old-row = temp-font.v-row .
     1168   old-col = temp-font.v-col .
     1169   old-row-lans = temp-font.v-row-lans .
     1170   old-col-lans = temp-font.v-col-lans .
     1171       for each temp-font where
     1172                temp-font.fontnum  <> 7 :
     1173           assign
     1174               temp-font.v-row    = old_H * old-row / temp-font.font-h
     1175               temp-font.v-col    = old_W * old-col / temp-font.font-W
     1176               temp-font.v-row-lans    = old_H * old-row-lans / temp-font.font-h
     1177               temp-font.v-col-lans    = old_W * old-col-lans / temp-font.font-W
     1178           .
     1179       end.
     1180     end.
     1181   end procedure.
     1182   PROCEDURE How-name :
     1183   define input  parameter h as integer no-undo .
     1184   define input  parameter w as integer no-undo .
     1185   define output parameter n as character  no-undo .
     1186   define variable A4port-H as integer   no-undo init 63.
     1187   define variable A4port-W as integer   no-undo init 136.
     1188   define variable A4lans-H as integer   no-undo init 43.
     1189   define variable A4lans-W as integer   no-undo init 198.
     1190   define variable Strim-W  as integer   no-undo init 278.
     1191   run define-a4-size (
     1192        input ReportFontNum
     1193       ,output A4port-H
     1194       ,output A4port-W
     1195       ,output A4lans-H
     1196       ,output A4lans-W ).
     1197   If w >= 1 and w <= A4port-W Then DO:
     1198     If h >= 1  and h <= A4lans-H Then n = "A4-lans":U.
     1199     If h > A4lans-H  and h <= A4port-H Then n = "A4-port":U.
     1200     If h > A4port-H              Then n = "to-file":U.
     1201   End.
     1202   If w > A4port-W and w <= A4lans-W Then DO:
     1203     If h >= 1  and h <= A4lans-H Then n = "A4-lans":U.
     1204     If h > A4lans-H  and h <= A4port-H Then n = "A3-lans":U.
     1205     If h > A4port-H              Then n = "to-file":U.
     1206   End.
     1207   If w > A4lans-W and w <= Strim-W Then DO:
     1208     If h >= 1  and h <= A4lans-H Then n = "to-file":U.
     1209     If h > A4lans-H  and h <= A4port-H Then n = "A3-lans":U.
     1210     If h > A4port-H              Then n = "to-file":U.
     1211   End.
     1212   If w > Strim-W Then DO:
     1213      n = "to-file":U.
     1214   End.
     1215   END PROCEDURE.
     1216   PROCEDURE define-a4-size :
     1217   define input  parameter p-ReportFontNum as integer   no-undo .
     1218   define output parameter A4port-H as integer   no-undo .
     1219   define output parameter A4port-W as integer   no-undo .
     1220   define output parameter A4lans-H as integer   no-undo .
     1221   define output parameter A4lans-W as integer   no-undo .
     1222   if not can-find (first temp-font ) then do:
     1223      run get-font-ini .
     1224   end.
     1225   find first temp-font where temp-font.fontnum = p-ReportFontNum no-error .
     1226   if available temp-font then do:
     1227   assign
     1228     A4port-H = temp-font.v-row
     1229     A4port-W = temp-font.v-col
     1230     A4lans-H = temp-font.v-row-lans
     1231     A4lans-W = temp-font.v-col-lans
     1232   .
     1233   end.
     1234   else do:
     1235   assign
     1236     A4port-H = 63
     1237     A4port-W = 136
     1238     A4lans-H = 43
     1239     A4lans-W = 198
     1240   .
     1241   end.
     1242   END PROCEDURE.
