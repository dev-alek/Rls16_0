      875   define new global shared variable g#attr-lib  as handle no-undo .
      876   define variable v-attr-lib-variable as handle no-undo .
      877   procedure gds-attr-name :
      878     define input  parameter p-code           as character no-undo .
      879     define output parameter p-type           as character no-undo .
      880     define output parameter p-format         as character no-undo .
      881     define output parameter p-label          as character no-undo .
      882     define output parameter p-user-can-edit  as logical   no-undo .
      883     define output parameter p-output-display as logical   no-undo .
      884     define output parameter p-other          as character no-undo .
      885     do
      886     on error undo, return error
      887     :
      888           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-name in g#attr-lib
      889         (input  p-code
      890         ,output p-type
      891         ,output p-format
      892         ,output p-label
      893         ,output p-user-can-edit
      894         ,output p-output-display
      895         ,output p-other
      896         ) no-error .
      897       if error-status :error
      898       then do:
      899         undo, return error return-value .
      900       end.
      901     end.
      902   end procedure.
      903   procedure gds-attr-tooltip :
      904     define input  parameter p-code    as character no-undo .
      905     define output parameter p-tooltip as character no-undo .
