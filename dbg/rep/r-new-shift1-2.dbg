     1559   define shared stream Prnlibstream.
     1560     procedure on-same-page :
     1561       define input parameter p-line-number as integer no-undo .
     1562       if p-line-number > page-size( PrnLibstream )
     1563       then do:
     1564         return .
     1565       end.
     1566       if line-counter( PrnLibstream ) + p-line-number > page-size( PrnLibstream )
     1567       then do:
     1568         page stream PrnLibstream .
     1569       end.
     1570     end procedure.
