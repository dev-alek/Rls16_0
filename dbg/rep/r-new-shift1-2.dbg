     1471   procedure placelib_write-attr:
     1472   define input  parameter p-code     like ub.place-attr.attr-code .
     1473   define input  parameter p-obj-code like ub.place-attr.obj-code .
     1474   define input  parameter p-obj-type like ub.place-attr.obj-type .
     1475   define input  parameter p-pl-code  like ub.place-attr.pl-code .
     1476   define input  parameter p-value    like ub.place-attr.attr-value .
     1477   define output parameter p-ok       as logical.
     1478   define buffer buf_place-attr for ub.place-attr .
     1479     do on error undo, return error return-value :
     1480        p-ok = false.
     1481        find first buf_place-attr exclusive-lock where buf_place-attr.attr-code   = p-code
     1482                                                   and buf_place-attr.obj-code    = p-obj-code
     1483                                                   and buf_place-attr.obj-type    = p-obj-type
     1484                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
     1485        if not available buf_place-attr then do :
     1486           create buf_place-attr.
     1487           assign
     1488             buf_place-attr.attr-code   = p-code
     1489             buf_place-attr.attr-value  = p-value
     1490             buf_place-attr.obj-code    = p-obj-code
     1491             buf_place-attr.obj-type    = p-obj-type
     1492             buf_place-attr.pl-code     = p-pl-code
     1493           .
     1494           p-ok = true.
     1495        end.
     1496        else do:
     1497           buf_place-attr.attr-value  = p-value .
     1498           p-ok = true.
     1499        end.
     1500     end.
     1501   end.
     1502   procedure placelib_get-attr:
     1503   define input  parameter  p-code     like ub.place-attr.attr-code .
     1504   define input  parameter  p-obj-code like ub.place-attr.obj-code .
     1505   define input  parameter  p-obj-type like ub.place-attr.obj-type .
     1506   define input  parameter  p-pl-code  like ub.place-attr.pl-code .
     1507   define output parameter  p-value    like ub.place-attr.attr-value .
     1508   define output parameter  p-ok       as logical.
     1509   define buffer buf_place-attr for ub.place-attr .
     1510     do on error undo, return error return-value :
     1511        p-ok = false.
     1512        find first buf_place-attr no-lock where buf_place-attr.attr-code   = p-code
     1513                                                   and buf_place-attr.obj-code    = p-obj-code
     1514                                                   and buf_place-attr.obj-type    = p-obj-type
     1515                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
     1516        if available buf_place-attr then do :
     1517          p-value = buf_place-attr.attr-value.
     1518          p-ok = true.
     1519        end.
     1520        else do :
     1521          p-ok = false.
     1522        end.
     1523     end.
     1524   end.
     1525   procedure placelib_del-attr:
     1526   define input parameter  p-code     like ub.place-attr.attr-code .
     1527   define input parameter  p-obj-code like ub.place-attr.obj-code .
     1528   define input parameter  p-obj-type like ub.place-attr.obj-type .
     1529   define input parameter  p-pl-code  like ub.place-attr.pl-code .
     1530   define input parameter  p-value    like ub.place-attr.attr-value .
     1531   define output parameter p-ok       as logical.
     1532   define buffer buf_place-attr for ub.place-attr .
     1533     do on error undo, return error return-value :
     1534        p-ok = false.
     1535        find first buf_place-attr exclusive-lock where buf_place-attr.attr-code   = p-code
     1536                                                   and buf_place-attr.obj-code    = p-obj-code
     1537                                                   and buf_place-attr.obj-type    = p-obj-type
     1538                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
     1539        if available buf_place-attr then do :
     1540           delete buf_place-attr.
     1541           p-ok = true.
     1542        end.
     1543     end.
     1544   end.
