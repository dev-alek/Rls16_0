     4159   procedure add-chk :
     4160     define input  parameter p-obj-type like ub.chk-doc.obj-type no-undo .
     4161     define input  parameter p-obj-code like ub.chk-doc.obj-code no-undo .
     4162     define input  parameter p-doc-code like ub.chk-doc.doc-code no-undo .
     4163     define input  parameter p-chk-type like ub.chk-doc.chk-type no-undo .
     4164     define input  parameter p-gds-code like ub.goods.gds-code   no-undo .
     4165     define input  parameter p-pl-code  like ub.chk-gds.pl-code  no-undo .
     4166     define input  parameter p-loc1     like ub.chk-gds.loc1     no-undo .
     4167     define buffer buf_chk-gds  for ub.chk-gds.
     4168     define buffer bf_chk-gds   for ub.chk-gds.
     4169     define buffer buf_bar-code for ub.bar-code.
     4170     define VARIABLE v-pl-code as integer no-undo .
     4171     define buffer bf_place for ub.place .
     4172     define variable v-qnty like ub.chk-gds.doc-qnty no-undo init 0.
     4173     do
     4174       on error undo, return error return-value
     4175       :
     4176       for each buf_chk-gds
     4177         where buf_chk-gds.doc-code = p-doc-code
     4178         and buf_chk-gds.pl-code = p-pl-code
     4179         no-lock,
     4180         first buf_bar-code
     4181         where buf_bar-code.b-code = buf_chk-gds.b-code
     4182         and buf_bar-code.gds-code = p-gds-code
     4183         no-lock
     4184         :
     4185         find first temp-line-pump WHERE temp-line-pump.gds-code = buf_bar-code.gds-code
     4186           and temp-line-pump.pump-code = buf_chk-gds.pump and
     4187           temp-line-pump.nozzle-code  = buf_chk-gds.nozzle-code and
     4188           temp-line-pump.pl-code = buf_chk-gds.pl-code
     4189           no-error .
     4190         if not available (temp-line-pump) then
     4191         do:
     4192           create temp-line-pump.
     4193           assign
     4194             temp-line-pump.gds-code    = buf_bar-code.gds-code
     4195             temp-line-pump.pl-code     = buf_chk-gds.pl-code
     4196             temp-line-pump.loc1        = buf_chk-gds.loc1
     4197             temp-line-pump.pump-code   = buf_chk-gds.pump
     4198             temp-line-pump.nozzle-code = buf_chk-gds.nozzle-code
     4199             .
     4200         end.
     4201         v-qnty        = buf_chk-gds.doc-qnty .
     4202         if p-chk-type = integer('17':U)
     4203           then
     4204         do:
     4205           assign
     4206             temp-line-pump.pol8-l  = temp-line-pump.pol8-l + v-qnty
     4207             temp-line-pump.pol8-kg = temp-line-pump.pol8-kg + (v-qnty * buf_chk-gds.density)
     4208             .
     4209         end.
     4210         if p-chk-type = integer('1':U) or p-chk-type = integer('6':U)
     4211           then
     4212         do:
     4213           assign
     4214             temp-line-pump.pol9-l  = temp-line-pump.pol9-l + v-qnty
     4215             temp-line-pump.pol9-kg = temp-line-pump.pol9-kg + (v-qnty * buf_chk-gds.density)
     4216             .
     4217         end.
     4218         if p-chk-type = integer('15':U) THEN
     4219         DO:
     4220           assign
     4221             temp-line-pump.pol12 = temp-line-pump.pol12 + v-qnty
     4222             .
     4223         end.
     4224         if p-chk-type = integer('14':U) THEN
     4225         DO:
     4226           if buf_chk-gds.write-off-code = 0 then
     4227             assign
     4228               temp-line-pump.pol10 = temp-line-pump.pol10  + v-qnty
     4229               .
     4230           if buf_chk-gds.write-off-code = 1 then
     4231             assign
     4232               temp-line-pump.pol11 = temp-line-pump.pol11 + v-qnty
     4233               .
     4234         end.
     4235       end.
     4236     end.
     4237   end procedure.
