     1472   procedure placelib_write-attr:
     1473   define input  parameter p-code     like ub.place-attr.attr-code .
     1474   define input  parameter p-obj-code like ub.place-attr.obj-code .
     1475   define input  parameter p-obj-type like ub.place-attr.obj-type .
     1476   define input  parameter p-pl-code  like ub.place-attr.pl-code .
     1477   define input  parameter p-value    like ub.place-attr.attr-value .
     1478   define output parameter p-ok       as logical.
     1479   define buffer buf_place-attr for ub.place-attr .
     1480     do on error undo, return error return-value :
     1481        p-ok = false.
     1482        find first buf_place-attr exclusive-lock where buf_place-attr.attr-code   = p-code
     1483                                                   and buf_place-attr.obj-code    = p-obj-code
     1484                                                   and buf_place-attr.obj-type    = p-obj-type
     1485                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
     1486        if not available buf_place-attr then do :
     1487           create buf_place-attr.
     1488           assign
     1489             buf_place-attr.attr-code   = p-code
     1490             buf_place-attr.attr-value  = p-value
     1491             buf_place-attr.obj-code    = p-obj-code
     1492             buf_place-attr.obj-type    = p-obj-type
     1493             buf_place-attr.pl-code     = p-pl-code
     1494           .
     1495           p-ok = true.
     1496        end.
     1497        else do:
     1498           buf_place-attr.attr-value  = p-value .
     1499           p-ok = true.
     1500        end.
     1501     end.
     1502   end.
     1503   procedure placelib_get-attr:
     1504   define input  parameter  p-code     like ub.place-attr.attr-code .
     1505   define input  parameter  p-obj-code like ub.place-attr.obj-code .
     1506   define input  parameter  p-obj-type like ub.place-attr.obj-type .
     1507   define input  parameter  p-pl-code  like ub.place-attr.pl-code .
     1508   define output parameter  p-value    like ub.place-attr.attr-value .
     1509   define output parameter  p-ok       as logical.
     1510   define buffer buf_place-attr for ub.place-attr .
     1511     do on error undo, return error return-value :
     1512        p-ok = false.
     1513        find first buf_place-attr no-lock where buf_place-attr.attr-code   = p-code
     1514                                                   and buf_place-attr.obj-code    = p-obj-code
     1515                                                   and buf_place-attr.obj-type    = p-obj-type
     1516                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
     1517        if available buf_place-attr then do :
     1518          p-value = buf_place-attr.attr-value.
     1519          p-ok = true.
     1520        end.
     1521        else do :
     1522          p-ok = false.
     1523        end.
     1524     end.
     1525   end.
     1526   procedure placelib_del-attr:
     1527   define input parameter  p-code     like ub.place-attr.attr-code .
     1528   define input parameter  p-obj-code like ub.place-attr.obj-code .
     1529   define input parameter  p-obj-type like ub.place-attr.obj-type .
     1530   define input parameter  p-pl-code  like ub.place-attr.pl-code .
     1531   define input parameter  p-value    like ub.place-attr.attr-value .
     1532   define output parameter p-ok       as logical.
     1533   define buffer buf_place-attr for ub.place-attr .
     1534     do on error undo, return error return-value :
     1535        p-ok = false.
     1536        find first buf_place-attr exclusive-lock where buf_place-attr.attr-code   = p-code
     1537                                                   and buf_place-attr.obj-code    = p-obj-code
     1538                                                   and buf_place-attr.obj-type    = p-obj-type
     1539                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
     1540        if available buf_place-attr then do :
     1541           delete buf_place-attr.
     1542           p-ok = true.
     1543        end.
     1544     end.
     1545   end.
     1546   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1547   define new global shared variable g#lib-calc as handle no-undo .
     1548   function fnc-convert-dot-to-colon returns character
     1549       (input p-data as decimal, input p-accur as character, input p-num as integer) forward.
     1550   function fnc-convert-dot-to-colon returns character
     1551   (input p-data as decimal, input p-accur as character, input p-num as integer):
     1552       define variable result as character no-undo.
     1553       define variable v-str-result as character no-undo.
     1554       if p-data = ? then p-data = 0 .
     1555       p-data = round(p-data, p-num).
     1556       v-str-result = trim(replace(string(p-data, p-accur), ".", ",")).
     1557       return v-str-result.
     1558   END FUNCTION.
