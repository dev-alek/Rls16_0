      159   procedure create_obj-list :
      160      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      161      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      162      do
      163      on error undo, return error return-value
      164      :
      165         define buffer cli-obj for ub.clients .
      166         define variable p-var as integer no-undo .
      167         define buffer buf_obj-list for obj-list .
      168         find last buf_obj-list  use-index pi no-error .
      169         if available buf_obj-list
      170         then
      171            p-var = buf_obj-list.obj-id + 1.
      172         else
      173            p-var = 1.
      174         find first cli-obj where
      175                   cli-obj.obj-type = p-obj-type
      176               and cli-obj.obj-code = p-obj-code
      177         no-lock no-error.
      178         if available cli-obj
      179         then do:
      180            create buf_obj-list.
      181            assign
      182               buf_obj-list.obj-id   = p-var
      183               buf_obj-list.obj-code = cli-obj.obj-code
      184               buf_obj-list.obj-type = cli-obj.obj-type
      185               buf_obj-list.obj-name = cli-obj.obj-name
      186               buf_obj-list.db-num   = cli-obj.db-num
      187            .
      188         end.
      189      end.
      190   end.
