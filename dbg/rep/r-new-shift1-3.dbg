     2662     end.
     2663     for each temp-rvs-line
     2664       break by temp-rvs-line.gds-code by temp-rvs-line.pl-code
     2665       on error undo, return error return-value
     2666       :
     2667       v-fact-order-inv = 0 .
     2668       find last ub.doc-line no-lock where
     2669         ub.doc-line.fact-order <= fo
     2670         and ub.doc-line.obj-code = temp-rvs-line.obj-code
     2671         and ub.doc-line.obj-type = temp-rvs-line.obj-type
     2672         and ub.doc-line.prod-code = temp-rvs-line.prod-code
     2673         and ub.doc-line.prod-type = temp-rvs-line.prod-type
     2674         and ub.doc-line.artic = temp-rvs-line.artic
     2675         and ub.doc-line.status_ = 'факт':U
     2676         and ub.doc-line.ext-doc-type = 'vt':U no-error .
     2677       if available (ub.doc-line) then v-fact-order-inv = ub.doc-line.fact-order .
     2678       assign
