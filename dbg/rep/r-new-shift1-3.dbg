      876   define new global shared variable g#attr-lib  as handle no-undo .
      877   define variable v-attr-lib-variable as handle no-undo .
      878   procedure gds-attr-name :
      879     define input  parameter p-code           as character no-undo .
      880     define output parameter p-type           as character no-undo .
      881     define output parameter p-format         as character no-undo .
      882     define output parameter p-label          as character no-undo .
      883     define output parameter p-user-can-edit  as logical   no-undo .
      884     define output parameter p-output-display as logical   no-undo .
      885     define output parameter p-other          as character no-undo .
      886     do
      887     on error undo, return error
      888     :
      889           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-name in g#attr-lib
      890         (input  p-code
      891         ,output p-type
      892         ,output p-format
      893         ,output p-label
      894         ,output p-user-can-edit
      895         ,output p-output-display
      896         ,output p-other
      897         ) no-error .
      898       if error-status :error
      899       then do:
      900         undo, return error return-value .
      901       end.
      902     end.
      903   end procedure.
