     3646                 '<td text_wrap="true" num="0.00" val="' + fnc-convert-dot-to-colon(bf_temp-rvs-line.pol4-kg-state,"->>>>>>>>>>>>>9.99",2) + '" style="text-align: right;">' + if bf_temp-rvs-line.pol4-kg-state <> ? then fnc-convert-dot-to-colon(bf_temp-rvs-line.pol4-kg-state,"->>>>>>>>>>>9.99",2) + '</td>' else "" + '</td>' skip
