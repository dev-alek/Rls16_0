     3691     output stream OutStr-html close.
     3692   end procedure .
     3693   procedure print-sug:
     3694     define variable v-value         as character no-undo.
     3695     define variable v-ok            as logical   no-undo.
     3696     define variable v-com-tanks     as character no-undo .
     3697     define variable v-main-tanks    as character no-undo .
     3698     define variable v-num-com-tanks as integer   no-undo .
     3699     define variable is-sug as logical no-undo .
     3700     for each temp-rvs-line:
     3701       is-sug = is-sug(temp-rvs-line.gds-code) .
     3702       if is-sug then leave .
     3703     end.
     3704     if is-sug then do:
     3705     output stream OutStr-html to value(v-report-name-html) append convert target 'UTF-8' .
     3706     put stream OutStr-html unformatted
     3707       '<tbody>' skip
     3708       '<tr>' skip
     3709       '<th text_wrap="true" colspan="22" style="text-align: center;">СУГ</th>' skip
     3710       '</tr>' skip
     3711       '<tr>' skip
     3712       '<th text_wrap="true" rowspan="3" style="text-align: center;">Наим продукта</th>' skip
     3713       '<th text_wrap="true" rowspan="3" style="text-align: center;">№ рез.</th>' skip
     3714       '<th text_wrap="true" rowspan="3" style="text-align: center;">ед. изм.</th>' skip.
     3715     put stream OutStr-html unformatted
     3716       '<th text_wrap="true" rowspan="3" style="text-align: center;">Расчетный остаток на нач. смены, кг</th>' skip.
     3717     put stream OutStr-html unformatted
     3718       '<th text_wrap="true" rowspan="3" style="text-align: center;">Поступило за смену, л/кг</th>' skip
     3719       '<th text_wrap="true" rowspan="2" colspan="7" style="text-align: center;">Обороты за смену</th>' skip
     3720       '<th text_wrap="true" colspan="4" style="text-align: center;">Потери</th>' skip
     3721       '<th text_wrap="true" rowspan="2" colspan="4" style="text-align: center;">Остаток на конец смены</th>' skip
     3722       '<th text_wrap="true" rowspan="2" colspan="2" style="text-align: center;">Величина небаланса, кг</th>' skip
     3723       '</tr>' skip
     3724       '<tr>' skip
     3725       '<th text_wrap="true" colspan="2" style="text-align: center;">к списанию</th>' skip
     3726       '<th text_wrap="true" colspan="2" style="text-align: center;">к начислению</th>' skip
     3727       '</tr>' skip
     3728       '<tr>' skip
     3729       '<th text_wrap="true" style="text-align: center;">Всего по счетчикам ГРК</th>' skip
     3730       '<th text_wrap="true" style="text-align: center;">Расход по кассе</th>' skip
     3731       '<th text_wrap="true" style="text-align: center;">Техпролив</th>' skip
     3732       '<th text_wrap="true" style="text-align: center;">Разница</th>' skip
     3733       '<th text_wrap="true" style="text-align: center;">Сброс (не пролито)</th>' skip
     3734       '<th text_wrap="true" style="text-align: center;">Сброс (пролито)</th>' skip
     3735       '<th text_wrap="true" style="text-align: center;">Перелив</th>' skip
     3736       '<th text_wrap="true" style="text-align: center;">При зачистке</th>' skip
     3737       '<th text_wrap="true" style="text-align: center;">Аварийные</th>' skip
     3738       '<th text_wrap="true" style="text-align: center;">За смену</th>' skip
     3739       '<th text_wrap="true" style="text-align: center;">Нарастающим итогом</th>' skip
     3740       '<th text_wrap="true" colspan="2" style="text-align: center;">Измеренный</th>' skip
     3741       '<th text_wrap="true" colspan="2" style="text-align: center;">Расчетный, кг.</th>' skip
     3742       '<th text_wrap="true" style="text-align: center;">Допускаемая</th>' skip
     3743       '<th text_wrap="true" style="text-align: center;">Фактическая</th>' skip
     3744       '</tr>' skip
     3745       '<tr>' skip
     3746       '<th style="text-align: center;">23</th>' skip
     3747       '<th style="text-align: center;">24</th>' skip
     3748       '<th style="text-align: center;">25</th>' skip
     3749       '<th style="text-align: center;">26</th>' skip
     3750       '<th style="text-align: center;">27</th>' skip
     3751       '<th style="text-align: center;">28</th>' skip
     3752       '<th style="text-align: center;">29</th>' skip
     3753       '<th style="text-align: center;">30</th>' skip
     3754       '<th style="text-align: center;">31</th>' skip
     3755       '<th style="text-align: center;">32</th>' skip
     3756       '<th style="text-align: center;">33</th>' skip
     3757       '<th style="text-align: center;">34</th>' skip
     3758       '<th style="text-align: center;">35</th>' skip
     3759       '<th style="text-align: center;">36</th>' skip
     3760       '<th style="text-align: center;">37</th>' skip
     3761       '<th style="text-align: center;">38</th>' skip
     3762       '<th colspan="2" style="text-align: center;">39</th>' skip
     3763       '<th colspan="2" style="text-align: center;">40</th>' skip
     3764       '<th style="text-align: center;">41</th>' skip
     3765       '<th style="text-align: center;">42</th>' skip
     3766       '</tr>' skip
     3767       .
     3768     for each temp-rvs-line break by temp-rvs-line.gds-code by temp-rvs-line.pl-code:
     3769       if first-of(temp-rvs-line.gds-code) and is-sug(temp-rvs-line.gds-code) then
     3770       do:
     3771         for each buf_temp-rvs-line where buf_temp-rvs-line.gds-code = temp-rvs-line.gds-code:
     3772           for each temp-line-pump where buf_temp-rvs-line.gds-code = temp-line-pump.gds-code
     3773             and temp-line-pump.pl-code = buf_temp-rvs-line.pl-code
     3774             and temp-line-pump.loc1 = buf_temp-rvs-line.place_loc1  :
     3775             find first buf_temp-line-pump where buf_temp-line-pump.gds-code = temp-line-pump.gds-code and buf_temp-line-pump.pump-code = temp-line-pump.pump-code
     3776               and buf_temp-line-pump.nozzle-code = temp-line-pump.nozzle-code and buf_temp-line-pump.loc1 <> temp-line-pump.loc1 no-error .
     3777             if available (buf_temp-line-pump) then
     3778             do:
     3779               if not temp-line-pump.log_ then
     3780                 assign
     3781                   buf_temp-rvs-line.pol61 = buf_temp-rvs-line.pol61 + (temp-line-pump.pol6 - temp-line-pump.pol7)
     3782                   buf_temp-line-pump.log_ = yes .
     3783             end.
     3784             assign
     3785               buf_temp-rvs-line.pol6    = buf_temp-rvs-line.pol6 + (temp-line-pump.pol6 - temp-line-pump.pol7)
     3786               buf_temp-rvs-line.pol8-l  = buf_temp-rvs-line.pol8-l + temp-line-pump.pol8-l
     3787               buf_temp-rvs-line.pol8-kg = buf_temp-rvs-line.pol8-kg + temp-line-pump.pol8-kg
     3788               buf_temp-rvs-line.pol10   = buf_temp-rvs-line.pol10 + temp-line-pump.pol10
     3789               buf_temp-rvs-line.pol11   = buf_temp-rvs-line.pol11 + temp-line-pump.pol11
     3790               buf_temp-rvs-line.pol12   = buf_temp-rvs-line.pol12 + temp-line-pump.pol12
     3791               buf_temp-rvs-line.pol7-l  = buf_temp-rvs-line.pol7-l + temp-line-pump.pol9-l
     3792               buf_temp-rvs-line.pol7-kg = buf_temp-rvs-line.pol7-kg + temp-line-pump.pol9-kg
     3793               buf_temp-rvs-line.pol9    = buf_temp-rvs-line.pol8-l + buf_temp-rvs-line.pol7-l - buf_temp-rvs-line.pol6
     3794               .
     3795           end.
     3796           assign
     3797             temp-rvs-line.itog-pol6     = temp-rvs-line.itog-pol6 + buf_temp-rvs-line.pol6 - buf_temp-rvs-line.pol61
     3798             temp-rvs-line.itog-pol4-l   = temp-rvs-line.itog-pol4-l + buf_temp-rvs-line.pol4-l-system
     3799             temp-rvs-line.itog-pol4-kg  = temp-rvs-line.itog-pol4-kg + buf_temp-rvs-line.pol4-kg-system
     3800             temp-rvs-line.itog-pol5-l   = temp-rvs-line.itog-pol5-l + buf_temp-rvs-line.pol5-l
     3801             temp-rvs-line.itog-pol5-kg  = temp-rvs-line.itog-pol5-kg + buf_temp-rvs-line.pol5-kg
     3802             temp-rvs-line.itog-pol8-l   = temp-rvs-line.itog-pol8-l + buf_temp-rvs-line.pol8-l
     3803             temp-rvs-line.itog-pol8-kg  = temp-rvs-line.itog-pol8-kg + buf_temp-rvs-line.pol8-kg
     3804             temp-rvs-line.itog-pol9     = temp-rvs-line.itog-pol9 + buf_temp-rvs-line.pol9 + buf_temp-rvs-line.pol61
     3805             temp-rvs-line.itog-pol10    = temp-rvs-line.itog-pol10 + buf_temp-rvs-line.pol10
     3806             temp-rvs-line.itog-pol11    = temp-rvs-line.itog-pol11 + buf_temp-rvs-line.pol11
     3807             temp-rvs-line.itog-pol12    = temp-rvs-line.itog-pol12 + buf_temp-rvs-line.pol12
     3808             temp-rvs-line.itog-pol13    = temp-rvs-line.itog-pol13 + buf_temp-rvs-line.pol13
     3809             temp-rvs-line.itog-pol7-l   = temp-rvs-line.itog-pol7-l + buf_temp-rvs-line.pol7-l
     3810             temp-rvs-line.itog-pol7-kg  = temp-rvs-line.itog-pol7-kg + buf_temp-rvs-line.pol7-kg
     3811             temp-rvs-line.itog-pol16-l  = temp-rvs-line.itog-pol16-l + buf_temp-rvs-line.pol16-l
     3812             temp-rvs-line.itog-pol16-kg = temp-rvs-line.itog-pol16-kg + buf_temp-rvs-line.pol16-kg
     3813             temp-rvs-line.itog-pol17-l  = temp-rvs-line.itog-pol17-l + buf_temp-rvs-line.pol17-l
     3814             temp-rvs-line.itog-pol17-kg = temp-rvs-line.itog-pol17-kg + buf_temp-rvs-line.pol17-kg
     3815             temp-rvs-line.itog-pol18    = temp-rvs-line.itog-pol17-kg / temp-rvs-line.itog-pol17-l
     3816             temp-rvs-line.itog-pol20-l  = temp-rvs-line.itog-pol20-l + buf_temp-rvs-line.pol20-l
     3817             temp-rvs-line.itog-pol20-kg = temp-rvs-line.itog-pol20-kg + buf_temp-rvs-line.pol20-kg
     3818             temp-rvs-line.itog-pol21-l  = temp-rvs-line.itog-pol21-l + buf_temp-rvs-line.pol21-l
     3819             temp-rvs-line.itog-pol21-kg = temp-rvs-line.itog-pol21-kg + buf_temp-rvs-line.pol21-kg .
     3820         end.
     3821         put stream OutStr-html unformatted
     3822           '<tr>' skip
     3823           '<td text_wrap="true" rowspan="2" style="text-align: right;">' + temp-rvs-line.gds-name + '</td>' skip
