     2647               .
     2648           end.
     2649         end.
     2650         else
     2651         do:
     2652           if temp-rvs-line.shift-date < ub.rvs-doc.shift-date
     2653             or ( temp-rvs-line.shift-date = ub.rvs-doc.shift-date
     2654             and temp-rvs-line.shift-num  < ub.rvs-doc.shift-num
     2655             )
     2656             then
     2657           do:
