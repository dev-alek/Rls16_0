     2680         temp-rvs-line.pol5-kg = 0
     2681         .
     2682       for each tt-pump-nozzle
     2683         on error undo, return error return-value
     2684         :
     2685         delete tt-pump-nozzle.
     2686       end.
     2687       if p-tog-1-whole-gds = true then
     2688       do:
     2689         assign
     2690           v-count   = 0
     2691           v-tot-cnt = 0
     2692           .
     2693         for each buf_temp-rvs-line
     2694           where buf_temp-rvs-line.gds-code = temp-rvs-line.gds-code
     2695           break by buf_temp-rvs-line.pl-code
     2696           on error undo, return error return-value
     2697           :
     2698           if first-of( buf_temp-rvs-line.pl-code ) then
     2699           do:
     2700             assign
     2701               v-count2 = 2
     2702               .
