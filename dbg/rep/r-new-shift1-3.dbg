      960   procedure gds-attr-exist :
      961     define input  parameter p-gds-code like ub.goods-attr.gds-code   no-undo .
      962     define input  parameter p-code     like ub.goods-attr.attr-code  no-undo .
      963     define output parameter p-exist    as logical no-undo .
      964     do
