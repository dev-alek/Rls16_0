      942   procedure gds-attr-write :
      943     define input parameter p-gds-code like ub.goods-attr.gds-code   no-undo .
      944     define input parameter p-code     like ub.goods-attr.attr-code  no-undo .
      945     define input parameter p-value    like ub.goods-attr.attr-value no-undo .
      946     do
      947     on error undo, return error
      948     :
      949           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-write in g#attr-lib
      950         (input  p-gds-code
      951         ,input  p-code
      952         ,input  p-value
      953         ) no-error .
