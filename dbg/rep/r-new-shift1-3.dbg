     2507     assign
     2508       pobj-type    = p-obj-type
     2509       pobj-code    = p-obj-code
     2510       pshift-date  = x-date-Start
     2511       pshift-num   = x-shift-Start
     2512       pshift-date1 = x-date-End
     2513       pshift-num1  = x-shift-End
     2514       .
     2515   define buffer end_shift-obj      for ub.shift-obj .
     2516   define buffer previous-shift-obj for ub.shift-obj.
     2517   define variable fo      as decimal no-undo init 0.
     2518   define variable prev-fo as decimal no-undo init 0.
     2519   define variable moving  as logical no-undo init yes.
     2520   find first end_shift-obj share-lock
     2521     where end_shift-obj.obj-type   = pobj-type
     2522       and end_shift-obj.obj-code   = pobj-code
     2523       and end_shift-obj.shift-date = pshift-date1
     2524       and end_shift-obj.shift-num  = pshift-num1
     2525       no-error.
     2526   if not available end_shift-obj then do:
     2527     message
     2528       vss-workfile vss-revision vss-description skip
     2529       substitute("Не найдена смена с порядковым номером &1 от &2 для объекта &3 &4", pshift-num1, pshift-date1, pobj-type, pobj-code ) skip
     2530       view-as alert-box error .
     2531     return error.
     2532   end.
     2533   else do:
     2534     assign
     2535       fo = end_shift-obj.fact-order
     2536     .
     2537   end.
     2538   find last previous-shift-obj share-lock
     2539     where previous-shift-obj.obj-type = pobj-type
     2540       and previous-shift-obj.obj-code = pobj-code
     2541       and (( previous-shift-obj.shift-date = pshift-date
     2542              and previous-shift-obj.shift-num < pshift-num
     2543            )
     2544            or previous-shift-obj.shift-date < pshift-date
     2545           )
     2546       use-index pi no-error.
     2547   if available previous-shift-obj then do:
     2548       assign
     2549         prev-fo = previous-shift-obj.fact-order
     2550       .
     2551   end.
     2552   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2553   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2554     (input  p-obj-type
     2555     ,input  p-obj-code
     2556     ,output p-host-code
     2557     )  .
     2558     v-InfoSectionsTotal = new InfoSectionsTotal().
     2559     v-InfoSection = new InfoSection().
