     2704               where buf_rvs-line-pump.rvs-code = buf_temp-rvs-line.rvs-code
     2705               and buf_rvs-line-pump.obj-code = buf_temp-rvs-line.obj-code
     2706               and buf_rvs-line-pump.obj-type = buf_temp-rvs-line.obj-type
     2707               and buf_rvs-line-pump.pl-code  = buf_temp-rvs-line.pl-code
     2708               and buf_rvs-line-pump.gds-code = buf_temp-rvs-line.gds-code
     2709               break by buf_rvs-line-pump.pl-code
     2710               on error undo, return error return-value
     2711               :
     2712               assign
     2713                 v-count2 = v-count2 + 1
     2714                 .
     2715             end.
     2716             if v-count = 0
     2717               and v-count2 < 4
     2718               then
     2719             do:
     2720               assign
     2721                 v-count2 = 4
     2722                 .
     2723             end.
     2724             assign
     2725               v-count   = v-count + v-count2
     2726               v-tot-cnt = v-tot-cnt + 1
     2727               .
     2728           end.
     2729         end.
     2730         if v-tot-cnt > 1 then
     2731         do:
     2732           assign
     2733             v-count = v-count + 2
     2734             .
     2735         end.
     2736       end.
     2737       if available previous-rvs-doc then
     2738       do:
     2739         find first previous-rvs-line  no-lock
     2740           where previous-rvs-line.rvs-code = previous-rvs-doc.rvs-code
     2741           and previous-rvs-line.gds-code = temp-rvs-line.gds-code
     2742           and previous-rvs-line.obj-code = temp-rvs-line.obj-code
     2743           and previous-rvs-line.obj-type = temp-rvs-line.obj-type
     2744           and previous-rvs-line.pl-code  = temp-rvs-line.pl-code
     2745           no-error .
     2746       end.
     2747       for each ub.rvs-line-pump no-lock
     2748         where ub.rvs-line-pump.rvs-code = temp-rvs-line.rvs-code
     2749         and ub.rvs-line-pump.gds-code = temp-rvs-line.gds-code
     2750         and ub.rvs-line-pump.obj-code = temp-rvs-line.obj-code
     2751         and ub.rvs-line-pump.obj-type = temp-rvs-line.obj-type
     2752         and ub.rvs-line-pump.pl-code  = temp-rvs-line.pl-code
     2753         :
     2754         for each ub.pl-gds-pump no-lock where ub.pl-gds-pump.pump-code = ub.rvs-line-pump.pump-code
     2755           and ub.pl-gds-pump.pl-code = ub.rvs-line-pump.pl-code
     2756           :
     2757           find first temp-line-pump where temp-line-pump.gds-code = rvs-line-pump.gds-code and temp-line-pump.pl-code = rvs-line-pump.pl-code and temp-line-pump.loc1
     2758             = temp-rvs-line.place_loc1 and temp-line-pump.pump-code    = ub.rvs-line-pump.pump-code and
     2759             temp-line-pump.nozzle-code  = ub.rvs-line-pump.nozzle-code no-error.
     2760           if not AVAILABLE temp-line-pump then
     2761           do:
     2762             create temp-line-pump .
     2763             assign
     2764               temp-line-pump.gds-code     = ub.rvs-line-pump.gds-code
     2765               temp-line-pump.pl-code      = ub.rvs-line-pump.pl-code
     2766               temp-line-pump.state-mh-cnt = ub.rvs-line-pump.state-mh-cnt
     2767               temp-line-pump.state-el-cnt = ub.rvs-line-pump.state-el-cnt
     2768               temp-line-pump.pol6         = temp-line-pump.state-mh-cnt
     2769               temp-line-pump.loc1         = temp-rvs-line.place_loc1
     2770               temp-line-pump.pump-code    = ub.rvs-line-pump.pump-code
     2771               temp-line-pump.nozzle-code  = ub.rvs-line-pump.nozzle-code
     2772               .
     2773           end.
     2774           else
     2775           do:
     2776             assign
     2777               temp-line-pump.state-mh-cnt = ub.rvs-line-pump.state-mh-cnt
     2778               temp-line-pump.state-el-cnt = ub.rvs-line-pump.state-el-cnt
     2779               temp-line-pump.pol6         = temp-line-pump.pol6 + temp-line-pump.state-mh-cnt
     2780               .
     2781           end.
     2782           if available previous-rvs-doc then
     2783           do:
     2784             Find FIRST previous-rvs-line-pump  No-LOCK WHERE
     2785               previous-rvs-line-pump.rvs-code = previous-rvs-doc.rvs-code AND
     2786               previous-rvs-line-pump.obj-code = temp-rvs-line.obj-code  and
     2787               previous-rvs-line-pump.obj-type = temp-rvs-line.obj-type  and
     2788               previous-rvs-line-pump.pl-code  = temp-rvs-line.pl-code AND
     2789               previous-rvs-line-pump.pump-code = ub.rvs-line-pump.pump-code AND
     2790               previous-rvs-line-pump.nozzle-code = ub.rvs-line-pump.nozzle-code No-ERROR.
     2791             IF available previous-rvs-line-pump then
     2792             do:
     2793               assign
     2794                 temp-line-pump.previous-state-mh-cnt = previous-rvs-line-pump.state-mh-cnt
     2795                 temp-line-pump.previous-state-el-cnt = previous-rvs-line-pump.state-el-cnt
     2796                 temp-line-pump.pol7                  = temp-line-pump.pol7 + temp-line-pump.previous-state-mh-cnt
     2797                 .
     2798             end.
     2799           end.
     2800           if not available previous-rvs-doc
     2801             or not available previous-rvs-line-pump
     2802             then
     2803           do:
     2804             for each control-rvs-doc no-lock
     2805               where control-rvs-doc.obj-type   = p-obj-type
     2806               and control-rvs-doc.obj-code   = p-obj-code
     2807               and control-rvs-doc.shift-date = x-date-start
     2808               and control-rvs-doc.shift-num  = x-shift-start
     2809               and control-rvs-doc.status_    = 'факт':U
     2810               and control-rvs-doc.rvs-type   = 'контроль':U
     2811               ,first control-rvs-line-pump no-lock
     2812               where control-rvs-line-pump.rvs-code = control-rvs-doc.rvs-code
     2813               and control-rvs-line-pump.gds-code = temp-rvs-line.gds-code
     2814               and control-rvs-line-pump.obj-code = temp-rvs-line.obj-code
     2815               and control-rvs-line-pump.obj-type = temp-rvs-line.obj-type
     2816               and control-rvs-line-pump.pl-code  = temp-rvs-line.pl-code
     2817               and control-rvs-line-pump.pump-code = ub.rvs-line-pump.pump-code
     2818               and control-rvs-line-pump.nozzle-code = ub.rvs-line-pump.nozzle-code
     2819               by control-rvs-doc.fact-order
     2820               :
     2821               assign
     2822                 temp-line-pump.previous-state-mh-cnt = control-rvs-line-pump.state-mh-cnt
     2823                 temp-line-pump.previous-state-el-cnt = control-rvs-line-pump.state-el-cnt
     2824                 temp-line-pump.pol7                  = temp-line-pump.pol7 + temp-line-pump.previous-state-mh-cnt
     2825                 .
     2826               leave.
     2827             end.
     2828           end.
     2829         end.
     2830       END.
     2831       _shift-chk:
     2832       FOR EACH buf_chk-doc
     2833         WHERE buf_chk-doc.obj-type = temp-rvs-line.obj-type
     2834         AND   buf_chk-doc.obj-code = temp-rvs-line.obj-code
     2835         AND   buf_chk-doc.shift-date >= x-date-Start
     2836         AND   buf_chk-doc.shift-date <= x-date-End
     2837         NO-LOCK
     2838         :
     2839         IF ( buf_chk-doc.shift-date = x-Date-Start
     2840           AND  buf_chk-doc.shift-num  < x-Shift-Start)
     2841           OR ( buf_chk-doc.shift-date = x-Date-End
     2842           AND  buf_chk-doc.shift-num  > x-Shift-End)
     2843           THEN
     2844         dO:
     2845           NEXT _shift-chk.
     2846         END.
     2847         run add-chk in this-procedure (
     2848           input buf_chk-doc.obj-type
     2849           , input buf_chk-doc.obj-code
     2850           , input buf_chk-doc.doc-code
     2851           , input buf_chk-doc.chk-type
     2852           , input temp-rvs-line.gds-code
     2853           , input temp-rvs-line.pl-code
     2854           , input temp-rvs-line.place_loc1
     2855           ) .
     2856       END.
     2857       if last-of(temp-rvs-line.pl-code ) then
     2858       do:
     2859         for each ub.trn-doc no-lock
     2860           where ub.trn-doc.obj-type   = temp-rvs-line.obj-type
     2861           and ub.trn-doc.obj-code   = temp-rvs-line.obj-code
     2862           and ub.trn-doc.shift-date >= x-date-Start
     2863           and ub.trn-doc.shift-date <= x-date-End
     2864           and ub.trn-doc.status_    = 'факт':U
     2865           and ub.trn-doc.doc-type   = 'при':U
     2866           on error undo, return error return-value
     2867           :
     2868           if ub.trn-doc.shift-date = x-date-Start and ub.trn-doc.shift-num < x-Shift-Start then next .
     2869           if ub.trn-doc.shift-date = x-date-End   and ub.trn-doc.shift-num > x-Shift-End then next .
     2870           for each ub.doc-pl no-lock
     2871             where ub.doc-pl.gds-code = temp-rvs-line.gds-code
     2872             and ub.doc-pl.obj-code = temp-rvs-line.obj-code
     2873             and ub.doc-pl.obj-type = temp-rvs-line.obj-type
     2874             and ub.doc-pl.out-code = ub.trn-doc.doc-code
     2875             and ub.doc-pl.pl-code  = temp-rvs-line.pl-code
     2876             on error undo, return error return-value
     2877             :
     2878             assign
     2879               temp-rvs-line.pol5-l  = temp-rvs-line.pol5-l + ub.doc-pl.fact-qnty
     2880               temp-rvs-line.pol5-kg = temp-rvs-line.pol5-kg + ub.doc-pl.cli-fact-qnty
     2881               .
     2882           end.
     2883         end.
     2884         for each buf_trn-doc no-lock
     2885           where buf_trn-doc.obj-type   = temp-rvs-line.obj-type
     2886           and buf_trn-doc.obj-code   = temp-rvs-line.obj-code
     2887           and buf_trn-doc.shift-date <= x-date-End
     2888           and buf_trn-doc.shift-num <= x-Shift-End
     2889           and buf_trn-doc.status_    = 'факт':U
     2890           and buf_trn-doc.doc-type   = 'при':U
     2891           and buf_trn-doc.fact-order > v-fact-order-inv
     2892           on error undo, return error return-value
     2893           :
     2894           for each ub.doc-pl no-lock
     2895             where ub.doc-pl.gds-code = temp-rvs-line.gds-code
     2896             and ub.doc-pl.obj-code = temp-rvs-line.obj-code
     2897             and ub.doc-pl.obj-type = temp-rvs-line.obj-type
     2898             and ub.doc-pl.out-code = buf_trn-doc.doc-code
     2899             and ub.doc-pl.pl-code  = temp-rvs-line.pl-code
     2900             on error undo, return error return-value
     2901             :
     2902             v-InfoSectionsTotal:Initialization(buf_trn-doc.doc-code, temp-rvs-line.gds-code).
     2903             v-InfoSectionsTotal:GetDBAllAttr().
     2904             do iNum = 1 to v-InfoSectionsTotal:SectionNum:
     2905               assign
     2906                 temp-rvs-line.pol21_tech = temp-rvs-line.pol21_tech + v-InfoSectionsTotal:GetInfoSectionProp(iNum):TPNorm
     2907                 .
     2908             end.
     2909           end.
     2910         end.
     2911         assign
     2912           temp-rvs-line.pol4-l-state   = 0
     2913           temp-rvs-line.pol4-kg-state  = 0
     2914           temp-rvs-line.pol4-l-system  = 0
     2915           temp-rvs-line.pol4-kg-system = 0
     2916           .
     2917         if available previous-rvs-line then
     2918         do:
     2919           assign
     2920             temp-rvs-line.pol4-l-state   = previous-rvs-line.state-measure-qnty + previous-rvs-line.state-add-qnty
     2921             temp-rvs-line.pol4-kg-state  = previous-rvs-line.state-measure-cli-qnty + previous-rvs-line.state-add-qnty * previous-rvs-line.state-density
     2922             temp-rvs-line.pol4-l-system  = previous-rvs-line.system-qnty
     2923             temp-rvs-line.pol4-kg-system = previous-rvs-line.system-cli-qnty
     2924             .
     2925         end.
     2926         Assign
     2927           temp-rvs-line.pol4-l-system  = (if p-param-shft-qty = "system":U then temp-rvs-line.pol4-l-system else temp-rvs-line.pol4-l-state)
     2928           temp-rvs-line.pol4-kg-system = (if p-param-shft-qty = "system":U then temp-rvs-line.pol4-kg-system else  temp-rvs-line.pol4-kg-state)
     2929           .
     2930         find first last-rvs-line no-lock
     2931           where last-rvs-line.rvs-code = last-rvs-doc.rvs-code
     2932           and last-rvs-line.gds-code = temp-rvs-line.gds-code
     2933           and last-rvs-line.obj-code = temp-rvs-line.obj-code
     2934           and last-rvs-line.obj-type = temp-rvs-line.obj-type
     2935           and last-rvs-line.pl-code  = temp-rvs-line.pl-code
     2936           no-error .
     2937         if available last-rvs-line
     2938           and ( p-param-shft-qty = "system":U
     2939           or p-param-shft-qty = "state-all-per":U
     2940           )
     2941           then
     2942         do:
     2943           assign
     2944             temp-rvs-line.pol20-l  = last-rvs-line.system-qnty
     2945             temp-rvs-line.pol20-kg = last-rvs-line.system-cli-qnty
     2946             .
     2947         end.
     2948         else
     2949         do:
     2950           if p-param-shft-qty = "state":U then
     2951           do:
     2952             assign
     2953               temp-rvs-line.pol20-l  = temp-rvs-line.pol4-l-state
     2954               temp-rvs-line.pol20-kg = temp-rvs-line.pol4-kg-state
     2955               .
     2956           end.
     2957           else
     2958           do:
     2959             assign
     2960               temp-rvs-line.pol20-l  = temp-rvs-line.pol4-l-system
     2961               temp-rvs-line.pol20-kg = temp-rvs-line.pol4-kg-system
     2962               .
     2963           end.
     2964           for each ub.trn-doc no-lock
     2965             where ub.trn-doc.obj-type   = temp-rvs-line.obj-type
     2966             and ub.trn-doc.obj-code   = temp-rvs-line.obj-code
     2967             and ub.trn-doc.shift-date >= x-date-Start
     2968             and ub.trn-doc.shift-date <= x-date-End
     2969             and ub.trn-doc.status_    = 'факт':U
     2970             on error undo, return error return-value
     2971             :
     2972             if ub.trn-doc.shift-date = x-date-Start and ub.trn-doc.shift-num < x-Shift-Start then next .
     2973             if ub.trn-doc.shift-date = x-date-End   and ub.trn-doc.shift-num > x-Shift-End then next .
     2974             for each ub.doc-pl no-lock
     2975               where ub.doc-pl.gds-code = temp-rvs-line.gds-code
     2976               and ub.doc-pl.obj-code = temp-rvs-line.obj-code
     2977               and ub.doc-pl.obj-type = temp-rvs-line.obj-type
     2978               and ub.doc-pl.out-code = ub.trn-doc.doc-code
     2979               and ub.doc-pl.pl-code  = temp-rvs-line.pl-code
     2980               on error undo, return error return-value
     2981               :
     2982               if lookup( ub.trn-doc.ext-doc-type, 'ee,ep,es,we,ev,em,wm,eo':U ) > 0 then
     2983               do:
     2984                 assign
     2985                   v-sign = -1.0
     2986                   .
     2987               end.
     2988               else
     2989               do:
     2990                 assign
     2991                   v-sign = 1.0
     2992                   .
     2993                 if lookup( ub.trn-doc.ext-doc-type, 'ie,re,rs,vt,vp,ap,mp,pc,iv,rv,im,io':U ) = 0 then
     2994                 do:
     2995                   undo, return error substitute( '&1. Тип "&2" не внесен в списки документов уменьшающих(увеличивающих) остатки!', vss-workfile, ub.trn-doc.ext-doc-type).
     2996                 end.
     2997               end.
     2998               if ( p-param-shft-qty = "state":U
     2999                 and ub.trn-doc.doc-type <> 'инв':U
     3000                 )
     3001                 or p-param-shft-qty = "system":U
     3002                 or p-param-shft-qty = "state-all-per":U
     3003                 then
     3004               do:
     3005                 assign
     3006                   temp-rvs-line.pol20-l  = temp-rvs-line.pol20-l + ub.doc-pl.fact-qnty * v-sign
     3007                   temp-rvs-line.pol20-kg = temp-rvs-line.pol20-kg + ub.doc-pl.cli-fact-qnty * v-sign
     3008                   .
     3009               end.
     3010             end.
     3011           end.
     3012         end.
     3013         define variable is-vir  as logical   no-undo.
     3014         define variable v-value as character no-undo.
     3015         define variable v-ok    as logical   no-undo.
     3016         run placelib_get-attr(input "place-virtual"
     3017           ,input temp-rvs-line.obj-code
     3018           ,input temp-rvs-line.obj-type
     3019           ,input temp-rvs-line.pl-code
     3020           ,output v-value
     3021           ,output v-ok) no-error.
     3022         is-vir = if (v-ok and logical(v-value)) then true else false.
     3023         if is-vir then
     3024         do:
     3025           if available last-rvs-line then
     3026           do:
     3027             temp-rvs-line.pol20-l = last-rvs-line.system-qnty.
     3028             temp-rvs-line.pol20-kg = last-rvs-line.system-cli-qnty.
     3029           end.
     3030         end.
     3031         assign
     3032           temp-rvs-line.pol18    = temp-rvs-line.state-density
     3033           temp-rvs-line.pol17-l  = temp-rvs-line.state-measure-qnty + temp-rvs-line.state-add-qnty
     3034           temp-rvs-line.pol17-kg = temp-rvs-line.state-measure-cli-qnty + temp-rvs-line.state-add-qnty * temp-rvs-line.pol18
     3035           temp-rvs-line.pol13    = temp-rvs-line.state-add-qnty
     3036           .
     3037         temp-rvs-line.pol21-l = temp-rvs-line.pol17-l - temp-rvs-line.pol20-l .
     3038         temp-rvs-line.pol21-kg = temp-rvs-line.pol17-kg - temp-rvs-line.pol20-kg .
     3039         find first buf_rvs-line-attr no-lock where buf_rvs-line-attr.obj-code = temp-rvs-line.obj-code
     3040           and buf_rvs-line-attr.obj-type = temp-rvs-line.obj-type
     3041           and buf_rvs-line-attr.gds-code = temp-rvs-line.gds-code
     3042           and buf_rvs-line-attr.pl-code = temp-rvs-line.pl-code
     3043           and buf_rvs-line-attr.rvs-code = temp-rvs-line.rvs-code
     3044           and buf_rvs-line-attr.attr-code = "delta-mass-qnty" no-error .
     3045         if AVAILABLE buf_rvs-line-attr then
     3046         do:
     3047           temp-rvs-line.pol22 = (temp-rvs-line.pol17-kg * decimal(buf_rvs-line-attr.attr-value)) / 100 .
     3048         end.
     3049       End.
     3050   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     3051     (input  'stfactpl'
     3052     ,input  0
     3053     ,input  ''
     3054     ,input  0
     3055     ,input  ''
     3056     ,input  ''
     3057     ,input  ''
     3058     ,input  no
     3059     ,output stfactplvalue
     3060     ,output stfactpltype
     3061     ) no-error .
     3062       if stfactplvalue <> ""  then
     3063       do:
     3064   if (valid-handle(g#lib-calc) <> true) then do:   run str/lib-calc.p persistent no-error .   if error-status :error or (valid-handle(g#lib-calc) <> true) then do:     message       "Error starting lib-calc.p" skip       g#lib-calc skip       g#lib-calc :type skip       g#lib-calc :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-calc_chkqtpl in g#lib-calc
     3065     (  input stfactplvalue
     3066     , output v-update
     3067     , output v-revision
     3068     , output v-percrev
     3069     , output v-auto-tank
     3070     , output v-percauto
     3071     , output v-inv
     3072     , output v-percinv
     3073     , output v-inv-set
     3074     ) no-error .
     3075         if error-status :error then
     3076         do:
     3077           message
     3078             vss-workfile vss-revision vss-description skip
     3079             "Разборе строки параметра stfactpl" skip
     3080             error-status :get-message(1) skip
     3081             return-value skip
     3082             view-as alert-box error .
     3083           return error .
     3084         end.
     3085       end.
     3086       if v-percauto <> ? then
     3087       do:
     3088         assign
     3089           temp-rvs-line.fact-pl = v-percauto
     3090           .
     3091       end.
     3092       else
     3093         assign
     3094           temp-rvs-line.fact-pl = 0.65
     3095           .
     3096     end.
     3097     run print-total .
     3098     run print-sug .
     3099   procedure print-total:
     3100     define variable v-value         as character no-undo.
     3101     define variable v-ok            as logical   no-undo.
     3102     define variable v-com-tanks     as character no-undo .
     3103     define variable v-main-tanks    as character no-undo .
     3104     define variable v-num-com-tanks as integer   no-undo .
     3105     output stream OutStr-html to value(v-report-name-html) append convert target 'UTF-8' .
     3106     put stream OutStr-html unformatted
     3107       '<tbody>' skip
     3108       '<tr>' skip
     3109       '<th text_wrap="true" colspan="23" style="text-align: center;">Нефтепродукты: бензины и ДТ</th>' skip
     3110       '</tr>' skip
     3111       '<tr>' skip
