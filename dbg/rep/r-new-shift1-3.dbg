     2564       and last-rvs-doc.shift-date = x-date-end
     2565       and last-rvs-doc.shift-num  = x-shift-end
     2566       and last-rvs-doc.status_    = 'факт':U
     2567       and last-rvs-doc.rvs-type   = 'смена':U
     2568       no-error.
     2569     if not available last-rvs-doc then
     2570     do:
     2571         if p-batch > 0 then do:      run write-log-and-file in p-log-handle (                 input 1                                          , input p-log-file-name                              , input 1                                          , input substitute("&1 &2 &3&4Не найдена сменная сверка&4объект &5&6 смена &7 &8"                                 ,vss-workfile                                 ,vss-revision                                 ,vss-description                                ,chr(10)                                ,p-obj-type                                 ,p-obj-code                                 ,string(x-date-End, "99/99/9999")                                ,x-shift-end )).    end.    else do:       run write-to-log in p-log-handle ( input substitute("&1 &2 &3&4Не найдена сменная сверка&4объект &5&6 смена &7 &8"                                 ,vss-workfile                                 ,vss-revision                                 ,vss-description                                ,chr(10)                                ,p-obj-type                                 ,p-obj-code                                 ,string(x-date-End, "99/99/9999")                                ,x-shift-end )).    end.
     2572       if valid-handle(p-parent-handle)
     2573         and lookup("cb_write-report-error", p-parent-handle:internal-entries) > 0
     2574         and valid-handle(p-rebh) then
     2575       do:
     2576         run cb_write-report-error in p-parent-handle ( input p-rebh
     2577           ,input v-report-name-html
     2578           ,input ?
     2579           ,input '3':U
     2580           ,input substitute("&1 &2 &3&4Не найдена сменная сверка&4объект &5&6 смена &7 &8"                                 ,vss-workfile                                 ,vss-revision                                 ,vss-description                                ,chr(10)                                ,p-obj-type                                 ,p-obj-code                                 ,string(x-date-End, "99/99/9999")                                ,x-shift-end )).
     2581       end.
     2582       return error.
     2583     END.
     2584     if available previous-shift-obj then
     2585     do:
     2586       find first previous-rvs-doc no-lock
     2587         where previous-rvs-doc.obj-type   = p-obj-type
     2588         and previous-rvs-doc.obj-code   = p-obj-code
     2589         and previous-rvs-doc.shift-date = previous-shift-obj.shift-date
     2590         and previous-rvs-doc.shift-num  = previous-shift-obj.shift-num
     2591         and previous-rvs-doc.status_    = 'факт':U
     2592         and previous-rvs-doc.rvs-type   = 'смена':U
     2593         no-error.
     2594     end.
     2595     define temp-table temp-shift-obj no-undo like ub.shift-obj
     2596       FIELD num as integer
     2597       INDEX ii IS UNIQUE num
     2598       .
     2599     for each ub.rvs-doc no-lock
     2600       where ub.rvs-doc.obj-type   = p-obj-type
     2601       and ub.rvs-doc.obj-code   = p-obj-code
     2602       and ub.rvs-doc.shift-date >= x-date-Start
     2603       and ub.rvs-doc.shift-date <= x-date-End
     2604       and ub.rvs-doc.status_    = 'факт':U
     2605       and ub.rvs-doc.rvs-type   = 'смена':U
     2606       on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     2607       :
     2608       if ub.rvs-doc.shift-date = x-date-Start and ub.rvs-doc.shift-num < x-Shift-Start then next .
     2609       if ub.rvs-doc.shift-date = x-date-End   and ub.rvs-doc.shift-num > x-Shift-End then next .
     2610       for each ub.rvs-line no-lock
     2611         where ub.rvs-line.rvs-code = ub.rvs-doc.rvs-code
     2612         on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     2613         :
     2614         find first temp-rvs-line
     2615           where temp-rvs-line.pl-code  = ub.rvs-line.pl-code
     2616           and temp-rvs-line.gds-code = ub.rvs-line.gds-code
     2617           no-error .
     2618         if not available temp-rvs-line then
     2619         do:
     2620           create temp-rvs-line .
     2621           buffer-copy ub.rvs-line to temp-rvs-line .
     2622           find first ub.goods no-lock
     2623             where ub.goods.gds-code = ub.rvs-line.gds-code
     2624             no-error.
     2625           assign
     2626             temp-rvs-line.gds-name   = ub.goods.gds-name
     2627             temp-rvs-line.artic      = ub.goods.artic
     2628             temp-rvs-line.prod-type  = ub.goods.prod-type
     2629             temp-rvs-line.prod-code  = ub.goods.prod-code
     2630             temp-rvs-line.shift-date = ub.rvs-doc.shift-date
     2631             temp-rvs-line.shift-num  = ub.rvs-doc.shift-num
     2632             .
     2633   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     2634     (input  ub.goods.gds-code
     2635     ,input  ?
     2636     ,output temp-rvs-line.v-bar-code
     2637     )  .
     2638           find first ub.place no-lock
     2639             where ub.place.obj-code = p-obj-code
     2640             and ub.place.obj-type = p-obj-type
     2641             and ub.place.pl-code  = ub.rvs-line.pl-code
     2642             no-error.
     2643           if available ub.place then
     2644           do:
     2645             assign
