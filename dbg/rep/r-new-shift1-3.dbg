     3681             temp-rvs-line.itog-pol20-l     = 0
     3682             temp-rvs-line.itog-pol20-kg    = 0
     3683             temp-rvs-line.itog-pol21_nebal = 0
     3684             temp-rvs-line.itog-pol21_tech  = 0
     3685             .
