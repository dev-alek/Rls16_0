     1621   procedure c-place_get-attr :
     1622     define input parameter attr-code as character no-undo .
     1623     define input parameter obj-code as integer no-undo .
     1624     define input parameter obj-type as character no-undo .
     1625     define input parameter pl-code as integer no-undo .
     1626     define input parameter endDate as date no-undo .
     1627     define input parameter endTime as integer no-undo .
     1628     define output parameter attr-value as character no-undo .
     1629     define buffer bf_c-place-attr for ub.c-place-attr .
     1630     define variable is-place-attr as logical no-undo .
     1631     find last bf_c-place-attr no-lock where bf_c-place-attr.pl-code = pl-code and
     1632       bf_c-place-attr.obj-code = obj-code and
     1633       bf_c-place-attr.obj-type = obj-type and
     1634       bf_c-place-attr.attr-code = attr-code and
     1635       ((bf_c-place-attr.corr-date = endDate and
     1636       bf_c-place-attr.corr-time < endTime) or
     1637       bf_c-place-attr.corr-date < endDate) no-error .
     1638     if available (bf_c-place-attr) then attr-value = bf_c-place-attr.attr-value .
     1639     else attr-value = "true" .
     1640   end procedure.
     1641   FUNCTION get_max-qnty returns decimal (
     1642     input obj-code as integer,
     1643     input obj-type as character,
     1644     input pl-code as integer,
     1645     input endDate as date,
     1646     input endTime as integer ):
     1647     define buffer bf_c-place     for ub.c-place .
     1648     define buffer buf_c-place    for ub.c-place .
     1649     define buffer bf_place       for ub.place .
     1650     define buffer curr_c-place   for c-place .
     1651     define buffer buf_c-plc-hist for ub.c-plc-hist .
     1652     define variable ii      as integer no-undo init 0.
     1653     define variable is-max-qnty as logical no-undo .
     1654     define variable is-true as logical no-undo .
     1655     find last curr_c-place no-lock where curr_c-place.pl-code = pl-code and
     1656       curr_c-place.obj-code = obj-code and
     1657       curr_c-place.obj-type = obj-type and
     1658       ((curr_c-place.corr-date = endDate and
     1659       curr_c-place.corr-time < endTime) or
     1660       curr_c-place.corr-date < endDate) no-error .
     1661     if available (curr_c-place) then
     1662     do:
     1663       find first buf_c-plc-hist no-lock where
     1664         buf_c-plc-hist.obj-type = obj-type
     1665         AND buf_c-plc-hist.obj-code = obj-code
     1666         AND buf_c-plc-hist.pl-code = pl-code
     1667         AND buf_c-plc-hist.subject  = "place"
     1668         and buf_c-plc-hist.chip-num = curr_c-place.chip-num no-error .
     1669       if available (buf_c-plc-hist) then
     1670       do:
     1671         define variable v-label-param as character no-undo .
     1672         v-label-param =
     1673           "max-qnty" + chr(4) + "Максимальное количество" + chr(4) + "" .
     1674         run proc-full-temp-changes in this-procedure (
     1675           input buf_c-plc-hist.action = integer('1':U)
     1676           ,input buf_c-plc-hist.action = integer('99':U)
     1677           ,input  buffer curr_c-place:handle
     1678           ,input  'place':U
     1679           ,input  "max-qnty"
     1680           ,input  v-label-param).
     1681       end.
     1682     end.
     1683     for each with-action:
     1684       return decimal(with-action.v_new) .
     1685     end.
     1686     if available (curr_c-place) then
     1687     do:
     1688       return curr_c-place.max-qnty .
     1689     end.
     1690     find first bf_place no-lock where bf_place.pl-code = pl-code and
     1691       bf_place.obj-code = obj-code and
     1692       bf_place.obj-type = obj-type no-error .
     1693     return bf_place.max-qnty .
     1694   end function.
     1695   FUNCTION get_meas returns logical (
     1696     input obj-code as integer,
     1697     input obj-type as character,
     1698     input pl-code as integer,
     1699     input endDate as date,
     1700     input endTime as integer ):
     1701     define buffer bf_c-place     for ub.c-place .
     1702     define buffer buf_c-place    for ub.c-place .
     1703     define buffer bf_place       for ub.place .
     1704     define buffer curr_c-place   for c-place .
     1705     define buffer buf_c-plc-hist for ub.c-plc-hist .
     1706     define variable ii      as integer no-undo init 0.
     1707     define variable is-meas as logical no-undo .
     1708     define variable is-true as logical no-undo .
     1709     find last curr_c-place no-lock where curr_c-place.pl-code = pl-code and
     1710       curr_c-place.obj-code = obj-code and
     1711       curr_c-place.obj-type = obj-type and
     1712       ((curr_c-place.corr-date = endDate and
     1713       curr_c-place.corr-time < endTime) or
     1714       curr_c-place.corr-date < endDate) no-error .
     1715     if available (curr_c-place) then
     1716     do:
     1717       find first buf_c-plc-hist no-lock where
     1718         buf_c-plc-hist.obj-type = obj-type
     1719         AND buf_c-plc-hist.obj-code = obj-code
     1720         AND buf_c-plc-hist.pl-code = pl-code
     1721         AND buf_c-plc-hist.subject  = "place"
     1722         and buf_c-plc-hist.chip-num = curr_c-place.chip-num no-error .
     1723       if available (buf_c-plc-hist) then
     1724       do:
     1725         define variable v-label-param as character no-undo .
     1726         v-label-param =
     1727           "is-meas" + chr(4) + "Измеряется приборами" + chr(4) + "" .
     1728         run proc-full-temp-changes in this-procedure (
     1729           input buf_c-plc-hist.action = integer('1':U)
     1730           ,input buf_c-plc-hist.action = integer('99':U)
     1731           ,input  buffer curr_c-place:handle
     1732           ,input  'place':U
     1733           ,input  "is-meas"
     1734           ,input  v-label-param).
     1735       end.
     1736     end.
     1737     for each with-action:
     1738       return logical (with-action.v_new) .
     1739     end.
     1740     find first bf_place no-lock where bf_place.pl-code = pl-code and
     1741       bf_place.obj-code = obj-code and
     1742       bf_place.obj-type = obj-type no-error .
     1743     return bf_place.is-meas .
     1744   end function.
     1745   FUNCTION get_com-vessel returns logical (
     1746     input obj-code as integer,
     1747     input obj-type as character,
     1748     input attr-code as character,
     1749     input pl-code as integer,
     1750     input openDate as date,
     1751     input endDate as date,
     1752     input openTime as integer,
     1753     input endTime as integer ):
     1754     define buffer current_c-place-attr for c-place-attr .
     1755     define buffer buf_c-plc-hist       for ub.c-plc-hist .
     1756     define variable ii      as integer   no-undo init 0.
     1757     define variable is-meas as logical   no-undo .
     1758     define variable is-true as logical   no-undo .
     1759     define variable v-label as character no-undo .
     1760     define variable p-ok    as logical   no-undo .
     1761     find last current_c-place-attr no-lock where
     1762       current_c-place-attr.obj-type = obj-type
     1763       AND current_c-place-attr.obj-code = obj-code
     1764       AND current_c-place-attr.pl-code = pl-code
     1765       and current_c-place-attr.attr-code = attr-code
     1766       and ((current_c-place-attr.corr-date = endDate
     1767       and current_c-place-attr.corr-time < endTime) or
     1768       current_c-place-attr.corr-date < endDate)
     1769       no-error .
     1770     if avail current_c-place-attr then
     1771     do:
     1772       find first buf_c-plc-hist no-lock where
     1773         buf_c-plc-hist.obj-type = obj-type
     1774         AND buf_c-plc-hist.obj-code = obj-code
     1775         AND buf_c-plc-hist.pl-code = pl-code
     1776         AND buf_c-plc-hist.subject  = "place-attr"
     1777         and buf_c-plc-hist.chip-num = current_c-place-attr.chip-num no-error .
     1778       if available (buf_c-plc-hist) then
     1779       do:
     1780         define variable v-label-param as character no-undo .
     1781         if current_c-place-attr.attr-code = "place-SI"
     1782           or current_c-place-attr.attr-code = "place-SI-temp"
     1783           or current_c-place-attr.attr-code = "place-SI-dens"
     1784           or current_c-place-attr.attr-code = "place-SI-level"
     1785           then
     1786         do :
     1787           v-label-param =
     1788             "attr-value" + chr(4) + "Значение атрибута" + chr(4) + "getSIname" + chr(8)
     1789             + "attr-code" + chr(4) + "Код атрибута" + chr(4) + "getPlaceAttrCode"   .
     1790         end .
     1791         else
     1792         do :
     1793           v-label-param =
     1794             "attr-value" + chr(4) + "Значение атрибута" + chr(4) + "getPlaceAttrValue" + chr(8)
     1795             + "attr-code" + chr(4) + "Код атрибута" + chr(4) + "getPlaceAttrCode" + chr(8)
     1796             + "PS" + chr(4) + "Примечание" + chr(4) + "" + chr(8)
     1797             + "status_" + chr(4) + "Статус" + chr(4) + ""  .
     1798         end .
     1799         run proc-full-temp-changes in this-procedure (
     1800           input buf_c-plc-hist.action = integer('1':U)
     1801           ,input buf_c-plc-hist.action = integer('99':U)
     1802           ,input  buffer current_c-place-attr:handle
     1803           ,input  'place-attr':U
     1804           ,input  "attr-code,attr-value,PS,status_"
     1805           ,input  v-label-param).
     1806       end.
     1807     end.
     1808     for each with-action:
     1809       p-ok = logical (with-action.v_new) no-error .
     1810       if error-status:error then p-ok = false .
     1811       return   p-ok .
     1812     end.
     1813     return no .
     1814   end function.
     1815   FUNCTION get_com-tanks returns character (
     1816     input obj-code as integer,
     1817     input obj-type as character,
     1818     input attr-code as character,
     1819     input pl-code as integer,
     1820     input openDate as date,
     1821     input endDate as date,
     1822     input openTime as integer,
     1823     input endTime as integer ):
     1824     define buffer current_c-place-attr for ub.c-place-attr .
     1825       define buffer buf_c-plc-hist       for ub.c-plc-hist .
     1826     define variable ii        as integer   no-undo init 0.
     1827     define variable is-meas   as logical   no-undo .
     1828     define variable is-true   as logical   no-undo .
     1829     define variable v-label   as character no-undo .
     1830     define variable p-ok as character no-undo .
     1831     find last current_c-place-attr no-lock where
     1832       current_c-place-attr.obj-type = obj-type
     1833       AND current_c-place-attr.obj-code = obj-code
     1834       AND current_c-place-attr.pl-code = pl-code
     1835       and current_c-place-attr.attr-code = attr-code
     1836       and ((current_c-place-attr.corr-date = endDate
     1837       and current_c-place-attr.corr-time < endTime) or
     1838       current_c-place-attr.corr-date < endDate)
     1839       no-error .
     1840     if avail current_c-place-attr then
     1841     do:
     1842       find first buf_c-plc-hist no-lock where
     1843         buf_c-plc-hist.obj-type = obj-type
     1844         AND buf_c-plc-hist.obj-code = obj-code
     1845         AND buf_c-plc-hist.pl-code = pl-code
     1846         AND buf_c-plc-hist.subject  = "place-attr"
     1847         and buf_c-plc-hist.chip-num = current_c-place-attr.chip-num no-error .
     1848       if available (buf_c-plc-hist) then
     1849       do:
     1850         define variable v-label-param as character no-undo .
     1851         if current_c-place-attr.attr-code = "place-SI"
     1852           or current_c-place-attr.attr-code = "place-SI-temp"
     1853           or current_c-place-attr.attr-code = "place-SI-dens"
     1854           or current_c-place-attr.attr-code = "place-SI-level"
     1855           then
     1856         do :
     1857           v-label-param =
     1858             "attr-value" + chr(4) + "Значение атрибута" + chr(4) + "getSIname" + chr(8)
     1859             + "attr-code" + chr(4) + "Код атрибута" + chr(4) + "getPlaceAttrCode"   .
     1860         end .
     1861         else
     1862         do :
     1863           v-label-param =
     1864             "attr-value" + chr(4) + "Значение атрибута" + chr(4) + "getPlaceAttrValue" + chr(8)
     1865             + "attr-code" + chr(4) + "Код атрибута" + chr(4) + "getPlaceAttrCode" + chr(8)
     1866             + "PS" + chr(4) + "Примечание" + chr(4) + "" + chr(8)
     1867             + "status_" + chr(4) + "Статус" + chr(4) + ""  .
     1868         end .
     1869         run proc-full-temp-changes in this-procedure (
     1870           input buf_c-plc-hist.action = integer('1':U)
     1871           ,input buf_c-plc-hist.action = integer('99':U)
     1872           ,input  buffer current_c-place-attr:handle
     1873           ,input  'place-attr':U
     1874           ,input  "attr-code,attr-value,PS,status_"
     1875           ,input  v-label-param).
     1876       end.
     1877     end.
     1878     for each with-action:
     1879        p-ok = with-action.v_new no-error .
     1880        if error-status:error then p-ok = "" .
     1881       return   p-ok .
     1882     end.
     1883     return "" .
     1884   end function.
     1885   function getSIname returns character (si-code as char) :
     1886     for first sr-izmerenia no-lock where sr-izmerenia.node-code = integer(si-code) :
     1887       return sr-izmerenia.sr-model .
     1888     end .
     1889   end .
     1890   function  getPlaceAttrCode returns character (istr as char ):
     1891     define variable OStr as character no-undo.
     1892     if istr eq "disable-level-alarm"
     1893       then
     1894       OStr = "Сообщения о переполнении".
     1895     else if istr eq "disable-water-alarm"
     1896         then
     1897         OStr = "Сообщения по воде".
     1898       else if istr eq "place-need-RVD-rvs"
     1899           then
     1900           OStr = "Необходимо сделать сверку с РВД".
     1901         else if istr eq "place-SI-level"
     1902             then
     1903             OStr = "Доп. средство измерения уровня".
     1904           else if istr eq "place-SI-dens"
     1905               then
     1906               OStr = "Доп. средство измерения плотности".
     1907             else if istr eq "place-SI-temp"
     1908                 then
     1909                 OStr = "Доп. средство измерения температуры".
     1910               else if istr eq "place-SI"
     1911                   then
     1912                   OStr = "Основное средство измерения".
     1913                 else
     1914                   OStr = istr.
     1915     return OStr.
     1916   end.
     1917   function  getPlaceAttrValue returns character (istr as char ):
     1918     define variable OStr  as character no-undo.
     1919     define variable vFlag as logical   no-undo.
     1920     if    entry(1,istr,chr(4)) eq "enable"
     1921       then
     1922       assign
     1923         OStr  = "Включено"
     1924         vFlag = yes
     1925         .
     1926     else if    entry(1,istr,chr(4)) eq "disable"
     1927         then
     1928         assign
     1929           OStr  = "Выключено"
     1930           vFlag = yes
     1931           .
     1932       else
     1933         OStr = istr.
     1934     if     vFlag
     1935       and num-entries (istr,chr(4)) > 2
     1936       then
     1937       OStr = OStr + " для смены № " + entry(3,istr,chr(4)) + " Дата " + entry(2,istr,chr(4)).
     1938     return OStr.
     1939   end.
     1940   PROCEDURE proc-full-temp-changes :
     1941     define input  parameter p-act-create as logical   no-undo .
     1942     define input  parameter p-act-delete as logical   no-undo .
     1943     define input  parameter p-hst-handle as handle    no-undo .
     1944     define input  parameter p-main-table as character no-undo .
     1945     define input  parameter p-field-list as character no-undo .
     1946     define input  parameter p-label-form as character no-undo .
     1947     define variable h-new-buf         as handle    no-undo .
     1948     define variable h-main-buf        as handle    no-undo .
     1949     define variable h-for-comp        as handle    no-undo .
     1950     define variable v-inform          as character no-undo .
     1951     define variable v-ind             as integer   no-undo .
     1952     define variable v-idx-field-qnty  as integer   no-undo .
     1953     define variable v-num-entries     as integer   no-undo .
     1954     define variable fh                as handle    no-undo .
     1955     define variable fh-main           as handle    no-undo .
     1956     define variable fh-old            as handle    no-undo .
     1957     define variable fh-new            as handle    no-undo .
     1958     define variable v-field-name      as character no-undo .
     1959     define variable v-field-lvl       as character no-undo .
     1960     define variable v-field-form      as character no-undo .
     1961     define variable v-search-exp      as character no-undo .
     1962     define variable v-srch-main       as character no-undo .
     1963     define variable v-word-link       as character no-undo .
     1964     define variable v-av-chip-num     as logical   no-undo .
     1965     define variable v-main-pi-fld-lst as character no-undo .
     1966     define variable v-main-fld-lst    as character no-undo .
     1967     define variable v-delim-list      as character no-undo .
     1968     define variable v-label           as character no-undo .
     1969     define variable v-old-value       as character no-undo case-sensitive.
     1970     define variable v-new-value       as character no-undo case-sensitive.
     1971     define variable v-chg-fields      as character no-undo.
     1972     for each with-action:
     1973       delete with-action.
     1974     end.
     1975     if not p-hst-handle:available then
     1976     do:
     1977       return .
     1978     end.
     1979     create buffer h-new-buf  for table p-hst-handle .
     1980     create buffer h-main-buf for table p-main-table .
     1981     assign
     1982       v-inform = h-main-buf:index-information(1)
     1983       v-ind    = 2
     1984       .
     1985     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1986       on error undo, return error
     1987       :
     1988       assign
     1989         v-inform = h-main-buf:index-information( v-ind )
     1990         v-ind    = v-ind + 1
     1991         .
     1992     end.
     1993     if v-inform = ?
     1994       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1995       or entry( 3, v-inform, ",":U ) <> "1":U
     1996       then
     1997     do:
     1998       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, h-main-buf:name ).
     1999     end.
     2000     assign
     2001       v-idx-field-qnty = num-entries( v-inform ) - 4
     2002       .
     2003     if v-idx-field-qnty < 2 then
     2004     do:
     2005       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, h-main-buf:name ).
     2006     end.
     2007     assign
     2008       v-srch-main   = "where":U
     2009       v-word-link   = "":U
     2010       v-av-chip-num = false
     2011       v-delim-list  = "":U
     2012       .
     2013     do v-ind = 1 to v-idx-field-qnty by 2
     2014       on error undo, return error
     2015       :
     2016       assign
     2017         v-field-name      = entry( 4 + v-ind, v-inform, ",":U )
     2018         fh                = p-hst-handle:buffer-field( v-field-name )
     2019         fh-main           = h-main-buf:buffer-field( v-field-name )
     2020         v-srch-main       = substitute( "&1 &2 &3.&4 =", v-srch-main, v-word-link, fh-main:table, v-field-name )
     2021         v-main-pi-fld-lst = v-main-pi-fld-lst + v-delim-list + v-field-name
     2022         .
     2023       if fh:data-type ="character":U then
     2024       do:
     2025         assign
     2026           v-srch-main = substitute( '&1 "&2"', v-srch-main, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     2027           .
     2028       end.
     2029       else
     2030       do:
     2031         assign
     2032           v-srch-main = substitute( "&1 &2", v-srch-main, fh:buffer-value() )
     2033           .
     2034       end.
     2035       if v-delim-list = "":U then
     2036       do:
     2037         assign
     2038           v-delim-list = ",":U
     2039           .
     2040       end.
     2041       if v-word-link = "":U then
     2042       do:
     2043         assign
     2044           v-word-link = "and":U
     2045           .
     2046       end.
     2047     end.
     2048     assign
     2049       v-delim-list = "":U
     2050       .
     2051     do v-ind = 1 to h-main-buf:num-fields
     2052       on error undo, return error
     2053       :
     2054       assign
     2055         fh-main      = h-main-buf:buffer-field( v-ind )
     2056         v-field-name = fh-main:name
     2057         .
     2058       assign
     2059         v-main-fld-lst = v-main-fld-lst + v-delim-list + v-field-name
     2060         .
     2061       if v-delim-list = "":U then
     2062       do:
     2063         assign
     2064           v-delim-list = ",":U
     2065           .
     2066       end.
     2067     end.
     2068     assign
     2069       v-inform = p-hst-handle:index-information(1)
     2070       v-ind    = 2
     2071       .
     2072     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     2073       on error undo, return error
     2074       :
     2075       assign
     2076         v-inform = p-hst-handle:index-information( v-ind )
     2077         v-ind    = v-ind + 1
     2078         .
     2079     end.
     2080     if v-inform = ?
     2081       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     2082       or entry( 3, v-inform, ",":U ) <> "1":U
     2083       then
     2084     do:
     2085       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, p-hst-handle:name ).
     2086     end.
     2087     assign
     2088       v-idx-field-qnty = num-entries( v-inform ) - 4
     2089       .
     2090     if v-idx-field-qnty < 2 then
     2091     do:
     2092       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, p-hst-handle:name ).
     2093     end.
     2094     assign
     2095       v-search-exp  = "where":U
     2096       v-word-link   = "":U
     2097       v-av-chip-num = false
     2098       .
     2099     do v-ind = 1 to v-idx-field-qnty by 2
     2100       on error undo, return error
     2101       :
     2102       assign
     2103         v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     2104         fh           = p-hst-handle:buffer-field( v-field-name )
     2105         v-search-exp = substitute( "&1 &2 &3.&4", v-search-exp, v-word-link, fh:table, v-field-name )
     2106         .
     2107       if v-field-name = "chip-num":U then
     2108       do:
     2109         assign
     2110           v-search-exp  = substitute( "&1 >", v-search-exp )
     2111           v-av-chip-num = true
     2112           .
     2113       end.
     2114       else
     2115       do:
     2116         assign
     2117           v-search-exp = substitute( "&1 =", v-search-exp )
     2118           .
     2119       end.
     2120       if fh:data-type ="character":U then
     2121       do:
     2122         assign
     2123           v-search-exp = substitute( '&1 "&2"', v-search-exp, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     2124           .
     2125       end.
     2126       else
     2127       do:
     2128         assign
     2129           v-search-exp = substitute( '&1 &2', v-search-exp, fh:buffer-value() )
     2130           .
     2131       end.
     2132       if v-word-link = "":U then
     2133       do:
     2134         assign
     2135           v-word-link = "and":U
     2136           .
     2137       end.
     2138     end.
     2139     if v-av-chip-num = false then
     2140     do:
     2141       message
     2142         vss-workfile vss-revision vss-description skip
     2143         substitute( "Таблица &2 не содержит поля chip-num.", vss-workfile, p-hst-handle:name ) skip
     2144         "Использование данной процедуры невозможно!" skip
     2145         view-as alert-box error .
     2146       return error .
     2147     end.
     2148     h-new-buf:find-first( v-search-exp, no-lock ) no-error .
     2149     if not h-new-buf:available then
     2150     do:
     2151       h-main-buf:find-first( v-srch-main, no-lock ) no-error .
     2152       if not h-main-buf:available then
     2153       do:
     2154         assign
     2155           h-for-comp = ?
     2156           .
     2157       end.
     2158       else
     2159       do:
     2160         assign
     2161           h-for-comp = h-main-buf
     2162           .
     2163       end.
     2164     end.
     2165     else
     2166     do:
     2167       assign
     2168         h-for-comp = h-new-buf
     2169         .
     2170     end.
     2171     assign
     2172       v-num-entries = num-entries( v-main-fld-lst, ",":U )
     2173       .
     2174     do v-ind = 1 to v-num-entries
     2175       on error undo, return error return-value
     2176       :
     2177       assign
     2178         v-field-name = entry( v-ind, v-main-fld-lst )
     2179         fh-old       = p-hst-handle:buffer-field( v-field-name )
     2180         v-old-value  = fh-old:buffer-value()
     2181         v-label      = trim( fh-old:label )
     2182         .
     2183       if ( trim( p-field-list ) <> "":U
     2184         and lookup( v-field-name, p-field-list ) > 0
     2185         )
     2186         or trim( p-field-list ) = "":U
     2187         then
     2188       do:
     2189         if h-for-comp <> ? then
     2190         do:
     2191           assign
     2192             fh-new      = h-for-comp:buffer-field( v-field-name )
     2193             v-new-value = fh-new:buffer-value()
     2194             .
     2195         end.
     2196         else
     2197         do:
     2198           assign
     2199             v-new-value = "":U
     2200             .
     2201         end.
     2202         if p-act-create = true then
     2203         do:
     2204           assign
     2205             v-old-value = "":U
     2206             .
     2207         end.
     2208         if p-act-delete = true then
     2209         do:
     2210           assign
     2211             v-new-value = "":U
     2212             .
     2213         end.
     2214         if v-old-value <> v-new-value
     2215           then
     2216         do:
     2217           create with-action.
     2218           assign
     2219             with-action.t_name     = p-main-table
     2220             with-action.f_name     = v-field-name
     2221             with-action.l_name     = replace( v-label, "&":U, "":U )
     2222             with-action.v_old      = trim( v-old-value )
     2223             with-action.v_new      = trim( v-new-value )
     2224             with-action.num_       = 0
     2225             with-action.fNotChange = v-old-value eq v-new-value
     2226             .
     2227         end.
     2228       end.
     2229     end.
     2230     assign
     2231       v-num-entries = num-entries( p-label-form, chr(8) )
     2232       .
     2233     do v-ind = 1 to v-num-entries
     2234       on error undo, return error return-value
     2235       :
     2236       if num-entries( entry( v-ind, p-label-form, chr(8) ), chr(4) ) = 3 then
     2237       do:
     2238         assign
     2239           v-field-name = entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     2240           v-field-lvl  = entry( 2, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     2241           v-field-form = entry( 3, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     2242           .
     2243         find first with-action
     2244           where with-action.f_name = v-field-name
     2245           no-error .
     2246         if available with-action then
     2247         do:
     2248           if trim( v-field-lvl ) <> "":U then
     2249           do:
     2250             assign
     2251               with-action.l_name = v-field-lvl
     2252               .
     2253           end.
     2254           if trim( v-field-form ) <> "":U then
     2255           do:
     2256             assign
     2257               with-action.v_old = dynamic-function( v-field-form, with-action.v_old )
     2258               .
     2259             if h-for-comp <> ? then
     2260             do:
     2261               assign
     2262                 with-action.v_new = dynamic-function( v-field-form, with-action.v_new )
     2263                 .
     2264             end.
     2265           end.
     2266         end.
     2267       end.
     2268       else
     2269       do:
     2270         message
     2271           vss-workfile vss-revision vss-description skip
     2272           "Ошибка! Список должен содержать три поля с разделителем delim-par!" skip
     2273           substitute( "список для поля '&1': '&2'"
     2274           ,entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     2275           ,entry( v-ind, p-label-form, chr(8) )
     2276           ) skip
     2277           substitute( "полный список: &2", p-label-form ) skip
     2278           view-as alert-box error .
     2279       end.
     2280     end.
     2281     delete object h-new-buf .
     2282     delete object h-main-buf .
     2283   END PROCEDURE.
     2284     define variable v-stfactpl          as character no-undo initial "":U .
     2285     define variable v-data-type         as character no-undo initial "":U .
     2286     define variable v-update            as logical   no-undo initial yes  .
