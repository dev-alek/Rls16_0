      939               "|" space(1)
      940               "Заведующий производством"
      941               ":"                                               at 10 + 70
      942               space(1) "подпись"
      943               ":"                                               at 10 + 80
      944               "|"                                               at 10 + 119
      945           skip space(10)
      946               "|"
      947               v-single-line   format "X(117)"
      948               "|"
      949           skip space(10)
      950               "|" space(1)
      951               "Калькуляцию составил"
      952               ":"                                               at 10 + 70
      953               space(1) "подпись"
      954               ":"                                               at 10 + 80
      955               "|"                                               at 10 + 119
      956           skip space(10)
      957               "|"
      958               v-single-line   format "X(117)"
      959               "|"
      960           skip space(10)
      961               "|" space (1)
      962               "УТВЕРЖДАЮ. Руководитель организации"
      963               ":"                                               at 10 + 70
      964               space(1) "подпись"
      965               ":"                                               at 10 + 80
      966               "|"                                               at 10 + 119
      967           skip space(10)
      968               v-single-line   format "X(119)"
      969           .
      970           hide stream out-stream frame BottomFrame .
      971           v-rep-util:end-report().
      972       end.
      973       output stream Out-Stream close.
      974   if session :set-wait-state( "" ) then.
      975   if g#quest-print = false
      976   then do:
      977     run adecomm/_osprint.p ( ?, string( session:temp-directory + "rpt" + string( g#report-num ) ),
      978                                         7, (if 4 >= 8 then 2 else 0), 0, 0,
      979                                         OUTPUT g#log ).
      980   end.
      981   else do:
      982     os-command silent
      983       value( "COPY /b " +
      984         string( session:temp-directory) +  "$" + string( g#report-num ) + " + " +
      985         string( session:temp-directory) + "rpt" + string( g#report-num ) + " " +
      986         string( session:temp-directory) +  "$" + string( g#report-num )
      987                 ) .
      988     os-command silent
      989       value( "COPY /b " +
      990         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl" + " + " +
      991         string( session:temp-directory) + "rpt" + string( g#report-num ) + ".txl" + " " +
      992         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl"
      993                 ) .
      994   end.
      995   end.
      996   procedure print-header-numbers :
      997   do
      998   on error undo, return error
      999   :
     1000   def input parameter p-single-line as char    no-undo.
     1001   def input parameter p-need-line   as logical no-undo.
     1002       if p-need-line = yes
     1003       then put stream out-stream
     1004           skip
     1005             string( "Страница " + string( PAGE-NUMBER( Out-Stream ), ">>9" ) ) format "X(13)" at right-field( 10 + 119, 13)
     1006           skip space(10)
     1007             p-single-line format "X(119)"
     1008       .
     1009       put stream out-stream
     1010           skip space(10)
     1011             "|"
     1012             "1"                  at center-field( 10 + 1, 10 + 5, 1)
     1013             ":"                  at 10 + 5
     1014             "2"                  at center-field( 10 + 5, 10 + 22, 1)
     1015             ":"                  at 10 + 22
     1016             "3"                  at center-field( 10 + 22, 10 + 70, 1)
     1017             ":"                  at 10 + 70
     1018             "4"                  at center-field( 10 + 70, 10 + 80, 1)
     1019             ":"                  at 10 + 80
     1020             "5"                  at center-field( 10 + 80, 10 + 90, 1)
     1021             ":"                  at 10 + 90
     1022             "6"                  at center-field( 10 + 90, 10 + 104, 1)
     1023             ":"                  at 10 + 104
     1024             "7"                  at center-field( 10 + 104, 10 + 119, 1)
     1025             "|"                  at 10 + 119
     1026           skip space(10)
     1027             "|"
     1028             p-single-line format "X(117)"
     1029             "|"                  at 10 + 119
     1030       .
     1031   end.
     1032   end procedure.
     1033   procedure write-itog :
     1034   do
     1035   on error undo, return error
     1036   :
     1037       def input parameter p-type          as char no-undo.
     1038       def input parameter p-in-mass       as decimal no-undo.
     1039       def input parameter p-in-sum        as decimal no-undo.
     1040       def input parameter p-out-norm-mass as decimal no-undo.
     1041       def input parameter p-out-fact-mass as decimal no-undo.
     1042       def input parameter p-out-fact-sum  as decimal no-undo.
     1043       put stream Out-Stream
     1044         skip space(10)
     1045           v-single-line format "X(119)"
     1046       .
     1047   end.
     1048   end procedure.
     1049   procedure check-all-weight-kg :
     1050   do
     1051   on error undo, return error
     1052   :
     1053   define input parameter p-fbr-doc-doc-code       as character    no-undo.
     1054   define input parameter p-recipe-code            as character    no-undo.
     1055   define output parameter p-no-printable-recipe   as logical      no-undo.
     1056       define variable v-is-weight     as logical init no    no-undo.
     1057       define buffer  buf_fbr-line for ub.fbr-line.
     1058       define buffer  buf_goods    for ub.goods.
     1059       define buffer  buf_units    for ub.units.
     1060           assign
     1061               p-no-printable-recipe = no
     1062           .
     1063           for each buf_fbr-line
     1064              where buf_fbr-line.doc-code     = p-fbr-doc-doc-code
     1065                and buf_fbr-line.is-comp      = no
     1066                and buf_fbr-line.recipe-code  = p-recipe-code
     1067           :
     1068               find first buf_goods
     1069                    where buf_goods.artic      = buf_fbr-line.artic
     1070                      and buf_goods.prod-type  = buf_fbr-line.prod-type
     1071                      and buf_goods.prod-code  = buf_fbr-line.prod-code
     1072               .
     1073               if buf_goods.gds-type <> 'у':U
     1074               then do:
     1075                   assign
     1076                       v-is-weight = no
     1077                   .
     1078                   for each buf_units no-lock
     1079                      where buf_units.type = 'вес':U
     1080                   :
     1081                       if buf_goods.unit-base = buf_units.unit-name
     1082                       then do:
     1083                           assign
     1084                               v-is-weight = yes
     1085                           .
     1086                       end.
     1087                   end.
     1088                   if v-is-weight = no
     1089                   then do:
     1090                       assign
     1091                           p-no-printable-recipe = yes
     1092                       .
     1093                       leave.
     1094                   end.
     1095               end.
     1096           end.
     1097   end.
     1098   end procedure.
     1099   procedure print-title :
     1100   define input parameter p-recipe-code    as character        no-undo.
     1101   define input parameter p-fbr-doc-status as character        no-undo.
     1102       define buffer buf_temp_recipe       for temp_recipe.
     1103   do
     1104   for buf_temp_recipe
     1105   on error undo, return error
     1106   :
     1107       find first buf_temp_recipe
     1108            where buf_temp_recipe.recipe-code = p-recipe-code
     1109       .
     1110       v-rep-gen:add-element("v-organization", v-organization).
     1111       v-rep-gen:add-element("t-okpo", t-okpo).
     1112       v-rep-gen:add-element("v-org-name", v-org-name).
     1113       v-rep-gen:add-element("buf_temp_recipe.recipe-name", buf_temp_recipe.recipe-name).
     1114       v-rep-gen:add-element("buf_temp_recipe.recipe-code", buf_temp_recipe.recipe-code).
     1115       v-rep-gen:add-element("buf_temp_recipe.recipe-type", buf_temp_recipe.recipe-type).
     1116       v-rep-gen:add-element("v-doc-code", v-doc-code).
     1117       v-rep-gen:add-element("p-recipe-code", p-recipe-code).
     1118       v-rep-gen:add-element("v-fact-date", if v-fact-date = ? then "" else string(v-fact-date)).
     1119       v-rep-gen:add-element("p-fbr-doc-status", p-fbr-doc-status).
     1120       def var tmp1 as char no-undo.
     1121       tmp1 = ( if p-fbr-doc-status <> 'факт':U then substitute( " Статус: &1", p-fbr-doc-status ) else "":U ).
     1122       def var tmp2 as char no-undo.
     1123       tmp2 = (if CostPrice        =  no      then substitute( " Цены реализации" )              else "":U).
     1124       v-rep-gen:add-element("status1", tmp1 + " " + tmp2).
     1125       put stream Out-Stream
     1126           skip
     1127           string( "Страница " + string( PAGE-NUMBER( Out-Stream ), ">>9" ) ) format "X(13)" at right-field( 10 + 119, 13)
     1128           skip
     1129           space(10) v-single-line format  "X(16)"             at 114
     1130           skip
     1131           space(10) "| "                                      at 114
     1132                           'код':U                               at center-field(114, 10 + 119, length('код':U))
     1133                           "|"                                       at 10 + 119
     1134           skip
     1135           space(10) "Форма по ОКУД" format "X(14)"            at right-field(114, 13)
     1136                           "| "                                      at 114
     1137                           "0330501"                                 at center-field(114, 10 + 119, 7)
     1138                           "|"                                       at 10 + 119
     1139           skip
     1140           space(10) "Организация:               "
     1141                   v-organization                format "X(60)"
     1142                   "по ОКПО"                                      at right-field(114, 7)
     1143                   "|"                                            at 114
     1144                   trim(t-okpo)                  format "X(10)"   at right-field( 10 + 119, 10)
     1145                   "|"                                            at 10 + 119
     1146           skip
     1147           space(10) "Структурное подразделение: "
     1148                           v-org-name              format "X(60)"
     1149                           "|"                                       at 114
     1150                           "|"                                       at 10 + 119
     1151           skip
     1152           space(10) "Вид деятельности по ОКДП"
     1153                                                   format "X(25)"    at right-field(114, 25)
     1154                           "|"                                       at 114
     1155                           "|"                                       at 10 + 119
     1156           skip
     1157           space(10) "Наименование блюда:        "
     1158                           buf_temp_recipe.recipe-name           format "X(60)"
     1159                           "|"                                       at 114
     1160                           "|"                                       at 10 + 119
     1161           skip
     1162           space(10) "Номер блюда по сборнику рецептур"
     1163                                                   format "X(32)"    at right-field(114, 32)
     1164                           "|"                                       at 114
     1165                           buf_temp_recipe.recipe-code           format "X(8)"     at center-field(114, 10 + 119, 8)
     1166                           "|"                                       at 10 + 119
     1167           skip
     1168           space(10) "Вид операции"          format "X(12)"    at right-field(114, 12)
     1169                           "|"                                       at 114
     1170                           buf_temp_recipe.recipe-type           format "X(12)"    at center-field(114, 10 + 119, 12)
     1171                           "|"                                       at 10 + 119
     1172           skip
     1173           space(10) v-single-line           format  "X(16)"   at 114
     1174       .
     1175       put stream Out-Stream
     1176           skip space(10)
     1177               v-single-line   format  "X(46)"   at 50 + 1
     1178           skip space(50)
     1179               "|"
     1180               "Номер"                           at  center-field(50, 50 + 20, 5)
     1181               "|"                               at 50 + 20
     1182               "Номер"                           at  center-field(50 + 20, 50 + 33, 5)
     1183               "|"                               at 50 + 33
     1184               "Дата"                            at  center-field(50 + 33, 50 + 46, 4)
     1185               "|"                               at 50 + 46
     1186           skip space(50)
     1187               "|"
     1188               "документа"     format "X(9)"     at  center-field(50, 50 + 20, 9)
     1189               "|"                               at 50 + 20
     1190               "рецепта"       format "X(7)"     at  center-field(50 + 20, 50 + 33, 7)
     1191               "|"                               at 50 + 33
     1192               "составления"   format "X(11)"    at  center-field(50 + 33, 50 + 46, 11)
     1193               "|"                               at 50 + 46
     1194           skip space(50)
     1195               "|"
     1196               v-single-line   format "X(44)"
     1197               "|"  at 50 + 46
     1198           skip
     1199               space(25) "КАЛЬКУЛЯЦИОННАЯ КАРТОЧКА | "
     1200               v-doc-code format "X(16)"
     1201               " | "
     1202               fill( " ", 10 - length( p-recipe-code ) ) + p-recipe-code
     1203                               format "X(10)"            at  right-field( 50 + 33, 10)
     1204               "| "                                      at 50 + 33
     1205               v-fact-date     format "99/99/9999"
     1206               "|"                                       at 50 + 46
     1207               ( tmp1 ) format "X(15)"
     1208               ( tmp2 ) format "X(16)"
     1209           skip space(10)
     1210               v-single-line   format  "X(46)"      at 50 + 1
     1211       .
     1212   end.
     1213   end procedure.
     1214   procedure print-header :
     1215   do
     1216   on error undo, return error
     1217   :
     1218           put stream Out-Stream
     1219             skip space(10)
     1220               v-single-line format "X(119)"
     1221             skip space(10)
     1222                 "|"
     1223                 ":"                                  at 10 + 5
     1224                 "Продукты"                           at center-field( 10 + 5, 10 + 80, 8)
     1225                 ":"                                  at 10 + 80
     1226                 ":"                                  at 10 + 90
     1227                 ":"                                  at 10 + 104
     1228               "|"                                    at 10 + 119
     1229             skip space(10)
     1230                 "|"
     1231                 "Но-"
     1232                 ":"                                  at 10 + 5
     1233                 v-single-line format "X(74)"
     1234                 ":"                                  at 10 + 80
     1235                 "норма"                              at center-field( 10 + 80, 10 + 90, 5)
     1236                 ":"                                  at 10 + 90
     1237                 "цена,"                              at center-field( 10 + 90, 10 + 104, 5)
     1238                 ":"                                  at 10 + 104
     1239                 "сумма,"                             at center-field( 10 + 104, 10 + 119, 6)
     1240                 "|"                                  at 10 + 119
     1241             skip space(10)
     1242                 "|"
     1243                 "мер"
     1244                 ":"                                  at 10 + 5
     1245                 "Артикул"                            at center-field( 10 + 5, 10 + 22, 7)
     1246                 ":"                                  at 10 + 22
     1247                 "Наименование"                       at center-field( 10 + 22, 10 + 70, 12)
     1248                 ":"                                  at 10 + 70
     1249                 "Код"                                at center-field( 10 + 70, 10 + 80, 3)
     1250                 ":"                                  at 10 + 80
     1251                 ":"                                  at 10 + 90
     1252                 "руб.коп"            at center-field( 10 + 90, 10 + 104, 7)
     1253                 ":"                                  at 10 + 104
     1254                 "руб.коп"            at center-field( 10 + 104, 10 + 119, 7)
     1255                 "|"                                  at 10 + 119
     1256             skip space(10)
     1257               "|"
     1258               v-single-line format "X(117)"
     1259               "|" at 10 + 119
     1260           .
     1261   end.
     1262   end procedure.
     1263   procedure print-line :
     1264   define input parameter p-line-counter as integer          no-undo.
     1265   define input parameter p-goods-artic  as character        no-undo.
     1266   define input parameter p-goods-name   as character        no-undo.
     1267   define input parameter p-bar-code     as character        no-undo.
     1268   define input parameter p-mass         as decimal          no-undo.
     1269   define input parameter p-cost         as decimal          no-undo.
     1270   define input parameter p-sum          as decimal          no-undo.
     1271   do
     1272   on error undo, return error
     1273   :
     1274       v-rep-gen:start-element("table").
     1275       v-rep-gen:add-element("p-line-counter", string(p-line-counter, ">>9")).
     1276       v-rep-gen:add-element("p-goods-artic", p-goods-artic).
     1277       v-rep-gen:add-element("p-goods-name", p-goods-name).
     1278       v-rep-gen:add-element("p-bar-code", string(p-bar-code, "X(9)")).
     1279       v-rep-gen:add-element("p-mass", string(p-mass, ">,>>9.999")).
     1280       v-rep-gen:add-element("p-cost", string(p-cost, ">>,>>>,>>9.99")).
     1281       v-rep-gen:add-element("p-sum", string(p-sum, ">>>,>>>,>>9.99")).
     1282       v-rep-gen:end-element("table").
     1283       put stream out-stream
     1284           skip space(10)
     1285               "|"
     1286               p-line-counter    format ">>9"
     1287               ":"                                  at 10 + 5
     1288               p-goods-artic     format "X(16)"
     1289               ":"                                  at 10 + 22
     1290               p-goods-name      format "X(47)"
     1291               ":"                                  at 10 + 70
     1292               p-bar-code        format "X(9)"
     1293               ":"                                  at 10 + 80
     1294               p-mass            format ">,>>9.999"
     1295               ":"                                  at 10 + 90
     1296               p-cost            format ">>,>>>,>>9.99"
     1297               ":"                                  at 10 + 104
     1298               p-sum             format ">>>,>>>,>>9.99"
     1299               "|"                                  at 10 + 119
     1300       .
     1301   end.
     1302   end procedure.
