      779                      and buf_fbr-recipe-gds.prod-type   = buf_fbr-line.prod-type
      780                      and buf_fbr-recipe-gds.prod-code   = buf_fbr-line.prod-code
      781                      and buf_fbr-recipe-gds.artic       = buf_fbr-line.artic
      782               no-error.
      783               if available buf_fbr-recipe-gds
      784               then do:
      785                   assign
