      489       find first buf_fbr-doc no-lock
      490           where recid(buf_fbr-doc) = p-recid
      491       no-error.
      492       if not available buf_fbr-doc
      493       then do:
      494           message
      495               "Не найден документ производства."
      496               skip (1) "Форму ОП-1 напечатать невозможно."
      497           view-as alert-box.
      498           undo, return.
      499       end.
      500       if buf_fbr-doc.is-free = yes
      501       then do:
      502           message
      503               "Калькуляционная карточка не может быть напечатана"
      504               skip "для документа производства без рецептов."
      505           view-as alert-box error.
      506           undo, return error .
      507       end.
      508       assign
      509           v-single-line  = fill("-", 230)
      510           v-underline    = fill("_", 230)
      511       .
      512       assign
      513           v-doc-code     = buf_fbr-doc.doc-code
      514           v-fact-date    = buf_fbr-doc.fact-date
      515       .
      516       find first buf_clients no-lock
      517           where buf_clients.obj-type = buf_fbr-doc.obj-type
      518           and buf_clients.obj-code = buf_fbr-doc.obj-code
      519       no-error.
      520       case buf_clients.obj-type :
      521           when 'маг':U then
      522               do:
      523                   find first shop no-lock
      524                       where shop.obj-code = buf_clients.obj-code
      525                   .
      526               end.
      527           when 'скл':U then
      528               do:
      529                   find first store no-lock
      530                       where store.obj-code = buf_clients.obj-code
      531                   .
      532               end.
      533       end case.
      534       assign
      535           v-org-name = buf_clients.obj-name
      536       .
      537   if session :set-wait-state( "compiler" ) then.
      538   output stream Out-Stream to value( string( session:temp-directory +
      539                                        "rpt" + string( g#report-num ) ) )
      540                                        page-size  value(62) .
      541       form header
      542           v-single-line format "X(119)" at 1 skip
      543           "Продолжение - на следующей странице" at 30 skip
      544           with frame BottomFrame width 235 page-bottom no-labels no-box .
      545       view stream Out-Stream frame BottomFrame .
      546       find first clients no-lock
      547           where clients.obj-type = 'орг':U
      548           and clients.obj-code = buf_fbr-doc.host-code
      549       .
      550       case clients.obj-type:
      551          when 'орг':U
      552          then do:
      553               FIND ub.firm WHERE ub.firm.firm-code = clients.obj-code NO-LOCK .
      554               if available ub.firm
      555               then do:
      556                   assign
      557                       t-addres = ( if ub.firm.ind = 0 or ub.firm.ind = ? then "" else string( ub.firm.ind ) )
      558                       t-addres = t-addres
      559                           + ( if ub.firm.city = ? or trim(ub.firm.city) = ""
      560                               then ""
      561                               else ( (if t-addres = "" then "" else ", ") + trim( ub.firm.city ) )
      562                             )
      563                       t-temp-address = ( if ub.firm.addres1 = ? then "" else trim( substring( ub.firm.addres1, 1, 50 ) ) )
      564                       t-addres = t-addres + ( if t-addres = "" or t-temp-address = "" then "" else ", " )
      565                           + ( if t-temp-address = "" then "" else ( trim( t-temp-address ) ) )
      566                           + ( if  ub.firm.addres2 = ? or trim(ub.firm.addres2) = "" then "" else ( ", " + trim( ub.firm.addres2 ) ) )
      567                       t-temp-address = ( if ub.firm.addres1 = ? then "" else trim( substring( ub.firm.addres1, 51, 50 ) ) )
      568                       t-addres = t-addres + ( if t-addres = "" or t-temp-address = "" then "" else ", " )
      569                           + ( if t-temp-address = "" then "" else ( trim( t-temp-address ) ) )
      570                       t-temp-address = ( if ub.firm.addres1 = ? then "" else trim( substring( ub.firm.addres1, 101, 50 ) ) )
      571                       t-addres = t-addres + ( if t-addres = "" or t-temp-address = "" then "" else ", " )
      572                           + ( if t-temp-address = "" then "" else ( trim( t-temp-address ) ) )
      573                       t-phone = ub.firm.phone
      574                       t-inn   = ub.firm.inn
      575                       t-okpo  = ub.firm.okpo
      576                   .
      577               end.
      578          end.
      579          when 'маг':U
      580          then do:
      581               FIND ub.shop WHERE ub.shop.obj-code = clients.obj-code NO-LOCK .
      582               if available ub.shop
      583               then do:
      584                   assign
      585                       t-addres = ( if trim( shop.addres1 ) <> "" then ( trim( shop.addres1 ) ) else "" )
      586                               + ( if trim( shop.addres2 ) <> "" then ( ", " + trim( shop.addres2 ) ) else "" )
      587                       t-phone = shop.phone
      588                       t-inn = ""
      589                       t-okpo = ""
      590                   .
      591               end.
      592          end.
      593          when 'скл':U
      594          then do:
      595               FIND ub.store WHERE ub.store.obj-code = clients.obj-code NO-LOCK .
      596               if available ub.store
      597               then do:
      598                   assign
      599                       t-addres = ( if trim( ub.store.addres1 ) <> "" then ( trim( ub.store.addres1 ) ) else "" )
      600                               + ( if trim( ub.store.addres2 ) <> "" then ( ", " + trim( ub.store.addres2 ) ) else "" )
      601                       t-phone = ub.store.phone
      602                       t-inn = ""
      603                       t-okpo = ""
      604                   .
      605               end.
      606          end.
      607          when 'чел':U
      608          then do:
      609               find ub.person where ub.person.psn-code = clients.obj-code no-lock .
      610               if available ub.person
      611               then do:
      612                   assign
      613                       t-addres = ( if ub.person.ind <> 0 and ub.person.ind <> ? then string( ub.person.ind ) else "" )
      614                                   + ( if  ub.person.city <> ? and trim(ub.person.city) <> "" then ( ", " + trim( ub.person.city ) ) else "" )
      615                                   + ( if  ub.person.address <> ? and trim(ub.person.address) <> "" then ( ", " + trim( ub.person.address ) ) else "" )
      616                       t-phone = ub.person.phone1
      617                       t-inn = ub.person.inn
      618                       t-okpo = ub.person.okpo
      619                   .
      620               end.
      621          end.
      622       end case.
      623       assign
      624           v-organization = string( "ИНН " + t-inn + " " + CAPS( clients.obj-name ) + " (" + string(clients.obj-code) + ")"
      625                       + t-addres + t-phone)
      626       .
      627       fill-temp-recipe:
      628       for each buf_fbr-line no-lock
      629          where buf_fbr-line.doc-code = buf_fbr-doc.doc-code
      630            and buf_fbr-line.is-comp  = yes
      631       :
