      788                                   then 0
      789                                   else buf_fbr-recipe-gds.brutto-qnty
      790                                 )
      791                   .
      792                   if buf_fbr-recipe-gds.is-waste <> yes
      793                   then do:
      794                       if not costprice then
      795                           do:
