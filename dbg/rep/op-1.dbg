       95   define temp-table temp_p-fmt_string-part no-undo
       96       field str-key       as integer
       97       field string-part   as character
       98       index pi is primary unique
       99           str-key
      100   .
      101   define variable v-p-fmt-2-str-key    as integer      no-undo.
      102   FUNCTION center-field RETURNS INTEGER (INPUT iStartPix AS INTEGER, iEndPix AS INTEGER,
      103                                     iInput AS INTEGER).
      104     def var v-start-print as integer no-undo .
      105     if (iStartPix < 0) or (iEndPix < iStartPix) then return 0.
      106     assign
      107       v-start-print = INTEGER(iStartPix + ((iEndPix - iStartPix) / 2) - (iInput / 2))
      108     .
      109     RETURN v-start-print .
      110   END FUNCTION.
      111   FUNCTION right-field RETURNS INTEGER ( iEndPix AS INTEGER,
      112                                     iInput AS INTEGER).
      113     def var v-start-print as integer no-undo .
      114     assign
      115       v-start-print = INTEGER(iEndPix - 1 - iInput)
      116     .
      117     if v-start-print < 0 then return 0.
      118     RETURN v-start-print .
      119   END FUNCTION.
      120   function p-fmt-align-string returns character (
      121         p-in-string      as character
      122       , p-page-width     as integer
      123       , p-align-type     as character
      124   ).
      125       define variable v-string-length     as integer      no-undo.
      126       define variable v-out-string        as character    no-undo.
      127       assign
      128           v-string-length = length( trim( p-in-string ) )
      129       .
      130       if v-string-length >= p-page-width
      131       then do:
      132           assign
      133               v-out-string = trim( p-in-string )
      134           .
      135       end.
      136       else do:
      137           case p-align-type
      138           :
      139               when 'left':U
      140               then do:
      141                   assign
      142                       v-out-string = trim( p-in-string )
      143                   .
      144               end.
      145               when 'right':U
      146               then do:
      147                   assign
      148                       v-out-string = fill( " ":U, p-page-width - v-string-length ) + trim( p-in-string )
      149                   .
      150               end.
      151               when 'center':U
      152               then do:
      153                   assign
      154                       v-out-string = fill( " ":U, integer( ( p-page-width - v-string-length ) / 2 ) ) + trim( p-in-string )
      155                   .
      156               end.
      157           end case.
      158       end.
      159       return v-out-string .
      160   end function.
      161   procedure p-fmt-split-string :
      162   define input parameter p-source-string  as character        no-undo.
      163   define input parameter p-split-length   as integer          no-undo.
      164   define output parameter p-string-1      as character        no-undo.
      165   define output parameter p-string-2      as character        no-undo.
      166   do
      167   on error undo, return error
      168   :
      169       define variable v-space-pos    as integer      no-undo.
      170       if length( p-source-string ) <= p-split-length
      171       then do:
      172           assign
      173               p-string-1 = p-source-string
      174           .
      175       end.
      176       else do:
      177           assign
      178               v-space-pos = r-index( p-source-string, " ":U, p-split-length )
      179           .
      180           if v-space-pos = 0
      181           then do:
      182               assign
      183                   v-space-pos = index( p-source-string, " ":U )
      184               .
      185           end.
      186           if v-space-pos = 0
      187           then do:
      188               assign
      189                   p-string-1 = substring( p-source-string, 1, p-split-length )
      190                   p-string-2 = trim( substring( p-source-string, p-split-length, p-split-length ) )
      191               .
      192           end.
      193           else do:
      194               assign
      195                   p-string-1 = substring( p-source-string, 1, v-space-pos )
      196                   p-string-2 = trim( substring( p-source-string, v-space-pos ) )
      197               .
      198           end.
      199       end.
      200   end.
      201   end procedure.
      202   procedure p-fmt-round :
      203   define input parameter p-qnty               as decimal          no-undo.
      204   define input parameter p-price-no-VAT       as decimal          no-undo.
      205   define input parameter p-VAT                as decimal          no-undo.
      206   define input parameter p-SLT                as decimal          no-undo.
      207   define input parameter p-road-tax           as decimal          no-undo.
      208   define output parameter p-new-price-no-VAT  as decimal          no-undo.
      209   define output parameter p-new-VAT           as decimal          no-undo.
      210   define output parameter p-new-SLT           as decimal          no-undo.
      211   define output parameter p-new-sum-VAT       as decimal          no-undo.
      212   define output parameter p-new-sum-SLT       as decimal          no-undo.
      213   define output parameter p-new-sum-road-tax  as decimal          no-undo.
      214   define output parameter p-new-sum-no-VAT    as decimal          no-undo.
      215   define output parameter p-new-sum-full      as decimal          no-undo.
      216       define variable v-vat-pc    as decimal      no-undo.
      217       define variable v-slt-pc    as decimal      no-undo.
      218   do
      219   on error undo, return error
      220   :
      221       if p-price-no-VAT = 0
      222       then do:
      223           assign
      224               p-new-price-no-VAT = 0.0
      225               p-new-VAT          = ?
      226               p-new-SLT          = ?
      227               p-new-sum-VAT      = 0.0
      228               p-new-sum-SLT      = 0.0
      229               p-new-sum-no-VAT   = 0.0
      230               p-new-sum-road-tax = 0.0
      231               p-new-sum-full     = 0.0
      232           .
      233       end.
      234       else do:
      235           assign
      236               v-vat-pc            = p-VAT / p-price-no-VAT
      237               v-slt-pc            = p-SLT / ( p-price-no-VAT + p-VAT )
      238               p-new-price-no-VAT  = round( p-price-no-VAT, 2 )
      239               p-new-VAT           = round( p-new-price-no-VAT * v-vat-pc, 2 )
      240               p-new-SLT           = round( ( p-new-price-no-VAT + p-new-VAT ) * v-slt-pc, 2 )
      241               p-new-sum-VAT       = round( p-new-VAT          * p-qnty, 2 )
      242               p-new-sum-SLT       = round( ( p-new-price-no-VAT + p-new-VAT ) * p-qnty * v-slt-pc, 2 )
      243               p-new-sum-no-VAT    = round( p-new-price-no-VAT * p-qnty, 2 )
      244               p-new-sum-road-tax  = round( p-road-tax * p-qnty, 2 )
      245               p-new-sum-full      = round( ( p-new-price-no-VAT + p-new-VAT + p-new-SLT + p-road-tax ) * p-qnty, 2 )
      246           .
      247       end.
      248   end.
      249   end procedure.
      250   procedure p-fmt-split :
      251   define input parameter p-in-string      as character        no-undo.
      252   define input parameter p-split-length   as integer          no-undo.
      253       define variable v-start-pos     as integer      no-undo.
      254       define variable v-end-pos       as integer      no-undo.
      255       define buffer buf_temp_p-fmt_string-part        for temp_p-fmt_string-part.
      256   do
      257   for buf_temp_p-fmt_string-part
      258   on error undo, return error
      259   :
      260       empty temp-table buf_temp_p-fmt_string-part.
      261       if p-split-length < 1
      262       then do:
      263           undo, return error substitute( "p-fmt-split: Строка не может быть разбита на &1 частей", p-split-length ).
      264       end.
      265       assign
      266           p-in-string                 = trim( p-in-string )
      267           v-p-fmt-2-str-key   = 0
      268           v-start-pos                 = 1
      269           v-end-pos                   = length( p-in-string )
      270       .
      271       run p-fmt-get-string-range in this-procedure (
      272             input p-in-string
      273           , input p-split-length
      274           , input v-start-pos
      275           , output v-start-pos
      276           , output v-end-pos
      277       ).
      278       do while v-end-pos <> 0
      279       :
      280           create buf_temp_p-fmt_string-part.
      281           assign
      282               v-p-fmt-2-str-key = v-p-fmt-2-str-key + 1
      283           .
      284           assign
      285               buf_temp_p-fmt_string-part.str-key      = v-p-fmt-2-str-key
      286               buf_temp_p-fmt_string-part.string-part  = substring( p-in-string, v-start-pos, v-end-pos - v-start-pos )
      287           .
      288           assign
      289               v-start-pos = v-end-pos + 1
      290           .
      291           run p-fmt-get-string-range in this-procedure (
      292                 input p-in-string
      293               , input p-split-length
      294               , input v-start-pos
      295               , output v-start-pos
      296               , output v-end-pos
      297           ).
      298       end.
      299   end.
      300   end procedure.
      301   procedure p-fmt-get-string-range :
      302   define input parameter p-in-string      as character        no-undo.
      303   define input parameter p-split-length   as integer          no-undo.
      304   define input parameter p-old-start-pos  as integer          no-undo.
      305   define output parameter p-start-pos     as integer          no-undo.
      306   define output parameter p-end-pos       as integer          no-undo.
      307       define variable v-init-string    as character    no-undo.
      308       define variable v-temp-char      as character    no-undo.
      309       define variable v-temp-pos       as integer      no-undo.
      310       define variable v-counter        as integer      no-undo.
      311   do
      312   on error undo, return error
      313   :
      314       assign
      315           p-start-pos   = p-old-start-pos
      316           v-init-string = substring( p-in-string, p-start-pos )
      317       no-error.
      318       if error-status :error
      319       or trim( v-init-string ) = "":U
      320       then do:
      321           assign
      322               p-end-pos = 0
      323           .
      324           undo, return .
      325       end.
      326       assign
      327           v-temp-char   = substring( v-init-string, 1, 1 )
      328       .
      329       do
      330       while trim( v-temp-char ) = "":U
      331       :
      332           assign
      333               p-start-pos     = p-start-pos + 1
      334               v-init-string   = substring( p-in-string, p-start-pos )
      335               v-temp-char     = substring( v-init-string, 1, 1 )
      336           .
      337       end.
      338       assign
      339           v-temp-pos  = p-split-length
      340           v-temp-char = substring( v-init-string, v-temp-pos, 1 )
      341           v-counter   = 0
      342       .
      343       search-word-end:
      344       do
      345       while trim( v-temp-char ) <> "":U
      346       :
      347           assign
      348               v-counter   = v-counter + 1
      349           .
      350           if v-counter > 20
      351           then do:
      352               assign
      353                   v-temp-pos  = p-split-length
      354               .
      355               leave search-word-end.
      356           end.
      357           assign
      358               v-temp-pos  = v-temp-pos - 1
      359               v-temp-char = substring( v-init-string, v-temp-pos, 1 )
      360           .
      361       end.
      362       assign
      363           p-end-pos = p-start-pos + v-temp-pos - 1
      364       .
      365   end.
      366   end procedure.
