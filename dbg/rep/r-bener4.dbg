     1450                           "Страница " AT 65 PAGE-NUMBER( PrnLibStream )  AT 75 FORMAT ">>9" SKIP
     1451                       Line format "X(82)" AT 1
     1452       with width 160 down stream-io use-text .
     1453   DEFINE FRAME PayCodes-rubl
     1454           sym1 column-label ":" format "X(1)"
     1455           benefits.pay-name column-label "Вид оплаты" format "X(41)"
     1456           sym6 column-label ":" format "X(1)"
     1457           benefits.tot-r-b column-label  "Сумма (вал.продаж)."  format "->,>>>,>>>,>>>,>>9.99"
     1458           sym7 column-label ":" format "X(1)"
     1459           benefits.pcnt column-label "% от суммы" format "->>>>9.99%"
     1460           sym8 column-label ":" format "X(1)"
     1461       HEADER  date_string format "X(35)" AT 5
     1462                           string( " " ) format "X(20)" AT 42
     1463                           "Страница " AT 65 PAGE-NUMBER( PrnLibStream )  AT 75 FORMAT ">>9" SKIP
     1464                       Line format "X(82)" AT 1
     1465       with width 160 down stream-io use-text .
     1466   DEFINE FRAME ZUM-PayCodes-rubl
     1467           sym1 column-label ":" format "X(1)"
     1468           benefits.pay-name column-label "Вид оплаты" format "X(41)"
     1469           sym6 column-label ":" format "X(1)"
     1470           benefits.tot-r-b column-label "Сумма (вал.продаж)"  format "->,>>>,>>>,>>>,>>9.99"
     1471           sym7 column-label ":" format "X(1)"
     1472           benefits.pcnt column-label "% от суммы" format "->>>>9.99%"
     1473           sym8 column-label ":" format "X(1)"
     1474       with width 160 down stream-io use-text NO-LABELS.
     1475   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1476   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1477   procedure cur-time :
     1478      define output parameter p-today as date      no-undo .
     1479      define output parameter p-time  as integer   no-undo .
     1480     do
     1481     on error undo, return error
     1482     :
     1483       define variable v-date1 as date      no-undo .
     1484       define variable v-date2 as date      no-undo .
     1485       define variable v-time  as integer   no-undo .
     1486       assign
     1487         v-date1 = today
     1488         v-time  = time
     1489         v-date2 = today
     1490       .
     1491       if v-date1 <> v-date2
     1492       then do:
     1493         assign
     1494           v-date1 = today
     1495           v-time  = v-time
     1496         .
     1497       end.
     1498       assign
     1499         p-today = v-date1
     1500         p-time  = v-time
     1501       .
     1502     end.
     1503   end.
     1504   function cur-time-date returns character
     1505   :
     1506     return string(today, '99/99/9999':U) .
     1507   end.
     1508   function cur-time-mjd returns decimal
     1509   :
     1510     define variable v-date as date      no-undo .
     1511     define variable v-time as integer   no-undo .
     1512     run cur-time in this-procedure
     1513       (output v-date
     1514       ,output v-time
     1515       ) .
     1516     return integer(v-date) - 2400002 + (v-time / 86400) .
     1517   end.
     1518   function cur-time-get-ending-index returns integer
     1519   (input p-number as integer
     1520   )
     1521   :
     1522     if p-number < 0
     1523     or p-number = ?
     1524     then do:
     1525       return 1 .
     1526     end.
     1527     define variable v-rest as integer   no-undo .
     1528     assign
     1529       p-number = p-number modulo 100
     1530     .
     1531     if p-number < 20
     1532     then do:
     1533       assign
     1534         v-rest = p-number
     1535       .
     1536     end.
     1537     else do:
     1538       assign
     1539         v-rest = p-number modulo 10
     1540       .
     1541     end.
     1542     case v-rest :
     1543       when 1
     1544       then do:
     1545         return 2 .
     1546       end.
     1547       when 2 or
     1548       when 3 or
     1549       when 4
     1550       then do:
     1551         return 3 .
     1552       end.
     1553       otherwise do:
     1554         return 1 .
     1555       end.
     1556     end case .
     1557   end.
     1558   procedure cur-time-mjd-to-date :
     1559      define input  parameter i-mjd-diff as decimal no-undo.
     1560      define output parameter o-Date     as date    no-undo.
     1561      define output parameter o-Time     as integer no-undo.
     1562      define variable v-day-number as integer   no-undo .
     1563      if    i-mjd-diff < 0
     1564         or i-mjd-diff = ?
     1565      then do:
     1566         return "?" .
     1567      end.
     1568      assign
     1569         v-day-number = truncate(i-mjd-diff,0).
     1570         o-Date = date(v-day-number + 2400002).
     1571         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     1572     .
     1573   end.
     1574   function cur-time-mjd-to-string returns character
     1575   (input p-mjd-diff as decimal
     1576   )
     1577   :
     1578     define variable v-day-number as integer   no-undo .
     1579     define variable v-seconds    as integer   no-undo .
     1580     define variable v-hour       as integer   no-undo .
     1581     define variable v-min        as integer   no-undo .
     1582     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     1583     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     1584     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     1585     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1586     if p-mjd-diff < 0
     1587     or p-mjd-diff = ?
     1588     then do:
     1589       return "?" .
     1590     end.
     1591     assign
     1592       v-day-number = integer(truncate(p-mjd-diff,0))
     1593       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1594     .
     1595     if v-seconds > 86400
     1596     then do:
     1597       assign
     1598         v-seconds = 86400 - 1
     1599       .
     1600     end.
     1601     if v-seconds < 0
     1602     then do:
     1603       assign
     1604         v-seconds = 0
     1605       .
     1606     end.
     1607     assign
     1608       v-hour = truncate(v-seconds / 3600, 0)
     1609     .
     1610     assign
     1611       v-seconds = v-seconds modulo 3600
     1612     .
     1613     assign
     1614       v-min = truncate(v-seconds / 60, 0)
     1615     .
     1616     assign
     1617       v-seconds = v-seconds modulo 60
     1618     .
     1619     return
     1620         (if v-day-number <> 0
     1621           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1622           else ""
     1623         )
     1624       + (if v-day-number <> 0 or v-hour <> 0
     1625           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1626           else ""
     1627         )
     1628       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1629           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1630           else ""
     1631         )
     1632       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1633       .
     1634   end.
     1635   function cur-time-string returns character
     1636   :
     1637     define variable v-date as date      no-undo .
     1638     define variable v-time as integer   no-undo .
     1639     run cur-time in this-procedure
     1640       (output v-date
     1641       ,output v-time
     1642       ) .
     1643     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1644   end.
     1645   function cur-time-string-sec returns character
     1646   :
     1647     define variable v-date as date      no-undo .
     1648     define variable v-time as integer   no-undo .
     1649     run cur-time in this-procedure
     1650       (output v-date
     1651       ,output v-time
     1652       ) .
     1653     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1654   end.
     1655   function cur-time-custom  returns character
     1656   (input p-prefix as character
     1657   ,input p-date-format as character
     1658   ,input p-delimiter as character
     1659   ,input p-time-format as character
     1660   ,input p-suffix as character
     1661   )
     1662   :
     1663     define variable v-date as date      no-undo .
     1664     define variable v-time as integer   no-undo .
     1665     run cur-time in this-procedure
     1666       (output v-date
     1667       ,output v-time
     1668       ) .
     1669     return
     1670       p-prefix
     1671       + string(v-date, p-date-format)
     1672       + p-delimiter
     1673       + string(v-time, p-time-format)
     1674       + p-suffix
     1675       .
     1676   end.
     1677   function cur-time-print  returns character
     1678   :
     1679     define variable v-date as date      no-undo .
     1680     define variable v-time as integer   no-undo .
     1681     run cur-time in this-procedure
     1682       (output v-date
     1683       ,output v-time
     1684       ) .
     1685     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1686   end.
     1687   function cur-time-datetime returns datetime
     1688   :
     1689     define variable v-char as character no-undo .
     1690     define variable v-datetime as datetime no-undo .
     1691     v-char = cur-time-string().
     1692     v-datetime = datetime(v-char).
     1693     return  v-datetime.
     1694   end.
     1695   function cur-time-string-msec returns character
     1696   :
     1697     define variable v-date as datetime  no-undo .
     1698     v-date = now.
     1699     return string(v-date) .
     1700   end.
     1701   assign
     1702   date_string = cur-time-print()
     1703   Line = fill( "-", 140 ).
     1704   for each benefits:
     1705       delete benefits.
     1706   end.
     1707   for each inkas-num:
     1708       delete inkas-num.
     1709   end.
     1710   for each day_sum:
     1711       delete day_sum.
     1712   end.
     1713   for each all-days_sum:
     1714       delete all-days_sum.
     1715   end.
     1716   if v-curr-r-b = 'base':U then do:
     1717   sale-price-type = "рублей".
     1718   end.
     1719   else sale-price-type = "рублей".
     1720   run no-benq-i(output found).
     1721   if not found then do:
     1722     run waitfram-hide in this-procedure .
     1723     message "Не было никакой выручки на выбранных объектах в течение заданного Вами периода времени." view-as alert-box information .
     1724     return.
     1725   end.
     1726   run rep/r-beneq2.p (input cas-num,
     1727                  output allday-basesum,
     1728                  output allday-rublsum) no-error.
     1729   if error-status:error then return error .
     1730   run waitfram-hide in this-procedure .
     1731   if x-date-start = x-date-end
     1732   then choice = TRUE .
     1733   else choice = HowBreak .
     1734   output stream PrnLibStream to value( string( session:temp-directory +
     1735                                        "rpt" + string( g#report-num ) ) )
     1736                                        page-size 62 .
     1737   FORM HEADER
     1738   Line format "X(136)" AT 1 SKIP
     1739   "Продолжение - на следующей странице" AT 30 SKIP
     1740   with FRAME BottomFrame width 160 PAGE-BOTTOM NO-LABELS NO-BOX .
     1741   VIEW stream PrnLibStream FRAME BottomFrame .
     1742   PUT stream PrnLibStream space(5) .
     1743   PUT stream PrnLibStream UNFORMATTED
     1744   string( "ОТЧЕТ  О  ВЫРУЧКЕ " + str1)  format "X(120)" SKIP(1)
     1745   str4 SKIP(0)
     1746   space(5)
     1747   (IF NotInc
     1748    then
     1749    ( "( сформирован НЕ ПО ВСЕМ ЧЕКАМ " + (IF cas-num = 0
     1750                                          then "ВСЕХ КАСС"
     1751                                          ELSE ("КАССЫ " + string(cas-num))
     1752                                          )
     1753    )
     1754     else ("( сформирован ПО ЧЕКАМ " +
     1755           (IF cas-num = 0
     1756             then "ВСЕХ КАСС"
     1757             ELSE ("КАССЫ " + string(cas-num) )
     1758             )
     1759          )
     1760           + ")"
     1761     )                 format "x(80)" skip(1)
     1762   .
     1763   FORM with frame Benefit-rubl .
     1764   DatePrinted = FALSE .
     1765   FOR EACH obj-list WHERE
     1766            obj-list.obj-type = 'маг':U BREAK BY obj-list.obj-code :
     1767     FIND FIRST clients WHERE
     1768               clients.obj-type = obj-list.obj-type  AND
     1769               clients.obj-code = obj-list.obj-code  NO-LOCK .
     1770     assign
     1771     ALLDAY-NUM-chk = 0
     1772     allday-num-chk-nf = 0
     1773     day-num-chk = 0
     1774     day-num-chk-nf = 0.
     1775     DOWN stream PrnLibStream 1 with frame Benefit-rubl .
     1776     PUT stream PrnLibStream space(10) clients.obj-name format "x(60)" skip.
     1777       UNDERLINE stream PrnLibStream
     1778       benefits.pay-name
     1779       benefits.tot-rubl
     1780       benefits.pcnt
     1781       with frame Benefit-rubl.
     1782     ACCUMULATE
     1783     obj-list.obj-code ( COUNT ) .
     1784      FOR EACH ub.inkas WHERE
     1785                ub.inkas.obj-type = obj-list.obj-type AND
     1786               ub.inkas.obj-code = obj-list.obj-code AND
     1787               ub.inkas.status_ = 'факт':U AND
     1788               ub.inkas.doc-date >= x-date-start AND
     1789               ub.inkas.doc-date <= x-date-end NO-LOCK:
     1790         assign
     1791         Day-Num-Chk = Day-Num-Chk  + ub.inkas.num-chk
     1792         day-num-chk-nf = day-num-chk-nf + ub.inkas.num-chk-nff
     1793         .
     1794      end.
     1795      FOR EACH ub.inkas WHERE
     1796                ub.inkas.obj-type = obj-list.obj-type AND
     1797               ub.inkas.obj-code = obj-list.obj-code AND
     1798               ub.inkas.status_ = 'факт':U AND
     1799               ub.inkas.doc-date >= x-date-start AND
     1800               ub.inkas.doc-date <= x-date-end NO-LOCK,
     1801           FIRST inkas-num NO-LOCK WHERE
     1802                 (inkas-num.inkas-code = ub.inkas.inkas-code),
     1803           EACH ub.inkas-pay-desk WHERE
     1804                ub.inkas-pay-desk.inkas-code = ub.inkas.inkas-code AND
     1805           (IF cas-num > 0 then ub.inkas-pay-desk.pay-desk = cas-num else TRUE)
     1806                NO-LOCK
     1807       BREAK
     1808       BY ub.inkas.obj-type
     1809       BY ub.inkas.obj-code
     1810       BY ub.inkas.status_
     1811       BY ub.inkas-pay-desk.pay-desk
     1812       BY ub.inkas-pay-desk.pay-code
     1813       BY ub.inkas-pay-desk.curr-code :
     1814         if first-of( ub.inkas-pay-desk.pay-desk ) then  do:
     1815           FOR EACH b-inkas WHERE
     1816                   b-inkas.obj-type = obj-list.obj-type AND
     1817                   b-inkas.obj-code = obj-list.obj-code AND
     1818                   b-inkas.status_ = 'факт':U AND
     1819                   b-inkas.doc-date >= x-date-start AND
     1820                   b-inkas.doc-date <= x-date-end NO-LOCK,
     1821               EACH b-inkas-pay-desk NO-LOCK WHERE
     1822                    b-inkas-pay-desk.inkas-code = b-inkas.inkas-code AND
     1823                    b-inkas-pay-desk.pay-desk = ub.inkas-pay-desk.pay-desk
     1824           BREAK
     1825           BY b-inkas.inkas-code:
     1826             ACCUMULATE
     1827             b-inkas-pay-desk.tot-base ( TOTAL )
     1828             b-inkas-pay-desk.tot-rubl ( TOTAL )
     1829             b-inkas-pay-desk.tot-sum ( TOTAL ) .
     1830           END.
     1831           assign
     1832           Day-Tot-Sum = ACCUM TOTAL b-inkas-pay-desk.tot-sum
     1833           Day-Tot-Base = ACCUM TOTAL b-inkas-pay-desk.tot-base
     1834           Day-Tot-Rubl = ACCUM TOTAL b-inkas-pay-desk.tot-rubl
     1835           Day-Tot-R-b  = (if v-curr-r-b = 'base':U
     1836                           then Day-Tot-Base
     1837                           else Day-Tot-rubl)
     1838           .
     1839         end.
     1840         ACCUMULATE
     1841         ub.inkas-pay-desk.tot-base ( TOTAL )
     1842         ub.inkas-pay-desk.tot-rubl ( TOTAL )
     1843         (if v-curr-r-b = 'base':U
     1844          then inkas-pay-desk.tot-base
     1845          else inkas-pay-desk.tot-rubl)  (TOTAL)
     1846         ub.inkas-pay-desk.tot-sum ( SUB-TOTAL BY ub.inkas-pay-desk.curr-code )
     1847         ub.inkas-pay-desk.tot-base ( SUB-TOTAL BY ub.inkas-pay-desk.curr-code )
     1848         ub.inkas-pay-desk.tot-rubl ( SUB-TOTAL BY ub.inkas-pay-desk.curr-code )
     1849         (if v-curr-r-b = 'base':U
     1850          then ub.inkas-pay-desk.tot-base
     1851          else ub.inkas-pay-desk.tot-rubl) ( SUB-TOTAL BY ub.inkas-pay-desk.curr-code )
     1852         ub.inkas-pay-desk.tot-sum ( SUB-TOTAL BY ub.inkas-pay-desk.pay-code )
     1853         ub.inkas-pay-desk.tot-base ( SUB-TOTAL BY ub.inkas-pay-desk.pay-code )
     1854         ub.inkas-pay-desk.tot-rubl ( SUB-TOTAL BY ub.inkas-pay-desk.pay-code )
     1855         (if v-curr-r-b = 'base':U
     1856          then ub.inkas-pay-desk.tot-base
     1857          else ub.inkas-pay-desk.tot-rubl) ( SUB-TOTAL BY ub.inkas-pay-desk.pay-code )
     1858         .
     1859         if first-of( ub.inkas-pay-desk.curr-code ) then
     1860         FIND FIRST ub.currency WHERE
     1861                   ub.currency.curr-code = ub.inkas-pay-desk.curr-code NO-LOCK.
     1862         if first-of( ub.inkas-pay-desk.curr-code ) then
     1863         FIND FIRST ub.cash-pay WHERE
     1864                     ub.cash-pay.cdpay-code = ub.inkas-pay-desk.pay-code AND
     1865                     ub.cash-pay.curr-code = ub.inkas-pay-desk.curr-code NO-LOCK NO-ERROR.
     1866         if last-of( inkas-pay-desk.curr-code ) AND
     1867            ( ACCUM SUB-TOTAL BY ub.inkas-pay-desk.curr-code
     1868            (if v-curr-r-b = 'base':U
     1869            then ub.inkas-pay-desk.tot-base
     1870            else ub.inkas-pay-desk.tot-rubl)
     1871            ) <> 0
     1872         then do:
     1873           DISPLAY stream PrnLibStream
     1874           sym1
     1875           ub.inkas-pay-desk.pay-desk  WHEN ( NOT DatePrinted ) @ benefits.date_ column-label "Касса"
     1876           sym2
     1877           (if avail ub.cash-pay then ub.cash-pay.obj-name else "Неопознанная оплата") @ benefits.pay-name
     1878           sym6
     1879           ( ACCUM SUB-TOTAL BY ub.inkas-pay-desk.curr-code ub.inkas-pay-desk.tot-rubl ) @ benefits.tot-rubl
     1880           sym7
     1881           round( ( ACCUM SUB-TOTAL BY ub.inkas-pay-desk.curr-code ub.inkas-pay-desk.tot-rubl ) /
     1882                         Day-Tot-rubl * 100, 2 ) @ benefits.pcnt
     1883           sym8
     1884           with frame Benefit-rubl .
     1885           DOWN stream PrnLibStream 1 with frame Benefit-rubl.
     1886         end.
     1887         if last-of( ub.inkas-pay-desk.pay-desk ) then  do:
     1888           UNDERLINE stream PrnLibStream
     1889           benefits.pay-name
     1890           benefits.tot-rubl
     1891           benefits.pcnt
     1892           with frame Benefit-rubl.
     1893           DISPLAY stream PrnLibStream
     1894           sym1
     1895           "100.00%" @ benefits.pcnt
     1896           sym8
     1897           with frame Benefit-rubl .
     1898           UNDERLINE stream PrnLibStream
     1899           benefits.pay-name
     1900           benefits.tot-rubl
     1901           benefits.pcnt
     1902           with frame Benefit-rubl.
     1903           DatePrinted = FALSE .
     1904         end.
     1905         if last( ub.inkas-pay-desk.pay-desk ) then do:
     1906           assign
     1907           ALLDay-Num-Chk = Day-Num-Chk
     1908           allday-num-chk-nf = allday-num-chk-nf.
     1909           UNDERLINE stream PrnLibStream
     1910           benefits.pay-name
     1911           benefits.tot-rubl
     1912           benefits.pcnt
     1913           with frame Benefit-rubl.
     1914           DISPLAY stream PrnLibStream
     1915           ( " ИТОГО чеков: " + string( AllDay-Num-Chk )  + " - " +
     1916             string( round( (  ( ACCUM TOTAL inkas-pay-desk.tot-rubl ) / AllDay-Num-Chk )  , 2  ) , "->>>,>>9.99")
     1917             + "/чек") @ benefits.pay-name
     1918           ACCUM TOTAL inkas-pay-desk.tot-rubl  @ benefits.tot-rubl
     1919           with frame Benefit-rubl .
     1920           DOWN stream PrnLibStream 1 with frame Benefit-rubl .
     1921           DISPLAY stream PrnLibStream
     1922           ( " ИТОГО чеков ф: " + string( AllDay-Num-Chk - allday-num-chk-nf)  + " - " +
     1923             string( round( (  ( ACCUM TOTAL inkas-pay-desk.tot-rubl ) / (AllDay-Num-Chk - allday-num-chk-nf) )  , 2  ) , "->>>,>>9.99")
     1924             + "/чек") @ benefits.pay-name
     1925           ACCUM TOTAL inkas-pay-desk.tot-rubl  @ benefits.tot-rubl
     1926           with frame Benefit-rubl .
     1927           DOWN stream PrnLibStream 1 with frame Benefit-rubl .
     1928         end.
     1929       END .
     1930     ALLOBJ-ALlDAy-Num-CHk = ALLOBJ-ALlDay-Num-CHk + ALLDAY-NUM-chk .
     1931     ALLOBJ-ALlDAy-Num-CHk-nf = ALLOBJ-ALlDay-Num-CHk-nf + ALLDAY-NUM-chk-nf .
     1932     if last-of( obj-list.obj-code ) then do:
     1933         UNDERLINE stream PrnLibStream
     1934         benefits.pay-name
     1935         benefits.tot-rubl
     1936         benefits.pcnt
     1937         with frame Benefit-rubl.
     1938     end.
     1939     if last( obj-list.obj-code ) AND ( ACCUM COUNT obj-list.obj-code ) > 1 then do:
     1940         DISPLAY stream PrnLibStream
     1941         ( "ИТОГО по всем - чеков "  + string(ALlObj-ALLDay-Num-Chk) + " -  " +
     1942           string( ROUND ( ( AllDay-RublSum / ( ALLObj-ALLDay-Num-Chk)), 2)) +
     1943           "/чек(баз.вал.)" )  @ benefits.pay-name
     1944         AllDay-RublSum @ benefits.tot-rubl
     1945         with FRAME Benefit-rubl .
     1946         DOWN stream PrnLibStream 1 with frame Benefit-rubl .
     1947         DISPLAY stream PrnLibStream
     1948         ( "ИТОГО по всем - чеков ф"  + string(ALlObj-ALLDay-Num-Chk - allobj-allday-num-chk-nf) + " -  " +
     1949           string( ROUND ( ( AllDay-RublSum / ( ALLObj-ALLDay-Num-Chk - allobj-allday-num-chk-nf)), 2)) +
     1950           "/чек(баз.вал.)" )  @ benefits.pay-name
     1951         AllDay-RublSum @ benefits.tot-rubl
     1952         with FRAME Benefit-rubl .
     1953     end.
     1954   END.
     1955   ObjAmount = ( ACCUM COUNT obj-list.obj-code ) .
     1956   if ( ObjAmount > 1 ) then do:
     1957     FORM with frame ZUM-PayCodes-rubl .
     1958     FOR EACH obj-list WHERE
     1959              obj-list.obj-type = 'маг':U,
     1960         EACH ub.inkas WHERE
     1961              ub.inkas.obj-type = obj-list.obj-type AND
     1962             ub.inkas.obj-code = obj-list.obj-code AND
     1963             ub.inkas.status_ = 'факт':U AND
     1964             ub.inkas.doc-date >= x-date-start AND
     1965             ub.inkas.doc-date <= x-date-end NO-LOCK,
     1966         FIRST inkas-num WHERE
     1967               inkas-num.inkas-code = inkas.inkas-code,
     1968         EACH ub.inkas-pay-desk WHERE
     1969              ub.inkas-pay-desk.inkas-code = ub.inkas.inkas-code AND
     1970        (IF cas-num > 0 then ub.inkas-pay-desk.pay-desk = cas-num else TRUE)
     1971              NO-LOCK
     1972     BREAK
     1973     BY ub.inkas-pay-desk.pay-code
     1974     BY ub.inkas-pay-desk.curr-code :
     1975       ACCUMULATE
     1976       inkas-pay-desk.tot-sum ( SUB-TOTAL BY ub.inkas-pay-desk.pay-code )
     1977       inkas-pay-desk.tot-base ( SUB-TOTAL BY ub.inkas-pay-desk.pay-code )
     1978       inkas-pay-desk.tot-rubl ( SUB-TOTAL BY ub.inkas-pay-desk.pay-code )
     1979         (if v-curr-r-b = 'base':U
     1980          then ub.inkas-pay-desk.tot-base
     1981          else ub.inkas-pay-desk.tot-rubl)   ( SUB-TOTAL BY ub.inkas-pay-desk.pay-code )
     1982       ub.inkas-pay-desk.tot-sum ( SUB-TOTAL BY ub.inkas-pay-desk.curr-code )
     1983       ub.inkas-pay-desk.tot-base ( SUB-TOTAL BY ub.inkas-pay-desk.curr-code )
     1984       ub.inkas-pay-desk.tot-rubl ( SUB-TOTAL BY ub.inkas-pay-desk.curr-code )
     1985         (if v-curr-r-b = 'base':U
     1986          then ub.inkas-pay-desk.tot-base
     1987          else ub.inkas-pay-desk.tot-rubl)  ( SUB-TOTAL BY ub.inkas-pay-desk.curr-code )
     1988       .
     1989       if first-of( ub.inkas-pay-desk.curr-code ) then
     1990       FIND FIRST ub.currency WHERE
     1991                  ub.currency.curr-code = ub.inkas-pay-desk.curr-code NO-LOCK.
     1992       if first-of( ub.inkas-pay-desk.curr-code ) then
     1993       FIND FIRST ub.cash-pay WHERE
     1994                 ub.cash-pay.cdpay-code = ub.inkas-pay-desk.pay-code AND
     1995                 ub.cash-pay.curr-code = ub.inkas-pay-desk.curr-code NO-LOCK NO-ERROR.
     1996       if last-of( ub.inkas-pay-desk.curr-code ) AND
     1997          ( ACCUM SUB-TOTAL BY inkas-pay-desk.curr-code
     1998            (if v-curr-r-b = 'base':U
     1999            then ub.inkas-pay-desk.tot-base
     2000            else ub.inkas-pay-desk.tot-rubl)
     2001          ) <> 0 then do:
     2002         DISPLAY stream PrnLibStream
     2003         ( "/итого по " + (iF avail ub.cash-pay then ub.cash-pay.obj-name else "Неопознанная оплата") ) @ benefits.pay-name
     2004         ( ACCUM SUB-TOTAL BY ub.inkas-pay-desk.curr-code inkas-pay-desk.tot-rubl ) @ benefits.tot-rubl
     2005         with frame ZUM-PayCodes-rubl .
     2006         DOWN stream PrnLibStream 1 with FRAME ZUM-PayCodes-rubl .
     2007        end.
     2008     END.
     2009   end.
     2010   HIDE stream PrnLibStream FRAME BottomFrame .
     2011   PUT stream PrnLibStream Line format "X(82)" SKIP(1) .
     2012   if ( ACCUM COUNT obj-list.obj-code ) < 2 then do:
     2013       if ( line-counter( PrnLibStream ) + 9 ) > page-size( PrnLibStream ) then page stream PrnLibStream.
     2014       PUT stream PrnLibStream
     2015       space(10) "Директор _______________" format "X(30)"
     2016       "Старший продавец ______________" format "X(30)" SKIP(2)
     2017       space(10) "Бухгалтер ______________" format "X(30)"
     2018       "Кассир ________________________" format "X(30)" SKIP .
     2019   end.
     2020   output stream PrnLibStream CLOSE.
     2021   run prn-lib-prn-file in this-procedure (
     2022                                             input parParentProc
     2023                                             ,input 0
     2024                                             ).
