     2678               vat-rubl-buyer-prl              = 0
     2679               slt-base-sale-prl               = 0
     2680               slt-rubl-sale-prl               = 0
     2681               road-tax-base-sale-prl          = 0
     2682               road-tax-rubl-sale-prl          = 0
     2683               excise-base-sale-prl            = 0
     2684               excise-rubl-sale-prl            = 0
     2685               discnt-base-sale-prl            = 0
     2686               discnt-rubl-sale-prl            = 0
     2687             .
