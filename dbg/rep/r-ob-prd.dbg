     4741   procedure init-temphost:
     4742     define buffer buf_store   for ub.store .
     4743     define buffer buf_shop    for ub.shop .
     4744     define buffer buf_clients for ub.clients .
     4745     define buffer buf_db for ub.db .
     4746     define buffer buf_temp-host for temp-host .
     4747     define buffer buf_temp-obj for temp-obj .
     4748     do
     4749     on error undo, return error return-value
     4750     :
     4751       for each buf_store
     4752       on error undo, return error
     4753       :
     4754         find first buf_temp-host
     4755           where buf_temp-host.host-code = buf_store.host-code
     4756           no-error .
     4757         if not available buf_temp-host
     4758         then do:
     4759           create buf_temp-host .
     4760           assign
     4761             buf_temp-host.host-code = buf_store.host-code
     4762           .
     4763         end.
     4764         find first buf_clients no-lock
     4765           where buf_clients.obj-type = 'скл':U
     4766             and buf_clients.obj-code = buf_store.obj-code
     4767           no-error .
     4768         if not available buf_clients
     4769         then do:
     4770           message
     4771             "Ошибка при поиске клиента" skip
     4772             "Клиент" 'скл':U buf_store.obj-code skip
     4773             view-as alert-box error .
     4774           undo, return error .
     4775         end.
     4776         create buf_temp-obj .
     4777         assign
     4778           buf_temp-obj.obj-type  = 'скл':U
     4779           buf_temp-obj.obj-code  = buf_store.obj-code
     4780           buf_temp-obj.host-code = buf_store.host-code
     4781           buf_temp-obj.db-num    = buf_clients.db-num
     4782         .
     4783       end.
     4784       for each buf_shop
     4785       on error undo, return error
     4786       :
     4787         find first buf_temp-host
     4788           where buf_temp-host.host-code = buf_shop.host-code
     4789           no-error .
     4790         if not available buf_temp-host
     4791         then do:
     4792           create buf_temp-host .
     4793           assign
     4794             buf_temp-host.host-code = buf_shop.host-code
     4795           .
     4796         end.
     4797         find first buf_clients no-lock
     4798           where buf_clients.obj-type = 'маг':U
     4799             and buf_clients.obj-code = buf_shop.obj-code
     4800           no-error .
     4801         if not available buf_clients then do:
     4802           message
     4803             "Ошибка при поиске клиента" skip
     4804             "Клиент" 'маг':U buf_shop.obj-code skip
     4805             view-as alert-box error .
     4806           undo, return error .
     4807         end.
     4808         create buf_temp-obj .
     4809         assign
     4810           buf_temp-obj.obj-type  = 'маг':U
     4811           buf_temp-obj.obj-code  = buf_shop.obj-code
     4812           buf_temp-obj.host-code = buf_shop.host-code
     4813           buf_temp-obj.db-num    = buf_clients.db-num
     4814         .
     4815       end.
     4816     end.
     4817   end.
