     2413           "Бар-код" buf_main_price-list.b-code skip
     2414           view-as alert-box error .
     2415         undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  )  .
     2416       end.
     2417       find first buf_goods no-lock
     2418         where buf_goods.artic     = buf_main_price-list.artic
     2419           and buf_goods.prod-type = buf_main_price-list.prod-type
     2420           and buf_goods.prod-code = buf_main_price-list.prod-code
     2421         no-error .
     2422       if not available buf_goods
     2423       then do:
     2424         message
     2425           vss-workfile vss-revision vss-description skip
     2426           vss-include-info20 skip
     2427           "Не найден товар" skip
     2428           "Переоценка" buf_main_price-list.doc-num skip
     2429           "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     2430           view-as alert-box error .
     2431         undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     2432       end.
     2433   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2434   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     2435     (input  buf_main_price-list.artic
