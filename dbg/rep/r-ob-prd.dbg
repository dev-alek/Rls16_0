     2599               no-error .
     2600             if available buf_bar-code
     2601             and buf_bar-code.unit-cli = v-unit-base
     2602             then do:
     2603               message
     2604                 vss-workfile vss-revision vss-description skip
     2605                 vss-include-info20 skip
     2606                 "Ошибка при закрытии переоценки" skip
     2607                 "Не задано количество для бар-кода с основной единицей измерения" skip
     2608                 "Переоценка" buf_main_price-list.doc-num skip
     2609                 "Бар-код" buf_price-list.b-code skip
     2610                 "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     2611                 "Количество" buf_price-list.doc-qnty skip
     2612                 "Основная единица измерения" v-unit-base skip
     2613                 "Единица измерения бар-кода" buf_bar-code.unit-cli skip
     2614                 view-as alert-box error .
     2615               undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     2616             end.
     2617             next .
     2618           end.
     2619           if not can-find
     2620             (first buf_bar-code
     2621             where buf_bar-code.b-code = buf_price-list.b-code
     2622             )
     2623           then do:
