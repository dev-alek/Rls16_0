     2672               price-base-with-tax-sale-prl    = 0
     2673               price-rubl-without-tax-sale-prl = 0
     2674               price-base-without-tax-sale-prl = 0
     2675               vat-base-sale-prl               = 0
     2676               vat-rubl-sale-prl               = 0
