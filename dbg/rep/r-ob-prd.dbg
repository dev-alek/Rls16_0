     1086                                         else - buf_doc-line.fact-qnty
     1087                                       )
     1088             .
     1089   assign
     1090     price-rubl-with-tax-loc = buf_doc-line.price-rubl
     1091     price-base-with-tax-loc = buf_doc-line.price-base
     1092   .
     1093   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1094   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1095     (output varinvprb
     1096     )  .
     1097      find first in-vatp_doc-attr no-lock
     1098       where in-vatp_doc-attr.doc-code  = buf_trn-doc.doc-code
     1099         and in-vatp_doc-attr.attr-code = 'envd':U
     1100       no-error .
     1101       if available in-vatp_doc-attr
     1102          then do:
     1103          assign
     1104            in-vatp-have-vat-slt = no.
     1105      end.
     1106      else do:
     1107        assign
     1108          in-vatp-have-vat-slt = yes.
     1109      end.
     1110      find first in-vatp-goods where in-vatp-goods.artic     = buf_doc-line.artic     and
     1111                                        in-vatp-goods.prod-type = buf_doc-line.prod-type and
     1112                                        in-vatp-goods.prod-code = buf_doc-line.prod-code no-lock.
     1113      if (not buf_trn-doc.internal and
     1114              buf_trn-doc.doc-type = 'при':U) or
     1115         in-vatp-goods.gds-type = 'у':U then do:
     1116         if varinvprb = "base":u then do:
     1117           assign
     1118             road-tax-base-loc = buf_doc-line.road-tax
     1119             road-tax-rubl-loc = buf_doc-line.road-tax * buf_trn-doc.base-rate / buf_trn-doc.base-scale.
     1120         end.
     1121         else do:
     1122           ASSIGN
     1123             road-tax-rubl-loc = buf_doc-line.road-tax
     1124             road-tax-base-loc = buf_doc-line.road-tax / buf_trn-doc.base-rate * buf_trn-doc.base-scale.
     1125         end.
     1126         if road-tax-base-loc = ? then road-tax-base-loc = 0.
     1127         if road-tax-rubl-loc = ? then road-tax-rubl-loc = 0.
     1128         assign
     1129           road-tax-cli-loc = ?.
     1130         ASSIGN
     1131           transport-base-loc = (if buf_doc-line.transport-base = ? then 0 else buf_doc-line.transport-base)
     1132           transport-rubl-loc = (if buf_doc-line.transport-rubl = ? then 0 else buf_doc-line.transport-rubl)
     1133           transport-cli-loc  = 0
     1134           other-base-loc     = (if buf_doc-line.other-base     = ? then 0 else buf_doc-line.other-base)
     1135           other-rubl-loc     = (if buf_doc-line.other-rubl     = ? then 0 else buf_doc-line.other-rubl)
     1136           other-cli-loc      = 0
     1137           vat-pc-loc         = (if buf_doc-line.vat-pc         = ? then 0 else buf_doc-line.vat-pc)
     1138           slt-pc-loc         = (if buf_doc-line.slt-pc         = ? then 0 else buf_doc-line.slt-pc).
     1139                                 ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     1140               ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     1141         assign
     1142           vat-cli-loc            = ?
     1143           slt-cli-loc            = ?
     1144           price-cli-with-tax-loc = ?.
     1145      end.
     1146      else do:
     1147                                                   for each in-vatp-parts where in-vatp-parts.out-code  = buf_doc-line.doc-code  and
     1148                                         in-vatp-parts.obj-type  = buf_doc-line.obj-type  and
     1149                                         in-vatp-parts.obj-code  = buf_doc-line.obj-code  and
     1150                                         in-vatp-parts.artic     = buf_doc-line.artic     and
     1151                                         in-vatp-parts.prod-type = buf_doc-line.prod-type and
     1152                                         in-vatp-parts.prod-code = buf_doc-line.prod-code
     1153                            use-index out-code no-lock:
     1154             accumulate  in-vatp-parts.road-tax-base  * in-vatp-parts.fact-qnty (total)
     1155                         in-vatp-parts.road-tax-rubl  * in-vatp-parts.fact-qnty (total)
     1156                         in-vatp-parts.transport-base * in-vatp-parts.fact-qnty (total)
     1157                         in-vatp-parts.transport-rubl * in-vatp-parts.fact-qnty (total)
     1158                         in-vatp-parts.other-base     * in-vatp-parts.fact-qnty (total)
     1159                         in-vatp-parts.other-rubl     * in-vatp-parts.fact-qnty (total)
     1160                                                                                                                 (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  (total)
     1161                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))  (total)
     1162                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))  (total)
     1163                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc))  (total)
     1164                                               (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  (total)
     1165                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))  (total)
     1166                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))  (total)
     1167                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc))  (total)
     1168                         .
     1169         end.
     1170         ASSIGN
     1171           road-tax-base-loc   = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.road-tax-base  * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
     1172           road-tax-rubl-loc   = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.road-tax-rubl  * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
     1173           transport-base-loc  = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.transport-base * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
     1174           transport-rubl-loc  = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.transport-rubl * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
     1175           other-base-loc      = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.other-base     * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
     1176           other-rubl-loc      = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.other-rubl     * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
     1177                                           vat-base-loc        = if buf_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / buf_doc-line.fact-qnty   else 0
     1178           slt-base-loc        = if buf_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / buf_doc-line.fact-qnty   else 0
     1179                   vat-rubl-loc        = if buf_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / buf_doc-line.fact-qnty   else 0
     1180           slt-rubl-loc        = if buf_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / buf_doc-line.fact-qnty   else 0
     1181           vat-pc-loc          = (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc)))
     1182           slt-pc-loc          = (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))).
     1183         if road-tax-base-loc  = ? then road-tax-base-loc  = 0.
     1184         if road-tax-rubl-loc  = ? then road-tax-rubl-loc  = 0.
     1185         if transport-base-loc = ? then transport-base-loc = 0.
     1186         if transport-rubl-loc = ? then transport-rubl-loc = 0.
     1187         if other-base-loc     = ? then other-base-loc     = 0.
     1188         if other-rubl-loc     = ? then other-rubl-loc     = 0.
     1189         assign
     1190           transport-cli-loc      = 0
     1191           other-cli-loc          = 0
     1192           road-tax-cli-loc       = ?
     1193           vat-cli-loc            = ?
     1194           slt-cli-loc            = ?
     1195           price-cli-with-tax-loc = ?.
     1196      end.
     1197   ASSIGN
     1198             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     1199       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     1200   .
     1201             assign
     1202               v-fact-qnty           = v-fact-qnty      + v-parts-fact-qnty
     1203               v-vat-pc              = vat-pc-loc
     1204               v-slt-pc              = slt-pc-loc
     1205               v-sum-base            = v-sum-base       + (price-base-with-tax-loc * v-parts-fact-qnty)
     1206               v-sum-rubl            = v-sum-rubl       + (price-rubl-with-tax-loc * v-parts-fact-qnty)
     1207               v-vat-base            = v-vat-base       + (vat-base-loc            * v-parts-fact-qnty)
     1208               v-vat-rubl            = v-vat-rubl       + (vat-rubl-loc            * v-parts-fact-qnty)
     1209               v-slt-base            = v-slt-base       + (slt-base-loc            * v-parts-fact-qnty)
     1210               v-slt-rubl            = v-slt-rubl       + (slt-rubl-loc            * v-parts-fact-qnty)
     1211               v-road-tax-base       =  0
     1212               v-road-tax-rubl       =  0
     1213               v-excise-base         =  0
     1214               v-excise-rubl         =  0
     1215               v-transport-base      =  0
     1216               v-transport-rubl      =  0
     1217               v-other-base          =  0
     1218               v-other-rubl          =  0
     1219             .
     1220       end.
     1221     end.
     1222   end procedure.
     1223   define variable vss-include-info14 as character format "X(65)" no-undo
     1224   initial "@(#)$Workfile$ $Revision$".
     1225   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1226   procedure r-sale :
     1227     define input parameter  p-doc-code          like ub.doc-line.doc-code          no-undo .
     1228     define input parameter  p-artic             like ub.doc-line.artic             no-undo .
     1229     define input parameter  p-prod-type         like ub.doc-line.prod-type         no-undo .
     1230     define input parameter  p-prod-code         like ub.doc-line.prod-code         no-undo .
     1231     define output parameter p-fact-qnty         like ub.ot-line.fact-qnty       no-undo .
     1232     define output parameter p-vat-pc            like ub.doc-line.vat-pc         no-undo .
     1233     define output parameter p-slt-pc            like ub.doc-line.slt-pc         no-undo .
     1234     define output parameter p-sum-base          like ub.ot-line.sum-base        no-undo .
     1235     define output parameter p-sum-rubl          like ub.ot-line.sum-rubl        no-undo .
     1236     define output parameter p-vat-base          like ub.ot-line.vat-base        no-undo .
     1237     define output parameter p-vat-rubl          like ub.ot-line.vat-rubl        no-undo .
     1238     define output parameter p-slt-base          like ub.ot-line.slt-base        no-undo .
     1239     define output parameter p-slt-rubl          like ub.ot-line.slt-rubl        no-undo .
     1240     define output parameter p-road-tax-base     like ub.ot-line.road-tax-base   no-undo .
     1241     define output parameter p-road-tax-rubl     like ub.ot-line.road-tax-rubl   no-undo .
     1242     define output parameter p-transport-base    like ub.ot-line.transport-base  no-undo .
     1243     define output parameter p-transport-rubl    like ub.ot-line.transport-rubl  no-undo .
     1244     define output parameter p-other-base        like ub.ot-line.other-base      no-undo .
     1245     define output parameter p-other-rubl        like ub.ot-line.other-rubl      no-undo .
     1246     define output parameter p-excise-base       like ub.ot-line.excise-base     no-undo .
     1247     define output parameter p-excise-rubl       like ub.ot-line.excise-rubl     no-undo .
     1248     define variable vss-description as character no-undo initial "r-sale-01: обработка продажных цен товара".
     1249     do
     1250     on error undo, return error
     1251     :
     1252       define  variable price-rubl-with-tax-sale    like ub.doc-line.price-rubl no-undo.
     1253       define  variable price-base-with-tax-sale    like ub.doc-line.price-base no-undo.
     1254       define  variable price-rubl-without-tax-sale like ub.doc-line.price-rubl no-undo.
     1255       define  variable price-base-without-tax-sale like ub.doc-line.price-base no-undo.
     1256       define  variable vat-base-sale               like ub.doc-line.price-base no-undo.
     1257       define  variable vat-rubl-sale               like ub.doc-line.price-rubl no-undo.
     1258       define  variable vat-base-buyer              like ub.doc-line.price-base no-undo.
     1259       define  variable vat-rubl-buyer              like ub.doc-line.price-rubl no-undo.
     1260       define  variable slt-base-sale               like ub.doc-line.price-base no-undo.
     1261       define  variable slt-rubl-sale               like ub.doc-line.price-rubl no-undo.
     1262       define  variable road-tax-base-sale          like ub.doc-line.road-tax   no-undo.
     1263       define  variable road-tax-rubl-sale          like ub.doc-line.road-tax   no-undo.
     1264       define  variable excise-base-sale            like ub.doc-line.price-base no-undo.
     1265       define  variable excise-rubl-sale            like ub.doc-line.price-rubl no-undo.
     1266       define  variable discnt-base-sale            like ub.gds-dtl.discnt-base no-undo.
     1267       define  variable discnt-rubl-sale            like ub.gds-dtl.discnt-rubl no-undo.
     1268       define buffer out-vatp_gds-dtl     for ub.gds-dtl.
