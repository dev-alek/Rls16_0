     6357           if SumsOnly = no then do:
     6358             put stream outstream  "|" gds-prop.cli-name format "X(29)" "|" at print-o skip .
     6359             run macr_excel_char (gds-prop.cli-name, v-row, 1) .              assign v-row = v-row + 1 .
     6360           End.
     6361           for each temp-sum where temp-sum.level = 5 : assign temp-sum.sum = 0 . end.
     6362         End.
     6363         if first-of(gds-prop.gds-code) then do:
