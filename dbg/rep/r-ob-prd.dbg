     2643               ,output vat-rubl-sale-prl
     2644               ,output vat-base-buyer-prl
     2645               ,output vat-rubl-buyer-prl
     2646               ,output slt-base-sale-prl
     2647               ,output slt-rubl-sale-prl
     2648               ,output road-tax-base-sale-prl
     2649               ,output road-tax-rubl-sale-prl
     2650               ,output excise-base-sale-prl
     2651               ,output excise-rubl-sale-prl
     2652               ,output discnt-base-sale-prl
     2653               ,output discnt-rubl-sale-prl
     2654               ) no-error .
     2655             if error-status :error
     2656             then do:
     2657               message
     2658                 vss-workfile vss-revision vss-description skip
     2659                 vss-include-info20 skip
     2660                 "Ошибка при вызове процеды prl-vat" skip
     2661                 "Документ" buf_price-list.doc-num skip
     2662                 "Артикул" buf_price-list.artic buf_price-list.prod-type buf_price-list.prod-code skip
     2663                 error-status :get-message(1) skip
