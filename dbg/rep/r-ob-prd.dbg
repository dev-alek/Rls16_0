     5400       ,input 7
     5401       ,output v-user-action
     5402       ,output v-printed
     5403       ) .
     5404   end.
     5405   procedure GetName :
     5406     do
     5407     on error undo, return error return-value
     5408     :
     5409       define output parameter str as character no-undo .
     5410       case SortCli:
     5411         when 1 then do:
     5412           assign str = gds-prop.cli-name .
     5413         end.
     5414         when 2 or when 3 then do:
     5415           if gds-prop.s-ind = ? then assign str = "?" .
     5416           else do:
     5417             find first buf1_clients no-lock
     5418               where buf1_clients.obj-type = 'чел':U
     5419                 and buf1_clients.obj-code = gds-prop.s-ind
     5420             .
     5421             assign str = buf1_clients.obj-name .
     5422           end.
     5423         end.
     5424         when 4 then do:
     5425           find first buf_pay-type no-lock where buf_pay-type.obj-code = gds-prop.s-ind .
     5426           assign str = buf_pay-type.obj-name .
     5427         end.
     5428         when 5 then do:
     5429           find first buf_cli-grp no-lock where buf_cli-grp.node-code = gds-prop.s-ind .
     5430           assign str = buf_cli-grp.node-name .
     5431         end.
     5432       end case.
     5433     end.
     5434   end procedure.
     5435   procedure PutItogSum :
     5436     define input  parameter p-name as character no-undo .
     5437     define input  parameter p-num  as integer   no-undo .
     5438     define buffer buf_temp-sum for temp-sum .
     5439     define buffer buf1_temp-sum for temp-sum .
     5440     define variable smm as decimal   no-undo .
     5441     assign  beg = 1  v-col = 1 .
     5442     put stream outstream  "|" at beg p-name format "X(29)" .  assign beg = beg + 30  .
     5443     run macr_excel_char (p-name, v-row, v-col) .              assign v-col = v-col + 1 .
     5444     if SumsOnly = no then do:
     5445       put stream outstream  "|" at beg .  assign beg = beg + 14 .
     5446       put stream outstream  "|" at beg .  assign beg = beg + 15 .
     5447       put stream outstream  "|" at beg .  assign beg = beg + 30 .
     5448       assign v-col = v-col + 3 .
     5449     end.
     5450     for each  buf_temp-sum where buf_temp-sum.level = p-num :
     5451       if use-column[ buf_temp-sum.num ] = no then next .
     5452       case buf_temp-sum.sum-type :
     5453         when 0 then do:
     5454           put stream outstream  "|" at beg buf_temp-sum.sum format frm-qnty  .
     5455           run macr_excel_sum (buf_temp-sum.sum, v-row, v-col, sz-qnty) .
     5456           assign  beg = beg + 14 .
     5457         end.
     5458         when 1 or when 2 or when 3 then do:
     5459           put stream outstream  "|" at beg buf_temp-sum.sum format frm-sum .
     5460           run macr_excel_sum (buf_temp-sum.sum, v-row, v-col, 2) .
     5461           assign  beg = beg + 14 .
     5462         end.
     5463         when 4 then do:
     5464           if buf_temp-sum.num <> 24 then do:
     5465             find first buf1_temp-sum where buf1_temp-sum.level = p-num and buf1_temp-sum.num = (buf_temp-sum.num - 1) no-error .
     5466             if available buf1_temp-sum then assign smm = buf1_temp-sum.sum .
     5467             find first buf1_temp-sum where buf1_temp-sum.level = p-num and buf1_temp-sum.num = (buf_temp-sum.num - 2) no-error .
     5468             if available buf1_temp-sum then assign smm = smm * 100 / ( smm + buf1_temp-sum.sum ) .
     5469           end.
     5470           else do:
     5471             find first buf1_temp-sum where buf1_temp-sum.level = p-num and buf1_temp-sum.num = 17 no-error .
     5472             if available buf1_temp-sum then assign smm = buf1_temp-sum.sum .
     5473             find first buf1_temp-sum where buf1_temp-sum.level = p-num and buf1_temp-sum.num = 16 no-error .
     5474             if available buf1_temp-sum then assign smm = ( smm - buf1_temp-sum.sum ) * 100 / buf1_temp-sum.sum .
     5475           end.
     5476           if smm = ? then assign smm = 0 .
     5477           put stream outstream  "|" at beg smm format frm-prc .
     5478           run macr_excel_sum (smm, v-row, v-col, 2) .
     5479           assign  beg = beg + 10 .
     5480         end.
     5481       end.
     5482       assign v-col = v-col + 1 .
     5483     end.
     5484     if p-num > 2 then put stream outstream   "|" at print-o skip .
     5485     else              put stream outstream   "|" at print-o skip Line format frmt skip.
     5486     assign v-row = v-row + 1 .
     5487   end procedure .
     5488   procedure CalculSum :
     5489     define input  parameter p-num as integer   no-undo .
     5490     define buffer buf_temp-sum for temp-sum .
     5491     for each temp-sum where temp-sum.level = -1 :
     5492       find first buf_temp-sum
     5493         where buf_temp-sum.level    = p-num
     5494           and buf_temp-sum.num      = temp-sum.num
     5495           and buf_temp-sum.doc-type = temp-sum.doc-type
     5496           and buf_temp-sum.sum-type = temp-sum.sum-type
     5497       no-error .
     5498       if not available buf_temp-sum then do:
     5499         create buf_temp-sum .
     5500         assign
     5501           buf_temp-sum.level    = p-num
     5502           buf_temp-sum.num      = temp-sum.num
     5503           buf_temp-sum.doc-type = temp-sum.doc-type
     5504           buf_temp-sum.sum-type = temp-sum.sum-type
     5505           buf_temp-sum.sum      = temp-sum.sum
     5506         .
     5507       end.
     5508       else assign buf_temp-sum.sum = buf_temp-sum.sum + temp-sum.sum .
     5509     end.
     5510   end procedure.
     5511   procedure Add-gds-prop :
     5512     define input  parameter p-num as integer   no-undo .
     5513     do on error undo, return error return-value :
     5514       if SortCli = 1 then do:
     5515         find first gds-prop
     5516           where gds-prop.artic     = buf_doc-line.artic
     5517             and gds-prop.prod-type = buf_doc-line.prod-type
     5518             and gds-prop.prod-code = buf_doc-line.prod-code
     5519             and gds-prop.cli-type  = buf_trn-doc.cli-type
     5520             and gds-prop.cli-code  = buf_trn-doc.cli-code
     5521         no-error .
     5522       end.
     5523       else do:
     5524         find first gds-prop
     5525           where gds-prop.artic     = buf_doc-line.artic
     5526             and gds-prop.prod-type = buf_doc-line.prod-type
     5527             and gds-prop.prod-code = buf_doc-line.prod-code
     5528             and gds-prop.s-ind     = p-num
     5529         no-error .
     5530       end.
     5531       if not available gds-prop then do:
     5532         create gds-prop .
     5533         find first buf_goods no-lock
     5534           where buf_goods.artic     = buf_doc-line.artic
     5535             and buf_goods.prod-type = buf_doc-line.prod-type
     5536             and buf_goods.prod-code = buf_doc-line.prod-code
     5537         no-error .
     5538         if g#gds-engl then assign gds-prop.gds-name = buf_goods.engl-name.
     5539         else               assign gds-prop.gds-name = buf_goods.gds-name.
     5540   define variable vss-include-info56 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5541   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rootnode in g#library
     5542     (input  buf_goods.artic
     5543     ,input  buf_goods.prod-type
     5544     ,input  buf_goods.prod-code
     5545     ,output v-root-node
     5546     )  .
     5547   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prtat in g#library
     5548     (input  v-root-node
     5549     ,input  'empty-scale=request'
     5550     ,output gds-prop.empty-scale
     5551     )  .
     5552   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     5553     (input  buf_goods.gds-code
     5554     ,input  ?
     5555     ,output ii
     5556     ) no-error .
     5557         if error-status :error then do:
     5558           message vss-workfile vss-revision vss-description skip "Ошибка при определении бар-кода товара" skip  "Код товара" skip
     5559           view-as alert-box error .
     5560           undo, return error .
     5561          end.
     5562         assign
     5563           gds-prop.artic     = buf_doc-line.artic
     5564           gds-prop.prod-type = buf_doc-line.prod-type
     5565           gds-prop.prod-code = buf_doc-line.prod-code
     5566           gds-prop.gds-code  = buf_goods.gds-code
     5567           gds-prop.grp-name  = buf_goods.grp-name
     5568           gds-prop.b-code    = string(ii,">>>>>>>>>>>>9")
     5569           gds-prop.grp-code  = buf_goods.grp-code
     5570           gds-prop.cli-type  = buf_trn-doc.cli-type
     5571           gds-prop.cli-code  = buf_trn-doc.cli-code
     5572           gds-prop.cli-name  = buf_trn-doc.cli-name
     5573         .
     5574         case SortCli :
     5575           when 3 then assign gds-prop.s-ind = buf_trn-doc.agnt .
     5576           when 2 then assign gds-prop.s-ind = buf_trn-doc.boss .
     5577           when 4 then assign gds-prop.s-ind = buf_trn-doc.pay-code .
     5578           when 5 then assign gds-prop.s-ind = buf1_clients.grp-code .
     5579         end.
     5580       end.
     5581       if gds-prop.empty-scale = no then do:
     5582         FOR EACH buf_gds-dtl no-lock
     5583           where buf_gds-dtl.artic     = buf_doc-line.artic
     5584             AND buf_gds-dtl.doc-code  = buf_doc-line.doc-code
     5585             AND buf_gds-dtl.prod-code = buf_doc-line.prod-code
     5586             AND buf_gds-dtl.prod-type = buf_doc-line.prod-type
     5587           :
     5588   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     5589     (input  gds-prop.gds-code
     5590     ,input  buf_gds-dtl.prt-code
     5591     ,output v-prt-b-code
     5592     ) no-error .
     5593           if error-status :error then do:
     5594             message  vss-workfile vss-revision vss-description skip "Ошибка при определении бар-кода признака" skip
     5595             "Код товара"   gds-prop.gds-code skip  "Код признака" buf_gds-dtl.prt-code skip error-status :get-message(1) skip
     5596              return-value skip view-as alert-box error .
     5597             undo, return error .
     5598           end.
     5599           run Add-temp-prt ( gds-prop.gds-code, gds-prop.cli-type, gds-prop.cli-code, gds-prop.s-ind, 0, edt, buf_gds-dtl.prt-code, v-prt-b-code, buf_gds-dtl.fact-qnty ) .
     5600           run Add-temp-prt ( gds-prop.gds-code, gds-prop.cli-type, gds-prop.cli-code, gds-prop.s-ind, 1, edt, buf_gds-dtl.prt-code, v-prt-b-code, buf_gds-dtl.fact-qnty * (if var-report-r-b = "rubl" then v1-sum-rubl else v1-sum-base) / v1-fact-qnty ) .
     5601           if buf_trn-doc.ext-doc-type <> 'ie':U         and
     5602              buf_trn-doc.ext-doc-type <> 'ep':U      then do:
     5603             run Add-temp-prt ( gds-prop.gds-code, gds-prop.cli-type, gds-prop.cli-code, gds-prop.s-ind, 2, edt, buf_gds-dtl.prt-code, v-prt-b-code, buf_gds-dtl.fact-qnty * (if var-report-r-b = "rubl" then buf_gds-dtl.price-rubl else buf_gds-dtl.price-base) ) .
     5604             if   buf_trn-doc.ext-doc-type = 'ee':U
     5605               or buf_trn-doc.ext-doc-type = 'es':U
     5606               or buf_trn-doc.ext-doc-type = 're':U
     5607               or buf_trn-doc.ext-doc-type = 'rs':U
     5608             then do:
     5609               run Add-temp-prt ( gds-prop.gds-code, gds-prop.cli-type, gds-prop.cli-code, gds-prop.s-ind, 3, edt, buf_gds-dtl.prt-code, v-prt-b-code,  buf_gds-dtl.fact-qnty * (if var-report-r-b = "rubl" then buf_gds-dtl.discnt-rubl else buf_gds-dtl.discnt-base) ) .
     5610             end.
     5611           end.
     5612         end.
     5613       end.
     5614       if buf_trn-doc.ext-doc-type = 'ee':U      or
     5615          buf_trn-doc.ext-doc-type = 'es':U or
     5616          buf_trn-doc.ext-doc-type = 'ep':U   or
     5617          buf_trn-doc.ext-doc-type = 'ev':U      or
     5618          buf_trn-doc.ext-doc-type = 'we':U      then
     5619         assign
     5620           v1-sum-rubl   = - v1-sum-rubl
     5621           v1-sum-base   = - v1-sum-base
     5622           v1-fact-qnty  = - v1-fact-qnty
     5623           v2-sum-rubl   = - v2-sum-rubl
     5624           v2-sum-base   = - v2-sum-base
     5625           v2-other-rubl = - v2-other-rubl
     5626           v2-other-base = - v2-other-base
     5627         .
     5628       run Add-temp-prt ( gds-prop.gds-code, gds-prop.cli-type, gds-prop.cli-code, gds-prop.s-ind, 0, edt, -1, gds-prop.b-code, v1-fact-qnty) .
     5629       run Add-temp-prt ( gds-prop.gds-code, gds-prop.cli-type, gds-prop.cli-code, gds-prop.s-ind, 1, edt, -1, gds-prop.b-code, (if var-report-r-b = "rubl" then v1-sum-rubl else v1-sum-base)) .
     5630       if buf_trn-doc.ext-doc-type <> 'ie':U and  buf_trn-doc.ext-doc-type <> 'ep':U  then do:
     5631         if   buf_trn-doc.ext-doc-type = 'ee':U
     5632           or buf_trn-doc.ext-doc-type = 'es':U
     5633           or buf_trn-doc.ext-doc-type = 're':U
     5634           or buf_trn-doc.ext-doc-type = 'rs':U
     5635         then do:
     5636           run Add-temp-prt ( gds-prop.gds-code, gds-prop.cli-type, gds-prop.cli-code, gds-prop.s-ind, 3, edt, -1, gds-prop.b-code, (if var-report-r-b = "rubl" then v2-other-rubl else v2-other-base)) .
     5637           run Add-temp-prt ( gds-prop.gds-code, gds-prop.cli-type, gds-prop.cli-code, gds-prop.s-ind, 4, edt, -1, gds-prop.b-code, (if var-report-r-b = "rubl" then v2-other-rubl * 100 / ( v2-other-rubl + v2-sum-rubl ) else v2-other-base * 100 / ( v2-other-base + v2-sum-base ) ) ) .
     5638         end.
     5639         run Add-temp-prt ( gds-prop.gds-code, gds-prop.cli-type, gds-prop.cli-code, gds-prop.s-ind, 2, edt, -1, gds-prop.b-code, (if var-report-r-b = "rubl" then v2-sum-rubl else v2-sum-base) ) .
     5640       end.
     5641     end.
     5642   end procedure.
     5643   procedure Add-temp-prt :
     5644     define input  parameter p-gds-code as integer   no-undo .
     5645     define input  parameter p-cli-type as character no-undo .
     5646     define input  parameter p-cli-code as integer   no-undo .
     5647     define input  parameter p-s-ind    as integer   no-undo .
     5648     define input  parameter p-num      as integer   no-undo .
     5649     define input  parameter p-type     as character no-undo .
     5650     define input  parameter p-prt-code as integer   no-undo .
     5651     define input  parameter p-b-code   as integer   no-undo .
     5652     define input  parameter p-val      as decimal   no-undo .
     5653     do on error undo, return error return-value :
     5654       if SortCli = 1 then do:
     5655         find first temp-prt
     5656           where temp-prt.gds-code = p-gds-code
     5657             and temp-prt.prt-code = p-prt-code
     5658             and temp-prt.sum-type = p-num
     5659             and temp-prt.doc-type = p-type
     5660             and temp-prt.cli-type = p-cli-type
     5661             and temp-prt.cli-code = p-cli-code
     5662         no-error .
     5663       end.
     5664       else do:
     5665         find first temp-prt
     5666           where temp-prt.gds-code = p-gds-code
     5667             and temp-prt.prt-code = p-prt-code
     5668             and temp-prt.sum-type = p-num
     5669             and temp-prt.doc-type = p-type
     5670             and temp-prt.s-ind    = p-s-ind
     5671         no-error .
     5672       end.
     5673       if not available temp-prt then do:
     5674         create temp-prt .
     5675         ASSIGN
     5676           temp-prt.gds-code = p-gds-code
     5677           temp-prt.prt-code = p-prt-code
     5678           temp-prt.b-code   = p-b-code
     5679           temp-prt.doc-type = p-type
     5680           temp-prt.sum-type = p-num
     5681           temp-prt.cli-type = p-cli-type
     5682           temp-prt.cli-code = p-cli-code
     5683           temp-prt.s-ind    = p-s-ind
     5684         .
     5685       end.
     5686       assign temp-prt.sum = temp-prt.sum + p-val .
     5687     end.
     5688   end procedure.
     5689   procedure Add-temp-sum :
     5690     define input  parameter p-gds-code as integer   no-undo .
     5691     define input  parameter p-cli-type as character no-undo .
     5692     define input  parameter p-cli-code as integer   no-undo .
     5693     define input  parameter p-s-ind    as integer   no-undo .
     5694     define input  parameter p-num      as integer   no-undo .
     5695     define input  parameter p-type     as character no-undo .
     5696     define input  parameter p-prt-code as integer   no-undo .
     5697     define input  parameter p-count    as integer   no-undo .
     5698     define buffer buf_temp-prt for temp-prt .
     5699     define variable lvl as integer  no-undo .
     5700     define variable tp-str as character no-undo .
     5701     if p-prt-code <> -1 then  assign lvl = - 2 .
     5702     else                      assign lvl = - 1 .
     5703     do on error undo, return error return-value :
     5704       find first temp-sum
     5705         where temp-sum.level    = lvl
     5706           and temp-sum.num      = p-count
     5707           and temp-sum.doc-type = p-type
     5708           and temp-sum.sum-type = p-num
     5709       no-error  .
     5710       if not available temp-sum then do:
     5711         create temp-sum .
     5712         assign
     5713           temp-sum.doc-type = p-type
     5714           temp-sum.num      = p-count
     5715           temp-sum.level    = lvl
     5716           temp-sum.sum-type = p-num
     5717           temp-sum.sum      = 0
     5718         .
     5719       end.
     5720       if     p-type <> "rs-vz" and p-type <> "eff-val" and p-type <> "eff-prc" then do:
     5721         if SortCli = 1 then do:
     5722           find first buf_temp-prt
     5723             where buf_temp-prt.gds-code = p-gds-code
     5724               and buf_temp-prt.prt-code = p-prt-code
     5725               and buf_temp-prt.sum-type = p-num
     5726               and buf_temp-prt.doc-type = p-type
     5727               and buf_temp-prt.cli-type = p-cli-type
     5728               and buf_temp-prt.cli-code = p-cli-code
     5729           no-error .
     5730         end.
     5731         else do:
     5732           find first buf_temp-prt
     5733             where buf_temp-prt.gds-code = p-gds-code
     5734               and buf_temp-prt.prt-code = p-prt-code
     5735               and buf_temp-prt.sum-type = p-num
     5736               and buf_temp-prt.doc-type = p-type
     5737               and buf_temp-prt.s-ind    = p-s-ind
     5738           no-error .
     5739         end.
     5740         if available buf_temp-prt then assign temp-sum.sum  = buf_temp-prt.sum  .
     5741       end.
     5742       else do:
     5743         if p-num = 4 and p-type <> "eff-prc" then do:
     5744           define buffer buf1_temp-sum for temp-sum .
     5745           find first buf1_temp-sum where buf1_temp-sum.level = lvl and buf1_temp-sum.sum-type = 2 and buf1_temp-sum.doc-type = p-type no-error .
     5746           if available buf1_temp-sum then assign temp-sum.sum  = buf1_temp-sum.sum.
     5747           find first buf1_temp-sum where buf1_temp-sum.level = lvl and buf1_temp-sum.sum-type = 3 and buf1_temp-sum.doc-type = p-type no-error .
     5748           if available buf1_temp-sum then assign temp-sum.sum  =  buf1_temp-sum.sum * 100 / (temp-sum.sum + buf1_temp-sum.sum) .
     5749         end.
     5750         else do:
     5751           case p-type :
     5752             when "rs-vz" then do:
     5753               do ii = 1 to 4:
     5754                 case ii:
     5755                   when 1 then assign tp-str = 'ee':U .
     5756                   when 2 then assign tp-str = 're':U .
     5757                   when 3 then assign tp-str = 'es':U .
     5758                   when 4 then assign tp-str = 'rs':U .
     5759                 end.
     5760                 if SortCli = 1 then do:
     5761                   find first buf_temp-prt
     5762                     where buf_temp-prt.gds-code = p-gds-code and buf_temp-prt.prt-code = p-prt-code
     5763                       and buf_temp-prt.sum-type = p-num      and buf_temp-prt.doc-type = tp-str
     5764                       and buf_temp-prt.cli-type = p-cli-type and buf_temp-prt.cli-code = p-cli-code
     5765                   no-error .
     5766                 end.
     5767                 else do:
     5768                   find first buf_temp-prt
     5769                     where buf_temp-prt.gds-code = p-gds-code and buf_temp-prt.prt-code = p-prt-code
     5770                       and buf_temp-prt.sum-type = p-num      and buf_temp-prt.doc-type = tp-str
     5771                       and buf_temp-prt.s-ind    = p-s-ind
     5772                   no-error .
     5773                 end.
     5774                 if available buf_temp-prt then do:
     5775                   if ii = 1 or ii = 3 then assign temp-sum.sum = temp-sum.sum + buf_temp-prt.sum .
     5776                   else                     assign temp-sum.sum = temp-sum.sum - buf_temp-prt.sum .
     5777                 end.
     5778               end.
     5779             end.
     5780             when "eff-val" or when "eff-prc" then do:
     5781               define variable sm1 as decimal initial 0 no-undo .
     5782               define variable sm2 as decimal initial 0 no-undo .
     5783               do ii = 1 to 4:
     5784                 case ii:
     5785                   when 1 then assign tp-str = 'ee':U .
     5786                   when 2 then assign tp-str = 're':U .
     5787                   when 3 then assign tp-str = 'es':U .
     5788                   when 4 then assign tp-str = 'rs':U .
     5789                 end.
     5790                 if SortCli = 1 then do:
     5791                   find first buf_temp-prt
     5792                     where buf_temp-prt.gds-code = p-gds-code and buf_temp-prt.prt-code = p-prt-code
     5793                       and buf_temp-prt.sum-type = 2          and buf_temp-prt.doc-type = tp-str
     5794                       and buf_temp-prt.cli-type = p-cli-type and buf_temp-prt.cli-code = p-cli-code
     5795                   no-error .
     5796                 end.
     5797                 else do:
     5798                   find first buf_temp-prt
     5799                     where buf_temp-prt.gds-code = p-gds-code and buf_temp-prt.prt-code = p-prt-code
     5800                       and buf_temp-prt.sum-type = 2          and buf_temp-prt.doc-type = tp-str
     5801                       and buf_temp-prt.s-ind    = p-s-ind
     5802                   no-error .
     5803                 end.
     5804                 if available buf_temp-prt then do:
     5805                   if ii = 1 or ii = 3 then assign sm2 = sm2 + buf_temp-prt.sum .
     5806                   else                     assign sm2 = sm2 - buf_temp-prt.sum .
     5807                 end.
     5808                 if SortCli = 1 then do:
     5809                   find first buf_temp-prt
     5810                     where buf_temp-prt.gds-code = p-gds-code and buf_temp-prt.prt-code = p-prt-code
     5811                       and buf_temp-prt.sum-type = 1          and buf_temp-prt.doc-type = tp-str
     5812                       and buf_temp-prt.cli-type = p-cli-type and buf_temp-prt.cli-code = p-cli-code
     5813                   no-error .
     5814                 end.
     5815                 else do:
     5816                   find first buf_temp-prt
     5817                     where buf_temp-prt.gds-code = p-gds-code and buf_temp-prt.prt-code = p-prt-code
     5818                       and buf_temp-prt.sum-type = 1          and buf_temp-prt.doc-type = tp-str
     5819                       and buf_temp-prt.s-ind    = p-s-ind
     5820                   no-error .
     5821                 end.
     5822                 if available buf_temp-prt then do:
     5823                   if ii = 1 or ii = 3 then assign sm1 = sm1 + buf_temp-prt.sum .
     5824                   else                     assign sm1 = sm1 - buf_temp-prt.sum .
     5825                 end.
     5826               end.
     5827               if p-type = "eff-prc" then assign temp-sum.sum = (sm2 - sm1) * 100 / sm1 .
     5828               else                       assign temp-sum.sum = sm2 - sm1 .
     5829             end.
     5830           end.
     5831         end.
     5832       end.
     5833       if temp-sum.sum = ? then assign temp-sum.sum = 0 .
     5834     end.
     5835   end procedure.
     5836   procedure PutColumnTitulExcel :
     5837     do
     5838     on error undo, return error return-value
     5839     :
     5840     assign
     5841       v-col = 1
     5842       v-row = 1
     5843     .
     5844     run macr_excel_char (ReportNAme, v-row, 2) .
     5845     run macr_cell_format ( 11, yes, no, ?, v-row, 2, v-row, 2) .
     5846     assign v-row = v-row + 1 .
     5847     run macr_excel_char (str1, v-row, v-col) .                          assign v-row = v-row + 1 .
     5848     run macr_excel_char (str2, v-row, v-col) .                          assign v-row = v-row + 1 .
     5849     run macr_excel_char (str3, v-row, v-col) .                          assign v-row = v-row + 1 .
     5850     run macr_excel_char ("Выбранные объекты: " + str4, v-row, v-col) .  assign v-row = v-row + 1 .
     5851     run macr_excel_char (ReportHeader, v-row, v-col) .                  assign v-row = v-row + 1 .
     5852     assign v-col = 1 .
     5853     run macr_excel_char ("Контрагент", v-row, v-col) .        run macr_cell_size (40,?, v-row, v-col,?,?).  assign v-col = v-col + 1 .
     5854     if SumsOnly = no then do:
     5855       run macr_excel_char ("Код", v-row, v-col) .             run macr_cell_size (13,?, v-row, v-col,?,?).  assign v-col = v-col + 1 .
     5856       run macr_excel_char ("Артикул", v-row, v-col) .         run macr_cell_size (16,?, v-row, v-col,?,?).  assign v-col = v-col + 1 .
     5857       run macr_excel_char ("Название товара", v-row, v-col) . run macr_cell_size (40,?, v-row, v-col,?,?).  assign v-col = v-col + 1 .
     5858     end.
     5859     if use-column[1 ] = yes then do: run macr_excel_char ("Приход внешний (кол-во)", v-row, v-col) .   assign v-col = v-col + 1 .                end.
     5860     if use-column[2 ] = yes then do: run macr_excel_char ("Приход внешний (сумма учет. цен)", v-row, v-col) .    assign v-col = v-col + 1 .      end.
     5861     if use-column[3 ] = yes then do: run macr_excel_char ("Возврат поставщику (кол-во)", v-row, v-col) .         assign v-col = v-col + 1 .      end.
     5862     if use-column[4 ] = yes then do: run macr_excel_char ("Возврат поставщику (сумма учет. цен)", v-row, v-col) .    assign v-col = v-col + 1 .  end.
     5863     if use-column[5 ] = yes then do: run macr_excel_char ("Расход внешний (кол-во)", v-row, v-col) .    assign v-col = v-col + 1 .               end.
     5864     if use-column[6 ] = yes then do: run macr_excel_char ("Расход внешний (сумма учет. цен)", v-row, v-col) .    assign v-col = v-col + 1 .      end.
     5865     if use-column[7 ] = yes then do: run macr_excel_char ("Расход внешний (сумма прод. цен)", v-row, v-col) .    assign v-col = v-col + 1 .      end.
