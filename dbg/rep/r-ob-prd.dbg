     2268   procedure prdoclib-create-temp-prt-obj :
     2269     define input parameter  p-root-price-sale like ub.price-list.price-sale no-undo .
     2270     define parameter buffer buf_prt-obj       for ub.prt-obj .
     2271     define parameter buffer buf_temp-prt-obj  for temp-prt-obj .
