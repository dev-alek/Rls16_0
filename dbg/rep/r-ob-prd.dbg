     2289         .
     2290         find first buf_gds-prt no-lock
     2291           where buf_gds-prt.node-code = buf_temp-prt-obj.prt-code
     2292           .
     2293         assign
     2294           buf_temp-prt-obj.is-term = buf_gds-prt.is-term
     2295         .
     2296         if buf_temp-prt-obj.is-term
     2297         then do:
     2298           assign
     2299             buf_temp-prt-obj.price-sale = p-root-price-sale
     2300           .
     2301         end.
     2302       end.
     2303     end.
     2304   end procedure.
     2305   procedure prdoclib-temp-prt-obj-by-prt-root :
     2306     define input parameter  p-prt-code like ub.prt-obj.prt-code no-undo .
     2307     define parameter buffer buf_temp-prt-obj  for temp-prt-obj .
     2308     define buffer buf_gds-prt for ub.gds-prt .
     2309     do
     2310     on error undo, return error return-value
     2311     :
     2312       find first buf_temp-prt-obj
     2313         where buf_temp-prt-obj.prt-code = p-prt-code
     2314         no-error .
     2315       if not available buf_temp-prt-obj
     2316       then do:
     2317         create buf_temp-prt-obj .
     2318         assign
     2319           buf_temp-prt-obj.prt-code         = p-prt-code
     2320           buf_temp-prt-obj.price-sale       = ?
     2321           buf_temp-prt-obj.fact-qnty        = 0
     2322           buf_temp-prt-obj.price-list-qnty  = ?
     2323           buf_temp-prt-obj.prt-obj-recid    = ?
     2324           buf_temp-prt-obj.price-list-recid = ?
     2325         .
     2326         find first buf_gds-prt no-lock
     2327           where buf_gds-prt.node-code = buf_temp-prt-obj.prt-code
     2328           .
     2329         assign
     2330           buf_temp-prt-obj.is-term = buf_gds-prt.is-term
     2331         .
     2332         if buf_temp-prt-obj.is-term
     2333         then do:
     2334           assign
     2335             buf_temp-prt-obj.price-sale = 0
     2336           .
     2337         end.
     2338       end.
     2339     end.
     2340   end procedure.
     2341   procedure prdoclib-init-temp-prt-obj :
     2342     define input parameter p-obj-type        like ub.prt-obj.obj-type  no-undo .
     2343     define input parameter p-obj-code        like ub.prt-obj.obj-code  no-undo .
     2344     define input parameter p-artic           like ub.prt-obj.artic     no-undo .
     2345     define input parameter p-prod-type       like ub.prt-obj.prod-type no-undo .
     2346     define input parameter p-prod-code       like ub.prt-obj.prod-code no-undo .
     2347     define input parameter p-root-price-sale like ub.prt-obj.price-sale no-undo .
     2348     define buffer buf_prt-obj      for ub.prt-obj .
     2349     define buffer buf_temp-prt-obj for temp-prt-obj .
     2350     do
     2351     on error undo, return error return-value
     2352     :
     2353       run prdoclib-clear-temp-prt-obj in this-procedure .
     2354       for each buf_prt-obj
     2355         where buf_prt-obj.obj-type  = p-obj-type
     2356           and buf_prt-obj.obj-code  = p-obj-code
     2357           and buf_prt-obj.artic     = p-artic
     2358           and buf_prt-obj.prod-type = p-prod-type
     2359           and buf_prt-obj.prod-code = p-prod-code
     2360       on error undo, return error return-value
     2361       :
     2362         run prdoclib-create-temp-prt-obj in this-procedure
     2363           (input  p-root-price-sale
     2364           ,buffer buf_prt-obj
     2365           ,buffer buf_temp-prt-obj
     2366           ).
     2367       end.
     2368     end.
     2369   end procedure.
     2370   procedure prdoclib-calc-fact-sale :
     2371     define input  parameter p-price-list-recid   as recid     no-undo .
     2372     define output parameter p-fact-qnty          as decimal   no-undo .
     2373     define output parameter p-cur-base           as decimal   no-undo .
     2374     define output parameter p-cur-VAT-base       as decimal   no-undo .
