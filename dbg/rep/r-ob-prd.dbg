     2586           undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     2587         end.
     2588         for each buf_price-list no-lock
     2589           where buf_price-list.doc-num    = buf_main_price-list.doc-num
     2590             and buf_price-list.main-price = false
     2591             and buf_price-list.artic      = buf_main_price-list.artic
