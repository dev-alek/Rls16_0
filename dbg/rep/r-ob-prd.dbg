     2493           ,output price-rubl-with-tax-sale-prl
     2494           ,output price-base-with-tax-sale-prl
     2495           ,output price-rubl-without-tax-sale-prl
     2496           ,output price-base-without-tax-sale-prl
     2497           ,output vat-base-sale-prl
     2498           ,output vat-rubl-sale-prl
     2499           ,output vat-base-buyer-prl
     2500           ,output vat-rubl-buyer-prl
     2501           ,output slt-base-sale-prl
     2502           ,output slt-rubl-sale-prl
     2503           ,output road-tax-base-sale-prl
     2504           ,output road-tax-rubl-sale-prl
     2505           ,output excise-base-sale-prl
     2506           ,output excise-rubl-sale-prl
     2507           ,output discnt-base-sale-prl
     2508           ,output discnt-rubl-sale-prl
     2509           ) no-error .
     2510         if error-status :error
     2511         then do:
     2512           message
     2513             vss-workfile vss-revision vss-description skip
