     1641                   p-road-tax-rubl       = p-road-tax-rubl + road-tax-rubl-sale        * v-gds-dtl-fact-qnty
     1642                   p-excise-base         = p-excise-base   + excise-base-sale          * v-gds-dtl-fact-qnty
     1643                   p-excise-rubl         = p-excise-rubl   + excise-rubl-sale          * v-gds-dtl-fact-qnty
     1644                   p-other-base          = p-other-base    + discnt-base-sale          * v-gds-dtl-fact-qnty
     1645                   p-other-rubl          = p-other-rubl    + discnt-rubl-sale          * v-gds-dtl-fact-qnty
     1646               .
     1647           end.
     1648       end.
     1649       assign
     1650           p-transport-base      = 0
     1651           p-transport-rubl      = 0
     1652           p-vat-pc              = buf_doc-line.vat-pc
     1653           p-slt-pc              = buf_doc-line.slt-pc
     1654       .
     1655     end.
     1656     if p-fact-qnty      = ?
     1657     or p-vat-pc         = ?
     1658     or p-slt-pc         = ?
     1659     or p-sum-base       = ?
     1660     or p-sum-rubl       = ?
     1661     or p-vat-base       = ?
     1662     or p-vat-rubl       = ?
     1663     or p-slt-base       = ?
     1664     or p-slt-rubl       = ?
     1665     or p-road-tax-base  = ?
     1666     or p-road-tax-rubl  = ?
