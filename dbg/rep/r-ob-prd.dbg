     2386     on stop undo, return error substitute(" stop &1 &2" , return-value , error-status :get-message(1)  )
     2387     on end-key undo, return error substitute(" end-key &1 &2" , return-value , error-status :get-message(1)  )
     2388     :
     2389       find first buf_main_price-list no-lock
     2390         where recid(buf_main_price-list) = p-price-list-recid
     2391         no-error .
