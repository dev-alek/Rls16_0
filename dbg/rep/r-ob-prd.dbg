     2466     ,input  buf_goods.prod-code
     2467     ,buffer buf_gds-obj
     2468     ) no-error .
     2469           if error-status :error then do:
     2470              undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     2471           end.
     2472         end.
     2473       define variable price-rubl-with-tax-sale-prl    as decimal   no-undo .
     2474       define variable price-base-with-tax-sale-prl    as decimal   no-undo .
