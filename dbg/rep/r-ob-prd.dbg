     6003   procedure PrintLine :
     6004     do  on error undo, return error return-value  :
     6005     if line-counter( Outstream ) + 2 > page-size( Outstream ) then do:
     6006       put stream outstream  skip Line format frmt skip "продолжение - на следующей странице" AT 30 SKIP .
     6007       page stream OutStream .
     6008       run PrintTitul in this-procedure .
     6009     end.
     6010     if  ( v-row ) >= 63000 then do:
     6011       Output stream Macr_Excel  close .
     6012       run paramls-write in this-procedure (input "file",input string(v-ind),input v-file-name ) .
     6013       run gbl/_tmpfile.p ("wb", ".txt", output v-file-name) .
     6014       output stream  Macr_Excel to value(v-file-name) .
     6015       v-ind = v-ind + 1 .
     6016       run PutColumnTitulExcel in this-procedure .
     6017     end.
     6018     for each temp-sum where temp-sum.level = -1 :   assign temp-sum.sum = 0  . end.
     6019     assign jj = 1 .
     6020     run Add-temp-sum (  gds-prop.gds-code, gds-prop.cli-type, gds-prop.cli-code, gds-prop.s-ind, 0, 'ie':U, -1, jj ) .     assign jj = jj + 1 .
