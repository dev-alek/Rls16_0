     6050       end.
     6051     end.
     6052     if null-oborot = no and SumsOnly = no  then do:
     6053       assign
     6054         v-col = 1
     6055         beg   = 1
     6056       .
     6057       put stream outstream  "|" at beg  .
     6058       assign v-col = v-col + 1    beg = beg + 30 .
     6059       if SumsOnly = no then do:
     6060         put stream outstream  "|" at beg  gds-prop.b-code   format "X(13)" .
     6061         run macr_excel_char (string(gds-prop.b-code), v-row, v-col) .
     6062         assign v-col = v-col + 1    beg = beg + 14 .
     6063         put stream outstream  "|" at beg  gds-prop.artic    format "X(14)" .
     6064         run macr_excel_char (string(gds-prop.artic), v-row, v-col) .
     6065         assign v-col = v-col + 1    beg = beg + 15 .
     6066         put stream outstream  "|" at beg  gds-prop.gds-name format "X(29)" .
     6067         run macr_excel_char (string(gds-prop.gds-name), v-row, v-col) .
     6068         assign v-col = v-col + 1    beg = beg + 30 .
     6069       end.
     6070       for each temp-sum where temp-sum.level = -1 :
     6071         if use-column[ temp-sum.num ] = no then next .
     6072         case temp-sum.sum-type :
     6073           when 0 then do:
     6074             put stream outstream  "|" at beg temp-sum.sum format frm-qnty  .
     6075             run macr_excel_sum (temp-sum.sum, v-row, v-col, sz-qnty) .
     6076             assign  beg = beg + 14 .
     6077           end.
     6078           when 1 or when 2 or when 3 then do:
     6079             put stream outstream  "|" at beg temp-sum.sum format frm-sum .
     6080             run macr_excel_sum (temp-sum.sum, v-row, v-col, 2) .
     6081             assign  beg = beg + 14 .
     6082           end.
     6083           when 4 then do:
     6084             put stream outstream  "|" at beg temp-sum.sum format frm-prc .
     6085             run macr_excel_sum (temp-sum.sum, v-row, v-col, 2) .
     6086             assign  beg = beg + 10 .
     6087           end.
     6088         end.
     6089         assign v-col = v-col + 1 .
     6090       end.
     6091       put stream outstream   "|"  skip .
     6092       assign v-row = v-row + 1 .
     6093     end.
     6094     do ii = 1 to 5:
     6095       run CalculSum in this-procedure (ii) .
     6096     end.
     6097     if gds-prop.empty-scale = no and SumsOnly = no then do:
     6098       run PrintScale .
     6099     end.
     6100     end.
     6101   end procedure.
     6102   procedure PrintScale :
     6103     do
     6104     on error undo, return error return-value
     6105     :
     6106       if line-counter( Outstream ) + 2 > page-size( Outstream ) then do:
     6107         put stream outstream  skip Line format frmt skip "продолжение - на следующей странице" AT 30 SKIP .
     6108         page stream OutStream .
     6109         run PrintTitul in this-procedure .
     6110       end.
     6111       if  ( v-row ) >= 63000 then do:
     6112         Output stream Macr_Excel  close .
     6113         run paramls-write in this-procedure (input "file",input string(v-ind),input v-file-name ) .
     6114         run gbl/_tmpfile.p ("wb", ".txt", output v-file-name) .
     6115         output stream  Macr_Excel to value(v-file-name) .
     6116         v-ind = v-ind + 1 .
     6117         run PutColumnTitulExcel in this-procedure .
     6118       end.
     6119       for each temp-prt
     6120         where temp-prt.gds-code = gds-prop.gds-code and temp-prt.prt-code > - 1
     6121         break by temp-prt.prt-code :
     6122         if first-of ( temp-prt.prt-code ) then do:
     6123           for each temp-sum where temp-sum.level = -2 : assign temp-sum.sum = 0 . end.
     6124           assign jj = 1 .
     6125           run Add-temp-sum ( gds-prop.gds-code, gds-prop.cli-type, gds-prop.cli-code, gds-prop.s-ind, 0, 'ie':U,     temp-prt.prt-code, jj ) . assign jj = jj + 1 .
     6126           run Add-temp-sum ( gds-prop.gds-code, gds-prop.cli-type, gds-prop.cli-code, gds-prop.s-ind, 1, 'ie':U,     temp-prt.prt-code, jj ) . assign jj = jj + 1 .
     6127           run Add-temp-sum ( gds-prop.gds-code, gds-prop.cli-type, gds-prop.cli-code, gds-prop.s-ind, 0, 'ep':U,  temp-prt.prt-code, jj ) . assign jj = jj + 1 .
     6128           run Add-temp-sum ( gds-prop.gds-code, gds-prop.cli-type, gds-prop.cli-code, gds-prop.s-ind, 1, 'ep':U,  temp-prt.prt-code, jj ) . assign jj = jj + 1 .
     6129           run Add-temp-sum ( gds-prop.gds-code, gds-prop.cli-type, gds-prop.cli-code, gds-prop.s-ind, 0, 'ee':U,     temp-prt.prt-code, jj ) . assign jj = jj + 1 .
     6130           run Add-temp-sum ( gds-prop.gds-code, gds-prop.cli-type, gds-prop.cli-code, gds-prop.s-ind, 1, 'ee':U,     temp-prt.prt-code, jj ) . assign jj = jj + 1 .
     6131           run Add-temp-sum ( gds-prop.gds-code, gds-prop.cli-type, gds-prop.cli-code, gds-prop.s-ind, 2, 'ee':U,     temp-prt.prt-code, jj ) . assign jj = jj + 1 .
     6132           run Add-temp-sum ( gds-prop.gds-code, gds-prop.cli-type, gds-prop.cli-code, gds-prop.s-ind, 3, 'ee':U,     temp-prt.prt-code, jj ) . assign jj = jj + 1 .
     6133           run Add-temp-sum ( gds-prop.gds-code, gds-prop.cli-type, gds-prop.cli-code, gds-prop.s-ind, 4, 'ee':U,     temp-prt.prt-code, jj ) . assign jj = jj + 1 .
     6134           run Add-temp-sum ( gds-prop.gds-code, gds-prop.cli-type, gds-prop.cli-code, gds-prop.s-ind, 0, 're':U, temp-prt.prt-code, jj ) . assign jj = jj + 1 .
     6135           run Add-temp-sum ( gds-prop.gds-code, gds-prop.cli-type, gds-prop.cli-code, gds-prop.s-ind, 1, 're':U, temp-prt.prt-code, jj ) . assign jj = jj + 1 .
     6136           run Add-temp-sum ( gds-prop.gds-code, gds-prop.cli-type, gds-prop.cli-code, gds-prop.s-ind, 2, 're':U, temp-prt.prt-code, jj ) . assign jj = jj + 1 .
     6137           run Add-temp-sum ( gds-prop.gds-code, gds-prop.cli-type, gds-prop.cli-code, gds-prop.s-ind, 3, 're':U, temp-prt.prt-code, jj ) . assign jj = jj + 1 .
     6138           run Add-temp-sum ( gds-prop.gds-code, gds-prop.cli-type, gds-prop.cli-code, gds-prop.s-ind, 4, 're':U, temp-prt.prt-code, jj ) . assign jj = jj + 1 .
     6139           run Add-temp-sum ( gds-prop.gds-code, gds-prop.cli-type, gds-prop.cli-code, gds-prop.s-ind, 0, "rs-vz",                temp-prt.prt-code, jj ) . assign jj = jj + 1 .
     6140           run Add-temp-sum ( gds-prop.gds-code, gds-prop.cli-type, gds-prop.cli-code, gds-prop.s-ind, 1, "rs-vz",                temp-prt.prt-code, jj ) . assign jj = jj + 1 .
     6141           run Add-temp-sum ( gds-prop.gds-code, gds-prop.cli-type, gds-prop.cli-code, gds-prop.s-ind, 2, "rs-vz",                temp-prt.prt-code, jj ) . assign jj = jj + 1 .
     6142           run Add-temp-sum ( gds-prop.gds-code, gds-prop.cli-type, gds-prop.cli-code, gds-prop.s-ind, 3, "rs-vz",                temp-prt.prt-code, jj ) . assign jj = jj + 1 .
     6143           run Add-temp-sum ( gds-prop.gds-code, gds-prop.cli-type, gds-prop.cli-code, gds-prop.s-ind, 4, "rs-vz",                temp-prt.prt-code, jj ) . assign jj = jj + 1 .
     6144           run Add-temp-sum ( gds-prop.gds-code, gds-prop.cli-type, gds-prop.cli-code, gds-prop.s-ind, 0, 'we':U,     temp-prt.prt-code, jj ) . assign jj = jj + 1 .
     6145           run Add-temp-sum ( gds-prop.gds-code, gds-prop.cli-type, gds-prop.cli-code, gds-prop.s-ind, 1, 'we':U,     temp-prt.prt-code, jj ) . assign jj = jj + 1 .
     6146           run Add-temp-sum ( gds-prop.gds-code, gds-prop.cli-type, gds-prop.cli-code, gds-prop.s-ind, 2, 'we':U,     temp-prt.prt-code, jj ) . assign jj = jj + 1 .
     6147           run Add-temp-sum ( gds-prop.gds-code, gds-prop.cli-type, gds-prop.cli-code, gds-prop.s-ind, 2, "eff-val",              temp-prt.prt-code, jj ) . assign jj = jj + 1 .
     6148           run Add-temp-sum ( gds-prop.gds-code, gds-prop.cli-type, gds-prop.cli-code, gds-prop.s-ind, 4, "eff-prc",              temp-prt.prt-code, jj ) . assign jj = jj + 1 .
     6149           define variable  null-oborot1 as logical  no-undo .
     6150           assign null-oborot1 = yes .
     6151           for each temp-sum  where temp-sum.level = -2 :
     6152             if temp-sum.sum <> 0 and temp-sum.sum <> ? then do:
     6153               assign null-oborot1 = no .
     6154               leave.
     6155             end.
     6156           end.
     6157           if null-oborot1 = yes then next .
     6158           assign
     6159             v-col = 2
     6160             beg   = 1
     6161           .
     6162           put stream outstream  "|" at beg .  assign beg = beg + 30 .
     6163           put stream outstream  "|" at beg temp-prt.b-code format ">>>>>>>>>>>>9" .
     6164           run macr_excel_char (string(temp-prt.b-code), v-row, v-col) .
     6165           assign v-col = v-col + 2    beg = beg + 29 .
     6166           FIND FIRST ub.gds-prt WHERE ub.gds-prt.node-code  = temp-prt.prt-code NO-LOCK no-error .
     6167           put stream outstream  "|" at beg '  /'+ ub.gds-prt.f-name format "X(29)" .
     6168           run macr_excel_char ('  /'+ ub.gds-prt.f-name, v-row, v-col) .
     6169           assign v-col = v-col + 1    beg = beg + 30 .
     6170           for each temp-sum where temp-sum.level = -2 :
     6171             if use-column[ temp-sum.num ] = no then next .
     6172             case temp-sum.sum-type :
     6173               when 0 then do:
     6174                 put stream outstream  "|" at beg temp-sum.sum format frm-qnty  .
     6175                 run macr_excel_sum (temp-sum.sum, v-row, v-col, sz-qnty) .
     6176                 assign  beg = beg + 14 .
     6177               end.
     6178               when  2 then do:
     6179                 put stream outstream  "|" at beg temp-sum.sum format frm-sum .
     6180                 run macr_excel_sum (temp-sum.sum, v-row, v-col, 2) .
     6181                 assign  beg = beg + 14 .
     6182               end.
     6183               when 1 or when 3 then do:
     6184                 put stream outstream  "|" at beg .
     6185                 assign  beg = beg + 14 .
     6186               end.
     6187               when 4 then do:
     6188                 put stream outstream  "|" at beg .
     6189                 assign  beg = beg + 10 .
     6190               end.
     6191             end.
     6192             assign v-col = v-col + 1 .
     6193           end.
     6194           put stream outstream   "|" at beg skip .
     6195           assign v-row = v-row + 1 .
     6196         end.
     6197       end.
     6198     end.
     6199   end procedure.
     6200   procedure for-each1 :
     6201     do
     6202     on error undo, return error return-value
     6203     :
     6204       for each gds-prop
     6205         break by gds-prop.prod-type
     6206               by gds-prop.prod-code
     6207               by gds-prop.cli-name
     6208               by gds-prop.grp-name
     6209               by if SortType = "sort-code":U   then  gds-prop.b-code Else  gds-prop.artic
     6210               by gds-prop.gds-code :
     6211         if first-of(gds-prop.prod-code) then do:
     6212           find first buf_clients no-lock where buf_clients.obj-type = gds-prop.prod-type and buf_clients.obj-code = gds-prop.prod-code .
     6213           put stream outstream  "|" string("Производитель " + buf_clients.obj-name) format "X(49)" "|" at print-o skip .
     6214           run macr_excel_char ("Производитель " + buf_clients.obj-name, v-row, 1) .              assign v-row = v-row + 1 .
     6215           for each temp-sum where temp-sum.level = 2 : assign temp-sum.sum = 0 . end.
     6216         End.
     6217         if first-of(gds-prop.cli-name) then do:
     6218           run GetName in this-procedure (output ItogStr1).
     6219           if SumsOnly = no then do:
     6220             put stream outstream  "|" ItogStr1 format "X(49)" "|" at print-o skip .
     6221             run macr_excel_char (ItogStr1, v-row, 1) .          assign v-row = v-row + 1 .
     6222           end.
     6223           for each temp-sum where temp-sum.level = 3 : assign temp-sum.sum = 0 . end.
     6224         End.
     6225         if first-of(gds-prop.grp-name) then do:
     6226           put stream outstream  "|" string("Группа " + gds-prop.grp-name) format "X(59)" "|" at print-o skip .
     6227           run macr_excel_char ("Группа " + gds-prop.grp-name, v-row, 1) .              assign v-row = v-row + 1 .
     6228           for each temp-sum where temp-sum.level = 4 : assign temp-sum.sum = 0 . end.
     6229         End.
     6230         if last-of(gds-prop.gds-code) then do:
     6231           run PrintLine in this-procedure .
     6232         End.
     6233         if last-of(gds-prop.cli-name) then do:
     6234           run PutItogSum in this-procedure ("Итого по " + ItogStr1, 3) .
     6235         End.
     6236         if last-of(gds-prop.prod-code) then do:
     6237           assign ItogStr = "Итого по производителю " .
     6238           run PutItogSum in this-procedure ( ItogStr, 2) .
     6239         End.
     6240       end.
     6241     end.
     6242   end procedure.
     6243   procedure for-each2 :
     6244     do
     6245     on error undo, return error return-value
     6246     :
     6247       for each gds-prop
     6248         break by gds-prop.prod-type
     6249               by gds-prop.prod-code
     6250               by gds-prop.s-ind
     6251               by gds-prop.cli-name
     6252               by gds-prop.grp-name
     6253               by if SortType = "sort-code":U   then  gds-prop.b-code Else  gds-prop.artic
     6254               by gds-prop.gds-code :
     6255         if first-of(gds-prop.prod-code) then do:
     6256           find first buf_clients no-lock where buf_clients.obj-type = gds-prop.prod-type and buf_clients.obj-code = gds-prop.prod-code .
     6257           put stream outstream  "|" string("Производитель " + buf_clients.obj-name) format "X(49)" "|" at print-o skip .
     6258           run macr_excel_char ("Производитель " + buf_clients.obj-name, v-row, 1) .              assign v-row = v-row + 1 .
     6259           for each temp-sum where temp-sum.level = 2 : assign temp-sum.sum = 0 . end.
     6260         End.
     6261         if first-of(gds-prop.s-ind) then do:
     6262           run GetName in this-procedure (output ItogStr1).
     6263           put stream outstream  "|" ItogStr1 format "X(49)" "|" at print-o skip .
     6264           run macr_excel_char (ItogStr1, v-row, 1) .          assign v-row = v-row + 1 .
     6265           for each temp-sum where temp-sum.level = 3 : assign temp-sum.sum = 0 . end.
     6266         End.
     6267         if first-of(gds-prop.cli-name) then do:
     6268           if SumsOnly = no then do:
     6269             put stream outstream  "|" gds-prop.cli-name format "X(29)" "|" at print-o skip .
     6270             run macr_excel_char (gds-prop.cli-name, v-row, 1) .              assign v-row = v-row + 1 .
     6271           End.
     6272           for each temp-sum where temp-sum.level = 5 : assign temp-sum.sum = 0 . end.
     6273         End.
     6274         if first-of(gds-prop.grp-name) then do:
     6275           put stream outstream  "|" string("Группа " + gds-prop.grp-name) format "X(59)" "|" at print-o skip .
     6276           run macr_excel_char ("Группа " + gds-prop.grp-name, v-row, 1) .              assign v-row = v-row + 1 .
     6277           for each temp-sum where temp-sum.level = 4 : assign temp-sum.sum = 0 . end.
     6278         End.
     6279         if first-of(gds-prop.gds-code) then do:
     6280           run PrintLine in this-procedure .
     6281         End.
     6282         if last-of(gds-prop.cli-name) then do:
     6283           assign ItogStr = "Итого по " + gds-prop.cli-name .
     6284           run PutItogSum in this-procedure ( ItogStr, 5) .
     6285         End.
     6286         if last-of(gds-prop.s-ind) then do:
     6287           run PutItogSum in this-procedure ("Итого по " + ItogStr1, 3) .
     6288         End.
     6289         if last-of(gds-prop.prod-code) then do:
     6290           assign ItogStr = "Итого по производителю " .
     6291           run PutItogSum in this-procedure ( ItogStr, 2) .
     6292         End.
     6293       end.
     6294     End.
     6295   end procedure.
