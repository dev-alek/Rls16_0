     5898         PUT stream OutStream string(obj-list.obj-name + " (" + obj-list.obj-type + '#' + string(obj-list.obj-code)  + "), ") at 21 format "X(50)" skip.
     5899       end.
     5900     end.
     5901     put stream outstream  skip
     5902       string( "Дата печати :" ) AT 5 format "x(15)" TODAY format "99.99.9999"
