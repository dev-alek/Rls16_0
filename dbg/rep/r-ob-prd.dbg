     6043     run Add-temp-sum (  gds-prop.gds-code, gds-prop.cli-type, gds-prop.cli-code, gds-prop.s-ind, 4, "eff-prc", -1, jj ) .              assign jj = jj + 1 .
     6044     define variable null-oborot as logical no-undo .
     6045     assign null-oborot = yes .
     6046     for each temp-sum  where temp-sum.level = -1 :
