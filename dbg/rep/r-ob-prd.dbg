     2693                                   + buf_price-list.doc-qnty
     2694               p-cur-base          = p-cur-base
     2695                                   + price-base-with-tax-sale-prl * buf_price-list.doc-qnty
     2696               p-cur-VAT-base      = p-cur-VAT-base
     2697                                   + vat-base-sale-prl * buf_price-list.doc-qnty
     2698               p-cur-SLT-base      = p-cur-SLT-base
     2699                                   + slt-base-sale-prl * buf_price-list.doc-qnty
     2700               p-cur-road-tax-base = p-cur-road-tax-base
     2701                                   + road-tax-base-sale-prl * buf_price-list.doc-qnty
     2702               p-cur-excise-base   = p-cur-excise-base
     2703                                   + excise-base-sale-prl * buf_price-list.doc-qnty
     2704             .
     2705           end.
     2706           else do:
     2707             assign
     2708               p-fact-qnty         = p-fact-qnty
     2709                                   + buf_price-list.doc-qnty
     2710               p-cur-base          = p-cur-base
     2711                                   + price-rubl-with-tax-sale-prl * buf_price-list.doc-qnty
     2712               p-cur-VAT-base      = p-cur-VAT-base
     2713                                   + vat-rubl-sale-prl * buf_price-list.doc-qnty
     2714               p-cur-SLT-base      = p-cur-SLT-base
     2715                                   + slt-rubl-sale-prl * buf_price-list.doc-qnty
     2716               p-cur-road-tax-base = p-cur-road-tax-base
     2717                                   + road-tax-rubl-sale-prl * buf_price-list.doc-qnty
     2718               p-cur-excise-base   = p-cur-excise-base
     2719                                   + excise-rubl-sale-prl * buf_price-list.doc-qnty
     2720             .
     2721           end.
     2722         end.
     2723     end.
     2724   end procedure.
     2725   procedure prdoclib-calc-prc :
     2726     define input  parameter p-price-doc-recid as   recid                  no-undo.
     2727     define input  parameter p-cons-pay        as   integer                no-undo.
     2728     define output parameter p-ov-cons         like ub.doc-line.price-base no-undo.
     2729     define output parameter p-ov-VAT-cons     like ub.doc-line.price-base no-undo.
     2730     define output parameter p-ov-SLT-cons     like ub.doc-line.price-base no-undo.
     2731     define output parameter p-ov-prch         like ub.doc-line.price-base no-undo.
     2732     define output parameter p-ov-VAT-prch     like ub.doc-line.price-base no-undo.
     2733     define output parameter p-ov-SLT-prch     like ub.doc-line.price-base no-undo.
     2734     do
     2735     on error undo, return error return-value
     2736     :
     2737       define buffer buf_price-doc       for ub.price-doc .
     2738       define buffer buf_price-list      for ub.price-list .
     2739       define buffer buf_parts           for ub.parts .
     2740       define variable v-ov-qnty     as decimal   no-undo .
     2741       define variable v-ov-base     as decimal   no-undo .
     2742       define variable v-ov-VAT-base as decimal   no-undo .
     2743       define variable v-ov-SLT-base as decimal   no-undo .
     2744       define variable v-cons-qnty   as decimal   no-undo .
     2745       define variable v-prch-qnty   as decimal   no-undo .
     2746       define variable v-cons-mult   as decimal   no-undo .
     2747       define variable v-prch-mult   as decimal   no-undo .
     2748       find first buf_price-doc no-lock
     2749         where recid(buf_price-doc) = p-price-doc-recid
     2750         no-error .
     2751       if not available buf_price-doc
     2752       then do:
     2753         message
     2754           vss-workfile vss-revision vss-description skip
     2755           vss-include-info20 skip
     2756           "Ошибка задания входных параметров" skip
     2757           "Не найден документ переоценки" skip
     2758           "Код записи (recid)" p-price-doc-recid skip
     2759           view-as alert-box error .
     2760         undo, return error .
     2761       end.
     2762       for each buf_price-list no-lock
     2763         where buf_price-list.doc-num    = buf_price-doc.doc-num
     2764           and buf_price-list.main-price = true
     2765       on error undo, return error return-value
     2766       :
     2767         run prdoclib-calc-ov
     2768           (input recid(buf_price-list)
     2769           ,output v-ov-qnty
     2770           ,output v-ov-base
     2771           ,output v-ov-VAT-base
     2772           ,output v-ov-SLT-base
     2773           ) no-error .
     2774         if error-status :error
     2775         then do:
     2776           if error-status :get-message(1) <> ""
     2777           then do:
     2778             message
     2779               vss-workfile vss-revision vss-description skip
     2780               vss-include-info20 skip
     2781               "Ошибка при вызове процедуры prdoclib-calc-ov" skip
     2782               error-status :get-message(1) skip
     2783               return-value skip
     2784               view-as alert-box error .
     2785           end.
     2786           undo, return error return-value .
     2787         end.
     2788         assign
     2789           v-cons-qnty = 0
     2790           v-prch-qnty = 0
     2791         .
     2792         for each buf_parts no-lock
     2793           where buf_parts.out-code  = buf_price-list.doc-num
     2794             and buf_parts.obj-type  = buf_price-list.obj-type
     2795             and buf_parts.obj-code  = buf_price-list.obj-code
     2796             and buf_parts.artic     = buf_price-list.artic
     2797             and buf_parts.prod-type = buf_price-list.prod-type
     2798             and buf_parts.prod-code = buf_price-list.prod-code
     2799         on error undo, return error return-value
     2800         :
     2801           if buf_parts.pay-code = p-cons-pay
     2802           then do:
     2803             assign
     2804               v-cons-qnty = v-cons-qnty + buf_parts.fact-qnty
     2805             .
     2806           end.
     2807           else do:
     2808             assign
     2809               v-prch-qnty = v-prch-qnty + buf_parts.fact-qnty
     2810             .
     2811           end.
     2812         end.
     2813         if (v-cons-qnty + v-prch-qnty) = 0
     2814         then do:
     2815           assign
     2816             v-cons-mult = 0
     2817             v-prch-mult = 1
     2818           .
     2819         end.
     2820         else do:
     2821           assign
     2822             v-cons-mult = v-cons-qnty / (v-cons-qnty + v-prch-qnty)
     2823             v-prch-mult = v-prch-qnty / (v-cons-qnty + v-prch-qnty)
     2824           .
     2825         end.
     2826         assign
     2827           p-ov-cons     = p-ov-cons     + v-ov-base     * v-cons-mult
     2828           p-ov-VAT-cons = p-ov-VAT-cons + v-ov-VAT-base * v-cons-mult
     2829           p-ov-SLT-cons = p-ov-SLT-cons + v-ov-SLT-base * v-cons-mult
     2830           p-ov-prch     = p-ov-prch     + v-ov-base     * v-prch-mult
     2831           p-ov-VAT-prch = p-ov-VAT-prch + v-ov-VAT-base * v-prch-mult
     2832           p-ov-SLT-prch = p-ov-SLT-prch + v-ov-SLT-base * v-prch-mult
     2833         .
     2834       end.
     2835     end.
     2836   end procedure.
     2837   procedure prdoclib-calc-ov :
     2838     define input  parameter p-price-list-recid as recid     no-undo .
     2839     define output parameter p-fact-qnty        as decimal   no-undo .
     2840     define output parameter p-ov-base          as decimal   no-undo .
     2841     define output parameter p-ov-VAT-base      as decimal   no-undo .
     2842     define output parameter p-ov-SLT-base      as decimal   no-undo .
     2843     do
     2844     on error undo, return error return-value
     2845     :
     2846       define buffer buf_main_price-list    for ub.price-list .
     2847       define buffer buf_prev_price-list    for ub.price-list .
     2848       define buffer buf_special_price-list for ub.price-list .
     2849       define buffer buf_goods              for ub.goods .
     2850       define variable v-fact-qnty             like ub.doc-line.price-base no-undo.
     2851       define variable v-cur-base              like ub.doc-line.price-base no-undo.
     2852       define variable v-cur-VAT-base          like ub.doc-line.price-base no-undo.
     2853       define variable v-cur-SLT-base          like ub.doc-line.price-base no-undo.
     2854       define variable v-cur-road-tax-base     like ub.doc-line.price-base no-undo.
     2855       define variable v-cur-excise-base       like ub.doc-line.price-base no-undo.
     2856       define variable v-prev-price-list-recid as   recid                  no-undo.
     2857       define variable v-prev-cli-base-rate    like ub.goods.cli-base-rate no-undo.
     2858       define variable v-prev-fact-qnty        like ub.doc-line.price-base no-undo.
     2859       define variable v-prev-cur-base         like ub.doc-line.price-base no-undo.
     2860       define variable v-prev-cur-VAT-base     like ub.doc-line.price-base no-undo.
     2861       define variable v-prev-cur-SLT-base     like ub.doc-line.price-base no-undo.
     2862       find first buf_main_price-list no-lock
     2863         where recid(buf_main_price-list) = p-price-list-recid
     2864         no-error .
     2865       if not available buf_main_price-list
     2866       then do:
     2867         message
     2868           vss-workfile vss-revision vss-description skip
     2869           vss-include-info20 skip
     2870           "Ошибка задания входных параметров" skip
     2871           "Не найдена строка переоценки" skip
     2872           "Код записи (recid)" p-price-list-recid skip
     2873           view-as alert-box error .
     2874         undo, return error .
     2875       end.
     2876       if buf_main_price-list.main-price <> true
     2877       then do:
     2878         message
     2879           vss-workfile vss-revision vss-description skip
     2880           vss-include-info20 skip
     2881           "Ошибка задания входных параметров" skip
     2882           "Строка переоценки не является основной" skip
     2883           "Код записи (recid)" p-price-list-recid skip
     2884           "Переоценка" buf_main_price-list.doc-num skip
     2885           "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     2886           "Бар-код" buf_main_price-list.b-code skip
     2887           view-as alert-box error .
     2888         undo, return error .
     2889       end.
     2890       run prdoclib-calc-fact-sale in this-procedure
     2891         (input  recid(buf_main_price-list)
     2892         ,output v-fact-qnty
     2893         ,output v-cur-base
     2894         ,output v-cur-VAT-base
     2895         ,output v-cur-SLT-base
     2896         ,output v-cur-road-tax-base
     2897         ,output v-cur-excise-base
     2898         ) no-error.
     2899       if error-status :error
     2900       then do:
     2901         message
     2902           vss-workfile vss-revision vss-description skip
     2903           vss-include-info20 skip
     2904           "Ошибка при расчете сумм переоценки." skip
     2905           "Документ переоценки" buf_main_price-list.doc-num skip
     2906           "Товар" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     2907           error-status :get-message(1) skip
     2908           return-value skip
     2909           view-as alert-box error .
     2910         undo, return error .
     2911       end.
     2912   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2913   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodepls in g#library
     2914     (input  buf_main_price-list.obj-type
     2915     ,input  buf_main_price-list.obj-code
     2916     ,input  buf_main_price-list.b-code
     2917     ,input  buf_main_price-list.b-code
     2918     ,input  buf_main_price-list.fact-order
     2919     ,output v-prev-price-list-recid
     2920     ,output v-prev-cli-base-rate
     2921     ) no-error .
     2922       if error-status :error
     2923       then do:
     2924         message
     2925           vss-workfile vss-revision vss-description skip
     2926           vss-include-info20 skip
     2927           "Ошибка при поиске предыдущей переоценки." skip
     2928           "Документ переоценки " buf_main_price-list.doc-num skip
     2929           "Товар " buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     2930           error-status :get-message(1) skip
     2931           return-value skip
     2932           view-as alert-box error .
     2933         undo, return error .
     2934       end.
     2935       if v-prev-price-list-recid <> ?
     2936       then do:
     2937         find first buf_prev_price-list no-lock
     2938           where recid(buf_prev_price-list) = v-prev-price-list-recid
     2939           .
     2940         find first buf_special_price-list no-lock
     2941           where buf_special_price-list.doc-num    = buf_prev_price-list.doc-num
     2942             and buf_special_price-list.main-price = false
     2943             and buf_special_price-list.artic      = buf_prev_price-list.artic
     2944             and buf_special_price-list.prod-type  = buf_prev_price-list.prod-type
     2945             and buf_special_price-list.prod-code  = buf_prev_price-list.prod-code
     2946             and buf_special_price-list.doc-qnty   <> ?
     2947           no-error .
     2948         if available buf_special_price-list
     2949         then do:
     2950           message
     2951             "Товар имеет специальные цены на признаки" skip
     2952             "Разбиение суммы переоценки по консигнации, выкупу невозможно" skip
     2953             "Переоценка" buf_prev_price-list.doc-num skip
     2954             "Товар" buf_prev_price-list.artic buf_prev_price-list.prod-type buf_prev_price-list.prod-code skip
     2955             view-as alert-box error .
     2956           undo, return error .
     2957         end.
     2958         find first buf_goods no-lock
     2959           where buf_goods.artic     = buf_main_price-list.artic
     2960             and buf_goods.prod-type = buf_main_price-list.prod-type
     2961             and buf_goods.prod-code = buf_main_price-list.prod-code
     2962           no-error .
     2963         if not available buf_goods
     2964         then do:
     2965           message
     2966             vss-workfile vss-revision vss-description skip
     2967             vss-include-info20 skip
     2968             "Не найден товар" skip
     2969             "Переоценка" buf_main_price-list.doc-num skip
     2970             "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     2971             view-as alert-box error .
     2972           undo, return error .
     2973         end.
     2974         if buf_prev_price-list.vat-pc = ?
     2975         or buf_prev_price-list.slt-pc = ?
     2976         then do:
     2977           message
     2978             "В переоценке не заданы налоги товара" skip
     2979             "Разбиение суммы переоценки по консигнации, выкупу невозможно" skip
     2980             "Переоценка" buf_prev_price-list.doc-num skip
     2981             "Товар" buf_prev_price-list.artic buf_prev_price-list.prod-type buf_prev_price-list.prod-code skip
     2982             "НДС" buf_prev_price-list.vat-pc skip
     2983             "НП" buf_prev_price-list.slt-pc skip
     2984             view-as alert-box error .
     2985           undo, return error return-value .
     2986         end.
     2987         define variable v-prev-cur-SLT-pc as decimal no-undo .
     2988         assign
     2989           v-prev-cur-SLT-pc   = buf_prev_price-list.price-sale * buf_prev_price-list.slt-pc / (100 + buf_prev_price-list.slt-pc)
     2990         .
     2991         assign
     2992           v-prev-cur-base     = v-fact-qnty * buf_prev_price-list.price-sale
     2993           v-prev-cur-VAT-base = v-fact-qnty
     2994                               * (buf_prev_price-list.price-sale - v-prev-cur-SLT-pc)
     2995                               * buf_prev_price-list.vat-pc / (100 + buf_prev_price-list.vat-pc)
     2996           v-prev-cur-SLT-base = v-fact-qnty * v-prev-cur-SLT-pc
     2997         .
     2998         assign
     2999           p-fact-qnty   = v-fact-qnty
     3000           p-ov-base     = v-cur-base     - v-prev-cur-base
     3001           p-ov-VAT-base = v-cur-VAT-base - v-prev-cur-VAT-base
     3002           p-ov-SLT-base = v-cur-SLT-base - v-prev-cur-SLT-base
     3003         .
     3004       end.
     3005       else do:
     3006         assign
     3007           v-prev-cur-base     = 0
     3008           v-prev-cur-VAT-base = 0
     3009           v-prev-cur-SLT-base = 0
     3010           .
     3011         assign
     3012           p-fact-qnty   = v-fact-qnty
     3013           p-ov-base     = v-cur-base     - v-prev-cur-base
     3014           p-ov-VAT-base = v-cur-VAT-base - v-prev-cur-VAT-base
     3015           p-ov-SLT-base = v-cur-SLT-base - v-prev-cur-SLT-base
     3016         .
     3017       end.
     3018     end.
     3019   end procedure.
     3020   procedure prdoclib-init-prt-obj-by-factord :
     3021     define input parameter p-obj-type           like ub.gds-obj.obj-type  no-undo .
     3022     define input parameter p-obj-code           like ub.gds-obj.obj-code  no-undo .
     3023     define input parameter p-artic              like ub.gds-obj.artic     no-undo .
     3024     define input parameter p-prod-type          like ub.gds-obj.prod-type no-undo .
     3025     define input parameter p-prod-code          like ub.gds-obj.prod-code no-undo .
     3026     define input parameter p-fact-order         as decimal   no-undo .
     3027     define input parameter p-include-fact-order as logical   no-undo .
     3028     define variable vss-description as character no-undo init "prdoclib-init-prt-obj-by-factord: определение остатков по признакам на любой момент времени".
     3029     define buffer buf_gds-obj      for ub.gds-obj .
     3030     define buffer buf_doc-line     for ub.doc-line .
     3031     define buffer buf_temp-prt-obj for temp-prt-obj .
     3032     define variable v-total-gds-dtl-qnty as decimal   no-undo .
     3033     do
     3034     on error undo, return error return-value
     3035     :
     3036       do transaction
     3037       on error undo, return error return-value
     3038       :
     3039   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3040   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     3041     (input  p-obj-type
     3042     ,input  p-obj-code
     3043     ,input  p-artic
     3044     ,input  p-prod-type
     3045     ,input  p-prod-code
     3046     ,buffer buf_gds-obj
     3047     ) no-error .
     3048         if error-status :error
     3049         then do:
     3050           message
     3051             vss-workfile vss-revision vss-description skip
     3052             vss-include-info20 skip
     3053             "Невозможно найти gds-obj" skip
     3054             error-status :get-message(1) skip
     3055             return-value skip
     3056             view-as alert-box error .
     3057           undo, return error .
     3058         end.
     3059         find current buf_gds-obj exclusive-lock .
     3060       end.
     3061       run prdoclib-init-temp-prt-obj in this-procedure
     3062         (input p-obj-type
     3063         ,input p-obj-code
     3064         ,input p-artic
     3065         ,input p-prod-type
     3066         ,input p-prod-code
     3067         ,input 0
     3068         ) .
     3069       for each buf_temp-prt-obj
     3070         where buf_temp-prt-obj.is-term <> true
     3071       on error undo, return error return-value
     3072       :
     3073         delete buf_temp-prt-obj .
     3074       end.
     3075       if p-include-fact-order = true
     3076       then do:
     3077         assign
     3078          p-fact-order = p-fact-order - 0.0000000001
     3079         .
     3080       end.
     3081       for each buf_doc-line no-lock
     3082         where buf_doc-line.obj-type   = p-obj-type
     3083           and buf_doc-line.obj-code   = p-obj-code
     3084           and buf_doc-line.artic      = p-artic
     3085           and buf_doc-line.prod-type  = p-prod-type
     3086           and buf_doc-line.prod-code  = p-prod-code
     3087           and buf_doc-line.status_    = 'факт':U
     3088           and buf_doc-line.fact-order >= p-fact-order
     3089       on error undo, return error return-value
     3090       :
     3091         run prdoclib-process-document in this-procedure
     3092           (input  buf_doc-line.doc-code
     3093           ,input  p-obj-type
     3094           ,input  p-obj-code
     3095           ,input  p-artic
     3096           ,input  p-prod-type
     3097           ,input  p-prod-code
     3098           ,output v-total-gds-dtl-qnty
     3099           ) .
     3100       end.
     3101     end.
     3102   end procedure.
     3103   procedure prdoclib-process-document :
     3104     define input  parameter p-doc-code           as character no-undo .
     3105     define input  parameter p-obj-type           as character no-undo .
     3106     define input  parameter p-obj-code           as integer   no-undo .
     3107     define input  parameter p-artic              as character no-undo .
     3108     define input  parameter p-prod-type          as character no-undo .
     3109     define input  parameter p-prod-code          as integer   no-undo .
     3110     define output parameter p-total-gds-dtl-qnty as decimal   no-undo .
     3111     define buffer buf_trn-doc      for ub.trn-doc .
     3112     define buffer buf_gds-dtl      for ub.gds-dtl .
     3113     define buffer buf_temp-prt-obj for temp-prt-obj .
     3114     do
     3115     on error undo, return error return-value
     3116     :
     3117       find first buf_trn-doc no-lock
     3118         where buf_trn-doc.doc-code = p-doc-code
     3119         no-error .
     3120       if not available buf_trn-doc then do:
     3121         message
     3122           vss-workfile vss-revision vss-description skip
     3123           vss-include-info20 skip
     3124           "Ошибка при поиске документа" skip
     3125           "Документ" p-doc-code skip
     3126           "Объект" p-obj-type p-obj-code skip
     3127           "Артикул" p-artic p-prod-type p-prod-code skip
     3128           view-as alert-box error .
     3129         undo, return error .
     3130       end.
     3131       assign
     3132         p-total-gds-dtl-qnty = 0
     3133       .
     3134       for each buf_gds-dtl no-lock
     3135         where buf_gds-dtl.doc-code  = p-doc-code
     3136           and buf_gds-dtl.artic     = p-artic
     3137           and buf_gds-dtl.prod-type = p-prod-type
     3138           and buf_gds-dtl.prod-code = p-prod-code
     3139       on error undo, return error
     3140       :
     3141         define variable v-term-node as integer   no-undo .
     3142   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run termnode in g#library
     3143     (input  buf_gds-dtl.prt-code
     3144     ,output v-term-node
     3145     )  .
     3146         run prdoclib-temp-prt-obj-by-prt-root in this-procedure
     3147           (input  v-term-node
     3148           ,buffer buf_temp-prt-obj
     3149           ) .
     3150         if buf_temp-prt-obj.is-term <> true then do:
     3151           undo, return error substitute("Документ ссылается на нетерминальный признак. Код признака &1"
     3152                                        ,buf_gds-dtl.prt-code
     3153                                        ) .
     3154         end.
     3155         case buf_trn-doc.doc-type :
     3156           when 'при':U or
     3157           when 'возврат':U
     3158           then do:
     3159             assign
     3160               p-total-gds-dtl-qnty        = p-total-gds-dtl-qnty
     3161                                           - buf_gds-dtl.fact-qnty
     3162               buf_temp-prt-obj.fact-qnty  = buf_temp-prt-obj.fact-qnty
     3163                                           - buf_gds-dtl.fact-qnty
     3164             .
     3165           end.
     3166           when 'рас':U or
     3167           when 'спи':U
     3168           then do:
     3169             assign
     3170               p-total-gds-dtl-qnty        = p-total-gds-dtl-qnty
     3171                                           + buf_gds-dtl.fact-qnty
     3172               buf_temp-prt-obj.fact-qnty  = buf_temp-prt-obj.fact-qnty
     3173                                           + buf_gds-dtl.fact-qnty
     3174             .
     3175           end.
     3176           when 'инв':U
     3177           then do:
     3178             assign
     3179               p-total-gds-dtl-qnty        = p-total-gds-dtl-qnty
     3180                                           - buf_gds-dtl.doc-qnty
     3181               buf_temp-prt-obj.fact-qnty  = buf_temp-prt-obj.fact-qnty
     3182                                           - buf_gds-dtl.doc-qnty
     3183             .
     3184           end.
     3185           otherwise do:
     3186             undo, return error substitute("Неизвестный тип документа &1"
     3187                                          ,buf_trn-doc.doc-type
     3188                                          ) .
     3189           end.
     3190         end.
     3191       end.
     3192     end.
     3193   end procedure.
     3194   procedure prdoclib-prc-pl-document :
     3195     define input  parameter p-doc-code              as character no-undo .
     3196     define input  parameter p-obj-type              as character no-undo .
     3197     define input  parameter p-obj-code              as integer   no-undo .
     3198     define input  parameter p-gds-code              as integer   no-undo .
     3199     define output parameter p-total-pl-gds-qnty     as decimal   no-undo .
     3200     define output parameter p-total-pl-gds-cli-qnty as decimal   no-undo .
     3201     do
     3202     on error undo, return error return-value
     3203     :
     3204       define buffer buf_trn-doc      for ub.trn-doc .
     3205       define buffer buf_doc-pl       for ub.doc-pl .
     3206       define buffer buf_temp-pl-gds for temp-pl-gds .
     3207       define variable v-sign as decimal   no-undo .
     3208       find first buf_trn-doc no-lock
     3209         where buf_trn-doc.doc-code = p-doc-code
     3210         no-error .
     3211       if not available buf_trn-doc then do:
     3212         message
     3213           vss-workfile vss-revision vss-description skip
     3214           vss-include-info20 skip
     3215           "Ошибка при поиске документа" skip
     3216           "Документ" p-doc-code skip
     3217           "Объект" p-obj-type p-obj-code skip
     3218           "Товар" p-gds-code skip
     3219           view-as alert-box error .
     3220         undo, return error .
     3221       end.
     3222       assign
     3223         p-total-pl-gds-qnty     = 0
     3224         p-total-pl-gds-cli-qnty = 0
     3225       .
     3226       for each buf_doc-pl no-lock
     3227         where buf_doc-pl.out-code  = p-doc-code
     3228           and buf_doc-pl.gds-code  = p-gds-code
     3229       on error undo, return error return-value
     3230       :
     3231         find first buf_temp-pl-gds
     3232           where buf_temp-pl-gds.obj-type = buf_trn-doc.obj-type
     3233             and buf_temp-pl-gds.obj-code = buf_trn-doc.obj-code
     3234             and buf_temp-pl-gds.pl-code  = buf_doc-pl.pl-code
     3235           .
     3236         case buf_trn-doc.doc-type :
     3237           when 'при':U
     3238           or when 'возврат':U
     3239           or when 'инв':U
     3240           then do:
     3241             assign
     3242               v-sign = -1.0
     3243             .
     3244           end.
     3245           when 'рас':U or
     3246           when 'спи':U
     3247           then do:
     3248             assign
     3249               v-sign = 1.0
     3250             .
     3251           end.
     3252           otherwise do:
     3253             undo, return error substitute("(prdoclib-prc-pl-document) Неизвестный тип документа &1", buf_trn-doc.doc-type ) .
     3254           end.
     3255         end case.
     3256         assign
     3257           p-total-pl-gds-qnty           = p-total-pl-gds-qnty           + buf_doc-pl.fact-qnty     * v-sign
     3258           p-total-pl-gds-cli-qnty       = p-total-pl-gds-cli-qnty       + buf_doc-pl.cli-fact-qnty * v-sign
     3259           buf_temp-pl-gds.fact-qnty     = buf_temp-pl-gds.fact-qnty     + buf_doc-pl.fact-qnty     * v-sign
     3260           buf_temp-pl-gds.cli-fact-qnty = buf_temp-pl-gds.cli-fact-qnty + buf_doc-pl.cli-fact-qnty * v-sign
     3261         .
     3262       end.
     3263     end.
     3264   end procedure.
     3265   procedure prdoclib-init-prt-obj-by-date :
     3266     define input parameter p-obj-type   like ub.gds-obj.obj-type  no-undo .
     3267     define input parameter p-obj-code   like ub.gds-obj.obj-code  no-undo .
     3268     define input parameter p-artic      like ub.gds-obj.artic     no-undo .
     3269     define input parameter p-prod-type  like ub.gds-obj.prod-type no-undo .
     3270     define input parameter p-prod-code  like ub.gds-obj.prod-code no-undo .
     3271     define input parameter p-fact-date  as date      no-undo .
     3272     define variable vss-description as character no-undo init "prdoclib-init-prt-obj-by-date: определение остатков по признакам на конец дня".
     3273     do
     3274     on error undo, return error return-value
     3275     :
     3276       define variable v-fact-order                as decimal   no-undo .
     3277       define variable v-shift-end-fact-order      as decimal   no-undo .
     3278       define variable v-day-end-fact-order        as decimal   no-undo .
     3279       run factord in this-procedure
     3280         (input  p-fact-date
     3281         ,input  1
     3282         ,input  1
     3283         ,input  ?
     3284         ,input  0
     3285         ,input  false
     3286         ,output v-fact-order
     3287         ,output v-shift-end-fact-order
     3288         ,output v-day-end-fact-order
     3289         ) no-error .
     3290       if error-status :error
     3291       then do:
     3292         message
     3293           vss-workfile vss-revision vss-description skip
     3294           vss-include-info20 skip
     3295           "Ошибка при определении момента времени, на который требуется остаток" skip
     3296           "Объект" p-obj-type p-obj-code skip
     3297           "Артикул" p-artic p-prod-type p-prod-code skip
     3298           "Дата" p-fact-date skip
     3299           view-as alert-box error .
     3300         undo, return error .
     3301       end.
     3302       run prdoclib-init-prt-obj-by-date-factord in this-procedure
     3303         (input p-obj-type
     3304         ,input p-obj-code
     3305         ,input p-artic
     3306         ,input p-prod-type
     3307         ,input p-prod-code
     3308         ,input v-day-end-fact-order
     3309         ,input false
     3310         ) no-error .
     3311       if error-status :error
     3312       then do:
     3313         message
     3314           vss-workfile vss-revision vss-description skip
     3315           vss-include-info20 skip
     3316           "Ошибка при вызове метода prdoclib-init-prt-obj-by-date-factord" skip
     3317           "Объект" p-obj-type p-obj-code skip
     3318           "Артикул" p-artic p-prod-type p-prod-code skip
     3319           "Дата" p-fact-date skip
     3320           view-as alert-box error .
     3321         undo, return error .
     3322       end.
     3323     end.
     3324   end procedure.
     3325   procedure prdoclib-calc-temp-fact-sale :
     3326     define input  parameter p-obj-type           as character no-undo .
     3327     define input  parameter p-obj-code           as integer   no-undo .
     3328     define input  parameter p-gds-code           as integer   no-undo .
     3329     define input  parameter p-day-end-fact-order as decimal   no-undo .
     3330     define input  parameter p-curr-r-b           as character no-undo .
     3331     define output parameter p-fact-qnty          as decimal   no-undo .
     3332     define output parameter p-cur-base           as decimal   no-undo .
     3333     define output parameter p-cur-VAT-base       as decimal   no-undo .
     3334     define output parameter p-cur-SLT-base       as decimal   no-undo .
     3335     define output parameter p-cur-road-tax-base  as decimal   no-undo .
     3336     define output parameter p-cur-excise-base    as decimal   no-undo .
     3337     define buffer buf_temp-prt-obj for temp-prt-obj .
     3338     define variable v-prt-b-code        like ub.bar-code.b-code no-undo .
     3339     define variable v-cli-base-rate     like ub.bar-code.cli-base-rate no-undo .
     3340     define variable parrecid-prl        as recid     no-undo .
     3341     define variable v-fact-qnty         as decimal   no-undo .
     3342     define variable v-cur-base          as decimal   no-undo .
     3343     define variable v-cur-VAT-base      as decimal   no-undo .
     3344     define variable v-cur-SLT-base      as decimal   no-undo .
     3345     define variable v-cur-road-tax-base as decimal   no-undo .
     3346     define variable v-cur-excise-base   as decimal   no-undo .
     3347     define variable price-rubl-with-tax-sale-prl    as decimal   no-undo .
     3348     define variable price-base-with-tax-sale-prl    as decimal   no-undo .
     3349     define variable price-rubl-without-tax-sale-prl as decimal   no-undo .
     3350     define variable price-base-without-tax-sale-prl as decimal   no-undo .
     3351     define variable vat-base-sale-prl               as decimal   no-undo .
     3352     define variable vat-rubl-sale-prl               as decimal   no-undo .
     3353     define variable vat-base-buyer-prl              as decimal   no-undo .
     3354     define variable vat-rubl-buyer-prl              as decimal   no-undo .
     3355     define variable slt-base-sale-prl               as decimal   no-undo .
     3356     define variable slt-rubl-sale-prl               as decimal   no-undo .
     3357     define variable road-tax-base-sale-prl          as decimal   no-undo .
     3358     define variable road-tax-rubl-sale-prl          as decimal   no-undo .
     3359     define variable excise-base-sale-prl            as decimal   no-undo .
     3360     define variable excise-rubl-sale-prl            as decimal   no-undo .
     3361     define variable discnt-base-sale-prl            as decimal   no-undo .
     3362     define variable discnt-rubl-sale-prl            as decimal   no-undo .
     3363     do
     3364     on error undo, return error return-value
     3365     :
     3366       for each buf_temp-prt-obj no-lock
     3367       on error undo, return error return-value
     3368       :
     3369   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     3370     (input  p-gds-code
     3371     ,input  buf_temp-prt-obj.prt-code
     3372     ,output v-prt-b-code
     3373     ) no-error .
     3374         if error-status :error
     3375         then do:
     3376           message
     3377             vss-workfile vss-revision vss-description skip
     3378             "Ошибка при определении бар-кода признака" skip
     3379             "Код товара"   p-gds-code skip
     3380             "Код признака" buf_temp-prt-obj.prt-code skip
     3381             error-status :get-message(1) skip
     3382             return-value skip
     3383             view-as alert-box error .
     3384           undo, return error .
     3385         end.
     3386   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3387   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodepls in g#library
     3388     (input  p-obj-type
     3389     ,input  p-obj-code
     3390     ,input  v-prt-b-code
     3391     ,input  0
     3392     ,input  p-day-end-fact-order
     3393     ,output parrecid-prl
     3394     ,output v-cli-base-rate
     3395     ) no-error .
     3396         if error-status :error
     3397         then do:
     3398           message
     3399             vss-workfile vss-revision vss-description skip
     3400             "Ошибка при определении цены бар-кода" skip
     3401             "Объект" p-obj-type p-obj-code skip
     3402             "Бар-код" v-prt-b-code skip
     3403             "fact-order" p-day-end-fact-order skip
     3404             error-status :get-message(1) skip
     3405             return-value skip
     3406             view-as alert-box error .
     3407           undo, return error .
     3408         end.
     3409         if parrecid-prl <> ?
     3410         then do:
     3411           run prl-vat in this-procedure
     3412             (input  parrecid-prl
     3413             ,output price-rubl-with-tax-sale-prl
     3414             ,output price-base-with-tax-sale-prl
     3415             ,output price-rubl-without-tax-sale-prl
     3416             ,output price-base-without-tax-sale-prl
     3417             ,output vat-base-sale-prl
     3418             ,output vat-rubl-sale-prl
     3419             ,output vat-base-buyer-prl
     3420             ,output vat-rubl-buyer-prl
     3421             ,output slt-base-sale-prl
     3422             ,output slt-rubl-sale-prl
     3423             ,output road-tax-base-sale-prl
     3424             ,output road-tax-rubl-sale-prl
     3425             ,output excise-base-sale-prl
     3426             ,output excise-rubl-sale-prl
     3427             ,output discnt-base-sale-prl
     3428             ,output discnt-rubl-sale-prl
     3429             ) no-error .
     3430           if error-status :error
     3431           then do:
     3432             message
     3433               vss-workfile vss-revision vss-description skip
     3434               "Ошибка при вызове процеды prl-vat" skip
     3435               "Объект" p-obj-type p-obj-code skip
     3436               "Код товара" p-gds-code skip
     3437               "Указатель на запись переоценки" parrecid-prl skip
     3438               error-status :get-message(1) skip
     3439               return-value skip
     3440               view-as alert-box error .
     3441             undo, return error .
     3442           end.
     3443         end.
     3444         else do:
     3445           assign
     3446             price-rubl-with-tax-sale-prl    = 0
     3447             price-base-with-tax-sale-prl    = 0
     3448             price-rubl-without-tax-sale-prl = 0
     3449             price-base-without-tax-sale-prl = 0
     3450             vat-base-sale-prl               = 0
     3451             vat-rubl-sale-prl               = 0
     3452             slt-base-sale-prl               = 0
     3453             slt-rubl-sale-prl               = 0
     3454             road-tax-base-sale-prl          = 0
     3455             road-tax-rubl-sale-prl          = 0
     3456             excise-base-sale-prl            = 0
     3457             excise-rubl-sale-prl            = 0
     3458             discnt-base-sale-prl            = 0
     3459             discnt-rubl-sale-prl            = 0
     3460           .
     3461         end.
     3462         assign
     3463           v-fact-qnty         = v-fact-qnty
     3464                               + buf_temp-prt-obj.fact-qnty
     3465           v-cur-base          = v-cur-base
     3466                               + (if p-curr-r-b = 'base':U
     3467                                   then price-base-with-tax-sale-prl
     3468                                   else price-rubl-with-tax-sale-prl
     3469                                 )
     3470                               * buf_temp-prt-obj.fact-qnty
     3471           v-cur-VAT-base      = v-cur-VAT-base
     3472                               + (if p-curr-r-b = 'base':U
     3473                                   then vat-base-sale-prl
     3474                                   else vat-rubl-sale-prl
     3475                                 )
     3476                               * buf_temp-prt-obj.fact-qnty
     3477           v-cur-SLT-base      = v-cur-SLT-base
     3478                               + (if p-curr-r-b = 'base':U
     3479                                   then slt-base-sale-prl
     3480                                   else slt-rubl-sale-prl
     3481                                 )
     3482                               * buf_temp-prt-obj.fact-qnty
     3483           v-cur-road-tax-base = v-cur-road-tax-base
     3484                               + (if p-curr-r-b = 'base':U
     3485                                   then road-tax-base-sale-prl
     3486                                   else road-tax-rubl-sale-prl
     3487                                 )
     3488                               * buf_temp-prt-obj.fact-qnty
     3489           v-cur-excise-base   = v-cur-excise-base
     3490                               + (if p-curr-r-b = 'base':U
     3491                                   then excise-base-sale-prl
     3492                                   else excise-rubl-sale-prl
     3493                                 )
     3494                               * buf_temp-prt-obj.fact-qnty
     3495         .
     3496       end.
     3497       assign
     3498         p-fact-qnty         = v-fact-qnty
     3499         p-cur-base          = v-cur-base
     3500         p-cur-VAT-base      = v-cur-VAT-base
     3501         p-cur-SLT-base      = v-cur-SLT-base
     3502         p-cur-road-tax-base = v-cur-road-tax-base
     3503         p-cur-excise-base   = v-cur-excise-base
     3504       .
     3505     end.
     3506   end procedure.
     3507   procedure prdoclib-clear-temp-pl-gds :
     3508     define buffer buf_temp-pl-gds for temp-pl-gds .
     3509     do
     3510     on error undo, return error return-value
     3511     :
     3512       for each buf_temp-pl-gds
     3513       on error undo, return error return-value
     3514       :
     3515         delete buf_temp-pl-gds .
     3516       end.
     3517     end.
     3518   end procedure.
     3519   procedure prdoclib-init-temp-pl-gds :
     3520     define input parameter p-obj-type        like ub.pl-gds.obj-type  no-undo .
     3521     define input parameter p-obj-code        like ub.pl-gds.obj-code  no-undo .
     3522     define input parameter p-gds-code        like ub.pl-gds.gds-code  no-undo .
     3523     define buffer buf_pl-gds      for ub.pl-gds .
     3524     define buffer buf_temp-pl-gds for temp-pl-gds .
     3525     do
     3526     on error undo, return error return-value
     3527     :
     3528       run prdoclib-clear-temp-pl-gds in this-procedure .
     3529       for each buf_pl-gds
     3530         where buf_pl-gds.obj-type = p-obj-type
     3531           and buf_pl-gds.obj-code = p-obj-code
     3532           and buf_pl-gds.gds-code = p-gds-code
     3533       on error undo, return error return-value
     3534       :
     3535         create buf_temp-pl-gds .
     3536         buffer-copy buf_pl-gds to buf_temp-pl-gds .
     3537       end.
     3538     end.
     3539   end procedure.
     3540   procedure prdoclib-init-pl-gds-by-factord :
     3541     define input parameter p-obj-type           like ub.gds-obj.obj-type  no-undo .
     3542     define input parameter p-obj-code           like ub.gds-obj.obj-code  no-undo .
     3543     define input parameter p-artic              like ub.gds-obj.artic     no-undo .
     3544     define input parameter p-prod-type          like ub.gds-obj.prod-type no-undo .
     3545     define input parameter p-prod-code          like ub.gds-obj.prod-code no-undo .
     3546     define input parameter p-fact-order         as decimal   no-undo .
     3547     define input parameter p-include-fact-order as logical   no-undo .
     3548     define variable vss-description as character no-undo init "prdoclib-init-pl-gds-by-factord: определение остатков по признакам на любой момент времени".
     3549     define buffer buf_goods       for ub.goods .
     3550     define buffer buf_gds-obj     for ub.gds-obj .
     3551     define buffer buf_doc-line    for ub.doc-line .
     3552     define buffer buf_temp-pl-gds for temp-pl-gds .
     3553     define variable v-total-pl-gds-qnty     as decimal   no-undo .
     3554     define variable v-total-pl-gds-cli-qnty as decimal   no-undo .
     3555     do
     3556     on error undo, return error return-value
     3557     :
     3558       do transaction
     3559       on error undo, return error return-value
     3560       :
