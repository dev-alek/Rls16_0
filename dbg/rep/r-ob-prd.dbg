      583   procedure grplib-get-full-name :
      584      define input parameter p-node-code  as integer      no-undo.
      585      define output parameter p-full-name as character    no-undo.
      586      do
      587   on error undo, return error
      588   :
      589       define variable v-upper-code    as integer           no-undo.
      590       define buffer buf_gds-grp       for ub.gds-grp.
      591       define buffer buf_upper_gds-grp for ub.gds-grp.
      592       find first buf_gds-grp no-lock
      593            where buf_gds-grp.node-code = p-node-code
      594       no-error.
      595       if not available buf_gds-grp
      596       then do:
      597           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
      598       end.
      599       assign
      600           p-full-name  = ""
      601           v-upper-code = 1
      602       .
      603       do while buf_gds-grp.upper-code <> 0
      604       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
      605       :
      606           assign
      607               p-full-name  = buf_gds-grp.node-name
      608                            + (if p-full-name <> "" then chr(47) else "")
      609                            + p-full-name
      610               v-upper-code = buf_gds-grp.upper-code
      611           .
      612           find first buf_gds-grp no-lock
      613                where buf_gds-grp.node-code = v-upper-code
      614           no-error.
      615           if not available buf_gds-grp
      616           then do:
      617               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
      618                                   + string( v-upper-code )
      619                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      620           end.
      621       end.
      622       assign
      623       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
      624       .
      625   end.
      626   end .
      627   procedure grplib-get-node-from-full-name :
      628   define input parameter p-full-name as character no-undo .
      629   define output parameter p-node-code as integer no-undo .
      630   define variable v-ii as integer no-undo .
      631   define variable v-upper-code as integer no-undo .
      632   define variable v-root-code as integer no-undo .
      633   define variable v-entry as character no-undo .
      634   define buffer buf_gds-grp       for ub.gds-grp.
      635   do
      636   on error undo, return error
      637   :
      638     find first buf_gds-grp no-lock
      639         where buf_gds-grp.upper-code = 0
      640     no-error .
      641     if not available buf_gds-grp
      642     then do:
      643         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
      644     end.
      645     else do:
      646       assign
      647       v-root-code = buf_gds-grp.node-code
      648       .
      649     end.
      650     v-upper-code = v-root-code.
      651     do v-ii = 1 to num-entries(p-full-name, chr(47)):
      652       assign
      653       v-entry = entry(v-ii, p-full-name, chr(47)).
      654       if v-entry = '' then leave.
      655       find first buf_gds-grp no-lock where
      656                 buf_gds-grp.node-name = v-entry
      657             and buf_gds-grp.upper-code = v-upper-code
      658             no-error.
      659       if not available buf_gds-grp then do:
      660         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
      661       end.
      662       else do:
      663         p-node-code = buf_gds-grp.node-code.
      664         v-upper-code = buf_gds-grp.node-code.
      665       end.
      666     end.
      667   end.
      668   end .
      669   def var vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      670   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
      671   procedure paramls-clear :
      672     define buffer buf_temp-param for temp-param .
      673     do
      674     on error undo, return error return-value
      675     :
      676       for each buf_temp-param
      677       on error undo, return error
      678       :
      679         delete buf_temp-param .
      680       end.
      681     end.
      682   end procedure.
      683   procedure paramls-write :
      684     define input  parameter p-code     as character no-undo .
      685     define input  parameter p-sub-code as character no-undo .
      686     define input  parameter p-value    as character no-undo .
      687     define buffer buf_temp-param for temp-param .
      688     do
      689     on error undo, return error return-value
      690     :
      691       find first buf_temp-param
      692         where buf_temp-param.param-code     = p-code
      693           and buf_temp-param.param-sub-code = p-sub-code
      694         no-error .
      695       if not available buf_temp-param then do:
      696         create buf_temp-param .
      697         assign
      698           buf_temp-param.param-code     = p-code
      699           buf_temp-param.param-sub-code = p-sub-code
      700         .
      701       end.
      702       assign
      703         buf_temp-param.param-value = p-value
      704       .
      705     end.
      706   end procedure.
      707   procedure paramls-read :
      708     define input  parameter p-code          as character no-undo .
      709     define input  parameter p-sub-code      as character no-undo .
      710     define input  parameter p-default-value as character no-undo .
      711     define output parameter p-value         as character no-undo .
      712     define buffer buf_temp-param for temp-param .
      713     do
      714     on error undo, return error return-value
      715     :
      716       find first buf_temp-param
      717         where buf_temp-param.param-code     = p-code
      718           and buf_temp-param.param-sub-code = p-sub-code
      719         no-error .
      720       if available buf_temp-param then do:
      721         assign
      722           p-value = buf_temp-param.param-value
      723         .
      724       end.
      725       else do:
      726         assign
      727           p-value = p-default-value
      728         .
      729       end.
      730     end.
      731   end procedure.
      732   procedure paramls-append :
      733     define input  parameter p-code     as character no-undo .
      734     define input  parameter p-sub-code as character no-undo .
      735     define input  parameter p-value    as character no-undo .
      736     define buffer buf_temp-param for temp-param .
      737     do
      738     on error undo, return error return-value
      739     :
      740       find first buf_temp-param
      741            where buf_temp-param.param-code     = p-code
      742              and buf_temp-param.param-sub-code = p-sub-code
      743         no-error .
      744       if not available buf_temp-param then do:
      745         create buf_temp-param .
      746         assign
      747           buf_temp-param.param-code     = p-code
      748           buf_temp-param.param-sub-code = p-sub-code
      749           buf_temp-param.param-value    = p-value
      750         .
      751       end.
      752       else do:
      753           assign
      754               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
      755           .
      756       end.
      757     end.
      758   end procedure.
      759   define variable vss-include-info9 as character format "X(65)" no-undo
      760   initial "@(#)$Workfile$ $Revision$".
      761   def var vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      762   procedure r-cost :
      763     define input  parameter v-doc-code       like ub.doc-line.doc-code          no-undo .
      764     define input  parameter v-artic          like ub.doc-line.artic             no-undo .
      765     define input  parameter v-prod-type      like ub.doc-line.prod-type         no-undo .
      766     define input  parameter v-prod-code      like ub.doc-line.prod-code         no-undo .
      767     define output parameter v-fact-qnty      like ub.ot-line.fact-qnty       no-undo .
      768     define output parameter v-vat-pc         like ub.doc-line.vat-pc         no-undo .
      769     define output parameter v-slt-pc         like ub.doc-line.slt-pc         no-undo .
      770     define output parameter v-sum-base       like ub.ot-line.sum-base        no-undo .
      771     define output parameter v-sum-rubl       like ub.ot-line.sum-rubl        no-undo .
      772     define output parameter v-vat-base       like ub.ot-line.vat-base        no-undo .
      773     define output parameter v-vat-rubl       like ub.ot-line.vat-rubl        no-undo .
      774     define output parameter v-slt-base       like ub.ot-line.slt-base        no-undo .
      775     define output parameter v-slt-rubl       like ub.ot-line.slt-rubl        no-undo .
      776     define output parameter v-road-tax-base  like ub.ot-line.road-tax-base   no-undo .
      777     define output parameter v-road-tax-rubl  like ub.ot-line.road-tax-rubl   no-undo .
      778     define output parameter v-transport-base like ub.ot-line.transport-base  no-undo .
      779     define output parameter v-transport-rubl like ub.ot-line.transport-rubl  no-undo .
      780     define output parameter v-other-base     like ub.ot-line.other-base      no-undo .
      781     define output parameter v-other-rubl     like ub.ot-line.other-rubl      no-undo .
      782     define output parameter v-excise-base    like ub.ot-line.excise-base     no-undo .
      783     define output parameter v-excise-rubl    like ub.ot-line.excise-rubl     no-undo .
      784     do
      785     on error undo, return error
      786     :
      787       define buffer   in-vatp-trn-doc  for ub.trn-doc .
      788       define buffer   in-vatp-parts    for ub.parts   .
      789       define buffer   in-vatp-doc      for ub.trn-doc .
      790       define buffer   in-vatp-goods    for ub.goods   .
      791       define buffer   in-vatp-sysconf  for ub.sysconf .
      792       define buffer   in-vatp_doc-attr for ub.doc-attr.
      793       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
      794       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
      795       define variable varinvprb                  as   character              no-undo.
      796       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
      797       define variable cli-base-rate              as   decimal                no-undo.
      798       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
      799       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
      800       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
      801       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
      802       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
      803       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
      804       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
      805       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
      806       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
      807       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
      808       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
      809       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
      810       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
      811       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
      812       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
      813       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
      814       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
      815       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
      816       define variable other-base-loc             like ub.doc-line.price-base no-undo.
      817       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
      818       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
      819       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
      820       define variable varinvatp-envd             as   character              no-undo.
      821       define variable varinvatp-type             as   character              no-undo.
      822       def var v-parts-fact-qnty as decimal   no-undo .
      823       define buffer buf_parts    for ub.parts    .
      824       define buffer buf_goods    for ub.goods    .
      825       define buffer buf_trn-doc  for ub.trn-doc  .
      826       define buffer buf_doc-line for ub.doc-line .
      827       find first buf_doc-line no-lock
      828         where buf_doc-line.doc-code  = v-doc-code
      829           and buf_doc-line.artic     = v-artic
      830           and buf_doc-line.prod-type = v-prod-type
      831           and buf_doc-line.prod-code = v-prod-code
      832         no-error .
      833       if not available buf_doc-line then do:
      834         message
      835           vss-workfile vss-revision vss-description skip
      836           vss-include-info10 skip
      837           "Ошибка задания входных параметров" skip
      838           "Не найдена строка документа"  skip
      839           "Документ" v-doc-code skip
      840           "Артикул" v-artic v-prod-type v-prod-code skip
      841           view-as alert-box error .
      842         return error .
      843       end.
      844       find first buf_trn-doc no-lock
      845         where buf_trn-doc.doc-code = v-doc-code
      846         no-error .
      847       if not available buf_trn-doc then do:
      848         message
      849           vss-workfile vss-revision vss-description skip
      850           vss-include-info10 skip
      851           "Ошибка задания входных параметров" skip
      852           "Не найден документ" skip
      853           "Документ" v-doc-code skip
      854           "Артикул" v-artic v-prod-type v-prod-code skip
      855           view-as alert-box error .
      856         undo, return error .
      857       end.
      858       find first buf_goods no-lock
      859         where buf_goods.artic     = buf_doc-line.artic
      860           and buf_goods.prod-type = buf_doc-line.prod-type
      861           and buf_goods.prod-code = buf_doc-line.prod-code
      862         no-error .
      863       if not available buf_goods then do:
      864         message
      865           vss-workfile vss-revision vss-description skip
      866           vss-include-info10 skip
      867           "Ошибка задания входных параметров" skip
      868           "Не найден товар" skip
      869           "Документ" v-doc-code skip
      870           "Артикул" v-artic v-prod-type v-prod-code skip
      871           view-as alert-box error .
      872         undo, return error .
      873       end.
      874       if buf_goods.gds-type = 'т':U then do:
      875             for each buf_parts no-lock
      876               where buf_parts.out-code  = buf_trn-doc.doc-code
      877                 and buf_parts.obj-type  = buf_trn-doc.obj-type
      878                 and buf_parts.obj-code  = buf_trn-doc.obj-code
      879                 and buf_parts.artic     = buf_doc-line.artic
      880                 and buf_parts.prod-type = buf_doc-line.prod-type
      881                 and buf_parts.prod-code = buf_doc-line.prod-code
      882             on error undo, return error
      883             :
      884   assign
      885     price-rubl-with-tax-loc = buf_parts.price-rubl
      886     price-base-with-tax-loc = buf_parts.price-base
      887   .
      888   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      889   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      890     (output varinvprb
      891     )  .
      892     if buf_parts.out-code = 'free-zone':U     or
      893        buf_parts.out-code = 'out-zone':U   or
      894        buf_parts.doc-type = 'акт':U then do:
      895       assign
      896         in-vatp-have-vat-slt = yes.
      897     end.
      898     else do:
      899       find first in-vatp_doc-attr no-lock
      900         where in-vatp_doc-attr.doc-code  = buf_parts.out-code
      901           and in-vatp_doc-attr.attr-code = 'envd':U
      902         no-error .
      903       if not available in-vatp_doc-attr then do:
      904         assign
      905           in-vatp-have-vat-slt = yes.
      906       end.
      907       else do:
      908            in-vatp-have-vat-slt = no.
      909       end.
      910     end.
      911     assign
      912      price-cli-with-tax-loc = buf_parts.price-cli
      913      cli-base-rate          = buf_parts.cli-base-rate.
      914     ASSIGN   road-tax-base-loc  = (if buf_parts.road-tax-base  = ? then 0 else buf_parts.road-tax-base)
      915              road-tax-rubl-loc  = (if buf_parts.road-tax-rubl  = ? then 0 else buf_parts.road-tax-rubl).
      916     ASSIGN  transport-base-loc = (if buf_parts.transport-base = ? then 0 else buf_parts.transport-base)
      917             transport-rubl-loc = (if buf_parts.transport-rubl = ? then 0 else buf_parts.transport-rubl)
      918             other-base-loc     = (if buf_parts.other-base     = ? then 0 else buf_parts.other-base)
      919             other-rubl-loc     = (if buf_parts.other-rubl     = ? then 0 else buf_parts.other-rubl)
      920             vat-pc-loc         = (if buf_parts.vat-pc         = ? then 0 else buf_parts.vat-pc)
      921             slt-pc-loc         = (if buf_parts.slt-pc         = ? then 0 else buf_parts.slt-pc).
      922             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
