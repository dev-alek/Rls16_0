     5889   procedure PrintTitul :
     5890     if (PAGE-NUMBER( outstream ) = 1 ) then do:
     5891       PUT stream OutStream SPACE(30) ReportNAme format "X(100)" SKIP
     5892                              str1 format "X(130)" SKIP
     5893                              str2 format "X(130)" SKIP
     5894                              str3 format "X(130)" SKIP
     5895                              ReportHeader format "X(130)" SKIP.
     5896       PUT stream OutStream "Выбранные объекты: " format "X(20)" .
