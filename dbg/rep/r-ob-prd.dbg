     6368           run PutItogSum in this-procedure ( ItogStr, 5) .
     6369         End.
     6370         if last-of(gds-prop.s-ind) then do:
     6371           if ItogStr1 = ? then run PutItogSum in this-procedure ("Итого по ?", 3) .
     6372           else run PutItogSum in this-procedure ("Итого по " + ItogStr1, 3) .
     6373         End.
     6374         if last-of(gds-prop.prod-code) then do:
     6375           assign ItogStr = "Итого по производителю " .
     6376           run PutItogSum in this-procedure ( ItogStr, 2) .
