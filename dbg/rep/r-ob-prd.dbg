     1285       define variable varvat-base-factovp      like ub.gds-dtl.price-base               no-undo.
     1286       define variable varvatcons-base-factovp  like ub.gds-dtl.price-base               no-undo.
     1287       define variable vardsc-base-factovp      like ub.gds-dtl.price-base               no-undo.
     1288       define variable varsum-base-docovp       like ub.gds-dtl.price-base               no-undo.
     1289       define variable varslt-base-docovp       like ub.gds-dtl.price-base               no-undo.
     1290       define variable varvat-base-docovp       like ub.gds-dtl.price-base               no-undo.
     1291       define variable varvatcons-base-docovp   like ub.gds-dtl.price-base               no-undo.
     1292       define variable vardsc-base-docovp       like ub.gds-dtl.price-base               no-undo.
     1293       define variable varsum-rubl-factovp      like ub.gds-dtl.price-base               no-undo.
     1294       define variable varslt-rubl-factovp      like ub.gds-dtl.price-base               no-undo.
     1295       define variable varvat-rubl-factovp      like ub.gds-dtl.price-base               no-undo.
     1296       define variable varvatcons-rubl-factovp  like ub.gds-dtl.price-base               no-undo.
     1297       define variable vardsc-rubl-factovp      like ub.gds-dtl.price-base               no-undo.
     1298       define variable varsum-rubl-docovp       like ub.gds-dtl.price-base               no-undo.
     1299       define variable varslt-rubl-docovp       like ub.gds-dtl.price-base               no-undo.
     1300       define variable varvat-rubl-docovp       like ub.gds-dtl.price-base               no-undo.
     1301       define variable varvatcons-rubl-docovp   like ub.gds-dtl.price-base               no-undo.
     1302       define variable vardsc-rubl-docovp       like ub.gds-dtl.price-base               no-undo.
     1303       define variable varfact-qnty             like ub.parts.fact-qnty                  no-undo.
     1304       define variable varcons-qnty             like ub.parts.fact-qnty                  no-undo.
     1305       define variable varis-one-gds-dtl        as   logical                             no-undo.
     1306       define variable varcurprice-base         like ub.gds-dtl.cur-base                 no-undo.
     1307       define variable varcurprice-rubl         like ub.gds-dtl.price-base               no-undo.
     1308       define variable varcurdiscnt-base        like ub.gds-dtl.cur-base                 no-undo.
     1309       define variable varcurdiscnt-rubl        like ub.gds-dtl.price-base               no-undo.
     1310       define variable varoutvprb               as   character                           no-undo.
     1311       define variable out-vatp-have-vat-slt    as   logical initial yes                 no-undo.
     1312       define buffer   in-vatp-trn-doco  for ub.trn-doc .
     1313       define buffer   in-vatp-partso    for ub.parts   .
     1314       define buffer   in-vatp-doco      for ub.trn-doc .
     1315       define buffer   in-vatp-goodso    for ub.goods   .
     1316       define buffer   in-vatp-sysconfo  for ub.sysconf .
     1317       define buffer   in-vatp_doc-attro for ub.doc-attr.
     1318       define variable in-vatp-have-vat-slto       as   logical initial yes    no-undo.
     1319       define variable vat-pc-loco                 like ub.doc-line.vat-pc     no-undo.
     1320       define variable varinvprbo                  as   character              no-undo.
     1321       define variable slt-pc-loco                 like ub.doc-line.slt-pc     no-undo.
     1322       define variable cli-base-rateo              as   decimal                no-undo.
     1323       define variable price-rubl-with-tax-loco    like ub.doc-line.price-rubl no-undo.
     1324       define variable price-base-with-tax-loco    like ub.doc-line.price-base no-undo.
     1325       define variable price-cli-with-tax-loco     like ub.doc-line.price-cli  no-undo.
     1326       define variable price-rubl-without-tax-loco like ub.doc-line.price-rubl no-undo.
     1327       define variable price-base-without-tax-loco like ub.doc-line.price-base no-undo.
     1328       define variable price-cli-without-tax-loco  like ub.doc-line.price-base no-undo.
     1329       define variable vat-base-loco               like ub.doc-line.price-base no-undo.
     1330       define variable vat-rubl-loco               like ub.doc-line.price-rubl no-undo.
     1331       define variable vat-cli-loco                like ub.doc-line.price-rubl no-undo.
     1332       define variable slt-base-loco               like ub.doc-line.price-base no-undo.
     1333       define variable slt-rubl-loco               like ub.doc-line.price-rubl no-undo.
     1334       define variable slt-cli-loco                like ub.doc-line.price-rubl no-undo.
     1335       define variable road-tax-base-loco          like ub.doc-line.road-tax   no-undo.
     1336       define variable road-tax-rubl-loco          like ub.doc-line.road-tax   no-undo.
     1337       define variable road-tax-cli-loco           like ub.doc-line.road-tax   no-undo.
     1338       define variable transport-base-loco         like ub.doc-line.price-base no-undo.
     1339       define variable transport-rubl-loco         like ub.doc-line.price-rubl no-undo.
     1340       define variable transport-cli-loco          like ub.doc-line.price-rubl no-undo.
     1341       define variable other-base-loco             like ub.doc-line.price-base no-undo.
     1342       define variable other-rubl-loco             like ub.doc-line.price-rubl no-undo.
     1343       define variable other-cli-loco              like ub.doc-line.price-rubl no-undo.
     1344       define variable exch-rate-cli-loco          like ub.trn-doc.exch-rate   no-undo.
     1345       define variable varinvatp-envdo             as   character              no-undo.
     1346       define variable varinvatp-typeo             as   character              no-undo.
     1347       define variable v-gds-dtl-fact-qnty as decimal no-undo .
     1348       define buffer buf_gds-dtl  for ub.gds-dtl .
     1349       define buffer buf_goods    for ub.goods .
     1350       define buffer buf_trn-doc  for ub.trn-doc .
     1351       define buffer buf_doc-line for ub.doc-line .
     1352       find first buf_doc-line no-lock
     1353         where buf_doc-line.doc-code  = p-doc-code
     1354           and buf_doc-line.artic     = p-artic
     1355           and buf_doc-line.prod-type = p-prod-type
     1356           and buf_doc-line.prod-code = p-prod-code
     1357         no-error .
     1358       if not available buf_doc-line then do:
     1359         message
     1360           vss-workfile vss-revision vss-description skip
     1361           vss-include-info15 skip
     1362           "Ошибка задания входных параметров" skip
     1363           "Не найдена строка документа" skip
     1364           "Документ" p-doc-code skip
     1365           "Артикул" p-artic p-prod-type p-prod-code skip
     1366           view-as alert-box error .
     1367         undo, return error .
     1368       end.
     1369       find first buf_trn-doc no-lock
     1370         where buf_trn-doc.doc-code = buf_doc-line.doc-code
     1371         no-error .
     1372       if not available buf_trn-doc then do:
     1373         message
     1374           vss-workfile vss-revision vss-description skip
     1375           vss-include-info15 skip
     1376           "Не найден документ" skip
     1377           "Документ" p-doc-code skip
     1378           "Артикул" p-artic p-prod-type p-prod-code skip
     1379           view-as alert-box error .
     1380         undo, return error .
     1381       end.
     1382       for each buf_gds-dtl no-lock
     1383         where buf_gds-dtl.doc-code  = buf_doc-line.doc-code
     1384           and buf_gds-dtl.artic     = buf_doc-line.artic
     1385           and buf_gds-dtl.prod-type = buf_doc-line.prod-type
     1386           and buf_gds-dtl.prod-code = buf_doc-line.prod-code
     1387       on error undo, return error
     1388       :
     1389           if buf_trn-doc.doc-type <> 'инв':U
     1390           then do:
     1391               if buf_trn-doc.doc-type = 'при':U
     1392               or buf_trn-doc.doc-type = 'возврат':U
     1393               then do:
     1394                   assign
     1395                       v-gds-dtl-fact-qnty = buf_gds-dtl.fact-qnty
     1396                   .
     1397               end.
     1398               else do:
     1399                   assign
     1400                       v-gds-dtl-fact-qnty = - buf_gds-dtl.fact-qnty
     1401                   .
     1402               end.
     1403           end.
     1404           else do:
     1405               assign
     1406                   v-gds-dtl-fact-qnty = buf_gds-dtl.doc-qnty
     1407               .
     1408           end.
     1409           if v-gds-dtl-fact-qnty <> 0
     1410           then do:
     1411   if buf_trn-doc.ext-doc-type = 'ot':U or
     1412      buf_trn-doc.ext-doc-type = ?                 then do:
     1413     assign
     1414      out-vatp-have-vat-slt = yes.
     1415   end.
     1416   else do:
     1417     find first out-vatp_doc-attr no-lock
     1418       where out-vatp_doc-attr.doc-code  = buf_trn-doc.doc-code
     1419         and out-vatp_doc-attr.attr-code = 'envd':U
     1420         no-error .
     1421     if not available out-vatp_doc-attr then do:
     1422       assign
     1423         out-vatp-have-vat-slt = yes.
     1424     end.
     1425     else do:
     1426        out-vatp-have-vat-slt = no.
     1427     end.
     1428   end.
     1429   find first out-vatp_goods where out-vatp_goods.artic     = buf_doc-line.artic     and
     1430                                      out-vatp_goods.prod-type = buf_doc-line.prod-type and
     1431                                      out-vatp_goods.prod-code = buf_doc-line.prod-code no-lock.
     1432   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1433   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rootnode in g#library
     1434     (input  buf_doc-line.artic
     1435     ,input  buf_doc-line.prod-type
     1436     ,input  buf_doc-line.prod-code
     1437     ,output varroot-node
     1438     ) no-error .
     1439   if error-status :error then do:
     1440     message
     1441       vss-workfile vss-revision vss-description skip
     1442       "Ошибка при определении корневого признака товара" skip
     1443       "Артикул" buf_doc-line.artic buf_doc-line.prod-type buf_doc-line.prod-code skip
     1444       error-status :get-message(1) skip
     1445       return-value skip
     1446       view-as alert-box error .
     1447     undo, return error .
     1448   end.
     1449   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prtat in g#library
     1450     (input  varroot-node
     1451     ,input  'empty-scale=request'
     1452     ,output varempty-scale
     1453     ) no-error .
     1454   if error-status :error then do:
     1455     message
     1456       vss-workfile vss-revision vss-description skip
     1457       "Ошибка при определении атрибута признака" skip
     1458       "Артикул" buf_doc-line.artic buf_doc-line.prod-type buf_doc-line.prod-code skip
     1459       "Признак" varroot-node skip
     1460       "Запрашивался атрибут" "empty-scale=request" skip
     1461       error-status :get-message(1) skip
     1462       return-value skip
     1463       view-as alert-box error .
     1464     undo, return error .
     1465   end.
     1466   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1467   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1468     (output varoutvprb
     1469     )  .
     1470   if varoutvprb = "base":u then do:
     1471     assign
     1472           road-tax-base-sale    =  (if buf_doc-line.road-tax = ? then 0 else buf_doc-line.road-tax * 1)
     1473       excise-base-sale      =  (if buf_doc-line.excise   = ? then 0 else buf_doc-line.excise   * 1)
     1474     .
     1475   end.
     1476   else do:
     1477     assign
     1478           road-tax-base-sale    =  (if buf_doc-line.road-tax = ? then 0 else buf_doc-line.road-tax / buf_trn-doc.base-rate * buf_trn-doc.base-scale)
     1479       excise-base-sale      =  (if buf_doc-line.excise   = ? then 0 else buf_doc-line.excise   / buf_trn-doc.base-rate * buf_trn-doc.base-scale)
     1480     .
     1481   end.
     1482   if varoutvprb = "rubl":u then do:
     1483     assign
     1484           road-tax-rubl-sale    = (if buf_doc-line.road-tax = ? then 0 else buf_doc-line.road-tax * 1)
     1485       excise-rubl-sale      = (if buf_doc-line.excise   = ? then 0 else buf_doc-line.excise   * 1) .
     1486   end.
     1487   else do:
     1488     assign
     1489           road-tax-rubl-sale    = (if buf_doc-line.road-tax = ? then 0 else buf_doc-line.road-tax * buf_trn-doc.base-rate / buf_trn-doc.base-scale)
     1490       excise-rubl-sale      = (if buf_doc-line.excise   = ? then 0 else buf_doc-line.excise   * buf_trn-doc.base-rate / buf_trn-doc.base-scale) .
     1491   end.
     1492   assign
     1493     varis-cons-parts-have =  no.
     1494   assign
     1495     varfact-qnty       = 0
     1496     varcons-qnty       = 0
     1497     varprice-base-cons = 0
     1498     varprice-rubl-cons = 0.
     1499   find first out-vatp_doc-line where
     1500              out-vatp_doc-line.doc-code   = buf_trn-doc.doc-code
     1501          and out-vatp_doc-line.artic      = buf_doc-line.artic
     1502          and out-vatp_doc-line.prod-type  = buf_doc-line.prod-type
     1503          and out-vatp_doc-line.prod-code  = buf_doc-line.prod-code no-lock no-error.
     1504   if available out-vatp_doc-line           and
     1505     (out-vatp_doc-line.status_ = 'запрос':U or out-vatp_goods.gds-type = 'у':U) then do:
     1506     assign
     1507       varfact-qnty = out-vatp_doc-line.fact-qnty.
     1508   end.
     1509   else do:
     1510     for each out-vatp_parts where out-vatp_parts.out-code   = buf_trn-doc.doc-code
     1511                                  and out-vatp_parts.obj-type   = buf_trn-doc.obj-type
     1512                                  and out-vatp_parts.obj-code   = buf_trn-doc.obj-code
     1513                                  and out-vatp_parts.artic      = buf_doc-line.artic
     1514                                  and out-vatp_parts.prod-type  = buf_doc-line.prod-type
     1515                                  and out-vatp_parts.prod-code  = buf_doc-line.prod-code no-lock :
     1516       if out-vatp_parts.purch-code = 2 then do:
     1517   assign
     1518     price-rubl-with-tax-loco = out-vatp_parts.price-rubl
     1519     price-base-with-tax-loco = out-vatp_parts.price-base
     1520   .
     1521   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1522   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1523     (output varinvprbo
     1524     )  .
     1525     if out-vatp_parts.out-code = 'free-zone':U     or
     1526        out-vatp_parts.out-code = 'out-zone':U   or
     1527        out-vatp_parts.doc-type = 'акт':U then do:
     1528       assign
     1529         in-vatp-have-vat-slto = yes.
     1530     end.
     1531     else do:
     1532       find first in-vatp_doc-attro no-lock
     1533         where in-vatp_doc-attro.doc-code  = out-vatp_parts.out-code
     1534           and in-vatp_doc-attro.attr-code = 'envd':U
     1535         no-error .
     1536       if not available in-vatp_doc-attro then do:
     1537         assign
     1538           in-vatp-have-vat-slto = yes.
     1539       end.
     1540       else do:
     1541            in-vatp-have-vat-slto = no.
     1542       end.
     1543     end.
     1544     assign
     1545      price-cli-with-tax-loco = out-vatp_parts.price-cli
     1546      cli-base-rateo          = out-vatp_parts.cli-base-rate.
     1547     ASSIGN   road-tax-base-loco  = (if out-vatp_parts.road-tax-base  = ? then 0 else out-vatp_parts.road-tax-base)
     1548              road-tax-rubl-loco  = (if out-vatp_parts.road-tax-rubl  = ? then 0 else out-vatp_parts.road-tax-rubl).
     1549     ASSIGN  transport-base-loco = (if out-vatp_parts.transport-base = ? then 0 else out-vatp_parts.transport-base)
     1550             transport-rubl-loco = (if out-vatp_parts.transport-rubl = ? then 0 else out-vatp_parts.transport-rubl)
     1551             other-base-loco     = (if out-vatp_parts.other-base     = ? then 0 else out-vatp_parts.other-base)
     1552             other-rubl-loco     = (if out-vatp_parts.other-rubl     = ? then 0 else out-vatp_parts.other-rubl)
     1553             vat-pc-loco         = (if out-vatp_parts.vat-pc         = ? then 0 else out-vatp_parts.vat-pc)
     1554             slt-pc-loco         = (if out-vatp_parts.slt-pc         = ? then 0 else out-vatp_parts.slt-pc).
     1555             ASSIGN   slt-base-loco    = (if in-vatp-have-vat-slto = no then 0 else (price-base-with-tax-loco - ((if road-tax-base-loco  = ? then 0 else road-tax-base-loco) + (if transport-base-loco = ? then 0 else transport-base-loco) + (if other-base-loco = ? then 0 else other-base-loco)))                           * slt-pc-loco / (100 + slt-pc-loco))                        vat-base-loco    = (if in-vatp-have-vat-slto = no then 0 else (price-base-with-tax-loco - ((if road-tax-base-loco  = ? then 0 else road-tax-base-loco) + (if transport-base-loco = ? then 0 else transport-base-loco) + (if other-base-loco = ? then 0 else other-base-loco))) * (1 - slt-pc-loco / (100 + slt-pc-loco)) * vat-pc-loco / (100 + vat-pc-loco)).
     1556       ASSIGN   slt-rubl-loco    = (if in-vatp-have-vat-slto = no then 0 else (price-rubl-with-tax-loco - ((if road-tax-rubl-loco  = ? then 0 else road-tax-rubl-loco) + (if transport-rubl-loco = ? then 0 else transport-rubl-loco) + (if other-rubl-loco = ? then 0 else other-rubl-loco)))                           * slt-pc-loco / (100 + slt-pc-loco))                        vat-rubl-loco    = (if in-vatp-have-vat-slto = no then 0 else (price-rubl-with-tax-loco - ((if road-tax-rubl-loco  = ? then 0 else road-tax-rubl-loco) + (if transport-rubl-loco = ? then 0 else transport-rubl-loco) + (if other-rubl-loco = ? then 0 else other-rubl-loco))) * (1 - slt-pc-loco / (100 + slt-pc-loco)) * vat-pc-loco / (100 + vat-pc-loco)).
     1557     assign
     1558       exch-rate-cli-loco = (out-vatp_parts.price-rubl - transport-rubl-loco - other-rubl-loco - road-tax-rubl-loco - (if out-vatp_parts.vat-type <> 'в т. ч.':U then vat-rubl-loco else 0) - (if out-vatp_parts.slt-type <> 'в т. ч.':U then slt-rubl-loco else 0)) / out-vatp_parts.price-cli .
     1559     assign
     1560       slt-cli-loco        = slt-rubl-loco       / exch-rate-cli-loco
     1561       vat-cli-loco        = vat-rubl-loco       / exch-rate-cli-loco
     1562       road-tax-cli-loco   = road-tax-rubl-loco  / exch-rate-cli-loco
     1563       transport-cli-loco  = 0
     1564       other-cli-loco      = 0
     1565     .
     1566   ASSIGN
     1567             price-base-without-tax-loco = price-base-with-tax-loco - vat-base-loco - slt-base-loco - ((if road-tax-base-loco  = ? then 0 else road-tax-base-loco) + (if transport-base-loco = ? then 0 else transport-base-loco) + (if other-base-loco = ? then 0 else other-base-loco))
     1568       price-rubl-without-tax-loco = price-rubl-with-tax-loco - vat-rubl-loco - slt-rubl-loco - ((if road-tax-rubl-loco  = ? then 0 else road-tax-rubl-loco) + (if transport-rubl-loco = ? then 0 else transport-rubl-loco) + (if other-rubl-loco = ? then 0 else other-rubl-loco))
     1569   .
     1570         assign
     1571           varprice-base-cons = varprice-base-cons + (price-base-with-tax-loco - (if road-tax-base-loco = ? then 0 else road-tax-base-loco))* out-vatp_parts.fact-qnty
     1572           varprice-rubl-cons = varprice-rubl-cons + (price-rubl-with-tax-loco - (if road-tax-rubl-loco = ? then 0 else road-tax-rubl-loco))* out-vatp_parts.fact-qnty.
     1573         assign
     1574           varis-cons-parts-have = yes
     1575           varcons-qnty          = varcons-qnty + out-vatp_parts.fact-qnty.
     1576       end.
     1577       assign
     1578         varfact-qnty = varfact-qnty + out-vatp_parts.fact-qnty.
