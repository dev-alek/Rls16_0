     4959   define variable v-account as integer init 0 no-undo .
     4960   define variable v-account-lavel as character no-undo .
     4961   define variable v-button-stop as logical no-undo .
     4962   define variable v-kol-spice as integer no-undo .
     4963   define variable v-kol-spice2 as integer no-undo .
     4964   define variable v-kol-spice3 as integer no-undo .
     4965   DEFINE VARIABLE StopProcessing AS LOGICAL NO-UNDO.
     4966   DEFINE BUTTON StopBtn AUTO-END-KEY
     4967        LABEL "Стоп"
     4968        SIZE 10 BY 1.
     4969   DEFINE VARIABLE RecordsDone AS INTEGER FORMAT ">,>>>,>>>,>>9":U INITIAL 0
     4970        LABEL "Обработано записей"
     4971         VIEW-AS TEXT
     4972        SIZE 14 BY .67 NO-UNDO.
     4973   DEFINE VARIABLE RecordsString AS CHARACTER FORMAT "X(60)"
     4974         VIEW-AS TEXT
     4975        SIZE 53.25 BY .67
     4976        FGCOLOR 1  NO-UNDO.
     4977   DEFINE VARIABLE RecordsString2 AS CHARACTER FORMAT "X(60)"
     4978         VIEW-AS TEXT
     4979        SIZE 53.25 BY .67
     4980        FGCOLOR 1  NO-UNDO.
     4981   DEFINE VARIABLE RecordsString3 AS CHARACTER FORMAT "X(60)"
     4982         VIEW-AS TEXT
     4983        SIZE 53.25 BY .67
     4984        FGCOLOR 1  NO-UNDO.
     4985   DEFINE RECTANGLE RECT-1
     4986        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     4987        SIZE 55.13 BY 4.46.
     4988   DEFINE FRAME InfoFrame
     4989        StopBtn AT ROW 4.25 COL 21.75
     4990        RecordsString AT ROW 1.21 COL 2 NO-LABEL
     4991        RecordsString2 AT ROW 1.96 COL 2 NO-LABEL
     4992        RecordsString3 AT ROW 2.58 COL 2 NO-LABEL
     4993        RecordsDone AT ROW 3.42 COL 24.88 COLON-ALIGNED
     4994        RECT-1 AT ROW 1 COL 1
     4995       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     4996            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     4997            TITLE "Процесс"
     4998            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
     4999   define variable mFrameView      as logical   no-undo init yes.
     5000     define variable mFramHandle as handle no-undo.
     5001     mFramHandle = frame InfoFrame:handle.
     5002     if  log-manager:logfile-name ne ?
     5003     then DO:
     5004         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     5005         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     5006         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
     5007     end.
     5008     mFrameView = not session:batch-mode and mFramHandle:visible.
     5009     if mFrameView
     5010     then do:
     5011       ASSIGN
     5012          FRAME InfoFrame:HIDDEN                           = TRUE
     5013          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
     5014     end.
     5015   ON CHOOSE OF StopBtn IN FRAME InfoFrame
     5016   DO:
     5017     IF not StopProcessing THEN
     5018       Message "Вы действительно хотите прервать" SKIP
     5019               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
     5020                 UPDATE StopProcessing.
     5021     IF StopProcessing THEN do:
     5022        if mFrameView
     5023        then do:
     5024           HIDE FRAME InfoFrame.
     5025        end.
     5026     End.
     5027   END.
     5028   assign v-account = ( if integer( 10 ) = 0 then 100 else integer( 10 ) ).
     5029     if  log-manager:logfile-name ne ?
     5030     then DO:
     5031         log-manager:write-message("ON mFrameView=" + string(mFrameView), "frameRepError").
     5032     end.
     5033     if not session:batch-mode then
     5034     do:
     5035       VIEW FRAME InfoFrame.
     5036       mFrameView = true.
     5037     end.
     5038      v-button-stop = false .
     5039         if mFrameView
     5040         then do:
     5041         if v-button-stop then view STOPBTN in frame InfoFrame.
     5042                          else Hide STOPBTN in frame InfoFrame.
     5043         end.
     5044     if x-SelectGood = 2 then do:
     5045       for each tmp#grp :
     5046         run grplib-get-full-name in this-procedure( input tmp#grp.node-code, output CurrGrpName ) .
     5047         for each obj-list,
     5048             each buf_gds-obj no-lock
     5049           where buf_gds-obj.obj-type = obj-list.obj-type
     5050             and buf_gds-obj.obj-code = obj-list.obj-code
     5051             and buf_gds-obj.grp-name begins CurrGrpName :
     5052           find first gds-sel-grp
     5053             where gds-sel-grp.artic     = buf_gds-obj.artic
     5054               and gds-sel-grp.prod-type = buf_gds-obj.prod-type
     5055               and gds-sel-grp.prod-code = buf_gds-obj.prod-code
     5056             no-error .
     5057           if not available gds-sel-grp then do:
     5058             create gds-sel-grp .
     5059             assign
     5060               gds-sel-grp.artic     = buf_gds-obj.artic
     5061               gds-sel-grp.prod-type = buf_gds-obj.prod-type
     5062               gds-sel-grp.prod-code = buf_gds-obj.prod-code
     5063             .
     5064           end.
     5065         end.
     5066       end.
     5067     end.
     5068     for each obj-list :
     5069       if CloseDoc = yes then do:
     5070         for each buf_trn-doc no-lock
     5071           where buf_trn-doc.obj-type   = obj-list.obj-type
     5072             and buf_trn-doc.obj-code   = obj-list.obj-code
     5073             and buf_trn-doc.status_    =  'факт':U
     5074             and buf_trn-doc.fact-order >= v-fact-order-start
     5075             and buf_trn-doc.fact-order <  v-fact-order-end
     5076         :
     5077   define variable vss-include-info54 as character format "X(65)" no-undo
     5078   initial "@(#)$Workfile$ $Revision$".
     5079           find first buf1_clients no-lock
     5080             where buf1_clients.obj-type = buf_trn-doc.cli-type
     5081               and buf1_clients.obj-code = buf_trn-doc.cli-code
     5082           .
     5083           if SelectOrg = 2 then do:
     5084             find first buf_clients where recid( buf_clients ) = integer( org-list ) no-lock .
     5085             if buf_trn-doc.cli-type <> buf_clients.obj-type or buf_trn-doc.cli-code <> buf_clients.obj-code then next .
     5086           end.
     5087           if SelectMngr = 2 then do:
     5088             if buf_trn-doc.agnt = ? or LOOKUP (string(buf_trn-doc.agnt), mngr-list ) = 0 then next .
     5089           end.
     5090           if    buf_trn-doc.ext-doc-type <> 'ee':U
     5091             and buf_trn-doc.ext-doc-type <> 'es':U
     5092             and buf_trn-doc.ext-doc-type <> 're':U
     5093             and buf_trn-doc.ext-doc-type <> 'rs':U
     5094             and buf_trn-doc.ext-doc-type <> 'ie':U
     5095             and buf_trn-doc.ext-doc-type <> 'ep':U
     5096             and buf_trn-doc.ext-doc-type <> 'we':U    then next .
     5097           if buf_trn-doc.ext-doc-type = 'es':U then assign edt = 'ee':U .
     5098           else do:
     5099             if buf_trn-doc.ext-doc-type = 'rs':U then assign edt = 're':U .
     5100             else assign edt = buf_trn-doc.ext-doc-type .
     5101           end.
     5102           assign Counter1 = Counter1 + 1.
