     3887     (output varoutvprbprl
     3888     )  .
     3889   if varoutvprbprl = "base":u then do:
     3890     assign
     3891           road-tax-base-saleprl    =  (if varroad-tax = ? then 0 else varroad-tax * 1)
     3892       excise-base-saleprl      =  (if varexcise   = ? then 0 else varexcise   * 1)
     3893     .
     3894   end.
     3895   else do:
