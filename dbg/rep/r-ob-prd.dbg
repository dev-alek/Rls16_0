     2283           buf_temp-prt-obj.prt-code         = buf_prt-obj.prt-code
     2284           buf_temp-prt-obj.price-sale       = ?
     2285           buf_temp-prt-obj.fact-qnty        = buf_prt-obj.fact-qnty
