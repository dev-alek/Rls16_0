     2395           vss-workfile vss-revision vss-description skip
     2396           vss-include-info20 skip
     2397           "Ошибка задания входных параметров" skip
     2398           "Не найдена строка переоценки" skip
     2399           "Код записи (recid)" p-price-list-recid skip
     2400           view-as alert-box error .
     2401         undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  )   .
     2402       end.
     2403       if buf_main_price-list.main-price <> true
     2404       then do:
     2405         message
     2406           vss-workfile vss-revision vss-description skip
     2407           vss-include-info20 skip
     2408           "Ошибка задания входных параметров" skip
     2409           "Строка переоценки не является основной" skip
     2410           "Код записи (recid)" p-price-list-recid skip
