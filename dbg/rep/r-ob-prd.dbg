     2628               "Переоценка" buf_price-list.doc-num skip
     2629               "Артикул" buf_price-list.artic buf_price-list.prod-type buf_price-list.prod-code skip
     2630               "Бар-код" buf_price-list.b-code skip
     2631               view-as alert-box error .
     2632             undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     2633           end.
     2634           if buf_price-list.doc-qnty <> 0
     2635           then do:
     2636             run prl-vat in this-procedure
     2637               (input  recid(buf_price-list)
     2638               ,output price-rubl-with-tax-sale-prl
     2639               ,output price-base-with-tax-sale-prl
     2640               ,output price-rubl-without-tax-sale-prl
     2641               ,output price-base-without-tax-sale-prl
