     6333   procedure for-each4 :
     6334     do
     6335     on error undo, return error return-value
     6336     :
     6337       for each gds-prop
     6338         break by gds-prop.prod-type
     6339               by gds-prop.prod-code
     6340               by gds-prop.s-ind
     6341               by gds-prop.cli-name
     6342               by if SortType = "sort-code":U   then  gds-prop.b-code Else  gds-prop.artic
     6343               by gds-prop.gds-code :
     6344         if first-of(gds-prop.prod-code) then do:
     6345           find first buf_clients no-lock where buf_clients.obj-type = gds-prop.prod-type and buf_clients.obj-code = gds-prop.prod-code .
     6346           put stream outstream  "|" string("Производитель " + buf_clients.obj-name) format "X(49)" "|" at print-o skip .
