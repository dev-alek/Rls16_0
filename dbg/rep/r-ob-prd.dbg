     1705   function excel-format-dec-to-char returns char (input p-dec as decimal ).
     1706     if num-entries(string(p-dec), '.') = 2
     1707       then return( entry(1, string(p-dec), '.') + v-delim + entry(2, string(p-dec), '.')) .
     1708       else return( string(p-dec)) .
     1709   end function.
     1710   function format-point-to-comma returns char (input orig as char ) .
     1711   define variable rtext as character no-undo .
     1712   define variable strt as integer no-undo .
     1713   define variable leng as integer no-undo .
     1714   assign rtext = orig .
     1715   repeat:
     1716     strt =  index(rtext,'.').
     1717     if strt = 0 then leave.
     1718     leng = 1.
     1719     substring(rtext,strt,leng,"character") = v-delim .
     1720   end.
     1721   return rtext.
     1722   end function.
     1723   function format-excel-text returns char ( input start-text as char ) :
     1724   def var  i    as int no-undo.
     1725   def var  ch   as char no-undo.
     1726   def var  n    as int no-undo.
     1727   def var  ipos as int no-undo.
     1728     n = num-entries(trim(start-text), chr(10)) - 1 .
     1729     do i = 1 to n :
     1730       ipos = index( start-text, chr(10)).
     1731       if ipos > 0 then
     1732         substr( start-text, ipos, 1 ) = ' '.
     1733     end.
     1734     n = num-entries(trim(start-text), chr(13)) - 1 .
     1735     do i = 1 to n :
     1736       ipos = index( start-text, chr(13)).
     1737       if ipos > 0 then
     1738         substr( start-text, ipos, 1 ) = ' '.
     1739     end.
     1740     if index( start-text, '"' ) = 0 then
     1741       start-text =  '="'   + trim( start-text) + '"'   .
     1742       else do:
     1743         n = num-entries(trim(start-text), '"') - 1.
     1744         do i = 1 to n :
     1745           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
     1746         end.
     1747         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
     1748         start-text = '="'  + ch  + '"' .
     1749       end.
     1750     return start-text.
     1751   end.
     1752   function excel-sum returns char (input p-dec as decimal ).
     1753     return(format-excel-text(excel-format-dec-to-char(round(p-dec,2)))) .
     1754   end function.
     1755   function excel-qnty returns char (input p-dec as decimal ).
     1756     return(format-excel-text(excel-format-dec-to-char(round(p-dec,3)))) .
     1757   end function.
     1758   function format-excel-text-macr returns char ( input start-text as char ) :
     1759   def var  i    as int no-undo.
     1760   def var  ch   as char no-undo.
     1761   def var  n    as int no-undo.
     1762   def var  ipos as int no-undo.
     1763     n = num-entries(trim(start-text), chr(10)) - 1 .
     1764     do i = 1 to n :
     1765       ipos = index( start-text, chr(10)).
     1766       if ipos > 0 then
     1767         substring( start-text, ipos , 1 ) = ' '.
     1768     end.
     1769     n = num-entries(trim(start-text), chr(13)) - 1 .
     1770     do i = 1 to n :
     1771       ipos = index( start-text, chr(13)).
     1772       if ipos > 0 then
     1773         substring( start-text, ipos, 1 ) = ' '.
     1774     end.
     1775     if index( start-text, '"' ) = 0 then
     1776       start-text =  '"'   + trim( start-text) + '"'   .
     1777       else do:
     1778         n = num-entries(trim(start-text), '"') - 1.
     1779         do i = 1 to n :
     1780           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
     1781         end.
     1782         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
     1783         start-text = '"'  + ch  + '"' .
     1784       end.
     1785     n = num-entries(trim(start-text), chr(10)) - 1 .
     1786     do i = 1 to n :
     1787       ipos = index( start-text, chr(10)).
     1788       if ipos > 0 then
     1789         substring( start-text, ipos , 1 ) = ' '.
     1790     end.
     1791       if num-entries(trim(start-text), chr(10)) > 1 then  message num-entries(trim(start-text), chr(10)) start-text.
     1792     return start-text.
     1793   end.
