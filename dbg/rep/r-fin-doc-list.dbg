      576   procedure fd-attr-code :
      577     do
      578     on error undo, return error
      579     :
      580       define input  parameter p-code           as character no-undo .
      581       define output parameter p-type           as character no-undo .
      582       define output parameter p-format         as character no-undo .
      583       define output parameter p-label          as character no-undo .
      584       define output parameter p-user-can-edit  as logical   no-undo .
      585       define output parameter p-output-display as logical   no-undo .
      586       define output parameter p-other          as character no-undo .
      587       case p-code :
      588               when 'shift-date':U then do:     assign     p-label = "Дата смены"     p-type = 'T':U      p-format = "99/99/9999"     p-label = "Дата смены"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
      589               when 'shift-num':U then do:     assign     p-label = "П.смены"     p-type = 'I':U      p-format = "99"     p-label = "П.смены"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
      590               when 'shift-name':U then do:     assign     p-label = "№ смены"     p-type = 'C':U      p-format = "X(2)"     p-label = "№ смены"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
      591               when 'barcode':U then do:     assign     p-label = "Штрих-код"     p-type = 'C':U      p-format = "X(20)"     p-label = "Штрих-код"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
      592               when 'lockid':U then do:     assign     p-label = "ID блокировки чека"     p-type = 'C':U      p-format = "X(2)"     p-label = "ID блокировки чека"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
      593               when 'cover_sheet':U then do:     assign     p-label = "Разбиение по номиналам"     p-type = 'C':U      p-format = "X(4000)"     p-label = "Разбиение по номиналам"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
      594               when 'pre-vedom':U then do:     assign     p-label = "Атрибут для препроводительной ведомости"     p-type = 'C':U      p-format = "X(256)"     p-label = "Атрибут для препроводительной ведомости"     p-user-can-edit  = false     p-output-display = false     p-other = '':u      .   end.
      595               when 'contr-kb':U then do:     assign     p-label = "Код кассовой книги получателя\отправителя при перемещении ДС между кассами"     p-type = 'I':U      p-format = ">>>9"     p-label = "Код кассовой книги получателя\отправителя при перемещении ДС между кассами"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
      596         otherwise do:
      597           undo, return error "неизвестный атрибут платежа" + " " + p-code .
      598         end.
      599       end.
      600     end.
      601   end procedure.
      602   procedure fd-attr-tooltip :
      603     do
      604     on error undo, return error
      605     :
      606       define input  parameter p-code    as character no-undo .
      607       define output parameter p-tooltip as character no-undo .
      608       define output parameter p-label   as character no-undo .
      609       case p-code :
      610               when 'shift-date':U then do:     assign     p-tooltip = "Дата смены"     p-label = "Дата смены" .   end.
      611               when 'shift-num':U then do:     assign     p-tooltip = "П.смены"     p-label = "П.смены" .   end.
      612               when 'shift-name':U then do:     assign     p-tooltip = "№ смены"     p-label = "№ смены" .   end.
      613               when 'barcode':U then do:     assign     p-tooltip = "Штрих-код"     p-label = "Штрих-код" .   end.
      614               when 'lockid':U then do:     assign     p-tooltip = "ID блокировки чека"     p-label = "ID блокировки чека" .   end.
      615               when 'cover_sheet':U then do:     assign     p-tooltip = "Разбиение по номиналам"     p-label = "Разбиение по номиналам" .   end.
      616               when 'pre-vedom':U then do:     assign     p-tooltip = "Атрибут для препроводительной ведомости"     p-label = "Атрибут для препроводительной ведомости" .   end.
      617               when 'contr-kb':U then do:     assign     p-tooltip = "Код кассовой книги получателя\отправителя при перемещении ДС между кассами"     p-label = "Код кассовой книги получателя\отправителя при перемещении ДС между кассами" .   end.
      618         otherwise do:
      619           undo, return error "неизвестный атрибут платежа" + " " + p-code .
      620         end.
      621       end.
      622     end.
      623   end procedure.
      624   procedure fin-doc-attr-write :
      625    do
      626    on error undo, return error return-value
      627    :
      628   define input parameter p-host-code     like ub.fin-doc-attr.host-code  no-undo .
      629   define input parameter p-fin-doc-code  like ub.fin-doc-attr.fin-doc-code   no-undo .
      630   define input parameter p-attr-code     like ub.fin-doc-attr.attr-code  no-undo .
      631   define input parameter p-attr-value    like ub.fin-doc-attr.attr-value no-undo .
      632   define variable  v-format         as character no-undo .
      633   define variable  v-label          as character no-undo .
      634   define variable  v-user-can-edit  as logical   no-undo .
      635   define variable  v-output-display as logical   no-undo .
      636   define variable  v-other          as character no-undo .
      637   define variable  v-type           as character no-undo .
      638   define buffer buf_fin-doc-attr for ub.fin-doc-attr.
      639   run fd-attr-code in this-procedure
      640                                     (input  p-attr-code
      641                                     ,output v-type
      642                                     ,output v-format
      643                                     ,output v-label
      644                                     ,output v-user-can-edit
      645                                     ,output v-output-display
      646                                     ,output v-other
      647                                     ) no-error .
      648   if error-status :error then do:
      649     undo, return error return-value .
      650   end.
      651   find first buf_fin-doc-attr  exclusive-lock  where
      652             buf_fin-doc-attr.attr-code    = p-attr-code
      653         AND buf_fin-doc-attr.host-code    = p-host-code
      654         AND buf_fin-doc-attr.fin-doc-code     = p-fin-doc-code  no-error .
      655     if not available  buf_fin-doc-attr then do:
      656         create buf_fin-doc-attr.
      657         assign
      658         buf_fin-doc-attr.attr-code    = p-attr-code
      659         buf_fin-doc-attr.attr-value   = p-attr-value
      660         buf_fin-doc-attr.host-code    = p-host-code
      661         buf_fin-doc-attr.fin-doc-code     = p-fin-doc-code
      662         .
      663     end.
      664     else do:
      665          assign
      666          buf_fin-doc-attr.attr-value = p-attr-value.
      667     end.
      668    end.
      669   end procedure.
      670   procedure fd-attr-exist :
      671     do
      672     on error undo, return error
      673     :
      674       define input parameter p-host-code     like ub.fin-doc-attr.host-code  no-undo .
      675       define input parameter p-fin-doc-code  like ub.fin-doc-attr.fin-doc-code   no-undo .
      676       define input parameter p-code          like ub.fin-doc-attr.attr-code  no-undo .
      677       define output parameter p-exist   as logical  no-undo .
      678       define buffer buf_fin-doc-attr for ub.fin-doc-attr .
      679       define variable  v-type           as character no-undo .
      680       define variable  v-format         as character no-undo .
      681       define variable  v-label          as character no-undo .
      682       define variable  v-user-can-edit  as logical   no-undo .
      683       define variable  v-output-display as logical   no-undo .
      684       define variable  v-other          as character no-undo .
      685       run fd-attr-code in this-procedure
      686         (input  p-code
      687         ,output v-type
      688         ,output v-format
      689         ,output v-label
      690         ,output v-user-can-edit
      691         ,output v-output-display
      692         ,output v-other
      693         ) no-error .
      694       if error-status :error then do:
      695         undo, return error return-value .
      696       end.
      697       find first buf_fin-doc-attr exclusive-lock
      698         where buf_fin-doc-attr.host-code  = p-host-code
      699           and buf_fin-doc-attr.fin-doc-code  = p-fin-doc-code
      700           and buf_fin-doc-attr.attr-code = p-code
      701         no-error .
      702       if  available buf_fin-doc-attr then do:
      703         p-exist = yes.
      704       end.
      705     end.
      706   end procedure.
      707   procedure fd-attr-delete :
      708     do
      709     on error undo, return error
      710     :
      711     define input parameter p-host-code     like ub.fin-doc-attr.host-code  no-undo .
      712     define input parameter p-fin-doc-code  like ub.fin-doc-attr.fin-doc-code   no-undo .
      713     define input parameter p-code          like ub.fin-doc-attr.attr-code  no-undo .
      714     define output parameter p-deleted  as logical no-undo.
      715       define buffer buf_fin-doc-attr for ub.fin-doc-attr .
      716       define variable  v-type           as character no-undo .
      717       define variable  v-format         as character no-undo .
      718       define variable  v-label          as character no-undo .
      719       define variable  v-user-can-edit  as logical   no-undo .
      720       define variable  v-output-display as logical   no-undo .
      721       define variable  v-other          as character no-undo .
      722       run fd-attr-code in this-procedure
      723         (input  p-code
      724         ,output v-type
      725         ,output v-format
      726         ,output v-label
      727         ,output v-user-can-edit
      728         ,output v-output-display
      729         ,output v-other
      730         ) no-error .
      731       if error-status :error then do:
      732         undo, return error return-value .
      733       end.
      734       find first buf_fin-doc-attr exclusive-lock
      735         where buf_fin-doc-attr.host-code  = p-host-code
      736           and buf_fin-doc-attr.fin-doc-code  = p-fin-doc-code
      737           and buf_fin-doc-attr.attr-code = p-code
      738         no-error NO-WAIT.
      739       if not available buf_fin-doc-attr then do:
      740         p-deleted = no.
      741       end.
      742       else do:
      743         delete buf_fin-doc-attr no-error .
      744         if error-status:error then do:
      745           undo, return error return-value .
      746         end.
      747         p-deleted = yes.
      748       end.
      749     end.
      750   end procedure.
