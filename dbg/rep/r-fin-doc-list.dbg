      913   define input parameter p-chip-num      like ub.c-fin-doc-attr.chip-num   no-undo .
      914   define input  parameter p-attr-code    like ub.c-fin-doc-attr.attr-code    no-undo .
      915   define output parameter p-attr-value   like ub.c-fin-doc-attr.attr-value   no-undo .
      916   define variable  v-format         as character no-undo .
      917   define variable  v-label          as character no-undo .
      918   define variable  v-user-can-edit  as logical   no-undo .
      919   define variable  v-output-display as logical   no-undo .
      920   define variable  v-other          as character no-undo .
      921   define variable  v-type           as character no-undo .
      922   define buffer buf_c-fin-doc-attr for ub.c-fin-doc-attr.
      923   run fd-attr-code in this-procedure
      924     (input  p-attr-code
      925     ,output v-type
      926     ,output v-format
      927     ,output v-label
      928     ,output v-user-can-edit
      929     ,output v-output-display
      930     ,output v-other
      931     ) no-error .
      932   if error-status :error then do:
      933     undo, return error return-value .
      934   end.
      935   find first buf_c-fin-doc-attr no-lock where
      936             buf_c-fin-doc-attr.attr-code    = p-attr-code
      937         and buf_c-fin-doc-attr.fin-doc-code      = p-fin-doc-code
      938         and buf_c-fin-doc-attr.host-code      = p-host-code
      939         and buf_c-fin-doc-attr.corr-user-db-num = p-corr-user-db-num
      940         and buf_c-fin-doc-attr.chip-num         > p-chip-num      no-error .
      941     if available  buf_c-fin-doc-attr then do:
      942       assign
      943       p-attr-value = buf_c-fin-doc-attr.attr-value
      944       .
      945     end.
      946     else do:
      947       p-attr-value = ? .
      948     end.
      949    end.
      950   end procedure.
      951   define   shared variable g#auto as logical no-undo.
      952   define   shared variable g#news as logical no-undo.
      953   define   shared variable g#oxml as logical no-undo.
      954   define   shared variable g#esys as logical no-undo.
      955   define   shared variable g#news-source-db as integer no-undo.
      956   define   shared variable g#esys-source-esys as integer no-undo.
      957   define   shared variable g#db-num as integer   no-undo .
      958   define   shared variable g#userid as character no-undo .
      959   define   shared variable g#passwd as character no-undo .
      960   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      961   define new shared stream PrnLibStream.
      962   procedure prn-lib-prn-file :
      963     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      964     define input parameter p-DIsabledoptions as integer no-undo .
      965     define variable v-report-name as character no-undo .
      966     define variable v-user-action as character no-undo .
      967     define variable v-printed     as logical   no-undo .
      968     define variable v-exist       as logical   no-undo .
      969     do
      970       on error undo, return error
      971       :
      972       run prn-lib-get-report-name  in this-procedure (
      973         input parParentProc
      974         ,output v-report-name
      975         ).
      976   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      977   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      978     (input  v-report-name
      979     ,input  2
      980     ,output v-exist
      981     )  .
      982       if NOT v-exist then
      983       DO:
      984         Message
      985           "Нет заданий на печать ! "
      986           view-as alert-box .
      987         Return  .
      988       End.
      989       run gbl/prnfilen.w
      990         (input  ""
      991         ,input  p-DisabledOptions
      992         ,input  string(v-report-name )
      993         ,input  7
      994         ,output v-user-action
      995         ,output v-printed
      996         ) .
      997       if v-printed then
      998       do:
      999         return "YES" .
     1000       end.
     1001       else
     1002       do:
     1003         return "NO" .
     1004       end.
     1005     end.
     1006   end procedure.
     1007   procedure prn-lib-open-stream :
     1008     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1009     define input parameter p-page-size    as integer no-undo .
     1010     define input parameter p-is-stream    as logical no-undo .
     1011     define input parameter p-append       as logical no-undo .
     1012     define variable v-report-name as character no-undo .
     1013     do
     1014       on error undo, return error
     1015       :
     1016       run prn-lib-get-report-name  in this-procedure (
     1017         input parParentProc
     1018         ,output v-report-name
     1019         ).
     1020       if p-is-stream then
     1021       do:
     1022         if p-append then
     1023         do:
     1024           output stream PrnLibStream to value( v-report-name )
     1025             page-size value(p-page-size) append .
     1026         end.
     1027         if not p-append then
     1028         do:
     1029           output stream PrnLibStream to value( v-report-name )
     1030             page-size value(p-page-size) .
     1031         end.
     1032       end.
     1033       if not p-is-stream then
     1034       do:
     1035         if p-append then
     1036         do:
     1037           output to value( v-report-name )
     1038             page-size value(p-page-size) append .
     1039         end.
     1040         if not p-append then
     1041         do:
     1042           output to value( v-report-name )
     1043             page-size value(p-page-size) .
     1044         end.
     1045       end.
     1046     end.
     1047   end procedure.
     1048   procedure prn-lib-open-exp :
     1049     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1050     define input parameter p-is-stream    as logical no-undo .
     1051     define input parameter p-is-append    as logical no-undo .
     1052     define output parameter p-ReportFileName as char init "report" no-undo.
     1053     define output parameter p-process as logical no-undo .
     1054     define variable glog as logical no-undo .
     1055     do
     1056       on error undo, return error
     1057       :
     1058       SYSTEM-DIALOG GET-FILE p-ReportFileName
     1059         TITLE      "Укажите путь"
     1060         FILTERS "Текстовый файл (*.txt)"   "*.txt"
     1061         ASK-OVERWRITE
     1062         CREATE-TEST-FILE
     1063         SAVE-AS
     1064         USE-FILENAME
     1065         DEFAULT-EXTENSION "txt"
     1066         UPDATE glog
     1067         .
     1068       if not glog then  return.
     1069       p-ReportFileName = trim( string( p-ReportFileName ) ) .
     1070       if p-is-stream then
     1071       do:
     1072         if p-is-append then
     1073         do:
     1074           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1075         end.
     1076         else
     1077         do:
     1078           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1079         end.
     1080       end.
     1081       else
     1082       do:
     1083         if p-is-append then
     1084         do:
     1085           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1086         end.
     1087         else
     1088         do:
     1089           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1090         end.
     1091       end.
     1092       p-process = yes.
     1093     end.
     1094   end procedure.
     1095   procedure prn-lib-get-report-name :
     1096     define input parameter parParentProc  as widget-handle no-undo.
     1097     define output parameter p-report-name as character no-undo .
     1098     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
     1099   end procedure.
     1100   procedure prn-lib-reportviewer-report-name :
     1101     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1102     define input parameter p-report-name-html as character no-undo .
     1103     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
     1104   end procedure.
     1105   procedure prn-lib-reportviewer :
     1106     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1107     define input parameter p-report-name-html as character no-undo .
     1108     define input parameter p-param        as character no-undo .
     1109     define variable v-excel           as character no-undo init 'TRUE' .
     1110     define variable v-value-character as character no-undo .
     1111     define variable v-value-integer   as character no-undo .
     1112     define variable v-value-date      as date      no-undo .
     1113     define variable v-value-decimal   as decimal   no-undo .
     1114     define variable rep-excel         as logical   no-undo .
     1115     define variable excel-string      as character no-undo .
     1116     define variable v-param-type      as character no-undo .
     1117     define variable v-tth             as handle    no-undo .
     1118     run adm/shattri.p (
     1119       input "get":U
     1120       ,input  ""
     1121       ,input  0
     1122       ,input  'report-glob':U
     1123       ,input  'rep-excel':U
     1124       ,output v-value-character
     1125       ,output v-value-date
     1126       ,output v-value-decimal
     1127       ,output v-value-integer
     1128       ,output rep-excel
     1129       ,output v-param-type
     1130       ,INPUT-OUTPUT table-handle v-tth
     1131       )  .
     1132     if rep-excel then v-excel = "TRUE" .
     1133     else v-excel = "FALSE" .
     1134     if p-param eq ""
     1135     then
     1136        p-param = "EXCEL:" + v-excel.
     1137     else
     1138        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
     1139     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
     1140   end procedure.
     1141   define temp-table tt-rep no-undo
     1142      field host-code        as integer
     1143      field shift            as character
     1144      field shift-date       as date
     1145      field prn-doc-code     as character
     1146      field receiver         as character
     1147      field receiver-name    as character
     1148      field contract         as character
     1149      field fin-doc-type     as character
     1150      field doc-date         as date
     1151      field fin-ext-doc-type as character
     1152      field perm-date        as date
     1153      field pay-date         as date
     1154      field fact-date        as date
     1155      field del-date         as date
     1156      field status_          as character
     1157      field sum-doc          as decimal
     1158      field payer            as character
     1159      field payer-name       as character
     1160      field curr-abbr        as character
     1161      field obj-info         as character
     1162      field fio              as character
     1163   index pi host-code shift prn-doc-code.
     1164   define temp-table tt-fin-doc-attr no-undo
     1165      field host-code    as integer
     1166      field fin-doc-code as integer
     1167      field shift-date   as date
     1168   index pi host-code fin-doc-code.
     1169   define stream sOutStr-html.
     1170   function fGetContract returns character
     1171     (input iHostCode     as integer,
     1172      input iContractCode as integer):
     1173      define buffer bcontract for contract.
     1174      define variable vPrnCode as character no-undo.
     1175      find first bcontract where
     1176                 bcontract.host-code     = iHostCode
     1177             AND bcontract.contract-code = iContractCode
     1178      no-lock no-error.
     1179      if available bcontract then
     1180         vPrnCode = bcontract.contract-prn-code.
     1181     return vprncode.
     1182   end function.
     1183   function fGetCurrency returns character
     1184      (input iCurrCode as integer):
     1185      define buffer bcurrency for currency.
     1186      define variable vCurrAbbr as character no-undo.
     1187      find first bcurrency where
     1188                 bcurrency.curr-code = iCurrCode
     1189      no-lock no-error.
     1190      if available bcurrency then
     1191         vCurrAbbr = bcurrency.curr-abbr.
     1192      else
     1193         vCurrAbbr = string(iCurrCode).
     1194      return vCurrAbbr.
     1195   end function.
     1196   function fDate2Str returns character
     1197      (input idate as date,
     1198       input iformat as char):
     1199      define variable vdatestr as character no-undo.
     1200      if idate = ? then
     1201         vdatestr = "".
     1202      else
     1203         vdatestr = string(idate, iformat).
     1204      return vdatestr.
     1205   end function.
     1206   function fDec2Str returns character
     1207      (input idec as decimal,
     1208       input iformat as char):
     1209      define variable vdecstr as character no-undo.
     1210      if idec = ? then
     1211         vdecstr = "".
     1212      else
     1213         vdecstr = string(idec, iformat).
     1214      return vdecstr.
     1215   end function.
     1216   function fInt2Str returns character
     1217      (input iInt as integer,
     1218       input iformat as char):
     1219      define variable vIntStr as character no-undo.
     1220      if iInt = ? then
     1221         vIntStr = "".
     1222      else
     1223         vIntStr = string(iInt, iformat).
     1224      return vIntStr.
     1225   end function.
     1226   function fStrNvl returns character
     1227      (input iStr     as character,
     1228       input iDefault as character):
     1229      return if iStr > "" then iStr else iDefault.
     1230   end function.
     1231   run initTT.
     1232   run PrintTT.
     1233   procedure InitTT:
     1234      define buffer fin-doc      for fin-doc.
     1235      define buffer c-fin-doc    for c-fin-doc.
     1236      define buffer fin-doc-attr for fin-doc-attr.
     1237      define buffer user-account for user-account.
     1238      define variable vShift    as character no-undo.
     1239      define variable vI        as int64     no-undo.
     1240      empty temp-table tt-fin-doc-attr.
     1241      empty temp-table tt-rep.
     1242      if x-tog-shift then do:
     1243         vI = vI + 1.
     1244         if X-shift-start = X-shift-end then
     1245            mParamStr[vI] = "Смена: " + string(X-shift-start).
     1246         else
     1247            mParamStr[vI] = "Смены: c " + string(X-shift-start) + " по " + string(X-shift-end).
     1248      end.
     1249      vI = vI + 1.
     1250      if X-date-start = X-date-end then
     1251         mParamStr[vI] = "За дату : " + string(X-date-start, "99.99.9999").
     1252      else
     1253         mParamStr[vI] = "За период c " + string(X-date-start, "99.99.9999") + " по " + string(X-date-end, "99.99.9999").
     1254      vI = vI + 1.
     1255      mParamStr[vI] = "Выбор объекта: ".
     1256      for each obj-list,
     1257         first clients where
     1258               clients.obj-type = obj-list.obj-type
     1259           and clients.obj-code = obj-list.obj-code
     1260      no-lock:
     1261         mParamStr[vI] = mParamStr[vI] + "(" + obj-list.obj-type + string(obj-list.obj-code) + ")"
     1262                                       + clients.obj-name + "," .
     1263      end.
     1264      mParamStr[vI] = trim(mParamStr[vI], ",").
     1265      vI = vI + 1.
     1266      mParamStr[vI] = "По типу документа: " + iDocType.
     1267      vI = vI + 1.
     1268      mParamStr[vI] = "По статусу документа: " + iDocStatus.
     1269      if lookup(iDocStatus, "Все,факт") > 0 then do:
     1270         if x-tog-shift then do:
     1271            for each obj-list,
     1272                each fin-doc where
     1273                     fin-doc.host-code    =  iCntxtHostCodeObj
     1274                 and fin-doc.obj-code     =  obj-list.obj-code
     1275                 and fin-doc.obj-type     =  obj-list.obj-type
     1276                 and fin-doc.shift-date   >= X-date-start
     1277                 and fin-doc.shift-date   <= X-date-end
     1278                 and fin-doc.status_      = "факт"
     1279                 and fin-doc.fin-doc-type = (if iDocType = "Все" then fin-doc.fin-doc-type else iDocType)
     1280            no-lock:
     1281               if (fin-doc.shift-date = X-date-Start and fin-doc.shift-num < x-Shift-Start) or
     1282                  (fin-doc.shift-date = X-date-End   and fin-doc.shift-num > X-Shift-End)
     1283               then
     1284                  next.
     1285               vShift = (if fin-doc.shift-num = integer(fin-doc.shift-name) then
     1286                             fin-doc.shift-name
     1287                          else
     1288                             fin-doc.shift-name + "(" + string(fin-doc.shift-num) + ")").
     1289               run CreateOneRec((buffer fin-doc:handle),
     1290                                vShift,
     1291                                fin-doc.shift-date).
     1292            end.
     1293         end.
     1294         else do:
     1295            for each obj-list,
     1296                each fin-doc where
     1297                     fin-doc.host-code    =  iCntxtHostCodeObj
     1298                 and fin-doc.obj-code     =  obj-list.obj-code
     1299                 and fin-doc.obj-type     =  obj-list.obj-type
     1300                 and fin-doc.doc-date     >= X-date-start
     1301                 and fin-doc.doc-date     <= X-date-end
     1302                 and fin-doc.status_      =  "факт"
     1303                 and fin-doc.fin-doc-type =  (if iDocType = "Все" then fin-doc.fin-doc-type else iDocType)
     1304            no-lock:
     1305               vShift = (if fin-doc.shift-num = integer(fin-doc.shift-name) then
     1306                             fin-doc.shift-name
     1307                          else
     1308                             fin-doc.shift-name + "(" + string(fin-doc.shift-num) + ")").
     1309               run CreateOneRec((buffer fin-doc:handle),
     1310                                vShift,
     1311                                fin-doc.shift-date).
     1312            end.
     1313         end.
     1314      end.
     1315      if lookup(iDocStatus, "Все,Удален") > 0 then do:
     1316         if x-tog-shift then do:
     1317            for each obj-list,
     1318                each c-fin-doc where
     1319                     c-fin-doc.host-code    =  iCntxtHostCodeObj
     1320                 and c-fin-doc.obj-code     =  obj-list.obj-code
     1321                 and c-fin-doc.obj-type     =  obj-list.obj-type
     1322                 and c-fin-doc.shift-date   >= X-date-start
     1323                 and c-fin-doc.shift-date   <= X-date-end
     1324                 and c-fin-doc.status_      =  "факт"
     1325                 and c-fin-doc.is-del       =  yes
     1326                 and c-fin-doc.fin-doc-type =  (if iDocType = "Все" then c-fin-doc.fin-doc-type else iDocType)
     1327            no-lock:
     1328               if (c-fin-doc.shift-date = X-date-Start and c-fin-doc.shift-num < x-Shift-Start) or
     1329                  (c-fin-doc.shift-date = X-date-End   and c-fin-doc.shift-num > X-Shift-End)
     1330               then
     1331                  next.
     1332               vShift = (if c-fin-doc.shift-num = integer(c-fin-doc.shift-name) then
     1333                             c-fin-doc.shift-name
     1334                          else
     1335                             c-fin-doc.shift-name + "(" + string(c-fin-doc.shift-num) + ")").
     1336               run CreateOneRec((buffer c-fin-doc:handle),
     1337                                vShift,
     1338                                c-fin-doc.shift-date).
     1339            end.
     1340         end.
     1341         else do:
     1342            for each obj-list,
     1343                each c-fin-doc where
     1344                     c-fin-doc.host-code    =  iCntxtHostCodeObj
     1345                 and c-fin-doc.obj-code     =  obj-list.obj-code
     1346                 and c-fin-doc.obj-type     =  obj-list.obj-type
     1347                 and c-fin-doc.doc-date     >= X-date-start
     1348                 and c-fin-doc.doc-date     <= X-date-end
     1349                 and c-fin-doc.status_      =  "факт"
     1350                 and c-fin-doc.is-del       =  yes
     1351                 and c-fin-doc.fin-doc-type =  (if iDocType = "Все" then c-fin-doc.fin-doc-type else iDocType)
     1352            no-lock:
     1353               vShift = (if c-fin-doc.shift-num = integer(c-fin-doc.shift-name) then
     1354                             c-fin-doc.shift-name
     1355                          else
     1356                             c-fin-doc.shift-name + "(" + string(c-fin-doc.shift-num) + ")").
     1357               run CreateOneRec((buffer c-fin-doc:handle),
     1358                                vShift,
     1359                                c-fin-doc.shift-date).
     1360            end.
     1361         end.
     1362      end.
     1363   end procedure.
     1364   procedure CreateOneRec:
     1365      define input parameter iBuffHandle as handle    no-undo.
     1366      define input parameter iShift      as character no-undo.
     1367      define input parameter iShiftDate  as date      no-undo.
     1368      define buffer user-account for user-account.
     1369      define variable vReceiver as character no-undo.
     1370      define variable vPayer    as character no-undo.
     1371      define variable vObjInfo  as character no-undo.
     1372      define variable vContract as character no-undo.
     1373      define variable vCurrAbbr as character no-undo.
     1374      define variable vFio      as character no-undo.
     1375      do:
     1376         assign
     1377            vReceiver = iBuffHandle::receiver-type + string(iBuffHandle::receiver-code)
     1378            vPayer    = iBuffHandle::payer-type + string(iBuffHandle::payer-code)
     1379            vObjInfo  = if iBuffHandle::obj-code > 0 then
     1380                           iBuffHandle::obj-type + string(iBuffHandle::obj-code)
     1381                        else ""
     1382            .
     1383         vContract = fGetContract(iBuffHandle::host-code,
     1384                                  iBuffHandle::contract-code).
     1385         vCurrAbbr = fGetCurrency(iBuffHandle::curr-code).
     1386         find first user-account where
     1387                    user-account.user-id = iBuffHandle:buffer-field(if iBuffHandle:table = "fin-doc" then
     1388                                                                       "user-name-doc"
     1389                                                                    else
     1390                                                                       "corr-user-name"):buffer-value
     1391         no-lock no-error .
     1392         if avail user-account then
     1393            vFio = trim(user-account.last-name  + " " +
     1394                        user-account.first-name + " " +
     1395                        user-account.second-name).
     1396         create tt-rep.
     1397         assign
     1398            tt-rep.host-code        = iBuffHandle::host-code
     1399            tt-rep.shift            = iShift
     1400            tt-rep.shift-date       = iShiftDate
     1401            tt-rep.prn-doc-code     = iBuffHandle::prn-doc-code
     1402            tt-rep.receiver         = vReceiver
     1403            tt-rep.receiver-name    = iBuffHandle::receiver-name
     1404            tt-rep.contract         = vContract
     1405            tt-rep.fin-doc-type     = iBuffHandle::fin-doc-type
     1406            tt-rep.doc-date         = iBuffHandle::doc-date
     1407            tt-rep.fin-ext-doc-type = iBuffHandle::fin-ext-doc-type
     1408            tt-rep.perm-date        = iBuffHandle::perm-date
     1409            tt-rep.pay-date         = iBuffHandle::pay-date
     1410            tt-rep.fact-date        = iBuffHandle::fact-date
     1411            tt-rep.del-date         = (if iBuffHandle:table = "c-fin-doc" then iBuffHandle:buffer-field("corr-date"):buffer-value else ?)
     1412            tt-rep.status_          = (if iBuffHandle:table = "c-fin-doc" then "удален" else iBuffHandle::status_)
     1413            tt-rep.sum-doc          = iBuffHandle::sum-doc
     1414            tt-rep.payer            = vPayer
     1415            tt-rep.payer-name       = iBuffHandle::payer-name
     1416            tt-rep.curr-abbr        = vCurrAbbr
     1417            tt-rep.obj-info         = vObjInfo
     1418            tt-rep.fio              = vFio
     1419            .
     1420      end.
     1421   end procedure.
     1422   procedure PrintTT:
     1423      define variable vReportId    as character no-undo.
     1424      define variable vFileNameRep as character no-undo.
     1425      define variable vSumDocStr   as character no-undo.
     1426      define variable vI           as int64     no-undo.
     1427      do on error undo, return error return-value:
     1428         run get-report-num(output vReportId).
     1429         vFileNameRep = session:temp-directory + string(vReportId) + ".html".
     1430         output stream sOutStr-html to value(vFileNameRep) convert target 'UTF-8'.
     1431         put stream sOutStr-html unformatted
     1432            "<!DOCTYPE HTML>" skip
     1433               ' <html>' skip
     1434               '  <head>' skip
     1435               '   <meta charset="utf-8">' skip
     1436               '    <style type="text/css">' skip
     1437               '      table ' + chr(123) + ' border-collapse: collapse; ' + chr(125) skip
     1438               '      .class1 ' + chr(123) + ' border-collapse: collapse; ' + chr(125) skip
     1439               '      tbody td, th ' + chr(123) + ' border-collapse: collapse; border: 1px solid black; height: 14px;' + chr(125) skip
     1440               '   </style>' skip
     1441               '  </head>' skip
     1442            .
     1443         put stream sOutStr-html unformatted
     1444              '<body>' skip
     1445              '<TABLE name="1"  fit_to_page="true" orientation="landscape" CELLSPACING="0" BORDER="0">' skip
     1446              '<thead>' skip
     1447              '<TR class="set_columns">' skip
     1448                  '<TD style="width:  50px;"></TD>' skip
     1449                  '<TD style="width:  50px;"></TD>' skip
     1450                  '<TD style="width:  80px;"></TD>' skip
     1451                  '<TD style="width: 100px;"></TD>' skip
     1452                  '<TD style="width: 100px;"></TD>' skip
     1453                  '<TD style="width: 150px;"></TD>' skip
     1454                  '<TD style="width:  80px;"></TD>' skip
     1455                  '<TD style="width:  45px;"></TD>' skip
     1456                  '<TD style="width:  80px;"></TD>' skip
     1457                  '<TD style="width:  45px;"></TD>' skip
     1458                  '<TD style="width:  80px;"></TD>' skip
     1459                  '<TD style="width:  80px;"></TD>' skip
     1460                  '<TD style="width:  80px;"></TD>' skip
     1461                  '<TD style="width:  80px;"></TD>' skip
     1462                  '<TD style="width:  50px;"></TD>' skip
     1463                  '<TD style="width:  80px;"></TD>' skip
     1464                  '<TD style="width: 100px;"></TD>' skip
     1465                  '<TD style="width: 150px;"></TD>' skip
     1466                  '<TD style="width:  30px;"></TD>' skip
     1467                  '<TD style="width:  60px;"></TD>' skip
     1468                  '<TD style="width: 100px;"></TD>' skip
     1469              '</TR>' skip
     1470              '<TR>' skip
     1471                  '<TD colspan="12" STYLE="font-size: 14px;">' + 'СПИСОК КАССОВЫХ ДОКУМЕНТОВ' + '</TD>'skip
     1472              '</TR>' skip.
     1473         do vI = 1 to extent(mParamStr):
     1474            if mParamStr[vI] = "" then leave.
     1475            put stream sOutStr-html unformatted
     1476                 '<TR>' skip
     1477                     '<TD colspan="12" STYLE="font-size: 14px;">' + mParamStr[vI] + '</TD>' skip
     1478                 '</TR>' skip
     1479               .
     1480         end.
     1481         put stream sOutStr-html unformatted
     1482              '<TR>' skip
     1483                  '<TD colspan="12" STYLE="font-size: 14px;">Дата печати: ' + string(today, "99.99.9999") + ' ' + string(time, "HH:MM") + '</TD>' skip
     1484              '</TR>' skip
     1485              '</thead>' skip
     1486            .
     1487         put stream sOutStr-html unformatted
     1488            '<tbody>'
     1489            '<TR>'skip
     1490               '<TH style="text-align: center;">Код фирмы</TH>' skip
     1491               '<TH style="text-align: center;">Номер смены</TH>' skip
     1492               '<TH style="text-align: center;">Дата смены</TH>' skip
     1493               '<TH style="text-align: center;">Номер документа </TH>' skip
     1494               '<TH style="text-align: center;">Получатель</TH>' skip
     1495               '<TH style="text-align: center;">Название получателя</TH>' skip
     1496               '<TH style="text-align: center;">Договор</TH>' skip
     1497               '<TH style="text-align: center;">Тип доку мента</TH>' skip
     1498               '<TH style="text-align: center;">Дата документа</TH>' skip
     1499               '<TH style="text-align: center;">Расш. тип доку мента    </TH>' skip
     1500               '<TH style="text-align: center;">Дата разр</TH>' skip
     1501               '<TH style="text-align: center;">Дата прин банком</TH>' skip
     1502               '<TH style="text-align: center;">Дата факт</TH>' skip
     1503               '<TH style="text-align: center;">Дата удаления документа</TH>' skip
     1504               '<TH style="text-align: center;">Статус</TH>' skip
     1505               '<TH style="text-align: center;">Сумма</TH>' skip
     1506               '<TH style="text-align: center;">Плательщик</TH>' skip
     1507               '<TH style="text-align: center;">Название плательщика</TH>' skip
     1508               '<TH style="text-align: center;">Вал</TH>' skip
     1509               '<TH style="text-align: center;">Объект</TH>' skip
     1510               '<TH style="text-align: center;">Пользователь</TH>' skip
     1511            '</TR>'skip
     1512            .
     1513         for each tt-rep:
     1514            vSumDocStr = fDec2Str(tt-rep.sum-doc, "->>>>>>>>>>>9.99").
     1515            put stream sOutStr-html unformatted
     1516               '<TR>' skip
     1517                   '<TD style="text-align: right"> ' + fInt2Str(tt-rep.host-code, "999999999")         + '</TD>' skip
     1518                   '<TD style="text-align: right"> ' + fStrNvl(tt-rep.shift, "")                       + '</TD>' skip
     1519                   '<TD style="text-align: left"> '  + fdate2str(tt-rep.shift-date, "99.99.9999")      + '</TD>' skip
     1520                   '<TD style="text-align: left"> '  + fStrNvl(tt-rep.prn-doc-code, "")                + '</TD>' skip
     1521                   '<TD style="text-align: left"> '  + fStrNvl(tt-rep.receiver, "")                    + '</TD>' skip
     1522                   '<TD style="text-align: left"> '  + fStrNvl(tt-rep.receiver-name, "")               + '</TD>' skip
     1523                   '<TD style="text-align: left"> '  + fStrNvl(tt-rep.contract, "")                    + '</TD>' skip
     1524                   '<TD style="text-align: left"> '  + fStrNvl(tt-rep.fin-doc-type, "")                + '</TD>' skip
     1525                   '<TD style="text-align: left"> '  + fdate2str(tt-rep.doc-date,  "99.99.9999")       + '</TD>' skip
     1526                   '<TD style="text-align: left"> '  + fStrNvl(tt-rep.fin-ext-doc-type, "")            + '</TD>' skip
     1527                   '<TD style="text-align: left"> '  + fdate2str(tt-rep.perm-date, "99.99.9999")       + '</TD>' skip
     1528                   '<TD style="text-align: left"> '  + fdate2str(tt-rep.pay-date,  "99.99.9999")       + '</TD>' skip
     1529                   '<TD style="text-align: left"> '  + fdate2str(tt-rep.fact-date, "99.99.9999")       + '</TD>' skip
     1530                   '<TD style="text-align: left"> '  + fdate2str(tt-rep.del-date,  "99.99.9999")       + '</TD>' skip
     1531                   '<TD style="text-align: left"> '  + fStrNvl(tt-rep.status_, "")                     + '</TD>' skip
     1532                   '<TD num="#,##0.00" val="'           + vSumDocStr + '" style="text-align: right"> ' + vSumDocStr + '</TD>' skip
     1533                   '<TD style="text-align: left"> '  + fStrNvl(tt-rep.payer, "")                       + '</TD>' skip
     1534                   '<TD style="text-align: left"> '  + fStrNvl(tt-rep.payer-name, "")                  + '</TD>' skip
     1535                   '<TD style="text-align: left"> '  + fStrNvl(tt-rep.curr-abbr, "")                   + '</TD>' skip
     1536                   '<TD style="text-align: left"> '  + fStrNvl(tt-rep.obj-info, "")                    + '</TD>' skip
     1537                   '<TD text_wrap="true" style="text-align: left"> '  + fStrNvl(tt-rep.fio, "")        + '</TD>' skip
     1538               '</TR>' skip.
     1539         end.
     1540         put stream sOutStr-html unformatted
     1541            '</tbody>' skip
     1542            '</table>' skip
     1543            '</body>' skip
     1544            '</html>' skip
     1545            .
     1546         output stream sOutStr-html close.
     1547         run prn-lib-reportviewer-report-name in this-procedure (
     1548             input parparentproc
     1549             ,input vFileNameRep
     1550             ) no-error.
     1551         if error-status:error then
     1552         do:
     1553             message "error-status:error = " error-status:error skip return-value view-as alert-box.
     1554             return .
     1555         end.
     1556      end.
     1557   end procedure.
     1558   PROCEDURE get-report-num :
     1559   define output parameter p-report-num as integer no-undo .
     1560     do
     1561     on error undo, return error return-value
     1562     :
     1563       run gbl/getrpnum.p (output p-report-num).
     1564     end.
     1565   END PROCEDURE.
