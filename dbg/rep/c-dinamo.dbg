     1062   procedure prn-lib-prn-file :
     1063     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1064     define input parameter p-DIsabledoptions as integer no-undo .
     1065     define variable v-report-name as character no-undo .
     1066     define variable v-user-action as character no-undo .
     1067     define variable v-printed     as logical   no-undo .
     1068     define variable v-exist       as logical   no-undo .
     1069     do
     1070       on error undo, return error
     1071       :
