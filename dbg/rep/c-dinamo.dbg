     1579   b-a descending
     1580   .
     1581   define shared temp-table t-stk no-undo
     1582   field month_ as integer
     1583   field year_ as integer
     1584   field ym as integer
     1585   field b-a as integer
     1586   field b-a-full as character
     1587   field fact-qnty like ub.stk-line.fact-qnty
     1588   field sale-sum-rubl like ub.stk-line.sum-rubl
     1589   field sale-sum-base like ub.stk-line.sum-base
     1590   field cost-sum-rubl like ub.stk-line.sum-rubl
     1591   field cost-sum-base like ub.stk-line.sum-base
     1592   index pi is unique primary
     1593   ym
     1594   b-a
     1595   .
     1596   define shared temp-table t-fo0 no-undo
     1597   field obj-type like ub.clients.obj-type
     1598   field obj-code like ub.clients.obj-code
     1599   field fact-order like ub.stk-line.fact-order
     1600   field cfact-date as date
     1601   field ym as integer
     1602   index pi is unique primary
     1603   obj-type
     1604   obj-code
     1605   fact-order
     1606   .
     1607   FUNCTION get-doc-type RETURNS CHARACTER
     1608     ( input p-ii as integer, input-output p-ext-doc-type as character, input-output p-sign as character, output p-ext-doc-type-full as character, output p-doc-type-full as character, output p-idoc-type as character ) :
     1609   DEFINE VARIABLE v-doc-type as character no-undo .
     1610   assign
     1611   p-ext-doc-type-full = entry(p-ii, 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U)
     1612   .
     1613     CASE p-ext-doc-type:
     1614       when 'ie':U
     1615    or when 'iv':U
     1616    or when 'im':U
     1617    then do:
     1618         assign
     1619         v-doc-type = 'при':U
     1620         p-doc-type-full = "Приход"
     1621         p-idoc-type = string(1)
     1622         p-sign = string(0)
     1623         .
     1624       end.
     1625       when 'ee':U
     1626    or when 'es':U
     1627    or when 'we':U
     1628    or when 'ep':U
     1629    or when 'ev':U
     1630    or when 'wm':U then do:
     1631         assign
     1632         v-doc-type = 'рас':U
     1633         p-doc-type-full = "Расход"
     1634         p-idoc-type  = string(2)
     1635         p-sign = string(0)
     1636         .
     1637       end.
     1638       when 're':U
     1639    or when 'rs':U
     1640    or when 'rv':U then do:
     1641         assign
     1642         v-doc-type = 'возврат':U
     1643         p-doc-type-full = "Возврат"
     1644         p-idoc-type = string(3)
     1645         p-sign = string(0)
     1646         .
     1647       end.
     1648       when 'ap':U then do:
     1649         assign
     1650         v-doc-type = 'ap':U
     1651         p-doc-type-full = "Переоц.уч.цен"
     1652         p-idoc-type = string(6)
     1653         p-sign = string(0)
     1654         .
     1655       end.
     1656       when 'pc':U then do:
     1657         assign
     1658         v-doc-type = 'pc':U
     1659         p-doc-type-full = "Смена типа приобр."
     1660         p-idoc-type = string( 5)
     1661         p-sign = string(0)
     1662         .
     1663       end.
     1664       when 'ot':U then do:
     1665         assign
     1666         v-doc-type = 'ot':U
     1667         p-doc-type-full = "Переоценка"
     1668         p-idoc-type = string(4)
     1669         p-sign = string(0)
     1670        .
     1671       end.
     1672       when 'vt':U      or
     1673       when 'vp':U then do:
     1674         CASE p-sign:
     1675           when string(0) then do:
     1676             assign
     1677             p-ext-doc-type = p-ext-doc-type + chr(44) + p-ext-doc-type
     1678             v-doc-type = 'рас':U + chr(44) + 'при':U
     1679             p-doc-type-full = "Расход" + chr(44) + "Приход"
     1680             p-ext-doc-type-full = p-ext-doc-type-full + "(-)":U + chr(44) + p-ext-doc-type-full + "(+)":U
     1681             p-idoc-type = string(2) + chr(44) + string(1)
     1682             p-sign = string(-1) + chr(44) + string( 1)
     1683             .
     1684           end.
     1685           when string(- 1) then do:
     1686             assign
     1687             v-doc-type = 'рас':U
     1688             p-doc-type-full = "Расход"
     1689             p-ext-doc-type-full = p-ext-doc-type-full + "(-)":U
     1690             p-idoc-type = string(2)
     1691             p-sign = string( - 1)
     1692             .
     1693           end.
     1694           when string(1) then do:
     1695             assign
     1696             v-doc-type = 'при':U
     1697             p-doc-type-full = "Приход"
     1698             p-ext-doc-type-full = p-ext-doc-type-full + "(+)":U
     1699             p-idoc-type =  string(1)
     1700             p-sign = string(1)
     1701             .
     1702           end.
     1703         END CASE.
     1704       end.
     1705       when 'em':U then do:
     1706         assign
     1707         v-doc-type = "":U
     1708         p-doc-type-full = ""
     1709         p-idoc-type = string( 0)
     1710         p-sign = string(0)
     1711         .
     1712       end.
     1713     END CASE.
     1714     RETURN v-doc-type.
     1715   END FUNCTION.
     1716   procedure proc-view-objects :
     1717   DEFINE VARIABLE v-attr-codes as character no-undo .
     1718   DEFINE VARIABLE v-attr-labels as character no-undo .
     1719   DEFINE VARIABLE v-output as character no-undo .
     1720     do
     1721     on error undo, return error
     1722     :
     1723       for each obj-list no-lock,
     1724           first t-fo0 no-lock where
     1725                t-fo0.obj-type = obj-list.obj-type
     1726            AND t-fo0.obj-code = obj-list.obj-code
     1727           :
     1728         assign
     1729         v-attr-codes = v-attr-codes + obj-list.obj-type + string(obj-list.obj-code) + chr(44)
     1730         v-attr-labels = v-attr-labels + obj-list.obj-type + string(obj-list.obj-code) + fill( chr(32), 5) +
     1731                         "Данные c" + chr(32) + string(t-fo0.cfact-date, "99/99/9999") + chr(44)
     1732         .
     1733       end.
     1734       assign
     1735       v-attr-codes = right-trim(v-attr-codes, chr(44))
     1736       v-attr-labels = right-trim(v-attr-labels, chr(44))
     1737       .
     1738       run gbl/d-list.w (
     1739                     input "":U
     1740                    ,input "Объекты, выбранные для показа динамики товара"
     1741                    ,input v-attr-codes
     1742                    ,input v-attr-labels
     1743                    ,input chr(44)
     1744                    ,input "":U
     1745                    ,output v-output).
     1746     end.
     1747   end procedure.
     1748   procedure proc-print-oborot :
     1749   define input parameter p-artic like ub.goods.artic no-undo .
     1750   define input parameter p-prod-type like ub.goods.prod-type no-undo .
     1751   define input parameter p-prod-code like ub.goods.prod-code no-undo .
     1752   define input parameter p-date-start as date no-undo .
     1753   define input parameter p-date-end as date no-undo .
     1754   DEFINE VARIABLE v-attr-codes as character no-undo .
     1755   DEFINE VARIABLE v-attr-labels as character no-undo .
     1756   DEFINE VARIABLE v-output as character no-undo .
     1757   DEFINE VARIABLE v-obj-type like ub.clients.obj-type no-undo .
     1758   DEFINE VARIABLE v-obj-code like ub.clients.obj-code no-undo .
     1759     do
     1760     on error undo, return error
     1761     :
     1762       for each obj-list no-lock:
     1763         assign
     1764         v-attr-codes = v-attr-codes + obj-list.obj-type + string(obj-list.obj-code) + chr(44).
     1765       end.
     1766       assign
     1767       v-attr-codes = right-trim(v-attr-codes, chr(44))
     1768       .
     1769       if num-entries(v-attr-codes) <> 1 then do:
     1770         run gbl/d-list.w (
     1771                       input "b-sel":U
     1772                     ,input "Выберите объект для печати оборотной ведомости"
     1773                     ,input v-attr-codes
     1774                     ,input v-attr-codes
     1775                     ,input chr(44)
     1776                     ,input "":U
     1777                     ,output v-output).
     1778         if v-output = "":U then return.
     1779         assign
     1780         v-obj-type = substr(v-output, 1, 3)
     1781         v-obj-code = integer(substr(v-output, 4))
     1782         .
     1783       end.
     1784       else do:
     1785         assign
     1786         v-obj-type = substr(v-attr-codes, 1, 3)
     1787         v-obj-code = integer(substr(v-attr-codes, 4))
     1788         .
     1789       end.
     1790       run rep/e-good2.w (parParentProc,
     1791                     p-artic,
     1792                     p-prod-type,
     1793                     p-prod-code,
     1794                     p-date-start,
     1795                     p-date-end,
     1796                     v-obj-type,
     1797                     v-obj-code
     1798                       ) no-error.
     1799     end.
     1800   end procedure.
     1801   procedure proc-print-crd :
     1802   define input parameter p-artic like ub.goods.artic no-undo .
     1803   define input parameter p-prod-type like ub.goods.prod-type no-undo .
     1804   define input parameter p-prod-code like ub.goods.prod-code no-undo .
     1805   define input parameter p-date-start as date no-undo .
     1806   define input parameter p-date-end as date no-undo .
     1807   DEFINE VARIABLE v-attr-codes as character no-undo .
     1808   DEFINE VARIABLE v-attr-labels as character no-undo .
     1809   DEFINE VARIABLE v-output as character no-undo .
     1810   DEFINE VARIABLE v-obj-type like ub.clients.obj-type no-undo .
     1811   DEFINE VARIABLE v-obj-code like ub.clients.obj-code no-undo .
     1812     do
     1813     on error undo, return error
     1814     :
     1815       for each obj-list no-lock:
     1816         assign
     1817         v-attr-codes = v-attr-codes + obj-list.obj-type + string(obj-list.obj-code) + chr(44).
     1818       end.
     1819       assign
     1820       v-attr-codes = right-trim(v-attr-codes, chr(44))
     1821       .
     1822       if num-entries(v-attr-codes) <> 1 then do:
     1823         run gbl/d-list.w (
     1824                      input "b-sel":U
     1825                     ,input "Выберите объект для печати карточки товара"
     1826                     ,input v-attr-codes
     1827                     ,input v-attr-codes
     1828                     ,input chr(44)
     1829                     ,input "":U
     1830                     ,output v-output).
     1831         if v-output = "":U then return.
     1832         assign
     1833         v-obj-type = substr(v-output, 1, 3)
     1834         v-obj-code = integer(substr(v-output, 4))
     1835         .
     1836       end.
     1837       else do:
     1838         assign
     1839         v-obj-type = substr(v-attr-codes, 1, 3)
     1840         v-obj-code = integer(substr(v-attr-codes, 4))
     1841         .
     1842       end.
     1843       run rep/g-gdscrd.p (parParentProc,
     1844                     p-artic,
     1845                     p-prod-type,
     1846                     p-prod-code,
     1847                     p-date-start,
     1848                     p-date-end,
     1849                     v-obj-type,
     1850                     v-obj-code
     1851                       ) no-error.
     1852     end.
     1853   end procedure.
     1854   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1855   define variable v-waitfram-action01         as character   no-undo .
     1856   define variable v-waitfram-action02         as character   no-undo .
     1857   define variable v-waitfram-action03         as character   no-undo .
     1858   define variable mWaitFramTextBeg            as character   no-undo.
     1859   define variable mWaitFramTextEnd            as character   no-undo.
     1860   define variable mWaitFramView               as logical     no-undo.
     1861   define variable mWaitProcEvent              as logical     no-undo init yes.
     1862   define variable mWaitFramInterval           as integer     no-undo init 1 .
     1863   define variable mWaitFramStop               as logical     no-undo.
     1864   define variable mWaitFramStopUser           as logical     no-undo.
     1865   define variable mWaitFramStopTimeOut        as logical     no-undo.
     1866   define variable mWaitFramStartProc          as datetime-tz no-undo.
     1867   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     1868   define button B-WaitFramStop auto-end-key
     1869        label "Стоп"
     1870        size 10 by 1 tooltip "Остоновить процесс".
     1871   define button B-viewProcInfo
     1872        label "Информация"
     1873        size 15 by 1 tooltip "Информация о процесс".
     1874   define frame waitfram
     1875     v-waitfram-action01 format "x(72)" no-label skip
     1876     v-waitfram-action02 format "x(72)" no-label skip
     1877     v-waitfram-action03 format "x(72)" no-label skip
     1878     B-viewProcInfo
     1879     B-WaitFramStop at row 4 col 30
     1880     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1881     .
     1882   define new global shared variable mBatchMode as logical no-undo init ?.
     1883   define variable mFramBachModHandle as handle no-undo.
     1884   mFramBachModHandle = frame waitfram:handle.
     1885   define variable mFameOldVis as logical no-undo.
     1886   define variable mVisCUrentVin as logical no-undo.
     1887   if session:batch-mode
     1888   then
     1889      mBatchMode = yes.
     1890   if mBatchMode = ? then do:
     1891     mVisCUrentVin = current-window:visible.
     1892     mFameOldVis = mFramBachModHandle:visible.
     1893     mFramBachModHandle:visible  = yes.
     1894     mBatchMode = mFramBachModHandle:visible ne yes.
     1895     mFramBachModHandle:visible = mFameOldVis.
     1896     current-window:visible = mVisCUrentVin.
     1897   end.
     1898    if  log-manager:logfile-name ne ?
     1899     then DO:
     1900         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1901         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1902         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1903     end.
     1904   on choose of B-WaitFramStop in frame waitfram
     1905   do:
     1906     mWaitFramStop = yes.
     1907     mWaitFramStopUser = yes.
     1908   end.
     1909   function waitfram-check-timeout returns logical():
     1910      define variable vtime as int64 no-undo.
     1911      if mWaitFramStopTimeOut
     1912      then
     1913         return yes.
     1914      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1915      if     mWaitFramTimeOut ne ?
     1916         and mWaitFramTimeOut ne 0
     1917         and mWaitFramTimeOut lt vtime
     1918      then do:
     1919         mWaitFramStopTimeOut = yes.
     1920      end.
     1921      return mWaitFramStopTimeOut.
     1922   end.
     1923   procedure waitfram-hide :
     1924     if not session:batch-mode
     1925     then do
     1926     on error undo, return error return-value
     1927     :
     1928       pause 0 before-hide .
     1929       if not mBatchMode then
     1930         hide frame waitfram .
     1931     if     not mWaitFramView
     1932        and mWaitProcEvent
     1933     then
     1934       process events .
     1935     end.
     1936   end procedure.
     1937   procedure waitfram-show :
     1938     define input  parameter p-message as character no-undo .
     1939     define variable v-left-margin as integer   no-undo .
     1940     if not session:batch-mode
     1941     then do
     1942     on error undo, return error return-value
     1943     :
     1944       if length(p-message) <= 70 then do:
     1945         assign
     1946           v-left-margin = integer((70 - length(p-message)) / 2)
     1947         .
     1948         assign
     1949           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1950         .
     1951         assign
     1952           v-waitfram-action01 = " "
     1953           v-waitfram-action02 = " "
     1954                                    + fill(" ", v-left-margin)
     1955                                    + p-message
     1956           v-waitfram-action03 = " "
     1957         .
     1958       end.
     1959       else do:
     1960         define variable vRindex1 as integer no-undo.
     1961         define variable vRindex2 as integer no-undo.
     1962         vRindex1 = r-index(p-message," ",70).
     1963         if vRindex1 = 0
     1964         then
     1965            vRindex1 = 70.
     1966         if length(p-message)  <= vRindex1 + 70 then do:
     1967           assign
     1968             v-waitfram-action01 = " "
     1969             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1970             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1971           .
     1972         end.
     1973         else do:
     1974           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1975           if vRindex2 <= vRindex1
     1976           then
     1977              vRindex2 = vRindex1 + 70.
     1978           assign
     1979             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1980             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1981             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1982           .
     1983         end.
     1984       end.
     1985       B-viewProcInfo:visible   in frame waitfram = no.
     1986       B-viewProcInfo:sensitive in frame waitfram = no.
     1987       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1988       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1989       if  (   mWaitFramView
     1990          or  mWaitProcEvent)
     1991          and not mBatchMode
     1992       then
     1993          display
     1994             v-waitfram-action01 skip
     1995             v-waitfram-action02 skip
     1996             v-waitfram-action03 skip
     1997          with frame waitfram .
     1998       if     mWaitFramView
     1999          then do:
     2000             if     mWaitFramInterval ne ?
     2001                and not mBatchMode
     2002             then
     2003                wait-for go of frame waitfram pause mWaitFramInterval.
     2004          end.
     2005          else
     2006             if     mWaitProcEvent
     2007                and not mBatchMode
     2008             then
     2009                process events .
     2010     end.
     2011   end procedure.
     2012      procedure waitfram-show-this:
     2013         define input  parameter iInterval as int64 no-undo.
     2014         define variable vtime as int64 no-undo.
     2015         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     2016         mWaitFramInterval = iInterval.
     2017         run waitfram-show (substitute("&1&2 &3&4" ,
     2018                                       mWaitFramTextBeg ,
     2019                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     2020                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     2021                                       mWaitFramTextEnd
     2022                                      )
     2023                           ).
     2024      end.
     2025      procedure WaitFramRunPause:
     2026         define input  parameter iInterval as dec no-undo.
     2027         define variable vStart  as datetime-tz no-undo.
     2028         define variable vend    as datetime-tz no-undo.
     2029         define variable vint as int64 no-undo.
     2030         define variable vOk as logical no-undo.
     2031         vStart = now.
     2032         vend   = vStart.
     2033         publish "WaitFramPause" (iInterval,output vOk).
     2034         vend   =  now.
     2035         vint = vend - vStart.
     2036         vint = iInterval - vint / 1000.
     2037         if     not mWaitFramStop
     2038            and (   vint > 0
     2039                 or (    not vOk
     2040                     and iInterval eq ?
     2041                     )
     2042                 )
     2043         then
     2044            run waitfram-show-this (iInterval).
     2045         vend   =  now.
     2046         vint = vend - vStart.
     2047         vint = iInterval - vint / 1000.
     2048         if     not mWaitFramStop
     2049            and vint > 0
     2050         then do:
     2051            run gbl/pause.p (vint * 1000).
     2052         end.
     2053         if iInterval ne ?
     2054         then
     2055            publish "WaitFramStop".
     2056         waitfram-check-timeout().
     2057      end.
     2058      procedure WaitFramWaitFor:
     2059         define input  parameter iInterval as dec no-undo.
     2060         assign
     2061            mWaitFramStartProc   = now
     2062            mWaitFramStopUser    = no
     2063            mWaitFramStopTimeOut = no
     2064         .
     2065         block-wait:
     2066         do while not mWaitFramStop:
     2067            run WaitFramRunPause (iInterval).
     2068            if  waitfram-check-timeout()
     2069            then do:
     2070               leave block-wait.
     2071            end.
     2072         end.
     2073         run waitfram-hide.
     2074      end.
     2075   procedure waitfram-join :
     2076     define input  parameter p-line-1  as character no-undo .
     2077     define input  parameter p-line-2  as character no-undo .
     2078     define input  parameter p-line-3  as character no-undo .
     2079     define output parameter p-message as character no-undo .
     2080     do
     2081     on error undo, return error return-value
     2082     :
     2083       assign
     2084         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     2085                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     2086                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     2087       .
     2088     end.
     2089   end procedure.
     2090   function waitfram-join-function returns character
     2091     (input p-line-1 as character
     2092     ,input p-line-2 as character
     2093     ,input p-line-3 as character
     2094     ).
     2095     define variable v-message as character no-undo .
     2096     run waitfram-join in this-procedure
     2097       (input  p-line-1
     2098       ,input  p-line-2
     2099       ,input  p-line-3
     2100       ,output v-message
     2101       ) .
     2102     return v-message .
     2103   end function .
     2104   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2105   define variable v-fltopend-rowid as rowid extent 18 no-undo .
     2106   procedure fltopend_fltopend :
     2107   define input parameter p-parent-handle as handle no-undo .
     2108   define input parameter p-qh as handle no-undo .
     2109   define input parameter p-flt-open-open-query  as character no-undo .
     2110   define input parameter p-where-cond as character no-undo .
     2111   define input parameter p-use-indFIRST-query-tail as character no-undo .
     2112   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     2113   define input parameter p-indexed-reposition as character no-undo .
     2114     do
     2115     on error undo, return error
     2116     :
     2117   define variable v-prepare-string as character no-undo .
     2118   define variable glog as logical no-undo .
     2119   assign
     2120   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     2121                      p-where-cond + chr(32)  +
     2122                      p-use-indFIRST-query-tail + chr(32) +
     2123                      p-use-ind-sort-clmn-by + chr(32) +
     2124                      p-indexed-reposition
     2125   .
     2126   assign
     2127   glog = p-qh:query-prepare(v-prepare-string) no-error .
     2128   if not glog
     2129   or error-status:error then do:
     2130     message error-status:get-message(1) view-as alert-box .
     2131     undo, return error .
     2132   end.
     2133   assign
     2134   glog = p-qh:query-open no-error .
     2135   if not glog
     2136   or error-status:error then do:
     2137     message error-status:get-message(1) view-as alert-box .
     2138     undo, return error .
     2139   end.
     2140     end.
     2141   end procedure.
     2142   procedure fltopend_fltfindd :
     2143   define input parameter p-parent-handle as handle no-undo .
     2144   define input parameter p-qh as handle no-undo .
     2145   define input parameter p-rowid as rowid no-undo .
     2146   define input parameter p-next as logical no-undo .
     2147   define input parameter p-lock as integer no-undo .
     2148   define input parameter p-bh as handle no-undo .
     2149   define input parameter p-where-cond as character no-undo .
     2150   define input parameter p-use-index-phrase as character no-undo .
     2151   define variable glog as logical no-undo .
     2152   define variable v-qh as handle no-undo .
     2153   define variable v-bh as handle no-undo .
     2154   define variable v-recid as recid no-undo .
     2155   define variable v-prepare-string as character no-undo .
     2156   do
     2157   on error undo, return error
     2158   on stop undo, return error
     2159   :
     2160     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
     2161     create buffer v-bh for table p-bh buffer-name p-bh:name.
     2162     create query v-qh.
     2163     v-qh:set-buffers(v-bh).
     2164     v-prepare-string = substitute("for each &1 &2 &3"
     2165                                     ,v-bh:name
     2166                                     ,p-where-cond
     2167                                     ,p-use-index-phrase).
     2168     glog = v-qh:query-prepare(v-prepare-string) no-error.
     2169     if not glog then do:
     2170       delete object v-qh.
     2171       delete object v-bh.
     2172       undo, return error .
     2173     end.
     2174     glog = v-qh:query-open no-error .
     2175     if not glog then do:
     2176       delete object v-qh.
     2177       delete object v-bh.
     2178       undo, return error .
     2179     end.
     2180     if p-next then do:
     2181       v-qh:reposition-to-rowid(p-rowid) no-error .
     2182       glog = v-qh:get-next( p-lock) no-error .
     2183       glog = v-qh:get-next( p-lock) no-error .
     2184       if not glog or v-qh:query-off-end = yes then do:
     2185         glog = v-qh:get-first( p-lock) no-error .
     2186       end.
     2187     end.
     2188     else do:
     2189       glog = v-qh:get-first( p-lock) no-error .
     2190     end.
     2191     v-recid = v-bh:recid no-error .
     2192     delete object v-qh.
     2193     delete object v-bh.
     2194     return string(v-recid) .
     2195   end.
     2196   end procedure.
     2197   procedure fltopend_fltfindq :
     2198   define input parameter p-parent-handle as handle no-undo .
     2199   define input parameter p-qh as handle no-undo .
     2200   define input parameter p-next as logical no-undo .
     2201   define input parameter p-lock as integer no-undo .
     2202   define input parameter p-flt-open-open-query  as character no-undo .
     2203   define input parameter p-where-cond as character no-undo .
     2204   define input parameter p-use-indFIRST-query-tail as character no-undo .
     2205   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     2206   define input parameter p-indexed-reposition as character no-undo .
     2207   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
     2208   define variable glog as logical no-undo .
     2209   define variable v-qh as handle no-undo .
     2210   define variable v-bh as handle no-undo extent 18.
     2211   define variable v-rowid as rowid no-undo extent 18.
     2212   define variable v-ii as integer no-undo .
     2213   define variable v-prepare-string as character no-undo .
     2214   do
     2215   on error undo, return error
     2216   on stop undo, return error
     2217   :
     2218     create query v-qh.
     2219     do v-ii = 1 to p-qh:num-buffers:
     2220       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
     2221       assign
     2222       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
     2223       no-error.
     2224       v-qh:add-buffer(v-bh[v-ii]).
     2225     end.
     2226     assign
     2227     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     2228                       p-where-cond + chr(32)  +
     2229                       p-use-indFIRST-query-tail + chr(32) +
     2230                       p-use-ind-sort-clmn-by + chr(32) +
     2231                       p-indexed-reposition
     2232     .
     2233     glog = v-qh:query-prepare( v-prepare-string) no-error .
     2234     if not glog then do:
     2235       delete object v-qh.
     2236       do v-ii = 1 to p-qh:num-buffers:
     2237         delete object v-bh[v-ii].
     2238       end.
     2239       undo, return error .
     2240     end.
     2241     glog = v-qh:query-open no-error .
     2242     if not glog then do:
     2243       delete object v-qh.
     2244       do v-ii = 1 to p-qh:num-buffers:
     2245         delete object v-bh[v-ii].
     2246       end.
     2247       undo, return error .
     2248     end.
     2249     if p-next then do:
     2250       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
     2251       glog = v-qh:get-next( p-lock) no-error .
     2252       glog = v-qh:get-next( p-lock) no-error .
     2253       if not glog or v-qh:query-off-end = yes then do:
     2254         glog = v-qh:get-first( p-lock) no-error .
     2255       end.
     2256     end.
     2257     else do:
     2258       glog = v-qh:get-first( p-lock) no-error .
     2259     end.
     2260     do v-ii = 1 to p-qh:num-buffers:
     2261       assign
     2262       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     2263       no-error.
     2264     end.
     2265     delete object v-qh.
     2266     do v-ii = 1 to p-qh:num-buffers:
     2267       delete object v-bh[v-ii].
     2268     end.
     2269   end.
     2270   end procedure.
     2271   define temp-table temp_trn-doc-code no-undo
     2272       field doc-code as character
     2273       index pi is primary unique doc-code
     2274   .
     2275   FUNCTION Last-Day RETURNS INTEGER ( INPUT i-date AS DATE ) :
     2276     DEFINE VARIABLE t_date AS DATE NO-UNDO.
     2277     ASSIGN t_date = DATE( MONTH( i-date ), 28, YEAR( i-date ) ).
     2278     RETURN ( DAY( t_date - DAY( t_date + 4 ) + 4 ) ).
     2279   END FUNCTION.
     2280   define variable filter-point as character no-undo init "c-dinamo" .
     2281   define variable filter-point0 as character no-undo init "c-dinamo" .
     2282   define variable filter-label as character no-undo init "Динамика" .
     2283   define variable filter-label0 as character no-undo init "Динамика" .
     2284   define variable sort-column-name as character no-undo .
     2285   define variable v-contra like ub.clients.obj-name no-undo.
     2286   define variable v-fact-date as date no-undo.
     2287   define variable print-option as character no-undo.
     2288   DEFINE VARIABLE v-fact-qnty as decimal no-undo .
     2289   DEFINE VARIABLE v-sale-sum-rubl as decimal no-undo .
     2290   DEFINE VARIABLE v-sale-sum-base as decimal no-undo .
     2291   DEFINE VARIABLE v-cost-sum-rubl as decimal no-undo .
     2292   DEFINE VARIABLE v-cost-sum-base as decimal no-undo .
     2293   DEFINE VARIABLE v-line-cost-sum-rubl as decimal no-undo .
     2294   DEFINE VARIABLE v-line-cost-sum-base as decimal no-undo .
     2295   DEFINE VARIABLE loc-flt-rec as logical no-undo.
     2296   define variable v-doc-rec as recid no-undo .
     2297   define shared buffer t-month for t-month0.
     2298   define shared buffer t-fo for t-fo0.
     2299   define buffer buf_goods for ub.goods.
     2300   define buffer lkp_t-stk for t-stk.
     2301   define buffer lkp_t-dinamo for t-dinamo.
     2302   define new shared temp-table temp-ot-line0 no-undo
     2303   like ub.ot-line
     2304   .
     2305   define new shared buffer temp-ot-line for temp-ot-line0.
     2306   FUNCTION get-doc RETURNS character
     2307     ( input p-doc-code as character, input p-ext-doc-type as character, input p-sign-int as integer, output p-fact-date  as date, output p-contra as character)  FORWARD.
     2308   DEFINE MENU MENU-B-print
     2309          MENU-ITEM m_docum        LABEL "Документ"
     2310          MENU-ITEM m_list         LABEL "Список документов"
     2311          MENU-ITEM m_card         LABEL "Учетная карточка"
     2312          MENU-ITEM m_oborot       LABEL "Оборотная ведомость".
     2313   DEFINE BUTTON B-doc
     2314        LABEL "&Документ"
     2315        SIZE 10 BY 1
     2316        BGCOLOR 8 .
     2317   DEFINE BUTTON B-Help
     2318        LABEL "Помо&щь"
     2319        SIZE 3 BY 1
     2320        BGCOLOR 8 .
     2321   DEFINE BUTTON B-next AUTO-GO
     2322        LABEL "&>>"
     2323        SIZE 4 BY 1
     2324        BGCOLOR 8 .
     2325   DEFINE BUTTON B-objects
     2326        LABEL "&Объекты?"
     2327        SIZE 10 BY 1
     2328        BGCOLOR 8 .
     2329   DEFINE BUTTON B-prev AUTO-GO
     2330        LABEL "&<<"
     2331        SIZE 4 BY 1
     2332        BGCOLOR 8 .
     2333   DEFINE BUTTON B-print
     2334        LABEL "Пе&чать"
     2335        SIZE 3 BY 1
     2336        BGCOLOR 8 .
     2337   DEFINE BUTTON b-quit AUTO-END-KEY
     2338        LABEL "&Выход"
     2339        SIZE 10 BY 1
     2340        BGCOLOR 8 .
     2341   DEFINE BUTTON B-sch
     2342        LABEL "&Фильтр"
     2343        SIZE 3 BY 1
     2344        BGCOLOR 8 .
     2345   DEFINE VARIABLE RS-curr AS CHARACTER INITIAL "rubl"
     2346        VIEW-AS RADIO-SET HORIZONTAL
     2347        RADIO-BUTTONS
     2348             "Баз.вал.", "base",
     2349   "", "rubl"
     2350        SIZE 25.5 BY 1 NO-UNDO.
     2351   DEFINE QUERY BR-dinamo FOR
     2352         lkp_t-dinamo SCROLLING.
     2353   DEFINE QUERY BR-docs FOR
     2354         temp-ot-line SCROLLING.
     2355   DEFINE QUERY BR-stk FOR
     2356         lkp_t-stk SCROLLING.
     2357   DEFINE BROWSE BR-dinamo
     2358     QUERY BR-dinamo DISPLAY
     2359         string((if loc-flt-rec then v-fact-qnty else lkp_t-dinamo.fact-qnty), "->>,>>>,>>9.999")
     2360   column-label "Кол-во" format "X(15)"
     2361   (if RS-curr = "rubl":U
     2362   then string((if loc-flt-rec then v-sale-sum-rubl  else lkp_t-dinamo.sale-sum-rubl) ,"->>,>>>,>>>,>>>,>>9.99")
     2363   else string((if loc-flt-rec then v-sale-sum-base  else lkp_t-dinamo.sale-sum-base),"->>,>>>,>>>,>>>,>>9.99"))
     2364   COLUMn-LABEL "Сумма продаж. цен" format "X(22)"
     2365   (if p-cost-view then
     2366   (if RS-curr = "rubl":U
     2367   then string((if loc-flt-rec then v-cost-sum-rubl  else lkp_t-dinamo.cost-sum-rubl) , "->>,>>>,>>>,>>>,>>9.99")
     2368   else string((if loc-flt-rec then v-cost-sum-base  else lkp_t-dinamo.cost-sum-base), "->>,>>>,>>>,>>>,>>9.99"))
     2369   else "":U)
     2370   COLUMn-LABEL "Сумма учетных цен" format "X(22)"
     2371       WITH NO-ROW-MARKERS NO-COLUMN-SCROLLING SEPARATORS SIZE 82 BY 4.92
     2372            BGCOLOR 8
     2373            TITLE BGCOLOR 8 "Итого по документам".
     2374   DEFINE BROWSE BR-docs
     2375     QUERY BR-docs DISPLAY
     2376         get-doc( input temp-ot-line.doc-code, input temp-ot-line.ext-doc-type, (if temp-ot-line.fact-qnty > 0 then 1 else - 1), output v-fact-date, output v-contra)
     2377     COLUMN-LABEL "Тип док-та" format "X(18)"
     2378   temp-ot-line.doc-code
     2379   temp-ot-line.obj-type + string(temp-ot-line.obj-code ) COLUMn-LABEL "Объект" format "X(8)"
     2380   v-fact-date COLUMN-LABEL "Факт.дата" format "99/99/9999"
     2381   v-contra column-label "Контрагент" format "X(20)"
     2382   temp-ot-line.fact-qnty COLUMN-LABEL "Кол-во" format "->>,>>>,>>9.999"
     2383   (If Rs-curr = "rubl":U
     2384   then temp-ot-line.sum-rubl
     2385   else temp-ot-line.sum-base)
     2386   COLUMN-LABEL "Сумма"  format "->>,>>>,>>>,>>>,>>9.99"
     2387   (If Rs-curr = "rubl":U
     2388   then temp-ot-line.sum-rubl / temp-ot-line.fact-qnty
     2389   else temp-ot-line.sum-base / temp-ot-line.fact-qnty)
     2390   column-label "Цена приведенная" format "->>,>>>,>>>,>>>,>>9.99"
     2391   decimal(entry(1, temp-ot-line.cat-id)) COLUMn-LABEL "НДС" format "99.99"
     2392   (If Rs-curr = "rubl":U
     2393   then temp-ot-line.VAT-rubl
     2394   else temp-ot-line.VAT-base)
     2395    COLUMN-LABEL "Сумма НДС" format "->>,>>>,>>>,>>>,>>9.99"
     2396   decimal(entry(2, temp-ot-line.cat-id)) COLUMn-LABEL "НП" format "99.99"
     2397   (If Rs-curr = "rubl":U
     2398   then temp-ot-line.SLT-rubl
     2399   else temp-ot-line.SLT-base) COLUMN-LABEL "Сумма НП"  format "->>,>>>,>>>,>>>,>>9.99"
     2400   (If Rs-curr = "rubl":U
     2401   then temp-ot-line.transport-rubl
     2402   else temp-ot-line.transport-base) COLUMN-LABEL "Транспортные расходы"  format "->>,>>>,>>>,>>>,>>9.99"
     2403   (if  Rs-curr = "rubl":U
     2404   then temp-ot-line.other-rubl
     2405   else temp-ot-line.other-base) COLUMN-LABEL "Сумма др.расходов"  format "->>,>>>,>>>,>>>,>>9.99"
     2406   (if  Rs-curr = "rubl":U
     2407   then temp-ot-line.road-tax-rubl
     2408   else temp-ot-line.road-tax-base) COLUMN-LABEL "Сумма дор.налога"  format "->>,>>>,>>>,>>>,>>9.99"
     2409   (if  Rs-curr = "rubl":U
     2410   then temp-ot-line.excise-rubl
     2411   else temp-ot-line.excise-base) COLUMN-LABEL "Сумма акциза"  format "->>,>>>,>>>,>>>,>>9.99"
     2412       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 13.17.
     2413   DEFINE BROWSE BR-stk
     2414     QUERY BR-stk DISPLAY
     2415         lkp_t-stk.b-a-full
     2416   column-label "":U
     2417   FORMAT "X(18)"
     2418   string(lkp_t-stk.fact-qnty, "->>,>>>,>>9.999")
     2419   column-label "Кол-во" format "X(15)"
     2420   (if Rs-curr = "rubl":U
     2421   then string(lkp_t-stk.sale-sum-rubl, "->>,>>>,>>>,>>>,>>9.99")
     2422   else string(lkp_t-stk.sale-sum-base, "->>,>>>,>>>,>>>,>>9.99"))
     2423   column-label "Сумма продаж. цен" format "X(22)"
     2424   (if p-cost-view then
     2425   (if Rs-curr = "rubl":U
     2426   then string(lkp_t-stk.cost-sum-rubl, "->>,>>>,>>>,>>>,>>9.99")
     2427   else string(lkp_t-stk.cost-sum-base, "->>,>>>,>>>,>>>,>>9.99"))
     2428   else "":U)
     2429   column-label "Сумма учетных цен" format "X(22)"
     2430       WITH NO-ROW-MARKERS NO-COLUMN-SCROLLING SEPARATORS SIZE 82 BY 4.92
     2431            BGCOLOR 8
     2432            TITLE BGCOLOR 8 "Остатки".
     2433   DEFINE FRAME Dialog-Frame
     2434        b-quit AT ROW 1 COL 1
     2435        RS-curr AT ROW 1 COL 12.63 NO-LABEL
     2436        B-prev AT ROW 1 COL 41
     2437        B-next AT ROW 1 COL 45
     2438        B-objects AT ROW 1 COL 49
     2439        B-doc AT ROW 1 COL 59
     2440        B-print AT ROW 1 COL 89
     2441        B-sch AT ROW 1 COL 92
     2442        B-Help AT ROW 1 COL 95
     2443        BR-docs AT ROW 2.5 COL 1
     2444        BR-stk AT ROW 15.96 COL 10
     2445        BR-dinamo AT ROW 15.96 COL 10
     2446        SPACE(7.25) SKIP(1.17)
     2447       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     2448            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     2449            TITLE "Учетная карточка"
     2450            CANCEL-BUTTON b-quit.
     2451   ASSIGN
     2452          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     2453          FRAME Dialog-Frame:HIDDEN           = TRUE.
     2454   ASSIGN
     2455          B-print:POPUP-MENU IN FRAME Dialog-Frame       = MENU MENU-B-print:HANDLE.
     2456   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     2457   DO:
     2458     assign
     2459     p-curr = Rs-curr.
     2460     APPLY "END-ERROR":U TO SELF.
     2461   END.
     2462   ON CHOOSE OF B-doc IN FRAME Dialog-Frame
     2463   DO:
     2464     run proc-b-doc in this-procedure no-error.
     2465     if error-status:error then return no-apply.
     2466   END.
     2467   ON CHOOSE OF B-next IN FRAME Dialog-Frame
     2468   DO:
     2469       run proc-b-move(input self:name) no-error.
     2470     if error-status:error then return no-apply.
     2471   END.
     2472   ON CHOOSE OF B-objects IN FRAME Dialog-Frame
     2473   DO:
     2474     run proc-view-objects in this-procedure no-error.
     2475     if error-status:error then return no-apply.
     2476   END.
     2477   ON CHOOSE OF B-prev IN FRAME Dialog-Frame
     2478   DO:
     2479       run proc-b-move(input self:name) no-error.
     2480     if error-status:error then return no-apply.
     2481   END.
     2482   ON CHOOSE OF B-print IN FRAME Dialog-Frame
     2483   DO:
     2484     run proc-b-print in this-procedure no-error.
     2485     if error-status:error then return no-apply.
     2486   END.
     2487   ON CHOOSE OF b-quit IN FRAME Dialog-Frame
     2488   DO:
     2489       assign
     2490       p-curr = rs-curr.
     2491       p-next-prev = ?.
     2492   END.
     2493   ON CHOOSE OF B-sch IN FRAME Dialog-Frame
     2494   DO:
     2495       run proc-b-sch in this-procedure no-error.
     2496     if error-status:error then return no-apply.
     2497   END.
     2498   ON CHOOSE OF MENU-ITEM m_card
     2499   DO:
     2500     assign
     2501     print-option = "card":U.
     2502     run proc-b-print in this-procedure no-error.
     2503     if error-status:error then return no-apply.
     2504   END.
     2505   ON CHOOSE OF MENU-ITEM m_docum
     2506   DO:
     2507      print-option = "document":U.
     2508     run proc-b-print in this-procedure no-error.
     2509     if error-status:error then return no-apply.
     2510   END.
     2511   ON CHOOSE OF MENU-ITEM m_list
     2512   DO:
     2513      print-option = "list":U.
     2514     run proc-b-print in this-procedure no-error.
     2515     if error-status:error then return no-apply.
     2516   END.
     2517   ON CHOOSE OF MENU-ITEM m_oborot
     2518   DO:
     2519      print-option = "oborot":U.
     2520     run proc-b-print in this-procedure no-error.
     2521     if error-status:error then return no-apply.
     2522   END.
     2523   ON VALUE-CHANGED OF RS-curr IN FRAME Dialog-Frame
     2524   DO:
     2525     assign
     2526     Rs-curr.
     2527    br-docs:refresh().
     2528    if br-stk:visible in frame Dialog-Frame then br-stk:refresh().
     2529    if br-dinamo:visible in frame Dialog-Frame then br-dinamo:refresh().
     2530   END.
     2531   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     2532   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     2533   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2534   on help of frame Dialog-Frame
     2535   do:
     2536     run gbl/app_help.p
     2537       (input this-procedure :file-name
     2538       ,input ''
     2539       ,input ?
     2540       ) no-error.
     2541     if error-status :error then do:
     2542       message
     2543         "Ошибка при вызове помощи"
     2544         error-status :get-message(1)
     2545         view-as alert-box .
     2546     end.
     2547   end.
     2548   run minbtn-set in this-procedure .
     2549   on choose of b-help in frame Dialog-Frame
     2550   do:
     2551     apply "help":u to frame Dialog-Frame .
     2552   end.
     2553   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2554   procedure minbtn-set :
     2555       do
     2556           on error undo, return error return-value
     2557           :
     2558           define variable ii              as integer       no-undo .
     2559           define variable fh              as widget-handle no-undo .
     2560           define variable hh              as widget-handle no-undo .
     2561           define variable v-h             as handle        extent 4 no-undo .
     2562           define variable v-name-button   as character     no-undo .
     2563           define variable v-help-old-x    as decimal       no-undo .
     2564           define variable v-help-old-y    as decimal       no-undo .
     2565           define variable v-help-old-size as decimal       no-undo .
     2566           define variable v-frame-width   as decimal       no-undo .
     2567           define variable jj              as integer       no-undo .
     2568           do
     2569               on error undo, return error
     2570               :
     2571               assign
     2572                   v-frame-width = frame Dialog-Frame:width - 0.3
     2573                   fh            = frame Dialog-Frame:first-child
     2574                   hh            = fh:first-child
     2575                   ii            = 1
     2576                   .
     2577               do while valid-handle(hh):
     2578                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     2579                   do:
     2580                       case lc(hh:name) :
     2581                           when "b-help" then
     2582                               do:
     2583                                   hh:load-image-up("cmp/b-help.bmp":u) .
     2584                                   hh:load-image-down("cmp/b-help.bmp":u) .
     2585                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     2586                                   hh:TOOLTIP = "Помощь" .
     2587                                   v-help-old-x = hh:column .
     2588                                   v-help-old-y = hh:row    .
     2589                                   v-help-old-size = hh:width .
     2590                                   hh:width-chars = 2.5 .
     2591                               end.
     2592                           when "b-print" then
     2593                               do:
     2594                                   hh:load-image("cmp/b-print.bmp":u) .
     2595                                   hh:TOOLTIP = "Печать" .
     2596                                   v-h[ii] = hh:handle .
     2597                                   ii = ii + 1 .
     2598                                   hh:width-chars = 3 .
     2599                               end.
     2600                           when "b-history" or
     2601                           when "b-hist" then
     2602                               do:
     2603                                   hh:load-image("cmp/b-hist.bmp":u) .
     2604                                   hh:TOOLTIP = "История" .
     2605                                   v-h[ii] = hh:handle .
     2606                                   ii = ii + 1 .
     2607                                   hh:width-chars = 3 .
     2608                               end.
     2609                           when "b-sch" then
     2610                               do:
     2611                                   hh:load-image("cmp/b-sch.bmp":u) .
     2612                                   hh:TOOLTIP = "Установка Фильтра" .
     2613                                   v-h[ii] = hh:handle .
     2614                                   ii = ii + 1 .
     2615                                   hh:width-chars = 3 .
     2616                               end.
     2617                           when "b-hist-user" then
     2618                               do:
     2619                                   hh:load-image("cmp/b-hist.bmp":u) .
     2620                                   hh:TOOLTIP = "История пользователя" .
     2621                                   ii = ii + 1 .
     2622                               end.
     2623                       end case.
     2624                   end.
     2625                   hh = hh:next-sibling.
     2626               end.
     2627               b-help:column = v-frame-width - b-help:width-chars.
     2628               jj = 0.
     2629               repeat ii = 4 to 1 by -1 :
     2630                   if valid-handle (v-h[ii] ) then
     2631                   do:
     2632                       jj  = jj + 1 .
     2633                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     2634                       v-h[ii]:row    = v-help-old-y .
     2635                   end.
     2636               end.
     2637           end.
     2638       end.
     2639   end procedure.
     2640   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     2641   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     2642   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     2643   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     2644   define variable v-diasize-current-frame-width  as decimal   no-undo .
     2645   define variable v-diasize-current-frame-height as decimal   no-undo .
     2646   define variable v-diasize-change-size          as logical   no-undo .
     2647   define variable v-diasize-resize-button        as handle    no-undo .
     2648   define variable v-diasize-wndmax               as logical   no-undo .
     2649   define variable v-diasize-wndstore             as logical   no-undo .
     2650   define variable v-diasize-proc-name            as character no-undo .
     2651   define variable v-diasize-browse-handle        as handle    no-undo .
     2652   define variable v-diasize-browse-number        as integer   no-undo .
     2653   define variable v-diasize-need-full-display    as logical   no-undo init false .
     2654   define temp-table temp-diasize-handle no-undo
     2655     field handle-value  as handle
     2656     field save-position as decimal
     2657     index xpk is primary unique handle-value
     2658     .
     2659   define temp-table temp-browse-handle no-undo
     2660     field browse-type   as character
     2661     field browse-number as integer
     2662     field browse-handle as handle
     2663     field original-size as decimal
     2664     index xpk is primary unique browse-type browse-number
     2665     index xie browse-type browse-handle
     2666   .
     2667   procedure diasize_change-height :
     2668     define input  parameter p-change-value  as decimal   no-undo .
     2669     define input  parameter p-move-resize   as logical   no-undo .
     2670     define variable v-field-group-handle    as handle    no-undo .
     2671     define variable v-object-handle         as handle    no-undo .
     2672     define variable v-frame-height          as decimal   no-undo .
     2673     define variable v-frame-virtual-height  as decimal   no-undo .
     2674     define variable v-browse-height         as decimal   no-undo .
     2675     define variable v-window-height         as decimal   no-undo .
     2676     define variable v-window-virtual-height as decimal   no-undo .
     2677     define variable v-change-sign           as integer   no-undo .
     2678     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2679     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2680     if p-change-value > 0
     2681     then do:
     2682       if frame Dialog-Frame :height + p-change-value
     2683           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     2684       then do:
     2685         assign
     2686           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     2687                           - (frame Dialog-Frame :height-chars)
     2688         .
     2689         if p-change-value <= 0
     2690         then do:
     2691           run diasize_position-resize-button in this-procedure .
     2692           return .
     2693         end.
     2694       end.
     2695     end.
     2696     if p-change-value < 0
     2697     then do:
     2698       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     2699       then do:
     2700         assign
     2701           p-change-value = v-diasize-orig-frame-height
     2702                          - (frame Dialog-Frame :height-chars)
     2703         .
     2704         if p-change-value >= 0
     2705         then do:
     2706           run diasize_position-resize-button in this-procedure .
     2707           return .
     2708         end.
     2709       end.
     2710     end.
     2711     if p-change-value >= 0
     2712     then do:
     2713       assign
     2714         v-change-sign = 1
     2715       .
     2716     end.
     2717     else do:
     2718       assign
     2719         v-change-sign = -1
     2720       .
     2721     end.
     2722     assign
     2723       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2724     .
     2725     if p-change-value = 0
     2726     then do:
     2727       run diasize_position-resize-button in this-procedure .
     2728       return .
     2729     end.
     2730     move_block:
     2731     do
     2732     on error undo move_block, retry move_block
     2733     :
     2734       if retry
     2735       then do:
     2736         do
     2737         on error undo move_block, leave move_block
     2738         :
     2739           if p-change-value > 0
     2740           then do:
     2741             for each buf_temp-diasize-handle
     2742             on error undo, next
     2743             :
     2744               assign
     2745                 v-object-handle = buf_temp-diasize-handle.handle-value
     2746               .
     2747               if v-object-handle <> v-diasize-resize-button
     2748               then do:
     2749                 assign
     2750                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2751                 .
     2752               end.
     2753             end.
     2754             assign
     2755               v-diasize-browse-handle :height = v-browse-height
     2756             .
     2757             for each buf_temp-browse-handle
     2758               where buf_temp-browse-handle.browse-type = 'height':u
     2759             on error undo, next
     2760             :
     2761               assign
     2762                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2763               .
     2764             end.
     2765             assign
     2766               frame Dialog-Frame :height = v-frame-height
     2767             .
     2768             if frame Dialog-Frame :scrollable = true
     2769             then do:
     2770               assign
     2771                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2772               .
     2773             end.
     2774             run diasize_position-resize-button in this-procedure .
     2775           end.
     2776           else do:
     2777             if frame Dialog-Frame :scrollable = true
     2778             then do:
     2779               assign
     2780                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2781               .
     2782             end.
     2783             assign
     2784               frame Dialog-Frame :height = v-frame-height
     2785             .
     2786             assign
     2787               v-diasize-browse-handle :height = v-browse-height
     2788             .
     2789             for each buf_temp-browse-handle
     2790               where buf_temp-browse-handle.browse-type = 'height':u
     2791             on error undo, next
     2792             :
     2793               assign
     2794                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2795               .
     2796             end.
     2797             for each buf_temp-diasize-handle
     2798             on error undo, next
     2799             :
     2800               assign
     2801                 v-object-handle = buf_temp-diasize-handle.handle-value
     2802               .
     2803               if v-object-handle <> v-diasize-resize-button
     2804               then do:
     2805                 assign
     2806                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2807                 .
     2808               end.
     2809             end.
     2810             run diasize_position-resize-button in this-procedure .
     2811           end.
     2812           assign
     2813             v-diasize-change-size = false
     2814           .
     2815           leave move_block .
     2816         end.
     2817       end.
     2818       assign
     2819         v-diasize-need-full-display = true
     2820       .
     2821       if v-diasize-change-size = false
     2822       then do:
     2823         assign
     2824           v-diasize-change-size = true
     2825         .
     2826       end.
     2827       else do:
     2828         return .
     2829       end.
     2830       assign
     2831         v-frame-height = frame Dialog-Frame :height
     2832         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     2833         v-browse-height = v-diasize-browse-handle :height
     2834       .
     2835       for each buf_temp-browse-handle
     2836         where buf_temp-browse-handle.browse-type = 'height':u
     2837       :
     2838         assign
     2839           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     2840         .
     2841       end.
     2842       for each buf_temp-diasize-handle
     2843       :
     2844         delete buf_temp-diasize-handle .
     2845       end.
     2846       assign
     2847         v-field-group-handle = frame Dialog-Frame :first-child
     2848       .
     2849       do while valid-handle(v-field-group-handle)
     2850       :
     2851         assign
     2852           v-object-handle = v-field-group-handle :first-child
     2853         .
     2854         do while valid-handle(v-object-handle)
     2855         :
     2856           if  v-object-handle <> v-diasize-browse-handle :handle
     2857           and can-query(v-object-handle, "row")
     2858           and can-query(v-object-handle, "height")
     2859           and ( v-object-handle :row > v-diasize-browse-handle :row )
     2860           then do:
     2861             find first buf_temp-browse-handle
     2862               where buf_temp-browse-handle.browse-type   = 'height':u
     2863                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2864               no-error .
     2865             if available buf_temp-browse-handle
     2866             then do:
     2867             end.
     2868             else do:
     2869               create buf_temp-diasize-handle .
     2870               assign
     2871                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2872                 buf_temp-diasize-handle.save-position = v-object-handle :row
     2873               .
     2874             end.
     2875           end.
     2876           assign
     2877             v-object-handle = v-object-handle :next-sibling
     2878           .
     2879         end.
     2880         assign
     2881           v-field-group-handle = v-field-group-handle :next-sibling
     2882         .
     2883       end.
     2884       do with frame Dialog-Frame
     2885       :
     2886         hide v-diasize-resize-button .
     2887         assign
     2888           v-diasize-resize-button :row    = 1
     2889           v-diasize-resize-button :column = 1
     2890         .
     2891       end.
     2892       if p-change-value > 0
     2893       then do:
     2894         if frame Dialog-Frame :scrollable = true
     2895         then do:
     2896           assign
     2897             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2898             no-error .
     2899           if error-status :error
     2900           or error-status :get-message(1) <> ""
     2901           then do:
     2902             undo move_block, retry move_block .
     2903           end.
     2904         end.
     2905         assign
     2906           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2907           no-error .
     2908         if error-status :error
     2909         or error-status :get-message(1) <> ""
     2910         then do:
     2911           undo move_block, retry move_block .
     2912         end.
     2913         assign
     2914           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2915           no-error .
     2916         if error-status :error
     2917         or error-status :get-message(1) <> ""
     2918         then do:
     2919           undo move_block, retry move_block .
     2920         end.
     2921         for each buf_temp-browse-handle
     2922           where buf_temp-browse-handle.browse-type = 'height':u
     2923         on error undo move_block, retry move_block
     2924         :
     2925           assign
     2926             buf_temp-browse-handle.browse-handle :height
     2927               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2928             no-error .
     2929           if error-status :error
     2930           or error-status :get-message(1) <> ""
     2931           then do:
     2932             undo move_block, retry move_block .
     2933           end.
     2934         end.
     2935         for each buf_temp-diasize-handle
     2936         on error undo move_block, retry move_block
     2937         :
     2938           assign
     2939             v-object-handle = buf_temp-diasize-handle.handle-value
     2940           .
     2941           if v-object-handle <> v-diasize-resize-button
     2942           then do:
     2943             assign
     2944               v-object-handle :row = v-object-handle :row + p-change-value
     2945               no-error .
     2946             if error-status :error
     2947             or error-status :get-message(1) <> ""
     2948             then do:
     2949               undo move_block, retry move_block .
     2950             end.
     2951           end.
     2952         end.
     2953       end.
     2954       else do:
     2955         for each buf_temp-diasize-handle
     2956         on error undo move_block, retry move_block
     2957         :
     2958           assign
     2959             v-object-handle = buf_temp-diasize-handle.handle-value
     2960           .
     2961           if v-object-handle <> v-diasize-resize-button
     2962           then do:
     2963             assign
     2964               v-object-handle :row = v-object-handle :row + p-change-value
     2965               no-error .
     2966             if error-status :error
     2967             or error-status :get-message(1) <> ""
     2968             then do:
     2969               undo move_block, retry move_block .
     2970             end.
     2971           end.
     2972         end.
     2973         assign
     2974           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2975           no-error .
     2976         if error-status :error
     2977         or error-status :get-message(1) <> ""
     2978         then do:
     2979           undo move_block, retry move_block .
     2980         end.
     2981         for each buf_temp-browse-handle
     2982           where buf_temp-browse-handle.browse-type = 'height':u
     2983         on error undo move_block, retry move_block
     2984         :
     2985           assign
     2986             buf_temp-browse-handle.browse-handle :height
     2987               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2988             no-error .
     2989           if error-status :error
     2990           or error-status :get-message(1) <> ""
     2991           then do:
     2992             undo move_block, retry move_block .
     2993           end.
     2994         end.
     2995         assign
     2996           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2997           no-error .
     2998         if error-status :error
     2999         or error-status :get-message(1) <> ""
     3000         then do:
     3001           undo move_block, retry move_block .
     3002         end.
     3003         if frame Dialog-Frame :scrollable = true
     3004         then do:
     3005           assign
     3006             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     3007             no-error .
     3008           if error-status :error
     3009           or error-status :get-message(1) <> ""
     3010           then do:
     3011             undo move_block, retry move_block .
     3012           end.
     3013         end.
     3014       end.
     3015       if p-move-resize = true
     3016       then do:
     3017         run diasize_position-resize-button in this-procedure .
     3018       end.
     3019       if v-diasize-wndstore = true
     3020       then do:
     3021         if connected("ub") = true
     3022         then do:
     3023           define variable v-cntxt-db-num        as integer   no-undo .
     3024           define variable v-cntxt-userid        as character no-undo .
     3025           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3026                                             , OUTPUT v-cntxt-userid
     3027                                             ) .
     3028           run gbl/wndsizew.p
     3029             (input  v-cntxt-db-num
     3030             ,input  v-cntxt-userid
     3031             ,input  v-diasize-proc-name
     3032             ,input  'height':u
     3033             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     3034             ) .
     3035         end.
     3036       end.
     3037     end.
     3038     assign
     3039       v-diasize-change-size = false
     3040     .
     3041   end procedure.
     3042   procedure diasize_set-height :
     3043     define input  parameter p-new-height  as decimal   no-undo .
     3044     define input  parameter p-move-resize as logical   no-undo .
     3045     do
     3046     on error undo, return error return-value
     3047     :
     3048       run diasize_change-height in this-procedure
     3049         (input  (p-new-height - frame Dialog-Frame :height)
     3050         ,input  p-move-resize
     3051         ) .
     3052     end.
     3053   end procedure.
     3054   procedure diasize_change-width :
     3055     define input  parameter p-change-value as decimal   no-undo .
     3056     define input  parameter p-move-resize  as logical   no-undo .
     3057     define variable v-field-group-handle   as handle    no-undo .
     3058     define variable v-object-handle        as handle    no-undo .
     3059     define variable v-frame-width          as decimal   no-undo .
     3060     define variable v-frame-virtual-width  as decimal   no-undo .
     3061     define variable v-browse-width         as decimal   no-undo .
     3062     define variable v-window-width         as decimal   no-undo .
     3063     define variable v-window-virtual-width as decimal   no-undo .
     3064     define variable v-change-sign          as integer   no-undo .
     3065     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     3066     define buffer buf_temp-browse-handle  for temp-browse-handle .
     3067     if p-change-value > 0
     3068     then do:
     3069       if frame Dialog-Frame :width + p-change-value >
     3070           session :width-chars
     3071       then do:
     3072         assign
     3073           p-change-value = session :width-chars - frame Dialog-Frame :width
     3074         .
     3075         if p-change-value <= 0
     3076         then do:
     3077           run diasize_position-resize-button in this-procedure .
     3078           return .
     3079         end.
     3080       end.
     3081     end.
     3082     if p-change-value < 0
     3083     then do:
     3084       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     3085       then do:
     3086         assign
     3087           p-change-value = v-diasize-orig-frame-width
     3088                          - frame Dialog-Frame :width
     3089         .
     3090         if p-change-value >= 0
     3091         then do:
     3092           run diasize_position-resize-button in this-procedure .
     3093           return .
     3094         end.
     3095       end.
     3096     end.
     3097     if p-change-value >= 0
     3098     then do:
     3099       assign
     3100         v-change-sign = 1
     3101       .
     3102     end.
     3103     else do:
     3104       assign
     3105         v-change-sign = -1
     3106       .
     3107     end.
     3108     assign
     3109       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     3110     .
     3111     if p-change-value = 0
     3112     then do:
     3113       run diasize_position-resize-button in this-procedure .
     3114       return .
     3115     end.
     3116     move_block:
     3117     do
     3118     on error undo move_block, leave move_block
     3119     :
     3120       if retry
     3121       then do:
     3122         do
     3123         on error undo move_block, leave move_block
     3124         :
     3125           if p-change-value > 0
     3126           then do:
     3127             for each buf_temp-diasize-handle
     3128             on error undo, next
     3129             :
     3130               assign
     3131                 v-object-handle = buf_temp-diasize-handle.handle-value
     3132               .
     3133               if v-object-handle <> v-diasize-resize-button
     3134               then do:
     3135                 assign
     3136                   v-object-handle :col = buf_temp-diasize-handle.save-position
     3137                 .
     3138               end.
     3139             end.
     3140             assign
     3141               v-diasize-browse-handle :width = v-browse-width
     3142             .
     3143             for each buf_temp-browse-handle
     3144               where buf_temp-browse-handle.browse-type = 'width':u
     3145             on error undo, next
     3146             :
     3147               assign
     3148                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     3149               .
     3150             end.
     3151             assign
     3152               frame Dialog-Frame :width = v-frame-width
     3153             .
     3154             if frame Dialog-Frame :scrollable = true
     3155             then do:
     3156               assign
     3157                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     3158               .
     3159             end.
     3160             run diasize_position-resize-button in this-procedure .
     3161           end.
     3162           else do:
     3163             if frame Dialog-Frame :scrollable = true
     3164             then do:
     3165               assign
     3166                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     3167               .
     3168             end.
     3169             assign
     3170               frame Dialog-Frame :width = v-frame-width
     3171             .
     3172             for each buf_temp-browse-handle
     3173               where buf_temp-browse-handle.browse-type = 'width':u
     3174             on error undo, next
     3175             :
     3176               assign
     3177                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     3178               .
     3179             end.
     3180             assign
     3181               v-diasize-browse-handle :width = v-browse-width
     3182             .
     3183             for each buf_temp-diasize-handle
     3184             on error undo, next
     3185             :
     3186               assign
     3187                 v-object-handle = buf_temp-diasize-handle.handle-value
     3188               .
     3189               if v-object-handle <> v-diasize-resize-button
     3190               then do:
     3191                 assign
     3192                   v-object-handle :col = buf_temp-diasize-handle.save-position
     3193                 .
     3194               end.
     3195             end.
     3196             run diasize_position-resize-button in this-procedure .
     3197           end.
     3198           assign
     3199             v-diasize-change-size = false
     3200           .
     3201           leave move_block .
     3202         end.
     3203       end.
     3204       assign
     3205         v-diasize-need-full-display = true
     3206       .
     3207       if v-diasize-change-size = false
     3208       then do:
     3209         assign
     3210           v-diasize-change-size = true
     3211         .
     3212       end.
     3213       else do:
     3214         return .
     3215       end.
     3216       assign
     3217         v-frame-width = frame Dialog-Frame :width
     3218         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     3219         v-browse-width = v-diasize-browse-handle :width
     3220       .
     3221       for each buf_temp-browse-handle
     3222         where buf_temp-browse-handle.browse-type = 'width':u
     3223       :
     3224         assign
     3225           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     3226         .
     3227       end.
     3228       for each buf_temp-diasize-handle
     3229       :
     3230         delete buf_temp-diasize-handle .
     3231       end.
     3232       assign
     3233         v-field-group-handle = frame Dialog-Frame :first-child
     3234       .
     3235       do while valid-handle(v-field-group-handle)
     3236       :
     3237         assign
     3238           v-object-handle = v-field-group-handle :first-child
     3239         .
     3240         do while valid-handle(v-object-handle)
     3241         :
     3242           if  v-object-handle <> v-diasize-browse-handle :handle
     3243           and v-object-handle <> v-diasize-resize-button
     3244           and can-query(v-object-handle, "row")
     3245           and can-query(v-object-handle, "height")
     3246           and ( v-object-handle :col + v-object-handle :width
     3247                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     3248               )
     3249           then do:
     3250             find first buf_temp-browse-handle
     3251               where buf_temp-browse-handle.browse-type   = 'width':u
     3252                 and buf_temp-browse-handle.browse-handle = v-object-handle
     3253               no-error .
     3254             if available buf_temp-browse-handle
     3255             then do:
     3256             end.
     3257             else do:
     3258               create buf_temp-diasize-handle .
     3259               assign
     3260                 buf_temp-diasize-handle.handle-value  = v-object-handle
     3261                 buf_temp-diasize-handle.save-position = v-object-handle :col
     3262               .
     3263             end.
     3264           end.
     3265           assign
     3266             v-object-handle = v-object-handle :next-sibling
     3267           .
     3268         end.
     3269         assign
     3270           v-field-group-handle = v-field-group-handle :next-sibling
     3271         .
     3272       end.
     3273       do with frame Dialog-Frame
     3274       :
     3275         hide v-diasize-resize-button .
     3276         v-diasize-resize-button :row = 1.
     3277         v-diasize-resize-button :column = 1.
     3278       end.
     3279       if p-change-value > 0
     3280       then do:
     3281         if frame Dialog-Frame :scrollable = true
     3282         then do:
     3283           assign
     3284             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     3285             no-error .
     3286           if error-status :error
     3287           or error-status :get-message(1) <> ""
     3288           then do:
     3289             undo move_block, retry move_block.
     3290           end.
     3291         end.
     3292         assign
     3293           frame Dialog-Frame :width = v-frame-width + p-change-value
     3294           no-error .
     3295         if error-status :error
     3296         or error-status :get-message(1) <> ""
     3297         then do:
     3298           undo move_block, retry move_block.
     3299         end.
     3300         assign
     3301           v-diasize-browse-handle :width = v-browse-width + p-change-value
     3302         no-error .
     3303         if error-status :error
     3304         or error-status :get-message(1) <> ""
     3305         then do:
     3306           undo move_block, retry move_block.
     3307         end.
     3308         for each buf_temp-browse-handle
     3309           where buf_temp-browse-handle.browse-type = 'width':u
     3310         on error undo move_block, retry move_block
     3311         :
     3312           assign
     3313             buf_temp-browse-handle.browse-handle :width
     3314               = buf_temp-browse-handle.browse-handle :width + p-change-value
     3315             no-error .
     3316           if error-status :error
     3317           or error-status :get-message(1) <> ""
     3318           then do:
     3319             undo move_block, retry move_block .
     3320           end.
     3321         end.
     3322         for each buf_temp-diasize-handle
     3323         on error undo move_block, retry move_block
     3324         :
     3325           assign
     3326             v-object-handle = buf_temp-diasize-handle.handle-value
     3327           .
     3328           if v-object-handle <> v-diasize-resize-button
     3329           then do:
     3330             assign
     3331               v-object-handle :col = v-object-handle :col + p-change-value
     3332               no-error .
     3333             if error-status :error
     3334             or error-status :get-message(1) <> ""
     3335             then do:
     3336               undo move_block, retry move_block .
     3337             end.
     3338           end.
     3339         end.
     3340       end.
     3341       else do:
     3342         for each buf_temp-diasize-handle
     3343         on error undo move_block, retry move_block
     3344         :
     3345           assign
     3346             v-object-handle = buf_temp-diasize-handle.handle-value
     3347           .
     3348           if v-object-handle <> v-diasize-resize-button
     3349           then do:
     3350             assign
     3351               v-object-handle :col = v-object-handle :col + p-change-value
     3352               no-error .
     3353             if error-status :error
     3354             or error-status :get-message(1) <> ""
     3355             then do:
     3356               undo move_block, retry move_block .
     3357             end.
     3358           end.
     3359         end.
     3360         for each buf_temp-browse-handle
     3361           where buf_temp-browse-handle.browse-type = 'width':u
     3362         on error undo move_block, retry move_block
     3363         :
     3364           assign
     3365             buf_temp-browse-handle.browse-handle :width
     3366               = buf_temp-browse-handle.browse-handle :width + p-change-value
     3367             no-error .
     3368           if error-status :error
     3369           or error-status :get-message(1) <> ""
     3370           then do:
     3371             undo move_block, retry move_block .
     3372           end.
     3373         end.
     3374         assign
     3375           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     3376           no-error .
     3377         if error-status :error
     3378         or error-status :get-message(1) <> ""
     3379         then do:
     3380           undo move_block, retry move_block.
     3381         end.
     3382         assign
     3383           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     3384         no-error .
     3385         if error-status :error
     3386         or error-status :get-message(1) <> ""
     3387         then do:
     3388           undo move_block, retry move_block.
     3389         end.
     3390         if frame Dialog-Frame :scrollable = true
     3391         then do:
     3392           assign
     3393             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     3394           no-error .
     3395           if error-status :error
     3396           or error-status :get-message(1) <> ""
     3397           then do:
     3398             undo move_block, retry move_block.
     3399           end.
     3400         end.
     3401       end.
     3402       if p-move-resize
     3403       then do:
     3404         run diasize_position-resize-button in this-procedure .
     3405       end.
     3406       if v-diasize-wndstore = true
     3407       then do:
     3408         if connected("ub") = true
     3409         then do:
     3410           define variable v-cntxt-db-num        as integer   no-undo .
     3411           define variable v-cntxt-userid        as character no-undo .
     3412           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3413                                             , OUTPUT v-cntxt-userid
     3414                                             ) .
     3415           run gbl/wndsizew.p
     3416             (input  v-cntxt-db-num
     3417             ,input  v-cntxt-userid
     3418             ,input  v-diasize-proc-name
     3419             ,input  'width':u
     3420             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     3421             ) .
     3422         end.
     3423       end.
     3424     end.
     3425     assign
     3426       v-diasize-change-size = false
     3427     .
     3428   end procedure.
     3429   procedure diasize_set-width :
     3430     define input  parameter p-new-width  as decimal   no-undo .
     3431     define input  parameter p-move-resize as logical   no-undo .
     3432     do
     3433     on error undo, return error return-value
     3434     :
     3435       run diasize_change-width in this-procedure
     3436         (input  (p-new-width - frame Dialog-Frame :width)
     3437         ,input  p-move-resize
     3438         ) .
     3439     end.
     3440   end procedure.
     3441   procedure diasize_position-resize-button :
     3442     do with frame Dialog-Frame
     3443     :
     3444       hide v-diasize-resize-button .
     3445       assign
     3446         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     3447                     - 1
     3448                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     3449         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     3450                     - 1
     3451                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     3452       .
     3453       view v-diasize-resize-button .
     3454     end.
     3455   end procedure.
     3456   on alt-right anywhere
     3457   do:
     3458     run diasize_change-width in this-procedure
     3459       (input 1
     3460       ,input true
     3461       ) .
     3462     return no-apply .
     3463   end.
     3464   on alt-left anywhere
     3465   do:
     3466     run diasize_change-width in this-procedure
     3467       (input -1
     3468       ,input true
     3469       ) .
     3470     return no-apply .
     3471   end.
     3472   on alt-down anywhere
     3473   do:
     3474     run diasize_change-height in this-procedure
     3475       (input 1
     3476       ,input true
     3477       ) .
     3478     return no-apply .
     3479   end.
     3480   on alt-up anywhere
     3481   do:
     3482     run diasize_change-height in this-procedure
     3483       (input -1
     3484       ,input true
     3485       ) .
     3486     return no-apply .
     3487   end.
     3488   on alt-enter of frame Dialog-Frame
     3489   do:
     3490     run diasize_maximize in this-procedure
     3491       (input  ?
     3492       ).
     3493     return no-apply .
     3494   end.
     3495   procedure diasize_end-move :
     3496     do
     3497     on error undo, return error return-value
     3498     :
     3499       define variable v-row-delta as decimal   no-undo .
     3500       define variable v-col-delta as decimal   no-undo .
     3501       define variable v-new-row as decimal   no-undo .
     3502       define variable v-new-col as decimal   no-undo .
     3503       assign
     3504         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     3505         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     3506       .
     3507       assign
     3508         v-row-delta = v-new-row - frame Dialog-Frame :height
     3509         v-col-delta = v-new-col - frame Dialog-Frame :width
     3510       .
     3511       run diasize_change-height in this-procedure
     3512         (input v-row-delta
     3513         ,input true
     3514         ) .
     3515       run diasize_change-width in this-procedure
     3516         (input v-col-delta
     3517         ,input true
     3518         ) .
     3519     end.
     3520   end procedure.
     3521   procedure diasize_maximize :
     3522     define input  parameter p-action as logical   no-undo .
     3523     do
     3524     on error undo, return error return-value
     3525     :
     3526       if p-action = ?
     3527       then do:
     3528         if v-diasize-need-maximize = true
     3529         then do:
     3530           assign
     3531             p-action = true
     3532           .
     3533         end.
     3534         else do:
     3535           assign
     3536             p-action = false
     3537           .
     3538         end.
     3539       end.
     3540       if p-action = true
     3541       then do:
     3542         run diasize_change-height in this-procedure
     3543           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     3544               - frame Dialog-Frame :height-chars
     3545           ,input true
     3546           ) .
     3547         run diasize_change-width in this-procedure
     3548           (input session :width-chars
     3549               - frame Dialog-Frame :width-chars
     3550           ,input true
     3551           ) .
     3552         assign
     3553           v-diasize-need-maximize = false
     3554         .
     3555       end.
     3556       else do:
     3557         run diasize_change-width in this-procedure
     3558           (input v-diasize-orig-frame-width
     3559               - frame Dialog-Frame :width-chars
     3560           ,input true
     3561           ) .
     3562         run diasize_change-height in this-procedure
     3563           (input v-diasize-orig-frame-height
     3564               - frame Dialog-Frame :height-chars
     3565           ,input true
     3566           ) .
     3567         assign
     3568           v-diasize-need-maximize = true
     3569         .
     3570       end.
     3571     end.
     3572   end procedure.
     3573   procedure diasize_restore-orig-size :
     3574     do
     3575     on error undo, return error return-value
     3576     :
     3577       assign
     3578         v-diasize-current-frame-width  = frame Dialog-Frame :width
     3579         v-diasize-current-frame-height = frame Dialog-Frame :height
     3580       .
     3581       run diasize_set-height in this-procedure
     3582         (input  v-diasize-orig-frame-height
     3583         ,input  true
     3584         ) .
     3585       run diasize_set-width in this-procedure
     3586         (input  v-diasize-orig-frame-width
     3587         ,input  true
     3588         ) .
     3589     end.
     3590   end procedure.
     3591   procedure diasize_restore-current-size :
     3592     do
     3593     on error undo, return error return-value
     3594     :
     3595       run diasize_set-height in this-procedure
     3596         (input  v-diasize-current-frame-height
     3597         ,input  true
     3598         ) .
     3599       run diasize_set-width in this-procedure
     3600         (input  v-diasize-current-frame-width
     3601         ,input  true
     3602         ) .
     3603     end.
     3604   end procedure.
     3605   procedure diasize_set-browse-handle :
     3606     define input  parameter p-browse-handle as handle   no-undo .
     3607     define buffer buf_temp-browse-handle for temp-browse-handle .
     3608     do
     3609     on error undo, return error return-value
     3610     :
     3611       assign
     3612         v-diasize-browse-handle = p-browse-handle
     3613       .
     3614       for each buf_temp-browse-handle
     3615       on error undo, return error return-value
     3616       :
     3617         delete buf_temp-browse-handle .
     3618       end.
     3619     end.
     3620   end procedure.
     3621   procedure diasize_add_browse :
     3622     define input  parameter p-browse-type   as character no-undo .
     3623     define input  parameter p-browse-handle as handle    no-undo .
     3624     define buffer buf_temp-browse-handle for temp-browse-handle .
     3625     do
     3626     on error undo, return error return-value
     3627     :
     3628       assign
     3629         v-diasize-browse-number = v-diasize-browse-number + 1
     3630       .
     3631       create buf_temp-browse-handle .
     3632       assign
     3633         buf_temp-browse-handle.browse-type   = p-browse-type
     3634         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     3635         buf_temp-browse-handle.browse-handle = p-browse-handle
     3636       .
     3637     end.
     3638   end procedure.
     3639   procedure diasize_init :
     3640     define variable v-default-value    as logical   no-undo .
     3641     define variable v-restore-saved    as logical   no-undo .
     3642     define variable v-resize-value-str as character no-undo .
     3643     do
     3644     on error undo, return error return-value
     3645     :
     3646       do with frame Dialog-Frame
     3647       :
     3648         assign
     3649           v-diasize-orig-frame-height = frame Dialog-Frame :height
     3650           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     3651           v-diasize-browse-handle     = browse br-docs :handle
     3652         .
     3653         create button v-diasize-resize-button
     3654         assign
     3655           parent        = frame Dialog-Frame :first-child
     3656           label         = "s"
     3657           height-pixels = 16
     3658           width-pixels  = 16
     3659           visible       = true
     3660           sensitive     = true
     3661           movable       = true
     3662           triggers:
     3663             on end-move persistent run diasize_end-move in this-procedure .
     3664           end triggers.
     3665         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     3666         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     3667         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     3668         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     3669         assign
     3670           v-diasize-wndmax = false
     3671         .
     3672         if connected("ub") = true
     3673         then do:
     3674           define variable v-cntxt-db-num        as integer   no-undo .
     3675           define variable v-cntxt-userid        as character no-undo .
     3676           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3677                                             , OUTPUT v-cntxt-userid
     3678                                             ) .
     3679           run gbl/wndpar_r.p
     3680             (input  v-cntxt-db-num
     3681             ,input  v-cntxt-userid
     3682             ,input  'wndmax':U
     3683             ,output v-diasize-wndmax
     3684             ,output v-default-value
     3685             ) .
     3686         end.
     3687         assign
     3688           v-diasize-wndstore = false
     3689         .
     3690         if connected("ub") = true
     3691         then do:
     3692           run gbl/wndpar_r.p
     3693             (input  v-cntxt-db-num
     3694             ,input  v-cntxt-userid
     3695             ,input  'wndstore':U
     3696             ,output v-diasize-wndstore
     3697             ,output v-default-value
     3698             ) .
     3699         end.
     3700         assign
     3701           v-diasize-proc-name = entry(1, program-name(2), '.')
     3702         .
     3703         if v-diasize-wndstore = true
     3704         then do:
     3705           assign
     3706             v-restore-saved = false
     3707           .
     3708           if connected("ub") = true
     3709           then do:
     3710             run gbl/wndsizer.p
     3711               (input  v-cntxt-db-num
     3712               ,input  v-cntxt-userid
     3713               ,input  v-diasize-proc-name
     3714               ,input  'height':u
     3715               ,output v-resize-value-str
     3716               ) .
     3717             if v-resize-value-str <> '':U
     3718             then do:
     3719               run diasize_change-height in this-procedure
     3720                 (input  integer(v-resize-value-str)
     3721                 ,input  true
     3722                 ) .
     3723               assign
     3724                 v-restore-saved = true
     3725               .
     3726             end.
     3727           end.
     3728           if connected("ub") = true
     3729           then do:
     3730             run gbl/wndsizer.p
     3731               (input  v-cntxt-db-num
     3732               ,input  v-cntxt-userid
     3733               ,input  v-diasize-proc-name
     3734               ,input  'width':u
     3735               ,output v-resize-value-str
     3736               ) .
     3737             if v-resize-value-str <> '':U
     3738             then do:
     3739               run diasize_change-width in this-procedure
     3740                 (input  integer(v-resize-value-str)
     3741                 ,input  true
     3742                 ) .
     3743               assign
     3744                 v-restore-saved = true
     3745               .
     3746             end.
     3747           end.
     3748           if v-restore-saved <> true
     3749           then do:
     3750             if v-diasize-wndmax = true
     3751             then do:
     3752               run diasize_maximize in this-procedure
     3753                 (input  true
     3754                 ) .
     3755             end.
     3756           end.
     3757         end.
     3758         else do:
     3759           if v-diasize-wndmax = true
     3760           then do:
     3761             run diasize_maximize in this-procedure
     3762               (input  true
     3763               ) .
     3764           end.
     3765         end.
     3766       end.
     3767     end.
     3768   end procedure.
     3769   procedure diasize_need-full-display :
     3770     define output parameter p-need-full-display as logical   no-undo .
     3771     do
     3772     on error undo, return error return-value
     3773     :
     3774       assign
     3775         p-need-full-display = v-diasize-need-full-display
     3776       .
     3777       assign
     3778         v-diasize-need-full-display = false
     3779       .
     3780     end.
     3781   end procedure.
     3782   procedure get-context :
     3783      define output parameter p-db-num as integer          no-undo.
     3784      define output parameter p-user-id as character        no-undo.
     3785      define variable v-login               as character    no-undo.
     3786      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     3787      define buffer buf_user-login  for ub.user-login .
     3788      do
     3789      on error undo, return error
     3790      :
     3791            FIND FIRST buf_sys-ctrl no-lock.
     3792            ASSIGN
     3793               v-login = USERID("ub")
     3794               p-db-num = buf_sys-ctrl.db-num
     3795            .
     3796            FIND FIRST buf_user-login
     3797                 WHERE buf_user-login.db-num = p-db-num
     3798                   AND buf_user-login.user-login = v-login
     3799                 no-lock
     3800                 no-error
     3801                 .
     3802            IF AVAILABLE buf_user-login
     3803            THEN DO:
     3804               assign
     3805                  p-user-id = buf_user-login.user-id
     3806               .
     3807            END.
     3808      end.
     3809   end procedure.
     3810   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3811   procedure set-filter-name :
     3812   define input parameter p-filter-name as character no-undo .
     3813     do with frame Dialog-Frame:
     3814       if p-filter-name > "" then do:
     3815         assign
     3816           frame Dialog-Frame:title
     3817             = frame Dialog-Frame:title + "   ФИЛЬТР: " + p-filter-name.
     3818         .
     3819         assign
     3820           b-sch :tooltip = "Установлен фильтр " + p-filter-name
     3821         .
     3822       end.
     3823       else do:
     3824         assign
     3825           b-sch :tooltip = ""
     3826         .
     3827       end.
     3828     end.
     3829   end procedure.
     3830   p-next-prev = yes.
     3831   n-p: do while p-next-prev :
     3832   MAIN-BLOCK:
     3833   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3834      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     3835       if not avail t-month then return error.
     3836       find first buf_goods no-lock where buf_goods.gds-code = p-gds-code.
     3837     RUN Myenable.
     3838     run diasize_add_browse in this-procedure
     3839       (input  'width':u
     3840       ,input  browse br-dinamo :handle
     3841       ) .
     3842     run diasize_init in this-procedure .
     3843     WAIT-FOR GO OF FRAME Dialog-Frame.
     3844   END.
     3845   end.
     3846   RUN disable_UI.
     3847   PROCEDURE disable_UI :
     3848     HIDE FRAME Dialog-Frame.
     3849   END PROCEDURE.
     3850   PROCEDURE enable_UI :
     3851     DISPLAY RS-curr
     3852         WITH FRAME Dialog-Frame.
     3853     ENABLE b-quit RS-curr B-prev B-next B-objects B-doc B-print B-sch B-Help
     3854            BR-docs BR-stk BR-dinamo
     3855         WITH FRAME Dialog-Frame.
     3856     VIEW FRAME Dialog-Frame.
     3857     OPEN QUERY BR-dinamo FOR EACH lkp_t-dinamo no-lock where                                  lkp_t-dinamo.ym = t-month.ym                                AND LKP_T-DINAMO.EXT-doc-type = p-mode                                AND lkp_t-dinamo.sign = p-sign.    OPEN QUERY BR-docs FOR EACH temp-ot-line no-lock.    OPEN QUERY BR-stk FOR EACH lkp_t-stk no-lock where lkp_t-stk.ym = t-month.ym.
     3858   END PROCEDURE.
     3859   PROCEDURE fill-tables :
     3860   DEFINE VARIABLE bfact-order like ub.ot-line.fact-order no-undo .
     3861   DEFINE VARIABLE afact-order like ub.ot-line.fact-order no-undo .
     3862   DEFINE VARIABLE v-sale-sum-type as character no-undo .
     3863   DEFINE VARIABLE v-last-day as integer no-undo .
     3864   for each temp-ot-line :
     3865       delete temp-ot-line.
     3866   end.
     3867   if buf_goods.gds-type = 'т':U then do:
     3868     assign
     3869     v-sale-sum-type = 'crsa':U
     3870     .
     3871   end.
     3872   else do:
     3873     assign
     3874     v-sale-sum-type = 'cgsr':U
     3875     .
     3876   end.
     3877   ASSIGN v-last-day = last-day( date( t-month.month_, 1, t-month.year_ ) ).
     3878   run day-begin-fact-order in this-procedure (
     3879                                                input date(t-month.month_, 1, t-month.year)
     3880                                                ,output bfact-order).
     3881   run factord-end-day  in this-procedure (
     3882                                                input  date(t-month.month_, v-last-day, t-month.year_)
     3883                                                ,output afact-order).
     3884   CASE p-mode :
     3885       WHEN 'все':U        THEN DO:
     3886           for each obj-list no-lock,
     3887               each ub.ot-line no-lock where
     3888                        ub.ot-line.artic = buf_goods.artic
     3889                   AND ub.ot-line.prod-type = buf_goods.prod-type
     3890                   AND ub.ot-line.prod-code = buf_goods.prod-code
     3891                   AND ub.OT-LINE.OBJ-TYPE = OBJ-LIST.OBJ-TYPE
     3892                   AND ub.OT-LINE.OBJ-CODE = OBJ-LIST.OBJ-CODE
     3893                   AND ub.ot-line.sum-type = v-sale-sum-type
     3894                   and ub.ot-line.fact-order >= bfact-order
     3895                   and ub.ot-line.fact-order <= afact-order,
     3896                first t-fo no-lock where
     3897                      t-fo.obj-type = obj-list.OBJ-TYPE
     3898                           and t-fo.obj-code = obj-list.obj-code
     3899                           and t-fo.fact-order >= ot-line.fact-order:
     3900               create temp-ot-line.
     3901               buffer-copy ot-line to  temp-ot-line.
     3902           end.
     3903        end.
     3904        otherwise do:
     3905           for each obj-list no-lock,
     3906               each ub.ot-line no-lock where
     3907                        ub.ot-line.artic = buf_goods.artic
     3908                   AND ub.ot-line.prod-type = buf_goods.prod-type
     3909                   AND ub.ot-line.prod-code = buf_goods.prod-code
     3910                   AND ub.OT-LINE.OBJ-TYPE = OBJ-LIST.OBJ-TYPE
     3911                   AND ub.OT-LINE.OBJ-CODE = OBJ-LIST.OBJ-CODE
     3912                   AND ub.ot-line.sum-type = v-sale-sum-type
     3913                   and ub.ot-line.fact-order >= bfact-order
     3914                   and ub.ot-line.fact-order <= afact-order
     3915                 AND ub.ot-line.ext-doc-type = p-mode,
     3916                first t-fo no-lock where
     3917                      t-fo.obj-type = obj-list.OBJ-TYPE
     3918                           and t-fo.obj-code = obj-list.obj-code
     3919                           and t-fo.fact-order >= ot-line.fact-order:
     3920               create temp-ot-line.
     3921               buffer-copy ot-line to  temp-ot-line.
     3922           end.
     3923       END.
     3924   END CASE.
     3925   END PROCEDURE.
     3926   PROCEDURE MyEnable :
     3927   assign
     3928   b-print:MENU-MOUSE IN FRAME Dialog-Frame = 1.
     3929   if p-mode <> 'все':U then do:
     3930       assign
     3931       menu-item m_card:sensitive in menu menu-b-print = no
     3932       menu-item m_oborot:sensitive in menu menu-b-print = no
     3933       .
     3934   end.
     3935     ENABLE
     3936     b-quit
     3937     B-prev
     3938     B-next
     3939     B-objects
     3940     B-doc
     3941     B-sch
     3942     B-print
     3943     B-Help
     3944     BR-docs
     3945     BR-dinamo
     3946     BR-stk
     3947     RS-curr
     3948     WITH FRAME Dialog-Frame.
     3949     VIEW FRAME Dialog-Frame.
     3950     Rs-curr = p-curr.
     3951     display RS-curr WITH FRAME Dialog-Frame.
     3952      CASE p-mode:
     3953       when 'все':U then do:
     3954         hide br-dinamo in frame Dialog-Frame.
     3955          OPEN QUERY BR-stk FOR EACH lkp_t-stk no-lock where lkp_t-stk.ym = t-month.ym.
     3956       end.
     3957       otherwise do:
     3958         hide br-stk in frame Dialog-Frame.
     3959         OPEN QUERY BR-dinamo FOR EACH lkp_t-dinamo no-lock where                                  lkp_t-dinamo.ym = t-month.ym                                AND LKP_T-DINAMO.EXT-doc-type = p-mode                                AND lkp_t-dinamo.sign = p-sign.
     3960       end.
     3961     END.
     3962     run waitfram-show in this-procedure("Ждите...").
     3963     run fill-tables in this-procedure .
     3964   RUn OpenBR in this-procedure ( input yes, input no, input '':U).
     3965   END PROCEDURE.
     3966   PROCEDURE OpenBr :
     3967   define input  parameter p-open-query     as logical   no-undo .
     3968   define input  parameter p-find-next      as logical   no-undo .
     3969   define input  parameter p-find-condition as character no-undo .
     3970   DEFINE VARIABLE l-query-was-opened as logical no-undo .
     3971   define variable title0 as character no-undo.
     3972   define variable v-month-name as character no-undo.
     3973   DEFINE VARIABLE ii as integer no-undo .
     3974   DEFINE VARIABLE jj as integer no-undo .
     3975   DEFINE VARIABLE v-ext-doc-type as character no-undo .
     3976   DEFINE VARIABLE v-ext-doc-type-full as character no-undo .
     3977   DEFINE VARIABLE v-doc-type as character no-undo .
     3978   DEFINE VARIABLE v-doc-type-full as character no-undo .
     3979   DEFINE VARIABLE v-idoc-type as character no-undo .
     3980   DEFINE VARIABLE v-sign as character no-undo .
     3981   DEFINE VARIABLE v-sign-int as integer no-undo .
     3982   define buffer cost_ot-line for ub.ot-line.
     3983   if available t-month then do:
     3984       assign
     3985       v-month-name = string(t-month.month_).
     3986       run gbl/monthnam.p (input t-month.month_, output v-month-name) no-error.
     3987   end.
     3988   assign
     3989   title0 =    ("код товара:" + chr(32) +              string(buf_goods.gds-code) + chr(32) + "артикул:" + chr(32) +              buf_goods.artic + chr(32) +              buf_goods.prod-type + string(buf_goods.prod-code) + chr(32) +              string(buf_goods.gds-name, "X(20)") + chr(32) +              (if avail t-month then              ("Динамика за":U + chr(32) + v-month-name +              chr(32) + string(t-month.year_))              else "":U))
     3990   .
     3991   run waitfram-show in this-procedure("Ждите...").
     3992   DEFINE VARIABLE sort-column-phrase as character no-undo .
     3993   case sort-column-name :
     3994     when "" then do:
     3995       assign
     3996         sort-column-phrase = ""
     3997       .
     3998     end.
     3999     otherwise do:
     4000       assign
     4001         sort-column-phrase = "by " + sort-column-name
     4002       .
     4003     end.
     4004   end case.
     4005   define variable l-open-query as logical   no-undo .
     4006     CASE p-mode :
     4007       WHEN 'все':U        THEN DO:
     4008         ASSIGN
     4009         frame Dialog-Frame:TITLE = title0
     4010         filter-point = filter-point0 + p-mode
     4011         filter-label = substitute("&1", filter-label0)
     4012         .
     4013   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4014   define variable  l-disable-where-26  as logical   no-undo .
     4015   define variable  l-filter-open-26    as logical   .
     4016   define variable  flt-rec-26       as recid     no-undo .
     4017   define variable  filter-name-26      as character no-undo .
     4018   define variable  where-phrase-26     as character no-undo .
     4019   define variable  sort-phrase-26      as character no-undo .
     4020   define variable  where-phrase-rus-26 as character no-undo .
     4021   define variable  sort-phrase-rus-26  as character no-undo .
     4022   run gbl/flt-get.p
     4023     (input filter-point
     4024     ,output flt-rec-26
     4025     ,output filter-name-26
     4026     ,output where-phrase-26
     4027     ,output sort-phrase-26
     4028     ,output where-phrase-rus-26
     4029     ,output sort-phrase-rus-26
     4030     ).
     4031   if p-open-query then do:
     4032       run set-filter-name in this-procedure
     4033         (INPUT filter-name-26
     4034         ) no-error .
     4035     assign
     4036       l-filter-open-26 = false
     4037     .
     4038     if flt-rec-26 <> ?
     4039       or sort-column-phrase > ""
     4040     then do:
     4041       define variable  parameter-2-26 as character no-undo .
     4042       define variable  parameter-3-26 as character no-undo .
     4043       define variable  parameter-4-26 as character no-undo .
     4044       define variable  parameter-5-26 as character no-undo .
     4045       define variable  parameter-6-26 as character no-undo .
     4046       define variable  parameter-7-26 as character no-undo .
     4047         assign
     4048         parameter-3-26 =
     4049                                 "FOR EACH temp-ot-line"
     4050         parameter-4-26 =
     4051           (
     4052             if ("  TRUE " + " " + where-phrase-26) <> ""
     4053             then "  TRUE " + " " + where-phrase-26
     4054             else "true"
     4055           )
     4056         parameter-5-26 = (" " + "" + " " + "")
     4057         parameter-6-26 = if sort-phrase-26 = ''
     4058                              then
     4059           (
     4060           " " + "  " +
     4061             " " + sort-column-phrase +
     4062           " " + " by temp-ot-line.fact-order descending "
     4063           )
     4064                              else
     4065           (
     4066           " " + "  " +
     4067             " " + sort-column-phrase +
     4068           " " + sort-phrase-26
     4069           )
     4070         parameter-7-26 =
     4071           " indexed-reposition  "
     4072       .
     4073       do
     4074       on stop undo, leave
     4075       on error undo, leave
     4076       :
     4077         assign
     4078           l-disable-where-26 =
     4079             ("  TRUE " + " " + where-phrase-26 = "")
     4080         .
     4081         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     4082                             ,input QUERY br-docs:handle
     4083                             ,input parameter-3-26
     4084                             ,input parameter-4-26
     4085                             ,input parameter-5-26
     4086                             ,input parameter-6-26
     4087                             ,input parameter-7-26
     4088                             )
     4089         .
     4090         assign
     4091           l-filter-open-26 = true
     4092         .
     4093       end.
     4094       if l-filter-open-26 = false then do:
     4095         message
     4096           "Ошибка при фильтрации / сортировке" skip
     4097           "Будут показаны записи без учета фильтра" skip
     4098           view-as alert-box .
     4099       end.
     4100       else do:
     4101           assign
     4102             l-query-was-opened = true
     4103           .
     4104       end.
     4105     end.
     4106     if l-filter-open-26 = false then do:
     4107       OPEN QUERY br-docs FOR EACH temp-ot-line
     4108         where   TRUE
     4109          by temp-ot-line.fact-order descending
     4110         indexed-reposition
     4111     .
     4112         assign
     4113           l-query-was-opened = true
     4114         .
     4115     end.
     4116   end.
     4117   else do:
     4118     assign
     4119       v-doc-rec = recid( temp-ot-line )
     4120     .
     4121     do
     4122     on stop undo, leave
     4123     on error undo, leave
     4124     :
     4125       if QUERY br-docs:handle:get-buffer-handle(1) = (buffer temp-ot-line:handle) then do:
     4126         assign
     4127         parameter-2-26 = (if p-find-next then "true":u else "false":u )
     4128         parameter-4-26 =
     4129           "where ":u + "  TRUE " + " ":u + where-phrase-26 + " ":u + p-find-condition + " " + ""
     4130         parameter-5-26 = "  "
     4131       .
     4132         run fltopend_fltfindd in this-procedure  (
     4133                             input this-procedure:handle
     4134                             ,input QUERY br-docs:handle
     4135                             ,input rowid(temp-ot-line)
     4136                             ,input logical(parameter-2-26)
     4137                             ,input no-lock
     4138                             ,input (buffer temp-ot-line:handle)
     4139                             ,input parameter-4-26
     4140                             ,input parameter-5-26
     4141                             ) no-error.
     4142         .
     4143         assign
     4144           v-doc-rec = integer(return-value)
     4145           v-fltopend-rowid[1] = ?
     4146         .
     4147       end.
     4148       else do:
     4149         assign
     4150         parameter-2-26 = (if p-find-next then "true":u else "false":u )
     4151         parameter-3-26 =  "FOR EACH temp-ot-line"
     4152         parameter-4-26 =
     4153           (
     4154             if ("  TRUE " + " " + where-phrase-26) <> ""
     4155             then "  TRUE " + " " + where-phrase-26
     4156             else "true"
     4157           )
     4158         parameter-5-26 = (" " + "" + " " + "" + " " + p-find-condition)
     4159         parameter-6-26 = if sort-phrase-26 = ''
     4160                              then
     4161           (
     4162           " " + "  " +
     4163             " " + sort-column-phrase +
     4164           " " + " by temp-ot-line.fact-order descending "
     4165           )
     4166                              else
     4167           (
     4168           " " + "  " +
     4169             " " + sort-column-phrase +
     4170           " " + sort-phrase-26
     4171           )
     4172         parameter-7-26 =
     4173           " indexed-reposition  "
     4174       .
     4175         run fltopend_fltfindq in this-procedure  (
     4176                             input this-procedure:handle
     4177                             ,input QUERY br-docs:handle
     4178                             ,input logical(parameter-2-26)
     4179                             ,input no-lock
     4180                             ,input parameter-3-26
     4181                             ,input parameter-4-26
     4182                             ,input parameter-5-26
     4183                             ,input parameter-6-26
     4184                             ,input parameter-7-26
     4185                             ,output v-fltopend-rowid
     4186                             ) no-error.
     4187         .
     4188         v-doc-rec = ?.
     4189       end.
     4190       assign
     4191         l-query-was-opened = true
     4192       .
     4193     end.
     4194   end.
     4195       END.
     4196       otherwise do:
     4197          assign
     4198          v-sign = string(p-sign)
     4199          v-ext-doc-type = p-mode
     4200          ii = lookup(v-ext-doc-type, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U)
     4201          v-doc-type = get-doc-type(input ii,
     4202                                    input-output p-mode,
     4203                                    input-output v-sign,
     4204                                    output v-ext-doc-type-full,
     4205                                    output v-doc-type-full,
     4206                                    output v-idoc-type)
     4207          v-sign-int = integer(v-sign)
     4208          .
     4209          assign
     4210          filter-point = filter-point0 + v-ext-doc-type-full
     4211          filter-label = substitute("&1 v-ext-doc-type-full", filter-label0)
     4212          .
     4213          ASSIGN
     4214          frame Dialog-Frame:TITLE = title0 + chr(32) + v-ext-doc-type-full
     4215          .
     4216          if p-sign = 0 then do:
     4217   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4218   define variable  l-disable-where-28  as logical   no-undo .
     4219   define variable  l-filter-open-28    as logical   .
     4220   define variable  flt-rec-28       as recid     no-undo .
     4221   define variable  filter-name-28      as character no-undo .
     4222   define variable  where-phrase-28     as character no-undo .
     4223   define variable  sort-phrase-28      as character no-undo .
     4224   define variable  where-phrase-rus-28 as character no-undo .
     4225   define variable  sort-phrase-rus-28  as character no-undo .
     4226   run gbl/flt-get.p
     4227     (input filter-point
     4228     ,output flt-rec-28
     4229     ,output filter-name-28
     4230     ,output where-phrase-28
     4231     ,output sort-phrase-28
     4232     ,output where-phrase-rus-28
     4233     ,output sort-phrase-rus-28
     4234     ).
     4235   if p-open-query then do:
     4236       run set-filter-name in this-procedure
     4237         (INPUT filter-name-28
     4238         ) no-error .
     4239     assign
     4240       l-filter-open-28 = false
     4241     .
     4242     if flt-rec-28 <> ?
     4243       or sort-column-phrase > ""
     4244     then do:
     4245       define variable  parameter-2-28 as character no-undo .
     4246       define variable  parameter-3-28 as character no-undo .
     4247       define variable  parameter-4-28 as character no-undo .
     4248       define variable  parameter-5-28 as character no-undo .
     4249       define variable  parameter-6-28 as character no-undo .
     4250       define variable  parameter-7-28 as character no-undo .
     4251         assign
     4252         parameter-3-28 =
     4253                                 "FOR EACH temp-ot-line"
     4254         parameter-4-28 =
     4255           (
     4256             if (" TRUE " + " " + where-phrase-28) <> ""
     4257             then " TRUE " + " " + where-phrase-28
     4258             else "true"
     4259           )
     4260         parameter-5-28 = (" " + "" + " " + "")
     4261         parameter-6-28 = if sort-phrase-28 = ''
     4262                              then
