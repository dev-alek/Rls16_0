     1075         ).
     1076   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1077   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
     1078     (input  v-report-name
     1079     ,input  2
     1080     ,output v-exist
     1081     )  .
     1082       if NOT v-exist then
     1083       DO:
     1084         Message
     1085           "Нет заданий на печать ! "
     1086           view-as alert-box .
     1087         Return  .
     1088       End.
     1089       run gbl/prnfilen.w
     1090         (input  ""
     1091         ,input  p-DisabledOptions
     1092         ,input  string(v-report-name )
     1093         ,input  7
     1094         ,output v-user-action
     1095         ,output v-printed
     1096         ) .
     1097       if v-printed then
     1098       do:
     1099         return "YES" .
     1100       end.
     1101       else
     1102       do:
     1103         return "NO" .
     1104       end.
     1105     end.
     1106   end procedure.
     1107   procedure prn-lib-open-stream :
     1108     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1109     define input parameter p-page-size    as integer no-undo .
     1110     define input parameter p-is-stream    as logical no-undo .
     1111     define input parameter p-append       as logical no-undo .
     1112     define variable v-report-name as character no-undo .
     1113     do
     1114       on error undo, return error
     1115       :
     1116       run prn-lib-get-report-name  in this-procedure (
     1117         input parParentProc
     1118         ,output v-report-name
     1119         ).
     1120       if p-is-stream then
     1121       do:
     1122         if p-append then
     1123         do:
     1124           output stream PrnLibStream to value( v-report-name )
     1125             page-size value(p-page-size) append .
     1126         end.
     1127         if not p-append then
     1128         do:
     1129           output stream PrnLibStream to value( v-report-name )
     1130             page-size value(p-page-size) .
     1131         end.
     1132       end.
     1133       if not p-is-stream then
     1134       do:
     1135         if p-append then
     1136         do:
     1137           output to value( v-report-name )
     1138             page-size value(p-page-size) append .
     1139         end.
     1140         if not p-append then
     1141         do:
     1142           output to value( v-report-name )
     1143             page-size value(p-page-size) .
     1144         end.
     1145       end.
     1146     end.
     1147   end procedure.
     1148   procedure prn-lib-open-exp :
     1149     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1150     define input parameter p-is-stream    as logical no-undo .
     1151     define input parameter p-is-append    as logical no-undo .
     1152     define output parameter p-ReportFileName as char init "report" no-undo.
     1153     define output parameter p-process as logical no-undo .
     1154     define variable glog as logical no-undo .
     1155     do
     1156       on error undo, return error
     1157       :
     1158       SYSTEM-DIALOG GET-FILE p-ReportFileName
     1159         TITLE      "Укажите путь"
     1160         FILTERS "Текстовый файл (*.txt)"   "*.txt"
     1161         ASK-OVERWRITE
     1162         CREATE-TEST-FILE
     1163         SAVE-AS
     1164         USE-FILENAME
     1165         DEFAULT-EXTENSION "txt"
     1166         UPDATE glog
     1167         .
     1168       if not glog then  return.
     1169       p-ReportFileName = trim( string( p-ReportFileName ) ) .
     1170       if p-is-stream then
     1171       do:
     1172         if p-is-append then
     1173         do:
     1174           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1175         end.
     1176         else
     1177         do:
     1178           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1179         end.
     1180       end.
     1181       else
     1182       do:
     1183         if p-is-append then
     1184         do:
     1185           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1186         end.
     1187         else
     1188         do:
     1189           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1190         end.
     1191       end.
     1192       p-process = yes.
     1193     end.
     1194   end procedure.
     1195   procedure prn-lib-get-report-name :
     1196     define input parameter parParentProc  as widget-handle no-undo.
     1197     define output parameter p-report-name as character no-undo .
     1198     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
     1199   end procedure.
     1200   procedure prn-lib-reportviewer-report-name :
     1201     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1202     define input parameter p-report-name-html as character no-undo .
     1203     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
     1204   end procedure.
     1205   procedure prn-lib-reportviewer :
     1206     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1207     define input parameter p-report-name-html as character no-undo .
     1208     define input parameter p-param        as character no-undo .
     1209     define variable v-excel           as character no-undo init 'TRUE' .
     1210     define variable v-value-character as character no-undo .
     1211     define variable v-value-integer   as character no-undo .
     1212     define variable v-value-date      as date      no-undo .
     1213     define variable v-value-decimal   as decimal   no-undo .
     1214     define variable rep-excel         as logical   no-undo .
     1215     define variable excel-string      as character no-undo .
     1216     define variable v-param-type      as character no-undo .
     1217     define variable v-tth             as handle    no-undo .
     1218     run adm/shattri.p (
     1219       input "get":U
     1220       ,input  ""
     1221       ,input  0
     1222       ,input  'report-glob':U
     1223       ,input  'rep-excel':U
     1224       ,output v-value-character
     1225       ,output v-value-date
     1226       ,output v-value-decimal
     1227       ,output v-value-integer
     1228       ,output rep-excel
     1229       ,output v-param-type
     1230       ,INPUT-OUTPUT table-handle v-tth
     1231       )  .
     1232     if rep-excel then v-excel = "TRUE" .
     1233     else v-excel = "FALSE" .
     1234     if p-param eq ""
     1235     then
     1236        p-param = "EXCEL:" + v-excel.
     1237     else
     1238        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
     1239     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
     1240   end procedure.
     1241   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1242   procedure cur-time :
     1243      define output parameter p-today as date      no-undo .
     1244      define output parameter p-time  as integer   no-undo .
     1245     do
     1246     on error undo, return error
     1247     :
     1248       define variable v-date1 as date      no-undo .
     1249       define variable v-date2 as date      no-undo .
     1250       define variable v-time  as integer   no-undo .
     1251       assign
     1252         v-date1 = today
     1253         v-time  = time
     1254         v-date2 = today
     1255       .
     1256       if v-date1 <> v-date2
     1257       then do:
     1258         assign
     1259           v-date1 = today
     1260           v-time  = v-time
     1261         .
     1262       end.
     1263       assign
     1264         p-today = v-date1
     1265         p-time  = v-time
     1266       .
     1267     end.
     1268   end.
     1269   function cur-time-date returns character
     1270   :
     1271     return string(today, '99/99/9999':U) .
     1272   end.
     1273   function cur-time-mjd returns decimal
     1274   :
     1275     define variable v-date as date      no-undo .
     1276     define variable v-time as integer   no-undo .
     1277     run cur-time in this-procedure
     1278       (output v-date
     1279       ,output v-time
     1280       ) .
     1281     return integer(v-date) - 2400002 + (v-time / 86400) .
     1282   end.
     1283   function cur-time-get-ending-index returns integer
     1284   (input p-number as integer
     1285   )
     1286   :
     1287     if p-number < 0
     1288     or p-number = ?
     1289     then do:
     1290       return 1 .
     1291     end.
     1292     define variable v-rest as integer   no-undo .
     1293     assign
     1294       p-number = p-number modulo 100
     1295     .
     1296     if p-number < 20
     1297     then do:
     1298       assign
     1299         v-rest = p-number
     1300       .
     1301     end.
     1302     else do:
     1303       assign
     1304         v-rest = p-number modulo 10
     1305       .
     1306     end.
     1307     case v-rest :
     1308       when 1
     1309       then do:
     1310         return 2 .
     1311       end.
     1312       when 2 or
     1313       when 3 or
     1314       when 4
     1315       then do:
     1316         return 3 .
     1317       end.
     1318       otherwise do:
     1319         return 1 .
     1320       end.
     1321     end case .
     1322   end.
     1323   procedure cur-time-mjd-to-date :
     1324      define input  parameter i-mjd-diff as decimal no-undo.
     1325      define output parameter o-Date     as date    no-undo.
     1326      define output parameter o-Time     as integer no-undo.
     1327      define variable v-day-number as integer   no-undo .
     1328      if    i-mjd-diff < 0
     1329         or i-mjd-diff = ?
     1330      then do:
     1331         return "?" .
     1332      end.
     1333      assign
     1334         v-day-number = truncate(i-mjd-diff,0).
     1335         o-Date = date(v-day-number + 2400002).
     1336         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     1337     .
     1338   end.
     1339   function cur-time-mjd-to-string returns character
     1340   (input p-mjd-diff as decimal
     1341   )
     1342   :
     1343     define variable v-day-number as integer   no-undo .
     1344     define variable v-seconds    as integer   no-undo .
     1345     define variable v-hour       as integer   no-undo .
     1346     define variable v-min        as integer   no-undo .
     1347     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     1348     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     1349     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     1350     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1351     if p-mjd-diff < 0
     1352     or p-mjd-diff = ?
     1353     then do:
     1354       return "?" .
     1355     end.
     1356     assign
     1357       v-day-number = integer(truncate(p-mjd-diff,0))
     1358       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1359     .
     1360     if v-seconds > 86400
     1361     then do:
     1362       assign
     1363         v-seconds = 86400 - 1
     1364       .
     1365     end.
     1366     if v-seconds < 0
     1367     then do:
     1368       assign
     1369         v-seconds = 0
     1370       .
     1371     end.
     1372     assign
     1373       v-hour = truncate(v-seconds / 3600, 0)
     1374     .
     1375     assign
     1376       v-seconds = v-seconds modulo 3600
     1377     .
     1378     assign
     1379       v-min = truncate(v-seconds / 60, 0)
     1380     .
     1381     assign
     1382       v-seconds = v-seconds modulo 60
     1383     .
     1384     return
     1385         (if v-day-number <> 0
     1386           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1387           else ""
     1388         )
     1389       + (if v-day-number <> 0 or v-hour <> 0
     1390           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1391           else ""
     1392         )
     1393       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1394           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1395           else ""
     1396         )
     1397       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1398       .
     1399   end.
     1400   function cur-time-string returns character
     1401   :
     1402     define variable v-date as date      no-undo .
     1403     define variable v-time as integer   no-undo .
     1404     run cur-time in this-procedure
     1405       (output v-date
     1406       ,output v-time
     1407       ) .
     1408     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1409   end.
     1410   function cur-time-string-sec returns character
     1411   :
     1412     define variable v-date as date      no-undo .
     1413     define variable v-time as integer   no-undo .
     1414     run cur-time in this-procedure
     1415       (output v-date
     1416       ,output v-time
     1417       ) .
     1418     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1419   end.
     1420   function cur-time-custom  returns character
     1421   (input p-prefix as character
     1422   ,input p-date-format as character
     1423   ,input p-delimiter as character
     1424   ,input p-time-format as character
     1425   ,input p-suffix as character
     1426   )
     1427   :
     1428     define variable v-date as date      no-undo .
     1429     define variable v-time as integer   no-undo .
     1430     run cur-time in this-procedure
     1431       (output v-date
     1432       ,output v-time
     1433       ) .
     1434     return
     1435       p-prefix
     1436       + string(v-date, p-date-format)
     1437       + p-delimiter
     1438       + string(v-time, p-time-format)
     1439       + p-suffix
     1440       .
     1441   end.
     1442   function cur-time-print  returns character
     1443   :
     1444     define variable v-date as date      no-undo .
     1445     define variable v-time as integer   no-undo .
     1446     run cur-time in this-procedure
     1447       (output v-date
     1448       ,output v-time
     1449       ) .
     1450     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1451   end.
     1452   function cur-time-datetime returns datetime
     1453   :
     1454     define variable v-char as character no-undo .
     1455     define variable v-datetime as datetime no-undo .
     1456     v-char = cur-time-string().
     1457     v-datetime = datetime(v-char).
     1458     return  v-datetime.
     1459   end.
     1460   function cur-time-string-msec returns character
     1461   :
     1462     define variable v-date as datetime  no-undo .
     1463     v-date = now.
     1464     return string(v-date) .
     1465   end.
