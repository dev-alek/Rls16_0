     1475   procedure fltfield-clear :
     1476     define output parameter loc-fld as character no-undo.
     1477     define output parameter loc-lab as character no-undo .
     1478     define output parameter loc-spr as character no-undo .
     1479     define output parameter loc-dim as character no-undo .
     1480     assign
     1481       loc-fld = ""
     1482       loc-lab = ""
     1483       loc-spr = ""
     1484       loc-dim = "0"
     1485     .
     1486   end procedure .
     1487   procedure fltfield-add :
     1488     define input        parameter par-fld as character no-undo.
     1489     define input        parameter par-lab as character no-undo .
     1490     define input        parameter par-spr as character no-undo .
     1491     define input-output parameter loc-fld as character no-undo.
     1492     define input-output parameter loc-lab as character no-undo .
     1493     define input-output parameter loc-spr as character no-undo .
     1494     define input-output parameter loc-dim as character no-undo .
     1495     do
     1496     on error undo, return error
     1497     :
     1498       assign
     1499       loc-fld = if loc-dim = '0'
     1500                 then par-fld
     1501                 else (loc-fld + chr(44) + par-fld)
     1502       loc-lab = if loc-dim = '0'
     1503                 then par-lab
     1504                 else (loc-lab + chr(44) + par-lab)
     1505       loc-spr = if loc-dim = '0'
     1506                 then par-spr
     1507                 else (loc-spr + chr(44) + par-spr)
     1508       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
     1509                 string(integer(if num-entries(loc-dim) > 1
     1510                               then entry(2, loc-dim)
     1511                               else entry(1, loc-dim)
     1512                               ) + 1)
     1513       no-error
     1514       .
     1515     end.
     1516   end procedure.
