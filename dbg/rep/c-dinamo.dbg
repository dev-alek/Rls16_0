     4824   END PROCEDURE.
     4825   PROCEDURE print-line-doc :
     4826   define buffer buf_trn-doc for ub.trn-doc.
     4827   define buffer buf_price-doc for ub.price-doc.
     4828   define buffer buf_temp_trn-doc-code     for temp_trn-doc-code.
     4829   if not available temp-ot-line then return error.
     4830   CASE temp-ot-line.ext-doc-type:
     4831       when 'ot':U
     4832       then do:
     4833           find first buf_price-doc no-lock where buf_price-doc.doc-num = temp-ot-line.doc-code no-error.
     4834           if not available buf_price-doc then return error.
     4835           run rep/pr-dprn.w ( input parparentproc, recid( buf_price-doc ) ).
     4836       end.
     4837       otherwise do:
     4838           find first buf_trn-doc no-lock where buf_trn-doc.doc-code = temp-ot-line.doc-code no-error.
     4839           if not available buf_trn-doc then return error.
     4840           empty temp-table buf_temp_trn-doc-code.
     4841           create buf_temp_trn-doc-code.
     4842           assign
     4843               buf_temp_trn-doc-code.doc-code = buf_trn-doc.doc-code
     4844           .
     4845           run rep/d-docm.w ( input parparentproc, input this-procedure, input table buf_temp_trn-doc-code ).
     4846       end.
     4847   END CASE.
     4848   END PROCEDURE.
     4849   PROCEDURE print-list-doc :
     4850   DEFINE VARIABLE v-get-doc as character no-undo .
     4851   define variable v-contra like ub.clients.obj-name no-undo.
     4852   define variable v-fact-date as date no-undo.
     4853   DEFINE VARIABLE v-obj as character no-undo .
     4854   DEFINE VARIABLE v-vat-pc as decimal no-undo .
     4855   DEFINE VARIABLE v-slt-pc as decimal no-undo .
     4856   DEFINE VARIABLE v-price-base as decimal no-undo .
     4857   DEFINE VARIABLE v-price-rubl as decimal no-undo .
     4858   DEFINE VARIABLE accum-fact-qnty as decimal no-undo .
     4859   DEFINE VARIABLE accum-sum-rubl as decimal no-undo .
     4860   DEFINE VARIABLE accum-sum-base as decimal no-undo .
     4861   DEFINE VARIABLE accum-VAT-rubl as decimal no-undo .
     4862   DEFINE VARIABLE accum-VAT-base as decimal no-undo .
     4863   DEFINE VARIABLE accum-SLT-rubl as decimal no-undo .
     4864   DEFINE VARIABLE accum-SLT-base as decimal no-undo .
     4865   DEFINE VARIABLE accum-transport-base as decimal no-undo .
     4866   DEFINE VARIABLE accum-transport-rubl as decimal no-undo .
     4867   DEFINE VARIABLE accum-other-base as decimal no-undo .
     4868   DEFINE VARIABLE accum-other-rubl as decimal no-undo .
     4869   DEFINE VARIABLE accum-road-tax-base as decimal no-undo .
     4870   DEFINE VARIABLE accum-road-tax-rubl as decimal no-undo .
     4871   DEFINE VARIABLE accum-excise-base as decimal no-undo .
     4872   DEFINE VARIABLE accum-excise-rubl as decimal no-undo .
     4873   DEFINE VARIABLE accum-count     as integer no-undo .
     4874   DEFINE VARIABLE date_string as character no-undo .
     4875   DEFINE VARIABLE Line as character no-undo .
     4876   define variable v-doc-rec as recid no-undo .
     4877   define buffer buf_t-stk for t-stk.
     4878   define frame Fdinamo
     4879   v-get-doc COLUMN-LABEL "Тип док-та" format "X(18)"
     4880   temp-ot-line.doc-code
     4881   v-obj COLUMn-LABEL "Объект" format "X(8)"
     4882   v-fact-date COLUMN-LABEL "Факт.дата" format "99/99/9999"
     4883   v-contra column-label "Контрагент" format "X(20)"
     4884   temp-ot-line.fact-qnty COLUMN-LABEL "Кол-во" format "->>,>>>,>>9.999"
     4885   temp-ot-line.sum-rubl COLUMN-LABEL "Сумма"  format "->>,>>>,>>>,>>>,>>9.99"
     4886   v-price-rubl column-label "Цена приведенная" format "->>,>>>,>>>,>>>,>>9.99"
     4887   v-vat-pc COLUMn-LABEL "НДС" format "99.99"
     4888   temp-ot-line.VAT-rubl COLUMN-LABEL "Сумма НДС" format "->>,>>>,>>>,>>>,>>9.99"
     4889   v-slt-pc COLUMn-LABEL "НП" format "99.99"
     4890   temp-ot-line.SLT-rubl COLUMN-LABEL "Сумма НП" format "->>,>>>,>>>,>>>,>>9.99"
     4891   HEADER  date_string AT 5 format "X(35)"
     4892   string( "Страница " ) format "X(9)" AT 50 PAGE-NUMBER(PrnLibStream) AT 60 FORMAT ">>9" SKIP
     4893   Line format "X(181)" AT 1
     4894   with width 232 down stream-io use-text    .
     4895   Line = fill("-", 181).
     4896   date_string = cur-time-print() .
     4897   run prn-lib-open-stream  in this-procedure (
     4898                                                input parParentProc
     4899                                               ,input 232
     4900                                               ,input yes
     4901                                               ,input no
     4902                                               ).
     4903   PUT  STREAM PrnLibStream unformatted
     4904   frame Dialog-Frame:title format "x(181)" chr(10)
     4905   (fill(chr(32), 20) +
     4906    "(":U +  (if RS-curr = "rubl":U then "Рубли" else "Баз.вал.") + ")":U) skip
     4907    str4
     4908    SKIP(1) .
     4909   FORM HEADER
     4910   Line format "X(181)" AT 1 SKIP
     4911   "Продолжение - на следующей странице" AT 30 SKIP
     4912   with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     4913   VIEW  STREAM PrnLibStream FRAME BottomFrame .
     4914   run waitfram-show in this-procedure("Ждите...").
     4915   v-doc-rec = recid( temp-ot-line ).
     4916   DO WHILE available temp-ot-line :
     4917      GET prev br-docs.
     4918   END.
     4919   GET next br-docs.
     4920   FORM with FRAME FDinamo  .
     4921   DO WHILE available temp-ot-line :
     4922   display stream PrnLibStream
     4923   get-doc( input temp-ot-line.doc-code, input temp-ot-line.ext-doc-type, (if temp-ot-line.fact-qnty > 0 then 1 else - 1), output v-fact-date, output v-contra)
     4924     @ v-get-doc
     4925   temp-ot-line.doc-code
     4926   (temp-ot-line.obj-type + string(temp-ot-line.obj-code )) @ v-obj
     4927   v-fact-date
     4928   v-contra
     4929   temp-ot-line.fact-qnty
     4930   (IF Rs-curr = "rubl":U
     4931   then  temp-ot-line.sum-rubl
     4932    else  temp-ot-line.sum-base) @ temp-ot-line.sum-rubl
     4933   (IF Rs-curr = "rubl":U
     4934   then  temp-ot-line.sum-rubl / temp-ot-line.fact-qnty
     4935   else temp-ot-line.sum-base / temp-ot-line.fact-qnty) @ v-price-rubl
     4936   decimal(entry(1, temp-ot-line.cat-id)) @ v-vat-pc
     4937   (IF Rs-curr = "rubl":U
     4938   then  temp-ot-line.VAT-rubl
     4939   else temp-ot-line.VAT-base) @ temp-ot-line.Vat-rubl
     4940   decimal(entry(2, temp-ot-line.cat-id)) @ v-slt-pc
     4941   (IF Rs-curr = "rubl":U
     4942   then  temp-ot-line.SLT-rubl
     4943   else temp-ot-line.SLT-base) @ temp-ot-line.SLt-rubl
     4944     WITH FRAME Fdinamo.
     4945     DOWN STREAM PrnLibStream 1 with FRAME FDinamo .
     4946     assign
     4947     accum-count            = accum-count            +    1
     4948     accum-fact-qnty        = accum-fact-qnty        +    temp-ot-line.fact-qnty
     4949     accum-sum-rubl         = accum-sum-rubl         +    temp-ot-line.sum-rubl
     4950     accum-sum-base         = accum-sum-base         +    temp-ot-line.sum-base
     4951     accum-VAT-rubl         = accum-VAT-rubl         +    temp-ot-line.VAT-rubl
     4952     accum-VAT-base         = accum-VAT-base         +    temp-ot-line.VAT-base
     4953     accum-SLT-rubl         = accum-SLT-rubl         +    temp-ot-line.SLT-rubl
     4954     accum-SLT-base         = accum-SLT-base         +    temp-ot-line.SLT-base
     4955     accum-transport-base   = accum-transport-base   +    temp-ot-line.transport-base
     4956     accum-transport-rubl   = accum-transport-rubl   +    temp-ot-line.transport-rubl
     4957     accum-other-base       = accum-other-base       +    temp-ot-line.other-base
     4958     accum-other-rubl       = accum-other-rubl       +    temp-ot-line.other-rubl
     4959     accum-road-tax-base    = accum-road-tax-base    +    temp-ot-line.road-tax-base
     4960     accum-road-tax-rubl    = accum-road-tax-rubl    +    temp-ot-line.road-tax-rubl
     4961     accum-excise-base      = accum-excise-base      +    temp-ot-line.excise-base
     4962     accum-excise-rubl      = accum-excise-rubl      +    temp-ot-line.excise-rubl
     4963     .
     4964     GET next br-docs.
     4965   END.
     4966   UNDERLINE stream PrnLibStream
     4967   v-get-doc
     4968   temp-ot-line.doc-code
     4969   v-obj
     4970   v-fact-date
     4971   v-contra
     4972   temp-ot-line.fact-qnty
     4973   temp-ot-line.sum-rubl
     4974   v-price-rubl
     4975   v-vat-pc
     4976   temp-ot-line.VAT-rubl
     4977   v-slt-pc
     4978   temp-ot-line.SLT-rubl
     4979   WITH FRAME Fdinamo.
     4980   DOWN STREAM PrnLibStream 1 with FRAME FDinamo .
     4981   display stream PrnLibStream
     4982   string(accum-count)      @   v-get-doc
     4983   accum-fact-qnty          @   temp-ot-line.fact-qnty
     4984   (If RS-curr = "rubl":U
     4985   then accum-sum-rubl
     4986   else accum-sum-base)      @   temp-ot-line.sum-rubl
     4987   (If RS-curr = "rubl":U
     4988   then accum-VAT-rubl
     4989   else accum-VAT-base)           @   temp-ot-line.VAT-rubl
     4990   accum-SLT-rubl           @   temp-ot-line.SLT-rubl
     4991   WITH FRAME Fdinamo.
     4992   DOWN STREAM PrnLibStream 1 with FRAME FDinamo .
     4993   if p-mode = 'все':U then do:
     4994     DISPLAY stream PrnLibStream
     4995     "Остатки"  @ v-get-doc
     4996     WITH FRAME Fdinamo.
     4997     DOWN STREAM PrnLibStream 1 with FRAME FDinamo .
     4998     for each buf_t-stk no-lock where
     4999             buf_t-stk.ym = t-month.ym:
     5000       DISPLAY stream PrnLibStream
     5001       buf_t-stk.b-a-full  @ v-get-doc
     5002       buf_t-stk.fact-qnty @ temp-ot-line.fact-qnty
     5003       (If RS-curr = "rubl":U
     5004     then  buf_t-stk.sale-sum-rubl
     5005     else   buf_t-stk.sale-sum-base)  @ temp-ot-line.sum-rubl
     5006       WITH FRAME Fdinamo.
     5007       DOWN STREAM PrnLibStream 1 with FRAME FDinamo .
     5008     end.
     5009   end.
     5010   HIDE  STREAM PrnLibStream FRAME BottomFrame .
     5011   HIDE  STREAM PrnLibStream FRAME Fdinamo.
     5012   output STREAM PrnLibStream CLOSE.
     5013   run waitfram-hide in this-procedure.
     5014   run prn-lib-prn-file in this-procedure (
     5015                                             input parParentProc
     5016                                             ,input 0
     5017                                             ).
     5018   reposition br-docs to recid v-doc-rec no-error.
     5019   APPLY "entry" to br-docs.
     5020   END PROCEDURE.
     5021   PROCEDURE print-other :
     5022   define variable v-last-day as integer no-undo.
     5023   ASSIGN v-last-day = last-day( date( t-month.month_, 1, t-month.year_ ) ).
     5024   CASE print-option:
     5025       when "card":U then dO:
     5026         run proc-print-crd in this-procedure  (
     5027                                                    buf_goods.artic
     5028                                                   ,buf_goods.prod-type
     5029                                                   ,buf_goods.prod-code
     5030                                                   ,date(t-month.month_, 1, t-month.year_)
     5031                                                   ,date(t-month.month_, v-last-day, t-month.year_   )
     5032                              ) no-error  .
     5033       end.
     5034       when "oborot":U then do:
     5035         run proc-print-oborot in this-procedure  (
     5036                                                    buf_goods.artic
     5037                                                   ,buf_goods.prod-type
     5038                                                   ,buf_goods.prod-code
     5039                                                   ,date(t-month.month_, 1, t-month.year_)
     5040                                                   ,date(t-month.month_, v-last-day, t-month.year_   )
     5041                                                    )
     5042         no-error.
     5043       end.
     5044   END CASE.
     5045   END PROCEDURE.
     5046   PROCEDURE proc-b-doc :
     5047   if not available temp-ot-line then do:
     5048       return error.
     5049   end.
     5050   run str/showdoc.p (input parparentproc,
     5051                           input temp-ot-line.doc-code
     5052                          ,input buf_goods.artic
     5053                          ,input buf_goods.prod-type
     5054                          ,input buf_goods.prod-code
     5055                          ,input ?).
     5056   END PROCEDURE.
     5057   PROCEDURE proc-b-move :
     5058   DEFINE INPUT PARAMETER par-action as character No-UNDO.
     5059   DEFINE VARIABLE  loc#log as logical no-undo .
     5060     ASSIGN p-doc-rec = RECID( t-month ).
     5061     CASE par-action:
     5062       when "b-next":U then do:
     5063         if valid-handle (p-br-handle) then do:
     5064           loc#log = p-br-handle:select-next-row().
     5065         end.
     5066       end.
     5067       when "b-prev":U then do:
     5068         if valid-handle (p-br-handle) then do:
     5069           loc#log = p-br-handle:select-prev-row().
     5070         end.
     5071       end.
     5072     END CASE.
     5073     ASSIGN p-doc-rec = RECID( t-month ).
     5074     if not loc#log then DO:
     5075       MESSAGE
     5076         "Это" ( IF par-action = "B-Next":U THEN "последний" ELSE "первый" )
     5077         "месяц в списке!"
     5078       VIEW-AS ALERT-BOX INFORMATION.
     5079       RETURN NO-APPLY.
     5080     END.
     5081   END PROCEDURE.
     5082   PROCEDURE proc-b-print :
     5083      if print-option = "" then do:
     5084        run gbl/pop-up.p (self:handle, no) no-error.
     5085      end.
     5086      if print-option = "":U then return error.
     5087      CASE print-option:
     5088       when "document" then do:
     5089           run print-line-doc in this-procedure no-error.
     5090       end.
     5091       when "list" then do:
     5092           run print-list-doc in this-procedure no-error.
     5093       end.
     5094       otherwise do:
     5095           run print-other in this-procedure no-error.
     5096       end.
     5097      END.
     5098      assign
     5099      print-option = "":U.
     5100   END PROCEDURE.
     5101   PROCEDURE proc-b-sch :
     5102   assign
     5103     tbl = 'ot-line'
     5104     join-tbl = 'temp-ot-line'
     5105     fld = ""
     5106     lab = ""
     5107     spr = ""
     5108     dim = '0'
     5109     .
     5110   run fltfield-add in this-procedure('doc-code', 'Номер док-та', '',
     5111   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5112   run fltfield-add in this-procedure('fact-order', 'Факт.дата', 'fact-order-d',
     5113   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5114   run fltfield-add in this-procedure('obj-type*obj-code', 'Объект', 'cli',
     5115   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5116   if p-mode = 'все':U then do:
     5117     run fltfield-add in this-procedure('ext-doc-type', 'Тип док-та', 'ext-doc-type',
     5118     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5119   end.
     5120   run fltfield-add in this-procedure('sum-rubl', 'Сумма рубли', '',
     5121   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5122   run fltfield-add in this-procedure('sum-base', 'Сумма баз.вал.', '',
     5123   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5124   Filter-Block:
     5125   DO ON STOP    UNDO Filter-Block, LEAVE Filter-Block
     5126       ON ERROR   UNDO Filter-Block, LEAVE Filter-Block
     5127       ON END-KEY UNDO Filter-Block, LEAVE Filter-Block :
     5128     run gbl/filter.w ( input parparentproc
     5129                      , INPUT (filter-point + chr(4) + filter-label)
     5130                      , INPUT tbl
     5131                      , INPUT join-tbl
     5132                      , INPUT fld
     5133                      , INPUT lab
     5134                      , INPUT spr
     5135                      , INPUT dim ).
     5136     if return-value = 'undo':U then return error.
     5137     RUN OpenBr in this-procedure ( input yes, input no, input '':U).
     5138   END.
     5139   END PROCEDURE.
     5140   FUNCTION get-doc RETURNS character
     5141     ( input p-doc-code as character, input p-ext-doc-type as character, input p-sign-int as integer, output p-fact-date  as date, output p-contra as character) :
     5142   DEFINE VARIABLE v-ext-doc-type as character no-undo .
     5143   DEFINE VARIABLE v-ext-doc-type-full as character no-undo .
     5144   DEFINE VARIABLE v-doc-type as character no-undo .
     5145   DEFINE VARIABLE v-doc-type-full as character no-undo .
     5146   DEFINE VARIABLE v-idoc-type as character no-undo .
     5147   DEFINE VARIABLE v-sign as character no-undo .
     5148   DEFINE VARIABLE v-sign-int as integer no-undo .
     5149   DEFINE VARIABLE ii as integer no-undo.
     5150   define buffer buf_trn-doc for ub.trn-doc .
     5151   define buffer buf_price-doc for ub.price-doc .
     5152     assign
     5153     v-ext-doc-type = p-ext-doc-type
     5154     ii = lookup(v-ext-doc-type, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U)
     5155     v-sign = string(p-sign-int)
     5156     v-doc-type = get-doc-type(input ii, input-output v-ext-doc-type, input-output v-sign, output v-ext-doc-type-full, output v-doc-type-full, output v-idoc-type)
     5157     .
     5158   CASE p-ext-doc-type:
     5159       when 'ot':U then do:
     5160           find first buf_price-doc no-lock where buf_price-doc.doc-num = p-doc-code.
     5161               assign
     5162       p-fact-date = buf_price-doc.fact-date
     5163       p-contra = "":U
     5164       .
     5165       end.
     5166       otherwise do:
     5167           find first buf_trn-doc no-lock where buf_trn-doc.doc-code = p-doc-code.
     5168                       assign
     5169       p-fact-date = buf_trn-doc.fact-date
     5170       p-contra = buf_trn-doc.cli-name
     5171       .
     5172    end.
     5173   END CASE.
     5174     RETURN v-ext-doc-type-full.
     5175   END FUNCTION.
