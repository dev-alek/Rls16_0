      627   define variable var-report-r-b as character no-undo .
      628   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      629   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      630     (output var-report-r-b
      631     )  .
      632   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      633   DEF VAR BLACK_COLOR        AS INTEGER NO-UNDO INIT  0.
      634   DEF VAR DARK_BLUE_COLOR    AS INTEGER NO-UNDO INIT  1.
      635   DEF VAR DARK_GREEN_COLOR   AS INTEGER NO-UNDO INIT  2.
      636   DEF VAR CYAN_COLOR         AS INTEGER NO-UNDO INIT  3.
      637   DEF VAR BROWN_COLOR        AS INTEGER NO-UNDO INIT  4.
      638   DEF VAR DARK_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
      639   DEF VAR DARK_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
      640   DEF VAR VERY_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
      641   DEF VAR VERY_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
      642   DEF VAR GRAY_COLOR         AS INTEGER NO-UNDO INIT  8.
      643   DEF VAR GREY_COLOR         AS INTEGER NO-UNDO INIT  8.
      644   DEF VAR BLUE_COLOR         AS INTEGER NO-UNDO INIT  9.
      645   DEF VAR GREEN_COLOR        AS INTEGER NO-UNDO INIT 10.
      646   DEF VAR RED_COLOR          AS INTEGER NO-UNDO INIT 12.
      647   DEF VAR LIGHT_RED_COLOR    AS INTEGER NO-UNDO INIT 13.
      648   DEF VAR YELLOW_COLOR       AS INTEGER NO-UNDO INIT 14.
      649   DEF VAR WHITE_COLOR        AS INTEGER NO-UNDO INIT 15.
      650   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      651   procedure factord :
      652     define input  parameter p-fact-date            as date    no-undo .
      653     define input  parameter p-fact-time            as integer no-undo .
      654     define input  parameter p-fact-num             as integer no-undo .
      655     define input  parameter p-shift-date           as date    no-undo .
      656     define input  parameter p-shift-num            as integer no-undo .
      657     define input  parameter p-shift-on             as logical no-undo .
      658     define output parameter p-fact-order           as decimal no-undo .
      659     define output parameter p-shift-end-fact-order as decimal no-undo .
      660     define output parameter p-day-end-fact-order   as decimal no-undo .
      661     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      662     if p-fact-date = ?
      663     then do:
      664       return error "Не указана фактическая дата" .
      665     end.
      666     define variable v-fact-date-num as integer no-undo .
      667     assign
      668       v-fact-date-num = integer(p-fact-date)
      669     .
      670     if p-fact-num = ?
      671     or p-fact-num = 0
      672     then do:
      673       return error "Не задан p-fact-num " + string(p-fact-num) .
      674     end.
      675     if p-fact-num < 0
      676     then do:
      677       return error "Отрицательный fact-num " + string(p-fact-num) .
      678     end.
      679     if p-fact-num >= 100000000
      680     then do:
      681       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      682     end.
      683     if p-shift-on = true
      684     then do:
      685       if p-shift-date = ?
      686       then do:
      687         return error "Не задана дата смены" .
      688       end.
      689       if p-shift-num = ?
      690       or p-shift-num = 0
      691       then do:
      692         return error "Не задан номер смены" .
      693       end.
      694     end.
      695     else do:
      696       assign
      697         p-shift-date = p-fact-date
      698         p-shift-num  = 24
      699       .
      700     end.
      701     define variable v-shift-offset as integer no-undo .
      702     if p-shift-date = p-fact-date
      703     then do:
      704       assign
      705         v-shift-offset = 1
      706       .
      707     end.
      708     if p-shift-date < p-fact-date
      709     then do:
      710       assign
      711         v-shift-offset = 0
      712       .
      713     end.
      714     if p-shift-date > p-fact-date
      715     then do:
      716       message
      717         vss-workfile vss-revision vss-description skip
      718         "Неправильная дата закрытия смены" skip
      719         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      720         view-as alert-box error .
      721       undo, return error
      722         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      723           ,string(p-fact-date, '99/99/9999':U)
      724           ,string(p-shift-date, '99/99/9999':U)
      725           )
      726       .
      727     end.
      728     if p-shift-num < 1
      729     or p-shift-num > 24
      730     then do:
      731       message
      732         vss-workfile vss-revision vss-description skip
      733         "Неправильный номер смены" skip
      734         "p-shift-num" p-shift-num skip
      735         view-as alert-box error .
      736       undo, return error return-value .
      737     end.
      738     assign
      739       p-fact-order           = v-fact-date-num
      740                              + v-shift-offset * 0.5
      741                              + p-shift-num    * 0.02 - 0.01
      742                              + p-fact-num     * 0.0000000001
      743       p-shift-end-fact-order = v-fact-date-num
      744                              + v-shift-offset * 0.5
      745                              + p-shift-num    * 0.02
      746       p-day-end-fact-order   = v-fact-date-num
      747                              + 0.99
      748     .
      749     if p-fact-order           <= v-fact-date-num
      750     or p-shift-end-fact-order <= v-fact-date-num
      751     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      752     or p-shift-end-fact-order >= p-day-end-fact-order
      753     then do:
      754       message
      755         vss-workfile vss-revision vss-description skip
      756         "Внутренняя ошибка при генерации фактического номера" skip
      757         "p-fact-date"            p-fact-date            skip
      758         "p-fact-time"            p-fact-time            skip
      759         "p-fact-num"             p-fact-num             skip
      760         "p-shift-date"           p-shift-date           skip
      761         "p-shift-num"            p-shift-num            skip
      762         "p-shift-on"             p-shift-on             skip
      763         "p-shift-end-fact-order" p-shift-end-fact-order skip
      764         "p-day-end-fact-order"   p-day-end-fact-order   skip
      765         "v-fact-date-num"        v-fact-date-num        skip
      766         view-as alert-box error .
      767       undo, return error return-value .
      768     end.
      769   end procedure.
      770   procedure day-begin-fact-order :
      771     define input  parameter p-fact-date            as date    no-undo .
      772     define output parameter p-day-begin-fact-order as decimal no-undo .
      773     do
      774     on error undo, return error return-value
      775     :
      776       if p-fact-date = ?
      777       then do:
      778         assign
      779           p-day-begin-fact-order = 0
      780         .
      781       end.
      782       else do:
      783         assign
      784           p-day-begin-fact-order = integer(p-fact-date)
      785         .
      786       end.
      787     end.
      788   end procedure.
      789   procedure factord-max-fact-order :
      790     define output parameter p-max-fact-order as decimal   no-undo .
      791     do
      792     on error undo, return error return-value
      793     :
      794       run day-begin-fact-order in this-procedure
      795         (input  date(1, 1, 5000)
      796         ,output p-max-fact-order
      797         ) .
      798     end.
      799   end procedure.
      800   procedure factord-cut-archive :
      801     define input  parameter p-obj-type             as character no-undo .
      802     define input  parameter p-obj-code             as integer   no-undo .
      803     define input  parameter p-fact-date            as date      no-undo .
      804     define output parameter p-shift-on             as logical   no-undo .
      805     define output parameter p-shift-date           as date      no-undo .
      806     define output parameter p-shift-num            as integer   no-undo .
      807     define output parameter p-day-end-fact-order   as decimal   no-undo .
      808     define output parameter p-shift-end-fact-order as decimal   no-undo .
      809     define variable v-fact-order as decimal   no-undo .
      810     define buffer buf_shift-obj for ub.shift-obj .
      811     do
      812     on error undo, return error return-value
      813     :
      814   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      815   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      816     (input  p-obj-type
      817     ,input  p-obj-code
      818     ,input  'shift-on=request'
      819     ,output p-shift-on
      820     ) no-error .
      821       if error-status :error
      822       then do:
      823         message
      824           vss-workfile vss-revision vss-description skip
      825           "Ошибка при определении атрибута объекта" skip
      826           "Объект" p-obj-type p-obj-code skip
      827           error-status :get-message(1) skip
      828           return-value skip
      829           view-as alert-box error .
      830         undo, return error return-value .
      831       end.
      832       if p-shift-on = false
      833       then do:
      834         assign
      835           p-shift-date               = ?
      836           p-shift-num                = 0
      837         .
      838       end.
      839       else do:
      840         find first buf_shift-obj share-lock
      841           where buf_shift-obj.obj-type   = p-obj-type
      842             and buf_shift-obj.obj-code   = p-obj-code
      843             and buf_shift-obj.shift-date > p-fact-date
      844           use-index pi
      845           no-error .
      846         if not available buf_shift-obj
      847         or buf_shift-obj.status_ <> 'зкр':U
      848         then do:
      849           message
      850             vss-workfile vss-revision vss-description skip
      851             "Невозможно вычислить последнюю смену" skip
      852             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      853             "Объект" p-obj-type p-obj-code skip
      854             "Дата" p-fact-date skip
      855             view-as alert-box error .
      856           undo, return error return-value .
      857         end.
      858         find last buf_shift-obj share-lock
      859           where buf_shift-obj.obj-type = p-obj-type
      860             and buf_shift-obj.obj-code = p-obj-code
      861             and buf_shift-obj.shift-date <= p-fact-date
      862           use-index pi
      863           no-error .
      864         if available buf_shift-obj
      865         then do:
      866           if  buf_shift-obj.status_ = 'зкр':U
      867           then do:
      868             assign
      869               p-shift-date = buf_shift-obj.shift-date
      870               p-shift-num  = buf_shift-obj.shift-num
      871             .
      872           end.
      873           else do:
      874             message
      875               vss-workfile vss-revision vss-description skip
      876               "Невозможно вычислить последнюю смену" skip
      877               "Статус смены отличен от статуса" 'зкр':U skip
      878               "Объект" p-obj-type p-obj-code skip
      879               "Дата" p-fact-date skip
      880               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      881               view-as alert-box error .
      882             undo, return error return-value .
      883           end.
      884         end.
      885         else do:
      886           assign
      887             p-shift-date = p-fact-date - 1
      888             p-shift-num  = 1
      889           .
      890         end.
      891       end.
      892       run factord in this-procedure
      893         (input  p-fact-date
      894         ,input  1
      895         ,input  1
      896         ,input  p-shift-date
      897         ,input  p-shift-num
      898         ,input  p-shift-on
      899         ,output v-fact-order
      900         ,output p-shift-end-fact-order
      901         ,output p-day-end-fact-order
      902         ) no-error .
      903       if error-status :error
      904       then do:
      905         message
      906           vss-workfile vss-revision vss-description skip
      907           "Ошибка при вызове процедуры factord"
      908           error-status :get-message(1) skip
      909           return-value skip
      910           view-as alert-box error .
      911         undo, return error return-value .
      912       end.
      913     end.
      914   end procedure.
      915   procedure factord-lock-shift :
      916     define input  parameter p-obj-type  as character no-undo .
      917     define input  parameter p-obj-code  as integer   no-undo .
      918     define input  parameter p-fact-date as date      no-undo .
      919     define parameter buffer buf_shift-obj for ub.shift-obj .
      920     define variable v-shift-on      as logical   no-undo .
      921     define variable v-extra-message as character no-undo .
      922     define variable v-error as character no-undo .
      923     do
      924     on error undo, return error return-value
      925     :
      926   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      927   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      928     (input  p-obj-type
      929     ,input  p-obj-code
      930     ,input  'shift-on=request'
      931     ,output v-shift-on
      932     ) no-error .
      933       if error-status :error
      934       then do:
      935         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
      936         undo, return error v-error .
      937       end.
      938       if v-shift-on = true
      939       then do:
      940         find first buf_shift-obj share-lock
      941           where buf_shift-obj.obj-type   = p-obj-type
      942             and buf_shift-obj.obj-code   = p-obj-code
      943             and buf_shift-obj.shift-date > p-fact-date
      944           use-index pi
      945           no-error .
      946         if not available buf_shift-obj
      947         or buf_shift-obj.status_ <> 'зкр':U
      948         then do:
      949           find last buf_shift-obj
      950             where buf_shift-obj.obj-type = p-obj-type
      951               and buf_shift-obj.obj-code = p-obj-code
      952               and buf_shift-obj.status_  = 'зкр':U
      953             use-index stts
      954             no-error .
      955           if available buf_shift-obj
      956           then do:
      957             assign
      958               v-extra-message =
      959                     substitute("Дата начала последеней закрытой смены на объекте &1"
      960                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
      961                               )
      962             .
      963           end.
      964           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
      965           undo, return error v-error .
      966         end.
      967       end.
      968     end.
      969   end procedure.
      970   procedure factord-end-day :
      971     define input  parameter p-fact-date            as date    no-undo .
      972     define output parameter p-day-end-fact-order   as decimal no-undo .
      973     do
      974     on error undo, return error return-value
      975     :
      976       if p-fact-date = ?
      977       then do:
      978         return error "Не указана фактическая дата" .
      979       end.
      980       assign
      981         p-day-end-fact-order = integer(p-fact-date) + 0.99
      982       .
      983     end.
      984   end procedure.
      985   procedure factord-to-date :
      986     define input  parameter p-fact-order as decimal no-undo .
      987     define output parameter p-fact-date  as date    no-undo .
      988     define variable v-ref-date  as date      no-undo .
      989     define variable v-ref-delta as integer   no-undo .
      990     do
      991     on error undo, return error return-value
      992     :
      993       if p-fact-order = ?
      994       or p-fact-order = 0
      995       then do:
      996         return error "Не указан fact-order" .
      997       end.
      998       assign
      999         v-ref-date  = date(1, 1, 2000)
     1000       .
     1001       assign
     1002         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     1003       .
     1004       assign
     1005         p-fact-date = v-ref-date + v-ref-delta
     1006       .
     1007     end.
     1008   end procedure.
     1009   procedure factord-to-fact-num :
     1010     define input  parameter p-fact-order as decimal no-undo .
     1011     define output parameter p-fact-num   as integer no-undo .
     1012     define variable v-fact-order-trunc as decimal no-undo .
     1013     do
     1014     on error undo, return error return-value
     1015     :
     1016       if p-fact-order = ?
     1017       or p-fact-order = 0
     1018       then do:
     1019         return error "Не указан fact-order" .
     1020       end.
     1021       assign
     1022        v-fact-order-trunc = truncate(p-fact-order, 2)
     1023       .
     1024       assign
     1025         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     1026       .
     1027     end.
     1028   end procedure.
     1029   procedure factord-to-shift-num :
     1030     define input  parameter p-fact-order as decimal no-undo .
     1031     define output parameter p-shift-num   as integer no-undo .
     1032     define variable  p-shift-numd  as decimal   no-undo .
     1033     define variable v-fact-order-trunc as decimal no-undo .
     1034     do
     1035     on error undo, return error return-value
     1036     :
     1037       if p-fact-order = ?
     1038       or p-fact-order = 0
     1039       then do:
     1040         return error "Не указан fact-order" .
     1041       end.
     1042       assign
     1043        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     1044       .
     1045       if v-fact-order-trunc < 0.5 then do:
     1046         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     1047       end.
     1048       assign
     1049         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     1050         .
     1051        assign
     1052         p-shift-num = truncate (p-shift-numd , 0)
     1053       .
     1054     end.
     1055   end procedure.
