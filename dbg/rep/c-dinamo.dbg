      191   def
      192    shared
      193   temp-table  obj-list no-undo
      194     field obj-type like ub.clients.obj-type
      195     field obj-code like ub.clients.obj-code
      196     field obj-name like ub.clients.obj-name
      197     field obj-id   as integer
