      201     index ie2 obj-name
      202   .
      203   procedure create_obj-list :
      204      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      205      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      206      do
      207      on error undo, return error return-value
      208      :
      209         define buffer cli-obj for ub.clients .
      210         define variable p-var as integer no-undo .
      211         define buffer buf_obj-list for obj-list .
      212         find last buf_obj-list  use-index pi no-error .
      213         if available buf_obj-list
      214         then
      215            p-var = buf_obj-list.obj-id + 1.
      216         else
      217            p-var = 1.
      218         find first cli-obj where
      219                   cli-obj.obj-type = p-obj-type
      220               and cli-obj.obj-code = p-obj-code
      221         no-lock no-error.
      222         if available cli-obj
      223         then do:
      224            create buf_obj-list.
      225            assign
      226               buf_obj-list.obj-id   = p-var
      227               buf_obj-list.obj-code = cli-obj.obj-code
      228               buf_obj-list.obj-type = cli-obj.obj-type
      229               buf_obj-list.obj-name = cli-obj.obj-name
      230               buf_obj-list.db-num   = cli-obj.db-num
      231            .
      232         end.
      233      end.
      234   end.
