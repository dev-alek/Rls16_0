     1564   field sale-sum-rubl like ub.stk-line.sum-rubl
     1565   field sale-sum-base like ub.stk-line.sum-base
     1566   field cost-sum-rubl like ub.stk-line.sum-rubl
     1567   field cost-sum-base like ub.stk-line.sum-base
     1568   field obj-type like ub.clients.obj-type
     1569   field obj-code like ub.clients.obj-code
