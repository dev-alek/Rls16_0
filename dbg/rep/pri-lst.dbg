      432   procedure gds-attr_check-code-dt-seasons :
      433     define input  parameter p-code     like ub.goods.gds-code   no-undo .
      434     define input  parameter p-obj-type like ub.clients.obj-type no-undo .
      435     define input  parameter p-obj-code like ub.clients.obj-code no-undo .
      436     define output parameter p-gds-code like ub.goods.gds-code   no-undo .
      437     define output parameter p-dt-code  as   integer             no-undo .
      438     do
      439     on error undo, return error
      440     :
      441           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr_check-code-dt-seasons in g#attr-lib
      442         (input p-code
      443         ,input p-obj-type
      444         ,input p-obj-code
      445         ,output p-gds-code
      446         ,output p-dt-code
      447         ) no-error .
      448       if error-status :error
      449       then do:
      450         undo, return error return-value .
      451       end.
      452     end.
      453   end.
      454   DEFINE VARIABLE varattr-value as character no-undo .
      455   DEFINE VARIABLE varattr-type as character no-undo .
      456   DEFINE BUTTON b-help DEFAULT
      457        LABEL "Помо&щь"
      458        SIZE 10 BY 1.
      459   DEFINE BUTTON b-quit AUTO-END-KEY DEFAULT
      460        LABEL "&Отмена"
      461        SIZE 10 BY 1.
      462   DEFINE VARIABLE t-1 AS LOGICAL INITIAL no
      463        LABEL "Печать &списка"
      464        VIEW-AS TOGGLE-BOX
      465        SIZE 44.25 BY .79 NO-UNDO.
      466   DEFINE VARIABLE t-2 AS LOGICAL INITIAL no
      467        LABEL "Печать ценников (этикеток)"
      468        VIEW-AS TOGGLE-BOX
      469        SIZE 44.25 BY .79 NO-UNDO.
      470   DEFINE FRAME pri-lst
      471        b-quit AT ROW 1 COL 10.5
      472        b-help AT ROW 1 COL 32.5
      473        t-1 AT ROW 2.5 COL 2
      474        t-2 AT ROW 3.67 COL 2
      475        SPACE(0.98) SKIP(0.78)
      476       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      477            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      478            TITLE "Что напечатать".
      479   ASSIGN
      480          FRAME pri-lst:SCROLLABLE       = FALSE.
      481   ON VALUE-CHANGED OF t-1 IN FRAME pri-lst
      482   DO:
      483       run rep/r-gdslst.w (
      484                        input parparentproc
      485                      , input p-curr-obj-type
      486                      , input p-curr-obj-code
      487                      , input lst-type
      488                      , input table-name
      489                      ).
      490       apply "GO" to FRAME pri-lst.
      491   END.
      492   ON VALUE-CHANGED OF t-2 IN FRAME pri-lst
      493   DO:
      494     CASE table-name :
      495       when "gds-list" then do:
      496         CASE lst-type:
      497           when "LIST" then do:
      498             run rep/tickslst.p (input parparentproc, input p-curr-obj-type, input p-curr-obj-code).
      499           end.
      500           when "ALL" then do:
      501             run rep/tick-lst.p (input parparentproc, input p-curr-obj-type, input p-curr-obj-code).
      502           end.
      503         END CASE.
      504       end.
      505       when "bb-list" then do:
      506         CASE lst-type:
      507           when "LIST" then do:
      508             run rep/tckbslst.p (input parparentproc, input p-curr-obj-type, input p-curr-obj-code).
      509           end.
      510           when "ALL" then do:
      511             run rep/tckb-lst.p (input parparentproc, input p-curr-obj-type, input p-curr-obj-code).
      512           end.
      513         END CASE.
      514       end.
      515     END CASE.
      516       apply "GO" to FRAME pri-lst.
      517   END.
      518   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME pri-lst:PARENT eq ?
      519   THEN FRAME pri-lst:PARENT = ACTIVE-WINDOW.
      520   ON WINDOW-CLOSE OF FRAME pri-lst APPLY "END-ERROR":U TO SELF.
      521   MAIN-BLOCK:
      522   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      523      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      524   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      525   on help of frame pri-lst
      526   do:
      527     run gbl/app_help.p
      528       (input this-procedure :file-name
      529       ,input ''
      530       ,input ?
      531       ) no-error.
      532     if error-status :error then do:
      533       message
      534         "Ошибка при вызове помощи"
      535         error-status :get-message(1)
      536         view-as alert-box .
      537     end.
      538   end.
      539   run minbtn-set in this-procedure .
      540   on choose of b-help in frame pri-lst
      541   do:
      542     apply "help":u to frame pri-lst .
      543   end.
      544   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      545   procedure minbtn-set :
      546       do
      547           on error undo, return error return-value
      548           :
      549           define variable ii              as integer       no-undo .
      550           define variable fh              as widget-handle no-undo .
      551           define variable hh              as widget-handle no-undo .
      552           define variable v-h             as handle        extent 4 no-undo .
      553           define variable v-name-button   as character     no-undo .
      554           define variable v-help-old-x    as decimal       no-undo .
      555           define variable v-help-old-y    as decimal       no-undo .
      556           define variable v-help-old-size as decimal       no-undo .
      557           define variable v-frame-width   as decimal       no-undo .
      558           define variable jj              as integer       no-undo .
      559           do
      560               on error undo, return error
      561               :
      562               assign
      563                   v-frame-width = frame pri-lst:width - 0.3
      564                   fh            = frame pri-lst:first-child
      565                   hh            = fh:first-child
      566                   ii            = 1
      567                   .
      568               do while valid-handle(hh):
      569                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      570                   do:
      571                       case lc(hh:name) :
      572                           when "b-help" then
      573                               do:
      574                                   hh:load-image-up("cmp/b-help.bmp":u) .
      575                                   hh:load-image-down("cmp/b-help.bmp":u) .
      576                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      577                                   hh:TOOLTIP = "Помощь" .
      578                                   v-help-old-x = hh:column .
      579                                   v-help-old-y = hh:row    .
      580                                   v-help-old-size = hh:width .
      581                                   hh:width-chars = 2.5 .
      582                               end.
      583                           when "b-print" then
      584                               do:
      585                                   hh:load-image("cmp/b-print.bmp":u) .
      586                                   hh:TOOLTIP = "Печать" .
      587                                   v-h[ii] = hh:handle .
      588                                   ii = ii + 1 .
      589                                   hh:width-chars = 3 .
      590                               end.
      591                           when "b-history" or
      592                           when "b-hist" then
      593                               do:
      594                                   hh:load-image("cmp/b-hist.bmp":u) .
      595                                   hh:TOOLTIP = "История" .
      596                                   v-h[ii] = hh:handle .
      597                                   ii = ii + 1 .
      598                                   hh:width-chars = 3 .
      599                               end.
      600                           when "b-sch" then
      601                               do:
      602                                   hh:load-image("cmp/b-sch.bmp":u) .
      603                                   hh:TOOLTIP = "Установка Фильтра" .
      604                                   v-h[ii] = hh:handle .
      605                                   ii = ii + 1 .
      606                                   hh:width-chars = 3 .
      607                               end.
      608                           when "b-hist-user" then
      609                               do:
      610                                   hh:load-image("cmp/b-hist.bmp":u) .
      611                                   hh:TOOLTIP = "История пользователя" .
      612                                   ii = ii + 1 .
      613                               end.
      614                       end case.
      615                   end.
      616                   hh = hh:next-sibling.
      617               end.
      618               b-help:column = v-frame-width - b-help:width-chars.
      619               jj = 0.
      620               repeat ii = 4 to 1 by -1 :
      621                   if valid-handle (v-h[ii] ) then
      622                   do:
      623                       jj  = jj + 1 .
      624                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      625                       v-h[ii]:row    = v-help-old-y .
      626                   end.
      627               end.
      628           end.
      629       end.
      630   end procedure.
      631     RUN enable_UI.
      632     WAIT-FOR GO OF FRAME pri-lst.
      633   END.
      634   RUN disable_UI.
      635   PROCEDURE disable_UI :
      636     HIDE FRAME pri-lst.
      637   END PROCEDURE.
      638   PROCEDURE enable_UI :
      639     DISPLAY t-1 t-2
      640         WITH FRAME pri-lst.
      641     ENABLE b-quit b-help t-1 t-2
      642         WITH FRAME pri-lst.
      643   END PROCEDURE.
