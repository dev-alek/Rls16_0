     6755       if available gds-list
     6756       then do:
     6757         next .
     6758       end.
     6759       find first gds-list no-lock where
     6760                  gds-list.artic     = gds-ptrl.artic     and
     6761                  gds-list.prod-type = gds-ptrl.prod-type and
     6762                  gds-list.prod-code = gds-ptrl.prod-code no-error .
     6763       if available gds-list
     6764       then do:
