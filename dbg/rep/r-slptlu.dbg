     3252   end.
     3253   end procedure.
     3254   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3255   procedure cur-time :
     3256      define output parameter p-today as date      no-undo .
     3257      define output parameter p-time  as integer   no-undo .
     3258     do
     3259     on error undo, return error
     3260     :
     3261       define variable v-date1 as date      no-undo .
     3262       define variable v-date2 as date      no-undo .
     3263       define variable v-time  as integer   no-undo .
     3264       assign
     3265         v-date1 = today
     3266         v-time  = time
     3267         v-date2 = today
     3268       .
     3269       if v-date1 <> v-date2
     3270       then do:
     3271         assign
     3272           v-date1 = today
     3273           v-time  = v-time
     3274         .
     3275       end.
     3276       assign
     3277         p-today = v-date1
     3278         p-time  = v-time
     3279       .
     3280     end.
     3281   end.
     3282   function cur-time-date returns character
     3283   :
     3284     return string(today, '99/99/9999':U) .
     3285   end.
     3286   function cur-time-mjd returns decimal
     3287   :
     3288     define variable v-date as date      no-undo .
     3289     define variable v-time as integer   no-undo .
     3290     run cur-time in this-procedure
     3291       (output v-date
     3292       ,output v-time
     3293       ) .
     3294     return integer(v-date) - 2400002 + (v-time / 86400) .
     3295   end.
     3296   function cur-time-get-ending-index returns integer
     3297   (input p-number as integer
     3298   )
     3299   :
     3300     if p-number < 0
     3301     or p-number = ?
     3302     then do:
     3303       return 1 .
     3304     end.
     3305     define variable v-rest as integer   no-undo .
     3306     assign
     3307       p-number = p-number modulo 100
     3308     .
     3309     if p-number < 20
     3310     then do:
     3311       assign
     3312         v-rest = p-number
     3313       .
     3314     end.
     3315     else do:
     3316       assign
     3317         v-rest = p-number modulo 10
     3318       .
     3319     end.
     3320     case v-rest :
     3321       when 1
     3322       then do:
     3323         return 2 .
     3324       end.
     3325       when 2 or
     3326       when 3 or
     3327       when 4
     3328       then do:
     3329         return 3 .
     3330       end.
     3331       otherwise do:
     3332         return 1 .
     3333       end.
     3334     end case .
     3335   end.
     3336   procedure cur-time-mjd-to-date :
     3337      define input  parameter i-mjd-diff as decimal no-undo.
     3338      define output parameter o-Date     as date    no-undo.
     3339      define output parameter o-Time     as integer no-undo.
     3340      define variable v-day-number as integer   no-undo .
     3341      if    i-mjd-diff < 0
     3342         or i-mjd-diff = ?
     3343      then do:
     3344         return "?" .
     3345      end.
     3346      assign
     3347         v-day-number = truncate(i-mjd-diff,0).
     3348         o-Date = date(v-day-number + 2400002).
     3349         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     3350     .
     3351   end.
     3352   function cur-time-mjd-to-string returns character
     3353   (input p-mjd-diff as decimal
     3354   )
     3355   :
     3356     define variable v-day-number as integer   no-undo .
     3357     define variable v-seconds    as integer   no-undo .
     3358     define variable v-hour       as integer   no-undo .
     3359     define variable v-min        as integer   no-undo .
     3360     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     3361     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     3362     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     3363     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     3364     if p-mjd-diff < 0
     3365     or p-mjd-diff = ?
     3366     then do:
     3367       return "?" .
     3368     end.
     3369     assign
     3370       v-day-number = integer(truncate(p-mjd-diff,0))
     3371       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     3372     .
     3373     if v-seconds > 86400
     3374     then do:
     3375       assign
     3376         v-seconds = 86400 - 1
     3377       .
     3378     end.
     3379     if v-seconds < 0
     3380     then do:
     3381       assign
     3382         v-seconds = 0
     3383       .
     3384     end.
     3385     assign
     3386       v-hour = truncate(v-seconds / 3600, 0)
     3387     .
     3388     assign
     3389       v-seconds = v-seconds modulo 3600
     3390     .
     3391     assign
     3392       v-min = truncate(v-seconds / 60, 0)
     3393     .
     3394     assign
     3395       v-seconds = v-seconds modulo 60
     3396     .
     3397     return
     3398         (if v-day-number <> 0
     3399           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     3400           else ""
     3401         )
     3402       + (if v-day-number <> 0 or v-hour <> 0
     3403           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     3404           else ""
     3405         )
     3406       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     3407           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     3408           else ""
     3409         )
     3410       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     3411       .
     3412   end.
     3413   function cur-time-string returns character
     3414   :
     3415     define variable v-date as date      no-undo .
     3416     define variable v-time as integer   no-undo .
     3417     run cur-time in this-procedure
     3418       (output v-date
     3419       ,output v-time
     3420       ) .
     3421     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     3422   end.
     3423   function cur-time-string-sec returns character
     3424   :
     3425     define variable v-date as date      no-undo .
     3426     define variable v-time as integer   no-undo .
     3427     run cur-time in this-procedure
     3428       (output v-date
     3429       ,output v-time
     3430       ) .
     3431     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     3432   end.
     3433   function cur-time-custom  returns character
     3434   (input p-prefix as character
     3435   ,input p-date-format as character
     3436   ,input p-delimiter as character
     3437   ,input p-time-format as character
     3438   ,input p-suffix as character
     3439   )
     3440   :
     3441     define variable v-date as date      no-undo .
     3442     define variable v-time as integer   no-undo .
     3443     run cur-time in this-procedure
     3444       (output v-date
     3445       ,output v-time
     3446       ) .
     3447     return
     3448       p-prefix
     3449       + string(v-date, p-date-format)
     3450       + p-delimiter
     3451       + string(v-time, p-time-format)
     3452       + p-suffix
     3453       .
     3454   end.
     3455   function cur-time-print  returns character
     3456   :
     3457     define variable v-date as date      no-undo .
     3458     define variable v-time as integer   no-undo .
     3459     run cur-time in this-procedure
     3460       (output v-date
     3461       ,output v-time
     3462       ) .
     3463     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     3464   end.
     3465   function cur-time-datetime returns datetime
     3466   :
     3467     define variable v-char as character no-undo .
     3468     define variable v-datetime as datetime no-undo .
     3469     v-char = cur-time-string().
     3470     v-datetime = datetime(v-char).
     3471     return  v-datetime.
     3472   end.
     3473   function cur-time-string-msec returns character
     3474   :
     3475     define variable v-date as datetime  no-undo .
     3476     v-date = now.
     3477     return string(v-date) .
     3478   end.
