     5968                 gds-cell.gds-sum   = gds-cell.gds-sum   + ( if treal-2.is-pay = yes then treal-2.netto                 else 0.00 )
     5969                 gds-cell.gds-price = gds-cell.gds-price + ( if treal-2.is-pay = yes then treal-2.netto / treal-2.qnty1 else 0.00 )
     5970               .
     5971             end.
     5972             for each gds-line where
     5973                      gds-line.line-order > j_start-order
     5974             :
     5975               for each gds-cell where
     5976                        gds-cell.line-order = gds-line.line-order
     5977               :
     5978                 assign
     5979                   gds-cell.row-count = j_excel-row
     5980                 .
     5981               end.
     5982               assign
     5983                 gds-line.row-count = j_excel-row
     5984               .
