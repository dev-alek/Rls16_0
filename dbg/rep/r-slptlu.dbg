     6640     end.
     6641     assign
     6642       SheetF.MergeCellsH = "":U
     6643       SheetF.MergeCellsV = "1=1:4/2=1:4"
     6644       SheetF.ColFormat   = "":U
     6645       SheetF.Sizes       = "9,20"
     6646       v-column-label-1   = "На ........ Месяца" + chr(44) +
