     1640   do on error undo, return error return-value :
     1641   find first cl_tt-clcparts where recid(cl_tt-clcparts) = parrec-parts no-lock.
     1642   for each bf_tt-allsum on error undo, return error return-value :
     1643     delete bf_tt-allsum.
     1644   end.
     1645   assign
     1646     price-rubl-with-tax-loccl = cl_tt-clcparts.price-rubl
     1647     price-base-with-tax-loccl = cl_tt-clcparts.price-base
     1648   .
     1649   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1650   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1651     (output varinvprbcl
     1652     )  .
     1653     if cl_tt-clcparts.out-code = 'free-zone':U     or
     1654        cl_tt-clcparts.out-code = 'out-zone':U   or
     1655        cl_tt-clcparts.doc-type = 'акт':U then do:
     1656       assign
     1657         in-vatp-have-vat-sltcl = yes.
     1658     end.
     1659     else do:
     1660       find first in-vatp_doc-attrcl no-lock
     1661         where in-vatp_doc-attrcl.doc-code  = cl_tt-clcparts.out-code
     1662           and in-vatp_doc-attrcl.attr-code = 'envd':U
     1663         no-error .
     1664       if not available in-vatp_doc-attrcl then do:
     1665         assign
     1666           in-vatp-have-vat-sltcl = yes.
     1667       end.
     1668       else do:
     1669            in-vatp-have-vat-sltcl = no.
     1670       end.
     1671     end.
     1672     assign
     1673      price-cli-with-tax-loccl = cl_tt-clcparts.price-cli
     1674      cli-base-ratecl          = cl_tt-clcparts.cli-base-rate.
     1675     ASSIGN   road-tax-base-loccl  = (if cl_tt-clcparts.road-tax-base  = ? then 0 else cl_tt-clcparts.road-tax-base)
     1676              road-tax-rubl-loccl  = (if cl_tt-clcparts.road-tax-rubl  = ? then 0 else cl_tt-clcparts.road-tax-rubl).
     1677     ASSIGN  transport-base-loccl = (if cl_tt-clcparts.transport-base = ? then 0 else cl_tt-clcparts.transport-base)
     1678             transport-rubl-loccl = (if cl_tt-clcparts.transport-rubl = ? then 0 else cl_tt-clcparts.transport-rubl)
     1679             other-base-loccl     = (if cl_tt-clcparts.other-base     = ? then 0 else cl_tt-clcparts.other-base)
     1680             other-rubl-loccl     = (if cl_tt-clcparts.other-rubl     = ? then 0 else cl_tt-clcparts.other-rubl)
     1681             vat-pc-loccl         = (if cl_tt-clcparts.vat-pc         = ? then 0 else cl_tt-clcparts.vat-pc)
     1682             slt-pc-loccl         = (if cl_tt-clcparts.slt-pc         = ? then 0 else cl_tt-clcparts.slt-pc).
     1683             ASSIGN   slt-base-loccl    = (if in-vatp-have-vat-sltcl = no then 0 else (price-base-with-tax-loccl - ((if road-tax-base-loccl  = ? then 0 else road-tax-base-loccl) + (if transport-base-loccl = ? then 0 else transport-base-loccl) + (if other-base-loccl = ? then 0 else other-base-loccl)))                           * slt-pc-loccl / (100 + slt-pc-loccl))                        vat-base-loccl    = (if in-vatp-have-vat-sltcl = no then 0 else (price-base-with-tax-loccl - ((if road-tax-base-loccl  = ? then 0 else road-tax-base-loccl) + (if transport-base-loccl = ? then 0 else transport-base-loccl) + (if other-base-loccl = ? then 0 else other-base-loccl))) * (1 - slt-pc-loccl / (100 + slt-pc-loccl)) * vat-pc-loccl / (100 + vat-pc-loccl)).
