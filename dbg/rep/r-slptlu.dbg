     2366       bfs_tt-allsum.road-tax-base-doc   =  - bf_tt-allsum.road-tax-base-doc
     2367       bfs_tt-allsum.road-tax-rubl-doc   =  - bf_tt-allsum.road-tax-rubl-doc
     2368       bfs_tt-allsum.excise-base-doc     =  - bf_tt-allsum.excise-base-doc
