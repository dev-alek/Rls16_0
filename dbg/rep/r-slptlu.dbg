     6773         gds-list.prod-type = gds-ptrl.prod-type
     6774         gds-list.prod-code = gds-ptrl.prod-code
     6775         gds-list.gds-code  = gds-ptrl.gds-code
     6776         gds-list.gds-name  = gds-ptrl.gds-name
     6777         gds-list.order-num = j_excel-row
     6778       .
     6779     end.
     6780     assign
     6781       j_excel-pay     = 2
     6782       v-params-adding = "":U
     6783     .
     6784     do jj = 1 to j_excel-col :
     6785       find first tt_obj-pay no-lock where
     6786                  tt_obj-pay.xls-col = jj no-error .
     6787       if not available tt_obj-pay
     6788       then do:
     6789         message "Ошибка определения карт и талонов." view-as alert-box error .
     6790         return .
     6791       end.
     6792       assign
     6793         SheetF.MergeCellsV = SheetF.MergeCellsV + "/"           + string( j_excel-pay + 1 ) + "=" + "2:4"
     6794                                                 + "/"           + string( j_excel-pay + 2 ) + "=" + "3:4"
     6795         SheetF.Sizes       = SheetF.Sizes       + chr(44) + "12"
     6796                                                 + chr(44) + "12"
     6797                                                 + fill( chr(44) + "12", tt_obj-pay.pay-num )
     6798         SheetF.ColFormat   = SheetF.ColFormat   + ";"           + string( j_excel-pay + 1 ) + "=" + "0" + v-delim + "00"
     6799                                                 + ";"           + string( j_excel-pay + 2 ) + "=" + "0" + v-delim + "00"
     6800         v-merge-cells-h1   = v-merge-cells-h1   + chr(44) + string( j_excel-pay + 1 ) + ":"
     6801                                                                 + string( j_excel-pay + tt_obj-pay.pay-num + 2 )
     6802         v-merge-cells-h2   = v-merge-cells-h2   + chr(44) + string( j_excel-pay + 2 ) + ":"
     6803                                                                 + string( j_excel-pay + tt_obj-pay.pay-num + 2 )
     6804         v-merge-cells-h3   = v-merge-cells-h3   + chr(44) + string( j_excel-pay + 3 ) + ":"
     6805                                                                 + string( j_excel-pay + tt_obj-pay.pay-num + 2 )
     6806       .
     6807       do j1 = 1 to tt_obj-pay.pay-num :
     6808         assign
     6809           SheetF.ColFormat = SheetF.ColFormat + ";" + string( j_excel-pay + j1 + 2 ) + "=" + "0" + v-delim + "00"
     6810         .
     6811       end.
     6812       assign
     6813         j_excel-pay     = j_excel-pay     + tt_obj-pay.pay-num + 2
     6814         v-params-adding = v-params-adding
     6815                         + ( if v-params-adding = "":U then "":U else chr(44) )
     6816                         + string( j_excel-pay )
     6817       .
     6818     end.
     6819     assign
     6820       num-monthes     = CalcMonthes( x-Date-Start, x-Date-End )
     6821       v-params-adding = v-params-adding       + chr(4) +
     6822                         string( num-monthes ) + chr(4) +
     6823                         "9"
     6824     .
     6825     do jj = 1 to num-monthes - 1 :
     6826       assign
     6827         v-params-adding = v-params-adding + chr(44) + string( j_excel-row * jj + 9 )
     6828       .
     6829     end.
     6830     assign
     6831       SheetF.Excel-Column-Lable = v-column-label-1 + chr(10) +
     6832                                   v-column-label-2 + chr(10) +
     6833                                   v-column-label-3 + chr(10) +
     6834                                   v-column-label-4
     6835       SheetF.MergeCellsH        = substring( v-merge-cells-h1, 2 ) + "/" +
     6836                                   substring( v-merge-cells-h2, 2 ) + "/" +
     6837                                   substring( v-merge-cells-h3, 2 )
     6838       Sheetf.Bas-File           = "slptrluk.bas"
     6839       Sheetf.Bas-Param-Add      = yes
     6840       Sheetf.Bas-Params         = "Info"                + chr(4) +
     6841                                   string( j_excel-row ) + chr(4) +
     6842                                   string( j_excel-col ) + chr(4) +
     6843                                   v-params-adding
     6844       SheetF.ColFormat          = SheetF.ColFormat      + chr(4) +
     6845                                                           chr(4) +
     6846                                  "Справочно Цены"
     6847     .
     6848     run rep/extitle.p
     6849       ( input XLS-page-num
     6850       ) no-error .
     6851     do jj = 1 to num-monthes :
     6852       if Make-Excel then  put   stream ForExcel unformatted
     6853         RusMonth( jj )
     6854       .
     6855       for each gds-list no-lock
     6856       :
     6857         if Make-Excel then  put   stream ForExcel unformatted
     6858                             CHR(9)
     6859           gds-list.gds-name CHR(9)
     6860           fill( CHR(9), j_excel-col )
     6861           skip
     6862         .
     6863       end.
     6864     end.
     6865     output stream text_out close .
     6866     if Make-Excel then output stream ForExcel close.
     6867     run waitfram-hide in this-procedure .
     6868     run prn-lib-prn-file in this-procedure
     6869       ( input my-handle
     6870       , input 8
     6871       ) .
     6872   end.
     6873   procedure get-fo-range :
     6874     define  input parameter p-obj-type   as character no-undo .
     6875     define  input parameter p-obj-code   as integer   no-undo .
     6876     define  input parameter p-date-from  as date      no-undo .
     6877     define  input parameter p-date-till  as date      no-undo .
     6878     define  input parameter p-shift-from as integer   no-undo .
     6879     define  input parameter p-shift-till as integer   no-undo .
     6880     define  input parameter p-is-shift   as logical   no-undo .
     6881     define output parameter p-fo-from    as decimal   no-undo initial 0.00 .
     6882     define output parameter p-fo-till    as decimal   no-undo initial 0.00 .
     6883     define variable v-shift-end-fact-order as decimal no-undo .
     6884     define variable v-day-end-fact-order   as decimal no-undo .
     6885     define variable v-fact-order           as decimal no-undo .
     6886     do
     6887     on error undo, return error return-value
     6888     :
     6889       if p-is-shift = yes
     6890       then do:
     6891         run factord in this-procedure
     6892           (  input p-date-from
     6893           ,  input 1
     6894           ,  input 1
     6895           ,  input p-date-from
     6896           ,  input p-shift-from
     6897           ,  input p-is-shift
     6898           , output p-fo-from
     6899           , output v-shift-end-fact-order
     6900           , output v-day-end-fact-order
     6901           ) no-error .
     6902         if error-status :error
     6903         then do:
     6904           message vss-workfile skip( 0 ) vss-date skip( 0 ) vss-revision skip( 1 ) vss-description skip( 1 )
     6905                   "Ошибка при вызове процедуры factord" skip( 0 )
     6906                   error-status :get-message( 1 ) skip( 0 )
     6907                   return-value skip( 1 )
     6908           view-as alert-box error .
     6909           undo, return error return-value .
     6910         end.
     6911         run factord in this-procedure
     6912           (  input p-date-till
     6913           ,  input 1
     6914           ,  input 1
     6915           ,  input p-date-till
     6916           ,  input p-shift-till
     6917           ,  input p-is-shift
     6918           , output v-fact-order
     6919           , output p-fo-till
     6920           , output v-day-end-fact-order
     6921           ) no-error .
     6922         if error-status :error
     6923         then do:
     6924           message vss-workfile skip( 0 ) vss-date skip( 0 ) vss-revision skip( 1 ) vss-description skip( 1 )
     6925                   "Ошибка при вызове процедуры factord" skip( 0 )
     6926                   error-status :get-message( 1 ) skip( 0 )
     6927                   return-value skip( 1 )
     6928           view-as alert-box error .
     6929           undo, return error return-value .
     6930         end.
     6931       end.
     6932       else do:
     6933         run day-begin-fact-order in this-procedure
     6934           (  input p-date-from
     6935           , output p-fo-from
     6936           ) no-error .
     6937         if error-status :error or
     6938            p-fo-from = ?
     6939         then do:
     6940           assign
     6941             p-fo-from = 0.00
     6942           .
     6943         end.
     6944         run factord-end-day in this-procedure
     6945           (  input p-date-till
     6946           , output p-fo-till
     6947           ) no-error .
     6948         if error-status :error or
     6949            p-fo-till = ?
     6950         then do:
     6951           assign
     6952             p-fo-till = truncate( p-fo-from, 0 ) + 0.99
     6953           .
     6954         end.
     6955       end.
     6956       if p-fo-till < p-fo-from
     6957       then do:
     6958         assign
     6959           p-fo-till = p-fo-from
     6960         .
     6961       end.
     6962     end.
     6963   end procedure.
     6964   procedure cr-gds-list :
     6965     define input parameter p-obj-type as character no-undo .
     6966     define input parameter p-obj-code as integer   no-undo .
     6967     define variable is-petrol as logical no-undo .
     6968     define variable is-pieces as logical no-undo .
     6969     define variable v_gds-attr-value as character no-undo .
     6970     define variable v_gds-attr-type  as character no-undo .
     6971     define variable j_gds-order      as integer   no-undo initial 0 .
     6972     define variable j_gas-order      as integer   no-undo initial 0 .
     6973     define variable l_is-gds-gas     as logical   no-undo .
     6974     define variable doc-line_qnty    as decimal   no-undo initial 0.00 .
     6975     define buffer bf_gds-obj  for ub.gds-obj .
     6976     define buffer bf_goods    for ub.goods   .
     6977     define buffer bf_gds-ptrl for gds-ptrl   .
     6978     do
     6979     on error undo, return error return-value
     6980     :
     6981       for each gds-ptrl no-lock where
     6982                gds-ptrl.obj-type = p-obj-type and
     6983                gds-ptrl.obj-code = p-obj-code
     6984       :
     6985         find first bf_gds-ptrl exclusive-lock where
     6986             recid( bf_gds-ptrl ) = recid( gds-ptrl ) .
     6987         delete bf_gds-ptrl .
     6988       end.
     6989       for each  bf_gds-obj no-lock where
     6990                 bf_gds-obj.obj-type = p-obj-type and
     6991                 bf_gds-obj.obj-code = p-obj-code
     6992         , first bf_goods   no-lock where
     6993                 bf_goods.gds-code   = bf_gds-obj.gds-code
     6994       :
     6995         find first gds-ptrl no-lock where
     6996                    gds-ptrl.obj-type = bf_gds-obj.obj-type and
     6997                    gds-ptrl.obj-code = bf_gds-obj.obj-code and
     6998                    gds-ptrl.gds-code = bf_gds-obj.gds-code no-error .
     6999         if available gds-ptrl
     7000         then do:
     7001           next .
     7002         end.
     7003   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
     7004     (
     7005        input bf_gds-obj.artic
     7006     ,  input bf_gds-obj.prod-type
     7007     ,  input bf_gds-obj.prod-code
     7008     , output is-petrol
     7009     , output is-pieces
     7010     ) no-error.
     7011         if error-status :error or
     7012            is-petrol <> yes    or
     7013            is-pieces <> no
     7014         then do:
     7015           next .
     7016         end.
     7017         run gds-attr-value in this-procedure
     7018           (  input bf_goods.gds-code
     7019           ,  input 'fuel-type':U
     7020           , output v_gds-attr-value
     7021           , output v_gds-attr-type
     7022           ) no-error .
     7023         if not error-status :error and
     7024            v_gds-attr-value = 'metan':U
     7025         then do:
     7026           assign
     7027             l_is-gds-gas = yes
     7028           .
     7029         end.
     7030         else do:
     7031           assign
     7032             l_is-gds-gas = no
     7033           .
     7034         end.
     7035         find first bf_doc-line no-lock where
     7036                    bf_doc-line.obj-type      = bf_gds-obj.obj-type     and
     7037                    bf_doc-line.obj-code      = bf_gds-obj.obj-code     and
     7038                    bf_doc-line.prod-type     = bf_gds-obj.prod-type    and
     7039                    bf_doc-line.prod-code     = bf_gds-obj.prod-code    and
     7040                    bf_doc-line.artic         = bf_gds-obj.artic        and
     7041                    bf_doc-line.ext-doc-type  = 'es':U and
     7042                    bf_doc-line.status_       = 'факт':U                 and
     7043                    bf_doc-line.fact-order   >= fact-order_from         and
     7044                    bf_doc-line.fact-order   <= fact-order_till         no-error .
     7045         if not available bf_doc-line
     7046         then do:
     7047           next .
     7048         end.
     7049         assign
     7050           doc-line_qnty = 0.00
     7051         .
     7052         for each bf_doc-line no-lock where
     7053                  bf_doc-line.obj-type      = bf_gds-obj.obj-type     and
     7054                  bf_doc-line.obj-code      = bf_gds-obj.obj-code     and
     7055                  bf_doc-line.prod-type     = bf_gds-obj.prod-type    and
     7056                  bf_doc-line.prod-code     = bf_gds-obj.prod-code    and
     7057                  bf_doc-line.artic         = bf_gds-obj.artic        and
     7058                  bf_doc-line.ext-doc-type  = 'es':U and
     7059                  bf_doc-line.status_       = 'факт':U                 and
     7060                  bf_doc-line.fact-order   >= fact-order_from         and
     7061                  bf_doc-line.fact-order   <= fact-order_till
     7062         :
     7063           assign
     7064             doc-line_qnty = doc-line_qnty + bf_doc-line.fact-qnty
     7065           .
     7066         end.
     7067         if doc-line_qnty = 0.00
     7068         then do:
     7069           next .
     7070         end.
     7071         if l_is-gds-gas = yes
     7072         then do:
     7073           assign
     7074             j_gas-order = j_gas-order + 1
     7075           .
     7076         end.
     7077         else do:
     7078           assign
     7079             j_gds-order = j_gds-order + 1
     7080           .
     7081         end.
     7082         create gds-ptrl .
     7083         assign
     7084           gds-ptrl.obj-type  = bf_gds-obj.obj-type
     7085           gds-ptrl.obj-code  = bf_gds-obj.obj-code
     7086           gds-ptrl.artic     = bf_gds-obj.artic
     7087           gds-ptrl.prod-type = bf_gds-obj.prod-type
     7088           gds-ptrl.prod-code = bf_gds-obj.prod-code
     7089           gds-ptrl.gds-code  = bf_gds-obj.gds-code
     7090           gds-ptrl.gds-name  = bf_goods.gds-name
     7091           gds-ptrl.is-gas    = l_is-gds-gas
     7092           gds-ptrl.gds-order = ( if l_is-gds-gas = yes then j_gas-order else j_gds-order )
     7093         .
     7094       end.
     7095     end.
     7096   end procedure.
     7097   procedure get-dec-string :
     7098     define  input parameter p-dec  as decimal   no-undo .
     7099     define output parameter p-char as character no-undo .
     7100     define variable j-len as integer no-undo initial 12 .
     7101     do
     7102     on error undo, return error return-value
     7103     :
     7104       if p-dec = ? or
     7105          p-dec = 0.00
     7106       then do:
     7107         assign
     7108           p-char = fill( " ":U, j-len )
     7109         .
     7110       end.
     7111       else do:
     7112         assign
     7113           p-char = trim( string( p-dec, "->>>>>>>9.99":U ) )
     7114           p-char = fill( " ":U, j-len - length( trim( p-char ) ) ) + trim( p-char )
     7115         .
     7116       end.
     7117     end.
     7118   end procedure.
