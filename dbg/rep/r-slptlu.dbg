     6648       v-column-label-2   = "":U                 + chr(44) +
     6649                            "":U
     6650       v-column-label-3   = "":U                 + chr(44) +
     6651                            "":U
     6652       v-column-label-4   = "":U                 + chr(44) +
     6653                            "":U
     6654       v-merge-cells-h1   = "":U
     6655       v-merge-cells-h2   = "":U
     6656       v-merge-cells-h3   = "":U
     6657     .
     6658     for each tt_object no-lock
     6659     :
     6660       assign
     6661         v-column-label-1 = v-column-label-1                                            + chr(44) +
     6662                            replace( tt_object.obj-name, chr(44), chr(32) ) + chr(44)
     6663                                                                                        + chr(44)
     6664                                                                                        + chr(44)
     6665                                                                                        + chr(44)
     6666                                                                                        + chr(44)
     6667                                                                                        + chr(44)
     6668         v-column-label-2 = v-column-label-2 + chr(44) +
     6669                            "Приход"         + chr(44) +
     6670                            "Расход"         + chr(44)
     6671                                             + chr(44)
     6672                                             + chr(44)
     6673                                             + chr(44)
     6674                                             + chr(44)
     6675         v-column-label-3 = v-column-label-3 + chr(44) +
     6676                            "":U             + chr(44) +
     6677                            "нал"            + chr(44) +
     6678                            "грн."           + chr(44)
     6679                                             + chr(44)
     6680                                             + chr(44)
     6681                                             + chr(44)
     6682         v-column-label-4 = v-column-label-4 + chr(44) +
     6683                            "":U             + chr(44) +
     6684                            "":U
     6685       .
     6686       assign
     6687         j_excel-pay = 0
     6688         j_excel-col = j_excel-col + 1
     6689       .
     6690       for each tt_obj-pay no-lock where
     6691                tt_obj-pay.obj-type = tt_object.obj-type and
     6692                tt_obj-pay.obj-code = tt_object.obj-code
     6693       break by tt_obj-pay.obj-type
     6694             by tt_obj-pay.obj-code
     6695             by tt_obj-pay.pay-name
     6696       :
     6697         if first-of( tt_obj-pay.obj-code )
     6698         then do:
     6699           assign
     6700             j_excel-pay = 0
     6701           .
     6702         end.
     6703         assign
     6704           v-column-label-4 = v-column-label-4    + chr(44) +
     6705                              tt_obj-pay.pay-name
     6706           j_excel-pay      = j_excel-pay         + 1
     6707         .
