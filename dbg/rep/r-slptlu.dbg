     4651   procedure prn-lib-reportviewer :
     4652     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     4653     define input parameter p-report-name-html as character no-undo .
     4654     define input parameter p-param        as character no-undo .
     4655     define variable v-excel           as character no-undo init 'TRUE' .
     4656     define variable v-value-character as character no-undo .
     4657     define variable v-value-integer   as character no-undo .
     4658     define variable v-value-date      as date      no-undo .
     4659     define variable v-value-decimal   as decimal   no-undo .
     4660     define variable rep-excel         as logical   no-undo .
     4661     define variable excel-string      as character no-undo .
     4662     define variable v-param-type      as character no-undo .
     4663     define variable v-tth             as handle    no-undo .
     4664     run adm/shattri.p (
     4665       input "get":U
     4666       ,input  ""
     4667       ,input  0
     4668       ,input  'report-glob':U
     4669       ,input  'rep-excel':U
     4670       ,output v-value-character
     4671       ,output v-value-date
     4672       ,output v-value-decimal
     4673       ,output v-value-integer
     4674       ,output rep-excel
     4675       ,output v-param-type
     4676       ,INPUT-OUTPUT table-handle v-tth
     4677       )  .
     4678     if rep-excel then v-excel = "TRUE" .
     4679     else v-excel = "FALSE" .
     4680     if p-param eq ""
     4681     then
     4682        p-param = "EXCEL:" + v-excel.
     4683     else
     4684        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
     4685     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
     4686   end procedure.
