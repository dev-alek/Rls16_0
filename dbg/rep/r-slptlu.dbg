     4289   FUNCTION NextMonth-MY RETURNS INTEGER ( INPUT i-month AS INTEGER ) :
     4290     DEFINE VARIABLE j_month AS INTEGER NO-UNDO.
     4291     RUN get-next-month-MY IN THIS-PROCEDURE ( INPUT i-month, OUTPUT j_month ) NO-ERROR.
     4292     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE j_month ).
     4293   END FUNCTION.
     4294   PROCEDURE get-next-month-MY :
     4295     DEFINE  INPUT PARAMETER p-curr-month AS INTEGER NO-UNDO.
     4296     DEFINE OUTPUT PARAMETER p-next-month AS INTEGER NO-UNDO.
     4297     DO ON ERROR UNDO, RETURN ERROR :
     4298       ASSIGN p-next-month = ( p-curr-month MODULO 12 ) + 1.
     4299     END.
     4300   END PROCEDURE.
     4301   FUNCTION MonthNameRus RETURNS CHARACTER ( INPUT i-month AS INTEGER ) :
     4302     DEFINE VARIABLE v-name AS CHARACTER NO-UNDO.
     4303     RUN get-month-name-rus IN THIS-PROCEDURE ( INPUT i-month, OUTPUT v-name ) NO-ERROR.
     4304     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE v-name ).
     4305   END FUNCTION.
     4306   PROCEDURE get-month-name-rus :
     4307     DEFINE  INPUT PARAMETER p-month AS INTEGER   NO-UNDO.
     4308     DEFINE OUTPUT PARAMETER p-name  AS CHARACTER NO-UNDO.
     4309     DEFINE VARIABLE v-list AS CHARACTER NO-UNDO INITIAL "Январь,Февраль,Март,Апрель,Май,Июнь,Июль,Август,Сентябрь,Октябрь,Ноябрь,Декабрь".
     4310     DO ON ERROR UNDO, RETURN ERROR :
     4311       ASSIGN p-name = ( IF p-month >= 1 AND p-month <= 12 THEN ENTRY( p-month, v-list ) ELSE ? ).
     4312     END.
     4313   END PROCEDURE.
     4314   FUNCTION CalcMonthes  RETURNS INTEGER ( INPUT i-date-from AS DATE, INPUT i-date-till AS DATE ) :
     4315     DEFINE VARIABLE j_month-num AS INTEGER NO-UNDO.
     4316     RUN get-month-number IN THIS-PROCEDURE ( INPUT i-date-from, INPUT i-date-till, OUTPUT j_month-num ) NO-ERROR.
     4317     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE j_month-num ).
     4318   END FUNCTION.
     4319   PROCEDURE get-month-number :
     4320     DEFINE  INPUT PARAMETER p-date-from AS DATE    NO-UNDO.
     4321     DEFINE  INPUT PARAMETER p-date-till AS DATE    NO-UNDO.
     4322     DEFINE OUTPUT PARAMETER p-month-num AS INTEGER NO-UNDO.
     4323     DO ON ERROR UNDO, RETURN ERROR :
     4324       ASSIGN p-month-num = ( YEAR(  p-date-till ) - YEAR(  p-date-from ) ) * 12 +
     4325                              MONTH( p-date-till ) - MONTH( p-date-from )   +  1 .
     4326     END.
     4327   END PROCEDURE.
     4328   FUNCTION Centering RETURNS CHARACTER ( INPUT i-string AS CHARACTER, INPUT i-length AS INTEGER ) :
     4329     DEFINE VARIABLE v-outstring AS CHARACTER NO-UNDO.
     4330     RUN get-centre-string IN THIS-PROCEDURE ( INPUT i-string, INPUT i-length, OUTPUT v-outstring ) NO-ERROR.
     4331     RETURN ( IF ERROR-STATUS :ERROR THEN i-string ELSE v-outstring ).
     4332   END FUNCTION.
     4333   PROCEDURE get-centre-string :
     4334     DEFINE  INPUT PARAMETER p-instring  AS CHARACTER NO-UNDO.
     4335     DEFINE  INPUT PARAMETER p-length    AS INTEGER   NO-UNDO.
     4336     DEFINE OUTPUT PARAMETER p-outstring AS CHARACTER NO-UNDO INITIAL "":U.
     4337     DEFINE VARIABLE j-format AS INTEGER NO-UNDO.
     4338     DEFINE VARIABLE j-left   AS INTEGER NO-UNDO.
     4339     DO ON ERROR UNDO, RETURN ERROR :
     4340       ASSIGN p-instring = TRIM(   p-instring )
     4341              j-format   = LENGTH( p-instring ).
     4342       IF           j-format > p-length THEN DO:
     4343         ASSIGN p-outstring = SUBSTRING( p-instring, 1, p-length ).
     4344       END. ELSE IF j-format < p-length THEN DO:
     4345         ASSIGN j-left      = INTEGER( ( p-length - ( j-format + 1 ) ) * 0.5 )
     4346                p-outstring = FILL( " ":U, j-left ) + p-instring + FILL( " ":U, p-length - ( j-left + j-format ) ).
     4347       END.                             ELSE DO:
     4348         ASSIGN p-outstring = p-instring.
     4349       END.
     4350     END.
     4351   END PROCEDURE.
     4352   FUNCTION ShiftRight RETURNS CHARACTER ( INPUT i-string AS CHARACTER, INPUT i-length AS INTEGER ) :
     4353     DEFINE VARIABLE v-outstring AS CHARACTER NO-UNDO.
     4354     RUN get-right-string IN THIS-PROCEDURE ( INPUT i-string, INPUT i-length, OUTPUT v-outstring ) NO-ERROR.
     4355     RETURN ( IF ERROR-STATUS :ERROR THEN i-string ELSE v-outstring ).
     4356   END FUNCTION.
     4357   PROCEDURE get-right-string :
     4358     DEFINE  INPUT PARAMETER p-instring  AS CHARACTER NO-UNDO.
     4359     DEFINE  INPUT PARAMETER p-length    AS INTEGER   NO-UNDO.
     4360     DEFINE OUTPUT PARAMETER p-outstring AS CHARACTER NO-UNDO INITIAL "":U.
     4361     DEFINE VARIABLE j-format AS INTEGER NO-UNDO.
     4362     DO ON ERROR UNDO, RETURN ERROR :
     4363       ASSIGN p-instring = TRIM(   p-instring )
     4364              j-format   = LENGTH( p-instring ).
     4365       IF           j-format > p-length THEN DO:
     4366         ASSIGN p-outstring = SUBSTRING( p-instring, 1, p-length ).
     4367       END. ELSE IF j-format < p-length THEN DO:
     4368         ASSIGN p-outstring = FILL( " ":U, p-length - j-format ) + p-instring.
     4369       END.                             ELSE DO:
     4370         ASSIGN p-outstring = p-instring.
     4371       END.
     4372     END.
     4373   END PROCEDURE.
     4374   function Centre returns character ( input i-string as character
     4375                                     , input i-length as integer
     4376                                     ) :
     4377     define variable v-str as character no-undo .
     4378     assign
     4379       v-str = Centering( trim( i-string ), i-length )
     4380     .
     4381     if length( v-str ) < i-length
     4382     then do:
     4383       assign
     4384         v-str = v-str + fill( " ":U, i-length - length( v-str ) )
     4385       .
     4386     end.
     4387     else
     4388     if length( v-str ) > i-length
     4389     then do:
     4390       assign
     4391         v-str = substring( v-str, 1, i-length )
     4392       .
     4393     end.
     4394     return ( v-str  ) .
     4395   end function.
     4396   function OutDec returns character ( input p-sum as decimal ) :
     4397     define variable v-sum as character no-undo .
     4398     run get-dec-string in this-procedure
     4399       (  input p-sum
     4400       , output v-sum
     4401       ) no-error .
     4402     return ( if error-status :error then fill( " ":U, 12 ) else v-sum ) .
     4403   end function.
     4404   function RusMonth returns character ( input i-num as integer ) :
     4405     define variable j-month as integer no-undo .
     4406     define variable j-calc  as integer no-undo .
     4407     assign
     4408       j-month = month( x-Date-Start )
     4409     .
     4410     if i-num > 1
     4411     then do:
     4412       do j-calc = 1 to i-num - 1 :
     4413         assign
     4414           j-month = NextMonth-MY( j-month )
     4415         .
     4416       end.
     4417     end.
     4418     return ( MonthNameRus( j-month ) ) .
     4419   end function.
