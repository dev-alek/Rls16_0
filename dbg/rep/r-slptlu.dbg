     2395       bfs_tt-allsum.slt-cli-acc         =  - bf_tt-allsum.slt-cli-acc
     2396       bfs_tt-allsum.road-tax-base-acc   =  - bf_tt-allsum.road-tax-base-acc
     2397       bfs_tt-allsum.road-tax-rubl-acc   =  - bf_tt-allsum.road-tax-rubl-acc
     2398       bfs_tt-allsum.road-tax-cli-acc    =  - bf_tt-allsum.road-tax-cli-acc
     2399       bfs_tt-allsum.excise-base-acc     =  - bf_tt-allsum.excise-base-acc
     2400       bfs_tt-allsum.excise-rubl-acc     =  - bf_tt-allsum.excise-rubl-acc
     2401       bfs_tt-allsum.excise-cli-acc      =  - bf_tt-allsum.excise-cli-acc
     2402       bfs_tt-allsum.transport-base-acc  =  - bf_tt-allsum.transport-base-acc
     2403       bfs_tt-allsum.transport-rubl-acc  =  - bf_tt-allsum.transport-rubl-acc
     2404       bfs_tt-allsum.transport-cli-acc   =  - bf_tt-allsum.transport-cli-acc
     2405       bfs_tt-allsum.other-base-acc      =  - bf_tt-allsum.other-base-acc
     2406       bfs_tt-allsum.other-rubl-acc      =  - bf_tt-allsum.other-rubl-acc
     2407       bfs_tt-allsum.other-cli-acc       =  - bf_tt-allsum.other-cli-acc.
     2408   end.
     2409   create bfpc_tt-allsum.
     2410   create bfspc_tt-allsum.
     2411   case cl_tt-clcparts.purch-code :
     2412   when 1           then do:
     2413     assign
     2414       bfpc_tt-allsum.sum-type  = 'сумма_по_выкупу':U
     2415       bfspc_tt-allsum.sum-type = 'сумма_по_выкупу_со_знаком':U.
     2416     buffer-copy bf_tt-allsum  except bf_tt-allsum.sum-type  to bfpc_tt-allsum.
     2417     buffer-copy bfs_tt-allsum except bfs_tt-allsum.sum-type to bfspc_tt-allsum.
     2418   end.
     2419   when 4    then do:
     2420     assign
     2421       bfpc_tt-allsum.sum-type  = 'сумма_по_старой_консигнации':U
     2422       bfspc_tt-allsum.sum-type = 'сумма_по_старой_консигнации_со_знаком':U.
     2423     buffer-copy bf_tt-allsum  except bf_tt-allsum.sum-type  to bfpc_tt-allsum.
     2424     buffer-copy bfs_tt-allsum except bfs_tt-allsum.sum-type to bfspc_tt-allsum.
     2425   end.
     2426   when 3 then do:
     2427     assign
     2428       bfpc_tt-allsum.sum-type  = 'сумма_по_ответственному_хранению':U
     2429       bfspc_tt-allsum.sum-type = 'сумма_по_ответственному_хранению_со_знаком':U.
     2430     buffer-copy bf_tt-allsum  except bf_tt-allsum.sum-type  to bfpc_tt-allsum.
     2431     buffer-copy bfs_tt-allsum except bfs_tt-allsum.sum-type to bfspc_tt-allsum.
     2432   end.
     2433   when 2 then do:
     2434     assign
     2435       bfpc_tt-allsum.sum-type  = 'сумма_по_консигнации_выгода':U
     2436       bfspc_tt-allsum.sum-type = 'сумма_по_консигнации_выгода_со_знаком':U.
     2437     assign
