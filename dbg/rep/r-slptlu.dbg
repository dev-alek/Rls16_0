     6237                 gds-line.shift-date = today + 396
     6238                 gds-line.shift-num  = 99
     6239                 gds-line.shift-name = "И Т О Г О"
     6240                 gds-line.pay-code   = bf_gds-line.pay-code
     6241                 gds-line.out-name   = bf_gds-line.out-name
     6242                 gds-line.pay-name   = bf_gds-line.pay-name
     6243                 gds-line.is-cash    = bf_gds-line.is-cash
     6244                 gds-line.is-gas     = bf_gds-line.is-gas
     6245                 gds-line.col-count  = bf_gds-line.col-count
     6246                 gds-line.row-count  = 0
     6247                 gds-line.all-qnty   = 0.00
     6248                 gds-line.all-sum    = 0.00
     6249               .
     6250             end.
     6251             assign
     6252               gds-line.all-qnty  = gds-line.all-qnty  + bf_gds-line.all-qnty
     6253               gds-line.row-count = gds-line.row-count + 1
     6254             .
     6255             if gds-line.is-cash <> no
     6256             then do:
     6257               assign
     6258                 gds-line.all-sum = gds-line.all-sum + bf_gds-line.all-sum
     6259               .
     6260             end.
     6261             if last-of( bf_gds-line.pay-code )
     6262             then do:
     6263               for each bf_gds-cell no-lock
     6264                  where bf_gds-cell.is-gas   = bf_gds-line.is-gas
     6265                    and bf_gds-cell.pay-code = bf_gds-line.pay-code
     6266                    and bf_gds-cell.line-order <= j_start-order
     6267               break by bf_gds-cell.gds-order
     6268                     by bf_gds-cell.is-cash
     6269                     by bf_gds-cell.shift-date
     6270                     by bf_gds-cell.shift-num
     6271                     by bf_gds-cell.gds-code
     6272               :
     6273                 if first-of( bf_gds-cell.gds-order )
     6274                 then do:
     6275                   create gds-cell .
     6276                   assign
     6277                     gds-cell.line-order = gds-line.line-order
     6278                     gds-cell.shift-date = gds-line.shift-date
     6279                     gds-cell.shift-num  = gds-line.shift-num
     6280                     gds-cell.pay-code   = gds-line.pay-code
     6281                     gds-cell.is-cash    = gds-line.is-cash
     6282                     gds-cell.is-gas     = bf_gds-cell.is-gas
     6283                     gds-cell.gds-order  = bf_gds-cell.gds-order
     6284                     gds-cell.gds-code   = bf_gds-cell.gds-code
     6285                     gds-cell.col-count  = gds-line.col-count
     6286                     gds-cell.row-count  = gds-line.row-count
     6287                     gds-cell.gds-qnty   = 0.00
     6288                     gds-cell.gds-price  = 0.00
     6289                     gds-cell.gds-sum    = 0.00
     6290                   .
     6291                 end.
     6292                 assign
     6293                   gds-cell.gds-qnty = gds-cell.gds-qnty + bf_gds-cell.gds-qnty
     6294                 .
     6295                 if gds-cell.is-cash <> no
     6296                 then do:
     6297                   assign
     6298                     gds-cell.gds-sum = gds-cell.gds-sum + bf_gds-cell.gds-sum
     6299                   .
     6300                 end.
     6301               end.
     6302             end.
     6303           end.
     6304           assign
     6305             j_total-rows   = 0
     6306             j_line-counter = 0
     6307           .
     6308           for each gds-line no-lock
     6309           break by gds-line.shift-date
     6310                 by gds-line.shift-num
     6311                 by gds-line.line-order
     6312           :
     6313             if first-of( gds-line.shift-num )
     6314             then do:
     6315               assign
     6316                 j_line-counter = 0
     6317               .
     6318             end.
     6319             if gds-line.pay-code = 1000000002
     6320             then do:
     6321               next .
     6322             end.
     6323             if gds-line.all-qnty = 0.00
     6324             then do:
     6325               next .
     6326             end.
     6327             assign
     6328               j_line-counter = j_line-counter + 1
     6329             .
     6330             if last-of( gds-line.shift-num )
     6331             then do:
     6332               assign
     6333                 j_total-rows = j_total-rows + j_line-counter
     6334                 v-green-row  = v-green-row  +
     6335                                ( if v-green-row = "":U then "":U else chr(44) ) +
     6336                                string( j_total-rows + 6 )
     6337               .
     6338               for each bf_gds-line where
     6339                        bf_gds-line.shift-date = gds-line.shift-date and
     6340                        bf_gds-line.shift-num  = gds-line.shift-num
     6341               :
     6342                 for each bf_gds-cell where
     6343                          bf_gds-cell.line-order = bf_gds-line.line-order
     6344                 :
     6345                   assign
     6346                     bf_gds-cell.row-count = j_line-counter
     6347                   .
     6348                 end.
     6349                 assign
     6350                   bf_gds-line.row-count = j_line-counter
     6351                 .
     6352               end.
     6353             end.
     6354           end.
     6355           assign
     6356             XLS-page-num = XLS-page-num + 1
     6357           .
     6358           find first SheetF where
     6359                      SheetF.Sheet-Num = XLS-page-num no-error .
     6360           if not available SheetF
     6361           then do:
     6362             create SheetF .
     6363             assign
     6364               SheetF.Sheet-Num = XLS-page-num
     6365             .
     6366           end.
     6367           assign
     6368             SheetF.MergeCellsH        = "5:7"
     6369             SheetF.MergeCellsV        = "1=1:2/2=1:2/3=1:2"
     6370             SheetF.Excel-Column-Lable = "Дата"              + chr(44) +
     6371                                         "Покупатель"        + chr(44) +
     6372                                         "ИТОГО:"            + chr(44) +
     6373                                                               chr(44) +
     6374                                replace( tt_object.obj-name,   chr(44) , chr(32) )
     6375                                                             + chr(44)
     6376                                                             + chr(44)
     6377                                                             + chr(44) + chr(10)
     6378                                                             + chr(44)
     6379                                                             + chr(44)
     6380                                                             + chr(44)
     6381                                                             + chr(44) +
     6382                                         "Кол-во (л)"        + chr(44) +
     6383                                         "Цена реал."        + chr(44) +
     6384                                         "Сумма грн."        + chr(44)
     6385             SheetF.ColFormat          = "3=" + "0" + v-delim + "00" + ";" +
     6386                                         "5=" + "0" + v-delim + "00" + ";" +
     6387                                         "6=" + "0" + v-delim + "00" + ";" +
     6388                                         "7=" + "0" + v-delim + "00"
     6389             SheetF.Sizes              = "10,17,12,2,12,12,12,2"
     6390           .
     6391           for each gds-ptrl no-lock where
     6392                    gds-ptrl.obj-type  = tt_object.obj-type and
     6393                    gds-ptrl.obj-code  = tt_object.obj-code and
     6394                    gds-ptrl.is-gas    = yes
     6395           break by gds-ptrl.artic
     6396                 by gds-ptrl.prod-type
     6397                 by gds-ptrl.prod-code
     6398           :
     6399             assign
     6400               j_excel-row = j_excel-row + 1
     6401             .
     6402           end.
     6403           assign
     6404             vcurr-sheet-name = tt_object.obj-name + " - ГАЗ"
     6405             j_columns-total  = 7
     6406           .
     6407           if j_total-rows = 0 or
     6408              v-green-row  = "":U
     6409           then do:
     6410             assign
     6411               SheetF.MergeCellsH        = "":U
     6412               SheetF.MergeCellsV        = "":U
     6413               SheetF.Excel-Column-Lable = "":U
     6414               SheetF.ColFormat          = "":U
     6415               SheetF.Sizes              = "":U
     6416               ext-column-label          = "":U
     6417               XLS-page-num              = XLS-page-num - 1
     6418             .
     6419             next .
     6420           end.
     6421           put stream text_out unformatted
     6422             Header-Name  skip
     6423             Header-Line0 skip
     6424             Header-Line1 skip
     6425             Header-Line2 skip
     6426             Header-Line3 skip
     6427             Header-Line4 skip
     6428             Header-Line5 skip
     6429           .
     6430           assign
     6431             Sheetf.Bas-File      = "slptrluk.bas"
     6432             Sheetf.Bas-Param-Add = yes
     6433             Sheetf.Bas-Params    = "Gas"                                  + chr(4) +
     6434                                    string(              j_total-rows    ) + chr(4) +
     6435                                    string(              j_columns-total ) + chr(4) +
     6436                                                                             chr(4) +
     6437                                    string( num-entries( v-green-row   ) ) + chr(4) +
     6438                                    v-green-row
     6439             SheetF.ColFormat     = SheetF.ColFormat                       + chr(4) +
     6440                                                                             chr(4) +
     6441                                    vcurr-sheet-name
     6442           .
     6443           run rep/extitle.p
     6444             ( input XLS-page-num
     6445             ) no-error .
     6446           for each gds-line no-lock where
     6447                    gds-line.is-gas = yes
     6448           break by gds-line.shift-date
     6449                 by gds-line.shift-num
     6450                 by gds-line.line-order
     6451           :
     6452             if first-of( gds-line.shift-num )
     6453             then do:
     6454               assign
     6455                 j_line-counter = 0
     6456               .
     6457             end.
     6458             if gds-line.pay-code = 1000000002
     6459             then do:
     6460               next .
     6461             end.
     6462             if gds-line.all-qnty = 0.00
     6463             then do:
     6464               next .
     6465             end.
     6466             assign
     6467               j_line-counter = j_line-counter + 1
     6468             .
     6469             case j_line-counter :
     6470               when 1
     6471               then do:
     6472                 if gds-line.shift-name = "И Т О Г О"
     6473                 then do:
     6474                   put stream text_out unformatted
     6475                     ":" + fill( " ":U, 10 )
     6476                   .
     6477                   if Make-Excel then  put   stream ForExcel unformatted
     6478                     string( gds-line.shift-name, "x(10)":U      ) CHR(9)
     6479                   .
     6480                 end.
     6481                 else do:
     6482                   put stream text_out unformatted
     6483                     ":" + string( gds-line.shift-date, "99.99.9999":U )
     6484                   .
     6485                   if Make-Excel then  put   stream ForExcel unformatted
     6486                     string( gds-line.shift-date, "99.99.9999":U ) + " ":U +
     6487                     string( gds-line.shift-name, "x(10)":U      ) CHR(9)
     6488                   .
     6489                 end.
     6490               end.
     6491               when 2
     6492               then do:
     6493                 put stream text_out unformatted
     6494                   ":" + Centre( gds-line.shift-name, 10 )
     6495                 .
     6496                 if Make-Excel then  put   stream ForExcel unformatted
     6497                   CHR(9)
     6498                 .
     6499               end.
     6500               otherwise
     6501               do:
     6502                 put stream text_out unformatted
     6503                   ":" + fill( " ":U, 10 )
     6504                 .
     6505                 if Make-Excel then  put   stream ForExcel unformatted
     6506                   CHR(9)
     6507                 .
     6508               end.
     6509             end case.
     6510             put stream text_out unformatted
     6511               ":" + string(         gds-line.pay-name,   "x(17)":U ) +
     6512               ":" + string( OutDec( gds-line.all-qnty ), "x(12)":U )
     6513             .
     6514             if Make-Excel then  put   stream ForExcel unformatted
     6515               string(         gds-line.pay-name,   "x(17)":U ) CHR(9)
     6516               string( OutDec( gds-line.all-qnty ), "x(12)":U ) CHR(9)
     6517                                                                CHR(9)
     6518             .
     6519             assign
     6520               d_total-qnty = 0.00
     6521               d_total-sum  = 0.00
     6522             .
     6523             for each gds-cell no-lock where
     6524                      gds-cell.line-order = gds-line.line-order and
     6525                      gds-cell.is-gas     = yes
     6526             :
     6527               assign
     6528                 d_total-qnty = d_total-qnty + gds-cell.gds-qnty
     6529               .
     6530               if gds-cell.is-cash <> no
     6531               then do:
     6532                 assign
     6533                   d_total-sum = d_total-sum + gds-cell.gds-sum
     6534                 .
     6535               end.
     6536             end.
     6537             put stream text_out unformatted
     6538               ":" + string( OutDec( d_total-qnty ), "x(12)":U )
     6539             .
     6540             if Make-Excel then  put   stream ForExcel unformatted
     6541               string( OutDec( d_total-qnty ), "x(12)":U ) CHR(9)
     6542             .
     6543             if gds-line.is-cash <> no
     6544             then do:
     6545               if gds-line.is-cash = yes
     6546               then do:
     6547                 assign
     6548                   d_gas-price = ( if d_total-qnty <> 0.00 and d_total-qnty <> ? then d_total-sum / d_total-qnty else 0.00 )
     6549                 .
     6550                 put stream text_out unformatted
     6551                   ":" + string( OutDec( d_gas-price ), "x(12)":U )
     6552                 .
     6553                 if Make-Excel then  put   stream ForExcel unformatted
     6554                   string( OutDec( d_gas-price ), "x(12)":U ) CHR(9)
     6555                 .
     6556               end.
     6557               else do:
     6558                 put stream text_out unformatted
     6559                   ":" + fill( " ":U, 12 )
     6560                 .
     6561                 if Make-Excel then  put   stream ForExcel unformatted
     6562                   CHR(9)
     6563                 .
     6564               end.
     6565               put stream text_out unformatted
     6566                 ":" + string( OutDec( d_total-sum ), "x(12)":U )
     6567               .
     6568               if Make-Excel then  put   stream ForExcel unformatted
     6569                 string( OutDec( d_total-sum ), "x(12)":U ) CHR(9)
     6570               .
     6571             end.
     6572             else do:
     6573               put stream text_out unformatted
     6574                 ":" + fill( " ":U, 12 ) +
     6575                 ":" + fill( " ":U, 12 )
     6576               .
     6577               if Make-Excel then  put   stream ForExcel unformatted
     6578                 CHR(9)
     6579                 CHR(9)
     6580               .
     6581             end.
     6582             put stream text_out unformatted
     6583               ":" skip
     6584             .
     6585             if Make-Excel then  put   stream ForExcel unformatted
     6586               CHR(9)
     6587               skip
     6588             .
     6589             if last-of( gds-line.shift-num )
     6590             then do:
     6591               put stream text_out unformatted
     6592                 Under-Line skip
     6593               .
     6594             end.
     6595           end.
     6596           page stream text_out .
     6597           if   Make-Excel Then  do:   Output stream ForExcel close.   assign   number-list = number-list + 1   .   os-delete value( v-excel-file + ".":U + string(number-list)).   Output Stream ForExcel to value( v-excel-file + ".":U + string(number-list ) ) . end.
     6598         end.
     6599         if tt_object.gas-found <> yes
     6600         then do:
     6601           if XLS-page-num > 0
     6602           then do:
     6603             if not available SheetF
     6604             then do:
     6605               find first SheetF where
     6606                          SheetF.Sheet-Num = XLS-page-num no-error .
     6607             end.
     6608             if available SheetF
     6609             then do:
     6610               delete SheetF .
     6611             end.
     6612             assign
     6613               XLS-page-num = XLS-page-num - 1
     6614             .
     6615           end.
     6616         end.
     6617       end.
     6618     end.
     6619     assign
     6620       ReportName   = "Справочно."
     6621       ReportHeader = "":U
     6622       str1         = "Цены. Расход. Рынок. Месяц."
     6623       str2         = "":U
     6624       str3         = "":U
     6625       str4         = "":U
     6626       j_excel-row  = 0
     6627       j_excel-col  = 0
     6628     .
     6629     assign
     6630       XLS-page-num = XLS-page-num + 1
     6631     .
     6632     find first SheetF where
