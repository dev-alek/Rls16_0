     2963     (input  bf_goods.gds-code
     2964     ,input  bf_gds-dtl.prt-code
     2965     ,output varb-code
     2966     ) no-error .
     2967   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2968   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     2969     (input  bf_trn-doc.obj-type
     2970     ,input  bf_trn-doc.obj-code
     2971     ,input  varb-code
     2972     ,input  0
     2973     ,input  bf_trn-doc.fact-order
     2974     ,output vardoc-num
     2975     ,output varprice-sale
     2976     ,output varroad-tax
     2977     ,output varexcise
     2978     )  .
     2979             if varprice-sale = ?
     2980             then do:
     2981               assign
     2982                 varprice-sale = 0
     2983                 varroad-tax   = 0
     2984                 varexcise     = 0
     2985               .
     2986             end.
     2987             assign
     2988               varlastcur-base     = varprice-sale
     2989               varlastcur-road-tax = varroad-tax
     2990               varlastcur-excise   = varexcise
     2991               varcur-base         = varcur-base      + varprice-sale * bf_gds-dtl.fact-qnty
     2992               varcur-road-tax     = varcur-road-tax  + varroad-tax   * bf_gds-dtl.fact-qnty
     2993               varcur-excise       = varcur-excise    + varexcise     * bf_gds-dtl.fact-qnty
     2994               varcur-fact-qnty    = varcur-fact-qnty + bf_gds-dtl.fact-qnty
     2995             .
     2996         end.
     2997       end.
     2998       if varcur-fact-qnty = 0 then do:
     2999         assign
     3000           varcur-base      = varlastcur-base
     3001           varcur-road-tax  = varlastcur-road-tax
     3002           varcur-excise    = varlastcur-excise
     3003         .
     3004       end.
     3005       else do:
     3006         assign
     3007           varcur-base      = varcur-base      / varcur-fact-qnty
     3008           varcur-road-tax  = varcur-road-tax  / varcur-fact-qnty
     3009           varcur-excise    = varcur-excise    / varcur-fact-qnty
     3010         .
     3011       end.
     3012       if varcur-vat-pc = ?
     3013       then do:
     3014         return error substitute ("Нет текущего продажного НДС по товару &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     3015       end.
     3016       if varcur-slt-pc = ?
     3017       then do:
     3018         return error substitute ("Нет текущего продажного НП по товару &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     3019       end.
     3020       find first bf_sysconf where bf_sysconf.host-code = bf_trn-doc.host-code no-lock.
     3021       assign
     3022         varcur-cons-vat-pc = bf_sysconf.cons-vat-pc.
     3023       if varcur-cons-vat-pc = ? then do:
     3024         return error substitute ("Нет текущего продажного консигнационного НДС по фирме &1", bf_trn-doc.host-code).
     3025       end.
     3026       define buffer buf_tt-clcparts for tt-clcparts .
     3027       for each buf_tt-clcparts
     3028       on error undo, return error return-value
     3029       :
