     4508   procedure prn-lib-prn-file :
     4509     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     4510     define input parameter p-DIsabledoptions as integer no-undo .
     4511     define variable v-report-name as character no-undo .
     4512     define variable v-user-action as character no-undo .
     4513     define variable v-printed     as logical   no-undo .
     4514     define variable v-exist       as logical   no-undo .
     4515     do
     4516       on error undo, return error
     4517       :
     4518       run prn-lib-get-report-name  in this-procedure (
     4519         input parParentProc
     4520         ,output v-report-name
     4521         ).
     4522   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4523   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
     4524     (input  v-report-name
     4525     ,input  2
     4526     ,output v-exist
     4527     )  .
     4528       if NOT v-exist then
     4529       DO:
     4530         Message
     4531           "Нет заданий на печать ! "
     4532           view-as alert-box .
     4533         Return  .
     4534       End.
     4535       run gbl/prnfilen.w
     4536         (input  ""
     4537         ,input  p-DisabledOptions
     4538         ,input  string(v-report-name )
     4539         ,input  7
     4540         ,output v-user-action
     4541         ,output v-printed
     4542         ) .
     4543       if v-printed then
     4544       do:
     4545         return "YES" .
     4546       end.
     4547       else
     4548       do:
     4549         return "NO" .
     4550       end.
     4551     end.
     4552   end procedure.
     4553   procedure prn-lib-open-stream :
     4554     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     4555     define input parameter p-page-size    as integer no-undo .
     4556     define input parameter p-is-stream    as logical no-undo .
     4557     define input parameter p-append       as logical no-undo .
     4558     define variable v-report-name as character no-undo .
     4559     do
     4560       on error undo, return error
     4561       :
     4562       run prn-lib-get-report-name  in this-procedure (
     4563         input parParentProc
     4564         ,output v-report-name
     4565         ).
     4566       if p-is-stream then
     4567       do:
     4568         if p-append then
     4569         do:
     4570           output stream text_out to value( v-report-name )
     4571             page-size value(p-page-size) append .
     4572         end.
     4573         if not p-append then
     4574         do:
     4575           output stream text_out to value( v-report-name )
     4576             page-size value(p-page-size) .
     4577         end.
     4578       end.
     4579       if not p-is-stream then
     4580       do:
     4581         if p-append then
     4582         do:
     4583           output to value( v-report-name )
     4584             page-size value(p-page-size) append .
     4585         end.
     4586         if not p-append then
     4587         do:
     4588           output to value( v-report-name )
     4589             page-size value(p-page-size) .
     4590         end.
     4591       end.
     4592     end.
     4593   end procedure.
     4594   procedure prn-lib-open-exp :
     4595     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     4596     define input parameter p-is-stream    as logical no-undo .
     4597     define input parameter p-is-append    as logical no-undo .
     4598     define output parameter p-ReportFileName as char init "report" no-undo.
     4599     define output parameter p-process as logical no-undo .
     4600     define variable glog as logical no-undo .
     4601     do
     4602       on error undo, return error
     4603       :
     4604       SYSTEM-DIALOG GET-FILE p-ReportFileName
     4605         TITLE      "Укажите путь"
     4606         FILTERS "Текстовый файл (*.txt)"   "*.txt"
     4607         ASK-OVERWRITE
     4608         CREATE-TEST-FILE
     4609         SAVE-AS
     4610         USE-FILENAME
     4611         DEFAULT-EXTENSION "txt"
     4612         UPDATE glog
     4613         .
     4614       if not glog then  return.
     4615       p-ReportFileName = trim( string( p-ReportFileName ) ) .
     4616       if p-is-stream then
     4617       do:
     4618         if p-is-append then
     4619         do:
     4620           OUTPUT stream text_out TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     4621         end.
     4622         else
     4623         do:
     4624           OUTPUT stream text_out TO value ( p-ReportFileName ) PAGE-SIZE 0.
     4625         end.
     4626       end.
     4627       else
     4628       do:
     4629         if p-is-append then
     4630         do:
     4631           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     4632         end.
     4633         else
     4634         do:
     4635           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
     4636         end.
     4637       end.
     4638       p-process = yes.
     4639     end.
     4640   end procedure.
