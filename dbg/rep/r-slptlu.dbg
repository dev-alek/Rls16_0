     4719   define variable vss-include-info37 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4720   define variable vss-include-info38 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4721   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
     4722   define variable par-type          as character no-undo.
     4723   define variable v-value-character as character no-undo .
     4724   define variable v-value-date      as date      no-undo .
     4725   define variable v-value-decimal   as decimal   no-undo .
     4726   define variable v-value-integer   as integer   no-undo .
     4727   define variable v-value-logical   as logical   no-undo .
     4728   define variable vss-include-info39 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4729   empty temp-table thbjattr_thbj-attr.
     4730   run adm/shattri.p (
     4731      input "get":U
     4732     ,input v-cntxt-obj-type
     4733     ,input v-cntxt-obj-code
     4734     ,input 'report-firm':U
     4735     ,input  ""
     4736     ,output v-value-character
     4737     ,output v-value-date
     4738     ,output v-value-decimal
     4739     ,output v-value-integer
     4740     ,output v-value-logical
     4741     ,output par-type
     4742     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     4743     ) no-error .
     4744     for each thbjattr_thbj-attr :
     4745         if thbjattr_thbj-attr.prop-code = 'XL-delim'  then v_temp-param   = thbjattr_thbj-attr.property-value-character.
     4746     end.
     4747     IF v_temp-param = "" then XL-delim = ";".
     4748     else XL-delim = v_temp-param.
     4749     for each SheetF where
     4750              SheetF.Sheet-Num > 1
     4751     :
     4752       delete SheetF .
     4753     end.
     4754     for each obj-list no-lock
     4755     :
     4756       create tt_object .
     4757       assign
     4758         tt_object.obj-type  = obj-list.obj-type
     4759         tt_object.obj-code  = obj-list.obj-code
     4760         tt_object.obj-name  = obj-list.obj-name
     4761         tt_object.obj-id    = obj-list.obj-id
     4762         tt_object.db-num    = obj-list.db-num
     4763         tt_object.gds-found = no
     4764         tt_object.gas-found = no
     4765       .
     4766     end.
     4767     run prn-lib-open-stream in this-procedure
     4768       ( input my-handle
     4769       , input 43
     4770       , input yes
     4771       , input no
     4772       ) .
     4773     for each tt_object no-lock
     4774     :
     4775       for each gds-line
     4776       :
     4777         delete gds-line .
     4778       end.
     4779       for each gds-cell
     4780       :
     4781         delete gds-cell .
     4782       end.
     4783       assign
     4784         v-green-row = "":U
     4785       .
     4786       assign
     4787         ReportName       = "":U
     4788         ReportHeader     = "":U
     4789         str1             = "":U
     4790         str2             = "":U
     4791         str3             = "":U
     4792         str4             = "":U
     4793         Header-Line0     = "--------------------------------------------------------"
     4794         Header-Line1     = ":          :                 :          Итого          :"
     4795         Header-Line2     = ":   Дата   :    Покупатель   :------------:------------:"
     4796         Header-Line3     = ":          :                 :   Кол-во   :  сумма нал :"
     4797         Header-Line4     = ":          :                 :     (л)    :   (грн.)   :"
     4798         Header-Line5     = ":----------:-----------------:------------:------------:"
     4799         Header-add-Line0 = "":U
     4800         Header-add-Line1 = "":U
     4801         Header-add-Line2 = "":U
     4802         Header-add-Line3 = "":U
     4803         Header-add-Line4 = "":U
     4804         Header-add-Line5 = "":U
     4805       .
     4806       assign
     4807         j_excel-row = 0
     4808         j_excel-col = 0
     4809       .
     4810       run get-fo-range in this-procedure
     4811         (  input tt_object.obj-type
     4812         ,  input tt_object.obj-code
     4813         ,  input x-Date-Start
     4814         ,  input x-Date-End
     4815         ,  input x-Shift-Start
     4816         ,  input x-Shift-End
     4817         ,  input x-TOG-Shift
     4818         , output fact-order_from
     4819         , output fact-order_till
     4820         ) no-error .
     4821       if error-status :error
     4822       then do:
     4823         message return-value view-as alert-box .
     4824         return error .
     4825       end.
     4826       assign
     4827         j_columns-total = 0
     4828         j_line-order    = 0
     4829       .
     4830       assign
     4831         XLS-page-num = XLS-page-num + 1
     4832       .
     4833       find first SheetF where
     4834                  SheetF.Sheet-Num = XLS-page-num no-error .
     4835       if not available SheetF
     4836       then do:
     4837         create SheetF .
     4838         assign
     4839           SheetF.Sheet-Num = XLS-page-num
     4840         .
     4841       end.
     4842       assign
     4843         SheetF.MergeCellsH        = "3:4"
     4844         SheetF.MergeCellsV        = "1=1:2/2=1:2"
     4845         SheetF.Excel-Column-Lable = "Дата"              + chr(44) +
     4846                                     "Покупатель"        + chr(44) +
     4847                                     "Итого"             + chr(44) +
     4848                                     "":U
     4849         SheetF.ColFormat          = "3=" + "0" + v-delim + "00" + ";" +
     4850                                     "4=" + "0" + v-delim + "00"
     4851         SheetF.Sizes              = "10,17,12,12"
     4852         ext-column-label          = "":U             + chr(44) +
     4853                                     "":U             + chr(44) +
     4854                                     "Кол-во (л)"     + chr(44) +
     4855                                     "Сумма нал(грн)"
     4856       .
     4857       run cr-gds-list in this-procedure
     4858         ( input tt_object.obj-type
     4859         , input tt_object.obj-code
     4860         ) no-error .
     4861       if error-status :error
     4862       then do:
     4863         message return-value view-as alert-box .
     4864         return error .
     4865       end.
     4866       find first bf_gds-ptrl no-lock where
     4867                  bf_gds-ptrl.obj-type = tt_object.obj-type and
     4868                  bf_gds-ptrl.obj-code = tt_object.obj-code no-error .
     4869       if not available bf_gds-ptrl
     4870       then do:
     4871         assign
     4872           SheetF.MergeCellsH        = "":U
     4873           SheetF.MergeCellsV        = "":U
     4874           SheetF.Excel-Column-Lable = "":U
     4875           SheetF.ColFormat          = "":U
     4876           SheetF.Sizes              = "":U
     4877           ext-column-label          = "":U
     4878           XLS-page-num              = XLS-page-num - 1
     4879         .
     4880         next .
     4881       end.
     4882       assign
     4883         goods-found   = no
     4884         gds-ptr-found = no
     4885         gds-gas-found = no
     4886       .
     4887       for each gds-ptrl no-lock where
     4888                gds-ptrl.obj-type = tt_object.obj-type and
     4889                gds-ptrl.obj-code = tt_object.obj-code
     4890       :
     4891         find first bf_object exclusive-lock where
     4892             recid( bf_object ) = recid( tt_object ) .
     4893         if gds-ptrl.is-gas = no
     4894         then do:
     4895           assign
     4896             bf_object.gds-found = yes
     4897           .
     4898           assign
     4899             gds-ptr-found = yes
     4900           .
     4901         end.
     4902         if gds-ptrl.is-gas = yes
     4903         then do:
     4904           assign
     4905             bf_object.gas-found = yes
     4906           .
     4907           assign
     4908             gds-gas-found = yes
     4909           .
     4910         end.
     4911         if bf_object.gas-found = yes or
     4912            bf_object.gds-found = yes
     4913         then do:
     4914           assign
     4915             bf_object.was-found = yes
     4916           .
     4917         end.
     4918         find first bf_object        no-lock where
     4919             recid( bf_object ) = recid( tt_object ) .
     4920       end.
     4921       assign
     4922         j_columns-total = 0
     4923       .
     4924       for each gds-ptrl no-lock where
     4925                gds-ptrl.obj-type = tt_object.obj-type and
     4926                gds-ptrl.obj-code = tt_object.obj-code and
     4927                gds-ptrl.is-gas   = no
     4928             by gds-ptrl.gds-order
     4929       :
     4930         assign
     4931           gds-ptr-found    = yes
     4932           j_columns-total  = j_columns-total  + 1
     4933           Header-add-Line0 = Header-add-Line0 + "---------------------------------------"
     4934           Header-add-Line1 = Header-add-Line1 + Centre( gds-ptrl.gds-name, 38 )     + ":"
     4935           Header-add-Line2 = Header-add-Line2 + "------------:------------:------------:"
     4936           Header-add-Line3 = Header-add-Line3 + "   Кол-во   :    Цена    :    Сумма   :"
     4937           Header-add-Line4 = Header-add-Line4 + "     (л)    :   реализ   :   реализ   :"
     4938           Header-add-Line5 = Header-add-Line5 + "------------:------------:------------:"
     4939         .
     4940         assign
     4941           SheetF.Excel-Column-Lable = SheetF.Excel-Column-Lable + chr(44) +
     4942                                       replace( gds-ptrl.gds-name, chr(44), chr(32) )
     4943                                                                 + chr(44)
     4944                                                                 + chr(44)
     4945           ext-column-label          = ext-column-label          + chr(44) +
     4946                                       "Кол-во (л)"              + chr(44) +
     4947                                       "Цена реализ"             + chr(44) +
     4948                                       "Сумма реализ"
     4949           SheetF.ColFormat          = SheetF.ColFormat                                               + ";" +
     4950                                       string( j_columns-total * 3 + 2 ) + "=" + "0" + v-delim + "00" + ";" +
     4951                                       string( j_columns-total * 3 + 3 ) + "=" + "0" + v-delim + "00" + ";" +
     4952                                       string( j_columns-total * 3 + 4 ) + "=" + "0" + v-delim + "00"
     4953           SheetF.Sizes              = SheetF.Sizes + chr(44) + "12" +
     4954                                                      chr(44) + "12" +
     4955                                                      chr(44) + "12"
     4956           SheetF.MergeCellsH        = SheetF.MergeCellsH                + chr(44) +
     4957                                       string( j_columns-total * 3 + 2 ) + ":"           +
     4958                                       string( j_columns-total * 3 + 4 )
     4959         .
     4960       end.
     4961       assign
     4962         SheetF.Excel-Column-Lable = SheetF.Excel-Column-Lable + chr(10) + ext-column-label
     4963       .
     4964       if tt_object.gds-found = yes
     4965       then do:
     4966         assign
     4967           ReportName   = substitute( 'Отчет по розничной реализации нефтепродуктов на &1'
     4968                                    , tt_object.obj-name
     4969                                    )
     4970           j_length     = 56 + 39 * j_columns-total
     4971           Under-Line   = fill( "-", j_length )
     4972           str1         = substitute( "за период с &1 по &2"
     4973                                    , string( x-Date-Start, "99/99/9999":U )
     4974                                    , string( x-Date-End,   "99/99/9999":U )
     4975                                    )
     4976           ReportHeader = substitute( "Дата печати: &1, время: &2"
     4977                                    , string( t_today, "99.99.9999":U )
     4978                                    , string( j_time,  "HH:MM:SS":U   )
     4979                                    )
     4980           Header-Name  = Centering(  caps( ReportName ), j_length ) +
     4981                          chr(10)                                +
     4982                          Centering(        str1,         j_length ) +
     4983                          chr(10)                                +
     4984                          chr(10)                                +
     4985                          chr(10)                                +
     4986                          ShiftRight(       ReportHeader, j_length )
     4987         .
     4988         assign
     4989           j_line-order = 0
     4990         .
     4991         for each bf_shift-obj no-lock where
     4992                  bf_shift-obj.obj-type    = tt_object.obj-type and
     4993                  bf_shift-obj.obj-code    = tt_object.obj-code and
     4994                  bf_shift-obj.status_     = 'зкр':U      and
     4995                  bf_shift-obj.fact-order >= fact-order_from    and
     4996                  bf_shift-obj.fact-order <= fact-order_till
     4997         break by bf_shift-obj.shift-date
     4998               by bf_shift-obj.shift-num
     4999         :
     5000           if first-of( bf_shift-obj.shift-num )
     5001           then do:
     5002             for each treal-2
     5003             :
     5004               delete treal-2 .
     5005             end.
     5006             run rep/r-shftch.p
     5007               ( input bf_shift-obj.obj-type
     5008               , input bf_shift-obj.obj-code
     5009               , input bf_shift-obj.shift-date
     5010               , input bf_shift-obj.shift-num
     5011               , input bf_shift-obj.shift-date
     5012               , input bf_shift-obj.shift-num
     5013               , input 1110
     5014               , input yes
     5015               , input yes
     5016               , input yes
     5017               , input no
     5018               , input no
     5019               , input no
     5020               ) no-error .
     5021             if error-status :error
     5022             then do:
     5023               message return-value view-as alert-box .
     5024               return error .
     5025             end.
     5026           end.
     5027           assign
     5028             j_excel-row   = 0
     5029             j_start-order = j_line-order
     5030           .
     5031           for each treal-2 no-lock where
     5032                    treal-2.is-pay    <> ? and
     5033                    treal-2.curr-code >= 0
     5034           :
     5035             find first gds-ptrl no-lock where
     5036                        gds-ptrl.obj-type = tt_object.obj-type and
     5037                        gds-ptrl.obj-code = tt_object.obj-code and
     5038                        gds-ptrl.is-gas   = no                 and
     5039                        gds-ptrl.gds-code = treal-2.gds-code   no-error .
     5040             if not available gds-ptrl
     5041             then do:
     5042               next .
     5043             end.
     5044             assign
     5045               j_excel-row = j_excel-row + 1
     5046             .
     5047             find first gds-line where
     5048                        gds-line.pay-code   = treal-2.cpay-code       and
     5049                        gds-line.shift-date = bf_shift-obj.shift-date and
     5050                        gds-line.shift-num  = bf_shift-obj.shift-num  and
     5051                        gds-line.is-gas     = gds-ptrl.is-gas         no-error .
     5052             if not available gds-line
     5053             then do:
     5054               assign
     5055                 j_line-order = j_line-order + 10
     5056               .
     5057               find first ub.cash-pay no-lock where
     5058                          ub.cash-pay.cdpay-code = treal-2.cpay-code and
     5059                          ub.cash-pay.curr-code  = treal-2.curr-code no-error .
     5060               create gds-line .
     5061               assign
     5062                 gds-line.line-order = j_line-order
     5063                 gds-line.shift-date = bf_shift-obj.shift-date
     5064                 gds-line.shift-num  = bf_shift-obj.shift-num
     5065                 gds-line.shift-name = bf_shift-obj.shift-name
     5066                 gds-line.pay-code   = treal-2.cpay-code
     5067                 gds-line.out-name   = treal-2.out-name
     5068                 gds-line.pay-name   = ( if available ub.cash-pay then ub.cash-pay.obj-name else treal-2.out-name )
     5069                 gds-line.is-cash    = ( if available ub.cash-pay then ub.cash-pay.is-cash  else no )
     5070                 gds-line.is-gas     = gds-ptrl.is-gas
     5071                 gds-line.col-count  = j_columns-total
     5072               .
     5073               if gds-line.is-cash = no and
     5074                  ( available ub.cash-pay )
     5075               then do:
     5076                 find first tt_obj-pay no-lock where
     5077                            tt_obj-pay.obj-type = bf_shift-obj.obj-type and
     5078                            tt_obj-pay.obj-code = bf_shift-obj.obj-code and
     5079                            tt_obj-pay.pay-name = gds-line.pay-name     no-error .
     5080                 if not available tt_obj-pay
     5081                 then do:
     5082                   create tt_obj-pay .
     5083                   assign
     5084                     tt_obj-pay.obj-type = bf_shift-obj.obj-type
     5085                     tt_obj-pay.obj-code = bf_shift-obj.obj-code
     5086                     tt_obj-pay.pay-name = gds-line.pay-name
     5087                     tt_obj-pay.pay-num  = 0
     5088                     tt_obj-pay.xls-col  = 0
     5089                   .
     5090                 end.
     5091               end.
     5092             end.
     5093             assign
     5094               gds-line.all-qnty = gds-line.all-qnty + treal-2.qnty1
     5095               gds-line.all-sum  = gds-line.all-sum  + ( if gds-line.is-cash = yes then treal-2.netto else 0.00 )
     5096             .
     5097             find first gds-cell where
     5098                        gds-cell.shift-date = bf_shift-obj.shift-date and
     5099                        gds-cell.shift-num  = bf_shift-obj.shift-num  and
     5100                        gds-cell.pay-code   = treal-2.cpay-code       and
     5101                        gds-cell.gds-code   = treal-2.gds-code        no-error .
     5102             if not available gds-cell
     5103             then do:
     5104               create gds-cell .
     5105               assign
     5106                 gds-cell.line-order = gds-line.line-order
     5107                 gds-cell.shift-date = gds-line.shift-date
     5108                 gds-cell.shift-num  = gds-line.shift-num
     5109                 gds-cell.pay-code   = gds-line.pay-code
     5110                 gds-cell.is-cash    = gds-line.is-cash
     5111                 gds-cell.is-gas     = gds-ptrl.is-gas
     5112                 gds-cell.gds-order  = gds-ptrl.gds-order
     5113                 gds-cell.gds-code   = gds-ptrl.gds-code
     5114                 gds-cell.col-count  = gds-line.col-count
     5115               .
     5116             end.
     5117             assign
     5118               gds-cell.gds-qnty  = gds-cell.gds-qnty  + treal-2.qnty1
     5119               gds-cell.gds-sum   = gds-cell.gds-sum   + ( if treal-2.is-pay = yes then treal-2.netto                 else 0.00 )
     5120               gds-cell.gds-price = gds-cell.gds-price + ( if treal-2.is-pay = yes then treal-2.netto / treal-2.qnty1 else 0.00 )
     5121             .
     5122           end.
     5123           for each gds-line where
     5124                    gds-line.line-order > j_start-order
     5125           :
     5126             for each gds-cell where
     5127                      gds-cell.line-order = gds-line.line-order
     5128             :
     5129               assign
     5130                 gds-cell.row-count = j_excel-row
     5131               .
     5132             end.
     5133             assign
     5134               gds-line.row-count = j_excel-row
     5135             .
     5136           end.
     5137           assign
     5138             d_all-qnty = 0.00
     5139             d_all-sum  = 0.00
     5140           .
     5141           for each gds-line no-lock
     5142              where gds-line.line-order > j_start-order
     5143                and gds-line.is-cash    = no
     5144                and gds-line.shift-date = bf_shift-obj.shift-date
     5145                and gds-line.shift-num  = bf_shift-obj.shift-num
     5146           :
     5147             assign
     5148               d_all-qnty = d_all-qnty + gds-line.all-qnty
     5149             .
     5150           end.
     5151           assign
     5152             j_line-order = j_line-order + 10
     5153           .
     5154           create gds-line .
     5155           assign
     5156             gds-line.line-order = j_line-order
     5157             gds-line.shift-date = bf_shift-obj.shift-date
     5158             gds-line.shift-num  = bf_shift-obj.shift-num
     5159             gds-line.shift-name = bf_shift-obj.shift-name
     5160             gds-line.pay-code   = 1000000001
     5161             gds-line.out-name   = "Всего б/н"
     5162             gds-line.pay-name   = "Всего б/н"
     5163             gds-line.is-cash    = no
     5164             gds-line.is-gas     = no
     5165             gds-line.col-count  = j_columns-total
     5166             gds-line.row-count  = j_excel-row
     5167             gds-line.all-qnty   = d_all-qnty
     5168             gds-line.all-sum    = 0.00
     5169           .
     5170           assign
     5171             d_all-qnty = 0.00
     5172           .
     5173           for each bf_gds-cell no-lock where
     5174                    bf_gds-cell.line-order > j_start-order       and
     5175                    bf_gds-cell.shift-date = gds-line.shift-date and
     5176                    bf_gds-cell.shift-num  = gds-line.shift-num  and
     5177                    bf_gds-cell.is-cash    = gds-line.is-cash
     5178           break by bf_gds-cell.gds-code
     5179                 by bf_gds-cell.pay-code
     5180           :
     5181             if first-of( bf_gds-cell.gds-code )
     5182             then do:
     5183               assign
     5184                 d_all-qnty = 0.00
     5185               .
     5186             end.
     5187             assign
     5188               d_all-qnty = d_all-qnty + bf_gds-cell.gds-qnty
     5189             .
     5190             if last-of( bf_gds-cell.gds-code )
     5191             then do:
     5192               create gds-cell .
     5193               assign
     5194                 gds-cell.line-order = j_line-order
     5195                 gds-cell.shift-date = gds-line.shift-date
     5196                 gds-cell.shift-num  = gds-line.shift-num
     5197                 gds-cell.pay-code   = gds-line.pay-code
     5198                 gds-cell.is-cash    = gds-line.is-cash
     5199                 gds-cell.is-gas     = bf_gds-cell.is-gas
     5200                 gds-cell.gds-order  = bf_gds-cell.gds-order
     5201                 gds-cell.gds-code   = bf_gds-cell.gds-code
     5202                 gds-cell.col-count  = gds-line.col-count
     5203                 gds-cell.gds-qnty   = d_all-qnty
     5204                 gds-cell.gds-sum    = 0.00
     5205                 gds-cell.gds-price  = 0.00
     5206               .
     5207             end.
     5208           end.
     5209           assign
     5210             d_all-qnty = 0.00
     5211             d_all-sum  = 0.00
     5212           .
     5213           for each gds-line no-lock
     5214              where gds-line.line-order > j_start-order
     5215                and gds-line.is-cash    = yes
     5216                and gds-line.shift-date = bf_shift-obj.shift-date
     5217                and gds-line.shift-num  = bf_shift-obj.shift-num
     5218           on error undo, return error return-value
     5219           :
     5220             assign
     5221               d_all-qnty = d_all-qnty + gds-line.all-qnty
     5222               d_all-sum  = d_all-sum  + gds-line.all-sum
     5223             .
     5224           end.
     5225           assign
     5226             j_line-order = j_line-order + 10
     5227           .
     5228           create gds-line .
     5229           assign
     5230             gds-line.line-order = j_line-order
     5231             gds-line.shift-date = bf_shift-obj.shift-date
     5232             gds-line.shift-num  = bf_shift-obj.shift-num
     5233             gds-line.shift-name = bf_shift-obj.shift-name
     5234             gds-line.pay-code   = 1000000002
     5235             gds-line.out-name   = "Всего нал"
     5236             gds-line.pay-name   = "Всего нал"
     5237             gds-line.is-cash    = yes
     5238             gds-line.is-gas     = no
     5239             gds-line.col-count  = j_columns-total
     5240             gds-line.row-count  = j_excel-row
     5241             gds-line.all-qnty   = d_all-qnty
     5242             gds-line.all-sum    = d_all-sum
     5243           .
     5244           assign
     5245             d_all-qnty = 0.00
     5246             d_all-sum  = 0.00
     5247           .
     5248           for each bf_gds-cell no-lock where
     5249                    bf_gds-cell.line-order > j_start-order       and
     5250                    bf_gds-cell.shift-date = gds-line.shift-date and
     5251                    bf_gds-cell.shift-num  = gds-line.shift-num  and
     5252                    bf_gds-cell.is-cash    = gds-line.is-cash
     5253           break by bf_gds-cell.gds-code
     5254                 by bf_gds-cell.pay-code
     5255           :
     5256             if first-of( bf_gds-cell.gds-code )
     5257             then do:
     5258               assign
     5259                 d_all-qnty = 0.00
     5260                 d_all-sum  = 0.00
     5261               .
     5262             end.
     5263             assign
     5264               d_all-qnty = d_all-qnty + bf_gds-cell.gds-qnty
     5265               d_all-sum  = d_all-sum  + bf_gds-cell.gds-sum
     5266             .
     5267             if last-of( bf_gds-cell.gds-code )
     5268             then do:
     5269               create gds-cell .
     5270               assign
     5271                 gds-cell.line-order = j_line-order
     5272                 gds-cell.shift-date = gds-line.shift-date
     5273                 gds-cell.shift-num  = gds-line.shift-num
     5274                 gds-cell.pay-code   = gds-line.pay-code
     5275                 gds-cell.is-cash    = gds-line.is-cash
     5276                 gds-cell.is-gas     = bf_gds-cell.is-gas
     5277                 gds-cell.gds-order  = bf_gds-cell.gds-order
     5278                 gds-cell.gds-code   = bf_gds-cell.gds-code
     5279                 gds-cell.col-count  = gds-line.col-count
     5280                 gds-cell.gds-qnty   = d_all-qnty
     5281                 gds-cell.gds-sum    = d_all-sum
     5282                 gds-cell.gds-price  = 0.00
     5283               .
     5284             end.
     5285           end.
     5286           assign
     5287             d_all-qnty = 0.00
     5288             d_all-sum  = 0.00
     5289           .
     5290           for each gds-line no-lock where
     5291                    gds-line.line-order > j_start-order           and
     5292                    gds-line.shift-date = bf_shift-obj.shift-date and
     5293                    gds-line.shift-num  = bf_shift-obj.shift-num  and
     5294                  ( gds-line.pay-code   = 1000000001 or
     5295                    gds-line.pay-code   = 1000000002 )
     5296           :
     5297             assign
     5298               d_all-qnty = d_all-qnty + gds-line.all-qnty
     5299               d_all-sum  = d_all-sum  + gds-line.all-sum
     5300             .
     5301           end.
     5302           assign
     5303             j_line-order = j_line-order + 10
     5304           .
     5305           create gds-line .
     5306           assign
     5307             gds-line.line-order = j_line-order
     5308             gds-line.shift-date = bf_shift-obj.shift-date
     5309             gds-line.shift-num  = bf_shift-obj.shift-num
     5310             gds-line.shift-name = bf_shift-obj.shift-name
     5311             gds-line.pay-code   = 1000000003
     5312             gds-line.out-name   = "Всего (нал+б/н)"
     5313             gds-line.pay-name   = "Всего (нал+б/н)"
     5314             gds-line.is-cash    = ?
     5315             gds-line.is-gas     = no
     5316             gds-line.col-count  = j_columns-total
     5317             gds-line.row-count  = j_excel-row
     5318             gds-line.all-qnty   = d_all-qnty
     5319             gds-line.all-sum    = d_all-sum
     5320           .
     5321           assign
     5322             d_all-qnty = 0.00
     5323             d_all-sum  = 0.00
     5324           .
     5325           for each bf_gds-cell no-lock
     5326              where bf_gds-cell.line-order > j_start-order
     5327                and bf_gds-cell.shift-date = gds-line.shift-date
     5328                and bf_gds-cell.shift-num  = gds-line.shift-num
     5329                and ( bf_gds-cell.pay-code   = 1000000001
     5330                     or bf_gds-cell.pay-code = 1000000002 )
     5331           break by bf_gds-cell.gds-code
     5332                 by bf_gds-cell.pay-code
     5333           :
     5334             if first-of( bf_gds-cell.gds-code )
     5335             then do:
     5336               assign
     5337                 d_all-qnty = 0.00
     5338                 d_all-sum  = 0.00
     5339               .
     5340             end.
     5341             assign
     5342               d_all-qnty = d_all-qnty + bf_gds-cell.gds-qnty
     5343               d_all-sum  = d_all-sum  + bf_gds-cell.gds-sum
     5344             .
     5345             if last-of( bf_gds-cell.gds-code )
     5346             then do:
     5347               create gds-cell .
     5348               assign
     5349                 gds-cell.line-order = j_line-order
     5350                 gds-cell.shift-date = gds-line.shift-date
     5351                 gds-cell.shift-num  = gds-line.shift-num
     5352                 gds-cell.pay-code   = gds-line.pay-code
     5353                 gds-cell.is-cash    = gds-line.is-cash
     5354                 gds-cell.is-gas     = bf_gds-cell.is-gas
     5355                 gds-cell.gds-order  = bf_gds-cell.gds-order
     5356                 gds-cell.gds-code   = bf_gds-cell.gds-code
     5357                 gds-cell.col-count  = gds-line.col-count
     5358                 gds-cell.gds-qnty   = d_all-qnty
     5359                 gds-cell.gds-sum    = d_all-sum
     5360                 gds-cell.gds-price  = 0.00
     5361               .
     5362             end.
     5363           end.
     5364           assign
     5365             d_all-qnty = 0.00
     5366             d_all-sum  = 0.00
     5367           .
     5368         end.
     5369         assign
     5370           j_start-order = j_line-order
     5371         .
     5372         for each bf_gds-line no-lock
     5373            where bf_gds-line.is-gas     = no
     5374              and bf_gds-line.line-order <= j_start-order
     5375         break by bf_gds-line.pay-code
     5376               by bf_gds-line.is-cash
     5377               by bf_gds-line.shift-date
     5378               by bf_gds-line.shift-num
     5379               by bf_gds-line.line-order
     5380         :
     5381           if first-of( bf_gds-line.pay-code )
     5382           then do:
     5383             assign
     5384               j_line-order = j_line-order + 10
     5385             .
     5386             create gds-line .
     5387             assign
     5388               gds-line.line-order = j_line-order
     5389               gds-line.shift-date = today + 396
     5390               gds-line.shift-num  = 99
     5391               gds-line.shift-name = "И Т О Г О"
     5392               gds-line.pay-code   = bf_gds-line.pay-code
     5393               gds-line.out-name   = bf_gds-line.out-name
     5394               gds-line.pay-name   = bf_gds-line.pay-name
     5395               gds-line.is-cash    = bf_gds-line.is-cash
     5396               gds-line.is-gas     = bf_gds-line.is-gas
     5397               gds-line.col-count  = bf_gds-line.col-count
     5398               gds-line.row-count  = 0
     5399               gds-line.all-qnty   = 0.00
     5400               gds-line.all-sum    = 0.00
     5401             .
     5402           end.
     5403           assign
     5404             gds-line.all-qnty  = gds-line.all-qnty  + bf_gds-line.all-qnty
     5405             gds-line.row-count = gds-line.row-count + 1
     5406           .
     5407           if gds-line.is-cash <> no
     5408           then do:
     5409             assign
     5410               gds-line.all-sum = gds-line.all-sum + bf_gds-line.all-sum
     5411             .
     5412           end.
     5413           if last-of( bf_gds-line.pay-code )
     5414           then do:
     5415             for each bf_gds-cell no-lock
     5416                where bf_gds-cell.is-gas   = bf_gds-line.is-gas
     5417                  and bf_gds-cell.pay-code = bf_gds-line.pay-code
     5418                  and bf_gds-cell.line-order <= j_start-order
     5419             break by bf_gds-cell.gds-order
     5420                   by bf_gds-cell.is-cash
     5421                   by bf_gds-cell.shift-date
     5422                   by bf_gds-cell.shift-num
     5423                   by bf_gds-cell.gds-code
     5424             :
     5425               if first-of( bf_gds-cell.gds-order )
     5426               then do:
     5427                 create gds-cell .
     5428                 assign
     5429                   gds-cell.line-order = gds-line.line-order
     5430                   gds-cell.shift-date = gds-line.shift-date
     5431                   gds-cell.shift-num  = gds-line.shift-num
     5432                   gds-cell.pay-code   = gds-line.pay-code
     5433                   gds-cell.is-cash    = gds-line.is-cash
     5434                   gds-cell.is-gas     = bf_gds-cell.is-gas
     5435                   gds-cell.gds-order  = bf_gds-cell.gds-order
     5436                   gds-cell.gds-code   = bf_gds-cell.gds-code
     5437                   gds-cell.col-count  = gds-line.col-count
     5438                   gds-cell.row-count  = gds-line.row-count
     5439                   gds-cell.gds-qnty   = 0.00
     5440                   gds-cell.gds-price  = 0.00
     5441                   gds-cell.gds-sum    = 0.00
     5442                 .
     5443               end.
     5444               assign
     5445                 gds-cell.gds-qnty = gds-cell.gds-qnty + bf_gds-cell.gds-qnty
     5446               .
     5447               if gds-cell.is-cash <> no
     5448               then do:
     5449                 assign
     5450                   gds-cell.gds-sum = gds-cell.gds-sum + bf_gds-cell.gds-sum
     5451                 .
     5452               end.
     5453             end.
     5454           end.
     5455         end.
     5456         assign
     5457           j_total-rows   = 0
     5458           j_line-counter = 0
     5459         .
     5460         for each gds-line no-lock
     5461         break by gds-line.shift-date
     5462               by gds-line.shift-num
     5463               by gds-line.line-order
     5464         :
     5465           if first-of( gds-line.shift-num )
     5466           then do:
     5467             assign
     5468               j_line-counter = 0
     5469             .
     5470           end.
     5471           if gds-line.pay-code = 1000000002
     5472           then do:
     5473             next .
     5474           end.
     5475           if gds-line.all-qnty = 0.00
     5476           then do:
     5477             next .
     5478           end.
     5479           assign
     5480             j_line-counter = j_line-counter + 1
     5481           .
     5482           if last-of( gds-line.shift-num )
     5483           then do:
     5484             assign
     5485               j_total-rows = j_total-rows + j_line-counter
     5486               v-green-row  = v-green-row  +
     5487                              ( if v-green-row = "":U then "":U else chr(44) ) +
     5488                              string( j_total-rows + 6 )
     5489             .
     5490             for each bf_gds-line where
     5491                      bf_gds-line.shift-date = gds-line.shift-date and
     5492                      bf_gds-line.shift-num  = gds-line.shift-num
     5493             :
     5494               for each bf_gds-cell where
     5495                        bf_gds-cell.line-order = bf_gds-line.line-order
     5496               :
     5497                 assign
     5498                   bf_gds-cell.row-count = j_line-counter
     5499                 .
     5500               end.
     5501               assign
     5502                 bf_gds-line.row-count = j_line-counter
     5503               .
     5504             end.
     5505           end.
     5506         end.
     5507         if not can-find( first bf_gds-line no-lock )
     5508         then do:
     5509           assign
     5510             SheetF.MergeCellsH        = "":U
     5511             SheetF.MergeCellsV        = "":U
     5512             SheetF.Excel-Column-Lable = "":U
     5513             SheetF.ColFormat          = "":U
     5514             SheetF.Sizes              = "":U
     5515             ext-column-label          = "":U
     5516             XLS-page-num              = XLS-page-num - 1
     5517           .
     5518           next .
     5519         end.
     5520         put stream text_out unformatted
     5521           Header-Name                     skip
     5522           Header-Line0 + Header-add-Line0 skip
     5523           Header-Line1 + Header-add-Line1 skip
     5524           Header-Line2 + Header-add-Line2 skip
     5525           Header-Line3 + Header-add-Line3 skip
     5526           Header-Line4 + Header-add-Line4 skip
     5527           Header-Line5 + Header-add-Line5 skip
     5528         .
     5529         assign
     5530           vcurr-sheet-name = tt_object.obj-name
     5531         .
     5532         assign
     5533           Sheetf.Bas-File      = "slptrluk.bas"
     5534           Sheetf.Bas-Param-Add = yes
     5535           Sheetf.Bas-Params    = "Petrol"                               + chr(4) +
     5536                                  string(              j_total-rows    ) + chr(4) +
     5537                                  string(              j_columns-total ) + chr(4) +
     5538                                                                           chr(4) +
     5539                                  string( num-entries( v-green-row   ) ) + chr(4) +
     5540                                  v-green-row
     5541           SheetF.ColFormat     = SheetF.ColFormat                       + chr(4) +
     5542                                                                           chr(4) +
     5543                                  vcurr-sheet-name
     5544         .
     5545         run rep/extitle.p
     5546           ( input XLS-page-num
     5547           ) no-error .
     5548         assign
     5549           j_line-counter = 0
     5550         .
     5551         for each gds-line no-lock where
     5552                  gds-line.is-gas = no
     5553         break by gds-line.shift-date
     5554               by gds-line.shift-num
     5555               by gds-line.line-order
     5556         :
     5557           if first-of( gds-line.shift-num )
     5558           then do:
     5559             assign
     5560               j_line-counter = 0
     5561             .
     5562           end.
     5563           if gds-line.pay-code = 1000000002
     5564           then do:
     5565             next .
     5566           end.
     5567           if gds-line.all-qnty = 0.00
     5568           then do:
     5569             next .
     5570           end.
     5571           assign
     5572             j_line-counter = j_line-counter + 1
     5573           .
     5574           case j_line-counter :
     5575             when 1
     5576             then do:
     5577               if gds-line.shift-name = "И Т О Г О"
     5578               then do:
     5579                 put stream text_out unformatted
     5580                   ":" + fill( " ":U, 10 )
     5581                 .
     5582                 if Make-Excel then  put   stream ForExcel unformatted
     5583                   string( gds-line.shift-name, "x(10)":U      ) CHR(9)
     5584                 .
     5585               end.
     5586               else do:
     5587                 put stream text_out unformatted
     5588                   ":" + string( gds-line.shift-date, "99.99.9999":U )
     5589                 .
     5590                 if Make-Excel then  put   stream ForExcel unformatted
     5591                   string( gds-line.shift-date, "99.99.9999":U ) + " ":U +
     5592                   string( gds-line.shift-name, "x(10)":U      ) CHR(9)
     5593                 .
     5594               end.
     5595             end.
     5596             when 2
     5597             then do:
     5598               put stream text_out unformatted
     5599                 ":" + Centre( gds-line.shift-name, 10 )
     5600               .
     5601               if Make-Excel then  put   stream ForExcel unformatted
     5602                 CHR(9)
     5603               .
     5604             end.
     5605             otherwise
     5606             do:
     5607               put stream text_out unformatted
     5608                 ":" + fill( " ":U, 10 )
     5609               .
     5610               if Make-Excel then  put   stream ForExcel unformatted
     5611                 CHR(9)
     5612               .
     5613             end.
     5614           end case.
     5615           put stream text_out unformatted
     5616             ":" + string(         gds-line.pay-name,   "x(17)":U ) +
     5617             ":" + string( OutDec( gds-line.all-qnty ), "x(12)":U )
     5618           .
     5619           if Make-Excel then  put   stream ForExcel unformatted
     5620             string(         gds-line.pay-name,   "x(17)":U ) CHR(9)
     5621             string( OutDec( gds-line.all-qnty ), "x(12)":U ) CHR(9)
     5622           .
     5623           if gds-line.is-cash = no
     5624           then do:
     5625             put stream text_out unformatted
     5626               ":" + fill( " ":U, 12 )
     5627             .
     5628             if Make-Excel then  put   stream ForExcel unformatted
     5629               CHR(9)
     5630             .
     5631           end.
     5632           else do:
     5633             put stream text_out unformatted
     5634               ":" + string( OutDec( gds-line.all-sum ), "x(12)":U )
     5635             .
     5636             if Make-Excel then  put   stream ForExcel unformatted
     5637               string( OutDec( gds-line.all-sum ), "x(12)":U ) CHR(9)
     5638             .
     5639           end.
     5640           do jj = 1 to gds-line.col-count
     5641           :
     5642             find first gds-cell no-lock where
     5643                        gds-cell.line-order = gds-line.line-order and
     5644                        gds-cell.gds-order  = jj                  no-error .
     5645             if available gds-cell
     5646             then do:
     5647               put stream text_out unformatted
     5648                 ":" + string( OutDec( gds-cell.gds-qnty  ), "x(12)":U )
     5649               .
     5650               if Make-Excel then  put   stream ForExcel unformatted
     5651                 string( OutDec( gds-cell.gds-qnty  ), "x(12)":U ) CHR(9)
     5652               .
     5653               if gds-cell.is-cash = no
     5654               then do:
     5655                 put stream text_out unformatted
     5656                   ":" + fill( " ":U, 12 ) +
     5657                   ":" + fill( " ":U, 12 )
     5658                 .
     5659                 if Make-Excel then  put   stream ForExcel unformatted
     5660                   CHR(9)
     5661                   CHR(9)
     5662                 .
     5663               end.
     5664               else do:
     5665                 if gds-line.is-cash =  yes
     5666                 then do:
     5667                   put stream text_out unformatted
     5668                     ":" + string( OutDec( gds-cell.gds-price ), "x(12)":U )
     5669                   .
     5670                   if Make-Excel then  put   stream ForExcel unformatted
     5671                     string( OutDec( gds-cell.gds-price ), "x(12)":U ) CHR(9)
     5672                   .
     5673                 end.
     5674                 else do:
     5675                   put stream text_out unformatted
     5676                     ":" + fill( " ":U, 12 )
     5677                   .
     5678                   if Make-Excel then  put   stream ForExcel unformatted
     5679                     CHR(9)
     5680                   .
     5681                 end.
     5682                 put stream text_out unformatted
     5683                   ":" + string( OutDec( gds-cell.gds-sum ), "x(12)":U )
     5684                 .
     5685                 if Make-Excel then  put   stream ForExcel unformatted
     5686                   string( OutDec( gds-cell.gds-sum ), "x(12)":U ) CHR(9)
     5687                 .
     5688               end.
     5689             end.
     5690             else do:
     5691               put stream text_out unformatted
     5692                 ":" + fill( " ":U, 12 ) +
     5693                 ":" + fill( " ":U, 12 ) +
     5694                 ":" + fill( " ":U, 12 )
     5695               .
     5696               if Make-Excel then  put   stream ForExcel unformatted
     5697                 CHR(9)
     5698                 CHR(9)
     5699                 CHR(9)
     5700               .
     5701             end.
     5702           end.
     5703           put stream text_out unformatted
     5704             ":" skip
     5705           .
     5706           if Make-Excel then  put   stream ForExcel unformatted
     5707             skip
     5708           .
     5709           if last-of( gds-line.shift-num )
     5710           then do:
     5711             put stream text_out unformatted
     5712               Under-Line skip
     5713             .
     5714           end.
     5715         end.
     5716       end.
     5717       for each gds-ptrl no-lock where
     5718                gds-ptrl.obj-type  = tt_object.obj-type and
     5719                gds-ptrl.obj-code  = tt_object.obj-code and
     5720                gds-ptrl.is-gas    = no
     5721       break by gds-ptrl.artic
     5722             by gds-ptrl.prod-type
     5723             by gds-ptrl.prod-code
     5724       :
     5725         assign
     5726           j_excel-col = j_excel-col + 1
     5727         .
     5728       end.
     5729       if tt_object.gds-found = yes
     5730       then do:
     5731         page stream text_out .
     5732         if   Make-Excel Then  do:   Output stream ForExcel close.   assign   number-list = number-list + 1   .   os-delete value( v-excel-file + ".":U + string(number-list)).   Output Stream ForExcel to value( v-excel-file + ".":U + string(number-list ) ) . end.
     5733       end.
     5734       else do:
     5735         if XLS-page-num > 0
     5736         then do:
     5737           if not available SheetF
     5738           then do:
     5739             find first SheetF where
     5740                        SheetF.Sheet-Num = XLS-page-num no-error .
     5741           end.
     5742           if available SheetF
     5743           then do:
     5744             delete SheetF .
     5745           end.
     5746           assign
     5747             XLS-page-num = XLS-page-num - 1
     5748           .
     5749         end.
     5750       end.
     5751     end.
     5752     assign
     5753       gds-gas-found = no
     5754     .
     5755     for each tt_object no-lock
     5756     :
     5757       if tt_object.gas-found <> yes
     5758       then do:
     5759         next .
     5760       end.
     5761       assign
     5762         gds-gas-found = yes
     5763       .
     5764       leave .
     5765     end.
     5766     if gds-gas-found = yes
     5767     then do:
     5768       assign
     5769         j_columns-total = 0
     5770         j_line-order    = 0
     5771       .
     5772       for each tt_object no-lock
     5773       :
     5774         for each gds-line
     5775         :
     5776           delete gds-line .
     5777         end.
     5778         for each gds-cell
     5779         :
     5780           delete gds-cell .
     5781         end.
     5782         assign
     5783           v-green-row = "":U
     5784         .
     5785         if tt_object.gas-found <> yes
     5786         then do:
     5787           next .
     5788         end.
     5789         if tt_object.gas-found = yes
     5790         then do:
     5791           assign
     5792             ReportName       = "":U
     5793             ReportHeader     = "":U
     5794             str1             = "":U
     5795             str2             = "":U
     5796             str3             = "":U
     5797             str4             = "":U
     5798             Header-Line0     = "----------------------------------------------------------------------------------"
     5799             Header-Line1     = ":          :                 :            :" + centre( tt_object.obj-name, 38 ) + ":"
     5800             Header-Line2     = ":          :                 :            :------------:------------:------------:"
     5801             Header-Line3     = ":   Дата   :    Покупатель   :   Итого:   :   Кол-во   :    Цена    :    Сумма   :"
     5802             Header-Line4     = ":          :                 :            :     (л)    :   реализ   :   реализ   :"
     5803             Header-Line5     = ":----------:-----------------:------------:------------:------------:------------:"
     5804             Header-add-Line0 = "":U
     5805             Header-add-Line1 = "":U
     5806             Header-add-Line2 = "":U
     5807             Header-add-Line3 = "":U
     5808             Header-add-Line4 = "":U
     5809             Header-add-Line5 = "":U
     5810           .
     5811           assign
     5812             j_excel-row = 0
     5813             j_excel-col = 0
     5814           .
     5815           assign
     5816             ReportName   = substitute( 'Отчет по розничной реализации нефтепродуктов (газ) на &1'
     5817                                      , tt_object.obj-name
     5818                                      )
     5819             j_length     = 82
     5820             Under-Line   = fill( "-", j_length )
     5821             str1         = substitute( "за период с &1 по &2"
     5822                                      , string( x-Date-Start, "99/99/9999":U )
     5823                                      , string( x-Date-End,   "99/99/9999":U )
     5824                                      )
     5825             ReportHeader = substitute( "Дата печати: &1, время: &2"
     5826                                      , string( t_today, "99.99.9999":U )
     5827                                      , string( j_time,  "HH:MM:SS":U   )
     5828                                      )
     5829             Header-Name  = Centering(  caps( ReportName ), j_length ) +
     5830                            chr(10)                                +
     5831                            Centering(        str1,         j_length ) +
     5832                            chr(10)                                +
     5833                            chr(10)                                +
     5834                            chr(10)                                +
     5835                            ShiftRight(       ReportHeader, j_length )
     5836           .
     5837           assign
     5838             j_line-order = j_line-order + 100
     5839           .
     5840           for each bf_shift-obj no-lock where
     5841                    bf_shift-obj.obj-type    = tt_object.obj-type and
     5842                    bf_shift-obj.obj-code    = tt_object.obj-code and
     5843                    bf_shift-obj.status_     = 'зкр':U      and
     5844                    bf_shift-obj.fact-order >= fact-order_from    and
     5845                    bf_shift-obj.fact-order <= fact-order_till
     5846           break by bf_shift-obj.shift-date
     5847                 by bf_shift-obj.shift-num
     5848           :
     5849             if first-of( bf_shift-obj.shift-num )
     5850             then do:
     5851               for each treal-2
     5852               :
     5853                 delete treal-2 .
     5854               end.
     5855               run rep/r-shftch.p
     5856                 ( input bf_shift-obj.obj-type
     5857                 , input bf_shift-obj.obj-code
     5858                 , input bf_shift-obj.shift-date
     5859                 , input bf_shift-obj.shift-num
     5860                 , input bf_shift-obj.shift-date
     5861                 , input bf_shift-obj.shift-num
     5862                 , input 1110
     5863                 , input yes
     5864                 , input yes
     5865                 , input yes
     5866                 , input no
     5867                 , input no
     5868                 , input no
     5869                 ) no-error .
     5870               if error-status :error
     5871               then do:
     5872                 message return-value view-as alert-box .
     5873                 return error .
     5874               end.
     5875             end.
     5876             assign
     5877               j_excel-row   = 0
     5878               j_start-order = j_line-order
     5879             .
     5880             for each treal-2 no-lock where
     5881                      treal-2.is-pay    <> ? and
     5882                      treal-2.curr-code >= 0
     5883             :
     5884               find first gds-ptrl no-lock where
     5885                          gds-ptrl.obj-type = tt_object.obj-type and
     5886                          gds-ptrl.obj-code = tt_object.obj-code and
     5887                          gds-ptrl.is-gas   = yes                and
     5888                          gds-ptrl.gds-code = treal-2.gds-code   no-error .
     5889               if not available gds-ptrl
     5890               then do:
     5891                 next .
     5892               end.
     5893               assign
     5894                 j_excel-row = j_excel-row + 1
     5895               .
     5896               find first gds-line where
     5897                          gds-line.pay-code   = treal-2.cpay-code       and
     5898                          gds-line.shift-date = bf_shift-obj.shift-date and
     5899                          gds-line.shift-num  = bf_shift-obj.shift-num  and
     5900                          gds-line.is-gas     = gds-ptrl.is-gas         no-error .
     5901               if not available gds-line
     5902               then do:
     5903                 assign
     5904                   j_line-order = j_line-order + 10
     5905                 .
     5906                 find first ub.cash-pay no-lock where
     5907                            ub.cash-pay.cdpay-code = treal-2.cpay-code and
     5908                            ub.cash-pay.curr-code  = treal-2.curr-code no-error .
     5909                 create gds-line .
     5910                 assign
     5911                   gds-line.line-order = j_line-order
     5912                   gds-line.shift-date = bf_shift-obj.shift-date
     5913                   gds-line.shift-num  = bf_shift-obj.shift-num
     5914                   gds-line.shift-name = bf_shift-obj.shift-name
     5915                   gds-line.pay-code   = treal-2.cpay-code
     5916                   gds-line.out-name   = treal-2.out-name
     5917                   gds-line.pay-name   = ( if available ub.cash-pay then ub.cash-pay.obj-name else treal-2.out-name )
     5918                   gds-line.is-cash    = ( if available ub.cash-pay then ub.cash-pay.is-cash  else no )
     5919                   gds-line.is-gas     = gds-ptrl.is-gas
     5920                   gds-line.col-count  = j_columns-total
     5921                 .
     5922                 if gds-line.is-cash = no and
     5923                    ( available ub.cash-pay )
     5924                 then do:
     5925                   find first tt_obj-pay no-lock where
     5926                              tt_obj-pay.obj-type = bf_shift-obj.obj-type and
     5927                              tt_obj-pay.obj-code = bf_shift-obj.obj-code and
     5928                              tt_obj-pay.pay-name = gds-line.pay-name     no-error .
     5929                   if not available tt_obj-pay
     5930                   then do:
     5931                     create tt_obj-pay .
     5932                     assign
     5933                       tt_obj-pay.obj-type = bf_shift-obj.obj-type
     5934                       tt_obj-pay.obj-code = bf_shift-obj.obj-code
     5935                       tt_obj-pay.pay-name = gds-line.pay-name
     5936                       tt_obj-pay.pay-num  = 0
     5937                       tt_obj-pay.xls-col  = 0
     5938                     .
     5939                   end.
     5940                 end.
     5941               end.
     5942               assign
     5943                 gds-line.all-qnty = gds-line.all-qnty + treal-2.qnty1
     5944                 gds-line.all-sum  = gds-line.all-sum  + ( if gds-line.is-cash = yes then treal-2.netto else 0.00 )
     5945               .
     5946               find first gds-cell where
     5947                          gds-cell.shift-date = bf_shift-obj.shift-date and
     5948                          gds-cell.shift-num  = bf_shift-obj.shift-num  and
     5949                          gds-cell.pay-code   = treal-2.cpay-code       and
     5950                          gds-cell.gds-code   = treal-2.gds-code        no-error .
     5951               if not available gds-cell
     5952               then do:
     5953                 create gds-cell .
     5954                 assign
     5955                   gds-cell.line-order = gds-line.line-order
     5956                   gds-cell.shift-date = gds-line.shift-date
     5957                   gds-cell.shift-num  = gds-line.shift-num
     5958                   gds-cell.pay-code   = gds-line.pay-code
     5959                   gds-cell.is-cash    = gds-line.is-cash
