     3244   procedure get-full-path-RepViewer:
     3245       define output parameter p-fill-path-RepView as character no-undo.
     3246       if search("exe\ReportViewer\reportviewer.exe") <> ? then
     3247       do:
     3248           p-fill-path-RepView = search("exe\ReportViewer\reportviewer.exe").
     3249       end.
     3250       else
     3251       do:
     3252           message "Не найдена программа просмотра отчёта!" view-as alert-box error.
     3253       end.
     3254   end procedure.
     3255   procedure define-full-path-Report:
     3256       define input parameter p-rep-num as integer no-undo.
     3257       define output parameter p-file-name-rep-htm as character no-undo.
     3258       p-file-name-rep-htm = session:temp-directory + "rpt" + string(p-rep-num) + ".html".
     3259   end procedure.
     3260   procedure search-full-path-Report:
     3261       define input parameter p-file-name as character no-undo.
     3262       if search(p-file-name) = ? then
     3263           do:
     3264               message "Не найден файл отчёта: " p-file-name view-as alert-box error.
     3265           end.
     3266       else
     3267           do:
     3268               p-file-name = search(p-file-name).
     3269           end.
     3270   end procedure.
     3271   procedure Report-Viewer:
     3272       define input parameter p-full-path-RepView as character no-undo.
     3273       define input parameter p-file-name-rep-htm as character no-undo.
     3274   os-command no-wait value(p-full-path-RepView + " true " + search(p-file-name-rep-htm)).
     3275   end procedure.
     3276   procedure create-file:
     3277       define input parameter p-file-name as character no-undo.
     3278       output to value(string(p-file-name)).
     3279       output close.
     3280   end procedure.
     3281   procedure tt-print-line:
     3282       define input parameter p-obj-type as character no-undo.
     3283       define input parameter p-obj-code as integer no-undo.
     3284       define input parameter p-d-card as character no-undo.
     3285       define input parameter p-upper-code like ub.gds-grp.upper-code no-undo.
     3286       define input parameter p-print-lvl as integer no-undo.
     3287       define variable v-display as character no-undo.
     3288       define buffer buf3_dcards for dcards.
     3289       for each buf3_dcards where
     3290                buf3_dcards.upper-code = p-upper-code and
     3291                buf3_dcards.obj-type = p-obj-type and
     3292                buf3_dcards.obj-code = p-obj-code and
     3293                buf3_dcards.d-card = p-d-card
     3294       no-lock
     3295       :
     3296           if p-print-lvl < 3 then
     3297           do:
     3298               v-display = "yes".
     3299           end.
     3300           else
     3301           do:
     3302               v-display = "none".
     3303           end.
     3304           do:
     3305               if buf3_dcards.grp-lvl <> 0 then
     3306               do:
     3307                   put stream OutStr-html unformatted
     3308                       '       <tr level="' + string(p-print-lvl) + '">' skip
     3309                       '         <td style="display: ' + v-display + '; text-align: left; height: 20px; padding-left: ' + string((p-print-lvl - 0) * 10) + 'px; font-weight: bold">' + string(fill(" ", ((p-print-lvl - 1 ) * 4))) + buf3_dcards.artic + '</td>' skip
     3310                       '         <td style="display: ' + v-display + '; text-align: left; font-weight: bold">' + buf3_dcards.gds-name + '</td>' skip
     3311                       '         <td num="0" style="display: ' + v-display + '; text-align: right; font-weight: bold">' + (if buf3_dcards.counter = 0 then "" else (string(if buf3_dcards.counter <> ? then string (buf3_dcards.counter) else "?"))) + '</td>' skip
     3312                       '         <td num="0.00" style="display: ' + v-display + '; text-align: right; font-weight: bold">' + if buf3_dcards.sum <> ? then fnc-convert-dot-to-colon(buf3_dcards.sum, v-accur-13) + '</td>' else "?" + '</td>' skip
     3313                       '         <td num="0.00" style="display: ' + v-display + '; text-align: right; font-weight: bold">' + if buf3_dcards.discount <> ? then fnc-convert-dot-to-colon(buf3_dcards.discount, v-accur-13) + '</td>' else "?" + '</td>' skip
     3314                       '         <td num="0.00" style="display: ' + v-display + '; text-align: right; font-weight: bold">' + if buf3_dcards.sum-withdisc <> ? then fnc-convert-dot-to-colon(buf3_dcards.sum-withdisc, v-accur-13) + '</td>' else "?" + '</td>' skip
     3315                       '       </tr>' skip
     3316                   .
     3317               end.
     3318               else
     3319               do:
     3320                   put stream OutStr-html unformatted
     3321                       '       <tr level="' + string(p-print-lvl) + '">' skip
     3322                       '         <td style="display: ' + v-display + '; text-align: left; height: 20px; padding-left: ' + string((p-print-lvl - 0) * 10) + 'px">' + string(fill(" ", ((p-print-lvl - 1 ) * 4))) + buf3_dcards.artic + '</td>' skip
     3323                       '         <td style="display: ' + v-display + '; text-align: left">' + buf3_dcards.gds-name + '</td>' skip
     3324                       '         <td num="0" style="display: ' + v-display + '; text-align: right">' + (if buf3_dcards.counter = 0 then "" else (string(if buf3_dcards.counter <> ? then string (buf3_dcards.counter) else "?"))) + '</td>' skip
     3325                       '         <td num="0.00" style="display: ' + v-display + '; text-align: right">' + if buf3_dcards.sum <> ? then fnc-convert-dot-to-colon(buf3_dcards.sum, v-accur-13) + '</td>' else "?" + '</td>' skip
     3326                       '         <td num="0.00" style="display: ' + v-display + '; text-align: right">' + if buf3_dcards.discount <> ? then fnc-convert-dot-to-colon(buf3_dcards.discount, v-accur-13) + '</td>' else "?" + '</td>' skip
     3327                       '         <td num="0.00" style="display: ' + v-display + '; text-align: right">' + if buf3_dcards.sum-withdisc <> ? then fnc-convert-dot-to-colon(buf3_dcards.sum-withdisc, v-accur-13) + '</td>' else "?" + '</td>' skip
     3328                       '       </tr>' skip
     3329                   .
     3330               end.
     3331           end.
     3332           if buf3_dcards.grp-lvl <> 0 then run tt-print-line (input p-obj-type, input p-obj-code, input p-d-card, input buf3_dcards.grp-code, input p-print-lvl + 1).
     3333       end.
     3334   end procedure.
     3335   procedure transform-tt-level:
     3336       define input parameter p-obj-type as character no-undo.
     3337       define input parameter p-obj-code as integer no-undo.
     3338       define input parameter p-d-card like ub.dis-card.d-card no-undo.
     3339       define variable v-doc-qnty as decimal no-undo.
     3340       define variable v-sum-withoutdisc as decimal no-undo.
     3341       define variable v-sum-withdisc as decimal no-undo.
     3342       define variable v-discount as decimal no-undo.
     3343       define variable v-gds-grp-name as character no-undo.
     3344       define variable v-cur-lvl as integer no-undo.
     3345       define variable v-upper-code as integer initial ? no-undo.
     3346       define variable v-first-of as logical no-undo.
     3347       define variable v-last-of as logical no-undo.
     3348       define variable v-cur-recid as recid no-undo.
     3349       define buffer buf1_dcards for dcards.
     3350       define buffer buf2_dcards for dcards.
     3351       define buffer bufobj_dcards for dcards.
     3352       define buffer bufobj2_dcards for dcards.
     3353       do while v-upper-code <> 0
     3354       :
     3355           v-upper-code = 0.
     3356           v-gds-grp-name = ''.
     3357           for each buf1_dcards where
     3358                    buf1_dcards.grp-lvl  = v-cur-lvl and
     3359                    buf1_dcards.obj-type = p-obj-type and
     3360                    buf1_dcards.obj-code = p-obj-code and
     3361                    buf1_dcards.d-card   = p-d-card
     3362           break
     3363               by buf1_dcards.grp-code
     3364           :
     3365               if first-of(buf1_dcards.grp-code) then
     3366               do:
     3367                   assign
     3368                       v-doc-qnty = 0
     3369                       v-sum-withoutdisc = 0
     3370                       v-sum-withdisc = 0
     3371                       v-discount = 0
     3372                   .
     3373                   find first ub.gds-grp where
     3374                              ub.gds-grp.node-code = buf1_dcards.grp-code
     3375                   no-lock no-error.
     3376                   if available ub.gds-grp then
     3377                   do:
     3378                       assign
     3379                           v-upper-code = ub.gds-grp.upper-code
     3380                           v-gds-grp-name = ub.gds-grp.node-name
     3381                       .
     3382                   end.
     3383               end.
     3384               buf1_dcards.upper-code = if buf1_dcards.grp-lvl = 0 then buf1_dcards.grp-code else v-upper-code.
     3385               if buf1_dcards.grp-lvl <> 0 then
     3386               do:
     3387                   assign
     3388                       buf1_dcards.gds-name = v-gds-grp-name
     3389                       buf1_dcards.artic = string(buf1_dcards.grp-code)
     3390                   .
     3391               end.
     3392               assign
     3393                   v-doc-qnty = v-doc-qnty + buf1_dcards.doc-qnty
     3394                   v-sum-withoutdisc = v-sum-withoutdisc + buf1_dcards.sum
     3395                   v-sum-withdisc = v-sum-withdisc + buf1_dcards.sum-withdisc
     3396                   v-discount = v-discount + buf1_dcards.discount
     3397               .
     3398               if last-of (buf1_dcards.grp-code) then
     3399               do:
     3400                   create buf2_dcards.
     3401                   assign
     3402                       buf2_dcards.grp-code =
     3403                           (if buf1_dcards.grp-lvl = 0 then buf1_dcards.grp-code
     3404                            else v-upper-code)
     3405                       buf2_dcards.doc-qnty = v-doc-qnty
     3406                       buf2_dcards.sum = v-sum-withoutdisc
     3407                       buf2_dcards.sum-withdisc = v-sum-withdisc
     3408                       buf2_dcards.discount = v-discount
     3409                       buf2_dcards.grp-lvl = buf1_dcards.grp-lvl + 1
     3410                       buf2_dcards.obj-type = p-obj-type
     3411                       buf2_dcards.obj-code = p-obj-code
     3412                       buf2_dcards.d-card = p-d-card
     3413                   .
     3414               end.
     3415           end.
     3416           v-cur-lvl = v-cur-lvl + 1.
     3417       end.
     3418   end procedure.
     3419   procedure my-watch-table:
     3420       define variable v-full-file-name as character no-undo.
     3421       define variable v-message as character no-undo.
     3422       define variable v-table-handle as handle no-undo.
     3423       define variable v-cnt-field as integer no-undo.
     3424       define variable v-list-field-name as character no-undo.
     3425       define variable v-list-field-label as character no-undo.
     3426       define variable v-list-field-type as character no-undo.
     3427       define buffer dcards for dcards.
     3428       v-table-handle = buffer dcards:handle.
     3429       v-cnt-field = v-table-handle:num-fields.
     3430       do v-ii = 1 to v-cnt-field:
     3431           v-list-field-name =
     3432               (if v-list-field-name <> "" then
     3433                  v-list-field-name + "$" + v-table-handle:buffer-field(v-ii):name
     3434               else
     3435                   v-table-handle:buffer-field(v-ii):name).
     3436           v-list-field-label =
     3437               (if v-list-field-label <> "" then
     3438                  v-list-field-label + "$" + v-table-handle:buffer-field(v-ii):label
     3439               else
     3440                   v-table-handle:buffer-field(v-ii):label).
     3441           v-list-field-type =
     3442               (if v-list-field-type <> "" then
     3443                  v-list-field-type + "$" + v-table-handle:buffer-field(v-ii):data-type
     3444               else
     3445                   v-table-handle:buffer-field(v-ii):data-type).
     3446       end.
     3447       v-full-file-name = "C:\work15_0\my-watch-dcards.txt".
     3448       if search(v-full-file-name) = ? then
     3449           do:
     3450               message "Не найден файл отчёта: " v-full-file-name view-as alert-box error.
     3451           end.
     3452       output stream MyWatch-strm to value(v-full-file-name)   convert target "utf-8".
     3453           put stream MyWatch-strm unformatted
     3454               today format "99.99.9999" " " string(time, "HH:MM") " " "Исследуемая таблица: " "dcards" "." skip
     3455               v-list-field-label skip
     3456               v-list-field-name skip
     3457               v-list-field-type skip
     3458           .
     3459           if not can-find(first dcards) then
     3460           do:
     3461               v-message = "Исследуемая таблица dcards пуста!".
     3462               put stream MyWatch-strm unformatted
     3463                   v-message
     3464               .
     3465               message "My-watch-table: " v-message view-as alert-box information.
     3466           end.
     3467               for each  dcards no-lock:
     3468                   export stream MyWatch-strm delimiter "$"  dcards.
     3469               end.
     3470       output stream MyWatch-strm close.
     3471   end procedure.
     3472   procedure watch_dc-list:
     3473       define variable v-full-file-name as character no-undo.
     3474       define variable v-message as character no-undo.
     3475       define variable v-table-handle as handle no-undo.
     3476       define variable v-cnt-field as integer no-undo.
     3477       define variable v-list-field-name as character no-undo.
     3478       define variable v-list-field-label as character no-undo.
     3479       define variable v-list-field-type as character no-undo.
     3480       define buffer dc-list for dc-list.
     3481       do:
     3482           v-table-handle = buffer dc-list:handle.
     3483           v-cnt-field = v-table-handle:num-fields.
     3484           do v-ii = 1 to v-cnt-field:
     3485               v-list-field-name =
     3486                   (if v-list-field-name <> "" then
     3487                      v-list-field-name + "$" + v-table-handle:buffer-field(v-ii):name
     3488                   else
     3489                       v-table-handle:buffer-field(v-ii):name).
     3490               v-list-field-label =
     3491                   (if v-list-field-label <> "" then
     3492                      v-list-field-label + "$" + v-table-handle:buffer-field(v-ii):label
     3493                   else
     3494                       v-table-handle:buffer-field(v-ii):label).
     3495               v-list-field-type =
     3496                   (if v-list-field-type <> "" then
     3497                      v-list-field-type + "$" + v-table-handle:buffer-field(v-ii):data-type
     3498                   else
     3499                       v-table-handle:buffer-field(v-ii):data-type).
     3500           end.
     3501       end.
     3502       v-full-file-name = "C:\work15_0\my-watch_dc-list.txt".
     3503       if search(v-full-file-name) = ? then
     3504           do:
     3505               message "Не найден файл отчёта: " v-full-file-name view-as alert-box error.
     3506           end.
     3507       output stream MyWatch-strm to value(v-full-file-name)   convert target "utf-8".
     3508           put stream MyWatch-strm unformatted
     3509               today format "99.99.9999" " " string(time, "HH:MM") " " "Исследуемая таблица: " "dc-list" "." skip
     3510               v-list-field-label skip
     3511               v-list-field-name skip
     3512               v-list-field-type skip
     3513           .
     3514           if not can-find(first dc-list) then
     3515           do:
     3516               v-message = "Исследуемая таблица dc-list пуста!".
     3517               put stream MyWatch-strm unformatted
     3518                   v-message
     3519               .
     3520               message "My-watch-table: " v-message view-as alert-box information.
     3521           end.
     3522               for each  dc-list no-lock:
     3523                   export stream MyWatch-strm delimiter "$"  dc-list.
     3524               end.
     3525       output stream MyWatch-strm close.
     3526   end procedure.
     3527   procedure old-code:
     3528       for each dcards where (UpLevel = 0 or dcards.sum >= UpLevel)
     3529       ,
     3530       first dis-card no-lock where dis-card.d-card = dcards.d-card
     3531       break
     3532           by dcards.cli-type-code
     3533           by dcards.card-num-chr
     3534           by dcards.d-card
     3535           by dcards.chk-date
     3536       :
     3537           if (not t-legacy and not t-subsid)
     3538               or first-of (dcards.cli-type-code) then
     3539           do:
     3540               find first buf2_clients no-lock where
     3541                          buf2_clients.obj-type = dis-card.cli-type
     3542                      and buf2_clients.obj-code = dis-card.cli-code no-error
     3543               .
     3544               if available buf2_clients then
     3545               do:
     3546                   assign
     3547                       v-cli-name = buf2_clients.obj-name
     3548                       v-cli-type-code = dis-card.cli-type + string(dis-card.cli-code)
     3549                   .
     3550               end.
     3551               else
     3552               do:
     3553                   assign
     3554                       v-cli-name = dis-card.cli-type + string(dis-card.cli-code)
     3555                       v-cli-type-code = dis-card.cli-type + string(dis-card.cli-code)
     3556                   .
     3557               end.
     3558           end.
     3559           if first-of (dcards.cli-type-code) then
     3560           do:
     3561               assign
     3562                   accum-counter-cli       = 0
     3563                   accum-qnty-cli          = 0
     3564                   accum-sum-cli           = 0
     3565                   accum-discount-cli      = 0
     3566                   accum-netto-cli         = 0
     3567                   only-one-card-per-cli   = 0
     3568               .
     3569           end.
     3570           if first-of(dcards.card-num-chr) then
     3571           do:
     3572               assign
     3573                   accum-counter-leg       = 0
     3574                   accum-qnty-leg          = 0
     3575                   accum-sum-leg           = 0
     3576                   accum-discount-leg      = 0
     3577                   accum-netto-leg         = 0
     3578                   only-one-card-per-leg   = 0
     3579               .
     3580           end.
     3581           if first-of(dcards.d-card) then
     3582           do:
     3583               assign
     3584                   accum-counter-crd       = 0
     3585                   accum-qnty-crd          = 0
     3586                   accum-sum-crd           = 0
     3587                   accum-discount-crd      = 0
     3588                   accum-netto-crd         = 0
     3589               .
     3590           end.
     3591           assign
     3592               accum-counter         = accum-counter      + dcards.counter
     3593               accum-qnty            = accum-qnty         + dcards.doc-qnty
     3594               accum-sum             = accum-sum          + dcards.sum
     3595               accum-discount        = accum-discount     + dcards.discount
     3596               accum-netto           = accum-netto        + dcards.sum - dcards.discount
     3597               accum-counter-cli     = accum-counter-cli  + dcards.counter
     3598               accum-qnty-cli        = accum-qnty-cli     + dcards.doc-qnty
     3599               accum-sum-cli         = accum-sum-cli      + dcards.sum
     3600               accum-discount-cli    = accum-discount-cli + dcards.discount
     3601               accum-netto-cli       = accum-netto-cli    + dcards.sum - dcards.discount
     3602               accum-counter-leg     = accum-counter-leg  + dcards.counter
     3603               accum-qnty-leg        = accum-qnty-leg     + dcards.doc-qnty
     3604               accum-sum-leg         = accum-sum-leg      + dcards.sum
     3605               accum-discount-leg    = accum-discount-leg + dcards.discount
     3606               accum-netto-leg       = accum-netto-leg    + dcards.sum - dcards.discount
     3607               accum-counter-crd     = accum-counter-crd  + dcards.counter
     3608               accum-qnty-crd        = accum-qnty-crd     + dcards.doc-qnty
     3609               accum-sum-crd         = accum-sum-crd      + dcards.sum
     3610               accum-discount-crd    = accum-discount-crd + dcards.discount
     3611               accum-netto-crd       = accum-netto-crd    + dcards.sum - dcards.discount
     3612           .
     3613           if t-legacy or t-subsid then
     3614           do:
     3615               if only-one-card-per-leg = 0 then
     3616               do:
     3617                   only-one-card-per-leg = 1.
     3618               end.
     3619               else
     3620               do:
     3621                   only-one-card-per-leg = 2.
     3622               end.
     3623               if first-of(dcards.card-num-chr) then
     3624               do:
     3625                   assign
     3626                       v-show-d-card = dcards.card-num-chr
     3627                   .
     3628               end.
     3629           end.
     3630           if first-of(dcards.d-card) then
     3631           do:
     3632               if first(dcards.d-card) then
     3633               do:
     3634                   down stream PrnLibStream 1 with frame X123.
     3635               end.
     3636               only-one-card-per-cli = only-one-card-per-cli + 1.
     3637               for-d-pcnt = get-d-pcnt(
     3638                                        buffer dis-card
     3639                                       ,input v-cntxt-host-code-obj
     3640                                       ,input v-cntxt-obj-type
     3641                                       ,input v-cntxt-obj-code
     3642                                       ,input 'def-pcnt':U
     3643                                       ,output loc-d-pcnt
     3644                                       ).
     3645               put stream PrnLibStream space(10)
     3646                   substitute ("№ карты: &1 &2 / &3 (&4) / Процент скидки: &5"
     3647                               ,(if t-legacy or t-subsid then ("~{" + v-show-d-card + "~}") else "":U)
     3648                               ,trim(dcards.d-card)
     3649                               ,trim(v-cli-name)
     3650                               ,(if t-legacy or t-subsid then dcards.cli-type-code else v-cli-type-code)
     3651                               ,for-d-pcnt) format "x(100)" skip
     3652                   .
     3653               underline stream PrnLibStream
     3654                   dcards.chk-date
     3655                   dcards.artic
     3656                   buf3_clients.obj-name
     3657                   goods.gds-name
     3658                   dcards.b-code
     3659                   dcards.sale-price
     3660                   dcards.doc-qnty
     3661                   dcards.sum
     3662                   dcards.discount
     3663                   v-for-netto
     3664               with frame X123.
     3665               do:
     3666                   if dcards.b-code <> 0 then
     3667                   do:
     3668                       find first buf3_clients where buf3_clients.obj-type = dcards.prod-type and
     3669                                  buf3_clients.obj-code = dcards.prod-code no-lock
     3670                       .
     3671                       find first ub.goods where
     3672                                  ub.goods.artic = dcards.artic and
     3673                                  ub.goods.prod-type = dcards.prod-type and
     3674                                  ub.goods.prod-code = dcards.prod-code no-lock
     3675                       .
     3676                       find first ub.gds-prt where
     3677                                  ub.gds-prt.node-code = dcards.node-code no-lock no-error
     3678                       .
     3679                       if available ub.gds-prt and
     3680                           not ub.gds-prt.node-name = '_Пустая шкала':U then
     3681                       do:
     3682                           for-name = string(ub.goods.gds-name, "X(25)") + "\" + ub.gds-prt.node-name.
     3683                       end.
     3684                       else
     3685                       do:
     3686                           for-name = ub.goods.gds-name.
     3687                       end.
     3688                       namebuf1 = breakstr(for-name, 25, input-output namebuf1, input-output namebuf2).
     3689                       display stream PrnLibStream
     3690                           sym1
     3691                           dcards.chk-date
     3692                           dcards.artic
     3693                           dcards.b-code
     3694                           buf3_clients.obj-name
     3695                           namebuf1 @ ub.goods.gds-name
     3696                           dcards.sale-price
     3697                           dcards.doc-qnty
     3698                           dcards.sum
     3699                           dcards.discount
     3700                           (dcards.sum - dcards.discount) @ v-for-netto
     3701                           sym2
     3702                       with frame X123.
     3703                       down stream PrnLibStream 1 with frame X123.
     3704                       if namebuf2 <> "" then
     3705                       do:
     3706                           display stream PrnLibStream
     3707                               sym1
     3708                                namebuf2 @ goods.gds-name
     3709                               sym2
     3710                               with frame X123
     3711                           .
     3712                           down stream PrnLibStream 1 with frame X123.
     3713                       end.
     3714                   end.
     3715                   else
     3716                   do:
     3717                       if dcards.artic > "" then
     3718                       do:
     3719                           display stream PrnLibStream
     3720                               sym1
     3721                               dcards.chk-date
     3722                               dcards.artic
     3723                               (if dcards.artic = 'СТ' then "Сопутствующие товары" else '') @ ub.goods.gds-name
     3724                               dcards.sum
     3725                               dcards.discount
     3726                               (dcards.sum - dcards.discount) @ v-for-netto
     3727                               sym2
     3728                           with frame X123.
     3729                           down stream PrnLibStream 1 with frame X123.
     3730                       end.
     3731                   end.
     3732               end.
     3733               do:
     3734               end.
     3735           end.
     3736           if last-of(dcards.d-card) then
     3737           do:
     3738               do:
     3739                   underline stream PrnLibStream
     3740                       dcards.chk-date
     3741                       dcards.artic
     3742                       dcards.b-code
     3743                       buf3_clients.obj-name
     3744                       goods.gds-name
     3745                       dcards.sale-price
     3746                       dcards.doc-qnty
     3747                       dcards.sum
     3748                       dcards.discount
     3749                       v-for-netto
     3750                       with frame X123
     3751                   .
     3752               end.
     3753               display stream PrnLibStream
     3754                   sym1
     3755                   "Итого" @ dcards.chk-date
     3756                   "по карте" @ dcards.artic
     3757                   ("чеков: " + string(accum-counter-crd)) @ buf3_clients.obj-name
     3758                   dcards.d-card @ goods.gds-name
     3759                   ACCUM-sum-crd @ dcards.sum
     3760                   ACCUM-discount-crd @ dcards.discount
     3761                   ACCUM-netto-crd @ v-for-netto
     3762                   sym2
     3763               with frame X123.
     3764               do:
     3765                   display stream PrnLibStream
     3766                       (ACCUM-qnty-crd) @ dcards.doc-qnty
     3767                   with frame X123.
     3768               end.
     3769               underline stream PrnLibStream
     3770                   dcards.chk-date
     3771                   dcards.artic
     3772                   dcards.b-code
     3773                   buf3_clients.obj-name
     3774                   goods.gds-name
     3775                   dcards.sale-price
     3776                   dcards.doc-qnty
     3777                   dcards.sum
     3778                   dcards.discount
     3779                   v-for-netto
     3780               with frame X123.
     3781           end.
     3782           if t-legacy or t-subsid then
     3783           do:
     3784               if last-of(dcards.card-num-chr) then
     3785               do:
     3786               end.
     3787               if last-of(dcards.card-num-chr) and only-one-card-per-leg = 2 then
     3788               do:
     3789                   do:
     3790                       underline stream PrnLibStream
     3791                           dcards.chk-date
     3792                           dcards.artic
     3793                           dcards.b-code
     3794                           buf3_clients.obj-name
     3795                           goods.gds-name
     3796                           dcards.sale-price
     3797                           dcards.doc-qnty
     3798                           dcards.sum
     3799                           dcards.discount
     3800                           v-for-netto
     3801                       with frame X123.
     3802                   end.
     3803                   display stream PrnLibStream
     3804                       sym1
     3805                       "Итого" @ dcards.chk-date
     3806                       substitute("~{&1~}", substring(v-show-d-card, 1, 14)) @  dcards.artic
     3807                       ("чеков: " + string(ACCUM-counter-leg)) @ buf3_clients.obj-name
     3808                       (trim( v-cli-name ) +
     3809                       " (" +
     3810                       (if t-legacy or t-subsid then dcards.cli-type-code else v-cli-type-code) +
     3811                       " )" ) @ goods.gds-name
     3812                       ACCUM-sum-leg  @ dcards.sum
     3813                       ACCUM-discount-leg @ dcards.discount
     3814                       ACCUM-netto-leg @ v-for-netto
     3815                       sym2
     3816                   with frame X123.
     3817                   do:
     3818                       display stream PrnLibStream
     3819                           (ACCUM-qnty-leg) @ dcards.doc-qnty
     3820                       with frame X123.
     3821                   end.
     3822                   underline stream PrnLibStream
     3823                       dcards.chk-date
     3824                       dcards.artic
     3825                       dcards.b-code
     3826                       buf3_clients.obj-name
     3827                       goods.gds-name
     3828                       dcards.sale-price
     3829                       dcards.doc-qnty
     3830                       dcards.sum
     3831                       dcards.discount
     3832                       v-for-netto
     3833                   with frame X123.
     3834               end.
     3835           end.
     3836           if last-of(dcards.cli-type-code) and only-one-card-per-cli > 1 then
     3837           do:
     3838               do:
     3839                   underline stream PrnLibStream
     3840                       dcards.chk-date
     3841                       dcards.artic
     3842                       dcards.b-code
     3843                       buf3_clients.obj-name
     3844                       goods.gds-name
     3845                       dcards.sale-price
     3846                       dcards.doc-qnty
     3847                       dcards.sum
     3848                       dcards.discount
     3849                       v-for-netto
     3850                   with frame X123.
     3851               end.
     3852               display stream PrnLibStream
     3853                   sym1
     3854                   "Итого" @ dcards.chk-date
     3855                   "по клиенту"  @  dcards.artic
     3856                   ("чеков: " + string(ACCUM-counter-cli)) @ buf3_clients.obj-name
     3857                   (trim(v-cli-name) +
     3858                   " (" +
     3859                   (if t-legacy or t-subsid then dcards.cli-type-code else v-cli-type-code) +
     3860                   " )") @ goods.gds-name
     3861                   ACCUM-sum-cli  @ dcards.sum
     3862                   ACCUM-discount-cli @ dcards.discount
     3863                   ACCUM-netto-cli @ v-for-netto
     3864                   sym2
     3865               with frame X123.
     3866               do:
     3867                   display stream PrnLibStream
     3868                       (ACCUM-qnty-cli) @ dcards.doc-qnty
     3869                   with frame X123.
     3870               end.
     3871               underline stream PrnLibStream
     3872                   dcards.chk-date
     3873                   dcards.artic
     3874                   dcards.b-code
     3875                   buf3_clients.obj-name
     3876                   goods.gds-name
     3877                   dcards.sale-price
     3878                   dcards.doc-qnty
     3879                   dcards.sum
     3880                   dcards.discount
     3881                   v-for-netto
     3882               with frame X123.
     3883           end.
     3884           if last(dcards.d-card) and FixDCard = "" then
     3885           do:
     3886               display stream PrnLibStream
     3887                   sym1
     3888                   "Итого" @ dcards.chk-date
     3889                   "по ВСЕМ" @ dcards.artic
     3890                   ("чеков: " + string(ACCUM-counter)) @ buf3_clients.obj-name
     3891                   ACCUM-sum @ dcards.sum
     3892                   ACCUM-discount @ dcards.discount
     3893                   ACCUM-netto @ v-for-netto
     3894                   sym2
     3895               with frame X123.
     3896               do:
     3897                   display stream PrnLibStream
     3898                       (ACCUM-qnty) @ dcards.doc-qnty
     3899                   with frame X123.
     3900               end.
     3901               underline stream PrnLibStream
     3902                   dcards.chk-date
     3903                   dcards.artic
     3904                   dcards.b-code
     3905                   buf3_clients.obj-name
     3906                   goods.gds-name
     3907                   dcards.sale-price
     3908                   dcards.doc-qnty
     3909                   dcards.sum
     3910                   dcards.discount
     3911                   v-for-netto
     3912               with frame X123.
     3913           end.
     3914       end.
     3915   end procedure.
     3916   procedure new-code:
     3917       for each dcards where (UpLevel = 0 or dcards.sum >= UpLevel)
     3918       ,
     3919       first dis-card no-lock where dis-card.d-card = dcards.d-card
     3920       break by dcards.cli-type-code
     3921             by dcards.card-num-chr
     3922             by dcards.d-card
     3923             by dcards.chk-date
     3924       :
     3925           if (not t-legacy and not t-subsid)
     3926               or first-of (dcards.cli-type-code) then
     3927           do:
     3928               find first buf2_clients no-lock where
     3929                          buf2_clients.obj-type = dis-card.cli-type
     3930                      and buf2_clients.obj-code = dis-card.cli-code no-error
     3931               .
     3932               if available buf2_clients then
     3933               do:
     3934                   assign
     3935                       v-cli-name = buf2_clients.obj-name
     3936                       v-cli-type-code = dis-card.cli-type + string(dis-card.cli-code)
     3937                   .
     3938               end.
     3939               else
     3940               do:
     3941                   assign
     3942                       v-cli-name = dis-card.cli-type + string(dis-card.cli-code)
     3943                       v-cli-type-code = dis-card.cli-type + string(dis-card.cli-code)
     3944                   .
     3945               end.
     3946           end.
     3947           assign
     3948               accum-counter         = accum-counter      + dcards.counter
     3949               accum-qnty            = accum-qnty         + dcards.doc-qnty
     3950               accum-sum             = accum-sum          + dcards.sum
     3951               accum-discount        = accum-discount     + dcards.discount
     3952               accum-netto           = accum-netto        + dcards.sum - dcards.discount
     3953           .
     3954           if t-legacy or t-subsid then
     3955           do:
     3956               if only-one-card-per-leg = 0 then
     3957               do:
     3958                   only-one-card-per-leg = 1.
     3959               end.
     3960               else
     3961               do:
     3962                   only-one-card-per-leg = 2.
     3963               end.
     3964               if first-of(dcards.card-num-chr) then
     3965               do:
     3966                   assign
     3967                       v-show-d-card = dcards.card-num-chr
     3968                   .
     3969               end.
     3970           end.
     3971           if first-of(dcards.d-card) then
     3972           do:
     3973               if first(dcards.d-card) then
     3974               do:
     3975                   down stream PrnLibStream 1 with frame X123.
     3976               end.
     3977               only-one-card-per-cli = only-one-card-per-cli + 1.
     3978               for-d-pcnt = get-d-pcnt(
     3979                                        buffer dis-card
     3980                                       ,input v-cntxt-host-code-obj
     3981                                       ,input v-cntxt-obj-type
     3982                                       ,input v-cntxt-obj-code
     3983                                       ,input 'def-pcnt':U
     3984                                       ,output loc-d-pcnt
     3985                                       ).
     3986               put stream PrnLibStream space(10)
     3987                   substitute ("№ карты: &1 &2 / &3 (&4) / Процент скидки: &5"
     3988                               ,(if t-legacy or t-subsid then ("~{" + v-show-d-card + "~}") else "":U)
     3989                               ,trim(dcards.d-card)
     3990                               ,trim(v-cli-name)
     3991                               ,(if t-legacy or t-subsid then dcards.cli-type-code else v-cli-type-code)
     3992                               ,for-d-pcnt) format "x(100)" skip
     3993                   .
     3994           end.
     3995       end.
     3996   end.
     3997   function fnc-convert-dot-to-colon returns character
     3998   (input p-data as decimal, input p-accur as character):
     3999       define variable result as character no-undo.
     4000       define variable v-str-result as character no-undo.
     4001       if p-data = ? then
     4002       do:
     4003           v-str-result = "?".
     4004       end.
     4005       else
     4006       do:
     4007           p-data = round(p-data, 2).
     4008           v-str-result = trim(replace(string(p-data, p-accur), ".", ",")).
     4009       end.
     4010       return v-str-result.
     4011   end function.
     4012   function fnc-DD-MM-YYYY returns character
     4013   (input p-dat-date as date):
     4014       define variable result as character no-undo.
     4015       define variable p-str-date as character no-undo.
     4016       p-str-date = replace(string(p-dat-date,'99.99.9999'), "/", ".").
     4017           return p-str-date.
     4018   end function.
