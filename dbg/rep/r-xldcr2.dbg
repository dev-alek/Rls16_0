      582   define  stream PrnLibStream.
      583   procedure prn-lib-prn-file :
      584     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      585     define input parameter p-DIsabledoptions as integer no-undo .
      586     define variable v-report-name as character no-undo .
      587     define variable v-user-action as character no-undo .
      588     define variable v-printed     as logical   no-undo .
      589     define variable v-exist       as logical   no-undo .
      590     do
      591       on error undo, return error
      592       :
      593       run prn-lib-get-report-name  in this-procedure (
      594         input parParentProc
      595         ,output v-report-name
      596         ).
      597   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      598   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      599     (input  v-report-name
      600     ,input  2
      601     ,output v-exist
      602     )  .
      603       if NOT v-exist then
      604       DO:
      605         Message
      606           "Нет заданий на печать ! "
      607           view-as alert-box .
      608         Return  .
      609       End.
      610       run gbl/prnfilen.w
      611         (input  ""
      612         ,input  p-DisabledOptions
      613         ,input  string(v-report-name )
      614         ,input  7
      615         ,output v-user-action
      616         ,output v-printed
      617         ) .
      618       if v-printed then
      619       do:
      620         return "YES" .
      621       end.
      622       else
      623       do:
      624         return "NO" .
      625       end.
      626     end.
      627   end procedure.
      628   procedure prn-lib-open-stream :
      629     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      630     define input parameter p-page-size    as integer no-undo .
      631     define input parameter p-is-stream    as logical no-undo .
      632     define input parameter p-append       as logical no-undo .
      633     define variable v-report-name as character no-undo .
      634     do
      635       on error undo, return error
      636       :
      637       run prn-lib-get-report-name  in this-procedure (
      638         input parParentProc
      639         ,output v-report-name
      640         ).
      641       if p-is-stream then
      642       do:
      643         if p-append then
      644         do:
      645           output stream PrnLibStream to value( v-report-name )
      646             page-size value(p-page-size) append .
      647         end.
      648         if not p-append then
      649         do:
      650           output stream PrnLibStream to value( v-report-name )
      651             page-size value(p-page-size) .
      652         end.
      653       end.
      654       if not p-is-stream then
      655       do:
      656         if p-append then
      657         do:
      658           output to value( v-report-name )
      659             page-size value(p-page-size) append .
      660         end.
      661         if not p-append then
      662         do:
      663           output to value( v-report-name )
      664             page-size value(p-page-size) .
      665         end.
      666       end.
      667     end.
      668   end procedure.
      669   procedure prn-lib-open-exp :
      670     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      671     define input parameter p-is-stream    as logical no-undo .
      672     define input parameter p-is-append    as logical no-undo .
      673     define output parameter p-ReportFileName as char init "report" no-undo.
      674     define output parameter p-process as logical no-undo .
      675     define variable glog as logical no-undo .
      676     do
      677       on error undo, return error
      678       :
      679       SYSTEM-DIALOG GET-FILE p-ReportFileName
      680         TITLE      "Укажите путь"
      681         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      682         ASK-OVERWRITE
      683         CREATE-TEST-FILE
      684         SAVE-AS
      685         USE-FILENAME
      686         DEFAULT-EXTENSION "txt"
      687         UPDATE glog
      688         .
      689       if not glog then  return.
      690       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      691       if p-is-stream then
      692       do:
      693         if p-is-append then
      694         do:
      695           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      696         end.
      697         else
      698         do:
      699           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      700         end.
      701       end.
      702       else
      703       do:
      704         if p-is-append then
      705         do:
      706           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      707         end.
      708         else
      709         do:
      710           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      711         end.
      712       end.
      713       p-process = yes.
      714     end.
      715   end procedure.
      716   procedure prn-lib-get-report-name :
      717     define input parameter parParentProc  as widget-handle no-undo.
      718     define output parameter p-report-name as character no-undo .
      719     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      720   end procedure.
      721   procedure prn-lib-reportviewer-report-name :
      722     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      723     define input parameter p-report-name-html as character no-undo .
      724     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      725   end procedure.
      726   procedure prn-lib-reportviewer :
      727     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      728     define input parameter p-report-name-html as character no-undo .
      729     define input parameter p-param        as character no-undo .
      730     define variable v-excel           as character no-undo init 'TRUE' .
      731     define variable v-value-character as character no-undo .
      732     define variable v-value-integer   as character no-undo .
      733     define variable v-value-date      as date      no-undo .
      734     define variable v-value-decimal   as decimal   no-undo .
      735     define variable rep-excel         as logical   no-undo .
      736     define variable excel-string      as character no-undo .
      737     define variable v-param-type      as character no-undo .
      738     define variable v-tth             as handle    no-undo .
      739     run adm/shattri.p (
      740       input "get":U
      741       ,input  ""
      742       ,input  0
      743       ,input  'report-glob':U
      744       ,input  'rep-excel':U
      745       ,output v-value-character
      746       ,output v-value-date
      747       ,output v-value-decimal
      748       ,output v-value-integer
      749       ,output rep-excel
      750       ,output v-param-type
      751       ,INPUT-OUTPUT table-handle v-tth
      752       )  .
      753     if rep-excel then v-excel = "TRUE" .
      754     else v-excel = "FALSE" .
      755     if p-param eq ""
      756     then
      757        p-param = "EXCEL:" + v-excel.
      758     else
      759        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      760     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      761   end procedure.
      762   function diff-list returns character (
      763     input parfirst-list  as character,
      764     input parsecond-list as character,
      765     input pardelim       as character).
      766     if pardelim = ""
      767     or pardelim = ?
      768     then do:
      769       assign
      770         pardelim = ","
      771       .
      772     end.
      773     def var ind as integer no-undo .
      774     def var v-elem as character no-undo .
      775     def var v-result-list as character no-undo init "".
      776     def var v-num-parfirst-list as integer no-undo .
      777     assign
      778       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      779     .
      780     do ind = 1 to v-num-parfirst-list
      781     :
      782       assign
      783         v-elem = entry(ind, parfirst-list, pardelim)
      784       .
      785       if lookup(v-elem, parsecond-list, pardelim) = 0 then do:
      786         assign
      787           v-result-list = v-result-list
      788                         + (if v-result-list > "" then pardelim else "")
      789                         + v-elem
      790         .
      791       end.
      792     end.
      793     return v-result-list .
      794   end function.
      795   function add-list returns character (
      796    input parfirst-list  as character,
      797    input parsecond-list as character,
      798    input pardelim       as character).
      799     if pardelim = ""
      800     or pardelim = ?
      801     then do:
      802       assign
      803         pardelim = ","
      804       .
      805     end.
      806     def var ind as integer no-undo .
      807     def var v-elem as character no-undo .
      808     def var v-result-list as character no-undo init "".
      809     def var v-num-parfirst-list as integer no-undo .
      810     assign
      811       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      812     .
      813     do ind = 1 to v-num-parfirst-list
      814     :
      815       assign
      816         v-elem = entry(ind, parfirst-list, pardelim)
      817       .
      818       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      819         assign
      820           v-result-list = v-result-list
      821                         + (if v-result-list > "" then pardelim else "")
      822                         + v-elem
      823         .
      824       end.
      825     end.
      826     def var v-num-parsecond-list as integer no-undo .
      827     assign
      828       v-num-parsecond-list = num-entries(parsecond-list, pardelim)
      829     .
      830     do ind = 1 to v-num-parsecond-list
      831     :
      832       assign
      833         v-elem = entry(ind, parsecond-list, pardelim)
      834       .
      835       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      836         assign
      837           v-result-list = v-result-list
      838                         + (if v-result-list > "" then pardelim else "")
      839                         + v-elem
      840         .
      841       end.
      842     end.
      843     return v-result-list .
      844   end function.
      845   function cross-list returns character (
      846    input parfirst-list  as character,
      847    input parsecond-list as character,
      848    input pardelim       as character).
      849     if pardelim = ""
      850     or pardelim = ?
      851     then do:
      852       assign
      853         pardelim = ","
      854       .
      855     end.
      856     def var ind as integer no-undo .
      857     def var v-elem as character no-undo .
      858     def var v-result-list as character no-undo init "".
      859     def var v-num-parfirst-list as integer no-undo .
      860     assign
      861       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      862     .
      863     do ind = 1 to v-num-parfirst-list
      864     :
      865       assign
      866         v-elem = entry(ind, parfirst-list, pardelim)
      867       .
      868       if lookup(v-elem, v-result-list, pardelim) = 0
      869       and lookup(v-elem, parsecond-list, pardelim) > 0
      870       then do:
      871         assign
      872           v-result-list = v-result-list
      873                         + (if v-result-list > "" then pardelim else "")
      874                         + v-elem
      875         .
      876       end.
      877     end.
      878     return v-result-list .
      879   end function.
      880   function radio-label returns character (
      881    input par-rs-value  as character,
      882    input par-rs-radio-buttons as character)
      883    .
      884    DEFINE variable v-result-label as character no-undo.
      885    assign
      886    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons) MODULO 2 = 0)
      887                              then (LOOKUP(par-rs-value, par-rs-radio-buttons) - 1)
      888                              else LOOKUP(par-rs-value, par-rs-radio-buttons)
      889                             ), par-rs-radio-buttons
      890                           )
      891    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      892    .
      893   return v-result-label.
      894   end function.
      895   function m-radio-label returns character (
      896    input par-rs-value  as character,
      897    input par-rs-radio-buttons as character,
      898    input par-delim as character
      899    )
      900    .
      901    DEFINE variable v-result-label as character no-undo.
      902    assign
      903    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) MODULO 2 = 0)
      904                              then (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) - 1)
      905                              else LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim)
      906                             ), par-rs-radio-buttons, par-delim
      907                           )
      908    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      909    .
      910   return v-result-label.
      911   end function.
      912   FUNCTION mixlist returns character
      913   (
      914    input parfirst-list  as character
      915    ,input parsecond-list as character
      916    ,input pardelim       as character
      917    ,input pardelim-result as character ) :
      918     if pardelim = ""
      919     or pardelim = ?
      920     then do:
      921       assign
      922         pardelim = ","
      923       .
      924     end.
      925     def var ind as integer no-undo .
      926     def var v-elem1 as character no-undo .
      927     def var v-elem2 as character no-undo .
      928     def var v-result-list as character no-undo init "".
      929     do ind = 1 to num-entries(parfirst-list, pardelim)
      930     :
      931       assign
      932         v-elem1 = entry(ind, parfirst-list, pardelim)
      933         v-elem2 = entry(ind, parsecond-list, pardelim)
      934       .
      935         assign
      936           v-result-list = v-result-list
      937                         + (if v-result-list > "" then pardelim-result else "")
      938                         + v-elem1 + pardelim-result + v-elem2
      939         .
      940     end.
      941     return v-result-list .
      942   END FUNCTION.
      943   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      944   function breakstr returns character ( input        for-name    as character,
      945                                         input        line-length as integer,
      946                                         input-output line1       as character,
      947                                         input-output line2       as character ) :
      948     define variable ii as integer no-undo.
      949     if length( for-name ) > line-length then do:
      950       assign ii    = 1
      951              line1 = "":u
      952              line2 = "":u.
      953       if length( entry( ii, for-name , " ":u ) ) > line-length then do:
      954         assign line1 =       substring( for-name, 1, line-length     )
      955                line2 = trim( substring( for-name,    line-length + 1 ) ).
      956       end.                                                     else do:
      957         do while length( line1 + entry( ii, for-name, " ":u ) ) < ( line-length + 1 ) :
      958           assign line1 = line1 + entry( ii, for-name, " ":u ) + " ":u
      959                  ii    = ii    + 1.
      960           if length( entry( ii, for-name, " ":u ) ) > line-length then do:
      961             assign line1 = line1 + substring( for-name, length( line1 ), line-length - length( line1 ) + 1 ).
      962           end.
      963         end.
      964         assign line2 = trim( substring( for-name, length( line1 ) ) ).
      965       end.
      966     end.                                else do:
      967       assign line1 = for-name
      968              line2 = "":u.
      969     end.
      970     return ( line1 ).
      971   end function.
      972   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      973   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      974   FUNCTION get-d-pcnt RETURNS CHARACTER
      975     ( buffer loc-dis-card for ub.dis-card,
      976       input parhost-code as integer,
      977       input parobj-type as character,
      978       input parobj-code as integer,
      979       input p-discnt-role as character,
      980       output loc-d-v as decimal) :
      981   define variable v-node-code as integer no-undo .
      982   define buffer buf_dis-card-type for ub.dis-card-type.
      983   define buffer buf_dis-card-property for ub.dis-card-property.
      984   find first buf_dis-card-type no-lock where
      985             buf_dis-card-type.type = loc-dis-card.type
      986         and buf_dis-card-type.emitent-host-code = loc-dis-card.emitent-host-code
      987         and buf_dis-card-type.host-code = 0
      988         and buf_dis-card-type.obj-type = '':U
      989         and buf_dis-card-type.obj-code = 0 no-error.
      990   if available buf_dis-card-type then do:
      991     case p-discnt-role:
      992       when 'def-pcnt':U  then do:
      993         assign
      994         v-node-code = 1.
      995       end.
      996       when 'def-cash-pcnt':U then do:
      997         assign
      998         v-node-code = 2.
      999       end.
     1000       when 'def-categ':U then do:
     1001         assign
     1002         v-node-code = 3.
     1003       end.
     1004     end.
     1005     if buf_dis-card-type.d-pcnt-byshop then do:
     1006      find first buf_dis-card-property no-lock where
     1007                buf_dis-card-property.d-card = loc-dis-card.d-card
     1008            and buf_dis-card-property.dtm-code = 26
     1009            and buf_dis-card-property.host-code = parhost-code
     1010            and buf_dis-card-property.obj-type = parobj-type
     1011            and buf_dis-card-property.obj-code = parobj-code
     1012            and buf_dis-card-property.node-code = v-node-code no-error.
     1013      if available buf_dis-card-property then do:
     1014        if p-discnt-role = 'def-categ':U then do:
     1015          assign
     1016          loc-d-v = buf_dis-card-property.property-value-integer.
     1017        end.
     1018        else do:
     1019          assign
     1020          loc-d-v = buf_dis-card-property.property-value-decimal.
     1021        end.
     1022      end.
     1023       if loc-d-v = ? then do:
     1024   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1025   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdpcnt in g#library
     1026     (
     1027      input  loc-dis-card.type
     1028     ,input  loC-dis-card.emitent-host-code
     1029     ,input  parhost-code
     1030     ,input  parobj-type
     1031     ,input  parobj-code
     1032     ,input  p-discnt-role
     1033     ,output loc-d-v
     1034     ) no-error .
     1035       end.
     1036       if loc-d-v = ? then do:
     1037         find first buf_dis-card-property no-lock where
     1038                   buf_dis-card-property.d-card = loc-dis-card.d-card
     1039               and buf_dis-card-property.dtm-code = 26
     1040               and buf_dis-card-property.host-code = parhost-code
     1041               and buf_dis-card-property.obj-type = ''
     1042               and buf_dis-card-property.obj-code = 0
     1043               and buf_dis-card-property.node-code = v-node-code no-error.
     1044         if available buf_dis-card-property then do:
     1045           if p-discnt-role = 'def-categ':U then do:
     1046             assign
     1047             loc-d-v = buf_dis-card-property.property-value-integer.
     1048           end.
     1049           else do:
     1050             assign
     1051             loc-d-v = buf_dis-card-property.property-value-decimal.
     1052           end.
     1053         end.
     1054       end.
     1055       if loc-d-v = ? then do:
     1056   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1057   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdpcnt in g#library
     1058     (
     1059      input  loc-dis-card.type
     1060     ,input  loC-dis-card.emitent-host-code
     1061     ,input  parhost-code
     1062     ,input  ''
     1063     ,input  0
     1064     ,input  p-discnt-role
     1065     ,output loc-d-v
     1066     ) no-error .
     1067       end.
     1068       if loc-d-v = ? then do:
     1069         case p-discnt-role:
     1070           when 'def-categ':U then do:
     1071             loc-d-v = loc-dis-card.category.
     1072           end.
     1073           when 'def-pcnt':U then do:
     1074             loc-d-v = loc-dis-card.d-pcnt.
     1075           end.
     1076           when 'def-cash-pcnt':U then do:
     1077             loc-d-v = loc-dis-card.cash-d-pcnt.
     1078           end.
     1079         end case.
     1080       end.
     1081       if p-discnt-role = 'def-categ':U then do:
     1082         return substitute("(i) &1", string(loc-d-v, ">>>9")).
     1083       end.
     1084       else do:
     1085         return substitute("(i) &1", string(loc-d-v, "->9.99%")).
     1086       end.
     1087     end.
     1088   end.
     1089   else do:
     1090    return "ОШИБКА-НЕТ ТИПА".
     1091   end.
     1092   case p-discnt-role:
     1093     when 'def-categ':U then do:
     1094        loc-d-v = loc-dis-card.category.
     1095        return string(loc-d-v, ">>>9").
     1096     end.
     1097     when 'def-pcnt':U then do:
     1098       loc-d-v = loc-dis-card.d-pcnt.
     1099       return string(loc-d-v, "->9.99%").
     1100     end.
     1101     when 'def-cash-pcnt':U then do:
     1102       loc-d-v = loc-dis-card.cash-d-pcnt.
     1103       return string(loc-d-v, "->9.99%").
     1104     end.
     1105   end case.
     1106   END FUNCTION.
     1107   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1108   define variable v-waitfram-action01         as character   no-undo .
     1109   define variable v-waitfram-action02         as character   no-undo .
     1110   define variable v-waitfram-action03         as character   no-undo .
     1111   define variable mWaitFramTextBeg            as character   no-undo.
     1112   define variable mWaitFramTextEnd            as character   no-undo.
     1113   define variable mWaitFramView               as logical     no-undo.
     1114   define variable mWaitProcEvent              as logical     no-undo init yes.
     1115   define variable mWaitFramInterval           as integer     no-undo init 1 .
     1116   define variable mWaitFramStop               as logical     no-undo.
     1117   define variable mWaitFramStopUser           as logical     no-undo.
     1118   define variable mWaitFramStopTimeOut        as logical     no-undo.
     1119   define variable mWaitFramStartProc          as datetime-tz no-undo.
     1120   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     1121   define button B-WaitFramStop auto-end-key
     1122        label "Стоп"
     1123        size 10 by 1 tooltip "Остоновить процесс".
     1124   define button B-viewProcInfo
     1125        label "Информация"
     1126        size 15 by 1 tooltip "Информация о процесс".
     1127   define frame waitfram
     1128     v-waitfram-action01 format "x(72)" no-label skip
     1129     v-waitfram-action02 format "x(72)" no-label skip
     1130     v-waitfram-action03 format "x(72)" no-label skip
     1131     B-viewProcInfo
     1132     B-WaitFramStop at row 4 col 30
     1133     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1134     .
     1135   define new global shared variable mBatchMode as logical no-undo init ?.
     1136   define variable mFramBachModHandle as handle no-undo.
     1137   mFramBachModHandle = frame waitfram:handle.
     1138   define variable mFameOldVis as logical no-undo.
     1139   define variable mVisCUrentVin as logical no-undo.
     1140   if session:batch-mode
     1141   then
     1142      mBatchMode = yes.
     1143   if mBatchMode = ? then do:
     1144     mVisCUrentVin = current-window:visible.
     1145     mFameOldVis = mFramBachModHandle:visible.
     1146     mFramBachModHandle:visible  = yes.
     1147     mBatchMode = mFramBachModHandle:visible ne yes.
     1148     mFramBachModHandle:visible = mFameOldVis.
     1149     current-window:visible = mVisCUrentVin.
     1150   end.
     1151    if  log-manager:logfile-name ne ?
     1152     then DO:
     1153         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1154         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1155         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1156     end.
     1157   on choose of B-WaitFramStop in frame waitfram
     1158   do:
     1159     mWaitFramStop = yes.
     1160     mWaitFramStopUser = yes.
     1161   end.
     1162   function waitfram-check-timeout returns logical():
     1163      define variable vtime as int64 no-undo.
     1164      if mWaitFramStopTimeOut
     1165      then
     1166         return yes.
     1167      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1168      if     mWaitFramTimeOut ne ?
     1169         and mWaitFramTimeOut ne 0
     1170         and mWaitFramTimeOut lt vtime
     1171      then do:
     1172         mWaitFramStopTimeOut = yes.
     1173      end.
     1174      return mWaitFramStopTimeOut.
     1175   end.
     1176   procedure waitfram-hide :
     1177     if not session:batch-mode
     1178     then do
     1179     on error undo, return error return-value
     1180     :
     1181       pause 0 before-hide .
     1182       if not mBatchMode then
     1183         hide frame waitfram .
     1184     if     not mWaitFramView
     1185        and mWaitProcEvent
     1186     then
     1187       process events .
     1188     end.
     1189   end procedure.
     1190   procedure waitfram-show :
     1191     define input  parameter p-message as character no-undo .
     1192     define variable v-left-margin as integer   no-undo .
     1193     if not session:batch-mode
     1194     then do
     1195     on error undo, return error return-value
     1196     :
     1197       if length(p-message) <= 70 then do:
     1198         assign
     1199           v-left-margin = integer((70 - length(p-message)) / 2)
     1200         .
     1201         assign
     1202           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1203         .
     1204         assign
     1205           v-waitfram-action01 = " "
     1206           v-waitfram-action02 = " "
     1207                                    + fill(" ", v-left-margin)
     1208                                    + p-message
     1209           v-waitfram-action03 = " "
     1210         .
     1211       end.
     1212       else do:
     1213         define variable vRindex1 as integer no-undo.
     1214         define variable vRindex2 as integer no-undo.
     1215         vRindex1 = r-index(p-message," ",70).
     1216         if vRindex1 = 0
     1217         then
     1218            vRindex1 = 70.
     1219         if length(p-message)  <= vRindex1 + 70 then do:
     1220           assign
     1221             v-waitfram-action01 = " "
     1222             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1223             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1224           .
     1225         end.
     1226         else do:
     1227           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1228           if vRindex2 <= vRindex1
     1229           then
     1230              vRindex2 = vRindex1 + 70.
     1231           assign
     1232             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1233             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1234             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1235           .
     1236         end.
     1237       end.
     1238       B-viewProcInfo:visible   in frame waitfram = no.
     1239       B-viewProcInfo:sensitive in frame waitfram = no.
     1240       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1241       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1242       if  (   mWaitFramView
     1243          or  mWaitProcEvent)
     1244          and not mBatchMode
     1245       then
     1246          display
     1247             v-waitfram-action01 skip
     1248             v-waitfram-action02 skip
     1249             v-waitfram-action03 skip
     1250          with frame waitfram .
     1251       if     mWaitFramView
     1252          then do:
     1253             if     mWaitFramInterval ne ?
     1254                and not mBatchMode
     1255             then
     1256                wait-for go of frame waitfram pause mWaitFramInterval.
     1257          end.
     1258          else
     1259             if     mWaitProcEvent
     1260                and not mBatchMode
     1261             then
     1262                process events .
     1263     end.
     1264   end procedure.
     1265      procedure waitfram-show-this:
     1266         define input  parameter iInterval as int64 no-undo.
     1267         define variable vtime as int64 no-undo.
     1268         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1269         mWaitFramInterval = iInterval.
     1270         run waitfram-show (substitute("&1&2 &3&4" ,
     1271                                       mWaitFramTextBeg ,
     1272                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1273                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1274                                       mWaitFramTextEnd
     1275                                      )
     1276                           ).
     1277      end.
     1278      procedure WaitFramRunPause:
     1279         define input  parameter iInterval as dec no-undo.
     1280         define variable vStart  as datetime-tz no-undo.
     1281         define variable vend    as datetime-tz no-undo.
     1282         define variable vint as int64 no-undo.
     1283         define variable vOk as logical no-undo.
     1284         vStart = now.
     1285         vend   = vStart.
     1286         publish "WaitFramPause" (iInterval,output vOk).
     1287         vend   =  now.
     1288         vint = vend - vStart.
     1289         vint = iInterval - vint / 1000.
     1290         if     not mWaitFramStop
     1291            and (   vint > 0
     1292                 or (    not vOk
     1293                     and iInterval eq ?
     1294                     )
     1295                 )
     1296         then
     1297            run waitfram-show-this (iInterval).
     1298         vend   =  now.
     1299         vint = vend - vStart.
     1300         vint = iInterval - vint / 1000.
     1301         if     not mWaitFramStop
     1302            and vint > 0
     1303         then do:
     1304            run gbl/pause.p (vint * 1000).
     1305         end.
     1306         if iInterval ne ?
     1307         then
     1308            publish "WaitFramStop".
     1309         waitfram-check-timeout().
     1310      end.
     1311      procedure WaitFramWaitFor:
     1312         define input  parameter iInterval as dec no-undo.
     1313         assign
     1314            mWaitFramStartProc   = now
     1315            mWaitFramStopUser    = no
     1316            mWaitFramStopTimeOut = no
     1317         .
     1318         block-wait:
     1319         do while not mWaitFramStop:
     1320            run WaitFramRunPause (iInterval).
     1321            if  waitfram-check-timeout()
     1322            then do:
     1323               leave block-wait.
     1324            end.
     1325         end.
     1326         run waitfram-hide.
     1327      end.
     1328   procedure waitfram-join :
     1329     define input  parameter p-line-1  as character no-undo .
     1330     define input  parameter p-line-2  as character no-undo .
     1331     define input  parameter p-line-3  as character no-undo .
     1332     define output parameter p-message as character no-undo .
     1333     do
     1334     on error undo, return error return-value
     1335     :
     1336       assign
     1337         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1338                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1339                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1340       .
     1341     end.
     1342   end procedure.
     1343   function waitfram-join-function returns character
     1344     (input p-line-1 as character
     1345     ,input p-line-2 as character
     1346     ,input p-line-3 as character
     1347     ).
     1348     define variable v-message as character no-undo .
     1349     run waitfram-join in this-procedure
     1350       (input  p-line-1
     1351       ,input  p-line-2
     1352       ,input  p-line-3
     1353       ,output v-message
     1354       ) .
     1355     return v-message .
     1356   end function .
