     1396   procedure grplib-get-full-name :
     1397      define input parameter p-node-code  as integer      no-undo.
     1398      define output parameter p-full-name as character    no-undo.
     1399      do
     1400   on error undo, return error
     1401   :
     1402       define variable v-upper-code    as integer           no-undo.
     1403       define buffer buf_gds-grp       for ub.gds-grp.
     1404       define buffer buf_upper_gds-grp for ub.gds-grp.
     1405       find first buf_gds-grp no-lock
     1406            where buf_gds-grp.node-code = p-node-code
     1407       no-error.
     1408       if not available buf_gds-grp
     1409       then do:
     1410           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
     1411       end.
     1412       assign
     1413           p-full-name  = ""
     1414           v-upper-code = 1
     1415       .
     1416       do while buf_gds-grp.upper-code <> 0
     1417       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
     1418       :
     1419           assign
     1420               p-full-name  = buf_gds-grp.node-name
     1421                            + (if p-full-name <> "" then chr(47) else "")
     1422                            + p-full-name
     1423               v-upper-code = buf_gds-grp.upper-code
     1424           .
     1425           find first buf_gds-grp no-lock
     1426                where buf_gds-grp.node-code = v-upper-code
     1427           no-error.
     1428           if not available buf_gds-grp
     1429           then do:
     1430               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
     1431                                   + string( v-upper-code )
     1432                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     1433           end.
     1434       end.
     1435       assign
     1436       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
     1437       .
     1438   end.
     1439   end .
     1440   procedure grplib-get-node-from-full-name :
     1441   define input parameter p-full-name as character no-undo .
     1442   define output parameter p-node-code as integer no-undo .
     1443   define variable v-ii as integer no-undo .
     1444   define variable v-upper-code as integer no-undo .
     1445   define variable v-root-code as integer no-undo .
     1446   define variable v-entry as character no-undo .
     1447   define buffer buf_gds-grp       for ub.gds-grp.
     1448   do
     1449   on error undo, return error
     1450   :
     1451     find first buf_gds-grp no-lock
     1452         where buf_gds-grp.upper-code = 0
     1453     no-error .
     1454     if not available buf_gds-grp
     1455     then do:
     1456         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
     1457     end.
     1458     else do:
     1459       assign
     1460       v-root-code = buf_gds-grp.node-code
     1461       .
     1462     end.
     1463     v-upper-code = v-root-code.
     1464     do v-ii = 1 to num-entries(p-full-name, chr(47)):
     1465       assign
     1466       v-entry = entry(v-ii, p-full-name, chr(47)).
     1467       if v-entry = '' then leave.
     1468       find first buf_gds-grp no-lock where
     1469                 buf_gds-grp.node-name = v-entry
     1470             and buf_gds-grp.upper-code = v-upper-code
     1471             no-error.
     1472       if not available buf_gds-grp then do:
     1473         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
     1474       end.
     1475       else do:
     1476         p-node-code = buf_gds-grp.node-code.
     1477         v-upper-code = buf_gds-grp.node-code.
     1478       end.
     1479     end.
     1480   end.
     1481   end .
