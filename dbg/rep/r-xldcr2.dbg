      153   procedure create_obj-list :
      154      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      155      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      156      do
      157      on error undo, return error return-value
      158      :
      159         define buffer cli-obj for ub.clients .
      160         define variable p-var as integer no-undo .
      161         define buffer buf_obj-list for obj-list .
      162         find last buf_obj-list  use-index pi no-error .
      163         if available buf_obj-list
      164         then
      165            p-var = buf_obj-list.obj-id + 1.
      166         else
      167            p-var = 1.
      168         find first cli-obj where
      169                   cli-obj.obj-type = p-obj-type
      170               and cli-obj.obj-code = p-obj-code
      171         no-lock no-error.
      172         if available cli-obj
      173         then do:
      174            create buf_obj-list.
      175            assign
      176               buf_obj-list.obj-id   = p-var
      177               buf_obj-list.obj-code = cli-obj.obj-code
      178               buf_obj-list.obj-type = cli-obj.obj-type
      179               buf_obj-list.obj-name = cli-obj.obj-name
      180               buf_obj-list.db-num   = cli-obj.db-num
      181            .
      182         end.
      183      end.
      184   end.
