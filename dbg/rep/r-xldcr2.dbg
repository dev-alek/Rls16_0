     2506                                       dcards.d-card       = buf_payment.d-card
     2507                                       dcards.b-code       = 0
     2508                                       dcards.sale-price   = 0
     2509                                       dcards.grp-lvl      = 1
     2510                                       dcards.doc-qnty     = 0
     2511                                       dcards.upper-code   = 1
     2512                                       dcards.gds-name     = "ВС"
     2513                                       dcards.artic        = "Импорт из ВС"
     2514                                   .
     2515                               end.
     2516                           end.
     2517                           if available dcards then
     2518                           do:
     2519                               assign
     2520                                   dcards.doc-qnty     = 0
     2521                                   dcards.sale-price   = 0
     2522                                   dcards.sum          = dcards.sum + buf_payment.tot-cli
     2523                                   dcards.counter      = (dcards.counter + 1)
     2524                               .
     2525                           end.
     2526                       end.
     2527                   end.
     2528               end.
     2529               do:
     2530                   for first buf-obj1_dcards where
     2531                             buf-obj1_dcards.obj-name   = "ИТОГО" and
     2532                             buf-obj1_dcards.grp-lvl    = 2000
     2533                   no-lock
     2534                   :
     2535                       assign
     2536                           buf-obj1_dcards.counter = buf-obj1_dcards.counter + v-obj_doc-qnty
     2537                           buf-obj1_dcards.sum = buf-obj1_dcards.sum + v-obj_sum-withoutdisc
     2538                       .
     2539                       release buf-obj1_dcards.
     2540                   end.
     2541               end.
     2542           end.
     2543       end.
     2544       do:
     2545       end.
     2546       run waitfram-hide in this-procedure.
     2547       if can-find(first dcards) then
     2548       do:
     2549           run prn-lib-open-stream in this-procedure (
     2550                                                        input my-handle
     2551                                                       ,input 43
     2552                                                       ,input yes
     2553                                                       ,input no
     2554                                                      ).
     2555           Line = fill("-", 200).
     2556           form header
     2557               line format "X(184)" at 1 skip
     2558               "Продолжение - на следующей странице" at 30 skip
     2559               with frame BottomFrame width 232 page-bottom no-labels no-box
     2560           .
     2561           view stream PrnLibStream frame BottomFrame.
     2562           assign
     2563               v-report-name = "Отчет по картам клиентам"
     2564           .
     2565           assign
     2566               v-period = str1
     2567           .
     2568           assign
     2569               v-msg-noAllChk = (if NotInc then "(сформирован НЕ ПО ВСЕМ ЧЕКАМ)" else "")
     2570           .
     2571           put stream PrnLibStream
     2572               space(40) "Отчет по продажам постоянным клиентам" skip
     2573               space(40) str1 format "X(60)" skip
     2574               space(20) (if NotInc then "(сформирован НЕ ПО ВСЕМ ЧЕКАМ)" else " ") format "x(40)" skip
     2575               space(20) "По объектам :"
     2576           .
     2577           _short-list: for each obj-list no-lock
     2578           :
     2579               find first buf_clients where
     2580                          buf_clients.obj-type = obj-list.obj-type and
     2581                          buf_clients.obj-code = obj-list.obj-code no-lock
     2582               .
     2583               find first ub.db where
     2584                          ub.db.db-num = buf_clients.db-num no-lock
     2585               .
     2586               do:
     2587               end.
     2588               do:
     2589                   v-short-obj-list = v-short-obj-list + (if length(v-short-obj-list) > 0 then ";  " else "") +  buf_clients.obj-name.
     2590                   if length(v-short-obj-list) > 100 then
     2591                   do:
     2592                       v-short-obj-list = substring(v-short-obj-list, 1, 100) + "...".
     2593                       leave _short-list.
     2594                   end.
     2595               end.
     2596               do:
     2597               end.
     2598           end.
     2599           do:
     2600           end.
     2601           case DcardMode:
     2602               when "ALL":U then
     2603               do:
     2604                   v-sel-card-string = "По ВСЕМ картам.".
     2605                   do:
     2606                   end.
     2607               end.
     2608               when "ONE":U then
     2609               do:
     2610               end.
     2611               when "LIST":U then
     2612               do:
     2613                   ii = 0.
     2614                   for each dc-list no-lock
     2615                   :
     2616                       ii = ii + 1.
     2617                   end.
     2618                   v-sel-card-string = "По сформированному списку карт" + "(в списке " + string(ii) + " кар.)".
     2619                   do:
     2620                       put stream PrnLibStream
     2621                           space(10) string("По сформированному списку карт") format "x(50)" skip
     2622                           substitute("В списке &1 карт", ii) skip
     2623                       .
     2624                   end.
     2625               end.
     2626           end case.
     2627           if X-SelectGood = 1 then
     2628           do:
     2629               create tt-selectgood.
     2630               tt-selectgood.collection-name = "По ВСЕМ производителям (поставщикам).".
     2631               do:
     2632                   put stream PrnLibStream
     2633                       space(20) "По ВСЕМ производителям (поставщикам)." format "x(40)" skip(1)
     2634                   .
     2635               end.
     2636           end.
     2637           else
     2638           do:
     2639               case X-selectgood:
     2640                   when 3 then
     2641                   do:
     2642                       do:
     2643                           put stream PrnLibStream
     2644                           space(20) "По производителям: " format "x(80)" skip(0).
     2645                       end.
     2646                       _g#cli: for each g#cli
     2647                       :
     2648                           do:
     2649                               put stream PrnLibStream
     2650                                   space(20) g#cli.obj-name format "x(80)" skip(0)
     2651                               .
     2652                           end.
     2653                           if available tt-selectgood then
     2654                           do:
     2655                               if tt-selectgood.collection-element = g#cli.obj-name then next.
     2656                           end.
     2657                           else
     2658                           do:
     2659                               create tt-selectgood.
     2660                           end.
     2661                           if available tt-selectgood then
     2662                           do:
     2663                               tt-selectgood.collection-element = tt-selectgood.collection-element + g#cli.obj-name + "; ".
     2664                               if length(tt-selectgood.collection-element) > 100 then
     2665                               do:
     2666                                   tt-selectgood.collection-element = substring(tt-selectgood.collection-element, 1, 100).
     2667                                   tt-selectgood.collection-element = right-trim(tt-selectgood.collection-element, " ").
     2668                                   tt-selectgood.collection-element = right-trim(tt-selectgood.collection-element, ";").
     2669                                   tt-selectgood.collection-element = tt-selectgood.collection-element + "...".
     2670                                   leave _g#cli.
     2671                               end.
     2672                           end.
     2673                       end.
     2674                       find first tt-selectgood no-lock no-error.
     2675                       if not available tt-selectgood then
     2676                       do:
     2677                           create tt-selectgood.
     2678                       end.
     2679                       tt-selectgood.collection-name = "По производителям:".
     2680                   end.
     2681                   when 2 then
     2682                   do:
     2683                       do:
     2684                           put stream PrnLibStream
     2685                               space(20) "По группам товаров: " format "x(80)" skip(0)
     2686                           .
     2687                       end.
     2688                       _tmp#grp: for each tmp#grp
     2689                       :
     2690                           do:
     2691                               put stream PrnLibStream
     2692                                   space(20) tmp#grp.grp-name format "x(80)" skip(0)
     2693                               .
     2694                           end.
     2695                           if available tt-selectgood then
     2696                           do:
     2697                               if tt-selectgood.collection-element = tmp#grp.grp-name then next.
     2698                           end.
     2699                           else
     2700                           do:
     2701                               create tt-selectgood.
     2702                           end.
     2703                           if available tt-selectgood then
     2704                           do:
     2705                               tt-selectgood.collection-element = tt-selectgood.collection-element + tmp#grp.grp-name + "; ".
     2706                               if length(tt-selectgood.collection-element) > 100 then
     2707                               do:
     2708                                   tt-selectgood.collection-element = substring(tt-selectgood.collection-element, 1, 100).
     2709                                   tt-selectgood.collection-element = right-trim(tt-selectgood.collection-element, " ").
     2710                                   tt-selectgood.collection-element = right-trim(tt-selectgood.collection-element, ";").
     2711                                   tt-selectgood.collection-element = tt-selectgood.collection-element + "...".
     2712                                   leave _tmp#grp.
     2713                               end.
     2714                           end.
     2715                       end.
     2716                       find first tt-selectgood no-lock no-error.
     2717                       if not available tt-selectgood then
     2718                       do:
     2719                           create tt-selectgood.
     2720                       end.
     2721                       tt-selectgood.collection-name = "По группам товаров:".
     2722                   end.
     2723                   when 4 then
     2724                   do:
     2725                       ii = 0.
     2726                       for each gds-list
     2727                       :
     2728                           ii = ii + 1.
     2729                       end.
     2730                       create tt-selectgood.
     2731                       tt-selectgood.collection-name = "По сформированному списку товаров " + "(В списке " + string(ii) + " товаров).".
     2732                       do:
     2733                           put stream PrnLibStream
     2734                               space(10) "По сформированному списку товаров " format "x(50)"
     2735                               substitute("(В списке &1 товаров)", ii) skip
     2736                           .
     2737                       end.
     2738                   end.
     2739                   when 5 then
     2740                   do:
     2741                       find first gds-list
     2742                       .
     2743                       create tt-selectgood.
     2744                       tt-selectgood.collection-name = "По товару:".
     2745                       tt-selectgood.collection-element = string(gds-list.artic) + chr(32) +
     2746                                                         gds-list.prod-type + string(gds-list.prod-code) +
     2747                                                         chr(32) + gds-list.gds-name
     2748                       .
     2749                       do:
     2750                           put stream PrnLibStream
     2751                               space(20) "По товару: " format "x(10)"
     2752                               gds-list.artic chr(32) gds-list.prod-type gds-list.prod-code chr(32) gds-list.gds-name skip(0)
     2753                           .
     2754                       end.
     2755                   end.
     2756               end case.
     2757           end.
     2758           do:
     2759           end.
     2760           if t-legacy or t-subsid then
     2761           do:
     2762               if t-legacy then v-legacy-string = "С учетом перевыпуска карт (приведены номера карт ПОСЛЕДНЕГО ВЫПУСКА).".
     2763               if t-subsid then v-subsid-string = "С учетом дополнительных карт (приведены номера ОСНОВНЫХ карт).".
     2764               do:
     2765                   put stream PrnLibStream unformatted
     2766                       (if t-legacy then "С учетом перевыпуска карт (приведены номера карт ПОСЛЕДНЕГО ВЫПУСКА)"
     2767                        else '':U)
     2768                       (if t-subsid then "С учетом дополнительных карт (приведены номера ОСНОВНЫХ карт)"
     2769                        else '':U)
     2770                                   skip (1)
     2771                   .
     2772               end.
     2773           end.
     2774           do:
     2775           end.
     2776           do:
     2777           end.
     2778           run proc-create-HTML(
     2779                                    input v-file-name-rep-htm
     2780                                   ,input v-report-name
     2781                                   ,input v-period
     2782                               ).
     2783           run search-full-path-Report(input v-file-name-rep-htm).
     2784           run Report-Viewer(input v-full-path-RepView, input v-file-name-rep-htm).
     2785           do:
     2786           end.
     2787       end.
     2788       else
     2789       do:
     2790           message
     2791               "На выбранных Вами объектах" skip
     2792               "не было продаж постоянным клиентам" skip
     2793               "в течение заданного Вами периода времени."
     2794           view-as alert-box information.
     2795           for each dcards:
     2796               delete dcards.
     2797           end.
     2798       end.
     2799   end procedure.
     2800   procedure proc-create-HTML:
     2801       define input parameter p-file-name-rep-htm as character no-undo.
     2802       define input parameter p-report-name as character no-undo.
     2803       define input parameter p-period as character no-undo.
     2804       define variable v-message as character no-undo.
     2805       define buffer buf-html_clients for ub.clients.
     2806       define buffer buf-obj2_dcards for dcards.
     2807       define buffer buf-crd2_dcards for dcards.
     2808       define buffer buf-crd-imp_dcards for dcards.
     2809       do:
     2810           output stream OutStr-html to value(p-file-name-rep-htm) append convert target 'UTF-8'.
     2811               put stream OutStr-html unformatted
     2812                   "<!DOCTYPE HTML>" skip
     2813                   ' <html>' skip
     2814                   '  <head>' skip
     2815                   '   <meta charset="utf-8">' skip
     2816                   '    <style type="text/css">' skip
     2817                   '      table ' + chr(123) + ' border-collapse: collapse; font-size: 9pt; table-layout: fixed; width: 1157px; padding: 14px; ' + chr(125) skip
     2818                   '      td ' + chr(123) ' border: 1px black ridge; word-wrap:break-word; ' + chr(125) skip
     2819                   '      htm' skip
     2820                   '      .rotate ' + chr(123) skip
     2821                   '        -webkit-transform: rotate(-90deg);' skip
     2822                   '        -moz-transform: rotate(-90deg);' skip
     2823                   '        -ms-transform: rotate(-90deg);' skip
     2824                   '        -o-transform: rotate(-90deg);' skip
     2825                   '        transform: rotate(-90deg);' skip
     2826                   '        -webkit-transform-origin: 50% 50%;' skip
     2827                   '        -moz-transform-origin: 50% 50%;' skip
     2828                   '        -ms-transform-origin: 50% 50%;' skip
     2829                   '        -o-transform-origin: 50% 50%;' skip
     2830                   '        transform-origin: 50% 50%;' skip
     2831                   '        filter: progid:DXImageTransform.Microsoft.BasicImage(rotation=3);' skip
     2832                   '          ' + chr(125) skip
     2833                   '            th' + ' ' + chr(123) skip
     2834                   '            border: 1px black solid;' skip
     2835                   '            word-wrap: break-word;' skip
     2836                   '          ' + chr(125) skip
     2837                   '   </style>' skip
     2838                   '  </head>' skip
     2839               .
     2840       end.
     2841       do:
     2842               put stream OutStr-html unformatted
     2843                   ' <body>' skip
     2844                   '   <table name="Лист1" outline_below="false">' skip
     2845                   '     <thead>' skip
     2846                   '       <tr class="set_columns">' skip
     2847                   '         <td style="width: 130px; border: none;"></td>' skip
     2848                   '         <td style="width: 170px; border: none;"></td>' skip
     2849                   '         <td style="width: 77px; border: none;"></td>' skip
     2850                   '         <td style="width: 77px; border: none;"></td>' skip
     2851                   '         <td style="width: 77px; border: none;"></td>' skip
     2852                   '         <td style="width: 77px; border: none;"></td>' skip
     2853                   '       </tr>' skip
     2854               .
     2855       end.
     2856       do:
     2857               put stream OutStr-html unformatted
     2858                   '       <tr>' skip
     2859                   '         <td style="border: none; height: 14px"></td>' skip
     2860                   '         <td style="border: none"></td>' skip
     2861                   '         <td style="border: none"></td>' skip
     2862                   '         <td style="border: none"></td>' skip
     2863                   '         <td style="border: none"></td>' skip
     2864                   '         <td style="border: none"></td>' skip
     2865                   '       </tr>' skip
     2866                   '       <tr>' skip
     2867                   '         <td colspan="6" style="border: none; height: 14px; font-weight: bold; text-align: center">' + p-report-name + '</td>' skip
     2868                   '         <td style="border: none"></td>' skip
     2869                   '         <td style="border: none"></td>' skip
     2870                   '         <td style="border: none"></td>' skip
     2871                   '         <td style="border: none"></td>' skip
     2872                   '         <td style="border: none"></td>' skip
     2873                   '       </tr>' skip
     2874                   '       <tr>' skip
     2875                   '         <td colspan="6" style="border: none; height: 14px; font-weight: bold; text-align: center">' + v-period + '</td>' skip
     2876                   '         <td style="border: none"></td>' skip
     2877                   '         <td style="border: none"></td>' skip
     2878                   '         <td style="border: none"></td>' skip
     2879                   '         <td style="border: none"></td>' skip
     2880                   '         <td style="border: none"></td>' skip
     2881                   '       </tr>' skip
     2882                   '       <tr>' skip
     2883                   '         <td style="border: none; height: 14px; font-weight: bold"></td>' skip
     2884                   '         <td style="border: none"></td>' skip
     2885                   '         <td style="border: none"></td>' skip
     2886                   '         <td style="border: none"></td>' skip
     2887                   '         <td style="border: none"></td>' skip
     2888                   '         <td style="border: none"></td>' skip
     2889                   '       </tr>' skip
     2890               .
     2891               if NotInc then
     2892               do:
     2893                   run msg-html-noAllChk(output v-message).
     2894                   put stream OutStr-html unformatted
     2895                       v-message
     2896                   .
     2897               end.
     2898               put stream OutStr-html unformatted
     2899                   '       <tr>' skip
     2900                   '         <td colspan="6" style="border: none; height: 14px; font-weight: bold">По объектам:</td>' skip
     2901                   '         <td style="border: none"></td>' skip
     2902                   '         <td style="border: none"></td>' skip
     2903                   '         <td style="border: none"></td>' skip
     2904                   '         <td style="border: none"></td>' skip
     2905                   '         <td style="border: none"></td>' skip
     2906                   '       </tr>' skip
     2907               .
     2908               do:
     2909               end.
     2910               put stream OutStr-html unformatted
     2911                   '       <tr>' skip
     2912                   '         <td colspan="6" style="border: none; height: 14px">' + v-short-obj-list + '</td>' skip
     2913                   '         <td style="border: none"></td>' skip
     2914                   '         <td style="border: none"></td>' skip
     2915                   '         <td style="border: none"></td>' skip
     2916                   '         <td style="border: none"></td>' skip
     2917                   '         <td style="border: none"></td>' skip
     2918                   '       </tr>' skip
     2919               .
     2920               put stream OutStr-html unformatted
     2921                   '       <tr>' skip
     2922                   '         <td style="border: none; height: 14px"></td>' skip
     2923                   '         <td style="border: none"></td>' skip
     2924                   '         <td style="border: none"></td>' skip
     2925                   '         <td style="border: none"></td>' skip
     2926                   '         <td style="border: none"></td>' skip
     2927                   '         <td style="border: none"></td>' skip
     2928                   '       </tr>' skip
     2929               .
     2930               put stream OutStr-html unformatted
     2931                   '       <tr>' skip
     2932                   '         <td colspan="6" style="border: none; height: 14px">' + v-sel-card-string + '</td>' skip
     2933                   '         <td style="border: none"></td>' skip
     2934                   '         <td style="border: none"></td>' skip
     2935                   '         <td style="border: none"></td>' skip
     2936                   '         <td style="border: none"></td>' skip
     2937                   '         <td style="border: none"></td>' skip
     2938                   '       </tr>' skip
     2939               .
     2940               if  X-SelectGood <> 1 then
     2941               do:
     2942                   put stream OutStr-html unformatted
     2943                       '       <tr>' skip
     2944                       '         <td style="border: none; height: 14px"></td>' skip
     2945                       '         <td style="border: none"></td>' skip
     2946                       '         <td style="border: none"></td>' skip
     2947                       '         <td style="border: none"></td>' skip
     2948                       '         <td style="border: none"></td>' skip
     2949                       '         <td style="border: none"></td>' skip
     2950                       '       </tr>' skip
     2951                   .
     2952               end.
     2953               find first tt-selectgood no-lock no-error.
     2954               if available tt-selectgood then
     2955               do:
     2956                   if tt-selectgood.collection-name <> ? or tt-selectgood.collection-name <> "":U then
     2957                   do:
     2958                       put stream OutStr-html unformatted
     2959                           '       <tr>' skip
     2960                           '         <td colspan="6" style="border: none; height: 14px">' + tt-selectgood.collection-name + '</td>' skip
     2961                           '         <td style="border: none"></td>' skip
     2962                           '         <td style="border: none"></td>' skip
     2963                           '         <td style="border: none"></td>' skip
     2964                           '         <td style="border: none"></td>' skip
     2965                           '         <td style="border: none"></td>' skip
     2966                           '       </tr>' skip
     2967                       .
     2968                   end.
     2969               end.
     2970               if X-SelectGood <> 1 then
     2971               do:
     2972                   define variable v-nn as integer initial 0 no-undo.
     2973                   for each tt-selectgood no-lock where
     2974                   :
     2975                       if tt-selectgood.collection-element <> ? or tt-selectgood.collection-element <> "" then
     2976                       do:
     2977                           v-nn = v-nn + 1.
     2978                           put stream OutStr-html unformatted
     2979                               '       <tr>' skip
     2980                               '         <td colspan="6" style="border: none; height: 14px">' + tt-selectgood.collection-element + '</td>' skip
     2981                               '         <td style="border: none"></td>' skip
     2982                               '         <td style="border: none"></td>' skip
     2983                               '         <td style="border: none"></td>' skip
     2984                               '         <td style="border: none"></td>' skip
     2985                               '         <td style="border: none"></td>' skip
     2986                               '       </tr>' skip
     2987                           .
     2988                       end.
     2989                   end.
     2990                   if v-nn > 0 and (t-legacy or t-subsid) then
     2991                   do:
     2992                       put stream OutStr-html unformatted
     2993                           '       <tr>' skip
     2994                           '         <td style="border: none; height: 14px"></td>' skip
     2995                           '         <td style="border: none"></td>' skip
     2996                           '         <td style="border: none"></td>' skip
     2997                           '         <td style="border: none"></td>' skip
     2998                           '         <td style="border: none"></td>' skip
     2999                           '         <td style="border: none"></td>' skip
     3000                           '       </tr>' skip
     3001                       .
     3002                   end.
     3003               end.
     3004               if t-legacy then
     3005               do:
     3006                   put stream OutStr-html unformatted
     3007                       '       <tr>' skip
     3008                       '         <td colspan="6" style="border: none; height: 14px">' + v-legacy-string + '</td>' skip
     3009                       '         <td style="border: none"></td>' skip
     3010                       '         <td style="border: none"></td>' skip
     3011                       '         <td style="border: none"></td>' skip
     3012                       '         <td style="border: none"></td>' skip
     3013                       '         <td style="border: none"></td>' skip
     3014                       '       </tr>' skip
     3015                   .
     3016               end.
     3017               if t-subsid then
     3018               do:
     3019                   put stream OutStr-html unformatted
     3020                       '       <tr>' skip
