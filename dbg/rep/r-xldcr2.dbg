     1685   (input p-data as decimal, p-accur as character) forward.
     1686   run My-Rep.
     1687   run waitfram-hide in this-procedure .
     1688   procedure calc-chk:
     1689       v-first-of-d-card = no.
     1690       do:
     1691           if dcardmode = "ONE":U then
     1692           do:
     1693               if not buf_chk-doc.d-card = FixDCard then return.
     1694           end.
     1695           if dcardmode = "list":U then
     1696           do:
     1697               find first dc-list where
     1698               dc-list.d-card = buf_chk-doc.d-card no-error.
     1699               if not available dc-list then return.
     1700           end.
     1701       end.
     1702       process events.
     1703       v-count = v-count + 1.
     1704       if (v-count  modulo 10) = 0
     1705       and  v-count >= 10 then
     1706       do:
     1707           run waitfram-show in this-procedure (input substitute("&1&2 обработано чеков &3"
     1708                                                                   ,obj-list.obj-type
     1709                                                                   ,obj-list.obj-code
     1710                                                                   ,v-count))
     1711           .
     1712       end.
     1713       new-doc = yes.
     1714       if p-T-obj-detal = yes  then
     1715       do:
     1716           v-obj-type = obj-list.obj-type.
     1717           v-obj-code = obj-list.obj-code.
     1718           v-obj-name = obj-list.obj-name.
     1719       end.
     1720       else
     1721       do:
     1722           v-obj-type = "".
     1723           v-obj-code = 0.
     1724           v-obj-name = "".
     1725       end.
     1726       do:
     1727       end.
     1728       do:
     1729       end.
     1730       do:
     1731           _chk: for each buf_chk-gds where buf_chk-gds.doc-code = buf_chk-doc.doc-code
     1732                 ,
     1733                 first buf_bar-code no-lock where
     1734                       buf_bar-code.b-code = buf_chk-gds.b-code
     1735                 ,
     1736                 first buf_goods no-lock where
     1737                       buf_goods.gds-code = buf_bar-code.gds-code
     1738           :
     1739               do:
     1740               end.
     1741               if buf_chk-gds.write-off-code <> ? and
     1742                  buf_chk-gds.write-off-code > 0 then next _CHk.
     1743                   if prodmode = 3 then
     1744                   do:
     1745                       if not can-find(first g#cli no-lock where
     1746                                             g#cli.obj-type = buf_goods.prod-type and
     1747                                             g#cli.obj-code = buf_goods.prod-code) then next _chk.
     1748                   end.
     1749                   if prodmode = 2 then
     1750                   do:
     1751                       assign
     1752                           v-grp-name = ""
     1753                           v-found = no
     1754                       .
     1755                       _ii-grp: do ii-grp = 1 to num-entries(buf_goods.grp-name, chr(47)) - 1
     1756                       :
     1757                           assign
     1758                               v-grp-name = v-grp-name + entry(ii-grp, buf_goods.grp-name, chr(47)) + chr(47)
     1759                           .
     1760                           if can-find(first tmp#grp no-lock where
     1761                                             tmp#grp.grp-name = v-grp-name) then
     1762                           do:
     1763                               assign v-found = yes.
     1764                               leave _ii-grp.
     1765                           end.
     1766                       end.
     1767                       if not v-found then next _chk.
     1768                   end.
     1769                   if prodmode = 4 then
     1770                   do:
     1771                       if not can-find(first gds-list no-lock where
     1772                                             gds-list.gds-code = buf_goods.gds-code) then next _chk.
     1773                   end.
     1774               do:
     1775               end.
     1776               find first dcards where
     1777                          dcards.obj-type = v-obj-type and
     1778                          dcards.obj-code = v-obj-code and
     1779                          dcards.chk-date = buf_chk-doc.chk-date and
     1780                          dcards.d-card = buf_chk-doc.d-card and
     1781                          dcards.b-code = buf_bar-code.b-code
     1782               no-error.
     1783               if not available dcards then
     1784               do:
     1785                   create dcards.
     1786                   assign
     1787                       dcards.obj-type     = v-obj-type
     1788                       dcards.obj-code     = v-obj-code
     1789                       dcards.obj-name     = v-obj-name
     1790                       dcards.chk-date     = buf_chk-doc.chk-date
     1791                       dcards.shift-date   = buf_chk-doc.shift-date
     1792                       dcards.chk-doc-code = buf_chk-doc.doc-code
     1793                       dcards.d-card       = buf_chk-doc.d-card
     1794                       dcards.artic        = buf_goods.artic
     1795                       dcards.gds-name     = buf_goods.gds-name
     1796                       dcards.b-code       = buf_bar-code.b-code
     1797                       dcards.prod-type    = buf_goods.prod-type
     1798                       dcards.prod-code    = buf_goods.prod-code
     1799                       dcards.doc-qnty     = 0
     1800                       dcards.grp-code     = buf_goods.grp-code
     1801                       dcards.gds-code     = buf_goods.gds-code
     1802                   .
     1803                   if t-legacy or t-subsid then
     1804                   do:
     1805                       find first buf_dis-card no-lock where
     1806                                  buf_dis-card.d-card = buf_chk-doc.d-card
     1807                       no-error.
     1808                       if available buf_dis-card then
     1809                       do:
     1810                           assign
     1811                               v-card-num-chr = (if t-legacy and t-subsid then buf_dis-card.first-main-card
     1812                                                   else (if t-legacy and not t-subsid then buf_dis-card.first-card
     1813                                                           else buf_dis-card.main-card))
     1814                           .
     1815                           assign
     1816                               dcards.d-card          = buf_dis-card.d-card
     1817                               dcards.card-num-chr    = v-card-num-chr
     1818                               dcards.first-card      = buf_dis-card.first-card
     1819                               dcards.main-card       = buf_dis-card.main-card
     1820                               dcards.first-main-card = buf_dis-card.first-main-card
     1821                               dcards.cli-type-code   = buf_dis-card.cli-type + string(buf_dis-card.cli-code)
     1822                               dcards.card-num        = buf_dis-card.card-num
     1823                           .
     1824                       end.
     1825                   end.
     1826                   else
     1827                   do:
     1828                       if buf_chk-doc.cli-type = ?
     1829                       or buf_chk-doc.cli-code = ?
     1830                       or buf_chk-doc.cli-type = '':U
     1831                       or buf_chk-doc.cli-code = 0 then
     1832                       do:
     1833                           find first buf_dis-card no-lock where
     1834                           buf_dis-card.d-card = buf_chk-doc.d-card no-error.
     1835                           if available buf_dis-card then
     1836                           do:
     1837                               assign
     1838                                   dcards.cli-type-code = buf_dis-card.cli-type + string(buf_dis-card.cli-code)
     1839                               .
     1840                           end.
     1841                       end.
     1842                       else
     1843                       do:
     1844                           assign
     1845                               dcards.cli-type-code = buf_chk-doc.cli-type + string(buf_chk-doc.cli-code)
     1846                           .
     1847                       end.
     1848                   end.
     1849               end.
     1850               v-first-of-d-card = yes.
     1851               assign
     1852                   dcards.doc-qnty = dcards.doc-qnty + buf_chk-gds.doc-qnty
     1853                   dcards.sale-price = buf_chk-gds.price-base
     1854                   dcards.counter = dcards.counter + 1
     1855                   dcards.sum = dcards.sum + (buf_chk-gds.doc-qnty * dcards.sale-price)
     1856                   dcards.discount = dcards.discount + (buf_chk-gds.doc-qnty *
     1857                                     (buf_chk-gds.discnt +
     1858                                     (buf_chk-gds.price-base - buf_chk-gds.price-base)))
     1859                   dcards.sum-withdisc = dcards.sum - dcards.discount
     1860                   new-doc = no
     1861               .
     1862           end.
     1863           if v-first-of-d-card = yes  then
     1864           do:
     1865               find first buf-crd_dcards where
     1866                          buf-crd_dcards.grp-lvl = 1000 and
     1867                          buf-crd_dcards.obj-type = v-obj-type and
     1868                          buf-crd_dcards.obj-code = v-obj-code and
     1869                          buf-crd_dcards.d-card = dcards.d-card and
     1870                          buf-crd_dcards.cli-type-code = dcards.cli-type-code
     1871               no-lock no-error.
     1872               if not available buf-crd_dcards then
     1873               do:
     1874                   create buf-crd_dcards.
     1875                   assign
     1876                       buf-crd_dcards.grp-lvl = 1000
     1877                       buf-crd_dcards.obj-type = v-obj-type
     1878                       buf-crd_dcards.obj-code = v-obj-code
     1879                       buf-crd_dcards.d-card = dcards.d-card
     1880                       buf-crd_dcards.cli-type-code = dcards.cli-type-code
     1881                   .
     1882               end.
     1883               if available buf-crd_dcards then
     1884               do:
     1885                   buf-crd_dcards.counter = buf-crd_dcards.counter + 1.
     1886               end.
     1887           end.
     1888       end.
     1889   end procedure.
     1890   procedure My-Rep:
     1891   do:
     1892   end.
     1893       run get-full-path-RepViewer(output v-full-path-RepView).
     1894       run get-report-num in parParentProc(output g#report-num).
     1895       run define-full-path-Report(input g#report-num, output v-file-name-rep-htm).
     1896       run create-file(v-file-name-rep-htm).
     1897       define frame X123
     1898           sym1                column-label ":!:" format "X(1)"
     1899           dcards.chk-date     column-label "Дата!покупки" format "99/99/9999"
     1900           dcards.artic        column-label "Артикул! " format "X(16)"
     1901           dcards.b-code       column-label "Баркод!" format ">>>>>>>>>>>>9"
     1902           ub.goods.gds-name   format "X(25)"
     1903           buf3_clients.obj-name   column-label "Производитель!(поставщик)" format "X(38)"
     1904           dcards.sale-price   column-label "Цена!отпускная" format ">,>>>,>>9.99"
     1905           dcards.doc-qnty         column-label "Количество  ! " format "->>>>>>9.<<<"
     1906           dcards.sum          column-label "Получено! " format "->>,>>>,>>>,>>9.99"
     1907           dcards.discount     column-label "Скидка! " format "->>,>>>,>>9.99"
     1908           v-for-netto         column-label "Сумма!нетто" format "->>>,>>>,>>9.99"
     1909           sym2                column-label ":!:" format "X(1)"
     1910           header
     1911           v-header-base-curr  format "X(40)" at 50
     1912           "Страница " at 100 page-number( PrnLibStream ) at 110 format ">>>>9" skip
     1913           Line format "X(184)" at 1
     1914           with width 232 down stream-io use-text
     1915       .
     1916       case X-selectgood:
     1917           when 3 then
     1918           do:
     1919               for each g#cli no-lock
     1920               :
     1921                   num-g# = num-g# + 1.
     1922                   if num-g# = 1 then FixProdAttr = g#cli.obj-type + string(g#cli.obj-code).
     1923                   if num-g# > 1 then leave.
     1924               end.
     1925           end.
     1926           when 2 then
     1927           do:
     1928               for each tmp#grp no-lock
     1929               :
     1930                   num-g# = num-g# + 1.
     1931                   if num-g# = 1 then FixProdAttr = string(tmp#grp.node-code).
     1932                   if num-g# > 1 then leave.
     1933               end.
     1934           end.
     1935           when 4 or when 5 then
     1936           do:
     1937               for each gds-list no-lock
     1938               :
     1939                   num-g# = num-g# + 1.
     1940                   if num-g# = 1 then
     1941                   FixProdAttr = string(gds-list.gds-code).
     1942                   if num-g# > 1 then leave.
     1943               end.
     1944           end.
     1945       end case.
     1946       run waitfram-show in this-procedure ("Подождите ...").
     1947       do:
     1948       end.
     1949           if prodmode = 3 then
     1950           do:
     1951               assign
     1952                   v-prod-type = Substr(FixProdAttr, 1, 3)
     1953                   v-prod-code = integer(substr(FixProdAttr, 4))
     1954               .
     1955           end.
     1956           if prodmode = 2 then
     1957           do:
     1958               assign
     1959                   v-grp-code = integer(FixProdAttr)
     1960               .
     1961               run grplib-get-full-name in this-procedure (
     1962                                                            input v-grp-code
     1963                                                           ,output v-grp-name)
     1964               .
     1965           end.
     1966           if prodmode = 5 then
     1967           do:
     1968               assign
     1969                   v-gds-code = integer(FixProdAttr)
     1970               .
     1971           end.
     1972       for each obj-host:
     1973           delete obj-host.
     1974       end.
     1975       create obj-host.
     1976       assign
     1977           obj-host.host-code = 0
     1978       .
     1979       _obj: for each obj-list
     1980       :
     1981           if obj-list.obj-type = 'маг':U then
     1982           do:
     1983               find first buf_shop no-lock where
     1984               buf_shop.obj-code = obj-list.obj-code.
     1985               find first obj-host no-lock where
     1986               obj-host.host-code = buf_shop.host-code no-error.
     1987               if not available obj-host then
     1988               do:
     1989                   create obj-host.
     1990                   assign
     1991                       obj-host.host-code = buf_shop.host-code
     1992                   .
     1993               end.
     1994           end.
     1995           else
     1996           do:
     1997               find first buf_store no-lock where
     1998               buf_store.obj-code = obj-list.obj-code.
     1999               find first obj-host no-lock where
     2000               obj-host.host-code = buf_store.host-code no-error.
     2001               if not available obj-host then
     2002               do:
     2003                   create obj-host.
     2004                   assign
     2005                       obj-host.host-code = buf_store.host-code
     2006                   .
     2007               end.
     2008           end.
     2009           if x-TOG-Shift = yes then
     2010           do:
     2011               if can-find(first ub.chk-doc where
     2012               ub.chk-doc.obj-type = obj-list.obj-type and
     2013               ub.chk-doc.obj-code = obj-list.obj-code and
     2014               (ub.chk-doc.shift-date >= X-date-Start) and
     2015               (ub.chk-doc.shift-date <= X-date-End) and
     2016               ub.chk-doc.d-card <> "" and
     2017               ub.chk-doc.out-code <> ?) then
     2018                   do:
     2019                       _chk-doc1: for each buf_chk-doc no-lock where
     2020                       buf_chk-doc.obj-type = obj-list.obj-type and
     2021                       buf_chk-doc.obj-code = obj-list.obj-code and
     2022                       (buf_chk-doc.shift-date > X-date-Start or (buf_chk-doc.shift-date = X-date-Start and buf_chk-doc.shift-num >= x-Shift-Start)) and
     2023                       (buf_chk-doc.shift-date < X-date-End or (buf_chk-doc.shift-date = X-date-End and buf_chk-doc.shift-num <= x-Shift-End)) and
     2024                       buf_chk-doc.d-card <> "":U and
     2025                       buf_chk-doc.out-code <> ?
     2026                       :
     2027                           do:
     2028                               if lookup(string(buf_chk-doc.chk-type), '14,15,16,36,17,8,11,12,13,40,69,101,106,108,169,196,114,115,116,117,111,112,136,113,101,106,108,208,2,3,4,5,7,43,44':U) > 0 then next _chk-doc1.
     2029                               run calc-chk.
     2030                           end.
     2031                       end.
     2032                   end.
     2033           end.
     2034           else
     2035           do:
     2036               if can-find(first chk-doc where
