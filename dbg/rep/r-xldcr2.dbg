     3215   procedure msg-html-noAllChk:
     3216       define output parameter p-message as character no-undo.
     3217           p-message =
     3218                   '       <tr>' + chr(10) +
     3219                   '         <td style="border: none; height: 14px; font-weight: bold"></td>' + chr(10) +
     3220                   '         <td colspan="9" style="border: none">' + "сформирован НЕ ПО ВСЕМ ЧЕКАМ" + '</td>' + chr(10) +
     3221                   '         <td style="border: none"></td>' + chr(10) +
     3222                   '         <td style="border: none"></td>' + chr(10) +
     3223                   '         <td style="border: none"></td>' + chr(10) +
     3224                   '         <td style="border: none"></td>' + chr(10) +
     3225                   '         <td style="border: none"></td>' + chr(10) +
     3226                   '         <td style="border: none"></td>' + chr(10) +
     3227                   '         <td style="border: none"></td>' + chr(10) +
     3228                   '         <td style="border: none"></td>' + chr(10) +
     3229                   '       </tr>' + chr(10) +
     3230                   '       <tr>' + chr(10) +
     3231                   '         <td style="border: none; height: 14px; font-weight: bold"></td>' + chr(10) +
     3232                   '         <td style="border: none"></td>' + chr(10) +
     3233                   '         <td style="border: none"></td>' + chr(10) +
     3234                   '         <td style="border: none"></td>' + chr(10) +
     3235                   '         <td style="border: none"></td>' + chr(10) +
     3236                   '         <td style="border: none"></td>' + chr(10) +
     3237                   '         <td style="border: none"></td>' + chr(10) +
     3238                   '         <td style="border: none"></td>' + chr(10) +
     3239                   '         <td style="border: none"></td>' + chr(10) +
