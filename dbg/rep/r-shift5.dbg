       97   def
       98    shared
       99   temp-table  obj-list no-undo
      100     field obj-type like ub.clients.obj-type
      101     field obj-code like ub.clients.obj-code
      102     field obj-name like ub.clients.obj-name
      103     field obj-id   as integer
      104     field db-num   as integer
      105     index pi is primary unique obj-id
      106     index ie1 obj-type obj-code
      107     index ie2 obj-name
      108   .
      109   procedure create_obj-list :
      110      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      111      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      112      do
      113      on error undo, return error return-value
      114      :
      115         define buffer cli-obj for ub.clients .
      116         define variable p-var as integer no-undo .
      117         define buffer buf_obj-list for obj-list .
      118         find last buf_obj-list  use-index pi no-error .
      119         if available buf_obj-list
      120         then
      121            p-var = buf_obj-list.obj-id + 1.
      122         else
      123            p-var = 1.
      124         find first cli-obj where
      125                   cli-obj.obj-type = p-obj-type
      126               and cli-obj.obj-code = p-obj-code
      127         no-lock no-error.
      128         if available cli-obj
      129         then do:
      130            create buf_obj-list.
      131            assign
      132               buf_obj-list.obj-id   = p-var
      133               buf_obj-list.obj-code = cli-obj.obj-code
      134               buf_obj-list.obj-type = cli-obj.obj-type
      135               buf_obj-list.obj-name = cli-obj.obj-name
      136               buf_obj-list.db-num   = cli-obj.db-num
      137            .
      138         end.
      139      end.
      140   end.
