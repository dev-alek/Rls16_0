      571   DEFINE new shared TEMP-TABLE t-5 no-undo
      572   FIELD wth-code like ub.wealth.wth-code
      573   FIELD wth-name like ub.wealth.wth-name
      574   FIELD stock-before like ub.wth-line.income
      575   FIELD stock-after like ub.wth-line.income
      576   FIELD income-cassa  like ub.wth-line.income-cassa
      577   FIELD income-other like ub.wth-line.income-other
      578   FIELD incass-bank  like ub.wth-line.incass-bank
      579   FIELD incass-other like ub.wth-line.incass-other
      580   FIELD incass-cassa like ub.wth-line.incass-cassa
      581   INDEX pi IS UNIQUE primary
      582   wth-code
      583   INDEX namei
      584   wth-name
      585   .
      586   define shared stream PrnLibstream .
      587   define variable pol1 as character no-undo .
      588   define variable pol2 as decimal   no-undo .
      589   define variable pol3 as decimal   no-undo .
      590   define variable pol4 as decimal   no-undo .
      591   define variable pol5 as decimal   no-undo .
      592   define variable pol6 as decimal   no-undo .
      593   define variable pol7 as decimal   no-undo .
      594   define variable line as character no-undo .
      595   define variable ii   as integer   no-undo .
      596     procedure on-same-page :
      597       define input parameter p-line-number as integer no-undo .
      598       if p-line-number > page-size( PrnLibstream )
      599       then do:
      600         return .
      601       end.
      602       if line-counter( PrnLibstream ) + p-line-number > page-size( PrnLibstream )
      603       then do:
      604         page stream PrnLibstream .
      605       end.
      606     end procedure.
      607   define frame FRAME-5
      608     pol1 column-label "5.1":C32 format "x(32)":U           space( 0 ) sym1 column-label ":" format "x(1)":U space( 0 )
      609     pol2 column-label "5.2":C15 format "->>>,>>>,>>9.99":U space( 0 ) sym2 column-label ":" format "x(1)":U space( 0 )
      610     pol3 column-label "5.3":C14 format ">>>,>>>,>>9.99":U  space( 0 ) sym3 column-label ":" format "x(1)":U space( 0 )
      611     pol4 column-label "5.4":C14 format ">>>,>>>,>>9.99":U  space( 0 ) sym4 column-label ":" format "x(1)":U space( 0 )
      612     pol5 column-label "5.5":C14 format ">>>,>>>,>>9.99":U  space( 0 ) sym5 column-label ":" format "x(1)":U space( 0 )
      613     pol6 column-label "5.6":C14 format ">>>,>>>,>>9.99":U  space( 0 ) sym6 column-label ":" format "x(1)":U space( 0 )
      614     pol7 column-label "5.7":C15 format "->>>,>>>,>>9.99":U space( 0 )
      615   with width 232 down stream-io use-text no-box .
      616   run rep/r-shft5r.p
      617     ( input p-obj-type
      618     , input p-obj-code
      619     , input X-date-Start
      620     , input X-Shift-Start
      621     , input X-date-End
      622     , input X-Shift-End
      623     ) no-error .
      624   form header
      625     "----------------------------------------------------------------------------------------------------------------------------"  skip "                                                ƒ¬»∆≈Õ»≈ Ã¿“≈–»¿À‹Õ€’ ÷≈ÕÕŒ—“≈…                                             "  skip "----------------------------------------------------------------------------------------------------------------------------"  skip "          Õ¿»Ã≈ÕŒ¬¿Õ»≈          :   Œ—“¿“Œ  Õ¿  :          œŒÀ”◊≈ÕŒ           :        »Õ ¿——»–Œ¬¿ÕŒ        :   Œ—“¿“Œ  Õ¿  "  skip "          Ï‡ÚÂË‡Î¸Ì˚ı          :  Õ¿◊¿ÀŒ —Ã≈Õ€ :-----------------------------:-----------------------------:    ŒÕ≈÷ —Ã≈Õ€ "  skip "            ˆÂÌÌÓÒÚÂÈ           :               :    ¬˚Û˜Í‡   :    œÓ˜ËÂ    :       ‚      :   œÓ˜ËÂ     :               "  skip "                                :               :   Á‡ ÒÏÂÌÛ   :   ËÒÚÓ˜ÌËÍË  :     ·‡ÌÍ     : ÍÓÌÚ‡„ÂÌÚ˚  :               "  skip "----------------------------------------------------------------------------------------------------------------------------"
      626   with frame TopFrame width 232 page-top no-labels no-box .
      627   view stream PrnLibstream Frame TopFrame .
      628   for each t-5 no-lock use-index namei
      629   :
      630     assign
      631       pol1 = t-5.wth-name
      632       pol2 = t-5.stock-before
      633       pol3 = t-5.income-cassa - t-5.incass-cassa
      634       pol4 = t-5.income-other
      635       pol5 = t-5.incass-bank
      636       pol6 = t-5.incass-other
      637       pol7 = t-5.stock-after
      638     .
      639     run on-same-page in this-procedure ( input 1 + 1 ) .
      640     display Stream PrnLibstream
      641       pol1
      642       pol2
      643       pol3 when pol3 <> 0
      644       pol4 when pol4 <> 0
      645       pol5 when pol5 <> 0
      646       pol6 when pol6 <> 0
      647       pol7
      648     with frame Frame-5.
      649     if Make-Excel then  put   stream ForExcel unformatted
      650       pol1 CHR(9)
      651       pol2 CHR(9)
      652       pol3 CHR(9)
      653       pol4 CHR(9)
      654       pol5 CHR(9)
      655       pol6 CHR(9)
      656       pol7 CHR(9)
      657     skip .
      658   end.
