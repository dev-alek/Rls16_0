     4486     ) no-error .
     4487       if varcur-vat-pc = ?
     4488       then do:
     4489         return error substitute ("Ошибка при поиске НДС для товара &1 &2 &3 документ &4", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code, bf_trn-doc.doc-code).
     4490       end.
     4491       if varcur-slt-pc = ?
     4492       then do:
     4493         return error substitute ("Ошибка при поиске НДС для товара &1 &2 &3 документ &4", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code, bf_trn-doc.doc-code).
     4494       end.
     4495       v-calcbypart = no.
     4496       if bf_doc-line.whole-send-news = integer('1':U)   then
     4497       v-calcbypart = yes.
     4498       else do:
     4499       for each bf_gds-dtl no-lock
     4500         where bf_gds-dtl.doc-code  = bf_doc-line.doc-code
     4501           and bf_gds-dtl.artic     = bf_doc-line.artic
     4502           and bf_gds-dtl.prod-type = bf_doc-line.prod-type
     4503           and bf_gds-dtl.prod-code = bf_doc-line.prod-code
     4504       on error undo, return error return-value
     4505       :
     4506   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     4507     (input  bf_goods.gds-code
     4508     ,input  bf_gds-dtl.prt-code
     4509     ,output varb-code
     4510     ) no-error .
     4511   define variable vss-include-info39 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4512   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     4513     (input  bf_trn-doc.obj-type
     4514     ,input  bf_trn-doc.obj-code
     4515     ,input  varb-code
     4516     ,input  0
     4517     ,input  bf_trn-doc.fact-order
     4518     ,output vardoc-num
     4519     ,output varprice-sale
     4520     ,output varroad-tax
     4521     ,output varexcise
     4522     )  .
     4523             if varprice-sale = ?
     4524             then do:
     4525               assign
     4526                 varprice-sale = 0
     4527                 varroad-tax   = 0
     4528                 varexcise     = 0
     4529               .
     4530             end.
     4531             assign
     4532               varlastcur-base     = varprice-sale
     4533               varlastcur-road-tax = varroad-tax
     4534               varlastcur-excise   = varexcise
     4535               varcur-base         = varcur-base      + varprice-sale * bf_gds-dtl.fact-qnty
     4536               varcur-road-tax     = varcur-road-tax  + varroad-tax   * bf_gds-dtl.fact-qnty
     4537               varcur-excise       = varcur-excise    + varexcise     * bf_gds-dtl.fact-qnty
     4538               varcur-fact-qnty    = varcur-fact-qnty + bf_gds-dtl.fact-qnty
     4539             .
     4540         end.
     4541       end.
     4542       if varcur-fact-qnty = 0 then do:
     4543         assign
     4544           varcur-base      = varlastcur-base
     4545           varcur-road-tax  = varlastcur-road-tax
     4546           varcur-excise    = varlastcur-excise
     4547         .
     4548       end.
     4549       else do:
     4550         assign
     4551           varcur-base      = varcur-base      / varcur-fact-qnty
     4552           varcur-road-tax  = varcur-road-tax  / varcur-fact-qnty
     4553           varcur-excise    = varcur-excise    / varcur-fact-qnty
     4554         .
     4555       end.
     4556       if varcur-vat-pc = ?
     4557       then do:
     4558         return error substitute ("Нет текущего продажного НДС по товару &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     4559       end.
     4560       if varcur-slt-pc = ?
     4561       then do:
     4562         return error substitute ("Нет текущего продажного НП по товару &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     4563       end.
     4564       find first bf_sysconf where bf_sysconf.host-code = bf_trn-doc.host-code no-lock.
     4565       assign
     4566         varcur-cons-vat-pc = bf_sysconf.cons-vat-pc.
     4567       if varcur-cons-vat-pc = ? then do:
     4568         return error substitute ("Нет текущего продажного консигнационного НДС по фирме &1", bf_trn-doc.host-code).
     4569       end.
     4570       define buffer buf_tt-clcparts for tt-clcparts .
     4571       for each buf_tt-clcparts
     4572       on error undo, return error return-value
     4573       :
     4574         delete buf_tt-clcparts.
     4575       end.
     4576       for each bf_parts no-lock
     4577         where bf_parts.out-code  = bf_doc-line.doc-code
     4578           and bf_parts.obj-type  = bf_doc-line.obj-type
     4579           and bf_parts.obj-code  = bf_doc-line.obj-code
     4580           and bf_parts.artic     = bf_doc-line.artic
     4581           and bf_parts.prod-type = bf_doc-line.prod-type
     4582           and bf_parts.prod-code = bf_doc-line.prod-code
     4583       on error undo, return error return-value
     4584       :
     4585         create buf_tt-clcparts .
     4586         buffer-copy bf_parts to buf_tt-clcparts .
     4587         if v-calcbypart = yes   then do:
     4588   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run partbcod in g#library
     4589     (buffer bf_parts
     4590     ,output v-b-pcode
     4591     ) no-error .
     4592   define variable vss-include-info40 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4593   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     4594     (input  bf_parts.obj-type
     4595     ,input  bf_parts.obj-code
     4596     ,input  v-b-pcode
     4597     ,input  0
     4598     ,input  bf_trn-doc.fact-order
     4599     ,output vardoc-num
     4600     ,output varprice-salef
     4601     ,output varroad-tax
     4602     ,output varexcise
     4603     ) no-error .
     4604             if varprice-sale = ?
     4605             then do:
     4606               assign
     4607                 varprice-salef = 0
     4608                 varroad-tax   = 0
     4609                 varexcise     = 0
     4610               .
     4611             end.
     4612             assign
     4613             part-cur-base  = varprice-salef
     4614             part-cur-road-tax  = varroad-tax
     4615             part-cur-excise = varexcise.
     4616         end.
     4617       end.
     4618       run clcprtsl_calc-ttable in this-procedure
     4619         (input yes,
     4620          input yes,
     4621          input bf_doc-line.road-tax,
     4622          input bf_doc-line.excise,
     4623          input bf_doc-line.vat-pc,
     4624          input bf_doc-line.cons-vat-pc,
     4625          input bf_doc-line.slt-pc,
     4626          input bf_trn-doc.base-rate,
     4627          input bf_trn-doc.base-scale,
     4628          input varr-b,
     4629          input varcur-base,
     4630          input varcur-road-tax,
     4631          input varcur-excise,
     4632          input varcur-vat-pc,
     4633          input varcur-cons-vat-pc,
     4634          input varcur-slt-pc
     4635          ) no-error.
     4636       if error-status:error then do:
     4637         message
     4638           vss-workfile vss-revision vss-description skip
     4639           "Ошибка при вызове процедуры clcprtsl_calc-ttable." skip
     4640           return-value skip
     4641           trim(error-status :get-message(1))
     4642           trim(error-status :get-message(2))
     4643           trim(error-status :get-message(3))
     4644           trim(error-status :get-message(4))
     4645           trim(error-status :get-message(5)) skip
     4646           view-as alert-box error.
     4647         undo, return error .
     4648       end.
     4649     end.
     4650   end.
     4651   end.
     4652   procedure clcprtsl_calc-ttable :
     4653   define input parameter paris-doc           as   logical                 no-undo.
     4654   define input parameter paris-cur           as   logical                 no-undo.
     4655   define input parameter parroad-tax         like ub.doc-line.road-tax    no-undo.
     4656   define input parameter parexcise           like ub.doc-line.excise      no-undo.
     4657   define input parameter parvat-pc           like ub.doc-line.vat-pc      no-undo.
     4658   define input parameter parcons-vat-pc      like ub.doc-line.cons-vat-pc no-undo.
     4659   define input parameter parslt-pc           like ub.doc-line.slt-pc      no-undo.
     4660   define input parameter parbase-rate        like ub.trn-doc.base-rate    no-undo.
     4661   define input parameter parbase-scale       like ub.trn-doc.base-scale   no-undo.
     4662   define input parameter parr-b              as   character               no-undo.
     4663   define input parameter parcur-base         like ub.gds-dtl.cur-base     no-undo.
     4664   define input parameter parcur-road-tax     like ub.doc-line.road-tax    no-undo.
     4665   define input parameter parcur-excise       like ub.doc-line.excise      no-undo.
     4666   define input parameter parcur-vat-pc       like ub.doc-line.vat-pc      no-undo.
     4667   define input parameter parcurcons-vat-pc   like ub.doc-line.cons-vat-pc no-undo.
     4668   define input parameter parcurslt-pc        like ub.doc-line.slt-pc      no-undo.
     4669   define buffer bf_tt-allsum      for tt-allsum.
     4670   define buffer bf_tt-clcparts    for tt-clcparts.
     4671   define buffer bf_tt-allsum-line for tt-allsum-line.
     4672   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     4673   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     4674   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     4675   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     4676   define variable varexcise          like ub.price-list.excise     no-undo.
     4677   do on error undo, return error return-value :
     4678   for each bf_tt-allsum-line
     4679   on error undo, return error return-value
     4680    :
     4681     delete bf_tt-allsum-line.
     4682   end.
     4683   for each bf_tt-allsum
     4684   on error undo, return error return-value
     4685   :
     4686     delete bf_tt-allsum.
     4687   end.
     4688   for each bf_tt-clcparts
     4689   on error undo, return error return-value
     4690   :
     4691   if v-calcbypart then do:
     4692             assign
     4693             parcur-base =   bf_tt-clcparts.part-cur-base
     4694             parcur-road-tax = bf_tt-clcparts.part-cur-road-tax
     4695             parcur-excise =   bf_tt-clcparts.part-cur-excise
     4696             .
     4697   end.
     4698      run clcprtsl_calc-parts in this-procedure (
     4699        input recid(bf_tt-clcparts),
     4700        input paris-doc,
     4701        input paris-cur,
     4702        input parroad-tax,
     4703        input parexcise,
     4704        input parvat-pc,
     4705        input parcons-vat-pc,
     4706        input parslt-pc,
     4707        input parbase-rate,
     4708        input parbase-scale,
     4709        input parr-b,
     4710        input parcur-base,
     4711        input parcur-road-tax,
     4712        input parcur-excise,
     4713        input parcur-vat-pc,
     4714        input parcurcons-vat-pc,
     4715        input parcurslt-pc
     4716        ) no-error.
     4717     if error-status:error then do:
     4718       message
     4719         vss-workfile vss-revision vss-description skip
     4720         vss-include-info27 skip
     4721         "Ошибка при обсчете партии" skip
     4722         "Документ партии " bf_tt-clcparts.out-code skip
     4723         "Товар" bf_tt-clcparts.artic bf_tt-clcparts.prod-type bf_tt-clcparts.prod-code skip
     4724         return-value skip
     4725         error-status:get-message(1) skip
     4726         error-status:get-message(2) skip
     4727         error-status:get-message(3) skip
     4728         view-as alert-box error .
     4729       undo, return error .
     4730     end.
     4731     for each bf_tt-allsum on error undo, return error return-value :
     4732       find first bf_tt-allsum-line where bf_tt-allsum-line.sum-type = bf_tt-allsum.sum-type no-error.
     4733       if not available bf_tt-allsum-line then do:
     4734         create bf_tt-allsum-line.
     4735         assign
     4736           bf_tt-allsum-line.sum-type = bf_tt-allsum.sum-type.
     4737       end.
     4738       assign
     4739         bf_tt-allsum-line.fact-qnty              = bf_tt-allsum-line.fact-qnty            + bf_tt-allsum.fact-qnty
     4740         bf_tt-allsum-line.cli-qnty               = bf_tt-allsum-line.cli-qnty             + bf_tt-allsum.cli-qnty
     4741         bf_tt-allsum-line.sum-dsc-base-doc       = bf_tt-allsum-line.sum-dsc-base-doc     + bf_tt-allsum.sum-dsc-base-doc
     4742         bf_tt-allsum-line.sum-dsc-rubl-doc       = bf_tt-allsum-line.sum-dsc-rubl-doc     + bf_tt-allsum.sum-dsc-rubl-doc
     4743         bf_tt-allsum-line.dsc-base-doc           = bf_tt-allsum-line.dsc-base-doc         + bf_tt-allsum.dsc-base-doc
     4744         bf_tt-allsum-line.dsc-rubl-doc           = bf_tt-allsum-line.dsc-rubl-doc         + bf_tt-allsum.dsc-rubl-doc
     4745         bf_tt-allsum-line.vat-base-doc           = bf_tt-allsum-line.vat-base-doc         + bf_tt-allsum.vat-base-doc
     4746         bf_tt-allsum-line.vat-rubl-doc           = bf_tt-allsum-line.vat-rubl-doc         + bf_tt-allsum.vat-rubl-doc
     4747         bf_tt-allsum-line.vat-base-buyer-doc     = bf_tt-allsum-line.vat-base-buyer-doc   + bf_tt-allsum.vat-base-buyer-doc
     4748         bf_tt-allsum-line.vat-rubl-buyer-doc     = bf_tt-allsum-line.vat-rubl-buyer-doc   + bf_tt-allsum.vat-rubl-buyer-doc
     4749         bf_tt-allsum-line.slt-base-doc           = bf_tt-allsum-line.slt-base-doc         + bf_tt-allsum.slt-base-doc
     4750         bf_tt-allsum-line.slt-rubl-doc           = bf_tt-allsum-line.slt-rubl-doc         + bf_tt-allsum.slt-rubl-doc
     4751         bf_tt-allsum-line.road-tax-base-doc      = bf_tt-allsum-line.road-tax-base-doc    + bf_tt-allsum.road-tax-base-doc
     4752         bf_tt-allsum-line.road-tax-rubl-doc      = bf_tt-allsum-line.road-tax-rubl-doc    + bf_tt-allsum.road-tax-rubl-doc
     4753         bf_tt-allsum-line.excise-base-doc        = bf_tt-allsum-line.excise-base-doc      + bf_tt-allsum.excise-base-doc
     4754         bf_tt-allsum-line.excise-rubl-doc        = bf_tt-allsum-line.excise-rubl-doc      + bf_tt-allsum.excise-rubl-doc
     4755         bf_tt-allsum-line.sum-dsc-base-cur       = bf_tt-allsum-line.sum-dsc-base-cur     + bf_tt-allsum.sum-dsc-base-cur
     4756         bf_tt-allsum-line.sum-dsc-rubl-cur       = bf_tt-allsum-line.sum-dsc-rubl-cur     + bf_tt-allsum.sum-dsc-rubl-cur
     4757         bf_tt-allsum-line.dsc-base-cur           = bf_tt-allsum-line.dsc-base-cur         + bf_tt-allsum.dsc-base-cur
     4758         bf_tt-allsum-line.dsc-rubl-cur           = bf_tt-allsum-line.dsc-rubl-cur         + bf_tt-allsum.dsc-rubl-cur
     4759         bf_tt-allsum-line.vat-base-cur           = bf_tt-allsum-line.vat-base-cur         + bf_tt-allsum.vat-base-cur
     4760         bf_tt-allsum-line.vat-rubl-cur           = bf_tt-allsum-line.vat-rubl-cur         + bf_tt-allsum.vat-rubl-cur
     4761         bf_tt-allsum-line.vat-base-buyer-cur     = bf_tt-allsum-line.vat-base-buyer-cur   + bf_tt-allsum.vat-base-buyer-cur
     4762         bf_tt-allsum-line.vat-rubl-buyer-cur     = bf_tt-allsum-line.vat-rubl-buyer-cur   + bf_tt-allsum.vat-rubl-buyer-cur
     4763         bf_tt-allsum-line.slt-base-cur           = bf_tt-allsum-line.slt-base-cur         + bf_tt-allsum.slt-base-cur
     4764         bf_tt-allsum-line.slt-rubl-cur           = bf_tt-allsum-line.slt-rubl-cur         + bf_tt-allsum.slt-rubl-cur
     4765         bf_tt-allsum-line.road-tax-base-cur      = bf_tt-allsum-line.road-tax-base-cur    + bf_tt-allsum.road-tax-base-cur
     4766         bf_tt-allsum-line.road-tax-rubl-cur      = bf_tt-allsum-line.road-tax-rubl-cur    + bf_tt-allsum.road-tax-rubl-cur
     4767         bf_tt-allsum-line.excise-base-cur        = bf_tt-allsum-line.excise-base-cur      + bf_tt-allsum.excise-base-cur
     4768         bf_tt-allsum-line.excise-rubl-cur        = bf_tt-allsum-line.excise-rubl-cur      + bf_tt-allsum.excise-rubl-cur
     4769         bf_tt-allsum-line.sum-dsc-base-acc       = bf_tt-allsum-line.sum-dsc-base-acc     + bf_tt-allsum.sum-dsc-base-acc
     4770         bf_tt-allsum-line.sum-dsc-rubl-acc       = bf_tt-allsum-line.sum-dsc-rubl-acc     + bf_tt-allsum.sum-dsc-rubl-acc
     4771         bf_tt-allsum-line.sum-dsc-cli-acc        = bf_tt-allsum-line.sum-dsc-cli-acc      + bf_tt-allsum.sum-dsc-cli-acc
     4772         bf_tt-allsum-line.dsc-base-acc           = bf_tt-allsum-line.dsc-base-acc         + bf_tt-allsum.dsc-base-acc
     4773         bf_tt-allsum-line.dsc-rubl-acc           = bf_tt-allsum-line.dsc-rubl-acc         + bf_tt-allsum.dsc-rubl-acc
     4774         bf_tt-allsum-line.dsc-cli-acc            = bf_tt-allsum-line.dsc-cli-acc          + bf_tt-allsum.dsc-cli-acc
     4775         bf_tt-allsum-line.vat-base-acc           = bf_tt-allsum-line.vat-base-acc         + bf_tt-allsum.vat-base-acc
     4776         bf_tt-allsum-line.vat-rubl-acc           = bf_tt-allsum-line.vat-rubl-acc         + bf_tt-allsum.vat-rubl-acc
     4777         bf_tt-allsum-line.vat-cli-acc            = bf_tt-allsum-line.vat-cli-acc          + bf_tt-allsum.vat-cli-acc
     4778         bf_tt-allsum-line.slt-base-acc           = bf_tt-allsum-line.slt-base-acc         + bf_tt-allsum.slt-base-acc
     4779         bf_tt-allsum-line.slt-rubl-acc           = bf_tt-allsum-line.slt-rubl-acc         + bf_tt-allsum.slt-rubl-acc
     4780         bf_tt-allsum-line.slt-cli-acc            = bf_tt-allsum-line.slt-cli-acc          + bf_tt-allsum.slt-cli-acc
     4781         bf_tt-allsum-line.road-tax-base-acc      = bf_tt-allsum-line.road-tax-base-acc    + bf_tt-allsum.road-tax-base-acc
     4782         bf_tt-allsum-line.road-tax-rubl-acc      = bf_tt-allsum-line.road-tax-rubl-acc    + bf_tt-allsum.road-tax-rubl-acc
     4783         bf_tt-allsum-line.road-tax-cli-acc       = bf_tt-allsum-line.road-tax-cli-acc     + bf_tt-allsum.road-tax-cli-acc
     4784         bf_tt-allsum-line.excise-base-acc        = bf_tt-allsum-line.excise-base-acc      + bf_tt-allsum.excise-base-acc
     4785         bf_tt-allsum-line.excise-rubl-acc        = bf_tt-allsum-line.excise-rubl-acc      + bf_tt-allsum.excise-rubl-acc
     4786         bf_tt-allsum-line.excise-cli-acc         = bf_tt-allsum-line.excise-cli-acc       + bf_tt-allsum.excise-cli-acc
     4787         bf_tt-allsum-line.transport-base-acc     = bf_tt-allsum-line.transport-base-acc   + bf_tt-allsum.transport-base-acc
     4788         bf_tt-allsum-line.transport-rubl-acc     = bf_tt-allsum-line.transport-rubl-acc   + bf_tt-allsum.transport-rubl-acc
     4789         bf_tt-allsum-line.transport-cli-acc      = bf_tt-allsum-line.transport-cli-acc    + bf_tt-allsum.transport-cli-acc
     4790         bf_tt-allsum-line.other-base-acc         = bf_tt-allsum-line.other-base-acc       + bf_tt-allsum.other-base-acc
     4791         bf_tt-allsum-line.other-rubl-acc         = bf_tt-allsum-line.other-rubl-acc       + bf_tt-allsum.other-rubl-acc
     4792         bf_tt-allsum-line.other-cli-acc          = bf_tt-allsum-line.other-cli-acc        + bf_tt-allsum.other-cli-acc
     4793         .
     4794     end.
     4795   end.
     4796   end.
     4797   end procedure.
     4798   define variable vss-include-info41 as character format "X(65)" no-undo
     4799   initial "@(#)$Workfile$ $Revision$".
     4800   define temp-table temp_p-fmt_string-part no-undo
     4801       field str-key       as integer
     4802       field string-part   as character
     4803       index pi is primary unique
     4804           str-key
     4805   .
     4806   define variable v-p-fmt-41-str-key    as integer      no-undo.
     4807   FUNCTION center-field RETURNS INTEGER (INPUT iStartPix AS INTEGER, iEndPix AS INTEGER,
     4808                                     iInput AS INTEGER).
     4809     def var v-start-print as integer no-undo .
     4810     if (iStartPix < 0) or (iEndPix < iStartPix) then return 0.
     4811     assign
     4812       v-start-print = INTEGER(iStartPix + ((iEndPix - iStartPix) / 2) - (iInput / 2))
     4813     .
     4814     RETURN v-start-print .
     4815   END FUNCTION.
     4816   FUNCTION right-field RETURNS INTEGER ( iEndPix AS INTEGER,
     4817                                     iInput AS INTEGER).
     4818     def var v-start-print as integer no-undo .
     4819     assign
     4820       v-start-print = INTEGER(iEndPix - 1 - iInput)
     4821     .
     4822     if v-start-print < 0 then return 0.
     4823     RETURN v-start-print .
     4824   END FUNCTION.
     4825   function p-fmt-align-string returns character (
     4826         p-in-string      as character
     4827       , p-page-width     as integer
     4828       , p-align-type     as character
     4829   ).
     4830       define variable v-string-length     as integer      no-undo.
     4831       define variable v-out-string        as character    no-undo.
     4832       assign
     4833           v-string-length = length( trim( p-in-string ) )
     4834       .
     4835       if v-string-length >= p-page-width
     4836       then do:
     4837           assign
     4838               v-out-string = trim( p-in-string )
     4839           .
     4840       end.
     4841       else do:
     4842           case p-align-type
     4843           :
     4844               when 'left':U
     4845               then do:
     4846                   assign
     4847                       v-out-string = trim( p-in-string )
     4848                   .
     4849               end.
     4850               when 'right':U
     4851               then do:
     4852                   assign
     4853                       v-out-string = fill( " ":U, p-page-width - v-string-length ) + trim( p-in-string )
     4854                   .
     4855               end.
     4856               when 'center':U
     4857               then do:
     4858                   assign
     4859                       v-out-string = fill( " ":U, integer( ( p-page-width - v-string-length ) / 2 ) ) + trim( p-in-string )
     4860                   .
     4861               end.
     4862           end case.
     4863       end.
     4864       return v-out-string .
     4865   end function.
     4866   procedure p-fmt-split-string :
     4867   define input parameter p-source-string  as character        no-undo.
     4868   define input parameter p-split-length   as integer          no-undo.
     4869   define output parameter p-string-1      as character        no-undo.
     4870   define output parameter p-string-2      as character        no-undo.
     4871   do
     4872   on error undo, return error
     4873   :
     4874       define variable v-space-pos    as integer      no-undo.
     4875       if length( p-source-string ) <= p-split-length
     4876       then do:
     4877           assign
     4878               p-string-1 = p-source-string
     4879           .
     4880       end.
     4881       else do:
     4882           assign
     4883               v-space-pos = r-index( p-source-string, " ":U, p-split-length )
     4884           .
     4885           if v-space-pos = 0
     4886           then do:
     4887               assign
     4888                   v-space-pos = index( p-source-string, " ":U )
     4889               .
     4890           end.
     4891           if v-space-pos = 0
     4892           then do:
     4893               assign
     4894                   p-string-1 = substring( p-source-string, 1, p-split-length )
     4895                   p-string-2 = trim( substring( p-source-string, p-split-length, p-split-length ) )
     4896               .
     4897           end.
     4898           else do:
     4899               assign
     4900                   p-string-1 = substring( p-source-string, 1, v-space-pos )
     4901                   p-string-2 = trim( substring( p-source-string, v-space-pos ) )
     4902               .
     4903           end.
     4904       end.
     4905   end.
     4906   end procedure.
     4907   procedure p-fmt-round :
     4908   define input parameter p-qnty               as decimal          no-undo.
     4909   define input parameter p-price-no-VAT       as decimal          no-undo.
     4910   define input parameter p-VAT                as decimal          no-undo.
     4911   define input parameter p-SLT                as decimal          no-undo.
     4912   define input parameter p-road-tax           as decimal          no-undo.
     4913   define output parameter p-new-price-no-VAT  as decimal          no-undo.
     4914   define output parameter p-new-VAT           as decimal          no-undo.
     4915   define output parameter p-new-SLT           as decimal          no-undo.
     4916   define output parameter p-new-sum-VAT       as decimal          no-undo.
     4917   define output parameter p-new-sum-SLT       as decimal          no-undo.
     4918   define output parameter p-new-sum-road-tax  as decimal          no-undo.
     4919   define output parameter p-new-sum-no-VAT    as decimal          no-undo.
     4920   define output parameter p-new-sum-full      as decimal          no-undo.
     4921       define variable v-vat-pc    as decimal      no-undo.
     4922       define variable v-slt-pc    as decimal      no-undo.
     4923   do
     4924   on error undo, return error
     4925   :
     4926       if p-price-no-VAT = 0
     4927       then do:
     4928           assign
     4929               p-new-price-no-VAT = 0.0
     4930               p-new-VAT          = ?
     4931               p-new-SLT          = ?
     4932               p-new-sum-VAT      = 0.0
     4933               p-new-sum-SLT      = 0.0
     4934               p-new-sum-no-VAT   = 0.0
     4935               p-new-sum-road-tax = 0.0
     4936               p-new-sum-full     = 0.0
     4937           .
     4938       end.
     4939       else do:
     4940           assign
     4941               v-vat-pc            = p-VAT / p-price-no-VAT
     4942               v-slt-pc            = p-SLT / ( p-price-no-VAT + p-VAT )
     4943               p-new-price-no-VAT  = round( p-price-no-VAT, 2 )
     4944               p-new-VAT           = round( p-new-price-no-VAT * v-vat-pc, 2 )
     4945               p-new-SLT           = round( ( p-new-price-no-VAT + p-new-VAT ) * v-slt-pc, 2 )
     4946               p-new-sum-VAT       = round( p-new-VAT          * p-qnty, 2 )
     4947               p-new-sum-SLT       = round( ( p-new-price-no-VAT + p-new-VAT ) * p-qnty * v-slt-pc, 2 )
     4948               p-new-sum-no-VAT    = round( p-new-price-no-VAT * p-qnty, 2 )
     4949               p-new-sum-road-tax  = round( p-road-tax * p-qnty, 2 )
     4950               p-new-sum-full      = round( ( p-new-price-no-VAT + p-new-VAT + p-new-SLT + p-road-tax ) * p-qnty, 2 )
     4951           .
     4952       end.
     4953   end.
     4954   end procedure.
     4955   procedure p-fmt-split :
     4956   define input parameter p-in-string      as character        no-undo.
     4957   define input parameter p-split-length   as integer          no-undo.
     4958       define variable v-start-pos     as integer      no-undo.
     4959       define variable v-end-pos       as integer      no-undo.
     4960       define buffer buf_temp_p-fmt_string-part        for temp_p-fmt_string-part.
     4961   do
     4962   for buf_temp_p-fmt_string-part
     4963   on error undo, return error
     4964   :
     4965       empty temp-table buf_temp_p-fmt_string-part.
     4966       if p-split-length < 1
     4967       then do:
     4968           undo, return error substitute( "p-fmt-split: Строка не может быть разбита на &1 частей", p-split-length ).
     4969       end.
     4970       assign
     4971           p-in-string                 = trim( p-in-string )
     4972           v-p-fmt-41-str-key   = 0
     4973           v-start-pos                 = 1
     4974           v-end-pos                   = length( p-in-string )
     4975       .
     4976       run p-fmt-get-string-range in this-procedure (
     4977             input p-in-string
     4978           , input p-split-length
     4979           , input v-start-pos
     4980           , output v-start-pos
     4981           , output v-end-pos
     4982       ).
     4983       do while v-end-pos <> 0
     4984       :
     4985           create buf_temp_p-fmt_string-part.
     4986           assign
     4987               v-p-fmt-41-str-key = v-p-fmt-41-str-key + 1
     4988           .
     4989           assign
     4990               buf_temp_p-fmt_string-part.str-key      = v-p-fmt-41-str-key
     4991               buf_temp_p-fmt_string-part.string-part  = substring( p-in-string, v-start-pos, v-end-pos - v-start-pos )
     4992           .
     4993           assign
     4994               v-start-pos = v-end-pos + 1
     4995           .
     4996           run p-fmt-get-string-range in this-procedure (
     4997                 input p-in-string
     4998               , input p-split-length
     4999               , input v-start-pos
     5000               , output v-start-pos
     5001               , output v-end-pos
     5002           ).
     5003       end.
     5004   end.
     5005   end procedure.
     5006   procedure p-fmt-get-string-range :
     5007   define input parameter p-in-string      as character        no-undo.
     5008   define input parameter p-split-length   as integer          no-undo.
     5009   define input parameter p-old-start-pos  as integer          no-undo.
     5010   define output parameter p-start-pos     as integer          no-undo.
     5011   define output parameter p-end-pos       as integer          no-undo.
     5012       define variable v-init-string    as character    no-undo.
     5013       define variable v-temp-char      as character    no-undo.
     5014       define variable v-temp-pos       as integer      no-undo.
     5015       define variable v-counter        as integer      no-undo.
     5016   do
     5017   on error undo, return error
     5018   :
     5019       assign
     5020           p-start-pos   = p-old-start-pos
     5021           v-init-string = substring( p-in-string, p-start-pos )
     5022       no-error.
     5023       if error-status :error
     5024       or trim( v-init-string ) = "":U
     5025       then do:
     5026           assign
     5027               p-end-pos = 0
     5028           .
     5029           undo, return .
     5030       end.
     5031       assign
     5032           v-temp-char   = substring( v-init-string, 1, 1 )
     5033       .
     5034       do
     5035       while trim( v-temp-char ) = "":U
     5036       :
     5037           assign
     5038               p-start-pos     = p-start-pos + 1
     5039               v-init-string   = substring( p-in-string, p-start-pos )
     5040               v-temp-char     = substring( v-init-string, 1, 1 )
     5041           .
     5042       end.
     5043       assign
     5044           v-temp-pos  = p-split-length
     5045           v-temp-char = substring( v-init-string, v-temp-pos, 1 )
     5046           v-counter   = 0
     5047       .
     5048       search-word-end:
     5049       do
     5050       while trim( v-temp-char ) <> "":U
     5051       :
     5052           assign
     5053               v-counter   = v-counter + 1
     5054           .
     5055           if v-counter > 20
     5056           then do:
     5057               assign
     5058                   v-temp-pos  = p-split-length
     5059               .
     5060               leave search-word-end.
     5061           end.
     5062           assign
     5063               v-temp-pos  = v-temp-pos - 1
     5064               v-temp-char = substring( v-init-string, v-temp-pos, 1 )
     5065           .
     5066       end.
     5067       assign
     5068           p-end-pos = p-start-pos + v-temp-pos - 1
     5069       .
     5070   end.
     5071   end procedure.
     5072   define temp-table temp-font no-undo
     5073     field fontnum  as integer
     5074     field fontname as character
     5075     field fontsize as character
     5076     field fonttype as character
     5077     field font-h   as integer
     5078     field font-w   as integer
     5079     field v-row    as integer
     5080     field v-col    as integer
     5081     field v-row-lans as integer
     5082     field v-col-lans as integer
     5083   index pi fontnum
     5084   .
     5085   procedure get-font-ini :
     5086     do
     5087     on error undo, return error return-value
     5088     :
     5089   define variable ii as integer   no-undo .
     5090   define variable v-font7 as character no-undo .
     5091   define variable v-font as character no-undo .
     5092   define variable loc-name as character no-undo .
     5093   define variable loc-size as character no-undo .
     5094   define variable loc-type as character no-undo .
     5095   define variable old_H as integer   no-undo .
     5096   define variable old_w as integer   no-undo .
     5097   define variable old-row  as integer   no-undo .
     5098   define variable old-col  as integer   no-undo .
     5099   define variable old-row-lans  as integer   no-undo .
     5100   define variable old-col-lans  as integer   no-undo .
     5101   define variable vv as integer   no-undo .
     5102   empty temp-table temp-font.
     5103     GET-KEY-VALUE SECTION "fonts" KEY "font7" VALUE v-font7 .
     5104       case num-entries (v-font7) :
     5105         when 4 then do:
     5106             assign
     5107               loc-name = entry ( 1 , v-font7 )
     5108               loc-size = entry ( 2 , v-font7 )
     5109               loc-type = entry ( 3 , v-font7 ) + "," +  entry ( 4 , v-font7 )
     5110             .
     5111         end.
     5112         when 3 then do:
     5113             assign
     5114               loc-name = entry ( 1 , v-font7 )
     5115               loc-size = entry ( 2 , v-font7 )
     5116               loc-type = entry ( 3 , v-font7 )
     5117             .
     5118         end.
     5119         when 2 then  do:
     5120             assign
     5121               loc-name = entry ( 1 , v-font7 )
     5122               loc-size = entry ( 2 , v-font7 )
     5123               loc-type = ""
     5124             .
     5125         end.
     5126         when 1 then do:
     5127             assign
     5128               loc-name = trim(entry ( 1 , v-font7 ))
     5129               loc-size = ""
     5130               loc-type = ""
     5131             .
     5132         end.
     5133       end case.
     5134     create temp-font.
     5135     assign
     5136       temp-font.fontnum  = 7
     5137       temp-font.fontname = trim(loc-name)
     5138       temp-font.fontsize = trim(loc-size)
     5139       temp-font.fonttype = trim(loc-type)
     5140       temp-font.v-row    = 62
     5141       temp-font.v-col    = 136
     5142       temp-font.v-row-lans = 43
     5143       temp-font.v-col-lans = 198
     5144     .
     5145     repeat ii = 16 to 100 :
     5146       get-key-value section 'fonts' key 'font' + string(ii)   value v-font  .
     5147       if v-font = "" or v-font = ? then leave.
     5148       case num-entries (v-font) :
     5149         when 4 then do:
     5150             assign
     5151               loc-name = entry ( 1 , v-font )
     5152               loc-size = entry ( 2 , v-font )
     5153               loc-type = entry ( 3 , v-font ) + "," +  entry ( 4 , v-font )
     5154             .
     5155         end.
     5156         when 3 then do:
     5157             assign
     5158               loc-name = entry ( 1 , v-font )
     5159               loc-size = entry ( 2 , v-font )
     5160               loc-type = entry ( 3 , v-font )
     5161             .
     5162         end.
     5163         when 2 then do:
     5164             assign
     5165               loc-name = entry ( 1 , v-font )
     5166               loc-size = entry ( 2 , v-font )
     5167               loc-type = ""
     5168             .
     5169         end.
     5170         when 1 then do:
     5171             assign
     5172               loc-name = trim(entry ( 1 , v-font ))
     5173               loc-size = ""
     5174               loc-type = ""
     5175             .
     5176         end.
     5177       end case.
     5178     create temp-font.
     5179     assign
     5180       temp-font.fontnum  = ii
     5181       temp-font.fontname = trim(loc-name)
     5182       temp-font.fontsize = trim(loc-size)
     5183       temp-font.fonttype = trim(loc-type)
     5184     .
     5185     end.
     5186       for each temp-font :
     5187          vv = integer(entry(2,temp-font.fontsize, "=" )) no-error .
     5188          if  vv = ? then vv =  0 .
     5189           run rep/exfont.p (
     5190             input   temp-font.fontname ,
     5191             input   vv ,
     5192             input   temp-font.fonttype ,
     5193             output  temp-font.font-h   ,
     5194             output  temp-font.font-w   )
     5195           .
     5196       end.
     5197   find first temp-font where  temp-font.fontnum  = 7  .
     5198   old_H = temp-font.font-H .
     5199   old_w = temp-font.font-W .
     5200   old-row = temp-font.v-row .
     5201   old-col = temp-font.v-col .
     5202   old-row-lans = temp-font.v-row-lans .
     5203   old-col-lans = temp-font.v-col-lans .
     5204       for each temp-font where
     5205                temp-font.fontnum  <> 7 :
     5206           assign
     5207               temp-font.v-row    = old_H * old-row / temp-font.font-h
     5208               temp-font.v-col    = old_W * old-col / temp-font.font-W
     5209               temp-font.v-row-lans    = old_H * old-row-lans / temp-font.font-h
     5210               temp-font.v-col-lans    = old_W * old-col-lans / temp-font.font-W
     5211           .
     5212       end.
     5213     end.
     5214   end procedure.
     5215   PROCEDURE How-name :
     5216   define input  parameter h as integer no-undo .
     5217   define input  parameter w as integer no-undo .
     5218   define output parameter n as character  no-undo .
     5219   define variable A4port-H as integer   no-undo init 63.
     5220   define variable A4port-W as integer   no-undo init 136.
     5221   define variable A4lans-H as integer   no-undo init 43.
     5222   define variable A4lans-W as integer   no-undo init 198.
     5223   define variable Strim-W  as integer   no-undo init 278.
     5224   run define-a4-size (
     5225        input ReportFontNum
     5226       ,output A4port-H
     5227       ,output A4port-W
     5228       ,output A4lans-H
     5229       ,output A4lans-W ).
     5230   If w >= 1 and w <= A4port-W Then DO:
     5231     If h >= 1  and h <= A4lans-H Then n = "A4-lans":U.
     5232     If h > A4lans-H  and h <= A4port-H Then n = "A4-port":U.
     5233     If h > A4port-H              Then n = "to-file":U.
     5234   End.
     5235   If w > A4port-W and w <= A4lans-W Then DO:
     5236     If h >= 1  and h <= A4lans-H Then n = "A4-lans":U.
     5237     If h > A4lans-H  and h <= A4port-H Then n = "A3-lans":U.
     5238     If h > A4port-H              Then n = "to-file":U.
     5239   End.
     5240   If w > A4lans-W and w <= Strim-W Then DO:
     5241     If h >= 1  and h <= A4lans-H Then n = "to-file":U.
     5242     If h > A4lans-H  and h <= A4port-H Then n = "A3-lans":U.
     5243     If h > A4port-H              Then n = "to-file":U.
     5244   End.
     5245   If w > Strim-W Then DO:
     5246      n = "to-file":U.
     5247   End.
     5248   END PROCEDURE.
     5249   PROCEDURE define-a4-size :
     5250   define input  parameter p-ReportFontNum as integer   no-undo .
     5251   define output parameter A4port-H as integer   no-undo .
     5252   define output parameter A4port-W as integer   no-undo .
     5253   define output parameter A4lans-H as integer   no-undo .
     5254   define output parameter A4lans-W as integer   no-undo .
     5255   if not can-find (first temp-font ) then do:
     5256      run get-font-ini .
     5257   end.
     5258   find first temp-font where temp-font.fontnum = p-ReportFontNum no-error .
     5259   if available temp-font then do:
     5260   assign
     5261     A4port-H = temp-font.v-row
     5262     A4port-W = temp-font.v-col
     5263     A4lans-H = temp-font.v-row-lans
     5264     A4lans-W = temp-font.v-col-lans
     5265   .
     5266   end.
     5267   else do:
     5268   assign
     5269     A4port-H = 63
     5270     A4port-W = 136
     5271     A4lans-H = 43
     5272     A4lans-W = 198
     5273   .
     5274   end.
     5275   END PROCEDURE.
     5276   define buffer buf_parts         for ub.parts.
     5277   define buffer buf_goods         for ub.goods.
     5278   define buffer buf_cli-gds       for ub.cli-gds.
     5279   define buffer buf_trn-doc       for ub.trn-doc.
     5280   define buffer buf_doc-line      for ub.doc-line.
     5281   define buffer buf_temp-gds      for temp-gds.
     5282   define stream out-stream.
     5283   define variable v-line                    as  character     no-undo.
     5284   define variable g#report-num              as integer        no-undo .
     5285   define variable v-counter                 as integer        no-undo .
     5286   define variable v-vardate                 as date           no-undo .
     5287   define variable v-end-fact-order          as decimal        no-undo .
     5288   define variable v-shift-end-fact-order    as decimal        no-undo .
     5289   define variable v-day-end-fact-order      as decimal        no-undo .
     5290   define variable v-alc-db-num              as integer        no-undo .
     5291   define variable v-alc-mark-code           as character      no-undo .
     5292   define variable v-alc-bottling-date       as date           no-undo .
     5293   define variable v-alc-refAB-path          as character      no-undo .
     5294   define variable v-alc-qualitycert-path    as character      no-undo .
     5295   define variable v-alc-certif-path         as character      no-undo .
     5296   define variable v-alc-comment             as character      no-undo .
     5297   define variable v-curr-grp-name           as character      no-undo .
     5298   define variable v-obj-code                as integer        no-undo .
     5299   define variable v-obj-type                as character      no-undo .
     5300   define variable v-repfrm-str              as character      no-undo .
     5301   define variable v-print-rubl              as logical        no-undo .
     5302   define variable v-total-price             as decimal        no-undo .
     5303   define variable v-total-sum-noNDS         as decimal        no-undo .
     5304   define variable v-total-sum-withNDS       as decimal        no-undo .
     5305   define variable v-cli-code                as integer        no-undo .
     5306   define variable v-cli-type                as character      no-undo .
     5307   define variable v-sub-total-sum-noNDS     as decimal        no-undo .
     5308   define variable v-sub-total-sum-withNDS   as decimal        no-undo .
     5309   define variable v-sub-total-qnty          like temp-parts.fact-qnty no-undo .
     5310   def SHARED temp-table g#post-f NO-UNDO
     5311       field obj-type like ub.clients.obj-type
     5312       field obj-code like ub.clients.obj-code
     5313       field obj-name like ub.clients.obj-name
     5314       field grp-code like ub.clients.grp-code
     5315       field grp-name like ub.clients.grp-name
     5316       field lvl-num like  ub.cli-grp.lvl-num
     5317       INDEX pi IS UNIQUE PRIMARY obj-type obj-code
     5318       INDEX p1  obj-name
     5319       .
     5320   define temp-table temp-str no-undo
     5321     field doc-code      like ub.doc-line.doc-code
     5322     field artic         like ub.doc-line.artic
     5323     field prod-type     like ub.doc-line.prod-type
     5324     field prod-code     like ub.doc-line.prod-code
     5325     field gds-code      like ub.goods.gds-code
     5326     field gds-name      like ub.goods.gds-name
     5327     field fact-date     like ub.trn-doc.fact-date
     5328     field cli-code      like ub.trn-doc.cli-code
     5329     field cli-type      like ub.trn-doc.cli-type
     5330     field cli-name      like ub.trn-doc.cli-name
     5331     field fact-qnty     like ub.doc-line.fact-qnty
     5332     field price         as decimal
     5333     field sum-noNDS     as decimal
     5334     field sum-withNDS   as decimal
     5335     index pi is primary doc-code artic prod-type prod-code
     5336     index cli cli-code cli-type gds-code fact-date
     5337   .
     5338   define frame f-doc
     5339     sym1 column-label ":!:!" format "X(1)" space (0)
     5340     temp-str.gds-code column-label "Код товара! " format "999999999" space(0)
     5341     sym2 column-label ":!:!" format "X(1)" space (0)
     5342     temp-str.gds-name column-label "Наименование! " format "X(40)" space(0)
     5343     sym3 column-label ":!:!" format "X(1)" space (0)
     5344     temp-str.doc-code column-label "Документ!прихода" format "X(14)" space(0)
     5345     sym4 column-label ":!:!" format "X(1)" space (0)
     5346     temp-str.fact-date column-label "Дата поставки! " format "99.99.99" space(0)
     5347     sym5 column-label ":!:!" format "X(1)" space (0)
     5348     temp-str.fact-qnty column-label "Количество! " format "->>,>>>,>>9.999" space(0)
     5349     sym6 column-label ":!:!" format "X(1)" space (0)
     5350     temp-str.price column-label "Цена! " format "->>,>>>,>>9.99" space(0)
     5351     sym7 column-label ":!:!" format "X(1)" space (0)
     5352     temp-str.sum-noNDS column-label "Сумма без НДС! " format "->>,>>>,>>9.99" space(0)
     5353     sym8 column-label ":!:!" format "X(1)" space (0)
     5354     temp-str.sum-withNDS column-label "Сумма c НДС! " format "->>,>>>,>>9.99" space(0)
     5355     sym9 column-label ":!:!" format "X(1)" space (0)
     5356   header
     5357     string( "Страница " + string( PAGE-NUMBER( out-stream ), ">>>9" ) ) at 117 format "X(13)" skip
     5358     v-line format "X(153)" at 1
     5359   with width 160 down stream-io .
     5360   form header
     5361           v-line format "X(153)" at 1 SKIP
     5362           "Продолжение - на следующей странице" at 1 SKIP
     5363   with frame BottomFrame width 160 PAGE-BOTTOM NO-LABELS NO-BOX .
     5364   assign
     5365     v-line = fill( "-" , 300 )
     5366   .
     5367   form with frame f-doc.
     5368   for each temp-str:
     5369     delete temp-str.
     5370   end.
     5371   for each temp-gds:
     5372     delete temp-gds.
     5373   end.
     5374   run get-report-num in my-handle (output g#report-num).
     5375   output stream out-stream to value( string( session:temp-directory +
     5376                                        "rpt" + string( g#report-num ) ) )
     5377                                        page-size  value(ReportPageHeight) .
     5378   case x-SET_val_TYPE :
     5379     when 1 then do:
     5380       assign
     5381         v-print-rubl = yes
     5382       .
     5383     end.
     5384     when 2 then do:
     5385       assign
     5386         v-print-rubl = no
     5387       .
     5388     end.
     5389     otherwise do:
     5390       message "Неизвестный тип валюты!" skip "Отчет формируется в базовой валюте" view-as alert-box information .
     5391       assign
     5392         v-print-rubl = no
     5393       .
     5394     end.
     5395   end case.
     5396   assign
     5397     v-counter = 0
     5398   .
     5399   define variable v-account as integer init 0 no-undo .
     5400   define variable v-account-lavel as character no-undo .
     5401   define variable v-button-stop as logical no-undo .
     5402   define variable v-kol-spice as integer no-undo .
     5403   define variable v-kol-spice2 as integer no-undo .
     5404   define variable v-kol-spice3 as integer no-undo .
     5405   DEFINE VARIABLE StopProcessing AS LOGICAL NO-UNDO.
     5406   DEFINE BUTTON StopBtn AUTO-END-KEY
     5407        LABEL "Стоп"
     5408        SIZE 10 BY 1.
     5409   DEFINE VARIABLE RecordsDone AS INTEGER FORMAT ">,>>>,>>>,>>9":U INITIAL 0
     5410        LABEL "Обработано записей"
     5411         VIEW-AS TEXT
     5412        SIZE 14 BY .67 NO-UNDO.
     5413   DEFINE VARIABLE RecordsString AS CHARACTER FORMAT "X(60)"
     5414         VIEW-AS TEXT
     5415        SIZE 53.25 BY .67
     5416        FGCOLOR 1  NO-UNDO.
     5417   DEFINE VARIABLE RecordsString2 AS CHARACTER FORMAT "X(60)"
     5418         VIEW-AS TEXT
     5419        SIZE 53.25 BY .67
     5420        FGCOLOR 1  NO-UNDO.
     5421   DEFINE VARIABLE RecordsString3 AS CHARACTER FORMAT "X(60)"
     5422         VIEW-AS TEXT
     5423        SIZE 53.25 BY .67
     5424        FGCOLOR 1  NO-UNDO.
     5425   DEFINE RECTANGLE RECT-1
     5426        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     5427        SIZE 55.13 BY 4.46.
     5428   DEFINE FRAME InfoFrame
     5429        StopBtn AT ROW 4.25 COL 21.75
     5430        RecordsString AT ROW 1.21 COL 2 NO-LABEL
     5431        RecordsString2 AT ROW 1.96 COL 2 NO-LABEL
     5432        RecordsString3 AT ROW 2.58 COL 2 NO-LABEL
     5433        RecordsDone AT ROW 3.42 COL 24.88 COLON-ALIGNED
     5434        RECT-1 AT ROW 1 COL 1
     5435       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     5436            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     5437            TITLE "Процесс"
     5438            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
     5439   define variable mFrameView      as logical   no-undo init yes.
     5440     define variable mFramHandle as handle no-undo.
     5441     mFramHandle = frame InfoFrame:handle.
     5442     if  log-manager:logfile-name ne ?
     5443     then DO:
     5444         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     5445         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     5446         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
     5447     end.
     5448     mFrameView = not session:batch-mode and mFramHandle:visible.
     5449     if mFrameView
     5450     then do:
     5451       ASSIGN
     5452          FRAME InfoFrame:HIDDEN                           = TRUE
     5453          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
     5454     end.
     5455   ON CHOOSE OF StopBtn IN FRAME InfoFrame
     5456   DO:
     5457     IF not StopProcessing THEN
     5458       Message "Вы действительно хотите прервать" SKIP
     5459               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
     5460                 UPDATE StopProcessing.
     5461     IF StopProcessing THEN do:
     5462        if mFrameView
     5463        then do:
     5464           HIDE FRAME InfoFrame.
     5465        end.
     5466     End.
     5467   END.
     5468   run create-temp-str in this-procedure no-error .
     5469   view stream out-stream frame BottomFrame.
     5470   run print-header in this-procedure no-error.
     5471   for each temp-str no-lock
     5472     break by temp-str.cli-code
     5473           by temp-str.cli-type
     5474           by temp-str.gds-code
     5475           by temp-str.fact-date
     5476   :
     5477     accumulate
     5478       temp-str.sum-noNDS    (TOTAL)
     5479       temp-str.sum-withNDS  (TOTAL)
     5480     .
     5481   IF ( v-counter modulo v-account = 0 )  then DO:
     5482    Assign
     5483       v-kol-spice = (50 - LENGTH(v-repfrm-str)) / 2
     5484       RecordsString = fill(' ',v-kol-spice) + string(v-repfrm-str)
     5485       .
     5486             if  log-manager:logfile-name ne ?
     5487             then DO:
     5488                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     5489             end.
     5490              if mFrameView
     5491              then do:
     5492               DISPLAY
     5493                 v-counter @ RecordsDone
     5494                 RecordsString   @ RecordsString
     5495                 WITH FRAME InfoFrame.
     5496              end.
     5497   End.
     5498      if v-button-stop then  DO:
     5499            if mFrameView
     5500            then
     5501               PROCESS EVENTS.
     5502            IF StopProcessing THEN DO:
     5503            RETURN error.
     5504            End.
     5505      end.
     5506     if v-cli-code <> temp-str.cli-code or v-cli-type <> temp-str.cli-type then do:
     5507       assign
     5508         v-cli-code = temp-str.cli-code
     5509         v-cli-type = temp-str.cli-type
     5510       .
     5511       run print-sub-itog in this-procedure
     5512                    ( input v-sub-total-qnty
     5513                    , input v-sub-total-sum-noNDS
     5514                    , input v-sub-total-sum-withNDS
     5515                    )
     5516                    no-error.
     5517       run print-supplier in this-procedure no-error.
     5518       assign
     5519         v-sub-total-qnty        = 0
     5520         v-sub-total-sum-noNDS   = 0
     5521         v-sub-total-sum-withNDS = 0
     5522       .
     5523     end.
     5524     run print-line in this-procedure no-error.
     5525     assign
     5526       v-counter               = v-counter               + 1
     5527       v-sub-total-qnty        = v-sub-total-qnty        + temp-str.fact-qnty
     5528       v-sub-total-sum-noNDS   = v-sub-total-sum-noNDS   + temp-str.sum-noNDS
     5529       v-sub-total-sum-withNDS = v-sub-total-sum-withNDS + temp-str.sum-withNDS
     5530     .
     5531   end.
     5532   if mFrameView
     5533   then do:
     5534      HIDE FRAME InfoFrame.
     5535   end.
     5536   for each temp-gds:
     5537     delete temp-gds.
     5538   end.
     5539   for each temp-str:
     5540     delete temp-str.
     5541   end.
     5542   assign
     5543     v-total-sum-noNDS   = accum TOTAL temp-str.sum-noNDS
     5544     v-total-sum-withNDS = accum TOTAL temp-str.sum-withNDS
     5545   .
     5546   run print-sub-itog in this-procedure
     5547                 ( input v-sub-total-qnty
     5548                 , input v-sub-total-sum-noNDS
     5549                 , input v-sub-total-sum-withNDS
     5550                 )
     5551                    no-error .
     5552   run print-itog in this-procedure
     5553                 ( input v-total-sum-noNDS
     5554                 , input v-total-sum-withNDS
     5555                 )
     5556                 no-error .
     5557   hide stream out-stream frame BottomFrame.
     5558   if Make-Excel then output stream ForExcel close.
     5559   output stream out-stream close.
     5560   define variable v-user-action   as character no-undo .
     5561   define variable v-printed       as logical   no-undo .
     5562   define variable DisabledOptions as integer   no-undo .
     5563   define variable v-orient-page as character no-undo .
     5564   run How-name in this-procedure (
     5565       input ReportPageHeight,
     5566       input ReportPageWidth,
     5567       output v-orient-page )
     5568       .
     5569   if v-orient-page = "A4-lans":U then DisabledOptions = 8 .
     5570                                  else DisabledOptions = 0 .
     5571   run gbl/prnfilen.w
     5572       (input  ""
     5573       ,input  DisabledOptions
     5574       ,input  string(session :temp-directory) + "rpt" + string( g#report-num )
     5575       ,input  ReportFontNum
     5576       ,output v-user-action
     5577       ,output v-printed
     5578       ) .
     5579   end.
     5580   procedure create-temp-str :
     5581   do
     5582   on error undo, return error return-value
     5583   :
     5584   case x-SelectGood :
     5585     when 1 then do:
     5586   define variable vss-include-info42 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5587   assign v-account = ( if integer( 1 ) = 0 then 100 else integer( 1 ) ).
     5588     if  log-manager:logfile-name ne ?
     5589     then DO:
     5590         log-manager:write-message("ON mFrameView=" + string(mFrameView), "frameRepError").
     5591     end.
     5592     if not session:batch-mode then
     5593     do:
     5594       VIEW FRAME InfoFrame.
     5595       mFrameView = true.
     5596     end.
     5597      v-button-stop = false .
     5598         if mFrameView
     5599         then do:
     5600         if v-button-stop then view STOPBTN in frame InfoFrame.
     5601                          else Hide STOPBTN in frame InfoFrame.
     5602         end.
     5603   assign
     5604     v-repfrm-str = "Расчет по объектам..."
     5605   .
     5606   IF ( v-counter modulo v-account = 0 )  then DO:
     5607    Assign
     5608       v-kol-spice = (50 - LENGTH(v-repfrm-str)) / 2
     5609       RecordsString = fill(' ',v-kol-spice) + string(v-repfrm-str)
     5610       .
     5611             if  log-manager:logfile-name ne ?
     5612             then DO:
     5613                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     5614             end.
     5615              if mFrameView
     5616              then do:
     5617               DISPLAY
     5618                 v-counter @ RecordsDone
     5619                 RecordsString   @ RecordsString
     5620                 WITH FRAME InfoFrame.
     5621              end.
     5622   End.
     5623      if v-button-stop then  DO:
     5624            if mFrameView
     5625            then
     5626               PROCESS EVENTS.
     5627            IF StopProcessing THEN DO:
     5628            RETURN error.
     5629            End.
     5630      end.
     5631   for each obj-list no-lock,
     5632       each buf_goods no-lock,
     5633       first ub.gds-obj no-lock
     5634           where ub.gds-obj.obj-type  = obj-list.obj-type
     5635             and ub.gds-obj.obj-code  = obj-list.obj-code
     5636             and ub.gds-obj.artic     = buf_goods.artic
     5637             and ub.gds-obj.prod-type = buf_goods.prod-type
     5638             and ub.gds-obj.prod-code = buf_goods.prod-code
     5639             by obj-list.obj-code
     5640             by obj-list.obj-type
     5641   :
     5642     if v-obj-code <> obj-list.obj-code or v-obj-type <> obj-list.obj-type then do:
     5643       assign
     5644         v-obj-code    = obj-list.obj-code
     5645         v-obj-type    = obj-list.obj-type
     5646         v-counter     = 0
     5647         v-repfrm-str  = "Расчет по объекту " + obj-list.obj-name + " (" + string( obj-list.obj-code ) + ")"
     5648       .
     5649   IF ( v-counter modulo v-account = 0 )  then DO:
     5650    Assign
     5651       v-kol-spice = (50 - LENGTH(v-repfrm-str)) / 2
     5652       RecordsString = fill(' ',v-kol-spice) + string(v-repfrm-str)
     5653       .
     5654             if  log-manager:logfile-name ne ?
     5655             then DO:
     5656                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     5657             end.
     5658              if mFrameView
     5659              then do:
     5660               DISPLAY
     5661                 v-counter @ RecordsDone
     5662                 RecordsString   @ RecordsString
     5663                 WITH FRAME InfoFrame.
     5664              end.
     5665   End.
     5666      if v-button-stop then  DO:
     5667            if mFrameView
     5668            then
     5669               PROCESS EVENTS.
     5670            IF StopProcessing THEN DO:
     5671            RETURN error.
     5672            End.
     5673      end.
     5674     end.
     5675     for each buf_trn-doc no-lock
     5676           where buf_trn-doc.obj-type     = obj-list.obj-type
     5677             and buf_trn-doc.obj-code     = obj-list.obj-code
     5678             and buf_trn-doc.status_      = 'факт':U
     5679             and buf_trn-doc.fact-date   >= X-date-start
     5680             and buf_trn-doc.fact-date   <= X-date-end
     5681             and buf_trn-doc.ext-doc-type = 'ie':U,
     5682         each buf_doc-line no-lock
     5683           where buf_doc-line.doc-code    = buf_trn-doc.doc-code
     5684             and buf_doc-line.artic       = buf_goods.artic
     5685             and buf_doc-line.prod-type   = buf_goods.prod-type
     5686             and buf_doc-line.prod-code   = buf_goods.prod-code
     5687     :
     5688     assign
     5689       v-counter = v-counter + 1
     5690     .
     5691   IF ( v-counter modulo v-account = 0 )  then DO:
     5692    Assign
     5693       v-kol-spice = (50 - LENGTH(v-repfrm-str)) / 2
     5694       RecordsString = fill(' ',v-kol-spice) + string(v-repfrm-str)
     5695       .
     5696             if  log-manager:logfile-name ne ?
     5697             then DO:
     5698                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     5699             end.
     5700              if mFrameView
     5701              then do:
     5702               DISPLAY
     5703                 v-counter @ RecordsDone
     5704                 RecordsString   @ RecordsString
     5705                 WITH FRAME InfoFrame.
     5706              end.
     5707   End.
     5708      if v-button-stop then  DO:
     5709            if mFrameView
     5710            then
     5711               PROCESS EVENTS.
     5712            IF StopProcessing THEN DO:
     5713            RETURN error.
     5714            End.
     5715      end.
     5716     find first g#post-f no-lock
     5717       where g#post-f.obj-code = buf_trn-doc.cli-code
     5718         and g#post-f.obj-type = buf_trn-doc.cli-type
     5719         no-error .
     5720     if p-RADpost = 1 or available g#post-f then do:
     5721     run clcprtsl_calc-line (recid(buf_doc-line)).
     5722     find first tt-allsum-line where tt-allsum-line.sum-type = 'основная_сумма':U no-error.
     5723     if error-status:error then do:
     5724       message substitute ("Не найдена запись по типу &1 для товара &2 &3 &4 в документе &5. ", 'основная_сумма':U, buf_doc-line.artic, buf_doc-line.prod-type, buf_doc-line.prod-code, buf_doc-line.doc-code) view-as alert-box error .
     5725     end.
     5726     create temp-str.
     5727     assign
     5728       temp-str.doc-code     = buf_doc-line.doc-code
     5729       temp-str.artic        = buf_doc-line.artic
     5730       temp-str.prod-type    = buf_doc-line.prod-type
     5731       temp-str.prod-code    = buf_doc-line.prod-code
     5732       temp-str.gds-code     = buf_goods.gds-code
     5733       temp-str.gds-name     = buf_goods.gds-name
     5734       temp-str.fact-date    = buf_trn-doc.fact-date
     5735       temp-str.cli-code     = buf_trn-doc.cli-code
     5736       temp-str.cli-type     = buf_trn-doc.cli-type
     5737       temp-str.cli-name     = buf_trn-doc.cli-name
     5738       temp-str.fact-qnty    = buf_doc-line.fact-qnty
     5739     .
     5740     if available tt-allsum-line then do:
     5741       assign
     5742         temp-str.price        = if v-print-rubl = yes then
     5743                                   ( tt-allsum-line.sum-dsc-rubl-doc / tt-allsum-line.fact-qnty )
     5744                                 else
     5745                                   ( tt-allsum-line.sum-dsc-base-doc / tt-allsum-line.fact-qnty )
     5746         temp-str.sum-noNDS    = if v-print-rubl = yes then
     5747                                   ( tt-allsum-line.sum-dsc-rubl-doc - tt-allsum-line.vat-rubl-doc - tt-allsum-line.slt-rubl-doc )
     5748                                 else
     5749                                   ( tt-allsum-line.sum-dsc-base-doc - tt-allsum-line.vat-base-doc - tt-allsum-line.slt-base-doc )
     5750         temp-str.sum-withNDS  = if v-print-rubl = yes then
     5751                                   ( tt-allsum-line.sum-dsc-rubl-doc )
     5752                                 else
     5753                                   ( tt-allsum-line.sum-dsc-base-doc )
     5754       .
     5755     end.
     5756     else do:
     5757       assign
     5758         temp-str.price        = 0
     5759         temp-str.sum-noNDS    = 0
     5760         temp-str.sum-withNDS  = 0
     5761       .
     5762     end.
     5763     end.
     5764    end.
     5765   end.
     5766   if mFrameView
     5767   then do:
     5768      HIDE FRAME InfoFrame.
     5769   end.
     5770     end.
     5771     when 2 then do:
     5772       for each tmp#grp no-lock
     5773       :
     5774         run grplib-get-full-name in this-procedure( input tmp#grp.node-code, output v-curr-grp-name ) .
     5775         for each buf_goods no-lock
     5776               where buf_goods.grp-name begins v-curr-grp-name
     5777         :
     5778           find first temp-gds no-lock
     5779             where temp-gds.artic     = buf_goods.artic
     5780               and temp-gds.prod-type = buf_goods.prod-type
     5781               and temp-gds.prod-code = buf_goods.prod-code
     5782             no-error .
     5783           if not available temp-gds then do:
     5784             create temp-gds.
     5785             buffer-copy buf_goods to temp-gds no-error.
     5786           end.
     5787         end.
     5788       end.
     5789   define variable vss-include-info43 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5790   assign v-account = ( if integer( 1 ) = 0 then 100 else integer( 1 ) ).
     5791     if  log-manager:logfile-name ne ?
     5792     then DO:
     5793         log-manager:write-message("ON mFrameView=" + string(mFrameView), "frameRepError").
     5794     end.
     5795     if not session:batch-mode then
     5796     do:
     5797       VIEW FRAME InfoFrame.
     5798       mFrameView = true.
     5799     end.
     5800      v-button-stop = false .
     5801         if mFrameView
     5802         then do:
     5803         if v-button-stop then view STOPBTN in frame InfoFrame.
     5804                          else Hide STOPBTN in frame InfoFrame.
     5805         end.
     5806   assign
     5807     v-repfrm-str = "Расчет по объектам..."
     5808   .
     5809   IF ( v-counter modulo v-account = 0 )  then DO:
