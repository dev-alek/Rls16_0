     6784       sheetf.Excel-Column-Lable =
     6785       "Код товара" + chr(44) +
     6786       "Наменование"  + chr(44) +
     6787       "Документ прихода"  + chr(44) +
     6788       "Дата поставки"  + chr(44) +
     6789       "Количество" + chr(44) +
     6790       "Цена" + chr(44) +
     6791       "Сумма без НДС" + chr(44) +
     6792       "Сумма с НДС"
     6793       sheetf.sizes =
     6794       "20"  + chr(44) +
     6795       "40"  + chr(44) +
     6796       "15"  + chr(44) +
     6797       "15"  + chr(44) +
     6798       "15"  + chr(44) +
     6799       "15"  + chr(44) +
     6800       "15"  + chr(44) +
     6801       "15"
     6802       Sheetf.colformat = "1=@;2=@;3=@;4=dd/mm/yy;5=0,00;6=0,00;7=0,00;8=0,00;"
     6803     .
     6804     run rep/extitle.p (1).
     6805   end.
     6806   end procedure.
     6807   procedure print-line :
     6808   define variable v-gds-name                as character      no-undo .
     6809   do
     6810   on error undo, return error return-value
     6811   :
     6812       if length( temp-str.gds-name ) > 40 then
     6813       do:
     6814         assign
     6815           v-gds-name = substitute( "&1>" , substring( temp-str.gds-name , 1 , (40 - 1) ) )
     6816         .
     6817       end.
     6818       else do:
     6819         assign
     6820           v-gds-name = temp-str.gds-name
     6821         .
     6822       end.
     6823     display stream out-stream
     6824       sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9
     6825       temp-str.gds-code
     6826       v-gds-name @ temp-str.gds-name
     6827       temp-str.doc-code
     6828       temp-str.fact-date
     6829       temp-str.fact-qnty
     6830       temp-str.price
     6831       temp-str.sum-noNDS
     6832       temp-str.sum-withNDS
     6833     with frame f-doc.
     6834     down stream out-stream with frame f-doc.
     6835     if Make-Excel then  put   stream ForExcel unformatted
     6836       temp-str.gds-code                           CHR(9)
     6837       temp-str.gds-name                           CHR(9)
     6838       temp-str.doc-code                           CHR(9)
     6839       temp-str.fact-date    format "99.99.99"     CHR(9)
     6840       temp-str.fact-qnty                          CHR(9)
     6841       temp-str.price        format ">>>>>>>>9.99" CHR(9)
     6842       temp-str.sum-noNDS    format ">>>>>>>>9.99" CHR(9)
     6843       temp-str.sum-withNDS  format ">>>>>>>>9.99" CHR(9)
     6844     skip.
     6845   end.
     6846   end procedure.
     6847   procedure print-supplier :
     6848   do
     6849   on error undo, return error return-value
     6850   :
     6851       if line-counter( out-stream ) + 4 > page-size( out-stream ) then page stream out-stream .
     6852       put stream out-stream v-line at 1 format "X(153)" skip .
     6853       display stream out-stream
     6854         temp-str.cli-code @ temp-str.gds-code
     6855         temp-str.cli-name @ temp-str.gds-name
     6856       with frame f-doc.
     6857       down stream out-stream with frame f-doc.
     6858       put stream out-stream v-line at 1 format "X(153)" skip .
     6859       if Make-Excel then  put   stream ForExcel unformatted
     6860         temp-str.cli-code     CHR(9)
     6861         temp-str.cli-name     CHR(9)
     6862         " "                   CHR(9)
     6863         " "                   CHR(9)
     6864         " "                   CHR(9)
     6865         " "                   CHR(9)
     6866         " "                   CHR(9)
     6867         " "                   CHR(9)
     6868       skip.
     6869   end.
     6870   end procedure.
     6871   procedure print-sub-itog :
     6872   define input  parameter p-sub-total-qnty        like ub.parts.fact-qnty no-undo .
     6873   define input  parameter p-sub-total-sum-noNDS   as decimal format ">>>>>>>>9.99"  no-undo .
     6874   define input  parameter p-sub-total-sum-withNDS as decimal format ">>>>>>>>9.99"  no-undo .
     6875   do
     6876   on error undo, return error return-value
     6877   :
     6878       if line-counter( out-stream ) + 4 > page-size( out-stream ) then page stream out-stream .
     6879       if p-sub-total-qnty > 0 then do:
     6880           put stream out-stream v-line at 1 format "X(153)" skip.
     6881           display stream out-stream
     6882             sym1 sym2 sym5 sym6 sym8 sym9
     6883             "Итого по товарам"          @ temp-str.gds-code
     6884             p-sub-total-qnty            @ temp-str.fact-qnty
     6885             p-sub-total-sum-noNDS       @ temp-str.sum-noNDS
     6886             p-sub-total-sum-withNDS     @ temp-str.sum-withNDS
     6887           with frame f-doc.
     6888           down stream out-stream with frame f-doc.
     6889           if Make-Excel then  put   stream ForExcel unformatted
     6890             "Итого по товарам"                            CHR(9)
     6891             " "                                           CHR(9)
     6892             " "                                           CHR(9)
     6893             " "                                           CHR(9)
     6894             p-sub-total-qnty                              CHR(9)
     6895             " "                                           CHR(9)
     6896             p-sub-total-sum-noNDS   format ">>>>>>>>9.99" CHR(9)
     6897             p-sub-total-sum-withNDS format ">>>>>>>>9.99" CHR(9)
     6898           skip(1).
     6899       end.
     6900   end.
     6901   end procedure.
     6902   procedure print-itog :
     6903   define input  parameter p-total-sum-noNDS   as decimal format ">>>>>>>>9.99"  no-undo .
     6904   define input  parameter p-total-sum-withNDS as decimal format ">>>>>>>>9.99"  no-undo .
     6905   do
     6906   on error undo, return error return-value
     6907   :
     6908     if line-counter( out-stream ) + 3 > page-size( out-stream ) then do:
     6909       page stream out-stream.
     6910     end.
     6911     put stream out-stream v-line at 1 format "X(153)".
     6912     display stream out-stream
     6913       sym1 sym2 sym8 sym9
     6914       "Итого по поставщикам"  @ temp-str.gds-code
     6915       p-total-sum-noNDS       @ temp-str.sum-noNDS
     6916       p-total-sum-withNDS     @ temp-str.sum-withNDS
     6917     with frame f-doc.
     6918     put stream out-stream v-line at 1 format "X(153)".
     6919     if Make-Excel then  put   stream ForExcel unformatted
     6920     skip(2)
     6921       "Итого по поставщикам"                    CHR(9)
     6922       " "                                       CHR(9)
     6923       " "                                       CHR(9)
     6924       " "                                       CHR(9)
     6925       " "                                       CHR(9)
     6926       " "                                       CHR(9)
     6927       p-total-sum-noNDS   format ">>>>>>>>9.99" CHR(9)
     6928       p-total-sum-withNDS format ">>>>>>>>9.99" CHR(9)
     6929     skip.
     6930   end.
     6931   end procedure.
