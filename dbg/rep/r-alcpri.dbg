     1898           "v-max-fact-order" v-max-fact-order skip
     1899           view-as alert-box error .
     1900         undo, return error .
     1901       end.
     1902     end.
     1903   end procedure.
     1904   procedure partslib-update-by-factord :
     1905     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
     1906     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
     1907     define input parameter p-artic              like ub.parts.artic     no-undo .
     1908     define input parameter p-prod-type          like ub.parts.prod-type no-undo .
     1909     define input parameter p-prod-code          like ub.parts.prod-code no-undo .
     1910     define input parameter p-start-fact-order   as decimal   no-undo .
     1911     define input parameter p-end-fact-order     as decimal   no-undo .
     1912     define input parameter p-lock-gds-obj       as logical   no-undo .
     1913     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-factord: определение партий свободной зоны на любую дату".
