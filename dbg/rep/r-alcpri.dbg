     1250   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1251   procedure factord :
     1252     define input  parameter p-fact-date            as date    no-undo .
     1253     define input  parameter p-fact-time            as integer no-undo .
     1254     define input  parameter p-fact-num             as integer no-undo .
     1255     define input  parameter p-shift-date           as date    no-undo .
     1256     define input  parameter p-shift-num            as integer no-undo .
     1257     define input  parameter p-shift-on             as logical no-undo .
     1258     define output parameter p-fact-order           as decimal no-undo .
     1259     define output parameter p-shift-end-fact-order as decimal no-undo .
     1260     define output parameter p-day-end-fact-order   as decimal no-undo .
     1261     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
     1262     if p-fact-date = ?
     1263     then do:
     1264       return error "Не указана фактическая дата" .
     1265     end.
     1266     define variable v-fact-date-num as integer no-undo .
     1267     assign
     1268       v-fact-date-num = integer(p-fact-date)
     1269     .
     1270     if p-fact-num = ?
     1271     or p-fact-num = 0
     1272     then do:
     1273       return error "Не задан p-fact-num " + string(p-fact-num) .
     1274     end.
     1275     if p-fact-num < 0
     1276     then do:
     1277       return error "Отрицательный fact-num " + string(p-fact-num) .
     1278     end.
     1279     if p-fact-num >= 100000000
     1280     then do:
     1281       return error "Недопустимо большой fact-num " + string(p-fact-num) .
     1282     end.
     1283     if p-shift-on = true
     1284     then do:
     1285       if p-shift-date = ?
     1286       then do:
     1287         return error "Не задана дата смены" .
     1288       end.
     1289       if p-shift-num = ?
     1290       or p-shift-num = 0
     1291       then do:
     1292         return error "Не задан номер смены" .
     1293       end.
     1294     end.
     1295     else do:
     1296       assign
     1297         p-shift-date = p-fact-date
     1298         p-shift-num  = 24
     1299       .
     1300     end.
     1301     define variable v-shift-offset as integer no-undo .
     1302     if p-shift-date = p-fact-date
     1303     then do:
     1304       assign
     1305         v-shift-offset = 1
     1306       .
     1307     end.
     1308     if p-shift-date < p-fact-date
     1309     then do:
     1310       assign
     1311         v-shift-offset = 0
     1312       .
     1313     end.
     1314     if p-shift-date > p-fact-date
     1315     then do:
     1316       message
     1317         vss-workfile vss-revision vss-description skip
     1318         "Неправильная дата закрытия смены" skip
     1319         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
     1320         view-as alert-box error .
     1321       undo, return error
     1322         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
     1323           ,string(p-fact-date, '99/99/9999':U)
     1324           ,string(p-shift-date, '99/99/9999':U)
     1325           )
     1326       .
     1327     end.
     1328     if p-shift-num < 1
     1329     or p-shift-num > 24
     1330     then do:
     1331       message
     1332         vss-workfile vss-revision vss-description skip
     1333         "Неправильный номер смены" skip
     1334         "p-shift-num" p-shift-num skip
     1335         view-as alert-box error .
     1336       undo, return error return-value .
     1337     end.
     1338     assign
     1339       p-fact-order           = v-fact-date-num
     1340                              + v-shift-offset * 0.5
     1341                              + p-shift-num    * 0.02 - 0.01
     1342                              + p-fact-num     * 0.0000000001
     1343       p-shift-end-fact-order = v-fact-date-num
     1344                              + v-shift-offset * 0.5
     1345                              + p-shift-num    * 0.02
     1346       p-day-end-fact-order   = v-fact-date-num
     1347                              + 0.99
     1348     .
     1349     if p-fact-order           <= v-fact-date-num
     1350     or p-shift-end-fact-order <= v-fact-date-num
     1351     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
     1352     or p-shift-end-fact-order >= p-day-end-fact-order
     1353     then do:
     1354       message
     1355         vss-workfile vss-revision vss-description skip
     1356         "Внутренняя ошибка при генерации фактического номера" skip
     1357         "p-fact-date"            p-fact-date            skip
     1358         "p-fact-time"            p-fact-time            skip
     1359         "p-fact-num"             p-fact-num             skip
     1360         "p-shift-date"           p-shift-date           skip
     1361         "p-shift-num"            p-shift-num            skip
     1362         "p-shift-on"             p-shift-on             skip
     1363         "p-shift-end-fact-order" p-shift-end-fact-order skip
     1364         "p-day-end-fact-order"   p-day-end-fact-order   skip
     1365         "v-fact-date-num"        v-fact-date-num        skip
     1366         view-as alert-box error .
     1367       undo, return error return-value .
     1368     end.
     1369   end procedure.
     1370   procedure day-begin-fact-order :
     1371     define input  parameter p-fact-date            as date    no-undo .
     1372     define output parameter p-day-begin-fact-order as decimal no-undo .
     1373     do
     1374     on error undo, return error return-value
     1375     :
     1376       if p-fact-date = ?
     1377       then do:
     1378         assign
     1379           p-day-begin-fact-order = 0
     1380         .
     1381       end.
     1382       else do:
     1383         assign
     1384           p-day-begin-fact-order = integer(p-fact-date)
     1385         .
     1386       end.
     1387     end.
     1388   end procedure.
     1389   procedure factord-max-fact-order :
     1390     define output parameter p-max-fact-order as decimal   no-undo .
     1391     do
     1392     on error undo, return error return-value
     1393     :
     1394       run day-begin-fact-order in this-procedure
     1395         (input  date(1, 1, 5000)
     1396         ,output p-max-fact-order
     1397         ) .
     1398     end.
     1399   end procedure.
     1400   procedure factord-cut-archive :
     1401     define input  parameter p-obj-type             as character no-undo .
     1402     define input  parameter p-obj-code             as integer   no-undo .
     1403     define input  parameter p-fact-date            as date      no-undo .
     1404     define output parameter p-shift-on             as logical   no-undo .
     1405     define output parameter p-shift-date           as date      no-undo .
     1406     define output parameter p-shift-num            as integer   no-undo .
     1407     define output parameter p-day-end-fact-order   as decimal   no-undo .
     1408     define output parameter p-shift-end-fact-order as decimal   no-undo .
     1409     define variable v-fact-order as decimal   no-undo .
     1410     define buffer buf_shift-obj for ub.shift-obj .
     1411     do
     1412     on error undo, return error return-value
     1413     :
     1414   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1415   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1416     (input  p-obj-type
     1417     ,input  p-obj-code
     1418     ,input  'shift-on=request'
     1419     ,output p-shift-on
     1420     ) no-error .
     1421       if error-status :error
     1422       then do:
     1423         message
     1424           vss-workfile vss-revision vss-description skip
     1425           "Ошибка при определении атрибута объекта" skip
     1426           "Объект" p-obj-type p-obj-code skip
     1427           error-status :get-message(1) skip
     1428           return-value skip
     1429           view-as alert-box error .
     1430         undo, return error return-value .
     1431       end.
     1432       if p-shift-on = false
     1433       then do:
     1434         assign
     1435           p-shift-date               = ?
     1436           p-shift-num                = 0
     1437         .
     1438       end.
     1439       else do:
     1440         find first buf_shift-obj share-lock
     1441           where buf_shift-obj.obj-type   = p-obj-type
     1442             and buf_shift-obj.obj-code   = p-obj-code
     1443             and buf_shift-obj.shift-date > p-fact-date
     1444           use-index pi
     1445           no-error .
     1446         if not available buf_shift-obj
     1447         or buf_shift-obj.status_ <> 'зкр':U
     1448         then do:
     1449           message
     1450             vss-workfile vss-revision vss-description skip
     1451             "Невозможно вычислить последнюю смену" skip
     1452             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
     1453             "Объект" p-obj-type p-obj-code skip
     1454             "Дата" p-fact-date skip
     1455             view-as alert-box error .
     1456           undo, return error return-value .
     1457         end.
     1458         find last buf_shift-obj share-lock
     1459           where buf_shift-obj.obj-type = p-obj-type
     1460             and buf_shift-obj.obj-code = p-obj-code
     1461             and buf_shift-obj.shift-date <= p-fact-date
     1462           use-index pi
     1463           no-error .
     1464         if available buf_shift-obj
     1465         then do:
     1466           if  buf_shift-obj.status_ = 'зкр':U
     1467           then do:
     1468             assign
     1469               p-shift-date = buf_shift-obj.shift-date
     1470               p-shift-num  = buf_shift-obj.shift-num
     1471             .
     1472           end.
     1473           else do:
     1474             message
     1475               vss-workfile vss-revision vss-description skip
     1476               "Невозможно вычислить последнюю смену" skip
     1477               "Статус смены отличен от статуса" 'зкр':U skip
     1478               "Объект" p-obj-type p-obj-code skip
     1479               "Дата" p-fact-date skip
     1480               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     1481               view-as alert-box error .
     1482             undo, return error return-value .
     1483           end.
     1484         end.
     1485         else do:
     1486           assign
     1487             p-shift-date = p-fact-date - 1
     1488             p-shift-num  = 1
     1489           .
     1490         end.
     1491       end.
     1492       run factord in this-procedure
     1493         (input  p-fact-date
     1494         ,input  1
     1495         ,input  1
     1496         ,input  p-shift-date
     1497         ,input  p-shift-num
     1498         ,input  p-shift-on
     1499         ,output v-fact-order
     1500         ,output p-shift-end-fact-order
     1501         ,output p-day-end-fact-order
     1502         ) no-error .
     1503       if error-status :error
     1504       then do:
     1505         message
     1506           vss-workfile vss-revision vss-description skip
     1507           "Ошибка при вызове процедуры factord"
     1508           error-status :get-message(1) skip
     1509           return-value skip
     1510           view-as alert-box error .
     1511         undo, return error return-value .
     1512       end.
     1513     end.
     1514   end procedure.
     1515   procedure factord-lock-shift :
     1516     define input  parameter p-obj-type  as character no-undo .
     1517     define input  parameter p-obj-code  as integer   no-undo .
     1518     define input  parameter p-fact-date as date      no-undo .
     1519     define parameter buffer buf_shift-obj for ub.shift-obj .
     1520     define variable v-shift-on      as logical   no-undo .
     1521     define variable v-extra-message as character no-undo .
     1522     define variable v-error as character no-undo .
     1523     do
     1524     on error undo, return error return-value
     1525     :
     1526   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1527   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1528     (input  p-obj-type
     1529     ,input  p-obj-code
     1530     ,input  'shift-on=request'
     1531     ,output v-shift-on
     1532     ) no-error .
     1533       if error-status :error
     1534       then do:
     1535         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     1536         undo, return error v-error .
     1537       end.
     1538       if v-shift-on = true
     1539       then do:
     1540         find first buf_shift-obj share-lock
     1541           where buf_shift-obj.obj-type   = p-obj-type
     1542             and buf_shift-obj.obj-code   = p-obj-code
     1543             and buf_shift-obj.shift-date > p-fact-date
     1544           use-index pi
     1545           no-error .
     1546         if not available buf_shift-obj
     1547         or buf_shift-obj.status_ <> 'зкр':U
     1548         then do:
     1549           find last buf_shift-obj
     1550             where buf_shift-obj.obj-type = p-obj-type
     1551               and buf_shift-obj.obj-code = p-obj-code
     1552               and buf_shift-obj.status_  = 'зкр':U
     1553             use-index stts
     1554             no-error .
     1555           if available buf_shift-obj
     1556           then do:
     1557             assign
     1558               v-extra-message =
     1559                     substitute("Дата начала последеней закрытой смены на объекте &1"
     1560                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     1561                               )
     1562             .
     1563           end.
     1564           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     1565           undo, return error v-error .
     1566         end.
     1567       end.
     1568     end.
     1569   end procedure.
     1570   procedure factord-end-day :
     1571     define input  parameter p-fact-date            as date    no-undo .
     1572     define output parameter p-day-end-fact-order   as decimal no-undo .
     1573     do
     1574     on error undo, return error return-value
     1575     :
     1576       if p-fact-date = ?
     1577       then do:
     1578         return error "Не указана фактическая дата" .
     1579       end.
     1580       assign
     1581         p-day-end-fact-order = integer(p-fact-date) + 0.99
     1582       .
     1583     end.
     1584   end procedure.
     1585   procedure factord-to-date :
     1586     define input  parameter p-fact-order as decimal no-undo .
     1587     define output parameter p-fact-date  as date    no-undo .
     1588     define variable v-ref-date  as date      no-undo .
     1589     define variable v-ref-delta as integer   no-undo .
     1590     do
     1591     on error undo, return error return-value
     1592     :
     1593       if p-fact-order = ?
     1594       or p-fact-order = 0
     1595       then do:
     1596         return error "Не указан fact-order" .
     1597       end.
     1598       assign
     1599         v-ref-date  = date(1, 1, 2000)
     1600       .
     1601       assign
     1602         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     1603       .
     1604       assign
     1605         p-fact-date = v-ref-date + v-ref-delta
     1606       .
     1607     end.
     1608   end procedure.
     1609   procedure factord-to-fact-num :
     1610     define input  parameter p-fact-order as decimal no-undo .
     1611     define output parameter p-fact-num   as integer no-undo .
     1612     define variable v-fact-order-trunc as decimal no-undo .
     1613     do
     1614     on error undo, return error return-value
     1615     :
     1616       if p-fact-order = ?
     1617       or p-fact-order = 0
     1618       then do:
     1619         return error "Не указан fact-order" .
     1620       end.
     1621       assign
     1622        v-fact-order-trunc = truncate(p-fact-order, 2)
     1623       .
     1624       assign
     1625         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     1626       .
     1627     end.
     1628   end procedure.
     1629   procedure factord-to-shift-num :
     1630     define input  parameter p-fact-order as decimal no-undo .
     1631     define output parameter p-shift-num   as integer no-undo .
     1632     define variable  p-shift-numd  as decimal   no-undo .
     1633     define variable v-fact-order-trunc as decimal no-undo .
     1634     do
     1635     on error undo, return error return-value
     1636     :
     1637       if p-fact-order = ?
     1638       or p-fact-order = 0
     1639       then do:
     1640         return error "Не указан fact-order" .
     1641       end.
     1642       assign
     1643        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     1644       .
     1645       if v-fact-order-trunc < 0.5 then do:
     1646         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     1647       end.
     1648       assign
     1649         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     1650         .
     1651        assign
     1652         p-shift-num = truncate (p-shift-numd , 0)
     1653       .
     1654     end.
     1655   end procedure.
     1656   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1657   define temp-table temp-parts no-undo   like ub.parts   field free-qnty as decimal   field free-cli-qnty as decimal .
     1658   procedure partslib-clear-temp-parts :
     1659     define buffer buf_temp-parts for temp-parts .
     1660     do
     1661     on error undo, return error
     1662     :
     1663       for each buf_temp-parts
     1664       on error undo, return error
     1665       :
     1666         delete buf_temp-parts .
     1667       end.
     1668     end.
     1669   end procedure.
     1670   procedure partslib-create-temp-parts :
     1671     define parameter buffer buf_parts       for ub.parts .
     1672     define parameter buffer buf_temp-parts  for temp-parts .
     1673     define input  parameter p-goods-twounit as logical   no-undo .
     1674     define variable v-base-part-code as character no-undo .
     1675     do
     1676     on error undo, return error
     1677     :
     1678       if p-goods-twounit = true
     1679       then do:
     1680         assign
     1681           v-base-part-code = entry(1, buf_parts.part-code, '#':U)
     1682         .
     1683       end.
     1684       else do:
     1685         assign
     1686           v-base-part-code = buf_parts.part-code
     1687         .
     1688       end.
     1689       find first buf_temp-parts exclusive-lock
     1690         where buf_temp-parts.obj-type  = buf_parts.obj-type
     1691           and buf_temp-parts.obj-code  = buf_parts.obj-code
     1692           and buf_temp-parts.artic     = buf_parts.artic
     1693           and buf_temp-parts.prod-type = buf_parts.prod-type
     1694           and buf_temp-parts.prod-code = buf_parts.prod-code
     1695           and buf_temp-parts.in-code   = buf_parts.in-code
     1696           and buf_temp-parts.out-code  = 'free-zone':U
     1697           and buf_temp-parts.part-code = v-base-part-code
     1698         no-error.
     1699       if not available buf_temp-parts
     1700       then do:
     1701         create buf_temp-parts .
     1702         buffer-copy buf_parts to buf_temp-parts
     1703         assign
     1704           buf_temp-parts.out-code  = 'free-zone':U
     1705           buf_temp-parts.part-code = v-base-part-code
     1706           buf_temp-parts.rsrv-free = yes
     1707           buf_temp-parts.status_   = no
     1708           buf_temp-parts.qnty      = 0
     1709           buf_temp-parts.fact-qnty = 0
     1710           buf_temp-parts.real-qnty = 0
     1711           buf_temp-parts.cli-qnty  = 0
     1712         .
     1713       end.
     1714     end.
     1715   end procedure.
     1716   procedure partslib-init-temp-parts :
     1717     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
     1718     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
     1719     define input parameter p-artic           like ub.parts.artic     no-undo .
     1720     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
     1721     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
     1722     define buffer buf_parts      for ub.parts .
     1723     define buffer buf_temp-parts for temp-parts .
     1724     define variable v-goods-twounit    as logical   no-undo .
     1725     do
     1726     on error undo, return error
     1727     :
     1728   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1729   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     1730     (input  p-artic
     1731     ,input  p-prod-type
     1732     ,input  p-prod-code
     1733     ,input  'twounit=request':u
     1734     ,output v-goods-twounit
     1735     ) no-error .
     1736       if error-status :error
     1737       then do:
     1738         message
     1739           vss-workfile vss-revision vss-description skip
     1740           vss-include-info17 skip
     1741           "Ошибка при определении атрибута товара" skip
     1742           "Артикул" p-artic p-prod-type p-prod-code skip
     1743           "twounit=request" skip
     1744           error-status :get-message(1) skip
     1745           return-value skip
     1746           view-as alert-box error .
     1747         undo, return error return-value .
     1748       end.
     1749       run partslib-clear-temp-parts in this-procedure .
     1750       for each buf_parts
     1751         where buf_parts.obj-type  = p-obj-type
     1752           and buf_parts.obj-code  = p-obj-code
     1753           and buf_parts.artic     = p-artic
     1754           and buf_parts.prod-type = p-prod-type
     1755           and buf_parts.prod-code = p-prod-code
     1756           and buf_parts.rsrv-free = yes
     1757           and buf_parts.status_   = no
     1758           and buf_parts.in-code   <> buf_parts.out-code
     1759       on error undo, return error
     1760       :
     1761         run partslib-create-temp-parts in this-procedure
     1762           (buffer buf_parts
     1763           ,buffer buf_temp-parts
     1764           ,input  v-goods-twounit
     1765           ) .
     1766         define variable v-parts-qnty          as decimal   no-undo .
     1767         define variable v-parts-cli-qnty      as decimal   no-undo .
     1768         define variable v-parts-free-qnty     as decimal   no-undo .
     1769         define variable v-parts-free-cli-qnty as decimal   no-undo .
     1770         if buf_parts.out-code = 'free-zone':U
     1771         then do:
     1772           assign
     1773             v-parts-qnty          = buf_parts.qnty
     1774             v-parts-cli-qnty      = buf_parts.cli-qnty
     1775             v-parts-free-qnty     = buf_parts.qnty
     1776             v-parts-free-cli-qnty = buf_parts.cli-qnty
     1777           .
     1778         end.
     1779         else do:
     1780           assign
     1781             v-parts-qnty          = abs(buf_parts.qnty)
     1782             v-parts-cli-qnty      = abs(buf_parts.cli-qnty)
     1783             v-parts-free-qnty     = 0
     1784             v-parts-free-cli-qnty = 0
     1785           .
     1786         end.
     1787         assign
     1788           buf_temp-parts.qnty          = buf_temp-parts.qnty          + v-parts-qnty
     1789           buf_temp-parts.fact-qnty     = buf_temp-parts.fact-qnty     + v-parts-qnty
     1790           buf_temp-parts.real-qnty     = 0
     1791           buf_temp-parts.cli-qnty      = buf_temp-parts.cli-qnty      + v-parts-cli-qnty
     1792           buf_temp-parts.free-qnty     = buf_temp-parts.free-qnty     + v-parts-free-qnty
     1793           buf_temp-parts.free-cli-qnty = buf_temp-parts.free-cli-qnty + v-parts-free-cli-qnty
     1794         .
     1795       end.
     1796     end.
     1797   end procedure.
     1798   procedure partslib-init-temp-parts-by-factord :
     1799     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
     1800     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
