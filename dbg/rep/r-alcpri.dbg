     1849           vss-include-info17 skip
     1850           "Ошибка при инициализации текущего остатка по партиям свободной зоны" skip
     1851           "Объект" p-obj-type p-obj-code skip
     1852           "Артикул" p-artic p-prod-type p-prod-code skip
     1853           "p-fact-order" p-fact-order skip
     1854           view-as alert-box error .
     1855         undo, return error .
     1856       end.
     1857       if p-include-fact-order = true
     1858       then do:
