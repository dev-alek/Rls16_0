     1189   define variable sym4  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1190   define variable sym5  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1191   define variable sym6  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1192   define variable sym7  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1193   define variable sym8  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1194   define variable sym9  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1195   define variable sym10 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1196   define variable sym11 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1197   define variable sym12 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1198   define variable sym13 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1199   define variable sym14 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1200   define variable sym15 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1201   define variable sym16 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1202   define variable sym17 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1203   define variable sym18 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1204   define variable sym19 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1205   define variable sym20 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1206   define variable sym21 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
     1207   define variable sym22 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
     1208   define variable sym23 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
     1209   define variable sym24 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
     1210   define variable sym25 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
     1211   define variable sym26 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
     1212   define variable sym27 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
     1213   define variable temp1 as integer   no-undo.
     1214   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1215   define  temp-table temp-gds no-undo like ub.goods
     1216     field qnty   as decimal
