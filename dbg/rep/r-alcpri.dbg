     1918     define variable v-goods-twounit    as logical   no-undo .
     1919     do
     1920     on error undo, return error
     1921     :
     1922       if p-start-fact-order > p-end-fact-order
     1923       then do:
     1924         message
     1925           vss-workfile vss-revision vss-description skip
     1926           vss-include-info17 skip
     1927           "Ошибка задания входных параметров" skip
     1928           "Начало интервала превышает конец интервала" skip
     1929           "Объект" p-obj-type p-obj-code skip
     1930           "Артикул" p-artic p-prod-type p-prod-code skip
     1931           "p-start-fact-order" p-start-fact-order skip
     1932           "p-end-fact-order"   p-end-fact-order skip
     1933           view-as alert-box error .
     1934         undo, return error .
     1935       end.
     1936       if p-lock-gds-obj = true
     1937       then do:
     1938         do transaction
     1939         on error undo, return error
     1940         :
     1941   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1942   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     1943     (input  p-obj-type
     1944     ,input  p-obj-code
     1945     ,input  p-artic
     1946     ,input  p-prod-type
     1947     ,input  p-prod-code
     1948     ,buffer buf_gds-obj
     1949     ) no-error .
     1950           if error-status :error
     1951           then do:
     1952             message
     1953               vss-workfile vss-revision vss-description skip
     1954               vss-include-info17 skip
     1955               "Невозможно найти gds-obj" skip
     1956               error-status :get-message(1) skip
     1957               return-value skip
     1958               view-as alert-box error .
     1959             undo, return error .
     1960           end.
     1961           find current buf_gds-obj exclusive-lock .
     1962         end.
     1963       end.
     1964   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1965   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     1966     (input  p-artic
     1967     ,input  p-prod-type
     1968     ,input  p-prod-code
     1969     ,input  'gds-goods=request':u
     1970     ,output v-goods-gds-goods
     1971     ) no-error .
     1972       if error-status :error
     1973       then do:
     1974         message
     1975           vss-workfile vss-revision vss-description skip
     1976           vss-include-info17 skip
     1977           "Ошибка при определении атрибута товара" skip
     1978           "Артикул" p-artic p-prod-type p-prod-code skip
     1979           "gds-goods=request" skip
     1980           error-status :get-message(1) skip
     1981           return-value skip
     1982           view-as alert-box error .
     1983         undo, return error return-value .
     1984       end.
     1985   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1986   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     1987     (input  p-artic
     1988     ,input  p-prod-type
     1989     ,input  p-prod-code
     1990     ,input  'twounit=request':u
     1991     ,output v-goods-twounit
     1992     ) no-error .
     1993       if error-status :error
     1994       then do:
     1995         message
     1996           vss-workfile vss-revision vss-description skip
     1997           vss-include-info17 skip
     1998           "Ошибка при определении атрибута товара" skip
     1999           "Артикул" p-artic p-prod-type p-prod-code skip
     2000           "twounit=request" skip
     2001           error-status :get-message(1) skip
     2002           return-value skip
     2003           view-as alert-box error .
     2004         undo, return error return-value .
     2005       end.
     2006       for each buf_doc-line no-lock
     2007         where buf_doc-line.obj-type   = p-obj-type
     2008           and buf_doc-line.obj-code   = p-obj-code
     2009           and buf_doc-line.artic      = p-artic
     2010           and buf_doc-line.prod-type  = p-prod-type
     2011           and buf_doc-line.prod-code  = p-prod-code
     2012           and buf_doc-line.status_    = 'факт':U
     2013           and buf_doc-line.fact-order > p-start-fact-order
     2014           and buf_doc-line.fact-order <= p-end-fact-order
     2015       on error undo, return error
     2016       :
     2017         run partslib-process-document in this-procedure
     2018           (input  buf_doc-line.doc-code
     2019           ,input  p-obj-type
     2020           ,input  p-obj-code
     2021           ,input  p-artic
     2022           ,input  p-prod-type
     2023           ,input  p-prod-code
     2024           ,input  v-goods-gds-goods
     2025           ,input  v-goods-twounit
     2026           ,output v-total-parts-qnty
     2027           ) no-error .
     2028         if error-status :error
     2029         then do:
     2030           message
     2031             vss-workfile vss-revision vss-description skip
     2032             vss-include-info17 skip
     2033             "Ошибка при вызове процедуры partslib-process-document" skip
     2034             "Документ" buf_doc-line.doc-code skip
     2035             "Объект" p-obj-type p-obj-code skip
     2036             "Артикул" p-artic p-prod-type p-prod-code skip
     2037             "p-start-fact-order" p-start-fact-order skip
     2038             "p-end-fact-order" p-end-fact-order skip
     2039             error-status :get-message(1) skip
     2040             return-value skip
     2041             view-as alert-box error .
     2042           undo, return error return-value .
     2043         end.
     2044       end.
     2045     end.
     2046   end procedure.
     2047   procedure partslib-process-document :
     2048     define input  parameter p-doc-code         as character no-undo .
     2049     define input  parameter p-obj-type         as character no-undo .
     2050     define input  parameter p-obj-code         as integer   no-undo .
     2051     define input  parameter p-artic            as character no-undo .
     2052     define input  parameter p-prod-type        as character no-undo .
     2053     define input  parameter p-prod-code        as integer   no-undo .
     2054     define input  parameter p-goods-gds-goods  as logical   no-undo .
     2055     define input  parameter p-goods-twounit    as logical   no-undo .
     2056     define output parameter p-total-parts-qnty as decimal   no-undo .
     2057     define variable v-parts-sign as integer   no-undo .
     2058     define buffer buf_trn-doc    for ub.trn-doc .
     2059     define buffer buf_doc-line   for ub.doc-line .
     2060     define buffer buf_parts      for ub.parts .
     2061     define buffer buf_temp-parts for temp-parts .
     2062     do
     2063     on error undo, return error return-value
     2064     :
     2065       find first buf_trn-doc no-lock
     2066         where buf_trn-doc.doc-code = p-doc-code
     2067         no-error .
     2068       if not available buf_trn-doc
     2069       then do:
     2070         undo, return error substitute("Ошибка при поиске документа. Документ &1"
     2071                                      ,p-doc-code
     2072                                      ) .
     2073       end.
     2074       case buf_trn-doc.doc-type
     2075       :
     2076         when 'при':U or
     2077         when 'возврат':U or
     2078         when 'инв':U
     2079         then do:
     2080           assign
     2081             v-parts-sign = -1
     2082           .
     2083         end.
     2084         when 'рас':U or
     2085         when 'спи':U
     2086         then do:
     2087           assign
     2088             v-parts-sign = 1
     2089           .
     2090         end.
     2091         otherwise do:
     2092           undo, return error substitute("Неизвестный тип документа &1"
     2093                                       ,buf_trn-doc.doc-type
     2094                                       ) .
     2095         end.
     2096       end.
     2097       find first buf_doc-line no-lock
     2098         where buf_doc-line.doc-code  = p-doc-code
     2099           and buf_doc-line.artic     = p-artic
     2100           and buf_doc-line.prod-type = p-prod-type
     2101           and buf_doc-line.prod-code = p-prod-code
     2102         no-error .
     2103       if not available buf_doc-line
     2104       then do:
     2105         undo, return error substitute("Ошибка при поиске строки документа. Документ &1. Артикул &2 &3 &4"
     2106                                      ,p-doc-code
     2107                                      ,artic
     2108                                      ,prod-type
     2109                                      ,prod-code
     2110                                      ) .
     2111       end.
     2112       assign
     2113         p-total-parts-qnty = 0
     2114       .
     2115       if p-goods-gds-goods = true
     2116       then do:
     2117         for each buf_parts no-lock
     2118           where buf_parts.out-code  = p-doc-code
     2119             and buf_parts.obj-type  = p-obj-type
     2120             and buf_parts.obj-code  = p-obj-code
     2121             and buf_parts.artic     = p-artic
     2122             and buf_parts.prod-type = p-prod-type
     2123             and buf_parts.prod-code = p-prod-code
     2124         on error undo, return error
     2125         :
     2126           run partslib-create-temp-parts in this-procedure
     2127             (buffer buf_parts
     2128             ,buffer buf_temp-parts
     2129             ,input  p-goods-twounit
     2130             ) .
     2131           assign
     2132             p-total-parts-qnty        = p-total-parts-qnty
     2133                                       + v-parts-sign * buf_parts.fact-qnty
     2134             buf_temp-parts.qnty       = buf_temp-parts.qnty
     2135                                       + v-parts-sign * buf_parts.fact-qnty
     2136             buf_temp-parts.fact-qnty  = buf_temp-parts.fact-qnty
     2137                                       + v-parts-sign * buf_parts.fact-qnty
     2138             buf_temp-parts.cli-qnty   = buf_temp-parts.cli-qnty
     2139                                       + v-parts-sign * buf_parts.cli-qnty
     2140           .
     2141           if buf_temp-parts.qnty = 0
     2142           then do:
     2143             delete buf_temp-parts .
     2144           end.
     2145         end.
     2146       end.
     2147       else do:
     2148         assign
     2149           p-total-parts-qnty = p-total-parts-qnty
     2150                              + v-parts-sign * buf_doc-line.fact-qnty
     2151         .
     2152       end.
     2153     end.
     2154   end procedure.
     2155   procedure partslib-init-temp-parts-by-date :
     2156     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
     2157     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
     2158     define input parameter p-artic           like ub.parts.artic     no-undo .
     2159     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
     2160     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
     2161     define input parameter p-fact-date       as date      no-undo .
     2162     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-date: определение партий свободной зоны на любую дату".
     2163     do
     2164     on error undo, return error
     2165     :
     2166       define variable v-fact-order                as decimal   no-undo .
     2167       define variable v-shift-end-fact-order      as decimal   no-undo .
     2168       define variable v-day-end-fact-order        as decimal   no-undo .
     2169       run factord in this-procedure
     2170         (input  p-fact-date
     2171         ,input  1
     2172         ,input  1
     2173         ,input  ?
     2174         ,input  0
     2175         ,input  false
     2176         ,output v-fact-order
     2177         ,output v-shift-end-fact-order
     2178         ,output v-day-end-fact-order
     2179         ) no-error .
     2180       if error-status :error
     2181       then do:
     2182         message
     2183           vss-workfile vss-revision vss-description skip
     2184           vss-include-info17 skip
     2185           "Ошибка при определении момента времени, на который требуется остаток" skip
     2186           "Объект" p-obj-type p-obj-code skip
     2187           "Артикул" p-artic p-prod-type p-prod-code skip
     2188           "Дата" p-fact-date skip
     2189           view-as alert-box error .
     2190         undo, return error .
     2191       end.
     2192       run partslib-init-temp-parts-by-factord in this-procedure
     2193         (input p-obj-type
     2194         ,input p-obj-code
     2195         ,input p-artic
     2196         ,input p-prod-type
     2197         ,input p-prod-code
     2198         ,input v-day-end-fact-order
     2199         ,input false
     2200         ) no-error .
     2201       if error-status :error
     2202       then do:
     2203         message
     2204           vss-workfile vss-revision vss-description skip
     2205           vss-include-info17 skip
     2206           "Ошибка при вызове метода partslib-init-temp-parts-by-factord" skip
     2207           "Объект" p-obj-type p-obj-code skip
     2208           "Артикул" p-artic p-prod-type p-prod-code skip
     2209           "Дата" p-fact-date skip
     2210           view-as alert-box error .
     2211         undo, return error .
     2212       end.
     2213     end.
     2214   end procedure.
     2215   procedure partslib-calc-cost :
     2216     define output parameter p-fact-qnty      as decimal   no-undo .
     2217     define output parameter p-vat-pc         as decimal   no-undo .
     2218     define output parameter p-slt-pc         as decimal   no-undo .
     2219     define output parameter p-sum-base       as decimal   no-undo .
     2220     define output parameter p-sum-rubl       as decimal   no-undo .
     2221     define output parameter p-vat-base       as decimal   no-undo .
     2222     define output parameter p-vat-rubl       as decimal   no-undo .
     2223     define output parameter p-slt-base       as decimal   no-undo .
     2224     define output parameter p-slt-rubl       as decimal   no-undo .
     2225     define output parameter p-road-tax-base  as decimal   no-undo .
     2226     define output parameter p-road-tax-rubl  as decimal   no-undo .
     2227     define output parameter p-transport-base as decimal   no-undo .
     2228     define output parameter p-transport-rubl as decimal   no-undo .
     2229     define output parameter p-other-base     as decimal   no-undo .
     2230     define output parameter p-other-rubl     as decimal   no-undo .
     2231     define output parameter p-excise-base    as decimal   no-undo .
     2232     define output parameter p-excise-rubl    as decimal   no-undo .
     2233     define variable vss-description as character no-undo init "partslib-calc-cost: расчет сумм в учетных ценах".
     2234     do
     2235     on error undo, return error return-value
     2236     :
     2237       define buffer buf_temp-parts for temp-parts .
     2238       define buffer   in-vatp-trn-doc  for ub.trn-doc .
     2239       define buffer   in-vatp-parts    for ub.parts   .
     2240       define buffer   in-vatp-doc      for ub.trn-doc .
     2241       define buffer   in-vatp-goods    for ub.goods   .
     2242       define buffer   in-vatp-sysconf  for ub.sysconf .
     2243       define buffer   in-vatp_doc-attr for ub.doc-attr.
     2244       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
     2245       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
     2246       define variable varinvprb                  as   character              no-undo.
     2247       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
     2248       define variable cli-base-rate              as   decimal                no-undo.
     2249       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
     2250       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
     2251       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
     2252       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
     2253       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
     2254       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
     2255       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
     2256       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
     2257       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
     2258       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
     2259       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
     2260       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
     2261       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
     2262       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
     2263       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
     2264       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
     2265       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
     2266       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
     2267       define variable other-base-loc             like ub.doc-line.price-base no-undo.
     2268       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
     2269       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
     2270       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
     2271       define variable varinvatp-envd             as   character              no-undo.
     2272       define variable varinvatp-type             as   character              no-undo.
     2273       for each buf_temp-parts
     2274       on error undo, return error
     2275       :
     2276   assign
     2277     price-rubl-with-tax-loc = buf_temp-parts.price-rubl
     2278     price-base-with-tax-loc = buf_temp-parts.price-base
     2279   .
     2280   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     2281   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     2282     (output varinvprb
     2283     )  .
     2284     if buf_temp-parts.out-code = 'free-zone':U     or
     2285        buf_temp-parts.out-code = 'out-zone':U   or
     2286        buf_temp-parts.doc-type = 'акт':U then do:
     2287       assign
     2288         in-vatp-have-vat-slt = yes.
     2289     end.
     2290     else do:
     2291       find first in-vatp_doc-attr no-lock
     2292         where in-vatp_doc-attr.doc-code  = buf_temp-parts.out-code
     2293           and in-vatp_doc-attr.attr-code = 'envd':U
     2294         no-error .
     2295       if not available in-vatp_doc-attr then do:
     2296         assign
     2297           in-vatp-have-vat-slt = yes.
     2298       end.
     2299       else do:
     2300            in-vatp-have-vat-slt = no.
     2301       end.
     2302     end.
     2303     assign
     2304      price-cli-with-tax-loc = buf_temp-parts.price-cli
     2305      cli-base-rate          = buf_temp-parts.cli-base-rate.
     2306     ASSIGN   road-tax-base-loc  = (if buf_temp-parts.road-tax-base  = ? then 0 else buf_temp-parts.road-tax-base)
     2307              road-tax-rubl-loc  = (if buf_temp-parts.road-tax-rubl  = ? then 0 else buf_temp-parts.road-tax-rubl).
     2308     ASSIGN  transport-base-loc = (if buf_temp-parts.transport-base = ? then 0 else buf_temp-parts.transport-base)
     2309             transport-rubl-loc = (if buf_temp-parts.transport-rubl = ? then 0 else buf_temp-parts.transport-rubl)
     2310             other-base-loc     = (if buf_temp-parts.other-base     = ? then 0 else buf_temp-parts.other-base)
     2311             other-rubl-loc     = (if buf_temp-parts.other-rubl     = ? then 0 else buf_temp-parts.other-rubl)
     2312             vat-pc-loc         = (if buf_temp-parts.vat-pc         = ? then 0 else buf_temp-parts.vat-pc)
     2313             slt-pc-loc         = (if buf_temp-parts.slt-pc         = ? then 0 else buf_temp-parts.slt-pc).
     2314             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     2315       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     2316     assign
     2317       exch-rate-cli-loc = (buf_temp-parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if buf_temp-parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if buf_temp-parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / buf_temp-parts.price-cli .
     2318     assign
     2319       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
     2320       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
     2321       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
     2322       transport-cli-loc  = 0
     2323       other-cli-loc      = 0
     2324     .
     2325   ASSIGN
     2326             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     2327       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     2328   .
     2329         assign
     2330           p-fact-qnty      = p-fact-qnty      + buf_temp-parts.fact-qnty
     2331           p-vat-pc         = p-vat-pc         + vat-pc-loc
     2332           p-slt-pc         = p-slt-pc         + slt-pc-loc
     2333           p-sum-base       = p-sum-base       + price-base-with-tax-loc * buf_temp-parts.fact-qnty
     2334           p-sum-rubl       = p-sum-rubl       + price-rubl-with-tax-loc * buf_temp-parts.fact-qnty
     2335           p-vat-base       = p-vat-base       + vat-base-loc            * buf_temp-parts.fact-qnty
     2336           p-vat-rubl       = p-vat-rubl       + vat-rubl-loc            * buf_temp-parts.fact-qnty
     2337           p-slt-base       = p-slt-base       + slt-base-loc            * buf_temp-parts.fact-qnty
     2338           p-slt-rubl       = p-slt-rubl       + slt-rubl-loc            * buf_temp-parts.fact-qnty
     2339           p-road-tax-base  = p-road-tax-base  + road-tax-base-loc       * buf_temp-parts.fact-qnty
     2340           p-road-tax-rubl  = p-road-tax-rubl  + road-tax-rubl-loc       * buf_temp-parts.fact-qnty
     2341           p-transport-base = p-transport-base + transport-base-loc      * buf_temp-parts.fact-qnty
     2342           p-transport-rubl = p-transport-rubl + transport-rubl-loc      * buf_temp-parts.fact-qnty
     2343           p-other-base     = p-other-base     + other-base-loc          * buf_temp-parts.fact-qnty
     2344           p-other-rubl     = p-other-rubl     + other-rubl-loc          * buf_temp-parts.fact-qnty
     2345           p-excise-base    = p-excise-base    + 0
     2346           p-excise-rubl    = p-excise-rubl    + 0
     2347         .
     2348       end.
     2349       if p-fact-qnty      = ?
     2350       or p-sum-base       = ?
     2351       or p-sum-rubl       = ?
     2352       or p-vat-base       = ?
     2353       or p-vat-rubl       = ?
     2354       or p-slt-base       = ?
     2355       or p-slt-rubl       = ?
     2356       or p-road-tax-base  = ?
     2357       or p-road-tax-rubl  = ?
     2358       or p-transport-base = ?
     2359       or p-transport-rubl = ?
     2360       or p-other-base     = ?
     2361       or p-other-rubl     = ?
     2362       or p-excise-base    = ?
     2363       or p-excise-rubl    = ?
     2364       then do:
     2365         message
     2366           vss-workfile vss-revision vss-description skip
     2367           vss-include-info17 skip
     2368           "Программа in-vatp.i вернула неопределенные значения" skip
     2369           "p-fact-qnty"      p-fact-qnty      skip
     2370           "p-sum-base"       p-sum-base       skip
     2371           "p-sum-rubl"       p-sum-rubl       skip
     2372           "p-vat-base"       p-vat-base       skip
     2373           "p-vat-rubl"       p-vat-rubl       skip
     2374           "p-slt-base"       p-slt-base       skip
