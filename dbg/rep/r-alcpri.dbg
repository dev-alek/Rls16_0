     2376           "p-road-tax-base"  p-road-tax-base  skip
     2377           "p-road-tax-rubl"  p-road-tax-rubl  skip
     2378           "p-transport-base" p-transport-base skip
     2379           "p-transport-rubl" p-transport-rubl skip
     2380           "p-other-base"     p-other-base     skip
