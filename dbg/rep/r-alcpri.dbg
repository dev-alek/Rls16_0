      578   function excel-format-dec-to-char returns char (input p-dec as decimal ).
      579     if num-entries(string(p-dec), '.') = 2
      580       then return( entry(1, string(p-dec), '.') + v-delim + entry(2, string(p-dec), '.')) .
      581       else return( string(p-dec)) .
      582   end function.
      583   function format-point-to-comma returns char (input orig as char ) .
      584   define variable rtext as character no-undo .
      585   define variable strt as integer no-undo .
      586   define variable leng as integer no-undo .
      587   assign rtext = orig .
      588   repeat:
      589     strt =  index(rtext,'.').
      590     if strt = 0 then leave.
      591     leng = 1.
      592     substring(rtext,strt,leng,"character") = v-delim .
      593   end.
      594   return rtext.
      595   end function.
      596   function format-excel-text returns char ( input start-text as char ) :
      597   def var  i    as int no-undo.
      598   def var  ch   as char no-undo.
      599   def var  n    as int no-undo.
      600   def var  ipos as int no-undo.
      601     n = num-entries(trim(start-text), chr(10)) - 1 .
      602     do i = 1 to n :
      603       ipos = index( start-text, chr(10)).
      604       if ipos > 0 then
      605         substr( start-text, ipos, 1 ) = ' '.
      606     end.
      607     n = num-entries(trim(start-text), chr(13)) - 1 .
      608     do i = 1 to n :
      609       ipos = index( start-text, chr(13)).
      610       if ipos > 0 then
      611         substr( start-text, ipos, 1 ) = ' '.
      612     end.
      613     if index( start-text, '"' ) = 0 then
      614       start-text =  '="'   + trim( start-text) + '"'   .
      615       else do:
      616         n = num-entries(trim(start-text), '"') - 1.
      617         do i = 1 to n :
      618           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
      619         end.
      620         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
      621         start-text = '="'  + ch  + '"' .
      622       end.
      623     return start-text.
      624   end.
      625   function excel-sum returns char (input p-dec as decimal ).
      626     return(format-excel-text(excel-format-dec-to-char(round(p-dec,2)))) .
      627   end function.
      628   function excel-qnty returns char (input p-dec as decimal ).
      629     return(format-excel-text(excel-format-dec-to-char(round(p-dec,3)))) .
      630   end function.
      631   function format-excel-text-macr returns char ( input start-text as char ) :
      632   def var  i    as int no-undo.
      633   def var  ch   as char no-undo.
      634   def var  n    as int no-undo.
      635   def var  ipos as int no-undo.
      636     n = num-entries(trim(start-text), chr(10)) - 1 .
      637     do i = 1 to n :
      638       ipos = index( start-text, chr(10)).
      639       if ipos > 0 then
      640         substring( start-text, ipos , 1 ) = ' '.
      641     end.
      642     n = num-entries(trim(start-text), chr(13)) - 1 .
      643     do i = 1 to n :
      644       ipos = index( start-text, chr(13)).
      645       if ipos > 0 then
      646         substring( start-text, ipos, 1 ) = ' '.
      647     end.
      648     if index( start-text, '"' ) = 0 then
      649       start-text =  '"'   + trim( start-text) + '"'   .
      650       else do:
      651         n = num-entries(trim(start-text), '"') - 1.
      652         do i = 1 to n :
      653           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
      654         end.
      655         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
      656         start-text = '"'  + ch  + '"' .
      657       end.
      658     n = num-entries(trim(start-text), chr(10)) - 1 .
      659     do i = 1 to n :
      660       ipos = index( start-text, chr(10)).
      661       if ipos > 0 then
      662         substring( start-text, ipos , 1 ) = ' '.
      663     end.
      664       if num-entries(trim(start-text), chr(10)) > 1 then  message num-entries(trim(start-text), chr(10)) start-text.
      665     return start-text.
      666   end.
      667   define variable vss-include-info8 as character format "X(65)" no-undo
      668   initial "@(#)$Workfile$ $Revision$".
      669   procedure grplib-get-full-name :
      670      define input parameter p-node-code  as integer      no-undo.
      671      define output parameter p-full-name as character    no-undo.
      672      do
      673   on error undo, return error
      674   :
      675       define variable v-upper-code    as integer           no-undo.
      676       define buffer buf_gds-grp       for ub.gds-grp.
      677       define buffer buf_upper_gds-grp for ub.gds-grp.
      678       find first buf_gds-grp no-lock
      679            where buf_gds-grp.node-code = p-node-code
      680       no-error.
      681       if not available buf_gds-grp
      682       then do:
      683           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
      684       end.
      685       assign
      686           p-full-name  = ""
      687           v-upper-code = 1
      688       .
      689       do while buf_gds-grp.upper-code <> 0
      690       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
      691       :
      692           assign
      693               p-full-name  = buf_gds-grp.node-name
      694                            + (if p-full-name <> "" then chr(47) else "")
      695                            + p-full-name
      696               v-upper-code = buf_gds-grp.upper-code
      697           .
      698           find first buf_gds-grp no-lock
      699                where buf_gds-grp.node-code = v-upper-code
      700           no-error.
      701           if not available buf_gds-grp
      702           then do:
      703               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
      704                                   + string( v-upper-code )
      705                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      706           end.
      707       end.
      708       assign
      709       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
      710       .
      711   end.
      712   end .
      713   procedure grplib-get-node-from-full-name :
      714   define input parameter p-full-name as character no-undo .
      715   define output parameter p-node-code as integer no-undo .
      716   define variable v-ii as integer no-undo .
      717   define variable v-upper-code as integer no-undo .
      718   define variable v-root-code as integer no-undo .
      719   define variable v-entry as character no-undo .
      720   define buffer buf_gds-grp       for ub.gds-grp.
      721   do
      722   on error undo, return error
      723   :
      724     find first buf_gds-grp no-lock
      725         where buf_gds-grp.upper-code = 0
      726     no-error .
      727     if not available buf_gds-grp
      728     then do:
      729         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
      730     end.
      731     else do:
      732       assign
      733       v-root-code = buf_gds-grp.node-code
      734       .
      735     end.
      736     v-upper-code = v-root-code.
      737     do v-ii = 1 to num-entries(p-full-name, chr(47)):
      738       assign
      739       v-entry = entry(v-ii, p-full-name, chr(47)).
      740       if v-entry = '' then leave.
      741       find first buf_gds-grp no-lock where
      742                 buf_gds-grp.node-name = v-entry
      743             and buf_gds-grp.upper-code = v-upper-code
      744             no-error.
      745       if not available buf_gds-grp then do:
      746         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
      747       end.
      748       else do:
      749         p-node-code = buf_gds-grp.node-code.
      750         v-upper-code = buf_gds-grp.node-code.
      751       end.
      752     end.
      753   end.
      754   end .
      755   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      756   define variable v-waitfram-action01         as character   no-undo .
      757   define variable v-waitfram-action02         as character   no-undo .
      758   define variable v-waitfram-action03         as character   no-undo .
      759   define variable mWaitFramTextBeg            as character   no-undo.
      760   define variable mWaitFramTextEnd            as character   no-undo.
      761   define variable mWaitFramView               as logical     no-undo.
      762   define variable mWaitProcEvent              as logical     no-undo init yes.
      763   define variable mWaitFramInterval           as integer     no-undo init 1 .
      764   define variable mWaitFramStop               as logical     no-undo.
      765   define variable mWaitFramStopUser           as logical     no-undo.
      766   define variable mWaitFramStopTimeOut        as logical     no-undo.
      767   define variable mWaitFramStartProc          as datetime-tz no-undo.
      768   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      769   define button B-WaitFramStop auto-end-key
      770        label "Стоп"
      771        size 10 by 1 tooltip "Остоновить процесс".
      772   define button B-viewProcInfo
      773        label "Информация"
      774        size 15 by 1 tooltip "Информация о процесс".
      775   define frame waitfram
      776     v-waitfram-action01 format "x(72)" no-label skip
      777     v-waitfram-action02 format "x(72)" no-label skip
      778     v-waitfram-action03 format "x(72)" no-label skip
      779     B-viewProcInfo
      780     B-WaitFramStop at row 4 col 30
      781     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      782     .
      783   define new global shared variable mBatchMode as logical no-undo init ?.
      784   define variable mFramBachModHandle as handle no-undo.
      785   mFramBachModHandle = frame waitfram:handle.
      786   define variable mFameOldVis as logical no-undo.
      787   define variable mVisCUrentVin as logical no-undo.
      788   if session:batch-mode
      789   then
      790      mBatchMode = yes.
      791   if mBatchMode = ? then do:
      792     mVisCUrentVin = current-window:visible.
      793     mFameOldVis = mFramBachModHandle:visible.
      794     mFramBachModHandle:visible  = yes.
      795     mBatchMode = mFramBachModHandle:visible ne yes.
      796     mFramBachModHandle:visible = mFameOldVis.
      797     current-window:visible = mVisCUrentVin.
      798   end.
      799    if  log-manager:logfile-name ne ?
      800     then DO:
      801         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      802         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      803         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      804     end.
      805   on choose of B-WaitFramStop in frame waitfram
      806   do:
      807     mWaitFramStop = yes.
      808     mWaitFramStopUser = yes.
      809   end.
      810   function waitfram-check-timeout returns logical():
      811      define variable vtime as int64 no-undo.
      812      if mWaitFramStopTimeOut
      813      then
      814         return yes.
      815      vtime = ( now - mWaitFramStartProc ) / 1000 .
      816      if     mWaitFramTimeOut ne ?
      817         and mWaitFramTimeOut ne 0
      818         and mWaitFramTimeOut lt vtime
      819      then do:
      820         mWaitFramStopTimeOut = yes.
      821      end.
      822      return mWaitFramStopTimeOut.
      823   end.
      824   procedure waitfram-hide :
      825     if not session:batch-mode
      826     then do
      827     on error undo, return error return-value
      828     :
      829       pause 0 before-hide .
      830       if not mBatchMode then
      831         hide frame waitfram .
      832     if     not mWaitFramView
      833        and mWaitProcEvent
      834     then
      835       process events .
      836     end.
      837   end procedure.
      838   procedure waitfram-show :
      839     define input  parameter p-message as character no-undo .
      840     define variable v-left-margin as integer   no-undo .
      841     if not session:batch-mode
      842     then do
      843     on error undo, return error return-value
      844     :
      845       if length(p-message) <= 70 then do:
      846         assign
      847           v-left-margin = integer((70 - length(p-message)) / 2)
      848         .
      849         assign
      850           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      851         .
      852         assign
      853           v-waitfram-action01 = " "
      854           v-waitfram-action02 = " "
      855                                    + fill(" ", v-left-margin)
      856                                    + p-message
      857           v-waitfram-action03 = " "
      858         .
      859       end.
      860       else do:
      861         define variable vRindex1 as integer no-undo.
      862         define variable vRindex2 as integer no-undo.
      863         vRindex1 = r-index(p-message," ",70).
      864         if vRindex1 = 0
      865         then
      866            vRindex1 = 70.
      867         if length(p-message)  <= vRindex1 + 70 then do:
      868           assign
      869             v-waitfram-action01 = " "
      870             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      871             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      872           .
      873         end.
      874         else do:
      875           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      876           if vRindex2 <= vRindex1
      877           then
      878              vRindex2 = vRindex1 + 70.
      879           assign
      880             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      881             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      882             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      883           .
      884         end.
      885       end.
      886       B-viewProcInfo:visible   in frame waitfram = no.
      887       B-viewProcInfo:sensitive in frame waitfram = no.
      888       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      889       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      890       if  (   mWaitFramView
      891          or  mWaitProcEvent)
      892          and not mBatchMode
      893       then
      894          display
      895             v-waitfram-action01 skip
      896             v-waitfram-action02 skip
      897             v-waitfram-action03 skip
      898          with frame waitfram .
      899       if     mWaitFramView
      900          then do:
      901             if     mWaitFramInterval ne ?
      902                and not mBatchMode
      903             then
      904                wait-for go of frame waitfram pause mWaitFramInterval.
      905          end.
      906          else
      907             if     mWaitProcEvent
      908                and not mBatchMode
      909             then
      910                process events .
      911     end.
      912   end procedure.
      913      procedure waitfram-show-this:
      914         define input  parameter iInterval as int64 no-undo.
      915         define variable vtime as int64 no-undo.
      916         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      917         mWaitFramInterval = iInterval.
      918         run waitfram-show (substitute("&1&2 &3&4" ,
      919                                       mWaitFramTextBeg ,
      920                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      921                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      922                                       mWaitFramTextEnd
      923                                      )
      924                           ).
      925      end.
      926      procedure WaitFramRunPause:
      927         define input  parameter iInterval as dec no-undo.
      928         define variable vStart  as datetime-tz no-undo.
      929         define variable vend    as datetime-tz no-undo.
      930         define variable vint as int64 no-undo.
      931         define variable vOk as logical no-undo.
      932         vStart = now.
      933         vend   = vStart.
      934         publish "WaitFramPause" (iInterval,output vOk).
      935         vend   =  now.
      936         vint = vend - vStart.
      937         vint = iInterval - vint / 1000.
      938         if     not mWaitFramStop
      939            and (   vint > 0
      940                 or (    not vOk
      941                     and iInterval eq ?
      942                     )
      943                 )
      944         then
      945            run waitfram-show-this (iInterval).
      946         vend   =  now.
      947         vint = vend - vStart.
      948         vint = iInterval - vint / 1000.
      949         if     not mWaitFramStop
      950            and vint > 0
      951         then do:
      952            run gbl/pause.p (vint * 1000).
      953         end.
      954         if iInterval ne ?
      955         then
      956            publish "WaitFramStop".
      957         waitfram-check-timeout().
      958      end.
      959      procedure WaitFramWaitFor:
      960         define input  parameter iInterval as dec no-undo.
      961         assign
      962            mWaitFramStartProc   = now
      963            mWaitFramStopUser    = no
      964            mWaitFramStopTimeOut = no
      965         .
      966         block-wait:
      967         do while not mWaitFramStop:
      968            run WaitFramRunPause (iInterval).
      969            if  waitfram-check-timeout()
      970            then do:
      971               leave block-wait.
      972            end.
      973         end.
      974         run waitfram-hide.
      975      end.
      976   procedure waitfram-join :
      977     define input  parameter p-line-1  as character no-undo .
      978     define input  parameter p-line-2  as character no-undo .
      979     define input  parameter p-line-3  as character no-undo .
      980     define output parameter p-message as character no-undo .
      981     do
      982     on error undo, return error return-value
      983     :
      984       assign
      985         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      986                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      987                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      988       .
      989     end.
      990   end procedure.
      991   function waitfram-join-function returns character
      992     (input p-line-1 as character
      993     ,input p-line-2 as character
      994     ,input p-line-3 as character
      995     ).
      996     define variable v-message as character no-undo .
      997     run waitfram-join in this-procedure
      998       (input  p-line-1
      999       ,input  p-line-2
     1000       ,input  p-line-3
     1001       ,output v-message
     1002       ) .
     1003     return v-message .
     1004   end function .
     1005   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1006   define  stream PrnLibStream.
     1007   procedure prn-lib-prn-file :
     1008     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1009     define input parameter p-DIsabledoptions as integer no-undo .
     1010     define variable v-report-name as character no-undo .
     1011     define variable v-user-action as character no-undo .
     1012     define variable v-printed     as logical   no-undo .
     1013     define variable v-exist       as logical   no-undo .
     1014     do
     1015       on error undo, return error
     1016       :
     1017       run prn-lib-get-report-name  in this-procedure (
     1018         input parParentProc
     1019         ,output v-report-name
     1020         ).
     1021   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1022   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
     1023     (input  v-report-name
     1024     ,input  2
     1025     ,output v-exist
     1026     )  .
     1027       if NOT v-exist then
     1028       DO:
     1029         Message
     1030           "Нет заданий на печать ! "
     1031           view-as alert-box .
     1032         Return  .
     1033       End.
     1034       run gbl/prnfilen.w
     1035         (input  ""
     1036         ,input  p-DisabledOptions
     1037         ,input  string(v-report-name )
     1038         ,input  7
     1039         ,output v-user-action
     1040         ,output v-printed
     1041         ) .
     1042       if v-printed then
     1043       do:
     1044         return "YES" .
     1045       end.
     1046       else
     1047       do:
     1048         return "NO" .
     1049       end.
     1050     end.
     1051   end procedure.
     1052   procedure prn-lib-open-stream :
     1053     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1054     define input parameter p-page-size    as integer no-undo .
     1055     define input parameter p-is-stream    as logical no-undo .
     1056     define input parameter p-append       as logical no-undo .
     1057     define variable v-report-name as character no-undo .
     1058     do
     1059       on error undo, return error
     1060       :
     1061       run prn-lib-get-report-name  in this-procedure (
     1062         input parParentProc
     1063         ,output v-report-name
     1064         ).
     1065       if p-is-stream then
     1066       do:
     1067         if p-append then
     1068         do:
     1069           output stream PrnLibStream to value( v-report-name )
     1070             page-size value(p-page-size) append .
     1071         end.
     1072         if not p-append then
     1073         do:
     1074           output stream PrnLibStream to value( v-report-name )
     1075             page-size value(p-page-size) .
     1076         end.
     1077       end.
     1078       if not p-is-stream then
     1079       do:
     1080         if p-append then
     1081         do:
     1082           output to value( v-report-name )
     1083             page-size value(p-page-size) append .
     1084         end.
     1085         if not p-append then
     1086         do:
     1087           output to value( v-report-name )
     1088             page-size value(p-page-size) .
     1089         end.
     1090       end.
     1091     end.
     1092   end procedure.
     1093   procedure prn-lib-open-exp :
     1094     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1095     define input parameter p-is-stream    as logical no-undo .
     1096     define input parameter p-is-append    as logical no-undo .
     1097     define output parameter p-ReportFileName as char init "report" no-undo.
     1098     define output parameter p-process as logical no-undo .
     1099     define variable glog as logical no-undo .
     1100     do
     1101       on error undo, return error
     1102       :
     1103       SYSTEM-DIALOG GET-FILE p-ReportFileName
     1104         TITLE      "Укажите путь"
     1105         FILTERS "Текстовый файл (*.txt)"   "*.txt"
     1106         ASK-OVERWRITE
     1107         CREATE-TEST-FILE
     1108         SAVE-AS
     1109         USE-FILENAME
     1110         DEFAULT-EXTENSION "txt"
     1111         UPDATE glog
     1112         .
     1113       if not glog then  return.
     1114       p-ReportFileName = trim( string( p-ReportFileName ) ) .
     1115       if p-is-stream then
     1116       do:
     1117         if p-is-append then
     1118         do:
     1119           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1120         end.
     1121         else
     1122         do:
     1123           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1124         end.
     1125       end.
     1126       else
     1127       do:
     1128         if p-is-append then
     1129         do:
     1130           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1131         end.
     1132         else
     1133         do:
     1134           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1135         end.
     1136       end.
     1137       p-process = yes.
     1138     end.
     1139   end procedure.
     1140   procedure prn-lib-get-report-name :
     1141     define input parameter parParentProc  as widget-handle no-undo.
     1142     define output parameter p-report-name as character no-undo .
     1143     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
     1144   end procedure.
     1145   procedure prn-lib-reportviewer-report-name :
     1146     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1147     define input parameter p-report-name-html as character no-undo .
     1148     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
     1149   end procedure.
     1150   procedure prn-lib-reportviewer :
     1151     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1152     define input parameter p-report-name-html as character no-undo .
     1153     define input parameter p-param        as character no-undo .
     1154     define variable v-excel           as character no-undo init 'TRUE' .
     1155     define variable v-value-character as character no-undo .
     1156     define variable v-value-integer   as character no-undo .
     1157     define variable v-value-date      as date      no-undo .
     1158     define variable v-value-decimal   as decimal   no-undo .
     1159     define variable rep-excel         as logical   no-undo .
     1160     define variable excel-string      as character no-undo .
     1161     define variable v-param-type      as character no-undo .
     1162     define variable v-tth             as handle    no-undo .
     1163     run adm/shattri.p (
     1164       input "get":U
     1165       ,input  ""
     1166       ,input  0
     1167       ,input  'report-glob':U
     1168       ,input  'rep-excel':U
     1169       ,output v-value-character
     1170       ,output v-value-date
     1171       ,output v-value-decimal
     1172       ,output v-value-integer
     1173       ,output rep-excel
     1174       ,output v-param-type
     1175       ,INPUT-OUTPUT table-handle v-tth
     1176       )  .
     1177     if rep-excel then v-excel = "TRUE" .
     1178     else v-excel = "FALSE" .
     1179     if p-param eq ""
     1180     then
     1181        p-param = "EXCEL:" + v-excel.
     1182     else
     1183        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
     1184     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
     1185   end procedure.
