     2387     end.
     2388   end procedure.
     2389   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2390   function octal-to-char return character
     2391   ( p-string as character ) :
     2392     def var v-asc     as integer no-undo .
     2393     def var v-new-asc as integer no-undo .
     2394     def var ind       as integer no-undo .
     2395     if length(p-string) <> 3 then do:
     2396       return ? .
     2397     end.
     2398     assign
     2399       v-asc = 0
     2400     .
     2401     do ind = 1 to length(p-string)
     2402     :
     2403       assign
     2404         v-new-asc = asc(substring(p-string, ind, 1)) - asc('0')
     2405       .
     2406       if v-new-asc < 0 or v-new-asc >= 8 then do:
     2407         return ? .
     2408       end.
     2409       assign
     2410         v-asc = v-asc * 8 + v-new-asc
     2411       .
     2412     end.
     2413     return chr(v-asc) .
     2414   end function .
     2415   function char-to-octal return character
     2416   ( p-chr as character ) :
     2417     def var v-asc    as integer   no-undo .
     2418     def var ind      as integer   no-undo .
     2419     def var v-string as character no-undo .
     2420     if length(p-chr) <> 1 then do:
     2421       return ? .
     2422     end.
     2423     assign
     2424       v-asc    = asc(p-chr)
     2425       v-string = ""
     2426     .
     2427     do ind = 1 to 3
     2428     :
     2429       assign
     2430         v-string = chr( v-asc mod 8 + asc('0')) + v-string
     2431       .
     2432       assign
     2433         v-asc = truncate(v-asc / 8, 0)
     2434       .
     2435     end.
     2436     return v-string .
     2437   end.
     2438   function str-encode return character
     2439   (   p-init-string       as character
     2440     , p-encode-char       as character
     2441     , p-special-char-list as character
     2442   ) :
     2443     def var p-encode-string as character no-undo .
     2444     def var ind                as integer no-undo .
     2445     def var v-num-special-char as integer no-undo .
     2446     def var v-special-char     as character no-undo .
     2447     if p-encode-char = ?
     2448     or p-encode-char = "" then do:
     2449       assign
     2450         p-encode-char = "~~"
     2451       .
     2452     end.
     2453     if p-init-string = ? then do:
     2454       return "?" .
     2455     end.
     2456     if p-init-string = "?" then do:
     2457       return p-encode-char + char-to-octal("?") .
     2458     end.
     2459     assign
     2460       v-num-special-char = length(p-special-char-list)
     2461       p-encode-string    = replace(p-init-string
     2462                                   ,p-encode-char
     2463                                   ,p-encode-char + char-to-octal(p-encode-char)
     2464                                   )
     2465     .
     2466     do ind = 1 to v-num-special-char
     2467     :
     2468       assign
     2469         v-special-char = substring(p-special-char-list, ind, 1)
     2470       .
     2471       if v-special-char <> p-encode-char then do:
     2472         assign
     2473           p-encode-string = replace (p-encode-string
     2474                                     ,v-special-char
     2475                                     ,p-encode-char + char-to-octal(v-special-char)
     2476                                     )
     2477         .
     2478       end.
     2479     end.
     2480     return p-encode-string .
     2481   end.
     2482   function str-decode returns character
     2483     (p-init-string   as character
     2484     ,p-encode-char   as character
     2485     ) :
     2486     def var p-decode-string as character no-undo .
     2487     def var ind                       as integer no-undo .
     2488     def var v-num-entries-init-string as integer no-undo .
     2489     def var v-sub-phrase              as character no-undo .
     2490     def var v-special-char            as character no-undo .
     2491     if p-encode-char = ?
     2492     or p-encode-char = "" then do:
     2493       assign
     2494         p-encode-char = "~~"
     2495       .
     2496     end.
     2497     if p-init-string = "?" then do:
     2498       return ? .
     2499     end.
     2500     assign
     2501       v-num-entries-init-string = num-entries(p-init-string, p-encode-char)
     2502     .
     2503     if v-num-entries-init-string > 1 then do:
     2504       assign
     2505         p-decode-string = entry(1, p-init-string, p-encode-char)
     2506       .
     2507       do ind = 2 to v-num-entries-init-string
     2508       :
     2509         assign
     2510           v-sub-phrase = entry(ind, p-init-string, p-encode-char)
     2511         .
     2512         assign
     2513           v-special-char = octal-to-char(substring(v-sub-phrase, 1, 3))
     2514         .
     2515         if v-special-char <> ? then do:
     2516           assign
     2517             p-decode-string = p-decode-string
     2518                             + v-special-char
     2519                             + substring(v-sub-phrase, 4)
     2520           .
     2521         end.
     2522         else do:
     2523           assign
     2524             p-decode-string = p-decode-string
     2525                             + p-encode-char
     2526                             + v-sub-phrase
     2527           .
     2528         end.
     2529       end.
     2530     end.
     2531     else do:
     2532       assign
     2533         p-decode-string = p-init-string
     2534       .
     2535     end.
     2536     return p-decode-string .
     2537   end.
     2538   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2539   procedure integerm :
     2540     define input  parameter p-string      as character no-undo .
     2541     define input  parameter p-allow-sign  as logical   no-undo .
     2542     define input  parameter p-allow-comma as logical   no-undo .
     2543     define output parameter p-value       as integer   no-undo .
     2544     define output parameter p-data-valid  as logical   no-undo .
     2545     define output parameter p-message     as character no-undo .
     2546     define variable v-replace-string as character no-undo .
     2547     do
     2548     on error undo, return error return-value
     2549     :
     2550       if p-string = ?
     2551       then do:
     2552         assign
     2553           p-value      = ?
     2554           p-data-valid = false
     2555           p-message    = "Ошибка задания входных параметров. Не задана строка для преобразования"
     2556         .
     2557         return .
     2558       end.
     2559       if p-string = ""
     2560       then do:
     2561         assign
     2562           p-value      = ?
     2563           p-data-valid = false
     2564           p-message    = "Ошибка задания входных параметров. Задана пустая строка для преобразования"
     2565         .
     2566         return .
     2567       end.
     2568       assign
     2569         p-value = integer(p-string) no-error
     2570       .
     2571       if error-status :error = true
     2572       then do:
     2573         assign
     2574           p-value      = ?
     2575           p-data-valid = false
     2576           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'"
     2577                                    ,p-string
     2578                                    )
     2579         .
     2580         return .
     2581       end.
     2582       if index(p-string, ' ':u) > 0
     2583       then do:
     2584         assign
     2585           p-value      = ?
     2586           p-data-valid = false
     2587           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
     2588                                    + "Строка содержит символы пробела"
     2589                                    ,p-string
     2590                                    )
     2591         .
     2592         return .
     2593       end.
     2594       assign
     2595         v-replace-string = p-string
     2596         v-replace-string = replace(v-replace-string, '0':u, '9':u)
     2597         v-replace-string = replace(v-replace-string, '1':u, '9':u)
     2598         v-replace-string = replace(v-replace-string, '2':u, '9':u)
     2599         v-replace-string = replace(v-replace-string, '3':u, '9':u)
     2600         v-replace-string = replace(v-replace-string, '4':u, '9':u)
     2601         v-replace-string = replace(v-replace-string, '5':u, '9':u)
     2602         v-replace-string = replace(v-replace-string, '6':u, '9':u)
     2603         v-replace-string = replace(v-replace-string, '7':u, '9':u)
     2604         v-replace-string = replace(v-replace-string, '8':u, '9':u)
     2605       .
     2606       if p-allow-sign = true
     2607       then do:
     2608         if index('+-':u, substring(v-replace-string, 1, 1)) > 0
     2609         then do:
     2610           assign
     2611             v-replace-string = substring(v-replace-string, 2)
     2612           .
     2613         end.
     2614       end.
     2615       else do:
     2616         if substring(v-replace-string, 1, 1) = '+':u
     2617         then do:
     2618           assign
     2619             p-value      = ?
     2620             p-data-valid = false
     2621             p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
     2622                                     + "Задан параметр недопустимости знака челого числа. "
     2623                                     + "Строка содержит символ плюс. "
     2624                                     ,p-string
     2625                                     )
     2626           .
     2627           return .
     2628         end.
     2629         if substring(v-replace-string, 1, 1) = '-':u
     2630         then do:
     2631           assign
     2632             p-value      = ?
     2633             p-data-valid = false
     2634             p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
     2635                                     + "Задан параметр недопустимости знака челого числа. "
     2636                                     + "Строка содержит символ минус. "
     2637                                     ,p-string
     2638                                     )
     2639           .
     2640           return .
     2641         end.
     2642       end.
     2643       if p-allow-comma = true
     2644       then do:
     2645         assign
     2646           v-replace-string = replace(v-replace-string, ',', '')
     2647         .
     2648       end.
     2649       else do:
     2650         if index(v-replace-string, ',') > 0
     2651         then do:
     2652           assign
     2653             p-value      = ?
     2654             p-data-valid = false
     2655             p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
     2656                                     + "Задан параметр недопустимости знака разделителя тысяч."
     2657                                     + "Строка содержит знак разделителя тысяч. "
     2658                                     ,p-string
     2659                                     )
     2660           .
     2661           return .
     2662         end.
     2663       end.
     2664       if index(p-string, '.') > 0
     2665       then do:
     2666         assign
     2667           p-value      = ?
     2668           p-data-valid = false
     2669           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
     2670                                    + "Строка содержит знак десятичной точки"
     2671                                    ,p-string
     2672                                    )
     2673         .
     2674         return .
     2675       end.
     2676       if v-replace-string <> fill('9', length(v-replace-string))
     2677       then do:
     2678         assign
     2679           p-value      = ?
     2680           p-data-valid = false
     2681           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
     2682                                    + "Встречены символы, недопустимые для целого числа '&2'"
     2683                                    ,p-string
     2684                                    ,replace(v-replace-string, '9', '')
     2685                                    )
     2686         .
     2687         return .
     2688       end.
     2689       assign
     2690         p-data-valid = true
     2691         p-message    = ""
     2692       .
     2693     end.
     2694   end procedure.
     2695   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2696   procedure alc-lib_mark-name :
     2697     define input  parameter p-mark-db-num   as integer   no-undo .
     2698     define input  parameter p-mark-code     as integer   no-undo .
     2699     define output parameter p-mark-name     as character no-undo .
     2700     define buffer buf_ex-mark for ub.ex-mark .
     2701     do
     2702     on error undo, return error return-value
     2703     :
     2704       if p-mark-db-num = ?
     2705       or p-mark-code   = ?
     2706       then do:
     2707         assign
     2708           p-mark-name = '?':u
     2709         .
     2710         return .
     2711       end.
     2712       if  p-mark-db-num = 0
     2713       and p-mark-code   = 0
     2714       then do:
     2715         assign
     2716           p-mark-name = ""
     2717         .
     2718         return .
     2719       end.
     2720       find first buf_ex-mark no-lock
     2721         where buf_ex-mark.db-num    = p-mark-db-num
     2722           and buf_ex-mark.mark-code = p-mark-code
     2723         no-error .
     2724       if available buf_ex-mark
     2725       then do:
     2726         assign
     2727           p-mark-name = substitute('&1':u
     2728                                   ,buf_ex-mark.mark-name
     2729                                   )
     2730         .
     2731       end.
     2732     end.
     2733   end procedure.
     2734   procedure alc-lib_get-new-part-code :
     2735     define input  parameter p-obj-type       as character no-undo .
     2736     define input  parameter p-obj-code       as integer   no-undo .
     2737     define input  parameter p-prod-type      as character no-undo .
     2738     define input  parameter p-prod-code      as integer   no-undo .
     2739     define input  parameter p-artic          as character no-undo .
     2740     define input  parameter p-doc-code       as character no-undo .
     2741     define output parameter p-new-part-code  as character no-undo .
     2742     define variable v-cur-part-code as integer no-undo.
     2743     define variable v-max-part-code as integer no-undo.
     2744     define variable i               as integer no-undo.
     2745     define buffer bf_parts for ub.parts .
     2746     do
     2747     on error undo, return error return-value
     2748     :
     2749       assign
     2750         v-max-part-code = 0
     2751       .
     2752       for each bf_parts no-lock
     2753             where bf_parts.obj-type  = p-obj-type  and
     2754                   bf_parts.obj-code  = p-obj-code  and
     2755                   bf_parts.prod-type = p-prod-type and
     2756                   bf_parts.prod-code = p-prod-code and
     2757                   bf_parts.artic     = p-artic     and
     2758                   bf_parts.out-code  = p-doc-code
     2759         :
     2760         assign
     2761           v-cur-part-code = integer(bf_parts.part-code)
     2762           no-error.
     2763         if error-status:error = no and v-cur-part-code > v-max-part-code then do:
     2764           assign
     2765             v-max-part-code = v-cur-part-code
     2766           .
     2767         end.
     2768       end.
     2769       assign
     2770         p-new-part-code = string (v-max-part-code + 1)
     2771       .
     2772     end.
     2773   end procedure.
