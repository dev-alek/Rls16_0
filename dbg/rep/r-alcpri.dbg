     1832             return-value skip
     1833             view-as alert-box error .
     1834           undo, return error .
     1835         end.
     1836         find current buf_gds-obj exclusive-lock .
     1837       end.
     1838       run partslib-init-temp-parts in this-procedure
     1839         (input p-obj-type
     1840         ,input p-obj-code
     1841         ,input p-artic
     1842         ,input p-prod-type
     1843         ,input p-prod-code
     1844         ) no-error .
     1845       if error-status :error
