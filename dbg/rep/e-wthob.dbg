     1064        'Record-Source,Record-Target,TableIO-Target~`':U +
     1065        '~`':U +
     1066        '~`~`~`~`~`~`~`~`~`~`~`':U +
     1067        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
     1068            THEN "^^":U
     1069        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
     1070             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
     1071   PROCEDURE adm-apply-entry :
     1072     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1073   END PROCEDURE.
     1074   PROCEDURE adm-destroy :
     1075    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1076   END PROCEDURE.
     1077   PROCEDURE adm-disable :
     1078       DISABLE RECT-7 cb-ob-tal cb-ob-liter cb-ob-rubl bt-doc-type sl-doc-type WITH FRAME F-Main.
     1079       RUN dispatch ('disable-fields':U).
     1080       RUN set-attribute-list ('ENABLED=no':U).
     1081       RETURN.
     1082   END PROCEDURE.
     1083   PROCEDURE adm-edit-attribute-list :
     1084         RUN adm/support/viewerd.w (INPUT THIS-PROCEDURE).
     1085         RETURN.
     1086   END PROCEDURE.
     1087   PROCEDURE adm-enable :
     1088       ENABLE UNLESS-HIDDEN RECT-7 cb-ob-tal cb-ob-liter cb-ob-rubl bt-doc-type sl-doc-type WITH FRAME F-Main.
     1089       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
     1090       RUN set-attribute-list ('ENABLED=yes':U).
     1091       RETURN.
     1092   END PROCEDURE.
     1093   PROCEDURE adm-exit :
     1094        RUN notify ('exit':U).
     1095     RETURN.
     1096   END PROCEDURE.
     1097   PROCEDURE adm-hide :
     1098     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1099   END PROCEDURE.
     1100   PROCEDURE adm-initialize :
     1101     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1102   END PROCEDURE.
     1103   PROCEDURE adm-show-errors :
     1104       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
     1105       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
     1106           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
     1107       END.
     1108       RETURN.
     1109   END PROCEDURE.
     1110   PROCEDURE adm-UIB-mode :
     1111     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1112   END PROCEDURE.
     1113   PROCEDURE adm-view :
     1114     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1115   END PROCEDURE.
     1116   PROCEDURE dispatch :
     1117       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
     1118       RUN broker-dispatch IN adm-broker-hdl
     1119           (THIS-PROCEDURE, p-method-name) NO-ERROR.
     1120       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
     1121   END PROCEDURE.
     1122   PROCEDURE ensure-broker :
     1123   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
     1124   IF RETURN-VALUE NE "ADM-Broker":U THEN
     1125   DO:
     1126       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
     1127       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
     1128   END.
     1129   END PROCEDURE.
     1130   PROCEDURE get-attribute :
     1131     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
     1132     RUN broker-get-attribute IN adm-broker-hdl
     1133         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
     1134     RETURN RETURN-VALUE.
     1135   END PROCEDURE.
     1136   PROCEDURE get-attribute-list :
     1137     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
     1138     RUN broker-get-attribute-list IN adm-broker-hdl
     1139         (INPUT THIS-PROCEDURE,
     1140          INPUT ?,
     1141          OUTPUT p-attr-list) NO-ERROR.
     1142     RETURN.
     1143   END PROCEDURE.
     1144   PROCEDURE new-state :
     1145     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     1146     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
     1147     RETURN.
     1148   END PROCEDURE.
     1149   PROCEDURE notify :
     1150     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
     1151     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
     1152     IF RETURN-VALUE = "ADM-ERROR":U THEN
     1153         RETURN "ADM-ERROR":U.
     1154     RETURN.
     1155   END PROCEDURE.
     1156   PROCEDURE set-attribute-list :
     1157     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
     1158     RUN ensure-broker.
     1159     RUN broker-set-attribute-list IN adm-broker-hdl
     1160         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
     1161     RETURN.
     1162   END PROCEDURE.
     1163   PROCEDURE set-position :
     1164       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
     1165       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
     1166       IF VALID-HANDLE(adm-object-hdl) THEN
     1167       DO:
     1168         ASSIGN adm-object-hdl:ROW    =   p-row
     1169                adm-object-hdl:COLUMN =   p-col.
     1170       END.
     1171       RETURN.
     1172   END PROCEDURE.
     1173   PROCEDURE adm-display-fields :
     1174       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
     1175       RETURN.
     1176   END PROCEDURE.
     1177   PROCEDURE adm-open-query :
     1178     RETURN.
     1179   END PROCEDURE.
     1180   PROCEDURE adm-row-changed :
     1181         IF VALID-HANDLE(adm-object-hdl) THEN
     1182           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     1183         RUN notify ('row-available':U).
     1184         RETURN.
     1185   END PROCEDURE.
     1186   PROCEDURE reposition-query :
     1187       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
     1188       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
     1189       RETURN.
     1190   END PROCEDURE.
     1191     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
     1192     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
     1193     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
     1194     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
     1195     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
     1196     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
     1197     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
     1198     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
     1199     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1200     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
     1201     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1202     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
     1203     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
     1204     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
     1205     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
     1206     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
     1207     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
     1208     IF "":U = "":U THEN
     1209       RUN modify-list-attribute IN adm-broker-hdl
     1210         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
     1211     RUN use-create-on-add(?).
     1212   PROCEDURE adm-add-record :
     1213       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     1214          "must have at least one Enabled Table to perform Add.":U
     1215          VIEW-AS ALERT-BOX ERROR.
     1216       RETURN.
     1217   END PROCEDURE.
     1218   PROCEDURE adm-assign-record :
     1219    MESSAGE
     1220          "Object ":U THIS-PROCEDURE:FILE-NAME
     1221            "must have at least one Enabled Table to perform Assign.":U
     1222              VIEW-AS ALERT-BOX ERROR.
     1223      RETURN.
     1224     END PROCEDURE.
     1225   PROCEDURE adm-assign-statement :
     1226     RETURN.
     1227   END PROCEDURE.
     1228   PROCEDURE adm-cancel-record :
     1229      RETURN.
     1230     END PROCEDURE.
     1231   PROCEDURE adm-copy-record :
     1232       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     1233        "must have at least one Enabled Table to perform Copy.":U
     1234          VIEW-AS ALERT-BOX ERROR.
     1235       RETURN.
     1236   END PROCEDURE.
     1237   PROCEDURE adm-create-record :
     1238      RETURN.
     1239   END PROCEDURE.
     1240   PROCEDURE adm-current-changed :
     1241     RETURN.
     1242   END PROCEDURE.
     1243   PROCEDURE adm-delete-record :
     1244    MESSAGE
     1245          "Object ":U THIS-PROCEDURE:FILE-NAME
     1246            "must have at least one Enabled Table to perform Delete.":U
     1247              VIEW-AS ALERT-BOX ERROR.
     1248       RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
     1249       RETURN.
     1250   END PROCEDURE.
     1251   PROCEDURE adm-disable-fields :
     1252         RUN notify ('disable-fields, GROUP-ASSIGN-TARGET':U).
     1253       RETURN.
     1254   END PROCEDURE.
     1255   PROCEDURE adm-enable-fields :
     1256       RETURN.
     1257   END PROCEDURE.
     1258   PROCEDURE adm-end-update :
     1259     RETURN.
     1260   END PROCEDURE.
     1261   PROCEDURE adm-reset-record :
     1262       RETURN.
     1263   END PROCEDURE.
     1264   PROCEDURE adm-update-record :
     1265       MESSAGE
     1266         "Object ":U THIS-PROCEDURE:FILE-NAME
     1267           "must have at least one Enabled Table to perform Update.":U
     1268             VIEW-AS ALERT-BOX ERROR.
     1269      RETURN.
     1270   END PROCEDURE.
     1271   PROCEDURE check-modified :
     1272   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
     1273   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
     1274   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
     1275   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
     1276     IF check-state = "check":U THEN
     1277     DO:
     1278       RUN get-link-handle IN adm-broker-hdl
     1279         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
     1280            OUTPUT group-target-list).
     1281       IF group-target-list NE "":U THEN
     1282       DO i = 1 TO NUM-ENTRIES(group-target-list):
     1283         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
     1284         RUN check-modified IN curr-widget ('group-check':U).
     1285         IF RETURN-VALUE NE "":U THEN
     1286         DO:
     1287           RUN check-modified-message(RETURN-VALUE).
     1288           RETURN "":U.
     1289         END.
     1290       END.
     1291     END.
     1292     RETURN "":U.
     1293   END PROCEDURE.
     1294   PROCEDURE check-modified-message :
     1295     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
     1296        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
     1297           'CONTAINER-SOURCE':U, 'HIDDEN':U).
     1298        IF RETURN-VALUE = "YES":U THEN
     1299           RUN notify ('view,CONTAINER-SOURCE':U).
     1300        MESSAGE IF p-changed-table NE ? THEN
     1301           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
     1302           ELSE "Current values have been changed."
     1303           SKIP "  Do you wish to save those changes?"
     1304           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
     1305        IF ANS THEN
     1306        DO:
     1307           IF group-assign-target THEN
     1308             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
     1309           ELSE RUN dispatch('update-record':U).
     1310           IF RETURN-VALUE = "ADM-ERROR":U THEN
     1311           DO:
     1312               MESSAGE "Changes to the previous record were not saved."
     1313                 VIEW-AS ALERT-BOX ERROR.
     1314               IF group-assign-target THEN
     1315                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1316               ELSE RUN dispatch ('cancel-record':U).
     1317           END.
     1318        END.
     1319        ELSE DO:
     1320          IF group-assign-target THEN
     1321             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1322          ELSE RUN dispatch('cancel-record':U).
     1323        END.
     1324        RETURN.
     1325   END PROCEDURE.
     1326   PROCEDURE get-rowid :
     1327       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
     1328       ASSIGN
     1329       p-table   =   adm-first-table.
     1330       RETURN.
     1331   END PROCEDURE.
     1332   PROCEDURE init-group-assign :
     1333       RUN request-attribute IN adm-broker-hdl
     1334         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
     1335       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
     1336         group-assign-target = yes.
     1337       ELSE group-assign-target = no.
     1338       RETURN.
     1339   END PROCEDURE.
     1340   PROCEDURE set-editors :
     1341       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
     1342       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
     1343       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
     1344       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
     1345       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
     1346       DO WHILE VALID-HANDLE (curr-widget):
     1347           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
     1348              curr-widget:HIDDEN = no THEN DO:
     1349             CASE p-field-setting:
     1350               WHEN "INITIALIZE":U THEN
     1351               DO:
     1352                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
     1353                     read-only-list +
     1354                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
     1355                        STRING(curr-widget).
     1356               END.
     1357               WHEN "DISABLE":U OR
     1358               WHEN "ENABLE":U THEN
     1359               DO:
     1360                   curr-widget:SENSITIVE = yes.
     1361                   RUN get-attribute ('Read-Only-Editors':U).
     1362                   IF RETURN-VALUE = ? OR
     1363                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
     1364                       curr-widget:READ-ONLY =
     1365                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
     1366               END.
     1367               WHEN "CLEAR":U THEN
     1368                   curr-widget:SCREEN-VALUE = "":U.
     1369             END CASE.
     1370           END.
     1371           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
     1372       END.
     1373       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
     1374         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
     1375           + '"':U).
     1376       RETURN.
     1377   END PROCEDURE.
     1378   PROCEDURE use-check-modified-all :
     1379    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1380     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
     1381     RETURN.
     1382   END PROCEDURE.
     1383   PROCEDURE use-create-on-add :
     1384   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1385      RETURN.
     1386   END PROCEDURE.
     1387   PROCEDURE use-initial-lock :
     1388     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1389     ASSIGN adm-initial-lock = p-attr-value.
     1390     RETURN.
     1391   END PROCEDURE.
     1392     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
     1393   ASSIGN
     1394          FRAME F-Main:SCROLLABLE       = FALSE
     1395          FRAME F-Main:HIDDEN           = TRUE.
     1396   ASSIGN
     1397          cb-detal:HIDDEN IN FRAME F-Main           = TRUE.
     1398   ON CHOOSE OF bt-doc-type IN FRAME F-Main
     1399   DO:
     1400       run select-doc-type in this-procedure.
     1401   END.
     1402   PROCEDURE disable_UI :
     1403     HIDE FRAME F-Main.
     1404     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1405   END PROCEDURE.
     1406   PROCEDURE local-apply-layout :
     1407     RUN dispatch IN THIS-PROCEDURE ( INPUT 'apply-layout':U ) .
     1408   END PROCEDURE.
     1409   PROCEDURE local-initialize :
     1410   RUN dispatch IN THIS-PROCEDURE ( INPUT 'initialize':U ) .
     1411       define variable v-void-logical          as logical      no-undo.
     1412       define variable v-void-character        as character    no-undo.
     1413       define variable v-ext-doc-type-list     as character    no-undo.
     1414       define variable v-found                 as logical      no-undo.
     1415   do
     1416   on error undo, return error
     1417   :
     1418       run uf-get (
     1419             input 'wthob':U
     1420           , input v-cntxt-userid
     1421           , output v-void-character
     1422           , output v-ext-doc-type-list
     1423           , output cb-ob-liter
     1424           , output cb-ob-rubl
     1425           , output cb-ob-tal
     1426           , output v-void-logical
     1427       ) no-error.
     1428       display
     1429           cb-ob-liter
     1430           cb-ob-rubl
     1431           cb-ob-tal
     1432       with frame F-Main no-error.
     1433       if v-ext-doc-type-list = "":U
     1434       then do:
     1435           assign
     1436               sl-doc-type :list-item-pairs in frame F-Main = "< Все >,''":U
     1437           .
     1438       end.
     1439       else do:
     1440           assign
     1441               sl-doc-type :list-item-pairs in frame F-Main = v-ext-doc-type-list
     1442           .
     1443       end.
     1444   end.
     1445   END PROCEDURE.
     1446   PROCEDURE my-report :
     1447       define variable v-begin-date            as date         no-undo.
     1448       define variable v-end-date              as date         no-undo.
     1449       define variable v-begin-shift           as integer      no-undo.
     1450       define variable v-end-shift             as integer      no-undo.
     1451       define variable v-counter               as integer      no-undo.
     1452       define variable v-ext-doc-type-list     as character    no-undo.
     1453   do
     1454   on error undo, return error
     1455   :
     1456       assign
     1457           v-begin-date  = x-Date-Start
     1458           v-end-date    = x-Date-End
     1459           v-begin-shift = x-Shift-Start
     1460           v-end-shift   = x-Shift-End
     1461       .
     1462       if sl-doc-type :list-item-pairs in frame F-Main = "< Все >,''":U
     1463       then do:
     1464           assign
     1465               v-ext-doc-type-list = "":U
     1466           .
     1467       end.
     1468       else do:
     1469           do v-counter = 1 to sl-doc-type :num-items
     1470           on error undo, return error
     1471           :
     1472               assign
     1473                   v-ext-doc-type-list = substitute( "&1&2&3"
     1474                                   , v-ext-doc-type-list
     1475                                   , ( if v-ext-doc-type-list = "":U then "":U else ",":U )
     1476                                   , entry( v-counter * 2, sl-doc-type :list-item-pairs )
     1477                                   )
     1478               .
     1479           end.
     1480       end.
     1481   assign frame F-Main
     1482       cb-detal
     1483       cb-ob-tal
     1484       cb-ob-liter
     1485       cb-ob-rubl   .
     1486       run uf-set (
     1487             input 'wthob':U
     1488           , input  v-cntxt-userid
     1489           , input "":U
     1490           , input sl-doc-type :list-item-pairs
     1491           , input cb-ob-liter
     1492           , input cb-ob-rubl
     1493           , input cb-ob-tal
     1494           , input no
     1495       ) no-error.
     1496       if error-status:error then message error-status:get-message(1) view-as alert-box.
     1497       run rep/r-wthob.p (
     1498             input v-begin-date
     1499           , input v-end-date
     1500           , input v-begin-shift
     1501           , input v-end-shift
     1502           , input x-SelectObject
     1503           , input v-ext-doc-type-list
     1504           , input cb-detal
     1505           , input cb-ob-liter
     1506           , input cb-ob-rubl
     1507           , input cb-ob-tal
     1508       ).
     1509   end.
     1510   END PROCEDURE.
     1511   PROCEDURE my-var :
     1512   assign frame F-Main
     1513       cb-detal
     1514       cb-ob-tal
     1515       cb-ob-liter
     1516       cb-ob-rubl
     1517   .
     1518   END PROCEDURE.
     1519   PROCEDURE select-doc-type :
     1520       define variable v-counter       as integer      no-undo.
     1521       define variable v-label         as character    no-undo.
     1522       define variable v-value         as character    no-undo.
     1523       define variable v-list          as character    no-undo.
     1524       define variable v-changed       as logical    no-undo.
     1525       define variable v-accepted      as logical    no-undo.
     1526       define variable v-list-edt      as character    no-undo.
     1527       define variable v-list-edt-full as character    no-undo.
     1528   do
     1529   with frame F-Main
     1530   on error undo, return error
     1531   :
     1532       assign
     1533           v-list-edt  = 'ie':U
     1534               + ",":U + 'ee':U
     1535               + ",":U + 'ip':U
     1536               + ",":U + 'ep':U
     1537               + ",":U + 'rp':U
     1538               + ",":U + 'ff':U
     1539               + ",":U + 'ef':U
     1540               + ",":U + 'rf':U
     1541               + ",":U + 'pc':U
     1542               + ",":U + 'ps':U
     1543               + ",":U + 'pz':U
     1544               + ",":U + 'df':U
     1545               + ",":U + 'dp':U
     1546               + ",":U + 'xc':U
     1547       .
     1548       assign
     1549           v-list-edt-full  = 'приход внешний':U
     1550                   + ",":U + 'расход внешний':U
     1551                   + ",":U + 'приход внутр. в зону погашения':U
     1552                   + ",":U + 'расход внутр. из зоны погашения':U
     1553                   + ",":U + 'возврат внутр. в зону погашения':U
     1554                   + ",":U + 'приход внутр. в своб. зону':U
     1555                   + ",":U + 'расход внутр. из своб. зоны':U
     1556                   + ",":U + 'возврат внутр. в своб зону':U
     1557                   + ",":U + 'погашение через кассу':U
     1558                   + ",":U + 'погашение за реализованное топливо':U
     1559                   + ",":U + 'возврат от покупателя':U
     1560                   + ",":U + 'уничтожение в свободной зоне':U
     1561                   + ",":U + 'уничтожение в зоне погашения':U
     1562                   + ",":U + 'обмен':U
     1563       .
     1564       run twowin_clear in this-procedure.
     1565       do v-counter = 1 to num-entries( v-list-edt-full )
     1566       on error undo, return error
     1567       :
     1568           assign
     1569               v-label = entry( v-counter, v-list-edt-full )
     1570               v-value = entry( v-counter, v-list-edt )
     1571           .
     1572           run twowin_add-item in this-procedure (
     1573                 input v-value
     1574               , input v-label
     1575               , input substitute( "Код вида документа: &1", v-value )
     1576               , input ( sl-doc-type :lookup( v-value ) <> 0 or sl-doc-type :list-item-pairs = "< Все >,''":U  )
     1577           ).
     1578       end.
     1579       run gbl/twowin.w (
     1580             input ?
     1581           , input 1
     1582           , input "Выбор видов документов":U
     1583           , input "":U
     1584           , input "&Тест"
     1585           , input table temp_twowin_items
     1586           , output table temp_twowin_itemsSelected
     1587           , output v-changed
     1588           , output v-accepted
     1589       ).
     1590       if v-accepted = yes
     1591           and v-changed = yes
     1592       then do:
     1593           assign
     1594               sl-doc-type :list-item-pairs    = "< Все >,''":U
     1595               v-list                          = "":U
     1596               v-counter = 0
     1597           .
     1598           for each temp_twowin_itemsSelected
     1599           by temp_twowin_itemsSelected.itm-key
     1600           :
     1601               assign
     1602                   v-counter = v-counter + 1
     1603                   v-list = substitute( "&1&2&3"
     1604                                   , v-list
     1605                                   , ( if v-list = "":U then "":U else ",":U )
     1606                                   , temp_twowin_itemsSelected.itmExtKey
     1607                                   )
     1608               .
     1609               if v-counter = 1
     1610               then do:
     1611                   assign
     1612                       sl-doc-type :list-item-pairs    = substitute( "&1,&2"
     1613                                           , entry( lookup( temp_twowin_itemsSelected.itmExtKey, v-list-edt ), v-list-edt-full )
     1614                                           , temp_twowin_itemsSelected.itmExtKey
     1615                                                )
     1616                   .
     1617               end.
     1618               else do:
     1619                   sl-doc-type :add-last (
     1620                       entry( lookup( temp_twowin_itemsSelected.itmExtKey, v-list-edt ), v-list-edt-full )
     1621                       , temp_twowin_itemsSelected.itmExtKey
     1622                   ).
     1623               end.
     1624           end.
     1625           if v-list = v-list-edt
     1626           then do:
     1627               assign
     1628                   sl-doc-type :list-item-pairs = "< Все >,''":U
     1629               .
     1630           end.
     1631       end.
     1632   end.
     1633   END PROCEDURE.
     1634   PROCEDURE state-changed :
     1635     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE    NO-UNDO.
     1636     DEFINE INPUT PARAMETER p-state      AS CHARACTER NO-UNDO.
     1637     CASE p-state:
     1638     END CASE.
     1639     END PROCEDURE.
