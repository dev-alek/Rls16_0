      841   procedure uf-get :
      842     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
      843     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
      844     define output parameter p-List_        like ubflt.usr-flt.List_        no-undo .
      845     define output parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
      846     define output parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
      847     define output parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
      848     define output parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
      849     define output parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
      850     do
      851     on error undo, return error
      852     :
      853       define buffer buf_usr-flt for ubflt.usr-flt .
      854       define variable v-use-List_     as logical   no-undo .
      855       define variable v-type-List_     as character no-undo .
      856       define variable v-format-List_   as character no-undo .
      857       define variable v-use-Naim      as logical   no-undo .
      858       define variable v-type-Naim      as character no-undo .
      859       define variable v-format-Naim    as character no-undo .
      860       define variable v-use-print-graft as logical   no-undo .
      861       define variable v-use-sort-gr     as logical   no-undo .
      862       define variable v-use-type-price  as logical   no-undo .
      863       define variable v-use-type-val    as logical   no-undo .
      864       define variable v-label          as character no-undo .
      865       define variable v-tooltip        as character no-undo .
      866       define variable v-user-can-edit  as logical   no-undo .
      867       define variable v-output-display as logical   no-undo .
      868       define variable v-other          as character no-undo .
      869       run uf-name in this-procedure
      870          (input  entry(1, p-code, chr(4))
      871         ,output v-use-List_
      872         ,output v-type-List_
      873         ,output v-format-List_
      874         ,output v-use-Naim
      875         ,output v-type-Naim
      876         ,output v-format-Naim
      877         ,output v-use-print-graft
      878         ,output v-use-sort-gr
      879         ,output v-use-type-price
      880         ,output v-use-type-val
      881         ,output v-label
      882         ,output v-tooltip
      883         ,output v-user-can-edit
      884         ,output v-output-display
      885         ,output v-other
      886         ) no-error .
      887       if error-status :error then do:
      888         undo, return error return-value .
      889       end.
      890       find first buf_usr-flt no-lock where
      891                  buf_usr-flt.Call-point     = p-code AND
      892                  buf_usr-flt.user-name       = p-user-name
      893         no-error .
      894       if avail buf_usr-flt then do:
      895         assign
      896         p-List_        = (if v-use-List_       then buf_usr-flt.List_       else ?)
      897         p-Naim         = (if v-use-Naim        then buf_usr-flt.Naim        else ?)
      898         p-print-graft  = (if v-use-print-graft then buf_usr-flt.print-graft else ?)
      899         p-sort-gr      = (if v-use-sort-gr     then buf_usr-flt.sort-gr     else ?)
      900         p-type-price   = (if v-use-type-price  then buf_usr-flt.type-price  else ?)
      901         p-type-val     = (if v-use-List_       then buf_usr-flt.type-val    else ?)
      902         .
      903       end.
      904       else do:
      905         assign
      906         p-List_        = (if v-use-List_       then "":U                    else ?)
      907         p-Naim         = (if v-use-Naim        then "":U                    else ?)
      908         p-print-graft  = (if v-use-print-graft then no                      else ?)
      909         p-sort-gr      = (if v-use-sort-gr     then no                      else ?)
      910         p-type-price   = (if v-use-type-price  then no                      else ?)
      911         p-type-val     = (if v-use-List_       then no                      else ?)
      912         .
      913       end.
      914     end.
      915   end procedure.
      916   procedure uf-set :
      917     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
      918     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
      919     define input  parameter p-List_        like ubflt.usr-flt.List_        no-undo .
      920     define input  parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
      921     define input  parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
      922     define input  parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
      923     define input  parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
      924     define input  parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
      925     do
      926     on error undo, return error
      927     :
      928       define buffer buf_usr-flt for ubflt.usr-flt .
      929       define variable v-use-List_     as logical   no-undo .
      930       define variable v-type-List_     as character no-undo .
      931       define variable v-format-List_   as character no-undo .
      932       define variable v-use-Naim      as logical   no-undo .
      933       define variable v-type-Naim      as character no-undo .
      934       define variable v-format-Naim    as character no-undo .
      935       define variable v-use-print-graft as logical   no-undo .
      936       define variable v-use-sort-gr   as logical   no-undo .
      937       define variable v-use-type-price as logical   no-undo .
      938       define variable v-use-type-val  as logical   no-undo .
      939       define variable v-tooltip        as character no-undo .
      940       define variable v-label          as character no-undo .
      941       define variable v-user-can-edit  as logical   no-undo .
      942       define variable v-output-display as logical   no-undo .
      943       define variable v-other          as character no-undo .
      944       run uf-name in this-procedure
      945         (input  entry(1, p-code, chr(4))
      946         ,output v-use-List_
      947         ,output v-type-List_
      948         ,output v-format-List_
      949         ,output v-use-Naim
      950         ,output v-type-Naim
      951         ,output v-format-Naim
      952         ,output v-use-print-graft
      953         ,output v-use-sort-gr
      954         ,output v-use-type-price
      955         ,output v-use-type-val
      956         ,output v-label
      957         ,output v-tooltip
      958         ,output v-user-can-edit
      959         ,output v-output-display
      960         ,output v-other
      961         ) no-error .
      962       if error-status :error then do:
      963         undo, return error return-value .
      964       end.
      965       find first buf_usr-flt where
      966                  buf_usr-flt.Call-point     = p-code AND
      967                  buf_usr-flt.user-name       = p-user-name
      968         no-error .
      969       if not avail buf_usr-flt then do:
      970           create buf_usr-flt .
      971           assign
      972           buf_usr-flt.call-point = p-code
      973           buf_usr-flt.user-name  = p-user-name
      974           .
      975       end.
      976       if avail buf_usr-flt then do:
      977        assign
      978        buf_usr-flt.List_       =  (if v-use-List_       then  p-List_        else ?)
      979        buf_usr-flt.Naim        =  (if v-use-Naim        then  p-Naim         else ?)
      980        buf_usr-flt.print-graft =  (if v-use-print-graft then  p-print-graft  else ?)
      981        buf_usr-flt.sort-gr     =  (if v-use-sort-gr     then  p-sort-gr      else ?)
      982        buf_usr-flt.type-price  =  (if v-use-type-price  then  p-type-price   else ?)
      983        buf_usr-flt.type-val    =  (if v-use-List_       then  p-type-val     else ?)
      984       .
      985       release buf_usr-flt.
      986       end.
      987       else undo, return error ("Ошибка при записи usr-flt" + substitute(" call-point=&1, user-name=&2", p-code, p-user-name)).
      988     end.
      989   end procedure.
      990   CREATE WIDGET-POOL.
