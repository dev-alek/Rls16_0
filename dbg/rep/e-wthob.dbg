      679   define temp-table temp_twowin_items no-undo
      680       field itm-key       as integer
      681       field itmExtKey     as character
      682       field itmName       as character
      683       field itmDesc       as character
      684       field itmSelected   as logical
      685       field selLeft       as logical
      686       field selRight      as logical
      687       index pi is primary unique
      688           itm-key
      689       index ie
      690           itmExtKey
      691   .
      692   define temp-table temp_twowin_itemsSelected no-undo
      693       field its-key   as integer
      694       field itm-key   as integer
      695       field itmExtKey as character
      696       index pi is primary unique
      697           its-key
      698       index im
      699           itm-key
      700   .
      701   define variable v-twowin13-itm-key    as integer      no-undo.
      702   procedure twowin_clear :
      703       define buffer buf_temp_twowin_items        for temp_twowin_items.
      704   do
      705   for buf_temp_twowin_items
      706   on error undo, return error
      707   :
      708       empty temp-table buf_temp_twowin_items.
      709   end.
      710   end procedure.
      711   procedure twowin_add-item :
      712   define input parameter p-ext-key   as character        no-undo.
      713   define input parameter p-item-name as character        no-undo.
      714   define input parameter p-item-desc as character        no-undo.
      715   define input parameter p-selected  as logical          no-undo.
      716       define buffer buf_temp_twowin_items        for temp_twowin_items.
      717   do
      718   for buf_temp_twowin_items
      719   on error undo, return error
      720   :
      721       assign
      722           v-twowin13-itm-key = v-twowin13-itm-key + 1
      723       .
      724       create temp_twowin_items.
      725       assign
      726           temp_twowin_items.itm-key      = v-twowin13-itm-key
      727           temp_twowin_items.itmExtKey    = p-ext-key
      728           temp_twowin_items.itmName      = p-item-name
      729           temp_twowin_items.itmDesc      = p-item-desc
      730           temp_twowin_items.itmSelected  = p-selected
      731           temp_twowin_items.selLeft      = no
      732           temp_twowin_items.selRight     = no
      733       .
      734   end.
      735   end procedure.
      736   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
