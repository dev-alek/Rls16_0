     1047   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
     1048   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
     1049   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
     1050   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
     1051         adm-object-hdl = FRAME F-Main:HANDLE.
     1052   RUN ensure-broker.
     1053   THIS-PROCEDURE:ADM-DATA =
     1054        'ADM1.1~`':U +
     1055        'SmartViewer~`':U +
     1056        '~`':U +
     1057        'NO ~`':U +
     1058        '~`':U +
     1059        '~`':U +
