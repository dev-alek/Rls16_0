      410   procedure prn-lib-open-stream :
      411     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      412     define input parameter p-page-size    as integer no-undo .
      413     define input parameter p-is-stream    as logical no-undo .
      414     define input parameter p-append       as logical no-undo .
      415     define variable v-report-name as character no-undo .
      416     do
      417       on error undo, return error
      418       :
      419       run prn-lib-get-report-name  in this-procedure (
      420         input parParentProc
      421         ,output v-report-name
      422         ).
      423       if p-is-stream then
      424       do:
      425         if p-append then
      426         do:
      427           output stream PrnLibStream to value( v-report-name )
      428             page-size value(p-page-size) append .
      429         end.
      430         if not p-append then
      431         do:
      432           output stream PrnLibStream to value( v-report-name )
      433             page-size value(p-page-size) .
      434         end.
      435       end.
      436       if not p-is-stream then
      437       do:
      438         if p-append then
      439         do:
      440           output to value( v-report-name )
      441             page-size value(p-page-size) append .
      442         end.
      443         if not p-append then
      444         do:
      445           output to value( v-report-name )
      446             page-size value(p-page-size) .
      447         end.
      448       end.
      449     end.
      450   end procedure.
      451   procedure prn-lib-open-exp :
      452     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      453     define input parameter p-is-stream    as logical no-undo .
      454     define input parameter p-is-append    as logical no-undo .
      455     define output parameter p-ReportFileName as char init "report" no-undo.
      456     define output parameter p-process as logical no-undo .
      457     define variable glog as logical no-undo .
      458     do
      459       on error undo, return error
      460       :
      461       SYSTEM-DIALOG GET-FILE p-ReportFileName
      462         TITLE      "Укажите путь"
      463         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      464         ASK-OVERWRITE
      465         CREATE-TEST-FILE
      466         SAVE-AS
      467         USE-FILENAME
      468         DEFAULT-EXTENSION "txt"
      469         UPDATE glog
      470         .
      471       if not glog then  return.
      472       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      473       if p-is-stream then
      474       do:
      475         if p-is-append then
      476         do:
      477           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      478         end.
      479         else
      480         do:
      481           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      482         end.
      483       end.
      484       else
      485       do:
      486         if p-is-append then
      487         do:
      488           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      489         end.
      490         else
      491         do:
      492           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      493         end.
      494       end.
      495       p-process = yes.
      496     end.
      497   end procedure.
      498   procedure prn-lib-get-report-name :
      499     define input parameter parParentProc  as widget-handle no-undo.
      500     define output parameter p-report-name as character no-undo .
      501     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      502   end procedure.
      503   procedure prn-lib-reportviewer-report-name :
      504     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      505     define input parameter p-report-name-html as character no-undo .
      506     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      507   end procedure.
      508   procedure prn-lib-reportviewer :
      509     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      510     define input parameter p-report-name-html as character no-undo .
      511     define input parameter p-param        as character no-undo .
      512     define variable v-excel           as character no-undo init 'TRUE' .
      513     define variable v-value-character as character no-undo .
      514     define variable v-value-integer   as character no-undo .
      515     define variable v-value-date      as date      no-undo .
      516     define variable v-value-decimal   as decimal   no-undo .
      517     define variable rep-excel         as logical   no-undo .
      518     define variable excel-string      as character no-undo .
      519     define variable v-param-type      as character no-undo .
      520     define variable v-tth             as handle    no-undo .
      521     run adm/shattri.p (
      522       input "get":U
      523       ,input  ""
      524       ,input  0
      525       ,input  'report-glob':U
      526       ,input  'rep-excel':U
      527       ,output v-value-character
      528       ,output v-value-date
      529       ,output v-value-decimal
      530       ,output v-value-integer
      531       ,output rep-excel
      532       ,output v-param-type
      533       ,INPUT-OUTPUT table-handle v-tth
      534       )  .
      535     if rep-excel then v-excel = "TRUE" .
      536     else v-excel = "FALSE" .
      537     if p-param eq ""
      538     then
      539        p-param = "EXCEL:" + v-excel.
      540     else
      541        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      542     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      543   end procedure.
