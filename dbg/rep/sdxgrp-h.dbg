      362   define new shared variable PrintRubl          as logical   no-undo .
      363   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      364   define  stream PrnLibStream.
      365   procedure prn-lib-prn-file :
      366     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      367     define input parameter p-DIsabledoptions as integer no-undo .
      368     define variable v-report-name as character no-undo .
      369     define variable v-user-action as character no-undo .
