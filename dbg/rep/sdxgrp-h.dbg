      379   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      380   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      381     (input  v-report-name
      382     ,input  2
      383     ,output v-exist
      384     )  .
      385       if NOT v-exist then
      386       DO:
      387         Message
      388           "Нет заданий на печать ! "
      389           view-as alert-box .
      390         Return  .
      391       End.
      392       run gbl/prnfilen.w
      393         (input  ""
      394         ,input  p-DisabledOptions
      395         ,input  string(v-report-name )
      396         ,input  7
      397         ,output v-user-action
      398         ,output v-printed
      399         ) .
      400       if v-printed then
      401       do:
      402         return "YES" .
      403       end.
      404       else
      405       do:
      406         return "NO" .
      407       end.
      408     end.
