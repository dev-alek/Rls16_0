      568       grp-code other-code
      569         .
      570   define SHARED temp-table temp-dis-card-type no-undo like ub.dis-card-type.
      571   define variable full-name as char.
      572   define buffer for-grp for ub.gds-grp.
      573   define variable LL AS INTEGER.
      574   define variable tot-nc as integer no-undo.
      575   define variable ii as integer     no-undo .
      576   define variable kk as integer     no-undo .
      577   define variable cycle as integer no-undo .
      578   define variable v-obj-code like ub.clients.obj-code no-undo .
      579   define variable v-obj-name like ub.clients.obj-name no-undo .
      580   define variable accum-num-chk as integer extent 24 no-undo .
      581   define variable accum-tot-nc as integer no-undo .
      582   define variable accum-obj-list as integer no-undo .
      583   define buffer cli-obj for ub.clients .
      584   for each obj-list no-lock:
      585     assign
      586     accum-obj-list = accum-obj-list + 1.
      587     if accum-obj-list > 1 then LEAVE.
      588   end.
      589   run prn-lib-open-stream  in this-procedure (
      590                                                input parParentProc
      591                                               ,input 62
      592                                               ,input yes
      593                                               ,input no
      594                                               ).
      595   PUT stream PrnLibStream
      596       "Почасовая статистика розничных продаж" format "x(80)" SKIP(0)
      597       ("( ПО ВЕЛИЧИНЕ СУММ ПРОДАЖ - ЧЕКИ) ЗА ПЕРИОД c" +
      598       string( startdate, "99/99/9999" ) + " по " + string( enddate, "99/99/9999" ) + ".")      format "x(80)" SKIP(0)
      599       IF RETS then "ВОЗВРАТЫ УЧТЕНЫ" ELSE "" format "x(80)" SKIP(0).
      600   if t-dis-card then do:
      601     PUT stream PrnLibStream UNFORMATTED
      602     "Только покупки по дисконтным картам" skip.
      603     if rs-dis-card = 1 then do:
      604       for each temp-dis-card-type No-LOCK:
      605         PUT stream PrnLibStream UNFORMATTED
      606         temp-dis-card-type.type
      607         skip.
      608       END.
      609     end.
      610   end.
      611   PUT stream PrnLibStream UNFORMATTED SelectObject  skip(0)
      612   (if byobject then "С разбивкой по объектам" else '':U) skip(1)
      613   .
      614   PUT stream PrnLibStream UNFORMATTED
      615   SKIP
      616   cur-time-print() format "x(35)" SKIP.
      617   PUT stream PrnLibStream  UNFORMATTED
      618   "Сумма_чека"  p-XL-delim
      619   "0.00-0.59" p-XL-delim
      620   "1.00-1.59" p-XL-delim
      621   "2.00-2.59" p-XL-delim
      622   "3.00-3.59" p-XL-delim
      623   "4.00-4.59" p-XL-delim
      624   "5.00-5.59" p-XL-delim
      625   "6.00-6.59" p-XL-delim
      626   "7.00-7.59" p-XL-delim
      627   "8.00-8.59" p-XL-delim
      628   "9.00-9.59" p-XL-delim
      629   "0.00-10.59" p-XL-delim
      630   "11.00-11.59" p-XL-delim
      631   "12.00-12.59" p-XL-delim
      632   "13.00-13.59" p-XL-delim
      633   "14.00-14.59" p-XL-delim
      634   "15.00-15.59" p-XL-delim
      635   "16.00-16.59" p-XL-delim
      636   "17.00-17.59" p-XL-delim
      637   "18.00-18.59" p-XL-delim
      638   "19.00-19.59" p-XL-delim
      639   "20.00-20.59" p-XL-delim
      640   "21.00-21.59" p-XL-delim
      641   "22.00-22.59" p-XL-delim
      642   "23.00-23.59" p-XL-delim
      643   "Итого_по_строке" p-XL-delim skip.
      644   _cycle:
      645   do cycle = 1 to 0 by -1:
      646     if byobject and cycle = 0 and accum-obj-list = 1 then LEAVE _cycle.
      647     _obj-list:
      648     for each obj-list no-lock:
      649       if not byobject and cycle = 1 then LEAVE _obj-list.
      650       if cycle = 1 then v-obj-code = obj-list.obj-code.
      651       if cycle = 0 then v-obj-code = 0.
      652       assign
      653       tot-nc = 0
      654       accum-num-chk[1] =  0
      655       accum-num-chk[2] =  0
      656       accum-num-chk[3] =  0
      657       accum-num-chk[4] =  0
      658       accum-num-chk[5] =  0
      659       accum-num-chk[6] =  0
      660       accum-num-chk[7] =  0
      661       accum-num-chk[8] =  0
      662       accum-num-chk[9] =  0
      663       accum-num-chk[10] = 0
      664       accum-num-chk[11] = 0
      665       accum-num-chk[12] = 0
      666       accum-num-chk[13] = 0
      667       accum-num-chk[14] = 0
      668       accum-num-chk[15] = 0
      669       accum-num-chk[16] = 0
      670       accum-num-chk[17] = 0
      671       accum-num-chk[18] = 0
      672       accum-num-chk[19] = 0
      673       accum-num-chk[20] = 0
      674       accum-num-chk[21] = 0
      675       accum-num-chk[22] = 0
      676       accum-num-chk[23] = 0
      677       accum-num-chk[24] = 0
      678       accum-tot-nc = 0
      679       .
      680       if cycle = 1 then do:
      681         FIND FIRST ub.clients NO-LOCK WHERE
      682                   ub.clients.obj-code = v-obj-code AND
      683                   ub.clients.obj-type = 'маг':U NO-ERROR.
      684         if available ub.clients then do:
      685           v-obj-name = replace(ub.clients.obj-name, chr(32) , "_").
      686         end.
      687         else v-obj-name = string(v-obj-code).
      688       end.
      689       if byobject and cycle = 0 then do:
      690         v-obj-name = "ПО_ВСЕМ_ОБЪЕКТАМ".
      691       end.
      692       PUT stream PrnLibStream UNFORMATTED
      693       v-obj-name p-XL-delim
      694       SKIP.
      695       _sum-vals:
      696       for each sum-vals:
      697          find first grp-h WHERE
      698                    grp-h.obj-code = v-obj-code
      699               AND  grp-h.sum = sum-vals.sum1 no-error .
      700         if not available grp-h and v-obj-code > 0 and accum-obj-list > 1 then next.
      701         if available grp-h then do:
      702           tot-nc =  grp-h.num-chk[1] + grp-h.num-chk[2] + grp-h.num-chk[3] +
      703                         grp-h.num-chk[4] + grp-h.num-chk[5] + grp-h.num-chk[6] + grp-h.num-chk[7] +
      704                         grp-h.num-chk[8] + grp-h.num-chk[9] + grp-h.num-chk[10] + grp-h.num-chk[11] +
      705                         grp-h.num-chk[12] + grp-h.num-chk[13] + grp-h.num-chk[14] + grp-h.num-chk[15] +
      706                         grp-h.num-chk[16] + grp-h.num-chk[17] + grp-h.num-chk[18] + grp-h.num-chk[19] +
      707                         grp-h.num-chk[20] + grp-h.num-chk[21] + grp-h.num-chk[22] + grp-h.num-chk[23] +
      708                         grp-h.num-chk[24].
      709           PUT STREAM PrnLibStream UNFORMATTED
      710           (string(sum-vals.sum1) + "_" + string(sum-vals.sum2) ) p-XL-delim
      711           grp-h.num-chk[1] p-XL-delim
      712           grp-h.num-chk[2] p-XL-delim
      713           grp-h.num-chk[3] p-XL-delim
      714           grp-h.num-chk[4] p-XL-delim
      715           grp-h.num-chk[5] p-XL-delim
      716           grp-h.num-chk[6] p-XL-delim
      717           grp-h.num-chk[7] p-XL-delim
      718           grp-h.num-chk[8] p-XL-delim
      719           grp-h.num-chk[9] p-XL-delim
      720           grp-h.num-chk[10] p-XL-delim
      721           grp-h.num-chk[11] p-XL-delim
      722           grp-h.num-chk[12] p-XL-delim
      723           grp-h.num-chk[13] p-XL-delim
      724           grp-h.num-chk[14] p-XL-delim
      725           grp-h.num-chk[15] p-XL-delim
      726           grp-h.num-chk[16] p-XL-delim
      727           grp-h.num-chk[17] p-XL-delim
      728           grp-h.num-chk[18] p-XL-delim
      729           grp-h.num-chk[19] p-XL-delim
      730           grp-h.num-chk[20] p-XL-delim
      731           grp-h.num-chk[21] p-XL-delim
      732           grp-h.num-chk[22] p-XL-delim
      733           grp-h.num-chk[23] p-XL-delim
      734           grp-h.num-chk[24] p-XL-delim
      735           tot-nc
      736           skip.
      737           ASSIGN
      738           accum-num-chk[1] = accum-num-chk[1] + grp-h.num-chk[1]
      739           accum-num-chk[2] = accum-num-chk[2] + grp-h.num-chk[2]
      740           accum-num-chk[3] = accum-num-chk[3] + grp-h.num-chk[3]
      741           accum-num-chk[4] = accum-num-chk[4] + grp-h.num-chk[4]
      742           accum-num-chk[5] = accum-num-chk[5] + grp-h.num-chk[5]
      743           accum-num-chk[6] = accum-num-chk[6] + grp-h.num-chk[6]
      744           accum-num-chk[7] = accum-num-chk[7] + grp-h.num-chk[7]
      745           accum-num-chk[8] = accum-num-chk[8] + grp-h.num-chk[8]
      746           accum-num-chk[9] = accum-num-chk[9] + grp-h.num-chk[9]
      747           accum-num-chk[10] = accum-num-chk[10] + grp-h.num-chk[10]
      748           accum-num-chk[11] = accum-num-chk[11] + grp-h.num-chk[11]
      749           accum-num-chk[12] = accum-num-chk[12] + grp-h.num-chk[12]
      750           accum-num-chk[13] = accum-num-chk[13] + grp-h.num-chk[13]
      751           accum-num-chk[14] = accum-num-chk[14] + grp-h.num-chk[14]
      752           accum-num-chk[15] = accum-num-chk[15] + grp-h.num-chk[15]
      753           accum-num-chk[16] = accum-num-chk[16] + grp-h.num-chk[16]
      754           accum-num-chk[17] = accum-num-chk[17] + grp-h.num-chk[17]
      755           accum-num-chk[18] = accum-num-chk[18] + grp-h.num-chk[18]
      756           accum-num-chk[19] = accum-num-chk[19] + grp-h.num-chk[19]
      757           accum-num-chk[20] = accum-num-chk[20] + grp-h.num-chk[20]
      758           accum-num-chk[21] = accum-num-chk[21] + grp-h.num-chk[21]
      759           accum-num-chk[22] = accum-num-chk[22] + grp-h.num-chk[22]
      760           accum-num-chk[23] = accum-num-chk[23] + grp-h.num-chk[23]
      761           accum-num-chk[24] = accum-num-chk[24] + grp-h.num-chk[24]
      762           accum-tot-nc = accum-tot-nc + tot-nc
      763           .
      764         end.
      765         else do:
      766           PUT STREAM PrnLibStream UNFORMATTED
      767           (string(sum-vals.sum1) + "_" + string(sum-vals.sum2) ) p-XL-delim
      768           0 p-XL-delim
      769           0 p-XL-delim
      770           0 p-XL-delim
      771           0 p-XL-delim
      772           0 p-XL-delim
      773           0 p-XL-delim
      774           0 p-XL-delim
      775           0 p-XL-delim
      776           0 p-XL-delim
      777           0 p-XL-delim
      778           0 p-XL-delim
      779           0 p-XL-delim
      780           0 p-XL-delim
      781           0 p-XL-delim
      782           0 p-XL-delim
      783           0 p-XL-delim
      784           0 p-XL-delim
      785           0 p-XL-delim
      786           0 p-XL-delim
      787           0 p-XL-delim
      788           0 p-XL-delim
      789           0 p-XL-delim
      790           0 p-XL-delim
      791           0 p-XL-delim
      792           0
      793           skip.
      794         end.
      795       end.
      796       PUT stream PrnLibStream UNFORMATTED
      797       substitute("Итого_&1", v-obj-name) p-XL-delim
      798       accum-num-chk[1]  p-XL-delim
      799       accum-num-chk[2]  p-XL-delim
      800       accum-num-chk[3]  p-XL-delim
      801       accum-num-chk[4]  p-XL-delim
      802       accum-num-chk[5]  p-XL-delim
      803       accum-num-chk[6]  p-XL-delim
      804       accum-num-chk[7]  p-XL-delim
      805       accum-num-chk[8]  p-XL-delim
      806       accum-num-chk[9]  p-XL-delim
      807       accum-num-chk[10] p-XL-delim
      808       accum-num-chk[11] p-XL-delim
      809       accum-num-chk[12] p-XL-delim
      810       accum-num-chk[13] p-XL-delim
      811       accum-num-chk[14] p-XL-delim
      812       accum-num-chk[15] p-XL-delim
      813       accum-num-chk[16] p-XL-delim
      814       accum-num-chk[17] p-XL-delim
      815       accum-num-chk[18] p-XL-delim
      816       accum-num-chk[19] p-XL-delim
      817       accum-num-chk[20] p-XL-delim
      818       accum-num-chk[21] p-XL-delim
      819       accum-num-chk[22] p-XL-delim
      820       accum-num-chk[23] p-XL-delim
      821       accum-num-chk[24] p-XL-delim
      822       accum-tot-nc
      823       skip
      824       .
      825       if byobject and cycle = 0 then LEAVE _obj-list.
      826     end.
      827   END .
      828   output stream PrnLibStream CLOSE .
