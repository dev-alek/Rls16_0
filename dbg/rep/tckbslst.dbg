      919   procedure scnb-list-b-code :
      920     do
      921     on error undo, return error
      922     :
      923   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      924   define variable v-value16 as character no-undo .
      925   if NOT can-find(first scnblist) then
      926       RETURN.
      927   for each scnblist
      928   by scnblist.b-code
      929   :
      930     if scnblist.b-str = "":U then next.
      931     find ub.goods no-lock
      932       where ub.goods.prod-type = scnblist.prod-type
      933         and ub.goods.prod-code = scnblist.prod-code
      934         and ub.goods.artic = scnblist.artic
      935     .
      936     find ub.gds-prt no-lock
      937       where ub.gds-prt.upper-code = ub.goods.prt-root
      938     .
      939     if scnblist.qnty = ? then do:
      940       run gbl/d-prompt.w (
      941         'title=':u +  substitute("ЕАН &1" , scnblist.b-str )  + '\':u
      942       + 'text1=':u + substitute("Для товара  &1 &2" ,  ub.goods.artic , ub.goods.gds-name )  + '\':u
      943       + 'text2=':u + "Введите количество" + '\':u
      944       + 'format=' + ">>>>9" + '\':u
      945       + 'type=' + 'I':U + '\':u
      946       + 'fillin_row=3\':u
      947       + 'fillin_col=4\':u
      948       + 'fillin_width=7\':u
      949       + 'fillin_height=1\':u
      950       + 'max-chars=5\':u
      951       + 'readonly=no\':u
      952       , input-output v-value16
      953       ).
      954       if return-value = 'false':u
      955           then scnblist.qnty .
      956           else scnblist.qnty = int(v-value16) .
      957     end.
      958     assign
      959       rootnode_code = ub.gds-prt.node-code
      960       list-qnty = scnblist.qnty
      961     .
      962     if v-cntxp-doc-prt AND TickOnS AND can-find(first ub.gds-prt where ub.gds-prt.upper-code = rootnode_code) then do:
      963       assign
      964         prn-prt = TRUE
      965       .
      966     end.
      967     else do:
      968       assign
      969         prn-prt = FALSE
      970       .
      971     end.
      972     find first ub.bar-code no-lock where
      973               ub.bar-code.b-code = scnblist.b-code no-error .
      974     if available ub.bar-code then do:
      975       if scnblist.b-str <> "":U
      976       and not scnblist.loc-ean then do:
      977         define buffer buf_prod-bc for ub.prod-bc.
      978         find first buf_prod-bc where buf_prod-bc.b-code =
      979                     scnblist.b-code
      980                 AND buf_prod-bc.b-str = scnblist.b-str no-error .
      981         ListProdbc = buf_prod-bc.b-str.
      982         do on error undo, return error :
      983           if prn-prt = false     and bar-code.node-code <> rootnode_code   then do:     next.   end.   if prn-prt = true then do:     find first gds-prt no-lock       where gds-prt.node-code = bar-code.node-code     .     if gds-prt.is-term = false then do:       next.     end.   end.
