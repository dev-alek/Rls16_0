      535   run adm/shattri.p (
      536       input "get":U
      537       ,input  p-obj-type
      538       ,input  p-obj-code
      539       ,input  'cd-sending':U
      540       ,input  'dflt-cd':U
      541       ,output dflt-cd
      542       ,output v-value-date10
      543       ,output v-value-decimal10
      544       ,output v-value-integer10
      545       ,output v-value-logical10
      546       ,output v-param-type10
      547       ,INPUT-OUTPUT table-handle v-tth10
      548       )  .
      549   delete object v-tth10 no-error.
      550   how-pcnt-kat = ''.
      551   run adm/shattri.p (
      552       input "get":U
      553       ,input  p-obj-type
      554       ,input  p-obj-code
      555       ,input  'cd-inf-send':U
      556       ,input  'how-pcnt-kat':U
      557       ,output how-pcnt-kat
      558       ,output v-value-date9
      559       ,output v-value-decimal9
      560       ,output v-value-integer9
      561       ,output v-value-logical9
      562       ,output v-param-type9
      563       ,INPUT-OUTPUT table-handle v-tth9
      564       ) no-error .
      565   delete object v-tth9.
      566   if how-pcnt-kat = 'pcnt-kat-pdf':U then do:
      567     find first  buf_dis-thbj-rule9 No-LOCK  where
      568                 buf_dis-thbj-rule9.obj-type = p-obj-type
      569           AND  buf_dis-thbj-rule9.obj-code = p-obj-code
      570           and  buf_dis-thbj-rule9.pos-type = dflt-cd
      571           and  buf_dis-thbj-rule9.discnt-role = 'pcnt-kat-pdf':U
      572           and  buf_dis-thbj-rule9.nonunique = ''
      573           no-error .
      574     if not available buf_dis-thbj-rule9 then do:
      575   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      576   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      577     (input  p-obj-type
      578     ,input  p-obj-code
      579     ,output v-host-code9
      580     )  .
      581       find first  buf_dis-thbj-rule9 No-LOCK  where
      582                   buf_dis-thbj-rule9.obj-code = v-host-code9
      583             AND  buf_dis-thbj-rule9.obj-type = 'орг':U
      584             and  buf_dis-thbj-rule9.pos-type = dflt-cd
      585             and  buf_dis-thbj-rule9.discnt-role = 'pcnt-kat-pdf':U
      586             and  buf_dis-thbj-rule9.nonunique = ''
      587             no-error .
      588     end.
      589     if not available buf_dis-thbj-rule9 then do:
      590       find first  buf_dis-thbj-rule9 No-LOCK  where
      591                   buf_dis-thbj-rule9.obj-code = 0
      592             AND  buf_dis-thbj-rule9.obj-type = ''
      593             and  buf_dis-thbj-rule9.pos-type = dflt-cd
      594             and  buf_dis-thbj-rule9.discnt-role = 'pcnt-kat-pdf':U
      595             and  buf_dis-thbj-rule9.nonunique = ''
      596             no-error .
      597     end.
      598     if available buf_dis-thbj-rule9 then do:
      599       how-pcnt-kat = how-pcnt-kat + "=" + string(buf_dis-thbj-rule9.rule-num).
      600     end.
      601     else do:
      602       how-pcnt-kat = how-pcnt-kat + "="  + string(0).
      603     end.
      604   end.
      605   tickons = yes.
      606   action = "list-bb".
      607   CASE List-sort:
      608     when "artic":U then do:
      609       run scnb-list-artic in this-procedure .
      610     end.
      611     when "b-code":U then do:
      612       run scnb-list-b-code in this-procedure .
      613     end.
      614     when "order-num":U then do:
      615       run scnb-list-order-num in this-procedure .
      616     end.
      617     when "gds-name":U then do:
      618       run scnb-list-gds-name in this-procedure .
      619     end.
