      739                 ,input list-qnty
      740                 ,input pr-doc-rubl
      741                 ,input pr-doc-rb
      742                 ,input pr-doc-rubl-old
      743                 ,input pr-doc-rb-old
      744                 ,input v-fact-order
      745                 ,input ListProdBc
      746                 ,input curr-rate
      747                 ,input TickPS
      748                 ,input dflt-cd
      749                 ,input how-pcnt-kat
      750                 ,input-output b-count
      751                 ,input v-part-code
      752                 ,input v-doc-code
      753                 ,input v-promo-code
      754                 ,input v-ActionId
      755                 ,input v-db-num
      756                 ) no-error .
