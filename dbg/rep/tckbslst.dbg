      121   def new shared var bc-frmt as character no-undo .
      122   def new shared var bc-pfx  as character no-undo .
      123   def var bc-par-type as character no-undo .
      124       run gbl/conf-rd.p ("bc-frmt", "", "", 0, "", "", "",  no , output bc-frmt, output bc-par-type) no-error.
      125       if "new" = "bc" AND ( error-status:error OR bc-par-type <> "C":U OR not can-do ("EAN8,EAN13", bc-frmt) ) then
      126           do:
      127               message "Не задан или не верно задан ТИП собственного бар-кода!"
      128                   view-as alert-box ERROR TITLE "".
      129               return error.
      130           end.
      131       run gbl/conf-rd.p ("bc-pfx", "", "", 0, "", "", "",  no , output bc-pfx, output bc-par-type) no-error.
      132       if "new" = "bc" AND ( error-status:error OR bc-par-type <> "C":U ) then
      133           do:
      134               message "Не задан или не верно задан ПРЕФИКС бар-кода складского места!"
      135                   view-as alert-box ERROR TITLE "".
      136               return error.
      137           end.
      138   PROCEDURE gen-bc:
      139     def input  parameter internal-b-code like ub.bar-code.b-code no-undo .
      140     def output parameter full-b-code     as character init ""    no-undo .
      141   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      142     define variable tmp-str2  as character no-undo.
      143     define variable tmp-num2  as character no-undo.
      144     define variable i2        as integer   no-undo.
      145     define variable sum2      as integer   no-undo.
      146     define variable len-code2 as integer   no-undo.
      147     define variable varcont2  as logical   initial yes no-undo.
      148     CASE bc-frmt :
      149       WHEN "EAN13" THEN do:
      150         assign
      151           tmp-str2 = string( internal-b-code, "999999999999" )
      152         .
      153       end.
      154       WHEN "EAN8" THEN do:
      155         assign
      156           tmp-str2 = string( internal-b-code, "9999999" )
      157         .
      158       end.
      159       OTHERWISE DO:
      160           message "Неизвестный тип генерации бар-кода процедурой bc-gnrti.i: " bc-frmt " ."
      161           view-as alert-box error.
      162           return error.
      163       END.
      164     END CASE.
      165     if varcont2 = yes then do:
      166       if integer( substring( tmp-str2, 1, length( bc-pfx ) ) ) <> 0
      167       then do:
      168         message
      169           "Невозможно сформировать бар-код" SKIP
      170           "для товара с кодом: " internal-b-code
      171           view-as alert-box error title "подрезание кода".
      172         return error.
      173       end.
      174       else do:
      175         assign
      176           full-b-code = bc-pfx + substring( tmp-str2, length( bc-pfx ) + 1, length( tmp-str2 ) - length( bc-pfx ) )
      177           len-code2    = length( full-b-code )
      178         .
      179         define variable v-sum-char2 as character no-undo .
      180         assign
      181           sum2 = 0
      182         .
      183         do i2 = 1 to len-code2 by 2
      184         :
      185           assign
      186             v-sum-char2 = substr(full-b-code, len-code2 - i2 + 1, 1)
      187           .
      188           if v-sum-char2 < "0"
      189           or v-sum-char2 > "9"
      190           then do:
      191             message
      192               "Невозможно сформировать бар-код" skip
      193               "для товара с кодом: " internal-b-code skip
      194               view-as alert-box error title "подсчет контрольной суммы".
      195             return error.
      196           end.
      197           assign
      198             sum2 = sum2 + integer(v-sum-char2)
      199           .
      200         end.
      201         if varcont2 = yes then do:
      202           assign
      203             sum2 = sum2 * 3
      204           .
      205           do i2 = 2 to len-code2 by 2
      206           :
      207             assign
      208               v-sum-char2 = substr(full-b-code, len-code2 - i2 + 1, 1)
      209             .
      210             if v-sum-char2 < "0"
      211             or v-sum-char2 > "9"
      212             then do:
      213               message
      214                 "Невозможно сформировать бар-код" skip
      215                 "для товара с кодом: " internal-b-code skip
      216                 view-as alert-box error title "подсчет контрольной суммы".
      217               return error.
      218             end.
      219             assign
      220               sum2 = sum2 + integer(v-sum-char2)
      221             .
      222           end.
      223           if varcont2 = yes then do:
      224              if sum2 mod 10 = 0 then do:
      225                assign
      226                  full-b-code = full-b-code + '0'
      227                .
      228              end.
      229              else do:
      230                assign
      231                  full-b-code = full-b-code + string(10 - sum2 mod 10)
      232                .
      233              end.
      234           end.
      235         end.
      236       end.
      237     end.
      238   END PROCEDURE.
      239   def new shared var pl-frmt as character no-undo .
      240   def new shared var pl-pfx  as character no-undo .
      241   def var pl-par-type as character no-undo .
      242       run gbl/conf-rd.p ("pl-frmt", "", "", 0, "", "", "",  no , output pl-frmt, output pl-par-type) no-error.
      243       if "new" = "bc" AND ( error-status:error OR pl-par-type <> "C":U OR not can-do ("EAN8,EAN13", pl-frmt) ) then
      244           do:
      245               message "Не задан или не верно задан ТИП собственного бар-кода!"
      246                   view-as alert-box ERROR TITLE "".
      247               return error.
      248           end.
      249       run gbl/conf-rd.p ("pl-pfx", "", "", 0, "", "", "",  no , output pl-pfx, output pl-par-type) no-error.
      250       if "new" = "bc" AND ( error-status:error OR pl-par-type <> "C":U ) then
      251           do:
      252               message "Не задан или не верно задан ПРЕФИКС бар-кода складского места!"
      253                   view-as alert-box ERROR TITLE "".
      254               return error.
      255           end.
      256   PROCEDURE gen-pl:
