      621   procedure scnb-list-gds-name :
      622     do
      623     on error undo, return error
      624     :
      625   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      626   define variable v-value12 as character no-undo .
      627   if NOT can-find(first scnblist) then
      628       RETURN.
      629   for each scnblist
      630   by scnblist.gds-name
      631   :
      632     if scnblist.b-str = "":U then next.
      633     find ub.goods no-lock
      634       where ub.goods.prod-type = scnblist.prod-type
      635         and ub.goods.prod-code = scnblist.prod-code
      636         and ub.goods.artic = scnblist.artic
      637     .
      638     find ub.gds-prt no-lock
      639       where ub.gds-prt.upper-code = ub.goods.prt-root
      640     .
      641     if scnblist.qnty = ? then do:
      642       run gbl/d-prompt.w (
      643         'title=':u +  substitute("ЕАН &1" , scnblist.b-str )  + '\':u
      644       + 'text1=':u + substitute("Для товара  &1 &2" ,  ub.goods.artic , ub.goods.gds-name )  + '\':u
      645       + 'text2=':u + "Введите количество" + '\':u
      646       + 'format=' + ">>>>9" + '\':u
      647       + 'type=' + 'I':U + '\':u
      648       + 'fillin_row=3\':u
      649       + 'fillin_col=4\':u
      650       + 'fillin_width=7\':u
      651       + 'fillin_height=1\':u
      652       + 'max-chars=5\':u
      653       + 'readonly=no\':u
      654       , input-output v-value12
      655       ).
      656       if return-value = 'false':u
      657           then scnblist.qnty .
      658           else scnblist.qnty = int(v-value12) .
      659     end.
      660     assign
      661       rootnode_code = ub.gds-prt.node-code
      662       list-qnty = scnblist.qnty
      663     .
      664     if v-cntxp-doc-prt AND TickOnS AND can-find(first ub.gds-prt where ub.gds-prt.upper-code = rootnode_code) then do:
      665       assign
      666         prn-prt = TRUE
      667       .
      668     end.
      669     else do:
      670       assign
      671         prn-prt = FALSE
      672       .
      673     end.
      674     find first ub.bar-code no-lock where
      675               ub.bar-code.b-code = scnblist.b-code no-error .
      676     if available ub.bar-code then do:
      677       if scnblist.b-str <> "":U
      678       and not scnblist.loc-ean then do:
      679         define buffer buf_prod-bc for ub.prod-bc.
      680         find first buf_prod-bc where buf_prod-bc.b-code =
      681                     scnblist.b-code
      682                 AND buf_prod-bc.b-str = scnblist.b-str no-error .
      683         ListProdbc = buf_prod-bc.b-str.
      684         do on error undo, return error :
      685           if prn-prt = false     and bar-code.node-code <> rootnode_code   then do:     next.   end.   if prn-prt = true then do:     find first gds-prt no-lock       where gds-prt.node-code = bar-code.node-code     .     if gds-prt.is-term = false then do:       next.     end.   end.
      686   run rep/ticket.p (
      687                  buffer ub.goods
      688                 ,buffer ub.bar-code
      689                 ,buffer ub.scales-gds
      690                 ,input p-obj-type
      691                 ,input p-obj-code
      692                 ,input Action
      693                 ,input rootnode_code
      694                 ,input TickOnw
      695                 ,input TickOnN
      696                 ,input QntyType
      697                 ,input PriceType
      698                 ,input scaleprice
      699                 ,input nakl-qnty
      700                 ,input list-qnty
      701                 ,input pr-doc-rubl
      702                 ,input pr-doc-rb
      703                 ,input pr-doc-rubl-old
      704                 ,input pr-doc-rb-old
      705                 ,input v-fact-order
      706                 ,input ListProdBc
      707                 ,input curr-rate
      708                 ,input TickPS
      709                 ,input dflt-cd
      710                 ,input how-pcnt-kat
      711                 ,input-output b-count
      712                 ,input v-part-code
      713                 ,input v-doc-code
      714                 ,input v-promo-code
      715                 ,input v-ActionId
      716                 ,input v-db-num
      717                 ) no-error .
      718         end.
      719       end.
      720       if scnblist.b-str <> "":U
      721       and scnblist.loc-ean then do:
      722         ListProdbc = scnblist.b-str.
      723         do on error undo, return error :
      724           if prn-prt = false     and bar-code.node-code <> rootnode_code   then do:     next.   end.   if prn-prt = true then do:     find first gds-prt no-lock       where gds-prt.node-code = bar-code.node-code     .     if gds-prt.is-term = false then do:       next.     end.   end.
      725   run rep/ticket.p (
      726                  buffer ub.goods
