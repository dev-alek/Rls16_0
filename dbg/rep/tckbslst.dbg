     1067   procedure scnb-list-order-num :
     1068     do
     1069     on error undo, return error
     1070     :
     1071   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1072   define variable v-value18 as character no-undo .
     1073   if NOT can-find(first scnblist) then
     1074       RETURN.
     1075   for each scnblist
     1076   by scnblist.order-num
     1077   :
     1078     if scnblist.b-str = "":U then next.
     1079     find ub.goods no-lock
     1080       where ub.goods.prod-type = scnblist.prod-type
     1081         and ub.goods.prod-code = scnblist.prod-code
     1082         and ub.goods.artic = scnblist.artic
     1083     .
     1084     find ub.gds-prt no-lock
     1085       where ub.gds-prt.upper-code = ub.goods.prt-root
     1086     .
     1087     if scnblist.qnty = ? then do:
     1088       run gbl/d-prompt.w (
     1089         'title=':u +  substitute("ЕАН &1" , scnblist.b-str )  + '\':u
     1090       + 'text1=':u + substitute("Для товара  &1 &2" ,  ub.goods.artic , ub.goods.gds-name )  + '\':u
     1091       + 'text2=':u + "Введите количество" + '\':u
     1092       + 'format=' + ">>>>9" + '\':u
     1093       + 'type=' + 'I':U + '\':u
     1094       + 'fillin_row=3\':u
     1095       + 'fillin_col=4\':u
     1096       + 'fillin_width=7\':u
     1097       + 'fillin_height=1\':u
     1098       + 'max-chars=5\':u
     1099       + 'readonly=no\':u
     1100       , input-output v-value18
     1101       ).
     1102       if return-value = 'false':u
     1103           then scnblist.qnty .
     1104           else scnblist.qnty = int(v-value18) .
     1105     end.
     1106     assign
     1107       rootnode_code = ub.gds-prt.node-code
     1108       list-qnty = scnblist.qnty
     1109     .
     1110     if v-cntxp-doc-prt AND TickOnS AND can-find(first ub.gds-prt where ub.gds-prt.upper-code = rootnode_code) then do:
     1111       assign
     1112         prn-prt = TRUE
     1113       .
     1114     end.
     1115     else do:
     1116       assign
     1117         prn-prt = FALSE
     1118       .
     1119     end.
     1120     find first ub.bar-code no-lock where
     1121               ub.bar-code.b-code = scnblist.b-code no-error .
     1122     if available ub.bar-code then do:
     1123       if scnblist.b-str <> "":U
     1124       and not scnblist.loc-ean then do:
     1125         define buffer buf_prod-bc for ub.prod-bc.
     1126         find first buf_prod-bc where buf_prod-bc.b-code =
     1127                     scnblist.b-code
     1128                 AND buf_prod-bc.b-str = scnblist.b-str no-error .
     1129         ListProdbc = buf_prod-bc.b-str.
     1130         do on error undo, return error :
     1131           if prn-prt = false     and bar-code.node-code <> rootnode_code   then do:     next.   end.   if prn-prt = true then do:     find first gds-prt no-lock       where gds-prt.node-code = bar-code.node-code     .     if gds-prt.is-term = false then do:       next.     end.   end.
     1132   run rep/ticket.p (
     1133                  buffer ub.goods
     1134                 ,buffer ub.bar-code
     1135                 ,buffer ub.scales-gds
     1136                 ,input p-obj-type
     1137                 ,input p-obj-code
     1138                 ,input Action
     1139                 ,input rootnode_code
     1140                 ,input TickOnw
     1141                 ,input TickOnN
     1142                 ,input QntyType
     1143                 ,input PriceType
     1144                 ,input scaleprice
     1145                 ,input nakl-qnty
     1146                 ,input list-qnty
     1147                 ,input pr-doc-rubl
     1148                 ,input pr-doc-rb
     1149                 ,input pr-doc-rubl-old
     1150                 ,input pr-doc-rb-old
     1151                 ,input v-fact-order
     1152                 ,input ListProdBc
     1153                 ,input curr-rate
     1154                 ,input TickPS
     1155                 ,input dflt-cd
     1156                 ,input how-pcnt-kat
     1157                 ,input-output b-count
     1158                 ,input v-part-code
     1159                 ,input v-doc-code
     1160                 ,input v-promo-code
     1161                 ,input v-ActionId
     1162                 ,input v-db-num
     1163                 ) no-error .
     1164         end.
     1165       end.
     1166       if scnblist.b-str <> "":U
     1167       and scnblist.loc-ean then do:
     1168         ListProdbc = scnblist.b-str.
     1169         do on error undo, return error :
     1170           if prn-prt = false     and bar-code.node-code <> rootnode_code   then do:     next.   end.   if prn-prt = true then do:     find first gds-prt no-lock       where gds-prt.node-code = bar-code.node-code     .     if gds-prt.is-term = false then do:       next.     end.   end.
     1171   run rep/ticket.p (
     1172                  buffer ub.goods
     1173                 ,buffer ub.bar-code
     1174                 ,buffer ub.scales-gds
     1175                 ,input p-obj-type
     1176                 ,input p-obj-code
     1177                 ,input Action
     1178                 ,input rootnode_code
     1179                 ,input TickOnw
     1180                 ,input TickOnN
     1181                 ,input QntyType
     1182                 ,input PriceType
     1183                 ,input scaleprice
     1184                 ,input nakl-qnty
     1185                 ,input list-qnty
     1186                 ,input pr-doc-rubl
     1187                 ,input pr-doc-rb
     1188                 ,input pr-doc-rubl-old
     1189                 ,input pr-doc-rb-old
     1190                 ,input v-fact-order
     1191                 ,input ListProdBc
     1192                 ,input curr-rate
     1193                 ,input TickPS
     1194                 ,input dflt-cd
     1195                 ,input how-pcnt-kat
     1196                 ,input-output b-count
     1197                 ,input v-part-code
     1198                 ,input v-doc-code
     1199                 ,input v-promo-code
     1200                 ,input v-ActionId
     1201                 ,input v-db-num
     1202                 ) no-error .
     1203         end.
     1204       end.
     1205     end.
     1206   end.
