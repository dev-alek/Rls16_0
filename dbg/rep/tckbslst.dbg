      312               view-as alert-box error title "подсчет контрольной суммы".
      313             return error.
      314           end.
      315           assign
      316             sum3 = sum3 + integer(v-sum-char3)
      317           .
      318         end.
      319         if varcont3 = yes then do:
      320           assign
      321             sum3 = sum3 * 3
      322           .
      323           do i3 = 2 to len-code3 by 2
      324           :
      325             assign
      326               v-sum-char3 = substr(full-b-code, len-code3 - i3 + 1, 1)
      327             .
      328             if v-sum-char3 < "0"
      329             or v-sum-char3 > "9"
      330             then do:
      331               message
      332                 "Невозможно сформировать бар-код" skip
      333                 "для товара с кодом: " internal-b-code skip
      334                 view-as alert-box error title "подсчет контрольной суммы".
      335               return error.
      336             end.
      337             assign
      338               sum3 = sum3 + integer(v-sum-char3)
      339             .
      340           end.
      341           if varcont3 = yes then do:
      342              if sum3 mod 10 = 0 then do:
      343                assign
