      518   define variable dflt-cd as character no-undo .
      519   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      520   define variable v-param-type9 as character no-undo .
      521   define variable v-value-date9 as date no-undo .
      522   define variable v-value-decimal9 as decimal no-undo .
      523   define variable v-value-integer9 as INTEGER no-undo .
      524   define variable v-value-logical9 AS LOGICAL no-undo .
      525   define variable v-tth9 as handle no-undo .
      526   define variable v-host-code9 as integer no-undo .
      527   define buffer buf_dis-thbj-rule9 for ub.dis-thbj-rule.
      528   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      529   define variable v-param-type10 as character no-undo .
      530   define variable v-value-date10 as date no-undo .
      531   define variable v-value-decimal10 as decimal no-undo .
      532   define variable v-value-integer10 as INTEGER no-undo .
      533   define variable v-value-logical10 AS LOGICAL no-undo .
