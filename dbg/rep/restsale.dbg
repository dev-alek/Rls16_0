        1   define input parameter parparentproc as widget-handle no-undo .
        2   define input parameter p-obj-type like ub.clients.obj-type no-undo.
        3   define input parameter p-obj-code like ub.clients.obj-code no-undo.
        4   define input parameter p-date-begin as date no-undo.
        5   define input parameter p-time-begin as integer no-undo.
        6   define input parameter p-date-end as date no-undo.
        7   define input parameter p-time-end as integer no-undo.
        8   define variable vss-revision    as character no-undo init "$Revision$":U .
        9   define variable vss-author      as character no-undo init "$Author$":U .
       10   define variable vss-date        as character no-undo init "$Date$":U .
       11   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       12   define variable vss-archive     as character no-undo init "$Archive$":U .
       13   define variable vss-description as character no-undo init "Реализация по видам топлива".
       14   procedure vss-get-info :
       15     define output parameter p-vss-revision    like vss-revision    no-undo .
       16     define output parameter p-vss-author      like vss-author      no-undo .
       17     define output parameter p-vss-date        like vss-date        no-undo .
       18     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       19     define output parameter p-vss-archive     like vss-archive     no-undo .
       20     define output parameter p-vss-description like vss-description no-undo .
       21     assign
       22       p-vss-revision    = vss-revision
       23       p-vss-author      = vss-author
       24       p-vss-date        = vss-date
       25       p-vss-workfile    = vss-workfile
       26       p-vss-archive     = vss-archive
       27       p-vss-description = vss-description
       28     .
       29   end procedure.
       30   procedure vss-get-parameters :
       31     define output parameter p-vss-parameters as character no-undo .
       32   end procedure.
       33   define new global shared variable g#vssrevis-logger as handle    no-undo .
       34   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       35   define variable v-vssrevis-logger                   as handle    no-undo .
       36   procedure vss-logevent :
       37     define input  parameter p-extra-paramters as character no-undo .
       38     define variable v-vssrevis-parameters as character no-undo .
       39     do
       40     on error undo, return error return-value
       41     :
       42       if  valid-handle(v-vssrevis-logger)
       43       and v-vssrevis-logger :get-signature("logevent") <> ""
       44       then do:
       45         run vss-get-parameters in this-procedure
       46           (output v-vssrevis-parameters
       47           ).
       48         run logevent in v-vssrevis-logger
       49           (input vss-workfile
       50           ,input vss-revision
       51           ,input v-vssrevis-parameters
       52           ,input p-extra-paramters
       53           ).
       54       end.
       55     end.
       56   end procedure.
       57   assign
       58     v-vssrevis-logger = g#vssrevis-logger
       59   .
       60   if  valid-handle(v-vssrevis-logger)
       61   and v-vssrevis-logger :get-signature("logevent") <> ""
       62   then do:
       63     assign
       64       v-vssrevis-logevent = true
       65     .
       66     run vss-logevent in this-procedure (input vss-description) .
       67   end.
       68   define new global shared variable g#language as character no-undo .
       69   if g#language <> '' and g#language <> 'rus':U then do:
       70     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       71   end.
       72   define new global shared variable g#library  as handle no-undo .
       73   define new global shared variable g#library2 as handle no-undo .
       74   procedure proc-alt-shift-f2:
       75     if not ibs.th.gbl.gbl-var:rcode
       76   then
       77     run gbl\inidebug.p .
       78   end.
       79   procedure proc-alt-shift-f3:
       80     run gbl/prvssinf.p
       81       ( input this-procedure
       82       ) .
       83   end.
       84   define variable v-inform-launched as logical no-undo initial false .
       85   procedure proc-alt-shift-f4:
       86     define variable v-action as character no-undo .
       87     if v-inform-launched = false then do:
       88       assign
       89         v-inform-launched = true
       90       .
       91       run gbl/d-inform.w
       92         (  input self
       93         ,  input this-procedure
       94         , output v-action
       95         ) no-error .
       96       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       97       assign
       98         v-inform-launched = false
       99       .
      100     end.
      101   end.
      102   procedure proc-alt-f1:
      103     run gbl/corrhelp.p
      104       (input this-procedure
      105       ) .
      106   end .
      107   on alt-shift-f2 anywhere do:
      108     run proc-alt-shift-f2.
      109   end.
      110   on alt-shift-f3 anywhere do:
      111     run proc-alt-shift-f3 in this-procedure .
      112   end.
      113   on alt-shift-f4 anywhere do:
      114     run proc-alt-shift-f4 in this-procedure.
      115   end.
      116   on alt-f1 anywhere do:
      117     run proc-alt-f1 in this-procedure .
      118   end.
      119   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      120     define variable v-cntxt-db-num        as integer   no-undo .
      121     define variable v-cntxt-userid        as character no-undo .
      122     define variable v-cntxt-level         as character no-undo .
      123     define variable v-cntxt-host-code-obj as integer   no-undo .
      124     define variable v-cntxt-obj-type      as character no-undo .
      125     define variable v-cntxt-obj-code      as integer   no-undo .
      126     define variable v-cntxt-db-num-obj    as integer   no-undo .
      127     define variable v-cntxt-is-admin      as logical   no-undo .
      128   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      129   procedure factord :
      130     define input  parameter p-fact-date            as date    no-undo .
      131     define input  parameter p-fact-time            as integer no-undo .
      132     define input  parameter p-fact-num             as integer no-undo .
      133     define input  parameter p-shift-date           as date    no-undo .
      134     define input  parameter p-shift-num            as integer no-undo .
      135     define input  parameter p-shift-on             as logical no-undo .
      136     define output parameter p-fact-order           as decimal no-undo .
      137     define output parameter p-shift-end-fact-order as decimal no-undo .
      138     define output parameter p-day-end-fact-order   as decimal no-undo .
      139     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      140     if p-fact-date = ?
      141     then do:
      142       return error "Не указана фактическая дата" .
      143     end.
      144     define variable v-fact-date-num as integer no-undo .
      145     assign
      146       v-fact-date-num = integer(p-fact-date)
      147     .
      148     if p-fact-num = ?
      149     or p-fact-num = 0
      150     then do:
      151       return error "Не задан p-fact-num " + string(p-fact-num) .
      152     end.
      153     if p-fact-num < 0
      154     then do:
      155       return error "Отрицательный fact-num " + string(p-fact-num) .
      156     end.
      157     if p-fact-num >= 100000000
      158     then do:
      159       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      160     end.
      161     if p-shift-on = true
      162     then do:
      163       if p-shift-date = ?
      164       then do:
      165         return error "Не задана дата смены" .
      166       end.
      167       if p-shift-num = ?
      168       or p-shift-num = 0
      169       then do:
      170         return error "Не задан номер смены" .
      171       end.
      172     end.
      173     else do:
      174       assign
      175         p-shift-date = p-fact-date
      176         p-shift-num  = 24
      177       .
      178     end.
      179     define variable v-shift-offset as integer no-undo .
      180     if p-shift-date = p-fact-date
      181     then do:
      182       assign
      183         v-shift-offset = 1
      184       .
      185     end.
      186     if p-shift-date < p-fact-date
      187     then do:
      188       assign
      189         v-shift-offset = 0
      190       .
      191     end.
      192     if p-shift-date > p-fact-date
      193     then do:
      194       message
      195         vss-workfile vss-revision vss-description skip
      196         "Неправильная дата закрытия смены" skip
      197         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      198         view-as alert-box error .
      199       undo, return error
      200         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      201           ,string(p-fact-date, '99/99/9999':U)
      202           ,string(p-shift-date, '99/99/9999':U)
      203           )
      204       .
      205     end.
      206     if p-shift-num < 1
      207     or p-shift-num > 24
      208     then do:
      209       message
      210         vss-workfile vss-revision vss-description skip
      211         "Неправильный номер смены" skip
      212         "p-shift-num" p-shift-num skip
      213         view-as alert-box error .
      214       undo, return error return-value .
      215     end.
      216     assign
      217       p-fact-order           = v-fact-date-num
      218                              + v-shift-offset * 0.5
      219                              + p-shift-num    * 0.02 - 0.01
      220                              + p-fact-num     * 0.0000000001
      221       p-shift-end-fact-order = v-fact-date-num
      222                              + v-shift-offset * 0.5
      223                              + p-shift-num    * 0.02
      224       p-day-end-fact-order   = v-fact-date-num
      225                              + 0.99
      226     .
      227     if p-fact-order           <= v-fact-date-num
      228     or p-shift-end-fact-order <= v-fact-date-num
      229     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      230     or p-shift-end-fact-order >= p-day-end-fact-order
      231     then do:
      232       message
      233         vss-workfile vss-revision vss-description skip
      234         "Внутренняя ошибка при генерации фактического номера" skip
      235         "p-fact-date"            p-fact-date            skip
      236         "p-fact-time"            p-fact-time            skip
      237         "p-fact-num"             p-fact-num             skip
      238         "p-shift-date"           p-shift-date           skip
      239         "p-shift-num"            p-shift-num            skip
      240         "p-shift-on"             p-shift-on             skip
      241         "p-shift-end-fact-order" p-shift-end-fact-order skip
      242         "p-day-end-fact-order"   p-day-end-fact-order   skip
      243         "v-fact-date-num"        v-fact-date-num        skip
      244         view-as alert-box error .
      245       undo, return error return-value .
      246     end.
      247   end procedure.
      248   procedure day-begin-fact-order :
      249     define input  parameter p-fact-date            as date    no-undo .
      250     define output parameter p-day-begin-fact-order as decimal no-undo .
      251     do
      252     on error undo, return error return-value
      253     :
      254       if p-fact-date = ?
      255       then do:
      256         assign
      257           p-day-begin-fact-order = 0
      258         .
      259       end.
      260       else do:
      261         assign
      262           p-day-begin-fact-order = integer(p-fact-date)
      263         .
      264       end.
      265     end.
      266   end procedure.
      267   procedure factord-max-fact-order :
      268     define output parameter p-max-fact-order as decimal   no-undo .
      269     do
      270     on error undo, return error return-value
      271     :
      272       run day-begin-fact-order in this-procedure
      273         (input  date(1, 1, 5000)
      274         ,output p-max-fact-order
      275         ) .
      276     end.
      277   end procedure.
      278   procedure factord-cut-archive :
      279     define input  parameter p-obj-type             as character no-undo .
      280     define input  parameter p-obj-code             as integer   no-undo .
      281     define input  parameter p-fact-date            as date      no-undo .
      282     define output parameter p-shift-on             as logical   no-undo .
      283     define output parameter p-shift-date           as date      no-undo .
      284     define output parameter p-shift-num            as integer   no-undo .
      285     define output parameter p-day-end-fact-order   as decimal   no-undo .
      286     define output parameter p-shift-end-fact-order as decimal   no-undo .
      287     define variable v-fact-order as decimal   no-undo .
      288     define buffer buf_shift-obj for ub.shift-obj .
      289     do
      290     on error undo, return error return-value
      291     :
      292   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      293   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      294     (input  p-obj-type
      295     ,input  p-obj-code
      296     ,input  'shift-on=request'
      297     ,output p-shift-on
      298     ) no-error .
      299       if error-status :error
      300       then do:
      301         message
      302           vss-workfile vss-revision vss-description skip
      303           "Ошибка при определении атрибута объекта" skip
      304           "Объект" p-obj-type p-obj-code skip
      305           error-status :get-message(1) skip
      306           return-value skip
      307           view-as alert-box error .
      308         undo, return error return-value .
      309       end.
      310       if p-shift-on = false
      311       then do:
      312         assign
      313           p-shift-date               = ?
      314           p-shift-num                = 0
      315         .
      316       end.
      317       else do:
      318         find first buf_shift-obj share-lock
      319           where buf_shift-obj.obj-type   = p-obj-type
      320             and buf_shift-obj.obj-code   = p-obj-code
      321             and buf_shift-obj.shift-date > p-fact-date
      322           use-index pi
      323           no-error .
      324         if not available buf_shift-obj
      325         or buf_shift-obj.status_ <> 'зкр':U
      326         then do:
      327           message
      328             vss-workfile vss-revision vss-description skip
      329             "Невозможно вычислить последнюю смену" skip
      330             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      331             "Объект" p-obj-type p-obj-code skip
      332             "Дата" p-fact-date skip
      333             view-as alert-box error .
      334           undo, return error return-value .
      335         end.
      336         find last buf_shift-obj share-lock
      337           where buf_shift-obj.obj-type = p-obj-type
      338             and buf_shift-obj.obj-code = p-obj-code
      339             and buf_shift-obj.shift-date <= p-fact-date
      340           use-index pi
      341           no-error .
      342         if available buf_shift-obj
      343         then do:
      344           if  buf_shift-obj.status_ = 'зкр':U
      345           then do:
      346             assign
      347               p-shift-date = buf_shift-obj.shift-date
      348               p-shift-num  = buf_shift-obj.shift-num
      349             .
      350           end.
      351           else do:
      352             message
      353               vss-workfile vss-revision vss-description skip
      354               "Невозможно вычислить последнюю смену" skip
      355               "Статус смены отличен от статуса" 'зкр':U skip
      356               "Объект" p-obj-type p-obj-code skip
      357               "Дата" p-fact-date skip
      358               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      359               view-as alert-box error .
      360             undo, return error return-value .
      361           end.
      362         end.
      363         else do:
      364           assign
      365             p-shift-date = p-fact-date - 1
      366             p-shift-num  = 1
      367           .
      368         end.
      369       end.
      370       run factord in this-procedure
      371         (input  p-fact-date
      372         ,input  1
      373         ,input  1
      374         ,input  p-shift-date
      375         ,input  p-shift-num
      376         ,input  p-shift-on
      377         ,output v-fact-order
      378         ,output p-shift-end-fact-order
      379         ,output p-day-end-fact-order
      380         ) no-error .
      381       if error-status :error
      382       then do:
      383         message
      384           vss-workfile vss-revision vss-description skip
      385           "Ошибка при вызове процедуры factord"
      386           error-status :get-message(1) skip
      387           return-value skip
      388           view-as alert-box error .
      389         undo, return error return-value .
      390       end.
      391     end.
      392   end procedure.
      393   procedure factord-lock-shift :
      394     define input  parameter p-obj-type  as character no-undo .
      395     define input  parameter p-obj-code  as integer   no-undo .
      396     define input  parameter p-fact-date as date      no-undo .
      397     define parameter buffer buf_shift-obj for ub.shift-obj .
      398     define variable v-shift-on      as logical   no-undo .
      399     define variable v-extra-message as character no-undo .
      400     define variable v-error as character no-undo .
      401     do
      402     on error undo, return error return-value
      403     :
      404   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      405   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      406     (input  p-obj-type
      407     ,input  p-obj-code
      408     ,input  'shift-on=request'
      409     ,output v-shift-on
      410     ) no-error .
      411       if error-status :error
      412       then do:
      413         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
      414         undo, return error v-error .
      415       end.
      416       if v-shift-on = true
      417       then do:
      418         find first buf_shift-obj share-lock
      419           where buf_shift-obj.obj-type   = p-obj-type
      420             and buf_shift-obj.obj-code   = p-obj-code
      421             and buf_shift-obj.shift-date > p-fact-date
      422           use-index pi
      423           no-error .
      424         if not available buf_shift-obj
      425         or buf_shift-obj.status_ <> 'зкр':U
      426         then do:
      427           find last buf_shift-obj
      428             where buf_shift-obj.obj-type = p-obj-type
      429               and buf_shift-obj.obj-code = p-obj-code
      430               and buf_shift-obj.status_  = 'зкр':U
      431             use-index stts
      432             no-error .
      433           if available buf_shift-obj
      434           then do:
      435             assign
      436               v-extra-message =
      437                     substitute("Дата начала последеней закрытой смены на объекте &1"
      438                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
      439                               )
      440             .
      441           end.
      442           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
      443           undo, return error v-error .
      444         end.
      445       end.
      446     end.
      447   end procedure.
      448   procedure factord-end-day :
      449     define input  parameter p-fact-date            as date    no-undo .
      450     define output parameter p-day-end-fact-order   as decimal no-undo .
      451     do
      452     on error undo, return error return-value
      453     :
      454       if p-fact-date = ?
      455       then do:
      456         return error "Не указана фактическая дата" .
      457       end.
      458       assign
      459         p-day-end-fact-order = integer(p-fact-date) + 0.99
      460       .
      461     end.
      462   end procedure.
      463   procedure factord-to-date :
      464     define input  parameter p-fact-order as decimal no-undo .
      465     define output parameter p-fact-date  as date    no-undo .
      466     define variable v-ref-date  as date      no-undo .
      467     define variable v-ref-delta as integer   no-undo .
      468     do
      469     on error undo, return error return-value
      470     :
      471       if p-fact-order = ?
      472       or p-fact-order = 0
      473       then do:
      474         return error "Не указан fact-order" .
      475       end.
      476       assign
      477         v-ref-date  = date(1, 1, 2000)
      478       .
      479       assign
      480         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
      481       .
      482       assign
      483         p-fact-date = v-ref-date + v-ref-delta
      484       .
      485     end.
      486   end procedure.
      487   procedure factord-to-fact-num :
      488     define input  parameter p-fact-order as decimal no-undo .
      489     define output parameter p-fact-num   as integer no-undo .
      490     define variable v-fact-order-trunc as decimal no-undo .
      491     do
      492     on error undo, return error return-value
      493     :
      494       if p-fact-order = ?
      495       or p-fact-order = 0
      496       then do:
      497         return error "Не указан fact-order" .
      498       end.
      499       assign
      500        v-fact-order-trunc = truncate(p-fact-order, 2)
      501       .
      502       assign
      503         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
      504       .
      505     end.
      506   end procedure.
      507   procedure factord-to-shift-num :
      508     define input  parameter p-fact-order as decimal no-undo .
      509     define output parameter p-shift-num   as integer no-undo .
      510     define variable  p-shift-numd  as decimal   no-undo .
      511     define variable v-fact-order-trunc as decimal no-undo .
      512     do
      513     on error undo, return error return-value
      514     :
      515       if p-fact-order = ?
      516       or p-fact-order = 0
      517       then do:
      518         return error "Не указан fact-order" .
      519       end.
      520       assign
      521        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
      522       .
      523       if v-fact-order-trunc < 0.5 then do:
      524         v-fact-order-trunc = v-fact-order-trunc + 0.5.
      525       end.
      526       assign
      527         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
      528         .
      529        assign
      530         p-shift-num = truncate (p-shift-numd , 0)
      531       .
      532     end.
      533   end procedure.
      534   define variable v-time-begin  as integer      no-undo.
      535   define variable v-time-end    as integer      no-undo.
      536   DEFINE TEMP-TABLE tt-gds-sale NO-UNDO
      537      field gds-code           like ub.goods.gds-code
      538      field gds-name           like ub.goods.gds-name
      539      field sale-qnty-mass     like ub.rvs-line.state-measure-qnty
      540      field sale-qnty-value    like ub.rvs-line.state-measure-qnty
      541      field density            as decimal
      542      field rvs-count          as integer
      543   index pu as primary unique
      544         gds-code
      545    .
      546   define buffer buf_tt-gds-sale    for tt-gds-sale.
      547   DEFINE BUTTON b-help
      548        LABEL "Помо&щь"
      549        SIZE 10 BY 1
      550        BGCOLOR 8 .
      551   DEFINE BUTTON b-qiut AUTO-END-KEY
      552        LABEL "&Выход"
      553        SIZE 10 BY 1
      554        BGCOLOR 8 .
      555   DEFINE VARIABLE v-date-begin AS DATE FORMAT "99/99/99":U
      556        LABEL "Дата начала"
      557        VIEW-AS FILL-IN
      558        SIZE 9 BY 1 NO-UNDO.
      559   DEFINE VARIABLE v-date-end AS DATE FORMAT "99/99/99":U
      560        LABEL "Дата окончания"
      561        VIEW-AS FILL-IN
      562        SIZE 9 BY 1 NO-UNDO.
      563   DEFINE VARIABLE v-hour-begin AS INTEGER FORMAT "99":U INITIAL 0
      564        LABEL "Время"
      565        VIEW-AS FILL-IN
      566        SIZE 3 BY 1 NO-UNDO.
      567   DEFINE VARIABLE v-hour-end AS INTEGER FORMAT "99":U INITIAL 0
      568        LABEL "время"
      569        VIEW-AS FILL-IN
      570        SIZE 3 BY 1 NO-UNDO.
      571   DEFINE VARIABLE v-minute-begin AS INTEGER FORMAT "99":U INITIAL 0
      572        LABEL ""
      573        VIEW-AS FILL-IN
      574        SIZE 3 BY 1 NO-UNDO.
      575   DEFINE VARIABLE v-minute-end AS INTEGER FORMAT "99":U INITIAL 0
      576        LABEL ""
      577        VIEW-AS FILL-IN
      578        SIZE 3 BY 1 NO-UNDO.
      579   DEFINE QUERY BROWSE-5 FOR
      580         buf_tt-gds-sale SCROLLING.
      581   DEFINE BROWSE BROWSE-5
      582     QUERY BROWSE-5 DISPLAY
      583         buf_tt-gds-sale.gds-name        COLUMN-LABEL "Топливо"
      584   buf_tt-gds-sale.sale-qnty-value COLUMN-LABEL "Литры"
      585   buf_tt-gds-sale.sale-qnty-mass  COLUMN-LABEL "Килограммы"
      586       WITH NO-ROW-MARKERS SEPARATORS SIZE 79.5 BY 8.75 EXPANDABLE.
      587   DEFINE FRAME Dialog-Frame
      588        b-qiut AT ROW 1 COL 1
      589        b-help AT ROW 1 COL 71
      590        v-date-begin AT ROW 2.25 COL 13 COLON-ALIGNED
      591        v-date-end AT ROW 2.25 COL 44.5 COLON-ALIGNED
      592        v-hour-begin AT ROW 3.5 COL 13 COLON-ALIGNED
      593        v-minute-begin AT ROW 3.5 COL 18.5 COLON-ALIGNED
      594        v-hour-end AT ROW 3.5 COL 44.5 COLON-ALIGNED
      595        v-minute-end AT ROW 3.5 COL 50 COLON-ALIGNED
      596        BROWSE-5 AT ROW 5 COL 1.5
      597        SPACE(0.74) SKIP(0.16)
      598       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      599            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      600            TITLE "Реализация по видам топлива"
      601            CANCEL-BUTTON b-qiut.
      602   ASSIGN
      603          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      604          FRAME Dialog-Frame:HIDDEN           = TRUE.
      605   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      606   DO:
      607     APPLY "END-ERROR":U TO SELF.
      608   END.
      609   ON LEAVE OF v-date-begin IN FRAME Dialog-Frame
      610   DO:
      611       ASSIGN
      612             v-date-begin
      613       .
      614       run mandatory-begin-end in this-procedure .
      615       run fill-sale in this-procedure .
      616       run enable_UI in this-procedure .
      617   END.
      618   ON LEAVE OF v-date-end IN FRAME Dialog-Frame
      619   DO:
      620      ASSIGN
      621            v-date-begin
      622            v-date-end
      623      .
      624      run mandatory-begin-end in this-procedure .
      625      run fill-sale in this-procedure .
      626      run enable_UI in this-procedure .
      627   END.
      628   ON LEAVE OF v-hour-begin IN FRAME Dialog-Frame
      629   DO:
      630      ASSIGN
      631         v-hour-begin
      632      .
      633      RUN mandatory-24 IN THIS-PROCEDURE
      634            (INPUT-OUTPUT v-hour-begin ) .
      635      run mandatory-begin-end in this-procedure .
      636      assign
      637         v-time-begin = v-hour-begin * 60 * 60 + v-minute-begin * 60
      638      .
      639      run fill-sale in this-procedure .
      640      run enable_UI in this-procedure .
      641   END.
      642   ON LEAVE OF v-hour-end IN FRAME Dialog-Frame
      643   DO:
      644      ASSIGN
      645         v-hour-end
      646      .
      647      RUN mandatory-24 IN THIS-PROCEDURE
      648         (INPUT-OUTPUT v-hour-end ) .
      649      run mandatory-begin-end in this-procedure .
      650      assign
      651         v-time-end = v-hour-end * 60 * 60 + v-minute-end * 60
      652      .
      653      run fill-sale in this-procedure .
      654      run enable_UI in this-procedure .
      655   END.
      656   ON LEAVE OF v-minute-begin IN FRAME Dialog-Frame
      657   DO:
      658      ASSIGN
      659         v-minute-begin
      660      .
      661      run MANDATORY-60 IN THIS-PROCEDURE
      662            (INPUT-OUTPUT v-minute-begin ) .
      663      run mandatory-begin-end in this-procedure .
      664      assign
      665         v-time-begin = v-hour-begin * 60 * 60 + v-minute-begin * 60
      666      .
      667      run fill-sale in this-procedure .
      668      run enable_UI in this-procedure .
      669   END.
      670   ON LEAVE OF v-minute-end IN FRAME Dialog-Frame
      671   DO:
      672      ASSIGN
      673      v-minute-end
      674      .
      675      run MANDATORY-60 IN THIS-PROCEDURE
      676         (INPUT-OUTPUT v-minute-end ) .
      677      run mandatory-begin-end in this-procedure .
      678      assign
      679         v-time-end = v-hour-end * 60 * 60 + v-minute-end * 60
      680      .
      681      run fill-sale in this-procedure .
      682      run enable_UI in this-procedure .
      683   END.
      684   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      685   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      686   MAIN-BLOCK:
      687   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      688      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      689      run reset-date in this-procedure .
      690      IF v-date-begin > v-date-end THEN DO:
      691         assign
      692            v-date-end = v-date-begin
      693         .
      694      END.
      695      IF v-date-begin = v-date-end
      696      AND v-hour-begin > v-hour-end
      697      THEN DO:
      698         assign
      699               v-hour-end = v-hour-begin
      700         .
      701      END.
      702      IF v-date-begin = v-date-end
      703      AND v-hour-begin = v-hour-end
      704      AND v-minute-begin > v-minute-end
      705      THEN DO:
      706         assign
      707            v-minute-end = v-minute-begin
      708         .
      709      END.
      710      run fill-sale in this-procedure .
      711      run enable_UI.
      712      WAIT-FOR GO OF FRAME Dialog-Frame.
      713   END.
      714   run disable_UI.
      715   PROCEDURE disable_UI :
      716     HIDE FRAME Dialog-Frame.
      717   END PROCEDURE.
      718   PROCEDURE enable_UI :
      719     DISPLAY v-date-begin v-date-end v-hour-begin v-minute-begin v-hour-end
      720             v-minute-end
      721         WITH FRAME Dialog-Frame.
      722     ENABLE b-qiut b-help v-date-begin v-date-end v-hour-begin v-minute-begin
      723            v-hour-end v-minute-end BROWSE-5
      724         WITH FRAME Dialog-Frame.
      725     VIEW FRAME Dialog-Frame.
      726     OPEN QUERY BROWSE-5 FOR EACH buf_tt-gds-sale.
      727   END PROCEDURE.
      728   PROCEDURE fill-sale :
      729   do
      730   on error undo, return error
      731   :
      732   define buffer buf_chk-doc     for ub.chk-doc.
      733   define buffer buf_chk-gds     for ub.chk-gds.
      734   define buffer buf_pl-gds      for ub.pl-gds.
      735   define buffer buf_tt-gds-sale for tt-gds-sale.
      736   define buffer buf_bar-code    for ub.bar-code.
      737   define buffer buf_goods       for ub.goods.
      738   define buffer buf_rvs-doc     for rvs-doc.
      739   define buffer buf_rvs-line-pump     for rvs-line-pump.
      740   define buffer buf_rvs-line    for rvs-line .
      741   define buffer buf_doc-line    for doc-line .
      742   define buffer buf_inkas       for inkas .
      743   define buffer buf_shift-obj      for shift-obj.
      744   define variable v-shift-num    as integer      no-undo.
      745   define variable v-shift-date    as date      no-undo.
      746   define variable v-delta-time    as integer      no-undo.
      747   define variable v-delta-time-2  as integer      no-undo.
      748   define variable v-rvs-code    as character    no-undo.
      749   define variable v-density    as decimal      no-undo.
      750   define variable v-fact-order-start    as decimal      no-undo.
      751   define variable v-fact-order-end      as decimal      no-undo.
      752   define variable v-close    as logical      no-undo.
      753      assign
      754         v-close        = FALSE
      755         v-shift-num    = 0
      756         v-shift-date   = ?
      757      .
      758      empty temp-table buf_tt-gds-sale.
      759      FIND FIRST buf_shift-obj
      760         where buf_shift-obj.obj-type = p-obj-type
      761            and buf_shift-obj.obj-code =  p-obj-code
      762            and buf_shift-obj.status_ = 'тек':U
      763         no-lock
      764         no-error.
      765      IF AVAILABLE buf_shift-obj THEN DO:
      766         IF (buf_shift-obj.open-date < v-date-begin)
      767         OR (buf_shift-obj.open-date = v-date-begin
      768         AND buf_shift-obj.open-time <= v-time-begin)
      769         THEN DO:
      770            assign
      771               v-close = FALSE
      772            .
      773         end.
      774         else do:
      775            assign
      776               v-close = TRUE
      777            .
      778         end.
      779      END.
      780      IF v-close THEN DO:
      781         _chk:
      782         for each buf_chk-doc
      783            where  buf_chk-doc.obj-type   = p-obj-type
      784               and buf_chk-doc.obj-code  = p-obj-code
      785               and ((    buf_chk-doc.chk-date =  v-date-begin
      786                     and buf_chk-doc.chk-time >= v-time-begin)
      787                   or
      788                    (buf_chk-doc.chk-date > v-date-begin)
      789                   )
      790               and ((buf_chk-doc.chk-date = v-date-end
      791                     and buf_chk-doc.chk-time <= v-time-end)
      792                     or (buf_chk-doc.chk-date <  v-date-end))
      793               and (buf_chk-doc.chk-type = INTEGER('1':U)
      794                OR buf_chk-doc.chk-type  = INTEGER('6':U))
      795            and buf_chk-doc.out-code <> ?
      796            no-lock
      797            ,
      798           first buf_inkas
      799           where buf_inkas.inkas-code = buf_chk-doc.out-code
      800             and buf_inkas.status_    = 'факт':U
      801            no-lock,
      802            each buf_chk-gds
      803            where buf_chk-gds.doc-code = buf_chk-doc.doc-code
      804            no-lock
      805            :
      806               FIND FIRST buf_bar-code
      807                  WHERE buf_bar-code.b-code = buf_chk-gds.b-code
      808                  NO-LOCK
      809                  .
      810               FIND first buf_pl-gds
      811                  where buf_pl-gds.gds-code = buf_bar-code.gds-code
      812                     and buf_pl-gds.obj-type = p-obj-type
      813                     and buf_pl-gds.obj-code = p-obj-code
      814                  no-lock
      815                  no-error
      816                  .
      817               IF not available buf_pl-gds THEN DO:
      818                  next _chk.
      819               END.
      820               FIND first buf_goods
      821                  where buf_goods.gds-code = buf_bar-code.gds-code
      822                  no-lock
      823                  .
      824            find first buf_tt-gds-sale
      825                  where buf_tt-gds-sale.gds-code = buf_pl-gds.gds-code
      826                  no-error.
      827            if not available buf_tt-gds-sale then do:
      828               find first buf_goods
      829                     where buf_goods.gds-code = buf_pl-gds.gds-code
      830                     no-lock
      831                     .
      832               create buf_tt-gds-sale.
      833               assign
      834                  buf_tt-gds-sale.gds-code = buf_goods.gds-code
      835                  buf_tt-gds-sale.gds-name = buf_goods.gds-name
      836               .
      837            end.
      838            assign
      839               buf_tt-gds-sale.sale-qnty-value = buf_tt-gds-sale.sale-qnty-value + buf_chk-gds.doc-qnty
      840               buf_tt-gds-sale.sale-qnty-mass  = buf_tt-gds-sale.sale-qnty-mass  + buf_chk-gds.doc-qnty * buf_chk-gds.density
      841            .
      842         end.
      843      END.
      844      ELSE DO:
      845         FOR each buf_rvs-doc
      846            where buf_rvs-doc.obj-type = p-obj-type
      847            and buf_rvs-doc.obj-code   = p-obj-code
      848            and buf_rvs-doc.shift-date = v-shift-date
      849            and buf_rvs-doc.shift-num  = v-shift-num
      850            and buf_rvs-doc.status_    = 'факт':U
      851            and buf_rvs-doc.rvs-type   = 'контроль':U
      852            no-lock
      853            :
      854            IF v-date-begin = buf_rvs-doc.fact-date
      855            then do:
      856               IF v-delta-time > ABS(buf_rvs-doc.fact-time - v-time-begin)
      857               then do:
      858                  assign
      859                     v-delta-time = ABS(buf_rvs-doc.fact-time - v-time-begin)
      860                     v-rvs-code  = buf_rvs-doc.rvs-code
      861                     v-fact-order-start = buf_rvs-doc.fact-order
      862                  .
      863               end.
      864            end.
      865            else do:
      866               assign
      867               v-delta-time-2 = IF v-date-begin > buf_rvs-doc.fact-date
      868                              then ABS(buf_rvs-doc.fact-time - ((v-date-begin - buf_rvs-doc.fact-date) * 86400 - buf_rvs-doc.fact-time + v-time-begin))
      869                              else ABS(buf_rvs-doc.fact-time - ((buf_rvs-doc.fact-date - v-date-begin) * 86400 - v-time-begin + buf_rvs-doc.fact-time))
      870               .
      871               IF v-delta-time > v-delta-time-2
      872               then do:
      873                  assign
      874                     v-delta-time = v-delta-time-2
      875                     v-rvs-code  = buf_rvs-doc.rvs-code
      876                  .
      877               end.
      878            end.
      879         end.
      880         IF v-delta-time = 9999999 then do:
      881            message
      882               "В смене, заданной для прогноза, нет контрольных сверок"
      883               skip
      884            view-as alert-box information.
      885            return .
      886         end.
      887         IF v-delta-time > 1800 then do:
      888            message
      889               "В смене, заданной для прогноза, контрольная сверка"
      890               "отстоит по времени от точки начала прогноза более чем на 30 минут"
      891               skip
      892            view-as alert-box information.
      893         end.
      894         _buf_rvs-line-pump:
      895         for EACH buf_rvs-line-pump
      896            WHERE buf_rvs-line-pump.rvs-code = v-rvs-code
      897            NO-LOCK
      898            :
      899            find first buf_tt-gds-sale
      900                  where buf_tt-gds-sale.gds-code = buf_rvs-line-pump.gds-code
      901                  no-error.
      902            if not available buf_tt-gds-sale then do:
      903               find first buf_goods
      904                     where buf_goods.gds-code = buf_rvs-line-pump.gds-code
      905                     no-lock
      906                     .
      907               create buf_tt-gds-sale.
      908               assign
      909                  buf_tt-gds-sale.gds-code = buf_goods.gds-code
      910                  buf_tt-gds-sale.gds-name = buf_goods.gds-name
      911               .
      912            end.
      913            assign
      914               buf_tt-gds-sale.sale-qnty-value = buf_tt-gds-sale.sale-qnty-value - IF buf_rvs-line-pump.meas-am-qnty <> ? THEN buf_rvs-line-pump.meas-am-qnty ELSE 0
      915               buf_tt-gds-sale.sale-qnty-mass  = buf_tt-gds-sale.sale-qnty-mass  - IF buf_rvs-line-pump.meas-am-qnty <> ? THEN buf_rvs-line-pump.meas-am-qnty ELSE 0
      916            .
      917         END.
      918         assign
      919            v-delta-time = 9999999
      920         .
      921         FOR each buf_rvs-doc
      922            where buf_rvs-doc.obj-type = p-obj-type
      923            and buf_rvs-doc.obj-code   = p-obj-code
      924            and buf_rvs-doc.shift-date = v-shift-date
      925            and buf_rvs-doc.shift-num  = v-shift-num
      926            and buf_rvs-doc.status_    = 'факт':U
      927            and (buf_rvs-doc.rvs-type  = 'контроль':U
      928                  OR
      929                  buf_rvs-doc.rvs-type   = 'смена':U)
      930            no-lock
      931            :
      932            IF v-date-end = buf_rvs-doc.fact-date
      933            then do:
      934               IF v-delta-time > ABS(buf_rvs-doc.fact-time - v-time-end)
      935               then do:
      936                  assign
      937                     v-delta-time = ABS(buf_rvs-doc.fact-time - v-time-end)
      938                     v-rvs-code  = buf_rvs-doc.rvs-code
      939                     v-fact-order-end = buf_rvs-doc.fact-order
      940                  .
      941               end.
      942            end.
      943            else do:
      944               assign
      945               v-delta-time-2 = IF v-date-end > buf_rvs-doc.fact-date
      946                              then ABS(buf_rvs-doc.fact-time - ((v-date-end - buf_rvs-doc.fact-date) * 86400 - buf_rvs-doc.fact-time + v-time-end))
      947                              else ABS(buf_rvs-doc.fact-time - ((buf_rvs-doc.fact-date - v-date-end) * 86400 - v-time-end + buf_rvs-doc.fact-time))
      948               .
      949               IF v-delta-time > v-delta-time-2
      950               then do:
      951                  assign
      952                     v-delta-time = v-delta-time-2
      953                     v-rvs-code  = buf_rvs-doc.rvs-code
      954                  .
      955               end.
      956            end.
      957         end.
      958         IF v-delta-time = 9999999 then do:
      959            message
      960               "В смене, заданной для прогноза, нет контрольных сверок"
      961               skip
      962            view-as alert-box information.
      963            return.
      964         end.
      965         IF v-delta-time > 1800 then do:
      966            message
      967               "В смене, заданной для прогноза, контрольная сверка"
      968               "отстоит по времени от точки окончания прогноза более чем на 30 минут"
      969               skip
      970            view-as alert-box information.
      971         end.
      972         _buf_rvs-line-pump:
      973         for EACH buf_rvs-line-pump
      974            WHERE buf_rvs-line-pump.rvs-code = v-rvs-code
      975            NO-LOCK
      976            :
      977            find first buf_tt-gds-sale
      978                  where buf_tt-gds-sale.gds-code = buf_rvs-line-pump.gds-code
      979                  no-error.
      980            if not available buf_tt-gds-sale then do:
      981               find first buf_goods
      982                     where buf_goods.gds-code = buf_rvs-line-pump.gds-code
      983                     no-lock
      984                     .
      985               create buf_tt-gds-sale.
      986               assign
      987                  buf_tt-gds-sale.gds-code = buf_goods.gds-code
      988                  buf_tt-gds-sale.gds-name = buf_goods.gds-name
      989               .
      990            end.
      991            assign
      992               buf_tt-gds-sale.sale-qnty-value = buf_tt-gds-sale.sale-qnty-value + IF buf_rvs-line-pump.meas-am-qnty <> ? THEN buf_rvs-line-pump.meas-am-qnty ELSE 0
      993               buf_tt-gds-sale.sale-qnty-mass  = buf_tt-gds-sale.sale-qnty-mass  + (IF buf_rvs-line-pump.meas-am-qnty <> ? THEN buf_rvs-line-pump.meas-am-qnty ELSE 0)
      994            .
      995         END.
      996         FOR each buf_rvs-doc
      997               where buf_rvs-doc.obj-type = p-obj-type
      998               and buf_rvs-doc.obj-code   = p-obj-code
      999               and buf_rvs-doc.shift-date = v-shift-date
     1000               and buf_rvs-doc.shift-num  = v-shift-num
     1001               and buf_rvs-doc.status_    = 'факт':U
     1002               and (buf_rvs-doc.rvs-type  = 'контроль':U
     1003                     OR
     1004                     buf_rvs-doc.rvs-type   = 'смена':U)
     1005               and buf_rvs-doc.fact-order >= v-fact-order-start
     1006               and buf_rvs-doc.fact-order <= v-fact-order-end
     1007               no-lock
     1008               ,
     1009               each  buf_rvs-line
     1010               where buf_rvs-line.rvs-code = buf_rvs-doc.rvs-code
     1011               no-lock
     1012               ,
     1013               first buf_tt-gds-sale
     1014               where buf_tt-gds-sale.gds-code = buf_rvs-line.gds-code
     1015               :
     1016               assign
     1017                  buf_tt-gds-sale.density = buf_tt-gds-sale.density + buf_rvs-line.density
     1018                  buf_tt-gds-sale.rvs-count = buf_tt-gds-sale.rvs-count + 1
     1019               .
     1020         end.
     1021         FOR EACH buf_tt-gds-sale
     1022             :
     1023               assign
     1024                  buf_tt-gds-sale.density = buf_tt-gds-sale.density / buf_tt-gds-sale.rvs-count
     1025                  buf_tt-gds-sale.sale-qnty-mass = buf_tt-gds-sale.sale-qnty-mass * buf_tt-gds-sale.density
     1026               .
     1027         end.
     1028      END.
     1029   end.
     1030   END PROCEDURE.
     1031   PROCEDURE mandatory-24 :
     1032   DEFINE INPUT-OUTPUT PARAMETER p-time AS INTEGER NO-UNDO .
     1033   DO
     1034   ON error undo, RETURN:
     1035      IF p-time > 23 THEN DO:
     1036          ASSIGN
     1037              p-time = 23
     1038          .
     1039          RETURN .
     1040      END.
     1041      IF p-time < 0 THEN DO:
     1042          ASSIGN
     1043              p-time = 0
     1044          .
     1045          RETURN .
     1046      END.
     1047   END.
     1048   END PROCEDURE.
     1049   PROCEDURE mandatory-60 :
     1050   DEFINE INPUT-OUTPUT PARAMETER p-time AS INTEGER NO-UNDO .
     1051   DO
     1052   ON error undo, RETURN:
     1053      IF p-time > 59 THEN DO:
     1054          ASSIGN
     1055              p-time = 59
     1056          .
     1057          RETURN .
     1058      END.
     1059      IF p-time < 0 THEN DO:
     1060          ASSIGN
     1061              p-time = 0
     1062          .
     1063          RETURN .
     1064      END.
     1065   END.
     1066   END PROCEDURE.
     1067   PROCEDURE mandatory-begin-end :
     1068   do
     1069   on error undo, return error
     1070   :
     1071      IF v-date-begin > v-date-end THEN DO:
     1072         message
     1073            "Дата окончания не может быть меньше даты начала."
     1074            skip
     1075         view-as alert-box information.
     1076         assign
     1077               v-date-end = v-date-begin
     1078         .
     1079      END.
     1080      IF v-date-begin = v-date-end
     1081      AND v-hour-begin > v-hour-end
     1082      THEN DO:
     1083         message
     1084            "Время окончания не может быть меньше даты начала."
     1085            skip
     1086         view-as alert-box information.
     1087         assign
     1088               v-hour-end = v-hour-begin
     1089         .
     1090      END.
     1091      IF v-date-begin = v-date-end
     1092      AND v-hour-begin = v-hour-end
     1093      AND v-minute-begin > v-minute-end
     1094      THEN DO:
     1095      message
     1096         "Время окончания не может быть меньше даты начала."
     1097         skip
     1098      view-as alert-box information.
     1099      assign
     1100         v-minute-end = v-minute-begin
     1101      .
     1102      END.
     1103   end.
     1104   END PROCEDURE.
     1105   PROCEDURE reset-date :
     1106   do
     1107   on error undo, return error
     1108   :
     1109     define variable v-sec    as integer      no-undo.
     1110     assign
     1111        v-date-begin     = p-date-begin
     1112        v-date-end       = p-date-end
     1113        v-time-begin     = p-time-begin
     1114        v-time-end       = p-time-end
     1115        v-sec            = p-time-begin MOD 60
     1116        v-minute-begin   = ((p-time-begin - v-sec) / 60) mod 60
     1117        v-hour-begin     = (((p-time-begin - v-sec) / 60) - v-minute-begin) / 60
     1118     .
     1119     assign
     1120        v-sec            = p-time-end MOD 60
     1121        v-minute-end     = ((p-time-end - v-sec) / 60) mod 60
     1122        v-hour-end       = (((p-time-end - v-sec) / 60) - v-minute-end) / 60
     1123     .
     1124   end.
     1125   END PROCEDURE.
