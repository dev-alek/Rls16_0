        1   block-level on error undo, throw.
        2   define input parameter p-mainmenu-handle    as handle           no-undo.
        3   define input parameter p-trn-doc-recid      as recid            no-undo.
        4   define variable vss-revision    as character no-undo initial "$Revision: aea5316774be, 0, rls $":U .
        5   define variable vss-author      as character no-undo initial "$Author: expertek $":U .
        6   define variable vss-date        as character no-undo initial "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        7   define variable vss-workfile    as character no-undo initial "$Workfile: inv-new.p $":U .
        8   define variable vss-archive     as character no-undo initial "$Archive: rep/inv-new.p $":U .
        9   define variable vss-description as character no-undo initial "Новая форма для инвентаризации.":U .
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define new global shared variable g#library  as handle no-undo .
       69   define new global shared variable g#library2 as handle no-undo .
       70   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       71   define  shared variable PrintCopiesCounter as integer   no-undo initial 1 .
       72   define  shared variable RepPathName        as character no-undo .
       73   define  shared variable PrintRubl          as logical   no-undo .
       74   define variable vss-include-info1 as character format "X(65)" no-undo
       75   initial "@(#)$Workfile$ $Revision$".
       76   define temp-table temp_p-fmt_string-part no-undo
       77       field str-key       as integer
       78       field string-part   as character
       79       index pi is primary unique
       80           str-key
       81   .
       82   define variable v-p-fmt-1-str-key    as integer      no-undo.
       83   FUNCTION center-field RETURNS INTEGER (INPUT iStartPix AS INTEGER, iEndPix AS INTEGER,
       84                                     iInput AS INTEGER).
       85     def var v-start-print as integer no-undo .
       86     if (iStartPix < 0) or (iEndPix < iStartPix) then return 0.
       87     assign
       88       v-start-print = INTEGER(iStartPix + ((iEndPix - iStartPix) / 2) - (iInput / 2))
       89     .
       90     RETURN v-start-print .
       91   END FUNCTION.
       92   FUNCTION right-field RETURNS INTEGER ( iEndPix AS INTEGER,
       93                                     iInput AS INTEGER).
       94     def var v-start-print as integer no-undo .
       95     assign
       96       v-start-print = INTEGER(iEndPix - 1 - iInput)
       97     .
       98     if v-start-print < 0 then return 0.
       99     RETURN v-start-print .
      100   END FUNCTION.
      101   function p-fmt-align-string returns character (
      102         p-in-string      as character
      103       , p-page-width     as integer
      104       , p-align-type     as character
      105   ).
      106       define variable v-string-length     as integer      no-undo.
      107       define variable v-out-string        as character    no-undo.
      108       assign
      109           v-string-length = length( trim( p-in-string ) )
      110       .
      111       if v-string-length >= p-page-width
      112       then do:
      113           assign
      114               v-out-string = trim( p-in-string )
      115           .
      116       end.
      117       else do:
      118           case p-align-type
      119           :
      120               when 'left':U
      121               then do:
      122                   assign
      123                       v-out-string = trim( p-in-string )
      124                   .
      125               end.
      126               when 'right':U
      127               then do:
      128                   assign
      129                       v-out-string = fill( " ":U, p-page-width - v-string-length ) + trim( p-in-string )
      130                   .
      131               end.
      132               when 'center':U
      133               then do:
      134                   assign
      135                       v-out-string = fill( " ":U, integer( ( p-page-width - v-string-length ) / 2 ) ) + trim( p-in-string )
      136                   .
      137               end.
      138           end case.
      139       end.
      140       return v-out-string .
      141   end function.
      142   procedure p-fmt-split-string :
      143   define input parameter p-source-string  as character        no-undo.
      144   define input parameter p-split-length   as integer          no-undo.
      145   define output parameter p-string-1      as character        no-undo.
      146   define output parameter p-string-2      as character        no-undo.
      147   do
      148   on error undo, return error
      149   :
      150       define variable v-space-pos    as integer      no-undo.
      151       if length( p-source-string ) <= p-split-length
      152       then do:
      153           assign
      154               p-string-1 = p-source-string
      155           .
      156       end.
      157       else do:
      158           assign
      159               v-space-pos = r-index( p-source-string, " ":U, p-split-length )
      160           .
      161           if v-space-pos = 0
      162           then do:
      163               assign
      164                   v-space-pos = index( p-source-string, " ":U )
      165               .
      166           end.
      167           if v-space-pos = 0
      168           then do:
      169               assign
      170                   p-string-1 = substring( p-source-string, 1, p-split-length )
      171                   p-string-2 = trim( substring( p-source-string, p-split-length, p-split-length ) )
      172               .
      173           end.
      174           else do:
      175               assign
      176                   p-string-1 = substring( p-source-string, 1, v-space-pos )
      177                   p-string-2 = trim( substring( p-source-string, v-space-pos ) )
      178               .
      179           end.
      180       end.
      181   end.
      182   end procedure.
      183   procedure p-fmt-round :
      184   define input parameter p-qnty               as decimal          no-undo.
      185   define input parameter p-price-no-VAT       as decimal          no-undo.
      186   define input parameter p-VAT                as decimal          no-undo.
      187   define input parameter p-SLT                as decimal          no-undo.
      188   define input parameter p-road-tax           as decimal          no-undo.
      189   define output parameter p-new-price-no-VAT  as decimal          no-undo.
      190   define output parameter p-new-VAT           as decimal          no-undo.
      191   define output parameter p-new-SLT           as decimal          no-undo.
      192   define output parameter p-new-sum-VAT       as decimal          no-undo.
      193   define output parameter p-new-sum-SLT       as decimal          no-undo.
      194   define output parameter p-new-sum-road-tax  as decimal          no-undo.
      195   define output parameter p-new-sum-no-VAT    as decimal          no-undo.
      196   define output parameter p-new-sum-full      as decimal          no-undo.
      197       define variable v-vat-pc    as decimal      no-undo.
      198       define variable v-slt-pc    as decimal      no-undo.
      199   do
      200   on error undo, return error
      201   :
      202       if p-price-no-VAT = 0
      203       then do:
      204           assign
      205               p-new-price-no-VAT = 0.0
      206               p-new-VAT          = ?
      207               p-new-SLT          = ?
      208               p-new-sum-VAT      = 0.0
      209               p-new-sum-SLT      = 0.0
      210               p-new-sum-no-VAT   = 0.0
      211               p-new-sum-road-tax = 0.0
      212               p-new-sum-full     = 0.0
      213           .
      214       end.
      215       else do:
      216           assign
      217               v-vat-pc            = p-VAT / p-price-no-VAT
      218               v-slt-pc            = p-SLT / ( p-price-no-VAT + p-VAT )
      219               p-new-price-no-VAT  = round( p-price-no-VAT, 2 )
      220               p-new-VAT           = round( p-new-price-no-VAT * v-vat-pc, 2 )
      221               p-new-SLT           = round( ( p-new-price-no-VAT + p-new-VAT ) * v-slt-pc, 2 )
      222               p-new-sum-VAT       = round( p-new-VAT          * p-qnty, 2 )
      223               p-new-sum-SLT       = round( ( p-new-price-no-VAT + p-new-VAT ) * p-qnty * v-slt-pc, 2 )
      224               p-new-sum-no-VAT    = round( p-new-price-no-VAT * p-qnty, 2 )
      225               p-new-sum-road-tax  = round( p-road-tax * p-qnty, 2 )
      226               p-new-sum-full      = round( ( p-new-price-no-VAT + p-new-VAT + p-new-SLT + p-road-tax ) * p-qnty, 2 )
      227           .
      228       end.
      229   end.
      230   end procedure.
      231   procedure p-fmt-split :
      232   define input parameter p-in-string      as character        no-undo.
      233   define input parameter p-split-length   as integer          no-undo.
      234       define variable v-start-pos     as integer      no-undo.
      235       define variable v-end-pos       as integer      no-undo.
      236       define buffer buf_temp_p-fmt_string-part        for temp_p-fmt_string-part.
      237   do
      238   for buf_temp_p-fmt_string-part
      239   on error undo, return error
      240   :
      241       empty temp-table buf_temp_p-fmt_string-part.
      242       if p-split-length < 1
      243       then do:
      244           undo, return error substitute( "p-fmt-split: Строка не может быть разбита на &1 частей", p-split-length ).
      245       end.
      246       assign
      247           p-in-string                 = trim( p-in-string )
      248           v-p-fmt-1-str-key   = 0
      249           v-start-pos                 = 1
      250           v-end-pos                   = length( p-in-string )
      251       .
      252       run p-fmt-get-string-range in this-procedure (
      253             input p-in-string
      254           , input p-split-length
      255           , input v-start-pos
      256           , output v-start-pos
      257           , output v-end-pos
      258       ).
      259       do while v-end-pos <> 0
      260       :
      261           create buf_temp_p-fmt_string-part.
      262           assign
      263               v-p-fmt-1-str-key = v-p-fmt-1-str-key + 1
      264           .
      265           assign
      266               buf_temp_p-fmt_string-part.str-key      = v-p-fmt-1-str-key
      267               buf_temp_p-fmt_string-part.string-part  = substring( p-in-string, v-start-pos, v-end-pos - v-start-pos )
      268           .
      269           assign
      270               v-start-pos = v-end-pos + 1
      271           .
      272           run p-fmt-get-string-range in this-procedure (
      273                 input p-in-string
      274               , input p-split-length
      275               , input v-start-pos
      276               , output v-start-pos
      277               , output v-end-pos
      278           ).
      279       end.
      280   end.
      281   end procedure.
      282   procedure p-fmt-get-string-range :
      283   define input parameter p-in-string      as character        no-undo.
      284   define input parameter p-split-length   as integer          no-undo.
      285   define input parameter p-old-start-pos  as integer          no-undo.
      286   define output parameter p-start-pos     as integer          no-undo.
      287   define output parameter p-end-pos       as integer          no-undo.
      288       define variable v-init-string    as character    no-undo.
      289       define variable v-temp-char      as character    no-undo.
      290       define variable v-temp-pos       as integer      no-undo.
      291       define variable v-counter        as integer      no-undo.
      292   do
      293   on error undo, return error
      294   :
      295       assign
      296           p-start-pos   = p-old-start-pos
      297           v-init-string = substring( p-in-string, p-start-pos )
      298       no-error.
      299       if error-status :error
      300       or trim( v-init-string ) = "":U
      301       then do:
      302           assign
      303               p-end-pos = 0
      304           .
      305           undo, return .
      306       end.
      307       assign
      308           v-temp-char   = substring( v-init-string, 1, 1 )
      309       .
      310       do
      311       while trim( v-temp-char ) = "":U
      312       :
      313           assign
      314               p-start-pos     = p-start-pos + 1
      315               v-init-string   = substring( p-in-string, p-start-pos )
      316               v-temp-char     = substring( v-init-string, 1, 1 )
      317           .
      318       end.
      319       assign
      320           v-temp-pos  = p-split-length
      321           v-temp-char = substring( v-init-string, v-temp-pos, 1 )
      322           v-counter   = 0
      323       .
      324       search-word-end:
      325       do
      326       while trim( v-temp-char ) <> "":U
      327       :
      328           assign
      329               v-counter   = v-counter + 1
      330           .
      331           if v-counter > 20
      332           then do:
      333               assign
      334                   v-temp-pos  = p-split-length
      335               .
      336               leave search-word-end.
      337           end.
      338           assign
      339               v-temp-pos  = v-temp-pos - 1
      340               v-temp-char = substring( v-init-string, v-temp-pos, 1 )
      341           .
      342       end.
      343       assign
      344           p-end-pos = p-start-pos + v-temp-pos - 1
      345       .
      346   end.
      347   end procedure.
      348   define variable vss-include-info2 as character format "X(65)" no-undo
      349   initial "@(#)$Workfile$ $Revision$".
      350   define variable v-fmtcli-name          as character    no-undo.
      351   define variable v-fmtcli-engl-name     as character    no-undo.
      352   define variable v-fmtcli-addres        as character    no-undo.
      353   define variable v-fmtcli-post-addres   as character    no-undo.
      354   define variable v-fmtcli-full-addres   as character    no-undo.
      355   define variable v-fmtcli-phone         as character    no-undo.
      356   define variable v-fmtcli-inn           as character    no-undo.
      357   define variable v-fmtcli-kpp           as character    no-undo.
      358   define variable v-fmtcli-okpo          as character    no-undo.
      359   define variable v-fmtcli-country       as character    no-undo.
      360   define variable v-fmtcli-city          as character    no-undo.
      361   define variable v-fmtcli-index         as character    no-undo.
      362   define variable v-fmtcli-schet-exists  as logical      no-undo.
      363   define variable v-fmtcli-bank-exists   as logical      no-undo.
      364   define variable v-fmtcli-bank-r-schet  as character    no-undo.
      365   define variable v-fmtcli-bank-c-schet  as character    no-undo.
      366   define variable v-fmtcli-bank-bik      as character    no-undo.
      367   define variable v-fmtcli-bank-name     as character    no-undo.
      368   define variable v-fmtcli-bank-addres   as character    no-undo.
      369   define variable v-fmtcli-bank-city     as character    no-undo.
      370   procedure fmtcli-get-bank :
      371   define input parameter p-host-code      as integer          no-undo.
      372   define input parameter p-obj-type       as character        no-undo.
      373   define input parameter p-obj-code       as integer          no-undo.
      374   define input parameter p-curr-code      as integer          no-undo.
      375       define buffer buf_fin-schet     for ub.fin-schet.
      376       define buffer buf_fin-bank      for ub.fin-bank.
      377   do
      378   for buf_fin-schet
      379     , buf_fin-bank
      380   on error undo, return error
      381   :
      382       assign
      383           v-fmtcli-schet-exists       = no
      384           v-fmtcli-bank-exists        = no
      385           v-fmtcli-bank-r-schet       = "":U
      386           v-fmtcli-bank-c-schet       = "":U
      387           v-fmtcli-bank-bik           = "":U
      388           v-fmtcli-bank-name          = "":U
      389           v-fmtcli-bank-addres        = "":U
      390           v-fmtcli-bank-city          = "":U
      391       .
      392       search-for-schet:
      393       for each buf_fin-schet no-lock
      394          where buf_fin-schet.host-code = p-host-code
      395            and buf_fin-schet.cli-type  = p-obj-type
      396            and buf_fin-schet.cli-code  = p-obj-code
      397            and buf_fin-schet.curr-code = p-curr-code
      398       on error undo, return error
      399       :
      400           if buf_fin-schet.status_   = 'удал':U
      401           then do:
      402           end.
      403           else do:
      404               assign
      405                   v-fmtcli-schet-exists   = yes
      406                   v-fmtcli-bank-r-schet   = trim( buf_fin-schet.r-schet )
      407                   v-fmtcli-bank-c-schet   = trim( buf_fin-schet.c-schet )
      408               .
      409               find first buf_fin-bank no-lock
      410                    where buf_fin-bank.host-code = p-host-code
      411                      and buf_fin-bank.code-bank = buf_fin-schet.code-bank
      412               no-error.
      413               if available buf_fin-bank
      414               then do:
      415                   assign
      416                       v-fmtcli-bank-exists      = yes
      417                       v-fmtcli-bank-bik         = trim( buf_fin-bank.bik )
      418                       v-fmtcli-bank-name        = trim( buf_fin-bank.bank-name )
      419                       v-fmtcli-bank-addres      = trim(buf_fin-bank.addres)
      420                       v-fmtcli-bank-city      = trim(buf_fin-bank.bank-city)
      421                   .
      422               end.
      423               else do:
      424                   assign
      425                       v-fmtcli-bank-exists    = no
      426                       v-fmtcli-bank-bik       = "":U
      427                       v-fmtcli-bank-name      = "":U
      428                       v-fmtcli-bank-addres    = "":U
      429                       v-fmtcli-bank-city      = "":U
      430                   .
      431               end.
      432               leave search-for-schet.
      433           end.
      434       end.
      435   end.
      436   end procedure.
      437   procedure fmtcli-get-client :
      438   define input parameter p-obj-type       as character    no-undo.
      439   define input parameter p-obj-code       as integer      no-undo.
      440       define variable v-temp-fmtcli-address      as character     no-undo.
      441       define variable v-num-country-city    as integer      no-undo.
      442       define buffer buf_clients   for ub.clients.
      443       define buffer buf_firm      for ub.firm.
      444       define buffer buf_store     for ub.store.
      445       define buffer buf_shop      for ub.shop.
      446       define buffer buf_person    for ub.person.
      447   do
      448   for buf_clients
      449     , buf_firm
      450     , buf_store
      451     , buf_shop
      452     , buf_person
      453   on error undo, return error
      454   :
      455       assign
      456           v-fmtcli-name           = "":U
      457           v-fmtcli-addres         = "":U
      458           v-fmtcli-post-addres    = "":U
      459           v-fmtcli-full-addres    = "":U
      460           v-fmtcli-phone          = "":U
      461           v-fmtcli-inn            = "":U
      462           v-fmtcli-kpp            = "":U
      463           v-fmtcli-okpo           = "":U
      464           v-fmtcli-city           = "":U
      465           v-fmtcli-index          = "":U
      466           v-fmtcli-country        = "":U
      467       .
      468       find first buf_clients no-lock
      469            where buf_clients.obj-type = p-obj-type
      470              and buf_clients.obj-code = p-obj-code
      471       .
      472       assign
      473           v-fmtcli-name = buf_clients.obj-name
      474       .
      475       case buf_clients.obj-type:
      476          when 'орг':U
      477          then do:
      478               find first buf_firm no-lock
      479                    where buf_firm.firm-code = buf_clients.obj-code
      480                    no-error
      481               .
      482               if available buf_firm
      483               then do:
      484                   assign
      485                       v-num-country-city = num-entries( buf_firm.city )
      486                       v-fmtcli-engl-name = buf_firm.engl-name
      487                   .
      488                   if v-num-country-city > 0
      489                   then do:
      490                       assign
      491                           v-fmtcli-country    = trim( entry( 1, buf_firm.city ) )
      492                       .
      493                   end.
      494                   if v-num-country-city > 1
      495                   then do:
      496                       assign
      497                           v-fmtcli-city       = trim( entry( 2, buf_firm.city ) )
      498                       .
      499                   end.
      500                   run fmtcli-concatenate-strings in this-procedure (
      501                         input v-fmtcli-full-addres
      502                       , input v-fmtcli-country
      503                       , input ", ":U
      504                       , input 50
      505                       , output v-fmtcli-full-addres
      506                   ).
      507                   run fmtcli-concatenate-strings in this-procedure (
      508                         input v-fmtcli-full-addres
      509                       , input v-fmtcli-city
      510                       , input ", ":U
      511                       , input 50
      512                       , output v-fmtcli-full-addres
      513                   ).
      514                   run fmtcli-concatenate-strings in this-procedure (
      515                         input v-fmtcli-full-addres
      516                       , input IF buf_firm.ind = 0 THEN "" ELSE string( buf_firm.ind )
      517                       , input ", ":U
      518                       , input 50
      519                       , output v-fmtcli-full-addres
      520                   ).
      521                   run fmtcli-concatenate-strings in this-procedure (
      522                         input v-fmtcli-post-addres
      523                       , input v-fmtcli-country
      524                       , input ", ":U
      525                       , input 50
      526                       , output v-fmtcli-post-addres
      527                   ).
      528                   run fmtcli-concatenate-strings in this-procedure (
      529                         input v-fmtcli-post-addres
      530                       , input v-fmtcli-city
      531                       , input ", ":U
      532                       , input 50
      533                       , output v-fmtcli-post-addres
      534                   ).
      535                   run fmtcli-concatenate-strings in this-procedure (
      536                         input v-fmtcli-post-addres
      537                       , input string( buf_firm.ind )
      538                       , input ", ":U
      539                       , input 50
      540                       , output v-fmtcli-post-addres
      541                   ).
      542                   run fmtcli-concatenate-strings in this-procedure (
      543                         input substring( buf_firm.addres1, 1, 50 )
      544                       , input buf_firm.addres2
      545                       , input " ":U
      546                       , input 50
      547                       , output v-temp-fmtcli-address
      548                   ).
      549                   run fmtcli-concatenate-strings in this-procedure (
      550                         input v-temp-fmtcli-address
      551                       , input substring( buf_firm.addres1, 51, 50 )
      552                       , input " ":U
      553                       , input 50
      554                       , output v-temp-fmtcli-address
      555                   ).
      556                   run fmtcli-concatenate-strings in this-procedure (
      557                         input v-temp-fmtcli-address
      558                       , input substring( buf_firm.addres1, 101, 50 )
      559                       , input " ":U
      560                       , input 50
      561                       , output v-temp-fmtcli-address
      562                   ).
      563                   assign
      564                       v-fmtcli-addres = v-temp-fmtcli-address
      565                   .
      566                   if buf_firm.addres1 <> ?
      567                   then do:
      568                       run fmtcli-concatenate-strings in this-procedure (
      569                             input v-fmtcli-full-addres
      570                           , input v-fmtcli-addres
      571                           , input ", ":U
      572                           , input 0
      573                           , output v-fmtcli-full-addres
      574                       ).
      575                   end.
      576                   run fmtcli-concatenate-strings in this-procedure (
      577                         input substring( buf_firm.post-addr1, 1, 50 )
      578                       , input buf_firm.post-addr2
      579                       , input " ":U
      580                       , input 50
      581                       , output v-fmtcli-post-addres
      582                   ).
      583                   run fmtcli-concatenate-strings in this-procedure (
      584                         input v-fmtcli-post-addres
      585                       , input substring( buf_firm.post-addr1, 51, 50 )
      586                       , input " ":U
      587                       , input 50
      588                       , output v-fmtcli-post-addres
      589                   ).
      590                   run fmtcli-concatenate-strings in this-procedure (
      591                         input v-fmtcli-post-addres
      592                       , input substring( buf_firm.post-addr1, 101, 50 )
      593                       , input " ":U
      594                       , input 50
      595                       , output v-fmtcli-post-addres
      596                   ).
      597                   assign
      598                       v-fmtcli-phone         = buf_firm.phone
      599                       v-fmtcli-inn           = buf_firm.inn
      600                       v-fmtcli-kpp           = buf_firm.kpp
      601                       v-fmtcli-okpo          = buf_firm.okpo
      602                       v-fmtcli-index         = string( buf_firm.ind )
      603                   .
      604               end.
      605          end.
      606          when 'маг':U
      607          then do:
      608               find first buf_shop no-lock
      609                    where buf_shop.obj-code = buf_clients.obj-code
      610               .
      611               if available buf_shop
      612               then do:
      613                   run fmtcli-concatenate-strings in this-procedure (
      614                         input buf_shop.addres1
      615                       , input buf_shop.addres2
      616                       , input " ":U
      617                       , input 50
      618                       , output v-fmtcli-addres
      619                   ).
      620                   assign
      621                       v-fmtcli-full-addres = v-fmtcli-addres
      622                       v-fmtcli-post-addres = v-fmtcli-addres
      623                       v-fmtcli-phone       = buf_shop.phone
      624                       v-fmtcli-inn         = "":U
      625                       v-fmtcli-kpp         = "":U
      626                       v-fmtcli-okpo        = "":U
      627                       v-fmtcli-city        = "":U
      628                       v-fmtcli-index       = "":U
      629                   .
      630               end.
      631          end.
      632          when 'скл':U
      633          then do:
      634               find first buf_store no-lock
      635                    where buf_store.obj-code = buf_clients.obj-code
      636               .
      637               if available buf_store
      638               then do:
      639                   run fmtcli-concatenate-strings in this-procedure (
      640                         input buf_store.addres1
      641                       , input buf_store.addres2
      642                       , input " ":U
      643                       , input 50
      644                       , output v-fmtcli-addres
      645                   ).
      646                   assign
      647                       v-fmtcli-full-addres = v-fmtcli-addres
      648                       v-fmtcli-phone       = buf_store.phone
      649                       v-fmtcli-inn         = "":U
      650                       v-fmtcli-kpp         = "":U
      651                       v-fmtcli-okpo        = "":U
      652                       v-fmtcli-city        = "":U
      653                       v-fmtcli-index       = "":U
      654                   .
      655               end.
      656          end.
      657          when 'чел':U
      658          then do:
      659               find first buf_person no-lock
      660                    where buf_person.psn-code = buf_clients.obj-code
      661               .
      662               if available buf_person
      663               then do:
      664                   run fmtcli-concatenate-strings in this-procedure (
      665                         input ( if buf_person.ind = 0 or buf_person.ind = ?
      666                                 then "":U
      667                                 else string( buf_person.ind, "999999")
      668                                 )
      669                       , input buf_person.city
      670                       , input ", ":U
      671                       , input 0
      672                       , output v-fmtcli-full-addres
      673                   ).
      674                   assign
      675                       v-fmtcli-addres = buf_person.address
      676                   .
      677                   run fmtcli-concatenate-strings in this-procedure (
      678                         input v-fmtcli-full-addres
      679                       , input v-fmtcli-addres
      680                       , input ", ":U
      681                       , input 0
      682                       , output v-fmtcli-full-addres
      683                   ).
      684                   assign
      685                       v-fmtcli-phone     = buf_person.phone1
      686                       v-fmtcli-inn       = buf_person.inn
      687                       v-fmtcli-kpp       = buf_person.kpp
      688                       v-fmtcli-okpo      = buf_person.okpo
      689                       v-fmtcli-city      = buf_person.city
      690                       v-fmtcli-index     = string( buf_person.ind )
      691                   .
      692               end.
      693          end.
      694       end case.
      695   end.
      696   end procedure.
      697   procedure fmtcli-concatenate-strings :
      698   define input parameter p-string-1       as character        no-undo.
      699   define input parameter p-string-2       as character        no-undo.
      700   define input parameter p-delimiter      as character        no-undo.
      701   define input parameter p-length         as integer          no-undo.
      702   define output parameter p-out-string    as character        no-undo.
      703   do
      704   on error undo, return error
      705   :
      706       assign
      707           p-out-string = ( if p-string-1 = ?
      708                            then "":U
      709                            else trim( p-string-1 ) )
      710       .
      711       assign
      712           p-out-string = p-out-string
      713                        + ( if p-out-string = "":U
      714                            or length( p-out-string ) = p-length
      715                            or p-string-2 = ?
      716                            or trim( p-string-2 ) = "":U
      717                            then "":U
      718                            else p-delimiter )
      719                        + ( if p-string-2 = ?
      720                            or trim( p-string-2 ) = "":U
      721                            then "":U
      722                            else trim( p-string-2 ) )
      723       .
      724   end.
      725   end procedure.
      726   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      727   procedure cur-time :
      728      define output parameter p-today as date      no-undo .
      729      define output parameter p-time  as integer   no-undo .
      730     do
      731     on error undo, return error
      732     :
      733       define variable v-date1 as date      no-undo .
      734       define variable v-date2 as date      no-undo .
      735       define variable v-time  as integer   no-undo .
      736       assign
      737         v-date1 = today
      738         v-time  = time
      739         v-date2 = today
      740       .
      741       if v-date1 <> v-date2
      742       then do:
      743         assign
      744           v-date1 = today
      745           v-time  = v-time
      746         .
      747       end.
      748       assign
      749         p-today = v-date1
      750         p-time  = v-time
      751       .
      752     end.
      753   end.
      754   function cur-time-date returns character
      755   :
      756     return string(today, '99/99/9999':U) .
      757   end.
      758   function cur-time-mjd returns decimal
      759   :
      760     define variable v-date as date      no-undo .
      761     define variable v-time as integer   no-undo .
      762     run cur-time in this-procedure
      763       (output v-date
      764       ,output v-time
      765       ) .
      766     return integer(v-date) - 2400002 + (v-time / 86400) .
      767   end.
      768   function cur-time-get-ending-index returns integer
      769   (input p-number as integer
      770   )
      771   :
      772     if p-number < 0
      773     or p-number = ?
      774     then do:
      775       return 1 .
      776     end.
      777     define variable v-rest as integer   no-undo .
      778     assign
      779       p-number = p-number modulo 100
      780     .
      781     if p-number < 20
      782     then do:
      783       assign
      784         v-rest = p-number
      785       .
      786     end.
      787     else do:
      788       assign
      789         v-rest = p-number modulo 10
      790       .
      791     end.
      792     case v-rest :
      793       when 1
      794       then do:
      795         return 2 .
      796       end.
      797       when 2 or
      798       when 3 or
      799       when 4
      800       then do:
      801         return 3 .
      802       end.
      803       otherwise do:
      804         return 1 .
      805       end.
      806     end case .
      807   end.
      808   procedure cur-time-mjd-to-date :
      809      define input  parameter i-mjd-diff as decimal no-undo.
      810      define output parameter o-Date     as date    no-undo.
      811      define output parameter o-Time     as integer no-undo.
      812      define variable v-day-number as integer   no-undo .
      813      if    i-mjd-diff < 0
      814         or i-mjd-diff = ?
      815      then do:
      816         return "?" .
      817      end.
      818      assign
      819         v-day-number = truncate(i-mjd-diff,0).
      820         o-Date = date(v-day-number + 2400002).
      821         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      822     .
      823   end.
      824   function cur-time-mjd-to-string returns character
      825   (input p-mjd-diff as decimal
      826   )
      827   :
      828     define variable v-day-number as integer   no-undo .
      829     define variable v-seconds    as integer   no-undo .
      830     define variable v-hour       as integer   no-undo .
      831     define variable v-min        as integer   no-undo .
      832     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      833     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      834     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      835     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      836     if p-mjd-diff < 0
      837     or p-mjd-diff = ?
      838     then do:
      839       return "?" .
      840     end.
      841     assign
      842       v-day-number = integer(truncate(p-mjd-diff,0))
      843       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      844     .
      845     if v-seconds > 86400
      846     then do:
      847       assign
      848         v-seconds = 86400 - 1
      849       .
      850     end.
      851     if v-seconds < 0
      852     then do:
      853       assign
      854         v-seconds = 0
      855       .
      856     end.
      857     assign
      858       v-hour = truncate(v-seconds / 3600, 0)
      859     .
      860     assign
      861       v-seconds = v-seconds modulo 3600
      862     .
      863     assign
      864       v-min = truncate(v-seconds / 60, 0)
      865     .
      866     assign
      867       v-seconds = v-seconds modulo 60
      868     .
      869     return
      870         (if v-day-number <> 0
      871           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      872           else ""
      873         )
      874       + (if v-day-number <> 0 or v-hour <> 0
      875           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      876           else ""
      877         )
      878       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      879           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      880           else ""
      881         )
      882       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      883       .
      884   end.
      885   function cur-time-string returns character
      886   :
      887     define variable v-date as date      no-undo .
      888     define variable v-time as integer   no-undo .
      889     run cur-time in this-procedure
      890       (output v-date
      891       ,output v-time
      892       ) .
      893     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      894   end.
      895   function cur-time-string-sec returns character
      896   :
      897     define variable v-date as date      no-undo .
      898     define variable v-time as integer   no-undo .
      899     run cur-time in this-procedure
      900       (output v-date
      901       ,output v-time
      902       ) .
      903     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      904   end.
      905   function cur-time-custom  returns character
      906   (input p-prefix as character
      907   ,input p-date-format as character
      908   ,input p-delimiter as character
      909   ,input p-time-format as character
      910   ,input p-suffix as character
      911   )
      912   :
      913     define variable v-date as date      no-undo .
      914     define variable v-time as integer   no-undo .
      915     run cur-time in this-procedure
      916       (output v-date
      917       ,output v-time
      918       ) .
      919     return
      920       p-prefix
      921       + string(v-date, p-date-format)
      922       + p-delimiter
      923       + string(v-time, p-time-format)
      924       + p-suffix
      925       .
      926   end.
      927   function cur-time-print  returns character
      928   :
      929     define variable v-date as date      no-undo .
      930     define variable v-time as integer   no-undo .
      931     run cur-time in this-procedure
      932       (output v-date
      933       ,output v-time
      934       ) .
      935     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      936   end.
      937   function cur-time-datetime returns datetime
      938   :
      939     define variable v-char as character no-undo .
      940     define variable v-datetime as datetime no-undo .
      941     v-char = cur-time-string().
      942     v-datetime = datetime(v-char).
      943     return  v-datetime.
      944   end.
      945   function cur-time-string-msec returns character
      946   :
      947     define variable v-date as datetime  no-undo .
      948     v-date = now.
      949     return string(v-date) .
      950   end.
      951   define new global shared variable g#lib-trn  as handle no-undo .
      952   define new global shared variable g#lib-trn2 as handle no-undo .
      953   define new global shared variable g#lib-trn3 as handle no-undo .
      954   define new global shared variable g#lib-trn4 as handle no-undo .
      955   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      956   define new global shared variable g#trdcalib as handle no-undo.
      957       define stream out-stream.
      958       define variable v-inv-new-line-counter  as integer      no-undo.
      959       define variable v-single-line           as character    no-undo.
      960       define variable v-today                 as date         no-undo.
      961       define variable v-time                  as integer      no-undo.
      962       define variable v-print-rubl            as logical      no-undo.
      963       define variable v-page-after-sum        as decimal      no-undo.
      964       define variable v-page-before-sum       as decimal      no-undo.
      965       define variable v-page-surplus-sum      as decimal      no-undo.
      966       define variable v-page-lack-sum         as decimal      no-undo.
      967       define variable v-doc-after-sum         as decimal      no-undo.
      968       define variable v-doc-before-sum        as decimal      no-undo.
      969       define variable v-doc-surplus-sum       as decimal      no-undo.
      970       define variable v-doc-lack-sum          as decimal      no-undo.
      971       define variable g#report-num    as integer      no-undo.
      972       define variable g#quest-print   as logical      no-undo.
      973       define variable g#log           as logical      no-undo.
      974       define buffer buf_trn-doc       for trn-doc.
      975       define buffer buf_doc-line      for doc-line.
      976   do
      977   on error undo, return error
      978   :
      979       run get-report-num in p-mainmenu-handle (
      980           output g#report-num
      981       ).
      982       run get-quest-print in p-mainmenu-handle (
      983           output g#quest-print
      984       ).
      985       find first buf_trn-doc no-lock
      986            where recid( buf_trn-doc ) = p-trn-doc-recid
      987       no-error.
      988       if not available buf_trn-doc
      989       then do:
      990           message
      991                    vss-workfile vss-revision vss-description
      992               skip(1)
      993               skip "Неверно выбран документ."
      994           view-as alert-box error.
      995           undo, return error .
      996       end.
      997       if buf_trn-doc.ext-doc-type <> 'vt':U
      998       then do:
      999           message
     1000                   "Ошибка выбора документа."
     1001               skip(1)
     1002               skip "Форма предназначена только для печати"
     1003               skip "документов инвентаризации."
     1004           view-as alert-box error.
     1005           undo, return error .
     1006       end.
     1007       assign
     1008           v-single-line  = fill( "-", 230 )
     1009           v-inv-new-line-counter = 0
     1010           v-print-rubl   = ( if PrintRubl = yes then yes else no )
     1011       .
     1012   if session :set-wait-state( "compiler" ) then.
     1013   output stream out-stream to value( string( session:temp-directory +
     1014                                        "rpt" + string( g#report-num ) ) )
     1015                                        page-size  value(230) .
     1016       run fmtcli-get-client in this-procedure (
     1017             input buf_trn-doc.obj-type
     1018           , input buf_trn-doc.obj-code
     1019       ).
     1020       run cur-time in this-procedure (
     1021             output v-today
     1022           , output v-time
     1023       ).
     1024       put stream Out-Stream
     1025           skip space(5)
     1026               substitute( "Объект: (&1 &2) &3"
     1027                           , buf_trn-doc.obj-type
     1028                           , buf_trn-doc.obj-code
     1029                           , v-fmtcli-name      )              format "X(193)"
     1030           skip(1) space(5)
     1031               substitute( "Дата печати: &1"
     1032                           , string( v-today, "99/99/9999" ) ) format "X(23)"
     1033               "Инвентаризация"                                   at 5 + 23 + 60
     1034       .
     1035       run print-header in this-procedure (
     1036           input yes
     1037       ).
     1038       for each buf_doc-line no-lock
     1039          where buf_doc-line.doc-code = buf_trn-doc.doc-code
     1040       by buf_doc-line.artic
     1041       on error undo, return error
     1042       :
     1043           assign
     1044               v-inv-new-line-counter  = v-inv-new-line-counter    + 1
     1045           .
     1046           run print-line in this-procedure (
     1047                 input buf_doc-line.doc-code
     1048               , input buf_doc-line.artic
     1049               , input buf_doc-line.prod-type
     1050               , input buf_doc-line.prod-code
     1051               , input v-print-rubl
     1052           ).
     1053       end.
     1054       run print-footer in this-procedure (
     1055           input v-print-rubl
     1056       ).
     1057       output stream Out-Stream close.
     1058   if session :set-wait-state( "" ) then.
     1059   if g#quest-print = false
     1060   then do:
     1061     run adecomm/_osprint.p ( ?, string( session:temp-directory + "rpt" + string( g#report-num ) ),
     1062                                         7, (if 8 >= 8 then 2 else 0), 0, 0,
     1063                                         OUTPUT g#log ).
     1064   end.
     1065   else do:
     1066     os-command silent
     1067       value( "COPY /b " +
     1068         string( session:temp-directory) +  "$" + string( g#report-num ) + " + " +
     1069         string( session:temp-directory) + "rpt" + string( g#report-num ) + " " +
     1070         string( session:temp-directory) +  "$" + string( g#report-num )
     1071                 ) .
     1072     os-command silent
     1073       value( "COPY /b " +
     1074         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl" + " + " +
     1075         string( session:temp-directory) + "rpt" + string( g#report-num ) + ".txl" + " " +
     1076         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl"
     1077                 ) .
     1078   end.
     1079   end.
     1080   procedure print-header :
     1081   define input parameter p-first  as logical      no-undo.
     1082   do
     1083   on error undo, return error
     1084   :
     1085       if line-counter( Out-stream ) = 0
     1086       or p-first = yes
     1087       then do:
     1088           put stream Out-Stream
     1089               skip string( "Страница " + string( PAGE-NUMBER( Out-Stream ), ">>9" ) ) format "X(13)"   at right-field( 198, 13)
     1090           .
     1091           put stream Out-Stream
     1092               skip
     1093                   v-single-line           format "X(194)"    at 5
     1094               skip
     1095                   "|"                                     at 5
     1096                   "N"                                     at center-field( 5, 10, 1 )
     1097                   "|"                                     at 10
     1098                   "Код"                                   at center-field( 10, 20, 3 )
     1099                   "|"                                     at 20
     1100                   "Артикул"                               at center-field( 20, 37, 7 )
     1101                   "|"                                     at 37
     1102                   "Наименование товара"                   at 37 + 2
     1103                   "|"                                     at 70
     1104                   "Ед."                                   at center-field( 70, 75, 3 )
     1105                   "|"                                     at 75
     1106                   "Учетный"                               at center-field( 75, 87, 7 )
     1107                   "|"                                     at 87
     1108                   "Продажная"                             at center-field( 87, 98, 9 )
     1109                   "|"                                     at 98
     1110                   "Сумма по ТН"                           at center-field( 98, 114, 11 )
     1111                   "|"                                     at 114
     1112                   "Количество"                            at center-field( 114, 126, 10 )
     1113                   "|"                                     at 126
     1114                   "Сумма"                                 at center-field( 126, 142, 5 )
     1115                   "|"                                     at 142
     1116                   "Излишки"                               at center-field( 142, 154, 7 )
     1117                   "|"                                     at 154
     1118                   "Сумма"                                 at center-field( 154, 170, 5 )
     1119                   "|"                                     at 170
     1120                   "Недостача"                             at center-field( 170, 182, 9 )
     1121                   "|"                                     at 182
     1122                   "Сумма"                                 at center-field( 182, 198, 5 )
     1123                   "|"                                     at 198
     1124               skip
     1125                   "|"                                     at 5
     1126                   "п/п"                                   at center-field( 5, 10, 3 )
     1127                   "|"                                     at 10
     1128                   "|"                                     at 20
     1129                   "|"                                     at 37
     1130                   "|"                                     at 70
     1131                   "изм."                                  at center-field( 70, 75, 4 )
     1132                   "|"                                     at 75
     1133                   "остаток"                               at center-field( 75, 87, 7 )
     1134                   "|"                                     at 87
     1135                   "цена"                                  at center-field( 87, 98, 4 )
     1136                   "|"                                     at 98
     1137                   "|"                                     at 114
     1138                   "по факту"                              at center-field( 114, 126, 8 )
     1139                   "|"                                     at 126
     1140                   "по факту"                              at center-field( 126, 142, 8 )
     1141                   "|"                                     at 142
     1142                   "|"                                     at 154
     1143                   "излишков"                              at center-field( 154, 170, 8 )
     1144                   "|"                                     at 170
     1145                   "|"                                     at 182
     1146                   "недостачи"                             at center-field( 182, 198, 9 )
     1147                   "|"                                     at 198
     1148               skip
     1149                   "|"                                     at 5
     1150                   v-single-line                           format "X(192)"
     1151                   "|"
     1152           .
     1153       end.
     1154   end.
     1155   end procedure.
     1156   procedure print-line :
     1157   define input parameter p-doc-code   as character        no-undo.
     1158   define input parameter p-artic      as character        no-undo.
     1159   define input parameter p-prod-type  as character        no-undo.
     1160   define input parameter p-prod-code  as integer          no-undo.
     1161   define input parameter p-print-rubl as logical          no-undo.
     1162       define variable v-price-sale            as decimal      no-undo.
     1163       define variable v-before-qnty           as decimal      no-undo.
     1164       define variable v-before-sum            as decimal      no-undo.
     1165       define variable v-before-sum-rubl       as decimal      no-undo.
     1166       define variable v-before-sum-base       as decimal      no-undo.
     1167       define variable v-after-qnty            as decimal      no-undo.
     1168       define variable v-after-sum             as decimal      no-undo.
     1169       define variable v-after-sum-rubl        as decimal      no-undo.
     1170       define variable v-after-sum-base        as decimal      no-undo.
     1171       define variable v-surplus-qnty          as decimal      no-undo.
     1172       define variable v-surplus-sum           as decimal      no-undo.
     1173       define variable v-lack-qnty             as decimal      no-undo.
     1174       define variable v-lack-sum              as decimal      no-undo.
     1175       define buffer buf_doc-line      for doc-line.
     1176       define buffer buf_goods         for goods.
     1177   do
     1178   on error undo, return error
     1179   :
     1180       find first buf_goods no-lock
     1181            where buf_goods.artic      = p-artic
     1182              and buf_goods.prod-type  = p-prod-type
     1183              and buf_goods.prod-code  = p-prod-code
     1184       .
     1185       find first buf_doc-line no-lock
     1186            where buf_doc-line.doc-code  = p-doc-code
     1187              and buf_doc-line.artic     = buf_goods.artic
     1188              and buf_doc-line.prod-type = buf_goods.prod-type
     1189              and buf_doc-line.prod-code = buf_goods.prod-code
     1190       .
     1191       run print-header in this-procedure (
     1192           input no
     1193       ).
     1194       run get-before-and-after-inv-qnty in this-procedure (
     1195             input p-doc-code
     1196           , input buf_goods.gds-code
     1197           , output v-before-qnty
     1198           , output v-before-sum-rubl
     1199           , output v-before-sum-base
     1200           , output v-after-qnty
     1201           , output v-after-sum-rubl
     1202           , output v-after-sum-base
     1203       ) no-error.
     1204       if error-status :error
     1205       then do:
     1206           message
     1207                    vss-workfile vss-revision vss-description
     1208               skip(1)
     1209               skip "Ошибка вычисления сумм до и после инвентаризации."
     1210               skip(1)
     1211               skip "Документ:" p-doc-code
     1212               skip "Товар:" buf_goods.artic buf_goods.gds-name
     1213               skip(1)
     1214               skip "Строка товара в форме может содержать неверные данные."
     1215           view-as alert-box warning.
     1216           assign
     1217               v-price-sale  = 0
     1218               v-before-qnty = 0
     1219               v-before-sum  = 0
     1220               v-after-qnty  = 0
     1221               v-after-sum   = 0
     1222           .
     1223       end.
     1224       if p-print-rubl
     1225       then do:
     1226           assign
     1227               v-before-sum = v-before-sum-rubl
     1228               v-after-sum  = v-after-sum-rubl
     1229               v-price-sale = v-before-sum-rubl / v-before-qnty
     1230           .
     1231       end.
     1232       else do:
     1233           assign
     1234               v-before-sum = v-before-sum-base
     1235               v-after-sum  = v-after-sum-base
     1236               v-price-sale = v-before-sum-base / v-before-qnty
     1237           .
     1238       end.
     1239       assign
     1240           v-surplus-qnty  = 0
     1241           v-surplus-sum   = 0
     1242           v-lack-qnty     = 0
     1243           v-lack-sum      = 0
     1244       .
     1245       if v-before-qnty < v-after-qnty
     1246       then do:
     1247           assign
     1248               v-surplus-qnty = v-after-qnty - v-before-qnty
     1249               v-surplus-sum  = v-after-sum  - v-before-sum
     1250           .
     1251       end.
     1252       if v-before-qnty > v-after-qnty
     1253       then do:
     1254           assign
     1255               v-lack-qnty = v-before-qnty - v-after-qnty
     1256               v-lack-sum  = v-before-sum  - v-after-sum
     1257           .
     1258       end.
     1259       put stream out-stream
     1260           skip
     1261               "|"                                         at 5
     1262               v-inv-new-line-counter  format ">>>9"
     1263               "|"                                         at 10
     1264               buf_goods.gds-code      format "999999999"
     1265               "|"                                         at 20
     1266               p-artic                 format "X(16)"
     1267               "|"                                         at 37
     1268               buf_goods.gds-name      format "X(32)"
     1269               "|"                                         at 70
     1270               buf_goods.unit-base     format "X(4)"
     1271               "|"                                         at 75
     1272               v-before-qnty           format "->>>,>>9.99"
     1273               "|"                                         at 87
     1274               v-price-sale            format ">>>,>>9.99"
     1275               "|"                                         at 98
     1276               v-before-sum            format "->>>,>>>,>>9.99"
     1277               "|"                                         at 114
     1278               v-after-qnty            format "->>>,>>9.99"
     1279               "|"                                         at 126
     1280               v-after-sum             format "->>>,>>>,>>9.99"
     1281               "|"                                         at 142
     1282               v-surplus-qnty          format "->>>,>>9.99"
     1283               "|"                                         at 154
     1284               v-surplus-sum           format "->>>,>>>,>>9.99"
     1285               "|"                                         at 170
     1286               v-lack-qnty             format "->>>,>>9.99"
     1287               "|"                                         at 182
     1288               v-lack-sum              format "->>>,>>>,>>9.99"
     1289               "|"                                         at 198
     1290       .
     1291       assign
     1292           v-page-after-sum        = v-page-after-sum      + v-after-sum
     1293           v-page-before-sum       = v-page-before-sum     + v-before-sum
     1294           v-page-surplus-sum      = v-page-surplus-sum    + v-surplus-sum
     1295           v-page-lack-sum         = v-page-lack-sum       + v-lack-sum
     1296       .
     1297       if line-counter( Out-stream ) + 2 > page-size( Out-stream )
     1298       then do:
     1299           run print-end-of-page in this-procedure (
     1300               input yes
     1301           ).
     1302       end.
     1303   end.
     1304   end procedure.
     1305   procedure print-footer :
     1306   do
     1307   on error undo, return error
     1308   :
     1309   define input parameter p-print-rubl as logical      no-undo.
     1310       define variable v-all-sum-cost as decimal       no-undo.
     1311       run print-end-of-page in this-procedure (
     1312           input no
     1313       ).
     1314       if line-counter( Out-stream ) + 10 > page-size( Out-stream )
     1315       then do:
     1316           page stream out-stream.
     1317       end.
     1318       put stream Out-Stream
     1319           skip (1)
     1320               "Всего по документу:   "                        at 5
     1321               v-doc-before-sum            format "->>>,>>>,>>9.99"  at 98 + 1
     1322               v-doc-after-sum             format "->>>,>>>,>>9.99"  at 126 + 1
     1323               v-doc-surplus-sum           format "->>>,>>>,>>9.99"  at 154 + 1
     1324               v-doc-lack-sum              format "->>>,>>>,>>9.99"  at 182 + 1
     1325       .
     1326       put stream Out-Stream
     1327           skip (2)
     1328               "Гл. Бухгалтер:_______________________________________________________________ "                       at 5
     1329           skip (1)
     1330               "Начальник розничной сети:____________________________________________________ "                       at 5
     1331       .
     1332   end.
     1333   end procedure.
     1334   procedure print-end-of-page :
     1335   do
     1336   on error undo, return error
     1337   :
     1338   define input parameter p-print-continue-line    as logical      no-undo.
     1339       put stream Out-Stream
     1340           skip
     1341               v-single-line           format "X(194)"     at 5
     1342           skip
     1343               "Итого: "                                       at 37
     1344               v-page-before-sum       format "->>>,>>>,>>9.99"      at 98 + 1
     1345               v-page-after-sum        format "->>>,>>>,>>9.99"      at 126 + 1
     1346               v-page-surplus-sum      format "->>>,>>>,>>9.99"      at 154 + 1
     1347               v-page-lack-sum         format "->>>,>>>,>>9.99"      at 182 + 1
     1348       .
     1349       if p-print-continue-line = yes
     1350       then do:
     1351           put stream Out-Stream
     1352               skip
     1353                   v-single-line           format "X(194)"    at 5
     1354               skip
     1355                   "Продолжение - на следующей странице"               at 30
     1356           .
     1357       end.
     1358       assign
     1359           v-doc-after-sum     = v-doc-after-sum     + v-page-after-sum
     1360           v-doc-before-sum    = v-doc-before-sum    + v-page-before-sum
     1361           v-doc-surplus-sum   = v-doc-surplus-sum   + v-page-surplus-sum
     1362           v-doc-lack-sum      = v-doc-lack-sum      + v-page-lack-sum
     1363       .
     1364       assign
     1365           v-page-after-sum   = 0
     1366           v-page-before-sum  = 0
     1367           v-page-surplus-sum = 0
     1368           v-page-lack-sum    = 0
     1369       .
     1370   end.
     1371   end procedure.
     1372   procedure get-before-and-after-inv-qnty :
     1373   define input parameter p-doc-code           as character        no-undo.
     1374   define input parameter p-gds-code           as integer          no-undo.
     1375   define output parameter p-before-qnty       as decimal          no-undo.
     1376   define output parameter p-before-sum-rubl   as decimal          no-undo.
     1377   define output parameter p-before-sum-base   as decimal          no-undo.
     1378   define output parameter p-after-qnty        as decimal          no-undo.
     1379   define output parameter p-after-sum-rubl    as decimal          no-undo.
     1380   define output parameter p-after-sum-base    as decimal          no-undo.
     1381       define variable v-attr-value    as character     no-undo.
     1382       define variable v-attr-type     as character     no-undo.
     1383       define buffer buf_trn-doc-sum       for trn-doc-sum.
     1384       define buffer buf_doc-line-sum      for doc-line-sum.
     1385   do
     1386   on error undo, return error
     1387   :
     1388   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input p-doc-code ,
     1389                           input 'addsum':U ,
     1390                          output v-attr-value ,
     1391                          output v-attr-type )  .
     1392       if lookup( 'bd':U, v-attr-value ) <> 0
     1393       then do:
     1394           find first buf_doc-line-sum no-lock
     1395                where buf_doc-line-sum.doc-code = p-doc-code
     1396                  and buf_doc-line-sum.gds-code = p-gds-code
     1397                  and buf_doc-line-sum.sum-type = 'bd':U
     1398           no-error.
     1399           if available buf_doc-line-sum
     1400           then do:
     1401               assign
     1402                   p-before-qnty       = buf_doc-line-sum.fact-qnty
     1403                   p-before-sum-rubl   = buf_doc-line-sum.crsa-sum-rubl
     1404                   p-before-sum-base   = buf_doc-line-sum.crsa-sum-base
     1405               .
     1406           end.
     1407           else do:
     1408               message
     1409                   skip "Не найдена запись trn-doc-sum"
     1410                   skip(1)
     1411                   skip "Номер документа:" p-doc-code
     1412                   skip "Код товара:" p-gds-code
     1413               view-as alert-box error.
     1414               undo, return error .
     1415           end.
     1416       end.
     1417       if lookup( 'ad':U, v-attr-value ) <> 0
     1418       then do:
     1419           find first buf_doc-line-sum no-lock
     1420                where buf_doc-line-sum.doc-code = p-doc-code
     1421                  and buf_doc-line-sum.gds-code = p-gds-code
     1422                  and buf_doc-line-sum.sum-type = 'ad':U
     1423           no-error.
     1424           if available buf_doc-line-sum
     1425           then do:
     1426               assign
     1427                   p-after-qnty       = buf_doc-line-sum.fact-qnty
     1428                   p-after-sum-rubl   = buf_doc-line-sum.crsa-sum-rubl
     1429                   p-after-sum-base   = buf_doc-line-sum.crsa-sum-base
     1430               .
     1431           end.
     1432           else do:
     1433               message
     1434                   skip "Не найдена запись trn-doc-sum"
     1435                   skip(1)
     1436                   skip "Номер документа:" p-doc-code
     1437                   skip "Код товара:" p-gds-code
     1438               view-as alert-box error.
     1439               undo, return error .
     1440           end.
     1441       end.
     1442   end.
     1443   end procedure.
