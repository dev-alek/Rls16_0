     2432   procedure run4 :
     2433         case select-good :
     2434            when 1  then do:
     2435   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2436   IF x-SelectObject = "currency":U  OR  xTog-obj THEN DO :
     2437       for each gds-obj  where
     2438             gds-obj.obj-type = x-store-type  and
     2439             gds-obj.obj-code = x-store-code
     2440             and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     2441         no-lock,
     2442   First clients  where  clients.obj-code = gds-obj.prod-code and
     2443                         clients.obj-type = gds-obj.prod-type
     2444                   no-lock,
     2445             First goods  where  gds-obj.gds-code   = goods.gds-code
     2446   no-lock
     2447   BREAK BY ((substring(clients.obj-name,1,10) + string(temp-gds-list.prod-code)))
     2448         BY (temp-gds-list.grp-name)
     2449       BY (temp-gds-list.gds-name) :
     2450         run item-goods ( "4" , "goods" ) .
     2451         if return-value <> "" then NEXT.
     2452           If Last-of(temp-gds-list.grp-name) Then Do:
     2453           If String(Entry(2,"temp-gds-list.grp-name",".")) = "Grp-name"
