     3904   procedure oborot-stk :
     3905   define input  parameter l-store-code   like ub.clients.obj-code      no-undo.
     3906   define input  parameter l-store-type   like ub.clients.obj-type      no-undo.
     3907   define input  parameter l-artic        like ub.stk-line.artic        no-undo.
     3908   define input  parameter l-prod-code    like ub.stk-line.prod-code    no-undo.
     3909   define input  parameter l-prod-type    like ub.stk-line.prod-type    no-undo.
     3910   define input  parameter l-tog-shift    as   logical                  no-undo.
     3911   define input  parameter l-fact-order-1   like ub.stk-line.fact-order   no-undo.
     3912   define input  parameter l-fact-order-2   like ub.stk-line.fact-order   no-undo.
     3913   define input  parameter l-sum-type     like ub.stk-line.sum-type     no-undo.
     3914   define input  parameter l-cat-id       like ub.stk-line.cat-id       no-undo.
     3915   define input  parameter l-tog-obj       as log no-undo.
     3916   define output parameter quantity    like ub.stk-line.fact-qnty   no-undo.
     3917   define output parameter coast_r     like ub.stk-line.sum-rubl    no-undo.
     3918   define output parameter coast_v     like ub.stk-line.sum-rubl    no-undo.
     3919   define output parameter vat_r       like ub.stk-line.sum-rubl    no-undo.
     3920   define output parameter vat_v       like ub.stk-line.sum-rubl    no-undo.
     3921   define output parameter slt_r       like ub.stk-line.sum-rubl    no-undo.
     3922   define output parameter slt_v       like ub.stk-line.sum-rubl    no-undo.
     3923   define output parameter other_r     like ub.stk-line.sum-rubl    no-undo.
     3924   define output parameter other_v     like ub.stk-line.sum-rubl    no-undo.
     3925   define variable  quantity#1    like ub.stk-line.fact-qnty   no-undo.
     3926   define variable  coast_r#1     like ub.stk-line.sum-rubl    no-undo.
     3927   define variable  coast_v#1     like ub.stk-line.sum-rubl    no-undo.
     3928   define variable  vat_r#1       like ub.stk-line.sum-rubl    no-undo.
     3929   define variable  vat_v#1       like ub.stk-line.sum-rubl    no-undo.
     3930   define variable  slt_r#1       like ub.stk-line.sum-rubl    no-undo.
     3931   define variable  slt_v#1       like ub.stk-line.sum-rubl    no-undo.
     3932   define variable  other_r#1     like ub.stk-line.sum-rubl    no-undo.
     3933   define variable  other_v#1     like ub.stk-line.sum-rubl    no-undo.
     3934   define variable  quantity#2    like ub.stk-line.fact-qnty   no-undo.
     3935   define variable  coast_r#2     like ub.stk-line.sum-rubl    no-undo.
     3936   define variable  coast_v#2     like ub.stk-line.sum-rubl    no-undo.
     3937   define variable  vat_r#2       like ub.stk-line.sum-rubl    no-undo.
     3938   define variable  vat_v#2       like ub.stk-line.sum-rubl    no-undo.
     3939   define variable  slt_r#2       like ub.stk-line.sum-rubl    no-undo.
     3940   define variable  slt_v#2       like ub.stk-line.sum-rubl    no-undo.
     3941   define variable  other_r#2     like ub.stk-line.sum-rubl    no-undo.
     3942   define variable  other_v#2     like ub.stk-line.sum-rubl    no-undo.
     3943   run ost-lineother-tax  in this-procedure
     3944    (  input   l-store-code  ,
     3945       input   l-store-type  ,
     3946       input   l-artic       ,
     3947       input   l-prod-code   ,
     3948       input   l-prod-type   ,
     3949       input   l-tog-shift   ,
     3950       input   l-fact-order-1,
     3951       input   l-sum-type    ,
     3952       input   l-cat-id      ,
     3953       input   l-tog-obj     ,
     3954       output  quantity#1 ,
     3955       output  coast_r#1  ,
     3956       output  coast_v#1  ,
     3957       output  vat_r#1    ,
     3958       output  vat_v#1    ,
     3959       output  slt_r#1    ,
     3960       output  slt_v#1    ,
     3961       output  other_r#1  ,
     3962       output  other_v#1  ).
     3963   run ost-lineother-tax  in this-procedure
     3964    (  input   l-store-code  ,
     3965       input   l-store-type  ,
     3966       input   l-artic       ,
     3967       input   l-prod-code   ,
     3968       input   l-prod-type   ,
     3969       input   l-tog-shift   ,
     3970       input   l-fact-order-2,
     3971       input   l-sum-type    ,
     3972       input   l-cat-id      ,
     3973       input   l-tog-obj     ,
     3974       output  quantity#2 ,
     3975       output  coast_r#2  ,
     3976       output  coast_v#2  ,
     3977       output  vat_r#2    ,
     3978       output  vat_v#2    ,
     3979       output  slt_r#2    ,
     3980       output  slt_v#2    ,
     3981       output  other_r#2  ,
     3982       output  other_v#2  ).
     3983       assign
     3984         quantity =   quantity#2 -  quantity#1
     3985         coast_r  =   coast_r#2  -  coast_r#1
     3986         coast_v  =   coast_v#2  -  coast_v#1
     3987         vat_r    =   vat_r#2    -  vat_r#1
     3988         vat_v    =   vat_v#2    -  vat_v#1
     3989         slt_r    =   slt_r#2    -  slt_r#1
     3990         slt_v    =   slt_v#2    -  slt_v#1
     3991         other_r  =   other_r#2  -  other_r#1
     3992         other_v  =   other_v#2  -  other_v#1
     3993         .
     3994    end procedure.
