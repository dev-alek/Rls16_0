     3062           if  not (not show-negativ  and (
     3063                 b1-prih          [1]   = 0 and
     3064                 b1-rash          [1]   = 0 and
     3065                 b1-kassa         [1]   = 0 and
     3066                 b1-inv           [1]   = 0 and
     3067                 b1-gds-zap-other       = 0 and
     3068                 b1-overturn      [1]   = 0 and
     3069                 b1-overturn      [5]   = 0 and
     3070                 b1-ostatok-start [1]   = 0 and
     3071                 b1-ostatok-end   [1]   = 0   )) then do:
     3072                 if sums-only then do:
     3073                     if fr0 = true then do:
     3074                         put stream  outstream  tmp#stroka0 format "x(100)" skip.
     3075                         if Make-Excel then  put   stream ForExcel unformatted string(tmp#stroka0) skip.
     3076                         fr0 = false .
     3077                       end.
     3078                  end.
     3079           run di-qnty in this-procedure ("кол-во"  ,1, s-bar-code, gds-zap-artic, gds-zap-gds-name ,"","b1":u).
     3080           if xshowcost    then do: run di in this-procedure ("учет." ,2 ,"","", "", "", "b1":u).  end.
     3081           if xshowcrsa    then do: run di in this-procedure ("прод." , 5, "","", "", "", "b1":u).  end.
     3082           if xshowsale    then do: run di in this-procedure ("док." , 8, "","", "", "", "b1":u).  end.
     3083           if vat-cost    then do: run di in this-procedure ( "уч.НДС", 3,"","","","","b1":u ). end.
     3084           if vat-crsa    then do: run di in this-procedure ( "пр.НДС", 6,"","","","","b1":u ).  end.
     3085           if vat-sale    then do: run di in this-procedure ( "дк.НДС", 9,"","","","","b1":u ).  end.
     3086          if not sums-only then run p-line.
     3087    end.
     3088    end.
     3089   end procedure.
     3090   procedure display-b2  :
     3091        if not( not show-negativ-2 and
     3092            ( b2-prih         [1]   = 0 and
     3093              b2-rash          [1]   = 0 and
     3094              b2-kassa         [1]   = 0 and
     3095              b2-inv           [1]   = 0 and
     3096              b2-gds-zap-other       = 0 and
     3097              b2-overturn      [1]   = 0 and
     3098              b2-overturn      [5]   = 0 and
     3099              b2-overturn      [8]   = 0 ) ) then do:
     3100           if  not (not show-negativ  and (
     3101                 b2-prih          [1]   = 0 and
     3102                 b2-rash          [1]   = 0 and
     3103                 b2-kassa         [1]   = 0 and
     3104                 b2-inv           [1]   = 0 and
     3105                 b2-gds-zap-other       = 0 and
     3106                 b2-overturn      [1]   = 0 and
     3107                 b2-overturn      [5]   = 0 and
     3108                 b2-ostatok-start [1]   = 0 and
     3109                 b2-ostatok-end   [1]   = 0   )) then do:
     3110           run di-qnty( "кол-во", 1 ,s-bar-code,gds-zap-artic, gds-zap-gds-name,"", "b2":u).
     3111           if xshowcost    then do: run di in this-procedure ("учет.", 2, "","", "", "", "b2":u).  end.
     3112           if xshowcrsa    then do: run di in this-procedure ("прод.", 5 ,"","", "", "", "b2":u).  end.
     3113           if xshowsale    then do: run di in this-procedure ("док.", 8 ,"","", "", "", "b2":u).  end.
     3114            if vat-cost    then do: run di in this-procedure ( "уч.НДС", 3,"","","","","b2":u ). end.
     3115            if vat-crsa    then do: run di in this-procedure ( "пр.НДС", 6,"","","","","b2":u ).  end.
     3116            if vat-sale    then do: run di in this-procedure ( "дк.НДС", 9,"","","","","b2":u ).  end.
     3117            if not sums-only then run u-line.
     3118    end.
     3119   end.
     3120   end procedure.
     3121   procedure clear-b1  :
     3122    b1-gds-zap-other           = 0.
     3123    repeat kk = 1 to 9 :
     3124    assign
     3125       b1-prih                                            [kk]    = 0
     3126       b1-rash                                            [kk]    = 0
     3127       b1-kassa                                           [kk]    = 0
     3128       b1-inv                                             [kk]    = 0
     3129       b1-overturn                                        [kk]    = 0
     3130       b1-ostatok-end                                     [kk]    = 0
     3131       b1-ostatok-start                                   [kk]    = 0   .
     3132      end.
     3133    end procedure.
     3134   procedure clear-b2  :
     3135    b2-gds-zap-other           = 0.
     3136    repeat kk = 1 to 9 :
     3137    assign
     3138       b2-prih                                            [kk]    = 0
     3139       b2-rash                                            [kk]    = 0
     3140       b2-kassa                                           [kk]    = 0
     3141       b2-inv                                             [kk]    = 0
     3142       b2-overturn                                        [kk]    = 0
     3143       b2-ostatok-end                                     [kk]    = 0
     3144       b2-ostatok-start                                   [kk]    = 0   .
     3145      end.
     3146   end procedure.
     3147   procedure clear-bi  :
     3148    bi-gds-zap-other           = 0.
