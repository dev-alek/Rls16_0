     2990   procedure calcitog :
     2991       run ostatok  in this-procedure(
     2992           input x-store-code  ,
     2993           input x-store-type  ,x-tog-shift,
     2994           input x-date-start - 1 ,
     2995           input date('')      , x-shift-start,x-shift-end,
