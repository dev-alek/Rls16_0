     2997           input '##,##':U,
     2998           input xtog-obj ,
     2999           output  quantity1  ,
     3000           output  coast_r1   ,
     3001           output  coast_v1   ,
     3002           output  vat_r1     ,
     3003           output  vat_v1     ,
     3004           output  fact-order-1 ).
     3005       run ostatok  in this-procedure (
     3006           input x-store-code  ,
     3007           input x-store-type  , x-tog-shift,
     3008           input x-date-start  ,
     3009           input x-date-end    , x-shift-start,x-shift-end,
     3010           input 'crsa':U   ,
     3011           input '##,##':U,
     3012           input xtog-obj ,
     3013           output  quantity1  ,
     3014           output  coast_r1   ,
     3015           output  coast_v1   ,
     3016           output  vat_r1     ,
     3017           output  vat_v1     ,
     3018           output  fact-order-2 ).
     3019             quantity1  = 0.
     3020             coast_r1   = 0.
     3021             coast_v1   = 0.
     3022             vat_r1     = 0.
     3023             vat_v1     = 0.
     3024   end procedure.
