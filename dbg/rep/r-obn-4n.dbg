     2215                   output  vat_v       ,
     2216                   output  slt_r       ,
     2217                   output  slt_v       ).
     2218   assign
     2219     ostatok-end [1 + 6]   = quantity
     2220    ostatok-end [2 + 6]   = if tprintrubl then coast_r else coast_v
     2221    ostatok-end [3 + 6]   = if tprintrubl then vat_r   else vat_v
     2222    ostatok-end [10]        = if tprintrubl then slt_r   else slt_v
     2223    b1-ostatok-end [1 + 6] =  b1-ostatok-end [1 + 6] + ostatok-end [1 + 6]
