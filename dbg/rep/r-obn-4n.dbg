     3150    assign
     3151       bi-prih                                            [kk]    = 0
     3152       bi-rash                                            [kk]    = 0
     3153       bi-kassa                                           [kk]    = 0
     3154       bi-inv                                             [kk]    = 0
     3155       bi-overturn                                        [kk]    = 0
     3156       bi-ostatok-end                                     [kk]    = 0
     3157       bi-ostatok-start                                   [kk]    = 0   .
