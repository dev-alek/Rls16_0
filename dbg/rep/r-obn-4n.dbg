     2465                     Gds-zap-artic = "        Итого по "
     2466                     Gds-zap-gds-name =   B2-name
     2467                                   .
     2468               Run Display-b1 In This-procedure .
     2469               Run Clear-b1 In This-procedure .
     2470               Assign Break_Group = True.
     2471           End.
     2472           If Last-of((substring(clients.obj-name,1,10) + string(temp-gds-list.prod-code))) Then Do:
