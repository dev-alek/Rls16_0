     3160   procedure display-title :
     3161      PUT stream  OutStream  UNFORMATTED  string( v-cntxt-host-name-obj +  " , " + x-store-type  +  " " + objname) at 50 format "x(85)" skip(2)
     3162             reportname  at 20 format "x(170)" skip
     3163             trim(str1)  at 35 format "x(75)" skip.
     3164        repeat i = 1 to num-entries(str2,chr(10)) :
     3165         PUT stream  OutStream  UNFORMATTED  entry(i,str2,chr(10))  at 1 format "x(170)" skip.
     3166        end.
     3167       i=0.
     3168          PUT stream  OutStream  UNFORMATTED  trim(str3)  at 35 format "x(75)" skip.
     3169        repeat i = 1 to num-entries(str4,chr(10)) :
     3170         PUT stream  OutStream  UNFORMATTED  entry(i,str4,chr(10))  at 1 format "x(170)" skip.
     3171        end.
     3172       i=0.
     3173        repeat i = 1 to num-entries(reportheader,chr(10)) :
     3174         PUT stream  OutStream  UNFORMATTED  entry(i,reportheader,chr(10))  at 1 format "x(170)" skip.
     3175        end.
     3176       i=0.
     3177       run rep/extitle.p (1) .
     3178   end procedure.
     3179   procedure ob-line  :
     3180   define input  parameter x-store-code   like ub.clients.obj-code     no-undo.
     3181   define input  parameter x-store-type   like ub.clients.obj-type     no-undo.
     3182   define input  parameter x-artic        like ub.ot-line.artic        no-undo.
     3183   define input  parameter x-prod-code    like ub.ot-line.prod-code    no-undo.
     3184   define input  parameter x-prod-type    like ub.ot-line.prod-type    no-undo.
     3185   define input  parameter x-fact-order-1   like ub.ot-line.fact-order   no-undo.
     3186   define input  parameter x-fact-order-2   like ub.ot-line.fact-order   no-undo.
     3187   define input  parameter x-sum-type       like ub.ot-line.sum-type     no-undo.
     3188   define input  parameter x-cat-id         like ub.ot-line.cat-id       no-undo.
     3189   define input  parameter x-ext-doc-type   like ub.ot-line.ext-doc-type no-undo.
     3190   define input  parameter xtog-obj           as log no-undo.
     3191   define variable  tt#          as   int                 no-undo.
     3192   define variable  quantity#1    like ub.stk-line.fact-qnty   no-undo.
     3193   define variable  coast_r#1     like ub.stk-line.sum-rubl    no-undo.
     3194   define variable  coast_v#1     like ub.stk-line.sum-rubl    no-undo.
     3195   define variable  vat_r#1       like ub.stk-line.sum-rubl    no-undo.
     3196   define variable  vat_v#1       like ub.stk-line.sum-rubl    no-undo.
     3197   define variable  slt_r#1       like ub.stk-line.sum-rubl    no-undo.
     3198   define variable  slt_v#1       like ub.stk-line.sum-rubl    no-undo.
     3199   define variable  other_r#1     like ub.stk-line.sum-rubl    no-undo.
     3200   define variable  other_v#1     like ub.stk-line.sum-rubl    no-undo.
     3201   define variable  l-sum-type as character no-undo .
     3202   define variable  l-cat-id   as character no-undo .
     3203   define variable v-s# as character no-undo .
     3204    if (x-sum-type = 'sale':U ) then assign tt# = 6 v-s# = 'sadt':U .
     3205    if (x-sum-type = 'crsa':U ) then assign tt# = 3 v-s# = 'cgdt':U .
     3206    if (x-sum-type = 'cost':U ) then assign tt# = 0 v-s# = 'csdt':U .
     3207    if (x-sum-type = 'sasr':U) then assign tt# = 6 v-s# = 'adsr':U .
     3208    if (x-sum-type = 'cgsr':U) then assign tt# = 3 v-s# = 'gdsr':U .
     3209    if (x-sum-type = 'cssr':U) then assign tt# = 0 v-s# = 'sdsr':U .
     3210   define variable v-i as integer no-undo .
     3211   repeat v-i = 1 to  extent(m-prih) :
     3212    run oborot-stk in this-procedure (input  x-store-code , input  x-store-type , input  x-artic ,input  x-prod-code  ,input  x-prod-type  ,input  x-tog-shift  ,input  fact-order-1 ,input  fact-order-2 , input v-s# + m-prih[v-i] , input l-cat-id , input xtog-obj     ,    output quantity#1   ,    output coast_r#1    ,    output coast_v#1    ,    output vat_r#1      ,    output vat_v#1      ,    output slt_r#1      ,    output slt_v#1      ,    output other_r#1    ,    output other_v#1    ) .
     3213       assign prih[1 + tt#]   = prih[1 + tt#] + quantity#1
     3214              prih[2 + tt#]   = prih[2 + tt#] + if tprintrubl then coast_r#1 else coast_v#1
     3215              prih[3 + tt#]   = prih[3 + tt#] + if tprintrubl then vat_r#1   else vat_v#1 .
     3216       if tt# = 6 then gds-zap-other  = gds-zap-other + if tprintrubl then other_r#1  else other_v#1  .
     3217   end.
     3218   repeat v-i = 1 to  extent(m-rash) :
     3219    run oborot-stk in this-procedure (input  x-store-code , input  x-store-type , input  x-artic ,input  x-prod-code  ,input  x-prod-type  ,input  x-tog-shift  ,input  fact-order-1 ,input  fact-order-2 , input  v-s# + m-rash[v-i] , input l-cat-id , input xtog-obj     ,    output quantity#1   ,    output coast_r#1    ,    output coast_v#1    ,    output vat_r#1      ,    output vat_v#1      ,    output slt_r#1      ,    output slt_v#1      ,    output other_r#1    ,    output other_v#1    ) .
     3220       assign rash[1 + tt#]   = rash[1 + tt#] +  quantity#1
     3221              rash[2 + tt#]   = rash[2 + tt#] +  if tprintrubl then coast_r#1 else coast_v#1
     3222              rash[3 + tt#]   = rash[3 + tt#] +  if tprintrubl then vat_r#1   else vat_v#1 .
     3223       if tt# = 6 then gds-zap-other  = gds-zap-other + if tprintrubl then other_r#1  else other_v#1  .
     3224   end.
     3225   repeat v-i = 1 to  extent(m-kassa) :
     3226    run oborot-stk in this-procedure (input  x-store-code , input  x-store-type , input  x-artic ,input  x-prod-code  ,input  x-prod-type  ,input  x-tog-shift  ,input  fact-order-1 ,input  fact-order-2 , input  v-s# + m-kassa[v-i] , input l-cat-id , input xtog-obj     ,    output quantity#1   ,    output coast_r#1    ,    output coast_v#1    ,    output vat_r#1      ,    output vat_v#1      ,    output slt_r#1      ,    output slt_v#1      ,    output other_r#1    ,    output other_v#1    ) .
     3227       assign kassa[1 + tt#]   = kassa[1 + tt#] + quantity#1
     3228              kassa[2 + tt#]   = kassa[2 + tt#] + if tprintrubl then coast_r#1 else coast_v#1
     3229              kassa[3 + tt#]   = kassa[3 + tt#] + if tprintrubl then vat_r#1   else vat_v#1 .
     3230       if tt# = 6 then gds-zap-other  = gds-zap-other + if tprintrubl then other_r#1  else other_v#1  .
     3231    end.
     3232   repeat v-i = 1 to  extent(m-inv) :
     3233    run oborot-stk in this-procedure (input  x-store-code , input  x-store-type , input  x-artic ,input  x-prod-code  ,input  x-prod-type  ,input  x-tog-shift  ,input  fact-order-1 ,input  fact-order-2 , input  v-s# + m-inv[v-i] , input l-cat-id , input xtog-obj     ,    output quantity#1   ,    output coast_r#1    ,    output coast_v#1    ,    output vat_r#1      ,    output vat_v#1      ,    output slt_r#1      ,    output slt_v#1      ,    output other_r#1    ,    output other_v#1    ) .
     3234       assign inv[1 + tt#]   = inv[1 + tt#] + quantity#1
     3235              inv[2 + tt#]   = inv[2 + tt#] + if tprintrubl then coast_r#1 else coast_v#1
     3236              inv[3 + tt#]   = inv[3 + tt#] + if tprintrubl then vat_r#1   else vat_v#1 .
     3237       if tt# = 6 then gds-zap-other  = gds-zap-other + if tprintrubl then other_r#1  else other_v#1  .
     3238   end.
     3239   repeat v-i = 1 to  extent(m-overturn) :
     3240    run oborot-stk in this-procedure (input  x-store-code , input  x-store-type , input  x-artic ,input  x-prod-code  ,input  x-prod-type  ,input  x-tog-shift  ,input  fact-order-1 ,input  fact-order-2 , input  v-s# + m-overturn[v-i] , input l-cat-id , input xtog-obj     ,    output quantity#1   ,    output coast_r#1    ,    output coast_v#1    ,    output vat_r#1      ,    output vat_v#1      ,    output slt_r#1      ,    output slt_v#1      ,    output other_r#1    ,    output other_v#1    ) .
     3241       assign overturn[1 + tt#]   = overturn[1 + tt#] + quantity#1
     3242              overturn[2 + tt#]   = overturn[2 + tt#] + if tprintrubl then coast_r#1 else coast_v#1
     3243              overturn[3 + tt#]   = overturn[3 + tt#] + if tprintrubl then vat_r#1   else vat_v#1 .
     3244       if tt# = 6 then gds-zap-other  = gds-zap-other + if tprintrubl then other_r#1  else other_v#1  .
     3245   end.
     3246     if tt# = 6 then do:
     3247          if (x-sum-type = 'sasr':U) then do:
     3248              assign
     3249              prih[1 ]   = prih[7 ]
     3250              rash[1 ]   = rash[7 ]
     3251              kassa[1]   = kassa[7]
     3252              inv[1]     = inv[7  ]
     3253              .
     3254              end.
     3255              assign overturn[1 + tt#]   = (ostatok-end[1 + tt#]  - ostatok-start[1 + tt#] )  -  (inv[1 + tt#] + prih[1 + tt#]   +  kassa[1 + tt#]  +  rash[1 + tt#]  )
     3256                     overturn[2 + tt#]   = (ostatok-end[2 + tt#]  - ostatok-start[2 + tt#] )  -  (inv[2 + tt#] + prih[2 + tt#]   +  kassa[2 + tt#]  +  rash[2 + tt#]  +  gds-zap-other )
     3257                     overturn[3 + tt#]   = (ostatok-end[3 + tt#]  - ostatok-start[3 + tt#] )  -  (inv[3 + tt#] + prih[3 + tt#]   +  kassa[3 + tt#]  +  rash[3 + tt#]  )  .
     3258     end.
     3259   end procedure.
     3260   procedure report-exec1  :
     3261      find first clients where x-store-type = clients.obj-type and
     3262                               x-store-code = clients.obj-code no-lock no-error.
     3263   IF ( i modulo v-account = 0 )  then DO:
     3264    Assign
     3265       v-kol-spice = (50 - LENGTH(clients.obj-name)) / 2
     3266       RecordsString = fill(' ',v-kol-spice) + string(clients.obj-name)
     3267       .
     3268             if  log-manager:logfile-name ne ?
     3269             then DO:
     3270                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     3271             end.
     3272              if mFrameView
     3273              then do:
     3274               DISPLAY
     3275                 i @ RecordsDone
     3276                 RecordsString   @ RecordsString
     3277                 WITH FRAME InfoFrame.
     3278              end.
     3279   End.
     3280      if v-button-stop then  DO:
     3281            if mFrameView
     3282            then
     3283               PROCESS EVENTS.
     3284            IF StopProcessing THEN DO:
     3285            RETURN error.
     3286            End.
     3287      end.
     3288     run calcitog.
     3289     run print-header.
     3290      case retclassify :
     3291        when "prod/grp-goods":u then run run4.
     3292      end case.
     3293     run print-footer.
     3294     end procedure.
     3295   procedure calc-sub-itog :
     3296   define input parameter tt as int no-undo.
     3297   define variable b as int no-undo.
     3298   if tt = 6  then assign
     3299     b1-gds-zap-other = b1-gds-zap-other +  gds-zap-other
     3300     b2-gds-zap-other = b2-gds-zap-other +  gds-zap-other
     3301     bi-gds-zap-other = bi-gds-zap-other +  gds-zap-other
     3302     bo-gds-zap-other = bo-gds-zap-other +  gds-zap-other
     3303     .
     3304   repeat b = 1 to 3:
     3305     assign
     3306     b1-prih[b + tt]    = b1-prih[b + tt]    +  prih[b + tt]
     3307     b2-prih[b + tt]    = b2-prih[b + tt]    +  prih[b + tt]
     3308     bi-prih[b + tt]    = bi-prih[b + tt]    +  prih[b + tt]
     3309     bo-prih[b + tt]    = bo-prih[b + tt]    +  prih[b + tt]
     3310     bo-ostatok-start[b + tt]    = bo-ostatok-start[b + tt]    +  ostatok-start[b + tt]
     3311     bo-ostatok-end[b + tt]      = bo-ostatok-end[b + tt]      +  ostatok-end[b + tt]
     3312     b1-rash[b + tt]    = b1-rash[b + tt]    +  rash[b + tt]
     3313     b2-rash[b + tt]    = b2-rash[b + tt]    +  rash[b + tt]
     3314     bi-rash[b + tt]    = bi-rash[b + tt]    +  rash[b + tt]
     3315     bo-rash[b + tt]    = bo-rash[b + tt]    +  rash[b + tt]
     3316     b1-kassa[b + tt]    = b1-kassa[b + tt]    +  kassa[b + tt]
     3317     b2-kassa[b + tt]    = b2-kassa[b + tt]    +  kassa[b + tt]
     3318     bi-kassa[b + tt]    = bi-kassa[b + tt]    +  kassa[b + tt]
     3319     bo-kassa[b + tt]    = bo-kassa[b + tt]    +  kassa[b + tt]
     3320     b1-inv[b + tt]    = b1-inv[b + tt]    +  inv[b + tt]
     3321     b2-inv[b + tt]    = b2-inv[b + tt]    +  inv[b + tt]
     3322     bi-inv[b + tt]    = bi-inv[b + tt]    +  inv[b + tt]
     3323     bo-inv[b + tt]    = bo-inv[b + tt]    +  inv[b + tt]
     3324     b1-overturn[b + tt]    = b1-overturn[b + tt]    +  overturn[b + tt]
     3325     b2-overturn[b + tt]    = b2-overturn[b + tt]    +  overturn[b + tt]
     3326     bi-overturn[b + tt]    = bi-overturn[b + tt]    +  overturn[b + tt]
     3327     bo-overturn[b + tt]    = bo-overturn[b + tt]    +  overturn[b + tt] .
     3328   end.
     3329   end procedure.
     3330   procedure clear-item :
     3331   define variable kk as int no-undo.
     3332    gds-zap-other = 0 .
     3333    repeat kk = 1 to 9 :
     3334    assign
     3335       prih            [kk]    = 0
     3336       rash            [kk]    = 0
     3337       kassa           [kk]    = 0
     3338       inv             [kk]    = 0
     3339       overturn        [kk]    = 0
     3340       ostatok-end     [kk]    = 0
     3341       ostatok-start   [kk]    = 0 .
     3342          end.
     3343    end procedure.
     3344   procedure item-goods :
     3345      define input parameter  par-3 as char no-undo.
     3346      define input parameter  par-4 as char no-undo.
     3347        if par-4 = "goods":u  then do:
     3348           assign
     3349               gds-zap-unit-base  = goods.unit-base
     3350               gds-zap-prt-root   = goods.prt-root
     3351               gds-zap-prod-type  = goods.prod-type
     3352               gds-zap-prod-code  = goods.prod-code
     3353               gds-zap-artic      = goods.artic
     3354               gds-zap-grp-name   = goods.grp-name
     3355               gds-zap-b-code     = goods.gds-code
     3356               gds-zap-type       = goods.gds-type.
     3357           if g#gds-engl then
     3358               assign gds-zap-gds-name = goods.engl-name.
     3359           else
     3360               assign gds-zap-gds-name = goods.gds-name.
     3361        end.
     3362        if par-4 = "gds-list":u  then do:
     3363           assign
     3364               gds-zap-unit-base  = gds-list.unit-base
     3365               gds-zap-prt-root   = gds-list.prt-root
     3366               gds-zap-prod-type  = gds-list.prod-type
     3367               gds-zap-prod-code  = gds-list.prod-code
     3368               gds-zap-artic      = gds-list.artic
     3369               gds-zap-grp-name   = gds-list.grp-name
     3370               gds-zap-b-code     = gds-list.gds-code
     3371               gds-zap-type       = gds-list.gds-type.
     3372           if g#gds-engl then
     3373               assign gds-zap-gds-name = gds-list.engl-name.
     3374           else
     3375               assign gds-zap-gds-name = gds-list.gds-name.
     3376       end.
     3377       run foreach  in this-procedure.
     3378   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     3379     (input  gds-zap-b-code
     3380     ,input  ?
     3381     ,output v-bar-code
     3382     )  .
     3383   s-bar-code = string (v-bar-code,"999999999").
     3384       If  break_group = true  and par-3 <> "1"  then DO :
     3385            FIND FIRST clients WHERE clients.obj-type = gds-zap-prod-type AND clients.obj-code = gds-zap-prod-code use-index pi NO-LOCK .
     3386            gds-zap-prod-name  = clients.obj-name.
     3387             If break_group1 = true  THEN  DO :
     3388               if (par-3 = "3"  OR  par-3 = "5" ) and  par-3 <> "6"
     3389                 then DO: Assign temp-str = string("ГРУППА : " + gds-zap-grp-name )         b1-name = gds-zap-grp-name . end.
     3390                 else DO: Assign temp-str = string("ПРОИЗВОДИТЕЛЬ : " + gds-zap-prod-name ) b1-name = gds-zap-prod-name. end.
     3391               if par-3 = "6"  then  dO:
     3392                  if xTog-obj = true then do:
     3393                    var-vat-pc = func-vat (input gds-zap-b-code , input x-store-type, input x-store-code)
     3394                     .
     3395                   end.
     3396                  else do:
     3397                   var-vat-pc = temp-gds-list.vat-pc .
     3398                   end.
     3399                   assign
     3400                       temp-str = string( "СТАВКА НДС : " + string(var-vat-pc) + "%" )
     3401                       b1-name = temp-str.
     3402                   end.
     3403               if NOT xSumsOnly or (par-3 = "4" Or par-3 = "5" ) THEN DO :
     3404                   fr0 = true .
     3405                   tmp#stroka0 = temp-str.
     3406               End.
     3407             End.
     3408               IF (par-3 = "4"  OR  par-3 = "5")  THEN DO:
     3409                 if par-3 = "4"
     3410                   then Assign temp-str = string("ГРУППА : " + gds-zap-grp-name )          b2-name = gds-zap-grp-name .
     3411                   else Assign temp-str = string("ПРОИЗВОДИТЕЛЬ : " + gds-zap-prod-name )  b2-name = gds-zap-prod-name.
     3412                 if NOT xSumsOnly THEN DO:
     3413                     fr = true .
     3414                 End.
     3415                 break_group1 = false.
     3416               END.
     3417          break_group = false.
     3418       End.
     3419       run display-line  in this-procedure.
     3420    end procedure.
     3421   procedure di :
