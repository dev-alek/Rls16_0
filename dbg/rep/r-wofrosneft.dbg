      521   do on error undo, return error return-value :
      522   find first cl_tt-clcparts where recid(cl_tt-clcparts) = parrec-parts no-lock.
      523   for each bf_tt-allsum on error undo, return error return-value :
      524     delete bf_tt-allsum.
      525   end.
      526   assign
      527     price-rubl-with-tax-loccl = cl_tt-clcparts.price-rubl
      528     price-base-with-tax-loccl = cl_tt-clcparts.price-base
      529   .
      530   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      531   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      532     (output varinvprbcl
      533     )  .
      534     if cl_tt-clcparts.out-code = 'free-zone':U     or
      535        cl_tt-clcparts.out-code = 'out-zone':U   or
      536        cl_tt-clcparts.doc-type = 'акт':U then do:
      537       assign
      538         in-vatp-have-vat-sltcl = yes.
      539     end.
      540     else do:
      541       find first in-vatp_doc-attrcl no-lock
      542         where in-vatp_doc-attrcl.doc-code  = cl_tt-clcparts.out-code
      543           and in-vatp_doc-attrcl.attr-code = 'envd':U
      544         no-error .
      545       if not available in-vatp_doc-attrcl then do:
      546         assign
      547           in-vatp-have-vat-sltcl = yes.
      548       end.
      549       else do:
      550            in-vatp-have-vat-sltcl = no.
      551       end.
      552     end.
      553     assign
      554      price-cli-with-tax-loccl = cl_tt-clcparts.price-cli
      555      cli-base-ratecl          = cl_tt-clcparts.cli-base-rate.
      556     ASSIGN   road-tax-base-loccl  = (if cl_tt-clcparts.road-tax-base  = ? then 0 else cl_tt-clcparts.road-tax-base)
      557              road-tax-rubl-loccl  = (if cl_tt-clcparts.road-tax-rubl  = ? then 0 else cl_tt-clcparts.road-tax-rubl).
      558     ASSIGN  transport-base-loccl = (if cl_tt-clcparts.transport-base = ? then 0 else cl_tt-clcparts.transport-base)
      559             transport-rubl-loccl = (if cl_tt-clcparts.transport-rubl = ? then 0 else cl_tt-clcparts.transport-rubl)
      560             other-base-loccl     = (if cl_tt-clcparts.other-base     = ? then 0 else cl_tt-clcparts.other-base)
      561             other-rubl-loccl     = (if cl_tt-clcparts.other-rubl     = ? then 0 else cl_tt-clcparts.other-rubl)
      562             vat-pc-loccl         = (if cl_tt-clcparts.vat-pc         = ? then 0 else cl_tt-clcparts.vat-pc)
      563             slt-pc-loccl         = (if cl_tt-clcparts.slt-pc         = ? then 0 else cl_tt-clcparts.slt-pc).
      564             ASSIGN   slt-base-loccl    = (if in-vatp-have-vat-sltcl = no then 0 else (price-base-with-tax-loccl - ((if road-tax-base-loccl  = ? then 0 else road-tax-base-loccl) + (if transport-base-loccl = ? then 0 else transport-base-loccl) + (if other-base-loccl = ? then 0 else other-base-loccl)))                           * slt-pc-loccl / (100 + slt-pc-loccl))                        vat-base-loccl    = (if in-vatp-have-vat-sltcl = no then 0 else (price-base-with-tax-loccl - ((if road-tax-base-loccl  = ? then 0 else road-tax-base-loccl) + (if transport-base-loccl = ? then 0 else transport-base-loccl) + (if other-base-loccl = ? then 0 else other-base-loccl))) * (1 - slt-pc-loccl / (100 + slt-pc-loccl)) * vat-pc-loccl / (100 + vat-pc-loccl)).
      565       ASSIGN   slt-rubl-loccl    = (if in-vatp-have-vat-sltcl = no then 0 else (price-rubl-with-tax-loccl - ((if road-tax-rubl-loccl  = ? then 0 else road-tax-rubl-loccl) + (if transport-rubl-loccl = ? then 0 else transport-rubl-loccl) + (if other-rubl-loccl = ? then 0 else other-rubl-loccl)))                           * slt-pc-loccl / (100 + slt-pc-loccl))                        vat-rubl-loccl    = (if in-vatp-have-vat-sltcl = no then 0 else (price-rubl-with-tax-loccl - ((if road-tax-rubl-loccl  = ? then 0 else road-tax-rubl-loccl) + (if transport-rubl-loccl = ? then 0 else transport-rubl-loccl) + (if other-rubl-loccl = ? then 0 else other-rubl-loccl))) * (1 - slt-pc-loccl / (100 + slt-pc-loccl)) * vat-pc-loccl / (100 + vat-pc-loccl)).
      566     assign
      567       exch-rate-cli-loccl = (cl_tt-clcparts.price-rubl - transport-rubl-loccl - other-rubl-loccl - road-tax-rubl-loccl - (if cl_tt-clcparts.vat-type <> 'в т. ч.':U then vat-rubl-loccl else 0) - (if cl_tt-clcparts.slt-type <> 'в т. ч.':U then slt-rubl-loccl else 0)) / cl_tt-clcparts.price-cli .
      568     assign
      569       slt-cli-loccl        = slt-rubl-loccl       / exch-rate-cli-loccl
      570       vat-cli-loccl        = vat-rubl-loccl       / exch-rate-cli-loccl
      571       road-tax-cli-loccl   = road-tax-rubl-loccl  / exch-rate-cli-loccl
      572       transport-cli-loccl  = 0
      573       other-cli-loccl      = 0
      574     .
      575   ASSIGN
      576             price-base-without-tax-loccl = price-base-with-tax-loccl - vat-base-loccl - slt-base-loccl - ((if road-tax-base-loccl  = ? then 0 else road-tax-base-loccl) + (if transport-base-loccl = ? then 0 else transport-base-loccl) + (if other-base-loccl = ? then 0 else other-base-loccl))
      577       price-rubl-without-tax-loccl = price-rubl-with-tax-loccl - vat-rubl-loccl - slt-rubl-loccl - ((if road-tax-rubl-loccl  = ? then 0 else road-tax-rubl-loccl) + (if transport-rubl-loccl = ? then 0 else transport-rubl-loccl) + (if other-rubl-loccl = ? then 0 else other-rubl-loccl))
      578   .
      579   if paris-doc then do:
      580     assign
      581       parartic     = cl_tt-clcparts.artic
      582       parprod-type = cl_tt-clcparts.prod-type
      583       parprod-code = cl_tt-clcparts.prod-code
      584       pardoc-type  = cl_tt-clcparts.doc-type
      585       pardoc-code  = cl_tt-clcparts.out-code
      586       parobj-type  = cl_tt-clcparts.obj-type
      587       parobj-code  = cl_tt-clcparts.obj-code.
      588   if parext-doc-type = 'ot':U or
      589      parext-doc-type = ?                 then do:
      590     assign
      591      out-vatp-have-vat-sltcl = yes.
      592   end.
      593   else do:
      594     find first out-vatp_doc-attrcl no-lock
      595       where out-vatp_doc-attrcl.doc-code  = pardoc-code
      596         and out-vatp_doc-attrcl.attr-code = 'envd':U
      597         no-error .
      598     if not available out-vatp_doc-attrcl then do:
      599       assign
      600         out-vatp-have-vat-sltcl = yes.
      601     end.
      602     else do:
      603        out-vatp-have-vat-sltcl = no.
      604     end.
      605   end.
      606   find first out-vatp_goodscl where out-vatp_goodscl.artic     = parartic     and
      607                                      out-vatp_goodscl.prod-type = parprod-type and
      608                                      out-vatp_goodscl.prod-code = parprod-code no-lock.
      609   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      610   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rootnode in g#library
      611     (input  parartic
      612     ,input  parprod-type
      613     ,input  parprod-code
      614     ,output varroot-nodecl
      615     ) no-error .
      616   if error-status :error then do:
      617     message
      618       vss-workfile vss-revision vss-description skip
      619       "Ошибка при определении корневого признака товара" skip
      620       "Артикул" parartic parprod-type parprod-code skip
      621       error-status :get-message(1) skip
      622       return-value skip
      623       view-as alert-box error .
      624     undo, return error .
      625   end.
      626   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prtat in g#library
      627     (input  varroot-nodecl
      628     ,input  'empty-scale=request'
      629     ,output varempty-scalecl
      630     ) no-error .
      631   if error-status :error then do:
      632     message
      633       vss-workfile vss-revision vss-description skip
      634       "Ошибка при определении атрибута признака" skip
      635       "Артикул" parartic parprod-type parprod-code skip
      636       "Признак" varroot-nodecl skip
      637       "Запрашивался атрибут" "empty-scale=request" skip
      638       error-status :get-message(1) skip
      639       return-value skip
      640       view-as alert-box error .
      641     undo, return error .
      642   end.
