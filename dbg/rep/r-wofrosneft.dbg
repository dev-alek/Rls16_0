     1477       bfacc_tt-allsum.slt-rubl-acc        = bf_tt-allsum.slt-rubl-acc
     1478       bfacc_tt-allsum.slt-cli-acc         = bf_tt-allsum.slt-cli-acc
     1479       bfacc_tt-allsum.excise-base-acc     = bf_tt-allsum.excise-base-acc
     1480       bfacc_tt-allsum.excise-rubl-acc     = bf_tt-allsum.excise-rubl-acc
     1481       bfacc_tt-allsum.excise-cli-acc      = bf_tt-allsum.excise-cli-acc
     1482       bfacc_tt-allsum.road-tax-base-acc   = bf_tt-allsum.road-tax-base-acc
     1483       bfacc_tt-allsum.road-tax-rubl-acc   = bf_tt-allsum.road-tax-rubl-acc
     1484       bfacc_tt-allsum.road-tax-cli-acc    = bf_tt-allsum.road-tax-cli-acc
     1485       bfacc_tt-allsum.transport-base-acc  = bf_tt-allsum.transport-base-acc
     1486       bfacc_tt-allsum.transport-rubl-acc  = bf_tt-allsum.transport-rubl-acc
     1487       bfacc_tt-allsum.transport-cli-acc   = bf_tt-allsum.transport-cli-acc
     1488       bfacc_tt-allsum.other-base-acc      = bf_tt-allsum.other-base-acc
     1489       bfacc_tt-allsum.other-rubl-acc      = bf_tt-allsum.other-rubl-acc
     1490       bfacc_tt-allsum.other-cli-acc       = bf_tt-allsum.other-cli-acc
     1491       .
     1492     assign
     1493       bfsacc_tt-allsum.fact-qnty           = bfs_tt-allsum.fact-qnty
     1494       bfsacc_tt-allsum.cli-qnty            = bfs_tt-allsum.cli-qnty
     1495       bfsacc_tt-allsum.sum-dsc-base-doc    = bfs_tt-allsum.sum-dsc-base-acc
     1496       bfsacc_tt-allsum.sum-dsc-rubl-doc    = bfs_tt-allsum.sum-dsc-rubl-acc
     1497       bfsacc_tt-allsum.dsc-base-doc        = bfs_tt-allsum.dsc-base-acc
     1498       bfsacc_tt-allsum.dsc-rubl-doc        = bfs_tt-allsum.dsc-rubl-acc
     1499       bfsacc_tt-allsum.vat-base-doc        = 0
     1500       bfsacc_tt-allsum.vat-rubl-doc        = 0
     1501       bfsacc_tt-allsum.vat-base-buyer-doc  = bfs_tt-allsum.vat-base-acc
     1502       bfsacc_tt-allsum.vat-rubl-buyer-doc  = bfs_tt-allsum.vat-rubl-acc
     1503       bfsacc_tt-allsum.slt-base-doc        = bfs_tt-allsum.slt-base-acc
     1504       bfsacc_tt-allsum.slt-rubl-doc        = bfs_tt-allsum.slt-rubl-acc
     1505       bfsacc_tt-allsum.road-tax-base-doc   = bfs_tt-allsum.road-tax-base-acc
     1506       bfsacc_tt-allsum.road-tax-rubl-doc   = bfs_tt-allsum.road-tax-rubl-acc
     1507       bfsacc_tt-allsum.excise-base-doc     = bfs_tt-allsum.excise-base-acc
     1508       bfsacc_tt-allsum.excise-rubl-doc     = bfs_tt-allsum.excise-rubl-acc
     1509       bfsacc_tt-allsum.sum-dsc-base-cur    = bfs_tt-allsum.sum-dsc-base-acc
     1510       bfsacc_tt-allsum.sum-dsc-rubl-cur    = bfs_tt-allsum.sum-dsc-rubl-acc
     1511       bfsacc_tt-allsum.dsc-base-cur        = bfs_tt-allsum.dsc-base-acc
     1512       bfsacc_tt-allsum.dsc-rubl-cur        = bfs_tt-allsum.dsc-rubl-acc
     1513       bfsacc_tt-allsum.vat-base-cur        = 0
     1514       bfsacc_tt-allsum.vat-rubl-cur        = 0
     1515       bfsacc_tt-allsum.vat-base-buyer-cur  = bfs_tt-allsum.vat-base-acc
     1516       bfsacc_tt-allsum.vat-rubl-buyer-cur  = bfs_tt-allsum.vat-rubl-acc
     1517       bfsacc_tt-allsum.slt-base-cur        = bfs_tt-allsum.slt-base-acc
     1518       bfsacc_tt-allsum.slt-rubl-cur        = bfs_tt-allsum.slt-rubl-acc
     1519       bfsacc_tt-allsum.road-tax-base-cur   = bfs_tt-allsum.road-tax-base-acc
     1520       bfsacc_tt-allsum.road-tax-rubl-cur   = bfs_tt-allsum.road-tax-rubl-acc
     1521       bfsacc_tt-allsum.excise-base-cur     = bfs_tt-allsum.excise-base-acc
     1522       bfsacc_tt-allsum.excise-rubl-cur     = bfs_tt-allsum.excise-rubl-acc
     1523       bfsacc_tt-allsum.sum-dsc-base-acc    = bfs_tt-allsum.sum-dsc-base-acc
     1524       bfsacc_tt-allsum.sum-dsc-rubl-acc    = bfs_tt-allsum.sum-dsc-rubl-acc
     1525       bfsacc_tt-allsum.sum-dsc-cli-acc     = bfs_tt-allsum.sum-dsc-cli-acc
     1526       bfsacc_tt-allsum.dsc-base-acc        = bfs_tt-allsum.dsc-base-acc
     1527       bfsacc_tt-allsum.dsc-rubl-acc        = bfs_tt-allsum.dsc-rubl-acc
     1528       bfsacc_tt-allsum.dsc-cli-acc         = bfs_tt-allsum.dsc-cli-acc
     1529       bfsacc_tt-allsum.vat-base-acc        = bfs_tt-allsum.vat-base-acc
     1530       bfsacc_tt-allsum.vat-rubl-acc        = bfs_tt-allsum.vat-rubl-acc
     1531       bfsacc_tt-allsum.vat-cli-acc         = bfs_tt-allsum.vat-cli-acc
     1532       bfsacc_tt-allsum.slt-base-acc        = bfs_tt-allsum.slt-base-acc
     1533       bfsacc_tt-allsum.slt-rubl-acc        = bfs_tt-allsum.slt-rubl-acc
     1534       bfsacc_tt-allsum.slt-cli-acc         = bfs_tt-allsum.slt-cli-acc
     1535       bfsacc_tt-allsum.excise-base-acc     = bfs_tt-allsum.excise-base-acc
     1536       bfsacc_tt-allsum.excise-rubl-acc     = bfs_tt-allsum.excise-rubl-acc
     1537       bfsacc_tt-allsum.excise-cli-acc      = bfs_tt-allsum.excise-cli-acc
     1538       bfsacc_tt-allsum.road-tax-base-acc   = bfs_tt-allsum.road-tax-base-acc
     1539       bfsacc_tt-allsum.road-tax-rubl-acc   = bfs_tt-allsum.road-tax-rubl-acc
     1540       bfsacc_tt-allsum.road-tax-cli-acc    = bfs_tt-allsum.road-tax-cli-acc
     1541       bfsacc_tt-allsum.transport-base-acc  = bfs_tt-allsum.transport-base-acc
     1542       bfsacc_tt-allsum.transport-rubl-acc  = bfs_tt-allsum.transport-rubl-acc
     1543       bfsacc_tt-allsum.transport-cli-acc   = bfs_tt-allsum.transport-cli-acc
     1544       bfsacc_tt-allsum.other-base-acc      = bfs_tt-allsum.other-base-acc
     1545       bfsacc_tt-allsum.other-rubl-acc      = bfs_tt-allsum.other-rubl-acc
     1546       bfsacc_tt-allsum.other-cli-acc       = bfs_tt-allsum.other-cli-acc
     1547       .
     1548   end.
     1549   otherwise do:
     1550     return error substitute ("Неизвестный тип приобретения &1 по партии с кодом &2 по документу &3, порожденную документом &4 по товару &5 &6 &7.",
     1551                              cl_tt-clcparts.purch-code,
     1552                              cl_tt-clcparts.part-code,
     1553                              cl_tt-clcparts.out-code,
     1554                              cl_tt-clcparts.in-code,
     1555                              cl_tt-clcparts.artic,
     1556                              cl_tt-clcparts.prod-type,
     1557                              cl_tt-clcparts.prod-code).
     1558   end.
     1559   end case.
     1560   end.
     1561   end procedure.
     1562   procedure clcprtsl_calc-line :
     1563   define input  parameter parrec-line as recid no-undo.
     1564   define variable v-tax-date         as   date                     no-undo.
     1565   define variable v-vat-pc           like ub.doc-line.vat-pc       no-undo.
     1566   define variable varr-b             as   character                no-undo.
     1567   define variable varr-btype         as   character                no-undo.
     1568   define variable varcur-base        like ub.gds-dtl.price-base    no-undo.
     1569   define variable varcur-road-tax    like ub.doc-line.road-tax     no-undo.
     1570   define variable varcur-excise      like ub.doc-line.excise       no-undo.
     1571   define variable varcur-vat-pc      like ub.doc-line.vat-pc       no-undo.
     1572   define variable varcur-cons-vat-pc like ub.doc-line.cons-vat-pc  no-undo.
     1573   define variable varcur-slt-pc      like ub.doc-line.slt-pc       no-undo.
     1574   define variable varcur-fact-qnty   like ub.gds-dtl.fact-qnty     no-undo.
     1575   define variable varb-code          like ub.bar-code.b-code       no-undo.
     1576   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     1577   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     1578   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     1579   define variable varexcise          like ub.price-list.excise     no-undo.
     1580   define variable varlastcur-base        like ub.gds-dtl.price-base no-undo.
     1581   define variable varlastcur-road-tax    like ub.gds-dtl.price-base no-undo.
     1582   define variable varlastcur-excise      like ub.gds-dtl.price-base     no-undo.
     1583   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     1584   define variable v-varsum           as decimal                  no-undo.
     1585   define variable varprice-salef as decimal   no-undo .
     1586   define buffer bf_trn-doc             for ub.trn-doc.
     1587   define buffer bf_doc-line            for ub.doc-line.
     1588   define buffer bf_gds-dtl             for ub.gds-dtl.
     1589   define buffer bf_goods               for ub.goods.
     1590   define buffer bf_parts               for ub.parts.
     1591   define buffer bf_sysconf             for ub.sysconf.
     1592   define buffer bf_tt-allsum-line      for tt-allsum-line.
     1593   define buffer bfs_tt-allsum-line     for tt-allsum-line.
     1594   define buffer bfo_tt-allsum-line     for tt-allsum-line.
     1595   define buffer bfos_tt-allsum-line    for tt-allsum-line.
     1596   define buffer buf_parts        for ub.parts.
     1597   v-calcbypart = no.
     1598   do on error undo, return error return-value :
     1599   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1600   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1601     (output varr-b
     1602     )  .
     1603     find first bf_doc-line where recid (bf_doc-line) = parrec-line no-lock.
     1604     find first bf_trn-doc where bf_trn-doc.doc-code = bf_doc-line.doc-code no-lock.
     1605     find first bf_goods where bf_goods.artic     = bf_doc-line.artic     and
     1606                               bf_goods.prod-type = bf_doc-line.prod-type and
     1607                               bf_goods.prod-code = bf_doc-line.prod-code no-lock.
     1608     if bf_trn-doc.fact-date <> ?        then do:
     1609       assign v-tax-date = bf_trn-doc.fact-date.
     1610     end.
     1611     else do:
     1612       assign v-tax-date = ?.
     1613     end.
     1614   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1615   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     1616     (input  bf_goods.gds-code
     1617     ,input  '1':U
     1618     ,input  v-tax-date
     1619     ,input  bf_trn-doc.host-code
     1620     ,input  bf_trn-doc.obj-type
     1621     ,input  bf_trn-doc.obj-code
     1622     ,output v-vat-pc
     1623     ) no-error .
     1624     if error-status :error
     1625     or v-vat-pc = ? then do:
     1626        return error substitute ("Ошибка при поиске НДС для товара &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     1627     end.
     1628     if bf_goods.gds-type = 'у':U or
     1629        bf_trn-doc.status_ = 'запрос':U then do:
     1630       for each bf_tt-allsum-line
     1631       on error undo, return error return-value
     1632        :
     1633         delete bf_tt-allsum-line.
     1634       end.
     1635       create bf_tt-allsum-line.
     1636       assign
     1637        bf_tt-allsum-line.sum-type = 'основная_сумма':U.
     1638       for each bf_gds-dtl where bf_gds-dtl.doc-code  = bf_doc-line.doc-code  and
     1639                                 bf_gds-dtl.artic     = bf_doc-line.artic     and
     1640                                 bf_gds-dtl.prod-type = bf_doc-line.prod-type and
     1641                                 bf_gds-dtl.prod-code = bf_doc-line.prod-code no-lock on error undo, return error return-value :
     1642         assign
     1643           bf_tt-allsum-line.fact-qnty            =  bf_tt-allsum-line.fact-qnty        + bf_gds-dtl.fact-qnty
     1644           bf_tt-allsum-line.sum-dsc-base-doc     =  bf_tt-allsum-line.sum-dsc-base-doc + (bf_gds-dtl.price-base - bf_gds-dtl.discnt-base) * bf_gds-dtl.fact-qnty
     1645           bf_tt-allsum-line.sum-dsc-rubl-doc     =  bf_tt-allsum-line.sum-dsc-rubl-doc + (bf_gds-dtl.price-rubl - bf_gds-dtl.discnt-rubl) * bf_gds-dtl.fact-qnty
     1646           bf_tt-allsum-line.dsc-base-doc         =  bf_tt-allsum-line.dsc-base-doc     + bf_gds-dtl.discnt-base * bf_gds-dtl.fact-qnty
     1647           bf_tt-allsum-line.dsc-rubl-doc         =  bf_tt-allsum-line.dsc-rubl-doc     + bf_gds-dtl.discnt-rubl * bf_gds-dtl.fact-qnty
     1648           bf_tt-allsum-line.sum-dsc-base-cur     =  bf_tt-allsum-line.sum-dsc-base-cur + (if varr-b = "base" then bf_gds-dtl.cur-base else bf_gds-dtl.cur-base / bf_trn-doc.exch-rate * bf_trn-doc.exch-scale) * bf_gds-dtl.fact-qnty
     1649           bf_tt-allsum-line.sum-dsc-rubl-cur     =  bf_tt-allsum-line.sum-dsc-rubl-cur + (if varr-b = "rubl" then bf_gds-dtl.cur-base else bf_gds-dtl.cur-base * bf_trn-doc.exch-rate / bf_trn-doc.exch-scale) * bf_gds-dtl.fact-qnty
     1650           bf_tt-allsum-line.sum-dsc-base-acc     =  bf_tt-allsum-line.sum-dsc-base-acc + bf_doc-line.price-base * bf_gds-dtl.fact-qnty
     1651           bf_tt-allsum-line.sum-dsc-rubl-acc     =  bf_tt-allsum-line.sum-dsc-rubl-acc + bf_doc-line.price-rubl * bf_gds-dtl.fact-qnty
     1652           bf_tt-allsum-line.sum-dsc-cli-acc      =  ?
     1653           bf_tt-allsum-line.vat-base-acc         =  bf_tt-allsum-line.vat-base-acc     + bf_doc-line.price-base * v-vat-pc / (100 + v-vat-pc) * bf_gds-dtl.fact-qnty
     1654           bf_tt-allsum-line.vat-rubl-acc         =  bf_tt-allsum-line.vat-rubl-acc     + bf_doc-line.price-rubl * v-vat-pc / (100 + v-vat-pc) * bf_gds-dtl.fact-qnty
     1655           bf_tt-allsum-line.vat-cli-acc          =  ?
     1656           .
     1657       end.
     1658       assign
     1659         bf_tt-allsum-line.cli-qnty             =  ?
     1660         bf_tt-allsum-line.slt-base-doc         =  bf_tt-allsum-line.sum-dsc-base-doc * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     1661         bf_tt-allsum-line.slt-rubl-doc         =  bf_tt-allsum-line.sum-dsc-rubl-doc * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     1662         bf_tt-allsum-line.vat-base-buyer-doc   =  (bf_tt-allsum-line.sum-dsc-base-doc - bf_tt-allsum-line.slt-base-doc) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     1663         bf_tt-allsum-line.vat-rubl-buyer-doc   =  (bf_tt-allsum-line.sum-dsc-rubl-doc - bf_tt-allsum-line.slt-rubl-doc) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     1664         bf_tt-allsum-line.road-tax-base-doc    =  0
     1665         bf_tt-allsum-line.road-tax-rubl-doc    =  0
     1666         bf_tt-allsum-line.excise-base-doc      =  0
     1667         bf_tt-allsum-line.excise-rubl-doc      =  0
     1668         bf_tt-allsum-line.vat-base-doc         =  bf_tt-allsum-line.vat-base-buyer-doc
     1669         bf_tt-allsum-line.vat-rubl-doc         =  bf_tt-allsum-line.vat-rubl-buyer-doc
     1670         bf_tt-allsum-line.dsc-base-cur         =  0
     1671         bf_tt-allsum-line.dsc-rubl-cur         =  0
     1672         bf_tt-allsum-line.slt-base-cur         =  bf_tt-allsum-line.sum-dsc-base-cur * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     1673         bf_tt-allsum-line.slt-rubl-cur         =  bf_tt-allsum-line.sum-dsc-rubl-cur * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     1674         bf_tt-allsum-line.vat-base-buyer-cur   =  (bf_tt-allsum-line.sum-dsc-base-cur - bf_tt-allsum-line.slt-base-cur) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     1675         bf_tt-allsum-line.vat-rubl-buyer-cur   =  (bf_tt-allsum-line.sum-dsc-rubl-cur - bf_tt-allsum-line.slt-rubl-cur) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     1676         bf_tt-allsum-line.road-tax-base-cur    =  0
     1677         bf_tt-allsum-line.road-tax-rubl-cur    =  0
     1678         bf_tt-allsum-line.excise-base-cur      =  0
     1679         bf_tt-allsum-line.excise-rubl-cur      =  0
     1680         bf_tt-allsum-line.vat-base-cur         =  bf_tt-allsum-line.vat-base-buyer-cur
     1681         bf_tt-allsum-line.vat-rubl-cur         =  bf_tt-allsum-line.vat-rubl-buyer-cur
     1682         bf_tt-allsum-line.dsc-base-acc         =  0
     1683         bf_tt-allsum-line.dsc-rubl-acc         =  0
     1684         bf_tt-allsum-line.dsc-cli-acc          =  0
     1685         bf_tt-allsum-line.slt-base-acc         =  0
     1686         bf_tt-allsum-line.slt-rubl-acc         =  0
     1687         bf_tt-allsum-line.slt-cli-acc          =  0
     1688         bf_tt-allsum-line.road-tax-base-acc    =  0
     1689         bf_tt-allsum-line.road-tax-rubl-acc    =  0
     1690         bf_tt-allsum-line.road-tax-cli-acc     =  0
     1691         bf_tt-allsum-line.excise-base-acc      =  0
