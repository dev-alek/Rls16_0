     1866               .
     1867             end.
     1868             assign
     1869               varlastcur-base     = varprice-sale
     1870               varlastcur-road-tax = varroad-tax
     1871               varlastcur-excise   = varexcise
     1872               varcur-base         = varcur-base      + varprice-sale * bf_gds-dtl.fact-qnty
     1873               varcur-road-tax     = varcur-road-tax  + varroad-tax   * bf_gds-dtl.fact-qnty
     1874               varcur-excise       = varcur-excise    + varexcise     * bf_gds-dtl.fact-qnty
     1875               varcur-fact-qnty    = varcur-fact-qnty + bf_gds-dtl.fact-qnty
     1876             .
     1877         end.
     1878       end.
     1879       if varcur-fact-qnty = 0 then do:
     1880         assign
     1881           varcur-base      = varlastcur-base
     1882           varcur-road-tax  = varlastcur-road-tax
     1883           varcur-excise    = varlastcur-excise
     1884         .
     1885       end.
     1886       else do:
     1887         assign
     1888           varcur-base      = varcur-base      / varcur-fact-qnty
     1889           varcur-road-tax  = varcur-road-tax  / varcur-fact-qnty
     1890           varcur-excise    = varcur-excise    / varcur-fact-qnty
     1891         .
     1892       end.
     1893       if varcur-vat-pc = ?
