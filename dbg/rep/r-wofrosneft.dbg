     1989   procedure clcprtsl_calc-ttable :
     1990   define input parameter paris-doc           as   logical                 no-undo.
     1991   define input parameter paris-cur           as   logical                 no-undo.
     1992   define input parameter parroad-tax         like ub.doc-line.road-tax    no-undo.
     1993   define input parameter parexcise           like ub.doc-line.excise      no-undo.
     1994   define input parameter parvat-pc           like ub.doc-line.vat-pc      no-undo.
     1995   define input parameter parcons-vat-pc      like ub.doc-line.cons-vat-pc no-undo.
     1996   define input parameter parslt-pc           like ub.doc-line.slt-pc      no-undo.
     1997   define input parameter parbase-rate        like ub.trn-doc.base-rate    no-undo.
     1998   define input parameter parbase-scale       like ub.trn-doc.base-scale   no-undo.
     1999   define input parameter parr-b              as   character               no-undo.
     2000   define input parameter parcur-base         like ub.gds-dtl.cur-base     no-undo.
     2001   define input parameter parcur-road-tax     like ub.doc-line.road-tax    no-undo.
     2002   define input parameter parcur-excise       like ub.doc-line.excise      no-undo.
     2003   define input parameter parcur-vat-pc       like ub.doc-line.vat-pc      no-undo.
     2004   define input parameter parcurcons-vat-pc   like ub.doc-line.cons-vat-pc no-undo.
     2005   define input parameter parcurslt-pc        like ub.doc-line.slt-pc      no-undo.
     2006   define buffer bf_tt-allsum      for tt-allsum.
     2007   define buffer bf_tt-clcparts    for tt-clcparts.
     2008   define buffer bf_tt-allsum-line for tt-allsum-line.
     2009   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     2010   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     2011   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     2012   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     2013   define variable varexcise          like ub.price-list.excise     no-undo.
     2014   do on error undo, return error return-value :
     2015   for each bf_tt-allsum-line
     2016   on error undo, return error return-value
     2017    :
     2018     delete bf_tt-allsum-line.
     2019   end.
     2020   for each bf_tt-allsum
     2021   on error undo, return error return-value
     2022   :
     2023     delete bf_tt-allsum.
     2024   end.
     2025   for each bf_tt-clcparts
     2026   on error undo, return error return-value
     2027   :
     2028   if v-calcbypart then do:
     2029             assign
     2030             parcur-base =   bf_tt-clcparts.part-cur-base
     2031             parcur-road-tax = bf_tt-clcparts.part-cur-road-tax
     2032             parcur-excise =   bf_tt-clcparts.part-cur-excise
     2033             .
     2034   end.
     2035      run clcprtsl_calc-parts in this-procedure (
     2036        input recid(bf_tt-clcparts),
     2037        input paris-doc,
     2038        input paris-cur,
     2039        input parroad-tax,
     2040        input parexcise,
     2041        input parvat-pc,
     2042        input parcons-vat-pc,
     2043        input parslt-pc,
     2044        input parbase-rate,
     2045        input parbase-scale,
     2046        input parr-b,
     2047        input parcur-base,
     2048        input parcur-road-tax,
     2049        input parcur-excise,
     2050        input parcur-vat-pc,
     2051        input parcurcons-vat-pc,
     2052        input parcurslt-pc
     2053        ) no-error.
     2054     if error-status:error then do:
     2055       message
     2056         vss-workfile vss-revision vss-description skip
     2057         vss-include-info2 skip
     2058         "Ошибка при обсчете партии" skip
     2059         "Документ партии " bf_tt-clcparts.out-code skip
     2060         "Товар" bf_tt-clcparts.artic bf_tt-clcparts.prod-type bf_tt-clcparts.prod-code skip
     2061         return-value skip
     2062         error-status:get-message(1) skip
     2063         error-status:get-message(2) skip
     2064         error-status:get-message(3) skip
     2065         view-as alert-box error .
     2066       undo, return error .
     2067     end.
     2068     for each bf_tt-allsum on error undo, return error return-value :
     2069       find first bf_tt-allsum-line where bf_tt-allsum-line.sum-type = bf_tt-allsum.sum-type no-error.
     2070       if not available bf_tt-allsum-line then do:
     2071         create bf_tt-allsum-line.
     2072         assign
     2073           bf_tt-allsum-line.sum-type = bf_tt-allsum.sum-type.
     2074       end.
     2075       assign
     2076         bf_tt-allsum-line.fact-qnty              = bf_tt-allsum-line.fact-qnty            + bf_tt-allsum.fact-qnty
     2077         bf_tt-allsum-line.cli-qnty               = bf_tt-allsum-line.cli-qnty             + bf_tt-allsum.cli-qnty
     2078         bf_tt-allsum-line.sum-dsc-base-doc       = bf_tt-allsum-line.sum-dsc-base-doc     + bf_tt-allsum.sum-dsc-base-doc
     2079         bf_tt-allsum-line.sum-dsc-rubl-doc       = bf_tt-allsum-line.sum-dsc-rubl-doc     + bf_tt-allsum.sum-dsc-rubl-doc
     2080         bf_tt-allsum-line.dsc-base-doc           = bf_tt-allsum-line.dsc-base-doc         + bf_tt-allsum.dsc-base-doc
     2081         bf_tt-allsum-line.dsc-rubl-doc           = bf_tt-allsum-line.dsc-rubl-doc         + bf_tt-allsum.dsc-rubl-doc
     2082         bf_tt-allsum-line.vat-base-doc           = bf_tt-allsum-line.vat-base-doc         + bf_tt-allsum.vat-base-doc
     2083         bf_tt-allsum-line.vat-rubl-doc           = bf_tt-allsum-line.vat-rubl-doc         + bf_tt-allsum.vat-rubl-doc
     2084         bf_tt-allsum-line.vat-base-buyer-doc     = bf_tt-allsum-line.vat-base-buyer-doc   + bf_tt-allsum.vat-base-buyer-doc
     2085         bf_tt-allsum-line.vat-rubl-buyer-doc     = bf_tt-allsum-line.vat-rubl-buyer-doc   + bf_tt-allsum.vat-rubl-buyer-doc
     2086         bf_tt-allsum-line.slt-base-doc           = bf_tt-allsum-line.slt-base-doc         + bf_tt-allsum.slt-base-doc
     2087         bf_tt-allsum-line.slt-rubl-doc           = bf_tt-allsum-line.slt-rubl-doc         + bf_tt-allsum.slt-rubl-doc
     2088         bf_tt-allsum-line.road-tax-base-doc      = bf_tt-allsum-line.road-tax-base-doc    + bf_tt-allsum.road-tax-base-doc
     2089         bf_tt-allsum-line.road-tax-rubl-doc      = bf_tt-allsum-line.road-tax-rubl-doc    + bf_tt-allsum.road-tax-rubl-doc
     2090         bf_tt-allsum-line.excise-base-doc        = bf_tt-allsum-line.excise-base-doc      + bf_tt-allsum.excise-base-doc
     2091         bf_tt-allsum-line.excise-rubl-doc        = bf_tt-allsum-line.excise-rubl-doc      + bf_tt-allsum.excise-rubl-doc
     2092         bf_tt-allsum-line.sum-dsc-base-cur       = bf_tt-allsum-line.sum-dsc-base-cur     + bf_tt-allsum.sum-dsc-base-cur
     2093         bf_tt-allsum-line.sum-dsc-rubl-cur       = bf_tt-allsum-line.sum-dsc-rubl-cur     + bf_tt-allsum.sum-dsc-rubl-cur
     2094         bf_tt-allsum-line.dsc-base-cur           = bf_tt-allsum-line.dsc-base-cur         + bf_tt-allsum.dsc-base-cur
     2095         bf_tt-allsum-line.dsc-rubl-cur           = bf_tt-allsum-line.dsc-rubl-cur         + bf_tt-allsum.dsc-rubl-cur
     2096         bf_tt-allsum-line.vat-base-cur           = bf_tt-allsum-line.vat-base-cur         + bf_tt-allsum.vat-base-cur
     2097         bf_tt-allsum-line.vat-rubl-cur           = bf_tt-allsum-line.vat-rubl-cur         + bf_tt-allsum.vat-rubl-cur
     2098         bf_tt-allsum-line.vat-base-buyer-cur     = bf_tt-allsum-line.vat-base-buyer-cur   + bf_tt-allsum.vat-base-buyer-cur
     2099         bf_tt-allsum-line.vat-rubl-buyer-cur     = bf_tt-allsum-line.vat-rubl-buyer-cur   + bf_tt-allsum.vat-rubl-buyer-cur
     2100         bf_tt-allsum-line.slt-base-cur           = bf_tt-allsum-line.slt-base-cur         + bf_tt-allsum.slt-base-cur
     2101         bf_tt-allsum-line.slt-rubl-cur           = bf_tt-allsum-line.slt-rubl-cur         + bf_tt-allsum.slt-rubl-cur
     2102         bf_tt-allsum-line.road-tax-base-cur      = bf_tt-allsum-line.road-tax-base-cur    + bf_tt-allsum.road-tax-base-cur
     2103         bf_tt-allsum-line.road-tax-rubl-cur      = bf_tt-allsum-line.road-tax-rubl-cur    + bf_tt-allsum.road-tax-rubl-cur
     2104         bf_tt-allsum-line.excise-base-cur        = bf_tt-allsum-line.excise-base-cur      + bf_tt-allsum.excise-base-cur
     2105         bf_tt-allsum-line.excise-rubl-cur        = bf_tt-allsum-line.excise-rubl-cur      + bf_tt-allsum.excise-rubl-cur
     2106         bf_tt-allsum-line.sum-dsc-base-acc       = bf_tt-allsum-line.sum-dsc-base-acc     + bf_tt-allsum.sum-dsc-base-acc
     2107         bf_tt-allsum-line.sum-dsc-rubl-acc       = bf_tt-allsum-line.sum-dsc-rubl-acc     + bf_tt-allsum.sum-dsc-rubl-acc
     2108         bf_tt-allsum-line.sum-dsc-cli-acc        = bf_tt-allsum-line.sum-dsc-cli-acc      + bf_tt-allsum.sum-dsc-cli-acc
     2109         bf_tt-allsum-line.dsc-base-acc           = bf_tt-allsum-line.dsc-base-acc         + bf_tt-allsum.dsc-base-acc
     2110         bf_tt-allsum-line.dsc-rubl-acc           = bf_tt-allsum-line.dsc-rubl-acc         + bf_tt-allsum.dsc-rubl-acc
     2111         bf_tt-allsum-line.dsc-cli-acc            = bf_tt-allsum-line.dsc-cli-acc          + bf_tt-allsum.dsc-cli-acc
     2112         bf_tt-allsum-line.vat-base-acc           = bf_tt-allsum-line.vat-base-acc         + bf_tt-allsum.vat-base-acc
     2113         bf_tt-allsum-line.vat-rubl-acc           = bf_tt-allsum-line.vat-rubl-acc         + bf_tt-allsum.vat-rubl-acc
     2114         bf_tt-allsum-line.vat-cli-acc            = bf_tt-allsum-line.vat-cli-acc          + bf_tt-allsum.vat-cli-acc
     2115         bf_tt-allsum-line.slt-base-acc           = bf_tt-allsum-line.slt-base-acc         + bf_tt-allsum.slt-base-acc
     2116         bf_tt-allsum-line.slt-rubl-acc           = bf_tt-allsum-line.slt-rubl-acc         + bf_tt-allsum.slt-rubl-acc
     2117         bf_tt-allsum-line.slt-cli-acc            = bf_tt-allsum-line.slt-cli-acc          + bf_tt-allsum.slt-cli-acc
     2118         bf_tt-allsum-line.road-tax-base-acc      = bf_tt-allsum-line.road-tax-base-acc    + bf_tt-allsum.road-tax-base-acc
     2119         bf_tt-allsum-line.road-tax-rubl-acc      = bf_tt-allsum-line.road-tax-rubl-acc    + bf_tt-allsum.road-tax-rubl-acc
     2120         bf_tt-allsum-line.road-tax-cli-acc       = bf_tt-allsum-line.road-tax-cli-acc     + bf_tt-allsum.road-tax-cli-acc
     2121         bf_tt-allsum-line.excise-base-acc        = bf_tt-allsum-line.excise-base-acc      + bf_tt-allsum.excise-base-acc
     2122         bf_tt-allsum-line.excise-rubl-acc        = bf_tt-allsum-line.excise-rubl-acc      + bf_tt-allsum.excise-rubl-acc
     2123         bf_tt-allsum-line.excise-cli-acc         = bf_tt-allsum-line.excise-cli-acc       + bf_tt-allsum.excise-cli-acc
     2124         bf_tt-allsum-line.transport-base-acc     = bf_tt-allsum-line.transport-base-acc   + bf_tt-allsum.transport-base-acc
     2125         bf_tt-allsum-line.transport-rubl-acc     = bf_tt-allsum-line.transport-rubl-acc   + bf_tt-allsum.transport-rubl-acc
     2126         bf_tt-allsum-line.transport-cli-acc      = bf_tt-allsum-line.transport-cli-acc    + bf_tt-allsum.transport-cli-acc
     2127         bf_tt-allsum-line.other-base-acc         = bf_tt-allsum-line.other-base-acc       + bf_tt-allsum.other-base-acc
     2128         bf_tt-allsum-line.other-rubl-acc         = bf_tt-allsum-line.other-rubl-acc       + bf_tt-allsum.other-rubl-acc
     2129         bf_tt-allsum-line.other-cli-acc          = bf_tt-allsum-line.other-cli-acc        + bf_tt-allsum.other-cli-acc
     2130         .
     2131     end.
     2132   end.
     2133   end.
     2134   end procedure.
     2135   do
     2136   on error undo, return error
     2137   :  v-all-qnty = 0.
     2138      v-all-stoim = 0.
     2139      v-fact-date-string = "".
     2140     find first t-doc no-lock  where recid( t-doc ) = rec_id  no-error.
     2141     if not available t-doc  then do:
     2142       message
     2143           vss-workfile vss-revision vss-description    skip "Не найден документ для печати."
     2144           skip return-value   skip trim(error-status :get-message(1))  trim(error-status :get-message(2))  trim(error-status :get-message(3))
     2145       view-as alert-box error.
     2146       undo, return error .
     2147     end.
     2148         run rep/get-psn.p
     2149         (input t-doc.boss
     2150         ,output v-boss-name
     2151         ) .
     2152       if v-boss-name = "?" then v-boss-name = " ".
     2153        run rep/get-psn.p
     2154         (input t-doc.agnt
     2155         ,output v-agnt-name
     2156         ) .
     2157       if v-agnt-name = "?" then v-agnt-name = " ".
     2158       find first OurObject no-lock
     2159        where OurObject.obj-type = t-doc.obj-type
     2160          and OurObject.obj-code = t-doc.obj-code
     2161       no-error.
     2162       if available OurObject then
     2163       do:
     2164       v-obj-name = OurObject.obj-name.
     2165       end.
     2166       v-doc-code = t-doc.doc-code.
     2167       v-fact-date-string = if t-doc.status_ = 'факт':U then  " от " + string( t-doc.fact-date , "99/99/9999" ) else "" .
     2168       v-doc-date-string = string( t-doc.doc-date, "99/99/9999" ).
     2169        for each buf_doc-line no-lock
     2170               where buf_doc-line.doc-code = t-doc.doc-code:
     2171        find first buf_goods no-lock  where buf_goods.artic      = buf_doc-line.artic
     2172                                         and buf_goods.prod-type  = buf_doc-line.prod-type
     2173                                         and buf_goods.prod-code  = buf_doc-line.prod-code.
     2174        if available buf_goods  then
     2175                                do:
     2176                                    create tt-line.
     2177                                    tt-line.gds-code = buf_goods.gds-code.
     2178                                    tt-line.artic = buf_goods.artic.
     2179                                    tt-line.gds-name = buf_goods.gds-name.
     2180                                    tt-line.qnty = buf_doc-line.fact-qnty.
     2181                                    v-all-qnty = v-all-qnty + tt-line.qnty.
     2182                                    run clcprtsl_calc-line in this-procedure (input recid (buf_doc-line)).
     2183                                    find first tt-allsum-line where tt-allsum-line.sum-type = 'основная_сумма':U no-error .
     2184                                    tt-line.stoim = tt-allsum-line.sum-dsc-rubl-doc.
     2185                                    v-all-stoim = v-all-stoim + tt-line.stoim.
     2186                                    tt-line.price   = tt-line.stoim / tt-line.qnty no-error.
     2187                                    find first ub.trn-reason no-lock
     2188                                            where ub.trn-reason.reason-code = t-doc.reason-code no-error.
     2189                                    if  available ub.trn-reason then
     2190                                    do:
     2191                                    tt-line.reason = ub.trn-reason.reason-name.
     2192                                    end.
     2193                               end.
     2194         end.
     2195        v-all-stoim = round( v-all-stoim,2).
     2196        run rep/wp-rub.p ( input v-all-stoim, output s1, output s2 ) .
     2197        s1 = RIGHT-TRIM(s1,".").
     2198         run rep/get-psn.p
     2199         (input t-doc.wrkr
     2200         ,output v-wrkr-name
     2201         ) .
     2202        if v-wrkr-name = "?" then v-wrkr-name = " " .
     2203   run main no-error.
     2204   if error-status:error then
     2205       message return-value
     2206       view-as alert-box.
     2207   end.
     2208   procedure main:
     2209       define variable v-file-name as character no-undo.
     2210       run create-rep(output v-file-name) no-error. if error-status:ERROR then return error subst("&1 &2 &3", return-value, ERROR-STATUS:get-message(1), ERROR-STATUS:get-message(2)).
     2211       if v-file-name = ? then
     2212           return error "файл созданного отчета не найден".
     2213       else
     2214           run open-ie(v-file-name) no-error. if error-status:ERROR then return error subst("&1 &2 &3", return-value, ERROR-STATUS:get-message(1), ERROR-STATUS:get-message(2)).
     2215   output stream out-stream to value( string( session:temp-directory +
     2216                                        "rpt" + string( g#report-num ) ) )
     2217                                        page-size  value(43) .
     2218       put stream out-stream unformatted
     2219             chr(10)
     2220           + "Печатная форма предназначена только для вывода в Microsoft Excel."
     2221           + chr(10)
     2222       .
     2223       output stream out-stream close.
     2224   end.
     2225   procedure create-rep:
     2226       define output parameter p-filename as character no-undo.
     2227       define variable v-rls-file as character no-undo.
     2228       define variable v-data-file as character no-undo.
     2229       define variable v-xsl-file as character no-undo.
     2230       define variable v-tmp-file as character no-undo.
     2231       define variable hw as handle no-undo.
     2232       define variable rep-out as class Rep-Out no-undo.
     2233       assign
     2234           v-xsl-file = search("exe/writeofrosneft.xsl.html")
     2235           v-data-file = session:temp-directory + string(time) + ".xml"
     2236           v-tmp-file = session:temp-directory + string(time) + ".html".
     2237       .
     2238       create sax-writer hw.
     2239       hw:formatted = true.
     2240       hw:set-output-destination ("file", v-data-file).
     2241       run write-data(hw) no-error. if error-status:ERROR then return error subst("&1 &2 &3", return-value, ERROR-STATUS:get-message(1), ERROR-STATUS:get-message(2)).
     2242       rep-out = new rep-out().
     2243       v-rls-file = rep-out:xsl-transform(v-data-file, v-xsl-file).
     2244       os-delete value(v-tmp-file).
     2245       os-copy value(v-rls-file) value(v-tmp-file).
     2246       os-delete value(v-rls-file).
     2247       delete object rep-out.
     2248       p-filename = v-tmp-file.
     2249   end.
     2250   procedure write-data:
     2251       define input parameter hw as handle no-undo.
     2252       v-lines-counter = 1.
     2253       hw:start-document ().
     2254       hw:start-element ("rep").
     2255       hw:start-element ("card").
     2256       hw:insert-attribute ("boss-name", if v-boss-name = ? then "" else v-boss-name ).
     2257       hw:insert-attribute ("agnt-name", if v-agnt-name = ? then "" else v-agnt-name ).
     2258       hw:insert-attribute ("obj-name", if v-obj-name = ? then "" else v-obj-name ).
     2259       hw:insert-attribute ("doc-code", if v-doc-code = ? then "" else v-doc-code ).
     2260       hw:insert-attribute ("fact-date-string", if v-fact-date-string = ? then "" else  v-fact-date-string  ).
     2261       hw:insert-attribute ("doc-date-string", if v-doc-date-string = ? then "" else  v-doc-date-string  ).
     2262       hw:insert-attribute ("wrkr-name", if v-wrkr-name = ? then "" else v-wrkr-name ).
     2263       hw:insert-attribute ("all-qnty", if v-all-qnty = ? then "" else string(v-all-qnty,"->>,>>>,>>9.<<") ).
     2264       hw:insert-attribute ("all-stoim", if v-all-stoim = ? then "" else string(v-all-stoim,"->,>>>,>>>,>>>,>>9.99")  ).
     2265       hw:insert-attribute ("s1", if s1 = ? then "" else s1  ).
     2266       hw:insert-attribute ("s1rub", if v-all-stoim = ? then "" else string(trunc( v-all-stoim, 0 ),"->,>>>,>>>,>>>,>>9"))  .
     2267       hw:insert-attribute ("s1kop", if v-all-stoim = ? then "" else string(trunc((v-all-stoim - trunc( v-all-stoim, 0 )) * 100, 0), "99"))  .
     2268       for each tt-line no-lock:
     2269           tt-line.lines-counter = v-lines-counter.
     2270           hw:start-element ("line").
     2271           hw:insert-attribute ("lines-counter", string(tt-line.lines-counter)).
     2272           hw:insert-attribute ("artic", if tt-line.artic = ? then "" else tt-line.artic).
     2273           hw:insert-attribute ("gds-name", if tt-line.gds-name = ? then "" else tt-line.gds-name).
     2274           hw:insert-attribute ("qnty", if tt-line.qnty = ? then "" else string(tt-line.qnty,"->>,>>>,>>9.<<")).
     2275           hw:insert-attribute ("price", if tt-line.price = ? then "" else string(tt-line.price,"->,>>>,>>>,>>>,>>9.99")).
     2276           hw:insert-attribute ("stoim", if tt-line.stoim = ? then "" else string(tt-line.stoim,"->,>>>,>>>,>>>,>>9.99")).
     2277           hw:insert-attribute ("reason", if tt-line.reason = ? then "" else tt-line.reason).
     2278           hw:end-element ("line").
     2279           v-lines-counter = v-lines-counter + 1.
     2280       end.
     2281       hw:end-element ("card").
     2282       hw:end-element ("rep").
     2283       hw:end-document ().
     2284   end.
     2285   procedure open-ie:
     2286       define input parameter p-filename as character no-undo.
     2287       define variable o-IE as com-handle no-undo.
     2288       create "InternetExplorer.Application" o-IE.
     2289       o-IE:addressbar = false.
     2290       o-IE:Navigate(p-filename).
     2291       o-IE:visible = true.
     2292       release object o-IE.
     2293   end.
