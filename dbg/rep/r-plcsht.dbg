     2782                              INPUT   buf_goods.gds-code,
     2783                              INPUT   "car-num":U ,
     2784                              OUTPUT  v-car-num      ,
     2785                              OUTPUT  v-exist       )
     2786                              NO-ERROR .
     2787                           IF ERROR-STATUS :ERROR
     2788                           OR NOT v-exist
     2789                           THEN DO:
     2790                              assign
