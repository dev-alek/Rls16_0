      610   define variable var-report-r-b as character no-undo .
      611   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      612   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      613     (output var-report-r-b
      614     )  .
      615   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      616   define variable v-waitfram-action01         as character   no-undo .
      617   define variable v-waitfram-action02         as character   no-undo .
      618   define variable v-waitfram-action03         as character   no-undo .
      619   define variable mWaitFramTextBeg            as character   no-undo.
      620   define variable mWaitFramTextEnd            as character   no-undo.
      621   define variable mWaitFramView               as logical     no-undo.
      622   define variable mWaitProcEvent              as logical     no-undo init yes.
      623   define variable mWaitFramInterval           as integer     no-undo init 1 .
      624   define variable mWaitFramStop               as logical     no-undo.
      625   define variable mWaitFramStopUser           as logical     no-undo.
      626   define variable mWaitFramStopTimeOut        as logical     no-undo.
      627   define variable mWaitFramStartProc          as datetime-tz no-undo.
      628   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      629   define button B-WaitFramStop auto-end-key
      630        label "Стоп"
      631        size 10 by 1 tooltip "Остоновить процесс".
      632   define button B-viewProcInfo
      633        label "Информация"
      634        size 15 by 1 tooltip "Информация о процесс".
      635   define frame waitfram
      636     v-waitfram-action01 format "x(72)" no-label skip
      637     v-waitfram-action02 format "x(72)" no-label skip
      638     v-waitfram-action03 format "x(72)" no-label skip
      639     B-viewProcInfo
      640     B-WaitFramStop at row 4 col 30
      641     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      642     .
      643   define new global shared variable mBatchMode as logical no-undo init ?.
      644   define variable mFramBachModHandle as handle no-undo.
      645   mFramBachModHandle = frame waitfram:handle.
      646   define variable mFameOldVis as logical no-undo.
      647   define variable mVisCUrentVin as logical no-undo.
      648   if session:batch-mode
      649   then
      650      mBatchMode = yes.
      651   if mBatchMode = ? then do:
      652     mVisCUrentVin = current-window:visible.
      653     mFameOldVis = mFramBachModHandle:visible.
      654     mFramBachModHandle:visible  = yes.
      655     mBatchMode = mFramBachModHandle:visible ne yes.
      656     mFramBachModHandle:visible = mFameOldVis.
      657     current-window:visible = mVisCUrentVin.
      658   end.
      659    if  log-manager:logfile-name ne ?
      660     then DO:
      661         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      662         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      663         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      664     end.
      665   on choose of B-WaitFramStop in frame waitfram
      666   do:
      667     mWaitFramStop = yes.
      668     mWaitFramStopUser = yes.
      669   end.
      670   function waitfram-check-timeout returns logical():
      671      define variable vtime as int64 no-undo.
      672      if mWaitFramStopTimeOut
      673      then
      674         return yes.
      675      vtime = ( now - mWaitFramStartProc ) / 1000 .
      676      if     mWaitFramTimeOut ne ?
      677         and mWaitFramTimeOut ne 0
      678         and mWaitFramTimeOut lt vtime
      679      then do:
      680         mWaitFramStopTimeOut = yes.
      681      end.
      682      return mWaitFramStopTimeOut.
      683   end.
      684   procedure waitfram-hide :
      685     if not session:batch-mode
      686     then do
      687     on error undo, return error return-value
      688     :
      689       pause 0 before-hide .
      690       if not mBatchMode then
      691         hide frame waitfram .
      692     if     not mWaitFramView
      693        and mWaitProcEvent
      694     then
      695       process events .
      696     end.
      697   end procedure.
      698   procedure waitfram-show :
      699     define input  parameter p-message as character no-undo .
      700     define variable v-left-margin as integer   no-undo .
      701     if not session:batch-mode
      702     then do
      703     on error undo, return error return-value
      704     :
      705       if length(p-message) <= 70 then do:
      706         assign
      707           v-left-margin = integer((70 - length(p-message)) / 2)
      708         .
      709         assign
      710           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      711         .
      712         assign
      713           v-waitfram-action01 = " "
      714           v-waitfram-action02 = " "
      715                                    + fill(" ", v-left-margin)
      716                                    + p-message
      717           v-waitfram-action03 = " "
      718         .
      719       end.
      720       else do:
      721         define variable vRindex1 as integer no-undo.
      722         define variable vRindex2 as integer no-undo.
      723         vRindex1 = r-index(p-message," ",70).
      724         if vRindex1 = 0
      725         then
      726            vRindex1 = 70.
      727         if length(p-message)  <= vRindex1 + 70 then do:
      728           assign
      729             v-waitfram-action01 = " "
      730             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      731             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      732           .
      733         end.
      734         else do:
      735           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      736           if vRindex2 <= vRindex1
      737           then
      738              vRindex2 = vRindex1 + 70.
      739           assign
      740             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      741             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      742             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      743           .
      744         end.
      745       end.
      746       B-viewProcInfo:visible   in frame waitfram = no.
      747       B-viewProcInfo:sensitive in frame waitfram = no.
      748       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      749       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      750       if  (   mWaitFramView
      751          or  mWaitProcEvent)
      752          and not mBatchMode
      753       then
      754          display
      755             v-waitfram-action01 skip
      756             v-waitfram-action02 skip
      757             v-waitfram-action03 skip
      758          with frame waitfram .
      759       if     mWaitFramView
      760          then do:
      761             if     mWaitFramInterval ne ?
      762                and not mBatchMode
      763             then
      764                wait-for go of frame waitfram pause mWaitFramInterval.
      765          end.
      766          else
      767             if     mWaitProcEvent
      768                and not mBatchMode
      769             then
      770                process events .
      771     end.
      772   end procedure.
      773      procedure waitfram-show-this:
      774         define input  parameter iInterval as int64 no-undo.
      775         define variable vtime as int64 no-undo.
      776         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      777         mWaitFramInterval = iInterval.
      778         run waitfram-show (substitute("&1&2 &3&4" ,
      779                                       mWaitFramTextBeg ,
      780                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      781                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      782                                       mWaitFramTextEnd
      783                                      )
      784                           ).
      785      end.
      786      procedure WaitFramRunPause:
      787         define input  parameter iInterval as dec no-undo.
      788         define variable vStart  as datetime-tz no-undo.
      789         define variable vend    as datetime-tz no-undo.
      790         define variable vint as int64 no-undo.
      791         define variable vOk as logical no-undo.
      792         vStart = now.
      793         vend   = vStart.
      794         publish "WaitFramPause" (iInterval,output vOk).
      795         vend   =  now.
      796         vint = vend - vStart.
      797         vint = iInterval - vint / 1000.
      798         if     not mWaitFramStop
      799            and (   vint > 0
      800                 or (    not vOk
      801                     and iInterval eq ?
      802                     )
      803                 )
      804         then
      805            run waitfram-show-this (iInterval).
      806         vend   =  now.
      807         vint = vend - vStart.
      808         vint = iInterval - vint / 1000.
      809         if     not mWaitFramStop
      810            and vint > 0
      811         then do:
      812            run gbl/pause.p (vint * 1000).
      813         end.
      814         if iInterval ne ?
      815         then
      816            publish "WaitFramStop".
      817         waitfram-check-timeout().
      818      end.
      819      procedure WaitFramWaitFor:
      820         define input  parameter iInterval as dec no-undo.
      821         assign
      822            mWaitFramStartProc   = now
      823            mWaitFramStopUser    = no
      824            mWaitFramStopTimeOut = no
      825         .
      826         block-wait:
      827         do while not mWaitFramStop:
      828            run WaitFramRunPause (iInterval).
      829            if  waitfram-check-timeout()
      830            then do:
      831               leave block-wait.
      832            end.
      833         end.
      834         run waitfram-hide.
      835      end.
      836   procedure waitfram-join :
      837     define input  parameter p-line-1  as character no-undo .
      838     define input  parameter p-line-2  as character no-undo .
      839     define input  parameter p-line-3  as character no-undo .
      840     define output parameter p-message as character no-undo .
      841     do
      842     on error undo, return error return-value
      843     :
      844       assign
      845         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      846                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      847                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      848       .
      849     end.
      850   end procedure.
      851   function waitfram-join-function returns character
      852     (input p-line-1 as character
      853     ,input p-line-2 as character
      854     ,input p-line-3 as character
      855     ).
      856     define variable v-message as character no-undo .
      857     run waitfram-join in this-procedure
      858       (input  p-line-1
      859       ,input  p-line-2
      860       ,input  p-line-3
      861       ,output v-message
      862       ) .
      863     return v-message .
      864   end function .
      865   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      866   define  stream PrnLibStream.
      867   procedure prn-lib-prn-file :
      868     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      869     define input parameter p-DIsabledoptions as integer no-undo .
      870     define variable v-report-name as character no-undo .
      871     define variable v-user-action as character no-undo .
      872     define variable v-printed     as logical   no-undo .
      873     define variable v-exist       as logical   no-undo .
      874     do
      875       on error undo, return error
      876       :
      877       run prn-lib-get-report-name  in this-procedure (
      878         input parParentProc
      879         ,output v-report-name
      880         ).
      881   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      882   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      883     (input  v-report-name
      884     ,input  2
      885     ,output v-exist
      886     )  .
      887       if NOT v-exist then
      888       DO:
      889         Message
      890           "Нет заданий на печать ! "
      891           view-as alert-box .
      892         Return  .
      893       End.
      894       run gbl/prnfilen.w
      895         (input  ""
      896         ,input  p-DisabledOptions
      897         ,input  string(v-report-name )
      898         ,input  7
      899         ,output v-user-action
      900         ,output v-printed
      901         ) .
      902       if v-printed then
      903       do:
      904         return "YES" .
      905       end.
      906       else
      907       do:
      908         return "NO" .
      909       end.
      910     end.
      911   end procedure.
      912   procedure prn-lib-open-stream :
      913     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      914     define input parameter p-page-size    as integer no-undo .
      915     define input parameter p-is-stream    as logical no-undo .
      916     define input parameter p-append       as logical no-undo .
      917     define variable v-report-name as character no-undo .
      918     do
      919       on error undo, return error
      920       :
      921       run prn-lib-get-report-name  in this-procedure (
      922         input parParentProc
      923         ,output v-report-name
      924         ).
      925       if p-is-stream then
      926       do:
      927         if p-append then
      928         do:
      929           output stream PrnLibStream to value( v-report-name )
      930             page-size value(p-page-size) append .
      931         end.
      932         if not p-append then
      933         do:
      934           output stream PrnLibStream to value( v-report-name )
      935             page-size value(p-page-size) .
      936         end.
      937       end.
      938       if not p-is-stream then
      939       do:
      940         if p-append then
      941         do:
      942           output to value( v-report-name )
      943             page-size value(p-page-size) append .
      944         end.
      945         if not p-append then
      946         do:
      947           output to value( v-report-name )
      948             page-size value(p-page-size) .
      949         end.
      950       end.
      951     end.
      952   end procedure.
      953   procedure prn-lib-open-exp :
      954     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      955     define input parameter p-is-stream    as logical no-undo .
      956     define input parameter p-is-append    as logical no-undo .
      957     define output parameter p-ReportFileName as char init "report" no-undo.
      958     define output parameter p-process as logical no-undo .
      959     define variable glog as logical no-undo .
      960     do
      961       on error undo, return error
      962       :
      963       SYSTEM-DIALOG GET-FILE p-ReportFileName
      964         TITLE      "Укажите путь"
      965         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      966         ASK-OVERWRITE
      967         CREATE-TEST-FILE
      968         SAVE-AS
      969         USE-FILENAME
      970         DEFAULT-EXTENSION "txt"
      971         UPDATE glog
      972         .
      973       if not glog then  return.
      974       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      975       if p-is-stream then
      976       do:
      977         if p-is-append then
      978         do:
      979           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      980         end.
      981         else
      982         do:
      983           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      984         end.
      985       end.
      986       else
      987       do:
      988         if p-is-append then
      989         do:
      990           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      991         end.
      992         else
      993         do:
      994           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      995         end.
      996       end.
      997       p-process = yes.
      998     end.
      999   end procedure.
     1000   procedure prn-lib-get-report-name :
     1001     define input parameter parParentProc  as widget-handle no-undo.
     1002     define output parameter p-report-name as character no-undo .
     1003     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
     1004   end procedure.
     1005   procedure prn-lib-reportviewer-report-name :
     1006     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1007     define input parameter p-report-name-html as character no-undo .
     1008     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
     1009   end procedure.
     1010   procedure prn-lib-reportviewer :
     1011     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1012     define input parameter p-report-name-html as character no-undo .
     1013     define input parameter p-param        as character no-undo .
     1014     define variable v-excel           as character no-undo init 'TRUE' .
     1015     define variable v-value-character as character no-undo .
     1016     define variable v-value-integer   as character no-undo .
     1017     define variable v-value-date      as date      no-undo .
     1018     define variable v-value-decimal   as decimal   no-undo .
     1019     define variable rep-excel         as logical   no-undo .
     1020     define variable excel-string      as character no-undo .
     1021     define variable v-param-type      as character no-undo .
     1022     define variable v-tth             as handle    no-undo .
     1023     run adm/shattri.p (
     1024       input "get":U
     1025       ,input  ""
     1026       ,input  0
     1027       ,input  'report-glob':U
     1028       ,input  'rep-excel':U
     1029       ,output v-value-character
     1030       ,output v-value-date
     1031       ,output v-value-decimal
     1032       ,output v-value-integer
     1033       ,output rep-excel
     1034       ,output v-param-type
     1035       ,INPUT-OUTPUT table-handle v-tth
     1036       )  .
     1037     if rep-excel then v-excel = "TRUE" .
     1038     else v-excel = "FALSE" .
     1039     if p-param eq ""
     1040     then
     1041        p-param = "EXCEL:" + v-excel.
     1042     else
     1043        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
     1044     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
     1045   end procedure.
     1046   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1047   procedure cur-time :
     1048      define output parameter p-today as date      no-undo .
     1049      define output parameter p-time  as integer   no-undo .
     1050     do
     1051     on error undo, return error
     1052     :
     1053       define variable v-date1 as date      no-undo .
     1054       define variable v-date2 as date      no-undo .
     1055       define variable v-time  as integer   no-undo .
     1056       assign
     1057         v-date1 = today
     1058         v-time  = time
     1059         v-date2 = today
     1060       .
     1061       if v-date1 <> v-date2
     1062       then do:
     1063         assign
     1064           v-date1 = today
     1065           v-time  = v-time
     1066         .
     1067       end.
     1068       assign
     1069         p-today = v-date1
     1070         p-time  = v-time
     1071       .
     1072     end.
     1073   end.
     1074   function cur-time-date returns character
     1075   :
     1076     return string(today, '99/99/9999':U) .
     1077   end.
     1078   function cur-time-mjd returns decimal
     1079   :
     1080     define variable v-date as date      no-undo .
     1081     define variable v-time as integer   no-undo .
     1082     run cur-time in this-procedure
     1083       (output v-date
     1084       ,output v-time
     1085       ) .
     1086     return integer(v-date) - 2400002 + (v-time / 86400) .
     1087   end.
     1088   function cur-time-get-ending-index returns integer
     1089   (input p-number as integer
     1090   )
     1091   :
     1092     if p-number < 0
     1093     or p-number = ?
     1094     then do:
     1095       return 1 .
     1096     end.
     1097     define variable v-rest as integer   no-undo .
     1098     assign
     1099       p-number = p-number modulo 100
     1100     .
     1101     if p-number < 20
     1102     then do:
     1103       assign
     1104         v-rest = p-number
     1105       .
     1106     end.
     1107     else do:
     1108       assign
     1109         v-rest = p-number modulo 10
     1110       .
     1111     end.
     1112     case v-rest :
     1113       when 1
     1114       then do:
     1115         return 2 .
     1116       end.
     1117       when 2 or
     1118       when 3 or
     1119       when 4
     1120       then do:
     1121         return 3 .
     1122       end.
     1123       otherwise do:
     1124         return 1 .
     1125       end.
     1126     end case .
     1127   end.
     1128   procedure cur-time-mjd-to-date :
     1129      define input  parameter i-mjd-diff as decimal no-undo.
     1130      define output parameter o-Date     as date    no-undo.
     1131      define output parameter o-Time     as integer no-undo.
     1132      define variable v-day-number as integer   no-undo .
     1133      if    i-mjd-diff < 0
     1134         or i-mjd-diff = ?
     1135      then do:
     1136         return "?" .
     1137      end.
     1138      assign
     1139         v-day-number = truncate(i-mjd-diff,0).
     1140         o-Date = date(v-day-number + 2400002).
     1141         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     1142     .
     1143   end.
     1144   function cur-time-mjd-to-string returns character
     1145   (input p-mjd-diff as decimal
     1146   )
     1147   :
     1148     define variable v-day-number as integer   no-undo .
     1149     define variable v-seconds    as integer   no-undo .
     1150     define variable v-hour       as integer   no-undo .
     1151     define variable v-min        as integer   no-undo .
     1152     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     1153     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     1154     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     1155     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1156     if p-mjd-diff < 0
     1157     or p-mjd-diff = ?
     1158     then do:
     1159       return "?" .
     1160     end.
     1161     assign
     1162       v-day-number = integer(truncate(p-mjd-diff,0))
     1163       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1164     .
     1165     if v-seconds > 86400
     1166     then do:
     1167       assign
     1168         v-seconds = 86400 - 1
     1169       .
     1170     end.
     1171     if v-seconds < 0
     1172     then do:
     1173       assign
     1174         v-seconds = 0
     1175       .
     1176     end.
     1177     assign
     1178       v-hour = truncate(v-seconds / 3600, 0)
     1179     .
     1180     assign
     1181       v-seconds = v-seconds modulo 3600
     1182     .
     1183     assign
     1184       v-min = truncate(v-seconds / 60, 0)
     1185     .
     1186     assign
     1187       v-seconds = v-seconds modulo 60
     1188     .
     1189     return
     1190         (if v-day-number <> 0
     1191           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1192           else ""
     1193         )
     1194       + (if v-day-number <> 0 or v-hour <> 0
     1195           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1196           else ""
     1197         )
     1198       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1199           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1200           else ""
     1201         )
     1202       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1203       .
     1204   end.
     1205   function cur-time-string returns character
     1206   :
     1207     define variable v-date as date      no-undo .
     1208     define variable v-time as integer   no-undo .
     1209     run cur-time in this-procedure
     1210       (output v-date
     1211       ,output v-time
     1212       ) .
     1213     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1214   end.
     1215   function cur-time-string-sec returns character
     1216   :
     1217     define variable v-date as date      no-undo .
     1218     define variable v-time as integer   no-undo .
     1219     run cur-time in this-procedure
     1220       (output v-date
     1221       ,output v-time
     1222       ) .
     1223     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1224   end.
     1225   function cur-time-custom  returns character
     1226   (input p-prefix as character
     1227   ,input p-date-format as character
     1228   ,input p-delimiter as character
     1229   ,input p-time-format as character
     1230   ,input p-suffix as character
     1231   )
     1232   :
     1233     define variable v-date as date      no-undo .
     1234     define variable v-time as integer   no-undo .
     1235     run cur-time in this-procedure
     1236       (output v-date
     1237       ,output v-time
     1238       ) .
     1239     return
     1240       p-prefix
     1241       + string(v-date, p-date-format)
     1242       + p-delimiter
     1243       + string(v-time, p-time-format)
     1244       + p-suffix
     1245       .
     1246   end.
     1247   function cur-time-print  returns character
     1248   :
     1249     define variable v-date as date      no-undo .
     1250     define variable v-time as integer   no-undo .
     1251     run cur-time in this-procedure
     1252       (output v-date
     1253       ,output v-time
     1254       ) .
     1255     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1256   end.
     1257   function cur-time-datetime returns datetime
     1258   :
     1259     define variable v-char as character no-undo .
     1260     define variable v-datetime as datetime no-undo .
     1261     v-char = cur-time-string().
     1262     v-datetime = datetime(v-char).
     1263     return  v-datetime.
     1264   end.
     1265   function cur-time-string-msec returns character
     1266   :
     1267     define variable v-date as datetime  no-undo .
     1268     v-date = now.
     1269     return string(v-date) .
     1270   end.
     1271   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1272   define new shared variable PrintCopiesCounter as integer   no-undo initial 1 .
     1273   define new shared variable RepPathName        as character no-undo .
     1274   define new shared variable PrintRubl          as logical   no-undo .
     1275   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1276   procedure lineattr-value :
     1277     do
     1278     on error undo, return error return-value
     1279     :
     1280       define input  parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
     1281       define input  parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
     1282       define input  parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
     1283       define output parameter p-value    like ub.doc-line-attr.attr-value no-undo .
     1284       define output parameter p-type     as character no-undo .
     1285       define buffer buf_doc-line-attr for ub.doc-line-attr .
     1286       def var v-format         as character no-undo .
     1287       def var v-fillin_width   as integer   no-undo .
     1288       def var v-fillin_height  as integer   no-undo .
     1289       def var v-label          as character no-undo .
     1290       def var v-user-can-edit  as logical   no-undo .
     1291       def var v-output-display as logical   no-undo .
     1292       def var v-other          as character no-undo .
     1293       run lineattr-code in this-procedure
     1294         (input  p-code
     1295         ,output p-type
     1296         ,output v-format
     1297         ,output v-fillin_width
     1298         ,output v-fillin_height
     1299         ,output v-label
     1300         ,output v-user-can-edit
     1301         ,output v-output-display
     1302         ,output v-other
     1303         ) no-error .
     1304       if error-status :error then do:
     1305         undo, return error return-value .
     1306       end.
     1307       find first buf_doc-line-attr no-lock
     1308         where buf_doc-line-attr.doc-code  = p-doc-code
     1309           and buf_doc-line-attr.gds-code  = p-gds-code
     1310           and buf_doc-line-attr.attr-code = p-code
     1311         no-error .
     1312       if avail buf_doc-line-attr then do:
     1313         assign
     1314           p-value =  buf_doc-line-attr.attr-value
     1315         .
     1316       end.
     1317       else do:
     1318         assign
     1319           p-value = if p-type = 'L':U then "no":U else ""
     1320         .
     1321       end.
     1322     end.
     1323   end procedure.
     1324   procedure lineattr-write :
     1325     do
     1326     on error undo, return error return-value
     1327     :
     1328       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
     1329       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
     1330       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
     1331       define input parameter p-value    like ub.doc-line-attr.attr-value no-undo .
     1332       define buffer buf_doc-line-attr for ub.doc-line-attr .
     1333       def var v-type           as character no-undo .
     1334       def var v-format         as character no-undo .
     1335       def var v-fillin_width   as integer   no-undo .
     1336       def var v-fillin_height  as integer   no-undo .
     1337       def var v-label          as character no-undo .
     1338       def var v-user-can-edit  as logical   no-undo .
     1339       def var v-output-display as logical   no-undo .
     1340       def var v-other          as character no-undo .
     1341       run lineattr-code in this-procedure
     1342         (input  p-code
     1343         ,output v-type
     1344         ,output v-format
     1345         ,output v-fillin_width
     1346         ,output v-fillin_height
     1347         ,output v-label
     1348         ,output v-user-can-edit
     1349         ,output v-output-display
     1350         ,output v-other
     1351         ) no-error .
     1352       if error-status :error then do:
     1353         undo, return error return-value .
     1354       end.
     1355       find first buf_doc-line-attr exclusive-lock
     1356         where buf_doc-line-attr.doc-code  = p-doc-code
     1357           and buf_doc-line-attr.gds-code  = p-gds-code
     1358           and buf_doc-line-attr.attr-code = p-code
     1359         no-error .
     1360       if not available buf_doc-line-attr then do:
     1361         create buf_doc-line-attr .
     1362         assign
     1363           buf_doc-line-attr.doc-code  = p-doc-code
     1364           buf_doc-line-attr.gds-code = p-gds-code
     1365           buf_doc-line-attr.attr-code = p-code
     1366         .
     1367       end.
     1368       assign
     1369         buf_doc-line-attr.attr-value = p-value
     1370       .
     1371        release buf_doc-line-attr.
     1372     end.
     1373   end procedure.
     1374   procedure lineattr-exist :
     1375     do
     1376     on error undo, return error return-value
     1377     :
     1378       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
     1379       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
     1380       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
     1381       define output parameter p-exist   as logical  no-undo .
     1382       define buffer buf_doc-line-attr for ub.doc-line-attr .
     1383       def var v-type           as character no-undo .
     1384       def var v-format         as character no-undo .
     1385       def var v-fillin_width   as integer   no-undo .
     1386       def var v-fillin_height  as integer   no-undo .
     1387       def var v-label          as character no-undo .
     1388       def var v-user-can-edit  as logical   no-undo .
     1389       def var v-output-display as logical   no-undo .
     1390       def var v-other          as character no-undo .
     1391       run lineattr-code in this-procedure
     1392         (input  p-code
     1393         ,output v-type
     1394         ,output v-format
     1395         ,output v-fillin_width
     1396         ,output v-fillin_height
     1397         ,output v-label
     1398         ,output v-user-can-edit
     1399         ,output v-output-display
     1400         ,output v-other
     1401         ) no-error .
     1402       if error-status :error then do:
     1403         undo, return error return-value .
     1404       end.
     1405       find first buf_doc-line-attr no-lock
     1406         where buf_doc-line-attr.doc-code  = p-doc-code
     1407           and buf_doc-line-attr.gds-code = p-gds-code
     1408           and buf_doc-line-attr.attr-code = p-code
     1409         no-error .
     1410       if  available buf_doc-line-attr then do:
     1411         p-exist = yes.
     1412       end.
     1413     end.
     1414   end procedure.
     1415   procedure lineattr-delete :
     1416     do
     1417     on error undo, return error return-value
     1418     :
     1419       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
     1420       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
     1421       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
     1422       define output parameter p-deleted  as logical no-undo.
     1423       define buffer buf_doc-line-attr for ub.doc-line-attr .
     1424       def var v-type           as character no-undo .
     1425       def var v-format         as character no-undo .
     1426       def var v-fillin_width   as integer   no-undo .
     1427       def var v-fillin_height  as integer   no-undo .
     1428       def var v-label          as character no-undo .
     1429       def var v-user-can-edit  as logical   no-undo .
     1430       def var v-output-display as logical   no-undo .
     1431       def var v-other          as character no-undo .
     1432       run lineattr-code in this-procedure
     1433         (input  p-code
     1434         ,output v-type
     1435         ,output v-format
     1436         ,output v-fillin_width
     1437         ,output v-fillin_height
     1438         ,output v-label
     1439         ,output v-user-can-edit
     1440         ,output v-output-display
     1441         ,output v-other
     1442         ) no-error .
     1443       if error-status :error then do:
     1444         undo, return error return-value .
     1445       end.
     1446       find first buf_doc-line-attr exclusive-lock
     1447         where buf_doc-line-attr.doc-code  = p-doc-code
     1448           and buf_doc-line-attr.gds-code  = p-gds-code
     1449           and buf_doc-line-attr.attr-code = p-code
     1450         no-error NO-WAIT.
     1451       if not available buf_doc-line-attr then do:
     1452         p-deleted = no.
     1453       end.
     1454       else do:
     1455         delete buf_doc-line-attr.
     1456         p-deleted = yes.
     1457       end.
     1458     end.
     1459   end procedure.
     1460   procedure lineattr-code :
     1461     do on error undo, return error return-value
     1462     :
     1463       define input  parameter p-code           as character no-undo .
     1464       define output parameter p-type           as character no-undo .
     1465       define output parameter p-format         as character no-undo .
     1466       define output parameter p-fillin_width   as integer   no-undo .
     1467       define output parameter p-fillin_height  as integer   no-undo .
     1468       define output parameter p-label          as character no-undo .
     1469       define output parameter p-user-can-edit  as logical   no-undo .
     1470       define output parameter p-output-display as logical   no-undo .
     1471       define output parameter p-other          as character no-undo .
     1472       case p-code :
     1473               when 'parts_price-sale':U then do:     assign     p-label          = "Продажная цена партии"     p-type           = 'C':U      p-format         = "x(70)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Продажная цена партии"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
     1474               when 'fl_gds-code':U then do:     assign     p-label          = "Количество по букету"     p-type           = 'C':U      p-format         = "x(70)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Количество по букету"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
     1475               when 'old_other-ras':U then do:     assign     p-label          = " Первым способом из ПН Сумма дополнительных расходов по строке rubl base"     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = " Первым способом из ПН Сумма дополнительных расходов по строке rubl base"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
     1476               when 'new_other-ras':U then do:     assign     p-label          = " Способом из ДопРасх Сумма дополнительных расходов по строке rubl base"     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = " Способом из ДопРасх Сумма дополнительных расходов по строке rubl base"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
     1477               when 'flora_ps':U then do:     assign     p-label          = "Описание не товарной позиции"     p-type           = 'C':U      p-format         = "x(70)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Описание не товарной позиции"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
     1478               when 'country-code':U then do:     assign     p-label          = "Страна"     p-type           = 'I':U      p-format         = "->>>>>>>>9"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Страна"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
     1479               when 'add-line-cli':U then do:     assign     p-label          = "Курс . шкала . сумма . НДС "     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Курс . шкала . сумма . НДС "     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
     1480               when 'corr-price-sale':U then do:     assign     p-label          = "Продажная цена в строке ПН"     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Продажная цена в строке ПН"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
     1481               when 'reason-code':U then do:     assign     p-label          = "Причина отклонения"     p-type           = 'I':U      p-format         = "->>>>>>>>9"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Причина отклонения"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
     1482               when 'price-prod':U then do:     assign     p-label          = "Цена производителя Без НДС"     p-type           = 'D':U      p-format         = ">>>>>>>>9.99"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Цена производителя Без НДС"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
     1483               when 'price-prodvat':U then do:     assign     p-label          = "Цена производителя c НДС"     p-type           = 'D':U      p-format         = ">>>>>>>>9.99"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Цена производителя c НДС"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
     1484         otherwise do:
     1485           undo, return error "неизвестный атрибут строки документа" + " " + p-code .
     1486         end.
     1487       end.
     1488     end.
     1489   end procedure.
     1490   procedure lineattr-value-flora-gds :
     1491     do
     1492     on error undo, return error return-value
     1493     :
