     2835                     tt-doc.loc1               = v-loc
     2836                     tt-doc.state-measure-qnty = buf_rvs-line.state-measure-qnty
     2837                     tt-doc.state-temperature  = buf_rvs-line.state-temperature
     2838                     tt-doc.state-dencity      = buf_rvs-line.state-density
     2839                     tt-doc.fact-date          = buf_rvs-doc.fact-date
     2840                     tt-doc.fact-time          = STRING(buf_rvs-doc.fact-time, "HH:MM:SS")
     2841                     tt-doc.gds-name           = buf_goods.gds-name
     2842                     tt-doc.rvs-type           = buf_rvs-doc.rvs-type
     2843                     tt-doc.state-level-total  = buf_rvs-line.state-level-total
     2844                     tt-doc.attr_              = v-attr
     2845                  .
     2846                  case tt-doc.rvs-type:
     2847                     when 'после_док':U then do:
     2848                        assign
