     2763                                    and buf_clients.obj-code = INTEGER(v-autoent-code)
     2764                                 no-lock
     2765                                 no-error
     2766                                 .
     2767                           IF AVAILABLE buf_clients then do:
     2768                              assign
     2769                                 v-autoent-name = buf_clients.obj-name
     2770                              .
     2771                           end.
     2772                           else do:
     2773                              assign
     2774                                 v-autoent-name = "не задан":U
     2775                              .
     2776                           end.
     2777                           assign
     2778                              v-exist = false
     2779                           .
