     3292            v-counter    = v-counter + 1
     3293            v-density-av = v-density-av + tt-doc.state-dencity
     3294         .
     3295         IF LAST-OF(tt-doc.gds-code) then do:
     3296            find first buf_tt-doc
     3297               where buf_tt-doc.rvs-type = 'смена':U
     3298                  and buf_tt-doc.pl-code  = tt-doc.pl-code
     3299                  and buf_tt-doc.gds-code = tt-doc.gds-code
     3300               no-lock
     3301               no-error.
     3302            IF AVAILABLE buf_tt-doc then do:
     3303               assign
     3304                  buf_tt-doc.average-dencity = v-density-av / v-counter
     3305                  v-density-av = 0
     3306                  v-counter    = 0
     3307               .
     3308            end.
     3309            else do:
     3310               assign
     3311                  v-density-av = 0
     3312                  v-counter    = 0
     3313               .
     3314            end.
     3315         end.
     3316      end.
     3317   end.
     3318   end procedure.
     3319   procedure print-body :
     3320   do
     3321   on error undo, return error
     3322   :
     3323      assign
     3324         v-counter = 0
     3325      .
     3326      for each tt-doc
     3327          where  tt-doc.rvs-type   = 'смена':U
     3328          use-index by-type
     3329      :
     3330         v-counter = v-counter + 1.
     3331         display stream out-stream
     3332            tt-doc.loc1
     3333            tt-doc.state-measure-qnty
     3334            tt-doc.state-level-total
     3335            tt-doc.state-temperature
     3336            tt-doc.state-dencity
     3337            tt-doc.average-dencity
     3338            sym1  sym2  sym3  sym4  sym5  sym6  sym7
     3339         with frame f-first.
     3340         down stream out-stream 1 with frame f-first
     3341         .
     3342         run r-plc-xl-sheet1-write-line-data in this-procedure (
     3343              input tt-doc.loc1
     3344            , input tt-doc.state-measure-qnty
     3345            , input tt-doc.state-level-total
     3346            , input tt-doc.state-temperature
     3347            , input tt-doc.state-dencity
     3348            , input tt-doc.average-dencity
     3349         ) .
     3350      end.
     3351      IF v-counter = 0 then do:
     3352         display stream out-stream
     3353            "не закр." @ tt-doc.loc1
     3354            sym1  sym2  sym3  sym4  sym5  sym6  sym7
     3355         with frame f-first.
     3356         down stream out-stream 1 with frame f-first
     3357         .
     3358      end.
     3359      put stream out-stream unformatted fill( "-" , 54 ) skip.
     3360      assign
     3361         v-counter = 0
     3362      .
     3363      for each tt-doc
     3364          where  tt-doc.rvs-type   <> 'смена':U
     3365          use-index by-date
     3366      :
     3367         v-counter = v-counter + 1.
     3368         display stream out-stream
     3369                 v-counter
     3370            tt-doc.fact-date
     3371            tt-doc.fact-time
     3372            tt-doc.loc1
     3373            tt-doc.gds-name
     3374            tt-doc.rvs-type-outside
     3375            tt-doc.state-measure-qnty
     3376            tt-doc.state-level-total
     3377            tt-doc.state-temperature
     3378            tt-doc.state-dencity
     3379            tt-doc.attr_
     3380            sym1  sym2  sym3  sym4  sym5  sym6
     3381            sym7  sym8  sym9  sym10 sym11 sym12
     3382         with frame f-second.
     3383         down stream out-stream 1 with frame f-second
     3384         .
     3385         run r-plc-xl-sheet2-write-line-data in this-procedure (
     3386              input      v-counter
     3387            , input tt-doc.fact-date
     3388            , input tt-doc.fact-time
     3389            , input tt-doc.loc1
     3390            , input tt-doc.gds-name
     3391            , input tt-doc.rvs-type-outside
     3392            , input tt-doc.state-measure-qnty
     3393            , input tt-doc.state-level-total
     3394            , input tt-doc.state-temperature
     3395            , input tt-doc.state-dencity
     3396            , input tt-doc.attr_
     3397         ).
     3398      end.
     3399      IF v-counter <> 0 then do:
     3400         put stream out-stream unformatted fill( "-" , 238 ) skip.
     3401      end.
     3402   end.
     3403   end procedure.
     3404   procedure print-header :
     3405   do
     3406   on error undo, return error
     3407   :
     3408      put stream out-stream
     3409         "ПОКАЗАНИЯ УРОВНЕМЕРА ЗА СМЕНУ" at 25 skip(1)
     3410         "АЗС № " obj-list.obj-type obj-list.obj-code skip
     3411         "Сменный отчет № " X-date-Start X-shift-Alone SKIP
     3412         "Операторы (текущая смена): " v-shift-staff FORMAT "x(100)" skip
     3413         "Операторы (предыдущая смена): " v-shift-staff-prev FORMAT "x(100)" SKIP
     3414         "Дата с " v-date-begin " по " v-date-end FORMAT "x(70)" skip
     3415         "Дата - время передачи смены: "  v-date-rvs-shift FORMAT "x(10)" " " v-time-rvs-shift SKIP(1)
     3416      .
     3417      run r-plc-xl-write-cell-data in this-procedure ( input "objname":U,    input Substitute("&1&2", obj-list.obj-type, obj-list.obj-code) ).
     3418      run r-plc-xl-write-cell-data in this-procedure ( input "rep_num":U,    input Substitute("&1&2", X-date-Start, X-shift-Alone) ).
     3419      run r-plc-xl-write-cell-data in this-procedure ( input "staff":U,      input v-shift-staff ).
     3420      run r-plc-xl-write-cell-data in this-procedure ( input "staff_prev":U, input v-shift-staff-prev ).
     3421      run r-plc-xl-write-cell-data in this-procedure ( input "date_begin":U, input v-date-begin ).
     3422      run r-plc-xl-write-cell-data in this-procedure ( input "date_end":U,   input v-date-end ).
     3423      run r-plc-xl-write-cell-data in this-procedure ( input "f_date":U,     input v-date-rvs-shift ).
     3424      run r-plc-xl-write-cell-data in this-procedure ( input "f_time":U,     input v-time-rvs-shift ).
     3425   end.
     3426   end procedure.
     3427   procedure get-doc-line-attr :
     3428   define input parameter p-doc-code               as character        no-undo.
     3429   define input parameter p-gds-code               as integer          no-undo.
     3430   define input parameter p-attr-code              as character        no-undo.
     3431   define output parameter p-attr-value-character  as character        no-undo.
     3432   define output parameter p-attr-exists           as logical          no-undo.
     3433       define buffer buf_doc-line-attr for ub.doc-line-attr.
     3434   do
     3435   on error undo, return error
     3436   :
     3437       find first buf_doc-line-attr no-lock
     3438            where buf_doc-line-attr.doc-code    = p-doc-code
     3439              and buf_doc-line-attr.gds-code    = p-gds-code
     3440              and buf_doc-line-attr.attr-code   = p-attr-code
     3441       no-error.
     3442       if available buf_doc-line-attr
     3443       then do:
     3444           assign
     3445               p-attr-value-character = buf_doc-line-attr.attr-value
     3446               p-attr-exists          = yes
     3447           .
     3448       end.
     3449       else do:
     3450           assign
     3451               p-attr-exists          = no
     3452           .
     3453       end.
     3454   end.
     3455   end procedure.
     3456   do
     3457      on error  undo , return error return-value
     3458      on endkey undo , return error return-value
     3459      on stop   undo , return error return-value
     3460      :
     3461   define variable v-account as integer init 0 no-undo .
     3462   define variable v-account-lavel as character no-undo .
     3463   define variable v-button-stop as logical no-undo .
     3464   define variable v-kol-spice as integer no-undo .
     3465   define variable v-kol-spice2 as integer no-undo .
     3466   define variable v-kol-spice3 as integer no-undo .
     3467   DEFINE VARIABLE StopProcessing AS LOGICAL NO-UNDO.
     3468   DEFINE BUTTON StopBtn AUTO-END-KEY
     3469        LABEL "Стоп"
     3470        SIZE 10 BY 1.
     3471   DEFINE VARIABLE RecordsDone AS INTEGER FORMAT ">,>>>,>>>,>>9":U INITIAL 0
     3472        LABEL "Обработано записей"
     3473         VIEW-AS TEXT
     3474        SIZE 14 BY .67 NO-UNDO.
     3475   DEFINE VARIABLE RecordsString AS CHARACTER FORMAT "X(60)"
     3476         VIEW-AS TEXT
     3477        SIZE 53.25 BY .67
     3478        FGCOLOR 1  NO-UNDO.
     3479   DEFINE VARIABLE RecordsString2 AS CHARACTER FORMAT "X(60)"
     3480         VIEW-AS TEXT
     3481        SIZE 53.25 BY .67
     3482        FGCOLOR 1  NO-UNDO.
     3483   DEFINE VARIABLE RecordsString3 AS CHARACTER FORMAT "X(60)"
     3484         VIEW-AS TEXT
     3485        SIZE 53.25 BY .67
     3486        FGCOLOR 1  NO-UNDO.
     3487   DEFINE RECTANGLE RECT-1
     3488        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     3489        SIZE 55.13 BY 4.46.
     3490   DEFINE FRAME InfoFrame
     3491        StopBtn AT ROW 4.25 COL 21.75
     3492        RecordsString AT ROW 1.21 COL 2 NO-LABEL
     3493        RecordsString2 AT ROW 1.96 COL 2 NO-LABEL
     3494        RecordsString3 AT ROW 2.58 COL 2 NO-LABEL
     3495        RecordsDone AT ROW 3.42 COL 24.88 COLON-ALIGNED
     3496        RECT-1 AT ROW 1 COL 1
     3497       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     3498            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     3499            TITLE "Процесс"
     3500            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
     3501   define variable mFrameView      as logical   no-undo init yes.
     3502     define variable mFramHandle as handle no-undo.
     3503     mFramHandle = frame InfoFrame:handle.
     3504     if  log-manager:logfile-name ne ?
     3505     then DO:
     3506         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     3507         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     3508         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
     3509     end.
     3510     mFrameView = not session:batch-mode and mFramHandle:visible.
     3511     if mFrameView
     3512     then do:
     3513       ASSIGN
     3514          FRAME InfoFrame:HIDDEN                           = TRUE
     3515          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
     3516     end.
     3517   ON CHOOSE OF StopBtn IN FRAME InfoFrame
     3518   DO:
     3519     IF not StopProcessing THEN
     3520       Message "Вы действительно хотите прервать" SKIP
     3521               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
     3522                 UPDATE StopProcessing.
     3523     IF StopProcessing THEN do:
     3524        if mFrameView
     3525        then do:
     3526           HIDE FRAME InfoFrame.
     3527        end.
     3528     End.
     3529   END.
     3530   assign v-account = ( if integer( 100 ) = 0 then 100 else integer( 100 ) ).
     3531     if  log-manager:logfile-name ne ?
     3532     then DO:
     3533         log-manager:write-message("ON mFrameView=" + string(mFrameView), "frameRepError").
     3534     end.
     3535     if not session:batch-mode then
     3536     do:
     3537       VIEW FRAME InfoFrame.
     3538       mFrameView = true.
     3539     end.
     3540      v-button-stop = false .
     3541         if mFrameView
     3542         then do:
     3543         if v-button-stop then view STOPBTN in frame InfoFrame.
     3544                          else Hide STOPBTN in frame InfoFrame.
     3545         end.
     3546      run fill-doc in this-procedure .
     3547   if session :set-wait-state( "compiler" ) then.
     3548      run get-report-num in my-handle (output g#report-num).
     3549   output stream out-stream to value( string( session:temp-directory +
     3550                                        "rpt" + string( g#report-num ) ) )
     3551                                        page-size  value(43) .
     3552      RUN r-plc-xl-init IN THIS-PROCEDURE.
     3553      RUN print-header IN THIS-PROCEDURE .
     3554      run print-body in this-procedure .
     3555      output stream out-stream close.
     3556      RUN r-plc-xl-close IN THIS-PROCEDURE .
     3557   if mFrameView
     3558   then do:
     3559      HIDE FRAME InfoFrame.
     3560   end.
     3561      os-delete value( string( session:temp-directory ) + "rpt" + string( g#report-num ) + ".txl" )  .
     3562      os-rename
     3563         value( string( session:temp-directory ) + "$" + string( g#report-num ) + ".txl" )
     3564         value( string( session:temp-directory ) + "rpt" + string( g#report-num ) + ".txl" )
     3565      .
     3566      define variable v-user-action   as character no-undo .
     3567      define variable v-printed       as logical   no-undo .
     3568      run gbl/prnfilen.w
     3569            ( input  ""
     3570            , input  8
     3571            , input  string(session :temp-directory) + "rpt" + string( g#report-num )
     3572            , input  ReportFontNum
     3573            , output v-user-action
     3574            , output v-printed
     3575            ) .
     3576      os-delete value( string( session:temp-directory ) + "rpt" + string( g#report-num ) + ".txl" )  .
     3577      empty temp-table tt-doc.
     3578   if session :set-wait-state( "" ) then.
     3579   END.
