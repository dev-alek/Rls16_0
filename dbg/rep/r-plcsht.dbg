     2813                                           , v-autoent-name
     2814                                           , v-car-num
     2815                                           , v-fio
     2816                                           , STRING(buf_doc-line.doc-density, ">9.9999")
     2817                                           , STRING(buf_doc-line.temperature, "->9.99")
     2818                                           , buf_doc-line.doc-qnty * buf_doc-line.doc-density
     2819                                           , buf_doc-line.doc-qnty
     2820                                           )
     2821                     .
     2822                     release buf_doc-line.
     2823                  end.
     2824                  create tt-doc.
     2825                  assign
     2826                     tt-doc.rvs-code           = buf_rvs-line.rvs-code
     2827                     tt-doc.obj-type           = buf_rvs-line.obj-type
     2828                     tt-doc.obj-code           = buf_rvs-line.obj-code
     2829                     tt-doc.pl-code            = buf_rvs-line.pl-code
     2830                     tt-doc.gds-code           = buf_rvs-line.gds-code
     2831                     tt-doc.shift-date         = buf_rvs-doc.shift-date
     2832                     tt-doc.shift-num          = buf_rvs-doc.shift-num
     2833                     tt-doc.status_            = buf_rvs-doc.status_
