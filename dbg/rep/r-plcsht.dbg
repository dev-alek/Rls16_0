     1612   procedure lineattr-write-add-line-cli :
     1613   define input  parameter p-doc-code      like  ub.doc-line-attr.doc-code   no-undo .
     1614   define input  parameter p-gds-code      like  ub.doc-line-attr.gds-code   no-undo .
     1615   define input  parameter p-cli-type      as character no-undo .
     1616   define input  parameter p-cli-code      as integer   no-undo .
     1617   define input  parameter p-contract-code as integer   no-undo .
     1618   define input  parameter p-host-code     as integer   no-undo .
     1619   define input  parameter p-exch-code     as integer   no-undo .
     1620   define input  parameter p-exch-rate     as decimal   no-undo .
     1621   define input  parameter p-exch-scale    as integer   no-undo .
     1622   define input  parameter p-sum-cli       as decimal   no-undo .
     1623   define input  parameter p-sum-vat       as decimal   no-undo .
     1624   define buffer buf_doc-line-attr for ub.doc-line-attr .
     1625     do
     1626     on error undo, return error return-value
     1627     :
     1628       find first buf_doc-line-attr exclusive-lock
     1629         where buf_doc-line-attr.doc-code  = p-doc-code
     1630           and buf_doc-line-attr.gds-code  = p-gds-code
     1631           and buf_doc-line-attr.attr-code = 'add-line-cli':U +
     1632                                             chr(4) + p-cli-type +
     1633                                             chr(4) + string(p-cli-code) +
     1634                                             chr(4) + string(p-contract-code) +
     1635                                             chr(4) + string(p-host-code)
     1636         no-error .
     1637       if not available buf_doc-line-attr then do:
     1638         create buf_doc-line-attr .
     1639         assign
     1640           buf_doc-line-attr.doc-code  = p-doc-code
     1641           buf_doc-line-attr.gds-code  = p-gds-code
     1642           buf_doc-line-attr.attr-code = 'add-line-cli':U  +
     1643                                         chr(4) + p-cli-type +
     1644                                         chr(4) + string(p-cli-code) +
     1645                                         chr(4) + string(p-contract-code) +
     1646                                         chr(4) + string(p-host-code)
     1647         .
     1648       end.
     1649       assign
     1650         buf_doc-line-attr.attr-value =
     1651         string(p-exch-code)  + chr(4) +
     1652         string(p-exch-rate)  + chr(4) +
     1653         string(p-exch-scale) + chr(4) +
     1654         string(p-sum-cli)    + chr(4) +
     1655         string(p-sum-vat)
     1656         .
     1657     end.
     1658   end procedure.
     1659   procedure lineattr-value-add-line-cli :
     1660   define input   parameter p-doc-code      like  ub.doc-line-attr.doc-code   no-undo .
     1661   define input   parameter p-gds-code      like  ub.doc-line-attr.gds-code   no-undo .
     1662   define input   parameter p-cli-type      as character no-undo .
     1663   define input   parameter p-cli-code      as integer   no-undo .
     1664   define input   parameter p-contract-code as integer   no-undo .
     1665   define input   parameter p-host-code     as integer   no-undo .
     1666   define output  parameter p-exch-code     as integer   no-undo .
     1667   define output  parameter p-exch-rate     as decimal   no-undo .
     1668   define output  parameter p-exch-scale    as integer   no-undo .
     1669   define output  parameter p-sum-cli       as decimal   no-undo .
     1670   define output  parameter p-sum-vat       as decimal   no-undo .
     1671   define buffer buf_doc-line-attr for ub.doc-line-attr .
     1672     do
     1673     on error undo, return error return-value
     1674     :
     1675       find first buf_doc-line-attr exclusive-lock
     1676         where buf_doc-line-attr.doc-code  = p-doc-code
     1677           and buf_doc-line-attr.gds-code  = p-gds-code
     1678           and buf_doc-line-attr.attr-code = 'add-line-cli':U +
     1679                                             chr(4) + p-cli-type +
     1680                                             chr(4) + string(p-cli-code) +
     1681                                             chr(4) + string(p-contract-code) +
     1682                                             chr(4) + string(p-host-code)
     1683         no-error .
     1684       if available buf_doc-line-attr then do:
     1685        assign
     1686           p-exch-code  = integer ( entry (1 , buf_doc-line-attr.attr-value,  chr(4) ))
     1687           p-exch-rate  = decimal ( entry (2 , buf_doc-line-attr.attr-value, chr(4) ))
     1688           p-exch-scale = integer ( entry (3 , buf_doc-line-attr.attr-value, chr(4) ))
     1689           p-sum-cli    = decimal ( entry (4 , buf_doc-line-attr.attr-value, chr(4) ))
     1690           p-sum-vat    = decimal ( entry (5 , buf_doc-line-attr.attr-value, chr(4) ))
     1691          .
     1692        end.
     1693     end.
     1694   end procedure.
     1695   function lineattr-get-reason returns character ( buffer local-doc-line for ub.doc-line ) :
     1696     define variable v-code as character no-undo .
     1697     define variable v-type as character no-undo .
     1698     define variable v-gds-code as integer   no-undo .
     1699   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1700   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
     1701     (input  local-doc-line.artic
     1702     ,input  local-doc-line.prod-type
     1703     ,input  local-doc-line.prod-code
     1704     ,output v-gds-code
