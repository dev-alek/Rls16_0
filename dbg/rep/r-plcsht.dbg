     3247                     tt-doc.fact-date          = buf_rvs-doc.fact-date
     3248                     tt-doc.fact-time          = STRING(buf_rvs-doc.fact-time, "HH:MM:SS")
     3249                     tt-doc.gds-name           = buf_goods.gds-name
