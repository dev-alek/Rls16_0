     2871               end.
     2872            end.
     2873         end.
     2874      end.
     2875      else do:
     2876         IF v-fact-order-begin = ?
     2877         then do:
     2878            for each  buf_rvs-doc
     2879               where buf_rvs-doc.obj-type     = obj-list.obj-type
     2880                  and buf_rvs-doc.obj-code     = obj-list.obj-code
     2881                  AND buf_rvs-doc.status_      = 'факт':U
     2882                  AND buf_rvs-doc.fact-order  <= v-fact-order-end
     2883               no-lock
     2884               :
     2885   define variable vss-include-info18 as character format "X(65)" no-undo
     2886   initial "@(#)$Workfile$ $Revision$".
     2887               IF (buf_rvs-doc.rvs-type = 'после_док':U
     2888               OR  buf_rvs-doc.rvs-type = 'перед_док':U)
     2889               then do:
     2890                  find first buf_trn-doc
     2891                       where buf_trn-doc.doc-code = buf_rvs-doc.out-code
     2892                       no-lock
     2893                       .
     2894                  v-attr = "".
