     1949           , input "":U
     1950       ).
     1951       run r-plc-xl-write-cell-data in this-procedure (
     1952             input "Контроль_subtotalType":U
     1953           , input "":U
     1954       ).
     1955       run r-plc-xl-write-cell-data in this-procedure (
     1956             input "Сверки_valutCode":U
     1957           , input "0":U
     1958       ).
     1959       run r-plc-xl-write-cell-data in this-procedure (
     1960             input "Сверки_columnList":U
     1961           , input "counter,fact_date,fact_time,loc1,gds_name,rvs_type_outside,state_measure_qnty,state_level_total,state_temperature,state_dencity,attr_":U
     1962       ).
     1963       run r-plc-xl-write-cell-data in this-procedure (
     1964             input "Сверки_columnType":U
     1965           , input "S,S,S,S,S,S,S,S,S,S,S,S":U
     1966       ).
     1967       run r-plc-xl-write-cell-data in this-procedure (
     1968             input "Сверки_subtotalList":U
     1969           , input "":U
     1970       ).
     1971       run r-plc-xl-write-cell-data in this-procedure (
     1972             input "Сверки_subtotalType":U
     1973           , input "":U
     1974       ).
     1975   end.
     1976   end procedure.
     1977   procedure r-plc-xl-sheet1-write-line-data :
     1978   define input parameter p-loc1                 as character        no-undo.
     1979   define input parameter p-state-measure-qnty   as character        no-undo.
     1980   define input parameter p-state-level-total    as character        no-undo.
     1981   define input parameter p-state-temperature    as character        no-undo.
     1982   define input parameter p-state-dencity        as character        no-undo.
     1983   define input parameter p-average-dencity      as character        no-undo.
     1984   define buffer buf_temp_sheet1_line-data        for temp_sheet1_line-data.
     1985   do
     1986   for buf_temp_sheet1_line-data
     1987   on error undo, return error
     1988   :
     1989       for each buf_temp_sheet1_line-data
     1990       :
     1991           delete buf_temp_sheet1_line-data.
     1992       end.
     1993       create buf_temp_sheet1_line-data.
     1994       assign
     1995           v-r-plc-xl-sheet1-cur-data-row = v-r-plc-xl-sheet1-cur-data-row + 1
     1996       .
     1997       assign
     1998           buf_temp_sheet1_line-data.sheet-name          = "Контроль":U
     1999           buf_temp_sheet1_line-data.xl-line-id          = v-r-plc-xl-sheet1-cur-data-row
     2000           buf_temp_sheet1_line-data.loc1                = p-loc1
     2001           buf_temp_sheet1_line-data.state-measure-qnty  = p-state-measure-qnty
     2002           buf_temp_sheet1_line-data.state-level-total   = p-state-level-total
     2003           buf_temp_sheet1_line-data.state-temperature   = p-state-temperature
     2004           buf_temp_sheet1_line-data.state-dencity       = p-state-dencity
     2005           buf_temp_sheet1_line-data.average-dencity     = p-average-dencity
     2006       .
     2007       put stream excel-line unformatted
     2008                           buf_temp_sheet1_line-data.sheet-name
     2009           CHR(9)   "LD":U
     2010           CHR(9)   buf_temp_sheet1_line-data.loc1
     2011           CHR(9)   buf_temp_sheet1_line-data.state-measure-qnty
     2012           CHR(9)   buf_temp_sheet1_line-data.state-level-total
     2013           CHR(9)   buf_temp_sheet1_line-data.state-temperature
     2014           CHR(9)   buf_temp_sheet1_line-data.state-dencity
     2015           CHR(9)   buf_temp_sheet1_line-data.average-dencity
     2016           chr(10)
     2017       .
     2018   end.
     2019   end procedure.
     2020   procedure r-plc-xl-sheet2-write-line-data :
     2021   define input parameter p-counter               as character        no-undo.
     2022   define input parameter p-fact-date             as character        no-undo.
     2023   define input parameter p-fact-time             as character        no-undo.
     2024   define input parameter p-loc1                  as character        no-undo.
     2025   define input parameter p-gds-name              as character        no-undo.
     2026   define input parameter p-rvs-type-outside      as character        no-undo.
     2027   define input parameter p-state-measure-qnty    as character        no-undo.
     2028   define input parameter p-state-level-total     as character        no-undo.
     2029   define input parameter p-state-temperature     as character        no-undo.
     2030   define input parameter p-state-dencity         as character        no-undo.
     2031   define input parameter p-attr_                 as character        no-undo.
     2032       define buffer buf_temp_sheet2_line-data        for temp_sheet2_line-data.
     2033   do
     2034   for buf_temp_sheet2_line-data
     2035   on error undo, return error
     2036   :
     2037       for each buf_temp_sheet2_line-data
     2038       :
     2039           delete buf_temp_sheet2_line-data.
     2040       end.
     2041       create buf_temp_sheet2_line-data.
     2042       assign
     2043           v-r-plc-xl-sheet2-cur-data-row = v-r-plc-xl-sheet2-cur-data-row + 1
     2044       .
     2045       assign
     2046           buf_temp_sheet2_line-data.sheet-name          = "Сверки":U
     2047           buf_temp_sheet2_line-data.xl-line-id          = v-r-plc-xl-sheet2-cur-data-row
     2048           buf_temp_sheet2_line-data.counter             = p-counter
     2049           buf_temp_sheet2_line-data.fact-date           = p-fact-date
     2050           buf_temp_sheet2_line-data.fact-time           = p-fact-time
     2051           buf_temp_sheet2_line-data.loc1                = p-loc1
     2052           buf_temp_sheet2_line-data.gds-name            = p-gds-name
     2053           buf_temp_sheet2_line-data.rvs-type-outside    = p-rvs-type-outside
     2054           buf_temp_sheet2_line-data.state-measure-qnty  = p-state-measure-qnty
     2055           buf_temp_sheet2_line-data.state-level-total   = p-state-level-total
     2056           buf_temp_sheet2_line-data.state-temperature   = p-state-temperature
     2057           buf_temp_sheet2_line-data.state-dencity       = p-state-dencity
     2058           buf_temp_sheet2_line-data.attr_               = p-attr_
     2059       .
     2060       put stream excel-line unformatted
     2061                           buf_temp_sheet2_line-data.sheet-name
     2062           CHR(9)   "LD":U
     2063           CHR(9)   buf_temp_sheet2_line-data.counter
     2064           CHR(9)   buf_temp_sheet2_line-data.fact-date
     2065           CHR(9)   buf_temp_sheet2_line-data.fact-time
     2066           CHR(9)   buf_temp_sheet2_line-data.loc1
     2067           CHR(9)   buf_temp_sheet2_line-data.gds-name
     2068           CHR(9)   buf_temp_sheet2_line-data.rvs-type-outside
     2069           CHR(9)   buf_temp_sheet2_line-data.state-measure-qnty
     2070           CHR(9)   buf_temp_sheet2_line-data.state-level-total
     2071           CHR(9)   buf_temp_sheet2_line-data.state-temperature
     2072           CHR(9)   buf_temp_sheet2_line-data.state-dencity
     2073           CHR(9)   buf_temp_sheet2_line-data.attr_
     2074           chr(10)
     2075       .
     2076   end.
     2077   end procedure.
     2078   procedure r-plc-xl-write-cell-data :
     2079   define input parameter p-data-key   as character        no-undo.
     2080   define input parameter p-data-value as character        no-undo.
     2081       define buffer buf_temp_cell-data     for temp_cell-data.
     2082   do
     2083   for buf_temp_cell-data
     2084   on error undo, return error
     2085   :
     2086       find first buf_temp_cell-data
     2087            where buf_temp_cell-data.data-key = p-data-key
     2088       no-error.
     2089       if not available buf_temp_cell-data
     2090       then do:
     2091           create buf_temp_cell-data.
     2092           assign
     2093               buf_temp_cell-data.data-key = p-data-key
     2094           .
     2095       end.
     2096       assign
     2097           buf_temp_cell-data.data-value = p-data-value
     2098       .
     2099       put stream excel-cell unformatted
     2100                           buf_temp_cell-data.data-key
     2101           CHR(9)   buf_temp_cell-data.data-value
     2102           chr(10)
     2103       .
     2104   end.
     2105   end procedure.
     2106   procedure r-plc-xl-run-excel :
     2107   define input parameter p-header-filename    as character        no-undo.
     2108   define input parameter p-data-filename      as character        no-undo.
     2109       define variable v-template-file-name    as character    no-undo.
     2110       define variable v-vb-file-name          as character    no-undo.
     2111       define buffer buf_temp-param for temp-param .
     2112   do
     2113   for buf_temp-param
     2114   on error undo, return error
     2115   :
     2116       create buf_temp-param.
     2117       assign
     2118           v-template-file-name    = search( "exe/plcsht.xlt" )
     2119           v-vb-file-name          = search( "exe/t_form.bas")
     2120       .
     2121       if v-template-file-name = ?
     2122       or v-template-file-name = "":U
     2123       then do:
     2124           message
     2125               "Ошибка имени файла шаблона."
     2126           view-as alert-box error.
     2127       end.
     2128       if v-vb-file-name = ?
     2129       or v-vb-file-name = "":U
     2130       then do:
     2131           message
     2132               "Ошибка имени файла кода обработки."
     2133           view-as alert-box error.
     2134       end.
     2135       run paramls-write in this-procedure (
     2136             input "template":U
     2137           , input "template-file-name":U
     2138           , input v-template-file-name
     2139       ).
     2140       run paramls-write in this-procedure (
     2141             input "template":U
     2142           , input "vb-file-name":U
     2143           , input v-vb-file-name
     2144       ).
     2145       run paramls-write in this-procedure (
     2146             input "data":U
     2147           , input "data-header-filename":U
     2148           , input p-header-filename
     2149       ).
     2150       run paramls-write in this-procedure (
     2151             input "data":U
     2152           , input "data-filename":U
     2153           , input p-data-filename
     2154       ).
     2155       run gbl/macroxlt.p (
     2156           input-output table buf_temp-param
     2157       ) no-error.
     2158       if error-status :error
     2159       then do:
     2160           message
     2161                    vss-workfile vss-revision vss-description
     2162               skip(1)
     2163               skip "Ошибка создания файла Excel."
     2164               skip return-value
     2165               skip trim(error-status :get-message(1))
     2166                    trim(error-status :get-message(2))
     2167                    trim(error-status :get-message(3))
     2168           view-as alert-box error.
     2169           undo, return error .
     2170       end.
     2171   end.
     2172   end procedure.
     2173   procedure r-plc-xl-close :
     2174   do
     2175   on error undo, return error
     2176   :
     2177       output stream excel-line close.
     2178       output stream excel-cell close.
     2179       output to value( string( session:temp-directory + "$" + string( g#report-num ) ) + ".txl" ) append.
     2180           export "exe/plcsht.xlt":U.
     2181           export "exe/t_form.bas":U.
     2182           export v-r-plc-xl-cell-file-name.
     2183           export v-r-plc-xl-data-file-name.
     2184       output close.
     2185   end.
     2186   end procedure.
     2187   define temp-table tt-doc no-undo
     2188     field rvs-code           like ub.rvs-line.rvs-code
     2189     FIELD obj-type           like ub.rvs-line.obj-type
     2190     FIELD obj-code           like ub.rvs-line.obj-code
     2191     field pl-code            like ub.rvs-line.pl-code
     2192     field gds-code           like ub.rvs-line.gds-code
     2193     FIELD shift-date         like ub.rvs-doc.shift-date
     2194     FIELD shift-num          like ub.rvs-doc.shift-num
     2195     FIELD status_            like ub.rvs-doc.status_
     2196     FIELD fact-order         like ub.rvs-doc.fact-order
     2197     field loc1               like ub.place.loc1
     2198     field state-measure-qnty like ub.rvs-line.state-measure-qnty
     2199     field state-temperature  like ub.rvs-line.state-temperature
     2200     field state-dencity      like ub.rvs-line.state-density
     2201     field average-dencity    as decimal format ">9.9999"
     2202     FIELD fact-date          like ub.rvs-doc.fact-date
     2203     FIELD fact-time          as character
     2204     field gds-name           like ub.goods.gds-name
     2205     field rvs-type           like ub.rvs-doc.rvs-type
     2206     field rvs-type-outside   like ub.rvs-doc.rvs-type
     2207     field state-level-total  like ub.rvs-line.state-level-total
     2208     field attr_              as character
     2209   index by-line as primary unique
     2210         rvs-code
     2211         obj-type
     2212         obj-code
     2213         pl-code
     2214         gds-code
     2215   index by-type
     2216         rvs-type
     2217         loc1
     2218         gds-code
     2219   index by-date
     2220         rvs-type
     2221         fact-date
     2222         fact-time
     2223         loc1
     2224         gds-name
     2225   index by-pl
     2226         pl-code
     2227         gds-code
     2228   .
     2229     output to value( string( session:temp-directory + "$" + string( g#report-num ) ) + ".txl" ) .
     2230     output close.
     2231   define variable v-counter    as integer  FORMAT ">>9"    no-undo.
     2232   define variable v-fact-order-start        as decimal              no-undo .
     2233   define variable v-fact-order-end          as decimal              no-undo .
     2234   DEFINE VARIABLE sym1  AS CHARACTER NO-UNDO FORMAT "x(1)":U INITIAL "|":U .
     2235   DEFINE VARIABLE sym2  AS CHARACTER NO-UNDO FORMAT "x(1)":U INITIAL "|":U .
     2236   DEFINE VARIABLE sym3  AS CHARACTER NO-UNDO FORMAT "x(1)":U INITIAL "|":U .
     2237   DEFINE VARIABLE sym4  AS CHARACTER NO-UNDO FORMAT "x(1)":U INITIAL "|":U .
     2238   DEFINE VARIABLE sym5  AS CHARACTER NO-UNDO FORMAT "x(1)":U INITIAL "|":U .
     2239   DEFINE VARIABLE sym6  AS CHARACTER NO-UNDO FORMAT "x(1)":U INITIAL "|":U .
     2240   DEFINE VARIABLE sym7  AS CHARACTER NO-UNDO FORMAT "x(1)":U INITIAL "|":U .
     2241   DEFINE VARIABLE sym8  AS CHARACTER NO-UNDO FORMAT "x(1)":U INITIAL "|":U .
     2242   DEFINE VARIABLE sym9  AS CHARACTER NO-UNDO FORMAT "x(1)":U INITIAL "|":U .
     2243   DEFINE VARIABLE sym10 AS CHARACTER NO-UNDO FORMAT "x(1)":U INITIAL "|":U .
     2244   DEFINE VARIABLE sym11 AS CHARACTER NO-UNDO FORMAT "x(1)":U INITIAL "|":U .
     2245   DEFINE VARIABLE sym12 AS CHARACTER NO-UNDO FORMAT "x(1)":U INITIAL "|":U .
     2246   define variable v-line    as character    no-undo.
     2247   define variable v-date-begin       as character          no-undo.
     2248   define variable v-date-end         as character          no-undo.
     2249   define variable v-shift-staff      as character    no-undo.
     2250   define variable v-shift-staff-prev as character    no-undo.
     2251   define variable v-date-rvs-shift   as character     no-undo.
     2252   define variable v-time-rvs-shift   as character     no-undo.
     2253   DEFINE STREAM out-stream.
     2254     define frame f-first
     2255       sym1                      no-label format "X(1)"       space(0)
     2256       tt-doc.loc1               no-label format "X(8)"       space(0)
     2257       sym2                      no-label format "X(1)"       space(0)
     2258       tt-doc.state-measure-qnty no-label format "->>,>>9.99" space(0)
     2259       sym3                      no-label format "X(1)"       space(0)
     2260       tt-doc.state-level-total  no-label format "->>>9.99"   space(0)
     2261       sym4                      no-label format "X(1)"       space(0)
     2262       tt-doc.state-temperature  no-label format "->>9.99"    space(0)
     2263       sym5                      no-label format "X(1)"       space(0)
     2264       tt-doc.state-dencity      no-label format ">9.9999"    space(0)
     2265       sym6                      no-label format "X(1)"       space(0)
     2266       tt-doc.average-dencity    no-label format ">9.9999"    space(0)
     2267       sym7                      no-label format "X(1)"       space(0)
     2268     header
     2269       "+--------+----------+--------+-------+-------+-------+" skip
     2270       "|    №   |  объем   | высота | темпе | Плот- | Плот- |" skip
     2271       "| резер- |   (л)    | взлива | рату- | ность | ность |" skip
     2272       "| вуара  |          |  (см)  | ра    |       | сред- |" skip
     2273       "|        |          |        |  (С)  |       | няя   |" skip
     2274     with width 54 down stream-io no-labels no-box.
     2275     define frame f-second
     2276       sym1                      no-label format "X(1)"       space(0)
     2277       v-counter                 no-label format ">>9"        space(0)
     2278       sym2                      no-label format "X(1)"       space(0)
     2279       tt-doc.fact-date          no-label format "99/99/99"   space(0)
     2280       sym3                      no-label format "X(1)"       space(0)
     2281       tt-doc.fact-time          no-label format "X(8)"       space(0)
     2282       sym4                      no-label format "X(1)"       space(0)
     2283       tt-doc.loc1               no-label format "x(8)"       space(0)
     2284       sym5                      no-label format "X(1)"       space(0)
     2285       tt-doc.gds-name           no-label format "x(10)"      space(0)
     2286       sym6                      no-label format "X(1)"       space(0)
     2287       tt-doc.rvs-type-outside   no-label format "x(10)"      space(0)
     2288       sym7                      no-label format "X(1)"       space(0)
     2289       tt-doc.state-measure-qnty no-label format "->>,>>9.99" space(0)
     2290       sym8                      no-label format "X(1)"       space(0)
     2291       tt-doc.state-level-total  no-label format "->>9.99"    space(0)
     2292       sym9                      no-label format "X(1)"       space(0)
     2293       tt-doc.state-temperature  no-label format "->9.99"     space(0)
     2294       sym10                     no-label format "X(1)"       space(0)
     2295       tt-doc.state-dencity      no-label format "9.9999"     space(0)
     2296       sym11                     no-label format "X(1)"       space(0)
     2297       tt-doc.attr_              no-label format "x(150)"     space(0)
     2298       sym12                     no-label format "X(1)"       space(0)
     2299     header
     2300       "+---+--------+--------+--------+----------+----------+----------+-------+------+------+------------------------------------------------------------------------------------------------------------------------------------------------------+" SKIP
     2301       "|   |        |        |   №    |          | расшиф-  |          | Высота| Тем- | Плот-|     Данные ТТН Компания - перевозчик, № а/м,                                                                                                         |" SKIP
     2302       "|   |        |        | резер- |   вид    | ровка    |   Объем  | взлива| пера-| ность|       ФИО водителя, плотность, температура,                                                                                                          |" SKIP
     2303       "| № | Дата   | Время  | вуара  | топлива  | показа-  |    (л)   |  (см) | тура |      |              масса, объем (по ТТН)                                                                                                                   |" SKIP
     2304       "|   |        |        |        |          | ний      |          |       |  (С) |      |                                                                                                                                                      |" SKIP
     2305     with width 240 down stream-io no-labels no-box.
     2306   procedure prev-shift :
     2307   define input parameter p-obj-type   like  ub.rvs-doc.obj-type no-undo .
     2308   define input parameter p-obj-code   like  ub.rvs-doc.obj-code no-undo .
     2309   define input parameter p-shift-date like  ub.rvs-doc.shift-date no-undo .
     2310   define input parameter p-shift-num  like  ub.rvs-doc.shift-num no-undo .
     2311   define output parameter p-fact-order like ub.rvs-doc.fact-order init ? no-undo .
     2312   define buffer prev_shift-obj  for ub.shift-obj .
     2313   define buffer prev_rvs-doc    for ub.rvs-doc .
     2314   define buffer buf_shift-staff for ub.shift-staff.
     2315   do
     2316   on error undo, return error
     2317   :
     2318      find last  prev_shift-obj
     2319           where prev_shift-obj.obj-type = p-obj-type
     2320             and prev_shift-obj.obj-code = p-obj-code
     2321             and prev_shift-obj.status_  = 'зкр':U
     2322             and ( prev_shift-obj.shift-date < p-shift-date
     2323                   or
     2324                  ( prev_shift-obj.shift-date = p-shift-date
     2325                    and
     2326                    prev_shift-obj.shift-num  < p-shift-num
     2327                  )
     2328                 )
     2329      use-index stts
     2330      no-lock
     2331      no-error.
     2332      if available prev_shift-obj then do:
     2333         FOR each  buf_shift-staff
     2334            where buf_shift-staff.obj-type    = prev_shift-obj.obj-type
     2335               and buf_shift-staff.obj-code   = prev_shift-obj.obj-code
     2336               and buf_shift-staff.shift-date = prev_shift-obj.shift-date
     2337               and buf_shift-staff.shift-num  = prev_shift-obj.shift-num
     2338               and buf_shift-staff.psn-num   >= 0
     2339               no-lock
     2340               :
     2341            assign
     2342               v-shift-staff-prev = v-shift-staff-prev + ", " + buf_shift-staff.name
     2343            .
     2344         end.
     2345         assign
     2346            v-shift-staff-prev = TRIM(v-shift-staff-prev, ",")
     2347         .
     2348         find first prev_rvs-doc
     2349            where prev_rvs-doc.obj-type    = prev_shift-obj.obj-type
     2350               and prev_rvs-doc.obj-code   = prev_shift-obj.obj-code
     2351               and prev_rvs-doc.shift-date = prev_shift-obj.shift-date
     2352               and prev_rvs-doc.shift-num  = prev_shift-obj.shift-num
     2353               and prev_rvs-doc.status_    = 'факт':U
     2354               and prev_rvs-doc.rvs-type   = 'смена':U
     2355            no-lock
     2356            no-error.
     2357         if available prev_rvs-doc then do:
     2358            assign
     2359               p-fact-order = prev_rvs-doc.fact-order
     2360            .
     2361         end.
     2362      end.
     2363   end.
     2364   end procedure.
     2365   procedure fill-doc :
     2366   define buffer buf_rvs-line    for ub.rvs-line .
     2367   define buffer buf_rvs-doc     for ub.rvs-doc  .
     2368   define buffer buf_place       for ub.place .
     2369   define buffer buf_goods       for ub.goods .
     2370   define buffer buf_trn-doc     for ub.trn-doc .
     2371   define buffer buf_doc-line    for ub.doc-line.
     2372   define buffer buf_clients     for ub.clients.
     2373   define buffer buf_tt-doc      for tt-doc.
     2374   define buffer buf_shift-staff for ub.shift-staff.
     2375   define buffer buf_shift-obj   for ub.shift-obj.
     2376   define variable v-coordl    as character    no-undo .
     2377   define variable v-attr      as character    no-undo .
     2378   define variable v-pl-code   as integer      no-undo.
     2379   define variable v-fact-order-begin like ub.rvs-doc.fact-order init ? no-undo .
     2380   define variable v-fact-order-end   like ub.rvs-doc.fact-order init ? no-undo .
     2381   define variable v-density-av    as decimal      no-undo.
     2382   DEFINE VARIABLE v-type         AS CHARACTER NO-UNDO.
     2383   DEFINE VARIABLE v-autoent-code AS CHARACTER NO-UNDO.
     2384   DEFINE VARIABLE v-autoent-type AS CHARACTER NO-UNDO.
     2385   DEFINE VARIABLE v-car-num      AS CHARACTER NO-UNDO.
     2386   DEFINE VARIABLE v-fio          AS CHARACTER NO-UNDO.
     2387   define variable v-autoent-name as character no-undo.
     2388   DEFINE VARIABLE v-exist AS LOGICAL   NO-UNDO.
     2389   define variable v-loc    as character    no-undo.
     2390   do
     2391   on error undo, return error
     2392   :
     2393      find first obj-list
     2394           no-lock
     2395           no-error
     2396           .
     2397      if not available obj-list then do:
     2398         message
     2399            "Не определен объект для формирования отчета"
     2400         view-as alert-box information .
     2401         return error.
     2402      end.
     2403      find first buf_rvs-doc
     2404            where  buf_rvs-doc.obj-type   = obj-list.obj-type
     2405               and buf_rvs-doc.obj-code   = obj-list.obj-code
     2406               and buf_rvs-doc.shift-date = X-date-Start
     2407               and buf_rvs-doc.shift-num  = X-shift-Alone
     2408               and buf_rvs-doc.status_    = 'факт':U
     2409               and   buf_rvs-doc.rvs-type   = 'смена':U
     2410            no-lock
     2411            no-error
     2412            .
     2413      IF available buf_rvs-doc then do:
     2414         assign
     2415            v-fact-order-end = buf_rvs-doc.fact-order
     2416            v-date-rvs-shift = STRING(buf_rvs-doc.fact-date, "99/99/99")
     2417            v-time-rvs-shift = STRING(buf_rvs-doc.fact-time, "HH:MM:SS")
     2418         .
     2419      end.
     2420      ELSE do:
     2421         assign
     2422            v-date-rvs-shift = "Не закрыта"
     2423         .
     2424      end.
     2425      find first buf_shift-obj
     2426           where buf_shift-obj.obj-type   = obj-list.obj-type
     2427             and buf_shift-obj.obj-code   = obj-list.obj-code
     2428             and buf_shift-obj.shift-date = X-date-Start
     2429             and buf_shift-obj.shift-num  = X-shift-Alone
     2430      no-lock
     2431      no-error
     2432      .
     2433      IF NOT AVAILABLE buf_shift-obj then do:
     2434         MESSAGE SUBSTITUTE("Неправильно выбрана смена: &1, &2, &3, &4",
     2435                  X-shift-Alone
     2436                  , X-date-Start
     2437                  , obj-list.obj-type
     2438                  , obj-list.obj-code
     2439                  )
     2440         view-as alert-box error         .
     2441         return error.
     2442      end.
     2443      Assign
     2444         v-date-begin = IF buf_shift-obj.open-date = ?  then "Не открыта" else STRING(buf_shift-obj.open-date,  "99/99/99")
     2445         v-date-end   = IF buf_shift-obj.close-date = ? then "Не закрыта" else STRING(buf_shift-obj.close-date, "99/99/99")
     2446      .
     2447      FOR each  buf_shift-staff
     2448          where buf_shift-staff.obj-type   = obj-list.obj-type
     2449            and buf_shift-staff.obj-code   = obj-list.obj-code
     2450            and buf_shift-staff.shift-date = X-date-Start
     2451            and buf_shift-staff.shift-num  = X-shift-Alone
     2452            and buf_shift-staff.psn-num       >= 0
     2453          no-lock
     2454          :
     2455          assign
     2456            v-shift-staff = v-shift-staff + ", " + buf_shift-staff.name
     2457          .
     2458      end.
     2459      assign
     2460         v-shift-staff = TRIM(v-shift-staff, ",")
     2461      .
     2462      run prev-shift in this-procedure ( input  obj-list.obj-type
     2463                                       , input  obj-list.obj-code
     2464                                       , input  X-date-Start
     2465                                       , input  X-shift-Alone
     2466                                       , output v-fact-order-begin
     2467                                       ) .
     2468      IF v-fact-order-end = ?
     2469      then do:
     2470         IF v-fact-order-begin = ?
     2471         then do:
     2472            for each  buf_rvs-doc
     2473               where buf_rvs-doc.obj-type     = obj-list.obj-type
     2474                  and buf_rvs-doc.obj-code     = obj-list.obj-code
     2475                  AND buf_rvs-doc.status_      = 'факт':U
     2476               no-lock
     2477               :
     2478   define variable vss-include-info16 as character format "X(65)" no-undo
     2479   initial "@(#)$Workfile$ $Revision$".
     2480               IF (buf_rvs-doc.rvs-type = 'после_док':U
     2481               OR  buf_rvs-doc.rvs-type = 'перед_док':U)
     2482               then do:
     2483                  find first buf_trn-doc
     2484                       where buf_trn-doc.doc-code = buf_rvs-doc.out-code
     2485                       no-lock
     2486                       .
     2487                  v-attr = "".
     2488               end.
     2489               FOR each  buf_rvs-line
     2490               where buf_rvs-line.rvs-code = buf_rvs-doc.rvs-code
     2491               no-lock
     2492               :
     2493                  find first buf_place
     2494                        where buf_place.obj-type = buf_rvs-doc.obj-type
     2495                        and buf_place.obj-code = buf_rvs-doc.obj-code
     2496                        and buf_place.pl-code  = buf_rvs-line.pl-code
     2497                        no-lock
     2498                        no-error
     2499                        .
     2500                  if available buf_place then do:
     2501                     assign
     2502                        v-loc = buf_place.loc1
     2503                     .
     2504                  end.
     2505                  else do:
     2506                     assign
     2507                        v-loc = "Не найден"
     2508                     .
     2509                  end.
     2510                  find first buf_goods
     2511                     where buf_goods.gds-code = buf_rvs-line.gds-code
     2512                     no-lock
     2513                     .
     2514                  if  available buf_trn-doc
     2515                  AND (buf_rvs-doc.rvs-type = 'после_док':U
     2516                  OR   buf_rvs-doc.rvs-type = 'перед_док':U)
     2517                  then do:
     2518                     find first buf_doc-line
     2519                          where buf_doc-line.doc-code  = buf_trn-doc.doc-code
     2520                            and buf_doc-line.artic     = buf_goods.artic
     2521                            and buf_doc-line.prod-type = buf_goods.prod-type
     2522                            and buf_doc-line.prod-code = buf_goods.prod-code
     2523                          no-lock
     2524                          .
     2525                           assign
     2526                              v-exist = false
     2527                           .
     2528                           RUN get-doc-line-attr  (
     2529                              INPUT   buf_doc-line.doc-code  ,
     2530                              INPUT   buf_goods.gds-code,
     2531                              INPUT   "autoent-obj-type":U ,
     2532                              OUTPUT  v-autoent-type      ,
     2533                              OUTPUT  v-exist       )
     2534                              NO-ERROR .
     2535                           IF ERROR-STATUS :ERROR
     2536                           OR NOT v-exist
     2537                           THEN DO:
     2538                              assign
     2539                                 v-autoent-type = ""
     2540                              .
     2541                           END.
     2542                           assign
     2543                              v-exist = false
     2544                           .
     2545                           RUN get-doc-line-attr  (
     2546                              INPUT   buf_doc-line.doc-code  ,
     2547                              INPUT   buf_goods.gds-code,
     2548                              INPUT   "autoent-obj-code":U ,
     2549                              OUTPUT  v-autoent-code      ,
     2550                              OUTPUT  v-exist       )
     2551                              NO-ERROR .
     2552                           IF ERROR-STATUS :ERROR
     2553                           OR NOT v-exist
     2554                           THEN DO:
     2555                              assign
     2556                                 v-autoent-code = ""
     2557                              .
     2558                           END.
     2559                           find first buf_clients
     2560                                 where buf_clients.obj-type = v-autoent-type
     2561                                    and buf_clients.obj-code = INTEGER(v-autoent-code)
     2562                                 no-lock
     2563                                 no-error
     2564                                 .
     2565                           IF AVAILABLE buf_clients then do:
     2566                              assign
     2567                                 v-autoent-name = buf_clients.obj-name
     2568                              .
     2569                           end.
     2570                           else do:
     2571                              assign
     2572                                 v-autoent-name = "не задан":U
     2573                              .
     2574                           end.
     2575                           assign
     2576                              v-exist = false
     2577                           .
     2578                           RUN get-doc-line-attr  (
     2579                              INPUT   buf_doc-line.doc-code  ,
     2580                              INPUT   buf_goods.gds-code,
     2581                              INPUT   "car-num":U ,
     2582                              OUTPUT  v-car-num      ,
     2583                              OUTPUT  v-exist       )
     2584                              NO-ERROR .
     2585                           IF ERROR-STATUS :ERROR
     2586                           OR NOT v-exist
     2587                           THEN DO:
     2588                              assign
     2589                                 v-car-num = "не задан"
     2590                              .
     2591                           END.
     2592                           assign
     2593                              v-exist = false
     2594                           .
     2595                           RUN get-doc-line-attr  (
     2596                              INPUT   buf_doc-line.doc-code  ,
     2597                              INPUT   buf_goods.gds-code,
     2598                              INPUT   "fio":U ,
     2599                              OUTPUT  v-fio      ,
     2600                              OUTPUT  v-exist       )
     2601                              NO-ERROR .
     2602                           IF ERROR-STATUS :ERROR
     2603                           OR NOT v-exist
     2604                           THEN DO:
     2605                              assign
     2606                                 v-fio = "не заданы"
     2607                              .
     2608                           END.
     2609                     assign
     2610                        v-attr = Substitute( "Перевозчик: &1, № а/м: &2, ФИО водителя: &3, плотность: &4, температура: &5, масса: &6, объем: &7"
     2611                                           , v-autoent-name
     2612                                           , v-car-num
     2613                                           , v-fio
     2614                                           , STRING(buf_doc-line.doc-density, ">9.9999")
     2615                                           , STRING(buf_doc-line.temperature, "->9.99")
     2616                                           , buf_doc-line.doc-qnty * buf_doc-line.doc-density
     2617                                           , buf_doc-line.doc-qnty
     2618                                           )
     2619                     .
     2620                     release buf_doc-line.
     2621                  end.
     2622                  create tt-doc.
     2623                  assign
     2624                     tt-doc.rvs-code           = buf_rvs-line.rvs-code
     2625                     tt-doc.obj-type           = buf_rvs-line.obj-type
     2626                     tt-doc.obj-code           = buf_rvs-line.obj-code
     2627                     tt-doc.pl-code            = buf_rvs-line.pl-code
     2628                     tt-doc.gds-code           = buf_rvs-line.gds-code
     2629                     tt-doc.shift-date         = buf_rvs-doc.shift-date
     2630                     tt-doc.shift-num          = buf_rvs-doc.shift-num
     2631                     tt-doc.status_            = buf_rvs-doc.status_
     2632                     tt-doc.fact-order         = buf_rvs-doc.fact-order
     2633                     tt-doc.loc1               = v-loc
     2634                     tt-doc.state-measure-qnty = buf_rvs-line.state-measure-qnty
     2635                     tt-doc.state-temperature  = buf_rvs-line.state-temperature
     2636                     tt-doc.state-dencity      = buf_rvs-line.state-density
     2637                     tt-doc.fact-date          = buf_rvs-doc.fact-date
     2638                     tt-doc.fact-time          = STRING(buf_rvs-doc.fact-time, "HH:MM:SS")
     2639                     tt-doc.gds-name           = buf_goods.gds-name
     2640                     tt-doc.rvs-type           = buf_rvs-doc.rvs-type
     2641                     tt-doc.state-level-total  = buf_rvs-line.state-level-total
     2642                     tt-doc.attr_              = v-attr
     2643                  .
     2644                  case tt-doc.rvs-type:
     2645                     when 'после_док':U then do:
     2646                        assign
     2647                           tt-doc.rvs-type-outside = "после приема"
     2648                        .
     2649                     end.
     2650                     when     'перед_док':U then do:
     2651                        assign
     2652                           tt-doc.rvs-type-outside = "до приема"
     2653                        .
     2654                     end.
     2655                     when     'смена':U then do:
     2656                        assign
     2657                           tt-doc.rvs-type-outside = "смена"
     2658                        .
     2659                     end.
     2660                     when     'контроль':U then do:
     2661                        assign
     2662                           tt-doc.rvs-type-outside = "контроль"
     2663                        .
     2664                     end.
     2665                  end case.
     2666               if  available buf_trn-doc then do:
     2667                   release buf_trn-doc.
     2668               end.
     2669               end.
     2670            end.
     2671         end.
     2672         else do:
     2673            for each  buf_rvs-doc
     2674               where buf_rvs-doc.obj-type     = obj-list.obj-type
     2675                  and buf_rvs-doc.obj-code     = obj-list.obj-code
     2676                  AND buf_rvs-doc.status_      = 'факт':U
     2677                  AND buf_rvs-doc.fact-order  >  v-fact-order-begin
     2678               no-lock
     2679               :
     2680   define variable vss-include-info17 as character format "X(65)" no-undo
     2681   initial "@(#)$Workfile$ $Revision$".
     2682               IF (buf_rvs-doc.rvs-type = 'после_док':U
     2683               OR  buf_rvs-doc.rvs-type = 'перед_док':U)
     2684               then do:
     2685                  find first buf_trn-doc
     2686                       where buf_trn-doc.doc-code = buf_rvs-doc.out-code
     2687                       no-lock
     2688                       .
     2689                  v-attr = "".
     2690               end.
     2691               FOR each  buf_rvs-line
     2692               where buf_rvs-line.rvs-code = buf_rvs-doc.rvs-code
     2693               no-lock
     2694               :
     2695                  find first buf_place
     2696                        where buf_place.obj-type = buf_rvs-doc.obj-type
     2697                        and buf_place.obj-code = buf_rvs-doc.obj-code
     2698                        and buf_place.pl-code  = buf_rvs-line.pl-code
     2699                        no-lock
     2700                        no-error
     2701                        .
     2702                  if available buf_place then do:
     2703                     assign
     2704                        v-loc = buf_place.loc1
     2705                     .
     2706                  end.
     2707                  else do:
     2708                     assign
     2709                        v-loc = "Не найден"
     2710                     .
     2711                  end.
     2712                  find first buf_goods
     2713                     where buf_goods.gds-code = buf_rvs-line.gds-code
     2714                     no-lock
     2715                     .
     2716                  if  available buf_trn-doc
     2717                  AND (buf_rvs-doc.rvs-type = 'после_док':U
     2718                  OR   buf_rvs-doc.rvs-type = 'перед_док':U)
     2719                  then do:
     2720                     find first buf_doc-line
     2721                          where buf_doc-line.doc-code  = buf_trn-doc.doc-code
     2722                            and buf_doc-line.artic     = buf_goods.artic
     2723                            and buf_doc-line.prod-type = buf_goods.prod-type
     2724                            and buf_doc-line.prod-code = buf_goods.prod-code
     2725                          no-lock
     2726                          .
     2727                           assign
     2728                              v-exist = false
     2729                           .
     2730                           RUN get-doc-line-attr  (
     2731                              INPUT   buf_doc-line.doc-code  ,
     2732                              INPUT   buf_goods.gds-code,
     2733                              INPUT   "autoent-obj-type":U ,
     2734                              OUTPUT  v-autoent-type      ,
     2735                              OUTPUT  v-exist       )
     2736                              NO-ERROR .
     2737                           IF ERROR-STATUS :ERROR
     2738                           OR NOT v-exist
     2739                           THEN DO:
     2740                              assign
     2741                                 v-autoent-type = ""
     2742                              .
     2743                           END.
     2744                           assign
     2745                              v-exist = false
     2746                           .
     2747                           RUN get-doc-line-attr  (
     2748                              INPUT   buf_doc-line.doc-code  ,
     2749                              INPUT   buf_goods.gds-code,
     2750                              INPUT   "autoent-obj-code":U ,
