     1707         input   local-doc-line.doc-code ,
     1708         input   v-gds-code              ,
     1709         input   'reason-code':U ,
     1710         output  v-code                  ,
     1711         output  v-type ) .
     1712     find first ub.trn-reason no-lock where
     1713                ub.trn-reason.reason-code = integer ( v-code ) no-error.
     1714     if not available ub.trn-reason then do:
     1715        return "" .
     1716     end.
     1717     else do:
     1718        return ub.trn-reason.reason-name .
     1719     end.
     1720   end function.
