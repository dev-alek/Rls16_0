     2792                              .
     2793                           END.
     2794                           assign
     2795                              v-exist = false
     2796                           .
     2797                           RUN get-doc-line-attr  (
     2798                              INPUT   buf_doc-line.doc-code  ,
     2799                              INPUT   buf_goods.gds-code,
     2800                              INPUT   "fio":U ,
     2801                              OUTPUT  v-fio      ,
     2802                              OUTPUT  v-exist       )
     2803                              NO-ERROR .
     2804                           IF ERROR-STATUS :ERROR
     2805                           OR NOT v-exist
     2806                           THEN DO:
     2807                              assign
     2808                                 v-fio = "не заданы"
     2809                              .
     2810                           END.
