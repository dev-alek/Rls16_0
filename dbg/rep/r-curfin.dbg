     1513   define variable mFrameView      as logical   no-undo init yes.
     1514     define variable mFramHandle as handle no-undo.
     1515     mFramHandle = frame InfoFrame:handle.
     1516     if  log-manager:logfile-name ne ?
     1517     then DO:
     1518         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1519         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1520         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
     1521     end.
     1522     mFrameView = not session:batch-mode and mFramHandle:visible.
     1523     if mFrameView
     1524     then do:
     1525       ASSIGN
     1526          FRAME InfoFrame:HIDDEN                           = TRUE
     1527          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
     1528     end.
     1529   ON CHOOSE OF StopBtn IN FRAME InfoFrame
     1530   DO:
     1531     IF not StopProcessing THEN
     1532       Message "Вы действительно хотите прервать" SKIP
     1533               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
     1534                 UPDATE StopProcessing.
     1535     IF StopProcessing THEN do:
     1536        if mFrameView
     1537        then do:
     1538           HIDE FRAME InfoFrame.
     1539        end.
     1540     End.
     1541   END.
     1542   assign v-account = ( if integer( 1 ) = 0 then 100 else integer( 1 ) ).
     1543     if  log-manager:logfile-name ne ?
     1544     then DO:
     1545         log-manager:write-message("ON mFrameView=" + string(mFrameView), "frameRepError").
     1546     end.
     1547     if not session:batch-mode then
     1548     do:
     1549       VIEW FRAME InfoFrame.
     1550       mFrameView = true.
     1551     end.
     1552      v-button-stop = false .
     1553         if mFrameView
     1554         then do:
     1555         if v-button-stop then view STOPBTN in frame InfoFrame.
     1556                          else Hide STOPBTN in frame InfoFrame.
     1557         end.
