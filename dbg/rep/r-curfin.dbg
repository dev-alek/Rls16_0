      983   define variable sym1  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      984   define variable sym2  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      985   define variable sym3  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      986   define variable sym4  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      987   define variable sym5  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      988   define variable sym6  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      989   define variable sym7  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      990   define variable sym8  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      991   define variable sym9  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      992   define variable sym10 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
