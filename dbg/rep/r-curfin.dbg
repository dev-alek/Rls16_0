     1012   procedure cur-time :
     1013      define output parameter p-today as date      no-undo .
     1014      define output parameter p-time  as integer   no-undo .
     1015     do
     1016     on error undo, return error
     1017     :
     1018       define variable v-date1 as date      no-undo .
     1019       define variable v-date2 as date      no-undo .
     1020       define variable v-time  as integer   no-undo .
     1021       assign
     1022         v-date1 = today
     1023         v-time  = time
     1024         v-date2 = today
     1025       .
     1026       if v-date1 <> v-date2
     1027       then do:
     1028         assign
     1029           v-date1 = today
     1030           v-time  = v-time
     1031         .
     1032       end.
     1033       assign
     1034         p-today = v-date1
     1035         p-time  = v-time
     1036       .
     1037     end.
     1038   end.
     1039   function cur-time-date returns character
     1040   :
     1041     return string(today, '99/99/9999':U) .
     1042   end.
     1043   function cur-time-mjd returns decimal
     1044   :
     1045     define variable v-date as date      no-undo .
     1046     define variable v-time as integer   no-undo .
     1047     run cur-time in this-procedure
     1048       (output v-date
     1049       ,output v-time
     1050       ) .
     1051     return integer(v-date) - 2400002 + (v-time / 86400) .
     1052   end.
     1053   function cur-time-get-ending-index returns integer
     1054   (input p-number as integer
     1055   )
     1056   :
     1057     if p-number < 0
     1058     or p-number = ?
     1059     then do:
     1060       return 1 .
     1061     end.
     1062     define variable v-rest as integer   no-undo .
     1063     assign
     1064       p-number = p-number modulo 100
     1065     .
     1066     if p-number < 20
     1067     then do:
     1068       assign
     1069         v-rest = p-number
     1070       .
     1071     end.
     1072     else do:
     1073       assign
     1074         v-rest = p-number modulo 10
     1075       .
     1076     end.
     1077     case v-rest :
     1078       when 1
     1079       then do:
     1080         return 2 .
     1081       end.
     1082       when 2 or
     1083       when 3 or
     1084       when 4
     1085       then do:
     1086         return 3 .
     1087       end.
     1088       otherwise do:
     1089         return 1 .
     1090       end.
     1091     end case .
     1092   end.
     1093   procedure cur-time-mjd-to-date :
     1094      define input  parameter i-mjd-diff as decimal no-undo.
     1095      define output parameter o-Date     as date    no-undo.
     1096      define output parameter o-Time     as integer no-undo.
     1097      define variable v-day-number as integer   no-undo .
     1098      if    i-mjd-diff < 0
     1099         or i-mjd-diff = ?
     1100      then do:
     1101         return "?" .
     1102      end.
     1103      assign
     1104         v-day-number = truncate(i-mjd-diff,0).
     1105         o-Date = date(v-day-number + 2400002).
     1106         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     1107     .
     1108   end.
     1109   function cur-time-mjd-to-string returns character
     1110   (input p-mjd-diff as decimal
     1111   )
     1112   :
     1113     define variable v-day-number as integer   no-undo .
     1114     define variable v-seconds    as integer   no-undo .
     1115     define variable v-hour       as integer   no-undo .
     1116     define variable v-min        as integer   no-undo .
     1117     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     1118     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     1119     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     1120     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1121     if p-mjd-diff < 0
     1122     or p-mjd-diff = ?
     1123     then do:
     1124       return "?" .
     1125     end.
     1126     assign
     1127       v-day-number = integer(truncate(p-mjd-diff,0))
     1128       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1129     .
     1130     if v-seconds > 86400
     1131     then do:
     1132       assign
     1133         v-seconds = 86400 - 1
     1134       .
     1135     end.
     1136     if v-seconds < 0
     1137     then do:
     1138       assign
     1139         v-seconds = 0
     1140       .
     1141     end.
     1142     assign
     1143       v-hour = truncate(v-seconds / 3600, 0)
     1144     .
     1145     assign
     1146       v-seconds = v-seconds modulo 3600
     1147     .
     1148     assign
     1149       v-min = truncate(v-seconds / 60, 0)
     1150     .
     1151     assign
     1152       v-seconds = v-seconds modulo 60
     1153     .
     1154     return
     1155         (if v-day-number <> 0
     1156           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1157           else ""
     1158         )
     1159       + (if v-day-number <> 0 or v-hour <> 0
     1160           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1161           else ""
     1162         )
     1163       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1164           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1165           else ""
     1166         )
     1167       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1168       .
     1169   end.
     1170   function cur-time-string returns character
     1171   :
     1172     define variable v-date as date      no-undo .
     1173     define variable v-time as integer   no-undo .
     1174     run cur-time in this-procedure
     1175       (output v-date
     1176       ,output v-time
     1177       ) .
     1178     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1179   end.
     1180   function cur-time-string-sec returns character
     1181   :
     1182     define variable v-date as date      no-undo .
     1183     define variable v-time as integer   no-undo .
     1184     run cur-time in this-procedure
     1185       (output v-date
     1186       ,output v-time
     1187       ) .
     1188     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1189   end.
     1190   function cur-time-custom  returns character
     1191   (input p-prefix as character
     1192   ,input p-date-format as character
     1193   ,input p-delimiter as character
     1194   ,input p-time-format as character
     1195   ,input p-suffix as character
     1196   )
     1197   :
     1198     define variable v-date as date      no-undo .
     1199     define variable v-time as integer   no-undo .
     1200     run cur-time in this-procedure
     1201       (output v-date
     1202       ,output v-time
     1203       ) .
     1204     return
     1205       p-prefix
     1206       + string(v-date, p-date-format)
     1207       + p-delimiter
     1208       + string(v-time, p-time-format)
     1209       + p-suffix
     1210       .
     1211   end.
     1212   function cur-time-print  returns character
     1213   :
     1214     define variable v-date as date      no-undo .
     1215     define variable v-time as integer   no-undo .
     1216     run cur-time in this-procedure
     1217       (output v-date
     1218       ,output v-time
     1219       ) .
     1220     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1221   end.
     1222   function cur-time-datetime returns datetime
     1223   :
     1224     define variable v-char as character no-undo .
     1225     define variable v-datetime as datetime no-undo .
     1226     v-char = cur-time-string().
     1227     v-datetime = datetime(v-char).
     1228     return  v-datetime.
     1229   end.
     1230   function cur-time-string-msec returns character
     1231   :
     1232     define variable v-date as datetime  no-undo .
     1233     v-date = now.
     1234     return string(v-date) .
     1235   end.
