     1397     define input parameter parParentProc  as widget-handle no-undo.
     1398     define output parameter p-report-name as character no-undo .
     1399     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
     1400   end procedure.
