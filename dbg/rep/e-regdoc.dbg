      957   procedure uf-get :
      958     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
      959     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
      960     define output parameter p-List_        like ubflt.usr-flt.List_        no-undo .
      961     define output parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
      962     define output parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
      963     define output parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
      964     define output parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
      965     define output parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
      966     do
      967     on error undo, return error
      968     :
      969       define buffer buf_usr-flt for ubflt.usr-flt .
      970       define variable v-use-List_     as logical   no-undo .
      971       define variable v-type-List_     as character no-undo .
      972       define variable v-format-List_   as character no-undo .
      973       define variable v-use-Naim      as logical   no-undo .
      974       define variable v-type-Naim      as character no-undo .
      975       define variable v-format-Naim    as character no-undo .
      976       define variable v-use-print-graft as logical   no-undo .
      977       define variable v-use-sort-gr     as logical   no-undo .
      978       define variable v-use-type-price  as logical   no-undo .
      979       define variable v-use-type-val    as logical   no-undo .
      980       define variable v-label          as character no-undo .
      981       define variable v-tooltip        as character no-undo .
      982       define variable v-user-can-edit  as logical   no-undo .
      983       define variable v-output-display as logical   no-undo .
      984       define variable v-other          as character no-undo .
      985       run uf-name in this-procedure
      986          (input  entry(1, p-code, chr(4))
      987         ,output v-use-List_
      988         ,output v-type-List_
      989         ,output v-format-List_
      990         ,output v-use-Naim
      991         ,output v-type-Naim
      992         ,output v-format-Naim
      993         ,output v-use-print-graft
      994         ,output v-use-sort-gr
      995         ,output v-use-type-price
      996         ,output v-use-type-val
      997         ,output v-label
      998         ,output v-tooltip
      999         ,output v-user-can-edit
     1000         ,output v-output-display
     1001         ,output v-other
     1002         ) no-error .
     1003       if error-status :error then do:
     1004         undo, return error return-value .
     1005       end.
     1006       find first buf_usr-flt no-lock where
     1007                  buf_usr-flt.Call-point     = p-code AND
     1008                  buf_usr-flt.user-name       = p-user-name
     1009         no-error .
     1010       if avail buf_usr-flt then do:
     1011         assign
     1012         p-List_        = (if v-use-List_       then buf_usr-flt.List_       else ?)
     1013         p-Naim         = (if v-use-Naim        then buf_usr-flt.Naim        else ?)
     1014         p-print-graft  = (if v-use-print-graft then buf_usr-flt.print-graft else ?)
     1015         p-sort-gr      = (if v-use-sort-gr     then buf_usr-flt.sort-gr     else ?)
     1016         p-type-price   = (if v-use-type-price  then buf_usr-flt.type-price  else ?)
     1017         p-type-val     = (if v-use-List_       then buf_usr-flt.type-val    else ?)
     1018         .
     1019       end.
     1020       else do:
     1021         assign
     1022         p-List_        = (if v-use-List_       then "":U                    else ?)
     1023         p-Naim         = (if v-use-Naim        then "":U                    else ?)
     1024         p-print-graft  = (if v-use-print-graft then no                      else ?)
     1025         p-sort-gr      = (if v-use-sort-gr     then no                      else ?)
     1026         p-type-price   = (if v-use-type-price  then no                      else ?)
     1027         p-type-val     = (if v-use-List_       then no                      else ?)
     1028         .
     1029       end.
     1030     end.
     1031   end procedure.
     1032   procedure uf-set :
     1033     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
     1034     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
     1035     define input  parameter p-List_        like ubflt.usr-flt.List_        no-undo .
     1036     define input  parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
     1037     define input  parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
     1038     define input  parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
     1039     define input  parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
     1040     define input  parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
     1041     do
     1042     on error undo, return error
     1043     :
     1044       define buffer buf_usr-flt for ubflt.usr-flt .
     1045       define variable v-use-List_     as logical   no-undo .
     1046       define variable v-type-List_     as character no-undo .
     1047       define variable v-format-List_   as character no-undo .
     1048       define variable v-use-Naim      as logical   no-undo .
     1049       define variable v-type-Naim      as character no-undo .
     1050       define variable v-format-Naim    as character no-undo .
     1051       define variable v-use-print-graft as logical   no-undo .
     1052       define variable v-use-sort-gr   as logical   no-undo .
     1053       define variable v-use-type-price as logical   no-undo .
     1054       define variable v-use-type-val  as logical   no-undo .
     1055       define variable v-tooltip        as character no-undo .
     1056       define variable v-label          as character no-undo .
     1057       define variable v-user-can-edit  as logical   no-undo .
     1058       define variable v-output-display as logical   no-undo .
     1059       define variable v-other          as character no-undo .
     1060       run uf-name in this-procedure
     1061         (input  entry(1, p-code, chr(4))
     1062         ,output v-use-List_
     1063         ,output v-type-List_
     1064         ,output v-format-List_
     1065         ,output v-use-Naim
     1066         ,output v-type-Naim
     1067         ,output v-format-Naim
     1068         ,output v-use-print-graft
     1069         ,output v-use-sort-gr
     1070         ,output v-use-type-price
     1071         ,output v-use-type-val
     1072         ,output v-label
     1073         ,output v-tooltip
     1074         ,output v-user-can-edit
     1075         ,output v-output-display
     1076         ,output v-other
     1077         ) no-error .
     1078       if error-status :error then do:
     1079         undo, return error return-value .
     1080       end.
     1081       find first buf_usr-flt where
     1082                  buf_usr-flt.Call-point     = p-code AND
     1083                  buf_usr-flt.user-name       = p-user-name
     1084         no-error .
     1085       if not avail buf_usr-flt then do:
     1086           create buf_usr-flt .
     1087           assign
     1088           buf_usr-flt.call-point = p-code
     1089           buf_usr-flt.user-name  = p-user-name
     1090           .
     1091       end.
     1092       if avail buf_usr-flt then do:
     1093        assign
     1094        buf_usr-flt.List_       =  (if v-use-List_       then  p-List_        else ?)
     1095        buf_usr-flt.Naim        =  (if v-use-Naim        then  p-Naim         else ?)
     1096        buf_usr-flt.print-graft =  (if v-use-print-graft then  p-print-graft  else ?)
     1097        buf_usr-flt.sort-gr     =  (if v-use-sort-gr     then  p-sort-gr      else ?)
     1098        buf_usr-flt.type-price  =  (if v-use-type-price  then  p-type-price   else ?)
     1099        buf_usr-flt.type-val    =  (if v-use-List_       then  p-type-val     else ?)
     1100       .
     1101       release buf_usr-flt.
     1102       end.
     1103       else undo, return error ("Ошибка при записи usr-flt" + substitute(" call-point=&1, user-name=&2", p-code, p-user-name)).
     1104     end.
     1105   end procedure.
     1106   function diff-list returns character (
     1107     input parfirst-list  as character,
     1108     input parsecond-list as character,
     1109     input pardelim       as character).
     1110     if pardelim = ""
     1111     or pardelim = ?
     1112     then do:
     1113       assign
     1114         pardelim = ","
     1115       .
     1116     end.
     1117     def var ind as integer no-undo .
     1118     def var v-elem as character no-undo .
     1119     def var v-result-list as character no-undo init "".
     1120     def var v-num-parfirst-list as integer no-undo .
     1121     assign
     1122       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
     1123     .
     1124     do ind = 1 to v-num-parfirst-list
     1125     :
     1126       assign
     1127         v-elem = entry(ind, parfirst-list, pardelim)
     1128       .
     1129       if lookup(v-elem, parsecond-list, pardelim) = 0 then do:
     1130         assign
     1131           v-result-list = v-result-list
     1132                         + (if v-result-list > "" then pardelim else "")
     1133                         + v-elem
     1134         .
     1135       end.
     1136     end.
     1137     return v-result-list .
     1138   end function.
     1139   function add-list returns character (
     1140    input parfirst-list  as character,
     1141    input parsecond-list as character,
     1142    input pardelim       as character).
     1143     if pardelim = ""
     1144     or pardelim = ?
     1145     then do:
     1146       assign
     1147         pardelim = ","
     1148       .
     1149     end.
     1150     def var ind as integer no-undo .
     1151     def var v-elem as character no-undo .
     1152     def var v-result-list as character no-undo init "".
     1153     def var v-num-parfirst-list as integer no-undo .
     1154     assign
     1155       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
     1156     .
     1157     do ind = 1 to v-num-parfirst-list
     1158     :
     1159       assign
     1160         v-elem = entry(ind, parfirst-list, pardelim)
     1161       .
     1162       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
     1163         assign
     1164           v-result-list = v-result-list
     1165                         + (if v-result-list > "" then pardelim else "")
     1166                         + v-elem
     1167         .
     1168       end.
     1169     end.
     1170     def var v-num-parsecond-list as integer no-undo .
     1171     assign
     1172       v-num-parsecond-list = num-entries(parsecond-list, pardelim)
     1173     .
     1174     do ind = 1 to v-num-parsecond-list
     1175     :
     1176       assign
     1177         v-elem = entry(ind, parsecond-list, pardelim)
     1178       .
     1179       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
     1180         assign
     1181           v-result-list = v-result-list
     1182                         + (if v-result-list > "" then pardelim else "")
     1183                         + v-elem
     1184         .
     1185       end.
     1186     end.
     1187     return v-result-list .
     1188   end function.
     1189   function cross-list returns character (
     1190    input parfirst-list  as character,
     1191    input parsecond-list as character,
     1192    input pardelim       as character).
     1193     if pardelim = ""
     1194     or pardelim = ?
     1195     then do:
     1196       assign
     1197         pardelim = ","
     1198       .
     1199     end.
     1200     def var ind as integer no-undo .
     1201     def var v-elem as character no-undo .
     1202     def var v-result-list as character no-undo init "".
     1203     def var v-num-parfirst-list as integer no-undo .
     1204     assign
     1205       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
     1206     .
     1207     do ind = 1 to v-num-parfirst-list
     1208     :
     1209       assign
     1210         v-elem = entry(ind, parfirst-list, pardelim)
     1211       .
     1212       if lookup(v-elem, v-result-list, pardelim) = 0
     1213       and lookup(v-elem, parsecond-list, pardelim) > 0
     1214       then do:
     1215         assign
     1216           v-result-list = v-result-list
     1217                         + (if v-result-list > "" then pardelim else "")
     1218                         + v-elem
     1219         .
     1220       end.
     1221     end.
     1222     return v-result-list .
     1223   end function.
     1224   function radio-label returns character (
     1225    input par-rs-value  as character,
     1226    input par-rs-radio-buttons as character)
     1227    .
     1228    DEFINE variable v-result-label as character no-undo.
     1229    assign
     1230    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons) MODULO 2 = 0)
     1231                              then (LOOKUP(par-rs-value, par-rs-radio-buttons) - 1)
     1232                              else LOOKUP(par-rs-value, par-rs-radio-buttons)
     1233                             ), par-rs-radio-buttons
     1234                           )
     1235    v-result-label = REPLACE(v-result-label, "&":U, "":U)
     1236    .
     1237   return v-result-label.
     1238   end function.
     1239   function m-radio-label returns character (
     1240    input par-rs-value  as character,
     1241    input par-rs-radio-buttons as character,
     1242    input par-delim as character
     1243    )
     1244    .
     1245    DEFINE variable v-result-label as character no-undo.
     1246    assign
     1247    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) MODULO 2 = 0)
     1248                              then (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) - 1)
     1249                              else LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim)
     1250                             ), par-rs-radio-buttons, par-delim
     1251                           )
     1252    v-result-label = REPLACE(v-result-label, "&":U, "":U)
     1253    .
     1254   return v-result-label.
     1255   end function.
     1256   FUNCTION mixlist returns character
     1257   (
     1258    input parfirst-list  as character
     1259    ,input parsecond-list as character
     1260    ,input pardelim       as character
     1261    ,input pardelim-result as character ) :
     1262     if pardelim = ""
     1263     or pardelim = ?
     1264     then do:
     1265       assign
     1266         pardelim = ","
     1267       .
     1268     end.
     1269     def var ind as integer no-undo .
     1270     def var v-elem1 as character no-undo .
     1271     def var v-elem2 as character no-undo .
     1272     def var v-result-list as character no-undo init "".
     1273     do ind = 1 to num-entries(parfirst-list, pardelim)
     1274     :
     1275       assign
     1276         v-elem1 = entry(ind, parfirst-list, pardelim)
     1277         v-elem2 = entry(ind, parsecond-list, pardelim)
     1278       .
     1279         assign
     1280           v-result-list = v-result-list
     1281                         + (if v-result-list > "" then pardelim-result else "")
     1282                         + v-elem1 + pardelim-result + v-elem2
     1283         .
     1284     end.
     1285     return v-result-list .
     1286   END FUNCTION.
