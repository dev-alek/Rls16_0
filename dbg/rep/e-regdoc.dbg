     2284        .
     2285               END.
     2286      IF  NOT can-find (FIRST temp_twowin_itemsSelected_col)
     2287      THEN DO:
     2288         IF INDEX(sl-col-type :list-item-pairs, "<") > 0
     2289         THEN DO:
     2290            run twowin_clear in this-procedure.
     2291            do v-counter = 1 to num-entries( v-list-edt-full )
     2292            with frame F-Main
     2293            on error undo, return error
     2294            :
     2295               create temp_twowin_itemsSelected_col.
     2296               assign
     2297                  temp_twowin_itemsSelected_col.its-key   = v-counter
     2298                  temp_twowin_itemsSelected_col.itm-key   = v-counter
     2299                  temp_twowin_itemsSelected_col.itmExtKey = entry( v-counter, v-list-edt )
     2300               .
     2301            end.
     2302         END.
     2303         ELSE DO:
     2304            run twowin_clear in this-procedure.
     2305            do v-counter = 1 to num-entries( sl-col-type :list-item-pairs )
     2306            with frame F-Main
     2307            on error undo, return error
     2308            :
     2309               create temp_twowin_itemsSelected_col.
     2310               assign
     2311                  temp_twowin_itemsSelected_col.its-key   = v-counter
     2312                  temp_twowin_itemsSelected_col.itm-key   = v-counter
     2313                  temp_twowin_itemsSelected_col.itmExtKey = entry( v-counter, sl-col-type:list-item-pairs )
     2314               .
     2315            end.
     2316         END.
     2317      END.
     2318      assign
     2319         v-naim = sl-col-type :list-item-pairs
     2320      .
     2321      assign
     2322         v-list       = "":U
     2323         v-call-point = '':U
     2324      .
     2325      assign
     2326         v-widget = FRAME F-Main:FIRST-CHILD
     2327         v-widget = v-widget:FIRST-CHILD
     2328      .
     2329      DO WHILE  VALID-HANDLE(v-widget)
     2330      :
     2331         IF  v-widget:TYPE = "TOGGLE-BOX":U
     2332         AND v-widget:CHECKED = TRUE
     2333         THEN DO:
     2334            ASSIGN
     2335               v-list = v-list + "," + v-widget:NAME
     2336            .
     2337         END.
     2338         assign
     2339            v-widget = v-widget:NEXT-SIBLING
     2340         .
     2341      END.
     2342      run uf-set ( input v-call-point
     2343                       , input v-cntxt-userid
     2344                       , input v-list
     2345                       , input v-naim
     2346                       , input ?
     2347                       , input ?
     2348                       , input ?
     2349                       , input ?
     2350                       ) .
     2351      run rep/r-regdoc.p
     2352             ( input v-cntxt-obj-code ,
     2353               input v-cntxt-obj-type ,
     2354               input base-type,
     2355               input base-code,
     2356               input VAT-SLT,
     2357               input radio-serv,
     2358               input NullPer,
     2359               input CalcRest,
     2360               input table temp_twowin_itemsSelected_col,
     2361               input table g#post-f,
     2362               input rz-objecte ,
     2363               input x-SelectGood
     2364               )
     2365        .
     2366   END PROCEDURE.
     2367   PROCEDURE my-var :
     2368   assign frame F-Main ie em wm ee im ep ot es ap re pc rs mp we vp vt iv ev rv
     2369    VAT-SLT
     2370    radio-serv
     2371    rz-objecte
     2372    CalcRest
     2373    NullPer
     2374    .
     2375    assign
     2376    ReportHeader   = chr(10)
     2377                   + (if radio-serv = 1 then "Отчет по товарам," else "Отчет по услугам,":U ) + chr(10)
     2378                   + (if x-SET_val_TYPE = 1 then "В рублях,"  else "в базовой валюте,") + chr(10)
     2379                   + (if VAT-SLT then "Распределение НДС," + chr(10) else "":U)
     2380                   + (if rz-objecte then "Раздельно по объектам," + chr(10) else "":U)
     2381                   + (if CalcRest then "Расчет остатков," + chr(10) else "":U)
     2382                   + (if NullPer and ot then "Выводятся нулевые переоценки," + chr(10) else "":U)
     2383                   + "Выбор поставщика: " + (if Postname = "":U then 'все':U  else Postname)
     2384    .
     2385   END PROCEDURE.
     2386   PROCEDURE report-to-ach :
     2387    do
     2388    on error undo, return error return-value
     2389    :
     2390    DEFINE INPUT-OUTPUT  PARAMETER TABLE FOR param-to-export .
     2391     for each  param-to-export : delete  param-to-export. end.
     2392   define variable cconnect as character no-undo .
     2393   define variable user-name as character no-undo .
     2394   define variable vss-include-info21 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2395   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usrfulnm in g#library
     2396     (input  v-cntxt-userid
     2397     ,output user-name
     2398     )  .
     2399    get-key-value section "rep-sets" key "conpar" value cconnect .
     2400   define variable v-base-key as character no-undo .
     2401   run gbl/base-key.p
     2402      (output v-base-key
     2403     ) .
     2404     run create-param-to-export  in this-procedure
     2405     ( input 'base-key'  ,
     2406      input ''  ,
     2407      input 'character'  ,
     2408      input v-base-key  ,
     2409      input 'ключ' )
     2410    .
     2411     run create-param-to-export  in this-procedure
     2412     ( input 'db-connect'  ,
     2413      input ''  ,
     2414      input 'character'  ,
     2415      input cconnect  ,
     2416      input 'строка коннекта к БД' )
     2417    .
     2418     run create-param-to-export  in this-procedure
     2419     ( input 'report-code'  ,
     2420      input ''  ,
     2421      input 'character'  ,
     2422      input ReportProc  ,
     2423      input 'уникальный код отчета' )
     2424    .
     2425   define variable v-host-code like ub.sysconf.host-code no-undo .
     2426   define variable v-host-name like ub.clients.obj-name no-undo .
     2427   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2428   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostname in g#library
     2429     (input  v-cntxt-obj-type
     2430     ,input  v-cntxt-obj-code
     2431     ,output v-host-code
     2432     ,output v-host-name
     2433     )  .
     2434     run create-param-to-export  in this-procedure
     2435     ( input 'firm-name'  ,
     2436      input ''  ,
     2437      input 'character'  ,
     2438      input v-host-name  ,
     2439      input 'имя фирмы' )
     2440    .
     2441     run create-param-to-export  in this-procedure
     2442     ( input 'firm-code'  ,
     2443      input ''  ,
     2444      input 'integer'  ,
     2445      input string(v-cntxt-host-code-obj)  ,
     2446      input 'код фирмы' )
     2447    .
     2448     run create-param-to-export  in this-procedure
     2449     ( input 'user-name'  ,
     2450      input ''  ,
     2451      input 'character'  ,
     2452      input user-name  ,
     2453      input 'имя пользователя' )
     2454    .
     2455     run create-param-to-export  in this-procedure
     2456     ( input 'store-type'  ,
     2457      input ''  ,
     2458      input 'character'  ,
     2459      input v-cntxt-obj-type  ,
     2460      input 'текущий объект - тип'  )
     2461    .
     2462     run create-param-to-export  in this-procedure
     2463     ( input 'store-code'  ,
     2464      input ''  ,
     2465      input 'integer'  ,
     2466      input string(v-cntxt-obj-code)  ,
     2467      input 'текущий объект - код' )
     2468    .
     2469     run create-param-to-export  in this-procedure
     2470     ( input 'date-start'  ,
     2471      input ''  ,
     2472      input 'data'  ,
     2473      input string(x-date-start,'99/99/9999')  ,
     2474      input 'дата начала интервала'  )
     2475    .
     2476     run create-param-to-export  in this-procedure
     2477     ( input 'date-end'  ,
     2478      input ''  ,
     2479      input 'data'  ,
     2480      input string(x-date-end,'99/99/9999')  ,
     2481      input 'дата конца интервала' )
     2482    .
     2483     run create-param-to-export  in this-procedure
     2484     ( input 'user-id'  ,
     2485      input ''  ,
     2486      input 'character'  ,
     2487      input v-cntxt-userid  ,
     2488      input 'код пользователя' )
     2489    .
     2490   define variable v-base-code like ub.sysconf.base-code no-undo .
     2491   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2492   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     2493     (input  v-cntxt-host-code-obj
     2494     ,output v-base-code
     2495     )  .
     2496   define buffer buf_currency for ub.currency.
     2497   find first buf_currency no-lock where
     2498             buf_currency.curr-code = v-base-code.
     2499     run create-param-to-export  in this-procedure
     2500     ( input 'base-type'  ,
     2501      input ''  ,
     2502      input 'character'  ,
     2503      input string(buf_currency.curr-abbr)  ,
     2504      input 'тип базовой валюты' )
     2505    .
     2506     run create-param-to-export  in this-procedure
     2507     ( input 'base-code'  ,
     2508      input ''  ,
     2509      input 'integer'  ,
     2510      input string(v-base-code)  ,
     2511      input 'код базовой валюты' )
     2512    .
     2513   if Show-Crsa or Show-Cost or Show-Sale then do:
     2514     run create-param-to-export  in this-procedure
     2515     ( input 'crsa'  ,
     2516      input ''  ,
     2517      input 'logical'  ,
     2518      input string(show-Crsa,'yes/no')  ,
     2519      input '  продажные цены' )
     2520    .
     2521     run create-param-to-export  in this-procedure
     2522     ( input 'cost'  ,
     2523      input ''  ,
     2524      input 'logical'  ,
     2525      input string(show-cost,'yes/no')  ,
     2526      input '  учетные цены' )
     2527    .
     2528     run create-param-to-export  in this-procedure
     2529     ( input 'sale'  ,
     2530      input ''  ,
     2531      input 'logical'  ,
     2532      input string(show-sale,'yes/no')  ,
     2533      input '  цены документа' )
     2534    .
     2535   end.
     2536   else do:
     2537     run create-param-to-export  in this-procedure
     2538     ( input 'set-pay-type'  ,
     2539      input ''  ,
     2540      input 'integer'  ,
     2541      input string(x-set_pay_type)  ,
     2542      input 'тип цены Продажные цены=1 Учетные цены=2 Цены документа=3 ' )
     2543    .
     2544   end.
     2545     run create-param-to-export  in this-procedure
     2546     ( input 'rubl-val'  ,
     2547      input ''  ,
     2548      input 'integer'  ,
     2549      input string(x-SET_val_TYPE)  ,
     2550      input 'печатать в рублях или валюте руб=1  вал=2  обе=3 ' )
     2551    .
     2552     run create-param-to-export  in this-procedure
     2553     ( input 'reportname'  ,
     2554      input ''  ,
     2555      input 'character'  ,
     2556      input reportname  ,
     2557      input 'название отчета' )
     2558    .
     2559     run create-param-to-export  in this-procedure
     2560     ( input 'select-good'  ,
     2561      input ''  ,
     2562      input 'integer'  ,
     2563      input string(x-selectgood)  ,
     2564      input 'тип выбора товара all=1 grp=2 prod=3 choice=4 one=5 grp-prod=6' )
     2565    .
     2566    define variable ii as integer no-undo .
     2567    define variable ii-name as character no-undo .
     2568    define variable ii-1 as integer no-undo .
     2569    define variable ii-name-1 as character no-undo .
     2570     define variable ii-2 as integer no-undo .
     2571    define variable ii-name-2 as character no-undo .
     2572    define variable ii-3 as integer no-undo .
     2573    define variable ii-name-3 as character no-undo .
     2574    if x-selectgood = 1     Or
     2575       x-selectgood = 2     Or
     2576       x-selectgood = 3    Or
     2577       x-selectgood = 4  then do:
     2578    ii = 0.
     2579         for each gds-list :
     2580           ii = ii + 1 .
     2581           if ii = 1 then ii-name = "список товаров - содержит gds-code  (уникальный ключ товара)" .
     2582                     else ii-name = "" .
     2583     run create-param-to-export  in this-procedure
     2584     ( input 'gds-list'  ,
     2585      input string(ii)  ,
     2586      input 'integer'  ,
     2587      input string(gds-list.gds-code)  ,
     2588      input ii-name )
     2589    .
     2590         end.
     2591    end.
     2592    if x-selectgood = 2 then do:
     2593    ii-2 = 0.
     2594         for each tmp#grp :
     2595           ii-2 = ii-2 + 1 .
     2596           if ii-2 = 1 then ii-name-2 = "список товаров - содержит  <node-code#grp-name>  (уникальный ключ списка групп)" .
     2597                     else ii-name-2 = "" .
     2598     run create-param-to-export  in this-procedure
     2599     ( input 'tmp#grp'  ,
     2600      input string(ii-2)  ,
     2601      input 'integer character '  ,
     2602      input string(tmp#grp.node-code) + '#' +  (tmp#grp.grp-name)  ,
     2603      input ii-name-2 )
     2604    .
     2605         end.
     2606    end.
     2607    if x-selectgood = 3 then do:
     2608    ii-3 = 0.
     2609         for each g#cli :
     2610           ii-3 = ii-3 + 1 .
     2611           if ii-3 = 1 then ii-name-3 = "список товаров - содержит  <node-code#grp-name>  (уникальный ключ списка производителе)" .
     2612                       else ii-name-3 = "" .
     2613     run create-param-to-export  in this-procedure
     2614     ( input 'g#cli'  ,
     2615      input string(ii-3)  ,
     2616      input 'character integer'  ,
     2617      input g#cli.obj-type + '#' + string(g#cli.obj-code)  ,
     2618      input ii-name-3 )
     2619    .
     2620         end.
     2621    end.
     2622     run create-param-to-export  in this-procedure
     2623     ( input 'select-object'  ,
     2624      input ''  ,
     2625      input 'character'  ,
     2626      input x-selectobject  ,
     2627      input 'тип выбора объекта   -currency -choice -firm -все' )
     2628    .
     2629    ii-1 = 0.
     2630     for each obj-list :
     2631       ii-1 = ii-1 + 1 .
     2632       if ii-1 = 1 then ii-name-1 = "список объектов - содержит <obj-type#obj-code>  (уникальный ключ clients)" .
     2633                 else ii-name-1 = "" .
     2634     run create-param-to-export  in this-procedure
     2635     ( input 'obj-list'  ,
     2636      input string(ii-1)  ,
     2637      input 'character integer'  ,
     2638      input obj-list.obj-type + '#' + string (obj-list.obj-code)  ,
     2639      input ii-name-1 )
     2640    .
     2641     end.
     2642     run create-param-to-export  in this-procedure
     2643     ( input 'vat-slt'                             ,
     2644      input ''                                    ,
     2645      input 'logical'                             ,
     2646      input string(vat-slt,'yes/no')              ,
     2647      input vat-slt:label in frame F-Main )
     2648    .
     2649     run create-param-to-export  in this-procedure
     2650     ( input 'null-pricelist'                                      ,
     2651      input ''                                                    ,
     2652      input 'logical'                                             ,
     2653      input string(nullper,'yes/no')                              ,
     2654      input nullper:label in frame F-Main                 )
     2655    .
     2656     end.
     2657   END PROCEDURE.
     2658   PROCEDURE select-col-type :
     2659   define variable v-counter    as integer    no-undo .
     2660   define variable v-label      as character  no-undo .
     2661   define variable v-value      as character  no-undo .
     2662   define variable v-list       as character  no-undo .
     2663   define variable v-changed    as logical    no-undo .
     2664   define variable v-accepted   as logical    no-undo .
     2665   do
     2666   with frame F-Main
     2667   on error undo, return error
     2668   :
     2669       run twowin_clear in this-procedure.
     2670       do v-counter = 1 to num-entries( v-list-edt-full )
     2671       on error undo, return error
     2672       :
     2673           assign
     2674               v-label = entry( v-counter, v-list-edt-full )
     2675               v-value = entry( v-counter, v-list-edt )
     2676           .
     2677           run twowin_add-item in this-procedure (
     2678                 input v-value
     2679               , input v-label
     2680               , input substitute( "Колонка: &1", v-value )
     2681               , input ( sl-col-type :lookup( v-value ) <> 0 or sl-col-type :list-item-pairs = "< Все >,''":U  )
     2682           ).
     2683       end.
     2684       run gbl/twowin.w (
     2685             input ?
     2686           , input 1
     2687           , input "Выбор колонок":U
     2688           , input "":U
     2689           , input "&Тест"
     2690           , input table temp_twowin_items
     2691           , output table temp_twowin_itemsSelected_col
     2692           , output v-changed
     2693           , output v-accepted
     2694       ).
     2695       if  v-accepted = yes
     2696       and v-changed = yes
     2697       then do:
     2698           IF NOT CAN-FIND( FIRST temp_twowin_itemsSelected_col )
     2699           THEN DO:
     2700               assign
     2701                     sl-col-type :list-item-pairs    = "Нет выбранных колонок,''":U
     2702                     v-list                          = "":U
     2703                     v-counter = 0
     2704               .
     2705               return.
     2706           END.
     2707           assign
     2708               sl-col-type :list-item-pairs    = "< Все >,''":U
     2709               v-list                          = "":U
     2710               v-counter = 0
     2711           .
     2712           for each temp_twowin_itemsSelected_col
     2713           by temp_twowin_itemsSelected_col.itm-key
     2714           :
     2715               assign
     2716                   v-counter = v-counter + 1
     2717                   v-list = substitute( "&1&2&3"
     2718                                   , v-list
     2719                                   , ( if v-list = "":U then "":U else ",":U )
     2720                                   , temp_twowin_itemsSelected_col.itmExtKey
     2721                                   )
     2722               .
     2723               if v-counter = 1
     2724               then do:
     2725                   assign
     2726                       sl-col-type :list-item-pairs    = substitute( "&1,&2"
     2727                                           , entry( lookup( temp_twowin_itemsSelected_col.itmExtKey, v-list-edt ), v-list-edt-full )
     2728                                           , temp_twowin_itemsSelected_col.itmExtKey
     2729                                                )
     2730                   .
     2731               end.
     2732               else do:
     2733                   sl-col-type :add-last (
     2734                       entry( lookup( temp_twowin_itemsSelected_col.itmExtKey, v-list-edt ), v-list-edt-full )
     2735                       , temp_twowin_itemsSelected_col.itmExtKey
     2736                   ).
     2737               end.
     2738           end.
     2739           if v-list = v-list-edt
     2740           then do:
     2741               assign
     2742                   sl-col-type :list-item-pairs = "< Все >,''":U
     2743               .
     2744           end.
     2745       end.
     2746   end.
     2747   END PROCEDURE.
