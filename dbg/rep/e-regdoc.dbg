     1473   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
     1474   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
     1475   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
     1476   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
     1477   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
     1478   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
     1479   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
     1480   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
     1481         adm-object-hdl = FRAME F-Main:HANDLE.
     1482   RUN ensure-broker.
     1483   THIS-PROCEDURE:ADM-DATA =
     1484        'ADM1.1~`':U +
     1485        'SmartViewer~`':U +
     1486        '~`':U +
     1487        'NO ~`':U +
     1488        '~`':U +
     1489        '~`':U +
     1490        '~`':U +
     1491        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
     1492           + "~`":U +
     1493        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add~`':U +
     1494        'Record-Source,Record-Target,TableIO-Target~`':U +
     1495        '~`':U +
     1496        '~`~`~`~`~`~`~`~`~`~`~`':U +
     1497        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
     1498            THEN "^^":U
     1499        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
     1500             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
     1501   PROCEDURE adm-apply-entry :
     1502     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1503   END PROCEDURE.
     1504   PROCEDURE adm-destroy :
     1505    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1506   END PROCEDURE.
     1507   PROCEDURE adm-disable :
     1508       DISABLE RECT-15 RECT-16 RECT-12 RADIO-serv ie em wm ee im ep ot es ap VAT-SLT re pc rs rz-objecte mp we vp CalcRest vt iv ev NullPer rv sl-col-type bt-col-type PostName RADPost WITH FRAME F-Main.
     1509       RUN dispatch ('disable-fields':U).
     1510       RUN set-attribute-list ('ENABLED=no':U).
     1511       RETURN.
     1512   END PROCEDURE.
     1513   PROCEDURE adm-edit-attribute-list :
     1514         RUN adm/support/viewerd.w (INPUT THIS-PROCEDURE).
     1515         RETURN.
     1516   END PROCEDURE.
     1517   PROCEDURE adm-enable :
     1518       ENABLE UNLESS-HIDDEN RECT-15 RECT-16 RECT-12 RADIO-serv ie em wm ee im ep ot es ap VAT-SLT re pc rs rz-objecte mp we vp CalcRest vt iv ev NullPer rv sl-col-type bt-col-type PostName RADPost WITH FRAME F-Main.
     1519       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
     1520       RUN set-attribute-list ('ENABLED=yes':U).
     1521       RETURN.
     1522   END PROCEDURE.
     1523   PROCEDURE adm-exit :
     1524        RUN notify ('exit':U).
     1525     RETURN.
     1526   END PROCEDURE.
     1527   PROCEDURE adm-hide :
     1528     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1529   END PROCEDURE.
     1530   PROCEDURE adm-initialize :
     1531     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1532   END PROCEDURE.
     1533   PROCEDURE adm-show-errors :
     1534       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
     1535       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
     1536           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
     1537       END.
     1538       RETURN.
     1539   END PROCEDURE.
     1540   PROCEDURE adm-UIB-mode :
     1541     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1542   END PROCEDURE.
     1543   PROCEDURE adm-view :
     1544     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1545   END PROCEDURE.
     1546   PROCEDURE dispatch :
     1547       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
     1548       RUN broker-dispatch IN adm-broker-hdl
     1549           (THIS-PROCEDURE, p-method-name) NO-ERROR.
     1550       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
     1551   END PROCEDURE.
     1552   PROCEDURE ensure-broker :
     1553   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
     1554   IF RETURN-VALUE NE "ADM-Broker":U THEN
     1555   DO:
     1556       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
     1557       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
     1558   END.
     1559   END PROCEDURE.
     1560   PROCEDURE get-attribute :
     1561     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
     1562     RUN broker-get-attribute IN adm-broker-hdl
     1563         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
     1564     RETURN RETURN-VALUE.
     1565   END PROCEDURE.
     1566   PROCEDURE get-attribute-list :
     1567     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
     1568     RUN broker-get-attribute-list IN adm-broker-hdl
     1569         (INPUT THIS-PROCEDURE,
     1570          INPUT ?,
     1571          OUTPUT p-attr-list) NO-ERROR.
     1572     RETURN.
     1573   END PROCEDURE.
     1574   PROCEDURE new-state :
     1575     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     1576     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
     1577     RETURN.
     1578   END PROCEDURE.
     1579   PROCEDURE notify :
     1580     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
     1581     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
     1582     IF RETURN-VALUE = "ADM-ERROR":U THEN
     1583         RETURN "ADM-ERROR":U.
     1584     RETURN.
     1585   END PROCEDURE.
     1586   PROCEDURE set-attribute-list :
     1587     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
     1588     RUN ensure-broker.
     1589     RUN broker-set-attribute-list IN adm-broker-hdl
     1590         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
     1591     RETURN.
     1592   END PROCEDURE.
     1593   PROCEDURE set-position :
     1594       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
     1595       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
     1596       IF VALID-HANDLE(adm-object-hdl) THEN
     1597       DO:
     1598         ASSIGN adm-object-hdl:ROW    =   p-row
     1599                adm-object-hdl:COLUMN =   p-col.
     1600       END.
     1601       RETURN.
     1602   END PROCEDURE.
     1603   PROCEDURE adm-display-fields :
     1604       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
     1605       RETURN.
     1606   END PROCEDURE.
     1607   PROCEDURE adm-open-query :
     1608     RETURN.
     1609   END PROCEDURE.
     1610   PROCEDURE adm-row-changed :
     1611         IF VALID-HANDLE(adm-object-hdl) THEN
     1612           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     1613         RUN notify ('row-available':U).
     1614         RETURN.
     1615   END PROCEDURE.
     1616   PROCEDURE reposition-query :
     1617       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
     1618       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
     1619       RETURN.
     1620   END PROCEDURE.
     1621     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
     1622     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
     1623     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
     1624     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
     1625     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
     1626     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
     1627     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
     1628     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
     1629     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1630     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
     1631     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1632     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
     1633     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
     1634     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
     1635     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
     1636     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
     1637     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
     1638     IF "":U = "":U THEN
     1639       RUN modify-list-attribute IN adm-broker-hdl
     1640         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
     1641     RUN use-create-on-add(?).
     1642   PROCEDURE adm-add-record :
     1643       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     1644          "must have at least one Enabled Table to perform Add.":U
     1645          VIEW-AS ALERT-BOX ERROR.
     1646       RETURN.
     1647   END PROCEDURE.
     1648   PROCEDURE adm-assign-record :
     1649    MESSAGE
     1650          "Object ":U THIS-PROCEDURE:FILE-NAME
     1651            "must have at least one Enabled Table to perform Assign.":U
     1652              VIEW-AS ALERT-BOX ERROR.
     1653      RETURN.
     1654     END PROCEDURE.
     1655   PROCEDURE adm-assign-statement :
     1656     RETURN.
     1657   END PROCEDURE.
     1658   PROCEDURE adm-cancel-record :
     1659      RETURN.
     1660     END PROCEDURE.
     1661   PROCEDURE adm-copy-record :
     1662       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     1663        "must have at least one Enabled Table to perform Copy.":U
     1664          VIEW-AS ALERT-BOX ERROR.
     1665       RETURN.
     1666   END PROCEDURE.
     1667   PROCEDURE adm-create-record :
     1668      RETURN.
     1669   END PROCEDURE.
     1670   PROCEDURE adm-current-changed :
     1671     RETURN.
     1672   END PROCEDURE.
     1673   PROCEDURE adm-delete-record :
     1674    MESSAGE
     1675          "Object ":U THIS-PROCEDURE:FILE-NAME
     1676            "must have at least one Enabled Table to perform Delete.":U
     1677              VIEW-AS ALERT-BOX ERROR.
     1678       RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
     1679       RETURN.
     1680   END PROCEDURE.
     1681   PROCEDURE adm-disable-fields :
     1682         RUN notify ('disable-fields, GROUP-ASSIGN-TARGET':U).
     1683       RETURN.
     1684   END PROCEDURE.
     1685   PROCEDURE adm-enable-fields :
     1686       RETURN.
     1687   END PROCEDURE.
     1688   PROCEDURE adm-end-update :
     1689     RETURN.
     1690   END PROCEDURE.
     1691   PROCEDURE adm-reset-record :
     1692       RETURN.
     1693   END PROCEDURE.
     1694   PROCEDURE adm-update-record :
     1695       MESSAGE
     1696         "Object ":U THIS-PROCEDURE:FILE-NAME
     1697           "must have at least one Enabled Table to perform Update.":U
     1698             VIEW-AS ALERT-BOX ERROR.
     1699      RETURN.
     1700   END PROCEDURE.
     1701   PROCEDURE check-modified :
     1702   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
     1703   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
     1704   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
     1705   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
     1706     IF check-state = "check":U THEN
     1707     DO:
     1708       RUN get-link-handle IN adm-broker-hdl
     1709         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
     1710            OUTPUT group-target-list).
     1711       IF group-target-list NE "":U THEN
     1712       DO i = 1 TO NUM-ENTRIES(group-target-list):
     1713         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
     1714         RUN check-modified IN curr-widget ('group-check':U).
     1715         IF RETURN-VALUE NE "":U THEN
     1716         DO:
     1717           RUN check-modified-message(RETURN-VALUE).
     1718           RETURN "":U.
     1719         END.
     1720       END.
     1721     END.
     1722     RETURN "":U.
     1723   END PROCEDURE.
     1724   PROCEDURE check-modified-message :
     1725     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
     1726        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
     1727           'CONTAINER-SOURCE':U, 'HIDDEN':U).
     1728        IF RETURN-VALUE = "YES":U THEN
     1729           RUN notify ('view,CONTAINER-SOURCE':U).
     1730        MESSAGE IF p-changed-table NE ? THEN
     1731           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
     1732           ELSE "Current values have been changed."
     1733           SKIP "  Do you wish to save those changes?"
     1734           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
     1735        IF ANS THEN
     1736        DO:
     1737           IF group-assign-target THEN
     1738             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
     1739           ELSE RUN dispatch('update-record':U).
     1740           IF RETURN-VALUE = "ADM-ERROR":U THEN
     1741           DO:
     1742               MESSAGE "Changes to the previous record were not saved."
     1743                 VIEW-AS ALERT-BOX ERROR.
     1744               IF group-assign-target THEN
     1745                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1746               ELSE RUN dispatch ('cancel-record':U).
     1747           END.
     1748        END.
     1749        ELSE DO:
     1750          IF group-assign-target THEN
     1751             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1752          ELSE RUN dispatch('cancel-record':U).
     1753        END.
     1754        RETURN.
     1755   END PROCEDURE.
     1756   PROCEDURE get-rowid :
     1757       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
     1758       ASSIGN
     1759       p-table   =   adm-first-table.
     1760       RETURN.
     1761   END PROCEDURE.
     1762   PROCEDURE init-group-assign :
     1763       RUN request-attribute IN adm-broker-hdl
     1764         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
     1765       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
     1766         group-assign-target = yes.
     1767       ELSE group-assign-target = no.
     1768       RETURN.
     1769   END PROCEDURE.
     1770   PROCEDURE set-editors :
     1771       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
     1772       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
     1773       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
     1774       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
     1775       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
     1776       DO WHILE VALID-HANDLE (curr-widget):
     1777           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
     1778              curr-widget:HIDDEN = no THEN DO:
     1779             CASE p-field-setting:
     1780               WHEN "INITIALIZE":U THEN
     1781               DO:
     1782                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
     1783                     read-only-list +
     1784                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
     1785                        STRING(curr-widget).
     1786               END.
     1787               WHEN "DISABLE":U OR
     1788               WHEN "ENABLE":U THEN
     1789               DO:
     1790                   curr-widget:SENSITIVE = yes.
     1791                   RUN get-attribute ('Read-Only-Editors':U).
     1792                   IF RETURN-VALUE = ? OR
     1793                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
     1794                       curr-widget:READ-ONLY =
     1795                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
     1796               END.
     1797               WHEN "CLEAR":U THEN
     1798                   curr-widget:SCREEN-VALUE = "":U.
     1799             END CASE.
     1800           END.
     1801           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
     1802       END.
     1803       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
     1804         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
     1805           + '"':U).
     1806       RETURN.
     1807   END PROCEDURE.
     1808   PROCEDURE use-check-modified-all :
     1809    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1810     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
     1811     RETURN.
     1812   END PROCEDURE.
     1813   PROCEDURE use-create-on-add :
     1814   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1815      RETURN.
     1816   END PROCEDURE.
     1817   PROCEDURE use-initial-lock :
     1818     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1819     ASSIGN adm-initial-lock = p-attr-value.
     1820     RETURN.
     1821   END PROCEDURE.
     1822     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
     1823   ASSIGN
     1824          FRAME F-Main:SCROLLABLE       = FALSE
     1825          FRAME F-Main:HIDDEN           = TRUE.
     1826   ASSIGN
     1827          PostName:READ-ONLY IN FRAME F-Main        = TRUE.
     1828   ON CHOOSE OF bt-col-type IN FRAME F-Main
     1829   DO:
     1830       run select-col-type in this-procedure.
     1831   END.
     1832   ON VALUE-CHANGED OF RADIO-serv IN FRAME F-Main
     1833   DO:
     1834     ASSIGN
     1835       RADIO-serv
     1836     .
     1837     IF RADIO-serv = 2
     1838     THEN DO:
     1839       ASSIGN
     1840           CalcRest = FALSE
     1841       .
     1842       DISPLAY
     1843           CalcRest
     1844       WITH FRAME F-Main.
     1845       DISABLE
     1846           CalcRest
     1847       WITH FRAME F-Main.
     1848     END.
     1849     ELSE DO:
     1850       ENABLE
     1851           CalcRest
     1852       WITH FRAME F-Main.
     1853     END.
     1854   END.
     1855   ON VALUE-CHANGED OF RADPost IN FRAME F-Main
     1856   DO:
     1857      Assign RadPost.
     1858      for each g#post-f :
     1859            delete g#post-f.
     1860      end.
     1861      Case RAdPost :
     1862      when 3
     1863      then DO:
     1864         run str/cli-list.w
     1865            ( my-handle,
     1866               v-cntxt-host-code-obj,
     1867               v-cntxt-obj-type,
     1868               v-cntxt-obj-code)
     1869               .
     1870         Postname = "" .
     1871         For each cli-list :
     1872            create g#post-f.
     1873            assign
     1874               g#post-f.obj-type = cli-list.obj-type
     1875               g#post-f.obj-code = cli-list.obj-code
     1876               g#post-f.obj-name = cli-list.obj-name
     1877               g#post-f.grp-code = cli-list.grp-code
     1878               g#post-f.grp-name = cli-list.grp-name
     1879               Postname = Postname + cli-list.obj-name + chr(10)
     1880            .
     1881         End.
     1882         Display
     1883            PostName
     1884         with frame F-Main .
     1885      END.
     1886      when 1
     1887      then DO:
     1888         Assign
     1889            Postname = ""
     1890         .
     1891         Display
     1892            PostName
     1893         with frame F-Main .
     1894      END.
     1895      when 2
     1896      then do:
     1897         run ref/cli-all.w ( my-handle
     1898                           , "b-sel,b-mark"
     1899                           , 'орг':U
     1900                           , 'все':U
     1901                           , 'текущие':U
     1902                           , ?
     1903                           , ",,,,,,NO,,"
     1904                           , ?
     1905                           , output post-grp_recids
     1906                           ) .
     1907         if post-grp_recids = ""
     1908         then do:
     1909            Assign
     1910               Postname = 'все':U
     1911               radpost = 1
     1912            .
     1913            Display
     1914               PostName
     1915               radpost
     1916            with frame F-Main.
     1917         end.
     1918         else do:
     1919            Assign
     1920               Postname = ''
     1921            .
     1922            DO ii = 1 TO num-entries( post-grp_recids )
     1923            :
     1924               FIND FIRST cli-post
     1925                    where recid( cli-post ) = int(entry( ii, post-grp_recids ))
     1926                    no-lock
     1927                    no-error
     1928                    .
     1929               create g#post-f.
     1930               assign
     1931                  g#post-f.obj-type = cli-post.obj-type
     1932                  g#post-f.obj-code = cli-post.obj-code
     1933                  g#post-f.obj-name = cli-post.obj-name
     1934                  g#post-f.grp-code = cli-post.grp-code
     1935                  g#post-f.grp-name = cli-post.grp-name
     1936                  Postname = PostName + cli-post.obj-name + chr(10)
     1937               .
     1938            END.
     1939            Display PostName with frame F-Main .
     1940         end.
     1941      end.
     1942      End case.
     1943   END.
     1944   define variable  list-com-hand as character no-undo .
     1945   define variable var-r-b as character no-undo .
     1946   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1947   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1948     (output var-r-b
     1949     )  .
     1950   PROCEDURE disable_UI :
     1951     HIDE FRAME F-Main.
     1952     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1953   END PROCEDURE.
     1954   PROCEDURE enable_UI :
     1955     DISPLAY RADIO-serv ie em wm ee im ep ot es ap VAT-SLT re pc rs rz-objecte mp
     1956             we vp CalcRest vt iv ev NullPer rv sl-col-type PostName RADPost
     1957         WITH FRAME F-Main.
     1958     ENABLE RECT-15 RECT-16 RECT-12 RADIO-serv ie em wm ee im ep ot es ap VAT-SLT
     1959            re pc rs rz-objecte mp we vp CalcRest vt iv ev NullPer rv sl-col-type
     1960            bt-col-type PostName RADPost
     1961         WITH FRAME F-Main.
     1962   END PROCEDURE.
     1963   PROCEDURE local-initialize :
     1964   define variable v-void-log    as logical      no-undo .
     1965   define variable v-call-point  as character    no-undo .
     1966   define variable v-naim        as character    no-undo .
     1967   define variable v-list        as character    no-undo .
     1968   define variable v-counter     as integer      no-undo .
     1969   define variable v-found       as logical      no-undo .
     1970   define variable v-widget      as handle       no-undo .
     1971   define variable v-ok          as logical      no-undo .
     1972   v-ok = RADIO-serv:disable (radio-label("2", RADIO-serv:radio-buttons)) in frame F-Main .
     1973      assign
     1974         v-list-edt1 = "Номер документа для печати" + chr(44)
     1975                     + "Номер документа поставщика" + chr(44)
     1976                     + "Номер счет-фактуры" + chr(44)
     1977                     + "Дата счет-фактуры" + chr(44)
     1978                     + "Количество" + chr(44)
     1979                     + "Суммы с НДС"
     1980         v-list-edt2 = "Суммы НДС" + chr(44)
     1981                     + "Суммы без НДС" + chr(44)
     1982                     + "Сумма скидки" + chr(44)
     1983                     + "Дата документа поставщика" + chr(44)
     1984                     + "Наценка с НДС" + chr(44)
     1985                     + "Наценка без НДС" + chr(44)
     1986                     + "Основание"
     1987         v-list-edt = v-list-edt1 + chr(44) + v-list-edt2
     1988         v-list-edt1-full  = "Номер документа для печати" + chr(44)
     1989                           + "Номер документа поставщика" + chr(44)
     1990                           + "Номер счет-фактуры" + chr(44)
     1991                           + "Дата счет-фактуры" + chr(44)
     1992                           + "Количество" + chr(44)
     1993                           + "Суммы с НДС"
     1994         v-list-edt2-full  = "Суммы НДС" + chr(44)
     1995                           + "Суммы без НДС" + chr(44)
     1996                           + "Сумма скидки" + chr(44)
     1997                           + "Дата документа поставщика" + chr(44)
     1998                           + "Наценка с НДС" + chr(44)
     1999                           + "Наценка без НДС" + chr(44)
     2000                           + "Основание"
     2001         v-list-edt-full = v-list-edt1-full + chr(44) +  v-list-edt2-full
     2002         v-widget = FRAME F-Main:FIRST-CHILD
     2003         v-widget = v-widget:FIRST-CHILD
     2004         v-call-point = '':U
     2005      .
     2006      run uf-get ( input v-call-point
     2007                        , input v-cntxt-userid
     2008                        , output v-list
     2009                        , output v-naim
     2010                        , output v-void-log
     2011                        , output v-void-log
     2012                        , output v-void-log
     2013                        , output v-void-log
     2014                        ) .
     2015         DO WHILE  VALID-HANDLE(v-widget)
     2016         :
     2017            IF  v-widget:TYPE = "TOGGLE-BOX":U
     2018            THEN DO:
     2019               ASSIGN
     2020                  v-widget:CHECKED      = LOOKUP (v-widget:NAME, v-list) > 0
     2021               .
     2022            END.
     2023            assign
     2024               v-widget = v-widget:NEXT-SIBLING
     2025            .
     2026         END.
     2027         IF v-naim <> "":U
     2028         THEN DO:
     2029            ASSIGN
     2030               sl-col-type :list-item-pairs = v-naim
     2031            .
     2032         END.
     2033         ELSE DO:
     2034            ASSIGN
     2035               sl-col-type :list-item-pairs = "< Все >,"
     2036            .
     2037         END.
     2038     run dispatch IN THIS-PROCEDURE ( INPUT 'initialize':U ) .
     2039   define variable vss-include-info20 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2040   do:
     2041     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     2042       (input  v-cntxt-db-num
     2043       ,input  v-cntxt-userid
     2044       ,input  0
     2045       ,input  'actn_reports_lookup-cost':U
     2046       ,input  'object':U
     2047       ,input  v-cntxt-host-code-obj
     2048       ,input  v-cntxt-obj-type
     2049       ,input  v-cntxt-obj-code
     2050       ,input  0
     2051       ,input  0
     2052       ,input  0
     2053       ,input  false
     2054       ,output g#log
     2055       )  .
     2056   end.
     2057      if not  g#log then do :
     2058    end.
     2059   END PROCEDURE.
     2060   PROCEDURE my-report :
     2061   define variable v-call-point  as character  no-undo .
     2062   define variable v-naim        as character  no-undo .
     2063   define variable v-list        as character  no-undo .
     2064   define variable v-counter     as integer    no-undo .
     2065   define variable v-widget      as handle     no-undo .
     2066      FOR EACH tdedt:
