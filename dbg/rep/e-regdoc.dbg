      852   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      853   define variable v-uf-List_        like ubflt.usr-flt.List_        no-undo .
      854   define variable v-uf-Naim         like ubflt.usr-flt.Naim         no-undo .
      855   define variable v-uf-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
      856   define variable v-uf-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
      857   define variable v-uf-type-price   like ubflt.usr-flt.type-price   no-undo .
      858   define variable v-uf-type-val     like ubflt.usr-flt.type-val     no-undo .
      859   define temp-table usr-flt_custom-labels no-undo like ub.custom-labels.
      860   procedure uf-name :
      861     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
      862     define output parameter p-use-List_     as logical   no-undo .
      863     define output parameter p-type-List_     as character no-undo .
      864     define output parameter p-format-List_   as character no-undo .
      865     define output parameter p-use-Naim      as logical   no-undo .
      866     define output parameter p-type-Naim      as character no-undo .
      867     define output parameter p-format-Naim    as character no-undo .
      868     define output parameter p-use-print-graft as logical   no-undo .
      869     define output parameter p-use-sort-gr   as logical   no-undo .
      870     define output parameter p-use-type-price as logical   no-undo .
      871     define output parameter p-use-type-val  as logical   no-undo .
      872     define output parameter p-label          as character no-undo .
      873     define output parameter p-tooltip        as character no-undo .
      874     define output parameter p-user-can-edit  as logical   no-undo .
      875     define output parameter p-output-display as logical   no-undo .
      876     define output parameter p-other          as character no-undo .
      877     do
      878     on error undo, return error
      879     :
      880       case p-code :
      881               when 'cli-all-p':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = yes      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Параметры вызова справочника клиентов"     p-tooltip = "Параметры по умолчанию, используемые для вызова справочника клиентов"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      882               when 'oldscode':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(1)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Настройки справочника неиспользуемых весовых кодов"     p-tooltip = "Настройки справочника неиспользуемых весовых кодов"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      883               when 'gds-ref-p':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = yes      p-type-Naim = 'C':U      p-format-Naim = "X(8)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = yes      p-label = "Параметры вызова справочника товаров"     p-tooltip = "Параметры по умолчанию, используемые для вызова справочника товаров"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      884               when 'gds-grp-p':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(1)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Параметры вызова справочника групп товаров"     p-tooltip = "Параметры по умолчанию, используемые для вызова справочника групп товаров"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
