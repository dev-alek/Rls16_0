      806   procedure twowin_add-item :
      807   define input parameter p-ext-key   as character        no-undo.
      808   define input parameter p-item-name as character        no-undo.
      809   define input parameter p-item-desc as character        no-undo.
      810   define input parameter p-selected  as logical          no-undo.
      811       define buffer buf_temp_twowin_items        for temp_twowin_items.
      812   do
      813   for buf_temp_twowin_items
      814   on error undo, return error
      815   :
      816       assign
      817           v-twowin16-itm-key = v-twowin16-itm-key + 1
      818       .
      819       create temp_twowin_items.
      820       assign
      821           temp_twowin_items.itm-key      = v-twowin16-itm-key
      822           temp_twowin_items.itmExtKey    = p-ext-key
      823           temp_twowin_items.itmName      = p-item-name
      824           temp_twowin_items.itmDesc      = p-item-desc
      825           temp_twowin_items.itmSelected  = p-selected
      826           temp_twowin_items.selLeft      = no
      827           temp_twowin_items.selRight     = no
      828       .
      829   end.
      830   end procedure.
