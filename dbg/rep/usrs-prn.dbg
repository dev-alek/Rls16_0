        1   block-level on error undo, throw.
        2   def var vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        3   def var vss-author      as character no-undo init "$Author: expertek $":U .
        4   def var vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        5   def var vss-workfile    as character no-undo init "$Workfile: usrs-prn.p $":U .
        6   def var vss-archive     as character no-undo init "$Archive: rep/usrs-prn.p $":U .
        7   def var vss-description as character no-undo init "Список пользователей системы".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define new global shared variable g#library  as handle no-undo .
       67   define new global shared variable g#library2 as handle no-undo .
       68   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       69   define new shared variable PrintCopiesCounter as integer   no-undo initial 1 .
       70   define new shared variable RepPathName        as character no-undo .
       71   define new shared variable PrintRubl          as logical   no-undo .
       72   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       73   DEF VAR BLACK_COLOR        AS INTEGER NO-UNDO INIT  0.
       74   DEF VAR DARK_BLUE_COLOR    AS INTEGER NO-UNDO INIT  1.
       75   DEF VAR DARK_GREEN_COLOR   AS INTEGER NO-UNDO INIT  2.
       76   DEF VAR CYAN_COLOR         AS INTEGER NO-UNDO INIT  3.
       77   DEF VAR BROWN_COLOR        AS INTEGER NO-UNDO INIT  4.
       78   DEF VAR DARK_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
       79   DEF VAR DARK_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
       80   DEF VAR VERY_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
       81   DEF VAR VERY_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
       82   DEF VAR GRAY_COLOR         AS INTEGER NO-UNDO INIT  8.
       83   DEF VAR GREY_COLOR         AS INTEGER NO-UNDO INIT  8.
       84   DEF VAR BLUE_COLOR         AS INTEGER NO-UNDO INIT  9.
       85   DEF VAR GREEN_COLOR        AS INTEGER NO-UNDO INIT 10.
       86   DEF VAR RED_COLOR          AS INTEGER NO-UNDO INIT 12.
       87   DEF VAR LIGHT_RED_COLOR    AS INTEGER NO-UNDO INIT 13.
       88   DEF VAR YELLOW_COLOR       AS INTEGER NO-UNDO INIT 14.
       89   DEF VAR WHITE_COLOR        AS INTEGER NO-UNDO INIT 15.
       90   define variable vss-include-info2 as character format "X(65)" no-undo
       91   initial "@(#)$Workfile$ $Revision$".
       92       define temp-table Tmp#List no-undo like ub.ord-blank
       93           field id                        as integer
       94           field proc-name                 as character
       95           field proc-param                as character
       96           field print-options             as character
       97           field orient                    as character
       98           field orient-orientation        as character
       99           field orient-font-num           as integer
      100           field font-num                  as character
      101           field filtr                     as character
      102           field view_                     as integer  init 1
      103           field sys-key                   as character
      104           field sys-key-black             as character
      105           field type-parts                as character
      106           field type-parts-enabled        as logical
      107           field type-price                as character
      108           field type-price-enabled        as logical
      109           field type-scale                as character
      110           field type-scale-enabled        as logical
      111           field type-val                  as character
      112           field type-val-enabled          as logical
      113           field sort-name                 as character
      114           field sort-name-enabled         as logical
      115           field sort-gr                   as character
      116           field sort-gr-enabled           as logical
      117           field print-graft               as character
      118           field print-graft-enabled       as logical
      119           field no-vat                    as character
      120           field no-vat-enabled            as logical
      121           index pi is primary unique id
      122           index in-name
      123              blank-name
      124           index lu
      125               last-use
      126       .
      127       define temp-table temp_form-list no-undo
      128           field doc-code  as character
      129           field id        as integer
      130           field doc-type  as character
      131           field status_   as character
      132           field internal  as character
      133           field flag      as character
      134           index pi is primary unique
      135               doc-code
      136               id
      137           index idx
      138               id
      139       .
      140       define temp-table temp_menu-doc_disabled-doc-list no-undo
      141           field doc-code      as character
      142           field blank-name    as character
      143           field reason        as character
      144           index pi is primary unique
      145                   doc-code
      146                   blank-name
      147       .
      148       define variable v-menu-doc-sys-key              as character    no-undo.
      149       define variable v-menu-doc-doc-code             as character    no-undo.
      150       define variable v-menu-doc-doc-type             as character    no-undo.
      151       define variable v-menu-doc-ext-doc-type         as character    no-undo.
      152       define variable v-menu-doc-status_              as character    no-undo.
      153       define variable v-menu-doc-internal             as character    no-undo.
      154       define variable v-menu-doc-flag                 as character    no-undo.
      155       define variable v-menu-doc-item-counter         as integer      no-undo.
      156       define variable v-menu-doc-item-disabled        as logical      no-undo.
      157   define variable vss-include-info3 as character format "X(65)":U no-undo initial "@(#)$Workfile$ $Revision$".
      158   function check-entry-with-mask returns logical ( input p-element as character, input p-list as character, input p-delimiter as character ) :
      159     define variable p-entry   as logical   no-undo .
      160     define variable v-ind as integer   no-undo .
      161     if p-delimiter = "*":U then do:
      162       message
      163         vss-workfile "(check-entry-with-mask)" vss-revision vss-description skip
      164         substitute('Разделитель не может быть равный "&1"', p-delimiter ) skip
      165         view-as alert-box error .
      166       return ? .
      167     end.
      168     assign
      169       p-entry = true
      170     .
      171     if lookup( p-element, p-list, p-delimiter ) = 0 then do:
      172       assign
      173         p-entry = false
      174       .
      175       if num-entries( p-list, "*":U ) > 1 then do:
      176         block_check-list:
      177         do v-ind = 1 to num-entries( p-list, p-delimiter )
      178         :
      179           if p-element matches entry( v-ind, p-list, p-delimiter ) then do:
      180             assign
      181               p-entry = true
      182             .
      183             leave block_check-list .
      184           end.
      185         end.
      186       end.
      187     end.
      188     return p-entry .
      189   end function .
      190       procedure menu-doc-create-menu-item
      191       :
      192       define input parameter p-type   as   character no-undo.
      193       define input parameter p-stat   as   character no-undo.
      194       define input parameter p-intr   as   character no-undo.
      195       define input parameter p-flag   as   character no-undo.
      196       define input parameter param-1  as   character no-undo.
      197       define input parameter param-2  as   character no-undo.
      198       define input parameter param-3  as   character no-undo.
      199       define input parameter param-4  as   character no-undo.
      200       define input parameter param-5  as   character no-undo.
      201       define input parameter param-6  as   character no-undo.
      202       define input parameter param-7  as   character no-undo.
      203       define input parameter param-8  as   character no-undo.
      204       define input parameter param-9  as   character no-undo.
      205       define input parameter param-10 as   character no-undo.
      206       define input parameter param-11 as   character no-undo.
      207       define input parameter param-12 as   character no-undo.
      208       do
      209       on error undo, return error
      210       :
      211           assign
      212               v-menu-doc-item-disabled = yes
      213           .
      214           if v-menu-doc-sys-key <> 'ExpertekIBS':U
      215           and ( ( param-10 <> "":U
      216                   and check-entry-with-mask( v-menu-doc-sys-key, param-10, chr(44) ) = false
      217                 )
      218                 or ( param-12 <> "":U
      219                      and check-entry-with-mask( v-menu-doc-sys-key, param-12, chr(44) ) = true )
      220                    )
      221           then do:
      222               undo, return .
      223           end.
      224           if param-7 = "":U
      225           then do:
      226               undo, return .
      227           end.
      228           if param-1 = '*':U
      229           or lookup( p-type, param-1 ) > 0
      230           then do:
      231               if param-2 = '*':U
      232               or lookup( p-stat, param-2 ) > 0
      233               then do:
      234                   if param-3 = '*':U
      235                   or lookup( p-intr, param-3 ) > 0
      236                   then do:
      237                       if param-4 = '*':U
      238                       or lookup( p-flag, param-4 ) > 0
      239                       then do:
      240                           assign
      241                               v-menu-doc-item-disabled = no
      242                           .
      243                           find first tmp#list
      244                                where tmp#list.blank-name     = param-5
      245                                  and tmp#list.filtr          = param-6
      246                                  and tmp#list.proc-name      = param-7
      247                                  and tmp#list.proc-param     = param-8
      248                                  and tmp#list.print-options  = param-9
      249                                  and tmp#list.sys-key        = param-10
      250                                  and tmp#list.orient         = param-11
      251                                  and tmp#list.sys-key-black  = param-12
      252                           no-error.
      253                           if not available tmp#list
      254                           then do:
      255                               assign
      256                                   v-menu-doc-item-counter = v-menu-doc-item-counter + 1
      257                               .
      258                               create tmp#list.
      259                               assign
      260                                   tmp#list.id             = v-menu-doc-item-counter
      261                                   tmp#list.cli-code       = v-menu-doc-item-counter
      262                                   tmp#list.blank-name     = param-5
      263                                   tmp#list.filtr          = param-6
      264                                   tmp#list.proc-name      = param-7
      265                                   tmp#list.proc-param     = param-8
      266                                   tmp#list.print-options  = param-9
      267                                   tmp#list.sys-key        = param-10
      268                                   tmp#list.orient         = param-11
      269                                   tmp#list.sys-key-black  = param-12
      270                               .
      271                               assign
      272                                   tmp#list.orient-orientation     = entry( 1, tmp#list.orient )
      273                                   tmp#list.orient-font-num        = 7
      274                               .
      275                               assign
      276                                   tmp#list.orient-font-num      = ( if num-entries( tmp#list.orient ) > 1
      277                                                                     then integer( entry( 2, tmp#list.orient ) )
      278                                                                     else 7 )
      279                               no-error.
      280                               if error-status :error
      281                               then do:
      282                                   assign
      283                                       tmp#list.orient-font-num = 7
      284                                   .
      285                               end.
      286                               run menu-doc-set-visible-options in this-procedure (
      287                                     input tmp#list.print-options
      288                                   , output tmp#list.type-parts-enabled
      289                                   , output tmp#list.type-price-enabled
      290                                   , output tmp#list.type-scale-enabled
      291                                   , output tmp#list.type-val-enabled
      292                                   , output tmp#list.sort-name-enabled
      293                                   , output tmp#list.sort-gr-enabled
      294                                   , output tmp#list.print-graft-enabled
      295                                   , output tmp#list.no-vat-enabled
      296                               ).
      297                           end.
      298                       end.
      299                   end.
      300               end.
      301           end.
      302           if v-menu-doc-item-disabled = yes
      303           then do:
      304               find first tmp#list
      305                    where tmp#list.blank-name     = param-5
      306                      and tmp#list.filtr          = param-6
      307                      and tmp#list.proc-name      = param-7
      308                      and tmp#list.proc-param     = param-8
      309                      and tmp#list.print-options  = param-9
      310                      and tmp#list.sys-key        = param-10
      311                      and tmp#list.orient         = param-11
      312                      and tmp#list.sys-key-black  = param-12
      313               no-error.
      314               if available tmp#list
      315               then do:
      316                   find first temp_menu-doc_disabled-doc-list
      317                        where temp_menu-doc_disabled-doc-list.doc-code     = v-menu-doc-doc-code
      318                          and temp_menu-doc_disabled-doc-list.blank-name   = param-5
      319                   no-error.
      320                   if not available temp_menu-doc_disabled-doc-list
      321                   then do:
      322                       create temp_menu-doc_disabled-doc-list.
      323                       assign
      324                           temp_menu-doc_disabled-doc-list.doc-code    = v-menu-doc-doc-code
      325                           temp_menu-doc_disabled-doc-list.blank-name  = param-5
      326                       .
      327                   end.
      328                   if param-1 <> '*':U
      329                   and lookup( p-type, param-1 ) > 0
      330                   then do:
      331                       assign
      332                           temp_menu-doc_disabled-doc-list.reason   = "type":U
      333                       .
      334                   end.
      335                   assign
      336                       temp_menu-doc_disabled-doc-list.reason = temp_menu-doc_disabled-doc-list.reason + ",":U
      337                   .
      338                   if param-2 <> '*':U
      339                   and lookup( p-stat, param-2 ) > 0
      340                   then do:
      341                       assign
      342                           temp_menu-doc_disabled-doc-list.reason = temp_menu-doc_disabled-doc-list.reason + "stat":U
      343                       .
      344                   end.
      345                   assign
      346                       temp_menu-doc_disabled-doc-list.reason = temp_menu-doc_disabled-doc-list.reason + ",":U
      347                   .
      348                   if param-3 <> '*':U
      349                   and lookup( p-intr, param-3 ) > 0
      350                   then do:
      351                       assign
      352                           temp_menu-doc_disabled-doc-list.reason = temp_menu-doc_disabled-doc-list.reason + "intr":U
      353                       .
      354                   end.
      355                   assign
      356                       temp_menu-doc_disabled-doc-list.reason = temp_menu-doc_disabled-doc-list.reason + ",":U
      357                   .
      358                   if param-4 <> '*':U
      359                   and lookup( p-flag, param-4 ) > 0
      360                   then do:
      361                       assign
      362                           temp_menu-doc_disabled-doc-list.reason = temp_menu-doc_disabled-doc-list.reason + "flag":U
      363                       .
      364                   end.
      365                   if v-menu-doc-sys-key = 'ExpertekIBS':U
      366                   then do:
      367                       run menu-doc-extend-blank-name-for-IBS in this-procedure (
      368                             input tmp#list.blank-name
      369                           , input tmp#list.sys-key
      370                           , input Tmp#List.sys-key-black
      371                           , output tmp#list.blank-name
      372                       ).
      373                   end.
      374               end.
      375               else do:
      376                   assign
      377                       v-menu-doc-item-disabled = no
      378                   .
      379               end.
      380           end.
      381           if v-menu-doc-item-disabled = no
      382           then do:
      383               find first tmp#list
      384                    where tmp#list.blank-name     = param-5
      385                      and tmp#list.filtr          = param-6
      386                      and tmp#list.proc-name      = param-7
      387                      and tmp#list.proc-param     = param-8
      388                      and tmp#list.print-options  = param-9
      389                      and tmp#list.sys-key        = param-10
      390                      and tmp#list.orient         = param-11
      391                      and tmp#list.sys-key-black  = param-12
      392               no-error.
      393               if available tmp#list
      394               then do:
      395                   find first temp_form-list
      396                        where temp_form-list.doc-code  = v-menu-doc-doc-code
      397                          and temp_form-list.id        = tmp#list.id
      398                   no-error.
      399                   if not available temp_form-list
      400                   then do:
      401                       create temp_form-list.
      402                       assign
      403                           temp_form-list.doc-code  = v-menu-doc-doc-code
      404                           temp_form-list.id        = tmp#list.id
      405                           temp_form-list.doc-type  = v-menu-doc-doc-type
      406                           temp_form-list.status_   = v-menu-doc-status_
      407                           temp_form-list.internal  = v-menu-doc-internal
      408                           temp_form-list.flag      = v-menu-doc-flag
      409                       .
      410                   end.
      411                   if v-menu-doc-sys-key = 'ExpertekIBS':U
      412                   then do:
      413                       run menu-doc-extend-blank-name-for-IBS in this-procedure (
      414                             input tmp#list.blank-name
      415                           , input tmp#list.sys-key
      416                           , input Tmp#List.sys-key-black
      417                           , output tmp#list.blank-name
      418                       ).
      419                   end.
      420               end.
      421           end.
      422       end.
      423       end procedure.
      424       procedure menu-doc-set-visible-options :
      425       define input parameter p-print-options          as character        no-undo.
      426       define output parameter p-type-parts-enabled    as logical          no-undo.
      427       define output parameter p-type-price-enabled    as logical          no-undo.
      428       define output parameter p-type-scale-enabled    as logical          no-undo.
      429       define output parameter p-type-val-enabled      as logical          no-undo.
      430       define output parameter p-sort-name-enabled     as logical          no-undo.
      431       define output parameter p-sort-gr-enabled       as logical          no-undo.
      432       define output parameter p-print-graft-enabled   as logical          no-undo.
      433       define output parameter p-no-vat-enabled        as logical          no-undo.
      434       do
      435       on error undo, return error
      436       :
      437           assign
      438               p-type-parts-enabled    = ( if substring( p-print-options, 1, 1 ) = "+" then yes else no )
      439               p-type-price-enabled    = ( if substring( p-print-options, 2, 1 ) = "+" then yes else no )
      440               p-type-scale-enabled    = ( if substring( p-print-options, 3, 1 ) = "+" then yes else no )
      441               p-type-val-enabled      = ( if substring( p-print-options, 4, 1 ) = "+" then yes else no )
      442               p-sort-name-enabled     = ( if substring( p-print-options, 5, 1 ) = "+" then yes else no )
      443               p-sort-gr-enabled       = ( if substring( p-print-options, 6, 1 ) = "+" then yes else no )
      444               p-print-graft-enabled   = ( if substring( p-print-options, 7, 1 ) = "+" then yes else no )
      445               p-no-vat-enabled        = ( if substring( p-print-options, 8, 1 ) = "+" then yes else no )
      446           .
      447       end.
      448       end procedure.
      449       procedure menu-doc-create-options-string :
      450       define input parameter p-tmp-list-id        as integer          no-undo.
      451       define output parameter p-options-string    as character        no-undo.
      452           define buffer buf_tmp#list      for tmp#list.
      453       do
      454       for buf_tmp#list
      455       on error undo, return error
      456       :
      457           find first buf_tmp#list
      458                where buf_tmp#list.id = p-tmp-list-id
      459           .
      460           assign
      461               p-options-string =  ( if trim( buf_tmp#list.type-parts  ) = "+":U then "+":U else "-":U )
      462                                 + ( if trim( buf_tmp#list.type-price  ) = "+":U then "+":U else "-":U )
      463                                 + ( if trim( buf_tmp#list.type-scale  ) = "+":U then "+":U else "-":U )
      464                                 + ( if trim( buf_tmp#list.type-val    ) = "+":U then "+":U else "-":U )
      465                                 + ( if trim( buf_tmp#list.sort-name   ) = "+":U then "+":U else "-":U )
      466                                 + ( if trim( buf_tmp#list.sort-gr     ) = "+":U then "+":U else "-":U )
      467                                 + ( if trim( buf_tmp#list.print-graft ) = "+":U then "+":U else "-":U )
      468                                 + ( if trim( buf_tmp#list.no-vat      ) = "+":U then "+":U else "-":U )
      469           .
      470       end.
      471       end procedure.
      472       procedure menu-doc-set-options-string :
      473       define input parameter p-tmp-list-id            as integer          no-undo.
      474       define input parameter p-options-string         as character        no-undo.
      475           define buffer buf_tmp#list      for tmp#list.
      476       do
      477       for buf_tmp#list
      478       on error undo, return error
      479       :
      480           find first buf_tmp#list
      481                where buf_tmp#list.id = p-tmp-list-id
      482           .
      483           assign
      484               buf_tmp#list.type-parts  = ( if buf_tmp#list.type-parts-enabled     = yes then substitute( "  &1", substring( p-options-string, 1, 1 ) ) else " ":U )
      485               buf_tmp#list.type-price  = ( if buf_tmp#list.type-price-enabled     = yes then substitute( "  &1", substring( p-options-string, 2, 1 ) ) else " ":U )
      486               buf_tmp#list.type-scale  = ( if buf_tmp#list.type-scale-enabled     = yes then substitute( "  &1", substring( p-options-string, 3, 1 ) ) else " ":U )
      487               buf_tmp#list.type-val    = ( if buf_tmp#list.type-val-enabled       = yes then substitute( "  &1", substring( p-options-string, 4, 1 ) ) else " ":U )
      488               buf_tmp#list.sort-name   = ( if buf_tmp#list.sort-name-enabled      = yes then substitute( "  &1", substring( p-options-string, 5, 1 ) ) else " ":U )
      489               buf_tmp#list.sort-gr     = ( if buf_tmp#list.sort-gr-enabled        = yes then substitute( "  &1", substring( p-options-string, 6, 1 ) ) else " ":U )
      490               buf_tmp#list.print-graft = ( if buf_tmp#list.print-graft-enabled    = yes then substitute( "  &1", substring( p-options-string, 7, 1 ) ) else " ":U )
      491               buf_tmp#list.no-vat      = ( if buf_tmp#list.no-vat-enabled         = yes then substitute( "  &1", substring( p-options-string, 8, 1 ) ) else " ":U )
      492           .
      493       end.
      494       end procedure.
      495       procedure menu-doc-create-options-enabled-string :
      496       define input parameter p-tmp-list-id                as integer          no-undo.
      497       define output parameter p-options-enabled-string    as character        no-undo.
      498           define buffer buf_tmp#list      for tmp#list.
      499       do
      500       for buf_tmp#list
      501       on error undo, return error
      502       :
      503           find first buf_tmp#list
      504                where buf_tmp#list.id = p-tmp-list-id
      505           .
      506           assign
      507               p-options-enabled-string =  ( if buf_tmp#list.type-parts-enabled  = yes then "+":U else "-":U )
      508                                         + ( if buf_tmp#list.type-price-enabled  = yes then "+":U else "-":U )
      509                                         + ( if buf_tmp#list.type-scale-enabled  = yes then "+":U else "-":U )
      510                                         + ( if buf_tmp#list.type-val-enabled    = yes then "+":U else "-":U )
      511                                         + ( if buf_tmp#list.sort-name-enabled   = yes then "+":U else "-":U )
      512                                         + ( if buf_tmp#list.sort-gr-enabled     = yes then "+":U else "-":U )
      513                                         + ( if buf_tmp#list.print-graft-enabled = yes then "+":U else "-":U )
      514                                         + ( if buf_tmp#list.no-vat-enabled      = yes then "+":U else "-":U )
      515           .
      516       end.
      517       end procedure.
      518       procedure menu-doc-extend-blank-name-for-IBS :
      519       define input parameter p-in-blank-name      as character        no-undo.
      520       define input parameter p-sys-key            as character        no-undo.
      521       define input parameter p-sys-key-black      as character        no-undo.
      522       define output parameter p-out-blank-name    as character        no-undo.
      523       do
      524       on error undo, return error
      525       :
      526           assign
      527               p-out-blank-name = p-in-blank-name
      528           .
      529           if p-sys-key <> "":U
      530           then do:
      531               assign
      532                   p-out-blank-name = substring( p-in-blank-name + " '" + p-sys-key + "'" , 1, 120 )
      533               .
      534           end.
      535           if p-sys-key-black <> ""
      536           then do:
      537               assign
      538                   p-out-blank-name = substring( p-in-blank-name + " no-'" + p-sys-key-black + "'", 1, 120 )
      539               .
      540           end.
      541       end.
      542       end procedure.
      543   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      544     define variable v-cntxt-db-num        as integer   no-undo .
      545     define variable v-cntxt-userid        as character no-undo .
      546     define variable v-cntxt-level         as character no-undo .
      547     define variable v-cntxt-host-code-obj as integer   no-undo .
      548     define variable v-cntxt-obj-type      as character no-undo .
      549     define variable v-cntxt-obj-code      as integer   no-undo .
      550     define variable v-cntxt-db-num-obj    as integer   no-undo .
      551     define variable v-cntxt-is-admin      as logical   no-undo .
      552   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      553   procedure cur-time :
      554      define output parameter p-today as date      no-undo .
      555      define output parameter p-time  as integer   no-undo .
      556     do
      557     on error undo, return error
      558     :
      559       define variable v-date1 as date      no-undo .
      560       define variable v-date2 as date      no-undo .
      561       define variable v-time  as integer   no-undo .
      562       assign
      563         v-date1 = today
      564         v-time  = time
      565         v-date2 = today
      566       .
      567       if v-date1 <> v-date2
      568       then do:
      569         assign
      570           v-date1 = today
      571           v-time  = v-time
      572         .
      573       end.
      574       assign
      575         p-today = v-date1
      576         p-time  = v-time
      577       .
      578     end.
      579   end.
      580   function cur-time-date returns character
      581   :
      582     return string(today, '99/99/9999':U) .
      583   end.
      584   function cur-time-mjd returns decimal
      585   :
      586     define variable v-date as date      no-undo .
      587     define variable v-time as integer   no-undo .
      588     run cur-time in this-procedure
      589       (output v-date
      590       ,output v-time
      591       ) .
      592     return integer(v-date) - 2400002 + (v-time / 86400) .
      593   end.
      594   function cur-time-get-ending-index returns integer
      595   (input p-number as integer
      596   )
      597   :
      598     if p-number < 0
      599     or p-number = ?
      600     then do:
      601       return 1 .
      602     end.
      603     define variable v-rest as integer   no-undo .
      604     assign
      605       p-number = p-number modulo 100
      606     .
      607     if p-number < 20
      608     then do:
      609       assign
      610         v-rest = p-number
      611       .
      612     end.
      613     else do:
      614       assign
      615         v-rest = p-number modulo 10
      616       .
      617     end.
      618     case v-rest :
      619       when 1
      620       then do:
      621         return 2 .
      622       end.
      623       when 2 or
      624       when 3 or
      625       when 4
      626       then do:
      627         return 3 .
      628       end.
      629       otherwise do:
      630         return 1 .
      631       end.
      632     end case .
      633   end.
      634   procedure cur-time-mjd-to-date :
      635      define input  parameter i-mjd-diff as decimal no-undo.
      636      define output parameter o-Date     as date    no-undo.
      637      define output parameter o-Time     as integer no-undo.
      638      define variable v-day-number as integer   no-undo .
      639      if    i-mjd-diff < 0
      640         or i-mjd-diff = ?
      641      then do:
      642         return "?" .
      643      end.
      644      assign
      645         v-day-number = truncate(i-mjd-diff,0).
      646         o-Date = date(v-day-number + 2400002).
      647         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      648     .
      649   end.
      650   function cur-time-mjd-to-string returns character
      651   (input p-mjd-diff as decimal
      652   )
      653   :
      654     define variable v-day-number as integer   no-undo .
      655     define variable v-seconds    as integer   no-undo .
      656     define variable v-hour       as integer   no-undo .
      657     define variable v-min        as integer   no-undo .
      658     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      659     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      660     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      661     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      662     if p-mjd-diff < 0
      663     or p-mjd-diff = ?
      664     then do:
      665       return "?" .
      666     end.
      667     assign
      668       v-day-number = integer(truncate(p-mjd-diff,0))
      669       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      670     .
      671     if v-seconds > 86400
      672     then do:
      673       assign
      674         v-seconds = 86400 - 1
      675       .
      676     end.
      677     if v-seconds < 0
      678     then do:
      679       assign
      680         v-seconds = 0
      681       .
      682     end.
      683     assign
      684       v-hour = truncate(v-seconds / 3600, 0)
      685     .
      686     assign
      687       v-seconds = v-seconds modulo 3600
      688     .
      689     assign
      690       v-min = truncate(v-seconds / 60, 0)
      691     .
      692     assign
      693       v-seconds = v-seconds modulo 60
      694     .
      695     return
      696         (if v-day-number <> 0
      697           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      698           else ""
      699         )
      700       + (if v-day-number <> 0 or v-hour <> 0
      701           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      702           else ""
      703         )
      704       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      705           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      706           else ""
      707         )
      708       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      709       .
      710   end.
      711   function cur-time-string returns character
      712   :
      713     define variable v-date as date      no-undo .
      714     define variable v-time as integer   no-undo .
      715     run cur-time in this-procedure
      716       (output v-date
      717       ,output v-time
      718       ) .
      719     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      720   end.
      721   function cur-time-string-sec returns character
      722   :
      723     define variable v-date as date      no-undo .
      724     define variable v-time as integer   no-undo .
      725     run cur-time in this-procedure
      726       (output v-date
      727       ,output v-time
      728       ) .
      729     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      730   end.
      731   function cur-time-custom  returns character
      732   (input p-prefix as character
      733   ,input p-date-format as character
      734   ,input p-delimiter as character
      735   ,input p-time-format as character
      736   ,input p-suffix as character
      737   )
      738   :
      739     define variable v-date as date      no-undo .
      740     define variable v-time as integer   no-undo .
      741     run cur-time in this-procedure
      742       (output v-date
      743       ,output v-time
      744       ) .
      745     return
      746       p-prefix
      747       + string(v-date, p-date-format)
      748       + p-delimiter
      749       + string(v-time, p-time-format)
      750       + p-suffix
      751       .
      752   end.
      753   function cur-time-print  returns character
      754   :
      755     define variable v-date as date      no-undo .
      756     define variable v-time as integer   no-undo .
      757     run cur-time in this-procedure
      758       (output v-date
      759       ,output v-time
      760       ) .
      761     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      762   end.
      763   function cur-time-datetime returns datetime
      764   :
      765     define variable v-char as character no-undo .
      766     define variable v-datetime as datetime no-undo .
      767     v-char = cur-time-string().
      768     v-datetime = datetime(v-char).
      769     return  v-datetime.
      770   end.
      771   function cur-time-string-msec returns character
      772   :
      773     define variable v-date as datetime  no-undo .
      774     v-date = now.
      775     return string(v-date) .
      776   end.
      777   define input  parameter parparentproc as widget-handle no-undo .
      778   define input parameter p-user-id like user-account.user-id no-undo.
      779   define input parameter p-db-num  AS INTEGER no-undo.
      780   DEFINE STREAM out-stream .
      781   DEFINE VARIABLE LineCounter AS INTEGER INITIAL 0   NO-UNDO .
      782   define variable v-user-action   as character no-undo .
      783   define variable v-printed       as logical   no-undo .
      784   define variable Line            as character no-undo.
      785   define variable g#report-num              as integer              no-undo .
      786   def var sym1 as char init ":!:"   no-undo.
      787   def var sym2 as char init ":!:"   no-undo.
      788   def var sym3 as char init ":!:"   no-undo.
      789   MESSAGE 123
      790   view-as alert-box.
      791   run get-report-num in parparentproc (output g#report-num).
      792   output stream out-stream to value( string( session:temp-directory +
      793                                        "rpt" + string( g#report-num ) ) )
      794                                        page-size  value(62) .
      795   DEFINE FRAME main
      796       sym1 column-label ":!:" format "x(1)"
      797       clients.obj-name     column-label "Макс. скидка / Объекты / Армы! " format "x(100)"
      798       sym2 column-label ":!:" format "x(1)"
      799       action-role.action-role-name  column-label "Группа прав! "
      800       sym3 column-label ":!:" format "x(1)"
      801       HEADER
      802           cur-time-print() AT 5 format "x(35)"
      803               string( "Страница " + string (PAGE-NUMBER( out-stream ) , ">>9") )
      804                       AT 45 format "X(15)" SKIP
      805           Line format "X(127)" AT 1
      806   with width 160 down stream-io .
      807   FORM HEADER
      808         Line format "X(127)" SKIP
      809         "Продолжение - на следующей странице" AT 30 SKIP
      810         with FRAME BottomFrame width 160 PAGE-BOTTOM NO-LABELS NO-BOX .
      811         VIEW stream out-stream FRAME BottomFrame .
      812   if session:set-wait-state("compiler") then.
      813   Line = fill("-", 140).
      814   FORM with FRAME main .
      815   if p-user-id = ? then
      816       PUT STREAM out-stream SPACE(30) "С П И С О К    П О Л Ь З О В А Т Е Л Е Й  С И С Т Е М Ы" FORMAT "X(127)" SKIP.
      817   account_:
      818   FOR EACH  user-account
      819       WHERE user-account.user-id = p-user-id
      820       OR    p-user-id = ?
      821       NO-LOCK
      822       :
      823          FIND FIRST user-login
      824               WHERE user-login.user-id = p-user-id
      825                 AND (user-login.db-num  = p-db-num
      826                              )
      827               NO-LOCK
      828               NO-ERROR
      829               .
      830          IF NOT AVAILABLE user-login THEN DO:
      831             NEXT account_.
      832          END.
      833          FIND FIRST _user WHERE _user._userid = user-login.user-login NO-LOCK NO-ERROR.
      834          if NOT available _user then
      835              do:
      836                  message string('Пользователь "' + user-account.user-id + '" не найден в таблице _user!') view-as alert-box ERROR.
      837                  NEXT.
      838              end.
      839          LineCounter = LineCounter + 1 .
      840          DISPLAY stream  out-stream
      841              sym1
      842              string( string( LineCounter, ">>9" )
      843                    + ") Пользователь: "
      844                    + trim( _user._user-name )
      845                    ) @ clients.obj-name
      846              sym3
      847              with FRAME main .
      848          DOWN stream  out-stream 1 with FRAME main .
      849          DISPLAY stream  out-stream
      850              sym1
      851              string( "     Макс. скидка: " + trim( string( user-login.max-discnt ) ) + " %" ) @ clients.obj-name
      852              sym2 sym3
      853              with FRAME main .
      854          DOWN stream  out-stream 1 with FRAME main .
      855          DISPLAY stream  out-stream
      856              sym1 "     Объекты:" @ clients.obj-name
      857              sym2 sym3
      858          with FRAME main .
      859          DOWN stream  out-stream 1 with FRAME main .
      860          FOR EACH  user-login-action-role
      861              WHERE user-login-action-role.user-id             = user-account.user-id
      862                and user-login-action-role.db-num              = p-db-num
      863                and user-login-action-role.action-role-context = 'object':U
      864              NO-LOCK,
      865              FIRST action-role
      866              WHERE action-role.db-num           = p-db-num
      867                AND action-role.action-head-code = 0
      868                AND action-role.action-role-code = user-login-action-role.action-role-code
      869              NO-LOCK
      870              :
      871               FIND FIRST clients
      872                    WHERE clients.obj-type = user-login-action-role.obj-type
      873                    AND   clients.obj-code = user-login-action-role.obj-code
      874                    NO-LOCK
      875                    NO-ERROR.
      876               IF NOT AVAILABLE clients THEN
      877                   DO:
      878                       MESSAGE STRING('В ДБ нет объекта "' + user-login-action-role.obj-type + ' ' + string(user-login-action-role.obj-code) + '" принадлежащего пользователю ' + trim( _user._user-name ) ) view-as alert-box ERROR.
      879                       NEXT.
      880                   END.
      881               DISPLAY stream  out-stream
      882                   sym1 clients.obj-name
      883                   sym2 action-role.action-role-name
      884                   sym3
      885               WITH FRAME main .
      886               DOWN STREAM  out-stream 1 with FRAME main .
      887          END.
      888          DISPLAY stream  out-stream
      889              sym1 "     Армы:" @ clients.obj-name
      890              sym2 sym3
      891              with FRAME main .
      892          DOWN stream  out-stream 1 with FRAME main .
      893          FOR EACH  user-login-action-role
      894              WHERE user-login-action-role.user-id             = user-account.user-id
      895                and user-login-action-role.db-num              = p-db-num
      896                and user-login-action-role.action-role-context = 'firm':U
      897              NO-LOCK,
      898              FIRST action-role
      899              WHERE action-role.db-num           = p-db-num
      900                AND action-role.action-head-code = 0
      901                AND action-role.action-role-code = user-login-action-role.action-role-code
      902              NO-LOCK
      903              :
      904              DISPLAY stream out-stream
      905                  sym1
      906                  string( "фирма " + string(user-login-action-role.host-code) + ")" ) @ clients.obj-name
      907                  sym2 action-role.action-role-name @ action-role.action-role-name
      908                  sym3
      909                  with FRAME main .
      910              DOWN stream  out-stream 1 with FRAME main .
      911          END.
      912   END.
      913   IF ( LINE-COUNTER( out-stream ) + 1 ) > PAGE-SIZE( out-stream )
      914   THEN PAGE STREAM out-stream .
      915   PUT STREAM out-stream Line FORMAT "X(127)" SKIP.
      916   HIDE STREAM out-stream FRAME BottomFrame .
      917   OUTPUT STREAM out-stream CLOSE.
      918   run gbl/prnfilen.w
      919                      ( input  "":U
      920                      , input  0
      921                      , input  string(session :temp-directory)
      922                             + "rpt"
      923                             + string( g#report-num )
      924                      , input  7
      925                      , output v-user-action
      926                      , output v-printed
      927                      ) .
