      679   define temp-table temp_twowin_items no-undo
      680       field itm-key       as integer
      681       field itmExtKey     as character
      682       field itmName       as character
      683       field itmDesc       as character
      684       field itmSelected   as logical
      685       field selLeft       as logical
      686       field selRight      as logical
      687       index pi is primary unique
      688           itm-key
      689       index ie
      690           itmExtKey
      691   .
      692   define temp-table temp_twowin_itemsSelected no-undo
      693       field its-key   as integer
      694       field itm-key   as integer
      695       field itmExtKey as character
      696       index pi is primary unique
      697           its-key
      698       index im
      699           itm-key
      700   .
      701   define variable v-twowin13-itm-key    as integer      no-undo.
      702   procedure twowin_clear :
      703       define buffer buf_temp_twowin_items        for temp_twowin_items.
      704   do
      705   for buf_temp_twowin_items
      706   on error undo, return error
      707   :
      708       empty temp-table buf_temp_twowin_items.
      709   end.
      710   end procedure.
      711   procedure twowin_add-item :
      712   define input parameter p-ext-key   as character        no-undo.
      713   define input parameter p-item-name as character        no-undo.
      714   define input parameter p-item-desc as character        no-undo.
      715   define input parameter p-selected  as logical          no-undo.
      716       define buffer buf_temp_twowin_items        for temp_twowin_items.
      717   do
      718   for buf_temp_twowin_items
      719   on error undo, return error
      720   :
      721       assign
      722           v-twowin13-itm-key = v-twowin13-itm-key + 1
      723       .
      724       create temp_twowin_items.
      725       assign
      726           temp_twowin_items.itm-key      = v-twowin13-itm-key
      727           temp_twowin_items.itmExtKey    = p-ext-key
      728           temp_twowin_items.itmName      = p-item-name
      729           temp_twowin_items.itmDesc      = p-item-desc
      730           temp_twowin_items.itmSelected  = p-selected
      731           temp_twowin_items.selLeft      = no
      732           temp_twowin_items.selRight     = no
      733       .
      734   end.
      735   end procedure.
      736   CREATE WIDGET-POOL.
      737   def var State-source as  WIDGET-HANDLE.
      738   define variable loc-ref-list as character no-undo .
      739   DEFINE RECTANGLE RECT-7
      740        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      741        SIZE 46.5 BY 6.25.
      742   DEFINE VARIABLE cb-at AS LOGICAL INITIAL yes
      743        LABEL "Прочие"
      744        VIEW-AS TOGGLE-BOX
      745        SIZE 11.13 BY .83 NO-UNDO.
      746   DEFINE VARIABLE cb-money AS LOGICAL INITIAL yes
      747        LABEL "Деньги или денежный эквивалент"
      748        VIEW-AS TOGGLE-BOX
      749        SIZE 33 BY .83 NO-UNDO.
      750   DEFINE VARIABLE cb-ser AS LOGICAL INITIAL yes
      751        LABEL "Серийные"
      752        VIEW-AS TOGGLE-BOX
      753        SIZE 11.13 BY .83 NO-UNDO.
      754   DEFINE FRAME F-Main
      755        cb-money AT ROW 3 COL 7.5 WIDGET-ID 20
      756        cb-ser AT ROW 4.25 COL 7.5 WIDGET-ID 22
      757        cb-at AT ROW 5.5 COL 7.5 WIDGET-ID 24
      758        "Учитывать типы МЦ:" VIEW-AS TEXT
      759             SIZE 19 BY .67 AT ROW 1.75 COL 3.5 WIDGET-ID 18
      760             FGCOLOR 4
      761        RECT-7 AT ROW 1.25 COL 2
      762       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
      763            SIDE-LABELS NO-UNDERLINE THREE-D
      764            AT COL 1 ROW 1 SCROLLABLE
      765            BGCOLOR 8 .
      766   IF NOT THIS-PROCEDURE:PERSISTENT THEN DO:
      767     MESSAGE "c:\tester\Rls_16_0\rc_160_rus\cmpdir\src\rep\e-wth-mv.w should only be RUN PERSISTENT.":U
      768             VIEW-AS ALERT-BOX ERROR BUTTONS OK.
      769     RETURN.
      770   END.
      771   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
      772   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
      773   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
      774   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
      775   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
      776   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
      777   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
      778   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
      779         adm-object-hdl = FRAME F-Main:HANDLE.
      780   RUN ensure-broker.
      781   THIS-PROCEDURE:ADM-DATA =
      782        'ADM1.1~`':U +
      783        'SmartViewer~`':U +
      784        '~`':U +
      785        'NO ~`':U +
      786        '~`':U +
      787        '~`':U +
      788        '~`':U +
      789        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
      790           + "~`":U +
      791        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add~`':U +
      792        'Record-Source,Record-Target,TableIO-Target~`':U +
      793        '~`':U +
      794        '~`~`~`~`~`~`~`~`~`~`~`':U +
      795        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
      796            THEN "^^":U
      797        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
      798             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
      799   PROCEDURE adm-apply-entry :
      800     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      801   END PROCEDURE.
      802   PROCEDURE adm-destroy :
      803    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      804   END PROCEDURE.
      805   PROCEDURE adm-disable :
      806       DISABLE RECT-7 cb-money cb-ser cb-at WITH FRAME F-Main.
      807       RUN dispatch ('disable-fields':U).
      808       RUN set-attribute-list ('ENABLED=no':U).
      809       RETURN.
      810   END PROCEDURE.
      811   PROCEDURE adm-edit-attribute-list :
      812         RUN adm/support/viewerd.w (INPUT THIS-PROCEDURE).
      813         RETURN.
      814   END PROCEDURE.
      815   PROCEDURE adm-enable :
      816       ENABLE UNLESS-HIDDEN RECT-7 cb-money cb-ser cb-at WITH FRAME F-Main.
      817       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
      818       RUN set-attribute-list ('ENABLED=yes':U).
      819       RETURN.
      820   END PROCEDURE.
      821   PROCEDURE adm-exit :
      822        RUN notify ('exit':U).
      823     RETURN.
      824   END PROCEDURE.
      825   PROCEDURE adm-hide :
      826     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      827   END PROCEDURE.
      828   PROCEDURE adm-initialize :
      829     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      830   END PROCEDURE.
      831   PROCEDURE adm-show-errors :
      832       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
      833       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
      834           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
      835       END.
      836       RETURN.
      837   END PROCEDURE.
      838   PROCEDURE adm-UIB-mode :
      839     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      840   END PROCEDURE.
      841   PROCEDURE adm-view :
      842     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      843   END PROCEDURE.
      844   PROCEDURE dispatch :
      845       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
      846       RUN broker-dispatch IN adm-broker-hdl
      847           (THIS-PROCEDURE, p-method-name) NO-ERROR.
      848       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
      849   END PROCEDURE.
      850   PROCEDURE ensure-broker :
      851   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
      852   IF RETURN-VALUE NE "ADM-Broker":U THEN
      853   DO:
      854       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
      855       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
      856   END.
      857   END PROCEDURE.
      858   PROCEDURE get-attribute :
      859     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
      860     RUN broker-get-attribute IN adm-broker-hdl
      861         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
      862     RETURN RETURN-VALUE.
      863   END PROCEDURE.
      864   PROCEDURE get-attribute-list :
      865     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
      866     RUN broker-get-attribute-list IN adm-broker-hdl
      867         (INPUT THIS-PROCEDURE,
      868          INPUT ?,
      869          OUTPUT p-attr-list) NO-ERROR.
      870     RETURN.
      871   END PROCEDURE.
      872   PROCEDURE new-state :
      873     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
      874     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
      875     RETURN.
      876   END PROCEDURE.
      877   PROCEDURE notify :
      878     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
      879     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
      880     IF RETURN-VALUE = "ADM-ERROR":U THEN
      881         RETURN "ADM-ERROR":U.
      882     RETURN.
      883   END PROCEDURE.
      884   PROCEDURE set-attribute-list :
      885     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
      886     RUN ensure-broker.
      887     RUN broker-set-attribute-list IN adm-broker-hdl
      888         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
      889     RETURN.
      890   END PROCEDURE.
      891   PROCEDURE set-position :
      892       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
      893       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
      894       IF VALID-HANDLE(adm-object-hdl) THEN
      895       DO:
      896         ASSIGN adm-object-hdl:ROW    =   p-row
      897                adm-object-hdl:COLUMN =   p-col.
      898       END.
      899       RETURN.
      900   END PROCEDURE.
      901   PROCEDURE adm-display-fields :
      902       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
      903       RETURN.
      904   END PROCEDURE.
      905   PROCEDURE adm-open-query :
      906     RETURN.
      907   END PROCEDURE.
      908   PROCEDURE adm-row-changed :
      909         IF VALID-HANDLE(adm-object-hdl) THEN
      910           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
      911         RUN notify ('row-available':U).
      912         RETURN.
      913   END PROCEDURE.
      914   PROCEDURE reposition-query :
      915       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
      916       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
      917       RETURN.
      918   END PROCEDURE.
