      999   PROCEDURE check-modified :
     1000   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
     1001   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
     1002   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
     1003   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
     1004     IF check-state = "check":U THEN
     1005     DO:
     1006       RUN get-link-handle IN adm-broker-hdl
     1007         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
     1008            OUTPUT group-target-list).
     1009       IF group-target-list NE "":U THEN
     1010       DO i = 1 TO NUM-ENTRIES(group-target-list):
     1011         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
     1012         RUN check-modified IN curr-widget ('group-check':U).
     1013         IF RETURN-VALUE NE "":U THEN
     1014         DO:
     1015           RUN check-modified-message(RETURN-VALUE).
     1016           RETURN "":U.
     1017         END.
     1018       END.
     1019     END.
     1020     RETURN "":U.
     1021   END PROCEDURE.
     1022   PROCEDURE check-modified-message :
     1023     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
     1024        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
     1025           'CONTAINER-SOURCE':U, 'HIDDEN':U).
     1026        IF RETURN-VALUE = "YES":U THEN
     1027           RUN notify ('view,CONTAINER-SOURCE':U).
     1028        MESSAGE IF p-changed-table NE ? THEN
     1029           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
     1030           ELSE "Current values have been changed."
     1031           SKIP "  Do you wish to save those changes?"
     1032           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
     1033        IF ANS THEN
     1034        DO:
     1035           IF group-assign-target THEN
     1036             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
     1037           ELSE RUN dispatch('update-record':U).
     1038           IF RETURN-VALUE = "ADM-ERROR":U THEN
     1039           DO:
     1040               MESSAGE "Changes to the previous record were not saved."
     1041                 VIEW-AS ALERT-BOX ERROR.
     1042               IF group-assign-target THEN
     1043                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1044               ELSE RUN dispatch ('cancel-record':U).
     1045           END.
     1046        END.
     1047        ELSE DO:
     1048          IF group-assign-target THEN
     1049             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1050          ELSE RUN dispatch('cancel-record':U).
     1051        END.
     1052        RETURN.
     1053   END PROCEDURE.
     1054   PROCEDURE get-rowid :
     1055       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
     1056       ASSIGN
     1057       p-table   =   adm-first-table.
     1058       RETURN.
     1059   END PROCEDURE.
     1060   PROCEDURE init-group-assign :
     1061       RUN request-attribute IN adm-broker-hdl
     1062         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
     1063       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
     1064         group-assign-target = yes.
     1065       ELSE group-assign-target = no.
     1066       RETURN.
     1067   END PROCEDURE.
     1068   PROCEDURE set-editors :
     1069       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
     1070       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
     1071       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
     1072       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
     1073       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
     1074       DO WHILE VALID-HANDLE (curr-widget):
     1075           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
     1076              curr-widget:HIDDEN = no THEN DO:
     1077             CASE p-field-setting:
     1078               WHEN "INITIALIZE":U THEN
     1079               DO:
     1080                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
     1081                     read-only-list +
     1082                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
     1083                        STRING(curr-widget).
     1084               END.
     1085               WHEN "DISABLE":U OR
     1086               WHEN "ENABLE":U THEN
     1087               DO:
     1088                   curr-widget:SENSITIVE = yes.
     1089                   RUN get-attribute ('Read-Only-Editors':U).
     1090                   IF RETURN-VALUE = ? OR
     1091                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
     1092                       curr-widget:READ-ONLY =
     1093                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
     1094               END.
     1095               WHEN "CLEAR":U THEN
     1096                   curr-widget:SCREEN-VALUE = "":U.
     1097             END CASE.
     1098           END.
     1099           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
     1100       END.
     1101       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
     1102         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
     1103           + '"':U).
     1104       RETURN.
     1105   END PROCEDURE.
     1106   PROCEDURE use-check-modified-all :
     1107    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1108     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
     1109     RETURN.
     1110   END PROCEDURE.
     1111   PROCEDURE use-create-on-add :
     1112   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1113      RETURN.
     1114   END PROCEDURE.
     1115   PROCEDURE use-initial-lock :
     1116     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1117     ASSIGN adm-initial-lock = p-attr-value.
     1118     RETURN.
     1119   END PROCEDURE.
     1120     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
     1121   ASSIGN
     1122          FRAME F-Main:SCROLLABLE       = FALSE
     1123          FRAME F-Main:HIDDEN           = TRUE.
     1124   PROCEDURE disable_UI :
     1125     HIDE FRAME F-Main.
     1126     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1127   END PROCEDURE.
     1128   PROCEDURE local-apply-layout :
     1129     RUN dispatch IN THIS-PROCEDURE ( INPUT 'apply-layout':U ) .
     1130   END PROCEDURE.
     1131   PROCEDURE local-initialize :
     1132   RUN dispatch IN THIS-PROCEDURE ( INPUT 'initialize':U ) .
     1133   define variable ser-wth  as logical   no-undo.
     1134   define variable conf-par as character no-undo.
     1135   define variable par-type as character no-undo.
     1136   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     1137     (input  'ser-wth'
     1138     ,input  0
     1139     ,input  ''
     1140     ,input  0
     1141     ,input  ''
     1142     ,input  ''
     1143     ,input  ''
     1144     ,input  NO
     1145     ,output conf-par
     1146     ,output par-type
     1147     ) no-error .
     1148       IF not error-status:error then
     1149       assign
     1150       ser-wth = (conf-par = "yes":U).
     1151   do with frame F-Main:
     1152    IF NOT ser-wth THEN HIDE cb-ser.
     1153    cb-money:checked = yes.
     1154    cb-ser:checked = yes.
     1155    cb-at:checked = yes.
     1156   end.
     1157   END PROCEDURE.
     1158   PROCEDURE my-report :
     1159   do
     1160   on error undo, return error
     1161   :
     1162       run rep/r-wth-mv.p (
     1163             input cb-money
     1164           , input cb-ser
     1165           , input cb-at
     1166       ).
     1167   end.
     1168   END PROCEDURE.
     1169   PROCEDURE my-var :
     1170   assign frame F-Main
     1171       cb-money
     1172       cb-ser
     1173       cb-at
     1174   .
     1175   END PROCEDURE.
