      585   function fnc-convert-dot-to-colon returns character
      586       (input p-data as decimal, input p-accur as character, input p-num as integer) forward.
      587   function fnc-convert-dot-to-colon returns character
      588   (input p-data as decimal, input p-accur as character, input p-num as integer):
      589       define variable result as character no-undo.
      590       define variable v-str-result as character no-undo.
      591       if p-data = ? then p-data = 0 .
      592       p-data = round(p-data, p-num).
      593       v-str-result = trim(replace(string(p-data, p-accur), ".", ",")).
      594       return v-str-result.
      595   END FUNCTION.
      596   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      597   define  stream PrnLibStream.
      598   procedure prn-lib-prn-file :
      599     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      600     define input parameter p-DIsabledoptions as integer no-undo .
      601     define variable v-report-name as character no-undo .
      602     define variable v-user-action as character no-undo .
      603     define variable v-printed     as logical   no-undo .
      604     define variable v-exist       as logical   no-undo .
      605     do
      606       on error undo, return error
      607       :
      608       run prn-lib-get-report-name  in this-procedure (
      609         input parParentProc
      610         ,output v-report-name
      611         ).
      612   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      613   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      614     (input  v-report-name
      615     ,input  2
      616     ,output v-exist
      617     )  .
      618       if NOT v-exist then
      619       DO:
      620         Message
      621           "Нет заданий на печать ! "
      622           view-as alert-box .
      623         Return  .
      624       End.
      625       run gbl/prnfilen.w
      626         (input  ""
      627         ,input  p-DisabledOptions
      628         ,input  string(v-report-name )
      629         ,input  7
      630         ,output v-user-action
      631         ,output v-printed
      632         ) .
      633       if v-printed then
      634       do:
      635         return "YES" .
      636       end.
      637       else
      638       do:
      639         return "NO" .
      640       end.
      641     end.
      642   end procedure.
      643   procedure prn-lib-open-stream :
      644     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      645     define input parameter p-page-size    as integer no-undo .
      646     define input parameter p-is-stream    as logical no-undo .
      647     define input parameter p-append       as logical no-undo .
      648     define variable v-report-name as character no-undo .
      649     do
      650       on error undo, return error
      651       :
      652       run prn-lib-get-report-name  in this-procedure (
      653         input parParentProc
      654         ,output v-report-name
      655         ).
      656       if p-is-stream then
      657       do:
      658         if p-append then
      659         do:
      660           output stream PrnLibStream to value( v-report-name )
      661             page-size value(p-page-size) append .
      662         end.
      663         if not p-append then
      664         do:
      665           output stream PrnLibStream to value( v-report-name )
      666             page-size value(p-page-size) .
      667         end.
      668       end.
      669       if not p-is-stream then
      670       do:
      671         if p-append then
      672         do:
      673           output to value( v-report-name )
      674             page-size value(p-page-size) append .
      675         end.
      676         if not p-append then
      677         do:
      678           output to value( v-report-name )
      679             page-size value(p-page-size) .
      680         end.
      681       end.
      682     end.
      683   end procedure.
      684   procedure prn-lib-open-exp :
      685     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      686     define input parameter p-is-stream    as logical no-undo .
      687     define input parameter p-is-append    as logical no-undo .
      688     define output parameter p-ReportFileName as char init "report" no-undo.
      689     define output parameter p-process as logical no-undo .
      690     define variable glog as logical no-undo .
      691     do
      692       on error undo, return error
      693       :
      694       SYSTEM-DIALOG GET-FILE p-ReportFileName
      695         TITLE      "Укажите путь"
      696         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      697         ASK-OVERWRITE
      698         CREATE-TEST-FILE
      699         SAVE-AS
      700         USE-FILENAME
      701         DEFAULT-EXTENSION "txt"
      702         UPDATE glog
      703         .
      704       if not glog then  return.
      705       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      706       if p-is-stream then
      707       do:
      708         if p-is-append then
      709         do:
      710           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      711         end.
      712         else
      713         do:
      714           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      715         end.
      716       end.
      717       else
      718       do:
      719         if p-is-append then
      720         do:
      721           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      722         end.
      723         else
      724         do:
      725           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      726         end.
      727       end.
      728       p-process = yes.
      729     end.
      730   end procedure.
      731   procedure prn-lib-get-report-name :
      732     define input parameter parParentProc  as widget-handle no-undo.
      733     define output parameter p-report-name as character no-undo .
      734     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      735   end procedure.
      736   procedure prn-lib-reportviewer-report-name :
      737     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      738     define input parameter p-report-name-html as character no-undo .
      739     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      740   end procedure.
      741   procedure prn-lib-reportviewer :
      742     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      743     define input parameter p-report-name-html as character no-undo .
      744     define input parameter p-param        as character no-undo .
      745     define variable v-excel           as character no-undo init 'TRUE' .
      746     define variable v-value-character as character no-undo .
      747     define variable v-value-integer   as character no-undo .
      748     define variable v-value-date      as date      no-undo .
      749     define variable v-value-decimal   as decimal   no-undo .
      750     define variable rep-excel         as logical   no-undo .
      751     define variable excel-string      as character no-undo .
      752     define variable v-param-type      as character no-undo .
      753     define variable v-tth             as handle    no-undo .
      754     run adm/shattri.p (
      755       input "get":U
      756       ,input  ""
      757       ,input  0
      758       ,input  'report-glob':U
      759       ,input  'rep-excel':U
      760       ,output v-value-character
      761       ,output v-value-date
      762       ,output v-value-decimal
      763       ,output v-value-integer
      764       ,output rep-excel
      765       ,output v-param-type
      766       ,INPUT-OUTPUT table-handle v-tth
      767       )  .
      768     if rep-excel then v-excel = "TRUE" .
      769     else v-excel = "FALSE" .
      770     if p-param eq ""
      771     then
      772        p-param = "EXCEL:" + v-excel.
      773     else
      774        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      775     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      776   end procedure.
      777   define buffer buf_obj-list    for obj-list .
      778   define buffer buf_clients     for ub.clients .
      779   define buffer buf_chk-doc     for ub.chk-doc .
      780   define buffer buf_shift-obj   for ub.shift-obj .
      781   define buffer buf_chk-discnt  for ub.chk-discnt .
      782   define buffer bf_chk-discnt   for ub.chk-discnt .
      783   define buffer buf_chk-gds     for ub.chk-gds .
      784   define buffer buf_PromoAction for ub.PromoAction .
      785   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      786     define variable v-cntxt-db-num        as integer   no-undo .
      787     define variable v-cntxt-userid        as character no-undo .
      788     define variable v-cntxt-level         as character no-undo .
      789     define variable v-cntxt-host-code-obj as integer   no-undo .
      790     define variable v-cntxt-obj-type      as character no-undo .
      791     define variable v-cntxt-obj-code      as integer   no-undo .
      792     define variable v-cntxt-db-num-obj    as integer   no-undo .
      793     define variable v-cntxt-is-admin      as logical   no-undo .
      794   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      795     run mainmenu_getcntxt in parparentproc
      796       (output v-cntxt-db-num
      797       ,output v-cntxt-userid
      798       ,output v-cntxt-level
      799       ,output v-cntxt-host-code-obj
      800       ,output v-cntxt-obj-type
      801       ,output v-cntxt-obj-code
      802       ,output v-cntxt-db-num-obj
      803       ,output v-cntxt-is-admin
      804       ) .
      805   define variable v-obj-list-code       as integer.
      806   define variable v-obj-list-type       as char.
      807   define variable v-cntxt-obj-name      as character no-undo .
      808   define variable v-cntxt-host-name-obj as character no-undo .
      809   define stream Out-Stream.
      810   define stream OutStr-html.
      811   function pr-objname returns character
      812     (input p-obj-code as integer ) forward.
      813   define variable v-file-name-rep-htm as character no-undo .
      814   define variable ii                  as integer   no-undo .
      815   define TEMP-TABLE tt-promo
      816     field obj-code     as integer
      817     field obj-type     as character
      818     field shift-date   as date
      819     field shift-num    as integer
      820     field promo-id     as character
      821     field promo-name   as character
      822     field object-qnty  as decimal
      823     field goods-qnty   as decimal
      824     field discount-sum as decimal
      825     field itog-sum     as decimal
      826     field change-BL    as character
      827     index pi
      828     is unique
      829     obj-code
      830     promo-id
      831     obj-type
      832     shift-date
      833     shift-num
      834     .
      835   define TEMP-TABLE tt-shift-obj like ub.shift-obj .
      836   define variable v-sum-with    as decimal no-undo .
      837   define variable v-sum-without as decimal no-undo .
      838   for each buf_obj-list no-lock:
      839     if x-TOG-Shift = yes then
      840     do:
      841       for each buf_chk-discnt no-lock where buf_chk-discnt.record-type = 5
      842         and buf_chk-discnt.obj-code = buf_obj-list.obj-code
      843         and buf_chk-discnt.obj-type = buf_obj-list.obj-type
      844         and buf_chk-discnt.out-code <> ?,
      845         first buf_chk-doc no-lock where buf_chk-doc.doc-code = buf_chk-discnt.doc-code
      846         and buf_chk-doc.shift-date >= x-Date-Start
      847         and buf_chk-doc.shift-date <= x-Date-End:
      848         if (buf_chk-doc.shift-date = X-date-Start)
      849           and (buf_chk-doc.shift-num < x-Shift-Start) then next.
      850         if (buf_chk-doc.shift-date = X-date-End)
      851           and (buf_chk-doc.shift-num > x-Shift-End) then next.
      852         find first tt-promo where tt-promo.obj-code = buf_chk-discnt.obj-code and tt-promo.obj-type = buf_chk-discnt.obj-type
      853           and tt-promo.shift-date = buf_chk-doc.shift-date and tt-promo.shift-num = buf_chk-doc.shift-num and tt-promo.promo-id = buf_chk-discnt.promo-id no-error .
      854         if not available (tt-promo) then
      855         do:
      856           find first buf_PromoAction no-lock where buf_PromoAction.id = integer(buf_chk-discnt.promo-id) no-error .
      857           create tt-promo .
      858           assign
      859             tt-promo.obj-code    = buf_chk-discnt.obj-code
      860             tt-promo.obj-type    = buf_chk-discnt.obj-type
      861             tt-promo.object-qnty = buf_chk-discnt.object-sum
      862             tt-promo.promo-id    = string(buf_chk-discnt.promo-id)
      863             tt-promo.shift-date  = buf_chk-doc.shift-date
      864             tt-promo.shift-num   = buf_chk-doc.shift-num
      865             tt-promo.promo-name  = if available (buf_PromoAction) then buf_PromoAction.nameAction else "".
      866           .
      867           find first ub.promoAttr where
      868             ub.promoAttr.attr-code = "charge-BL" and
      869             ub.promoAttr.tablename = "PromoPay" and
      870             buf_PromoAction.id = int64(entry(1,ub.PromoAttr.p-key,chr(3))) and
      871             buf_PromoAction.db-num = integer(entry(2,ub.PromoAttr.p-key,chr(3)))
      872             no-error.
      873           if available (ub.PromoAttr) then do:
      874             if logical(ub.PromoAttr.attr-value) = true then tt-promo.change-BL = "да" .
      875             else tt-promo.change-BL = "нет" .
      876           end.
      877           else tt-promo.change-BL = "нет" .
      878         end.
      879         else tt-promo.object-qnty = tt-promo.object-qnty + buf_chk-discnt.object-sum .
      880         for each bf_chk-discnt no-lock where bf_chk-discnt.record-type = 1 and bf_chk-discnt.doc-code = buf_chk-discnt.doc-code and bf_chk-discnt.promo-id = buf_chk-discnt.promo-id:
      881           for each buf_chk-gds no-lock where buf_chk-gds.doc-code = bf_chk-discnt.doc-code and buf_chk-gds.line-num = bf_chk-discnt.object-line-num:
      882             assign
      883               tt-promo.discount-sum = tt-promo.discount-sum + bf_chk-discnt.discnt-value-abs
      884               tt-promo.goods-qnty   = tt-promo.goods-qnty + buf_chk-gds.doc-qnty
      885               tt-promo.itog-sum     = tt-promo.itog-sum + buf_chk-gds.src-sum
      886               .
      887           end.
      888         end.
      889       end.
      890     end.
      891     else
      892     do:
      893       for each buf_chk-discnt no-lock where buf_chk-discnt.record-type = 5
      894         and buf_chk-discnt.obj-code = buf_obj-list.obj-code
      895         and buf_chk-discnt.obj-type = buf_obj-list.obj-type
      896         and buf_chk-discnt.out-code <> ?
      897         and buf_chk-discnt.chk-date >= x-Date-Start
      898         and buf_chk-discnt.chk-date <= x-Date-End,
      899         first buf_chk-doc no-lock where buf_chk-doc.doc-code = buf_chk-discnt.doc-code:
      900         find first tt-promo where tt-promo.obj-code = buf_chk-discnt.obj-code and tt-promo.obj-type = buf_chk-discnt.obj-type
      901           and tt-promo.shift-date = buf_chk-doc.shift-date and tt-promo.shift-num = buf_chk-doc.shift-num and tt-promo.promo-id = buf_chk-discnt.promo-id no-error .
      902         if not available (tt-promo) then
      903         do:
      904           find first buf_PromoAction no-lock where buf_PromoAction.id = integer(buf_chk-discnt.promo-id) no-error .
      905           create tt-promo .
      906           assign
      907               tt-promo.obj-code    = buf_chk-discnt.obj-code
      908               tt-promo.obj-type    = buf_chk-discnt.obj-type
      909               tt-promo.shift-date = buf_chk-doc.shift-date
      910               tt-promo.shift-num  = buf_chk-doc.shift-num
      911               tt-promo.object-qnty = buf_chk-discnt.object-sum
      912               tt-promo.promo-id    = string(buf_chk-discnt.promo-id)
      913               tt-promo.promo-name  = if available (buf_PromoAction) then buf_PromoAction.nameAction else "".
      914           .
      915         end.
      916         else tt-promo.object-qnty = tt-promo.object-qnty + buf_chk-discnt.object-sum .
      917         for each bf_chk-discnt no-lock where bf_chk-discnt.record-type = 1 and bf_chk-discnt.doc-code = buf_chk-discnt.doc-code and bf_chk-discnt.promo-id = buf_chk-discnt.promo-id:
      918           for each buf_chk-gds no-lock where buf_chk-gds.doc-code = bf_chk-discnt.doc-code and buf_chk-gds.line-num = bf_chk-discnt.object-line-num:
      919             assign
      920               tt-promo.discount-sum = tt-promo.discount-sum + bf_chk-discnt.discnt-value-abs
      921               tt-promo.goods-qnty   = tt-promo.goods-qnty + buf_chk-gds.doc-qnty
      922               tt-promo.itog-sum     = tt-promo.itog-sum + buf_chk-gds.src-sum
      923               .
      924           end.
      925         end.
      926       end.
      927     end.
      928   end.
      929   run get-report-num (output p-report-id).
      930   v-file-name-rep-htm = session:temp-directory + string(p-report-id) + ".html".
      931   output stream OutStr-html to value(v-file-name-rep-htm) convert target 'UTF-8'.
      932   put stream OutStr-html unformatted
      933     "<!DOCTYPE HTML>" skip
      934     ' <html>' skip
      935     '  <head>' skip
      936     '   <meta charset="utf-8">' skip
      937     '    <style type="text/css">' skip
      938     '      table ' + chr(123) + ' border-collapse: collapse; ' + chr(125) skip
      939     '      .class1 ' + chr(123) + ' border-collapse: collapse; ' + chr(125) skip
      940     '      tbody td, th ' + chr(123) + ' border-collapse: collapse; border: 1px solid black; height: 14px;' + chr(125) skip
      941     '   </style>' skip
      942     '  </head>' skip
      943     .
      944   run pr-header .
      945   run pr-line .
      946   run pr-foot .
      947   procedure pr-header:
      948     put stream OutStr-html unformatted
      949       '<body>' skip
      950       '<TABLE name="1"  fit_to_page="true" orientation="portrait" CELLSPACING="0" BORDER="0">'skip
      951       '<thead>' skip
      952       .
      953     put stream OutStr-html unformatted
      954       '<tr class="set_columns">' skip
      955       '<td style="width: 40px;"></td>' skip
      956       '<td style="width: 40px;"></td>' skip
      957       '<td style="width: 40px;"></td>' skip
      958       '<td style="width: 200px;"></td>' skip
      959       '<td style="width: 100px;"></td>' skip
      960       '<td style="width: 100px;"></td>' skip
      961       '<td style="width: 100px;"></td>' skip
      962       '<td style="width: 100px;"></td>' skip
      963       '<td style="width: 100px;"></td>' skip
      964       '</tr>' skip
      965       .
      966     put stream OutStr-html unformatted
      967       '<tr>' skip
      968       '<td colspan="9" style="text-align: center;">Отчет по реализации промо-акций за период с ' + string(x-Date-Start,"99.99.99") + ' по ' + string(x-Date-End,"99.99.99") + ' </td>' skip
      969       '</tr>' skip
      970       '</thead>' skip .
      971   end.
      972   procedure pr-line:
      973     put stream OutStr-html unformatted
      974       '<tbody>' skip
      975       '<TR>' skip
      976       '<TD text_wrap="true" style="text-align: center; font-weight:bold; background-color: silver;">Дата смены</TD>' skip
      977       '<TD text_wrap="true" style="text-align: center; font-weight:bold; background-color: silver;">№ смены</TD>' skip
      978       '<TD text_wrap="true" style="text-align: center; font-weight:bold; background-color: silver;">№ промо-акции</TD>' skip
      979       '<TD text_wrap="true" style="text-align: center; font-weight:bold; background-color: silver;">Наименование промо-акции</TD>' skip
      980       '<TD text_wrap="true" style="text-align: center; font-weight:bold; background-color: silver;">Количество срабатываний</TD>' skip
      981       '<TD text_wrap="true" style="text-align: center; font-weight:bold; background-color: silver;">Количество акционных товаров</TD>' skip
      982       '<TD text_wrap="true" style="text-align: center; font-weight:bold; background-color: silver;">Сумма скидки</TD>' skip
      983       '<TD text_wrap="true" style="text-align: center; font-weight:bold; background-color: silver;">Сумма без скидки</TD>' skip
      984       '<TD text_wrap="true" style="text-align: center; font-weight:bold; background-color: silver;">Запрет начисления БЛ</TD>' skip
      985       '</TR>'skip
      986       .
      987     for each tt-promo by tt-promo.shift-date:
      988       put stream OutStr-html unformatted
      989         '<TR>' skip
      990         '<TD text_wrap="true" style="text-align: center;">' + STRING (tt-promo.shift-date,"99.99.99") + '</TD>' skip
      991         '<TD text_wrap="true" style="text-align: center;">' + string(tt-promo.shift-num) + '</TD>' skip
      992         '<TD text_wrap="true" style="text-align: center;">' + string(tt-promo.promo-id) + '</TD>' skip
      993         '<TD text_wrap="true">' + string(tt-promo.promo-name) + '</TD>' skip
      994         '<TD text_wrap="true" style="text-align: center;">' + string(if tt-promo.object-qnty <> ? then tt-promo.object-qnty else 0) + '</TD>' skip
      995         '<TD text_wrap="true" style="text-align: center;">' + STRING (tt-promo.goods-qnty) + '</TD>' skip
      996         '<TD text_wrap="true" num="0.00" val="' + fnc-convert-dot-to-colon(tt-promo.discount-sum,"->>>>>>>>>>>9.99",2) + '" style="text-align: center;">' + fnc-convert-dot-to-colon(tt-promo.discount-sum,"->>>>>>>>>>>9.99",2) + '</TD>' skip
      997         '<TD text_wrap="true" num="0.00" val="' + fnc-convert-dot-to-colon(tt-promo.itog-sum,"->>>>>>>>>>>9.99",2) + '" style="text-align: center;">' + fnc-convert-dot-to-colon(tt-promo.itog-sum,"->>>>>>>>>>>9.99",2) + '</TD>' skip
      998         '<TD text_wrap="true" style="text-align: center;">' + tt-promo.change-BL + '</TD>' skip
      999         '</TR>'skip
     1000         .
     1001     end.
     1002     put stream OutStr-html unformatted
     1003       '</tbody>' skip .
     1004   end.
     1005   procedure pr-foot:
     1006     put stream OutStr-html unformatted
     1007       '</table>' skip
     1008       '</body>' skip
     1009       '</html>' skip
     1010       .
     1011   end.
     1012   output stream OutStr-html close.
     1013   run prn-lib-reportviewer-report-name in this-procedure (
     1014     input THIS-PROCEDURE
     1015     ,input v-file-name-rep-htm
     1016     ).
     1017   PROCEDURE get-report-num :
     1018     define output parameter p-report-num as integer no-undo .
     1019     do
     1020       on error undo, return error return-value
     1021       :
     1022       run gbl/getrpnum.p (output p-report-num).
     1023     end.
     1024   END PROCEDURE.
