      632   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      633   define variable v-waitfram-action01         as character   no-undo .
      634   define variable v-waitfram-action02         as character   no-undo .
      635   define variable v-waitfram-action03         as character   no-undo .
      636   define variable mWaitFramTextBeg            as character   no-undo.
      637   define variable mWaitFramTextEnd            as character   no-undo.
      638   define variable mWaitFramView               as logical     no-undo.
      639   define variable mWaitProcEvent              as logical     no-undo init yes.
      640   define variable mWaitFramInterval           as integer     no-undo init 1 .
      641   define variable mWaitFramStop               as logical     no-undo.
      642   define variable mWaitFramStopUser           as logical     no-undo.
      643   define variable mWaitFramStopTimeOut        as logical     no-undo.
      644   define variable mWaitFramStartProc          as datetime-tz no-undo.
      645   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      646   define button B-WaitFramStop auto-end-key
      647        label "Стоп"
      648        size 10 by 1 tooltip "Остоновить процесс".
      649   define button B-viewProcInfo
      650        label "Информация"
      651        size 15 by 1 tooltip "Информация о процесс".
      652   define frame waitfram
      653     v-waitfram-action01 format "x(72)" no-label skip
      654     v-waitfram-action02 format "x(72)" no-label skip
      655     v-waitfram-action03 format "x(72)" no-label skip
      656     B-viewProcInfo
      657     B-WaitFramStop at row 4 col 30
      658     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      659     .
      660   define new global shared variable mBatchMode as logical no-undo init ?.
      661   define variable mFramBachModHandle as handle no-undo.
      662   mFramBachModHandle = frame waitfram:handle.
      663   define variable mFameOldVis as logical no-undo.
      664   define variable mVisCUrentVin as logical no-undo.
      665   if session:batch-mode
      666   then
      667      mBatchMode = yes.
      668   if mBatchMode = ? then do:
      669     mVisCUrentVin = current-window:visible.
      670     mFameOldVis = mFramBachModHandle:visible.
      671     mFramBachModHandle:visible  = yes.
      672     mBatchMode = mFramBachModHandle:visible ne yes.
      673     mFramBachModHandle:visible = mFameOldVis.
      674     current-window:visible = mVisCUrentVin.
      675   end.
      676    if  log-manager:logfile-name ne ?
      677     then DO:
      678         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      679         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      680         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      681     end.
      682   on choose of B-WaitFramStop in frame waitfram
      683   do:
      684     mWaitFramStop = yes.
      685     mWaitFramStopUser = yes.
      686   end.
      687   function waitfram-check-timeout returns logical():
      688      define variable vtime as int64 no-undo.
      689      if mWaitFramStopTimeOut
      690      then
      691         return yes.
      692      vtime = ( now - mWaitFramStartProc ) / 1000 .
      693      if     mWaitFramTimeOut ne ?
      694         and mWaitFramTimeOut ne 0
      695         and mWaitFramTimeOut lt vtime
      696      then do:
      697         mWaitFramStopTimeOut = yes.
      698      end.
      699      return mWaitFramStopTimeOut.
      700   end.
      701   procedure waitfram-hide :
      702     if not session:batch-mode
      703     then do
      704     on error undo, return error return-value
      705     :
      706       pause 0 before-hide .
      707       if not mBatchMode then
      708         hide frame waitfram .
      709     if     not mWaitFramView
      710        and mWaitProcEvent
      711     then
      712       process events .
      713     end.
      714   end procedure.
      715   procedure waitfram-show :
      716     define input  parameter p-message as character no-undo .
      717     define variable v-left-margin as integer   no-undo .
      718     if not session:batch-mode
      719     then do
      720     on error undo, return error return-value
      721     :
      722       if length(p-message) <= 70 then do:
      723         assign
      724           v-left-margin = integer((70 - length(p-message)) / 2)
      725         .
      726         assign
      727           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      728         .
      729         assign
      730           v-waitfram-action01 = " "
      731           v-waitfram-action02 = " "
      732                                    + fill(" ", v-left-margin)
      733                                    + p-message
      734           v-waitfram-action03 = " "
      735         .
      736       end.
      737       else do:
      738         define variable vRindex1 as integer no-undo.
      739         define variable vRindex2 as integer no-undo.
      740         vRindex1 = r-index(p-message," ",70).
      741         if vRindex1 = 0
      742         then
      743            vRindex1 = 70.
      744         if length(p-message)  <= vRindex1 + 70 then do:
      745           assign
      746             v-waitfram-action01 = " "
      747             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      748             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      749           .
      750         end.
      751         else do:
      752           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      753           if vRindex2 <= vRindex1
      754           then
      755              vRindex2 = vRindex1 + 70.
      756           assign
      757             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      758             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      759             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      760           .
      761         end.
      762       end.
      763       B-viewProcInfo:visible   in frame waitfram = no.
      764       B-viewProcInfo:sensitive in frame waitfram = no.
      765       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      766       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      767       if  (   mWaitFramView
      768          or  mWaitProcEvent)
      769          and not mBatchMode
      770       then
      771          display
      772             v-waitfram-action01 skip
      773             v-waitfram-action02 skip
      774             v-waitfram-action03 skip
      775          with frame waitfram .
      776       if     mWaitFramView
      777          then do:
      778             if     mWaitFramInterval ne ?
      779                and not mBatchMode
      780             then
      781                wait-for go of frame waitfram pause mWaitFramInterval.
      782          end.
      783          else
      784             if     mWaitProcEvent
      785                and not mBatchMode
      786             then
      787                process events .
      788     end.
      789   end procedure.
      790      procedure waitfram-show-this:
      791         define input  parameter iInterval as int64 no-undo.
      792         define variable vtime as int64 no-undo.
      793         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      794         mWaitFramInterval = iInterval.
      795         run waitfram-show (substitute("&1&2 &3&4" ,
      796                                       mWaitFramTextBeg ,
      797                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      798                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      799                                       mWaitFramTextEnd
      800                                      )
      801                           ).
      802      end.
      803      procedure WaitFramRunPause:
      804         define input  parameter iInterval as dec no-undo.
      805         define variable vStart  as datetime-tz no-undo.
      806         define variable vend    as datetime-tz no-undo.
      807         define variable vint as int64 no-undo.
      808         define variable vOk as logical no-undo.
      809         vStart = now.
      810         vend   = vStart.
      811         publish "WaitFramPause" (iInterval,output vOk).
      812         vend   =  now.
      813         vint = vend - vStart.
      814         vint = iInterval - vint / 1000.
      815         if     not mWaitFramStop
      816            and (   vint > 0
      817                 or (    not vOk
      818                     and iInterval eq ?
      819                     )
      820                 )
      821         then
      822            run waitfram-show-this (iInterval).
      823         vend   =  now.
      824         vint = vend - vStart.
      825         vint = iInterval - vint / 1000.
      826         if     not mWaitFramStop
      827            and vint > 0
      828         then do:
      829            run gbl/pause.p (vint * 1000).
      830         end.
      831         if iInterval ne ?
      832         then
      833            publish "WaitFramStop".
      834         waitfram-check-timeout().
      835      end.
      836      procedure WaitFramWaitFor:
      837         define input  parameter iInterval as dec no-undo.
      838         assign
      839            mWaitFramStartProc   = now
      840            mWaitFramStopUser    = no
      841            mWaitFramStopTimeOut = no
      842         .
      843         block-wait:
      844         do while not mWaitFramStop:
      845            run WaitFramRunPause (iInterval).
      846            if  waitfram-check-timeout()
      847            then do:
      848               leave block-wait.
      849            end.
      850         end.
      851         run waitfram-hide.
      852      end.
      853   procedure waitfram-join :
      854     define input  parameter p-line-1  as character no-undo .
      855     define input  parameter p-line-2  as character no-undo .
      856     define input  parameter p-line-3  as character no-undo .
      857     define output parameter p-message as character no-undo .
      858     do
      859     on error undo, return error return-value
      860     :
      861       assign
      862         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      863                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      864                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      865       .
      866     end.
      867   end procedure.
      868   function waitfram-join-function returns character
      869     (input p-line-1 as character
      870     ,input p-line-2 as character
      871     ,input p-line-3 as character
      872     ).
      873     define variable v-message as character no-undo .
      874     run waitfram-join in this-procedure
      875       (input  p-line-1
      876       ,input  p-line-2
      877       ,input  p-line-3
      878       ,output v-message
      879       ) .
      880     return v-message .
      881   end function .
      882   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      883   procedure factord :
      884     define input  parameter p-fact-date            as date    no-undo .
      885     define input  parameter p-fact-time            as integer no-undo .
      886     define input  parameter p-fact-num             as integer no-undo .
      887     define input  parameter p-shift-date           as date    no-undo .
      888     define input  parameter p-shift-num            as integer no-undo .
      889     define input  parameter p-shift-on             as logical no-undo .
      890     define output parameter p-fact-order           as decimal no-undo .
      891     define output parameter p-shift-end-fact-order as decimal no-undo .
      892     define output parameter p-day-end-fact-order   as decimal no-undo .
      893     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      894     if p-fact-date = ?
      895     then do:
      896       return error "Не указана фактическая дата" .
      897     end.
      898     define variable v-fact-date-num as integer no-undo .
      899     assign
      900       v-fact-date-num = integer(p-fact-date)
      901     .
      902     if p-fact-num = ?
      903     or p-fact-num = 0
      904     then do:
      905       return error "Не задан p-fact-num " + string(p-fact-num) .
      906     end.
      907     if p-fact-num < 0
      908     then do:
      909       return error "Отрицательный fact-num " + string(p-fact-num) .
      910     end.
      911     if p-fact-num >= 100000000
      912     then do:
      913       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      914     end.
      915     if p-shift-on = true
      916     then do:
      917       if p-shift-date = ?
      918       then do:
      919         return error "Не задана дата смены" .
      920       end.
      921       if p-shift-num = ?
      922       or p-shift-num = 0
      923       then do:
      924         return error "Не задан номер смены" .
      925       end.
      926     end.
      927     else do:
      928       assign
      929         p-shift-date = p-fact-date
      930         p-shift-num  = 24
      931       .
      932     end.
      933     define variable v-shift-offset as integer no-undo .
      934     if p-shift-date = p-fact-date
      935     then do:
      936       assign
      937         v-shift-offset = 1
      938       .
      939     end.
      940     if p-shift-date < p-fact-date
      941     then do:
      942       assign
      943         v-shift-offset = 0
      944       .
      945     end.
      946     if p-shift-date > p-fact-date
      947     then do:
      948       message
      949         vss-workfile vss-revision vss-description skip
      950         "Неправильная дата закрытия смены" skip
      951         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      952         view-as alert-box error .
      953       undo, return error
      954         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      955           ,string(p-fact-date, '99/99/9999':U)
      956           ,string(p-shift-date, '99/99/9999':U)
      957           )
      958       .
      959     end.
      960     if p-shift-num < 1
      961     or p-shift-num > 24
      962     then do:
      963       message
      964         vss-workfile vss-revision vss-description skip
      965         "Неправильный номер смены" skip
      966         "p-shift-num" p-shift-num skip
      967         view-as alert-box error .
      968       undo, return error return-value .
      969     end.
      970     assign
      971       p-fact-order           = v-fact-date-num
      972                              + v-shift-offset * 0.5
      973                              + p-shift-num    * 0.02 - 0.01
      974                              + p-fact-num     * 0.0000000001
      975       p-shift-end-fact-order = v-fact-date-num
      976                              + v-shift-offset * 0.5
      977                              + p-shift-num    * 0.02
      978       p-day-end-fact-order   = v-fact-date-num
      979                              + 0.99
      980     .
      981     if p-fact-order           <= v-fact-date-num
      982     or p-shift-end-fact-order <= v-fact-date-num
      983     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      984     or p-shift-end-fact-order >= p-day-end-fact-order
      985     then do:
      986       message
      987         vss-workfile vss-revision vss-description skip
      988         "Внутренняя ошибка при генерации фактического номера" skip
      989         "p-fact-date"            p-fact-date            skip
      990         "p-fact-time"            p-fact-time            skip
      991         "p-fact-num"             p-fact-num             skip
      992         "p-shift-date"           p-shift-date           skip
      993         "p-shift-num"            p-shift-num            skip
      994         "p-shift-on"             p-shift-on             skip
      995         "p-shift-end-fact-order" p-shift-end-fact-order skip
      996         "p-day-end-fact-order"   p-day-end-fact-order   skip
      997         "v-fact-date-num"        v-fact-date-num        skip
      998         view-as alert-box error .
      999       undo, return error return-value .
     1000     end.
     1001   end procedure.
     1002   procedure day-begin-fact-order :
     1003     define input  parameter p-fact-date            as date    no-undo .
     1004     define output parameter p-day-begin-fact-order as decimal no-undo .
     1005     do
     1006     on error undo, return error return-value
     1007     :
     1008       if p-fact-date = ?
     1009       then do:
     1010         assign
     1011           p-day-begin-fact-order = 0
     1012         .
     1013       end.
     1014       else do:
     1015         assign
     1016           p-day-begin-fact-order = integer(p-fact-date)
     1017         .
     1018       end.
     1019     end.
     1020   end procedure.
     1021   procedure factord-max-fact-order :
     1022     define output parameter p-max-fact-order as decimal   no-undo .
     1023     do
     1024     on error undo, return error return-value
     1025     :
     1026       run day-begin-fact-order in this-procedure
     1027         (input  date(1, 1, 5000)
     1028         ,output p-max-fact-order
     1029         ) .
     1030     end.
     1031   end procedure.
     1032   procedure factord-cut-archive :
     1033     define input  parameter p-obj-type             as character no-undo .
     1034     define input  parameter p-obj-code             as integer   no-undo .
     1035     define input  parameter p-fact-date            as date      no-undo .
     1036     define output parameter p-shift-on             as logical   no-undo .
     1037     define output parameter p-shift-date           as date      no-undo .
     1038     define output parameter p-shift-num            as integer   no-undo .
     1039     define output parameter p-day-end-fact-order   as decimal   no-undo .
     1040     define output parameter p-shift-end-fact-order as decimal   no-undo .
     1041     define variable v-fact-order as decimal   no-undo .
     1042     define buffer buf_shift-obj for ub.shift-obj .
     1043     do
     1044     on error undo, return error return-value
     1045     :
     1046   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1047   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1048     (input  p-obj-type
     1049     ,input  p-obj-code
     1050     ,input  'shift-on=request'
     1051     ,output p-shift-on
     1052     ) no-error .
     1053       if error-status :error
     1054       then do:
     1055         message
     1056           vss-workfile vss-revision vss-description skip
     1057           "Ошибка при определении атрибута объекта" skip
     1058           "Объект" p-obj-type p-obj-code skip
     1059           error-status :get-message(1) skip
     1060           return-value skip
     1061           view-as alert-box error .
     1062         undo, return error return-value .
     1063       end.
     1064       if p-shift-on = false
     1065       then do:
     1066         assign
     1067           p-shift-date               = ?
     1068           p-shift-num                = 0
     1069         .
     1070       end.
     1071       else do:
     1072         find first buf_shift-obj share-lock
     1073           where buf_shift-obj.obj-type   = p-obj-type
     1074             and buf_shift-obj.obj-code   = p-obj-code
     1075             and buf_shift-obj.shift-date > p-fact-date
     1076           use-index pi
     1077           no-error .
     1078         if not available buf_shift-obj
     1079         or buf_shift-obj.status_ <> 'зкр':U
     1080         then do:
     1081           message
     1082             vss-workfile vss-revision vss-description skip
     1083             "Невозможно вычислить последнюю смену" skip
     1084             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
     1085             "Объект" p-obj-type p-obj-code skip
     1086             "Дата" p-fact-date skip
     1087             view-as alert-box error .
     1088           undo, return error return-value .
     1089         end.
     1090         find last buf_shift-obj share-lock
     1091           where buf_shift-obj.obj-type = p-obj-type
     1092             and buf_shift-obj.obj-code = p-obj-code
     1093             and buf_shift-obj.shift-date <= p-fact-date
     1094           use-index pi
     1095           no-error .
     1096         if available buf_shift-obj
     1097         then do:
     1098           if  buf_shift-obj.status_ = 'зкр':U
     1099           then do:
     1100             assign
     1101               p-shift-date = buf_shift-obj.shift-date
     1102               p-shift-num  = buf_shift-obj.shift-num
     1103             .
     1104           end.
     1105           else do:
     1106             message
     1107               vss-workfile vss-revision vss-description skip
     1108               "Невозможно вычислить последнюю смену" skip
     1109               "Статус смены отличен от статуса" 'зкр':U skip
     1110               "Объект" p-obj-type p-obj-code skip
     1111               "Дата" p-fact-date skip
     1112               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     1113               view-as alert-box error .
     1114             undo, return error return-value .
     1115           end.
     1116         end.
     1117         else do:
     1118           assign
     1119             p-shift-date = p-fact-date - 1
     1120             p-shift-num  = 1
     1121           .
     1122         end.
     1123       end.
     1124       run factord in this-procedure
     1125         (input  p-fact-date
     1126         ,input  1
     1127         ,input  1
     1128         ,input  p-shift-date
     1129         ,input  p-shift-num
     1130         ,input  p-shift-on
     1131         ,output v-fact-order
     1132         ,output p-shift-end-fact-order
     1133         ,output p-day-end-fact-order
     1134         ) no-error .
     1135       if error-status :error
     1136       then do:
     1137         message
     1138           vss-workfile vss-revision vss-description skip
     1139           "Ошибка при вызове процедуры factord"
     1140           error-status :get-message(1) skip
     1141           return-value skip
     1142           view-as alert-box error .
     1143         undo, return error return-value .
     1144       end.
     1145     end.
     1146   end procedure.
     1147   procedure factord-lock-shift :
     1148     define input  parameter p-obj-type  as character no-undo .
     1149     define input  parameter p-obj-code  as integer   no-undo .
     1150     define input  parameter p-fact-date as date      no-undo .
     1151     define parameter buffer buf_shift-obj for ub.shift-obj .
     1152     define variable v-shift-on      as logical   no-undo .
     1153     define variable v-extra-message as character no-undo .
     1154     define variable v-error as character no-undo .
     1155     do
     1156     on error undo, return error return-value
     1157     :
     1158   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1159   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1160     (input  p-obj-type
     1161     ,input  p-obj-code
     1162     ,input  'shift-on=request'
     1163     ,output v-shift-on
     1164     ) no-error .
     1165       if error-status :error
     1166       then do:
     1167         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     1168         undo, return error v-error .
     1169       end.
     1170       if v-shift-on = true
     1171       then do:
     1172         find first buf_shift-obj share-lock
     1173           where buf_shift-obj.obj-type   = p-obj-type
     1174             and buf_shift-obj.obj-code   = p-obj-code
     1175             and buf_shift-obj.shift-date > p-fact-date
     1176           use-index pi
     1177           no-error .
     1178         if not available buf_shift-obj
     1179         or buf_shift-obj.status_ <> 'зкр':U
     1180         then do:
     1181           find last buf_shift-obj
     1182             where buf_shift-obj.obj-type = p-obj-type
     1183               and buf_shift-obj.obj-code = p-obj-code
     1184               and buf_shift-obj.status_  = 'зкр':U
     1185             use-index stts
     1186             no-error .
     1187           if available buf_shift-obj
     1188           then do:
     1189             assign
     1190               v-extra-message =
     1191                     substitute("Дата начала последеней закрытой смены на объекте &1"
     1192                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     1193                               )
     1194             .
     1195           end.
     1196           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     1197           undo, return error v-error .
     1198         end.
     1199       end.
     1200     end.
     1201   end procedure.
     1202   procedure factord-end-day :
     1203     define input  parameter p-fact-date            as date    no-undo .
     1204     define output parameter p-day-end-fact-order   as decimal no-undo .
     1205     do
     1206     on error undo, return error return-value
     1207     :
     1208       if p-fact-date = ?
     1209       then do:
     1210         return error "Не указана фактическая дата" .
     1211       end.
     1212       assign
     1213         p-day-end-fact-order = integer(p-fact-date) + 0.99
     1214       .
     1215     end.
     1216   end procedure.
     1217   procedure factord-to-date :
     1218     define input  parameter p-fact-order as decimal no-undo .
     1219     define output parameter p-fact-date  as date    no-undo .
     1220     define variable v-ref-date  as date      no-undo .
     1221     define variable v-ref-delta as integer   no-undo .
     1222     do
     1223     on error undo, return error return-value
     1224     :
     1225       if p-fact-order = ?
     1226       or p-fact-order = 0
     1227       then do:
     1228         return error "Не указан fact-order" .
     1229       end.
     1230       assign
     1231         v-ref-date  = date(1, 1, 2000)
     1232       .
     1233       assign
     1234         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     1235       .
     1236       assign
     1237         p-fact-date = v-ref-date + v-ref-delta
     1238       .
     1239     end.
     1240   end procedure.
     1241   procedure factord-to-fact-num :
     1242     define input  parameter p-fact-order as decimal no-undo .
     1243     define output parameter p-fact-num   as integer no-undo .
     1244     define variable v-fact-order-trunc as decimal no-undo .
     1245     do
     1246     on error undo, return error return-value
     1247     :
     1248       if p-fact-order = ?
     1249       or p-fact-order = 0
     1250       then do:
     1251         return error "Не указан fact-order" .
     1252       end.
     1253       assign
     1254        v-fact-order-trunc = truncate(p-fact-order, 2)
     1255       .
     1256       assign
     1257         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     1258       .
     1259     end.
     1260   end procedure.
     1261   procedure factord-to-shift-num :
     1262     define input  parameter p-fact-order as decimal no-undo .
     1263     define output parameter p-shift-num   as integer no-undo .
     1264     define variable  p-shift-numd  as decimal   no-undo .
     1265     define variable v-fact-order-trunc as decimal no-undo .
     1266     do
     1267     on error undo, return error return-value
     1268     :
     1269       if p-fact-order = ?
     1270       or p-fact-order = 0
     1271       then do:
     1272         return error "Не указан fact-order" .
     1273       end.
     1274       assign
     1275        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     1276       .
     1277       if v-fact-order-trunc < 0.5 then do:
     1278         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     1279       end.
     1280       assign
     1281         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     1282         .
     1283        assign
     1284         p-shift-num = truncate (p-shift-numd , 0)
     1285       .
     1286     end.
     1287   end procedure.
     1288   define temp-table temp-font no-undo
     1289     field fontnum  as integer
     1290     field fontname as character
     1291     field fontsize as character
     1292     field fonttype as character
     1293     field font-h   as integer
     1294     field font-w   as integer
     1295     field v-row    as integer
     1296     field v-col    as integer
     1297     field v-row-lans as integer
     1298     field v-col-lans as integer
     1299   index pi fontnum
     1300   .
     1301   procedure get-font-ini :
     1302     do
     1303     on error undo, return error return-value
     1304     :
     1305   define variable ii as integer   no-undo .
     1306   define variable v-font7 as character no-undo .
     1307   define variable v-font as character no-undo .
     1308   define variable loc-name as character no-undo .
     1309   define variable loc-size as character no-undo .
     1310   define variable loc-type as character no-undo .
     1311   define variable old_H as integer   no-undo .
     1312   define variable old_w as integer   no-undo .
     1313   define variable old-row  as integer   no-undo .
     1314   define variable old-col  as integer   no-undo .
     1315   define variable old-row-lans  as integer   no-undo .
     1316   define variable old-col-lans  as integer   no-undo .
     1317   define variable vv as integer   no-undo .
     1318   empty temp-table temp-font.
     1319     GET-KEY-VALUE SECTION "fonts" KEY "font7" VALUE v-font7 .
     1320       case num-entries (v-font7) :
     1321         when 4 then do:
     1322             assign
     1323               loc-name = entry ( 1 , v-font7 )
     1324               loc-size = entry ( 2 , v-font7 )
     1325               loc-type = entry ( 3 , v-font7 ) + "," +  entry ( 4 , v-font7 )
     1326             .
     1327         end.
     1328         when 3 then do:
     1329             assign
     1330               loc-name = entry ( 1 , v-font7 )
     1331               loc-size = entry ( 2 , v-font7 )
     1332               loc-type = entry ( 3 , v-font7 )
     1333             .
     1334         end.
     1335         when 2 then  do:
     1336             assign
     1337               loc-name = entry ( 1 , v-font7 )
     1338               loc-size = entry ( 2 , v-font7 )
     1339               loc-type = ""
     1340             .
     1341         end.
     1342         when 1 then do:
     1343             assign
     1344               loc-name = trim(entry ( 1 , v-font7 ))
     1345               loc-size = ""
     1346               loc-type = ""
     1347             .
     1348         end.
     1349       end case.
     1350     create temp-font.
     1351     assign
     1352       temp-font.fontnum  = 7
     1353       temp-font.fontname = trim(loc-name)
     1354       temp-font.fontsize = trim(loc-size)
     1355       temp-font.fonttype = trim(loc-type)
     1356       temp-font.v-row    = 62
     1357       temp-font.v-col    = 136
     1358       temp-font.v-row-lans = 43
     1359       temp-font.v-col-lans = 198
     1360     .
     1361     repeat ii = 16 to 100 :
     1362       get-key-value section 'fonts' key 'font' + string(ii)   value v-font  .
     1363       if v-font = "" or v-font = ? then leave.
     1364       case num-entries (v-font) :
     1365         when 4 then do:
     1366             assign
     1367               loc-name = entry ( 1 , v-font )
     1368               loc-size = entry ( 2 , v-font )
     1369               loc-type = entry ( 3 , v-font ) + "," +  entry ( 4 , v-font )
     1370             .
     1371         end.
     1372         when 3 then do:
     1373             assign
     1374               loc-name = entry ( 1 , v-font )
     1375               loc-size = entry ( 2 , v-font )
     1376               loc-type = entry ( 3 , v-font )
     1377             .
     1378         end.
     1379         when 2 then do:
     1380             assign
     1381               loc-name = entry ( 1 , v-font )
     1382               loc-size = entry ( 2 , v-font )
     1383               loc-type = ""
     1384             .
     1385         end.
     1386         when 1 then do:
     1387             assign
     1388               loc-name = trim(entry ( 1 , v-font ))
     1389               loc-size = ""
     1390               loc-type = ""
     1391             .
     1392         end.
     1393       end case.
     1394     create temp-font.
     1395     assign
     1396       temp-font.fontnum  = ii
     1397       temp-font.fontname = trim(loc-name)
     1398       temp-font.fontsize = trim(loc-size)
     1399       temp-font.fonttype = trim(loc-type)
     1400     .
     1401     end.
     1402       for each temp-font :
     1403          vv = integer(entry(2,temp-font.fontsize, "=" )) no-error .
     1404          if  vv = ? then vv =  0 .
     1405           run rep/exfont.p (
     1406             input   temp-font.fontname ,
     1407             input   vv ,
     1408             input   temp-font.fonttype ,
     1409             output  temp-font.font-h   ,
     1410             output  temp-font.font-w   )
     1411           .
     1412       end.
     1413   find first temp-font where  temp-font.fontnum  = 7  .
     1414   old_H = temp-font.font-H .
     1415   old_w = temp-font.font-W .
     1416   old-row = temp-font.v-row .
     1417   old-col = temp-font.v-col .
     1418   old-row-lans = temp-font.v-row-lans .
     1419   old-col-lans = temp-font.v-col-lans .
     1420       for each temp-font where
     1421                temp-font.fontnum  <> 7 :
     1422           assign
     1423               temp-font.v-row    = old_H * old-row / temp-font.font-h
     1424               temp-font.v-col    = old_W * old-col / temp-font.font-W
     1425               temp-font.v-row-lans    = old_H * old-row-lans / temp-font.font-h
     1426               temp-font.v-col-lans    = old_W * old-col-lans / temp-font.font-W
     1427           .
     1428       end.
     1429     end.
     1430   end procedure.
     1431   PROCEDURE How-name :
     1432   define input  parameter h as integer no-undo .
     1433   define input  parameter w as integer no-undo .
     1434   define output parameter n as character  no-undo .
     1435   define variable A4port-H as integer   no-undo init 63.
     1436   define variable A4port-W as integer   no-undo init 136.
     1437   define variable A4lans-H as integer   no-undo init 43.
     1438   define variable A4lans-W as integer   no-undo init 198.
     1439   define variable Strim-W  as integer   no-undo init 278.
     1440   run define-a4-size (
     1441        input ReportFontNum
     1442       ,output A4port-H
     1443       ,output A4port-W
     1444       ,output A4lans-H
     1445       ,output A4lans-W ).
     1446   If w >= 1 and w <= A4port-W Then DO:
     1447     If h >= 1  and h <= A4lans-H Then n = "A4-lans":U.
     1448     If h > A4lans-H  and h <= A4port-H Then n = "A4-port":U.
     1449     If h > A4port-H              Then n = "to-file":U.
     1450   End.
     1451   If w > A4port-W and w <= A4lans-W Then DO:
     1452     If h >= 1  and h <= A4lans-H Then n = "A4-lans":U.
     1453     If h > A4lans-H  and h <= A4port-H Then n = "A3-lans":U.
     1454     If h > A4port-H              Then n = "to-file":U.
     1455   End.
     1456   If w > A4lans-W and w <= Strim-W Then DO:
     1457     If h >= 1  and h <= A4lans-H Then n = "to-file":U.
     1458     If h > A4lans-H  and h <= A4port-H Then n = "A3-lans":U.
     1459     If h > A4port-H              Then n = "to-file":U.
     1460   End.
     1461   If w > Strim-W Then DO:
     1462      n = "to-file":U.
     1463   End.
     1464   END PROCEDURE.
     1465   PROCEDURE define-a4-size :
     1466   define input  parameter p-ReportFontNum as integer   no-undo .
     1467   define output parameter A4port-H as integer   no-undo .
     1468   define output parameter A4port-W as integer   no-undo .
     1469   define output parameter A4lans-H as integer   no-undo .
     1470   define output parameter A4lans-W as integer   no-undo .
     1471   if not can-find (first temp-font ) then do:
     1472      run get-font-ini .
     1473   end.
     1474   find first temp-font where temp-font.fontnum = p-ReportFontNum no-error .
     1475   if available temp-font then do:
     1476   assign
     1477     A4port-H = temp-font.v-row
     1478     A4port-W = temp-font.v-col
     1479     A4lans-H = temp-font.v-row-lans
     1480     A4lans-W = temp-font.v-col-lans
     1481   .
     1482   end.
     1483   else do:
     1484   assign
     1485     A4port-H = 63
     1486     A4port-W = 136
     1487     A4lans-H = 43
     1488     A4lans-W = 198
     1489   .
     1490   end.
     1491   END PROCEDURE.
     1492   define variable v-account as integer init 0 no-undo .
     1493   define variable v-account-lavel as character no-undo .
     1494   define variable v-button-stop as logical no-undo .
     1495   define variable v-kol-spice as integer no-undo .
     1496   define variable v-kol-spice2 as integer no-undo .
     1497   define variable v-kol-spice3 as integer no-undo .
     1498   DEFINE VARIABLE StopProcessing AS LOGICAL NO-UNDO.
     1499   DEFINE BUTTON StopBtn AUTO-END-KEY
     1500        LABEL "Стоп"
     1501        SIZE 10 BY 1.
     1502   DEFINE VARIABLE RecordsDone AS INTEGER FORMAT ">,>>>,>>>,>>9":U INITIAL 0
     1503        LABEL "Обработано записей"
     1504         VIEW-AS TEXT
     1505        SIZE 14 BY .67 NO-UNDO.
     1506   DEFINE VARIABLE RecordsString AS CHARACTER FORMAT "X(60)"
     1507         VIEW-AS TEXT
     1508        SIZE 53.25 BY .67
     1509        FGCOLOR 1  NO-UNDO.
     1510   DEFINE VARIABLE RecordsString2 AS CHARACTER FORMAT "X(60)"
     1511         VIEW-AS TEXT
     1512        SIZE 53.25 BY .67
     1513        FGCOLOR 1  NO-UNDO.
     1514   DEFINE VARIABLE RecordsString3 AS CHARACTER FORMAT "X(60)"
     1515         VIEW-AS TEXT
     1516        SIZE 53.25 BY .67
     1517        FGCOLOR 1  NO-UNDO.
     1518   DEFINE RECTANGLE RECT-1
     1519        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1520        SIZE 55.13 BY 4.46.
     1521   DEFINE FRAME InfoFrame
     1522        StopBtn AT ROW 4.25 COL 21.75
     1523        RecordsString AT ROW 1.21 COL 2 NO-LABEL
     1524        RecordsString2 AT ROW 1.96 COL 2 NO-LABEL
     1525        RecordsString3 AT ROW 2.58 COL 2 NO-LABEL
     1526        RecordsDone AT ROW 3.42 COL 24.88 COLON-ALIGNED
     1527        RECT-1 AT ROW 1 COL 1
     1528       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1529            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1530            TITLE "Процесс"
     1531            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
     1532   define variable mFrameView      as logical   no-undo init yes.
     1533     define variable mFramHandle as handle no-undo.
     1534     mFramHandle = frame InfoFrame:handle.
     1535     if  log-manager:logfile-name ne ?
     1536     then DO:
     1537         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1538         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1539         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
     1540     end.
     1541     mFrameView = not session:batch-mode and mFramHandle:visible.
     1542     if mFrameView
     1543     then do:
     1544       ASSIGN
     1545          FRAME InfoFrame:HIDDEN                           = TRUE
     1546          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
     1547     end.
     1548   ON CHOOSE OF StopBtn IN FRAME InfoFrame
     1549   DO:
     1550     IF not StopProcessing THEN
     1551       Message "Вы действительно хотите прервать" SKIP
     1552               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
     1553                 UPDATE StopProcessing.
     1554     IF StopProcessing THEN do:
     1555        if mFrameView
     1556        then do:
     1557           HIDE FRAME InfoFrame.
     1558        end.
     1559     End.
     1560   END.
     1561   define variable g#report-num  as integer no-undo .
     1562   def var vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1563   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
     1564   procedure paramls-clear :
     1565     define buffer buf_temp-param for temp-param .
     1566     do
     1567     on error undo, return error return-value
     1568     :
     1569       for each buf_temp-param
     1570       on error undo, return error
     1571       :
     1572         delete buf_temp-param .
     1573       end.
     1574     end.
     1575   end procedure.
     1576   procedure paramls-write :
     1577     define input  parameter p-code     as character no-undo .
     1578     define input  parameter p-sub-code as character no-undo .
     1579     define input  parameter p-value    as character no-undo .
     1580     define buffer buf_temp-param for temp-param .
     1581     do
     1582     on error undo, return error return-value
     1583     :
     1584       find first buf_temp-param
     1585         where buf_temp-param.param-code     = p-code
     1586           and buf_temp-param.param-sub-code = p-sub-code
     1587         no-error .
     1588       if not available buf_temp-param then do:
     1589         create buf_temp-param .
     1590         assign
     1591           buf_temp-param.param-code     = p-code
     1592           buf_temp-param.param-sub-code = p-sub-code
     1593         .
     1594       end.
     1595       assign
     1596         buf_temp-param.param-value = p-value
     1597       .
     1598     end.
     1599   end procedure.
     1600   procedure paramls-read :
     1601     define input  parameter p-code          as character no-undo .
     1602     define input  parameter p-sub-code      as character no-undo .
     1603     define input  parameter p-default-value as character no-undo .
     1604     define output parameter p-value         as character no-undo .
     1605     define buffer buf_temp-param for temp-param .
     1606     do
     1607     on error undo, return error return-value
     1608     :
     1609       find first buf_temp-param
     1610         where buf_temp-param.param-code     = p-code
     1611           and buf_temp-param.param-sub-code = p-sub-code
     1612         no-error .
     1613       if available buf_temp-param then do:
     1614         assign
     1615           p-value = buf_temp-param.param-value
     1616         .
     1617       end.
     1618       else do:
     1619         assign
     1620           p-value = p-default-value
     1621         .
     1622       end.
     1623     end.
     1624   end procedure.
     1625   procedure paramls-append :
     1626     define input  parameter p-code     as character no-undo .
     1627     define input  parameter p-sub-code as character no-undo .
     1628     define input  parameter p-value    as character no-undo .
     1629     define buffer buf_temp-param for temp-param .
     1630     do
     1631     on error undo, return error return-value
     1632     :
     1633       find first buf_temp-param
     1634            where buf_temp-param.param-code     = p-code
     1635              and buf_temp-param.param-sub-code = p-sub-code
     1636         no-error .
     1637       if not available buf_temp-param then do:
     1638         create buf_temp-param .
     1639         assign
     1640           buf_temp-param.param-code     = p-code
     1641           buf_temp-param.param-sub-code = p-sub-code
     1642           buf_temp-param.param-value    = p-value
     1643         .
     1644       end.
     1645       else do:
     1646           assign
     1647               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
     1648           .
     1649       end.
     1650     end.
     1651   end procedure.
     1652   define variable vss-include-info15 as character format "X(65)" no-undo
     1653   initial "@(#)$Workfile$ $Revision$".
     1654   define stream excel-line.
     1655   define stream excel-cell.
     1656   define temp-table temp_cell-data no-undo
     1657       field data-key as character
     1658       field data-value as character
     1659       index pi is primary unique data-key
     1660   .
     1661   define temp-table temp_sheet1_line-data no-undo
     1662       field sheet-name          as character
     1663       field xl-line-id          as integer
     1664       field cli-name            as character
     1665       field talon-name          as character
     1666       field talon-nominal       as character
     1667       field talon-series        as character
     1668       field give-sum-units      as character
     1669       field give-sum-money      as character
     1670       field chg-give-sum-units  as character
     1671       field chg-give-sum-money  as character
     1672       field sell-sum-units      as character
     1673       field sell-sum-money      as character
     1674       field ret-sum-units       as character
     1675       field ret-sum-money       as character
     1676       field chg-ret-sum-units   as character
     1677       field chg-ret-sum-money   as character
     1678       field spi-sum-units       as character
     1679       field spi-sum-money       as character
     1680       field restFrom-units      as character
     1681       field restFrom-money      as character
     1682       field restEnd-units       as character
     1683       field restEnd-money       as character
     1684       index pi is primary unique
     1685           xl-line-id
     1686   .
     1687   define variable v-wthobrxl-sheet1-cur-data-row  as integer      no-undo.
     1688   define variable v-wthobrxl-cell-file-name       as character    no-undo.
     1689   define variable v-wthobrxl-data-file-name       as character    no-undo.
     1690   procedure wthobrxl-init :
     1691   do
     1692   on error undo, return error
     1693   :
     1694       assign
     1695           v-wthobrxl-sheet1-cur-data-row = 0
     1696       .
     1697       run gbl/_tmpfile.p (
     1698             input "xd"
     1699           , input ".txt"
     1700           , output v-wthobrxl-data-file-name
     1701       ).
     1702       output stream excel-line to value( v-wthobrxl-data-file-name ).
     1703       run gbl/_tmpfile.p (
     1704             input "xc"
     1705           , input ".txt"
     1706           , output v-wthobrxl-cell-file-name
     1707       ).
     1708       output stream excel-cell to value( v-wthobrxl-cell-file-name ).
     1709       run wthobrxl-write-cell-data in this-procedure (
     1710             input "sheetList":U
     1711           , input "Лист1":U
     1712       ).
     1713       run wthobrxl-write-cell-data in this-procedure (
     1714             input "Лист1_regularExpressions":U
     1715           , input "1":U
     1716       ).
     1717       if printrubl
     1718       then do:
     1719           run wthobrxl-write-cell-data in this-procedure (
     1720                 input "Лист1_valutCode":U
     1721               , input "0":U
     1722           ).
     1723       end.
     1724       else do:
     1725           run wthobrxl-write-cell-data in this-procedure (
     1726                 input "Лист1_valutCode":U
     1727               , input "1":U
     1728           ).
     1729       end.
     1730       run wthobrxl-write-cell-data in this-procedure (
     1731             input "Лист1_columnList":U
     1732           , input "cliname,talonname,talonnominal,talonser,givesumunits,givesummoney,chggivesumunits,chggivesummoney,sellsumunits,sellsummoney,retsumunits,retsummoney,chgretsumunits,chgretsummoney,spisumunits,spisummoney,restfromunits,restfrommoney,restendunits,restendmoney":U
     1733       ).
     1734       run wthobrxl-write-cell-data in this-procedure (
     1735             input "Лист1_columnType":U
     1736           , input "S,S,S,S,S,S,S,S,S,S,S,S,S,S,S,S,S,S,S,S":U
     1737       ).
     1738       run wthobrxl-write-cell-data in this-procedure (
     1739             input "Лист1_subtotalList":U
     1740           , input "":U
     1741       ).
     1742       run wthobrxl-write-cell-data in this-procedure (
     1743             input "Лист1_subtotalType":U
     1744           , input "":U
     1745       ).
     1746   end.
     1747   end procedure.
     1748   procedure wthobrxl-write-line-data :
     1749   define input parameter p-cli-name            as character no-undo .
     1750   define input parameter p-talon-name          as character no-undo .
     1751   define input parameter p-talon-nominal       as character no-undo .
     1752   define input parameter p-talon-series        as character no-undo .
     1753   define input parameter p-give-sum-units      as character no-undo .
     1754   define input parameter p-give-sum-money      as character no-undo .
     1755   define input parameter p-chg-give-sum-units  as character no-undo .
     1756   define input parameter p-chg-give-sum-money  as character no-undo .
     1757   define input parameter p-sell-sum-units      as character no-undo .
     1758   define input parameter p-sell-sum-money      as character no-undo .
     1759   define input parameter p-ret-sum-units       as character no-undo .
     1760   define input parameter p-ret-sum-money       as character no-undo .
     1761   define input parameter p-chg-ret-sum-units   as character no-undo .
     1762   define input parameter p-chg-ret-sum-money   as character no-undo .
     1763   define input parameter p-spi-sum-units       as character no-undo .
     1764   define input parameter p-spi-sum-money       as character no-undo .
     1765   define input parameter p-RestFrom-units      as character no-undo .
     1766   define input parameter p-restFrom-money      as character no-undo .
     1767   define input parameter p-restEnd-units       as character no-undo .
     1768   define input parameter p-restEnd-money       as character no-undo .
     1769   define buffer buf_temp_sheet1_line-data      for temp_sheet1_line-data.
     1770   do
     1771   for buf_temp_sheet1_line-data
     1772   on error undo, return error
     1773   :
     1774       for each buf_temp_sheet1_line-data
     1775       :
     1776           delete buf_temp_sheet1_line-data.
     1777       end.
     1778       create buf_temp_sheet1_line-data.
     1779       assign
     1780           v-wthobrxl-sheet1-cur-data-row = v-wthobrxl-sheet1-cur-data-row + 1
     1781       .
     1782       assign
     1783           buf_temp_sheet1_line-data.sheet-name          = "Лист1":U
     1784           buf_temp_sheet1_line-data.xl-line-id          = v-wthobrxl-sheet1-cur-data-row
     1785           buf_temp_sheet1_line-data.cli-name            = p-cli-name
     1786           buf_temp_sheet1_line-data.talon-name          = p-talon-name
     1787           buf_temp_sheet1_line-data.talon-nominal       = p-talon-nominal
     1788           buf_temp_sheet1_line-data.talon-series        = p-talon-series
     1789           buf_temp_sheet1_line-data.give-sum-units      = p-give-sum-units
     1790           buf_temp_sheet1_line-data.give-sum-money      = p-give-sum-money
     1791           buf_temp_sheet1_line-data.chg-give-sum-units  = p-chg-give-sum-units
     1792           buf_temp_sheet1_line-data.chg-give-sum-money  = p-chg-give-sum-money
     1793           buf_temp_sheet1_line-data.sell-sum-units      = p-sell-sum-units
     1794           buf_temp_sheet1_line-data.sell-sum-money      = p-sell-sum-money
     1795           buf_temp_sheet1_line-data.ret-sum-units       = p-ret-sum-units
     1796           buf_temp_sheet1_line-data.ret-sum-money       = p-ret-sum-money
     1797           buf_temp_sheet1_line-data.chg-ret-sum-units   = p-chg-ret-sum-units
     1798           buf_temp_sheet1_line-data.chg-ret-sum-money   = p-chg-ret-sum-money
     1799           buf_temp_sheet1_line-data.spi-sum-units       = p-spi-sum-units
     1800           buf_temp_sheet1_line-data.spi-sum-money       = p-spi-sum-money
     1801           buf_temp_sheet1_line-data.RestFrom-units      = p-RestFrom-units
     1802           buf_temp_sheet1_line-data.restFrom-money      = p-restFrom-money
     1803           buf_temp_sheet1_line-data.restEnd-units       = p-restEnd-units
     1804           buf_temp_sheet1_line-data.restEnd-money       = p-restEnd-money
     1805       .
     1806       put stream excel-line unformatted
     1807                           buf_temp_sheet1_line-data.sheet-name
     1808           CHR(9)   "DTA":U
     1809           CHR(9)   buf_temp_sheet1_line-data.cli-name
     1810           CHR(9)   buf_temp_sheet1_line-data.talon-name
     1811           CHR(9)   buf_temp_sheet1_line-data.talon-nominal
     1812           CHR(9)   buf_temp_sheet1_line-data.talon-series
     1813           CHR(9)   buf_temp_sheet1_line-data.give-sum-units
     1814           CHR(9)   buf_temp_sheet1_line-data.give-sum-money
     1815           CHR(9)   buf_temp_sheet1_line-data.chg-give-sum-units
     1816           CHR(9)   buf_temp_sheet1_line-data.chg-give-sum-money
     1817           CHR(9)   buf_temp_sheet1_line-data.sell-sum-units
     1818           CHR(9)   buf_temp_sheet1_line-data.sell-sum-money
     1819           CHR(9)   buf_temp_sheet1_line-data.ret-sum-units
     1820           CHR(9)   buf_temp_sheet1_line-data.ret-sum-money
     1821           CHR(9)   buf_temp_sheet1_line-data.chg-ret-sum-units
     1822           CHR(9)   buf_temp_sheet1_line-data.chg-ret-sum-money
     1823           CHR(9)   buf_temp_sheet1_line-data.spi-sum-units
     1824           CHR(9)   buf_temp_sheet1_line-data.spi-sum-money
     1825           CHR(9)   buf_temp_sheet1_line-data.RestFrom-units
     1826           CHR(9)   buf_temp_sheet1_line-data.restFrom-money
     1827           CHR(9)   buf_temp_sheet1_line-data.restEnd-units
     1828           CHR(9)   buf_temp_sheet1_line-data.restEnd-money
     1829           chr(10)
     1830       .
     1831   end.
     1832   end procedure.
     1833   procedure wthobrxl-write-cell-data :
     1834   define input parameter p-data-key   as character        no-undo.
     1835   define input parameter p-data-value as character        no-undo.
     1836       define buffer buf_temp_cell-data     for temp_cell-data.
     1837   do
     1838   for buf_temp_cell-data
     1839   on error undo, return error
     1840   :
     1841       find first buf_temp_cell-data
     1842            where buf_temp_cell-data.data-key = p-data-key
     1843       no-error.
     1844       if not available buf_temp_cell-data
     1845       then do:
     1846           create buf_temp_cell-data.
     1847           assign
     1848               buf_temp_cell-data.data-key = p-data-key
     1849           .
     1850       end.
     1851       assign
     1852           buf_temp_cell-data.data-value = p-data-value
     1853       .
     1854       put stream excel-cell unformatted
     1855                           buf_temp_cell-data.data-key
     1856           CHR(9)   buf_temp_cell-data.data-value
     1857           chr(10)
     1858       .
     1859   end.
     1860   end procedure.
     1861   procedure wthobrxl-sheet1-write-line-format :
     1862   define input parameter p-fmt-label       as character  no-undo.
     1863       define buffer buf_temp_sheet1_line-data        for temp_sheet1_line-data.
     1864   do
     1865   for buf_temp_sheet1_line-data
     1866   on error undo, return error
     1867   :
     1868       put stream excel-line unformatted
     1869                           "Лист1":U
     1870           CHR(9)   "FMT":U
     1871           CHR(9)   p-fmt-label
     1872           chr(10)
     1873       .
     1874   end.
     1875   end procedure.
     1876   procedure wthobrxl-run-excel :
     1877   define input parameter p-header-filename    as character        no-undo.
     1878   define input parameter p-data-filename      as character        no-undo.
     1879       define variable v-template-file-name    as character    no-undo.
     1880       define variable v-vb-file-name          as character    no-undo.
     1881       define buffer buf_temp-param for temp-param .
     1882   do
     1883   for buf_temp-param
     1884   on error undo, return error
     1885   :
     1886       create buf_temp-param.
     1887       assign
     1888           v-template-file-name    = search( "exe/wth-obr.xlt" )
     1889           v-vb-file-name          = search( "exe/t_form.bas" )
     1890       .
     1891       if v-template-file-name = ?
     1892       or v-template-file-name = "":U
     1893       then do:
     1894           message
     1895               "Ошибка имени файла шаблона."
     1896           view-as alert-box error.
     1897       end.
     1898       if v-vb-file-name = ?
     1899       or v-vb-file-name = "":U
     1900       then do:
     1901           message
     1902               "Ошибка имени файла кода обработки."
     1903           view-as alert-box error.
     1904       end.
     1905       run paramls-write in this-procedure (
     1906             input "template":U
     1907           , input "template-file-name":U
     1908           , input v-template-file-name
     1909       ).
     1910       run paramls-write in this-procedure (
     1911             input "template":U
     1912           , input "vb-file-name":U
     1913           , input v-vb-file-name
     1914       ).
     1915       run paramls-write in this-procedure (
     1916             input "data":U
     1917           , input "data-header-filename":U
     1918           , input p-header-filename
     1919       ).
     1920       run paramls-write in this-procedure (
     1921             input "data":U
     1922           , input "data-filename":U
     1923           , input p-data-filename
     1924       ).
     1925       run gbl/macroxlt.p (
     1926           input-output table buf_temp-param
     1927       ) no-error.
     1928       if error-status :error
     1929       then do:
     1930           message
     1931                    vss-workfile vss-revision vss-description
     1932               skip(1)
     1933               skip "Ошибка создания файла Excel."
     1934               skip return-value
     1935               skip trim(error-status :get-message(1))
     1936                    trim(error-status :get-message(2))
     1937                    trim(error-status :get-message(3))
     1938           view-as alert-box error.
     1939           undo, return error .
     1940       end.
     1941   end.
     1942   end procedure.
     1943   procedure wthobrxl-close :
     1944   do
     1945   on error undo, return error
     1946   :
     1947       output stream excel-line close.
     1948       output stream excel-cell close.
     1949       output to value( string( session:temp-directory + "$" + string( g#report-num ) ) + ".txl" ) append.
     1950           export "exe/wth-obr.xlt":U.
     1951           export "exe/t_form.bas":U.
     1952           export v-wthobrxl-cell-file-name.
     1953           export v-wthobrxl-data-file-name.
     1954       output close.
     1955   end.
     1956   end procedure.
     1957   define temp-table tt-clients  no-undo like ub.clients.
     1958   define temp-table tt-wealth   no-undo like ub.wealth.
     1959   define temp-table tt-wth-par  no-undo like ub.wth-par.
     1960   define temp-table tt-wth-ser  no-undo like ub.wth-ser.
     1961   define temp-table tt-wth-parts  no-undo like ub.wth-parts
     1962   index idx-cli-dt cli-type
     1963                 cli-code
     1964                 beg-dt
     1965                 ext-doc-type
     1966                 out-code
     1967   index idx-cli-fact cli-type
     1968                      cli-code
     1969                      fact-date
     1970                      ext-doc-type
     1971                      out-code
     1972   .
     1973   define temp-table tt-rest  no-undo like ub.wth-parts
     1974   index idx-cli-fact cli-type
     1975                      cli-code
     1976                      fact-date
     1977                      ext-doc-type
     1978                      out-code
     1979   .
     1980   define temp-table tt-report no-undo
     1981     field cli-type            like ub.clients.obj-type
     1982     field cli-code            like ub.clients.obj-code
     1983     field wth-code            like ub.wealth.wth-code
     1984     field par-code            like ub.wth-par.par-code
     1985     field par-val             like ub.wth-par.par-val
     1986     field ser-code            like ub.wth-ser.ser-code
     1987     field db-num              like ub.wth-ser.db-num
     1988     field cli-name            as character
     1989     field talon-name          as character
     1990     field talon-nominal       as character
     1991     field talon-series        as character
     1992     field give-sum-units      as decimal
     1993     field give-sum-money      as decimal
     1994     field chg-give-sum-units  as decimal
     1995     field chg-give-sum-money  as decimal
     1996     field sell-sum-units      as decimal
     1997     field sell-sum-money      as decimal
     1998     field ret-sum-units       as decimal
     1999     field ret-sum-money       as decimal
     2000     field chg-ret-sum-units   as decimal
     2001     field chg-ret-sum-money   as decimal
     2002     field spi-sum-units       as decimal
     2003     field spi-sum-money       as decimal
     2004     field restFrom-units      as decimal
     2005     field restFrom-money      as decimal
     2006     field restEnd-units      as decimal
     2007     field restEnd-money      as decimal
     2008   index pi is primary unique
     2009     cli-type
     2010     cli-code
     2011     wth-code
     2012     par-code
     2013     ser-code
     2014     db-num
     2015   .
     2016   define temp-table tt-report-cli no-undo
     2017     field cli-type            like ub.clients.obj-type
     2018     field cli-code            like ub.clients.obj-code
     2019     field give-sum-units      as decimal
     2020     field give-sum-money      as decimal
     2021     field chg-give-sum-units  as decimal
     2022     field chg-give-sum-money  as decimal
     2023     field sell-sum-units      as decimal
     2024     field sell-sum-money      as decimal
     2025     field ret-sum-units       as decimal
     2026     field ret-sum-money       as decimal
     2027     field chg-ret-sum-units   as decimal
     2028     field chg-ret-sum-money   as decimal
     2029     field spi-sum-units       as decimal
     2030     field spi-sum-money       as decimal
     2031     field restFrom-units      as decimal
     2032     field restFrom-money      as decimal
     2033     field restEnd-units       as decimal
     2034     field restEnd-money       as decimal
     2035   index pi is primary unique
     2036     cli-type
     2037     cli-code
     2038   .
     2039   define stream out-stream.
     2040   define buffer buf_wealth      for ub.wealth.
     2041   define buffer buf_wth-gds     for ub.wth-gds.
     2042   define buffer buf_wth-par     for ub.wth-par.
     2043   define buffer buf_goods       for ub.goods.
     2044   define buffer buf_objects     for ub.clients.
     2045   define variable v-is-wth-restrict   as logical   no-undo .
     2046   define variable v-is-par-restrict   as logical   no-undo .
     2047   define variable v-is-ser-restrict   as logical   no-undo .
     2048   define variable v-print-rubl        as logical   no-undo .
     2049   define variable v-fact-order-start  as decimal   no-undo .
     2050   define variable v-fact-order-end    as decimal   no-undo .
     2051   define variable v-line              as character no-undo .
     2052   do on error undo, return error return-value
     2053   :
     2054     assign
     2055       v-line = fill( "-" , 300 )
     2056     .
     2057      if lookup( string(p-cb-wth-detail) , "1,2,3,4":U ) = 0
     2058      then do:
     2059       message
     2060         "Неверно указан уровень детализации!"
     2061       view-as alert-box error.
     2062       return error .
     2063      end.
     2064   if session :set-wait-state( "compiler" ) then.
     2065     run get-report-num in my-handle (output g#report-num).
     2066   output stream out-stream to value( string( session:temp-directory +
     2067                                        "rpt" + string( g#report-num ) ) )
     2068                                        page-size 62 .
     2069     run wthobrxl-init in this-procedure .
     2070     run fill-tt in this-procedure .
     2071     run waitfram-show in this-procedure ("Печать отчета...") .
     2072     run print-header in this-procedure .
     2073     run print-report in this-procedure .
     2074     run waitfram-hide in this-procedure .
     2075     put stream out-stream unformatted " "  skip.
     2076     run clear-tt in this-procedure .
     2077     run wthobrxl-close in this-procedure .
     2078     output stream out-stream close.
     2079     if Make-Excel then output stream ForExcel close.
     2080   if session :set-wait-state( "" ) then.
     2081     os-delete value( string( session:temp-directory ) + "rpt" + string( g#report-num ) + ".txl" )  .
     2082     os-rename
     2083       value( string( session:temp-directory ) + "$" + string( g#report-num ) + ".txl" )
     2084       value( string( session:temp-directory ) + "rpt" + string( g#report-num ) + ".txl" )
     2085     .
     2086     define variable v-user-action   as character no-undo .
     2087     define variable v-printed       as logical   no-undo .
     2088     define variable DisabledOptions as integer   no-undo .
     2089     define variable v-orient-page as character no-undo .
     2090     run How-name in this-procedure (
     2091         input ReportPageHeight,
     2092         input ReportPageWidth,
     2093         output v-orient-page )
     2094         .
     2095     if v-orient-page = "A4-lans":U then DisabledOptions = 8 .
     2096                                    else DisabledOptions = 0 .
     2097     run gbl/prnfilen.w
     2098         (input  ""
     2099         ,input  20
     2100         ,input  string(session :temp-directory) + "rpt" + string( g#report-num )
     2101         ,input  ReportFontNum
     2102         ,output v-user-action
     2103         ,output v-printed
     2104         ) .
     2105     os-delete value( string( session:temp-directory ) + "rpt" + string( g#report-num ) ) .
     2106     os-delete value( string( session:temp-directory ) + "rpt" + string( g#report-num ) + ".txl" ) .
     2107   end.
     2108   procedure clear-tt :
     2109   do
     2110   on error undo, return error return-value
     2111   :
     2112    empty temp-table tt-clients.
     2113    empty temp-table tt-wealth .
     2114    empty temp-table tt-wth-par.
     2115    empty temp-table tt-wth-ser.
     2116    empty temp-table tt-report .
     2117    empty temp-table tt-report-cli .
     2118    empty temp-table tt-wth-parts .
     2119   end.
     2120   end procedure.
     2121   procedure fill-tt :
     2122   do
     2123   on error undo, return error return-value
     2124   :
     2125     define buffer buf_wealth        for ub.wealth .
     2126     define buffer buf_wth-par       for ub.wth-par.
     2127     define buffer buf_wth-ser       for ub.wth-ser.
     2128     define buffer buf_clients       for ub.clients.
     2129     define buffer buf_wth-parts     for tt-wth-parts.
     2130     define buffer b_wth-parts       for ub.wth-parts.
     2131     define buffer buf_tt-clients    for tt-clients.
     2132     define buffer buf_tt-wealth     for tt-wealth .
     2133     define buffer buf_tt-wth-par    for tt-wth-par.
     2134     define buffer buf_tt-wth-ser    for tt-wth-ser.
     2135     define buffer buf_tt-report     for tt-report .
     2136     define buffer buf_tt-report-cli for tt-report-cli.
     2137     define variable v-give-sum-units      as decimal   no-undo .
     2138     define variable v-give-sum-money      as decimal   no-undo .
     2139     define variable v-chg-give-sum-units  as decimal   no-undo .
     2140     define variable v-chg-give-sum-money  as decimal   no-undo .
     2141     define variable v-sell-sum-units      as decimal   no-undo .
     2142     define variable v-sell-sum-money      as decimal   no-undo .
     2143     define variable v-ret-sum-units       as decimal   no-undo .
     2144     define variable v-ret-sum-money       as decimal   no-undo .
     2145     define variable v-chg-ret-sum-units   as decimal   no-undo .
     2146     define variable v-chg-ret-sum-money   as decimal   no-undo .
     2147     define variable v-spi-sum-units       as decimal   no-undo .
     2148     define variable v-spi-sum-money       as decimal   no-undo .
     2149     define variable v-restFrom-units      as decimal   no-undo .
     2150     define variable v-restFrom-money      as decimal   no-undo .
     2151     define variable v-restEnd-units       as decimal   no-undo .
     2152     define variable v-restEnd-money       as decimal   no-undo .
     2153     define variable v-i                   as integer   no-undo .
     2154     define variable v-total               as integer   no-undo .
     2155     define variable v-counter             as integer   no-undo .
     2156     define variable v-repfrm-str          as character no-undo .
     2157     run clear-tt in this-procedure .
     2158     run waitfram-show in this-procedure ("Обработка данных...") .
     2159     if p-clients-recid-list <> ''
     2160     then do:
     2161       assign
     2162         v-total = num-entries(p-clients-recid-list)
     2163       .
     2164       do v-i = 1 to v-total:
     2165         find first buf_clients no-lock
     2166           where recid(buf_clients) = integer(entry(v-i,p-clients-recid-list))
     2167         no-error .
     2168         if available buf_clients
     2169         then do:
     2170           find first buf_tt-clients
     2171             where buf_tt-clients.obj-type = buf_clients.obj-type
     2172               and buf_tt-clients.obj-code = buf_clients.obj-code
     2173           no-error .
     2174           if not available buf_tt-clients
     2175           then do:
     2176             create buf_tt-clients.
     2177             buffer-copy buf_clients to buf_tt-clients.
     2178           end.
     2179         end.
     2180       end.
     2181     end.
     2182     else do:
     2183       for each buf_clients no-lock
     2184       :
     2185         find first buf_tt-clients
     2186           where buf_tt-clients.obj-type = buf_clients.obj-type
     2187             and buf_tt-clients.obj-code = buf_clients.obj-code
     2188         no-error .
     2189         if not available buf_tt-clients
     2190         then do:
     2191           create buf_tt-clients.
     2192           buffer-copy buf_clients to buf_tt-clients.
     2193         end.
     2194       end.
     2195     end.
     2196     if p-wth-recid-list <> ''
     2197     then do:
     2198       assign
     2199         v-total = num-entries(p-wth-recid-list)
     2200       .
     2201       case p-rs-wth-type:
     2202         when 1 then do:
     2203           assign
     2204             v-is-wth-restrict = yes
     2205           .
     2206           do v-i = 1 to v-total
     2207           :
     2208             find first buf_wealth no-lock
     2209               where recid(buf_wealth) = integer( entry( v-i , p-wth-recid-list ) )
     2210             no-error .
     2211             if available buf_wealth then do:
     2212               find first buf_tt-wealth no-lock
     2213                 where buf_tt-wealth.wth-code = buf_wealth.wth-code
     2214               no-error .
     2215               if not available buf_tt-wealth then do:
     2216                 create buf_tt-wealth.
     2217                 buffer-copy buf_wealth to buf_tt-wealth.
     2218               end.
     2219             end.
     2220           end.
     2221         end.
     2222         when 2 then do:
     2223           assign
     2224             v-is-par-restrict = yes
     2225           .
     2226           do v-i = 1 to v-total
     2227           :
     2228             find first buf_wth-par no-lock
     2229               where recid(buf_wth-par) = integer( entry( v-i , p-wth-recid-list ) )
     2230             no-error .
     2231             if available buf_wth-par then do:
     2232               find first buf_tt-wth-par no-lock
     2233                 where buf_tt-wth-par.wth-code = buf_wth-par.wth-code
     2234                   and buf_tt-wth-par.par-code = buf_wth-par.par-code
     2235               no-error .
     2236               if not available buf_tt-wth-par then do:
     2237                 create buf_tt-wth-par.
     2238                 buffer-copy buf_wth-par to buf_tt-wth-par.
     2239               end.
     2240             end.
     2241           end.
     2242         end.
     2243         when 3 then do:
     2244           assign
     2245             v-is-ser-restrict = yes
     2246           .
     2247           do v-i = 1 to v-total
     2248           :
     2249             find first buf_wth-ser no-lock
     2250               where recid(buf_wth-ser) = integer( entry( v-i , p-wth-recid-list ) )
     2251             no-error .
     2252             if available buf_wth-ser then do :
     2253               find first buf_tt-wth-ser no-lock
     2254                 where buf_tt-wth-ser.ser-code = buf_wth-ser.ser-code
     2255                   and buf_tt-wth-ser.db-num   = buf_wth-ser.db-num
     2256               no-error .
     2257               if not available buf_tt-wth-ser then do:
     2258                 create buf_tt-wth-ser.
     2259                 buffer-copy buf_wth-ser to buf_tt-wth-ser.
     2260               end.
     2261             end.
     2262           end.
     2263         end.
     2264       end case .
     2265     end.
     2266     run waitfram-hide in this-procedure .
     2267     assign
     2268       v-repfrm-str = "Расчет партий МЦ..."
     2269     .
     2270     etime(yes).
     2271   if p-dt-calc = 1 then do:
     2272       if p-wth-recid-list <> '' and p-rs-wth-type = 1  then   do:
     2273           for each buf_tt-wealth no-lock,
     2274           each b_wth-parts no-lock where b_wth-parts.fact-date >= x-date-start
     2275                                           and b_wth-parts.fact-date <= x-date-end
     2276                                           and b_wth-parts.wth-code = buf_tt-wealth.wth-code
     2277                                           and lookup(b_wth-parts.out-code,'free-zone,out-zone,cli-zone,фальшивый,put-zone':u) = 0
     2278                                           and (b_wth-parts.ext-doc-type = 'ee':U or
     2279                                                 b_wth-parts.ext-doc-type = 'xc':U    or
     2280                                                 b_wth-parts.ext-doc-type = 'pz':U or
     2281                                                 b_wth-parts.ext-doc-type = 'dc':U or
     2282                                                 b_wth-parts.ext-doc-type = 'pc':U or
     2283                                                 b_wth-parts.ext-doc-type = 'ps':U)
     2284                                           and b_wth-parts.fact-num <> 0    :
     2285               create tt-wth-parts.
     2286               buffer-copy b_wth-parts to tt-wth-parts.
     2287           end.
     2288           for each buf_tt-wealth no-lock,
     2289           each b_wth-parts no-lock where ((b_wth-parts.fact-date > x-date-end and lookup(b_wth-parts.out-code,'free-zone,out-zone,cli-zone,фальшивый,put-zone':u) = 0 and b_wth-parts.fact-num <> 0 ) or b_wth-parts.out-code = 'cli-zone':U )
     2290                                           and b_wth-parts.wth-code = buf_tt-wealth.wth-code
     2291                                           and (b_wth-parts.ext-doc-type = 'ee':U or
     2292                                                 b_wth-parts.ext-doc-type = 'xc':U    or
     2293                                                 b_wth-parts.ext-doc-type = 'pz':U or
     2294                                                 b_wth-parts.ext-doc-type = 'dc':U or
     2295                                                 b_wth-parts.ext-doc-type = 'pc':U or
     2296                                                 b_wth-parts.ext-doc-type = 'ps':U)
     2297                                          :
     2298               create tt-rest.
     2299               buffer-copy b_wth-parts to tt-rest.
     2300           end.
     2301       end.
     2302       else if p-wth-recid-list <> '' and p-rs-wth-type = 2 then do:
     2303           for each buf_tt-wth-par no-lock ,
     2304               each b_wth-parts no-lock where b_wth-parts.fact-date >= x-date-start
     2305                                           and b_wth-parts.fact-date <= x-date-end
     2306                                           and b_wth-parts.wth-code = buf_tt-wth-par.wth-code
     2307                                           and b_wth-parts.par-code = buf_tt-wth-par.par-code
     2308                                           and lookup(b_wth-parts.out-code,'free-zone,out-zone,cli-zone,фальшивый,put-zone':u) = 0
     2309                                           and (b_wth-parts.ext-doc-type = 'ee':U or
     2310                                                 b_wth-parts.ext-doc-type = 'xc':U    or
     2311                                                 b_wth-parts.ext-doc-type = 'pz':U or
     2312                                                 b_wth-parts.ext-doc-type = 'dc':U or
     2313                                                 b_wth-parts.ext-doc-type = 'pc':U or
     2314                                                 b_wth-parts.ext-doc-type = 'ps':U)
     2315                                           and b_wth-parts.fact-num <> 0 :
     2316               create tt-wth-parts.
     2317               buffer-copy b_wth-parts to tt-wth-parts.
     2318           end.
     2319           for each buf_tt-wth-par no-lock ,
     2320               each b_wth-parts no-lock where ((b_wth-parts.fact-date > x-date-end and lookup(b_wth-parts.out-code,'free-zone,out-zone,cli-zone,фальшивый,put-zone':u) = 0 and b_wth-parts.fact-num <> 0 ) or b_wth-parts.out-code = 'cli-zone':U )
     2321                                           and b_wth-parts.wth-code = buf_tt-wth-par.wth-code
     2322                                           and b_wth-parts.par-code = buf_tt-wth-par.par-code
     2323                                           and (b_wth-parts.ext-doc-type = 'ee':U or
     2324                                                 b_wth-parts.ext-doc-type = 'xc':U    or
     2325                                                 b_wth-parts.ext-doc-type = 'pz':U or
     2326                                                 b_wth-parts.ext-doc-type = 'dc':U or
     2327                                                 b_wth-parts.ext-doc-type = 'pc':U or
     2328                                                 b_wth-parts.ext-doc-type = 'ps':U):
     2329               create tt-rest.
     2330               buffer-copy b_wth-parts to tt-rest.
     2331           end.
     2332       end.
     2333       else do:
     2334           for each b_wth-parts no-lock where b_wth-parts.fact-date >= x-date-start
     2335                                           and b_wth-parts.fact-date <= x-date-end
     2336                                           and lookup(b_wth-parts.out-code,'free-zone,out-zone,cli-zone,фальшивый,put-zone':u) = 0
     2337                                           and (b_wth-parts.ext-doc-type = 'ee':U or
     2338                                                 b_wth-parts.ext-doc-type = 'xc':U    or
     2339                                                 b_wth-parts.ext-doc-type = 'pz':U or
     2340                                                 b_wth-parts.ext-doc-type = 'dc':U or
     2341                                                 b_wth-parts.ext-doc-type = 'pc':U or
     2342                                                 b_wth-parts.ext-doc-type = 'ps':U)
     2343                                          and b_wth-parts.fact-num <> 0 :
     2344               create tt-wth-parts.
     2345               buffer-copy b_wth-parts to tt-wth-parts.
     2346           end.
     2347           for each b_wth-parts no-lock where ((b_wth-parts.fact-date > x-date-end and lookup(b_wth-parts.out-code,'free-zone,out-zone,cli-zone,фальшивый,put-zone':u) = 0 and b_wth-parts.fact-num <> 0 ) or b_wth-parts.out-code = 'cli-zone':U )
     2348                                            and (b_wth-parts.ext-doc-type = 'ee':U or      b_wth-parts.ext-doc-type = 'xc':U    or      b_wth-parts.ext-doc-type = 'pz':U or      b_wth-parts.ext-doc-type = 'dc':U or       b_wth-parts.ext-doc-type = 'pc':U or       b_wth-parts.ext-doc-type = 'ps':U) :
     2349               create tt-rest.
     2350               buffer-copy b_wth-parts to tt-rest.
     2351           end.
     2352       end.
     2353   end.
     2354   if p-dt-calc = 2 then do:
     2355    for each b_wth-parts no-lock where b_wth-parts.beg-dt >= x-date-start
     2356                                   and b_wth-parts.beg-dt <= x-date-end
     2357                                   and (b_wth-parts.ext-doc-type = 'ee':U or      b_wth-parts.ext-doc-type = 'xc':U    or      b_wth-parts.ext-doc-type = 'pz':U or      b_wth-parts.ext-doc-type = 'dc':U or       b_wth-parts.ext-doc-type = 'pc':U or       b_wth-parts.ext-doc-type = 'ps':U):
     2358       create tt-wth-parts.
     2359       buffer-copy b_wth-parts to tt-wth-parts.
     2360    end.
     2361    if p-wth-recid-list <> '' and p-rs-wth-type = 1  then
     2362       for each buf_tt-wealth no-lock,
     2363       each b_wth-parts no-lock where b_wth-parts.beg-dt >= x-date-start
     2364                                   and b_wth-parts.beg-dt <= x-date-end
     2365                                       and b_wth-parts.wth-code = buf_tt-wealth.wth-code
     2366                                       and (b_wth-parts.ext-doc-type = 'ee':U or      b_wth-parts.ext-doc-type = 'xc':U    or      b_wth-parts.ext-doc-type = 'pz':U or      b_wth-parts.ext-doc-type = 'dc':U or       b_wth-parts.ext-doc-type = 'pc':U or       b_wth-parts.ext-doc-type = 'ps':U):
     2367           create tt-wth-parts.
     2368           buffer-copy b_wth-parts to tt-wth-parts.
     2369       end.
     2370       else if p-wth-recid-list <> '' and p-rs-wth-type = 2 then
     2371       for each buf_tt-wth-par no-lock ,
     2372           each b_wth-parts no-lock where b_wth-parts.beg-dt >= x-date-start
     2373                                   and b_wth-parts.beg-dt <= x-date-end
     2374                                       and b_wth-parts.wth-code = buf_tt-wth-par.wth-code
     2375                                       and b_wth-parts.par-code = buf_tt-wth-par.par-code
     2376                                       and (b_wth-parts.ext-doc-type = 'ee':U or      b_wth-parts.ext-doc-type = 'xc':U    or      b_wth-parts.ext-doc-type = 'pz':U or      b_wth-parts.ext-doc-type = 'dc':U or       b_wth-parts.ext-doc-type = 'pc':U or       b_wth-parts.ext-doc-type = 'ps':U):
     2377           create tt-wth-parts.
     2378           buffer-copy b_wth-parts to tt-wth-parts.
     2379       end.
     2380       else
     2381       for each b_wth-parts no-lock where b_wth-parts.beg-dt >= x-date-start
     2382                                   and b_wth-parts.beg-dt <= x-date-end
     2383                                   and (b_wth-parts.ext-doc-type = 'ee':U or      b_wth-parts.ext-doc-type = 'xc':U    or      b_wth-parts.ext-doc-type = 'pz':U or      b_wth-parts.ext-doc-type = 'dc':U or       b_wth-parts.ext-doc-type = 'pc':U or       b_wth-parts.ext-doc-type = 'ps':U):
     2384           create tt-wth-parts.
     2385           buffer-copy b_wth-parts to tt-wth-parts.
     2386       end.
     2387   end.
     2388   if p-dt-calc = 3 then do:
     2389       if p-wth-recid-list <> '' and p-rs-wth-type = 1  then
     2390       for each buf_tt-wealth no-lock,
     2391       each b_wth-parts no-lock where b_wth-parts.fact-date >= x-date-start
     2392                                       and b_wth-parts.fact-date <= x-date-end
     2393                                       and b_wth-parts.wth-code = buf_tt-wealth.wth-code
     2394                                       and b_wth-parts.beg-dt >= p-dtFrom
     2395                                       and b_wth-parts.beg-dt <= p-dtTo
     2396                                       and (b_wth-parts.ext-doc-type = 'ee':U or      b_wth-parts.ext-doc-type = 'xc':U    or      b_wth-parts.ext-doc-type = 'pz':U or      b_wth-parts.ext-doc-type = 'dc':U or       b_wth-parts.ext-doc-type = 'pc':U or       b_wth-parts.ext-doc-type = 'ps':U):
     2397           create tt-wth-parts.
     2398           buffer-copy b_wth-parts to tt-wth-parts.
     2399       end.
     2400       else if p-wth-recid-list <> '' and p-rs-wth-type = 2 then
     2401       for each buf_tt-wth-par no-lock ,
     2402           each b_wth-parts no-lock where b_wth-parts.fact-date >= x-date-start
     2403                                       and b_wth-parts.fact-date <= x-date-end
     2404                                       and b_wth-parts.wth-code = buf_tt-wth-par.wth-code
     2405                                       and b_wth-parts.wth-code = buf_tt-wth-par.par-code
     2406                                       and b_wth-parts.beg-dt >= p-dtFrom
     2407                                       and b_wth-parts.beg-dt <= p-dtTo
     2408                                       and (b_wth-parts.ext-doc-type = 'ee':U or      b_wth-parts.ext-doc-type = 'xc':U    or      b_wth-parts.ext-doc-type = 'pz':U or      b_wth-parts.ext-doc-type = 'dc':U or       b_wth-parts.ext-doc-type = 'pc':U or       b_wth-parts.ext-doc-type = 'ps':U):
     2409           create tt-wth-parts.
     2410           buffer-copy b_wth-parts to tt-wth-parts.
     2411       end.
     2412       else do:
     2413         for each b_wth-parts no-lock where b_wth-parts.fact-date >= x-date-start
     2414                                       and b_wth-parts.fact-date <= x-date-end
     2415                                       and b_wth-parts.beg-dt >= p-dtFrom
     2416                                       and b_wth-parts.beg-dt <= p-dtTo
     2417                                       and (b_wth-parts.ext-doc-type = 'ee':U or      b_wth-parts.ext-doc-type = 'xc':U    or      b_wth-parts.ext-doc-type = 'pz':U or      b_wth-parts.ext-doc-type = 'dc':U or       b_wth-parts.ext-doc-type = 'pc':U or       b_wth-parts.ext-doc-type = 'ps':U):
     2418           create tt-wth-parts.
     2419           buffer-copy b_wth-parts to tt-wth-parts.
     2420         end.
     2421         for each b_wth-parts no-lock where ((b_wth-parts.fact-date > x-date-end and lookup(b_wth-parts.out-code,'free-zone,out-zone,cli-zone,фальшивый,put-zone':u) = 0 and b_wth-parts.fact-num <> 0 ) or b_wth-parts.out-code = 'cli-zone':U )
     2422                                            and (b_wth-parts.ext-doc-type = 'ee':U or      b_wth-parts.ext-doc-type = 'xc':U    or      b_wth-parts.ext-doc-type = 'pz':U or      b_wth-parts.ext-doc-type = 'dc':U or       b_wth-parts.ext-doc-type = 'pc':U or       b_wth-parts.ext-doc-type = 'ps':U)
     2423                                            and b_wth-parts.beg-dt >= p-dtFrom
     2424                                            and b_wth-parts.beg-dt <= p-dtTo
     2425                                       :
     2426               create tt-rest.
     2427               buffer-copy b_wth-parts to tt-rest.
     2428         end.
     2429       end.
     2430   end.
     2431    release tt-wth-parts.
     2432   assign v-account = ( if integer( 10 ) = 0 then 100 else integer( 10 ) ).
     2433     if  log-manager:logfile-name ne ?
     2434     then DO:
     2435         log-manager:write-message("ON mFrameView=" + string(mFrameView), "frameRepError").
     2436     end.
     2437     if not session:batch-mode then
     2438     do:
     2439       VIEW FRAME InfoFrame.
     2440       mFrameView = true.
     2441     end.
     2442      v-button-stop = false .
     2443         if mFrameView
     2444         then do:
     2445         if v-button-stop then view STOPBTN in frame InfoFrame.
     2446                          else Hide STOPBTN in frame InfoFrame.
     2447         end.
     2448     for each buf_tt-clients
     2449     :
     2450       _wth-parts1:
     2451       for each buf_wth-parts no-lock
     2452         where buf_wth-parts.cli-type       = buf_tt-clients.obj-type
     2453           and buf_wth-parts.cli-code       = buf_tt-clients.obj-code
     2454           and lookup(buf_wth-parts.out-code,'free-zone,out-zone,cli-zone,фальшивый,put-zone':u) = 0 ,
     2455           first buf_wealth no-lock
     2456               where buf_wealth.wth-code = buf_wth-parts.wth-code ,
     2457           first buf_wth-par no-lock
     2458             where buf_wth-par.wth-code = buf_wth-parts.wth-code
     2459               and buf_wth-par.par-code = buf_wth-parts.par-code
     2460       :
     2461         assign
     2462           v-counter = v-counter + 1
     2463         .
     2464   IF ( v-counter modulo v-account = 0 )  then DO:
     2465    Assign
     2466       v-kol-spice = (50 - LENGTH(v-repfrm-str)) / 2
     2467       RecordsString = fill(' ',v-kol-spice) + string(v-repfrm-str)
     2468       .
     2469             if  log-manager:logfile-name ne ?
     2470             then DO:
     2471                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     2472             end.
     2473              if mFrameView
     2474              then do:
     2475               DISPLAY
     2476                 v-counter @ RecordsDone
     2477                 RecordsString   @ RecordsString
     2478                 WITH FRAME InfoFrame.
     2479              end.
     2480   End.
     2481      if v-button-stop then  DO:
     2482            if mFrameView
     2483            then
     2484               PROCESS EVENTS.
     2485            IF StopProcessing THEN DO:
     2486            RETURN error.
     2487            End.
     2488      end.
     2489         if      buf_wth-parts.fact-qnty   = 0
     2490            and  buf_wth-parts.price-rubl  = 0
     2491         then do:
     2492           next _wth-parts1.
     2493         end.
     2494         if buf_wth-parts.ext-doc-type = 'ee':U or
     2495            buf_wth-parts.ext-doc-type = 'xc':U    or
     2496            buf_wth-parts.ext-doc-type = 'pz':U or
     2497            buf_wth-parts.ext-doc-type = 'dc':U or
     2498            buf_wth-parts.ext-doc-type = 'pc':U or
     2499            buf_wth-parts.ext-doc-type = 'ps':U
     2500         then do:
     2501           find first buf_tt-report
     2502             where buf_tt-report.cli-type = buf_wth-parts.cli-type
     2503               and buf_tt-report.cli-code = buf_wth-parts.cli-code
     2504               and buf_tt-report.wth-code = buf_wth-parts.wth-code
     2505               and buf_tt-report.par-code = buf_wth-parts.par-code
     2506               and buf_tt-report.ser-code = buf_wth-parts.ser-code
     2507               and buf_tt-report.db-num   = buf_wth-parts.db-num
     2508           no-error .
     2509           if not available buf_tt-report
     2510           then do:
     2511             if v-is-wth-restrict = yes
     2512             then do:
     2513               find first buf_tt-wealth
     2514                 where buf_tt-wealth.wth-code = buf_wth-parts.wth-code
     2515               no-error .
     2516               if not available buf_tt-wealth
     2517               then do:
     2518                 next _wth-parts1.
     2519               end.
     2520             end.
     2521             if v-is-par-restrict = yes
     2522             then do:
     2523               find first buf_tt-wth-par
     2524                 where buf_tt-wth-par.wth-code = buf_wth-parts.wth-code
     2525                   and buf_tt-wth-par.par-code = buf_wth-parts.par-code
     2526               no-error .
     2527               if not available buf_tt-wth-par
     2528               then do:
     2529                 next _wth-parts1.
     2530               end.
     2531             end.
     2532             if v-is-ser-restrict = yes
     2533             then do:
     2534               find first buf_tt-wth-ser
     2535                 where buf_wth-ser.ser-code = buf_wth-parts.ser-code
     2536                   and buf_wth-ser.db-num   = buf_wth-parts.db-num
     2537               no-error .
     2538               if not available buf_tt-wth-ser
     2539               then do:
     2540                 next _wth-parts1.
     2541               end.
     2542             end.
     2543             find first buf_wth-ser no-lock
     2544               where buf_wth-ser.ser-code = buf_wth-parts.ser-code
     2545                 and buf_wth-ser.db-num   = buf_wth-parts.db-num
     2546             no-error .
     2547             if not available buf_wth-ser
     2548             then do:
     2549               next _wth-parts1.
     2550             end.
     2551             create buf_tt-report.
     2552             assign
     2553               buf_tt-report.cli-type      = buf_wth-parts.cli-type
     2554               buf_tt-report.cli-code      = buf_wth-parts.cli-code
     2555               buf_tt-report.wth-code      = buf_wth-parts.wth-code
     2556               buf_tt-report.par-code      = buf_wth-parts.par-code
     2557               buf_tt-report.ser-code      = buf_wth-parts.ser-code
     2558               buf_tt-report.db-num        = buf_wth-parts.db-num
     2559               buf_tt-report.cli-name      = buf_tt-clients.obj-name
     2560               buf_tt-report.talon-name    = buf_wealth.wth-name
     2561               buf_tt-report.talon-nominal = substitute("&1 &2",  buf_wth-par.par-val, buf_wth-par.par-unit )
     2562               buf_tt-report.talon-series  = buf_wth-ser.series
     2563             .
     2564           end.
     2565         end.
     2566         case buf_wth-parts.ext-doc-type
     2567         :
     2568           when 'ee':U
     2569           then do:
     2570             assign
     2571               buf_tt-report.give-sum-units = buf_tt-report.give-sum-units + buf_wth-parts.fact-qnty * buf_wth-par.par-val
     2572               buf_tt-report.give-sum-money = buf_tt-report.give-sum-money + buf_wth-parts.price-rubl * buf_wth-parts.fact-qnty
     2573             .
     2574           end.
     2575           when 'xc':U
     2576           then do:
     2577             if buf_wth-parts.type = 'рас':U
     2578             then do:
     2579               assign
     2580                 buf_tt-report.chg-give-sum-units = buf_tt-report.chg-give-sum-units + buf_wth-parts.fact-qnty * buf_wth-par.par-val
     2581                 buf_tt-report.chg-give-sum-money = buf_tt-report.chg-give-sum-money + buf_wth-parts.price-rubl * buf_wth-parts.fact-qnty
     2582               .
     2583             end.
     2584             if buf_wth-parts.type = 'при':U
     2585             then do:
     2586               assign
     2587                 buf_tt-report.chg-ret-sum-units = buf_tt-report.chg-ret-sum-units + buf_wth-parts.fact-qnty * buf_wth-par.par-val
     2588                 buf_tt-report.chg-ret-sum-money = buf_tt-report.chg-ret-sum-money + buf_wth-parts.price-rubl * buf_wth-parts.fact-qnty
     2589               .
     2590             end.
     2591           end.
     2592           when 'pz':U
     2593           then do:
     2594               assign  buf_tt-report.ret-sum-units = buf_tt-report.ret-sum-units + buf_wth-parts.fact-qnty * buf_wth-par.par-val
     2595               buf_tt-report.ret-sum-money = buf_tt-report.ret-sum-money + buf_wth-parts.price-rubl * buf_wth-parts.fact-qnty
     2596             .
     2597           end.
     2598           when 'dc':U
     2599           then do:
     2600             assign
     2601               buf_tt-report.spi-sum-units = buf_tt-report.spi-sum-units + buf_wth-parts.fact-qnty * buf_wth-par.par-val
     2602               buf_tt-report.spi-sum-money = buf_tt-report.spi-sum-money + buf_wth-parts.price-rubl * buf_wth-parts.fact-qnty
     2603             .
     2604           end.
     2605           when 'pc':U or
     2606           when 'ps':U
     2607           then do:
     2608             assign
     2609               buf_tt-report.sell-sum-units = buf_tt-report.sell-sum-units + buf_wth-parts.fact-qnty * buf_wth-par.par-val
     2610               buf_tt-report.sell-sum-money = buf_tt-report.sell-sum-money + buf_wth-parts.price-rubl * buf_wth-parts.fact-qnty
     2611             .
     2612           end.
     2613         end case.
     2614       end.
     2615       def buffer buf-rest for tt-rest.
     2616       if p-dt-calc = 1 or p-dt-calc = 3 then do:
     2617         _wth-rest:
     2618         for each  buf-rest no-lock where buf-rest.cli-type       = buf_tt-clients.obj-type
     2619                              and buf-rest.cli-code       = buf_tt-clients.obj-code
     2620           ,first buf_wealth no-lock
     2621               where buf_wealth.wth-code = buf-rest.wth-code
     2622           ,first buf_wth-par no-lock
     2623             where buf_wth-par.wth-code = buf-rest.wth-code
     2624               and buf_wth-par.par-code = buf-rest.par-code
     2625              :
     2626           find first buf_tt-report
     2627             where buf_tt-report.cli-type = buf-rest.cli-type
     2628               and buf_tt-report.cli-code = buf-rest.cli-code
     2629               and buf_tt-report.wth-code = buf-rest.wth-code
     2630               and buf_tt-report.par-code = buf-rest.par-code
     2631               and buf_tt-report.ser-code = buf-rest.ser-code
     2632               and buf_tt-report.db-num   = buf-rest.db-num
     2633           no-error .
     2634           if not available buf_tt-report
     2635           then do:
     2636             if v-is-wth-restrict = yes
     2637             then do:
     2638               find first buf_tt-wealth
     2639                 where buf_tt-wealth.wth-code = buf-rest.wth-code
     2640               no-error .
     2641               if not available buf_tt-wealth
     2642               then do:
     2643                 next _wth-rest.
     2644               end.
     2645             end.
     2646             if v-is-par-restrict = yes
     2647             then do:
     2648               find first buf_tt-wth-par
     2649                 where buf_tt-wth-par.wth-code = buf-rest.wth-code
     2650                   and buf_tt-wth-par.par-code = buf-rest.par-code
     2651               no-error .
     2652               if not available buf_tt-wth-par
     2653               then do:
     2654                 next _wth-rest.
     2655               end.
     2656             end.
     2657             if v-is-ser-restrict = yes
     2658             then do:
     2659               find first buf_tt-wth-ser
     2660                 where buf_wth-ser.ser-code = buf-rest.ser-code
     2661                   and buf_wth-ser.db-num   = buf-rest.db-num
     2662               no-error .
     2663               if not available buf_tt-wth-ser
     2664               then do:
     2665                 next _wth-rest.
     2666               end.
     2667             end.
     2668             find first buf_wth-ser no-lock
     2669               where buf_wth-ser.ser-code = buf-rest.ser-code
     2670                 and buf_wth-ser.db-num   = buf-rest.db-num
     2671             no-error .
     2672             if not available buf_wth-ser
     2673             then do:
     2674               next _wth-rest.
     2675             end.
     2676             create buf_tt-report.
     2677             assign
     2678               buf_tt-report.cli-type      = buf-rest.cli-type
     2679               buf_tt-report.cli-code      = buf-rest.cli-code
     2680               buf_tt-report.wth-code      = buf-rest.wth-code
     2681               buf_tt-report.par-code      = buf-rest.par-code
     2682               buf_tt-report.ser-code      = buf-rest.ser-code
     2683               buf_tt-report.db-num        = buf-rest.db-num
     2684               buf_tt-report.cli-name      = buf_tt-clients.obj-name
     2685               buf_tt-report.talon-name    = buf_wealth.wth-name
     2686               buf_tt-report.talon-nominal = substitute("&1 &2",  buf_wth-par.par-val, buf_wth-par.par-unit )
     2687               buf_tt-report.talon-series  = buf_wth-ser.series
     2688             .
     2689           end.
     2690                if buf-rest.out-code <> 'cli-zone':U and (buf-rest.ext-doc-type = 'ee':U or (buf-rest.ext-doc-type = 'xc':U and buf-rest.type  = 'рас':U)) then
     2691                             assign  buf_tt-report.restEnd-units = buf_tt-report.restEnd-units - buf-rest.fact-qnty * buf_wth-par.par-val
     2692                                     buf_tt-report.restEnd-money = buf_tt-report.restEnd-money - buf-rest.price-rubl * buf-rest.fact-qnty
     2693                             .
     2694                             else    assign  buf_tt-report.restEnd-units = buf_tt-report.restEnd-units + buf-rest.fact-qnty * buf_wth-par.par-val
     2695                                     buf_tt-report.restEnd-money = buf_tt-report.restEnd-money + buf-rest.price-rubl * buf-rest.fact-qnty
     2696                             .
     2697         end.
     2698         for each buf_tt-report where buf_tt-report.cli-type = buf_tt-clients.obj-type
     2699                                  and buf_tt-report.cli-code = buf_tt-clients.obj-code :
     2700               assign  buf_tt-report.restFrom-units = buf_tt-report.restEnd-units - buf_tt-report.give-sum-units - buf_tt-report.chg-give-sum-units
     2701                                                     + buf_tt-report.chg-ret-sum-units + buf_tt-report.ret-sum-units + buf_tt-report.spi-sum-units  + buf_tt-report.sell-sum-units
     2702                       buf_tt-report.restFrom-money = buf_tt-report.restEnd-money - buf_tt-report.give-sum-money - buf_tt-report.chg-give-sum-money
     2703                                                     + buf_tt-report.chg-ret-sum-money + buf_tt-report.ret-sum-money + buf_tt-report.spi-sum-money + buf_tt-report.sell-sum-money
     2704               .
     2705         end.
     2706       end.
     2707       if p-dt-calc = 2 then do:
     2708         for each buf_tt-report where buf_tt-report.cli-type = buf_tt-clients.obj-type
     2709                                  and buf_tt-report.cli-code = buf_tt-clients.obj-code :
     2710               assign  buf_tt-report.restEnd-units = buf_tt-report.give-sum-units + buf_tt-report.chg-give-sum-units
     2711                                                     - buf_tt-report.chg-ret-sum-units - buf_tt-report.ret-sum-units - buf_tt-report.spi-sum-units  - buf_tt-report.sell-sum-units
     2712                       buf_tt-report.restEnd-money = buf_tt-report.give-sum-money + buf_tt-report.chg-give-sum-money
     2713                                                     - buf_tt-report.chg-ret-sum-money - buf_tt-report.ret-sum-money - buf_tt-report.spi-sum-money - buf_tt-report.sell-sum-money
     2714               .
     2715         end.
     2716       end.
     2717       if p-dt-calc = 3 then do:
     2718       end.
     2719     end.
     2720   if mFrameView
     2721   then do:
     2722      HIDE FRAME InfoFrame.
     2723   end.
     2724     assign
     2725       v-give-sum-units     = 0
     2726       v-give-sum-money     = 0
     2727       v-chg-give-sum-units = 0
     2728       v-chg-give-sum-money = 0
     2729       v-sell-sum-units     = 0
     2730       v-sell-sum-money     = 0
     2731       v-ret-sum-units      = 0
     2732       v-ret-sum-money      = 0
     2733       v-chg-ret-sum-units  = 0
     2734       v-chg-ret-sum-money  = 0
     2735       v-spi-sum-units      = 0
     2736       v-spi-sum-money      = 0
     2737       v-restFrom-units     = 0
     2738       v-restFrom-money     = 0
     2739       v-restEnd-units      = 0
     2740       v-restEnd-money      = 0
     2741     .
     2742     run waitfram-show in this-procedure ("Расчет подитогов по клиентам...") .
     2743     for each buf_tt-report
     2744       break by buf_tt-report.cli-type
     2745             by buf_tt-report.cli-code
     2746     :
     2747       assign
     2748         v-give-sum-units      = v-give-sum-units     + buf_tt-report.give-sum-units
     2749         v-give-sum-money      = v-give-sum-money     + buf_tt-report.give-sum-money
     2750         v-chg-give-sum-units  = v-chg-give-sum-units + buf_tt-report.chg-give-sum-units
     2751         v-chg-give-sum-money  = v-chg-give-sum-money + buf_tt-report.chg-give-sum-money
     2752         v-sell-sum-units      = v-sell-sum-units     + buf_tt-report.sell-sum-units
     2753         v-sell-sum-money      = v-sell-sum-money     + buf_tt-report.sell-sum-money
     2754         v-ret-sum-units       = v-ret-sum-units      + buf_tt-report.ret-sum-units
     2755         v-ret-sum-money       = v-ret-sum-money      + buf_tt-report.ret-sum-money
     2756         v-chg-ret-sum-units   = v-chg-ret-sum-units  + buf_tt-report.chg-ret-sum-units
     2757         v-chg-ret-sum-money   = v-chg-ret-sum-money  + buf_tt-report.chg-ret-sum-money
     2758         v-spi-sum-units       = v-spi-sum-units      + buf_tt-report.spi-sum-units
     2759         v-spi-sum-money       = v-spi-sum-money      + buf_tt-report.spi-sum-money
     2760         v-restFrom-units      = v-restFrom-units     + buf_tt-report.restFrom-units
     2761         v-restFrom-money      = v-restFrom-money     + buf_tt-report.restFrom-money
     2762         v-restEnd-units       = v-restEnd-units      + buf_tt-report.restEnd-units
     2763         v-restEnd-money       = v-restEnd-money      + buf_tt-report.restEnd-money
     2764       .
     2765       if last-of(buf_tt-report.cli-type)
     2766         or last-of(buf_tt-report.cli-code)
     2767       then do:
     2768         create buf_tt-report-cli.
     2769         assign
     2770           buf_tt-report-cli.cli-type            = buf_tt-report.cli-type
     2771           buf_tt-report-cli.cli-code            = buf_tt-report.cli-code
     2772           buf_tt-report-cli.give-sum-units      = v-give-sum-units
     2773           buf_tt-report-cli.give-sum-money      = v-give-sum-money
     2774           buf_tt-report-cli.chg-give-sum-units  = v-chg-give-sum-units
     2775           buf_tt-report-cli.chg-give-sum-money  = v-chg-give-sum-money
     2776           buf_tt-report-cli.sell-sum-units      = v-sell-sum-units
     2777           buf_tt-report-cli.sell-sum-money      = v-sell-sum-money
     2778           buf_tt-report-cli.ret-sum-units       = v-ret-sum-units
     2779           buf_tt-report-cli.ret-sum-money       = v-ret-sum-money
     2780           buf_tt-report-cli.chg-ret-sum-units   = v-chg-ret-sum-units
     2781           buf_tt-report-cli.chg-ret-sum-money   = v-chg-ret-sum-money
     2782           buf_tt-report-cli.spi-sum-units       = v-spi-sum-units
     2783           buf_tt-report-cli.spi-sum-money       = v-spi-sum-money
     2784           buf_tt-report-cli.restFrom-units      = v-restFrom-units
     2785           buf_tt-report-cli.restFrom-money      = v-restFrom-money
     2786           buf_tt-report-cli.restEnd-units       = v-restEnd-units
     2787           buf_tt-report-cli.restEnd-money       = v-restEnd-money
     2788           v-give-sum-units                      = 0
     2789           v-give-sum-money                      = 0
     2790           v-chg-give-sum-units                  = 0
     2791           v-chg-give-sum-money                  = 0
     2792           v-sell-sum-units                      = 0
     2793           v-sell-sum-money                      = 0
     2794           v-ret-sum-units                       = 0
     2795           v-ret-sum-money                       = 0
     2796           v-chg-ret-sum-units                   = 0
     2797           v-chg-ret-sum-money                   = 0
     2798           v-spi-sum-units                       = 0
     2799           v-spi-sum-money                       = 0
     2800           v-restFrom-units                      = 0
     2801           v-restFrom-money                      = 0
     2802           v-restEnd-units                       = 0
     2803           v-restEnd-money                       = 0
     2804         .
     2805       end.
     2806     end.
     2807     run waitfram-hide in this-procedure .
     2808   end.
     2809   end procedure.
     2810   procedure print-header :
     2811   do
     2812   on error undo, return error return-value
     2813   :
     2814   define buffer buf_clients for ub.clients.
     2815   define buffer buf_wealth  for ub.wealth.
     2816   define buffer buf_wth-par for ub.wth-par.
     2817   define buffer buf_wth-ser for ub.wth-ser.
     2818   define variable v-date-range    as character no-undo .
     2819   define variable v-clients-list  as character no-undo .
     2820   define variable v-wth-list      as character no-undo .
     2821   if  p-dt-calc = 1 then v-date-range = 'За период '.
     2822   else  if  p-dt-calc = 2 then v-date-range = ' Даты начала срока годности '.
     2823     assign
     2824       v-date-range = v-date-range + substitute( "с &1 по &2"
     2825                                , string( x-Date-Start , "99/99/9999" )
     2826                                , string( x-Date-End  , "99/99/9999" )
     2827                                )
     2828     .
     2829   if  p-dt-calc = 3 then  v-date-range = v-date-range + substitute(" (Дата начала срока годности с &1 по &2) "
     2830                                                         ,p-dtFrom
     2831                                                         ,p-dtTo).
     2832     if p-rs-supp <> 1 then do:
     2833       for each tt-clients no-lock :
     2834         find first buf_clients no-lock
     2835           where buf_clients.obj-type = tt-clients.obj-type
     2836             and buf_clients.obj-code = tt-clients.obj-code
     2837         no-error .
     2838         if available buf_clients then do:
     2839           assign
     2840             v-clients-list = v-clients-list + buf_clients.obj-name + "\n":U
     2841           .
     2842         end.
     2843       end.
     2844     end.
     2845     else do:
     2846       assign
     2847         v-clients-list = "Все":U
     2848       .
     2849     end.
     2850     if v-is-wth-restrict then do:
     2851       assign
     2852         v-wth-list = "МЦ:":U + " ":U
     2853       .
     2854       for each tt-wealth :
     2855         assign
     2856           v-wth-list = v-wth-list + tt-wealth.wth-name + ",":U
     2857         .
     2858       end.
     2859     end.
     2860     if v-is-par-restrict then do:
     2861       assign
     2862         v-wth-list = "Номиналы:":U + " ":U
     2863       .
     2864       for each tt-wth-par :
     2865         find first buf_wth-par no-lock
     2866           where buf_wth-par.wth-code = tt-wth-par.wth-code
     2867             and buf_wth-par.par-code = tt-wth-par.par-code
     2868         no-error .
     2869         find first buf_wealth no-lock
     2870           where buf_wealth.wth-code = tt-wth-par.wth-code
     2871         no-error .
     2872         if available buf_wth-par and available buf_wealth then do:
     2873           assign
     2874             v-wth-list = v-wth-list + substitute( "&1 - &2 &3&4"
     2875                                                 , buf_wealth.wth-name
     2876                                                 , buf_wth-par.par-val
     2877                                                 , buf_wth-par.par-unit
     2878                                                 , ",":U
     2879                                                 )
     2880           .
     2881         end.
     2882       end.
     2883     end.
     2884     if v-is-ser-restrict then do:
     2885       assign
     2886         v-wth-list = "Серии:":U + " ":U
     2887       .
     2888       for each tt-wth-ser :
     2889         find first buf_wth-par no-lock
     2890           where buf_wth-par.wth-code = tt-wth-ser.wth-code
     2891             and buf_wth-par.par-code = tt-wth-ser.par-code
     2892         no-error .
     2893         find first buf_wealth no-lock
     2894           where buf_wealth.wth-code = tt-wth-par.wth-code
     2895         no-error .
     2896         if available buf_wth-par and available buf_wealth then do:
     2897           assign
     2898             v-wth-list = v-wth-list + substitute( "&1 : &2 - &3 &4&5"
     2899                                                 , tt-wth-ser.series
     2900                                                 , buf_wealth.wth-name
     2901                                                 , buf_wth-par.par-val
     2902                                                 , buf_wth-par.par-unit
     2903                                                 , ",":U
     2904                                                 )
     2905           .
     2906         end.
     2907       end.
     2908     end.
     2909     v-wth-list = substring(v-wth-list,1,length(v-wth-list) - 1) no-error.
     2910     if  v-is-wth-restrict = no and
     2911         v-is-par-restrict = no and
     2912         v-is-ser-restrict = no
     2913     then do:
     2914       assign
     2915         v-wth-list = "Все":U
     2916       .
     2917     end.
     2918     run wthobrxl-write-cell-data in this-procedure ( input "h_daterange":U
     2919                                                    , input v-date-range
     2920                                                    ) .
     2921     run wthobrxl-write-cell-data in this-procedure ( input "h_clients":U
     2922                                                    , input v-clients-list
     2923                                                    ) .
     2924     run wthobrxl-write-cell-data in this-procedure ( input "h_wth":U
     2925                                                    , input v-wth-list
     2926                                                    ) .
     2927   end.
     2928   end procedure.
     2929   procedure print-report :
     2930     define buffer buf_tt-report     for tt-report .
     2931     define buffer buf_tt-report-cli for tt-report-cli.
     2932     define variable v-give-sum-units            as decimal   no-undo .
     2933     define variable v-give-sum-money            as decimal   no-undo .
     2934     define variable v-chg-give-sum-units        as decimal   no-undo .
     2935     define variable v-chg-give-sum-money        as decimal   no-undo .
     2936     define variable v-sell-sum-units            as decimal   no-undo .
     2937     define variable v-sell-sum-money            as decimal   no-undo .
     2938     define variable v-ret-sum-units             as decimal   no-undo .
     2939     define variable v-ret-sum-money             as decimal   no-undo .
     2940     define variable v-chg-ret-sum-units         as decimal   no-undo .
     2941     define variable v-chg-ret-sum-money         as decimal   no-undo .
     2942     define variable v-spi-sum-units             as decimal   no-undo .
     2943     define variable v-spi-sum-money             as decimal   no-undo .
     2944     define variable v-RestFrom-units            as decimal   no-undo .
     2945     define variable v-restFrom-money            as decimal   no-undo .
     2946     define variable v-restEnd-units             as decimal   no-undo .
     2947     define variable v-restEnd-money             as decimal   no-undo .
     2948     define variable v-total-give-sum-units      as decimal   no-undo .
     2949     define variable v-total-give-sum-money      as decimal   no-undo .
     2950     define variable v-total-chg-give-sum-units  as decimal   no-undo .
     2951     define variable v-total-chg-give-sum-money  as decimal   no-undo .
     2952     define variable v-total-sell-sum-units      as decimal   no-undo .
     2953     define variable v-total-sell-sum-money      as decimal   no-undo .
     2954     define variable v-total-ret-sum-units       as decimal   no-undo .
     2955     define variable v-total-ret-sum-money       as decimal   no-undo .
     2956     define variable v-total-chg-ret-sum-units   as decimal   no-undo .
     2957     define variable v-total-chg-ret-sum-money   as decimal   no-undo .
     2958     define variable v-total-spi-sum-units       as decimal   no-undo .
     2959     define variable v-total-spi-sum-money       as decimal   no-undo .
     2960     define variable v-total-RestFrom-units      as decimal   no-undo .
     2961     define variable v-total-restFrom-money      as decimal   no-undo .
     2962     define variable v-total-restEnd-units       as decimal   no-undo .
     2963     define variable v-total-restEnd-money       as decimal   no-undo .
     2964   do
     2965   on error undo, return error return-value
     2966   :
     2967     _rep-line:
     2968     for each buf_tt-report
     2969     break by buf_tt-report.cli-type
     2970           by buf_tt-report.cli-code
     2971           by buf_tt-report.wth-code
     2972           by buf_tt-report.par-code
     2973           by buf_tt-report.ser-code
     2974           by buf_tt-report.db-num
     2975     :
     2976       if first-of(buf_tt-report.cli-type) or first-of(buf_tt-report.cli-code)
     2977       then do:
     2978         find first buf_tt-report-cli
     2979           where buf_tt-report-cli.cli-type  = buf_tt-report.cli-type
     2980             and buf_tt-report-cli.cli-code  = buf_tt-report.cli-code
     2981         no-error .
     2982         if not available buf_tt-report-cli
     2983         then do:
     2984           message
     2985             substitute( "Не найдены итоги по клиенту &1 &2 - &3"
     2986                       , buf_tt-report.cli-code
     2987                       , buf_tt-report.cli-type
     2988                       , buf_tt-report.cli-name
     2989                       )
     2990           view-as alert-box error.
     2991           next _rep-line.
     2992         end.
     2993         run wthobrxl-write-line-data in this-procedure ( input buf_tt-report.cli-name
     2994                                                        , input " ":u
     2995                                                        , input " ":u
     2996                                                        , input " ":u
     2997                                                        , input string( buf_tt-report-cli.give-sum-units     )
     2998                                                        , input string( buf_tt-report-cli.give-sum-money     )
     2999                                                        , input string( buf_tt-report-cli.chg-give-sum-units )
     3000                                                        , input string( buf_tt-report-cli.chg-give-sum-money )
     3001                                                        , input string( buf_tt-report-cli.sell-sum-units     )
     3002                                                        , input string( buf_tt-report-cli.sell-sum-money     )
     3003                                                        , input string( buf_tt-report-cli.ret-sum-units      )
     3004                                                        , input string( buf_tt-report-cli.ret-sum-money      )
     3005                                                        , input string( buf_tt-report-cli.chg-ret-sum-units  )
     3006                                                        , input string( buf_tt-report-cli.chg-ret-sum-money  )
     3007                                                        , input string( buf_tt-report-cli.spi-sum-units      )
     3008                                                        , input string( buf_tt-report-cli.spi-sum-money      )
     3009                                                        , input string( buf_tt-report-cli.RestFrom-units )
     3010                                                        , input string( buf_tt-report-cli.restFrom-money )
     3011                                                        , input string( buf_tt-report-cli.restEnd-units  )
     3012                                                        , input string( buf_tt-report-cli.restEnd-money  )
     3013                                                        ) .
     3014         if p-cb-wth-detail <> 1
     3015         then do:
     3016           run wthobrxl-sheet1-write-line-format in this-procedure ( "St" ).
     3017         end.
     3018       end.
     3019       assign
     3020         v-total-give-sum-units      = v-total-give-sum-units     + buf_tt-report.give-sum-units
     3021         v-total-give-sum-money      = v-total-give-sum-money     + buf_tt-report.give-sum-money
     3022         v-total-chg-give-sum-units  = v-total-chg-give-sum-units + buf_tt-report.chg-give-sum-units
     3023         v-total-chg-give-sum-money  = v-total-chg-give-sum-money + buf_tt-report.chg-give-sum-money
     3024         v-total-sell-sum-units      = v-total-sell-sum-units     + buf_tt-report.sell-sum-units
     3025         v-total-sell-sum-money      = v-total-sell-sum-money     + buf_tt-report.sell-sum-money
     3026         v-total-ret-sum-units       = v-total-ret-sum-units      + buf_tt-report.ret-sum-units
     3027         v-total-ret-sum-money       = v-total-ret-sum-money      + buf_tt-report.ret-sum-money
     3028         v-total-chg-ret-sum-units   = v-total-chg-ret-sum-units  + buf_tt-report.chg-ret-sum-units
     3029         v-total-chg-ret-sum-money   = v-total-chg-ret-sum-money  + buf_tt-report.chg-ret-sum-money
     3030         v-total-spi-sum-units       = v-total-spi-sum-units      + buf_tt-report.spi-sum-units
     3031         v-total-spi-sum-money       = v-total-spi-sum-money      + buf_tt-report.spi-sum-money
     3032         v-total-RestFrom-units  = v-total-RestFrom-units  + buf_tt-report.RestFrom-units
     3033         v-total-restFrom-money  = v-total-restFrom-money  + buf_tt-report.restFrom-money
     3034         v-total-restEnd-units   = v-total-restEnd-units   + buf_tt-report.restEnd-units
     3035         v-total-restEnd-money   = v-total-restEnd-money   + buf_tt-report.restEnd-money
     3036       .
     3037       if p-cb-wth-detail <> 1
     3038       then do:
     3039         assign
     3040           v-give-sum-units      = v-give-sum-units     + buf_tt-report.give-sum-units
     3041           v-give-sum-money      = v-give-sum-money     + buf_tt-report.give-sum-money
     3042           v-chg-give-sum-units  = v-chg-give-sum-units + buf_tt-report.chg-give-sum-units
     3043           v-chg-give-sum-money  = v-chg-give-sum-money + buf_tt-report.chg-give-sum-money
     3044           v-sell-sum-units      = v-sell-sum-units     + buf_tt-report.sell-sum-units
     3045           v-sell-sum-money      = v-sell-sum-money     + buf_tt-report.sell-sum-money
     3046           v-ret-sum-units       = v-ret-sum-units      + buf_tt-report.ret-sum-units
     3047           v-ret-sum-money       = v-ret-sum-money      + buf_tt-report.ret-sum-money
     3048           v-chg-ret-sum-units   = v-chg-ret-sum-units  + buf_tt-report.chg-ret-sum-units
     3049           v-chg-ret-sum-money   = v-chg-ret-sum-money  + buf_tt-report.chg-ret-sum-money
     3050           v-spi-sum-units       = v-spi-sum-units      + buf_tt-report.spi-sum-units
     3051           v-spi-sum-money       = v-spi-sum-money      + buf_tt-report.spi-sum-money
     3052           v-RestFrom-units   = v-RestFrom-units  + buf_tt-report.RestFrom-units
     3053           v-restFrom-money   = v-restFrom-money  + buf_tt-report.restFrom-money
     3054           v-restEnd-units    = v-restEnd-units   + buf_tt-report.restEnd-units
     3055           v-restEnd-money    = v-restEnd-money   + buf_tt-report.restEnd-money
     3056         .
     3057       end.
     3058       if    p-cb-wth-detail = 2
     3059         and last-of(buf_tt-report.wth-code)
     3060       then do:
     3061         run wthobrxl-write-line-data in this-procedure ( input ' ':U
     3062                                                        , input buf_tt-report.talon-name
     3063                                                        , input ' ':U
     3064                                                        , input ' ':U
     3065                                                        , input string( v-give-sum-units     )
     3066                                                        , input string( v-give-sum-money     )
     3067                                                        , input string( v-chg-give-sum-units )
     3068                                                        , input string( v-chg-give-sum-money )
     3069                                                        , input string( v-sell-sum-units     )
     3070                                                        , input string( v-sell-sum-money     )
     3071                                                        , input string( v-ret-sum-units      )
     3072                                                        , input string( v-ret-sum-money      )
     3073                                                        , input string( v-chg-ret-sum-units  )
     3074                                                        , input string( v-chg-ret-sum-money  )
     3075                                                        , input string( v-spi-sum-units      )
     3076                                                        , input string( v-spi-sum-money      )
     3077                                                        , input string( v-RestFrom-units  )
     3078                                                        , input string( v-restFrom-money  )
     3079                                                        , input string( v-restEnd-units   )
     3080                                                        , input string( v-restEnd-money   )
     3081                                                         ) .
     3082         assign
     3083           v-give-sum-units      = 0
     3084           v-give-sum-money      = 0
     3085           v-chg-give-sum-units  = 0
     3086           v-chg-give-sum-money  = 0
     3087           v-sell-sum-units      = 0
     3088           v-sell-sum-money      = 0
     3089           v-ret-sum-units       = 0
     3090           v-ret-sum-money       = 0
     3091           v-chg-ret-sum-units   = 0
     3092           v-chg-ret-sum-money   = 0
     3093           v-spi-sum-units       = 0
     3094           v-spi-sum-money       = 0
     3095           v-RestFrom-units      = 0
     3096           v-restFrom-money      = 0
     3097           v-restEnd-units       = 0
     3098           v-restEnd-money       = 0
     3099         .
     3100       end.
     3101       if    p-cb-wth-detail = 3
     3102         and ( last-of(buf_tt-report.wth-code) or last-of(buf_tt-report.par-code) )
     3103       then do:
     3104         run wthobrxl-write-line-data in this-procedure ( input ' ':U
     3105                                                        , input buf_tt-report.talon-name
     3106                                                        , input buf_tt-report.talon-nominal
     3107                                                        , input ' ':U
     3108                                                        , input string( v-give-sum-units     )
     3109                                                        , input string( v-give-sum-money     )
     3110                                                        , input string( v-chg-give-sum-units )
     3111                                                        , input string( v-chg-give-sum-money )
     3112                                                        , input string( v-sell-sum-units     )
     3113                                                        , input string( v-sell-sum-money     )
     3114                                                        , input string( v-ret-sum-units      )
     3115                                                        , input string( v-ret-sum-money      )
     3116                                                        , input string( v-chg-ret-sum-units  )
     3117                                                        , input string( v-chg-ret-sum-money  )
     3118                                                        , input string( v-spi-sum-units      )
     3119                                                        , input string( v-spi-sum-money      )
     3120                                                        , input string( v-RestFrom-units  )
     3121                                                        , input string( v-restFrom-money  )
     3122                                                        , input string( v-restEnd-units   )
     3123                                                        , input string( v-restEnd-money   )
     3124                                                        ) .
     3125         assign
     3126           v-give-sum-units      = 0
     3127           v-give-sum-money      = 0
     3128           v-chg-give-sum-units  = 0
     3129           v-chg-give-sum-money  = 0
     3130           v-sell-sum-units      = 0
     3131           v-sell-sum-money      = 0
     3132           v-ret-sum-units       = 0
     3133           v-ret-sum-money       = 0
     3134           v-chg-ret-sum-units   = 0
     3135           v-chg-ret-sum-money   = 0
     3136           v-spi-sum-units       = 0
     3137           v-spi-sum-money       = 0
     3138           v-RestFrom-units      = 0
     3139           v-restFrom-money      = 0
     3140           v-restEnd-units       = 0
     3141           v-restEnd-money       = 0
     3142         .
     3143       end.
     3144       if    p-cb-wth-detail = 4
     3145         and ( last-of(buf_tt-report.ser-code) or last-of(buf_tt-report.db-num) )
     3146       then do:
     3147         run wthobrxl-write-line-data in this-procedure ( input ' ':U
     3148                                                        , input buf_tt-report.talon-name
     3149                                                        , input buf_tt-report.talon-nominal
     3150                                                        , input buf_tt-report.talon-series
     3151                                                        , input string( v-give-sum-units     )
     3152                                                        , input string( v-give-sum-money     )
     3153                                                        , input string( v-chg-give-sum-units )
     3154                                                        , input string( v-chg-give-sum-money )
     3155                                                        , input string( v-sell-sum-units     )
     3156                                                        , input string( v-sell-sum-money     )
     3157                                                        , input string( v-ret-sum-units      )
     3158                                                        , input string( v-ret-sum-money      )
     3159                                                        , input string( v-chg-ret-sum-units  )
     3160                                                        , input string( v-chg-ret-sum-money  )
     3161                                                        , input string( v-spi-sum-units      )
     3162                                                        , input string( v-spi-sum-money      )
     3163                                                        , input string( v-RestFrom-units  )
     3164                                                        , input string( v-restFrom-money  )
     3165                                                        , input string( v-restEnd-units   )
     3166                                                        , input string( v-restEnd-money   )
     3167                                                        ) .
     3168         assign
     3169           v-give-sum-units      = 0
     3170           v-give-sum-money      = 0
     3171           v-chg-give-sum-units  = 0
     3172           v-chg-give-sum-money  = 0
     3173           v-sell-sum-units      = 0
     3174           v-sell-sum-money      = 0
     3175           v-ret-sum-units       = 0
     3176           v-ret-sum-money       = 0
     3177           v-chg-ret-sum-units   = 0
     3178           v-chg-ret-sum-money   = 0
     3179           v-spi-sum-units       = 0
     3180           v-spi-sum-money       = 0
     3181           v-RestFrom-units      = 0
     3182           v-restFrom-money      = 0
     3183           v-restEnd-units       = 0
     3184           v-restEnd-money       = 0
     3185         .
     3186       end.
     3187     end.
     3188     run wthobrxl-write-line-data in this-procedure (  input "ИТОГО:":U
     3189                                                     , input ' ':U
     3190                                                     , input ' ':U
     3191                                                     , input ' ':U
     3192                                                     , input string( v-total-give-sum-units     )
     3193                                                     , input string( v-total-give-sum-money     )
     3194                                                     , input string( v-total-chg-give-sum-units )
     3195                                                     , input string( v-total-chg-give-sum-money )
     3196                                                     , input string( v-total-sell-sum-units     )
     3197                                                     , input string( v-total-sell-sum-money     )
