     1032   PROCEDURE check-modified :
     1033   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
     1034   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
     1035   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
     1036   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
     1037     IF check-state = "check":U THEN
     1038     DO:
     1039       RUN get-link-handle IN adm-broker-hdl
     1040         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
     1041            OUTPUT group-target-list).
     1042       IF group-target-list NE "":U THEN
     1043       DO i = 1 TO NUM-ENTRIES(group-target-list):
     1044         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
     1045         RUN check-modified IN curr-widget ('group-check':U).
     1046         IF RETURN-VALUE NE "":U THEN
     1047         DO:
     1048           RUN check-modified-message(RETURN-VALUE).
     1049           RETURN "":U.
     1050         END.
     1051       END.
     1052     END.
     1053     RETURN "":U.
     1054   END PROCEDURE.
     1055   PROCEDURE check-modified-message :
     1056     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
     1057        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
     1058           'CONTAINER-SOURCE':U, 'HIDDEN':U).
     1059        IF RETURN-VALUE = "YES":U THEN
     1060           RUN notify ('view,CONTAINER-SOURCE':U).
     1061        MESSAGE IF p-changed-table NE ? THEN
     1062           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
     1063           ELSE "Current values have been changed."
     1064           SKIP "  Do you wish to save those changes?"
     1065           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
     1066        IF ANS THEN
     1067        DO:
     1068           IF group-assign-target THEN
     1069             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
     1070           ELSE RUN dispatch('update-record':U).
     1071           IF RETURN-VALUE = "ADM-ERROR":U THEN
     1072           DO:
     1073               MESSAGE "Changes to the previous record were not saved."
     1074                 VIEW-AS ALERT-BOX ERROR.
     1075               IF group-assign-target THEN
     1076                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1077               ELSE RUN dispatch ('cancel-record':U).
     1078           END.
     1079        END.
     1080        ELSE DO:
     1081          IF group-assign-target THEN
     1082             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1083          ELSE RUN dispatch('cancel-record':U).
     1084        END.
     1085        RETURN.
     1086   END PROCEDURE.
     1087   PROCEDURE get-rowid :
     1088       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
     1089       ASSIGN
     1090       p-table   =   adm-first-table.
     1091       RETURN.
     1092   END PROCEDURE.
     1093   PROCEDURE init-group-assign :
     1094       RUN request-attribute IN adm-broker-hdl
     1095         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
     1096       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
     1097         group-assign-target = yes.
     1098       ELSE group-assign-target = no.
     1099       RETURN.
     1100   END PROCEDURE.
     1101   PROCEDURE set-editors :
     1102       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
     1103       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
     1104       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
     1105       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
     1106       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
     1107       DO WHILE VALID-HANDLE (curr-widget):
     1108           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
     1109              curr-widget:HIDDEN = no THEN DO:
     1110             CASE p-field-setting:
     1111               WHEN "INITIALIZE":U THEN
     1112               DO:
     1113                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
     1114                     read-only-list +
     1115                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
     1116                        STRING(curr-widget).
     1117               END.
     1118               WHEN "DISABLE":U OR
     1119               WHEN "ENABLE":U THEN
     1120               DO:
     1121                   curr-widget:SENSITIVE = yes.
     1122                   RUN get-attribute ('Read-Only-Editors':U).
     1123                   IF RETURN-VALUE = ? OR
     1124                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
     1125                       curr-widget:READ-ONLY =
     1126                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
     1127               END.
     1128               WHEN "CLEAR":U THEN
     1129                   curr-widget:SCREEN-VALUE = "":U.
     1130             END CASE.
     1131           END.
     1132           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
     1133       END.
     1134       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
     1135         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
     1136           + '"':U).
     1137       RETURN.
     1138   END PROCEDURE.
     1139   PROCEDURE use-check-modified-all :
     1140    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1141     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
     1142     RETURN.
     1143   END PROCEDURE.
     1144   PROCEDURE use-create-on-add :
