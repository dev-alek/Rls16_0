     1729                                    param-to-export.param-sub-code = "" no-error .
     1730   if available param-to-export then do:   delete param-to-export . end.
     1731   END PROCEDURE.
     1732   PROCEDURE state-changed :
     1733     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE    NO-UNDO.
     1734     DEFINE INPUT PARAMETER p-state      AS CHARACTER NO-UNDO.
     1735     CASE p-state:
     1736     END CASE.
     1737   END PROCEDURE.
     1738   PROCEDURE proc-r :
     1739    case Classify :
     1740     when "no-classify" then do:
     1741        if tog-obj = true then
     1742           run rep/r-obr-1y.p
     1743              ( input t-txt      , input v-cntxt-obj-code ,                     input v-cntxt-obj-type , input buf_currency.curr-abbr  , input v-base-code  , input Classify , input SortType ,                    input SumsOnly   , input ShowZero   , input ShowZero-2 , input tog-obj  , input tog-lavel,                    input var-lavel  , input vat-cost   , input vat-crsa   , input vat-sale   ) .
     1744         else
     1745           run rep/r-obr-1n.p
     1746               ( input t-txt      , input v-cntxt-obj-code ,                     input v-cntxt-obj-type , input buf_currency.curr-abbr  , input v-base-code  , input Classify , input SortType ,                    input SumsOnly   , input ShowZero   , input ShowZero-2 , input tog-obj  , input tog-lavel,                    input var-lavel  , input vat-cost   , input vat-crsa   , input vat-sale   ) .
     1747     end.
     1748     when "prod" then do:
     1749        if tog-obj = true then
     1750           run rep/r-obr-3y.p
     1751               ( input t-txt      , input v-cntxt-obj-code ,                     input v-cntxt-obj-type , input buf_currency.curr-abbr  , input v-base-code  , input Classify , input SortType ,                    input SumsOnly   , input ShowZero   , input ShowZero-2 , input tog-obj  , input tog-lavel,                    input var-lavel  , input vat-cost   , input vat-crsa   , input vat-sale   ) .
     1752         else
     1753           run rep/r-obr-3n.p
     1754               ( input t-txt      , input v-cntxt-obj-code ,                     input v-cntxt-obj-type , input buf_currency.curr-abbr  , input v-base-code  , input Classify , input SortType ,                    input SumsOnly   , input ShowZero   , input ShowZero-2 , input tog-obj  , input tog-lavel,                    input var-lavel  , input vat-cost   , input vat-crsa   , input vat-sale   ) .
     1755     end.
     1756     when "grp-goods" then do:
     1757        if tog-obj = true then
     1758           run rep/r-obr-2y.p
     1759              ( input t-txt      , input v-cntxt-obj-code ,                     input v-cntxt-obj-type , input buf_currency.curr-abbr  , input v-base-code  , input Classify , input SortType ,                    input SumsOnly   , input ShowZero   , input ShowZero-2 , input tog-obj  , input tog-lavel,                    input var-lavel  , input vat-cost   , input vat-crsa   , input vat-sale   ) .
     1760         else
     1761           run rep/r-obr-2n.p
     1762               ( input t-txt      , input v-cntxt-obj-code ,                     input v-cntxt-obj-type , input buf_currency.curr-abbr  , input v-base-code  , input Classify , input SortType ,                    input SumsOnly   , input ShowZero   , input ShowZero-2 , input tog-obj  , input tog-lavel,                    input var-lavel  , input vat-cost   , input vat-crsa   , input vat-sale   ) .
     1763     end.
     1764     when "prod/grp-goods" then do:
     1765        if tog-obj = true then
     1766           run rep/r-obr-4y.p
     1767               ( input t-txt      , input v-cntxt-obj-code ,                     input v-cntxt-obj-type , input buf_currency.curr-abbr  , input v-base-code  , input Classify , input SortType ,                    input SumsOnly   , input ShowZero   , input ShowZero-2 , input tog-obj  , input tog-lavel,                    input var-lavel  , input vat-cost   , input vat-crsa   , input vat-sale   ) .
     1768         else
     1769           run rep/r-obr-4n.p
     1770               ( input t-txt      , input v-cntxt-obj-code ,                     input v-cntxt-obj-type , input buf_currency.curr-abbr  , input v-base-code  , input Classify , input SortType ,                    input SumsOnly   , input ShowZero   , input ShowZero-2 , input tog-obj  , input tog-lavel,                    input var-lavel  , input vat-cost   , input vat-crsa   , input vat-sale   ) .
     1771     end.
     1772     when "grp-goods/prod" then do:
     1773        if tog-obj = true then
     1774           run rep/r-obr-5y.p
     1775               ( input t-txt      , input v-cntxt-obj-code ,                     input v-cntxt-obj-type , input buf_currency.curr-abbr  , input v-base-code  , input Classify , input SortType ,                    input SumsOnly   , input ShowZero   , input ShowZero-2 , input tog-obj  , input tog-lavel,                    input var-lavel  , input vat-cost   , input vat-crsa   , input vat-sale   ) .
     1776         else
     1777           run rep/r-obr-5n.p
     1778               ( input t-txt      , input v-cntxt-obj-code ,                     input v-cntxt-obj-type , input buf_currency.curr-abbr  , input v-base-code  , input Classify , input SortType ,                    input SumsOnly   , input ShowZero   , input ShowZero-2 , input tog-obj  , input tog-lavel,                    input var-lavel  , input vat-cost   , input vat-crsa   , input vat-sale   ) .
     1779     end.
     1780     when "vat-ps" then do:
     1781        if tog-obj = true then
     1782           run rep/r-obr-6y.p
     1783               ( input t-txt      , input v-cntxt-obj-code ,                     input v-cntxt-obj-type , input buf_currency.curr-abbr  , input v-base-code  , input Classify , input SortType ,                    input SumsOnly   , input ShowZero   , input ShowZero-2 , input tog-obj  , input tog-lavel,                    input var-lavel  , input vat-cost   , input vat-crsa   , input vat-sale   ) .
     1784         else
     1785           run rep/r-obr-6n.p
     1786              ( input t-txt      , input v-cntxt-obj-code ,                     input v-cntxt-obj-type , input buf_currency.curr-abbr  , input v-base-code  , input Classify , input SortType ,                    input SumsOnly   , input ShowZero   , input ShowZero-2 , input tog-obj  , input tog-lavel,                    input var-lavel  , input vat-cost   , input vat-crsa   , input vat-sale   ) .
     1787     end.
     1788   end case.
     1789   END PROCEDURE.
     1790   PROCEDURE proc-c :
     1791    case Classify :
     1792     when "no-classify" then do:
