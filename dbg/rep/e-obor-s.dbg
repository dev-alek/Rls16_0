     1148   PROCEDURE use-initial-lock :
     1149     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1150     ASSIGN adm-initial-lock = p-attr-value.
     1151     RETURN.
     1152   END PROCEDURE.
     1153     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
     1154   ASSIGN
     1155          FRAME F-Main:SCROLLABLE       = FALSE
     1156          FRAME F-Main:HIDDEN           = TRUE.
     1157   ON VALUE-CHANGED OF Classify IN FRAME F-Main
     1158   DO:
     1159       Assign Classify.
     1160       if Classify  Begins "prod":U OR
     1161          Classify  Begins "grp-goods":U OR
     1162          Classify  Begins "vat-ps":U
     1163           then
     1164           enable SumsOnly with frame F-Main .
     1165      if Classify = "no-classify":U
     1166         Then do:
     1167               SumsOnly = FALSE .
     1168               display SumsOnly with frame F-Main .
     1169               disable SumsOnly with frame F-Main .
     1170           end.
     1171      if Classify = "grp-goods":U
     1172            Then do:
     1173               display TOG-lavel   with frame F-Main .
     1174               enable  TOG-lavel   with frame F-Main .
     1175           end.
     1176            Else do:
     1177               display  TOG-lavel  var-Lavel with frame F-Main .
     1178               disable  TOG-lavel  var-Lavel with frame F-Main .
     1179           end.
     1180   END.
     1181   ON VALUE-CHANGED OF ShowZero IN FRAME F-Main
     1182   DO:
     1183      assign ShowZero.
     1184     if ShowZero = no then do:
     1185        ShowZero-3 = no .
     1186        display ShowZero-3 with frame F-Main .
     1187        disable ShowZero-3 with frame F-Main .
     1188     end.
     1189     else enable ShowZero-3 with frame F-Main .
     1190   END.
     1191   ON VALUE-CHANGED OF ShowZero-2 IN FRAME F-Main
     1192   DO:
     1193       assign ShowZero-2.
     1194     if ShowZero-2 = no then do:
     1195        ShowZero = no .
     1196        ShowZero-3 = no .
     1197        display ShowZero ShowZero-3 with frame F-Main .
     1198        disable ShowZero ShowZero-3 with frame F-Main .
     1199     end.
     1200     else enable ShowZero with frame F-Main .
     1201   END.
     1202   ON VALUE-CHANGED OF Tog-lavel IN FRAME F-Main
     1203   DO:
     1204       Assign tog-lavel.
     1205     if tog-lavel =TRUE
     1206           Then do:
     1207               display  var-Lavel  with frame F-Main .
     1208               enable   var-Lavel  with frame F-Main .
     1209           end.
     1210            Else do:
     1211               display    var-Lavel with frame F-Main .
     1212               disable    var-Lavel with frame F-Main .
     1213           end.
     1214   END.
