     1314   PROCEDURE my-report :
     1315   case SortType :
     1316     when "sort-artic" then do:
     1317       run proc-r in this-procedure .
     1318     end.
     1319     when "sort-code" then do:
     1320       run proc-c in this-procedure .
     1321     end.
     1322     when "sort-name" then do:
     1323       run proc-n in this-procedure .
     1324     end.
     1325   end case.
     1326   END PROCEDURE.
     1327   PROCEDURE my-var :
     1328   assign frame F-Main SumsOnly ShowZero tog-obj ShowZero-2
     1329   tog-lavel var-lavel Classify T-txt
     1330    SortType
     1331      VAT-Cost VAT-CRSA VAT-sale
     1332      ShowZero-3 .
     1333   v-show-all-goods  = ShowZero-3 .
     1334   if x-SelectObject = "currency":U and tog-obj = false then tog-obj = true .
     1335   Assign
     1336    STR-obj-type = ''
     1337    STR-obj-code = ''
     1338    STR-obj-name = ''
     1339    STR-obj      = ''.
     1340   For each obj-list no-lock:
     1341    Assign
     1342    STR-obj-type = STR-obj-type + obj-list.obj-type + ','
     1343    STR-obj-code = STR-obj-code + String(obj-list.obj-code) + ','
     1344    STR-obj-name = STR-obj-name + obj-list.obj-name + ','
     1345    STR-obj = STR-obj +  obj-list.obj-type + '#' + string(obj-list.obj-code)  + ',' .
     1346   End.
     1347   ReportNAme = "О Т Ч Е Т   О   С О С Т О Я Н И И   З А П А С А   И   П Р О Д А Ж А Х   ( сводная оборотная ведомость )".
     1348   def var t-class as char no-undo.
     1349   def var t-sort as char no-undo.
     1350     case classify:
     1351       when "no-classify":u    then t-class =   "Без классификации" .
     1352       when "prod":u           then t-class =   "Производители"   .
     1353       when "post":u           then t-class =   "Поставщики"   .
     1354       when "grp-goods":u      then t-class =   "Группы товаров"  .
     1355       when "post/grp-goods":u then t-class =   "Поставщики/Группы товаров" .
     1356       when "prod/grp-goods":u then t-class =   "Производители/Группы товаров" .
     1357       when "grp-goods/prod":u then t-class =   "Группы товаров/Производители" .
     1358       when "grp-goods/post":u then t-class =   "Группы товаров/Поставщики" .
     1359       when  "vat-ps":u        then t-class =   "Ставка НДС" .
     1360       when  "sort":u          then t-class =   "Проба(Сорт)" .
     1361       when  "n-level":u       then t-class =   "Группы с уровнем вложенности " .
     1362       when  "t-level":u       then t-class =   "Терминальные группы" .
     1363    end case.
     1364     case sorttype:
     1365       when "sort-pp":u               then t-sort =   "по порядку" .
     1366       when "sort-code":u             then t-sort =   "по коду" .
     1367       when "sort-artic":u            then t-sort =   "по артикулу"  .
     1368       when "sort-qunty":u            then t-sort =   "по реализации".
     1369       when "sort-name":u             then t-sort =   "по наименованию".
     1370       when "sort-type":u             then t-sort =   "по типу ткани".
     1371       when "sort-doc-code":u         then t-sort =   "по номеру документа".
     1372       when "sort-recipe-code":u      then t-sort =   "по номеру рецепта".
     1373    end case.
     1374   ReportHeader = "Классификация : " + t-Class.
     1375   ReportHeader = ReportHeader +
     1376                  (if tog-lavel  then "    Итоги с уровня  "  + String(var-lavel)  else " "    ).
     1377   ReportHeader = ReportHeader  + chr(10).
     1378   ReportHeader = ReportHeader +
     1379                  "Сортировка " + t-Sort + chr(10) +
     1380                  "Показать : " +
     1381                  (if SumsOnly     then "Только итоги, "  else " "            ) +
     1382                  (if Show-Cost     then "Суммы в учетных ценах, "  else " "   ) +
     1383                  (if Show-Crsa     then "Суммы в продажных ценах, "  else " " ) +
     1384                  (if Show-Sale     then "Суммы в продажных ценах документа , "  else " " ) +
     1385                  (if vat-Cost     then "НДС в учетных ценах, "  else " "   ) +
     1386                  (if vat-Crsa     then "НДС в продажных ценах, "  else " " ) +
     1387                  (if vat-Sale     then "НДС в продажных ценах документа , "  else " " ) +
     1388                  (if ShowZero-3     then " Показывать все выбранные товары "  else " " ) +
     1389                  (if ShowZero-2    then "Показывать нулевые обороты "  else "Не показывать нулевые обороты" )  +
     1390                  (if ShowZero     then "Показывать нулевые остатки "  else "Не показывать нулевые остатки" ) .
     1391   Sheetf.Excel-Column-Lable = "Код,Артикул,Название товара ,Ед.изм,т/у,Скидка,Остаток на  начало,,,,,,,Приход,,,,,,,Расход,,,,,,,Касса,,,,,,,Инвентаризация,,,,,,,Переоценка,,,,,,,Остаток на конец,,,,,,,, "  + chr(10).
     1392   Sheetf.Excel-Column-Lable = Excel-Column-Lable + ",,,,,, " +
     1393         Fill ( "кол-во ,учет.сумма ,прод.сумма ,в ценах док-та ,учет.НДС,прод.НДС,НДС в ценах док-та ," , 7) .
     1394   Sheetf.Sizes = "10,16,60,7,3,13," + Fill("13,", 49) .
     1395   Sheetf.make-correct = fill("false,", 55) .
     1396   Sheetf.ColFOrmat = "2=@;3=@"  .
     1397   END PROCEDURE.
