     1563      input ''  ,
     1564      input 'character'  ,
     1565      input reportname  ,
     1566      input 'название отчета' )
     1567    .
     1568     run create-param-to-export  in this-procedure
     1569     ( input 'select-good'  ,
     1570      input ''  ,
     1571      input 'integer'  ,
     1572      input string(x-selectgood)  ,
     1573      input 'тип выбора товара all=1 grp=2 prod=3 choice=4 one=5 grp-prod=6' )
     1574    .
     1575    define variable ii as integer no-undo .
     1576    define variable ii-name as character no-undo .
     1577    define variable ii-1 as integer no-undo .
     1578    define variable ii-name-1 as character no-undo .
     1579     define variable ii-2 as integer no-undo .
     1580    define variable ii-name-2 as character no-undo .
     1581    define variable ii-3 as integer no-undo .
     1582    define variable ii-name-3 as character no-undo .
     1583    if x-selectgood = 1     Or
     1584       x-selectgood = 2     Or
     1585       x-selectgood = 3    Or
     1586       x-selectgood = 4  then do:
     1587    ii = 0.
     1588         for each gds-list :
     1589           ii = ii + 1 .
     1590           if ii = 1 then ii-name = "список товаров - содержит gds-code  (уникальный ключ товара)" .
     1591                     else ii-name = "" .
     1592     run create-param-to-export  in this-procedure
     1593     ( input 'gds-list'  ,
     1594      input string(ii)  ,
     1595      input 'integer'  ,
     1596      input string(gds-list.gds-code)  ,
     1597      input ii-name )
     1598    .
     1599         end.
     1600    end.
     1601    if x-selectgood = 2 then do:
     1602    ii-2 = 0.
     1603         for each tmp#grp :
     1604           ii-2 = ii-2 + 1 .
     1605           if ii-2 = 1 then ii-name-2 = "список товаров - содержит  <node-code#grp-name>  (уникальный ключ списка групп)" .
     1606                     else ii-name-2 = "" .
     1607     run create-param-to-export  in this-procedure
     1608     ( input 'tmp#grp'  ,
     1609      input string(ii-2)  ,
     1610      input 'integer character '  ,
     1611      input string(tmp#grp.node-code) + '#' +  (tmp#grp.grp-name)  ,
     1612      input ii-name-2 )
     1613    .
     1614         end.
     1615    end.
     1616    if x-selectgood = 3 then do:
     1617    ii-3 = 0.
     1618         for each g#cli :
     1619           ii-3 = ii-3 + 1 .
     1620           if ii-3 = 1 then ii-name-3 = "список товаров - содержит  <node-code#grp-name>  (уникальный ключ списка производителе)" .
     1621                       else ii-name-3 = "" .
     1622     run create-param-to-export  in this-procedure
     1623     ( input 'g#cli'  ,
     1624      input string(ii-3)  ,
     1625      input 'character integer'  ,
     1626      input g#cli.obj-type + '#' + string(g#cli.obj-code)  ,
     1627      input ii-name-3 )
     1628    .
     1629         end.
     1630    end.
     1631     run create-param-to-export  in this-procedure
     1632     ( input 'select-object'  ,
     1633      input ''  ,
     1634      input 'character'  ,
     1635      input x-selectobject  ,
     1636      input 'тип выбора объекта   -currency -choice -firm -все' )
     1637    .
     1638    ii-1 = 0.
     1639     for each obj-list :
     1640       ii-1 = ii-1 + 1 .
     1641       if ii-1 = 1 then ii-name-1 = "список объектов - содержит <obj-type#obj-code>  (уникальный ключ clients)" .
     1642                 else ii-name-1 = "" .
     1643     run create-param-to-export  in this-procedure
     1644     ( input 'obj-list'  ,
     1645      input string(ii-1)  ,
     1646      input 'character integer'  ,
     1647      input obj-list.obj-type + '#' + string (obj-list.obj-code)  ,
     1648      input ii-name-1 )
     1649    .
     1650     end.
