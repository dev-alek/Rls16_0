      804   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
      805   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
      806   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
      807   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
      808   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
      809   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
      810   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
      811   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
      812         adm-object-hdl = FRAME F-Main:HANDLE.
      813   RUN ensure-broker.
      814   THIS-PROCEDURE:ADM-DATA =
      815        'ADM1.1~`':U +
      816        'SmartViewer~`':U +
      817        '~`':U +
      818        'NO ~`':U +
      819        '~`':U +
      820        '~`':U +
      821        '~`':U +
      822        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
      823           + "~`":U +
      824        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add~`':U +
      825        'Record-Source,Record-Target,TableIO-Target~`':U +
      826        '~`':U +
      827        '~`~`~`~`~`~`~`~`~`~`~`':U +
      828        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
      829            THEN "^^":U
      830        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
      831             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
      832   PROCEDURE adm-apply-entry :
      833     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      834   END PROCEDURE.
      835   PROCEDURE adm-destroy :
      836    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      837   END PROCEDURE.
      838   PROCEDURE adm-disable :
      839       DISABLE RECT-6 RECT-8 RECT-9 RECT-5 SortType Tog-obj Classify ShowZero-2 VAT-Cost VAT-CRSA ShowZero VAT-sale T-txt WITH FRAME F-Main.
      840       RUN dispatch ('disable-fields':U).
      841       RUN set-attribute-list ('ENABLED=no':U).
      842       RETURN.
      843   END PROCEDURE.
      844   PROCEDURE adm-edit-attribute-list :
      845         RUN adm/support/viewerd.w (INPUT THIS-PROCEDURE).
      846         RETURN.
      847   END PROCEDURE.
      848   PROCEDURE adm-enable :
      849       ENABLE UNLESS-HIDDEN RECT-6 RECT-8 RECT-9 RECT-5 SortType Tog-obj Classify ShowZero-2 VAT-Cost VAT-CRSA ShowZero VAT-sale T-txt WITH FRAME F-Main.
      850       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
      851       RUN set-attribute-list ('ENABLED=yes':U).
      852       RETURN.
      853   END PROCEDURE.
      854   PROCEDURE adm-exit :
      855        RUN notify ('exit':U).
      856     RETURN.
      857   END PROCEDURE.
      858   PROCEDURE adm-hide :
      859     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      860   END PROCEDURE.
      861   PROCEDURE adm-initialize :
      862     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      863   END PROCEDURE.
      864   PROCEDURE adm-show-errors :
      865       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
      866       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
      867           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
      868       END.
      869       RETURN.
      870   END PROCEDURE.
      871   PROCEDURE adm-UIB-mode :
      872     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      873   END PROCEDURE.
      874   PROCEDURE adm-view :
      875     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      876   END PROCEDURE.
      877   PROCEDURE dispatch :
      878       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
      879       RUN broker-dispatch IN adm-broker-hdl
      880           (THIS-PROCEDURE, p-method-name) NO-ERROR.
      881       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
      882   END PROCEDURE.
      883   PROCEDURE ensure-broker :
      884   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
      885   IF RETURN-VALUE NE "ADM-Broker":U THEN
      886   DO:
      887       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
      888       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
      889   END.
      890   END PROCEDURE.
      891   PROCEDURE get-attribute :
      892     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
      893     RUN broker-get-attribute IN adm-broker-hdl
      894         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
      895     RETURN RETURN-VALUE.
      896   END PROCEDURE.
      897   PROCEDURE get-attribute-list :
      898     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
      899     RUN broker-get-attribute-list IN adm-broker-hdl
      900         (INPUT THIS-PROCEDURE,
      901          INPUT ?,
      902          OUTPUT p-attr-list) NO-ERROR.
      903     RETURN.
      904   END PROCEDURE.
      905   PROCEDURE new-state :
      906     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
      907     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
      908     RETURN.
      909   END PROCEDURE.
      910   PROCEDURE notify :
      911     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
      912     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
      913     IF RETURN-VALUE = "ADM-ERROR":U THEN
      914         RETURN "ADM-ERROR":U.
      915     RETURN.
      916   END PROCEDURE.
      917   PROCEDURE set-attribute-list :
      918     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
      919     RUN ensure-broker.
      920     RUN broker-set-attribute-list IN adm-broker-hdl
      921         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
      922     RETURN.
      923   END PROCEDURE.
      924   PROCEDURE set-position :
      925       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
      926       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
      927       IF VALID-HANDLE(adm-object-hdl) THEN
      928       DO:
      929         ASSIGN adm-object-hdl:ROW    =   p-row
      930                adm-object-hdl:COLUMN =   p-col.
      931       END.
      932       RETURN.
      933   END PROCEDURE.
      934   PROCEDURE adm-display-fields :
      935       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
      936       RETURN.
      937   END PROCEDURE.
      938   PROCEDURE adm-open-query :
      939     RETURN.
      940   END PROCEDURE.
      941   PROCEDURE adm-row-changed :
