     1332   DEFINE RECTANGLE RECT-1
     1333        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1334        SIZE 55.13 BY 4.46.
     1335   DEFINE FRAME InfoFrame
     1336        StopBtn AT ROW 4.25 COL 21.75
     1337        RecordsString AT ROW 1.21 COL 2 NO-LABEL
     1338        RecordsString2 AT ROW 1.96 COL 2 NO-LABEL
     1339        RecordsString3 AT ROW 2.58 COL 2 NO-LABEL
     1340        RecordsDone AT ROW 3.42 COL 24.88 COLON-ALIGNED
     1341        RECT-1 AT ROW 1 COL 1
     1342       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1343            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1344            TITLE "Процесс"
     1345            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
     1346   define variable mFrameView      as logical   no-undo init yes.
     1347     define variable mFramHandle as handle no-undo.
     1348     mFramHandle = frame InfoFrame:handle.
     1349     if  log-manager:logfile-name ne ?
     1350     then DO:
     1351         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1352         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1353         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
     1354     end.
     1355     mFrameView = not session:batch-mode and mFramHandle:visible.
     1356     if mFrameView
     1357     then do:
     1358       ASSIGN
     1359          FRAME InfoFrame:HIDDEN                           = TRUE
     1360          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
     1361     end.
     1362   ON CHOOSE OF StopBtn IN FRAME InfoFrame
     1363   DO:
     1364     IF not StopProcessing THEN
     1365       Message "Вы действительно хотите прервать" SKIP
     1366               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
     1367                 UPDATE StopProcessing.
     1368     IF StopProcessing THEN do:
     1369        if mFrameView
     1370        then do:
     1371           HIDE FRAME InfoFrame.
     1372        end.
     1373     End.
     1374   END.
     1375   assign v-account = ( if integer( 25 ) = 0 then 100 else integer( 25 ) ).
     1376     if  log-manager:logfile-name ne ?
     1377     then DO:
     1378         log-manager:write-message("ON mFrameView=" + string(mFrameView), "frameRepError").
     1379     end.
     1380     if not session:batch-mode then
     1381     do:
     1382       VIEW FRAME InfoFrame.
     1383       mFrameView = true.
     1384     end.
     1385      v-button-stop = false .
     1386         if mFrameView
     1387         then do:
     1388         if v-button-stop then view STOPBTN in frame InfoFrame.
     1389                          else Hide STOPBTN in frame InfoFrame.
     1390         end.
     1391   v-ind = 0    .
