     1445     ) .
     1446   PROCEDURE Load-From-Spec:
     1447      DEFINE BUFFER g#post-f         FOR g#post-f.
     1448      DEFINE BUFFER buf_c-Spec       FOR ub.c-Contract-Specif.
     1449      DEFINE BUFFER buf_Spec         FOR ub.Contract-Specif.
     1450      DEFINE BUFFER buf_Contract     FOR ub.Contract.
     1451      DEFINE BUFFER gds-list         FOR gds-list.
     1452      DEFINE VARIABLE iNum    as INTEGER  NO-UNDO INITIAL 0.
     1453      DEFINE VARIABLE lHist   as LOGICAL  NO-UNDO INITIAL FALSE.
     1454      DEFINE VARIABLE dPrice  as DECIMAL  EXTENT 3 NO-UNDO INITIAL 0.
     1455      FOR EACH gds-list NO-LOCK:
     1456          ASSIGN
     1457             iNum = 0.
     1458          Label-Spec:
     1459          FOR EACH buf_c-Spec WHERE
     1460                   buf_c-Spec.gds-code    = Gds-list.gds-code
     1461               AND buf_c-Spec.Corr-date  >= x-Date-Start
     1462               AND buf_c-Spec.Corr-date  <= x-Date-end
     1463              NO-LOCK,
     1464              FIRST buf_Contract WHERE
     1465                    buf_Contract.Host-code       = buf_c-Spec.Host-code
     1466                AND buf_Contract.Contract-code   = buf_c-Spec.Contract-num
     1467              NO-LOCK:
     1468              if NOT CAN-FIND(FIRST g#post-f WHERE
     1469                                    g#post-f.obj-Type = buf_Contract.Cli-type
     1470                                AND g#post-f.obj-Code = buf_Contract.Cli-Code
     1471                                NO-LOCK) THEN DO:
     1472                 NEXT Label-Spec.
     1473              END.
     1474              RUN  Get-next-rec-Spec (
     1475                   buf_c-Spec.Host-code,
     1476                   buf_c-Spec.Contract-num,
     1477                   buf_c-Spec.Gds-code,
     1478                   buf_c-Spec.Corr-date,
     1479                   buf_c-Spec.Corr-time,
     1480                   OUTPUT dPrice,
     1481                   OUTPUT lHist
     1482                   ).
     1483              RUN Create-tt-Temp in THIS-PROCEDURE(
     1484                  INPUT-OUTPUT iNum,
     1485                  Gds-list.Gds-Code,
     1486                  buf_c-Spec.Corr-date,
     1487                  (IF dPrice[3] = 0 THEN dPrice[2] ELSE dPrice[3]),
     1488                  dPrice[2]
     1489                  ).
     1490          END.
     1491      END.
     1492      RETURN.
     1493   END PROCEDURE.
     1494   PROCEDURE Get-next-rec-Spec:
     1495      DEFINE INPUT PARAMETER iHost-code     as INTEGER NO-UNDO.
     1496      DEFINE INPUT PARAMETER iContract-num  as INTEGER NO-UNDO.
     1497      DEFINE INPUT PARAMETER iGds-code      as INTEGER NO-UNDO.
     1498      DEFINE INPUT PARAMETER dtDate         as DATE    NO-UNDO.
     1499      DEFINE INPUT PARAMETER iTime          as INTEGER NO-UNDO.
     1500      DEFINE OUTPUT PARAMETER dPrice        as DECIMAL EXTENT 3 NO-UNDO INITIAL 0.
     1501      DEFINE OUTPUT PARAMETER lHist         as LOGICAL NO-UNDO INITIAL FALSE.
     1502      DEFINE BUFFER buf_c-Spec       FOR ub.c-Contract-Specif.
     1503      DEFINE BUFFER buf_Spec         FOR ub.Contract-Specif.
     1504      FIND FIRST buf_c-Spec WHERE
     1505                 buf_c-Spec.Host-code     = iHost-code
     1506             AND buf_c-Spec.Contract-num  = iContract-num
     1507             AND buf_c-Spec.Gds-code      = iGds-code
     1508             AND (buf_c-Spec.Corr-date    = dtDate AND buf_c-Spec.corr-time > iTime
     1509                  OR buf_c-Spec.Corr-date > dtDate
     1510                 )
     1511             NO-LOCK NO-ERROR.
     1512      IF AVAILABLE buf_c-Spec THEN DO:
     1513         ASSIGN
     1514            lHist       = TRUE
     1515            dPrice [1]  = buf_c-Spec.price-base
     1516            dPrice [2]  = buf_c-Spec.Price-Cli
     1517            dPrice [3]  = buf_c-Spec.Price-rubl
     1518            .
     1519         RETURN.
     1520      END.
     1521      FIND FIRST buf_Spec WHERE
     1522                 buf_Spec.Host-code     = iHost-code
     1523             AND buf_Spec.Contract-num  = iContract-num
     1524             AND buf_Spec.Gds-code      = iGds-code
     1525           NO-LOCK NO-ERROR.
     1526      IF AVAILABLE buf_Spec THEN DO:
     1527         ASSIGN
     1528            dPrice [1]  = buf_Spec.price-base
     1529            dPrice [2]  = buf_Spec.Price-Cli
     1530            dPrice [3]  = buf_Spec.Price-rubl
     1531            .
     1532         RETURN.
     1533      END.
     1534      RETURN.
     1535   END PROCEDURE.
     1536   PROCEDURE Create-tt-Temp:
     1537      DEFINE INPUT-OUTPUT PARAMETER iNum  as INTEGER NO-UNDO.
     1538      DEFINE INPUT PARAMETER iGds-code    as INTEGER NO-UNDO.
     1539      DEFINE INPUT PARAMETER dtFact-Date  as DATE    NO-UNDO.
     1540      DEFINE INPUT PARAMETER dPrice-rubl  as DECIMAL NO-UNDO.
     1541      DEFINE INPUT PARAMETER dPrice-cli   as DECIMAL NO-UNDO.
     1542      DEFINE BUFFER tt-Temp FOR tt-Temp.
     1543      ASSIGN
     1544         iNum = iNum + 1.
     1545      FIND FIRST tt-Temp WHERE
     1546                 tt-Temp.Gds-code   = iGds-code
     1547             AND tt-Temp.Fact-date  = dtFact-date
     1548             AND tt-Temp.Price-rubl = dPrice-rubl
     1549           NO-LOCK NO-ERROR.
     1550      if NOT AVAILABLE tt-Temp THEN DO:
     1551         CREATE tt-Temp.
     1552         ASSIGN
     1553            tt-Temp.Num        = iNum
     1554            tt-Temp.Gds-code   = iGds-code
     1555            tt-Temp.Fact-date  = dtFact-date
     1556            tt-Temp.Price-rubl = dPrice-rubl
     1557            tt-Temp.Price-rubl = dPrice-cli
     1558            .
     1559      END.
     1560      RETURN.
     1561   END PROCEDURE.
     1562   PROCEDURE Load-From-Trn-doc:
     1563   DEFINE BUFFER trn-doc FOR ub.Trn-doc.
     1564   for each g#post-f :
     1565   for each trn-doc no-lock where
     1566            trn-doc.fact-date <= x-date-end  and
     1567            trn-doc.fact-date >= x-date-start and
     1568            trn-doc.host-code  = v-cntxt-host-code-obj  and
     1569            trn-doc.ext-doc-type  = 'ie':U  and
     1570            trn-doc.status_       = 'факт':U and
     1571            trn-doc.cli-code   = g#post-f.obj-code and
     1572            trn-doc.cli-type   = g#post-f.obj-type
     1573            :
     1574     for each gds-list :
     1575       v-price-rubl = 0.
     1576       v-goods = false .
     1577       v-price-cli = 0 .
     1578         find first bf_doc-line where bf_doc-line.doc-code  = trn-doc.doc-code   and
     1579                                      bf_doc-line.artic     = gds-list.artic     and
     1580                                      bf_doc-line.prod-type = gds-list.prod-type and
     1581                                      bf_doc-line.prod-code = gds-list.prod-code no-lock no-error.
     1582         if available bf_doc-line then do:
     1583           v-price-rubl = bf_doc-line.price-rubl .
     1584           find first tt-temp where
     1585             tt-temp.gds-code   = gds-list.gds-code and
     1586             tt-temp.price-rubl = v-price-rubl      and
     1587             tt-temp.fact-date  = trn-doc.fact-date no-error .
     1588             if not available tt-temp then do:
     1589                 create tt-temp.
     1590                 assign
     1591                   tt-temp.gds-code   = gds-list.gds-code
     1592                   tt-temp.price-rubl = v-price-rubl
     1593                   tt-temp.price-cli  = v-price-cli
     1594                   tt-temp.fact-date  = trn-doc.fact-date
     1595                 .
     1596             end.
     1597         end.
     1598     end.
     1599   end.
     1600   end.
     1601   RETURN.
     1602   END PROCEDURE.
     1603   procedure print-line :
     1604     do on error undo, return error return-value :
     1605     assign
     1606        Lines_Counter = Lines_Counter + 1
     1607       .
     1608     if line-counter( OutStream ) + 2 > page-size( OutStream ) then do:
     1609        page stream OutStream.
     1610        PUT STREAM OutStream UNFORMATTED
     1611            string( "Лист " + string( PAGE-NUMBER(OutStream) , ">>>>9") ) AT 100 format "X(13)" SKIP .
     1612        run print-1 in this-procedure.
     1613        end.
     1614     if line-counter( OutStream ) < Tmp_Counter then
     1615       assign
     1616       .
     1617     assign
     1618       Tmp_Counter  = line-counter( OutStream )
     1619       num-ln = num-ln + 1
     1620     .
     1621     if line-counter( OutStream ) + j > page-size( OutStream ) then  PAGE STREAM OutStream.
     1622   PUT STREAM OutStream UNFORMATTED
     1623       sym1                format "X(1)" space(0)
     1624       string(gds-list.gds-code)    format "X(10)" space(0)
     1625       sym2                format "X(1)" space(0)
     1626       string(gds-list.gds-name)    format "X(30)" space(0)
     1627       sym3                format "X(1)" space(0)
     1628       string(gds-list.unit-base)    format "X(3)" space(0)
     1629   .
     1630       num#col# = 1.
     1631       num#str# = num#str# + 1.
     1632       run macr_excel_char in this-procedure(gds-list.gds-code  , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1633       run macr_excel_char in this-procedure(gds-list.gds-name  , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1634       run macr_excel_char in this-procedure(gds-list.unit-base  , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1635       for each buf_tt where buf_tt.gds-code = gds-list.gds-code break by buf_tt.fact-date :
     1636               PUT STREAM OutStream UNFORMATTED
     1637                   sym1                          format "X(1)" space(0)
     1638                   string(buf_tt.price-rubl,">>>>>>9.99")    format "X(11)" space(0)
     1639                   string(buf_tt.fact-date, "99/99/99")     format "X(8)"  space(0)
     1640               .
     1641               run macr_excel_cell_format in this-procedure(
     1642                   buf_tt.price-rubl,
     1643                   num#str#,
     1644                   num#col#,
     1645                   "0.00"
     1646                   ).
     1647               assign    num#col# = num#col# + 1 .
     1648                 run macr_excel_char in this-procedure("(" + string(buf_tt.fact-date,"99/99/99") + ")"   , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1649       end.
     1650     PUT STREAM OutStream UNFORMATTED
     1651         sym2                format "X(1)" space(0)
     1652         skip
     1653     .
     1654     end.
     1655   end procedure.
     1656   procedure print-all-itog :
     1657   end procedure.
     1658   procedure PrintTitul :
     1659     do  on error undo, return error return-value  :
     1660     define variable cc as integer no-undo .
     1661     define variable tt as integer no-undo .
     1662     define variable pp as integer no-undo .
     1663   PUT STREAM OutStream UNFORMATTED
     1664   space(1)
     1665      ReportNAme skip
     1666      "по фирме "  ub.clients.obj-name skip
     1667      "Дата составления " + cur-time-date()  skip
     1668         .
     1669     define variable i as integer no-undo .
     1670     Repeat i = 1 to NUM-ENTRIES(ReportHeader,chr(10)) :
     1671       PUT STREAM OutStream UNFORMATTED  Entry(i,ReportHeader,chr(10))  AT 1 format "X(90)" SKIP.
     1672     End.
     1673       num#str# = 1.
     1674       num#col# = 1.
     1675       run macr_excel_char in this-procedure( Reportname , num#str# , num#col#   ) .
     1676       num#str# = num#str# + 1.
     1677       run macr_excel_char in this-procedure( "по фирме " + CAPS( ub.clients.obj-name)   , num#str# , num#col#   ) .
     1678       num#str# = num#str# + 1.
     1679       run macr_excel_char in this-procedure( ReportHeader , num#str# , num#col#   ) .
     1680       num#str# = num#str# + 1.
     1681       run macr_excel_char in this-procedure("Дата составления " + cur-time-date()   , num#str# , num#col#   ) .
     1682       num#str# = num#str# + 1.
     1683       run macr_excel_char in this-procedure("Код"  , num#str# , num#col#   ) .    run macr_cell_size ( 10 , ? , num#str# , num#col# , ?, ? ) .
     1684       num#col# = 2.
     1685       run macr_excel_char in this-procedure("Наименование"  , num#str# , num#col#   ) .  run macr_cell_size ( 30 , ? , num#str# , num#col# , ?, ? ) .
     1686       num#col# = 3.
     1687       run macr_excel_char in this-procedure("Ед.Изм"  , num#str# , num#col#   ) . run macr_cell_size ( 3 , ? , num#str# , num#col# , ?, ? ) .
     1688       repeat i = 1 to kol-post :
     1689         num#col# = num#col# + 1.
     1690         run macr_excel_char in this-procedure( "Цена" , num#str# , num#col#   ) .
     1691         run macr_cell_size  in this-procedure( 10 , ? , num#str# , num#col# , ?, ? ) .
     1692         num#col# = num#col# + 1.
     1693         run macr_excel_char in this-procedure( "(Дата)" , num#str# , num#col#   ) .
     1694         run macr_cell_size in this-procedure( 10 , ? , num#str# , num#col# , ?, ? ) .
     1695       end.
     1696     run print-1 in this-procedure .
     1697       run macr_cell_format in this-procedure
     1698       ( 10    ,
     1699         true  ,
     1700         false  ,
     1701         ?    ,
     1702         1 ,
     1703         1 ,
     1704         num#str# ,
     1705         num#col# ) .
     1706        put  stream macr_excel unformatted
     1707          substitute('select("r&1c&2:r&3c&4 ")' , num#str# , 1 , num#str# ,  num#col# ) + chr(10)  +
     1708          'BORDER( 2 , 2 , 2 , 2 , 2 , ,0,0,0,0,0) '  + chr(10) +
     1709          'ALIGNMENT(3 , , 4 , 4 ,)'  + chr(10)
     1710          .
     1711       put  stream macr_excel unformatted
     1712          substitute('select("r&1c&2:r&3c&4 ")' , num#str# , 1 , num#str# ,  3 ) + chr(10)  +
     1713          'BORDER( 2, , , , , , , , , , ) '  + chr(10) .
     1714     end.
     1715   end procedure.
     1716   procedure PrintPodval :
     1717     do on error undo, return error return-value  :
     1718     define variable pp as integer no-undo .
     1719     define variable rr as integer no-undo .
     1720     end.
     1721   end procedure.
     1722   PROCEDURE on-same-page :
     1723     define input parameter p-line-number as integer  no-undo .
     1724     if p-line-number > page-size( OutStream ) then return .
     1725     if line-counter( OutStream ) + p-line-number > page-size( OutStream ) then  page stream OutStream .
     1726   end procedure.
     1727   procedure print-1 :
     1728     do
     1729     on error undo, return error return-value
     1730     :
     1731       PUT STREAM OutStream UNFORMATTED  fill("-",11)  AT 1 format "X(11)" .
     1732       PUT STREAM OutStream UNFORMATTED  fill("-",31)  format "X(31)" .
     1733       PUT STREAM OutStream UNFORMATTED  fill("-",4)  format "X(4)" .
     1734       repeat i = 1 to kol-post :
     1735         PUT STREAM OutStream UNFORMATTED fill("-",20) format "X(20)" .
     1736       end.
     1737       PUT STREAM OutStream UNFORMATTED  skip .
     1738       PUT STREAM OutStream UNFORMATTED  ":Код"  AT 1 format "X(11)" .
     1739       PUT STREAM OutStream UNFORMATTED  ":Наименование"  format "X(31)" .
     1740       PUT STREAM OutStream UNFORMATTED  ":Е.И"  format "X(4)" .
     1741       repeat i = 1 to kol-post :
     1742         PUT STREAM OutStream UNFORMATTED  ":Цена        (Дата)"  format "X(20)" .
     1743       end.
     1744       PUT STREAM OutStream UNFORMATTED  skip .
     1745       PUT STREAM OutStream UNFORMATTED  fill("-",11)  AT 1 format "X(11)" .
     1746       PUT STREAM OutStream UNFORMATTED  fill("-",31)  format "X(31)" .
     1747       PUT STREAM OutStream UNFORMATTED  fill("-",4)  format "X(4)" .
     1748       repeat i = 1 to kol-post :
     1749         PUT STREAM OutStream UNFORMATTED fill("-",20) format "X(20)" .
     1750       end.
     1751       PUT STREAM OutStream UNFORMATTED  skip .
     1752     end.
     1753   end procedure.
     1754   def var vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1755   procedure macr_excel_char :
     1756    do
     1757    on error undo, return error return-value
     1758    :
     1759    define input parameter  p-val as character no-undo .
     1760    define input parameter  p-row as integer no-undo .
     1761    define input parameter  p-col as integer no-undo .
     1762    if p-val = ? then p-val = "" .
     1763       put stream macr_excel unformatted
     1764             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     1765    end.
     1766   end procedure.
     1767   procedure macr_excel_char_with_format :
     1768    do
     1769    on error undo, return error return-value
     1770    :
     1771    define input parameter  p-val as character no-undo .
     1772    define input parameter  p-row as integer no-undo .
     1773    define input parameter  p-col as integer no-undo .
     1774    if p-val = ? then p-val = "" .
     1775       put stream macr_excel unformatted
     1776             substitute('select("r&1c&2")', p-row , p-col ) + chr(10) .
     1777       put stream macr_excel unformatted 'format.number("@")' + chr(10) .
     1778       put stream macr_excel unformatted
     1779             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     1780    end.
     1781   end procedure.
     1782   procedure macr_excel_cell_format :
     1783    do
     1784    on error undo, return error return-value
     1785    :
     1786    define input parameter  p-val    as character no-undo .
     1787    define input parameter  p-row    as integer   no-undo .
     1788    define input parameter  p-col    as integer   no-undo .
     1789    define input parameter  p-format as character no-undo .
     1790    if p-val = ? then p-val = "" .
     1791       put stream macr_excel unformatted
     1792             substitute('select("r&1c&2")', p-row , p-col ) + chr(10) .
     1793       put stream macr_excel unformatted substitute('format.number("&1")', p-format) + chr(10) .
     1794       put stream macr_excel unformatted
     1795             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     1796    end.
     1797   end procedure.
     1798   procedure macr_excel_sum :
     1799    do
     1800    on error undo, return error return-value
     1801    :
     1802    define input parameter  p-row as integer no-undo .
     1803    define input parameter  p-col as integer no-undo .
     1804    define input parameter  p-row1 as integer no-undo .
     1805    define input parameter  p-col1 as integer no-undo .
     1806    define input parameter  p-row2 as integer no-undo .
     1807    define input parameter  p-col2 as integer no-undo .
     1808       put stream macr_excel unformatted
     1809             substitute('formula("=sum(r&3c&4:r&5c&6)","r&1c&2")', p-row , p-col , p-row1 , p-col1 ,p-row2 , p-col2 ) + chr(10)  .
     1810    end.
     1811   end procedure.
     1812   procedure macr_excel_dec :
     1813    do
     1814    on error undo, return error return-value
     1815    :
     1816    define input parameter  p-val as character no-undo .
     1817    define input parameter  p-row as integer   no-undo .
     1818    define input parameter  p-col as integer   no-undo .
     1819     if p-val = ? then p-val =  "" .
     1820      put  stream macr_excel unformatted
     1821           substitute('formula(&3,"r&1c&2")', p-row , p-col ,  p-val )  + chr(10) .
     1822    end.
     1823   end procedure.
     1824   procedure macr_cell_format :
     1825    do
     1826    on error undo, return error return-value
     1827    :
     1828    define input parameter  p-size   as integer   no-undo .
     1829    define input parameter  p-bold   as logical   no-undo .
     1830    define input parameter  p-italic as logical   no-undo .
     1831    define input parameter  p-color  as integer   no-undo .
     1832    define input parameter  p-row    as integer   no-undo .
     1833    define input parameter  p-col    as integer   no-undo .
     1834    define input parameter  p-row-2  as integer   no-undo .
     1835    define input parameter  p-col-2  as integer   no-undo .
     1836     if p-size = ? then p-size = 10 .
     1837     if p-bold = ? then p-bold = false .
     1838     if p-italic = ? then p-italic = false .
     1839     if p-row-2 = ? then p-row-2 = p-row .
     1840     if p-col-2 = ? then p-col-2 = p-col .
     1841     put  stream macr_excel unformatted
     1842      substitute('select("r&1c&2:r&3c&4 ")' , p-row , p-col , p-row-2 , p-col-2 ) + chr(10) .
     1843     if p-color <> ? then do:
     1844        put  stream macr_excel unformatted
     1845          substitute('patterns(1,,&1,true)', p-color ) + chr(10)  .
     1846     end.
     1847     put  stream macr_excel unformatted
     1848          substitute('format.font(,&1,&2,&3)' , p-size,
     1849                                           string ( p-bold  , "true/false" ) ,
     1850                                           string ( p-italic , "true/false" )
     1851                                           ) + chr(10) .
     1852    end.
     1853   end procedure.
     1854   procedure macr_cell_size :
     1855    do
     1856    on error undo, return error return-value
     1857    :
     1858    define input parameter  p-w   as integer   no-undo .
     1859    define input parameter  p-l   as integer   no-undo .
     1860    define input parameter  p-row    as integer   no-undo .
     1861    define input parameter  p-col    as integer   no-undo .
     1862    define input parameter  p-row-2  as integer   no-undo .
     1863    define input parameter  p-col-2  as integer   no-undo .
     1864     if p-row-2 = ? then p-row-2 = p-row .
     1865     if p-col-2 = ? then p-col-2 = p-col .
     1866     if p-w = ? then    p-w = 0 .
     1867     if p-l = ? then    p-l = 0 .
     1868    define variable s-w as character no-undo .
     1869    define variable s-l as character no-undo .
     1870    if p-w = 0 then s-w = "" .
     1871               else s-w = string(p-w)  .
     1872    if p-l = 0 then s-l = "" .
     1873               else s-l = string(p-l)  .
     1874   put  stream macr_excel unformatted
     1875        substitute('select("r&1c&2:r&3c&4 ")' , p-row , p-col , p-row-2 , p-col-2 )  skip .
     1876   put  stream macr_excel unformatted
     1877        substitute('COLUMN.WIDTH(&1,,,,)' , s-w  )  skip.
     1878   put  stream macr_excel unformatted
     1879        'FORMAT.TEXT(2,2,0,,,,,)'  skip.
     1880    end.
     1881   end procedure.
     1882   procedure proc-print-header :
     1883    do
     1884    on error undo, return error return-value
     1885    :
     1886      find first sheetf .
     1887        sheetf.excel-row-heder =  num-entries( c-str ,chr(10)) + 1.
     1888        sheetf.excel-row-title =  num-entries( sheetf.excel-column-lable , chr(10) ).
     1889        var-1 =  num#str# .
     1890        repeat c-c = 1 to sheetf.excel-row-title :
     1891        num#str# = num#str# + 1 .
     1892        p-var = num-entries( entry (c-c, sheetf.excel-column-lable, chr(10)) , chr(44) ) .
     1893        do c-i = 1 to p-var :
     1894           str--1 = entry( c-i, entry (c-c,sheetf.excel-column-lable, chr(10)) , chr(44)) .
     1895           str--2 = integer(entry( c-i, sheetf.sizes )) .
     1896           num#col# = c-i .
     1897           run macr_excel_char_with_format ( str--1  , num#str# , num#col#  ) .
     1898           run macr_cell_size ( str--2 , ? , num#str# , num#col# , ?, ? ) .
     1899        end.
     1900       c-i = 0.
     1901       end.
     1902       run macr_cell_format (
     1903           10       ,
     1904           true     ,
     1905           false    ,
     1906           35       ,
     1907           var-1 + 1,
     1908           1        ,
     1909           num#str# ,
     1910           num#col# )
     1911           .
     1912     put  stream macr_excel unformatted
     1913          substitute('select("r&1c&2:r&3c&4 ")' , var-1 + 1 , 1 , num#str# ,  num#col# ) + chr(10)  +
     1914          'ALIGNMENT(3 , , 4 , 4 ,)'  + chr(10)
     1915          .
     1916    end.
     1917   end procedure.
     1918   procedure end-proc :
     1919    do
     1920    on error undo, return error return-value
     1921    :
     1922     v-file-name = ( string( session:temp-directory + "rpt" + string( g#report-num ) ) + ".t-t").
     1923     OUTPUT to VALUE (v-file-name) .
     1924     for each temp-param :
     1925       export  temp-param  .
     1926     end.
     1927    end.
     1928   end procedure.
