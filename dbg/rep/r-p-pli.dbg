     1183           RETURN.
     1184        END.
     1185   END CASE.
     1186   define variable kk as integer   no-undo .
     1187   define variable v-old as decimal   no-undo .
     1188   define variable v-code as integer   no-undo .
     1189   v-old = 0.
     1190   v-code = 0.
     1191   for each buf_tt where break by buf_tt.gds-code
     1192                               by buf_tt.fact-date :
     1193       if v-old = buf_tt.price-rubl and  v-code = buf_tt.gds-code
     1194          then do:
     1195             v-old = buf_tt.price-rubl.
     1196             v-code   = buf_tt.gds-code.
     1197             delete buf_tt .
     1198          end.
     1199          else do:
     1200             v-old = buf_tt.price-rubl.
     1201             v-code   = buf_tt.gds-code.
     1202          end.
     1203   end.
     1204   for each gds-list :
     1205    kk = 0.
     1206       for each buf_tt where buf_tt.gds-code = gds-list.gds-code break by buf_tt.fact-date :
     1207         kk = kk + 1.
     1208       end.
     1209       if kk > kol-post then kol-post = kk.
     1210   end.
