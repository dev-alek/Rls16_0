     1170   define buffer buf_tt for tt-temp .
     1171   CASE p-iType-Rep:
     1172        WHEN 1 THEN DO:
     1173           RUN Load-From-Trn-Doc.
     1174        END.
     1175        WHEN 2 THEN DO:
