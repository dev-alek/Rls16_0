     1311   define variable v-kol-spice3 as integer no-undo .
     1312   DEFINE VARIABLE StopProcessing AS LOGICAL NO-UNDO.
     1313   DEFINE BUTTON StopBtn AUTO-END-KEY
     1314        LABEL "Стоп"
     1315        SIZE 10 BY 1.
     1316   DEFINE VARIABLE RecordsDone AS INTEGER FORMAT ">,>>>,>>>,>>9":U INITIAL 0
     1317        LABEL "Обработано записей"
     1318         VIEW-AS TEXT
     1319        SIZE 14 BY .67 NO-UNDO.
     1320   DEFINE VARIABLE RecordsString AS CHARACTER FORMAT "X(60)"
     1321         VIEW-AS TEXT
     1322        SIZE 53.25 BY .67
     1323        FGCOLOR 1  NO-UNDO.
     1324   DEFINE VARIABLE RecordsString2 AS CHARACTER FORMAT "X(60)"
     1325         VIEW-AS TEXT
     1326        SIZE 53.25 BY .67
     1327        FGCOLOR 1  NO-UNDO.
