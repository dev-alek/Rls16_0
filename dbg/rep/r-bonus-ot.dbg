     1584   define variable v-obj-type as character format "X(3)" no-undo.
     1585   define variable v-obj-code as integer no-undo.
     1586   define variable v-obj-name as character no-undo.
     1587   define variable num-g#              as integer no-undo.
     1588   define variable for-d-pcnt          as character no-undo.
     1589   define variable loc-d-pcnt          like ub.dis-card.d-pcnt no-undo.
     1590   define variable v-header-base-curr  as character no-undo.
     1591   define variable accum-counter       as integer no-undo.
     1592   define variable accum-qnty          as decimal no-undo.
     1593   define variable accum-sum           as decimal no-undo.
     1594   define variable accum-discount      as decimal no-undo.
     1595   define variable accum-netto         as decimal no-undo.
     1596   define variable accum-counter-cli   as integer no-undo.
     1597   define variable accum-qnty-cli      as decimal no-undo.
     1598   define variable accum-sum-cli       as decimal no-undo.
     1599   define variable accum-discount-cli  as decimal no-undo.
     1600   define variable accum-netto-cli     as decimal no-undo.
     1601   define variable accum-counter-leg   as integer no-undo.
     1602   define variable accum-qnty-leg      as decimal no-undo.
     1603   define variable accum-sum-leg       as decimal no-undo.
     1604   define variable accum-discount-leg  as decimal no-undo.
     1605   define variable accum-netto-leg     as decimal no-undo.
     1606   define variable accum-counter-crd   as integer no-undo.
     1607   define variable accum-qnty-crd      as decimal no-undo.
     1608   define variable accum-sum-crd       as decimal no-undo.
     1609   define variable accum-discount-crd  as decimal no-undo.
     1610   define variable accum-netto-crd     as decimal no-undo.
     1611   define variable v-d-card            like ub.dis-card.d-card no-undo.
     1612   define variable v-ii                as integer no-undo.
     1613   define variable stream-pos          as integer no-undo.
     1614   define variable v-root-card         like ub.dis-card.d-card no-undo.
     1615   define variable v-cli-code          like ub.dis-card.cli-code no-undo.
     1616   define variable v-cli-type          like ub.dis-card.cli-type no-undo.
     1617   define variable v-cli-type-code     as character no-undo.
     1618   define variable v-cli-name          like ub.clients.obj-name no-undo.
     1619   define variable v-show-d-card       like ub.dis-card.d-card no-undo.
     1620   define variable ii                  as integer no-undo.
     1621   define variable v-base-code         like ub.sysconf.base-code no-undo.
     1622   define variable v-mes-noAll-chk     as character no-undo.
     1623   define variable v-accur-13          as character initial "->>>>>>>>>>>>9.99" no-undo.
     1624   define buffer buf_clients for ub.clients.
     1625   define buffer buf2_clients for ub.clients.
     1626   define buffer buf3_clients for ub.clients.
     1627   define buffer buf_currency for ub.currency.
     1628   define temp-table help-chk no-undo
     1629       field doc-code as char
     1630       field group-chk as integer
     1631       index pi is primary unique  doc-code group-chk
     1632       .
     1633   define temp-table my-table no-undo
     1634       field note1 as character
     1635       field note2 as character
     1636       field note3 as character
     1637       field note4 as character
     1638       field note5 as character
     1639       field note6 as character
     1640       field note7 as character
     1641       field note8 as character
     1642       field note9 as character
     1643       field note10 as character
     1644       field note11 as character
     1645   .
