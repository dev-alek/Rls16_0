     1390   procedure grplib-get-full-name :
     1391      define input parameter p-node-code  as integer      no-undo.
     1392      define output parameter p-full-name as character    no-undo.
     1393      do
     1394   on error undo, return error
     1395   :
     1396       define variable v-upper-code    as integer           no-undo.
     1397       define buffer buf_gds-grp       for ub.gds-grp.
     1398       define buffer buf_upper_gds-grp for ub.gds-grp.
     1399       find first buf_gds-grp no-lock
     1400            where buf_gds-grp.node-code = p-node-code
     1401       no-error.
     1402       if not available buf_gds-grp
     1403       then do:
     1404           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
     1405       end.
     1406       assign
     1407           p-full-name  = ""
     1408           v-upper-code = 1
     1409       .
     1410       do while buf_gds-grp.upper-code <> 0
     1411       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
     1412       :
     1413           assign
     1414               p-full-name  = buf_gds-grp.node-name
     1415                            + (if p-full-name <> "" then chr(47) else "")
     1416                            + p-full-name
     1417               v-upper-code = buf_gds-grp.upper-code
     1418           .
     1419           find first buf_gds-grp no-lock
     1420                where buf_gds-grp.node-code = v-upper-code
     1421           no-error.
     1422           if not available buf_gds-grp
     1423           then do:
     1424               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
     1425                                   + string( v-upper-code )
     1426                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     1427           end.
     1428       end.
     1429       assign
     1430       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
     1431       .
     1432   end.
     1433   end .
     1434   procedure grplib-get-node-from-full-name :
     1435   define input parameter p-full-name as character no-undo .
     1436   define output parameter p-node-code as integer no-undo .
     1437   define variable v-ii as integer no-undo .
     1438   define variable v-upper-code as integer no-undo .
     1439   define variable v-root-code as integer no-undo .
     1440   define variable v-entry as character no-undo .
     1441   define buffer buf_gds-grp       for ub.gds-grp.
     1442   do
     1443   on error undo, return error
     1444   :
     1445     find first buf_gds-grp no-lock
     1446         where buf_gds-grp.upper-code = 0
     1447     no-error .
     1448     if not available buf_gds-grp
     1449     then do:
     1450         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
     1451     end.
     1452     else do:
     1453       assign
     1454       v-root-code = buf_gds-grp.node-code
     1455       .
     1456     end.
     1457     v-upper-code = v-root-code.
     1458     do v-ii = 1 to num-entries(p-full-name, chr(47)):
     1459       assign
     1460       v-entry = entry(v-ii, p-full-name, chr(47)).
     1461       if v-entry = '' then leave.
     1462       find first buf_gds-grp no-lock where
     1463                 buf_gds-grp.node-name = v-entry
     1464             and buf_gds-grp.upper-code = v-upper-code
     1465             no-error.
     1466       if not available buf_gds-grp then do:
     1467         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
     1468       end.
     1469       else do:
     1470         p-node-code = buf_gds-grp.node-code.
     1471         v-upper-code = buf_gds-grp.node-code.
     1472       end.
     1473     end.
     1474   end.
     1475   end .
