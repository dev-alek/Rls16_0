     1577   define variable v-dcard_discount as decimal no-undo.
     1578   define variable v-obj_doc-qnty as decimal no-undo.
     1579   define variable v-obj_sum-withoutdisc as decimal no-undo.
     1580   define variable v-obj_sum-withdisc as decimal no-undo.
     1581   define variable v-obj_discount as decimal no-undo.
