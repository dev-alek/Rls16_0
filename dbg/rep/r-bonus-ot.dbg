      576   define  stream PrnLibStream.
      577   procedure prn-lib-prn-file :
      578     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      579     define input parameter p-DIsabledoptions as integer no-undo .
      580     define variable v-report-name as character no-undo .
      581     define variable v-user-action as character no-undo .
      582     define variable v-printed     as logical   no-undo .
      583     define variable v-exist       as logical   no-undo .
      584     do
      585       on error undo, return error
      586       :
      587       run prn-lib-get-report-name  in this-procedure (
      588         input parParentProc
      589         ,output v-report-name
      590         ).
      591   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      592   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      593     (input  v-report-name
      594     ,input  2
      595     ,output v-exist
      596     )  .
      597       if NOT v-exist then
      598       DO:
      599         Message
      600           "Нет заданий на печать ! "
      601           view-as alert-box .
      602         Return  .
      603       End.
      604       run gbl/prnfilen.w
      605         (input  ""
      606         ,input  p-DisabledOptions
      607         ,input  string(v-report-name )
      608         ,input  7
      609         ,output v-user-action
      610         ,output v-printed
      611         ) .
      612       if v-printed then
      613       do:
      614         return "YES" .
      615       end.
      616       else
      617       do:
      618         return "NO" .
      619       end.
      620     end.
      621   end procedure.
      622   procedure prn-lib-open-stream :
      623     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      624     define input parameter p-page-size    as integer no-undo .
      625     define input parameter p-is-stream    as logical no-undo .
      626     define input parameter p-append       as logical no-undo .
      627     define variable v-report-name as character no-undo .
      628     do
      629       on error undo, return error
      630       :
      631       run prn-lib-get-report-name  in this-procedure (
      632         input parParentProc
      633         ,output v-report-name
      634         ).
      635       if p-is-stream then
      636       do:
      637         if p-append then
      638         do:
      639           output stream PrnLibStream to value( v-report-name )
      640             page-size value(p-page-size) append .
      641         end.
      642         if not p-append then
      643         do:
      644           output stream PrnLibStream to value( v-report-name )
      645             page-size value(p-page-size) .
      646         end.
      647       end.
      648       if not p-is-stream then
      649       do:
      650         if p-append then
      651         do:
      652           output to value( v-report-name )
      653             page-size value(p-page-size) append .
      654         end.
      655         if not p-append then
      656         do:
      657           output to value( v-report-name )
      658             page-size value(p-page-size) .
      659         end.
      660       end.
      661     end.
      662   end procedure.
      663   procedure prn-lib-open-exp :
      664     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      665     define input parameter p-is-stream    as logical no-undo .
      666     define input parameter p-is-append    as logical no-undo .
      667     define output parameter p-ReportFileName as char init "report" no-undo.
      668     define output parameter p-process as logical no-undo .
      669     define variable glog as logical no-undo .
      670     do
      671       on error undo, return error
      672       :
      673       SYSTEM-DIALOG GET-FILE p-ReportFileName
      674         TITLE      "Укажите путь"
      675         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      676         ASK-OVERWRITE
      677         CREATE-TEST-FILE
      678         SAVE-AS
      679         USE-FILENAME
      680         DEFAULT-EXTENSION "txt"
      681         UPDATE glog
      682         .
      683       if not glog then  return.
      684       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      685       if p-is-stream then
      686       do:
      687         if p-is-append then
      688         do:
      689           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      690         end.
      691         else
      692         do:
      693           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      694         end.
      695       end.
      696       else
      697       do:
      698         if p-is-append then
      699         do:
      700           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      701         end.
      702         else
      703         do:
      704           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      705         end.
      706       end.
      707       p-process = yes.
      708     end.
      709   end procedure.
      710   procedure prn-lib-get-report-name :
      711     define input parameter parParentProc  as widget-handle no-undo.
      712     define output parameter p-report-name as character no-undo .
      713     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      714   end procedure.
      715   procedure prn-lib-reportviewer-report-name :
      716     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      717     define input parameter p-report-name-html as character no-undo .
      718     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      719   end procedure.
      720   procedure prn-lib-reportviewer :
      721     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      722     define input parameter p-report-name-html as character no-undo .
      723     define input parameter p-param        as character no-undo .
      724     define variable v-excel           as character no-undo init 'TRUE' .
      725     define variable v-value-character as character no-undo .
      726     define variable v-value-integer   as character no-undo .
      727     define variable v-value-date      as date      no-undo .
      728     define variable v-value-decimal   as decimal   no-undo .
      729     define variable rep-excel         as logical   no-undo .
      730     define variable excel-string      as character no-undo .
      731     define variable v-param-type      as character no-undo .
      732     define variable v-tth             as handle    no-undo .
      733     run adm/shattri.p (
      734       input "get":U
      735       ,input  ""
      736       ,input  0
      737       ,input  'report-glob':U
      738       ,input  'rep-excel':U
      739       ,output v-value-character
      740       ,output v-value-date
      741       ,output v-value-decimal
      742       ,output v-value-integer
      743       ,output rep-excel
      744       ,output v-param-type
      745       ,INPUT-OUTPUT table-handle v-tth
      746       )  .
      747     if rep-excel then v-excel = "TRUE" .
      748     else v-excel = "FALSE" .
      749     if p-param eq ""
      750     then
      751        p-param = "EXCEL:" + v-excel.
      752     else
      753        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      754     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      755   end procedure.
      756   function diff-list returns character (
      757     input parfirst-list  as character,
      758     input parsecond-list as character,
      759     input pardelim       as character).
      760     if pardelim = ""
      761     or pardelim = ?
      762     then do:
      763       assign
      764         pardelim = ","
      765       .
      766     end.
      767     def var ind as integer no-undo .
      768     def var v-elem as character no-undo .
      769     def var v-result-list as character no-undo init "".
      770     def var v-num-parfirst-list as integer no-undo .
      771     assign
      772       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      773     .
      774     do ind = 1 to v-num-parfirst-list
      775     :
      776       assign
      777         v-elem = entry(ind, parfirst-list, pardelim)
      778       .
      779       if lookup(v-elem, parsecond-list, pardelim) = 0 then do:
      780         assign
      781           v-result-list = v-result-list
      782                         + (if v-result-list > "" then pardelim else "")
      783                         + v-elem
      784         .
      785       end.
      786     end.
      787     return v-result-list .
      788   end function.
      789   function add-list returns character (
      790    input parfirst-list  as character,
      791    input parsecond-list as character,
      792    input pardelim       as character).
      793     if pardelim = ""
      794     or pardelim = ?
      795     then do:
      796       assign
      797         pardelim = ","
      798       .
      799     end.
      800     def var ind as integer no-undo .
      801     def var v-elem as character no-undo .
      802     def var v-result-list as character no-undo init "".
      803     def var v-num-parfirst-list as integer no-undo .
      804     assign
      805       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      806     .
      807     do ind = 1 to v-num-parfirst-list
      808     :
      809       assign
      810         v-elem = entry(ind, parfirst-list, pardelim)
      811       .
      812       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      813         assign
      814           v-result-list = v-result-list
      815                         + (if v-result-list > "" then pardelim else "")
      816                         + v-elem
      817         .
      818       end.
      819     end.
      820     def var v-num-parsecond-list as integer no-undo .
      821     assign
      822       v-num-parsecond-list = num-entries(parsecond-list, pardelim)
      823     .
      824     do ind = 1 to v-num-parsecond-list
      825     :
      826       assign
      827         v-elem = entry(ind, parsecond-list, pardelim)
      828       .
      829       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      830         assign
      831           v-result-list = v-result-list
      832                         + (if v-result-list > "" then pardelim else "")
      833                         + v-elem
      834         .
      835       end.
      836     end.
      837     return v-result-list .
      838   end function.
      839   function cross-list returns character (
      840    input parfirst-list  as character,
      841    input parsecond-list as character,
      842    input pardelim       as character).
      843     if pardelim = ""
      844     or pardelim = ?
      845     then do:
      846       assign
      847         pardelim = ","
      848       .
      849     end.
      850     def var ind as integer no-undo .
      851     def var v-elem as character no-undo .
      852     def var v-result-list as character no-undo init "".
      853     def var v-num-parfirst-list as integer no-undo .
      854     assign
      855       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      856     .
      857     do ind = 1 to v-num-parfirst-list
      858     :
      859       assign
      860         v-elem = entry(ind, parfirst-list, pardelim)
      861       .
      862       if lookup(v-elem, v-result-list, pardelim) = 0
      863       and lookup(v-elem, parsecond-list, pardelim) > 0
      864       then do:
      865         assign
      866           v-result-list = v-result-list
      867                         + (if v-result-list > "" then pardelim else "")
      868                         + v-elem
      869         .
      870       end.
      871     end.
      872     return v-result-list .
      873   end function.
      874   function radio-label returns character (
      875    input par-rs-value  as character,
      876    input par-rs-radio-buttons as character)
      877    .
      878    DEFINE variable v-result-label as character no-undo.
      879    assign
      880    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons) MODULO 2 = 0)
      881                              then (LOOKUP(par-rs-value, par-rs-radio-buttons) - 1)
      882                              else LOOKUP(par-rs-value, par-rs-radio-buttons)
      883                             ), par-rs-radio-buttons
      884                           )
      885    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      886    .
      887   return v-result-label.
      888   end function.
      889   function m-radio-label returns character (
      890    input par-rs-value  as character,
      891    input par-rs-radio-buttons as character,
      892    input par-delim as character
      893    )
      894    .
      895    DEFINE variable v-result-label as character no-undo.
      896    assign
      897    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) MODULO 2 = 0)
      898                              then (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) - 1)
      899                              else LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim)
      900                             ), par-rs-radio-buttons, par-delim
      901                           )
      902    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      903    .
      904   return v-result-label.
      905   end function.
      906   FUNCTION mixlist returns character
      907   (
      908    input parfirst-list  as character
      909    ,input parsecond-list as character
      910    ,input pardelim       as character
      911    ,input pardelim-result as character ) :
      912     if pardelim = ""
      913     or pardelim = ?
      914     then do:
      915       assign
      916         pardelim = ","
      917       .
      918     end.
      919     def var ind as integer no-undo .
      920     def var v-elem1 as character no-undo .
      921     def var v-elem2 as character no-undo .
      922     def var v-result-list as character no-undo init "".
      923     do ind = 1 to num-entries(parfirst-list, pardelim)
      924     :
      925       assign
      926         v-elem1 = entry(ind, parfirst-list, pardelim)
      927         v-elem2 = entry(ind, parsecond-list, pardelim)
      928       .
      929         assign
      930           v-result-list = v-result-list
      931                         + (if v-result-list > "" then pardelim-result else "")
      932                         + v-elem1 + pardelim-result + v-elem2
      933         .
      934     end.
      935     return v-result-list .
      936   END FUNCTION.
      937   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      938   function breakstr returns character ( input        for-name    as character,
      939                                         input        line-length as integer,
      940                                         input-output line1       as character,
      941                                         input-output line2       as character ) :
      942     define variable ii as integer no-undo.
      943     if length( for-name ) > line-length then do:
      944       assign ii    = 1
      945              line1 = "":u
      946              line2 = "":u.
      947       if length( entry( ii, for-name , " ":u ) ) > line-length then do:
      948         assign line1 =       substring( for-name, 1, line-length     )
      949                line2 = trim( substring( for-name,    line-length + 1 ) ).
      950       end.                                                     else do:
      951         do while length( line1 + entry( ii, for-name, " ":u ) ) < ( line-length + 1 ) :
      952           assign line1 = line1 + entry( ii, for-name, " ":u ) + " ":u
      953                  ii    = ii    + 1.
      954           if length( entry( ii, for-name, " ":u ) ) > line-length then do:
      955             assign line1 = line1 + substring( for-name, length( line1 ), line-length - length( line1 ) + 1 ).
      956           end.
      957         end.
      958         assign line2 = trim( substring( for-name, length( line1 ) ) ).
      959       end.
      960     end.                                else do:
      961       assign line1 = for-name
      962              line2 = "":u.
      963     end.
      964     return ( line1 ).
      965   end function.
      966   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      967   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      968   FUNCTION get-d-pcnt RETURNS CHARACTER
      969     ( buffer loc-dis-card for ub.dis-card,
      970       input parhost-code as integer,
      971       input parobj-type as character,
      972       input parobj-code as integer,
      973       input p-discnt-role as character,
      974       output loc-d-v as decimal) :
      975   define variable v-node-code as integer no-undo .
      976   define buffer buf_dis-card-type for ub.dis-card-type.
      977   define buffer buf_dis-card-property for ub.dis-card-property.
      978   find first buf_dis-card-type no-lock where
      979             buf_dis-card-type.type = loc-dis-card.type
      980         and buf_dis-card-type.emitent-host-code = loc-dis-card.emitent-host-code
      981         and buf_dis-card-type.host-code = 0
      982         and buf_dis-card-type.obj-type = '':U
      983         and buf_dis-card-type.obj-code = 0 no-error.
      984   if available buf_dis-card-type then do:
      985     case p-discnt-role:
      986       when 'def-pcnt':U  then do:
      987         assign
      988         v-node-code = 1.
      989       end.
      990       when 'def-cash-pcnt':U then do:
      991         assign
      992         v-node-code = 2.
      993       end.
      994       when 'def-categ':U then do:
      995         assign
      996         v-node-code = 3.
      997       end.
      998     end.
      999     if buf_dis-card-type.d-pcnt-byshop then do:
     1000      find first buf_dis-card-property no-lock where
     1001                buf_dis-card-property.d-card = loc-dis-card.d-card
     1002            and buf_dis-card-property.dtm-code = 26
     1003            and buf_dis-card-property.host-code = parhost-code
     1004            and buf_dis-card-property.obj-type = parobj-type
     1005            and buf_dis-card-property.obj-code = parobj-code
     1006            and buf_dis-card-property.node-code = v-node-code no-error.
     1007      if available buf_dis-card-property then do:
     1008        if p-discnt-role = 'def-categ':U then do:
     1009          assign
     1010          loc-d-v = buf_dis-card-property.property-value-integer.
     1011        end.
     1012        else do:
     1013          assign
     1014          loc-d-v = buf_dis-card-property.property-value-decimal.
     1015        end.
     1016      end.
     1017       if loc-d-v = ? then do:
     1018   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1019   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdpcnt in g#library
     1020     (
     1021      input  loc-dis-card.type
     1022     ,input  loC-dis-card.emitent-host-code
     1023     ,input  parhost-code
     1024     ,input  parobj-type
     1025     ,input  parobj-code
     1026     ,input  p-discnt-role
     1027     ,output loc-d-v
     1028     ) no-error .
     1029       end.
     1030       if loc-d-v = ? then do:
     1031         find first buf_dis-card-property no-lock where
     1032                   buf_dis-card-property.d-card = loc-dis-card.d-card
     1033               and buf_dis-card-property.dtm-code = 26
     1034               and buf_dis-card-property.host-code = parhost-code
     1035               and buf_dis-card-property.obj-type = ''
     1036               and buf_dis-card-property.obj-code = 0
     1037               and buf_dis-card-property.node-code = v-node-code no-error.
     1038         if available buf_dis-card-property then do:
     1039           if p-discnt-role = 'def-categ':U then do:
     1040             assign
     1041             loc-d-v = buf_dis-card-property.property-value-integer.
     1042           end.
     1043           else do:
     1044             assign
     1045             loc-d-v = buf_dis-card-property.property-value-decimal.
     1046           end.
     1047         end.
     1048       end.
     1049       if loc-d-v = ? then do:
     1050   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1051   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdpcnt in g#library
     1052     (
     1053      input  loc-dis-card.type
     1054     ,input  loC-dis-card.emitent-host-code
     1055     ,input  parhost-code
     1056     ,input  ''
     1057     ,input  0
     1058     ,input  p-discnt-role
     1059     ,output loc-d-v
     1060     ) no-error .
     1061       end.
     1062       if loc-d-v = ? then do:
     1063         case p-discnt-role:
     1064           when 'def-categ':U then do:
     1065             loc-d-v = loc-dis-card.category.
     1066           end.
     1067           when 'def-pcnt':U then do:
     1068             loc-d-v = loc-dis-card.d-pcnt.
     1069           end.
     1070           when 'def-cash-pcnt':U then do:
     1071             loc-d-v = loc-dis-card.cash-d-pcnt.
     1072           end.
     1073         end case.
     1074       end.
     1075       if p-discnt-role = 'def-categ':U then do:
     1076         return substitute("(i) &1", string(loc-d-v, ">>>9")).
     1077       end.
     1078       else do:
     1079         return substitute("(i) &1", string(loc-d-v, "->9.99%")).
     1080       end.
     1081     end.
     1082   end.
     1083   else do:
     1084    return "ОШИБКА-НЕТ ТИПА".
     1085   end.
     1086   case p-discnt-role:
     1087     when 'def-categ':U then do:
     1088        loc-d-v = loc-dis-card.category.
     1089        return string(loc-d-v, ">>>9").
     1090     end.
     1091     when 'def-pcnt':U then do:
     1092       loc-d-v = loc-dis-card.d-pcnt.
     1093       return string(loc-d-v, "->9.99%").
     1094     end.
     1095     when 'def-cash-pcnt':U then do:
     1096       loc-d-v = loc-dis-card.cash-d-pcnt.
     1097       return string(loc-d-v, "->9.99%").
     1098     end.
     1099   end case.
     1100   END FUNCTION.
     1101   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1102   define variable v-waitfram-action01         as character   no-undo .
     1103   define variable v-waitfram-action02         as character   no-undo .
     1104   define variable v-waitfram-action03         as character   no-undo .
     1105   define variable mWaitFramTextBeg            as character   no-undo.
     1106   define variable mWaitFramTextEnd            as character   no-undo.
     1107   define variable mWaitFramView               as logical     no-undo.
     1108   define variable mWaitProcEvent              as logical     no-undo init yes.
     1109   define variable mWaitFramInterval           as integer     no-undo init 1 .
     1110   define variable mWaitFramStop               as logical     no-undo.
     1111   define variable mWaitFramStopUser           as logical     no-undo.
     1112   define variable mWaitFramStopTimeOut        as logical     no-undo.
     1113   define variable mWaitFramStartProc          as datetime-tz no-undo.
     1114   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     1115   define button B-WaitFramStop auto-end-key
     1116        label "Стоп"
     1117        size 10 by 1 tooltip "Остоновить процесс".
     1118   define button B-viewProcInfo
     1119        label "Информация"
     1120        size 15 by 1 tooltip "Информация о процесс".
     1121   define frame waitfram
     1122     v-waitfram-action01 format "x(72)" no-label skip
     1123     v-waitfram-action02 format "x(72)" no-label skip
     1124     v-waitfram-action03 format "x(72)" no-label skip
     1125     B-viewProcInfo
     1126     B-WaitFramStop at row 4 col 30
     1127     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1128     .
     1129   define new global shared variable mBatchMode as logical no-undo init ?.
     1130   define variable mFramBachModHandle as handle no-undo.
     1131   mFramBachModHandle = frame waitfram:handle.
     1132   define variable mFameOldVis as logical no-undo.
     1133   define variable mVisCUrentVin as logical no-undo.
     1134   if session:batch-mode
     1135   then
     1136      mBatchMode = yes.
     1137   if mBatchMode = ? then do:
     1138     mVisCUrentVin = current-window:visible.
     1139     mFameOldVis = mFramBachModHandle:visible.
     1140     mFramBachModHandle:visible  = yes.
     1141     mBatchMode = mFramBachModHandle:visible ne yes.
     1142     mFramBachModHandle:visible = mFameOldVis.
     1143     current-window:visible = mVisCUrentVin.
     1144   end.
     1145    if  log-manager:logfile-name ne ?
     1146     then DO:
     1147         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1148         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1149         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1150     end.
     1151   on choose of B-WaitFramStop in frame waitfram
     1152   do:
     1153     mWaitFramStop = yes.
     1154     mWaitFramStopUser = yes.
     1155   end.
     1156   function waitfram-check-timeout returns logical():
     1157      define variable vtime as int64 no-undo.
     1158      if mWaitFramStopTimeOut
     1159      then
     1160         return yes.
     1161      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1162      if     mWaitFramTimeOut ne ?
     1163         and mWaitFramTimeOut ne 0
     1164         and mWaitFramTimeOut lt vtime
     1165      then do:
     1166         mWaitFramStopTimeOut = yes.
     1167      end.
     1168      return mWaitFramStopTimeOut.
     1169   end.
     1170   procedure waitfram-hide :
     1171     if not session:batch-mode
     1172     then do
     1173     on error undo, return error return-value
     1174     :
     1175       pause 0 before-hide .
     1176       if not mBatchMode then
     1177         hide frame waitfram .
     1178     if     not mWaitFramView
     1179        and mWaitProcEvent
     1180     then
     1181       process events .
     1182     end.
     1183   end procedure.
     1184   procedure waitfram-show :
     1185     define input  parameter p-message as character no-undo .
     1186     define variable v-left-margin as integer   no-undo .
     1187     if not session:batch-mode
     1188     then do
     1189     on error undo, return error return-value
     1190     :
     1191       if length(p-message) <= 70 then do:
     1192         assign
     1193           v-left-margin = integer((70 - length(p-message)) / 2)
     1194         .
     1195         assign
     1196           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1197         .
     1198         assign
     1199           v-waitfram-action01 = " "
     1200           v-waitfram-action02 = " "
     1201                                    + fill(" ", v-left-margin)
     1202                                    + p-message
     1203           v-waitfram-action03 = " "
     1204         .
     1205       end.
     1206       else do:
     1207         define variable vRindex1 as integer no-undo.
     1208         define variable vRindex2 as integer no-undo.
     1209         vRindex1 = r-index(p-message," ",70).
     1210         if vRindex1 = 0
     1211         then
     1212            vRindex1 = 70.
     1213         if length(p-message)  <= vRindex1 + 70 then do:
     1214           assign
     1215             v-waitfram-action01 = " "
     1216             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1217             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1218           .
     1219         end.
     1220         else do:
     1221           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1222           if vRindex2 <= vRindex1
     1223           then
     1224              vRindex2 = vRindex1 + 70.
     1225           assign
     1226             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1227             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1228             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1229           .
     1230         end.
     1231       end.
     1232       B-viewProcInfo:visible   in frame waitfram = no.
     1233       B-viewProcInfo:sensitive in frame waitfram = no.
     1234       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1235       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1236       if  (   mWaitFramView
     1237          or  mWaitProcEvent)
     1238          and not mBatchMode
     1239       then
     1240          display
     1241             v-waitfram-action01 skip
     1242             v-waitfram-action02 skip
     1243             v-waitfram-action03 skip
     1244          with frame waitfram .
     1245       if     mWaitFramView
     1246          then do:
     1247             if     mWaitFramInterval ne ?
     1248                and not mBatchMode
     1249             then
     1250                wait-for go of frame waitfram pause mWaitFramInterval.
     1251          end.
     1252          else
     1253             if     mWaitProcEvent
     1254                and not mBatchMode
     1255             then
     1256                process events .
     1257     end.
     1258   end procedure.
     1259      procedure waitfram-show-this:
     1260         define input  parameter iInterval as int64 no-undo.
     1261         define variable vtime as int64 no-undo.
     1262         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1263         mWaitFramInterval = iInterval.
     1264         run waitfram-show (substitute("&1&2 &3&4" ,
     1265                                       mWaitFramTextBeg ,
     1266                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1267                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1268                                       mWaitFramTextEnd
     1269                                      )
     1270                           ).
     1271      end.
     1272      procedure WaitFramRunPause:
     1273         define input  parameter iInterval as dec no-undo.
     1274         define variable vStart  as datetime-tz no-undo.
     1275         define variable vend    as datetime-tz no-undo.
     1276         define variable vint as int64 no-undo.
     1277         define variable vOk as logical no-undo.
     1278         vStart = now.
     1279         vend   = vStart.
     1280         publish "WaitFramPause" (iInterval,output vOk).
     1281         vend   =  now.
     1282         vint = vend - vStart.
     1283         vint = iInterval - vint / 1000.
     1284         if     not mWaitFramStop
     1285            and (   vint > 0
     1286                 or (    not vOk
     1287                     and iInterval eq ?
     1288                     )
     1289                 )
     1290         then
     1291            run waitfram-show-this (iInterval).
     1292         vend   =  now.
     1293         vint = vend - vStart.
     1294         vint = iInterval - vint / 1000.
     1295         if     not mWaitFramStop
     1296            and vint > 0
     1297         then do:
     1298            run gbl/pause.p (vint * 1000).
     1299         end.
     1300         if iInterval ne ?
     1301         then
     1302            publish "WaitFramStop".
     1303         waitfram-check-timeout().
     1304      end.
     1305      procedure WaitFramWaitFor:
     1306         define input  parameter iInterval as dec no-undo.
     1307         assign
     1308            mWaitFramStartProc   = now
     1309            mWaitFramStopUser    = no
     1310            mWaitFramStopTimeOut = no
     1311         .
     1312         block-wait:
     1313         do while not mWaitFramStop:
     1314            run WaitFramRunPause (iInterval).
     1315            if  waitfram-check-timeout()
     1316            then do:
     1317               leave block-wait.
     1318            end.
     1319         end.
     1320         run waitfram-hide.
     1321      end.
     1322   procedure waitfram-join :
     1323     define input  parameter p-line-1  as character no-undo .
     1324     define input  parameter p-line-2  as character no-undo .
     1325     define input  parameter p-line-3  as character no-undo .
     1326     define output parameter p-message as character no-undo .
     1327     do
     1328     on error undo, return error return-value
     1329     :
     1330       assign
     1331         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1332                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1333                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1334       .
     1335     end.
     1336   end procedure.
     1337   function waitfram-join-function returns character
     1338     (input p-line-1 as character
     1339     ,input p-line-2 as character
     1340     ,input p-line-3 as character
     1341     ).
     1342     define variable v-message as character no-undo .
     1343     run waitfram-join in this-procedure
     1344       (input  p-line-1
     1345       ,input  p-line-2
     1346       ,input  p-line-3
     1347       ,output v-message
     1348       ) .
     1349     return v-message .
     1350   end function .
