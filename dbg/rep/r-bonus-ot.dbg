     1663       field gds-string as character
     1664   .
     1665   define buffer buf_shop for ub.shop.
     1666   define buffer buf_store for ub.store.
     1667   define buffer buf_dis-card for ub.dis-card.
     1668   define buffer buf_dcards for dcards.
     1669   define buffer buf-crd_dcards for dcards.
     1670   define buffer buf-crd2_dcards for dcards.
     1671   define buffer buf-obj_dcards for dcards.
     1672   define buffer buf-obj1_dcards for dcards.
     1673   define buffer buf-obj3_dcards for dcards.
     1674   define buffer X_dis-card for ub.dis-card.
     1675   define buffer buf_chk-doc for ub.chk-doc.
     1676   define buffer buf_CHK-GDS for ub.chk-gds.
     1677   define buffer buf_bar-code for ub.bar-code.
     1678   define buffer buf_goods for ub.goods.
     1679   define buffer buf_payment for ub.payment.
     1680   define buffer buf_payment-attr for ub.payment-attr.
     1681   define buffer buf_obj-list for obj-list.
     1682   define stream OutStr-html.
     1683   define stream MyWatch-strm.
     1684   function fnc-DD-MM-YYYY returns character
     1685   (input p-dat-date as date) forward.
     1686   function fnc-convert-dot-to-colon returns character
     1687   (input p-data as decimal, p-accur as character) forward.
     1688   run My-Rep.
     1689   run waitfram-hide in this-procedure .
     1690   procedure calc-chk:
     1691       v-first-of-d-card = no.
     1692       do:
     1693           if dcardmode = "ONE":U then
     1694           do:
     1695               if not buf_chk-doc.d-card = FixDCard then return.
     1696           end.
     1697           if dcardmode = "list":U then
     1698           do:
     1699               find first dc-list where
     1700               dc-list.d-card = buf_chk-doc.d-card no-error.
     1701               if not available dc-list then return.
     1702           end.
     1703       end.
     1704       process events.
     1705       v-count = v-count + 1.
     1706       if (v-count  modulo 10) = 0
     1707       and  v-count >= 10 then
     1708       do:
     1709           run waitfram-show in this-procedure (input substitute("&1&2 обработано чеков &3"
     1710                                                                   ,obj-list.obj-type
     1711                                                                   ,obj-list.obj-code
     1712                                                                   ,v-count))
     1713           .
     1714       end.
     1715       new-doc = yes.
     1716       if p-T-obj-detal = yes  then
     1717       do:
     1718           v-obj-type = obj-list.obj-type.
     1719           v-obj-code = obj-list.obj-code.
     1720           v-obj-name = obj-list.obj-name.
     1721       end.
     1722       else
     1723       do:
     1724           v-obj-type = "".
     1725           v-obj-code = 0.
     1726           v-obj-name = "".
     1727       end.
     1728       do:
     1729           _chk: for each buf_chk-gds where buf_chk-gds.doc-code = buf_chk-doc.doc-code
     1730                 ,
     1731                 first buf_bar-code no-lock where
     1732                       buf_bar-code.b-code = buf_chk-gds.b-code
     1733                 ,
     1734                 first buf_goods no-lock where
     1735                       buf_goods.gds-code = buf_bar-code.gds-code
     1736           :
     1737   case x-SelectGood:
     1738            when 4 or
     1739            when 6     or
     1740            when 5   then
     1741                   do:
     1742                       find  first gds-list no-lock
     1743                           where gds-list.artic     = buf_goods.artic
     1744                           and gds-list.prod-type = buf_goods.prod-type
     1745                           and gds-list.prod-code = buf_goods.prod-code
     1746                           no-error .
     1747                           if not available gds-list then next.
     1748                   end.
     1749           when 1  then
     1750                   do:
     1751                   end.
     1752   end case.
     1753               if buf_chk-gds.write-off-code <> ? and
     1754                  buf_chk-gds.write-off-code > 0 then next _CHk.
     1755                   if prodmode = 3 then
     1756                   do:
     1757                       if not can-find(first g#cli no-lock where
     1758                                             g#cli.obj-type = buf_goods.prod-type and
     1759                                             g#cli.obj-code = buf_goods.prod-code) then next _chk.
     1760                   end.
     1761                   if prodmode = 2 then
     1762                   do:
     1763                       assign
     1764                           v-grp-name = ""
     1765                           v-found = no
     1766                       .
     1767                       _ii-grp: do ii-grp = 1 to num-entries(buf_goods.grp-name, chr(47)) - 1
     1768                       :
     1769                           assign
     1770                               v-grp-name = v-grp-name + entry(ii-grp, buf_goods.grp-name, chr(47)) + chr(47)
     1771                           .
     1772                           if can-find(first tmp#grp no-lock where
     1773                                             tmp#grp.grp-name = v-grp-name) then
     1774                           do:
     1775                               assign v-found = yes.
     1776                               leave _ii-grp.
     1777                           end.
     1778                       end.
     1779                       if not v-found then next _chk.
     1780                   end.
     1781                   if prodmode = 4 then
     1782                   do:
     1783                       if not can-find(first gds-list no-lock where
     1784                                             gds-list.gds-code = buf_goods.gds-code) then next _chk.
     1785                   end.
     1786               find first dcards where
     1787                          dcards.obj-type = v-obj-type and
     1788                          dcards.obj-code = v-obj-code and
     1789                          dcards.d-card = buf_chk-doc.d-card and
     1790                          dcards.b-code = buf_bar-code.b-code
     1791               no-error.
     1792               if not available dcards then
     1793               do:
     1794                   create dcards.
     1795                   assign
     1796                       dcards.obj-type     = v-obj-type
     1797                       dcards.obj-code     = v-obj-code
     1798                       dcards.obj-name     = v-obj-name
     1799                       dcards.chk-date     = buf_chk-doc.chk-date
     1800                       dcards.shift-date   = buf_chk-doc.shift-date
     1801                       dcards.chk-doc-code = buf_chk-doc.doc-code
     1802                       dcards.d-card       = buf_chk-doc.d-card
     1803                       dcards.artic        = buf_goods.artic
     1804                       dcards.gds-name     = buf_goods.gds-name
     1805                       dcards.b-code       = buf_bar-code.b-code
     1806                       dcards.prod-type    = buf_goods.prod-type
     1807                       dcards.prod-code    = buf_goods.prod-code
     1808                       dcards.doc-qnty     = 0
     1809                       dcards.grp-code     = buf_goods.grp-code
     1810                       dcards.gds-code     = buf_goods.gds-code
     1811                   .
     1812               end.
     1813               v-first-of-d-card = yes.
     1814               assign
     1815                   dcards.doc-qnty = dcards.doc-qnty + buf_chk-gds.doc-qnty
     1816                   dcards.sale-price = buf_chk-gds.price-base
     1817                   dcards.sum = dcards.sum + (buf_chk-gds.doc-qnty * dcards.sale-price)
     1818                    new-doc = no
     1819                           dcards.cli-type-code = buf_chk-doc.cli-type + string(buf_chk-doc.cli-code)
     1820                            dcards.discount = dcards.discount + (buf_chk-gds.doc-qnty *
     1821                                     (buf_chk-gds.discnt +
     1822                                     (buf_chk-gds.price-base - buf_chk-gds.price-base)))
     1823                           dcards.sum-withdisc = dcards.sum - dcards.discount
     1824                           dcards.counter = dcards.counter + 1 .
     1825          for  first   chk-discnt where chk-discnt.line-num = buf_chk-gds.line-num and chk-discnt.doc-code = buf_chk-gds.doc-code and chk-discnt.record-type = 4 :
     1826                           assign dcards.qnty-bonus =  dcards.qnty-bonus + chk-discnt.discnt-value-abs.
     1827                   end.
     1828           end.
     1829           if v-first-of-d-card = yes  then
     1830           do:
     1831               find first buf-crd_dcards where
     1832                          buf-crd_dcards.grp-lvl = 1000 and
     1833                          buf-crd_dcards.obj-type = v-obj-type and
     1834                          buf-crd_dcards.obj-code = v-obj-code and
     1835                          buf-crd_dcards.d-card = dcards.d-card
     1836               no-lock no-error.
     1837               if not available buf-crd_dcards then
     1838               do:
     1839                   create buf-crd_dcards.
     1840                   assign
     1841                       buf-crd_dcards.grp-lvl = 1000
     1842                       buf-crd_dcards.obj-type = v-obj-type
     1843                       buf-crd_dcards.obj-code = v-obj-code
     1844                       buf-crd_dcards.d-card = dcards.d-card
     1845                       buf-crd_dcards.cli-type-code = dcards.cli-type-code
     1846                       .
     1847               end.
     1848               if available buf-crd_dcards then
     1849               do:
     1850                   buf-crd_dcards.counter = buf-crd_dcards.counter + 1.
     1851               end.
     1852       end.
     1853   end.
     1854   end procedure.
     1855   procedure My-Rep:
     1856       run get-full-path-RepViewer(output v-full-path-RepView).
     1857       run get-report-num in parParentProc(output g#report-num).
     1858       run define-full-path-Report(input g#report-num, output v-file-name-rep-htm).
     1859       run create-file(v-file-name-rep-htm).
     1860      case X-selectgood:
     1861           when 3 then
     1862           do:
     1863               for each g#cli no-lock
     1864               :
     1865                   num-g# = num-g# + 1.
     1866                   if num-g# = 1 then FixProdAttr = g#cli.obj-type + string(g#cli.obj-code).
     1867                   if num-g# > 1 then leave.
     1868               end.
     1869           end.
     1870           when 2 then
     1871           do:
     1872               for each tmp#grp no-lock
     1873               :
     1874                   num-g# = num-g# + 1.
     1875                   if num-g# = 1 then FixProdAttr = string(tmp#grp.node-code).
     1876                   if num-g# > 1 then leave.
     1877               end.
     1878           end.
     1879           when 4 or when 5 then
     1880           do:
     1881               for each gds-list no-lock
     1882               :
     1883                   num-g# = num-g# + 1.
     1884                   if num-g# = 1 then
     1885                   FixProdAttr = string(gds-list.gds-code).
     1886                   if num-g# > 1 then leave.
     1887               end.
     1888           end.
     1889       end case.
     1890       run waitfram-show in this-procedure ("Подождите ...").
     1891           if prodmode = 3 then
     1892           do:
     1893               assign
     1894                   v-prod-type = Substr(FixProdAttr, 1, 3)
     1895                   v-prod-code = integer(substr(FixProdAttr, 4))
     1896               .
     1897           end.
     1898           if prodmode = 2 then
     1899           do:
     1900               assign
     1901                   v-grp-code = integer(FixProdAttr)
     1902               .
     1903               run grplib-get-full-name in this-procedure (
     1904                                                            input v-grp-code
     1905                                                           ,output v-grp-name)
     1906               .
     1907           end.
     1908           if prodmode = 5 then
     1909           do:
     1910               assign
     1911                   v-gds-code = integer(FixProdAttr)
     1912               .
     1913           end.
     1914       for each obj-host:
     1915           delete obj-host.
     1916       end.
     1917       create obj-host.
     1918       assign
     1919           obj-host.host-code = 0
     1920       .
     1921       _obj: for each obj-list
     1922       :
     1923           if obj-list.obj-type = 'маг':U then
     1924           do:
     1925               find first buf_shop no-lock where
     1926               buf_shop.obj-code = obj-list.obj-code.
     1927               find first obj-host no-lock where
     1928               obj-host.host-code = buf_shop.host-code no-error.
     1929               if not available obj-host then
     1930               do:
     1931                   create obj-host.
     1932                   assign
     1933                       obj-host.host-code = buf_shop.host-code
     1934                   .
     1935               end.
     1936           end.
     1937           else
     1938           do:
     1939               find first buf_store no-lock where
     1940               buf_store.obj-code = obj-list.obj-code.
     1941               find first obj-host no-lock where
     1942               obj-host.host-code = buf_store.host-code no-error.
     1943               if not available obj-host then
     1944               do:
     1945                   create obj-host.
     1946                   assign
     1947                       obj-host.host-code = buf_store.host-code
     1948                   .
     1949               end.
     1950           end.
     1951           if x-TOG-Shift = yes then
     1952           do:
     1953               if can-find(first ub.chk-doc where
     1954               ub.chk-doc.obj-type = obj-list.obj-type and
     1955               ub.chk-doc.obj-code = obj-list.obj-code and
     1956               (ub.chk-doc.shift-date >= X-date-Start) and
     1957               (ub.chk-doc.shift-date <= X-date-End) and
     1958               ub.chk-doc.d-card <> "" and
     1959               ub.chk-doc.out-code > "" ) then
     1960                   do:
     1961                       _chk-doc1: for each buf_chk-doc no-lock where
     1962                       buf_chk-doc.obj-type = obj-list.obj-type and
     1963                       buf_chk-doc.obj-code = obj-list.obj-code and
     1964                       (buf_chk-doc.shift-date > X-date-Start or (buf_chk-doc.shift-date = X-date-Start and buf_chk-doc.shift-num >= x-Shift-Start)) and
     1965                       (buf_chk-doc.shift-date < X-date-End or (buf_chk-doc.shift-date = X-date-End and buf_chk-doc.shift-num <= x-Shift-End)) and
     1966                       buf_chk-doc.d-card <> "":U and
     1967                       buf_chk-doc.out-code <> ?
     1968                       :
     1969                           do:
     1970                               if lookup(string(buf_chk-doc.chk-type), '14,15,16,36,17,8,11,12,13,40,69,101,106,108,169,196,114,115,116,117,111,112,136,113,101,106,108,208,2,3,4,5,7,43,44':U) > 0 then next _chk-doc1.
     1971                               run calc-chk.
     1972                           end.
     1973                       end.
     1974                   end.
     1975           end.
     1976           else
     1977           do:
     1978               if can-find(first chk-doc where
     1979               chk-doc.obj-type = obj-list.obj-type and
     1980               chk-doc.obj-code = obj-list.obj-code and
     1981               chk-doc.chk-date >= X-date-Start and
     1982               chk-doc.chk-date <= X-date-End and
     1983               chk-doc.d-card <> "" and
     1984               chk-doc.out-code > "" ) then
     1985               do:
     1986                   _chk-doc: for each buf_chk-doc no-lock where
     1987                   buf_chk-doc.obj-type = obj-list.obj-type and
     1988                   buf_chk-doc.obj-code = obj-list.obj-code and
     1989                   buf_chk-doc.chk-date >= X-date-Start and
     1990                   buf_chk-doc.chk-date <= X-date-End and
     1991                   buf_chk-doc.d-card <> "":U and
     1992                   buf_chk-doc.out-code <> ?
     1993                   :
     1994                       do:
     1995                           if lookup(string(buf_chk-doc.chk-type), '14,15,16,36,17,8,11,12,13,40,69,101,106,108,169,196,114,115,116,117,111,112,136,113,101,106,108,208,2,3,4,5,7,43,44':U) > 0 then next _chk-doc.
     1996                           run calc-chk.
     1997                       end.
     1998                   end.
     1999               end.
     2000           end.
     2001           if  p-T-obj-detal = yes  then
     2002           do:
     2003               if can-find(first dcards) then
     2004               do:
     2005                   assign
     2006                       v-obj-chk-counter = 0
     2007                       v-obj_doc-qnty = 0
     2008                       v-obj_sum-withdisc = 0
     2009                       v-obj_qnty-bonus = 0
     2010                   .
     2011                   for each buf-obj_dcards where
     2012                            buf-obj_dcards.obj-type = obj-list.obj-type and
     2013                            buf-obj_dcards.obj-code = obj-list.obj-code and
     2014                            buf-obj_dcards.grp-lvl = 0
     2015                   break
     2016                       by buf-obj_dcards.d-card
     2017                   :
     2018                       if first-of(buf-obj_dcards.d-card) then
     2019                       do:
     2020                           run transform-tt-level(input buf-obj_dcards.obj-type, input buf-obj_dcards.obj-code, input buf-obj_dcards.d-card  ).
     2021                           do:
     2022                               assign
     2023                                   v-dcard_doc-qnty = 0
     2024                                   v-dcard_sum-withdisc = 0
     2025                                   v-dcard_qnty-bonus = 0
     2026                               .
     2027                           end.
     2028                       end.
     2029                       assign
     2030                           v-dcard_doc-qnty = v-dcard_doc-qnty + buf-obj_dcards.doc-qnty
     2031                           v-dcard_sum-withdisc = v-dcard_sum-withdisc + buf-obj_dcards.sum-withdisc
     2032                           v-dcard_qnty-bonus = v-dcard_qnty-bonus + buf-obj_dcards.qnty-bonus
     2033                       .
     2034                       assign
     2035                            v-obj_doc-qnty = v-obj_doc-qnty + buf-obj_dcards.doc-qnty
     2036                           v-obj_sum-withdisc = v-obj_sum-withdisc + buf-obj_dcards.sum-withdisc
     2037                          v-obj_qnty-bonus = v-obj_qnty-bonus + buf-obj_dcards.qnty-bonus
     2038                       .
     2039                       if last-of(buf-obj_dcards.d-card) then
     2040                       do:
     2041                           find first buf-crd_dcards where
     2042                                      buf-crd_dcards.grp-lvl = 1000 and
     2043                                      buf-crd_dcards.obj-type = buf-obj_dcards.obj-type and
     2044                                      buf-crd_dcards.obj-code = buf-obj_dcards.obj-code and
     2045                                      buf-crd_dcards.d-card = buf-obj_dcards.d-card
     2046                           no-error.
     2047                           for first buf_clients where
     2048                                     buf_clients.obj-type = substring(buf-obj_dcards.cli-type-code, 1, 3) and
     2049                                     buf_clients.obj-code = integer(substring(buf-obj_dcards.cli-type-code, 4))
     2050                           :
     2051                               buf-crd_dcards.gds-name = buf_clients.obj-name.
     2052                           end.
     2053                           assign
     2054                               buf-crd_dcards.doc-qnty = v-dcard_doc-qnty
     2055                               buf-crd_dcards.sum-withdisc = v-dcard_sum-withdisc
     2056                               buf-crd_dcards.qnty-bonus = v-dcard_qnty-bonus
     2057                           .
     2058                           v-obj-chk-counter = v-obj-chk-counter + buf-crd_dcards.counter.
     2059                       end.
     2060                   end.
     2061                   find first buf-obj1_dcards where
     2062                             buf-obj1_dcards.grp-lvl = 2000 and
     2063                             buf-obj1_dcards.obj-type = obj-list.obj-type and
     2064                             buf-obj1_dcards.obj-code = obj-list.obj-code and
     2065                             buf-obj1_dcards.obj-name = obj-list.obj-name
     2066                   no-lock no-error.
     2067                   if not available buf-obj1_dcards then
     2068                   do:
     2069                       create buf-obj1_dcards.
     2070                       assign
     2071                           buf-obj1_dcards.grp-lvl = 2000
     2072                           buf-obj1_dcards.obj-type = obj-list.obj-type
     2073                           buf-obj1_dcards.obj-code = obj-list.obj-code
     2074                           buf-obj1_dcards.obj-name = obj-list.obj-name
     2075                       .
     2076                   end.
     2077                   if available buf-obj1_dcards then
     2078                   do:
     2079                       assign
     2080                           buf-obj1_dcards.counter = v-obj-chk-counter
     2081                           buf-obj1_dcards.doc-qnty = v-obj_doc-qnty
     2082                           buf-obj1_dcards.sum-withdisc = v-obj_sum-withdisc
     2083                           buf-obj1_dcards.qnty-bonus = v-obj_qnty-bonus
     2084                       .
     2085                   end.
     2086               end.
     2087           end.
     2088       end.
     2089       if p-T-obj-detal = no  then
     2090       do:
     2091           if can-find(first dcards) then
     2092           do:
     2093               assign
     2094                     v-obj-chk-counter = 0
     2095                       v-obj_doc-qnty = 0
     2096                       v-obj_sum-withdisc = 0
     2097     v-obj_qnty-bonus = 0.
     2098               for each buf-obj3_dcards where
     2099                        buf-obj3_dcards.grp-lvl = 0
     2100               break
     2101                   by buf-obj3_dcards.d-card
     2102               :
     2103                   if first-of(buf-obj3_dcards.d-card) then
     2104                   do:
     2105                       run transform-tt-level(input buf-obj3_dcards.obj-type, input buf-obj3_dcards.obj-code, input buf-obj3_dcards.d-card  ).
     2106                       do:
     2107                           assign
     2108                               v-dcard_doc-qnty = 0
     2109                               v-dcard_sum-withdisc = 0
     2110                               v-dcard_qnty-bonus = 0
     2111                           .
     2112                       end.
     2113                   end.
     2114                   assign
     2115                       v-dcard_doc-qnty = v-dcard_doc-qnty + buf-obj3_dcards.doc-qnty
     2116                       v-dcard_sum-withdisc = v-dcard_sum-withdisc + buf-obj3_dcards.sum-withdisc
     2117                       v-dcard_qnty-bonus = v-dcard_qnty-bonus + buf-obj3_dcards.qnty-bonus
     2118                   .
     2119                   assign
     2120                       v-obj_sum-withdisc = v-obj_sum-withdisc + buf-obj3_dcards.sum-withdisc
     2121                       v-obj_qnty-bonus = v-obj_qnty-bonus + buf-obj3_dcards.qnty-bonus
     2122                   .
     2123                   if last-of(buf-obj3_dcards.d-card) then
     2124                   do:
     2125                       find first buf-crd_dcards where
     2126                                  buf-crd_dcards.grp-lvl = 1000 and
     2127                                  buf-crd_dcards.obj-type = buf-obj3_dcards.obj-type and
     2128                                  buf-crd_dcards.obj-code = buf-obj3_dcards.obj-code and
     2129                                  buf-crd_dcards.d-card = buf-obj3_dcards.d-card
     2130                       no-lock no-error.
     2131                       if available buf-crd_dcards then
     2132                       do:
     2133                           for first buf_clients where
     2134                                     buf_clients.obj-type = substring(buf-obj3_dcards.cli-type-code, 1, 3) and
     2135                                     buf_clients.obj-code = integer(substring(buf-obj3_dcards.cli-type-code, 4))
     2136                           :
     2137                               buf-crd_dcards.gds-name = buf_clients.obj-name.
     2138                           end.
     2139                           assign
     2140                               buf-crd_dcards.doc-qnty = v-dcard_doc-qnty
     2141                               buf-crd_dcards.sum-withdisc = v-dcard_sum-withdisc
     2142                               buf-crd_dcards.qnty-bonus = v-dcard_qnty-bonus
     2143                           .
     2144                           v-obj-chk-counter = v-obj-chk-counter + buf-crd_dcards.counter.
     2145                       end.
     2146                   end.
     2147               end.
     2148               if can-find(first dcards) then
     2149               do:
     2150                   create buf-obj1_dcards.
     2151                   assign
     2152                       buf-obj1_dcards.obj-name = "ИТОГО"
     2153                       buf-obj1_dcards.grp-lvl = 2000
     2154                       buf-obj1_dcards.counter = v-obj-chk-counter
     2155                       buf-obj1_dcards.sum-withdisc = v-obj_sum-withdisc
     2156                       buf-obj1_dcards.qnty-bonus = v-obj_qnty-bonus
     2157                   .
     2158                   release buf-obj1_dcards.
     2159               end.
     2160           end.
     2161       end.
     2162       run waitfram-hide in this-procedure.
     2163       if can-find(first dcards) then
     2164       do:
     2165           run prn-lib-open-stream in this-procedure (
     2166                                                        input my-handle
     2167                                                       ,input 43
     2168                                                       ,input yes
     2169                                                       ,input no
     2170                                                      ).
     2171           Line = fill("-", 200).
     2172           form header
     2173               line format "X(184)" at 1 skip
     2174               "Продолжение - на следующей странице" at 30 skip
     2175               with frame BottomFrame width 232 page-bottom no-labels no-box
     2176           .
     2177           view stream PrnLibStream frame BottomFrame.
     2178           assign
     2179               v-report-name = "Отчет по бонусам"
     2180           .
     2181           assign
     2182               v-period = str1
     2183           .
     2184           assign
     2185               v-msg-noAllChk = (if NotInc then "(сформирован НЕ ПО ВСЕМ ЧЕКАМ)" else "")
     2186           .
     2187           put stream PrnLibStream
     2188               space(40) "Отчет по бонусам" skip
     2189               space(40) str1 format "X(60)" skip
     2190               space(20) (if NotInc then "(сформирован НЕ ПО ВСЕМ ЧЕКАМ)" else " ") format "x(40)" skip
     2191               space(20) "По объектам :"
     2192           .
     2193           _short-list: for each obj-list no-lock
     2194           :
     2195               find first buf_clients where
     2196                          buf_clients.obj-type = obj-list.obj-type and
     2197                          buf_clients.obj-code = obj-list.obj-code no-lock
     2198               .
     2199               find first ub.db where
     2200                          ub.db.db-num = buf_clients.db-num no-lock
     2201               .
     2202               do:
     2203                   v-short-obj-list = v-short-obj-list + (if length(v-short-obj-list) > 0 then ";  " else "") +  buf_clients.obj-name.
     2204                   if length(v-short-obj-list) > 100 then
     2205                   do:
     2206                       v-short-obj-list = substring(v-short-obj-list, 1, 100) + "...".
     2207                       leave _short-list.
     2208                   end.
     2209               end.
     2210           end.
     2211           case DcardMode:
     2212               when "ALL":U then
     2213               do:
     2214                   v-sel-card-string = "Покупатели: По ВСЕМ картам.".
     2215               end.
     2216               when "ONE":U then do:
     2217                   end.
     2218               when "LIST":U then
     2219               do:
     2220                   ii = 0.
     2221                   for each dc-list no-lock
     2222                   :
     2223                       ii = ii + 1.
     2224                   end.
     2225                   v-sel-card-string = "Покупатели : По сформированному списку карт" + "(в списке " + string(ii) + " кар.)".
     2226                   do:
     2227                       put stream PrnLibStream
     2228                           space(10) string("По сформированному списку карт") format "x(50)" skip
     2229                           substitute("В списке &1 карт", ii) skip
     2230                       .
     2231                   end.
     2232               end.
     2233           end case.
     2234           if X-SelectGood = 1 then
     2235           do:
     2236           end.
     2237           else
     2238           do:
     2239               case X-selectgood:
     2240                   when 3 then
     2241                   do:
     2242                       do:
     2243                           put stream PrnLibStream
     2244                           space(20) "По производителям: " format "x(80)" skip(0).
     2245                       end.
     2246                       _g#cli: for each g#cli
     2247                       :
     2248                           do:
     2249                               put stream PrnLibStream
     2250                                   space(20) g#cli.obj-name format "x(80)" skip(0)
     2251                               .
     2252                           end.
     2253                           if available tt-selectgood then
     2254                           do:
     2255                               if tt-selectgood.collection-element = g#cli.obj-name then next.
     2256                           end.
     2257                           else
     2258                           do:
     2259                               create tt-selectgood.
     2260                           end.
     2261                           if available tt-selectgood then
     2262                           do:
     2263                               tt-selectgood.collection-element = tt-selectgood.collection-element + g#cli.obj-name + "; ".
     2264                               if length(tt-selectgood.collection-element) > 100 then
     2265                               do:
     2266                                   tt-selectgood.collection-element = substring(tt-selectgood.collection-element, 1, 100).
     2267                                   tt-selectgood.collection-element = right-trim(tt-selectgood.collection-element, " ").
     2268                                   tt-selectgood.collection-element = right-trim(tt-selectgood.collection-element, ";").
     2269                                   tt-selectgood.collection-element = tt-selectgood.collection-element + "...".
     2270                                   leave _g#cli.
     2271                               end.
     2272                           end.
     2273                       end.
     2274                       find first tt-selectgood no-lock no-error.
     2275                       if not available tt-selectgood then
     2276                       do:
     2277                           create tt-selectgood.
     2278                       end.
     2279                       tt-selectgood.collection-name = "Выбор товара: По производителям:".
     2280                   end.
     2281                   when 2 then
     2282                   do:
     2283                       do:
     2284                           put stream PrnLibStream
     2285                               space(20) "Выбор товара: По группам товаров: " format "x(80)" skip(0)
     2286                           .
     2287                       end.
     2288                       _tmp#grp: for each tmp#grp
     2289                       :
     2290                           do:
     2291                               put stream PrnLibStream
     2292                                   space(20) tmp#grp.grp-name format "x(80)" skip(0)
     2293                               .
     2294                           end.
     2295                           if available tt-selectgood then
     2296                           do:
     2297                               if tt-selectgood.collection-element = tmp#grp.grp-name then next.
     2298                           end.
     2299                           else
     2300                           do:
     2301                               create tt-selectgood.
     2302                           end.
     2303                           if available tt-selectgood then
     2304                           do:
     2305                               tt-selectgood.collection-element = tt-selectgood.collection-element + tmp#grp.grp-name + "; ".
     2306                               if length(tt-selectgood.collection-element) > 100 then
     2307                               do:
     2308                                   tt-selectgood.collection-element = substring(tt-selectgood.collection-element, 1, 100).
     2309                                   tt-selectgood.collection-element = right-trim(tt-selectgood.collection-element, " ").
     2310                                   tt-selectgood.collection-element = right-trim(tt-selectgood.collection-element, ";").
     2311                                   tt-selectgood.collection-element = tt-selectgood.collection-element + "...".
     2312                                   leave _tmp#grp.
     2313                               end.
     2314                           end.
     2315                       end.
     2316                       find first tt-selectgood no-lock no-error.
     2317                       if not available tt-selectgood then
     2318                       do:
     2319                           create tt-selectgood.
     2320                       end.
     2321                       tt-selectgood.collection-name = " По группам товаров:".
     2322                   end.
     2323                   when 4 then
     2324                   do:
     2325                       ii = 0.
     2326                       for each gds-list
     2327                       :
     2328                           ii = ii + 1.
     2329                       end.
     2330                       create tt-selectgood.
     2331                       tt-selectgood.collection-name = " По сформированному списку товаров " + "(В списке " + string(ii) + " товаров).".
     2332                       do:
     2333                           put stream PrnLibStream
     2334                               space(10) "По сформированному списку товаров " format "x(50)"
     2335                               substitute("(В списке &1 товаров)", ii) skip
     2336                           .
     2337                       end.
     2338                   end.
     2339                   when 5 then
     2340                   do:
     2341                       find first gds-list
     2342                       .
     2343                       create tt-selectgood.
     2344                       tt-selectgood.collection-name = "Выбор товара:".
     2345                       tt-selectgood.collection-element = string(gds-list.artic) + chr(32) +
     2346                                                         gds-list.prod-type + string(gds-list.prod-code) +
     2347                                                         chr(32) + gds-list.gds-name
     2348                       .
     2349                       do:
     2350                           put stream PrnLibStream
     2351                               space(20) "По товару: " format "x(10)"
     2352                               gds-list.artic chr(32) gds-list.prod-type gds-list.prod-code chr(32) gds-list.gds-name skip(0)
     2353                           .
     2354                       end.
     2355                   end.
     2356               end case.
     2357           end.
     2358   str1 = (if X-TOG-Shift then "С " + fnc-DD-MM-YYYY(date(string(X-Date-Start,"99/99/9999"))) + ", смена № "  + string(X-Shift-Start) +
     2359                                   " по " + fnc-DD-MM-YYYY(date(string(X-Date-End,"99/99/9999"))) + ", смена № " + string(X-Shift-End)
     2360                              else
     2361                                   "За период с " + fnc-DD-MM-YYYY(date(string(X-Date-Start,"99/99/9999"))) + " по " + fnc-DD-MM-YYYY(date(string(X-Date-End,"99/99/9999")))
     2362       ).
     2363           run proc-create-HTML(
     2364                                    input v-file-name-rep-htm
     2365                                   ,input v-report-name
     2366                                   ,input str1
     2367                               ).
     2368           run search-full-path-Report(input v-file-name-rep-htm).
     2369           run Report-Viewer(input v-full-path-RepView, input v-file-name-rep-htm).
     2370       end.
     2371       else
     2372       do:
     2373           message
     2374               "На выбранных Вами объектах" skip
     2375               "не было продаж " skip
     2376               "в течение заданного Вами периода времени."
     2377           view-as alert-box information.
     2378           for each dcards:
     2379               delete dcards.
     2380           end.
     2381       end.
     2382   end procedure.
     2383   procedure proc-create-HTML:
     2384       define input parameter p-file-name-rep-htm as character no-undo.
     2385       define input parameter p-report-name as character no-undo.
     2386       define input parameter p-period as character no-undo.
     2387       define variable v-message as character no-undo.
     2388       define buffer buf-html_clients for ub.clients.
     2389       define buffer buf-obj2_dcards for dcards.
     2390       define buffer buf-crd2_dcards for dcards.
     2391       define buffer buf-crd-imp_dcards for dcards.
     2392       do:
     2393           output stream OutStr-html to value(p-file-name-rep-htm) append convert target 'UTF-8'.
     2394               put stream OutStr-html unformatted
     2395                   "<!DOCTYPE HTML>" skip
     2396                   ' <html>' skip
     2397                   '  <head>' skip
     2398                   '   <meta charset="utf-8">' skip
     2399                   '    <style type="text/css">' skip
     2400                   '      table ' + chr(123) + ' border-collapse: collapse; font-size: 9pt; table-layout: fixed; width: 500px; padding: 3px; ' + chr(125) skip
     2401                   '      td ' + chr(123) ' border: 1px black ridge; word-wrap:break-word; ' + chr(125) skip
     2402                   '      htm' skip
     2403                   '      .rotate ' + chr(123) skip
     2404                   '        -webkit-transform: rotate(-90deg);' skip
     2405                   '        -moz-transform: rotate(-90deg);' skip
     2406                   '        -ms-transform: rotate(-90deg);' skip
     2407                   '        -o-transform: rotate(-90deg);' skip
     2408                   '        transform: rotate(-90deg);' skip
     2409                   '        -webkit-transform-origin: 50% 50%;' skip
     2410                   '        -moz-transform-origin: 50% 50%;' skip
     2411                   '        -ms-transform-origin: 50% 50%;' skip
     2412                   '        -o-transform-origin: 50% 50%;' skip
     2413                   '        transform-origin: 50% 50%;' skip
     2414                   '        filter: progid:DXImageTransform.Microsoft.BasicImage(rotation=3);' skip
     2415                   '          ' + chr(125) skip
     2416                   '            th' + ' ' + chr(123) skip
     2417                   '            border: 1px black solid;' skip
     2418                   '            word-wrap: break-word;' skip
     2419                   '          ' + chr(125) skip
     2420                   '   </style>' skip
     2421                   '  </head>' skip
     2422               .
     2423       end.
     2424       do:
     2425               put stream OutStr-html unformatted
     2426                   ' <body>' skip
     2427                   '   <table name="Лист1" outline_below="false" orientation="Portrait" fit_to_page="true" >' skip
     2428                   '     <thead>' skip
     2429                   '       <tr class="set_columns">' skip
     2430                   '         <td style="width: 150px; border: none;"></td>' skip
     2431                   '         <td style="width: 200px; border: none;"></td>' skip
     2432                   '         <td style="width: 130px; border: none;"></td>' skip
     2433                   '         <td style="width: 80px; border: none;"></td>' skip
     2434                '         <td style="width: 80px; border: none;"></td>' skip
     2435                   '       </tr>' skip
     2436               .
     2437       end.
     2438       do:
     2439               put stream OutStr-html unformatted
     2440                   '       <tr>' skip
     2441                   '         <td style="border: none; height: 14px"></td>' skip
     2442                   '         <td style="border: none"></td>' skip
     2443                   '         <td style="border: none"></td>' skip
     2444                   '         <td style="border: none"></td>' skip
     2445                   '         <td style="border: none"></td>' skip
     2446                   '       </tr>' skip
     2447                   '       <tr>' skip
     2448                   '         <td colspan="5" style="border: none; height: 14px; font-weight: bold; text-align: center">' + p-report-name + '</td>' skip
     2449                   '         <td style="border: none"></td>' skip
     2450                   '         <td style="border: none"></td>' skip
     2451                   '         <td style="border: none"></td>' skip
     2452                   '         <td style="border: none"></td>' skip
     2453                   '       </tr>' skip
     2454                   '       <tr>' skip
     2455                   '         <td colspan="5" style="border: none; height: 14px; font-weight: bold; text-align: center">' + p-period + '</td>' skip
     2456                   '         <td style="border: none"></td>' skip
     2457                   '         <td style="border: none"></td>' skip
     2458                   '         <td style="border: none"></td>' skip
     2459                   '         <td style="border: none"></td>' skip
     2460                   '       </tr>' skip
     2461                   '       <tr>' skip
     2462                   '         <td style="border: none; height: 14px; font-weight: bold"></td>' skip
     2463                   '         <td style="border: none"></td>' skip
     2464                   '         <td style="border: none"></td>' skip
     2465                   '         <td style="border: none"></td>' skip
     2466                   '         <td style="border: none"></td>' skip
     2467                   '       </tr>' skip
     2468               .
     2469               if NotInc then
     2470               do:
     2471                   run msg-html-noAllChk(output v-message).
     2472                   put stream OutStr-html unformatted
     2473                       v-message
     2474                   .
     2475               end.
     2476               put stream OutStr-html unformatted
     2477                   '       <tr>' skip
     2478                   '         <td colspan="5" style="border: none; height: 14px; font-weight: bold">По объектам:</td>' skip
     2479                   '         <td style="border: none"></td>' skip
     2480                   '         <td style="border: none"></td>' skip
     2481                   '         <td style="border: none"></td>' skip
     2482                   '         <td style="border: none"></td>' skip
     2483                   '       </tr>' skip
     2484               .
     2485               put stream OutStr-html unformatted
     2486                   '       <tr>' skip
     2487                   '         <td colspan="5" style="border: none; height: 14px">' + v-short-obj-list + '</td>' skip
     2488                   '         <td style="border: none"></td>' skip
     2489                   '         <td style="border: none"></td>' skip
     2490                   '         <td style="border: none"></td>' skip
     2491                   '         <td style="border: none"></td>' skip
     2492                   '       </tr>' skip
     2493               .
     2494               put stream OutStr-html unformatted
     2495                   '       <tr>' skip
     2496                   '         <td style="border: none; height: 14px"></td>' skip
     2497                   '         <td style="border: none"></td>' skip
     2498                   '         <td style="border: none"></td>' skip
     2499                   '         <td style="border: none"></td>' skip
     2500                   '         <td style="border: none"></td>' skip
     2501                   '       </tr>' skip
     2502               .
     2503               put stream OutStr-html unformatted
     2504                   '       <tr>' skip
     2505                   '         <td colspan="5" style="border: none; height: 14px">' + v-sel-card-string + '</td>' skip
     2506                   '         <td style="border: none"></td>' skip
     2507                   '         <td style="border: none"></td>' skip
     2508                   '         <td style="border: none"></td>' skip
     2509                   '         <td style="border: none"></td>' skip
     2510                   '       </tr>' skip
     2511               .
     2512               if  X-SelectGood <> 1 then
     2513               do:
     2514                   put stream OutStr-html unformatted
     2515                       '       <tr>' skip
     2516                       '         <td style="border: none; height: 14px"></td>' skip
     2517                       '         <td style="border: none"></td>' skip
     2518                       '         <td style="border: none"></td>' skip
     2519                       '         <td style="border: none"></td>' skip
     2520                       '         <td style="border: none"></td>' skip
     2521                       '       </tr>' skip
     2522                   .
     2523               end.
     2524               find first tt-selectgood no-lock no-error.
     2525               if available tt-selectgood then
     2526               do:
     2527                   if tt-selectgood.collection-name <> ? or tt-selectgood.collection-name <> "":U then
     2528                   do:
     2529                       put stream OutStr-html unformatted
     2530                           '       <tr>' skip
     2531                           '         <td colspan="5" style="border: none; height: 14px">' + tt-selectgood.collection-name + '</td>' skip
     2532                           '         <td style="border: none"></td>' skip
     2533                           '         <td style="border: none"></td>' skip
     2534                           '         <td style="border: none"></td>' skip
     2535                           '         <td style="border: none"></td>' skip
     2536                           '         <td style="border: none"></td>' skip
     2537                           '       </tr>' skip
     2538                       .
     2539                   end.
     2540               end.
     2541               if X-SelectGood <> 1 then
     2542               do:
     2543                   define variable v-nn as integer initial 0 no-undo.
     2544                   for each tt-selectgood no-lock where
     2545                   :
     2546                       if tt-selectgood.collection-element <> ? or tt-selectgood.collection-element <> "" then
     2547                       do:
     2548                           v-nn = v-nn + 1.
     2549                           put stream OutStr-html unformatted
     2550                               '       <tr>' skip
     2551                               '         <td colspan="5" style="border: none; height: 14px">' + tt-selectgood.collection-element + '</td>' skip
     2552                               '         <td style="border: none"></td>' skip
     2553                               '         <td style="border: none"></td>' skip
     2554                               '         <td style="border: none"></td>' skip
     2555                               '         <td style="border: none"></td>' skip
     2556                               '         <td style="border: none"></td>' skip
     2557                               '       </tr>' skip
     2558                           .
     2559                       end.
     2560                   end.
     2561               end.
     2562               put stream OutStr-html unformatted
     2563                   '       <tr>' skip
     2564                   '         <td style=" border: none; height: 14px"></td>' skip
     2565                   '         <td style=" border: none"></td>' skip
     2566                   '         <td style=" border: none"></td>' skip
     2567                   '         <td style=" border: none"></td>' skip
     2568                   '         <td style=" border: none"></td>' skip
     2569                   '       </tr>' skip
     2570               .
     2571       end.
     2572       do:
     2573               put stream OutStr-html unformatted
     2574                   '     <tbody>' skip
     2575                   '       <tr>' skip
     2576                   '         <th style="text-align: center; height: 30px">Номер Карты / Артикул товара</th>' skip
     2577                   '         <th style="text-align: center;">Наименование</th>' skip
     2578                   '         <th style="text-align: center;">Кол-во чеков/покупок</th>' skip
     2579                   '         <th style="text-align: center;">Сумма</th>' skip
     2580                   '         <th style="text-align: center;">Бонусы</th>' skip
     2581                   '       </tr>' skip
     2582                   '       <tr>' skip
     2583                   '         <th num="" style="text-align: center">1</th>' skip
     2584                   '         <th num="" style="text-align: center">2</th>' skip
     2585                   '         <th num="" style="text-align: center">3</th>' skip
     2586                   '         <th num="" style="text-align: center">4</th>' skip
     2587                   '         <th num="" style="text-align: center">5</th>' skip
     2588                   '       </tr>' skip
     2589               .
     2590           output stream OutStr-html close.
     2591       end.
     2592       do:
     2593           output stream OutStr-html to value(p-file-name-rep-htm) append convert target 'UTF-8'.
     2594           if p-T-obj-detal then
     2595           do:
     2596               for each buf-obj2_dcards where
     2597                        buf-obj2_dcards.grp-lvl = 2000 and
     2598                        buf-obj2_dcards.artic = "" no-lock
     2599               :
     2600                   do:
     2601                       put stream OutStr-html unformatted
     2602                           '       <tr level="1">' skip
     2603                           '         <td style="display: yes; text-align: left; height: 20px; font-weight: bold">' + "Объект: " + (if buf-obj2_dcards.obj-name = ? then "" else buf-obj2_dcards.obj-name) + '</td>' skip
     2604                           '         <td style="display: yes; text-align: left; font-weight: bold"></td>' skip
     2605                           '         <td num="0" style="display: yes; text-align: right; font-weight: bold">' + string(buf-obj2_dcards.counter) + '</td>' skip
     2606                           '         <td num="0.00" style="display: yes; text-align: right; font-weight: bold" val="' + string(buf-obj2_dcards.sum-withdisc) + '"' + '>' +
     2607                                       fnc-convert-dot-to-colon(buf-obj2_dcards.sum-withdisc, v-accur-13) + '</td>' skip
     2608                           '         <td num="0.00" style="display: yes; text-align: right; font-weight: bold" val="' + string(buf-obj2_dcards.qnty-bonus) + '"' + '>' +
     2609                                       fnc-convert-dot-to-colon(buf-obj2_dcards.qnty-bonus, v-accur-13) + '</td>' skip
     2610                           '       </tr>' skip
     2611                       .
     2612                   end.
     2613                   for each buf-crd2_dcards where
     2614                            buf-crd2_dcards.obj-type = buf-obj2_dcards.obj-type and
     2615                            buf-crd2_dcards.obj-code = buf-obj2_dcards.obj-code and
     2616                            buf-crd2_dcards.grp-lvl  = 1000 and
     2617                            buf-crd2_dcards.artic    = ""
     2618                   no-lock
     2619                   :
     2620                       do:
     2621                           put stream OutStr-html unformatted
     2622                               '       <tr level="2">' skip
     2623                               '         <td style="display: yes; text-align: left; height: 20px; font-weight: bold; padding-left: 10px">' +  string(fill(" ", (4))) +  (if buf-crd2_dcards.d-card <> ? then buf-crd2_dcards.d-card else "?") + '</td>' skip
     2624                               '         <td style="display: yes; text-align: left; font-weight: bold">' +  buf-crd2_dcards.gds-name +  " (" + buf-crd2_dcards.cli-type-code + ")" + '</td>' skip
     2625                               '         <td num="0" style="display: yes; text-align: right; font-weight: bold">' + string(buf-crd2_dcards.counter) + '</td>' skip
     2626                               '         <td num="0.00" style="display: yes; text-align: right; font-weight: bold" val="' + string(buf-crd2_dcards.sum-withdisc) + '"' + '>' +
     2627                                           fnc-convert-dot-to-colon(buf-crd2_dcards.sum-withdisc, v-accur-13) + '</td>' skip
     2628                               '         <td num="0.00" style="display: yes; text-align: right; font-weight: bold" val="' + string(buf-crd2_dcards.qnty-bonus) + '"' + '>' +
     2629                                           fnc-convert-dot-to-colon(buf-crd2_dcards.qnty-bonus, v-accur-13) + '</td>' skip
     2630                               '       </tr>' skip
     2631                           .
     2632                       end.
     2633                       if available buf-crd2_dcards then
     2634                       do:
     2635                           run tt-print-line (input buf-crd2_dcards.obj-type, input buf-crd2_dcards.obj-code, input buf-crd2_dcards.d-card, input 1, input 3).
     2636                       end.
     2637                   end.
     2638               end.
     2639           end.
     2640           else
     2641           do:
     2642               for each buf-obj2_dcards where
     2643                         buf-obj2_dcards.grp-lvl = 2000 and
     2644                         buf-obj2_dcards.gds-name <> "ВС" and
     2645                         buf-obj2_dcards.artic <> "Импорт из ВС" no-lock
     2646               :
     2647                   put stream OutStr-html unformatted
     2648                       '       <tr level="1">' skip
     2649                       '         <td style="display: yes; text-align: left; height: 20px; font-weight: bold">' + "Итого по всем ДКартам: " + '</td>' skip
     2650                       '         <td style="display: yes; text-align: left; font-weight: bold"></td>' skip
     2651                       '         <td num="0" style="display: yes; text-align: right; font-weight: bold">' + string(buf-obj2_dcards.counter) + '</td>' skip
     2652                       '         <td num="0.00" style="display: yes; text-align: right; font-weight: bold" val="' + string(buf-obj2_dcards.sum-withdisc) + '"' + '>' +
     2653                                   fnc-convert-dot-to-colon(buf-obj2_dcards.sum-withdisc, v-accur-13) + '</td>' skip
     2654                       '         <td num="0.00" style="display: yes; text-align: right; font-weight: bold" val="' + string(buf-obj2_dcards.qnty-bonus) + '"' + '>' +
     2655                                   fnc-convert-dot-to-colon(buf-obj2_dcards.qnty-bonus, v-accur-13) + '</td>' skip
     2656                       '       </tr>' skip
     2657                   .
     2658                   for each buf-crd2_dcards where
     2659                            buf-crd2_dcards.grp-lvl = 1000
     2660                   no-lock
     2661                   :
     2662                       do:
     2663                           put stream OutStr-html unformatted
     2664                               '       <tr level="2">' skip
     2665                               '         <td style="display: yes; text-align: left; height: 20px; font-weight: bold; padding-left: 10px">' +  string(fill(" ", (4))) +  (if buf-crd2_dcards.d-card <> ? then buf-crd2_dcards.d-card else "?") + '</td>' skip
     2666                               '         <td style="display: yes; text-align: left; font-weight: bold">' +  buf-crd2_dcards.gds-name + " (" + buf-crd2_dcards.cli-type-code + ")" + '</td>' skip
     2667                               '         <td num="0" style="display: yes; text-align: right; font-weight: bold">' + string(buf-crd2_dcards.counter) + '</td>' skip
     2668                               '         <td num="0.00" style="display: yes; text-align: right; font-weight: bold" val="' + string(buf-crd2_dcards.sum-withdisc) + '"' + '>' +
     2669                                           fnc-convert-dot-to-colon(buf-crd2_dcards.sum-withdisc, v-accur-13) + '</td>' skip
     2670                               '         <td num="0.00" style="display: yes; text-align: right; font-weight: bold" val="' + string(buf-crd2_dcards.qnty-bonus) + '"' + '>' +
     2671                                           fnc-convert-dot-to-colon(buf-crd2_dcards.qnty-bonus, v-accur-13) + '</td>' skip
     2672                               '       </tr>' skip
     2673                           .
     2674                       end.
     2675                       if available buf-crd2_dcards then
     2676                       do:
     2677                           run tt-print-line (input buf-crd2_dcards.obj-type, input buf-crd2_dcards.obj-code, input buf-crd2_dcards.d-card, input 1, input 3).
     2678                       end.
     2679                   end.
     2680               end.
     2681           end.
     2682       end.
     2683       do:
     2684                   put stream OutStr-html unformatted
     2685                   '     </tbody>' skip
     2686                   '   </table>' skip
     2687                   '  </body>' skip
     2688                   ' </html>' skip
     2689                   .
     2690           output stream OutStr-html close.
     2691       end.
     2692   end procedure.
     2693   procedure msg-html-noAllChk:
     2694       define output parameter p-message as character no-undo.
     2695           p-message =
     2696                   '       <tr>' + chr(10) +
     2697                   '         <td style="border: none; height: 14px; font-weight: bold"></td>' + chr(10) +
     2698                   '         <td colspan="9" style="border: none">' + "сформирован НЕ ПО ВСЕМ ЧЕКАМ" + '</td>' + chr(10) +
     2699                   '         <td style="border: none"></td>' + chr(10) +
     2700                   '         <td style="border: none"></td>' + chr(10) +
     2701                   '         <td style="border: none"></td>' + chr(10) +
     2702                   '         <td style="border: none"></td>' + chr(10) +
     2703                   '         <td style="border: none"></td>' + chr(10) +
     2704                   '         <td style="border: none"></td>' + chr(10) +
     2705                   '         <td style="border: none"></td>' + chr(10) +
     2706                   '         <td style="border: none"></td>' + chr(10) +
     2707                   '       </tr>' + chr(10) +
     2708                   '       <tr>' + chr(10) +
     2709                   '         <td style="border: none; height: 14px; font-weight: bold"></td>' + chr(10) +
     2710                   '         <td style="border: none"></td>' + chr(10) +
     2711                   '         <td style="border: none"></td>' + chr(10) +
     2712                   '         <td style="border: none"></td>' + chr(10) +
     2713                   '         <td style="border: none"></td>' + chr(10) +
     2714                   '         <td style="border: none"></td>' + chr(10) +
     2715                   '         <td style="border: none"></td>' + chr(10) +
     2716                   '         <td style="border: none"></td>' + chr(10) +
     2717                   '         <td style="border: none"></td>' + chr(10) +
     2718                   '         <td style="border: none"></td>' + chr(10) +
     2719                   '       </tr>' + chr(10)
     2720           .
     2721   end procedure.
     2722   procedure get-full-path-RepViewer:
     2723       define output parameter p-fill-path-RepView as character no-undo.
     2724       if search("exe\ReportViewer\reportviewer.exe") <> ? then
     2725       do:
     2726           p-fill-path-RepView = search("exe\ReportViewer\reportviewer.exe").
     2727       end.
     2728       else
     2729       do:
     2730           message "Не найдена программа просмотра отчёта!" view-as alert-box error.
     2731       end.
     2732   end procedure.
     2733   procedure define-full-path-Report:
     2734       define input parameter p-rep-num as integer no-undo.
     2735       define output parameter p-file-name-rep-htm as character no-undo.
     2736       p-file-name-rep-htm = session:temp-directory + "rpt" + string(p-rep-num) + ".html".
     2737   end procedure.
     2738   procedure search-full-path-Report:
     2739       define input parameter p-file-name as character no-undo.
     2740       if search(p-file-name) = ? then
     2741           do:
     2742               message "Не найден файл отчёта: " p-file-name view-as alert-box error.
     2743           end.
     2744       else
     2745           do:
     2746               p-file-name = search(p-file-name).
     2747           end.
     2748   end procedure.
     2749   procedure Report-Viewer:
     2750       define input parameter p-full-path-RepView as character no-undo.
     2751       define input parameter p-file-name-rep-htm as character no-undo.
     2752   os-command no-wait value(p-full-path-RepView + " true " + search(p-file-name-rep-htm)).
     2753   end procedure.
     2754   procedure create-file:
     2755       define input parameter p-file-name as character no-undo.
     2756       output to value(string(p-file-name)).
     2757       output close.
     2758   end procedure.
     2759   procedure tt-print-line:
     2760       define input parameter p-obj-type as character no-undo.
     2761       define input parameter p-obj-code as integer no-undo.
     2762       define input parameter p-d-card as character no-undo.
     2763       define input parameter p-upper-code like ub.gds-grp.upper-code no-undo.
     2764       define input parameter p-print-lvl as integer no-undo.
     2765       define variable v-display as character no-undo.
     2766       define buffer buf3_dcards for dcards.
     2767       for each buf3_dcards where
     2768                buf3_dcards.upper-code = p-upper-code and
     2769                buf3_dcards.obj-type = p-obj-type and
     2770                buf3_dcards.obj-code = p-obj-code and
     2771                buf3_dcards.d-card = p-d-card
     2772       no-lock
     2773       :
     2774           if p-print-lvl < 3 then
     2775           do:
     2776               v-display = "yes".
     2777           end.
     2778           else
     2779           do:
     2780               v-display = "none".
     2781           end.
     2782           do:
     2783               if buf3_dcards.grp-lvl <> 0 then
     2784               do:
     2785                   put stream OutStr-html unformatted
     2786                       '       <tr level="' + string(p-print-lvl) + '">' skip
     2787                       '         <td style="display: ' + v-display + '; text-align: left; height: 20px; padding-left: ' + string((p-print-lvl - 0) * 10) + 'px; font-weight: bold">' + string(fill(" ", ((p-print-lvl - 1 ) * 4))) + buf3_dcards.artic + '</td>' skip
     2788                       '         <td style="display: ' + v-display + '; text-align: left; font-weight: bold">' + buf3_dcards.gds-name + '</td>' skip
     2789                       '         <td num="0" style="display: ' + v-display + '; text-align: right; font-weight: bold">' + (if buf3_dcards.counter = 0 then "" else (string(if buf3_dcards.counter <> ? then string (buf3_dcards.counter) else "?"))) + '</td>' skip
     2790                       '         <td num="0.00" style="display: ' + v-display + '; text-align: right; font-weight: bold">' + if buf3_dcards.sum-withdisc <> ? then fnc-convert-dot-to-colon(buf3_dcards.sum-withdisc, v-accur-13) + '</td>' else "?" + '</td>' skip
     2791                       '         <td num="0.00" style="display: ' + v-display + '; text-align: right; font-weight: bold">' + if buf3_dcards.qnty-bonus <> ? then fnc-convert-dot-to-colon(buf3_dcards.qnty-bonus, v-accur-13) + '</td>' else "?" + '</td>' skip
     2792                       '       </tr>' skip
     2793                   .
     2794               end.
     2795               else
     2796               do:
     2797                   put stream OutStr-html unformatted
     2798                       '       <tr level="' + string(p-print-lvl) + '">' skip
     2799                       '         <td style="display: ' + v-display + '; text-align: left; height: 20px; padding-left: ' + string((p-print-lvl - 0) * 10) + 'px">' + string(fill(" ", ((p-print-lvl - 1 ) * 4))) + buf3_dcards.artic + '</td>' skip
     2800                       '         <td style="display: ' + v-display + '; text-align: left">' + buf3_dcards.gds-name + '</td>' skip
     2801                       '         <td num="0" style="display: ' + v-display + '; text-align: right">' + (if buf3_dcards.counter = 0 then "" else (string(if buf3_dcards.counter <> ? then string (buf3_dcards.counter) else "?"))) + '</td>' skip
     2802                       '         <td num="0.00" style="display: ' + v-display + '; text-align: right">' + if buf3_dcards.sum-withdisc <> ? then fnc-convert-dot-to-colon(buf3_dcards.sum-withdisc, v-accur-13) + '</td>' else "?" + '</td>' skip
     2803                       '         <td num="0.00" style="display: ' + v-display + '; text-align: right">' + if buf3_dcards.qnty-bonus <> ? then fnc-convert-dot-to-colon(buf3_dcards.qnty-bonus, v-accur-13) + '</td>' else "?" + '</td>' skip
     2804                       '       </tr>' skip
     2805                   .
     2806               end.
     2807           end.
     2808           if buf3_dcards.grp-lvl <> 0 then run tt-print-line (input p-obj-type, input p-obj-code, input p-d-card, input buf3_dcards.grp-code, input p-print-lvl + 1).
     2809       end.
     2810   end procedure.
     2811   procedure transform-tt-level:
     2812       define input parameter p-obj-type as character no-undo.
     2813       define input parameter p-obj-code as integer no-undo.
     2814       define input parameter p-d-card like ub.dis-card.d-card no-undo.
     2815    define variable v-qnty-bonus as decimal.
     2816       define variable v-doc-qnty as decimal no-undo.
     2817       define variable v-sum-withoutdisc as decimal no-undo.
     2818       define variable v-sum-withdisc as decimal no-undo.
     2819       define variable v-discount as decimal no-undo.
     2820       define variable v-gds-grp-name as character no-undo.
     2821       define variable v-cur-lvl as integer no-undo.
     2822       define variable v-upper-code as integer initial ? no-undo.
     2823       define variable v-first-of as logical no-undo.
     2824       define variable v-last-of as logical no-undo.
     2825       define variable v-cur-recid as recid no-undo.
     2826     define variable counter as integer.
     2827       define buffer buf1_dcards for dcards.
     2828       define buffer buf2_dcards for dcards.
     2829       define buffer bufobj_dcards for dcards.
     2830       define buffer bufobj2_dcards for dcards.
     2831       define buffer bufhl_dcards for dcards.
     2832       do while v-upper-code <> 0
     2833       :
     2834           v-upper-code = 0.
     2835           v-gds-grp-name = ''.
     2836           for each buf1_dcards where
     2837                    buf1_dcards.grp-lvl  = v-cur-lvl and
     2838                    buf1_dcards.obj-type = p-obj-type and
     2839                    buf1_dcards.obj-code = p-obj-code and
     2840                    buf1_dcards.d-card   = p-d-card
     2841           break
     2842               by buf1_dcards.grp-code
     2843           :
     2844               if first-of(buf1_dcards.grp-code) then
     2845               do:
     2846                   assign
     2847                       v-doc-qnty = 0
     2848                       v-sum-withdisc = 0
     2849                       v-qnty-bonus = 0
     2850                       counter = 0
     2851                   .
     2852                   find first ub.gds-grp where
     2853                              ub.gds-grp.node-code = buf1_dcards.grp-code
     2854                   no-lock no-error.
     2855                   if available ub.gds-grp then
     2856                   do:
     2857                       assign
     2858                           v-upper-code = ub.gds-grp.upper-code
     2859                           v-gds-grp-name = ub.gds-grp.node-name
     2860                       .
     2861                   end.
     2862               end.
     2863               buf1_dcards.upper-code = if buf1_dcards.grp-lvl = 0 then buf1_dcards.grp-code else v-upper-code.
     2864               if buf1_dcards.grp-lvl <> 0 then
     2865               do:
     2866                   assign
     2867                       buf1_dcards.gds-name = v-gds-grp-name
     2868                       buf1_dcards.artic = string(buf1_dcards.grp-code)
     2869                   .
     2870               end.
     2871               assign
     2872                   v-doc-qnty = v-doc-qnty + buf1_dcards.doc-qnty
     2873                   v-sum-withdisc = v-sum-withdisc + buf1_dcards.sum-withdisc
     2874                   v-qnty-bonus = v-qnty-bonus + buf1_dcards.qnty-bonus
     2875                   counter = counter +  buf1_dcards.counter
     2876               .
     2877               if last-of (buf1_dcards.grp-code) then
     2878               do:
     2879                   find first buf2_dcards where buf2_dcards.grp-code = (if buf1_dcards.grp-lvl = 0 then buf1_dcards.grp-code else v-upper-code)
     2880                                             and  buf2_dcards.grp-lvl > buf1_dcards.grp-lvl
     2881                                           and buf2_dcards.gds-code = 0
     2882                                             and  buf2_dcards.obj-type = p-obj-type
     2883                                             and  buf2_dcards.obj-code = p-obj-code
     2884                                             and buf2_dcards.d-card = p-d-card no-error.
     2885                   if not available buf2_dcards then do:
     2886                   create buf2_dcards.
     2887                   assign
     2888                       buf2_dcards.grp-code =
     2889                           (if buf1_dcards.grp-lvl = 0 then buf1_dcards.grp-code
     2890                            else v-upper-code)
     2891                      buf2_dcards.grp-lvl = buf1_dcards.grp-lvl + 1
     2892                       buf2_dcards.obj-type = p-obj-type
     2893                       buf2_dcards.obj-code = p-obj-code
     2894                       buf2_dcards.d-card = p-d-card
     2895                   .
     2896                   end.
     2897                   assign
     2898                                           buf2_dcards.counter = counter
     2899                       buf2_dcards.doc-qnty = buf2_dcards.doc-qnty + v-doc-qnty
     2900                       buf2_dcards.sum-withdisc = buf2_dcards.sum-withdisc + v-sum-withdisc
     2901                       buf2_dcards.discount = buf2_dcards.discount + v-discount
     2902                       buf2_dcards.qnty-bonus = buf2_dcards.qnty-bonus + v-qnty-bonus
     2903                       .
     2904               end.
     2905           end.
     2906           if v-upper-code = ? then v-upper-code = 0.
     2907           v-cur-lvl = v-cur-lvl + 1.
     2908       end.
     2909       for each  bufhl_dcards where  bufhl_dcards.grp-code <> 0  and
     2910            bufhl_dcards.d-card = p-d-card and  bufhl_dcards.gds-code = 0:
     2911           for each buf2_dcards where buf2_dcards.grp-code =  bufhl_dcards.grp-code and buf2_dcards.grp-lvl <>  bufhl_dcards.grp-lvl and     buf2_dcards.d-card = p-d-card and buf2_dcards.gds-code = 0 :
     2912               assign
     2913               bufhl_dcards.counter = buf2_dcards.counter + bufhl_dcards.counter
     2914                               bufhl_dcards.doc-qnty = buf2_dcards.doc-qnty +  bufhl_dcards.doc-qnty
     2915                       bufhl_dcards.sum-withdisc = buf2_dcards.sum-withdisc +  bufhl_dcards.sum-withdisc
     2916                       bufhl_dcards.discount = buf2_dcards.discount +  bufhl_dcards.discount
     2917                       bufhl_dcards.qnty-bonus = buf2_dcards.qnty-bonus +  bufhl_dcards.qnty-bonus
     2918                       .
     2919                          delete  buf2_dcards .
     2920           end.
     2921       end.
     2922   end procedure.
     2923   procedure my-watch-table:
     2924       define variable v-full-file-name as character no-undo.
     2925       define variable v-message as character no-undo.
     2926       define variable v-table-handle as handle no-undo.
     2927       define variable v-cnt-field as integer no-undo.
     2928       define variable v-list-field-name as character no-undo.
     2929       define variable v-list-field-label as character no-undo.
     2930       define variable v-list-field-type as character no-undo.
     2931       define buffer dcards for dcards.
     2932       v-table-handle = buffer dcards:handle.
     2933       v-cnt-field = v-table-handle:num-fields.
     2934       do v-ii = 1 to v-cnt-field:
     2935           v-list-field-name =
     2936               (if v-list-field-name <> "" then
     2937                  v-list-field-name + "$" + v-table-handle:buffer-field(v-ii):name
     2938               else
     2939                   v-table-handle:buffer-field(v-ii):name).
     2940           v-list-field-label =
     2941               (if v-list-field-label <> "" then
     2942                  v-list-field-label + "$" + v-table-handle:buffer-field(v-ii):label
     2943               else
     2944                   v-table-handle:buffer-field(v-ii):label).
     2945           v-list-field-type =
     2946               (if v-list-field-type <> "" then
     2947                  v-list-field-type + "$" + v-table-handle:buffer-field(v-ii):data-type
     2948               else
     2949                   v-table-handle:buffer-field(v-ii):data-type).
     2950       end.
     2951       v-full-file-name = "C:\work15_0\my-watch-dcards.txt".
     2952       if search(v-full-file-name) = ? then
     2953           do:
     2954               message "Не найден файл отчёта: " v-full-file-name view-as alert-box error.
     2955           end.
     2956       output stream MyWatch-strm to value(v-full-file-name)   convert target "utf-8".
     2957           put stream MyWatch-strm unformatted
     2958               today format "99.99.9999" " " string(time, "HH:MM") " " "Исследуемая таблица: " "dcards" "." skip
     2959               v-list-field-label skip
     2960               v-list-field-name skip
     2961               v-list-field-type skip
     2962           .
     2963           if not can-find(first dcards) then
     2964           do:
     2965               v-message = "Исследуемая таблица dcards пуста!".
     2966               put stream MyWatch-strm unformatted
     2967                   v-message
     2968               .
     2969               message "My-watch-table: " v-message view-as alert-box information.
     2970           end.
     2971               for each  dcards no-lock:
     2972                   export stream MyWatch-strm delimiter "$"  dcards.
     2973               end.
     2974       output stream MyWatch-strm close.
     2975   end procedure.
     2976   function fnc-convert-dot-to-colon returns character
     2977   (input p-data as decimal, input p-accur as character):
     2978       define variable result as character no-undo.
     2979       define variable v-str-result as character no-undo.
     2980       if p-data = ? then
     2981       do:
     2982           v-str-result = "?".
     2983       end.
     2984       else
     2985       do:
     2986           p-data = round(p-data, 2).
     2987           v-str-result = trim(replace(string(p-data, p-accur), ".", ",")).
     2988       end.
     2989       return v-str-result.
     2990   end function.
     2991   function fnc-DD-MM-YYYY returns character
     2992   (input p-dat-date as date):
     2993       define variable result as character no-undo.
     2994       define variable p-str-date as character no-undo.
     2995       p-str-date = replace(string(p-dat-date,'99.99.9999'), "/", ".").
     2996           return p-str-date.
     2997   end function.
