     1946     END PROCEDURE.
     1947   PROCEDURE adm-copy-record :
     1948       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     1949        "must have at least one Enabled Table to perform Copy.":U
     1950          VIEW-AS ALERT-BOX ERROR.
     1951       RETURN.
     1952   END PROCEDURE.
     1953   PROCEDURE adm-create-record :
     1954      RETURN.
     1955   END PROCEDURE.
     1956   PROCEDURE adm-current-changed :
     1957     RETURN.
     1958   END PROCEDURE.
     1959   PROCEDURE adm-delete-record :
     1960    MESSAGE
     1961          "Object ":U THIS-PROCEDURE:FILE-NAME
     1962            "must have at least one Enabled Table to perform Delete.":U
     1963              VIEW-AS ALERT-BOX ERROR.
     1964       RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
     1965       RETURN.
