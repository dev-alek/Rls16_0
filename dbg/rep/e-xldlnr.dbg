     1608   procedure lhistprex-print-dc-list-hist-excel :
     1609   define input parameter p-text  as logical no-undo .
     1610   define input parameter p-excel as logical no-undo .
     1611   define input parameter p-sheet-num as integer no-undo .
     1612   define buffer buf_lh-sheetf for sheetf.
     1613   define buffer buf_dc-list-hist for dc-list-hist.
     1614     do
     1615     on error undo, return error
     1616     :
     1617       find first buf_dc-list-hist no-lock where buf_dc-list-hist.id = 0 no-error .
     1618       if p-excel then do:
     1619         if   Make-Excel Then  do:   Output stream ForExcel close.   assign   number-list = number-list + 1   .   os-delete value( v-excel-file + ".":U + string(number-list)).   Output Stream ForExcel to value( v-excel-file + ".":U + string(number-list ) ) . end.
     1620         FInd first buf_lh-Sheetf where
     1621                   buf_lh-Sheetf.sheet-num = p-sheet-num No-ERROR.
     1622         if not avail buf_lh-sheetf then
     1623         create buf_lh-sheetf.
     1624         assign
     1625         buf_lh-Sheetf.Sheet-num = 2
     1626         buf_lh-sheetf.Excel-Column-Lable =  "№ п/п,Действие,Записей,итого,Множество"
     1627         buf_lh-sheetf.sizes = "9,9,9,12,155"
     1628         .
     1629         run rep/extitlee.p (input p-sheet-num
     1630                       , input  substitute("История создания списка &1 &2"
     1631                                   ,
     1632   ''
     1633                                   ,(if available buf_dc-list-hist
     1634                                   then buf_dc-list-hist.des
     1635                                   else "БЕЗЫМЯННЫЙ"))
     1636                       ) .
     1637       end.
     1638       if p-text then do:
     1639         Page stream PrnLibStream.
     1640         PUT  STREAM PrnLibStream unformatted
     1641         SPACE(25) substitute("История создания списка &1 &2"
     1642                             , ''
     1643                             ,(if available buf_dc-list-hist
     1644                             then buf_dc-list-hist.des
     1645                             else "БЕЗЫМЯННЫЙ")) skip(0)
     1646         space(25) cur-time-print() skip(1)
     1647         .
     1648         put stream PrnLibStream unformatted
     1649         string("№", "X(9)") chr(32)
     1650         string("Действие", "X(9)") chr(32)
     1651         string("записей", "X(9)") chr(32)
     1652         string(" = итого", "X(12)") chr(32)
     1653         (if page-size(PrnLibStream) > 43
     1654         then string("Множество", "X(" + string(136 - 43) + ")")
     1655         else string("Множество", "X(" + string(198 - 43) + ")")
     1656         )
     1657         skip(0)
     1658         fill('-':U, 9) chr(32)
     1659         fill('-':U, 9) chr(32)
     1660         fill('-':U, 9) chr(32)
     1661         fill('-':U, 12) chr(32)
     1662         (if page-size(PrnLibStream) > 43
     1663         then fill('-':U, 136 - 43)
     1664         else fill('-':U, 198 - 43))
     1665         skip(0)
     1666         .
     1667       end.
     1668       for each buf_dc-list-hist where buf_dc-list-hist.id > 0
     1669       by buf_dc-list-hist.id
     1670       :
     1671         if p-text then do:
     1672           put stream PrnLibStream unformatted
     1673           (if buf_dc-list-hist.line = 0
     1674           then string(buf_dc-list-hist.id, ">>>>>>>>9")
     1675           else fill(chr(32) , 9)
     1676           )  chr(32)
     1677           (if buf_dc-list-hist.item_ <> '':U
     1678           then string(buf_dc-list-hist.hist-mode, "X(8)")
     1679           else fill( chr(32), 8)) chr(32)
     1680           string(buf_dc-list-hist.num-add, ">>>>>>>>9") chr(32) chr(32) chr(32) chr(32)
     1681           string(buf_dc-list-hist.num-recs, ">>>>>>>>9")  chr(32)
     1682           (if page-size(PrnLibStream) > 43
     1683           then string(buf_dc-list-hist.des, "X(" + string(136 - 43) + ")")
     1684           else string(buf_dc-list-hist.des, "X(" + string(198 - 43) + ")"))
     1685           skip.
     1686         end.
     1687         if p-excel then do:
     1688           if Make-Excel then  put   stream ForExcel unformatted
     1689           (if buf_dc-list-hist.line = 0
     1690           then string(buf_dc-list-hist.id, ">>>>>>>>9")
     1691           else '':U)
     1692           CHR(9)
     1693           (if buf_dc-list-hist.item_ <> '':U
     1694           then buf_dc-list-hist.hist-mode
     1695           else '':U)  CHR(9)
     1696           (if buf_dc-list-hist.item_ <> '':U
     1697           then string(buf_dc-list-hist.num-add, "->>>>>>>>9")
     1698           else '':U)  CHR(9)
     1699           (if buf_dc-list-hist.item_ <> '':U
     1700           then string(buf_dc-list-hist.num-recs, ">>>>>>>>9")
     1701           else '':U)  CHR(9)
     1702           buf_dc-list-hist.des
     1703           skip.
     1704         end.
     1705       end.
     1706     end.
     1707   end procedure.
     1708   CREATE WIDGET-POOL.
     1709   define variable parparentproc as widget-handle no-undo.
     1710   define variable loc-ref-list as character no-undo.
     1711   define variable doc-list as character no-undo.
     1712   define variable ii as integer no-undo.
     1713   DEFINE VARIABLE cb-disType AS CHARACTER FORMAT "X(256)":U INITIAL "1"
     1714        LABEL "Тип скидки"
     1715        VIEW-AS COMBO-BOX INNER-LINES 5
     1716        LIST-ITEM-PAIRS "ЛНР","1",
     1717                        "Оплата бонусами","2"
     1718        DROP-DOWN-LIST
     1719        SIZE 16 BY 1 NO-UNDO.
     1720   DEFINE VARIABLE v-rs-det AS CHARACTER
     1721        VIEW-AS RADIO-SET VERTICAL
     1722        RADIO-BUTTONS
     1723             "Товар", "good":U,
     1724   "По типам товаров (Топливо\СТ\Услуги)", "goodtype":U
     1725        SIZE 39.4 BY 2.52 NO-UNDO.
     1726   DEFINE VARIABLE v-rs-klass AS CHARACTER
     1727        VIEW-AS RADIO-SET VERTICAL
     1728        RADIO-BUTTONS
     1729             "Объект", "object":U,
     1730   "Дата", "date":U,
     1731   "Номер карты", "card":U
     1732        SIZE 20 BY 3.81 NO-UNDO.
     1733   DEFINE RECTANGLE RECT-3
     1734        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1735        SIZE 42.8 BY 4.52.
     1736   DEFINE RECTANGLE RECT-4
     1737        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1738        SIZE 42.8 BY 3.05.
     1739   DEFINE FRAME F-Main
     1740        cb-disType AT ROW 1.29 COL 14.6 COLON-ALIGNED WIDGET-ID 2
     1741        v-rs-klass AT ROW 4.33 COL 3.6 NO-LABEL
     1742        v-rs-det AT ROW 9.33 COL 3.6 NO-LABEL
     1743        " Классификация" VIEW-AS TEXT
     1744             SIZE 15.4 BY .81 AT ROW 3.48 COL 3.6
     1745             FGCOLOR 4
     1746        " Детализация" VIEW-AS TEXT
     1747             SIZE 13.4 BY .81 AT ROW 8.48 COL 3.6
     1748             FGCOLOR 4
     1749        RECT-3 AT ROW 3.86 COL 1.2
     1750        RECT-4 AT ROW 8.91 COL 1.2
     1751       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
     1752            SIDE-LABELS NO-UNDERLINE THREE-D
     1753            AT COL 1 ROW 1 SCROLLABLE .
     1754   IF NOT THIS-PROCEDURE:PERSISTENT THEN DO:
     1755     MESSAGE "c:\tester\Rls_16_0\rc_160_rus\cmpdir\src\rep\e-xldlnr.w should only be RUN PERSISTENT.":U
     1756             VIEW-AS ALERT-BOX ERROR BUTTONS OK.
     1757     RETURN.
     1758   END.
     1759   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
     1760   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
     1761   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
     1762   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
     1763   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
     1764   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
     1765   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
     1766   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
     1767         adm-object-hdl = FRAME F-Main:HANDLE.
     1768   RUN ensure-broker.
     1769   THIS-PROCEDURE:ADM-DATA =
     1770        'ADM1.1~`':U +
     1771        'SmartViewer~`':U +
     1772        '~`':U +
     1773        'NO ~`':U +
     1774        '~`':U +
     1775        '~`':U +
     1776        '~`':U +
     1777        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
     1778           + "~`":U +
     1779        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add~`':U +
     1780        'Record-Source,Record-Target,TableIO-Target~`':U +
     1781        '~`':U +
     1782        '~`~`~`~`~`~`~`~`~`~`~`':U +
     1783        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
     1784            THEN "^^":U
     1785        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
     1786             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
     1787   PROCEDURE adm-apply-entry :
     1788     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1789   END PROCEDURE.
     1790   PROCEDURE adm-destroy :
     1791    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1792   END PROCEDURE.
     1793   PROCEDURE adm-disable :
     1794       DISABLE RECT-3 RECT-4 cb-disType v-rs-klass v-rs-det WITH FRAME F-Main.
     1795       RUN dispatch ('disable-fields':U).
     1796       RUN set-attribute-list ('ENABLED=no':U).
     1797       RETURN.
     1798   END PROCEDURE.
     1799   PROCEDURE adm-edit-attribute-list :
     1800         RUN adm/support/viewerd.w (INPUT THIS-PROCEDURE).
     1801         RETURN.
     1802   END PROCEDURE.
     1803   PROCEDURE adm-enable :
     1804       ENABLE UNLESS-HIDDEN RECT-3 RECT-4 cb-disType v-rs-klass v-rs-det WITH FRAME F-Main.
     1805       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
     1806       RUN set-attribute-list ('ENABLED=yes':U).
     1807       RETURN.
     1808   END PROCEDURE.
     1809   PROCEDURE adm-exit :
     1810        RUN notify ('exit':U).
     1811     RETURN.
     1812   END PROCEDURE.
     1813   PROCEDURE adm-hide :
     1814     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1815   END PROCEDURE.
     1816   PROCEDURE adm-initialize :
     1817     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1818   END PROCEDURE.
     1819   PROCEDURE adm-show-errors :
     1820       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
     1821       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
     1822           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
     1823       END.
     1824       RETURN.
     1825   END PROCEDURE.
     1826   PROCEDURE adm-UIB-mode :
     1827     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1828   END PROCEDURE.
     1829   PROCEDURE adm-view :
     1830     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1831   END PROCEDURE.
     1832   PROCEDURE dispatch :
     1833       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
     1834       RUN broker-dispatch IN adm-broker-hdl
     1835           (THIS-PROCEDURE, p-method-name) NO-ERROR.
     1836       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
     1837   END PROCEDURE.
     1838   PROCEDURE ensure-broker :
     1839   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
     1840   IF RETURN-VALUE NE "ADM-Broker":U THEN
     1841   DO:
     1842       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
     1843       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
     1844   END.
     1845   END PROCEDURE.
     1846   PROCEDURE get-attribute :
     1847     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
     1848     RUN broker-get-attribute IN adm-broker-hdl
     1849         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
     1850     RETURN RETURN-VALUE.
     1851   END PROCEDURE.
     1852   PROCEDURE get-attribute-list :
     1853     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
     1854     RUN broker-get-attribute-list IN adm-broker-hdl
     1855         (INPUT THIS-PROCEDURE,
     1856          INPUT ?,
     1857          OUTPUT p-attr-list) NO-ERROR.
     1858     RETURN.
     1859   END PROCEDURE.
     1860   PROCEDURE new-state :
     1861     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     1862     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
     1863     RETURN.
     1864   END PROCEDURE.
     1865   PROCEDURE notify :
     1866     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
     1867     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
     1868     IF RETURN-VALUE = "ADM-ERROR":U THEN
     1869         RETURN "ADM-ERROR":U.
     1870     RETURN.
     1871   END PROCEDURE.
     1872   PROCEDURE set-attribute-list :
     1873     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
     1874     RUN ensure-broker.
     1875     RUN broker-set-attribute-list IN adm-broker-hdl
     1876         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
     1877     RETURN.
     1878   END PROCEDURE.
     1879   PROCEDURE set-position :
     1880       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
     1881       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
     1882       IF VALID-HANDLE(adm-object-hdl) THEN
     1883       DO:
     1884         ASSIGN adm-object-hdl:ROW    =   p-row
     1885                adm-object-hdl:COLUMN =   p-col.
     1886       END.
     1887       RETURN.
     1888   END PROCEDURE.
     1889   PROCEDURE adm-display-fields :
     1890       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
     1891       RETURN.
     1892   END PROCEDURE.
     1893   PROCEDURE adm-open-query :
     1894     RETURN.
     1895   END PROCEDURE.
     1896   PROCEDURE adm-row-changed :
     1897         IF VALID-HANDLE(adm-object-hdl) THEN
     1898           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     1899         RUN notify ('row-available':U).
     1900         RETURN.
     1901   END PROCEDURE.
     1902   PROCEDURE reposition-query :
     1903       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
     1904       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
     1905       RETURN.
     1906   END PROCEDURE.
     1907     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
     1908     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
     1909     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
     1910     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
     1911     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
     1912     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
     1913     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
     1914     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
     1915     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1916     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
     1917     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1918     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
     1919     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
     1920     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
     1921     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
     1922     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
     1923     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
     1924     IF "":U = "":U THEN
     1925       RUN modify-list-attribute IN adm-broker-hdl
     1926         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
     1927     RUN use-create-on-add(?).
     1928   PROCEDURE adm-add-record :
     1929       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     1930          "must have at least one Enabled Table to perform Add.":U
     1931          VIEW-AS ALERT-BOX ERROR.
     1932       RETURN.
     1933   END PROCEDURE.
     1934   PROCEDURE adm-assign-record :
