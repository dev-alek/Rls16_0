     1131   procedure prn-lib-prn-file :
     1132     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1133     define input parameter p-DIsabledoptions as integer no-undo .
     1134     define variable v-report-name as character no-undo .
     1135     define variable v-user-action as character no-undo .
     1136     define variable v-printed     as logical   no-undo .
     1137     define variable v-exist       as logical   no-undo .
