     1973   END PROCEDURE.
     1974   PROCEDURE adm-end-update :
     1975     RETURN.
     1976   END PROCEDURE.
     1977   PROCEDURE adm-reset-record :
     1978       RETURN.
     1979   END PROCEDURE.
     1980   PROCEDURE adm-update-record :
     1981       MESSAGE
     1982         "Object ":U THIS-PROCEDURE:FILE-NAME
     1983           "must have at least one Enabled Table to perform Update.":U
     1984             VIEW-AS ALERT-BOX ERROR.
     1985      RETURN.
     1986   END PROCEDURE.
     1987   PROCEDURE check-modified :
     1988   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
     1989   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
     1990   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
     1991   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
     1992     IF check-state = "check":U THEN
     1993     DO:
     1994       RUN get-link-handle IN adm-broker-hdl
     1995         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
     1996            OUTPUT group-target-list).
     1997       IF group-target-list NE "":U THEN
     1998       DO i = 1 TO NUM-ENTRIES(group-target-list):
     1999         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
     2000         RUN check-modified IN curr-widget ('group-check':U).
     2001         IF RETURN-VALUE NE "":U THEN
     2002         DO:
     2003           RUN check-modified-message(RETURN-VALUE).
     2004           RETURN "":U.
     2005         END.
     2006       END.
     2007     END.
     2008     RETURN "":U.
     2009   END PROCEDURE.
     2010   PROCEDURE check-modified-message :
     2011     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
     2012        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
     2013           'CONTAINER-SOURCE':U, 'HIDDEN':U).
     2014        IF RETURN-VALUE = "YES":U THEN
     2015           RUN notify ('view,CONTAINER-SOURCE':U).
     2016        MESSAGE IF p-changed-table NE ? THEN
     2017           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
     2018           ELSE "Current values have been changed."
     2019           SKIP "  Do you wish to save those changes?"
     2020           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
     2021        IF ANS THEN
     2022        DO:
     2023           IF group-assign-target THEN
     2024             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
     2025           ELSE RUN dispatch('update-record':U).
     2026           IF RETURN-VALUE = "ADM-ERROR":U THEN
     2027           DO:
     2028               MESSAGE "Changes to the previous record were not saved."
     2029                 VIEW-AS ALERT-BOX ERROR.
     2030               IF group-assign-target THEN
     2031                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     2032               ELSE RUN dispatch ('cancel-record':U).
     2033           END.
     2034        END.
     2035        ELSE DO:
     2036          IF group-assign-target THEN
     2037             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     2038          ELSE RUN dispatch('cancel-record':U).
     2039        END.
     2040        RETURN.
     2041   END PROCEDURE.
     2042   PROCEDURE get-rowid :
     2043       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
     2044       ASSIGN
     2045       p-table   =   adm-first-table.
     2046       RETURN.
     2047   END PROCEDURE.
     2048   PROCEDURE init-group-assign :
     2049       RUN request-attribute IN adm-broker-hdl
     2050         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
     2051       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
     2052         group-assign-target = yes.
     2053       ELSE group-assign-target = no.
     2054       RETURN.
     2055   END PROCEDURE.
     2056   PROCEDURE set-editors :
     2057       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
     2058       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
     2059       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
     2060       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
     2061       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
     2062       DO WHILE VALID-HANDLE (curr-widget):
     2063           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
     2064              curr-widget:HIDDEN = no THEN DO:
     2065             CASE p-field-setting:
     2066               WHEN "INITIALIZE":U THEN
     2067               DO:
     2068                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
     2069                     read-only-list +
     2070                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
     2071                        STRING(curr-widget).
     2072               END.
     2073               WHEN "DISABLE":U OR
     2074               WHEN "ENABLE":U THEN
     2075               DO:
     2076                   curr-widget:SENSITIVE = yes.
     2077                   RUN get-attribute ('Read-Only-Editors':U).
     2078                   IF RETURN-VALUE = ? OR
     2079                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
     2080                       curr-widget:READ-ONLY =
     2081                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
     2082               END.
     2083               WHEN "CLEAR":U THEN
     2084                   curr-widget:SCREEN-VALUE = "":U.
     2085             END CASE.
     2086           END.
     2087           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
     2088       END.
     2089       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
     2090         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
     2091           + '"':U).
     2092       RETURN.
     2093   END PROCEDURE.
     2094   PROCEDURE use-check-modified-all :
     2095    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     2096     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
     2097     RETURN.
     2098   END PROCEDURE.
     2099   PROCEDURE use-create-on-add :
     2100   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     2101      RETURN.
     2102   END PROCEDURE.
     2103   PROCEDURE use-initial-lock :
     2104     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     2105     ASSIGN adm-initial-lock = p-attr-value.
     2106     RETURN.
     2107   END PROCEDURE.
     2108     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
     2109   ASSIGN
     2110          FRAME F-Main:SCROLLABLE       = FALSE
     2111          FRAME F-Main:HIDDEN           = TRUE.
     2112     parparentproc = my-handle.
     2113   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2114     run mainmenu_getcntxt in parparentproc
     2115       (output v-cntxt-db-num
     2116       ,output v-cntxt-userid
     2117       ,output v-cntxt-level
     2118       ,output v-cntxt-host-code-obj
     2119       ,output v-cntxt-obj-type
     2120       ,output v-cntxt-obj-code
     2121       ,output v-cntxt-db-num-obj
     2122       ,output v-cntxt-is-admin
     2123       ) .
     2124   PROCEDURE disable_UI :
     2125     HIDE FRAME F-Main.
     2126     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     2127   END PROCEDURE.
     2128   PROCEDURE local-apply-layout :
     2129     RUN dispatch IN THIS-PROCEDURE ( INPUT 'apply-layout':U ) .
     2130   END PROCEDURE.
     2131   PROCEDURE local-initialize :
     2132   define variable v-list as character no-undo.
     2133       define variable v-tmp as character no-undo.
     2134       RUN dispatch IN THIS-PROCEDURE ( INPUT 'initialize':U ) .
     2135       cb-disType:screen-value in frame F-Main = '1'.
     2136   END PROCEDURE.
     2137   PROCEDURE my-report :
     2138       run rep/r-xldlnr.p(input cb-disType, input v-rs-klass, input v-rs-det).
     2139   end procedure.
     2140   PROCEDURE my-var :
     2141       assign frame F-Main
     2142           cb-disType
     2143           v-rs-klass
     2144           v-rs-det
     2145       .
     2146   END PROCEDURE.
     2147   PROCEDURE state-changed :
     2148     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE    NO-UNDO.
     2149     DEFINE INPUT PARAMETER p-state      AS CHARACTER NO-UNDO.
     2150     CASE p-state:
     2151     END CASE.
     2152     END PROCEDURE.
