     1274   procedure prn-lib-reportviewer :
     1275     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1276     define input parameter p-report-name-html as character no-undo .
     1277     define input parameter p-param        as character no-undo .
     1278     define variable v-excel           as character no-undo init 'TRUE' .
     1279     define variable v-value-character as character no-undo .
     1280     define variable v-value-integer   as character no-undo .
     1281     define variable v-value-date      as date      no-undo .
     1282     define variable v-value-decimal   as decimal   no-undo .
     1283     define variable rep-excel         as logical   no-undo .
     1284     define variable excel-string      as character no-undo .
     1285     define variable v-param-type      as character no-undo .
     1286     define variable v-tth             as handle    no-undo .
     1287     run adm/shattri.p (
     1288       input "get":U
     1289       ,input  ""
     1290       ,input  0
     1291       ,input  'report-glob':U
     1292       ,input  'rep-excel':U
     1293       ,output v-value-character
     1294       ,output v-value-date
     1295       ,output v-value-decimal
     1296       ,output v-value-integer
     1297       ,output rep-excel
     1298       ,output v-param-type
     1299       ,INPUT-OUTPUT table-handle v-tth
     1300       )  .
     1301     if rep-excel then v-excel = "TRUE" .
     1302     else v-excel = "FALSE" .
     1303     if p-param eq ""
     1304     then
     1305        p-param = "EXCEL:" + v-excel.
     1306     else
     1307        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
     1308     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
     1309   end procedure.
     1310   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1311   define variable v-waitfram-action01         as character   no-undo .
     1312   define variable v-waitfram-action02         as character   no-undo .
     1313   define variable v-waitfram-action03         as character   no-undo .
     1314   define variable mWaitFramTextBeg            as character   no-undo.
     1315   define variable mWaitFramTextEnd            as character   no-undo.
     1316   define variable mWaitFramView               as logical     no-undo.
     1317   define variable mWaitProcEvent              as logical     no-undo init yes.
     1318   define variable mWaitFramInterval           as integer     no-undo init 1 .
     1319   define variable mWaitFramStop               as logical     no-undo.
     1320   define variable mWaitFramStopUser           as logical     no-undo.
     1321   define variable mWaitFramStopTimeOut        as logical     no-undo.
     1322   define variable mWaitFramStartProc          as datetime-tz no-undo.
     1323   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     1324   define button B-WaitFramStop auto-end-key
     1325        label "Стоп"
     1326        size 10 by 1 tooltip "Остоновить процесс".
     1327   define button B-viewProcInfo
     1328        label "Информация"
     1329        size 15 by 1 tooltip "Информация о процесс".
     1330   define frame waitfram
     1331     v-waitfram-action01 format "x(72)" no-label skip
     1332     v-waitfram-action02 format "x(72)" no-label skip
     1333     v-waitfram-action03 format "x(72)" no-label skip
     1334     B-viewProcInfo
     1335     B-WaitFramStop at row 4 col 30
     1336     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1337     .
     1338   define new global shared variable mBatchMode as logical no-undo init ?.
     1339   define variable mFramBachModHandle as handle no-undo.
     1340   mFramBachModHandle = frame waitfram:handle.
     1341   define variable mFameOldVis as logical no-undo.
     1342   define variable mVisCUrentVin as logical no-undo.
     1343   if session:batch-mode
     1344   then
     1345      mBatchMode = yes.
     1346   if mBatchMode = ? then do:
     1347     mVisCUrentVin = current-window:visible.
     1348     mFameOldVis = mFramBachModHandle:visible.
     1349     mFramBachModHandle:visible  = yes.
     1350     mBatchMode = mFramBachModHandle:visible ne yes.
     1351     mFramBachModHandle:visible = mFameOldVis.
     1352     current-window:visible = mVisCUrentVin.
     1353   end.
     1354    if  log-manager:logfile-name ne ?
     1355     then DO:
     1356         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1357         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1358         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1359     end.
     1360   on choose of B-WaitFramStop in frame waitfram
     1361   do:
     1362     mWaitFramStop = yes.
     1363     mWaitFramStopUser = yes.
     1364   end.
     1365   function waitfram-check-timeout returns logical():
     1366      define variable vtime as int64 no-undo.
     1367      if mWaitFramStopTimeOut
     1368      then
     1369         return yes.
     1370      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1371      if     mWaitFramTimeOut ne ?
     1372         and mWaitFramTimeOut ne 0
     1373         and mWaitFramTimeOut lt vtime
     1374      then do:
     1375         mWaitFramStopTimeOut = yes.
     1376      end.
     1377      return mWaitFramStopTimeOut.
     1378   end.
     1379   procedure waitfram-hide :
     1380     if not session:batch-mode
     1381     then do
     1382     on error undo, return error return-value
     1383     :
     1384       pause 0 before-hide .
     1385       if not mBatchMode then
     1386         hide frame waitfram .
     1387     if     not mWaitFramView
     1388        and mWaitProcEvent
     1389     then
     1390       process events .
     1391     end.
     1392   end procedure.
     1393   procedure waitfram-show :
     1394     define input  parameter p-message as character no-undo .
     1395     define variable v-left-margin as integer   no-undo .
     1396     if not session:batch-mode
     1397     then do
     1398     on error undo, return error return-value
     1399     :
     1400       if length(p-message) <= 70 then do:
     1401         assign
     1402           v-left-margin = integer((70 - length(p-message)) / 2)
     1403         .
     1404         assign
     1405           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1406         .
     1407         assign
     1408           v-waitfram-action01 = " "
     1409           v-waitfram-action02 = " "
     1410                                    + fill(" ", v-left-margin)
     1411                                    + p-message
     1412           v-waitfram-action03 = " "
     1413         .
     1414       end.
     1415       else do:
     1416         define variable vRindex1 as integer no-undo.
     1417         define variable vRindex2 as integer no-undo.
     1418         vRindex1 = r-index(p-message," ",70).
     1419         if vRindex1 = 0
     1420         then
     1421            vRindex1 = 70.
     1422         if length(p-message)  <= vRindex1 + 70 then do:
     1423           assign
     1424             v-waitfram-action01 = " "
     1425             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1426             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1427           .
     1428         end.
     1429         else do:
     1430           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1431           if vRindex2 <= vRindex1
     1432           then
     1433              vRindex2 = vRindex1 + 70.
     1434           assign
     1435             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1436             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1437             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1438           .
     1439         end.
     1440       end.
     1441       B-viewProcInfo:visible   in frame waitfram = no.
     1442       B-viewProcInfo:sensitive in frame waitfram = no.
     1443       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1444       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1445       if  (   mWaitFramView
     1446          or  mWaitProcEvent)
     1447          and not mBatchMode
     1448       then
     1449          display
     1450             v-waitfram-action01 skip
     1451             v-waitfram-action02 skip
     1452             v-waitfram-action03 skip
     1453          with frame waitfram .
     1454       if     mWaitFramView
     1455          then do:
     1456             if     mWaitFramInterval ne ?
     1457                and not mBatchMode
     1458             then
     1459                wait-for go of frame waitfram pause mWaitFramInterval.
     1460          end.
     1461          else
     1462             if     mWaitProcEvent
     1463                and not mBatchMode
     1464             then
     1465                process events .
     1466     end.
     1467   end procedure.
     1468      procedure waitfram-show-this:
     1469         define input  parameter iInterval as int64 no-undo.
     1470         define variable vtime as int64 no-undo.
     1471         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1472         mWaitFramInterval = iInterval.
     1473         run waitfram-show (substitute("&1&2 &3&4" ,
     1474                                       mWaitFramTextBeg ,
     1475                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1476                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1477                                       mWaitFramTextEnd
     1478                                      )
     1479                           ).
     1480      end.
     1481      procedure WaitFramRunPause:
     1482         define input  parameter iInterval as dec no-undo.
     1483         define variable vStart  as datetime-tz no-undo.
     1484         define variable vend    as datetime-tz no-undo.
     1485         define variable vint as int64 no-undo.
     1486         define variable vOk as logical no-undo.
     1487         vStart = now.
     1488         vend   = vStart.
     1489         publish "WaitFramPause" (iInterval,output vOk).
     1490         vend   =  now.
     1491         vint = vend - vStart.
     1492         vint = iInterval - vint / 1000.
     1493         if     not mWaitFramStop
     1494            and (   vint > 0
     1495                 or (    not vOk
     1496                     and iInterval eq ?
     1497                     )
     1498                 )
     1499         then
     1500            run waitfram-show-this (iInterval).
     1501         vend   =  now.
     1502         vint = vend - vStart.
     1503         vint = iInterval - vint / 1000.
     1504         if     not mWaitFramStop
     1505            and vint > 0
     1506         then do:
     1507            run gbl/pause.p (vint * 1000).
     1508         end.
     1509         if iInterval ne ?
     1510         then
     1511            publish "WaitFramStop".
     1512         waitfram-check-timeout().
     1513      end.
     1514      procedure WaitFramWaitFor:
     1515         define input  parameter iInterval as dec no-undo.
     1516         assign
     1517            mWaitFramStartProc   = now
     1518            mWaitFramStopUser    = no
     1519            mWaitFramStopTimeOut = no
     1520         .
     1521         block-wait:
     1522         do while not mWaitFramStop:
     1523            run WaitFramRunPause (iInterval).
     1524            if  waitfram-check-timeout()
     1525            then do:
     1526               leave block-wait.
     1527            end.
     1528         end.
     1529         run waitfram-hide.
     1530      end.
     1531   procedure waitfram-join :
     1532     define input  parameter p-line-1  as character no-undo .
     1533     define input  parameter p-line-2  as character no-undo .
     1534     define input  parameter p-line-3  as character no-undo .
     1535     define output parameter p-message as character no-undo .
     1536     do
     1537     on error undo, return error return-value
     1538     :
     1539       assign
     1540         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1541                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1542                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1543       .
     1544     end.
     1545   end procedure.
     1546   function waitfram-join-function returns character
     1547     (input p-line-1 as character
     1548     ,input p-line-2 as character
     1549     ,input p-line-3 as character
     1550     ).
     1551     define variable v-message as character no-undo .
     1552     run waitfram-join in this-procedure
     1553       (input  p-line-1
     1554       ,input  p-line-2
     1555       ,input  p-line-3
     1556       ,output v-message
     1557       ) .
     1558     return v-message .
     1559   end function .
