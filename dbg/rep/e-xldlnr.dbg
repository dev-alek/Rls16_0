     1269   procedure prn-lib-reportviewer-report-name :
     1270     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1271     define input parameter p-report-name-html as character no-undo .
     1272     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
