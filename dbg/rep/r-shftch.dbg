      260   DEFINE INPUT PARAMETER pout-name as character no-undo.
      261   DEFINE INPUT PARAMETER pis-pay as logical no-undo.
      262   DEFINE INPUT PARAMETER pii as integer no-undo.
      263   _main:
      264   DO ON ERROR UNDO _main, return error:
      265       create treal-2.
      266       assign
      267       treal-2.gds-code = pgds-code
      268       treal-2.cpay-code = pcpay-code
      269       treal-2.curr-code = pcurr-code
      270       treal-2.qnty1  =  pqnty1
