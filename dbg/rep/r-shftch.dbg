      337     function valid-density returns logical ( input p-density as decimal, input p-unit-base-cli-eq as logical ) :
      338       define variable v-answ as logical no-undo .
      339       if ( p-unit-base-cli-eq = true
      340            and p-density = 1.0
      341          )
      342         or ( p-unit-base-cli-eq = false
      343              and p-density <> ?
      344              and p-density > 0.0
      345              and p-density < 1.0
      346            )
      347       then do:
      348         assign
      349           v-answ = true
      350         .
      351       end.
      352       else do:
      353         assign
      354           v-answ = false
      355         .
      356       end.
      357       return v-answ.
      358     end function.
