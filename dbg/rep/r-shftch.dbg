      487       assign
      488       cp-treal-8.gds-code = pgds-code
      489       cp-treal-8.cpay-code = pcpay-code
      490       cp-treal-8.curr-code = pcurr-code
      491       cp-treal-8.qnty1  =  pqnty1
      492       cp-treal-8.netto = pnetto
      493       cp-treal-8.cli-type = p-cli-type
      494       cp-treal-8.cli-code = p-cli-code
      495       no-error
      496       .
      497       if error-status:error then undo _main, return error.
      498   END.
      499   END PROCEDURE.
      500   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      501   PROCEDURE create-cli-treal-8.
      502   DEFINE INPUT PARAMETER pgds-code like ub.goods.gds-code no-undo.
      503   DEFINE INPUT PARAMETER pcpay-code like ub.cash-pay.cdpay-code no-undo.
      504   DEFINE INPUT PARAMETER pcurr-code like ub.cash-pay.curr-code no-undo.
      505   define input parameter p-cli-type as character no-undo .
      506   define input parameter p-cli-code as integer no-undo .
      507   DEFINE INPUT PARAMETER pqnty1 as decimal no-undo.
      508   DEFINE INPUT PARAMETER pnetto as decimal no-undo.
      509   _main:
      510   DO ON ERROR UNDO _main, return error:
      511       create cli-treal-8.
      512       assign
      513       cli-treal-8.gds-code = pgds-code
      514       cli-treal-8.cpay-code = pcpay-code
      515       cli-treal-8.curr-code = pcurr-code
      516       cli-treal-8.qnty1  =  pqnty1
      517       cli-treal-8.netto = pnetto
      518       cli-treal-8.cli-type = p-cli-type
      519       cli-treal-8.cli-code = p-cli-code
      520       no-error
      521       .
      522       if error-status:error then undo _main, return error.
      523   END.
      524   END PROCEDURE.
      525   define variable v-curr-r-b as character no-undo .
      526   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      527   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      528     (output v-curr-r-b
      529     )  .
      530   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      531   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      532     (input  pobj-type
      533     ,input  pobj-code
      534     ,output v-host-code
      535     )  .
      536   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      537   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
      538     (input  v-host-code
      539     ,output v-base-code
      540     )  .
      541   if v-curr-r-b = 'base':U or
      542   v-base-code = 0 then pychk_NO-exch = yes.
      543   else pychk_No-exch = no.
      544   if v-curr-r-b = 'rubl':U or
      545   v-base-code = 0 then pychk_NO-exch-rubl = yes.
      546   else pychk_No-exch-rubl = no.
      547   if pclassify then do:
      548     FIND FIRST t-3 where t-3.grp-code = 0 No-ERROR.
      549   end.
      550   assign
      551   pychk_classify = pclassify
      552   pychk_selectgood = pselectgood
      553   pychk_sheet2 = sheet2
      554   pychk_sheet3 = sheet3
      555   pychk_sheet4 = sheet4
      556   pychk_sheet8 = sheet8
      557   .
      558   for each temp-chk-gds:
      559     delete temp-chk-gds.
      560   end.
      561   _chk-doc:
      562   FOR EACH ub.chk-doc No-LOCK WHERE
      563            ub.chk-doc.obj-type = pobj-type AND
      564            ub.chk-doc.obj-code = pobj-code AND
      565            ub.chk-doc.shift-date >= pshift-date AND
      566            ub.chk-doc.shift-date <= pshift-date1 AND
      567        ub.chk-doc.out-code <> ?,
      568      EACH ub.chk-pay NO-LOCK WHERE
      569             ub.chk-pay.doc-code = ub.chk-doc.doc-code
      570       BREAK
      571       BY CHK-pay.DOC-CODE
      572       BY CHK-pay.LINE-NUM:
      573       if ub.chk-doc.shift-date = pshift-date  and ub.chk-doc.shift-num < pshift-num  then next .
      574       if ub.chk-doc.shift-date = pshift-date1 and ub.chk-doc.shift-num > pshift-num1 then next .
      575       if lookup(string(chk-doc.chk-type), '14,15,16,36,17,8,11,12,13,40,101,106,108,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U) > 0 then next _chk-doc.
      576   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      577   if first-of(CHK-pay.DOC-CODE) THEN Do:
      578     assign
      579     pychk_kk = 0
      580     pychk_jj = 1
      581     pychk_jjp = 0
      582     pychk_jjo = 0
      583     pychk_pay-sum = chk-doc.netto
      584     pychk_dop-sumg = 0
      585     .
      586    if ub.chk-doc.netto < 0 then do:
      587           if pychk_doc-code-r <> ub.chk-doc.out-code
      588           then do:
      589             find first pychk_ras-doc no-lock
      590               where pychk_ras-doc.doc-code = ub.chk-doc.out-code
      591               no-error .
      592             if not available pychk_ras-doc then do:
      593               message
      594                 substitute("ŒÚÒÛÚÒÚ‚ÛÂÚ ‰ÓÍÛÏÂÌÚ ‡ÒıÓ‰‡ ÔÓ ˜ÂÍÛ &1"
      595                           , ub.chk-doc.doc-code
      596                           )   skip
      597                 "› —œŒ–“ Õ≈ ÃŒ∆≈“ ¡€“‹ Œ—”Ÿ≈—“¬À≈Õ" SKIP
      598                 view-as alert-box error .
      599               return error .
      600             end.
      601             pychk_doc-code-r = pychk_ras-doc.doc-code.
      602             find first pychk_ret-doc no-lock
      603               where pychk_ret-doc.doc-code = pychk_ras-doc.out-code
      604               no-error .
      605             if not available pychk_ret-doc then do:
      606               message
      607                 substitute("ŒÚÒÛÚÒÚ‚ÛÂÚ ‰ÓÍÛÏÂÌÚ ‚ÓÁ‚‡Ú‡ ÔÓ ˜ÂÍÛ &1"
      608                           , ub.chk-doc.doc-code
      609                           )   skip
      610                 "› —œŒ–“ Õ≈ ÃŒ∆≈“ ¡€“‹ Œ—”Ÿ≈—“¬À≈Õ" SKIP
      611                 view-as alert-box error .
      612               return error .
      613             end.
      614             pychk_doc-code-v = pychk_ret-doc.doc-code.
      615           end.
      616           assign
      617             pychk_doc-code = pychk_doc-code-v
      618           .
      619         end.
      620         else do:
      621           assign
      622             pychk_doc-code = ub.chk-doc.out-code
      623           .
      624         end.
      625     FOR EACH ub.chk-gds No-LOCK WHERE
      626              ub.chk-gds.doc-code = ub.chk-pay.doc-code
      627     BY ub.chk-gds.line-num:
      628     pychk_density = 0.
      629     if ub.chk-gds.write-off-code <> ?
      630     and ub.chk-gds.write-off-code > 0 then NEXT.
      631       if chk-gds.pump <> 0 then do:
      632         find first ub.bar-code no-lock where ub.bar-code.b-code = ub.chk-gds.b-code    no-error.
      633         find first ub.goods    no-lock where ub.goods.gds-code  = ub.bar-code.gds-code no-error.
      634         find first ub.doc-line no-lock where
      635                   ub.doc-line.doc-code  = pychk_doc-code and
      636                   ub.doc-line.artic     = ub.goods.artic      and
      637                   ub.doc-line.prod-type = ub.goods.prod-type  and
      638                   ub.doc-line.prod-code = ub.goods.prod-code  no-error.
      639         assign pychk_density = ( if available ub.doc-line then ub.doc-line.fact-density else 0 ).
      640         find first temp-chk-gds where
      641                   temp-chk-gds.b-code = chk-gds.b-code
      642              AND  temp-chk-gds.doc-code = chk-gds.doc-code
      643              and temp-chk-gds.rec-type = 1 no-error.
      644         if available temp-chk-gds then do:
      645           assign
      646           temp-chk-gds.qnty = temp-chk-gds.qnty  + chk-gds.doc-qnty
      647           temp-chk-gds.sum  = temp-chk-gds.sum  + chk-gds.doc-qnty * (chk-gds.price-base - chk-gds.discnt + chk-gds.price-service)
      648           temp-chk-gds.sum-change = temp-chk-gds.sum
      649           temp-chk-gds.qnty2 = temp-chk-gds.qnty2 + ub.chk-gds.doc-qnty * pychk_density
      650           .
      651         end.
      652         else do:
      653           find first temp-chk-gds use-index ijj where temp-chk-gds.jj_ = pychk_jj no-error.
      654           if not available temp-chk-gds then do:
      655             create temp-chk-gds.
      656             assign
      657             temp-chk-gds.jj_ = pychk_jj
      658             pychk_jj = pychk_jj + 1
      659             temp-chk-gds.qnty2 = 0
      660             temp-chk-gds.qnty = 0
      661             temp-chk-gds.sum = 0
      662             temp-chk-gds.sum-change = temp-chk-gds.sum
      663             .
      664           end.
      665           else do:
      666             assign
      667             temp-chk-gds.qnty2 = 0
      668             temp-chk-gds.qnty = 0
      669             temp-chk-gds.sum = 0
      670             temp-chk-gds.sum-change = temp-chk-gds.sum
      671             pychk_jj = pychk_jj + 1
      672             .
      673           end.
      674           ASSIGN
      675           temp-chk-gds.doc-code = chk-gds.doc-code
      676           temp-chk-gds.b-code = chk-gds.b-code
      677           temp-chk-gds.rec-type = 1
      678           temp-chk-gds.gds-type = 1
      679           temp-chk-gds.qnty = temp-chk-gds.qnty  + chk-gds.doc-qnty
      680           temp-chk-gds.sum  = temp-chk-gds.sum  + chk-gds.doc-qnty * (chk-gds.price-base - chk-gds.discnt + chk-gds.price-service)
      681           temp-chk-gds.sum-change = temp-chk-gds.sum
      682           temp-chk-gds.qnty2 = temp-chk-gds.qnty2 + ub.chk-gds.doc-qnty * pychk_density
      683           pychk_jjp = pychk_jjp + 1
      684           temp-chk-gds.jjp_  = pychk_jjp
      685           temp-chk-gds.jjo_  = 0
      686           .
      687         end.
      688       end.
      689       else do:
      690         find first temp-chk-gds where
      691                   temp-chk-gds.b-code = chk-gds.b-code
      692              AND  temp-chk-gds.doc-code = chk-gds.doc-code
      693              and temp-chk-gds.rec-type = 0  no-error.
      694         IF AVAILABLE TEMP-CHK-GDS THEN DO:
      695           assign
      696           temp-chk-gds.qnty = temp-chk-gds.qnty  + chk-gds.DOC-qnty
      697           temp-chk-gds.sum  = temp-chk-gds.sum  + chk-gds.doc-qnty * (chk-gds.price-base - chk-gds.discnt + chk-gds.price-service)
      698           temp-chk-gds.qnty2 = temp-chk-gds.qnty2 + chk-gds.doc-qnty * pychk_density
      699           temp-chk-gds.sum-change = temp-chk-gds.sum
      700           .
      701         end.
      702         else do:
      703           find first temp-chk-gds where temp-chk-gds.jj_ = pychk_jj use-index ijj no-error.
      704           if not available temp-chk-gds then do:
      705             create temp-chk-gds.
      706             assign
      707             temp-chk-gds.jj_ = pychk_jj
      708             temp-chk-gds.qnty2 = 0
      709             temp-chk-gds.qnty = 0
      710             temp-chk-gds.sum = 0
      711             temp-chk-gds.sum-change = temp-chk-gds.sum
      712             pychk_jj = pychk_jj + 1
      713             .
      714           end.
      715           else do:
      716             assign
      717             pychk_jj = pychk_jj + 1
      718             temp-chk-gds.qnty2 = 0
      719             temp-chk-gds.qnty = 0
      720             temp-chk-gds.sum = 0
      721             temp-chk-gds.sum-change = temp-chk-gds.sum
      722             .
      723           end.
      724           ASSIGN
      725           temp-chk-gds.doc-code = chk-gds.doc-code
      726           temp-chk-gds.b-code = chk-gds.b-code
      727           temp-chk-gds.qnty = temp-chk-gds.qnty  + chk-gds.DOC-qnty
      728           temp-chk-gds.sum  = temp-chk-gds.sum  + chk-gds.doc-qnty * (chk-gds.price-base - chk-gds.discnt + chk-gds.price-service)
      729           temp-chk-gds.qnty2 = temp-chk-gds.qnty2 + chk-gds.doc-qnty * pychk_density
      730           temp-chk-gds.sum-change = temp-chk-gds.sum
      731           temp-chk-gds.rec-type = 0
      732           temp-chk-gds.gds-type =
      733                                     (if chk-doc.office = 'Û':U then 3 else 2)
      734           pychk_jjo = pychk_jjo + 1
      735           temp-chk-gds.jjp_  = 0
      736           temp-chk-gds.jjo_  = pychk_jjo
      737           .
      738         end.
      739       end.
      740     END.
      741   end.
      742   FIND FIRST ub.cash-pay No-LOCK WHERE
      743             ub.cash-pay.cdpay-code = ub.chk-pay.pay-code AND
      744             ub.cash-pay.curr-code = ub.chk-pay.curr-code No-ERROR.
      745   if available ub.cash-pay then do:
      746     find first temp-chk-pay where
      747             temp-chk-pay.line-num = chk-pay.line-num
      748         AND  temp-chk-pay.doc-code = chk-pay.doc-code  no-error.
      749     find first temp-chk-pay use-index pi where
      750             temp-chk-pay.line-num = chk-pay.line-num no-error.
      751     if not available temp-chk-pay then do:
      752       create temp-chk-pay.
      753     end.
      754     buffer-copy chk-pay to temp-chk-pay
      755     assign
      756     temp-chk-pay.pet-good = integer(cash-pay.atr64) * 2 + integer(cash-pay.is-cash)
      757     temp-chk-pay.obj-name = cash-pay.obj-name
      758     temp-chk-pay.is-cash  = cash-pay.is-cash
      759     temp-chk-pay.register = cash-pay.register
      760     .
      761   end.
      762   if last-of(chk-pay.doc-code) then do:
      763     for each temp-chk-pay where
      764             temp-chk-pay.doc-code = chk-pay.doc-code
      765     by temp-chk-pay.pet-good descending
      766     by temp-chk-pay.line-num:
      767       assign
      768       pychk_dop-sump = (if v-curr-r-b = 'rubl':U then temp-chk-pay.tot-rubl else temp-chk-pay.tot-base)
      769       pychk_exch = if pychk_No-exch then 1 else temp-chk-pay.tot-rubl / temp-chk-pay.tot-base
      770       pychk_exch-rubl = if pychk_No-exch-rubl then 1 else temp-chk-pay.tot-rubl / temp-chk-pay.tot-base
      771       .
      772       _repeat:
      773       REPEAT WHILE  abs(pychk_dop-sump) > 0 :
      774         if pychk_dop-sumg = 0 then do:
      775           assign
      776           pychk_kk = pychk_kk + 1
      777           .
      778           if pychk_kk >= pychk_jj then LEAVE _repeat.
      779           if pychk_kk <= pychk_jjp then
      780           find first temp-chk-gds where
      781                     temp-chk-gds.doc-code = chk-doc.doc-code
      782               AND  temp-chk-gds.jjp_ = pychk_kk no-error .
      783           else
      784           find first temp-chk-gds where
      785                     temp-chk-gds.doc-code = chk-doc.doc-code
      786               AND  temp-chk-gds.jjo_ = pychk_kk - pychk_jjp no-error .
      787           if not available temp-chk-gds or temp-chk-gds.sum = 0 then do:
      788             NEXT _repeat.
      789           end.
      790           assign
      791           pychk_dop-sumg = temp-chk-gds.sum
      792           .
      793         end.
      794         assign
      795         pychk_dop-sumk = min(abs(pychk_dop-sumg), abs(pychk_dop-sump))  * (if pychk_dop-sump > 0 then 1 else -1 )
      796         pychk_pay-sum = pychk_pay-sum - pychk_dop-sumk
      797         pychk_dop-sump = pychk_dop-sump - pychk_dop-sumk
      798         pychk_dop-sumg = pychk_dop-sumg - pychk_dop-sumk
      799         .
      800         FIND FIRST ub.bar-code No-LOCK WHERE
      801                   ub.bar-code.b-code =  temp-chk-gds.b-code No-ERROR.
      802         IF NOT AVAIL ub.bar-code then NEXT _repeat.
      803         CASE temp-chk-gds.gds-type:
      804           WHEN 1   then do:
      805             if pychk_sheet2 then do:
      806               FIND FIRST treal-2 No-LOCK WHERE
      807                         treal-2.gds-code = ub.bar-code.gds-code AND
      808                         treal-2.cpay-code = temp-chk-pay.pay-code AND
      809                         treal-2.curr-code = temp-chk-pay.curr-code AND
      810                         treal-2.is-pay = yes
      811                         No-ERROR.
      812               IF NOT AVAIL treal-2 then do:
      813                 FIND last b-treal-2 No-LOCK WHERE
      814                           b-treal-2.gds-code = ub.bar-code.gds-code use-index vi No-ERROR.
      815                 run create-treal-2 in this-procedure (
      816                                 INPUT ub.bar-code.gds-code,
      817                                 INPUT temp-chk-pay.pay-code,
      818                                 INPUT temp-chk-pay.curr-code,
      819                                 INPUT 0,
      820                                 INPUT 0,
      821                                 INPUT 0,
      822                                 INPUT temp-chk-pay.obj-name,
      823                                 INPUT yes,
      824                                 INPUT (if avail b-treal-2
      825                                       then b-treal-2.ii + 1
      826                                       else 1)
      827                                 ) no-error.
      828               END.
      829               assign
      830               treal-2.netto = treal-2.netto + pychk_dop-sumk / pychk_exch
      831               treal-2.qnty1 = treal-2.qnty1 + temp-chk-gds.qnty * (pychk_dop-sumk / temp-chk-gds.sum)
      832               treal-2.qnty2 = treal-2.qnty2 + temp-chk-gds.qnty2 * ( pychk_dop-sumk / temp-chk-gds.sum )
      833               .
      834             end.
      835             if pychk_sheet8
      836             and ub.chk-doc.d-card <> '':U
      837             then do:
      838               if temp-chk-pay.register > 0 then do:
      839                 if ub.chk-doc.cli-type = ?
      840                 or ub.chk-doc.cli-code = ?
      841                 or ub.chk-doc.cli-type = '':U
      842                 or ub.chk-doc.cli-code = 0 then do:
      843                   find first buf_dis-card no-lock where
      844                             buf_dis-card.d-card = ub.chk-doc.d-card no-error .
      845                   if available buf_dis-card then do:
      846                     assign
      847                     v-cli-type = buf_dis-card.cli-type
      848                     v-cli-code = buf_dis-card.cli-code
      849                     .
      850                   end.
      851                 end.
      852                 else do:
      853                   assign
      854                   v-cli-type = ub.chk-doc.cli-type
      855                   v-cli-code = ub.chk-doc.cli-code
      856                   .
      857                 end.
      858                 FIND FIRST treal-8 No-LOCK WHERE
      859                           treal-8.gds-code = ub.bar-code.gds-code
      860                       AND treal-8.cpay-code = 0
      861                       AND treal-8.curr-code = 0
      862                       AND treal-8.cli-type = v-cli-type
      863                       AND treal-8.cli-code = v-cli-code  No-ERROR.
      864                 IF NOT AVAIL treal-8 then do:
      865                   run create-treal-8 in this-procedure (
      866                                     INPUT ub.bar-code.gds-code
      867                                   ,INPUT 0
      868                                   ,INPUT 0
      869                                   ,INPUT v-cli-type
      870                                   ,INPUT v-cli-code
      871                                   ,INPUT 0
      872                                   ,input 0
      873                                   ) no-error.
      874                 END.
      875                 assign
      876                 treal-8.netto = treal-8.netto + pychk_dop-sumk / pychk_exch
      877                 treal-8.qnty1 = treal-8.qnty1 + temp-chk-gds.qnty * (pychk_dop-sumk / temp-chk-gds.sum)
      878                 treal-8.netto-rubl = treal-8.netto-rubl + pychk_dop-sumk * pychk_exch-rubl
      879                 .
      880                 FIND FIRST cp-gds-treal-8 No-LOCK WHERE
      881                           cp-gds-treal-8.gds-code = ub.bar-code.gds-code
      882                       AND cp-gds-treal-8.cpay-code = temp-chk-pay.pay-code
      883                       AND cp-gds-treal-8.curr-code = temp-chk-pay.curr-code
      884                       AND cp-gds-treal-8.cli-type = '':U
      885                       AND cp-gds-treal-8.cli-code = 0  No-ERROR.
      886                 if not available cp-gds-treal-8 then do:
      887                   run create-cp-gds-treal-8 in this-procedure (
      888                                     INPUT ub.bar-code.gds-code
      889                                   ,INPUT temp-chk-pay.pay-code
      890                                   ,INPUT temp-chk-pay.curr-code
      891                                   ,INPUT '':U
      892                                   ,INPUT 0
      893                                   ,INPUT 0
      894                                   ,input 0
      895                                   ) no-error.
      896                 end.
      897                 assign
      898                 cp-gds-treal-8.netto = cp-gds-treal-8.netto + pychk_dop-sumk / pychk_exch
      899                 cp-gds-treal-8.qnty1 = cp-gds-treal-8.qnty1 + temp-chk-gds.qnty * (pychk_dop-sumk / temp-chk-gds.sum)
      900                 cp-gds-treal-8.netto-rubl = cp-gds-treal-8.netto-rubl + pychk_dop-sumk * pychk_exch-rubl
      901                 .
      902                 FIND FIRST gds-treal-8 No-LOCK WHERE
      903                           gds-treal-8.gds-code = ub.bar-code.gds-code
      904                       AND gds-treal-8.cpay-code = 0
      905                       AND gds-treal-8.curr-code = 0
      906                       AND gds-treal-8.cli-type = '':U
      907                       AND gds-treal-8.cli-code = 0  No-ERROR.
      908                 if not available gds-treal-8 then do:
      909                   run create-gds-treal-8 in this-procedure (
      910                                     INPUT ub.bar-code.gds-code
      911                                   ,INPUT 0
      912                                   ,INPUT 0
      913                                   ,INPUT '':U
      914                                   ,INPUT 0
      915                                   ,INPUT 0
      916                                   ,input 0
      917                                   ) no-error.
      918                 end.
      919                 assign
      920                 gds-treal-8.netto = gds-treal-8.netto + pychk_dop-sumk / pychk_exch
      921                 gds-treal-8.qnty1 = gds-treal-8.qnty1 + temp-chk-gds.qnty * (pychk_dop-sumk / temp-chk-gds.sum)
      922                 gds-treal-8.netto-rubl = gds-treal-8.netto-rubl + pychk_dop-sumk * pychk_exch-rubl
      923                 .
      924                 FIND FIRST cp-treal-8 No-LOCK WHERE
      925                           cp-treal-8.gds-code = 0
      926                       AND cp-treal-8.cpay-code = temp-chk-pay.pay-code
      927                       AND cp-treal-8.curr-code = temp-chk-pay.curr-code
      928                       AND cp-treal-8.cli-type = '':U
      929                       AND cp-treal-8.cli-code = 0  No-ERROR.
      930                 if not available cp-treal-8 then do:
      931                   run create-cp-treal-8 in this-procedure (
      932                                     INPUT 0
      933                                   ,INPUT temp-chk-pay.pay-code
      934                                   ,INPUT temp-chk-pay.curr-code
      935                                   ,INPUT '':U
      936                                   ,INPUT 0
      937                                   ,INPUT 0
      938                                   ,input 0
      939                                   ) no-error.
      940                 end.
      941                 assign
      942                 cp-treal-8.netto = cp-treal-8.netto + pychk_dop-sumk / pychk_exch
      943                 cp-treal-8.qnty1 = cp-treal-8.qnty1 + temp-chk-gds.qnty * (pychk_dop-sumk / temp-chk-gds.sum)
      944                 cp-treal-8.netto-rubl = cp-treal-8.netto-rubl + pychk_dop-sumk * pychk_exch-rubl
      945                 .
      946                 FIND FIRST cli-treal-8 No-LOCK WHERE
      947                           cli-treal-8.gds-code = 0
      948                       AND cli-treal-8.cpay-code = 0
      949                       AND cli-treal-8.curr-code = 0
      950                       AND cli-treal-8.cli-type = v-cli-type
      951                       AND cli-treal-8.cli-code = v-cli-code  No-ERROR.
      952                 if not available cli-treal-8 then do:
      953                   run create-cli-treal-8 in this-procedure (
      954                                     INPUT 0
      955                                   ,INPUT 0
      956                                   ,INPUT 0
      957                                   ,INPUT v-cli-type
      958                                   ,INPUT v-cli-code
      959                                   ,INPUT 0
      960                                   ,input 0
      961                                   ) no-error.
      962                 end.
      963                 assign
      964                 cli-treal-8.netto = cli-treal-8.netto + pychk_dop-sumk / pychk_exch
      965                 cli-treal-8.qnty1 = cli-treal-8.qnty1 + temp-chk-gds.qnty * (pychk_dop-sumk / temp-chk-gds.sum)
      966                 cli-treal-8.netto-rubl = cli-treal-8.netto-rubl + pychk_dop-sumk * pychk_exch-rubl
      967                 .
      968               end.
      969             end.
      970           END.
      971           WHEN 2  then do:
      972             if pychk_sheet3 then do:
      973               FIND FIRST ub.goods No-LOCK WHERE
      974                           ub.goods.gds-code = ub.bar-code.gds-code No-ERROR.
      975               IF NOT AVAIL ub.goods then NEXT _repeat.
      976               if pychk_classify then do:
      977                 if pychk_selectgood then do:
      978                   FIND FIRST buf_t-3 where
      979                             ub.goods.grp-name begins buf_t-3.serv-name No-ERROR.
      980                   if not avail buf_t-3 then next _repeat .
      981                 end.
      982               end.
      983               else dO:
      984                 FIND FIRST t-3 where
      985                           ub.goods.grp-name begins t-3.serv-name No-ERROR.
      986                 if not avail t-3 then next _repeat .
      987               end.
      988               if avail t-3  then do:
      989                 FIND FIRST treal-3 No-LOCK WHERE
      990                           treal-3.grp-code = t-3.grp-code-sheet AND
      991                           treal-3.cpay-code = temp-chk-pay.pay-code AND
      992                           treal-3.curr-code = temp-chk-pay.curr-code
      993                           No-ERROR.
      994                 IF NOT AVAIL treal-3 then do:
      995                   FIND last b-treal-3 No-LOCK WHERE
      996                             b-treal-3.grp-code-sheet = t-3.grp-code-sheet use-index vi No-ERROR.
      997                   run create-treal-3 in this-procedure (
      998                                 INPUT t-3.grp-code-sheet,
      999                                 INPUT temp-chk-pay.pay-code,
     1000                                 INPUT temp-chk-pay.curr-code,
     1001                                 INPUT 0,
     1002                                 INPUT 0,
     1003                                 INPUT temp-chk-pay.obj-name,
     1004                                 INPUT yes,
     1005                                 INPUT (if avail b-treal-3
     1006                                       then b-treal-3.ii + 1
     1007                                         else 1)
     1008                                       ) no-error.
     1009                 END.
     1010                 assign
     1011                 treal-3.netto = treal-3.netto + pychk_dop-sumk / pychk_exch
     1012                 treal-3.qnty1 = treal-3.qnty1 + temp-chk-gds.qnty * (pychk_dop-sumk / temp-chk-gds.sum)
     1013                 .
     1014               end.
     1015             END.
     1016           END.
     1017           WHEN 3  then do:
     1018             if pychk_sheet4 then do:
     1019               FIND FIRST treal-4 No-LOCK WHERE
     1020                         treal-4.gds-code = ub.bar-code.gds-code AND
     1021                         treal-4.cpay-code = temp-chk-pay.pay-code AND
     1022                         treal-4.curr-code = temp-chk-pay.curr-code AND
     1023                         treal-4.is-pay = yes
     1024                         No-ERROR.
     1025               IF NOT AVAIL treal-4 then do:
     1026                 FIND last b-treal-4 No-LOCK WHERE
     1027                           b-treal-4.gds-code = ub.bar-code.gds-code use-index vi No-ERROR.
     1028                 run create-treal-4  in this-procedure (
     1029                                 INPUT ub.bar-code.gds-code,
     1030                                 INPUT temp-chk-pay.pay-code,
     1031                                 INPUT temp-chk-pay.curr-code,
     1032                                 INPUT 0,
     1033                                 INPUT 0,
     1034                                 INPUT temp-chk-pay.obj-name,
     1035                                 INPUT yes,
     1036                                 INPUT (if avail b-treal-4
     1037                                       then b-treal-4.ii + 1
     1038                                       else 1)
     1039                                 ) no-error.
     1040               END.
     1041               assign
     1042               treal-4.netto = treal-4.netto + pychk_dop-sumk / pychk_exch
     1043               treal-4.qnty1 = treal-4.qnty1 + temp-chk-gds.qnty * (pychk_dop-sumk / temp-chk-gds.sum)
     1044               .
     1045               END.
     1046           END.
     1047         END CASE.
     1048         if pychk_dop-sumg <= 0 then do:
     1049           assign
     1050           pychk_kk = pychk_kk + 1.
     1051           if pychk_kk >= pychk_jj then LEAVE _repeat.
     1052           if pychk_kk <= pychk_jjp then do:
     1053             find first temp-chk-gds where
     1054                       temp-chk-gds.doc-code = chk-doc.doc-code
     1055                 AND  temp-chk-gds.jjp_ = pychk_kk no-error .
     1056           end.
     1057           else do:
     1058             find first temp-chk-gds where
     1059                       temp-chk-gds.doc-code = chk-doc.doc-code
     1060                 AND  temp-chk-gds.jjo_ = pychk_kk - pychk_jjp no-error .
     1061             if not available temp-chk-gds then do:
     1062               LEAVE _repeat.
     1063             end.
     1064           end.
     1065           pychk_dop-sumg = temp-chk-gds.sum.
     1066           pychk_dop-sumg = temp-chk-gds.sum.
     1067         end.
     1068       END.
     1069     end.
     1070   output close.
     1071   end.
     1072   END.
