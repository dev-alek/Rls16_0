     5979                   sj-adv.obj-attr = sj-goods.obj-attr AND
     5980                   sj-adv.b-code = sj-goods.b-code AND
     5981                   sj-adv.saleman = sj-goods.saleman
     5982             BREAK BY sj-goods.obj-attr
     5983                   BY sj-goods.saleman
     5984                   BY sj-goods.artic
     5985                   BY sj-goods.b-code
     5986                   BY sj-adv.price
     5987                   BY sj-adv.discnt
     5988                   :
     5989   define variable vss-include-info45 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5990   if first( sj-goods.obj-attr ) then do:
     5991     if v-curr-r-b = 'base':U then do:
     5992                           if my-set_val_type = 2  then
