     5030             string( "   ГРУППА : " + get-grp-name(sj-goods.grp-name) ) format "x(120)" SKIP.
     5031             if my-Set_Val_Type = 2 then do:
     5032               UNDERLINE STREAM PrnLibStream
     5033               sj-goods.artic
     5034               sj-goods.name
     5035               with FRAME sj-base-d-t .
     5036             end.
     5037             else do:
