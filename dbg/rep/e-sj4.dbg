     5058   define variable vss-include-info41 as character format "x(65)" no-undo initial "@(#)$Workfile: e-sjprod.i $ $Revision: aea5316774be, 0, rls $".
     5059   define variable vss-include-info42 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5060       ACCUMULATE
     5061       sj-adv.qnty (TOTAL)
     5062       sj-adv.qnty-2 (TOTAL)
     5063       sj-adv.qnty-3 (TOTAL)
     5064       sj-adv.brutto-sum (TOTAL)
