     5904           DISPLAY STREAM PrnLibStream
     5905           (string(round((ACCUM TOTAL sj-adv.qnty) / v-num-chk, 2)) + "/ч")  @ sj-adv.qnty
     5906           (string(round((ACCUM TOTAL sj-adv.qnty-2) / v-num-chk, 2)) + "/ч") @ sj-adv.qnty-2
     5907           (string(round((ACCUM TOTAL sj-adv.qnty-3) / v-num-chk, 2)) + "/ч") @ sj-adv.qnty-3
     5908           with FRAME sj-base-d-t .
     5909           DOWN STREAM PrnLibStream 1 with FRAME sj-base-d-t .
     5910           UNDERLINE STREAM PrnLibStream
     5911           sj-goods.b-code
     5912           sj-goods.artic
     5913           sj-goods.name
     5914           sj-adv.qnty
     5915           sj-adv.qnty-2
     5916           sj-adv.qnty-3
     5917           sj-adv.brutto-sum
     5918           sj-adv.discnt-sum
     5919           pcnt
     5920           sj-adv.netto-sum
     5921           with FRAME sj-base-d-t .
     5922         end.
     5923         when 3 then do:
     5924           if OneLinePrinted then
     5925           PUT STREAM PrnLibStream LINE  SKIP.
     5926           DISPLAY STREAM PrnLibStream
     5927           substitute("ИТОГО ч- &1", v-num-chk) @ sj-goods.name
     5928           ACCUM TOTAL sj-adv.qnty @ sj-adv.qnty
     5929           ACCUM TOTAL sj-adv.qnty-2 @ sj-adv.qnty-2
     5930           ACCUM TOTAL sj-adv.qnty-3 @ sj-adv.qnty-3
     5931           ACCUM TOTAL sj-adv.brutto-sum @ sj-adv.brutto-sum
     5932           ACCUM TOTAL sj-adv.brutto-sum-r @ sj-adv.brutto-sum-r
     5933           ACCUM TOTAL sj-adv.discnt-sum @ sj-adv.discnt-sum
     5934           (IF (ACCUM TOTAL sj-adv.qnty) <> 0 THEN
     5935           round( ( ACCUM TOTAL sj-adv.discnt-sum ) /
     5936                       ( ACCUM TOTAL sj-adv.brutto-sum ) * 100 , 1 ) ELSE 0) @ pcnt
     5937           ACCUM TOTAL sj-adv.netto-sum @ sj-adv.netto-sum
     5938           ACCUM TOTAL sj-adv.netto-sum-r @ sj-adv.netto-sum-r
     5939           with FRAME sj-full-d-t .
     5940           DOWN STREAM PrnLibStream 1 with FRAME sj-full-d-t .
     5941           DISPLAY STREAM PrnLibStream
     5942           (string(round((ACCUM TOTAL sj-adv.qnty) / v-num-chk, 2)) + "/ч") @ sj-adv.qnty
     5943           (string(round((ACCUM TOTAL sj-adv.qnty-2) / v-num-chk, 2)) + "/ч") @ sj-adv.qnty-2
     5944           (string(round((ACCUM TOTAL sj-adv.qnty-3) / v-num-chk, 2)) + "/ч") @ sj-adv.qnty-3
     5945           with FRAME sj-full-d-t .
     5946           DOWN STREAM PrnLibStream 1 with FRAME sj-full-d-t .
     5947           UNDERLINE STREAM PrnLibStream
     5948           sj-goods.b-code
     5949           sj-goods.artic
     5950           sj-goods.name
     5951           sj-adv.qnty
     5952           sj-adv.qnty-2
     5953           sj-adv.qnty-3
     5954           sj-adv.brutto-sum
     5955           sj-adv.brutto-sum-r
     5956           sj-adv.discnt-sum pcnt
     5957           sj-adv.netto-sum
     5958           sj-adv.netto-sum-r
     5959           with FRAME sj-full-d-t .
     5960         end.
     5961       END CASE .
     5962       if ObjsQnty = 1 then
     5963       PUT STREAM PrnLibStream
     5964       " " SKIP(1) space(10)
     5965       "Директор ______________" format "X(50)"
     5966       "Кассир ___________________" format "X(50)" SKIP .
     5967     end.
     5968     END.
     5969   end.
     5970   END PROCEDURE.
     5971   PROCEDURE SimpleProc_d-t.
     5972   define variable v-salesman-name as character no-undo .
