     2705                 ACCUM TOTAL BY sj-tots.grp-name sj-tots.qnty-3    @ sj-adv.qnty-3
     2706                 ACCUM TOTAL BY sj-tots.grp-name sj-tots.brutto-sum  @ sj-adv.brutto-sum
     2707                 ACCUM TOTAL BY sj-tots.grp-name sj-tots.brutto-sum-r @ sj-adv.brutto-sum-r
     2708                 ACCUM TOTAL BY sj-tots.grp-name sj-tots.discnt-sum      @ sj-adv.discnt-sum
     2709                 round( ( ACCUM TOTAL BY sj-tots.grp-name sj-tots.discnt-sum ) /
     2710                             ( ACCUM TOTAL BY sj-tots.grp-name sj-tots.brutto-sum) * 100 , 1 )
     2711                                 @ pcnt
