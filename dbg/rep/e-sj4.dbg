     2678                 ACCUM TOTAL BY sj-tots.grp-name sj-tots.discnt-sum      @ sj-adv.discnt-sum
     2679                 round( ( ACCUM TOTAL BY sj-tots.grp-name sj-tots.discnt-sum ) /
     2680                        ( ACCUM TOTAL BY sj-tots.grp-name sj-tots.brutto-sum) * 100 , 1 )
     2681                                 @ pcnt
     2682                 ACCUM TOTAL BY sj-tots.grp-name sj-tots.netto-sum   @ sj-adv.netto-sum
     2683                 with FRAME sj-base-d-t .
