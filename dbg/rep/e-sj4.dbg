     5974   define variable vss-include-info44 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5975   if SHRs-sort = "Article":U then do:
     5976     if SHBySalers then do:
     5977         FOR EACH sj-goods NO-LOCK,
