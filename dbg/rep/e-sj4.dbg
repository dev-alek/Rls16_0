     1381   FUNCTION get-grp-name returns character( input p-grp-code-alpha as integer):
     1382   define buffer buf_sj-grp for sj-grp.
     1383     find first buf_sj-grp no-lock where
     1384               buf_sj-grp.grp-code-alpha = p-grp-code-alpha no-error.
     1385     if available buf_sj-grp then do:
     1386       return buf_sj-grp.grp-name .
     1387     end.
     1388     return "!!!Неизвестное имя группы!!!".
     1389   END FUNCTION.
