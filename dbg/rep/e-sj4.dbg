     4940     end.
     4941     else do:
     4942                               DOWN STREAM PrnLibStream 1 with FRAME sj-base-d-t .
     4943     end.
     4944   end.
     4945                   if first-of( sj-goods.obj-attr ) AND ( ObjsQnty > 1 ) then  do:
     4946                           assign
     4947                           strbuf1 = substr( sj-goods.obj-attr, 1, 3 )
     4948                           intbuf1 = integer( substr( sj-goods.obj-attr, 4 ) ) .
     4949                           FIND FIRST cli-obj WHERE
     4950                                      cli-obj.obj-type = strbuf1 AND
     4951                                      cli-obj.obj-code = intbuf1 NO-LOCK .
