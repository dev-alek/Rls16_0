     5071       sj-adv.qnty ( SUB-TOTAL BY sj-goods.obj-attr )
     5072       sj-adv.qnty-2 ( SUB-TOTAL BY sj-goods.obj-attr )
     5073       sj-adv.qnty-3 ( SUB-TOTAL BY sj-goods.obj-attr )
     5074       sj-adv.brutto-sum ( SUB-TOTAL BY sj-goods.obj-attr )
