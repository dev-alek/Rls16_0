     4696                           sj-adv.qnty
     4697                           sj-adv.qnty-2
     4698                           sj-adv.qnty-3
     4699                           sj-adv.brutto-sum
     4700                           sj-adv.brutto-sum-r
     4701                           sj-adv.discnt-sum
     4702                           pcnt
     4703                           sj-adv.netto-sum
     4704                           sj-adv.netto-sum-r
     4705                           with FRAME sj-full-t .
     4706                           DISPLAY STREAM PrnLibStream
     4707                           string( "Итого " + sj-goods.obj-attr )
     4708                               @ sj-goods.name
     4709                           ACCUM SUB-TOTAL BY sj-goods.obj-attr sj-adv.qnty    @ sj-adv.qnty
     4710                           ACCUM SUB-TOTAL BY sj-goods.obj-attr sj-adv.qnty-2    @ sj-adv.qnty-2
     4711                           ACCUM SUB-TOTAL BY sj-goods.obj-attr sj-adv.qnty-3    @ sj-adv.qnty-3
     4712                           ACCUM SUB-TOTAL BY sj-goods.obj-attr sj-adv.brutto-sum  @ sj-adv.brutto-sum
     4713                           ACCUM SUB-TOTAL BY sj-goods.obj-attr sj-adv.brutto-sum-r @ sj-adv.brutto-sum-r
     4714                           ACCUM SUB-TOTAL BY sj-goods.obj-attr sj-adv.discnt-sum      @ sj-adv.discnt-sum
     4715                           round( ( ACCUM SUB-TOTAL BY sj-goods.obj-attr sj-adv.discnt-sum ) /
     4716                                       ( ACCUM SUB-TOTAL BY sj-goods.obj-attr sj-adv.brutto-sum) * 100 , 1 )
     4717                                           @ pcnt
     4718                           ACCUM SUB-TOTAL BY sj-goods.obj-attr sj-adv.netto-sum   @ sj-adv.netto-sum
     4719                           ACCUM SUB-TOTAL BY sj-goods.obj-attr sj-adv.netto-sum-r @ sj-adv.netto-sum-r
     4720                           with FRAME sj-full-t .
     4721                           DOWN STREAM PrnLibStream 1 with FRAME sj-full-t .
     4722                       end.
     4723               END CASE .
     4724               if NOT last(  sj-adv.price ) then
     4725                   CASE my-set_val_type :
     4726                       when 2 then
     4727                           UNDERLINE STREAM PrnLibStream
     4728                           sj-goods.name
     4729                           sj-adv.qnty
     4730                           sj-adv.qnty-2
     4731                           sj-adv.qnty-3
     4732                           sj-adv.brutto-sum
     4733                           sj-adv.discnt-sum
     4734                           pcnt
     4735                           sj-adv.netto-sum
     4736                           with FRAME sj-base-t .
     4737                       when 3 then
     4738                           UNDERLINE STREAM PrnLibStream
     4739                           sj-goods.name
     4740                           sj-adv.qnty
     4741                           sj-adv.qnty-2
     4742                           sj-adv.qnty-3
     4743                           sj-adv.brutto-sum
     4744                           sj-adv.brutto-sum-r
     4745                           sj-adv.discnt-sum
     4746                           pcnt
     4747                           sj-adv.netto-sum
     4748                           sj-adv.netto-sum-r
     4749                           with FRAME sj-full-t .
     4750                   END CASE .
     4751               OneLinePrinted = TRUE .
     4752           end.
     4753       if last( sj-adv.discnt    ) then do:
     4754         IF AllObjsTotalsBy then do:
     4755           PUT STREAM PrnLibStream string( "   ПО ВСЕМ ОБЪЕКТАМ " +
     4756              "ПО ПРОИЗВОДИТЕЛЯМ:"
     4757              )
     4758           format "x(120)" SKIP .
     4759           for each sj-tots NO-LOCK BREAK BY sj-tots.prod-name:
     4760             ACCUMULATE
     4761             sj-tots.qnty   (TOTAL BY sj-tots.prod-name)
     4762             sj-tots.qnty-2   (TOTAL BY sj-tots.prod-name)
     4763             sj-tots.qnty-3   (TOTAL BY sj-tots.prod-name)
     4764             sj-tots.brutto-sum  (TOTAL BY sj-tots.prod-name)
     4765             sj-tots.discnt-sum  (TOTAL BY sj-tots.prod-name)
     4766             sj-tots.netto-sum   (TOTAL BY sj-tots.prod-name).
     4767             if my-set_val_type = 3  then
