     2713                 ACCUM TOTAL BY sj-tots.grp-name sj-tots.netto-sum-r @ sj-adv.netto-sum-r
     2714                 with FRAME sj-full-d-t .
     2715                 DOWN STREAM PrnLibStream 1 with FRAME sj-full-d-t .
     2716               end.
     2717             END CASE .
     2718           end.
     2719         END.
     2720       end.
     2721       if ( line-counter(PrnLibStream) + 7 ) > page-size(PrnLibStream) then page stream PrnLibStream.
     2722       CASE my-set_val_type :
     2723         when 2 then do:
     2724           if OneLinePrinted then
