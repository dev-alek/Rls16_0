     4931         BY sj-adv.discnt
     4932     :
     4933   define variable vss-include-info40 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4934   if first( sj-goods.obj-attr ) then do:
     4935     if v-curr-r-b = 'base':U then do:
     4936                           if my-set_val_type = 2  then
