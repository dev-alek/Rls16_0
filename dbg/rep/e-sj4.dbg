     2685               end.
     2686               when 3 then do:
     2687                 UNDERLINE STREAM PrnLibStream
     2688                 sj-goods.b-code
     2689                 sj-goods.artic
     2690                 sj-goods.name
     2691                 sj-adv.qnty
     2692                 sj-adv.qnty-2
     2693                 sj-adv.qnty-3
     2694                 sj-adv.brutto-sum
     2695                 sj-adv.brutto-sum-r
     2696                 sj-adv.discnt-sum
     2697                 pcnt
     2698                 sj-adv.netto-sum
     2699                 sj-adv.netto-sum-r
