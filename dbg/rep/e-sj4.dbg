     4989           if my-Set_Val_Type = 2 then do:
     4990             UNDERLINE STREAM PrnLibStream
     4991             sj-goods.artic
     4992             sj-goods.name
     4993             with FRAME sj-base-d-t .
     4994           end.
     4995           else do:
