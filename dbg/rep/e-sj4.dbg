     5080       sj-adv.qnty-2 (SUB-TOTAL BY ( sj-adv.discnt  ))
     5081       sj-adv.qnty-3 (SUB-TOTAL BY ( sj-adv.discnt  ))
     5082       sj-adv.brutto-sum  (SUB-TOTAL BY (  sj-adv.discnt  ))
     5083       sj-adv.discnt-sum  (SUB-TOTAL BY ( sj-adv.discnt  ))
     5084       sj-adv.netto-sum  (SUB-TOTAL BY (  sj-adv.discnt  ) )
     5085       sj-adv.brutto-sum-r  (SUB-TOTAL BY (  sj-adv.discnt  ))
     5086       sj-adv.netto-sum-r  (SUB-TOTAL BY (  sj-adv.discnt  ) )
     5087       sj-adv.num-lines ( SUB-TOTAL BY (  sj-adv.discnt  ))
     5088       sj-adv.num-docs (SUB-TOTAL BY (  sj-adv.discnt  ))
     5089       sj-adv.qnty  (SUB-TOTAL BY ( sj-goods.b-code ) )
     5090       sj-adv.qnty-2 (SUB-TOTAL BY ( sj-goods.b-code ) )
     5091       sj-adv.qnty-3 (SUB-TOTAL BY ( sj-goods.b-code ) )
     5092       sj-adv.brutto-sum  (SUB-TOTAL BY ( sj-goods.b-code ) )
     5093       sj-adv.discnt-sum  (SUB-TOTAL BY ( sj-goods.b-code ) )
