     8377                           round( ( ACCUM SUB-TOTAL BY sj-goods.obj-attr sj-adv.discnt-sum ) /
     8378                               ( ACCUM SUB-TOTAL BY sj-goods.obj-attr sj-adv.brutto-sum ) * 100 , 1 )
     8379                               @ pcnt
     8380                           ACCUM SUB-TOTAL BY sj-goods.obj-attr sj-adv.netto-sum
     8381                               @ sj-adv.netto-sum
     8382                           with FRAME sj-base-t .
     8383                           DOWN STREAM PrnLibStream 1 with FRAME sj-base-t .
     8384                       end.
     8385                   when 3 then do:
     8386                           UNDERLINE STREAM PrnLibStream
     8387                           sj-goods.name
     8388                           sj-adv.qnty
     8389                           sj-adv.qnty-2
     8390                           sj-adv.qnty-3
     8391                           sj-adv.brutto-sum
     8392                           sj-adv.brutto-sum-r
     8393                           sj-adv.discnt-sum
     8394                           pcnt
     8395                           sj-adv.netto-sum
     8396                           sj-adv.netto-sum-r
     8397                           with FRAME sj-full-t .
     8398                           DISPLAY STREAM PrnLibStream
     8399                           string( "Итого " + sj-goods.obj-attr )
     8400                               @ sj-goods.name
     8401                           ACCUM SUB-TOTAL BY sj-goods.obj-attr sj-adv.qnty    @ sj-adv.qnty
     8402                           ACCUM SUB-TOTAL BY sj-goods.obj-attr sj-adv.qnty-2    @ sj-adv.qnty-2
     8403                           ACCUM SUB-TOTAL BY sj-goods.obj-attr sj-adv.qnty-3    @ sj-adv.qnty-3
     8404                           ACCUM SUB-TOTAL BY sj-goods.obj-attr sj-adv.brutto-sum  @ sj-adv.brutto-sum
     8405                           ACCUM SUB-TOTAL BY sj-goods.obj-attr sj-adv.brutto-sum-r @ sj-adv.brutto-sum-r
     8406                           ACCUM SUB-TOTAL BY sj-goods.obj-attr sj-adv.discnt-sum      @ sj-adv.discnt-sum
     8407                           round( ( ACCUM SUB-TOTAL BY sj-goods.obj-attr sj-adv.discnt-sum ) /
     8408                                       ( ACCUM SUB-TOTAL BY sj-goods.obj-attr sj-adv.brutto-sum) * 100 , 1 )
     8409                                           @ pcnt
     8410                           ACCUM SUB-TOTAL BY sj-goods.obj-attr sj-adv.netto-sum   @ sj-adv.netto-sum
     8411                           ACCUM SUB-TOTAL BY sj-goods.obj-attr sj-adv.netto-sum-r @ sj-adv.netto-sum-r
     8412                           with FRAME sj-full-t .
     8413                           DOWN STREAM PrnLibStream 1 with FRAME sj-full-t .
     8414                       end.
     8415               END CASE .
     8416               if NOT last(  sj-adv.price ) then
     8417                   CASE my-set_val_type :
     8418                       when 2 then
     8419                           UNDERLINE STREAM PrnLibStream
     8420                           sj-goods.name
     8421                           sj-adv.qnty
     8422                           sj-adv.qnty-2
     8423                           sj-adv.qnty-3
     8424                           sj-adv.brutto-sum
     8425                           sj-adv.discnt-sum
     8426                           pcnt
     8427                           sj-adv.netto-sum
     8428                           with FRAME sj-base-t .
     8429                       when 3 then
     8430                           UNDERLINE STREAM PrnLibStream
     8431                           sj-goods.name
     8432                           sj-adv.qnty
     8433                           sj-adv.qnty-2
     8434                           sj-adv.qnty-3
     8435                           sj-adv.brutto-sum
     8436                           sj-adv.brutto-sum-r
     8437                           sj-adv.discnt-sum
     8438                           pcnt
     8439                           sj-adv.netto-sum
     8440                           sj-adv.netto-sum-r
     8441                           with FRAME sj-full-t .
     8442                   END CASE .
     8443               OneLinePrinted = TRUE .
     8444           end.
     8445       if last(  sj-adv.discnt  ) then do:
     8446         if v-curr-r-b = 'base':U and my-Set_val_type = 3 then  do:
     8447           if OneLinePrinted then
     8448           PUT STREAM PrnLibStream Line  SKIP.
     8449         end.
     8450         else do:
     8451           if OneLinePrinted then
     8452           PUT STREAM PrnLibStream Line format ("X(" + string(196) + ")")  SKIP.
     8453         end.
     8454         if ( line-counter(PrnLibStream) + 7 ) > page-size(PrnLibStream) then page stream PrnLibStream .
     8455         CASE my-Set_val_type :
     8456           when 2 then do:
     8457             DISPLAY STREAM PrnLibStream
     8458             substitute("ИТОГО ч- &1", v-num-chk) @ sj-goods.name
     8459             ACCUM TOTAL sj-adv.qnty @ sj-adv.qnty
     8460             ACCUM TOTAL sj-adv.qnty-2 @ sj-adv.qnty-2
     8461             ACCUM TOTAL sj-adv.qnty-3 @ sj-adv.qnty-3
     8462             ACCUM TOTAL sj-adv.brutto-sum @ sj-adv.brutto-sum
     8463             ACCUM TOTAL sj-adv.discnt-sum @ sj-adv.discnt-sum
     8464             (IF (ACCUM TOTAL sj-adv.qnty) <> 0
     8465             THEN
     8466             round( ( ACCUM TOTAL sj-adv.discnt-sum ) /
     8467             ( ACCUM TOTAL sj-adv.brutto-sum ) * 100 , 1 )
     8468             ELSE 0) @ pcnt
     8469             ACCUM TOTAL sj-adv.netto-sum @ sj-adv.netto-sum
     8470             with FRAME sj-base-d-t .
     8471             DOWN STREAM PrnLibStream 1 with FRAME sj-base-d-t .
     8472             DISPLAY STREAM PrnLibStream
     8473             (string(round((ACCUM TOTAL sj-adv.qnty) / v-num-chk, 2)) + "/ч")  @ sj-adv.qnty
     8474             (string(round((ACCUM TOTAL sj-adv.qnty-2) / v-num-chk, 2)) + "/ч") @ sj-adv.qnty-2
     8475             (string(round((ACCUM TOTAL sj-adv.qnty-3) / v-num-chk, 2)) + "/ч") @ sj-adv.qnty-3
     8476             with FRAME sj-base-d-t .
     8477             DOWN STREAM PrnLibStream 1 with FRAME sj-base-d-t .
     8478             UNDERLINE STREAM PrnLibStream
     8479             sj-goods.b-code
     8480             sj-goods.artic
     8481             sj-goods.name
     8482             sj-adv.qnty
     8483             sj-adv.qnty
     8484             sj-adv.brutto-sum
     8485             sj-adv.discnt-sum
     8486             pcnt
     8487             sj-adv.netto-sum
     8488             with FRAME sj-base-d-t .
     8489           end.
     8490           when 3 then do:
     8491           DISPLAY STREAM PrnLibStream
     8492           substitute("ИТОГО ч- &1", v-num-chk) @ sj-goods.name
     8493           ACCUM TOTAL sj-adv.qnty @ sj-adv.qnty
     8494           ACCUM TOTAL sj-adv.qnty-2 @ sj-adv.qnty-2
     8495           ACCUM TOTAL sj-adv.qnty-3 @ sj-adv.qnty-3
     8496           ACCUM TOTAL sj-adv.brutto-sum @ sj-adv.brutto-sum
     8497           ACCUM TOTAL sj-adv.brutto-sum-r @ sj-adv.brutto-sum-r
     8498           ACCUM TOTAL sj-adv.discnt-sum @ sj-adv.discnt-sum
     8499           (IF (ACCUM TOTAL sj-adv.qnty) <> 0
     8500           THEN
     8501           round( ( ACCUM TOTAL sj-adv.discnt-sum ) /
     8502                         ( ACCUM TOTAL sj-adv.brutto-sum ) * 100 , 1 )
     8503           ELSE 0) @ pcnt
     8504           ACCUM TOTAL sj-adv.netto-sum @ sj-adv.netto-sum
     8505           ACCUM TOTAL sj-adv.netto-sum-r @ sj-adv.netto-sum-r
     8506           with FRAME sj-full-d-t .
     8507           DOWN STREAM PrnLibStream 1 with FRAME sj-full-d-t .
     8508           DISPLAY STREAM PrnLibStream
     8509           (string(round((ACCUM TOTAL sj-adv.qnty) / v-num-chk, 2)) + "/ч")  @ sj-adv.qnty
     8510           (string(round((ACCUM TOTAL sj-adv.qnty-2) / v-num-chk, 2)) + "/ч") @ sj-adv.qnty-2
     8511           (string(round((ACCUM TOTAL sj-adv.qnty-3) / v-num-chk, 2)) + "/ч") @ sj-adv.qnty-3
     8512           with FRAME sj-full-d-t .
     8513           DOWN STREAM PrnLibStream 1 with FRAME sj-full-d-t .
     8514           UNDERLINE STREAM PrnLibStream
     8515           sj-goods.b-code
     8516           sj-goods.artic
     8517           sj-goods.name
     8518           sj-adv.qnty
     8519           sj-adv.qnty-2
     8520           sj-adv.qnty-3
     8521           sj-adv.brutto-sum
     8522           sj-adv.brutto-sum-r
     8523           sj-adv.discnt-sum
     8524           pcnt
     8525           sj-adv.netto-sum
     8526           sj-adv.netto-sum-r
     8527           with FRAME sj-full-d-t .
     8528         end.
     8529       END CASE .
     8530       if ObjsQnty = 1 then
     8531       PUT STREAM PrnLibStream
     8532       " " SKIP(1) space(10)
     8533       "Директор ______________" format "X(50)"
     8534       "Кассир ___________________" format "X(50)" SKIP .
     8535     end.
     8536       END .
     8537     end.
     8538   end.
     8539   END PROCEDURE.
