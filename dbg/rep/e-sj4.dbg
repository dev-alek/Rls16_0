     4769             sj-tots.brutto-sum-r (TOTAL BY sj-tots.prod-name)
     4770             sj-tots.netto-sum-r (TOTAL BY sj-tots.prod-name).
     4771             IF LAST-OF(sj-tots.prod-name) then do:
     4772               CASE my-set_val_type :
     4773                 when 2 then do:
     4774                   UNDERLINE STREAM PrnLibStream
     4775                   sj-goods.b-code
     4776                   sj-goods.artic
     4777                   sj-goods.name
     4778                   sj-adv.qnty
     4779                   sj-adv.qnty-2
     4780                   sj-adv.qnty-3
     4781                   sj-adv.brutto-sum
     4782                   sj-adv.discnt-sum
     4783                   pcnt
     4784                   sj-adv.netto-sum
     4785                   with FRAME sj-base-d-t .
     4786                   DISPLAY STREAM PrnLibStream
     4787                   sj-tots.prod-name  @ sj-goods.name
     4788                   ACCUM TOTAL BY sj-tots.prod-name sj-tots.qnty    @ sj-adv.qnty
     4789                   ACCUM TOTAL BY sj-tots.prod-name sj-tots.qnty-2    @ sj-adv.qnty-2
     4790                   ACCUM TOTAL BY sj-tots.prod-name sj-tots.qnty-3    @ sj-adv.qnty-3
     4791                   ACCUM TOTAL BY sj-tots.prod-name sj-tots.brutto-sum      @ sj-adv.brutto-sum
     4792                   ACCUM TOTAL BY sj-tots.prod-name sj-tots.discnt-sum      @ sj-adv.discnt-sum
     4793                   round( ( ACCUM TOTAL BY sj-tots.prod-name sj-tots.discnt-sum ) /
     4794                          ( ACCUM TOTAL BY sj-tots.prod-name sj-tots.brutto-sum) * 100 , 1 )
     4795                                   @ pcnt
     4796                   ACCUM TOTAL BY sj-tots.prod-name sj-tots.netto-sum   @ sj-adv.netto-sum
     4797                   with FRAME sj-base-d-t .
     4798                   DOWN STREAM PrnLibStream 1 with FRAME sj-base-d-t .
     4799                 end.
     4800                 when 3 then do:
     4801                   UNDERLINE STREAM PrnLibStream
     4802                   sj-goods.b-code
     4803                   sj-goods.artic
     4804                   sj-goods.name
     4805                   sj-adv.qnty
     4806                   sj-adv.qnty-2
     4807                   sj-adv.qnty-3
     4808                   sj-adv.brutto-sum
     4809                   sj-adv.brutto-sum-r
     4810                   sj-adv.discnt-sum
     4811                   pcnt
     4812                   sj-adv.netto-sum
     4813                   sj-adv.netto-sum-r
     4814                   with FRAME sj-full-d-t .
     4815                   DISPLAY STREAM PrnLibStream
     4816                   sj-tots.prod-name @ sj-goods.name
     4817                   ACCUM TOTAL BY sj-tots.prod-name sj-tots.qnty    @ sj-adv.qnty
     4818                   ACCUM TOTAL BY sj-tots.prod-name sj-tots.qnty    @ sj-adv.qnty
     4819                   ACCUM TOTAL BY sj-tots.prod-name sj-tots.brutto-sum  @ sj-adv.brutto-sum
     4820                   ACCUM TOTAL BY sj-tots.prod-name sj-tots.brutto-sum-r @ sj-adv.brutto-sum-r
     4821                   ACCUM TOTAL BY sj-tots.prod-name sj-tots.discnt-sum      @ sj-adv.discnt-sum
     4822                   round( ( ACCUM TOTAL BY sj-tots.prod-name sj-tots.discnt-sum ) /
     4823                               ( ACCUM TOTAL BY sj-tots.prod-name sj-tots.brutto-sum) * 100 , 1 )
     4824                                   @ pcnt
     4825                   ACCUM TOTAL BY sj-tots.prod-name sj-tots.netto-sum   @ sj-adv.netto-sum
     4826                   ACCUM TOTAL BY sj-tots.prod-name sj-tots.netto-sum-r @ sj-adv.netto-sum-r
     4827                   with FRAME sj-full-d-t .
     4828                   DOWN STREAM PrnLibStream 1 with FRAME sj-full-d-t .
     4829                 end.
     4830               END CASE .
     4831             end.
     4832           END.
     4833       end.
     4834       if ( line-counter(PrnLibStream) + 7 ) > page-size(PrnLibStream) then page stream PrnLibStream.
     4835       CASE my-set_val_type :
     4836         when 2 then do:
     4837           if OneLinePrinted then
     4838           PUT STREAM PrnLibStream  LINE format ("X(" + string(198) + ")") SKIP.
     4839           DISPLAY STREAM PrnLibStream
     4840           substitute("ИТОГО ч- &1", v-num-chk) @ sj-goods.name
     4841           ACCUM TOTAL sj-adv.qnty @ sj-adv.qnty
     4842           ACCUM TOTAL sj-adv.qnty-2 @ sj-adv.qnty-2
     4843           ACCUM TOTAL sj-adv.qnty-3 @ sj-adv.qnty-3
     4844           ACCUM TOTAL sj-adv.brutto-sum @ sj-adv.brutto-sum
     4845           ACCUM TOTAL sj-adv.discnt-sum @ sj-adv.discnt-sum
     4846           (IF (ACCUM TOTAL sj-adv.qnty) <> 0 THEN
     4847           round( ( ACCUM TOTAL sj-adv.discnt-sum ) /
     4848                       ( ACCUM TOTAL sj-adv.brutto-sum ) * 100 , 1 ) ELSE 0) @ pcnt
     4849           ACCUM TOTAL sj-adv.netto-sum @ sj-adv.netto-sum
     4850               with FRAME sj-base-d-t .
     4851           DOWN STREAM PrnLibStream 1 with FRAME sj-base-d-t .
     4852           DISPLAY STREAM PrnLibStream
     4853           (string(round((ACCUM TOTAL sj-adv.qnty) / v-num-chk, 2)) + "/ч")  @ sj-adv.qnty
     4854           (string(round((ACCUM TOTAL sj-adv.qnty-2) / v-num-chk, 2)) + "/ч") @ sj-adv.qnty-2
     4855           (string(round((ACCUM TOTAL sj-adv.qnty-3) / v-num-chk, 2)) + "/ч") @ sj-adv.qnty-3
     4856           with FRAME sj-base-d-t .
     4857           DOWN STREAM PrnLibStream 1 with FRAME sj-base-d-t .
     4858           UNDERLINE STREAM PrnLibStream
     4859           sj-goods.b-code
     4860           sj-goods.artic
     4861           sj-goods.name
     4862           sj-adv.qnty
     4863           sj-adv.qnty-2
     4864           sj-adv.qnty-3
     4865           sj-adv.brutto-sum
     4866           sj-adv.discnt-sum
     4867           pcnt
     4868           sj-adv.netto-sum
     4869           with FRAME sj-base-d-t .
     4870         end.
     4871         when 3 then do:
     4872           if OneLinePrinted then
     4873           PUT STREAM PrnLibStream LINE  SKIP.
     4874           DISPLAY STREAM PrnLibStream
     4875           substitute("ИТОГО ч- &1", v-num-chk) @ sj-goods.name
     4876           ACCUM TOTAL sj-adv.qnty @ sj-adv.qnty
     4877           ACCUM TOTAL sj-adv.qnty-2 @ sj-adv.qnty-2
     4878           ACCUM TOTAL sj-adv.qnty-3 @ sj-adv.qnty-3
     4879           ACCUM TOTAL sj-adv.brutto-sum @ sj-adv.brutto-sum
     4880           ACCUM TOTAL sj-adv.brutto-sum-r @ sj-adv.brutto-sum-r
     4881           ACCUM TOTAL sj-adv.discnt-sum @ sj-adv.discnt-sum
     4882           (IF (ACCUM TOTAL sj-adv.qnty) <> 0 THEN
     4883           round( ( ACCUM TOTAL sj-adv.discnt-sum ) /
     4884                       ( ACCUM TOTAL sj-adv.brutto-sum ) * 100 , 1 ) ELSE 0) @ pcnt
     4885           ACCUM TOTAL sj-adv.netto-sum @ sj-adv.netto-sum
     4886           ACCUM TOTAL sj-adv.netto-sum-r @ sj-adv.netto-sum-r
     4887           with FRAME sj-full-d-t .
     4888           DOWN STREAM PrnLibStream 1 with FRAME sj-full-d-t .
     4889           DISPLAY STREAM PrnLibStream
     4890           (string(round((ACCUM TOTAL sj-adv.qnty) / v-num-chk, 2)) + "/ч") @ sj-adv.qnty
     4891           (string(round((ACCUM TOTAL sj-adv.qnty-2) / v-num-chk, 2)) + "/ч") @ sj-adv.qnty-2
     4892           (string(round((ACCUM TOTAL sj-adv.qnty-3) / v-num-chk, 2)) + "/ч") @ sj-adv.qnty-3
     4893           with FRAME sj-full-d-t .
     4894           DOWN STREAM PrnLibStream 1 with FRAME sj-full-d-t .
     4895           UNDERLINE STREAM PrnLibStream
     4896           sj-goods.b-code
     4897           sj-goods.artic
     4898           sj-goods.name
     4899           sj-adv.qnty
     4900           sj-adv.qnty-2
     4901           sj-adv.qnty-3
     4902           sj-adv.brutto-sum
     4903           sj-adv.brutto-sum-r
     4904           sj-adv.discnt-sum pcnt
     4905           sj-adv.netto-sum
     4906           sj-adv.netto-sum-r
     4907           with FRAME sj-full-d-t .
     4908         end.
     4909       END CASE .
     4910       if ObjsQnty = 1 then
     4911       PUT STREAM PrnLibStream
     4912       " " SKIP(1) space(10)
     4913       "Директор ______________" format "X(50)"
     4914       "Кассир ___________________" format "X(50)" SKIP .
     4915     end.
     4916     END.
     4917   end.
     4918   else do:
     4919     FOR EACH sj-goods NO-LOCK,
     4920         EACH sj-adv NO-LOCK WHERE
     4921               sj-adv.obj-attr = sj-goods.obj-attr AND
     4922               sj-adv.b-code = sj-goods.b-code AND
