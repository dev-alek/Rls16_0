     1856                               , input RETS
     1857                               , input TREE
     1858                               , input RS-OPTION
     1859                               , input t-dis-card
     1860                               , input rs-dis-card) no-error .
     1861               if error-status:error then do:
     1862                 message
     1863                 vss-workfile vss-revision vss-description skip
     1864                 error-status:get-message(1) skip
     1865                 return-value
     1866                 view-as alert-box error .
     1867                 run waitfram-hide in this-procedure .
     1868                 return.
     1869               end.
     1870               run waitfram-hide in this-procedure .
     1871             END.
     1872             else do:
     1873                 run rep/sv-grp-h.p (
     1874                                input my-handle
     1875                               ,input X-date-start
     1876                               ,input X-date-end
     1877                               ,input str4
     1878                               ,input (if x-SelectObject <> "currency":U and t-byobject then yes else no)
     1879                               ,input integer( WH-Start )
     1880                               ,input integer( WH-End )
     1881                               ,input RETS
     1882                               ,input TREE
     1883                               ,input RS-OPTION
     1884                               ,input t-dis-card
     1885                               ,input  rs-dis-card) no-error.
     1886                 if error-status:error then do:
     1887                   message
     1888                   vss-workfile vss-revision vss-description skip
     1889                   error-status:get-message(1) skip
     1890                   return-value
     1891                   view-as alert-box error .
     1892                   run waitfram-hide in this-procedure .
     1893                   return.
     1894                 end.
     1895                 run waitfram-hide in this-procedure .
     1896              end.
     1897              if vXl then
     1898               run prn-lib-prn-file in this-procedure (
     1899                                                         input parParentProc
     1900                                                         ,input 3
     1901                                                         ).
     1902              else run prn-lib-prn-file in this-procedure (
     1903                                                         input parParentProc
     1904                                                         ,input 8
     1905                                                         ).
     1906              FOR EACH grp-h :
     1907                 delete grp-h .
     1908              END .
     1909              FOR EACH cancells :
     1910                delete cancells .
     1911              END .
     1912              FOR EACH sum-vals :
     1913                if sum-vals.sum2 < 0 then do:
     1914                   delete sum-vals.
     1915                   NEXT.
     1916                end.
     1917                assign
     1918                sum-vals .num-chk[1] = 0
     1919                sum-vals .num-chk[2] = 0
     1920                sum-vals .num-chk[3] = 0
     1921                sum-vals .num-chk[4] = 0
     1922                sum-vals .num-chk[5] = 0
     1923                sum-vals .num-chk[6] = 0
     1924                sum-vals .num-chk[7] = 0
     1925                sum-vals .num-chk[8] = 0
     1926                sum-vals .num-chk[9] = 0
     1927                sum-vals .num-chk[10] = 0
     1928                sum-vals .num-chk[11] = 0
     1929                sum-vals .num-chk[12] = 0
     1930                sum-vals .num-chk[13] = 0
     1931                sum-vals .num-chk[14] = 0
     1932                sum-vals .num-chk[15] = 0
     1933                sum-vals .num-chk[16] = 0
     1934                sum-vals .num-chk[17] = 0
     1935                sum-vals .num-chk[18] = 0
     1936                sum-vals .num-chk[19] = 0
     1937                sum-vals .num-chk[20] = 0
     1938                sum-vals .num-chk[21] = 0
     1939                sum-vals .num-chk[22] = 0
     1940                sum-vals .num-chk[23] = 0
     1941                sum-vals .num-chk[24] = 0
     1942                sum-vals.tot = 0.
     1943             END .
     1944          end.
     1945          else
     1946          message "В указанный Вами период времени" skip
     1947                  "на интересующих Вас объектах" skip
     1948                  "не было строк чеков в указанном диапазоне сумм."
     1949          view-as alert-box INFORMATION .
