      843   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      844   define variable v-waitfram-action01         as character   no-undo .
      845   define variable v-waitfram-action02         as character   no-undo .
      846   define variable v-waitfram-action03         as character   no-undo .
      847   define variable mWaitFramTextBeg            as character   no-undo.
      848   define variable mWaitFramTextEnd            as character   no-undo.
      849   define variable mWaitFramView               as logical     no-undo.
      850   define variable mWaitProcEvent              as logical     no-undo init yes.
      851   define variable mWaitFramInterval           as integer     no-undo init 1 .
      852   define variable mWaitFramStop               as logical     no-undo.
      853   define variable mWaitFramStopUser           as logical     no-undo.
      854   define variable mWaitFramStopTimeOut        as logical     no-undo.
      855   define variable mWaitFramStartProc          as datetime-tz no-undo.
      856   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      857   define button B-WaitFramStop auto-end-key
      858        label "Стоп"
      859        size 10 by 1 tooltip "Остоновить процесс".
      860   define button B-viewProcInfo
      861        label "Информация"
      862        size 15 by 1 tooltip "Информация о процесс".
      863   define frame waitfram
      864     v-waitfram-action01 format "x(72)" no-label skip
      865     v-waitfram-action02 format "x(72)" no-label skip
      866     v-waitfram-action03 format "x(72)" no-label skip
      867     B-viewProcInfo
      868     B-WaitFramStop at row 4 col 30
      869     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      870     .
      871   define new global shared variable mBatchMode as logical no-undo init ?.
      872   define variable mFramBachModHandle as handle no-undo.
      873   mFramBachModHandle = frame waitfram:handle.
      874   define variable mFameOldVis as logical no-undo.
      875   define variable mVisCUrentVin as logical no-undo.
      876   if session:batch-mode
      877   then
      878      mBatchMode = yes.
      879   if mBatchMode = ? then do:
      880     mVisCUrentVin = current-window:visible.
      881     mFameOldVis = mFramBachModHandle:visible.
      882     mFramBachModHandle:visible  = yes.
      883     mBatchMode = mFramBachModHandle:visible ne yes.
      884     mFramBachModHandle:visible = mFameOldVis.
      885     current-window:visible = mVisCUrentVin.
      886   end.
      887    if  log-manager:logfile-name ne ?
      888     then DO:
      889         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      890         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      891         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      892     end.
      893   on choose of B-WaitFramStop in frame waitfram
      894   do:
      895     mWaitFramStop = yes.
      896     mWaitFramStopUser = yes.
      897   end.
      898   function waitfram-check-timeout returns logical():
      899      define variable vtime as int64 no-undo.
      900      if mWaitFramStopTimeOut
      901      then
      902         return yes.
      903      vtime = ( now - mWaitFramStartProc ) / 1000 .
      904      if     mWaitFramTimeOut ne ?
      905         and mWaitFramTimeOut ne 0
      906         and mWaitFramTimeOut lt vtime
      907      then do:
      908         mWaitFramStopTimeOut = yes.
      909      end.
      910      return mWaitFramStopTimeOut.
      911   end.
      912   procedure waitfram-hide :
      913     if not session:batch-mode
      914     then do
      915     on error undo, return error return-value
      916     :
      917       pause 0 before-hide .
      918       if not mBatchMode then
      919         hide frame waitfram .
      920     if     not mWaitFramView
      921        and mWaitProcEvent
      922     then
      923       process events .
      924     end.
      925   end procedure.
      926   procedure waitfram-show :
      927     define input  parameter p-message as character no-undo .
      928     define variable v-left-margin as integer   no-undo .
      929     if not session:batch-mode
      930     then do
      931     on error undo, return error return-value
      932     :
      933       if length(p-message) <= 70 then do:
      934         assign
      935           v-left-margin = integer((70 - length(p-message)) / 2)
      936         .
      937         assign
      938           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      939         .
      940         assign
      941           v-waitfram-action01 = " "
      942           v-waitfram-action02 = " "
      943                                    + fill(" ", v-left-margin)
      944                                    + p-message
      945           v-waitfram-action03 = " "
      946         .
      947       end.
      948       else do:
      949         define variable vRindex1 as integer no-undo.
      950         define variable vRindex2 as integer no-undo.
      951         vRindex1 = r-index(p-message," ",70).
      952         if vRindex1 = 0
      953         then
      954            vRindex1 = 70.
      955         if length(p-message)  <= vRindex1 + 70 then do:
      956           assign
      957             v-waitfram-action01 = " "
      958             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      959             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      960           .
      961         end.
      962         else do:
      963           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      964           if vRindex2 <= vRindex1
      965           then
      966              vRindex2 = vRindex1 + 70.
      967           assign
      968             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      969             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      970             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      971           .
      972         end.
      973       end.
      974       B-viewProcInfo:visible   in frame waitfram = no.
      975       B-viewProcInfo:sensitive in frame waitfram = no.
      976       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      977       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      978       if  (   mWaitFramView
      979          or  mWaitProcEvent)
      980          and not mBatchMode
      981       then
      982          display
      983             v-waitfram-action01 skip
      984             v-waitfram-action02 skip
      985             v-waitfram-action03 skip
      986          with frame waitfram .
      987       if     mWaitFramView
      988          then do:
      989             if     mWaitFramInterval ne ?
      990                and not mBatchMode
      991             then
      992                wait-for go of frame waitfram pause mWaitFramInterval.
      993          end.
      994          else
      995             if     mWaitProcEvent
      996                and not mBatchMode
      997             then
      998                process events .
      999     end.
     1000   end procedure.
     1001      procedure waitfram-show-this:
     1002         define input  parameter iInterval as int64 no-undo.
     1003         define variable vtime as int64 no-undo.
     1004         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1005         mWaitFramInterval = iInterval.
     1006         run waitfram-show (substitute("&1&2 &3&4" ,
     1007                                       mWaitFramTextBeg ,
     1008                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1009                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1010                                       mWaitFramTextEnd
     1011                                      )
     1012                           ).
     1013      end.
     1014      procedure WaitFramRunPause:
     1015         define input  parameter iInterval as dec no-undo.
     1016         define variable vStart  as datetime-tz no-undo.
     1017         define variable vend    as datetime-tz no-undo.
     1018         define variable vint as int64 no-undo.
     1019         define variable vOk as logical no-undo.
     1020         vStart = now.
     1021         vend   = vStart.
     1022         publish "WaitFramPause" (iInterval,output vOk).
     1023         vend   =  now.
     1024         vint = vend - vStart.
     1025         vint = iInterval - vint / 1000.
     1026         if     not mWaitFramStop
     1027            and (   vint > 0
     1028                 or (    not vOk
     1029                     and iInterval eq ?
     1030                     )
     1031                 )
     1032         then
     1033            run waitfram-show-this (iInterval).
     1034         vend   =  now.
     1035         vint = vend - vStart.
     1036         vint = iInterval - vint / 1000.
     1037         if     not mWaitFramStop
     1038            and vint > 0
     1039         then do:
     1040            run gbl/pause.p (vint * 1000).
     1041         end.
     1042         if iInterval ne ?
     1043         then
     1044            publish "WaitFramStop".
     1045         waitfram-check-timeout().
     1046      end.
     1047      procedure WaitFramWaitFor:
     1048         define input  parameter iInterval as dec no-undo.
     1049         assign
     1050            mWaitFramStartProc   = now
     1051            mWaitFramStopUser    = no
     1052            mWaitFramStopTimeOut = no
     1053         .
     1054         block-wait:
     1055         do while not mWaitFramStop:
     1056            run WaitFramRunPause (iInterval).
     1057            if  waitfram-check-timeout()
     1058            then do:
     1059               leave block-wait.
     1060            end.
     1061         end.
     1062         run waitfram-hide.
     1063      end.
     1064   procedure waitfram-join :
     1065     define input  parameter p-line-1  as character no-undo .
     1066     define input  parameter p-line-2  as character no-undo .
     1067     define input  parameter p-line-3  as character no-undo .
     1068     define output parameter p-message as character no-undo .
     1069     do
     1070     on error undo, return error return-value
     1071     :
     1072       assign
     1073         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1074                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1075                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1076       .
     1077     end.
     1078   end procedure.
     1079   function waitfram-join-function returns character
     1080     (input p-line-1 as character
     1081     ,input p-line-2 as character
     1082     ,input p-line-3 as character
     1083     ).
     1084     define variable v-message as character no-undo .
     1085     run waitfram-join in this-procedure
     1086       (input  p-line-1
     1087       ,input  p-line-2
     1088       ,input  p-line-3
     1089       ,output v-message
     1090       ) .
     1091     return v-message .
     1092   end function .
     1093   define variable parparentproc as widget-handle no-undo .
     1094   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1095     define variable v-cntxt-db-num        as integer   no-undo .
     1096     define variable v-cntxt-userid        as character no-undo .
     1097     define variable v-cntxt-level         as character no-undo .
     1098     define variable v-cntxt-host-code-obj as integer   no-undo .
     1099     define variable v-cntxt-obj-type      as character no-undo .
     1100     define variable v-cntxt-obj-code      as integer   no-undo .
     1101     define variable v-cntxt-db-num-obj    as integer   no-undo .
     1102     define variable v-cntxt-is-admin      as logical   no-undo .
     1103   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1104   define  stream PrnLibStream.
     1105   procedure prn-lib-prn-file :
     1106     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1107     define input parameter p-DIsabledoptions as integer no-undo .
     1108     define variable v-report-name as character no-undo .
     1109     define variable v-user-action as character no-undo .
     1110     define variable v-printed     as logical   no-undo .
     1111     define variable v-exist       as logical   no-undo .
     1112     do
     1113       on error undo, return error
     1114       :
     1115       run prn-lib-get-report-name  in this-procedure (
     1116         input parParentProc
     1117         ,output v-report-name
     1118         ).
     1119   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1120   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
     1121     (input  v-report-name
     1122     ,input  2
     1123     ,output v-exist
     1124     )  .
     1125       if NOT v-exist then
     1126       DO:
     1127         Message
     1128           "Нет заданий на печать ! "
     1129           view-as alert-box .
     1130         Return  .
     1131       End.
     1132       run gbl/prnfilen.w
     1133         (input  ""
     1134         ,input  p-DisabledOptions
     1135         ,input  string(v-report-name )
     1136         ,input  7
     1137         ,output v-user-action
     1138         ,output v-printed
     1139         ) .
     1140       if v-printed then
     1141       do:
     1142         return "YES" .
     1143       end.
     1144       else
     1145       do:
     1146         return "NO" .
     1147       end.
     1148     end.
     1149   end procedure.
     1150   procedure prn-lib-open-stream :
     1151     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1152     define input parameter p-page-size    as integer no-undo .
     1153     define input parameter p-is-stream    as logical no-undo .
     1154     define input parameter p-append       as logical no-undo .
     1155     define variable v-report-name as character no-undo .
     1156     do
     1157       on error undo, return error
     1158       :
     1159       run prn-lib-get-report-name  in this-procedure (
     1160         input parParentProc
     1161         ,output v-report-name
     1162         ).
     1163       if p-is-stream then
     1164       do:
     1165         if p-append then
     1166         do:
     1167           output stream PrnLibStream to value( v-report-name )
     1168             page-size value(p-page-size) append .
     1169         end.
     1170         if not p-append then
     1171         do:
     1172           output stream PrnLibStream to value( v-report-name )
     1173             page-size value(p-page-size) .
     1174         end.
     1175       end.
     1176       if not p-is-stream then
     1177       do:
     1178         if p-append then
     1179         do:
     1180           output to value( v-report-name )
     1181             page-size value(p-page-size) append .
     1182         end.
     1183         if not p-append then
     1184         do:
     1185           output to value( v-report-name )
     1186             page-size value(p-page-size) .
     1187         end.
     1188       end.
     1189     end.
     1190   end procedure.
     1191   procedure prn-lib-open-exp :
     1192     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1193     define input parameter p-is-stream    as logical no-undo .
     1194     define input parameter p-is-append    as logical no-undo .
     1195     define output parameter p-ReportFileName as char init "report" no-undo.
     1196     define output parameter p-process as logical no-undo .
     1197     define variable glog as logical no-undo .
     1198     do
     1199       on error undo, return error
     1200       :
     1201       SYSTEM-DIALOG GET-FILE p-ReportFileName
     1202         TITLE      "Укажите путь"
     1203         FILTERS "Текстовый файл (*.txt)"   "*.txt"
     1204         ASK-OVERWRITE
     1205         CREATE-TEST-FILE
     1206         SAVE-AS
     1207         USE-FILENAME
     1208         DEFAULT-EXTENSION "txt"
     1209         UPDATE glog
     1210         .
     1211       if not glog then  return.
     1212       p-ReportFileName = trim( string( p-ReportFileName ) ) .
     1213       if p-is-stream then
     1214       do:
     1215         if p-is-append then
     1216         do:
     1217           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1218         end.
     1219         else
     1220         do:
     1221           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1222         end.
     1223       end.
     1224       else
     1225       do:
     1226         if p-is-append then
     1227         do:
     1228           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1229         end.
     1230         else
     1231         do:
     1232           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1233         end.
     1234       end.
     1235       p-process = yes.
     1236     end.
     1237   end procedure.
     1238   procedure prn-lib-get-report-name :
     1239     define input parameter parParentProc  as widget-handle no-undo.
     1240     define output parameter p-report-name as character no-undo .
     1241     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
     1242   end procedure.
     1243   procedure prn-lib-reportviewer-report-name :
     1244     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1245     define input parameter p-report-name-html as character no-undo .
     1246     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
     1247   end procedure.
     1248   procedure prn-lib-reportviewer :
     1249     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1250     define input parameter p-report-name-html as character no-undo .
     1251     define input parameter p-param        as character no-undo .
     1252     define variable v-excel           as character no-undo init 'TRUE' .
     1253     define variable v-value-character as character no-undo .
     1254     define variable v-value-integer   as character no-undo .
     1255     define variable v-value-date      as date      no-undo .
     1256     define variable v-value-decimal   as decimal   no-undo .
     1257     define variable rep-excel         as logical   no-undo .
     1258     define variable excel-string      as character no-undo .
     1259     define variable v-param-type      as character no-undo .
     1260     define variable v-tth             as handle    no-undo .
     1261     run adm/shattri.p (
     1262       input "get":U
     1263       ,input  ""
     1264       ,input  0
     1265       ,input  'report-glob':U
     1266       ,input  'rep-excel':U
     1267       ,output v-value-character
     1268       ,output v-value-date
     1269       ,output v-value-decimal
     1270       ,output v-value-integer
     1271       ,output rep-excel
     1272       ,output v-param-type
     1273       ,INPUT-OUTPUT table-handle v-tth
     1274       )  .
     1275     if rep-excel then v-excel = "TRUE" .
     1276     else v-excel = "FALSE" .
     1277     if p-param eq ""
     1278     then
     1279        p-param = "EXCEL:" + v-excel.
     1280     else
     1281        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
     1282     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
     1283   end procedure.
     1284   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1285   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1286   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
     1287   define variable par-type          as character no-undo.
     1288   define variable v-value-character as character no-undo .
     1289   define variable v-value-date      as date      no-undo .
     1290   define variable v-value-decimal   as decimal   no-undo .
     1291   define variable v-value-integer   as integer   no-undo .
     1292   define variable v-value-logical   as logical   no-undo .
     1293   DEFINE NEW SHARED temp-table cancells no-undo
     1294   field rd as recid
     1295   field doc-qnty like ub.chk-gds.doc-qnty
     1296   INDEX pi IS PRIMARY rd ASCENDING.
     1297   define variable for-name like ub.goods.grp-name.
     1298   define variable ii as integer no-undo.
     1299   define buffer for-sum-vals for sum-vals.
     1300   define buffer cli-obj for ub.clients .
     1301   DEFINE VARIABLE h_s-hour AS HANDLE NO-UNDO.
     1302   DEFINE BUTTON B-vals
     1303        LABEL "Суммы"
     1304        SIZE 10 BY 1.
     1305   DEFINE VARIABLE RS-dis-card AS INTEGER
     1306        VIEW-AS RADIO-SET VERTICAL
     1307        RADIO-BUTTONS
     1308             "Все типы карт", 0,
     1309   "Выборочно", 1
     1310        SIZE 19 BY 2.13 NO-UNDO.
     1311   DEFINE VARIABLE RS-OPTION AS CHARACTER
     1312        VIEW-AS RADIO-SET VERTICAL
     1313        RADIO-BUTTONS
     1314             "Строки чеков", "LINE":U,
     1315   "Чеки", "CHECK":U,
     1316   "Оплаты", "PAY":U
     1317        SIZE 25.63 BY 2.25 NO-UNDO.
     1318   DEFINE VARIABLE Rets AS LOGICAL INITIAL no
     1319        LABEL "Обрабатывать возвраты"
     1320        VIEW-AS TOGGLE-BOX
     1321        SIZE 42.5 BY 1 NO-UNDO.
     1322   DEFINE VARIABLE t-byobject AS LOGICAL INITIAL no
     1323        LABEL "С разбивкой по объектам"
     1324        VIEW-AS TOGGLE-BOX
     1325        SIZE 31 BY 1 NO-UNDO.
     1326   DEFINE VARIABLE T-dis-card AS LOGICAL INITIAL no
     1327        LABEL "Только покупки по картам"
     1328        VIEW-AS TOGGLE-BOX
     1329        SIZE 26.63 BY 1 NO-UNDO.
     1330   DEFINE VARIABLE Tree AS LOGICAL INITIAL no
     1331        LABEL "Названия групп полностью"
     1332        VIEW-AS TOGGLE-BOX
     1333        SIZE 42.5 BY 1 NO-UNDO.
     1334   DEFINE QUERY BR-dis-card-type FOR
     1335         temp-dis-card-type SCROLLING.
     1336   DEFINE BROWSE BR-dis-card-type
     1337     QUERY BR-dis-card-type DISPLAY
     1338         temp-dis-card-type.type COLUMN-LABEL "Тип" FORMAT "X(8)":U
     1339         temp-dis-card-type.emitent-host-code COLUMN-LABEL "Код эмитента" FORMAT "99999":U
     1340       WITH NO-ROW-MARKERS SEPARATORS SIZE 23.63 BY 8.04
     1341            TITLE "Выбранные типы карт".
     1342   DEFINE FRAME F-Main
     1343        T-dis-card AT ROW 1.25 COL 49
     1344        RS-dis-card AT ROW 2.92 COL 49.13 NO-LABEL
     1345        BR-dis-card-type AT ROW 5.67 COL 48.38
     1346        RS-OPTION AT ROW 12.63 COL 1.88 NO-LABEL
     1347        B-vals AT ROW 12.67 COL 28.5
     1348        Tree AT ROW 15 COL 1.38
     1349        t-byobject AT ROW 15 COL 47
     1350        Rets AT ROW 16.04 COL 1.38
     1351       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
     1352            SIDE-LABELS NO-UNDERLINE THREE-D
     1353            AT COL 1 ROW 1
     1354            SIZE 77.38 BY 16.21.
     1355   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
     1356   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
     1357   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
     1358   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
     1359   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
     1360   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
     1361   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
     1362   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
     1363       ASSIGN adm-object-hdl = FRAME F-Main:HANDLE.
     1364   RUN ensure-broker.
     1365   THIS-PROCEDURE:ADM-DATA =
     1366        'ADM1.1~`':U +
     1367        'SmartObject~`':U +
     1368        'FRAME~`':U +
     1369        'NO ~`':U +
     1370        '~`':U +
     1371        'temp-dis-card-type~`':U +
     1372        '~`':U +
     1373        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
     1374           + "~`":U +
     1375        'Layout,Hide-on-Init~`':U +
     1376        '~`':U +
     1377        '~`':U +
     1378        '~`~`~`~`~`~`~`~`~`~`~`':U +
     1379        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
     1380            THEN "^^":U
     1381        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
     1382             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
     1383   PROCEDURE adm-apply-entry :
     1384     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1385   END PROCEDURE.
     1386   PROCEDURE adm-destroy :
     1387    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1388   END PROCEDURE.
     1389   PROCEDURE adm-disable :
     1390       DISABLE T-dis-card BR-dis-card-type RS-OPTION B-vals Tree t-byobject Rets WITH FRAME F-Main.
     1391       RUN dispatch ('disable-fields':U).
     1392       RUN set-attribute-list ('ENABLED=no':U).
     1393       RETURN.
     1394   END PROCEDURE.
     1395   PROCEDURE adm-edit-attribute-list :
     1396         RUN adm/support/contnrd.w (INPUT THIS-PROCEDURE).
     1397         RETURN.
     1398   END PROCEDURE.
     1399   PROCEDURE adm-enable :
     1400       ENABLE UNLESS-HIDDEN T-dis-card BR-dis-card-type RS-OPTION B-vals Tree t-byobject Rets WITH FRAME F-Main.
     1401       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
     1402       RUN set-attribute-list ('ENABLED=yes':U).
     1403       RETURN.
     1404   END PROCEDURE.
     1405   PROCEDURE adm-exit :
     1406        RUN notify ('exit':U).
     1407     RETURN.
     1408   END PROCEDURE.
     1409   PROCEDURE adm-hide :
     1410     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1411   END PROCEDURE.
     1412   PROCEDURE adm-initialize :
     1413     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1414   END PROCEDURE.
     1415   PROCEDURE adm-show-errors :
     1416       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
     1417       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
     1418           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
     1419       END.
     1420       RETURN.
     1421   END PROCEDURE.
     1422   PROCEDURE adm-UIB-mode :
     1423     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1424   END PROCEDURE.
     1425   PROCEDURE adm-view :
     1426     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1427   END PROCEDURE.
     1428   PROCEDURE dispatch :
     1429       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
     1430       RUN broker-dispatch IN adm-broker-hdl
     1431           (THIS-PROCEDURE, p-method-name) NO-ERROR.
     1432       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
     1433   END PROCEDURE.
     1434   PROCEDURE ensure-broker :
     1435   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
     1436   IF RETURN-VALUE NE "ADM-Broker":U THEN
     1437   DO:
     1438       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
     1439       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
     1440   END.
     1441   END PROCEDURE.
     1442   PROCEDURE get-attribute :
     1443     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
     1444     RUN broker-get-attribute IN adm-broker-hdl
     1445         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
     1446     RETURN RETURN-VALUE.
     1447   END PROCEDURE.
     1448   PROCEDURE get-attribute-list :
     1449     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
     1450     RUN broker-get-attribute-list IN adm-broker-hdl
     1451         (INPUT THIS-PROCEDURE,
     1452          INPUT ?,
     1453          OUTPUT p-attr-list) NO-ERROR.
     1454     RETURN.
     1455   END PROCEDURE.
     1456   PROCEDURE new-state :
     1457     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     1458     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
     1459     RETURN.
     1460   END PROCEDURE.
     1461   PROCEDURE notify :
     1462     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
     1463     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
     1464     IF RETURN-VALUE = "ADM-ERROR":U THEN
     1465         RETURN "ADM-ERROR":U.
     1466     RETURN.
     1467   END PROCEDURE.
     1468   PROCEDURE set-attribute-list :
     1469     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
     1470     RUN ensure-broker.
     1471     RUN broker-set-attribute-list IN adm-broker-hdl
     1472         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
     1473     RETURN.
     1474   END PROCEDURE.
     1475   PROCEDURE set-position :
     1476       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
     1477       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
     1478       IF VALID-HANDLE(adm-object-hdl) THEN
     1479       DO:
     1480           DEFINE VARIABLE parent-hdl AS HANDLE NO-UNDO.
     1481           IF adm-object-hdl:TYPE = "WINDOW":U THEN
     1482           DO:
     1483             IF p-row = 0 THEN p-row =
     1484               (SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2.
     1485             IF p-col = 0 THEN p-col =
     1486               (SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2.
     1487           END.
     1488           ELSE IF adm-object-hdl:TYPE = "DIALOG-BOX":U THEN
     1489           DO:
     1490             parent-hdl = adm-object-hdl:PARENT.
     1491             IF p-row = 0 THEN p-row =
     1492               ((SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2) -
     1493                 parent-hdl:ROW.
     1494             IF p-col = 0 THEN p-col =
     1495               ((SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2) -
     1496                 parent-hdl:COL.
     1497           END.
     1498           IF p-row GE 0 AND p-row < 1 THEN p-row = 1.
     1499           IF p-col GE 0 AND p-col < 1 THEN p-col = 1.
     1500         ASSIGN adm-object-hdl:ROW    =   p-row
     1501                adm-object-hdl:COLUMN =   p-col.
     1502       END.
     1503       RETURN.
     1504   END PROCEDURE.
     1505   RUN set-attribute-list ("CURRENT-PAGE=0,ADM-OBJECT-HANDLE=":U +
     1506       STRING(adm-object-hdl)).
     1507   PAUSE 0 BEFORE-HIDE.
     1508   PROCEDURE adm-change-page :
     1509     RUN broker-change-page IN adm-broker-hdl (INPUT THIS-PROCEDURE) NO-ERROR.
     1510     END PROCEDURE.
     1511   PROCEDURE delete-page :
     1512     DEFINE INPUT PARAMETER p-page# AS INTEGER NO-UNDO.
     1513     RUN broker-delete-page IN adm-broker-hdl
     1514         (INPUT THIS-PROCEDURE, INPUT p-page#).
     1515     END PROCEDURE.
     1516   PROCEDURE init-object :
     1517     DEFINE INPUT PARAMETER  p-proc-name   AS CHARACTER NO-UNDO.
     1518     DEFINE INPUT PARAMETER  p-parent-hdl  AS HANDLE    NO-UNDO.
     1519     DEFINE INPUT PARAMETER  p-attr-list   AS CHARACTER NO-UNDO.
     1520     DEFINE OUTPUT PARAMETER p-proc-hdl    AS HANDLE    NO-UNDO.
     1521     RUN broker-init-object IN adm-broker-hdl
     1522         (INPUT THIS-PROCEDURE, INPUT p-proc-name, INPUT p-parent-hdl,
     1523          INPUT p-attr-list, OUTPUT p-proc-hdl) NO-ERROR.
     1524     RETURN.
     1525   END PROCEDURE.
     1526   PROCEDURE init-pages :
     1527     DEFINE INPUT PARAMETER p-page-list      AS CHARACTER NO-UNDO.
     1528     RUN broker-init-pages IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     1529         INPUT p-page-list) NO-ERROR.
     1530     END PROCEDURE.
     1531   PROCEDURE select-page :
     1532     DEFINE INPUT PARAMETER p-page#     AS INTEGER   NO-UNDO.
     1533     RUN broker-select-page IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     1534         INPUT p-page#) NO-ERROR.
     1535     END PROCEDURE.
     1536   PROCEDURE view-page :
     1537     DEFINE INPUT PARAMETER p-page#      AS INTEGER   NO-UNDO.
     1538     RUN broker-view-page IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     1539         INPUT p-page#).
     1540     END PROCEDURE.
     1541   ASSIGN
     1542          BR-dis-card-type:HIDDEN  IN FRAME F-Main                = TRUE.
     1543   ON CHOOSE OF B-vals IN FRAME F-Main
     1544   DO:
     1545     run str/sum-vals.w .
     1546   END.
     1547   ON VALUE-CHANGED OF RS-dis-card IN FRAME F-Main
     1548   DO:
     1549   DEFINE VARIABLE varrid-list as character no-undo.
     1550     ASSIGN
     1551     RS-dis-card.
     1552     CASE RS-dis-card:
     1553       when 1 then do:
     1554           run ref/dc-types.w (
     1555                          input my-handle
     1556                         ,INPUT "":U
     1557                         ,INPUT "b-sel,b-mark":U
     1558                         ,INPUT 0
     1559                         ,INPUT v-cntxt-host-code-obj
     1560                         ,INPUT v-cntxt-obj-type
     1561                         ,INPUT v-cntxt-obj-code
     1562                         ,input-OUTPUT varrid-list).
     1563           if varrid-list = "" then do:
     1564               for each temp-dis-card-type:
     1565                   delete temp-dis-card-type.
     1566               end.
     1567               rs-dis-card = 0.
     1568               OPEN QUERY BR-dis-card-type FOR EACH temp-dis-card-type NO-LOCK.
     1569               DISPLAY
     1570               rs-dis-card
     1571               with frame F-Main.
     1572               HIDE
     1573               br-dis-card-type
     1574               in frame F-Main.
     1575           end.
     1576           else dO:
     1577             DO ii = 1 to num-entries(varrid-list):
     1578               FIND FIRST ub.dis-card-type No-LOCK WHERE
     1579                                 recid(ub.dis-card-type) = integer(entry(ii, varrid-list)) No-ERROR.
     1580             if avail ub.dis-card-type then dO:
     1581               create temp-dis-card-type.
     1582               buffer-copy ub.dis-card-type to temp-dis-card-type.
     1583             END.
     1584           END.
     1585           OPEN QUERY BR-dis-card-type FOR EACH temp-dis-card-type NO-LOCK.
     1586           DISPLAY
     1587           br-dis-card-type
     1588           with frame F-Main .
     1589         end.
     1590       end.
     1591       when 0 then do:
     1592         for each temp-dis-card-type:
     1593           delete temp-dis-card-type.
     1594         end.
     1595        OPEN QUERY BR-dis-card-type FOR EACH temp-dis-card-type NO-LOCK.
     1596         HIDE
     1597         br-dis-card-type
     1598         in frame F-Main.
     1599       end.
     1600     END CASE.
     1601   END.
     1602   ON VALUE-CHANGED OF RS-OPTION IN FRAME F-Main
     1603   DO:
     1604       assign RS-option.
     1605       if RS-option <> "LINE":U then disable Tree with FRAME F-Main.
     1606       else enable Tree with FRAME F-Main.
     1607   END.
     1608   ON VALUE-CHANGED OF T-dis-card IN FRAME F-Main
     1609   DO:
     1610     assign
     1611     t-dis-card.
     1612     CASE t-dis-card:
     1613       when yes then do:
     1614           assign
     1615           Rs-dis-card = 0.
     1616           DISPLAY
     1617           RS-dis-card
     1618           with frame F-Main.
     1619           ENABLE
     1620           RS-dis-card
     1621           with frame F-Main.
     1622       end.
     1623       when no then do:
     1624           assign
     1625           Rs-dis-card = 0.
     1626           DISABLE
     1627           RS-dis-card
     1628           with frame F-Main.
     1629       end.
     1630     END CASE.
     1631   END.
     1632   if not this-procedure :persistent
     1633   then do:
     1634     message
     1635       vss-workfile vss-revision vss-description skip
     1636       "Ошибка при запуске процедуры" skip
     1637       "Данную процедуру следует запускать только с параметром persistent" skip
     1638       view-as alert-box error .
     1639     undo, return error .
     1640   end.
     1641   assign
     1642   loc#db-num = v-cntxt-db-num
     1643   loc#host-code = v-cntxt-host-code-obj
     1644   loc#store-code = v-cntxt-obj-code
     1645   .
     1646   PROCEDURE adm-create-objects :
     1647     DEFINE VARIABLE adm-current-page  AS INTEGER NO-UNDO.
     1648     RUN get-attribute IN THIS-PROCEDURE ('Current-Page':U).
     1649     ASSIGN adm-current-page = INTEGER(RETURN-VALUE).
     1650     CASE adm-current-page:
     1651       WHEN 0 THEN DO:
     1652          RUN init-object IN THIS-PROCEDURE (
     1653                INPUT  'rep/s-hour.w':U ,
     1654                INPUT  FRAME F-Main:HANDLE ,
     1655                INPUT  '':U ,
     1656                OUTPUT h_s-hour ).
     1657                 RUN adjust-tab-order IN adm-broker-hdl ( h_s-hour ,
     1658                T-dis-card:HANDLE IN FRAME F-Main , 'BEFORE':U ).
     1659       END.
     1660     END CASE.
     1661   END PROCEDURE.
     1662   PROCEDURE adm-row-available :
     1663     DEFINE VARIABLE tbl-list           AS CHARACTER INIT "":U NO-UNDO.
     1664     DEFINE VARIABLE rowid-list         AS CHARACTER NO-UNDO.
     1665     DEFINE VARIABLE row-avail-cntr     AS INTEGER INIT 0 NO-UNDO.
     1666     DEFINE VARIABLE row-avail-rowid    AS ROWID NO-UNDO.
     1667     DEFINE VARIABLE row-avail-enabled  AS LOGICAL NO-UNDO.
     1668     DEFINE VARIABLE link-handle        AS CHARACTER NO-UNDO.
     1669     DEFINE VARIABLE record-source-hdl  AS HANDLE NO-UNDO.
     1670     DEFINE VARIABLE different-row      AS LOGICAL NO-UNDO INIT no.
     1671     DEFINE VARIABLE key-name           AS CHARACTER INIT ? NO-UNDO.
     1672     DEFINE VARIABLE key-value          AS CHARACTER INIT ? NO-UNDO.
     1673     RUN check-modified IN THIS-PROCEDURE ('check':U) NO-ERROR.
     1674     IF adm-updating-record THEN RETURN.
     1675     RUN get-attribute ('FIELDS-ENABLED':U).
     1676     row-avail-enabled = IF RETURN-VALUE = "YES":U THEN yes ELSE no.
     1677     RUN get-link-handle IN adm-broker-hdl (THIS-PROCEDURE, 'RECORD-SOURCE':U,
     1678         OUTPUT link-handle) NO-ERROR.
     1679     IF link-handle = "":U THEN
     1680         RETURN.
     1681     ASSIGN record-source-hdl = WIDGET-HANDLE(ENTRY(1,link-handle)).
     1682     IF NUM-ENTRIES(link-handle) > 1 THEN
     1683         MESSAGE "row-available in ":U THIS-PROCEDURE:FILE-NAME
     1684             "encountered more than one RECORD-SOURCE.":U SKIP
     1685             "The first - ":U record-source-hdl:file-name " - will be used.":U
     1686                VIEW-AS ALERT-BOX ERROR.
     1687     RUN get-attribute ('Key-Name':U).
     1688     key-name = RETURN-VALUE.
     1689     IF key-name = "":U THEN key-name = ?.
     1690     IF key-name NE ? THEN DO:
     1691       RUN send-key IN record-source-hdl (INPUT key-name, OUTPUT key-value)
     1692         NO-ERROR.
     1693       IF key-value NE ? THEN
     1694         RUN set-attribute-list (SUBSTITUTE ('Key-Value="&1"':U, key-value)).
     1695     END.
     1696   IF VALID-HANDLE (adm-object-hdl) THEN
     1697       RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     1698   RUN notify IN THIS-PROCEDURE ('row-available':U).
     1699   END PROCEDURE.
     1700   PROCEDURE disable_UI :
     1701     HIDE FRAME F-Main.
     1702     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1703   END PROCEDURE.
     1704   PROCEDURE enable_UI :
     1705     DISPLAY T-dis-card RS-dis-card RS-OPTION Tree t-byobject Rets
     1706         WITH FRAME F-Main.
     1707     ENABLE T-dis-card BR-dis-card-type RS-OPTION B-vals Tree t-byobject Rets
     1708         WITH FRAME F-Main.
     1709     OPEN QUERY BR-dis-card-type FOR EACH temp-dis-card-type NO-LOCK.
     1710   END PROCEDURE.
     1711   PROCEDURE local-initialize :
     1712     RUN dispatch IN THIS-PROCEDURE ( INPUT 'initialize':U ) .
     1713     run ini-from-selobj in h_s-hour.
     1714     APPLY "VALUE-CHANGED" to T-dis-card in frame F-Main.
     1715     APPLY "VALUE-CHANGED" to RS-dis-card in frame F-Main.
     1716     parparentproc = my-handle.
     1717   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1718     run mainmenu_getcntxt in parparentproc
     1719       (output v-cntxt-db-num
     1720       ,output v-cntxt-userid
     1721       ,output v-cntxt-level
     1722       ,output v-cntxt-host-code-obj
     1723       ,output v-cntxt-obj-type
     1724       ,output v-cntxt-obj-code
     1725       ,output v-cntxt-db-num-obj
     1726       ,output v-cntxt-is-admin
     1727       ) .
     1728   END PROCEDURE.
     1729   PROCEDURE My-Report :
     1730   define variable num-cols as integer.
     1731   define variable choice as integer.
     1732   define variable glog as logical no-undo .
     1733   assign
     1734   FRAME F-Main RS-OPTION
     1735   FRAME F-Main Tree
     1736   FRAME F-Main Rets
     1737   .
     1738   IF NOT CAN-FIND(FIRST SUM-VALS) THEN DO:
     1739      message "Вы не выбрали ни одного диапазона сумм!"
     1740      view-as alert-box ERROR .
     1741      RETURN NO-APPLY.
     1742   END.
     1743   num-cols = ( integer( vH-0 ) + integer( vH-1 ) + integer( vH-2 ) + integer( vH-3 ) + integer( vH-4 ) +
     1744                integer( vH-5 ) + integer( vH-6 ) + integer( vH-7 ) + integer( vH-8 ) + integer( vH-9 ) +
     1745                integer( vH-10 ) + integer( vH-11 ) + integer( vH-12 ) + integer( vH-13 ) + integer( vH-14 ) +
     1746                integer( vH-15 ) + integer( vH-16 ) + integer( vH-17 ) + integer( vH-18 ) + integer( vH-19 ) +
     1747                integer( vH-20 ) + integer( vH-21 ) + integer( vH-22 ) + integer( vH-23 ) ).
     1748   glog = ?.
     1749   if num-cols > 10 AND num-cols < 14  and NOT vXL then do:
     1750       run gbl/d-askw.w (input "Формат вывода",
     1751                    input ("Количество интересующих Вас интервалов времени больше 10 :" + chr(10) +
     1752                           "отчет не уместится на бумаге формата А4 (ориентация альбомная)"
     1753                          ),
     1754                    input "|",
     1755                    input ("Выводить в Excel|" +
     1756                           "Формат А3 (ориентация альбомная)|" +
     1757                           "Уменьшить количество интервалов"),
     1758                    input "||",
     1759                    input 1,
     1760                    input 3,
     1761                    output choice).
     1762       if choice = 3 then return no-apply.
     1763       if choice = 1 then vxl = yes.
     1764       run display_ in h_s-hour.
     1765   end.
     1766   else if num-cols >=14 AND NOT vXl then do:
     1767       run gbl/d-askw.w (input "Формат вывода",
     1768                    input ("Количество интересующих Вас интервалов времени больше 13 :" + chr(10) +
     1769                           "отчет не уместится на бумаге формата А3 (ориентация альбомная)"
     1770                          ),
     1771                    input "|",
     1772                    input ("Выводить в Excel|" +
     1773                           "Уменьшить количество интервалов"),
     1774                    input "|",
     1775                    input 1,
     1776                    input 2,
     1777                    output choice).
     1778       if choice = 2 then return no-apply.
     1779       vxl = yes.
     1780       run display_ in h_s-hour.
     1781   end.
     1782   if ( integer( vH-0 ) + integer( vH-1 ) + integer( vH-2 ) + integer( vH-3 ) + integer( vH-4 ) +
     1783        integer( vH-5 ) + integer( vH-6 ) + integer( vH-7 ) + integer( vH-8 ) + integer( vH-9 ) +
     1784        integer( vH-10 ) + integer( vH-11 ) + integer( vH-12 ) + integer( vH-13 ) + integer( vH-14 ) +
     1785        integer( vH-15 ) + integer( vH-16 ) + integer( vH-17 ) + integer( vH-18 ) + integer( vH-19 ) +
     1786        integer( vH-20 ) + integer( vH-21 ) + integer( vH-22 ) + integer( vH-23 ) ) = 0
     1787   then do:
     1788       message "Вы не определили," skip
     1789               "какие интервалы времени" skip
     1790               "Вас интересуют."     view-as alert-box ERROR .
     1791       return no-apply.
     1792   end.
     1793   else do:
     1794      run waitfram-show in this-procedure ( "Подождите ..." ).
     1795       IF RETS THEN FOR each sum-vals NO-LOCK WHERE sum1 >= 0 :
     1796           create for-sum-vals.
     1797           assign
     1798           for-sum-vals.sum1 = - sum-vals.sum2
     1799           for-sum-vals.sum2 = - sum-vals.sum1.
     1800        END.
     1801        if vxl then do:
     1802           define variable p-XL-delim as character no-undo .
     1803           define variable type-par1 as character no-undo .
     1804           define variable tmp-var1  as character no-undo .
     1805   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1806   empty temp-table thbjattr_thbj-attr.
     1807   run adm/shattri.p (
     1808      input "get":U
     1809     ,input v-cntxt-obj-type
     1810     ,input v-cntxt-obj-code
     1811     ,input 'report-firm':U
     1812     ,input  ""
     1813     ,output v-value-character
     1814     ,output v-value-date
     1815     ,output v-value-decimal
     1816     ,output v-value-integer
     1817     ,output v-value-logical
     1818     ,output par-type
     1819     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     1820     ) no-error .
     1821         for each thbjattr_thbj-attr :
     1822             if thbjattr_thbj-attr.prop-code = 'XL-delim'  then tmp-var1   = thbjattr_thbj-attr.property-value-character.
     1823         end.
     1824         IF tmp-var1 = "" then p-XL-delim = ";".
     1825         else p-XL-delim = tmp-var1.
     1826         end.
     1827          If RS-Option = "LINE":U OR RS-OPTION = "PAY":U then do:
