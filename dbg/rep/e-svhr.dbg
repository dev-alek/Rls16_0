     2009                     message
     2010                     vss-workfile vss-revision vss-description skip
     2011                     error-status:get-message(1) skip
     2012                     return-value
     2013                     view-as alert-box error .
     2014                     run waitfram-hide in this-procedure .
     2015                     return.
     2016                   end.
     2017                   run waitfram-hide in this-procedure .
     2018                END.
     2019                if vXl then
     2020                 run prn-lib-prn-file in this-procedure (
     2021                                                           input parParentProc
     2022                                                           ,input 3
     2023                                                           ).
     2024                else
     2025                 run prn-lib-prn-file in this-procedure (
     2026                                                           input parParentProc
     2027                                                           ,input 8
     2028                                                           ).
     2029                FOR EACH grp-h :
     2030                   delete grp-h .
     2031                END .
     2032                FOR EACH cancells :
     2033                   delete cancells .
     2034                END .
     2035                FOR EACH sum-vals :
     2036                    if sum-vals.sum2 < 0 then do:
     2037                       delete sum-vals.
     2038                       next.
     2039                    end.
     2040                    assign
     2041                    sum-vals .num-chk[1] = 0
     2042                    sum-vals .num-chk[2] = 0
     2043                    sum-vals .num-chk[3] = 0
     2044                    sum-vals .num-chk[4] = 0
     2045                    sum-vals .num-chk[5] = 0
     2046                    sum-vals .num-chk[6] = 0
     2047                    sum-vals .num-chk[7] = 0
     2048                    sum-vals .num-chk[8] = 0
     2049                    sum-vals .num-chk[9] = 0
     2050                    sum-vals .num-chk[10] = 0
     2051                    sum-vals .num-chk[11] = 0
     2052                    sum-vals .num-chk[12] = 0
     2053                    sum-vals .num-chk[13] = 0
     2054                    sum-vals .num-chk[14] = 0
     2055                    sum-vals .num-chk[15] = 0
     2056                    sum-vals .num-chk[16] = 0
     2057                    sum-vals .num-chk[17] = 0
     2058                    sum-vals .num-chk[18] = 0
     2059                    sum-vals .num-chk[19] = 0
     2060                    sum-vals .num-chk[20] = 0
     2061                    sum-vals .num-chk[21] = 0
     2062                    sum-vals .num-chk[22] = 0
     2063                    sum-vals .num-chk[23] = 0
     2064                    sum-vals .num-chk[24] = 0
     2065                    sum-vals.tot = 0
     2066                    .
     2067                 END .
     2068              end.
     2069              else
     2070              message "В указанный Вами период времени" skip
     2071                      "на интересующих Вас объектах" skip
     2072                      "не было чеков в указанном диапазоне сумм."
     2073                      view-as alert-box INFORMATION .
     2074           end.
     2075       end.
     2076   END PROCEDURE.
     2077   PROCEDURE My-var :
     2078   run Assign-Frame in h_s-hour.
     2079   assign frame F-Main
     2080   Tree Rets Rs-Option
     2081   t-dis-card rs-dis-card t-byobject.
     2082   Assign
     2083    STR-obj-type = ''
     2084    STR-obj-code = ''
     2085    STR-obj-name = ''
     2086    STR-obj      = ''.
     2087   For each obj-list no-lock:
     2088    Assign
     2089    STR-obj-type = STR-obj-type + obj-list.obj-type + ','
     2090    STR-obj-code = STR-obj-code + String(obj-list.obj-code) + ','
     2091    STR-obj-name = STR-obj-name + obj-list.obj-name + ','
     2092    STR-obj = STR-obj +  obj-list.obj-type + '#' + string(obj-list.obj-code)  + ',' .
     2093   End.
     2094   ReportNAme = "Почасовая статистика розничных продаж  ПО ВЕЛИЧИНЕ СУММ ПРОДАЖ" .
     2095   ReportHeader =  radio-label(string(Rs-Option), RS-Option:radio-buttons) + ", "
     2096                               + Tree:label + " " + Rets:label +
     2097                               (IF t-byobject THEN t-byobject:LABEL IN FRAME F-Main ELSE '':U) + ", " +
     2098                               string(if vXl then ", Вывод в Excel" else "").
     2099   assign
     2100   use-column[4] = vH-0
     2101   use-column[5] = vH-1
     2102   use-column[6] = vh-2
     2103   use-column[7] = vh-3
     2104   use-column[8] = vh-4
     2105   use-column[9] = vH-5
     2106   use-column[10] = vH-6
     2107   use-column[11] = vh-7
     2108   use-column[12] = vh-8
     2109   use-column[13] = vh-9
     2110   use-column[14] = vH-10
     2111   use-column[15] = vH-11
     2112   use-column[16] = vh-12
     2113   use-column[17] = vh-13
     2114   use-column[18] = vh-14
     2115   use-column[19] = vH-15
     2116   use-column[20] = vH-16
     2117   use-column[21] = vh-17
     2118   use-column[22] = vh-18
     2119   use-column[23] = vh-19
     2120   use-column[24] = vH-20
     2121   use-column[25] = vH-21
     2122   use-column[26] = vh-22
     2123   use-column[27] = vh-23
     2124   .
     2125   END PROCEDURE.
     2126   PROCEDURE send-records :
     2127     DEFINE INPUT PARAMETER p-tbl-list AS CHARACTER NO-UNDO.
     2128     DEFINE OUTPUT PARAMETER p-rowid-list AS CHARACTER NO-UNDO.
     2129     DEFINE VARIABLE i            AS INTEGER   NO-UNDO.
     2130     DEFINE VARIABLE link-handle  AS CHARACTER NO-UNDO.
     2131     DEFINE VARIABLE rowid-string AS CHARACTER NO-UNDO.
     2132     DO i = 1 TO NUM-ENTRIES(p-tbl-list):
     2133         IF i > 1 THEN p-rowid-list = p-rowid-list + ",":U.
     2134         CASE ENTRY(i, p-tbl-list):
     2135       WHEN "temp-dis-card-type":U THEN p-rowid-list = p-rowid-list +
     2136           IF AVAILABLE temp-dis-card-type THEN STRING(ROWID(temp-dis-card-type))
     2137           ELSE "?":U.
     2138           OTHERWISE
     2139           DO:
     2140               RUN get-link-handle IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     2141                   INPUT "RECORD-SOURCE":U, OUTPUT link-handle) NO-ERROR.
     2142               IF link-handle NE "":U THEN
     2143               DO:
     2144                   IF NUM-ENTRIES(link-handle) > 1 THEN
     2145                       MESSAGE "send-records in ":U THIS-PROCEDURE:FILE-NAME
     2146                               "encountered more than one RECORD-SOURCE.":U SKIP
     2147                               "The first will be used.":U
     2148                               VIEW-AS ALERT-BOX ERROR.
     2149                   RUN send-records IN WIDGET-HANDLE(ENTRY(1,link-handle))
     2150                       (INPUT ENTRY(i, p-tbl-list), OUTPUT rowid-string).
     2151                   p-rowid-list = p-rowid-list + rowid-string.
     2152               END.
     2153               ELSE
     2154               DO:
     2155                   MESSAGE "Requested table":U ENTRY(i, p-tbl-list)
     2156                           "does not match tables in send-records":U
     2157                           "in procedure":U THIS-PROCEDURE:FILE-NAME ".":U SKIP
     2158                           "Check that objects are linked properly and that":U
     2159                           "database qualification is consistent.":U
     2160                       VIEW-AS ALERT-BOX ERROR.
     2161                   RETURN ERROR.
     2162               END.
     2163           END.
     2164           END CASE.
     2165       END.
     2166   END PROCEDURE.
     2167   PROCEDURE state-changed :
     2168     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE NO-UNDO.
     2169     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     2170     CASE p-state:
     2171     END CASE.
     2172     IF INDEX(p-state, "SELECTOBJECT=") > 0 then do:
     2173           RUn ini-from-selobj in h_s-hour.
     2174     end.
     2175   END PROCEDURE.
