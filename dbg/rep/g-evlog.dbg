      405   procedure vss-get-info :
      406     define output parameter p-vss-revision    like vss-revision    no-undo .
      407     define output parameter p-vss-author      like vss-author      no-undo .
      408     define output parameter p-vss-date        like vss-date        no-undo .
      409     define output parameter p-vss-workfile    like vss-workfile    no-undo .
      410     define output parameter p-vss-archive     like vss-archive     no-undo .
      411     define output parameter p-vss-description like vss-description no-undo .
      412     assign
      413       p-vss-revision    = vss-revision
      414       p-vss-author      = vss-author
      415       p-vss-date        = vss-date
      416       p-vss-workfile    = vss-workfile
      417       p-vss-archive     = vss-archive
      418       p-vss-description = vss-description
      419     .
      420   end procedure.
      421   procedure vss-get-parameters :
      422     define output parameter p-vss-parameters as character no-undo .
      423   end procedure.
      424   define new global shared variable g#vssrevis-logger as handle    no-undo .
      425   define variable v-vssrevis-logevent                 as logical   no-undo init false .
      426   define variable v-vssrevis-logger                   as handle    no-undo .
      427   procedure vss-logevent :
      428     define input  parameter p-extra-paramters as character no-undo .
      429     define variable v-vssrevis-parameters as character no-undo .
      430     do
      431     on error undo, return error return-value
      432     :
      433       if  valid-handle(v-vssrevis-logger)
      434       and v-vssrevis-logger :get-signature("logevent") <> ""
      435       then do:
      436         run vss-get-parameters in this-procedure
      437           (output v-vssrevis-parameters
      438           ).
      439         run logevent in v-vssrevis-logger
      440           (input vss-workfile
      441           ,input vss-revision
      442           ,input v-vssrevis-parameters
      443           ,input p-extra-paramters
      444           ).
      445       end.
      446     end.
      447   end procedure.
      448   assign
      449     v-vssrevis-logger = g#vssrevis-logger
      450   .
      451   if  valid-handle(v-vssrevis-logger)
      452   and v-vssrevis-logger :get-signature("logevent") <> ""
      453   then do:
      454     assign
      455       v-vssrevis-logevent = true
      456     .
      457     run vss-logevent in this-procedure (input vss-description) .
      458   end.
      459   define new global shared variable g#language as character no-undo .
      460   if g#language <> '' and g#language <> 'rus':U then do:
      461     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      462   end.
      463   define new global shared variable g#library  as handle no-undo .
      464   define new global shared variable g#library2 as handle no-undo .
      465   procedure proc-alt-shift-f2:
      466     if not ibs.th.gbl.gbl-var:rcode
      467   then
      468     run gbl\inidebug.p .
      469   end.
      470   procedure proc-alt-shift-f3:
      471     run gbl/prvssinf.p
      472       ( input this-procedure
      473       ) .
      474   end.
      475   define variable v-inform-launched as logical no-undo initial false .
      476   procedure proc-alt-shift-f4:
      477     define variable v-action as character no-undo .
      478     if v-inform-launched = false then do:
      479       assign
      480         v-inform-launched = true
      481       .
      482       run gbl/d-inform.w
      483         (  input self
      484         ,  input this-procedure
      485         , output v-action
      486         ) no-error .
      487       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      488       assign
      489         v-inform-launched = false
      490       .
      491     end.
      492   end.
      493   procedure proc-alt-f1:
      494     run gbl/corrhelp.p
      495       (input this-procedure
      496       ) .
      497   end .
      498   on alt-shift-f2 anywhere do:
      499     run proc-alt-shift-f2.
      500   end.
      501   on alt-shift-f3 anywhere do:
      502     run proc-alt-shift-f3 in this-procedure .
      503   end.
      504   on alt-shift-f4 anywhere do:
      505     run proc-alt-shift-f4 in this-procedure.
      506   end.
      507   on alt-f1 anywhere do:
      508     run proc-alt-f1 in this-procedure .
      509   end.
      510   do
      511   on error undo, return error
      512   :
      513      run rep/d-report.w
      514         ( input parparentproc
      515         , input 'rep/e-evlog.w'
      516         , input "Журнал событий на кассе TH POS"
      517         , input 2
      518         , input "1,4,5"
      519         , input "2,4"
      520         , input ""
      521         , input ""
      522         , input "shop,1"
      523         , input NO
      524         ).
      525   end.
