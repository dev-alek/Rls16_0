     4172   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
     4173   procedure paramls-clear :
     4174     define buffer buf_temp-param for temp-param .
     4175     do
     4176     on error undo, return error return-value
     4177     :
     4178       for each buf_temp-param
     4179       on error undo, return error
     4180       :
     4181         delete buf_temp-param .
     4182       end.
     4183     end.
     4184   end procedure.
     4185   procedure paramls-write :
     4186     define input  parameter p-code     as character no-undo .
     4187     define input  parameter p-sub-code as character no-undo .
     4188     define input  parameter p-value    as character no-undo .
     4189     define buffer buf_temp-param for temp-param .
     4190     do
     4191     on error undo, return error return-value
     4192     :
     4193       find first buf_temp-param
     4194         where buf_temp-param.param-code     = p-code
     4195           and buf_temp-param.param-sub-code = p-sub-code
     4196         no-error .
     4197       if not available buf_temp-param then do:
     4198         create buf_temp-param .
     4199         assign
     4200           buf_temp-param.param-code     = p-code
     4201           buf_temp-param.param-sub-code = p-sub-code
     4202         .
     4203       end.
     4204       assign
     4205         buf_temp-param.param-value = p-value
     4206       .
     4207     end.
     4208   end procedure.
     4209   procedure paramls-read :
     4210     define input  parameter p-code          as character no-undo .
     4211     define input  parameter p-sub-code      as character no-undo .
     4212     define input  parameter p-default-value as character no-undo .
     4213     define output parameter p-value         as character no-undo .
     4214     define buffer buf_temp-param for temp-param .
     4215     do
     4216     on error undo, return error return-value
     4217     :
     4218       find first buf_temp-param
     4219         where buf_temp-param.param-code     = p-code
     4220           and buf_temp-param.param-sub-code = p-sub-code
     4221         no-error .
     4222       if available buf_temp-param then do:
     4223         assign
     4224           p-value = buf_temp-param.param-value
     4225         .
     4226       end.
     4227       else do:
     4228         assign
     4229           p-value = p-default-value
     4230         .
     4231       end.
     4232     end.
     4233   end procedure.
     4234   procedure paramls-append :
     4235     define input  parameter p-code     as character no-undo .
     4236     define input  parameter p-sub-code as character no-undo .
     4237     define input  parameter p-value    as character no-undo .
     4238     define buffer buf_temp-param for temp-param .
     4239     do
     4240     on error undo, return error return-value
     4241     :
     4242       find first buf_temp-param
     4243            where buf_temp-param.param-code     = p-code
     4244              and buf_temp-param.param-sub-code = p-sub-code
     4245         no-error .
