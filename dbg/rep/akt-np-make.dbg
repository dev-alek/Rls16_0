     1083   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1084   procedure wthcattr-sprcli :
     1085   define input parameter parparentproc  as widget-handle no-undo.
     1086   define input parameter p-mode  as character no-undo.
     1087   define input-output parameter p-value as character no-undo .
     1088   define output parameter p-setted as logical no-undo .
     1089     DEFINE VARIABLE v-value as character no-undo .
     1090     define variable v-cli-type as character no-undo .
     1091     define variable v-cli-code as integer no-undo .
     1092     define buffer buf_clients   for ub.clients.
     1093     define variable v_rid as character no-undo.
     1094     define variable ref-rec as recid no-undo .
     1095     do
     1096     on error undo, return error
     1097     :
     1098         v-value = p-value.
     1099      if p-value <> '':U then do:
     1100       assign
     1101       v-cli-type = substring(p-value, 1, 3)
     1102       v-cli-code = integer(substring(p-value, 4))
     1103       no-error.
     1104       if error-status:error then do:
     1105         assign
     1106         v-cli-type = '':U
     1107         v-cli-code = 0
     1108         .
     1109       end.
     1110      end.
     1111      FIND FIRST buf_clients NO-LOCK WHERE
     1112               buf_clients.obj-type = v-cli-type AND
     1113               buf_clients.obj-code = v-cli-code  NO-ERROR.
     1114      IF available(buf_clients) then do:
     1115       run ref/cli-all.w (
     1116                   input parparentproc
     1117                  ,input if p-mode = 'ИЗМЕНЕНИЕ':U then "b-sel":U else "":U
     1118                  ,input v-cli-type
     1119                  ,input 'все':U
     1120                  ,input 'все':U
     1121                  ,input RECID( buf_clients )
     1122                  ,input ",,,,,,NO"
     1123                  ,input ?
     1124                  ,OUTPUT v_rid ).
     1125     END.
     1126     ELSE if p-mode = 'ИЗМЕНЕНИЕ':U then DO:
     1127       run ref/cli-all.w (
     1128                    input parparentproc
     1129                   ,INPUT "b-sel":U
     1130                  ,input  v-cli-type
     1131                  ,input 'все':U
     1132                  ,input 'текущие':U
     1133                  ,input ?
     1134                  ,input ",,,,,,NO"
     1135                  ,input ?
     1136                  ,OUTPUT v_rid ).
     1137     END.
     1138     else do:
     1139       message
     1140       if p-value = "":U then 'Атрибут не задан!'
     1141       else substitute('Не найден клиент &1',p-value)
     1142       view-as alert-box warning.
     1143     end.
     1144     IF v_rid <> ? AND v_rid <> "":U THEN DO:
     1145       ASSIGN ref-rec = INT( v_rid ) NO-ERROR.
     1146       IF ERROR-STATUS:ERROR THEN DO:
     1147           RETURN NO-APPLY.
     1148       END.
     1149       FIND FIRST buf_clients NO-LOCK WHERE
     1150                  RECID( buf_clients ) = ref-rec NO-ERROR.
     1151       IF AVAIL buf_clients THEN DO:
     1152         v-value = buf_clients.obj-type + string(buf_clients.obj-code, ">>>>>>>>9").
     1153       end.
     1154     end.
     1155     if v-value <> p-value then do:
     1156       p-value = v-value.
     1157       p-setted = yes.
     1158     end.
     1159     end.
     1160   end procedure.
     1161     define new global shared variable g#wthcalib as handle no-undo.
     1162   procedure torgconf-read :
     1163   do
     1164   on error undo, return error
     1165   :
     1166       define input parameter p-form-name  as character    no-undo.
     1167       define input parameter p-host-code  as integer      no-undo.
     1168       define input parameter p-obj-type   as character    no-undo.
     1169       define input parameter p-obj-code   as integer      no-undo.
     1170       define variable v-outdate   as character     no-undo.
     1171       define variable v-outares   as character     no-undo.
     1172       define variable v-outsend   as character     no-undo.
     1173       define variable v-outasend  as character     no-undo.
     1174       define variable v-outprops  as character     no-undo.
     1175       define variable v-outnum    as character     no-undo.
     1176       define variable v-outprim   as character     no-undo.
     1177       define variable v-outdisc   as character     no-undo.
     1178       define variable v-outsubs   as character     no-undo.
     1179       define variable v-outrecv   as character     no-undo.
     1180       define variable v-outegrp   as character     no-undo.
     1181       define variable v-outt12    as character     no-undo.
     1182       define variable v-outappr   as character     no-undo.
     1183       define variable v-outrubl   as character     no-undo.
     1184       define variable v-outhold   as character     no-undo.
     1185       define variable v-outobj    as character     no-undo.
     1186       define variable v-outexlst  as character     no-undo.
     1187       define variable v-outprncd  as character     no-undo.
     1188       define variable v-par-type  as character     no-undo.
     1189       define variable v-outogr    as character     no-undo.
     1190       define variable v-outR      as character     no-undo.
     1191       define variable v-outB      as character     no-undo.
     1192       define variable v-outC      as character     no-undo.
     1193       assign
     1194           v-torgconf-outdate  = no
     1195           v-torgconf-outnum   = no
     1196           v-torgconf-outprim  = no
     1197           v-torgconf-outdisc  = no
     1198           v-torgconf-outsubs  = no
     1199           v-torgconf-outrecv  = no
     1200           v-torgconf-outegrp  = no
     1201           v-torgconf-outt12   = no
     1202           v-torgconf-outappr  = no
     1203           v-torgconf-outrubl  = no
     1204           v-torgconf-outhold  = no
     1205           v-torgconf-outobj   = no
     1206           v-torgconf-outexlst = no
     1207           v-torgconf-outexpas = "":U
     1208           v-torgconf-outprncd = yes
     1209           v-torgconf-outares  = no
     1210           v-torgconf-outsend  = no
     1211           v-torgconf-outasend  = no
     1212           v-torgconf-outprops  = no
     1213           v-form-name          = p-form-name
     1214       .
     1215   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1216   empty temp-table thbjattr_thbj-attr.
     1217   run adm/shattri.p (
     1218      input "get":U
     1219     ,input ''
     1220     ,input 0
     1221     ,input 'prt-glob':U
     1222     ,input  ""
     1223     ,output v-value-character
     1224     ,output v-value-date
     1225     ,output v-value-decimal
     1226     ,output v-value-integer
     1227     ,output v-value-logical
     1228     ,output par-type
     1229     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     1230     ) no-error .
     1231   for each thbjattr_thbj-attr :
     1232       if thbjattr_thbj-attr.prop-code = 'outprncd':U then v-outprncd =  string(thbjattr_thbj-attr.property-value-logical) .
     1233       if thbjattr_thbj-attr.prop-code = 'outrecv':U  then v-outrecv  =  thbjattr_thbj-attr.property-value-character .
     1234       if thbjattr_thbj-attr.prop-code = 'outprops':U then v-outprops =  thbjattr_thbj-attr.property-value-character .
     1235   end.
     1236   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1237   empty temp-table thbjattr_thbj-attr.
     1238   run adm/shattri.p (
     1239      input "get":U
     1240     ,input p-obj-type
     1241     ,input p-obj-code
     1242     ,input 'prt-obj':U
     1243     ,input  ""
     1244     ,output v-value-character
     1245     ,output v-value-date
     1246     ,output v-value-decimal
     1247     ,output v-value-integer
     1248     ,output v-value-logical
     1249     ,output par-type
     1250     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     1251     ) no-error .
     1252   for each thbjattr_thbj-attr :
     1253       if thbjattr_thbj-attr.prop-code = 'outdate':U  then v-outdate  =  thbjattr_thbj-attr.property-value-character .
     1254       if thbjattr_thbj-attr.prop-code = 'outares':U  then v-outares  =  thbjattr_thbj-attr.property-value-character .
     1255       if thbjattr_thbj-attr.prop-code = 'outnum':U   then v-outnum   =  thbjattr_thbj-attr.property-value-character .
     1256       if thbjattr_thbj-attr.prop-code = 'outprim':U  then v-outprim  =  thbjattr_thbj-attr.property-value-character .
     1257       if thbjattr_thbj-attr.prop-code = 'outdisc':U  then v-outdisc  =  thbjattr_thbj-attr.property-value-character .
     1258       if thbjattr_thbj-attr.prop-code = 'outsubs':U  then v-outsubs  =  thbjattr_thbj-attr.property-value-character .
     1259       if thbjattr_thbj-attr.prop-code = 'outegrp':U  then v-outegrp  =  thbjattr_thbj-attr.property-value-character .
     1260       if thbjattr_thbj-attr.prop-code = 'outt12':U   then v-outt12   =  thbjattr_thbj-attr.property-value-character .
     1261       if thbjattr_thbj-attr.prop-code = 'outappr':U  then v-outappr  =  thbjattr_thbj-attr.property-value-character .
     1262       if thbjattr_thbj-attr.prop-code = 'outrubl':U  then v-outrubl  =  thbjattr_thbj-attr.property-value-character .
     1263       if thbjattr_thbj-attr.prop-code = 'outhold':U  then v-outhold  =  thbjattr_thbj-attr.property-value-character .
     1264       if thbjattr_thbj-attr.prop-code = 'outobj':U   then v-outobj   =  thbjattr_thbj-attr.property-value-character .
     1265       if thbjattr_thbj-attr.prop-code = 'outsend':U  then v-outsend  =  thbjattr_thbj-attr.property-value-character .
     1266       if thbjattr_thbj-attr.prop-code = 'outasend':U then v-outasend =  thbjattr_thbj-attr.property-value-character .
     1267       if thbjattr_thbj-attr.prop-code = 'outogr':U   then v-torgconf-outogr   =  thbjattr_thbj-attr.property-value-character .
     1268       if thbjattr_thbj-attr.prop-code = 'outR':U     then v-torgconf-outR     =  thbjattr_thbj-attr.property-value-character .
     1269       if thbjattr_thbj-attr.prop-code = 'outB':U     then v-torgconf-outB     =  thbjattr_thbj-attr.property-value-character .
     1270       if thbjattr_thbj-attr.prop-code = 'outssdoc':U then v-torgconf-outssdoc =  thbjattr_thbj-attr.property-value-character .
     1271       if thbjattr_thbj-attr.prop-code = 'outC':U     then v-torgconf-outC     =  thbjattr_thbj-attr.property-value-character .
     1272   end.
     1273       run gbl/conf-rd.p ("outexpas", "":U, "":U, 0, "":U, "":U, "":U, no, output v-torgconf-outexpas, output v-par-type) no-error.
     1274       if error-status :error
     1275       then do:
     1276           assign
     1277               v-torgconf-outexpas = "":U
     1278           .
     1279       end.
     1280       assign
     1281           v-torgconf-outprncd = ( v-outprncd = "yes":U )
     1282       .
     1283       if p-form-name <> ""
     1284       and p-form-name <> ?
     1285       then do:
     1286           run gbl/conf-rd.p ("outexlst" , p-host-code, p-obj-type, p-obj-code, "", "", "", no, output v-outexlst , output v-par-type) no-error.
     1287           if error-status :error
     1288           then do:
     1289               assign
     1290                   v-outexlst           = ""
     1291               .
     1292           end.
     1293           if lookup( p-form-name, v-outdate ) <> 0
     1294           then do:
     1295               assign
     1296                   v-torgconf-outdate  = yes
     1297               .
     1298           end.
     1299           if lookup( p-form-name, v-outares ) <> 0
     1300           then do:
     1301               assign
     1302                   v-torgconf-outares  = yes
     1303               .
     1304           end.
     1305           if lookup( p-form-name, v-outnum  ) <> 0
     1306           then do:
     1307               assign
     1308                   v-torgconf-outnum   = yes
     1309               .
     1310           end.
     1311           if lookup( p-form-name, v-outprim ) <> 0
     1312           then do:
     1313               assign
     1314                   v-torgconf-outprim  = yes
     1315               .
     1316           end.
     1317           if lookup( p-form-name, v-outdisc ) <> 0
     1318           then do:
     1319               assign
     1320                   v-torgconf-outdisc  = yes
     1321               .
     1322           end.
     1323           if lookup( p-form-name, v-outsubs ) <> 0
     1324           then do:
     1325               assign
     1326                   v-torgconf-outsubs  = yes
     1327               .
     1328           end.
     1329           if lookup( p-form-name, v-outrecv ) <> 0
     1330           then do:
     1331               assign
     1332                   v-torgconf-outrecv  = yes
     1333               .
     1334           end.
     1335           if lookup( p-form-name, v-outegrp ) <> 0
     1336           then do:
     1337               assign
     1338                   v-torgconf-outegrp  = yes
     1339               .
     1340           end.
     1341           if lookup( p-form-name, v-outt12  ) <> 0
     1342           then do:
     1343               assign
     1344                   v-torgconf-outt12   = yes
     1345               .
     1346           end.
     1347           if lookup( p-form-name, v-outappr  ) <> 0
     1348           then do:
     1349               assign
     1350                   v-torgconf-outappr   = yes
     1351               .
     1352           end.
     1353           if lookup( p-form-name, v-outrubl  ) <> 0
     1354           then do:
     1355               assign
     1356                   v-torgconf-outrubl   = yes
     1357               .
     1358           end.
     1359           if lookup( p-form-name, v-outhold  ) <> 0
     1360           then do:
     1361               assign
     1362                   v-torgconf-outhold   = yes
     1363               .
     1364           end.
     1365           if lookup( p-form-name, v-outobj   ) <> 0
     1366           then do:
     1367               assign
     1368                   v-torgconf-outobj    = yes
     1369               .
     1370           end.
     1371           if lookup( p-form-name, v-outsend   ) <> 0
     1372           then do:
     1373               assign
     1374                   v-torgconf-outsend    = yes
     1375               .
     1376           end.
     1377           if lookup( p-form-name, v-outasend   ) <> 0
     1378           then do:
     1379               assign
     1380                   v-torgconf-outasend    = yes
     1381               .
     1382           end.
     1383           if lookup( p-form-name, v-outprops   ) <> 0
     1384           then do:
     1385               assign
     1386                   v-torgconf-outprops    = yes
     1387               .
     1388           end.
     1389           if lookup( p-form-name, v-outexlst ) <> 0
     1390           then do:
     1391               assign
     1392                   v-torgconf-outexlst  = yes
     1393               .
     1394           end.
     1395        assign
     1396         v-name = p-form-name.
     1397   end.
     1398   end.
     1399   end procedure.
     1400   procedure torgconf-get-self-param :
     1401   define input parameter p-obj-type           as character        no-undo.
     1402   define input parameter p-obj-code           as integer          no-undo.
     1403   define input parameter p-curr-code          as integer          no-undo.
     1404       define variable v-host-code    as integer      no-undo.
     1405       define variable v-par-type     as character    no-undo.
     1406   do
     1407   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message(1))
     1408   :
     1409   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1410   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1411     (input  p-obj-type
     1412     ,input  p-obj-code
     1413     ,output v-host-code
     1414     )  .
     1415       if v-torgconf-outhold = yes
     1416       then do:
     1417           run torgconf-get-holdfirm-code in this-procedure (
     1418                 input p-obj-type
     1419               , input p-obj-code
     1420               , output v-torgconf-self-host-code
     1421           ).
     1422           if v-torgconf-self-host-code = 0
     1423           then do:
     1424               return error.
     1425           end.
     1426       end.
     1427       else do:
     1428           assign
     1429               v-torgconf-self-host-code = v-host-code
     1430           .
     1431       end.
     1432       if v-torgconf-self-host-code = 0
     1433       then do:
     1434           assign
     1435               v-torgconf-self-host-name           = "":U
     1436               v-torgconf-self-host-addres         = "":U
     1437               v-torgconf-self-host-post-addres    = "":U
     1438               v-torgconf-self-host-phone          = "":U
     1439               v-torgconf-self-host-inn            = "":U
     1440               v-torgconf-self-host-kpp            = "":U
     1441               v-torgconf-self-host-okpo           = "":U
     1442               v-torgconf-self-host-egrip-date     = "":U
     1443               v-torgconf-self-host-egrip-num      = "":U
     1444           .
     1445       end.
     1446       else do:
     1447           run fmtcli-get-client in this-procedure (
     1448                 input 'орг':U
     1449               , input v-torgconf-self-host-code
     1450           ).
     1451           assign
     1452               v-torgconf-self-host-name        = v-fmtcli-name
     1453               v-torgconf-self-host-engl-name   = v-fmtcli-engl-name
     1454               v-torgconf-self-host-addres      = v-fmtcli-full-addres
     1455               v-torgconf-self-host-post-addres = v-fmtcli-post-addres
     1456               v-torgconf-self-host-phone       = v-fmtcli-phone
     1457               v-torgconf-self-host-inn         = v-fmtcli-inn
     1458               v-torgconf-self-host-kpp         = v-fmtcli-kpp
     1459               v-torgconf-self-host-okpo        = v-fmtcli-okpo
     1460           .
     1461           run gbl/clntat-v.p (
     1462                 input 'орг':U
     1463               , input v-torgconf-self-host-code
     1464               , input 'egrip-date':U
     1465               , output v-torgconf-self-host-egrip-date
     1466               , output v-par-type
     1467           ).
     1468           run gbl/clntat-v.p (
     1469                 input 'орг':U
     1470               , input v-torgconf-self-host-code
     1471               , input 'egrip-num':U
     1472               , output v-torgconf-self-host-egrip-num
     1473               , output v-par-type
     1474           ).
     1475           run fmtcli-get-bank in this-procedure (
     1476                 input v-host-code
     1477               , input 'орг':U
     1478               , input v-torgconf-self-host-code
     1479               , input p-curr-code
     1480           ).
     1481       end.
     1482       assign
     1483           v-torgconf-self-schet-exists = v-fmtcli-schet-exists
     1484           v-torgconf-self-bank-exists  = v-fmtcli-bank-exists
     1485           v-torgconf-self-bank-r-schet = v-fmtcli-bank-r-schet
     1486           v-torgconf-self-bank-c-schet = v-fmtcli-bank-c-schet
     1487           v-torgconf-self-bank-bik     = v-fmtcli-bank-bik
     1488           v-torgconf-self-bank-name    = v-fmtcli-bank-name
     1489           v-torgconf-self-bank-addres  = v-fmtcli-bank-addres
     1490           v-torgconf-self-bank-city    = v-fmtcli-bank-city
     1491       .
     1492       assign
     1493           v-torgconf-self-obj-type = p-obj-type
     1494           v-torgconf-self-obj-code = p-obj-code
     1495       .
     1496       run fmtcli-get-client in this-procedure (
     1497             input p-obj-type
     1498           , input p-obj-code
     1499       ).
     1500       assign
     1501           v-torgconf-self-obj-name       = v-fmtcli-name
     1502           v-torgconf-self-obj-engl-name  = v-fmtcli-engl-name
     1503           v-torgconf-self-obj-addres     = v-fmtcli-full-addres
     1504           v-torgconf-temp-post-addres    = v-fmtcli-post-addres
     1505           v-torgconf-self-obj-phone      = v-fmtcli-phone
     1506           v-torgconf-self-obj-inn        = v-fmtcli-inn
     1507           v-torgconf-self-obj-okpo       = v-fmtcli-okpo
     1508       .
     1509   end.
     1510   end procedure.
     1511   procedure torgconf-get-recepient-param :
     1512   define input parameter torgconfdoc-code   as character                  no-undo.
     1513   define output parameter v-code-rec        as integer                    no-undo .
     1514   define output parameter v-type-rec        as character                  no-undo initial 'C':U.
     1515   define output parameter v-codefirm-rec    as integer                    no-undo .
     1516   define output parameter v-curcode-rec     as integer                    no-undo .
     1517        define variable  v-recipient-code  as character                  no-undo .
     1518        define variable  v-recipient       like ub.doc-attr.attr-value   no-undo.
     1519        define variable  v-trdcattr-type   as character                  no-undo initial 'C':U.
     1520   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input torgconfdoc-code ,
     1521                           input 'Recipient':U ,
     1522                          output v-recipient-code ,
     1523                          output v-trdcattr-type ) no-error .
     1524       if error-status :error then do:
     1525        message
     1526         vss-workfile vss-revision vss-description skip
     1527         "Ошибка при вызове процедуры tdat-val":U skip
     1528         "Документ: " torgconfdoc-code skip
     1529         "Атрибут: " 'Recipient':U skip
     1530         "Значение: " v-recipient skip
     1531         trim( error-status :get-message (1) ) skip
     1532         return-value skip
     1533         view-as alert-box error.
     1534       undo, return error return-value.
     1535       end.
     1536     assign
     1537       v-recipient  = v-recipient-code
     1538       v-type-rec = substring(v-recipient-code,1,3)
     1539       v-code-rec  = int(substring(v-recipient-code,4,15))
     1540       no-error
     1541     .
     1542     if v-type-rec = ? then v-type-rec = "" .
     1543     if v-code-rec  = ? then v-code-rec  =  0 .
     1544     end procedure.
     1545   procedure torgconf-get-wthrecepient-param :
