     4314       .
     4315       assign
     4316           rootnode_code = gds-prt.node-code
     4317       .
     4318               find first bar-code no-lock
     4319                    where bar-code.gds-code = goods.gds-code
     4320                      and bar-code.unit-cli = goods.unit-base
     4321                      and bar-code.node-code = rootnode_code
     4322                      and bar-code.part-code = ""
     4323                      and bar-code.in-code = ""
     4324               .
     4325               find first gds-dtl no-lock
     4326                    where gds-dtl.doc-code = doc-line.doc-code
     4327                      and gds-dtl.prod-type = doc-line.prod-type
     4328                      and gds-dtl.prod-code = doc-line.prod-code
     4329                      and gds-dtl.artic = doc-line.artic
     4330                      and gds-dtl.prt-code = rootnode_code
     4331               .
     4332               assign
     4333                   tqnty = gds-dtl.fact-qnty
     4334               .
     4335           find first pl-gds where pl-gds.gds-code = goods.gds-code
     4336                               and pl-gds.obj-code = OurObject.obj-code
     4337                               and pl-gds.obj-type = OurObject.obj-type no-error.
     4338              if AVAILABLE pl-gds then do:
     4339                  v-pl-code = pl-gds.pl-code .
     4340              end.
     4341       accumulate
     4342           tqnty (total)
     4343       .
     4344           output stream OutStr-html to value(v-report-name-html) convert target 'UTF-8' .
     4345           put stream OutStr-html unformatted
     4346           substitute(
     4347             '<!doctype html>
     4348               <html>
     4349                 <head>
     4350                 <meta charset="UTF-8">
     4351                     <!-- Стили документа -->
     4352                 <style>
     4353                      table ~{
     4354                          border-collapse: collapse;
     4355                          
     4356                           
     4357                          
     4358                      ~}
     4359                      .class1 ~{
     4360                          border-collapse: collapse;
     4361                      ~}
     4362                      td, th ~{
     4363                          border: 0px solid black;
     4364                          border-collapse: collapse;
     4365                          text_wrap: true;              
     4366                      ~}
     4367             
     4368                 </style>
     4369                 </head>
     4370                   <body>
     4371                     <table orientation="portrait" name="&1" fit_to_page="true">  <!-- таблица, в которой содержится весь отчет -->
     4372                       <!-- Обязательно создаётся строка таблицы, в которой находятся размеры колонок в px-->
     4373                       <thead>  
     4374                         <tr class="set_columns">
     4375                           <td style="width:60px"></td>
     4376                           <td style="width:60px"></td>
     4377                           <td style="width:100px"></td>
     4378                           <td style="width:100px"></td>
     4379                           <td style="width:100px"></td>
     4380                           <td style="width:100px"></td>
     4381                           <td style="width:80px"></td>
     4382                           <td style="width:200px"></td>
     4383                           <td style="width:10px"></td>
     4384                         </tr>
     4385                       <tr>
     4386                         <td colspan="5"></td>
     4387                         <td colspan="4" style="text-align: center; height: 30px;">Утверждаю</td>
     4388                       </tr>
     4389                       <tr>
     4390                         <td colspan="5"></td>
     4391                         <td colspan="4" style="border-bottom: 1px solid black; height: 30px;"></td>
     4392                       </tr>
     4393                       <tr>
     4394                         <td colspan="5"></td>
     4395                         <td colspan="4" style="text-align: center;">(должность руководителя)</td>
     4396                       </tr>                    
     4397                       <tr>
     4398                         <td colspan="5"></td>
     4399                         <td colspan="4" style="border-bottom: 1px solid black; text-align: center; height: 30px;"></td>
     4400                       </tr>
     4401                       <tr>
     4402                         <td colspan="5"></td>
     4403                         <td colspan="4" style="text-align: center;">(фамилия, инициалы руководителя)</td>
     4404                       </tr>
     4405                       <tr>
     4406                         <td colspan="5"></td>
     4407                         <td colspan="4" style="height: 30px;">" ___ "  __________________  20__  г.</td>
     4408                       </tr>
     4409                       <tr>
     4410                         <td colspan="9" style="height: 150px;"></td>
     4411                       </tr> 
     4412                       <tr>
     4413                         <td colspan="9" style="text-align: center; height: 30px;">АКТ</td>
     4414                       </tr>
     4415                       <tr>
     4416                         <td colspan="9" style="text-align: center; height: 30px;">учета нефтепродуктов при выполнении</td>
     4417                       </tr>   
     4418                       <tr>
     4419                         <td colspan="9" style="text-align: center; height: 30px;">ремонтных работ на ТРК (МРК)</td>
     4420                       </tr>   
     4421                       <tr style="height: 30px;">
     4422                         <td colspan="4">Основание выполнения работ</td>
     4423                         <td colspan="5" style="border-bottom: 1px solid black;"></td>
     4424                       </tr>  
     4425                       <tr style="height: 30px;">
     4426                         <td colspan="4">Исполнители ремонтных работ</td>
     4427                         <td colspan="5" style="border-bottom: 1px solid black;"></td>
     4428                       </tr>  
     4429                       <tr>
     4430                         <td colspan="4" style="text-align: right;"></td>
     4431                         <td colspan="5" style="text-align: center;">(должность, фамилия и инициалы)</td>
     4432                       </tr>  
     4433                       <tr style="height: 30px;">
     4434                         <td colspan="9" style="border-bottom: 1px solid black;"></td>
     4435                       </tr>  
     4436                       <tr>
     4437                         <td colspan="9" style="text-align: center;">(должность, фамилия и инициалы)</td>
     4438                       </tr>  
     4439                       <tr style="height: 30px;">
     4440                         <td colspan="3">Оператор АЗС</td>
     4441                         <td colspan="6" style="border-bottom: 1px solid black;"></td>
     4442                       </tr> 
     4443                       <tr style="height: 30px;">
     4444                         <td colspan="4">&2</td>
     4445                         <td>на АЗС</td>
     4446                         <td colspan="4" style="text-align: center; border-bottom: 1px solid black;">&3</td>
     4447                       </tr>  
     4448                       <tr>
     4449                         <td colspan="4"></td>
     4450                         <td></td>
     4451                         <td colspan="4" style="text-align: center;">(№ или наименование АЗС)</td>
     4452                       </tr>
     4453                       <tr style="height: 30px;">
     4454                         <td colspan="3">принадлежащей</td>
     4455                         <td colspan="5" style="border-bottom: 1px solid black; text-align: center;">&4</td>
     4456                         <td></td>
     4457                       </tr>
     4458                       <tr style="height: 30px;">
     4459                         <td colspan="2">Продукт</td>
     4460                         <td colspan="2" style="border-bottom: 1px solid black; text-align: center;">&5</td>
     4461                         <td colspan="5" style="text-align: center;">, отпущенный через ТРК № __________, пост</td>
     4462                       </tr> 
     4463                       <tr style="height: 30px;">
     4464                         <td colspan="4">№ _________________________ в объеме</td>
     4465                         <td colspan="2" style="border-bottom: 1px solid black; text-align: center;">&6</td>
     4466                         <td colspan="3" style="text-align: right;"> литров в резервуар </td>
     4467                       </tr> 
     4468                       <tr style="height: 30px;">
     4469                         <td>№</td>
     4470                         <td colspan="3" style="border-bottom: 1px solid black; text-align: center;">&7</td>
     4471                         <td colspan="5"></td>
     4472                       </tr> 
     4473                       <tr style="height: 30px;">
     4474                         <td colspan="6">Показания суммарного счетчика до прокачки</td>
     4475                         <td colspan="3" style="border-bottom: 1px solid black; text-align: right;">,</td>
     4476                        
     4477                       </tr> 
     4478                       <tr style="height: 30px;">
     4479                         <td colspan="4"></td>  
     4480                         <td colspan="2">после прокачки</td>
     4481                         <td colspan="3" style="border-bottom: 1px solid black; text-align: right;">.</td>
     4482                         
     4483                       </tr> 
     4484                       <tr style="height: 60px;">
     4485                         <td colspan="2">Подписи</td>  
     4486                         <td colspan="4" style="border-bottom: 1px solid black;"></td>
     4487                         <td colspan="3"></td>
     4488                       </tr> 
     4489                       <tr style="height: 30px;">
     4490                         <td colspan="2"></td>  
     4491                         <td colspan="4" style="border-bottom: 1px solid black;"></td>
     4492                         <td colspan="3"></td>
     4493                       </tr> 
     4494                       <tr style="height: 30px;">
     4495                         <td colspan="2"></td>  
     4496                         <td colspan="4" style="border-bottom: 1px solid black;"></td>
     4497                         <td colspan="3"></td>
     4498                       </tr> 
     4499                       </thead>'
     4500         ,
     4501           string(goods.gds-code),
     4502           v-doc-date-string,
     4503           string(OurObject.obj-name),
     4504           string(t-okpo),
     4505           string(goods.gds-name),
     4506           tqnty,
     4507           v-pl-code
     4508         ).
     4509         put stream OutStr-html unformatted
     4510           substitute (
     4511           '
     4512           </body>
     4513           </html>
     4514           '
     4515               , chr(123), chr(125)
     4516          ).
     4517   output stream OutStr-html close.
     4518   end.
     4519           run prn-lib-reportviewer in this-procedure (
     4520               input p-mainmenu-handle
     4521               ,input v-report-name-html
     4522               ,input ""
     4523               ) no-error.
     4524           if error-status:error then
     4525           do:
     4526               message return-value view-as alert-box.
     4527               return .
     4528           end.
     4529   end.
