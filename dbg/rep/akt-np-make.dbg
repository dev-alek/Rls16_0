     1880   procedure torgconf-get-ship-param :
     1881   define input parameter p-host-obj-code      as integer          no-undo.
     1882   define input parameter p-obj-type           as character        no-undo.
     1883   define input parameter p-obj-code           as integer          no-undo.
     1884   define input parameter p-curr-code          as integer          no-undo.
     1885       define variable v-host-code    as integer      no-undo.
     1886   do
     1887   on error undo, return error
     1888   :
     1889       assign
     1890           v-torgconf-ship-type = p-obj-type
     1891           v-torgconf-ship-code = p-obj-code
     1892       .
     1893       if trim(p-obj-type) = ""
     1894       and p-obj-code = 0
     1895       then do:
     1896       assign
     1897           v-torgconf-ship-name         = "":U
     1898           v-torgconf-ship-addres       = "":U
     1899           v-torgconf-ship-post-addres  = "":U
     1900           v-torgconf-ship-phone        = "":U
     1901           v-torgconf-ship-inn          = "":U
     1902           v-torgconf-ship-kpp          = "":U
     1903           v-torgconf-ship-okpo         = "":U
     1904       .
     1905       end.
     1906       else do:
     1907       run fmtcli-get-client in this-procedure (
     1908             input p-obj-type
     1909           , input p-obj-code
     1910       ).
     1911       assign
     1912           v-torgconf-ship-name         = trim( v-fmtcli-name          )
     1913           v-torgconf-ship-engl-name    = trim( v-fmtcli-engl-name          )
     1914           v-torgconf-ship-addres       = trim( v-fmtcli-full-addres   )
     1915           v-torgconf-ship-post-addres  = trim( v-fmtcli-post-addres   )
     1916           v-torgconf-ship-phone        = trim( v-fmtcli-phone         )
     1917           v-torgconf-ship-inn          = trim( v-fmtcli-inn           )
     1918           v-torgconf-ship-kpp          = trim( v-fmtcli-kpp           )
     1919           v-torgconf-ship-okpo         = trim( v-fmtcli-okpo          )
     1920       .
     1921       end.
     1922           run fmtcli-get-bank in this-procedure (
     1923             input p-host-obj-code
     1924           , input p-obj-type
     1925           , input p-obj-code
     1926           , input p-curr-code
     1927       ).
     1928       assign
     1929           v-torgconf-ship-schet-exists = v-fmtcli-schet-exists
     1930           v-torgconf-ship-bank-exists  = v-fmtcli-bank-exists
     1931           v-torgconf-ship-bank-r-schet = v-fmtcli-bank-r-schet
     1932           v-torgconf-ship-bank-c-schet = v-fmtcli-bank-c-schet
     1933           v-torgconf-ship-bank-bik     = v-fmtcli-bank-bik
     1934           v-torgconf-ship-bank-name    = v-fmtcli-bank-name
     1935           v-torgconf-ship-bank-addres  = v-fmtcli-bank-addres
     1936           v-torgconf-ship-bank-city    = v-fmtcli-bank-city
     1937       .
     1938   end.
     1939   end procedure.
     1940   procedure torgconf-get-holdfirm-code :
     1941   define input parameter p-obj-type   as character        no-undo.
     1942   define input parameter p-obj-code   as integer          no-undo.
     1943   define output parameter p-firm-code as integer          no-undo.
     1944       define variable v-firm-code-str     as character    no-undo.
     1945       define variable v-par-type          as character    no-undo.
     1946       define buffer buf_clients       for ub.clients.
     1947   do
     1948   for buf_clients
     1949   on error undo, return error
     1950   :
     1951       run gbl/clntat-v.p (
     1952             input p-obj-type
     1953           , input p-obj-code
     1954           , input 'holdfirm-code':U
     1955           , output v-firm-code-str
     1956           , output v-par-type
     1957       ).
     1958       assign
     1959           p-firm-code = integer( v-firm-code-str )
     1960       no-error.
     1961       if error-status :error
     1962       then do:
     1963           message
     1964               "Неверно задан код фирмы для печати накладных."
     1965           view-as alert-box warning.
     1966           assign
     1967               p-firm-code = 0
     1968           .
     1969       end.
     1970       else do:
     1971           find first buf_clients no-lock
     1972                where buf_clients.obj-type = 'орг':U
     1973                  and buf_clients.obj-code = p-firm-code
     1974           no-error.
     1975           if not available buf_clients
     1976           then do:
     1977               message
     1978                   "Включен параметр 'Список печатных форм, для которых должна быть задана фирма для печати накладных' (outhold)" skip
     1979                   "Не найдена фирма по заданному коду фирмы для печати накладных."
     1980               view-as alert-box warning.
     1981               assign
     1982                   p-firm-code = 0
     1983               .
     1984           end.
     1985       end.
     1986   end.
     1987   end procedure.
     1988   procedure torgconf-get-post-head:
     1989   define input  parameter p-obj-type             as character        no-undo.
     1990   define input  parameter p-obj-code             as integer          no-undo.
     1991   define output parameter p-torgconf-post-head   as character        no-undo.
     1992      define variable v-host-code         as integer      no-undo.
     1993      define buffer buf_sysconf     for ub.sysconf.
     1994        assign
     1995         p-torgconf-post-head  = ""
     1996        .
     1997   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1998   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1999     (input  p-obj-type
     2000     ,input  p-obj-code
     2001     ,output v-host-code
     2002     )  .
     2003      find first buf_sysconf no-lock
     2004      where buf_sysconf.host-code = v-host-code
     2005      no-error.
     2006      if available buf_sysconf
     2007      then do:
     2008         assign
     2009            p-torgconf-post-head = buf_sysconf.head-position
     2010         .
     2011      end.
     2012   end procedure.
     2013   procedure torgconf-get-storekeeper:
     2014   define input  parameter p-wrkr                   as integer          no-undo.
     2015   define output parameter p-torgconf-wrkr-name     as character        no-undo.
     2016   define output parameter p-torgconf-post          as character        no-undo.
     2017      define buffer buf_sysconf     for ub.sysconf.
     2018      define buffer buf_person      for ub.person.
     2019      define buffer buf_shop        for ub.shop .
     2020      define buffer buf_store       for ub.store .
     2021      if v-torgconf-outC = "no_print"
     2022      then do:
     2023         assign p-torgconf-post = ""
     2024                p-torgconf-wrkr-name = ""
     2025                .
     2026      end.
     2027      if v-torgconf-outC = "clad_doc"
     2028      then do:
     2029         run rep/get-psn.p
     2030               (input  p-wrkr
     2031               ,output p-torgconf-wrkr-name
     2032               ) .
     2033         find first buf_person no-lock
     2034         where buf_person.psn-code = p-wrkr
     2035         no-error.
     2036         if available buf_person
     2037         then do:
     2038           p-torgconf-post = buf_person.position.
     2039         end.
     2040         if p-torgconf-post = "?":U then p-torgconf-post = "".
     2041         if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     2042      end.
     2043      if v-torgconf-outC = "clad_obj"
     2044      then do:
     2045         CASE v-torgconf-self-obj-type:
     2046         WHEN 'маг':U
     2047         THEN DO:
     2048            find first buf_shop no-lock
     2049            where buf_shop.obj-code = v-torgconf-self-obj-code
     2050            .
     2051            assign
     2052               p-torgconf-wrkr-name = buf_shop.store-man
     2053               p-torgconf-post = ""
     2054            .
     2055            if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     2056         END.
     2057         WHEN 'скл':U
     2058         THEN DO:
     2059            find first buf_store no-lock
     2060            where buf_store.obj-code = v-torgconf-self-obj-code
     2061            .
     2062            assign
     2063               p-torgconf-wrkr-name = buf_store.store-man
     2064               p-torgconf-post = ""
     2065            .
     2066            if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     2067         END.
     2068         OTHERWISE DO:
     2069            assign
     2070               p-torgconf-post = "":U
     2071               p-torgconf-wrkr-name = "":U
     2072            .
     2073         END.
     2074         END CASE.
     2075      end.
     2076    end procedure.
     2077   procedure torgconf-get-form-header :
     2078   define input parameter p-for-inverse    as logical          no-undo.
     2079   define input parameter p-doc-code       as character        no-undo.
     2080   define input parameter p-print-doc      as logical          no-undo.
     2081   define input parameter p-doc-date       as date             no-undo.
     2082   define input parameter p-fact-date      as date             no-undo.
     2083   define input parameter p-doc-type       as character        no-undo.
     2084   define input parameter p-status_        as character        no-undo.
     2085   define input parameter p-reverse        as logical          no-undo.
     2086   define input parameter p-sf-par         as logical          no-undo.
     2087       define variable v-attr-type         as character    no-undo.
     2088       define variable v-doc-code-standard as logical      no-undo.
     2089       define variable v-doc-date-standard as logical      no-undo.
     2090       define variable v-par-consignee-addres  as character    no-undo.
     2091       define variable v-host-code         as integer      no-undo.
     2092       define variable v-dcode-attr        as character    no-undo.
     2093       define variable v-ddate-attr        as character    no-undo.
     2094       define variable v-doc-date          as character    no-undo.
     2095       define variable v-doc-code          as character    no-undo.
     2096       define variable v-par-type          as character    no-undo.
     2097       define variable v-attr              as character    no-undo.
     2098       define buffer buf_firm          for ub.firm .
     2099       define buffer buf_clients       for ub.clients .
     2100       define buffer buf_sysconf       for ub.sysconf .
     2101       define buffer buf_shop          for ub.shop .
     2102       define buffer buf_store         for ub.store .
     2103       define buffer buf_person        for ub.person .
     2104       define buffer buf_trn-doc       for ub.trn-doc .
     2105       define buffer buf_wth-doc       for ub.wth-doc .
     2106       do
     2107   for buf_firm
     2108     , buf_clients
     2109     , buf_sysconf
     2110     , buf_shop
     2111     , buf_trn-doc
     2112     , buf_person
     2113     , buf_wth-doc
     2114   on error undo, return error
     2115   :
     2116       if p-doc-type = 'при':U
     2117       or p-doc-type = 'возврат':U
     2118       then do:
     2119           assign
     2120               v-torgconf-supplier         = substitute( "&1&2&3&4&5", v-torgconf-cli-name, ( if v-torgconf-cli-addres = "":U then "":U else ", " ),
     2121                                             v-torgconf-cli-addres, ( if v-torgconf-cli-phone = "":U then "":U else ", " ), v-torgconf-cli-phone )
     2122               v-torgconf-suppi            = substitute( "&1&2&3&4&5", v-torgconf-cli-name, ( if v-torgconf-cli-addres = "":U then "":U else ", " ),
     2123                                             v-torgconf-cli-addres, ( if v-torgconf-cli-phone = "":U then "":U else ", " ), v-torgconf-cli-phone )
     2124               v-torgconf-saler            = substitute( "&1&2&3&4&5", v-torgconf-self-host-name, ( if v-torgconf-self-host-addres = "":U then "":U else ", " ),
     2125                                             v-torgconf-self-host-addres, ( if v-torgconf-self-host-phone = "":U then "":U else ", " ),v-torgconf-self-host-phone )
     2126               v-torgconf-consignee        = substitute( "&1&2&3&4&5", v-torgconf-sup-host-name, ( if v-torgconf-sup-host-addres = "":U then "":U else ", " ),
     2127                                             v-torgconf-sup-host-addres, ( if v-torgconf-sup-host-phone = "":U then "":U else ", " ), v-torgconf-sup-host-phone  )
     2128               v-torgconf-supplier-okpo    = v-torgconf-cli-okpo
     2129               v-torgconf-saler-okpo       = v-torgconf-self-host-okpo
     2130               v-torgconf-consignee-okpo   = v-torgconf-sup-host-okpo
     2131               v-torgconf-supplier-code    = substitute( "&1", v-torgconf-cli-code         )
     2132               v-torgconf-supplier-type    = v-torgconf-cli-type
     2133               v-torgconf-saler-code       = substitute( "&1", v-torgconf-self-host-code   )
     2134               v-torgconf-saler-type       = v-torgconf-self-host-type
     2135               v-torgconf-consignee-code   = substitute( "&1", v-torgconf-sup-host-code   )
     2136               v-torgconf-consignee-type   = v-torgconf-sup-host-type
     2137               v-torgconf-supplier-name    = substitute( "&1", v-torgconf-cli-name         )
     2138               v-torgconf-saler-name       = substitute( "&1", v-torgconf-self-host-name   )
     2139               v-torgconf-consignee-name   = substitute( "&1", v-torgconf-sup-host-name   )
     2140               v-torgconf-supplier-addr    = substitute( "&1", v-torgconf-cli-addres       )
     2141               v-torgconf-saler-addr       = substitute( "&1", v-torgconf-self-host-addres )
     2142               v-torgconf-consignee-addr   = substitute( "&1", v-torgconf-sup-host-addres )
     2143               v-torgconf-supplier-inn     = substitute( "&1", v-torgconf-cli-inn          )
     2144               v-torgconf-supplier-engl-name     = substitute( "&1", v-torgconf-cli-engl-name          )
     2145               v-torgconf-saler-inn        = substitute( "&1", v-torgconf-self-host-inn    )
     2146               v-torgconf-consignee-inn    = substitute( "&1", v-torgconf-sup-host-inn    )
     2147               v-torgconf-supplier-kpp     = substitute( "&1", v-torgconf-cli-kpp          )
     2148               v-torgconf-saler-kpp        = substitute( "&1", v-torgconf-self-host-kpp    )
     2149               v-torgconf-consignee-kpp    = substitute( "&1", v-torgconf-sup-host-kpp    )
     2150           .
     2151           if v-torgconf-cli-schet-exists = yes
     2152           AND v-form-name                  = "torg12":U
     2153           then do:
     2154               assign
     2155                   v-torgconf-supplier = v-torgconf-supplier
     2156                       + substitute( ", р/с &1 к/с &2"
     2157                                   , v-torgconf-cli-bank-r-schet
     2158                                   , v-torgconf-cli-bank-c-schet
     2159                                   )
     2160                   v-torgconf-suppi = v-torgconf-supplier
     2161                       + substitute( ", р/с &1 к/с &2"
     2162                                   , v-torgconf-cli-bank-r-schet
     2163                                   , v-torgconf-cli-bank-c-schet
     2164                                   )
     2165               .
     2166               if v-torgconf-cli-bank-exists = yes
     2167               then do:
     2168                   assign
     2169                       v-torgconf-supplier = v-torgconf-supplier
     2170                           + substitute( " БИК &1 в &2 &3"
     2171                                       , v-torgconf-cli-bank-bik
     2172                                       , v-torgconf-cli-bank-name
     2173                                       ,(if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) )
     2174                                       )
     2175                      v-torgconf-suppi = v-torgconf-supplier
     2176                           + substitute( " БИК &1 в &2 &3"
     2177                                       , v-torgconf-cli-bank-bik
     2178                                       , v-torgconf-cli-bank-name
     2179                                       ,(if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) )
     2180                                       )
     2181                   .
     2182               end.
     2183           end.
     2184           if v-torgconf-self-schet-exists = yes
     2185           AND v-form-name                  = "torg12":U
     2186           then do:
     2187               assign
     2188                   v-torgconf-saler = v-torgconf-saler
     2189                       + substitute( ", р/с &1 к/с &2"
     2190                                   , v-torgconf-self-bank-r-schet
     2191                                   , v-torgconf-self-bank-c-schet
     2192                                   )
     2193               .
     2194               if v-torgconf-self-bank-exists = yes
     2195               then do:
     2196                   assign
     2197                       v-torgconf-saler = v-torgconf-saler
     2198                           + substitute( " БИК &1 в &2 &3"
     2199                                       , v-torgconf-self-bank-bik
     2200                                       , v-torgconf-self-bank-name
     2201                                       , v-torgconf-self-bank-addres
     2202                                       )
     2203                   .
     2204               end.
     2205           end.
     2206           if v-torgconf-sup-schet-exists = yes
     2207           AND v-form-name                  = "torg12":U
     2208           then do:
     2209               assign
     2210                   v-torgconf-consignee = v-torgconf-consignee
     2211                       + substitute( ", р/с &1 к/с &2"
     2212                                   , v-torgconf-sup-bank-r-schet
     2213                                   , v-torgconf-sup-bank-c-schet
     2214                                   )
     2215               .
     2216             if v-torgconf-sup-bank-exists = yes
     2217              then do:
     2218                assign
     2219                   v-torgconf-consignee = v-torgconf-consignee
     2220                           + substitute( " БИК &1 в &2 &3"
     2221                                       , v-torgconf-sup-bank-bik
     2222                                       , v-torgconf-sup-bank-name
     2223                                       , v-torgconf-sup-bank-addres
     2224                                       )
     2225                   .
     2226               end.
     2227           end.
     2228      if v-torgconf-outares = yes  AND v-form-name  = "torg12":U
     2229      then do:
     2230          assign
     2231            v-torgconf-supplier = substitute(  "&1&2&3 &4 &5&6"
     2232                                                   , IF v-form-name = "torg12":U THEN SUBSTITUTE("ИНН &1 КПП &2 ", v-torgconf-cli-inn, v-torgconf-cli-kpp) ELSE "":U
     2233                                                   , v-torgconf-cli-name
     2234                                                   , ( if v-torgconf-outprncd = yes
     2235                                                         then substitute( " (&1)", v-torgconf-cli-code )
     2236                                                         else "":U )
     2237                                                   , v-torgconf-cli-post-addres
     2238                                                   , v-torgconf-cli-phone
     2239                                                   , ( if v-torgconf-cli-bank-r-schet <> "":U
     2240                                                       AND v-form-name                  = "torg12":U
     2241                                                         then substitute( ", р/с &1 к/с &2, БИК &3 в &4, &5"
     2242                                                               , v-torgconf-cli-bank-r-schet
     2243                                                               , v-torgconf-cli-bank-c-schet
     2244                                                               , v-torgconf-cli-bank-bik
     2245                                                               , v-torgconf-cli-bank-name
     2246                                                               , (if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) )     )
     2247                                                         else "":U )
     2248                                                )
     2249         .
     2250      end.
     2251       v-torgconf-suppi = substitute(  "&1&2&3 &4 &5&6"
     2252                                        , IF v-form-name = "torg12":U THEN SUBSTITUTE("ИНН &1 КПП &2 ", v-torgconf-cli-inn, v-torgconf-cli-kpp) ELSE "":U
     2253                                        , v-torgconf-cli-name
     2254                                        , ( if v-torgconf-outprncd = yes
     2255                                            then substitute( " (&1)", v-torgconf-cli-code )
     2256                                            else "":U )
     2257                                        , v-torgconf-cli-addres
     2258                                        , v-torgconf-cli-phone
     2259                                        , ( if v-torgconf-cli-bank-r-schet <> "":U
     2260                                            AND v-form-name                  = "torg12":U
     2261                                            then substitute( ", р/с &1 к/с &2, БИК &3 в &4, &5"
     2262                                                           , v-torgconf-cli-bank-r-schet
     2263                                                           , v-torgconf-cli-bank-c-schet
     2264                                                           , v-torgconf-cli-bank-bik
     2265                                                           , v-torgconf-cli-bank-name
     2266                                                           , (if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) ))
     2267                                                   else "":U )
     2268                                        ).
     2269       end.
     2270       else do:
     2271       v-torgconf-suppi = substitute(  "&1&2&3 &4 &5&6"
     2272                                        , IF v-form-name = "torg12":U THEN SUBSTITUTE("ИНН &1 КПП &2 ", v-torgconf-self-host-inn, v-torgconf-self-host-kpp) ELSE "":U
     2273                                        , v-torgconf-self-host-name
     2274                                        , ( if v-torgconf-outprncd = yes
     2275                                            then substitute( " (&1)", v-torgconf-self-host-code )
     2276                                            else "":U )
     2277                                        , v-torgconf-self-host-addres
     2278                                        , v-torgconf-self-host-phone
     2279                                        , ( if v-torgconf-self-bank-r-schet <> "":U
     2280                                            AND v-form-name                  = "torg12":U
     2281                                            then substitute( ", р/с &1 к/с &2, БИК &3 в &4, &5"
     2282                                                           , v-torgconf-self-bank-r-schet
     2283                                                           , v-torgconf-self-bank-c-schet
     2284                                                           , v-torgconf-self-bank-bik
     2285                                                           , v-torgconf-self-bank-name
     2286                                                           , (if v-torgconf-self-bank-city = "":U then "":U else ( "г. " + v-torgconf-self-bank-city) )     )
     2287                                                   else "":U )
     2288                                           ).
     2289         if v-torgconf-outares = yes
     2290         and p-reverse = no
     2291         then do:
     2292            assign
     2293               v-par-consignee-addres = v-torgconf-ship-post-addres
     2294            .
     2295         end.
     2296         if v-torgconf-outares = no
     2297         and p-reverse = no
     2298         then do:
     2299            assign
     2300               v-par-consignee-addres = v-torgconf-ship-addres
     2301            .
     2302         end.
     2303         if p-reverse = yes
     2304         then do:
     2305             assign
     2306               v-par-consignee-addres = v-torgconf-ship-addres
     2307             .
     2308         end.
     2309           assign
     2310               v-torgconf-supplier         = substitute( "&1&2&3&4&5", v-torgconf-self-host-name, ( if v-torgconf-self-host-addres = "":U then "":U else ", " ), v-torgconf-self-host-addres,
     2311                                             ( if v-torgconf-self-host-phone = "":U then "":U else ", " ), v-torgconf-self-host-phone )
     2312               v-torgconf-saler            = substitute( "&1&2&3&4&5", v-torgconf-cli-name      , ( if v-torgconf-cli-addres       = "":U then "":U else ", " ), v-torgconf-cli-addres,
     2313                                             ( if v-torgconf-cli-phone       = "":U then "":U else ", " ), v-torgconf-cli-phone )
     2314               v-torgconf-consignee        = substitute( "&1&2&3&4&5", v-torgconf-ship-name      , ( if v-par-consignee-addres   = "":U then "":U else ", " ), v-par-consignee-addres,
     2315                                              ( if v-torgconf-ship-phone   = "":U then "":U else ", " ), v-torgconf-ship-phone)
     2316               v-torgconf-supplier-okpo    = v-torgconf-self-host-okpo
     2317               v-torgconf-saler-okpo       = v-torgconf-cli-okpo
     2318               v-torgconf-consignee-okpo   = v-torgconf-ship-okpo
     2319               v-torgconf-supplier-code    = substitute( "&1", v-torgconf-self-host-code   )
     2320               v-torgconf-supplier-code    = v-torgconf-self-host-type
     2321               v-torgconf-saler-code       = substitute( "&1", v-torgconf-cli-code         )
     2322               v-torgconf-saler-type       = v-torgconf-cli-type
     2323               v-torgconf-consignee-code   = substitute( "&1", v-torgconf-ship-code         )
     2324               v-torgconf-consignee-type   = v-torgconf-ship-type
     2325               v-torgconf-supplier-name    = substitute( "&1", v-torgconf-self-host-name   )
     2326               v-torgconf-saler-name       = substitute( "&1", v-torgconf-cli-name         )
     2327               v-torgconf-consignee-name   = substitute( "&1", v-torgconf-ship-name         )
     2328               v-torgconf-supplier-addr    = substitute( "&1", v-torgconf-self-host-addres )
     2329               v-torgconf-saler-addr       = substitute( "&1", v-torgconf-cli-addres       )
     2330               v-torgconf-consignee-addr   = substitute( "&1", v-par-consignee-addres                )
     2331               v-torgconf-supplier-inn     = substitute( "&1", v-torgconf-self-host-inn    )
     2332               v-torgconf-supplier-engl-name     = substitute( "&1", v-torgconf-self-host-engl-name    )
     2333               v-torgconf-saler-inn        = substitute( "&1", v-torgconf-cli-inn          )
     2334               v-torgconf-consignee-inn    = substitute( "&1", v-torgconf-ship-inn          )
     2335               v-torgconf-supplier-kpp     = substitute( "&1", v-torgconf-self-host-kpp    )
     2336               v-torgconf-saler-kpp        = substitute( "&1", v-torgconf-cli-kpp          )
     2337               v-torgconf-consignee-kpp    = substitute( "&1", v-torgconf-ship-kpp          )
     2338               v-torgconf-sf-buyer-name    = v-torgconf-consignee-name
     2339               v-torgconf-sf-buyer-code    = v-torgconf-consignee-code
     2340               v-torgconf-sf-buyer-type    = v-torgconf-consignee-type
     2341               v-torgconf-sf-buyer-addr    = v-torgconf-consignee-addr
     2342           .
     2343           if v-torgconf-self-schet-exists = yes
     2344           AND v-form-name                  = "torg12":U
     2345           then do:
     2346               assign
     2347                   v-torgconf-supplier = v-torgconf-supplier
     2348                       + substitute( ", р/с &1 к/с &2"
     2349                                   , v-torgconf-self-bank-r-schet
     2350                                   , v-torgconf-self-bank-c-schet
     2351                                   )
     2352               .
     2353               if v-torgconf-self-bank-exists = yes
     2354               then do:
     2355                   assign
     2356                       v-torgconf-supplier = v-torgconf-supplier
     2357                           + substitute( " БИК &1 в &2 &3"
     2358                                       , v-torgconf-self-bank-bik
     2359                                       , v-torgconf-self-bank-name
     2360                                       , v-torgconf-self-bank-addres
     2361                                       )
     2362                   .
     2363               end.
     2364           end.
     2365           if v-torgconf-cli-schet-exists = yes
     2366           AND v-form-name                  = "torg12":U
     2367           then do:
     2368               assign
     2369                   v-torgconf-saler = v-torgconf-saler
     2370                       + substitute( ", р/с &1 к/с &2"
     2371                                   , v-torgconf-cli-bank-r-schet
     2372                                   , v-torgconf-cli-bank-c-schet
     2373                                   )
     2374               .
     2375               if v-torgconf-cli-bank-exists = yes
     2376               then do:
     2377                   assign
     2378                       v-torgconf-saler = v-torgconf-saler
     2379                           + substitute( " БИК &1 в &2 &3"
     2380                                       , v-torgconf-cli-bank-bik
     2381                                       , v-torgconf-cli-bank-name
     2382                                       , (if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) )
     2383                                       )
     2384                   .
     2385               end.
     2386           end.
     2387           if v-torgconf-ship-schet-exists = yes
     2388           AND v-form-name                  = "torg12":U
     2389           then do:
     2390               assign
     2391                   v-torgconf-consignee = v-torgconf-consignee
     2392                       + substitute( ", р/с &1 к/с &2"
     2393                                   , v-torgconf-ship-bank-r-schet
     2394                                   , v-torgconf-ship-bank-c-schet
     2395                                   )
     2396               .
     2397               if v-torgconf-ship-bank-exists = yes
     2398               then do:
     2399                   assign
     2400                       v-torgconf-consignee = v-torgconf-consignee
     2401                           + substitute( " БИК &1 в &2  &3"
     2402                                       , v-torgconf-ship-bank-bik
     2403                                       , v-torgconf-ship-bank-name
     2404                                       , (if v-torgconf-ship-bank-city = "":U then "":U else ( "г. " + v-torgconf-ship-bank-city) )
     2405                                       )
     2406                   .
     2407               end.
     2408           end.
     2409      if p-reverse = yes
     2410         then do:
     2411          if  v-torgconf-outares = yes then v-torgconf-saler = substitute( "&1&2&3", v-torgconf-cli-name      , ( if v-torgconf-cli-post-addres       = "":U then "":U else ", " ), v-torgconf-cli-post-addres       )
     2412            .
     2413          else v-torgconf-saler = substitute( "&1&2&3", v-torgconf-cli-name      , ( if v-torgconf-cli-addres       = "":U then "":U else ", " ), v-torgconf-cli-addres       ) .
     2414                 if v-torgconf-cli-schet-exists = yes
     2415                 AND v-form-name                  = "torg12":U
     2416                     then do:
     2417                           assign
     2418                              v-torgconf-saler = v-torgconf-saler
     2419                                 + substitute( ", р/с &1 к/с &2"
     2420                                             , v-torgconf-cli-bank-r-schet
     2421                                             , v-torgconf-cli-bank-c-schet
     2422                                             )
     2423               .
     2424               if v-torgconf-cli-bank-exists = yes
     2425               AND v-form-name                  = "torg12":U
     2426                  then do:
     2427                     assign
     2428                        v-torgconf-saler = v-torgconf-saler
     2429                              + substitute( " БИК &1 в &2  &3"
     2430                                          , v-torgconf-cli-bank-bik
