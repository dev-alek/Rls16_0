     3928   procedure prn-lib-open-stream :
     3929     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     3930     define input parameter p-page-size    as integer no-undo .
     3931     define input parameter p-is-stream    as logical no-undo .
     3932     define input parameter p-append       as logical no-undo .
     3933     define variable v-report-name as character no-undo .
     3934     do
     3935       on error undo, return error
     3936       :
     3937       run prn-lib-get-report-name  in this-procedure (
     3938         input parParentProc
     3939         ,output v-report-name
     3940         ).
     3941       if p-is-stream then
     3942       do:
     3943         if p-append then
     3944         do:
     3945           output stream PrnLibStream to value( v-report-name )
     3946             page-size value(p-page-size) append .
     3947         end.
     3948         if not p-append then
     3949         do:
     3950           output stream PrnLibStream to value( v-report-name )
     3951             page-size value(p-page-size) .
     3952         end.
     3953       end.
     3954       if not p-is-stream then
     3955       do:
     3956         if p-append then
     3957         do:
     3958           output to value( v-report-name )
     3959             page-size value(p-page-size) append .
     3960         end.
     3961         if not p-append then
     3962         do:
     3963           output to value( v-report-name )
     3964             page-size value(p-page-size) .
     3965         end.
     3966       end.
     3967     end.
     3968   end procedure.
     3969   procedure prn-lib-open-exp :
     3970     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     3971     define input parameter p-is-stream    as logical no-undo .
     3972     define input parameter p-is-append    as logical no-undo .
     3973     define output parameter p-ReportFileName as char init "report" no-undo.
     3974     define output parameter p-process as logical no-undo .
     3975     define variable glog as logical no-undo .
     3976     do
     3977       on error undo, return error
     3978       :
     3979       SYSTEM-DIALOG GET-FILE p-ReportFileName
     3980         TITLE      "Укажите путь"
     3981         FILTERS "Текстовый файл (*.txt)"   "*.txt"
     3982         ASK-OVERWRITE
     3983         CREATE-TEST-FILE
     3984         SAVE-AS
     3985         USE-FILENAME
     3986         DEFAULT-EXTENSION "txt"
     3987         UPDATE glog
     3988         .
     3989       if not glog then  return.
     3990       p-ReportFileName = trim( string( p-ReportFileName ) ) .
     3991       if p-is-stream then
     3992       do:
     3993         if p-is-append then
     3994         do:
     3995           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     3996         end.
     3997         else
     3998         do:
     3999           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
     4000         end.
     4001       end.
     4002       else
     4003       do:
     4004         if p-is-append then
     4005         do:
     4006           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     4007         end.
     4008         else
     4009         do:
     4010           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
     4011         end.
     4012       end.
     4013       p-process = yes.
     4014     end.
     4015   end procedure.
