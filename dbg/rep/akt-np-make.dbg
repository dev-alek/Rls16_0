     3495               assign
     3496                  v-torgconf-ogr-post = buf_sysconf.head-position
     3497               .
     3498            end.
     3499            find first buf_clients no-lock
     3500                where buf_clients.obj-type = 'орг':U
     3501                and buf_clients.obj-code = v-host-code
     3502            .
     3503            find first buf_firm no-lock
