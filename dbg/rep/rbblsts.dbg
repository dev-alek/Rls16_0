     1297           sym1
     1298           "Производитель :" @ gds-zap.artic
     1299           gds-zap.prod-name @ gds-zap.gds-name
     1300           sym5 with frame zapas .
     1301           DOWN stream PrnLibStream
     1302           1 with frame zapas .
     1303           UNDERLINE stream PrnLibStream
     1304           tb-code
     1305           gds-zap.artic
     1306           gds-zap.gds-name
     1307           with frame zapas .
     1308         end.
     1309         DISPLAY stream PrnLibStream
     1310         sym1 string( gds-zap.b-code, ">>>>>>>>>9" ) @ tb-code
     1311         sym2 gds-zap.artic sym3 gds-zap.gds-name
     1312         sym4 gds-zap.weight-bc
     1313         sym5 free-clmn sym6
     1314         with frame zapas .
     1315         DOWN stream PrnLibStream
     1316         1 with frame zapas .
     1317       END.
     1318     END.
     1319     when "Classify_3" then do:
     1320       FOR EACH gds-zap
     1321       BREAK
     1322       BY gds-zap.grp-name
     1323       BY (if p-sorttype = "artic":U                     then gds-zap.artic                     else (if p-sorttype = "b-code":U                           then string( gds-zap.b-code, "9999999999" )                           else string(gds-zap.order-num, "9999999999"))                           )  :
     1324         if first-of ( gds-zap.grp-name ) then do:
     1325           if NOT first ( gds-zap.grp-name ) then do:
     1326             UNDERLINE stream PrnLibStream
     1327             tb-code
     1328             gds-zap.artic
     1329             gds-zap.gds-name
     1330             with frame zapas .
     1331           end.
     1332           DISPLAY stream PrnLibStream
     1333           sym1 "Группа товаров :" @ gds-zap.artic
     1334           gds-zap.grp-name @ gds-zap.gds-name
     1335           sym5
     1336           with frame zapas .
     1337           DOWN stream PrnLibStream
     1338           1 with frame zapas .
     1339           UNDERLINE stream PrnLibStream
     1340           tb-code
     1341           gds-zap.artic
     1342           gds-zap.gds-name
     1343           with frame zapas .
     1344         end.
     1345         DISPLAY stream PrnLibStream
     1346         sym1 string( gds-zap.b-code, ">>>>>>>>>9" ) @ tb-code
     1347         sym2 gds-zap.artic sym3 gds-zap.gds-name
     1348         sym4 gds-zap.weight-bc
     1349         sym5 free-clmn
     1350         sym6
     1351           sym7
     1352           gds-zap.qnty
     1353           sym8
     1354           gds-zap.b-str @ pbtb-code
     1355         with frame zapas .
     1356         DOWN stream PrnLibStream
     1357         1 with frame zapas .
     1358       END.
     1359     end.
     1360     when "Classify_4" then do:
     1361       FOR EACH gds-zap
     1362       BREAK
     1363       BY ( gds-zap.prod-type + string( gds-zap.prod-code ) )
     1364       BY gds-zap.grp-name
     1365       BY (if p-sorttype = "artic":U                     then gds-zap.artic                     else (if p-sorttype = "b-code":U                           then string( gds-zap.b-code, "9999999999" )                           else string(gds-zap.order-num, "9999999999"))                           ) :
     1366         if first-of ( ( gds-zap.prod-type + string( gds-zap.prod-code ) ) ) then do:
     1367           if NOT first ( ( gds-zap.prod-type + string( gds-zap.prod-code ) ) ) then do:
     1368             UNDERLINE stream PrnLibStream
     1369             tb-code
     1370             gds-zap.artic
     1371             gds-zap.gds-name
     1372             with frame zapas .
     1373           end.
     1374           DISPLAY stream PrnLibStream
     1375           sym1  "Производитель :" @ gds-zap.artic
     1376           gds-zap.prod-name @ gds-zap.gds-name
     1377           sym5 with frame zapas .
     1378           DOWN stream PrnLibStream
     1379           1 with frame zapas .
     1380           UNDERLINE stream PrnLibStream
     1381           tb-code
     1382           gds-zap.artic
     1383           gds-zap.gds-name
     1384           with frame zapas .
     1385         end.
     1386         if first-of ( gds-zap.grp-name ) then do:
     1387           if NOT first ( gds-zap.grp-name ) then do:
     1388             UNDERLINE stream PrnLibStream
     1389             tb-code
     1390             gds-zap.artic
     1391             gds-zap.gds-name
     1392             with frame zapas .
     1393           end.
     1394           DISPLAY stream PrnLibStream
     1395           sym1 "Группа товаров :" @ gds-zap.artic
     1396           gds-zap.grp-name @ gds-zap.gds-name
     1397           sym5 with frame zapas .
     1398           DOWN stream PrnLibStream
     1399           1 with frame zapas .
     1400           UNDERLINE stream PrnLibStream
     1401           tb-code
     1402           gds-zap.artic
     1403           gds-zap.gds-name
     1404           with frame zapas .
     1405         end.
     1406         DISPLAY stream PrnLibStream
     1407         sym1 string( gds-zap.b-code, ">>>>>>>>>9" ) @ tb-code
     1408         sym2 gds-zap.artic sym3 gds-zap.gds-name
     1409         sym4 gds-zap.weight-bc
     1410         sym5 free-clmn sym6
     1411           sym7
     1412           gds-zap.qnty
     1413           sym8
     1414           gds-zap.b-str @ pbtb-code
     1415         with frame zapas .
     1416         DOWN stream PrnLibStream
     1417         1 with frame zapas .
     1418       END.
     1419     end.
     1420     when "Classify_5" then do:
     1421       FOR EACH gds-zap
     1422       BREAK
     1423       BY gds-zap.grp-name
     1424       BY ( gds-zap.prod-type + string( gds-zap.prod-code ) )
     1425       BY (if p-sorttype = "artic":U                     then gds-zap.artic                     else (if p-sorttype = "b-code":U                           then string( gds-zap.b-code, "9999999999" )                           else string(gds-zap.order-num, "9999999999"))                           ) :
     1426         if first-of ( gds-zap.grp-name ) then  do:
     1427           if NOT first ( gds-zap.grp-name ) then do:
     1428             UNDERLINE stream PrnLibStream
     1429             tb-code
     1430             gds-zap.artic
     1431             gds-zap.gds-name
     1432             with frame zapas .
     1433           end.
     1434           DISPLAY stream PrnLibStream
     1435           sym1 "Группа товаров :" @ gds-zap.artic
     1436           gds-zap.grp-name @ gds-zap.gds-name
     1437           sym5 with frame zapas .
     1438           DOWN stream PrnLibStream
     1439           1 with frame zapas .
     1440           UNDERLINE stream PrnLibStream
     1441           tb-code gds-zap.artic gds-zap.gds-name with frame zapas .
     1442         end.
     1443         if first-of ( ( gds-zap.prod-type + string( gds-zap.prod-code ) ) ) then do:
     1444           if NOT first ( ( gds-zap.prod-type + string( gds-zap.prod-code ) ) ) then do:
     1445             UNDERLINE stream PrnLibStream
     1446             tb-code
     1447             gds-zap.artic
     1448             gds-zap.gds-name
     1449             with frame zapas .
     1450           end.
     1451           DISPLAY stream PrnLibStream
     1452           sym1 "Производитель :" @ gds-zap.artic
     1453           gds-zap.prod-name @ gds-zap.gds-name
     1454           sym5
     1455           with frame zapas .
     1456           DOWN stream PrnLibStream
     1457           1 with frame zapas .
     1458           UNDERLINE stream PrnLibStream
     1459           tb-code gds-zap.artic gds-zap.gds-name with frame zapas .
     1460         end.
     1461         DISPLAY stream PrnLibStream
     1462         sym1 string( gds-zap.b-code, ">>>>>>>>>9" ) @ tb-code
     1463         sym2 gds-zap.artic sym3 gds-zap.gds-name
     1464         sym4 gds-zap.weight-bc
     1465         sym5 free-clmn sym6
     1466           sym7
     1467           gds-zap.qnty
     1468           sym8
     1469           gds-zap.b-str @ pbtb-code
     1470         with frame zapas .
     1471         DOWN stream PrnLibStream
     1472         1 with frame zapas .
     1473       END.
     1474     END.
     1475   END CASE .
     1476   HIDE stream PrnlibStream FRAME BottomFrame .
     1477   PUT  stream PrnlibStream
     1478   Line format "X(135)" SKIP .
