      565   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      566   define new global shared variable g#attr-lib  as handle no-undo .
      567   define variable v-attr-lib-variable as handle no-undo .
      568   procedure gdsoattr-name :
      569     define input  parameter p-code           as character no-undo .
      570     define output parameter p-type           as character no-undo .
      571     define output parameter p-format         as character no-undo .
      572     define output parameter p-label          as character no-undo .
      573     define output parameter p-user-can-edit  as logical   no-undo .
      574     define output parameter p-output-display as logical   no-undo .
