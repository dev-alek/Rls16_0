        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter p-obj-type like ub.clients.obj-type no-undo .
        4   define input parameter p-obj-code like ub.clients.obj-code no-undo .
        5   define input parameter p-sorttype as character no-undo .
        6   define input parameter p-classify as character no-undo .
        7   def var vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        8   def var vss-author      as character no-undo init "$Author: expertek $":U .
        9   def var vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       10   def var vss-workfile    as character no-undo init "$Workfile: rbblsts.p $":U .
       11   def var vss-archive     as character no-undo init "$Archive: rep/rbblsts.p $":U .
       12   def var vss-description as character no-undo init "Печать списка scn-list".
       13   procedure vss-get-info :
