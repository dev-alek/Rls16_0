      904   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      905   define variable v-waitfram-action01         as character   no-undo .
      906   define variable v-waitfram-action02         as character   no-undo .
      907   define variable v-waitfram-action03         as character   no-undo .
      908   define variable mWaitFramTextBeg            as character   no-undo.
      909   define variable mWaitFramTextEnd            as character   no-undo.
      910   define variable mWaitFramView               as logical     no-undo.
      911   define variable mWaitProcEvent              as logical     no-undo init yes.
      912   define variable mWaitFramInterval           as integer     no-undo init 1 .
      913   define variable mWaitFramStop               as logical     no-undo.
      914   define variable mWaitFramStopUser           as logical     no-undo.
      915   define variable mWaitFramStopTimeOut        as logical     no-undo.
      916   define variable mWaitFramStartProc          as datetime-tz no-undo.
      917   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      918   define button B-WaitFramStop auto-end-key
      919        label "Стоп"
      920        size 10 by 1 tooltip "Остоновить процесс".
      921   define button B-viewProcInfo
      922        label "Информация"
      923        size 15 by 1 tooltip "Информация о процесс".
      924   define frame waitfram
      925     v-waitfram-action01 format "x(72)" no-label skip
      926     v-waitfram-action02 format "x(72)" no-label skip
      927     v-waitfram-action03 format "x(72)" no-label skip
      928     B-viewProcInfo
      929     B-WaitFramStop at row 4 col 30
      930     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      931     .
      932   define new global shared variable mBatchMode as logical no-undo init ?.
      933   define variable mFramBachModHandle as handle no-undo.
      934   mFramBachModHandle = frame waitfram:handle.
      935   define variable mFameOldVis as logical no-undo.
      936   define variable mVisCUrentVin as logical no-undo.
      937   if session:batch-mode
      938   then
      939      mBatchMode = yes.
      940   if mBatchMode = ? then do:
      941     mVisCUrentVin = current-window:visible.
      942     mFameOldVis = mFramBachModHandle:visible.
      943     mFramBachModHandle:visible  = yes.
      944     mBatchMode = mFramBachModHandle:visible ne yes.
      945     mFramBachModHandle:visible = mFameOldVis.
      946     current-window:visible = mVisCUrentVin.
      947   end.
      948    if  log-manager:logfile-name ne ?
      949     then DO:
      950         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      951         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      952         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      953     end.
      954   on choose of B-WaitFramStop in frame waitfram
      955   do:
      956     mWaitFramStop = yes.
      957     mWaitFramStopUser = yes.
      958   end.
      959   function waitfram-check-timeout returns logical():
      960      define variable vtime as int64 no-undo.
      961      if mWaitFramStopTimeOut
      962      then
      963         return yes.
      964      vtime = ( now - mWaitFramStartProc ) / 1000 .
      965      if     mWaitFramTimeOut ne ?
      966         and mWaitFramTimeOut ne 0
      967         and mWaitFramTimeOut lt vtime
      968      then do:
      969         mWaitFramStopTimeOut = yes.
      970      end.
      971      return mWaitFramStopTimeOut.
      972   end.
      973   procedure waitfram-hide :
      974     if not session:batch-mode
      975     then do
      976     on error undo, return error return-value
      977     :
      978       pause 0 before-hide .
      979       if not mBatchMode then
      980         hide frame waitfram .
      981     if     not mWaitFramView
      982        and mWaitProcEvent
      983     then
      984       process events .
      985     end.
      986   end procedure.
      987   procedure waitfram-show :
      988     define input  parameter p-message as character no-undo .
      989     define variable v-left-margin as integer   no-undo .
      990     if not session:batch-mode
      991     then do
      992     on error undo, return error return-value
      993     :
      994       if length(p-message) <= 70 then do:
      995         assign
      996           v-left-margin = integer((70 - length(p-message)) / 2)
      997         .
      998         assign
      999           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1000         .
     1001         assign
     1002           v-waitfram-action01 = " "
     1003           v-waitfram-action02 = " "
     1004                                    + fill(" ", v-left-margin)
     1005                                    + p-message
     1006           v-waitfram-action03 = " "
     1007         .
     1008       end.
     1009       else do:
     1010         define variable vRindex1 as integer no-undo.
     1011         define variable vRindex2 as integer no-undo.
     1012         vRindex1 = r-index(p-message," ",70).
     1013         if vRindex1 = 0
     1014         then
     1015            vRindex1 = 70.
     1016         if length(p-message)  <= vRindex1 + 70 then do:
     1017           assign
     1018             v-waitfram-action01 = " "
     1019             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1020             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1021           .
     1022         end.
     1023         else do:
     1024           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1025           if vRindex2 <= vRindex1
     1026           then
     1027              vRindex2 = vRindex1 + 70.
     1028           assign
     1029             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1030             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1031             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1032           .
     1033         end.
     1034       end.
     1035       B-viewProcInfo:visible   in frame waitfram = no.
     1036       B-viewProcInfo:sensitive in frame waitfram = no.
     1037       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1038       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1039       if  (   mWaitFramView
     1040          or  mWaitProcEvent)
     1041          and not mBatchMode
     1042       then
     1043          display
     1044             v-waitfram-action01 skip
     1045             v-waitfram-action02 skip
     1046             v-waitfram-action03 skip
     1047          with frame waitfram .
     1048       if     mWaitFramView
     1049          then do:
     1050             if     mWaitFramInterval ne ?
     1051                and not mBatchMode
     1052             then
     1053                wait-for go of frame waitfram pause mWaitFramInterval.
     1054          end.
     1055          else
     1056             if     mWaitProcEvent
     1057                and not mBatchMode
     1058             then
     1059                process events .
     1060     end.
     1061   end procedure.
     1062      procedure waitfram-show-this:
     1063         define input  parameter iInterval as int64 no-undo.
     1064         define variable vtime as int64 no-undo.
     1065         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1066         mWaitFramInterval = iInterval.
     1067         run waitfram-show (substitute("&1&2 &3&4" ,
     1068                                       mWaitFramTextBeg ,
     1069                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1070                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1071                                       mWaitFramTextEnd
     1072                                      )
     1073                           ).
     1074      end.
     1075      procedure WaitFramRunPause:
     1076         define input  parameter iInterval as dec no-undo.
     1077         define variable vStart  as datetime-tz no-undo.
     1078         define variable vend    as datetime-tz no-undo.
     1079         define variable vint as int64 no-undo.
     1080         define variable vOk as logical no-undo.
     1081         vStart = now.
     1082         vend   = vStart.
     1083         publish "WaitFramPause" (iInterval,output vOk).
     1084         vend   =  now.
     1085         vint = vend - vStart.
     1086         vint = iInterval - vint / 1000.
     1087         if     not mWaitFramStop
     1088            and (   vint > 0
     1089                 or (    not vOk
     1090                     and iInterval eq ?
     1091                     )
     1092                 )
     1093         then
     1094            run waitfram-show-this (iInterval).
     1095         vend   =  now.
     1096         vint = vend - vStart.
     1097         vint = iInterval - vint / 1000.
     1098         if     not mWaitFramStop
     1099            and vint > 0
     1100         then do:
     1101            run gbl/pause.p (vint * 1000).
     1102         end.
     1103         if iInterval ne ?
     1104         then
     1105            publish "WaitFramStop".
     1106         waitfram-check-timeout().
     1107      end.
     1108      procedure WaitFramWaitFor:
     1109         define input  parameter iInterval as dec no-undo.
     1110         assign
     1111            mWaitFramStartProc   = now
     1112            mWaitFramStopUser    = no
     1113            mWaitFramStopTimeOut = no
     1114         .
     1115         block-wait:
     1116         do while not mWaitFramStop:
     1117            run WaitFramRunPause (iInterval).
     1118            if  waitfram-check-timeout()
     1119            then do:
     1120               leave block-wait.
     1121            end.
     1122         end.
     1123         run waitfram-hide.
     1124      end.
     1125   procedure waitfram-join :
     1126     define input  parameter p-line-1  as character no-undo .
     1127     define input  parameter p-line-2  as character no-undo .
     1128     define input  parameter p-line-3  as character no-undo .
     1129     define output parameter p-message as character no-undo .
     1130     do
     1131     on error undo, return error return-value
     1132     :
     1133       assign
     1134         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1135                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1136                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1137       .
     1138     end.
     1139   end procedure.
     1140   function waitfram-join-function returns character
     1141     (input p-line-1 as character
     1142     ,input p-line-2 as character
     1143     ,input p-line-3 as character
     1144     ).
     1145     define variable v-message as character no-undo .
     1146     run waitfram-join in this-procedure
     1147       (input  p-line-1
     1148       ,input  p-line-2
     1149       ,input  p-line-3
     1150       ,output v-message
     1151       ) .
     1152     return v-message .
     1153   end function .
     1154   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1155   define variable  sym1 as char init ":"   no-undo.
     1156   define variable  sym2 as char init ":"   no-undo.
     1157   define variable  sym3 as char init ":"   no-undo.
     1158   define variable  sym4 as char init ":"   no-undo.
     1159   define variable  sym5 as char init ":"   no-undo.
     1160   define variable  sym6 as char init ":"   no-undo.
     1161   define variable  sym7 as char init ":"   no-undo.
     1162   define variable  sym8 as char init ":"   no-undo.
     1163   define variable  tb-code as char no-undo.
     1164   define variable  pbtb-code as character no-undo .
     1165   define variable  free-clmn as char no-undo.
     1166   define variable  Line         as  char    no-undo.
     1167   define variable  v-ind as integer no-undo .
     1168   DEFINE VARIABLE varattr-value as character no-undo .
     1169   DEFINE VARIABLE varattr-type as character no-undo .
     1170   define buffer buf_clients for ub.clients.
     1171   define buffer buf_units for ub.units.
     1172   define stream PrnLibStream.
     1173   DEFINE FRAME zapas
     1174   sym1 column-label ":!:" format "X(1)"
     1175   gds-zap.weight-bc column-label "Вес.!код" format "X(5)"
     1176   sym2 column-label ":!:" format "X(1)"
     1177   tb-code column-label "Код! " format "x(10)"
     1178   sym8 column-label ":!:" format "X(1)"
     1179   pbtb-code column-label "   ДопБк  " format "x(13)"
     1180   sym3 column-label ":!:" format "X(1)"
     1181   gds-zap.artic column-label "Артикул! " format "X(16)"
     1182   sym4 column-label ":!:" format "X(1)"
     1183   gds-zap.gds-name column-label "Название товара! " format "X(50)"
     1184   sym5 column-label ":!:" format "X(1)"
     1185   gds-zap.qnty     column-label "Количество! " format "->>>,>>9.999"
     1186   sym7 column-label ":!:" format "X(1)"
     1187   free-clmn column-label "Для заметок! " format "X(38)"
     1188   sym6 column-label ":!:" format "X(1)"
     1189   HEADER
     1190   cur-time-print() AT 5 format "X(35)"
     1191   string( "Страница" ) AT 110 PAGE-NUMBER(Prnlibstream) AT 120 FORMAT ">>>9" SKIP
     1192   Line format "X(135)" AT 1
     1193   with width 160 down stream-io.
     1194   if not can-find(first scnblist) then do:
     1195     message
     1196       "Список пустой"
     1197       view-as alert-box information .
     1198     return .
     1199   end.
     1200   run waitfram-show in this-procedure ( "Обработано записей " ) .
     1201   FOR EACH scnblist USE-INDEX art NO-LOCK:
     1202     assign
     1203     v-ind = v-ind + 1
     1204     .
     1205     if ( v-ind modulo 25 ) = 0 then do:
     1206       run waitfram-show in this-procedure ( "Обработано записей " + string(v-ind) ) .
     1207     end.
     1208     FIND buf_clients WHERE
     1209        buf_clients.obj-type = scnblist.prod-type
     1210    AND buf_clients.obj-code = scnblist.prod-code NO-LOCK .
     1211     CREATE gds-zap .
     1212     assign
     1213     gds-zap.unit-base  = scnblist.unit-base
     1214     gds-zap.prt-root     = scnblist.prt-root
     1215     gds-zap.gds-name = scnblist.gds-name
     1216     gds-zap.prod-type  = scnblist.prod-type
     1217     gds-zap.prod-code = scnblist.prod-code
     1218     gds-zap.artic          = scnblist.artic
     1219     gds-zap.prod-name = buf_clients.obj-name
     1220     gds-zap.grp-name = scnblist.grp-name
     1221     gds-zap.order-num  = scnblist.order-num
     1222     gds-zap.qnty     = scnblist.qnty
     1223     .
     1224   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     1225     (input  scnblist.gds-code
     1226     ,input  ?
     1227     ,output gds-zap.b-code
     1228     )  .
     1229     assign
     1230       gds-zap.weight-bc = ""
     1231     .
     1232     FIND buf_units WHERE
     1233         buf_units.unit-name = scnblist.unit-base NO-LOCK.
     1234     if lookup('вес':U, buf_units.type) > 0 then do:
     1235       varattr-value = "":U.
     1236       run gdsoattr-value in this-procedure(
     1237                                             input 'scales-code':U
     1238                                             ,input scnblist.gds-code
     1239                                             ,input p-obj-type
     1240                                             ,input p-obj-code
     1241                                             ,output varattr-value
     1242                                             ,output varattr-type
     1243                                             ) no-error.
     1244       assign gds-zap.weight-bc = varattr-value.
     1245     end.
     1246     gds-zap.b-str     = (if gds-zap.weight-bc <> ? and gds-zap.weight-bc <> '':U then '':U else scnblist.b-str).
     1247   END.
     1248   run waitfram-hide in this-procedure .
     1249     run prn-lib-open-stream  in this-procedure (
     1250                                               input parparentproc
     1251                                               ,input 43
     1252                                               ,input yes
     1253                                               ,input no
     1254                                               ).
     1255   PUT  stream PrnlibStream
     1256   space(30)
     1257   "СПИСОК  КОДОВ" format "X(50)" SKIP(1)
     1258            .
     1259   FORM HEADER
     1260   Line format "X(135)" AT 1 SKIP
     1261   "Продолжение - на следующей странице" AT 30 SKIP
     1262   with FRAME BottomFrame width 160 PAGE-BOTTOM NO-LABELS NO-BOX.
     1263   VIEW stream Prnlibstream FRAME BottomFrame .
     1264   Line = fill("-", 140) .
     1265   FORM with frame zapas .
     1266   CASE p-Classify :
     1267     when "Classify_1" then do:
     1268       FOR EACH gds-zap BREAK BY  (if p-sorttype = "artic":U                     then gds-zap.artic                     else (if p-sorttype = "b-code":U                           then string( gds-zap.b-code, "9999999999" )                           else string(gds-zap.order-num, "9999999999"))                           ) :
     1269         DISPLAY stream PrnLibStream
     1270         sym1 string( gds-zap.b-code, ">>>>>>>>>9" ) @ tb-code
     1271         sym2 gds-zap.artic sym3 gds-zap.gds-name
     1272         sym4 gds-zap.weight-bc
     1273         sym5 free-clmn sym6
     1274           sym7
     1275           gds-zap.qnty
     1276           sym8
     1277           gds-zap.b-str @ pbtb-code
     1278         with frame zapas .
     1279         DOWN stream PrnLibStream
     1280         1 with frame zapas .
     1281       END.
     1282     end.
     1283     when "Classify_2" then do:
     1284       FOR EACH gds-zap
