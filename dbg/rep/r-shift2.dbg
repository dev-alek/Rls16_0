     1688   FORM HEADER
     1689     string( p-z-number-list, "x(198)":U ) format "x(198)":U skip "------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------" skip "               ИНФОРМАЦИЯ О ПРОДУКТЕ               :                           РАСШИФРОВКА ПОСТУПЛЕНИЯ                        :               РАСШИФРОВКА РЕАЛИЗАЦИИ              :       ОСТАТОК     " skip "------------------------------------------------------------------------------------------------------------------------------:---------------------------------------------------:       на конец    " skip "НАИМЕНОВАНИЕ:   КОД   :ЦЕНА    : ОСТАТОК НА НАЧАЛО :           ПОСТАВЩИК       :    НОМЕР     :        КОЛИЧЕСТВО      :ТЕМПЕ-:    ТИП РАСХОДА   : КОЛ-ВО  : КОЛ-ВО  :    СУММА   :-------------------" skip "  продукта  : товара  :розничн :-------------------:---------------------------:   документа  :------------------------:РАТУРА:   (тип платежа)  :в литрах :в килогр :            : КОЛ-ВО  : КОЛ-ВО  " skip "            :         :на конец:  ОБЪЕМ  : МАССА   :   Наименование   :  Код   :    прихода   : ОБЪЕМ  :ПЛОТ- : МАССА  :в цис-:                  :         :         :            :в литрах :в килогр." skip "            :         :смены   :         :         :                  :        :     (ТТН)    :        :НОСТЬ :        : терне:                  :         :         :            :         :         " skip "            :         :        :    л    :   кг    :                  :        :              :   л    :кг/м3 :   кг   : гр.С :                  :    л    :    кг   :            :         :         " skip "------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------"
     1690   WITH FRAME TopFrame WIDTH 232 PAGE-TOP NO-LABELS NO-BOX.
     1691   VIEW STREAM PrnLibstream FRAME TOpFrame.
     1692   for each actreal-2 :
     1693     delete actreal-2 .
     1694   end.
     1695   FOR EACH t-2 USE-INDEX pi :
     1696     assign areal-is-pay-qnty1 = 0
     1697            areal-is-pay-qnty2 = 0
     1698            areal-is-pay-netto = 0
     1699            areal-no-pay-qnty1 = 0
     1700            areal-no-pay-qnty2 = 0
     1701            areal-no-pay-netto = 0
     1702            areal-qnty1        = 0
     1703            areal-qnty2        = 0
     1704            areal-netto        = 0
     1705            aincome-qnty1      = 0
     1706            aincome-qnty2      = 0
     1707            loc-real-ii        = 1
     1708            loc-grpii          = 0
     1709            loc-grp-only-not-single = 0
     1710            loc-income-ii      = 0
     1711            curr-real-ii       = 1.
     1712     FIND LAST treal-2 NO-LOCK WHERE
     1713               treal-2.gds-code = t-2.gds-code AND
     1714               treal-2.is-pay   = YES          USE-INDEX vi NO-ERROR.
     1715     if available treal-2 then do:
     1716       assign loc-real-ii  = treal-2.ii + 1
     1717              curr-real-ii = treal-2.ii + 1.
     1718     end.
     1719     IF CAN-FIND( FIRST treal-2 WHERE
     1720                        treal-2.gds-code = t-2.gds-code ) THEN DO:
     1721       do v-step = 1 to 2:
     1722         if v-step = 1 then assign v-is-pay = yes.
     1723         if v-step = 2 then assign v-is-pay = no .
     1724         FOR EACH treal-2 WHERE treal-2.is-pay = v-is-pay AND treal-2.gds-code = t-2.gds-code and treal-2.curr-code >= 0 USE-INDEX pi :
     1725           assign
     1726             areal-qnty1 = areal-qnty1 + treal-2.qnty1
     1727             areal-qnty2 = areal-qnty2 + treal-2.qnty2
     1728             areal-netto = areal-netto + treal-2.netto
     1729           .
     1730           if treal-2.is-pay = yes then do:
     1731             assign
     1732             areal-is-pay-qnty1 = areal-is-pay-qnty1 + treal-2.qnty1
     1733             areal-is-pay-qnty2 = areal-is-pay-qnty2 + treal-2.qnty2
     1734             areal-is-pay-netto = areal-is-pay-netto + treal-2.netto.
     1735             if p-with-cp-grouping = yes then do:
     1736               assign
     1737               v-grp-code = ?
     1738               v-grp-code = get-grp-name-code(treal-2.cpay-code, treal-2.curr-code, output v-grp-name)
     1739               v-grp-code = (if v-grp-code = ? then 10000 else v-grp-code)
     1740               v-grp-name = (if v-grp-code = 10000
     1741                             then "(По остальным)"
     1742                             else substitute("(По гр. &1)", string(v-grp-name, "X(9)"))
     1743                             )
     1744               .
     1745               FIND FIRST grptreal-2 WHERE
     1746                           grptreal-2.gds-code = treal-2.gds-code AND
     1747                           grptreal-2.cpay-code = - v-grp-code AND
     1748                           grptreal-2.curr-code = - 1 AND
     1749                           grptreal-2.is-pay = treal-2.is-pay NO-ERROR.
     1750               if not available grptreal-2 then do:
     1751                 run create-treal-2 in this-procedure ( input treal-2.gds-code,
     1752                                                           input - v-grp-code,
     1753                                                           input - 1 ,
     1754                                                           input treal-2.qnty1,
     1755                                                           input treal-2.qnty2,
     1756                                                           input treal-2.netto,
     1757                                                           input  chr(4) + v-grp-name,
     1758                                                           input treal-2.is-pay,
     1759                                                           input loc-real-ii ) no-error.
     1760                 assign
     1761                 curr-real-ii = curr-real-ii + 1
     1762                 loc-grp-only-not-single = loc-grp-only-not-single + 1
     1763                 loc-real-ii = loc-real-ii + 1
     1764                 loc-grpii       = loc-grpii + 1
     1765                 .
     1766               end.
     1767               else do:
     1768                 assign
     1769                 loc-grp-only-not-single = (if grptreal-2.out-name  begins chr(4)
     1770                                        then (loc-grp-only-not-single - 1)
     1771                                        else loc-grp-only-not-single)
     1772                 grptreal-2.out-name = v-grp-name
     1773                 grptreal-2.qnty1 = grptreal-2.qnty1 + treal-2.qnty1
     1774                 grptreal-2.qnty2 = grptreal-2.qnty2 + treal-2.qnty2
     1775                 grptreal-2.netto = grptreal-2.netto + treal-2.netto
     1776                 .
     1777               end.
     1778             end.
     1779           end.
     1780           else do:
     1781             assign
     1782                   rc            = recid( treal-2 )
     1783             curr-real-ii         = ( if (curr-real-ii = loc-real-ii)
     1784                                      AND
     1785                                       ( (loc-real-ii - loc-grp-only-not-single) > 1
     1786                                       OR
     1787                                       can-find( first treal-2 no-lock where
     1788                                                       treal-2.gds-code =  t-2.gds-code and
     1789                                                       treal-2.is-pay   =  no           and
     1790                                                       recid( treal-2 ) <> rc ) )
     1791                                     then ( curr-real-ii + 1 )
     1792                                     else   curr-real-ii )
     1793             treal-2.ii           = curr-real-ii
     1794             curr-real-ii         = curr-real-ii + 1.
     1795             if treal-2.cpay-code <> -4 then do:
     1796               assign areal-no-pay-qnty1 = areal-no-pay-qnty1 + treal-2.qnty1
     1797                     areal-no-pay-qnty2 = areal-no-pay-qnty2 + treal-2.qnty2
     1798                     areal-no-pay-netto = areal-no-pay-netto + treal-2.netto.
     1799             end.
     1800           end.
     1801         end.
     1802       END.
     1803       if curr-real-ii - loc-grp-only-not-single > 2 then do:
     1804         run create-treal-2 in this-procedure ( input t-2.gds-code,
     1805                                                input 0,
     1806                                                input 0,
     1807                                                input areal-is-pay-qnty1,
     1808                                                input areal-is-pay-qnty2,
     1809                                                input areal-is-pay-netto,
     1810                                                input "ИТОГО ОПЛАЧ.РАСХОД",
     1811                                                input yes,
     1812                                                input loc-real-ii           ) no-error.
     1813         if loc-real-ii = curr-real-ii then do:
     1814           assign curr-real-ii = curr-real-ii + 1.
     1815         end.
     1816         run create-treal-2 in this-procedure ( input t-2.gds-code,
     1817                                                input 0,
     1818                                                input 0,
     1819                                                input areal-no-pay-qnty1,
     1820                                                input areal-no-pay-qnty2,
     1821                                                input areal-no-pay-netto,
     1822                                                input "ИТОГО ПРОЧ.РАСХОД",
     1823                                                input no,
     1824                                                input curr-real-ii         ) no-error.
     1825         assign curr-real-ii = curr-real-ii + 1.
     1826         run create-treal-2 in this-procedure ( input t-2.gds-code,
     1827                                                input 0,
     1828                                                input 0,
     1829                                                input areal-qnty1,
     1830                                                input areal-qnty2,
     1831                                                input areal-netto,
     1832                                                input "ВСЕГО РАСХОД ",
     1833                                                input ?,
     1834                                                input curr-real-ii     ) no-error.
     1835       end.
     1836     END.
     1837     FOR EACH tincome-2 WHERE
     1838              tincome-2.gds-code = t-2.gds-code
     1839              USE-INDEX vi
     1840              :
     1841       if tincome-2.supp-name = "Итого по поставщику" then do:
     1842         assign loc-income-ii = tincome-2.ii .
     1843         next.
     1844       end.
     1845       assign aincome-qnty1 = aincome-qnty1 + tincome-2.qnty1
     1846              aincome-qnty2 = aincome-qnty2 + tincome-2.qnty2
     1847              loc-income-ii = tincome-2.ii
     1848              .
     1849     END.
     1850     if loc-income-ii > 1 then do:
     1851       run create-tincome-2 in this-procedure ( input t-2.gds-code,
     1852                                                input "",
     1853                                                input aincome-qnty1,
     1854                                                input aincome-qnty2,
     1855                                                input "ИТОГО ПОСТУПЛЕНИЙ",
     1856                                                input 0,
     1857                                                input no,
     1858                                                input ( loc-income-ii + 1 ) ) no-error.
     1859       assign loc-income-ii = loc-income-ii + 1.
     1860     end.
     1861     assign t-2.lines = MAX( curr-real-ii - loc-grp-only-not-single
     1862                           , loc-income-ii, 1 ).
     1863   END.
     1864   if Make-Excel then  put   stream ForExcel unformatted skip.
     1865   FOR EACH t-2 NO-LOCK
     1866       BREAK
     1867         BY t-2.main-code :
     1868     v-delta = 0.
     1869     DO jj = 1 TO t-2.lines :
     1870       assign pol1      = "":U
     1871              pol2      = 0
     1872              pol3      = 0
     1873              pol4      = 0
     1874              pol5      = 0
     1875              pol6      = "":U
     1876              pol7      = 0
     1877              pol8      = "":U
     1878              pol9      = 0
     1879              pol10     = 0
     1880              pol11     = 0
     1881              pol12     = ?
     1882              pol13     = "":U
     1883              pol14     = 0
     1884              pol15     = 0
     1885              pol16     = 0
     1886              pol17     = 0
     1887              pol18     = 0
     1888              main-line = no
     1889              supp-line = no
     1890              pay-line  = no.
     1891       IF jj = 1 then do:
     1892         assign pol1      = t-2.gds-name
     1893                pol2      = t-2.main-code
     1894                pol3      = t-2.last-price
     1895                pol4      = t-2.qnty1-before
     1896                pol5      = t-2.qnty2-before
     1897                pol17     = t-2.qnty1-after
     1898                pol18     = t-2.qnty2-after
     1899                main-line = yes.
     1900         if p-batch > 0
     1901         and p-report-id  = "53/2040"
     1902         then do:
     1903           find first buf_shift-pgds where
     1904                   buf_shift-pgds.obj-type = p-obj-type
     1905               and buf_shift-pgds.obj-code = p-obj-code
     1906               and buf_shift-pgds.shift-date = X-date-end
     1907               and buf_shift-pgds.shift-num = X-shift-end
     1908               and buf_shift-pgds.gds-code = t-2.gds-code no-error.
     1909           if available buf_shift-pgds then do:
     1910             assign
     1911             buf_shift-pgds.end-price-sale = t-2.last-price
     1912             .
     1913             release buf_shift-pgds.
     1914           end.
     1915         end.
     1916       END.
     1917       FIND FIRST tincome-2 NO-LOCK WHERE
     1918                  tincome-2.gds-code = t-2.gds-code AND
     1919                  tincome-2.ii       = jj           NO-ERROR.
     1920       IF AVAIlABLE tincome-2 THEN DO:
     1921   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input tincome-2.doc-code ,
     1922                           input 'nids':U ,
     1923                          output v-attr-value ,
     1924                          output v-attr-type )  .
     1925         assign
     1926           pol8 = if v-attr-value = "" or v-attr-value = ?
     1927                  then tincome-2.doc-code
     1928                  else v-attr-value
     1929           pol8-excel = if v-attr-value = "" or v-attr-value = ?
     1930                  then tincome-2.doc-code
     1931                  else '="' + v-attr-value + '"'
     1932         .
     1933         ASSIGN pol6      = tincome-2.supp-name
     1934                pol7      = tincome-2.supp-code
     1935                pol9      = tincome-2.qnty1
     1936                pol10     = tincome-2.density
     1937                pol11     = tincome-2.qnty2
     1938                pol12     = tincome-2.temperature
     1939                supp-line = yes.
     1940        if p-batch > 0
     1941        and tincome-2.supp-code > 0
     1942        and tincome-2.gds-code > 0
     1943        and p-report-id  = "53/2040"
     1944        then do:
     1945         find first buf_shift-pgds-in where
     1946                   buf_shift-pgds-in.obj-type = p-obj-type
     1947               and buf_shift-pgds-in.obj-code = p-obj-code
     1948               and buf_shift-pgds-in.shift-date = X-date-end
     1949               and buf_shift-pgds-in.shift-num = X-shift-end
     1950               and buf_shift-pgds-in.gds-code = t-2.gds-code
     1951               and buf_shift-pgds-in.doc-code = tincome-2.doc-code no-error.
     1952           if not available buf_shift-pgds-in then do:
     1953             create buf_shift-pgds-in.
     1954             assign
     1955             buf_shift-pgds-in.obj-type = p-obj-type
     1956             buf_shift-pgds-in.obj-code = p-obj-code
     1957             buf_shift-pgds-in.shift-date = X-date-end
     1958             buf_shift-pgds-in.shift-num = X-shift-end
     1959             buf_shift-pgds-in.gds-code = t-2.gds-code
     1960             buf_shift-pgds-in.doc-code = tincome-2.doc-code
     1961             buf_shift-pgds-in.cli-type-code = substitute("&1&2", tincome-2.supp-type, tincome-2.supp-code)
     1962             buf_shift-pgds-in.cli-name = tincome-2.supp-name
     1963             buf_shift-pgds-in.fact-qnty = tincome-2.qnty1
     1964             buf_shift-pgds-in.fact-qnty-2 = tincome-2.qnty2
     1965             .
     1966             release buf_shift-pgds-in.
     1967           end.
     1968         end.
     1969       END.
     1970      _not-empty-group:
     1971       do while true :
     1972         FIND FIRST treal-2 NO-LOCK WHERE
     1973                   treal-2.gds-code = t-2.gds-code AND
     1974                   treal-2.ii       = jj + v-delta          NO-ERROR.
     1975         if not available treal-2  then leave _not-empty-group.
     1976         if available treal-2 then do:
     1977           if treal-2.cpay-code <> 0
     1978           or treal-2.curr-code= - 1
     1979           then do:
     1980             FIND FIRST actreal-2 WHERE
     1981                       actreal-2.gds-code = 0 AND
     1982                       actreal-2.cpay-code = treal-2.cpay-code AND
     1983                       actreal-2.curr-code = treal-2.curr-code AND
     1984                       actreal-2.is-pay = treal-2.is-pay NO-ERROR.
     1985             if not available actreal-2 then do:
     1986               assign acii = acii + 1.
     1987               run create-actreal-2 in this-procedure ( input 0,
     1988                                                       input treal-2.cpay-code,
     1989                                                       input treal-2.curr-code,
     1990                                                       input treal-2.qnty1,
     1991                                                       input treal-2.qnty2,
     1992                                                       input treal-2.netto,
     1993                                                       input trim(treal-2.out-name, chr(4)),
     1994                                                       input treal-2.is-pay,
     1995                                                       input acii               ) no-error.
     1996             end.
     1997             else do:
     1998               assign actreal-2.qnty1 = actreal-2.qnty1 + treal-2.qnty1
     1999                     actreal-2.qnty2 = actreal-2.qnty2 + treal-2.qnty2
     2000                     actreal-2.netto = actreal-2.netto + treal-2.netto.
     2001             end.
     2002           end.
     2003           if treal-2.is-pay = yes
     2004           and treal-2.curr-code < 0
     2005           and treal-2.out-name begins chr(4) then do:
     2006             assign
     2007             v-delta = v-delta + 1
     2008             .
     2009             next _not-empty-group.
     2010           end.
     2011           else do:
     2012             assign
     2013             pol13    = treal-2.out-name
     2014             pol14    = treal-2.qnty1
     2015             pol15    = treal-2.qnty2
     2016             pol16    = treal-2.netto
     2017             pay-line = yes
     2018             .
     2019             if p-batch > 0
     2020           and (treal-2.curr-code > 0
     2021           or not (treal-2.curr-code = 0 and treal-2.cpay-code = 0)
     2022           )
     2023           and treal-2.gds-code > 0
     2024             and p-report-id  = "53/2040"
     2025           then do:
     2026             find first buf_shift-pgds-out where
     2027                   buf_shift-pgds-out.obj-type = p-obj-type
     2028               and buf_shift-pgds-out.obj-code = p-obj-code
     2029               and buf_shift-pgds-out.shift-date = X-date-end
     2030               and buf_shift-pgds-out.shift-num = X-shift-end
     2031               and buf_shift-pgds-out.gds-code = treal-2.gds-code
     2032                 and buf_shift-pgds-out.pay-code = treal-2.cpay-code
     2033                 and buf_shift-pgds-out.curr-code = treal-2.curr-code
     2034                 no-error.
     2035             if not available buf_shift-pgds-out then do:
     2036                 find first buf_cash-pay no-lock where
     2037                           buf_cash-pay.cdpay-code = treal-2.cpay-code
     2038                     and  buf_cash-pay.curr-code = treal-2.curr-code no-error.
     2039                 create buf_shift-pgds-out.
     2040               assign
     2041               buf_shift-pgds-out.obj-type = p-obj-type
     2042               buf_shift-pgds-out.obj-code = p-obj-code
     2043               buf_shift-pgds-out.shift-date = X-date-end
     2044               buf_shift-pgds-out.shift-num = X-shift-end
     2045               buf_shift-pgds-out.gds-code = treal-2.gds-code
     2046               buf_shift-pgds-out.pay-code = treal-2.cpay-code
     2047                 buf_shift-pgds-out.curr-code = treal-2.curr-code
     2048               buf_shift-pgds-out.out-name = treal-2.out-name
     2049                 buf_shift-pgds-out.cp-type = (if available buf_cash-pay
     2050                                               and buf_cash-pay.is-cash
     2051                                               then 1
     2052                                               else 2)
     2053               buf_shift-pgds-out.fact-qnty = treal-2.qnty1
     2054               buf_shift-pgds-out.fact-qnty-2 = treal-2.qnty2
     2055               buf_shift-pgds-out.fact-sum = treal-2.netto
     2056               .
     2057               release buf_shift-pgds-out.
     2058                 .
     2059               end.
     2060             end.
     2061             leave _not-empty-group.
     2062             end.
     2063           end.
     2064       end.
     2065       DISPLAY STREAM PrnLibstream pol1
     2066                                pol2  WHEN main-line = yes
     2067                                pol3  WHEN main-line = yes
     2068                                pol4  WHEN main-line = yes
     2069                                pol5  WHEN main-line = yes
     2070                                pol6
