     2271                             CHR(9) skip.
     2272           DOWN 1 STREAM PrnLibstream WITH FRAME FRAME-2.
     2273           if last-of( actreal-2.is-pay )  then do:
     2274             if actreal-2.is-pay = yes then do:
     2275               assign pol13 = "ИТОГО ОПЛАЧ.РАСХОД"
     2276                      pol14 = areal-is-pay-qnty1
     2277                      pol15 = areal-is-pay-qnty2
     2278                      pol16 = areal-is-pay-netto.
     2279             end.
     2280             else do:
     2281               assign pol13 = "ИТОГО ПРОЧ.РАСХОД"
     2282                      pol14 = areal-no-pay-qnty1
     2283                      pol15 = areal-no-pay-qnty2
     2284                      pol16 = areal-no-pay-netto.
     2285             end.
     2286             DISPLAY STREAM PrnLibstream pol13
     2287                                      pol14
     2288                                      pol15
     2289                                      pol16
     2290                                      sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12 sym13 sym14 sym15 sym16 sym17
     2291             WITH FRAME FRAME-2.
     2292             if Make-Excel then  put   stream ForExcel unformatted       CHR(9)
     2293                               CHR(9)
     2294                               CHR(9)
     2295                               CHR(9)
     2296                               CHR(9)
     2297                               CHR(9)
     2298                               CHR(9)
     2299                               CHR(9)
     2300                               CHR(9)
     2301                               CHR(9)
     2302                               CHR(9)
     2303                               CHR(9)
     2304                         pol13 CHR(9)
     2305                         pol14 CHR(9)
     2306                         pol15 CHR(9)
     2307                         pol16 CHR(9)
     2308                               CHR(9) skip.
     2309             DOWN 1 STREAM PrnLibstream WITH FRAME FRAME-2.
     2310           end.
     2311         END.
     2312       END.
     2313       UNDERLINE STREAM PrnLibstream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12 sym13 sym14 sym15 sym16 sym17 pol1 pol2 pol3 pol4 pol5 pol6 pol7 pol8 pol9 pol10 pol11 pol12 pol13 pol14 pol15 pol16 pol17 pol18 WITH FRAME FRAME-2.
     2314     END.
     2315   END.
     2316   PROCEDURE create-tincome-2 :
     2317     define input parameter p-gds-code  like ub.goods.gds-code   no-undo.
     2318     define input parameter p-doc-code  like ub.trn-doc.doc-code no-undo.
     2319     define input parameter p-qnty1     as   decimal             no-undo.
     2320     define input parameter p-qnty2     as   decimal             no-undo.
     2321     define input parameter p-supp-name as   character           no-undo.
     2322     define input parameter p-supp-code like ub.clients.obj-code no-undo.
     2323     define input parameter p-is-fact   as   logical             no-undo.
     2324     define input parameter p-ii        as   integer             no-undo.
     2325     _main:
     2326     DO ON ERROR UNDO _main, RETURN ERROR :
     2327       CREATE tincome-2.
     2328       assign tincome-2.gds-code    = p-gds-code
     2329              tincome-2.doc-code    = p-doc-code
     2330              tincome-2.qnty1       = p-qnty1
     2331              tincome-2.qnty2       = p-qnty2
     2332              tincome-2.supp-code   = p-supp-code
     2333              tincome-2.supp-name   = p-supp-name
     2334              tincome-2.is-fact     = p-is-fact
     2335              tincome-2.temperature = ?
     2336              tincome-2.ii          = p-ii        no-error.
     2337       IF ERROR-STATUS :ERROR THEN DO: UNDO _main, RETURN ERROR. END.
     2338     END.
     2339   END PROCEDURE.
