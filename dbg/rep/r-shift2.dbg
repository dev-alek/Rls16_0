     1615     procedure on-same-page :
     1616       define input parameter p-line-number as integer no-undo .
     1617       if p-line-number > page-size( PrnLibstream )
     1618       then do:
     1619         return .
     1620       end.
     1621       if line-counter( PrnLibstream ) + p-line-number > page-size( PrnLibstream )
     1622       then do:
     1623         page stream PrnLibstream .
     1624       end.
     1625     end procedure.
     1626   FUNCTION get-grp-name-code RETURNS INTEGER
     1627     ( INPUT p-cdpay-code AS integer, INPUT p-curr-code AS INTEGER, output p-grp-name as character ) :
     1628   DEFINE VARIABLE v-dopi AS INTEGER NO-UNDO INIT ?.
     1629   DEFINE VARIABLE v-value AS character NO-UNDO.
     1630   DEFINE VARIABLE v-type AS character NO-UNDO.
     1631     RUN cp-attr-value  IN THIS-PROCEDURE(
     1632        input p-cdpay-code
     1633       ,input p-curr-code
     1634       ,input 0
     1635       ,input '':U
     1636       ,input 0
     1637       ,INPUT 'grp-code':U
     1638       ,output v-value
     1639       ,OUTPUT v-type) NO-ERROR.
     1640     IF NOT ERROR-STATUS:ERROR THEN DO:
     1641         ASSIGN
     1642         v-dopi = INTEGER(entry(2, v-value, chr(4)))
     1643         p-grp-name = entry(1, v-value, chr(4) )
     1644         NO-ERROR.
     1645     END.
     1646     RETURN v-dopi.
     1647   END FUNCTION.
