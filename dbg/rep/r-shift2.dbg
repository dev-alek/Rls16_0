     2072                                pol8  WHEN pol8 <> ""
     2073                                pol9  WHEN supp-line = yes
     2074                                pol10 when supp-line = yes and pol10 <> ? and pol10 > 0
     2075                                pol11 WHEN supp-line = yes
     2076                                pol12 WHEN pol7 <> 0 and pol12 <> ?
     2077                                pol13
     2078                                pol14 WHEN pay-line  = yes
     2079                                pol15 WHEN pay-line  = yes
     2080                                pol16 WHEN pay-line  = yes
     2081                                pol17 WHEN main-line = yes
     2082                                pol18 WHEN main-line = yes
     2083                                sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12 sym13 sym14 sym15 sym16 sym17
     2084       WITH FRAME FRAME-2.
     2085       if jj < t-2.lines then do: down stream PrnLibstream with frame FRAME-2. end.
     2086       if main-line = yes then do:
     2087         assign accum-4  = accum-4  + pol4
     2088                accum-5  = accum-5  + pol5
     2089                accum-17 = accum-17 + pol17
     2090                accum-18 = accum-18 + pol18.
     2091         if Make-Excel then  put   stream ForExcel unformatted pol1 CHR(9)
     2092                     pol2 CHR(9)
     2093                     pol3 CHR(9)
     2094                     pol4 CHR(9)
     2095                     pol5 CHR(9).
