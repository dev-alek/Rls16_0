     1057   end procedure.
     1058   procedure cp-attr-value :
     1059     do
     1060     on error undo, return error
     1061     :
     1062       define input parameter p-cdpay-code   like ub.cash-pay-attr.cdpay-code     no-undo .
     1063       define input parameter p-curr-code    like ub.cash-pay-attr.curr-code      no-undo .
     1064       define input parameter p-host-code    like ub.cash-pay-attr.host-code      no-undo .
     1065       define input parameter p-obj-type     like ub.cash-pay-attr.obj-type       no-undo .
     1066       define input parameter p-obj-code     like ub.cash-pay-attr.obj-code       no-undo .
     1067       define input  parameter p-code        like ub.cash-pay-attr.attr-code      no-undo .
     1068       define output parameter p-value       like ub.cash-pay-attr.attr-value    no-undo .
     1069       define output parameter p-type        as character no-undo .
     1070       define buffer buf_cash-pay-attr for ub.cash-pay-attr .
     1071       define variable v-format         as character no-undo .
     1072       define variable v-label          as character no-undo .
     1073       define variable v-range          as integer   no-undo .
     1074       define variable v-user-can-edit  as logical   no-undo .
     1075       define variable v-output-display as logical   no-undo .
     1076       define variable v-other          as character no-undo .
     1077       run cp-attr-code in this-procedure
     1078         (input  p-code
     1079         ,output p-type
     1080         ,output v-format
     1081         ,output v-label
     1082         ,output v-range
     1083         ,output v-user-can-edit
     1084         ,output v-output-display
     1085         ,output v-other
     1086         ) no-error .
     1087       if error-status :error then do:
     1088         undo, return error return-value .
     1089       end.
     1090       find first buf_cash-pay-attr no-lock
     1091         where buf_cash-pay-attr.cdpay-code = p-cdpay-code
     1092           and buf_cash-pay-attr.curr-code  = p-curr-code
     1093           and buf_cash-pay-attr.host-code  = p-host-code
     1094           and buf_cash-pay-attr.obj-type   = p-obj-type
     1095           and buf_cash-pay-attr.obj-code   = p-obj-code
     1096           and buf_cash-pay-attr.attr-code  = p-code
     1097         no-error .
     1098       if avail buf_cash-pay-attr then do:
     1099         assign
     1100           p-value =  buf_cash-pay-attr.attr-value
     1101         .
     1102       end.
     1103       else do:
     1104         assign
     1105           p-value = if p-type = 'L':U then "no":U else ""
     1106         .
     1107       end.
     1108     end.
     1109   end procedure.
     1110   procedure cp-attr-write :
     1111     do
     1112     on error undo, return error
     1113     :
     1114       define input parameter p-cdpay-code   like ub.cash-pay-attr.cdpay-code     no-undo .
     1115       define input parameter p-curr-code    like ub.cash-pay-attr.curr-code      no-undo .
     1116       define input parameter p-host-code    like ub.cash-pay-attr.host-code      no-undo .
     1117       define input parameter p-obj-type     like ub.cash-pay-attr.obj-type       no-undo .
     1118       define input parameter p-obj-code     like ub.cash-pay-attr.obj-code       no-undo .
     1119       define input parameter p-code     like ub.cash-pay-attr.attr-code  no-undo .
     1120       define input parameter p-value    like ub.cash-pay-attr.attr-value no-undo .
     1121       define buffer buf_cash-pay-attr for ub.cash-pay-attr .
     1122       define buffer last_cash-pay-attr for ub.cash-pay-attr .
     1123       define variable v-type           as character no-undo .
     1124       define variable v-format         as character no-undo .
     1125       define variable v-label          as character no-undo .
     1126       define variable v-range          as integer   no-undo .
     1127       define variable v-user-can-edit  as logical   no-undo .
     1128       define variable v-output-display as logical   no-undo .
     1129       define variable v-other          as character no-undo .
     1130       run cp-attr-code in this-procedure
     1131         (input  p-code
     1132         ,output v-type
     1133         ,output v-format
     1134         ,output v-label
     1135         ,output v-range
     1136         ,output v-user-can-edit
     1137         ,output v-output-display
     1138         ,output v-other
     1139         ) no-error .
     1140       if error-status :error then do:
     1141         undo, return error return-value .
     1142       end.
     1143       find first buf_cash-pay-attr exclusive-lock
     1144         where buf_cash-pay-attr.cdpay-code = p-cdpay-code
     1145           and buf_cash-pay-attr.curr-code  = p-curr-code
     1146           and buf_cash-pay-attr.host-code  = p-host-code
     1147           and buf_cash-pay-attr.obj-type   = p-obj-type
     1148           and buf_cash-pay-attr.obj-code   = p-obj-code
     1149           and buf_cash-pay-attr.attr-code = p-code
     1150         no-error .
     1151       if not available buf_cash-pay-attr then do:
     1152         create buf_cash-pay-attr .
     1153         assign
     1154         buf_cash-pay-attr.cdpay-code = p-cdpay-code
     1155         buf_cash-pay-attr.curr-code  = p-curr-code
     1156         buf_cash-pay-attr.host-code  = p-host-code
     1157         buf_cash-pay-attr.obj-type   = p-obj-type
     1158         buf_cash-pay-attr.obj-code   = p-obj-code
     1159         buf_cash-pay-attr.attr-code = p-code
     1160         .
     1161       end.
     1162       assign
     1163         buf_cash-pay-attr.attr-value = p-value
     1164       .
     1165       release buf_cash-pay-attr no-error .
     1166       if error-status:error then do:
     1167         undo, return error return-value .
     1168       end.
     1169     end.
     1170   end procedure.
     1171   procedure cp-attr-exist :
     1172     do
     1173     on error undo, return error
     1174     :
     1175       define input parameter p-cdpay-code   like ub.cash-pay-attr.cdpay-code     no-undo .
     1176       define input parameter p-curr-code    like ub.cash-pay-attr.curr-code      no-undo .
     1177       define input parameter p-host-code    like ub.cash-pay-attr.host-code      no-undo .
     1178       define input parameter p-obj-type     like ub.cash-pay-attr.obj-type       no-undo .
     1179       define input parameter p-obj-code     like ub.cash-pay-attr.obj-code       no-undo .
     1180       define input parameter p-code     like ub.cash-pay-attr.attr-code  no-undo .
     1181       define output parameter p-exist   as logical  no-undo .
     1182       define buffer buf_cash-pay-attr for ub.cash-pay-attr .
     1183       define variable v-type           as character no-undo .
     1184       define variable v-format         as character no-undo .
     1185       define variable v-label          as character no-undo .
     1186       define variable v-range          as integer   no-undo .
     1187       define variable v-user-can-edit  as logical   no-undo .
     1188       define variable v-output-display as logical   no-undo .
     1189       define variable v-other          as character no-undo .
     1190       run cp-attr-code in this-procedure
     1191         (input  p-code
     1192         ,output v-type
     1193         ,output v-format
     1194         ,output v-label
     1195         ,output v-range
     1196         ,output v-user-can-edit
     1197         ,output v-output-display
     1198         ,output v-other
     1199         ) no-error .
     1200       if error-status :error then do:
     1201         undo, return error return-value .
     1202       end.
     1203       find first buf_cash-pay-attr exclusive-lock
     1204         where buf_cash-pay-attr.cdpay-code = p-cdpay-code
     1205           and buf_cash-pay-attr.curr-code  = p-curr-code
     1206           and buf_cash-pay-attr.host-code  = p-host-code
     1207           and buf_cash-pay-attr.obj-type   = p-obj-type
     1208           and buf_cash-pay-attr.obj-code   = p-obj-code
     1209           and buf_cash-pay-attr.attr-code = p-code
     1210         no-error .
     1211       if  available buf_cash-pay-attr then do:
     1212         p-exist = yes.
     1213       end.
     1214     end.
     1215   end procedure.
     1216   procedure cp-attr-delete :
     1217     do
     1218     on error undo, return error
     1219     :
     1220       define input parameter p-cdpay-code   like ub.cash-pay-attr.cdpay-code     no-undo .
     1221       define input parameter p-curr-code    like ub.cash-pay-attr.curr-code      no-undo .
     1222       define input parameter p-host-code    like ub.cash-pay-attr.host-code      no-undo .
     1223       define input parameter p-obj-type     like ub.cash-pay-attr.obj-type       no-undo .
     1224       define input parameter p-obj-code     like ub.cash-pay-attr.obj-code       no-undo .
     1225       define input parameter p-code     like ub.cash-pay-attr.attr-code  no-undo .
     1226       define output parameter p-deleted  as logical no-undo.
     1227       define buffer buf_cash-pay-attr for ub.cash-pay-attr .
     1228       define variable v-type           as character no-undo .
     1229       define variable v-format         as character no-undo .
     1230       define variable v-label          as character no-undo .
     1231       define variable v-range          as integer   no-undo .
     1232       define variable v-user-can-edit  as logical   no-undo .
     1233       define variable v-output-display as logical   no-undo .
     1234       define variable v-other          as character no-undo .
     1235       run cp-attr-code in this-procedure
     1236         (input  p-code
     1237         ,output v-type
     1238         ,output v-format
     1239         ,output v-label
     1240         ,output v-range
     1241         ,output v-user-can-edit
     1242         ,output v-output-display
     1243         ,output v-other
     1244         ) no-error .
     1245       if error-status :error then do:
     1246         undo, return error return-value .
     1247       end.
     1248       find first buf_cash-pay-attr exclusive-lock
     1249         where buf_cash-pay-attr.cdpay-code = p-cdpay-code
     1250           and buf_cash-pay-attr.curr-code  = p-curr-code
     1251           and buf_cash-pay-attr.host-code  = p-host-code
     1252           and buf_cash-pay-attr.obj-type   = p-obj-type
     1253           and buf_cash-pay-attr.obj-code   = p-obj-code
     1254           and buf_cash-pay-attr.attr-code = p-code
     1255         no-error NO-WAIT.
     1256       if not available buf_cash-pay-attr then do:
     1257         p-deleted = no.
     1258       end.
     1259       else do:
     1260         delete buf_cash-pay-attr no-error .
     1261         if error-status:error then do:
     1262           undo, return error return-value .
     1263         end.
     1264         p-deleted = yes.
     1265       end.
     1266     end.
     1267   end procedure.
     1268   procedure cp-attr-news :
     1269     do
     1270     on error undo, return error
     1271     :
     1272       define input  parameter p-code           as character no-undo .
     1273       define output parameter p-news           as logical   no-undo .
     1274       case p-code :
     1275               when 'paycard-export-prefix':U then do:     assign     p-news = true.   end.
     1276               when 'grp-code':U then do:     assign     p-news = true.   end.
     1277               when 'is-use':U then do:     assign     p-news = true.   end.
     1278               when 'dop-doc':U then do:     assign     p-news = true.   end.
     1279               when 'paycard-all-prefix':U then do:     assign     p-news = true.   end.
     1280               when 'paycard-edit-prefix':U then do:     assign     p-news = true.   end.
     1281               when 'form_km3':U then do:     assign     p-news = false.   end.
     1282               when 'bal_malina':U then do:     assign     p-news = false.   end.
     1283               when 'max_proc_sum':U then do:     assign     p-news = true.   end.
     1284               when 'mask_card_kup':U then do:     assign     p-news = true.   end.
     1285         otherwise do:
     1286           p-news = no.
     1287         end.
     1288       end.
     1289     end.
     1290   end procedure.
