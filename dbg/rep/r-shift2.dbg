     2223                areal-is-pay-qnty2 = 0
     2224                areal-is-pay-netto = 0
     2225                areal-no-pay-qnty1 = 0
     2226                areal-no-pay-qnty2 = 0
     2227                areal-no-pay-netto = 0.
     2228         FOR EACH actreal-2 NO-LOCK
