     2106           assign accum-9  = accum-9  + pol9
     2107                  accum-11 = accum-11 + pol11.
     2108         end.
     2109         if Make-Excel then  put   stream ForExcel unformatted pol6                                                           CHR(9)
     2110                     ( if pol7 <> 0 then string( pol7  ) else "":U )                CHR(9)
     2111                     ( if pol8-excel <> "" then pol8-excel else "":U)               CHR(9)
     2112                     pol9                                                           CHR(9)
     2113                     ( if pol7 <> 0 and pol10 <> ? then string( pol10 ) else "":U ) CHR(9)
     2114                     pol11                                                          CHR(9)
     2115                     ( if pol7 <> 0 and pol12 <> ? then string( pol12 ) else "":U ) CHR(9).
     2116       end.
     2117       else do:
     2118         if Make-Excel then  put   stream ForExcel unformatted CHR(9)
     2119                     CHR(9)
     2120                     CHR(9)
     2121                     CHR(9)
     2122                     CHR(9)
     2123                     CHR(9)
     2124                     CHR(9).
     2125       end.
     2126       if pay-line = yes then do:
     2127         if treal-2.cpay-code <> 0
     2128         and treal-2.curr-code <>  - 1
     2129         then do:
     2130         assign accum-14 = accum-14 + pol14
     2131                accum-15 = accum-15 + pol15
     2132                accum-16 = accum-16 + pol16.
     2133         end.
     2134         if Make-Excel then  put   stream ForExcel unformatted pol13 CHR(9)
     2135                     pol14 CHR(9)
     2136                     pol15 CHR(9)
     2137                     pol16 CHR(9).
     2138       end.
     2139       else do:
