     3668   procedure display-title :
     3669   define variable v-nn as integer   no-undo .
     3670      PUT stream  OutStream  UNFORMATTED  string( v-cntxt-host-name-obj +  " , " + x-store-type  +  " " + objname) at 50 format "x(85)" skip(2)
     3671             reportname  at 20 format "x(170)" skip
     3672             trim(str1)  at 35 format "x(75)" skip.
     3673        v-nn = num-entries(str2,chr(10)) .
     3674        repeat i = 1 to v-nn :
     3675         PUT stream  OutStream  UNFORMATTED  entry(i,str2,chr(10))  at 1 format "x(170)" skip.
     3676        end.
     3677       i=0.
     3678        PUT stream  OutStream  UNFORMATTED  trim(str3)  at 35 format "x(75)" skip.
     3679        v-nn = num-entries(str4,chr(10)) .
     3680        repeat i = 1 to v-nn:
     3681          PUT stream  OutStream  UNFORMATTED  entry(i,str4,chr(10))  at 1 format "x(170)" skip.
     3682        end.
     3683       i=0.
     3684        v-nn = num-entries( reportheader,chr(10)) .
     3685        repeat i = 1 to v-nn :
     3686         PUT stream  OutStream  UNFORMATTED  entry(i,reportheader,chr(10))  at 1 format "x(170)" skip.
     3687        end.
     3688       i=0.
     3689       run rep/extitle.p (1) .
     3690   end procedure.
     3691   procedure report-exec1  :
     3692      find first clients where x-store-type = clients.obj-type and
     3693                               x-store-code = clients.obj-code no-lock no-error.
     3694     run calcitog.
     3695     run print-header.
     3696      case retclassify :
     3697         when "vat-ps":u         then run run7 in this-procedure .
     3698         otherwise do:
     3699           message "error" view-as alert-box error .
     3700         end.
     3701      end case.
     3702     run print-footer.
     3703     end procedure.
     3704   procedure calc-sub-itog :
     3705   define variable b  as int no-undo.
     3706   assign
     3707     b1-gds-zap-other = b1-gds-zap-other +  gds-zap-other
     3708     b2-gds-zap-other = b2-gds-zap-other +  gds-zap-other
     3709     bi-gds-zap-other = bi-gds-zap-other +  gds-zap-other
     3710     bo-gds-zap-other = bo-gds-zap-other +  gds-zap-other
     3711     .
     3712   repeat b = 1 to 20 :
     3713     assign
     3714     b1-ostatok-start[b ]    = b1-ostatok-start[b ]    +  ostatok-start[b ]
     3715     b1-ostatok-end  [b ]    = b1-ostatok-end  [b ]    +  ostatok-end  [b ]
     3716     b2-ostatok-start[b ]    = b2-ostatok-start[b ]    +  ostatok-start[b ]
     3717     b2-ostatok-end  [b ]    = b2-ostatok-end  [b ]    +  ostatok-end  [b ]
     3718     bi-ostatok-start[b ]    = bi-ostatok-start[b ]    +  ostatok-start[b ]
     3719     bi-ostatok-end  [b ]    = bi-ostatok-end  [b ]    +  ostatok-end  [b ]
     3720     bo-ostatok-start[b ]    = bo-ostatok-start[b ]    +  ostatok-start[b ]
     3721     bo-ostatok-end  [b ]    = bo-ostatok-end  [b ]    +  ostatok-end  [b ]
     3722     b1-prih[b ]    = b1-prih[b ]    +  prih[b ]
     3723     b2-prih[b ]    = b2-prih[b ]    +  prih[b ]
     3724     bi-prih[b ]    = bi-prih[b ]    +  prih[b ]
     3725     bo-prih[b ]    = bo-prih[b ]    +  prih[b ]
     3726     b1-rash[b ]    = b1-rash[b ]    +  rash[b ]
     3727     b2-rash[b ]    = b2-rash[b ]    +  rash[b ]
     3728     bi-rash[b ]    = bi-rash[b ]    +  rash[b ]
     3729     bo-rash[b ]    = bo-rash[b ]    +  rash[b ]
     3730     b1-kassa[b ]    = b1-kassa[b ]    +  kassa[b ]
     3731     b2-kassa[b ]    = b2-kassa[b ]    +  kassa[b ]
     3732     bi-kassa[b ]    = bi-kassa[b ]    +  kassa[b ]
     3733     bo-kassa[b ]    = bo-kassa[b ]    +  kassa[b ]
     3734     b1-inv[b ]    = b1-inv[b ]    +  inv[b ]
     3735     b2-inv[b ]    = b2-inv[b ]    +  inv[b ]
     3736     bi-inv[b ]    = bi-inv[b ]    +  inv[b ]
     3737     bo-inv[b ]    = bo-inv[b ]    +  inv[b ]
     3738     b1-overturn[b ]    = b1-overturn[b ]    +  overturn[b ]
     3739     b2-overturn[b ]    = b2-overturn[b ]    +  overturn[b ]
     3740     bi-overturn[b ]    = bi-overturn[b ]    +  overturn[b ]
     3741     bo-overturn[b ]    = bo-overturn[b ]    +  overturn[b ]
     3742     .
     3743   end.
     3744   end procedure.
     3745   procedure clear-item :
     3746   define variable kk as int no-undo.
     3747    gds-zap-other = 0 .
     3748    repeat kk = 1 to 20 :
     3749    assign
     3750       prih            [kk]    = 0
     3751       rash            [kk]    = 0
     3752       kassa           [kk]    = 0
     3753       inv             [kk]    = 0
     3754       overturn        [kk]    = 0
     3755       ostatok-end     [kk]    = 0
     3756       ostatok-start   [kk]    = 0 .
     3757          end.
     3758    end procedure.
     3759   procedure item-goods :
     3760      def input parameter  par-3 as char no-undo.
     3761      def input parameter  par-4 as char no-undo.
     3762        if par-4 = "goods":u  then do:
     3763           assign
     3764               gds-zap-unit-base  = goods.unit-base
     3765               gds-zap-prt-root   = goods.prt-root
     3766               gds-zap-prod-type  = goods.prod-type
     3767               gds-zap-prod-code  = goods.prod-code
     3768               gds-zap-artic      = goods.artic
     3769               gds-zap-grp-name   = goods.grp-name
     3770               gds-zap-b-code     = goods.gds-code
     3771               gds-zap-type       = goods.gds-type.
     3772           if g#gds-engl then
     3773               assign gds-zap-gds-name = goods.engl-name.
     3774           else
     3775               assign gds-zap-gds-name = goods.gds-name.
     3776        end.
     3777        if par-4 = "gds-list":u  then do:
     3778           assign
     3779               gds-zap-unit-base  = gds-list.unit-base
     3780               gds-zap-prt-root   = gds-list.prt-root
     3781               gds-zap-prod-type  = gds-list.prod-type
     3782               gds-zap-prod-code  = gds-list.prod-code
     3783               gds-zap-artic      = gds-list.artic
     3784               gds-zap-grp-name   = gds-list.grp-name
     3785               gds-zap-b-code     = gds-list.gds-code
     3786               gds-zap-type       = gds-list.gds-type.
     3787           if g#gds-engl then
     3788               assign gds-zap-gds-name = gds-list.engl-name.
     3789           else
     3790               assign gds-zap-gds-name = gds-list.gds-name.
     3791        end.
     3792       define variable old-gds-zap-gds-name as character no-undo .
     3793       old-gds-zap-gds-name = gds-zap-gds-name.
     3794       x-type-pr = "r".
     3795       run foreach.
     3796   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     3797     (input  gds-zap-b-code
     3798     ,input  ?
     3799     ,output v-bar-code
     3800     )  .
     3801   s-bar-code = string (v-bar-code,"999999999").
     3802       If  break_group = true  and par-3 <> "1"  then DO :
     3803            FIND FIRST clients WHERE clients.obj-type = gds-zap-prod-type AND clients.obj-code = gds-zap-prod-code use-index pi NO-LOCK .
     3804            gds-zap-prod-name  = clients.obj-name.
     3805             If break_group1 = true  THEN  DO :
     3806               if (par-3 = "3"  OR  par-3 = "5" ) and  par-3 <> "6"
     3807                 then DO: Assign temp-str = string("ГРУППА : " + gds-zap-grp-name )         b1-name = gds-zap-grp-name . end.
