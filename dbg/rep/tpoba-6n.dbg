     3576           if xshowcost    then do: run di in this-procedure ("учет." ,12 ,"","", "", "", "b1":u).  end.
     3577           if xshowcrsa    then do: run di in this-procedure ("прод." ,15, "","", "", "", "b1":u).  end.
     3578           if xshowsale    then do: run di in this-procedure ("док." , 18, "","", "", "", "b1":u).  end.
     3579           if vat-cost    then do: run di in this-procedure ( "уч.НДС", 13,"","","","","b1":u ). end.
     3580           if vat-crsa    then do: run di in this-procedure ( "пр.НДС", 16,"","","","","b1":u ).  end.
     3581           if vat-sale    then do: run di in this-procedure ( "дк.НДС", 19,"","","","","b1":u ).  end.
