     4454    if  p2 > 10  then f_e = 10 .
     4455                 else f_e =  0 .
     4456   if Make-Excel then  put   stream ForExcel unformatted
     4457     p3 CHR(9)
     4458     p4 CHR(9)
     4459     if f_e = 0 then g1 else p5 CHR(9)
     4460     p6 CHR(9)
     4461     gds-zap-type CHR(9)
     4462     excel-sum(gds-zap-other   )  CHR(9)
     4463     excel-qnty(ostatok-start[1  + f_e ])  CHR(9)
     4464     excel-sum(ostatok-start[2  + f_e ])  CHR(9)
     4465     excel-sum(ostatok-start[5  + f_e ])  CHR(9)
     4466     excel-sum(ostatok-start[8  + f_e ])  CHR(9)
     4467     .
     4468     if Make-Excel then  put   stream ForExcel unformatted
     4469     excel-sum(ostatok-start[3  + f_e ])  CHR(9)
     4470     excel-sum(ostatok-start[6  + f_e ])  CHR(9)
     4471     excel-sum(ostatok-start[9  + f_e ])  CHR(9)
     4472     excel-qnty(Prih        [1  + f_e ])  CHR(9)
     4473     excel-sum(Prih         [2  + f_e ])  CHR(9)
     4474     excel-sum(Prih         [5  + f_e ])  CHR(9)
     4475     excel-sum(Prih         [8  + f_e ])  CHR(9)
     4476     excel-sum(Prih         [3  + f_e ])  CHR(9)
     4477     excel-sum(Prih         [6  + f_e ])  CHR(9)
     4478     excel-sum(Prih         [9  + f_e ])  CHR(9)
     4479     .
     4480     if Make-Excel then  put   stream ForExcel unformatted
     4481     excel-qnty(RAsh        [1  + f_e ])  CHR(9)
     4482     excel-sum(RAsh         [2  + f_e ])  CHR(9)
     4483     excel-sum(RAsh         [5  + f_e ])  CHR(9)
     4484     excel-sum(RAsh         [8  + f_e ])  CHR(9)
     4485     excel-sum(RAsh         [3  + f_e ])  CHR(9)
     4486     excel-sum(RAsh         [6  + f_e ])  CHR(9)
     4487     excel-sum(RAsh         [9  + f_e ])  CHR(9)
     4488     excel-qnty(KAssa       [1  + f_e ])  CHR(9)
     4489     excel-sum(KAssa        [2  + f_e ])  CHR(9)
     4490     excel-sum(KAssa        [5  + f_e ])  CHR(9)
     4491     excel-sum(KAssa        [8  + f_e ])  CHR(9)
     4492     excel-sum(KAssa        [3  + f_e ])  CHR(9)
     4493     excel-sum(KAssa        [6  + f_e ])  CHR(9)
     4494     .
     4495     if Make-Excel then  put   stream ForExcel unformatted
     4496     excel-sum(KAssa        [9  + f_e ])  CHR(9)
     4497     excel-qnty(Inv         [1  + f_e ])  CHR(9)
     4498     excel-sum(Inv          [2  + f_e ])  CHR(9)
     4499     excel-sum(Inv          [5  + f_e ])  CHR(9)
     4500     excel-sum(Inv          [8  + f_e ])  CHR(9)
     4501     excel-sum(Inv          [3  + f_e ])  CHR(9)
     4502     excel-sum(Inv          [6  + f_e ])  CHR(9)
     4503     excel-sum(Inv          [9  + f_e ])  CHR(9)
     4504     .
     4505     if Make-Excel then  put   stream ForExcel unformatted
     4506     excel-qnty(Overturn    [1  + f_e ])  CHR(9)
     4507     excel-sum(Overturn     [2  + f_e ])  CHR(9)
     4508     excel-sum(Overturn     [5  + f_e ])  CHR(9)
     4509     excel-sum(Overturn     [8  + f_e ])  CHR(9)
     4510     excel-sum(Overturn     [3  + f_e ])  CHR(9)
     4511     excel-sum(Overturn     [6  + f_e ])  CHR(9)
     4512     excel-sum(Overturn     [9  + f_e ])  CHR(9)
     4513     excel-qnty(Ostatok-end [1  + f_e ])  CHR(9)
     4514     excel-sum(Ostatok-end  [2  + f_e ])  CHR(9)
     4515     excel-sum(Ostatok-end  [5  + f_e ])  CHR(9)
     4516     excel-sum(Ostatok-end  [8  + f_e ])  CHR(9)
     4517     excel-sum(Ostatok-end  [3  + f_e ])  CHR(9)
     4518     excel-sum(Ostatok-end  [6  + f_e ])  CHR(9)
     4519     excel-sum(Ostatok-end  [9  + f_e ])  CHR(9)
     4520     g2
     4521     skip.
     4522                 end.
     4523      end case.
     4524                  DOWN stream   OutStream 1 with FRAME ZAPAS.
     4525    end procedure.
     4526   procedure ost-line-body :
     4527   do on error undo, return error return-value :
     4528   define input parameter p-num        as   integer   no-undo .
     4529   define input parameter p-store-type like ub.clients.obj-type no-undo .
     4530   define input parameter p-store-code like ub.clients.obj-code no-undo .
     4531    find last  ub.aht-stk-line where
     4532                           ub.aht-stk-line.gds-code   = gds-zap-b-code
     4533                     and   ub.aht-stk-line.fact-order <= fact-order-1
     4534                     and   ub.aht-stk-line.obj-code   = p-store-code
     4535                     and   ub.aht-stk-line.obj-type   = p-store-type
     4536                     and   ub.aht-stk-line.sum-type   = x-type-pr
     4537                           use-index category no-lock no-error.
     4538           if available ub.aht-stk-line then do:
     4539               if  tprintrubl  then
     4540                     assign
     4541                           ostatok-start[1 + p-num]  = ostatok-start[1 + p-num] +  (if ub.aht-stk-line.sum-type <> "b"
     4542                                                                   then round( ub.aht-stk-line.fact-qnty,3) else 0 )
     4543                           ostatok-start[2 + p-num]  =ostatok-start[2 + p-num] +  round( ub.aht-stk-line.cost-sum-rubl ,2)
     4544                           ostatok-start[3 + p-num]  =ostatok-start[3 + p-num] +  round( ub.aht-stk-line.cost-vat-rubl ,2)
     4545                           ostatok-start[4 + p-num]  =ostatok-start[4 + p-num] +  0
     4546                           ostatok-start[5 + p-num]  =ostatok-start[5 + p-num]  + round( ub.aht-stk-line.crsa-sum-rubl ,2)
     4547                           ostatok-start[6 + p-num]  =ostatok-start[6 + p-num]  + round( ub.aht-stk-line.crsa-vat-rubl ,2)
     4548                           ostatok-start[7 + p-num]  =ostatok-start[7 + p-num]  + round( ub.aht-stk-line.sale-discnt-rubl ,2)
     4549                           ostatok-start[8 + p-num]  =ostatok-start[8 + p-num]  + round( ub.aht-stk-line.crsa-sum-rubl ,2)
     4550                           ostatok-start[9 + p-num]  =ostatok-start[9 + p-num]  + round( ub.aht-stk-line.crsa-vat-rubl ,2)
     4551                           ostatok-start[10 + p-num] =ostatok-start[10 + p-num] + round( ub.aht-stk-line.crsa-slt-rubl ,2)
     4552                           .
     4553                 else
     4554                     assign
     4555                           ostatok-start[1 + p-num]  = ostatok-start[1 + p-num] + (if ub.aht-stk-line.sum-type <> "b"
     4556                                                                      then round( ub.aht-stk-line.fact-qnty,3) else 0 )
     4557                           ostatok-start[2 + p-num]  = ostatok-start[2 + p-num] +  round( ub.aht-stk-line.cost-sum-base ,2)
     4558                           ostatok-start[3 + p-num]  = ostatok-start[3 + p-num] +  round( ub.aht-stk-line.cost-vat-base ,2)
     4559                           ostatok-start[4 + p-num]  = ostatok-start[4 + p-num] +  0
     4560                           ostatok-start[5 + p-num]  = ostatok-start[5 + p-num]  + round( ub.aht-stk-line.crsa-sum-base ,2)
     4561                           ostatok-start[6 + p-num]  = ostatok-start[6 + p-num]  + round( ub.aht-stk-line.crsa-vat-base ,2)
     4562                           ostatok-start[7 + p-num]  = ostatok-start[7 + p-num]  + round( ub.aht-stk-line.sale-discnt-base ,2)
     4563                           ostatok-start[8 + p-num]  = ostatok-start[8 + p-num]  + round( ub.aht-stk-line.crsa-sum-base ,2)
     4564                           ostatok-start[9 + p-num]  = ostatok-start[9 + p-num]  + round( ub.aht-stk-line.crsa-vat-base ,2)
     4565                           ostatok-start[10 + p-num] = ostatok-start[10 + p-num] + round( ub.aht-stk-line.crsa-slt-base ,2)
     4566                     .
     4567                end.
     4568    find last  ub.aht-stk-line where
     4569                           ub.aht-stk-line.gds-code   = gds-zap-b-code
     4570                     and   ub.aht-stk-line.fact-order <= fact-order-2
     4571                     and   ub.aht-stk-line.obj-code   = p-store-code
     4572                     and   ub.aht-stk-line.obj-type   = p-store-type
     4573                     and   ub.aht-stk-line.sum-type   = x-type-pr
     4574                           use-index category no-lock no-error.
     4575           if available ub.aht-stk-line then do:
     4576               if  tprintrubl  then
     4577                     assign
     4578                           ostatok-end[1 + p-num]  = ostatok-end[1 + p-num] + (if ub.aht-stk-line.sum-type <> "b"
     4579                                                                  then round( ub.aht-stk-line.fact-qnty,3) else 0 )
     4580                           ostatok-end[2 + p-num]  = ostatok-end[2 + p-num] + round( ub.aht-stk-line.cost-sum-rubl ,2)
     4581                           ostatok-end[3 + p-num]  = ostatok-end[3 + p-num] + round( ub.aht-stk-line.cost-vat-rubl ,2)
     4582                           ostatok-end[4 + p-num]  = ostatok-end[4 + p-num] + 0
     4583                           ostatok-end[5 + p-num]  = ostatok-end[5 + p-num] + round( ub.aht-stk-line.crsa-sum-rubl ,2)
     4584                           ostatok-end[6 + p-num]  = ostatok-end[6 + p-num] + round( ub.aht-stk-line.crsa-vat-rubl ,2)
     4585                           ostatok-end[7 + p-num]  = ostatok-end[7 + p-num] + round( ub.aht-stk-line.sale-discnt-rubl ,2)
     4586                           ostatok-end[8 + p-num]  = ostatok-end[8 + p-num] + round( ub.aht-stk-line.crsa-sum-rubl ,2)
     4587                           ostatok-end[9 + p-num]  = ostatok-end[9 + p-num] + round( ub.aht-stk-line.crsa-vat-rubl ,2)
     4588                           ostatok-end[10 + p-num] = ostatok-end[10 + p-num] + round( ub.aht-stk-line.crsa-slt-rubl ,2)
     4589                           .
     4590                 else
     4591                     assign
     4592                           ostatok-end[1 + p-num]  = ostatok-end[1 + p-num] +  (if ub.aht-stk-line.sum-type <> "b"
     4593                                                                   then round( ub.aht-stk-line.fact-qnty,3) else 0 )
     4594                           ostatok-end[2 + p-num]  = ostatok-end[2 + p-num] +  round( ub.aht-stk-line.cost-sum-base ,2)
     4595                           ostatok-end[3 + p-num]  = ostatok-end[3 + p-num] +  round( ub.aht-stk-line.cost-vat-base ,2)
     4596                           ostatok-end[4 + p-num]  = ostatok-end[4 + p-num] +  0
     4597                           ostatok-end[5 + p-num]  = ostatok-end[5 + p-num] +  round( ub.aht-stk-line.crsa-sum-base ,2)
     4598                           ostatok-end[6 + p-num]  = ostatok-end[6 + p-num] +  round( ub.aht-stk-line.crsa-vat-base ,2)
     4599                           ostatok-end[7 + p-num]  = ostatok-end[7 + p-num] +  round( ub.aht-stk-line.sale-discnt-base ,2)
     4600                           ostatok-end[8 + p-num]  = ostatok-end[8 + p-num] +  round( ub.aht-stk-line.crsa-sum-base ,2)
     4601                           ostatok-end[9 + p-num]  = ostatok-end[9 + p-num] +  round( ub.aht-stk-line.crsa-vat-base ,2)
     4602                           ostatok-end[10 + p-num] = ostatok-end[10 + p-num] + round( ub.aht-stk-line.crsa-slt-base ,2)
     4603                     .
     4604                end.
     4605   end.
     4606   end procedure.
     4607   procedure ob-line  :
     4608   do on error undo, return error return-value :
     4609   def input  parameter x-store-code     like ub.clients.obj-code         no-undo .
     4610   def input  parameter x-store-type     like ub.clients.obj-type         no-undo .
     4611   def input  parameter x-gds-code       like ub.aht-ot-line.gds-code     no-undo .
     4612   def input  parameter x-fact-order-1   like ub.aht-ot-line.fact-order   no-undo .
     4613   def input  parameter x-fact-order-2   like ub.aht-ot-line.fact-order   no-undo .
     4614   def input  parameter x-sum-type       like ub.aht-ot-line.sum-type     no-undo .
     4615   def input  parameter xtog-obj         as logical no-undo .
     4616   define variable      tt#              as integer no-undo .
     4617   define variable x-type-pr1 as character no-undo .
     4618   define variable x-type-pr2 as character no-undo .
     4619   define variable p-ok as logical   no-undo .
     4620    if x-sum-type = arh-type-cost then tt# = 0 .
     4621    if x-sum-type = arh-type-crsa then tt# = 3 .
     4622    if x-sum-type = arh-type-sale then tt# = 6 .
     4623   if  x-sum-type = "cb" then
     4624    assign
     4625       x-type-pr1 = "c"
     4626       x-type-pr2 = "b"
     4627    .
     4628   else
     4629    assign
     4630       x-type-pr1 = x-sum-type
     4631       x-type-pr2 = x-sum-type
     4632    .
     4633     for each obj-list  no-lock :
     4634        for each ub.aht-ot-line where
     4635                         ( ub.aht-ot-line.gds-code      = x-gds-code
     4636                     and   ub.aht-ot-line.fact-order   <= x-fact-order-2
     4637                     and   ub.aht-ot-line.fact-order   >= x-fact-order-1
     4638                     and   ub.aht-ot-line.obj-code     = obj-list.obj-code
     4639                     and   ub.aht-ot-line.obj-type     = obj-list.obj-type
     4640                     and   ub.aht-ot-line.sum-type     = x-type-pr1 )
     4641                     OR  ( ub.aht-ot-line.gds-code      = x-gds-code
     4642                     and   ub.aht-ot-line.fact-order   <= x-fact-order-2
     4643                     and   ub.aht-ot-line.fact-order   >= x-fact-order-1
     4644                     and   ub.aht-ot-line.obj-code     = obj-list.obj-code
     4645                     and   ub.aht-ot-line.obj-type     = obj-list.obj-type
     4646                     and   ub.aht-ot-line.sum-type     = x-type-pr2 )
     4647                     no-lock :
     4648       if  p-tpsy = true then do:
     4649           run ver-owner2
     4650           ( input  ub.aht-ot-line.gds-code,
     4651             input  ub.aht-ot-line.obj-type,
     4652             input  ub.aht-ot-line.obj-code,
     4653             output p-ok ) .
     4654       end.
     4655       case ub.aht-ot-line.ext-doc-type:
     4656                 when        'ie':U  or
     4657                 when        're':U  or
     4658                 when        'iv':U    or
     4659                 when        'rv':U or
     4660                 when        'im':U     then
     4661                 do:
     4662                 assign
     4663                        prih[1 ]   = prih[1 ]   + (if ub.aht-ot-line.sum-type <> "b" then round( ub.aht-ot-line.fact-qnty,3) else 0 )
     4664                        prih[2 ]   = prih[2 ]   +  if tprintrubl then ub.aht-ot-line.cost-sum-rubl else  ub.aht-ot-line.cost-sum-base
     4665                        prih[3 ]   = prih[3 ]   +  if tprintrubl then ub.aht-ot-line.cost-vat-rubl else  ub.aht-ot-line.cost-vat-base
     4666                        prih[4 ]   = prih[4 ]
     4667                        prih[5 ]   = prih[5 ]   +  if tprintrubl then ub.aht-ot-line.crsa-sum-rubl else  ub.aht-ot-line.crsa-sum-base
     4668                        prih[6 ]   = prih[6 ]   +  if tprintrubl then ub.aht-ot-line.crsa-vat-rubl else  ub.aht-ot-line.crsa-vat-base
     4669                        prih[7 ]   = prih[7 ]   +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     4670                        prih[8 ]   = prih[8 ]   +  if tprintrubl then ub.aht-ot-line.sale-sum-rubl else  ub.aht-ot-line.sale-sum-base
     4671                        prih[9 ]   = prih[9 ]   +  if tprintrubl then ub.aht-ot-line.sale-vat-rubl else  ub.aht-ot-line.sale-vat-base
     4672                        gds-zap-other   = gds-zap-other  +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     4673                  .
     4674        if p-ok = true then do:
     4675           assign
     4676             prih[11 ]   = prih[11 ]   + (if ub.aht-ot-line.sum-type <> "b" then round( ub.aht-ot-line.fact-qnty,3) else 0 )
     4677             prih[12 ]   = prih[12 ]   +  if tprintrubl then ub.aht-ot-line.cost-sum-rubl else  ub.aht-ot-line.cost-sum-base
     4678             prih[13 ]   = prih[13 ]   +  if tprintrubl then ub.aht-ot-line.cost-vat-rubl else  ub.aht-ot-line.cost-vat-base
     4679             prih[14 ]   = prih[14 ]
     4680             prih[15 ]   = prih[15 ]   +  if tprintrubl then ub.aht-ot-line.crsa-sum-rubl else  ub.aht-ot-line.crsa-sum-base
     4681             prih[16 ]   = prih[16 ]   +  if tprintrubl then ub.aht-ot-line.crsa-vat-rubl else  ub.aht-ot-line.crsa-vat-base
     4682             prih[17 ]   = prih[17 ]   +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     4683             prih[18 ]   = prih[18 ]   +  if tprintrubl then ub.aht-ot-line.sale-sum-rubl else  ub.aht-ot-line.sale-sum-base
     4684             prih[19 ]   = prih[19 ]   +  if tprintrubl then ub.aht-ot-line.sale-vat-rubl else  ub.aht-ot-line.sale-vat-base
     4685             .
     4686        end.
     4687                 end.
     4688                 when       'ee':U      or
     4689                 when       'ep':U    or
     4690                 when       'ev':U     or
     4691                 when       'em':U       or
     4692                 when       'wm':U       or
     4693                 when       'we':U     then
     4694                 do:
     4695                   assign
     4696                       rash[1  ]   = rash[1 ]   +  (if ub.aht-ot-line.sum-type <> "b" then round( ub.aht-ot-line.fact-qnty,3) else 0 )
     4697                       rash[2  ]   = rash[2 ]   +  if tprintrubl then ub.aht-ot-line.cost-sum-rubl else  ub.aht-ot-line.cost-sum-base
     4698                       rash[3 ]   = rash[3 ]   +  if tprintrubl then ub.aht-ot-line.cost-vat-rubl else  ub.aht-ot-line.cost-vat-base
     4699                       rash[4 ]   = rash[4 ]
     4700                       rash[5 ]   = rash[5 ]   +  if tprintrubl then ub.aht-ot-line.crsa-sum-rubl else  ub.aht-ot-line.crsa-sum-base
     4701                       rash[6 ]   = rash[6 ]   +  if tprintrubl then ub.aht-ot-line.crsa-vat-rubl else  ub.aht-ot-line.crsa-vat-base
     4702                       rash[7 ]   = rash[7 ]   +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     4703                       rash[8 ]   = rash[8 ]   +  if tprintrubl then ub.aht-ot-line.sale-sum-rubl else  ub.aht-ot-line.sale-sum-base
     4704                       rash[9 ]   = rash[9 ]   +  if tprintrubl then ub.aht-ot-line.sale-vat-rubl else  ub.aht-ot-line.sale-vat-base
     4705                       gds-zap-other   = gds-zap-other  +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     4706                 .
     4707                   if p-ok = true then do:
     4708                     assign
     4709                       rash[11  ]   = rash[11 ]   +  (if ub.aht-ot-line.sum-type <> "b" then round( ub.aht-ot-line.fact-qnty,3) else 0 )
     4710                       rash[12  ]   = rash[12 ]   +  if tprintrubl then ub.aht-ot-line.cost-sum-rubl else  ub.aht-ot-line.cost-sum-base
     4711                       rash[13 ]   = rash[13 ]   +  if tprintrubl then ub.aht-ot-line.cost-vat-rubl else  ub.aht-ot-line.cost-vat-base
     4712                       rash[14 ]   = rash[14 ]
     4713                       rash[15 ]   = rash[15 ]   +  if tprintrubl then ub.aht-ot-line.crsa-sum-rubl else  ub.aht-ot-line.crsa-sum-base
     4714                       rash[16 ]   = rash[16 ]   +  if tprintrubl then ub.aht-ot-line.crsa-vat-rubl else  ub.aht-ot-line.crsa-vat-base
     4715                       rash[17 ]   = rash[17 ]   +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     4716                       rash[18 ]   = rash[18 ]   +  if tprintrubl then ub.aht-ot-line.sale-sum-rubl else  ub.aht-ot-line.sale-sum-base
     4717                       rash[19 ]   = rash[19 ]   +  if tprintrubl then ub.aht-ot-line.sale-vat-rubl else  ub.aht-ot-line.sale-vat-base
     4718                     .
     4719                   end.
     4720                 end.
     4721                 when       'es':U  or
     4722                 when       'rs':U then
     4723                 do:
     4724                     assign
     4725                       kassa[1  ]   = kassa[1 ]   +  (if ub.aht-ot-line.sum-type <> "b" then round( ub.aht-ot-line.fact-qnty,3) else 0 )
     4726                       kassa[2  ]   = kassa[2 ]   +  if tprintrubl then ub.aht-ot-line.cost-sum-rubl else  ub.aht-ot-line.cost-sum-base
     4727                       kassa[3  ]   = kassa[3 ]   +  if tprintrubl then ub.aht-ot-line.cost-vat-rubl else  ub.aht-ot-line.cost-vat-base
     4728                       kassa[4  ]   = kassa[4 ]
     4729                       kassa[5  ]   = kassa[5 ]   +  if tprintrubl then ub.aht-ot-line.crsa-sum-rubl else  ub.aht-ot-line.crsa-sum-base
     4730                       kassa[6  ]   = kassa[6 ]   +  if tprintrubl then ub.aht-ot-line.crsa-vat-rubl else  ub.aht-ot-line.crsa-vat-base
     4731                       kassa[7  ]   = kassa[7 ]   +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     4732                       kassa[8  ]   = kassa[8 ]   +  if tprintrubl then ub.aht-ot-line.sale-sum-rubl else  ub.aht-ot-line.sale-sum-base
     4733                       kassa[9  ]   = kassa[9 ]   +  if tprintrubl then ub.aht-ot-line.sale-vat-rubl else  ub.aht-ot-line.sale-vat-base
     4734                       gds-zap-other   = gds-zap-other  +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     4735                       .
     4736                     if p-ok = true then
     4737                     assign
     4738                       kassa[11  ]   = kassa[11 ]   +  (if ub.aht-ot-line.sum-type <> "b" then round( ub.aht-ot-line.fact-qnty,3) else 0 )
     4739                       kassa[12  ]   = kassa[12 ]   +  if tprintrubl then ub.aht-ot-line.cost-sum-rubl else  ub.aht-ot-line.cost-sum-base
     4740                       kassa[13  ]   = kassa[13 ]   +  if tprintrubl then ub.aht-ot-line.cost-vat-rubl else  ub.aht-ot-line.cost-vat-base
     4741                       kassa[14  ]   = kassa[14 ]
     4742                       kassa[15  ]   = kassa[15 ]   +  if tprintrubl then ub.aht-ot-line.crsa-sum-rubl else  ub.aht-ot-line.crsa-sum-base
     4743                       kassa[16  ]   = kassa[16 ]   +  if tprintrubl then ub.aht-ot-line.crsa-vat-rubl else  ub.aht-ot-line.crsa-vat-base
     4744                       kassa[17  ]   = kassa[17 ]   +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     4745                       kassa[18  ]   = kassa[18 ]   +  if tprintrubl then ub.aht-ot-line.sale-sum-rubl else  ub.aht-ot-line.sale-sum-base
     4746                       kassa[19  ]   = kassa[19 ]   +  if tprintrubl then ub.aht-ot-line.sale-vat-rubl else  ub.aht-ot-line.sale-vat-base
     4747                       .
     4748                 end.
     4749             when       'vt':U            or
     4750             when       'pc':U or
     4751             when       'vp':U       then do:
     4752                 assign
     4753                   inv[1  ]   = inv[1 ]   +  (if ub.aht-ot-line.sum-type <> "b" then round( ub.aht-ot-line.fact-qnty,3) else 0 )
     4754                   inv[2  ]   = inv[2 ]   +  if tprintrubl then ub.aht-ot-line.cost-sum-rubl else  ub.aht-ot-line.cost-sum-base
     4755                   inv[3  ]   = inv[3 ]   +  if tprintrubl then ub.aht-ot-line.cost-vat-rubl else  ub.aht-ot-line.cost-vat-base
     4756                   inv[4  ]   = inv[4 ]
     4757                   inv[5  ]   = inv[5 ]   +  if tprintrubl then ub.aht-ot-line.crsa-sum-rubl else  ub.aht-ot-line.crsa-sum-base
     4758                   inv[6  ]   = inv[6 ]   +  if tprintrubl then ub.aht-ot-line.crsa-vat-rubl else  ub.aht-ot-line.crsa-vat-base
     4759                   inv[7  ]   = inv[7 ]   +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     4760                   inv[8  ]   = inv[8 ]   +  if tprintrubl then ub.aht-ot-line.sale-sum-rubl else  ub.aht-ot-line.sale-sum-base
     4761                   inv[9  ]   = inv[9 ]   +  if tprintrubl then ub.aht-ot-line.sale-vat-rubl else  ub.aht-ot-line.sale-vat-base
     4762                   gds-zap-other   = gds-zap-other  +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     4763                   .
     4764                 if p-ok = true then
     4765                 assign
     4766                   inv[11  ]   = inv[11 ]   +  (if ub.aht-ot-line.sum-type <> "b" then round( ub.aht-ot-line.fact-qnty,3) else 0 )
     4767                   inv[12  ]   = inv[12 ]   +  if tprintrubl then ub.aht-ot-line.cost-sum-rubl else  ub.aht-ot-line.cost-sum-base
     4768                   inv[13  ]   = inv[13 ]   +  if tprintrubl then ub.aht-ot-line.cost-vat-rubl else  ub.aht-ot-line.cost-vat-base
     4769                   inv[14  ]   = inv[14 ]
     4770                   inv[15  ]   = inv[15 ]   +  if tprintrubl then ub.aht-ot-line.crsa-sum-rubl else  ub.aht-ot-line.crsa-sum-base
     4771                   inv[16  ]   = inv[16 ]   +  if tprintrubl then ub.aht-ot-line.crsa-vat-rubl else  ub.aht-ot-line.crsa-vat-base
     4772                   inv[17  ]   = inv[17 ]   +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     4773                   inv[18  ]   = inv[18 ]   +  if tprintrubl then ub.aht-ot-line.sale-sum-rubl else  ub.aht-ot-line.sale-sum-base
     4774                   inv[19  ]   = inv[19 ]   +  if tprintrubl then ub.aht-ot-line.sale-vat-rubl else  ub.aht-ot-line.sale-vat-base
     4775                   .
     4776                 end.
     4777             when       'ot':U or
     4778             when       'ap':U then
     4779                 do:
     4780                    assign
     4781                       overturn[1  ]   = overturn[1 ]   +  (if ub.aht-ot-line.sum-type <> "b" then round( ub.aht-ot-line.fact-qnty,3) else 0 )
     4782                       overturn[2  ]   = overturn[2 ]   +  if tprintrubl then ub.aht-ot-line.cost-sum-rubl else  ub.aht-ot-line.cost-sum-base
     4783                       overturn[3  ]   = overturn[3 ]   +  if tprintrubl then ub.aht-ot-line.cost-vat-rubl else  ub.aht-ot-line.cost-vat-base
     4784                       overturn[4  ]   = overturn[4 ]
     4785                       overturn[5  ]   = overturn[5 ]   +  if tprintrubl then ub.aht-ot-line.crsa-sum-rubl else  ub.aht-ot-line.crsa-sum-base
     4786                       overturn[6  ]   = overturn[6 ]   +  if tprintrubl then ub.aht-ot-line.crsa-vat-rubl else  ub.aht-ot-line.crsa-vat-base
     4787                       overturn[7  ]   = overturn[7 ]   +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     4788                       overturn[8  ]   = overturn[8 ]   +  if tprintrubl then ub.aht-ot-line.sale-sum-rubl else  ub.aht-ot-line.sale-sum-base
     4789                       overturn[9  ]   = overturn[9 ]   +  if tprintrubl then ub.aht-ot-line.sale-vat-rubl else  ub.aht-ot-line.sale-vat-base
     4790                       gds-zap-other   = gds-zap-other  +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     4791                       .
     4792                    if p-ok = true then
     4793                    assign
     4794                       overturn[11  ]   = overturn[11 ]   +  (if ub.aht-ot-line.sum-type <> "b" then round( ub.aht-ot-line.fact-qnty,3) else 0 )
     4795                       overturn[12  ]   = overturn[12 ]   +  if tprintrubl then ub.aht-ot-line.cost-sum-rubl else  ub.aht-ot-line.cost-sum-base
     4796                       overturn[13  ]   = overturn[13 ]   +  if tprintrubl then ub.aht-ot-line.cost-vat-rubl else  ub.aht-ot-line.cost-vat-base
     4797                       overturn[14  ]   = overturn[14 ]
     4798                       overturn[15  ]   = overturn[15 ]   +  if tprintrubl then ub.aht-ot-line.crsa-sum-rubl else  ub.aht-ot-line.crsa-sum-base
     4799                       overturn[16  ]   = overturn[16 ]   +  if tprintrubl then ub.aht-ot-line.crsa-vat-rubl else  ub.aht-ot-line.crsa-vat-base
     4800                       overturn[17  ]   = overturn[17 ]   +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     4801                       overturn[18  ]   = overturn[18 ]   +  if tprintrubl then ub.aht-ot-line.sale-sum-rubl else  ub.aht-ot-line.sale-sum-base
     4802                       overturn[19  ]   = overturn[19 ]   +  if tprintrubl then ub.aht-ot-line.sale-vat-rubl else  ub.aht-ot-line.sale-vat-base
     4803                       .
     4804                 end.
     4805         end case.
     4806      end.
     4807     end.
     4808     assign
     4809       tt# = 6
     4810       overturn[1 + tt# ]   = (ostatok-end[1 + tt# ]  - ostatok-start[1 + tt# ] )  -  (inv[1 + tt# ] + prih[1 + tt# ] + kassa[1 + tt# ] + rash[1 + tt# ]  )
     4811       overturn[2 + tt# ]   = (ostatok-end[2 + tt# ]  - ostatok-start[2 + tt# ] )  -  (inv[2 + tt# ] + prih[2 + tt# ] + kassa[2 + tt# ] + rash[2 + tt# ]  )
     4812       overturn[3 + tt# ]   = (ostatok-end[3 + tt# ]  - ostatok-start[3 + tt# ] )  -  (inv[3 + tt# ] + prih[3 + tt# ] + kassa[3 + tt# ] + rash[3 + tt# ]  )
     4813     .
     4814     if p-ok = true then
     4815     assign
     4816       tt# = 6
     4817       overturn[1 + tt# ]   = (ostatok-end[1 + tt# ]  - ostatok-start[1 + tt# ] )  -  (inv[1 + tt# ] + prih[1 + tt# ] + kassa[1 + tt# ] + rash[1 + tt# ]  )
     4818       overturn[2 + tt# ]   = (ostatok-end[2 + tt# ]  - ostatok-start[2 + tt# ] )  -  (inv[2 + tt# ] + prih[2 + tt# ] + kassa[2 + tt# ] + rash[2 + tt# ]  )
     4819       overturn[3 + tt# ]   = (ostatok-end[3 + tt# ]  - ostatok-start[3 + tt# ] )  -  (inv[3 + tt# ] + prih[3 + tt# ] + kassa[3 + tt# ] + rash[3 + tt# ]  )
     4820     .
     4821   end.
     4822   end procedure.
     4823   procedure ver-owner :
     4824     do
     4825     on error undo, return error return-value
     4826     :
     4827   define input  parameter p-gds-code like ub.goods.gds-code no-undo .
     4828   define input  parameter p-db-num as integer   no-undo .
     4829   define output parameter p-ok as logical   no-undo .
     4830   define variable  p-proprietor-host-code like ub.clients.host-code no-undo .
     4831   define variable  p-proprietor-obj-type  like ub.clients.obj-type no-undo .
     4832   define variable  p-proprietor-obj-code  like ub.clients.obj-code no-undo .
     4833   p-ok = false .
     4834   if  p-tpsy = false  then return.
     4835     run tpsi-gds-proprietor (
     4836         input  p-gds-code             ,
     4837         input  p-db-num               ,
     4838         output p-proprietor-host-code ,
     4839         output p-proprietor-obj-type  ,
     4840         output p-proprietor-obj-code )  .
     4841    if p-proprietor-host-code = v-cntxt-host-code-obj then p-ok = true  .
     4842   end.
     4843   end procedure.
     4844   procedure ver-owner2 :
     4845     do
     4846     on error undo, return error return-value
     4847     :
     4848   define input  parameter p-gds-code like ub.goods.gds-code no-undo .
     4849   define input  parameter p-obj-type  like ub.clients.obj-type no-undo .
     4850   define input  parameter p-obj-code  like ub.clients.obj-code no-undo .
     4851   define output parameter p-ok as logical   no-undo .
     4852   define variable  p-proprietor-host-code like ub.clients.host-code no-undo .
     4853   define variable  p-proprietor-obj-type  like ub.clients.obj-type no-undo .
     4854   define variable  p-proprietor-obj-code  like ub.clients.obj-code no-undo .
     4855   p-ok = false .
     4856   if  p-tpsy = false  then return.
     4857   define buffer buf_obj-list for obj-list.
     4858   find first buf_obj-list where
     4859         buf_obj-list.obj-type = p-obj-type and
     4860         buf_obj-list.obj-code = p-obj-code
     4861         no-error .
     4862   if error-status :error then return .
     4863     run tpsi-gds-proprietor (
     4864         input  p-gds-code             ,
     4865         input  buf_obj-list.db-num     ,
     4866         output p-proprietor-host-code ,
     4867         output p-proprietor-obj-type  ,
     4868         output p-proprietor-obj-code )  .
     4869    if p-proprietor-host-code = v-cntxt-host-code-obj then p-ok = true  .
     4870   end.
     4871   end procedure.
