     3975   procedure di :
     3976   def input parameter p1 as char no-undo.
     3977   def input parameter p2 as int no-undo.
     3978   def input parameter p3 as char no-undo.
     3979   def input parameter p4 as char no-undo.
     3980   def input parameter p5 as char no-undo.
     3981   def input parameter p6 as char no-undo.
     3982   def input parameter p7 as char no-undo.
     3983    case caps(p7) :
     3984      when "b1":u  then do:
     3985       DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     3986         p3 @ s-bar-code
     3987         p4 @ gds-zap-artic
     3988         p5 @ gds-zap-gds-name
     3989         p6 @ gds-zap-unit-base
     3990         p1 @ gds-type
     3991         b1-ostatok-start [p2] format "->>>>>>>>>>9.<<" @  F-ostatok-start
     3992         b1-Prih          [p2] format "->>>>>>>>>>9.<<" @  F-Prih
     3993         b1-RAsh          [p2] format "->>>>>>>>>>9.<<" @  F-RAsh
     3994         b1-KAssa         [p2] format "->>>>>>>>>>9.<<" @  F-KAssa
     3995         b1-Inv           [p2] format "->>>>>>>>>>9.<<" @  F-Inv
     3996         b1-Overturn      [p2] format "->>>>>>>>>>9.<<" @  F-Overturn
     3997         b1-Ostatok-end   [p2] format "->>>>>>>>>>9.<<" @  F-Ostatok-end
     3998         b1-gds-zap-other      format "->>>>>>>>>>9.<<" when (p2 = 1) @  gds-zap-other
     3999         with FRAME ZAPAS .
     4000                  DOWN stream   OutStream 1 with FRAME ZAPAS.
     4001                   end.
     4002      when "b2":u  then  do:
     4003       DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     4004         p3 @ s-bar-code
     4005         p4 @ gds-zap-artic
     4006         p5 @ gds-zap-gds-name
     4007         p6 @ gds-zap-unit-base
     4008         p1 @ gds-type
     4009         b2-ostatok-start [p2] format "->>>>>>>>>>9.<<" @  F-ostatok-start
     4010         b2-Prih          [p2] format "->>>>>>>>>>9.<<" @  F-Prih
     4011         b2-RAsh          [p2] format "->>>>>>>>>>9.<<" @  F-RAsh
     4012         b2-KAssa         [p2] format "->>>>>>>>>>9.<<" @  F-KAssa
     4013         b2-Inv           [p2] format "->>>>>>>>>>9.<<" @  F-Inv
     4014         b2-Overturn      [p2] format "->>>>>>>>>>9.<<" @  F-Overturn
     4015         b2-Ostatok-end   [p2] format "->>>>>>>>>>9.<<" @  F-Ostatok-end
     4016         b2-gds-zap-other      format "->>>>>>>>>>9.<<" when (p2 = 1) @  gds-zap-other
     4017         with FRAME ZAPAS .
     4018                  DOWN stream   OutStream 1 with FRAME ZAPAS.
     4019                 end.
     4020      when "bi":u then  do:
     4021       DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     4022         p3 @ s-bar-code
     4023         p4 @ gds-zap-artic
     4024         p5 @ gds-zap-gds-name
     4025         p6 @ gds-zap-unit-base
     4026         p1 @ gds-type
     4027         bi-ostatok-start [p2] format "->>>>>>>>>>9.<<" @  F-ostatok-start
     4028         bi-Prih          [p2] format "->>>>>>>>>>9.<<" @  F-Prih
     4029         bi-RAsh          [p2] format "->>>>>>>>>>9.<<" @  F-RAsh
     4030         bi-KAssa         [p2] format "->>>>>>>>>>9.<<" @  F-KAssa
     4031         bi-Inv           [p2] format "->>>>>>>>>>9.<<" @  F-Inv
     4032         bi-Overturn      [p2] format "->>>>>>>>>>9.<<" @  F-Overturn
     4033         bi-Ostatok-end   [p2] format "->>>>>>>>>>9.<<" @  F-Ostatok-end
     4034         bi-gds-zap-other      format "->>>>>>>>>>9.<<" when (p2 = 1) @  gds-zap-other
     4035         with FRAME ZAPAS .
     4036                  DOWN stream   OutStream 1 with FRAME ZAPAS.
     4037                 end.
     4038      when "bo":u then  do:
     4039       DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     4040         p3 @ s-bar-code
     4041         p4 @ gds-zap-artic
     4042         p5 @ gds-zap-gds-name
     4043         p6 @ gds-zap-unit-base
     4044         p1 @ gds-type
     4045         bo-ostatok-start [p2] format "->>>>>>>>>>9.<<" @  F-ostatok-start
     4046         bo-Prih          [p2] format "->>>>>>>>>>9.<<" @  F-Prih
     4047         bo-RAsh          [p2] format "->>>>>>>>>>9.<<" @  F-RAsh
     4048         bo-KAssa         [p2] format "->>>>>>>>>>9.<<" @  F-KAssa
     4049         bo-Inv           [p2] format "->>>>>>>>>>9.<<" @  F-Inv
     4050         bo-Overturn      [p2] format "->>>>>>>>>>9.<<" @  F-Overturn
     4051         bo-Ostatok-end   [p2] format "->>>>>>>>>>9.<<" @  F-Ostatok-end
     4052         bo-gds-zap-other      format "->>>>>>>>>>9.<<" when (p2 = 1) @  gds-zap-other
     4053         with FRAME ZAPAS .
     4054                  DOWN stream   OutStream 1 with FRAME ZAPAS.
     4055                 end.
     4056      when ""  then  do:
     4057       DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     4058         p3 @ s-bar-code
     4059         p4 @ gds-zap-artic
     4060         p5 @ gds-zap-gds-name
     4061         p6 @ gds-zap-unit-base
     4062         p1 @ gds-type
