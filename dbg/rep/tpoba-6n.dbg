     4065         RAsh          [p2] format "->>>>>>>>>>9.<<" @  F-RAsh
     4066         KAssa         [p2] format "->>>>>>>>>>9.<<" @  F-KAssa
     4067         Inv           [p2] format "->>>>>>>>>>9.<<" @  F-Inv
     4068         Overturn      [p2] format "->>>>>>>>>>9.<<" @  F-Overturn
     4069         Ostatok-end   [p2] format "->>>>>>>>>>9.<<" @  F-Ostatok-end
     4070         gds-zap-other      format "->>>>>>>>>>9.<<" when (p2 = 1) @  gds-zap-other
     4071         with FRAME ZAPAS .
     4072                  DOWN stream   OutStream 1 with FRAME ZAPAS.
     4073                 end.
     4074      end case.
     4075    end procedure.
     4076   procedure di-qnty :
     4077   def input parameter p1 as char no-undo.
     4078   def input parameter p2 as int no-undo.
     4079   def input parameter p3 as char no-undo.
     4080   def input parameter p4 as char no-undo.
     4081   def input parameter p5 as char no-undo.
     4082   def input parameter p6 as char no-undo.
     4083   def input parameter p7 as char no-undo.
     4084    case caps(p7) :
     4085      when "b1":u  then do :
     4086       DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     4087         p3 @ s-bar-code
     4088         p4 @ gds-zap-artic
     4089         p5 @ gds-zap-gds-name
     4090         p6 @ gds-zap-unit-base
     4091         p1 @ gds-type
     4092         b1-ostatok-start [p2] format "->>>>>>>>>>9.<<<" @  F-ostatok-start
     4093         b1-Prih          [p2] format "->>>>>>>>>>9.<<<" @  F-Prih
     4094         b1-RAsh          [p2] format "->>>>>>>>>>9.<<<" @  F-RAsh
     4095         b1-KAssa         [p2] format "->>>>>>>>>>9.<<<" @  F-KAssa
     4096         b1-Inv           [p2] format "->>>>>>>>>>9.<<<" @  F-Inv
     4097         b1-Overturn      [p2] format "->>>>>>>>>>9.<<<" @  F-Overturn
     4098         b1-Ostatok-end   [p2] format "->>>>>>>>>>9.<<<" @  F-Ostatok-end
     4099         b1-gds-zap-other      format "->>>>>>>>>>9.<<<" when (p2 = 1) @  gds-zap-other
     4100         with FRAME ZAPAS .
     4101                 if num-entries(g1, "|") = 2 then assign  g1 =  "" .
     4102                 p6 = "" .
     4103                 gds-zap-type = "" .
     4104    if  p2 > 10  then f_e = 10 .
     4105                 else f_e =  0 .
     4106   if Make-Excel then  put   stream ForExcel unformatted
     4107     p3 CHR(9)
     4108     p4 CHR(9)
     4109     if f_e = 0 then g1 else p5 CHR(9)
     4110     p6 CHR(9)
     4111     gds-zap-type CHR(9)
     4112     excel-sum(b1-gds-zap-other   )  CHR(9)
     4113     excel-qnty(b1-ostatok-start[1  + f_e ])  CHR(9)
     4114     excel-sum(b1-ostatok-start[2  + f_e ])  CHR(9)
     4115     excel-sum(b1-ostatok-start[5  + f_e ])  CHR(9)
     4116     excel-sum(b1-ostatok-start[8  + f_e ])  CHR(9)
     4117     .
     4118     if Make-Excel then  put   stream ForExcel unformatted
     4119     excel-sum(b1-ostatok-start[3  + f_e ])  CHR(9)
     4120     excel-sum(b1-ostatok-start[6  + f_e ])  CHR(9)
     4121     excel-sum(b1-ostatok-start[9  + f_e ])  CHR(9)
     4122     excel-qnty(b1-Prih        [1  + f_e ])  CHR(9)
     4123     excel-sum(b1-Prih         [2  + f_e ])  CHR(9)
     4124     excel-sum(b1-Prih         [5  + f_e ])  CHR(9)
     4125     excel-sum(b1-Prih         [8  + f_e ])  CHR(9)
     4126     excel-sum(b1-Prih         [3  + f_e ])  CHR(9)
     4127     excel-sum(b1-Prih         [6  + f_e ])  CHR(9)
     4128     excel-sum(b1-Prih         [9  + f_e ])  CHR(9)
     4129     .
     4130     if Make-Excel then  put   stream ForExcel unformatted
     4131     excel-qnty(b1-RAsh        [1  + f_e ])  CHR(9)
     4132     excel-sum(b1-RAsh         [2  + f_e ])  CHR(9)
     4133     excel-sum(b1-RAsh         [5  + f_e ])  CHR(9)
     4134     excel-sum(b1-RAsh         [8  + f_e ])  CHR(9)
     4135     excel-sum(b1-RAsh         [3  + f_e ])  CHR(9)
     4136     excel-sum(b1-RAsh         [6  + f_e ])  CHR(9)
     4137     excel-sum(b1-RAsh         [9  + f_e ])  CHR(9)
     4138     excel-qnty(b1-KAssa       [1  + f_e ])  CHR(9)
     4139     excel-sum(b1-KAssa        [2  + f_e ])  CHR(9)
     4140     excel-sum(b1-KAssa        [5  + f_e ])  CHR(9)
     4141     excel-sum(b1-KAssa        [8  + f_e ])  CHR(9)
     4142     excel-sum(b1-KAssa        [3  + f_e ])  CHR(9)
     4143     excel-sum(b1-KAssa        [6  + f_e ])  CHR(9)
     4144     .
     4145     if Make-Excel then  put   stream ForExcel unformatted
     4146     excel-sum(b1-KAssa        [9  + f_e ])  CHR(9)
