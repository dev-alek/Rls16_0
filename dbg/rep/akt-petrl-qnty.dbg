      936                   v-torgconf-outrecv  = yes
      937               .
      938           end.
      939           if lookup( p-form-name, v-outegrp ) <> 0
      940           then do:
      941               assign
      942                   v-torgconf-outegrp  = yes
      943               .
      944           end.
      945           if lookup( p-form-name, v-outt12  ) <> 0
      946           then do:
      947               assign
      948                   v-torgconf-outt12   = yes
      949               .
      950           end.
