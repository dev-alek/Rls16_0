     4449   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
     4450     (
     4451        input buf_doc-line.artic
     4452     ,  input buf_doc-line.prod-type
     4453     ,  input buf_doc-line.prod-code
     4454     , output is-petrolium
     4455     , output is-pieces
     4456     ) no-error.
     4457         if error-status :error
     4458         then do:
     4459           return error return-value .
     4460         end.
     4461         if is-petrolium then do
     4462         :
     4463           find first buf_goods where buf_goods.artic     = buf_doc-line.artic
     4464                                  and buf_goods.prod-code = buf_doc-line.prod-code
     4465                                  and buf_goods.prod-type = buf_doc-line.prod-type no-lock no-error.
     4466           assign
     4467               v-doc-code = buf_doc-line.doc-code
     4468               v-gds-code = buf_goods.gds-code
     4469           .
     4470           v-InfoSectionsTotal:Initialization(v-doc-code, v-gds-code).
     4471           v-InfoSectionsTotal:GetDBAllAttr().
     4472           find first clients where clients.obj-code = buf_trn-doc.boss and
     4473                                    clients.obj-type = 'чел':U no-lock no-error.
     4474           find first person where person.psn-code = buf_trn-doc.boss no-lock no-error.
     4475           run gds-attr-value in this-procedure
     4476             (  input buf_goods.gds-code
     4477             ,  input 'fuel-type':U
     4478             , output v-gds-attr-value
     4479             , output v-gds-attr-type
     4480             ) no-error .
     4481           case v-gds-attr-value :
     4482             when "petrol" then do:
     4483               assign
     4484                 v-list-gds-name = v-list-gds-name + "," + buf_goods.gds-name
     4485                 v-sortpetrl = "бензин".
     4486             end.
     4487             when "diesel-sum" or when "diesel-wint" then do:
     4488               assign
     4489                 v-list-gds-name = v-list-gds-name + "," + buf_goods.gds-name
     4490                 v-sortpetrl = buf_goods.gds-name.
     4491             end.
     4492             otherwise next _foreachgds.
     4493           end case.
     4494           if v-date-start-min = ? or datetime (v-date-start-min, v-time-start-min) > datetime (v-InfoSectionsTotal:StartRealDate, v-InfoSectionsTotal:StartRealTime) then do:
     4495             assign
     4496               v-date-start-min = v-InfoSectionsTotal:StartRealDate.
     4497               v-time-start-min = v-InfoSectionsTotal:StartRealTime
     4498               .
     4499           end.
     4500           if v-date-end-max = ? or datetime (v-date-end-max, v-time-end-max) < datetime (v-InfoSectionsTotal:EndRealDate, v-InfoSectionsTotal:EndRealTime) then do:
     4501             assign
     4502               v-time-end-max = v-InfoSectionsTotal:EndRealTime
     4503               v-date-end-max = v-InfoSectionsTotal:EndRealDate
     4504             .
     4505           end.
     4506           do iNum = 1 to v-InfoSectionsTotal:SectionNum:
     4507             ii = ii + 1.
     4508             if ii > 4 then do:
     4509               run cr-end-general.
     4510               run cr-begin-general.
     4511               ii = 1.
     4512               if iNum >= v-InfoSectionsTotal:SectionNum
     4513                 then v-list-gds-name = "".
     4514             end.
     4515             run aktpq-xl-write-cell-data in this-procedure (
     4516                   input "gdsname":U + string (ii)
     4517                 , input buf_goods.gds-name
     4518             ).
     4519             run aktpq-xl-write-cell-data in this-procedure (
     4520                   input "sectionnum":U + string (ii)
     4521                 , input v-InfoSectionsTotal:GetInfoSectionProp(iNum):SectionName
     4522             ).
     4523             run aktpq-xl-write-cell-data in this-procedure (
     4524                   input "vol":U + string (ii)
     4525                 , input v-InfoSectionsTotal:GetInfoSectionProp(iNum):CarVol
     4526             ).
     4527            run aktpq-xl-write-cell-data in this-procedure (
