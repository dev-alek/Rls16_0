     4160   define variable vss-include-info16 as character format "X(65)" no-undo
     4161   initial "@(#)$Workfile$ $Revision$".
     4162   define stream excel-line .
     4163   define stream excel-cell .
     4164   define temp-table temp_cell-data no-undo
     4165       field data-key   as character
     4166       field data-value as character
     4167       index pi is primary unique data-key
     4168   .
     4169   define variable v-aktpq-xl-cell-file-name  as character    no-undo .
     4170   define variable v-aktpq-xl-data-file-name  as character    no-undo .
     4171   procedure aktpq-xl-init :
     4172   do
     4173   on error undo, return error
     4174   :
     4175       run gbl/_tmpfile.p (
     4176             input "xc"
     4177           , input ".txt"
     4178           , output v-aktpq-xl-cell-file-name
     4179       ).
     4180       output stream excel-cell to value( v-aktpq-xl-cell-file-name ).
     4181       run aktpq-xl-write-cell-data in this-procedure (
     4182             input "valutCode":U
     4183           , input "0":U
     4184       ).
     4185       run aktpq-xl-write-cell-data in this-procedure (
     4186             input "columnList":U
     4187           , input "":U
     4188       ).
     4189       run aktpq-xl-write-cell-data in this-procedure (
     4190             input "columnType":U
     4191           , input "":U
     4192       ).
     4193       run aktpq-xl-write-cell-data in this-procedure (
     4194             input "columnAmount":U
     4195           , input "0":U
     4196       ).
     4197   end.
     4198   end procedure.
     4199   procedure aktpq-xl-write-cell-data :
     4200   define input parameter p-data-key   as character        no-undo.
     4201   define input parameter p-data-value as character        no-undo.
     4202       define buffer buf_temp_cell-data     for temp_cell-data.
     4203   do
     4204   for buf_temp_cell-data
     4205   on error undo, return error
     4206   :
     4207       find first buf_temp_cell-data
     4208            where buf_temp_cell-data.data-key = p-data-key
     4209       no-error.
     4210       if not available buf_temp_cell-data
     4211       then do:
     4212           create buf_temp_cell-data.
     4213           assign
     4214               buf_temp_cell-data.data-key = p-data-key
     4215           .
     4216       end.
     4217       assign
     4218           buf_temp_cell-data.data-value = p-data-value
     4219       .
     4220       put stream excel-cell unformatted
     4221                           buf_temp_cell-data.data-key
     4222           chr(9)   buf_temp_cell-data.data-value
     4223           chr(10)
     4224       .
     4225   end.
     4226   end procedure.
     4227   procedure aktpq-xl-run-excel :
     4228   define input parameter p-header-filename    as character    no-undo .
     4229   define input parameter p-data-filename      as character    no-undo .
     4230   define variable v-template-file-name        as character    no-undo .
     4231   define variable v-vb-file-name              as character    no-undo .
     4232       define buffer buf_temp-param for temp-param .
     4233   do
     4234   for buf_temp-param
     4235   on error undo, return error
     4236   :
     4237       create buf_temp-param.
     4238       assign
     4239           v-template-file-name    = search( "exe/akt-petrl-q.xlt" )
     4240           v-vb-file-name          = search( "exe/t_97.bas")
     4241       .
     4242       if v-template-file-name = ?
     4243       or v-template-file-name = "":U
     4244       then do:
     4245           message
     4246               "Ошибка имени файла шаблона."
     4247           view-as alert-box error.
     4248       end.
     4249       if v-vb-file-name = ?
     4250       or v-vb-file-name = "":U
     4251       then do:
     4252           message
     4253               "Ошибка имени файла кода обработки."
     4254           view-as alert-box error.
     4255       end.
     4256       run paramls-write in this-procedure (
     4257             input "template":U
     4258           , input "template-file-name":U
     4259           , input v-template-file-name
     4260       ).
     4261       run paramls-write in this-procedure (
     4262             input "template":U
     4263           , input "vb-file-name":U
     4264           , input v-vb-file-name
     4265       ).
     4266       run paramls-write in this-procedure (
     4267             input "data":U
     4268           , input "data-header-filename":U
     4269           , input p-header-filename
     4270       ).
     4271       run paramls-write in this-procedure (
     4272             input "data":U
     4273           , input "data-filename":U
     4274           , input p-data-filename
     4275       ).
     4276       run gbl/macroxlt.p (
     4277           input-output table buf_temp-param
     4278       ) no-error.
     4279       if error-status :error
     4280       then do:
     4281           message
     4282                    vss-workfile vss-revision vss-description
     4283               skip(1)
     4284               skip "Ошибка создания файла Excel."
     4285               skip return-value
     4286               skip trim(error-status :get-message(1))
     4287                    trim(error-status :get-message(2))
     4288                    trim(error-status :get-message(3))
     4289           view-as alert-box error.
     4290           undo, return error .
     4291       end.
     4292   end.
     4293   end procedure.
     4294   procedure aktpq-xl-close :
     4295   do
     4296   on error undo, return error
     4297   :
     4298       output stream excel-line close.
     4299       output stream excel-cell close.
     4300       output to value( string( session:temp-directory + "$" + string( g#report-num ) ) + ".txl" ) append.
     4301           export "exe/akt-petrl-q.xlt":U.
     4302           export "exe/t_97.bas":U.
     4303           export v-aktpq-xl-cell-file-name.
     4304           export v-aktpq-xl-data-file-name.
     4305       output close.
     4306   end.
     4307   end procedure.
