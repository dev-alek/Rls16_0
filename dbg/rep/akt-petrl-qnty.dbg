     4422             v-cntxp-out-rate        = bf-cntxp_shop.out-rate
     4423             v-cntxp-out-line-discnt = bf-cntxp_shop.out-line-discnt
     4424             v-cntxp-in-ov           = bf-cntxp_shop.in-ov
     4425             v-cntxp-in-perm         = bf-cntxp_shop.in-perm
     4426             v-cntxp-no-eq           = bf-cntxp_shop.no-eq
