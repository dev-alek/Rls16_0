     1344   procedure torgconf-get-sup-param :
     1345   define input parameter p-obj-type           as character        no-undo.
     1346   define input parameter p-obj-code           as integer          no-undo.
     1347   define input parameter p-curr-code          as integer          no-undo.
     1348       define variable v-host-code    as integer      no-undo.
     1349       define variable v-par-type     as character    no-undo.
     1350   do
     1351   on error undo, return error
     1352   :
     1353       assign
     1354          v-torgconf-sup-host-code = v-host-code
     1355       .
     1356       if v-torgconf-sup-host-code = 0
     1357       then do:
     1358           assign
     1359               v-torgconf-sup-host-name           = "":U
     1360               v-torgconf-sup-host-addres         = "":U
     1361               v-torgconf-sup-host-post-addres    = "":U
     1362               v-torgconf-sup-host-phone          = "":U
     1363               v-torgconf-sup-host-inn            = "":U
     1364               v-torgconf-sup-host-kpp            = "":U
     1365               v-torgconf-sup-host-okpo           = "":U
     1366               v-torgconf-sup-host-egrip-date     = "":U
     1367               v-torgconf-sup-host-egrip-num      = "":U
     1368           .
     1369       end.
     1370       else do:
     1371           run fmtcli-get-client in this-procedure (
     1372                 input 'орг':U
     1373               , input v-torgconf-sup-host-code
     1374           ).
     1375           assign
     1376               v-torgconf-sup-host-name        = v-fmtcli-name
     1377               v-torgconf-sup-host-engl-name   = v-fmtcli-engl-name
     1378               v-torgconf-sup-host-addres      = v-fmtcli-full-addres
     1379               v-torgconf-sup-host-post-addres = v-fmtcli-post-addres
     1380               v-torgconf-sup-host-phone       = v-fmtcli-phone
     1381               v-torgconf-sup-host-inn         = v-fmtcli-inn
     1382               v-torgconf-sup-host-kpp         = v-fmtcli-kpp
     1383               v-torgconf-sup-host-okpo        = v-fmtcli-okpo
     1384           .
     1385           run gbl/clntat-v.p (
     1386                 input 'орг':U
     1387               , input v-torgconf-sup-host-code
     1388               , input 'egrip-date':U
     1389               , output v-torgconf-sup-host-egrip-date
     1390               , output v-par-type
     1391           ).
     1392           run gbl/clntat-v.p (
     1393                 input 'орг':U
     1394               , input v-torgconf-sup-host-code
     1395               , input 'egrip-num':U
     1396               , output v-torgconf-sup-host-egrip-num
     1397               , output v-par-type
     1398           ).
     1399           run fmtcli-get-bank in this-procedure (
     1400                 input v-host-code
     1401               , input 'орг':U
     1402               , input v-torgconf-sup-host-code
     1403               , input p-curr-code
     1404           ).
     1405       end.
     1406       assign
     1407           v-torgconf-sup-schet-exists = v-fmtcli-schet-exists
     1408           v-torgconf-sup-bank-exists  = v-fmtcli-bank-exists
     1409           v-torgconf-sup-bank-r-schet = v-fmtcli-bank-r-schet
     1410           v-torgconf-sup-bank-c-schet = v-fmtcli-bank-c-schet
     1411           v-torgconf-sup-bank-bik     = v-fmtcli-bank-bik
     1412           v-torgconf-sup-bank-name    = v-fmtcli-bank-name
     1413           v-torgconf-sup-bank-addres  = v-fmtcli-bank-addres
     1414           v-torgconf-sup-bank-city    = v-fmtcli-bank-city
     1415       .
     1416       assign
     1417           v-torgconf-sup-obj-type = p-obj-type
     1418           v-torgconf-sup-obj-code = p-obj-code
     1419       .
     1420       if trim(p-obj-type) <> ""
     1421       and p-obj-code <> 0
     1422       then do:
     1423       run fmtcli-get-client in this-procedure (
     1424             input p-obj-type
     1425           , input p-obj-code
     1426       ).
     1427       assign
     1428           v-torgconf-sup-obj-name        = v-fmtcli-name
     1429           v-torgconf-sup-obj-engl-name   = v-fmtcli-engl-name
     1430           v-torgconf-sup-obj-addres      = v-fmtcli-full-addres
     1431           v-torgconf-temp-post-addres    = v-fmtcli-post-addres
     1432           v-torgconf-sup-obj-phone       = v-fmtcli-phone
     1433           v-torgconf-sup-obj-inn         = v-fmtcli-inn
     1434           v-torgconf-sup-obj-okpo        = v-fmtcli-okpo
     1435       .
     1436      end.
     1437      end.
     1438   end procedure.
     1439   procedure torgconf-get-cli-param :
     1440   define input parameter p-host-obj-code      as integer          no-undo.
     1441   define input parameter p-obj-type           as character        no-undo.
     1442   define input parameter p-obj-code           as integer          no-undo.
     1443   define input parameter p-curr-code          as integer          no-undo.
     1444       define variable v-host-code    as integer      no-undo.
     1445   do
     1446   on error undo, return error
     1447   :
     1448       assign
     1449           v-torgconf-cli-type = p-obj-type
     1450           v-torgconf-cli-code = p-obj-code
     1451       .
     1452       run fmtcli-get-client in this-procedure (
     1453             input p-obj-type
     1454           , input p-obj-code
     1455       ).
     1456       assign
     1457           v-torgconf-cli-name         = trim( v-fmtcli-name          )
     1458           v-torgconf-cli-engl-name    = trim( v-fmtcli-engl-name          )
     1459           v-torgconf-cli-addres       = trim( v-fmtcli-full-addres   )
     1460           v-torgconf-cli-post-addres  = trim( v-fmtcli-post-addres   )
     1461           v-torgconf-cli-phone        = trim( v-fmtcli-phone         )
     1462           v-torgconf-cli-inn          = trim( v-fmtcli-inn           )
     1463           v-torgconf-cli-kpp          = trim( v-fmtcli-kpp           )
     1464           v-torgconf-cli-okpo         = trim( v-fmtcli-okpo          )
     1465       .
     1466      run fmtcli-get-bank in this-procedure (
     1467             input p-host-obj-code
     1468           , input p-obj-type
     1469           , input p-obj-code
     1470           , input p-curr-code
     1471       ).
     1472       assign
     1473           v-torgconf-cli-schet-exists = v-fmtcli-schet-exists
     1474           v-torgconf-cli-bank-exists  = v-fmtcli-bank-exists
     1475           v-torgconf-cli-bank-r-schet = v-fmtcli-bank-r-schet
     1476           v-torgconf-cli-bank-c-schet = v-fmtcli-bank-c-schet
     1477           v-torgconf-cli-bank-bik     = v-fmtcli-bank-bik
     1478           v-torgconf-cli-bank-name    = v-fmtcli-bank-name
     1479           v-torgconf-cli-bank-addres  = v-fmtcli-bank-addres
     1480           v-torgconf-cli-bank-city    = v-fmtcli-bank-city
     1481       .
     1482   end.
     1483   end procedure.
     1484   procedure torgconf-get-ship-param :
     1485   define input parameter p-host-obj-code      as integer          no-undo.
     1486   define input parameter p-obj-type           as character        no-undo.
     1487   define input parameter p-obj-code           as integer          no-undo.
     1488   define input parameter p-curr-code          as integer          no-undo.
     1489       define variable v-host-code    as integer      no-undo.
     1490   do
     1491   on error undo, return error
     1492   :
     1493       assign
     1494           v-torgconf-ship-type = p-obj-type
     1495           v-torgconf-ship-code = p-obj-code
     1496       .
     1497       if trim(p-obj-type) = ""
     1498       and p-obj-code = 0
     1499       then do:
     1500       assign
     1501           v-torgconf-ship-name         = "":U
     1502           v-torgconf-ship-addres       = "":U
     1503           v-torgconf-ship-post-addres  = "":U
     1504           v-torgconf-ship-phone        = "":U
     1505           v-torgconf-ship-inn          = "":U
     1506           v-torgconf-ship-kpp          = "":U
     1507           v-torgconf-ship-okpo         = "":U
     1508       .
     1509       end.
     1510       else do:
     1511       run fmtcli-get-client in this-procedure (
     1512             input p-obj-type
     1513           , input p-obj-code
     1514       ).
     1515       assign
     1516           v-torgconf-ship-name         = trim( v-fmtcli-name          )
     1517           v-torgconf-ship-engl-name    = trim( v-fmtcli-engl-name          )
     1518           v-torgconf-ship-addres       = trim( v-fmtcli-full-addres   )
     1519           v-torgconf-ship-post-addres  = trim( v-fmtcli-post-addres   )
     1520           v-torgconf-ship-phone        = trim( v-fmtcli-phone         )
     1521           v-torgconf-ship-inn          = trim( v-fmtcli-inn           )
     1522           v-torgconf-ship-kpp          = trim( v-fmtcli-kpp           )
     1523           v-torgconf-ship-okpo         = trim( v-fmtcli-okpo          )
     1524       .
     1525       end.
     1526           run fmtcli-get-bank in this-procedure (
     1527             input p-host-obj-code
     1528           , input p-obj-type
     1529           , input p-obj-code
     1530           , input p-curr-code
     1531       ).
     1532       assign
     1533           v-torgconf-ship-schet-exists = v-fmtcli-schet-exists
     1534           v-torgconf-ship-bank-exists  = v-fmtcli-bank-exists
     1535           v-torgconf-ship-bank-r-schet = v-fmtcli-bank-r-schet
     1536           v-torgconf-ship-bank-c-schet = v-fmtcli-bank-c-schet
     1537           v-torgconf-ship-bank-bik     = v-fmtcli-bank-bik
     1538           v-torgconf-ship-bank-name    = v-fmtcli-bank-name
     1539           v-torgconf-ship-bank-addres  = v-fmtcli-bank-addres
     1540           v-torgconf-ship-bank-city    = v-fmtcli-bank-city
     1541       .
     1542   end.
     1543   end procedure.
     1544   procedure torgconf-get-holdfirm-code :
     1545   define input parameter p-obj-type   as character        no-undo.
     1546   define input parameter p-obj-code   as integer          no-undo.
     1547   define output parameter p-firm-code as integer          no-undo.
     1548       define variable v-firm-code-str     as character    no-undo.
     1549       define variable v-par-type          as character    no-undo.
     1550       define buffer buf_clients       for ub.clients.
     1551   do
     1552   for buf_clients
     1553   on error undo, return error
     1554   :
     1555       run gbl/clntat-v.p (
     1556             input p-obj-type
     1557           , input p-obj-code
     1558           , input 'holdfirm-code':U
     1559           , output v-firm-code-str
     1560           , output v-par-type
     1561       ).
     1562       assign
     1563           p-firm-code = integer( v-firm-code-str )
     1564       no-error.
     1565       if error-status :error
     1566       then do:
     1567           message
     1568               "Неверно задан код фирмы для печати накладных."
     1569           view-as alert-box warning.
     1570           assign
     1571               p-firm-code = 0
     1572           .
     1573       end.
     1574       else do:
     1575           find first buf_clients no-lock
     1576                where buf_clients.obj-type = 'орг':U
     1577                  and buf_clients.obj-code = p-firm-code
     1578           no-error.
     1579           if not available buf_clients
     1580           then do:
     1581               message
     1582                   "Включен параметр 'Список печатных форм, для которых должна быть задана фирма для печати накладных' (outhold)" skip
     1583                   "Не найдена фирма по заданному коду фирмы для печати накладных."
     1584               view-as alert-box warning.
     1585               assign
     1586                   p-firm-code = 0
     1587               .
     1588           end.
     1589       end.
     1590   end.
     1591   end procedure.
     1592   procedure torgconf-get-post-head:
     1593   define input  parameter p-obj-type             as character        no-undo.
     1594   define input  parameter p-obj-code             as integer          no-undo.
     1595   define output parameter p-torgconf-post-head   as character        no-undo.
     1596      define variable v-host-code         as integer      no-undo.
     1597      define buffer buf_sysconf     for ub.sysconf.
     1598        assign
     1599         p-torgconf-post-head  = ""
     1600        .
     1601   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1602   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1603     (input  p-obj-type
     1604     ,input  p-obj-code
     1605     ,output v-host-code
     1606     )  .
     1607      find first buf_sysconf no-lock
     1608      where buf_sysconf.host-code = v-host-code
     1609      no-error.
     1610      if available buf_sysconf
     1611      then do:
     1612         assign
     1613            p-torgconf-post-head = buf_sysconf.head-position
     1614         .
     1615      end.
     1616   end procedure.
     1617   procedure torgconf-get-storekeeper:
     1618   define input  parameter p-wrkr                   as integer          no-undo.
     1619   define output parameter p-torgconf-wrkr-name     as character        no-undo.
     1620   define output parameter p-torgconf-post          as character        no-undo.
     1621      define buffer buf_sysconf     for ub.sysconf.
     1622      define buffer buf_person      for ub.person.
     1623      define buffer buf_shop        for ub.shop .
     1624      define buffer buf_store       for ub.store .
     1625      if v-torgconf-outC = "no_print"
     1626      then do:
     1627         assign p-torgconf-post = ""
     1628                p-torgconf-wrkr-name = ""
     1629                .
     1630      end.
     1631      if v-torgconf-outC = "clad_doc"
     1632      then do:
     1633         run rep/get-psn.p
     1634               (input  p-wrkr
     1635               ,output p-torgconf-wrkr-name
     1636               ) .
     1637         find first buf_person no-lock
     1638         where buf_person.psn-code = p-wrkr
     1639         no-error.
     1640         if available buf_person
     1641         then do:
     1642           p-torgconf-post = buf_person.position.
     1643         end.
     1644         if p-torgconf-post = "?":U then p-torgconf-post = "".
     1645         if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     1646      end.
     1647      if v-torgconf-outC = "clad_obj"
     1648      then do:
     1649         CASE v-torgconf-self-obj-type:
     1650         WHEN 'маг':U
     1651         THEN DO:
     1652            find first buf_shop no-lock
     1653            where buf_shop.obj-code = v-torgconf-self-obj-code
     1654            .
     1655            assign
     1656               p-torgconf-wrkr-name = buf_shop.store-man
     1657               p-torgconf-post = ""
     1658            .
     1659            if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     1660         END.
     1661         WHEN 'скл':U
     1662         THEN DO:
     1663            find first buf_store no-lock
     1664            where buf_store.obj-code = v-torgconf-self-obj-code
     1665            .
     1666            assign
     1667               p-torgconf-wrkr-name = buf_store.store-man
     1668               p-torgconf-post = ""
     1669            .
     1670            if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     1671         END.
     1672         OTHERWISE DO:
     1673            assign
     1674               p-torgconf-post = "":U
     1675               p-torgconf-wrkr-name = "":U
     1676            .
     1677         END.
     1678         END CASE.
     1679      end.
     1680    end procedure.
     1681   procedure torgconf-get-form-header :
     1682   define input parameter p-for-inverse    as logical          no-undo.
     1683   define input parameter p-doc-code       as character        no-undo.
     1684   define input parameter p-print-doc      as logical          no-undo.
     1685   define input parameter p-doc-date       as date             no-undo.
     1686   define input parameter p-fact-date      as date             no-undo.
     1687   define input parameter p-doc-type       as character        no-undo.
     1688   define input parameter p-status_        as character        no-undo.
     1689   define input parameter p-reverse        as logical          no-undo.
     1690   define input parameter p-sf-par         as logical          no-undo.
     1691       define variable v-attr-type         as character    no-undo.
     1692       define variable v-doc-code-standard as logical      no-undo.
     1693       define variable v-doc-date-standard as logical      no-undo.
     1694       define variable v-par-consignee-addres  as character    no-undo.
     1695       define variable v-host-code         as integer      no-undo.
     1696       define variable v-dcode-attr        as character    no-undo.
     1697       define variable v-ddate-attr        as character    no-undo.
     1698       define variable v-doc-date          as character    no-undo.
     1699       define variable v-doc-code          as character    no-undo.
     1700       define variable v-par-type          as character    no-undo.
     1701       define variable v-attr              as character    no-undo.
     1702       define buffer buf_firm          for ub.firm .
     1703       define buffer buf_clients       for ub.clients .
     1704       define buffer buf_sysconf       for ub.sysconf .
     1705       define buffer buf_shop          for ub.shop .
     1706       define buffer buf_store         for ub.store .
     1707       define buffer buf_person        for ub.person .
     1708       define buffer buf_trn-doc       for ub.trn-doc .
     1709       define buffer buf_wth-doc       for ub.wth-doc .
     1710       do
     1711   for buf_firm
     1712     , buf_clients
     1713     , buf_sysconf
     1714     , buf_shop
     1715     , buf_trn-doc
     1716     , buf_person
     1717     , buf_wth-doc
     1718   on error undo, return error
     1719   :
     1720       if p-doc-type = 'при':U
     1721       or p-doc-type = 'возврат':U
     1722       then do:
     1723           assign
     1724               v-torgconf-supplier         = substitute( "&1&2&3&4&5", v-torgconf-cli-name, ( if v-torgconf-cli-addres = "":U then "":U else ", " ),
     1725                                             v-torgconf-cli-addres, ( if v-torgconf-cli-phone = "":U then "":U else ", " ), v-torgconf-cli-phone )
