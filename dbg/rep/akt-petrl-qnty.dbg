     4529                 , input buf_doc-line.temperature
     4530             ).
     4531            run aktpq-xl-write-cell-data in this-procedure (
     4532                   input "petrlvol":U + string (ii)
     4533                 , input v-InfoSectionsTotal:GetInfoSectionProp(iNum):FactQnty
     4534             ).
     4535            run aktpq-xl-write-cell-data in this-procedure (
     4536                   input "dens":U + string (ii)
     4537                 , input v-InfoSectionsTotal:GetInfoSectionProp(iNum):DocDensity * 1000
     4538             ).
     4539            run aktpq-xl-write-cell-data in this-procedure (
     4540                   input "weight":U + string (ii)
     4541                 , input v-InfoSectionsTotal:GetInfoSectionProp(iNum):CliQnty
     4542             ).
     4543            run aktpq-xl-write-cell-data in this-procedure (
     4544                   input "mark":U + string (ii)
     4545                 , input v-InfoSectionsTotal:GetInfoSectionProp(iNum):ABTarir
