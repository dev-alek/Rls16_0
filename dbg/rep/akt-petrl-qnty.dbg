     4547             find first buf_rvs-doc no-lock where buf_rvs-doc.rvs-type = 'перед_док':U and buf_rvs-doc.out-code = buf_trn-doc.doc-code no-error.
     4548             def var v-loc1 as char no-undo.
     4549             def var v-state-level-total as decimal no-undo.
     4550             def var v-state-measure-qnty as decimal no-undo.
     4551             def var v-state-measure-cli-qnty as decimal no-undo.
     4552             def var v-state-temperature as decimal no-undo.
     4553             def var v-availrvsline as logical no-undo.
     4554             assign
     4555               v-state-level-total = 0
     4556               v-state-measure-qnty = 0
     4557               v-state-measure-cli-qnty = 0
     4558               v-state-temperature = 0
     4559               v-availrvsline = false
     4560               v-loc1 = ""
     4561             .
     4562             if available (buf_rvs-doc) then do:
     4563               for each buf_rvs-line where buf_rvs-line.rvs-code = buf_rvs-doc.rvs-code and buf_rvs-line.gds-code = buf_goods.gds-code no-lock:
     4564                 find first ub.place where ub.place.pl-code = buf_rvs-line.pl-code no-lock no-error.
     4565                 if available (ub.place)
     4566                 then do:
     4567                   v-loc1 = if v-loc1 <> "" then v-loc1 + "," + ub.place.loc1 else ub.place.loc1.
     4568                 end.
     4569                 v-availrvsline = true.
     4570                 assign
     4571                   v-state-level-total = v-state-level-total + buf_rvs-line.state-level-total
     4572                   v-state-measure-qnty = v-state-measure-qnty + buf_rvs-line.state-measure-qnty
     4573                   v-state-measure-cli-qnty = v-state-measure-cli-qnty + buf_rvs-line.state-measure-cli-qnty
     4574                   v-state-temperature = buf_rvs-line.state-temperature
     4575                 .
     4576               end.
     4577             end.
     4578             if v-availrvsline then do:
     4579               run aktpq-xl-write-cell-data in this-procedure (
     4580                 input "beforelevtotal":U + string (ii)
     4581                 , input v-state-level-total
     4582                 ).
     4583               run aktpq-xl-write-cell-data in this-procedure (
     4584                 input "beforemeasqnty":U + string (ii)
     4585                 , input v-state-measure-qnty
     4586                 ).
     4587               assign
     4588                 v-beforemeasqnty = v-state-measure-qnty.
     4589               run aktpq-xl-write-cell-data in this-procedure (
     4590                 input "beforestatetemp":U + string (ii)
     4591                 , input v-state-temperature
     4592                 ).
     4593               run aktpq-xl-write-cell-data in this-procedure (
     4594                 input "beforestatedens":U + string (ii)
     4595                 , input v-state-measure-cli-qnty / v-state-measure-qnty * 1000
     4596                 ).
     4597               run aktpq-xl-write-cell-data in this-procedure (
     4598                 input "beforestateweight":U + string (ii)
     4599                 , input v-state-measure-cli-qnty
     4600                 ).
     4601               assign
     4602                 v-beforestateweight = v-state-measure-cli-qnty.
     4603             end.
     4604             find first buf_rvs-doc no-lock where buf_rvs-doc.rvs-type = 'после_док':U and buf_rvs-doc.out-code = buf_trn-doc.doc-code no-error.
     4605             assign
     4606               v-state-level-total = 0
     4607               v-state-measure-qnty = 0
     4608               v-state-measure-cli-qnty = 0
     4609               v-state-temperature = 0
     4610               v-availrvsline = false
     4611               v-loc1 = ""
     4612             .
     4613             if available (buf_rvs-doc) then do:
     4614               for each buf_rvs-line no-lock where buf_rvs-line.rvs-code = buf_rvs-doc.rvs-code and buf_rvs-line.gds-code = buf_goods.gds-code :
     4615                 find first ub.place where ub.place.pl-code = buf_rvs-line.pl-code no-lock no-error.
     4616                 if available (ub.place)
     4617                 then do:
     4618                   v-loc1 = if v-loc1 <> "" then v-loc1 + "," + ub.place.loc1 else ub.place.loc1.
     4619                 end.
     4620                 v-availrvsline = true.
     4621                 assign
     4622                   v-state-level-total = buf_rvs-line.state-level-total + v-state-level-total
     4623                   v-state-measure-qnty = v-state-measure-qnty + buf_rvs-line.state-measure-qnty
     4624                   v-state-measure-cli-qnty = v-state-measure-cli-qnty + buf_rvs-line.state-measure-cli-qnty
     4625                   v-state-temperature = buf_rvs-line.state-temperature
     4626                 .
     4627               end.
     4628             end.
     4629             if v-availrvsline then do:
     4630               run aktpq-xl-write-cell-data in this-procedure (
     4631                 input "afterlevtotal":U + string (ii)
     4632                 , input v-state-level-total
     4633                 ).
     4634               run aktpq-xl-write-cell-data in this-procedure (
     4635                 input "aftermeasqnty":U + string (ii)
     4636                 , input  v-state-measure-qnty
     4637                 ).
     4638               run aktpq-xl-write-cell-data in this-procedure (
     4639                 input "afterstatetemp":U + string (ii)
     4640                 , input v-state-temperature
     4641                 ).
     4642               run aktpq-xl-write-cell-data in this-procedure (
     4643                 input "afterstatedens":U + string (ii)
     4644                 , input v-state-measure-cli-qnty / v-state-measure-qnty * 1000
     4645                 ).
     4646               run aktpq-xl-write-cell-data in this-procedure (
     4647                 input "afterstateweight":U + string (ii)
     4648                 , input v-state-measure-cli-qnty
     4649                 ).
     4650               assign
     4651                 v-acc_qnty = v-state-measure-qnty - v-beforemeasqnty
     4652                 v-acc_qnty_kg = v-state-measure-cli-qnty - v-beforestateweight
     4653               .
     4654               run aktpq-xl-write-cell-data in this-procedure (
     4655                 input "acc_qnty":U + string (ii)
     4656                 , input string (v-acc_qnty)
     4657                 ).
     4658               run aktpq-xl-write-cell-data in this-procedure (
     4659                 input "acc_qnty_kg":U + string (ii)
     4660                 , input string (v-acc_qnty_kg)
     4661                 ).
     4662             end.
     4663             run aktpq-xl-write-cell-data in this-procedure (
     4664                   input "sortpetrl":U + string (ii)
     4665                 , input v-sortpetrl
     4666             ).
     4667             run aktpq-xl-write-cell-data in this-procedure (
     4668               input "mouth":U + string (ii)
     4669               , input v-InfoSectionsTotal:GetInfoSectionProp(iNum):Mouth
     4670               ).
     4671             run aktpq-xl-write-cell-data in this-procedure (
     4672               input "factvol":U + string (ii)
     4673               , input v-InfoSectionsTotal:GetInfoSectionProp(iNum):TankVol
     4674               ).
     4675             run aktpq-xl-write-cell-data in this-procedure (
     4676               input "denspomi":U + string (ii)
     4677               , input v-InfoSectionsTotal:GetInfoSectionProp(iNum):TankDensityPomi * 1000
     4678               ).
     4679             run aktpq-xl-write-cell-data in this-procedure (
     4680               input "volpomi":U + string (ii)
     4681               , input v-InfoSectionsTotal:GetInfoSectionProp(iNum):TankVolPomi
     4682               ).
     4683             run aktpq-xl-write-cell-data in this-procedure (
     4684               input "factweight":U + string (ii)
     4685               , input v-InfoSectionsTotal:GetInfoSectionProp(iNum):TankWeight
     4686               ).
     4687             run aktpq-xl-write-cell-data in this-procedure (
     4688               input "measur_error":U + string (ii)
     4689               , input "0.65"
     4690               ).
     4691             assign
     4692               v-admittance_error_mass = 0.0065 * v-InfoSectionsTotal:GetInfoSectionProp(iNum):TankWeight no-error.
     4693             run aktpq-xl-write-cell-data in this-procedure (
     4694               input "admittance_error_mass":U + string (ii)
     4695               , input string (v-admittance_error_mass)
     4696               ).
     4697             assign
     4698               v-revision = decimal (entry (2, v-factpl, ";")) no-error.
     4699             if (entry (2, v-factpl, ";")) begins "revision="
     4700             then do:
     4701               assign
     4702                 v-diff_mass = v-acc_qnty_kg - v-InfoSectionsTotal:GetInfoSectionProp(iNum):CliQnty no-error.
     4703             end.
     4704             else do:
     4705               assign
     4706                 v-diff_mass = v-InfoSectionsTotal:GetInfoSectionProp(iNum):TankWeight - v-InfoSectionsTotal:GetInfoSectionProp(iNum):CliQnty no-error.
     4707             end.
     4708             run aktpq-xl-write-cell-data in this-procedure (
     4709               input "diff_mass":U + string (ii)
     4710               , input string (v-diff_mass)
     4711               ).
     4712             if (buf_trn-doc.fact-date = ? and 3 < month (today) and month (today) < 10)
     4713                 or (buf_trn-doc.fact-date <> ? and 3 <  month (buf_trn-doc.fact-date) and  month (buf_trn-doc.fact-date) < 10 )
     4714             then do:
     4715               case v-gds-attr-value:
     4716                 when "petrol" then do:
     4717                   v-natural_loss = v-InfoSectionsTotal:GetInfoSectionProp(iNum):CliQnty * 0.0211 / 100.
     4718                 end.
     4719                 when "diesel-sum" then do:
     4720                   v-natural_loss = v-InfoSectionsTotal:GetInfoSectionProp(iNum):CliQnty * 0.0006 / 100.
     4721                 end.
     4722                 when "diesel-wint" then do:
     4723                   v-natural_loss = v-InfoSectionsTotal:GetInfoSectionProp(iNum):CliQnty * 0.0021 / 100.
     4724                 end.
     4725               end case.
     4726             end.
     4727             else do:
     4728               case v-gds-attr-value:
     4729                 when "petrol" then do:
     4730                   v-natural_loss = v-InfoSectionsTotal:GetInfoSectionProp(iNum):CliQnty * 0.0134 / 100.
     4731                 end.
     4732                 when "diesel-sum" then do:
     4733                   v-natural_loss = v-InfoSectionsTotal:GetInfoSectionProp(iNum):CliQnty * 0.0003 / 100.
     4734                 end.
     4735                 when "diesel-wint" then do:
     4736                   v-natural_loss = v-InfoSectionsTotal:GetInfoSectionProp(iNum):CliQnty * 0.0012 / 100.
     4737                 end.
     4738               end case.
     4739             end.
     4740             run aktpq-xl-write-cell-data in this-procedure (
     4741               input "natural_loss":U + string (ii)
     4742               , input string (v-natural_loss)
     4743               ).
     4744             if v-diff_mass > 0 then do:
     4745               run aktpq-xl-write-cell-data in this-procedure (
     4746                 input "surpluse":U + string (ii)
     4747                 , input if v-diff_mass - v-admittance_error_mass > 0 then v-diff_mass - v-admittance_error_mass else 0
     4748                 ).
     4749             end.
     4750             else do:
     4751               run aktpq-xl-write-cell-data in this-procedure (
     4752                 input "surpluse":U + string (ii)
     4753                 , input if v-diff_mass + v-admittance_error_mass + v-natural_loss < 0 then v-diff_mass + v-admittance_error_mass + v-natural_loss else 0
     4754                 ).
     4755             end.
     4756             run aktpq-xl-write-cell-data in this-procedure (
     4757               input "accept_accod_kg":U + string (ii)
     4758               , input v-InfoSectionsTotal:GetInfoSectionProp(iNum):FactKgQnty
     4759               ).
     4760             run aktpq-xl-write-cell-data in this-procedure (
     4761               input "accept_accod_l":U + string (ii)
     4762               , input v-InfoSectionsTotal:GetInfoSectionProp(iNum):FactQnty
     4763               ).
     4764             run aktpq-xl-write-cell-data in this-procedure (
     4765               input "coor":U + string (ii)
