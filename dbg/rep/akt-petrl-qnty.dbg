     3486   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
     3487   procedure paramls-clear :
     3488     define buffer buf_temp-param for temp-param .
     3489     do
     3490     on error undo, return error return-value
     3491     :
     3492       for each buf_temp-param
     3493       on error undo, return error
     3494       :
     3495         delete buf_temp-param .
     3496       end.
     3497     end.
     3498   end procedure.
     3499   procedure paramls-write :
     3500     define input  parameter p-code     as character no-undo .
     3501     define input  parameter p-sub-code as character no-undo .
     3502     define input  parameter p-value    as character no-undo .
     3503     define buffer buf_temp-param for temp-param .
     3504     do
     3505     on error undo, return error return-value
     3506     :
     3507       find first buf_temp-param
     3508         where buf_temp-param.param-code     = p-code
     3509           and buf_temp-param.param-sub-code = p-sub-code
     3510         no-error .
     3511       if not available buf_temp-param then do:
     3512         create buf_temp-param .
     3513         assign
     3514           buf_temp-param.param-code     = p-code
     3515           buf_temp-param.param-sub-code = p-sub-code
     3516         .
     3517       end.
     3518       assign
     3519         buf_temp-param.param-value = p-value
     3520       .
     3521     end.
     3522   end procedure.
     3523   procedure paramls-read :
     3524     define input  parameter p-code          as character no-undo .
     3525     define input  parameter p-sub-code      as character no-undo .
     3526     define input  parameter p-default-value as character no-undo .
     3527     define output parameter p-value         as character no-undo .
     3528     define buffer buf_temp-param for temp-param .
     3529     do
     3530     on error undo, return error return-value
     3531     :
     3532       find first buf_temp-param
     3533         where buf_temp-param.param-code     = p-code
     3534           and buf_temp-param.param-sub-code = p-sub-code
     3535         no-error .
     3536       if available buf_temp-param then do:
     3537         assign
     3538           p-value = buf_temp-param.param-value
     3539         .
     3540       end.
     3541       else do:
     3542         assign
     3543           p-value = p-default-value
     3544         .
     3545       end.
     3546     end.
     3547   end procedure.
     3548   procedure paramls-append :
     3549     define input  parameter p-code     as character no-undo .
     3550     define input  parameter p-sub-code as character no-undo .
     3551     define input  parameter p-value    as character no-undo .
     3552     define buffer buf_temp-param for temp-param .
     3553     do
     3554     on error undo, return error return-value
     3555     :
     3556       find first buf_temp-param
     3557            where buf_temp-param.param-code     = p-code
     3558              and buf_temp-param.param-sub-code = p-sub-code
     3559         no-error .
     3560       if not available buf_temp-param then do:
     3561         create buf_temp-param .
     3562         assign
     3563           buf_temp-param.param-code     = p-code
     3564           buf_temp-param.param-sub-code = p-sub-code
     3565           buf_temp-param.param-value    = p-value
     3566         .
     3567       end.
     3568       else do:
     3569           assign
     3570               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
     3571           .
     3572       end.
     3573     end.
     3574   end procedure.
