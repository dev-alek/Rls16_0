     4803   PROCEDURE loc-doc-get-attr :
     4804     do
     4805     on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     4806     on stop   undo, return error substitute( "&1. stop", vss-workfile )
     4807     on endkey undo, return error substitute( "&1. endkey", vss-workfile )
     4808     :
     4809               find first buf_doc-attr     where buf_doc-attr.doc-code  = v-doc-code       and buf_doc-attr.attr-code = "car-num"     no-error.
     4810         if available buf_doc-attr then do:       assign         v-car-num = buf_doc-attr.attr-value       .     end.
     4811               find first buf_doc-attr     where buf_doc-attr.doc-code  = v-doc-code       and buf_doc-attr.attr-code = "autoent"     no-error.
     4812               assign
     4813           v-autoent-obj-type = entry (1, buf_doc-attr.attr-value, ";")
     4814         no-error.
     4815               find first buf_doc-attr     where buf_doc-attr.doc-code  = v-doc-code       and buf_doc-attr.attr-code = "autoent"     no-error.
     4816               assign
     4817           v-autoent-obj-code = entry (2, buf_doc-attr.attr-value, ";")
     4818         no-error.
     4819               find first buf_doc-attr     where buf_doc-attr.doc-code  = v-doc-code       and buf_doc-attr.attr-code = "ptb-item-pour"     no-error.
     4820               if available buf_doc-attr then do:       assign         v-item-pour = buf_doc-attr.attr-value       .     end.
     4821               find first buf_doc-attr     where buf_doc-attr.doc-code  = v-doc-code       and buf_doc-attr.attr-code = "fio-driver"     no-error.
     4822               if available buf_doc-attr then do:       assign         v-fio = buf_doc-attr.attr-value       .     end.
     4823               find first buf_doc-attr     where buf_doc-attr.doc-code  = v-doc-code       and buf_doc-attr.attr-code = "ptbobj"     no-error.
     4824               assign
     4825           v-ptbotype = entry (1, buf_doc-attr.attr-value, ";")
     4826         no-error.
     4827               find first buf_doc-attr     where buf_doc-attr.doc-code  = v-doc-code       and buf_doc-attr.attr-code = "ptbobj"     no-error.
     4828               assign
     4829           v-ptbocode = entry (2, buf_doc-attr.attr-value, ";")
     4830         no-error.
     4831               find first buf_doc-attr     where buf_doc-attr.doc-code  = v-doc-code       and buf_doc-attr.attr-code = "time-income"     no-error.
     4832         if available buf_doc-attr then do:       assign         v-time-income = buf_doc-attr.attr-value       .     end.
     4833     end.
