     5114         run aktpq-xl-write-cell-data in this-procedure (
     5115               input "acceptendmin":U
     5116             , input v-time-end-max mod 60
     5117         ).
     5118         run aktpq-xl-write-cell-data in this-procedure (
     5119               input "acceptendhour":U
     5120             , input (v-time-end-max - v-time-end-max mod 60) / 60
     5121         ).
     5122       end.
     5123       run aktpq-xl-close in this-procedure .
     5124   if g#quest-print = false
     5125   then do:
     5126     run adecomm/_osprint.p ( ?, string( session:temp-directory + "rpt" + string( g#report-num ) ),
     5127                                         7, (if 4 >= 8 then 2 else 0), 0, 0,
     5128                                         OUTPUT g#log ).
     5129   end.
     5130   else do:
     5131     os-command silent
     5132       value( "COPY /b " +
     5133         string( session:temp-directory) +  "$" + string( g#report-num ) + " + " +
     5134         string( session:temp-directory) + "rpt" + string( g#report-num ) + " " +
     5135         string( session:temp-directory) +  "$" + string( g#report-num )
     5136                 ) .
     5137     os-command silent
     5138       value( "COPY /b " +
     5139         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl" + " + " +
     5140         string( session:temp-directory) + "rpt" + string( g#report-num ) + ".txl" + " " +
     5141         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl"
     5142                 ) .
     5143   end.
     5144   end.
