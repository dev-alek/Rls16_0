     4417           assign
     4418             v-cntxp-doc-prt         = (v-cntxp-conf-par = "yes") and bf-cntxp_shop.doc-prt
     4419             v-cntxp-price-calc      = bf-cntxp_shop.price-calc
     4420             v-cntxp-inout-price     = bf-cntxp_shop.inout-price
