      993           if lookup( p-form-name, v-outexlst ) <> 0
      994           then do:
      995               assign
      996                   v-torgconf-outexlst  = yes
      997               .
      998           end.
      999        assign
     1000         v-name = p-form-name.
     1001   end.
     1002   end.
     1003   end procedure.
     1004   procedure torgconf-get-self-param :
     1005   define input parameter p-obj-type           as character        no-undo.
     1006   define input parameter p-obj-code           as integer          no-undo.
     1007   define input parameter p-curr-code          as integer          no-undo.
     1008       define variable v-host-code    as integer      no-undo.
     1009       define variable v-par-type     as character    no-undo.
     1010   do
     1011   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message(1))
     1012   :
     1013   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1014   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1015     (input  p-obj-type
     1016     ,input  p-obj-code
     1017     ,output v-host-code
     1018     )  .
     1019       if v-torgconf-outhold = yes
     1020       then do:
     1021           run torgconf-get-holdfirm-code in this-procedure (
     1022                 input p-obj-type
     1023               , input p-obj-code
     1024               , output v-torgconf-self-host-code
     1025           ).
     1026           if v-torgconf-self-host-code = 0
     1027           then do:
     1028               return error.
     1029           end.
     1030       end.
     1031       else do:
     1032           assign
     1033               v-torgconf-self-host-code = v-host-code
     1034           .
     1035       end.
     1036       if v-torgconf-self-host-code = 0
     1037       then do:
     1038           assign
     1039               v-torgconf-self-host-name           = "":U
     1040               v-torgconf-self-host-addres         = "":U
     1041               v-torgconf-self-host-post-addres    = "":U
     1042               v-torgconf-self-host-phone          = "":U
     1043               v-torgconf-self-host-inn            = "":U
     1044               v-torgconf-self-host-kpp            = "":U
     1045               v-torgconf-self-host-okpo           = "":U
     1046               v-torgconf-self-host-egrip-date     = "":U
     1047               v-torgconf-self-host-egrip-num      = "":U
     1048           .
     1049       end.
     1050       else do:
     1051           run fmtcli-get-client in this-procedure (
     1052                 input 'орг':U
     1053               , input v-torgconf-self-host-code
     1054           ).
     1055           assign
     1056               v-torgconf-self-host-name        = v-fmtcli-name
     1057               v-torgconf-self-host-engl-name   = v-fmtcli-engl-name
     1058               v-torgconf-self-host-addres      = v-fmtcli-full-addres
     1059               v-torgconf-self-host-post-addres = v-fmtcli-post-addres
     1060               v-torgconf-self-host-phone       = v-fmtcli-phone
     1061               v-torgconf-self-host-inn         = v-fmtcli-inn
     1062               v-torgconf-self-host-kpp         = v-fmtcli-kpp
     1063               v-torgconf-self-host-okpo        = v-fmtcli-okpo
     1064           .
     1065           run gbl/clntat-v.p (
     1066                 input 'орг':U
     1067               , input v-torgconf-self-host-code
     1068               , input 'egrip-date':U
     1069               , output v-torgconf-self-host-egrip-date
     1070               , output v-par-type
     1071           ).
     1072           run gbl/clntat-v.p (
     1073                 input 'орг':U
     1074               , input v-torgconf-self-host-code
     1075               , input 'egrip-num':U
     1076               , output v-torgconf-self-host-egrip-num
     1077               , output v-par-type
     1078           ).
     1079           run fmtcli-get-bank in this-procedure (
     1080                 input v-host-code
     1081               , input 'орг':U
     1082               , input v-torgconf-self-host-code
     1083               , input p-curr-code
     1084           ).
     1085       end.
     1086       assign
     1087           v-torgconf-self-schet-exists = v-fmtcli-schet-exists
     1088           v-torgconf-self-bank-exists  = v-fmtcli-bank-exists
     1089           v-torgconf-self-bank-r-schet = v-fmtcli-bank-r-schet
     1090           v-torgconf-self-bank-c-schet = v-fmtcli-bank-c-schet
     1091           v-torgconf-self-bank-bik     = v-fmtcli-bank-bik
     1092           v-torgconf-self-bank-name    = v-fmtcli-bank-name
     1093           v-torgconf-self-bank-addres  = v-fmtcli-bank-addres
     1094           v-torgconf-self-bank-city    = v-fmtcli-bank-city
     1095       .
     1096       assign
     1097           v-torgconf-self-obj-type = p-obj-type
     1098           v-torgconf-self-obj-code = p-obj-code
     1099       .
     1100       run fmtcli-get-client in this-procedure (
     1101             input p-obj-type
     1102           , input p-obj-code
     1103       ).
     1104       assign
     1105           v-torgconf-self-obj-name       = v-fmtcli-name
     1106           v-torgconf-self-obj-engl-name  = v-fmtcli-engl-name
     1107           v-torgconf-self-obj-addres     = v-fmtcli-full-addres
     1108           v-torgconf-temp-post-addres    = v-fmtcli-post-addres
     1109           v-torgconf-self-obj-phone      = v-fmtcli-phone
     1110           v-torgconf-self-obj-inn        = v-fmtcli-inn
     1111           v-torgconf-self-obj-okpo       = v-fmtcli-okpo
     1112       .
     1113   end.
     1114   end procedure.
     1115   procedure torgconf-get-recepient-param :
     1116   define input parameter torgconfdoc-code   as character                  no-undo.
     1117   define output parameter v-code-rec        as integer                    no-undo .
     1118   define output parameter v-type-rec        as character                  no-undo initial 'C':U.
     1119   define output parameter v-codefirm-rec    as integer                    no-undo .
     1120   define output parameter v-curcode-rec     as integer                    no-undo .
     1121        define variable  v-recipient-code  as character                  no-undo .
     1122        define variable  v-recipient       like ub.doc-attr.attr-value   no-undo.
     1123        define variable  v-trdcattr-type   as character                  no-undo initial 'C':U.
     1124   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input torgconfdoc-code ,
     1125                           input 'Recipient':U ,
     1126                          output v-recipient-code ,
     1127                          output v-trdcattr-type ) no-error .
     1128       if error-status :error then do:
     1129        message
     1130         vss-workfile vss-revision vss-description skip
     1131         "Ошибка при вызове процедуры tdat-val":U skip
     1132         "Документ: " torgconfdoc-code skip
     1133         "Атрибут: " 'Recipient':U skip
     1134         "Значение: " v-recipient skip
     1135         trim( error-status :get-message (1) ) skip
     1136         return-value skip
     1137         view-as alert-box error.
     1138       undo, return error return-value.
     1139       end.
     1140     assign
     1141       v-recipient  = v-recipient-code
     1142       v-type-rec = substring(v-recipient-code,1,3)
     1143       v-code-rec  = int(substring(v-recipient-code,4,15))
     1144       no-error
     1145     .
     1146     if v-type-rec = ? then v-type-rec = "" .
     1147     if v-code-rec  = ? then v-code-rec  =  0 .
     1148     end procedure.
