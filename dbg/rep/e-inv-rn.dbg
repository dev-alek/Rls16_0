      568   define new global shared variable g#library  as handle no-undo .
      569   define new global shared variable g#library2 as handle no-undo .
      570   define variable var-report-r-b as character no-undo .
      571   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      572   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      573     (output var-report-r-b
      574     )  .
      575   procedure proc-alt-shift-f2:
      576     if not ibs.th.gbl.gbl-var:rcode
      577   then
      578     run gbl\inidebug.p .
      579   end.
      580   procedure proc-alt-shift-f3:
      581     run gbl/prvssinf.p
      582       ( input this-procedure
      583       ) .
      584   end.
      585   define variable v-inform-launched as logical no-undo initial false .
      586   procedure proc-alt-shift-f4:
      587     define variable v-action as character no-undo .
      588     if v-inform-launched = false then do:
      589       assign
      590         v-inform-launched = true
      591       .
      592       run gbl/d-inform.w
      593         (  input self
      594         ,  input this-procedure
      595         , output v-action
      596         ) no-error .
      597       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      598       assign
      599         v-inform-launched = false
      600       .
      601     end.
      602   end.
      603   procedure proc-alt-f1:
      604     run gbl/corrhelp.p
      605       (input this-procedure
      606       ) .
      607   end .
      608   on alt-shift-f2 anywhere do:
      609     run proc-alt-shift-f2.
      610   end.
      611   on alt-shift-f3 anywhere do:
      612     run proc-alt-shift-f3 in this-procedure .
      613   end.
      614   on alt-shift-f4 anywhere do:
      615     run proc-alt-shift-f4 in this-procedure.
      616   end.
      617   on alt-f1 anywhere do:
      618     run proc-alt-f1 in this-procedure .
      619   end.
      620   define variable parParentProc as widget-handle no-undo .
      621   assign parParentProc = my-handle .
      622   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      623     define variable v-cntxt-db-num        as integer   no-undo .
      624     define variable v-cntxt-userid        as character no-undo .
      625     define variable v-cntxt-level         as character no-undo .
      626     define variable v-cntxt-host-code-obj as integer   no-undo .
      627     define variable v-cntxt-obj-type      as character no-undo .
      628     define variable v-cntxt-obj-code      as integer   no-undo .
      629     define variable v-cntxt-db-num-obj    as integer   no-undo .
      630     define variable v-cntxt-is-admin      as logical   no-undo .
      631   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      632     run mainmenu_getcntxt in parparentproc
      633       (output v-cntxt-db-num
      634       ,output v-cntxt-userid
      635       ,output v-cntxt-level
      636       ,output v-cntxt-host-code-obj
      637       ,output v-cntxt-obj-type
      638       ,output v-cntxt-obj-code
      639       ,output v-cntxt-db-num-obj
      640       ,output v-cntxt-is-admin
      641       ) .
      642   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      643   procedure factord :
      644     define input  parameter p-fact-date            as date    no-undo .
      645     define input  parameter p-fact-time            as integer no-undo .
      646     define input  parameter p-fact-num             as integer no-undo .
      647     define input  parameter p-shift-date           as date    no-undo .
      648     define input  parameter p-shift-num            as integer no-undo .
      649     define input  parameter p-shift-on             as logical no-undo .
      650     define output parameter p-fact-order           as decimal no-undo .
      651     define output parameter p-shift-end-fact-order as decimal no-undo .
      652     define output parameter p-day-end-fact-order   as decimal no-undo .
      653     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      654     if p-fact-date = ?
      655     then do:
      656       return error "Не указана фактическая дата" .
      657     end.
      658     define variable v-fact-date-num as integer no-undo .
      659     assign
      660       v-fact-date-num = integer(p-fact-date)
      661     .
      662     if p-fact-num = ?
      663     or p-fact-num = 0
      664     then do:
      665       return error "Не задан p-fact-num " + string(p-fact-num) .
      666     end.
      667     if p-fact-num < 0
      668     then do:
      669       return error "Отрицательный fact-num " + string(p-fact-num) .
      670     end.
      671     if p-fact-num >= 100000000
      672     then do:
      673       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      674     end.
      675     if p-shift-on = true
      676     then do:
      677       if p-shift-date = ?
      678       then do:
      679         return error "Не задана дата смены" .
      680       end.
      681       if p-shift-num = ?
      682       or p-shift-num = 0
      683       then do:
      684         return error "Не задан номер смены" .
      685       end.
      686     end.
      687     else do:
      688       assign
      689         p-shift-date = p-fact-date
      690         p-shift-num  = 24
      691       .
      692     end.
      693     define variable v-shift-offset as integer no-undo .
      694     if p-shift-date = p-fact-date
      695     then do:
      696       assign
      697         v-shift-offset = 1
      698       .
      699     end.
      700     if p-shift-date < p-fact-date
      701     then do:
      702       assign
      703         v-shift-offset = 0
      704       .
      705     end.
      706     if p-shift-date > p-fact-date
      707     then do:
      708       message
      709         vss-workfile vss-revision vss-description skip
      710         "Неправильная дата закрытия смены" skip
      711         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      712         view-as alert-box error .
      713       undo, return error
      714         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      715           ,string(p-fact-date, '99/99/9999':U)
      716           ,string(p-shift-date, '99/99/9999':U)
      717           )
      718       .
      719     end.
      720     if p-shift-num < 1
      721     or p-shift-num > 24
      722     then do:
      723       message
      724         vss-workfile vss-revision vss-description skip
      725         "Неправильный номер смены" skip
      726         "p-shift-num" p-shift-num skip
      727         view-as alert-box error .
      728       undo, return error return-value .
      729     end.
      730     assign
      731       p-fact-order           = v-fact-date-num
      732                              + v-shift-offset * 0.5
      733                              + p-shift-num    * 0.02 - 0.01
      734                              + p-fact-num     * 0.0000000001
      735       p-shift-end-fact-order = v-fact-date-num
      736                              + v-shift-offset * 0.5
      737                              + p-shift-num    * 0.02
      738       p-day-end-fact-order   = v-fact-date-num
      739                              + 0.99
      740     .
      741     if p-fact-order           <= v-fact-date-num
      742     or p-shift-end-fact-order <= v-fact-date-num
      743     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      744     or p-shift-end-fact-order >= p-day-end-fact-order
      745     then do:
      746       message
      747         vss-workfile vss-revision vss-description skip
      748         "Внутренняя ошибка при генерации фактического номера" skip
      749         "p-fact-date"            p-fact-date            skip
      750         "p-fact-time"            p-fact-time            skip
      751         "p-fact-num"             p-fact-num             skip
      752         "p-shift-date"           p-shift-date           skip
      753         "p-shift-num"            p-shift-num            skip
      754         "p-shift-on"             p-shift-on             skip
      755         "p-shift-end-fact-order" p-shift-end-fact-order skip
      756         "p-day-end-fact-order"   p-day-end-fact-order   skip
      757         "v-fact-date-num"        v-fact-date-num        skip
      758         view-as alert-box error .
      759       undo, return error return-value .
      760     end.
      761   end procedure.
      762   procedure day-begin-fact-order :
      763     define input  parameter p-fact-date            as date    no-undo .
      764     define output parameter p-day-begin-fact-order as decimal no-undo .
      765     do
      766     on error undo, return error return-value
      767     :
      768       if p-fact-date = ?
      769       then do:
      770         assign
      771           p-day-begin-fact-order = 0
      772         .
      773       end.
      774       else do:
      775         assign
      776           p-day-begin-fact-order = integer(p-fact-date)
      777         .
      778       end.
      779     end.
      780   end procedure.
      781   procedure factord-max-fact-order :
      782     define output parameter p-max-fact-order as decimal   no-undo .
      783     do
      784     on error undo, return error return-value
      785     :
      786       run day-begin-fact-order in this-procedure
      787         (input  date(1, 1, 5000)
      788         ,output p-max-fact-order
      789         ) .
      790     end.
      791   end procedure.
      792   procedure factord-cut-archive :
      793     define input  parameter p-obj-type             as character no-undo .
      794     define input  parameter p-obj-code             as integer   no-undo .
      795     define input  parameter p-fact-date            as date      no-undo .
      796     define output parameter p-shift-on             as logical   no-undo .
      797     define output parameter p-shift-date           as date      no-undo .
      798     define output parameter p-shift-num            as integer   no-undo .
      799     define output parameter p-day-end-fact-order   as decimal   no-undo .
      800     define output parameter p-shift-end-fact-order as decimal   no-undo .
      801     define variable v-fact-order as decimal   no-undo .
      802     define buffer buf_shift-obj for ub.shift-obj .
      803     do
      804     on error undo, return error return-value
      805     :
      806   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      807   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      808     (input  p-obj-type
      809     ,input  p-obj-code
      810     ,input  'shift-on=request'
      811     ,output p-shift-on
      812     ) no-error .
      813       if error-status :error
      814       then do:
      815         message
      816           vss-workfile vss-revision vss-description skip
      817           "Ошибка при определении атрибута объекта" skip
      818           "Объект" p-obj-type p-obj-code skip
      819           error-status :get-message(1) skip
      820           return-value skip
      821           view-as alert-box error .
      822         undo, return error return-value .
      823       end.
      824       if p-shift-on = false
      825       then do:
      826         assign
      827           p-shift-date               = ?
      828           p-shift-num                = 0
      829         .
      830       end.
      831       else do:
      832         find first buf_shift-obj share-lock
      833           where buf_shift-obj.obj-type   = p-obj-type
      834             and buf_shift-obj.obj-code   = p-obj-code
      835             and buf_shift-obj.shift-date > p-fact-date
      836           use-index pi
      837           no-error .
      838         if not available buf_shift-obj
      839         or buf_shift-obj.status_ <> 'зкр':U
      840         then do:
      841           message
      842             vss-workfile vss-revision vss-description skip
      843             "Невозможно вычислить последнюю смену" skip
      844             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      845             "Объект" p-obj-type p-obj-code skip
      846             "Дата" p-fact-date skip
      847             view-as alert-box error .
      848           undo, return error return-value .
      849         end.
      850         find last buf_shift-obj share-lock
      851           where buf_shift-obj.obj-type = p-obj-type
      852             and buf_shift-obj.obj-code = p-obj-code
      853             and buf_shift-obj.shift-date <= p-fact-date
      854           use-index pi
      855           no-error .
      856         if available buf_shift-obj
      857         then do:
      858           if  buf_shift-obj.status_ = 'зкр':U
      859           then do:
      860             assign
      861               p-shift-date = buf_shift-obj.shift-date
      862               p-shift-num  = buf_shift-obj.shift-num
      863             .
      864           end.
      865           else do:
      866             message
      867               vss-workfile vss-revision vss-description skip
      868               "Невозможно вычислить последнюю смену" skip
      869               "Статус смены отличен от статуса" 'зкр':U skip
      870               "Объект" p-obj-type p-obj-code skip
      871               "Дата" p-fact-date skip
      872               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      873               view-as alert-box error .
      874             undo, return error return-value .
      875           end.
      876         end.
      877         else do:
      878           assign
      879             p-shift-date = p-fact-date - 1
      880             p-shift-num  = 1
      881           .
      882         end.
      883       end.
      884       run factord in this-procedure
      885         (input  p-fact-date
      886         ,input  1
      887         ,input  1
      888         ,input  p-shift-date
      889         ,input  p-shift-num
      890         ,input  p-shift-on
      891         ,output v-fact-order
      892         ,output p-shift-end-fact-order
      893         ,output p-day-end-fact-order
      894         ) no-error .
      895       if error-status :error
      896       then do:
      897         message
      898           vss-workfile vss-revision vss-description skip
      899           "Ошибка при вызове процедуры factord"
      900           error-status :get-message(1) skip
      901           return-value skip
      902           view-as alert-box error .
      903         undo, return error return-value .
      904       end.
      905     end.
      906   end procedure.
      907   procedure factord-lock-shift :
      908     define input  parameter p-obj-type  as character no-undo .
      909     define input  parameter p-obj-code  as integer   no-undo .
      910     define input  parameter p-fact-date as date      no-undo .
      911     define parameter buffer buf_shift-obj for ub.shift-obj .
      912     define variable v-shift-on      as logical   no-undo .
      913     define variable v-extra-message as character no-undo .
      914     define variable v-error as character no-undo .
      915     do
      916     on error undo, return error return-value
      917     :
      918   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      919   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      920     (input  p-obj-type
      921     ,input  p-obj-code
      922     ,input  'shift-on=request'
      923     ,output v-shift-on
      924     ) no-error .
      925       if error-status :error
      926       then do:
      927         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
      928         undo, return error v-error .
      929       end.
      930       if v-shift-on = true
      931       then do:
      932         find first buf_shift-obj share-lock
      933           where buf_shift-obj.obj-type   = p-obj-type
      934             and buf_shift-obj.obj-code   = p-obj-code
      935             and buf_shift-obj.shift-date > p-fact-date
      936           use-index pi
      937           no-error .
      938         if not available buf_shift-obj
      939         or buf_shift-obj.status_ <> 'зкр':U
      940         then do:
      941           find last buf_shift-obj
      942             where buf_shift-obj.obj-type = p-obj-type
      943               and buf_shift-obj.obj-code = p-obj-code
      944               and buf_shift-obj.status_  = 'зкр':U
      945             use-index stts
      946             no-error .
      947           if available buf_shift-obj
      948           then do:
      949             assign
      950               v-extra-message =
      951                     substitute("Дата начала последеней закрытой смены на объекте &1"
      952                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
      953                               )
      954             .
      955           end.
      956           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
      957           undo, return error v-error .
      958         end.
      959       end.
      960     end.
      961   end procedure.
      962   procedure factord-end-day :
      963     define input  parameter p-fact-date            as date    no-undo .
      964     define output parameter p-day-end-fact-order   as decimal no-undo .
      965     do
      966     on error undo, return error return-value
      967     :
      968       if p-fact-date = ?
      969       then do:
      970         return error "Не указана фактическая дата" .
      971       end.
      972       assign
      973         p-day-end-fact-order = integer(p-fact-date) + 0.99
      974       .
      975     end.
      976   end procedure.
      977   procedure factord-to-date :
      978     define input  parameter p-fact-order as decimal no-undo .
      979     define output parameter p-fact-date  as date    no-undo .
      980     define variable v-ref-date  as date      no-undo .
      981     define variable v-ref-delta as integer   no-undo .
      982     do
      983     on error undo, return error return-value
      984     :
      985       if p-fact-order = ?
      986       or p-fact-order = 0
      987       then do:
      988         return error "Не указан fact-order" .
      989       end.
      990       assign
      991         v-ref-date  = date(1, 1, 2000)
      992       .
      993       assign
      994         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
      995       .
      996       assign
      997         p-fact-date = v-ref-date + v-ref-delta
      998       .
      999     end.
     1000   end procedure.
     1001   procedure factord-to-fact-num :
     1002     define input  parameter p-fact-order as decimal no-undo .
     1003     define output parameter p-fact-num   as integer no-undo .
     1004     define variable v-fact-order-trunc as decimal no-undo .
     1005     do
     1006     on error undo, return error return-value
     1007     :
     1008       if p-fact-order = ?
     1009       or p-fact-order = 0
     1010       then do:
     1011         return error "Не указан fact-order" .
     1012       end.
     1013       assign
     1014        v-fact-order-trunc = truncate(p-fact-order, 2)
     1015       .
     1016       assign
     1017         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     1018       .
     1019     end.
     1020   end procedure.
     1021   procedure factord-to-shift-num :
     1022     define input  parameter p-fact-order as decimal no-undo .
     1023     define output parameter p-shift-num   as integer no-undo .
     1024     define variable  p-shift-numd  as decimal   no-undo .
     1025     define variable v-fact-order-trunc as decimal no-undo .
     1026     do
     1027     on error undo, return error return-value
     1028     :
     1029       if p-fact-order = ?
     1030       or p-fact-order = 0
     1031       then do:
     1032         return error "Не указан fact-order" .
     1033       end.
     1034       assign
     1035        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     1036       .
     1037       if v-fact-order-trunc < 0.5 then do:
     1038         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     1039       end.
     1040       assign
     1041         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     1042         .
     1043        assign
     1044         p-shift-num = truncate (p-shift-numd , 0)
     1045       .
     1046     end.
     1047   end procedure.
