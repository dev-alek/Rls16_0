     1387   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
     1388   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
     1389   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
     1390   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
     1391   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
     1392   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
     1393   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
     1394   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
     1395         adm-object-hdl = FRAME F-Main:HANDLE.
     1396   RUN ensure-broker.
     1397   THIS-PROCEDURE:ADM-DATA =
     1398        'ADM1.1~`':U +
     1399        'SmartObject~`':U +
     1400        '~`':U +
     1401        'NO ~`':U +
     1402        '~`':U +
     1403        '~`':U +
     1404        '~`':U +
     1405        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
     1406           + "~`":U +
     1407        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add~`':U +
     1408        'Record-Source,Record-Target,TableIO-Target~`':U +
     1409        '~`':U +
     1410        '~`~`~`~`~`~`~`~`~`~`~`':U +
     1411        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
     1412            THEN "^^":U
     1413        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
     1414             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
     1415   PROCEDURE adm-apply-entry :
     1416     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1417   END PROCEDURE.
     1418   PROCEDURE adm-destroy :
     1419    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1420   END PROCEDURE.
     1421   PROCEDURE adm-disable :
     1422       DISABLE RECT-8 RECT-9 inv-shift-start inv-shift-end BUTTON-Shift-end BUTTON-Shift-Start inv-date-start inv-date-end tog-only-itog WITH FRAME F-Main.
     1423       RUN dispatch ('disable-fields':U).
     1424       RUN set-attribute-list ('ENABLED=no':U).
     1425       RETURN.
     1426   END PROCEDURE.
     1427   PROCEDURE adm-edit-attribute-list :
     1428         RUN adm/support/viewerd.w (INPUT THIS-PROCEDURE).
     1429         RETURN.
     1430   END PROCEDURE.
     1431   PROCEDURE adm-enable :
     1432       ENABLE UNLESS-HIDDEN RECT-8 RECT-9 inv-shift-start inv-shift-end BUTTON-Shift-end BUTTON-Shift-Start inv-date-start inv-date-end tog-only-itog WITH FRAME F-Main.
     1433       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
     1434       RUN set-attribute-list ('ENABLED=yes':U).
     1435       RETURN.
     1436   END PROCEDURE.
     1437   PROCEDURE adm-exit :
     1438        RUN notify ('exit':U).
     1439     RETURN.
     1440   END PROCEDURE.
     1441   PROCEDURE adm-hide :
     1442     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1443   END PROCEDURE.
     1444   PROCEDURE adm-initialize :
     1445     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1446   END PROCEDURE.
     1447   PROCEDURE adm-show-errors :
     1448       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
     1449       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
     1450           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
     1451       END.
     1452       RETURN.
     1453   END PROCEDURE.
     1454   PROCEDURE adm-UIB-mode :
     1455     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1456   END PROCEDURE.
     1457   PROCEDURE adm-view :
     1458     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1459   END PROCEDURE.
     1460   PROCEDURE dispatch :
     1461       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
     1462       RUN broker-dispatch IN adm-broker-hdl
     1463           (THIS-PROCEDURE, p-method-name) NO-ERROR.
     1464       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
     1465   END PROCEDURE.
     1466   PROCEDURE ensure-broker :
     1467   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
     1468   IF RETURN-VALUE NE "ADM-Broker":U THEN
     1469   DO:
     1470       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
     1471       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
     1472   END.
     1473   END PROCEDURE.
     1474   PROCEDURE get-attribute :
     1475     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
     1476     RUN broker-get-attribute IN adm-broker-hdl
     1477         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
     1478     RETURN RETURN-VALUE.
     1479   END PROCEDURE.
     1480   PROCEDURE get-attribute-list :
     1481     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
     1482     RUN broker-get-attribute-list IN adm-broker-hdl
     1483         (INPUT THIS-PROCEDURE,
     1484          INPUT ?,
     1485          OUTPUT p-attr-list) NO-ERROR.
     1486     RETURN.
     1487   END PROCEDURE.
     1488   PROCEDURE new-state :
     1489     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     1490     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
     1491     RETURN.
     1492   END PROCEDURE.
     1493   PROCEDURE notify :
     1494     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
     1495     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
     1496     IF RETURN-VALUE = "ADM-ERROR":U THEN
     1497         RETURN "ADM-ERROR":U.
     1498     RETURN.
     1499   END PROCEDURE.
     1500   PROCEDURE set-attribute-list :
     1501     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
     1502     RUN ensure-broker.
     1503     RUN broker-set-attribute-list IN adm-broker-hdl
     1504         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
     1505     RETURN.
     1506   END PROCEDURE.
     1507   PROCEDURE set-position :
     1508       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
     1509       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
     1510       IF VALID-HANDLE(adm-object-hdl) THEN
     1511       DO:
     1512         ASSIGN adm-object-hdl:ROW    =   p-row
     1513                adm-object-hdl:COLUMN =   p-col.
     1514       END.
     1515       RETURN.
     1516   END PROCEDURE.
     1517   PROCEDURE adm-display-fields :
     1518       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
     1519       RETURN.
     1520   END PROCEDURE.
     1521   PROCEDURE adm-open-query :
     1522     RETURN.
     1523   END PROCEDURE.
     1524   PROCEDURE adm-row-changed :
     1525         IF VALID-HANDLE(adm-object-hdl) THEN
     1526           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     1527         RUN notify ('row-available':U).
     1528         RETURN.
     1529   END PROCEDURE.
     1530   PROCEDURE reposition-query :
     1531       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
     1532       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
     1533       RETURN.
     1534   END PROCEDURE.
     1535     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
     1536     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
     1537     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
     1538     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
     1539     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
     1540     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
     1541     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
     1542     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
     1543     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1544     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
     1545     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1546     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
     1547     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
     1548     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
     1549     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
     1550     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
     1551     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
     1552     IF "":U = "":U THEN
     1553       RUN modify-list-attribute IN adm-broker-hdl
     1554         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
     1555     RUN use-create-on-add(?).
     1556   PROCEDURE adm-add-record :
     1557       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     1558          "must have at least one Enabled Table to perform Add.":U
     1559          VIEW-AS ALERT-BOX ERROR.
     1560       RETURN.
     1561   END PROCEDURE.
     1562   PROCEDURE adm-assign-record :
     1563    MESSAGE
     1564          "Object ":U THIS-PROCEDURE:FILE-NAME
     1565            "must have at least one Enabled Table to perform Assign.":U
     1566              VIEW-AS ALERT-BOX ERROR.
     1567      RETURN.
     1568     END PROCEDURE.
     1569   PROCEDURE adm-assign-statement :
     1570     RETURN.
     1571   END PROCEDURE.
     1572   PROCEDURE adm-cancel-record :
     1573      RETURN.
     1574     END PROCEDURE.
     1575   PROCEDURE adm-copy-record :
     1576       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     1577        "must have at least one Enabled Table to perform Copy.":U
     1578          VIEW-AS ALERT-BOX ERROR.
     1579       RETURN.
     1580   END PROCEDURE.
     1581   PROCEDURE adm-create-record :
     1582      RETURN.
     1583   END PROCEDURE.
     1584   PROCEDURE adm-current-changed :
     1585     RETURN.
     1586   END PROCEDURE.
     1587   PROCEDURE adm-delete-record :
     1588    MESSAGE
     1589          "Object ":U THIS-PROCEDURE:FILE-NAME
     1590            "must have at least one Enabled Table to perform Delete.":U
     1591              VIEW-AS ALERT-BOX ERROR.
     1592       RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
     1593       RETURN.
     1594   END PROCEDURE.
     1595   PROCEDURE adm-disable-fields :
     1596         RUN notify ('disable-fields, GROUP-ASSIGN-TARGET':U).
     1597       RETURN.
     1598   END PROCEDURE.
     1599   PROCEDURE adm-enable-fields :
     1600       RETURN.
     1601   END PROCEDURE.
     1602   PROCEDURE adm-end-update :
     1603     RETURN.
     1604   END PROCEDURE.
     1605   PROCEDURE adm-reset-record :
     1606       RETURN.
     1607   END PROCEDURE.
     1608   PROCEDURE adm-update-record :
     1609       MESSAGE
     1610         "Object ":U THIS-PROCEDURE:FILE-NAME
     1611           "must have at least one Enabled Table to perform Update.":U
     1612             VIEW-AS ALERT-BOX ERROR.
     1613      RETURN.
     1614   END PROCEDURE.
     1615   PROCEDURE check-modified :
     1616   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
     1617   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
     1618   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
     1619   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
     1620     IF check-state = "check":U THEN
     1621     DO:
     1622       RUN get-link-handle IN adm-broker-hdl
     1623         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
     1624            OUTPUT group-target-list).
     1625       IF group-target-list NE "":U THEN
     1626       DO i = 1 TO NUM-ENTRIES(group-target-list):
     1627         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
     1628         RUN check-modified IN curr-widget ('group-check':U).
     1629         IF RETURN-VALUE NE "":U THEN
     1630         DO:
     1631           RUN check-modified-message(RETURN-VALUE).
     1632           RETURN "":U.
     1633         END.
     1634       END.
     1635     END.
     1636     RETURN "":U.
     1637   END PROCEDURE.
     1638   PROCEDURE check-modified-message :
     1639     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
     1640        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
     1641           'CONTAINER-SOURCE':U, 'HIDDEN':U).
     1642        IF RETURN-VALUE = "YES":U THEN
     1643           RUN notify ('view,CONTAINER-SOURCE':U).
     1644        MESSAGE IF p-changed-table NE ? THEN
     1645           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
     1646           ELSE "Current values have been changed."
     1647           SKIP "  Do you wish to save those changes?"
     1648           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
     1649        IF ANS THEN
     1650        DO:
     1651           IF group-assign-target THEN
     1652             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
     1653           ELSE RUN dispatch('update-record':U).
     1654           IF RETURN-VALUE = "ADM-ERROR":U THEN
     1655           DO:
     1656               MESSAGE "Changes to the previous record were not saved."
     1657                 VIEW-AS ALERT-BOX ERROR.
     1658               IF group-assign-target THEN
     1659                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1660               ELSE RUN dispatch ('cancel-record':U).
     1661           END.
     1662        END.
     1663        ELSE DO:
     1664          IF group-assign-target THEN
     1665             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1666          ELSE RUN dispatch('cancel-record':U).
     1667        END.
     1668        RETURN.
     1669   END PROCEDURE.
     1670   PROCEDURE get-rowid :
     1671       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
     1672       ASSIGN
     1673       p-table   =   adm-first-table.
     1674       RETURN.
     1675   END PROCEDURE.
     1676   PROCEDURE init-group-assign :
     1677       RUN request-attribute IN adm-broker-hdl
     1678         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
     1679       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
     1680         group-assign-target = yes.
     1681       ELSE group-assign-target = no.
     1682       RETURN.
     1683   END PROCEDURE.
     1684   PROCEDURE set-editors :
     1685       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
     1686       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
     1687       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
     1688       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
     1689       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
     1690       DO WHILE VALID-HANDLE (curr-widget):
     1691           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
     1692              curr-widget:HIDDEN = no THEN DO:
     1693             CASE p-field-setting:
     1694               WHEN "INITIALIZE":U THEN
     1695               DO:
     1696                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
     1697                     read-only-list +
     1698                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
     1699                        STRING(curr-widget).
     1700               END.
     1701               WHEN "DISABLE":U OR
     1702               WHEN "ENABLE":U THEN
     1703               DO:
     1704                   curr-widget:SENSITIVE = yes.
     1705                   RUN get-attribute ('Read-Only-Editors':U).
     1706                   IF RETURN-VALUE = ? OR
     1707                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
     1708                       curr-widget:READ-ONLY =
     1709                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
     1710               END.
     1711               WHEN "CLEAR":U THEN
     1712                   curr-widget:SCREEN-VALUE = "":U.
     1713             END CASE.
     1714           END.
     1715           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
     1716       END.
     1717       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
     1718         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
     1719           + '"':U).
     1720       RETURN.
     1721   END PROCEDURE.
     1722   PROCEDURE use-check-modified-all :
     1723    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1724     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
     1725     RETURN.
     1726   END PROCEDURE.
     1727   PROCEDURE use-create-on-add :
     1728   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1729      RETURN.
     1730   END PROCEDURE.
     1731   PROCEDURE use-initial-lock :
     1732     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1733     ASSIGN adm-initial-lock = p-attr-value.
     1734     RETURN.
     1735   END PROCEDURE.
     1736     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
     1737   ASSIGN
     1738          FRAME F-Main:SCROLLABLE       = FALSE
     1739          FRAME F-Main:HIDDEN           = TRUE.
     1740   ON CHOOSE OF BUTTON-Shift-end IN FRAME F-Main
     1741   DO:
     1742     define variable v-doc-rec as recid no-undo .
     1743     define variable rec-list-2      as char no-undo.
     1744     IF  X-SelectObject = "currency":U then do:
     1745       find first shift-obj No-LOCK WHERE
     1746                 shift-obj.shift-date = inv-date-end AND
     1747                 shift-obj.shift-num = inv-shift-end AND
     1748                 shift-obj.obj-type = v-cntxt-obj-type AND
     1749                 shift-obj.obj-code = v-cntxt-obj-code No-ERROR.
     1750       if avail shift-obj then
     1751       rec-list-2 = string(recid(shift-obj)).
     1752     end.
     1753     IF  X-SelectObject = "currency":U
     1754     then do:
     1755         run str/sht-all.w
     1756         (             input my-handle
     1757                      ,input v-cntxt-obj-type
     1758                      ,input v-cntxt-obj-code
     1759                      ,input  "b-sel"
     1760                      ,input "obj":U
     1761                      ,input v-cntxt-obj-type
     1762                      ,input v-cntxt-obj-code
     1763                      ,input ReportProc
     1764                      ,input-output rec-list-2 ).
     1765     end.
     1766     Else do:
     1767         run str/sht-all.w
     1768         (             input my-handle
     1769                      ,input v-cntxt-obj-type
     1770                      ,input v-cntxt-obj-code
     1771                      ,input  "b-sel"
     1772                      ,input "all":U
     1773                      ,input '':U
     1774                      ,input 0
     1775                      ,input ReportProc
     1776                      ,input-output rec-list-2 ).
     1777       end.
     1778       find shift-obj where recid (shift-obj) = integer (entry(1,rec-list-2))  no-lock no-error.
     1779       if AVAILABLE  shift-obj then DO:
     1780          Assign
     1781           inv-date-end  = shift-obj.shift-date
     1782           inv-shift-end = shift-obj.shift-num.
     1783            enable inv-date-end  inv-shift-end with frame F-Main.
     1784          Display inv-date-end  inv-shift-end with frame F-Main.
     1785           apply "leave" to inv-shift-end .
     1786           apply "leave" to inv-date-end .
     1787       End.
     1788    END.
     1789   ON CHOOSE OF BUTTON-Shift-Start IN FRAME F-Main
     1790   DO:
     1791     define variable v-doc-rec as recid no-undo .
     1792     define variable rec-list-2      as char no-undo.
     1793     IF  X-SelectObject = "currency":U then do:
     1794       find first shift-obj No-LOCK WHERE
     1795                 shift-obj.shift-date = inv-date-start AND
     1796                 shift-obj.shift-num = inv-shift-start AND
     1797                 shift-obj.obj-type = v-cntxt-obj-type AND
     1798                 shift-obj.obj-code = v-cntxt-obj-code No-ERROR.
     1799       if avail shift-obj then
     1800       rec-list-2 = string(recid(shift-obj)).
     1801     end.
     1802     IF  X-SelectObject = "currency":U
     1803     then do:
     1804         run str/sht-all.w
     1805         (             input my-handle
     1806                      ,input v-cntxt-obj-type
     1807                      ,input v-cntxt-obj-code
     1808                      ,input  "b-sel"
     1809                      ,input "obj":U
     1810                      ,input v-cntxt-obj-type
     1811                      ,input v-cntxt-obj-code
     1812                      ,input ReportProc
     1813                      ,input-output rec-list-2 ).
     1814     end.
     1815     Else do:
     1816         run str/sht-all.w
     1817         (             input my-handle
     1818                      ,input v-cntxt-obj-type
     1819                      ,input v-cntxt-obj-code
     1820                      ,input  "b-sel"
     1821                      ,input "all":U
     1822                      ,input '':U
     1823                      ,input 0
     1824                      ,input ReportProc
     1825                      ,input-output rec-list-2 ).
     1826       end.
     1827       find shift-obj where recid (shift-obj) = integer (entry(1,rec-list-2))  no-lock no-error.
     1828       if AVAILABLE  shift-obj then DO:
     1829          Assign
     1830           inv-date-start  = shift-obj.shift-date
     1831           inv-shift-start = shift-obj.shift-num.
     1832            enable inv-date-start  inv-shift-start with frame F-Main.
     1833          Display inv-date-start  inv-shift-start with frame F-Main.
     1834           apply "leave" to inv-shift-start .
     1835           apply "leave" to inv-date-start .
     1836       End.
     1837    END.
     1838   ON LEAVE OF inv-Date-End IN FRAME F-Main
     1839   DO:
     1840       Assign  inv-Date-End no-error.
     1841       run verify-date in this-procedure .
     1842   END.
     1843   ON LEAVE OF inv-Date-Start IN FRAME F-Main
     1844   DO:
     1845       Assign  inv-Date-Start no-error.
     1846   END.
     1847   ON LEAVE OF inv-Shift-End IN FRAME F-Main
     1848   DO:
     1849     Assign inv-Shift-End.
     1850   END.
     1851   ON LEAVE OF inv-Shift-Start IN FRAME F-Main
     1852   DO:
     1853     Assign inv-Shift-Start.
     1854   END.
     1855   if not this-procedure :persistent
     1856   then do:
     1857     message
     1858       vss-workfile vss-revision vss-description skip
     1859       "Ошибка при запуске процедуры" skip
     1860       "Данную процедуру следует запускать только с параметром persistent" skip
     1861       view-as alert-box error .
     1862     undo, return error .
     1863   end.
     1864     run enable_UI in this-procedure .
     1865   PROCEDURE disable_UI :
     1866     HIDE FRAME F-Main.
     1867     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1868   END PROCEDURE.
     1869   PROCEDURE enable_UI :
     1870   assign
     1871       inv-date-start  = TODAY
     1872       inv-date-end    = TODAY
     1873       inv-shift-start = 0
     1874       inv-shift-end   = 0
     1875     .
     1876     display inv-date-start inv-date-end inv-shift-start inv-shift-end with frame F-Main .
     1877   END PROCEDURE.
     1878   PROCEDURE verify-date :
     1879   if Date(inv-Date-End:screen-value In frame F-Main) < DATE(inv-Date-Start:screen-value In frame F-Main) then DO:
     1880      message "Интервал дат введен неверно !" view-as alert-box error TITLE "О Ш И Б К А !!!".
     1881      Return error.
     1882   End.
     1883   END PROCEDURE.
     1884   PROCEDURE local-apply-layout :
     1885     RUN dispatch IN THIS-PROCEDURE ( INPUT 'apply-layout':U ) .
     1886   END PROCEDURE.
     1887   PROCEDURE my-report :
     1888         define variable v-db-num as integer   no-undo .
     1889         define buffer buf_db  for ub.db .
     1890         define buffer buf_clients for ub.clients .
     1891         define variable v-recalc-date as date no-undo .
     1892   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1893   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     1894     (output v-db-num
     1895     )  .
     1896         for each buf_db no-lock
     1897           where v-db-num = 0
     1898              or (v-db-num <> 0
     1899                  and buf_db.db-num = v-db-num
     1900                 )
     1901         on error undo, return error
     1902         :
     1903           for each buf_clients no-lock
     1904             where buf_clients.db-num = buf_db.db-num
     1905           on error undo, return error
     1906           :
     1907             define buffer lock_shift-obj for ub.shift-obj .
     1908             run factord-lock-shift in this-procedure
     1909               (input  buf_clients.obj-type
     1910               ,input  buf_clients.obj-code
     1911               ,input  0
     1912               ,buffer lock_shift-obj
     1913               ) no-error .
     1914             if error-status :error  then do:
     1915               next.
     1916             end.
     1917             define variable v-attr-arh-del-chr  as character no-undo .
     1918             define variable v-attr-arh-del-type as character no-undo .
     1919             define variable v-attr-arh-del      as logical   no-undo .
     1920             run clntattr-value in this-procedure
     1921               (input  buf_clients.obj-type
     1922               ,input  buf_clients.obj-code
     1923               ,input  'arh-del':U
     1924               ,output v-attr-arh-del-chr
     1925               ,output v-attr-arh-del-type
     1926               ).
     1927             assign
     1928               v-attr-arh-del = lookup(v-attr-arh-del-chr, 'yes,true':u) > 0
     1929             .
     1930             if  v-attr-arh-del <> true
     1931             and buf_clients.stts = 0
     1932             then do:
     1933               run trg/calcarh.p
     1934                 (input buf_clients.obj-type
     1935                 ,input buf_clients.obj-code
     1936                 ,input ?
     1937                 ,input false
     1938                 ,input inv-date-end
     1939                 ,input true
     1940                 ,input v-cntxt-db-num
     1941                 ,input v-cntxt-userid
     1942                 ) no-error .
     1943               if error-status :error
     1944               then do:
     1945                 message
     1946                   vss-workfile vss-revision vss-description skip
     1947                   "Ошибка при расчете складского архива по товарам" skip
     1948                   "Объект" buf_clients.obj-type buf_clients.obj-code skip
     1949                   "Информацию о рассчитанных объектах можно посмотреть в файле"
     1950                   "objarh.log" skip
     1951                   "или в АРМ Администратор" skip
     1952                   "Утилиты/Работа с архивами/Информация о складских архивах" skip
     1953                   error-status :get-message(1) skip
     1954                   return-value skip
     1955                   view-as alert-box error .
     1956                 undo, return error .
     1957               end.
     1958             end.
     1959           end.
     1960         end.
     1961   run rep/r-inv-RN.p (input my-handle, input tog-only-itog, input inv-date-start, input inv-date-end, input inv-shift-start, input inv-shift-end) .
     1962   END PROCEDURE.
     1963   PROCEDURE my-var :
     1964     Assign frame F-Main inv-date-start inv-date-end tog-only-itog .
     1965   END PROCEDURE.
     1966   PROCEDURE state-changed :
     1967     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE    NO-UNDO.
     1968     DEFINE INPUT PARAMETER p-state      AS CHARACTER NO-UNDO.
     1969     CASE p-state:
     1970       when "link-changed":U then  DO:
     1971            Run my-var.
     1972            End.
     1973     END CASE.
     1974   END PROCEDURE.
