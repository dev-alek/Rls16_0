     1881     end.
     1882     assign
     1883      price-cli-with-tax-loc = buf_parts.price-cli
     1884      cli-base-rate          = buf_parts.cli-base-rate.
     1885     ASSIGN   road-tax-base-loc  = (if buf_parts.road-tax-base  = ? then 0 else buf_parts.road-tax-base)
     1886              road-tax-rubl-loc  = (if buf_parts.road-tax-rubl  = ? then 0 else buf_parts.road-tax-rubl).
     1887     ASSIGN  transport-base-loc = (if buf_parts.transport-base = ? then 0 else buf_parts.transport-base)
     1888             transport-rubl-loc = (if buf_parts.transport-rubl = ? then 0 else buf_parts.transport-rubl)
     1889             other-base-loc     = (if buf_parts.other-base     = ? then 0 else buf_parts.other-base)
