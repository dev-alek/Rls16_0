        1   block-level on error undo, throw.
        2   define input parameter p-mainmenu-handle    as handle           no-undo.
        3   define input parameter p-fbr-doc-recid      as recid            no-undo.
        4   define input parameter p-print-in-rubl      as logical          no-undo.
        5   define input parameter p-print-details      as logical          no-undo.
        6   define input parameter p-fat                as logical          no-undo.
        7   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        8   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        9   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       10   define variable vss-workfile    as character no-undo init "$Workfile: fbr-actp.p $":U .
       11   define variable vss-archive     as character no-undo init "$Archive: rep/fbr-actp.p $":U .
       12   define variable vss-description as character no-undo init "Акт производства промежуточных ингредиентов".
       13   procedure vss-get-info :
       14     define output parameter p-vss-revision    like vss-revision    no-undo .
       15     define output parameter p-vss-author      like vss-author      no-undo .
       16     define output parameter p-vss-date        like vss-date        no-undo .
       17     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       18     define output parameter p-vss-archive     like vss-archive     no-undo .
       19     define output parameter p-vss-description like vss-description no-undo .
       20     assign
       21       p-vss-revision    = vss-revision
       22       p-vss-author      = vss-author
       23       p-vss-date        = vss-date
       24       p-vss-workfile    = vss-workfile
       25       p-vss-archive     = vss-archive
       26       p-vss-description = vss-description
       27     .
       28   end procedure.
       29   procedure vss-get-parameters :
       30     define output parameter p-vss-parameters as character no-undo .
       31   end procedure.
       32   define new global shared variable g#vssrevis-logger as handle    no-undo .
       33   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       34   define variable v-vssrevis-logger                   as handle    no-undo .
       35   procedure vss-logevent :
       36     define input  parameter p-extra-paramters as character no-undo .
       37     define variable v-vssrevis-parameters as character no-undo .
       38     do
       39     on error undo, return error return-value
       40     :
       41       if  valid-handle(v-vssrevis-logger)
       42       and v-vssrevis-logger :get-signature("logevent") <> ""
       43       then do:
       44         run vss-get-parameters in this-procedure
       45           (output v-vssrevis-parameters
       46           ).
       47         run logevent in v-vssrevis-logger
       48           (input vss-workfile
       49           ,input vss-revision
       50           ,input v-vssrevis-parameters
       51           ,input p-extra-paramters
       52           ).
       53       end.
       54     end.
       55   end procedure.
       56   assign
       57     v-vssrevis-logger = g#vssrevis-logger
       58   .
       59   if  valid-handle(v-vssrevis-logger)
       60   and v-vssrevis-logger :get-signature("logevent") <> ""
       61   then do:
       62     assign
       63       v-vssrevis-logevent = true
       64     .
       65     run vss-logevent in this-procedure (input vss-description) .
       66   end.
       67   define new global shared variable g#language as character no-undo .
       68   if g#language <> '' and g#language <> 'rus':U then do:
       69     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       70   end.
       71   define new global shared variable g#library  as handle no-undo .
       72   define new global shared variable g#library2 as handle no-undo .
       73   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       74   define  shared variable PrintCopiesCounter as integer   no-undo initial 1 .
       75   define  shared variable RepPathName        as character no-undo .
       76   define  shared variable PrintRubl          as logical   no-undo .
       77   define variable vss-include-info1 as character format "X(65)" no-undo
       78   initial "@(#)$Workfile$ $Revision$".
       79   define temp-table temp_p-fmt_string-part no-undo
       80       field str-key       as integer
       81       field string-part   as character
       82       index pi is primary unique
       83           str-key
       84   .
       85   define variable v-p-fmt-1-str-key    as integer      no-undo.
       86   FUNCTION center-field RETURNS INTEGER (INPUT iStartPix AS INTEGER, iEndPix AS INTEGER,
       87                                     iInput AS INTEGER).
       88     def var v-start-print as integer no-undo .
       89     if (iStartPix < 0) or (iEndPix < iStartPix) then return 0.
       90     assign
       91       v-start-print = INTEGER(iStartPix + ((iEndPix - iStartPix) / 2) - (iInput / 2))
       92     .
       93     RETURN v-start-print .
       94   END FUNCTION.
       95   FUNCTION right-field RETURNS INTEGER ( iEndPix AS INTEGER,
       96                                     iInput AS INTEGER).
       97     def var v-start-print as integer no-undo .
       98     assign
       99       v-start-print = INTEGER(iEndPix - 1 - iInput)
      100     .
      101     if v-start-print < 0 then return 0.
      102     RETURN v-start-print .
      103   END FUNCTION.
      104   function p-fmt-align-string returns character (
      105         p-in-string      as character
      106       , p-page-width     as integer
      107       , p-align-type     as character
      108   ).
      109       define variable v-string-length     as integer      no-undo.
      110       define variable v-out-string        as character    no-undo.
      111       assign
      112           v-string-length = length( trim( p-in-string ) )
      113       .
      114       if v-string-length >= p-page-width
      115       then do:
      116           assign
      117               v-out-string = trim( p-in-string )
      118           .
      119       end.
      120       else do:
      121           case p-align-type
      122           :
      123               when 'left':U
      124               then do:
      125                   assign
      126                       v-out-string = trim( p-in-string )
      127                   .
      128               end.
      129               when 'right':U
      130               then do:
      131                   assign
      132                       v-out-string = fill( " ":U, p-page-width - v-string-length ) + trim( p-in-string )
      133                   .
      134               end.
      135               when 'center':U
      136               then do:
      137                   assign
      138                       v-out-string = fill( " ":U, integer( ( p-page-width - v-string-length ) / 2 ) ) + trim( p-in-string )
      139                   .
      140               end.
      141           end case.
      142       end.
      143       return v-out-string .
      144   end function.
      145   procedure p-fmt-split-string :
      146   define input parameter p-source-string  as character        no-undo.
      147   define input parameter p-split-length   as integer          no-undo.
      148   define output parameter p-string-1      as character        no-undo.
      149   define output parameter p-string-2      as character        no-undo.
      150   do
      151   on error undo, return error
      152   :
      153       define variable v-space-pos    as integer      no-undo.
      154       if length( p-source-string ) <= p-split-length
      155       then do:
      156           assign
      157               p-string-1 = p-source-string
      158           .
      159       end.
      160       else do:
      161           assign
      162               v-space-pos = r-index( p-source-string, " ":U, p-split-length )
      163           .
      164           if v-space-pos = 0
      165           then do:
      166               assign
      167                   v-space-pos = index( p-source-string, " ":U )
      168               .
      169           end.
      170           if v-space-pos = 0
      171           then do:
      172               assign
      173                   p-string-1 = substring( p-source-string, 1, p-split-length )
      174                   p-string-2 = trim( substring( p-source-string, p-split-length, p-split-length ) )
      175               .
      176           end.
      177           else do:
      178               assign
      179                   p-string-1 = substring( p-source-string, 1, v-space-pos )
      180                   p-string-2 = trim( substring( p-source-string, v-space-pos ) )
      181               .
      182           end.
      183       end.
      184   end.
      185   end procedure.
      186   procedure p-fmt-round :
      187   define input parameter p-qnty               as decimal          no-undo.
      188   define input parameter p-price-no-VAT       as decimal          no-undo.
      189   define input parameter p-VAT                as decimal          no-undo.
      190   define input parameter p-SLT                as decimal          no-undo.
      191   define input parameter p-road-tax           as decimal          no-undo.
      192   define output parameter p-new-price-no-VAT  as decimal          no-undo.
      193   define output parameter p-new-VAT           as decimal          no-undo.
      194   define output parameter p-new-SLT           as decimal          no-undo.
      195   define output parameter p-new-sum-VAT       as decimal          no-undo.
      196   define output parameter p-new-sum-SLT       as decimal          no-undo.
      197   define output parameter p-new-sum-road-tax  as decimal          no-undo.
      198   define output parameter p-new-sum-no-VAT    as decimal          no-undo.
      199   define output parameter p-new-sum-full      as decimal          no-undo.
      200       define variable v-vat-pc    as decimal      no-undo.
      201       define variable v-slt-pc    as decimal      no-undo.
      202   do
      203   on error undo, return error
      204   :
      205       if p-price-no-VAT = 0
      206       then do:
      207           assign
      208               p-new-price-no-VAT = 0.0
      209               p-new-VAT          = ?
      210               p-new-SLT          = ?
      211               p-new-sum-VAT      = 0.0
      212               p-new-sum-SLT      = 0.0
      213               p-new-sum-no-VAT   = 0.0
      214               p-new-sum-road-tax = 0.0
      215               p-new-sum-full     = 0.0
      216           .
      217       end.
      218       else do:
      219           assign
      220               v-vat-pc            = p-VAT / p-price-no-VAT
      221               v-slt-pc            = p-SLT / ( p-price-no-VAT + p-VAT )
      222               p-new-price-no-VAT  = round( p-price-no-VAT, 2 )
      223               p-new-VAT           = round( p-new-price-no-VAT * v-vat-pc, 2 )
      224               p-new-SLT           = round( ( p-new-price-no-VAT + p-new-VAT ) * v-slt-pc, 2 )
      225               p-new-sum-VAT       = round( p-new-VAT          * p-qnty, 2 )
      226               p-new-sum-SLT       = round( ( p-new-price-no-VAT + p-new-VAT ) * p-qnty * v-slt-pc, 2 )
      227               p-new-sum-no-VAT    = round( p-new-price-no-VAT * p-qnty, 2 )
      228               p-new-sum-road-tax  = round( p-road-tax * p-qnty, 2 )
      229               p-new-sum-full      = round( ( p-new-price-no-VAT + p-new-VAT + p-new-SLT + p-road-tax ) * p-qnty, 2 )
      230           .
      231       end.
      232   end.
      233   end procedure.
      234   procedure p-fmt-split :
      235   define input parameter p-in-string      as character        no-undo.
      236   define input parameter p-split-length   as integer          no-undo.
      237       define variable v-start-pos     as integer      no-undo.
      238       define variable v-end-pos       as integer      no-undo.
      239       define buffer buf_temp_p-fmt_string-part        for temp_p-fmt_string-part.
      240   do
      241   for buf_temp_p-fmt_string-part
      242   on error undo, return error
      243   :
      244       empty temp-table buf_temp_p-fmt_string-part.
      245       if p-split-length < 1
      246       then do:
      247           undo, return error substitute( "p-fmt-split: Строка не может быть разбита на &1 частей", p-split-length ).
      248       end.
      249       assign
      250           p-in-string                 = trim( p-in-string )
      251           v-p-fmt-1-str-key   = 0
      252           v-start-pos                 = 1
      253           v-end-pos                   = length( p-in-string )
      254       .
      255       run p-fmt-get-string-range in this-procedure (
      256             input p-in-string
      257           , input p-split-length
      258           , input v-start-pos
      259           , output v-start-pos
      260           , output v-end-pos
      261       ).
      262       do while v-end-pos <> 0
      263       :
      264           create buf_temp_p-fmt_string-part.
      265           assign
      266               v-p-fmt-1-str-key = v-p-fmt-1-str-key + 1
      267           .
      268           assign
      269               buf_temp_p-fmt_string-part.str-key      = v-p-fmt-1-str-key
      270               buf_temp_p-fmt_string-part.string-part  = substring( p-in-string, v-start-pos, v-end-pos - v-start-pos )
      271           .
      272           assign
      273               v-start-pos = v-end-pos + 1
      274           .
      275           run p-fmt-get-string-range in this-procedure (
      276                 input p-in-string
      277               , input p-split-length
      278               , input v-start-pos
      279               , output v-start-pos
      280               , output v-end-pos
      281           ).
      282       end.
      283   end.
      284   end procedure.
      285   procedure p-fmt-get-string-range :
      286   define input parameter p-in-string      as character        no-undo.
      287   define input parameter p-split-length   as integer          no-undo.
      288   define input parameter p-old-start-pos  as integer          no-undo.
      289   define output parameter p-start-pos     as integer          no-undo.
      290   define output parameter p-end-pos       as integer          no-undo.
      291       define variable v-init-string    as character    no-undo.
      292       define variable v-temp-char      as character    no-undo.
      293       define variable v-temp-pos       as integer      no-undo.
      294       define variable v-counter        as integer      no-undo.
      295   do
      296   on error undo, return error
      297   :
      298       assign
      299           p-start-pos   = p-old-start-pos
      300           v-init-string = substring( p-in-string, p-start-pos )
      301       no-error.
      302       if error-status :error
      303       or trim( v-init-string ) = "":U
      304       then do:
      305           assign
      306               p-end-pos = 0
      307           .
      308           undo, return .
      309       end.
      310       assign
      311           v-temp-char   = substring( v-init-string, 1, 1 )
      312       .
      313       do
      314       while trim( v-temp-char ) = "":U
      315       :
      316           assign
      317               p-start-pos     = p-start-pos + 1
      318               v-init-string   = substring( p-in-string, p-start-pos )
      319               v-temp-char     = substring( v-init-string, 1, 1 )
      320           .
      321       end.
      322       assign
      323           v-temp-pos  = p-split-length
      324           v-temp-char = substring( v-init-string, v-temp-pos, 1 )
      325           v-counter   = 0
      326       .
      327       search-word-end:
      328       do
      329       while trim( v-temp-char ) <> "":U
      330       :
      331           assign
      332               v-counter   = v-counter + 1
      333           .
      334           if v-counter > 20
      335           then do:
      336               assign
      337                   v-temp-pos  = p-split-length
      338               .
      339               leave search-word-end.
      340           end.
      341           assign
      342               v-temp-pos  = v-temp-pos - 1
      343               v-temp-char = substring( v-init-string, v-temp-pos, 1 )
      344           .
      345       end.
      346       assign
      347           p-end-pos = p-start-pos + v-temp-pos - 1
      348       .
      349   end.
      350   end procedure.
      351   define variable vss-include-info2 as character format "X(65)" no-undo
      352   initial "@(#)$Workfile$ $Revision$".
      353   define variable v-fmtcli-name          as character    no-undo.
      354   define variable v-fmtcli-engl-name     as character    no-undo.
      355   define variable v-fmtcli-addres        as character    no-undo.
      356   define variable v-fmtcli-post-addres   as character    no-undo.
      357   define variable v-fmtcli-full-addres   as character    no-undo.
      358   define variable v-fmtcli-phone         as character    no-undo.
      359   define variable v-fmtcli-inn           as character    no-undo.
      360   define variable v-fmtcli-kpp           as character    no-undo.
      361   define variable v-fmtcli-okpo          as character    no-undo.
      362   define variable v-fmtcli-country       as character    no-undo.
      363   define variable v-fmtcli-city          as character    no-undo.
      364   define variable v-fmtcli-index         as character    no-undo.
      365   define variable v-fmtcli-schet-exists  as logical      no-undo.
      366   define variable v-fmtcli-bank-exists   as logical      no-undo.
      367   define variable v-fmtcli-bank-r-schet  as character    no-undo.
      368   define variable v-fmtcli-bank-c-schet  as character    no-undo.
      369   define variable v-fmtcli-bank-bik      as character    no-undo.
      370   define variable v-fmtcli-bank-name     as character    no-undo.
      371   define variable v-fmtcli-bank-addres   as character    no-undo.
      372   define variable v-fmtcli-bank-city     as character    no-undo.
      373   procedure fmtcli-get-bank :
      374   define input parameter p-host-code      as integer          no-undo.
      375   define input parameter p-obj-type       as character        no-undo.
      376   define input parameter p-obj-code       as integer          no-undo.
      377   define input parameter p-curr-code      as integer          no-undo.
      378       define buffer buf_fin-schet     for ub.fin-schet.
      379       define buffer buf_fin-bank      for ub.fin-bank.
      380   do
      381   for buf_fin-schet
      382     , buf_fin-bank
      383   on error undo, return error
      384   :
      385       assign
      386           v-fmtcli-schet-exists       = no
      387           v-fmtcli-bank-exists        = no
      388           v-fmtcli-bank-r-schet       = "":U
      389           v-fmtcli-bank-c-schet       = "":U
      390           v-fmtcli-bank-bik           = "":U
      391           v-fmtcli-bank-name          = "":U
      392           v-fmtcli-bank-addres        = "":U
      393           v-fmtcli-bank-city          = "":U
      394       .
      395       search-for-schet:
      396       for each buf_fin-schet no-lock
      397          where buf_fin-schet.host-code = p-host-code
      398            and buf_fin-schet.cli-type  = p-obj-type
      399            and buf_fin-schet.cli-code  = p-obj-code
      400            and buf_fin-schet.curr-code = p-curr-code
      401       on error undo, return error
      402       :
      403           if buf_fin-schet.status_   = 'удал':U
      404           then do:
      405           end.
      406           else do:
      407               assign
      408                   v-fmtcli-schet-exists   = yes
      409                   v-fmtcli-bank-r-schet   = trim( buf_fin-schet.r-schet )
      410                   v-fmtcli-bank-c-schet   = trim( buf_fin-schet.c-schet )
      411               .
      412               find first buf_fin-bank no-lock
      413                    where buf_fin-bank.host-code = p-host-code
      414                      and buf_fin-bank.code-bank = buf_fin-schet.code-bank
      415               no-error.
      416               if available buf_fin-bank
      417               then do:
      418                   assign
      419                       v-fmtcli-bank-exists      = yes
      420                       v-fmtcli-bank-bik         = trim( buf_fin-bank.bik )
      421                       v-fmtcli-bank-name        = trim( buf_fin-bank.bank-name )
      422                       v-fmtcli-bank-addres      = trim(buf_fin-bank.addres)
      423                       v-fmtcli-bank-city      = trim(buf_fin-bank.bank-city)
      424                   .
      425               end.
      426               else do:
      427                   assign
      428                       v-fmtcli-bank-exists    = no
      429                       v-fmtcli-bank-bik       = "":U
      430                       v-fmtcli-bank-name      = "":U
      431                       v-fmtcli-bank-addres    = "":U
      432                       v-fmtcli-bank-city      = "":U
      433                   .
      434               end.
      435               leave search-for-schet.
      436           end.
      437       end.
      438   end.
      439   end procedure.
      440   procedure fmtcli-get-client :
      441   define input parameter p-obj-type       as character    no-undo.
      442   define input parameter p-obj-code       as integer      no-undo.
      443       define variable v-temp-fmtcli-address      as character     no-undo.
      444       define variable v-num-country-city    as integer      no-undo.
      445       define buffer buf_clients   for ub.clients.
      446       define buffer buf_firm      for ub.firm.
      447       define buffer buf_store     for ub.store.
      448       define buffer buf_shop      for ub.shop.
      449       define buffer buf_person    for ub.person.
      450   do
      451   for buf_clients
      452     , buf_firm
      453     , buf_store
      454     , buf_shop
      455     , buf_person
      456   on error undo, return error
      457   :
      458       assign
      459           v-fmtcli-name           = "":U
      460           v-fmtcli-addres         = "":U
      461           v-fmtcli-post-addres    = "":U
      462           v-fmtcli-full-addres    = "":U
      463           v-fmtcli-phone          = "":U
      464           v-fmtcli-inn            = "":U
      465           v-fmtcli-kpp            = "":U
      466           v-fmtcli-okpo           = "":U
      467           v-fmtcli-city           = "":U
      468           v-fmtcli-index          = "":U
      469           v-fmtcli-country        = "":U
      470       .
      471       find first buf_clients no-lock
      472            where buf_clients.obj-type = p-obj-type
      473              and buf_clients.obj-code = p-obj-code
      474       .
      475       assign
      476           v-fmtcli-name = buf_clients.obj-name
      477       .
      478       case buf_clients.obj-type:
      479          when 'орг':U
      480          then do:
      481               find first buf_firm no-lock
      482                    where buf_firm.firm-code = buf_clients.obj-code
      483                    no-error
      484               .
      485               if available buf_firm
      486               then do:
      487                   assign
      488                       v-num-country-city = num-entries( buf_firm.city )
      489                       v-fmtcli-engl-name = buf_firm.engl-name
      490                   .
      491                   if v-num-country-city > 0
      492                   then do:
      493                       assign
      494                           v-fmtcli-country    = trim( entry( 1, buf_firm.city ) )
      495                       .
      496                   end.
      497                   if v-num-country-city > 1
      498                   then do:
      499                       assign
      500                           v-fmtcli-city       = trim( entry( 2, buf_firm.city ) )
      501                       .
      502                   end.
      503                   run fmtcli-concatenate-strings in this-procedure (
      504                         input v-fmtcli-full-addres
      505                       , input v-fmtcli-country
      506                       , input ", ":U
      507                       , input 50
      508                       , output v-fmtcli-full-addres
      509                   ).
      510                   run fmtcli-concatenate-strings in this-procedure (
      511                         input v-fmtcli-full-addres
      512                       , input v-fmtcli-city
      513                       , input ", ":U
      514                       , input 50
      515                       , output v-fmtcli-full-addres
      516                   ).
      517                   run fmtcli-concatenate-strings in this-procedure (
      518                         input v-fmtcli-full-addres
      519                       , input IF buf_firm.ind = 0 THEN "" ELSE string( buf_firm.ind )
      520                       , input ", ":U
      521                       , input 50
      522                       , output v-fmtcli-full-addres
      523                   ).
      524                   run fmtcli-concatenate-strings in this-procedure (
      525                         input v-fmtcli-post-addres
      526                       , input v-fmtcli-country
      527                       , input ", ":U
      528                       , input 50
      529                       , output v-fmtcli-post-addres
      530                   ).
      531                   run fmtcli-concatenate-strings in this-procedure (
      532                         input v-fmtcli-post-addres
      533                       , input v-fmtcli-city
      534                       , input ", ":U
      535                       , input 50
      536                       , output v-fmtcli-post-addres
      537                   ).
      538                   run fmtcli-concatenate-strings in this-procedure (
      539                         input v-fmtcli-post-addres
      540                       , input string( buf_firm.ind )
      541                       , input ", ":U
      542                       , input 50
      543                       , output v-fmtcli-post-addres
      544                   ).
      545                   run fmtcli-concatenate-strings in this-procedure (
      546                         input substring( buf_firm.addres1, 1, 50 )
      547                       , input buf_firm.addres2
      548                       , input " ":U
      549                       , input 50
      550                       , output v-temp-fmtcli-address
      551                   ).
      552                   run fmtcli-concatenate-strings in this-procedure (
      553                         input v-temp-fmtcli-address
      554                       , input substring( buf_firm.addres1, 51, 50 )
      555                       , input " ":U
      556                       , input 50
      557                       , output v-temp-fmtcli-address
      558                   ).
      559                   run fmtcli-concatenate-strings in this-procedure (
      560                         input v-temp-fmtcli-address
      561                       , input substring( buf_firm.addres1, 101, 50 )
      562                       , input " ":U
      563                       , input 50
      564                       , output v-temp-fmtcli-address
      565                   ).
      566                   assign
      567                       v-fmtcli-addres = v-temp-fmtcli-address
      568                   .
      569                   if buf_firm.addres1 <> ?
      570                   then do:
      571                       run fmtcli-concatenate-strings in this-procedure (
      572                             input v-fmtcli-full-addres
      573                           , input v-fmtcli-addres
      574                           , input ", ":U
      575                           , input 0
      576                           , output v-fmtcli-full-addres
      577                       ).
      578                   end.
      579                   run fmtcli-concatenate-strings in this-procedure (
      580                         input substring( buf_firm.post-addr1, 1, 50 )
      581                       , input buf_firm.post-addr2
      582                       , input " ":U
      583                       , input 50
      584                       , output v-fmtcli-post-addres
      585                   ).
      586                   run fmtcli-concatenate-strings in this-procedure (
      587                         input v-fmtcli-post-addres
      588                       , input substring( buf_firm.post-addr1, 51, 50 )
      589                       , input " ":U
      590                       , input 50
      591                       , output v-fmtcli-post-addres
      592                   ).
      593                   run fmtcli-concatenate-strings in this-procedure (
      594                         input v-fmtcli-post-addres
      595                       , input substring( buf_firm.post-addr1, 101, 50 )
      596                       , input " ":U
      597                       , input 50
      598                       , output v-fmtcli-post-addres
      599                   ).
      600                   assign
      601                       v-fmtcli-phone         = buf_firm.phone
      602                       v-fmtcli-inn           = buf_firm.inn
      603                       v-fmtcli-kpp           = buf_firm.kpp
      604                       v-fmtcli-okpo          = buf_firm.okpo
      605                       v-fmtcli-index         = string( buf_firm.ind )
      606                   .
      607               end.
      608          end.
      609          when 'маг':U
      610          then do:
      611               find first buf_shop no-lock
      612                    where buf_shop.obj-code = buf_clients.obj-code
      613               .
      614               if available buf_shop
      615               then do:
      616                   run fmtcli-concatenate-strings in this-procedure (
      617                         input buf_shop.addres1
      618                       , input buf_shop.addres2
      619                       , input " ":U
      620                       , input 50
      621                       , output v-fmtcli-addres
      622                   ).
      623                   assign
      624                       v-fmtcli-full-addres = v-fmtcli-addres
      625                       v-fmtcli-post-addres = v-fmtcli-addres
      626                       v-fmtcli-phone       = buf_shop.phone
      627                       v-fmtcli-inn         = "":U
      628                       v-fmtcli-kpp         = "":U
      629                       v-fmtcli-okpo        = "":U
      630                       v-fmtcli-city        = "":U
      631                       v-fmtcli-index       = "":U
      632                   .
      633               end.
      634          end.
      635          when 'скл':U
      636          then do:
      637               find first buf_store no-lock
      638                    where buf_store.obj-code = buf_clients.obj-code
      639               .
      640               if available buf_store
      641               then do:
      642                   run fmtcli-concatenate-strings in this-procedure (
      643                         input buf_store.addres1
      644                       , input buf_store.addres2
      645                       , input " ":U
      646                       , input 50
      647                       , output v-fmtcli-addres
      648                   ).
      649                   assign
      650                       v-fmtcli-full-addres = v-fmtcli-addres
      651                       v-fmtcli-phone       = buf_store.phone
      652                       v-fmtcli-inn         = "":U
      653                       v-fmtcli-kpp         = "":U
      654                       v-fmtcli-okpo        = "":U
      655                       v-fmtcli-city        = "":U
      656                       v-fmtcli-index       = "":U
      657                   .
      658               end.
      659          end.
      660          when 'чел':U
      661          then do:
      662               find first buf_person no-lock
      663                    where buf_person.psn-code = buf_clients.obj-code
      664               .
      665               if available buf_person
      666               then do:
      667                   run fmtcli-concatenate-strings in this-procedure (
      668                         input ( if buf_person.ind = 0 or buf_person.ind = ?
      669                                 then "":U
      670                                 else string( buf_person.ind, "999999")
      671                                 )
      672                       , input buf_person.city
      673                       , input ", ":U
      674                       , input 0
      675                       , output v-fmtcli-full-addres
      676                   ).
      677                   assign
      678                       v-fmtcli-addres = buf_person.address
      679                   .
      680                   run fmtcli-concatenate-strings in this-procedure (
      681                         input v-fmtcli-full-addres
      682                       , input v-fmtcli-addres
      683                       , input ", ":U
      684                       , input 0
      685                       , output v-fmtcli-full-addres
      686                   ).
      687                   assign
      688                       v-fmtcli-phone     = buf_person.phone1
      689                       v-fmtcli-inn       = buf_person.inn
      690                       v-fmtcli-kpp       = buf_person.kpp
      691                       v-fmtcli-okpo      = buf_person.okpo
      692                       v-fmtcli-city      = buf_person.city
      693                       v-fmtcli-index     = string( buf_person.ind )
      694                   .
      695               end.
      696          end.
      697       end case.
      698   end.
      699   end procedure.
      700   procedure fmtcli-concatenate-strings :
      701   define input parameter p-string-1       as character        no-undo.
      702   define input parameter p-string-2       as character        no-undo.
      703   define input parameter p-delimiter      as character        no-undo.
      704   define input parameter p-length         as integer          no-undo.
      705   define output parameter p-out-string    as character        no-undo.
      706   do
      707   on error undo, return error
      708   :
      709       assign
      710           p-out-string = ( if p-string-1 = ?
      711                            then "":U
      712                            else trim( p-string-1 ) )
      713       .
      714       assign
      715           p-out-string = p-out-string
      716                        + ( if p-out-string = "":U
      717                            or length( p-out-string ) = p-length
      718                            or p-string-2 = ?
      719                            or trim( p-string-2 ) = "":U
      720                            then "":U
      721                            else p-delimiter )
      722                        + ( if p-string-2 = ?
      723                            or trim( p-string-2 ) = "":U
      724                            then "":U
      725                            else trim( p-string-2 ) )
      726       .
      727   end.
      728   end procedure.
      729   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      730   procedure cur-time :
      731      define output parameter p-today as date      no-undo .
      732      define output parameter p-time  as integer   no-undo .
      733     do
      734     on error undo, return error
      735     :
      736       define variable v-date1 as date      no-undo .
      737       define variable v-date2 as date      no-undo .
      738       define variable v-time  as integer   no-undo .
      739       assign
      740         v-date1 = today
      741         v-time  = time
      742         v-date2 = today
      743       .
      744       if v-date1 <> v-date2
      745       then do:
      746         assign
      747           v-date1 = today
      748           v-time  = v-time
      749         .
      750       end.
      751       assign
      752         p-today = v-date1
      753         p-time  = v-time
      754       .
      755     end.
      756   end.
      757   function cur-time-date returns character
      758   :
      759     return string(today, '99/99/9999':U) .
      760   end.
      761   function cur-time-mjd returns decimal
      762   :
      763     define variable v-date as date      no-undo .
      764     define variable v-time as integer   no-undo .
      765     run cur-time in this-procedure
      766       (output v-date
      767       ,output v-time
      768       ) .
      769     return integer(v-date) - 2400002 + (v-time / 86400) .
      770   end.
      771   function cur-time-get-ending-index returns integer
      772   (input p-number as integer
      773   )
      774   :
      775     if p-number < 0
      776     or p-number = ?
      777     then do:
      778       return 1 .
      779     end.
      780     define variable v-rest as integer   no-undo .
      781     assign
      782       p-number = p-number modulo 100
      783     .
      784     if p-number < 20
      785     then do:
      786       assign
      787         v-rest = p-number
      788       .
      789     end.
      790     else do:
      791       assign
      792         v-rest = p-number modulo 10
      793       .
      794     end.
      795     case v-rest :
      796       when 1
      797       then do:
      798         return 2 .
      799       end.
      800       when 2 or
      801       when 3 or
      802       when 4
      803       then do:
      804         return 3 .
      805       end.
      806       otherwise do:
      807         return 1 .
      808       end.
      809     end case .
      810   end.
      811   procedure cur-time-mjd-to-date :
      812      define input  parameter i-mjd-diff as decimal no-undo.
      813      define output parameter o-Date     as date    no-undo.
      814      define output parameter o-Time     as integer no-undo.
      815      define variable v-day-number as integer   no-undo .
      816      if    i-mjd-diff < 0
      817         or i-mjd-diff = ?
      818      then do:
      819         return "?" .
      820      end.
      821      assign
      822         v-day-number = truncate(i-mjd-diff,0).
      823         o-Date = date(v-day-number + 2400002).
      824         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      825     .
      826   end.
      827   function cur-time-mjd-to-string returns character
      828   (input p-mjd-diff as decimal
      829   )
      830   :
      831     define variable v-day-number as integer   no-undo .
      832     define variable v-seconds    as integer   no-undo .
      833     define variable v-hour       as integer   no-undo .
      834     define variable v-min        as integer   no-undo .
      835     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      836     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      837     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      838     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      839     if p-mjd-diff < 0
      840     or p-mjd-diff = ?
      841     then do:
      842       return "?" .
      843     end.
      844     assign
      845       v-day-number = integer(truncate(p-mjd-diff,0))
      846       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      847     .
      848     if v-seconds > 86400
      849     then do:
      850       assign
      851         v-seconds = 86400 - 1
      852       .
      853     end.
      854     if v-seconds < 0
      855     then do:
      856       assign
      857         v-seconds = 0
      858       .
      859     end.
      860     assign
      861       v-hour = truncate(v-seconds / 3600, 0)
      862     .
      863     assign
      864       v-seconds = v-seconds modulo 3600
      865     .
      866     assign
      867       v-min = truncate(v-seconds / 60, 0)
      868     .
      869     assign
      870       v-seconds = v-seconds modulo 60
      871     .
      872     return
      873         (if v-day-number <> 0
      874           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      875           else ""
      876         )
      877       + (if v-day-number <> 0 or v-hour <> 0
      878           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      879           else ""
      880         )
      881       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      882           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      883           else ""
      884         )
      885       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      886       .
      887   end.
      888   function cur-time-string returns character
      889   :
      890     define variable v-date as date      no-undo .
      891     define variable v-time as integer   no-undo .
      892     run cur-time in this-procedure
      893       (output v-date
      894       ,output v-time
      895       ) .
      896     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      897   end.
      898   function cur-time-string-sec returns character
      899   :
      900     define variable v-date as date      no-undo .
      901     define variable v-time as integer   no-undo .
      902     run cur-time in this-procedure
      903       (output v-date
      904       ,output v-time
      905       ) .
      906     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      907   end.
      908   function cur-time-custom  returns character
      909   (input p-prefix as character
      910   ,input p-date-format as character
      911   ,input p-delimiter as character
      912   ,input p-time-format as character
      913   ,input p-suffix as character
      914   )
      915   :
      916     define variable v-date as date      no-undo .
      917     define variable v-time as integer   no-undo .
      918     run cur-time in this-procedure
      919       (output v-date
      920       ,output v-time
      921       ) .
      922     return
      923       p-prefix
      924       + string(v-date, p-date-format)
      925       + p-delimiter
      926       + string(v-time, p-time-format)
      927       + p-suffix
      928       .
      929   end.
      930   function cur-time-print  returns character
      931   :
      932     define variable v-date as date      no-undo .
      933     define variable v-time as integer   no-undo .
      934     run cur-time in this-procedure
      935       (output v-date
      936       ,output v-time
      937       ) .
      938     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      939   end.
      940   function cur-time-datetime returns datetime
      941   :
      942     define variable v-char as character no-undo .
      943     define variable v-datetime as datetime no-undo .
      944     v-char = cur-time-string().
      945     v-datetime = datetime(v-char).
      946     return  v-datetime.
      947   end.
      948   function cur-time-string-msec returns character
      949   :
      950     define variable v-date as datetime  no-undo .
      951     v-date = now.
      952     return string(v-date) .
      953   end.
      954   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      955   define temp-table temp-parts no-undo   like ub.parts   field free-qnty as decimal   field free-cli-qnty as decimal .
      956   procedure partslib-clear-temp-parts :
      957     define buffer buf_temp-parts for temp-parts .
      958     do
      959     on error undo, return error
      960     :
      961       for each buf_temp-parts
      962       on error undo, return error
      963       :
      964         delete buf_temp-parts .
      965       end.
      966     end.
      967   end procedure.
      968   procedure partslib-create-temp-parts :
      969     define parameter buffer buf_parts       for ub.parts .
      970     define parameter buffer buf_temp-parts  for temp-parts .
      971     define input  parameter p-goods-twounit as logical   no-undo .
      972     define variable v-base-part-code as character no-undo .
      973     do
      974     on error undo, return error
      975     :
      976       if p-goods-twounit = true
      977       then do:
      978         assign
      979           v-base-part-code = entry(1, buf_parts.part-code, '#':U)
      980         .
      981       end.
      982       else do:
      983         assign
      984           v-base-part-code = buf_parts.part-code
      985         .
      986       end.
      987       find first buf_temp-parts exclusive-lock
      988         where buf_temp-parts.obj-type  = buf_parts.obj-type
      989           and buf_temp-parts.obj-code  = buf_parts.obj-code
      990           and buf_temp-parts.artic     = buf_parts.artic
      991           and buf_temp-parts.prod-type = buf_parts.prod-type
      992           and buf_temp-parts.prod-code = buf_parts.prod-code
      993           and buf_temp-parts.in-code   = buf_parts.in-code
      994           and buf_temp-parts.out-code  = 'free-zone':U
      995           and buf_temp-parts.part-code = v-base-part-code
      996         no-error.
      997       if not available buf_temp-parts
      998       then do:
      999         create buf_temp-parts .
     1000         buffer-copy buf_parts to buf_temp-parts
     1001         assign
     1002           buf_temp-parts.out-code  = 'free-zone':U
     1003           buf_temp-parts.part-code = v-base-part-code
     1004           buf_temp-parts.rsrv-free = yes
     1005           buf_temp-parts.status_   = no
     1006           buf_temp-parts.qnty      = 0
     1007           buf_temp-parts.fact-qnty = 0
     1008           buf_temp-parts.real-qnty = 0
     1009           buf_temp-parts.cli-qnty  = 0
     1010         .
     1011       end.
     1012     end.
     1013   end procedure.
     1014   procedure partslib-init-temp-parts :
     1015     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
     1016     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
     1017     define input parameter p-artic           like ub.parts.artic     no-undo .
     1018     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
     1019     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
     1020     define buffer buf_parts      for ub.parts .
     1021     define buffer buf_temp-parts for temp-parts .
     1022     define variable v-goods-twounit    as logical   no-undo .
     1023     do
     1024     on error undo, return error
     1025     :
     1026   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1027   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     1028     (input  p-artic
     1029     ,input  p-prod-type
     1030     ,input  p-prod-code
     1031     ,input  'twounit=request':u
     1032     ,output v-goods-twounit
     1033     ) no-error .
     1034       if error-status :error
     1035       then do:
     1036         message
     1037           vss-workfile vss-revision vss-description skip
     1038           vss-include-info4 skip
     1039           "Ошибка при определении атрибута товара" skip
     1040           "Артикул" p-artic p-prod-type p-prod-code skip
     1041           "twounit=request" skip
     1042           error-status :get-message(1) skip
     1043           return-value skip
     1044           view-as alert-box error .
     1045         undo, return error return-value .
     1046       end.
     1047       run partslib-clear-temp-parts in this-procedure .
     1048       for each buf_parts
     1049         where buf_parts.obj-type  = p-obj-type
     1050           and buf_parts.obj-code  = p-obj-code
     1051           and buf_parts.artic     = p-artic
     1052           and buf_parts.prod-type = p-prod-type
     1053           and buf_parts.prod-code = p-prod-code
     1054           and buf_parts.rsrv-free = yes
     1055           and buf_parts.status_   = no
     1056           and buf_parts.in-code   <> buf_parts.out-code
     1057       on error undo, return error
     1058       :
     1059         run partslib-create-temp-parts in this-procedure
     1060           (buffer buf_parts
     1061           ,buffer buf_temp-parts
     1062           ,input  v-goods-twounit
     1063           ) .
     1064         define variable v-parts-qnty          as decimal   no-undo .
     1065         define variable v-parts-cli-qnty      as decimal   no-undo .
     1066         define variable v-parts-free-qnty     as decimal   no-undo .
     1067         define variable v-parts-free-cli-qnty as decimal   no-undo .
     1068         if buf_parts.out-code = 'free-zone':U
     1069         then do:
     1070           assign
     1071             v-parts-qnty          = buf_parts.qnty
     1072             v-parts-cli-qnty      = buf_parts.cli-qnty
     1073             v-parts-free-qnty     = buf_parts.qnty
     1074             v-parts-free-cli-qnty = buf_parts.cli-qnty
     1075           .
     1076         end.
     1077         else do:
     1078           assign
     1079             v-parts-qnty          = abs(buf_parts.qnty)
     1080             v-parts-cli-qnty      = abs(buf_parts.cli-qnty)
     1081             v-parts-free-qnty     = 0
     1082             v-parts-free-cli-qnty = 0
     1083           .
     1084         end.
     1085         assign
     1086           buf_temp-parts.qnty          = buf_temp-parts.qnty          + v-parts-qnty
     1087           buf_temp-parts.fact-qnty     = buf_temp-parts.fact-qnty     + v-parts-qnty
     1088           buf_temp-parts.real-qnty     = 0
     1089           buf_temp-parts.cli-qnty      = buf_temp-parts.cli-qnty      + v-parts-cli-qnty
     1090           buf_temp-parts.free-qnty     = buf_temp-parts.free-qnty     + v-parts-free-qnty
     1091           buf_temp-parts.free-cli-qnty = buf_temp-parts.free-cli-qnty + v-parts-free-cli-qnty
     1092         .
     1093       end.
     1094     end.
     1095   end procedure.
     1096   procedure partslib-init-temp-parts-by-factord :
     1097     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
     1098     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
     1099     define input parameter p-artic              like ub.parts.artic     no-undo .
     1100     define input parameter p-prod-type          like ub.parts.prod-type no-undo .
     1101     define input parameter p-prod-code          like ub.parts.prod-code no-undo .
     1102     define input parameter p-fact-order         as decimal   no-undo .
     1103     define input parameter p-include-fact-order as logical   no-undo .
     1104     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-factord: определение партий свободной зоны на любую дату".
     1105     define buffer buf_gds-obj  for ub.gds-obj .
     1106     do
     1107     on error undo, return error
     1108     :
     1109       do transaction
     1110       on error undo, return error
     1111       :
     1112   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1113   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     1114     (input  p-obj-type
     1115     ,input  p-obj-code
     1116     ,input  p-artic
     1117     ,input  p-prod-type
     1118     ,input  p-prod-code
     1119     ,buffer buf_gds-obj
     1120     ) no-error .
     1121         if error-status :error
     1122         then do:
     1123           message
     1124             vss-workfile vss-revision vss-description skip
     1125             vss-include-info4 skip
     1126             "Невозможно найти товар на объекте" skip
     1127             "Объект" p-obj-type p-obj-code skip
     1128             "Артикул" p-artic p-prod-type p-prod-code skip
     1129             error-status :get-message(1) skip
     1130             return-value skip
     1131             view-as alert-box error .
     1132           undo, return error .
     1133         end.
     1134         find current buf_gds-obj exclusive-lock .
     1135       end.
     1136       run partslib-init-temp-parts in this-procedure
     1137         (input p-obj-type
     1138         ,input p-obj-code
     1139         ,input p-artic
     1140         ,input p-prod-type
     1141         ,input p-prod-code
     1142         ) no-error .
     1143       if error-status :error
     1144       then do:
     1145         message
     1146           vss-workfile vss-revision vss-description skip
     1147           vss-include-info4 skip
     1148           "Ошибка при инициализации текущего остатка по партиям свободной зоны" skip
     1149           "Объект" p-obj-type p-obj-code skip
     1150           "Артикул" p-artic p-prod-type p-prod-code skip
     1151           "p-fact-order" p-fact-order skip
     1152           view-as alert-box error .
     1153         undo, return error .
     1154       end.
     1155       if p-include-fact-order = true
     1156       then do:
     1157         assign
     1158           p-fact-order = p-fact-order - 0.0000000001
     1159         .
     1160       end.
     1161       define variable v-max-fact-order as character no-undo .
     1162       run factord-max-fact-order in this-procedure
     1163         (output v-max-fact-order
     1164         ) no-error .
     1165       if error-status :error
     1166       then do:
     1167         message
     1168           vss-workfile vss-revision vss-description skip
     1169           vss-include-info4 skip
     1170           "Ошибка при вызове процедуры factord-max-fact-order" skip
     1171           "Объект" p-obj-type p-obj-code skip
     1172           "Артикул" p-artic p-prod-type p-prod-code skip
     1173           "p-fact-order" p-fact-order skip
     1174           view-as alert-box error .
     1175         undo, return error .
     1176       end.
     1177       run partslib-update-by-factord in this-procedure
     1178         (input p-obj-type
     1179         ,input p-obj-code
     1180         ,input p-artic
     1181         ,input p-prod-type
     1182         ,input p-prod-code
     1183         ,input p-fact-order
     1184         ,input v-max-fact-order
     1185         ,input false
     1186         ) no-error .
     1187       if error-status :error
     1188       then do:
     1189         message
     1190           vss-workfile vss-revision vss-description skip
     1191           vss-include-info4 skip
     1192           "Ошибка при вызове процедуры partslib-update-by-factord" skip
     1193           "Объект" p-obj-type p-obj-code skip
     1194           "Артикул" p-artic p-prod-type p-prod-code skip
     1195           "p-fact-order" p-fact-order skip
     1196           "v-max-fact-order" v-max-fact-order skip
     1197           view-as alert-box error .
     1198         undo, return error .
     1199       end.
     1200     end.
     1201   end procedure.
     1202   procedure partslib-update-by-factord :
     1203     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
     1204     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
     1205     define input parameter p-artic              like ub.parts.artic     no-undo .
     1206     define input parameter p-prod-type          like ub.parts.prod-type no-undo .
     1207     define input parameter p-prod-code          like ub.parts.prod-code no-undo .
     1208     define input parameter p-start-fact-order   as decimal   no-undo .
     1209     define input parameter p-end-fact-order     as decimal   no-undo .
     1210     define input parameter p-lock-gds-obj       as logical   no-undo .
     1211     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-factord: определение партий свободной зоны на любую дату".
     1212     define buffer buf_gds-obj  for ub.gds-obj .
     1213     define buffer buf_doc-line for ub.doc-line .
     1214     define variable v-total-parts-qnty as decimal   no-undo .
     1215     define variable v-goods-gds-goods  as logical   no-undo .
     1216     define variable v-goods-twounit    as logical   no-undo .
     1217     do
     1218     on error undo, return error
     1219     :
     1220       if p-start-fact-order > p-end-fact-order
     1221       then do:
     1222         message
     1223           vss-workfile vss-revision vss-description skip
     1224           vss-include-info4 skip
     1225           "Ошибка задания входных параметров" skip
     1226           "Начало интервала превышает конец интервала" skip
     1227           "Объект" p-obj-type p-obj-code skip
     1228           "Артикул" p-artic p-prod-type p-prod-code skip
     1229           "p-start-fact-order" p-start-fact-order skip
     1230           "p-end-fact-order"   p-end-fact-order skip
     1231           view-as alert-box error .
     1232         undo, return error .
     1233       end.
     1234       if p-lock-gds-obj = true
     1235       then do:
     1236         do transaction
     1237         on error undo, return error
     1238         :
     1239   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1240   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     1241     (input  p-obj-type
     1242     ,input  p-obj-code
     1243     ,input  p-artic
     1244     ,input  p-prod-type
     1245     ,input  p-prod-code
     1246     ,buffer buf_gds-obj
     1247     ) no-error .
     1248           if error-status :error
     1249           then do:
     1250             message
     1251               vss-workfile vss-revision vss-description skip
     1252               vss-include-info4 skip
     1253               "Невозможно найти gds-obj" skip
     1254               error-status :get-message(1) skip
     1255               return-value skip
     1256               view-as alert-box error .
     1257             undo, return error .
     1258           end.
     1259           find current buf_gds-obj exclusive-lock .
     1260         end.
     1261       end.
     1262   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1263   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     1264     (input  p-artic
     1265     ,input  p-prod-type
     1266     ,input  p-prod-code
     1267     ,input  'gds-goods=request':u
     1268     ,output v-goods-gds-goods
     1269     ) no-error .
     1270       if error-status :error
     1271       then do:
     1272         message
     1273           vss-workfile vss-revision vss-description skip
     1274           vss-include-info4 skip
     1275           "Ошибка при определении атрибута товара" skip
     1276           "Артикул" p-artic p-prod-type p-prod-code skip
     1277           "gds-goods=request" skip
     1278           error-status :get-message(1) skip
     1279           return-value skip
     1280           view-as alert-box error .
     1281         undo, return error return-value .
     1282       end.
     1283   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1284   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     1285     (input  p-artic
     1286     ,input  p-prod-type
     1287     ,input  p-prod-code
     1288     ,input  'twounit=request':u
     1289     ,output v-goods-twounit
     1290     ) no-error .
     1291       if error-status :error
     1292       then do:
     1293         message
     1294           vss-workfile vss-revision vss-description skip
     1295           vss-include-info4 skip
     1296           "Ошибка при определении атрибута товара" skip
     1297           "Артикул" p-artic p-prod-type p-prod-code skip
     1298           "twounit=request" skip
     1299           error-status :get-message(1) skip
     1300           return-value skip
     1301           view-as alert-box error .
     1302         undo, return error return-value .
     1303       end.
     1304       for each buf_doc-line no-lock
     1305         where buf_doc-line.obj-type   = p-obj-type
     1306           and buf_doc-line.obj-code   = p-obj-code
     1307           and buf_doc-line.artic      = p-artic
     1308           and buf_doc-line.prod-type  = p-prod-type
     1309           and buf_doc-line.prod-code  = p-prod-code
     1310           and buf_doc-line.status_    = 'факт':U
     1311           and buf_doc-line.fact-order > p-start-fact-order
     1312           and buf_doc-line.fact-order <= p-end-fact-order
     1313       on error undo, return error
     1314       :
     1315         run partslib-process-document in this-procedure
     1316           (input  buf_doc-line.doc-code
     1317           ,input  p-obj-type
     1318           ,input  p-obj-code
     1319           ,input  p-artic
     1320           ,input  p-prod-type
     1321           ,input  p-prod-code
     1322           ,input  v-goods-gds-goods
     1323           ,input  v-goods-twounit
     1324           ,output v-total-parts-qnty
     1325           ) no-error .
     1326         if error-status :error
     1327         then do:
     1328           message
     1329             vss-workfile vss-revision vss-description skip
     1330             vss-include-info4 skip
     1331             "Ошибка при вызове процедуры partslib-process-document" skip
     1332             "Документ" buf_doc-line.doc-code skip
     1333             "Объект" p-obj-type p-obj-code skip
     1334             "Артикул" p-artic p-prod-type p-prod-code skip
     1335             "p-start-fact-order" p-start-fact-order skip
     1336             "p-end-fact-order" p-end-fact-order skip
     1337             error-status :get-message(1) skip
     1338             return-value skip
     1339             view-as alert-box error .
     1340           undo, return error return-value .
     1341         end.
     1342       end.
     1343     end.
     1344   end procedure.
     1345   procedure partslib-process-document :
     1346     define input  parameter p-doc-code         as character no-undo .
     1347     define input  parameter p-obj-type         as character no-undo .
     1348     define input  parameter p-obj-code         as integer   no-undo .
     1349     define input  parameter p-artic            as character no-undo .
     1350     define input  parameter p-prod-type        as character no-undo .
     1351     define input  parameter p-prod-code        as integer   no-undo .
     1352     define input  parameter p-goods-gds-goods  as logical   no-undo .
     1353     define input  parameter p-goods-twounit    as logical   no-undo .
     1354     define output parameter p-total-parts-qnty as decimal   no-undo .
     1355     define variable v-parts-sign as integer   no-undo .
     1356     define buffer buf_trn-doc    for ub.trn-doc .
     1357     define buffer buf_doc-line   for ub.doc-line .
     1358     define buffer buf_parts      for ub.parts .
     1359     define buffer buf_temp-parts for temp-parts .
     1360     do
     1361     on error undo, return error return-value
     1362     :
     1363       find first buf_trn-doc no-lock
     1364         where buf_trn-doc.doc-code = p-doc-code
     1365         no-error .
     1366       if not available buf_trn-doc
     1367       then do:
     1368         undo, return error substitute("Ошибка при поиске документа. Документ &1"
     1369                                      ,p-doc-code
     1370                                      ) .
     1371       end.
     1372       case buf_trn-doc.doc-type
     1373       :
     1374         when 'при':U or
     1375         when 'возврат':U or
     1376         when 'инв':U
     1377         then do:
     1378           assign
     1379             v-parts-sign = -1
     1380           .
     1381         end.
     1382         when 'рас':U or
     1383         when 'спи':U
     1384         then do:
     1385           assign
     1386             v-parts-sign = 1
     1387           .
     1388         end.
     1389         otherwise do:
     1390           undo, return error substitute("Неизвестный тип документа &1"
     1391                                       ,buf_trn-doc.doc-type
     1392                                       ) .
     1393         end.
     1394       end.
     1395       find first buf_doc-line no-lock
     1396         where buf_doc-line.doc-code  = p-doc-code
     1397           and buf_doc-line.artic     = p-artic
     1398           and buf_doc-line.prod-type = p-prod-type
     1399           and buf_doc-line.prod-code = p-prod-code
     1400         no-error .
     1401       if not available buf_doc-line
     1402       then do:
     1403         undo, return error substitute("Ошибка при поиске строки документа. Документ &1. Артикул &2 &3 &4"
     1404                                      ,p-doc-code
     1405                                      ,artic
     1406                                      ,prod-type
     1407                                      ,prod-code
     1408                                      ) .
     1409       end.
     1410       assign
     1411         p-total-parts-qnty = 0
     1412       .
     1413       if p-goods-gds-goods = true
     1414       then do:
     1415         for each buf_parts no-lock
     1416           where buf_parts.out-code  = p-doc-code
     1417             and buf_parts.obj-type  = p-obj-type
     1418             and buf_parts.obj-code  = p-obj-code
     1419             and buf_parts.artic     = p-artic
     1420             and buf_parts.prod-type = p-prod-type
     1421             and buf_parts.prod-code = p-prod-code
     1422         on error undo, return error
     1423         :
     1424           run partslib-create-temp-parts in this-procedure
     1425             (buffer buf_parts
     1426             ,buffer buf_temp-parts
     1427             ,input  p-goods-twounit
     1428             ) .
     1429           assign
     1430             p-total-parts-qnty        = p-total-parts-qnty
     1431                                       + v-parts-sign * buf_parts.fact-qnty
     1432             buf_temp-parts.qnty       = buf_temp-parts.qnty
     1433                                       + v-parts-sign * buf_parts.fact-qnty
     1434             buf_temp-parts.fact-qnty  = buf_temp-parts.fact-qnty
     1435                                       + v-parts-sign * buf_parts.fact-qnty
     1436             buf_temp-parts.cli-qnty   = buf_temp-parts.cli-qnty
     1437                                       + v-parts-sign * buf_parts.cli-qnty
     1438           .
     1439           if buf_temp-parts.qnty = 0
     1440           then do:
     1441             delete buf_temp-parts .
     1442           end.
     1443         end.
     1444       end.
     1445       else do:
     1446         assign
     1447           p-total-parts-qnty = p-total-parts-qnty
     1448                              + v-parts-sign * buf_doc-line.fact-qnty
     1449         .
     1450       end.
     1451     end.
     1452   end procedure.
     1453   procedure partslib-init-temp-parts-by-date :
     1454     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
     1455     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
     1456     define input parameter p-artic           like ub.parts.artic     no-undo .
     1457     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
     1458     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
     1459     define input parameter p-fact-date       as date      no-undo .
     1460     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-date: определение партий свободной зоны на любую дату".
     1461     do
     1462     on error undo, return error
     1463     :
     1464       define variable v-fact-order                as decimal   no-undo .
     1465       define variable v-shift-end-fact-order      as decimal   no-undo .
     1466       define variable v-day-end-fact-order        as decimal   no-undo .
     1467       run factord in this-procedure
     1468         (input  p-fact-date
     1469         ,input  1
     1470         ,input  1
     1471         ,input  ?
     1472         ,input  0
     1473         ,input  false
     1474         ,output v-fact-order
     1475         ,output v-shift-end-fact-order
     1476         ,output v-day-end-fact-order
     1477         ) no-error .
     1478       if error-status :error
     1479       then do:
     1480         message
     1481           vss-workfile vss-revision vss-description skip
     1482           vss-include-info4 skip
     1483           "Ошибка при определении момента времени, на который требуется остаток" skip
     1484           "Объект" p-obj-type p-obj-code skip
     1485           "Артикул" p-artic p-prod-type p-prod-code skip
     1486           "Дата" p-fact-date skip
     1487           view-as alert-box error .
     1488         undo, return error .
     1489       end.
     1490       run partslib-init-temp-parts-by-factord in this-procedure
     1491         (input p-obj-type
     1492         ,input p-obj-code
     1493         ,input p-artic
     1494         ,input p-prod-type
     1495         ,input p-prod-code
     1496         ,input v-day-end-fact-order
     1497         ,input false
     1498         ) no-error .
     1499       if error-status :error
     1500       then do:
     1501         message
     1502           vss-workfile vss-revision vss-description skip
     1503           vss-include-info4 skip
     1504           "Ошибка при вызове метода partslib-init-temp-parts-by-factord" skip
     1505           "Объект" p-obj-type p-obj-code skip
     1506           "Артикул" p-artic p-prod-type p-prod-code skip
     1507           "Дата" p-fact-date skip
     1508           view-as alert-box error .
     1509         undo, return error .
     1510       end.
     1511     end.
     1512   end procedure.
     1513   procedure partslib-calc-cost :
     1514     define output parameter p-fact-qnty      as decimal   no-undo .
     1515     define output parameter p-vat-pc         as decimal   no-undo .
     1516     define output parameter p-slt-pc         as decimal   no-undo .
     1517     define output parameter p-sum-base       as decimal   no-undo .
     1518     define output parameter p-sum-rubl       as decimal   no-undo .
     1519     define output parameter p-vat-base       as decimal   no-undo .
     1520     define output parameter p-vat-rubl       as decimal   no-undo .
     1521     define output parameter p-slt-base       as decimal   no-undo .
     1522     define output parameter p-slt-rubl       as decimal   no-undo .
     1523     define output parameter p-road-tax-base  as decimal   no-undo .
     1524     define output parameter p-road-tax-rubl  as decimal   no-undo .
     1525     define output parameter p-transport-base as decimal   no-undo .
     1526     define output parameter p-transport-rubl as decimal   no-undo .
     1527     define output parameter p-other-base     as decimal   no-undo .
     1528     define output parameter p-other-rubl     as decimal   no-undo .
     1529     define output parameter p-excise-base    as decimal   no-undo .
     1530     define output parameter p-excise-rubl    as decimal   no-undo .
     1531     define variable vss-description as character no-undo init "partslib-calc-cost: расчет сумм в учетных ценах".
     1532     do
     1533     on error undo, return error return-value
     1534     :
     1535       define buffer buf_temp-parts for temp-parts .
     1536       define buffer   in-vatp-trn-doc  for ub.trn-doc .
     1537       define buffer   in-vatp-parts    for ub.parts   .
     1538       define buffer   in-vatp-doc      for ub.trn-doc .
     1539       define buffer   in-vatp-goods    for ub.goods   .
     1540       define buffer   in-vatp-sysconf  for ub.sysconf .
     1541       define buffer   in-vatp_doc-attr for ub.doc-attr.
     1542       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
     1543       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
     1544       define variable varinvprb                  as   character              no-undo.
     1545       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
     1546       define variable cli-base-rate              as   decimal                no-undo.
     1547       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
     1548       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
     1549       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
     1550       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
     1551       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
     1552       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
     1553       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
     1554       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
     1555       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
     1556       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
     1557       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
     1558       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
     1559       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
     1560       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
     1561       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
     1562       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
     1563       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
     1564       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
     1565       define variable other-base-loc             like ub.doc-line.price-base no-undo.
     1566       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
     1567       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
     1568       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
     1569       define variable varinvatp-envd             as   character              no-undo.
     1570       define variable varinvatp-type             as   character              no-undo.
     1571       for each buf_temp-parts
     1572       on error undo, return error
     1573       :
     1574   assign
     1575     price-rubl-with-tax-loc = buf_temp-parts.price-rubl
     1576     price-base-with-tax-loc = buf_temp-parts.price-base
     1577   .
     1578   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1579   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1580     (output varinvprb
     1581     )  .
     1582     if buf_temp-parts.out-code = 'free-zone':U     or
     1583        buf_temp-parts.out-code = 'out-zone':U   or
     1584        buf_temp-parts.doc-type = 'акт':U then do:
     1585       assign
     1586         in-vatp-have-vat-slt = yes.
     1587     end.
     1588     else do:
     1589       find first in-vatp_doc-attr no-lock
     1590         where in-vatp_doc-attr.doc-code  = buf_temp-parts.out-code
     1591           and in-vatp_doc-attr.attr-code = 'envd':U
     1592         no-error .
     1593       if not available in-vatp_doc-attr then do:
     1594         assign
     1595           in-vatp-have-vat-slt = yes.
     1596       end.
     1597       else do:
     1598            in-vatp-have-vat-slt = no.
     1599       end.
     1600     end.
     1601     assign
     1602      price-cli-with-tax-loc = buf_temp-parts.price-cli
     1603      cli-base-rate          = buf_temp-parts.cli-base-rate.
     1604     ASSIGN   road-tax-base-loc  = (if buf_temp-parts.road-tax-base  = ? then 0 else buf_temp-parts.road-tax-base)
     1605              road-tax-rubl-loc  = (if buf_temp-parts.road-tax-rubl  = ? then 0 else buf_temp-parts.road-tax-rubl).
     1606     ASSIGN  transport-base-loc = (if buf_temp-parts.transport-base = ? then 0 else buf_temp-parts.transport-base)
     1607             transport-rubl-loc = (if buf_temp-parts.transport-rubl = ? then 0 else buf_temp-parts.transport-rubl)
     1608             other-base-loc     = (if buf_temp-parts.other-base     = ? then 0 else buf_temp-parts.other-base)
     1609             other-rubl-loc     = (if buf_temp-parts.other-rubl     = ? then 0 else buf_temp-parts.other-rubl)
     1610             vat-pc-loc         = (if buf_temp-parts.vat-pc         = ? then 0 else buf_temp-parts.vat-pc)
     1611             slt-pc-loc         = (if buf_temp-parts.slt-pc         = ? then 0 else buf_temp-parts.slt-pc).
     1612             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     1613       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     1614     assign
     1615       exch-rate-cli-loc = (buf_temp-parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if buf_temp-parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if buf_temp-parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / buf_temp-parts.price-cli .
     1616     assign
     1617       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
     1618       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
     1619       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
     1620       transport-cli-loc  = 0
     1621       other-cli-loc      = 0
     1622     .
     1623   ASSIGN
     1624             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     1625       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     1626   .
     1627         assign
     1628           p-fact-qnty      = p-fact-qnty      + buf_temp-parts.fact-qnty
     1629           p-vat-pc         = p-vat-pc         + vat-pc-loc
     1630           p-slt-pc         = p-slt-pc         + slt-pc-loc
     1631           p-sum-base       = p-sum-base       + price-base-with-tax-loc * buf_temp-parts.fact-qnty
     1632           p-sum-rubl       = p-sum-rubl       + price-rubl-with-tax-loc * buf_temp-parts.fact-qnty
     1633           p-vat-base       = p-vat-base       + vat-base-loc            * buf_temp-parts.fact-qnty
     1634           p-vat-rubl       = p-vat-rubl       + vat-rubl-loc            * buf_temp-parts.fact-qnty
     1635           p-slt-base       = p-slt-base       + slt-base-loc            * buf_temp-parts.fact-qnty
     1636           p-slt-rubl       = p-slt-rubl       + slt-rubl-loc            * buf_temp-parts.fact-qnty
     1637           p-road-tax-base  = p-road-tax-base  + road-tax-base-loc       * buf_temp-parts.fact-qnty
     1638           p-road-tax-rubl  = p-road-tax-rubl  + road-tax-rubl-loc       * buf_temp-parts.fact-qnty
     1639           p-transport-base = p-transport-base + transport-base-loc      * buf_temp-parts.fact-qnty
     1640           p-transport-rubl = p-transport-rubl + transport-rubl-loc      * buf_temp-parts.fact-qnty
     1641           p-other-base     = p-other-base     + other-base-loc          * buf_temp-parts.fact-qnty
     1642           p-other-rubl     = p-other-rubl     + other-rubl-loc          * buf_temp-parts.fact-qnty
     1643           p-excise-base    = p-excise-base    + 0
     1644           p-excise-rubl    = p-excise-rubl    + 0
     1645         .
     1646       end.
     1647       if p-fact-qnty      = ?
     1648       or p-sum-base       = ?
     1649       or p-sum-rubl       = ?
     1650       or p-vat-base       = ?
     1651       or p-vat-rubl       = ?
     1652       or p-slt-base       = ?
     1653       or p-slt-rubl       = ?
     1654       or p-road-tax-base  = ?
     1655       or p-road-tax-rubl  = ?
     1656       or p-transport-base = ?
     1657       or p-transport-rubl = ?
     1658       or p-other-base     = ?
     1659       or p-other-rubl     = ?
     1660       or p-excise-base    = ?
     1661       or p-excise-rubl    = ?
     1662       then do:
     1663         message
     1664           vss-workfile vss-revision vss-description skip
     1665           vss-include-info4 skip
     1666           "Программа in-vatp.i вернула неопределенные значения" skip
     1667           "p-fact-qnty"      p-fact-qnty      skip
     1668           "p-sum-base"       p-sum-base       skip
     1669           "p-sum-rubl"       p-sum-rubl       skip
     1670           "p-vat-base"       p-vat-base       skip
     1671           "p-vat-rubl"       p-vat-rubl       skip
     1672           "p-slt-base"       p-slt-base       skip
     1673           "p-slt-rubl"       p-slt-rubl       skip
     1674           "p-road-tax-base"  p-road-tax-base  skip
     1675           "p-road-tax-rubl"  p-road-tax-rubl  skip
     1676           "p-transport-base" p-transport-base skip
     1677           "p-transport-rubl" p-transport-rubl skip
     1678           "p-other-base"     p-other-base     skip
     1679           "p-other-rubl"     p-other-rubl     skip
     1680           "p-excise-base"    p-excise-base    skip
     1681           "p-excise-rubl"    p-excise-rubl    skip
     1682           view-as alert-box error .
     1683         undo, return error .
