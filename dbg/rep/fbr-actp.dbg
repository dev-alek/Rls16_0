     2055                                         or buf_trn-doc.doc-type = 'инв':U
     2056                                         then buf_doc-line.fact-qnty
     2057                                         else - buf_doc-line.fact-qnty
     2058                                       )
     2059             .
     2060   assign
     2061     price-rubl-with-tax-loc = buf_doc-line.price-rubl
     2062     price-base-with-tax-loc = buf_doc-line.price-base
     2063   .
     2064   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     2065   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     2066     (output varinvprb
     2067     )  .
     2068      find first in-vatp_doc-attr no-lock
     2069       where in-vatp_doc-attr.doc-code  = buf_trn-doc.doc-code
     2070         and in-vatp_doc-attr.attr-code = 'envd':U
     2071       no-error .
     2072       if available in-vatp_doc-attr
     2073          then do:
     2074          assign
     2075            in-vatp-have-vat-slt = no.
     2076      end.
     2077      else do:
     2078        assign
     2079          in-vatp-have-vat-slt = yes.
     2080      end.
     2081      find first in-vatp-goods where in-vatp-goods.artic     = buf_doc-line.artic     and
     2082                                        in-vatp-goods.prod-type = buf_doc-line.prod-type and
     2083                                        in-vatp-goods.prod-code = buf_doc-line.prod-code no-lock.
     2084      if (not buf_trn-doc.internal and
     2085              buf_trn-doc.doc-type = 'при':U) or
     2086         in-vatp-goods.gds-type = 'у':U then do:
     2087         if varinvprb = "base":u then do:
     2088           assign
     2089             road-tax-base-loc = buf_doc-line.road-tax
     2090             road-tax-rubl-loc = buf_doc-line.road-tax * buf_trn-doc.base-rate / buf_trn-doc.base-scale.
     2091         end.
     2092         else do:
     2093           ASSIGN
     2094             road-tax-rubl-loc = buf_doc-line.road-tax
     2095             road-tax-base-loc = buf_doc-line.road-tax / buf_trn-doc.base-rate * buf_trn-doc.base-scale.
     2096         end.
     2097         if road-tax-base-loc = ? then road-tax-base-loc = 0.
     2098         if road-tax-rubl-loc = ? then road-tax-rubl-loc = 0.
     2099         assign
     2100           road-tax-cli-loc = ?.
     2101         ASSIGN
     2102           transport-base-loc = (if buf_doc-line.transport-base = ? then 0 else buf_doc-line.transport-base)
     2103           transport-rubl-loc = (if buf_doc-line.transport-rubl = ? then 0 else buf_doc-line.transport-rubl)
     2104           transport-cli-loc  = 0
     2105           other-base-loc     = (if buf_doc-line.other-base     = ? then 0 else buf_doc-line.other-base)
     2106           other-rubl-loc     = (if buf_doc-line.other-rubl     = ? then 0 else buf_doc-line.other-rubl)
     2107           other-cli-loc      = 0
     2108           vat-pc-loc         = (if buf_doc-line.vat-pc         = ? then 0 else buf_doc-line.vat-pc)
     2109           slt-pc-loc         = (if buf_doc-line.slt-pc         = ? then 0 else buf_doc-line.slt-pc).
     2110                                 ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     2111               ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     2112         assign
     2113           vat-cli-loc            = ?
     2114           slt-cli-loc            = ?
     2115           price-cli-with-tax-loc = ?.
     2116      end.
     2117      else do:
     2118                                                   for each in-vatp-parts where in-vatp-parts.out-code  = buf_doc-line.doc-code  and
     2119                                         in-vatp-parts.obj-type  = buf_doc-line.obj-type  and
     2120                                         in-vatp-parts.obj-code  = buf_doc-line.obj-code  and
     2121                                         in-vatp-parts.artic     = buf_doc-line.artic     and
     2122                                         in-vatp-parts.prod-type = buf_doc-line.prod-type and
     2123                                         in-vatp-parts.prod-code = buf_doc-line.prod-code
     2124                            use-index out-code no-lock:
     2125             accumulate  in-vatp-parts.road-tax-base  * in-vatp-parts.fact-qnty (total)
     2126                         in-vatp-parts.road-tax-rubl  * in-vatp-parts.fact-qnty (total)
     2127                         in-vatp-parts.transport-base * in-vatp-parts.fact-qnty (total)
     2128                         in-vatp-parts.transport-rubl * in-vatp-parts.fact-qnty (total)
     2129                         in-vatp-parts.other-base     * in-vatp-parts.fact-qnty (total)
     2130                         in-vatp-parts.other-rubl     * in-vatp-parts.fact-qnty (total)
     2131                                                                                                                 (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  (total)
     2132                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))  (total)
     2133                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))  (total)
     2134                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc))  (total)
     2135                                               (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  (total)
     2136                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))  (total)
     2137                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))  (total)
     2138                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc))  (total)
     2139                         .
     2140         end.
     2141         ASSIGN
     2142           road-tax-base-loc   = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.road-tax-base  * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
     2143           road-tax-rubl-loc   = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.road-tax-rubl  * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
     2144           transport-base-loc  = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.transport-base * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
     2145           transport-rubl-loc  = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.transport-rubl * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
     2146           other-base-loc      = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.other-base     * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
     2147           other-rubl-loc      = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.other-rubl     * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
     2148                                           vat-base-loc        = if buf_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / buf_doc-line.fact-qnty   else 0
     2149           slt-base-loc        = if buf_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / buf_doc-line.fact-qnty   else 0
     2150                   vat-rubl-loc        = if buf_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / buf_doc-line.fact-qnty   else 0
     2151           slt-rubl-loc        = if buf_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / buf_doc-line.fact-qnty   else 0
     2152           vat-pc-loc          = (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc)))
     2153           slt-pc-loc          = (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))).
     2154         if road-tax-base-loc  = ? then road-tax-base-loc  = 0.
     2155         if road-tax-rubl-loc  = ? then road-tax-rubl-loc  = 0.
     2156         if transport-base-loc = ? then transport-base-loc = 0.
     2157         if transport-rubl-loc = ? then transport-rubl-loc = 0.
     2158         if other-base-loc     = ? then other-base-loc     = 0.
     2159         if other-rubl-loc     = ? then other-rubl-loc     = 0.
     2160         assign
     2161           transport-cli-loc      = 0
     2162           other-cli-loc          = 0
     2163           road-tax-cli-loc       = ?
     2164           vat-cli-loc            = ?
     2165           slt-cli-loc            = ?
     2166           price-cli-with-tax-loc = ?.
     2167      end.
     2168   ASSIGN
     2169             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     2170       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     2171   .
     2172             assign
     2173               v-fact-qnty           = v-fact-qnty      + v-parts-fact-qnty
     2174               v-vat-pc              = vat-pc-loc
     2175               v-slt-pc              = slt-pc-loc
     2176               v-sum-base            = v-sum-base       + (price-base-with-tax-loc * v-parts-fact-qnty)
     2177               v-sum-rubl            = v-sum-rubl       + (price-rubl-with-tax-loc * v-parts-fact-qnty)
     2178               v-vat-base            = v-vat-base       + (vat-base-loc            * v-parts-fact-qnty)
     2179               v-vat-rubl            = v-vat-rubl       + (vat-rubl-loc            * v-parts-fact-qnty)
     2180               v-slt-base            = v-slt-base       + (slt-base-loc            * v-parts-fact-qnty)
     2181               v-slt-rubl            = v-slt-rubl       + (slt-rubl-loc            * v-parts-fact-qnty)
     2182               v-road-tax-base       =  0
     2183               v-road-tax-rubl       =  0
     2184               v-excise-base         =  0
     2185               v-excise-rubl         =  0
     2186               v-transport-base      =  0
     2187               v-transport-rubl      =  0
     2188               v-other-base          =  0
     2189               v-other-rubl          =  0
     2190             .
     2191       end.
     2192     end.
     2193   end procedure.
     2194   procedure fbrrep-fill-qnty-and-prices :
     2195   do
     2196   on error undo, return error
     2197   :
     2198   define input parameter p-fbr-doc-doc-code  as character    no-undo.
     2199       define variable v-gds-code  as integer       no-undo.
     2200       define variable v-gds-name  as character     no-undo.
     2201       define variable v-sign      as decimal       no-undo.
     2202       define buffer buf_fbr-line          for ub.fbr-line.
     2203       define buffer buf_temp_fbrrep-goods for temp_fbrrep-goods.
     2204       for each buf_fbr-line no-lock
     2205          where buf_fbr-line.doc-code = p-fbr-doc-doc-code
     2206       on error undo, return error
     2207       :
     2208           find first buf_temp_fbrrep-goods
     2209                where buf_temp_fbrrep-goods.artic     = buf_fbr-line.artic
     2210                  and buf_temp_fbrrep-goods.prod-type = buf_fbr-line.prod-type
     2211                  and buf_temp_fbrrep-goods.prod-code = buf_fbr-line.prod-code
     2212           use-index ar
     2213           no-error.
     2214           if not available buf_temp_fbrrep-goods
     2215           then do:
     2216               create buf_temp_fbrrep-goods.
     2217   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2218   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
     2219     (input  buf_fbr-line.artic
     2220     ,input  buf_fbr-line.prod-type
     2221     ,input  buf_fbr-line.prod-code
     2222     ,output v-gds-code
     2223     )  .
     2224   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2225   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-arnm in g#library
     2226     (input  buf_fbr-line.artic
     2227     ,input  buf_fbr-line.prod-type
     2228     ,input  buf_fbr-line.prod-code
     2229     ,output v-gds-name
     2230     )  .
     2231   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2232   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     2233     (input  buf_fbr-line.artic
     2234     ,input  buf_fbr-line.prod-type
     2235     ,input  buf_fbr-line.prod-code
     2236     ,input  'gds-goods=request':u
     2237     ,output buf_temp_fbrrep-goods.is-not-office
     2238     )  .
     2239               assign
     2240                   buf_temp_fbrrep-goods.gds-code             = v-gds-code
     2241                   buf_temp_fbrrep-goods.artic                = buf_fbr-line.artic
     2242                   buf_temp_fbrrep-goods.prod-type            = buf_fbr-line.prod-type
     2243                   buf_temp_fbrrep-goods.prod-code            = buf_fbr-line.prod-code
     2244                   buf_temp_fbrrep-goods.gds-name             = v-gds-name
     2245                   buf_temp_fbrrep-goods.is-waste             = buf_fbr-line.is-waste
     2246                   buf_temp_fbrrep-goods.fact-qnty            = 0
     2247                   buf_temp_fbrrep-goods.write-off-rsrv-qnty  = 0
     2248                   buf_temp_fbrrep-goods.write-off-qnty       = 0
     2249                   buf_temp_fbrrep-goods.income-qnty          = 0
     2250                   buf_temp_fbrrep-goods.income-rsrv-qnty     = 0
     2251                   buf_temp_fbrrep-goods.cost-rubl            = 0
     2252                   buf_temp_fbrrep-goods.cost-base            = 0
     2253                   buf_temp_fbrrep-goods.sum-cost-rubl        = 0
     2254                   buf_temp_fbrrep-goods.sum-cost-base        = 0
     2255                   buf_temp_fbrrep-goods.vat-cost-rubl        = 0
     2256                   buf_temp_fbrrep-goods.vat-cost-base        = 0
     2257                   buf_temp_fbrrep-goods.sum-vat-cost-rubl    = 0
     2258                   buf_temp_fbrrep-goods.sum-vat-cost-base    = 0
     2259                   buf_temp_fbrrep-goods.price-sale           = buf_fbr-line.price-sale
     2260                   buf_temp_fbrrep-goods.deleted              = no
     2261               .
     2262   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2263   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run unitbase in g#library
     2264     (input  v-gds-code
     2265     ,output buf_temp_fbrrep-goods.unit-base
     2266     )  .
     2267           end.
     2268           case buf_fbr-line.trn-type
     2269           :
     2270               when 'при':U
     2271               then do:
     2272                   assign
     2273                       v-sign                                  = 1
     2274                       buf_temp_fbrrep-goods.income-qnty       = buf_temp_fbrrep-goods.income-qnty     + buf_fbr-line.fact-qnty
     2275                   .
     2276                   if buf_fbr-line.rsrv-qnty <> ?
     2277                   then do:
     2278                       assign
     2279                           buf_temp_fbrrep-goods.income-rsrv-qnty = buf_temp_fbrrep-goods.income-rsrv-qnty   + buf_fbr-line.rsrv-qnty
     2280                       .
     2281                   end.
     2282               end.
     2283               when 'спи':U
     2284               then do:
     2285                   assign
     2286                       v-sign                                  = -1
     2287                       buf_temp_fbrrep-goods.write-off-qnty    = buf_temp_fbrrep-goods.write-off-qnty  + buf_fbr-line.fact-qnty
     2288                   .
     2289                   if buf_fbr-line.rsrv-qnty <> ?
     2290                   then do:
     2291                       assign
     2292                           buf_temp_fbrrep-goods.write-off-rsrv-qnty = buf_temp_fbrrep-goods.write-off-rsrv-qnty   + buf_fbr-line.rsrv-qnty
     2293                       .
     2294                   end.
     2295               end.
     2296           end case.
     2297           assign
     2298               buf_temp_fbrrep-goods.sum-cost-rubl        = buf_temp_fbrrep-goods.sum-cost-rubl     + v-sign * buf_fbr-line.price-sum-rubl
     2299               buf_temp_fbrrep-goods.sum-cost-base        = buf_temp_fbrrep-goods.sum-cost-base     + v-sign * buf_fbr-line.price-sum-base
     2300               buf_temp_fbrrep-goods.sum-vat-cost-rubl    = buf_temp_fbrrep-goods.sum-vat-cost-rubl + v-sign * buf_fbr-line.price-sum-vat-rubl
     2301               buf_temp_fbrrep-goods.sum-vat-cost-base    = buf_temp_fbrrep-goods.sum-vat-cost-base + v-sign * buf_fbr-line.price-sum-vat-base
     2302           .
     2303       end.
     2304       run test-temp-tables in this-procedure .
     2305   end.
     2306   end procedure.
     2307   procedure fbrrep-fill-for-fbr-actp :
     2308   do
     2309   on error undo, return error
     2310   :
     2311   define input parameter p-fbr-doc-doc-code  as character    no-undo.
     2312       define buffer buf_temp_fbrrep-goods for temp_fbrrep-goods.
     2313       define buffer buf_fbr-line          for ub.fbr-line.
     2314       run fbrrep-fill-qnty-and-prices in this-procedure (
     2315           input p-fbr-doc-doc-code
     2316       ).
     2317       for each buf_temp_fbrrep-goods
     2318       :
     2319           assign
     2320               buf_temp_fbrrep-goods.sum-cost-rubl     = 0
     2321               buf_temp_fbrrep-goods.sum-cost-base     = 0
     2322               buf_temp_fbrrep-goods.sum-vat-cost-rubl = 0
     2323               buf_temp_fbrrep-goods.sum-vat-cost-base = 0
     2324               buf_temp_fbrrep-goods.cost-rubl     = 0
     2325               buf_temp_fbrrep-goods.cost-base     = 0
     2326               buf_temp_fbrrep-goods.vat-cost-rubl = 0
     2327               buf_temp_fbrrep-goods.vat-cost-base = 0
     2328           .
     2329           if buf_temp_fbrrep-goods.income-qnty = 0
     2330           or buf_temp_fbrrep-goods.write-off-qnty = 0
     2331           then do:
     2332               assign
     2333                   buf_temp_fbrrep-goods.deleted   = yes
     2334                   buf_temp_fbrrep-goods.fact-qnty = 0
     2335               .
     2336           end.
     2337           else do:
     2338               if buf_temp_fbrrep-goods.income-qnty <= buf_temp_fbrrep-goods.write-off-qnty
     2339               then do:
     2340                   assign
     2341                       buf_temp_fbrrep-goods.fact-qnty = buf_temp_fbrrep-goods.income-qnty
     2342                   .
     2343                   for each buf_fbr-line no-lock
     2344                      where buf_fbr-line.doc-code  = p-fbr-doc-doc-code
     2345                        and buf_fbr-line.artic     = buf_temp_fbrrep-goods.artic
     2346                        and buf_fbr-line.prod-type = buf_temp_fbrrep-goods.prod-type
     2347                        and buf_fbr-line.prod-code = buf_temp_fbrrep-goods.prod-code
     2348                        and buf_fbr-line.trn-type  = 'при':U
     2349                   :
     2350                       assign
     2351                           buf_temp_fbrrep-goods.sum-cost-rubl     = buf_temp_fbrrep-goods.sum-cost-rubl     + buf_fbr-line.price-sum-rubl
     2352                           buf_temp_fbrrep-goods.sum-cost-base     = buf_temp_fbrrep-goods.sum-cost-base     + buf_fbr-line.price-sum-base
     2353                           buf_temp_fbrrep-goods.sum-vat-cost-rubl = buf_temp_fbrrep-goods.sum-vat-cost-rubl + buf_fbr-line.price-sum-vat-rubl
     2354                           buf_temp_fbrrep-goods.sum-vat-cost-base = buf_temp_fbrrep-goods.sum-vat-cost-base + buf_fbr-line.price-sum-vat-base
     2355                       .
     2356                   end.
     2357                   assign
     2358                       buf_temp_fbrrep-goods.cost-rubl     = buf_temp_fbrrep-goods.sum-cost-rubl     / buf_temp_fbrrep-goods.fact-qnty
     2359                       buf_temp_fbrrep-goods.cost-base     = buf_temp_fbrrep-goods.sum-cost-base     / buf_temp_fbrrep-goods.fact-qnty
     2360                       buf_temp_fbrrep-goods.vat-cost-rubl = buf_temp_fbrrep-goods.sum-vat-cost-rubl / buf_temp_fbrrep-goods.fact-qnty
     2361                       buf_temp_fbrrep-goods.vat-cost-base = buf_temp_fbrrep-goods.sum-vat-cost-base / buf_temp_fbrrep-goods.fact-qnty
     2362                   .
     2363               end.
     2364               else do:
     2365                   assign
     2366                       buf_temp_fbrrep-goods.fact-qnty = buf_temp_fbrrep-goods.write-off-qnty
     2367                   .
     2368                   for each buf_fbr-line no-lock
     2369                      where buf_fbr-line.doc-code  = p-fbr-doc-doc-code
     2370                        and buf_fbr-line.artic     = buf_temp_fbrrep-goods.artic
     2371                        and buf_fbr-line.prod-type = buf_temp_fbrrep-goods.prod-type
     2372                        and buf_fbr-line.prod-code = buf_temp_fbrrep-goods.prod-code
     2373                        and buf_fbr-line.trn-type  = 'спи':U
     2374                   :
     2375                       assign
     2376                           buf_temp_fbrrep-goods.sum-cost-rubl     = buf_temp_fbrrep-goods.sum-cost-rubl     + buf_fbr-line.price-sum-rubl
     2377                           buf_temp_fbrrep-goods.sum-cost-base     = buf_temp_fbrrep-goods.sum-cost-base     + buf_fbr-line.price-sum-base
     2378                           buf_temp_fbrrep-goods.sum-vat-cost-rubl = buf_temp_fbrrep-goods.sum-vat-cost-rubl + buf_fbr-line.price-sum-vat-rubl
     2379                           buf_temp_fbrrep-goods.sum-vat-cost-base = buf_temp_fbrrep-goods.sum-vat-cost-base + buf_fbr-line.price-sum-vat-base
     2380                       .
     2381                   end.
     2382                   assign
     2383                       buf_temp_fbrrep-goods.cost-rubl     = buf_temp_fbrrep-goods.sum-cost-rubl     / buf_temp_fbrrep-goods.fact-qnty
     2384                       buf_temp_fbrrep-goods.cost-base     = buf_temp_fbrrep-goods.sum-cost-base     / buf_temp_fbrrep-goods.fact-qnty
     2385                       buf_temp_fbrrep-goods.vat-cost-rubl = buf_temp_fbrrep-goods.sum-vat-cost-rubl / buf_temp_fbrrep-goods.fact-qnty
     2386                       buf_temp_fbrrep-goods.vat-cost-base = buf_temp_fbrrep-goods.sum-vat-cost-base / buf_temp_fbrrep-goods.fact-qnty
     2387                   .
     2388               end.
     2389           end.
     2390       end.
     2391       for each buf_temp_fbrrep-goods
     2392          where buf_temp_fbrrep-goods.deleted = yes
     2393       on error undo, return error
     2394       :
     2395           delete buf_temp_fbrrep-goods.
     2396       end.
     2397       run test-temp-tables in this-procedure .
     2398   end.
     2399   end procedure.
     2400   procedure fbrrep-fill-for-op-del :
     2401   do
     2402   on error undo, return error
     2403   :
     2404   define input parameter p-fbr-doc-doc-code   as character    no-undo.
     2405   define input parameter p-db-remote          as logical          no-undo.
     2406       define variable v-serv-code as character    no-undo.
     2407       define variable v-in-code   as character    no-undo.
     2408       define variable v-out-code  as character    no-undo.
     2409       define variable v-trn-qnty  as decimal       no-undo.
     2410       define variable v-sign      as decimal       no-undo.
     2411       define variable v-qnty      as decimal       no-undo.
     2412       define buffer buf_fbr-doc           for ub.fbr-doc.
     2413       define buffer buf_fbr-line          for ub.fbr-line.
     2414       define buffer buf_goods             for ub.goods .
     2415       define buffer buf_doc-line          for ub.doc-line .
     2416       define buffer buf_temp_fbrrep-goods for temp_fbrrep-goods .
     2417       run fbrrep-fill-qnty-and-prices in this-procedure (
     2418           input p-fbr-doc-doc-code
     2419       ).
     2420       for each buf_temp_fbrrep-goods
     2421       on error undo, return error
     2422       :
     2423           if buf_temp_fbrrep-goods.income-qnty <> 0
     2424           or buf_temp_fbrrep-goods.write-off-qnty <> 0
     2425           then do:
     2426               assign
     2427                   v-qnty  = ( buf_temp_fbrrep-goods.write-off-qnty - buf_temp_fbrrep-goods.income-qnty )
     2428               .
     2429               if v-qnty = 0
     2430               then do:
     2431                   find first buf_fbr-line no-lock
     2432                        where buf_fbr-line.doc-code    = p-fbr-doc-doc-code
     2433                          and buf_fbr-line.artic       = buf_temp_fbrrep-goods.artic
     2434                          and buf_fbr-line.prod-type   = buf_temp_fbrrep-goods.prod-type
     2435                          and buf_fbr-line.prod-code   = buf_temp_fbrrep-goods.prod-code
     2436                          and buf_fbr-line.fact-qnty   <> 0
     2437                   no-error.
     2438                   if available buf_fbr-line
     2439                   then do:
     2440                       assign
     2441                           buf_temp_fbrrep-goods.cost-rubl     = buf_fbr-line.price-rubl
     2442                           buf_temp_fbrrep-goods.cost-base     = buf_fbr-line.price-base
     2443                           buf_temp_fbrrep-goods.vat-cost-rubl = buf_fbr-line.price-sum-vat-rubl / buf_fbr-line.fact-qnty
     2444                           buf_temp_fbrrep-goods.vat-cost-base = buf_fbr-line.price-sum-vat-base / buf_fbr-line.fact-qnty
     2445                       .
     2446                   end.
     2447                   else do:
     2448                       assign
     2449                           buf_temp_fbrrep-goods.cost-rubl     = 0
     2450                           buf_temp_fbrrep-goods.cost-base     = 0
     2451                           buf_temp_fbrrep-goods.vat-cost-rubl = 0
     2452                           buf_temp_fbrrep-goods.vat-cost-base = 0
     2453                       .
     2454                   end.
     2455               end.
     2456               else do:
     2457                   assign
     2458                       buf_temp_fbrrep-goods.cost-rubl     = buf_temp_fbrrep-goods.sum-cost-rubl     / v-qnty
     2459                       buf_temp_fbrrep-goods.cost-base     = buf_temp_fbrrep-goods.sum-cost-base     / v-qnty
     2460                       buf_temp_fbrrep-goods.vat-cost-rubl = buf_temp_fbrrep-goods.sum-vat-cost-rubl / v-qnty
     2461                       buf_temp_fbrrep-goods.vat-cost-base = buf_temp_fbrrep-goods.sum-vat-cost-base / v-qnty
     2462                   .
     2463               end.
     2464           end.
     2465           else do:
     2466               assign
     2467                   buf_temp_fbrrep-goods.cost-rubl     = 0
     2468                   buf_temp_fbrrep-goods.cost-base     = 0
     2469                   buf_temp_fbrrep-goods.vat-cost-rubl = 0
     2470                   buf_temp_fbrrep-goods.vat-cost-base = 0
     2471               .
     2472           end.
     2473       end.
     2474       for each buf_temp_fbrrep-goods
     2475       :
     2476           if buf_temp_fbrrep-goods.is-waste = yes
     2477           then do:
     2478               assign
     2479                   buf_temp_fbrrep-goods.deleted = yes
     2480               .
     2481           end.
     2482           else do:
     2483               if buf_temp_fbrrep-goods.write-off-qnty <> 0
     2484               and buf_temp_fbrrep-goods.income-qnty <> 0
     2485               then do:
     2486                   if buf_temp_fbrrep-goods.write-off-qnty = buf_temp_fbrrep-goods.income-qnty
     2487                   then do:
     2488                       assign
     2489                           buf_temp_fbrrep-goods.deleted = yes
     2490                       .
     2491                   end.
     2492                   else do:
     2493                       if buf_temp_fbrrep-goods.write-off-qnty > buf_temp_fbrrep-goods.income-qnty
     2494                       then do:
     2495                           assign
     2496                               buf_temp_fbrrep-goods.write-off-qnty    = buf_temp_fbrrep-goods.write-off-qnty - buf_temp_fbrrep-goods.income-qnty
     2497                               buf_temp_fbrrep-goods.income-qnty       = 0
     2498                           .
     2499                       end.
     2500                       else do:
     2501                           assign
     2502                               buf_temp_fbrrep-goods.income-qnty       = buf_temp_fbrrep-goods.income-qnty - buf_temp_fbrrep-goods.write-off-qnty
     2503                               buf_temp_fbrrep-goods.write-off-qnty    = 0
     2504                           .
     2505                       end.
     2506                   end.
     2507               end.
     2508           end.
     2509       end.
     2510       for each buf_temp_fbrrep-goods
     2511          where buf_temp_fbrrep-goods.deleted = yes
     2512       on error undo, return error
     2513       :
     2514           delete buf_temp_fbrrep-goods.
     2515       end.
     2516       run test-temp-tables in this-procedure .
     2517       find first buf_fbr-doc no-lock
     2518            where buf_fbr-doc.doc-code = p-fbr-doc-doc-code
     2519       .
     2520       assign
     2521           v-out-code = p-fbr-doc-doc-code
     2522       .
     2523       run doc-code in this-procedure (
     2524             input  "pair"
     2525           , input  buf_fbr-doc.obj-type
     2526           , input  buf_fbr-doc.obj-code
     2527           , input  v-out-code
     2528           , output v-in-code
     2529       ) no-error.
     2530       if error-status:error
     2531       then do:
     2532           message
     2533                    vss-workfile vss-revision vss-description
     2534               skip "Ошибка вычисления номера приходной накладной."
     2535               skip return-value
     2536               skip trim(error-status :get-message(1))
     2537                    trim(error-status :get-message(2))
     2538                    trim(error-status :get-message(3))
     2539           view-as alert-box error.
     2540           undo, return error .
     2541       end.
     2542       run doc-code in this-procedure (
     2543             input  "trio"
     2544           , input  buf_fbr-doc.obj-type
     2545           , input  buf_fbr-doc.obj-code
     2546           , input  v-in-code
     2547           , output v-serv-code
     2548       ) no-error.
     2549       if error-status:error
     2550       then do:
     2551           message
     2552                    vss-workfile vss-revision vss-description
     2553               skip "Ошибка вычисления номера накладной расхода."
     2554               skip return-value
     2555               skip trim(error-status :get-message(1))
     2556                    trim(error-status :get-message(2))
     2557                    trim(error-status :get-message(3))
     2558           view-as alert-box error.
     2559           undo, return error .
     2560       end.
     2561       for each buf_temp_fbrrep-goods
     2562       on error undo, return error
     2563       :
     2564           if buf_temp_fbrrep-goods.income-qnty > buf_temp_fbrrep-goods.write-off-qnty
     2565           then do:
     2566               find first buf_doc-line no-lock
     2567                    where buf_doc-line.doc-code  = v-in-code
     2568                      and buf_doc-line.artic     = buf_temp_fbrrep-goods.artic
     2569                      and buf_doc-line.prod-type = buf_temp_fbrrep-goods.prod-type
     2570                      and buf_doc-line.prod-code = buf_temp_fbrrep-goods.prod-code
     2571               no-error.
     2572               if available buf_doc-line
     2573               then do:
     2574                   assign
     2575                       buf_temp_fbrrep-goods.fact-qnty = buf_temp_fbrrep-goods.income-qnty - buf_doc-line.doc-qnty
     2576                   .
     2577               end.
     2578               else do:
     2579                   assign
     2580                       buf_temp_fbrrep-goods.fact-qnty = buf_temp_fbrrep-goods.income-qnty
     2581                   .
     2582               end.
     2583           end.
     2584           else do:
     2585               if buf_temp_fbrrep-goods.is-not-office = no
     2586               then do:
     2587                   find first buf_doc-line no-lock
     2588                        where buf_doc-line.doc-code  = v-serv-code
     2589                          and buf_doc-line.artic     = buf_temp_fbrrep-goods.artic
     2590                          and buf_doc-line.prod-type = buf_temp_fbrrep-goods.prod-type
     2591                          and buf_doc-line.prod-code = buf_temp_fbrrep-goods.prod-code
     2592                   no-error.
     2593               end.
     2594               else do:
     2595                   find first buf_doc-line no-lock
     2596                        where buf_doc-line.doc-code  = v-out-code
     2597                          and buf_doc-line.artic     = buf_temp_fbrrep-goods.artic
     2598                          and buf_doc-line.prod-type = buf_temp_fbrrep-goods.prod-type
     2599                          and buf_doc-line.prod-code = buf_temp_fbrrep-goods.prod-code
     2600                   no-error.
     2601               end.
     2602               if available buf_doc-line
     2603               then do:
     2604                   assign
     2605                       buf_temp_fbrrep-goods.fact-qnty = buf_temp_fbrrep-goods.write-off-qnty - buf_doc-line.doc-qnty
     2606                   .
     2607               end.
     2608               else do:
     2609                   assign
     2610                       buf_temp_fbrrep-goods.fact-qnty = buf_temp_fbrrep-goods.write-off-qnty
     2611                   .
     2612               end.
     2613           end.
     2614           if available buf_doc-line
     2615           then do:
     2616               define variable v-void              as decimal       no-undo.
     2617               define variable v-fact-qnty         as decimal       no-undo.
     2618               define variable v-sum-base          as decimal       no-undo.
     2619               define variable v-sum-rubl          as decimal       no-undo.
     2620               define variable v-vat-base          as decimal       no-undo.
     2621               define variable v-vat-rubl          as decimal       no-undo.
     2622               define variable v-slt-base          as decimal       no-undo.
     2623               define variable v-slt-rubl          as decimal       no-undo.
     2624               define variable v-road-tax-base     as decimal       no-undo.
     2625               define variable v-road-tax-rubl     as decimal       no-undo.
     2626               define variable v-transport-base    as decimal       no-undo.
     2627               define variable v-transport-rubl    as decimal       no-undo.
     2628               define variable v-other-base        as decimal       no-undo.
     2629               define variable v-other-rubl        as decimal       no-undo.
     2630               define variable v-excise-base       as decimal       no-undo.
     2631               define variable v-excise-rubl       as decimal       no-undo.
     2632               run r-cost in this-procedure (
     2633                     input buf_doc-line.doc-code
     2634                   , input buf_doc-line.artic
     2635                   , input buf_doc-line.prod-type
     2636                   , input buf_doc-line.prod-code
     2637                   , output v-fact-qnty
     2638                   , output v-void
     2639                   , output v-void
     2640                   , output v-sum-base
     2641                   , output v-sum-rubl
     2642                   , output v-vat-base
     2643                   , output v-vat-rubl
     2644                   , output v-slt-base
     2645                   , output v-slt-rubl
     2646                   , output v-road-tax-base
     2647                   , output v-road-tax-rubl
     2648                   , output v-transport-base
     2649                   , output v-transport-rubl
     2650                   , output v-other-base
     2651                   , output v-other-rubl
     2652                   , output v-excise-base
     2653                   , output v-excise-rubl
     2654               ).
     2655               assign
     2656                   v-sign = ( if v-fact-qnty >= 0 then 1 else -1 )
     2657               .
     2658               assign
     2659                   v-sum-rubl = v-sum-rubl - v-vat-rubl - v-slt-rubl - v-road-tax-rubl - v-transport-rubl - v-other-rubl - v-excise-rubl
     2660                   v-sum-base = v-sum-base - v-vat-base - v-slt-base - v-road-tax-base - v-transport-base - v-other-base - v-excise-base
     2661                   v-sum-rubl = v-sum-rubl   * v-sign
     2662                   v-sum-base = v-sum-base   * v-sign
     2663                   v-vat-rubl = v-vat-rubl   * v-sign
     2664                   v-vat-base = v-vat-base   * v-sign
     2665                   v-fact-qnty = v-fact-qnty * v-sign
     2666               .
     2667               output to "fbrrep.txt" append .
     2668               put unformatted skip(1) v-fact-qnty "   " v-sum-rubl "    " v-vat-rubl.
     2669               output close.
     2670               assign
     2671                   buf_temp_fbrrep-goods.sum-cost-rubl     = absolute( buf_temp_fbrrep-goods.cost-rubl     * v-fact-qnty ) - absolute( v-sum-rubl )
     2672                   buf_temp_fbrrep-goods.sum-cost-base     = absolute( buf_temp_fbrrep-goods.cost-base     * v-fact-qnty ) - absolute( v-sum-base )
     2673                   buf_temp_fbrrep-goods.sum-vat-cost-rubl = absolute( buf_temp_fbrrep-goods.vat-cost-rubl * v-fact-qnty ) - absolute( v-vat-rubl )
     2674                   buf_temp_fbrrep-goods.sum-vat-cost-base = absolute( buf_temp_fbrrep-goods.vat-cost-base * v-fact-qnty ) - absolute( v-vat-base )
     2675               .
     2676               if buf_temp_fbrrep-goods.fact-qnty          = 0
     2677               and buf_temp_fbrrep-goods.sum-cost-rubl     = 0
     2678               and buf_temp_fbrrep-goods.sum-cost-base     = 0
     2679               and buf_temp_fbrrep-goods.sum-vat-cost-rubl = 0
     2680               and buf_temp_fbrrep-goods.sum-vat-cost-base = 0
     2681               then do:
     2682                   assign
     2683                       buf_temp_fbrrep-goods.deleted = yes
     2684                   .
     2685               end.
     2686           end.
     2687       end.
     2688       for each buf_temp_fbrrep-goods
     2689          where buf_temp_fbrrep-goods.deleted = yes
     2690       on error undo, return error
     2691       :
     2692           delete buf_temp_fbrrep-goods.
     2693       end.
     2694       run test-temp-tables in this-procedure .
     2695   end.
     2696   end procedure.
     2697   procedure test-temp-tables :
     2698   do
     2699   on error undo, return error
     2700   :
     2701       define variable v-str   as character     no-undo.
     2702       assign
     2703           v-str = ""
     2704       .
     2705       for each temp_fbrrep-goods
     2706       :
     2707           assign
     2708               v-str = v-str
     2709                   + chr(10) + temp_fbrrep-goods.artic
     2710                   + chr(9) + string( temp_fbrrep-goods.income-qnty )
     2711                   + chr(9) + string( temp_fbrrep-goods.write-off-qnty )
     2712                   + chr(9) + string( temp_fbrrep-goods.cost-rubl )
     2713                   + chr(9) + string( temp_fbrrep-goods.vat-cost-rubl )
     2714                   + chr(9) + string( temp_fbrrep-goods.sum-cost-rubl )
     2715                   + chr(9) + string( temp_fbrrep-goods.sum-vat-cost-rubl )
     2716                   + chr(9) + string( temp_fbrrep-goods.gds-name )
     2717           .
     2718       end.
     2719       output to "fbrrep.txt" append .
     2720       put unformatted skip(2) v-str.
     2721       output close.
     2722   end.
     2723   end procedure.
     2724   procedure fbrrep-test-fbrdoc-for-fact :
     2725   do
     2726   on error undo, return error
     2727   :
     2728   define output parameter p-have-error        as logical      no-undo.
     2729       define buffer buf_fbr-line          for ub.fbr-line.
     2730       define buffer buf_temp_fbrrep-goods for temp_fbrrep-goods.
     2731       for each buf_temp_fbrrep-goods
     2732       on error undo, return error
     2733       :
     2734       end.
     2735   end.
     2736   end procedure.
     2737   procedure fbrrep-fill-qnty-and-prices-gds :
     2738   do
     2739   on error undo, return error
     2740   :
     2741   define input parameter p-fbr-doc-doc-code   as character    no-undo.
     2742   define input parameter p-gds-code           as integer      no-undo.
     2743       define variable v-sign      as decimal       no-undo.
     2744       define buffer buf_fbr-line          for ub.fbr-line.
     2745       define buffer buf_goods             for ub.goods.
     2746       define buffer buf_temp_fbrrep-goods for temp_fbrrep-goods.
     2747       find first buf_goods no-lock
     2748            where buf_goods.gds-code = p-gds-code
     2749       .
     2750       find first buf_temp_fbrrep-goods
     2751            where buf_temp_fbrrep-goods.artic     = buf_goods.artic
     2752              and buf_temp_fbrrep-goods.prod-type = buf_goods.prod-type
     2753              and buf_temp_fbrrep-goods.prod-code = buf_goods.prod-code
     2754       use-index ar
     2755       no-error.
     2756       if available buf_temp_fbrrep-goods
     2757       then do:
     2758           delete buf_temp_fbrrep-goods.
     2759       end.
     2760       create buf_temp_fbrrep-goods.
     2761   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2762   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     2763     (input  buf_goods.artic
     2764     ,input  buf_goods.prod-type
     2765     ,input  buf_goods.prod-code
     2766     ,input  'gds-goods=request':u
     2767     ,output buf_temp_fbrrep-goods.is-not-office
     2768     )  .
     2769       assign
     2770           buf_temp_fbrrep-goods.gds-code             = p-gds-code
     2771           buf_temp_fbrrep-goods.artic                = buf_goods.artic
     2772           buf_temp_fbrrep-goods.prod-type            = buf_goods.prod-type
     2773           buf_temp_fbrrep-goods.prod-code            = buf_goods.prod-code
     2774           buf_temp_fbrrep-goods.gds-name             = buf_goods.gds-name
     2775           buf_temp_fbrrep-goods.is-waste             = no
     2776           buf_temp_fbrrep-goods.fact-qnty            = 0
     2777           buf_temp_fbrrep-goods.write-off-rsrv-qnty  = 0
     2778           buf_temp_fbrrep-goods.write-off-qnty       = 0
     2779           buf_temp_fbrrep-goods.income-qnty          = 0
     2780           buf_temp_fbrrep-goods.income-rsrv-qnty     = 0
     2781           buf_temp_fbrrep-goods.cost-rubl            = 0
     2782           buf_temp_fbrrep-goods.cost-base            = 0
     2783           buf_temp_fbrrep-goods.sum-cost-rubl        = 0
     2784           buf_temp_fbrrep-goods.sum-cost-base        = 0
     2785           buf_temp_fbrrep-goods.vat-cost-rubl        = 0
     2786           buf_temp_fbrrep-goods.vat-cost-base        = 0
     2787           buf_temp_fbrrep-goods.sum-vat-cost-rubl    = 0
     2788           buf_temp_fbrrep-goods.sum-vat-cost-base    = 0
     2789           buf_temp_fbrrep-goods.price-sale           = 0
     2790           buf_temp_fbrrep-goods.deleted              = no
     2791       .
     2792   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2793   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run unitbase in g#library
     2794     (input  p-gds-code
     2795     ,output buf_temp_fbrrep-goods.unit-base
     2796     )  .
     2797       for each buf_fbr-line no-lock
     2798          where buf_fbr-line.prod-type = buf_goods.prod-type
     2799            and buf_fbr-line.prod-code = buf_goods.prod-code
     2800            and buf_fbr-line.artic     = buf_goods.artic
     2801            and buf_fbr-line.doc-code  = p-fbr-doc-doc-code
     2802       on error undo, return error
     2803       :
     2804           case buf_fbr-line.trn-type
     2805           :
     2806               when 'при':U
     2807               then do:
     2808                   assign
     2809                       v-sign                                          = 1
     2810                       buf_temp_fbrrep-goods.income-qnty               = buf_temp_fbrrep-goods.income-qnty                 + buf_fbr-line.fact-qnty
     2811                       buf_temp_fbrrep-goods.sum-cost-income-rubl      = buf_temp_fbrrep-goods.sum-cost-income-rubl        + ( if buf_fbr-line.price-sum-rubl <> ? then buf_fbr-line.price-sum-rubl        else 0 )
     2812                       buf_temp_fbrrep-goods.sum-cost-income-base      = buf_temp_fbrrep-goods.sum-cost-income-base        + ( if buf_fbr-line.price-sum-rubl <> ? then buf_fbr-line.price-sum-base        else 0 )
     2813                       buf_temp_fbrrep-goods.sum-vat-cost-income-rubl  = buf_temp_fbrrep-goods.sum-vat-cost-income-rubl    + ( if buf_fbr-line.price-sum-rubl <> ? then buf_fbr-line.price-sum-vat-rubl    else 0 )
     2814                       buf_temp_fbrrep-goods.sum-vat-cost-income-base  = buf_temp_fbrrep-goods.sum-vat-cost-income-base    + ( if buf_fbr-line.price-sum-rubl <> ? then buf_fbr-line.price-sum-vat-base    else 0 )
     2815                   .
     2816                   if buf_fbr-line.rsrv-qnty <> ?
     2817                   then do:
     2818                       assign
     2819                           buf_temp_fbrrep-goods.income-rsrv-qnty = buf_temp_fbrrep-goods.income-rsrv-qnty   + buf_fbr-line.rsrv-qnty
     2820                       .
     2821                   end.
     2822               end.
     2823               when 'спи':U
     2824               then do:
     2825                   assign
     2826                       v-sign                                  = -1
     2827                       buf_temp_fbrrep-goods.write-off-qnty    = buf_temp_fbrrep-goods.write-off-qnty      + buf_fbr-line.fact-qnty
     2828                       buf_temp_fbrrep-goods.sum-cost-rubl     = buf_temp_fbrrep-goods.sum-cost-rubl       + ( if buf_fbr-line.price-sum-rubl <> ? then buf_fbr-line.price-sum-rubl        else 0 )
     2829                       buf_temp_fbrrep-goods.sum-cost-base     = buf_temp_fbrrep-goods.sum-cost-base       + ( if buf_fbr-line.price-sum-rubl <> ? then buf_fbr-line.price-sum-base        else 0 )
     2830                       buf_temp_fbrrep-goods.sum-vat-cost-rubl = buf_temp_fbrrep-goods.sum-vat-cost-rubl   + ( if buf_fbr-line.price-sum-rubl <> ? then buf_fbr-line.price-sum-vat-rubl    else 0 )
     2831                       buf_temp_fbrrep-goods.sum-vat-cost-base = buf_temp_fbrrep-goods.sum-vat-cost-base   + ( if buf_fbr-line.price-sum-rubl <> ? then buf_fbr-line.price-sum-vat-base    else 0 )
     2832                   .
     2833                   if buf_fbr-line.rsrv-qnty <> ?
     2834                   then do:
     2835                       assign
     2836                           buf_temp_fbrrep-goods.write-off-rsrv-qnty           = buf_temp_fbrrep-goods.write-off-rsrv-qnty           + buf_fbr-line.rsrv-qnty
     2837                           buf_temp_fbrrep-goods.sum-write-off-rsrv-rubl       = buf_temp_fbrrep-goods.sum-write-off-rsrv-rubl       + ( if buf_fbr-line.price-sum-rubl <> ? then buf_fbr-line.price-sum-rubl        else 0 )
     2838                           buf_temp_fbrrep-goods.sum-write-off-rsrv-base       = buf_temp_fbrrep-goods.sum-write-off-rsrv-base       + ( if buf_fbr-line.price-sum-rubl <> ? then buf_fbr-line.price-sum-base        else 0 )
     2839                           buf_temp_fbrrep-goods.sum-write-off-rsrv-vat-rubl   = buf_temp_fbrrep-goods.sum-write-off-rsrv-vat-rubl   + ( if buf_fbr-line.price-sum-rubl <> ? then buf_fbr-line.price-sum-vat-rubl    else 0 )
     2840                           buf_temp_fbrrep-goods.sum-write-off-rsrv-vat-base   = buf_temp_fbrrep-goods.sum-write-off-rsrv-vat-base   + ( if buf_fbr-line.price-sum-rubl <> ? then buf_fbr-line.price-sum-vat-base    else 0 )
     2841                       .
     2842                   end.
     2843               end.
     2844           end case.
     2845           assign
     2846               buf_temp_fbrrep-goods.is-waste             = buf_fbr-line.is-waste
     2847               buf_temp_fbrrep-goods.price-sale           = buf_fbr-line.price-sale
     2848               buf_temp_fbrrep-goods.cost-income-rubl     = ( if buf_temp_fbrrep-goods.income-qnty     = 0 then 0 else buf_temp_fbrrep-goods.sum-cost-income-rubl      / buf_temp_fbrrep-goods.income-qnty    )
     2849               buf_temp_fbrrep-goods.cost-income-base     = ( if buf_temp_fbrrep-goods.income-qnty     = 0 then 0 else buf_temp_fbrrep-goods.sum-cost-income-base      / buf_temp_fbrrep-goods.income-qnty    )
     2850               buf_temp_fbrrep-goods.vat-cost-income-rubl = ( if buf_temp_fbrrep-goods.income-qnty     = 0 then 0 else buf_temp_fbrrep-goods.sum-vat-cost-income-rubl  / buf_temp_fbrrep-goods.income-qnty    )
     2851               buf_temp_fbrrep-goods.vat-cost-income-base = ( if buf_temp_fbrrep-goods.income-qnty     = 0 then 0 else buf_temp_fbrrep-goods.sum-vat-cost-income-base  / buf_temp_fbrrep-goods.income-qnty    )
     2852               buf_temp_fbrrep-goods.cost-rubl            = ( if buf_temp_fbrrep-goods.write-off-qnty  = 0 then 0 else buf_temp_fbrrep-goods.sum-cost-rubl             / buf_temp_fbrrep-goods.write-off-qnty )
     2853               buf_temp_fbrrep-goods.cost-base            = ( if buf_temp_fbrrep-goods.write-off-qnty  = 0 then 0 else buf_temp_fbrrep-goods.sum-cost-base             / buf_temp_fbrrep-goods.write-off-qnty )
     2854               buf_temp_fbrrep-goods.vat-cost-rubl        = ( if buf_temp_fbrrep-goods.write-off-qnty  = 0 then 0 else buf_temp_fbrrep-goods.sum-vat-cost-rubl         / buf_temp_fbrrep-goods.write-off-qnty )
     2855               buf_temp_fbrrep-goods.vat-cost-base        = ( if buf_temp_fbrrep-goods.write-off-qnty  = 0 then 0 else buf_temp_fbrrep-goods.sum-vat-cost-base         / buf_temp_fbrrep-goods.write-off-qnty )
     2856           .
     2857       end.
     2858       run test-temp-tables in this-procedure .
     2859   end.
     2860   end procedure.
     2861   define stream out-stream.
     2862   do
     2863   on error undo, return error
     2864   :
     2865       define variable v-single-line   as character    no-undo.
     2866       define variable v-underline     as character    no-undo.
     2867       define variable v-organization  as character    no-undo.
     2868       define variable v-line-counter  as integer      no-undo.
     2869       define variable v-today         as date         no-undo.
     2870       define variable v-time          as integer      no-undo.
     2871       define variable v-have-transit  as logical      no-undo.
     2872       define variable v-page-sum-rubl         as decimal       no-undo.
     2873       define variable v-page-sum-base         as decimal       no-undo.
     2874       define variable v-page-sum-vat-rubl     as decimal       no-undo.
     2875       define variable v-page-sum-vat-base     as decimal       no-undo.
     2876       define variable v-page-sum-sale-rubl    as decimal       no-undo.
     2877       define variable v-doc-sum-rubl          as decimal       no-undo.
     2878       define variable v-doc-sum-base          as decimal       no-undo.
     2879       define variable v-doc-sum-vat-rubl      as decimal       no-undo.
     2880       define variable v-doc-sum-vat-base      as decimal       no-undo.
     2881       define variable v-doc-sum-sale-rubl     as decimal       no-undo.
     2882       define variable v-is-base               as logical       no-undo.
     2883       define variable g#report-num    as integer      no-undo.
     2884       define variable g#quest-print   as logical      no-undo.
     2885       define variable g#log           as logical      no-undo.
     2886       define buffer buf_fbr-doc               for fbr-doc.
     2887       define buffer buf_fbr-line              for fbr-line.
     2888       define buffer buf_temp_fbrrep-goods    for temp_fbrrep-goods.
     2889       run get-report-num in p-mainmenu-handle (
     2890           output g#report-num
     2891       ).
     2892       run get-quest-print in p-mainmenu-handle (
     2893           output g#quest-print
     2894       ).
     2895   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2896   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rbisbase in g#library
     2897     (output v-is-base
     2898     )  .
     2899       assign v-single-line = fill( "-", 200 ).
     2900       find first buf_fbr-doc no-lock
     2901            where recid( buf_fbr-doc ) = p-fbr-doc-recid
     2902       .
     2903   if session :set-wait-state( "compiler" ) then.
     2904   output stream out-stream to value( string( session:temp-directory +
     2905                                        "rpt" + string( g#report-num ) ) )
     2906                                        page-size  value(230) .
     2907       assign
     2908           v-single-line  = fill( "-", 230 )
     2909           v-underline    = fill( "_", 230 )
     2910           v-line-counter = 0
     2911       .
     2912       run fmtcli-get-client in this-procedure (
     2913             input buf_fbr-doc.obj-type
     2914           , input buf_fbr-doc.obj-code
     2915       ).
     2916       run cur-time in this-procedure (
     2917             output v-today
     2918           , output v-time
     2919       ).
     2920       put stream Out-Stream
     2921           skip space(3)
     2922               string( "Объект:   ("
     2923                       + buf_fbr-doc.obj-type
     2924                       + " " + string( buf_fbr-doc.obj-code )
     2925                       + ")    " + v-fmtcli-name )                        format "X(190)"
     2926           skip(1) space(3)
     2927               "Дата печати: "
     2928               string( v-today, "99/99/9999" )                 format "X(10)"
     2929               "Акт производства промежуточных ингредиентов"                                   at 3 + 10 + 40
     2930       .
     2931       run print-header in this-procedure (
     2932           input yes
     2933       ).
     2934       run fbrrep-fill-for-fbr-actp in this-procedure (
     2935           input buf_fbr-doc.doc-code
     2936       ).
     2937       for each buf_temp_fbrrep-goods
     2938       on error undo, return error
     2939       :
     2940           assign
     2941               v-have-transit          = yes
     2942               v-line-counter          = v-line-counter + 1
     2943               v-page-sum-rubl         = v-page-sum-rubl      + buf_temp_fbrrep-goods.sum-cost-rubl
     2944               v-page-sum-base         = v-page-sum-base      + buf_temp_fbrrep-goods.sum-cost-base
     2945               v-page-sum-vat-rubl     = v-page-sum-vat-rubl  + buf_temp_fbrrep-goods.sum-vat-cost-rubl
     2946               v-page-sum-vat-base     = v-page-sum-vat-base  + buf_temp_fbrrep-goods.sum-vat-cost-base
     2947               v-page-sum-sale-rubl    = v-page-sum-sale-rubl + ( buf_temp_fbrrep-goods.price-sale * buf_temp_fbrrep-goods.fact-qnty )
     2948           .
     2949           run print-line in this-procedure (
     2950                 input buf_temp_fbrrep-goods.gds-code
     2951               , input p-print-in-rubl
     2952               , input v-is-base
     2953           ).
     2954       end.
     2955       if v-have-transit = no
     2956       then do:
     2957           output stream Out-Stream close.
     2958   if session :set-wait-state( "" ) then.
     2959       end.
     2960       else do:
     2961           run print-footer in this-procedure (
     2962                 input p-print-in-rubl
     2963               , input v-is-base
     2964           ).
     2965           output stream Out-Stream close.
     2966   if session :set-wait-state( "" ) then.
     2967   if g#quest-print = false
     2968   then do:
     2969     run adecomm/_osprint.p ( ?, string( session:temp-directory + "rpt" + string( g#report-num ) ),
     2970                                         7, (if 8 >= 8 then 2 else 0), 0, 0,
     2971                                         OUTPUT g#log ).
     2972   end.
     2973   else do:
     2974     os-command silent
     2975       value( "COPY /b " +
     2976         string( session:temp-directory) +  "$" + string( g#report-num ) + " + " +
     2977         string( session:temp-directory) + "rpt" + string( g#report-num ) + " " +
     2978         string( session:temp-directory) +  "$" + string( g#report-num )
     2979                 ) .
     2980     os-command silent
     2981       value( "COPY /b " +
     2982         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl" + " + " +
     2983         string( session:temp-directory) + "rpt" + string( g#report-num ) + ".txl" + " " +
     2984         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl"
     2985                 ) .
     2986   end.
     2987       end.
     2988   end.
     2989   procedure print-line :
     2990   do
     2991   on error undo, return error
     2992   :
     2993   define input parameter p-gds-code   as integer      no-undo.
     2994   define input parameter p-print-rubl as logical      no-undo.
     2995   define input parameter p-is-base as logical      no-undo.
     2996       define variable v-qnty           as decimal       no-undo.
     2997       define variable v-cost           as decimal       no-undo.
     2998       define variable v-sum-cost       as decimal       no-undo.
     2999       define variable v-sum-vat-cost   as decimal       no-undo.
     3000       define variable v-sum-all-cost   as decimal       no-undo.
     3001       define variable v-price-sale     as decimal       no-undo.
     3002       define variable v-sum-price-sale as decimal       no-undo.
     3003       define variable v-qnty-length           as integer       no-undo.
     3004       define variable v-cost-length           as integer       no-undo.
     3005       define variable v-sum-cost-length       as integer       no-undo.
     3006       define variable v-sum-vat-cost-length   as integer       no-undo.
     3007       define variable v-sum-all-cost-length   as integer       no-undo.
     3008       define variable v-price-sale-length     as integer       no-undo.
     3009       define variable v-sum-price-sale-length as integer       no-undo.
     3010       define buffer buf_temp_fbrrep-goods        for temp_fbrrep-goods.
     3011       find first buf_temp_fbrrep-goods
     3012            where buf_temp_fbrrep-goods.gds-code = p-gds-code
     3013       .
     3014       run print-header in this-procedure (
     3015           input no
     3016       ).
     3017       assign
     3018           v-qnty           = buf_temp_fbrrep-goods.fact-qnty
     3019           v-price-sale     = buf_temp_fbrrep-goods.price-sale
     3020           v-sum-price-sale = buf_temp_fbrrep-goods.price-sale * buf_temp_fbrrep-goods.fact-qnty
     3021       .
     3022       if p-print-rubl = yes
     3023       then do:
     3024           assign
     3025               v-cost           = buf_temp_fbrrep-goods.sum-cost-rubl / buf_temp_fbrrep-goods.fact-qnty
     3026               v-sum-cost       = buf_temp_fbrrep-goods.sum-cost-rubl
     3027               v-sum-vat-cost   = buf_temp_fbrrep-goods.sum-vat-cost-rubl
     3028               v-sum-all-cost   = buf_temp_fbrrep-goods.sum-cost-rubl + buf_temp_fbrrep-goods.sum-vat-cost-rubl
     3029           .
     3030       end.
     3031       else do:
     3032           assign
     3033               v-cost           = buf_temp_fbrrep-goods.sum-cost-base / buf_temp_fbrrep-goods.fact-qnty
     3034               v-sum-cost       = buf_temp_fbrrep-goods.sum-cost-base
     3035               v-sum-vat-cost   = buf_temp_fbrrep-goods.sum-vat-cost-base
     3036               v-sum-all-cost   = buf_temp_fbrrep-goods.sum-cost-base + buf_temp_fbrrep-goods.sum-vat-cost-base
     3037           .
     3038       end.
     3039       assign
     3040           v-qnty-length           = length( string( v-qnty          , "->>,>>9.99"  ) )
     3041           v-cost-length           = length( string( v-cost          , ">>,>>9.99"  ) )
     3042           v-sum-cost-length       = length( string( v-sum-cost      , "->>>,>>>,>>9.99"  ) )
     3043           v-sum-vat-cost-length   = length( string( v-sum-vat-cost  , "->>>,>>>,>>9.99"  ) )
     3044           v-sum-all-cost-length   = length( string( v-sum-all-cost  , "->>>,>>>,>>9.99" ) )
     3045           v-price-sale-length     = length( string( v-price-sale    , ">>,>>9.99" ) )
     3046           v-sum-price-sale-length = length( string( v-sum-price-sale, "->>>,>>>,>>9.99" ) )
     3047       .
     3048       put stream Out-Stream
     3049           skip
     3050               "|"                                                     at 3
     3051               v-line-counter                      format ">>>9"
     3052               "|"                                                     at 3  + 5
     3053               buf_temp_fbrrep-goods.gds-code     format "999999999"
     3054               "|"                                                     at 3  + 15
     3055               buf_temp_fbrrep-goods.artic        format "X(16)"
     3056               "|"                                                     at 3  + 32
     3057               buf_temp_fbrrep-goods.gds-name     format "X(48)"
     3058               "|"                                                     at 3  + 83
     3059               buf_temp_fbrrep-goods.unit-base    format "X(4)"
     3060               "|"                                                     at 3  + 88
     3061               v-qnty                       format "->>,>>9.99"    at right-field( 3  + 100 , v-qnty-length               )
     3062               "|"                                                     at 3  + 100
     3063               v-cost                       format ">>,>>9.99"    at right-field( 3  + 111 , v-cost-length               )
     3064               "|"                                                     at 3  + 111
     3065               v-sum-cost                   format "->>>,>>>,>>9.99"    at right-field( 3  + 128 , v-sum-cost-length           )
     3066               "|"                                                     at 3  + 128
     3067               v-sum-vat-cost               format "->>>,>>>,>>9.99"    at right-field( 3 + 145, v-sum-vat-cost-length       )
     3068               "|"                                                     at 3 + 145
     3069               v-sum-all-cost               format "->>>,>>>,>>9.99"   at right-field( 3 + 162, v-sum-all-cost-length       )
     3070               "|"                                                     at 3 + 162
     3071       .
     3072       if ( p-is-base   = no
     3073           and p-print-rubl = yes )
     3074       or ( p-is-base   = yes
     3075           and p-print-rubl = no )
     3076       then do:
     3077           put stream Out-Stream
     3078                   v-price-sale                 format ">>,>>9.99"   at right-field( 3 + 173, v-price-sale-length         )
     3079           .
     3080       end.
     3081       put stream Out-Stream
     3082               "|"                                             at 3 + 173
     3083       .
     3084       if ( p-is-base   = no
     3085           and p-print-rubl = yes )
     3086       or ( p-is-base   = yes
     3087           and p-print-rubl = no )
     3088       then do:
     3089           put stream Out-Stream
     3090                   v-sum-price-sale             format "->>>,>>>,>>9.99"   at right-field( 3  + 190    ,     v-sum-price-sale-length )
     3091           .
     3092       end.
     3093       put stream Out-Stream
     3094               "|"                                                     at 3  + 190
     3095       .
     3096       if line-counter( Out-stream ) + 2 > page-size( Out-stream )
     3097       then do:
     3098           run print-end-of-page in this-procedure (
     3099                 input p-print-rubl
     3100               , input yes
     3101               , input p-is-base
     3102           ).
     3103       end.
     3104   end.
     3105   end procedure.
     3106   procedure print-header :
     3107   do
     3108   on error undo, return error
     3109   :
     3110   define input parameter p-first  as logical      no-undo.
     3111       if line-counter( Out-stream ) = 0
     3112       or p-first = yes
     3113       then do:
     3114           put stream Out-Stream
     3115               skip string( "Страница " + string( PAGE-NUMBER( Out-Stream ), ">>9" ) ) format "X(13)"   at right-field( 3  + 190, 13)
     3116           .
     3117           put stream Out-Stream
     3118               skip
     3119                   v-single-line           format "X(191)"    at 3
     3120               skip
     3121                   "|"                                                 at 3
     3122                   "N"                                                 at center-field( 3, 3  + 5, 1 )
     3123                   "|"                                                 at 3  + 5
     3124                   "Код"                                               at center-field( 3  + 5, 3  + 15, 3 )
     3125                   "|"                                                 at 3  + 15
     3126                   "Артикул"                                           at center-field( 3  + 15, 3  + 32, 7 )
     3127                   "|"                                                 at 3  + 32
     3128                   "Название товара"                                   at 3  + 32 + 2
     3129                   "|"                                                 at 3  + 83
     3130                   "Ед."                                               at center-field( 3  + 83, 3  + 88, 3 )
     3131                   "|"                                                 at 3  + 88
     3132                   "Количество"                                        at center-field( 3  + 88, 3  + 100, 10 )
     3133                   "|"                                                 at 3  + 100
     3134                   "Уч.цена"                                           at center-field( 3  + 100, 3  + 111, 7 )
     3135                   "|"                                                 at 3  + 111
     3136                   "Сумма уч.цен"                                      at center-field( 3  + 111, 3  + 128, 12 )
     3137                   "|"                                                 at 3  + 128
     3138                   "Сумма НДС"                                         at center-field( 3  + 128, 3 + 145, 9 )
     3139                   "|"                                                 at 3 + 145
     3140                   "Сумма уч.цен"                                      at center-field( 3 + 145, 3 + 162, 12 )
     3141                   "|"                                                 at 3 + 162
     3142                   "Продажная"                                         at center-field( 3 + 162, 3 + 173, 9 )
     3143                   "|"                                                 at 3 + 173
     3144                   "Сумма"                                             at center-field( 3 + 173, 3  + 190, 5 )
     3145                   "|"                                                 at 3  + 190
     3146               skip
     3147                   "|"                                                 at 3
     3148                   "п/п"                                               at center-field( 3, 3  + 5, 3 )
     3149                   "|"                                                 at 3  + 5
     3150                   "|"                                                 at 3  + 15
     3151                   "|"                                                 at 3  + 32
     3152                   "|"                                                 at 3  + 83
     3153                   "изм."                                              at center-field( 3  + 83, 3  + 88, 4 )
     3154                   "|"                                                 at 3  + 88
     3155                   "|"                                                 at 3  + 100
     3156                   "без НДС"                                           at center-field( 3  + 100, 3  + 111, 7 )
     3157                   "|"                                                 at 3  + 111
     3158                   "без НДС"                                           at center-field( 3  + 111, 3  + 128, 7 )
     3159                   "|"                                                 at 3  + 128
     3160                   "|"                                                 at 3 + 145
     3161                   "с НДС"                                             at center-field( 3 + 145, 3 + 162, 5 )
     3162                   "|"                                                 at 3 + 162
     3163                   "цена"                                              at center-field( 3 + 162, 3 + 173, 4 )
     3164                   "|"                                                 at 3 + 173
     3165                   "прод.цен"                                          at center-field( 3 + 173, 3  + 190, 8 )
     3166                   "|"                                                 at 3  + 190
     3167               skip
     3168                   v-single-line           format "X(191)"    at 3
     3169           .
     3170       end.
     3171   end.
     3172   end procedure.
     3173   procedure print-footer :
     3174   do
     3175   on error undo, return error
     3176   :
     3177   define input parameter p-print-rubl as logical      no-undo.
     3178   define input parameter p-is-base    as logical      no-undo.
     3179       define variable v-all-sum-cost as decimal       no-undo.
     3180       if p-print-rubl = yes
     3181       then do:
     3182           assign
     3183               v-all-sum-cost = v-doc-sum-rubl + v-page-sum-rubl + v-doc-sum-vat-rubl + v-page-sum-vat-rubl
     3184           .
     3185       end.
     3186       else do:
     3187           assign
     3188               v-all-sum-cost = v-doc-sum-base + v-page-sum-base + v-doc-sum-vat-base + v-page-sum-vat-base
     3189           .
     3190       end.
     3191       run print-end-of-page in this-procedure (
     3192             input p-print-rubl
     3193           , input no
     3194           , input p-is-base
     3195       ).
     3196       if line-counter( Out-stream ) + 10 > page-size( Out-stream )
     3197       then do:
     3198           page stream out-stream.
     3199       end.
     3200       put stream Out-Stream
     3201           skip (1)
     3202               "Всего промежуточных ингредиентов на сумму (в учетных ценах):   "                       at 3
     3203               v-all-sum-cost                                                      format "->>>,>>>,>>9.99"
     3204       .
     3205       if ( p-is-base   = no
     3206           and p-print-rubl = yes )
     3207       or ( p-is-base   = yes
     3208           and p-print-rubl = no )
     3209       then do:
     3210           put stream Out-Stream
     3211               skip (1)
     3212                   "Всего промежуточных ингредиентов на сумму (в продажных ценах): "                       at 3
     3213                   v-doc-sum-sale-rubl + v-page-sum-sale-rubl                          format "->>>,>>>,>>9.99"
     3214           .
     3215       end.
     3216       put stream Out-Stream
     3217           skip (2)
     3218               "Материально ответственное лицо:_______________________________ "                       at 3
     3219           skip (1)
     3220               "Бухгалтер:____________________________________________________ "                       at 3
     3221           skip (1)
     3222               "Обработал:____________________________________________________ "                       at 3
     3223       .
     3224   end.
     3225   end procedure.
     3226   procedure print-end-of-page :
     3227   do
     3228   on error undo, return error
     3229   :
     3230   define input parameter p-print-rubl             as logical      no-undo.
     3231   define input parameter p-print-continue-line    as logical      no-undo.
     3232   define input parameter p-is-base                as logical      no-undo.
     3233       define variable v-sum-cost       as decimal       no-undo.
     3234       define variable v-sum-vat-cost   as decimal       no-undo.
     3235       define variable v-sum-all-cost   as decimal       no-undo.
     3236       define variable v-sum-price-sale as decimal       no-undo.
     3237       define variable v-sum-cost-length       as integer       no-undo.
     3238       define variable v-sum-vat-cost-length   as integer       no-undo.
     3239       define variable v-sum-all-cost-length   as integer       no-undo.
     3240       define variable v-sum-price-sale-length as integer       no-undo.
     3241       if p-print-rubl = yes
     3242       then do:
     3243           assign
     3244               v-sum-cost       = v-page-sum-rubl
     3245               v-sum-vat-cost   = v-page-sum-vat-rubl
     3246               v-sum-all-cost   = v-page-sum-rubl + v-page-sum-vat-rubl
     3247           .
     3248       end.
     3249       else do:
     3250           assign
     3251               v-sum-cost       = v-page-sum-base
     3252               v-sum-vat-cost   = v-page-sum-vat-base
     3253               v-sum-all-cost   = v-page-sum-base + v-page-sum-vat-base
     3254           .
     3255       end.
     3256       assign
     3257           v-sum-price-sale        = v-page-sum-sale-rubl
     3258           v-sum-cost-length       = length( string( v-sum-cost      , "->>>,>>>,>>9.99"  ) )
     3259           v-sum-vat-cost-length   = length( string( v-sum-vat-cost  , "->>>,>>>,>>9.99"  ) )
     3260           v-sum-all-cost-length   = length( string( v-sum-all-cost  , "->>>,>>>,>>9.99" ) )
     3261           v-sum-price-sale-length = length( string( v-sum-price-sale, "->>>,>>>,>>9.99" ) )
     3262       .
     3263       put stream Out-Stream
     3264           skip
     3265               v-single-line           format "X(191)"    at 3
     3266           skip
     3267               "Итого: "                                           at 3  + 32
     3268               v-sum-cost              format "->>>,>>>,>>9.99"    at right-field( 3  + 128 , v-sum-cost-length       )
     3269               v-sum-vat-cost          format "->>>,>>>,>>9.99"    at right-field( 3 + 145, v-sum-vat-cost-length   )
     3270               v-sum-all-cost          format "->>>,>>>,>>9.99"   at right-field( 3 + 162, v-sum-all-cost-length   )
     3271       .
     3272       if ( p-is-base   = no
     3273           and p-print-rubl = yes )
     3274       or ( p-is-base   = yes
     3275           and p-print-rubl = no )
     3276       then do:
     3277           put stream Out-Stream
     3278                   v-sum-price-sale        format "->>>,>>>,>>9.99"   at right-field( 3  + 190    , v-sum-price-sale-length )
     3279           .
     3280       end.
     3281       if p-print-continue-line = yes
     3282       then do:
     3283           put stream Out-Stream
     3284               skip
     3285                   v-single-line           format "X(191)"    at 3
     3286               skip
     3287                   "Продолжение - на следующей странице"               at 30
     3288           .
     3289       end.
     3290       assign
     3291           v-doc-sum-rubl      = v-doc-sum-rubl      + v-page-sum-rubl
     3292           v-doc-sum-base      = v-doc-sum-base      + v-page-sum-base
     3293           v-doc-sum-vat-rubl  = v-doc-sum-vat-rubl  + v-page-sum-vat-rubl
     3294           v-doc-sum-vat-base  = v-doc-sum-vat-base  + v-page-sum-vat-base
     3295           v-doc-sum-sale-rubl = v-doc-sum-sale-rubl + v-page-sum-sale-rubl
     3296       .
     3297       assign
     3298           v-page-sum-rubl      = 0
     3299           v-page-sum-base      = 0
     3300           v-page-sum-vat-rubl  = 0
     3301           v-page-sum-vat-base  = 0
     3302           v-page-sum-sale-rubl = 0
     3303       .
     3304   end.
     3305   end procedure.
