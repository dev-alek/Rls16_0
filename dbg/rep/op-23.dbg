      707         " | "
      708         v-doc-date format "99/99/9999"
      709         "|" at 97
      710         v-doc-date format "99/99/9999" at  center-field(97, 117, 10)
      711         "|" at 117
      712         v-fact-date format "99/99/9999" at  center-field(117, 137, 10)
      713         "|"  at 137
      714         "______________  _____________________________" format "X(45)" at center-field(137, 3 + 195, 45)
      715      skip
      716         space(64) v-single-line format "X(73)"
      717         "    подпись          расшифровка подписи     " format "X(45)" at center-field(137, 3 + 195, 45)
      718      skip
      719         space(43) "О РАЗДЕЛКЕ МЯСА-СЫРЬЯ НА ПОЛУФАБРИКАТЫ" format "X(41)"
      720         "<    > ________________         г."            format "X(34)" at center-field(137, 3 + 195, 34)
      721   .
      722   form with frame f-doc .
      723   down stream Out-Stream 1 with frame f-doc no-labels.
      724   put stream Out-Stream
      725       skip space(3)
      726         string( "Цены и суммы указаны в рублях"  ) format "X(30)"
      727         ( if buf_fbr-doc.status_ <> 'факт':U
      728           then string( "Статус документа: " + buf_fbr-doc.status_ )
      729           else " " )
      730                                                     at 100 format "X(30)"
      731   .
      732   put stream Out-Stream
      733      skip space(3)
      734        v-single-line format "X(195)"
