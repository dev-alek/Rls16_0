      887   .
      888   run write-header ( input v-single-line
      889                     ,input no
      890                    ).
      891   for each buf_fbr-line
      892      where buf_fbr-line.doc-code = buf_fbr-doc.doc-code
      893      ,each buf_recipe
      894      where buf_recipe.recipe-code = buf_fbr-line.recipe-code
      895        and buf_recipe.recipe-type = 'разделка':U
      896      ,each buf_goods
      897      where buf_goods.artic      = buf_fbr-line.artic
      898        and buf_goods.prod-type  = buf_fbr-line.prod-type
      899        and buf_goods.prod-code  = buf_fbr-line.prod-code
      900   break by buf_recipe.recipe-code
      901         by buf_fbr-line.is-comp descending
      902   :
      903   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
      904     (input  buf_goods.gds-code
      905     ,input  ?
      906     ,output v-bar-code
      907     ) no-error .
      908    .
      909       if error-status:error then
      910       do:
      911       message
      912         vss-workfile + ". Не найден бар-код товара " + buf_goods.artic
      913       view-as alert-box error.
      914           undo, return error .
      915       end.
      916       if buf_fbr-line.is-comp = yes
      917       then do:
      918           find first buf_units no-lock
      919                where buf_units.unit-name = buf_goods.unit-base
      920           .
      921           assign
      922               v-in-price    = (if buf_fbr-line.price-rubl = ? then 0 else buf_fbr-line.price-rubl)
      923               v-in-sum      = (if buf_fbr-line.price-rubl * buf_fbr-line.rsrv-qnty = ?
      924                                then 0
      925                                else buf_fbr-line.price-rubl * buf_fbr-line.rsrv-qnty
      926                               )
      927               v-in-mass     = buf_fbr-line.rsrv-qnty
      928               v-pg-in-mass  = v-pg-in-mass + v-in-mass
      929               v-pg-in-sum   = v-pg-in-sum + v-in-sum
      930           .
      931           display stream out-stream
      932             sym1    buf_goods.artic         @ v-in-goods-artic
      933             sym2    buf_goods.gds-name      @ v-in-goods-name
      934             sym3    v-bar-code              @ v-in-bar-code
      935             sym4    buf_goods.unit-base     @ v-in-unit-name
      936             sym5    buf_units.OKEI          @ v-in-unit-OKEI
      937             sym6    v-in-price
      938             sym7    v-in-mass
      939             sym8    v-in-sum
      940           with frame f-doc.
      941       end.
      942       else do:
      943           find first buf_recipe-gds no-lock
      944                where buf_recipe-gds.recipe-code = buf_recipe.recipe-code
      945                  and buf_recipe-gds.prod-type   = buf_goods.prod-type
      946                  and buf_recipe-gds.prod-code   = buf_goods.prod-code
      947                  and buf_recipe-gds.artic       = buf_goods.artic
      948           .
      949           assign
      950               v-out-norm-prc  = buf_recipe-gds.qnty / buf_recipe.qnty * 100
      951               v-out-norm-mass = buf_recipe-gds.qnty / buf_recipe.qnty * v-in-mass
      952               v-out-norm-mass = (if v-out-norm-mass = ? then 0 else v-out-norm-mass )
      953               v-out-price     = (if buf_fbr-line.price-rubl = ? then 0 else buf_fbr-line.price-rubl)
      954               v-out-sum       = (if buf_fbr-line.price-rubl * buf_fbr-line.rsrv-qnty = ?
      955                                  then 0
      956                                  else buf_fbr-line.price-rubl * buf_fbr-line.rsrv-qnty
      957                                 )
      958               v-out-fact-mass     = buf_fbr-line.fact-qnty
      959               v-pg-out-norm-mass  = v-pg-out-norm-mass  + v-out-norm-mass
      960               v-pg-out-fact-mass  = v-pg-out-fact-mass  + v-out-fact-mass
      961               v-pg-out-fact-sum   = v-pg-out-fact-sum   + v-out-sum
      962               v-deviation = (if (v-out-fact-mass - v-out-norm-mass) < 0
      963                              then "-"
      964                              else (if (v-out-fact-mass - v-out-norm-mass) > 0 then "+" else "")
      965                             )
      966           .
      967           display stream out-stream
      968             sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8
      969             sym9    buf_goods.artic         @ v-out-goods-artic
      970             sym10   buf_goods.gds-name      @ v-out-goods-name
      971             sym11   v-bar-code              @ v-out-bar-code
      972             sym12   v-out-norm-prc
      973             sym13   v-out-norm-mass
      974             sym14
      975             sym15
      976             sym16   v-out-norm-mass         @ v-out-sum-norm-mass
      977             sym17   v-out-price
      978             sym18   v-out-fact-mass
      979             sym19   v-out-sum
      980             sym20   v-deviation
      981             sym21
      982           with frame f-doc.
      983           down stream out-stream 1 with frame f-doc.
      984       end.
      985       if line-counter( Out-Stream ) + 1 > page-size( Out-Stream )
      986       then do:
      987           run write-itog( input "Итого"
      988                          ,input v-pg-in-mass
      989                          ,input v-pg-in-sum
      990                          ,input v-pg-out-norm-mass
      991                          ,input v-pg-out-fact-mass
      992                          ,input v-pg-out-fact-sum
      993                         ).
      994           assign
      995               v-sum-in-mass       = v-sum-in-mass       + v-pg-in-mass
      996               v-sum-in-sum        = v-sum-in-sum        + v-pg-in-sum
      997               v-sum-out-norm-mass = v-sum-out-norm-mass + v-pg-out-norm-mass
      998               v-sum-out-fact-mass = v-sum-out-fact-mass + v-pg-out-fact-mass
      999               v-sum-out-fact-sum  = v-sum-out-fact-sum  + v-pg-out-fact-sum
     1000               v-pg-in-mass        = 0
     1001               v-pg-in-sum         = 0
     1002               v-pg-out-norm-mass  = 0
     1003               v-pg-out-fact-mass  = 0
     1004               v-pg-out-fact-sum   = 0
     1005           .
     1006           down stream out-stream 1 with frame f-doc.
     1007           run write-header(   input v-single-line
     1008                             , input yes
     1009                           ).
     1010       end.
     1011   end.
     1012   hide stream Out-Stream frame BottomFrame .
     1013   if line-counter( Out-Stream ) + 9 > page-size( Out-Stream )
     1014   then do:
     1015       run write-itog(   input "Итого"
     1016                       , input v-pg-in-mass
     1017                       , input v-pg-in-sum
     1018                       , input v-pg-out-norm-mass
     1019                       , input v-pg-out-fact-mass
     1020                       , input v-pg-out-fact-sum
     1021                     ).
     1022       assign
     1023           v-sum-in-mass       = v-sum-in-mass       + v-pg-in-mass
     1024           v-sum-in-sum        = v-sum-in-sum        + v-pg-in-sum
     1025           v-sum-out-norm-mass = v-sum-out-norm-mass + v-pg-out-norm-mass
     1026           v-sum-out-fact-mass = v-sum-out-fact-mass + v-pg-out-fact-mass
     1027           v-sum-out-fact-sum  = v-sum-out-fact-sum  + v-pg-out-fact-sum
     1028       .
     1029       page stream Out-Stream .
     1030       run write-header(   input v-single-line
     1031                         , input yes
     1032                       ).
     1033   end.
     1034   else do:
     1035       run write-itog(   input "Итого"
     1036                               , input v-pg-in-mass
     1037                               , input v-pg-in-sum
     1038                               , input v-pg-out-norm-mass
     1039                               , input v-pg-out-fact-mass
     1040                               , input v-pg-out-fact-sum
     1041                     ).
     1042               assign
     1043                   v-sum-in-mass       = v-sum-in-mass       + v-pg-in-mass
     1044                   v-sum-in-sum        = v-sum-in-sum        + v-pg-in-sum
     1045                   v-sum-out-norm-mass = v-sum-out-norm-mass + v-pg-out-norm-mass
     1046                   v-sum-out-fact-mass = v-sum-out-fact-mass + v-pg-out-fact-mass
     1047                   v-sum-out-fact-sum  = v-sum-out-fact-sum  + v-pg-out-fact-sum
     1048               .
     1049   end.
     1050   run write-itog( input "Всего"
     1051                   ,input v-sum-in-mass
     1052                   ,input v-sum-in-sum
     1053                   ,input v-sum-out-norm-mass
     1054                   ,input v-sum-out-fact-mass
     1055                   ,input v-sum-out-fact-sum
     1056                 ).
     1057   down stream Out-Stream 2 with frame f-doc .
     1058   put stream Out-Stream
     1059       skip(1) space(10)
     1060         "Переработано мяса-сырья"
     1061         v-sum-in-mass format ">>>>>>9.99" at  10 + 37
     1062         space(2) "кг"
     1063         "Выработано полуфабрикатов"               at 10 + 97
     1064         v-sum-out-fact-mass format ">>>>>>9.99"    at 10 + 147
     1065         space(2) "кг"
     1066       skip space(10)
     1067         v-underline format "X(185)"
     1068       skip(1) space(10)
     1069         "Представитель администрации"
     1070         v-underline format "X(10)"                at 10 + 17 + 13
     1071         v-underline format "X(15)"                at 10 + 37 + 4
     1072         v-underline format "X(30)"                at 10 + 57
     1073         "Заведующий производством"                at 10 + 97
     1074         v-underline format "X(19)"                at 10 + 127
     1075         v-underline format "X(30)"                at 10 + 147
     1076       skip space(10)
     1077         "должность"                               at center-field( 10 + 17 + 13, 10 + 37 + 4, 9)
     1078         "подпись"                                 at center-field( 10 + 37 + 4, 10 + 57, 6)
     1079         "расшифровка подписи"                     at center-field( 10 + 57, 10 + 57 + 30, 19)
     1080         "подпись"                                 at center-field( 10 + 127, 10 + 147, 6)
     1081         "расшифровка подписи"                     at center-field( 10 + 147, 10 + 177, 19)
     1082       skip space(10)
     1083         "Мастер (бригадир)"
     1084         v-underline format "X(19)"                at 10 + 37
     1085         v-underline format "X(30)"                at 10 + 57
     1086         v-underline format "X(19)"                at 10 + 107
     1087         v-underline format "X(19)"                at 10 + 127
     1088         v-underline format "X(30)"                at 10 + 147
     1089       skip space(10)
     1090         "подпись"                                 at center-field( 10 + 37, 10 + 57, 6)
     1091         "расшифровка подписи"                     at center-field( 10 + 57, 10 + 57 + 30, 19)
     1092         "должность"                               at center-field( 10 + 107, 10 + 127, 9)
     1093         "подпись"                                 at center-field( 10 + 127, 10 + 147, 6)
     1094         "расшифровка подписи"                     at center-field( 10 + 147, 10 + 177, 19)
     1095       skip space(10)
     1096         "Проверил бухгалтер"
     1097         v-underline format "X(19)"                at 10 + 37
     1098         v-underline format "X(30)"                at 10 + 57
     1099         "Приложение ________________________________________ документов"       at 10 + 97
     1100       skip space(10)
     1101         "подпись"                                 at center-field( 10 + 37, 10 + 57, 6)
     1102         "расшифровка подписи"                     at center-field( 10 + 57, 10 + 57 + 30, 19)
     1103   .
     1104   output stream Out-Stream close.
     1105   if session :set-wait-state( "" ) then.
     1106   if g#quest-print = false
     1107   then do:
     1108     run adecomm/_osprint.p ( ?, string( session:temp-directory + "rpt" + string( g#report-num ) ),
     1109                                         7, (if 8 >= 8 then 2 else 0), 0, 0,
     1110                                         OUTPUT g#log ).
     1111   end.
     1112   else do:
     1113     os-command silent
     1114       value( "COPY /b " +
     1115         string( session:temp-directory) +  "$" + string( g#report-num ) + " + " +
     1116         string( session:temp-directory) + "rpt" + string( g#report-num ) + " " +
     1117         string( session:temp-directory) +  "$" + string( g#report-num )
     1118                 ) .
     1119     os-command silent
     1120       value( "COPY /b " +
     1121         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl" + " + " +
     1122         string( session:temp-directory) + "rpt" + string( g#report-num ) + ".txl" + " " +
     1123         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl"
     1124                 ) .
     1125   end.
     1126   end.
     1127   procedure write-header :
     1128   do
     1129   on error undo, return error
     1130   :
     1131   def input parameter p-single-line as char    no-undo.
     1132   def input parameter p-need-line   as logical no-undo.
     1133       if p-need-line = yes
     1134       then put stream out-stream
     1135           skip
     1136             string( "Страница " + string( PAGE-NUMBER( Out-Stream ), ">>9" ) ) format "X(13)" at right-field( 3 + 195, 13)
     1137           skip space(3)
     1138             p-single-line format "X(195)"
     1139       .
     1140       put stream out-stream
     1141           skip space(3)
     1142             "|"
     1143             "1"                  at center-field( 3, 3 + 18, 1)
     1144             ":"                  at 3 + 18
     1145             "2"                  at center-field( 3 + 18, 3 + 40, 1)
     1146             ":"                  at 3 + 40
     1147             "3"                  at center-field( 3 + 40, 3 + 50, 1)
     1148             ":"                  at 3 + 50
     1149             "4"                  at center-field( 3 + 50, 3 + 54, 1)
     1150             ":"                  at 3 + 54
     1151             "5"                  at center-field( 3 + 54, 3 + 58, 1)
     1152             ":"                  at 3 + 58
     1153             "6"                  at center-field( 3 + 58, 3 + 67, 1)
     1154             ":"                  at 3 + 67
     1155             "7"                  at center-field( 3 + 67, 3 + 75, 1)
     1156             ":"                  at 3 + 75
     1157             "8"                  at center-field( 3 + 75, 3 + 85, 1)
     1158             ":"                  at 3 + 85
     1159             "9"                  at center-field( 3 + 85, 3 + 102, 1)
     1160             ":"                  at 3 + 102
     1161             "10"                 at center-field( 3 + 102, 3 + 123, 2)
     1162             ":"                  at 3 + 123
     1163             "11"                 at center-field( 3 + 123, 3 + 133, 2)
     1164             ":"                  at 3 + 133
     1165             "12"                 at center-field( 3 + 133, 3 + 138, 2)
     1166             ":"                  at 3 + 138
     1167             "13"                 at center-field( 3 + 138, 3 + 146, 2)
     1168             ":"                  at 3 + 146
     1169             "14"                 at center-field( 3 + 146, 3 + 151, 2)
     1170             ":"                  at 3 + 151
     1171             "15"                 at center-field( 3 + 151, 3 + 158, 2)
     1172             ":"                  at 3 + 158
     1173             "16"                 at center-field( 3 + 158, 3 + 166, 2)
     1174             ":"                  at 3 + 166
     1175             "17"                 at center-field( 3 + 166, 3 + 175, 2)
     1176             ":"                  at 3 + 175
     1177             "18"                 at center-field( 3 + 175, 3 + 183, 2)
     1178             ":"                  at 3 + 183
     1179             "19"                 at center-field( 3 + 183, 3 + 193, 2)
     1180             ":"                  at 3 + 193
     1181             "X"
     1182             "|"                  at 3 + 195
     1183           skip space(3)
     1184             "|"
     1185             p-single-line format "X(193)"
     1186             "|"                  at 3 + 195
     1187       .
     1188   end.
     1189   end procedure.
     1190   procedure write-itog :
     1191   do
     1192   on error undo, return error
     1193   :
     1194       define input parameter p-type          as char no-undo.
     1195       define input parameter p-in-mass       as decimal no-undo.
     1196       define input parameter p-in-sum        as decimal no-undo.
     1197       define input parameter p-out-norm-mass as decimal no-undo.
     1198       define input parameter p-out-fact-mass as decimal no-undo.
     1199       define input parameter p-out-fact-sum  as decimal no-undo.
     1200       put stream Out-Stream
     1201         skip space(3)
     1202           v-single-line format "X(195)"
     1203       .
     1204       display stream out-stream
     1205                 p-type                              @ v-in-price
     1206         sym7    p-in-mass       format ">>>9.99"    @ v-in-mass
     1207         sym8    p-in-sum        format ">>>>>9.99"  @ v-in-sum
     1208         sym13   p-out-norm-mass format ">>>9.99"    @ v-out-norm-mass
     1209         sym14
     1210         sym15   p-out-norm-mass format ">>>9.99"    @ v-out-sum-norm-mass
     1211         sym16   p-out-norm-mass format ">>>9.99"    @ v-out-norm-mass
     1212         sym17
     1213         sym18   p-out-fact-mass format ">>>9.99"    @ v-out-fact-mass
     1214         sym19   p-out-fact-sum  format ">>>>>9.99"  @ v-out-sum
     1215         sym21
     1216       with frame f-doc.
     1217   end.
     1218   end procedure.
