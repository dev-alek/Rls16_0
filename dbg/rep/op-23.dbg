      121   FUNCTION center-field RETURNS INTEGER (INPUT iStartPix AS INTEGER, iEndPix AS INTEGER,
      122                                     iInput AS INTEGER).
      123     def var v-start-print as integer no-undo .
      124     if (iStartPix < 0) or (iEndPix < iStartPix) then return 0.
      125     assign
      126       v-start-print = INTEGER(iStartPix + ((iEndPix - iStartPix) / 2) - (iInput / 2))
      127     .
      128     RETURN v-start-print .
      129   END FUNCTION.
      130   FUNCTION right-field RETURNS INTEGER ( iEndPix AS INTEGER,
      131                                     iInput AS INTEGER).
      132     def var v-start-print as integer no-undo .
      133     assign
      134       v-start-print = INTEGER(iEndPix - 1 - iInput)
      135     .
      136     if v-start-print < 0 then return 0.
      137     RETURN v-start-print .
      138   END FUNCTION.
      139   function p-fmt-align-string returns character (
      140         p-in-string      as character
      141       , p-page-width     as integer
      142       , p-align-type     as character
      143   ).
      144       define variable v-string-length     as integer      no-undo.
      145       define variable v-out-string        as character    no-undo.
      146       assign
      147           v-string-length = length( trim( p-in-string ) )
      148       .
      149       if v-string-length >= p-page-width
      150       then do:
      151           assign
      152               v-out-string = trim( p-in-string )
      153           .
      154       end.
      155       else do:
      156           case p-align-type
      157           :
      158               when 'left':U
      159               then do:
      160                   assign
      161                       v-out-string = trim( p-in-string )
      162                   .
      163               end.
      164               when 'right':U
      165               then do:
      166                   assign
      167                       v-out-string = fill( " ":U, p-page-width - v-string-length ) + trim( p-in-string )
      168                   .
      169               end.
      170               when 'center':U
      171               then do:
      172                   assign
      173                       v-out-string = fill( " ":U, integer( ( p-page-width - v-string-length ) / 2 ) ) + trim( p-in-string )
      174                   .
      175               end.
      176           end case.
      177       end.
      178       return v-out-string .
      179   end function.
      180   procedure p-fmt-split-string :
      181   define input parameter p-source-string  as character        no-undo.
      182   define input parameter p-split-length   as integer          no-undo.
      183   define output parameter p-string-1      as character        no-undo.
      184   define output parameter p-string-2      as character        no-undo.
      185   do
      186   on error undo, return error
      187   :
      188       define variable v-space-pos    as integer      no-undo.
      189       if length( p-source-string ) <= p-split-length
      190       then do:
      191           assign
      192               p-string-1 = p-source-string
      193           .
      194       end.
      195       else do:
      196           assign
      197               v-space-pos = r-index( p-source-string, " ":U, p-split-length )
      198           .
      199           if v-space-pos = 0
      200           then do:
      201               assign
      202                   v-space-pos = index( p-source-string, " ":U )
      203               .
      204           end.
      205           if v-space-pos = 0
      206           then do:
      207               assign
      208                   p-string-1 = substring( p-source-string, 1, p-split-length )
      209                   p-string-2 = trim( substring( p-source-string, p-split-length, p-split-length ) )
      210               .
      211           end.
      212           else do:
      213               assign
      214                   p-string-1 = substring( p-source-string, 1, v-space-pos )
      215                   p-string-2 = trim( substring( p-source-string, v-space-pos ) )
      216               .
      217           end.
      218       end.
      219   end.
      220   end procedure.
      221   procedure p-fmt-round :
      222   define input parameter p-qnty               as decimal          no-undo.
      223   define input parameter p-price-no-VAT       as decimal          no-undo.
      224   define input parameter p-VAT                as decimal          no-undo.
      225   define input parameter p-SLT                as decimal          no-undo.
      226   define input parameter p-road-tax           as decimal          no-undo.
      227   define output parameter p-new-price-no-VAT  as decimal          no-undo.
      228   define output parameter p-new-VAT           as decimal          no-undo.
      229   define output parameter p-new-SLT           as decimal          no-undo.
      230   define output parameter p-new-sum-VAT       as decimal          no-undo.
      231   define output parameter p-new-sum-SLT       as decimal          no-undo.
      232   define output parameter p-new-sum-road-tax  as decimal          no-undo.
      233   define output parameter p-new-sum-no-VAT    as decimal          no-undo.
      234   define output parameter p-new-sum-full      as decimal          no-undo.
      235       define variable v-vat-pc    as decimal      no-undo.
      236       define variable v-slt-pc    as decimal      no-undo.
      237   do
      238   on error undo, return error
      239   :
      240       if p-price-no-VAT = 0
      241       then do:
      242           assign
      243               p-new-price-no-VAT = 0.0
      244               p-new-VAT          = ?
      245               p-new-SLT          = ?
      246               p-new-sum-VAT      = 0.0
      247               p-new-sum-SLT      = 0.0
      248               p-new-sum-no-VAT   = 0.0
      249               p-new-sum-road-tax = 0.0
      250               p-new-sum-full     = 0.0
      251           .
      252       end.
      253       else do:
      254           assign
      255               v-vat-pc            = p-VAT / p-price-no-VAT
      256               v-slt-pc            = p-SLT / ( p-price-no-VAT + p-VAT )
      257               p-new-price-no-VAT  = round( p-price-no-VAT, 2 )
      258               p-new-VAT           = round( p-new-price-no-VAT * v-vat-pc, 2 )
      259               p-new-SLT           = round( ( p-new-price-no-VAT + p-new-VAT ) * v-slt-pc, 2 )
      260               p-new-sum-VAT       = round( p-new-VAT          * p-qnty, 2 )
      261               p-new-sum-SLT       = round( ( p-new-price-no-VAT + p-new-VAT ) * p-qnty * v-slt-pc, 2 )
      262               p-new-sum-no-VAT    = round( p-new-price-no-VAT * p-qnty, 2 )
      263               p-new-sum-road-tax  = round( p-road-tax * p-qnty, 2 )
      264               p-new-sum-full      = round( ( p-new-price-no-VAT + p-new-VAT + p-new-SLT + p-road-tax ) * p-qnty, 2 )
      265           .
      266       end.
      267   end.
      268   end procedure.
      269   procedure p-fmt-split :
      270   define input parameter p-in-string      as character        no-undo.
      271   define input parameter p-split-length   as integer          no-undo.
      272       define variable v-start-pos     as integer      no-undo.
      273       define variable v-end-pos       as integer      no-undo.
      274       define buffer buf_temp_p-fmt_string-part        for temp_p-fmt_string-part.
      275   do
      276   for buf_temp_p-fmt_string-part
      277   on error undo, return error
      278   :
      279       empty temp-table buf_temp_p-fmt_string-part.
      280       if p-split-length < 1
      281       then do:
      282           undo, return error substitute( "p-fmt-split: Строка не может быть разбита на &1 частей", p-split-length ).
      283       end.
      284       assign
      285           p-in-string                 = trim( p-in-string )
      286           v-p-fmt-1-str-key   = 0
      287           v-start-pos                 = 1
      288           v-end-pos                   = length( p-in-string )
      289       .
      290       run p-fmt-get-string-range in this-procedure (
      291             input p-in-string
      292           , input p-split-length
      293           , input v-start-pos
      294           , output v-start-pos
      295           , output v-end-pos
      296       ).
      297       do while v-end-pos <> 0
      298       :
      299           create buf_temp_p-fmt_string-part.
      300           assign
      301               v-p-fmt-1-str-key = v-p-fmt-1-str-key + 1
      302           .
      303           assign
      304               buf_temp_p-fmt_string-part.str-key      = v-p-fmt-1-str-key
      305               buf_temp_p-fmt_string-part.string-part  = substring( p-in-string, v-start-pos, v-end-pos - v-start-pos )
      306           .
      307           assign
      308               v-start-pos = v-end-pos + 1
      309           .
      310           run p-fmt-get-string-range in this-procedure (
      311                 input p-in-string
      312               , input p-split-length
      313               , input v-start-pos
      314               , output v-start-pos
      315               , output v-end-pos
      316           ).
      317       end.
      318   end.
      319   end procedure.
      320   procedure p-fmt-get-string-range :
      321   define input parameter p-in-string      as character        no-undo.
      322   define input parameter p-split-length   as integer          no-undo.
      323   define input parameter p-old-start-pos  as integer          no-undo.
      324   define output parameter p-start-pos     as integer          no-undo.
      325   define output parameter p-end-pos       as integer          no-undo.
      326       define variable v-init-string    as character    no-undo.
      327       define variable v-temp-char      as character    no-undo.
      328       define variable v-temp-pos       as integer      no-undo.
      329       define variable v-counter        as integer      no-undo.
      330   do
      331   on error undo, return error
      332   :
      333       assign
      334           p-start-pos   = p-old-start-pos
      335           v-init-string = substring( p-in-string, p-start-pos )
      336       no-error.
      337       if error-status :error
      338       or trim( v-init-string ) = "":U
      339       then do:
      340           assign
      341               p-end-pos = 0
      342           .
      343           undo, return .
      344       end.
      345       assign
      346           v-temp-char   = substring( v-init-string, 1, 1 )
      347       .
      348       do
      349       while trim( v-temp-char ) = "":U
      350       :
      351           assign
      352               p-start-pos     = p-start-pos + 1
      353               v-init-string   = substring( p-in-string, p-start-pos )
      354               v-temp-char     = substring( v-init-string, 1, 1 )
      355           .
      356       end.
      357       assign
      358           v-temp-pos  = p-split-length
      359           v-temp-char = substring( v-init-string, v-temp-pos, 1 )
      360           v-counter   = 0
      361       .
      362       search-word-end:
      363       do
      364       while trim( v-temp-char ) <> "":U
      365       :
      366           assign
      367               v-counter   = v-counter + 1
      368           .
      369           if v-counter > 20
      370           then do:
      371               assign
      372                   v-temp-pos  = p-split-length
      373               .
      374               leave search-word-end.
      375           end.
      376           assign
      377               v-temp-pos  = v-temp-pos - 1
      378               v-temp-char = substring( v-init-string, v-temp-pos, 1 )
      379           .
      380       end.
      381       assign
      382           p-end-pos = p-start-pos + v-temp-pos - 1
      383       .
      384   end.
      385   end procedure.
