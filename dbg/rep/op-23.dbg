      484   DEFINE frame f-doc
      485           space(3)
      486           sym1  format "X(1)" space(0)   v-in-goods-artic    format "X(16)"     space(0)
      487           sym2  format "X(1)" space(0)   v-in-goods-name     format "X(21)"     space(0)
      488           sym3  format "X(1)" space(0)   v-in-bar-code       format ">>>>>>>>9" space(0)
      489           sym4  format "X(1)" space(0)   v-in-unit-name      format "X(3)"      space(0)
      490           sym5  format "X(1)" space(0)   v-in-unit-OKEI      format "X(3)"      space(0)
      491           sym6  format "X(1)" space(0)   v-in-price          format ">>>>9.99"  space(0)
      492           sym7  format "X(1)" space(0)   v-in-mass           format ">>>9.99"   space(0)
      493           sym8  format "X(1)" space(0)   v-in-sum            format ">>>>>9.99" space(0)
      494           sym9  format "X(1)" space(0)   v-out-goods-artic   format "X(16)"     space(0)
      495           sym10 format "X(1)" space(0)   v-out-goods-name    format "X(20)"     space(0)
      496           sym11 format "X(1)" space(0)   v-out-bar-code      format ">>>>>>>>9" space(0)
      497           sym12 format "X(1)" space(0)   v-out-norm-prc      format  ">9.9"     space(0)
      498           sym13 format "X(1)" space(0)   v-out-norm-mass     format ">>>9.99"   space(0)
      499           sym14 format "X(1)" space(0)   v-out-norm-prc-emp  format "X(4)"      space(0)
      500           sym15 format "X(1)" space(0)   v-out-norm-mass-emp format "X(6)"      space(0)
      501           sym16 format "X(1)" space(0)   v-out-sum-norm-mass format ">>>9.99"   space(0)
      502           sym17 format "X(1)" space(0)   v-out-price         format ">>>>9.99"  space(0)
      503           sym18 format "X(1)" space(0)   v-out-fact-mass     format ">>>9.99"   space(0)
      504           sym19 format "X(1)" space(0)   v-out-sum           format ">>>>>9.99" space(0)
      505           sym20 format "X(1)" space(0)   v-deviation         format "X(1)"      space(0)
      506           sym21 format "X(1)" space(0)
      507   with width 235 down stream-io.
      508   assign
      509       v-single-line  = fill("-", 230)
      510       v-underline    = fill("_", 230)
      511       v-line-counter = 1
      512   .
      513   assign
      514       v-doc-code  = buf_fbr-doc.doc-code
      515       v-doc-date  = buf_fbr-doc.doc-date
      516       v-fact-date = (if buf_fbr-doc.status_ <> 'факт':U then ? else buf_fbr-doc.fact-date )
      517   .
      518   find first buf_clients no-lock
      519        where buf_clients.obj-type = buf_fbr-doc.obj-type
      520          and buf_clients.obj-code = buf_fbr-doc.obj-code
      521   no-error.
      522   case buf_clients.obj-type :
      523       when 'маг':U then
      524           do:
      525               find first shop no-lock
      526                    where shop.obj-code = buf_clients.obj-code
      527               .
      528           end.
      529       when 'скл':U then
      530           do:
      531               find first store no-lock
      532                    where store.obj-code = buf_clients.obj-code
      533               .
      534           end.
      535   end case.
      536   assign
      537       v-org-name = buf_clients.obj-name
      538   .
      539   if session:set-wait-state("compiler") then.
      540   output stream Out-Stream to value( string( session:temp-directory +
      541                                        "rpt" + string( g#report-num ) ) )
      542                                        page-size  value(43) .
      543   form header
      544       v-single-line format "X(195)" at 1 skip
      545       "Продолжение - на следующей странице" at 30 skip
      546       with frame BottomFrame width 235 page-bottom no-labels no-box .
      547   view stream Out-Stream frame BottomFrame .
      548   find first clients no-lock
      549        where clients.obj-type = 'орг':U
      550          and clients.obj-code = buf_fbr-doc.host-code
      551   .
      552       case clients.obj-type:
      553          when 'орг':U
      554          then do:
      555               FIND ub.firm WHERE ub.firm.firm-code = clients.obj-code NO-LOCK .
      556               if available ub.firm
      557               then do:
      558                   assign
      559                       t-addres = ( if ub.firm.ind = 0 or ub.firm.ind = ? then "" else string( ub.firm.ind ) )
      560                       t-addres = t-addres
      561                           + ( if ub.firm.city = ? or trim(ub.firm.city) = ""
      562                               then ""
      563                               else ( (if t-addres = "" then "" else ", ") + trim( ub.firm.city ) )
      564                             )
      565                       t-temp-address = ( if ub.firm.addres1 = ? then "" else trim( substring( ub.firm.addres1, 1, 50 ) ) )
      566                       t-addres = t-addres + ( if t-addres = "" or t-temp-address = "" then "" else ", " )
      567                           + ( if t-temp-address = "" then "" else ( trim( t-temp-address ) ) )
      568                           + ( if  ub.firm.addres2 = ? or trim(ub.firm.addres2) = "" then "" else ( ", " + trim( ub.firm.addres2 ) ) )
      569                       t-temp-address = ( if ub.firm.addres1 = ? then "" else trim( substring( ub.firm.addres1, 51, 50 ) ) )
      570                       t-addres = t-addres + ( if t-addres = "" or t-temp-address = "" then "" else ", " )
      571                           + ( if t-temp-address = "" then "" else ( trim( t-temp-address ) ) )
      572                       t-temp-address = ( if ub.firm.addres1 = ? then "" else trim( substring( ub.firm.addres1, 101, 50 ) ) )
      573                       t-addres = t-addres + ( if t-addres = "" or t-temp-address = "" then "" else ", " )
      574                           + ( if t-temp-address = "" then "" else ( trim( t-temp-address ) ) )
      575                       t-phone = ub.firm.phone
      576                       t-inn   = ub.firm.inn
      577                       t-okpo  = ub.firm.okpo
      578                   .
      579               end.
      580          end.
      581          when 'маг':U
      582          then do:
      583               FIND ub.shop WHERE ub.shop.obj-code = clients.obj-code NO-LOCK .
      584               if available ub.shop
      585               then do:
      586                   assign
      587                       t-addres = ( if trim( shop.addres1 ) <> "" then ( trim( shop.addres1 ) ) else "" )
      588                               + ( if trim( shop.addres2 ) <> "" then ( ", " + trim( shop.addres2 ) ) else "" )
      589                       t-phone = shop.phone
      590                       t-inn = ""
      591                       t-okpo = ""
      592                   .
      593               end.
      594          end.
      595          when 'скл':U
      596          then do:
      597               FIND ub.store WHERE ub.store.obj-code = clients.obj-code NO-LOCK .
      598               if available ub.store
      599               then do:
      600                   assign
      601                       t-addres = ( if trim( ub.store.addres1 ) <> "" then ( trim( ub.store.addres1 ) ) else "" )
      602                               + ( if trim( ub.store.addres2 ) <> "" then ( ", " + trim( ub.store.addres2 ) ) else "" )
      603                       t-phone = ub.store.phone
      604                       t-inn = ""
      605                       t-okpo = ""
      606                   .
      607               end.
      608          end.
      609          when 'чел':U
      610          then do:
      611               find ub.person where ub.person.psn-code = clients.obj-code no-lock .
      612               if available ub.person
      613               then do:
      614                   assign
      615                       t-addres = ( if ub.person.ind <> 0 and ub.person.ind <> ? then string( ub.person.ind ) else "" )
      616                                   + ( if  ub.person.city <> ? and trim(ub.person.city) <> "" then ( ", " + trim( ub.person.city ) ) else "" )
      617                                   + ( if  ub.person.address <> ? and trim(ub.person.address) <> "" then ( ", " + trim( ub.person.address ) ) else "" )
      618                       t-phone = ub.person.phone1
      619                       t-inn = ub.person.inn
      620                       t-okpo = ub.person.okpo
      621                   .
      622               end.
      623          end.
      624       end case.
      625   assign
      626       v-organization = string( "ИНН " + t-inn + " " + CAPS( clients.obj-name ) + " (" + string(clients.obj-code) + ")"
      627                   + t-addres + t-phone)
      628   .
      629   put stream Out-Stream
      630     skip
      631       string( "Страница " + string( PAGE-NUMBER( Out-Stream ), ">>9" ) ) format "X(13)" at right-field( 3 + 195, 13)
      632     skip
      633       space(3) v-single-line format  "X(19)"             at 180
      634     skip
      635       space(3) "| "                                      at 180
      636                     'код':U                               at 188
      637                     "|"                                       at 3 + 195
      638     skip
      639       space(3) "Форма по ОКУД" format "X(14)"            at 166
      640                     "| "                                      at 180
      641                     "0330523"
      642                     "|"                                       at 3 + 195
      643     skip
      644       space(3) "Организация:                         "
      645                v-organization             format "X(100)"
      646                "по ОКПО"                  format "X(7)"       at 172
      647                "| "                                           at 180
      648                t-okpo                     format "X(16)" "|"  at 3 + 195
      649     skip
      650       space(3) "Струрное подразделение:              "
      651                     v-org-name            format "X(100)"
      652                     "| "                                      at 180
      653                     "|"                                       at 3 + 195
      654       space(3) "Вид деятельности по ОКДП" format "X(25)" at 155
      655                     "| "                                      at 180
      656                     "|"                                       at 3 + 195
      657     skip
