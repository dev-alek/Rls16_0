      659                     "| "                                      at 180
      660                      ( if buf_fbr-doc.doc-type = 'при':U
      661                      then " приход"
      662                      else ( if buf_fbr-doc.doc-type = 'возврат':U then " возврат " else " расход" ) )
      663                                           format "X(16)"
      664                      "|"                                      at 3 + 195
      665     skip
      666       space(3) v-single-line         format  "X(19)"     at 180
      667   .
      668   put stream Out-Stream
      669      skip
      670         "УТВЕРЖДАЮ" at center-field(137, 3 + 195, 9)
      671      skip space(64)
      672         v-single-line format "X(73)"
      673         "Руководитель" at center-field(137, 3 + 195, 12)
      674      skip
      675       space(64) "|"
      676         "|"  at 84
