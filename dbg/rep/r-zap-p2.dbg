     1721       Temp-i.i-sale-qnty  = Temp-i.i-sale-qnty  + f-sale-qnty
     1722       Temp-i.i-end-qnty   = Temp-i.i-end-qnty   + f-end-qnty
     1723       Temp-i.i-end-sum    = Temp-i.i-end-sum    + f-end-sum
     1724     .
