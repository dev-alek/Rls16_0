     1942     assign
     1943       Temp-i.i-beg-qnty   = Temp-i.i-beg-qnty   + f-beg-qnty
     1944       Temp-i.i-sale-qnty  = Temp-i.i-sale-qnty  + f-sale-qnty
     1945       Temp-i.i-end-qnty   = Temp-i.i-end-qnty   + f-end-qnty
     1946       Temp-i.i-end-sum    = Temp-i.i-end-sum    + f-end-sum
     1947     .
     1948   end.
     1949           find first Temp-b share-lock
     1950             where Temp-b.obj-code  = obj-list.obj-code
     1951               and Temp-b.obj-type  = obj-list.obj-type  no-error .
     1952           if not avail Temp-b Then  create Temp-b no-error .
     1953           assign
     1954             Temp-b.grp          = STRING(temp-goods.grp-name)
     1955             Temp-b.obj-code     = obj-list.obj-code
     1956             Temp-b.obj-type     = obj-list.obj-type
     1957             Temp-b.b-beg-qnty   = Temp-b.b-beg-qnty   + f-beg-qnty
     1958             Temp-b.b-sale-qnty  = Temp-b.b-sale-qnty  + f-sale-qnty
     1959             Temp-b.b-end-qnty   = Temp-b.b-end-qnty   + f-end-qnty
     1960             Temp-b.b-end-sum    = Temp-b.b-end-sum    + f-end-sum
     1961           .
     1962         end.
     1963         Run PrintLine in this-procedure.
     1964       End.
     1965       if last-of(temp-goods.grp-name)  then do :
     1966         if Make-Excel then  put   stream ForExcel unformatted
     1967           "Итого"                 CHR(9)
     1968           "по группе "
     1969           var-client              CHR(9)
     1970         .
     1971         for each obj-list no-lock :
     1972           find first Temp-b no-lock
     1973                where Temp-b.obj-code  = obj-list.obj-code
     1974                  and Temp-b.obj-type  = obj-list.obj-type
     1975                  and Temp-b.grp = STRING(temp-goods.grp-name) no-error .
     1976           if avail  Temp-b then do:
     1977             if Make-Excel then  put   stream ForExcel unformatted                          CHR(9)
     1978               excel-qnty ( Temp-b.b-beg-qnty  )  CHR(9)
     1979               excel-qnty ( Temp-b.b-sale-qnty )  CHR(9)
     1980               excel-qnty ( Temp-b.b-end-qnty  )  CHR(9)
     1981               excel-sum  ( Temp-b.b-end-sum   )  CHR(9)
     1982             .
     1983           end.
     1984           else do:
     1985             if Make-Excel then  put   stream ForExcel unformatted  CHR(9)
     1986               0          CHR(9)
     1987               0          CHR(9)
     1988               0          CHR(9)
     1989               0          CHR(9)
     1990             .
     1991           end.
     1992           find current  Temp-b share-lock.
     1993             assign
     1994               Temp-b.b-beg-qnty  = 0
     1995               Temp-b.b-sale-qnty = 0
     1996               Temp-b.b-end-qnty  = 0
     1997               Temp-b.b-end-sum   = 0
     1998             .
     1999             find current  Temp-b no-lock.
     2000         End.
     2001         if Make-Excel then  put   stream ForExcel unformatted chr(10) .
     2002       End.
     2003     End.
     2004     Run PrintItogAll in this-procedure.
     2005   END PROCEDURE.
     2006   PROCEDURE PrintLine :
     2007     if ShowZero1 = yes or Ostat = yes or Oborot = yes
     2008     then do:
     2009       if ShowZero2 = yes or Oborot = yes
     2010       then do:
     2011         if Make-Excel then  put   stream ForExcel unformatted
     2012           format-excel-text(temp-goods.artic)    CHR(9)
     2013           temp-goods.gds-name                    CHR(9)
     2014         .
     2015         for each obj-list no-lock :
     2016           find first Temp-line no-lock
     2017                where Temp-line.obj-code  = obj-list.obj-code
     2018                  and Temp-line.obj-type  = obj-list.obj-type   no-error .
     2019             if Make-Excel then  put   stream ForExcel unformatted
     2020               excel-sum  ( Temp-line.l-end-cost )  CHR(9)
     2021               excel-qnty ( Temp-line.l-beg-qnty )  CHR(9)
     2022               excel-qnty ( Temp-line.l-sale-qnty ) CHR(9)
     2023               excel-qnty ( Temp-line.l-end-qnty )  CHR(9)
     2024               excel-sum  ( Temp-line.l-end-sum )   CHR(9)
     2025             .
     2026           End.
     2027           if Make-Excel then  put   stream ForExcel unformatted  chr(10) .
     2028       End.
     2029     End.
     2030   END PROCEDURE.
     2031   PROCEDURE PrintItogAll :
     2032     if Make-Excel then  put   stream ForExcel unformatted
     2033       "ИТОГО"                            CHR(9)
     2034       "по объектам"                      CHR(9)
     2035     .
     2036     for each obj-list no-lock :
     2037       find first Temp-i no-lock
     2038            where Temp-i.obj-code  = obj-list.obj-code
     2039              and Temp-i.obj-type  = obj-list.obj-type   no-error .
     2040       if available Temp-i then do:
     2041         if Make-Excel then  put   stream ForExcel unformatted                         CHR(9)
     2042          excel-qnty ( Temp-i.i-beg-qnty  )  CHR(9)
     2043          excel-qnty ( Temp-i.i-sale-qnty )  CHR(9)
     2044          excel-qnty ( Temp-i.i-end-qnty  )  CHR(9)
     2045          excel-sum  ( Temp-i.i-end-sum   )  CHR(9)
     2046         .
     2047       end.
     2048       else do:
     2049         if Make-Excel then  put   stream ForExcel unformatted  CHR(9)
     2050           0          CHR(9)
     2051           0          CHR(9)
     2052           0          CHR(9)
     2053           0          CHR(9)
     2054         .
     2055       end.
     2056     End.
     2057     if Make-Excel then  put   stream ForExcel unformatted chr(10) .
     2058   END PROCEDURE.
     2059   PROCEDURE prep-file :
     2060     for each obj-list no-lock :
     2061       for each buf_gds-obj
     2062          where buf_gds-obj.obj-code  = obj-list.obj-code
     2063            and buf_gds-obj.obj-type  = obj-list.obj-type
     2064         no-lock
     2065         :
     2066           if buf_gds-obj.last-doc = ? then next .
     2067           if buf_gds-obj.first-doc > x-date-end then next .
     2068           find first buf_goods
     2069                where buf_goods.gds-code = buf_gds-obj.gds-code no-lock no-error .
     2070           find first buf_clients
     2071                where buf_clients.obj-code = buf_gds-obj.prod-code
     2072                  and buf_clients.obj-type = buf_gds-obj.prod-type no-lock no-error .
     2073           if avail buf_goods and
     2074              avail buf_clients and
     2075              not can-find (temp-goods where temp-goods.gds-code = buf_gds-obj.gds-code no-lock )
     2076           then do:
     2077             create temp-goods.
     2078             assign
     2079               temp-goods.gds-code  = buf_goods.gds-code
     2080               temp-goods.artic     = buf_goods.artic
     2081               temp-goods.cli       = buf_clients.obj-name
     2082               temp-goods.grp-name  = buf_goods.grp-name
     2083               temp-goods.prod-code = buf_goods.prod-code
     2084               temp-goods.prod-type = buf_goods.prod-type
     2085               temp-goods.prt-root  = buf_goods.prt-root
     2086               temp-goods.gds-name  = buf_goods.gds-name
     2087               temp-goods.full-id   = buf_goods.artic + buf_goods.prod-type + string ( buf_goods.prod-code )
     2088             .
     2089           End.
     2090        End.
     2091     End.
     2092   END PROCEDURE.
