     1735             Temp-b.b-sale-qnty  = Temp-b.b-sale-qnty  + f-sale-qnty
     1736             Temp-b.b-end-qnty   = Temp-b.b-end-qnty   + f-end-qnty
     1737             Temp-b.b-end-sum    = Temp-b.b-end-sum    + f-end-sum
     1738           .
