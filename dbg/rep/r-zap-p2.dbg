     1698     Temp-line.l-end-cost  = f-end-cost
     1699     Temp-line.l-beg-qnty  = f-beg-qnty
     1700     Temp-line.l-sale-qnty = f-sale-qnty
     1701     Temp-line.l-end-qnty  = f-end-qnty
     1702     Temp-line.l-end-sum   = f-end-sum
     1703   .
