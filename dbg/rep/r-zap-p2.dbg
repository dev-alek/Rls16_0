     1621         do:
     1622           assign
     1623             f-end-cost  = buf_stk-line.sum-base / buf_stk-line.fact-qnty
     1624           .
     1625         end.
     1626         assign
     1627           f-end-qnty  = buf_stk-line.fact-qnty
     1628           f-end-sum   = buf_stk-line.sum-base
     1629         .
     1630       end.
     1631    for each buf_ot-line no-lock
