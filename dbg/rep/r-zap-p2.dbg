     1757               excel-qnty ( Temp-b.b-end-qnty  )  CHR(9)
     1758               excel-sum  ( Temp-b.b-end-sum   )  CHR(9)
     1759             .
     1760           end.
     1761           else do:
     1762             if Make-Excel then  put   stream ForExcel unformatted  CHR(9)
     1763               0          CHR(9)
     1764               0          CHR(9)
     1765               0          CHR(9)
     1766               0          CHR(9)
     1767             .
     1768           end.
     1769           find current  Temp-b share-lock.
     1770             assign
     1771               Temp-b.b-beg-qnty  = 0
     1772               Temp-b.b-sale-qnty = 0
     1773               Temp-b.b-end-qnty  = 0
     1774               Temp-b.b-end-sum   = 0
     1775             .
     1776             find current  Temp-b no-lock.
     1777         End.
     1778         if Make-Excel then  put   stream ForExcel unformatted chr(10) .
     1779       End.
     1780     End.
     1781     Run PrintItogAll in this-procedure.
     1782   END PROCEDURE.
