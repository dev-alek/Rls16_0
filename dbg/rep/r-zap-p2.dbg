     1190   DEFINE VARIABLE StopProcessing AS LOGICAL NO-UNDO.
     1191   DEFINE BUTTON StopBtn AUTO-END-KEY
     1192        LABEL "Стоп"
     1193        SIZE 10 BY 1.
     1194   DEFINE VARIABLE RecordsDone AS INTEGER FORMAT ">,>>>,>>>,>>9":U INITIAL 0
     1195        LABEL "Обработано записей"
     1196         VIEW-AS TEXT
     1197        SIZE 14 BY .67 NO-UNDO.
     1198   DEFINE VARIABLE RecordsString AS CHARACTER FORMAT "X(60)"
     1199         VIEW-AS TEXT
     1200        SIZE 53.25 BY .67
     1201        FGCOLOR 1  NO-UNDO.
     1202   DEFINE VARIABLE RecordsString2 AS CHARACTER FORMAT "X(60)"
     1203         VIEW-AS TEXT
     1204        SIZE 53.25 BY .67
     1205        FGCOLOR 1  NO-UNDO.
     1206   DEFINE VARIABLE RecordsString3 AS CHARACTER FORMAT "X(60)"
     1207         VIEW-AS TEXT
     1208        SIZE 53.25 BY .67
     1209        FGCOLOR 1  NO-UNDO.
     1210   DEFINE RECTANGLE RECT-1
     1211        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1212        SIZE 55.13 BY 4.46.
     1213   DEFINE FRAME InfoFrame
     1214        StopBtn AT ROW 4.25 COL 21.75
     1215        RecordsString AT ROW 1.21 COL 2 NO-LABEL
     1216        RecordsString2 AT ROW 1.96 COL 2 NO-LABEL
     1217        RecordsString3 AT ROW 2.58 COL 2 NO-LABEL
     1218        RecordsDone AT ROW 3.42 COL 24.88 COLON-ALIGNED
     1219        RECT-1 AT ROW 1 COL 1
     1220       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1221            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1222            TITLE "Процесс"
     1223            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
     1224   define variable mFrameView      as logical   no-undo init yes.
     1225     define variable mFramHandle as handle no-undo.
     1226     mFramHandle = frame InfoFrame:handle.
     1227     if  log-manager:logfile-name ne ?
     1228     then DO:
     1229         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1230         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1231         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
     1232     end.
     1233     mFrameView = not session:batch-mode and mFramHandle:visible.
     1234     if mFrameView
     1235     then do:
     1236       ASSIGN
     1237          FRAME InfoFrame:HIDDEN                           = TRUE
     1238          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
     1239     end.
     1240   ON CHOOSE OF StopBtn IN FRAME InfoFrame
     1241   DO:
     1242     IF not StopProcessing THEN
     1243       Message "Вы действительно хотите прервать" SKIP
     1244               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
     1245                 UPDATE StopProcessing.
     1246     IF StopProcessing THEN do:
     1247        if mFrameView
     1248        then do:
     1249           HIDE FRAME InfoFrame.
     1250        end.
     1251     End.
     1252   END.
     1253   Run report-execute in this-procedure.
     1254   function excel-format-dec-to-char returns char (input p-dec as decimal ).
     1255     if num-entries(string(p-dec), '.') = 2
     1256       then return( entry(1, string(p-dec), '.') + v-delim + entry(2, string(p-dec), '.')) .
     1257       else return( string(p-dec)) .
     1258   end function.
     1259   function format-point-to-comma returns char (input orig as char ) .
     1260   define variable rtext as character no-undo .
     1261   define variable strt as integer no-undo .
     1262   define variable leng as integer no-undo .
     1263   assign rtext = orig .
     1264   repeat:
     1265     strt =  index(rtext,'.').
     1266     if strt = 0 then leave.
     1267     leng = 1.
     1268     substring(rtext,strt,leng,"character") = v-delim .
     1269   end.
     1270   return rtext.
     1271   end function.
     1272   function format-excel-text returns char ( input start-text as char ) :
     1273   def var  i    as int no-undo.
     1274   def var  ch   as char no-undo.
     1275   def var  n    as int no-undo.
     1276   def var  ipos as int no-undo.
     1277     n = num-entries(trim(start-text), chr(10)) - 1 .
     1278     do i = 1 to n :
     1279       ipos = index( start-text, chr(10)).
     1280       if ipos > 0 then
     1281         substr( start-text, ipos, 1 ) = ' '.
     1282     end.
     1283     n = num-entries(trim(start-text), chr(13)) - 1 .
     1284     do i = 1 to n :
     1285       ipos = index( start-text, chr(13)).
     1286       if ipos > 0 then
     1287         substr( start-text, ipos, 1 ) = ' '.
     1288     end.
     1289     if index( start-text, '"' ) = 0 then
     1290       start-text =  '="'   + trim( start-text) + '"'   .
     1291       else do:
     1292         n = num-entries(trim(start-text), '"') - 1.
     1293         do i = 1 to n :
     1294           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
     1295         end.
     1296         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
     1297         start-text = '="'  + ch  + '"' .
     1298       end.
     1299     return start-text.
     1300   end.
     1301   function excel-sum returns char (input p-dec as decimal ).
     1302     return(format-excel-text(excel-format-dec-to-char(round(p-dec,2)))) .
     1303   end function.
     1304   function excel-qnty returns char (input p-dec as decimal ).
     1305     return(format-excel-text(excel-format-dec-to-char(round(p-dec,3)))) .
     1306   end function.
     1307   function format-excel-text-macr returns char ( input start-text as char ) :
     1308   def var  i    as int no-undo.
     1309   def var  ch   as char no-undo.
     1310   def var  n    as int no-undo.
     1311   def var  ipos as int no-undo.
     1312     n = num-entries(trim(start-text), chr(10)) - 1 .
     1313     do i = 1 to n :
     1314       ipos = index( start-text, chr(10)).
     1315       if ipos > 0 then
     1316         substring( start-text, ipos , 1 ) = ' '.
     1317     end.
     1318     n = num-entries(trim(start-text), chr(13)) - 1 .
     1319     do i = 1 to n :
     1320       ipos = index( start-text, chr(13)).
     1321       if ipos > 0 then
     1322         substring( start-text, ipos, 1 ) = ' '.
     1323     end.
     1324     if index( start-text, '"' ) = 0 then
     1325       start-text =  '"'   + trim( start-text) + '"'   .
     1326       else do:
     1327         n = num-entries(trim(start-text), '"') - 1.
     1328         do i = 1 to n :
     1329           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
     1330         end.
     1331         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
     1332         start-text = '"'  + ch  + '"' .
     1333       end.
     1334     n = num-entries(trim(start-text), chr(10)) - 1 .
     1335     do i = 1 to n :
     1336       ipos = index( start-text, chr(10)).
     1337       if ipos > 0 then
     1338         substring( start-text, ipos , 1 ) = ' '.
     1339     end.
     1340       if num-entries(trim(start-text), chr(10)) > 1 then  message num-entries(trim(start-text), chr(10)) start-text.
     1341     return start-text.
     1342   end.
     1343   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1344   FUNCTION determined RETURNS DECIMAL (INPUT parundefine-var AS DECIMAL):
     1345      IF parundefine-var = ? THEN RETURN 0.00.
     1346                             ELSE RETURN parundefine-var.
     1347   END FUNCTION.
     1348   FUNCTION dtm-char RETURNS CHARACTER (INPUT p-undef-char AS CHARACTER):
     1349      IF p-undef-char = ? THEN do:
     1350        RETURN "?".
     1351      end.
     1352      ELSE do:
     1353        RETURN p-undef-char .
     1354      end.
     1355   END FUNCTION.
     1356   PROCEDURE report-execute :
     1357   assign v-account = ( if integer( 10 ) = 0 then 100 else integer( 10 ) ).
     1358     if  log-manager:logfile-name ne ?
     1359     then DO:
     1360         log-manager:write-message("ON mFrameView=" + string(mFrameView), "frameRepError").
     1361     end.
     1362     if not session:batch-mode then
     1363     do:
     1364       VIEW FRAME InfoFrame.
     1365       mFrameView = true.
     1366     end.
     1367      v-button-stop = false .
     1368         if mFrameView
     1369         then do:
     1370         if v-button-stop then view STOPBTN in frame InfoFrame.
     1371                          else Hide STOPBTN in frame InfoFrame.
     1372         end.
     1373     run day-begin-fact-order in this-procedure ( input x-date-start, output v-fact-order-start ).
     1374     run day-begin-fact-order in this-procedure ( input ( x-date-end + 1 ),   output v-fact-order-end ).
     1375     run rep/extitle.p (1) .
     1376     run prep-file    in this-procedure.
     1377     case classify:
     1378       when "no-classify":u    then do:
     1379         run foreach1 in this-procedure.
     1380       end.
     1381       when "prod":u then do:
     1382         Run Foreach2 in this-procedure.
     1383       end.
     1384       when "grp-goods":u then do:
     1385         Run Foreach3 in this-procedure.
     1386       end.
     1387    end case.
     1388    if Make-Excel then output stream ForExcel close.
     1389   if mFrameView
     1390   then do:
     1391      HIDE FRAME InfoFrame.
     1392   end.
     1393    run rep/runexcel.p (string( session:temp-directory) + "rpt" + string( g#report-num ) + ".txt").
     1394   END PROCEDURE.
     1395   PROCEDURE foreach1 :
     1396     for each temp-goods  no-lock
     1397       break by temp-goods.full-id
     1398             by temp-goods.prod-type By temp-goods.prod-code by temp-goods.artic
     1399            with FRAME Zapas :
     1400       if last-of(temp-goods.artic) then do:
     1401         n-nm = n-nm + 1.
     1402   IF ( n-nm modulo v-account = 0 )  then DO:
     1403             if  log-manager:logfile-name ne ?
     1404             then DO:
     1405                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     1406             end.
     1407              if mFrameView
     1408              then do:
     1409               DISPLAY
     1410                 n-nm @ RecordsDone
     1411                 WITH FRAME InfoFrame.
     1412              end.
     1413   End.
     1414      if v-button-stop then  DO:
     1415            if mFrameView
     1416            then
     1417               PROCESS EVENTS.
     1418            IF StopProcessing THEN DO:
     1419            RETURN error.
     1420            End.
     1421      end.
     1422         assign
     1423           Ostat       = no
     1424           Oborot      = no
     1425         .
     1426         for each obj-list no-lock :
     1427   define variable vss-include-info19 as character format "X(65)" no-undo
     1428   initial "@(#)$Workfile$ $Revision$".
     1429   Assign
     1430     f-end-cost  = 0
     1431     f-beg-qnty  = 0
     1432     f-sale-qnty = 0
     1433     f-end-qnty  = 0
     1434     f-end-sum   = 0
     1435   .
     1436    find last  buf_stk-line no-lock
     1437      where buf_stk-line.obj-type  = obj-list.obj-type
     1438        and buf_stk-line.obj-code  = obj-list.obj-code
     1439        and buf_stk-line.artic     = temp-goods.artic
     1440        and buf_stk-line.prod-type = temp-goods.prod-type
     1441        and buf_stk-line.prod-code = temp-goods.prod-code
     1442        and buf_stk-line.sum-type  = ( if ShowPrice = 1 then 'crsa':U else 'cost':U )
     1443        and buf_stk-line.cat-id    = '##,##'
     1444        and buf_stk-line.fact-order < v-fact-order-end
     1445        use-index category no-error .
     1446       if available buf_stk-line then
     1447       do:
     1448         if buf_stk-line.fact-qnty <> 0 then
     1449         do:
     1450           assign
     1451             f-end-cost  = buf_stk-line.sum-base / buf_stk-line.fact-qnty
     1452           .
     1453         end.
     1454         assign
     1455           f-end-qnty  = buf_stk-line.fact-qnty
     1456           f-end-sum   = buf_stk-line.sum-base
     1457         .
     1458       end.
     1459    for each buf_ot-line no-lock
     1460      where buf_ot-line.obj-type  = obj-list.obj-type
     1461        and buf_ot-line.obj-code  = obj-list.obj-code
     1462        and buf_ot-line.artic     = temp-goods.artic
     1463        and buf_ot-line.prod-type = temp-goods.prod-type
     1464        and buf_ot-line.prod-code = temp-goods.prod-code
     1465        and buf_ot-line.fact-order >= v-fact-order-start
     1466        and buf_ot-line.fact-order < v-fact-order-end
     1467        and buf_ot-line.sum-type  = 'cost':U
     1468        and buf_ot-line.cat-id    = '##,##'
     1469        break by buf_ot-line.fact-order descending
     1470      :
     1471       case buf_ot-line.ext-doc-type :
     1472         when 'ee':U       then do:
     1473           assign
     1474             f-sale-qnty = f-sale-qnty + buf_ot-line.fact-qnty
     1475           .
     1476         End.
     1477         when 'es':U       then do:
     1478           assign
     1479             f-sale-qnty = f-sale-qnty + buf_ot-line.fact-qnty
     1480           .
     1481         End.
     1482         when 're':U       then do:
     1483           assign
     1484             f-sale-qnty = f-sale-qnty + buf_ot-line.fact-qnty
     1485           .
     1486         End.
     1487         when 'rs':U       then do:
     1488           assign
     1489             f-sale-qnty = f-sale-qnty + buf_ot-line.fact-qnty
     1490           .
     1491         End.
     1492       End case.
     1493     end.
     1494    find last buf_stk-line no-lock
     1495      where buf_stk-line.obj-type  = obj-list.obj-type
     1496        and buf_stk-line.obj-code  = obj-list.obj-code
     1497        and buf_stk-line.artic     = temp-goods.artic
     1498        and buf_stk-line.prod-type = temp-goods.prod-type
     1499        and buf_stk-line.prod-code = temp-goods.prod-code
     1500        and buf_stk-line.sum-type  = ( if ShowPrice = 1 then 'crsa':U else 'cost':U )
     1501        and buf_stk-line.cat-id    = '##,##'
     1502        and buf_stk-line.fact-order <= v-fact-order-start
     1503        use-index category no-error .
     1504       if available buf_stk-line then do:
     1505         assign
     1506           f-beg-qnty  = buf_stk-line.fact-qnty
     1507         .
     1508       end.
     1509     if f-sale-qnty <> 0 then do:
     1510       assign
     1511         Oborot = yes
     1512       .
     1513     end.
     1514     if f-beg-qnty <> 0 or f-end-qnty <> 0 then do:
     1515       assign
     1516         Ostat = yes
     1517       .
     1518     end.
     1519   find first Temp-line share-lock
     1520     where Temp-line.obj-type  = obj-list.obj-type
     1521       and Temp-line.obj-code  = obj-list.obj-code  no-error .
     1522   if not available Temp-line Then  create Temp-line no-error .
     1523   assign
     1524     Temp-line.obj-type    = obj-list.obj-type
     1525     Temp-line.obj-code    = obj-list.obj-code
     1526     Temp-line.l-end-cost  = f-end-cost
     1527     Temp-line.l-beg-qnty  = f-beg-qnty
     1528     Temp-line.l-sale-qnty = f-sale-qnty
     1529     Temp-line.l-end-qnty  = f-end-qnty
     1530     Temp-line.l-end-sum   = f-end-sum
     1531   .
     1532   find first Temp-i  share-lock
     1533     where Temp-i.obj-type  = obj-list.obj-type
     1534       and Temp-i.obj-code  = obj-list.obj-code no-error .
     1535   if not available Temp-i then do:
     1536     create Temp-i no-error .
     1537     assign
     1538       Temp-i.obj-code     = obj-list.obj-code
     1539       Temp-i.obj-type     = obj-list.obj-type
     1540       Temp-i.i-beg-qnty   = f-beg-qnty
     1541       Temp-i.i-sale-qnty  = f-sale-qnty
     1542       Temp-i.i-end-qnty   = f-end-qnty
     1543       Temp-i.i-end-sum    = f-end-sum
     1544     .
     1545   end.
     1546   else do:
     1547     assign
     1548       Temp-i.i-beg-qnty   = Temp-i.i-beg-qnty   + f-beg-qnty
     1549       Temp-i.i-sale-qnty  = Temp-i.i-sale-qnty  + f-sale-qnty
     1550       Temp-i.i-end-qnty   = Temp-i.i-end-qnty   + f-end-qnty
     1551       Temp-i.i-end-sum    = Temp-i.i-end-sum    + f-end-sum
     1552     .
     1553   end.
     1554         end.
     1555         Run PrintLine in this-procedure.
     1556       End.
     1557     End.
     1558     Run PrintItogAll in this-procedure.
     1559   END PROCEDURE.
     1560   PROCEDURE foreach2 :
     1561     for each temp-goods  no-lock
