     1742       if last-of(temp-goods.cli)  then do :
     1743         if Make-Excel then  put   stream ForExcel unformatted
     1744           "Итого"                 CHR(9)
     1745           "по произв. "
     1746           var-client              CHR(9)
     1747         .
     1748         for each obj-list no-lock :
     1749           find first Temp-b no-lock
     1750                where Temp-b.obj-code  = obj-list.obj-code
     1751                  and Temp-b.obj-type  = obj-list.obj-type
     1752                  and Temp-b.grp = STRING(temp-goods.cli) no-error .
     1753           if avail  Temp-b then do:
