      481   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      482   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
      483   define variable par-type          as character no-undo.
      484   define variable v-value-character as character no-undo .
      485   define variable v-value-date      as date      no-undo .
      486   define variable v-value-decimal   as decimal   no-undo .
      487   define variable v-value-integer   as integer   no-undo .
      488   define variable v-value-logical   as logical   no-undo .
      489   define variable v-torgconf-ext-doc-type as character    no-undo.
      490   define variable v-torgconf-outdate   as logical  init no    no-undo.
      491   define variable v-torgconf-outnum    as logical  init no    no-undo.
      492   define variable v-torgconf-outprim   as logical  init no    no-undo.
      493   define variable v-torgconf-outdisc   as logical  init no    no-undo.
      494   define variable v-torgconf-outsubs   as logical  init no    no-undo.
      495   define variable v-torgconf-outrecv   as logical  init no    no-undo.
      496   define variable v-torgconf-outegrp   as logical  init no    no-undo.
      497   define variable v-torgconf-outt12    as logical  init no    no-undo.
      498   define variable v-torgconf-outappr   as logical  init no    no-undo.
      499   define variable v-torgconf-outrubl   as logical  init no    no-undo.
      500   define variable v-torgconf-outhold   as logical  init no    no-undo.
      501   define variable v-torgconf-outobj    as logical  init no    no-undo.
      502   define variable v-torgconf-outexlst  as logical  init no    no-undo.
      503   define variable v-torgconf-outexpas  as character  init no    no-undo.
      504   define variable v-torgconf-outprncd  as logical  init no    no-undo.
      505   define variable v-torgconf-outares   as logical  init no    no-undo.
      506   define variable v-torgconf-outsend   as logical  init no    no-undo.
      507   define variable v-torgconf-outasend  as logical  init no    no-undo.
      508   define variable v-torgconf-outprops  as logical  init no    no-undo.
      509   define variable v-torgconf-outogr    as character no-undo.
      510   define variable v-torgconf-outR      as character no-undo.
      511   define variable v-torgconf-outB      as character no-undo.
      512   define variable v-torgconf-outC      as character no-undo.
      513   define variable v-torgconf-outssdoc  as character init "":U no-undo.
      514   define variable v-torgconf-self-host-code           as integer      no-undo.
      515   define variable v-torgconf-self-host-type           as character    INITIAL 'орг':U  no-undo.
      516   define variable v-torgconf-self-host-name           as character    no-undo.
      517   define variable v-torgconf-self-host-engl-name           as character    no-undo.
      518   define variable v-torgconf-self-host-addres         as character    no-undo.
      519   define variable v-torgconf-self-host-post-addres    as character    no-undo.
      520   define variable v-torgconf-self-host-phone          as character    no-undo.
