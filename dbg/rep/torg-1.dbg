     3486   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
     3487   procedure paramls-clear :
     3488     define buffer buf_temp-param for temp-param .
     3489     do
     3490     on error undo, return error return-value
     3491     :
     3492       for each buf_temp-param
     3493       on error undo, return error
     3494       :
     3495         delete buf_temp-param .
     3496       end.
     3497     end.
     3498   end procedure.
     3499   procedure paramls-write :
     3500     define input  parameter p-code     as character no-undo .
     3501     define input  parameter p-sub-code as character no-undo .
     3502     define input  parameter p-value    as character no-undo .
     3503     define buffer buf_temp-param for temp-param .
     3504     do
     3505     on error undo, return error return-value
     3506     :
     3507       find first buf_temp-param
     3508         where buf_temp-param.param-code     = p-code
     3509           and buf_temp-param.param-sub-code = p-sub-code
     3510         no-error .
     3511       if not available buf_temp-param then do:
     3512         create buf_temp-param .
     3513         assign
     3514           buf_temp-param.param-code     = p-code
     3515           buf_temp-param.param-sub-code = p-sub-code
     3516         .
     3517       end.
     3518       assign
     3519         buf_temp-param.param-value = p-value
     3520       .
     3521     end.
     3522   end procedure.
     3523   procedure paramls-read :
     3524     define input  parameter p-code          as character no-undo .
     3525     define input  parameter p-sub-code      as character no-undo .
     3526     define input  parameter p-default-value as character no-undo .
     3527     define output parameter p-value         as character no-undo .
     3528     define buffer buf_temp-param for temp-param .
     3529     do
     3530     on error undo, return error return-value
     3531     :
     3532       find first buf_temp-param
     3533         where buf_temp-param.param-code     = p-code
     3534           and buf_temp-param.param-sub-code = p-sub-code
     3535         no-error .
     3536       if available buf_temp-param then do:
     3537         assign
     3538           p-value = buf_temp-param.param-value
     3539         .
     3540       end.
     3541       else do:
     3542         assign
     3543           p-value = p-default-value
     3544         .
     3545       end.
     3546     end.
     3547   end procedure.
     3548   procedure paramls-append :
     3549     define input  parameter p-code     as character no-undo .
     3550     define input  parameter p-sub-code as character no-undo .
     3551     define input  parameter p-value    as character no-undo .
     3552     define buffer buf_temp-param for temp-param .
     3553     do
     3554     on error undo, return error return-value
     3555     :
     3556       find first buf_temp-param
     3557            where buf_temp-param.param-code     = p-code
     3558              and buf_temp-param.param-sub-code = p-sub-code
     3559         no-error .
     3560       if not available buf_temp-param then do:
     3561         create buf_temp-param .
     3562         assign
     3563           buf_temp-param.param-code     = p-code
     3564           buf_temp-param.param-sub-code = p-sub-code
     3565           buf_temp-param.param-value    = p-value
     3566         .
     3567       end.
     3568       else do:
     3569           assign
     3570               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
     3571           .
     3572       end.
     3573     end.
     3574   end procedure.
     3575       define variable g#report-num    as integer      no-undo.
     3576       define variable g#quest-print   as logical      no-undo.
     3577       define variable g#log           as logical      no-undo.
     3578   define variable vss-include-info15 as character format "X(65)" no-undo
     3579   initial "@(#)$Workfile$ $Revision$".
     3580   define stream excel-line.
     3581   define stream excel-cell.
     3582   define temp-table temp_cell-data no-undo
     3583       field data-key as character
     3584       field data-value as character
     3585       index pi is primary unique data-key
     3586   .
     3587   define temp-table temp_sheet2_line-data no-undo
     3588       field sheet-name        as character
     3589       field xl-line-id        as integer
     3590       field counter           as integer
     3591       field Name              as character
     3592       field gdscode           as character
     3593       field EI                as character
     3594       field OKEI              as character
     3595       field price             as character
     3596       field AmountInPlSupp    as character
     3597       field PlaceAmountSupp   as character
     3598       field MassSupp          as character
     3599       field SumSupp           as character
     3600       field AmountInPlFact    as character
     3601       field PlaceAmountFact   as character
     3602       field MassFact          as character
     3603       field SumFact           as character
     3604       field sum               as character
     3605       field VATpc             as character
     3606       field VATsum            as character
     3607       field AmountInPlDelt    as character
     3608       field PlaceAmountDelt   as character
     3609       field MassDelt          as character
     3610       field SumDelt           as character
     3611       field Sertif            as character
     3612       index pi is primary unique
     3613           xl-line-id
     3614   .
     3615   define variable v-torg1xl-sheet2-cur-data-row   as integer      no-undo.
     3616   define variable v-torg1xl-cell-file-name            as character    no-undo.
     3617   define variable v-torg1xl-data-file-name            as character    no-undo.
     3618   procedure torg1xl-init :
     3619   do
     3620   on error undo, return error
     3621   :
     3622       assign
     3623           v-torg1xl-sheet2-cur-data-row = 0
     3624       .
     3625       run gbl/_tmpfile.p (
     3626             input "xd"
     3627           , input ".txt"
     3628           , output v-torg1xl-data-file-name
     3629       ).
     3630       output stream excel-line to value( v-torg1xl-data-file-name ).
     3631       run gbl/_tmpfile.p (
     3632             input "xc"
     3633           , input ".txt"
     3634           , output v-torg1xl-cell-file-name
     3635       ).
     3636       output stream excel-cell to value( v-torg1xl-cell-file-name ).
     3637       run torg1xl-write-cell-data in this-procedure (
     3638             input "sheetList":U
     3639           , input "стр1,стр2,стр3":U
     3640       ).
     3641       if printrubl
     3642       then do:
     3643           run torg1xl-write-cell-data in this-procedure (
     3644                 input "стр1_valutCode":U
     3645               , input "0":U
     3646           ).
     3647           run torg1xl-write-cell-data in this-procedure (
     3648                 input "стр2_valutCode":U
     3649               , input "0":U
     3650           ).
     3651           run torg1xl-write-cell-data in this-procedure (
     3652                 input "стр3_valutCode":U
     3653               , input "0":U
     3654           ).
     3655       end.
     3656       else do:
     3657           run torg1xl-write-cell-data in this-procedure (
     3658                 input "стр1_valutCode":U
     3659               , input "1":U
     3660           ).
     3661           run torg1xl-write-cell-data in this-procedure (
     3662                 input "стр2_valutCode":U
     3663               , input "1":U
     3664           ).
     3665           run torg1xl-write-cell-data in this-procedure (
     3666                 input "стр3_valutCode":U
     3667               , input "1":U
     3668           ).
     3669       end.
     3670       run torg1xl-write-cell-data in this-procedure (
     3671             input "стр2_columnList":U
     3672           , input "counter,Name,gdscode,EI,OKEI,price,AmountInPlSupp,PlaceAmountSupp,MassSupp,SumSupp,AmountInPlFact,PlaceAmountFact,MassFact,SumFact,sum,VATpc,VATsum,AmountInPlDelt,PlaceAmountDelt,MassDelt,SumDelt,Sertif":U
     3673       ).
     3674       run torg1xl-write-cell-data in this-procedure (
     3675             input "стр2_columnType":U
     3676           , input "I,S,S,S,S,D,D,D,D,D,D,D,D,D,D,D,D,D,D,D,D,S":U
     3677       ).
     3678       run torg1xl-write-cell-data in this-procedure (
     3679             input "стр2_subtotalList":U
     3680           , input "PlaceAmountSupp,SumSupp,PlaceAmountFact,SumFact,sum,VATsum,PlaceAmountDelt,SumDelt":U
     3681       ).
     3682       run torg1xl-write-cell-data in this-procedure (
     3683             input "стр2_subtotalType":U
     3684           , input "D,D,D,D,D,D,D,D":U
     3685       ).
     3686   end.
     3687   end procedure.
     3688   procedure torg1xl-sheet2-write-line-data :
     3689   define input parameter p-Name              as character        no-undo.
     3690   define input parameter p-gdscode           as character        no-undo.
     3691   define input parameter p-EI                as character        no-undo.
     3692   define input parameter p-OKEI              as character        no-undo.
     3693   define input parameter p-price             as character        no-undo.
     3694   define input parameter p-AmountInPlSupp    as character        no-undo.
     3695   define input parameter p-PlaceAmountSupp   as character        no-undo.
     3696   define input parameter p-MassSupp          as character        no-undo.
     3697   define input parameter p-SumSupp           as character        no-undo.
     3698   define input parameter p-AmountInPlFact    as character        no-undo.
     3699   define input parameter p-PlaceAmountFact   as character        no-undo.
     3700   define input parameter p-MassFact          as character        no-undo.
     3701   define input parameter p-SumFact           as character        no-undo.
     3702   define input parameter p-sum               as character        no-undo.
     3703   define input parameter p-VATpc             as character        no-undo.
     3704   define input parameter p-VATsum            as character        no-undo.
     3705   define input parameter p-AmountInPlDelt    as character        no-undo.
     3706   define input parameter p-PlaceAmountDelt   as character        no-undo.
     3707   define input parameter p-MassDelt          as character        no-undo.
     3708   define input parameter p-SumDelt           as character        no-undo.
     3709   define input parameter p-Sertif            as character        no-undo.
     3710       define buffer buf_temp_sheet2_line-data        for temp_sheet2_line-data.
     3711   do
     3712   for buf_temp_sheet2_line-data
     3713   on error undo, return error
     3714   :
     3715       for each buf_temp_sheet2_line-data
     3716       :
     3717           delete buf_temp_sheet2_line-data.
     3718       end.
     3719       create buf_temp_sheet2_line-data.
     3720       assign
     3721           v-torg1xl-sheet2-cur-data-row           = v-torg1xl-sheet2-cur-data-row + 1
     3722           buf_temp_sheet2_line-data.sheet-name        = "стр2":U
     3723           buf_temp_sheet2_line-data.counter           = v-torg1xl-sheet2-cur-data-row
     3724           buf_temp_sheet2_line-data.Name              = p-Name
     3725           buf_temp_sheet2_line-data.gdscode           = p-gdscode
     3726           buf_temp_sheet2_line-data.EI                = p-EI
     3727           buf_temp_sheet2_line-data.OKEI              = p-OKEI
     3728           buf_temp_sheet2_line-data.price             = p-price
     3729           buf_temp_sheet2_line-data.AmountInPlSupp    = p-AmountInPlSupp
     3730           buf_temp_sheet2_line-data.PlaceAmountSupp   = p-PlaceAmountSupp
     3731           buf_temp_sheet2_line-data.MassSupp          = p-MassSupp
     3732           buf_temp_sheet2_line-data.SumSupp           = p-SumSupp
     3733           buf_temp_sheet2_line-data.AmountInPlFact    = p-AmountInPlFact
     3734           buf_temp_sheet2_line-data.PlaceAmountFact   = p-PlaceAmountFact
     3735           buf_temp_sheet2_line-data.MassFact          = p-MassFact
     3736           buf_temp_sheet2_line-data.SumFact           = p-SumFact
     3737           buf_temp_sheet2_line-data.sum               = p-sum
     3738           buf_temp_sheet2_line-data.VATpc             = p-VATpc
     3739           buf_temp_sheet2_line-data.VATsum            = p-VATsum
     3740           buf_temp_sheet2_line-data.AmountInPlDelt    = p-AmountInPlDelt
     3741           buf_temp_sheet2_line-data.PlaceAmountDelt   = p-PlaceAmountDelt
     3742           buf_temp_sheet2_line-data.MassDelt          = p-MassDelt
     3743           buf_temp_sheet2_line-data.SumDelt           = p-SumDelt
     3744           buf_temp_sheet2_line-data.Sertif            = p-Sertif
     3745       .
     3746       put stream excel-line unformatted
     3747                           buf_temp_sheet2_line-data.sheet-name
     3748           chr(9)   "DTA":U
     3749           chr(9)   buf_temp_sheet2_line-data.counter
     3750           chr(9)   buf_temp_sheet2_line-data.Name
     3751           chr(9)   buf_temp_sheet2_line-data.gdscode
     3752           chr(9)   buf_temp_sheet2_line-data.EI
     3753           chr(9)   buf_temp_sheet2_line-data.OKEI
     3754           chr(9)   buf_temp_sheet2_line-data.price
     3755           chr(9)   buf_temp_sheet2_line-data.AmountInPlSupp
     3756           chr(9)   buf_temp_sheet2_line-data.PlaceAmountSupp
     3757           chr(9)   buf_temp_sheet2_line-data.MassSupp
     3758           chr(9)   buf_temp_sheet2_line-data.SumSupp
     3759           chr(9)   buf_temp_sheet2_line-data.AmountInPlFact
     3760           chr(9)   buf_temp_sheet2_line-data.PlaceAmountFact
     3761           chr(9)   buf_temp_sheet2_line-data.MassFact
     3762           chr(9)   buf_temp_sheet2_line-data.SumFact
     3763           chr(9)   buf_temp_sheet2_line-data.sum
     3764           chr(9)   buf_temp_sheet2_line-data.VATpc
     3765           chr(9)   buf_temp_sheet2_line-data.VATsum
     3766           chr(9)   buf_temp_sheet2_line-data.AmountInPlDelt
     3767           chr(9)   buf_temp_sheet2_line-data.PlaceAmountDelt
     3768           chr(9)   buf_temp_sheet2_line-data.MassDelt
     3769           chr(9)   buf_temp_sheet2_line-data.SumDelt
     3770           chr(9)   buf_temp_sheet2_line-data.Sertif
     3771           chr(10)
     3772       .
     3773   end.
     3774   end procedure.
     3775   procedure torg1xl-write-cell-data :
     3776   define input parameter p-data-key   as character        no-undo.
     3777   define input parameter p-data-value as character        no-undo.
     3778       define buffer buf_temp_cell-data     for temp_cell-data.
     3779   do
     3780   for buf_temp_cell-data
     3781   on error undo, return error
     3782   :
     3783       find first buf_temp_cell-data
     3784            where buf_temp_cell-data.data-key = p-data-key
     3785       no-error.
     3786       if not available buf_temp_cell-data
     3787       then do:
     3788           create buf_temp_cell-data.
     3789           assign
     3790               buf_temp_cell-data.data-key = p-data-key
     3791           .
     3792       end.
     3793       assign
     3794           buf_temp_cell-data.data-value = p-data-value
     3795       .
     3796       put stream excel-cell unformatted
     3797                           buf_temp_cell-data.data-key
     3798           chr(9)   buf_temp_cell-data.data-value
     3799           chr(10)
     3800       .
     3801   end.
     3802   end procedure.
     3803   procedure torg1xl-run-excel :
     3804   define input parameter p-header-filename    as character        no-undo.
     3805   define input parameter p-data-filename      as character        no-undo.
     3806       define variable v-template-file-name    as character    no-undo.
     3807       define variable v-vb-file-name          as character    no-undo.
     3808       define buffer buf_temp-param for temp-param .
     3809   do
     3810   for buf_temp-param
     3811   on error undo, return error
     3812   :
     3813       create buf_temp-param.
     3814       assign
     3815           v-template-file-name    = search( "exe/torg1.xlt" )
     3816           v-vb-file-name          = search( "exe/t_form.bas")
     3817       .
     3818       if v-template-file-name = ?
     3819       or v-template-file-name = "":U
     3820       then do:
     3821           message
     3822               "Ошибка имени файла шаблона."
     3823           view-as alert-box error.
     3824       end.
     3825       if v-vb-file-name = ?
     3826       or v-vb-file-name = "":U
     3827       then do:
     3828           message
     3829               "Ошибка имени файла кода обработки."
     3830           view-as alert-box error.
     3831       end.
     3832       run paramls-write in this-procedure (
     3833             input "template":U
     3834           , input "template-file-name":U
     3835           , input v-template-file-name
     3836       ).
     3837       run paramls-write in this-procedure (
     3838             input "template":U
     3839           , input "vb-file-name":U
     3840           , input v-vb-file-name
     3841       ).
     3842       run paramls-write in this-procedure (
     3843             input "data":U
     3844           , input "data-header-filename":U
     3845           , input p-header-filename
     3846       ).
     3847       run paramls-write in this-procedure (
     3848             input "data":U
     3849           , input "data-filename":U
     3850           , input p-data-filename
     3851       ).
     3852       run gbl/macroxlt.p (
     3853           input-output table buf_temp-param
     3854       ) no-error.
     3855       if error-status :error
     3856       then do:
     3857           message
     3858                    vss-workfile vss-revision vss-description
     3859               skip(1)
     3860               skip "Ошибка создания файла Excel."
     3861               skip return-value
     3862               skip trim(error-status :get-message(1))
     3863                    trim(error-status :get-message(2))
     3864                    trim(error-status :get-message(3))
     3865           view-as alert-box error.
     3866           undo, return error .
     3867       end.
     3868   end.
     3869   end procedure.
     3870   procedure torg1xl-close :
     3871     define variable v-template-filename as character no-undo .
     3872   do
     3873   on error undo, return error
     3874   :
     3875       if printrubl
     3876       then do:
     3877         assign
     3878           v-template-filename = "exe/torg1.xlt":U
     3879         .
     3880       end.
     3881       else do:
     3882         assign
     3883           v-template-filename = "exe/torg1_val.xlt":U
     3884         .
     3885       end.
     3886       output stream excel-line close.
     3887       output stream excel-cell close.
     3888       output to value( string( session:temp-directory + "$" + string( g#report-num ) ) + ".txl" ) append.
     3889           export v-template-filename.
     3890           export "exe/t_form.bas":U.
     3891           export v-torg1xl-cell-file-name.
     3892           export v-torg1xl-data-file-name.
     3893       output close.
     3894   end.
     3895   end procedure.
     3896   procedure torg1xl-sheet2-write-line-format :
     3897   define input parameter p-fmt-label       as character  no-undo.
     3898       define buffer buf_temp_sheet2_line-data        for temp_sheet2_line-data.
     3899   do
     3900   for buf_temp_sheet2_line-data
     3901   on error undo, return error
     3902   :
     3903       put stream excel-line unformatted
     3904                           "стр2":U
     3905           chr(9)   "FMT":U
     3906           chr(9)   p-fmt-label
     3907           chr(10)
     3908       .
     3909   end.
     3910   end procedure.
