     5378   define variable varlastcur-excise      like ub.gds-dtl.price-base     no-undo.
     5379   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     5380   define variable v-varsum           as decimal                  no-undo.
     5381   define variable varprice-salef as decimal   no-undo .
     5382   define buffer bf_trn-doc             for ub.trn-doc.
     5383   define buffer bf_doc-line            for ub.doc-line.
     5384   define buffer bf_gds-dtl             for ub.gds-dtl.
