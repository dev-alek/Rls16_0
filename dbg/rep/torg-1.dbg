     5622         return error substitute ("Ошибка при поиске НДС для товара &1 &2 &3 документ &4", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code, bf_trn-doc.doc-code).
     5623       end.
     5624       if varcur-slt-pc = ?
     5625       then do:
     5626         return error substitute ("Ошибка при поиске НДС для товара &1 &2 &3 документ &4", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code, bf_trn-doc.doc-code).
     5627       end.
     5628       v-calcbypart = no.
     5629       if bf_doc-line.whole-send-news = integer('1':U)   then
     5630       v-calcbypart = yes.
     5631       else do:
     5632       for each bf_gds-dtl no-lock
     5633         where bf_gds-dtl.doc-code  = bf_doc-line.doc-code
     5634           and bf_gds-dtl.artic     = bf_doc-line.artic
     5635           and bf_gds-dtl.prod-type = bf_doc-line.prod-type
     5636           and bf_gds-dtl.prod-code = bf_doc-line.prod-code
     5637       on error undo, return error return-value
     5638       :
     5639   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     5640     (input  bf_goods.gds-code
     5641     ,input  bf_gds-dtl.prt-code
     5642     ,output varb-code
     5643     ) no-error .
     5644   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5645   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     5646     (input  bf_trn-doc.obj-type
     5647     ,input  bf_trn-doc.obj-code
     5648     ,input  varb-code
     5649     ,input  0
     5650     ,input  bf_trn-doc.fact-order
     5651     ,output vardoc-num
     5652     ,output varprice-sale
     5653     ,output varroad-tax
     5654     ,output varexcise
     5655     )  .
     5656             if varprice-sale = ?
     5657             then do:
     5658               assign
     5659                 varprice-sale = 0
     5660                 varroad-tax   = 0
     5661                 varexcise     = 0
     5662               .
     5663             end.
     5664             assign
     5665               varlastcur-base     = varprice-sale
     5666               varlastcur-road-tax = varroad-tax
     5667               varlastcur-excise   = varexcise
     5668               varcur-base         = varcur-base      + varprice-sale * bf_gds-dtl.fact-qnty
     5669               varcur-road-tax     = varcur-road-tax  + varroad-tax   * bf_gds-dtl.fact-qnty
     5670               varcur-excise       = varcur-excise    + varexcise     * bf_gds-dtl.fact-qnty
     5671               varcur-fact-qnty    = varcur-fact-qnty + bf_gds-dtl.fact-qnty
     5672             .
     5673         end.
     5674       end.
     5675       if varcur-fact-qnty = 0 then do:
     5676         assign
     5677           varcur-base      = varlastcur-base
     5678           varcur-road-tax  = varlastcur-road-tax
     5679           varcur-excise    = varlastcur-excise
     5680         .
     5681       end.
     5682       else do:
     5683         assign
     5684           varcur-base      = varcur-base      / varcur-fact-qnty
     5685           varcur-road-tax  = varcur-road-tax  / varcur-fact-qnty
     5686           varcur-excise    = varcur-excise    / varcur-fact-qnty
     5687         .
     5688       end.
     5689       if varcur-vat-pc = ?
     5690       then do:
     5691         return error substitute ("Нет текущего продажного НДС по товару &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     5692       end.
     5693       if varcur-slt-pc = ?
     5694       then do:
     5695         return error substitute ("Нет текущего продажного НП по товару &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     5696       end.
     5697       find first bf_sysconf where bf_sysconf.host-code = bf_trn-doc.host-code no-lock.
     5698       assign
     5699         varcur-cons-vat-pc = bf_sysconf.cons-vat-pc.
     5700       if varcur-cons-vat-pc = ? then do:
     5701         return error substitute ("Нет текущего продажного консигнационного НДС по фирме &1", bf_trn-doc.host-code).
     5702       end.
     5703       define buffer buf_tt-clcparts for tt-clcparts .
     5704       for each buf_tt-clcparts
     5705       on error undo, return error return-value
     5706       :
     5707         delete buf_tt-clcparts.
     5708       end.
     5709       for each bf_parts no-lock
     5710         where bf_parts.out-code  = bf_doc-line.doc-code
     5711           and bf_parts.obj-type  = bf_doc-line.obj-type
     5712           and bf_parts.obj-code  = bf_doc-line.obj-code
     5713           and bf_parts.artic     = bf_doc-line.artic
     5714           and bf_parts.prod-type = bf_doc-line.prod-type
     5715           and bf_parts.prod-code = bf_doc-line.prod-code
     5716       on error undo, return error return-value
     5717       :
     5718         create buf_tt-clcparts .
     5719         buffer-copy bf_parts to buf_tt-clcparts .
     5720         if v-calcbypart = yes   then do:
     5721   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run partbcod in g#library
     5722     (buffer bf_parts
     5723     ,output v-b-pcode
     5724     ) no-error .
     5725   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5726   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     5727     (input  bf_parts.obj-type
     5728     ,input  bf_parts.obj-code
     5729     ,input  v-b-pcode
     5730     ,input  0
     5731     ,input  bf_trn-doc.fact-order
     5732     ,output vardoc-num
     5733     ,output varprice-salef
     5734     ,output varroad-tax
     5735     ,output varexcise
     5736     ) no-error .
     5737             if varprice-sale = ?
     5738             then do:
     5739               assign
     5740                 varprice-salef = 0
     5741                 varroad-tax   = 0
     5742                 varexcise     = 0
     5743               .
     5744             end.
     5745             assign
     5746             part-cur-base  = varprice-salef
     5747             part-cur-road-tax  = varroad-tax
     5748             part-cur-excise = varexcise.
     5749         end.
     5750       end.
     5751       run clcprtsl_calc-ttable in this-procedure
     5752         (input yes,
     5753          input yes,
     5754          input bf_doc-line.road-tax,
     5755          input bf_doc-line.excise,
     5756          input bf_doc-line.vat-pc,
     5757          input bf_doc-line.cons-vat-pc,
     5758          input bf_doc-line.slt-pc,
     5759          input bf_trn-doc.base-rate,
     5760          input bf_trn-doc.base-scale,
     5761          input varr-b,
     5762          input varcur-base,
     5763          input varcur-road-tax,
     5764          input varcur-excise,
     5765          input varcur-vat-pc,
     5766          input varcur-cons-vat-pc,
     5767          input varcur-slt-pc
     5768          ) no-error.
     5769       if error-status:error then do:
     5770         message
     5771           vss-workfile vss-revision vss-description skip
     5772           "Ошибка при вызове процедуры clcprtsl_calc-ttable." skip
     5773           return-value skip
     5774           trim(error-status :get-message(1))
     5775           trim(error-status :get-message(2))
     5776           trim(error-status :get-message(3))
     5777           trim(error-status :get-message(4))
     5778           trim(error-status :get-message(5)) skip
     5779           view-as alert-box error.
     5780         undo, return error .
     5781       end.
     5782     end.
     5783   end.
     5784   end.
     5785   procedure clcprtsl_calc-ttable :
     5786   define input parameter paris-doc           as   logical                 no-undo.
     5787   define input parameter paris-cur           as   logical                 no-undo.
     5788   define input parameter parroad-tax         like ub.doc-line.road-tax    no-undo.
     5789   define input parameter parexcise           like ub.doc-line.excise      no-undo.
     5790   define input parameter parvat-pc           like ub.doc-line.vat-pc      no-undo.
     5791   define input parameter parcons-vat-pc      like ub.doc-line.cons-vat-pc no-undo.
     5792   define input parameter parslt-pc           like ub.doc-line.slt-pc      no-undo.
     5793   define input parameter parbase-rate        like ub.trn-doc.base-rate    no-undo.
     5794   define input parameter parbase-scale       like ub.trn-doc.base-scale   no-undo.
     5795   define input parameter parr-b              as   character               no-undo.
     5796   define input parameter parcur-base         like ub.gds-dtl.cur-base     no-undo.
     5797   define input parameter parcur-road-tax     like ub.doc-line.road-tax    no-undo.
     5798   define input parameter parcur-excise       like ub.doc-line.excise      no-undo.
     5799   define input parameter parcur-vat-pc       like ub.doc-line.vat-pc      no-undo.
     5800   define input parameter parcurcons-vat-pc   like ub.doc-line.cons-vat-pc no-undo.
     5801   define input parameter parcurslt-pc        like ub.doc-line.slt-pc      no-undo.
     5802   define buffer bf_tt-allsum      for tt-allsum.
     5803   define buffer bf_tt-clcparts    for tt-clcparts.
     5804   define buffer bf_tt-allsum-line for tt-allsum-line.
     5805   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     5806   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     5807   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     5808   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     5809   define variable varexcise          like ub.price-list.excise     no-undo.
     5810   do on error undo, return error return-value :
     5811   for each bf_tt-allsum-line
     5812   on error undo, return error return-value
     5813    :
     5814     delete bf_tt-allsum-line.
     5815   end.
     5816   for each bf_tt-allsum
     5817   on error undo, return error return-value
     5818   :
     5819     delete bf_tt-allsum.
     5820   end.
     5821   for each bf_tt-clcparts
     5822   on error undo, return error return-value
     5823   :
     5824   if v-calcbypart then do:
     5825             assign
     5826             parcur-base =   bf_tt-clcparts.part-cur-base
     5827             parcur-road-tax = bf_tt-clcparts.part-cur-road-tax
     5828             parcur-excise =   bf_tt-clcparts.part-cur-excise
     5829             .
     5830   end.
     5831      run clcprtsl_calc-parts in this-procedure (
     5832        input recid(bf_tt-clcparts),
     5833        input paris-doc,
     5834        input paris-cur,
     5835        input parroad-tax,
     5836        input parexcise,
     5837        input parvat-pc,
     5838        input parcons-vat-pc,
     5839        input parslt-pc,
     5840        input parbase-rate,
     5841        input parbase-scale,
     5842        input parr-b,
     5843        input parcur-base,
     5844        input parcur-road-tax,
     5845        input parcur-excise,
     5846        input parcur-vat-pc,
     5847        input parcurcons-vat-pc,
     5848        input parcurslt-pc
     5849        ) no-error.
     5850     if error-status:error then do:
     5851       message
     5852         vss-workfile vss-revision vss-description skip
     5853         vss-include-info16 skip
     5854         "Ошибка при обсчете партии" skip
     5855         "Документ партии " bf_tt-clcparts.out-code skip
     5856         "Товар" bf_tt-clcparts.artic bf_tt-clcparts.prod-type bf_tt-clcparts.prod-code skip
     5857         return-value skip
     5858         error-status:get-message(1) skip
     5859         error-status:get-message(2) skip
     5860         error-status:get-message(3) skip
     5861         view-as alert-box error .
     5862       undo, return error .
     5863     end.
     5864     for each bf_tt-allsum on error undo, return error return-value :
     5865       find first bf_tt-allsum-line where bf_tt-allsum-line.sum-type = bf_tt-allsum.sum-type no-error.
     5866       if not available bf_tt-allsum-line then do:
     5867         create bf_tt-allsum-line.
     5868         assign
     5869           bf_tt-allsum-line.sum-type = bf_tt-allsum.sum-type.
     5870       end.
     5871       assign
     5872         bf_tt-allsum-line.fact-qnty              = bf_tt-allsum-line.fact-qnty            + bf_tt-allsum.fact-qnty
     5873         bf_tt-allsum-line.cli-qnty               = bf_tt-allsum-line.cli-qnty             + bf_tt-allsum.cli-qnty
     5874         bf_tt-allsum-line.sum-dsc-base-doc       = bf_tt-allsum-line.sum-dsc-base-doc     + bf_tt-allsum.sum-dsc-base-doc
     5875         bf_tt-allsum-line.sum-dsc-rubl-doc       = bf_tt-allsum-line.sum-dsc-rubl-doc     + bf_tt-allsum.sum-dsc-rubl-doc
     5876         bf_tt-allsum-line.dsc-base-doc           = bf_tt-allsum-line.dsc-base-doc         + bf_tt-allsum.dsc-base-doc
     5877         bf_tt-allsum-line.dsc-rubl-doc           = bf_tt-allsum-line.dsc-rubl-doc         + bf_tt-allsum.dsc-rubl-doc
     5878         bf_tt-allsum-line.vat-base-doc           = bf_tt-allsum-line.vat-base-doc         + bf_tt-allsum.vat-base-doc
     5879         bf_tt-allsum-line.vat-rubl-doc           = bf_tt-allsum-line.vat-rubl-doc         + bf_tt-allsum.vat-rubl-doc
     5880         bf_tt-allsum-line.vat-base-buyer-doc     = bf_tt-allsum-line.vat-base-buyer-doc   + bf_tt-allsum.vat-base-buyer-doc
     5881         bf_tt-allsum-line.vat-rubl-buyer-doc     = bf_tt-allsum-line.vat-rubl-buyer-doc   + bf_tt-allsum.vat-rubl-buyer-doc
     5882         bf_tt-allsum-line.slt-base-doc           = bf_tt-allsum-line.slt-base-doc         + bf_tt-allsum.slt-base-doc
     5883         bf_tt-allsum-line.slt-rubl-doc           = bf_tt-allsum-line.slt-rubl-doc         + bf_tt-allsum.slt-rubl-doc
     5884         bf_tt-allsum-line.road-tax-base-doc      = bf_tt-allsum-line.road-tax-base-doc    + bf_tt-allsum.road-tax-base-doc
     5885         bf_tt-allsum-line.road-tax-rubl-doc      = bf_tt-allsum-line.road-tax-rubl-doc    + bf_tt-allsum.road-tax-rubl-doc
     5886         bf_tt-allsum-line.excise-base-doc        = bf_tt-allsum-line.excise-base-doc      + bf_tt-allsum.excise-base-doc
     5887         bf_tt-allsum-line.excise-rubl-doc        = bf_tt-allsum-line.excise-rubl-doc      + bf_tt-allsum.excise-rubl-doc
     5888         bf_tt-allsum-line.sum-dsc-base-cur       = bf_tt-allsum-line.sum-dsc-base-cur     + bf_tt-allsum.sum-dsc-base-cur
     5889         bf_tt-allsum-line.sum-dsc-rubl-cur       = bf_tt-allsum-line.sum-dsc-rubl-cur     + bf_tt-allsum.sum-dsc-rubl-cur
     5890         bf_tt-allsum-line.dsc-base-cur           = bf_tt-allsum-line.dsc-base-cur         + bf_tt-allsum.dsc-base-cur
     5891         bf_tt-allsum-line.dsc-rubl-cur           = bf_tt-allsum-line.dsc-rubl-cur         + bf_tt-allsum.dsc-rubl-cur
     5892         bf_tt-allsum-line.vat-base-cur           = bf_tt-allsum-line.vat-base-cur         + bf_tt-allsum.vat-base-cur
     5893         bf_tt-allsum-line.vat-rubl-cur           = bf_tt-allsum-line.vat-rubl-cur         + bf_tt-allsum.vat-rubl-cur
     5894         bf_tt-allsum-line.vat-base-buyer-cur     = bf_tt-allsum-line.vat-base-buyer-cur   + bf_tt-allsum.vat-base-buyer-cur
     5895         bf_tt-allsum-line.vat-rubl-buyer-cur     = bf_tt-allsum-line.vat-rubl-buyer-cur   + bf_tt-allsum.vat-rubl-buyer-cur
     5896         bf_tt-allsum-line.slt-base-cur           = bf_tt-allsum-line.slt-base-cur         + bf_tt-allsum.slt-base-cur
     5897         bf_tt-allsum-line.slt-rubl-cur           = bf_tt-allsum-line.slt-rubl-cur         + bf_tt-allsum.slt-rubl-cur
     5898         bf_tt-allsum-line.road-tax-base-cur      = bf_tt-allsum-line.road-tax-base-cur    + bf_tt-allsum.road-tax-base-cur
     5899         bf_tt-allsum-line.road-tax-rubl-cur      = bf_tt-allsum-line.road-tax-rubl-cur    + bf_tt-allsum.road-tax-rubl-cur
     5900         bf_tt-allsum-line.excise-base-cur        = bf_tt-allsum-line.excise-base-cur      + bf_tt-allsum.excise-base-cur
     5901         bf_tt-allsum-line.excise-rubl-cur        = bf_tt-allsum-line.excise-rubl-cur      + bf_tt-allsum.excise-rubl-cur
     5902         bf_tt-allsum-line.sum-dsc-base-acc       = bf_tt-allsum-line.sum-dsc-base-acc     + bf_tt-allsum.sum-dsc-base-acc
     5903         bf_tt-allsum-line.sum-dsc-rubl-acc       = bf_tt-allsum-line.sum-dsc-rubl-acc     + bf_tt-allsum.sum-dsc-rubl-acc
     5904         bf_tt-allsum-line.sum-dsc-cli-acc        = bf_tt-allsum-line.sum-dsc-cli-acc      + bf_tt-allsum.sum-dsc-cli-acc
     5905         bf_tt-allsum-line.dsc-base-acc           = bf_tt-allsum-line.dsc-base-acc         + bf_tt-allsum.dsc-base-acc
     5906         bf_tt-allsum-line.dsc-rubl-acc           = bf_tt-allsum-line.dsc-rubl-acc         + bf_tt-allsum.dsc-rubl-acc
     5907         bf_tt-allsum-line.dsc-cli-acc            = bf_tt-allsum-line.dsc-cli-acc          + bf_tt-allsum.dsc-cli-acc
     5908         bf_tt-allsum-line.vat-base-acc           = bf_tt-allsum-line.vat-base-acc         + bf_tt-allsum.vat-base-acc
     5909         bf_tt-allsum-line.vat-rubl-acc           = bf_tt-allsum-line.vat-rubl-acc         + bf_tt-allsum.vat-rubl-acc
     5910         bf_tt-allsum-line.vat-cli-acc            = bf_tt-allsum-line.vat-cli-acc          + bf_tt-allsum.vat-cli-acc
     5911         bf_tt-allsum-line.slt-base-acc           = bf_tt-allsum-line.slt-base-acc         + bf_tt-allsum.slt-base-acc
     5912         bf_tt-allsum-line.slt-rubl-acc           = bf_tt-allsum-line.slt-rubl-acc         + bf_tt-allsum.slt-rubl-acc
     5913         bf_tt-allsum-line.slt-cli-acc            = bf_tt-allsum-line.slt-cli-acc          + bf_tt-allsum.slt-cli-acc
     5914         bf_tt-allsum-line.road-tax-base-acc      = bf_tt-allsum-line.road-tax-base-acc    + bf_tt-allsum.road-tax-base-acc
     5915         bf_tt-allsum-line.road-tax-rubl-acc      = bf_tt-allsum-line.road-tax-rubl-acc    + bf_tt-allsum.road-tax-rubl-acc
     5916         bf_tt-allsum-line.road-tax-cli-acc       = bf_tt-allsum-line.road-tax-cli-acc     + bf_tt-allsum.road-tax-cli-acc
     5917         bf_tt-allsum-line.excise-base-acc        = bf_tt-allsum-line.excise-base-acc      + bf_tt-allsum.excise-base-acc
     5918         bf_tt-allsum-line.excise-rubl-acc        = bf_tt-allsum-line.excise-rubl-acc      + bf_tt-allsum.excise-rubl-acc
     5919         bf_tt-allsum-line.excise-cli-acc         = bf_tt-allsum-line.excise-cli-acc       + bf_tt-allsum.excise-cli-acc
     5920         bf_tt-allsum-line.transport-base-acc     = bf_tt-allsum-line.transport-base-acc   + bf_tt-allsum.transport-base-acc
     5921         bf_tt-allsum-line.transport-rubl-acc     = bf_tt-allsum-line.transport-rubl-acc   + bf_tt-allsum.transport-rubl-acc
     5922         bf_tt-allsum-line.transport-cli-acc      = bf_tt-allsum-line.transport-cli-acc    + bf_tt-allsum.transport-cli-acc
     5923         bf_tt-allsum-line.other-base-acc         = bf_tt-allsum-line.other-base-acc       + bf_tt-allsum.other-base-acc
     5924         bf_tt-allsum-line.other-rubl-acc         = bf_tt-allsum-line.other-rubl-acc       + bf_tt-allsum.other-rubl-acc
     5925         bf_tt-allsum-line.other-cli-acc          = bf_tt-allsum-line.other-cli-acc        + bf_tt-allsum.other-cli-acc
     5926         .
     5927     end.
     5928   end.
     5929   end.
     5930   end procedure.
     5931       define  variable price-rubl-with-tax-sale    like ub.doc-line.price-rubl no-undo.
     5932       define  variable price-base-with-tax-sale    like ub.doc-line.price-base no-undo.
