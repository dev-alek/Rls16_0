     5389   define buffer bfs_tt-allsum-line     for tt-allsum-line.
     5390   define buffer bfo_tt-allsum-line     for tt-allsum-line.
     5391   define buffer bfos_tt-allsum-line    for tt-allsum-line.
     5392   define buffer buf_parts        for ub.parts.
     5393   v-calcbypart = no.
     5394   do on error undo, return error return-value :
     5395   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     5396   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     5397     (output varr-b
     5398     )  .
     5399     find first bf_doc-line where recid (bf_doc-line) = parrec-line no-lock.
     5400     find first bf_trn-doc where bf_trn-doc.doc-code = bf_doc-line.doc-code no-lock.
     5401     find first bf_goods where bf_goods.artic     = bf_doc-line.artic     and
     5402                               bf_goods.prod-type = bf_doc-line.prod-type and
     5403                               bf_goods.prod-code = bf_doc-line.prod-code no-lock.
     5404     if bf_trn-doc.fact-date <> ?        then do:
     5405       assign v-tax-date = bf_trn-doc.fact-date.
     5406     end.
     5407     else do:
     5408       assign v-tax-date = ?.
     5409     end.
