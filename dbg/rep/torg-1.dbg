     6298       run torg1xl-write-cell-data in this-procedure (
     6299             input "docDate":U
     6300           , input v-torgconf-doc-date
     6301       ).
     6302       run torg1xl-write-cell-data in this-procedure (
     6303             input "operationType":U
     6304           , input ( if buf_trn-doc.doc-type = 'при':U AND NOT Invers then " приход" else " расход" )
     6305       ).
     6306       run torg1xl-write-cell-data in this-procedure (
     6307             input "cargoTo":U
     6308           , input v-torgconf-torg12-cargo-label
     6309       ).
     6310       run torg1xl-write-cell-data in this-procedure (
     6311             input "cargoToValue":U
     6312           , input v-torgconf-cargo-from-value
     6313       ).
     6314       run torg1xl-write-cell-data in this-procedure (
     6315             input "supplier":U
     6316           , input v-torgconf-supplier
     6317       ).
     6318       assign
     6319           v-line-counter = 0
     6320       .
     6321       for each buf_doc-line no-lock
     6322          where buf_doc-line.doc-code = buf_trn-doc.doc-code
     6323       on error undo, return error
     6324       :
     6325           find first buf_goods no-lock
     6326                where buf_goods.artic      = buf_doc-line.artic
     6327                  and buf_goods.prod-type  = buf_doc-line.prod-type
     6328                  and buf_goods.prod-code  = buf_doc-line.prod-code
     6329           .
     6330           find first buf_units no-lock
     6331                where buf_units.unit-name = buf_goods.unit-base
     6332           .
     6333           assign
     6334               v-gds-code  = buf_goods.gds-code
     6335               v-gds-name  = buf_goods.gds-name
     6336               v-unit-name = buf_units.unit-name
     6337               v-unit-okei = buf_units.OKEI
     6338           .
     6339           for each tt-clcparts
     6340           on error undo, return error
     6341           :
     6342               delete tt-clcparts.
     6343           end.
     6344           for each buf_parts no-lock
     6345              where buf_parts.out-code   = buf_trn-doc.doc-code
     6346                and buf_parts.obj-type   = buf_trn-doc.obj-type
     6347                and buf_parts.obj-code   = buf_trn-doc.obj-code
     6348                and buf_parts.prod-type  = buf_doc-line.prod-type
     6349                and buf_parts.prod-code  = buf_doc-line.prod-code
     6350                and buf_parts.artic      = buf_doc-line.artic
     6351           on error undo, return error return-value
     6352           :
     6353               assign
     6354                   v-line-counter = v-line-counter + 1
     6355               .
     6356               create tt-clcparts.
     6357               buffer-copy buf_parts to tt-clcparts.
     6358               run clcprtsl_calc-parts in this-procedure (
     6359                     input recid( tt-clcparts )
     6360                   , input no
     6361                   , input no
     6362                   , input 0
     6363                   , input 0
     6364                   , input 0
     6365                   , input 0
     6366                   , input 0
     6367                   , input 0
     6368                   , input 0
     6369                   , input "":U
     6370                   , input 0
     6371                   , input 0
     6372                   , input 0
     6373                   , input 0
     6374                   , input 0
     6375                   , input 0
     6376               ).
     6377               find first tt-allsum
     6378                    where tt-allsum.sum-type = 'основная_сумма':U
     6379               .
     6380               assign
     6381                   v-price     = ( if printrubl = yes then buf_parts.price-rubl else buf_parts.price-base )
     6382                   v-qnty-supp = buf_parts.qnty
     6383                   v-qnty-fact = buf_parts.fact-qnty
     6384               .
     6385               assign
     6386                   v-sert = "":U
     6387               .
     6388   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     6389     (input  buf_goods.gds-code
     6390     ,input  ?
     6391     ,output v-bar-code
     6392     ) no-error .
     6393    .
     6394               for each buf_sert-join no-lock
     6395                  where buf_sert-join.cli-type   = buf_goods.prod-type
     6396                    and buf_sert-join.cli-code   = buf_goods.prod-code
     6397                    and buf_sert-join.b-code     = v-bar-code
     6398               :
     6399                   for each buf_sert no-lock
     6400                      where buf_sert.sert-code = buf_sert-join.sert-code
     6401                   :
     6402                       if  buf_trn-doc.fact-date <= buf_sert.last-date
     6403                       and buf_trn-doc.fact-date >= buf_sert.first-date
     6404                       then do:
     6405                           assign
     6406                               v-sert = v-sert
     6407                                       + ( if trim( v-sert ) = "":U
     6408                                           then "":U
     6409                                           else ", ":U )
     6410                                       + string( buf_sert-join.sert-code )
     6411                           .
     6412                       end.
     6413                   end.
     6414               end.
     6415               assign
     6416                   v-price-NoVAT         = v-price - v-price * buf_parts.VAT-pc / ( 100 + buf_parts.VAT-pc )
     6417                   v-sum-PlaceAmountSupp = v-sum-PlaceAmountSupp + v-qnty-supp
     6418                   v-sum-SumSupp         = v-sum-SumSupp         + ( v-qnty-supp * v-price-NoVAT )
     6419                   v-sum-PlaceAmountFact = v-sum-PlaceAmountFact + v-qnty-fact
     6420                   v-sum-SumFact         = v-sum-SumFact         + ( v-qnty-fact * v-price-NoVAT )
     6421                   v-sum-sum             = v-sum-sum             + ( v-qnty-fact * v-price )
     6422                   v-sum-VATsum          = v-sum-VATsum          + ( buf_parts.VAT-pc / 100 * v-qnty-fact * v-price-NoVAT )
     6423                   v-sum-PlaceAmountDelt = v-sum-PlaceAmountDelt + ( v-qnty-fact - v-qnty-supp )
     6424                   v-sum-SumDelt         = v-sum-SumDelt         + ( ( v-qnty-fact - v-qnty-supp ) * v-price-NoVAT )
     6425               .
     6426               run torg1xl-sheet2-write-line-data in this-procedure (
     6427                     input v-gds-name
     6428                   , input v-gds-code
     6429                   , input v-unit-name
     6430                   , input v-unit-okei
     6431                   , input v-price-NoVAT
     6432                   , input 1
     6433                   , input v-qnty-supp
     6434                   , input 0
     6435                   , input v-qnty-supp * v-price-NoVAT
     6436                   , input 1
     6437                   , input v-qnty-fact
     6438                   , input 0
     6439                   , input v-qnty-fact * v-price-NoVAT
     6440                   , input v-qnty-fact * v-price
     6441                   , input buf_parts.VAT-pc
     6442                   , input buf_parts.VAT-pc / 100 * v-qnty-fact * v-price-NoVAT
     6443                   , input 1
     6444                   , input v-qnty-fact - v-qnty-supp
     6445                   , input 0
     6446                   , input ( v-qnty-fact - v-qnty-supp ) * v-price-NoVAT
     6447                   , input v-sert
     6448               ).
     6449           end.
     6450       end.
     6451       run torg1xl-write-cell-data in this-procedure (
     6452             input "стр2_it_PlaceAmountSupp":U
     6453           , input v-sum-PlaceAmountSupp
     6454       ).
     6455       run torg1xl-write-cell-data in this-procedure (
     6456             input "стр2_it_SumSupp":U
     6457           , input v-sum-SumSupp
     6458       ).
     6459       run torg1xl-write-cell-data in this-procedure (
     6460             input "стр2_it_PlaceAmountFact":U
     6461           , input v-sum-PlaceAmountFact
     6462       ).
     6463       run torg1xl-write-cell-data in this-procedure (
     6464             input "стр2_it_SumFact":U
     6465           , input v-sum-SumFact
     6466       ).
     6467       run torg1xl-write-cell-data in this-procedure (
     6468             input "стр2_it_sum":U
     6469           , input v-sum-sum
     6470       ).
     6471       run torg1xl-write-cell-data in this-procedure (
     6472             input "стр2_it_VATsum":U
     6473           , input v-sum-VATsum
     6474       ).
     6475       run torg1xl-write-cell-data in this-procedure (
     6476             input "стр2_it_PlaceAmountDelt":U
     6477           , input v-sum-PlaceAmountDelt
     6478       ).
     6479       run torg1xl-write-cell-data in this-procedure (
     6480             input "стр2_it_SumDelt":U
     6481           , input v-sum-SumDelt
     6482       ).
     6483       run torg1xl-close in this-procedure .
     6484   if g#quest-print = false
     6485   then do:
     6486     run adecomm/_osprint.p ( ?, string( session:temp-directory + "rpt" + string( g#report-num ) ),
     6487                                         7, (if 4 >= 8 then 2 else 0), 0, 0,
     6488                                         OUTPUT g#log ).
     6489   end.
     6490   else do:
     6491     os-command silent
     6492       value( "COPY /b " +
     6493         string( session:temp-directory) +  "$" + string( g#report-num ) + " + " +
     6494         string( session:temp-directory) + "rpt" + string( g#report-num ) + " " +
     6495         string( session:temp-directory) +  "$" + string( g#report-num )
     6496                 ) .
     6497     os-command silent
     6498       value( "COPY /b " +
     6499         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl" + " + " +
     6500         string( session:temp-directory) + "rpt" + string( g#report-num ) + ".txl" + " " +
     6501         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl"
     6502                 ) .
     6503   end.
     6504   if session :set-wait-state( "" ) then.
     6505   end.
