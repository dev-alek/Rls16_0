     1117     varprice-rubl-cons = varprice-rubl-cons / varcons-qnty.
     1118   if varprice-base-cons = ? then do:
     1119     assign
     1120       varprice-base-cons = 0.
     1121   end.
     1122   if varprice-rubl-cons = ? then do:
     1123     assign
     1124       varprice-rubl-cons = 0.
     1125   end.
     1126   assign
     1127       slt-base-sale               = (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-base - gds-dtl.discnt-base                - road-tax-base-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc)
     1128     vat-base-buyer              = (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-base - gds-dtl.discnt-base - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-base - gds-dtl.discnt-base                - road-tax-base-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - road-tax-base-sale) * doc-line.vat-pc / (100 + doc-line.vat-pc)
     1129     discnt-base-sale            = gds-dtl.discnt-base
     1130     price-base-with-tax-sale    = (gds-dtl.price-base - gds-dtl.discnt-base)
     1131       slt-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-rubl - gds-dtl.discnt-rubl                - road-tax-rubl-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc)
     1132     vat-rubl-buyer              = (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-rubl - gds-dtl.discnt-rubl - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-rubl - gds-dtl.discnt-rubl                - road-tax-rubl-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - road-tax-rubl-sale) * doc-line.vat-pc / (100 + doc-line.vat-pc)
     1133     discnt-rubl-sale            = gds-dtl.discnt-rubl
     1134     price-rubl-with-tax-sale    = (gds-dtl.price-rubl - gds-dtl.discnt-rubl)
     1135     .
     1136   if t-doc.doc-type = 'инв':U then do:
     1137     assign
     1138       varfact-qnty = gds-dtl.doc-qnty.
     1139   end.
     1140   else do:
     1141     assign
     1142       varfact-qnty = gds-dtl.fact-qnty.
     1143   end.
     1144   if varis-cons-parts-have = no then do:
     1145     assign
     1146           vat-base-sale               = (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-base - gds-dtl.discnt-base - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-base - gds-dtl.discnt-base                - road-tax-base-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - road-tax-base-sale) * doc-line.vat-pc / (100 + doc-line.vat-pc)
     1147           vat-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-rubl - gds-dtl.discnt-rubl - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-rubl - gds-dtl.discnt-rubl                - road-tax-rubl-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - road-tax-rubl-sale) * doc-line.vat-pc / (100 + doc-line.vat-pc).
     1148   end.
     1149   else do:
     1150     if t-doc.doc-type = 'инв':U then do:
     1151       assign
     1152               vat-base-sale               = (if out-vatp-have-vat-slt = no then 0 else (((gds-dtl.price-base - gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-base - gds-dtl.discnt-base                - road-tax-base-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - road-tax-base-sale - varprice-base-cons) * doc-line.cons-vat-pc / (100 + doc-line.cons-vat-pc) * gds-dtl.doc-qnty * varcons-qnty / varfact-qnty + ((gds-dtl.price-base - gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-base - gds-dtl.discnt-base                - road-tax-base-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - road-tax-base-sale) * doc-line.vat-pc / (100 + doc-line.vat-pc) * gds-dtl.doc-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     1153               vat-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else (((gds-dtl.price-rubl - gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-rubl - gds-dtl.discnt-rubl                - road-tax-rubl-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - road-tax-rubl-sale - varprice-rubl-cons) * doc-line.cons-vat-pc / (100 + doc-line.cons-vat-pc) * gds-dtl.doc-qnty * varcons-qnty / varfact-qnty + ((gds-dtl.price-rubl - gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-rubl - gds-dtl.discnt-rubl                - road-tax-rubl-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - road-tax-rubl-sale) * doc-line.vat-pc / (100 + doc-line.vat-pc) * gds-dtl.doc-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     1154        .
     1155     end.
     1156     else do:
     1157       assign
     1158               vat-base-sale               = (if out-vatp-have-vat-slt = no then 0 else (((gds-dtl.price-base - gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-base - gds-dtl.discnt-base                - road-tax-base-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - road-tax-base-sale - varprice-base-cons) * doc-line.cons-vat-pc / (100 + doc-line.cons-vat-pc) * gds-dtl.fact-qnty * varcons-qnty / varfact-qnty + ((gds-dtl.price-base - gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-base - gds-dtl.discnt-base                - road-tax-base-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - varprice-base-cons) * doc-line.vat-pc / (100 + doc-line.vat-pc) * gds-dtl.fact-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     1159               vat-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else (((gds-dtl.price-rubl - gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-rubl - gds-dtl.discnt-rubl                - road-tax-rubl-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - road-tax-rubl-sale - varprice-rubl-cons) * doc-line.cons-vat-pc / (100 + doc-line.cons-vat-pc) * gds-dtl.fact-qnty * varcons-qnty / varfact-qnty + ((gds-dtl.price-rubl - gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-rubl - gds-dtl.discnt-rubl                - road-tax-rubl-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - varprice-rubl-cons) * doc-line.vat-pc / (100 + doc-line.vat-pc) * gds-dtl.fact-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     1160        .
     1161     end.
     1162   end.
     1163   assign
     1164   price-base-without-tax-sale = price-base-with-tax-sale - vat-base-sale - slt-base-sale - road-tax-base-sale
     1165   price-rubl-without-tax-sale = price-rubl-with-tax-sale - vat-rubl-sale - slt-rubl-sale - road-tax-rubl-sale.
     1166               assign
     1167                   price-doc = ( if v-rb-is-base = yes
     1168                               then price-base-with-tax-sale - vat-rubl-sale
     1169                               else price-rubl-with-tax-sale - vat-rubl-sale
     1170                   )
     1171               .
     1172           end.
     1173           assign
     1174               Vat-gds = ( price-lst - (price-lst - ub.doc-line.road-tax * 1) * t-doc-line.SLT-pc / (100 + t-doc-line.SLT-pc) - v-tax-sum) * t-doc-line.vat-pc / ( 100 + t-doc-line.vat-pc )
     1175               marg = price-lst - price-doc - Vat-gds - (price-lst - ub.doc-line.road-tax * 1) * t-doc-line.SLT-pc / (100 + t-doc-line.SLT-pc)
     1176           .
     1177           ACCUMULATE bar-code.b-code ( COUNT )
     1178                   gds-dtl.fact-qnty ( TOTAL )
     1179                   marg * gds-dtl.fact-qnty ( TOTAL )
     1180                   gds-dtl.fact-qnty * (price-lst - ub.doc-line.road-tax * 1) * t-doc-line.SLT-pc / (100 + t-doc-line.SLT-pc) ( TOTAL )
     1181                   gds-dtl.fact-qnty * VAT-gds ( TOTAL )
     1182                   ( gds-dtl.fact-qnty * price-lst ) ( TOTAL )
     1183                   ( gds-dtl.fact-qnty * price-doc ) ( TOTAL )
     1184                   ( gds-dtl.fact-qnty * gds-dtl.price-rubl ) ( TOTAL )
     1185                   ( gds-dtl.fact-qnty * gds-dtl.price-base ) ( TOTAL )
     1186                   ( ( price-lst - gds-dtl.price-base ) * gds-dtl.fact-qnty ) ( TOTAL )
     1187                   ( ( price-lst - gds-dtl.price-rubl ) * gds-dtl.fact-qnty ) ( TOTAL )
     1188           .
     1189           assign
     1190               v-price-rb = ( if v-rb-is-base = yes then gds-dtl.price-base else gds-dtl.price-rubl )
     1191           .
     1192           DISPLAY sym1
     1193                   trim( string( bar-code.b-code ) ) @ tb-code
     1194                   gds-dtl.artic
     1195                   goods.gds-name
     1196                   gds-dtl.fact-qnty
     1197                   price-doc
     1198                   ( gds-dtl.fact-qnty * price-doc ) @ sum-no-NDS
     1199                   ( if v-rb-is-base = yes
     1200                   then gds-dtl.fact-qnty * gds-dtl.price-base
     1201                   else gds-dtl.fact-qnty * gds-dtl.price-rubl ) @ doc-sum
     1202                   price-lst
     1203                   ( gds-dtl.fact-qnty * price-lst ) @ obj-sum
     1204                   ( gds-dtl.fact-qnty * (price-lst - ub.doc-line.road-tax * 1) * t-doc-line.SLT-pc / (100 + t-doc-line.SLT-pc) ) @ SLT-sum
     1205                   t-doc-line.vat-pc
     1206                   ( gds-dtl.fact-qnty * VAT-gds ) @ VAT-sum
     1207                   string( string( marg / price-doc * 100, "->>>9.9" ) + "%" ) @ UpFact
     1208                   string( string( ( price-lst - v-price-rb ) / v-price-rb * 100, "->>>9.9" ) + "%" ) @ Delt
     1209                   sym2
     1210           .
     1211           if LAST( gds-dtl.artic )
     1212           then do:
     1213                   DOWN 1 .
     1214                   PUT Line format "X(180)" SKIP .
     1215                   assign
     1216                       v-sum-cost-without-vat = ACCUM TOTAL ( gds-dtl.fact-qnty * price-doc )
     1217                       v-sum-sale             = ACCUM TOTAL ( gds-dtl.fact-qnty * price-lst )
     1218                   .
     1219                   assign
     1220                       v-sum-price-rb      = ( if v-rb-is-base = yes
     1221                                               then ACCUM TOTAL ( gds-dtl.fact-qnty * gds-dtl.price-base )
     1222                                               else ACCUM TOTAL ( gds-dtl.fact-qnty * gds-dtl.price-rubl ) )
     1223                       v-delta-price-rb    = ( if v-rb-is-base = yes
     1224                                               then ( ACCUM TOTAL ( ( price-lst - gds-dtl.price-base ) * gds-dtl.fact-qnty ) )
     1225                                               else ( ACCUM TOTAL ( ( price-lst - gds-dtl.price-rubl ) * gds-dtl.fact-qnty ) ) )
     1226                   .
     1227                   DISPLAY "  ИТОГО"    @ goods.gds-name
     1228                       ACCUM TOTAL gds-dtl.fact-qnty @ gds-dtl.fact-qnty
     1229                       ACCUM TOTAL ( gds-dtl.fact-qnty * price-doc ) @ sum-no-NDS
     1230                       v-sum-price-rb @ doc-sum
     1231                       ACCUM TOTAL ( gds-dtl.fact-qnty * price-lst ) @ obj-sum
     1232                       ACCUM TOTAL ( gds-dtl.fact-qnty * (price-lst - ub.doc-line.road-tax * 1) * t-doc-line.SLT-pc / (100 + t-doc-line.SLT-pc) ) @ SLT-sum
     1233                       ACCUM TOTAL ( gds-dtl.fact-qnty * VAT-gds ) @ VAT-sum
     1234                       string( string( ( ACCUM TOTAL ( marg * gds-dtl.fact-qnty ) ) /
     1235                                              ( ACCUM TOTAL ( gds-dtl.fact-qnty * price-doc ) ) * 100, "->>>9.9" ) + "%" )
     1236                                       @ UpFact
     1237                       string( string( v-delta-price-rb / v-sum-price-rb * 100, "->>>9.9" ) + "%" )
     1238                                       @ Delt .
     1239                   UNDERLINE goods.gds-name gds-dtl.fact-qnty sum-no-NDS obj-sum SLT-sum UpFact .
     1240                   DOWN 2 .
     1241           end.
     1242   END.
     1243   HIDE FRAME BottomFrame .
     1244   if v-rb-is-base = yes
     1245   then do:
     1246       run rep/wp.p (
     1247             input p-mainmenu-handle
     1248           , input ACCUM TOTAL ( ub.gds-dtl.fact-qnty * price-lst )
     1249           , output propis
     1250           , output abbr
     1251       ).
     1252   end.
     1253   else do:
     1254       run rep/wp-rub.p (
     1255             input ACCUM TOTAL ( ub.gds-dtl.fact-qnty * price-lst )
     1256           , output propis
     1257           , output abbr
     1258       ).
     1259   end.
     1260   PUT SPACE(10) "Всего  " ( ACCUM COUNT ub.bar-code.b-code ) format ">>>>9"
     1261       " наименований." format "X(15)"
     1262       SKIP(1)
     1263       SPACE(10)
     1264       string( "Сумма цен по объекту составила : "
     1265                  + trim( string( ACCUM TOTAL ( ub.gds-dtl.fact-qnty * price-lst ), "->>>,>>>,>>>,>>>,>>9.99" ) )
     1266                  + " " + trim( abbr )
     1267                  + ", в том числе налог с продаж : "
     1268                  + trim( string( ACCUM TOTAL ( ub.gds-dtl.fact-qnty * (price-lst - ub.doc-line.road-tax * 1) * t-doc-line.SLT-pc / (100 + t-doc-line.SLT-pc) ), "->>>,>>>,>>>,>>>,>>9.99" ) )
     1269                  + " " + trim( abbr )
     1270                  + ", НДС : "
     1271                  + trim( string( ACCUM TOTAL ( ub.gds-dtl.fact-qnty * VAT-gds ), "->>>,>>>,>>>,>>>,>>9.99" ) )
     1272                  + " " + trim( abbr )
     1273                 ) format "X(126)"
     1274       skip(1)
     1275       space(10) "Разница между суммой в продажных ценах по объекту и суммой в ценах документа без НДС составила: "
     1276                  + trim( string( v-sum-sale - v-sum-cost-without-vat, "->>>,>>>,>>>,>>>,>>9.99" ) )
     1277                  + " " + trim( abbr )
     1278                                                           format "X(126)"
     1279       skip(1)
     1280   .
     1281   if line-counter + 4 > page-size then
     1282       PAGE .
     1283   PUT
     1284       space(10) string( "ИТОГО по акту передано товаров на сумму  "
     1285               + CAPS( ( if trim(propis) begins trim( abbr ) then string( "0 " + propis ) else propis ) ) )
     1286                                                           format "X(126)"
     1287       skip(1)
     1288   .
     1289   run get-boss-and-buh in this-procedure (
     1290         input t-doc.obj-type
     1291       , input t-doc.obj-code
     1292       , output v-main-boss
     1293       , output v-main-buh
     1294   ).
     1295   PUT
     1296       space(20) "От владельца : "
     1297                 "От эксплуататора : "  at 80
     1298                 v-store-man  format "X(20)"
     1299       skip (1)
     1300       space(20) "Руководитель предприятия:                                             / "
     1301                 string( v-main-boss  + " /" ) format "X(40)"
     1302       skip (1)
     1303       space(20) "Главный бухгалтер:                                                    / "
     1304                 string( v-main-buh  + " /" ) format "X(40)"
     1305   .
     1306   output CLOSE.
     1307   if g#quest-print = false
     1308   then do:
     1309     run adecomm/_osprint.p ( ?, string( session:temp-directory + "rpt" + string( g#report-num ) ),
     1310                                         7, (if 8 >= 8 then 2 else 0), 0, 0,
     1311                                         OUTPUT g#log ).
     1312   end.
     1313   else do:
     1314     os-command silent
     1315       value( "COPY /b " +
     1316         string( session:temp-directory) +  "$" + string( g#report-num ) + " + " +
     1317         string( session:temp-directory) + "rpt" + string( g#report-num ) + " " +
     1318         string( session:temp-directory) +  "$" + string( g#report-num )
     1319                 ) .
     1320     os-command silent
     1321       value( "COPY /b " +
     1322         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl" + " + " +
     1323         string( session:temp-directory) + "rpt" + string( g#report-num ) + ".txl" + " " +
     1324         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl"
     1325                 ) .
     1326   end.
     1327   end.
     1328   procedure get-boss-and-buh :
     1329   do
     1330   on error undo, return error
     1331   :
     1332   define input parameter p-obj-type   as character    no-undo.
     1333   define input parameter p-obj-code   as integer      no-undo.
     1334   define output parameter p-main-boss as character    no-undo.
     1335   define output parameter p-main-buh  as character    no-undo.
     1336       define variable v-host-code     as integer       no-undo.
     1337       define buffer buf_clients       for ub.clients.
     1338       define buffer buf_firm          for ub.firm.
     1339       define buffer buf_sysconf       for ub.sysconf.
     1340   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1341   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1342     (input  p-obj-type
     1343     ,input  p-obj-code
     1344     ,output v-host-code
     1345     )  .
     1346       find first buf_clients no-lock
     1347            where buf_clients.obj-type = 'орг':U
     1348              and buf_clients.obj-code = v-host-code
     1349       .
     1350       find first buf_firm no-lock
     1351            where buf_firm.firm-code = buf_clients.obj-code
     1352       .
     1353       assign
     1354           p-main-boss = buf_firm.director
     1355       .
     1356       find first buf_sysconf no-lock
     1357            where buf_sysconf.host-code = v-host-code
     1358       .
     1359       assign
     1360           p-main-buh  = buf_sysconf.snr-accnt
     1361       .
     1362   end.
     1363   end procedure.
