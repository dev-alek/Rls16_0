      999   end.
     1000   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1001   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1002     (output varoutvprb
     1003     )  .
     1004   if varoutvprb = "base":u then do:
     1005     assign
     1006           road-tax-base-sale    =  (if doc-line.road-tax = ? then 0 else doc-line.road-tax * 1)
     1007       excise-base-sale      =  (if doc-line.excise   = ? then 0 else doc-line.excise   * 1)
     1008     .
     1009   end.
     1010   else do:
     1011     assign
     1012           road-tax-base-sale    =  (if doc-line.road-tax = ? then 0 else doc-line.road-tax / t-doc.base-rate * t-doc.base-scale)
     1013       excise-base-sale      =  (if doc-line.excise   = ? then 0 else doc-line.excise   / t-doc.base-rate * t-doc.base-scale)
     1014     .
     1015   end.
     1016   if varoutvprb = "rubl":u then do:
     1017     assign
     1018           road-tax-rubl-sale    = (if doc-line.road-tax = ? then 0 else doc-line.road-tax * 1)
     1019       excise-rubl-sale      = (if doc-line.excise   = ? then 0 else doc-line.excise   * 1) .
     1020   end.
