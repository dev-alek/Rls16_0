     1024       excise-rubl-sale      = (if doc-line.excise   = ? then 0 else doc-line.excise   * t-doc.base-rate / t-doc.base-scale) .
     1025   end.
     1026   assign
     1027     varis-cons-parts-have =  no.
     1028   assign
     1029     varfact-qnty       = 0
     1030     varcons-qnty       = 0
     1031     varprice-base-cons = 0
     1032     varprice-rubl-cons = 0.
     1033   find first out-vatp_doc-line where
     1034              out-vatp_doc-line.doc-code   = t-doc.doc-code
     1035          and out-vatp_doc-line.artic      = doc-line.artic
     1036          and out-vatp_doc-line.prod-type  = doc-line.prod-type
     1037          and out-vatp_doc-line.prod-code  = doc-line.prod-code no-lock no-error.
     1038   if available out-vatp_doc-line           and
     1039     (out-vatp_doc-line.status_ = 'запрос':U or out-vatp_goods.gds-type = 'у':U) then do:
     1040     assign
     1041       varfact-qnty = out-vatp_doc-line.fact-qnty.
     1042   end.
     1043   else do:
     1044     for each out-vatp_parts where out-vatp_parts.out-code   = t-doc.doc-code
     1045                                  and out-vatp_parts.obj-type   = t-doc.obj-type
     1046                                  and out-vatp_parts.obj-code   = t-doc.obj-code
     1047                                  and out-vatp_parts.artic      = doc-line.artic
     1048                                  and out-vatp_parts.prod-type  = doc-line.prod-type
     1049                                  and out-vatp_parts.prod-code  = doc-line.prod-code no-lock :
     1050       if out-vatp_parts.purch-code = 2 then do:
     1051   assign
     1052     price-rubl-with-tax-loco = out-vatp_parts.price-rubl
     1053     price-base-with-tax-loco = out-vatp_parts.price-base
     1054   .
     1055   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1056   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1057     (output varinvprbo
     1058     )  .
     1059     if out-vatp_parts.out-code = 'free-zone':U     or
     1060        out-vatp_parts.out-code = 'out-zone':U   or
