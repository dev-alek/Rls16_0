     1065     else do:
     1066       find first in-vatp_doc-attro no-lock
     1067         where in-vatp_doc-attro.doc-code  = out-vatp_parts.out-code
     1068           and in-vatp_doc-attro.attr-code = 'envd':U
     1069         no-error .
