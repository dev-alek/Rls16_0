     6743   procedure print-header :
     6744   define input parameter p-doc-code           as character    no-undo.
     6745   define output parameter p-curr-abbr         as character    no-undo.
     6746       define variable v-print-doc      as character           no-undo.
     6747       define variable v-par-type       as character           no-undo.
     6748       define variable t-num            as character           no-undo.
     6749       define variable v-obj-prt-on     as logical             no-undo.
     6750       define variable t-inn            as character           no-undo.
     6751       define variable v-plat-rasch-doc as character    no-undo.
     6752       define variable v-curr-name      as character           no-undo.
