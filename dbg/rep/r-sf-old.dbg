     4459   procedure facturxl-write-cell-data :
     4460   define input parameter p-data-key   as character        no-undo.
     4461   define input parameter p-data-value as character        no-undo.
     4462       define buffer buf_temp_cell-data     for temp_cell-data.
     4463   do
     4464   for buf_temp_cell-data
     4465   on error undo, return error
     4466   :
     4467       find first buf_temp_cell-data
     4468            where buf_temp_cell-data.data-key = p-data-key
     4469       no-error.
     4470       if not available buf_temp_cell-data
     4471       then do:
     4472           create buf_temp_cell-data.
     4473           assign
     4474               buf_temp_cell-data.data-key = p-data-key
     4475           .
     4476       end.
     4477       assign
     4478           buf_temp_cell-data.data-value = p-data-value
     4479       .
     4480       put stream excel-cell unformatted
     4481                           buf_temp_cell-data.data-key
     4482           chr(9)   buf_temp_cell-data.data-value
     4483           chr(10)
     4484       .
     4485   end.
     4486   end procedure.
     4487   procedure facturxl-write-line-data :
     4488   define input parameter p-Name          as character        no-undo.
     4489   define input parameter p-UAES          as character        no-undo.
     4490   define input parameter p-EI            as character        no-undo.
     4491   define input parameter p-qnty          as character        no-undo.
     4492   define input parameter p-price         as character        no-undo.
     4493   define input parameter p-SumNoVAT      as character        no-undo.
     4494   define input parameter p-SumActciz     as character        no-undo.
     4495   define input parameter p-VATpc         as character        no-undo.
     4496   define input parameter p-VATsum        as character        no-undo.
     4497   define input parameter p-sum           as character        no-undo.
     4498   define input parameter p-country       as character        no-undo.
     4499   define input parameter p-GTD           as character        no-undo.
     4500       define buffer buf_temp_line-data        for temp_line-data.
     4501   do
     4502   for buf_temp_line-data
     4503   on error undo, return error
     4504   :
     4505       for each buf_temp_line-data
     4506       :
     4507           delete buf_temp_line-data.
     4508       end.
     4509       create buf_temp_line-data.
     4510       assign
     4511           v-facturxl-current-data-row = v-facturxl-current-data-row + 1
     4512       .
     4513       assign
     4514           buf_temp_line-data.data-key     = "LD":U
     4515           buf_temp_line-data.xl-line-id   = v-facturxl-current-data-row
     4516           buf_temp_line-data.Name         = p-Name
     4517           buf_temp_line-data.EI           = p-EI
     4518           buf_temp_line-data.qnty         = p-qnty
     4519           buf_temp_line-data.price        = p-price
     4520           buf_temp_line-data.SumNoVAT     = p-SumNoVAT
     4521           buf_temp_line-data.SumActciz    = p-SumActciz
     4522           buf_temp_line-data.VATpc        = p-VATpc
     4523           buf_temp_line-data.VATsum       = p-VATsum
     4524           buf_temp_line-data.sum          = p-sum
     4525           buf_temp_line-data.country      = p-country
     4526           buf_temp_line-data.GTD          = p-GTD
     4527       .
     4528       put stream excel-line unformatted
     4529                           buf_temp_line-data.data-key
     4530           chr(9)   buf_temp_line-data.Name
     4531           chr(9)   buf_temp_line-data.EI
     4532           chr(9)   buf_temp_line-data.qnty
     4533           chr(9)   buf_temp_line-data.price
     4534           chr(9)   buf_temp_line-data.SumNoVAT
     4535           chr(9)   buf_temp_line-data.SumActciz
     4536           chr(9)   buf_temp_line-data.VATpc
     4537           chr(9)   buf_temp_line-data.VATsum
     4538           chr(9)   buf_temp_line-data.sum
     4539           chr(9)   buf_temp_line-data.country
     4540           chr(9)   buf_temp_line-data.GTD
     4541           chr(10)
     4542       .
     4543   end.
     4544   end procedure.
     4545   procedure facturxl-run-excel :
     4546   define input parameter p-header-filename    as character        no-undo.
     4547   define input parameter p-data-filename      as character        no-undo.
     4548       define variable v-template-file-name    as character    no-undo.
     4549       define variable v-vb-file-name          as character    no-undo.
     4550       define buffer buf_temp-param for temp-param .
     4551   do
     4552   for buf_temp-param
     4553   on error undo, return error
     4554   :
     4555       create buf_temp-param.
     4556       assign
     4557           v-template-file-name    = search( "exe/sf_97.xlt" )
     4558           v-vb-file-name          = search( "exe/t_97.bas")
     4559       .
     4560       if v-template-file-name = ?
     4561       or v-template-file-name = "":U
     4562       then do:
     4563           message
     4564               "Ошибка имени файла шаблона."
     4565           view-as alert-box error.
     4566       end.
     4567       if v-vb-file-name = ?
     4568       or v-vb-file-name = "":U
     4569       then do:
     4570           message
     4571               "Ошибка имени файла кода обработки."
     4572           view-as alert-box error.
     4573       end.
     4574       run paramls-write in this-procedure (
     4575             input "template":U
     4576           , input "template-file-name":U
     4577           , input v-template-file-name
     4578       ).
     4579       run paramls-write in this-procedure (
     4580             input "template":U
     4581           , input "vb-file-name":U
     4582           , input v-vb-file-name
     4583       ).
     4584       run paramls-write in this-procedure (
     4585             input "data":U
     4586           , input "data-header-filename":U
     4587           , input p-header-filename
     4588       ).
     4589       run paramls-write in this-procedure (
     4590             input "data":U
     4591           , input "data-filename":U
     4592           , input p-data-filename
     4593       ).
     4594       run gbl/macroxlt.p (
     4595           input-output table buf_temp-param
     4596       ) no-error.
     4597       if error-status :error
     4598       then do:
     4599           message
     4600                    vss-workfile vss-revision vss-description
     4601               skip(1)
     4602               skip "Ошибка создания файла Excel."
     4603               skip return-value
     4604               skip trim(error-status :get-message(1))
     4605                    trim(error-status :get-message(2))
     4606                    trim(error-status :get-message(3))
     4607           view-as alert-box error.
     4608           undo, return error .
     4609       end.
     4610   end.
     4611   end procedure.
