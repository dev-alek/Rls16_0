     6730                   assign v-lines-counter = v-lines-counter + 1.
     6731               end.
     6732           end.
     6733       end.
     6734       assign
     6735           v-tot-sum-no-VAT    = v-tot-sum-no-VAT  + v-sum-no-VAT  + v-tax
     6736           v-tot-VAT           = v-tot-VAT         + v-VAT
     6737           v-tot-SLT           = v-tot-SLT         + v-SLT
