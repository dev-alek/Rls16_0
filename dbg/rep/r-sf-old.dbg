     3408     ,input  buf_wth-doc.obj-code
     3409     ,output v-host-code
     3410     )  .
     3411            end.
     3412         if v-torgconf-outogr = "no_print"
     3413            then do:
     3414               assign
     3415                  v-torgconf-ogr-name = ""
     3416                  v-torgconf-ogr-post = ""
     3417               .
     3418            end.
     3419         if v-torgconf-outogr  = "ruk_firm"
     3420               then do:
     3421               find first buf_sysconf no-lock
     3422               where buf_sysconf.host-code = v-host-code
     3423               no-error.
     3424               if available buf_sysconf
     3425               then do:
     3426                  assign
     3427                     v-torgconf-ogr-post = buf_sysconf.head-position
     3428                  .
     3429               end.
     3430               find first buf_clients no-lock
     3431                  where buf_clients.obj-type = 'орг':U
     3432                  and buf_clients.obj-code = v-host-code
     3433               .
     3434               find first buf_firm no-lock
     3435                  where buf_firm.firm-code = buf_clients.obj-code
     3436               .
     3437               assign
     3438                  v-torgconf-ogr-name = buf_firm.director
     3439               .
     3440            end.
     3441            if v-torgconf-outogr = "dir_obj"
     3442               then do:
     3443               find first buf_wth-doc no-lock
     3444               where buf_wth-doc.doc-code = p-doc-code
     3445               no-error.
     3446                  find first buf_shop no-lock
     3447                  where buf_shop.obj-code = buf_wth-doc.obj-code
     3448                  .
     3449                  assign
     3450                     v-torgconf-ogr-name = buf_shop.director
     3451                     v-torgconf-ogr-post = "Директор"
     3452                  .
     3453               end.
     3454         if v-torgconf-outogr = "manag_doc"
     3455            then do:
     3456               find first buf_wth-doc no-lock
     3457               where buf_wth-doc.doc-code = p-doc-code
     3458               no-error.
     3459               if available buf_wth-doc
     3460               then do:
     3461                  run rep/get-psn.p
     3462                  (input buf_wth-doc.deliver
     3463                  ,output v-torgconf-ogr-name
     3464                  ) .
     3465               end.
     3466               find first buf_person no-lock
     3467               where buf_person.psn-code = buf_wth-doc.deliver
     3468               no-error.
     3469               if available buf_person
     3470               then do:
     3471                  v-torgconf-ogr-post = buf_person.position.
     3472               end.
     3473               if v-torgconf-ogr-name = "?":U then v-torgconf-ogr-name = "".
     3474               if v-torgconf-ogr-post = ? then  v-torgconf-ogr-post = "".
     3475            end.
     3476      end.
     3477   end.
     3478   end procedure.
     3479   procedure torgconf-get-outogr-param:
     3480       define input parameter p-form-name  as character    no-undo.
     3481       define input parameter p-host-code  as integer      no-undo.
     3482       define input parameter p-obj-type   as character    no-undo.
     3483       define input parameter p-obj-code   as integer      no-undo.
     3484       define input parameter p-doc-code   as character      no-undo.
     3485       define buffer buf_firm          for ub.firm .
     3486       define buffer buf_clients       for ub.clients .
     3487       define buffer buf_sysconf       for ub.sysconf .
     3488       define buffer buf_shop          for ub.shop .
     3489       define buffer buf_store         for ub.store .
     3490       define buffer buf_person        for ub.person .
     3491       define buffer buf_trn-doc       for ub.trn-doc .
     3492       define buffer buf_wth-doc       for ub.wth-doc .
     3493      if  p-form-name <> 'wthtrg12':U
     3494      and p-form-name <> 'wthfct':U
     3495      and p-form-name <> 'wthm11':U
     3496      then do:
     3497       find first buf_trn-doc no-lock
     3498       where buf_trn-doc.doc-code = p-doc-code
     3499       no-error.
     3500       if v-torgconf-outogr = "no_print"
     3501         then do:
     3502            assign
     3503               v-torgconf-ogr-name = ""
     3504               v-torgconf-ogr-post = ""
     3505            .
     3506         end.
     3507      if v-torgconf-outogr  = "ruk_firm"
     3508            then do:
     3509            find first buf_sysconf no-lock
     3510            where buf_sysconf.host-code = p-host-code
     3511            no-error.
     3512            if available buf_sysconf
     3513            then do:
     3514               assign
     3515                  v-torgconf-ogr-post = buf_sysconf.head-position
     3516               .
     3517            end.
     3518            find first buf_clients no-lock
     3519                where buf_clients.obj-type = 'орг':U
     3520                and buf_clients.obj-code = p-host-code
     3521            .
     3522            find first buf_firm no-lock
     3523                where buf_firm.firm-code = buf_clients.obj-code
     3524            .
     3525            assign
     3526                v-torgconf-ogr-name = buf_firm.director
     3527            .
     3528         end.
     3529         if v-torgconf-outogr = "dir_obj"
     3530            then do:
     3531            find first buf_trn-doc no-lock
     3532            where buf_trn-doc.doc-code = p-doc-code
     3533            no-error.
     3534               CASE buf_trn-doc.obj-type:
     3535               WHEN 'маг':U
     3536               THEN DO:
     3537                  find first buf_shop no-lock
     3538                  where buf_shop.obj-code = buf_trn-doc.obj-code
     3539                  .
     3540                  assign
     3541                     v-torgconf-ogr-name = buf_shop.director
     3542                     v-torgconf-ogr-post = "Директор"
     3543                  .
     3544               END.
     3545               WHEN 'скл':U
     3546               THEN DO:
     3547                  find first buf_store no-lock
     3548                  where buf_store.obj-code = buf_trn-doc.obj-code
     3549                  .
     3550                  assign
     3551                     v-torgconf-ogr-name = buf_store.store-boss
     3552                     v-torgconf-ogr-post = "Директор"
     3553                  .
     3554               END.
     3555               OTHERWISE DO:
     3556                  assign
     3557                     v-torgconf-ogr-name = "":U
     3558                     v-torgconf-ogr-post = "":U
     3559                  .
     3560               END.
     3561               END CASE.
     3562            end.
     3563      if v-torgconf-outogr = "manag_doc"
     3564         then do:
     3565            find first buf_trn-doc no-lock
     3566            where buf_trn-doc.doc-code = p-doc-code
     3567            no-error.
     3568            if available buf_trn-doc
     3569            then do:
     3570               run rep/get-psn.p
     3571               (input buf_trn-doc.boss
     3572               ,output v-torgconf-ogr-name
     3573               ) .
     3574            end.
     3575            find first buf_person no-lock
     3576            where buf_person.psn-code = buf_trn-doc.boss
     3577            no-error.
     3578            if available buf_person
     3579            then do:
     3580               v-torgconf-ogr-post = buf_person.position.
     3581            end.
     3582            if v-torgconf-ogr-name = "?":U then v-torgconf-ogr-name = "".
     3583            if v-torgconf-ogr-post = ? then  v-torgconf-ogr-post = "".
     3584         end.
     3585      end.
     3586      else do:
     3587      find first buf_wth-doc no-lock
     3588         where buf_wth-doc.doc-code = p-doc-code
     3589         no-error.
     3590         if v-torgconf-outogr = "no_print"
     3591            then do:
     3592               assign
     3593                  v-torgconf-ogr-name = ""
     3594                  v-torgconf-ogr-post = ""
     3595               .
     3596            end.
     3597         if v-torgconf-outogr  = "ruk_firm"
     3598               then do:
     3599               find first buf_sysconf no-lock
     3600               where buf_sysconf.host-code = p-host-code
     3601               no-error.
     3602               if available buf_sysconf
     3603               then do:
     3604                  assign
     3605                     v-torgconf-ogr-post = buf_sysconf.head-position
     3606                  .
     3607               end.
     3608               find first buf_clients no-lock
     3609                  where buf_clients.obj-type = 'орг':U
     3610                  and buf_clients.obj-code = p-host-code
     3611               .
     3612               find first buf_firm no-lock
     3613                  where buf_firm.firm-code = buf_clients.obj-code
     3614               .
     3615               assign
     3616                  v-torgconf-ogr-name = buf_firm.director
     3617               .
     3618            end.
     3619            if v-torgconf-outogr = "dir_obj"
     3620               then do:
     3621               find first buf_wth-doc no-lock
     3622               where buf_wth-doc.doc-code = p-doc-code
     3623               no-error.
     3624                  find first buf_shop no-lock
     3625                  where buf_shop.obj-code = buf_wth-doc.obj-code
     3626                  .
     3627                  assign
     3628                     v-torgconf-ogr-name = buf_shop.director
     3629                     v-torgconf-ogr-post = "Директор"
     3630                  .
     3631               end.
     3632         if v-torgconf-outogr = "manag_doc"
     3633            then do:
     3634               find first buf_wth-doc no-lock
     3635               where buf_wth-doc.doc-code = p-doc-code
     3636               no-error.
     3637               if available buf_wth-doc
     3638               then do:
     3639                  run rep/get-psn.p
     3640                  (input buf_wth-doc.deliver
     3641                  ,output v-torgconf-ogr-name
     3642                  ) .
     3643               end.
     3644               find first buf_person no-lock
     3645               where buf_person.psn-code = buf_wth-doc.deliver
     3646               no-error.
     3647               if available buf_person
     3648               then do:
     3649                  v-torgconf-ogr-post = buf_person.position.
     3650               end.
     3651               if v-torgconf-ogr-name = "?":U then v-torgconf-ogr-name = "".
     3652               if v-torgconf-ogr-post = ? then  v-torgconf-ogr-post = "".
     3653            end.
     3654      end.
     3655   end.
     3656   procedure torgconf-get-reason  :
     3657   define input parameter  p-doc-code       as character        no-undo.
     3658   define input parameter  p-reason-code    as integer          no-undo .
     3659   define input parameter  p-doc-type       as character        no-undo.
     3660       if p-reason-code > 0
     3661       then do:
     3662           define buffer buf_trn-reason for ub.trn-reason.
     3663           find first buf_trn-reason no-lock where buf_trn-reason.reason-code = p-reason-code no-error .
     3664           if available buf_trn-reason then assign v-torgconf-reason =  buf_trn-reason.reason-name .
     3665       end.
     3666       else do:
     3667           if p-doc-type = 'при':U
     3668           then  do:
     3669               define variable v-attr-type     as character    no-undo.
     3670               define variable v-attr-value    as character    no-undo.
     3671               run gbl/trdcat-v.p (input p-doc-code,input 'nids':U,output v-attr-value,output v-attr-type) .
     3672               assign v-torgconf-reason = v-attr-value .
     3673               run gbl/trdcat-v.p (input p-doc-code,input 'dids':U,output v-attr-value,output v-attr-type) .
     3674               assign v-torgconf-reason = v-torgconf-reason + " от " + v-attr-value .
     3675           end.
     3676       end.
     3677   end procedure.
     3678   define variable vss-include-info16 as character format "X(65)" no-undo
     3679   initial "@(#)$Workfile$ $Revision$".
     3680   define temp-table temp_p-fmt_string-part no-undo
     3681       field str-key       as integer
     3682       field string-part   as character
     3683       index pi is primary unique
     3684           str-key
     3685   .
     3686   define variable v-p-fmt-16-str-key    as integer      no-undo.
     3687   FUNCTION center-field RETURNS INTEGER (INPUT iStartPix AS INTEGER, iEndPix AS INTEGER,
     3688                                     iInput AS INTEGER).
     3689     def var v-start-print as integer no-undo .
     3690     if (iStartPix < 0) or (iEndPix < iStartPix) then return 0.
     3691     assign
     3692       v-start-print = INTEGER(iStartPix + ((iEndPix - iStartPix) / 2) - (iInput / 2))
     3693     .
     3694     RETURN v-start-print .
     3695   END FUNCTION.
     3696   FUNCTION right-field RETURNS INTEGER ( iEndPix AS INTEGER,
     3697                                     iInput AS INTEGER).
     3698     def var v-start-print as integer no-undo .
     3699     assign
     3700       v-start-print = INTEGER(iEndPix - 1 - iInput)
     3701     .
     3702     if v-start-print < 0 then return 0.
     3703     RETURN v-start-print .
     3704   END FUNCTION.
     3705   function p-fmt-align-string returns character (
     3706         p-in-string      as character
     3707       , p-page-width     as integer
     3708       , p-align-type     as character
     3709   ).
     3710       define variable v-string-length     as integer      no-undo.
     3711       define variable v-out-string        as character    no-undo.
     3712       assign
     3713           v-string-length = length( trim( p-in-string ) )
     3714       .
     3715       if v-string-length >= p-page-width
     3716       then do:
     3717           assign
     3718               v-out-string = trim( p-in-string )
     3719           .
     3720       end.
     3721       else do:
     3722           case p-align-type
     3723           :
     3724               when 'left':U
     3725               then do:
     3726                   assign
     3727                       v-out-string = trim( p-in-string )
     3728                   .
     3729               end.
     3730               when 'right':U
     3731               then do:
     3732                   assign
     3733                       v-out-string = fill( " ":U, p-page-width - v-string-length ) + trim( p-in-string )
     3734                   .
     3735               end.
     3736               when 'center':U
     3737               then do:
     3738                   assign
     3739                       v-out-string = fill( " ":U, integer( ( p-page-width - v-string-length ) / 2 ) ) + trim( p-in-string )
     3740                   .
     3741               end.
     3742           end case.
     3743       end.
     3744       return v-out-string .
     3745   end function.
     3746   procedure p-fmt-split-string :
     3747   define input parameter p-source-string  as character        no-undo.
     3748   define input parameter p-split-length   as integer          no-undo.
     3749   define output parameter p-string-1      as character        no-undo.
     3750   define output parameter p-string-2      as character        no-undo.
     3751   do
     3752   on error undo, return error
     3753   :
     3754       define variable v-space-pos    as integer      no-undo.
     3755       if length( p-source-string ) <= p-split-length
     3756       then do:
     3757           assign
     3758               p-string-1 = p-source-string
     3759           .
     3760       end.
     3761       else do:
     3762           assign
     3763               v-space-pos = r-index( p-source-string, " ":U, p-split-length )
     3764           .
     3765           if v-space-pos = 0
     3766           then do:
     3767               assign
     3768                   v-space-pos = index( p-source-string, " ":U )
     3769               .
     3770           end.
     3771           if v-space-pos = 0
     3772           then do:
     3773               assign
     3774                   p-string-1 = substring( p-source-string, 1, p-split-length )
     3775                   p-string-2 = trim( substring( p-source-string, p-split-length, p-split-length ) )
     3776               .
     3777           end.
     3778           else do:
     3779               assign
     3780                   p-string-1 = substring( p-source-string, 1, v-space-pos )
     3781                   p-string-2 = trim( substring( p-source-string, v-space-pos ) )
     3782               .
     3783           end.
     3784       end.
     3785   end.
     3786   end procedure.
     3787   procedure p-fmt-round :
     3788   define input parameter p-qnty               as decimal          no-undo.
     3789   define input parameter p-price-no-VAT       as decimal          no-undo.
     3790   define input parameter p-VAT                as decimal          no-undo.
     3791   define input parameter p-SLT                as decimal          no-undo.
     3792   define input parameter p-road-tax           as decimal          no-undo.
     3793   define output parameter p-new-price-no-VAT  as decimal          no-undo.
     3794   define output parameter p-new-VAT           as decimal          no-undo.
     3795   define output parameter p-new-SLT           as decimal          no-undo.
     3796   define output parameter p-new-sum-VAT       as decimal          no-undo.
     3797   define output parameter p-new-sum-SLT       as decimal          no-undo.
     3798   define output parameter p-new-sum-road-tax  as decimal          no-undo.
     3799   define output parameter p-new-sum-no-VAT    as decimal          no-undo.
     3800   define output parameter p-new-sum-full      as decimal          no-undo.
     3801       define variable v-vat-pc    as decimal      no-undo.
     3802       define variable v-slt-pc    as decimal      no-undo.
     3803   do
     3804   on error undo, return error
     3805   :
     3806       if p-price-no-VAT = 0
     3807       then do:
     3808           assign
     3809               p-new-price-no-VAT = 0.0
     3810               p-new-VAT          = ?
     3811               p-new-SLT          = ?
     3812               p-new-sum-VAT      = 0.0
     3813               p-new-sum-SLT      = 0.0
     3814               p-new-sum-no-VAT   = 0.0
     3815               p-new-sum-road-tax = 0.0
     3816               p-new-sum-full     = 0.0
     3817           .
     3818       end.
     3819       else do:
     3820           assign
     3821               v-vat-pc            = p-VAT / p-price-no-VAT
     3822               v-slt-pc            = p-SLT / ( p-price-no-VAT + p-VAT )
     3823               p-new-price-no-VAT  = round( p-price-no-VAT, 2 )
     3824               p-new-VAT           = round( p-new-price-no-VAT * v-vat-pc, 2 )
     3825               p-new-SLT           = round( ( p-new-price-no-VAT + p-new-VAT ) * v-slt-pc, 2 )
     3826               p-new-sum-VAT       = round( p-new-VAT          * p-qnty, 2 )
     3827               p-new-sum-SLT       = round( ( p-new-price-no-VAT + p-new-VAT ) * p-qnty * v-slt-pc, 2 )
     3828               p-new-sum-no-VAT    = round( p-new-price-no-VAT * p-qnty, 2 )
     3829               p-new-sum-road-tax  = round( p-road-tax * p-qnty, 2 )
     3830               p-new-sum-full      = round( ( p-new-price-no-VAT + p-new-VAT + p-new-SLT + p-road-tax ) * p-qnty, 2 )
     3831           .
     3832       end.
     3833   end.
     3834   end procedure.
     3835   procedure p-fmt-split :
     3836   define input parameter p-in-string      as character        no-undo.
     3837   define input parameter p-split-length   as integer          no-undo.
     3838       define variable v-start-pos     as integer      no-undo.
     3839       define variable v-end-pos       as integer      no-undo.
     3840       define buffer buf_temp_p-fmt_string-part        for temp_p-fmt_string-part.
     3841   do
     3842   for buf_temp_p-fmt_string-part
     3843   on error undo, return error
     3844   :
     3845       empty temp-table buf_temp_p-fmt_string-part.
     3846       if p-split-length < 1
     3847       then do:
     3848           undo, return error substitute( "p-fmt-split: Строка не может быть разбита на &1 частей", p-split-length ).
     3849       end.
     3850       assign
     3851           p-in-string                 = trim( p-in-string )
     3852           v-p-fmt-16-str-key   = 0
     3853           v-start-pos                 = 1
     3854           v-end-pos                   = length( p-in-string )
     3855       .
     3856       run p-fmt-get-string-range in this-procedure (
     3857             input p-in-string
     3858           , input p-split-length
     3859           , input v-start-pos
     3860           , output v-start-pos
     3861           , output v-end-pos
     3862       ).
     3863       do while v-end-pos <> 0
     3864       :
     3865           create buf_temp_p-fmt_string-part.
     3866           assign
     3867               v-p-fmt-16-str-key = v-p-fmt-16-str-key + 1
     3868           .
     3869           assign
     3870               buf_temp_p-fmt_string-part.str-key      = v-p-fmt-16-str-key
     3871               buf_temp_p-fmt_string-part.string-part  = substring( p-in-string, v-start-pos, v-end-pos - v-start-pos )
     3872           .
     3873           assign
     3874               v-start-pos = v-end-pos + 1
     3875           .
     3876           run p-fmt-get-string-range in this-procedure (
     3877                 input p-in-string
     3878               , input p-split-length
     3879               , input v-start-pos
     3880               , output v-start-pos
     3881               , output v-end-pos
     3882           ).
     3883       end.
     3884   end.
     3885   end procedure.
     3886   procedure p-fmt-get-string-range :
     3887   define input parameter p-in-string      as character        no-undo.
     3888   define input parameter p-split-length   as integer          no-undo.
     3889   define input parameter p-old-start-pos  as integer          no-undo.
     3890   define output parameter p-start-pos     as integer          no-undo.
     3891   define output parameter p-end-pos       as integer          no-undo.
     3892       define variable v-init-string    as character    no-undo.
     3893       define variable v-temp-char      as character    no-undo.
     3894       define variable v-temp-pos       as integer      no-undo.
     3895       define variable v-counter        as integer      no-undo.
     3896   do
     3897   on error undo, return error
     3898   :
     3899       assign
     3900           p-start-pos   = p-old-start-pos
     3901           v-init-string = substring( p-in-string, p-start-pos )
     3902       no-error.
     3903       if error-status :error
     3904       or trim( v-init-string ) = "":U
     3905       then do:
     3906           assign
     3907               p-end-pos = 0
     3908           .
     3909           undo, return .
     3910       end.
     3911       assign
     3912           v-temp-char   = substring( v-init-string, 1, 1 )
     3913       .
     3914       do
     3915       while trim( v-temp-char ) = "":U
     3916       :
     3917           assign
     3918               p-start-pos     = p-start-pos + 1
     3919               v-init-string   = substring( p-in-string, p-start-pos )
     3920               v-temp-char     = substring( v-init-string, 1, 1 )
     3921           .
     3922       end.
     3923       assign
     3924           v-temp-pos  = p-split-length
     3925           v-temp-char = substring( v-init-string, v-temp-pos, 1 )
     3926           v-counter   = 0
     3927       .
     3928       search-word-end:
     3929       do
     3930       while trim( v-temp-char ) <> "":U
     3931       :
     3932           assign
     3933               v-counter   = v-counter + 1
     3934           .
     3935           if v-counter > 20
     3936           then do:
     3937               assign
     3938                   v-temp-pos  = p-split-length
     3939               .
     3940               leave search-word-end.
     3941           end.
     3942           assign
     3943               v-temp-pos  = v-temp-pos - 1
     3944               v-temp-char = substring( v-init-string, v-temp-pos, 1 )
