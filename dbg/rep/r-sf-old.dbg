     5757       assign
     5758               vat-base-sale               = (if out-vatp-have-vat-slt = no then 0 else (((ub.gds-dtl.price-base - ub.gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else ub.gds-dtl.price-base - ub.gds-dtl.discnt-base                - road-tax-base-sale) * ub.doc-line.SLT-pc / (100 + ub.doc-line.SLT-pc) - road-tax-base-sale - varprice-base-cons) * ub.doc-line.cons-vat-pc / (100 + ub.doc-line.cons-vat-pc) * ub.gds-dtl.doc-qnty * varcons-qnty / varfact-qnty + ((ub.gds-dtl.price-base - ub.gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else ub.gds-dtl.price-base - ub.gds-dtl.discnt-base                - road-tax-base-sale) * ub.doc-line.SLT-pc / (100 + ub.doc-line.SLT-pc) - road-tax-base-sale) * ub.doc-line.vat-pc / (100 + ub.doc-line.vat-pc) * ub.gds-dtl.doc-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     5759               vat-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else (((ub.gds-dtl.price-rubl - ub.gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else ub.gds-dtl.price-rubl - ub.gds-dtl.discnt-rubl                - road-tax-rubl-sale) * ub.doc-line.SLT-pc / (100 + ub.doc-line.SLT-pc) - road-tax-rubl-sale - varprice-rubl-cons) * ub.doc-line.cons-vat-pc / (100 + ub.doc-line.cons-vat-pc) * ub.gds-dtl.doc-qnty * varcons-qnty / varfact-qnty + ((ub.gds-dtl.price-rubl - ub.gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else ub.gds-dtl.price-rubl - ub.gds-dtl.discnt-rubl                - road-tax-rubl-sale) * ub.doc-line.SLT-pc / (100 + ub.doc-line.SLT-pc) - road-tax-rubl-sale) * ub.doc-line.vat-pc / (100 + ub.doc-line.vat-pc) * ub.gds-dtl.doc-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     5760        .
     5761     end.
     5762     else do:
     5763       assign
     5764               vat-base-sale               = (if out-vatp-have-vat-slt = no then 0 else (((ub.gds-dtl.price-base - ub.gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else ub.gds-dtl.price-base - ub.gds-dtl.discnt-base                - road-tax-base-sale) * ub.doc-line.SLT-pc / (100 + ub.doc-line.SLT-pc) - road-tax-base-sale - varprice-base-cons) * ub.doc-line.cons-vat-pc / (100 + ub.doc-line.cons-vat-pc) * ub.gds-dtl.fact-qnty * varcons-qnty / varfact-qnty + ((ub.gds-dtl.price-base - ub.gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else ub.gds-dtl.price-base - ub.gds-dtl.discnt-base                - road-tax-base-sale) * ub.doc-line.SLT-pc / (100 + ub.doc-line.SLT-pc) - varprice-base-cons) * ub.doc-line.vat-pc / (100 + ub.doc-line.vat-pc) * ub.gds-dtl.fact-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     5765               vat-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else (((ub.gds-dtl.price-rubl - ub.gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else ub.gds-dtl.price-rubl - ub.gds-dtl.discnt-rubl                - road-tax-rubl-sale) * ub.doc-line.SLT-pc / (100 + ub.doc-line.SLT-pc) - road-tax-rubl-sale - varprice-rubl-cons) * ub.doc-line.cons-vat-pc / (100 + ub.doc-line.cons-vat-pc) * ub.gds-dtl.fact-qnty * varcons-qnty / varfact-qnty + ((ub.gds-dtl.price-rubl - ub.gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else ub.gds-dtl.price-rubl - ub.gds-dtl.discnt-rubl                - road-tax-rubl-sale) * ub.doc-line.SLT-pc / (100 + ub.doc-line.SLT-pc) - varprice-rubl-cons) * ub.doc-line.vat-pc / (100 + ub.doc-line.vat-pc) * ub.gds-dtl.fact-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     5766        .
     5767     end.
     5768   end.
     5769   assign
     5770   price-base-without-tax-sale = price-base-with-tax-sale - vat-base-sale - slt-base-sale - road-tax-base-sale
     5771   price-rubl-without-tax-sale = price-rubl-with-tax-sale - vat-rubl-sale - slt-rubl-sale - road-tax-rubl-sale.
     5772                   assign
     5773                       v-VAT = ( if PrintRubl then vat-rubl-buyer else vat-base-buyer )
     5774                       v-SLT = ( if PrintRubl then slt-rubl-sale else slt-base-sale )
     5775                   .
     5776                   if v-VAT = ? then assign v-VAT = 0.
     5777                   if v-SLT = ? then assign v-SLT = 0.
     5778                   assign
     5779                       v-price-no-VAT   = ( if PrintRubl then price-rubl-with-tax-sale else price-base-with-tax-sale ) - v-VAT - v-SLT
     5780                       v-prt-qnty       = ub.gds-dtl.fact-qnty
     5781                   .
     5782                   if p-round = 'round':U
     5783                   then do:
     5784                       run p-fmt-round in this-procedure (
     5785                             input v-prt-qnty
     5786                           , input v-price-no-VAT
     5787                           , input v-VAT
     5788                           , input v-SLT
     5789                           , input 0
     5790                           , output v-price-no-VAT
     5791                           , output v-VAT
     5792                           , output v-SLT
     5793                           , output v-prt-VAT
     5794                           , output v-prt-SLT
     5795                           , output v-void-decimal
     5796                           , output v-prt-sum-no-VAT
     5797                           , output v-void-decimal
     5798                       ).
     5799                   end.
     5800                   else do:
     5801                       assign
     5802                           v-prt-VAT        = v-VAT          * v-prt-qnty
     5803                           v-prt-SLT        = v-SLT          * v-prt-qnty
     5804                           v-prt-sum-no-VAT = v-price-no-VAT * v-prt-qnty
     5805                       .
     5806                   end.
     5807                   assign
     5808                       v-price          = v-price-no-VAT + v-VAT
     5809                       v-prt-sum        = v-prt-sum-no-VAT + v-prt-VAT
     5810                   .
     5811                   assign
     5812                       v-tot-prt-qnty          = v-tot-prt-qnty        + v-prt-qnty
     5813                       v-tot-prt-VAT           = v-tot-prt-VAT         + v-prt-VAT
     5814                       v-tot-prt-SLT           = v-tot-prt-SLT         + v-prt-SLT
     5815                       v-tot-prt-sum-no-VAT    = v-tot-prt-sum-no-VAT  + v-prt-sum-no-VAT
     5816                       v-tot-prt-sum           = v-tot-prt-sum         + v-prt-sum
     5817                   .
     5818               end.
     5819               if v-must-print-scale
     5820               then do:
     5821                   find first ub.bar-code no-lock
     5822                        where ub.bar-code.gds-code    = ub.goods.gds-code
     5823                          and ub.bar-code.unit-cli    = ub.goods.unit-base
     5824                          and ub.bar-code.node-code   = ub.gds-dtl.prt-code
     5825                          and ub.bar-code.part-code   = ""
     5826                          and ub.bar-code.in-code     = ""
     5827                   .
     5828                   assign
     5829                       v-prt-name = ""
     5830                   .
     5831                   do while available ub.gds-prt:
     5832                       if available ub.gds-prt
     5833                       then do:
     5834                           assign
     5835                               v-prt-name     = "\" + string( ub.gds-prt.node-name, "X(10)" ) + v-prt-name
     5836                               v-node-code   = ub.gds-prt.upper-code
     5837                           .
     5838                       end.
     5839                       find first ub.gds-prt no-lock
     5840                            where ub.gds-prt.node-code = v-node-code
     5841                              and ub.gds-prt.root <> yes
     5842                       no-error.
     5843                   end.
     5844                   display stream out-stream
     5845                           sym1 v-prt-name @ ub.goods.gds-name
     5846                           sym2 ub.goods.unit-base
     5847                           sym3 v-prt-qnty @ v-qnty
     5848                           sym4 v-price-no-VAT
     5849                           sym5 v-prt-sum-no-VAT @ v-sum-no-VAT
     5850                           sym6 "   ---" format "x(6)" @ v-sum-actciz
     5851                           sym7 ub.doc-line.Vat-pc
     5852                           sym8 v-prt-VAT when v-prt-qnty <> 0 @ v-VAT
     5853                           sym9 v-prt-sum @ v-sum
     5854                           sym11 sym12 sym13
     5855                           with frame factur .
     5856                   v-lines-counter = v-lines-counter + 1 .
     5857                   down stream out-stream 1 with frame factur .
     5858                   run facturxl-write-line-data in this-procedure (
     5859                         input v-prt-name
     5860                       , input "":U
     5861                       , input ub.goods.unit-base
     5862                       , input string( v-prt-qnty )
     5863                       , input string( v-price-no-VAT )
     5864                       , input string( v-prt-sum-no-VAT )
     5865                       , input "   ---":U
     5866                       , input string( ub.doc-line.Vat-pc )
     5867                       , input string( v-prt-VAT )
     5868                       , input string( v-prt-sum )
     5869                       , input "":U
     5870                       , input "":U
     5871                   ).
     5872               end.
     5873           end.
     5874           assign
     5875               v-qnty          = v-tot-prt-qnty
     5876               v-VAT           = v-tot-prt-VAT
     5877               v-SLT           = v-tot-prt-SLT
     5878               v-sum-no-VAT    = v-tot-prt-sum-no-VAT
     5879               v-sum           = v-tot-prt-sum
     5880           .
     5881           if not v-must-print-scale
     5882           then do:
     5883               assign v-price-no-VAT = v-sum-no-VAT / v-qnty.
     5884               find first ub.bar-code no-lock
     5885                       where ub.bar-code.gds-code = ub.goods.gds-code
     5886                       and ub.bar-code.unit-cli = ub.goods.unit-base
     5887                       and ub.bar-code.node-code = rootnode_code
     5888                       and ub.bar-code.part-code = ""
     5889                       and ub.bar-code.in-code = ""
     5890               .
     5891               for each ub.parts no-lock
     5892                   where ub.parts.out-code = ub.doc-line.doc-code
     5893                       and ub.parts.obj-type = ub.doc-line.obj-type
     5894                       and ub.parts.obj-code = ub.doc-line.obj-code
     5895                       and ub.parts.artic = ub.doc-line.artic
     5896                       and ub.parts.prod-type = ub.doc-line.prod-type
     5897                       and ub.parts.prod-code = ub.doc-line.prod-code
     5898               :
     5899                       assign v-GTD = ub.parts.cst-code.
     5900                       if available ub.country
     5901                       and ub.country.alpha1 = "RU":U
     5902                       then do:
     5903                           assign
     5904                               v-GTD       = "-":U
     5905                               v-country   = "-":U
     5906                           .
     5907                       end.
     5908                       find first buf_parts-attr no-lock
     5909                         where buf_parts-attr.in-code   = ub.parts.in-code
     5910                           and buf_parts-attr.gds-code  = ub.goods.gds-code
     5911                           and buf_parts-attr.part-code = ub.parts.part-code
     5912                       no-error .
     5913                       if available buf_parts-attr
     5914                         and buf_parts-attr.country-code <> 0
     5915                         then do:
     5916                             find first buf_country
     5917                             where buf_country.num-code = buf_parts-attr.country-code
     5918                             no-error.
     5919                             if available buf_country
     5920                             and buf_country.num-code <> ub.country.num-code
     5921                             and buf_country.short-name <> ""
     5922                             then do :
     5923                                 assign
     5924                                     v-country = buf_country.short-name
     5925                                   .
     5926                                 if buf_country.alpha1 = "RU":U
     5927                                 then do :
     5928                                     assign
     5929                                       v-country = "-":U
     5930                                       v-GTD     = "-":U
     5931                                     .
     5932                                 end .
     5933                             end.
     5934                       end.
     5935                       display stream Out-stream
     5936                               sym1 string(ub.goods.artic,"X(16)") + " " + ub.goods.gds-name @ ub.goods.gds-name
     5937                               sym2 ub.goods.unit-base
     5938                               sym3 ub.parts.fact-qnty @ v-qnty
     5939                               sym4 v-price-no-VAT
     5940                               sym5 (if v-qnty <> 0 then v-sum-no-VAT * ub.parts.fact-qnty / v-qnty else 0 ) @ v-sum-no-VAT
     5941                               sym6 "   ---" format "x(6)" @ v-sum-actciz
     5942                               sym7 ub.doc-line.Vat-pc
     5943                               sym8 v-VAT * ub.parts.fact-qnty / v-qnty when v-qnty <> 0 @ v-VAT
     5944                               sym9 (if v-qnty <> 0 then v-sum * ub.parts.fact-qnty / v-qnty else 0 ) @ v-sum
     5945                               sym11 v-country
     5946                               sym12 v-GTD
     5947                               sym13
     5948                               with frame factur .
     5949                       down stream Out-stream 1 with frame factur .
     5950                       run facturxl-write-line-data in this-procedure (
     5951                             input string( ub.goods.artic, "X(16)" ) + " " + ub.goods.gds-name
     5952                           , input "":U
     5953                           , input ub.goods.unit-base
     5954                           , input string( ub.parts.fact-qnty )
     5955                           , input string( v-price-no-VAT )
     5956                           , input (if v-qnty <> 0 then v-sum-no-VAT * ub.parts.fact-qnty / v-qnty else 0 )
     5957                           , input "   ---":U
     5958                           , input string( ub.doc-line.Vat-pc )
     5959                           , input ( if v-qnty = 0 then "":U else string( v-VAT * ub.parts.fact-qnty / v-qnty ) )
     5960                           , input string( if v-qnty <> 0 then v-sum * ub.parts.fact-qnty / v-qnty else 0 )
     5961                           , input v-country
     5962                           , input v-GTD
     5963                       ).
     5964                       if FullGdsName
     5965                       and goods.gds-name <> "":U then do :
     5966                         run print-more in this-procedure.
     5967                       end.
     5968                       v-lines-counter = v-lines-counter + 1 .
     5969               end.
     5970           end.
     5971       end.
     5972       else do:
     5973           find first ub.bar-code no-lock
     5974                   where ub.bar-code.gds-code = ub.goods.gds-code
     5975                   and ub.bar-code.unit-cli = ub.goods.unit-base
     5976                   and ub.bar-code.node-code = rootnode_code
     5977                   and ub.bar-code.part-code = ""
     5978                   and ub.bar-code.in-code = ""
     5979           .
     5980           if CostPrice = yes
     5981           then do:
     5982               assign v-qnty = ub.doc-line.doc-qnty.
     5983   assign
     5984     price-rubl-with-tax-loc = ub.doc-line.price-rubl
     5985     price-base-with-tax-loc = ub.doc-line.price-base
     5986   .
     5987   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     5988   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     5989     (output varinvprb
     5990     )  .
     5991      find first in-vatp_doc-attr no-lock
     5992       where in-vatp_doc-attr.doc-code  = buf_trn-doc.doc-code
     5993         and in-vatp_doc-attr.attr-code = 'envd':U
     5994       no-error .
     5995       if available in-vatp_doc-attr
     5996          then do:
     5997          assign
     5998            in-vatp-have-vat-slt = no.
     5999      end.
     6000      else do:
     6001        assign
     6002          in-vatp-have-vat-slt = yes.
     6003      end.
     6004      find first in-vatp-goods where in-vatp-goods.artic     = ub.doc-line.artic     and
     6005                                        in-vatp-goods.prod-type = ub.doc-line.prod-type and
     6006                                        in-vatp-goods.prod-code = ub.doc-line.prod-code no-lock.
     6007      if (not buf_trn-doc.internal and
     6008              buf_trn-doc.doc-type = 'при':U) or
     6009         in-vatp-goods.gds-type = 'у':U then do:
     6010         if varinvprb = "base":u then do:
     6011           assign
     6012             road-tax-base-loc = ub.doc-line.road-tax
     6013             road-tax-rubl-loc = ub.doc-line.road-tax * buf_trn-doc.base-rate / buf_trn-doc.base-scale.
     6014         end.
     6015         else do:
     6016           ASSIGN
     6017             road-tax-rubl-loc = ub.doc-line.road-tax
     6018             road-tax-base-loc = ub.doc-line.road-tax / buf_trn-doc.base-rate * buf_trn-doc.base-scale.
     6019         end.
     6020         if road-tax-base-loc = ? then road-tax-base-loc = 0.
     6021         if road-tax-rubl-loc = ? then road-tax-rubl-loc = 0.
     6022         assign
     6023           road-tax-cli-loc = ?.
     6024         ASSIGN
     6025           transport-base-loc = (if ub.doc-line.transport-base = ? then 0 else ub.doc-line.transport-base)
     6026           transport-rubl-loc = (if ub.doc-line.transport-rubl = ? then 0 else ub.doc-line.transport-rubl)
     6027           transport-cli-loc  = 0
     6028           other-base-loc     = (if ub.doc-line.other-base     = ? then 0 else ub.doc-line.other-base)
     6029           other-rubl-loc     = (if ub.doc-line.other-rubl     = ? then 0 else ub.doc-line.other-rubl)
     6030           other-cli-loc      = 0
     6031           vat-pc-loc         = (if ub.doc-line.vat-pc         = ? then 0 else ub.doc-line.vat-pc)
     6032           slt-pc-loc         = (if ub.doc-line.slt-pc         = ? then 0 else ub.doc-line.slt-pc).
     6033                                 ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     6034               ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     6035         assign
     6036           vat-cli-loc            = ?
     6037           slt-cli-loc            = ?
     6038           price-cli-with-tax-loc = ?.
     6039      end.
     6040      else do:
     6041                                                   for each in-vatp-parts where in-vatp-parts.out-code  = ub.doc-line.doc-code  and
     6042                                         in-vatp-parts.obj-type  = ub.doc-line.obj-type  and
     6043                                         in-vatp-parts.obj-code  = ub.doc-line.obj-code  and
     6044                                         in-vatp-parts.artic     = ub.doc-line.artic     and
     6045                                         in-vatp-parts.prod-type = ub.doc-line.prod-type and
     6046                                         in-vatp-parts.prod-code = ub.doc-line.prod-code
     6047                            use-index out-code no-lock:
     6048             accumulate  in-vatp-parts.road-tax-base  * in-vatp-parts.fact-qnty (total)
     6049                         in-vatp-parts.road-tax-rubl  * in-vatp-parts.fact-qnty (total)
     6050                         in-vatp-parts.transport-base * in-vatp-parts.fact-qnty (total)
     6051                         in-vatp-parts.transport-rubl * in-vatp-parts.fact-qnty (total)
     6052                         in-vatp-parts.other-base     * in-vatp-parts.fact-qnty (total)
     6053                         in-vatp-parts.other-rubl     * in-vatp-parts.fact-qnty (total)
     6054                                                                                                                 (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  (total)
     6055                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))  (total)
     6056                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))  (total)
     6057                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc))  (total)
