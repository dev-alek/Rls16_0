     6678                                   ).
     6679                       display stream out-stream
     6680                           fill(" ", 19) + v-tax-name @ goods.gds-name
     6681                           v-prt-qnty                                                   @ v-qnty
     6682                               ( if PrintRubl then parts.road-tax-rubl else parts.road-tax-base )
     6683                                                                                       @ v-price-no-VAT
