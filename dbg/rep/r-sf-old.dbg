     6776     ,output v-value-date
     6777     ,output v-value-decimal
     6778     ,output v-value-integer
     6779     ,output v-value-logical
     6780     ,output par-type
     6781     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     6782     ) no-error .
     6783   for each thbjattr_thbj-attr :
     6784       if thbjattr_thbj-attr.prop-code = 'factur01' then v-print-doc =  string(thbjattr_thbj-attr.property-value-logical) .
     6785   end.
     6786       assign
     6787         p-sf-par = no
     6788       .
     6789       run torgconf-get-form-header in this-procedure (
     6790             input Invers
     6791           , input buf_trn-doc.doc-code
