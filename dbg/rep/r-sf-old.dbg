     6879      run facturxl-write-cell-data in this-procedure (
     6880           input "h_cargoFrom":U
     6881         , input v-out-name
     6882      ).
     6883      if LENGTH(v-out-name) > 145
     6884         then do:
     6885            put stream Out-stream
     6886               skip    space(5) string( "Грузоотправитель и его адрес"
     6887                                    + ( if p-round = 'round':U then ":" else " " )
     6888                                    + fill( " ", 11 )
     6889                                    + ( if buf_trn-doc.office = yes
     6890                                          then "---"
     6891                                          else SUBSTRING(v-out-name,1,145))) format "X(190)"
     6892               skip    space(45) SUBSTRING(v-out-name,146) format "X(145)" skip
     6893            .
     6894         end.
     6895         else do:
     6896            put stream Out-stream
     6897               skip    space(5) string( "Грузоотправитель и его адрес"
     6898                                       + ( if p-round = 'round':U then ":" else " " )
     6899                                       + fill( " ", 11 )
     6900                                       + ( if buf_trn-doc.office = yes
     6901                                             then "---"
     6902                                             else v-out-name)) format "X(190)" skip
     6903            .
     6904         end.
     6905       run facturxl-write-cell-data in this-procedure (
     6906             input "h_docCode":U
     6907           , input v-torgconf-doc-code
     6908       ).
     6909       run facturxl-write-cell-data in this-procedure (
     6910             input "h_docDate":U
     6911           , input v-torgconf-doc-date
     6912       ).
     6913       run facturxl-write-cell-data in this-procedure (
     6914             input "h_supplier":U
     6915           , input v-torgconf-supplier-name + IF v-torgconf-supplier-engl-name = "":U THEN "":U ELSE SUBSTITUTE(" (&1)", v-torgconf-supplier-engl-name )
     6916       ).
     6917       run facturxl-write-cell-data in this-procedure (
     6918             input "h_supplierAddr":U
     6919           , input v-torgconf-supplier-addr
     6920       ).
     6921       run facturxl-write-cell-data in this-procedure (
     6922             input "h_supplierINN":U
     6923           , input t-inn
     6924       ).
     6925       assign
     6926           t-inn = substitute( "&1&2&3", v-torgconf-saler-inn, ( if v-torgconf-saler-kpp = "":U then "":U else "/":U ), v-torgconf-saler-kpp )
     6927       .
     6928       if lookup( "GreenL", p-mode ) <> 0
     6929       then do:
     6930           assign
     6931               v-plat-rasch-doc    = "":U
     6932           .
     6933       end.
     6934       else do:
     6935           assign
     6936               v-plat-rasch-doc    = " N ":U + ( if p-round = 'round':U then ": ":U else " ":U ) + fill( " ", 6 ) + v-torgconf-plat-rasch-doc
     6937           .
     6938       end.
     6939            if LOOKUP( "serv", p-mode ) <> 0 then v-out-name = '---------------------'  .
     6940            else if     buf_trn-doc.doc-type <> 'при':U
     6941               and buf_trn-doc.doc-type <> 'возврат':U
     6942            then v-out-name =  v-torgconf-consignee.
     6943            else v-out-name =  v-torgconf-cargo-to-value .
     6944            run facturxl-write-cell-data in this-procedure (
     6945                  input "h_cargoTo":U
     6946                , input v-out-name
     6947            ).
     6948           if LENGTH(v-out-name) > 145
     6949            then do:
     6950               put stream Out-stream
     6951                  space(5) string( "Грузополучатель и его адрес" + ( if p-round = 'round':U then ": " else " " ) + fill( " ", 12 ) + SUBSTRING(v-out-name,1,145))   format "X(190)"
     6952                  skip space(45) SUBSTRING(v-out-name, 146) format "X(145)"
     6953               .
     6954            end.
     6955            else do:
     6956               put stream Out-stream
     6957                  space(5) string( "Грузополучатель и его адрес" + ( if p-round = 'round':U then ": " else " " ) + fill( " ", 12 ) + v-out-name)   format "X(190)"
     6958               .
     6959            end.
     6960           put stream Out-stream
     6961           skip    space(5) string( "К платежно-расчетному документу" + v-plat-rasch-doc ) format "X(190)"
     6962           skip(1) space(5) string( "Покупатель" + ( if p-round = 'round':U then ":" else " " ) + fill( " ", 29 ) + v-torgconf-saler-name +
     6963                                                   if v-torgconf-outprncd = yes
     6964                                                   then substitute( " (&1)", v-torgconf-saler-code )
     6965                                                   else "":U  ) format "X(190)"
     6966           skip    space(5) string( "Адрес" + ( if p-round = 'round':U then ":" else " " ) + fill( " ", 34 ) + v-torgconf-saler-addr ) format "X(190)"
     6967           skip    space(5) string( "Идентификационный номер покупателя (ИНН/КПП)" + ( if p-round = 'round':U then ": " else " " ) + t-inn ) format "X(190)"
     6968           skip    space(5) "Дополнение (условия оплаты по договору (контракту), способ отправления и т.п." format "X(190)"
     6969           skip    space(5) string( fill( "_", 130 ) ) format "X(130)"
     6970           skip
     6971       .
     6972       run facturxl-write-cell-data in this-procedure (
     6973             input "h_platDoc":U
     6974           , input v-torgconf-plat-rasch-doc
     6975       ).
     6976       run facturxl-write-cell-data in this-procedure (
     6977             input "h_saler":U
     6978           , input v-torgconf-saler-name + if v-torgconf-outprncd = yes
     6979                                           then substitute( " (&1)", v-torgconf-saler-code )
     6980                                           else "":U
     6981       ).
     6982       run facturxl-write-cell-data in this-procedure (
     6983             input "h_salerAddr":U
     6984           , input v-torgconf-saler-addr
     6985       ).
     6986       run facturxl-write-cell-data in this-procedure (
     6987             input "h_salerINN":U
     6988           , input t-inn
     6989       ).
     6990       assign
     6991           t-currency = ( trim( ( if invers and buf_trn-doc.doc-type <> 'при':U then v-curr-name else ( if PrintRubl then v-rubl-name else v-base-name  ) ) ) + "." )
     6992       .
     6993       run facturxl-write-cell-data in this-procedure (
     6994             input "h_currency":U
     6995           , input t-currency
     6996       ).
     6997       if buf_trn-doc.ext-doc-type = 'ep':U
     6998       then do:
     6999           put stream Out-stream
     7000               space(10) "Возврат товара поставщику." format "X(120)" skip
     7001           .
     7002       end.
     7003       if v-torgconf-outrubl = no
     7004       then do:
     7005           put stream Out-stream
     7006               space(10)
     7007                   string( "Валюта : " +
     7008                   trim( ( if invers and buf_trn-doc.doc-type <> 'при':U then v-curr-name else ( if PrintRubl then v-rubl-name else v-base-name  ) ) ) + "." ) format "X(120)"
     7009           .
     7010       end.
     7011       if v-torgconf-outprim = no
     7012       then do:
     7013           put stream Out-stream
     7014               skip space(10)
     7015               ( if not( buf_trn-doc.PS begins "@" )
     7016               then string( "Примечание : " + substr( buf_trn-doc.PS, 1, 120 ) )
     7017               else ""
     7018               ) format "X(120)"
     7019           .
     7020       end.
     7021       put stream Out-stream
     7022           skip
     7023       .
     7024   end.
     7025   end procedure.
     7026   procedure print-footer :
     7027   define variable v-base-code as integer     no-undo .
     7028   define variable v-base-abbr as character   no-undo .
     7029   define buffer buf_currency      for ub.currency.
     7030   do
     7031   on error undo, return error
     7032   :
     7033       put stream Out-stream
     7034           v-single-line format "X(198)"
     7035       .
     7036       if line-counter( Out-stream ) + 10 > page-size( Out-stream )
     7037       then do:
     7038           page stream Out-stream.
     7039       end.
     7040       run facturxl-write-cell-data in this-procedure (
     7041             input "it_SumNoVAT":U
     7042           , input string( v-tot-sum-no-VAT )
     7043       ).
     7044       run facturxl-write-cell-data in this-procedure (
     7045             input "it_VATsum":U
     7046           , input string( v-tot-VAT )
     7047       ).
     7048       run facturxl-write-cell-data in this-procedure (
     7049             input "it_sum":U
     7050           , input string( v-tot-sum )
     7051       ).
     7052       display stream Out-stream
     7053           "Всего" @ ub.goods.gds-name
     7054           v-tot-sum-no-VAT  @ v-sum-no-VAT
     7055           v-tot-VAT         @ v-VAT
     7056           v-tot-sum         @ v-sum
     7057       with frame factur .
     7058       down stream Out-stream 2 with frame factur .
     7059   define variable vss-include-info42 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7060   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     7061     (input  v-cntxt-host-code-obj
     7062     ,output v-base-code
     7063     )  .
     7064       find first buf_currency no-lock
     7065            where buf_currency.curr-code = v-base-code
     7066       .
     7067       assign
     7068           v-base-abbr = buf_currency.curr-abbr
     7069       .
     7070       if abs( v-tot-SLT ) >= 0.005
     7071       or ( not invers and abs( buf_trn-doc.discnt-rubl ) >= 0.005 )
     7072       then do:
     7073           put stream Out-stream
     7074               space(5) "Итого по документу: "
     7075               trim( string( v-tot-sum, "->,>>>,>>>,>>>,>>>,>>9.99" ) )
     7076               + " ("
     7077               + trim( ( if invers and buf_trn-doc.doc-type <> 'при':U then v-curr-abbr else ( if PrintRubl then "РУБ" else v-base-abbr ) ) )
     7078               + ")"
     7079                                                                           format "X(120)"     at 40
     7080           .
     7081           if v-tot-SLT <> 0 and p-no-slt = false
     7082           then do:
     7083               put stream Out-stream
     7084                   skip space(10) "Налог с продаж: "
     7085                           trim( string( v-tot-SLT, "->>>,>>9.99" ) )
     7086                           + " ("
     7087                           + trim( ( if PrintRubl then "РУБ" else v-base-abbr ) )
     7088                           + ")"
     7089                                                                           format "X(150)"     at 40
     7090               .
     7091           end.
     7092           if buf_trn-doc.discnt-rubl <> 0
     7093           and not invers
     7094           and v-torgconf-outdisc = no
     7095           then do:
     7096               put stream Out-stream
     7097                   skip space(14) "Скидка:"
     7098                           trim( string( ( if PrintRubl
     7099                                           then buf_trn-doc.discnt-rubl
     7100                                           else buf_trn-doc.tot-calc ), "->>>,>>>,>>>,>>9.99" ) )
     7101                           + " ("
     7102                           + trim( ( if PrintRubl then "РУБ" else v-base-abbr ) )
     7103                           + ")"
     7104                                                                           format "X(150)"     at 40
     7105               .
     7106           end.
     7107       end.
     7108       if v-tot-tax <> 0
     7109       then do:
     7110           put stream Out-stream
     7111               skip space(10)  v-tax-name + ": "                                   format "X(20)"
     7112                   trim( string( v-tot-tax, "->>>,>>>,>>>,>>9.99" ) )
     7113                   + " ("
     7114                   + trim( ( if invers and buf_trn-doc.doc-type <> 'при':U then v-curr-abbr else ( if PrintRubl then "РУБ" else v-base-abbr ) ) )
     7115                   + ")"
     7116                                                                           format "X(150)"     at 40
     7117           .
     7118       end.
     7119       put stream Out-stream
     7120           skip space(5) "Итого к оплате: "
     7121                           string( trim( string( v-tot-sum + v-tot-SLT, "->,>>>,>>>,>>>,>>>,>>9.99" ) )
     7122                           + " ("
     7123                           + trim( ( if invers and buf_trn-doc.doc-type <> 'при':U then v-curr-abbr else ( if PrintRubl then "РУБ" else v-base-abbr ) ) )
     7124                           + ")" )
     7125                                                                           format "X(150)"     at 40
     7126       .
     7127       if PrintRubl
     7128       and v-torgconf-outprops = yes
     7129       then do:
     7130           run rep/wp-rub.p (
     7131               input v-tot-sum + v-tot-SLT
     7132               , output v-propis
     7133               , output v-propis-cop
     7134           ).
     7135           put stream out-stream
     7136               skip space(25) v-propis
     7137                                                                               format "X(150)"  at 40
     7138               skip(1)
     7139           .
     7140           run facturxl-write-cell-data in this-procedure (
     7141                 input "h_summ_prop":U
     7142               , input v-propis
     7143           ).
     7144       end.
     7145       if v-torgconf-outsubs = no
     7146       then do:
     7147           run facturxl-write-cell-data in this-procedure (
     7148                 input "f_bossName":U
     7149               , input v-torgconf-main-boss
     7150           ).
     7151           run facturxl-write-cell-data in this-procedure (
     7152                 input "f_buhName":U
     7153               , input v-torgconf-main-buh
     7154           ).
     7155       end.
     7156       if v-torgconf-outsubs = no
     7157       and trim(v-torgconf-main-boss) = "":U
     7158       or v-torgconf-outsubs = yes
     7159         then do:
     7160               v-torgconf-main-boss = fill( "_", 36 ).
     7161         end.
     7162       if v-torgconf-outsubs = no
     7163       and trim(v-torgconf-main-buh) = "":U
     7164       or v-torgconf-outsubs = yes
     7165         then do:
     7166            v-torgconf-main-buh = fill( "_", 36 ).
     7167         end.
     7168           put stream Out-stream
     7169               skip(2) space(10) "Руководитель организации   " format "X(28)" fill( "_", 26 ) format "X(26)" "    /" v-torgconf-main-boss format "X(36)" "/"
     7170               "      Главный бухгалтер   " format "X(25)"fill( "_", 26 ) format "X(26)" "    /" v-torgconf-main-buh format "X(36)" "/"
     7171               skip space(45) "(подпись)" space(30) "(Ф.И.О)"  space(47) "(подпись)" space(30) "(Ф.И.О)"
     7172           .
     7173       if v-torgconf-outegrp = no
     7174       then do :
     7175         if trim(v-torgconf-self-host-name) = "":U
     7176         then do:
     7177             v-torgconf-self-host-name = fill("_", 42).
     7178         end.
     7179         if v-torgconf-self-host-egrip-date <> "":U
     7180          or v-torgconf-self-host-egrip-num  <> "":U
     7181          then do:
     7182             put stream Out-stream
     7183                 skip (1) space(10) substitute( "Индивидуальный предприниматель   &1  / &2 / ЕГРИП N &3 от &4 ", fill( "_", 26 ) , string(v-torgconf-self-host-name, "x(42)") , v-torgconf-self-host-egrip-num, v-torgconf-self-host-egrip-date ) format "X(174)"
     7184                 skip     space(51) "(подпись)"  space(29) "(Ф.И.О)" space(22) "(реквизиты свидетельства о государственной"
     7185                 skip     space(119) substitute( "регистрации индивидуального предпринимателя)" ) format "X(90)"
     7186                 skip
     7187             .
     7188             run facturxl-write-cell-data in this-procedure (
     7189                   input "f_ownerName":U
     7190                 , input v-torgconf-self-host-name
     7191             ).
     7192             run facturxl-write-cell-data in this-procedure (
     7193                 input "f_ownerReg":U
     7194               , input substitute ("N &1 от &2 ", v-torgconf-self-host-egrip-num, v-torgconf-self-host-egrip-date )
     7195             ).
     7196         end.
     7197         else do :
     7198             put stream Out-stream
     7199                 skip (1) space(10) substitute( "Индивидуальный предприниматель   &1  / &2 /  &3  ", fill( "_", 26 ) , fill("_", 42) , fill( "_", 50 ) ) format "X(174)"
     7200                 skip     space(51) "(подпись)"  space(29) "(Ф.И.О)" space(22) "(реквизиты свидетельства о государственной"
     7201                 skip     space(119) substitute( "регистрации индивидуального предпринимателя)" ) format "X(90)"
     7202                 skip
     7203             .
     7204         end.
     7205       end.
     7206       put stream Out-stream  skip "Примечание. Первый экземпляр - покупателю, второй экземпляр - продавцу"   format "X(90)"
     7207       .
     7208   end.
     7209   end procedure.
