     1028           v-torgconf-outprim  = no
     1029           v-torgconf-outdisc  = no
     1030           v-torgconf-outsubs  = no
     1031           v-torgconf-outrecv  = no
     1032           v-torgconf-outegrp  = no
     1033           v-torgconf-outt12   = no
     1034           v-torgconf-outappr  = no
     1035           v-torgconf-outrubl  = no
     1036           v-torgconf-outhold  = no
     1037           v-torgconf-outobj   = no
     1038           v-torgconf-outexlst = no
     1039           v-torgconf-outexpas = "":U
     1040           v-torgconf-outprncd = yes
     1041           v-torgconf-outares  = no
     1042           v-torgconf-outsend  = no
     1043           v-torgconf-outasend  = no
     1044           v-torgconf-outprops  = no
     1045           v-form-name          = p-form-name
     1046       .
     1047   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1048   empty temp-table thbjattr_thbj-attr.
     1049   run adm/shattri.p (
     1050      input "get":U
     1051     ,input ''
     1052     ,input 0
     1053     ,input 'prt-glob':U
     1054     ,input  ""
     1055     ,output v-value-character
     1056     ,output v-value-date
     1057     ,output v-value-decimal
     1058     ,output v-value-integer
     1059     ,output v-value-logical
