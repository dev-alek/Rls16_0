     6524       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     6525     assign
     6526       exch-rate-cli-loc = (ub.parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if ub.parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if ub.parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / ub.parts.price-cli .
     6527     assign
     6528       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
     6529       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
     6530       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
     6531       transport-cli-loc  = 0
     6532       other-cli-loc      = 0
     6533     .
     6534   ASSIGN
     6535             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     6536       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     6537   .
     6538                       assign
     6539                           v-parts-VAT       = ( if PrintRubl then vat-rubl-loc      else vat-base-loc )
     6540                           v-parts-SLT       = ( if PrintRubl then slt-rubl-loc      else slt-base-loc )
     6541                           v-tax-price       = ( if PrintRubl then road-tax-rubl-loc else road-tax-base-loc )
     6542                       .
     6543                       if v-parts-VAT = ?  then assign v-parts-VAT = 0.
     6544                       if v-parts-SLT = ?  then assign v-parts-SLT = 0.
     6545                       if v-tax-price = ?  then assign v-tax-price = 0.
     6546                       assign
     6547                           v-parts-price-no-VAT    =
     6548                                             ( if PrintRubl
     6549                                             then price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - road-tax-rubl-loc
     6550                                             else price-base-with-tax-loc - vat-base-loc - slt-base-loc - road-tax-base-loc )
     6551                           v-parts-sum             =
     6552                                             ( if PrintRubl
     6553                                             then price-rubl-with-tax-loc
     6554                                             else price-base-with-tax-loc ) * v-prt-qnty
     6555                       .
     6556                       if v-r-factur-is-vozvrat-vnesh = yes
     6557                       then do:
     6558                           assign
     6559                               v-parts-price-no-VAT = v-parts-price-no-VAT
     6560                                               - ( if PrintRubl
     6561                                                   then ( transport-rubl-loc + other-rubl-loc )
     6562                                                   else ( transport-base-loc + other-base-loc ) )
     6563                               v-parts-sum          = v-parts-sum
     6564                                               - ( ( if PrintRubl
     6565                                                     then ( transport-rubl-loc + other-rubl-loc )
     6566                                                     else ( transport-base-loc + other-base-loc ) ) * v-prt-qnty )
     6567                           .
     6568                       end.
     6569                       if p-round = 'round':U
     6570                       then do:
     6571                           if v-first-parts = yes
     6572                           then do:
     6573                               assign
     6574                                   v-first-parts   = no
     6575                                   v-sum-no-VAT    = 0
     6576                                   v-VAT           = 0
     6577                                   v-SLT           = 0
     6578                                   v-tax           = 0
     6579                                   v-sum           = 0
     6580                               .
     6581                           end.
     6582                           run p-fmt-round in this-procedure (
     6583                                 input v-prt-qnty
     6584                               , input v-parts-price-no-VAT
     6585                               , input v-parts-VAT
     6586                               , input v-parts-SLT
     6587                               , input v-tax-price
     6588                               , output v-parts-price-no-VAT
     6589                               , output v-parts-VAT
     6590                               , output v-parts-SLT
     6591                               , output v-sum-VAT
     6592                               , output v-sum-SLT
     6593                               , output v-sum-tax
     6594                               , output v-parts-sum-no-VAT
     6595                               , output v-parts-sum
     6596                           ).
     6597                           assign
     6598                               v-sum-no-VAT    = v-sum-no-VAT  + v-parts-sum-no-VAT
     6599                               v-VAT           = v-VAT         + v-sum-VAT
     6600                               v-SLT           = v-SLT         + v-sum-SLT
     6601                               v-tax           = v-tax         + v-sum-tax
     6602                               v-sum           = v-sum         + v-parts-sum
     6603                           .
     6604                       end.
     6605                       display stream Out-stream
     6606                           sym1 gds-str1                                                           @ ub.goods.gds-name
     6607                           sym2 ( if invers then ub.doc-line.unit-cli else ub.goods.unit-base )          @ ub.goods.unit-base
     6608                           sym3 v-prt-qnty                                                         @ v-qnty
     6609                           sym4 v-parts-price-no-VAT                                               @ v-price-no-VAT
     6610                           sym5 v-parts-price-no-VAT * v-prt-qnty                                  @ v-sum-no-VAT
     6611                           sym6 "   ---" format "x(6)"                                             @ v-sum-actciz
     6612                           sym7 ub.doc-line.Vat-pc
     6613                           sym8 v-parts-VAT * v-prt-qnty  when v-qnty <> 0                         @ v-VAT
     6614                           sym9 v-parts-sum                                                        @ v-sum
     6615                           sym11 v-country
     6616                           sym12 v-GTD
     6617                           sym13
     6618                       with frame factur .
     6619                       down stream Out-stream 1
     6620                       with frame factur .
     6621                       run facturxl-write-line-data in this-procedure (
     6622                             input string( ub.goods.artic, "X(16)" ) + " " + ub.goods.gds-name
     6623                           , input "":U
     6624                           , input ( if invers then ub.doc-line.unit-cli else ub.goods.unit-base )
     6625                           , input string( v-prt-qnty                        )
     6626                           , input string( v-parts-price-no-VAT              )
     6627                           , input string( v-parts-price-no-VAT * v-prt-qnty )
     6628                           , input "   ---":U
     6629                           , input string( ub.doc-line.Vat-pc          )
     6630                           , input ( if v-qnty = 0 then "":U else string( v-parts-VAT * v-prt-qnty ) )
     6631                           , input string( v-parts-sum              )
     6632                           , input v-country
     6633                           , input v-GTD
     6634                       ).
     6635                   end.
     6636                   else do:
     6637                       display stream Out-stream
     6638                           sym1 gds-str1                                                           @ ub.goods.gds-name
     6639                           sym2 ( if invers then ub.doc-line.unit-cli else ub.goods.unit-base )       @ ub.goods.unit-base
     6640                           sym3 v-prt-qnty                                                         @ v-qnty
     6641                           sym4 v-price-no-VAT
     6642                           sym5 v-price-no-VAT * v-prt-qnty                                        @ v-sum-no-VAT
     6643                           sym6 "   ---" format "x(6)"                                             @ v-sum-actciz
     6644                           sym7 ub.doc-line.Vat-pc
     6645                           sym8 v-VAT / v-qnty * v-prt-qnty when v-qnty <> 0                       @ v-VAT
     6646                           sym9  ( v-price-no-VAT + v-VAT / v-qnty ) * v-prt-qnty when v-qnty <> 0 @ v-sum
     6647                           sym11 v-country
     6648                           sym12 v-GTD
     6649                           sym13
     6650                       with frame factur .
     6651                       down stream Out-stream 1
     6652                       with frame factur .
     6653                       run facturxl-write-line-data in this-procedure (
     6654                             input string( ub.goods.artic, "X(16)" ) + " " + ub.goods.gds-name
     6655                           , input "":U
     6656                           , input ( if invers then ub.doc-line.unit-cli else ub.goods.unit-base )
     6657                           , input string( v-prt-qnty                        )
     6658                           , input string( v-price-no-VAT              )
     6659                           , input string( v-price-no-VAT * v-prt-qnty )
     6660                           , input "   ---":U
     6661                           , input string( ub.doc-line.Vat-pc          )
     6662                           , input ( if v-qnty = 0 then "":U else string( v-VAT / v-qnty * v-prt-qnty ) )
     6663                           , input ( if v-qnty = 0 then "":U else string( ( v-price-no-VAT + v-VAT / v-qnty ) * v-prt-qnty ) )
     6664                           , input v-country
     6665                           , input v-GTD
     6666                       ).
     6667                   end.
     6668                   if FullGdsName
     6669                   and gds-str1 <> "":U then do :
     6670                      run print-more in this-procedure.
     6671                   end.
     6672   define variable vss-include-info38 as character format "X(65)" no-undo
