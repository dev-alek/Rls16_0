     5159   procedure print-more:
     5160   do
     5161   on error undo, return error
     5162   :
     5163       define variable v-start-string as character no-undo.
     5164       define variable v-add-string as character no-undo.
     5165       assign
     5166           v-start-string = gds-str2
     5167       .
     5168       do while trim(v-start-string) <> "" :
     5169           assign gds-str = v-start-string.
     5170           v-add-string = breakstr(gds-str, 54, input-output v-add-string, input-output v-start-string).
     5171           display stream Out-stream
     5172               sym1 fill(" ",17) + v-add-string @ ub.goods.gds-name
     5173               sym2 sym3 sym4 sym5 sym6 sym7 sym8
     5174               sym9  sym11 sym12 sym13
     5175               with frame factur .
     5176           down stream Out-stream 1 with frame factur .
     5177       end.
     5178   end.
     5179   end procedure.
     5180   procedure print-line :
     5181   do
     5182   on error undo, return error
     5183   :
     5184   define variable v-print-parts     as logical    init no       no-undo.
     5185       find first ub.goods no-lock
     5186            where ub.goods.prod-type = ub.doc-line.prod-type
     5187              and ub.goods.prod-code = ub.doc-line.prod-code
     5188              and ub.goods.artic = ub.doc-line.artic
     5189       .
     5190       find first ub.country no-lock
     5191            where ub.country.alpha1 = ub.goods.alpha1
     5192       no-error.
     5193       if lookup( "zum", p-mode ) <> 0
     5194       then do:
     5195           assign
     5196               v-country = ub.goods.engl-name
     5197           .
     5198       end.
     5199       else do:
     5200           if available ub.country
     5201           then do:
     5202               assign
     5203                   v-country = ub.country.short-name
     5204               .
     5205           end.
     5206           else do:
     5207               assign
     5208                   v-country = ""
     5209               .
     5210           end.
     5211       end.
     5212       assign
     5213           gds-str  = ''
     5214           gds-str1 = ''
     5215           gds-str2 = ''
     5216       .
     5217       find first ub.Units no-lock
     5218            where ub.units.unit-name = ub.goods.unit-base
     5219       .
     5220       if (units.type = "дро,2ед"  or  ub.units.type = "дро,доп" )
     5221       then do:
     5222           assign
     5223               str =  string(ub.goods.artic,"x(16)") +  " "  + string(ub.goods.Sort,"x(5)") + " " + trim(ub.goods.gds-name)
     5224                                                                                    + " " + trim(ub.goods.PS)
     5225           .
     5226       end.
     5227       else do:
     5228           assign
     5229               str = string(ub.goods.artic,"x(16)") +  " "  + trim(ub.goods.gds-name)
     5230           .
     5231       end.
     5232       assign
     5233           Gds-str1 = breakstr(str, 54, input-output gds-str1, input-output gds-str2)
     5234       .
     5235       do while trim(gds-str2) <> "" :
     5236           assign
     5237               gds-str = gds-str2
     5238               gds-str1 = breakstr(gds-str, 54, input-output gds-str1, input-output gds-str2)
     5239           .
     5240       end.
     5241       assign
     5242           gds-str1 = breakstr(str, 54, input-output gds-str1, input-output gds-str2).
     5243       .
     5244       find first ub.gds-prt no-lock
     5245            where ub.gds-prt.upper-code = ub.doc-line.prt-root
     5246       .
     5247       assign
     5248           rootnode_code = ub.gds-prt.node-code
     5249       .
     5250       if ( ub.gds-prt.node-name <> '_Пустая шкала':U )
     5251       then do:
     5252           assign
     5253               v-tot-prt-qnty          = 0
     5254               v-tot-prt-VAT           = 0
