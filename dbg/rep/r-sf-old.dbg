     6864           skip(1) space(5) string( "Продавец" + ( if p-round = 'round':U then ":" else " " ) + fill( " ", 31 ) + v-torgconf-supplier-name + IF v-torgconf-supplier-engl-name = "":U THEN "":U ELSE SUBSTITUTE(" (&1)", v-torgconf-supplier-engl-name )) format "X(190)"
     6865           skip    space(5) string( "Адрес"    + ( if p-round = 'round':U then ":" else " " ) + fill( " ", 34 ) + v-torgconf-supplier-addr ) format "X(190)"
     6866           skip    space(5) string( "Идентификационный номер продавца (ИНН/КПП)" + ( if p-round = 'round':U then ":" else " " ) + t-inn ) format "X(190)"
     6867           .
