     6709                       , input "0":U
     6710                       , input
     6711                               ( if PrintRubl then parts.road-tax-rubl * v-prt-qnty
     6712                                              else parts.road-tax-base * v-prt-qnty )
     6713                       , input "":U
     6714                       , input "":U
     6715                       , input "":U
     6716                   ).
