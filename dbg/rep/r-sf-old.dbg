     4237   def var vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4238   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
     4239   procedure paramls-clear :
     4240     define buffer buf_temp-param for temp-param .
     4241     do
     4242     on error undo, return error return-value
     4243     :
     4244       for each buf_temp-param
     4245       on error undo, return error
     4246       :
     4247         delete buf_temp-param .
     4248       end.
     4249     end.
     4250   end procedure.
     4251   procedure paramls-write :
     4252     define input  parameter p-code     as character no-undo .
     4253     define input  parameter p-sub-code as character no-undo .
     4254     define input  parameter p-value    as character no-undo .
     4255     define buffer buf_temp-param for temp-param .
     4256     do
     4257     on error undo, return error return-value
     4258     :
     4259       find first buf_temp-param
     4260         where buf_temp-param.param-code     = p-code
     4261           and buf_temp-param.param-sub-code = p-sub-code
     4262         no-error .
     4263       if not available buf_temp-param then do:
     4264         create buf_temp-param .
     4265         assign
     4266           buf_temp-param.param-code     = p-code
     4267           buf_temp-param.param-sub-code = p-sub-code
     4268         .
     4269       end.
     4270       assign
     4271         buf_temp-param.param-value = p-value
     4272       .
     4273     end.
     4274   end procedure.
     4275   procedure paramls-read :
     4276     define input  parameter p-code          as character no-undo .
     4277     define input  parameter p-sub-code      as character no-undo .
     4278     define input  parameter p-default-value as character no-undo .
     4279     define output parameter p-value         as character no-undo .
     4280     define buffer buf_temp-param for temp-param .
     4281     do
     4282     on error undo, return error return-value
     4283     :
     4284       find first buf_temp-param
     4285         where buf_temp-param.param-code     = p-code
     4286           and buf_temp-param.param-sub-code = p-sub-code
     4287         no-error .
     4288       if available buf_temp-param then do:
     4289         assign
     4290           p-value = buf_temp-param.param-value
     4291         .
     4292       end.
     4293       else do:
     4294         assign
     4295           p-value = p-default-value
     4296         .
     4297       end.
     4298     end.
     4299   end procedure.
     4300   procedure paramls-append :
     4301     define input  parameter p-code     as character no-undo .
     4302     define input  parameter p-sub-code as character no-undo .
     4303     define input  parameter p-value    as character no-undo .
     4304     define buffer buf_temp-param for temp-param .
     4305     do
     4306     on error undo, return error return-value
     4307     :
     4308       find first buf_temp-param
     4309            where buf_temp-param.param-code     = p-code
     4310              and buf_temp-param.param-sub-code = p-sub-code
     4311         no-error .
     4312       if not available buf_temp-param then do:
     4313         create buf_temp-param .
     4314         assign
     4315           buf_temp-param.param-code     = p-code
     4316           buf_temp-param.param-sub-code = p-sub-code
     4317           buf_temp-param.param-value    = p-value
     4318         .
     4319       end.
     4320       else do:
     4321           assign
     4322               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
     4323           .
     4324       end.
     4325     end.
     4326   end procedure.
     4327   define variable vss-include-info19 as character format "X(65)" no-undo
     4328   initial "@(#)$Workfile$ $Revision$".
     4329   define stream excel-line.
     4330   define stream excel-cell.
     4331   define temp-table temp_cell-data no-undo
     4332       field data-key as character
     4333       field data-value as character
     4334       index pi is primary unique data-key
     4335   .
     4336   define temp-table temp_line-data no-undo
     4337       field data-key     as character
     4338       field xl-line-id   as integer
     4339       field Name         as character
     4340       field EI           as character
     4341       field qnty         as character
     4342       field price        as character
     4343       field SumNoVAT     as character
     4344       field SumActciz    as character
     4345       field VATpc        as character
     4346       field VATsum       as character
     4347       field sum          as character
     4348       field country      as character
     4349       field GTD          as character
     4350       index pi is primary unique xl-line-id
     4351   .
     4352   define variable v-facturxl-current-data-row     as integer      no-undo.
     4353   define variable v-facturxl-cell-file-name       as character    no-undo.
     4354   define variable v-facturxl-data-file-name       as character    no-undo.
     4355   procedure facturxl-init :
     4356       define buffer buf_temp_cell-data        for temp_cell-data.
     4357       define buffer buf_usr-flt               for ubflt.usr-flt.
     4358   do
     4359   for buf_temp_cell-data
     4360     , buf_usr-flt
     4361   on error undo, return error
     4362   :
     4363       assign
     4364           v-facturxl-current-data-row = 0
     4365       .
     4366       run gbl/_tmpfile.p (
     4367             input "xd"
     4368           , input ".txt"
     4369           , output v-facturxl-data-file-name
     4370       ).
     4371       output stream excel-line to value( v-facturxl-data-file-name ).
     4372       run gbl/_tmpfile.p (
     4373             input "xc"
     4374           , input ".txt"
     4375           , output v-facturxl-cell-file-name
     4376       ).
     4377       output stream excel-cell to value( v-facturxl-cell-file-name ).
     4378       if printrubl
     4379       then do:
     4380           run facturxl-write-cell-data in this-procedure (
     4381                 input "valutCode":U
     4382               , input "0":U
     4383           ).
     4384       end.
     4385       else do:
     4386           run facturxl-write-cell-data in this-procedure (
     4387                 input "valutCode":U
     4388               , input "1":U
     4389           ).
     4390       end.
     4391       run facturxl-write-cell-data in this-procedure (
     4392             input "columnList":U
     4393           , input "Name,EI,qnty,price,SumNoVAT,SumActciz,VATpc,VATsum,sum,country,GTD":U
     4394       ).
     4395       run facturxl-write-cell-data in this-procedure (
     4396             input "columnType":U
     4397           , input "S,S,D,C,C,S,D,C,C,S,S":U
     4398       ).
     4399       run facturxl-write-cell-data in this-procedure (
     4400             input "columnAmount":U
     4401           , input "11":U
     4402       ).
     4403       run facturxl-write-cell-data in this-procedure (
     4404             input "subtotalList":U
     4405           , input "SumNoVAT,VATsum,sum":U
     4406       ).
     4407       run facturxl-write-cell-data in this-procedure (
     4408             input "subtotalType":U
     4409           , input "S,S,S":U
     4410       ).
     4411       run facturxl-write-cell-data in this-procedure (
     4412             input "subtotalAmount":U
     4413           , input "3":U
     4414       ).
     4415   end.
     4416   end procedure.
     4417   procedure facturxl-close :
     4418   do
     4419   on error undo, return error
     4420   :
     4421       output stream excel-line close.
     4422       output stream excel-cell close.
     4423       output to value( string( session:temp-directory + "$" + string( g#report-num ) ) + ".txl" ) append.
     4424           export "exe/sf_97old.xlt":U.
     4425           export "exe/t_97.bas":U.
     4426           export v-facturxl-cell-file-name.
     4427           export v-facturxl-data-file-name.
     4428       output close.
     4429   end.
     4430   end procedure.
