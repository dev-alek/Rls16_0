     2178     field inn         as character
     2179     field no-vat-rubl as decimal
     2180     field vat-rubl    as decimal
     2181     field acc-rubl    as decimal
     2182     index xpk is primary unique doc-code supp-vat-pc supp-slt-pc
     2183     index xie1 fact-order doc-code supp-vat-pc supp-slt-pc
     2184     .
     2185   DEFINE VARIABLE SelectDocument AS CHARACTER
     2186        VIEW-AS RADIO-SET VERTICAL
     2187        RADIO-BUTTONS
     2188             "Все", "1",
     2189   "Кроме межфирменных", "2",
     2190   "Межфирменные", "3"
     2191        SIZE 42.63 BY 2.38
     2192        FGCOLOR 0  NO-UNDO.
     2193   DEFINE RECTANGLE RECT-cashiers
     2194        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     2195        SIZE 44.5 BY 4.25.
     2196   DEFINE FRAME F-Main
     2197        SelectDocument AT ROW 2.83 COL 2.38 NO-LABEL
     2198        "Документы :" VIEW-AS TEXT
     2199             SIZE 12 BY .92 AT ROW 1.5 COL 2
     2200             FGCOLOR 4
     2201        RECT-cashiers AT ROW 1.25 COL 1.5
     2202       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
     2203            SIDE-LABELS NO-UNDERLINE THREE-D
     2204            AT COL 1 ROW 1
     2205            SIZE 56.88 BY 11.83.
     2206   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
     2207   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
     2208   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
     2209   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
     2210   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
     2211   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
     2212   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
     2213   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
     2214       ASSIGN adm-object-hdl = FRAME F-Main:HANDLE.
     2215   RUN ensure-broker.
     2216   THIS-PROCEDURE:ADM-DATA =
     2217        'ADM1.1~`':U +
     2218        'SmartObject~`':U +
     2219        'FRAME~`':U +
     2220        'NO ~`':U +
     2221        '~`':U +
     2222        '~`':U +
     2223        '~`':U +
     2224        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
     2225           + "~`":U +
     2226        'Layout,Hide-on-Init~`':U +
     2227        '~`':U +
     2228        '~`':U +
     2229        '~`~`~`~`~`~`~`~`~`~`~`':U +
     2230        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
     2231            THEN "^^":U
     2232        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
     2233             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
     2234   PROCEDURE adm-apply-entry :
     2235     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     2236   END PROCEDURE.
     2237   PROCEDURE adm-destroy :
     2238    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     2239   END PROCEDURE.
     2240   PROCEDURE adm-disable :
     2241       DISABLE RECT-cashiers SelectDocument WITH FRAME F-Main.
     2242       RUN dispatch ('disable-fields':U).
     2243       RUN set-attribute-list ('ENABLED=no':U).
     2244       RETURN.
     2245   END PROCEDURE.
     2246   PROCEDURE adm-edit-attribute-list :
     2247         RUN adm/support/contnrd.w (INPUT THIS-PROCEDURE).
     2248         RETURN.
     2249   END PROCEDURE.
     2250   PROCEDURE adm-enable :
     2251       ENABLE UNLESS-HIDDEN RECT-cashiers SelectDocument WITH FRAME F-Main.
     2252       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
     2253       RUN set-attribute-list ('ENABLED=yes':U).
     2254       RETURN.
     2255   END PROCEDURE.
     2256   PROCEDURE adm-exit :
     2257        RUN notify ('exit':U).
     2258     RETURN.
     2259   END PROCEDURE.
     2260   PROCEDURE adm-hide :
     2261     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     2262   END PROCEDURE.
     2263   PROCEDURE adm-initialize :
     2264     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     2265   END PROCEDURE.
     2266   PROCEDURE adm-show-errors :
     2267       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
     2268       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
     2269           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
     2270       END.
     2271       RETURN.
     2272   END PROCEDURE.
     2273   PROCEDURE adm-UIB-mode :
     2274     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     2275   END PROCEDURE.
     2276   PROCEDURE adm-view :
     2277     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     2278   END PROCEDURE.
     2279   PROCEDURE dispatch :
     2280       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
     2281       RUN broker-dispatch IN adm-broker-hdl
     2282           (THIS-PROCEDURE, p-method-name) NO-ERROR.
     2283       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
     2284   END PROCEDURE.
     2285   PROCEDURE ensure-broker :
     2286   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
     2287   IF RETURN-VALUE NE "ADM-Broker":U THEN
     2288   DO:
     2289       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
     2290       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
     2291   END.
     2292   END PROCEDURE.
     2293   PROCEDURE get-attribute :
     2294     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
     2295     RUN broker-get-attribute IN adm-broker-hdl
     2296         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
     2297     RETURN RETURN-VALUE.
     2298   END PROCEDURE.
     2299   PROCEDURE get-attribute-list :
     2300     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
     2301     RUN broker-get-attribute-list IN adm-broker-hdl
     2302         (INPUT THIS-PROCEDURE,
     2303          INPUT ?,
     2304          OUTPUT p-attr-list) NO-ERROR.
     2305     RETURN.
     2306   END PROCEDURE.
     2307   PROCEDURE new-state :
     2308     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     2309     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
     2310     RETURN.
     2311   END PROCEDURE.
     2312   PROCEDURE notify :
     2313     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
     2314     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
     2315     IF RETURN-VALUE = "ADM-ERROR":U THEN
     2316         RETURN "ADM-ERROR":U.
     2317     RETURN.
     2318   END PROCEDURE.
     2319   PROCEDURE set-attribute-list :
     2320     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
     2321     RUN ensure-broker.
     2322     RUN broker-set-attribute-list IN adm-broker-hdl
     2323         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
     2324     RETURN.
     2325   END PROCEDURE.
     2326   PROCEDURE set-position :
     2327       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
     2328       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
     2329       IF VALID-HANDLE(adm-object-hdl) THEN
     2330       DO:
     2331           DEFINE VARIABLE parent-hdl AS HANDLE NO-UNDO.
     2332           IF adm-object-hdl:TYPE = "WINDOW":U THEN
     2333           DO:
     2334             IF p-row = 0 THEN p-row =
     2335               (SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2.
     2336             IF p-col = 0 THEN p-col =
     2337               (SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2.
     2338           END.
     2339           ELSE IF adm-object-hdl:TYPE = "DIALOG-BOX":U THEN
     2340           DO:
     2341             parent-hdl = adm-object-hdl:PARENT.
     2342             IF p-row = 0 THEN p-row =
     2343               ((SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2) -
     2344                 parent-hdl:ROW.
     2345             IF p-col = 0 THEN p-col =
     2346               ((SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2) -
     2347                 parent-hdl:COL.
     2348           END.
     2349           IF p-row GE 0 AND p-row < 1 THEN p-row = 1.
     2350           IF p-col GE 0 AND p-col < 1 THEN p-col = 1.
     2351         ASSIGN adm-object-hdl:ROW    =   p-row
     2352                adm-object-hdl:COLUMN =   p-col.
     2353       END.
     2354       RETURN.
     2355   END PROCEDURE.
     2356   RUN set-attribute-list ("CURRENT-PAGE=0,ADM-OBJECT-HANDLE=":U +
     2357       STRING(adm-object-hdl)).
     2358   PAUSE 0 BEFORE-HIDE.
     2359   PROCEDURE adm-change-page :
     2360     RUN broker-change-page IN adm-broker-hdl (INPUT THIS-PROCEDURE) NO-ERROR.
     2361     END PROCEDURE.
     2362   PROCEDURE delete-page :
     2363     DEFINE INPUT PARAMETER p-page# AS INTEGER NO-UNDO.
     2364     RUN broker-delete-page IN adm-broker-hdl
     2365         (INPUT THIS-PROCEDURE, INPUT p-page#).
     2366     END PROCEDURE.
     2367   PROCEDURE init-object :
     2368     DEFINE INPUT PARAMETER  p-proc-name   AS CHARACTER NO-UNDO.
     2369     DEFINE INPUT PARAMETER  p-parent-hdl  AS HANDLE    NO-UNDO.
     2370     DEFINE INPUT PARAMETER  p-attr-list   AS CHARACTER NO-UNDO.
     2371     DEFINE OUTPUT PARAMETER p-proc-hdl    AS HANDLE    NO-UNDO.
     2372     RUN broker-init-object IN adm-broker-hdl
     2373         (INPUT THIS-PROCEDURE, INPUT p-proc-name, INPUT p-parent-hdl,
     2374          INPUT p-attr-list, OUTPUT p-proc-hdl) NO-ERROR.
     2375     RETURN.
     2376   END PROCEDURE.
     2377   PROCEDURE init-pages :
     2378     DEFINE INPUT PARAMETER p-page-list      AS CHARACTER NO-UNDO.
     2379     RUN broker-init-pages IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     2380         INPUT p-page-list) NO-ERROR.
     2381     END PROCEDURE.
     2382   PROCEDURE select-page :
     2383     DEFINE INPUT PARAMETER p-page#     AS INTEGER   NO-UNDO.
     2384     RUN broker-select-page IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     2385         INPUT p-page#) NO-ERROR.
     2386     END PROCEDURE.
     2387   PROCEDURE view-page :
     2388     DEFINE INPUT PARAMETER p-page#      AS INTEGER   NO-UNDO.
     2389     RUN broker-view-page IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     2390         INPUT p-page#).
     2391     END PROCEDURE.
     2392   if not this-procedure :persistent
     2393   then do:
     2394     message
     2395       vss-workfile vss-revision vss-description skip
     2396       "Ошибка при запуске процедуры" skip
     2397       "Данную процедуру следует запускать только с параметром persistent" skip
     2398       view-as alert-box error .
     2399     undo, return error .
     2400   end.
     2401   run get-report-num in parParentProc
     2402     (output g#report-num
     2403     ).
     2404   PROCEDURE adm-create-objects :
     2405   END PROCEDURE.
     2406   PROCEDURE adm-row-available :
     2407     DEFINE VARIABLE tbl-list           AS CHARACTER INIT "":U NO-UNDO.
     2408     DEFINE VARIABLE rowid-list         AS CHARACTER NO-UNDO.
     2409     DEFINE VARIABLE row-avail-cntr     AS INTEGER INIT 0 NO-UNDO.
     2410     DEFINE VARIABLE row-avail-rowid    AS ROWID NO-UNDO.
     2411     DEFINE VARIABLE row-avail-enabled  AS LOGICAL NO-UNDO.
     2412     DEFINE VARIABLE link-handle        AS CHARACTER NO-UNDO.
     2413     DEFINE VARIABLE record-source-hdl  AS HANDLE NO-UNDO.
     2414     DEFINE VARIABLE different-row      AS LOGICAL NO-UNDO INIT no.
     2415     DEFINE VARIABLE key-name           AS CHARACTER INIT ? NO-UNDO.
     2416     DEFINE VARIABLE key-value          AS CHARACTER INIT ? NO-UNDO.
     2417     RUN check-modified IN THIS-PROCEDURE ('check':U) NO-ERROR.
     2418     IF adm-updating-record THEN RETURN.
     2419     RUN get-attribute ('FIELDS-ENABLED':U).
     2420     row-avail-enabled = IF RETURN-VALUE = "YES":U THEN yes ELSE no.
     2421     RUN get-link-handle IN adm-broker-hdl (THIS-PROCEDURE, 'RECORD-SOURCE':U,
     2422         OUTPUT link-handle) NO-ERROR.
     2423     IF link-handle = "":U THEN
     2424         RETURN.
     2425     ASSIGN record-source-hdl = WIDGET-HANDLE(ENTRY(1,link-handle)).
     2426     IF NUM-ENTRIES(link-handle) > 1 THEN
     2427         MESSAGE "row-available in ":U THIS-PROCEDURE:FILE-NAME
     2428             "encountered more than one RECORD-SOURCE.":U SKIP
     2429             "The first - ":U record-source-hdl:file-name " - will be used.":U
     2430                VIEW-AS ALERT-BOX ERROR.
     2431     RUN get-attribute ('Key-Name':U).
     2432     key-name = RETURN-VALUE.
     2433     IF key-name = "":U THEN key-name = ?.
     2434     IF key-name NE ? THEN DO:
     2435       RUN send-key IN record-source-hdl (INPUT key-name, OUTPUT key-value)
     2436         NO-ERROR.
     2437       IF key-value NE ? THEN
     2438         RUN set-attribute-list (SUBSTITUTE ('Key-Value="&1"':U, key-value)).
     2439     END.
     2440   IF VALID-HANDLE (adm-object-hdl) THEN
     2441       RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     2442   RUN notify IN THIS-PROCEDURE ('row-available':U).
     2443   END PROCEDURE.
     2444   PROCEDURE check-new-page :
     2445     define input  parameter p-address-num-lines as integer   no-undo .
     2446     do
     2447     on error undo, return error return-value
     2448     :
     2449       if line-counter ( PrnLibStream ) + p-address-num-lines > 42
     2450       then do:
     2451         page stream PrnLibStream .
     2452         put stream PrnLibStream
     2453           cur-time-print() at 5 format "x(35)"
     2454           "Страница " at 100 page-number(PrnLibStream) at 115 format ">>>9" skip
     2455           .
     2456         put stream PrnLibStream
     2457           '-----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------':u format "X(185)" skip
     2458           ':       1        :       2        :    3     :                    4                     :        5        :        7        :  8   :     9           :       12        :   10   :  11   :':u format "X(185)" skip
     2459           '-----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------':u format "X(185)" skip
     2460           .
     2461       end.
     2462     end.
     2463   END PROCEDURE.
     2464   PROCEDURE disable_UI :
     2465     HIDE FRAME F-Main.
     2466     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     2467   END PROCEDURE.
     2468   PROCEDURE enable_UI :
     2469     DISPLAY SelectDocument
     2470         WITH FRAME F-Main.
     2471     ENABLE RECT-cashiers SelectDocument
     2472         WITH FRAME F-Main.
     2473   END PROCEDURE.
     2474   PROCEDURE My-Report :
     2475   run My-Var in this-procedure .
     2476   run PrintProc in this-procedure .
     2477   END PROCEDURE.
     2478   PROCEDURE My-var :
     2479   assign
     2480     frame F-Main SelectDocument
     2481   .
     2482   assign
     2483     STR-obj-type = ''
     2484     STR-obj-code = ''
     2485     STR-obj-name = ''
     2486     STR-obj      = ''
     2487   .
     2488   for each obj-list no-lock
     2489   :
     2490     assign
     2491       STR-obj-type = STR-obj-type + obj-list.obj-type + ','
     2492       STR-obj-code = STR-obj-code + String(obj-list.obj-code) + ','
     2493       STR-obj-name = STR-obj-name + obj-list.obj-name + ','
     2494       STR-obj = STR-obj +  obj-list.obj-type + '#' + string(obj-list.obj-code)  + ','
     2495     .
     2496   end.
     2497   assign
     2498     ReportName   = "Журнал регистрации полученных счетов-фактур"
     2499     ReportHeader = "Документы : " +
     2500                      radio-label(string(SelectDocument), SelectDocument:radio-buttons) + chr(10)
     2501   .
     2502   END PROCEDURE.
     2503   PROCEDURE print-excel-header :
     2504     define input  parameter p-host-code as integer   no-undo .
     2505     define input-output parameter p-excel-line as integer   no-undo .
     2506     do
     2507     on error undo, return error return-value
     2508     :
     2509       run macr_excel_char in this-procedure
     2510         (input  format-excel-text(ReportName)
     2511         ,input  p-excel-line
     2512         ,input  1
     2513         ) .
     2514       assign
     2515         p-excel-line = p-excel-line + 1
     2516       .
     2517       run macr_excel_char in this-procedure
     2518         (input  format-excel-text(ReportHeader)
     2519         ,input  p-excel-line
     2520         ,input  1
     2521         ) .
     2522       run fmtcli-get-client in this-procedure
     2523         (input  'орг':U
     2524         ,input  p-host-code
     2525         ) .
     2526       assign
     2527         p-excel-line = p-excel-line + 1
     2528       .
     2529       run macr_excel_char in this-procedure
     2530         (input  format-excel-text(str1 + " по организации " + v-fmtcli-name )
     2531         ,input  p-excel-line
     2532         ,input  1
     2533         ) .
     2534       define variable v-str-num-entries   as integer   no-undo .
     2535       define variable v-str-entry         as integer   no-undo .
     2536       define variable v-str-text          as character no-undo .
     2537       define variable v-sub-start         as integer   no-undo .
     2538       define variable v-num-lines         as integer   no-undo .
     2539       define variable v-start-length-list as character no-undo .
     2540       define variable v-cur-line          as integer   no-undo .
     2541       assign
     2542         v-str-num-entries = num-entries(str4, chr(10))
     2543       .
     2544       do v-str-entry = 1 to v-str-num-entries
     2545       :
     2546         assign
     2547           v-str-text = entry(v-str-entry, str4, chr(10))
     2548         .
     2549         run split-string in this-procedure
     2550           (input  v-str-text
     2551           ,input  60
     2552           ,output v-num-lines
     2553           ,output v-start-length-list
     2554           ) .
     2555         do v-cur-line = 1 to v-num-lines
     2556         :
     2557           assign
     2558             p-excel-line = p-excel-line + 1
     2559           .
     2560           run macr_excel_char in this-procedure
     2561             (input
     2562               format-excel-text
     2563               ( substring
     2564                 (v-str-text
     2565                 ,integer
     2566                   (entry
     2567                     (v-cur-line * 2 - 1
     2568                     ,v-start-length-list
     2569                     ,chr(44)
     2570                     )
     2571                   )
     2572                 ,integer
     2573                   (entry
     2574                     (v-cur-line * 2
     2575                     ,v-start-length-list
     2576                     ,chr(44)
     2577                     )
     2578                   )
     2579                 )
     2580               )
     2581             ,input  p-excel-line
     2582             ,input  1
     2583             ) .
     2584         end.
     2585       end.
     2586       assign
     2587         p-excel-line = p-excel-line + 1
     2588       .
     2589       run macr_excel_char in this-procedure
     2590         (input  format-excel-text(cur-time-print())
     2591         ,input  p-excel-line
     2592         ,input  1
     2593         ) .
     2594     end.
     2595   END PROCEDURE.
     2596   PROCEDURE PrintProc :
     2597     define buffer buf_temp-doc-list for temp-doc-list .
     2598     define buffer buf_obj-list      for obj-list .
     2599     define buffer buf_trn-doc       for ub.trn-doc .
     2600     define buffer buf_clients       for ub.clients .
     2601     define variable v-select-document as logical   no-undo .
     2602     define variable v-is-hold         as logical   no-undo .
     2603     define variable v-scf-code        as character no-undo .
     2604     define variable v-scf-date        as date      no-undo .
     2605     define variable v-scf-date-str    as character no-undo .
     2606     define variable v-parameter-type  as character no-undo .
     2607     define buffer buf_d-slts-vats for d-slts-vats .
     2608     do
     2609     on error undo, return error return-value
     2610     :
     2611       define variable v-host-code as integer   no-undo .
     2612       define variable v-first-obj-type  as character no-undo .
     2613       define variable v-first-obj-code  as integer   no-undo .
     2614       define variable v-other-host-code as integer   no-undo .
     2615       find first buf_obj-list
     2616         no-error .
     2617       if available buf_obj-list
     2618       then do:
     2619         assign
     2620           v-first-obj-type = buf_obj-list.obj-type
     2621           v-first-obj-code = buf_obj-list.obj-code
     2622         .
     2623   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2624   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2625     (input  buf_obj-list.obj-type
     2626     ,input  buf_obj-list.obj-code
     2627     ,output v-host-code
     2628     )  .
     2629       end.
     2630       else do:
     2631         message
     2632           "Не выбран объект" skip
     2633           view-as alert-box error .
     2634         return .
     2635       end.
     2636       for each buf_obj-list
     2637       on error undo, return error return-value
     2638       :
     2639   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2640   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2641     (input  buf_obj-list.obj-type
     2642     ,input  buf_obj-list.obj-code
     2643     ,output v-other-host-code
     2644     )  .
     2645         if v-other-host-code <> v-host-code
     2646         then do:
     2647           message
