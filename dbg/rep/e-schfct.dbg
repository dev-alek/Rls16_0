     4093   PROCEDURE split-string :
     4094     define input  parameter p-split-string      as character no-undo .
     4095     define input  parameter p-split-length      as integer   no-undo .
     4096     define output parameter p-address-num-lines as integer   no-undo .
     4097     define output parameter p-start-length-list as character no-undo .
     4098     define variable v-ind as integer   no-undo .
     4099     do
     4100     on error undo, return error return-value
     4101     :
     4102       assign
     4103         v-ind = 1
     4104         p-address-num-lines = 0
     4105       .
     4106       do while true
     4107       :
     4108         if v-ind + p-split-length > length(p-split-string)
     4109         then do:
     4110           assign
     4111             p-address-num-lines = p-address-num-lines + 1
     4112             p-start-length-list = p-start-length-list
     4113                                 + (if p-start-length-list <> "" then ',':u else '':u)
     4114                                 + string(v-ind)
     4115                                 + chr(44)
     4116                                 + string(length(p-split-string) - v-ind + 1)
     4117           .
     4118           leave .
     4119         end.
     4120         else do:
     4121           define variable v-space-index as integer   no-undo .
     4122           assign
     4123             v-space-index = r-index(substring(p-split-string, v-ind, p-split-length), " ")
     4124           .
     4125           if v-space-index = 0
     4126           then do:
     4127             assign
     4128               v-space-index = r-index(substring(p-split-string, v-ind, p-split-length), ",")
     4129             .
     4130           end.
     4131           if v-space-index = 0
     4132           then do:
     4133             assign
     4134               v-space-index = p-split-length
     4135             .
     4136           end.
     4137           assign
     4138             p-address-num-lines = p-address-num-lines + 1
     4139             p-start-length-list = p-start-length-list
     4140                                 + (if p-start-length-list <> "" then ',':u else '':u)
     4141                                 + string(v-ind)
     4142                                 + chr(44)
     4143                                 + string(v-space-index)
     4144           .
     4145           assign
     4146             v-ind = v-ind + v-space-index
     4147           .
     4148         end.
     4149       end.
     4150     end.
     4151   END PROCEDURE.
     4152   PROCEDURE state-changed :
     4153     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE NO-UNDO.
     4154     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     4155   END PROCEDURE.
