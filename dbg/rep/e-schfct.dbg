     2096   .
     2097   define variable v-account as integer init 0 no-undo .
     2098   define variable v-account-lavel as character no-undo .
     2099   define variable v-button-stop as logical no-undo .
     2100   define variable v-kol-spice as integer no-undo .
     2101   define variable v-kol-spice2 as integer no-undo .
     2102   define variable v-kol-spice3 as integer no-undo .
     2103   DEFINE VARIABLE StopProcessing AS LOGICAL NO-UNDO.
     2104   DEFINE BUTTON StopBtn AUTO-END-KEY
     2105        LABEL "Стоп"
     2106        SIZE 10 BY 1.
     2107   DEFINE VARIABLE RecordsDone AS INTEGER FORMAT ">,>>>,>>>,>>9":U INITIAL 0
     2108        LABEL "Обработано записей"
     2109         VIEW-AS TEXT
     2110        SIZE 14 BY .67 NO-UNDO.
     2111   DEFINE VARIABLE RecordsString AS CHARACTER FORMAT "X(60)"
     2112         VIEW-AS TEXT
     2113        SIZE 53.25 BY .67
     2114        FGCOLOR 1  NO-UNDO.
     2115   DEFINE VARIABLE RecordsString2 AS CHARACTER FORMAT "X(60)"
     2116         VIEW-AS TEXT
     2117        SIZE 53.25 BY .67
     2118        FGCOLOR 1  NO-UNDO.
     2119   DEFINE VARIABLE RecordsString3 AS CHARACTER FORMAT "X(60)"
     2120         VIEW-AS TEXT
     2121        SIZE 53.25 BY .67
     2122        FGCOLOR 1  NO-UNDO.
     2123   DEFINE RECTANGLE RECT-1
     2124        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     2125        SIZE 55.13 BY 4.46.
     2126   DEFINE FRAME InfoFrame
     2127        StopBtn AT ROW 4.25 COL 21.75
     2128        RecordsString AT ROW 1.21 COL 2 NO-LABEL
     2129        RecordsString2 AT ROW 1.96 COL 2 NO-LABEL
     2130        RecordsString3 AT ROW 2.58 COL 2 NO-LABEL
     2131        RecordsDone AT ROW 3.42 COL 24.88 COLON-ALIGNED
     2132        RECT-1 AT ROW 1 COL 1
     2133       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     2134            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     2135            TITLE "Процесс"
     2136            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
     2137   define variable mFrameView      as logical   no-undo init yes.
     2138     define variable mFramHandle as handle no-undo.
     2139     mFramHandle = frame InfoFrame:handle.
     2140     if  log-manager:logfile-name ne ?
     2141     then DO:
     2142         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     2143         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     2144         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
     2145     end.
     2146     mFrameView = not session:batch-mode and mFramHandle:visible.
     2147     if mFrameView
     2148     then do:
     2149       ASSIGN
     2150          FRAME InfoFrame:HIDDEN                           = TRUE
     2151          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
     2152     end.
     2153   ON CHOOSE OF StopBtn IN FRAME InfoFrame
     2154   DO:
     2155     IF not StopProcessing THEN
     2156       Message "Вы действительно хотите прервать" SKIP
     2157               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
     2158                 UPDATE StopProcessing.
     2159     IF StopProcessing THEN do:
     2160        if mFrameView
     2161        then do:
     2162           HIDE FRAME InfoFrame.
     2163        end.
     2164     End.
     2165   END.
     2166   DEFINE VARIABLE parParentProc AS WIDGET-HANDLE NO-UNDO.
     2167   ASSIGN
     2168     parParentProc = my-handle
     2169   .
     2170   define temp-table temp-doc-list no-undo
     2171     field doc-code    as character
     2172     field supp-vat-pc as decimal
     2173     field supp-slt-pc as decimal
     2174     field fact-order  as decimal
     2175     field scf-code    as character
     2176     field scf-date    as date
