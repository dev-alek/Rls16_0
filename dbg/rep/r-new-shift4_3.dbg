      640   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      641   PROCEDURE create-treal-4.
      642   DEFINE INPUT PARAMETER pgds-code like ub.goods.gds-code no-undo.
      643   DEFINE INPUT PARAMETER pcpay-code like ub.cash-pay.cdpay-code no-undo.
      644   DEFINE INPUT PARAMETER pcurr-code like ub.cash-pay.curr-code no-undo.
      645   DEFINE INPUT PARAMETER pqnty1 as decimal no-undo.
      646   DEFINE INPUT PARAMETER pnetto as decimal no-undo.
      647   DEFINE INPUT PARAMETER pout-name as character no-undo.
      648   DEFINE INPUT PARAMETER pis-pay as logical no-undo.
      649   DEFINE INPUT PARAMETER pii as integer no-undo.
      650   _main:
      651   DO ON ERROR UNDO _main, return error:
      652       create treal-4.
      653       assign
      654       treal-4.gds-code = pgds-code
      655       treal-4.cpay-code = pcpay-code
      656       treal-4.curr-code = pcurr-code
      657       treal-4.qnty1  =  pqnty1
      658       treal-4.netto = pnetto
      659       treal-4.out-name = pout-name
      660       treal-4.is-pay = pis-pay
      661       treal-4.ii = pii
      662       no-error
      663       .
      664       if error-status:error then undo _main, return error.
      665   END.
      666   END PROCEDURE.
      667   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      668   PROCEDURE create-actreal-4.
      669   DEFINE INPUT PARAMETER pgds-code like ub.goods.gds-code no-undo.
      670   DEFINE INPUT PARAMETER pcpay-code like ub.cash-pay.cdpay-code no-undo.
      671   DEFINE INPUT PARAMETER pcurr-code like ub.cash-pay.curr-code no-undo.
      672   DEFINE INPUT PARAMETER pqnty1 as decimal no-undo.
      673   DEFINE INPUT PARAMETER pnetto as decimal no-undo.
      674   DEFINE INPUT PARAMETER pout-name as character no-undo.
      675   DEFINE INPUT PARAMETER pis-pay as logical no-undo.
      676   DEFINE INPUT PARAMETER pii as integer no-undo.
      677   _main:
      678   DO ON ERROR UNDO _main, return error:
      679       create actreal-4.
      680       assign
      681       actreal-4.gds-code = pgds-code
      682       actreal-4.cpay-code = pcpay-code
      683       actreal-4.curr-code = pcurr-code
      684       actreal-4.qnty1  =  pqnty1
      685       actreal-4.netto = pnetto
      686       actreal-4.out-name = pout-name
      687       actreal-4.is-pay = pis-pay
      688       actreal-4.ii = pii
      689       no-error
      690       .
      691       if error-status:error then undo _main, return error.
      692   END.
      693   END PROCEDURE.
      694   define NEW SHARED temp-table tmat-4 no-undo
      695     field netto-before as decimal   format "-999,999,999.99":U
      696     field netto-after  as decimal   format "-999,999,999.99":U
