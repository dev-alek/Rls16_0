      704   .
      705   define shared stream  PrnLibstream.
      706   define variable pol1 as character no-undo .
      707   define variable pol2 as integer   no-undo .
      708   define variable pol3 as decimal   no-undo .
      709   define variable pol4 as character no-undo .
      710   define variable pol5 as decimal   no-undo .
      711   define variable pol6 as decimal   no-undo .
      712   define variable pol7 as decimal   no-undo .
      713   define variable pol8 as decimal   no-undo .
      714   define variable pol9 as decimal   no-undo .
      715   define stream Out-Stream.
      716   define stream OutStr-html.
      717   define variable line                 as character no-undo .
      718   DEFINE VARIABLE areal-is-pay-qnty1   as decimal   no-undo.
      719   DEFINE VARIABLE areal-is-pay-netto   as decimal   no-undo.
      720   DEFINE VARIABLE areal-no-pay-qnty1   as decimal   no-undo.
      721   DEFINE VARIABLE areal-no-pay-netto   as decimal   no-undo.
      722   DEFINE VARIABLE areal-qnty1          as decimal   no-undo.
      723   DEFINE VARIABLE areal-netto          as decimal   no-undo.
      724   DEFINE VARIABLE v-total-is-pay-qnty1 as decimal   no-undo.
      725   DEFINE VARIABLE v-total-is-pay-netto as decimal   no-undo.
      726   DEFINE VARIABLE v-total-no-pay-qnty1 as decimal   no-undo.
      727   DEFINE VARIABLE v-total-no-pay-netto as decimal   no-undo.
      728   DEFINE VARIABLE v-total-qnty1        as decimal   no-undo.
      729   DEFINE VARIABLE v-total-netto        as decimal   no-undo.
      730   DEFINE VARIABLE a-qnty1              as decimal   no-undo.
      731   DEFINE VARIABLE a-netto              as decimal   no-undo.
      732   DEFINE VARIABLE loc-real-ii          as integer   no-undo.
      733   DEFINE VARIABLE curr-real-ii         as integer   no-undo.
      734   DEFINE VARIABLE jj                   as integer   no-undo.
      735   DEFINE VARIABLE loc-jj               as integer   no-undo.
      736   DEFINE VARIABLE main-line            as logical   no-undo.
      737   DEFINE VARIABLE mat-line             as logical   no-undo.
      738   DEFINE VARIABLE pay-line             as logical   no-undo.
      739   DEFINE VARIABLE a-line               as logical   no-undo.
      740   DEFINE VARIABLE max-line             as integer   no-undo.
      741   DEFINE VARIABLE max-real             as integer   no-undo.
      742   DEFINE VARIABLE rc                   as recid     no-undo.
      743   DEFINE VARIABLE acii                 as integer   no-undo .
      744     procedure on-same-page :
      745       define input parameter p-line-number as integer no-undo .
      746       if p-line-number > page-size( PrnLibstream )
      747       then do:
      748         return .
      749       end.
      750       if line-counter( PrnLibstream ) + p-line-number > page-size( PrnLibstream )
      751       then do:
      752         page stream PrnLibstream .
      753       end.
      754     end procedure.
      755   run rep/r-shft4r.p
      756       (input p-obj-type,
      757       input p-obj-code,
      758       input X-date-Start,
      759       input X-Shift-Start,
      760       input X-date-End,
      761       input X-Shift-End,
      762       input p-previous-shift-date
      763       ) no-error.
      764   output stream OutStr-html to value(v-report-name-html) append convert target 'UTF-8' .
      765   put stream OutStr-html unformatted
      766       substitute (
      767       '<tbody> <!-- Здесь начинается таблица отчета -->
      768                   <tr> <!-- Первые строки – шапка таблицы с тэгами tr -->
      769                   <th colspan="3" style="text-align: center;">Информация об услуге</th>
      770                   <th colspan="6" style="text-align: center;">Расшифровка реализации услуг</th>
      771               </tr>
      772               <tr>
      773                   <th style="text-align: center;">Наименование услуги</th>
      774                   <th style="text-align: center;">Код услуги</th>
      775                   <th style="text-align: center;">Цена рознич. на конец смены</th>
      776                   <th style="text-align: center;">Тип расхода (тип платежа)</th>
      777                   <th style="text-align: center;">Кол-во</th>
      778                   <th style="text-align: center;">Сумма</th>
      779                   <th style="text-align: center;">Сумма скидки</th>
      780                   <th style="text-align: center;">Сумма брутто</th>
      781                   <th style="text-align: center;">Кол-во покупок</th>
      782               </tr>
      783               <tr>
      784                   <th style="text-align: center;">4.1</th>
      785                   <th style="text-align: center;">4.2</th>
      786                   <th style="text-align: center;">4.3</th>
      787                   <th style="text-align: center;">4.4</th>
      788                   <th style="text-align: center;">4.5</th>
      789                   <th style="text-align: center;">4.6</th>
      790                   <th style="text-align: center;">4.7</th>
      791                   <th style="text-align: center;">4.8</th>
      792                   <th style="text-align: center;">4.9</th>
      793               </tr>
      794               '
      795       , chr(123), chr(125)
      796       ).
      797   for each actreal-4:
      798       delete actreal-4.
      799   end.
      800   FOR EACH t-4 use-index pi:
      801       assign
      802           areal-is-pay-qnty1 = 0
      803           areal-is-pay-netto = 0
      804           areal-no-pay-qnty1 = 0
      805           areal-no-pay-netto = 0
      806           areal-qnty1        = 0
      807           areal-netto        = 0
      808           loc-real-ii        = 1
      809           curr-real-ii       = 1
      810           .
      811       FIND LAST treal-4 No-LOCK WHERE
      812           treal-4.gds-code = t-4.gds-code AND
      813           treal-4.is-pay = yes use-index vi No-ERROR.
      814       if avail treal-4 then
      815           assign
      816               loc-real-ii  = treal-4.ii + 1
      817               curr-real-ii = treal-4.ii + 1
      818               .
      819       IF can-find(first treal-4 WHERE
      820           treal-4.gds-code = t-4.gds-code) then
      821       do:
      822           FOR EACh  treal-4 where
      823               treal-4.gds-code = t-4.gds-code use-index pi:
      824               if treal-4.discnt-type = -99 then do:
      825               assign
      826                   areal-qnty1 = areal-qnty1 + treal-4.qnty1
      827                   areal-netto = areal-netto + treal-4.netto
      828                   .
      829               if treal-4.is-pay then
      830                   assign
      831                       areal-is-pay-qnty1 = areal-is-pay-qnty1 + treal-4.qnty1
      832                       areal-is-pay-netto = areal-is-pay-netto + treal-4.netto
      833                       .
      834               else
      835                   assign
      836                       rc                 = recid(treal-4)
      837                       curr-real-ii       = (if curr-real-ii = loc-real-ii AND
      838                            (loc-real-ii > 1   OR
      839                             can-find(first treal-4 No-LOCK WHERE
      840                                            treal-4.gds-code = t-4.gds-code AND
      841                                            treal-4.is-pay = no AND
      842                                            recid(treal-4) <> rc)
      843                             )
      844                         then (curr-real-ii + 1)
      845                         else curr-real-ii
      846                        )
      847                       treal-4.ii         = curr-real-ii
      848                       curr-real-ii       = curr-real-ii + 1
      849                       areal-no-pay-qnty1 = areal-no-pay-qnty1 + treal-4.qnty1
      850                       areal-no-pay-netto = areal-no-pay-netto + treal-4.netto
      851                       .
      852               end.
      853           END.
      854           if curr-real-ii > 2 then
      855           do:
      856               run create-treal-4 (
      857                   INPUT t-4.gds-code,
      858                   INPUT 0,
      859                   INPUT 0,
      860                   INPUT areal-is-pay-qnty1,
      861                   INPUT areal-is-pay-netto,
      862                   INPUT "ИТОГО ОПЛАЧ.РАСХОД",
      863                   INPUT yes,
      864                   INPUT loc-real-ii) no-error.
      865               if loc-real-ii = curr-real-ii then
      866                   curr-real-ii = curr-real-ii + 1.
      867               run create-treal-4 (
      868                   INPUT t-4.gds-code,
      869                   INPUT 0,
      870                   INPUT 0,
      871                   INPUT areal-no-pay-qnty1,
      872                   INPUT areal-no-pay-netto,
      873                   INPUT "ИТОГО ПРОЧ.РАСХОДОВ",
      874                   INPUT no,
      875                   INPUT curr-real-ii) no-error.
      876               curr-real-ii = curr-real-ii + 1.
      877               run create-treal-4 (
      878                   INPUT t-4.gds-code,
      879                   INPUT 0,
      880                   INPUT 0,
      881                   INPUT areal-qnty1,
      882                   INPUT areal-netto,
      883                   INPUT "ВСЕГО  РАСХОД",
      884                   INPUT ?,
      885                   INPUT curr-real-ii) no-error.
      886           END.
      887       END.
      888       assign
      889           t-4.lines = MAX(curr-real-ii, 1)
      890           .
      891   END.
      892   FOR EACH t-4 No-LOCK,
      893       EACH treal-4 No-LOCK WHERE
      894       treal-4.gds-code = t-4.gds-code
      895       BREAK BY treal-4.gds-code
      896       BY treal-4.is-pay descending
      897       BY treal-4.ii:
      898       assign
      899           pol1      = ""
      900           pol2      = 0
      901           pol3      = 0
      902           pol4      = ""
      903           pol5      = 0
      904           pol6      = 0
      905           pol7      = 0
      906           pol8      = 0
      907           pol9      = 0
      908           main-line = no
      909           pay-line  = no
      910           .
      911       IF FIRST-OF(treal-4.gds-code) then
      912       do:
      913           assign
      914               pol1      = t-4.gds-name
      915               pol2      = t-4.main-code
      916               pol3      = t-4.last-price
      917               main-line = yes
      918               .
      919       END.
      920       assign
      921           pol4 = treal-4.out-name
      922           pol5 = treal-4.qnty1
      923           pol6 = treal-4.netto
      924           pol7 = treal-4.discount-sum
      925           pol8 = treal-4.brutto
      926           pol9 = treal-4.chk-qnty
      927           .
      928           if treal-4.discnt-type = -99 then do:
      929           assign
      930           a-netto   = a-netto + treal-4.netto
      931           a-qnty1   = a-qnty1 + treal-4.qnty1
      932           .
      933           end.
      934       if treal-4.cpay-code <> 0 and treal-4.discnt-type = -99 then
      935       dO:
      936           FIND FIRST actreal-4 WHERE
      937               actreal-4.gds-code = 0 AND
      938               actreal-4.cpay-code = treal-4.cpay-code AND
      939               actreal-4.curr-code = treal-4.curr-code AND
      940               actreal-4.is-pay = treal-4.is-pay  NO-ERROR.
      941           if not avail actreal-4 then
      942           do:
      943               acii = acii + 1.
      944               run create-actreal-4 (
      945                   INPUT 0,
      946                   INPUT treal-4.cpay-code,
      947                   INPUT treal-4.curr-code,
      948                   INPUT treal-4.qnty1,
      949                   INPUT treal-4.netto,
      950                   INPUT treal-4.out-name,
      951                   INPUT treal-4.is-pay,
      952                   INPUT acii) no-error.
      953           end.
      954           else
      955               assign
      956                   actreal-4.qnty1 = actreal-4.qnty1 + treal-4.qnty1
      957                   actreal-4.netto = actreal-4.netto + treal-4.netto
      958                   .
      959       end.
      960       if pol5 <> 0 then
      961       do:
      962           put stream OutStr-html unformatted
      963               substitute (
      964               '<tr>
      965                   <td text_wrap="true">&1</td>
      966                   <td style="text-align: right;">&2</td>
      967                   <td style="text-align: right;">&3</td>
      968                   <td text_wrap="true">&4</td>
      969                   <td style="text-align: right;">&5</td>
      970                   <td style="text-align: right;">&6</td>
      971                   <td style="text-align: right;">&7</td>
      972                   <td style="text-align: right;">&8</td>
      973                   <td style="text-align: right;">&9</td>
      974               </tr>    
      975                   '
      976               ,
      977               if main-line = no then "" else string(pol1),
      978               if main-line = no then "" else string(pol2),
      979               if main-line = no then "" else string(pol3,"->>>>>>>>>>>9.99"),
      980               pol4,
      981               string(pol5,"->>>>>>>>>>>9"),
      982               string(pol6,"->>>>>>>>>>>9.99"),
      983               if pol7 = 0 then "" else string(pol7,"->>>>>>>>>>>9.99"),
      984               if pol8 = 0 then "" else string(pol8,"->>>>>>>>>>>9.99"),
      985               if pol9 = 0 then "" else string(pol9,"->>>>>>>>>>>9.99")
      986               ).
      987       end.
      988       IF LAST(treal-4.gds-code) then
      989       do:
      990           assign
      991               pol1 = "ВСЕГО РЕАЛИЗОВАНО УСЛУГ  :"
      992               pol5 = a-qnty1
      993               pol6 = a-netto
      994               .
      995           put stream OutStr-html unformatted
      996               substitute (
      997               '<tr>
      998                   <th text_wrap="true" style="text-align: left">&1</th>
      999                   <th></th>
     1000                   <th></th>
     1001                   <th></th>
     1002                   <th style="text-align: right;">&2</th>
     1003                   <th style="text-align: right;">&3</th>
     1004                   <th style="text-align: right;"></th>
     1005                   <th style="text-align: right;"></th>
     1006                   <th style="text-align: right;"></th>
     1007               </tr>    
     1008                   '
     1009               ,
     1010               pol1,
     1011               string(pol5,"->>>>>>>>>>>9"),
     1012               string(pol6,"->>>>>>>>>>>9.99")
     1013               ).
     1014           if can-find(first actreal-4) then
     1015           do:
     1016               pol4 = "     в том числе:".
     1017               put stream OutStr-html unformatted
     1018                   substitute (
     1019                   '<tr>
     1020                   <td></td>
     1021                   <td></td>
     1022                   <td></td>
     1023                   <td text_wrap="true" style="text-align: left;">&1</td>
     1024                   <td></td>
     1025                   <td></td>
     1026                   <td></td>
     1027                   <td></td>
     1028                   <td></td>
     1029               </tr>    
     1030                   '
     1031                   ,
     1032                   pol4
     1033                   ).
     1034               assign
     1035                   areal-is-pay-qnty1 = 0
     1036                   areal-is-pay-netto = 0
     1037                   areal-no-pay-qnty1 = 0
     1038                   areal-no-pay-netto = 0
     1039                   .
     1040   RELEASE actreal-4 no-error.
     1041               FOR EACH actreal-4 No-LOCK
     1042                   BREAK
     1043                   BY actreal-4.gds-code
     1044                   By actreal-4.is-pay descending
     1045                   BY actreal-4.cpay-code descending
     1046                   BY actreal-4.curr-code:
     1047                   if actreal-4.is-pay = yes then
     1048                       assign
     1049                           areal-is-pay-qnty1 = areal-is-pay-qnty1 + actreal-4.qnty1
     1050                           areal-is-pay-netto = areal-is-pay-netto + actreal-4.netto
     1051                           .
     1052                   else
     1053                       assign
     1054                           areal-no-pay-qnty1 = areal-no-pay-qnty1 + actreal-4.qnty1
     1055                           areal-no-pay-netto = areal-no-pay-netto + actreal-4.netto
     1056                           .
     1057                   assign
     1058                       pol4 = actreal-4.out-name
     1059                       pol5 = actreal-4.qnty1
     1060                       pol6 = actreal-4.netto
     1061                       pol7 = actreal-4.discount-sum
     1062                       pol8 = actreal-4.brutto
     1063                       pol9 = actreal-4.chk-qnty
     1064                       .
     1065                   put stream OutStr-html unformatted
     1066                       substitute (
     1067                       '<tr>
     1068                   <td></td>
     1069                   <td></td>
     1070                   <td></td>
     1071                   <td>&1</td>
     1072                   <td style="text-align: right;">&2</td>
     1073                   <td style="text-align: right;">&3</td>
     1074                   <td style="text-align: right;"></td>
     1075                   <td style="text-align: right;"></td>
     1076                   <td style="text-align: right;"></td>
     1077               </tr>    
     1078                   '
     1079                       ,
     1080                       pol4,
     1081                       string(pol5,"->>>>>>>>>>>9"),
     1082                       string(pol6,"->>>>>>>>>>>9.99"),
     1083                       if pol7 = 0 then "" else string(pol7,"->>>>>>>>>>>9.99"),
     1084                       if pol8 = 0 then "" else string(pol8,"->>>>>>>>>>>9.99"),
     1085                       if pol9 = 0 then "" else string(pol9,"->>>>>>>>>>>9.99")
     1086                       ).
     1087                   if last-of(actreal-4.is-pay)  then
     1088                   do:
     1089                       if actreal-4.is-pay = yes then
     1090                           assign
     1091                               pol4 = "ИТОГО ОПЛАЧ.РАСХОД"
     1092                               pol5 = areal-is-pay-qnty1
     1093                               pol6 = areal-is-pay-netto
     1094                               .
     1095                       else
     1096                           assign
     1097                               pol4 = "ИТОГО ПРОЧ.РАСХОД"
     1098                               pol5 = areal-no-pay-qnty1
     1099                               pol6 = areal-no-pay-netto
     1100                               .
     1101                       put stream OutStr-html unformatted
     1102                           substitute (
     1103                           '<tr>
     1104                   <td></td>
     1105                   <td></td>
     1106                   <td></td>
     1107                   <td text_wrap="true">&1</td>
     1108                   <td style="text-align: right;">&2</td>
     1109                   <td style="text-align: right;">&3</td>
     1110                   <td style="text-align: right;"></td>
     1111                   <td style="text-align: right;"></td>
     1112                   <td style="text-align: right;"></td>
     1113               </tr>    
     1114                   '
     1115                           ,
     1116                           pol4,
     1117                           string(pol5,"->>>>>>>>>>>9"),
     1118                           string(pol6,"->>>>>>>>>>>9.99")
     1119                           ).
     1120                   end.
     1121               END.
     1122           end.
     1123       end.
     1124   END.
     1125   output stream OutStr-html close.
     1126   output stream OutStr-html to value(v-report-name-html) append convert target 'UTF-8' .
     1127   put stream OutStr-html unformatted
     1128       substitute (
     1129       '
     1130           </tbody>
     1131           '
     1132       , chr(123), chr(125)
     1133       ).
     1134   output stream OutStr-html close.
