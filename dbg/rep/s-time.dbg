        1   CREATE WIDGET-POOL.
        2   define variable vss-revision    as character no-undo init "$Revision$":u .
        3   define variable vss-author      as character no-undo init "$Author$":u .
        4   define variable vss-date        as character no-undo init "$Date$":u .
        5   define variable vss-workfile    as character no-undo init "$Workfile$":u .
        6   define variable vss-archive     as character no-undo init "$Archive$":u .
        7   define variable vss-description as character no-undo init "Отчет о выручке" .
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   procedure proc-alt-shift-f2:
       63     if not ibs.th.gbl.gbl-var:rcode
       64   then
       65     run gbl\inidebug.p .
       66   end.
       67   procedure proc-alt-shift-f3:
       68     run gbl/prvssinf.p
       69       ( input this-procedure
       70       ) .
       71   end.
       72   define variable v-inform-launched as logical no-undo initial false .
       73   procedure proc-alt-shift-f4:
       74     define variable v-action as character no-undo .
       75     if v-inform-launched = false then do:
       76       assign
       77         v-inform-launched = true
       78       .
       79       run gbl/d-inform.w
       80         (  input self
       81         ,  input this-procedure
       82         , output v-action
       83         ) no-error .
       84       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       85       assign
       86         v-inform-launched = false
       87       .
       88     end.
       89   end.
       90   procedure proc-alt-f1:
       91     run gbl/corrhelp.p
       92       (input this-procedure
       93       ) .
       94   end .
       95   on alt-shift-f2 anywhere do:
       96     run proc-alt-shift-f2.
       97   end.
       98   on alt-shift-f3 anywhere do:
       99     run proc-alt-shift-f3 in this-procedure .
      100   end.
      101   on alt-shift-f4 anywhere do:
      102     run proc-alt-shift-f4 in this-procedure.
      103   end.
      104   on alt-f1 anywhere do:
      105     run proc-alt-f1 in this-procedure .
      106   end.
      107   DEFINE SHARED TEMP-TABLE times NO-UNDO
      108       FIELD time1 as integer
      109       FIELD time2 as integer
      110       FIELD times as char
      111       INDEX pi IS PRIMARY UNIQUE time1 time2
      112       INDEX ps times.
      113   RUN set-attribute-list (
      114       'Keys-Accepted = "",
      115        Keys-Supplied = ""':U).
      116   DEFINE BUTTON B-add
      117        LABEL "&Добавить"
      118        SIZE 10 BY 1.
      119   DEFINE BUTTON B-del
      120        LABEL "&Удалить"
      121        SIZE 10 BY 1.
      122   DEFINE VARIABLE F-hour1 AS INTEGER FORMAT "99":U INITIAL 0
      123        VIEW-AS FILL-IN
      124        SIZE 3.25 BY 1 NO-UNDO.
      125   DEFINE VARIABLE F-hour2 AS INTEGER FORMAT "99":U INITIAL 0
      126        VIEW-AS FILL-IN
      127        SIZE 3.25 BY 1 NO-UNDO.
      128   DEFINE VARIABLE F-min1 AS INTEGER FORMAT "99":U INITIAL 0
      129        VIEW-AS FILL-IN
      130        SIZE 3.25 BY 1 NO-UNDO.
      131   DEFINE VARIABLE F-min2 AS INTEGER FORMAT "99":U INITIAL 0
      132        VIEW-AS FILL-IN
      133        SIZE 3.25 BY 1 NO-UNDO.
      134   DEFINE RECTANGLE RECT-1
      135        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      136        SIZE 23.25 BY 12.54.
      137   DEFINE VARIABLE SEL-time AS CHARACTER
      138        VIEW-AS SELECTION-LIST SINGLE SORT SCROLLBAR-VERTICAL
      139        SIZE 17.88 BY 6.67 NO-UNDO.
      140   DEFINE FRAME F-mMain
      141        F-hour1 AT ROW 3.13 COL 3.13 NO-LABEL
      142        F-min1 AT ROW 3.13 COL 7.88 NO-LABEL
      143        F-hour2 AT ROW 3.13 COL 15.13 NO-LABEL
      144        F-min2 AT ROW 3.13 COL 19.88 NO-LABEL
      145        B-add AT ROW 4.29 COL 8.25
      146        SEL-time AT ROW 5.46 COL 4.75 NO-LABEL
      147        B-del AT ROW 12.38 COL 7.63
      148        ":" VIEW-AS TEXT
      149             SIZE 1.5 BY 1 AT ROW 3.13 COL 18.38
      150             BGCOLOR 15
      151        ":" VIEW-AS TEXT
      152             SIZE 1.5 BY 1 AT ROW 3.13 COL 6.38
      153             BGCOLOR 15
      154        "временных интервалов" VIEW-AS TEXT
      155             SIZE 20.75 BY .71 AT ROW 2.17 COL 3.63
      156             FGCOLOR 4
      157        "Выбор" VIEW-AS TEXT
      158             SIZE 6.13 BY .71 AT ROW 1.38 COL 8.88
      159             FGCOLOR 4
      160        RECT-1 AT ROW 1.17 COL 1.88
      161       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
      162            SIDE-LABELS NO-UNDERLINE THREE-D
      163            AT COL 1 ROW 1 SCROLLABLE .
      164   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
      165   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
      166   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
      167   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
      168   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
      169   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
      170   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
      171   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
      172         adm-object-hdl = FRAME F-mMain:HANDLE.
      173   RUN ensure-broker.
      174   THIS-PROCEDURE:ADM-DATA =
      175        'ADM1.1~`':U +
      176        'SmartObject~`':U +
      177        '~`':U +
      178        'NO ~`':U +
      179        '~`':U +
      180        '~`':U +
      181        '~`':U +
      182        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
      183           + "~`":U +
      184        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add~`':U +
      185        'Record-Source,Record-Target,TableIO-Target~`':U +
      186        '~`':U +
      187        '~`~`~`~`~`~`~`~`~`~`~`':U +
      188        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
      189            THEN "^^":U
      190        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
      191             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
      192   PROCEDURE adm-apply-entry :
      193     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      194   END PROCEDURE.
      195   PROCEDURE adm-destroy :
      196    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      197   END PROCEDURE.
      198   PROCEDURE adm-disable :
      199       DISABLE RECT-1 F-hour1 F-min1 F-hour2 F-min2 B-add SEL-time B-del WITH FRAME F-mMain.
      200       RUN dispatch ('disable-fields':U).
      201       RUN set-attribute-list ('ENABLED=no':U).
      202       RETURN.
      203   END PROCEDURE.
      204   PROCEDURE adm-edit-attribute-list :
      205         RUN adm/support/viewerd.w (INPUT THIS-PROCEDURE).
      206         RETURN.
      207   END PROCEDURE.
      208   PROCEDURE adm-enable :
      209       ENABLE UNLESS-HIDDEN RECT-1 F-hour1 F-min1 F-hour2 F-min2 B-add SEL-time B-del WITH FRAME F-mMain.
      210       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
      211       RUN set-attribute-list ('ENABLED=yes':U).
      212       RETURN.
      213   END PROCEDURE.
      214   PROCEDURE adm-exit :
      215        RUN notify ('exit':U).
      216     RETURN.
      217   END PROCEDURE.
      218   PROCEDURE adm-hide :
      219     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      220   END PROCEDURE.
      221   PROCEDURE adm-initialize :
      222     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      223   END PROCEDURE.
      224   PROCEDURE adm-show-errors :
      225       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
      226       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
      227           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
      228       END.
      229       RETURN.
      230   END PROCEDURE.
      231   PROCEDURE adm-UIB-mode :
      232     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      233   END PROCEDURE.
      234   PROCEDURE adm-view :
      235     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      236   END PROCEDURE.
      237   PROCEDURE dispatch :
      238       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
      239       RUN broker-dispatch IN adm-broker-hdl
      240           (THIS-PROCEDURE, p-method-name) NO-ERROR.
      241       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
      242   END PROCEDURE.
      243   PROCEDURE ensure-broker :
      244   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
      245   IF RETURN-VALUE NE "ADM-Broker":U THEN
      246   DO:
      247       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
      248       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
      249   END.
      250   END PROCEDURE.
      251   PROCEDURE get-attribute :
      252     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
      253     RUN broker-get-attribute IN adm-broker-hdl
      254         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
      255     RETURN RETURN-VALUE.
      256   END PROCEDURE.
      257   PROCEDURE get-attribute-list :
      258     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
      259     RUN broker-get-attribute-list IN adm-broker-hdl
      260         (INPUT THIS-PROCEDURE,
      261          INPUT ?,
      262          OUTPUT p-attr-list) NO-ERROR.
      263     RETURN.
      264   END PROCEDURE.
      265   PROCEDURE new-state :
      266     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
      267     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
      268     RETURN.
      269   END PROCEDURE.
      270   PROCEDURE notify :
      271     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
      272     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
      273     IF RETURN-VALUE = "ADM-ERROR":U THEN
      274         RETURN "ADM-ERROR":U.
      275     RETURN.
      276   END PROCEDURE.
      277   PROCEDURE set-attribute-list :
      278     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
      279     RUN ensure-broker.
      280     RUN broker-set-attribute-list IN adm-broker-hdl
      281         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
      282     RETURN.
      283   END PROCEDURE.
      284   PROCEDURE set-position :
      285       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
      286       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
      287       IF VALID-HANDLE(adm-object-hdl) THEN
      288       DO:
      289         ASSIGN adm-object-hdl:ROW    =   p-row
      290                adm-object-hdl:COLUMN =   p-col.
      291       END.
      292       RETURN.
      293   END PROCEDURE.
      294   PROCEDURE adm-display-fields :
      295       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
      296       RETURN.
      297   END PROCEDURE.
      298   PROCEDURE adm-open-query :
      299     RETURN.
      300   END PROCEDURE.
      301   PROCEDURE adm-row-changed :
      302         IF VALID-HANDLE(adm-object-hdl) THEN
      303           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
      304         RUN notify ('row-available':U).
      305         RETURN.
      306   END PROCEDURE.
      307   PROCEDURE reposition-query :
      308       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
      309       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
      310       RETURN.
      311   END PROCEDURE.
      312     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
      313     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
      314     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
      315     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
      316     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
      317     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
      318     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
      319     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
      320     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
      321     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
      322     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
      323     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
      324     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
      325     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
      326     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
      327     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
      328     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
      329     IF "":U = "":U THEN
      330       RUN modify-list-attribute IN adm-broker-hdl
      331         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
      332     RUN use-create-on-add(?).
      333   PROCEDURE adm-add-record :
      334       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
      335          "must have at least one Enabled Table to perform Add.":U
      336          VIEW-AS ALERT-BOX ERROR.
      337       RETURN.
      338   END PROCEDURE.
      339   PROCEDURE adm-assign-record :
      340    MESSAGE
      341          "Object ":U THIS-PROCEDURE:FILE-NAME
      342            "must have at least one Enabled Table to perform Assign.":U
      343              VIEW-AS ALERT-BOX ERROR.
      344      RETURN.
      345     END PROCEDURE.
      346   PROCEDURE adm-assign-statement :
      347     RETURN.
      348   END PROCEDURE.
      349   PROCEDURE adm-cancel-record :
      350      RETURN.
      351     END PROCEDURE.
      352   PROCEDURE adm-copy-record :
      353       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
      354        "must have at least one Enabled Table to perform Copy.":U
      355          VIEW-AS ALERT-BOX ERROR.
      356       RETURN.
      357   END PROCEDURE.
      358   PROCEDURE adm-create-record :
      359      RETURN.
      360   END PROCEDURE.
      361   PROCEDURE adm-current-changed :
      362     RETURN.
      363   END PROCEDURE.
      364   PROCEDURE adm-delete-record :
      365    MESSAGE
      366          "Object ":U THIS-PROCEDURE:FILE-NAME
      367            "must have at least one Enabled Table to perform Delete.":U
      368              VIEW-AS ALERT-BOX ERROR.
      369       RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
      370       RETURN.
      371   END PROCEDURE.
      372   PROCEDURE adm-disable-fields :
      373         RUN notify ('disable-fields, GROUP-ASSIGN-TARGET':U).
      374       RETURN.
      375   END PROCEDURE.
      376   PROCEDURE adm-enable-fields :
      377       RETURN.
      378   END PROCEDURE.
      379   PROCEDURE adm-end-update :
      380     RETURN.
      381   END PROCEDURE.
      382   PROCEDURE adm-reset-record :
      383       RETURN.
      384   END PROCEDURE.
      385   PROCEDURE adm-update-record :
      386       MESSAGE
      387         "Object ":U THIS-PROCEDURE:FILE-NAME
      388           "must have at least one Enabled Table to perform Update.":U
      389             VIEW-AS ALERT-BOX ERROR.
      390      RETURN.
      391   END PROCEDURE.
      392   PROCEDURE check-modified :
      393   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
      394   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
      395   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
      396   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
      397     IF check-state = "check":U THEN
      398     DO:
      399       RUN get-link-handle IN adm-broker-hdl
      400         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
      401            OUTPUT group-target-list).
      402       IF group-target-list NE "":U THEN
      403       DO i = 1 TO NUM-ENTRIES(group-target-list):
      404         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
      405         RUN check-modified IN curr-widget ('group-check':U).
      406         IF RETURN-VALUE NE "":U THEN
      407         DO:
      408           RUN check-modified-message(RETURN-VALUE).
      409           RETURN "":U.
      410         END.
      411       END.
      412     END.
      413     RETURN "":U.
      414   END PROCEDURE.
      415   PROCEDURE check-modified-message :
      416     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
      417        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
      418           'CONTAINER-SOURCE':U, 'HIDDEN':U).
      419        IF RETURN-VALUE = "YES":U THEN
      420           RUN notify ('view,CONTAINER-SOURCE':U).
      421        MESSAGE IF p-changed-table NE ? THEN
      422           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
      423           ELSE "Current values have been changed."
      424           SKIP "  Do you wish to save those changes?"
      425           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
      426        IF ANS THEN
      427        DO:
      428           IF group-assign-target THEN
      429             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
      430           ELSE RUN dispatch('update-record':U).
      431           IF RETURN-VALUE = "ADM-ERROR":U THEN
      432           DO:
      433               MESSAGE "Changes to the previous record were not saved."
      434                 VIEW-AS ALERT-BOX ERROR.
      435               IF group-assign-target THEN
      436                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
      437               ELSE RUN dispatch ('cancel-record':U).
      438           END.
      439        END.
      440        ELSE DO:
      441          IF group-assign-target THEN
      442             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
      443          ELSE RUN dispatch('cancel-record':U).
      444        END.
      445        RETURN.
      446   END PROCEDURE.
      447   PROCEDURE get-rowid :
      448       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
      449       ASSIGN
      450       p-table   =   adm-first-table.
      451       RETURN.
      452   END PROCEDURE.
      453   PROCEDURE init-group-assign :
      454       RUN request-attribute IN adm-broker-hdl
      455         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
      456       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
      457         group-assign-target = yes.
      458       ELSE group-assign-target = no.
      459       RETURN.
      460   END PROCEDURE.
      461   PROCEDURE set-editors :
      462       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
      463       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
      464       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
      465       ASSIGN curr-widget = FRAME F-mMain:CURRENT-ITERATION.
      466       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
      467       DO WHILE VALID-HANDLE (curr-widget):
      468           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
      469              curr-widget:HIDDEN = no THEN DO:
      470             CASE p-field-setting:
      471               WHEN "INITIALIZE":U THEN
      472               DO:
      473                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
      474                     read-only-list +
      475                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
      476                        STRING(curr-widget).
      477               END.
      478               WHEN "DISABLE":U OR
      479               WHEN "ENABLE":U THEN
      480               DO:
      481                   curr-widget:SENSITIVE = yes.
      482                   RUN get-attribute ('Read-Only-Editors':U).
      483                   IF RETURN-VALUE = ? OR
      484                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
      485                       curr-widget:READ-ONLY =
      486                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
      487               END.
      488               WHEN "CLEAR":U THEN
      489                   curr-widget:SCREEN-VALUE = "":U.
      490             END CASE.
      491           END.
      492           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
      493       END.
      494       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
      495         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
      496           + '"':U).
      497       RETURN.
      498   END PROCEDURE.
      499   PROCEDURE use-check-modified-all :
      500    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
      501     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
      502     RETURN.
      503   END PROCEDURE.
      504   PROCEDURE use-create-on-add :
      505   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
      506      RETURN.
      507   END PROCEDURE.
      508   PROCEDURE use-initial-lock :
      509     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
      510     ASSIGN adm-initial-lock = p-attr-value.
      511     RETURN.
      512   END PROCEDURE.
      513     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
      514   ASSIGN
      515          FRAME F-mMain:SCROLLABLE       = FALSE
      516          FRAME F-mMain:HIDDEN           = TRUE.
      517   ON CHOOSE OF B-add IN FRAME F-mMain
      518   DO:
      519     define variable for-times as char.
      520     assign
      521     F-hour1
      522     F-hour2
      523     F-min1
      524     F-min2
      525     .
      526     IF (F-hour1 * 3600 + F-min1 * 60) > (F-hour2 * 3600 + F-min2 * 60) then do:
      527       BELL.
      528       RETURN NO-APPLY.
      529     END.
      530     if can-find(first TIMES no-lock where
      531                       TIMES.TIME1 <= (F-hour1 * 3600 + F-min1 * 60) and
      532                       not
      533                       TIMES.TIME2 < (F-hour1 * 3600 + F-min1 * 60))
      534       or
      535        can-find(first TIMES no-lock where
      536                       TIMES.TIME1 >= (F-hour1 * 3600 + F-min1 * 60) and
      537                       TIMES.TIME1 <= (F-hour2 * 3600 + F-min2 * 60 + 59))
      538       OR
      539        can-find(first TIMES no-lock where
      540                       TIMES.TIME1 >= (F-hour1 * 3600 + F-min1 * 60) and
      541                       TIMES.TIME1 <= (F-hour2 * 3600 + F-min2 * 60 + 59))
      542                       THeN DO:
      543           MESSAGE "Нельзя вводить перекрывающиеся периоды времени"
      544           view-as alert-box ERROR.
      545           RETURN NO-APPLY.
      546     end.
      547     assign
      548     for-times = string(f-hour1, "99") + ":" + string(f-min1, "99") + " - " +
      549                 string(f-hour2, "99") + ":" + string(f-min2, "99")
      550                 .
      551     find first times where times.times = for-times no-lock no-error.
      552     if available times then do:
      553       bell.
      554       message "Этот период уже выбран" .
      555       apply "entry" to F-hour1.
      556       return.
      557     end.
      558     create times.
      559     assign
      560     times.time1 = F-hour1 * 3600 + F-min1 * 60
      561     times.time2 = F-hour2 * 3600 + F-min2 * 60 + 59
      562     times.times = for-times
      563     .
      564     SEL-time:ADD-LAST(for-times).
      565   END.
      566   ON CHOOSE OF B-del IN FRAME F-mMain
      567   DO:
      568     define variable for-TIMES as character.
      569     APPLY "ENTRY" to sel-TIME.
      570     assign sel-TIME.
      571     for-TIMES = Sel-TIME.
      572     SEL-TIME:DELETE(for-TIMES).
      573     FIND FIRST TIMES where TIMES = FOR-TIMES NO-ERROR.
      574     IF AVAILABLE TIMES then delete TIMES.
      575     APPLY "ENTRY" to sel-TIME.
      576     APPLY "CURSOR-UP" to sel-TIME.
      577   END.
      578   ON LEAVE OF F-hour1 IN FRAME F-mMain
      579   DO:
      580     IF INTEGER(F-HOUR1:screen-value) > 23 then DO:
      581       BELL.
      582       RETURN NO-APPLY.
      583     END.
      584   END.
      585   ON LEAVE OF F-hour2 IN FRAME F-mMain
      586   DO:
      587     IF INTEGER(F-HOUR2:screen-value) > 23 then DO:
      588       BELL.
      589       RETURN NO-APPLY.
      590     END.
      591   END.
      592   ON LEAVE OF F-min1 IN FRAME F-mMain
      593   DO:
      594     IF INTEGER(F-MIN1:screen-value) > 59 then DO:
      595       BELL.
      596       RETURN NO-APPLY.
      597     END.
      598   END.
      599   ON LEAVE OF F-min2 IN FRAME F-mMain
      600   DO:
      601     IF INTEGER(F-MIN2:screen-value) > 59 then DO:
      602       BELL.
      603       RETURN NO-APPLY.
      604     END.
      605   END.
      606   if not this-procedure :persistent
      607   then do:
      608     message
      609       vss-workfile vss-revision vss-description skip
      610       "Ошибка при запуске процедуры" skip
      611       "Данную процедуру следует запускать только с параметром persistent" skip
      612       view-as alert-box error .
      613     undo, return error .
      614   end.
      615   PROCEDURE adm-row-available :
      616     DEFINE VARIABLE tbl-list           AS CHARACTER INIT "":U NO-UNDO.
      617     DEFINE VARIABLE rowid-list         AS CHARACTER NO-UNDO.
      618     DEFINE VARIABLE row-avail-cntr     AS INTEGER INIT 0 NO-UNDO.
      619     DEFINE VARIABLE row-avail-rowid    AS ROWID NO-UNDO.
      620     DEFINE VARIABLE row-avail-enabled  AS LOGICAL NO-UNDO.
      621     DEFINE VARIABLE link-handle        AS CHARACTER NO-UNDO.
      622     DEFINE VARIABLE record-source-hdl  AS HANDLE NO-UNDO.
      623     DEFINE VARIABLE different-row      AS LOGICAL NO-UNDO INIT no.
      624     DEFINE VARIABLE key-name           AS CHARACTER INIT ? NO-UNDO.
      625     DEFINE VARIABLE key-value          AS CHARACTER INIT ? NO-UNDO.
      626     RUN check-modified IN THIS-PROCEDURE ('check':U) NO-ERROR.
      627     IF adm-updating-record THEN RETURN.
      628     RUN get-attribute ('FIELDS-ENABLED':U).
      629     row-avail-enabled = IF RETURN-VALUE = "YES":U THEN yes ELSE no.
      630     RUN get-link-handle IN adm-broker-hdl (THIS-PROCEDURE, 'RECORD-SOURCE':U,
      631         OUTPUT link-handle) NO-ERROR.
      632     IF link-handle = "":U THEN
      633         RETURN.
      634     ASSIGN record-source-hdl = WIDGET-HANDLE(ENTRY(1,link-handle)).
      635     IF NUM-ENTRIES(link-handle) > 1 THEN
      636         MESSAGE "row-available in ":U THIS-PROCEDURE:FILE-NAME
      637             "encountered more than one RECORD-SOURCE.":U SKIP
      638             "The first - ":U record-source-hdl:file-name " - will be used.":U
      639                VIEW-AS ALERT-BOX ERROR.
      640     RUN get-attribute ('Key-Name':U).
      641     key-name = RETURN-VALUE.
      642     IF key-name = "":U THEN key-name = ?.
      643     IF key-name NE ? THEN DO:
      644       RUN send-key IN record-source-hdl (INPUT key-name, OUTPUT key-value)
      645         NO-ERROR.
      646       IF key-value NE ? THEN
      647         RUN set-attribute-list (SUBSTITUTE ('Key-Value="&1"':U, key-value)).
      648     END.
      649   IF VALID-HANDLE (adm-object-hdl) THEN
      650       RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
      651   RUN notify IN THIS-PROCEDURE ('row-available':U).
      652   END PROCEDURE.
      653   PROCEDURE disable_UI :
      654     HIDE FRAME F-mMain.
      655     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
      656   END PROCEDURE.
      657   PROCEDURE local-initialize :
      658     RUN dispatch IN THIS-PROCEDURE ( INPUT 'initialize':U ) .
      659     display
      660     0 @ f-hour1
      661     23 @ f-hour2
      662     0 @ f-MIN1
      663     59 @ f-MIN2
      664     with frame F-mMain
      665     .
      666   END PROCEDURE.
      667   PROCEDURE send-records :
      668   END PROCEDURE.
      669   PROCEDURE state-changed :
      670     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE    NO-UNDO.
      671     DEFINE INPUT PARAMETER p-state      AS CHARACTER NO-UNDO.
      672     CASE p-state:
      673       WHEN 'update-begin':U THEN DO:
      674           RUN dispatch('enable-fields':U).
      675           IF RETURN-VALUE = "ADM-ERROR":U THEN
      676           DO:
      677             RUN new-state('update-failed,TABLEIO-SOURCE':U).
      678             RUN new-state('update-complete':U).
      679           END.
      680           ELSE RUN new-state ('update':U).
      681       END.
      682       WHEN 'update-complete':U THEN DO:
      683           RUN new-state ('update-complete':U).
      684       END.
      685     END CASE.
      686   END PROCEDURE.
