     1593       end.
     1594     end.
     1595   end procedure.
     1596   procedure prn-lib-open-stream :
     1597     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1598     define input parameter p-page-size    as integer no-undo .
     1599     define input parameter p-is-stream    as logical no-undo .
     1600     define input parameter p-append       as logical no-undo .
     1601     define variable v-report-name as character no-undo .
     1602     do
     1603       on error undo, return error
     1604       :
     1605       run prn-lib-get-report-name  in this-procedure (
     1606         input parParentProc
     1607         ,output v-report-name
     1608         ).
     1609       if p-is-stream then
     1610       do:
     1611         if p-append then
     1612         do:
     1613           output stream PrnLibStream to value( v-report-name )
     1614             page-size value(p-page-size) append .
     1615         end.
     1616         if not p-append then
     1617         do:
     1618           output stream PrnLibStream to value( v-report-name )
     1619             page-size value(p-page-size) .
     1620         end.
     1621       end.
     1622       if not p-is-stream then
     1623       do:
     1624         if p-append then
     1625         do:
     1626           output to value( v-report-name )
     1627             page-size value(p-page-size) append .
     1628         end.
     1629         if not p-append then
     1630         do:
     1631           output to value( v-report-name )
     1632             page-size value(p-page-size) .
     1633         end.
     1634       end.
     1635     end.
     1636   end procedure.
     1637   procedure prn-lib-open-exp :
     1638     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1639     define input parameter p-is-stream    as logical no-undo .
     1640     define input parameter p-is-append    as logical no-undo .
     1641     define output parameter p-ReportFileName as char init "report" no-undo.
     1642     define output parameter p-process as logical no-undo .
     1643     define variable glog as logical no-undo .
     1644     do
     1645       on error undo, return error
     1646       :
     1647       SYSTEM-DIALOG GET-FILE p-ReportFileName
     1648         TITLE      "Укажите путь"
     1649         FILTERS "Текстовый файл (*.txt)"   "*.txt"
     1650         ASK-OVERWRITE
     1651         CREATE-TEST-FILE
     1652         SAVE-AS
     1653         USE-FILENAME
     1654         DEFAULT-EXTENSION "txt"
     1655         UPDATE glog
     1656         .
     1657       if not glog then  return.
     1658       p-ReportFileName = trim( string( p-ReportFileName ) ) .
     1659       if p-is-stream then
     1660       do:
     1661         if p-is-append then
     1662         do:
     1663           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1664         end.
     1665         else
     1666         do:
     1667           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1668         end.
     1669       end.
     1670       else
     1671       do:
     1672         if p-is-append then
     1673         do:
     1674           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1675         end.
     1676         else
     1677         do:
     1678           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1679         end.
     1680       end.
     1681       p-process = yes.
     1682     end.
     1683   end procedure.
     1684   procedure prn-lib-get-report-name :
     1685     define input parameter parParentProc  as widget-handle no-undo.
     1686     define output parameter p-report-name as character no-undo .
     1687     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
     1688   end procedure.
     1689   procedure prn-lib-reportviewer-report-name :
     1690     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1691     define input parameter p-report-name-html as character no-undo .
     1692     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
