     1016   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1017   procedure cur-time :
     1018      define output parameter p-today as date      no-undo .
     1019      define output parameter p-time  as integer   no-undo .
     1020     do
     1021     on error undo, return error
     1022     :
     1023       define variable v-date1 as date      no-undo .
     1024       define variable v-date2 as date      no-undo .
     1025       define variable v-time  as integer   no-undo .
     1026       assign
     1027         v-date1 = today
     1028         v-time  = time
     1029         v-date2 = today
     1030       .
     1031       if v-date1 <> v-date2
     1032       then do:
     1033         assign
     1034           v-date1 = today
     1035           v-time  = v-time
     1036         .
     1037       end.
     1038       assign
     1039         p-today = v-date1
     1040         p-time  = v-time
     1041       .
     1042     end.
     1043   end.
     1044   function cur-time-date returns character
     1045   :
     1046     return string(today, '99/99/9999':U) .
     1047   end.
     1048   function cur-time-mjd returns decimal
     1049   :
     1050     define variable v-date as date      no-undo .
     1051     define variable v-time as integer   no-undo .
     1052     run cur-time in this-procedure
     1053       (output v-date
     1054       ,output v-time
     1055       ) .
     1056     return integer(v-date) - 2400002 + (v-time / 86400) .
     1057   end.
     1058   function cur-time-get-ending-index returns integer
     1059   (input p-number as integer
     1060   )
     1061   :
     1062     if p-number < 0
     1063     or p-number = ?
     1064     then do:
     1065       return 1 .
     1066     end.
     1067     define variable v-rest as integer   no-undo .
     1068     assign
     1069       p-number = p-number modulo 100
     1070     .
     1071     if p-number < 20
     1072     then do:
     1073       assign
     1074         v-rest = p-number
     1075       .
     1076     end.
     1077     else do:
     1078       assign
     1079         v-rest = p-number modulo 10
     1080       .
     1081     end.
     1082     case v-rest :
     1083       when 1
     1084       then do:
     1085         return 2 .
     1086       end.
     1087       when 2 or
     1088       when 3 or
     1089       when 4
     1090       then do:
     1091         return 3 .
     1092       end.
     1093       otherwise do:
     1094         return 1 .
     1095       end.
     1096     end case .
     1097   end.
     1098   procedure cur-time-mjd-to-date :
     1099      define input  parameter i-mjd-diff as decimal no-undo.
     1100      define output parameter o-Date     as date    no-undo.
     1101      define output parameter o-Time     as integer no-undo.
     1102      define variable v-day-number as integer   no-undo .
     1103      if    i-mjd-diff < 0
     1104         or i-mjd-diff = ?
     1105      then do:
     1106         return "?" .
     1107      end.
     1108      assign
     1109         v-day-number = truncate(i-mjd-diff,0).
     1110         o-Date = date(v-day-number + 2400002).
     1111         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     1112     .
     1113   end.
     1114   function cur-time-mjd-to-string returns character
     1115   (input p-mjd-diff as decimal
     1116   )
     1117   :
     1118     define variable v-day-number as integer   no-undo .
     1119     define variable v-seconds    as integer   no-undo .
     1120     define variable v-hour       as integer   no-undo .
     1121     define variable v-min        as integer   no-undo .
     1122     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     1123     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     1124     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     1125     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1126     if p-mjd-diff < 0
     1127     or p-mjd-diff = ?
     1128     then do:
     1129       return "?" .
     1130     end.
     1131     assign
     1132       v-day-number = integer(truncate(p-mjd-diff,0))
     1133       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1134     .
     1135     if v-seconds > 86400
     1136     then do:
     1137       assign
     1138         v-seconds = 86400 - 1
     1139       .
     1140     end.
     1141     if v-seconds < 0
     1142     then do:
     1143       assign
     1144         v-seconds = 0
     1145       .
     1146     end.
     1147     assign
     1148       v-hour = truncate(v-seconds / 3600, 0)
     1149     .
     1150     assign
     1151       v-seconds = v-seconds modulo 3600
     1152     .
     1153     assign
     1154       v-min = truncate(v-seconds / 60, 0)
     1155     .
     1156     assign
     1157       v-seconds = v-seconds modulo 60
     1158     .
     1159     return
     1160         (if v-day-number <> 0
     1161           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1162           else ""
     1163         )
     1164       + (if v-day-number <> 0 or v-hour <> 0
     1165           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1166           else ""
     1167         )
     1168       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1169           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1170           else ""
     1171         )
     1172       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1173       .
     1174   end.
     1175   function cur-time-string returns character
     1176   :
     1177     define variable v-date as date      no-undo .
     1178     define variable v-time as integer   no-undo .
     1179     run cur-time in this-procedure
     1180       (output v-date
     1181       ,output v-time
     1182       ) .
     1183     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1184   end.
     1185   function cur-time-string-sec returns character
     1186   :
     1187     define variable v-date as date      no-undo .
     1188     define variable v-time as integer   no-undo .
     1189     run cur-time in this-procedure
     1190       (output v-date
     1191       ,output v-time
     1192       ) .
     1193     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1194   end.
     1195   function cur-time-custom  returns character
     1196   (input p-prefix as character
     1197   ,input p-date-format as character
     1198   ,input p-delimiter as character
     1199   ,input p-time-format as character
     1200   ,input p-suffix as character
     1201   )
     1202   :
     1203     define variable v-date as date      no-undo .
     1204     define variable v-time as integer   no-undo .
     1205     run cur-time in this-procedure
     1206       (output v-date
     1207       ,output v-time
     1208       ) .
     1209     return
     1210       p-prefix
     1211       + string(v-date, p-date-format)
     1212       + p-delimiter
     1213       + string(v-time, p-time-format)
     1214       + p-suffix
     1215       .
     1216   end.
     1217   function cur-time-print  returns character
     1218   :
     1219     define variable v-date as date      no-undo .
     1220     define variable v-time as integer   no-undo .
     1221     run cur-time in this-procedure
     1222       (output v-date
     1223       ,output v-time
     1224       ) .
     1225     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1226   end.
     1227   function cur-time-datetime returns datetime
     1228   :
     1229     define variable v-char as character no-undo .
     1230     define variable v-datetime as datetime no-undo .
     1231     v-char = cur-time-string().
     1232     v-datetime = datetime(v-char).
     1233     return  v-datetime.
     1234   end.
     1235   function cur-time-string-msec returns character
     1236   :
     1237     define variable v-date as datetime  no-undo .
     1238     v-date = now.
     1239     return string(v-date) .
     1240   end.
