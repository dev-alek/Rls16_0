      913   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      914   function breakstr returns character ( input        for-name    as character,
      915                                         input        line-length as integer,
      916                                         input-output line1       as character,
      917                                         input-output line2       as character ) :
      918     define variable ii as integer no-undo.
      919     if length( for-name ) > line-length then do:
      920       assign ii    = 1
      921              line1 = "":u
      922              line2 = "":u.
      923       if length( entry( ii, for-name , " ":u ) ) > line-length then do:
      924         assign line1 =       substring( for-name, 1, line-length     )
      925                line2 = trim( substring( for-name,    line-length + 1 ) ).
      926       end.                                                     else do:
      927         do while length( line1 + entry( ii, for-name, " ":u ) ) < ( line-length + 1 ) :
      928           assign line1 = line1 + entry( ii, for-name, " ":u ) + " ":u
      929                  ii    = ii    + 1.
      930           if length( entry( ii, for-name, " ":u ) ) > line-length then do:
      931             assign line1 = line1 + substring( for-name, length( line1 ), line-length - length( line1 ) + 1 ).
      932           end.
      933         end.
      934         assign line2 = trim( substring( for-name, length( line1 ) ) ).
      935       end.
      936     end.                                else do:
      937       assign line1 = for-name
      938              line2 = "":u.
      939     end.
      940     return ( line1 ).
      941   end function.
      942   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      943   procedure cur-time :
      944      define output parameter p-today as date      no-undo .
      945      define output parameter p-time  as integer   no-undo .
      946     do
      947     on error undo, return error
      948     :
      949       define variable v-date1 as date      no-undo .
      950       define variable v-date2 as date      no-undo .
      951       define variable v-time  as integer   no-undo .
      952       assign
      953         v-date1 = today
      954         v-time  = time
      955         v-date2 = today
      956       .
      957       if v-date1 <> v-date2
      958       then do:
      959         assign
      960           v-date1 = today
      961           v-time  = v-time
      962         .
      963       end.
      964       assign
      965         p-today = v-date1
      966         p-time  = v-time
      967       .
      968     end.
      969   end.
      970   function cur-time-date returns character
      971   :
      972     return string(today, '99/99/9999':U) .
      973   end.
      974   function cur-time-mjd returns decimal
      975   :
      976     define variable v-date as date      no-undo .
      977     define variable v-time as integer   no-undo .
      978     run cur-time in this-procedure
      979       (output v-date
      980       ,output v-time
      981       ) .
      982     return integer(v-date) - 2400002 + (v-time / 86400) .
      983   end.
      984   function cur-time-get-ending-index returns integer
      985   (input p-number as integer
      986   )
      987   :
      988     if p-number < 0
      989     or p-number = ?
      990     then do:
      991       return 1 .
      992     end.
      993     define variable v-rest as integer   no-undo .
      994     assign
      995       p-number = p-number modulo 100
      996     .
      997     if p-number < 20
      998     then do:
      999       assign
     1000         v-rest = p-number
     1001       .
     1002     end.
     1003     else do:
     1004       assign
     1005         v-rest = p-number modulo 10
     1006       .
     1007     end.
     1008     case v-rest :
     1009       when 1
     1010       then do:
     1011         return 2 .
     1012       end.
     1013       when 2 or
     1014       when 3 or
     1015       when 4
     1016       then do:
     1017         return 3 .
     1018       end.
     1019       otherwise do:
     1020         return 1 .
     1021       end.
     1022     end case .
     1023   end.
     1024   procedure cur-time-mjd-to-date :
     1025      define input  parameter i-mjd-diff as decimal no-undo.
     1026      define output parameter o-Date     as date    no-undo.
     1027      define output parameter o-Time     as integer no-undo.
     1028      define variable v-day-number as integer   no-undo .
     1029      if    i-mjd-diff < 0
     1030         or i-mjd-diff = ?
     1031      then do:
     1032         return "?" .
     1033      end.
     1034      assign
     1035         v-day-number = truncate(i-mjd-diff,0).
     1036         o-Date = date(v-day-number + 2400002).
     1037         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     1038     .
     1039   end.
     1040   function cur-time-mjd-to-string returns character
     1041   (input p-mjd-diff as decimal
     1042   )
     1043   :
     1044     define variable v-day-number as integer   no-undo .
     1045     define variable v-seconds    as integer   no-undo .
     1046     define variable v-hour       as integer   no-undo .
     1047     define variable v-min        as integer   no-undo .
     1048     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     1049     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     1050     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     1051     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1052     if p-mjd-diff < 0
     1053     or p-mjd-diff = ?
     1054     then do:
     1055       return "?" .
     1056     end.
     1057     assign
     1058       v-day-number = integer(truncate(p-mjd-diff,0))
     1059       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1060     .
     1061     if v-seconds > 86400
     1062     then do:
     1063       assign
     1064         v-seconds = 86400 - 1
     1065       .
     1066     end.
     1067     if v-seconds < 0
     1068     then do:
     1069       assign
     1070         v-seconds = 0
     1071       .
     1072     end.
     1073     assign
     1074       v-hour = truncate(v-seconds / 3600, 0)
     1075     .
     1076     assign
     1077       v-seconds = v-seconds modulo 3600
     1078     .
     1079     assign
     1080       v-min = truncate(v-seconds / 60, 0)
     1081     .
     1082     assign
     1083       v-seconds = v-seconds modulo 60
     1084     .
     1085     return
     1086         (if v-day-number <> 0
     1087           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1088           else ""
     1089         )
     1090       + (if v-day-number <> 0 or v-hour <> 0
     1091           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1092           else ""
     1093         )
     1094       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1095           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1096           else ""
     1097         )
     1098       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1099       .
     1100   end.
     1101   function cur-time-string returns character
     1102   :
     1103     define variable v-date as date      no-undo .
     1104     define variable v-time as integer   no-undo .
     1105     run cur-time in this-procedure
     1106       (output v-date
     1107       ,output v-time
     1108       ) .
     1109     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1110   end.
     1111   function cur-time-string-sec returns character
     1112   :
     1113     define variable v-date as date      no-undo .
     1114     define variable v-time as integer   no-undo .
     1115     run cur-time in this-procedure
     1116       (output v-date
     1117       ,output v-time
     1118       ) .
     1119     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1120   end.
     1121   function cur-time-custom  returns character
     1122   (input p-prefix as character
     1123   ,input p-date-format as character
     1124   ,input p-delimiter as character
     1125   ,input p-time-format as character
     1126   ,input p-suffix as character
     1127   )
     1128   :
     1129     define variable v-date as date      no-undo .
     1130     define variable v-time as integer   no-undo .
     1131     run cur-time in this-procedure
     1132       (output v-date
     1133       ,output v-time
     1134       ) .
     1135     return
     1136       p-prefix
     1137       + string(v-date, p-date-format)
     1138       + p-delimiter
     1139       + string(v-time, p-time-format)
     1140       + p-suffix
     1141       .
     1142   end.
     1143   function cur-time-print  returns character
     1144   :
     1145     define variable v-date as date      no-undo .
     1146     define variable v-time as integer   no-undo .
     1147     run cur-time in this-procedure
     1148       (output v-date
     1149       ,output v-time
     1150       ) .
     1151     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1152   end.
     1153   function cur-time-datetime returns datetime
     1154   :
     1155     define variable v-char as character no-undo .
     1156     define variable v-datetime as datetime no-undo .
     1157     v-char = cur-time-string().
     1158     v-datetime = datetime(v-char).
     1159     return  v-datetime.
     1160   end.
     1161   function cur-time-string-msec returns character
     1162   :
     1163     define variable v-date as datetime  no-undo .
     1164     v-date = now.
     1165     return string(v-date) .
     1166   end.
