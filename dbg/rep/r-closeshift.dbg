      214   procedure create_obj-list :
      215      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      216      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      217      do
      218      on error undo, return error return-value
      219      :
      220         define buffer cli-obj for ub.clients .
      221         define variable p-var as integer no-undo .
      222         define buffer buf_obj-list for obj-list .
      223         find last buf_obj-list  use-index pi no-error .
      224         if available buf_obj-list
      225         then
      226            p-var = buf_obj-list.obj-id + 1.
      227         else
      228            p-var = 1.
      229         find first cli-obj where
      230                   cli-obj.obj-type = p-obj-type
      231               and cli-obj.obj-code = p-obj-code
      232         no-lock no-error.
      233         if available cli-obj
      234         then do:
      235            create buf_obj-list.
      236            assign
      237               buf_obj-list.obj-id   = p-var
      238               buf_obj-list.obj-code = cli-obj.obj-code
      239               buf_obj-list.obj-type = cli-obj.obj-type
      240               buf_obj-list.obj-name = cli-obj.obj-name
      241               buf_obj-list.db-num   = cli-obj.db-num
      242            .
      243         end.
      244      end.
      245   end.
