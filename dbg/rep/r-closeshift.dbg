     6813   procedure last-line-tog-html :
     6814       define input parameter v-report-name-html     as character no-undo .
     6815       find first temp-shift-obj  where temp-shift-obj.num = v-count no-error .
     6816       if available temp-shift-obj then
     6817       do:
     6818           assign
