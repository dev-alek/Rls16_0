     3180   define            variable sheets                    as integer   no-undo.
     3181   define            variable v-previous-shift-date     as date      no-undo .
     3182   define            variable v-current-shift-date      as date      no-undo .
     3183   define            variable v-archive-ok              as logical   no-undo .
     3184   define            variable v-comment                 as character no-undo .
     3185   define            variable v-can-print               as logical   no-undo .
     3186   define            variable v-run-2-3-4               as logical   no-undo initial yes.
     3187   define            variable v-host-code               like ub.sysconf.host-code no-undo .
