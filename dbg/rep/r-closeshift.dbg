     1769   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1770   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1771   def var vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1772   procedure gen-key-rec :
     1773     define input  parameter p-tbl-name    as character no-undo.
     1774     define input  parameter p-bh_tbl-name as handle    no-undo.
     1775     define output parameter p-key-rec     as character no-undo.
     1776     do
     1777     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1778     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
     1779     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
     1780     :
     1781       define variable fh               as handle    no-undo .
     1782       define variable v-ok             as logical   no-undo .
     1783       define variable v-inform         as character no-undo .
     1784       define variable v-ind            as integer   no-undo .
     1785       define variable v-idx-field-qnty as integer   no-undo .
     1786       if p-tbl-name = ?
     1787         or p-tbl-name = "":U
     1788       then do:
     1789         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info26 ).
     1790       end.
     1791       if not p-bh_tbl-name:available then do:
     1792         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info26, p-tbl-name ).
     1793       end.
     1794       assign
     1795         p-key-rec = p-tbl-name
     1796         v-inform  = p-bh_tbl-name:index-information(1)
     1797         v-ind     = 2
     1798       .
     1799       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1800       on error undo, return error
     1801       :
     1802         assign
     1803           v-inform = p-bh_tbl-name:index-information( v-ind )
     1804           v-ind    = v-ind + 1
     1805         .
     1806       end.
     1807       if v-inform = ?
     1808         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1809         or entry( 3, v-inform, ",":U ) <> "1":U
     1810       then do:
     1811         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info26, p-tbl-name ).
     1812       end.
     1813       else do:
     1814         assign
     1815           v-idx-field-qnty = num-entries( v-inform ) - 4
     1816         .
     1817         if v-idx-field-qnty < 2 then do:
     1818           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info26, v-inform, p-tbl-name ).
     1819         end.
     1820         do v-ind = 1 to v-idx-field-qnty by 2
     1821         on error undo, return error
     1822         :
     1823           assign
     1824             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
     1825             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
     1826           .
     1827         end.
     1828       end.
     1829       if p-key-rec = ? then do:
     1830         assign
     1831           p-key-rec = "":U
     1832         .
     1833         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info26, p-tbl-name ).
     1834       end.
     1835     end.
     1836     return.
     1837   end procedure.
     1838   procedure gen-where-keyr-tab :
     1839     define input  parameter i-tableSerach as character no-undo.
     1840     define input  parameter i-tablekey   as character  no-undo.
     1841     define input  parameter p-key-rec    as character  no-undo.
     1842     define input  parameter p-key-handle as handle     no-undo .
     1843     define input  parameter p-db-name    as character  no-undo .
     1844     define input  parameter p-tt-handle  as handle     no-undo .
     1845     define output parameter o-Where      as character  no-undo.
     1846     do
     1847     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1848     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1849     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
     1850     :
     1851       define variable v-full-tbl-name  as character no-undo .
     1852       define variable bh_tbl-name      as handle    no-undo .
     1853       define variable fh_key           as handle    no-undo .
     1854       define variable fh_search        as handle    no-undo .
     1855       define variable v-field-num      as integer   no-undo .
     1856       define variable v-count-fld      as integer   no-undo .
     1857       define variable v-inform         as character no-undo .
     1858       define variable v-ind            as integer   no-undo .
     1859       define variable v-idx-field-qnty as integer   no-undo .
     1860       define variable v-field-name     as character no-undo .
     1861       define variable v-field-val      as character no-undo .
     1862       define variable v-word-link      as character no-undo .
     1863       define variable vTable           as character no-undo.
     1864       define variable bh_tbl-key       as handle    no-undo .
     1865       assign
     1866         p-key-rec = trim( p-key-rec )
     1867       .
     1868       if p-key-handle <> ? then do:
     1869         if not valid-handle(p-key-handle)
     1870            or p-key-handle:type <> "buffer"
     1871         then do:
     1872           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info26 ).
     1873         end.
     1874         if num-entries( p-key-rec, chr(3) ) > 1
     1875           or p-key-rec = ?
     1876           or p-key-rec = "":U
     1877         then do:
     1878           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info26, p-key-rec ).
     1879         end.
     1880       end.
     1881       else do:
     1882         if p-key-rec = ?
     1883           or p-key-rec = "":U
     1884         then do:
     1885           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info26 ).
     1886         end.
     1887       end.
     1888       assign
     1889         vTable = entry( 1 , p-key-rec, chr(3) )
     1890       .
     1891       if p-tt-handle <> ?
     1892         and ( not valid-handle(p-tt-handle)
     1893               or p-tt-handle:type <> "buffer"
     1894             )
     1895       then do:
     1896         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info26, vTable, chr(10) ).
     1897       end.
     1898       if p-tt-handle = ? then do:
     1899         assign
     1900           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
     1901         .
     1902         create buffer bh_tbl-name for table v-full-tbl-name .
     1903       end.
     1904       else do:
     1905         create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1906       end.
     1907       assign
     1908         v-inform = bh_tbl-name:index-information(1)
     1909         v-ind    = 2
     1910       .
     1911       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1912       on error undo, return error
     1913       :
     1914         assign
     1915           v-inform = bh_tbl-name:index-information( v-ind )
     1916           v-ind    = v-ind + 1
     1917         .
     1918       end.
     1919       if v-inform = ?
     1920         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1921         or entry( 3, v-inform, ",":U ) <> "1":U
     1922       then do:
     1923         delete object bh_tbl-name no-error.
     1924         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info26, vTable ).
     1925       end.
     1926       assign
     1927         v-idx-field-qnty = num-entries( v-inform ) - 4
     1928       .
     1929       if v-idx-field-qnty < 2 then do:
     1930         delete object bh_tbl-name no-error.
     1931         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info26, v-inform, vTable ).
     1932       end.
     1933       assign
     1934         o-where     = "where":U
     1935         v-word-link = "":U
     1936         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
     1937         v-count-fld = 0
     1938       .
     1939       if i-tablekey ne "" and i-tablekey ne ?
     1940       then do:
     1941         assign
     1942           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
     1943         .
     1944         create buffer bh_tbl-key for table v-full-tbl-name .
     1945       end.
     1946       if i-tableSerach ne "" and i-tableSerach ne ?
     1947       then do:
     1948         delete object bh_tbl-name no-error.
     1949         assign
     1950           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
     1951         .
     1952         create buffer bh_tbl-name for table v-full-tbl-name .
     1953       end.
     1954       block_where:
     1955       do v-ind = 1 to v-idx-field-qnty by 2
     1956       on error undo, return error
     1957       :
     1958         assign
     1959           v-count-fld = v-count-fld + 1
     1960         .
     1961         if p-key-handle = ?
     1962           and v-count-fld > v-field-num
     1963         then do:
     1964           leave block_where.
     1965         end.
     1966         define variable VfieldKeyTable as handle no-undo.
     1967         assign
     1968           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     1969           fh_search    = bh_tbl-name:buffer-field( v-field-name )
     1970         .
     1971         if     bh_tbl-key ne ?
     1972         then do:
     1973            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
     1974            if VfieldKeyTable eq ?
     1975            then next block_where.
     1976         end.
     1977         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
     1978         then
     1979            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
     1980         else
     1981            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
     1982         if p-key-handle = ? then do:
     1983           assign
     1984             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
     1985           .
     1986         end.
     1987         else do:
     1988           assign
     1989             fh_key = p-key-handle:buffer-field( v-field-name )
     1990           .
     1991           if fh_key = ?
     1992             or not valid-handle( fh_key )
     1993           then do:
     1994             delete object bh_tbl-name.
     1995             if     bh_tbl-key ne ?
     1996             then
     1997                delete object bh_tbl-key.
     1998             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info26, p-key-handle:name, v-field-name ).
     1999           end.
     2000           assign
     2001             v-field-val = fh_key:buffer-value
     2002           .
     2003         end.
     2004         if fh_search:data-type ="character":U then do:
     2005           assign
     2006             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
     2007             v-field-val = replace( v-field-val, '"':U, '~~"':U )
     2008             v-field-val = replace( v-field-val, "'":U, "~~'":U )
     2009             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
     2010             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
     2011             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
     2012             v-field-val = replace( v-field-val, chr(10), '~~n':U )
     2013             v-field-val = replace( v-field-val, chr(9), '~~t':U )
     2014             v-field-val = replace( v-field-val, chr(13), '~~r':U )
     2015             v-field-val = replace( v-field-val, chr(27), '~~E':U )
     2016             v-field-val = replace( v-field-val, chr(8), '~~b':U )
     2017             v-field-val = replace( v-field-val, chr(12), '~~f':U )
     2018             v-field-val = substitute( '"&1"', v-field-val )
     2019           .
     2020         end.
     2021         assign
     2022           o-where = substitute( "&1 &2", o-where, v-field-val )
     2023         .
     2024         if v-word-link = "":U then do:
     2025           assign
     2026             v-word-link = "and":U
     2027           .
     2028         end.
     2029       end.
     2030       delete object bh_tbl-name.
     2031       if     bh_tbl-key ne ?
     2032       then
     2033          delete object bh_tbl-key.
     2034       if p-key-handle = ?
     2035         and v-count-fld <> v-field-num
     2036       then do:
     2037         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info26, vTable ).
     2038       end.
     2039     end.
     2040   end procedure.
     2041   procedure gen-hn-keyr-tab :
     2042     define input  parameter i-tableSerach as character no-undo.
     2043     define input  parameter i-tablekey   as character no-undo.
     2044     define input  parameter p-key-rec    as character no-undo.
     2045     define input  parameter p-key-handle as handle    no-undo .
     2046     define input  parameter p-db-name    as character no-undo .
     2047     define input  parameter p-tt-handle  as handle    no-undo .
     2048     define input  parameter p-stts-lock  as integer   no-undo .
     2049     define output parameter o-hn         as handle    no-undo.
     2050     define variable v-full-tbl-name as character no-undo.
     2051     define variable v-where         as character no-undo.
     2052     define variable bh_tbl-name     as handle    no-undo.
     2053     define variable vTable          as character no-undo.
     2054     do
     2055     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2056     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     2057     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
     2058         run gen-where-keyr-tab(i-tableSerach,
     2059                                i-tablekey,
     2060                                p-key-rec,
     2061                                p-key-handle,
     2062                                p-db-name,
     2063                                p-tt-handle,
     2064                                output v-where).
     2065         if i-tableSerach ne "" and i-tableSerach ne ?
     2066         then do:
     2067            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
     2068            create buffer bh_tbl-name for table v-full-tbl-name .
     2069         end.
     2070         else do:
     2071            if p-tt-handle = ? then do:
     2072               assign
     2073                  vTable = entry( 1 , p-key-rec, chr(3) )
     2074               .
     2075               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
     2076               create buffer bh_tbl-name for table v-full-tbl-name .
     2077            end.
     2078            else do:
     2079               create buffer bh_tbl-name for table p-tt-handle:table-handle .
     2080            end.
     2081         end.
     2082         if p-tt-handle = ? then do:
     2083            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
     2084         end.
     2085         else do:
     2086            bh_tbl-name:find-first( v-where ) no-error .
     2087         end.
     2088         o-hn = bh_tbl-name.
     2089      end.
     2090   end procedure.
     2091   procedure gen-hn-keyr :
     2092     define input  parameter p-key-rec    as character no-undo.
     2093     define input  parameter p-key-handle as handle    no-undo .
     2094     define input  parameter p-db-name    as character no-undo .
     2095     define input  parameter p-tt-handle  as handle    no-undo .
     2096     define input  parameter p-stts-lock  as integer   no-undo .
     2097     define output parameter o-hn         as handle    no-undo.
     2098     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
     2099   end.
     2100   procedure gen-row-keyr :
     2101     define input  parameter p-key-rec    as character no-undo.
     2102     define input  parameter p-key-handle as handle    no-undo .
     2103     define input  parameter p-db-name    as character no-undo .
     2104     define input  parameter p-tt-handle  as handle    no-undo .
     2105     define input  parameter p-stts-lock  as integer   no-undo .
     2106     define output parameter p-tbl-row    as rowid     no-undo.
     2107     define output parameter p-tbl-name   as character no-undo.
     2108     define variable vHn as handle no-undo.
     2109       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
     2110       p-tbl-row = if vHn:available then vHn:rowid else ?.
     2111       p-tbl-name =  vHn:table.
     2112       delete object vHn no-error.
     2113     if p-tbl-row = ? then do:
     2114       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info26, p-tbl-name, p-key-rec ).
     2115     end.
     2116     else do:
     2117       return.
     2118     end.
     2119   end procedure.
     2120   procedure gen-key-fv :
     2121     define input  parameter p-key-rec    as character no-undo .
     2122     define output parameter p-field-list as character no-undo .
     2123     define output parameter p-value-list as character no-undo.
     2124     do
     2125     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2126     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     2127     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     2128     :
     2129       define variable v-full-tbl-name  as character no-undo .
     2130       define variable bh_tbl-name      as handle    no-undo .
     2131       define variable v-tbl-name       as character no-undo .
     2132       define variable v-field-num      as integer   no-undo .
     2133       define variable v-count-fld      as integer   no-undo .
     2134       define variable v-inform         as character no-undo .
     2135       define variable v-ind            as integer   no-undo .
     2136       define variable v-idx-field-qnty as integer   no-undo .
     2137       define variable v-delim-key      as character no-undo .
     2138       if p-key-rec = ?
     2139         or p-key-rec = "":U
     2140       then do:
     2141         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info26 ).
     2142       end.
     2143       assign
     2144         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     2145         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     2146       .
     2147       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     2148       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info26 ).
     2149       assign
     2150         v-inform = bh_tbl-name:index-information(1)
     2151         v-ind    = 2
     2152       .
     2153       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     2154       on error undo, return error
     2155       :
     2156         assign
     2157           v-inform = bh_tbl-name:index-information( v-ind )
     2158           v-ind    = v-ind + 1
     2159         .
     2160       end.
     2161       if v-inform = ?
     2162         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     2163         or entry( 3, v-inform, ",":U ) <> "1":U
     2164       then do:
     2165         delete object bh_tbl-name no-error.
     2166         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info26, v-tbl-name ).
     2167       end.
     2168       assign
     2169         v-idx-field-qnty = num-entries( v-inform ) - 4
     2170       .
     2171       if v-idx-field-qnty < 2 then do:
     2172         delete object bh_tbl-name no-error.
     2173         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info26, v-inform, v-tbl-name ).
     2174       end.
     2175       assign
     2176         p-field-list = "":U
     2177         p-value-list = "":U
     2178         v-delim-key  = "":U
     2179         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     2180         v-count-fld  = 0
     2181       .
     2182       block_where:
     2183       do v-ind = 1 to v-idx-field-qnty by 2
     2184       on error undo, return error
     2185       :
     2186         assign
     2187           v-count-fld = v-count-fld + 1
     2188         .
     2189         if v-count-fld > v-field-num then do:
     2190           leave block_where.
     2191         end.
     2192         assign
     2193           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     2194           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     2195         .
     2196         if v-ind = 1 then do:
     2197           assign
     2198             v-delim-key = chr(3)
     2199           .
     2200         end.
     2201       end.
     2202       delete object bh_tbl-name.
     2203       if v-count-fld <> v-field-num then do:
     2204         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info26, v-tbl-name ).
     2205       end.
     2206     end.
     2207   end procedure.
     2208   procedure gen-key-field :
     2209     define input  parameter p-table      as character no-undo .
     2210     define output parameter p-field-list as character no-undo .
     2211     do
     2212     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2213     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     2214     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     2215     :
     2216       define variable v-full-tbl-name  as character no-undo .
     2217       define variable bh_tbl-name      as handle    no-undo .
     2218       define variable v-tbl-name       as character no-undo .
     2219       define variable v-field-num      as integer   no-undo .
     2220       define variable v-count-fld      as integer   no-undo .
     2221       define variable v-inform         as character no-undo .
     2222       define variable v-ind            as integer   no-undo .
     2223       define variable v-idx-field-qnty as integer   no-undo .
     2224       define variable v-delim-key      as character no-undo .
     2225       if p-table = ?
     2226         or p-table = "":U
     2227       then do:
     2228         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info26 ).
     2229       end.
     2230       assign
     2231         v-tbl-name      = p-table
     2232         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     2233       .
     2234       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     2235       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info26 ).
     2236       assign
     2237         v-inform = bh_tbl-name:index-information(1)
     2238         v-ind    = 2
     2239       .
     2240       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     2241       on error undo, return error
     2242       :
     2243         assign
     2244           v-inform = bh_tbl-name:index-information( v-ind )
     2245           v-ind    = v-ind + 1
     2246         .
     2247       end.
     2248       if v-inform = ?
     2249         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     2250         or entry( 3, v-inform, ",":U ) <> "1":U
     2251       then do:
     2252         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info26, v-tbl-name ).
     2253       end.
     2254       assign
     2255         v-idx-field-qnty = num-entries( v-inform ) - 4
     2256       .
     2257       if v-idx-field-qnty < 2 then do:
     2258         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info26, v-inform, v-tbl-name ).
     2259       end.
     2260       assign
     2261         p-field-list = "":U
     2262         v-delim-key  = "":U
     2263         v-count-fld  = 0
     2264       .
     2265       block_where:
     2266       do v-ind = 1 to v-idx-field-qnty by 2
     2267       on error undo, return error
     2268       :
     2269         assign
     2270           v-count-fld = v-count-fld + 1
     2271         .
     2272         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     2273         if v-ind = 1 then do:
     2274           assign
     2275             v-delim-key = chr(3)
     2276           .
     2277         end.
     2278       end.
     2279       delete object bh_tbl-name.
     2280     end.
     2281   end procedure.
     2282   procedure get-gate-file-name :
     2283   define input parameter p-gate-rec as character no-undo .
     2284   define output  parameter p-gate-file-name as character no-undo .
     2285   define buffer buf_clob-data for ub.clob-data.
     2286   define variable v-tbl-row as rowid no-undo .
     2287   define variable v-tbl-name as character no-undo .
     2288   run gen-row-keyr in this-procedure ( input p-gate-rec
     2289                                       ,input ?
     2290                                       ,input "ub"
     2291                                       ,input ?
     2292                                       ,input no-lock
     2293                                       ,output v-tbl-row
     2294                                       ,output v-tbl-name) no-error.
     2295   if error-status:error then undo, return error substitute("&1 (get-gate-name) Несуществующий gate &2"
     2296                                                           ,vss-include-info24
     2297                                                           ,p-gate-rec).
     2298   find first buf_clob-data no-lock where
     2299             rowid(buf_clob-data) = v-tbl-row no-error.
     2300   if not available buf_clob-data then do:
     2301     if error-status:error then undo, return error substitute("&1 (get-gate-name) Несуществующий gate &2"
     2302                                                             ,vss-include-info24
     2303                                                             ,p-gate-rec).
     2304   end.
     2305   p-gate-file-name = buf_clob-data.file-name.
     2306   end procedure.
     2307   procedure get-gate-rec :
     2308   define input  parameter p-gate-name as character no-undo .
     2309   define output parameter p-gate-rec as character no-undo .
     2310   define buffer buf_clob-bind for ub.clob-bind.
     2311   define buffer buf_clob-data for ub.clob-data.
     2312   main-block:
     2313   do
     2314   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info24, return-value, chr(10), error-status :get-message (1))
     2315   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info24 )
     2316   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info24 )
     2317   :
     2318       find first buf_clob-bind no-lock where
     2319                 buf_clob-bind.uniq-key-rec = p-gate-name
     2320             and buf_clob-bind.field-name = '':U
     2321             and buf_clob-bind.part-num = 1
     2322             and buf_clob-bind.resource-type = 'gate':U
     2323             no-error.
     2324       if not available buf_clob-bind then do:
     2325         undo, return error substitute("Неверная ссылка на XSD -файл &1 для gate"
     2326                                         , p-gate-name
     2327                                         ).
     2328       end.
     2329       find first buf_clob-data no-lock where
     2330                 buf_clob-data.db-num = buf_clob-bind.db-num
     2331             and buf_clob-data.int64-i= buf_clob-bind.int64-id no-error.
     2332       if not available buf_clob-data then do:
     2333         undo, return error substitute("Не найден CLOB c ДБ &1 id &2 - файл &3"
     2334                                         , buf_clob-bind.db-num
     2335                                         , buf_clob-bind.int64-id
     2336                                         , p-gate-name
     2337                                         ).
     2338       end.
     2339       run gen-key-rec in this-procedure ( input 'clob-data':U
     2340                                 ,input buffer buf_clob-data:handle
     2341                                 ,output p-gate-rec).
     2342   end.
     2343   end procedure.
     2344   procedure get-gate-by-name :
     2345   define input  parameter p-gate-name as character no-undo .
     2346   define output parameter p-gate-rec as character no-undo .
     2347   define output parameter p-dsh as handle no-undo .
     2348   define input-output  parameter p-xmlh as handle no-undo .
     2349   define variable v-ii as integer   no-undo .
     2350   define variable glog as logical   no-undo .
     2351   define variable v-longchar as longchar no-undo .
     2352   define variable v-txmlh as handle no-undo .
     2353   define variable v-db-num as integer no-undo .
     2354   define variable v-int64-id as int64 no-undo .
     2355   define buffer buf_clob-bind for ub.clob-bind.
     2356   define buffer buf_clob-data for ub.clob-data.
     2357   main-block:
     2358   do
     2359   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info24, return-value, chr(10), error-status :get-message (1))
     2360   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info24 )
     2361   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info24 )
     2362   :
     2363       find first buf_clob-bind no-lock where
     2364                 buf_clob-bind.uniq-key-rec = p-gate-name
     2365             and buf_clob-bind.field-name = '':U
     2366             and buf_clob-bind.part-num = 1
     2367             and buf_clob-bind.resource-type = 'gate':U
     2368             no-error.
     2369       if not available buf_clob-bind then do:
     2370         undo, return error substitute("Неверная ссылка на XSD -файл &1 для gate"
     2371                                         , p-gate-name
     2372                                         ).
     2373       end.
     2374       find first buf_clob-data no-lock where
     2375                 buf_clob-data.db-num = buf_clob-bind.db-num
     2376             and buf_clob-data.int64-i= buf_clob-bind.int64-id no-error.
     2377       if not available buf_clob-data then do:
     2378         undo, return error substitute("Не найден CLOB c ДБ &1 id &2 - файл &3"
     2379                                         , buf_clob-bind.db-num
     2380                                         , buf_clob-bind.int64-id
     2381                                         , p-gate-name
     2382                                         ).
     2383       end.
     2384       assign
     2385       v-longchar = buf_clob-data.cdata
     2386       .
     2387       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     2388       if error-status :error then do:
     2389         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, buf_clob-data.file-name_, chr(10), error-status:get-message(1) , return-value ).
     2390       end.
     2391       create dataset p-dsh .
     2392       glog = p-dsh:READ-XMLSCHEMA( "LONGCHAR"
     2393                                     , v-longchar
     2394                                     , ?
     2395                                     , ?
     2396                                     , ?
     2397                                     ) no-error.
     2398       v-longchar = '':U.
     2399       if error-status :error
     2400       or not glog
     2401       then do:
     2402         undo, return error substitute("Не удалось прочитать XML-схему &1 из БД:&2&3", p-gate-name, chr(10), error-status:get-message(1) ).
     2403       end.
     2404       if not valid-handle(p-xmlh)
     2405       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     2406         create temp-table v-txmlh.
     2407         v-txmlh:create-like(buffer temp-xml-tables:handle).
     2408         v-txmlh:temp-table-prepare("temp-xml-tables").
     2409         p-xmlh = v-txmlh:default-buffer-handle.
     2410       end.
     2411       run gen-key-rec in this-procedure ( input 'clob-data':U
     2412                                 ,input buffer buf_clob-data:handle
     2413                                 ,output p-gate-rec).
     2414       do v-ii = 1 to p-dsh:num-buffers:
     2415         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     2416         if not p-xmlh:available then do:
     2417           p-xmlh:buffer-create().
     2418           assign
     2419           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     2420           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     2421           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     2422           p-xmlh::gate-handle_ = p-dsh
     2423           p-xmlh::uniq-gate-rec = p-gate-rec
     2424           p-xmlh::gate-name = p-dsh:name
     2425           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     2426           .
     2427           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     2428             assign
     2429             p-xmlh::order = -3.
     2430           end.
     2431         end.
     2432       end.
     2433   end.
     2434   end procedure.
     2435   procedure get-gate-by-rec :
     2436   define input  parameter p-gate-rec as character no-undo .
     2437   define output parameter p-dsh as handle no-undo .
     2438   define input-output  parameter p-xmlh as handle no-undo .
     2439   define input-output parameter p-longchar  as longchar no-undo .
     2440   define variable v-ii as integer   no-undo .
     2441   define variable glog as logical   no-undo .
     2442   define variable v-rowid as rowid no-undo .
     2443   define variable v-tbl-name as character no-undo .
     2444   define variable v-longchar as longchar no-undo .
     2445   define variable v-txmlh as handle no-undo .
     2446   define buffer buf_clob-data for ub.clob-data.
     2447   main-block:
     2448   do
     2449   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info24, return-value, chr(10), error-status :get-message (1))
     2450   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info24 )
     2451   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info24 )
     2452   :
     2453     run gen-row-keyr in this-procedure (
     2454                                           input  p-gate-rec
     2455                                           ,input  ?
     2456                                           ,input  "ub"
     2457                                           ,input  ?
     2458                                           ,input  NO-LOCK
     2459                                           ,output v-rowid
     2460                                           ,output v-tbl-name   ) no-error.
     2461       find first buf_clob-data no-lock where
     2462                 rowid(buf_clob-data) = v-rowid  no-error.
     2463       if not available buf_clob-data then do:
     2464         undo, return error substitute("Не найден CLOB  &1"
     2465                                         , p-gate-rec
     2466                                         ).
     2467       end.
     2468       assign
     2469       v-longchar = buf_clob-data.cdata
     2470       .
     2471       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     2472       if error-status :error then do:
     2473         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, buf_clob-data.file-name_, chr(10), error-status:get-message(1) , return-value ).
     2474       end.
     2475       create dataset p-dsh .
     2476       glog = p-dsh:READ-XMLSCHEMA( "LONGCHAR"
     2477                                     , v-longchar
     2478                                     , ?
     2479                                     , ?
     2480                                     , ?
     2481                                     ) no-error.
     2482       define variable v-esm as character no-undo .
     2483       v-esm = error-status:get-message(1) .
     2484       if p-longchar <> ? then do:
     2485         p-longchar = v-longchar.
     2486       end.
     2487       v-longchar = '':U.
     2488       if error-status :error
     2489       or not glog
     2490       then do:
     2491         undo, return error substitute("Не удалось прочитать XML-схему &1 (&2) из БД&3&4"
     2492                                      , p-gate-rec
     2493                                      , p-gate-rec
     2494                                      , v-esm
     2495                                      ).
     2496       end.
     2497       p-dsh:private-data = buf_clob-data.file-name_ + chr(4) + p-gate-rec.
     2498       if not valid-handle(p-xmlh)
     2499       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     2500         create temp-table v-txmlh.
     2501         v-txmlh:create-like(buffer temp-xml-tables:handle).
     2502         v-txmlh:temp-table-prepare("temp-xml-tables").
     2503         p-xmlh = v-txmlh:default-buffer-handle.
     2504       end.
     2505       do v-ii = 1 to p-dsh:num-buffers:
     2506         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     2507         if not p-xmlh:available then do:
     2508           p-xmlh:buffer-create().
     2509           assign
     2510           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     2511           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     2512           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     2513           p-xmlh::gate-handle_ = p-dsh
     2514           p-xmlh::uniq-gate-rec = p-gate-rec
     2515           p-xmlh::gate-name = p-dsh:name
     2516           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     2517           .
     2518           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     2519             assign
     2520             p-xmlh::order = -3.
     2521           end.
     2522           p-xmlh:buffer-release().
     2523         end.
     2524       end.
     2525   end.
     2526   end procedure.
     2527   procedure get-gate-by-file :
     2528   define input  parameter p-schema-file-name as character no-undo .
     2529   define input  parameter p-gate-rec as character no-undo .
     2530   define output parameter p-dsh as handle no-undo .
     2531   define input-output  parameter p-xmlh as handle no-undo .
     2532   define variable v-ii as integer   no-undo .
     2533   define variable glog as logical   no-undo .
     2534   define variable v-rowid as rowid no-undo .
     2535   define variable v-tbl-name as character no-undo .
     2536   define variable v-longchar as longchar no-undo .
     2537   define variable v-txmlh as handle no-undo .
     2538   main-block:
     2539   do
     2540   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info24, return-value, chr(10), error-status :get-message (1))
     2541   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info24 )
     2542   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info24 )
     2543   :
     2544       COPY-LOB
     2545       FROM  FILE p-schema-file-name
     2546       TO  OBJECT v-longchar
     2547       no-convert
     2548       NO-ERROR .
     2549       if error-status :error then do:
     2550           undo, return error substitute("Не удалось считать файл схемы &1 в память&2&3"
     2551                                     , p-schema-file-name
     2552                                 , chr(10)
     2553                                 , error-status:get-message(1) ).
     2554       end.
     2555       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     2556       if error-status :error then do:
     2557         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, p-schema-file-name, chr(10), error-status:get-message(1) , return-value ).
     2558       end.
     2559       create dataset p-dsh .
     2560       glog = p-dsh:READ-XMLSCHEMA( "longchar"
     2561                                     , v-longchar
     2562                                     , ?
     2563                                     , ?
     2564                                     , ?
     2565                                     ) no-error.
     2566       v-longchar = ''.
     2567       if error-status :error
     2568       or not glog
     2569       then do:
     2570         undo, return error substitute("Не удалось прочитать XML-схему из файла &1&2&3"
     2571                                      , p-schema-file-name
     2572                                      ,chr(10)
     2573                                      , error-status:get-message(1)
     2574                                      ).
     2575       end.
     2576       if not valid-handle(p-xmlh)
     2577       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     2578         create temp-table v-txmlh.
     2579         v-txmlh:create-like(buffer temp-xml-tables:handle).
     2580         v-txmlh:temp-table-prepare("temp-xml-tables").
     2581         p-xmlh = v-txmlh:default-buffer-handle.
     2582       end.
     2583       do v-ii = 1 to p-dsh:num-buffers:
     2584         p-xmlh:find-first(substitute(' where tbl-name = "&1" and  uniq-gate-rec = "&2" '
     2585                                      ,p-dsh:get-buffer-handle(v-ii):name
     2586                                      ,p-gate-rec
     2587                                      )) no-error.
     2588         if not p-xmlh:available then do:
     2589           p-xmlh:buffer-create().
     2590           assign
     2591           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):table
     2592           p-xmlh::uniq-gate-rec = p-gate-rec
     2593           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     2594           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     2595           p-xmlh::gate-handle_ = p-dsh
     2596           p-xmlh::gate-name = p-dsh:name
     2597           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     2598           .
     2599           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     2600             assign
     2601             p-xmlh::order = -3.
     2602           end.
     2603           p-xmlh:buffer-release().
     2604         end.
     2605       end.
     2606   end.
     2607   end procedure.
     2608   procedure gate-clear :
     2609   define input  parameter p-dsh as handle no-undo .
     2610   define input  parameter p-xmlh as handle no-undo .
     2611   define variable v-dsh as handle no-undo .
     2612   define variable v-th as handle no-undo .
     2613     do
     2614     on error undo, return error return-value
     2615     :
     2616       if valid-handle(p-dsh) then do:
     2617         delete object p-dsh.
     2618         v-dsh = p-dsh.
     2619         p-dsh = ?.
     2620       end.
     2621       repeat while true:
     2622         p-xmlh:find-first( substitute( " where gate-handle_ = &1 ", v-dsh)
     2623                            , share-lock) no-error.
     2624         if p-xmlh:available then do:
     2625           assign
     2626           v-th = p-xmlh:buffer-field("table-handle_"):buffer-value.
     2627           if valid-handle(p-xmlh:buffer-field("table-handle_"))
     2628           and valid-handle(v-th)
     2629           and v-th:dynamic = yes
     2630           then do:
     2631             delete object p-xmlh:buffer-field("table-handle_"):buffer-value.
     2632             p-xmlh:buffer-field("table-handle_"):buffer-value = ?.
     2633           end.
     2634           p-xmlh:buffer-delete().
     2635         end.
     2636         else do:
     2637           leave.
     2638         end.
     2639       end.
     2640       if p-xmlh:dynamic = yes
     2641       and valid-handle(p-xmlh)
     2642       then do:
     2643         delete object p-xmlh:table-handle.
     2644         p-xmlh = ?.
     2645       end.
     2646       v-dsh = ?.
     2647     end.
     2648   end procedure.
     2649   procedure all-gates-clear :
     2650   define parameter buffer buf_temp-xml-tables for temp-xml-tables.
     2651   do
     2652   on error undo, return error
     2653   :
     2654     for each buf_temp-xml-tables
     2655     break
     2656     by buf_temp-xml-tables.uniq-gate-rec
     2657     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2658     on stop   undo , return error substitute( "&1. stop", vss-workfile )
     2659     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     2660     :
     2661         if first-of(buf_temp-xml-tables.uniq-gate-rec) then do:
     2662           delete object buf_temp-xml-tables.gate-handle_.
     2663           buf_temp-xml-tables.gate-handle_ = ?.
     2664         end.
     2665         if valid-handle(buf_temp-xml-tables.table-handle_)
     2666         and buf_temp-xml-tables.table-handle_:dynamic = no
     2667         then do:
     2668           delete object buf_temp-xml-tables.table-handle_.
     2669           buf_temp-xml-tables.table-handle_ = ?.
     2670         end.
     2671         delete buf_temp-xml-tables.
     2672     end.
     2673   end.
     2674   end procedure.
     2675   procedure fix-schemalocation :
     2676   define input-output  parameter p-longchar as longchar no-undo .
     2677   DEFINE VARIABLE hdoc AS HANDLE.
     2678   DEFINE VARIABLE hroot AS HANDLE.
     2679   DEFINE VARIABLE hnode-child AS HANDLE.
     2680   DEFINE VARIABLE hnode-attr AS HANDLE.
     2681   define variable v-jj as integer   no-undo .
     2682   define variable ok as logical   no-undo .
     2683   define variable v-path1                    as character                no-undo .
     2684   DEFINE VARIABLE v-full-path1               as character                no-undo .
     2685   DEFINE VARIABLE v-file-name1               as character                no-undo .
     2686   DEFINE VARIABLE v-file-name-no-ext1        as character                no-undo .
     2687   DEFINE VARIABLE v-file-name-ext1           as character                no-undo .
     2688   define variable v-schema-location          as character                no-undo .
     2689   do
     2690   on error undo, return error return-value
     2691   :
     2692     CREATE X-DOCUMENT hdoc.
     2693     CREATE X-noderef hroot.
     2694     CREATE X-noderef hnode-child.
     2695     CREATE X-noderef hnode-attr.
     2696     hdoc:load("longchar", p-longchar, no) no-error.
     2697     iF ERROR-STATUS:GET-MESSAGE(1) <> '' THEN message ERROR-STATUS:GET-MESSAGE(1) view-as alert-box .
     2698     hdoc:get-document-element(hroot).
     2699     _repeat:
     2700     REPEAT v-jj = 1 TO hroot:NUM-CHILDREN:
     2701       ok = hroot:GET-CHILD(hNode-Child, v-jj).
     2702       if not ok then next.
     2703       if hNode-Child:local-name = "include"
     2704       then do:
     2705         ok = hNode-Child:GET-ATTRIBUTE-NODE( hnode-attr, "schemaLocation" ).
     2706           v-schema-location = hnode-attr:node-value.
     2707           run gbl/filename.p (
     2708                           input "exe/" + hnode-attr:node-value
     2709                         ,output v-full-path1
     2710                         ,output v-path1
     2711                         ,output v-file-name1
     2712                         ,output v-file-name-no-ext1
     2713                         ,output v-file-name-ext1
     2714                         ) no-error .
     2715           if error-status :error then do:
     2716             delete object hnode-attr.
     2717             delete object hnode-child.
     2718             delete object hroot.
     2719             delete object hdoc.
     2720             undo, return error substitute("Не удалось определить расположение схемы &1", v-schema-location).
     2721           end.
     2722         ok = hNode-Child:sET-ATTRIBUTE(  "schemaLocation", v-full-path1 ).
     2723         leave  _repeat.
     2724       end.
     2725     END.
     2726     hdoc:save("longchar", p-longchar).
     2727     delete object hnode-attr.
     2728     delete object hnode-child.
     2729     delete object hroot.
     2730     delete object hdoc.
     2731   end.
     2732   end procedure.
     2733   procedure gate-clb_fill-xml-tables :
     2734   define input parameter p-dsh as handle no-undo .
     2735   define input-output parameter p-xmlh as handle no-undo .
     2736   define variable v-ii as integer no-undo .
     2737     do
     2738     on error undo, return error
     2739     :
     2740       do v-ii = 1 to p-dsh:num-buffers:
     2741         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     2742         if not p-xmlh:available then do:
     2743           p-xmlh:buffer-create().
     2744           assign
     2745           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     2746           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     2747           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     2748           p-xmlh::gate-handle_ = p-dsh
     2749           p-xmlh::uniq-gate-rec = entry(2, p-dsh:private-data, chr(4))
     2750           p-xmlh::gate-name = p-dsh:name
     2751           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     2752           .
     2753           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     2754             assign
     2755             p-xmlh::order = -3.
     2756           end.
     2757           p-xmlh:buffer-release().
     2758         end.
     2759       end.
     2760     end.
     2761   end procedure.
     2762   procedure all-gates-empty :
     2763   define buffer buf_temp-xml-tables for temp-xml-tables.
     2764   do
     2765   on error undo, return error
     2766   :
     2767     for each buf_temp-xml-tables
     2768     break
     2769     by buf_temp-xml-tables.uniq-gate-rec
     2770     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2771     on stop   undo , return error substitute( "&1. stop", vss-workfile )
     2772     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     2773     :
     2774       if valid-handle(buf_temp-xml-tables.tbl-handle_) then do:
     2775         buf_temp-xml-tables.tbl-handle_:empty-temp-table().
     2776       end.
     2777     end.
     2778   end.
     2779   end procedure.
     2780   define variable vss-include-info27 as character format "X(65)" no-undo
     2781   initial "@(#)$Workfile$ $Revision$".
     2782   define variable v-fmtcli-name          as character    no-undo.
     2783   define variable v-fmtcli-engl-name     as character    no-undo.
     2784   define variable v-fmtcli-addres        as character    no-undo.
     2785   define variable v-fmtcli-post-addres   as character    no-undo.
     2786   define variable v-fmtcli-full-addres   as character    no-undo.
     2787   define variable v-fmtcli-phone         as character    no-undo.
     2788   define variable v-fmtcli-inn           as character    no-undo.
     2789   define variable v-fmtcli-kpp           as character    no-undo.
     2790   define variable v-fmtcli-okpo          as character    no-undo.
     2791   define variable v-fmtcli-country       as character    no-undo.
     2792   define variable v-fmtcli-city          as character    no-undo.
     2793   define variable v-fmtcli-index         as character    no-undo.
     2794   define variable v-fmtcli-schet-exists  as logical      no-undo.
     2795   define variable v-fmtcli-bank-exists   as logical      no-undo.
     2796   define variable v-fmtcli-bank-r-schet  as character    no-undo.
     2797   define variable v-fmtcli-bank-c-schet  as character    no-undo.
     2798   define variable v-fmtcli-bank-bik      as character    no-undo.
     2799   define variable v-fmtcli-bank-name     as character    no-undo.
     2800   define variable v-fmtcli-bank-addres   as character    no-undo.
     2801   define variable v-fmtcli-bank-city     as character    no-undo.
     2802   procedure fmtcli-get-bank :
     2803   define input parameter p-host-code      as integer          no-undo.
     2804   define input parameter p-obj-type       as character        no-undo.
     2805   define input parameter p-obj-code       as integer          no-undo.
     2806   define input parameter p-curr-code      as integer          no-undo.
     2807       define buffer buf_fin-schet     for ub.fin-schet.
     2808       define buffer buf_fin-bank      for ub.fin-bank.
     2809   do
     2810   for buf_fin-schet
     2811     , buf_fin-bank
     2812   on error undo, return error
     2813   :
     2814       assign
     2815           v-fmtcli-schet-exists       = no
     2816           v-fmtcli-bank-exists        = no
     2817           v-fmtcli-bank-r-schet       = "":U
     2818           v-fmtcli-bank-c-schet       = "":U
     2819           v-fmtcli-bank-bik           = "":U
     2820           v-fmtcli-bank-name          = "":U
     2821           v-fmtcli-bank-addres        = "":U
     2822           v-fmtcli-bank-city          = "":U
     2823       .
     2824       search-for-schet:
     2825       for each buf_fin-schet no-lock
     2826          where buf_fin-schet.host-code = p-host-code
     2827            and buf_fin-schet.cli-type  = p-obj-type
     2828            and buf_fin-schet.cli-code  = p-obj-code
     2829            and buf_fin-schet.curr-code = p-curr-code
     2830       on error undo, return error
     2831       :
     2832           if buf_fin-schet.status_   = 'удал':U
     2833           then do:
     2834           end.
     2835           else do:
     2836               assign
     2837                   v-fmtcli-schet-exists   = yes
     2838                   v-fmtcli-bank-r-schet   = trim( buf_fin-schet.r-schet )
     2839                   v-fmtcli-bank-c-schet   = trim( buf_fin-schet.c-schet )
     2840               .
     2841               find first buf_fin-bank no-lock
     2842                    where buf_fin-bank.host-code = p-host-code
     2843                      and buf_fin-bank.code-bank = buf_fin-schet.code-bank
     2844               no-error.
     2845               if available buf_fin-bank
     2846               then do:
     2847                   assign
     2848                       v-fmtcli-bank-exists      = yes
     2849                       v-fmtcli-bank-bik         = trim( buf_fin-bank.bik )
     2850                       v-fmtcli-bank-name        = trim( buf_fin-bank.bank-name )
     2851                       v-fmtcli-bank-addres      = trim(buf_fin-bank.addres)
     2852                       v-fmtcli-bank-city      = trim(buf_fin-bank.bank-city)
     2853                   .
     2854               end.
     2855               else do:
     2856                   assign
     2857                       v-fmtcli-bank-exists    = no
     2858                       v-fmtcli-bank-bik       = "":U
     2859                       v-fmtcli-bank-name      = "":U
     2860                       v-fmtcli-bank-addres    = "":U
     2861                       v-fmtcli-bank-city      = "":U
     2862                   .
     2863               end.
     2864               leave search-for-schet.
     2865           end.
     2866       end.
     2867   end.
     2868   end procedure.
     2869   procedure fmtcli-get-client :
     2870   define input parameter p-obj-type       as character    no-undo.
     2871   define input parameter p-obj-code       as integer      no-undo.
     2872       define variable v-temp-fmtcli-address      as character     no-undo.
     2873       define variable v-num-country-city    as integer      no-undo.
     2874       define buffer buf_clients   for ub.clients.
     2875       define buffer buf_firm      for ub.firm.
     2876       define buffer buf_store     for ub.store.
     2877       define buffer buf_shop      for ub.shop.
     2878       define buffer buf_person    for ub.person.
     2879   do
     2880   for buf_clients
     2881     , buf_firm
     2882     , buf_store
     2883     , buf_shop
     2884     , buf_person
     2885   on error undo, return error
     2886   :
     2887       assign
     2888           v-fmtcli-name           = "":U
     2889           v-fmtcli-addres         = "":U
     2890           v-fmtcli-post-addres    = "":U
     2891           v-fmtcli-full-addres    = "":U
     2892           v-fmtcli-phone          = "":U
     2893           v-fmtcli-inn            = "":U
     2894           v-fmtcli-kpp            = "":U
     2895           v-fmtcli-okpo           = "":U
     2896           v-fmtcli-city           = "":U
     2897           v-fmtcli-index          = "":U
     2898           v-fmtcli-country        = "":U
     2899       .
     2900       find first buf_clients no-lock
     2901            where buf_clients.obj-type = p-obj-type
     2902              and buf_clients.obj-code = p-obj-code
     2903       .
     2904       assign
     2905           v-fmtcli-name = buf_clients.obj-name
     2906       .
     2907       case buf_clients.obj-type:
     2908          when 'орг':U
     2909          then do:
     2910               find first buf_firm no-lock
     2911                    where buf_firm.firm-code = buf_clients.obj-code
     2912                    no-error
     2913               .
     2914               if available buf_firm
     2915               then do:
     2916                   assign
     2917                       v-num-country-city = num-entries( buf_firm.city )
     2918                       v-fmtcli-engl-name = buf_firm.engl-name
     2919                   .
     2920                   if v-num-country-city > 0
     2921                   then do:
     2922                       assign
     2923                           v-fmtcli-country    = trim( entry( 1, buf_firm.city ) )
     2924                       .
     2925                   end.
     2926                   if v-num-country-city > 1
     2927                   then do:
     2928                       assign
     2929                           v-fmtcli-city       = trim( entry( 2, buf_firm.city ) )
     2930                       .
     2931                   end.
     2932                   run fmtcli-concatenate-strings in this-procedure (
     2933                         input v-fmtcli-full-addres
     2934                       , input v-fmtcli-country
     2935                       , input ", ":U
     2936                       , input 50
     2937                       , output v-fmtcli-full-addres
     2938                   ).
     2939                   run fmtcli-concatenate-strings in this-procedure (
     2940                         input v-fmtcli-full-addres
     2941                       , input v-fmtcli-city
     2942                       , input ", ":U
     2943                       , input 50
     2944                       , output v-fmtcli-full-addres
     2945                   ).
     2946                   run fmtcli-concatenate-strings in this-procedure (
     2947                         input v-fmtcli-full-addres
     2948                       , input IF buf_firm.ind = 0 THEN "" ELSE string( buf_firm.ind )
     2949                       , input ", ":U
     2950                       , input 50
     2951                       , output v-fmtcli-full-addres
     2952                   ).
     2953                   run fmtcli-concatenate-strings in this-procedure (
     2954                         input v-fmtcli-post-addres
     2955                       , input v-fmtcli-country
     2956                       , input ", ":U
     2957                       , input 50
     2958                       , output v-fmtcli-post-addres
     2959                   ).
     2960                   run fmtcli-concatenate-strings in this-procedure (
     2961                         input v-fmtcli-post-addres
     2962                       , input v-fmtcli-city
     2963                       , input ", ":U
     2964                       , input 50
     2965                       , output v-fmtcli-post-addres
     2966                   ).
     2967                   run fmtcli-concatenate-strings in this-procedure (
     2968                         input v-fmtcli-post-addres
     2969                       , input string( buf_firm.ind )
     2970                       , input ", ":U
     2971                       , input 50
     2972                       , output v-fmtcli-post-addres
     2973                   ).
     2974                   run fmtcli-concatenate-strings in this-procedure (
     2975                         input substring( buf_firm.addres1, 1, 50 )
     2976                       , input buf_firm.addres2
     2977                       , input " ":U
     2978                       , input 50
     2979                       , output v-temp-fmtcli-address
     2980                   ).
     2981                   run fmtcli-concatenate-strings in this-procedure (
     2982                         input v-temp-fmtcli-address
     2983                       , input substring( buf_firm.addres1, 51, 50 )
     2984                       , input " ":U
     2985                       , input 50
     2986                       , output v-temp-fmtcli-address
     2987                   ).
     2988                   run fmtcli-concatenate-strings in this-procedure (
     2989                         input v-temp-fmtcli-address
     2990                       , input substring( buf_firm.addres1, 101, 50 )
     2991                       , input " ":U
     2992                       , input 50
     2993                       , output v-temp-fmtcli-address
     2994                   ).
     2995                   assign
     2996                       v-fmtcli-addres = v-temp-fmtcli-address
     2997                   .
     2998                   if buf_firm.addres1 <> ?
     2999                   then do:
     3000                       run fmtcli-concatenate-strings in this-procedure (
     3001                             input v-fmtcli-full-addres
     3002                           , input v-fmtcli-addres
     3003                           , input ", ":U
     3004                           , input 0
     3005                           , output v-fmtcli-full-addres
     3006                       ).
     3007                   end.
     3008                   run fmtcli-concatenate-strings in this-procedure (
     3009                         input substring( buf_firm.post-addr1, 1, 50 )
     3010                       , input buf_firm.post-addr2
     3011                       , input " ":U
     3012                       , input 50
     3013                       , output v-fmtcli-post-addres
     3014                   ).
     3015                   run fmtcli-concatenate-strings in this-procedure (
     3016                         input v-fmtcli-post-addres
     3017                       , input substring( buf_firm.post-addr1, 51, 50 )
     3018                       , input " ":U
     3019                       , input 50
     3020                       , output v-fmtcli-post-addres
     3021                   ).
     3022                   run fmtcli-concatenate-strings in this-procedure (
     3023                         input v-fmtcli-post-addres
     3024                       , input substring( buf_firm.post-addr1, 101, 50 )
     3025                       , input " ":U
     3026                       , input 50
     3027                       , output v-fmtcli-post-addres
     3028                   ).
     3029                   assign
     3030                       v-fmtcli-phone         = buf_firm.phone
     3031                       v-fmtcli-inn           = buf_firm.inn
     3032                       v-fmtcli-kpp           = buf_firm.kpp
     3033                       v-fmtcli-okpo          = buf_firm.okpo
     3034                       v-fmtcli-index         = string( buf_firm.ind )
     3035                   .
     3036               end.
     3037          end.
     3038          when 'маг':U
     3039          then do:
     3040               find first buf_shop no-lock
     3041                    where buf_shop.obj-code = buf_clients.obj-code
     3042               .
     3043               if available buf_shop
     3044               then do:
     3045                   run fmtcli-concatenate-strings in this-procedure (
     3046                         input buf_shop.addres1
     3047                       , input buf_shop.addres2
     3048                       , input " ":U
     3049                       , input 50
     3050                       , output v-fmtcli-addres
     3051                   ).
     3052                   assign
     3053                       v-fmtcli-full-addres = v-fmtcli-addres
     3054                       v-fmtcli-post-addres = v-fmtcli-addres
     3055                       v-fmtcli-phone       = buf_shop.phone
     3056                       v-fmtcli-inn         = "":U
     3057                       v-fmtcli-kpp         = "":U
     3058                       v-fmtcli-okpo        = "":U
     3059                       v-fmtcli-city        = "":U
     3060                       v-fmtcli-index       = "":U
     3061                   .
     3062               end.
     3063          end.
     3064          when 'скл':U
     3065          then do:
     3066               find first buf_store no-lock
     3067                    where buf_store.obj-code = buf_clients.obj-code
     3068               .
     3069               if available buf_store
     3070               then do:
     3071                   run fmtcli-concatenate-strings in this-procedure (
     3072                         input buf_store.addres1
     3073                       , input buf_store.addres2
     3074                       , input " ":U
     3075                       , input 50
     3076                       , output v-fmtcli-addres
     3077                   ).
     3078                   assign
     3079                       v-fmtcli-full-addres = v-fmtcli-addres
     3080                       v-fmtcli-phone       = buf_store.phone
     3081                       v-fmtcli-inn         = "":U
     3082                       v-fmtcli-kpp         = "":U
     3083                       v-fmtcli-okpo        = "":U
     3084                       v-fmtcli-city        = "":U
     3085                       v-fmtcli-index       = "":U
     3086                   .
     3087               end.
     3088          end.
     3089          when 'чел':U
     3090          then do:
     3091               find first buf_person no-lock
     3092                    where buf_person.psn-code = buf_clients.obj-code
     3093               .
     3094               if available buf_person
     3095               then do:
     3096                   run fmtcli-concatenate-strings in this-procedure (
     3097                         input ( if buf_person.ind = 0 or buf_person.ind = ?
     3098                                 then "":U
     3099                                 else string( buf_person.ind, "999999")
     3100                                 )
     3101                       , input buf_person.city
     3102                       , input ", ":U
     3103                       , input 0
     3104                       , output v-fmtcli-full-addres
     3105                   ).
     3106                   assign
     3107                       v-fmtcli-addres = buf_person.address
     3108                   .
     3109                   run fmtcli-concatenate-strings in this-procedure (
     3110                         input v-fmtcli-full-addres
     3111                       , input v-fmtcli-addres
     3112                       , input ", ":U
     3113                       , input 0
     3114                       , output v-fmtcli-full-addres
     3115                   ).
     3116                   assign
     3117                       v-fmtcli-phone     = buf_person.phone1
     3118                       v-fmtcli-inn       = buf_person.inn
     3119                       v-fmtcli-kpp       = buf_person.kpp
     3120                       v-fmtcli-okpo      = buf_person.okpo
     3121                       v-fmtcli-city      = buf_person.city
     3122                       v-fmtcli-index     = string( buf_person.ind )
     3123                   .
     3124               end.
     3125          end.
     3126       end case.
     3127   end.
     3128   end procedure.
     3129   procedure fmtcli-concatenate-strings :
     3130   define input parameter p-string-1       as character        no-undo.
     3131   define input parameter p-string-2       as character        no-undo.
     3132   define input parameter p-delimiter      as character        no-undo.
     3133   define input parameter p-length         as integer          no-undo.
     3134   define output parameter p-out-string    as character        no-undo.
     3135   do
     3136   on error undo, return error
     3137   :
     3138       assign
     3139           p-out-string = ( if p-string-1 = ?
     3140                            then "":U
     3141                            else trim( p-string-1 ) )
     3142       .
     3143       assign
     3144           p-out-string = p-out-string
     3145                        + ( if p-out-string = "":U
     3146                            or length( p-out-string ) = p-length
     3147                            or p-string-2 = ?
     3148                            or trim( p-string-2 ) = "":U
     3149                            then "":U
     3150                            else p-delimiter )
     3151                        + ( if p-string-2 = ?
     3152                            or trim( p-string-2 ) = "":U
     3153                            then "":U
     3154                            else trim( p-string-2 ) )
     3155       .
     3156   end.
     3157   end procedure.
     3158   define variable v-nn3 as integer no-undo .
     3159   define variable Jv    as integer no-undo .
     3160   v-nn3 = NUM-ENTRIES(custom-par).
     3161   REPEAT Jv = 1 to v-nn3:
     3162       if CAPS(trim(Entry(Jv,custom-par))) begins "X-DATE-START"      then  X-DATE-START  = date(Entry(2,Entry(Jv,custom-par ),"="))  .
     3163       if CAPS(trim(Entry(Jv,custom-par))) begins "X-DATE-END"        then  X-DATE-END    = date(Entry(2,Entry(Jv,custom-par ),"=")) .
     3164       if CAPS(trim(Entry(Jv,custom-par))) begins "X-SHIFT-START"     then  X-Shift-Start = int(Entry(2,Entry(Jv,custom-par ),"=")) .
     3165       if CAPS(trim(Entry(Jv,custom-par))) begins "X-SHIFT-END"       then  X-Shift-End   = int(Entry(2,Entry(Jv,custom-par ),"=")) .
     3166   End.
     3167   define            variable line                      as character no-undo .
     3168   define            variable rep-shift-store-name      as character no-undo.
     3169   define            variable rep-shift-for-mng         as character no-undo format "X(30)":U .
     3170   define            variable rep-shift-for-mng1        as character no-undo format "X(30)":U .
     3171   define            variable rep-shift-for-mng2        as character no-undo format "X(30)":U .
     3172   define            variable rep-shift-for-mng-next    as character no-undo format "X(30)":U .
