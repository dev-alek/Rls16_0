     1313   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1314   define variable v-waitfram-action01         as character   no-undo .
     1315   define variable v-waitfram-action02         as character   no-undo .
     1316   define variable v-waitfram-action03         as character   no-undo .
     1317   define variable mWaitFramTextBeg            as character   no-undo.
     1318   define variable mWaitFramTextEnd            as character   no-undo.
     1319   define variable mWaitFramView               as logical     no-undo.
     1320   define variable mWaitProcEvent              as logical     no-undo init yes.
     1321   define variable mWaitFramInterval           as integer     no-undo init 1 .
     1322   define variable mWaitFramStop               as logical     no-undo.
     1323   define variable mWaitFramStopUser           as logical     no-undo.
     1324   define variable mWaitFramStopTimeOut        as logical     no-undo.
     1325   define variable mWaitFramStartProc          as datetime-tz no-undo.
     1326   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     1327   define button B-WaitFramStop auto-end-key
     1328        label "Стоп"
     1329        size 10 by 1 tooltip "Остоновить процесс".
     1330   define button B-viewProcInfo
     1331        label "Информация"
     1332        size 15 by 1 tooltip "Информация о процесс".
     1333   define frame waitfram
     1334     v-waitfram-action01 format "x(72)" no-label skip
     1335     v-waitfram-action02 format "x(72)" no-label skip
     1336     v-waitfram-action03 format "x(72)" no-label skip
     1337     B-viewProcInfo
     1338     B-WaitFramStop at row 4 col 30
     1339     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1340     .
     1341   define new global shared variable mBatchMode as logical no-undo init ?.
     1342   define variable mFramBachModHandle as handle no-undo.
     1343   mFramBachModHandle = frame waitfram:handle.
     1344   define variable mFameOldVis as logical no-undo.
     1345   define variable mVisCUrentVin as logical no-undo.
     1346   if session:batch-mode
     1347   then
     1348      mBatchMode = yes.
     1349   if mBatchMode = ? then do:
     1350     mVisCUrentVin = current-window:visible.
     1351     mFameOldVis = mFramBachModHandle:visible.
     1352     mFramBachModHandle:visible  = yes.
     1353     mBatchMode = mFramBachModHandle:visible ne yes.
     1354     mFramBachModHandle:visible = mFameOldVis.
     1355     current-window:visible = mVisCUrentVin.
     1356   end.
     1357    if  log-manager:logfile-name ne ?
     1358     then DO:
     1359         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1360         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1361         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1362     end.
     1363   on choose of B-WaitFramStop in frame waitfram
     1364   do:
     1365     mWaitFramStop = yes.
     1366     mWaitFramStopUser = yes.
     1367   end.
     1368   function waitfram-check-timeout returns logical():
     1369      define variable vtime as int64 no-undo.
     1370      if mWaitFramStopTimeOut
     1371      then
     1372         return yes.
     1373      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1374      if     mWaitFramTimeOut ne ?
     1375         and mWaitFramTimeOut ne 0
     1376         and mWaitFramTimeOut lt vtime
     1377      then do:
     1378         mWaitFramStopTimeOut = yes.
     1379      end.
     1380      return mWaitFramStopTimeOut.
     1381   end.
     1382   procedure waitfram-hide :
     1383     if not session:batch-mode
     1384     then do
     1385     on error undo, return error return-value
     1386     :
     1387       pause 0 before-hide .
     1388       if not mBatchMode then
     1389         hide frame waitfram .
     1390     if     not mWaitFramView
     1391        and mWaitProcEvent
     1392     then
     1393       process events .
     1394     end.
     1395   end procedure.
     1396   procedure waitfram-show :
     1397     define input  parameter p-message as character no-undo .
     1398     define variable v-left-margin as integer   no-undo .
     1399     if not session:batch-mode
     1400     then do
     1401     on error undo, return error return-value
     1402     :
     1403       if length(p-message) <= 70 then do:
     1404         assign
     1405           v-left-margin = integer((70 - length(p-message)) / 2)
     1406         .
     1407         assign
     1408           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1409         .
     1410         assign
     1411           v-waitfram-action01 = " "
     1412           v-waitfram-action02 = " "
     1413                                    + fill(" ", v-left-margin)
     1414                                    + p-message
     1415           v-waitfram-action03 = " "
     1416         .
     1417       end.
     1418       else do:
     1419         define variable vRindex1 as integer no-undo.
     1420         define variable vRindex2 as integer no-undo.
     1421         vRindex1 = r-index(p-message," ",70).
     1422         if vRindex1 = 0
     1423         then
     1424            vRindex1 = 70.
     1425         if length(p-message)  <= vRindex1 + 70 then do:
     1426           assign
     1427             v-waitfram-action01 = " "
     1428             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1429             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1430           .
     1431         end.
     1432         else do:
     1433           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1434           if vRindex2 <= vRindex1
     1435           then
     1436              vRindex2 = vRindex1 + 70.
     1437           assign
     1438             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1439             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1440             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1441           .
     1442         end.
     1443       end.
     1444       B-viewProcInfo:visible   in frame waitfram = no.
     1445       B-viewProcInfo:sensitive in frame waitfram = no.
     1446       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1447       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1448       if  (   mWaitFramView
     1449          or  mWaitProcEvent)
     1450          and not mBatchMode
     1451       then
     1452          display
     1453             v-waitfram-action01 skip
     1454             v-waitfram-action02 skip
     1455             v-waitfram-action03 skip
     1456          with frame waitfram .
     1457       if     mWaitFramView
     1458          then do:
     1459             if     mWaitFramInterval ne ?
     1460                and not mBatchMode
     1461             then
     1462                wait-for go of frame waitfram pause mWaitFramInterval.
     1463          end.
     1464          else
     1465             if     mWaitProcEvent
     1466                and not mBatchMode
     1467             then
     1468                process events .
     1469     end.
     1470   end procedure.
     1471      procedure waitfram-show-this:
     1472         define input  parameter iInterval as int64 no-undo.
     1473         define variable vtime as int64 no-undo.
     1474         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1475         mWaitFramInterval = iInterval.
     1476         run waitfram-show (substitute("&1&2 &3&4" ,
     1477                                       mWaitFramTextBeg ,
     1478                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1479                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1480                                       mWaitFramTextEnd
     1481                                      )
     1482                           ).
     1483      end.
     1484      procedure WaitFramRunPause:
     1485         define input  parameter iInterval as dec no-undo.
     1486         define variable vStart  as datetime-tz no-undo.
     1487         define variable vend    as datetime-tz no-undo.
     1488         define variable vint as int64 no-undo.
     1489         define variable vOk as logical no-undo.
     1490         vStart = now.
     1491         vend   = vStart.
     1492         publish "WaitFramPause" (iInterval,output vOk).
     1493         vend   =  now.
     1494         vint = vend - vStart.
     1495         vint = iInterval - vint / 1000.
     1496         if     not mWaitFramStop
     1497            and (   vint > 0
     1498                 or (    not vOk
     1499                     and iInterval eq ?
     1500                     )
     1501                 )
     1502         then
     1503            run waitfram-show-this (iInterval).
     1504         vend   =  now.
     1505         vint = vend - vStart.
     1506         vint = iInterval - vint / 1000.
     1507         if     not mWaitFramStop
     1508            and vint > 0
     1509         then do:
     1510            run gbl/pause.p (vint * 1000).
     1511         end.
     1512         if iInterval ne ?
     1513         then
     1514            publish "WaitFramStop".
     1515         waitfram-check-timeout().
     1516      end.
     1517      procedure WaitFramWaitFor:
     1518         define input  parameter iInterval as dec no-undo.
     1519         assign
     1520            mWaitFramStartProc   = now
     1521            mWaitFramStopUser    = no
     1522            mWaitFramStopTimeOut = no
     1523         .
     1524         block-wait:
     1525         do while not mWaitFramStop:
     1526            run WaitFramRunPause (iInterval).
     1527            if  waitfram-check-timeout()
     1528            then do:
     1529               leave block-wait.
     1530            end.
     1531         end.
     1532         run waitfram-hide.
     1533      end.
     1534   procedure waitfram-join :
     1535     define input  parameter p-line-1  as character no-undo .
     1536     define input  parameter p-line-2  as character no-undo .
     1537     define input  parameter p-line-3  as character no-undo .
     1538     define output parameter p-message as character no-undo .
     1539     do
     1540     on error undo, return error return-value
     1541     :
     1542       assign
     1543         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1544                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1545                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1546       .
     1547     end.
     1548   end procedure.
     1549   function waitfram-join-function returns character
     1550     (input p-line-1 as character
     1551     ,input p-line-2 as character
     1552     ,input p-line-3 as character
     1553     ).
     1554     define variable v-message as character no-undo .
     1555     run waitfram-join in this-procedure
     1556       (input  p-line-1
     1557       ,input  p-line-2
     1558       ,input  p-line-3
     1559       ,output v-message
     1560       ) .
     1561     return v-message .
     1562   end function .
