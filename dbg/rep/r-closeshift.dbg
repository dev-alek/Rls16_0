      102       then do:
      103         run vss-get-parameters in this-procedure
      104           (output v-vssrevis-parameters
      105           ).
      106         run logevent in v-vssrevis-logger
      107           (input vss-workfile
      108           ,input vss-revision
      109           ,input v-vssrevis-parameters
      110           ,input p-extra-paramters
      111           ).
      112       end.
      113     end.
