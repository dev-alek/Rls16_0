     3189   define            variable p-z-number-list           as character no-undo.
     3190   define            variable p-z-number-item           as character no-undo.
     3191   define            variable v-param_prt-z-no          as character no-undo.
     3192   define            variable v-param_shft-qty          as character no-undo.
     3193   define            variable v-param_data-type         as character no-undo.
     3194   define new shared variable v-rep-shift-open-date     like ub.shift-obj.open-date no-undo.
     3195   define new shared variable v-rep-shift-open-time     like ub.shift-obj.open-time no-undo.
     3196   define new shared variable v-rep-shift-close-date    like ub.shift-obj.close-date no-undo.
     3197   define new shared variable v-rep-shift-close-time    like ub.shift-obj.close-time no-undo.
     3198   define new shared variable v-rep-shift-close         like ub.shift-obj.close-time no-undo.
     3199   define            variable v-count                   as integer   initial 0 no-undo .
     3200   define            variable v-ii                      as integer   no-undo .
     3201   define            variable v-str2                    as character no-undo .
     3202   define            variable v-write-xml-error         as logical   no-undo .
     3203   define            variable v-obj-address             as character no-undo .
     3204   define            variable v-obj-phone               as character no-undo .
     3205   define            variable v-report-name-html-list   as character no-undo .
     3206   define            variable v-report-name-html-result as character no-undo .
     3207   define            variable v-report-result           as logical   no-undo .
     3208   define            variable rep-shift-rol-mng         as character no-undo .
     3209   define            variable rep-shift-rol-oper        as character no-undo .
     3210   define            variable rep-shift-rol-mng2        as character no-undo .
     3211   define            variable rep-shift-rol-oper2       as character no-undo .
     3212   define            variable rep-shift-rol-mng-next    as character no-undo .
     3213   define            variable v-param-code              as integer   no-undo .
     3214   define            variable tog-list                  as character no-undo .
     3215   define            variable tog-last                  as character no-undo .
     3216   define            VARIABLE v-param                   as LOGICAL   no-undo .
     3217   define            VARIABLE v-one-shift               as LOGICAL   no-undo .
     3218   define buffer next-shift-obj     for ub.shift-obj.
     3219   define buffer previous-shift-obj for ub.shift-obj.
     3220   define buffer buf_goods          for ub.goods.
     3221   define buffer buf_shift          for shiftt.
     3222   define stream Out-Stream.
     3223   define stream OutStr-html.
     3224   define variable v-sort-list  as character no-undo .
     3225   define variable v-param-type as character no-undo .
     3226   define variable v-tth        as handle    no-undo .
     3227   run adm/shattri.p (
     3228       input "get":U
     3229       ,input  ''
     3230       ,input  0
     3231       ,input  'report-glob':U
     3232       ,input  'rep-shift-format':U
     3233       ,output v-sort-list
     3234       ,output v-value-date
     3235       ,output v-value-decimal
     3236       ,output v-param-code
     3237       ,output v-value-logical
     3238       ,output v-param-type
     3239       ,INPUT-OUTPUT table-handle v-tth
     3240       ) no-error .
     3241   if error-status:error then
     3242   do:
     3243       delete object v-tth.
     3244       message
     3245           "Не найден или незаполнен параметр - Формат печати сменного отчета"
     3246           view-as alert-box error .
     3247       return .
     3248   end.
     3249   x-tog-shift = true .
     3250   find first ub.clients no-lock where ub.clients.obj-code = p-obj-code and
     3251       ub.clients.obj-type = p-obj-type no-error .
     3252   if available (ub.clients) then
     3253   do:
     3254       CREATE obj-list.
     3255       Buffer-copy ub.clients TO obj-list.
     3256   end.
     3257   if tog-1 = true then
     3258   do:
     3259       tog-list = "tog-1".
     3260   end.
     3261   if tog-2 = true then
     3262   do:
     3263       tog-list = tog-list + ',' + "tog-2".
     3264   end.
     3265   if tog-3 = true then
     3266   do:
     3267       tog-list = tog-list + ',' + "tog-3".
     3268   end.
     3269   if tog-4 = true then
     3270   do:
     3271       tog-list = tog-list + ',' + "tog-4".
     3272   end.
     3273   if tog-5 = true then
     3274   do:
     3275       tog-list = tog-list + ',' + "tog-5".
     3276   end.
     3277   if tog-5-1 = true then
     3278   do:
     3279       tog-list = tog-list + ',' + "tog-5-1".
     3280   end.
     3281   if tog-7 = true then
     3282   do:
     3283       tog-list = tog-list + ',' + "tog-7".
     3284   end.
     3285   if tog-81 = true then
     3286   do:
     3287       tog-list = tog-list + ',' + "tog-81".
     3288   end.
     3289   if tog-9 = true then
     3290   do:
     3291       tog-list = tog-list + ',' + "tog-9".
     3292   end.
     3293   if tog-10 = true then
     3294   do:
     3295       tog-list = tog-list + ',' + "tog-10".
     3296   end.
     3297   if tog-list <> "" then
     3298   do:
     3299       tog-last = entry(num-entries(tog-list),tog-list).
     3300   end.
     3301   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3302     run mainmenu_getcntxt in parparentproc
     3303       (output v-cntxt-db-num
     3304       ,output v-cntxt-userid
     3305       ,output v-cntxt-level
     3306       ,output v-cntxt-host-code-obj
     3307       ,output v-cntxt-obj-type
     3308       ,output v-cntxt-obj-code
     3309       ,output v-cntxt-db-num-obj
     3310       ,output v-cntxt-is-admin
     3311       ) .
     3312   FIND FIRST ub.clients No-LOCK
     3313       WHERE ub.clients.obj-type = p-obj-type
     3314       AND ub.clients.obj-code = p-obj-code
     3315       No-ERROR.
     3316   assign
     3317       rep-shift-store-name = if available ub.clients
     3318                then ub.clients.obj-name
     3319                else (p-obj-type + string(p-obj-code))
     3320       .
     3321   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3322   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostname in g#library
     3323     (input  p-obj-type
     3324     ,input  p-obj-code
     3325     ,output v-host-code
     3326     ,output v-host-name
     3327     )  .
     3328   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3329   empty temp-table thbjattr_thbj-attr.
     3330   run adm/shattri.p (
     3331      input "get":U
     3332     ,input p-obj-type
     3333     ,input p-obj-code
     3334     ,input 'report-obj':U
     3335     ,input  ""
     3336     ,output v-value-character
     3337     ,output v-value-date
     3338     ,output v-value-decimal
     3339     ,output v-value-integer
     3340     ,output v-value-logical
     3341     ,output par-type
     3342     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     3343     ) no-error .
     3344   for each thbjattr_thbj-attr :
     3345       if thbjattr_thbj-attr.prop-code = 'prt-z-no'  then v-param_prt-z-no = string(thbjattr_thbj-attr.property-value-logical) .
     3346   end.
     3347   v-param_shft-qty = "state" .
     3348   define temp-table temp-shift-obj no-undo like ub.shift-obj
     3349       FIELD num as integer
     3350       INDEX ii IS UNIQUE num
     3351       .
     3352   RUN fmtcli-get-client IN THIS-PROCEDURE ( INPUT  p-obj-type
     3353       , INPUT  p-obj-code
     3354       ) .
     3355   assign
     3356       v-obj-address = ( if v-fmtcli-index <> '':U then ( v-fmtcli-index ) else '':U )
     3357                               + ( if v-fmtcli-full-addres <> '':U then ( v-fmtcli-full-addres ) else '':U )
     3358       v-obj-phone   = ( if v-fmtcli-phone <> '':U then v-fmtcli-phone else '':U )
     3359       .
     3360   for each ub.shift-obj  no-lock
     3361       where ub.shift-obj.obj-code   =  p-obj-code
     3362       and ub.shift-obj.obj-type   =  p-obj-type
     3363       and ub.shift-obj.shift-date >= X-date-Start
     3364       and ub.shift-obj.shift-date <= X-date-End
     3365       :
     3366       if ub.shift-obj.shift-date = X-date-Start and ub.shift-obj.shift-num < X-Shift-Start then next .
     3367       if ub.shift-obj.shift-date = X-date-End   and ub.shift-obj.shift-num > X-Shift-End then next .
     3368       create temp-shift-obj .
     3369       assign
     3370           v-count = v-count + 1 .
     3371       assign
     3372           temp-shift-obj.num = v-count .
     3373       buffer-copy ub.shift-obj to temp-shift-obj .
     3374       find first buf_shift where
     3375           buf_shift.obj-type = p-obj-type
     3376           and buf_shift.obj-code = p-obj-code
     3377           and buf_shift.shift-date = x-date-end
     3378           and buf_shift.shift-num = x-shift-end no-error.
     3379       if not available buf_shift then
     3380       do:
     3381           create buf_shift.
     3382           assign
     3383               buf_shift.obj-type    = p-obj-type
     3384               buf_shift.obj-code    = p-obj-code
     3385               buf_shift.shift-date  = ub.shift-obj.shift-date
     3386               buf_shift.shift-num   = ub.shift-obj.shift-num
     3387               buf_shift.db-num      = ub.clients.db-num
     3388               buf_shift.obj-name    = ub.clients.obj-name
     3389               buf_shift.obj-address = v-obj-address
     3390               buf_shift.obj-phone   = v-obj-phone
     3391               buf_shift.db-num      = ub.clients.db-num
     3392               buf_shift.shift-name  = ub.shift-obj.shift-name
     3393               buf_shift.base-code   = p-base-code
     3394               buf_shift.curr-abbr   = p-curr-abbr
     3395               .
     3396           release buf_shift.
     3397       end.
     3398       FOR EACH ub.shift-staff No-LOCK WHERE
     3399           ub.shift-staff.obj-type   = p-obj-type AND
     3400           ub.shift-staff.obj-code   = p-obj-code AND
     3401           ub.shift-staff.shift-date = ub.shift-obj.shift-date AND
     3402           ub.shift-staff.shift-num  = ub.shift-obj.shift-num AND
     3403           ub.shift-staff.next-shift = no AND
     3404           ub.shift-staff.staff-role = no and
     3405           ub.shift-staff.psn-num    >= 0 :
     3406           if lookup( chr(32) + ub.shift-staff.name, rep-shift-for-opers ) = 0 then
     3407           do:
     3408               assign
