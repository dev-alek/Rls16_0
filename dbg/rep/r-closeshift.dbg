     4165   procedure first-line-tog1-html :
     4166       define input parameter v-report-name-html     as character no-undo .
     4167       define buffer bf_shift-obj     for ub.shift-obj .
     4168       define buffer buf_usser-account for ub.user-account .
     4169       if v-param-code = 3 then
     4170       do:
     4171           find first bf_shift-obj no-lock where bf_shift-obj.shift-date = X-Date-Start and bf_shift-obj.Shift-num = X-Shift-Start no-error .
     4172           if not available (bf_shift-obj) then return error.
     4173           find first buf_usser-account no-lock where buf_usser-account.user-id = bf_shift-obj.close-id no-error .
     4174           if not available (buf_usser-account) then return error .
     4175           output stream OutStr-html to value(v-report-name-html) convert target 'UTF-8' .
     4176           put stream OutStr-html unformatted
     4177               substitute(
     4178               '<!doctype html>
     4179               <html>
     4180                 <head>
     4181                 <meta charset="UTF-8">
     4182                     <!-- Стили документа -->
     4183                 <style>
     4184                      table ~{
     4185                          border-collapse: collapse;
     4186                          width: 1400px; 
     4187                      ~}
