      659   define new shared stream PrnLibStream.
      660   procedure prn-lib-prn-file :
      661     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      662     define input parameter p-DIsabledoptions as integer no-undo .
      663     define variable v-report-name as character no-undo .
      664     define variable v-user-action as character no-undo .
      665     define variable v-printed     as logical   no-undo .
      666     define variable v-exist       as logical   no-undo .
      667     do
      668       on error undo, return error
      669       :
      670       run prn-lib-get-report-name  in this-procedure (
      671         input parParentProc
      672         ,output v-report-name
      673         ).
      674   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      675   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      676     (input  v-report-name
      677     ,input  2
      678     ,output v-exist
      679     )  .
      680       if NOT v-exist then
      681       DO:
      682         Message
      683           "Нет заданий на печать ! "
      684           view-as alert-box .
      685         Return  .
      686       End.
      687       run gbl/prnfilen.w
      688         (input  ""
      689         ,input  p-DisabledOptions
      690         ,input  string(v-report-name )
      691         ,input  7
      692         ,output v-user-action
      693         ,output v-printed
      694         ) .
      695       if v-printed then
      696       do:
      697         return "YES" .
      698       end.
      699       else
      700       do:
      701         return "NO" .
      702       end.
      703     end.
      704   end procedure.
      705   procedure prn-lib-open-stream :
      706     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      707     define input parameter p-page-size    as integer no-undo .
      708     define input parameter p-is-stream    as logical no-undo .
      709     define input parameter p-append       as logical no-undo .
      710     define variable v-report-name as character no-undo .
      711     do
      712       on error undo, return error
      713       :
      714       run prn-lib-get-report-name  in this-procedure (
      715         input parParentProc
      716         ,output v-report-name
      717         ).
      718       if p-is-stream then
      719       do:
      720         if p-append then
      721         do:
      722           output stream PrnLibStream to value( v-report-name )
      723             page-size value(p-page-size) append .
      724         end.
      725         if not p-append then
      726         do:
      727           output stream PrnLibStream to value( v-report-name )
      728             page-size value(p-page-size) .
      729         end.
      730       end.
      731       if not p-is-stream then
      732       do:
      733         if p-append then
      734         do:
      735           output to value( v-report-name )
      736             page-size value(p-page-size) append .
      737         end.
      738         if not p-append then
      739         do:
      740           output to value( v-report-name )
      741             page-size value(p-page-size) .
      742         end.
      743       end.
      744     end.
      745   end procedure.
      746   procedure prn-lib-open-exp :
      747     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      748     define input parameter p-is-stream    as logical no-undo .
      749     define input parameter p-is-append    as logical no-undo .
      750     define output parameter p-ReportFileName as char init "report" no-undo.
      751     define output parameter p-process as logical no-undo .
      752     define variable glog as logical no-undo .
      753     do
      754       on error undo, return error
      755       :
      756       SYSTEM-DIALOG GET-FILE p-ReportFileName
      757         TITLE      "Укажите путь"
      758         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      759         ASK-OVERWRITE
      760         CREATE-TEST-FILE
      761         SAVE-AS
      762         USE-FILENAME
      763         DEFAULT-EXTENSION "txt"
      764         UPDATE glog
      765         .
      766       if not glog then  return.
      767       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      768       if p-is-stream then
      769       do:
      770         if p-is-append then
      771         do:
      772           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      773         end.
      774         else
      775         do:
      776           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      777         end.
      778       end.
      779       else
      780       do:
      781         if p-is-append then
      782         do:
      783           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      784         end.
      785         else
      786         do:
      787           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      788         end.
      789       end.
      790       p-process = yes.
      791     end.
      792   end procedure.
      793   procedure prn-lib-get-report-name :
      794     define input parameter parParentProc  as widget-handle no-undo.
      795     define output parameter p-report-name as character no-undo .
      796     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      797   end procedure.
      798   procedure prn-lib-reportviewer-report-name :
      799     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      800     define input parameter p-report-name-html as character no-undo .
      801     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      802   end procedure.
      803   procedure prn-lib-reportviewer :
      804     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      805     define input parameter p-report-name-html as character no-undo .
      806     define input parameter p-param        as character no-undo .
      807     define variable v-excel           as character no-undo init 'TRUE' .
      808     define variable v-value-character as character no-undo .
      809     define variable v-value-integer   as character no-undo .
      810     define variable v-value-date      as date      no-undo .
      811     define variable v-value-decimal   as decimal   no-undo .
      812     define variable rep-excel         as logical   no-undo .
      813     define variable excel-string      as character no-undo .
      814     define variable v-param-type      as character no-undo .
      815     define variable v-tth             as handle    no-undo .
      816     run adm/shattri.p (
      817       input "get":U
      818       ,input  ""
      819       ,input  0
      820       ,input  'report-glob':U
      821       ,input  'rep-excel':U
      822       ,output v-value-character
      823       ,output v-value-date
      824       ,output v-value-decimal
      825       ,output v-value-integer
      826       ,output rep-excel
      827       ,output v-param-type
      828       ,INPUT-OUTPUT table-handle v-tth
      829       )  .
      830     if rep-excel then v-excel = "TRUE" .
      831     else v-excel = "FALSE" .
      832     if p-param eq ""
      833     then
      834        p-param = "EXCEL:" + v-excel.
      835     else
      836        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      837     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      838   end procedure.
