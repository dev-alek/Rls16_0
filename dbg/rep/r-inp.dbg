     4881       bfs_tt-allsum.sum-dsc-rubl-cur    =  - bf_tt-allsum.sum-dsc-rubl-cur
     4882       bfs_tt-allsum.dsc-base-cur        =  - bf_tt-allsum.dsc-base-cur
