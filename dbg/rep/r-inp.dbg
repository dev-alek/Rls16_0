     6713               "Инвойс       : " at 40 format "x(15)" ( if buf_trn-doc.inv-num = "" then "   " else buf_trn-doc.inv-num ) format "x(20)"
     6714               "Курс    : " format "x(12)" space(3) Rubl_Coeff format ">>>,>>9.9999" skip(1) .
