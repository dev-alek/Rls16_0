     1286                   v-torgconf-outexlst  = yes
     1287               .
     1288           end.
     1289        assign
     1290         v-name = p-form-name.
     1291   end.
     1292   end.
     1293   end procedure.
     1294   procedure torgconf-get-self-param :
     1295   define input parameter p-obj-type           as character        no-undo.
     1296   define input parameter p-obj-code           as integer          no-undo.
     1297   define input parameter p-curr-code          as integer          no-undo.
     1298       define variable v-host-code    as integer      no-undo.
     1299       define variable v-par-type     as character    no-undo.
     1300   do
     1301   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message(1))
     1302   :
     1303   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1304   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1305     (input  p-obj-type
     1306     ,input  p-obj-code
     1307     ,output v-host-code
     1308     )  .
     1309       if v-torgconf-outhold = yes
     1310       then do:
     1311           run torgconf-get-holdfirm-code in this-procedure (
     1312                 input p-obj-type
     1313               , input p-obj-code
     1314               , output v-torgconf-self-host-code
     1315           ).
     1316           if v-torgconf-self-host-code = 0
     1317           then do:
     1318               return error.
     1319           end.
     1320       end.
     1321       else do:
     1322           assign
     1323               v-torgconf-self-host-code = v-host-code
     1324           .
     1325       end.
     1326       if v-torgconf-self-host-code = 0
     1327       then do:
     1328           assign
     1329               v-torgconf-self-host-name           = "":U
     1330               v-torgconf-self-host-addres         = "":U
     1331               v-torgconf-self-host-post-addres    = "":U
     1332               v-torgconf-self-host-phone          = "":U
     1333               v-torgconf-self-host-inn            = "":U
