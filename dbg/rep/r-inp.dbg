     5002       .
     5003     assign
     5004       bfspc_tt-allsum.fact-qnty           = bfs_tt-allsum.fact-qnty
     5005       bfspc_tt-allsum.cli-qnty            = bfs_tt-allsum.cli-qnty
     5006       bfspc_tt-allsum.sum-dsc-base-doc    = bfs_tt-allsum.sum-dsc-base-doc    - bfs_tt-allsum.sum-dsc-base-acc
     5007       bfspc_tt-allsum.sum-dsc-rubl-doc    = bfs_tt-allsum.sum-dsc-rubl-doc    - bfs_tt-allsum.sum-dsc-rubl-acc
     5008       bfspc_tt-allsum.dsc-base-doc        = bfs_tt-allsum.dsc-base-doc        - bfs_tt-allsum.dsc-base-acc
     5009       bfspc_tt-allsum.dsc-rubl-doc        = bfs_tt-allsum.dsc-rubl-doc        - bfs_tt-allsum.dsc-rubl-acc
     5010       bfspc_tt-allsum.vat-base-doc        = bfs_tt-allsum.vat-base-doc
