     5529       end.
     5530       find first bf_sysconf where bf_sysconf.host-code = bf_trn-doc.host-code no-lock.
     5531       assign
     5532         varcur-cons-vat-pc = bf_sysconf.cons-vat-pc.
     5533       if varcur-cons-vat-pc = ? then do:
     5534         return error substitute ("Нет текущего продажного консигнационного НДС по фирме &1", bf_trn-doc.host-code).
     5535       end.
     5536       define buffer buf_tt-clcparts for tt-clcparts .
     5537       for each buf_tt-clcparts
     5538       on error undo, return error return-value
     5539       :
     5540         delete buf_tt-clcparts.
     5541       end.
     5542       for each bf_parts no-lock
     5543         where bf_parts.out-code  = bf_doc-line.doc-code
     5544           and bf_parts.obj-type  = bf_doc-line.obj-type
     5545           and bf_parts.obj-code  = bf_doc-line.obj-code
     5546           and bf_parts.artic     = bf_doc-line.artic
     5547           and bf_parts.prod-type = bf_doc-line.prod-type
     5548           and bf_parts.prod-code = bf_doc-line.prod-code
     5549       on error undo, return error return-value
     5550       :
     5551         create buf_tt-clcparts .
     5552         buffer-copy bf_parts to buf_tt-clcparts .
     5553         if v-calcbypart = yes   then do:
     5554   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run partbcod in g#library
     5555     (buffer bf_parts
     5556     ,output v-b-pcode
     5557     ) no-error .
     5558   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5559   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     5560     (input  bf_parts.obj-type
     5561     ,input  bf_parts.obj-code
     5562     ,input  v-b-pcode
     5563     ,input  0
     5564     ,input  bf_trn-doc.fact-order
     5565     ,output vardoc-num
     5566     ,output varprice-salef
     5567     ,output varroad-tax
     5568     ,output varexcise
     5569     ) no-error .
     5570             if varprice-sale = ?
     5571             then do:
     5572               assign
     5573                 varprice-salef = 0
     5574                 varroad-tax   = 0
     5575                 varexcise     = 0
     5576               .
     5577             end.
     5578             assign
     5579             part-cur-base  = varprice-salef
     5580             part-cur-road-tax  = varroad-tax
     5581             part-cur-excise = varexcise.
     5582         end.
     5583       end.
     5584       run clcprtsl_calc-ttable in this-procedure
     5585         (input yes,
     5586          input yes,
     5587          input bf_doc-line.road-tax,
     5588          input bf_doc-line.excise,
     5589          input bf_doc-line.vat-pc,
     5590          input bf_doc-line.cons-vat-pc,
     5591          input bf_doc-line.slt-pc,
     5592          input bf_trn-doc.base-rate,
     5593          input bf_trn-doc.base-scale,
     5594          input varr-b,
     5595          input varcur-base,
     5596          input varcur-road-tax,
     5597          input varcur-excise,
     5598          input varcur-vat-pc,
     5599          input varcur-cons-vat-pc,
     5600          input varcur-slt-pc
     5601          ) no-error.
     5602       if error-status:error then do:
     5603         message
     5604           vss-workfile vss-revision vss-description skip
     5605           "Ошибка при вызове процедуры clcprtsl_calc-ttable." skip
     5606           return-value skip
     5607           trim(error-status :get-message(1))
     5608           trim(error-status :get-message(2))
     5609           trim(error-status :get-message(3))
     5610           trim(error-status :get-message(4))
     5611           trim(error-status :get-message(5)) skip
     5612           view-as alert-box error.
     5613         undo, return error .
     5614       end.
     5615     end.
     5616   end.
     5617   end.
     5618   procedure clcprtsl_calc-ttable :
     5619   define input parameter paris-doc           as   logical                 no-undo.
     5620   define input parameter paris-cur           as   logical                 no-undo.
     5621   define input parameter parroad-tax         like ub.doc-line.road-tax    no-undo.
     5622   define input parameter parexcise           like ub.doc-line.excise      no-undo.
     5623   define input parameter parvat-pc           like ub.doc-line.vat-pc      no-undo.
     5624   define input parameter parcons-vat-pc      like ub.doc-line.cons-vat-pc no-undo.
     5625   define input parameter parslt-pc           like ub.doc-line.slt-pc      no-undo.
     5626   define input parameter parbase-rate        like ub.trn-doc.base-rate    no-undo.
     5627   define input parameter parbase-scale       like ub.trn-doc.base-scale   no-undo.
     5628   define input parameter parr-b              as   character               no-undo.
     5629   define input parameter parcur-base         like ub.gds-dtl.cur-base     no-undo.
     5630   define input parameter parcur-road-tax     like ub.doc-line.road-tax    no-undo.
     5631   define input parameter parcur-excise       like ub.doc-line.excise      no-undo.
     5632   define input parameter parcur-vat-pc       like ub.doc-line.vat-pc      no-undo.
     5633   define input parameter parcurcons-vat-pc   like ub.doc-line.cons-vat-pc no-undo.
     5634   define input parameter parcurslt-pc        like ub.doc-line.slt-pc      no-undo.
     5635   define buffer bf_tt-allsum      for tt-allsum.
     5636   define buffer bf_tt-clcparts    for tt-clcparts.
     5637   define buffer bf_tt-allsum-line for tt-allsum-line.
     5638   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     5639   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     5640   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     5641   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     5642   define variable varexcise          like ub.price-list.excise     no-undo.
     5643   do on error undo, return error return-value :
     5644   for each bf_tt-allsum-line
     5645   on error undo, return error return-value
     5646    :
     5647     delete bf_tt-allsum-line.
     5648   end.
     5649   for each bf_tt-allsum
     5650   on error undo, return error return-value
     5651   :
     5652     delete bf_tt-allsum.
     5653   end.
     5654   for each bf_tt-clcparts
     5655   on error undo, return error return-value
     5656   :
     5657   if v-calcbypart then do:
     5658             assign
     5659             parcur-base =   bf_tt-clcparts.part-cur-base
     5660             parcur-road-tax = bf_tt-clcparts.part-cur-road-tax
     5661             parcur-excise =   bf_tt-clcparts.part-cur-excise
     5662             .
     5663   end.
     5664      run clcprtsl_calc-parts in this-procedure (
     5665        input recid(bf_tt-clcparts),
     5666        input paris-doc,
     5667        input paris-cur,
     5668        input parroad-tax,
     5669        input parexcise,
     5670        input parvat-pc,
     5671        input parcons-vat-pc,
     5672        input parslt-pc,
     5673        input parbase-rate,
     5674        input parbase-scale,
     5675        input parr-b,
     5676        input parcur-base,
     5677        input parcur-road-tax,
     5678        input parcur-excise,
     5679        input parcur-vat-pc,
     5680        input parcurcons-vat-pc,
     5681        input parcurslt-pc
     5682        ) no-error.
     5683     if error-status:error then do:
     5684       message
     5685         vss-workfile vss-revision vss-description skip
     5686         vss-include-info15 skip
     5687         "Ошибка при обсчете партии" skip
     5688         "Документ партии " bf_tt-clcparts.out-code skip
     5689         "Товар" bf_tt-clcparts.artic bf_tt-clcparts.prod-type bf_tt-clcparts.prod-code skip
     5690         return-value skip
     5691         error-status:get-message(1) skip
     5692         error-status:get-message(2) skip
     5693         error-status:get-message(3) skip
     5694         view-as alert-box error .
     5695       undo, return error .
     5696     end.
     5697     for each bf_tt-allsum on error undo, return error return-value :
     5698       find first bf_tt-allsum-line where bf_tt-allsum-line.sum-type = bf_tt-allsum.sum-type no-error.
     5699       if not available bf_tt-allsum-line then do:
     5700         create bf_tt-allsum-line.
     5701         assign
     5702           bf_tt-allsum-line.sum-type = bf_tt-allsum.sum-type.
     5703       end.
     5704       assign
     5705         bf_tt-allsum-line.fact-qnty              = bf_tt-allsum-line.fact-qnty            + bf_tt-allsum.fact-qnty
     5706         bf_tt-allsum-line.cli-qnty               = bf_tt-allsum-line.cli-qnty             + bf_tt-allsum.cli-qnty
     5707         bf_tt-allsum-line.sum-dsc-base-doc       = bf_tt-allsum-line.sum-dsc-base-doc     + bf_tt-allsum.sum-dsc-base-doc
     5708         bf_tt-allsum-line.sum-dsc-rubl-doc       = bf_tt-allsum-line.sum-dsc-rubl-doc     + bf_tt-allsum.sum-dsc-rubl-doc
     5709         bf_tt-allsum-line.dsc-base-doc           = bf_tt-allsum-line.dsc-base-doc         + bf_tt-allsum.dsc-base-doc
     5710         bf_tt-allsum-line.dsc-rubl-doc           = bf_tt-allsum-line.dsc-rubl-doc         + bf_tt-allsum.dsc-rubl-doc
     5711         bf_tt-allsum-line.vat-base-doc           = bf_tt-allsum-line.vat-base-doc         + bf_tt-allsum.vat-base-doc
     5712         bf_tt-allsum-line.vat-rubl-doc           = bf_tt-allsum-line.vat-rubl-doc         + bf_tt-allsum.vat-rubl-doc
     5713         bf_tt-allsum-line.vat-base-buyer-doc     = bf_tt-allsum-line.vat-base-buyer-doc   + bf_tt-allsum.vat-base-buyer-doc
     5714         bf_tt-allsum-line.vat-rubl-buyer-doc     = bf_tt-allsum-line.vat-rubl-buyer-doc   + bf_tt-allsum.vat-rubl-buyer-doc
     5715         bf_tt-allsum-line.slt-base-doc           = bf_tt-allsum-line.slt-base-doc         + bf_tt-allsum.slt-base-doc
     5716         bf_tt-allsum-line.slt-rubl-doc           = bf_tt-allsum-line.slt-rubl-doc         + bf_tt-allsum.slt-rubl-doc
     5717         bf_tt-allsum-line.road-tax-base-doc      = bf_tt-allsum-line.road-tax-base-doc    + bf_tt-allsum.road-tax-base-doc
     5718         bf_tt-allsum-line.road-tax-rubl-doc      = bf_tt-allsum-line.road-tax-rubl-doc    + bf_tt-allsum.road-tax-rubl-doc
     5719         bf_tt-allsum-line.excise-base-doc        = bf_tt-allsum-line.excise-base-doc      + bf_tt-allsum.excise-base-doc
     5720         bf_tt-allsum-line.excise-rubl-doc        = bf_tt-allsum-line.excise-rubl-doc      + bf_tt-allsum.excise-rubl-doc
     5721         bf_tt-allsum-line.sum-dsc-base-cur       = bf_tt-allsum-line.sum-dsc-base-cur     + bf_tt-allsum.sum-dsc-base-cur
     5722         bf_tt-allsum-line.sum-dsc-rubl-cur       = bf_tt-allsum-line.sum-dsc-rubl-cur     + bf_tt-allsum.sum-dsc-rubl-cur
     5723         bf_tt-allsum-line.dsc-base-cur           = bf_tt-allsum-line.dsc-base-cur         + bf_tt-allsum.dsc-base-cur
     5724         bf_tt-allsum-line.dsc-rubl-cur           = bf_tt-allsum-line.dsc-rubl-cur         + bf_tt-allsum.dsc-rubl-cur
     5725         bf_tt-allsum-line.vat-base-cur           = bf_tt-allsum-line.vat-base-cur         + bf_tt-allsum.vat-base-cur
     5726         bf_tt-allsum-line.vat-rubl-cur           = bf_tt-allsum-line.vat-rubl-cur         + bf_tt-allsum.vat-rubl-cur
     5727         bf_tt-allsum-line.vat-base-buyer-cur     = bf_tt-allsum-line.vat-base-buyer-cur   + bf_tt-allsum.vat-base-buyer-cur
     5728         bf_tt-allsum-line.vat-rubl-buyer-cur     = bf_tt-allsum-line.vat-rubl-buyer-cur   + bf_tt-allsum.vat-rubl-buyer-cur
     5729         bf_tt-allsum-line.slt-base-cur           = bf_tt-allsum-line.slt-base-cur         + bf_tt-allsum.slt-base-cur
     5730         bf_tt-allsum-line.slt-rubl-cur           = bf_tt-allsum-line.slt-rubl-cur         + bf_tt-allsum.slt-rubl-cur
     5731         bf_tt-allsum-line.road-tax-base-cur      = bf_tt-allsum-line.road-tax-base-cur    + bf_tt-allsum.road-tax-base-cur
     5732         bf_tt-allsum-line.road-tax-rubl-cur      = bf_tt-allsum-line.road-tax-rubl-cur    + bf_tt-allsum.road-tax-rubl-cur
     5733         bf_tt-allsum-line.excise-base-cur        = bf_tt-allsum-line.excise-base-cur      + bf_tt-allsum.excise-base-cur
     5734         bf_tt-allsum-line.excise-rubl-cur        = bf_tt-allsum-line.excise-rubl-cur      + bf_tt-allsum.excise-rubl-cur
     5735         bf_tt-allsum-line.sum-dsc-base-acc       = bf_tt-allsum-line.sum-dsc-base-acc     + bf_tt-allsum.sum-dsc-base-acc
     5736         bf_tt-allsum-line.sum-dsc-rubl-acc       = bf_tt-allsum-line.sum-dsc-rubl-acc     + bf_tt-allsum.sum-dsc-rubl-acc
     5737         bf_tt-allsum-line.sum-dsc-cli-acc        = bf_tt-allsum-line.sum-dsc-cli-acc      + bf_tt-allsum.sum-dsc-cli-acc
     5738         bf_tt-allsum-line.dsc-base-acc           = bf_tt-allsum-line.dsc-base-acc         + bf_tt-allsum.dsc-base-acc
     5739         bf_tt-allsum-line.dsc-rubl-acc           = bf_tt-allsum-line.dsc-rubl-acc         + bf_tt-allsum.dsc-rubl-acc
     5740         bf_tt-allsum-line.dsc-cli-acc            = bf_tt-allsum-line.dsc-cli-acc          + bf_tt-allsum.dsc-cli-acc
     5741         bf_tt-allsum-line.vat-base-acc           = bf_tt-allsum-line.vat-base-acc         + bf_tt-allsum.vat-base-acc
     5742         bf_tt-allsum-line.vat-rubl-acc           = bf_tt-allsum-line.vat-rubl-acc         + bf_tt-allsum.vat-rubl-acc
     5743         bf_tt-allsum-line.vat-cli-acc            = bf_tt-allsum-line.vat-cli-acc          + bf_tt-allsum.vat-cli-acc
     5744         bf_tt-allsum-line.slt-base-acc           = bf_tt-allsum-line.slt-base-acc         + bf_tt-allsum.slt-base-acc
     5745         bf_tt-allsum-line.slt-rubl-acc           = bf_tt-allsum-line.slt-rubl-acc         + bf_tt-allsum.slt-rubl-acc
     5746         bf_tt-allsum-line.slt-cli-acc            = bf_tt-allsum-line.slt-cli-acc          + bf_tt-allsum.slt-cli-acc
     5747         bf_tt-allsum-line.road-tax-base-acc      = bf_tt-allsum-line.road-tax-base-acc    + bf_tt-allsum.road-tax-base-acc
     5748         bf_tt-allsum-line.road-tax-rubl-acc      = bf_tt-allsum-line.road-tax-rubl-acc    + bf_tt-allsum.road-tax-rubl-acc
     5749         bf_tt-allsum-line.road-tax-cli-acc       = bf_tt-allsum-line.road-tax-cli-acc     + bf_tt-allsum.road-tax-cli-acc
     5750         bf_tt-allsum-line.excise-base-acc        = bf_tt-allsum-line.excise-base-acc      + bf_tt-allsum.excise-base-acc
     5751         bf_tt-allsum-line.excise-rubl-acc        = bf_tt-allsum-line.excise-rubl-acc      + bf_tt-allsum.excise-rubl-acc
     5752         bf_tt-allsum-line.excise-cli-acc         = bf_tt-allsum-line.excise-cli-acc       + bf_tt-allsum.excise-cli-acc
     5753         bf_tt-allsum-line.transport-base-acc     = bf_tt-allsum-line.transport-base-acc   + bf_tt-allsum.transport-base-acc
     5754         bf_tt-allsum-line.transport-rubl-acc     = bf_tt-allsum-line.transport-rubl-acc   + bf_tt-allsum.transport-rubl-acc
     5755         bf_tt-allsum-line.transport-cli-acc      = bf_tt-allsum-line.transport-cli-acc    + bf_tt-allsum.transport-cli-acc
     5756         bf_tt-allsum-line.other-base-acc         = bf_tt-allsum-line.other-base-acc       + bf_tt-allsum.other-base-acc
     5757         bf_tt-allsum-line.other-rubl-acc         = bf_tt-allsum-line.other-rubl-acc       + bf_tt-allsum.other-rubl-acc
     5758         bf_tt-allsum-line.other-cli-acc          = bf_tt-allsum-line.other-cli-acc        + bf_tt-allsum.other-cli-acc
     5759         .
     5760     end.
     5761   end.
     5762   end.
     5763   end procedure.
     5764   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5765     define variable v-cntxt-db-num        as integer   no-undo .
     5766     define variable v-cntxt-userid        as character no-undo .
     5767     define variable v-cntxt-level         as character no-undo .
     5768     define variable v-cntxt-host-code-obj as integer   no-undo .
     5769     define variable v-cntxt-obj-type      as character no-undo .
     5770     define variable v-cntxt-obj-code      as integer   no-undo .
     5771     define variable v-cntxt-db-num-obj    as integer   no-undo .
     5772     define variable v-cntxt-is-admin      as logical   no-undo .
     5773   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5774   DEFINE temp-table temp-nalog no-undo
     5775     field   slt-prc          as  decimal
     5776     field   vat-prc          as  decimal
     5777     field   slt-sum          as  decimal
     5778     field   vat-sum          as  decimal
     5779     field   from-sum         as  decimal
     5780     INDEX pi  IS PRIMARY   vat-prc slt-prc
     5781   .
     5782   def var vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5783   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
     5784   procedure paramls-clear :
     5785     define buffer buf_temp-param for temp-param .
     5786     do
     5787     on error undo, return error return-value
     5788     :
     5789       for each buf_temp-param
     5790       on error undo, return error
     5791       :
     5792         delete buf_temp-param .
     5793       end.
     5794     end.
     5795   end procedure.
     5796   procedure paramls-write :
     5797     define input  parameter p-code     as character no-undo .
     5798     define input  parameter p-sub-code as character no-undo .
     5799     define input  parameter p-value    as character no-undo .
     5800     define buffer buf_temp-param for temp-param .
     5801     do
     5802     on error undo, return error return-value
     5803     :
     5804       find first buf_temp-param
     5805         where buf_temp-param.param-code     = p-code
     5806           and buf_temp-param.param-sub-code = p-sub-code
     5807         no-error .
     5808       if not available buf_temp-param then do:
     5809         create buf_temp-param .
     5810         assign
     5811           buf_temp-param.param-code     = p-code
     5812           buf_temp-param.param-sub-code = p-sub-code
     5813         .
     5814       end.
     5815       assign
     5816         buf_temp-param.param-value = p-value
     5817       .
     5818     end.
     5819   end procedure.
     5820   procedure paramls-read :
     5821     define input  parameter p-code          as character no-undo .
     5822     define input  parameter p-sub-code      as character no-undo .
     5823     define input  parameter p-default-value as character no-undo .
     5824     define output parameter p-value         as character no-undo .
     5825     define buffer buf_temp-param for temp-param .
     5826     do
     5827     on error undo, return error return-value
     5828     :
     5829       find first buf_temp-param
     5830         where buf_temp-param.param-code     = p-code
     5831           and buf_temp-param.param-sub-code = p-sub-code
     5832         no-error .
     5833       if available buf_temp-param then do:
     5834         assign
     5835           p-value = buf_temp-param.param-value
     5836         .
     5837       end.
     5838       else do:
     5839         assign
     5840           p-value = p-default-value
     5841         .
     5842       end.
     5843     end.
     5844   end procedure.
     5845   procedure paramls-append :
     5846     define input  parameter p-code     as character no-undo .
     5847     define input  parameter p-sub-code as character no-undo .
     5848     define input  parameter p-value    as character no-undo .
     5849     define buffer buf_temp-param for temp-param .
     5850     do
     5851     on error undo, return error return-value
     5852     :
     5853       find first buf_temp-param
     5854            where buf_temp-param.param-code     = p-code
     5855              and buf_temp-param.param-sub-code = p-sub-code
     5856         no-error .
     5857       if not available buf_temp-param then do:
     5858         create buf_temp-param .
     5859         assign
     5860           buf_temp-param.param-code     = p-code
     5861           buf_temp-param.param-sub-code = p-sub-code
     5862           buf_temp-param.param-value    = p-value
     5863         .
     5864       end.
     5865       else do:
     5866           assign
     5867               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
     5868           .
     5869       end.
     5870     end.
     5871   end procedure.
     5872   define variable g#report-num    as integer      no-undo.
     5873   define variable vss-include-info32 as character format "X(65)" no-undo
     5874   initial "@(#)$Workfile$ $Revision$".
     5875   define stream excel-line.
     5876   define stream excel-cell.
     5877   define temp-table temp_cell-data no-undo
     5878       field data-key as character
     5879       field data-value as character
     5880       index pi is primary unique data-key
     5881   .
     5882   define temp-table temp_line-data no-undo
     5883       field data-key     as character
     5884       field xl-line-id   as integer
     5885       field ID           as integer
     5886       field gdscode      as character
     5887       field artic        as character
     5888       field Name         as character
     5889       field EI           as character
     5890       field price        as character
     5891       field qnty         as character
     5892       field sum          as character
     5893       field nazen        as character
     5894       index pi is primary unique xl-line-id
     5895   .
     5896   define variable v-r-inpxl-current-data-row     as integer      no-undo.
     5897   define variable v-r-inpxl-cell-file-name       as character    no-undo.
     5898   define variable v-r-inpxl-data-file-name       as character    no-undo.
     5899   procedure r-inpxl-init :
     5900       define buffer buf_temp_cell-data        for temp_cell-data.
     5901   do
     5902   for buf_temp_cell-data on error undo, return error :
     5903       assign
     5904           v-r-inpxl-current-data-row = 0
     5905       .
     5906       run gbl/_tmpfile.p
     5907         (input "xd"
     5908         ,input ".txt"
     5909         ,output v-r-inpxl-data-file-name
     5910         ).
     5911       output stream excel-line to value( v-r-inpxl-data-file-name ).
     5912       run gbl/_tmpfile.p
     5913         (input "xc"
     5914         ,input ".txt"
     5915         ,output v-r-inpxl-cell-file-name
     5916         ).
     5917       output stream excel-cell to value( v-r-inpxl-cell-file-name ).
     5918       if printrubl
     5919       then do:
     5920           run r-inpxl-write-cell-data in this-procedure (
     5921                 input "valutCode":U
     5922               , input "0":U
     5923           ).
     5924       end.
     5925       else do:
     5926           run r-inpxl-write-cell-data in this-procedure (
     5927                 input "valutCode":U
     5928               , input "1":U
     5929           ).
     5930       end.
     5931       run r-inpxl-write-cell-data in this-procedure (
     5932             input "regularExpressions":U
     5933           , input "1":U
     5934       ).
     5935       run r-inpxl-write-cell-data in this-procedure (
     5936             input "columnList":U
     5937           , input "ID,gdscode,artic,Name,EI,price,qnty,sum,nazen":U
     5938       ).
     5939       run r-inpxl-write-cell-data in this-procedure (
     5940             input "columnType":U
     5941           , input "I,I,S,S,S,D,D,D,D":U
     5942       ).
     5943       run r-inpxl-write-cell-data in this-procedure (
     5944             input "columnAmount":U
     5945           , input "9":U
     5946       ).
     5947       run r-inpxl-write-cell-data in this-procedure (
     5948             input "subtotalList":U
     5949           , input "qnty,sum":U
     5950       ).
     5951       run r-inpxl-write-cell-data in this-procedure (
     5952             input "subtotalType":U
     5953           , input "S,S":U
     5954       ).
     5955       run r-inpxl-write-cell-data in this-procedure (
     5956             input "subtotalAmount":U
     5957           , input "2":U
     5958       ).
     5959   end.
     5960   end procedure.
     5961   procedure r-inpxl-close :
     5962   do
     5963   on error undo, return error
     5964   :
     5965       output stream excel-line close.
     5966       output stream excel-cell close.
     5967       output to value( string( session:temp-directory + "$" + string( g#report-num ) ) + ".txl" ) append.
     5968           export "exe/ni_97.xlt":U.
     5969           export "exe/t_97.bas":U.
     5970           export v-r-inpxl-cell-file-name.
     5971           export v-r-inpxl-data-file-name.
     5972       output close.
     5973   end.
     5974   end procedure.
     5975   procedure r-inpxl-write-cell-data :
     5976   define input parameter p-data-key   as character        no-undo.
     5977   define input parameter p-data-value as character        no-undo.
     5978       define buffer buf_temp_cell-data     for temp_cell-data.
     5979   do
     5980   for buf_temp_cell-data
     5981   on error undo, return error
     5982   :
     5983       find first buf_temp_cell-data
     5984            where buf_temp_cell-data.data-key = p-data-key
     5985       no-error.
     5986       if not available buf_temp_cell-data
     5987       then do:
     5988           create buf_temp_cell-data.
     5989           assign
     5990               buf_temp_cell-data.data-key = p-data-key
     5991           .
     5992       end.
     5993       assign
     5994           buf_temp_cell-data.data-value = p-data-value
     5995       .
     5996       put stream excel-cell unformatted
     5997                           buf_temp_cell-data.data-key
     5998           chr(9)   buf_temp_cell-data.data-value
     5999           chr(10)
     6000       .
     6001   end.
     6002   end procedure.
     6003   procedure r-inpxl-write-line-data :
     6004   define input parameter p-ID             as integer          no-undo.
     6005   define input parameter p-gdscode        as character        no-undo.
     6006   define input parameter p-artic          as character        no-undo.
     6007   define input parameter p-Name           as character        no-undo.
     6008   define input parameter p-EI             as character        no-undo.
     6009   define input parameter p-price          as character        no-undo.
     6010   define input parameter p-qnty           as character        no-undo.
     6011   define input parameter p-sum            as character        no-undo.
     6012   define input parameter p-nazen          as character        no-undo.
     6013       define buffer buf_temp_line-data        for temp_line-data.
     6014   do
     6015   for buf_temp_line-data
     6016   on error undo, return error
     6017   :
     6018       for each buf_temp_line-data
     6019       :
     6020           delete buf_temp_line-data.
     6021       end.
     6022       create buf_temp_line-data.
     6023       assign
     6024           v-r-inpxl-current-data-row = v-r-inpxl-current-data-row + 1
     6025       .
     6026       assign
     6027           buf_temp_line-data.data-key     = "LD":U
     6028           buf_temp_line-data.xl-line-id   = v-r-inpxl-current-data-row
     6029           buf_temp_line-data.id           = p-id
     6030           buf_temp_line-data.gdscode      = p-gdscode
     6031           buf_temp_line-data.artic        = p-artic
     6032           buf_temp_line-data.Name         = p-Name
     6033           buf_temp_line-data.EI           = p-EI
     6034           buf_temp_line-data.price        = p-price
     6035           buf_temp_line-data.qnty         = p-qnty
     6036           buf_temp_line-data.sum          = p-sum
     6037           buf_temp_line-data.nazen        = p-nazen
     6038       .
     6039       put stream excel-line unformatted
     6040                           buf_temp_line-data.data-key
     6041           chr(9)   ( if buf_temp_line-data.id = 0 then "":U else string( buf_temp_line-data.id ) )
     6042           chr(9)   buf_temp_line-data.gdscode
     6043           chr(9)   buf_temp_line-data.artic
     6044           chr(9)   buf_temp_line-data.Name
     6045           chr(9)   buf_temp_line-data.EI
     6046           chr(9)   buf_temp_line-data.price
     6047           chr(9)   buf_temp_line-data.qnty
     6048           chr(9)   buf_temp_line-data.sum
     6049           chr(9)   buf_temp_line-data.nazen
     6050           chr(10)
     6051       .
     6052   end.
     6053   end procedure.
     6054   procedure r-inpxl-run-excel :
     6055   define input parameter p-header-filename    as character        no-undo.
     6056   define input parameter p-data-filename      as character        no-undo.
     6057       define variable v-template-file-name    as character    no-undo.
     6058       define variable v-vb-file-name          as character    no-undo.
     6059       define buffer buf_temp-param for temp-param .
     6060   do
     6061   for buf_temp-param
     6062   on error undo, return error
     6063   :
     6064       create buf_temp-param.
     6065       assign
     6066           v-template-file-name    = search( "exe/ni_97.xlt" )
     6067           v-vb-file-name          = search( "exe/t_97.bas")
     6068       .
     6069       if v-template-file-name = ?  or v-template-file-name = "":U  then do:
     6070           message  "Ошибка имени файла шаблона." view-as alert-box error.
     6071       end.
     6072       if v-vb-file-name = ?  or v-vb-file-name = "":U then do:
     6073           message  "Ошибка имени файла кода обработки."   view-as alert-box error.
     6074       end.
     6075       run paramls-write in this-procedure (
     6076             input "template":U
     6077           , input "template-file-name":U
     6078           , input v-template-file-name
     6079       ).
     6080       run paramls-write in this-procedure (
     6081             input "template":U
     6082           , input "vb-file-name":U
     6083           , input v-vb-file-name
     6084       ).
     6085       run paramls-write in this-procedure (
     6086             input "data":U
     6087           , input "data-header-filename":U
     6088           , input p-header-filename
     6089       ).
     6090       run paramls-write in this-procedure (
     6091             input "data":U
     6092           , input "data-filename":U
     6093           , input p-data-filename
     6094       ).
     6095       run gbl/macroxlt.p (
     6096           input-output table buf_temp-param
     6097       ) no-error.
     6098       if error-status :error
     6099       then do:
     6100           message
     6101                    vss-workfile vss-revision vss-description
     6102               skip(1)
     6103               skip "Ошибка создания файла Excel."
     6104               skip return-value
     6105               skip trim(error-status :get-message(1))
     6106                    trim(error-status :get-message(2))
     6107                    trim(error-status :get-message(3))
     6108           view-as alert-box error.
     6109           undo, return error .
     6110       end.
     6111   end.
     6112   end procedure.
