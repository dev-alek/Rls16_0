     4976       bfpc_tt-allsum.excise-base-cur     = bf_tt-allsum.excise-base-cur
     4977       bfpc_tt-allsum.excise-rubl-cur     = bf_tt-allsum.excise-rubl-cur
     4978       bfpc_tt-allsum.sum-dsc-base-acc    = 0
