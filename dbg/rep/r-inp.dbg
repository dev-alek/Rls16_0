        1   block-level on error undo, throw.
        2   do
        3   on error undo, return error
        4   :
        5     define input parameter p-mainmenu-handle  as handle           no-undo.
        6     define input parameter rec_id             as recid            no-undo.
        7     define variable vss-revision    as character no-undo initial "$Revision: 58d3c7fbfb02, 2708, rls $":U .
        8     define variable vss-author      as character no-undo initial "$Author: EShklyar $":U .
        9     define variable vss-date        as character no-undo initial "$Date: Вт дек 29 14:38:14 2020 +0300 $":U .
       10     define variable vss-workfile    as character no-undo initial "$Workfile: r-inp.p $":U .
       11     define variable vss-archive     as character no-undo initial "$Archive: rep/r-inp.p $":U .
       12     define variable vss-description as character no-undo initial "Документ прихода (старый)":U .
       13   procedure vss-get-info :
       14     define output parameter p-vss-revision    like vss-revision    no-undo .
       15     define output parameter p-vss-author      like vss-author      no-undo .
       16     define output parameter p-vss-date        like vss-date        no-undo .
       17     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       18     define output parameter p-vss-archive     like vss-archive     no-undo .
       19     define output parameter p-vss-description like vss-description no-undo .
       20     assign
       21       p-vss-revision    = vss-revision
       22       p-vss-author      = vss-author
       23       p-vss-date        = vss-date
       24       p-vss-workfile    = vss-workfile
       25       p-vss-archive     = vss-archive
       26       p-vss-description = vss-description
       27     .
       28   end procedure.
       29   procedure vss-get-parameters :
       30     define output parameter p-vss-parameters as character no-undo .
       31   end procedure.
       32   define new global shared variable g#vssrevis-logger as handle    no-undo .
       33   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       34   define variable v-vssrevis-logger                   as handle    no-undo .
       35   procedure vss-logevent :
       36     define input  parameter p-extra-paramters as character no-undo .
       37     define variable v-vssrevis-parameters as character no-undo .
       38     do
       39     on error undo, return error return-value
       40     :
       41       if  valid-handle(v-vssrevis-logger)
       42       and v-vssrevis-logger :get-signature("logevent") <> ""
       43       then do:
       44         run vss-get-parameters in this-procedure
       45           (output v-vssrevis-parameters
       46           ).
       47         run logevent in v-vssrevis-logger
       48           (input vss-workfile
       49           ,input vss-revision
       50           ,input v-vssrevis-parameters
       51           ,input p-extra-paramters
       52           ).
       53       end.
       54     end.
       55   end procedure.
       56   assign
       57     v-vssrevis-logger = g#vssrevis-logger
       58   .
       59   if  valid-handle(v-vssrevis-logger)
       60   and v-vssrevis-logger :get-signature("logevent") <> ""
       61   then do:
       62     assign
       63       v-vssrevis-logevent = true
       64     .
       65     run vss-logevent in this-procedure (input vss-description) .
       66   end.
       67   define new global shared variable g#language as character no-undo .
       68   if g#language <> '' and g#language <> 'rus':U then do:
       69     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       70   end.
       71   define new global shared variable g#library  as handle no-undo .
       72   define new global shared variable g#library2 as handle no-undo .
       73   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       74   define  shared variable PrintCopiesCounter as integer   no-undo initial 1 .
       75   define  shared variable RepPathName        as character no-undo .
       76   define  shared variable PrintRubl          as logical   no-undo .
       77   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       78   function breakstr returns character ( input        for-name    as character,
       79                                         input        line-length as integer,
       80                                         input-output line1       as character,
       81                                         input-output line2       as character ) :
       82     define variable ii as integer no-undo.
       83     if length( for-name ) > line-length then do:
       84       assign ii    = 1
       85              line1 = "":u
       86              line2 = "":u.
       87       if length( entry( ii, for-name , " ":u ) ) > line-length then do:
       88         assign line1 =       substring( for-name, 1, line-length     )
       89                line2 = trim( substring( for-name,    line-length + 1 ) ).
       90       end.                                                     else do:
       91         do while length( line1 + entry( ii, for-name, " ":u ) ) < ( line-length + 1 ) :
       92           assign line1 = line1 + entry( ii, for-name, " ":u ) + " ":u
       93                  ii    = ii    + 1.
       94           if length( entry( ii, for-name, " ":u ) ) > line-length then do:
       95             assign line1 = line1 + substring( for-name, length( line1 ), line-length - length( line1 ) + 1 ).
       96           end.
       97         end.
       98         assign line2 = trim( substring( for-name, length( line1 ) ) ).
       99       end.
      100     end.                                else do:
      101       assign line1 = for-name
      102              line2 = "":u.
      103     end.
      104     return ( line1 ).
      105   end function.
      106   define variable vss-include-info2 as character format "X(65)" no-undo
      107   initial "@(#)$Workfile$ $Revision$".
      108   define variable v-fmtcli-name          as character    no-undo.
      109   define variable v-fmtcli-engl-name     as character    no-undo.
      110   define variable v-fmtcli-addres        as character    no-undo.
      111   define variable v-fmtcli-post-addres   as character    no-undo.
      112   define variable v-fmtcli-full-addres   as character    no-undo.
      113   define variable v-fmtcli-phone         as character    no-undo.
      114   define variable v-fmtcli-inn           as character    no-undo.
      115   define variable v-fmtcli-kpp           as character    no-undo.
      116   define variable v-fmtcli-okpo          as character    no-undo.
      117   define variable v-fmtcli-country       as character    no-undo.
      118   define variable v-fmtcli-city          as character    no-undo.
      119   define variable v-fmtcli-index         as character    no-undo.
      120   define variable v-fmtcli-schet-exists  as logical      no-undo.
      121   define variable v-fmtcli-bank-exists   as logical      no-undo.
      122   define variable v-fmtcli-bank-r-schet  as character    no-undo.
      123   define variable v-fmtcli-bank-c-schet  as character    no-undo.
      124   define variable v-fmtcli-bank-bik      as character    no-undo.
      125   define variable v-fmtcli-bank-name     as character    no-undo.
      126   define variable v-fmtcli-bank-addres   as character    no-undo.
      127   define variable v-fmtcli-bank-city     as character    no-undo.
      128   procedure fmtcli-get-bank :
      129   define input parameter p-host-code      as integer          no-undo.
      130   define input parameter p-obj-type       as character        no-undo.
      131   define input parameter p-obj-code       as integer          no-undo.
      132   define input parameter p-curr-code      as integer          no-undo.
      133       define buffer buf_fin-schet     for ub.fin-schet.
      134       define buffer buf_fin-bank      for ub.fin-bank.
      135   do
      136   for buf_fin-schet
      137     , buf_fin-bank
      138   on error undo, return error
      139   :
      140       assign
      141           v-fmtcli-schet-exists       = no
      142           v-fmtcli-bank-exists        = no
      143           v-fmtcli-bank-r-schet       = "":U
      144           v-fmtcli-bank-c-schet       = "":U
      145           v-fmtcli-bank-bik           = "":U
      146           v-fmtcli-bank-name          = "":U
      147           v-fmtcli-bank-addres        = "":U
      148           v-fmtcli-bank-city          = "":U
      149       .
      150       search-for-schet:
      151       for each buf_fin-schet no-lock
      152          where buf_fin-schet.host-code = p-host-code
      153            and buf_fin-schet.cli-type  = p-obj-type
      154            and buf_fin-schet.cli-code  = p-obj-code
      155            and buf_fin-schet.curr-code = p-curr-code
      156       on error undo, return error
      157       :
      158           if buf_fin-schet.status_   = 'удал':U
      159           then do:
      160           end.
      161           else do:
      162               assign
      163                   v-fmtcli-schet-exists   = yes
      164                   v-fmtcli-bank-r-schet   = trim( buf_fin-schet.r-schet )
      165                   v-fmtcli-bank-c-schet   = trim( buf_fin-schet.c-schet )
      166               .
      167               find first buf_fin-bank no-lock
      168                    where buf_fin-bank.host-code = p-host-code
      169                      and buf_fin-bank.code-bank = buf_fin-schet.code-bank
      170               no-error.
      171               if available buf_fin-bank
      172               then do:
      173                   assign
      174                       v-fmtcli-bank-exists      = yes
      175                       v-fmtcli-bank-bik         = trim( buf_fin-bank.bik )
      176                       v-fmtcli-bank-name        = trim( buf_fin-bank.bank-name )
      177                       v-fmtcli-bank-addres      = trim(buf_fin-bank.addres)
      178                       v-fmtcli-bank-city      = trim(buf_fin-bank.bank-city)
      179                   .
      180               end.
      181               else do:
      182                   assign
      183                       v-fmtcli-bank-exists    = no
      184                       v-fmtcli-bank-bik       = "":U
      185                       v-fmtcli-bank-name      = "":U
      186                       v-fmtcli-bank-addres    = "":U
      187                       v-fmtcli-bank-city      = "":U
      188                   .
      189               end.
      190               leave search-for-schet.
      191           end.
      192       end.
      193   end.
      194   end procedure.
      195   procedure fmtcli-get-client :
      196   define input parameter p-obj-type       as character    no-undo.
      197   define input parameter p-obj-code       as integer      no-undo.
      198       define variable v-temp-fmtcli-address      as character     no-undo.
      199       define variable v-num-country-city    as integer      no-undo.
      200       define buffer buf_clients   for ub.clients.
      201       define buffer buf_firm      for ub.firm.
      202       define buffer buf_store     for ub.store.
      203       define buffer buf_shop      for ub.shop.
      204       define buffer buf_person    for ub.person.
      205   do
      206   for buf_clients
      207     , buf_firm
      208     , buf_store
      209     , buf_shop
      210     , buf_person
      211   on error undo, return error
      212   :
      213       assign
      214           v-fmtcli-name           = "":U
      215           v-fmtcli-addres         = "":U
      216           v-fmtcli-post-addres    = "":U
      217           v-fmtcli-full-addres    = "":U
      218           v-fmtcli-phone          = "":U
      219           v-fmtcli-inn            = "":U
      220           v-fmtcli-kpp            = "":U
      221           v-fmtcli-okpo           = "":U
      222           v-fmtcli-city           = "":U
      223           v-fmtcli-index          = "":U
      224           v-fmtcli-country        = "":U
      225       .
      226       find first buf_clients no-lock
      227            where buf_clients.obj-type = p-obj-type
      228              and buf_clients.obj-code = p-obj-code
      229       .
      230       assign
      231           v-fmtcli-name = buf_clients.obj-name
      232       .
      233       case buf_clients.obj-type:
      234          when 'орг':U
      235          then do:
      236               find first buf_firm no-lock
      237                    where buf_firm.firm-code = buf_clients.obj-code
      238                    no-error
      239               .
      240               if available buf_firm
      241               then do:
      242                   assign
      243                       v-num-country-city = num-entries( buf_firm.city )
      244                       v-fmtcli-engl-name = buf_firm.engl-name
      245                   .
      246                   if v-num-country-city > 0
      247                   then do:
      248                       assign
      249                           v-fmtcli-country    = trim( entry( 1, buf_firm.city ) )
      250                       .
      251                   end.
      252                   if v-num-country-city > 1
      253                   then do:
      254                       assign
      255                           v-fmtcli-city       = trim( entry( 2, buf_firm.city ) )
      256                       .
      257                   end.
      258                   run fmtcli-concatenate-strings in this-procedure (
      259                         input v-fmtcli-full-addres
      260                       , input v-fmtcli-country
      261                       , input ", ":U
      262                       , input 50
      263                       , output v-fmtcli-full-addres
      264                   ).
      265                   run fmtcli-concatenate-strings in this-procedure (
      266                         input v-fmtcli-full-addres
      267                       , input v-fmtcli-city
      268                       , input ", ":U
      269                       , input 50
      270                       , output v-fmtcli-full-addres
      271                   ).
      272                   run fmtcli-concatenate-strings in this-procedure (
      273                         input v-fmtcli-full-addres
      274                       , input IF buf_firm.ind = 0 THEN "" ELSE string( buf_firm.ind )
      275                       , input ", ":U
      276                       , input 50
      277                       , output v-fmtcli-full-addres
      278                   ).
      279                   run fmtcli-concatenate-strings in this-procedure (
      280                         input v-fmtcli-post-addres
      281                       , input v-fmtcli-country
      282                       , input ", ":U
      283                       , input 50
      284                       , output v-fmtcli-post-addres
      285                   ).
      286                   run fmtcli-concatenate-strings in this-procedure (
      287                         input v-fmtcli-post-addres
      288                       , input v-fmtcli-city
      289                       , input ", ":U
      290                       , input 50
      291                       , output v-fmtcli-post-addres
      292                   ).
      293                   run fmtcli-concatenate-strings in this-procedure (
      294                         input v-fmtcli-post-addres
      295                       , input string( buf_firm.ind )
      296                       , input ", ":U
      297                       , input 50
      298                       , output v-fmtcli-post-addres
      299                   ).
      300                   run fmtcli-concatenate-strings in this-procedure (
      301                         input substring( buf_firm.addres1, 1, 50 )
      302                       , input buf_firm.addres2
      303                       , input " ":U
      304                       , input 50
      305                       , output v-temp-fmtcli-address
      306                   ).
      307                   run fmtcli-concatenate-strings in this-procedure (
      308                         input v-temp-fmtcli-address
      309                       , input substring( buf_firm.addres1, 51, 50 )
      310                       , input " ":U
      311                       , input 50
      312                       , output v-temp-fmtcli-address
      313                   ).
      314                   run fmtcli-concatenate-strings in this-procedure (
      315                         input v-temp-fmtcli-address
      316                       , input substring( buf_firm.addres1, 101, 50 )
      317                       , input " ":U
      318                       , input 50
      319                       , output v-temp-fmtcli-address
      320                   ).
      321                   assign
      322                       v-fmtcli-addres = v-temp-fmtcli-address
      323                   .
      324                   if buf_firm.addres1 <> ?
      325                   then do:
      326                       run fmtcli-concatenate-strings in this-procedure (
      327                             input v-fmtcli-full-addres
      328                           , input v-fmtcli-addres
      329                           , input ", ":U
      330                           , input 0
      331                           , output v-fmtcli-full-addres
      332                       ).
      333                   end.
      334                   run fmtcli-concatenate-strings in this-procedure (
      335                         input substring( buf_firm.post-addr1, 1, 50 )
      336                       , input buf_firm.post-addr2
      337                       , input " ":U
      338                       , input 50
      339                       , output v-fmtcli-post-addres
      340                   ).
      341                   run fmtcli-concatenate-strings in this-procedure (
      342                         input v-fmtcli-post-addres
      343                       , input substring( buf_firm.post-addr1, 51, 50 )
      344                       , input " ":U
      345                       , input 50
      346                       , output v-fmtcli-post-addres
      347                   ).
      348                   run fmtcli-concatenate-strings in this-procedure (
      349                         input v-fmtcli-post-addres
      350                       , input substring( buf_firm.post-addr1, 101, 50 )
      351                       , input " ":U
      352                       , input 50
      353                       , output v-fmtcli-post-addres
      354                   ).
      355                   assign
      356                       v-fmtcli-phone         = buf_firm.phone
      357                       v-fmtcli-inn           = buf_firm.inn
      358                       v-fmtcli-kpp           = buf_firm.kpp
      359                       v-fmtcli-okpo          = buf_firm.okpo
      360                       v-fmtcli-index         = string( buf_firm.ind )
      361                   .
      362               end.
      363          end.
      364          when 'маг':U
      365          then do:
      366               find first buf_shop no-lock
      367                    where buf_shop.obj-code = buf_clients.obj-code
      368               .
      369               if available buf_shop
      370               then do:
      371                   run fmtcli-concatenate-strings in this-procedure (
      372                         input buf_shop.addres1
      373                       , input buf_shop.addres2
      374                       , input " ":U
      375                       , input 50
      376                       , output v-fmtcli-addres
      377                   ).
      378                   assign
      379                       v-fmtcli-full-addres = v-fmtcli-addres
      380                       v-fmtcli-post-addres = v-fmtcli-addres
      381                       v-fmtcli-phone       = buf_shop.phone
      382                       v-fmtcli-inn         = "":U
      383                       v-fmtcli-kpp         = "":U
      384                       v-fmtcli-okpo        = "":U
      385                       v-fmtcli-city        = "":U
      386                       v-fmtcli-index       = "":U
      387                   .
      388               end.
      389          end.
      390          when 'скл':U
      391          then do:
      392               find first buf_store no-lock
      393                    where buf_store.obj-code = buf_clients.obj-code
      394               .
      395               if available buf_store
      396               then do:
      397                   run fmtcli-concatenate-strings in this-procedure (
      398                         input buf_store.addres1
      399                       , input buf_store.addres2
      400                       , input " ":U
      401                       , input 50
      402                       , output v-fmtcli-addres
      403                   ).
      404                   assign
      405                       v-fmtcli-full-addres = v-fmtcli-addres
      406                       v-fmtcli-phone       = buf_store.phone
      407                       v-fmtcli-inn         = "":U
      408                       v-fmtcli-kpp         = "":U
      409                       v-fmtcli-okpo        = "":U
      410                       v-fmtcli-city        = "":U
      411                       v-fmtcli-index       = "":U
      412                   .
      413               end.
      414          end.
      415          when 'чел':U
      416          then do:
      417               find first buf_person no-lock
      418                    where buf_person.psn-code = buf_clients.obj-code
      419               .
      420               if available buf_person
      421               then do:
      422                   run fmtcli-concatenate-strings in this-procedure (
      423                         input ( if buf_person.ind = 0 or buf_person.ind = ?
      424                                 then "":U
      425                                 else string( buf_person.ind, "999999")
      426                                 )
      427                       , input buf_person.city
      428                       , input ", ":U
      429                       , input 0
      430                       , output v-fmtcli-full-addres
      431                   ).
      432                   assign
      433                       v-fmtcli-addres = buf_person.address
      434                   .
      435                   run fmtcli-concatenate-strings in this-procedure (
      436                         input v-fmtcli-full-addres
      437                       , input v-fmtcli-addres
      438                       , input ", ":U
      439                       , input 0
      440                       , output v-fmtcli-full-addres
      441                   ).
      442                   assign
      443                       v-fmtcli-phone     = buf_person.phone1
      444                       v-fmtcli-inn       = buf_person.inn
      445                       v-fmtcli-kpp       = buf_person.kpp
      446                       v-fmtcli-okpo      = buf_person.okpo
      447                       v-fmtcli-city      = buf_person.city
      448                       v-fmtcli-index     = string( buf_person.ind )
      449                   .
      450               end.
      451          end.
      452       end case.
      453   end.
      454   end procedure.
      455   procedure fmtcli-concatenate-strings :
      456   define input parameter p-string-1       as character        no-undo.
      457   define input parameter p-string-2       as character        no-undo.
      458   define input parameter p-delimiter      as character        no-undo.
      459   define input parameter p-length         as integer          no-undo.
      460   define output parameter p-out-string    as character        no-undo.
      461   do
      462   on error undo, return error
      463   :
      464       assign
      465           p-out-string = ( if p-string-1 = ?
      466                            then "":U
      467                            else trim( p-string-1 ) )
      468       .
      469       assign
      470           p-out-string = p-out-string
      471                        + ( if p-out-string = "":U
      472                            or length( p-out-string ) = p-length
      473                            or p-string-2 = ?
      474                            or trim( p-string-2 ) = "":U
      475                            then "":U
      476                            else p-delimiter )
      477                        + ( if p-string-2 = ?
      478                            or trim( p-string-2 ) = "":U
      479                            then "":U
      480                            else trim( p-string-2 ) )
      481       .
      482   end.
      483   end procedure.
      484   def var vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      485   define new global shared variable g#attr-lib  as handle no-undo .
      486   define variable v-attr-lib-variable as handle no-undo .
      487   procedure clntattr-code :
      488     define input  parameter p-code           as character no-undo .
      489     define output parameter p-type           as character no-undo .
      490     define output parameter p-format         as character no-undo .
      491     define output parameter p-label          as character no-undo .
      492     define output parameter p-user-can-edit  as logical   no-undo .
      493     define output parameter p-output-display as logical   no-undo .
      494     define output parameter p-other          as character no-undo .
      495     do
      496     on error undo, return error return-value
      497     :
      498           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run clntattr-code in g#attr-lib
      499         (input  p-code
      500         ,output p-type
      501         ,output p-format
      502         ,output p-label
      503         ,output p-user-can-edit
      504         ,output p-output-display
      505         ,output p-other
      506         ) no-error .
      507       if error-status :error
      508       then do:
      509         undo, return error return-value .
      510       end.
      511     end.
      512   end procedure.
      513   procedure clntattr-tooltip :
      514     define input  parameter p-code    as character no-undo .
      515     define output parameter p-tooltip as character no-undo .
      516     define output parameter p-label   as character no-undo .
      517     do
      518     on error undo, return error return-value
      519     :
      520           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run clntattr-tooltip in g#attr-lib
      521         (input  p-code
      522         ,output p-tooltip
      523         ,output p-label
      524         ) no-error .
      525       if error-status :error
      526       then do:
      527         undo, return error return-value .
      528       end.
      529     end.
      530   end procedure.
      531   procedure clntattr-value :
      532     define input  parameter p-obj-type like ub.clients-attr.obj-type   no-undo .
      533     define input  parameter p-obj-code like ub.clients-attr.obj-code   no-undo .
      534     define input  parameter p-code     like ub.clients-attr.attr-code  no-undo .
      535     define output parameter p-value    like ub.clients-attr.attr-value no-undo .
      536     define output parameter p-type     as character no-undo .
      537     do
