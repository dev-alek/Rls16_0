     5479     (input  bf_trn-doc.obj-type
     5480     ,input  bf_trn-doc.obj-code
     5481     ,input  varb-code
     5482     ,input  0
     5483     ,input  bf_trn-doc.fact-order
     5484     ,output vardoc-num
     5485     ,output varprice-sale
     5486     ,output varroad-tax
     5487     ,output varexcise
     5488     )  .
     5489             if varprice-sale = ?
     5490             then do:
     5491               assign
     5492                 varprice-sale = 0
     5493                 varroad-tax   = 0
     5494                 varexcise     = 0
     5495               .
     5496             end.
     5497             assign
     5498               varlastcur-base     = varprice-sale
     5499               varlastcur-road-tax = varroad-tax
     5500               varlastcur-excise   = varexcise
     5501               varcur-base         = varcur-base      + varprice-sale * bf_gds-dtl.fact-qnty
     5502               varcur-road-tax     = varcur-road-tax  + varroad-tax   * bf_gds-dtl.fact-qnty
     5503               varcur-excise       = varcur-excise    + varexcise     * bf_gds-dtl.fact-qnty
     5504               varcur-fact-qnty    = varcur-fact-qnty + bf_gds-dtl.fact-qnty
     5505             .
     5506         end.
     5507       end.
     5508       if varcur-fact-qnty = 0 then do:
     5509         assign
     5510           varcur-base      = varlastcur-base
     5511           varcur-road-tax  = varlastcur-road-tax
     5512           varcur-excise    = varlastcur-excise
     5513         .
     5514       end.
     5515       else do:
     5516         assign
     5517           varcur-base      = varcur-base      / varcur-fact-qnty
     5518           varcur-road-tax  = varcur-road-tax  / varcur-fact-qnty
     5519           varcur-excise    = varcur-excise    / varcur-fact-qnty
     5520         .
     5521       end.
     5522       if varcur-vat-pc = ?
