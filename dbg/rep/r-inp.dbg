     6593   procedure print-titul :
     6594     do on error undo, return error return-value :
     6595       if can-do('факт':U, buf_trn-doc.status_ ) or ( can-do('накл':U, buf_trn-doc.status_) and buf_trn-doc.flag_ ) then do:
     6596         if buf_trn-doc.internal then do:
     6597           put stream Out_stream  "В Н У Т Р Е Н Н Е Е  ПЕРЕМЕЩЕНИЕ - П Р И Х О Д   N " at 22 format "X(55)"
     6598                    v-doc-code format "X(14)" "  от  " v-doc-date-string format "X(30)" skip(1) .
     6599           run r-inpxl-write-cell-data in this-procedure (
     6600               input "h_docName":U
     6601             , input string("В Н У Т Р Е Н Н Е Е  ПЕРЕМЕЩЕНИЕ - П Р И Х О Д  N ")
     6602           ).
     6603         end.
     6604         else do:
     6605           put stream Out_stream "П Р И Х О Д Н А Я   Н А К Л А Д Н А Я   N  " at 32 format "X(45)" v-doc-code format "X(14)" "  от  " v-doc-date-string format "X(30)" skip(1) .
     6606           run r-inpxl-write-cell-data in this-procedure (
     6607               input "h_docName":U
