     6690                 " N ____________" format "X(15)" " от " '"____"_____________' format "X(20)"
     6691                 string( string( year( buf_trn-doc.doc-date ) ) + " г." )  format "X(20)" skip(1) .
     6692         run r-inpxl-write-cell-data in this-procedure (
     6693             input "h_docName":U
