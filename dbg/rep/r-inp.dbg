     4886       bfs_tt-allsum.vat-base-buyer-cur  =  - bf_tt-allsum.vat-base-buyer-cur
     4887       bfs_tt-allsum.vat-rubl-buyer-cur  =  - bf_tt-allsum.vat-rubl-buyer-cur
     4888       bfs_tt-allsum.slt-base-cur        =  - bf_tt-allsum.slt-base-cur
     4889       bfs_tt-allsum.slt-rubl-cur        =  - bf_tt-allsum.slt-rubl-cur
     4890       bfs_tt-allsum.road-tax-base-cur   =  - bf_tt-allsum.road-tax-base-cur
     4891       bfs_tt-allsum.road-tax-rubl-cur   =  - bf_tt-allsum.road-tax-rubl-cur
     4892       bfs_tt-allsum.excise-base-cur     =  - bf_tt-allsum.excise-base-cur
     4893       bfs_tt-allsum.excise-rubl-cur     =  - bf_tt-allsum.excise-rubl-cur
     4894       bfs_tt-allsum.sum-dsc-base-acc    =  - bf_tt-allsum.sum-dsc-base-acc
     4895       bfs_tt-allsum.sum-dsc-rubl-acc    =  - bf_tt-allsum.sum-dsc-rubl-acc
     4896       bfs_tt-allsum.sum-dsc-cli-acc     =  - bf_tt-allsum.sum-dsc-cli-acc
     4897       bfs_tt-allsum.dsc-base-acc        =  - bf_tt-allsum.dsc-base-acc
     4898       bfs_tt-allsum.dsc-rubl-acc        =  - bf_tt-allsum.dsc-rubl-acc
     4899       bfs_tt-allsum.dsc-cli-acc         =  - bf_tt-allsum.dsc-cli-acc
     4900       bfs_tt-allsum.vat-base-acc        =  - bf_tt-allsum.vat-base-acc
     4901       bfs_tt-allsum.vat-rubl-acc        =  - bf_tt-allsum.vat-rubl-acc
     4902       bfs_tt-allsum.vat-cli-acc         =  - bf_tt-allsum.vat-cli-acc
     4903       bfs_tt-allsum.slt-base-acc        =  - bf_tt-allsum.slt-base-acc
     4904       bfs_tt-allsum.slt-rubl-acc        =  - bf_tt-allsum.slt-rubl-acc
     4905       bfs_tt-allsum.slt-cli-acc         =  - bf_tt-allsum.slt-cli-acc
     4906       bfs_tt-allsum.road-tax-base-acc   =  - bf_tt-allsum.road-tax-base-acc
     4907       bfs_tt-allsum.road-tax-rubl-acc   =  - bf_tt-allsum.road-tax-rubl-acc
     4908       bfs_tt-allsum.road-tax-cli-acc    =  - bf_tt-allsum.road-tax-cli-acc
     4909       bfs_tt-allsum.excise-base-acc     =  - bf_tt-allsum.excise-base-acc
     4910       bfs_tt-allsum.excise-rubl-acc     =  - bf_tt-allsum.excise-rubl-acc
     4911       bfs_tt-allsum.excise-cli-acc      =  - bf_tt-allsum.excise-cli-acc
     4912       bfs_tt-allsum.transport-base-acc  =  - bf_tt-allsum.transport-base-acc
     4913       bfs_tt-allsum.transport-rubl-acc  =  - bf_tt-allsum.transport-rubl-acc
     4914       bfs_tt-allsum.transport-cli-acc   =  - bf_tt-allsum.transport-cli-acc
     4915       bfs_tt-allsum.other-base-acc      =  - bf_tt-allsum.other-base-acc
     4916       bfs_tt-allsum.other-rubl-acc      =  - bf_tt-allsum.other-rubl-acc
     4917       bfs_tt-allsum.other-cli-acc       =  - bf_tt-allsum.other-cli-acc.
     4918   end.
     4919   create bfpc_tt-allsum.
     4920   create bfspc_tt-allsum.
     4921   case cl_tt-clcparts.purch-code :
     4922   when 1           then do:
     4923     assign
     4924       bfpc_tt-allsum.sum-type  = 'сумма_по_выкупу':U
     4925       bfspc_tt-allsum.sum-type = 'сумма_по_выкупу_со_знаком':U.
     4926     buffer-copy bf_tt-allsum  except bf_tt-allsum.sum-type  to bfpc_tt-allsum.
     4927     buffer-copy bfs_tt-allsum except bfs_tt-allsum.sum-type to bfspc_tt-allsum.
     4928   end.
     4929   when 4    then do:
     4930     assign
     4931       bfpc_tt-allsum.sum-type  = 'сумма_по_старой_консигнации':U
     4932       bfspc_tt-allsum.sum-type = 'сумма_по_старой_консигнации_со_знаком':U.
     4933     buffer-copy bf_tt-allsum  except bf_tt-allsum.sum-type  to bfpc_tt-allsum.
     4934     buffer-copy bfs_tt-allsum except bfs_tt-allsum.sum-type to bfspc_tt-allsum.
     4935   end.
     4936   when 3 then do:
     4937     assign
     4938       bfpc_tt-allsum.sum-type  = 'сумма_по_ответственному_хранению':U
     4939       bfspc_tt-allsum.sum-type = 'сумма_по_ответственному_хранению_со_знаком':U.
     4940     buffer-copy bf_tt-allsum  except bf_tt-allsum.sum-type  to bfpc_tt-allsum.
     4941     buffer-copy bfs_tt-allsum except bfs_tt-allsum.sum-type to bfspc_tt-allsum.
     4942   end.
     4943   when 2 then do:
     4944     assign
     4945       bfpc_tt-allsum.sum-type  = 'сумма_по_консигнации_выгода':U
     4946       bfspc_tt-allsum.sum-type = 'сумма_по_консигнации_выгода_со_знаком':U.
     4947     assign
     4948       bfpc_tt-allsum.fact-qnty           = bf_tt-allsum.fact-qnty
     4949       bfpc_tt-allsum.cli-qnty            = bf_tt-allsum.cli-qnty
     4950       bfpc_tt-allsum.sum-dsc-base-doc    = bf_tt-allsum.sum-dsc-base-doc    - bf_tt-allsum.sum-dsc-base-acc
     4951       bfpc_tt-allsum.sum-dsc-rubl-doc    = bf_tt-allsum.sum-dsc-rubl-doc    - bf_tt-allsum.sum-dsc-rubl-acc
     4952       bfpc_tt-allsum.dsc-base-doc        = bf_tt-allsum.dsc-base-doc        - bf_tt-allsum.dsc-base-acc
     4953       bfpc_tt-allsum.dsc-rubl-doc        = bf_tt-allsum.dsc-rubl-doc        - bf_tt-allsum.dsc-rubl-acc
     4954       bfpc_tt-allsum.vat-base-doc        = bf_tt-allsum.vat-base-doc
     4955       bfpc_tt-allsum.vat-rubl-doc        = bf_tt-allsum.vat-rubl-doc
     4956       bfpc_tt-allsum.vat-base-buyer-doc  = bf_tt-allsum.vat-base-buyer-doc  - bf_tt-allsum.vat-base-acc
     4957       bfpc_tt-allsum.vat-rubl-buyer-doc  = bf_tt-allsum.vat-rubl-buyer-doc  - bf_tt-allsum.vat-rubl-acc
     4958       bfpc_tt-allsum.slt-base-doc        = bf_tt-allsum.slt-base-doc        - bf_tt-allsum.slt-base-acc
     4959       bfpc_tt-allsum.slt-rubl-doc        = bf_tt-allsum.slt-rubl-doc        - bf_tt-allsum.slt-rubl-acc
     4960       bfpc_tt-allsum.road-tax-base-doc   = bf_tt-allsum.road-tax-base-doc   - bf_tt-allsum.road-tax-base-acc
     4961       bfpc_tt-allsum.road-tax-rubl-doc   = bf_tt-allsum.road-tax-rubl-doc   - bf_tt-allsum.road-tax-rubl-acc
     4962       bfpc_tt-allsum.excise-base-doc     = bf_tt-allsum.excise-base-doc
     4963       bfpc_tt-allsum.excise-rubl-doc     = bf_tt-allsum.excise-rubl-doc
     4964       bfpc_tt-allsum.sum-dsc-base-cur    = bf_tt-allsum.sum-dsc-base-cur    - bf_tt-allsum.sum-dsc-base-acc
     4965       bfpc_tt-allsum.sum-dsc-rubl-cur    = bf_tt-allsum.sum-dsc-rubl-cur    - bf_tt-allsum.sum-dsc-rubl-acc
     4966       bfpc_tt-allsum.dsc-base-cur        = bf_tt-allsum.dsc-base-cur        - bf_tt-allsum.dsc-base-acc
     4967       bfpc_tt-allsum.dsc-rubl-cur        = bf_tt-allsum.dsc-rubl-cur        - bf_tt-allsum.dsc-rubl-acc
     4968       bfpc_tt-allsum.vat-base-cur        = bf_tt-allsum.vat-base-cur
     4969       bfpc_tt-allsum.vat-rubl-cur        = bf_tt-allsum.vat-rubl-cur
