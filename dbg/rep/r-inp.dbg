     7045     ,input  buf_goods.prod-code
     7046     ,output v-root-node
     7047     )  .
     7048   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prtat in g#library
     7049     (input  v-root-node
     7050     ,input  'empty-scale=request'
     7051     ,output empty-scale
     7052     )  .
     7053       run clcprtsl_calc-line in this-procedure (input recid (buf_doc-line)).
     7054       find first tt-allsum-line where tt-allsum-line.sum-type = 'основная_сумма':U no-error .
     7055       if not CostPrice then do:
     7056         if PrintRubl then do:
     7057           assign stoim = tt-allsum-line.sum-dsc-rubl-cur  SLT-sum = tt-allsum-line.slt-rubl-cur  VAT-sum = tt-allsum-line.vat-rubl-buyer-cur .
     7058         end.
     7059         else do:
     7060           assign stoim = tt-allsum-line.sum-dsc-base-cur  SLT-sum = tt-allsum-line.slt-base-cur  VAT-sum = tt-allsum-line.vat-base-buyer-cur .
     7061         end.
     7062       end.
     7063       else do:
     7064         if PrintRubl then do:
     7065           assign stoim = tt-allsum-line.sum-dsc-rubl-acc  SLT-sum = tt-allsum-line.slt-rubl-acc  VAT-sum = tt-allsum-line.vat-rubl-acc .
     7066         end.
     7067         else do:
     7068           assign stoim = tt-allsum-line.sum-dsc-base-acc  SLT-sum = tt-allsum-line.slt-base-acc  VAT-sum = tt-allsum-line.vat-base-acc .
     7069         end.
     7070       end.
     7071       find first buf_gds-obj no-lock
     7072         where buf_gds-obj.gds-code = buf_goods.gds-code
     7073           and buf_gds-obj.obj-type = buf_trn-doc.obj-type
     7074           and buf_gds-obj.obj-code = buf_trn-doc.obj-code
     7075         no-error .
     7076       if varr-b = "rubl":u then assign Up-fact = (buf_gds-obj.price-sale - buf_doc-line.price-rubl) / buf_doc-line.price-rubl * 100 .
     7077                            else assign Up-fact = (buf_gds-obj.price-sale - buf_doc-line.price-base) / buf_doc-line.price-base * 100 .
     7078       assign
     7079         qnty    = buf_doc-line.fact-qnty
     7080         Price   = stoim / qnty
     7081         all-qnty    = all-qnty    + qnty
     7082         all-stoim   = all-stoim   + stoim
     7083         v-vat-pc = round(buf_doc-line.vat-pc,1)
     7084         v-slt-pc = round(buf_doc-line.slt-pc,1)
     7085       .
     7086       find first temp-nalog where temp-nalog.vat-prc = v-vat-pc and temp-nalog.slt-prc = v-slt-pc no-error .
     7087       if not available temp-nalog then do:
     7088         create temp-nalog .
     7089         assign  temp-nalog.vat-prc = v-vat-pc  temp-nalog.slt-prc = v-slt-pc  .
     7090       end.
     7091       assign
     7092         temp-nalog.vat-sum = temp-nalog.vat-sum + VAT-sum
     7093         temp-nalog.slt-sum = temp-nalog.slt-sum + SLT-sum
     7094         temp-nalog.from-sum = temp-nalog.from-sum + stoim
     7095       .
     7096       if empty-scale = no and PrintScale = yes then do:
     7097         display stream out_stream
     7098           sym1  Lines_Counter sym2 tb-code sym3 buf_goods.artic sym4 gds_name sym5 buf_goods.unit-base sym6 sym7 sym8 sym9 Up-fact sym10
     7099         with frame val.
     7100         down stream out_stream with frame val .
     7101         run r-inpxl-write-line-data in this-procedure (
     7102                     input Lines_Counter
     7103                   , input tb-code
     7104                   , input buf_goods.artic
     7105                   , input gds_name
     7106                   , input buf_goods.unit-base
     7107                   , input ""
     7108                   , input ""
     7109                   , input ""
     7110                   , input string( Up-fact )
     7111         ).
     7112         for each buf_gds-dtl no-lock
     7113           where buf_gds-dtl.doc-code  = buf_doc-line.doc-code
     7114             and buf_gds-dtl.artic     = buf_doc-line.artic
     7115             and buf_gds-dtl.prod-type = buf_doc-line.prod-type
     7116             and buf_gds-dtl.prod-code = buf_doc-line.prod-code
     7117           :
     7118   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     7119     (input  buf_goods.gds-code
     7120     ,input  buf_gds-dtl.prt-code
     7121     ,output b-code
     7122     ) no-error .
     7123           if error-status :error then do:
     7124             message vss-workfile vss-revision vss-description skip "Ошибка при определении бар-кода признака" skip  "Код товара" buf_goods.gds-code skip  "Код признака" buf_gds-dtl.prt-code skip
     7125             view-as alert-box error .
     7126           end.
     7127           find first buf_gds-prt where buf_gds-prt.node-code  = buf_gds-dtl.prt-code no-lock no-error .
     7128           if not CostPrice then do:
     7129             if PrintRubl then assign Price = buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl .
     7130             else              assign Price = buf_gds-dtl.price-base - buf_gds-dtl.discnt-base .
     7131           end.
     7132           display stream out_stream
     7133             sym1  sym2 string(b-code) @ tb-code sym3 sym4 ('  /'+ buf_gds-prt.f-name)  @  gds_name  sym5 sym6
     7134             Price sym7   buf_gds-dtl.fact-qnty @ qnty  sym8 (buf_gds-dtl.fact-qnty * Price ) @ stoim sym9 sym10
     7135           with frame val.
     7136           down stream out_stream with frame val .
     7137           run r-inpxl-write-line-data in this-procedure (
     7138                     input ""
     7139                   , input string(b-code)
     7140                   , input ""
     7141                   , input ('  /'+ buf_gds-prt.f-name)
     7142                   , input ""
     7143                   , input string( Price )
     7144                   , input string( buf_gds-dtl.fact-qnty )
     7145                   , input string( buf_gds-dtl.fact-qnty * Price )
     7146                   , input ""
     7147           ).
     7148         end.
     7149       end.
     7150       else do:
     7151         display stream out_stream
     7152           sym1 Lines_Counter sym2 tb-code sym3 buf_goods.artic sym4 gds_name sym5 buf_goods.unit-base sym6  Price sym7 qnty sym8 stoim sym9 Up-fact sym10
     7153         with frame val.
     7154         down stream out_stream with frame val .
     7155         run r-inpxl-write-line-data in this-procedure (
     7156                     input Lines_Counter
     7157                   , input tb-code
     7158                   , input buf_goods.artic
     7159                   , input gds_name
     7160                   , input buf_goods.unit-base
     7161                   , input string( Price )
     7162                   , input string( qnty )
     7163                   , input string( stoim )
     7164                   , input string( Up-fact )
     7165         ).
     7166       end.
     7167        end.
     7168       end.
     7169     end.
     7170   end procedure.
     7171   procedure print-itog :
     7172     do on error undo, return error return-value :
     7173     if not PrintRubl then run rep/wp.p (     input p-mainmenu-handle, input all-stoim, output s1, output s2 ) .
     7174     else                  run rep/wp-rub.p (                          input all-stoim, output s1, output s2 ) .
     7175     if is-akt = no then do:
     7176       put stream out_stream Line format "X(136)" skip .
     7177       if PrintRubl then do:
     7178         display stream out_stream sym1 sym2 sym3 sym4 "ИТОГО: " @ gds_name sym5 sym6 sym7 all-qnty @ qnty sym8 all-stoim @ stoim sym9 sym10 with frame rubl.
     7179         down stream out_stream with frame rubl .
     7180       end.
     7181       else do:
     7182         display stream out_stream sym1 sym2 sym3 sym4 "ИТОГО: " @ gds_name sym5 sym6 sym7 all-qnty @ qnty sym8 all-stoim @ stoim sym9 sym10 with frame val.
     7183         down stream out_stream with frame val .
     7184       end.
     7185       put stream out_stream Line format "X(136)" skip .
     7186       run r-inpxl-write-cell-data in this-procedure (
     7187             input "it_qnty":U
     7188           , input string( all-qnty )
     7189       ).
     7190       run r-inpxl-write-cell-data in this-procedure (
     7191             input "it_sum":U
     7192           , input string( all-stoim )
     7193       ).
     7194       if line-counter + 12 > page-size then page .
     7195       put stream Out_stream space(5) "Всего  "   all-qnty     format ">,>>>,>>9.<<<" " единицы  "
     7196                                                 Lines_Counter format ">>>>9" " наименований " format "X(15)"
     7197                                                 "на сумму"  all-stoim  format ">,>>>,>>>,>>>,>>9.99"   " "   s2
     7198                                                 skip(1) .
     7199       run r-inpxl-write-cell-data in this-procedure (
     7200             input "f_lineAmount":U
     7201           , input string( "Всего " + string(all-qnty,">,>>>,>>9.<<<") + " единицы " + string(Lines_Counter,">,>>>,>>9") + " наименований  на сумму " + string(all-stoim,">,>>>,>>>,>>>,>>9.99") + " " +  s2 )
     7202       ).
     7203         PUT STREAM Out_Stream SPACE(5) "Итого к оплате " all-stoim format ">,>>>,>>>,>>9.99" SPACE(2) trim(s2) format "X(4)" .
     7204         put stream Out_stream skip(1) space(10) caps(s1) format "x(126)" skip(1) .
     7205         run r-inpxl-write-cell-data in this-procedure (
     7206               input "f_SumAll":U
     7207             , input string( all-stoim,"->>>,>>>,>>>,>>9.99")
     7208         ).
     7209         run r-inpxl-write-cell-data in this-procedure (
     7210               input "f_SumAllLiteral":U
     7211             , input s1
     7212         ).
     7213         define variable str-nal as character no-undo .
     7214         put stream Out_stream  space(5)  "В том числе: " format "x(25)" skip.
     7215         for each temp-nalog break by temp-nalog.slt-prc by temp-nalog.vat-prc:
     7216             put stream Out_stream
     7217               string( "НДС " + string( temp-nalog.vat-prc, ">>9.<<%")) at 10 format "X(12)"
     7218               ":"  + string( temp-nalog.VAT-sum , "->>>,>>>,>>9.99" ) at 25 format "X(18)"   trim(s2)  " от суммы " format "X(10)"
     7219                string( temp-nalog.from-sum , "->>>,>>>,>>9.99" )  at 65 format "X(16)"   trim(s2) skip
     7220             .
     7221             if str-nal <> "" then assign str-nal = str-nal + "\n" .
     7222             assign
     7223               str-nal = str-nal +
     7224               string( "НДС " + string( temp-nalog.vat-prc, ">>9.<<%")) +  ":" + string( temp-nalog.VAT-sum , "->>>,>>>,>>9.99" ) + trim(s2) + " от суммы "
     7225               + string( temp-nalog.from-sum , "->>>,>>>,>>9.99" ) + trim(s2)
     7226             .
     7227         end.
     7228         run r-inpxl-write-cell-data in this-procedure (
     7229               input "f_Nalog":U
     7230             , input str-nal
     7231         ).
     7232       if buf_trn-doc.status_ = 'факт':U
     7233       then do:
     7234         run rep/get-psn.p
     7235           (input buf_trn-doc.boss
     7236           ,output Mngr_name
     7237           ) .
     7238         run rep/get-psn.p
     7239           (input buf_trn-doc.wrkr
     7240           ,output Wrkr_name
     7241           ) .
     7242         run rep/get-psn.p
     7243           (input buf_trn-doc.agnt
     7244           ,output Isp_name
     7245           ) .
     7246         define variable v-user-name as character no-undo .
     7247   define variable vss-include-info44 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7248   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usrfulnm in g#library
     7249     (input  buf_trn-doc.creid
     7250     ,output v-user-name
     7251     )  .
     7252         if not( v-sys-key = "ia" and CostPrice = no ) then
     7253           put stream Out_stream  skip(1)  space(10)  "Сдал : " format "x(60)"  "Принял : " format "x(50)" skip(1) .
     7254           put stream Out_stream "Документ оформил: " skip
     7255                                 "Оператор         : " at 9 format "X(30)"  v-user-name format "X(60)" skip
     7256                                 "Кладовщик        : " at 9 format "X(30)"  Wrkr_name   format "X(30)" skip
     7257                                 "Менеджер         : " at 9 format "X(30)"  Mngr_name   format "X(30)"  skip
     7258         .
     7259           run r-inpxl-write-cell-data in this-procedure (
     7260                 input "f_OperName":U
     7261               , input  v-user-name
     7262           ).
     7263           run r-inpxl-write-cell-data in this-procedure (
     7264                 input "f_KladName":U
     7265               , input Wrkr_name
     7266           ).
     7267           run r-inpxl-write-cell-data in this-procedure (
     7268                 input "f_MngrName":U
     7269               , input Mngr_name
     7270           ).
     7271         put stream Out_stream space(65) ( if v-torgconf-outdate = no then string( buf_trn-doc.fact-date, "99/99/9999" ) else "" )  format "X(10)"  skip .
     7272         run r-inpxl-write-cell-data in this-procedure (
     7273             input "f_Date":U
     7274           , input ( if v-torgconf-outdate = no then string( buf_trn-doc.fact-date, "99/99/9999" ) else "" )
     7275         ).
     7276       end.
     7277       else do:
     7278         put stream Out_stream  space(30) "--- Н Е   П О Д П И С Ы В А Т Ь ! ---" format "X(75)" skip(1) .
     7279       end.
     7280       hide stream Out_stream frame Bottomframe .
     7281     end.
     7282     else do:
     7283       put stream out_stream Line format "X(136)" skip .
     7284       display stream out_stream sym1 sym2 sym3 sym4 "ИТОГО: " @ gds_name sym5 sym6
     7285             all-qnty @ Price sym7 all-stoim @ qnty sym8 (all-qnty - all-stoim) @ stoim sym9 with frame AKT.
     7286       down stream out_stream with frame AKT .
     7287       put stream out_stream Line format "X(136)" skip .
     7288       put stream Out_stream skip space(20) "Главный бухгалтер ____________" format "X(45)"
     7289                                            "Начальник склада__________" format "X(35)" skip.
     7290       hide stream Out_stream frame Akt-Bottomframe .
     7291     end.
     7292     end.
     7293   end procedure.
