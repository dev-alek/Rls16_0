     6626         ).
     6627         put stream Out_stream string( "Отправитель  : " + buf_clients.obj-name + " (" + buf_clients.obj-type + " " + string(buf_clients.obj-code) + ")" ) at 10 format "X(120)" skip
     6628                 string( "Получатель   : " + Our_Host.obj-name + ",  " + Our_Object.obj-name ) at 10 format "X(125)" skip(1) .
     6629         find buf_pay-type where buf_pay-type.obj-code = buf_trn-doc.pay-code no-lock no-error .
     6630         if buf_trn-doc.internal then do:
     6631           put stream Out_stream "Вид оплаты   : " at 10 format  "x(15)" ( if available buf_pay-type then buf_pay-type.obj-name else "?" ) format "X(60)" skip .
     6632           run r-inpxl-write-cell-data in this-procedure (
     6633               input "h_PayType":U
     6634             , input ( If Available buf_pay-type Then buf_pay-type.Obj-name Else "?" )
     6635           ).
     6636         end.
     6637         else do:
     6638           run torgconf-get-reason in this-procedure ( input buf_trn-doc.doc-code, input buf_trn-doc.reason-code,  input buf_trn-doc.doc-type ) .
     6639           put stream Out_stream "Основание    : " at 10 format  "x(15)"  v-torgconf-reason format "X(110)" skip
     6640              "Инвойс       : " at 10 format "x(15)"  ( if buf_trn-doc.inv-num <> "" then fill(" ", 10 - length(trim(string( buf_trn-doc.inv-num)))) +
     6641               trim(string( buf_trn-doc.inv-num, "x(8)") ) else fill( " ", 8) ) format "X(10)" skip.
     6642           run r-inpxl-write-cell-data in this-procedure (
