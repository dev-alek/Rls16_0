     5455         return error substitute ("Ошибка при поиске НДС для товара &1 &2 &3 документ &4", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code, bf_trn-doc.doc-code).
     5456       end.
     5457       if varcur-slt-pc = ?
     5458       then do:
     5459         return error substitute ("Ошибка при поиске НДС для товара &1 &2 &3 документ &4", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code, bf_trn-doc.doc-code).
     5460       end.
     5461       v-calcbypart = no.
     5462       if bf_doc-line.whole-send-news = integer('1':U)   then
     5463       v-calcbypart = yes.
     5464       else do:
     5465       for each bf_gds-dtl no-lock
     5466         where bf_gds-dtl.doc-code  = bf_doc-line.doc-code
     5467           and bf_gds-dtl.artic     = bf_doc-line.artic
     5468           and bf_gds-dtl.prod-type = bf_doc-line.prod-type
