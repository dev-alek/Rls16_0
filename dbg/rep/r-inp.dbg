     5191   procedure clcprtsl_calc-line :
     5192   define input  parameter parrec-line as recid no-undo.
     5193   define variable v-tax-date         as   date                     no-undo.
     5194   define variable v-vat-pc           like ub.doc-line.vat-pc       no-undo.
     5195   define variable varr-b             as   character                no-undo.
     5196   define variable varr-btype         as   character                no-undo.
     5197   define variable varcur-base        like ub.gds-dtl.price-base    no-undo.
     5198   define variable varcur-road-tax    like ub.doc-line.road-tax     no-undo.
     5199   define variable varcur-excise      like ub.doc-line.excise       no-undo.
     5200   define variable varcur-vat-pc      like ub.doc-line.vat-pc       no-undo.
     5201   define variable varcur-cons-vat-pc like ub.doc-line.cons-vat-pc  no-undo.
     5202   define variable varcur-slt-pc      like ub.doc-line.slt-pc       no-undo.
     5203   define variable varcur-fact-qnty   like ub.gds-dtl.fact-qnty     no-undo.
     5204   define variable varb-code          like ub.bar-code.b-code       no-undo.
     5205   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     5206   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     5207   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     5208   define variable varexcise          like ub.price-list.excise     no-undo.
     5209   define variable varlastcur-base        like ub.gds-dtl.price-base no-undo.
     5210   define variable varlastcur-road-tax    like ub.gds-dtl.price-base no-undo.
     5211   define variable varlastcur-excise      like ub.gds-dtl.price-base     no-undo.
     5212   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     5213   define variable v-varsum           as decimal                  no-undo.
     5214   define variable varprice-salef as decimal   no-undo .
     5215   define buffer bf_trn-doc             for ub.trn-doc.
     5216   define buffer bf_doc-line            for ub.doc-line.
     5217   define buffer bf_gds-dtl             for ub.gds-dtl.
     5218   define buffer bf_goods               for ub.goods.
     5219   define buffer bf_parts               for ub.parts.
     5220   define buffer bf_sysconf             for ub.sysconf.
     5221   define buffer bf_tt-allsum-line      for tt-allsum-line.
     5222   define buffer bfs_tt-allsum-line     for tt-allsum-line.
     5223   define buffer bfo_tt-allsum-line     for tt-allsum-line.
     5224   define buffer bfos_tt-allsum-line    for tt-allsum-line.
     5225   define buffer buf_parts        for ub.parts.
     5226   v-calcbypart = no.
     5227   do on error undo, return error return-value :
     5228   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     5229   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     5230     (output varr-b
     5231     )  .
     5232     find first bf_doc-line where recid (bf_doc-line) = parrec-line no-lock.
     5233     find first bf_trn-doc where bf_trn-doc.doc-code = bf_doc-line.doc-code no-lock.
     5234     find first bf_goods where bf_goods.artic     = bf_doc-line.artic     and
     5235                               bf_goods.prod-type = bf_doc-line.prod-type and
     5236                               bf_goods.prod-code = bf_doc-line.prod-code no-lock.
     5237     if bf_trn-doc.fact-date <> ?        then do:
     5238       assign v-tax-date = bf_trn-doc.fact-date.
     5239     end.
     5240     else do:
     5241       assign v-tax-date = ?.
     5242     end.
     5243   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5244   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     5245     (input  bf_goods.gds-code
     5246     ,input  '1':U
     5247     ,input  v-tax-date
     5248     ,input  bf_trn-doc.host-code
     5249     ,input  bf_trn-doc.obj-type
     5250     ,input  bf_trn-doc.obj-code
     5251     ,output v-vat-pc
     5252     ) no-error .
     5253     if error-status :error
     5254     or v-vat-pc = ? then do:
     5255        return error substitute ("Ошибка при поиске НДС для товара &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     5256     end.
     5257     if bf_goods.gds-type = 'у':U or
     5258        bf_trn-doc.status_ = 'запрос':U then do:
     5259       for each bf_tt-allsum-line
     5260       on error undo, return error return-value
     5261        :
     5262         delete bf_tt-allsum-line.
     5263       end.
     5264       create bf_tt-allsum-line.
     5265       assign
     5266        bf_tt-allsum-line.sum-type = 'основная_сумма':U.
     5267       for each bf_gds-dtl where bf_gds-dtl.doc-code  = bf_doc-line.doc-code  and
     5268                                 bf_gds-dtl.artic     = bf_doc-line.artic     and
     5269                                 bf_gds-dtl.prod-type = bf_doc-line.prod-type and
     5270                                 bf_gds-dtl.prod-code = bf_doc-line.prod-code no-lock on error undo, return error return-value :
     5271         assign
     5272           bf_tt-allsum-line.fact-qnty            =  bf_tt-allsum-line.fact-qnty        + bf_gds-dtl.fact-qnty
     5273           bf_tt-allsum-line.sum-dsc-base-doc     =  bf_tt-allsum-line.sum-dsc-base-doc + (bf_gds-dtl.price-base - bf_gds-dtl.discnt-base) * bf_gds-dtl.fact-qnty
     5274           bf_tt-allsum-line.sum-dsc-rubl-doc     =  bf_tt-allsum-line.sum-dsc-rubl-doc + (bf_gds-dtl.price-rubl - bf_gds-dtl.discnt-rubl) * bf_gds-dtl.fact-qnty
     5275           bf_tt-allsum-line.dsc-base-doc         =  bf_tt-allsum-line.dsc-base-doc     + bf_gds-dtl.discnt-base * bf_gds-dtl.fact-qnty
     5276           bf_tt-allsum-line.dsc-rubl-doc         =  bf_tt-allsum-line.dsc-rubl-doc     + bf_gds-dtl.discnt-rubl * bf_gds-dtl.fact-qnty
     5277           bf_tt-allsum-line.sum-dsc-base-cur     =  bf_tt-allsum-line.sum-dsc-base-cur + (if varr-b = "base" then bf_gds-dtl.cur-base else bf_gds-dtl.cur-base / bf_trn-doc.exch-rate * bf_trn-doc.exch-scale) * bf_gds-dtl.fact-qnty
     5278           bf_tt-allsum-line.sum-dsc-rubl-cur     =  bf_tt-allsum-line.sum-dsc-rubl-cur + (if varr-b = "rubl" then bf_gds-dtl.cur-base else bf_gds-dtl.cur-base * bf_trn-doc.exch-rate / bf_trn-doc.exch-scale) * bf_gds-dtl.fact-qnty
     5279           bf_tt-allsum-line.sum-dsc-base-acc     =  bf_tt-allsum-line.sum-dsc-base-acc + bf_doc-line.price-base * bf_gds-dtl.fact-qnty
     5280           bf_tt-allsum-line.sum-dsc-rubl-acc     =  bf_tt-allsum-line.sum-dsc-rubl-acc + bf_doc-line.price-rubl * bf_gds-dtl.fact-qnty
     5281           bf_tt-allsum-line.sum-dsc-cli-acc      =  ?
     5282           bf_tt-allsum-line.vat-base-acc         =  bf_tt-allsum-line.vat-base-acc     + bf_doc-line.price-base * v-vat-pc / (100 + v-vat-pc) * bf_gds-dtl.fact-qnty
     5283           bf_tt-allsum-line.vat-rubl-acc         =  bf_tt-allsum-line.vat-rubl-acc     + bf_doc-line.price-rubl * v-vat-pc / (100 + v-vat-pc) * bf_gds-dtl.fact-qnty
     5284           bf_tt-allsum-line.vat-cli-acc          =  ?
     5285           .
     5286       end.
     5287       assign
     5288         bf_tt-allsum-line.cli-qnty             =  ?
     5289         bf_tt-allsum-line.slt-base-doc         =  bf_tt-allsum-line.sum-dsc-base-doc * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     5290         bf_tt-allsum-line.slt-rubl-doc         =  bf_tt-allsum-line.sum-dsc-rubl-doc * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     5291         bf_tt-allsum-line.vat-base-buyer-doc   =  (bf_tt-allsum-line.sum-dsc-base-doc - bf_tt-allsum-line.slt-base-doc) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     5292         bf_tt-allsum-line.vat-rubl-buyer-doc   =  (bf_tt-allsum-line.sum-dsc-rubl-doc - bf_tt-allsum-line.slt-rubl-doc) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
