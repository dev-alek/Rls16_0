      915   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
      916         adm-object-hdl = FRAME F-Main:HANDLE.
      917   RUN ensure-broker.
      918   THIS-PROCEDURE:ADM-DATA =
      919        'ADM1.1~`':U +
      920        'SmartViewer~`':U +
      921        '~`':U +
      922        'NO ~`':U +
      923        '~`':U +
      924        '~`':U +
      925        '~`':U +
      926        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
      927           + "~`":U +
      928        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add~`':U +
      929        'Record-Source,Record-Target,TableIO-Target~`':U +
      930        '~`':U +
      931        '~`~`~`~`~`~`~`~`~`~`~`':U +
      932        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
      933            THEN "^^":U
      934        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
      935             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
      936   PROCEDURE adm-apply-entry :
      937     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      938   END PROCEDURE.
      939   PROCEDURE adm-destroy :
      940    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      941   END PROCEDURE.
      942   PROCEDURE adm-disable :
      943       DISABLE RECT-14 RECT-15 RECT-16 RECT-12 ie VAT-SLT ee VAT-SLT-s ep CostSum es DispUpFact re Serv rs we NullPer vt iv CalcRest ev rv em wm im ot ap EDITOR-1 pc mp WITH FRAME F-Main.
      944       RUN dispatch ('disable-fields':U).
      945       RUN set-attribute-list ('ENABLED=no':U).
      946       RETURN.
      947   END PROCEDURE.
      948   PROCEDURE adm-edit-attribute-list :
      949         RUN adm/support/viewerd.w (INPUT THIS-PROCEDURE).
      950         RETURN.
      951   END PROCEDURE.
      952   PROCEDURE adm-enable :
      953       ENABLE UNLESS-HIDDEN RECT-14 RECT-15 RECT-16 RECT-12 ie VAT-SLT ee VAT-SLT-s ep CostSum es DispUpFact re Serv rs we NullPer vt iv CalcRest ev rv em wm im ot ap EDITOR-1 pc mp WITH FRAME F-Main.
      954       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
      955       RUN set-attribute-list ('ENABLED=yes':U).
      956       RETURN.
      957   END PROCEDURE.
      958   PROCEDURE adm-exit :
      959        RUN notify ('exit':U).
      960     RETURN.
      961   END PROCEDURE.
      962   PROCEDURE adm-hide :
      963     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      964   END PROCEDURE.
      965   PROCEDURE adm-initialize :
      966     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      967   END PROCEDURE.
      968   PROCEDURE adm-show-errors :
      969       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
      970       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
      971           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
      972       END.
      973       RETURN.
      974   END PROCEDURE.
      975   PROCEDURE adm-UIB-mode :
      976     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      977   END PROCEDURE.
      978   PROCEDURE adm-view :
      979     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      980   END PROCEDURE.
      981   PROCEDURE dispatch :
      982       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
      983       RUN broker-dispatch IN adm-broker-hdl
      984           (THIS-PROCEDURE, p-method-name) NO-ERROR.
      985       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
      986   END PROCEDURE.
      987   PROCEDURE ensure-broker :
      988   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
      989   IF RETURN-VALUE NE "ADM-Broker":U THEN
      990   DO:
      991       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
      992       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
      993   END.
      994   END PROCEDURE.
      995   PROCEDURE get-attribute :
      996     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
      997     RUN broker-get-attribute IN adm-broker-hdl
      998         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
      999     RETURN RETURN-VALUE.
     1000   END PROCEDURE.
     1001   PROCEDURE get-attribute-list :
     1002     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
     1003     RUN broker-get-attribute-list IN adm-broker-hdl
     1004         (INPUT THIS-PROCEDURE,
     1005          INPUT ?,
     1006          OUTPUT p-attr-list) NO-ERROR.
     1007     RETURN.
     1008   END PROCEDURE.
     1009   PROCEDURE new-state :
     1010     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     1011     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
     1012     RETURN.
     1013   END PROCEDURE.
     1014   PROCEDURE notify :
     1015     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
     1016     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
     1017     IF RETURN-VALUE = "ADM-ERROR":U THEN
     1018         RETURN "ADM-ERROR":U.
     1019     RETURN.
     1020   END PROCEDURE.
     1021   PROCEDURE set-attribute-list :
     1022     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
     1023     RUN ensure-broker.
     1024     RUN broker-set-attribute-list IN adm-broker-hdl
     1025         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
     1026     RETURN.
     1027   END PROCEDURE.
     1028   PROCEDURE set-position :
     1029       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
     1030       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
     1031       IF VALID-HANDLE(adm-object-hdl) THEN
     1032       DO:
     1033         ASSIGN adm-object-hdl:ROW    =   p-row
     1034                adm-object-hdl:COLUMN =   p-col.
     1035       END.
     1036       RETURN.
     1037   END PROCEDURE.
     1038   PROCEDURE adm-display-fields :
     1039       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
     1040       RETURN.
     1041   END PROCEDURE.
     1042   PROCEDURE adm-open-query :
