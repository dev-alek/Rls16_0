      908   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
      909   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
      910   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
