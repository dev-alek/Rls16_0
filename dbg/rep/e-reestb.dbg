     1690   PROCEDURE my-var :
     1691   assign frame F-Main ie ee ep es re rs we vt iv ev rv em wm im ot ap pc mp
     1692    VAT-SLT VAT-SLT-s
     1693    CostSum DispUpFact
     1694    Serv  NullPer CalcRest.
     1695   ReportNAme = "Р Е Е С Т Р   Д О К У М Е Н Т О В  ( Т О В А Р Н Ы Й   О Т Ч Е Т )".
     1696   ReportHeader = IF VAT-SLT THEN VAT-SLT:label + chr(10) Else "" .
     1697   ReportHeader = (ReportHeader) + IF VAT-SLT-s   THEN VAT-SLT-s:label + chr(10) Else "" .
     1698   ReportHeader = (ReportHeader) + IF CostSum     THEN CostSum:label + chr(10) Else "".
     1699   ReportHeader = (ReportHeader) + IF DispUpFact  THEN DispUpFact:label + chr(10) Else "" .
     1700   ReportHeader = (ReportHeader) + IF  Serv       THEN Serv:label + chr(10) Else "" .
     1701   ReportHeader = (ReportHeader) + IF  NullPer    THEN NullPer:label + chr(10) Else "без нулевых остатков по переоценке" + chr(10) .
     1702   ReportHeader = (ReportHeader) + IF  CalcRest   THEN CalcRest:label + chr(10) Else ""  .
     1703   ReportHeader = (ReportHeader) + "документы : "  + chr(10).
     1704   ReportHeader = (ReportHeader)               + IF  ie THen      (ie:label) + ","  else " " .
     1705   ReportHeader = (ReportHeader)               + IF  ee then      (ee:label) + ","  else " ".
     1706   ReportHeader = (ReportHeader)               + IF  ep then      (ep:label) + ","  else " ".
     1707   ReportHeader = (ReportHeader)               + IF  es THen      (es:label) + ","  else " ".
     1708   ReportHeader = (ReportHeader)               + IF  re then      (re:label) + ","  else " ".
     1709   ReportHeader = (ReportHeader) +  chr(10).
     1710   ReportHeader = (ReportHeader)               + IF  rs then      (rs:label) + ","  else " ".
     1711   ReportHeader = (ReportHeader)               + IF  we THen      (we:label) + ","  else " ".
     1712   ReportHeader = (ReportHeader)               + IF  vt then      (vt:label) + ","  else " ".
     1713   ReportHeader = (ReportHeader)               + IF  iv then      (iv:label) + ","  else " ".
     1714   ReportHeader = (ReportHeader)               + IF  ev THen      (ev:label) + ","  else " ".
     1715   ReportHeader = (ReportHeader) +  chr(10).
     1716   ReportHeader = (ReportHeader)               + IF  rv then      (rv:label) + ","  else " ".
     1717   ReportHeader = (ReportHeader)               + IF  em then      (em:label) + ","  else " " .
     1718   ReportHeader = (ReportHeader)               + IF  wm THen      wm:label + ","  else " " .
     1719   ReportHeader = (ReportHeader)               + IF  im then      im:label + ","  else " ".
     1720   ReportHeader = (ReportHeader)               + IF  ap then      ap:label + ","  else " ".
     1721   ReportHeader = (ReportHeader)               + IF  pc then      pc:label + ","  else " ".
     1722   ReportHeader = (ReportHeader)               + IF  mp then      mp:label + ","  else " ".
     1723   ReportHeader = (ReportHeader)               + IF  ot then      ot:label        else " " .
     1724    sheetf.Excel-Column-Lable =
     1725              "Дата закрытия"
     1726     + ","  + "№ документа"
     1727     + ","  + "Контрагент"
