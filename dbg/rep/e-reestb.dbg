     1098        "must have at least one Enabled Table to perform Copy.":U
     1099          VIEW-AS ALERT-BOX ERROR.
     1100       RETURN.
     1101   END PROCEDURE.
     1102   PROCEDURE adm-create-record :
     1103      RETURN.
     1104   END PROCEDURE.
     1105   PROCEDURE adm-current-changed :
     1106     RETURN.
     1107   END PROCEDURE.
     1108   PROCEDURE adm-delete-record :
     1109    MESSAGE
     1110          "Object ":U THIS-PROCEDURE:FILE-NAME
     1111            "must have at least one Enabled Table to perform Delete.":U
     1112              VIEW-AS ALERT-BOX ERROR.
     1113       RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
