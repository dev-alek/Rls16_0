      677   def var vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      678   function func-get-name-from-ext-type   returns char
      679     ( p-ext-type as character   ,
      680       p-caps     as logical ).
      681   define variable v-ext-name as character no-undo .
      682   run get-name-from-ext-type in this-procedure (
      683       input p-ext-type  ,
      684       input p-caps  ,
      685       output v-ext-name )
      686       no-error .
      687       if error-status :error then do:
      688          assign
      689            v-ext-name = p-ext-type
      690          .
      691       end.
      692    return (v-ext-name) .
      693   end.
      694   procedure get-name-from-ext-type :
      695    do
      696    on error undo, return error return-value
      697    :
      698   define input  parameter p-ext-type as character no-undo .
      699   define input  parameter p-caps     as logical no-undo   .
      700   define output parameter p-ext-name as character no-undo .
      701   define variable v-num as integer no-undo .
      702     if lookup ( p-ext-type , 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U ) = 0 then do :
      703       message
      704         vss-include-info13 skip
      705         "Неправильно задано значение входящего параметра! "
      706         "Нет такого типа документов " p-ext-type
      707         view-as alert-box error .
      708         undo, return error .
      709     end.
      710     v-num      = lookup ( p-ext-type , 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U ) .
      711     p-ext-name = entry  ( v-num , 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U ) .
      712     if p-caps  = true then do :
      713        p-ext-name = caps(substring(p-ext-name,1,1) ) + substring(p-ext-name, 2 , length (p-ext-name) - 1 ) .
      714     end .
      715     end.
      716   end procedure.
      717   define temp-table param-to-export no-undo
      718   field param-code     as character
      719   field param-sub-code as character
      720   field param-type     as character
      721   field param-value    as character
      722   field param-comment  as character
      723   index pi is unique primary  param-code     param-sub-code
      724   .
      725   procedure create-param-to-export :
      726    do
      727    on error undo, return error return-value
      728    :
      729    define input parameter p1 as character no-undo .
      730    define input parameter p2 as character no-undo .
      731    define input parameter p3 as character no-undo .
      732    define input parameter p4 as character no-undo .
      733    define input parameter p5 as character no-undo .
      734     create  param-to-export.
      735     assign
      736        param-to-export.param-code     =  p1
      737        param-to-export.param-sub-code =  p2
      738        param-to-export.param-type     =  p3
      739        param-to-export.param-value    =  p4
      740        param-to-export.param-comment  =  p5
      741     .
      742    end.
      743   end procedure.
