     1129   PROCEDURE adm-update-record :
     1130       MESSAGE
     1131         "Object ":U THIS-PROCEDURE:FILE-NAME
     1132           "must have at least one Enabled Table to perform Update.":U
     1133             VIEW-AS ALERT-BOX ERROR.
     1134      RETURN.
     1135   END PROCEDURE.
     1136   PROCEDURE check-modified :
     1137   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
     1138   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
     1139   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
     1140   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
     1141     IF check-state = "check":U THEN
     1142     DO:
     1143       RUN get-link-handle IN adm-broker-hdl
     1144         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
     1145            OUTPUT group-target-list).
     1146       IF group-target-list NE "":U THEN
     1147       DO i = 1 TO NUM-ENTRIES(group-target-list):
     1148         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
     1149         RUN check-modified IN curr-widget ('group-check':U).
     1150         IF RETURN-VALUE NE "":U THEN
     1151         DO:
     1152           RUN check-modified-message(RETURN-VALUE).
     1153           RETURN "":U.
     1154         END.
     1155       END.
     1156     END.
     1157     RETURN "":U.
     1158   END PROCEDURE.
     1159   PROCEDURE check-modified-message :
     1160     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
     1161        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
     1162           'CONTAINER-SOURCE':U, 'HIDDEN':U).
     1163        IF RETURN-VALUE = "YES":U THEN
     1164           RUN notify ('view,CONTAINER-SOURCE':U).
     1165        MESSAGE IF p-changed-table NE ? THEN
     1166           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
     1167           ELSE "Current values have been changed."
     1168           SKIP "  Do you wish to save those changes?"
     1169           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
     1170        IF ANS THEN
     1171        DO:
     1172           IF group-assign-target THEN
     1173             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
     1174           ELSE RUN dispatch('update-record':U).
     1175           IF RETURN-VALUE = "ADM-ERROR":U THEN
     1176           DO:
     1177               MESSAGE "Changes to the previous record were not saved."
     1178                 VIEW-AS ALERT-BOX ERROR.
     1179               IF group-assign-target THEN
     1180                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1181               ELSE RUN dispatch ('cancel-record':U).
     1182           END.
     1183        END.
     1184        ELSE DO:
     1185          IF group-assign-target THEN
     1186             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1187          ELSE RUN dispatch('cancel-record':U).
     1188        END.
     1189        RETURN.
     1190   END PROCEDURE.
     1191   PROCEDURE get-rowid :
     1192       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
     1193       ASSIGN
     1194       p-table   =   adm-first-table.
     1195       RETURN.
     1196   END PROCEDURE.
     1197   PROCEDURE init-group-assign :
     1198       RUN request-attribute IN adm-broker-hdl
     1199         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
     1200       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
     1201         group-assign-target = yes.
     1202       ELSE group-assign-target = no.
     1203       RETURN.
     1204   END PROCEDURE.
     1205   PROCEDURE set-editors :
     1206       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
     1207       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
     1208       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
     1209       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
     1210       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
     1211       DO WHILE VALID-HANDLE (curr-widget):
     1212           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
     1213              curr-widget:HIDDEN = no THEN DO:
     1214             CASE p-field-setting:
     1215               WHEN "INITIALIZE":U THEN
     1216               DO:
     1217                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
     1218                     read-only-list +
     1219                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
     1220                        STRING(curr-widget).
     1221               END.
     1222               WHEN "DISABLE":U OR
     1223               WHEN "ENABLE":U THEN
     1224               DO:
     1225                   curr-widget:SENSITIVE = yes.
     1226                   RUN get-attribute ('Read-Only-Editors':U).
     1227                   IF RETURN-VALUE = ? OR
     1228                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
     1229                       curr-widget:READ-ONLY =
     1230                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
     1231               END.
     1232               WHEN "CLEAR":U THEN
     1233                   curr-widget:SCREEN-VALUE = "":U.
     1234             END CASE.
     1235           END.
     1236           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
     1237       END.
     1238       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
     1239         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
     1240           + '"':U).
     1241       RETURN.
     1242   END PROCEDURE.
     1243   PROCEDURE use-check-modified-all :
     1244    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1245     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
     1246     RETURN.
     1247   END PROCEDURE.
     1248   PROCEDURE use-create-on-add :
     1249   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1250      RETURN.
     1251   END PROCEDURE.
     1252   PROCEDURE use-initial-lock :
     1253     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1254     ASSIGN adm-initial-lock = p-attr-value.
     1255     RETURN.
     1256   END PROCEDURE.
     1257     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
     1258   ASSIGN
     1259          FRAME F-Main:SCROLLABLE       = FALSE
     1260          FRAME F-Main:HIDDEN           = TRUE.
     1261   ASSIGN
     1262          EDITOR-1:READ-ONLY IN FRAME F-Main        = TRUE.
     1263   ON VALUE-CHANGED OF ap IN FRAME F-Main
     1264   DO:
     1265     run calc-rest in this-procedure .
     1266   END.
     1267   ON VALUE-CHANGED OF ee IN FRAME F-Main
     1268   DO:
     1269     run calc-rest in this-procedure .
     1270   END.
     1271   ON VALUE-CHANGED OF em IN FRAME F-Main
     1272   DO:
     1273     run calc-rest in this-procedure .
     1274   END.
     1275   ON VALUE-CHANGED OF ep IN FRAME F-Main
     1276   DO:
     1277     run calc-rest in this-procedure .
     1278   END.
     1279   ON VALUE-CHANGED OF es IN FRAME F-Main
     1280   DO:
     1281       run calc-rest in this-procedure .
     1282   END.
     1283   ON VALUE-CHANGED OF ev IN FRAME F-Main
     1284   DO:
     1285     run calc-rest in this-procedure .
     1286   END.
     1287   ON VALUE-CHANGED OF ie IN FRAME F-Main
     1288   DO:
     1289     run calc-rest in this-procedure .
     1290   END.
     1291   ON VALUE-CHANGED OF im IN FRAME F-Main
     1292   DO:
     1293     run calc-rest in this-procedure .
     1294   END.
     1295   ON VALUE-CHANGED OF iv IN FRAME F-Main
     1296   DO:
     1297     run calc-rest in this-procedure .
     1298   END.
     1299   ON VALUE-CHANGED OF mp IN FRAME F-Main
     1300   DO:
     1301     run calc-rest in this-procedure .
     1302   END.
     1303   ON VALUE-CHANGED OF ot IN FRAME F-Main
     1304   DO:
     1305     run calc-rest in this-procedure .
     1306   END.
     1307   ON VALUE-CHANGED OF pc IN FRAME F-Main
     1308   DO:
     1309     run calc-rest in this-procedure .
     1310   END.
     1311   ON VALUE-CHANGED OF re IN FRAME F-Main
     1312   DO:
     1313     run calc-rest in this-procedure .
     1314   END.
     1315   ON VALUE-CHANGED OF rs IN FRAME F-Main
     1316   DO:
     1317     run calc-rest in this-procedure .
     1318   END.
     1319   ON VALUE-CHANGED OF rv IN FRAME F-Main
     1320   DO:
     1321     run calc-rest in this-procedure .
     1322   END.
     1323   ON VALUE-CHANGED OF Serv IN FRAME F-Main
     1324   DO:
     1325     assign serv.
     1326     if serv then DO:
     1327          CalcRest = false.
     1328          disable CalcRest with frame F-Main.
     1329          display CalcRest with frame F-Main.
     1330          End.
     1331        Else do:
     1332          enable CalcRest with frame F-Main.
     1333          display CalcRest with frame F-Main.
     1334          End.
     1335   END.
     1336   ON VALUE-CHANGED OF vt IN FRAME F-Main
     1337   DO:
     1338       run calc-rest in this-procedure .
     1339   END.
     1340   ON VALUE-CHANGED OF we IN FRAME F-Main
     1341   DO:
     1342     run calc-rest in this-procedure .
     1343   END.
     1344   ON VALUE-CHANGED OF wm IN FRAME F-Main
     1345   DO:
     1346     run calc-rest in this-procedure .
     1347   END.
     1348   define variable  list-com-hand as character no-undo .
     1349   list-com-hand = "" .
     1350   list-com-hand = list-com-hand + string(ie:handle) + "," .
     1351   list-com-hand = list-com-hand + string(ee:handle) + "," .
     1352   list-com-hand = list-com-hand + string(ep:handle) + "," .
     1353   list-com-hand = list-com-hand + string(es:handle) + "," .
     1354   list-com-hand = list-com-hand + string(re:handle) + "," .
     1355   list-com-hand = list-com-hand + string(rs:handle) + "," .
     1356   list-com-hand = list-com-hand + string(we:handle) + "," .
     1357   list-com-hand = list-com-hand + string(vt:handle) + "," .
     1358   list-com-hand = list-com-hand + string(iv:handle) + "," .
     1359   list-com-hand = list-com-hand + string(ev:handle) + "," .
     1360   list-com-hand = list-com-hand + string(rv:handle) + "," .
     1361   list-com-hand = list-com-hand + string(em:handle) + "," .
     1362   list-com-hand = list-com-hand + string(wm:handle) + "," .
     1363   list-com-hand = list-com-hand + string(im:handle) + "," .
     1364   list-com-hand = list-com-hand + string(ot:handle) + "," .
     1365   list-com-hand = list-com-hand + string(ap:handle) + "," .
     1366   list-com-hand = list-com-hand + string(pc:handle) + "," .
     1367   list-com-hand = list-com-hand + string(mp:handle) + "," .
     1368   PROCEDURE calc-rest :
     1369   assign FRAME F-Main ie ee ep es re rs we vt iv ev rv em wm im ot ap pc mp    .
     1370   if  ie
     1371   AND ee
     1372   AND  ep
     1373   AND  es
     1374   AND  re
     1375   AND  rs
     1376   AND  we
     1377   AND  vt
     1378   AND  iv
     1379   AND  ev
     1380   AND  rv
     1381   AND  em
     1382   AND  wm
     1383   AND  im
     1384   AND  ot
     1385   AND  ap
     1386   AND  pc
     1387      then
     1388       do:
     1389           assign CalcRest = yes.
     1390           DISPLAY CalcRest WITH FRAME F-Main.
     1391           ENABLE CalcRest WITH FRAME F-Main.
     1392       end.
     1393   else
     1394       do:
     1395           assign CalcRest = no.
     1396           DISPLAY CalcRest WITH FRAME F-Main.
     1397           DISABLE CalcRest WITH FRAME F-Main.
     1398       end.
     1399   END PROCEDURE.
     1400   PROCEDURE disable_UI :
     1401     HIDE FRAME F-Main.
     1402     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1403   END PROCEDURE.
     1404   PROCEDURE enable_UI :
     1405     DISPLAY ie VAT-SLT ee VAT-SLT-s ep CostSum es DispUpFact re Serv rs we NullPer
     1406             vt iv CalcRest ev rv em wm im ot ap EDITOR-1 pc mp
     1407         WITH FRAME F-Main.
     1408     ENABLE RECT-14 RECT-15 RECT-16 RECT-12 ie VAT-SLT ee VAT-SLT-s ep CostSum es
     1409            DispUpFact re Serv rs we NullPer vt iv CalcRest ev rv em wm im ot ap
     1410            EDITOR-1 pc mp
     1411         WITH FRAME F-Main.
     1412   END PROCEDURE.
     1413   PROCEDURE local-initialize :
     1414     run dispatch IN THIS-PROCEDURE ( INPUT 'initialize':U ) .
     1415   define variable vss-include-info14 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1416   do:
     1417     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1418       (input  v-cntxt-db-num
     1419       ,input  v-cntxt-userid
     1420       ,input  0
     1421       ,input  'actn_reports_lookup-cost':U
     1422       ,input  'object':U
     1423       ,input  v-cntxt-host-code-obj
     1424       ,input  v-cntxt-obj-type
     1425       ,input  v-cntxt-obj-code
     1426       ,input  0
     1427       ,input  0
     1428       ,input  0
     1429       ,input  false
     1430       ,output g#log
     1431       )  .
     1432   end.
     1433      if not  g#log then do :
     1434      CostSum = false .
     1435      DispUpFact = false .
     1436      disable CostSum DispUpFact  with frame F-Main .
     1437      display CostSum  DispUpFact with frame F-Main .
     1438    end.
     1439   define variable lab-handle as handle no-undo .
     1440   define variable i as integer no-undo .
     1441   define variable v-code as character no-undo .
     1442   define variable v-nn as integer   no-undo .
     1443   v-nn = num-entries (list-com-hand) .
     1444   do i = 1 to v-nn :
     1445    lab-handle = widget-handle (entry( i , list-com-hand) ) no-error .
     1446    if valid-handle(lab-handle) = true and  error-status :error = false   then do:
     1447       v-code = lab-handle:name.
     1448       lab-handle:label = func-get-name-from-ext-type ( v-code, true  ) .
     1449       end.
     1450   end.
     1451   END PROCEDURE.
