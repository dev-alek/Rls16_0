     1044   END PROCEDURE.
     1045   PROCEDURE adm-row-changed :
     1046         IF VALID-HANDLE(adm-object-hdl) THEN
     1047           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     1048         RUN notify ('row-available':U).
     1049         RETURN.
