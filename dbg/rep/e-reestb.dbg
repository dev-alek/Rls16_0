     1910     ( input 'reportname'  ,
     1911      input ''  ,
     1912      input 'character'  ,
     1913      input reportname  ,
     1914      input 'название отчета' )
     1915    .
     1916     run create-param-to-export  in this-procedure
     1917     ( input 'select-good'  ,
     1918      input ''  ,
     1919      input 'integer'  ,
     1920      input string(x-selectgood)  ,
     1921      input 'тип выбора товара all=1 grp=2 prod=3 choice=4 one=5 grp-prod=6' )
     1922    .
     1923    define variable ii as integer no-undo .
     1924    define variable ii-name as character no-undo .
     1925    define variable ii-1 as integer no-undo .
     1926    define variable ii-name-1 as character no-undo .
     1927     define variable ii-2 as integer no-undo .
     1928    define variable ii-name-2 as character no-undo .
     1929    define variable ii-3 as integer no-undo .
     1930    define variable ii-name-3 as character no-undo .
     1931    if x-selectgood = 1     Or
     1932       x-selectgood = 2     Or
     1933       x-selectgood = 3    Or
     1934       x-selectgood = 4  then do:
     1935    ii = 0.
     1936         for each gds-list :
     1937           ii = ii + 1 .
     1938           if ii = 1 then ii-name = "список товаров - содержит gds-code  (уникальный ключ товара)" .
     1939                     else ii-name = "" .
     1940     run create-param-to-export  in this-procedure
     1941     ( input 'gds-list'  ,
     1942      input string(ii)  ,
     1943      input 'integer'  ,
     1944      input string(gds-list.gds-code)  ,
     1945      input ii-name )
     1946    .
     1947         end.
     1948    end.
     1949    if x-selectgood = 2 then do:
     1950    ii-2 = 0.
     1951         for each tmp#grp :
     1952           ii-2 = ii-2 + 1 .
     1953           if ii-2 = 1 then ii-name-2 = "список товаров - содержит  <node-code#grp-name>  (уникальный ключ списка групп)" .
     1954                     else ii-name-2 = "" .
     1955     run create-param-to-export  in this-procedure
     1956     ( input 'tmp#grp'  ,
     1957      input string(ii-2)  ,
     1958      input 'integer character '  ,
     1959      input string(tmp#grp.node-code) + '#' +  (tmp#grp.grp-name)  ,
     1960      input ii-name-2 )
     1961    .
     1962         end.
     1963    end.
     1964    if x-selectgood = 3 then do:
     1965    ii-3 = 0.
     1966         for each g#cli :
     1967           ii-3 = ii-3 + 1 .
     1968           if ii-3 = 1 then ii-name-3 = "список товаров - содержит  <node-code#grp-name>  (уникальный ключ списка производителе)" .
     1969                       else ii-name-3 = "" .
     1970     run create-param-to-export  in this-procedure
     1971     ( input 'g#cli'  ,
     1972      input string(ii-3)  ,
     1973      input 'character integer'  ,
     1974      input g#cli.obj-type + '#' + string(g#cli.obj-code)  ,
     1975      input ii-name-3 )
     1976    .
     1977         end.
     1978    end.
     1979     run create-param-to-export  in this-procedure
     1980     ( input 'select-object'  ,
     1981      input ''  ,
     1982      input 'character'  ,
     1983      input x-selectobject  ,
     1984      input 'тип выбора объекта   -currency -choice -firm -все' )
     1985    .
     1986    ii-1 = 0.
     1987     for each obj-list :
     1988       ii-1 = ii-1 + 1 .
     1989       if ii-1 = 1 then ii-name-1 = "список объектов - содержит <obj-type#obj-code>  (уникальный ключ clients)" .
     1990                 else ii-name-1 = "" .
     1991     run create-param-to-export  in this-procedure
     1992     ( input 'obj-list'  ,
     1993      input string(ii-1)  ,
     1994      input 'character integer'  ,
     1995      input obj-list.obj-type + '#' + string (obj-list.obj-code)  ,
     1996      input ii-name-1 )
     1997    .
     1998     end.
     1999     run create-param-to-export  in this-procedure
     2000     ( input 'vat-slt'                             ,
     2001      input ''                                    ,
     2002      input 'logical'                             ,
     2003      input string(vat-slt,'yes/no')              ,
