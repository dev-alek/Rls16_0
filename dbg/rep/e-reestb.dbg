     1051   PROCEDURE reposition-query :
     1052       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
     1053       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
     1054       RETURN.
     1055   END PROCEDURE.
     1056     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
     1057     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
     1058     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
     1059     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
     1060     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
     1061     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
     1062     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
     1063     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
     1064     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1065     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
     1066     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1067     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
     1068     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
     1069     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
     1070     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
     1071     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
     1072     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
     1073     IF "":U = "":U THEN
     1074       RUN modify-list-attribute IN adm-broker-hdl
     1075         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
     1076     RUN use-create-on-add(?).
     1077   PROCEDURE adm-add-record :
     1078       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     1079          "must have at least one Enabled Table to perform Add.":U
