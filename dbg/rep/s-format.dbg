       77   def
       78    shared
       79   temp-table  obj-list no-undo
       80     field obj-type like ub.clients.obj-type
       81     field obj-code like ub.clients.obj-code
       82     field obj-name like ub.clients.obj-name
       83     field obj-id   as integer
