      495     Col-name[242]=   'IH':U
      496     Col-name[243]=   'II':U
      497     Col-name[244]=   'IJ':U
      498     Col-name[245]=   'IK':U
      499     Col-name[246]=   'IL':U
      500     Col-name[247]=   'IM':U
      501     Col-name[248]=   'IN':U
      502     Col-name[249]=   'IO':U
      503     Col-name[250]=   'IP':U
      504     Col-name[251]=   'IQ':U
      505     Col-name[252]=   'IR':U
      506     Col-name[253]=   'IS':U
      507     Col-name[254]=   'IT':U
      508     Col-name[255]=   'IU':U
      509     Col-name[256]=   'IV':U
      510     .
      511    end.
      512   end procedure.
      513   define variable var-report-r-b as character no-undo .
      514   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      515   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      516     (output var-report-r-b
      517     )  .
      518   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      519   define  shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      520   define  shared variable RepPathName        as character no-undo .
      521   define  shared variable PrintRubl          as logical   no-undo .
      522   define temp-table temp-font no-undo
      523     field fontnum  as integer
      524     field fontname as character
      525     field fontsize as character
      526     field fonttype as character
      527     field font-h   as integer
      528     field font-w   as integer
      529     field v-row    as integer
      530     field v-col    as integer
      531     field v-row-lans as integer
      532     field v-col-lans as integer
      533   index pi fontnum
      534   .
      535   procedure get-font-ini :
      536     do
      537     on error undo, return error return-value
      538     :
      539   define variable ii as integer   no-undo .
      540   define variable v-font7 as character no-undo .
      541   define variable v-font as character no-undo .
      542   define variable loc-name as character no-undo .
      543   define variable loc-size as character no-undo .
      544   define variable loc-type as character no-undo .
      545   define variable old_H as integer   no-undo .
      546   define variable old_w as integer   no-undo .
      547   define variable old-row  as integer   no-undo .
      548   define variable old-col  as integer   no-undo .
      549   define variable old-row-lans  as integer   no-undo .
      550   define variable old-col-lans  as integer   no-undo .
      551   define variable vv as integer   no-undo .
      552   empty temp-table temp-font.
      553     GET-KEY-VALUE SECTION "fonts" KEY "font7" VALUE v-font7 .
      554       case num-entries (v-font7) :
      555         when 4 then do:
      556             assign
      557               loc-name = entry ( 1 , v-font7 )
      558               loc-size = entry ( 2 , v-font7 )
      559               loc-type = entry ( 3 , v-font7 ) + "," +  entry ( 4 , v-font7 )
      560             .
      561         end.
      562         when 3 then do:
      563             assign
      564               loc-name = entry ( 1 , v-font7 )
      565               loc-size = entry ( 2 , v-font7 )
      566               loc-type = entry ( 3 , v-font7 )
      567             .
      568         end.
      569         when 2 then  do:
      570             assign
      571               loc-name = entry ( 1 , v-font7 )
      572               loc-size = entry ( 2 , v-font7 )
      573               loc-type = ""
      574             .
      575         end.
      576         when 1 then do:
      577             assign
      578               loc-name = trim(entry ( 1 , v-font7 ))
      579               loc-size = ""
      580               loc-type = ""
      581             .
      582         end.
      583       end case.
      584     create temp-font.
      585     assign
      586       temp-font.fontnum  = 7
      587       temp-font.fontname = trim(loc-name)
      588       temp-font.fontsize = trim(loc-size)
      589       temp-font.fonttype = trim(loc-type)
      590       temp-font.v-row    = 62
      591       temp-font.v-col    = 136
      592       temp-font.v-row-lans = 43
      593       temp-font.v-col-lans = 198
      594     .
      595     repeat ii = 16 to 100 :
      596       get-key-value section 'fonts' key 'font' + string(ii)   value v-font  .
      597       if v-font = "" or v-font = ? then leave.
      598       case num-entries (v-font) :
      599         when 4 then do:
      600             assign
      601               loc-name = entry ( 1 , v-font )
      602               loc-size = entry ( 2 , v-font )
      603               loc-type = entry ( 3 , v-font ) + "," +  entry ( 4 , v-font )
      604             .
      605         end.
      606         when 3 then do:
      607             assign
      608               loc-name = entry ( 1 , v-font )
      609               loc-size = entry ( 2 , v-font )
      610               loc-type = entry ( 3 , v-font )
      611             .
      612         end.
      613         when 2 then do:
      614             assign
      615               loc-name = entry ( 1 , v-font )
      616               loc-size = entry ( 2 , v-font )
      617               loc-type = ""
      618             .
      619         end.
      620         when 1 then do:
      621             assign
      622               loc-name = trim(entry ( 1 , v-font ))
      623               loc-size = ""
      624               loc-type = ""
      625             .
      626         end.
      627       end case.
      628     create temp-font.
      629     assign
      630       temp-font.fontnum  = ii
      631       temp-font.fontname = trim(loc-name)
      632       temp-font.fontsize = trim(loc-size)
      633       temp-font.fonttype = trim(loc-type)
      634     .
      635     end.
      636       for each temp-font :
      637          vv = integer(entry(2,temp-font.fontsize, "=" )) no-error .
      638          if  vv = ? then vv =  0 .
      639           run rep/exfont.p (
      640             input   temp-font.fontname ,
      641             input   vv ,
      642             input   temp-font.fonttype ,
      643             output  temp-font.font-h   ,
      644             output  temp-font.font-w   )
      645           .
      646       end.
      647   find first temp-font where  temp-font.fontnum  = 7  .
      648   old_H = temp-font.font-H .
      649   old_w = temp-font.font-W .
      650   old-row = temp-font.v-row .
      651   old-col = temp-font.v-col .
      652   old-row-lans = temp-font.v-row-lans .
      653   old-col-lans = temp-font.v-col-lans .
      654       for each temp-font where
      655                temp-font.fontnum  <> 7 :
      656           assign
      657               temp-font.v-row    = old_H * old-row / temp-font.font-h
      658               temp-font.v-col    = old_W * old-col / temp-font.font-W
      659               temp-font.v-row-lans    = old_H * old-row-lans / temp-font.font-h
      660               temp-font.v-col-lans    = old_W * old-col-lans / temp-font.font-W
      661           .
      662       end.
      663     end.
      664   end procedure.
      665   PROCEDURE How-name :
      666   define input  parameter h as integer no-undo .
      667   define input  parameter w as integer no-undo .
      668   define output parameter n as character  no-undo .
      669   define variable A4port-H as integer   no-undo init 63.
      670   define variable A4port-W as integer   no-undo init 136.
      671   define variable A4lans-H as integer   no-undo init 43.
      672   define variable A4lans-W as integer   no-undo init 198.
      673   define variable Strim-W  as integer   no-undo init 278.
      674   run define-a4-size (
      675        input ReportFontNum
      676       ,output A4port-H
      677       ,output A4port-W
      678       ,output A4lans-H
      679       ,output A4lans-W ).
      680   If w >= 1 and w <= A4port-W Then DO:
      681     If h >= 1  and h <= A4lans-H Then n = "A4-lans":U.
      682     If h > A4lans-H  and h <= A4port-H Then n = "A4-port":U.
      683     If h > A4port-H              Then n = "to-file":U.
      684   End.
      685   If w > A4port-W and w <= A4lans-W Then DO:
      686     If h >= 1  and h <= A4lans-H Then n = "A4-lans":U.
      687     If h > A4lans-H  and h <= A4port-H Then n = "A3-lans":U.
      688     If h > A4port-H              Then n = "to-file":U.
      689   End.
      690   If w > A4lans-W and w <= Strim-W Then DO:
      691     If h >= 1  and h <= A4lans-H Then n = "to-file":U.
      692     If h > A4lans-H  and h <= A4port-H Then n = "A3-lans":U.
      693     If h > A4port-H              Then n = "to-file":U.
      694   End.
      695   If w > Strim-W Then DO:
      696      n = "to-file":U.
      697   End.
      698   END PROCEDURE.
      699   PROCEDURE define-a4-size :
      700   define input  parameter p-ReportFontNum as integer   no-undo .
      701   define output parameter A4port-H as integer   no-undo .
      702   define output parameter A4port-W as integer   no-undo .
      703   define output parameter A4lans-H as integer   no-undo .
      704   define output parameter A4lans-W as integer   no-undo .
      705   if not can-find (first temp-font ) then do:
      706      run get-font-ini .
      707   end.
      708   find first temp-font where temp-font.fontnum = p-ReportFontNum no-error .
      709   if available temp-font then do:
      710   assign
      711     A4port-H = temp-font.v-row
      712     A4port-W = temp-font.v-col
      713     A4lans-H = temp-font.v-row-lans
      714     A4lans-W = temp-font.v-col-lans
      715   .
      716   end.
      717   else do:
      718   assign
      719     A4port-H = 63
      720     A4port-W = 136
      721     A4lans-H = 43
      722     A4lans-W = 198
      723   .
      724   end.
      725   END PROCEDURE.
      726   procedure proc-alt-shift-f2:
      727     if not ibs.th.gbl.gbl-var:rcode
      728   then
      729     run gbl\inidebug.p .
      730   end.
      731   procedure proc-alt-shift-f3:
      732     run gbl/prvssinf.p
      733       ( input this-procedure
      734       ) .
      735   end.
      736   define variable v-inform-launched as logical no-undo initial false .
      737   procedure proc-alt-shift-f4:
      738     define variable v-action as character no-undo .
      739     if v-inform-launched = false then do:
      740       assign
      741         v-inform-launched = true
      742       .
      743       run gbl/d-inform.w
      744         (  input self
      745         ,  input this-procedure
      746         , output v-action
      747         ) no-error .
      748       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      749       assign
      750         v-inform-launched = false
      751       .
      752     end.
      753   end.
      754   procedure proc-alt-f1:
      755     run gbl/corrhelp.p
      756       (input this-procedure
      757       ) .
      758   end .
      759   on alt-shift-f2 anywhere do:
      760     run proc-alt-shift-f2.
      761   end.
      762   on alt-shift-f3 anywhere do:
      763     run proc-alt-shift-f3 in this-procedure .
      764   end.
      765   on alt-shift-f4 anywhere do:
      766     run proc-alt-shift-f4 in this-procedure.
      767   end.
      768   on alt-f1 anywhere do:
      769     run proc-alt-f1 in this-procedure .
      770   end.
      771   define variable vss-revision    as character no-undo init "$Revision$":U .
      772   define variable vss-author      as character no-undo init "$Author$":U .
      773   define variable vss-date        as character no-undo init "$Date$":U .
      774   define variable vss-workfile    as character no-undo init "$Workfile$":U .
      775   define variable vss-archive     as character no-undo init "$Archive$":U .
      776   define variable vss-description as character no-undo init "Формат листа".
      777   procedure vss-get-info :
      778     define output parameter p-vss-revision    like vss-revision    no-undo .
      779     define output parameter p-vss-author      like vss-author      no-undo .
      780     define output parameter p-vss-date        like vss-date        no-undo .
      781     define output parameter p-vss-workfile    like vss-workfile    no-undo .
      782     define output parameter p-vss-archive     like vss-archive     no-undo .
      783     define output parameter p-vss-description like vss-description no-undo .
      784     assign
      785       p-vss-revision    = vss-revision
      786       p-vss-author      = vss-author
      787       p-vss-date        = vss-date
      788       p-vss-workfile    = vss-workfile
      789       p-vss-archive     = vss-archive
      790       p-vss-description = vss-description
      791     .
      792   end procedure.
      793   procedure vss-get-parameters :
      794     define output parameter p-vss-parameters as character no-undo .
      795   end procedure.
      796   define new global shared variable g#vssrevis-logger as handle    no-undo .
      797   define variable v-vssrevis-logevent                 as logical   no-undo init false .
      798   define variable v-vssrevis-logger                   as handle    no-undo .
      799   procedure vss-logevent :
      800     define input  parameter p-extra-paramters as character no-undo .
      801     define variable v-vssrevis-parameters as character no-undo .
      802     do
      803     on error undo, return error return-value
      804     :
      805       if  valid-handle(v-vssrevis-logger)
      806       and v-vssrevis-logger :get-signature("logevent") <> ""
      807       then do:
      808         run vss-get-parameters in this-procedure
      809           (output v-vssrevis-parameters
      810           ).
      811         run logevent in v-vssrevis-logger
      812           (input vss-workfile
      813           ,input vss-revision
      814           ,input v-vssrevis-parameters
      815           ,input p-extra-paramters
      816           ).
      817       end.
      818     end.
      819   end procedure.
      820   assign
      821     v-vssrevis-logger = g#vssrevis-logger
      822   .
      823   if  valid-handle(v-vssrevis-logger)
      824   and v-vssrevis-logger :get-signature("logevent") <> ""
      825   then do:
      826     assign
      827       v-vssrevis-logevent = true
      828     .
      829     run vss-logevent in this-procedure (input vss-description) .
      830   end.
      831   define buffer buf_usr-flt for ubflt.usr-flt  .
      832   define variable v-h as integer   no-undo .
      833   define variable v-w as integer   no-undo .
      834   define variable v-h-lans as integer   no-undo .
      835   define variable v-w-lans as integer   no-undo .
      836   define variable gl-w as integer   no-undo .
      837   run get-font-ini in this-procedure .
      838   CREATE WIDGET-POOL.
      839   RUN set-attribute-list (
      840       'Keys-Accepted = "",
      841        Keys-Supplied = ""':U).
      842   DEFINE BUTTON BUTTON-1
      843        LABEL "A3"
      844        SIZE 2.75 BY 1 TOOLTIP "Стандартный размер листа для А3-альбом"
      845        FONT 4.
      846   DEFINE BUTTON BUTTON-2
      847        LABEL "A4"
      848        SIZE 2.75 BY 1 TOOLTIP "Стандартный размер листа для А4-альбом"
      849        FONT 4.
      850   DEFINE BUTTON IMAGE-1
      851        IMAGE-UP FILE "btn-left-arrow":U
      852        IMAGE-DOWN FILE "btn-left-arrow":U
      853        IMAGE-INSENSITIVE FILE "btn-left-arrow":U NO-FOCUS
      854        LABEL "IMAGE-1"
      855        SIZE 2.5 BY 1 TOOLTIP "Ширина страницы в символах".
      856   DEFINE BUTTON IMAGE-2
      857        IMAGE-UP FILE "btn-right-arrow":U
      858        IMAGE-DOWN FILE "btn-right-arrow":U
      859        IMAGE-INSENSITIVE FILE "btn-right-arrow":U NO-FOCUS
      860        LABEL "IMAGE-2"
      861        SIZE 2.5 BY 1 TOOLTIP "Ширина страницы в символах".
      862   DEFINE BUTTON IMAGE-4
      863        IMAGE-UP FILE "btn-down-arrow":U
      864        IMAGE-DOWN FILE "btn-down-arrow":U
      865        IMAGE-INSENSITIVE FILE "btn-down-arrow":U NO-FOCUS
      866        LABEL "IMAGE-4"
      867        SIZE 4.38 BY .83 TOOLTIP "Высота страницы в строках".
      868   DEFINE BUTTON IMAGE-5
      869        IMAGE-UP FILE "btn-up-arrow":U
      870        IMAGE-DOWN FILE "btn-up-arrow":U
      871        IMAGE-INSENSITIVE FILE "btn-up-arrow":U NO-FOCUS
      872        LABEL "IMAGE-5"
      873        SIZE 4.38 BY .83 TOOLTIP "Высота страницы в строках".
      874   DEFINE BUTTON r-font
      875        IMAGE-UP FILE "btn-down-arrow":U
      876        IMAGE-DOWN FILE "btn-down-arrow":U
      877        IMAGE-INSENSITIVE FILE "btn-down-arrow":U NO-FOCUS
      878        LABEL ""
      879        SIZE 4.38 BY .83 TOOLTIP "Выбор фонта из секции [fonts] ini".
      880   DEFINE VARIABLE l-fontname AS CHARACTER FORMAT "X(256)":U
      881         VIEW-AS TEXT
      882        SIZE 17 BY .67
      883        FGCOLOR 1 FONT 4 NO-UNDO.
      884   DEFINE VARIABLE l-fontnum AS INTEGER FORMAT ">>9":U INITIAL 7
      885         VIEW-AS TEXT
      886        SIZE 5.5 BY .67
      887        FGCOLOR 7  NO-UNDO.
      888   DEFINE VARIABLE l-fontsize AS CHARACTER FORMAT "X(256)":U
      889         VIEW-AS TEXT
      890        SIZE 17 BY .67
      891        FGCOLOR 1 FONT 4 NO-UNDO.
      892   DEFINE VARIABLE l-fonttype AS CHARACTER FORMAT "X(256)":U
      893         VIEW-AS TEXT
      894        SIZE 17 BY .67
      895        FGCOLOR 1 FONT 4 NO-UNDO.
      896   DEFINE VARIABLE l-height AS INTEGER FORMAT ">>9":U INITIAL 0
      897        VIEW-AS FILL-IN
      898        SIZE 4.38 BY 1 TOOLTIP "Высота страницы в строках" NO-UNDO.
      899   DEFINE VARIABLE l-name AS CHARACTER FORMAT "X(256)":C8
      900         VIEW-AS TEXT
      901        SIZE 7.88 BY .67 TOOLTIP "Рекомендуемая форма вывода"
      902        BGCOLOR 15 FGCOLOR 9  NO-UNDO.
      903   DEFINE VARIABLE l-width AS INTEGER FORMAT ">>9":U INITIAL 0
      904        VIEW-AS FILL-IN
      905        SIZE 4.25 BY 1 TOOLTIP "Ширина страницы в символах" NO-UNDO.
      906   DEFINE RECTANGLE RECT-10
      907        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      908        SIZE 16.38 BY 4.04.
      909   DEFINE RECTANGLE RECT-9
      910        EDGE-PIXELS 2 GRAPHIC-EDGE
      911        SIZE 9.25 BY 2.38 TOOLTIP "Рекомендуемая форма вывода"
      912        BGCOLOR 15 FGCOLOR 9 .
      913   DEFINE FRAME F-Main
      914        r-font AT ROW 1.17 COL 13.5
      915        IMAGE-5 AT ROW 6.13 COL 2.88
      916        IMAGE-4 AT ROW 7.83 COL 2.88
      917        l-height AT ROW 6.96 COL 6.26 RIGHT-ALIGNED NO-LABEL AUTO-RETURN
      918        IMAGE-1 AT ROW 8.71 COL 8
      919        BUTTON-2 AT ROW 8.71 COL 2.25
      920        BUTTON-1 AT ROW 8.71 COL 5
      921        l-width AT ROW 8.71 COL 13.88 RIGHT-ALIGNED NO-LABEL AUTO-RETURN
      922        IMAGE-2 AT ROW 8.71 COL 14.63
      923        l-fontnum AT ROW 1.25 COL 6.5 NO-LABEL
      924        l-fontname AT ROW 2.25 COL 1 NO-LABEL
      925        l-fontsize AT ROW 3 COL 1 NO-LABEL
      926        l-fonttype AT ROW 3.75 COL 1 NO-LABEL
      927        l-name AT ROW 7 COL 6.5 COLON-ALIGNED NO-LABEL
      928        "Фонт" VIEW-AS TEXT
      929             SIZE 4.5 BY .67 AT ROW 1.25 COL 1.5
      930             FGCOLOR 4
      931        "Формат страницы" VIEW-AS TEXT
      932             SIZE 16.13 BY .67 AT ROW 5 COL 1.5
      933             FGCOLOR 4
      934        RECT-10 AT ROW 5.88 COL 1.63
      935        RECT-9 AT ROW 6.13 COL 8
      936       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
      937            SIDE-LABELS NO-UNDERLINE THREE-D
      938            AT COL 1 ROW 1 SCROLLABLE .
      939   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
      940   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
      941   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
      942   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
      943   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
      944   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
      945   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
      946   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
      947         adm-object-hdl = FRAME F-Main:HANDLE.
      948   RUN ensure-broker.
      949   THIS-PROCEDURE:ADM-DATA =
      950        'ADM1.1~`':U +
      951        'SmartObject~`':U +
      952        '~`':U +
      953        'NO ~`':U +
      954        '~`':U +
      955        '~`':U +
      956        '~`':U +
      957        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
      958           + "~`":U +
      959        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add~`':U +
      960        'Record-Source,Record-Target,TableIO-Target~`':U +
      961        '~`':U +
      962        '~`~`~`~`~`~`~`~`~`~`~`':U +
      963        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
      964            THEN "^^":U
      965        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
      966             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
      967   PROCEDURE adm-apply-entry :
      968     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      969   END PROCEDURE.
      970   PROCEDURE adm-destroy :
      971    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      972   END PROCEDURE.
      973   PROCEDURE adm-disable :
      974       DISABLE r-font IMAGE-5 RECT-10 IMAGE-4 RECT-9 l-height IMAGE-1 BUTTON-2 BUTTON-1 l-width IMAGE-2 l-fontnum l-fontname l-fontsize l-fonttype l-name WITH FRAME F-Main.
      975       RUN dispatch ('disable-fields':U).
      976       RUN set-attribute-list ('ENABLED=no':U).
      977       RETURN.
      978   END PROCEDURE.
      979   PROCEDURE adm-edit-attribute-list :
      980         RUN adm/support/viewerd.w (INPUT THIS-PROCEDURE).
      981         RETURN.
      982   END PROCEDURE.
      983   PROCEDURE adm-enable :
      984       ENABLE UNLESS-HIDDEN r-font IMAGE-5 RECT-10 IMAGE-4 RECT-9 l-height IMAGE-1 BUTTON-2 BUTTON-1 l-width IMAGE-2 l-fontnum l-fontname l-fontsize l-fonttype l-name WITH FRAME F-Main.
      985       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
      986       RUN set-attribute-list ('ENABLED=yes':U).
      987       RETURN.
      988   END PROCEDURE.
      989   PROCEDURE adm-exit :
      990        RUN notify ('exit':U).
      991     RETURN.
      992   END PROCEDURE.
      993   PROCEDURE adm-hide :
      994     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      995   END PROCEDURE.
      996   PROCEDURE adm-initialize :
      997     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      998   END PROCEDURE.
      999   PROCEDURE adm-show-errors :
     1000       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
     1001       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
     1002           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
     1003       END.
     1004       RETURN.
     1005   END PROCEDURE.
     1006   PROCEDURE adm-UIB-mode :
     1007     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1008   END PROCEDURE.
     1009   PROCEDURE adm-view :
     1010     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1011   END PROCEDURE.
     1012   PROCEDURE dispatch :
     1013       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
     1014       RUN broker-dispatch IN adm-broker-hdl
     1015           (THIS-PROCEDURE, p-method-name) NO-ERROR.
     1016       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
     1017   END PROCEDURE.
     1018   PROCEDURE ensure-broker :
     1019   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
     1020   IF RETURN-VALUE NE "ADM-Broker":U THEN
     1021   DO:
     1022       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
     1023       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
     1024   END.
     1025   END PROCEDURE.
     1026   PROCEDURE get-attribute :
     1027     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
     1028     RUN broker-get-attribute IN adm-broker-hdl
     1029         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
     1030     RETURN RETURN-VALUE.
     1031   END PROCEDURE.
     1032   PROCEDURE get-attribute-list :
     1033     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
     1034     RUN broker-get-attribute-list IN adm-broker-hdl
     1035         (INPUT THIS-PROCEDURE,
     1036          INPUT ?,
     1037          OUTPUT p-attr-list) NO-ERROR.
     1038     RETURN.
     1039   END PROCEDURE.
     1040   PROCEDURE new-state :
     1041     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     1042     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
     1043     RETURN.
     1044   END PROCEDURE.
     1045   PROCEDURE notify :
     1046     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
     1047     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
     1048     IF RETURN-VALUE = "ADM-ERROR":U THEN
     1049         RETURN "ADM-ERROR":U.
     1050     RETURN.
     1051   END PROCEDURE.
     1052   PROCEDURE set-attribute-list :
     1053     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
     1054     RUN ensure-broker.
     1055     RUN broker-set-attribute-list IN adm-broker-hdl
     1056         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
     1057     RETURN.
     1058   END PROCEDURE.
     1059   PROCEDURE set-position :
     1060       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
     1061       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
     1062       IF VALID-HANDLE(adm-object-hdl) THEN
     1063       DO:
     1064         ASSIGN adm-object-hdl:ROW    =   p-row
     1065                adm-object-hdl:COLUMN =   p-col.
     1066       END.
     1067       RETURN.
     1068   END PROCEDURE.
     1069   PROCEDURE adm-display-fields :
     1070       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
     1071       RETURN.
     1072   END PROCEDURE.
     1073   PROCEDURE adm-open-query :
     1074     RETURN.
     1075   END PROCEDURE.
     1076   PROCEDURE adm-row-changed :
     1077         IF VALID-HANDLE(adm-object-hdl) THEN
     1078           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     1079         RUN notify ('row-available':U).
     1080         RETURN.
     1081   END PROCEDURE.
     1082   PROCEDURE reposition-query :
     1083       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
     1084       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
     1085       RETURN.
     1086   END PROCEDURE.
     1087     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
     1088     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
     1089     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
     1090     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
     1091     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
     1092     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
     1093     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
     1094     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
     1095     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1096     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
     1097     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1098     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
     1099     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
     1100     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
     1101     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
     1102     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
     1103     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
     1104     IF "":U = "":U THEN
     1105       RUN modify-list-attribute IN adm-broker-hdl
     1106         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
     1107     RUN use-create-on-add(?).
     1108   PROCEDURE adm-add-record :
     1109       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     1110          "must have at least one Enabled Table to perform Add.":U
     1111          VIEW-AS ALERT-BOX ERROR.
     1112       RETURN.
     1113   END PROCEDURE.
     1114   PROCEDURE adm-assign-record :
     1115    MESSAGE
     1116          "Object ":U THIS-PROCEDURE:FILE-NAME
     1117            "must have at least one Enabled Table to perform Assign.":U
     1118              VIEW-AS ALERT-BOX ERROR.
     1119      RETURN.
     1120     END PROCEDURE.
     1121   PROCEDURE adm-assign-statement :
     1122     RETURN.
     1123   END PROCEDURE.
     1124   PROCEDURE adm-cancel-record :
     1125      RETURN.
     1126     END PROCEDURE.
     1127   PROCEDURE adm-copy-record :
     1128       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     1129        "must have at least one Enabled Table to perform Copy.":U
     1130          VIEW-AS ALERT-BOX ERROR.
     1131       RETURN.
     1132   END PROCEDURE.
     1133   PROCEDURE adm-create-record :
     1134      RETURN.
     1135   END PROCEDURE.
     1136   PROCEDURE adm-current-changed :
     1137     RETURN.
     1138   END PROCEDURE.
     1139   PROCEDURE adm-delete-record :
     1140    MESSAGE
     1141          "Object ":U THIS-PROCEDURE:FILE-NAME
     1142            "must have at least one Enabled Table to perform Delete.":U
     1143              VIEW-AS ALERT-BOX ERROR.
     1144       RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
     1145       RETURN.
     1146   END PROCEDURE.
     1147   PROCEDURE adm-disable-fields :
     1148         RUN notify ('disable-fields, GROUP-ASSIGN-TARGET':U).
     1149       RETURN.
     1150   END PROCEDURE.
     1151   PROCEDURE adm-enable-fields :
     1152       RETURN.
     1153   END PROCEDURE.
     1154   PROCEDURE adm-end-update :
     1155     RETURN.
     1156   END PROCEDURE.
     1157   PROCEDURE adm-reset-record :
     1158       RETURN.
     1159   END PROCEDURE.
     1160   PROCEDURE adm-update-record :
     1161       MESSAGE
     1162         "Object ":U THIS-PROCEDURE:FILE-NAME
     1163           "must have at least one Enabled Table to perform Update.":U
     1164             VIEW-AS ALERT-BOX ERROR.
     1165      RETURN.
     1166   END PROCEDURE.
     1167   PROCEDURE check-modified :
     1168   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
     1169   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
     1170   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
     1171   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
     1172     IF check-state = "check":U THEN
     1173     DO:
     1174       RUN get-link-handle IN adm-broker-hdl
     1175         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
     1176            OUTPUT group-target-list).
     1177       IF group-target-list NE "":U THEN
     1178       DO i = 1 TO NUM-ENTRIES(group-target-list):
     1179         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
     1180         RUN check-modified IN curr-widget ('group-check':U).
     1181         IF RETURN-VALUE NE "":U THEN
     1182         DO:
     1183           RUN check-modified-message(RETURN-VALUE).
     1184           RETURN "":U.
     1185         END.
     1186       END.
     1187     END.
     1188     RETURN "":U.
     1189   END PROCEDURE.
     1190   PROCEDURE check-modified-message :
     1191     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
     1192        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
     1193           'CONTAINER-SOURCE':U, 'HIDDEN':U).
     1194        IF RETURN-VALUE = "YES":U THEN
     1195           RUN notify ('view,CONTAINER-SOURCE':U).
     1196        MESSAGE IF p-changed-table NE ? THEN
     1197           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
     1198           ELSE "Current values have been changed."
     1199           SKIP "  Do you wish to save those changes?"
     1200           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
     1201        IF ANS THEN
     1202        DO:
     1203           IF group-assign-target THEN
     1204             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
     1205           ELSE RUN dispatch('update-record':U).
     1206           IF RETURN-VALUE = "ADM-ERROR":U THEN
     1207           DO:
     1208               MESSAGE "Changes to the previous record were not saved."
     1209                 VIEW-AS ALERT-BOX ERROR.
     1210               IF group-assign-target THEN
     1211                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1212               ELSE RUN dispatch ('cancel-record':U).
     1213           END.
     1214        END.
     1215        ELSE DO:
     1216          IF group-assign-target THEN
     1217             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1218          ELSE RUN dispatch('cancel-record':U).
     1219        END.
     1220        RETURN.
     1221   END PROCEDURE.
     1222   PROCEDURE get-rowid :
     1223       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
     1224       ASSIGN
     1225       p-table   =   adm-first-table.
     1226       RETURN.
     1227   END PROCEDURE.
     1228   PROCEDURE init-group-assign :
     1229       RUN request-attribute IN adm-broker-hdl
     1230         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
     1231       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
     1232         group-assign-target = yes.
     1233       ELSE group-assign-target = no.
     1234       RETURN.
     1235   END PROCEDURE.
     1236   PROCEDURE set-editors :
     1237       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
     1238       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
     1239       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
     1240       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
     1241       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
     1242       DO WHILE VALID-HANDLE (curr-widget):
     1243           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
     1244              curr-widget:HIDDEN = no THEN DO:
     1245             CASE p-field-setting:
     1246               WHEN "INITIALIZE":U THEN
     1247               DO:
     1248                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
     1249                     read-only-list +
     1250                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
     1251                        STRING(curr-widget).
     1252               END.
     1253               WHEN "DISABLE":U OR
     1254               WHEN "ENABLE":U THEN
     1255               DO:
     1256                   curr-widget:SENSITIVE = yes.
     1257                   RUN get-attribute ('Read-Only-Editors':U).
     1258                   IF RETURN-VALUE = ? OR
     1259                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
     1260                       curr-widget:READ-ONLY =
     1261                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
     1262               END.
     1263               WHEN "CLEAR":U THEN
     1264                   curr-widget:SCREEN-VALUE = "":U.
     1265             END CASE.
     1266           END.
     1267           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
     1268       END.
     1269       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
     1270         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
     1271           + '"':U).
     1272       RETURN.
     1273   END PROCEDURE.
     1274   PROCEDURE use-check-modified-all :
     1275    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1276     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
     1277     RETURN.
     1278   END PROCEDURE.
     1279   PROCEDURE use-create-on-add :
     1280   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1281      RETURN.
     1282   END PROCEDURE.
     1283   PROCEDURE use-initial-lock :
     1284     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1285     ASSIGN adm-initial-lock = p-attr-value.
     1286     RETURN.
     1287   END PROCEDURE.
     1288     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
     1289   ASSIGN
     1290          FRAME F-Main:SCROLLABLE       = FALSE
     1291          FRAME F-Main:HIDDEN           = TRUE.
     1292   ON CHOOSE OF BUTTON-1 IN FRAME F-Main
     1293   DO:
     1294   define variable A4port-H as integer   no-undo init 63.
     1295   define variable A4port-W as integer   no-undo init 136.
     1296   define variable A4lans-H as integer   no-undo init 43.
     1297   define variable A4lans-W as integer   no-undo init 198.
     1298   run define-a4-size (
     1299       input ReportFontNum
     1300       ,output A4port-H
     1301       ,output A4port-W
     1302       ,output A4lans-H
     1303       ,output A4lans-W ).
     1304     l-Height:screen-value   in frame F-Main = string(A4port-H) .
     1305     l-Width:screen-value    in frame F-Main = "278".
     1306     run how-name
     1307     ( input integer(l-height:screen-value  in frame F-Main),
     1308       input integer(l-width:screen-value   in frame F-Main),
     1309       output (l-name )
     1310       ).
     1311    display l-name with frame F-Main.
     1312   END.
     1313   ON CHOOSE OF BUTTON-2 IN FRAME F-Main
     1314   DO:
     1315   define variable A4port-H as integer   no-undo init 63.
     1316   define variable A4port-W as integer   no-undo init 136.
     1317   define variable A4lans-H as integer   no-undo init 43.
     1318   define variable A4lans-W as integer   no-undo init 198.
     1319   run define-a4-size (
     1320        input  ReportFontNum
     1321       ,output A4port-H
     1322       ,output A4port-W
     1323       ,output A4lans-H
     1324       ,output A4lans-W
     1325       ).
     1326     if gl-w > A4port-W or gl-w  = 0 or gl-w = ? then do:
     1327       l-Height:screen-value in frame F-Main = string(A4lans-H).
     1328       l-Width:screen-value  in frame F-Main = string(A4lans-W).
     1329     end.
     1330     else do:
     1331       l-Height:screen-value in frame F-Main = string(A4port-H).
     1332       l-Width:screen-value  in frame F-Main = string(A4port-W).
     1333     end.
     1334     run How-name (INPUT integer(l-Height:screen-value  in frame F-Main),
     1335                   INPUT integer(l-Width:screen-value   in frame F-Main),
     1336                   OUTPUT (l-name ))
     1337                   .
     1338    display l-name with frame F-Main.
     1339   END.
     1340   ON CHOOSE OF IMAGE-1 IN FRAME F-Main
     1341   DO:
     1342     l-Width:screen-value   in frame F-Main =
     1343     string (integer(l-Width:screen-value   in frame F-Main) - 1).
     1344     run How-name (INPUT integer(l-Height:screen-value  in frame F-Main),
     1345                 INPUT integer(l-Width:screen-value   in frame F-Main),
     1346                 OUTPUT (l-name )).
     1347                 display l-name with frame F-Main.
     1348   END.
     1349   ON CHOOSE OF IMAGE-2 IN FRAME F-Main
     1350   DO:
     1351     l-Width:screen-value in frame F-Main =
     1352     string (integer(l-Width:screen-value   in frame F-Main) + 1) .
     1353     run how-name
     1354       ( input integer (l-height:screen-value in frame F-Main) ,
     1355         input integer (l-width:screen-value  in frame F-Main) ,
     1356         output (l-name ))
     1357         .
     1358     display l-name with frame F-Main .
     1359   END.
     1360   ON CHOOSE OF IMAGE-4 IN FRAME F-Main
     1361   DO:
     1362     l-Height:screen-value   in frame F-Main =
     1363     string (integer(l-Height:screen-value   in frame F-Main) - 1).
     1364     run How-name (INPUT integer(l-Height:screen-value  in frame F-Main),
     1365                 INPUT integer(l-Width:screen-value   in frame F-Main),
     1366                 OUTPUT (l-name )).
     1367    display l-name with frame F-Main.
     1368   END.
     1369   ON CHOOSE OF IMAGE-5 IN FRAME F-Main
     1370   DO:
     1371     l-Height:screen-value   in frame F-Main =
     1372     string (integer(l-Height:screen-value   in frame F-Main) + 1).
     1373     run How-name (INPUT integer(l-Height:screen-value  in frame F-Main),
     1374                 INPUT integer(l-Width:screen-value   in frame F-Main),
     1375                 OUTPUT (l-name )).
     1376                 display l-name with frame F-Main.
     1377   END.
     1378   ON LEAVE OF l-height IN FRAME F-Main
     1379   DO:
     1380     run How-name (INPUT integer(l-Height:screen-value  in frame F-Main),
     1381                 INPUT integer(l-Width:screen-value   in frame F-Main),
     1382                 OUTPUT (l-name )).
     1383                 display l-name with frame F-Main.
     1384   END.
     1385   ON LEAVE OF l-width IN FRAME F-Main
     1386   DO:
     1387     run How-name (INPUT integer(l-Height:screen-value  in frame F-Main),
     1388                 INPUT integer(l-Width:screen-value   in frame F-Main),
     1389                 OUTPUT (l-name )).
     1390                 display l-name with frame F-Main.
     1391   END.
     1392   ON CHOOSE OF r-font IN FRAME F-Main
     1393   DO:
     1394     run rep/lkp-font.w
     1395        ( output l-fontnum  ,
     1396          output l-fontname ,
     1397          output l-fontsize ,
     1398          output l-fonttype ,
     1399          output v-h        ,
     1400          output v-w        ,
     1401          output v-h-lans   ,
     1402          output v-w-lans
     1403          ) .
     1404     if l-fontnum = 0 or l-fontnum = ? then
     1405         return no-apply.
     1406     display l-fontnum
     1407         l-fontname
     1408         l-fontsize
     1409         l-fonttype
     1410         with frame F-Main
     1411         .
     1412     assign
     1413       ReportFontNum    = l-fontnum
     1414       ReportPageHeight = v-h
     1415       ReportPageWidth  = v-w
     1416     .
     1417     l-Height:screen-value   in frame F-Main =  string(ReportPageWidth).
     1418     l-Width:screen-value    in frame F-Main =  string(ReportPageHeight).
     1419     run how-name in this-procedure (
     1420         input integer(l-height:screen-value  in frame F-Main),
     1421         input integer(l-width:screen-value   in frame F-Main),
     1422         output l-name
     1423         ).
     1424    display l-name with frame F-Main.
     1425   END.
     1426   if not this-procedure :persistent
     1427   then do:
     1428     message
     1429       vss-workfile vss-revision vss-description skip
     1430       "Ошибка при запуске процедуры" skip
     1431       "Данную процедуру следует запускать только с параметром persistent" skip
     1432       view-as alert-box error .
     1433     undo, return error .
     1434   end.
     1435   PROCEDURE adm-row-available :
     1436     DEFINE VARIABLE tbl-list           AS CHARACTER INIT "":U NO-UNDO.
     1437     DEFINE VARIABLE rowid-list         AS CHARACTER NO-UNDO.
     1438     DEFINE VARIABLE row-avail-cntr     AS INTEGER INIT 0 NO-UNDO.
     1439     DEFINE VARIABLE row-avail-rowid    AS ROWID NO-UNDO.
     1440     DEFINE VARIABLE row-avail-enabled  AS LOGICAL NO-UNDO.
     1441     DEFINE VARIABLE link-handle        AS CHARACTER NO-UNDO.
     1442     DEFINE VARIABLE record-source-hdl  AS HANDLE NO-UNDO.
     1443     DEFINE VARIABLE different-row      AS LOGICAL NO-UNDO INIT no.
     1444     DEFINE VARIABLE key-name           AS CHARACTER INIT ? NO-UNDO.
     1445     DEFINE VARIABLE key-value          AS CHARACTER INIT ? NO-UNDO.
     1446     RUN check-modified IN THIS-PROCEDURE ('check':U) NO-ERROR.
     1447     IF adm-updating-record THEN RETURN.
     1448     RUN get-attribute ('FIELDS-ENABLED':U).
     1449     row-avail-enabled = IF RETURN-VALUE = "YES":U THEN yes ELSE no.
     1450     RUN get-link-handle IN adm-broker-hdl (THIS-PROCEDURE, 'RECORD-SOURCE':U,
     1451         OUTPUT link-handle) NO-ERROR.
     1452     IF link-handle = "":U THEN
     1453         RETURN.
     1454     ASSIGN record-source-hdl = WIDGET-HANDLE(ENTRY(1,link-handle)).
     1455     IF NUM-ENTRIES(link-handle) > 1 THEN
     1456         MESSAGE "row-available in ":U THIS-PROCEDURE:FILE-NAME
     1457             "encountered more than one RECORD-SOURCE.":U SKIP
     1458             "The first - ":U record-source-hdl:file-name " - will be used.":U
     1459                VIEW-AS ALERT-BOX ERROR.
     1460     RUN get-attribute ('Key-Name':U).
     1461     key-name = RETURN-VALUE.
     1462     IF key-name = "":U THEN key-name = ?.
     1463     IF key-name NE ? THEN DO:
     1464       RUN send-key IN record-source-hdl (INPUT key-name, OUTPUT key-value)
     1465         NO-ERROR.
     1466       IF key-value NE ? THEN
     1467         RUN set-attribute-list (SUBSTITUTE ('Key-Value="&1"':U, key-value)).
     1468     END.
     1469   IF VALID-HANDLE (adm-object-hdl) THEN
     1470       RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     1471   RUN notify IN THIS-PROCEDURE ('row-available':U).
     1472   END PROCEDURE.
     1473   PROCEDURE disable_UI :
     1474     HIDE FRAME F-Main.
     1475     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1476   END PROCEDURE.
     1477   PROCEDURE Get-var-2 :
     1478   define variable s-i as integer no-undo .
     1479   define variable s-t as character no-undo .
     1480   define variable A4port-H as integer   no-undo init 63.
     1481   define variable A4port-W as integer   no-undo init 136.
     1482   define variable A4lans-H as integer   no-undo init 43.
     1483   define variable A4lans-W as integer   no-undo init 198.
     1484   run define-a4-size (
     1485        input  ReportFontNum
     1486       ,output A4port-H
     1487       ,output A4port-W
     1488       ,output A4lans-H
     1489       ,output A4lans-W
     1490       ).
     1491   repeat  s-i = 1 to 256  :
     1492     s-t =  s-t + string(Use-Column[s-i] , "true/false")  + ";".
     1493   End.
     1494    ReportPageHeight = Integer(l-Height:screen-value in frame F-Main) .
     1495    ReportPageWidth  = Integer(l-Width:screen-value  in frame F-Main) .
     1496    find first buf_usr-flt exclusive-lock where
     1497            buf_usr-flt.user-name = g#userid and
     1498            buf_usr-flt.call-point   = ReportProc  no-error .
     1499        if NOT available buf_usr-flt then  create buf_usr-flt.
     1500          Assign
     1501            buf_usr-flt.user-name = g#userid
     1502            buf_usr-flt.call-point   = ReportProc
     1503            buf_usr-flt.list_ = string( "ReportPageHeight=" + string(ReportPageHeight)) + ","
     1504                              + string( "ReportPageWidth="  + string(ReportPageWidth)) + ","
     1505                              + string( "ReportFontNum="    + string(ReportFontNum)) + ","
     1506                              + string( "Use-Column="       + string(s-t))
     1507            .
     1508    find current buf_usr-flt no-lock .
     1509   if ReportPageHeight = 0 and ReportPageWidth  = 0 then DO:
     1510             Assign l-Height:screen-value  in frame F-Main = string(A4lans-H)
     1511                    l-Width:screen-value   in frame F-Main = string(A4lans-W)
     1512                  .
     1513                  run How-name (INPUT integer(l-Height:screen-value  in frame F-Main),
     1514                                INPUT integer(l-Width:screen-value   in frame F-Main),
     1515                                OUTPUT l-name).
     1516                                display l-name  with frame F-Main.
     1517             return error "format-page".
     1518             end.
     1519   END PROCEDURE.
     1520   PROCEDURE How-name-H :
     1521   define input  parameter  w as integer no-undo .
     1522   define output parameter h as integer no-undo .
     1523   define output parameter n as character no-undo .
     1524   define variable Strim-W  as integer   no-undo init 278.
     1525   define variable A4port-H as integer   no-undo init 63.
     1526   define variable A4port-W as integer   no-undo init 136.
     1527   define variable A4lans-H as integer   no-undo init 43.
     1528   define variable A4lans-W as integer   no-undo init 198.
     1529   run define-a4-size (
     1530       input ReportFontNum
     1531       ,output A4port-H
     1532       ,output A4port-W
     1533       ,output A4lans-H
     1534       ,output A4lans-W ).
     1535   gl-w  = w .
     1536   If w >= 1 and w <= A4port-W Then DO:
     1537      h = A4port-H  .
     1538      n = "A4-port":U.
     1539   End.
     1540   If w > A4port-W and w <= A4lans-W Then DO:
     1541      h = A4lans-H .
     1542      n = "A4-lans":U.
     1543   End.
     1544   If w > A4lans-W and w <= Strim-W Then DO:
     1545     h = A4port-H .
     1546     n = "A3-lans":U.
     1547   End.
     1548   If w > Strim-W Then DO:
     1549      h = A4port-H .
     1550      n = "to-file":U.
     1551   End.
     1552   END PROCEDURE.
     1553   PROCEDURE local-initialize :
     1554   RUN dispatch IN THIS-PROCEDURE ( INPUT 'initialize':U ) .
     1555   define variable  l-ind as integer no-undo .
     1556   define variable A4port-H as integer   no-undo init 63.
     1557   define variable A4port-W as integer   no-undo init 136.
     1558   define variable A4lans-H as integer   no-undo init 43.
     1559   define variable A4lans-W as integer   no-undo init 198.
     1560   run define-a4-size (
     1561       input ReportFontNum
     1562       ,output A4port-H
     1563       ,output A4port-W
     1564       ,output A4lans-H
     1565       ,output A4lans-W ).
     1566    find first buf_usr-flt no-lock  where
     1567            buf_usr-flt.user-name  = g#userid and
     1568            buf_usr-flt.call-point = ReportProc  no-error .
     1569        if available buf_usr-flt then  DO:
     1570             repeat l-ind = 1 to num-entries(buf_usr-flt.list_) :
     1571                       if entry(1,entry(l-ind,buf_usr-flt.list_),"=")  = "ReportPageHeight":U then
     1572                          l-Height:screen-value in frame F-Main = entry(2,entry(l-ind,buf_usr-flt.list_),"=") no-error .
     1573                          if error-status :error  then message "высота" .
     1574                       if entry(1,entry(l-ind,buf_usr-flt.list_),"=")  = "ReportPageWidth":U then
     1575                          l-Width:screen-value in frame F-Main = entry(2,entry(l-ind,buf_usr-flt.list_),"=") no-error .
     1576                          if error-status :error  then message "ширина" .
     1577                       if entry(1,entry(l-ind,buf_usr-flt.list_),"=")  = "ReportFontNum":U then
     1578                          ReportFontNum = integer (entry(2,entry(l-ind,buf_usr-flt.list_),"=")) no-error .
     1579                       if ReportFontNum = 0 or ReportFontNum = ? or  error-status :error then ReportFontNum = 7.
     1580                          l-FontNum:screen-value in frame F-Main = string(ReportFontNum) .
     1581                           run define-a4-size (
     1582                               input ReportFontNum
     1583                               ,output A4port-H
     1584                               ,output A4port-W
     1585                               ,output A4lans-H
     1586                               ,output A4lans-W ).
     1587                           run select-font ( input ReportFontNum ) .
     1588                  End.
     1589                 if ReportFontNum = 0 or ReportFontNum = ? or  error-status :error then ReportFontNum = 7.
     1590                 l-FontNum:screen-value in frame F-Main = string(ReportFontNum) .
     1591                 run define-a4-size (
     1592                     input ReportFontNum
     1593                     ,output A4port-H
     1594                     ,output A4port-W
     1595                     ,output A4lans-H
     1596                     ,output A4lans-W ).
     1597                 run select-font ( input ReportFontNum ) .
     1598      End.
     1599      Else do:
     1600         run define-a4-size (
     1601              input 7
     1602             ,output A4port-H
     1603             ,output A4port-W
     1604             ,output A4lans-H
     1605             ,output A4lans-W ).
     1606         run select-font ( input 7 ) .
     1607         Assign l-Height:screen-value  in frame F-Main = string(A4lans-H)
     1608                l-Width:screen-value   in frame F-Main = string(A4lans-W)
     1609                   .
     1610      end.
     1611   run How-name (INPUT integer(l-Height:screen-value  in frame F-Main),
     1612                 INPUT integer(l-Width:screen-value   in frame F-Main),
     1613                 OUTPUT (l-name )).
     1614   display l-name with frame F-Main.
     1615   END PROCEDURE.
     1616   PROCEDURE select-font :
     1617   define input  parameter p-fontnum as integer   no-undo .
     1618   find first temp-font where temp-font.fontnum = p-FontNum no-error .
     1619   if available temp-font then do:
     1620     l-fontnum  = temp-font.fontnum .
     1621     l-fontname = temp-font.fontname.
     1622     l-fontsize = temp-font.fontsize.
     1623     l-fonttype = temp-font.fonttype.
     1624   end.
     1625   else do:
     1626     assign
     1627       l-fontnum  = 7
     1628       l-fontname = "Нет настройки фонта"
     1629       l-fontsize = ""
     1630       l-fonttype = ""
     1631     .
     1632   end.
     1633    display
     1634         l-fontnum
     1635         l-fontname
     1636         l-fontsize
     1637         l-fonttype
     1638         with frame F-Main
     1639         .
     1640   END PROCEDURE.
     1641   PROCEDURE send-records :
     1642   END PROCEDURE.
     1643   PROCEDURE state-changed :
     1644     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE    NO-UNDO.
     1645     DEFINE INPUT PARAMETER p-state      AS CHARACTER NO-UNDO.
     1646     CASE p-state:
     1647       WHEN 'update-begin':U THEN DO:
     1648           RUN dispatch('enable-fields':U).
     1649           IF RETURN-VALUE = "ADM-ERROR":U THEN
     1650           DO:
     1651             RUN new-state('update-failed,TABLEIO-SOURCE':U).
     1652             RUN new-state('update-complete':U).
     1653           END.
     1654           ELSE RUN new-state ('update':U).
     1655       END.
     1656       WHEN 'update-complete':U THEN DO:
     1657           RUN new-state ('update-complete':U).
     1658       END.
     1659     END CASE.
     1660   END PROCEDURE.
     1661   procedure view-how-name :
     1662   define input parameter l-w like ReportPageWidth no-undo .
     1663             Assign l-Height:screen-value  in frame F-Main = string(ReportPageHeight)
     1664                    l-Width:screen-value   in frame F-Main = string(l-w)
     1665                    .
     1666                  run How-name-h (INPUT l-w ,
     1667                                  OUTPUT ReportPageHeight,
     1668                                  OUTPUT l-name).
     1669             Assign l-Height:screen-value  in frame F-Main = string(ReportPageHeight)
     1670                    l-Width:screen-value   in frame F-Main = string(l-w)
     1671                    .
     1672             display l-name with frame F-Main.
     1673   end procedure.
