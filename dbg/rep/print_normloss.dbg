      900   define variable v-torgconf-main-boss            as character    no-undo.
      901   define variable v-torgconf-main-buh             as character    no-undo.
      902   define variable v-torgconf-reason               as character    no-undo.
      903   define variable v-torgconf-sf-buyer-name        as character    no-undo.
      904   define variable v-torgconf-sf-buyer-code        as character    no-undo.
      905   define variable v-torgconf-sf-buyer-type        as character    no-undo.
      906   define variable v-torgconf-sf-buyer-addr        as character    no-undo.
      907   define variable v-torgconf-wth-cargo-to         as character    no-undo.
      908   define variable p-torgconf-date-warrant         as date      no-undo.
      909   define variable p-torgconf-N-warrant            as character no-undo.
      910   define variable p-torgconf-accept-fname         as character no-undo.
      911   define variable p-torgconf-accept-position      as character no-undo.
      912   define variable p-torgconf-t_pass-fname         as character no-undo.
      913   define variable p-torgconf-t_pass-position      as character no-undo.
      914   define variable p-torgconf-nfindoc              as character no-undo.
      915   define variable p-torgconf-ndovwho              as character no-undo.
      916   define variable p-torgconf-ddog                 as date      no-undo.
      917   define variable p-torgconf-ndog                 as character no-undo.
      918   define variable v-torgconf-vdoc-code            as character no-undo.
      919   define variable v-doc-code-attr                 as character no-undo.
      920   define variable v-torgconf-doc-date-attr        as character no-undo.
      921   define variable v-torgconf-vdoc-date            as character no-undo.
      922   define variable v-torgconf-main-boss-post       as character no-undo.
      923   define variable v-torgconf-ogr-name             as character no-undo.
      924   define variable v-torgconf-ogr-post             as character no-undo.
      925   define variable v-name                          as character    no-undo.
