     1584   procedure torgconf-get-sup-param :
     1585   define input parameter p-obj-type           as character        no-undo.
     1586   define input parameter p-obj-code           as integer          no-undo.
     1587   define input parameter p-curr-code          as integer          no-undo.
     1588       define variable v-host-code    as integer      no-undo.
     1589       define variable v-par-type     as character    no-undo.
     1590   do
     1591   on error undo, return error
     1592   :
     1593       assign
     1594          v-torgconf-sup-host-code = v-host-code
     1595       .
     1596       if v-torgconf-sup-host-code = 0
     1597       then do:
     1598           assign
     1599               v-torgconf-sup-host-name           = "":U
     1600               v-torgconf-sup-host-addres         = "":U
     1601               v-torgconf-sup-host-post-addres    = "":U
     1602               v-torgconf-sup-host-phone          = "":U
     1603               v-torgconf-sup-host-inn            = "":U
     1604               v-torgconf-sup-host-kpp            = "":U
     1605               v-torgconf-sup-host-okpo           = "":U
     1606               v-torgconf-sup-host-egrip-date     = "":U
     1607               v-torgconf-sup-host-egrip-num      = "":U
     1608           .
     1609       end.
     1610       else do:
     1611           run fmtcli-get-client in this-procedure (
     1612                 input 'орг':U
     1613               , input v-torgconf-sup-host-code
     1614           ).
     1615           assign
     1616               v-torgconf-sup-host-name        = v-fmtcli-name
     1617               v-torgconf-sup-host-engl-name   = v-fmtcli-engl-name
     1618               v-torgconf-sup-host-addres      = v-fmtcli-full-addres
     1619               v-torgconf-sup-host-post-addres = v-fmtcli-post-addres
     1620               v-torgconf-sup-host-phone       = v-fmtcli-phone
     1621               v-torgconf-sup-host-inn         = v-fmtcli-inn
     1622               v-torgconf-sup-host-kpp         = v-fmtcli-kpp
     1623               v-torgconf-sup-host-okpo        = v-fmtcli-okpo
     1624           .
     1625           run gbl/clntat-v.p (
     1626                 input 'орг':U
     1627               , input v-torgconf-sup-host-code
     1628               , input 'egrip-date':U
     1629               , output v-torgconf-sup-host-egrip-date
     1630               , output v-par-type
     1631           ).
     1632           run gbl/clntat-v.p (
     1633                 input 'орг':U
     1634               , input v-torgconf-sup-host-code
     1635               , input 'egrip-num':U
     1636               , output v-torgconf-sup-host-egrip-num
     1637               , output v-par-type
     1638           ).
     1639           run fmtcli-get-bank in this-procedure (
     1640                 input v-host-code
     1641               , input 'орг':U
     1642               , input v-torgconf-sup-host-code
     1643               , input p-curr-code
     1644           ).
     1645       end.
     1646       assign
     1647           v-torgconf-sup-schet-exists = v-fmtcli-schet-exists
     1648           v-torgconf-sup-bank-exists  = v-fmtcli-bank-exists
     1649           v-torgconf-sup-bank-r-schet = v-fmtcli-bank-r-schet
     1650           v-torgconf-sup-bank-c-schet = v-fmtcli-bank-c-schet
     1651           v-torgconf-sup-bank-bik     = v-fmtcli-bank-bik
     1652           v-torgconf-sup-bank-name    = v-fmtcli-bank-name
     1653           v-torgconf-sup-bank-addres  = v-fmtcli-bank-addres
     1654           v-torgconf-sup-bank-city    = v-fmtcli-bank-city
     1655       .
     1656       assign
     1657           v-torgconf-sup-obj-type = p-obj-type
     1658           v-torgconf-sup-obj-code = p-obj-code
     1659       .
     1660       if trim(p-obj-type) <> ""
     1661       and p-obj-code <> 0
     1662       then do:
     1663       run fmtcli-get-client in this-procedure (
     1664             input p-obj-type
     1665           , input p-obj-code
     1666       ).
     1667       assign
     1668           v-torgconf-sup-obj-name        = v-fmtcli-name
     1669           v-torgconf-sup-obj-engl-name   = v-fmtcli-engl-name
     1670           v-torgconf-sup-obj-addres      = v-fmtcli-full-addres
     1671           v-torgconf-temp-post-addres    = v-fmtcli-post-addres
     1672           v-torgconf-sup-obj-phone       = v-fmtcli-phone
     1673           v-torgconf-sup-obj-inn         = v-fmtcli-inn
     1674           v-torgconf-sup-obj-okpo        = v-fmtcli-okpo
     1675       .
     1676      end.
     1677      end.
     1678   end procedure.
     1679   procedure torgconf-get-cli-param :
     1680   define input parameter p-host-obj-code      as integer          no-undo.
     1681   define input parameter p-obj-type           as character        no-undo.
     1682   define input parameter p-obj-code           as integer          no-undo.
     1683   define input parameter p-curr-code          as integer          no-undo.
     1684       define variable v-host-code    as integer      no-undo.
     1685   do
     1686   on error undo, return error
     1687   :
     1688       assign
     1689           v-torgconf-cli-type = p-obj-type
     1690           v-torgconf-cli-code = p-obj-code
     1691       .
     1692       run fmtcli-get-client in this-procedure (
     1693             input p-obj-type
     1694           , input p-obj-code
     1695       ).
     1696       assign
     1697           v-torgconf-cli-name         = trim( v-fmtcli-name          )
     1698           v-torgconf-cli-engl-name    = trim( v-fmtcli-engl-name          )
     1699           v-torgconf-cli-addres       = trim( v-fmtcli-full-addres   )
     1700           v-torgconf-cli-post-addres  = trim( v-fmtcli-post-addres   )
     1701           v-torgconf-cli-phone        = trim( v-fmtcli-phone         )
     1702           v-torgconf-cli-inn          = trim( v-fmtcli-inn           )
     1703           v-torgconf-cli-kpp          = trim( v-fmtcli-kpp           )
     1704           v-torgconf-cli-okpo         = trim( v-fmtcli-okpo          )
     1705       .
     1706      run fmtcli-get-bank in this-procedure (
     1707             input p-host-obj-code
     1708           , input p-obj-type
     1709           , input p-obj-code
     1710           , input p-curr-code
     1711       ).
     1712       assign
     1713           v-torgconf-cli-schet-exists = v-fmtcli-schet-exists
     1714           v-torgconf-cli-bank-exists  = v-fmtcli-bank-exists
     1715           v-torgconf-cli-bank-r-schet = v-fmtcli-bank-r-schet
     1716           v-torgconf-cli-bank-c-schet = v-fmtcli-bank-c-schet
     1717           v-torgconf-cli-bank-bik     = v-fmtcli-bank-bik
     1718           v-torgconf-cli-bank-name    = v-fmtcli-bank-name
     1719           v-torgconf-cli-bank-addres  = v-fmtcli-bank-addres
     1720           v-torgconf-cli-bank-city    = v-fmtcli-bank-city
     1721       .
     1722   end.
     1723   end procedure.
     1724   procedure torgconf-get-ship-param :
     1725   define input parameter p-host-obj-code      as integer          no-undo.
     1726   define input parameter p-obj-type           as character        no-undo.
     1727   define input parameter p-obj-code           as integer          no-undo.
     1728   define input parameter p-curr-code          as integer          no-undo.
     1729       define variable v-host-code    as integer      no-undo.
     1730   do
     1731   on error undo, return error
     1732   :
     1733       assign
     1734           v-torgconf-ship-type = p-obj-type
     1735           v-torgconf-ship-code = p-obj-code
     1736       .
     1737       if trim(p-obj-type) = ""
     1738       and p-obj-code = 0
     1739       then do:
     1740       assign
     1741           v-torgconf-ship-name         = "":U
     1742           v-torgconf-ship-addres       = "":U
     1743           v-torgconf-ship-post-addres  = "":U
     1744           v-torgconf-ship-phone        = "":U
     1745           v-torgconf-ship-inn          = "":U
     1746           v-torgconf-ship-kpp          = "":U
     1747           v-torgconf-ship-okpo         = "":U
     1748       .
     1749       end.
     1750       else do:
     1751       run fmtcli-get-client in this-procedure (
     1752             input p-obj-type
     1753           , input p-obj-code
     1754       ).
     1755       assign
     1756           v-torgconf-ship-name         = trim( v-fmtcli-name          )
     1757           v-torgconf-ship-engl-name    = trim( v-fmtcli-engl-name          )
     1758           v-torgconf-ship-addres       = trim( v-fmtcli-full-addres   )
     1759           v-torgconf-ship-post-addres  = trim( v-fmtcli-post-addres   )
     1760           v-torgconf-ship-phone        = trim( v-fmtcli-phone         )
     1761           v-torgconf-ship-inn          = trim( v-fmtcli-inn           )
     1762           v-torgconf-ship-kpp          = trim( v-fmtcli-kpp           )
     1763           v-torgconf-ship-okpo         = trim( v-fmtcli-okpo          )
     1764       .
     1765       end.
     1766           run fmtcli-get-bank in this-procedure (
     1767             input p-host-obj-code
     1768           , input p-obj-type
     1769           , input p-obj-code
     1770           , input p-curr-code
     1771       ).
     1772       assign
     1773           v-torgconf-ship-schet-exists = v-fmtcli-schet-exists
     1774           v-torgconf-ship-bank-exists  = v-fmtcli-bank-exists
     1775           v-torgconf-ship-bank-r-schet = v-fmtcli-bank-r-schet
     1776           v-torgconf-ship-bank-c-schet = v-fmtcli-bank-c-schet
     1777           v-torgconf-ship-bank-bik     = v-fmtcli-bank-bik
     1778           v-torgconf-ship-bank-name    = v-fmtcli-bank-name
     1779           v-torgconf-ship-bank-addres  = v-fmtcli-bank-addres
     1780           v-torgconf-ship-bank-city    = v-fmtcli-bank-city
     1781       .
     1782   end.
     1783   end procedure.
     1784   procedure torgconf-get-holdfirm-code :
     1785   define input parameter p-obj-type   as character        no-undo.
     1786   define input parameter p-obj-code   as integer          no-undo.
     1787   define output parameter p-firm-code as integer          no-undo.
     1788       define variable v-firm-code-str     as character    no-undo.
     1789       define variable v-par-type          as character    no-undo.
     1790       define buffer buf_clients       for ub.clients.
     1791   do
     1792   for buf_clients
     1793   on error undo, return error
     1794   :
     1795       run gbl/clntat-v.p (
     1796             input p-obj-type
     1797           , input p-obj-code
     1798           , input 'holdfirm-code':U
     1799           , output v-firm-code-str
     1800           , output v-par-type
     1801       ).
     1802       assign
     1803           p-firm-code = integer( v-firm-code-str )
     1804       no-error.
     1805       if error-status :error
     1806       then do:
     1807           message
     1808               "Неверно задан код фирмы для печати накладных."
     1809           view-as alert-box warning.
     1810           assign
     1811               p-firm-code = 0
     1812           .
     1813       end.
     1814       else do:
     1815           find first buf_clients no-lock
     1816                where buf_clients.obj-type = 'орг':U
     1817                  and buf_clients.obj-code = p-firm-code
     1818           no-error.
     1819           if not available buf_clients
     1820           then do:
     1821               message
     1822                   "Включен параметр 'Список печатных форм, для которых должна быть задана фирма для печати накладных' (outhold)" skip
     1823                   "Не найдена фирма по заданному коду фирмы для печати накладных."
     1824               view-as alert-box warning.
     1825               assign
     1826                   p-firm-code = 0
     1827               .
     1828           end.
     1829       end.
     1830   end.
     1831   end procedure.
     1832   procedure torgconf-get-post-head:
     1833   define input  parameter p-obj-type             as character        no-undo.
     1834   define input  parameter p-obj-code             as integer          no-undo.
     1835   define output parameter p-torgconf-post-head   as character        no-undo.
     1836      define variable v-host-code         as integer      no-undo.
     1837      define buffer buf_sysconf     for ub.sysconf.
     1838        assign
     1839         p-torgconf-post-head  = ""
     1840        .
     1841   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1842   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1843     (input  p-obj-type
     1844     ,input  p-obj-code
     1845     ,output v-host-code
     1846     )  .
     1847      find first buf_sysconf no-lock
     1848      where buf_sysconf.host-code = v-host-code
     1849      no-error.
     1850      if available buf_sysconf
     1851      then do:
     1852         assign
     1853            p-torgconf-post-head = buf_sysconf.head-position
     1854         .
     1855      end.
     1856   end procedure.
     1857   procedure torgconf-get-storekeeper:
     1858   define input  parameter p-wrkr                   as integer          no-undo.
     1859   define output parameter p-torgconf-wrkr-name     as character        no-undo.
     1860   define output parameter p-torgconf-post          as character        no-undo.
     1861      define buffer buf_sysconf     for ub.sysconf.
     1862      define buffer buf_person      for ub.person.
     1863      define buffer buf_shop        for ub.shop .
     1864      define buffer buf_store       for ub.store .
     1865      if v-torgconf-outC = "no_print"
     1866      then do:
     1867         assign p-torgconf-post = ""
     1868                p-torgconf-wrkr-name = ""
     1869                .
     1870      end.
     1871      if v-torgconf-outC = "clad_doc"
     1872      then do:
     1873         run rep/get-psn.p
     1874               (input  p-wrkr
     1875               ,output p-torgconf-wrkr-name
     1876               ) .
     1877         find first buf_person no-lock
     1878         where buf_person.psn-code = p-wrkr
     1879         no-error.
     1880         if available buf_person
     1881         then do:
     1882           p-torgconf-post = buf_person.position.
     1883         end.
     1884         if p-torgconf-post = "?":U then p-torgconf-post = "".
     1885         if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     1886      end.
     1887      if v-torgconf-outC = "clad_obj"
     1888      then do:
     1889         CASE v-torgconf-self-obj-type:
     1890         WHEN 'маг':U
     1891         THEN DO:
     1892            find first buf_shop no-lock
     1893            where buf_shop.obj-code = v-torgconf-self-obj-code
     1894            .
     1895            assign
     1896               p-torgconf-wrkr-name = buf_shop.store-man
     1897               p-torgconf-post = ""
     1898            .
     1899            if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     1900         END.
     1901         WHEN 'скл':U
     1902         THEN DO:
     1903            find first buf_store no-lock
     1904            where buf_store.obj-code = v-torgconf-self-obj-code
     1905            .
     1906            assign
     1907               p-torgconf-wrkr-name = buf_store.store-man
     1908               p-torgconf-post = ""
     1909            .
     1910            if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     1911         END.
     1912         OTHERWISE DO:
     1913            assign
     1914               p-torgconf-post = "":U
     1915               p-torgconf-wrkr-name = "":U
     1916            .
     1917         END.
     1918         END CASE.
     1919      end.
     1920    end procedure.
     1921   procedure torgconf-get-form-header :
     1922   define input parameter p-for-inverse    as logical          no-undo.
     1923   define input parameter p-doc-code       as character        no-undo.
     1924   define input parameter p-print-doc      as logical          no-undo.
     1925   define input parameter p-doc-date       as date             no-undo.
     1926   define input parameter p-fact-date      as date             no-undo.
     1927   define input parameter p-doc-type       as character        no-undo.
     1928   define input parameter p-status_        as character        no-undo.
     1929   define input parameter p-reverse        as logical          no-undo.
     1930   define input parameter p-sf-par         as logical          no-undo.
     1931       define variable v-attr-type         as character    no-undo.
     1932       define variable v-doc-code-standard as logical      no-undo.
     1933       define variable v-doc-date-standard as logical      no-undo.
     1934       define variable v-par-consignee-addres  as character    no-undo.
     1935       define variable v-host-code         as integer      no-undo.
     1936       define variable v-dcode-attr        as character    no-undo.
     1937       define variable v-ddate-attr        as character    no-undo.
     1938       define variable v-doc-date          as character    no-undo.
     1939       define variable v-doc-code          as character    no-undo.
     1940       define variable v-par-type          as character    no-undo.
     1941       define variable v-attr              as character    no-undo.
     1942       define buffer buf_firm          for ub.firm .
     1943       define buffer buf_clients       for ub.clients .
     1944       define buffer buf_sysconf       for ub.sysconf .
     1945       define buffer buf_shop          for ub.shop .
     1946       define buffer buf_store         for ub.store .
     1947       define buffer buf_person        for ub.person .
     1948       define buffer buf_trn-doc       for ub.trn-doc .
     1949       define buffer buf_wth-doc       for ub.wth-doc .
     1950       do
     1951   for buf_firm
     1952     , buf_clients
     1953     , buf_sysconf
     1954     , buf_shop
     1955     , buf_trn-doc
     1956     , buf_person
     1957     , buf_wth-doc
     1958   on error undo, return error
     1959   :
     1960       if p-doc-type = 'при':U
     1961       or p-doc-type = 'возврат':U
     1962       then do:
     1963           assign
     1964               v-torgconf-supplier         = substitute( "&1&2&3&4&5", v-torgconf-cli-name, ( if v-torgconf-cli-addres = "":U then "":U else ", " ),
     1965                                             v-torgconf-cli-addres, ( if v-torgconf-cli-phone = "":U then "":U else ", " ), v-torgconf-cli-phone )
     1966               v-torgconf-suppi            = substitute( "&1&2&3&4&5", v-torgconf-cli-name, ( if v-torgconf-cli-addres = "":U then "":U else ", " ),
     1967                                             v-torgconf-cli-addres, ( if v-torgconf-cli-phone = "":U then "":U else ", " ), v-torgconf-cli-phone )
     1968               v-torgconf-saler            = substitute( "&1&2&3&4&5", v-torgconf-self-host-name, ( if v-torgconf-self-host-addres = "":U then "":U else ", " ),
     1969                                             v-torgconf-self-host-addres, ( if v-torgconf-self-host-phone = "":U then "":U else ", " ),v-torgconf-self-host-phone )
     1970               v-torgconf-consignee        = substitute( "&1&2&3&4&5", v-torgconf-sup-host-name, ( if v-torgconf-sup-host-addres = "":U then "":U else ", " ),
     1971                                             v-torgconf-sup-host-addres, ( if v-torgconf-sup-host-phone = "":U then "":U else ", " ), v-torgconf-sup-host-phone  )
     1972               v-torgconf-supplier-okpo    = v-torgconf-cli-okpo
     1973               v-torgconf-saler-okpo       = v-torgconf-self-host-okpo
     1974               v-torgconf-consignee-okpo   = v-torgconf-sup-host-okpo
     1975               v-torgconf-supplier-code    = substitute( "&1", v-torgconf-cli-code         )
     1976               v-torgconf-supplier-type    = v-torgconf-cli-type
     1977               v-torgconf-saler-code       = substitute( "&1", v-torgconf-self-host-code   )
     1978               v-torgconf-saler-type       = v-torgconf-self-host-type
     1979               v-torgconf-consignee-code   = substitute( "&1", v-torgconf-sup-host-code   )
     1980               v-torgconf-consignee-type   = v-torgconf-sup-host-type
     1981               v-torgconf-supplier-name    = substitute( "&1", v-torgconf-cli-name         )
     1982               v-torgconf-saler-name       = substitute( "&1", v-torgconf-self-host-name   )
     1983               v-torgconf-consignee-name   = substitute( "&1", v-torgconf-sup-host-name   )
     1984               v-torgconf-supplier-addr    = substitute( "&1", v-torgconf-cli-addres       )
     1985               v-torgconf-saler-addr       = substitute( "&1", v-torgconf-self-host-addres )
     1986               v-torgconf-consignee-addr   = substitute( "&1", v-torgconf-sup-host-addres )
     1987               v-torgconf-supplier-inn     = substitute( "&1", v-torgconf-cli-inn          )
     1988               v-torgconf-supplier-engl-name     = substitute( "&1", v-torgconf-cli-engl-name          )
     1989               v-torgconf-saler-inn        = substitute( "&1", v-torgconf-self-host-inn    )
     1990               v-torgconf-consignee-inn    = substitute( "&1", v-torgconf-sup-host-inn    )
     1991               v-torgconf-supplier-kpp     = substitute( "&1", v-torgconf-cli-kpp          )
     1992               v-torgconf-saler-kpp        = substitute( "&1", v-torgconf-self-host-kpp    )
     1993               v-torgconf-consignee-kpp    = substitute( "&1", v-torgconf-sup-host-kpp    )
     1994           .
     1995           if v-torgconf-cli-schet-exists = yes
     1996           AND v-form-name                  = "torg12":U
     1997           then do:
     1998               assign
     1999                   v-torgconf-supplier = v-torgconf-supplier
     2000                       + substitute( ", р/с &1 к/с &2"
     2001                                   , v-torgconf-cli-bank-r-schet
     2002                                   , v-torgconf-cli-bank-c-schet
     2003                                   )
     2004                   v-torgconf-suppi = v-torgconf-supplier
     2005                       + substitute( ", р/с &1 к/с &2"
     2006                                   , v-torgconf-cli-bank-r-schet
     2007                                   , v-torgconf-cli-bank-c-schet
     2008                                   )
     2009               .
     2010               if v-torgconf-cli-bank-exists = yes
     2011               then do:
     2012                   assign
     2013                       v-torgconf-supplier = v-torgconf-supplier
     2014                           + substitute( " БИК &1 в &2 &3"
     2015                                       , v-torgconf-cli-bank-bik
     2016                                       , v-torgconf-cli-bank-name
     2017                                       ,(if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) )
     2018                                       )
     2019                      v-torgconf-suppi = v-torgconf-supplier
     2020                           + substitute( " БИК &1 в &2 &3"
     2021                                       , v-torgconf-cli-bank-bik
     2022                                       , v-torgconf-cli-bank-name
     2023                                       ,(if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) )
     2024                                       )
     2025                   .
     2026               end.
     2027           end.
     2028           if v-torgconf-self-schet-exists = yes
     2029           AND v-form-name                  = "torg12":U
     2030           then do:
     2031               assign
     2032                   v-torgconf-saler = v-torgconf-saler
     2033                       + substitute( ", р/с &1 к/с &2"
     2034                                   , v-torgconf-self-bank-r-schet
     2035                                   , v-torgconf-self-bank-c-schet
     2036                                   )
     2037               .
     2038               if v-torgconf-self-bank-exists = yes
     2039               then do:
     2040                   assign
     2041                       v-torgconf-saler = v-torgconf-saler
     2042                           + substitute( " БИК &1 в &2 &3"
     2043                                       , v-torgconf-self-bank-bik
     2044                                       , v-torgconf-self-bank-name
     2045                                       , v-torgconf-self-bank-addres
     2046                                       )
     2047                   .
     2048               end.
     2049           end.
     2050           if v-torgconf-sup-schet-exists = yes
     2051           AND v-form-name                  = "torg12":U
     2052           then do:
     2053               assign
     2054                   v-torgconf-consignee = v-torgconf-consignee
     2055                       + substitute( ", р/с &1 к/с &2"
     2056                                   , v-torgconf-sup-bank-r-schet
     2057                                   , v-torgconf-sup-bank-c-schet
     2058                                   )
     2059               .
     2060             if v-torgconf-sup-bank-exists = yes
     2061              then do:
     2062                assign
     2063                   v-torgconf-consignee = v-torgconf-consignee
     2064                           + substitute( " БИК &1 в &2 &3"
     2065                                       , v-torgconf-sup-bank-bik
     2066                                       , v-torgconf-sup-bank-name
     2067                                       , v-torgconf-sup-bank-addres
     2068                                       )
     2069                   .
     2070               end.
     2071           end.
     2072      if v-torgconf-outares = yes  AND v-form-name  = "torg12":U
     2073      then do:
     2074          assign
     2075            v-torgconf-supplier = substitute(  "&1&2&3 &4 &5&6"
     2076                                                   , IF v-form-name = "torg12":U THEN SUBSTITUTE("ИНН &1 КПП &2 ", v-torgconf-cli-inn, v-torgconf-cli-kpp) ELSE "":U
     2077                                                   , v-torgconf-cli-name
     2078                                                   , ( if v-torgconf-outprncd = yes
     2079                                                         then substitute( " (&1)", v-torgconf-cli-code )
     2080                                                         else "":U )
     2081                                                   , v-torgconf-cli-post-addres
     2082                                                   , v-torgconf-cli-phone
     2083                                                   , ( if v-torgconf-cli-bank-r-schet <> "":U
     2084                                                       AND v-form-name                  = "torg12":U
     2085                                                         then substitute( ", р/с &1 к/с &2, БИК &3 в &4, &5"
     2086                                                               , v-torgconf-cli-bank-r-schet
     2087                                                               , v-torgconf-cli-bank-c-schet
     2088                                                               , v-torgconf-cli-bank-bik
     2089                                                               , v-torgconf-cli-bank-name
     2090                                                               , (if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) )     )
     2091                                                         else "":U )
     2092                                                )
     2093         .
     2094      end.
     2095       v-torgconf-suppi = substitute(  "&1&2&3 &4 &5&6"
     2096                                        , IF v-form-name = "torg12":U THEN SUBSTITUTE("ИНН &1 КПП &2 ", v-torgconf-cli-inn, v-torgconf-cli-kpp) ELSE "":U
     2097                                        , v-torgconf-cli-name
     2098                                        , ( if v-torgconf-outprncd = yes
     2099                                            then substitute( " (&1)", v-torgconf-cli-code )
