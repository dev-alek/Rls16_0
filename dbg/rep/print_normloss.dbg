     1081   empty temp-table thbjattr_thbj-attr.
     1082   run adm/shattri.p (
     1083      input "get":U
     1084     ,input p-obj-type
     1085     ,input p-obj-code
     1086     ,input 'prt-obj':U
     1087     ,input  ""
     1088     ,output v-value-character
     1089     ,output v-value-date
     1090     ,output v-value-decimal
     1091     ,output v-value-integer
     1092     ,output v-value-logical
     1093     ,output par-type
     1094     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     1095     ) no-error .
     1096   for each thbjattr_thbj-attr :
     1097       if thbjattr_thbj-attr.prop-code = 'outdate':U  then v-outdate  =  thbjattr_thbj-attr.property-value-character .
     1098       if thbjattr_thbj-attr.prop-code = 'outares':U  then v-outares  =  thbjattr_thbj-attr.property-value-character .
     1099       if thbjattr_thbj-attr.prop-code = 'outnum':U   then v-outnum   =  thbjattr_thbj-attr.property-value-character .
     1100       if thbjattr_thbj-attr.prop-code = 'outprim':U  then v-outprim  =  thbjattr_thbj-attr.property-value-character .
     1101       if thbjattr_thbj-attr.prop-code = 'outdisc':U  then v-outdisc  =  thbjattr_thbj-attr.property-value-character .
     1102       if thbjattr_thbj-attr.prop-code = 'outsubs':U  then v-outsubs  =  thbjattr_thbj-attr.property-value-character .
     1103       if thbjattr_thbj-attr.prop-code = 'outegrp':U  then v-outegrp  =  thbjattr_thbj-attr.property-value-character .
     1104       if thbjattr_thbj-attr.prop-code = 'outt12':U   then v-outt12   =  thbjattr_thbj-attr.property-value-character .
     1105       if thbjattr_thbj-attr.prop-code = 'outappr':U  then v-outappr  =  thbjattr_thbj-attr.property-value-character .
     1106       if thbjattr_thbj-attr.prop-code = 'outrubl':U  then v-outrubl  =  thbjattr_thbj-attr.property-value-character .
     1107       if thbjattr_thbj-attr.prop-code = 'outhold':U  then v-outhold  =  thbjattr_thbj-attr.property-value-character .
     1108       if thbjattr_thbj-attr.prop-code = 'outobj':U   then v-outobj   =  thbjattr_thbj-attr.property-value-character .
     1109       if thbjattr_thbj-attr.prop-code = 'outsend':U  then v-outsend  =  thbjattr_thbj-attr.property-value-character .
     1110       if thbjattr_thbj-attr.prop-code = 'outasend':U then v-outasend =  thbjattr_thbj-attr.property-value-character .
     1111       if thbjattr_thbj-attr.prop-code = 'outogr':U   then v-torgconf-outogr   =  thbjattr_thbj-attr.property-value-character .
     1112       if thbjattr_thbj-attr.prop-code = 'outR':U     then v-torgconf-outR     =  thbjattr_thbj-attr.property-value-character .
     1113       if thbjattr_thbj-attr.prop-code = 'outB':U     then v-torgconf-outB     =  thbjattr_thbj-attr.property-value-character .
     1114       if thbjattr_thbj-attr.prop-code = 'outssdoc':U then v-torgconf-outssdoc =  thbjattr_thbj-attr.property-value-character .
     1115       if thbjattr_thbj-attr.prop-code = 'outC':U     then v-torgconf-outC     =  thbjattr_thbj-attr.property-value-character .
     1116   end.
     1117       run gbl/conf-rd.p ("outexpas", "":U, "":U, 0, "":U, "":U, "":U, no, output v-torgconf-outexpas, output v-par-type) no-error.
     1118       if error-status :error
     1119       then do:
     1120           assign
     1121               v-torgconf-outexpas = "":U
     1122           .
     1123       end.
     1124       assign
     1125           v-torgconf-outprncd = ( v-outprncd = "yes":U )
     1126       .
     1127       if p-form-name <> ""
     1128       and p-form-name <> ?
     1129       then do:
     1130           run gbl/conf-rd.p ("outexlst" , p-host-code, p-obj-type, p-obj-code, "", "", "", no, output v-outexlst , output v-par-type) no-error.
     1131           if error-status :error
     1132           then do:
     1133               assign
     1134                   v-outexlst           = ""
     1135               .
     1136           end.
     1137           if lookup( p-form-name, v-outdate ) <> 0
     1138           then do:
     1139               assign
     1140                   v-torgconf-outdate  = yes
     1141               .
     1142           end.
     1143           if lookup( p-form-name, v-outares ) <> 0
     1144           then do:
     1145               assign
     1146                   v-torgconf-outares  = yes
     1147               .
     1148           end.
     1149           if lookup( p-form-name, v-outnum  ) <> 0
     1150           then do:
     1151               assign
     1152                   v-torgconf-outnum   = yes
     1153               .
     1154           end.
     1155           if lookup( p-form-name, v-outprim ) <> 0
     1156           then do:
     1157               assign
     1158                   v-torgconf-outprim  = yes
     1159               .
     1160           end.
     1161           if lookup( p-form-name, v-outdisc ) <> 0
     1162           then do:
     1163               assign
     1164                   v-torgconf-outdisc  = yes
     1165               .
     1166           end.
     1167           if lookup( p-form-name, v-outsubs ) <> 0
     1168           then do:
     1169               assign
     1170                   v-torgconf-outsubs  = yes
     1171               .
     1172           end.
     1173           if lookup( p-form-name, v-outrecv ) <> 0
     1174           then do:
     1175               assign
     1176                   v-torgconf-outrecv  = yes
     1177               .
     1178           end.
     1179           if lookup( p-form-name, v-outegrp ) <> 0
     1180           then do:
     1181               assign
     1182                   v-torgconf-outegrp  = yes
     1183               .
     1184           end.
     1185           if lookup( p-form-name, v-outt12  ) <> 0
     1186           then do:
     1187               assign
     1188                   v-torgconf-outt12   = yes
     1189               .
     1190           end.
     1191           if lookup( p-form-name, v-outappr  ) <> 0
     1192           then do:
     1193               assign
     1194                   v-torgconf-outappr   = yes
     1195               .
     1196           end.
     1197           if lookup( p-form-name, v-outrubl  ) <> 0
     1198           then do:
     1199               assign
     1200                   v-torgconf-outrubl   = yes
     1201               .
     1202           end.
     1203           if lookup( p-form-name, v-outhold  ) <> 0
     1204           then do:
     1205               assign
     1206                   v-torgconf-outhold   = yes
     1207               .
     1208           end.
     1209           if lookup( p-form-name, v-outobj   ) <> 0
     1210           then do:
     1211               assign
     1212                   v-torgconf-outobj    = yes
     1213               .
     1214           end.
     1215           if lookup( p-form-name, v-outsend   ) <> 0
     1216           then do:
     1217               assign
     1218                   v-torgconf-outsend    = yes
     1219               .
     1220           end.
     1221           if lookup( p-form-name, v-outasend   ) <> 0
     1222           then do:
     1223               assign
     1224                   v-torgconf-outasend    = yes
     1225               .
     1226           end.
     1227           if lookup( p-form-name, v-outprops   ) <> 0
     1228           then do:
