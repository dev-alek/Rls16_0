        1   using ibs.th.str.*.
        2   block-level on error undo, throw.
        3   define variable vss-revision    as character no-undo init "$Revision: 62b337b2b107, 1578, rls $":U .
        4   define variable vss-author      as character no-undo init "$Author: EShklyar $":U .
        5   define variable vss-date        as character no-undo init "$Date: Tue Nov 06 04:41:35 2018 +0300 $":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile: print_NormLoss.p $":U .
        7   define variable vss-archive     as character no-undo init "$Archive: rep/print_NormLoss.p $":U .
        8   define variable vss-description as character no-undo init "Нормы технологических потерь".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define input parameter parParentProc as widget-handle     no-undo .
       64   define input parameter p-type        as integer           no-undo .
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   FUNCTION LastMonthDate RETURNS DATE    ( INPUT i-date AS DATE ) :
       70     DEFINE VARIABLE t_date AS DATE NO-UNDO.
       71     RUN get-last-month-date IN THIS-PROCEDURE ( INPUT i-date, OUTPUT t_date ) NO-ERROR.
       72     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE t_date ).
       73   END FUNCTION.
       74   PROCEDURE get-last-month-date :
       75     DEFINE  INPUT PARAMETER p-curr-date AS DATE NO-UNDO.
       76     DEFINE OUTPUT PARAMETER p-last-date AS DATE NO-UNDO.
       77     DO ON ERROR UNDO, RETURN ERROR :
       78       ASSIGN p-last-date = DATE( MONTH( p-curr-date ), 28,  YEAR( p-curr-date ) ).
       79       ASSIGN p-last-date = p-last-date - DAY( p-last-date + 4 ) + 4.
       80     END.
       81   END PROCEDURE.
       82   FUNCTION LastMonthDay  RETURNS INTEGER ( INPUT i-date AS DATE ) :
       83     DEFINE VARIABLE j_day AS INTEGER NO-UNDO.
       84     RUN get-last-month-day IN THIS-PROCEDURE ( INPUT i-date, OUTPUT j_day ) NO-ERROR.
       85     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE j_day ).
       86   END FUNCTION.
       87   PROCEDURE get-last-month-day :
       88     DEFINE  INPUT PARAMETER p-date AS DATE    NO-UNDO.
       89     DEFINE OUTPUT PARAMETER p-day  AS INTEGER NO-UNDO.
       90     DEFINE VARIABLE t_date AS DATE NO-UNDO.
       91     DO ON ERROR UNDO, RETURN ERROR :
       92       ASSIGN t_date = DATE( MONTH( p-date ), 28,  YEAR( p-date ) ).
       93       ASSIGN p-day  = DAY( t_date - DAY( t_date + 4 ) + 4 ).
       94     END.
       95   END PROCEDURE.
       96   FUNCTION LastDay-MY  RETURNS INTEGER ( INPUT i-month AS INTEGER, INPUT i-year AS INTEGER ) :
       97     DEFINE VARIABLE j_day AS INTEGER NO-UNDO.
       98     RUN get-last-day-MY IN THIS-PROCEDURE ( INPUT i-month, INPUT i-year, OUTPUT j_day ) NO-ERROR.
       99     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE j_day ).
      100   END FUNCTION.
      101   PROCEDURE get-last-day-MY :
      102     DEFINE  INPUT PARAMETER p-month AS INTEGER NO-UNDO.
      103     DEFINE  INPUT PARAMETER p-year  AS INTEGER NO-UNDO.
      104     DEFINE OUTPUT PARAMETER p-day   AS INTEGER NO-UNDO.
      105     DEFINE VARIABLE t_date AS DATE NO-UNDO.
      106     DO ON ERROR UNDO, RETURN ERROR :
      107       ASSIGN t_date = DATE( p-month, 28, p-year ).
      108       ASSIGN p-day  = DAY( t_date - DAY( t_date + 4 ) + 4 ).
      109     END.
      110   END PROCEDURE.
      111   FUNCTION LastDate-MY RETURNS DATE    ( INPUT i-month AS INTEGER, INPUT i-year AS INTEGER ) :
      112     DEFINE VARIABLE t_date AS DATE NO-UNDO.
      113     RUN get-last-date-MY IN THIS-PROCEDURE ( INPUT i-month, INPUT i-year, OUTPUT t_date ) NO-ERROR.
      114     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE t_date ).
      115   END FUNCTION.
      116   PROCEDURE get-last-date-MY :
      117     DEFINE  INPUT PARAMETER p-month AS INTEGER NO-UNDO.
      118     DEFINE  INPUT PARAMETER p-year  AS INTEGER NO-UNDO.
      119     DEFINE OUTPUT PARAMETER p-date  AS DATE    NO-UNDO.
      120     DO ON ERROR UNDO, RETURN ERROR :
      121       ASSIGN p-date = DATE( p-month, 28, p-year ).
      122       ASSIGN p-date = p-date - DAY( p-date + 4 ) + 4.
      123     END.
      124   END PROCEDURE.
      125   FUNCTION NextMonth RETURNS INTEGER ( INPUT i-date AS DATE ) :
      126     DEFINE VARIABLE j_month AS INTEGER NO-UNDO.
      127     RUN get-next-month IN THIS-PROCEDURE ( INPUT i-date, OUTPUT j_month ) NO-ERROR.
      128     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE j_month ).
      129   END FUNCTION.
      130   PROCEDURE get-next-month :
      131     DEFINE  INPUT PARAMETER p-date  AS DATE    NO-UNDO.
      132     DEFINE OUTPUT PARAMETER p-month AS INTEGER NO-UNDO.
      133     DO ON ERROR UNDO, RETURN ERROR :
      134       ASSIGN p-month = ( MONTH( p-date ) MODULO 12 ) + 1.
      135     END.
      136   END PROCEDURE.
      137   FUNCTION NextYear  RETURNS INTEGER ( INPUT i-date AS DATE ) :
      138     DEFINE VARIABLE j_year AS INTEGER NO-UNDO.
      139     RUN get-next-year IN THIS-PROCEDURE ( INPUT i-date, OUTPUT j_year ) NO-ERROR.
      140     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE j_year ).
      141   END FUNCTION.
      142   PROCEDURE get-next-year :
      143     DEFINE  INPUT PARAMETER p-date AS DATE    NO-UNDO.
      144     DEFINE OUTPUT PARAMETER p-year AS INTEGER NO-UNDO.
      145     DO ON ERROR UNDO, RETURN ERROR :
      146       ASSIGN p-year = YEAR( p-date ) + ( IF MONTH( p-date ) < 12 THEN 0 ELSE 1 ).
      147     END.
      148   END PROCEDURE.
      149   FUNCTION PrevMonth RETURNS INTEGER ( INPUT i-date AS DATE ) :
      150     DEFINE VARIABLE j_month AS INTEGER NO-UNDO.
      151     RUN get-prev-month IN THIS-PROCEDURE ( INPUT i-date, OUTPUT j_month ) NO-ERROR.
      152     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE j_month ).
      153   END FUNCTION.
      154   PROCEDURE get-prev-month :
      155     DEFINE  INPUT PARAMETER p-date  AS DATE    NO-UNDO.
      156     DEFINE OUTPUT PARAMETER p-month AS INTEGER NO-UNDO.
      157     DO ON ERROR UNDO, RETURN ERROR :
      158       ASSIGN p-month = ( ( ( MONTH( p-date ) + 10 ) MODULO 12 ) MODULO 12 ) + 1.
      159     END.
      160   END PROCEDURE.
      161   FUNCTION PrevYear  RETURNS INTEGER ( INPUT i-date AS DATE ) :
      162     DEFINE VARIABLE j_year AS INTEGER NO-UNDO.
      163     RUN get-prev-year IN THIS-PROCEDURE ( INPUT i-date, OUTPUT j_year ) NO-ERROR.
      164     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE j_year ).
      165   END FUNCTION.
      166   PROCEDURE get-prev-year :
      167     DEFINE  INPUT PARAMETER p-date AS DATE    NO-UNDO.
      168     DEFINE OUTPUT PARAMETER p-year AS INTEGER NO-UNDO.
      169     DO ON ERROR UNDO, RETURN ERROR :
      170       ASSIGN p-year = YEAR( p-date ) + ( IF MONTH( p-date ) = 1 THEN -1 ELSE 0 ).
      171     END.
      172   END PROCEDURE.
      173   FUNCTION NextMonth-MY RETURNS INTEGER ( INPUT i-month AS INTEGER ) :
      174     DEFINE VARIABLE j_month AS INTEGER NO-UNDO.
      175     RUN get-next-month-MY IN THIS-PROCEDURE ( INPUT i-month, OUTPUT j_month ) NO-ERROR.
      176     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE j_month ).
      177   END FUNCTION.
      178   PROCEDURE get-next-month-MY :
      179     DEFINE  INPUT PARAMETER p-curr-month AS INTEGER NO-UNDO.
      180     DEFINE OUTPUT PARAMETER p-next-month AS INTEGER NO-UNDO.
      181     DO ON ERROR UNDO, RETURN ERROR :
      182       ASSIGN p-next-month = ( p-curr-month MODULO 12 ) + 1.
      183     END.
      184   END PROCEDURE.
      185   FUNCTION NextYear-MY  RETURNS INTEGER ( INPUT i-month AS INTEGER, INPUT i-year AS INTEGER ) :
      186     DEFINE VARIABLE j_year AS INTEGER NO-UNDO.
      187     RUN get-next-year-MY IN THIS-PROCEDURE ( INPUT i-month, INPUT i-year, OUTPUT j_year ) NO-ERROR.
      188     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE j_year ).
      189   END FUNCTION.
      190   PROCEDURE get-next-year-MY :
      191     DEFINE  INPUT PARAMETER p-curr-month AS INTEGER NO-UNDO.
      192     DEFINE  INPUT PARAMETER p-curr-year  AS INTEGER NO-UNDO.
      193     DEFINE OUTPUT PARAMETER p-next-year  AS INTEGER NO-UNDO.
      194     DO ON ERROR UNDO, RETURN ERROR :
      195       ASSIGN p-next-year = p-curr-year + ( IF p-curr-month < 12 THEN 0 ELSE 1 ).
      196     END.
      197   END PROCEDURE.
      198   FUNCTION MonthNameRus RETURNS CHARACTER ( INPUT i-month AS INTEGER ) :
      199     DEFINE VARIABLE v-name AS CHARACTER NO-UNDO.
      200     RUN get-month-name-rus IN THIS-PROCEDURE ( INPUT i-month, OUTPUT v-name ) NO-ERROR.
      201     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE v-name ).
      202   END FUNCTION.
      203   PROCEDURE get-month-name-rus :
      204     DEFINE  INPUT PARAMETER p-month AS INTEGER   NO-UNDO.
      205     DEFINE OUTPUT PARAMETER p-name  AS CHARACTER NO-UNDO.
      206     DEFINE VARIABLE v-list AS CHARACTER NO-UNDO INITIAL "Январь,Февраль,Март,Апрель,Май,Июнь,Июль,Август,Сентябрь,Октябрь,Ноябрь,Декабрь".
      207     DO ON ERROR UNDO, RETURN ERROR :
      208       ASSIGN p-name = ( IF p-month >= 1 AND p-month <= 12 THEN ENTRY( p-month, v-list ) ELSE ? ).
      209     END.
      210   END PROCEDURE.
      211   FUNCTION MonthNameRusGen RETURNS CHARACTER ( INPUT i-month AS INTEGER ) :
      212     DEFINE VARIABLE v-name AS CHARACTER NO-UNDO.
      213     RUN get-month-name-gen IN THIS-PROCEDURE ( INPUT i-month, OUTPUT v-name ) NO-ERROR.
      214     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE v-name ).
      215   END FUNCTION.
      216   PROCEDURE get-month-name-gen :
      217     DEFINE  INPUT PARAMETER p-month AS INTEGER   NO-UNDO.
      218     DEFINE OUTPUT PARAMETER p-name  AS CHARACTER NO-UNDO.
      219     DEFINE VARIABLE v-list AS CHARACTER NO-UNDO INITIAL "Января,Февраля,Марта,Апреля,Мая,Июня,Июля,Августа,Сентября,Октября,Ноября,Декабря".
      220     DO ON ERROR UNDO, RETURN ERROR :
      221       ASSIGN p-name = ( IF p-month >= 1 AND p-month <= 12 THEN ENTRY( p-month, v-list ) ELSE ? ).
      222     END.
      223   END PROCEDURE.
      224   FUNCTION CalcMonthes  RETURNS INTEGER ( INPUT i-date-from AS DATE, INPUT i-date-till AS DATE ) :
      225     DEFINE VARIABLE j_month-num AS INTEGER NO-UNDO.
      226     RUN get-month-number IN THIS-PROCEDURE ( INPUT i-date-from, INPUT i-date-till, OUTPUT j_month-num ) NO-ERROR.
      227     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE j_month-num ).
      228   END FUNCTION.
      229   PROCEDURE get-month-number :
      230     DEFINE  INPUT PARAMETER p-date-from AS DATE    NO-UNDO.
      231     DEFINE  INPUT PARAMETER p-date-till AS DATE    NO-UNDO.
      232     DEFINE OUTPUT PARAMETER p-month-num AS INTEGER NO-UNDO.
      233     DO ON ERROR UNDO, RETURN ERROR :
      234       ASSIGN p-month-num = ( YEAR(  p-date-till ) - YEAR(  p-date-from ) ) * 12 +
      235                              MONTH( p-date-till ) - MONTH( p-date-from )   +  1 .
      236     END.
      237   END PROCEDURE.
      238   FUNCTION CalcMonth-MY RETURNS INTEGER ( INPUT i-year-from  AS INTEGER,
      239                                           INPUT i-month-from AS INTEGER,
      240                                           INPUT i-year-till  AS INTEGER,
      241                                           INPUT i-month-till AS INTEGER  ) :
      242     DEFINE VARIABLE j_month-num AS INTEGER NO-UNDO.
      243     RUN get-month-num-MY IN THIS-PROCEDURE (  INPUT i-year-from,
      244                                               INPUT i-month-from,
      245                                               INPUT i-year-till,
      246                                               INPUT i-month-till,
      247                                              OUTPUT j_month-num   ) NO-ERROR.
      248     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE j_month-num ).
      249   END FUNCTION.
      250   PROCEDURE get-month-num-MY :
      251     DEFINE  INPUT PARAMETER p-year-from  AS INTEGER NO-UNDO.
      252     DEFINE  INPUT PARAMETER p-month-from AS INTEGER NO-UNDO.
      253     DEFINE  INPUT PARAMETER p-year-till  AS INTEGER NO-UNDO.
      254     DEFINE  INPUT PARAMETER p-month-till AS INTEGER NO-UNDO.
      255     DEFINE OUTPUT PARAMETER p-month-num  AS INTEGER NO-UNDO.
      256     DO ON ERROR UNDO, RETURN ERROR :
      257       ASSIGN p-month-num = ( p-year-till - p-year-from ) * 12 + p-month-till - p-month-from + 1.
      258     END.
      259   END PROCEDURE.
      260   FUNCTION DateTimeHeader RETURNS CHARACTER ( INPUT i-date AS DATE ) :
      261     DEFINE VARIABLE v-header AS CHARACTER NO-UNDO.
      262     RUN get-date-time-header IN THIS-PROCEDURE ( INPUT i-date, OUTPUT v-header ) NO-ERROR.
      263     RETURN ( IF ERROR-STATUS :ERROR THEN "":U ELSE v-header ).
      264   END FUNCTION.
      265   PROCEDURE get-date-time-header :
      266     DEFINE  INPUT PARAMETER p-date AS DATE      NO-UNDO.
      267     DEFINE OUTPUT PARAMETER p-head AS CHARACTER NO-UNDO.
      268     DO ON ERROR UNDO, RETURN ERROR :
      269       IF p-date = ? THEN DO: ASSIGN p-date = TODAY. END.
      270       ASSIGN p-head = "Дата печати: " + STRING( p-date, "99.99.9999":U ) + ", ":U + STRING( TIME, "HH:MM":U ).
      271     END.
      272   END PROCEDURE.
      273   FUNCTION Leap-Year RETURNS LOGICAL ( INPUT i-year AS INTEGER ) :
      274     DEFINE VARIABLE bissextile AS LOGICAL NO-UNDO.
      275     RUN get-leap-year-sign IN THIS-PROCEDURE ( INPUT i-year, OUTPUT bissextile ) NO-ERROR.
      276     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE bissextile ).
      277   END FUNCTION.
      278   PROCEDURE get-leap-year-sign :
      279     DEFINE  INPUT PARAMETER p-year AS INTEGER NO-UNDO.
      280     DEFINE OUTPUT PARAMETER p-sign AS LOGICAL NO-UNDO.
      281     DEFINE VARIABLE t_date AS DATE NO-UNDO.
      282     DO ON ERROR UNDO, RETURN ERROR :
      283       IF p-year = ? OR p-year = 0 THEN DO:
      284         ASSIGN t_date = TODAY.
      285         IF t_date <> TODAY THEN DO: ASSIGN t_date = TODAY. END.
      286         ASSIGN p-year = YEAR( t_date ).
      287       END.
      288       ASSIGN p-sign = ( INTEGER( TRUNCATE( p-year * 0.25, 0 ) ) * 4 = p-year ).
      289     END.
      290   END PROCEDURE.
      291   FUNCTION Leap-Year-d RETURNS LOGICAL ( INPUT i-date AS DATE ) :
      292     DEFINE VARIABLE bissextile AS LOGICAL NO-UNDO.
      293     RUN get-leap-year-sign-d IN THIS-PROCEDURE ( INPUT i-date, OUTPUT bissextile ) NO-ERROR.
      294     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE bissextile ).
      295   END FUNCTION.
      296   PROCEDURE get-leap-year-sign-d :
      297     DEFINE  INPUT PARAMETER p-date AS DATE    NO-UNDO.
      298     DEFINE OUTPUT PARAMETER p-sign AS LOGICAL NO-UNDO.
      299     DEFINE VARIABLE j-year AS INTEGER NO-UNDO.
      300     DO ON ERROR UNDO, RETURN ERROR :
      301       IF p-date = ? THEN DO:
      302         ASSIGN p-date = TODAY.
      303         IF p-date <> TODAY THEN DO: ASSIGN p-date = TODAY. END.
      304       END.
      305       ASSIGN j-year = YEAR( p-date ).
      306       ASSIGN p-sign = ( INTEGER( TRUNCATE( j-year * 0.25, 0 ) ) * 4 = j-year ).
      307     END.
      308   END PROCEDURE.
      309   define stream out-stream.
      310   define new global shared variable g#library  as handle no-undo .
      311   define new global shared variable g#library2 as handle no-undo .
      312   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      313   define  shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      314   define  shared variable RepPathName        as character no-undo .
      315   define  shared variable PrintRubl          as logical   no-undo .
      316   define new global shared variable g#lib-trn  as handle no-undo .
      317   define new global shared variable g#lib-trn2 as handle no-undo .
      318   define new global shared variable g#lib-trn3 as handle no-undo .
      319   define new global shared variable g#lib-trn4 as handle no-undo .
      320   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      321   define new global shared variable g#trdcalib as handle no-undo.
      322   FUNCTION center-field RETURNS INTEGER (INPUT iStartPix AS INTEGER, iEndPix AS INTEGER,
      323                                     iInput AS INTEGER).
      324     def var v-start-print as integer no-undo .
      325     if (iStartPix < 0) or (iEndPix < iStartPix) then return 0.
      326     assign
      327       v-start-print = INTEGER(iStartPix + ((iEndPix - iStartPix) / 2) - (iInput / 2))
      328     .
      329     RETURN v-start-print .
      330   END FUNCTION.
      331   FUNCTION right-field RETURNS INTEGER ( iEndPix AS INTEGER,
      332                                     iInput AS INTEGER).
      333     def var v-start-print as integer no-undo .
      334     assign
      335       v-start-print = INTEGER(iEndPix - 1 - iInput)
      336     .
      337     if v-start-print < 0 then return 0.
      338     RETURN v-start-print .
      339   END FUNCTION.
      340   define variable vss-include-info2 as character format "X(65)" no-undo
      341   initial "@(#)$Workfile$ $Revision$".
      342   define variable v-fmtcli-name          as character    no-undo.
      343   define variable v-fmtcli-engl-name     as character    no-undo.
      344   define variable v-fmtcli-addres        as character    no-undo.
      345   define variable v-fmtcli-post-addres   as character    no-undo.
      346   define variable v-fmtcli-full-addres   as character    no-undo.
      347   define variable v-fmtcli-phone         as character    no-undo.
      348   define variable v-fmtcli-inn           as character    no-undo.
      349   define variable v-fmtcli-kpp           as character    no-undo.
      350   define variable v-fmtcli-okpo          as character    no-undo.
      351   define variable v-fmtcli-country       as character    no-undo.
      352   define variable v-fmtcli-city          as character    no-undo.
      353   define variable v-fmtcli-index         as character    no-undo.
      354   define variable v-fmtcli-schet-exists  as logical      no-undo.
      355   define variable v-fmtcli-bank-exists   as logical      no-undo.
      356   define variable v-fmtcli-bank-r-schet  as character    no-undo.
      357   define variable v-fmtcli-bank-c-schet  as character    no-undo.
      358   define variable v-fmtcli-bank-bik      as character    no-undo.
      359   define variable v-fmtcli-bank-name     as character    no-undo.
      360   define variable v-fmtcli-bank-addres   as character    no-undo.
      361   define variable v-fmtcli-bank-city     as character    no-undo.
      362   procedure fmtcli-get-bank :
      363   define input parameter p-host-code      as integer          no-undo.
      364   define input parameter p-obj-type       as character        no-undo.
      365   define input parameter p-obj-code       as integer          no-undo.
      366   define input parameter p-curr-code      as integer          no-undo.
      367       define buffer buf_fin-schet     for ub.fin-schet.
      368       define buffer buf_fin-bank      for ub.fin-bank.
      369   do
      370   for buf_fin-schet
      371     , buf_fin-bank
      372   on error undo, return error
      373   :
      374       assign
      375           v-fmtcli-schet-exists       = no
      376           v-fmtcli-bank-exists        = no
      377           v-fmtcli-bank-r-schet       = "":U
      378           v-fmtcli-bank-c-schet       = "":U
      379           v-fmtcli-bank-bik           = "":U
      380           v-fmtcli-bank-name          = "":U
      381           v-fmtcli-bank-addres        = "":U
      382           v-fmtcli-bank-city          = "":U
      383       .
      384       search-for-schet:
      385       for each buf_fin-schet no-lock
      386          where buf_fin-schet.host-code = p-host-code
      387            and buf_fin-schet.cli-type  = p-obj-type
      388            and buf_fin-schet.cli-code  = p-obj-code
      389            and buf_fin-schet.curr-code = p-curr-code
      390       on error undo, return error
      391       :
      392           if buf_fin-schet.status_   = 'удал':U
      393           then do:
      394           end.
      395           else do:
      396               assign
      397                   v-fmtcli-schet-exists   = yes
      398                   v-fmtcli-bank-r-schet   = trim( buf_fin-schet.r-schet )
      399                   v-fmtcli-bank-c-schet   = trim( buf_fin-schet.c-schet )
      400               .
      401               find first buf_fin-bank no-lock
      402                    where buf_fin-bank.host-code = p-host-code
      403                      and buf_fin-bank.code-bank = buf_fin-schet.code-bank
      404               no-error.
      405               if available buf_fin-bank
      406               then do:
      407                   assign
      408                       v-fmtcli-bank-exists      = yes
      409                       v-fmtcli-bank-bik         = trim( buf_fin-bank.bik )
      410                       v-fmtcli-bank-name        = trim( buf_fin-bank.bank-name )
      411                       v-fmtcli-bank-addres      = trim(buf_fin-bank.addres)
      412                       v-fmtcli-bank-city      = trim(buf_fin-bank.bank-city)
      413                   .
      414               end.
      415               else do:
      416                   assign
      417                       v-fmtcli-bank-exists    = no
      418                       v-fmtcli-bank-bik       = "":U
      419                       v-fmtcli-bank-name      = "":U
      420                       v-fmtcli-bank-addres    = "":U
      421                       v-fmtcli-bank-city      = "":U
      422                   .
      423               end.
      424               leave search-for-schet.
      425           end.
      426       end.
      427   end.
      428   end procedure.
      429   procedure fmtcli-get-client :
      430   define input parameter p-obj-type       as character    no-undo.
      431   define input parameter p-obj-code       as integer      no-undo.
      432       define variable v-temp-fmtcli-address      as character     no-undo.
      433       define variable v-num-country-city    as integer      no-undo.
      434       define buffer buf_clients   for ub.clients.
      435       define buffer buf_firm      for ub.firm.
      436       define buffer buf_store     for ub.store.
      437       define buffer buf_shop      for ub.shop.
      438       define buffer buf_person    for ub.person.
      439   do
      440   for buf_clients
      441     , buf_firm
      442     , buf_store
      443     , buf_shop
      444     , buf_person
      445   on error undo, return error
      446   :
      447       assign
      448           v-fmtcli-name           = "":U
      449           v-fmtcli-addres         = "":U
      450           v-fmtcli-post-addres    = "":U
      451           v-fmtcli-full-addres    = "":U
      452           v-fmtcli-phone          = "":U
      453           v-fmtcli-inn            = "":U
      454           v-fmtcli-kpp            = "":U
      455           v-fmtcli-okpo           = "":U
      456           v-fmtcli-city           = "":U
      457           v-fmtcli-index          = "":U
      458           v-fmtcli-country        = "":U
      459       .
      460       find first buf_clients no-lock
      461            where buf_clients.obj-type = p-obj-type
      462              and buf_clients.obj-code = p-obj-code
      463       .
      464       assign
      465           v-fmtcli-name = buf_clients.obj-name
      466       .
      467       case buf_clients.obj-type:
      468          when 'орг':U
      469          then do:
      470               find first buf_firm no-lock
      471                    where buf_firm.firm-code = buf_clients.obj-code
      472                    no-error
      473               .
      474               if available buf_firm
      475               then do:
      476                   assign
      477                       v-num-country-city = num-entries( buf_firm.city )
      478                       v-fmtcli-engl-name = buf_firm.engl-name
      479                   .
      480                   if v-num-country-city > 0
      481                   then do:
      482                       assign
      483                           v-fmtcli-country    = trim( entry( 1, buf_firm.city ) )
      484                       .
      485                   end.
      486                   if v-num-country-city > 1
      487                   then do:
      488                       assign
      489                           v-fmtcli-city       = trim( entry( 2, buf_firm.city ) )
      490                       .
      491                   end.
      492                   run fmtcli-concatenate-strings in this-procedure (
      493                         input v-fmtcli-full-addres
      494                       , input v-fmtcli-country
      495                       , input ", ":U
      496                       , input 50
      497                       , output v-fmtcli-full-addres
      498                   ).
      499                   run fmtcli-concatenate-strings in this-procedure (
      500                         input v-fmtcli-full-addres
      501                       , input v-fmtcli-city
      502                       , input ", ":U
      503                       , input 50
      504                       , output v-fmtcli-full-addres
      505                   ).
      506                   run fmtcli-concatenate-strings in this-procedure (
      507                         input v-fmtcli-full-addres
      508                       , input IF buf_firm.ind = 0 THEN "" ELSE string( buf_firm.ind )
      509                       , input ", ":U
      510                       , input 50
      511                       , output v-fmtcli-full-addres
      512                   ).
      513                   run fmtcli-concatenate-strings in this-procedure (
      514                         input v-fmtcli-post-addres
      515                       , input v-fmtcli-country
      516                       , input ", ":U
      517                       , input 50
      518                       , output v-fmtcli-post-addres
      519                   ).
      520                   run fmtcli-concatenate-strings in this-procedure (
      521                         input v-fmtcli-post-addres
      522                       , input v-fmtcli-city
      523                       , input ", ":U
      524                       , input 50
      525                       , output v-fmtcli-post-addres
      526                   ).
      527                   run fmtcli-concatenate-strings in this-procedure (
      528                         input v-fmtcli-post-addres
      529                       , input string( buf_firm.ind )
      530                       , input ", ":U
      531                       , input 50
      532                       , output v-fmtcli-post-addres
      533                   ).
      534                   run fmtcli-concatenate-strings in this-procedure (
      535                         input substring( buf_firm.addres1, 1, 50 )
      536                       , input buf_firm.addres2
      537                       , input " ":U
      538                       , input 50
      539                       , output v-temp-fmtcli-address
      540                   ).
      541                   run fmtcli-concatenate-strings in this-procedure (
      542                         input v-temp-fmtcli-address
      543                       , input substring( buf_firm.addres1, 51, 50 )
      544                       , input " ":U
      545                       , input 50
      546                       , output v-temp-fmtcli-address
      547                   ).
      548                   run fmtcli-concatenate-strings in this-procedure (
      549                         input v-temp-fmtcli-address
      550                       , input substring( buf_firm.addres1, 101, 50 )
      551                       , input " ":U
      552                       , input 50
      553                       , output v-temp-fmtcli-address
      554                   ).
      555                   assign
      556                       v-fmtcli-addres = v-temp-fmtcli-address
      557                   .
      558                   if buf_firm.addres1 <> ?
      559                   then do:
      560                       run fmtcli-concatenate-strings in this-procedure (
      561                             input v-fmtcli-full-addres
      562                           , input v-fmtcli-addres
      563                           , input ", ":U
      564                           , input 0
      565                           , output v-fmtcli-full-addres
      566                       ).
      567                   end.
      568                   run fmtcli-concatenate-strings in this-procedure (
      569                         input substring( buf_firm.post-addr1, 1, 50 )
      570                       , input buf_firm.post-addr2
      571                       , input " ":U
      572                       , input 50
      573                       , output v-fmtcli-post-addres
      574                   ).
      575                   run fmtcli-concatenate-strings in this-procedure (
      576                         input v-fmtcli-post-addres
      577                       , input substring( buf_firm.post-addr1, 51, 50 )
      578                       , input " ":U
      579                       , input 50
      580                       , output v-fmtcli-post-addres
      581                   ).
      582                   run fmtcli-concatenate-strings in this-procedure (
      583                         input v-fmtcli-post-addres
      584                       , input substring( buf_firm.post-addr1, 101, 50 )
      585                       , input " ":U
      586                       , input 50
      587                       , output v-fmtcli-post-addres
      588                   ).
      589                   assign
      590                       v-fmtcli-phone         = buf_firm.phone
      591                       v-fmtcli-inn           = buf_firm.inn
      592                       v-fmtcli-kpp           = buf_firm.kpp
      593                       v-fmtcli-okpo          = buf_firm.okpo
      594                       v-fmtcli-index         = string( buf_firm.ind )
      595                   .
      596               end.
      597          end.
      598          when 'маг':U
      599          then do:
      600               find first buf_shop no-lock
      601                    where buf_shop.obj-code = buf_clients.obj-code
      602               .
      603               if available buf_shop
      604               then do:
      605                   run fmtcli-concatenate-strings in this-procedure (
      606                         input buf_shop.addres1
      607                       , input buf_shop.addres2
      608                       , input " ":U
      609                       , input 50
      610                       , output v-fmtcli-addres
      611                   ).
      612                   assign
      613                       v-fmtcli-full-addres = v-fmtcli-addres
      614                       v-fmtcli-post-addres = v-fmtcli-addres
      615                       v-fmtcli-phone       = buf_shop.phone
      616                       v-fmtcli-inn         = "":U
      617                       v-fmtcli-kpp         = "":U
      618                       v-fmtcli-okpo        = "":U
      619                       v-fmtcli-city        = "":U
      620                       v-fmtcli-index       = "":U
      621                   .
      622               end.
      623          end.
      624          when 'скл':U
      625          then do:
      626               find first buf_store no-lock
      627                    where buf_store.obj-code = buf_clients.obj-code
      628               .
      629               if available buf_store
      630               then do:
      631                   run fmtcli-concatenate-strings in this-procedure (
      632                         input buf_store.addres1
      633                       , input buf_store.addres2
      634                       , input " ":U
      635                       , input 50
      636                       , output v-fmtcli-addres
      637                   ).
      638                   assign
      639                       v-fmtcli-full-addres = v-fmtcli-addres
      640                       v-fmtcli-phone       = buf_store.phone
      641                       v-fmtcli-inn         = "":U
      642                       v-fmtcli-kpp         = "":U
      643                       v-fmtcli-okpo        = "":U
      644                       v-fmtcli-city        = "":U
      645                       v-fmtcli-index       = "":U
      646                   .
      647               end.
      648          end.
      649          when 'чел':U
      650          then do:
      651               find first buf_person no-lock
      652                    where buf_person.psn-code = buf_clients.obj-code
      653               .
      654               if available buf_person
      655               then do:
      656                   run fmtcli-concatenate-strings in this-procedure (
      657                         input ( if buf_person.ind = 0 or buf_person.ind = ?
      658                                 then "":U
      659                                 else string( buf_person.ind, "999999")
      660                                 )
      661                       , input buf_person.city
      662                       , input ", ":U
      663                       , input 0
      664                       , output v-fmtcli-full-addres
      665                   ).
      666                   assign
      667                       v-fmtcli-addres = buf_person.address
      668                   .
      669                   run fmtcli-concatenate-strings in this-procedure (
      670                         input v-fmtcli-full-addres
      671                       , input v-fmtcli-addres
      672                       , input ", ":U
      673                       , input 0
      674                       , output v-fmtcli-full-addres
      675                   ).
      676                   assign
      677                       v-fmtcli-phone     = buf_person.phone1
      678                       v-fmtcli-inn       = buf_person.inn
      679                       v-fmtcli-kpp       = buf_person.kpp
      680                       v-fmtcli-okpo      = buf_person.okpo
      681                       v-fmtcli-city      = buf_person.city
      682                       v-fmtcli-index     = string( buf_person.ind )
      683                   .
      684               end.
      685          end.
      686       end case.
      687   end.
      688   end procedure.
      689   procedure fmtcli-concatenate-strings :
      690   define input parameter p-string-1       as character        no-undo.
      691   define input parameter p-string-2       as character        no-undo.
      692   define input parameter p-delimiter      as character        no-undo.
      693   define input parameter p-length         as integer          no-undo.
      694   define output parameter p-out-string    as character        no-undo.
      695   do
      696   on error undo, return error
      697   :
      698       assign
      699           p-out-string = ( if p-string-1 = ?
      700                            then "":U
      701                            else trim( p-string-1 ) )
      702       .
      703       assign
      704           p-out-string = p-out-string
      705                        + ( if p-out-string = "":U
      706                            or length( p-out-string ) = p-length
      707                            or p-string-2 = ?
      708                            or trim( p-string-2 ) = "":U
      709                            then "":U
      710                            else p-delimiter )
      711                        + ( if p-string-2 = ?
      712                            or trim( p-string-2 ) = "":U
      713                            then "":U
      714                            else trim( p-string-2 ) )
      715       .
      716   end.
      717   end procedure.
