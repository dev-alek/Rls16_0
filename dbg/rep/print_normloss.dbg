     4399   procedure prn-lib-prn-file :
     4400     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     4401     define input parameter p-DIsabledoptions as integer no-undo .
     4402     define variable v-report-name as character no-undo .
     4403     define variable v-user-action as character no-undo .
     4404     define variable v-printed     as logical   no-undo .
     4405     define variable v-exist       as logical   no-undo .
     4406     do
     4407       on error undo, return error
     4408       :
     4409       run prn-lib-get-report-name  in this-procedure (
     4410         input parParentProc
     4411         ,output v-report-name
     4412         ).
     4413   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4414   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
     4415     (input  v-report-name
     4416     ,input  2
     4417     ,output v-exist
     4418     )  .
     4419       if NOT v-exist then
     4420       DO:
     4421         Message
     4422           "Нет заданий на печать ! "
     4423           view-as alert-box .
     4424         Return  .
     4425       End.
     4426       run gbl/prnfilen.w
     4427         (input  ""
     4428         ,input  p-DisabledOptions
     4429         ,input  string(v-report-name )
     4430         ,input  7
     4431         ,output v-user-action
     4432         ,output v-printed
     4433         ) .
     4434       if v-printed then
     4435       do:
     4436         return "YES" .
     4437       end.
     4438       else
     4439       do:
     4440         return "NO" .
     4441       end.
     4442     end.
     4443   end procedure.
     4444   procedure prn-lib-open-stream :
     4445     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     4446     define input parameter p-page-size    as integer no-undo .
     4447     define input parameter p-is-stream    as logical no-undo .
     4448     define input parameter p-append       as logical no-undo .
     4449     define variable v-report-name as character no-undo .
     4450     do
     4451       on error undo, return error
     4452       :
     4453       run prn-lib-get-report-name  in this-procedure (
     4454         input parParentProc
     4455         ,output v-report-name
     4456         ).
     4457       if p-is-stream then
     4458       do:
     4459         if p-append then
     4460         do:
     4461           output stream PrnLibStream to value( v-report-name )
     4462             page-size value(p-page-size) append .
     4463         end.
     4464         if not p-append then
     4465         do:
     4466           output stream PrnLibStream to value( v-report-name )
     4467             page-size value(p-page-size) .
     4468         end.
     4469       end.
     4470       if not p-is-stream then
     4471       do:
     4472         if p-append then
     4473         do:
     4474           output to value( v-report-name )
     4475             page-size value(p-page-size) append .
     4476         end.
     4477         if not p-append then
     4478         do:
     4479           output to value( v-report-name )
     4480             page-size value(p-page-size) .
     4481         end.
     4482       end.
     4483     end.
     4484   end procedure.
     4485   procedure prn-lib-open-exp :
     4486     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     4487     define input parameter p-is-stream    as logical no-undo .
     4488     define input parameter p-is-append    as logical no-undo .
     4489     define output parameter p-ReportFileName as char init "report" no-undo.
     4490     define output parameter p-process as logical no-undo .
     4491     define variable glog as logical no-undo .
     4492     do
     4493       on error undo, return error
     4494       :
     4495       SYSTEM-DIALOG GET-FILE p-ReportFileName
     4496         TITLE      "Укажите путь"
     4497         FILTERS "Текстовый файл (*.txt)"   "*.txt"
     4498         ASK-OVERWRITE
     4499         CREATE-TEST-FILE
     4500         SAVE-AS
     4501         USE-FILENAME
     4502         DEFAULT-EXTENSION "txt"
     4503         UPDATE glog
     4504         .
     4505       if not glog then  return.
     4506       p-ReportFileName = trim( string( p-ReportFileName ) ) .
     4507       if p-is-stream then
     4508       do:
     4509         if p-is-append then
     4510         do:
     4511           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     4512         end.
     4513         else
     4514         do:
     4515           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
     4516         end.
     4517       end.
     4518       else
     4519       do:
     4520         if p-is-append then
     4521         do:
     4522           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     4523         end.
     4524         else
     4525         do:
     4526           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
     4527         end.
     4528       end.
     4529       p-process = yes.
     4530     end.
     4531   end procedure.
     4532   procedure prn-lib-get-report-name :
     4533     define input parameter parParentProc  as widget-handle no-undo.
     4534     define output parameter p-report-name as character no-undo .
     4535     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
     4536   end procedure.
     4537   procedure prn-lib-reportviewer-report-name :
     4538     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     4539     define input parameter p-report-name-html as character no-undo .
     4540     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
     4541   end procedure.
     4542   procedure prn-lib-reportviewer :
     4543     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     4544     define input parameter p-report-name-html as character no-undo .
     4545     define input parameter p-param        as character no-undo .
     4546     define variable v-excel           as character no-undo init 'TRUE' .
     4547     define variable v-value-character as character no-undo .
     4548     define variable v-value-integer   as character no-undo .
     4549     define variable v-value-date      as date      no-undo .
     4550     define variable v-value-decimal   as decimal   no-undo .
     4551     define variable rep-excel         as logical   no-undo .
     4552     define variable excel-string      as character no-undo .
     4553     define variable v-param-type      as character no-undo .
     4554     define variable v-tth             as handle    no-undo .
     4555     run adm/shattri.p (
     4556       input "get":U
     4557       ,input  ""
     4558       ,input  0
     4559       ,input  'report-glob':U
     4560       ,input  'rep-excel':U
     4561       ,output v-value-character
     4562       ,output v-value-date
     4563       ,output v-value-decimal
     4564       ,output v-value-integer
     4565       ,output rep-excel
     4566       ,output v-param-type
     4567       ,INPUT-OUTPUT table-handle v-tth
     4568       )  .
     4569     if rep-excel then v-excel = "TRUE" .
     4570     else v-excel = "FALSE" .
     4571     if p-param eq ""
     4572     then
     4573        p-param = "EXCEL:" + v-excel.
     4574     else
     4575        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
     4576     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
     4577   end procedure.
     4578   function fnc-convert-dot-to-colon returns character
     4579       (input p-data as decimal, input p-accur as character, input p-num as integer) forward.
     4580   function fnc-convert-dot-to-colon returns character
     4581   (input p-data as decimal, input p-accur as character, input p-num as integer):
     4582       define variable result as character no-undo.
     4583       define variable v-str-result as character no-undo.
     4584       if p-data = ? then p-data = 0 .
     4585       p-data = round(p-data, p-num).
     4586       v-str-result = trim(replace(string(p-data, p-accur), ".", ",")).
     4587       return v-str-result.
     4588   END FUNCTION.
     4589   define stream Out-Stream.
     4590   define stream OutStr-html.
     4591   define VARIABLE p-report-id         as character no-undo .
     4592   define variable v-file-name-rep-htm as character no-undo .
     4593   define buffer buf_norm-loss for ub.norm-loss.
     4594   define temp-table tt-norm-loss no-undo
     4595     field clim-grp   as character
     4596     field position   as character
     4597     field oil-grp    as character
     4598     field season     as character
     4599     field value-loss as decimal
     4600     field type-id    as integer
     4601     field sec-vol1   as decimal
     4602     field sec-vol2   as decimal
     4603     field id         as integer
     4604     index pi id
     4605     asc sec-vol1
     4606     .
     4607   define temp-table tt-norm-1 no-undo
     4608     field sec-vol  as character
     4609     field sec-vol1 as decimal
     4610     field sec-vol2 as decimal
     4611     field season   as character
     4612     field type-id  as integer
     4613     field pol3     as decimal
     4614     field pol4     as decimal
     4615     field pol5     as decimal
     4616     field pol6     as decimal
     4617     field pol7     as decimal
     4618     field pol8     as decimal
     4619     field pol9     as decimal
     4620     field pol10    as decimal
     4621     field pol11    as decimal
     4622     field pol12    as decimal
     4623     field pol13    as decimal
     4624     field pol14    as decimal
     4625     field pol15    as decimal
     4626     field pol16    as decimal
     4627     field pol17    as decimal
     4628     field pol18    as decimal
     4629     field pol19    as decimal
     4630     field pol20    as decimal
     4631     field pol21    as decimal
     4632     field pol22    as decimal
     4633     field pol23    as decimal
     4634     index pi season sec-vol
     4635     .
     4636   define temp-table tt-norm-2 no-undo
     4637     field clim-grp  as character
     4638     field position1 as character
     4639     field position2 as character
     4640     field pol3      as decimal
     4641     field pol4      as decimal
     4642     field pol5      as decimal
     4643     field pol6      as decimal
     4644     field pol7      as decimal
     4645     field pol8      as decimal
     4646     field pol9      as decimal
     4647     field pol10     as decimal
     4648     field pol31     as decimal
     4649     field pol41     as decimal
     4650     field pol51     as decimal
     4651     field pol61     as decimal
     4652     field pol71     as decimal
     4653     field pol81     as decimal
     4654     field pol91     as decimal
     4655     field pol01     as decimal
     4656     field type-id   as integer
     4657     index pi clim-grp
     4658     .
     4659   define buffer buf_ttNL      for tt-norm-loss .
     4660   define buffer buf_tt-norm-1 for tt-norm-1 .
     4661   define buffer buf_tt-norm-2 for tt-norm-2 .
     4662   do
     4663     on error undo, return error return-value
     4664     :
     4665     for each buf_norm-loss no-lock :
     4666       create tt-norm-loss .
     4667       buffer-copy buf_norm-loss except buf_norm-loss.type buf_norm-loss.season buf_norm-loss.position to tt-norm-loss no-error .
     4668       tt-norm-loss.type-id = buf_norm-loss.type .
     4669       if buf_norm-loss.season = 0 then tt-norm-loss.season = "Весенне-Летний" .
     4670       else tt-norm-loss.season = "Осенне-Зимний" .
     4671       if buf_norm-loss.position = "0" then tt-norm-loss.position = "наземный" .
     4672       else tt-norm-loss.position = "подземный" .
     4673     end.
     4674     if p-type = 1 then
     4675     do:
     4676       for each buf_ttNL where buf_ttNL.type-id = p-type break by buf_ttNL.sec-vol1:
     4677         find first buf_tt-norm-1 where buf_tt-norm-1.sec-vol1 = buf_ttNL.sec-vol1 and buf_tt-norm-1.sec-vol2 = buf_ttNL.sec-vol2 and buf_tt-norm-1.season = buf_ttNL.season no-error .
     4678         if not available (buf_tt-norm-1) then
     4679         do:
     4680           create buf_tt-norm-1 .
     4681           assign
     4682             buf_tt-norm-1.season   = buf_ttNL.season
     4683             buf_tt-norm-1.sec-vol1 = buf_ttNL.sec-vol1
     4684             buf_tt-norm-1.sec-vol2 = buf_ttNL.sec-vol2
     4685             .
     4686           if buf_ttNL.sec-vol2 <> 0 and buf_ttNL.sec-vol1 <> 0 then
     4687           do:
     4688             buf_tt-norm-1.sec-vol = "Более " + string(buf_ttNL.sec-vol1) +
     4689               " до " + string(buf_ttNL.sec-vol2) + " вкл".
     4690           end.
     4691           else
     4692           do:
     4693             if buf_ttNL.sec-vol1 = 0 then
     4694             do:
     4695               buf_tt-norm-1.sec-vol = "До " + string (buf_ttNL.sec-vol2) + " вкл" .
     4696             end.
     4697             if buf_ttNL.sec-vol2 = 0 then
     4698             do:
     4699               buf_tt-norm-1.sec-vol = "Более " + string (buf_ttNL.sec-vol1) .
     4700             end.
     4701           end.
     4702         end.
     4703         case buf_ttNL.clim-grp:
     4704           when "1 (1)" then
     4705             do:
     4706               case buf_ttNL.oil-grp:
     4707                 when "I" or
     4708                 when "II" then
     4709                   do:
     4710                     buf_tt-norm-1.pol3 = buf_ttNL.value-loss .
     4711                   end.
     4712                 when "III" then
     4713                   do:
     4714                     buf_tt-norm-1.pol4 = buf_ttNL.value-loss .
     4715                   end.
     4716                 when "IV" then
     4717                   do:
     4718                     buf_tt-norm-1.pol5 = buf_ttNL.value-loss .
     4719                   end.
     4720               end.
     4721             end.
     4722           when "1 (2)" then
     4723             do:
     4724               case buf_ttNL.oil-grp:
     4725                 when "I" or
     4726                 when "II" then
     4727                   do:
     4728                     buf_tt-norm-1.pol6 = buf_ttNL.value-loss .
     4729                   end.
     4730                 when "III" then
     4731                   do:
     4732                     buf_tt-norm-1.pol7 = buf_ttNL.value-loss .
     4733                   end.
     4734                 when "IV" then
     4735                   do:
     4736                     buf_tt-norm-1.pol8 = buf_ttNL.value-loss .
     4737                   end.
     4738               end.
     4739             end.
     4740           when "2 (1)" then
     4741             do:
     4742               case buf_ttNL.oil-grp:
     4743                 when "I" or
     4744                 when "II" then
     4745                   do:
     4746                     buf_tt-norm-1.pol9 = buf_ttNL.value-loss .
     4747                   end.
     4748                 when "III" then
     4749                   do:
     4750                     buf_tt-norm-1.pol10 = buf_ttNL.value-loss .
     4751                   end.
     4752                 when "IV" then
     4753                   do:
     4754                     buf_tt-norm-1.pol11 = buf_ttNL.value-loss .
     4755                   end.
     4756               end.
     4757             end.
     4758           when "2 (2)" then
     4759             do:
     4760               case buf_ttNL.oil-grp:
     4761                 when "I" or
     4762                 when "II" then
     4763                   do:
     4764                     buf_tt-norm-1.pol12 = buf_ttNL.value-loss .
     4765                   end.
     4766                 when "III" then
     4767                   do:
     4768                     buf_tt-norm-1.pol13 = buf_ttNL.value-loss .
     4769                   end.
     4770                 when "IV" then
     4771                   do:
     4772                     buf_tt-norm-1.pol14 = buf_ttNL.value-loss .
     4773                   end.
     4774               end.
     4775             end.
     4776           when "2 (3)" then
     4777             do:
     4778               case buf_ttNL.oil-grp:
     4779                 when "I" or
     4780                 when "II" then
     4781                   do:
     4782                     buf_tt-norm-1.pol15 = buf_ttNL.value-loss .
     4783                   end.
     4784                 when "III" then
     4785                   do:
     4786                     buf_tt-norm-1.pol16 = buf_ttNL.value-loss .
     4787                   end.
     4788                 when "IV" then
     4789                   do:
     4790                     buf_tt-norm-1.pol17 = buf_ttNL.value-loss .
     4791                   end.
     4792               end.
     4793             end.
     4794           when "3 (1)" then
     4795             do:
     4796               case buf_ttNL.oil-grp:
     4797                 when "I" or
     4798                 when "II" then
     4799                   do:
     4800                     buf_tt-norm-1.pol18 = buf_ttNL.value-loss .
     4801                   end.
     4802                 when "III" then
     4803                   do:
     4804                     buf_tt-norm-1.pol19 = buf_ttNL.value-loss .
     4805                   end.
     4806                 when "IV" then
     4807                   do:
     4808                     buf_tt-norm-1.pol20 = buf_ttNL.value-loss .
     4809                   end.
     4810               end.
     4811             end.
     4812           when "3 (2)" then
     4813             do:
     4814               case buf_ttNL.oil-grp:
     4815                 when "I" or
     4816                 when "II" then
     4817                   do:
     4818                     buf_tt-norm-1.pol21 = buf_ttNL.value-loss .
     4819                   end.
     4820                 when "III" then
     4821                   do:
     4822                     buf_tt-norm-1.pol22 = buf_ttNL.value-loss .
     4823                   end.
     4824                 when "IV" then
     4825                   do:
     4826                     buf_tt-norm-1.pol23 = buf_ttNL.value-loss .
     4827                   end.
     4828               end.
     4829             end.
     4830         end.
     4831       end.
     4832     end.
     4833     else
     4834     do:
     4835       for each buf_ttNL where buf_ttNL.type-id = p-type:
     4836         find first buf_tt-norm-2 where buf_tt-norm-2.clim-grp = buf_ttNL.clim-grp no-error .
     4837         if not available (buf_tt-norm-2) then
     4838         do:
     4839           create buf_tt-norm-2 .
     4840           assign
     4841             buf_tt-norm-2.clim-grp = buf_ttNL.clim-grp
     4842             .
     4843         end.
     4844           if buf_ttNL.position = "наземный" then buf_tt-norm-2.position1 = buf_ttNL.position .
     4845           else buf_tt-norm-2.position2 = buf_ttNL.position .
     4846         case buf_ttNL.season:
     4847           when "Осенне-Зимний" then
     4848             do:
     4849               case buf_ttNL.oil-grp:
     4850                 when "I" then
     4851                   do:
     4852                     if buf_tt-norm-2.position1 = buf_ttNL.position then buf_tt-norm-2.pol9 = buf_tt-norm-2.pol9 + buf_ttNL.value-loss .
     4853                     else buf_tt-norm-2.pol91 = buf_tt-norm-2.pol91 + buf_ttNL.value-loss .
     4854                   end.
     4855                 when "II" then
     4856                   do:
     4857                     if buf_tt-norm-2.position1 = buf_ttNL.position then buf_tt-norm-2.pol3 = buf_tt-norm-2.pol3 + buf_ttNL.value-loss .
     4858                     else buf_tt-norm-2.pol31 = buf_tt-norm-2.pol31 + buf_ttNL.value-loss .
     4859                   end.
     4860                 when "III" then
     4861                   do:
     4862                     if buf_tt-norm-2.position1 = buf_ttNL.position then buf_tt-norm-2.pol5 = buf_tt-norm-2.pol5 + buf_ttNL.value-loss .
     4863                     else buf_tt-norm-2.pol51 = buf_tt-norm-2.pol51 + buf_ttNL.value-loss .
     4864                   end.
     4865                 when "IV" then
     4866                   do:
     4867                     if buf_tt-norm-2.position1 = buf_ttNL.position then buf_tt-norm-2.pol7 = buf_tt-norm-2.pol7 + buf_ttNL.value-loss .
     4868                     else buf_tt-norm-2.pol71 = buf_tt-norm-2.pol71 + buf_ttNL.value-loss .
     4869                   end.
     4870               end.
     4871             end.
     4872           when "Весенне-Летний" then
     4873             do:
     4874               case buf_ttNL.oil-grp:
     4875                 when "I" then
     4876                   do:
     4877                     if buf_tt-norm-2.position1 = buf_ttNL.position then buf_tt-norm-2.pol10 = buf_tt-norm-2.pol10 + buf_ttNL.value-loss .
     4878                     else buf_tt-norm-2.pol01 = buf_tt-norm-2.pol01 + buf_ttNL.value-loss .
     4879                   end.
     4880                 when "II" then
     4881                   do:
     4882                     if buf_tt-norm-2.position1 = buf_ttNL.position then buf_tt-norm-2.pol4 = buf_tt-norm-2.pol4 + buf_ttNL.value-loss .
     4883                     else buf_tt-norm-2.pol41 = buf_tt-norm-2.pol41 + buf_ttNL.value-loss .
     4884                   end.
     4885                 when "III" then
     4886                   do:
     4887                     if buf_tt-norm-2.position1 = buf_ttNL.position then buf_tt-norm-2.pol6 = buf_tt-norm-2.pol6 + buf_ttNL.value-loss .
     4888                     else buf_tt-norm-2.pol61 = buf_tt-norm-2.pol61 + buf_ttNL.value-loss .
     4889                   end.
     4890                 when "IV" then
     4891                   do:
     4892                     if buf_tt-norm-2.position1 = buf_ttNL.position then buf_tt-norm-2.pol8 = buf_tt-norm-2.pol8 + buf_ttNL.value-loss .
     4893                     else buf_tt-norm-2.pol81 = buf_tt-norm-2.pol81 + buf_ttNL.value-loss .
     4894                   end.
     4895               end.
     4896             end.
     4897         end.
     4898       end.
     4899     end.
     4900     run get-report-num (output p-report-id).
     4901     v-file-name-rep-htm = session:temp-directory + string(p-report-id) + ".html".
