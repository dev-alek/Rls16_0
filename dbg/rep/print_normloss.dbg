     3725   def var vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3726   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
     3727   procedure paramls-clear :
     3728     define buffer buf_temp-param for temp-param .
     3729     do
     3730     on error undo, return error return-value
     3731     :
     3732       for each buf_temp-param
     3733       on error undo, return error
     3734       :
     3735         delete buf_temp-param .
     3736       end.
     3737     end.
     3738   end procedure.
     3739   procedure paramls-write :
     3740     define input  parameter p-code     as character no-undo .
     3741     define input  parameter p-sub-code as character no-undo .
     3742     define input  parameter p-value    as character no-undo .
     3743     define buffer buf_temp-param for temp-param .
     3744     do
     3745     on error undo, return error return-value
     3746     :
     3747       find first buf_temp-param
     3748         where buf_temp-param.param-code     = p-code
     3749           and buf_temp-param.param-sub-code = p-sub-code
     3750         no-error .
     3751       if not available buf_temp-param then do:
     3752         create buf_temp-param .
     3753         assign
     3754           buf_temp-param.param-code     = p-code
     3755           buf_temp-param.param-sub-code = p-sub-code
     3756         .
     3757       end.
     3758       assign
     3759         buf_temp-param.param-value = p-value
     3760       .
     3761     end.
     3762   end procedure.
     3763   procedure paramls-read :
     3764     define input  parameter p-code          as character no-undo .
     3765     define input  parameter p-sub-code      as character no-undo .
     3766     define input  parameter p-default-value as character no-undo .
     3767     define output parameter p-value         as character no-undo .
     3768     define buffer buf_temp-param for temp-param .
     3769     do
     3770     on error undo, return error return-value
     3771     :
     3772       find first buf_temp-param
     3773         where buf_temp-param.param-code     = p-code
     3774           and buf_temp-param.param-sub-code = p-sub-code
     3775         no-error .
     3776       if available buf_temp-param then do:
     3777         assign
     3778           p-value = buf_temp-param.param-value
     3779         .
     3780       end.
     3781       else do:
     3782         assign
     3783           p-value = p-default-value
     3784         .
     3785       end.
     3786     end.
     3787   end procedure.
     3788   procedure paramls-append :
     3789     define input  parameter p-code     as character no-undo .
     3790     define input  parameter p-sub-code as character no-undo .
     3791     define input  parameter p-value    as character no-undo .
     3792     define buffer buf_temp-param for temp-param .
     3793     do
     3794     on error undo, return error return-value
     3795     :
     3796       find first buf_temp-param
     3797            where buf_temp-param.param-code     = p-code
     3798              and buf_temp-param.param-sub-code = p-sub-code
     3799         no-error .
     3800       if not available buf_temp-param then do:
     3801         create buf_temp-param .
     3802         assign
     3803           buf_temp-param.param-code     = p-code
     3804           buf_temp-param.param-sub-code = p-sub-code
     3805           buf_temp-param.param-value    = p-value
     3806         .
     3807       end.
     3808       else do:
     3809           assign
     3810               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
     3811           .
     3812       end.
     3813     end.
     3814   end procedure.
