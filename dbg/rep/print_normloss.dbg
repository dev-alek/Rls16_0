      891   define variable v-torgconf-saler-addr           as character    no-undo.
      892   define variable v-torgconf-consignee-addr       as character    no-undo.
      893   define variable v-torgconf-supplier-inn         as character    no-undo.
      894   define variable v-torgconf-saler-inn            as character    no-undo.
      895   define variable v-torgconf-consignee-inn        as character    no-undo.
      896   define variable v-torgconf-supplier-kpp         as character    no-undo.
      897   define variable v-torgconf-saler-kpp            as character    no-undo.
      898   define variable v-torgconf-consignee-kpp        as character    no-undo.
