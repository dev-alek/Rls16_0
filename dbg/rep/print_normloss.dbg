     1040           v-torgconf-outprim  = no
     1041           v-torgconf-outdisc  = no
     1042           v-torgconf-outsubs  = no
     1043           v-torgconf-outrecv  = no
     1044           v-torgconf-outegrp  = no
     1045           v-torgconf-outt12   = no
     1046           v-torgconf-outappr  = no
     1047           v-torgconf-outrubl  = no
     1048           v-torgconf-outhold  = no
     1049           v-torgconf-outobj   = no
     1050           v-torgconf-outexlst = no
     1051           v-torgconf-outexpas = "":U
     1052           v-torgconf-outprncd = yes
     1053           v-torgconf-outares  = no
     1054           v-torgconf-outsend  = no
     1055           v-torgconf-outasend  = no
