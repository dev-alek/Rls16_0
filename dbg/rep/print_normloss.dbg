     3462                     v-torgconf-ogr-name = buf_shop.director
     3463                     v-torgconf-ogr-post = "Директор"
     3464                  .
     3465               end.
     3466         if v-torgconf-outogr = "manag_doc"
     3467            then do:
     3468               find first buf_wth-doc no-lock
     3469               where buf_wth-doc.doc-code = p-doc-code
     3470               no-error.
     3471               if available buf_wth-doc
     3472               then do:
     3473                  run rep/get-psn.p
     3474                  (input buf_wth-doc.deliver
     3475                  ,output v-torgconf-ogr-name
     3476                  ) .
     3477               end.
     3478               find first buf_person no-lock
     3479               where buf_person.psn-code = buf_wth-doc.deliver
     3480               no-error.
     3481               if available buf_person
     3482               then do:
     3483                  v-torgconf-ogr-post = buf_person.position.
     3484               end.
     3485               if v-torgconf-ogr-name = "?":U then v-torgconf-ogr-name = "".
     3486               if v-torgconf-ogr-post = ? then  v-torgconf-ogr-post = "".
     3487            end.
     3488      end.
     3489   end.
     3490   end procedure.
     3491   procedure torgconf-get-outogr-param:
     3492       define input parameter p-form-name  as character    no-undo.
     3493       define input parameter p-host-code  as integer      no-undo.
     3494       define input parameter p-obj-type   as character    no-undo.
     3495       define input parameter p-obj-code   as integer      no-undo.
     3496       define input parameter p-doc-code   as character      no-undo.
     3497       define buffer buf_firm          for ub.firm .
     3498       define buffer buf_clients       for ub.clients .
     3499       define buffer buf_sysconf       for ub.sysconf .
     3500       define buffer buf_shop          for ub.shop .
     3501       define buffer buf_store         for ub.store .
     3502       define buffer buf_person        for ub.person .
     3503       define buffer buf_trn-doc       for ub.trn-doc .
     3504       define buffer buf_wth-doc       for ub.wth-doc .
     3505      if  p-form-name <> 'wthtrg12':U
     3506      and p-form-name <> 'wthfct':U
     3507      and p-form-name <> 'wthm11':U
     3508      then do:
     3509       find first buf_trn-doc no-lock
     3510       where buf_trn-doc.doc-code = p-doc-code
     3511       no-error.
     3512       if v-torgconf-outogr = "no_print"
     3513         then do:
     3514            assign
     3515               v-torgconf-ogr-name = ""
     3516               v-torgconf-ogr-post = ""
     3517            .
     3518         end.
     3519      if v-torgconf-outogr  = "ruk_firm"
     3520            then do:
     3521            find first buf_sysconf no-lock
     3522            where buf_sysconf.host-code = p-host-code
     3523            no-error.
     3524            if available buf_sysconf
     3525            then do:
     3526               assign
     3527                  v-torgconf-ogr-post = buf_sysconf.head-position
     3528               .
     3529            end.
     3530            find first buf_clients no-lock
     3531                where buf_clients.obj-type = 'орг':U
     3532                and buf_clients.obj-code = p-host-code
     3533            .
     3534            find first buf_firm no-lock
     3535                where buf_firm.firm-code = buf_clients.obj-code
     3536            .
     3537            assign
     3538                v-torgconf-ogr-name = buf_firm.director
     3539            .
     3540         end.
     3541         if v-torgconf-outogr = "dir_obj"
     3542            then do:
     3543            find first buf_trn-doc no-lock
     3544            where buf_trn-doc.doc-code = p-doc-code
     3545            no-error.
     3546               CASE buf_trn-doc.obj-type:
     3547               WHEN 'маг':U
     3548               THEN DO:
     3549                  find first buf_shop no-lock
     3550                  where buf_shop.obj-code = buf_trn-doc.obj-code
     3551                  .
     3552                  assign
     3553                     v-torgconf-ogr-name = buf_shop.director
     3554                     v-torgconf-ogr-post = "Директор"
     3555                  .
     3556               END.
     3557               WHEN 'скл':U
     3558               THEN DO:
     3559                  find first buf_store no-lock
     3560                  where buf_store.obj-code = buf_trn-doc.obj-code
     3561                  .
     3562                  assign
     3563                     v-torgconf-ogr-name = buf_store.store-boss
     3564                     v-torgconf-ogr-post = "Директор"
     3565                  .
     3566               END.
     3567               OTHERWISE DO:
     3568                  assign
     3569                     v-torgconf-ogr-name = "":U
     3570                     v-torgconf-ogr-post = "":U
     3571                  .
     3572               END.
     3573               END CASE.
     3574            end.
     3575      if v-torgconf-outogr = "manag_doc"
     3576         then do:
     3577            find first buf_trn-doc no-lock
     3578            where buf_trn-doc.doc-code = p-doc-code
     3579            no-error.
     3580            if available buf_trn-doc
     3581            then do:
     3582               run rep/get-psn.p
     3583               (input buf_trn-doc.boss
     3584               ,output v-torgconf-ogr-name
     3585               ) .
     3586            end.
     3587            find first buf_person no-lock
     3588            where buf_person.psn-code = buf_trn-doc.boss
     3589            no-error.
     3590            if available buf_person
     3591            then do:
     3592               v-torgconf-ogr-post = buf_person.position.
     3593            end.
     3594            if v-torgconf-ogr-name = "?":U then v-torgconf-ogr-name = "".
     3595            if v-torgconf-ogr-post = ? then  v-torgconf-ogr-post = "".
     3596         end.
     3597      end.
     3598      else do:
     3599      find first buf_wth-doc no-lock
     3600         where buf_wth-doc.doc-code = p-doc-code
     3601         no-error.
     3602         if v-torgconf-outogr = "no_print"
     3603            then do:
     3604               assign
     3605                  v-torgconf-ogr-name = ""
     3606                  v-torgconf-ogr-post = ""
     3607               .
     3608            end.
     3609         if v-torgconf-outogr  = "ruk_firm"
     3610               then do:
     3611               find first buf_sysconf no-lock
     3612               where buf_sysconf.host-code = p-host-code
     3613               no-error.
     3614               if available buf_sysconf
     3615               then do:
     3616                  assign
     3617                     v-torgconf-ogr-post = buf_sysconf.head-position
     3618                  .
     3619               end.
     3620               find first buf_clients no-lock
     3621                  where buf_clients.obj-type = 'орг':U
     3622                  and buf_clients.obj-code = p-host-code
     3623               .
     3624               find first buf_firm no-lock
     3625                  where buf_firm.firm-code = buf_clients.obj-code
     3626               .
     3627               assign
     3628                  v-torgconf-ogr-name = buf_firm.director
     3629               .
     3630            end.
     3631            if v-torgconf-outogr = "dir_obj"
     3632               then do:
     3633               find first buf_wth-doc no-lock
     3634               where buf_wth-doc.doc-code = p-doc-code
     3635               no-error.
     3636                  find first buf_shop no-lock
     3637                  where buf_shop.obj-code = buf_wth-doc.obj-code
     3638                  .
     3639                  assign
     3640                     v-torgconf-ogr-name = buf_shop.director
     3641                     v-torgconf-ogr-post = "Директор"
     3642                  .
     3643               end.
     3644         if v-torgconf-outogr = "manag_doc"
     3645            then do:
     3646               find first buf_wth-doc no-lock
     3647               where buf_wth-doc.doc-code = p-doc-code
     3648               no-error.
     3649               if available buf_wth-doc
     3650               then do:
     3651                  run rep/get-psn.p
     3652                  (input buf_wth-doc.deliver
     3653                  ,output v-torgconf-ogr-name
     3654                  ) .
     3655               end.
     3656               find first buf_person no-lock
     3657               where buf_person.psn-code = buf_wth-doc.deliver
     3658               no-error.
     3659               if available buf_person
     3660               then do:
     3661                  v-torgconf-ogr-post = buf_person.position.
     3662               end.
     3663               if v-torgconf-ogr-name = "?":U then v-torgconf-ogr-name = "".
     3664               if v-torgconf-ogr-post = ? then  v-torgconf-ogr-post = "".
     3665            end.
     3666      end.
     3667   end.
     3668   procedure torgconf-get-reason  :
     3669   define input parameter  p-doc-code       as character        no-undo.
     3670   define input parameter  p-reason-code    as integer          no-undo .
     3671   define input parameter  p-doc-type       as character        no-undo.
     3672       if p-reason-code > 0
     3673       then do:
     3674           define buffer buf_trn-reason for ub.trn-reason.
     3675           find first buf_trn-reason no-lock where buf_trn-reason.reason-code = p-reason-code no-error .
     3676           if available buf_trn-reason then assign v-torgconf-reason =  buf_trn-reason.reason-name .
     3677       end.
     3678       else do:
     3679           if p-doc-type = 'при':U
     3680           then  do:
     3681               define variable v-attr-type     as character    no-undo.
     3682               define variable v-attr-value    as character    no-undo.
     3683               run gbl/trdcat-v.p (input p-doc-code,input 'nids':U,output v-attr-value,output v-attr-type) .
     3684               assign v-torgconf-reason = v-attr-value .
     3685               run gbl/trdcat-v.p (input p-doc-code,input 'dids':U,output v-attr-value,output v-attr-type) .
     3686               assign v-torgconf-reason = v-torgconf-reason + " от " + v-attr-value .
     3687           end.
     3688       end.
     3689   end procedure.
