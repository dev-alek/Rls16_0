      927   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      928   procedure wthcattr-sprcli :
      929   define input parameter parparentproc  as widget-handle no-undo.
      930   define input parameter p-mode  as character no-undo.
      931   define input-output parameter p-value as character no-undo .
      932   define output parameter p-setted as logical no-undo .
      933     DEFINE VARIABLE v-value as character no-undo .
      934     define variable v-cli-type as character no-undo .
      935     define variable v-cli-code as integer no-undo .
      936     define buffer buf_clients   for ub.clients.
      937     define variable v_rid as character no-undo.
      938     define variable ref-rec as recid no-undo .
      939     do
      940     on error undo, return error
      941     :
      942         v-value = p-value.
      943      if p-value <> '':U then do:
      944       assign
      945       v-cli-type = substring(p-value, 1, 3)
      946       v-cli-code = integer(substring(p-value, 4))
      947       no-error.
      948       if error-status:error then do:
      949         assign
      950         v-cli-type = '':U
      951         v-cli-code = 0
      952         .
      953       end.
      954      end.
      955      FIND FIRST buf_clients NO-LOCK WHERE
      956               buf_clients.obj-type = v-cli-type AND
      957               buf_clients.obj-code = v-cli-code  NO-ERROR.
      958      IF available(buf_clients) then do:
      959       run ref/cli-all.w (
      960                   input parparentproc
      961                  ,input if p-mode = 'ИЗМЕНЕНИЕ':U then "b-sel":U else "":U
      962                  ,input v-cli-type
      963                  ,input 'все':U
      964                  ,input 'все':U
      965                  ,input RECID( buf_clients )
      966                  ,input ",,,,,,NO"
      967                  ,input ?
      968                  ,OUTPUT v_rid ).
      969     END.
      970     ELSE if p-mode = 'ИЗМЕНЕНИЕ':U then DO:
      971       run ref/cli-all.w (
      972                    input parparentproc
      973                   ,INPUT "b-sel":U
      974                  ,input  v-cli-type
      975                  ,input 'все':U
      976                  ,input 'текущие':U
      977                  ,input ?
      978                  ,input ",,,,,,NO"
      979                  ,input ?
      980                  ,OUTPUT v_rid ).
      981     END.
      982     else do:
      983       message
      984       if p-value = "":U then 'Атрибут не задан!'
      985       else substitute('Не найден клиент &1',p-value)
      986       view-as alert-box warning.
      987     end.
      988     IF v_rid <> ? AND v_rid <> "":U THEN DO:
      989       ASSIGN ref-rec = INT( v_rid ) NO-ERROR.
      990       IF ERROR-STATUS:ERROR THEN DO:
      991           RETURN NO-APPLY.
      992       END.
      993       FIND FIRST buf_clients NO-LOCK WHERE
      994                  RECID( buf_clients ) = ref-rec NO-ERROR.
      995       IF AVAIL buf_clients THEN DO:
      996         v-value = buf_clients.obj-type + string(buf_clients.obj-code, ">>>>>>>>9").
      997       end.
      998     end.
      999     if v-value <> p-value then do:
     1000       p-value = v-value.
     1001       p-setted = yes.
     1002     end.
     1003     end.
     1004   end procedure.
     1005     define new global shared variable g#wthcalib as handle no-undo.
     1006   procedure torgconf-read :
