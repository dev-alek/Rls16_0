     1057           v-form-name          = p-form-name
     1058       .
     1059   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1060   empty temp-table thbjattr_thbj-attr.
     1061   run adm/shattri.p (
     1062      input "get":U
     1063     ,input ''
     1064     ,input 0
     1065     ,input 'prt-glob':U
     1066     ,input  ""
     1067     ,output v-value-character
     1068     ,output v-value-date
