     4995   PROCEDURE get-report-num :
     4996     define output parameter p-report-num as integer no-undo .
     4997     do
     4998       on error undo, return error return-value
     4999       :
     5000       run gbl/getrpnum.p (output p-report-num).
     5001     end.
     5002   END PROCEDURE.
