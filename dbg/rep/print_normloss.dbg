     1237               .
     1238           end.
     1239        assign
     1240         v-name = p-form-name.
     1241   end.
     1242   end.
     1243   end procedure.
     1244   procedure torgconf-get-self-param :
     1245   define input parameter p-obj-type           as character        no-undo.
     1246   define input parameter p-obj-code           as integer          no-undo.
     1247   define input parameter p-curr-code          as integer          no-undo.
     1248       define variable v-host-code    as integer      no-undo.
     1249       define variable v-par-type     as character    no-undo.
     1250   do
     1251   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message(1))
     1252   :
     1253   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1254   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1255     (input  p-obj-type
     1256     ,input  p-obj-code
     1257     ,output v-host-code
     1258     )  .
     1259       if v-torgconf-outhold = yes
     1260       then do:
     1261           run torgconf-get-holdfirm-code in this-procedure (
     1262                 input p-obj-type
     1263               , input p-obj-code
     1264               , output v-torgconf-self-host-code
     1265           ).
     1266           if v-torgconf-self-host-code = 0
     1267           then do:
     1268               return error.
     1269           end.
     1270       end.
     1271       else do:
     1272           assign
     1273               v-torgconf-self-host-code = v-host-code
     1274           .
     1275       end.
     1276       if v-torgconf-self-host-code = 0
     1277       then do:
     1278           assign
     1279               v-torgconf-self-host-name           = "":U
     1280               v-torgconf-self-host-addres         = "":U
     1281               v-torgconf-self-host-post-addres    = "":U
     1282               v-torgconf-self-host-phone          = "":U
     1283               v-torgconf-self-host-inn            = "":U
     1284               v-torgconf-self-host-kpp            = "":U
     1285               v-torgconf-self-host-okpo           = "":U
     1286               v-torgconf-self-host-egrip-date     = "":U
     1287               v-torgconf-self-host-egrip-num      = "":U
     1288           .
     1289       end.
     1290       else do:
     1291           run fmtcli-get-client in this-procedure (
     1292                 input 'орг':U
     1293               , input v-torgconf-self-host-code
     1294           ).
     1295           assign
     1296               v-torgconf-self-host-name        = v-fmtcli-name
     1297               v-torgconf-self-host-engl-name   = v-fmtcli-engl-name
     1298               v-torgconf-self-host-addres      = v-fmtcli-full-addres
     1299               v-torgconf-self-host-post-addres = v-fmtcli-post-addres
     1300               v-torgconf-self-host-phone       = v-fmtcli-phone
     1301               v-torgconf-self-host-inn         = v-fmtcli-inn
     1302               v-torgconf-self-host-kpp         = v-fmtcli-kpp
     1303               v-torgconf-self-host-okpo        = v-fmtcli-okpo
     1304           .
     1305           run gbl/clntat-v.p (
     1306                 input 'орг':U
     1307               , input v-torgconf-self-host-code
     1308               , input 'egrip-date':U
     1309               , output v-torgconf-self-host-egrip-date
     1310               , output v-par-type
     1311           ).
     1312           run gbl/clntat-v.p (
     1313                 input 'орг':U
     1314               , input v-torgconf-self-host-code
     1315               , input 'egrip-num':U
     1316               , output v-torgconf-self-host-egrip-num
     1317               , output v-par-type
     1318           ).
     1319           run fmtcli-get-bank in this-procedure (
     1320                 input v-host-code
     1321               , input 'орг':U
     1322               , input v-torgconf-self-host-code
     1323               , input p-curr-code
     1324           ).
     1325       end.
     1326       assign
     1327           v-torgconf-self-schet-exists = v-fmtcli-schet-exists
     1328           v-torgconf-self-bank-exists  = v-fmtcli-bank-exists
     1329           v-torgconf-self-bank-r-schet = v-fmtcli-bank-r-schet
