      349   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      350   procedure cur-time :
      351      define output parameter p-today as date      no-undo .
      352      define output parameter p-time  as integer   no-undo .
      353     do
      354     on error undo, return error
      355     :
      356       define variable v-date1 as date      no-undo .
      357       define variable v-date2 as date      no-undo .
      358       define variable v-time  as integer   no-undo .
      359       assign
      360         v-date1 = today
      361         v-time  = time
      362         v-date2 = today
      363       .
      364       if v-date1 <> v-date2
      365       then do:
      366         assign
      367           v-date1 = today
      368           v-time  = v-time
      369         .
      370       end.
      371       assign
      372         p-today = v-date1
      373         p-time  = v-time
      374       .
      375     end.
      376   end.
      377   function cur-time-date returns character
      378   :
      379     return string(today, '99/99/9999':U) .
      380   end.
      381   function cur-time-mjd returns decimal
      382   :
      383     define variable v-date as date      no-undo .
      384     define variable v-time as integer   no-undo .
      385     run cur-time in this-procedure
      386       (output v-date
      387       ,output v-time
      388       ) .
      389     return integer(v-date) - 2400002 + (v-time / 86400) .
      390   end.
      391   function cur-time-get-ending-index returns integer
      392   (input p-number as integer
      393   )
      394   :
      395     if p-number < 0
      396     or p-number = ?
      397     then do:
      398       return 1 .
      399     end.
      400     define variable v-rest as integer   no-undo .
      401     assign
      402       p-number = p-number modulo 100
      403     .
      404     if p-number < 20
      405     then do:
      406       assign
      407         v-rest = p-number
      408       .
      409     end.
      410     else do:
      411       assign
      412         v-rest = p-number modulo 10
      413       .
      414     end.
      415     case v-rest :
      416       when 1
      417       then do:
      418         return 2 .
      419       end.
      420       when 2 or
      421       when 3 or
      422       when 4
      423       then do:
      424         return 3 .
      425       end.
      426       otherwise do:
      427         return 1 .
      428       end.
      429     end case .
      430   end.
      431   procedure cur-time-mjd-to-date :
      432      define input  parameter i-mjd-diff as decimal no-undo.
      433      define output parameter o-Date     as date    no-undo.
      434      define output parameter o-Time     as integer no-undo.
      435      define variable v-day-number as integer   no-undo .
      436      if    i-mjd-diff < 0
      437         or i-mjd-diff = ?
      438      then do:
      439         return "?" .
      440      end.
      441      assign
      442         v-day-number = truncate(i-mjd-diff,0).
      443         o-Date = date(v-day-number + 2400002).
      444         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      445     .
      446   end.
      447   function cur-time-mjd-to-string returns character
      448   (input p-mjd-diff as decimal
      449   )
      450   :
      451     define variable v-day-number as integer   no-undo .
      452     define variable v-seconds    as integer   no-undo .
      453     define variable v-hour       as integer   no-undo .
      454     define variable v-min        as integer   no-undo .
      455     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      456     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      457     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      458     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      459     if p-mjd-diff < 0
      460     or p-mjd-diff = ?
      461     then do:
      462       return "?" .
      463     end.
      464     assign
      465       v-day-number = integer(truncate(p-mjd-diff,0))
      466       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      467     .
      468     if v-seconds > 86400
      469     then do:
      470       assign
      471         v-seconds = 86400 - 1
      472       .
      473     end.
      474     if v-seconds < 0
      475     then do:
      476       assign
      477         v-seconds = 0
      478       .
      479     end.
      480     assign
      481       v-hour = truncate(v-seconds / 3600, 0)
      482     .
      483     assign
      484       v-seconds = v-seconds modulo 3600
      485     .
      486     assign
      487       v-min = truncate(v-seconds / 60, 0)
      488     .
      489     assign
      490       v-seconds = v-seconds modulo 60
      491     .
      492     return
      493         (if v-day-number <> 0
      494           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      495           else ""
      496         )
      497       + (if v-day-number <> 0 or v-hour <> 0
      498           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      499           else ""
      500         )
      501       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      502           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      503           else ""
      504         )
      505       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      506       .
      507   end.
      508   function cur-time-string returns character
      509   :
      510     define variable v-date as date      no-undo .
      511     define variable v-time as integer   no-undo .
      512     run cur-time in this-procedure
      513       (output v-date
      514       ,output v-time
      515       ) .
      516     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      517   end.
      518   function cur-time-string-sec returns character
      519   :
      520     define variable v-date as date      no-undo .
      521     define variable v-time as integer   no-undo .
      522     run cur-time in this-procedure
      523       (output v-date
      524       ,output v-time
      525       ) .
      526     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      527   end.
      528   function cur-time-custom  returns character
      529   (input p-prefix as character
      530   ,input p-date-format as character
      531   ,input p-delimiter as character
      532   ,input p-time-format as character
      533   ,input p-suffix as character
      534   )
      535   :
      536     define variable v-date as date      no-undo .
      537     define variable v-time as integer   no-undo .
      538     run cur-time in this-procedure
      539       (output v-date
      540       ,output v-time
      541       ) .
      542     return
      543       p-prefix
      544       + string(v-date, p-date-format)
      545       + p-delimiter
      546       + string(v-time, p-time-format)
      547       + p-suffix
      548       .
      549   end.
      550   function cur-time-print  returns character
      551   :
      552     define variable v-date as date      no-undo .
      553     define variable v-time as integer   no-undo .
      554     run cur-time in this-procedure
      555       (output v-date
      556       ,output v-time
      557       ) .
      558     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      559   end.
      560   function cur-time-datetime returns datetime
      561   :
      562     define variable v-char as character no-undo .
      563     define variable v-datetime as datetime no-undo .
      564     v-char = cur-time-string().
      565     v-datetime = datetime(v-char).
      566     return  v-datetime.
      567   end.
      568   function cur-time-string-msec returns character
      569   :
      570     define variable v-date as datetime  no-undo .
      571     v-date = now.
      572     return string(v-date) .
      573   end.
      574   define variable ini-par as character no-undo.
      575   define variable s       as character no-undo.
      576   define variable v-today as date      no-undo.
      577   define variable v-rb-is-base as logical no-undo .
      578   define variable v-base-code like ub.sysconf.base-code no-undo .
      579   define variable v-host-code like ub.sysconf.host-code no-undo .
      580   define variable base-type as character no-undo .
      581   define buffer buf_rep_currency for ub.currency.
      582   DEFINE BUTTON b-help DEFAULT
      583        LABEL "Помо&щь"
      584        SIZE 10 BY 1
      585        BGCOLOR 8 .
      586   DEFINE BUTTON b-sel AUTO-GO DEFAULT
      587        LABEL "Вы&бор"
      588        SIZE 10 BY 1
      589        BGCOLOR 8 .
      590   DEFINE BUTTON b-unit DEFAULT
      591        IMAGE-UP FILE "btn-down-arrow":U
      592        IMAGE-DOWN FILE "btn-down-arrow":U
      593        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      594        LABEL "":L
      595        SIZE 2.5 BY 1.
      596   DEFINE VARIABLE CurrTicket AS CHARACTER FORMAT "X(256)":U INITIAL "Не печатать"
      597        VIEW-AS COMBO-BOX INNER-LINES 5
      598        LIST-ITEMS "Не печатать"
      599        DROP-DOWN-LIST
      600        SIZE 27 BY 1 NO-UNDO.
      601   DEFINE VARIABLE f-tick-ps AS CHARACTER FORMAT "X(8)":U
      602        LABEL "PS"
      603        VIEW-AS FILL-IN
      604        SIZE 9 BY 1 NO-UNDO.
      605   DEFINE VARIABLE rate AS DECIMAL FORMAT "->>,>>9.99<<":U INITIAL 0
      606        LABEL "Курс"
      607        VIEW-AS FILL-IN
      608        SIZE 13 BY 1 NO-UNDO.
      609   DEFINE VARIABLE unit-type AS CHARACTER FORMAT "X(3)":U INITIAL "шт"
      610        VIEW-AS FILL-IN
      611        SIZE 4 BY 1 NO-UNDO.
      612   DEFINE VARIABLE bcode-type AS CHARACTER
      613        VIEW-AS RADIO-SET VERTICAL
      614        RADIO-BUTTONS
      615             "Основной бар-код", "main",
      616   "Бар-код партии", "part",
      617   "Неосн. бар-код", "subs"
      618        SIZE 19.5 BY 3 NO-UNDO.
      619   DEFINE VARIABLE List-Sort-Type AS CHARACTER
      620        VIEW-AS RADIO-SET VERTICAL
      621        RADIO-BUTTONS
      622             "По коду", "1",
      623   "По артикулу", "2",
      624   "В порядке ввода", "3"
      625        SIZE 26 BY 2.67 NO-UNDO.
      626   DEFINE VARIABLE price-type AS CHARACTER
      627        VIEW-AS RADIO-SET VERTICAL
      628        RADIO-BUTTONS
      629             "текущий прайс-лист", "price",
      630   "цена документа", "doc",
      631   "прайс-лист на дату документа", "doc-pr"
      632        SIZE 31.38 BY 2.63 NO-UNDO.
      633   DEFINE VARIABLE qnty-type AS CHARACTER
      634        VIEW-AS RADIO-SET VERTICAL
      635        RADIO-BUTTONS
      636             "по одному на товар", "один",
      637   "по остаткам на объекте", "остаток",
      638   "по кол-ву из списка", "список",
      639   "по документу", "документ"
      640        SIZE 31 BY 4.17 NO-UNDO.
      641   DEFINE RECTANGLE RECT-1
      642        EDGE-PIXELS 3 GRAPHIC-EDGE  NO-FILL
      643        SIZE 33.25 BY 5.42.
      644   DEFINE RECTANGLE RECT-2
      645        EDGE-PIXELS 3 GRAPHIC-EDGE  NO-FILL
      646        SIZE 33.25 BY 5.5.
      647   DEFINE RECTANGLE RECT-3
      648        EDGE-PIXELS 3 GRAPHIC-EDGE  NO-FILL
      649        SIZE 29 BY 4.75.
      650   DEFINE RECTANGLE RECT-4
      651        EDGE-PIXELS 3 GRAPHIC-EDGE  NO-FILL
      652        SIZE 29 BY 2.5.
      653   DEFINE RECTANGLE RECT-5
      654        EDGE-PIXELS 3 GRAPHIC-EDGE  NO-FILL
      655        SIZE 29 BY 3.67.
      656   DEFINE RECTANGLE RECT-Sort
      657        EDGE-PIXELS 3 GRAPHIC-EDGE  NO-FILL
      658        SIZE 29 BY 4.13.
      659   DEFINE VARIABLE OnlyChgPrice AS LOGICAL INITIAL no
      660        LABEL "только с измен. ценой"
      661        VIEW-AS TOGGLE-BOX
      662        SIZE 26 BY .83 NO-UNDO.
      663   DEFINE VARIABLE TickOnNulSale AS LOGICAL INITIAL no
      664        LABEL "в т.ч. с нулевыми ценами"
      665        VIEW-AS TOGGLE-BOX
      666        SIZE 27 BY .83 NO-UNDO.
      667   DEFINE VARIABLE TickOnSign AS LOGICAL INITIAL no
      668        LABEL "детально (по признакам)"
      669        VIEW-AS TOGGLE-BOX
      670        SIZE 26 BY .83 NO-UNDO.
      671   DEFINE VARIABLE TickOnWieght AS LOGICAL INITIAL no
      672        LABEL "в т.ч. на весовой товар"
      673        VIEW-AS TOGGLE-BOX
      674        SIZE 26 BY .83 NO-UNDO.
      675   DEFINE FRAME Tickets
      676        b-sel AT ROW 1 COL 2
      677        b-help AT ROW 1 COL 54
      678        qnty-type AT ROW 3.33 COL 32 NO-LABEL
      679        CurrTicket AT ROW 3.5 COL 3 NO-LABEL
      680        bcode-type AT ROW 5.17 COL 3 NO-LABEL
      681        unit-type AT ROW 7.17 COL 21.5 COLON-ALIGNED NO-LABEL
      682        b-unit AT ROW 7.17 COL 27.5
      683        TickOnWieght AT ROW 9 COL 3
      684        price-type AT ROW 9.04 COL 32 NO-LABEL
      685        TickOnNulSale AT ROW 10 COL 3
      686        TickOnSign AT ROW 11 COL 3
      687        rate AT ROW 11.83 COL 37.5 COLON-ALIGNED
      688        OnlyChgPrice AT ROW 12 COL 3 WIDGET-ID 2
      689        List-Sort-Type AT ROW 14.42 COL 3.75 NO-LABEL
      690        f-tick-ps AT ROW 15 COL 41.5 COLON-ALIGNED
      691        "Тип ценника (этикетки)" VIEW-AS TEXT
      692             SIZE 24 BY .67 AT ROW 2.67 COL 5
      693        "Количества" VIEW-AS TEXT
      694             SIZE 11 BY .67 AT ROW 2.67 COL 39.5
      695        "Цены" VIEW-AS TEXT
      696             SIZE 6 BY .67 AT ROW 8.08 COL 41.63
      697        "Сортировка" VIEW-AS TEXT
      698             SIZE 11 BY .67 AT ROW 13.54 COL 7.63
      699        RECT-3 AT ROW 8.5 COL 2
      700        RECT-Sort AT ROW 13.25 COL 2
      701        RECT-4 AT ROW 2.33 COL 2
      702        RECT-5 AT ROW 4.83 COL 2
      703        RECT-1 AT ROW 2.33 COL 31
      704        RECT-2 AT ROW 7.75 COL 31
      705        SPACE(1.24) SKIP(4.45)
      706       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      707            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      708            TITLE ""
      709            DEFAULT-BUTTON b-sel.
      710   ASSIGN
      711          FRAME Tickets:SCROLLABLE       = FALSE
      712          FRAME Tickets:HIDDEN           = TRUE.
      713   ASSIGN
      714          b-unit:HIDDEN IN FRAME Tickets           = TRUE.
      715   ASSIGN
      716          unit-type:HIDDEN IN FRAME Tickets           = TRUE.
      717   ON WINDOW-CLOSE OF FRAME Tickets
      718   DO:
      719     APPLY "END-ERROR":U TO SELF.
      720   END.
      721   ON CHOOSE OF b-sel IN FRAME Tickets
      722   DO:
      723     assign
      724       CurrTicket
      725       TickOnWieght
      726       TickOnSign
      727       TickOnNulSale
      728       qnty-type
      729       price-type
      730       unit-type
      731       bcode-type
      732       rate
      733       List-Sort-Type
      734       f-tick-ps
      735       OnlyChgPrice
      736       .
      737     assign
      738       TickOnN   = TickOnNulSale
      739       TickOnW   = TickOnWieght
      740       TickOnS   = TickOnSign
      741       QntyType  = qnty-type
      742       PriceType = price-type
      743       UnitName  = unit-type
      744       BCodeType = bcode-type
      745       curr-rate = rate
      746       List-sort = List-Sort-TYpe
      747       TickPS    = f-tick-ps
      748       OnlyChgPr = OnlyChgPrice
      749       .
      750     if CurrTicket <> "Не печатать" then
      751         do:
      752             DO i = 1 TO 1000:
      753                 assign s = string( "Ticket" + trim( string( i, ">>>9" ) ) ).
      754                 GET-KEY-VALUE SECTION "REP-SETS" KEY s VALUE ini-par.
      755                 if entry( 1, ini-par, "#" ) = CurrTicket then
      756                     LEAVE.
      757             END.
      758             assign
      759                 TicketName = entry( 2, ini-par, "#" )
      760                 ScalePrice = decimal( entry( 3, ini-par, "#" ) )
      761                 TicketType = entry( 4, ini-par, "#" )
      762                 .
      763         end.
      764     else
      765         assign TicketName = "".
      766   END.
      767   ON CHOOSE OF b-unit IN FRAME Tickets
      768   DO:
      769       def var unit-rec as recid no-undo.
      770       run ref/units.w ( input parparentproc, input yes, output unit-rec ).
      771       if unit-rec = ? then
      772           do:
      773               apply "entry" to unit-type in frame Tickets.
      774               return no-apply.
      775           end.
      776       FIND ub.units WHERE recid (ub.units) = unit-rec NO-LOCK.
      777       assign unit-type = ub.units.unit-name.
      778       DISPLAY unit-type with frame Tickets.
      779   END.
      780   ON VALUE-CHANGED OF bcode-type IN FRAME Tickets
      781   DO:
      782       assign bcode-type.
      783       assign TickOnSign = no.
      784       DISPLAY TickOnSign WITH FRAME Tickets.
      785       if bcode-type <> "part" AND v-cntxp-doc-prt AND Action <> "BCODE" AND Action <> "LIST" and Action <> "PROD-BC" then
      786           ENABLE TickOnSign WITH FRAME Tickets.
      787       else
      788           DISABLE TickOnSign WITH FRAME Tickets.
      789       if bcode-type = "main" AND (Action = "SCALES" OR tick-w) then
      790           assign TickOnWieght = yes.
      791       else
      792           assign TickOnWieght = no.
      793       DISPLAY TickOnWieght WITH FRAME Tickets.
      794       if bcode-type = "main" AND Action = "ALL" then
      795           ENABLE TickOnWieght WITH FRAME Tickets.
      796       else
      797           DISABLE TickOnWieght WITH FRAME Tickets.
      798       CASE bcode-type:
      799         WHEN "main" THEN do:
      800           if qnty-type:enable ( "по остаткам на объекте" ) then.
      801           if Action = "DOCUMENT" then do:
      802             if qnty-type:enable ( "по документу" )  then.
      803             if price-type:enable ( "цена документа" )  then.
      804             if price-type:enable ( "прайс-лист на дату документа" )  then.
      805           end.
      806           else do:
      807             if qnty-type:disable ( "по документу" )  then.
      808             if price-type:disable ( "цена документа" )  then.
      809             if price-type:disable ( "прайс-лист на дату документа" )  then.
      810           end.
      811           if Action = "LIST" then do:
      812             if qnty-type:enable ( "по кол-ву из списка" )  then.
      813           end.
      814           else do:
      815             if qnty-type:disable ( "по кол-ву из списка" )  then.
      816           end.
      817           DISABLE unit-type b-unit WITH FRAME Tickets.
      818           HIDE unit-type b-unit IN FRAME Tickets.
      819         end.
      820         WHEN "part" THEN do:
      821           if qnty-type:enable ( "по остаткам на объекте" )  then.
      822           if qnty-type:disable ( "по кол-ву из списка" )  then.
      823           if price-type:disable ( "цена документа" )  then.
      824           if price-type:disable ( "прайс-лист на дату документа" )  then.
      825           if Action = "DOCUMENT" then  do:
      826             if qnty-type:enable ( "по документу" )  then.
      827           end.
      828           else do:
      829             if qnty-type:disable ( "по документу" )  then.
      830           end.
      831           DISABLE unit-type b-unit WITH FRAME Tickets.
      832           HIDE unit-type b-unit IN FRAME Tickets.
      833         end.
      834         WHEN "subs" THEN do:
      835           if qnty-type:disable ( "по остаткам на объекте" )  then.
      836           if Action = "DOCUMENT" then do:
      837             if qnty-type:enable ( "по документу" )  then.
      838           end.
      839           else do:
      840             if qnty-type:disable ( "по документу" )  then.
      841           end.
      842           if price-type:disable ( "цена документа" )  then.
      843           if price-type:disable ( "прайс-лист на дату документа" )  then.
      844           ENABLE unit-type b-unit WITH FRAME Tickets.
      845         end.
      846       END CASE.
      847       if doctype = "bb-list" then do:
      848         hide
      849         TickOnSign
      850         in frame Tickets .
      851       end.
      852   END.
      853   ON VALUE-CHANGED OF price-type IN FRAME Tickets
      854   DO:
      855     assign price-type .
      856     if v-rb-is-base = true
      857        and v-base-code <> 0
      858        and DocType <> "price"
      859     then do:
      860       if price-type = "doc" or price-type = "doc-pr" then do:
      861         HIDE rate IN FRAME Tickets.
      862       end.
      863       else do:
      864         ENABLE rate WITH FRAME Tickets.
      865       end.
      866     end.
      867   END.
      868   procedure proc-cur-rate :
      869     do
      870     on error undo, return error return-value
      871     :
      872   define input  parameter p-obj-type as character no-undo .
      873   define input  parameter p-obj-code as integer   no-undo .
      874   define output parameter Rubl_Coeff as decimal   no-undo .
      875   define variable v-base-code like ub.sysconf.base-code no-undo .
      876   define variable v-host-code like ub.sysconf.host-code no-undo .
      877   DEFINE VARIABLE v-today as date no-undo .
      878   DEFINE VARIABLE v-time as integer no-undo .
      879   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      880   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      881     (input  p-obj-type
      882     ,input  p-obj-code
      883     ,output v-host-code
      884     )  .
      885   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      886   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
      887     (input  v-host-code
      888     ,output v-base-code
      889     )  .
      890   run cur-time in this-procedure ( output v-today, output v-time).
      891           FIND LAST ub.curr-accnt WHERE ub.curr-accnt.curr-code = v-base-code
      892                                                    AND ub.curr-accnt.exch-date <= v-today
      893                                                    NO-LOCK NO-ERROR .
      894           FIND LAST ub.curr-shop WHERE ub.curr-shop.curr-code = v-base-code
      895                                                    AND ub.curr-shop.obj-code = p-obj-code
      896                                                    AND ub.curr-shop.obj-type = p-obj-type
      897                                                    USE-INDEX pi NO-LOCK NO-ERROR .
      898           if p-obj-type = 'маг':U then
      899               do:
      900                   if not available ub.curr-shop then
      901                       do:
      902                           bell.
      903                           message "Нет ни одного МАГАЗИННОГО курса базовой валюты к рублям.".
      904                           Rubl_Coeff = 1.
      905                       end.
      906                   else
      907                       Rubl_Coeff = ub.curr-shop.exch-rate / ub.curr-shop.exch-scale.
      908               end.
      909           else
      910               do:
      911                   if not available ub.curr-accnt then
      912                       do:
      913                           bell.
      914                           message "Нет ни одного курса ММВБ базовой валюты к рублям.".
      915                           return.
      916                       end.
      917                   else
      918                       Rubl_Coeff = ub.curr-accnt.exch-rate / ub.curr-accnt.exch-scale.
      919               end.
      920     end.
      921   end procedure.
      922   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Tickets:PARENT eq ?
      923   THEN FRAME Tickets:PARENT = ACTIVE-WINDOW.
      924   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      925   on help of frame Tickets
      926   do:
      927     run gbl/app_help.p
      928       (input this-procedure :file-name
      929       ,input ''
      930       ,input ?
      931       ) no-error.
      932     if error-status :error then do:
      933       message
      934         "Ошибка при вызове помощи"
      935         error-status :get-message(1)
      936         view-as alert-box .
      937     end.
      938   end.
      939   run minbtn-set in this-procedure .
      940   on choose of b-help in frame Tickets
      941   do:
      942     apply "help":u to frame Tickets .
      943   end.
      944   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      945   procedure minbtn-set :
      946       do
      947           on error undo, return error return-value
      948           :
      949           define variable ii              as integer       no-undo .
      950           define variable fh              as widget-handle no-undo .
      951           define variable hh              as widget-handle no-undo .
      952           define variable v-h             as handle        extent 4 no-undo .
      953           define variable v-name-button   as character     no-undo .
      954           define variable v-help-old-x    as decimal       no-undo .
      955           define variable v-help-old-y    as decimal       no-undo .
      956           define variable v-help-old-size as decimal       no-undo .
      957           define variable v-frame-width   as decimal       no-undo .
      958           define variable jj              as integer       no-undo .
      959           do
      960               on error undo, return error
      961               :
      962               assign
      963                   v-frame-width = frame Tickets:width - 0.3
      964                   fh            = frame Tickets:first-child
      965                   hh            = fh:first-child
      966                   ii            = 1
      967                   .
      968               do while valid-handle(hh):
      969                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      970                   do:
      971                       case lc(hh:name) :
      972                           when "b-help" then
      973                               do:
      974                                   hh:load-image-up("cmp/b-help.bmp":u) .
      975                                   hh:load-image-down("cmp/b-help.bmp":u) .
      976                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      977                                   hh:TOOLTIP = "Помощь" .
      978                                   v-help-old-x = hh:column .
      979                                   v-help-old-y = hh:row    .
      980                                   v-help-old-size = hh:width .
      981                                   hh:width-chars = 2.5 .
      982                               end.
      983                           when "b-print" then
      984                               do:
      985                                   hh:load-image("cmp/b-print.bmp":u) .
      986                                   hh:TOOLTIP = "Печать" .
      987                                   v-h[ii] = hh:handle .
      988                                   ii = ii + 1 .
      989                                   hh:width-chars = 3 .
      990                               end.
      991                           when "b-history" or
      992                           when "b-hist" then
      993                               do:
      994                                   hh:load-image("cmp/b-hist.bmp":u) .
      995                                   hh:TOOLTIP = "История" .
      996                                   v-h[ii] = hh:handle .
      997                                   ii = ii + 1 .
      998                                   hh:width-chars = 3 .
      999                               end.
     1000                           when "b-sch" then
     1001                               do:
     1002                                   hh:load-image("cmp/b-sch.bmp":u) .
     1003                                   hh:TOOLTIP = "Установка Фильтра" .
     1004                                   v-h[ii] = hh:handle .
     1005                                   ii = ii + 1 .
     1006                                   hh:width-chars = 3 .
     1007                               end.
     1008                           when "b-hist-user" then
     1009                               do:
     1010                                   hh:load-image("cmp/b-hist.bmp":u) .
     1011                                   hh:TOOLTIP = "История пользователя" .
     1012                                   ii = ii + 1 .
     1013                               end.
     1014                       end case.
     1015                   end.
     1016                   hh = hh:next-sibling.
     1017               end.
     1018               b-help:column = v-frame-width - b-help:width-chars.
     1019               jj = 0.
     1020               repeat ii = 4 to 1 by -1 :
     1021                   if valid-handle (v-h[ii] ) then
     1022                   do:
     1023                       jj  = jj + 1 .
     1024                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1025                       v-h[ii]:row    = v-help-old-y .
     1026                   end.
     1027               end.
     1028           end.
     1029       end.
     1030   end procedure.
     1031   MAIN-BLOCK:
     1032   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1033      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1034   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1035   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rbisbase in g#library
     1036     (output v-rb-is-base
     1037     )  .
     1038   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1039   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1040     (input  p-obj-type
     1041     ,input  p-obj-code
     1042     ,output v-host-code
     1043     )  .
     1044   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1045   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     1046     (input  v-host-code
     1047     ,output v-base-code
     1048     )  .
     1049     find first buf_rep_currency no-lock
     1050       where buf_rep_currency.curr-code = v-base-code
     1051       no-error .
     1052       if available buf_rep_currency then base-type = buf_rep_currency.curr-abbr .
     1053                   else base-type = "б.в." .
     1054     DO i = 1 TO 1000:
     1055         assign s = string( "Ticket" + trim( string( i, ">>>9" ) ) ).
     1056         GET-KEY-VALUE SECTION "REP-SETS" KEY s VALUE ini-par.
     1057         if ini-par = ? then
     1058             LEAVE.
     1059         else
     1060             if CurrTicket:ADD-LAST( entry( 1, ini-par, "#" ) ) then.
     1061     END.
     1062     if v-rb-is-base = true
     1063       and v-base-code <> 0
     1064     then do:
     1065   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1066   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
     1067     (input  p-obj-type
     1068     ,input  p-obj-code
     1069     ,output v-today
     1070     )  .
     1071       run proc-cur-rate( input p-obj-type, input p-obj-code, output Rubl_Coeff ).
     1072       assign
     1073         rate = Rubl_Coeff
     1074       .
     1075     end.
     1076     assign
     1077       List-Sort-Type:radio-buttons = "По коду"         + chr(44) + "b-code":U + chr(44) +
     1078                                      "По артикулу"     + chr(44) + "artic":U +   chr(44) +
     1079                                      "По наименованию" + chr(44) + "gds-name":U + chr(44) +
     1080                                      "В порядке ввода" + chr(44) + "order-num":U
     1081     .
     1082     RUN enable_UI.
     1083     if v-rb-is-base = true then do:
     1084       if v-base-code = 0 OR (Action = "DOCUMENT" AND DocType <> "price" AND price-type = "doc" AND price-type = "doc-pr")
     1085       then do:
     1086         HIDE rate IN FRAME Tickets.
     1087       end.
     1088     end.
     1089     else do:
     1090       HIDE rate IN FRAME Tickets.
     1091     end.
     1092     if doctype = "bb-list" then do:
     1093       assign
     1094         qnty-type = "список"
     1095         TickOnSign = yes
     1096       .
     1097       display
     1098         qnty-type
     1099         with frame Tickets
     1100         .
     1101       hide
     1102       bcode-type
     1103       in frame Tickets .
     1104     end.
     1105     if action <> "DOCUMENT"
     1106       or ( action = "DOCUMENT":U
     1107            and doctype <> "price":U
     1108          )
     1109     then do:
     1110       disable
     1111         OnlyChgPrice
     1112         with frame Tickets .
     1113     end.
     1114     if action = "PROD-BC" then do:
     1115       DISABLE
     1116       List-Sort-Type
     1117       with frame Tickets.
     1118       if DocType = "main" then do:
     1119         if bcode-type:disable ( "Бар-код партии" )  then.
     1120         if bcode-type:disable ( "Неосн. бар-код" )  then.
     1121       end.
     1122       if DocType = "part" then do:
     1123         if bcode-type:disable ( "Основной бар-код" )  then.
     1124         if bcode-type:disable ( "Неосн. бар-код" )  then.
     1125       end.
     1126       if DocType = "subs" then do:
     1127         if bcode-type:disable ( "Бар-код партии" )  then.
     1128         if bcode-type:disable ( "Основной бар-код" )  then.
     1129       end.
     1130     end.
     1131     else do:
     1132       if Action <> "DOCUMENT"
     1133       AND Action <> "LIST"
     1134       AND Action <> "ALL" then  do:
     1135         if bcode-type:disable ( "Бар-код партии" )  then.
     1136         if bcode-type:disable ( "Неосн. бар-код" )  then.
     1137       end.
     1138     end.
     1139     APPLY "VALUE-CHANGED" TO bcode-type IN FRAME Tickets.
     1140     WAIT-FOR GO OF FRAME Tickets.
     1141   END.
     1142   RUN disable_UI.
     1143   PROCEDURE cust :
     1144   END PROCEDURE.
     1145   PROCEDURE disable_UI :
     1146     HIDE FRAME Tickets.
     1147   END PROCEDURE.
     1148   PROCEDURE enable_UI :
     1149     DISPLAY qnty-type CurrTicket bcode-type TickOnWieght price-type TickOnNulSale
     1150             rate List-Sort-Type f-tick-ps
     1151         WITH FRAME Tickets.
     1152     ENABLE b-sel b-help RECT-3 RECT-Sort RECT-4 RECT-5 RECT-1 RECT-2 qnty-type
     1153            CurrTicket bcode-type price-type TickOnNulSale rate OnlyChgPrice
     1154            List-Sort-Type f-tick-ps
     1155         WITH FRAME Tickets.
     1156     VIEW FRAME Tickets.
     1157   END PROCEDURE.
