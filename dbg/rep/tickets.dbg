       59   PROCEDURE gen-bc:
       60     def input  parameter internal-b-code like ub.bar-code.b-code no-undo .
       61     def output parameter full-b-code     as character init ""    no-undo .
       62   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       63     define variable tmp-str2  as character no-undo.
       64     define variable tmp-num2  as character no-undo.
       65     define variable i2        as integer   no-undo.
       66     define variable sum2      as integer   no-undo.
       67     define variable len-code2 as integer   no-undo.
       68     define variable varcont2  as logical   initial yes no-undo.
       69     CASE bc-frmt :
       70       WHEN "EAN13" THEN do:
       71         assign
       72           tmp-str2 = string( internal-b-code, "999999999999" )
       73         .
       74       end.
       75       WHEN "EAN8" THEN do:
       76         assign
       77           tmp-str2 = string( internal-b-code, "9999999" )
       78         .
       79       end.
       80       OTHERWISE DO:
       81           message "Неизвестный тип генерации бар-кода процедурой bc-gnrti.i: " bc-frmt " ."
       82           view-as alert-box error.
       83           return error.
       84       END.
       85     END CASE.
       86     if varcont2 = yes then do:
       87       if integer( substring( tmp-str2, 1, length( bc-pfx ) ) ) <> 0
       88       then do:
       89         message
       90           "Невозможно сформировать бар-код" SKIP
       91           "для товара с кодом: " internal-b-code
       92           view-as alert-box error title "подрезание кода".
       93         return error.
       94       end.
       95       else do:
       96         assign
       97           full-b-code = bc-pfx + substring( tmp-str2, length( bc-pfx ) + 1, length( tmp-str2 ) - length( bc-pfx ) )
       98           len-code2    = length( full-b-code )
       99         .
      100         define variable v-sum-char2 as character no-undo .
      101         assign
      102           sum2 = 0
      103         .
      104         do i2 = 1 to len-code2 by 2
      105         :
      106           assign
      107             v-sum-char2 = substr(full-b-code, len-code2 - i2 + 1, 1)
      108           .
      109           if v-sum-char2 < "0"
      110           or v-sum-char2 > "9"
      111           then do:
      112             message
      113               "Невозможно сформировать бар-код" skip
      114               "для товара с кодом: " internal-b-code skip
      115               view-as alert-box error title "подсчет контрольной суммы".
      116             return error.
      117           end.
      118           assign
      119             sum2 = sum2 + integer(v-sum-char2)
      120           .
      121         end.
      122         if varcont2 = yes then do:
      123           assign
      124             sum2 = sum2 * 3
      125           .
      126           do i2 = 2 to len-code2 by 2
      127           :
      128             assign
      129               v-sum-char2 = substr(full-b-code, len-code2 - i2 + 1, 1)
      130             .
      131             if v-sum-char2 < "0"
      132             or v-sum-char2 > "9"
      133             then do:
      134               message
      135                 "Невозможно сформировать бар-код" skip
      136                 "для товара с кодом: " internal-b-code skip
      137                 view-as alert-box error title "подсчет контрольной суммы".
      138               return error.
      139             end.
      140             assign
      141               sum2 = sum2 + integer(v-sum-char2)
      142             .
      143           end.
      144           if varcont2 = yes then do:
      145              if sum2 mod 10 = 0 then do:
      146                assign
      147                  full-b-code = full-b-code + '0'
      148                .
      149              end.
      150              else do:
      151                assign
      152                  full-b-code = full-b-code + string(10 - sum2 mod 10)
      153                .
      154              end.
      155           end.
      156         end.
      157       end.
      158     end.
      159   END PROCEDURE.
      160   def   shared var pl-frmt as character no-undo .
      161   def   shared var pl-pfx  as character no-undo .
      162   def var pl-par-type as character no-undo .
      163   PROCEDURE gen-pl:
