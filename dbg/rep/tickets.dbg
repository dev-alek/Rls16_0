      237             then do:
      238               message
      239                 "Невозможно сформировать бар-код" skip
      240                 "для товара с кодом: " internal-b-code skip
      241                 view-as alert-box error title "подсчет контрольной суммы".
      242               return error.
      243             end.
      244             assign
      245               sum3 = sum3 + integer(v-sum-char3)
      246             .
      247           end.
      248           if varcont3 = yes then do:
      249              if sum3 mod 10 = 0 then do:
      250                assign
      251                  full-b-code = full-b-code + '0'
      252                .
      253              end.
      254              else do:
