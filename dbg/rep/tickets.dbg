      171     define variable len-code3 as integer   no-undo.
      172     define variable varcont3  as logical   initial yes no-undo.
      173     CASE pl-frmt :
      174       WHEN "EAN13" THEN do:
      175         assign
      176           tmp-str3 = string( internal-b-code, "999999999999" )
