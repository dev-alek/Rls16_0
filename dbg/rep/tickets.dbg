      225         end.
      226         if varcont3 = yes then do:
      227           assign
      228             sum3 = sum3 * 3
      229           .
      230           do i3 = 2 to len-code3 by 2
      231           :
      232             assign
      233               v-sum-char3 = substr(full-b-code, len-code3 - i3 + 1, 1)
      234             .
