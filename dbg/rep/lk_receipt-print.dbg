      476   procedure xmlchar-test :
      477   define input parameter p-in-string          as character        no-undo.
      478   define output parameter p-out-string-enc    as character        no-undo.
      479   define output parameter p-out-string-dec    as character        no-undo.
      480   do
      481   on error undo, return error
      482   :
      483          run xmlchar-encode in this-procedure
      484       (
      485             input p-in-string
      486           , output p-out-string-enc
      487       ).
      488          run xmlchar-decode in this-procedure
      489       (
      490             input p-out-string-enc
      491           , output p-out-string-dec
      492       ).
      493   end.
      494   end .
      495   procedure xmlchar-encode :
      496   define input parameter p-in-string      as character        no-undo.
      497   define output parameter p-out-string    as character        no-undo.
      498       define variable v-position      as integer      no-undo.
      499       define variable v-current-char  as character    no-undo.
      500   do
      501   on error undo, return error
      502   :
      503       assign
      504           p-out-string = "":U
      505       .
      506       case p-in-string
      507       :
      508           when ?
      509           then do:
      510               assign
      511                   p-out-string = "?":U
      512               .
      513           end.
      514           when "?":U
      515           then do:
      516               assign
      517                   p-out-string = "&#63;":U
      518               .
      519           end.
      520           otherwise do:
      521               do v-position = 1 to length( p-in-string )
      522               :
      523                   assign
      524                       v-current-char = substring( p-in-string, v-position, 1 )
      525                   .
      526                   case v-current-char
      527                   :
      528                       when "&":U
      529                       then do:
      530                           assign
      531                               p-out-string = p-out-string + "&amp;":U
      532                           .
      533                       end.
      534                       when ">":U
      535                       then do:
      536                           assign
      537                               p-out-string = p-out-string + "&gt;":U
      538                           .
      539                       end.
      540                       when "<":U
      541                       then do:
      542                           assign
      543                               p-out-string = p-out-string + "&lt;":U
      544                           .
      545                       end.
      546                       when "'":U
      547                       then do:
      548                           assign
      549                               p-out-string = p-out-string + "&apos;":U
      550                           .
      551                       end.
      552                       when '"':U
      553                       then do:
      554                           assign
      555                               p-out-string = p-out-string + "&quot;":U
      556                           .
      557                       end.
      558                       when chr(1)
      559                       then do:
      560                           assign
      561                               p-out-string = p-out-string + "":U
      562                           .
      563                       end.
      564                       when chr(2)
      565                       then do:
      566                           assign
      567                               p-out-string = p-out-string + "":U
      568                           .
      569                       end.
      570                       when chr(3)
      571                       then do:
      572                           assign
      573                               p-out-string = p-out-string + "":U
      574                           .
      575                       end.
      576                       when chr(4)
      577                       then do:
      578                           assign
      579                               p-out-string = p-out-string + "":U
      580                           .
      581                       end.
      582                       when chr(5)
      583                       then do:
      584                           assign
      585                               p-out-string = p-out-string + "":U
      586                           .
      587                       end.
      588                       when chr(6)
      589                       then do:
      590                           assign
      591                               p-out-string = p-out-string + "":U
      592                           .
      593                       end.
      594                       when chr(7)
      595                       then do:
      596                           assign
      597                               p-out-string = p-out-string + "":U
      598                           .
      599                       end.
      600                       when chr(8)
      601                       then do:
      602                           assign
      603                               p-out-string = p-out-string + "":U
      604                           .
      605                       end.
      606                       when chr(9)
      607                       then do:
      608                           assign
      609                               p-out-string = p-out-string + "":U
      610                           .
      611                       end.
      612                       when chr(29)
      613                       then do:
      614                           assign
      615                               p-out-string = p-out-string + "":U
      616                           .
      617                       end.
      618                       when chr(10)
      619                       then do:
      620                           assign
      621                               p-out-string = p-out-string + "&#10;":U
      622                           .
      623                       end.
      624                       when chr(13)
      625                       then do:
      626                           assign
      627                               p-out-string = p-out-string + "&#13;":U
      628                           .
      629                       end.
      630                       otherwise do:
      631                           assign
      632                               p-out-string = p-out-string + v-current-char
      633                           .
      634                       end.
      635                   end case.
      636               end.
      637           end.
      638       end case.
      639   end.
      640   end .
      641   procedure xmlchar-encode-1c :
      642   define input parameter p-in-string      as character        no-undo.
      643   define output parameter p-out-string    as character        no-undo.
      644       define variable v-position      as integer      no-undo.
      645       define variable v-current-char  as character    no-undo.
      646   do
      647   on error undo, return error
      648   :
      649       assign
      650           p-out-string = "":U
      651       .
      652       case p-in-string
      653       :
      654           when ?
      655           then do:
      656               assign
      657                   p-out-string = "?":U
      658               .
      659           end.
      660           otherwise do:
      661               do v-position = 1 to length( p-in-string )
      662               :
      663                   assign
      664                       v-current-char = substring( p-in-string, v-position, 1 )
      665                   .
      666                   case v-current-char
      667                   :
      668                       when chr(1)
      669                       then do:
      670                           assign
      671                               p-out-string = p-out-string + " ":U
      672                           .
      673                       end.
      674                       when chr(2)
      675                       then do:
      676                           assign
      677                               p-out-string = p-out-string + " ":U
      678                           .
      679                       end.
      680                       when chr(3)
      681                       then do:
      682                           assign
      683                               p-out-string = p-out-string + " ":U
      684                           .
      685                       end.
      686                       when chr(4)
      687                       then do:
      688                           assign
      689                               p-out-string = p-out-string + " ":U
      690                           .
      691                       end.
      692                       when chr(5)
      693                       then do:
      694                           assign
      695                               p-out-string = p-out-string + " ":U
      696                           .
      697                       end.
      698                       when chr(6)
      699                       then do:
      700                           assign
      701                               p-out-string = p-out-string + " ":U
      702                           .
      703                       end.
      704                       when chr(7)
      705                       then do:
      706                           assign
      707                               p-out-string = p-out-string + " ":U
      708                           .
      709                       end.
      710                       when chr(8)
      711                       then do:
      712                           assign
      713                               p-out-string = p-out-string + " ":U
      714                           .
      715                       end.
      716                       when chr(9)
      717                       then do:
      718                           assign
      719                               p-out-string = p-out-string + " ":U
      720                           .
      721                       end.
      722                       when chr(29)
      723                       then do:
      724                           assign
      725                               p-out-string = p-out-string + " ":U
      726                           .
      727                       end.
      728                       when chr(10)
      729                       then do:
      730                           assign
      731                               p-out-string = p-out-string + " ":U
      732                           .
      733                       end.
      734                       when chr(13)
      735                       then do:
      736                           assign
      737                               p-out-string = p-out-string + " ":U
      738                           .
      739                       end.
      740                       otherwise do:
      741                           assign
      742                               p-out-string = p-out-string + v-current-char
      743                           .
      744                       end.
      745                   end case.
      746               end.
      747           end.
      748       end case.
      749   end.
      750   end .
      751   procedure xmlchar-decode :
      752   define input parameter p-in-string      as character        no-undo.
      753   define output parameter p-out-string    as character        no-undo.
      754       define variable v-position      as integer      no-undo.
      755       define variable v-last-position as integer      no-undo.
      756       define variable v-temp-integer  as integer      no-undo.
      757       define variable v-current-char  as character    no-undo.
      758       define variable v-next-char     as character    no-undo.
      759       define variable v-success       as logical      no-undo.
      760   do
      761   on error undo, return error
      762   :
      763       assign
      764           p-out-string = "":U
      765           v-position   = 0
      766       .
      767       replace-cycle:
      768       do while yes
      769       on error undo, return error
      770       :
      771           assign
      772               v-last-position = index( p-in-string, "&":U, v-position + 1 )
      773           .
      774           if v-last-position <= v-position
      775           then do:
      776               if v-position = 0
      777               then do:
      778                   assign
      779                       p-out-string = p-in-string
      780                   .
      781               end.
      782               else do:
      783                   assign
      784                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
      785                   .
      786               end.
      787               leave replace-cycle.
      788           end.
      789           else do:
      790               assign
      791                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
      792                   v-position      = v-last-position
      793                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
      794               .
      795               if v-current-char = "#":U
      796               then do:
      797                   assign
      798                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
      799                   .
      800                   if v-last-position > 0
      801                   then do:
      802                       run xmlchar-read-integer in this-procedure
      803                        (
      804                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
      805                           , output v-temp-integer
      806                           , output v-success
      807                       ).
      808                       if v-success = yes
      809                       and v-temp-integer >= 1
      810                       and v-temp-integer <= 255
      811                       then do:
      812                           assign
      813                               p-out-string = p-out-string + chr( v-temp-integer )
      814                               v-position   = v-last-position + 1
      815                           .
      816                       end.
      817                       else do:
      818                           assign
      819                               p-out-string = p-out-string + "&":U
      820                               v-position   = v-position   + 1
      821                           .
      822                       end.
      823                   end.
      824                   else do:
      825                       assign
      826                           p-out-string = p-out-string + "&":U
      827                           v-position   = v-position   + 1
      828                       .
      829                   end.
      830               end.
      831               else do:
      832                   case substring( p-in-string, v-position + 1, 3 )
      833                   :
      834                       when "lt;":U
      835                       then do:
      836                           assign
      837                               p-out-string = p-out-string + "<":U
      838                               v-position   = v-position   + 3
      839                           .
      840                       end.
      841                       when "gt;":U
      842                       then do:
      843                           assign
      844                               p-out-string = p-out-string + ">":U
      845                               v-position   = v-position   + 3
      846                           .
      847                       end.
      848                       otherwise do:
      849                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
      850                           then do:
      851                               assign
      852                                   p-out-string = p-out-string + "&":U
      853                                   v-position   = v-position   + 4
      854                               .
      855                           end.
      856                           else do:
      857                               case substring( p-in-string, v-position + 1, 5 )
      858                               :
      859                                   when "quot;":U
      860                                   then do:
      861                                       assign
      862                                           p-out-string = p-out-string + '"':U
      863                                           v-position   = v-position   + 5
      864                                       .
      865                                   end.
      866                                   when "apos;":U
      867                                   then do:
      868                                       assign
      869                                           p-out-string = p-out-string + "'":U
      870                                           v-position   = v-position   + 5
      871                                       .
      872                                   end.
      873                                   otherwise do:
      874                                       assign
      875                                           p-out-string = p-out-string + "&":U
      876                                       .
      877                                   end.
      878                               end case.
      879                           end.
      880                       end.
      881                   end case.
      882               end.
      883           end.
      884       end.
      885   end.
      886   end .
      887   procedure xmlchar-read-integer :
      888   define input parameter p-input-string      as character        no-undo.
      889   define output parameter p-output-integer   as integer          no-undo.
      890   define output parameter p-success       as logical          no-undo.
      891   do
      892   on error undo, return error
      893   :
      894       assign
      895           p-output-integer = integer( p-input-string )
      896       no-error.
      897       if error-status :error
      898       then do:
      899           assign
      900               p-success           = no
      901               p-output-integer    = 0
      902           .
      903       end.
      904       else do:
      905           assign
      906               p-success           = yes
      907           .
      908       end.
      909   end.
      910   end.
      911   define new global shared variable g#attr-lib  as handle no-undo .
      912   define variable v-attr-lib-variable as handle no-undo .
      913   define variable mMRCCode  as logical    no-undo.
      914   define variable mTypeMark as character  no-undo.
      915   function IS-NeedMark returns logical
      916   ( input ib-code as integer  ,
      917     input ib-str as character ):
      918      define buffer buf_prod-bc-attr for ub.prod-bc-attr.
      919      find first buf_prod-bc-attr where buf_prod-bc-attr.b-code eq ib-code
      920                                    and buf_prod-bc-attr.b-str  eq ib-str
      921                                    and buf_prod-bc-attr.attr-code eq 'mark':U
      922        no-lock no-error.
      923      return if available buf_prod-bc-attr then logical(buf_prod-bc-attr.attr-value) else no .
      924   end.
      925   function repTegforDm return char
      926   (iDM as char ):
      927       define variable vTeglist as character no-undo init "01,02,11,13,17,21,8005,37".
      928       define variable vteg as character no-undo.
      929       define variable oDM as character no-undo.
      930       define variable vi as integer no-undo.
      931       oDM = iDm.
      932       do vi = 1 to num-entries(vTeglist):
      933          vTeg = entry(vi,vTeglist).
      934          oDM = replace(oDM,"(" + vTeg + ")",vTeg).
      935       end.
      936       return oDM.
      937   end.
      938   function repSpecSimbforDm return char
      939   (iDM as char ):
      940       define variable oDM as character no-undo.
      941     run
      942       xmlchar-decode(iDM, output oDM).
      943     return repTegforDm (oDM).
      944   end.
      945   function CheckGtin return logical
      946   (iGtin as char):
      947      define variable bar_code as character no-undo.
      948      define variable vGtin as logical no-undo init "yes".
      949      if length(iGtin) eq 14
      950      then do:
      951         bar_code = substr (iGtin, 1, length (iGtin) - 1).
      952         run str/chk-sum.p
      953          (input-output bar_code ) no-error .
      954         if iGtin ne  bar_code
      955         then
      956            vGtin = no.
      957      end.
      958      else
      959         vGtin = no.
      960      return vgtin.
      961   end.
      962   function repSpecSimbforXlm return char
      963   (iDM as char ):
      964       iDM = replace(iDM,chr(29),"").
      965       return iDM.
      966   end.
      967   function getGtinByDM return char
      968   (IDM as char):
      969      define variable VTXT as char no-undo.
      970      define variable vGtin as char no-undo.
      971      vTXt = IdM.
      972      vGtin = IDM.
      973      if    length(vtxt) > 14
      974      then do:
      975         if   vtxt begins "(01)"
      976                or vtxt begins "(02)"
      977         then
      978            vGtin = substring(vtxt,5,14).
      979         else if   (vtxt begins "01"
      980                or vtxt begins "02" )
      981                and (   (    substring(iDm,17,2) eq "21"
      982                         and length(vtxt) >= 21)
      983                     or substring(iDm,17,2) eq "37"
      984                     or substring(iDm,17,4) eq "(37)" )
      985         then do:
      986            vGtin = substring(vtxt,3,14).
      987            if not checkGtin(vGtin)
      988            then
      989               vGtin = substring(vtxt,1,14).
      990         end.
      991         else if     length(vtxt) eq 14 + 7 + 4 + 4
      992             or length(vtxt) eq 14 + 7 + 4
      993             or length(vtxt) eq 14 + 7
      994         then
      995            vGtin = substring(vtxt,1,14).
      996      end.
      997      if not checkGtin(vGtin)
      998      then
      999         vGtin = "".
     1000      return vgtin.
     1001   end.
     1002   function getGdsCodeByGtin return int
     1003   (iGtin as char):
     1004      define buffer prod-bc  for ub.prod-bc.
     1005      define buffer bar-code for ub.bar-code.
     1006      find first prod-bc where prod-bc.b-str eq iGtin  and prod-bc.bc-on no-lock no-error.
     1007      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
     1008      return if avail bar-code then bar-code.gds-code else ?.
     1009   end.
     1010   function getQntyCodeByGtin return decimal
     1011   (iGtin as char):
     1012      define buffer prod-bc  for ub.prod-bc.
     1013      define buffer bar-code for ub.bar-code.
     1014      find first prod-bc where prod-bc.b-str eq iGtin no-lock no-error.
     1015      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
     1016      return if avail bar-code then bar-code.cli-base-rate else ?.
     1017   end.
     1018   function getGdsCodeByDM return int
     1019   (iDm as char):
     1020      define variable vGtin as char no-undo.
     1021      define buffer prod-bc for ub.prod-bc.
     1022      vGtin  = getGtinByDM (IDM ).
     1023      return getGdsCodeByGtin (vGtin).
     1024   end.
     1025   function ChekTypeMarkByGds return logical
     1026   (iGds-code as integer ):
     1027      define buffer goods-attr for ub.goods-attr.
     1028      find first goods-attr where goods-attr.gds-code   = iGds-code
     1029                              and goods-attr.attr-code  = 'mark-type':U
     1030      no-lock no-error.
     1031      if available goods-attr
     1032      then do:
     1033         mTypeMark = goods-attr.attr-value.
     1034         return goods-attr.attr-value = objsrv:Env:Marking:Types:tabak:NameProp
     1035           .
     1036      end.
     1037      else
     1038         return no.
     1039   end.
     1040   function ChekTypeMarkByDm return logical
     1041   (iDM as char ):
     1042      return ChekTypeMarkByGds(getGdsCodeByDM(idm)).
     1043   end.
     1044   function ChekTypeMarkByGtin return logical
     1045   (iGtin as char ):
     1046      return ChekTypeMarkByGds(getGdsCodeByGtin(iGtin)).
     1047   end.
     1048   function GetNextElement return character
     1049     (input iAllTeg        as logical
     1050     ,output oteg          as character
     1051     ,output otegval       as character
     1052     ,input-output pstr    as character
     1053      ):
     1054        define variable vlistElem   as character no-undo init "00,01,02,21,17,11,13,(01),(02),(21),(17),(11),(13)".
     1055        define variable vlistleng   as character no-undo init "27,14,14,13,06,06,06,0014,0014,0013,0006,0006,0006".
     1056        define variable vlistElemDop   as character no-undo init ",37,(37),(8005),8005,93,(93)".
     1057        define variable vlistlengDop   as character no-undo init ",08,0008,000006,0006,04,0004".
     1058        define variable vTeg as character no-undo.
     1059        define variable vLength as integer no-undo.
     1060        define variable vi as integer no-undo.
     1061        define variable vj as integer no-undo.
     1062        define buffer code for ub.code.
     1063        find first code where Code.parent eq "MarkType"
     1064                          and Code.CodeValue   eq mTypeMark
     1065                          no-lock no-error.
     1066        if     available code
     1067           and Code.misc1 ne ""
     1068           and Code.misc1 ne ?
     1069        then do:
     1070           integer (Code.misc1) no-error.
     1071           if not error-status:error
     1072           then
     1073             entry (4,vlistleng) = Code.misc1.
     1074        end.
     1075        if iAllTeg
     1076        then
     1077           assign
     1078              vlistElem     = vlistElem    + vlistElemDop
     1079              vlistleng     = vlistleng    + vlistlengDop
     1080           .
     1081        else if mMRCCode
     1082        then
     1083           assign
     1084              vlistElem     = vlistElem    + ",(8005),8005"
     1085              vlistleng     = vlistleng    + ",000006,0006"
     1086           .
     1087       block-elem:
     1088       do vi = 1 to num-entries(vlistElem):
     1089          vTeg = entry(vi,vlistElem).
     1090          if pstr begins vTeg
     1091          then do:
     1092             if    vTeg eq "21"
     1093             then
     1094                vLength = index(pstr,chr(29)) - 2 no-error.
     1095             if vLength  <= 0
     1096             then
     1097                vLength = int(entry(vi,vlistleng)).
     1098             otegval = substring (pstr,length(vteg) + 1, vLength).
     1099             oteg = replace(replace(vteg,")",""),"(","").
     1100             vTeg = vteg + otegval.
     1101             otegval = replace(otegval,chr(29),"").
     1102             oteg = replace(replace(oteg,")",""),"(","").
     1103             pstr = substring (pstr,length(vTeg)+ 1).
     1104             vTeg = replace(vTeg,chr(29),"").
     1105             leave block-elem.
     1106          end.
     1107          else
     1108             vTeg = "".
     1109       end.
     1110       return vteg.
     1111   end.
     1112   function GetCodeIdent return character
     1113   (iDm as char):
     1114      define variable Velement   as character no-undo init "first".
     1115      define variable oCodeIdent as character no-undo.
     1116      define variable vteg as character no-undo.
     1117      define variable vtegval as character no-undo.
     1118      define variable vGtin as character no-undo.
     1119      define buffer marking for ub.marking.
     1120      for first marking no-lock where
     1121                marking.mark eq iDm
     1122            and marking.unit-ext = "LEVEL2"
     1123      :
     1124        return iDm.
     1125      end.
     1126      vGtin  = getGtinByDM (iDm ).
     1127      ChekTypeMarkByDm(idm).
     1128      if iDm begins 'tech_':U
     1129      then
     1130         oCodeIdent = iDm.
     1131      else if length(iDm) < 21
     1132      then do:
     1133         find first marking where marking.mark eq idm
     1134         no-lock no-error.
     1135         oCodeIdent = if available marking then marking.mark else  ?.
     1136      end.
     1137      else if     length(iDm) eq 29
     1138         and not iDm begins "01"
     1139         and not iDm begins "02"
     1140      then
     1141         oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21 ).
     1142      else  if     length(iDm) >= 24
     1143               and (  iDm begins "01"
     1144                   or iDm begins "02")
     1145               and  substring(iDm,17,2) ne "21"
     1146      then do:
     1147         if checkGtin(substring(iDm,1,14)) and ( (length(idm) eq 25 and substring(iDm,22,1) eq "A")
     1148                                                   or (length(idm) eq 29 and substring(iDm,22,1) eq "A"))
     1149         then
     1150            oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21).
     1151         else
     1152            oCodeIdent = iDM.
     1153      end.
     1154      else  if     (   length(iDm) eq 25
     1155                    or length(iDm) eq 21)
     1156               and (not iDm begins "01"
     1157               and  not iDm begins "02")
     1158      then
     1159         oCodeIdent = substring(iDm,1,21).
     1160      else if vGtin = substring(iDm,1,14) and checkGtin(substring(iDm,1,14)) and ( length(idm) eq 21 or (length(idm) eq 25 and substring(iDm,22,1) eq "A"))
     1161      then
     1162         oCodeIdent = substring(iDm,1,21).
     1163      else do while Velement ne "" and idm ne "":
     1164         Velement = GetNextElement(no,output vteg, output vtegval, input-output idm).
     1165         oCodeIdent = oCodeIdent + Velement.
     1166      end.
     1167      return oCodeIdent.
     1168   end.
     1169   function GetTegCod return character
     1170   (icodeIdent as char, iTeg as char):
     1171      define variable Velement   as character no-undo init "first".
     1172      define variable oTeg as character no-undo init ?.
     1173      define variable vteg as character no-undo.
     1174      define variable vtegval as character no-undo.
     1175      if     ((length(icodeIdent) eq 21
     1176         and not icodeIdent begins "01"
     1177         and not icodeIdent begins "02")
     1178         or
     1179             ( length(icodeIdent) eq 25
     1180               and not icodeIdent begins "01"
     1181               and not icodeIdent begins "02"))
     1182      then do:
     1183         if iTeg eq "01" or iTeg eq "02"
     1184         then
     1185            oTeg = substring(icodeIdent,1,21).
     1186         else  if  iTeg eq "21"
     1187         then
     1188            oTeg = substring(icodeIdent,15,7).
     1189      end.
     1190      else do:
     1191         ChekTypeMarkByDm(icodeIdent).
     1192         block-teg:
     1193            do while Velement ne "" and icodeIdent ne "":
     1194            Velement = GetNextElement(yes,output vteg, output vtegval, input-output icodeIdent).
     1195            if    Velement begins iTeg
     1196               or Velement begins "(" + iTeg + ")"
     1197            then do:
     1198               oTeg = vtegval.
     1199               leave block-teg.
     1200            end.
     1201         end.
     1202      end.
     1203      return oTeg.
     1204   end.
     1205   function isOAD return logical
     1206   (icodeIdent as character):
     1207      return length(icodeIdent) > 18 and GetTegCod(icodeIdent,"37") ne ? and GetTegCod(icodeIdent,"02") ne ?.
     1208   end.
     1209   function isMark return logical
     1210   (icodeIdent as character):
     1211      define buffer buf_marking for ub.marking.
     1212      return can-find(first buf_marking where buf_marking.mark begins icodeIdent) or
     1213             (length(icodeIdent) > 20 and not isOAD(icodeIdent)).
     1214   end.
     1215   function addBracketForCode return character
     1216   (icodeIdent as char):
     1217      define variable Velement   as character no-undo init "first".
     1218      define variable oTeg as character no-undo.
     1219      define variable vteg as character no-undo.
     1220      define variable vtegval as character no-undo.
     1221      define buffer marking for ub.marking.
     1222      find first marking no-lock where
     1223                 marking.mark begins icodeIdent no-error.
     1224      if    not ChekTypeMarkByDm(icodeIdent)
     1225         or length(icodeIdent) le 24
     1226         or (avail marking and marking.unit-ext = "LEVEL2")
     1227      then
     1228         oTeg = icodeIdent.
     1229      else do:
     1230         if (  icodeIdent begins "01"
     1231            or icodeIdent begins "02"
     1232            ) and CheckGtin(substring (icodeIdent,3,14))
     1233            and substring (icodeIdent,17,2) eq "21"
     1234         then do:
     1235            mMRCCode = yes.
     1236            ChekTypeMarkByDm(icodeIdent).
     1237            block-teg:
     1238            do while Velement ne "" and icodeIdent ne "":
     1239               Velement = GetNextElement(no,output vteg, output vtegval, input-output icodeIdent).
     1240               if vteg ne ""
     1241               then
     1242                  oTeg = oTeg + "(" + vteg + ")" + vtegval .
     1243            end.
     1244            mMRCCode = no.
     1245         end.
     1246         else do:
     1247            oTeg = icodeIdent.
     1248         end.
     1249      end.
     1250      return oTeg.
     1251   end.
     1252   function getlevelByCodId return int
     1253   (iCode as char):
     1254      define variable vLength as int no-undo.
     1255      define variable vLevel  as int no-undo.
     1256      if not ChekTypeMarkByDM (icode) then return ?.
     1257      vLength = length(iCode).
     1258      if    vLength eq 18
     1259         or vLength eq 20
     1260      then
     1261         Vlevel = 4.
     1262      else if vLength eq 21
     1263      then
     1264         Vlevel = 1.
     1265      else if vLength eq 25
     1266      then do:
     1267         if  iCode begins "01"
     1268         then
     1269            Vlevel = 3.
     1270         else
     1271            Vlevel = 1.
     1272      end.
     1273      else if     vLength >= 26
     1274              and vLength <= 46
     1275      then do:
     1276         if    substring(iCode,17,2) eq "11"
     1277            or substring(iCode,17,2) eq "13"
     1278            or (    substring(iCode,17,2) eq "21"
     1279                and vLength >= 33
     1280                and substring(iCode,26,4) ne "8005")
     1281         then
     1282            Vlevel = 4.
     1283         else if    vLength eq 31
     1284                 or vLength eq 38
     1285                 or vLength eq 39
     1286                 or vLength eq 45
     1287         then
     1288            Vlevel = 1.
     1289         else if    vLength eq 35
     1290                 or vLength eq 43
     1291         then
     1292            Vlevel = 3.
     1293         else
     1294            Vlevel = ?.
     1295      end.
     1296      else
     1297         Vlevel = ?.
     1298      return Vlevel.
     1299   end.
     1300   function getLevelMotpBycodid return character
     1301   (iDm as char):
     1302      define variable vLevel as integer no-undo.
     1303      define variable vList as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     1304      vLevel = getlevelByCodId(iDm).
     1305      if    vLevel eq ?
     1306         or vLevel < 1
     1307         or vLevel > 6
     1308      then
     1309         return ?.
     1310      else
     1311         return entry(vlevel,vList).
     1312   end.
     1313   function getLevelUTDByLevelMotp return character
     1314   (iUnit as char):
     1315      define variable vLevel as integer no-undo.
     1316      define variable vListMOTP    as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     1317      define variable vListutd as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     1318      vLevel = lookup(iUnit,vListMOTP).
     1319      if    vLevel eq ?
     1320         or vLevel < 1
     1321         or vLevel > 4
     1322      then
     1323         return ?.
     1324      else
     1325         return entry(vlevel,vListutd).
     1326   end.
     1327   function getLevelMotpByDM return character
     1328   (iDm as char):
     1329      return getLevelMotpByCodId(GetCodeIdent(iDm)).
     1330   end.
     1331   function getLevelUTDByCodId return character
     1332   (iDm as char):
     1333      define variable vLevel as integer no-undo.
     1334      define variable vList as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     1335      vLevel = getlevelByCodId(iDm).
     1336      if    vLevel eq ?
     1337         or vLevel < 1
     1338         or vLevel > 4
     1339      then
     1340         return ?.
     1341      else
     1342         return entry(vlevel,vList).
     1343   end.
     1344   function getLevelUTDByDM return character
     1345   (iDm as char):
     1346      return getLevelUTDByCodId(GetCodeIdent(iDm)).
     1347   end.
     1348   define variable mNotMarkQnty as logical no-undo.
     1349   function getQntyUTDByCodId return decimal
     1350   (iDM as char):
     1351      define variable vLevel as integer no-undo.
     1352      define variable vList as character no-undo init "1,5,10,500".
     1353      define variable vGtin as character no-undo.
     1354      define variable vqnty as decimal no-undo init ?.
     1355      vqnty = dec(GetTegCod(iDM,"37")) no-error.
     1356      if vqnty eq ?
     1357      then do:
     1358         if not mNotMarkQnty
     1359         then do:
     1360            define buffer marking for ub.marking.
     1361            define variable vCodident as character no-undo.
     1362            vCodident = GetCodeIdent(idm).
     1363            find first marking where marking.mark begins vCodident no-lock no-error.
     1364            if     available marking
     1365               and marking.box-qnty ne ?
     1366            then
     1367               return marking.box-qnty.
     1368         end.
     1369         vGtin = getGtinByDm(iDM).
     1370         if ChekTypeMarkByGtin (vGtin)
     1371         then do:
     1372            vLevel = getlevelByCodId(iDM).
     1373            if     vLevel >= 1
     1374               and vLevel <= 4
     1375            then
     1376               vqnty = int(entry(vlevel,vList)).
     1377         end.
     1378         else
     1379            vqnty = getQntyCodeByGtin(vgtin).
     1380      end.
     1381      return vqnty.
     1382   end.
     1383   function getQntyUTDByDM return decimal
     1384   (iDm as char):
     1385      define variable vDM as character no-undo.
     1386      if     length (iDm) ne 25
     1387         and length (iDm) ne 29
     1388         and substring (iDm,length (iDm) - 6 + 1, 2 ) eq "93"
     1389      then
     1390         vDM = substring (iDm,1,length (iDm) - 6 ).
     1391      else
     1392         vDM = substring (iDm,1,length (iDm) - 4 ).
     1393      return getQntyUTDByCodId(vDM).
     1394   end.
     1395   function getMRC4 return decimal
     1396   (iMRC as char):
     1397      define variable oMrc     as decimal no-undo init ?.
     1398      define variable vAlphabet as character no-undo init "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!~"%&'*+-./_,:;=<>?".
     1399      define variable vi       as integer no-undo.
     1400      define variable vfound   as integer no-undo.
     1401      define variable vposStart   as integer no-undo.
     1402      do:
     1403      OMRc = 0.
     1404      do vi = 1 to 4:
     1405         define variable vsimb as character no-undo.
     1406         vsimb = substring(iMRC,vi,1).
     1407         vposStart = if keycode("Z") < keycode(vsimb) then 27 else 1.
     1408         vfound = index(vAlphabet,vsimb,vposStart) - 1.
     1409         if vfound > 0
     1410         then
     1411            OMRc = OMRc + exp (80,(4 - vi) ) * vfound  .
     1412         end.
     1413         OMRc = OMRc / 100.
     1414      end.
     1415      return OMRc.
     1416   end.
     1417   function getMRCByDM return decimal
     1418   (iDm as char):
     1419      define variable vMRC     as character no-undo.
     1420      define variable oMrc     as decimal no-undo init ?.
     1421      define variable Velement as character no-undo init "empty".
     1422      define variable vteg as character no-undo.
     1423      define variable vtegval as character no-undo.
     1424      if    length(idm) eq 14 + 7 + 4 + 4
     1425         or length(idm) eq 14 + 7 + 4
     1426      then do:
     1427         vMRC = substring(idm,22,4).
     1428         omrc = getMRC4(vMRC).
     1429      end.
     1430      else do:
     1431          ChekTypeMarkByDm(iDm).
     1432          block-mrc:
     1433          do while Velement ne "" and idm ne "":
     1434             Velement = GetNextElement(yes,output vteg, output vtegval, input-output idm).
     1435             if Velement begins "8005"
     1436             then do:
     1437                vMRC = substring(Velement,5,6).
     1438                leave block-mrc.
     1439             end.
     1440             else if Velement begins "(8005)"
     1441             then do:
     1442                vMRC = substring(Velement,7,6).
     1443                leave block-mrc.
     1444             end.
     1445          end.
     1446          if vMRC ne ""
     1447          then
     1448             OMRc = dec(vmrc) / 100 no-error.
     1449      end.
     1450      return OMRc.
     1451   end.
     1452   function MoveDate return Date
     1453   (idate as date,
     1454    iMonth as int64):
     1455      define variable vMonth   as int64 no-undo.
     1456      define variable vYear    as int64 no-undo.
     1457      define variable vDateNew as date  no-undo.
     1458       define variable vDay     as int64 no-undo.
     1459       vMonth = month(iDate) + iMonth.
     1460       vYear =  year(iDate).
     1461       if vMonth <= 0
     1462       then assign
     1463          vMonth = vMonth + 12
     1464           vYear  = vYear - 1
     1465       .
     1466       else if vMonth > 12
     1467       then assign
     1468          vMonth = vMonth - 12
     1469           vYear  = vYear + 1
     1470       .
     1471       vDateNew = date(vMonth,day(iDate),vYear) no-error.
     1472       do while error-status:error eq yes:
     1473          VDay = vDay + 1.
     1474          vDateNew = date(vMonth,day(iDate) - vDay,vYear) no-error.
     1475       end.
     1476       if VDay > 0
     1477       then
     1478          vDateNew + 1.
     1479       return vDateNew.
     1480   end.
     1481   procedure checkEMRC:
     1482   define input  parameter iDm as character no-undo.
     1483   define output parameter vok as logical   no-undo init yes.
     1484      define variable v-value-emrc as character no-undo.
     1485      define variable v-type-emrc  as character no-undo.
     1486      define variable vDateIso     as character no-undo.
     1487      define variable vMRC         as decimal no-undo.
     1488      define variable vqnty        as decimal no-undo.
     1489      define variable vPrice       as decimal no-undo.
     1490      define variable vparent      as character no-undo.
     1491      define variable vgds-code    as integer no-undo.
     1492      define buffer code for ub.code.
     1493      vMRC = getMRCByDM(iDm).
     1494      if vMRC > 0
     1495      then do:
     1496         vgds-code = getGdsCodeByDM(iDm).
     1497         vqnty     = getQntyUTDByDM(iDm).
     1498               if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     1499            (
     1500             input   vgds-code
     1501            ,input   'emrc-type':U
     1502            ,output   v-value-emrc
     1503            ,output   v-type-emrc
     1504          ) no-error.
     1505          if     v-value-emrc ne ""
     1506             and v-value-emrc ne ?
     1507          then do:
     1508             vDateIso = iso-date(today).
     1509             vPrice = vMRC / vqnty.
     1510             vparent ="emc" + chr(4) + v-value-emrc.
     1511             find last code where Code.parent      eq vparent
     1512                              and Code.code        le vDateIso
     1513                              and code.status_  eq 0
     1514             no-lock no-error.
     1515             if not available code or ( vPrice  >= dec(Code.CodeValue))
     1516             then
     1517                vOk = true .
     1518             else do:
     1519                 define variable vText      as character no-undo.
     1520                 define variable vDate      as date no-undo.
     1521                 define variable vDateLast  as character no-undo.
     1522                 define variable vDateFirst as character no-undo.
     1523                 define variable vDate3     as date no-undo.
     1524                 vdate = date(code.misc1).
     1525                 vDateLast = code.misc1.
     1526                 vDate3 = MoveDate(today, - 3 ).
     1527                 vText =  substitute ("ТОВАР ИМЕЕТ ОГРАНИЧЕННЫЙ СРОК РЕАЛИЗАЦИИ. Если товар произведен после &2, то его приемка и продажа запрещена.",
     1528                                      string(vDate3  , "99/99/9999"),
     1529                                      string(vDate   , "99/99/9999")
     1530                                      ).
     1531                 vdateIso = iso-date(vdate3).
     1532                 find last code  where Code.parent      eq vparent
     1533                                   and Code.code        le vDateIso
     1534                                   and code.status_  eq 0 no-lock no-error.
     1535                 if available code
     1536                 then
     1537                    vDateIso = code.code.
     1538                 vDateFirst = vDateIso.
     1539                 vDateLast = iso-date(vdate).
     1540                 define variable vGood as logical no-undo.
     1541                 define variable vDateSale as date no-undo.
     1542                 define buffer bcode for code.
     1543                 for last code where Code.parent   eq vparent
     1544                                 and code.status_  eq 0
     1545                                 and code.code     < vDateLast
     1546                                 and code.code     >= vDateFirst
     1547                 no-lock:
     1548                    find first bcode where bCode.parent   eq vparent
     1549                                       and bcode.status_  eq 0
     1550                                       and bcode.code     > code.code no-lock no-error.
     1551                    if available bcode
     1552                    then do:
     1553                       if vPrice < dec(Code.CodeValue)
     1554                       then
     1555                          vText = vtext + substitute ("&1Если товар произведен с &2 до &3, ТО ЕГО ПРИЕМКА И ПРОДАЖА ЗАПРЕЩЕНА",
     1556                                                     chr(10),
     1557                                                     string(    date( code.misc1)       ,"99/99/9999"),
     1558                                                     string(    date(bcode.misc1)       ,"99/99/9999")
     1559                                                     ).
     1560                       else do:
     1561                          vGood = yes.
     1562                          vDateSale = MoveDate(date(bcode.misc1), 3) - 1.
     1563                          vText = vtext + substitute ("&1Если товар произведен до &3, то продажа разрешена до &4.~Осталось &5 дней.",
     1564                                                     chr(10),
     1565                                                     string(    date( code.misc1)         ,"99/99/9999"),
     1566                                                     string(    date(bcode.misc1)         ,"99/99/9999"),
     1567                                                     string(         vDateSale            ,"99/99/9999"),
     1568                                                     string(vDateSale - today)
     1569                                                     ).
     1570                       end.
     1571                    end.
     1572                 end.
     1573                 if vgood
     1574                 then do:
     1575                    define variable choice as integer no-undo .
     1576                    run gbl/d-askw.w (input "Уточнение"
     1577                           ,input  vText
     1578                           ,input "|"
     1579                           ,input "Принять|Вернуть"
     1580                           ,input "Принять данный товар|Вернуть товар постащику"
     1581                           ,input 1
     1582                           ,input 2
     1583                           ,output choice) no-error.
     1584                    vok = choice eq 1.
     1585                 end.
     1586                 else
     1587                    vok =false.
     1588             end.
     1589          end.
     1590      end.
     1591   end.
     1592   function addGs2Mark return character
     1593   (iMark as char):
     1594      define variable vDM   as character no-undo.
     1595      define variable vIdx  as integer   no-undo.
     1596      if index(iMark,chr(29),1) > 0
     1597      then return iMark.
     1598      if substring(iMark,26,4) = "8005" then
     1599      do:
     1600        vIdx = index(iMark,"93",26 + 4 + 5).
     1601        if vIdx > 1 then do:
     1602          vDM = substitute("&1&4&2&4&3",
     1603                           substring(iMark,1,25),
     1604                           substring(iMark,26,vIdx - 25 - 1),
     1605                           substring(iMark,vIdx),
     1606                           chr(29)) no-error.
     1607          vIdx = index(vDm,"240",vIdx + 4).
     1608          if vIdx > 0 then
     1609          do:
     1610            vDM = substitute("&1&3&2",
     1611                             substring(vDm,1,vIdx - 1),
     1612                             substring(vDm,vIdx),
     1613                             chr(29)) no-error.
     1614          end.
     1615        end.
     1616        else
     1617          vDM = substitute("&1&3&2",
     1618                           substring(iMark,1,25),
     1619                           substring(iMark,26),
     1620                           chr(29)) no-error.
     1621      end.
     1622      else if substring(iMark,32,2) = "91" then
     1623      do:
     1624        vIdx = index(iMark,"92",32).
     1625        if vIdx > 1 then
     1626          vDM = substitute("&1&4&2&4&3",
     1627                           substring(iMark,1,31),
     1628                           substring(iMark,32,vIdx - 31 - 1),
     1629                           substring(iMark,vIdx),
     1630                           chr(29)) no-error.
     1631        else
     1632          vDM = substitute("&1&3&2",
     1633                           substring(iMark,1,31),
     1634                           substring(iMark,32),
     1635                           chr(29)) no-error.
     1636      end.
     1637      else if substring(iMark,39,2) = "91" then
     1638      do:
     1639        vIdx = index(iMark,"92",38).
     1640        if vIdx > 1 then
     1641          vDM = substitute("&1&4&2&4&3",
     1642                           substring(iMark,1,38),
     1643                           substring(iMark,39,vIdx - 38 - 1),
     1644                           substring(iMark,vIdx),
     1645                           chr(29)) no-error.
     1646        else
     1647          vDM = substitute("&1&3&2",
     1648                           substring(iMark,1,38),
     1649                           substring(iMark,39),
     1650                           chr(29)) no-error.
     1651      end.
     1652      else if substring(iMark,25,2) = "93" then
     1653      do:
     1654        vIdx = index(iMark,"92",25).
     1655        if vIdx > 1 then
     1656          vDM = substitute("&1&4&2&4&3",
     1657                           substring(iMark,1,24),
     1658                           substring(iMark,25,vIdx - 24 - 1),
     1659                           substring(iMark,vIdx),
     1660                           chr(29)) no-error.
     1661        else
     1662          vIdx = index(iMark,"3103",25).
     1663          if vIdx > 0 then
     1664          vDM = substitute("&1&4&2&4&3",
     1665                           substring(iMark,1,24),
     1666                           substring(iMark,25,vIdx - 24 - 1),
     1667                           substring(iMark,vIdx),
     1668                           chr(29)) no-error.
     1669          else
     1670            vDM = substitute("&1&3&2",
     1671                             substring(iMark,1,24),
     1672                             substring(iMark,25),
     1673                             chr(29)) no-error.
     1674      end.
     1675      else if substring(iMark,32,2) = "93" then
     1676      do:
     1677        vDM = substitute("&1&3&2",
     1678              substring(iMark,1,31),
     1679              substring(iMark,32),
     1680              chr(29)) no-error.
     1681      end.
     1682      return if vDM <> "" then vDm else iMark.
     1683   end.
     1684   FUNCTION MonthNameRusCase RETURNS CHARACTER ( INPUT i-month AS INTEGER, INPUT i-case AS INTEGER ) :
     1685     DEFINE VARIABLE v-name AS CHARACTER NO-UNDO.
     1686     RUN get-month-name-case IN THIS-PROCEDURE ( INPUT i-month, INPUT i-case, OUTPUT v-name ) NO-ERROR.
     1687     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE v-name ).
     1688   END FUNCTION.
     1689   PROCEDURE get-month-name-case :
     1690     DEFINE  INPUT PARAMETER p-month AS INTEGER   NO-UNDO.
     1691     DEFINE  INPUT PARAMETER p-case  AS INTEGER   NO-UNDO.
     1692     DEFINE OUTPUT PARAMETER p-name  AS CHARACTER NO-UNDO.
     1693     DEFINE VARIABLE v-list AS CHARACTER NO-UNDO EXTENT 6 INITIAL
     1694       [ "Январь,Февраль,Март,Апрель,Май,Июнь,Июль,Август,Сентябрь,Октябрь,Ноябрь,Декабрь",
     1695         "января,февраля,марта,апреля,мая,июня,июля,августа,сентября,октября,ноября,декабря",
     1696         "Январю,Февралю,Марту,Апрелю,Маю,Июню,Июлю,Августу,Сентябрю,Октябрю,Ноябрю,Декабрю",
     1697         "Январь,Февраль,Март,Апрель,Май,Июнь,Июль,Август,Сентябрь,Октябрь,Ноябрь,Декабрь",
     1698         "Январем,Февралем,Мартом,Апрелем,Маем,Июнем,Июлем,Августом,Сентябрем,Октябрем,Ноябрем,Декабрем",
     1699         "Январе,Феврале,Марте,Апреле,Мае,Июне,Июле,Августе,Сентябре,Октябре,Ноябре,Декабре"              ].
     1700     DO ON ERROR UNDO, RETURN ERROR :
     1701       IF p-month < 1 OR p-month > 12 OR
     1702          p-case  < 1 OR p-case  >  6 THEN DO:
     1703         ASSIGN p-name = ?.
     1704       END.                           ELSE DO:
     1705         ASSIGN p-name = ENTRY( p-month, v-list[ p-case ] ).
     1706       END.
     1707     END.
     1708   END PROCEDURE.
     1709   define stream Out-Stream.
     1710   define stream OutStr-html.
     1711   define VARIABLE p-report-id         as character no-undo .
     1712   define variable v-file-name-rep-htm as character no-undo .
     1713   define variable v-files as character no-undo .
     1714   define variable v-date              as character no-undo .
     1715   define variable v-utd-date          as character no-undo .
     1716   define variable ii                  as integer   no-undo .
     1717   def    var      Marking             as class     mark no-undo .
     1718   define buffer buf_utd               for ub.utd .
     1719   define buffer buf_utd-err           for ub.utd-err .
     1720   define buffer buf_utd-lines         for ub.utd-lines .
     1721   do
     1722   on error undo, return error return-value
     1723   :
     1724     run get-DD-Month-YYYY(date(today), output v-date) .
     1725     do ii = 1 to num-entries(p-rec-list) :
     1726       run printDoc (input entry(ii, p-rec-list)) .
     1727     end .
     1728     v-files = trim(v-files, " ") .
     1729     run prn-lib-reportviewer in this-procedure (
     1730         input this-procedure
     1731         ,input v-files
     1732         ,input ""
     1733         ) no-error.
     1734     if error-status:error then
     1735     do:
     1736         message return-value view-as alert-box.
     1737         return .
     1738     end.
     1739   end .
     1740   procedure printDoc :
     1741     define input parameter p-row-str as character no-undo .
     1742     define variable v-reason as character no-undo .
     1743     find first buf_utd no-lock where rowid(buf_utd) = to-rowid(p-row-str) no-error .
     1744     if not available (buf_utd) then
     1745     do:
     1746       return .
     1747     end.
     1748     v-reason = getattrUtd(input buf_utd.db-num, input buf_utd.doc-id, input "LK_RECEIPT_Action") .
     1749     case v-reason :
     1750       when "PRODUCTION_USE" then v-reason = "Использование для производственных целей" .
     1751       when "LOSS" then v-reason = "Утрата" .
     1752       when "DESTRUCTION" then v-reason = "Уничтожение" .
     1753       otherwise do :
     1754         v-reason = "Неизвестна" .
     1755       end .
     1756     end case .
     1757     run get-DD-Month-YYYY(buf_utd.DocumentDate, output v-utd-date) .
     1758     run get-report-num (output p-report-id).
     1759     v-file-name-rep-htm = session:temp-directory + string(p-report-id) + ".html" .
     1760     v-files = v-files + session:temp-directory + string(p-report-id) + ".html " .
     1761     output stream OutStr-html to value(v-file-name-rep-htm) convert target 'UTF-8'.
     1762     put stream OutStr-html unformatted
     1763       "<!DOCTYPE HTML>" skip
     1764       ' <html>' skip
     1765       '  <head>' skip
     1766       '   <meta charset="utf-8">' skip
     1767       '    <style type="text/css">' skip
     1768       '      table ' + chr(123) + ' border-collapse: collapse; ' + chr(125) skip
     1769       '      .class1 ' + chr(123) + ' border-collapse: collapse; ' + chr(125) skip
     1770       '      tbody td, th ' + chr(123) + ' border-collapse: collapse; border: 1px solid black; height: 14px;' + chr(125) skip
     1771       '   </style>' skip
     1772       '  </head>' skip
     1773     .
     1774     put stream OutStr-html unformatted
     1775       '<body>' skip
     1776       '<TABLE name="1"  fit_to_page="true" orientation="portrait" CELLSPACING="0" BORDER="0">'skip
     1777       '<thead>' skip
     1778     .
     1779     put stream OutStr-html unformatted
     1780       '<tr>' skip
     1781       '<td style="width: 80px;"></td>' skip
     1782       '<td style="width: 450px;"></td>' skip
     1783       '<td style="width: 200px;"></td>' skip
     1784       '<td style="width: 120px;"></td>' skip
     1785       '</tr>' skip
     1786     .
     1787     if buf_utd.documentExt > ""
     1788     then do :
     1789       put stream OutStr-html unformatted
     1790         '<tr><td colspan="4" style="text-align: left; font-weight: bold;">Вн. № ' + string(buf_utd.documentExt) + '</td></tr>'
     1791       .
     1792     end .
     1793     put stream OutStr-html unformatted
     1794       '<tr><td colspan="4" style="text-align: left; font-weight: bold;">Первичный документ ' + string(buf_utd.doc-code) + '</td></tr>'
     1795       '<tr><td colspan="4" style="text-align: left; font-weight: bold;">Закрыт ' + string(v-utd-date) + '</td></tr>'
     1796       '<tr><td colspan="4" style="text-align: left; font-weight: bold;">Причина: ' + string(v-reason) + '</td></tr>'
     1797     .
     1798     if can-find(first buf_utd-err no-lock where buf_utd-err.db-num = buf_utd.db-num and buf_utd-err.doc-id = buf_utd.doc-id)
     1799     then do :
     1800       put stream OutStr-html unformatted
     1801         '<tr><td colspan="4" style="text-align: left; font-weight: bold;">Ошибки:</td></tr>'
     1802       .
     1803     end .
     1804     for each buf_utd-err no-lock where buf_utd-err.db-num = buf_utd.db-num
     1805                                    and buf_utd-err.doc-id = buf_utd.doc-id
     1806     :
     1807       put stream OutStr-html unformatted
     1808         '<tr><td colspan="4" style="text-align: left;">' + buf_utd-err.CheckObj + '</td></tr>'
     1809       .
     1810     end .
     1811     put stream OutStr-html unformatted
     1812       '<tr><td colspan="4"></td></tr>'
     1813       '</thead>' skip
     1814       '<tbody>' skip
     1815     .
     1816     put stream OutStr-html unformatted
     1817       '<TR>' skip
     1818       '<TD text_wrap="true" style="text-align: center; font-weight: bold;">№ п/п</TD>' skip
     1819       '<TD text_wrap="true" style="text-align: center; font-weight: bold;">Наименование товара</TD>' skip
     1820       '<TD text_wrap="true" style="text-align: center; font-weight: bold;">GTIN</TD>' skip
     1821       '<TD text_wrap="true" style="text-align: center; font-weight: bold;">Количество</TD>' skip
     1822       '</TR>' skip
     1823     .
     1824     for each buf_utd-lines no-lock where buf_utd-lines.db-num = buf_utd.db-num
     1825                                      and buf_utd-lines.doc-id = buf_utd.doc-id
     1826                                      by buf_utd-lines.linenum
     1827     :
     1828       put stream OutStr-html unformatted
     1829         '<TR>' skip
     1830         '<TD text_wrap="true" style="text-align: left;">' + string(buf_utd-lines.linenum) + '</TD>' skip
     1831         '<TD text_wrap="true" style="text-align: left;">' + string(buf_utd-lines.GdsName) + '</TD>' skip
     1832         '<TD text_wrap="true" style="text-align: left;">' + string (buf_utd-lines.ProductCode) + '</TD>' skip
     1833         '<TD text_wrap="true" style="text-align: right;">' + string (buf_utd-lines.Quantity) + '</TD>' skip
     1834         '</TR>'
     1835       .
     1836     end .
     1837     put stream OutStr-html unformatted
     1838       '</tbody>' skip
     1839       '</table>' skip
     1840       '</body>' skip
     1841       '</html>' skip
     1842     .
     1843     output stream OutStr-html close.
     1844   end procedure .
     1845   procedure get-DD-Month-YYYY:
     1846     define input parameter p-dat-date as date no-undo.
     1847     define output parameter p-str-date as character no-undo.
     1848     define variable v-str-date  as character no-undo.
     1849     define variable v-str-day   as character no-undo.
     1850     define variable v-num-month as character no-undo.
     1851     define variable v-str-month as character no-undo.
     1852     define variable v-str-year  as character no-undo.
     1853     v-str-date = string(p-dat-date).
     1854     do:
     1855       v-str-day = string(entry(1, v-str-date, "/")).
     1856     end.
     1857     do:
     1858       v-num-month = entry(2, v-str-date, "/").
     1859       v-str-month = MonthNameRusCase(integer(v-num-month), 2).
     1860     end.
     1861     do:
     1862       v-str-year = string(year(p-dat-date)).
     1863     end.
     1864     p-str-date = '" ' + v-str-day + ' "' + " " + v-str-month + " " + v-str-year + " г.".
     1865   end procedure.
