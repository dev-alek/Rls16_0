      424   function setattrUtdMarkingLines returns logical
      425   (idb-num   as integer,
      426    idoc-id   as integer,
      427    ilinenum  as integer,
      428    imark     as character,
      429    iattrcode as character,
      430    iattrval  as character ):
      431      define buffer utd-marking-lines-attr for utd-marking-lines-attr.
      432      find first utd-marking-lines-attr where utd-marking-lines-attr.db-num    eq idb-num
      433                                          and utd-marking-lines-attr.doc-id    eq idoc-id
      434                                          and utd-marking-lines-attr.lineNum   eq ilineNum
      435                                          and utd-marking-lines-attr.mark      eq imark
      436                                          and utd-marking-lines-attr.attr-code eq iattrcode
      437      no-lock no-error.
      438      if not available utd-marking-lines-attr
      439      then do:
      440         if iattrval ne ?
      441            and iattrval ne ""
      442         then do:
      443            create utd-marking-lines-attr.
      444            assign
      445               utd-marking-lines-attr.db-num     = idb-num
      446               utd-marking-lines-attr.doc-id     = idoc-id
      447               utd-marking-lines-attr.lineNum    = ilineNum
      448               utd-marking-lines-attr.mark       = imark
      449               utd-marking-lines-attr.attr-code  = iattrcode
      450               utd-marking-lines-attr.attr-value = iattrval
      451            .
      452         end.
      453      end.
      454      else do:
      455         if utd-marking-lines-attr.attr-value ne iattrval
      456         then do:
      457            find current utd-marking-lines-attr exclusive-lock no-error.
      458            if available utd-marking-lines-attr
      459            then do:
      460               if    iattrval eq ?
      461                  or iattrval eq ""
      462               then do:
      463                  delete utd-marking-lines-attr.
      464               end.
      465               else do:
      466                  utd-marking-lines-attr.attr-value = iattrval.
      467               end.
      468            end.
      469         end.
      470      end.
      471      release utd-marking-lines-attr.
      472   end.
