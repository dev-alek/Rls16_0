      283   def var vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      284   function getattrUtdex returns char
      285   (idb-num   as integer,
      286    idoc-id   as integer,
      287    iattrcode as character,
      288    iExValue  as character  ):
      289      define buffer utd-attr for utd-attr.
      290      find first utd-attr where utd-attr.db-num eq idb-num
      291                            and utd-attr.doc-id eq idoc-id
      292                            and utd-attr.attr-code eq iattrcode
      293      no-lock no-error.
      294      return if not available utd-attr  then iExValue    else  utd-attr.attr-value.
      295   end.
      296   function getattrUtd returns char
      297   (idb-num   as integer,
      298    idoc-id   as integer,
      299    iattrcode as character ):
      300     return getattrUtdex(idb-num,idoc-id,iattrcode,?).
      301   end.
      302   function setattrUtd returns logical
      303   (idb-num   as integer,
      304    idoc-id   as integer,
      305    iattrcode as character,
      306    iattrval  as character ):
      307      define buffer utd-attr for utd-attr.
      308      find first utd-attr where utd-attr.db-num eq idb-num
      309                            and utd-attr.doc-id eq idoc-id
      310                            and utd-attr.attr-code eq iattrcode
      311      no-lock no-error.
      312      if not available utd-attr
      313      then do:
      314         create utd-attr.
      315         assign
      316            utd-attr.db-num    = idb-num
      317            utd-attr.doc-id    = idoc-id
      318            utd-attr.attr-code = iattrcode
      319            utd-attr.attr-value = iattrval
      320         .
      321      end.
      322      else do:
      323         if utd-attr.attr-value ne iattrval
      324         then do:
      325            find current utd-attr exclusive-lock no-error.
      326            if available utd-attr
      327            then
      328               utd-attr.attr-value = iattrval.
      329         end.
      330      end.
      331      release utd-attr.
      332   end.
      333   function GetAttrUtdlinesEx returns char
      334   (idb-num   as integer,
      335    idoc-id   as integer,
      336    ilinenum  as integer,
      337    iattrcode as character,
      338    iExValue  as character  ):
      339      define buffer utd-lines-attr for utd-lines-attr.
      340      find first utd-lines-attr where utd-lines-attr.db-num    eq idb-num
      341                                  and utd-lines-attr.doc-id    eq idoc-id
      342                                  and utd-lines-attr.lineNum   eq ilineNum
      343                                  and utd-lines-attr.attr-code eq iattrcode
      344      no-lock no-error.
      345      return if not available utd-lines-attr  then iExValue    else  utd-lines-attr.attr-value.
      346   end.
      347   function GetAttrUtdlines returns char
      348   (idb-num   as integer,
      349    idoc-id   as integer,
      350    ilinenum  as integer,
      351    iattrcode as character ):
      352      return GetAttrUtdlinesex (idb-num,idoc-id,ilinenum,iattrcode,?).
      353   end.
      354   function setattrUtdlines returns logical
      355   (idb-num   as integer,
      356    idoc-id   as integer,
      357    ilinenum  as integer,
      358    iattrcode as character,
      359    iattrval  as character ):
      360      define buffer utd-lines-attr for utd-lines-attr.
      361      find first utd-lines-attr where utd-lines-attr.db-num    eq idb-num
      362                                  and utd-lines-attr.doc-id    eq idoc-id
      363                                  and utd-lines-attr.lineNum   eq ilineNum
      364                                  and utd-lines-attr.attr-code eq iattrcode
      365      no-lock no-error.
      366      if not available utd-lines-attr
      367      then do:
      368         if iattrval ne ?
      369            and iattrval ne ""
      370         then do:
      371            create utd-lines-attr.
      372            assign
      373               utd-lines-attr.db-num    = idb-num
      374               utd-lines-attr.doc-id    = idoc-id
      375               utd-lines-attr.lineNum   = ilineNum
      376               utd-lines-attr.attr-code = iattrcode
      377               utd-lines-attr.attr-value = iattrval
      378            .
      379         end.
      380      end.
      381      else do:
      382         if utd-lines-attr.attr-value ne iattrval
      383         then do:
      384            find current utd-lines-attr exclusive-lock no-error.
      385            if available utd-lines-attr
      386            then do:
      387               if    iattrval eq ?
      388                  or iattrval eq ""
      389               then do:
      390                  delete utd-lines-attr.
      391               end.
      392               else do:
      393                  utd-lines-attr.attr-value = iattrval.
      394               end.
      395            end.
      396         end.
      397      end.
      398      release utd-lines-attr.
      399   end.
      400   function GetAttrUtdMarkingLinesEx returns char
      401   (idb-num   as integer,
      402    idoc-id   as integer,
      403    ilinenum  as integer,
      404    imark     as character,
      405    iattrcode as character,
      406    iExValue  as character  ):
      407      define buffer utd-marking-lines-attr for utd-marking-lines-attr.
      408      find first utd-marking-lines-attr where utd-marking-lines-attr.db-num    eq idb-num
      409                                          and utd-marking-lines-attr.doc-id    eq idoc-id
      410                                          and utd-marking-lines-attr.lineNum   eq ilineNum
      411                                          and utd-marking-lines-attr.mark      eq imark
      412                                          and utd-marking-lines-attr.attr-code eq iattrcode
      413      no-lock no-error.
      414      return if not available utd-marking-lines-attr  then iExValue    else  utd-marking-lines-attr.attr-value.
      415   end.
      416   function GetAttrUtdMarkingLines returns char
      417   (idb-num   as integer,
      418    idoc-id   as integer,
