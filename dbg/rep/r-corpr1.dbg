     6862   procedure prn-lib-open-stream :
     6863     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     6864     define input parameter p-page-size    as integer no-undo .
     6865     define input parameter p-is-stream    as logical no-undo .
     6866     define input parameter p-append       as logical no-undo .
