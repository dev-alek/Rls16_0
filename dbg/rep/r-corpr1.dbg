     6440             assign
     6441               varlastcur-base     = varprice-sale
     6442               varlastcur-road-tax = varroad-tax
     6443               varlastcur-excise   = varexcise
     6444               varcur-base         = varcur-base      + varprice-sale * bf_gds-dtl.fact-qnty
     6445               varcur-road-tax     = varcur-road-tax  + varroad-tax   * bf_gds-dtl.fact-qnty
