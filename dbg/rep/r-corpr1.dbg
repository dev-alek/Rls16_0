     7558          Pg-tqnty       @ gds-prop.qnty
     7559          Pg-sum-no-VAT @ gds-prop.sum-no-VAT
     7560          Pg-VAT-gds     @ gds-prop.VAT
     7561          Pg-stoim       @ gds-prop.stoim
     7562       with frame f-doc-m .
     7563       down stream PrnLibStream 1 with frame f-doc-m .
     7564       page stream PrnLibStream .
     7565       if page-number( PrnLibStream ) > prevpage then  assign  Pg-tqnty = 0  Pg-VAT-gds = 0   Pg-sum-no-VAT = 0  Pg-stoim = 0   .
     7566     end.
     7567     hide stream PrnLibStream frame BottomFrame .
     7568     put stream PrnLibStream v-single-line format "x(198)" skip.
     7569     display stream PrnLibStream
     7570       "Итого"           @ gds-prop.gds-name
     7571        Pg-tqnty         @ gds-prop.qnty
     7572        Pg-sum-no-VAT   @ gds-prop.sum-no-VAT
     7573        Pg-VAT-gds       @ gds-prop.VAT
     7574        Pg-stoim         @ gds-prop.stoim
     7575     with frame f-doc-m .
     7576     down stream PrnLibStream 1 with frame f-doc-m .
     7577     display stream PrnLibStream
     7578           "Всего по накладной"               @ gds-prop.gds-name
     7579           all-tqnty          @ gds-prop.qnty
     7580           all-sum-no-VAT    @ gds-prop.sum-no-VAT
     7581           all-VAT-gds        @ gds-prop.VAT
     7582           all-stoim          @ gds-prop.stoim
     7583     with frame f-doc-m .
     7584     down stream PrnLibStream 2 with frame f-doc-m .
     7585     if x-SET_val_TYPE = 1 then  run rep/wp-rub.p ( all-sum , output s1, output s2 ) .
     7586     else               run rep/wp.p ( ParParentProc, all-sum , output s1, output s2 ) .
     7587     run rep/wp-qnty.p ( input ( v-doc-line-counter - 1 ), output txt-LC).
     7588     put stream PrnLibStream
     7589       space(10) "  Всего на сумму:        "
     7590       trim( string( all-sum , "->>>,>>>,>>>,>>>,>>9.99") ) format "X(25)"
     7591       " (" trim( (  if x-SET_val_TYPE = 1 then "РУБ" else base-type ) ) format "X(6)" ")"
     7592     .
     7593     put stream PrnLibStream skip space(15) string( "В том числе: " ) format "X(160)" skip .
     7594     if v-tax-sum <> 0 then do:
     7595       put stream PrnLibStream space(21) v-tax-name + ":" + fill(" ", 1) + trim(string(v-tax-sum, "->>>,>>>,>>>,>>>,>>9.99"))
     7596                          + " (" + trim( ( if x-SET_val_TYPE = 1 then "РУБ" else base-type ) ) + ")" format "X(160)"  .
     7597     end.
     7598       define variable v-doc-places    as character    no-undo.
     7599   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input tdoc-code ,
     7600                           input 'QntyPlace':U ,
     7601                          output v-doc-places ,
     7602                          output v-attr-type )  .
     7603       if v-doc-places = "":U
     7604       then do:
     7605           assign
     7606               v-doc-places = v-underline
     7607           .
     7608       end.
     7609     put stream PrnLibStream  skip
     7610       space(30) string( "НДС: " + trim( string( all-VAT-gds, "->>>,>>>,>>>,>>>,>>9.99") ) +
     7611                                   " (" + trim( ( if x-SET_val_TYPE = 1 then "РУБ" else base-type ) ) + ")" ) format "X(160)" skip(2)
     7612       space(10) string( "Товарная накладная имеет приложение на " + v-underline ) format "X(125)" skip
     7613       space(10) string( "и содержит " + CAPS( txt-LC ) + " порядковый(ых) номер(ов) записей") format "X(180)" skip
     7614       v-underline format "X(29)" at 151 skip
     7615       string( "Масса груза (нетто) " + v-underline ) format "X(85)" at 60 string( "|" + v-underline ) format "X(30)" at 150 "|" skip
     7616       space(10) string( "Всего мест " + v-doc-places ) format "X(45)" string( "Масса груза (брутто) " + v-underline ) format "X(85)" at 60
     7617               string( "|" + v-underline ) format "X(30)" at 150 "|" skip(1)
     7618       string( "Приложение (паспорта, сертификаты, и т.д.) на " + string( v-underline, "X(42)" ) + " листах" ) format "X(95)" "|" at 97
     7619           string( "По доверенности N " + string( v-underline, "X(39)" ) + " от " + v-underline ) format "X(100)" at 99 skip
     7620       "Всего отпущено на сумму " format "X(95)" "|" at 97 string( "выданной " + v-underline ) format "X(100)" at 99 skip
     7621       space(2) CAPS(s1) format "X(93)" "|" at 97 skip
     7622     .
     7623       put stream PrnLibStream
     7624           string( "Отпуск разрешил " + v-underline ) format "X(95)" "|" at 97
     7625           skip "|" at 97 string( "Груз принял " + v-underline ) format "X(100)" at 99
     7626           skip v-underline format "X(95)" "|" at 97 string( "Груз получил грузополучатель " + v-underline ) format "X(100)" at 99
     7627           skip "М.П." at 15  "|" at 97 "М.П." at 99
     7628       .
     7629   if session :set-wait-state( "" ) then.
     7630     output stream PrnLibStream close.
     7631     run prn-lib-prn-file in this-procedure (input my-handle,input 8).
     7632   end.
     7633   procedure print-line :
     7634     do on error undo, return error :
     7635       if FullGdsName then do:
     7636         gds-str1 = breakstr(gds-prop.gds-name, 52, input-output gds-str1, input-output gds-str2).
     7637         assign v-char-counter = 0.
     7638         do while gds-str2 <> "" :
     7639           assign
     7640             gds-str = gds-str2
     7641             gds-str1 = breakstr(gds-str, 52, input-output gds-str1, input-output gds-str2)
     7642             v-char-counter = v-char-counter + 1
     7643           .
     7644         end.
     7645         if line-counter( PrnLibStream ) + v-char-counter > page-size( PrnLibStream )  then do:
     7646           put stream PrnLibStream v-single-line format "x(198)" skip.
     7647           display stream PrnLibStream
     7648             "Итого"           @ gds-prop.gds-name
     7649              Pg-tqnty         @ gds-prop.qnty
     7650              Pg-sum-no-VAT   @ gds-prop.sum-no-VAT
     7651              Pg-VAT-gds       @ gds-prop.VAT
     7652              Pg-stoim         @ gds-prop.stoim
     7653           with frame f-doc-m .
     7654           down stream PrnLibStream 1 with frame f-doc-m .
     7655           PAGE stream PrnLibStream.
     7656           if page-number( PrnLibStream ) > prevpage then  assign  Pg-tqnty = 0  Pg-VAT-gds = 0   Pg-sum-no-VAT = 0  Pg-stoim = 0   .
     7657         end.
     7658         assign
     7659           gds-str1 = breakstr(gds-prop.gds-name, 52, input-output gds-str1, input-output gds-str2)
     7660         .
     7661       end.
     7662       else  assign gds-str1 = gds-prop.gds-name  .
     7663       display stream PrnLibStream
     7664         v-doc-line-counter
     7665         gds-prop.artic
     7666         gds-str1          @ gds-prop.gds-name
     7667         string( gds-prop.b-code )   @ tb-code
     7668         gds-prop.unit-base
     7669         gds-prop.qnty
     7670         gds-prop.price-no-VAT
     7671         gds-prop.sum-no-VAT
     7672         gds-prop.VAT-pc
     7673         gds-prop.VAT
     7674         gds-prop.stoim
     7675         sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12 sym13 sym14 sym15 sym16 sym19
     7676       with frame f-doc-m.
     7677       down stream PrnLibStream 1 with frame f-doc-m.
     7678       if FullGdsName then do:
     7679         do while gds-str2 <> "" :
     7680           assign
     7681             gds-str = gds-str2
     7682             gds-str1 = breakstr(gds-str, 52, input-output gds-str1, input-output gds-str2)
     7683           .
     7684           display stream PrnLibStream
     7685             gds-str1 @ gds-prop.gds-name sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12 sym13 sym14 sym15 sym16 sym19
     7686           with frame f-doc-m .
     7687           down stream PrnLibStream 1 with frame f-doc-m .
     7688         end.
     7689       end.
     7690       assign
     7691         v-line-counter     = v-line-counter + 1
     7692         v-doc-line-counter = v-doc-line-counter + 1
     7693         PrevPage = page-number( PrnLibStream )
     7694         Pg-tqnty       = Pg-tqnty       + gds-prop.qnty
     7695         Pg-VAT-gds     = Pg-VAT-gds     + gds-prop.VAT
     7696         Pg-sum-no-VAT = Pg-sum-no-VAT + gds-prop.sum-no-VAT
     7697         Pg-stoim       = Pg-stoim       + gds-prop.stoim
     7698         all-tqnty       = all-tqnty       + gds-prop.qnty
     7699         all-sum-no-VAT = all-sum-no-VAT + gds-prop.sum-no-VAT
     7700         all-VAT-gds     = all-VAT-gds     + gds-prop.VAT
     7701         all-stoim       = all-stoim       + gds-prop.stoim
     7702         all-sum         = all-sum         + gds-prop.sum
     7703       .
     7704       if line-counter( PrnLibStream ) + 1 > page-size( PrnLibStream ) then do:
     7705         put stream PrnLibStream v-single-line format "x(198)" skip.
     7706         display stream PrnLibStream
     7707           "Итого"   @ gds-prop.gds-name
     7708            Pg-tqnty @ gds-prop.qnty
     7709            Pg-sum-no-VAT @ gds-prop.sum-no-VAT
     7710            Pg-VAT-gds  @ gds-prop.VAT
     7711            Pg-stoim @ gds-prop.stoim
     7712         with frame f-doc-m .
     7713         down stream PrnLibStream 1 with frame f-doc-m .
     7714         if page-number( PrnLibStream ) > prevpage then  assign  Pg-tqnty = 0  Pg-VAT-gds = 0   Pg-sum-no-VAT = 0  Pg-stoim = 0   .
     7715       end.
     7716     end.
     7717   end procedure.
