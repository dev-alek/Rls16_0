     7087               gds-prop.prod-code = buf_goods.prod-code
     7088               gds-prop.gds-code  = buf_goods.gds-code
     7089               gds-prop.gds-name  = buf_goods.gds-name
     7090               gds-prop.grp-name  = buf_goods.grp-name
     7091               gds-prop.unit-base = buf_goods.unit-base
     7092               gds-prop.part-code = parts-root.part-code
     7093               gds-prop.in-code   = parts-root.in-code
     7094               gds-prop.VAT-pc    = buf_parts.VAT-pc
