     2134   procedure torgconf-get-warrant-wth:
     2135   define input parameter p-torgconfdoc-code           as character                  no-undo.
     2136       define variable p-torgconf-ndovwho-type         as character no-undo.
     2137       define variable p-torgconf-accept-n-type        as character no-undo.
     2138   if valid-handle( g#wthcalib ) <> yes then do:       run str/wthcalib.p persistent no-error.       if error-status :error or valid-handle( g#wthcalib ) <> yes then do:         message "Error starting wthcalib.p"    skip( 0 )                 g#wthcalib                     skip( 0 )                 g#wthcalib   :type             skip( 0 )                 g#wthcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run wthcalib_wthat-val in g#wthcalib (  input p-torgconfdoc-code ,
     2139                           input 'wthproxy':U ,
     2140                          output p-torgconf-ndovwho ,
     2141                          output p-torgconf-ndovwho-type ) no-error .
     2142         if error-status :error then do:
     2143         message
     2144            vss-workfile vss-revision vss-description skip
     2145            "Ошибка при вызове процедуры tdat-val":U skip
     2146            "Документ: " p-torgconfdoc-code skip
     2147            "Атрибут: " 'wthproxy':U skip
     2148            "Значение: " p-torgconf-ndovwho skip
     2149            trim( error-status :get-message (1) ) skip
     2150            return-value skip
     2151            view-as alert-box error.
     2152         undo, return error return-value.
     2153         end.
     2154   if valid-handle( g#wthcalib ) <> yes then do:       run str/wthcalib.p persistent no-error.       if error-status :error or valid-handle( g#wthcalib ) <> yes then do:         message "Error starting wthcalib.p"    skip( 0 )                 g#wthcalib                     skip( 0 )                 g#wthcalib   :type             skip( 0 )                 g#wthcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run wthcalib_wthat-val in g#wthcalib (  input p-torgconfdoc-code ,
     2155                           input 'wthreceiver':U ,
     2156                          output p-torgconf-accept-fname ,
     2157                          output p-torgconf-accept-n-type ) no-error .
     2158         if error-status :error then do:
     2159         message
     2160            vss-workfile vss-revision vss-description skip
     2161            "Ошибка при вызове процедуры tdat-val":U skip
     2162            "Документ: " p-torgconfdoc-code skip
     2163            "Атрибут: " 't_accept-fname':U skip
     2164            "Значение: " p-torgconf-accept-fname skip
     2165            trim( error-status :get-message (1) ) skip
     2166            return-value skip
     2167            view-as alert-box error.
     2168         undo, return error return-value.
     2169         end.
     2170     end procedure.
     2171   procedure torgconf-get-sup-param :
     2172   define input parameter p-obj-type           as character        no-undo.
     2173   define input parameter p-obj-code           as integer          no-undo.
     2174   define input parameter p-curr-code          as integer          no-undo.
     2175       define variable v-host-code    as integer      no-undo.
     2176       define variable v-par-type     as character    no-undo.
     2177   do
     2178   on error undo, return error
     2179   :
     2180       assign
     2181          v-torgconf-sup-host-code = v-host-code
     2182       .
     2183       if v-torgconf-sup-host-code = 0
     2184       then do:
     2185           assign
     2186               v-torgconf-sup-host-name           = "":U
     2187               v-torgconf-sup-host-addres         = "":U
     2188               v-torgconf-sup-host-post-addres    = "":U
     2189               v-torgconf-sup-host-phone          = "":U
     2190               v-torgconf-sup-host-inn            = "":U
     2191               v-torgconf-sup-host-kpp            = "":U
     2192               v-torgconf-sup-host-okpo           = "":U
     2193               v-torgconf-sup-host-egrip-date     = "":U
     2194               v-torgconf-sup-host-egrip-num      = "":U
     2195           .
     2196       end.
     2197       else do:
     2198           run fmtcli-get-client in this-procedure (
     2199                 input 'орг':U
     2200               , input v-torgconf-sup-host-code
     2201           ).
     2202           assign
     2203               v-torgconf-sup-host-name        = v-fmtcli-name
     2204               v-torgconf-sup-host-engl-name   = v-fmtcli-engl-name
     2205               v-torgconf-sup-host-addres      = v-fmtcli-full-addres
     2206               v-torgconf-sup-host-post-addres = v-fmtcli-post-addres
     2207               v-torgconf-sup-host-phone       = v-fmtcli-phone
     2208               v-torgconf-sup-host-inn         = v-fmtcli-inn
     2209               v-torgconf-sup-host-kpp         = v-fmtcli-kpp
     2210               v-torgconf-sup-host-okpo        = v-fmtcli-okpo
     2211           .
     2212           run gbl/clntat-v.p (
     2213                 input 'орг':U
     2214               , input v-torgconf-sup-host-code
     2215               , input 'egrip-date':U
     2216               , output v-torgconf-sup-host-egrip-date
     2217               , output v-par-type
     2218           ).
     2219           run gbl/clntat-v.p (
     2220                 input 'орг':U
     2221               , input v-torgconf-sup-host-code
     2222               , input 'egrip-num':U
     2223               , output v-torgconf-sup-host-egrip-num
     2224               , output v-par-type
     2225           ).
     2226           run fmtcli-get-bank in this-procedure (
     2227                 input v-host-code
     2228               , input 'орг':U
     2229               , input v-torgconf-sup-host-code
     2230               , input p-curr-code
     2231           ).
     2232       end.
     2233       assign
     2234           v-torgconf-sup-schet-exists = v-fmtcli-schet-exists
     2235           v-torgconf-sup-bank-exists  = v-fmtcli-bank-exists
     2236           v-torgconf-sup-bank-r-schet = v-fmtcli-bank-r-schet
     2237           v-torgconf-sup-bank-c-schet = v-fmtcli-bank-c-schet
     2238           v-torgconf-sup-bank-bik     = v-fmtcli-bank-bik
     2239           v-torgconf-sup-bank-name    = v-fmtcli-bank-name
     2240           v-torgconf-sup-bank-addres  = v-fmtcli-bank-addres
     2241           v-torgconf-sup-bank-city    = v-fmtcli-bank-city
     2242       .
     2243       assign
     2244           v-torgconf-sup-obj-type = p-obj-type
     2245           v-torgconf-sup-obj-code = p-obj-code
     2246       .
     2247       if trim(p-obj-type) <> ""
     2248       and p-obj-code <> 0
     2249       then do:
     2250       run fmtcli-get-client in this-procedure (
     2251             input p-obj-type
     2252           , input p-obj-code
     2253       ).
     2254       assign
     2255           v-torgconf-sup-obj-name        = v-fmtcli-name
     2256           v-torgconf-sup-obj-engl-name   = v-fmtcli-engl-name
     2257           v-torgconf-sup-obj-addres      = v-fmtcli-full-addres
     2258           v-torgconf-temp-post-addres    = v-fmtcli-post-addres
     2259           v-torgconf-sup-obj-phone       = v-fmtcli-phone
     2260           v-torgconf-sup-obj-inn         = v-fmtcli-inn
     2261           v-torgconf-sup-obj-okpo        = v-fmtcli-okpo
     2262       .
     2263      end.
     2264      end.
     2265   end procedure.
     2266   procedure torgconf-get-cli-param :
     2267   define input parameter p-host-obj-code      as integer          no-undo.
     2268   define input parameter p-obj-type           as character        no-undo.
     2269   define input parameter p-obj-code           as integer          no-undo.
     2270   define input parameter p-curr-code          as integer          no-undo.
     2271       define variable v-host-code    as integer      no-undo.
     2272   do
     2273   on error undo, return error
     2274   :
     2275       assign
     2276           v-torgconf-cli-type = p-obj-type
     2277           v-torgconf-cli-code = p-obj-code
     2278       .
     2279       run fmtcli-get-client in this-procedure (
     2280             input p-obj-type
     2281           , input p-obj-code
     2282       ).
     2283       assign
     2284           v-torgconf-cli-name         = trim( v-fmtcli-name          )
     2285           v-torgconf-cli-engl-name    = trim( v-fmtcli-engl-name          )
     2286           v-torgconf-cli-addres       = trim( v-fmtcli-full-addres   )
     2287           v-torgconf-cli-post-addres  = trim( v-fmtcli-post-addres   )
     2288           v-torgconf-cli-phone        = trim( v-fmtcli-phone         )
     2289           v-torgconf-cli-inn          = trim( v-fmtcli-inn           )
     2290           v-torgconf-cli-kpp          = trim( v-fmtcli-kpp           )
     2291           v-torgconf-cli-okpo         = trim( v-fmtcli-okpo          )
     2292       .
     2293      run fmtcli-get-bank in this-procedure (
     2294             input p-host-obj-code
     2295           , input p-obj-type
     2296           , input p-obj-code
     2297           , input p-curr-code
     2298       ).
     2299       assign
     2300           v-torgconf-cli-schet-exists = v-fmtcli-schet-exists
     2301           v-torgconf-cli-bank-exists  = v-fmtcli-bank-exists
     2302           v-torgconf-cli-bank-r-schet = v-fmtcli-bank-r-schet
     2303           v-torgconf-cli-bank-c-schet = v-fmtcli-bank-c-schet
     2304           v-torgconf-cli-bank-bik     = v-fmtcli-bank-bik
     2305           v-torgconf-cli-bank-name    = v-fmtcli-bank-name
     2306           v-torgconf-cli-bank-addres  = v-fmtcli-bank-addres
     2307           v-torgconf-cli-bank-city    = v-fmtcli-bank-city
     2308       .
     2309   end.
     2310   end procedure.
     2311   procedure torgconf-get-ship-param :
     2312   define input parameter p-host-obj-code      as integer          no-undo.
     2313   define input parameter p-obj-type           as character        no-undo.
     2314   define input parameter p-obj-code           as integer          no-undo.
     2315   define input parameter p-curr-code          as integer          no-undo.
     2316       define variable v-host-code    as integer      no-undo.
     2317   do
     2318   on error undo, return error
     2319   :
     2320       assign
     2321           v-torgconf-ship-type = p-obj-type
     2322           v-torgconf-ship-code = p-obj-code
     2323       .
     2324       if trim(p-obj-type) = ""
     2325       and p-obj-code = 0
     2326       then do:
     2327       assign
     2328           v-torgconf-ship-name         = "":U
     2329           v-torgconf-ship-addres       = "":U
     2330           v-torgconf-ship-post-addres  = "":U
     2331           v-torgconf-ship-phone        = "":U
     2332           v-torgconf-ship-inn          = "":U
     2333           v-torgconf-ship-kpp          = "":U
     2334           v-torgconf-ship-okpo         = "":U
     2335       .
     2336       end.
     2337       else do:
     2338       run fmtcli-get-client in this-procedure (
     2339             input p-obj-type
     2340           , input p-obj-code
     2341       ).
     2342       assign
     2343           v-torgconf-ship-name         = trim( v-fmtcli-name          )
     2344           v-torgconf-ship-engl-name    = trim( v-fmtcli-engl-name          )
     2345           v-torgconf-ship-addres       = trim( v-fmtcli-full-addres   )
     2346           v-torgconf-ship-post-addres  = trim( v-fmtcli-post-addres   )
     2347           v-torgconf-ship-phone        = trim( v-fmtcli-phone         )
     2348           v-torgconf-ship-inn          = trim( v-fmtcli-inn           )
     2349           v-torgconf-ship-kpp          = trim( v-fmtcli-kpp           )
     2350           v-torgconf-ship-okpo         = trim( v-fmtcli-okpo          )
     2351       .
     2352       end.
     2353           run fmtcli-get-bank in this-procedure (
     2354             input p-host-obj-code
     2355           , input p-obj-type
     2356           , input p-obj-code
     2357           , input p-curr-code
     2358       ).
     2359       assign
     2360           v-torgconf-ship-schet-exists = v-fmtcli-schet-exists
     2361           v-torgconf-ship-bank-exists  = v-fmtcli-bank-exists
     2362           v-torgconf-ship-bank-r-schet = v-fmtcli-bank-r-schet
     2363           v-torgconf-ship-bank-c-schet = v-fmtcli-bank-c-schet
     2364           v-torgconf-ship-bank-bik     = v-fmtcli-bank-bik
     2365           v-torgconf-ship-bank-name    = v-fmtcli-bank-name
     2366           v-torgconf-ship-bank-addres  = v-fmtcli-bank-addres
     2367           v-torgconf-ship-bank-city    = v-fmtcli-bank-city
     2368       .
     2369   end.
     2370   end procedure.
     2371   procedure torgconf-get-holdfirm-code :
     2372   define input parameter p-obj-type   as character        no-undo.
     2373   define input parameter p-obj-code   as integer          no-undo.
     2374   define output parameter p-firm-code as integer          no-undo.
     2375       define variable v-firm-code-str     as character    no-undo.
     2376       define variable v-par-type          as character    no-undo.
     2377       define buffer buf_clients       for ub.clients.
     2378   do
     2379   for buf_clients
     2380   on error undo, return error
     2381   :
     2382       run gbl/clntat-v.p (
     2383             input p-obj-type
     2384           , input p-obj-code
     2385           , input 'holdfirm-code':U
     2386           , output v-firm-code-str
     2387           , output v-par-type
     2388       ).
     2389       assign
     2390           p-firm-code = integer( v-firm-code-str )
     2391       no-error.
     2392       if error-status :error
     2393       then do:
     2394           message
     2395               "Неверно задан код фирмы для печати накладных."
     2396           view-as alert-box warning.
     2397           assign
     2398               p-firm-code = 0
     2399           .
     2400       end.
     2401       else do:
     2402           find first buf_clients no-lock
     2403                where buf_clients.obj-type = 'орг':U
     2404                  and buf_clients.obj-code = p-firm-code
     2405           no-error.
     2406           if not available buf_clients
     2407           then do:
     2408               message
     2409                   "Включен параметр 'Список печатных форм, для которых должна быть задана фирма для печати накладных' (outhold)" skip
     2410                   "Не найдена фирма по заданному коду фирмы для печати накладных."
     2411               view-as alert-box warning.
     2412               assign
     2413                   p-firm-code = 0
     2414               .
     2415           end.
     2416       end.
     2417   end.
     2418   end procedure.
     2419   procedure torgconf-get-post-head:
     2420   define input  parameter p-obj-type             as character        no-undo.
     2421   define input  parameter p-obj-code             as integer          no-undo.
     2422   define output parameter p-torgconf-post-head   as character        no-undo.
     2423      define variable v-host-code         as integer      no-undo.
     2424      define buffer buf_sysconf     for ub.sysconf.
     2425        assign
     2426         p-torgconf-post-head  = ""
     2427        .
     2428   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2429   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2430     (input  p-obj-type
     2431     ,input  p-obj-code
     2432     ,output v-host-code
     2433     )  .
     2434      find first buf_sysconf no-lock
     2435      where buf_sysconf.host-code = v-host-code
     2436      no-error.
     2437      if available buf_sysconf
     2438      then do:
     2439         assign
     2440            p-torgconf-post-head = buf_sysconf.head-position
     2441         .
     2442      end.
     2443   end procedure.
     2444   procedure torgconf-get-storekeeper:
     2445   define input  parameter p-wrkr                   as integer          no-undo.
     2446   define output parameter p-torgconf-wrkr-name     as character        no-undo.
     2447   define output parameter p-torgconf-post          as character        no-undo.
     2448      define buffer buf_sysconf     for ub.sysconf.
     2449      define buffer buf_person      for ub.person.
     2450      define buffer buf_shop        for ub.shop .
     2451      define buffer buf_store       for ub.store .
     2452      if v-torgconf-outC = "no_print"
     2453      then do:
     2454         assign p-torgconf-post = ""
     2455                p-torgconf-wrkr-name = ""
     2456                .
     2457      end.
     2458      if v-torgconf-outC = "clad_doc"
     2459      then do:
     2460         run rep/get-psn.p
     2461               (input  p-wrkr
     2462               ,output p-torgconf-wrkr-name
     2463               ) .
     2464         find first buf_person no-lock
     2465         where buf_person.psn-code = p-wrkr
     2466         no-error.
     2467         if available buf_person
     2468         then do:
     2469           p-torgconf-post = buf_person.position.
     2470         end.
     2471         if p-torgconf-post = "?":U then p-torgconf-post = "".
     2472         if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     2473      end.
     2474      if v-torgconf-outC = "clad_obj"
     2475      then do:
     2476         CASE v-torgconf-self-obj-type:
     2477         WHEN 'маг':U
     2478         THEN DO:
     2479            find first buf_shop no-lock
     2480            where buf_shop.obj-code = v-torgconf-self-obj-code
     2481            .
     2482            assign
     2483               p-torgconf-wrkr-name = buf_shop.store-man
     2484               p-torgconf-post = ""
     2485            .
     2486            if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     2487         END.
     2488         WHEN 'скл':U
     2489         THEN DO:
     2490            find first buf_store no-lock
     2491            where buf_store.obj-code = v-torgconf-self-obj-code
     2492            .
     2493            assign
     2494               p-torgconf-wrkr-name = buf_store.store-man
     2495               p-torgconf-post = ""
     2496            .
     2497            if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     2498         END.
     2499         OTHERWISE DO:
     2500            assign
     2501               p-torgconf-post = "":U
     2502               p-torgconf-wrkr-name = "":U
     2503            .
     2504         END.
     2505         END CASE.
     2506      end.
     2507    end procedure.
     2508   procedure torgconf-get-form-header :
     2509   define input parameter p-for-inverse    as logical          no-undo.
     2510   define input parameter p-doc-code       as character        no-undo.
     2511   define input parameter p-print-doc      as logical          no-undo.
     2512   define input parameter p-doc-date       as date             no-undo.
     2513   define input parameter p-fact-date      as date             no-undo.
     2514   define input parameter p-doc-type       as character        no-undo.
     2515   define input parameter p-status_        as character        no-undo.
     2516   define input parameter p-reverse        as logical          no-undo.
     2517   define input parameter p-sf-par         as logical          no-undo.
     2518       define variable v-attr-type         as character    no-undo.
     2519       define variable v-doc-code-standard as logical      no-undo.
     2520       define variable v-doc-date-standard as logical      no-undo.
     2521       define variable v-par-consignee-addres  as character    no-undo.
     2522       define variable v-host-code         as integer      no-undo.
     2523       define variable v-dcode-attr        as character    no-undo.
     2524       define variable v-ddate-attr        as character    no-undo.
     2525       define variable v-doc-date          as character    no-undo.
     2526       define variable v-doc-code          as character    no-undo.
     2527       define variable v-par-type          as character    no-undo.
     2528       define variable v-attr              as character    no-undo.
     2529       define buffer buf_firm          for ub.firm .
     2530       define buffer buf_clients       for ub.clients .
     2531       define buffer buf_sysconf       for ub.sysconf .
     2532       define buffer buf_shop          for ub.shop .
     2533       define buffer buf_store         for ub.store .
     2534       define buffer buf_person        for ub.person .
     2535       define buffer buf_trn-doc       for ub.trn-doc .
     2536       define buffer buf_wth-doc       for ub.wth-doc .
     2537       do
     2538   for buf_firm
     2539     , buf_clients
     2540     , buf_sysconf
     2541     , buf_shop
     2542     , buf_trn-doc
     2543     , buf_person
     2544     , buf_wth-doc
     2545   on error undo, return error
     2546   :
     2547       if p-doc-type = 'при':U
     2548       or p-doc-type = 'возврат':U
     2549       then do:
     2550           assign
     2551               v-torgconf-supplier         = substitute( "&1&2&3&4&5", v-torgconf-cli-name, ( if v-torgconf-cli-addres = "":U then "":U else ", " ),
     2552                                             v-torgconf-cli-addres, ( if v-torgconf-cli-phone = "":U then "":U else ", " ), v-torgconf-cli-phone )
     2553               v-torgconf-suppi            = substitute( "&1&2&3&4&5", v-torgconf-cli-name, ( if v-torgconf-cli-addres = "":U then "":U else ", " ),
     2554                                             v-torgconf-cli-addres, ( if v-torgconf-cli-phone = "":U then "":U else ", " ), v-torgconf-cli-phone )
     2555               v-torgconf-saler            = substitute( "&1&2&3&4&5", v-torgconf-self-host-name, ( if v-torgconf-self-host-addres = "":U then "":U else ", " ),
     2556                                             v-torgconf-self-host-addres, ( if v-torgconf-self-host-phone = "":U then "":U else ", " ),v-torgconf-self-host-phone )
     2557               v-torgconf-consignee        = substitute( "&1&2&3&4&5", v-torgconf-sup-host-name, ( if v-torgconf-sup-host-addres = "":U then "":U else ", " ),
     2558                                             v-torgconf-sup-host-addres, ( if v-torgconf-sup-host-phone = "":U then "":U else ", " ), v-torgconf-sup-host-phone  )
     2559               v-torgconf-supplier-okpo    = v-torgconf-cli-okpo
     2560               v-torgconf-saler-okpo       = v-torgconf-self-host-okpo
     2561               v-torgconf-consignee-okpo   = v-torgconf-sup-host-okpo
     2562               v-torgconf-supplier-code    = substitute( "&1", v-torgconf-cli-code         )
     2563               v-torgconf-supplier-type    = v-torgconf-cli-type
