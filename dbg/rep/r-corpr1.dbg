      610   function breakstr returns character ( input        for-name    as character,
      611                                         input        line-length as integer,
      612                                         input-output line1       as character,
      613                                         input-output line2       as character ) :
      614     define variable ii as integer no-undo.
      615     if length( for-name ) > line-length then do:
      616       assign ii    = 1
      617              line1 = "":u
      618              line2 = "":u.
      619       if length( entry( ii, for-name , " ":u ) ) > line-length then do:
      620         assign line1 =       substring( for-name, 1, line-length     )
      621                line2 = trim( substring( for-name,    line-length + 1 ) ).
      622       end.                                                     else do:
      623         do while length( line1 + entry( ii, for-name, " ":u ) ) < ( line-length + 1 ) :
      624           assign line1 = line1 + entry( ii, for-name, " ":u ) + " ":u
      625                  ii    = ii    + 1.
      626           if length( entry( ii, for-name, " ":u ) ) > line-length then do:
      627             assign line1 = line1 + substring( for-name, length( line1 ), line-length - length( line1 ) + 1 ).
      628           end.
      629         end.
      630         assign line2 = trim( substring( for-name, length( line1 ) ) ).
      631       end.
      632     end.                                else do:
      633       assign line1 = for-name
      634              line2 = "":u.
      635     end.
      636     return ( line1 ).
      637   end function.
      638       def var t-addres        like ub.firm.addres1   no-undo.
      639       def var t-phone         like ub.firm.phone     no-undo.
      640       def var t-inn           like ub.firm.inn       no-undo.
      641       def var t-okpo          like ub.firm.okpo      no-undo.
      642       def var t-temp-address  like ub.firm.addres1   no-undo.
      643   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      644   define new global shared variable g#trdcalib as handle no-undo.
      645   define variable vss-include-info10 as character format "X(65)" no-undo
      646   initial "@(#)$Workfile$ $Revision$".
      647   define variable v-fmtcli-name          as character    no-undo.
      648   define variable v-fmtcli-engl-name     as character    no-undo.
      649   define variable v-fmtcli-addres        as character    no-undo.
      650   define variable v-fmtcli-post-addres   as character    no-undo.
      651   define variable v-fmtcli-full-addres   as character    no-undo.
      652   define variable v-fmtcli-phone         as character    no-undo.
      653   define variable v-fmtcli-inn           as character    no-undo.
      654   define variable v-fmtcli-kpp           as character    no-undo.
      655   define variable v-fmtcli-okpo          as character    no-undo.
      656   define variable v-fmtcli-country       as character    no-undo.
      657   define variable v-fmtcli-city          as character    no-undo.
      658   define variable v-fmtcli-index         as character    no-undo.
      659   define variable v-fmtcli-schet-exists  as logical      no-undo.
      660   define variable v-fmtcli-bank-exists   as logical      no-undo.
      661   define variable v-fmtcli-bank-r-schet  as character    no-undo.
      662   define variable v-fmtcli-bank-c-schet  as character    no-undo.
      663   define variable v-fmtcli-bank-bik      as character    no-undo.
      664   define variable v-fmtcli-bank-name     as character    no-undo.
      665   define variable v-fmtcli-bank-addres   as character    no-undo.
      666   define variable v-fmtcli-bank-city     as character    no-undo.
      667   procedure fmtcli-get-bank :
      668   define input parameter p-host-code      as integer          no-undo.
      669   define input parameter p-obj-type       as character        no-undo.
      670   define input parameter p-obj-code       as integer          no-undo.
      671   define input parameter p-curr-code      as integer          no-undo.
      672       define buffer buf_fin-schet     for ub.fin-schet.
      673       define buffer buf_fin-bank      for ub.fin-bank.
      674   do
      675   for buf_fin-schet
      676     , buf_fin-bank
      677   on error undo, return error
      678   :
      679       assign
      680           v-fmtcli-schet-exists       = no
      681           v-fmtcli-bank-exists        = no
      682           v-fmtcli-bank-r-schet       = "":U
      683           v-fmtcli-bank-c-schet       = "":U
      684           v-fmtcli-bank-bik           = "":U
      685           v-fmtcli-bank-name          = "":U
      686           v-fmtcli-bank-addres        = "":U
      687           v-fmtcli-bank-city          = "":U
      688       .
      689       search-for-schet:
      690       for each buf_fin-schet no-lock
      691          where buf_fin-schet.host-code = p-host-code
      692            and buf_fin-schet.cli-type  = p-obj-type
      693            and buf_fin-schet.cli-code  = p-obj-code
      694            and buf_fin-schet.curr-code = p-curr-code
      695       on error undo, return error
      696       :
      697           if buf_fin-schet.status_   = 'удал':U
      698           then do:
      699           end.
      700           else do:
      701               assign
      702                   v-fmtcli-schet-exists   = yes
      703                   v-fmtcli-bank-r-schet   = trim( buf_fin-schet.r-schet )
      704                   v-fmtcli-bank-c-schet   = trim( buf_fin-schet.c-schet )
      705               .
      706               find first buf_fin-bank no-lock
      707                    where buf_fin-bank.host-code = p-host-code
      708                      and buf_fin-bank.code-bank = buf_fin-schet.code-bank
      709               no-error.
      710               if available buf_fin-bank
      711               then do:
      712                   assign
      713                       v-fmtcli-bank-exists      = yes
      714                       v-fmtcli-bank-bik         = trim( buf_fin-bank.bik )
      715                       v-fmtcli-bank-name        = trim( buf_fin-bank.bank-name )
      716                       v-fmtcli-bank-addres      = trim(buf_fin-bank.addres)
      717                       v-fmtcli-bank-city      = trim(buf_fin-bank.bank-city)
      718                   .
      719               end.
      720               else do:
      721                   assign
      722                       v-fmtcli-bank-exists    = no
      723                       v-fmtcli-bank-bik       = "":U
      724                       v-fmtcli-bank-name      = "":U
      725                       v-fmtcli-bank-addres    = "":U
      726                       v-fmtcli-bank-city      = "":U
      727                   .
      728               end.
      729               leave search-for-schet.
      730           end.
      731       end.
      732   end.
      733   end procedure.
      734   procedure fmtcli-get-client :
      735   define input parameter p-obj-type       as character    no-undo.
      736   define input parameter p-obj-code       as integer      no-undo.
      737       define variable v-temp-fmtcli-address      as character     no-undo.
      738       define variable v-num-country-city    as integer      no-undo.
      739       define buffer buf_clients   for ub.clients.
      740       define buffer buf_firm      for ub.firm.
      741       define buffer buf_store     for ub.store.
      742       define buffer buf_shop      for ub.shop.
      743       define buffer buf_person    for ub.person.
      744   do
      745   for buf_clients
      746     , buf_firm
      747     , buf_store
      748     , buf_shop
      749     , buf_person
      750   on error undo, return error
      751   :
      752       assign
      753           v-fmtcli-name           = "":U
      754           v-fmtcli-addres         = "":U
      755           v-fmtcli-post-addres    = "":U
      756           v-fmtcli-full-addres    = "":U
      757           v-fmtcli-phone          = "":U
      758           v-fmtcli-inn            = "":U
      759           v-fmtcli-kpp            = "":U
      760           v-fmtcli-okpo           = "":U
      761           v-fmtcli-city           = "":U
      762           v-fmtcli-index          = "":U
      763           v-fmtcli-country        = "":U
      764       .
      765       find first buf_clients no-lock
      766            where buf_clients.obj-type = p-obj-type
      767              and buf_clients.obj-code = p-obj-code
      768       .
      769       assign
      770           v-fmtcli-name = buf_clients.obj-name
      771       .
      772       case buf_clients.obj-type:
      773          when 'орг':U
      774          then do:
      775               find first buf_firm no-lock
      776                    where buf_firm.firm-code = buf_clients.obj-code
      777                    no-error
      778               .
      779               if available buf_firm
      780               then do:
      781                   assign
      782                       v-num-country-city = num-entries( buf_firm.city )
      783                       v-fmtcli-engl-name = buf_firm.engl-name
      784                   .
      785                   if v-num-country-city > 0
      786                   then do:
      787                       assign
      788                           v-fmtcli-country    = trim( entry( 1, buf_firm.city ) )
      789                       .
      790                   end.
      791                   if v-num-country-city > 1
      792                   then do:
      793                       assign
      794                           v-fmtcli-city       = trim( entry( 2, buf_firm.city ) )
      795                       .
      796                   end.
      797                   run fmtcli-concatenate-strings in this-procedure (
      798                         input v-fmtcli-full-addres
      799                       , input v-fmtcli-country
      800                       , input ", ":U
      801                       , input 50
      802                       , output v-fmtcli-full-addres
      803                   ).
      804                   run fmtcli-concatenate-strings in this-procedure (
      805                         input v-fmtcli-full-addres
      806                       , input v-fmtcli-city
      807                       , input ", ":U
      808                       , input 50
      809                       , output v-fmtcli-full-addres
      810                   ).
      811                   run fmtcli-concatenate-strings in this-procedure (
      812                         input v-fmtcli-full-addres
      813                       , input IF buf_firm.ind = 0 THEN "" ELSE string( buf_firm.ind )
      814                       , input ", ":U
      815                       , input 50
      816                       , output v-fmtcli-full-addres
      817                   ).
      818                   run fmtcli-concatenate-strings in this-procedure (
      819                         input v-fmtcli-post-addres
      820                       , input v-fmtcli-country
      821                       , input ", ":U
      822                       , input 50
      823                       , output v-fmtcli-post-addres
      824                   ).
      825                   run fmtcli-concatenate-strings in this-procedure (
      826                         input v-fmtcli-post-addres
      827                       , input v-fmtcli-city
      828                       , input ", ":U
      829                       , input 50
      830                       , output v-fmtcli-post-addres
      831                   ).
      832                   run fmtcli-concatenate-strings in this-procedure (
      833                         input v-fmtcli-post-addres
      834                       , input string( buf_firm.ind )
      835                       , input ", ":U
      836                       , input 50
      837                       , output v-fmtcli-post-addres
      838                   ).
      839                   run fmtcli-concatenate-strings in this-procedure (
      840                         input substring( buf_firm.addres1, 1, 50 )
      841                       , input buf_firm.addres2
      842                       , input " ":U
      843                       , input 50
      844                       , output v-temp-fmtcli-address
      845                   ).
      846                   run fmtcli-concatenate-strings in this-procedure (
      847                         input v-temp-fmtcli-address
      848                       , input substring( buf_firm.addres1, 51, 50 )
      849                       , input " ":U
      850                       , input 50
      851                       , output v-temp-fmtcli-address
      852                   ).
      853                   run fmtcli-concatenate-strings in this-procedure (
      854                         input v-temp-fmtcli-address
      855                       , input substring( buf_firm.addres1, 101, 50 )
      856                       , input " ":U
      857                       , input 50
      858                       , output v-temp-fmtcli-address
      859                   ).
      860                   assign
      861                       v-fmtcli-addres = v-temp-fmtcli-address
      862                   .
      863                   if buf_firm.addres1 <> ?
      864                   then do:
      865                       run fmtcli-concatenate-strings in this-procedure (
      866                             input v-fmtcli-full-addres
      867                           , input v-fmtcli-addres
      868                           , input ", ":U
      869                           , input 0
      870                           , output v-fmtcli-full-addres
      871                       ).
      872                   end.
      873                   run fmtcli-concatenate-strings in this-procedure (
      874                         input substring( buf_firm.post-addr1, 1, 50 )
      875                       , input buf_firm.post-addr2
      876                       , input " ":U
      877                       , input 50
      878                       , output v-fmtcli-post-addres
      879                   ).
      880                   run fmtcli-concatenate-strings in this-procedure (
      881                         input v-fmtcli-post-addres
      882                       , input substring( buf_firm.post-addr1, 51, 50 )
      883                       , input " ":U
      884                       , input 50
      885                       , output v-fmtcli-post-addres
      886                   ).
      887                   run fmtcli-concatenate-strings in this-procedure (
      888                         input v-fmtcli-post-addres
      889                       , input substring( buf_firm.post-addr1, 101, 50 )
      890                       , input " ":U
      891                       , input 50
      892                       , output v-fmtcli-post-addres
      893                   ).
      894                   assign
      895                       v-fmtcli-phone         = buf_firm.phone
      896                       v-fmtcli-inn           = buf_firm.inn
      897                       v-fmtcli-kpp           = buf_firm.kpp
      898                       v-fmtcli-okpo          = buf_firm.okpo
      899                       v-fmtcli-index         = string( buf_firm.ind )
      900                   .
      901               end.
      902          end.
      903          when 'маг':U
      904          then do:
      905               find first buf_shop no-lock
      906                    where buf_shop.obj-code = buf_clients.obj-code
      907               .
      908               if available buf_shop
      909               then do:
      910                   run fmtcli-concatenate-strings in this-procedure (
      911                         input buf_shop.addres1
      912                       , input buf_shop.addres2
      913                       , input " ":U
      914                       , input 50
      915                       , output v-fmtcli-addres
      916                   ).
      917                   assign
      918                       v-fmtcli-full-addres = v-fmtcli-addres
      919                       v-fmtcli-post-addres = v-fmtcli-addres
      920                       v-fmtcli-phone       = buf_shop.phone
      921                       v-fmtcli-inn         = "":U
      922                       v-fmtcli-kpp         = "":U
      923                       v-fmtcli-okpo        = "":U
      924                       v-fmtcli-city        = "":U
      925                       v-fmtcli-index       = "":U
      926                   .
      927               end.
      928          end.
      929          when 'скл':U
      930          then do:
      931               find first buf_store no-lock
      932                    where buf_store.obj-code = buf_clients.obj-code
      933               .
      934               if available buf_store
      935               then do:
      936                   run fmtcli-concatenate-strings in this-procedure (
      937                         input buf_store.addres1
      938                       , input buf_store.addres2
      939                       , input " ":U
      940                       , input 50
      941                       , output v-fmtcli-addres
      942                   ).
      943                   assign
      944                       v-fmtcli-full-addres = v-fmtcli-addres
      945                       v-fmtcli-phone       = buf_store.phone
      946                       v-fmtcli-inn         = "":U
      947                       v-fmtcli-kpp         = "":U
      948                       v-fmtcli-okpo        = "":U
      949                       v-fmtcli-city        = "":U
      950                       v-fmtcli-index       = "":U
      951                   .
      952               end.
      953          end.
      954          when 'чел':U
      955          then do:
      956               find first buf_person no-lock
      957                    where buf_person.psn-code = buf_clients.obj-code
      958               .
      959               if available buf_person
      960               then do:
      961                   run fmtcli-concatenate-strings in this-procedure (
      962                         input ( if buf_person.ind = 0 or buf_person.ind = ?
      963                                 then "":U
      964                                 else string( buf_person.ind, "999999")
      965                                 )
      966                       , input buf_person.city
      967                       , input ", ":U
      968                       , input 0
      969                       , output v-fmtcli-full-addres
      970                   ).
      971                   assign
      972                       v-fmtcli-addres = buf_person.address
      973                   .
      974                   run fmtcli-concatenate-strings in this-procedure (
      975                         input v-fmtcli-full-addres
      976                       , input v-fmtcli-addres
      977                       , input ", ":U
      978                       , input 0
      979                       , output v-fmtcli-full-addres
      980                   ).
      981                   assign
      982                       v-fmtcli-phone     = buf_person.phone1
      983                       v-fmtcli-inn       = buf_person.inn
      984                       v-fmtcli-kpp       = buf_person.kpp
      985                       v-fmtcli-okpo      = buf_person.okpo
      986                       v-fmtcli-city      = buf_person.city
      987                       v-fmtcli-index     = string( buf_person.ind )
      988                   .
      989               end.
      990          end.
      991       end case.
      992   end.
      993   end procedure.
      994   procedure fmtcli-concatenate-strings :
      995   define input parameter p-string-1       as character        no-undo.
      996   define input parameter p-string-2       as character        no-undo.
      997   define input parameter p-delimiter      as character        no-undo.
      998   define input parameter p-length         as integer          no-undo.
      999   define output parameter p-out-string    as character        no-undo.
     1000   do
     1001   on error undo, return error
     1002   :
     1003       assign
     1004           p-out-string = ( if p-string-1 = ?
     1005                            then "":U
     1006                            else trim( p-string-1 ) )
     1007       .
     1008       assign
     1009           p-out-string = p-out-string
     1010                        + ( if p-out-string = "":U
     1011                            or length( p-out-string ) = p-length
     1012                            or p-string-2 = ?
     1013                            or trim( p-string-2 ) = "":U
     1014                            then "":U
     1015                            else p-delimiter )
     1016                        + ( if p-string-2 = ?
     1017                            or trim( p-string-2 ) = "":U
     1018                            then "":U
     1019                            else trim( p-string-2 ) )
     1020       .
     1021   end.
     1022   end procedure.
