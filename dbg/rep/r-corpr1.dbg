     6134   procedure clcprtsl_calc-line :
     6135   define input  parameter parrec-line as recid no-undo.
     6136   define variable v-tax-date         as   date                     no-undo.
     6137   define variable v-vat-pc           like ub.doc-line.vat-pc       no-undo.
     6138   define variable varr-b             as   character                no-undo.
     6139   define variable varr-btype         as   character                no-undo.
     6140   define variable varcur-base        like ub.gds-dtl.price-base    no-undo.
     6141   define variable varcur-road-tax    like ub.doc-line.road-tax     no-undo.
     6142   define variable varcur-excise      like ub.doc-line.excise       no-undo.
     6143   define variable varcur-vat-pc      like ub.doc-line.vat-pc       no-undo.
     6144   define variable varcur-cons-vat-pc like ub.doc-line.cons-vat-pc  no-undo.
     6145   define variable varcur-slt-pc      like ub.doc-line.slt-pc       no-undo.
     6146   define variable varcur-fact-qnty   like ub.gds-dtl.fact-qnty     no-undo.
     6147   define variable varb-code          like ub.bar-code.b-code       no-undo.
     6148   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     6149   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     6150   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     6151   define variable varexcise          like ub.price-list.excise     no-undo.
     6152   define variable varlastcur-base        like ub.gds-dtl.price-base no-undo.
     6153   define variable varlastcur-road-tax    like ub.gds-dtl.price-base no-undo.
     6154   define variable varlastcur-excise      like ub.gds-dtl.price-base     no-undo.
     6155   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     6156   define variable v-varsum           as decimal                  no-undo.
     6157   define variable varprice-salef as decimal   no-undo .
     6158   define buffer bf_trn-doc             for ub.trn-doc.
     6159   define buffer bf_doc-line            for ub.doc-line.
     6160   define buffer bf_gds-dtl             for ub.gds-dtl.
     6161   define buffer bf_goods               for ub.goods.
     6162   define buffer bf_parts               for ub.parts.
     6163   define buffer bf_sysconf             for ub.sysconf.
     6164   define buffer bf_tt-allsum-line      for tt-allsum-line.
     6165   define buffer bfs_tt-allsum-line     for tt-allsum-line.
     6166   define buffer bfo_tt-allsum-line     for tt-allsum-line.
     6167   define buffer bfos_tt-allsum-line    for tt-allsum-line.
     6168   define buffer buf_parts        for ub.parts.
     6169   v-calcbypart = no.
     6170   do on error undo, return error return-value :
     6171   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     6172   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     6173     (output varr-b
     6174     )  .
     6175     find first bf_doc-line where recid (bf_doc-line) = parrec-line no-lock.
     6176     find first bf_trn-doc where bf_trn-doc.doc-code = bf_doc-line.doc-code no-lock.
     6177     find first bf_goods where bf_goods.artic     = bf_doc-line.artic     and
     6178                               bf_goods.prod-type = bf_doc-line.prod-type and
     6179                               bf_goods.prod-code = bf_doc-line.prod-code no-lock.
     6180     if bf_trn-doc.fact-date <> ?        then do:
     6181       assign v-tax-date = bf_trn-doc.fact-date.
     6182     end.
     6183     else do:
     6184       assign v-tax-date = ?.
     6185     end.
     6186   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6187   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     6188     (input  bf_goods.gds-code
     6189     ,input  '1':U
     6190     ,input  v-tax-date
     6191     ,input  bf_trn-doc.host-code
     6192     ,input  bf_trn-doc.obj-type
     6193     ,input  bf_trn-doc.obj-code
     6194     ,output v-vat-pc
     6195     ) no-error .
     6196     if error-status :error
     6197     or v-vat-pc = ? then do:
     6198        return error substitute ("Ошибка при поиске НДС для товара &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     6199     end.
     6200     if bf_goods.gds-type = 'у':U or
     6201        bf_trn-doc.status_ = 'запрос':U then do:
     6202       for each bf_tt-allsum-line
     6203       on error undo, return error return-value
     6204        :
     6205         delete bf_tt-allsum-line.
     6206       end.
     6207       create bf_tt-allsum-line.
     6208       assign
     6209        bf_tt-allsum-line.sum-type = 'основная_сумма':U.
     6210       for each bf_gds-dtl where bf_gds-dtl.doc-code  = bf_doc-line.doc-code  and
     6211                                 bf_gds-dtl.artic     = bf_doc-line.artic     and
     6212                                 bf_gds-dtl.prod-type = bf_doc-line.prod-type and
     6213                                 bf_gds-dtl.prod-code = bf_doc-line.prod-code no-lock on error undo, return error return-value :
     6214         assign
     6215           bf_tt-allsum-line.fact-qnty            =  bf_tt-allsum-line.fact-qnty        + bf_gds-dtl.fact-qnty
     6216           bf_tt-allsum-line.sum-dsc-base-doc     =  bf_tt-allsum-line.sum-dsc-base-doc + (bf_gds-dtl.price-base - bf_gds-dtl.discnt-base) * bf_gds-dtl.fact-qnty
     6217           bf_tt-allsum-line.sum-dsc-rubl-doc     =  bf_tt-allsum-line.sum-dsc-rubl-doc + (bf_gds-dtl.price-rubl - bf_gds-dtl.discnt-rubl) * bf_gds-dtl.fact-qnty
     6218           bf_tt-allsum-line.dsc-base-doc         =  bf_tt-allsum-line.dsc-base-doc     + bf_gds-dtl.discnt-base * bf_gds-dtl.fact-qnty
     6219           bf_tt-allsum-line.dsc-rubl-doc         =  bf_tt-allsum-line.dsc-rubl-doc     + bf_gds-dtl.discnt-rubl * bf_gds-dtl.fact-qnty
     6220           bf_tt-allsum-line.sum-dsc-base-cur     =  bf_tt-allsum-line.sum-dsc-base-cur + (if varr-b = "base" then bf_gds-dtl.cur-base else bf_gds-dtl.cur-base / bf_trn-doc.exch-rate * bf_trn-doc.exch-scale) * bf_gds-dtl.fact-qnty
     6221           bf_tt-allsum-line.sum-dsc-rubl-cur     =  bf_tt-allsum-line.sum-dsc-rubl-cur + (if varr-b = "rubl" then bf_gds-dtl.cur-base else bf_gds-dtl.cur-base * bf_trn-doc.exch-rate / bf_trn-doc.exch-scale) * bf_gds-dtl.fact-qnty
     6222           bf_tt-allsum-line.sum-dsc-base-acc     =  bf_tt-allsum-line.sum-dsc-base-acc + bf_doc-line.price-base * bf_gds-dtl.fact-qnty
     6223           bf_tt-allsum-line.sum-dsc-rubl-acc     =  bf_tt-allsum-line.sum-dsc-rubl-acc + bf_doc-line.price-rubl * bf_gds-dtl.fact-qnty
     6224           bf_tt-allsum-line.sum-dsc-cli-acc      =  ?
     6225           bf_tt-allsum-line.vat-base-acc         =  bf_tt-allsum-line.vat-base-acc     + bf_doc-line.price-base * v-vat-pc / (100 + v-vat-pc) * bf_gds-dtl.fact-qnty
     6226           bf_tt-allsum-line.vat-rubl-acc         =  bf_tt-allsum-line.vat-rubl-acc     + bf_doc-line.price-rubl * v-vat-pc / (100 + v-vat-pc) * bf_gds-dtl.fact-qnty
     6227           bf_tt-allsum-line.vat-cli-acc          =  ?
     6228           .
     6229       end.
     6230       assign
     6231         bf_tt-allsum-line.cli-qnty             =  ?
     6232         bf_tt-allsum-line.slt-base-doc         =  bf_tt-allsum-line.sum-dsc-base-doc * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     6233         bf_tt-allsum-line.slt-rubl-doc         =  bf_tt-allsum-line.sum-dsc-rubl-doc * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     6234         bf_tt-allsum-line.vat-base-buyer-doc   =  (bf_tt-allsum-line.sum-dsc-base-doc - bf_tt-allsum-line.slt-base-doc) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     6235         bf_tt-allsum-line.vat-rubl-buyer-doc   =  (bf_tt-allsum-line.sum-dsc-rubl-doc - bf_tt-allsum-line.slt-rubl-doc) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
