     4255   procedure torgconf-get-reason  :
     4256   define input parameter  p-doc-code       as character        no-undo.
     4257   define input parameter  p-reason-code    as integer          no-undo .
     4258   define input parameter  p-doc-type       as character        no-undo.
     4259       if p-reason-code > 0
     4260       then do:
     4261           define buffer buf_trn-reason for ub.trn-reason.
     4262           find first buf_trn-reason no-lock where buf_trn-reason.reason-code = p-reason-code no-error .
     4263           if available buf_trn-reason then assign v-torgconf-reason =  buf_trn-reason.reason-name .
     4264       end.
     4265       else do:
     4266           if p-doc-type = 'при':U
     4267           then  do:
     4268               define variable v-attr-type     as character    no-undo.
     4269               define variable v-attr-value    as character    no-undo.
     4270               run gbl/trdcat-v.p (input p-doc-code,input 'nids':U,output v-attr-value,output v-attr-type) .
     4271               assign v-torgconf-reason = v-attr-value .
     4272               run gbl/trdcat-v.p (input p-doc-code,input 'dids':U,output v-attr-value,output v-attr-type) .
     4273               assign v-torgconf-reason = v-torgconf-reason + " от " + v-attr-value .
     4274           end.
     4275       end.
     4276   end procedure.
     4277   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4278   procedure factord :
     4279     define input  parameter p-fact-date            as date    no-undo .
     4280     define input  parameter p-fact-time            as integer no-undo .
     4281     define input  parameter p-fact-num             as integer no-undo .
     4282     define input  parameter p-shift-date           as date    no-undo .
     4283     define input  parameter p-shift-num            as integer no-undo .
     4284     define input  parameter p-shift-on             as logical no-undo .
     4285     define output parameter p-fact-order           as decimal no-undo .
     4286     define output parameter p-shift-end-fact-order as decimal no-undo .
     4287     define output parameter p-day-end-fact-order   as decimal no-undo .
     4288     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
     4289     if p-fact-date = ?
     4290     then do:
     4291       return error "Не указана фактическая дата" .
     4292     end.
     4293     define variable v-fact-date-num as integer no-undo .
     4294     assign
     4295       v-fact-date-num = integer(p-fact-date)
     4296     .
     4297     if p-fact-num = ?
     4298     or p-fact-num = 0
     4299     then do:
     4300       return error "Не задан p-fact-num " + string(p-fact-num) .
     4301     end.
     4302     if p-fact-num < 0
     4303     then do:
     4304       return error "Отрицательный fact-num " + string(p-fact-num) .
     4305     end.
     4306     if p-fact-num >= 100000000
     4307     then do:
     4308       return error "Недопустимо большой fact-num " + string(p-fact-num) .
     4309     end.
     4310     if p-shift-on = true
     4311     then do:
     4312       if p-shift-date = ?
     4313       then do:
     4314         return error "Не задана дата смены" .
     4315       end.
     4316       if p-shift-num = ?
     4317       or p-shift-num = 0
     4318       then do:
     4319         return error "Не задан номер смены" .
     4320       end.
     4321     end.
     4322     else do:
     4323       assign
     4324         p-shift-date = p-fact-date
     4325         p-shift-num  = 24
     4326       .
     4327     end.
     4328     define variable v-shift-offset as integer no-undo .
     4329     if p-shift-date = p-fact-date
     4330     then do:
     4331       assign
     4332         v-shift-offset = 1
     4333       .
     4334     end.
     4335     if p-shift-date < p-fact-date
     4336     then do:
     4337       assign
     4338         v-shift-offset = 0
     4339       .
     4340     end.
     4341     if p-shift-date > p-fact-date
     4342     then do:
     4343       message
     4344         vss-workfile vss-revision vss-description skip
     4345         "Неправильная дата закрытия смены" skip
     4346         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
     4347         view-as alert-box error .
     4348       undo, return error
     4349         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
     4350           ,string(p-fact-date, '99/99/9999':U)
     4351           ,string(p-shift-date, '99/99/9999':U)
     4352           )
     4353       .
     4354     end.
     4355     if p-shift-num < 1
     4356     or p-shift-num > 24
     4357     then do:
     4358       message
     4359         vss-workfile vss-revision vss-description skip
     4360         "Неправильный номер смены" skip
     4361         "p-shift-num" p-shift-num skip
     4362         view-as alert-box error .
     4363       undo, return error return-value .
     4364     end.
     4365     assign
     4366       p-fact-order           = v-fact-date-num
     4367                              + v-shift-offset * 0.5
     4368                              + p-shift-num    * 0.02 - 0.01
     4369                              + p-fact-num     * 0.0000000001
     4370       p-shift-end-fact-order = v-fact-date-num
     4371                              + v-shift-offset * 0.5
     4372                              + p-shift-num    * 0.02
     4373       p-day-end-fact-order   = v-fact-date-num
     4374                              + 0.99
     4375     .
     4376     if p-fact-order           <= v-fact-date-num
     4377     or p-shift-end-fact-order <= v-fact-date-num
     4378     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
     4379     or p-shift-end-fact-order >= p-day-end-fact-order
     4380     then do:
     4381       message
     4382         vss-workfile vss-revision vss-description skip
     4383         "Внутренняя ошибка при генерации фактического номера" skip
     4384         "p-fact-date"            p-fact-date            skip
     4385         "p-fact-time"            p-fact-time            skip
     4386         "p-fact-num"             p-fact-num             skip
     4387         "p-shift-date"           p-shift-date           skip
     4388         "p-shift-num"            p-shift-num            skip
     4389         "p-shift-on"             p-shift-on             skip
     4390         "p-shift-end-fact-order" p-shift-end-fact-order skip
     4391         "p-day-end-fact-order"   p-day-end-fact-order   skip
     4392         "v-fact-date-num"        v-fact-date-num        skip
     4393         view-as alert-box error .
     4394       undo, return error return-value .
     4395     end.
     4396   end procedure.
     4397   procedure day-begin-fact-order :
     4398     define input  parameter p-fact-date            as date    no-undo .
     4399     define output parameter p-day-begin-fact-order as decimal no-undo .
     4400     do
     4401     on error undo, return error return-value
     4402     :
     4403       if p-fact-date = ?
     4404       then do:
     4405         assign
     4406           p-day-begin-fact-order = 0
     4407         .
     4408       end.
     4409       else do:
     4410         assign
     4411           p-day-begin-fact-order = integer(p-fact-date)
     4412         .
     4413       end.
     4414     end.
     4415   end procedure.
     4416   procedure factord-max-fact-order :
     4417     define output parameter p-max-fact-order as decimal   no-undo .
     4418     do
     4419     on error undo, return error return-value
     4420     :
     4421       run day-begin-fact-order in this-procedure
     4422         (input  date(1, 1, 5000)
     4423         ,output p-max-fact-order
     4424         ) .
     4425     end.
     4426   end procedure.
     4427   procedure factord-cut-archive :
     4428     define input  parameter p-obj-type             as character no-undo .
     4429     define input  parameter p-obj-code             as integer   no-undo .
     4430     define input  parameter p-fact-date            as date      no-undo .
     4431     define output parameter p-shift-on             as logical   no-undo .
     4432     define output parameter p-shift-date           as date      no-undo .
     4433     define output parameter p-shift-num            as integer   no-undo .
     4434     define output parameter p-day-end-fact-order   as decimal   no-undo .
     4435     define output parameter p-shift-end-fact-order as decimal   no-undo .
     4436     define variable v-fact-order as decimal   no-undo .
     4437     define buffer buf_shift-obj for ub.shift-obj .
     4438     do
     4439     on error undo, return error return-value
     4440     :
     4441   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4442   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     4443     (input  p-obj-type
     4444     ,input  p-obj-code
     4445     ,input  'shift-on=request'
     4446     ,output p-shift-on
     4447     ) no-error .
     4448       if error-status :error
     4449       then do:
     4450         message
     4451           vss-workfile vss-revision vss-description skip
     4452           "Ошибка при определении атрибута объекта" skip
     4453           "Объект" p-obj-type p-obj-code skip
     4454           error-status :get-message(1) skip
     4455           return-value skip
     4456           view-as alert-box error .
     4457         undo, return error return-value .
     4458       end.
     4459       if p-shift-on = false
     4460       then do:
     4461         assign
     4462           p-shift-date               = ?
     4463           p-shift-num                = 0
     4464         .
     4465       end.
     4466       else do:
     4467         find first buf_shift-obj share-lock
     4468           where buf_shift-obj.obj-type   = p-obj-type
     4469             and buf_shift-obj.obj-code   = p-obj-code
     4470             and buf_shift-obj.shift-date > p-fact-date
     4471           use-index pi
     4472           no-error .
     4473         if not available buf_shift-obj
     4474         or buf_shift-obj.status_ <> 'зкр':U
     4475         then do:
     4476           message
     4477             vss-workfile vss-revision vss-description skip
     4478             "Невозможно вычислить последнюю смену" skip
     4479             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
     4480             "Объект" p-obj-type p-obj-code skip
     4481             "Дата" p-fact-date skip
     4482             view-as alert-box error .
     4483           undo, return error return-value .
     4484         end.
     4485         find last buf_shift-obj share-lock
     4486           where buf_shift-obj.obj-type = p-obj-type
     4487             and buf_shift-obj.obj-code = p-obj-code
     4488             and buf_shift-obj.shift-date <= p-fact-date
     4489           use-index pi
     4490           no-error .
     4491         if available buf_shift-obj
     4492         then do:
     4493           if  buf_shift-obj.status_ = 'зкр':U
     4494           then do:
     4495             assign
     4496               p-shift-date = buf_shift-obj.shift-date
     4497               p-shift-num  = buf_shift-obj.shift-num
     4498             .
     4499           end.
     4500           else do:
     4501             message
     4502               vss-workfile vss-revision vss-description skip
     4503               "Невозможно вычислить последнюю смену" skip
     4504               "Статус смены отличен от статуса" 'зкр':U skip
     4505               "Объект" p-obj-type p-obj-code skip
     4506               "Дата" p-fact-date skip
     4507               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     4508               view-as alert-box error .
     4509             undo, return error return-value .
     4510           end.
     4511         end.
     4512         else do:
     4513           assign
     4514             p-shift-date = p-fact-date - 1
     4515             p-shift-num  = 1
     4516           .
     4517         end.
     4518       end.
     4519       run factord in this-procedure
     4520         (input  p-fact-date
     4521         ,input  1
     4522         ,input  1
     4523         ,input  p-shift-date
     4524         ,input  p-shift-num
     4525         ,input  p-shift-on
     4526         ,output v-fact-order
     4527         ,output p-shift-end-fact-order
     4528         ,output p-day-end-fact-order
     4529         ) no-error .
     4530       if error-status :error
     4531       then do:
     4532         message
     4533           vss-workfile vss-revision vss-description skip
     4534           "Ошибка при вызове процедуры factord"
     4535           error-status :get-message(1) skip
     4536           return-value skip
     4537           view-as alert-box error .
     4538         undo, return error return-value .
     4539       end.
     4540     end.
     4541   end procedure.
     4542   procedure factord-lock-shift :
     4543     define input  parameter p-obj-type  as character no-undo .
     4544     define input  parameter p-obj-code  as integer   no-undo .
     4545     define input  parameter p-fact-date as date      no-undo .
     4546     define parameter buffer buf_shift-obj for ub.shift-obj .
     4547     define variable v-shift-on      as logical   no-undo .
     4548     define variable v-extra-message as character no-undo .
     4549     define variable v-error as character no-undo .
     4550     do
     4551     on error undo, return error return-value
     4552     :
     4553   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4554   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     4555     (input  p-obj-type
     4556     ,input  p-obj-code
     4557     ,input  'shift-on=request'
     4558     ,output v-shift-on
     4559     ) no-error .
     4560       if error-status :error
     4561       then do:
     4562         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     4563         undo, return error v-error .
     4564       end.
     4565       if v-shift-on = true
     4566       then do:
     4567         find first buf_shift-obj share-lock
     4568           where buf_shift-obj.obj-type   = p-obj-type
     4569             and buf_shift-obj.obj-code   = p-obj-code
     4570             and buf_shift-obj.shift-date > p-fact-date
     4571           use-index pi
     4572           no-error .
     4573         if not available buf_shift-obj
     4574         or buf_shift-obj.status_ <> 'зкр':U
     4575         then do:
     4576           find last buf_shift-obj
     4577             where buf_shift-obj.obj-type = p-obj-type
     4578               and buf_shift-obj.obj-code = p-obj-code
     4579               and buf_shift-obj.status_  = 'зкр':U
     4580             use-index stts
     4581             no-error .
     4582           if available buf_shift-obj
     4583           then do:
     4584             assign
     4585               v-extra-message =
     4586                     substitute("Дата начала последеней закрытой смены на объекте &1"
     4587                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     4588                               )
     4589             .
     4590           end.
     4591           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     4592           undo, return error v-error .
     4593         end.
     4594       end.
     4595     end.
     4596   end procedure.
     4597   procedure factord-end-day :
     4598     define input  parameter p-fact-date            as date    no-undo .
     4599     define output parameter p-day-end-fact-order   as decimal no-undo .
     4600     do
     4601     on error undo, return error return-value
     4602     :
     4603       if p-fact-date = ?
     4604       then do:
     4605         return error "Не указана фактическая дата" .
     4606       end.
     4607       assign
     4608         p-day-end-fact-order = integer(p-fact-date) + 0.99
     4609       .
     4610     end.
     4611   end procedure.
     4612   procedure factord-to-date :
     4613     define input  parameter p-fact-order as decimal no-undo .
     4614     define output parameter p-fact-date  as date    no-undo .
     4615     define variable v-ref-date  as date      no-undo .
     4616     define variable v-ref-delta as integer   no-undo .
     4617     do
     4618     on error undo, return error return-value
     4619     :
     4620       if p-fact-order = ?
     4621       or p-fact-order = 0
     4622       then do:
     4623         return error "Не указан fact-order" .
     4624       end.
     4625       assign
     4626         v-ref-date  = date(1, 1, 2000)
     4627       .
     4628       assign
     4629         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     4630       .
     4631       assign
     4632         p-fact-date = v-ref-date + v-ref-delta
     4633       .
     4634     end.
     4635   end procedure.
     4636   procedure factord-to-fact-num :
     4637     define input  parameter p-fact-order as decimal no-undo .
     4638     define output parameter p-fact-num   as integer no-undo .
     4639     define variable v-fact-order-trunc as decimal no-undo .
     4640     do
     4641     on error undo, return error return-value
     4642     :
     4643       if p-fact-order = ?
     4644       or p-fact-order = 0
     4645       then do:
     4646         return error "Не указан fact-order" .
     4647       end.
     4648       assign
     4649        v-fact-order-trunc = truncate(p-fact-order, 2)
     4650       .
     4651       assign
     4652         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     4653       .
     4654     end.
     4655   end procedure.
     4656   procedure factord-to-shift-num :
     4657     define input  parameter p-fact-order as decimal no-undo .
     4658     define output parameter p-shift-num   as integer no-undo .
     4659     define variable  p-shift-numd  as decimal   no-undo .
     4660     define variable v-fact-order-trunc as decimal no-undo .
     4661     do
     4662     on error undo, return error return-value
     4663     :
     4664       if p-fact-order = ?
     4665       or p-fact-order = 0
     4666       then do:
     4667         return error "Не указан fact-order" .
     4668       end.
     4669       assign
     4670        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     4671       .
     4672       if v-fact-order-trunc < 0.5 then do:
     4673         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     4674       end.
     4675       assign
     4676         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     4677         .
     4678        assign
     4679         p-shift-num = truncate (p-shift-numd , 0)
     4680       .
     4681     end.
     4682   end procedure.
