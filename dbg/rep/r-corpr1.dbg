     4816   define input parameter parcons-vat-pc      like ub.doc-line.cons-vat-pc no-undo.
     4817   define input parameter parslt-pc           like ub.doc-line.slt-pc      no-undo.
     4818   define input parameter parbase-rate        like ub.trn-doc.base-rate    no-undo.
