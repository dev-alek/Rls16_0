     6459         assign
     6460           varcur-base      = varcur-base      / varcur-fact-qnty
     6461           varcur-road-tax  = varcur-road-tax  / varcur-fact-qnty
     6462           varcur-excise    = varcur-excise    / varcur-fact-qnty
     6463         .
     6464       end.
     6465       if varcur-vat-pc = ?
     6466       then do:
     6467         return error substitute ("Нет текущего продажного НДС по товару &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     6468       end.
     6469       if varcur-slt-pc = ?
     6470       then do:
     6471         return error substitute ("Нет текущего продажного НП по товару &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     6472       end.
     6473       find first bf_sysconf where bf_sysconf.host-code = bf_trn-doc.host-code no-lock.
     6474       assign
     6475         varcur-cons-vat-pc = bf_sysconf.cons-vat-pc.
     6476       if varcur-cons-vat-pc = ? then do:
     6477         return error substitute ("Нет текущего продажного консигнационного НДС по фирме &1", bf_trn-doc.host-code).
     6478       end.
     6479       define buffer buf_tt-clcparts for tt-clcparts .
     6480       for each buf_tt-clcparts
     6481       on error undo, return error return-value
     6482       :
     6483         delete buf_tt-clcparts.
     6484       end.
     6485       for each bf_parts no-lock
     6486         where bf_parts.out-code  = bf_doc-line.doc-code
     6487           and bf_parts.obj-type  = bf_doc-line.obj-type
     6488           and bf_parts.obj-code  = bf_doc-line.obj-code
     6489           and bf_parts.artic     = bf_doc-line.artic
     6490           and bf_parts.prod-type = bf_doc-line.prod-type
     6491           and bf_parts.prod-code = bf_doc-line.prod-code
     6492       on error undo, return error return-value
     6493       :
     6494         create buf_tt-clcparts .
     6495         buffer-copy bf_parts to buf_tt-clcparts .
     6496         if v-calcbypart = yes   then do:
     6497   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run partbcod in g#library
     6498     (buffer bf_parts
     6499     ,output v-b-pcode
     6500     ) no-error .
     6501   define variable vss-include-info38 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6502   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     6503     (input  bf_parts.obj-type
     6504     ,input  bf_parts.obj-code
     6505     ,input  v-b-pcode
     6506     ,input  0
     6507     ,input  bf_trn-doc.fact-order
     6508     ,output vardoc-num
     6509     ,output varprice-salef
     6510     ,output varroad-tax
     6511     ,output varexcise
     6512     ) no-error .
     6513             if varprice-sale = ?
     6514             then do:
     6515               assign
     6516                 varprice-salef = 0
     6517                 varroad-tax   = 0
     6518                 varexcise     = 0
     6519               .
     6520             end.
     6521             assign
     6522             part-cur-base  = varprice-salef
     6523             part-cur-road-tax  = varroad-tax
     6524             part-cur-excise = varexcise.
     6525         end.
     6526       end.
     6527       run clcprtsl_calc-ttable in this-procedure
     6528         (input yes,
     6529          input yes,
     6530          input bf_doc-line.road-tax,
     6531          input bf_doc-line.excise,
     6532          input bf_doc-line.vat-pc,
     6533          input bf_doc-line.cons-vat-pc,
     6534          input bf_doc-line.slt-pc,
     6535          input bf_trn-doc.base-rate,
     6536          input bf_trn-doc.base-scale,
     6537          input varr-b,
     6538          input varcur-base,
     6539          input varcur-road-tax,
     6540          input varcur-excise,
     6541          input varcur-vat-pc,
     6542          input varcur-cons-vat-pc,
     6543          input varcur-slt-pc
     6544          ) no-error.
     6545       if error-status:error then do:
     6546         message
     6547           vss-workfile vss-revision vss-description skip
     6548           "Ошибка при вызове процедуры clcprtsl_calc-ttable." skip
     6549           return-value skip
     6550           trim(error-status :get-message(1))
     6551           trim(error-status :get-message(2))
     6552           trim(error-status :get-message(3))
     6553           trim(error-status :get-message(4))
     6554           trim(error-status :get-message(5)) skip
     6555           view-as alert-box error.
     6556         undo, return error .
     6557       end.
     6558     end.
     6559   end.
     6560   end.
     6561   procedure clcprtsl_calc-ttable :
     6562   define input parameter paris-doc           as   logical                 no-undo.
     6563   define input parameter paris-cur           as   logical                 no-undo.
     6564   define input parameter parroad-tax         like ub.doc-line.road-tax    no-undo.
     6565   define input parameter parexcise           like ub.doc-line.excise      no-undo.
     6566   define input parameter parvat-pc           like ub.doc-line.vat-pc      no-undo.
     6567   define input parameter parcons-vat-pc      like ub.doc-line.cons-vat-pc no-undo.
     6568   define input parameter parslt-pc           like ub.doc-line.slt-pc      no-undo.
     6569   define input parameter parbase-rate        like ub.trn-doc.base-rate    no-undo.
     6570   define input parameter parbase-scale       like ub.trn-doc.base-scale   no-undo.
     6571   define input parameter parr-b              as   character               no-undo.
     6572   define input parameter parcur-base         like ub.gds-dtl.cur-base     no-undo.
     6573   define input parameter parcur-road-tax     like ub.doc-line.road-tax    no-undo.
     6574   define input parameter parcur-excise       like ub.doc-line.excise      no-undo.
     6575   define input parameter parcur-vat-pc       like ub.doc-line.vat-pc      no-undo.
     6576   define input parameter parcurcons-vat-pc   like ub.doc-line.cons-vat-pc no-undo.
     6577   define input parameter parcurslt-pc        like ub.doc-line.slt-pc      no-undo.
     6578   define buffer bf_tt-allsum      for tt-allsum.
     6579   define buffer bf_tt-clcparts    for tt-clcparts.
     6580   define buffer bf_tt-allsum-line for tt-allsum-line.
     6581   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     6582   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     6583   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     6584   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     6585   define variable varexcise          like ub.price-list.excise     no-undo.
     6586   do on error undo, return error return-value :
     6587   for each bf_tt-allsum-line
     6588   on error undo, return error return-value
     6589    :
     6590     delete bf_tt-allsum-line.
     6591   end.
     6592   for each bf_tt-allsum
     6593   on error undo, return error return-value
     6594   :
     6595     delete bf_tt-allsum.
     6596   end.
     6597   for each bf_tt-clcparts
     6598   on error undo, return error return-value
     6599   :
     6600   if v-calcbypart then do:
     6601             assign
     6602             parcur-base =   bf_tt-clcparts.part-cur-base
     6603             parcur-road-tax = bf_tt-clcparts.part-cur-road-tax
     6604             parcur-excise =   bf_tt-clcparts.part-cur-excise
     6605             .
     6606   end.
     6607      run clcprtsl_calc-parts in this-procedure (
     6608        input recid(bf_tt-clcparts),
     6609        input paris-doc,
     6610        input paris-cur,
     6611        input parroad-tax,
     6612        input parexcise,
     6613        input parvat-pc,
     6614        input parcons-vat-pc,
     6615        input parslt-pc,
     6616        input parbase-rate,
     6617        input parbase-scale,
     6618        input parr-b,
     6619        input parcur-base,
     6620        input parcur-road-tax,
     6621        input parcur-excise,
     6622        input parcur-vat-pc,
     6623        input parcurcons-vat-pc,
     6624        input parcurslt-pc
     6625        ) no-error.
     6626     if error-status:error then do:
     6627       message
     6628         vss-workfile vss-revision vss-description skip
     6629         vss-include-info25 skip
     6630         "Ошибка при обсчете партии" skip
     6631         "Документ партии " bf_tt-clcparts.out-code skip
     6632         "Товар" bf_tt-clcparts.artic bf_tt-clcparts.prod-type bf_tt-clcparts.prod-code skip
     6633         return-value skip
     6634         error-status:get-message(1) skip
     6635         error-status:get-message(2) skip
     6636         error-status:get-message(3) skip
     6637         view-as alert-box error .
     6638       undo, return error .
     6639     end.
     6640     for each bf_tt-allsum on error undo, return error return-value :
     6641       find first bf_tt-allsum-line where bf_tt-allsum-line.sum-type = bf_tt-allsum.sum-type no-error.
     6642       if not available bf_tt-allsum-line then do:
     6643         create bf_tt-allsum-line.
     6644         assign
     6645           bf_tt-allsum-line.sum-type = bf_tt-allsum.sum-type.
     6646       end.
     6647       assign
