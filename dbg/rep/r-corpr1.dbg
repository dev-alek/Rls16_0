     7242           sym12 column-label ":!:!:!:!:" format "X(1)" space(0)
     7243           gds-prop.sum-no-VAT COLUMN-LABEL "Сумма без!НДС и НП! ! ! " format "->>,>>>,>>9.99" space(0)
     7244           sym13 column-label ":!:!:!:!:" format "X(1)" space(0)
     7245           gds-prop.VAT-pc column-label "Став-!ка!НДС!%! " format ">9.9<" space(0)
     7246           sym14 column-label ":!:!:!:!:" format "X(1)" space(0)
     7247           gds-prop.VAT column-label "Сумма!НДС! ! ! " format "->>,>>>,>>9.99" space(0)
     7248           sym15 column-label ":!:!:!:!:" format "X(1)" space(0)
     7249           gds-prop.stoim column-label "Сумма!с учетом!НДС (без НП)! ! " format "->>>,>>>,>>9.99" space(0)
     7250           sym16 column-label ":!:!:!:!:" format "X(1)" space(0)
     7251       header
     7252           string( "Цены и суммы указаны в " + trim( val-str ) ) format "X(30)"
     7253           string( "Документ N: " + tdoc-code + " от " + v-doc-date-string ) at 40 format "X(50)"
     7254            string( "Страница " + string( PAGE-NUMBER( PrnLibStream ), ">>9" ) ) at 180 format "X(13)" SKIP
     7255           v-single-line format "X(198)" at 1
     7256     with width 235 down stream-io.
     7257     assign
     7258       v-single-line = fill("-", 230)
     7259       v-underline = fill("_", 230)
     7260       v-line-counter = 1
     7261       v-doc-line-counter = 1
     7262     .
     7263       if x-SET_val_TYPE = 1 then assign v-curr-code = 0 .
     7264       else assign v-curr-code = base-code .
     7265       run torgconf-read in this-procedure (
     7266             input "torg12"
     7267           , input v-cntxt-host-code-obj
     7268           , input v-obj-type
     7269           , input v-obj-code
     7270       ) no-error.
     7271       if error-status :error
     7272       then do:
     7273           message
     7274           vss-workfile vss-revision vss-description
     7275           skip "Ошибка чтения параметров печати формы."
     7276           skip "Форма будет напечатана с параметрами по умолчанию."
     7277           skip return-value
     7278           skip trim(error-status :get-message(1))
     7279               trim(error-status :get-message(2))
     7280               trim(error-status :get-message(3))
     7281           view-as alert-box error.
     7282       end.
     7283     if v-torgconf-outdate = yes then  assign v-doc-date-string =  "          " .
     7284     else  assign v-doc-date-string = string( x-date-end, "99/99/9999" ) .
     7285   if session :set-wait-state( "compiler" ) then.
     7286     run prn-lib-open-stream  in this-procedure (input my-handle,input 43,input yes,input no).
     7287     form header
     7288       v-single-line format "X(198)" at 1 SKIP
     7289       "Продолжение - на следующей странице" at 30 SKIP
     7290       with frame BottomFrame width 235 PAGE-BOTTOM NO-LABELS NO-BOX .
     7291     view stream PrnLibStream frame BottomFrame .
     7292     assign  val-str =  if x-SET_val_TYPE = 1 then "рублях" else base-type .
     7293     find first clients no-lock  where clients.obj-type = 'орг':U   and clients.obj-code = v-cntxt-host-code-obj .
     7294       case clients.obj-type:
     7295          when 'орг':U
     7296          then do:
     7297               FIND ub.firm WHERE ub.firm.firm-code = clients.obj-code NO-LOCK .
     7298               if available ub.firm
     7299               then do:
     7300                   assign
     7301                       t-addres = ( if ub.firm.ind = 0 or ub.firm.ind = ? then "" else string( ub.firm.ind ) )
     7302                       t-addres = t-addres
     7303                           + ( if ub.firm.city = ? or trim(ub.firm.city) = ""
     7304                               then ""
     7305                               else ( (if t-addres = "" then "" else ", ") + trim( ub.firm.city ) )
     7306                             )
     7307                       t-temp-address = ( if ub.firm.addres1 = ? then "" else trim( substring( ub.firm.addres1, 1, 50 ) ) )
     7308                       t-addres = t-addres + ( if t-addres = "" or t-temp-address = "" then "" else ", " )
     7309                           + ( if t-temp-address = "" then "" else ( trim( t-temp-address ) ) )
     7310                           + ( if  ub.firm.addres2 = ? or trim(ub.firm.addres2) = "" then "" else ( ", " + trim( ub.firm.addres2 ) ) )
     7311                       t-temp-address = ( if ub.firm.addres1 = ? then "" else trim( substring( ub.firm.addres1, 51, 50 ) ) )
     7312                       t-addres = t-addres + ( if t-addres = "" or t-temp-address = "" then "" else ", " )
     7313                           + ( if t-temp-address = "" then "" else ( trim( t-temp-address ) ) )
     7314                       t-temp-address = ( if ub.firm.addres1 = ? then "" else trim( substring( ub.firm.addres1, 101, 50 ) ) )
     7315                       t-addres = t-addres + ( if t-addres = "" or t-temp-address = "" then "" else ", " )
     7316                           + ( if t-temp-address = "" then "" else ( trim( t-temp-address ) ) )
     7317                       t-phone = ub.firm.phone
     7318                       t-inn   = ub.firm.inn
     7319                       t-okpo  = ub.firm.okpo
     7320                   .
     7321               end.
     7322          end.
     7323          when 'маг':U
     7324          then do:
     7325               FIND ub.shop WHERE ub.shop.obj-code = clients.obj-code NO-LOCK .
     7326               if available ub.shop
     7327               then do:
     7328                   assign
     7329                       t-addres = ( if trim( shop.addres1 ) <> "" then ( trim( shop.addres1 ) ) else "" )
     7330                               + ( if trim( shop.addres2 ) <> "" then ( ", " + trim( shop.addres2 ) ) else "" )
     7331                       t-phone = shop.phone
     7332                       t-inn = ""
     7333                       t-okpo = ""
     7334                   .
     7335               end.
     7336          end.
     7337          when 'скл':U
     7338          then do:
     7339               FIND ub.store WHERE ub.store.obj-code = clients.obj-code NO-LOCK .
     7340               if available ub.store
     7341               then do:
     7342                   assign
     7343                       t-addres = ( if trim( ub.store.addres1 ) <> "" then ( trim( ub.store.addres1 ) ) else "" )
     7344                               + ( if trim( ub.store.addres2 ) <> "" then ( ", " + trim( ub.store.addres2 ) ) else "" )
     7345                       t-phone = ub.store.phone
     7346                       t-inn = ""
     7347                       t-okpo = ""
     7348                   .
     7349               end.
     7350          end.
     7351          when 'чел':U
