     7039     run day-begin-fact-order in this-procedure ( input ( x-date-end + 1 ),   output v-fact-order-end ).
     7040     for each obj-list no-lock :
     7041       assign
     7042         v-obj-type = obj-list.obj-type
     7043         v-obj-code = obj-list.obj-code
     7044       .
     7045       for each buf_trn-doc no-lock
     7046         where buf_trn-doc.obj-type = obj-list.obj-type
     7047           and buf_trn-doc.obj-code = obj-list.obj-code
     7048           and buf_trn-doc.status_  = 'факт':U
     7049           and buf_trn-doc.fact-order >= v-fact-order-start
     7050           and buf_trn-doc.fact-order < v-fact-order-end
     7051         :
     7052         if buf_trn-doc.ext-doc-type <> 'pc':U then next .
     7053         for each parts-root no-lock where parts-root.doc-code = buf_trn-doc.doc-code :
     7054           find first buf_goods where buf_goods.gds-code = parts-root.gds-code no-lock .
     7055           find first buf_parts no-lock
     7056             where buf_parts.artic     = buf_goods.artic
     7057               and buf_parts.prod-code = buf_goods.prod-code
     7058               and buf_parts.prod-type = buf_goods.prod-type
     7059               and buf_parts.part-code = parts-root.part-code
     7060               and buf_parts.in-code   = parts-root.in-code
     7061               and buf_parts.out-code  = buf_trn-doc.doc-code
     7062               and buf_parts.obj-code  = buf_trn-doc.obj-code
     7063               and buf_parts.obj-type  = buf_trn-doc.obj-type
     7064             no-error .
     7065           if (buf_parts.supp-type <> p-cli-type or buf_parts.supp-code <> p-cli-code) then next .
     7066           find first gds-prop
     7067             where gds-prop.artic     = buf_goods.artic
     7068               and gds-prop.prod-code = buf_goods.prod-code
     7069               and gds-prop.prod-type = buf_goods.prod-type
     7070               and gds-prop.part-code = parts-root.part-code
     7071               and gds-prop.in-code   = parts-root.in-code
     7072             no-error .
