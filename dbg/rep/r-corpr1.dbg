     1513   define variable v-form-name    as character    no-undo.
     1514   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1515   procedure wthcattr-sprcli :
     1516   define input parameter parparentproc  as widget-handle no-undo.
     1517   define input parameter p-mode  as character no-undo.
     1518   define input-output parameter p-value as character no-undo .
     1519   define output parameter p-setted as logical no-undo .
     1520     DEFINE VARIABLE v-value as character no-undo .
     1521     define variable v-cli-type as character no-undo .
     1522     define variable v-cli-code as integer no-undo .
     1523     define buffer buf_clients   for ub.clients.
     1524     define variable v_rid as character no-undo.
     1525     define variable ref-rec as recid no-undo .
     1526     do
     1527     on error undo, return error
     1528     :
     1529         v-value = p-value.
     1530      if p-value <> '':U then do:
     1531       assign
     1532       v-cli-type = substring(p-value, 1, 3)
     1533       v-cli-code = integer(substring(p-value, 4))
     1534       no-error.
     1535       if error-status:error then do:
     1536         assign
     1537         v-cli-type = '':U
     1538         v-cli-code = 0
     1539         .
     1540       end.
     1541      end.
     1542      FIND FIRST buf_clients NO-LOCK WHERE
     1543               buf_clients.obj-type = v-cli-type AND
     1544               buf_clients.obj-code = v-cli-code  NO-ERROR.
     1545      IF available(buf_clients) then do:
     1546       run ref/cli-all.w (
     1547                   input parparentproc
     1548                  ,input if p-mode = 'ИЗМЕНЕНИЕ':U then "b-sel":U else "":U
     1549                  ,input v-cli-type
     1550                  ,input 'все':U
     1551                  ,input 'все':U
     1552                  ,input RECID( buf_clients )
     1553                  ,input ",,,,,,NO"
     1554                  ,input ?
     1555                  ,OUTPUT v_rid ).
     1556     END.
     1557     ELSE if p-mode = 'ИЗМЕНЕНИЕ':U then DO:
     1558       run ref/cli-all.w (
     1559                    input parparentproc
     1560                   ,INPUT "b-sel":U
     1561                  ,input  v-cli-type
     1562                  ,input 'все':U
     1563                  ,input 'текущие':U
     1564                  ,input ?
     1565                  ,input ",,,,,,NO"
     1566                  ,input ?
     1567                  ,OUTPUT v_rid ).
     1568     END.
     1569     else do:
     1570       message
     1571       if p-value = "":U then 'Атрибут не задан!'
     1572       else substitute('Не найден клиент &1',p-value)
     1573       view-as alert-box warning.
     1574     end.
     1575     IF v_rid <> ? AND v_rid <> "":U THEN DO:
     1576       ASSIGN ref-rec = INT( v_rid ) NO-ERROR.
     1577       IF ERROR-STATUS:ERROR THEN DO:
     1578           RETURN NO-APPLY.
     1579       END.
     1580       FIND FIRST buf_clients NO-LOCK WHERE
     1581                  RECID( buf_clients ) = ref-rec NO-ERROR.
     1582       IF AVAIL buf_clients THEN DO:
     1583         v-value = buf_clients.obj-type + string(buf_clients.obj-code, ">>>>>>>>9").
     1584       end.
     1585     end.
     1586     if v-value <> p-value then do:
     1587       p-value = v-value.
     1588       p-setted = yes.
     1589     end.
     1590     end.
     1591   end procedure.
     1592     define new global shared variable g#wthcalib as handle no-undo.
     1593   procedure torgconf-read :
     1594   do
     1595   on error undo, return error
     1596   :
     1597       define input parameter p-form-name  as character    no-undo.
     1598       define input parameter p-host-code  as integer      no-undo.
     1599       define input parameter p-obj-type   as character    no-undo.
     1600       define input parameter p-obj-code   as integer      no-undo.
     1601       define variable v-outdate   as character     no-undo.
     1602       define variable v-outares   as character     no-undo.
     1603       define variable v-outsend   as character     no-undo.
     1604       define variable v-outasend  as character     no-undo.
     1605       define variable v-outprops  as character     no-undo.
     1606       define variable v-outnum    as character     no-undo.
     1607       define variable v-outprim   as character     no-undo.
     1608       define variable v-outdisc   as character     no-undo.
     1609       define variable v-outsubs   as character     no-undo.
     1610       define variable v-outrecv   as character     no-undo.
     1611       define variable v-outegrp   as character     no-undo.
     1612       define variable v-outt12    as character     no-undo.
     1613       define variable v-outappr   as character     no-undo.
     1614       define variable v-outrubl   as character     no-undo.
     1615       define variable v-outhold   as character     no-undo.
     1616       define variable v-outobj    as character     no-undo.
     1617       define variable v-outexlst  as character     no-undo.
     1618       define variable v-outprncd  as character     no-undo.
     1619       define variable v-par-type  as character     no-undo.
     1620       define variable v-outogr    as character     no-undo.
     1621       define variable v-outR      as character     no-undo.
     1622       define variable v-outB      as character     no-undo.
     1623       define variable v-outC      as character     no-undo.
     1624       assign
     1625           v-torgconf-outdate  = no
     1626           v-torgconf-outnum   = no
     1627           v-torgconf-outprim  = no
     1628           v-torgconf-outdisc  = no
     1629           v-torgconf-outsubs  = no
     1630           v-torgconf-outrecv  = no
     1631           v-torgconf-outegrp  = no
     1632           v-torgconf-outt12   = no
     1633           v-torgconf-outappr  = no
     1634           v-torgconf-outrubl  = no
     1635           v-torgconf-outhold  = no
     1636           v-torgconf-outobj   = no
     1637           v-torgconf-outexlst = no
     1638           v-torgconf-outexpas = "":U
     1639           v-torgconf-outprncd = yes
     1640           v-torgconf-outares  = no
     1641           v-torgconf-outsend  = no
     1642           v-torgconf-outasend  = no
     1643           v-torgconf-outprops  = no
     1644           v-form-name          = p-form-name
     1645       .
     1646   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1647   empty temp-table thbjattr_thbj-attr.
     1648   run adm/shattri.p (
     1649      input "get":U
     1650     ,input ''
     1651     ,input 0
     1652     ,input 'prt-glob':U
     1653     ,input  ""
     1654     ,output v-value-character
     1655     ,output v-value-date
     1656     ,output v-value-decimal
     1657     ,output v-value-integer
     1658     ,output v-value-logical
     1659     ,output par-type
     1660     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     1661     ) no-error .
     1662   for each thbjattr_thbj-attr :
     1663       if thbjattr_thbj-attr.prop-code = 'outprncd':U then v-outprncd =  string(thbjattr_thbj-attr.property-value-logical) .
     1664       if thbjattr_thbj-attr.prop-code = 'outrecv':U  then v-outrecv  =  thbjattr_thbj-attr.property-value-character .
     1665       if thbjattr_thbj-attr.prop-code = 'outprops':U then v-outprops =  thbjattr_thbj-attr.property-value-character .
     1666   end.
     1667   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1668   empty temp-table thbjattr_thbj-attr.
     1669   run adm/shattri.p (
     1670      input "get":U
     1671     ,input p-obj-type
     1672     ,input p-obj-code
     1673     ,input 'prt-obj':U
     1674     ,input  ""
     1675     ,output v-value-character
     1676     ,output v-value-date
     1677     ,output v-value-decimal
     1678     ,output v-value-integer
     1679     ,output v-value-logical
     1680     ,output par-type
     1681     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     1682     ) no-error .
     1683   for each thbjattr_thbj-attr :
     1684       if thbjattr_thbj-attr.prop-code = 'outdate':U  then v-outdate  =  thbjattr_thbj-attr.property-value-character .
     1685       if thbjattr_thbj-attr.prop-code = 'outares':U  then v-outares  =  thbjattr_thbj-attr.property-value-character .
     1686       if thbjattr_thbj-attr.prop-code = 'outnum':U   then v-outnum   =  thbjattr_thbj-attr.property-value-character .
     1687       if thbjattr_thbj-attr.prop-code = 'outprim':U  then v-outprim  =  thbjattr_thbj-attr.property-value-character .
     1688       if thbjattr_thbj-attr.prop-code = 'outdisc':U  then v-outdisc  =  thbjattr_thbj-attr.property-value-character .
     1689       if thbjattr_thbj-attr.prop-code = 'outsubs':U  then v-outsubs  =  thbjattr_thbj-attr.property-value-character .
     1690       if thbjattr_thbj-attr.prop-code = 'outegrp':U  then v-outegrp  =  thbjattr_thbj-attr.property-value-character .
     1691       if thbjattr_thbj-attr.prop-code = 'outt12':U   then v-outt12   =  thbjattr_thbj-attr.property-value-character .
     1692       if thbjattr_thbj-attr.prop-code = 'outappr':U  then v-outappr  =  thbjattr_thbj-attr.property-value-character .
     1693       if thbjattr_thbj-attr.prop-code = 'outrubl':U  then v-outrubl  =  thbjattr_thbj-attr.property-value-character .
     1694       if thbjattr_thbj-attr.prop-code = 'outhold':U  then v-outhold  =  thbjattr_thbj-attr.property-value-character .
     1695       if thbjattr_thbj-attr.prop-code = 'outobj':U   then v-outobj   =  thbjattr_thbj-attr.property-value-character .
     1696       if thbjattr_thbj-attr.prop-code = 'outsend':U  then v-outsend  =  thbjattr_thbj-attr.property-value-character .
     1697       if thbjattr_thbj-attr.prop-code = 'outasend':U then v-outasend =  thbjattr_thbj-attr.property-value-character .
     1698       if thbjattr_thbj-attr.prop-code = 'outogr':U   then v-torgconf-outogr   =  thbjattr_thbj-attr.property-value-character .
     1699       if thbjattr_thbj-attr.prop-code = 'outR':U     then v-torgconf-outR     =  thbjattr_thbj-attr.property-value-character .
     1700       if thbjattr_thbj-attr.prop-code = 'outB':U     then v-torgconf-outB     =  thbjattr_thbj-attr.property-value-character .
     1701       if thbjattr_thbj-attr.prop-code = 'outssdoc':U then v-torgconf-outssdoc =  thbjattr_thbj-attr.property-value-character .
     1702       if thbjattr_thbj-attr.prop-code = 'outC':U     then v-torgconf-outC     =  thbjattr_thbj-attr.property-value-character .
     1703   end.
     1704       run gbl/conf-rd.p ("outexpas", "":U, "":U, 0, "":U, "":U, "":U, no, output v-torgconf-outexpas, output v-par-type) no-error.
     1705       if error-status :error
     1706       then do:
     1707           assign
     1708               v-torgconf-outexpas = "":U
     1709           .
     1710       end.
     1711       assign
     1712           v-torgconf-outprncd = ( v-outprncd = "yes":U )
     1713       .
     1714       if p-form-name <> ""
     1715       and p-form-name <> ?
     1716       then do:
     1717           run gbl/conf-rd.p ("outexlst" , p-host-code, p-obj-type, p-obj-code, "", "", "", no, output v-outexlst , output v-par-type) no-error.
     1718           if error-status :error
     1719           then do:
     1720               assign
     1721                   v-outexlst           = ""
     1722               .
     1723           end.
     1724           if lookup( p-form-name, v-outdate ) <> 0
     1725           then do:
     1726               assign
     1727                   v-torgconf-outdate  = yes
     1728               .
     1729           end.
     1730           if lookup( p-form-name, v-outares ) <> 0
     1731           then do:
     1732               assign
     1733                   v-torgconf-outares  = yes
     1734               .
     1735           end.
     1736           if lookup( p-form-name, v-outnum  ) <> 0
     1737           then do:
     1738               assign
     1739                   v-torgconf-outnum   = yes
     1740               .
     1741           end.
     1742           if lookup( p-form-name, v-outprim ) <> 0
