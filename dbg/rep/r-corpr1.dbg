     6976       ,input  0
     6977       ,input  'report-glob':U
     6978       ,input  'rep-excel':U
     6979       ,output v-value-character
     6980       ,output v-value-date
     6981       ,output v-value-decimal
     6982       ,output v-value-integer
     6983       ,output rep-excel
