     7119               gds-prop.sum-no-VAT   = gds-prop.sum-no-VAT   + ABSOLUTE(tt-allsum.sum-dsc-rubl-acc - tt-allsum.slt-rubl-acc - tt-allsum.vat-rubl-acc)
     7120               gds-prop.VAT          = gds-prop.VAT          + ABSOLUTE(tt-allsum.vat-rubl-acc)
     7121               gds-prop.stoim        = gds-prop.stoim        + ABSOLUTE(tt-allsum.sum-dsc-rubl-acc - tt-allsum.slt-rubl-acc)
     7122               gds-prop.sum          = gds-prop.sum          + ABSOLUTE(tt-allsum.sum-dsc-rubl-acc)
