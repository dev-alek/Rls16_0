     1831   procedure torgconf-get-self-param :
     1832   define input parameter p-obj-type           as character        no-undo.
     1833   define input parameter p-obj-code           as integer          no-undo.
     1834   define input parameter p-curr-code          as integer          no-undo.
     1835       define variable v-host-code    as integer      no-undo.
     1836       define variable v-par-type     as character    no-undo.
     1837   do
     1838   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message(1))
     1839   :
     1840   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1841   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1842     (input  p-obj-type
     1843     ,input  p-obj-code
     1844     ,output v-host-code
     1845     )  .
     1846       if v-torgconf-outhold = yes
     1847       then do:
     1848           run torgconf-get-holdfirm-code in this-procedure (
     1849                 input p-obj-type
     1850               , input p-obj-code
     1851               , output v-torgconf-self-host-code
     1852           ).
     1853           if v-torgconf-self-host-code = 0
     1854           then do:
     1855               return error.
     1856           end.
     1857       end.
     1858       else do:
     1859           assign
     1860               v-torgconf-self-host-code = v-host-code
     1861           .
     1862       end.
     1863       if v-torgconf-self-host-code = 0
     1864       then do:
     1865           assign
     1866               v-torgconf-self-host-name           = "":U
     1867               v-torgconf-self-host-addres         = "":U
     1868               v-torgconf-self-host-post-addres    = "":U
     1869               v-torgconf-self-host-phone          = "":U
     1870               v-torgconf-self-host-inn            = "":U
     1871               v-torgconf-self-host-kpp            = "":U
     1872               v-torgconf-self-host-okpo           = "":U
     1873               v-torgconf-self-host-egrip-date     = "":U
     1874               v-torgconf-self-host-egrip-num      = "":U
     1875           .
     1876       end.
     1877       else do:
     1878           run fmtcli-get-client in this-procedure (
     1879                 input 'орг':U
     1880               , input v-torgconf-self-host-code
     1881           ).
     1882           assign
     1883               v-torgconf-self-host-name        = v-fmtcli-name
     1884               v-torgconf-self-host-engl-name   = v-fmtcli-engl-name
     1885               v-torgconf-self-host-addres      = v-fmtcli-full-addres
     1886               v-torgconf-self-host-post-addres = v-fmtcli-post-addres
     1887               v-torgconf-self-host-phone       = v-fmtcli-phone
     1888               v-torgconf-self-host-inn         = v-fmtcli-inn
     1889               v-torgconf-self-host-kpp         = v-fmtcli-kpp
     1890               v-torgconf-self-host-okpo        = v-fmtcli-okpo
     1891           .
     1892           run gbl/clntat-v.p (
     1893                 input 'орг':U
     1894               , input v-torgconf-self-host-code
     1895               , input 'egrip-date':U
     1896               , output v-torgconf-self-host-egrip-date
     1897               , output v-par-type
     1898           ).
     1899           run gbl/clntat-v.p (
     1900                 input 'орг':U
     1901               , input v-torgconf-self-host-code
     1902               , input 'egrip-num':U
     1903               , output v-torgconf-self-host-egrip-num
     1904               , output v-par-type
     1905           ).
     1906           run fmtcli-get-bank in this-procedure (
     1907                 input v-host-code
     1908               , input 'орг':U
     1909               , input v-torgconf-self-host-code
     1910               , input p-curr-code
     1911           ).
     1912       end.
     1913       assign
     1914           v-torgconf-self-schet-exists = v-fmtcli-schet-exists
     1915           v-torgconf-self-bank-exists  = v-fmtcli-bank-exists
     1916           v-torgconf-self-bank-r-schet = v-fmtcli-bank-r-schet
     1917           v-torgconf-self-bank-c-schet = v-fmtcli-bank-c-schet
     1918           v-torgconf-self-bank-bik     = v-fmtcli-bank-bik
     1919           v-torgconf-self-bank-name    = v-fmtcli-bank-name
     1920           v-torgconf-self-bank-addres  = v-fmtcli-bank-addres
     1921           v-torgconf-self-bank-city    = v-fmtcli-bank-city
     1922       .
     1923       assign
     1924           v-torgconf-self-obj-type = p-obj-type
     1925           v-torgconf-self-obj-code = p-obj-code
     1926       .
     1927       run fmtcli-get-client in this-procedure (
     1928             input p-obj-type
     1929           , input p-obj-code
     1930       ).
     1931       assign
     1932           v-torgconf-self-obj-name       = v-fmtcli-name
     1933           v-torgconf-self-obj-engl-name  = v-fmtcli-engl-name
     1934           v-torgconf-self-obj-addres     = v-fmtcli-full-addres
     1935           v-torgconf-temp-post-addres    = v-fmtcli-post-addres
     1936           v-torgconf-self-obj-phone      = v-fmtcli-phone
     1937           v-torgconf-self-obj-inn        = v-fmtcli-inn
     1938           v-torgconf-self-obj-okpo       = v-fmtcli-okpo
     1939       .
     1940   end.
     1941   end procedure.
     1942   procedure torgconf-get-recepient-param :
     1943   define input parameter torgconfdoc-code   as character                  no-undo.
     1944   define output parameter v-code-rec        as integer                    no-undo .
     1945   define output parameter v-type-rec        as character                  no-undo initial 'C':U.
     1946   define output parameter v-codefirm-rec    as integer                    no-undo .
     1947   define output parameter v-curcode-rec     as integer                    no-undo .
     1948        define variable  v-recipient-code  as character                  no-undo .
     1949        define variable  v-recipient       like ub.doc-attr.attr-value   no-undo.
     1950        define variable  v-trdcattr-type   as character                  no-undo initial 'C':U.
     1951   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input torgconfdoc-code ,
     1952                           input 'Recipient':U ,
     1953                          output v-recipient-code ,
     1954                          output v-trdcattr-type ) no-error .
     1955       if error-status :error then do:
     1956        message
     1957         vss-workfile vss-revision vss-description skip
     1958         "Ошибка при вызове процедуры tdat-val":U skip
     1959         "Документ: " torgconfdoc-code skip
     1960         "Атрибут: " 'Recipient':U skip
     1961         "Значение: " v-recipient skip
     1962         trim( error-status :get-message (1) ) skip
     1963         return-value skip
     1964         view-as alert-box error.
     1965       undo, return error return-value.
     1966       end.
     1967     assign
     1968       v-recipient  = v-recipient-code
     1969       v-type-rec = substring(v-recipient-code,1,3)
     1970       v-code-rec  = int(substring(v-recipient-code,4,15))
     1971       no-error
     1972     .
     1973     if v-type-rec = ? then v-type-rec = "" .
     1974     if v-code-rec  = ? then v-code-rec  =  0 .
     1975     end procedure.
