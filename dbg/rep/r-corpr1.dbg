     6869       on error undo, return error
     6870       :
     6871       run prn-lib-get-report-name  in this-procedure (
     6872         input parParentProc
     6873         ,output v-report-name
     6874         ).
     6875       if p-is-stream then
     6876       do:
     6877         if p-append then
     6878         do:
     6879           output stream PrnLibStream to value( v-report-name )
     6880             page-size value(p-page-size) append .
     6881         end.
     6882         if not p-append then
     6883         do:
     6884           output stream PrnLibStream to value( v-report-name )
     6885             page-size value(p-page-size) .
     6886         end.
     6887       end.
     6888       if not p-is-stream then
     6889       do:
     6890         if p-append then
     6891         do:
     6892           output to value( v-report-name )
     6893             page-size value(p-page-size) append .
     6894         end.
     6895         if not p-append then
     6896         do:
     6897           output to value( v-report-name )
     6898             page-size value(p-page-size) .
     6899         end.
     6900       end.
     6901     end.
     6902   end procedure.
     6903   procedure prn-lib-open-exp :
     6904     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     6905     define input parameter p-is-stream    as logical no-undo .
     6906     define input parameter p-is-append    as logical no-undo .
     6907     define output parameter p-ReportFileName as char init "report" no-undo.
     6908     define output parameter p-process as logical no-undo .
     6909     define variable glog as logical no-undo .
     6910     do
     6911       on error undo, return error
     6912       :
     6913       SYSTEM-DIALOG GET-FILE p-ReportFileName
     6914         TITLE      "Укажите путь"
     6915         FILTERS "Текстовый файл (*.txt)"   "*.txt"
     6916         ASK-OVERWRITE
     6917         CREATE-TEST-FILE
     6918         SAVE-AS
     6919         USE-FILENAME
     6920         DEFAULT-EXTENSION "txt"
     6921         UPDATE glog
     6922         .
     6923       if not glog then  return.
     6924       p-ReportFileName = trim( string( p-ReportFileName ) ) .
     6925       if p-is-stream then
     6926       do:
     6927         if p-is-append then
     6928         do:
     6929           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     6930         end.
     6931         else
     6932         do:
     6933           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
     6934         end.
     6935       end.
     6936       else
     6937       do:
     6938         if p-is-append then
     6939         do:
     6940           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     6941         end.
     6942         else
     6943         do:
     6944           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
     6945         end.
     6946       end.
     6947       p-process = yes.
     6948     end.
     6949   end procedure.
     6950   procedure prn-lib-get-report-name :
