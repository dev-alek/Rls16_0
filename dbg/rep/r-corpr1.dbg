     6705   end.
     6706   end procedure.
     6707   define variable vss-include-info39 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6708   procedure proc-alt-shift-f2:
     6709     if not ibs.th.gbl.gbl-var:rcode
     6710   then
     6711     run gbl\inidebug.p .
     6712   end.
     6713   procedure proc-alt-shift-f3:
     6714     run gbl/prvssinf.p
     6715       ( input this-procedure
     6716       ) .
     6717   end.
     6718   define variable v-inform-launched as logical no-undo initial false .
     6719   procedure proc-alt-shift-f4:
     6720     define variable v-action as character no-undo .
     6721     if v-inform-launched = false then do:
     6722       assign
     6723         v-inform-launched = true
     6724       .
     6725       run gbl/d-inform.w
     6726         (  input self
     6727         ,  input this-procedure
     6728         , output v-action
     6729         ) no-error .
     6730       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
     6731       assign
     6732         v-inform-launched = false
     6733       .
     6734     end.
     6735   end.
     6736   procedure proc-alt-f1:
     6737     run gbl/corrhelp.p
     6738       (input this-procedure
     6739       ) .
     6740   end .
     6741   on alt-shift-f2 anywhere do:
     6742     run proc-alt-shift-f2.
     6743   end.
     6744   on alt-shift-f3 anywhere do:
     6745     run proc-alt-shift-f3 in this-procedure .
     6746   end.
     6747   on alt-shift-f4 anywhere do:
     6748     run proc-alt-shift-f4 in this-procedure.
     6749   end.
