      176   procedure create_obj-list :
      177      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      178      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      179      do
      180      on error undo, return error return-value
      181      :
      182         define buffer cli-obj for ub.clients .
      183         define variable p-var as integer no-undo .
      184         define buffer buf_obj-list for obj-list .
      185         find last buf_obj-list  use-index pi no-error .
      186         if available buf_obj-list
      187         then
      188            p-var = buf_obj-list.obj-id + 1.
      189         else
      190            p-var = 1.
      191         find first cli-obj where
      192                   cli-obj.obj-type = p-obj-type
      193               and cli-obj.obj-code = p-obj-code
      194         no-lock no-error.
      195         if available cli-obj
      196         then do:
      197            create buf_obj-list.
      198            assign
      199               buf_obj-list.obj-id   = p-var
      200               buf_obj-list.obj-code = cli-obj.obj-code
      201               buf_obj-list.obj-type = cli-obj.obj-type
      202               buf_obj-list.obj-name = cli-obj.obj-name
      203               buf_obj-list.db-num   = cli-obj.db-num
      204            .
      205         end.
      206      end.
      207   end.
