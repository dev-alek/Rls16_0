     7353               find ub.person where ub.person.psn-code = clients.obj-code no-lock .
     7354               if available ub.person
     7355               then do:
     7356                   assign
     7357                       t-addres = ( if ub.person.ind <> 0 and ub.person.ind <> ? then string( ub.person.ind ) else "" )
     7358                                   + ( if  ub.person.city <> ? and trim(ub.person.city) <> "" then ( ", " + trim( ub.person.city ) ) else "" )
     7359                                   + ( if  ub.person.address <> ? and trim(ub.person.address) <> "" then ( ", " + trim( ub.person.address ) ) else "" )
     7360                       t-phone = ub.person.phone1
     7361                       t-inn = ub.person.inn
     7362                       t-okpo = ub.person.okpo
     7363                   .
     7364               end.
     7365          end.
     7366       end case.
     7367     if v-torgconf-outappr = yes then  put stream PrnLibStream  "Утверждена постановлением Госкомстата России от 25.12.98 N 132" at 137 .
     7368     put stream PrnLibStream
     7369       space(5) v-single-line format  "X(19)" at 180 skip
     7370       space(5) "| " at 180 'код':U at 188 "|" at 198 skip
     7371       space(5) "Форма по ОКУД" format "X(14)" at 166 "| " at 180 "0330212" "|" at 198 skip
     7372       space(5) string( "ИНН " + t-inn + " " + CAPS( clients.obj-name ) + " (" + string(clients.obj-code) + ")" + t-addres + t-phone) format "X(160)"
     7373                      "по ОКПО" format "X(7)" at 172 "| " at 180 t-okpo format "X(16)" "|" at 198 skip
     7374       space(5) ( if is_rem then string( CAPS( clients.obj-name ) + " (" + string(clients.obj-code) + ")" ) else  " " ) format "X(160)" "| " at 180  "|" at 198 skip
     7375       space(5) "Вид деятельности по ОКДП" format "X(25)" at 155 "| " at 180 "|" at 198 skip
     7376     .
     7377     if is_rem = yes then find first clients no-lock where clients.obj-type = 'орг':U     and clients.obj-code = v-cntxt-host-code-obj  .
     7378     else                 find first clients no-lock where clients.obj-type = p-cli-type and clients.obj-code = p-cli-code .
     7379       case clients.obj-type:
     7380          when 'орг':U
     7381          then do:
     7382               FIND ub.firm WHERE ub.firm.firm-code = clients.obj-code NO-LOCK .
     7383               if available ub.firm
     7384               then do:
     7385                   assign
     7386                       t-addres = ( if ub.firm.ind = 0 or ub.firm.ind = ? then "" else string( ub.firm.ind ) )
     7387                       t-addres = t-addres
     7388                           + ( if ub.firm.city = ? or trim(ub.firm.city) = ""
     7389                               then ""
     7390                               else ( (if t-addres = "" then "" else ", ") + trim( ub.firm.city ) )
     7391                             )
     7392                       t-temp-address = ( if ub.firm.addres1 = ? then "" else trim( substring( ub.firm.addres1, 1, 50 ) ) )
     7393                       t-addres = t-addres + ( if t-addres = "" or t-temp-address = "" then "" else ", " )
     7394                           + ( if t-temp-address = "" then "" else ( trim( t-temp-address ) ) )
     7395                           + ( if  ub.firm.addres2 = ? or trim(ub.firm.addres2) = "" then "" else ( ", " + trim( ub.firm.addres2 ) ) )
     7396                       t-temp-address = ( if ub.firm.addres1 = ? then "" else trim( substring( ub.firm.addres1, 51, 50 ) ) )
     7397                       t-addres = t-addres + ( if t-addres = "" or t-temp-address = "" then "" else ", " )
     7398                           + ( if t-temp-address = "" then "" else ( trim( t-temp-address ) ) )
     7399                       t-temp-address = ( if ub.firm.addres1 = ? then "" else trim( substring( ub.firm.addres1, 101, 50 ) ) )
     7400                       t-addres = t-addres + ( if t-addres = "" or t-temp-address = "" then "" else ", " )
     7401                           + ( if t-temp-address = "" then "" else ( trim( t-temp-address ) ) )
     7402                       t-phone = ub.firm.phone
     7403                       t-inn   = ub.firm.inn
     7404                       t-okpo  = ub.firm.okpo
     7405                   .
     7406               end.
     7407          end.
     7408          when 'маг':U
     7409          then do:
     7410               FIND ub.shop WHERE ub.shop.obj-code = clients.obj-code NO-LOCK .
     7411               if available ub.shop
     7412               then do:
     7413                   assign
     7414                       t-addres = ( if trim( shop.addres1 ) <> "" then ( trim( shop.addres1 ) ) else "" )
     7415                               + ( if trim( shop.addres2 ) <> "" then ( ", " + trim( shop.addres2 ) ) else "" )
     7416                       t-phone = shop.phone
     7417                       t-inn = ""
     7418                       t-okpo = ""
     7419                   .
     7420               end.
     7421          end.
     7422          when 'скл':U
     7423          then do:
     7424               FIND ub.store WHERE ub.store.obj-code = clients.obj-code NO-LOCK .
     7425               if available ub.store
     7426               then do:
     7427                   assign
     7428                       t-addres = ( if trim( ub.store.addres1 ) <> "" then ( trim( ub.store.addres1 ) ) else "" )
     7429                               + ( if trim( ub.store.addres2 ) <> "" then ( ", " + trim( ub.store.addres2 ) ) else "" )
     7430                       t-phone = ub.store.phone
     7431                       t-inn = ""
     7432                       t-okpo = ""
     7433                   .
     7434               end.
     7435          end.
     7436          when 'чел':U
     7437          then do:
     7438               find ub.person where ub.person.psn-code = clients.obj-code no-lock .
     7439               if available ub.person
     7440               then do:
     7441                   assign
     7442                       t-addres = ( if ub.person.ind <> 0 and ub.person.ind <> ? then string( ub.person.ind ) else "" )
     7443                                   + ( if  ub.person.city <> ? and trim(ub.person.city) <> "" then ( ", " + trim( ub.person.city ) ) else "" )
     7444                                   + ( if  ub.person.address <> ? and trim(ub.person.address) <> "" then ( ", " + trim( ub.person.address ) ) else "" )
     7445                       t-phone = ub.person.phone1
     7446                       t-inn = ub.person.inn
     7447                       t-okpo = ub.person.okpo
     7448                   .
     7449               end.
     7450          end.
     7451       end case.
     7452     put stream PrnLibStream
     7453       space(5) string( "Грузоотправитель: " + "ИНН " + t-inn + " " + CAPS( clients.obj-name ) + " (" + string(clients.obj-code) + ") "
     7454                   + t-addres + " " + t-phone)  format "X(160)"  "по ОКПО" format "X(7)"  at 172  "| " at 180  t-okpo format "X(16)"  "|" at 198 skip
     7455     .
     7456     if is_rem = yes then find first clients no-lock where clients.obj-type = 'орг':U     and clients.obj-code = v-cntxt-host-code-obj .
     7457     else                 find first clients no-lock where clients.obj-type = p-cli-type and clients.obj-code = p-cli-code .
     7458       run fmtcli-get-bank in this-procedure (
     7459             input v-cntxt-host-code-obj
     7460           , input clients.obj-type
     7461           , input clients.obj-type
     7462           , input v-curr-code
     7463       ).
     7464     put stream PrnLibStream
     7465       space(5) string( "Поставщик: " + clients.obj-name
     7466                       + ( if v-fmtcli-schet-exists
     7467                           then substitute( ", р/с &1 к/с &2", v-fmtcli-bank-r-schet, v-fmtcli-bank-c-schet )
     7468                               + ( if v-fmtcli-bank-exists
     7469                                   then substitute( " БИК &1 в &2 &3", v-fmtcli-bank-bik, v-fmtcli-bank-name, v-fmtcli-bank-addres  )
     7470                                   else ""
     7471                                 )
     7472                           else "" )
     7473                         ) format "X(160)"
     7474                 "по ОКПО" format "X(7)"       at 172
     7475                 "| "                          at 180
     7476                 t-okpo    format "X(16)"
     7477                 "|"                           at 198 skip
     7478     .
     7479     if is_rem = yes then find first clients no-lock where clients.obj-type = p-cli-type and clients.obj-code = p-cli-code .
     7480     else                 find first clients no-lock where clients.obj-type = 'орг':U     and clients.obj-code = v-cntxt-host-code-obj .
     7481       run fmtcli-get-bank in this-procedure (
     7482             input v-cntxt-host-code-obj
     7483           , input clients.obj-type
     7484           , input clients.obj-type
     7485           , input v-curr-code
     7486       ).
     7487     define variable v-attr-value  as character no-undo .
     7488     define variable v-attr-type   as character no-undo .
     7489     define variable v-osnov       as character initial "" no-undo .
     7490     put stream PrnLibStream
     7491       space(5) string( "Плательщик: " + clients.obj-name
     7492                       + ( if v-fmtcli-schet-exists
     7493                           then substitute( ", р/с &1 к/с &2", v-fmtcli-bank-r-schet, v-fmtcli-bank-c-schet )
     7494                               + ( if v-fmtcli-bank-exists
     7495                                   then substitute( " БИК &1 в &2 &3", v-fmtcli-bank-bik, v-fmtcli-bank-name, v-fmtcli-bank-addres  )
     7496                                   else ""
     7497                                 )
     7498                           else "" )
     7499                         ) format "X(160)"
     7500                "по ОКПО"          format "X(7)"       at 172
     7501                "| "                                   at 180
     7502                t-okpo             format "X(16)"
     7503                "|"                                    at 198 skip
     7504                space(5) string( "Основание: " + v-osnov ) format "X(160)" "номер" format "X(5)" at 174 "| " at 180  "|" at 198 skip
     7505     .
     7506     if v-torgconf-outprim = no then  put stream PrnLibStream space(5) string( "Примечание: " ) format "X(160)" .
     7507     put stream PrnLibStream  "дата" format "X(4)" at 175 "| " at 180 "|" at 198 skip
     7508       space(5) string( "Вид оплаты: " ) format "X(130)"
     7509       string( "Транспортная накладная " ) format "X(23)" at 147 "номер" format "X(5)" at 174 "| " at 180 tdoc-code format "X(16)" "|" at 198 skip
     7510       space(5) "дата" format "X(4)" at 175 "| " at 180 v-doc-date-string format "X(10)" "|" at 198 skip
     7511       space(5) "Вид операции" format "X(12)" at 167 "| " at 180  (if is_rem = yes then "возврат пост-ку" else "приход")  format "X(16)" "|" at 198 skip
     7512       space(5) v-single-line format  "X(19)" at 180 skip    space(64) v-single-line format "X(33)" skip
     7513       space(45) string( "ТОВАРНАЯ НАКЛАДНАЯ | " + string( tdoc-code, "X(16)") + " | " + v-doc-date-string + " | " ) format "X(100)" skip
     7514       space(64) v-single-line format "X(33)"
     7515     .
     7516     if is_rem = yes then put stream PrnLibStream skip space(10) "Возврат товара поставщику" format "X(120)" .
     7517     form with frame f-doc-m .
     7518     if sort-gr = yes then down stream PrnLibStream 1 with frame f-doc-m .
     7519     if sort-gr = yes then do:
     7520       case sort-name :
     7521         when 1 then do:
     7522           for each gds-prop break by gds-prop.grp-name by gds-prop.gds-name :
     7523             if first-of (gds-prop.grp-name) then put stream PrnLibStream  skip  ":" space(5)  "Группа:" space(2)  gds-prop.grp-name .
     7524             run print-line in this-procedure .
     7525           end.
     7526         end.
     7527         when 2 then do:
     7528           for each gds-prop break by gds-prop.grp-name by gds-prop.b-code :
     7529             if first-of (gds-prop.grp-name) then put stream PrnLibStream  skip  ":" space(5)  "Группа:" space(2)  gds-prop.grp-name .
     7530             run print-line in this-procedure .
     7531           end.
     7532         end.
     7533         when 3 then do:
     7534           for each gds-prop break by gds-prop.grp-name by gds-prop.artic :
     7535             if first-of (gds-prop.grp-name) then put stream PrnLibStream  skip  ":" space(5)  "Группа:" space(2)  gds-prop.grp-name .
     7536             run print-line in this-procedure .
     7537           end.
     7538         end.
     7539       end.
     7540     end.
     7541     else do:
     7542       case sort-name :
     7543         when 1 then do:
     7544           for each gds-prop break by gds-prop.gds-name :      run print-line in this-procedure .      end.
     7545         end.
     7546         when 2 then do:
     7547           for each gds-prop break by gds-prop.b-code :        run print-line in this-procedure .      end.
     7548         end.
     7549         when 3 then do:
     7550           for each gds-prop break by gds-prop.artic :         run print-line in this-procedure .      end.
     7551         end.
     7552       end.
     7553     end.
     7554     if line-counter( PrnLibStream ) + 20 > page-size( PrnLibStream ) then do:
     7555       put stream PrnLibStream v-single-line format "x(198)" skip.
     7556       display stream PrnLibStream
