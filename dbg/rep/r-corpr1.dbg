     7129               gds-prop.sum-no-VAT   = gds-prop.sum-no-VAT   + ABSOLUTE(tt-allsum.sum-dsc-base-acc - tt-allsum.slt-base-acc - tt-allsum.vat-base-acc)
     7130               gds-prop.VAT          = gds-prop.VAT          + ABSOLUTE(tt-allsum.vat-base-acc)
     7131               gds-prop.stoim        = gds-prop.stoim        + ABSOLUTE(tt-allsum.sum-dsc-base-acc - tt-allsum.slt-base-acc)
     7132               gds-prop.sum          = gds-prop.sum          + ABSOLUTE(tt-allsum.sum-dsc-base-acc)
     7133               v-tax-sum             = v-tax-sum             + ABSOLUTE(tt-allsum.road-tax-base-acc)
     7134               v-tot-discnt          = v-tot-discnt          + ABSOLUTE(tt-allsum.dsc-base-acc)
     7135             .
