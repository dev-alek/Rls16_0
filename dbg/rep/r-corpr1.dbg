     6753   define variable vss-include-info40 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6754     define variable v-cntxt-db-num        as integer   no-undo .
     6755     define variable v-cntxt-userid        as character no-undo .
     6756     define variable v-cntxt-level         as character no-undo .
