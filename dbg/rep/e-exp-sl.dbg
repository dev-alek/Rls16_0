     1194               when 'barcodfi':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Бар-код - доп поля"     p-tooltip = "Бар-код - доп поля"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
     1195                when 'UPD':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Настройки справочника Электронного документоборота"     p-tooltip = "Настройки справочника Электронного документоборота"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
     1196               when 'LK_RECEIPT':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Настройки справочника документов Вывода из оборота (ОСУ)"     p-tooltip = "Настройки справочника документов Вывода из оборота (ОСУ)"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
     1197         otherwise do:
     1198           undo, return error "неизвестная настройка пользователя usr-flt" + " " + p-code .
     1199         end.
     1200       end CASE.
     1201     end.
     1202   end procedure.
     1203   procedure uf-get :
     1204     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
     1205     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
     1206     define output parameter p-List_        like ubflt.usr-flt.List_        no-undo .
     1207     define output parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
     1208     define output parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
     1209     define output parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
     1210     define output parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
     1211     define output parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
     1212     do
     1213     on error undo, return error
     1214     :
     1215       define buffer buf_usr-flt for ubflt.usr-flt .
     1216       define variable v-use-List_     as logical   no-undo .
     1217       define variable v-type-List_     as character no-undo .
     1218       define variable v-format-List_   as character no-undo .
     1219       define variable v-use-Naim      as logical   no-undo .
     1220       define variable v-type-Naim      as character no-undo .
     1221       define variable v-format-Naim    as character no-undo .
     1222       define variable v-use-print-graft as logical   no-undo .
     1223       define variable v-use-sort-gr     as logical   no-undo .
     1224       define variable v-use-type-price  as logical   no-undo .
     1225       define variable v-use-type-val    as logical   no-undo .
     1226       define variable v-label          as character no-undo .
     1227       define variable v-tooltip        as character no-undo .
     1228       define variable v-user-can-edit  as logical   no-undo .
     1229       define variable v-output-display as logical   no-undo .
     1230       define variable v-other          as character no-undo .
     1231       run uf-name in this-procedure
     1232          (input  entry(1, p-code, chr(4))
     1233         ,output v-use-List_
     1234         ,output v-type-List_
     1235         ,output v-format-List_
     1236         ,output v-use-Naim
     1237         ,output v-type-Naim
     1238         ,output v-format-Naim
     1239         ,output v-use-print-graft
     1240         ,output v-use-sort-gr
     1241         ,output v-use-type-price
     1242         ,output v-use-type-val
     1243         ,output v-label
     1244         ,output v-tooltip
     1245         ,output v-user-can-edit
     1246         ,output v-output-display
     1247         ,output v-other
     1248         ) no-error .
     1249       if error-status :error then do:
     1250         undo, return error return-value .
     1251       end.
     1252       find first buf_usr-flt no-lock where
     1253                  buf_usr-flt.Call-point     = p-code AND
     1254                  buf_usr-flt.user-name       = p-user-name
     1255         no-error .
     1256       if avail buf_usr-flt then do:
     1257         assign
     1258         p-List_        = (if v-use-List_       then buf_usr-flt.List_       else ?)
     1259         p-Naim         = (if v-use-Naim        then buf_usr-flt.Naim        else ?)
     1260         p-print-graft  = (if v-use-print-graft then buf_usr-flt.print-graft else ?)
     1261         p-sort-gr      = (if v-use-sort-gr     then buf_usr-flt.sort-gr     else ?)
     1262         p-type-price   = (if v-use-type-price  then buf_usr-flt.type-price  else ?)
     1263         p-type-val     = (if v-use-List_       then buf_usr-flt.type-val    else ?)
     1264         .
     1265       end.
     1266       else do:
     1267         assign
     1268         p-List_        = (if v-use-List_       then "":U                    else ?)
     1269         p-Naim         = (if v-use-Naim        then "":U                    else ?)
     1270         p-print-graft  = (if v-use-print-graft then no                      else ?)
     1271         p-sort-gr      = (if v-use-sort-gr     then no                      else ?)
     1272         p-type-price   = (if v-use-type-price  then no                      else ?)
     1273         p-type-val     = (if v-use-List_       then no                      else ?)
     1274         .
     1275       end.
     1276     end.
     1277   end procedure.
     1278   procedure uf-set :
     1279     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
     1280     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
     1281     define input  parameter p-List_        like ubflt.usr-flt.List_        no-undo .
     1282     define input  parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
     1283     define input  parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
     1284     define input  parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
     1285     define input  parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
     1286     define input  parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
     1287     do
     1288     on error undo, return error
     1289     :
     1290       define buffer buf_usr-flt for ubflt.usr-flt .
     1291       define variable v-use-List_     as logical   no-undo .
     1292       define variable v-type-List_     as character no-undo .
     1293       define variable v-format-List_   as character no-undo .
     1294       define variable v-use-Naim      as logical   no-undo .
     1295       define variable v-type-Naim      as character no-undo .
     1296       define variable v-format-Naim    as character no-undo .
     1297       define variable v-use-print-graft as logical   no-undo .
     1298       define variable v-use-sort-gr   as logical   no-undo .
     1299       define variable v-use-type-price as logical   no-undo .
     1300       define variable v-use-type-val  as logical   no-undo .
     1301       define variable v-tooltip        as character no-undo .
     1302       define variable v-label          as character no-undo .
     1303       define variable v-user-can-edit  as logical   no-undo .
     1304       define variable v-output-display as logical   no-undo .
     1305       define variable v-other          as character no-undo .
     1306       run uf-name in this-procedure
     1307         (input  entry(1, p-code, chr(4))
     1308         ,output v-use-List_
     1309         ,output v-type-List_
     1310         ,output v-format-List_
     1311         ,output v-use-Naim
     1312         ,output v-type-Naim
     1313         ,output v-format-Naim
     1314         ,output v-use-print-graft
     1315         ,output v-use-sort-gr
     1316         ,output v-use-type-price
     1317         ,output v-use-type-val
     1318         ,output v-label
     1319         ,output v-tooltip
     1320         ,output v-user-can-edit
     1321         ,output v-output-display
     1322         ,output v-other
     1323         ) no-error .
     1324       if error-status :error then do:
     1325         undo, return error return-value .
     1326       end.
     1327       find first buf_usr-flt where
     1328                  buf_usr-flt.Call-point     = p-code AND
     1329                  buf_usr-flt.user-name       = p-user-name
     1330         no-error .
     1331       if not avail buf_usr-flt then do:
     1332           create buf_usr-flt .
     1333           assign
     1334           buf_usr-flt.call-point = p-code
     1335           buf_usr-flt.user-name  = p-user-name
     1336           .
     1337       end.
     1338       if avail buf_usr-flt then do:
     1339        assign
     1340        buf_usr-flt.List_       =  (if v-use-List_       then  p-List_        else ?)
     1341        buf_usr-flt.Naim        =  (if v-use-Naim        then  p-Naim         else ?)
     1342        buf_usr-flt.print-graft =  (if v-use-print-graft then  p-print-graft  else ?)
     1343        buf_usr-flt.sort-gr     =  (if v-use-sort-gr     then  p-sort-gr      else ?)
     1344        buf_usr-flt.type-price  =  (if v-use-type-price  then  p-type-price   else ?)
     1345        buf_usr-flt.type-val    =  (if v-use-List_       then  p-type-val     else ?)
     1346       .
     1347       release buf_usr-flt.
     1348       end.
     1349       else undo, return error ("Ошибка при записи usr-flt" + substitute(" call-point=&1, user-name=&2", p-code, p-user-name)).
     1350     end.
     1351   end procedure.
     1352   CREATE WIDGET-POOL.
     1353   define variable  State-source as  WIDGET-HANDLE.
     1354   define variable loc-ref-list as character no-undo .
     1355   define stream StreamLog.
     1356   DEFINE VARIABLE EDITOR-log AS CHARACTER
     1357        VIEW-AS EDITOR NO-WORD-WRAP SCROLLBAR-HORIZONTAL SCROLLBAR-VERTICAL
     1358        SIZE 69.6 BY 5.24 NO-UNDO.
     1359   DEFINE VARIABLE v-ftp-address AS CHARACTER FORMAT "X(40)":U
     1360        LABEL "ftp"
     1361        VIEW-AS FILL-IN
     1362        SIZE 28 BY 1 NO-UNDO.
     1363   DEFINE VARIABLE v-ftp-path AS CHARACTER FORMAT "X(256)":U
     1364        LABEL "Путь"
     1365        VIEW-AS FILL-IN
     1366        SIZE 46 BY 1 NO-UNDO.
     1367   DEFINE VARIABLE v-ftp-target-dir AS CHARACTER FORMAT "X(256)":U
     1368        LABEL "Папка"
     1369        VIEW-AS FILL-IN
     1370        SIZE 46 BY 1 NO-UNDO.
     1371   DEFINE VARIABLE v-login AS CHARACTER FORMAT "X(25)":U
     1372        LABEL "Логин"
     1373        VIEW-AS FILL-IN
     1374        SIZE 28 BY 1 NO-UNDO.
     1375   DEFINE VARIABLE v-name AS CHARACTER FORMAT "X(256)":U
     1376        LABEL "Префикс"
     1377        VIEW-AS FILL-IN
     1378        SIZE 17.2 BY 1 TOOLTIP "Префикс имени выходного файла." NO-UNDO.
     1379   DEFINE VARIABLE v-password AS CHARACTER FORMAT "X(25)":U
     1380        LABEL "Пароль"
     1381        VIEW-AS FILL-IN
     1382        SIZE 28 BY 1 NO-UNDO.
     1383   DEFINE VARIABLE RADIO-doc AS INTEGER
     1384        VIEW-AS RADIO-SET VERTICAL
     1385        RADIO-BUTTONS
     1386             "Локальную папку", 1,
     1387   "FTP адрес", 2
     1388        SIZE 24.4 BY 2.81 NO-UNDO.
     1389   DEFINE RECTANGLE RECT-7
     1390        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1391        SIZE 71.4 BY 16.24.
     1392   DEFINE FRAME F-Main
     1393        RADIO-doc AT ROW 2.57 COL 4.6 NO-LABEL
     1394        v-ftp-address AT ROW 5.86 COL 11 COLON-ALIGNED
     1395        v-login AT ROW 7.33 COL 11 COLON-ALIGNED
     1396        v-ftp-path AT ROW 8.86 COL 11 COLON-ALIGNED
     1397        v-ftp-target-dir AT ROW 8.86 COL 11 COLON-ALIGNED
     1398        v-password AT ROW 8.86 COL 11 COLON-ALIGNED PASSWORD-FIELD
     1399        v-name AT ROW 10.43 COL 11 COLON-ALIGNED WIDGET-ID 2
     1400        EDITOR-log AT ROW 12 COL 3 NO-LABEL WIDGET-ID 4
     1401        "Выгружать в:" VIEW-AS TEXT
     1402             SIZE 15 BY .67 AT ROW 1.86 COL 4.6
     1403             FGCOLOR 4
     1404        RECT-7 AT ROW 1 COL 1
     1405       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
     1406            SIDE-LABELS NO-UNDERLINE THREE-D
     1407            AT COL 1 ROW 1 SCROLLABLE
     1408            BGCOLOR 8 .
     1409   IF NOT THIS-PROCEDURE:PERSISTENT THEN DO:
     1410     MESSAGE "c:\tester\Rls_16_0\rc_160_rus\cmpdir\src\rep\e-exp-sl.w should only be RUN PERSISTENT.":U
     1411             VIEW-AS ALERT-BOX ERROR BUTTONS OK.
     1412     RETURN.
     1413   END.
     1414   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
     1415   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
     1416   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
     1417   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
     1418   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
     1419   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
     1420   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
     1421   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
     1422         adm-object-hdl = FRAME F-Main:HANDLE.
     1423   RUN ensure-broker.
     1424   THIS-PROCEDURE:ADM-DATA =
     1425        'ADM1.1~`':U +
     1426        'SmartViewer~`':U +
     1427        '~`':U +
     1428        'NO ~`':U +
     1429        '~`':U +
     1430        '~`':U +
     1431        '~`':U +
     1432        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
     1433           + "~`":U +
     1434        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add~`':U +
     1435        'Record-Source,Record-Target,TableIO-Target~`':U +
     1436        '~`':U +
     1437        '~`~`~`~`~`~`~`~`~`~`~`':U +
     1438        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
     1439            THEN "^^":U
     1440        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
     1441             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
     1442   PROCEDURE adm-apply-entry :
     1443     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1444   END PROCEDURE.
     1445   PROCEDURE adm-destroy :
     1446    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1447   END PROCEDURE.
     1448   PROCEDURE adm-disable :
     1449       DISABLE RECT-7 RADIO-doc v-login v-password v-name WITH FRAME F-Main.
     1450       RUN dispatch ('disable-fields':U).
     1451       RUN set-attribute-list ('ENABLED=no':U).
     1452       RETURN.
     1453   END PROCEDURE.
     1454   PROCEDURE adm-edit-attribute-list :
     1455         RUN adm/support/viewerd.w (INPUT THIS-PROCEDURE).
     1456         RETURN.
     1457   END PROCEDURE.
     1458   PROCEDURE adm-enable :
     1459       ENABLE UNLESS-HIDDEN RECT-7 RADIO-doc v-login v-password v-name WITH FRAME F-Main.
     1460       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
     1461       RUN set-attribute-list ('ENABLED=yes':U).
     1462       RETURN.
     1463   END PROCEDURE.
     1464   PROCEDURE adm-exit :
     1465        RUN notify ('exit':U).
     1466     RETURN.
     1467   END PROCEDURE.
     1468   PROCEDURE adm-hide :
     1469     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1470   END PROCEDURE.
     1471   PROCEDURE adm-initialize :
     1472     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1473   END PROCEDURE.
     1474   PROCEDURE adm-show-errors :
     1475       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
     1476       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
     1477           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
     1478       END.
     1479       RETURN.
     1480   END PROCEDURE.
     1481   PROCEDURE adm-UIB-mode :
     1482     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1483   END PROCEDURE.
     1484   PROCEDURE adm-view :
     1485     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1486   END PROCEDURE.
     1487   PROCEDURE dispatch :
     1488       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
     1489       RUN broker-dispatch IN adm-broker-hdl
     1490           (THIS-PROCEDURE, p-method-name) NO-ERROR.
     1491       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
     1492   END PROCEDURE.
     1493   PROCEDURE ensure-broker :
     1494   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
     1495   IF RETURN-VALUE NE "ADM-Broker":U THEN
     1496   DO:
     1497       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
     1498       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
     1499   END.
     1500   END PROCEDURE.
     1501   PROCEDURE get-attribute :
     1502     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
     1503     RUN broker-get-attribute IN adm-broker-hdl
     1504         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
     1505     RETURN RETURN-VALUE.
     1506   END PROCEDURE.
     1507   PROCEDURE get-attribute-list :
     1508     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
     1509     RUN broker-get-attribute-list IN adm-broker-hdl
     1510         (INPUT THIS-PROCEDURE,
     1511          INPUT ?,
     1512          OUTPUT p-attr-list) NO-ERROR.
     1513     RETURN.
     1514   END PROCEDURE.
     1515   PROCEDURE new-state :
     1516     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     1517     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
     1518     RETURN.
     1519   END PROCEDURE.
     1520   PROCEDURE notify :
     1521     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
     1522     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
     1523     IF RETURN-VALUE = "ADM-ERROR":U THEN
     1524         RETURN "ADM-ERROR":U.
     1525     RETURN.
     1526   END PROCEDURE.
     1527   PROCEDURE set-attribute-list :
     1528     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
     1529     RUN ensure-broker.
     1530     RUN broker-set-attribute-list IN adm-broker-hdl
     1531         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
     1532     RETURN.
     1533   END PROCEDURE.
     1534   PROCEDURE set-position :
     1535       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
     1536       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
     1537       IF VALID-HANDLE(adm-object-hdl) THEN
     1538       DO:
     1539         ASSIGN adm-object-hdl:ROW    =   p-row
     1540                adm-object-hdl:COLUMN =   p-col.
     1541       END.
     1542       RETURN.
     1543   END PROCEDURE.
     1544   PROCEDURE adm-display-fields :
     1545       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
     1546       RETURN.
     1547   END PROCEDURE.
     1548   PROCEDURE adm-open-query :
     1549     RETURN.
     1550   END PROCEDURE.
     1551   PROCEDURE adm-row-changed :
     1552         IF VALID-HANDLE(adm-object-hdl) THEN
     1553           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     1554         RUN notify ('row-available':U).
     1555         RETURN.
     1556   END PROCEDURE.
     1557   PROCEDURE reposition-query :
     1558       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
     1559       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
     1560       RETURN.
     1561   END PROCEDURE.
     1562     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
     1563     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
     1564     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
     1565     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
     1566     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
     1567     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
     1568     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
     1569     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
     1570     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1571     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
     1572     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1573     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
     1574     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
     1575     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
     1576     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
     1577     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
     1578     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
     1579     IF "":U = "":U THEN
     1580       RUN modify-list-attribute IN adm-broker-hdl
     1581         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
     1582     RUN use-create-on-add(?).
     1583   PROCEDURE adm-add-record :
     1584       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     1585          "must have at least one Enabled Table to perform Add.":U
     1586          VIEW-AS ALERT-BOX ERROR.
     1587       RETURN.
     1588   END PROCEDURE.
     1589   PROCEDURE adm-assign-record :
     1590    MESSAGE
     1591          "Object ":U THIS-PROCEDURE:FILE-NAME
     1592            "must have at least one Enabled Table to perform Assign.":U
     1593              VIEW-AS ALERT-BOX ERROR.
     1594      RETURN.
     1595     END PROCEDURE.
     1596   PROCEDURE adm-assign-statement :
     1597     RETURN.
     1598   END PROCEDURE.
     1599   PROCEDURE adm-cancel-record :
     1600      RETURN.
     1601     END PROCEDURE.
     1602   PROCEDURE adm-copy-record :
     1603       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     1604        "must have at least one Enabled Table to perform Copy.":U
     1605          VIEW-AS ALERT-BOX ERROR.
     1606       RETURN.
     1607   END PROCEDURE.
     1608   PROCEDURE adm-create-record :
     1609      RETURN.
     1610   END PROCEDURE.
     1611   PROCEDURE adm-current-changed :
     1612     RETURN.
     1613   END PROCEDURE.
     1614   PROCEDURE adm-delete-record :
     1615    MESSAGE
     1616          "Object ":U THIS-PROCEDURE:FILE-NAME
     1617            "must have at least one Enabled Table to perform Delete.":U
     1618              VIEW-AS ALERT-BOX ERROR.
     1619       RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
     1620       RETURN.
     1621   END PROCEDURE.
     1622   PROCEDURE adm-disable-fields :
     1623         RUN notify ('disable-fields, GROUP-ASSIGN-TARGET':U).
     1624       RETURN.
     1625   END PROCEDURE.
     1626   PROCEDURE adm-enable-fields :
     1627       RETURN.
     1628   END PROCEDURE.
     1629   PROCEDURE adm-end-update :
     1630     RETURN.
     1631   END PROCEDURE.
     1632   PROCEDURE adm-reset-record :
     1633       RETURN.
     1634   END PROCEDURE.
     1635   PROCEDURE adm-update-record :
     1636       MESSAGE
     1637         "Object ":U THIS-PROCEDURE:FILE-NAME
     1638           "must have at least one Enabled Table to perform Update.":U
     1639             VIEW-AS ALERT-BOX ERROR.
     1640      RETURN.
     1641   END PROCEDURE.
     1642   PROCEDURE check-modified :
     1643   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
     1644   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
     1645   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
     1646   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
     1647     IF check-state = "check":U THEN
     1648     DO:
     1649       RUN get-link-handle IN adm-broker-hdl
     1650         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
     1651            OUTPUT group-target-list).
     1652       IF group-target-list NE "":U THEN
     1653       DO i = 1 TO NUM-ENTRIES(group-target-list):
     1654         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
     1655         RUN check-modified IN curr-widget ('group-check':U).
     1656         IF RETURN-VALUE NE "":U THEN
     1657         DO:
     1658           RUN check-modified-message(RETURN-VALUE).
     1659           RETURN "":U.
     1660         END.
     1661       END.
     1662     END.
     1663     RETURN "":U.
     1664   END PROCEDURE.
     1665   PROCEDURE check-modified-message :
     1666     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
     1667        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
     1668           'CONTAINER-SOURCE':U, 'HIDDEN':U).
     1669        IF RETURN-VALUE = "YES":U THEN
     1670           RUN notify ('view,CONTAINER-SOURCE':U).
     1671        MESSAGE IF p-changed-table NE ? THEN
     1672           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
     1673           ELSE "Current values have been changed."
     1674           SKIP "  Do you wish to save those changes?"
     1675           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
     1676        IF ANS THEN
     1677        DO:
     1678           IF group-assign-target THEN
     1679             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
     1680           ELSE RUN dispatch('update-record':U).
     1681           IF RETURN-VALUE = "ADM-ERROR":U THEN
     1682           DO:
     1683               MESSAGE "Changes to the previous record were not saved."
     1684                 VIEW-AS ALERT-BOX ERROR.
     1685               IF group-assign-target THEN
     1686                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1687               ELSE RUN dispatch ('cancel-record':U).
     1688           END.
     1689        END.
     1690        ELSE DO:
     1691          IF group-assign-target THEN
     1692             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1693          ELSE RUN dispatch('cancel-record':U).
     1694        END.
     1695        RETURN.
     1696   END PROCEDURE.
     1697   PROCEDURE get-rowid :
     1698       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
     1699       ASSIGN
     1700       p-table   =   adm-first-table.
     1701       RETURN.
     1702   END PROCEDURE.
     1703   PROCEDURE init-group-assign :
     1704       RUN request-attribute IN adm-broker-hdl
     1705         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
     1706       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
     1707         group-assign-target = yes.
     1708       ELSE group-assign-target = no.
     1709       RETURN.
     1710   END PROCEDURE.
     1711   PROCEDURE set-editors :
     1712       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
     1713       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
     1714       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
     1715       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
     1716       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
     1717       DO WHILE VALID-HANDLE (curr-widget):
     1718           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
     1719              curr-widget:HIDDEN = no THEN DO:
     1720             CASE p-field-setting:
     1721               WHEN "INITIALIZE":U THEN
     1722               DO:
     1723                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
     1724                     read-only-list +
     1725                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
     1726                        STRING(curr-widget).
     1727               END.
     1728               WHEN "DISABLE":U OR
     1729               WHEN "ENABLE":U THEN
     1730               DO:
     1731                   curr-widget:SENSITIVE = yes.
     1732                   RUN get-attribute ('Read-Only-Editors':U).
     1733                   IF RETURN-VALUE = ? OR
     1734                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
     1735                       curr-widget:READ-ONLY =
     1736                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
     1737               END.
     1738               WHEN "CLEAR":U THEN
     1739                   curr-widget:SCREEN-VALUE = "":U.
     1740             END CASE.
     1741           END.
     1742           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
     1743       END.
     1744       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
     1745         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
     1746           + '"':U).
     1747       RETURN.
     1748   END PROCEDURE.
     1749   PROCEDURE use-check-modified-all :
     1750    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1751     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
     1752     RETURN.
     1753   END PROCEDURE.
     1754   PROCEDURE use-create-on-add :
     1755   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1756      RETURN.
     1757   END PROCEDURE.
     1758   PROCEDURE use-initial-lock :
     1759     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1760     ASSIGN adm-initial-lock = p-attr-value.
     1761     RETURN.
     1762   END PROCEDURE.
     1763     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
     1764   ASSIGN
     1765          FRAME F-Main:SCROLLABLE       = FALSE
     1766          FRAME F-Main:HIDDEN           = TRUE.
     1767   ASSIGN
     1768          EDITOR-log:READ-ONLY IN FRAME F-Main        = TRUE.
     1769   ASSIGN
     1770          v-ftp-path:HIDDEN IN FRAME F-Main           = TRUE.
     1771   ASSIGN
     1772          v-ftp-target-dir:HIDDEN IN FRAME F-Main           = TRUE.
     1773   ON VALUE-CHANGED OF RADIO-doc IN FRAME F-Main
     1774   DO:
     1775     assign
     1776      RADIO-doc
     1777     .
     1778     CASE RADIO-doc:
     1779     WHEN 2
     1780     then do:
     1781       ENABLE
     1782           v-ftp-address
     1783           v-login
     1784           v-password
     1785           editor-log
     1786       WITH FRAME F-Main.
     1787       DISPLAY
     1788           v-ftp-address
     1789           v-login
     1790           v-password
     1791           editor-log
     1792       WITH FRAME F-Main.
     1793     end.
     1794     OTHERWISE DO:
     1795         HIDE
     1796             v-ftp-address
     1797             v-login
     1798             v-password
     1799         IN FRAME F-Main.
     1800         ENABLE
     1801         editor-log
     1802         WITH FRAME F-Main.
     1803         DISPLAY
     1804         editor-log
     1805         WITH FRAME F-Main.
     1806     END.
     1807     END CASE.
     1808   END.
     1809   PROCEDURE disable_UI :
     1810     HIDE FRAME F-Main.
     1811     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1812   END PROCEDURE.
     1813   PROCEDURE local-apply-layout :
     1814     RUN dispatch IN THIS-PROCEDURE ( INPUT 'apply-layout':U ) .
     1815   END PROCEDURE.
     1816   PROCEDURE local-initialize :
     1817   define variable v-void-log    as logical   no-undo .
     1818      define variable v-call-point    as character    no-undo.
     1819      define variable v-naim    as character    no-undo.
     1820      define variable v-list    as character    no-undo.
     1821      define variable v-found    as logical      no-undo.
     1822      define variable v-doc    as logical      no-undo.
     1823      ASSIGN
     1824         v-call-point = 'e-exp-sl-1':U
     1825      .
     1826      run uf-get ( input v-call-point
     1827                        , input v-cntxt-userid
     1828                        , output v-list
     1829                        , output v-naim
     1830                        , output v-doc
     1831                        , output v-void-log
     1832                        , output v-void-log
     1833                        , output v-void-log
     1834                        ) .
     1835         ASSIGN
     1836            v-ftp-address    = v-naim
     1837            v-name           = v-list
     1838            radio-doc        = IF v-doc THEN 1 ELSE 2
     1839            v-call-point = 'e-exp-sl-2':U
     1840            .
     1841      .
     1842      run uf-get( input v-call-point
     1843                        , input v-cntxt-userid
     1844                        , output v-list
     1845                        , output v-naim
     1846                        , output v-void-log
     1847                        , output v-void-log
     1848                        , output v-void-log
     1849                        , output v-void-log
     1850                        ) .
     1851         ASSIGN
     1852            v-login     = v-naim
     1853            v-password  = v-list
     1854         .
     1855      DISPLAY
     1856         RADIO-DOC
     1857         v-name
     1858      WITH FRAME F-Main.
     1859      CASE RADIO-doc:
     1860        WHEN 2
     1861        then do:
     1862          ENABLE
     1863            v-ftp-address
     1864            v-login
     1865            v-password
     1866            editor-log
     1867          WITH FRAME F-Main.
     1868          DISPLAY
     1869            v-ftp-address
     1870            v-login
     1871            v-password
     1872            editor-log
     1873          WITH FRAME F-Main.
     1874        end.
     1875        OTHERWISE DO:
     1876          HIDE
     1877             v-ftp-address
     1878             v-login
     1879             v-password
     1880          IN FRAME F-Main.
     1881          ENABLE
     1882          editor-log
     1883          WITH FRAME F-Main.
     1884          DISPLAY
     1885          editor-log
     1886          WITH FRAME F-Main.
     1887        END.
     1888      END CASE.
     1889      RUN dispatch IN THIS-PROCEDURE ( INPUT 'initialize':U ) .
     1890   END PROCEDURE.
     1891   PROCEDURE my-report :
     1892   define variable v-call-point    as character    no-undo.
     1893   define variable v-naim    as character    no-undo.
     1894   define variable v-list    as character    no-undo.
     1895      define variable v-doc    as logical      no-undo.
     1896      define buffer buf_clients     for ub.clients .
     1897      DO with FRAME F-Main
     1898      :
     1899         ASSIGN
     1900            v-ftp-address
     1901            RADIO-doc
     1902            v-login
     1903            v-password
     1904            v-name
     1905         .
     1906      END.
     1907      ASSIGN
     1908         v-call-point = 'e-exp-sl-1':U
     1909         v-naim       = v-ftp-address
     1910         v-list       = v-name
     1911         v-doc        = IF RADIO-doc = 1 THEN TRUE
     1912                                         ELSE FALSE
     1913      .
     1914      run uf-set ( input v-call-point
     1915                        , input v-cntxt-userid
     1916                        , input v-list
     1917                        , input v-naim
     1918                        , input v-doc
     1919                        , input ?
     1920                        , input ?
     1921                        , input ?
     1922                        ) .
     1923      ASSIGN
     1924         v-call-point = 'e-exp-sl-2':U
     1925         v-naim       = v-login
     1926         v-list       = v-password
     1927      .
     1928      run uf-set ( input v-call-point
     1929                        , input v-cntxt-userid
     1930                        , input v-list
     1931                        , input v-naim
     1932                        , input ?
     1933                        , input ?
     1934                        , input ?
     1935                        , input ?
     1936                        ) .
     1937      EMPTY TEMP-TABLE tt-obj.
     1938      FOR EACH obj-list
     1939      :
     1940         FIND FIRST buf_clients NO-LOCK
     1941           WHERE buf_clients.obj-type = obj-list.obj-type
     1942             AND buf_clients.obj-code = obj-list.obj-code
     1943           NO-ERROR.
     1944         IF AVAILABLE buf_clients
     1945         THEN DO:
     1946            CREATE tt-obj.
     1947            ASSIGN
     1948               tt-obj.obj-code  = obj-list.obj-code
     1949               tt-obj.obj-type  = obj-list.obj-type
     1950               tt-obj.obj-name  = obj-list.obj-name
     1951               tt-obj.host-code = buf_clients.host-code
     1952            .
     1953         END.
     1954      END.
     1955      run rep/r-exp-sl.p ( INPUT x-Date-Alone
     1956                    , INPUT IF RADIO-doc = 1 THEN "":U ELSE v-ftp-address
     1957                    , input v-ftp-path
     1958                    , input v-ftp-target-dir
     1959                    , INPUT v-login
     1960                    , INPUT v-password
     1961                    , INPUT v-name
     1962                    , INPUT this-procedure:handle
     1963                    , input table tt-obj
     1964                    ) .
     1965   END PROCEDURE.
     1966   PROCEDURE my-var :
     1967   assign frame F-Main  RADIO-doc v-ftp-address v-login v-password .
     1968   END PROCEDURE.
     1969   PROCEDURE state-changed :
     1970     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE    NO-UNDO.
     1971     DEFINE INPUT PARAMETER p-state      AS CHARACTER NO-UNDO.
     1972     CASE p-state:
     1973     END CASE.
     1974     END PROCEDURE.
     1975   PROCEDURE write-log-and-file :
     1976   define input parameter p-tab-position   as integer      no-undo.
     1977   DEF INPUT PARAMETER p-file-name AS CHAR     NO-UNDO.
     1978   DEF INPUT PARAMETER p-log-level AS INTEGER  NO-UNDO.
     1979   DEF INPUT PARAMETER p-log-string  AS CHAR     NO-UNDO.
     1980   define variable sToWrite as character no-undo.
     1981   sToWrite = p-log-string + chr(10).
     1982   define variable v-text    as character    no-undo.
     1983    DO WITH frame F-Main:
     1984         ASSIGN
     1985            v-text = editor-log + chr(10) + p-log-string
     1986           editor-log = v-text.
     1987         DISPLAY editor-log.
     1988      END.
     1989   OUTPUT STREAM StreamLog TO VALUE(p-file-name) APPEND.
     1990       PUT STREAM StreamLog UNFORMATTED chr(10).
     1991       PUT STREAM StreamLog UNFORMATTED (IF (p-log-level = 0 OR sToWrite = "&DLine"
     1992                                         OR sToWrite = "&Line") THEN "" ELSE
     1993                                         cur-time-string-sec() + " ").
     1994       PUT STREAM StreamLog UNFORMATTED
     1995               (IF sToWrite = "&Line" THEN FILL("-", 80)
     1996                ELSE IF sToWrite = "&DLine" THEN FILL("=", 80)
     1997                ELSE sToWrite).
     1998   OUTPUT STREAM StreamLog CLOSE.
     1999   END PROCEDURE.
