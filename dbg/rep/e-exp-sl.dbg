      583   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      584   procedure cur-time :
      585      define output parameter p-today as date      no-undo .
      586      define output parameter p-time  as integer   no-undo .
      587     do
      588     on error undo, return error
      589     :
      590       define variable v-date1 as date      no-undo .
      591       define variable v-date2 as date      no-undo .
      592       define variable v-time  as integer   no-undo .
      593       assign
      594         v-date1 = today
      595         v-time  = time
      596         v-date2 = today
      597       .
      598       if v-date1 <> v-date2
      599       then do:
      600         assign
      601           v-date1 = today
      602           v-time  = v-time
      603         .
      604       end.
      605       assign
      606         p-today = v-date1
      607         p-time  = v-time
      608       .
      609     end.
      610   end.
      611   function cur-time-date returns character
      612   :
      613     return string(today, '99/99/9999':U) .
      614   end.
      615   function cur-time-mjd returns decimal
      616   :
      617     define variable v-date as date      no-undo .
      618     define variable v-time as integer   no-undo .
      619     run cur-time in this-procedure
      620       (output v-date
      621       ,output v-time
      622       ) .
      623     return integer(v-date) - 2400002 + (v-time / 86400) .
      624   end.
      625   function cur-time-get-ending-index returns integer
      626   (input p-number as integer
      627   )
      628   :
      629     if p-number < 0
      630     or p-number = ?
      631     then do:
      632       return 1 .
      633     end.
      634     define variable v-rest as integer   no-undo .
      635     assign
      636       p-number = p-number modulo 100
      637     .
      638     if p-number < 20
      639     then do:
      640       assign
      641         v-rest = p-number
      642       .
      643     end.
      644     else do:
      645       assign
      646         v-rest = p-number modulo 10
      647       .
      648     end.
      649     case v-rest :
      650       when 1
      651       then do:
      652         return 2 .
      653       end.
      654       when 2 or
      655       when 3 or
      656       when 4
      657       then do:
      658         return 3 .
      659       end.
      660       otherwise do:
      661         return 1 .
      662       end.
      663     end case .
      664   end.
      665   procedure cur-time-mjd-to-date :
      666      define input  parameter i-mjd-diff as decimal no-undo.
      667      define output parameter o-Date     as date    no-undo.
      668      define output parameter o-Time     as integer no-undo.
      669      define variable v-day-number as integer   no-undo .
      670      if    i-mjd-diff < 0
      671         or i-mjd-diff = ?
      672      then do:
      673         return "?" .
      674      end.
      675      assign
      676         v-day-number = truncate(i-mjd-diff,0).
      677         o-Date = date(v-day-number + 2400002).
      678         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      679     .
      680   end.
      681   function cur-time-mjd-to-string returns character
      682   (input p-mjd-diff as decimal
      683   )
      684   :
      685     define variable v-day-number as integer   no-undo .
      686     define variable v-seconds    as integer   no-undo .
      687     define variable v-hour       as integer   no-undo .
      688     define variable v-min        as integer   no-undo .
      689     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      690     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      691     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      692     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      693     if p-mjd-diff < 0
      694     or p-mjd-diff = ?
      695     then do:
      696       return "?" .
      697     end.
      698     assign
      699       v-day-number = integer(truncate(p-mjd-diff,0))
      700       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      701     .
      702     if v-seconds > 86400
      703     then do:
      704       assign
      705         v-seconds = 86400 - 1
      706       .
      707     end.
      708     if v-seconds < 0
      709     then do:
      710       assign
      711         v-seconds = 0
      712       .
      713     end.
      714     assign
      715       v-hour = truncate(v-seconds / 3600, 0)
      716     .
      717     assign
      718       v-seconds = v-seconds modulo 3600
      719     .
      720     assign
      721       v-min = truncate(v-seconds / 60, 0)
      722     .
      723     assign
      724       v-seconds = v-seconds modulo 60
      725     .
      726     return
      727         (if v-day-number <> 0
      728           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      729           else ""
      730         )
      731       + (if v-day-number <> 0 or v-hour <> 0
      732           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      733           else ""
      734         )
      735       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      736           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      737           else ""
      738         )
      739       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      740       .
      741   end.
      742   function cur-time-string returns character
      743   :
      744     define variable v-date as date      no-undo .
      745     define variable v-time as integer   no-undo .
      746     run cur-time in this-procedure
      747       (output v-date
      748       ,output v-time
      749       ) .
      750     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      751   end.
      752   function cur-time-string-sec returns character
      753   :
      754     define variable v-date as date      no-undo .
      755     define variable v-time as integer   no-undo .
      756     run cur-time in this-procedure
      757       (output v-date
      758       ,output v-time
      759       ) .
      760     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      761   end.
      762   function cur-time-custom  returns character
      763   (input p-prefix as character
      764   ,input p-date-format as character
      765   ,input p-delimiter as character
      766   ,input p-time-format as character
      767   ,input p-suffix as character
      768   )
      769   :
      770     define variable v-date as date      no-undo .
      771     define variable v-time as integer   no-undo .
      772     run cur-time in this-procedure
      773       (output v-date
      774       ,output v-time
      775       ) .
      776     return
      777       p-prefix
      778       + string(v-date, p-date-format)
      779       + p-delimiter
      780       + string(v-time, p-time-format)
      781       + p-suffix
      782       .
      783   end.
      784   function cur-time-print  returns character
      785   :
      786     define variable v-date as date      no-undo .
      787     define variable v-time as integer   no-undo .
      788     run cur-time in this-procedure
      789       (output v-date
      790       ,output v-time
      791       ) .
      792     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      793   end.
      794   function cur-time-datetime returns datetime
      795   :
      796     define variable v-char as character no-undo .
      797     define variable v-datetime as datetime no-undo .
      798     v-char = cur-time-string().
      799     v-datetime = datetime(v-char).
      800     return  v-datetime.
      801   end.
      802   function cur-time-string-msec returns character
      803   :
      804     define variable v-date as datetime  no-undo .
      805     v-date = now.
      806     return string(v-date) .
      807   end.
      808   define stream LogStream .
      809   define variable mNoTime as logical no-undo.
      810   procedure write-to-log-notime :
      811     define input param i-str as character no-undo .
      812     mNoTime = yes.
      813     run write-to-log (i-str).
      814     mNoTime = no.
      815   end.
      816   procedure write-to-log :
      817     define input param p-str as character no-undo .
      818     do
      819     on error  undo, return error substitute( "&1 (write-to-log). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      820     on stop   undo, return error substitute( "&1 (write-to-log). stop", vss-workfile )
      821     on endkey undo, return error substitute( "&1 (write-to-log). endkey", vss-workfile )
      822     :
      823       define variable log-res        as logical   no-undo .
      824       define variable v-jj           as integer   no-undo .
      825       if    mNoTime
      826          or writelogvalue eq "AsyncProc"
      827       then
      828          p-str = substitute( "&1 (pid: &2) &3&4"   , g#auto-user-id, g#auto-pid,                        p-str, chr(10) ).
      829       else
      830          p-str = substitute( "&1 (pid: &2) &3 &4&5", g#auto-user-id, g#auto-pid, cur-time-string-sec(), p-str, chr(10) ).
      831       if auto-log-msg-h <> ? then do:
      832         log-res = auto-log-msg-h:move-to-eof( ) .
      833         log-res = auto-log-msg-h:insert-string( p-str ).
      834       end.
      835       if hand-log-msg-h <> ? then do:
      836         log-res = hand-log-msg-h:move-to-eof( ) .
      837         log-res = hand-log-msg-h:insert-string( p-str ).
      838       end.
      839       assign
      840         p-str = replace(p-str, (chr(10) + chr(13)), chr(10) )
      841         p-str = replace(p-str, (chr(13) + chr(10)), chr(10) )
      842         p-str = replace(p-str, chr(10), (chr(13) + chr(10)) )
      843       .
      844       if add-log-file-name <> ? then do:
      845         do v-jj = 1 to num-entries(add-log-file-name, chr(1)):
      846           run gbl/fileapnd.p
      847             ( input entry(v-jj, add-log-file-name, chr(1) )
      848             ,input p-str
      849             ,input 20
      850             ) no-error .
      851           if error-status:error then do:
      852             return error return-value .
      853           end.
      854         end.
      855       end.
      856       if writelogvalue eq "AsyncProc"
      857       then do:
      858          p-str = trim(p-str, (chr(13) + chr(10)) )
      859       .
      860          Publish "WriteLogAsunc" (p-str,yes).
      861       end.
      862       else if writelogvalue <> "yes" then do:
      863         run gbl/fileapnd.p
      864           ( input log-file-name
      865           ,input p-str
      866           ,input 20
      867           ) no-error .
      868         if error-status:error then do:
      869           return error return-value .
      870         end.
      871       end.
      872     end.
      873   end procedure.
      874   procedure write-to-screen :
      875     define input param p-str as character no-undo .
      876     do
      877     on error  undo, return error substitute( "&1 (write-to-screen). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      878     on stop   undo, return error substitute( "&1 (write-to-screen). stop", vss-workfile )
      879     on endkey undo, return error substitute( "&1 (write-to-screen). endkey", vss-workfile )
      880     :
      881       define variable log-res as logical no-undo.
      882       assign
      883         p-str = substitute( "&1 (pid: &2) &3 &4&5", g#auto-user-id, g#auto-pid, cur-time-string-sec(), p-str, chr(10) )
      884       .
      885       if auto-log-msg-h <> ?
      886       then do:
      887         log-res = auto-log-msg-h:move-to-eof( ) .
      888         log-res = auto-log-msg-h:insert-string( p-str ).
      889       end.
      890       if hand-log-msg-h <> ?
      891       then do:
      892         log-res = hand-log-msg-h:move-to-eof( ) .
      893         log-res = hand-log-msg-h:insert-string( p-str ).
      894       end.
      895     end.
      896   end procedure.
      897   procedure send-msg-to-email :
      898     define input  parameter p-subject      as character no-undo .
      899     define input  parameter p-text-err     as character no-undo .
      900     define input  parameter p-attach-files as character no-undo .
      901     do
      902     on error  undo, return error substitute( "&1 (send-msg-to-email). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      903     on stop   undo, return error substitute( "&1 (send-msg-to-email). stop", vss-workfile )
      904     on endkey undo, return error substitute( "&1 (send-msg-to-email). endkey", vss-workfile )
      905     :
      906       define variable v-tth             as handle    no-undo .
      907       define variable v-value-character as character no-undo .
      908       define variable v-value-date      as date      no-undo .
      909       define variable v-value-decimal   as decimal   no-undo .
      910       define variable v-value-integer   as integer   no-undo .
      911       define variable v-value-logical   as logical   no-undo .
      912       define variable v-param-type      as character no-undo .
      913       define variable v-email       as character no-undo .
      914       define variable v-tmp-str     as character no-undo .
      915       define variable v-tmp1-str    as character no-undo .
      916       define variable v-ind         as integer   no-undo .
      917       define variable v-num-entries as integer   no-undo .
      918       delete object v-tth no-error.
      919       run adm/shattri.p
      920         ( input "get":U
      921          ,input  "":U
      922          ,input  0
      923          ,input  'auto-task':U
      924          ,input  'send-msg-to-email':U
      925          ,output v-value-character
      926          ,output v-value-date
      927          ,output v-value-decimal
      928          ,output v-value-integer
      929          ,output v-value-logical
      930          ,output v-param-type
      931          ,input-output table-handle v-tth
      932         ) no-error .
      933       if not error-status :error  then do:
      934         assign
      935           v-tmp-str = v-value-character
      936         .
      937       end.
      938       delete object v-tth no-error.
      939       assign
      940         v-tmp-str     = replace(v-tmp-str, (chr(10) + chr(13)), chr(44) )
      941         v-tmp-str     = replace(v-tmp-str, (chr(13) + chr(10)), chr(44) )
      942         v-tmp-str     = replace(v-tmp-str, chr(10), chr(44) )
      943         v-num-entries = num-entries( v-tmp-str, chr(44) )
      944         v-email       = "":U
      945       .
      946       do v-ind = 1 to v-num-entries
      947       :
      948         assign
      949           v-tmp1-str = entry( v-ind, v-tmp-str, chr(44) )
      950         .
      951         if trim( v-tmp1-str ) <> "":U then do:
      952           if v-email = "":U then do:
      953             assign
      954               v-email = v-tmp1-str
      955             .
      956           end.
      957           else do:
      958             assign
      959               v-email = v-email + chr(44) + v-tmp1-str
      960             .
      961           end.
      962         end.
      963       end.
      964       if v-email <> "":U then do:
      965         run gbl/sendmail.p
      966           ( input v-email
      967           , input p-subject
      968           , input p-text-err
      969           , input p-attach-files
      970           ) no-error .
      971         if error-status :error
      972           or return-value <> "":U
      973         then do:
      974           return error substitute( "&1 (send-msg-to-email). &2", vss-workfile, return-value ) .
      975         end.
      976       end.
      977     end.
      978   end procedure.
      979   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      980   procedure proc-alt-shift-f2:
      981     if not ibs.th.gbl.gbl-var:rcode
      982   then
      983     run gbl\inidebug.p .
      984   end.
      985   procedure proc-alt-shift-f3:
      986     run gbl/prvssinf.p
      987       ( input this-procedure
      988       ) .
      989   end.
      990   define variable v-inform-launched as logical no-undo initial false .
      991   procedure proc-alt-shift-f4:
      992     define variable v-action as character no-undo .
      993     if v-inform-launched = false then do:
      994       assign
      995         v-inform-launched = true
      996       .
      997       run gbl/d-inform.w
      998         (  input self
      999         ,  input this-procedure
     1000         , output v-action
     1001         ) no-error .
     1002       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
     1003       assign
     1004         v-inform-launched = false
     1005       .
     1006     end.
     1007   end.
     1008   procedure proc-alt-f1:
     1009     run gbl/corrhelp.p
     1010       (input this-procedure
     1011       ) .
     1012   end .
     1013   on alt-shift-f2 anywhere do:
     1014     run proc-alt-shift-f2.
     1015   end.
     1016   on alt-shift-f3 anywhere do:
     1017     run proc-alt-shift-f3 in this-procedure .
     1018   end.
     1019   on alt-shift-f4 anywhere do:
     1020     run proc-alt-shift-f4 in this-procedure.
     1021   end.
     1022   on alt-f1 anywhere do:
     1023     run proc-alt-f1 in this-procedure .
     1024   end.
     1025   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1026     define variable v-cntxt-db-num        as integer   no-undo .
     1027     define variable v-cntxt-userid        as character no-undo .
     1028     define variable v-cntxt-level         as character no-undo .
     1029     define variable v-cntxt-host-code-obj as integer   no-undo .
     1030     define variable v-cntxt-obj-type      as character no-undo .
     1031     define variable v-cntxt-obj-code      as integer   no-undo .
     1032     define variable v-cntxt-db-num-obj    as integer   no-undo .
     1033     define variable v-cntxt-is-admin      as logical   no-undo .
     1034   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1035     run mainmenu_getcntxt in my-handle
