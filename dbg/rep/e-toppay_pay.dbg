     1003   define  stream PrnLibStream.
     1004   procedure prn-lib-prn-file :
     1005     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1006     define input parameter p-DIsabledoptions as integer no-undo .
     1007     define variable v-report-name as character no-undo .
     1008     define variable v-user-action as character no-undo .
     1009     define variable v-printed     as logical   no-undo .
     1010     define variable v-exist       as logical   no-undo .
     1011     do
     1012       on error undo, return error
     1013       :
     1014       run prn-lib-get-report-name  in this-procedure (
     1015         input parParentProc
     1016         ,output v-report-name
     1017         ).
     1018   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1019   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
     1020     (input  v-report-name
     1021     ,input  2
     1022     ,output v-exist
     1023     )  .
     1024       if NOT v-exist then
     1025       DO:
     1026         Message
     1027           "Нет заданий на печать ! "
     1028           view-as alert-box .
     1029         Return  .
     1030       End.
     1031       run gbl/prnfilen.w
     1032         (input  ""
     1033         ,input  p-DisabledOptions
     1034         ,input  string(v-report-name )
     1035         ,input  7
     1036         ,output v-user-action
     1037         ,output v-printed
     1038         ) .
     1039       if v-printed then
     1040       do:
     1041         return "YES" .
     1042       end.
     1043       else
     1044       do:
     1045         return "NO" .
     1046       end.
     1047     end.
     1048   end procedure.
     1049   procedure prn-lib-open-stream :
     1050     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1051     define input parameter p-page-size    as integer no-undo .
     1052     define input parameter p-is-stream    as logical no-undo .
     1053     define input parameter p-append       as logical no-undo .
     1054     define variable v-report-name as character no-undo .
     1055     do
     1056       on error undo, return error
     1057       :
     1058       run prn-lib-get-report-name  in this-procedure (
     1059         input parParentProc
     1060         ,output v-report-name
     1061         ).
     1062       if p-is-stream then
     1063       do:
     1064         if p-append then
     1065         do:
     1066           output stream PrnLibStream to value( v-report-name )
     1067             page-size value(p-page-size) append .
     1068         end.
     1069         if not p-append then
     1070         do:
     1071           output stream PrnLibStream to value( v-report-name )
     1072             page-size value(p-page-size) .
     1073         end.
     1074       end.
     1075       if not p-is-stream then
     1076       do:
     1077         if p-append then
     1078         do:
     1079           output to value( v-report-name )
     1080             page-size value(p-page-size) append .
     1081         end.
     1082         if not p-append then
     1083         do:
     1084           output to value( v-report-name )
     1085             page-size value(p-page-size) .
     1086         end.
     1087       end.
     1088     end.
     1089   end procedure.
     1090   procedure prn-lib-open-exp :
     1091     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1092     define input parameter p-is-stream    as logical no-undo .
     1093     define input parameter p-is-append    as logical no-undo .
     1094     define output parameter p-ReportFileName as char init "report" no-undo.
     1095     define output parameter p-process as logical no-undo .
     1096     define variable glog as logical no-undo .
     1097     do
     1098       on error undo, return error
     1099       :
     1100       SYSTEM-DIALOG GET-FILE p-ReportFileName
     1101         TITLE      "Укажите путь"
     1102         FILTERS "Текстовый файл (*.txt)"   "*.txt"
     1103         ASK-OVERWRITE
     1104         CREATE-TEST-FILE
     1105         SAVE-AS
     1106         USE-FILENAME
     1107         DEFAULT-EXTENSION "txt"
     1108         UPDATE glog
     1109         .
     1110       if not glog then  return.
     1111       p-ReportFileName = trim( string( p-ReportFileName ) ) .
     1112       if p-is-stream then
     1113       do:
     1114         if p-is-append then
     1115         do:
     1116           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1117         end.
     1118         else
     1119         do:
     1120           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1121         end.
     1122       end.
     1123       else
     1124       do:
     1125         if p-is-append then
     1126         do:
     1127           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1128         end.
     1129         else
     1130         do:
     1131           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1132         end.
     1133       end.
     1134       p-process = yes.
     1135     end.
     1136   end procedure.
     1137   procedure prn-lib-get-report-name :
     1138     define input parameter parParentProc  as widget-handle no-undo.
     1139     define output parameter p-report-name as character no-undo .
     1140     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
     1141   end procedure.
     1142   procedure prn-lib-reportviewer-report-name :
     1143     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1144     define input parameter p-report-name-html as character no-undo .
     1145     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
     1146   end procedure.
     1147   procedure prn-lib-reportviewer :
     1148     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1149     define input parameter p-report-name-html as character no-undo .
     1150     define input parameter p-param        as character no-undo .
     1151     define variable v-excel           as character no-undo init 'TRUE' .
     1152     define variable v-value-character as character no-undo .
     1153     define variable v-value-integer   as character no-undo .
     1154     define variable v-value-date      as date      no-undo .
     1155     define variable v-value-decimal   as decimal   no-undo .
     1156     define variable rep-excel         as logical   no-undo .
     1157     define variable excel-string      as character no-undo .
     1158     define variable v-param-type      as character no-undo .
     1159     define variable v-tth             as handle    no-undo .
     1160     run adm/shattri.p (
     1161       input "get":U
     1162       ,input  ""
     1163       ,input  0
     1164       ,input  'report-glob':U
     1165       ,input  'rep-excel':U
     1166       ,output v-value-character
     1167       ,output v-value-date
     1168       ,output v-value-decimal
     1169       ,output v-value-integer
     1170       ,output rep-excel
     1171       ,output v-param-type
     1172       ,INPUT-OUTPUT table-handle v-tth
     1173       )  .
     1174     if rep-excel then v-excel = "TRUE" .
     1175     else v-excel = "FALSE" .
     1176     if p-param eq ""
     1177     then
     1178        p-param = "EXCEL:" + v-excel.
     1179     else
     1180        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
     1181     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
     1182   end procedure.
     1183   function diff-list returns character (
     1184     input parfirst-list  as character,
     1185     input parsecond-list as character,
     1186     input pardelim       as character).
     1187     if pardelim = ""
     1188     or pardelim = ?
     1189     then do:
     1190       assign
     1191         pardelim = ","
     1192       .
     1193     end.
     1194     def var ind as integer no-undo .
     1195     def var v-elem as character no-undo .
     1196     def var v-result-list as character no-undo init "".
     1197     def var v-num-parfirst-list as integer no-undo .
     1198     assign
     1199       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
     1200     .
     1201     do ind = 1 to v-num-parfirst-list
     1202     :
     1203       assign
     1204         v-elem = entry(ind, parfirst-list, pardelim)
     1205       .
     1206       if lookup(v-elem, parsecond-list, pardelim) = 0 then do:
     1207         assign
     1208           v-result-list = v-result-list
     1209                         + (if v-result-list > "" then pardelim else "")
     1210                         + v-elem
     1211         .
     1212       end.
     1213     end.
     1214     return v-result-list .
     1215   end function.
     1216   function add-list returns character (
     1217    input parfirst-list  as character,
     1218    input parsecond-list as character,
     1219    input pardelim       as character).
     1220     if pardelim = ""
     1221     or pardelim = ?
     1222     then do:
     1223       assign
     1224         pardelim = ","
     1225       .
     1226     end.
     1227     def var ind as integer no-undo .
     1228     def var v-elem as character no-undo .
     1229     def var v-result-list as character no-undo init "".
     1230     def var v-num-parfirst-list as integer no-undo .
     1231     assign
     1232       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
     1233     .
     1234     do ind = 1 to v-num-parfirst-list
     1235     :
     1236       assign
     1237         v-elem = entry(ind, parfirst-list, pardelim)
     1238       .
     1239       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
     1240         assign
     1241           v-result-list = v-result-list
     1242                         + (if v-result-list > "" then pardelim else "")
     1243                         + v-elem
     1244         .
     1245       end.
     1246     end.
     1247     def var v-num-parsecond-list as integer no-undo .
     1248     assign
     1249       v-num-parsecond-list = num-entries(parsecond-list, pardelim)
     1250     .
     1251     do ind = 1 to v-num-parsecond-list
     1252     :
     1253       assign
     1254         v-elem = entry(ind, parsecond-list, pardelim)
     1255       .
     1256       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
     1257         assign
     1258           v-result-list = v-result-list
     1259                         + (if v-result-list > "" then pardelim else "")
     1260                         + v-elem
     1261         .
     1262       end.
     1263     end.
     1264     return v-result-list .
     1265   end function.
     1266   function cross-list returns character (
     1267    input parfirst-list  as character,
     1268    input parsecond-list as character,
     1269    input pardelim       as character).
     1270     if pardelim = ""
     1271     or pardelim = ?
     1272     then do:
     1273       assign
     1274         pardelim = ","
     1275       .
     1276     end.
     1277     def var ind as integer no-undo .
     1278     def var v-elem as character no-undo .
     1279     def var v-result-list as character no-undo init "".
     1280     def var v-num-parfirst-list as integer no-undo .
     1281     assign
     1282       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
     1283     .
     1284     do ind = 1 to v-num-parfirst-list
     1285     :
     1286       assign
     1287         v-elem = entry(ind, parfirst-list, pardelim)
     1288       .
     1289       if lookup(v-elem, v-result-list, pardelim) = 0
     1290       and lookup(v-elem, parsecond-list, pardelim) > 0
     1291       then do:
     1292         assign
     1293           v-result-list = v-result-list
     1294                         + (if v-result-list > "" then pardelim else "")
     1295                         + v-elem
     1296         .
     1297       end.
     1298     end.
     1299     return v-result-list .
     1300   end function.
     1301   function radio-label returns character (
     1302    input par-rs-value  as character,
     1303    input par-rs-radio-buttons as character)
     1304    .
     1305    DEFINE variable v-result-label as character no-undo.
     1306    assign
     1307    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons) MODULO 2 = 0)
     1308                              then (LOOKUP(par-rs-value, par-rs-radio-buttons) - 1)
     1309                              else LOOKUP(par-rs-value, par-rs-radio-buttons)
     1310                             ), par-rs-radio-buttons
     1311                           )
     1312    v-result-label = REPLACE(v-result-label, "&":U, "":U)
     1313    .
     1314   return v-result-label.
     1315   end function.
     1316   function m-radio-label returns character (
     1317    input par-rs-value  as character,
     1318    input par-rs-radio-buttons as character,
     1319    input par-delim as character
     1320    )
     1321    .
     1322    DEFINE variable v-result-label as character no-undo.
     1323    assign
     1324    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) MODULO 2 = 0)
     1325                              then (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) - 1)
     1326                              else LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim)
     1327                             ), par-rs-radio-buttons, par-delim
     1328                           )
     1329    v-result-label = REPLACE(v-result-label, "&":U, "":U)
     1330    .
     1331   return v-result-label.
     1332   end function.
     1333   FUNCTION mixlist returns character
     1334   (
     1335    input parfirst-list  as character
     1336    ,input parsecond-list as character
     1337    ,input pardelim       as character
     1338    ,input pardelim-result as character ) :
     1339     if pardelim = ""
     1340     or pardelim = ?
     1341     then do:
     1342       assign
     1343         pardelim = ","
     1344       .
     1345     end.
     1346     def var ind as integer no-undo .
     1347     def var v-elem1 as character no-undo .
     1348     def var v-elem2 as character no-undo .
     1349     def var v-result-list as character no-undo init "".
     1350     do ind = 1 to num-entries(parfirst-list, pardelim)
     1351     :
     1352       assign
     1353         v-elem1 = entry(ind, parfirst-list, pardelim)
     1354         v-elem2 = entry(ind, parsecond-list, pardelim)
     1355       .
     1356         assign
     1357           v-result-list = v-result-list
     1358                         + (if v-result-list > "" then pardelim-result else "")
     1359                         + v-elem1 + pardelim-result + v-elem2
     1360         .
     1361     end.
     1362     return v-result-list .
     1363   END FUNCTION.
     1364   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1365   function breakstr returns character ( input        for-name    as character,
     1366                                         input        line-length as integer,
     1367                                         input-output line1       as character,
     1368                                         input-output line2       as character ) :
     1369     define variable ii as integer no-undo.
     1370     if length( for-name ) > line-length then do:
     1371       assign ii    = 1
     1372              line1 = "":u
     1373              line2 = "":u.
     1374       if length( entry( ii, for-name , " ":u ) ) > line-length then do:
     1375         assign line1 =       substring( for-name, 1, line-length     )
     1376                line2 = trim( substring( for-name,    line-length + 1 ) ).
     1377       end.                                                     else do:
     1378         do while length( line1 + entry( ii, for-name, " ":u ) ) < ( line-length + 1 ) :
     1379           assign line1 = line1 + entry( ii, for-name, " ":u ) + " ":u
     1380                  ii    = ii    + 1.
     1381           if length( entry( ii, for-name, " ":u ) ) > line-length then do:
     1382             assign line1 = line1 + substring( for-name, length( line1 ), line-length - length( line1 ) + 1 ).
     1383           end.
     1384         end.
     1385         assign line2 = trim( substring( for-name, length( line1 ) ) ).
     1386       end.
     1387     end.                                else do:
     1388       assign line1 = for-name
     1389              line2 = "":u.
     1390     end.
     1391     return ( line1 ).
     1392   end function.
