     3134     (input  bf_trn-doc.obj-type
     3135     ,input  bf_trn-doc.obj-code
     3136     ,input  varb-code
     3137     ,input  0
     3138     ,input  bf_trn-doc.fact-order
     3139     ,output vardoc-num
     3140     ,output varprice-sale
     3141     ,output varroad-tax
     3142     ,output varexcise
     3143     )  .
     3144             if varprice-sale = ?
     3145             then do:
     3146               assign
     3147                 varprice-sale = 0
     3148                 varroad-tax   = 0
     3149                 varexcise     = 0
     3150               .
     3151             end.
     3152             assign
     3153               varlastcur-base     = varprice-sale
     3154               varlastcur-road-tax = varroad-tax
     3155               varlastcur-excise   = varexcise
     3156               varcur-base         = varcur-base      + varprice-sale * bf_gds-dtl.fact-qnty
     3157               varcur-road-tax     = varcur-road-tax  + varroad-tax   * bf_gds-dtl.fact-qnty
     3158               varcur-excise       = varcur-excise    + varexcise     * bf_gds-dtl.fact-qnty
     3159               varcur-fact-qnty    = varcur-fact-qnty + bf_gds-dtl.fact-qnty
     3160             .
     3161         end.
     3162       end.
     3163       if varcur-fact-qnty = 0 then do:
     3164         assign
     3165           varcur-base      = varlastcur-base
     3166           varcur-road-tax  = varlastcur-road-tax
     3167           varcur-excise    = varlastcur-excise
     3168         .
     3169       end.
     3170       else do:
     3171         assign
     3172           varcur-base      = varcur-base      / varcur-fact-qnty
     3173           varcur-road-tax  = varcur-road-tax  / varcur-fact-qnty
     3174           varcur-excise    = varcur-excise    / varcur-fact-qnty
     3175         .
     3176       end.
     3177       if varcur-vat-pc = ?
     3178       then do:
     3179         return error substitute ("Нет текущего продажного НДС по товару &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     3180       end.
