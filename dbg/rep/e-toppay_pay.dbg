     2798       bfsacc_tt-allsum.vat-rubl-cur        = 0
     2799       bfsacc_tt-allsum.vat-base-buyer-cur  = bfs_tt-allsum.vat-base-acc
     2800       bfsacc_tt-allsum.vat-rubl-buyer-cur  = bfs_tt-allsum.vat-rubl-acc
     2801       bfsacc_tt-allsum.slt-base-cur        = bfs_tt-allsum.slt-base-acc
     2802       bfsacc_tt-allsum.slt-rubl-cur        = bfs_tt-allsum.slt-rubl-acc
     2803       bfsacc_tt-allsum.road-tax-base-cur   = bfs_tt-allsum.road-tax-base-acc
     2804       bfsacc_tt-allsum.road-tax-rubl-cur   = bfs_tt-allsum.road-tax-rubl-acc
     2805       bfsacc_tt-allsum.excise-base-cur     = bfs_tt-allsum.excise-base-acc
     2806       bfsacc_tt-allsum.excise-rubl-cur     = bfs_tt-allsum.excise-rubl-acc
     2807       bfsacc_tt-allsum.sum-dsc-base-acc    = bfs_tt-allsum.sum-dsc-base-acc
     2808       bfsacc_tt-allsum.sum-dsc-rubl-acc    = bfs_tt-allsum.sum-dsc-rubl-acc
     2809       bfsacc_tt-allsum.sum-dsc-cli-acc     = bfs_tt-allsum.sum-dsc-cli-acc
     2810       bfsacc_tt-allsum.dsc-base-acc        = bfs_tt-allsum.dsc-base-acc
     2811       bfsacc_tt-allsum.dsc-rubl-acc        = bfs_tt-allsum.dsc-rubl-acc
     2812       bfsacc_tt-allsum.dsc-cli-acc         = bfs_tt-allsum.dsc-cli-acc
     2813       bfsacc_tt-allsum.vat-base-acc        = bfs_tt-allsum.vat-base-acc
     2814       bfsacc_tt-allsum.vat-rubl-acc        = bfs_tt-allsum.vat-rubl-acc
     2815       bfsacc_tt-allsum.vat-cli-acc         = bfs_tt-allsum.vat-cli-acc
     2816       bfsacc_tt-allsum.slt-base-acc        = bfs_tt-allsum.slt-base-acc
     2817       bfsacc_tt-allsum.slt-rubl-acc        = bfs_tt-allsum.slt-rubl-acc
     2818       bfsacc_tt-allsum.slt-cli-acc         = bfs_tt-allsum.slt-cli-acc
     2819       bfsacc_tt-allsum.excise-base-acc     = bfs_tt-allsum.excise-base-acc
     2820       bfsacc_tt-allsum.excise-rubl-acc     = bfs_tt-allsum.excise-rubl-acc
     2821       bfsacc_tt-allsum.excise-cli-acc      = bfs_tt-allsum.excise-cli-acc
     2822       bfsacc_tt-allsum.road-tax-base-acc   = bfs_tt-allsum.road-tax-base-acc
     2823       bfsacc_tt-allsum.road-tax-rubl-acc   = bfs_tt-allsum.road-tax-rubl-acc
     2824       bfsacc_tt-allsum.road-tax-cli-acc    = bfs_tt-allsum.road-tax-cli-acc
     2825       bfsacc_tt-allsum.transport-base-acc  = bfs_tt-allsum.transport-base-acc
     2826       bfsacc_tt-allsum.transport-rubl-acc  = bfs_tt-allsum.transport-rubl-acc
     2827       bfsacc_tt-allsum.transport-cli-acc   = bfs_tt-allsum.transport-cli-acc
     2828       bfsacc_tt-allsum.other-base-acc      = bfs_tt-allsum.other-base-acc
     2829       bfsacc_tt-allsum.other-rubl-acc      = bfs_tt-allsum.other-rubl-acc
     2830       bfsacc_tt-allsum.other-cli-acc       = bfs_tt-allsum.other-cli-acc
     2831       .
     2832   end.
     2833   otherwise do:
     2834     return error substitute ("Неизвестный тип приобретения &1 по партии с кодом &2 по документу &3, порожденную документом &4 по товару &5 &6 &7.",
     2835                              cl_tt-clcparts.purch-code,
     2836                              cl_tt-clcparts.part-code,
     2837                              cl_tt-clcparts.out-code,
     2838                              cl_tt-clcparts.in-code,
     2839                              cl_tt-clcparts.artic,
     2840                              cl_tt-clcparts.prod-type,
     2841                              cl_tt-clcparts.prod-code).
     2842   end.
     2843   end case.
     2844   end.
     2845   end procedure.
     2846   procedure clcprtsl_calc-line :
     2847   define input  parameter parrec-line as recid no-undo.
     2848   define variable v-tax-date         as   date                     no-undo.
     2849   define variable v-vat-pc           like ub.doc-line.vat-pc       no-undo.
     2850   define variable varr-b             as   character                no-undo.
     2851   define variable varr-btype         as   character                no-undo.
     2852   define variable varcur-base        like ub.gds-dtl.price-base    no-undo.
     2853   define variable varcur-road-tax    like ub.doc-line.road-tax     no-undo.
     2854   define variable varcur-excise      like ub.doc-line.excise       no-undo.
     2855   define variable varcur-vat-pc      like ub.doc-line.vat-pc       no-undo.
     2856   define variable varcur-cons-vat-pc like ub.doc-line.cons-vat-pc  no-undo.
     2857   define variable varcur-slt-pc      like ub.doc-line.slt-pc       no-undo.
     2858   define variable varcur-fact-qnty   like ub.gds-dtl.fact-qnty     no-undo.
     2859   define variable varb-code          like ub.bar-code.b-code       no-undo.
     2860   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     2861   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     2862   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     2863   define variable varexcise          like ub.price-list.excise     no-undo.
     2864   define variable varlastcur-base        like ub.gds-dtl.price-base no-undo.
     2865   define variable varlastcur-road-tax    like ub.gds-dtl.price-base no-undo.
     2866   define variable varlastcur-excise      like ub.gds-dtl.price-base     no-undo.
     2867   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     2868   define variable v-varsum           as decimal                  no-undo.
     2869   define variable varprice-salef as decimal   no-undo .
     2870   define buffer bf_trn-doc             for ub.trn-doc.
     2871   define buffer bf_doc-line            for ub.doc-line.
     2872   define buffer bf_gds-dtl             for ub.gds-dtl.
     2873   define buffer bf_goods               for ub.goods.
     2874   define buffer bf_parts               for ub.parts.
     2875   define buffer bf_sysconf             for ub.sysconf.
     2876   define buffer bf_tt-allsum-line      for tt-allsum-line.
     2877   define buffer bfs_tt-allsum-line     for tt-allsum-line.
     2878   define buffer bfo_tt-allsum-line     for tt-allsum-line.
     2879   define buffer bfos_tt-allsum-line    for tt-allsum-line.
     2880   define buffer buf_parts        for ub.parts.
     2881   v-calcbypart = no.
     2882   do on error undo, return error return-value :
     2883   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     2884   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     2885     (output varr-b
     2886     )  .
     2887     find first bf_doc-line where recid (bf_doc-line) = parrec-line no-lock.
     2888     find first bf_trn-doc where bf_trn-doc.doc-code = bf_doc-line.doc-code no-lock.
     2889     find first bf_goods where bf_goods.artic     = bf_doc-line.artic     and
     2890                               bf_goods.prod-type = bf_doc-line.prod-type and
     2891                               bf_goods.prod-code = bf_doc-line.prod-code no-lock.
     2892     if bf_trn-doc.fact-date <> ?        then do:
     2893       assign v-tax-date = bf_trn-doc.fact-date.
     2894     end.
     2895     else do:
     2896       assign v-tax-date = ?.
     2897     end.
     2898   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2899   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     2900     (input  bf_goods.gds-code
     2901     ,input  '1':U
     2902     ,input  v-tax-date
     2903     ,input  bf_trn-doc.host-code
     2904     ,input  bf_trn-doc.obj-type
     2905     ,input  bf_trn-doc.obj-code
     2906     ,output v-vat-pc
     2907     ) no-error .
     2908     if error-status :error
     2909     or v-vat-pc = ? then do:
     2910        return error substitute ("Ошибка при поиске НДС для товара &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     2911     end.
     2912     if bf_goods.gds-type = 'у':U or
     2913        bf_trn-doc.status_ = 'запрос':U then do:
     2914       for each bf_tt-allsum-line
     2915       on error undo, return error return-value
     2916        :
     2917         delete bf_tt-allsum-line.
     2918       end.
     2919       create bf_tt-allsum-line.
     2920       assign
     2921        bf_tt-allsum-line.sum-type = 'основная_сумма':U.
     2922       for each bf_gds-dtl where bf_gds-dtl.doc-code  = bf_doc-line.doc-code  and
     2923                                 bf_gds-dtl.artic     = bf_doc-line.artic     and
     2924                                 bf_gds-dtl.prod-type = bf_doc-line.prod-type and
     2925                                 bf_gds-dtl.prod-code = bf_doc-line.prod-code no-lock on error undo, return error return-value :
     2926         assign
     2927           bf_tt-allsum-line.fact-qnty            =  bf_tt-allsum-line.fact-qnty        + bf_gds-dtl.fact-qnty
     2928           bf_tt-allsum-line.sum-dsc-base-doc     =  bf_tt-allsum-line.sum-dsc-base-doc + (bf_gds-dtl.price-base - bf_gds-dtl.discnt-base) * bf_gds-dtl.fact-qnty
     2929           bf_tt-allsum-line.sum-dsc-rubl-doc     =  bf_tt-allsum-line.sum-dsc-rubl-doc + (bf_gds-dtl.price-rubl - bf_gds-dtl.discnt-rubl) * bf_gds-dtl.fact-qnty
     2930           bf_tt-allsum-line.dsc-base-doc         =  bf_tt-allsum-line.dsc-base-doc     + bf_gds-dtl.discnt-base * bf_gds-dtl.fact-qnty
     2931           bf_tt-allsum-line.dsc-rubl-doc         =  bf_tt-allsum-line.dsc-rubl-doc     + bf_gds-dtl.discnt-rubl * bf_gds-dtl.fact-qnty
     2932           bf_tt-allsum-line.sum-dsc-base-cur     =  bf_tt-allsum-line.sum-dsc-base-cur + (if varr-b = "base" then bf_gds-dtl.cur-base else bf_gds-dtl.cur-base / bf_trn-doc.exch-rate * bf_trn-doc.exch-scale) * bf_gds-dtl.fact-qnty
     2933           bf_tt-allsum-line.sum-dsc-rubl-cur     =  bf_tt-allsum-line.sum-dsc-rubl-cur + (if varr-b = "rubl" then bf_gds-dtl.cur-base else bf_gds-dtl.cur-base * bf_trn-doc.exch-rate / bf_trn-doc.exch-scale) * bf_gds-dtl.fact-qnty
     2934           bf_tt-allsum-line.sum-dsc-base-acc     =  bf_tt-allsum-line.sum-dsc-base-acc + bf_doc-line.price-base * bf_gds-dtl.fact-qnty
     2935           bf_tt-allsum-line.sum-dsc-rubl-acc     =  bf_tt-allsum-line.sum-dsc-rubl-acc + bf_doc-line.price-rubl * bf_gds-dtl.fact-qnty
     2936           bf_tt-allsum-line.sum-dsc-cli-acc      =  ?
     2937           bf_tt-allsum-line.vat-base-acc         =  bf_tt-allsum-line.vat-base-acc     + bf_doc-line.price-base * v-vat-pc / (100 + v-vat-pc) * bf_gds-dtl.fact-qnty
     2938           bf_tt-allsum-line.vat-rubl-acc         =  bf_tt-allsum-line.vat-rubl-acc     + bf_doc-line.price-rubl * v-vat-pc / (100 + v-vat-pc) * bf_gds-dtl.fact-qnty
     2939           bf_tt-allsum-line.vat-cli-acc          =  ?
     2940           .
     2941       end.
     2942       assign
     2943         bf_tt-allsum-line.cli-qnty             =  ?
     2944         bf_tt-allsum-line.slt-base-doc         =  bf_tt-allsum-line.sum-dsc-base-doc * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     2945         bf_tt-allsum-line.slt-rubl-doc         =  bf_tt-allsum-line.sum-dsc-rubl-doc * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     2946         bf_tt-allsum-line.vat-base-buyer-doc   =  (bf_tt-allsum-line.sum-dsc-base-doc - bf_tt-allsum-line.slt-base-doc) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     2947         bf_tt-allsum-line.vat-rubl-buyer-doc   =  (bf_tt-allsum-line.sum-dsc-rubl-doc - bf_tt-allsum-line.slt-rubl-doc) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     2948         bf_tt-allsum-line.road-tax-base-doc    =  0
     2949         bf_tt-allsum-line.road-tax-rubl-doc    =  0
     2950         bf_tt-allsum-line.excise-base-doc      =  0
     2951         bf_tt-allsum-line.excise-rubl-doc      =  0
     2952         bf_tt-allsum-line.vat-base-doc         =  bf_tt-allsum-line.vat-base-buyer-doc
     2953         bf_tt-allsum-line.vat-rubl-doc         =  bf_tt-allsum-line.vat-rubl-buyer-doc
     2954         bf_tt-allsum-line.dsc-base-cur         =  0
     2955         bf_tt-allsum-line.dsc-rubl-cur         =  0
     2956         bf_tt-allsum-line.slt-base-cur         =  bf_tt-allsum-line.sum-dsc-base-cur * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     2957         bf_tt-allsum-line.slt-rubl-cur         =  bf_tt-allsum-line.sum-dsc-rubl-cur * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     2958         bf_tt-allsum-line.vat-base-buyer-cur   =  (bf_tt-allsum-line.sum-dsc-base-cur - bf_tt-allsum-line.slt-base-cur) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     2959         bf_tt-allsum-line.vat-rubl-buyer-cur   =  (bf_tt-allsum-line.sum-dsc-rubl-cur - bf_tt-allsum-line.slt-rubl-cur) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     2960         bf_tt-allsum-line.road-tax-base-cur    =  0
     2961         bf_tt-allsum-line.road-tax-rubl-cur    =  0
     2962         bf_tt-allsum-line.excise-base-cur      =  0
     2963         bf_tt-allsum-line.excise-rubl-cur      =  0
     2964         bf_tt-allsum-line.vat-base-cur         =  bf_tt-allsum-line.vat-base-buyer-cur
     2965         bf_tt-allsum-line.vat-rubl-cur         =  bf_tt-allsum-line.vat-rubl-buyer-cur
     2966         bf_tt-allsum-line.dsc-base-acc         =  0
     2967         bf_tt-allsum-line.dsc-rubl-acc         =  0
     2968         bf_tt-allsum-line.dsc-cli-acc          =  0
     2969         bf_tt-allsum-line.slt-base-acc         =  0
     2970         bf_tt-allsum-line.slt-rubl-acc         =  0
     2971         bf_tt-allsum-line.slt-cli-acc          =  0
     2972         bf_tt-allsum-line.road-tax-base-acc    =  0
     2973         bf_tt-allsum-line.road-tax-rubl-acc    =  0
     2974         bf_tt-allsum-line.road-tax-cli-acc     =  0
     2975         bf_tt-allsum-line.excise-base-acc      =  0
     2976         bf_tt-allsum-line.excise-rubl-acc      =  0
     2977         bf_tt-allsum-line.excise-cli-acc       =  0
     2978         bf_tt-allsum-line.transport-base-acc   =  0
     2979         bf_tt-allsum-line.transport-rubl-acc   =  0
     2980         bf_tt-allsum-line.transport-cli-acc    =  0
     2981         bf_tt-allsum-line.other-base-acc       =  0
     2982         bf_tt-allsum-line.other-rubl-acc       =  0
     2983         bf_tt-allsum-line.other-cli-acc        =  0
     2984         .
     2985       create bfs_tt-allsum-line.
     2986       assign
     2987       bfs_tt-allsum-line.sum-type = 'основная_сумма_со_знаком':U.
     2988       if bf_trn-doc.doc-type = 'инв':U or
     2989          bf_trn-doc.doc-type = 'при':U    or
     2990          bf_trn-doc.doc-type = 'возврат':U    then do:
     2991          buffer-copy bf_tt-allsum-line except bf_tt-allsum-line.sum-type to bfs_tt-allsum-line.
     2992       end.
     2993       else do:
     2994         assign
     2995           bfs_tt-allsum-line.fact-qnty           =  - bf_tt-allsum-line.fact-qnty
     2996           bfs_tt-allsum-line.cli-qnty            =  - bf_tt-allsum-line.cli-qnty
     2997           bfs_tt-allsum-line.sum-dsc-base-doc    =  - bf_tt-allsum-line.sum-dsc-base-doc
     2998           bfs_tt-allsum-line.sum-dsc-rubl-doc    =  - bf_tt-allsum-line.sum-dsc-rubl-doc
     2999           bfs_tt-allsum-line.dsc-base-doc        =  - bf_tt-allsum-line.dsc-base-doc
     3000           bfs_tt-allsum-line.dsc-rubl-doc        =  - bf_tt-allsum-line.dsc-rubl-doc
     3001           bfs_tt-allsum-line.vat-base-doc        =  - bf_tt-allsum-line.vat-base-doc
     3002           bfs_tt-allsum-line.vat-rubl-doc        =  - bf_tt-allsum-line.vat-rubl-doc
     3003           bfs_tt-allsum-line.vat-base-buyer-doc  =  - bf_tt-allsum-line.vat-base-buyer-doc
     3004           bfs_tt-allsum-line.vat-rubl-buyer-doc  =  - bf_tt-allsum-line.vat-rubl-buyer-doc
     3005           bfs_tt-allsum-line.slt-base-doc        =  - bf_tt-allsum-line.slt-base-doc
     3006           bfs_tt-allsum-line.slt-rubl-doc        =  - bf_tt-allsum-line.slt-rubl-doc
     3007           bfs_tt-allsum-line.road-tax-base-doc   =  - bf_tt-allsum-line.road-tax-base-doc
     3008           bfs_tt-allsum-line.road-tax-rubl-doc   =  - bf_tt-allsum-line.road-tax-rubl-doc
     3009           bfs_tt-allsum-line.excise-base-doc     =  - bf_tt-allsum-line.excise-base-doc
     3010           bfs_tt-allsum-line.excise-rubl-doc     =  - bf_tt-allsum-line.excise-rubl-doc
     3011           bfs_tt-allsum-line.sum-dsc-base-cur    =  - bf_tt-allsum-line.sum-dsc-base-cur
     3012           bfs_tt-allsum-line.sum-dsc-rubl-cur    =  - bf_tt-allsum-line.sum-dsc-rubl-cur
     3013           bfs_tt-allsum-line.dsc-base-cur        =  - bf_tt-allsum-line.dsc-base-cur
     3014           bfs_tt-allsum-line.dsc-rubl-cur        =  - bf_tt-allsum-line.dsc-rubl-cur
     3015           bfs_tt-allsum-line.vat-base-cur        =  - bf_tt-allsum-line.vat-base-cur
     3016           bfs_tt-allsum-line.vat-rubl-cur        =  - bf_tt-allsum-line.vat-rubl-cur
     3017           bfs_tt-allsum-line.vat-base-buyer-cur  =  - bf_tt-allsum-line.vat-base-buyer-cur
     3018           bfs_tt-allsum-line.vat-rubl-buyer-cur  =  - bf_tt-allsum-line.vat-rubl-buyer-cur
     3019           bfs_tt-allsum-line.slt-base-cur        =  - bf_tt-allsum-line.slt-base-cur
     3020           bfs_tt-allsum-line.slt-rubl-cur        =  - bf_tt-allsum-line.slt-rubl-cur
     3021           bfs_tt-allsum-line.road-tax-base-cur   =  - bf_tt-allsum-line.road-tax-base-cur
     3022           bfs_tt-allsum-line.road-tax-rubl-cur   =  - bf_tt-allsum-line.road-tax-rubl-cur
     3023           bfs_tt-allsum-line.excise-base-cur     =  - bf_tt-allsum-line.excise-base-cur
     3024           bfs_tt-allsum-line.excise-rubl-cur     =  - bf_tt-allsum-line.excise-rubl-cur
     3025           bfs_tt-allsum-line.sum-dsc-base-acc    =  - bf_tt-allsum-line.sum-dsc-base-acc
     3026           bfs_tt-allsum-line.sum-dsc-rubl-acc    =  - bf_tt-allsum-line.sum-dsc-rubl-acc
     3027           bfs_tt-allsum-line.sum-dsc-cli-acc     =  - bf_tt-allsum-line.sum-dsc-cli-acc
     3028           bfs_tt-allsum-line.dsc-base-acc        =  - bf_tt-allsum-line.dsc-base-acc
     3029           bfs_tt-allsum-line.dsc-rubl-acc        =  - bf_tt-allsum-line.dsc-rubl-acc
     3030           bfs_tt-allsum-line.dsc-cli-acc         =  - bf_tt-allsum-line.dsc-cli-acc
     3031           bfs_tt-allsum-line.vat-base-acc        =  - bf_tt-allsum-line.vat-base-acc
     3032           bfs_tt-allsum-line.vat-rubl-acc        =  - bf_tt-allsum-line.vat-rubl-acc
     3033           bfs_tt-allsum-line.vat-cli-acc         =  - bf_tt-allsum-line.vat-cli-acc
