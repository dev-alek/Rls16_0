     3417   end.
     3418   end procedure.
     3419   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3420   define variable v-waitfram-action01         as character   no-undo .
     3421   define variable v-waitfram-action02         as character   no-undo .
     3422   define variable v-waitfram-action03         as character   no-undo .
     3423   define variable mWaitFramTextBeg            as character   no-undo.
     3424   define variable mWaitFramTextEnd            as character   no-undo.
     3425   define variable mWaitFramView               as logical     no-undo.
     3426   define variable mWaitProcEvent              as logical     no-undo init yes.
     3427   define variable mWaitFramInterval           as integer     no-undo init 1 .
     3428   define variable mWaitFramStop               as logical     no-undo.
     3429   define variable mWaitFramStopUser           as logical     no-undo.
     3430   define variable mWaitFramStopTimeOut        as logical     no-undo.
     3431   define variable mWaitFramStartProc          as datetime-tz no-undo.
     3432   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     3433   define button B-WaitFramStop auto-end-key
     3434        label "Стоп"
     3435        size 10 by 1 tooltip "Остоновить процесс".
     3436   define button B-viewProcInfo
     3437        label "Информация"
     3438        size 15 by 1 tooltip "Информация о процесс".
     3439   define frame waitfram
     3440     v-waitfram-action01 format "x(72)" no-label skip
     3441     v-waitfram-action02 format "x(72)" no-label skip
     3442     v-waitfram-action03 format "x(72)" no-label skip
     3443     B-viewProcInfo
     3444     B-WaitFramStop at row 4 col 30
     3445     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     3446     .
     3447   define new global shared variable mBatchMode as logical no-undo init ?.
     3448   define variable mFramBachModHandle as handle no-undo.
     3449   mFramBachModHandle = frame waitfram:handle.
     3450   define variable mFameOldVis as logical no-undo.
     3451   define variable mVisCUrentVin as logical no-undo.
     3452   if session:batch-mode
     3453   then
     3454      mBatchMode = yes.
     3455   if mBatchMode = ? then do:
     3456     mVisCUrentVin = current-window:visible.
     3457     mFameOldVis = mFramBachModHandle:visible.
     3458     mFramBachModHandle:visible  = yes.
     3459     mBatchMode = mFramBachModHandle:visible ne yes.
     3460     mFramBachModHandle:visible = mFameOldVis.
     3461     current-window:visible = mVisCUrentVin.
     3462   end.
     3463    if  log-manager:logfile-name ne ?
     3464     then DO:
     3465         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     3466         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     3467         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     3468     end.
     3469   on choose of B-WaitFramStop in frame waitfram
     3470   do:
     3471     mWaitFramStop = yes.
     3472     mWaitFramStopUser = yes.
     3473   end.
     3474   function waitfram-check-timeout returns logical():
     3475      define variable vtime as int64 no-undo.
     3476      if mWaitFramStopTimeOut
     3477      then
     3478         return yes.
     3479      vtime = ( now - mWaitFramStartProc ) / 1000 .
     3480      if     mWaitFramTimeOut ne ?
     3481         and mWaitFramTimeOut ne 0
     3482         and mWaitFramTimeOut lt vtime
     3483      then do:
     3484         mWaitFramStopTimeOut = yes.
     3485      end.
     3486      return mWaitFramStopTimeOut.
     3487   end.
     3488   procedure waitfram-hide :
     3489     if not session:batch-mode
     3490     then do
     3491     on error undo, return error return-value
     3492     :
     3493       pause 0 before-hide .
     3494       if not mBatchMode then
     3495         hide frame waitfram .
     3496     if     not mWaitFramView
     3497        and mWaitProcEvent
     3498     then
     3499       process events .
     3500     end.
     3501   end procedure.
     3502   procedure waitfram-show :
     3503     define input  parameter p-message as character no-undo .
     3504     define variable v-left-margin as integer   no-undo .
     3505     if not session:batch-mode
     3506     then do
     3507     on error undo, return error return-value
     3508     :
     3509       if length(p-message) <= 70 then do:
     3510         assign
     3511           v-left-margin = integer((70 - length(p-message)) / 2)
     3512         .
     3513         assign
     3514           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     3515         .
     3516         assign
     3517           v-waitfram-action01 = " "
     3518           v-waitfram-action02 = " "
     3519                                    + fill(" ", v-left-margin)
     3520                                    + p-message
     3521           v-waitfram-action03 = " "
     3522         .
     3523       end.
     3524       else do:
     3525         define variable vRindex1 as integer no-undo.
     3526         define variable vRindex2 as integer no-undo.
     3527         vRindex1 = r-index(p-message," ",70).
     3528         if vRindex1 = 0
     3529         then
     3530            vRindex1 = 70.
     3531         if length(p-message)  <= vRindex1 + 70 then do:
     3532           assign
     3533             v-waitfram-action01 = " "
     3534             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     3535             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     3536           .
     3537         end.
     3538         else do:
     3539           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     3540           if vRindex2 <= vRindex1
     3541           then
     3542              vRindex2 = vRindex1 + 70.
     3543           assign
     3544             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     3545             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     3546             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     3547           .
     3548         end.
     3549       end.
     3550       B-viewProcInfo:visible   in frame waitfram = no.
     3551       B-viewProcInfo:sensitive in frame waitfram = no.
     3552       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     3553       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     3554       if  (   mWaitFramView
     3555          or  mWaitProcEvent)
     3556          and not mBatchMode
     3557       then
     3558          display
     3559             v-waitfram-action01 skip
     3560             v-waitfram-action02 skip
     3561             v-waitfram-action03 skip
     3562          with frame waitfram .
     3563       if     mWaitFramView
     3564          then do:
     3565             if     mWaitFramInterval ne ?
     3566                and not mBatchMode
     3567             then
     3568                wait-for go of frame waitfram pause mWaitFramInterval.
     3569          end.
     3570          else
     3571             if     mWaitProcEvent
     3572                and not mBatchMode
     3573             then
     3574                process events .
     3575     end.
     3576   end procedure.
     3577      procedure waitfram-show-this:
     3578         define input  parameter iInterval as int64 no-undo.
     3579         define variable vtime as int64 no-undo.
     3580         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     3581         mWaitFramInterval = iInterval.
     3582         run waitfram-show (substitute("&1&2 &3&4" ,
     3583                                       mWaitFramTextBeg ,
     3584                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     3585                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     3586                                       mWaitFramTextEnd
     3587                                      )
     3588                           ).
     3589      end.
     3590      procedure WaitFramRunPause:
     3591         define input  parameter iInterval as dec no-undo.
     3592         define variable vStart  as datetime-tz no-undo.
     3593         define variable vend    as datetime-tz no-undo.
     3594         define variable vint as int64 no-undo.
     3595         define variable vOk as logical no-undo.
     3596         vStart = now.
     3597         vend   = vStart.
     3598         publish "WaitFramPause" (iInterval,output vOk).
     3599         vend   =  now.
     3600         vint = vend - vStart.
     3601         vint = iInterval - vint / 1000.
     3602         if     not mWaitFramStop
     3603            and (   vint > 0
     3604                 or (    not vOk
     3605                     and iInterval eq ?
     3606                     )
     3607                 )
     3608         then
     3609            run waitfram-show-this (iInterval).
     3610         vend   =  now.
     3611         vint = vend - vStart.
     3612         vint = iInterval - vint / 1000.
     3613         if     not mWaitFramStop
     3614            and vint > 0
     3615         then do:
     3616            run gbl/pause.p (vint * 1000).
     3617         end.
     3618         if iInterval ne ?
     3619         then
     3620            publish "WaitFramStop".
     3621         waitfram-check-timeout().
     3622      end.
     3623      procedure WaitFramWaitFor:
     3624         define input  parameter iInterval as dec no-undo.
     3625         assign
     3626            mWaitFramStartProc   = now
     3627            mWaitFramStopUser    = no
     3628            mWaitFramStopTimeOut = no
     3629         .
     3630         block-wait:
     3631         do while not mWaitFramStop:
     3632            run WaitFramRunPause (iInterval).
     3633            if  waitfram-check-timeout()
     3634            then do:
     3635               leave block-wait.
     3636            end.
     3637         end.
     3638         run waitfram-hide.
     3639      end.
     3640   procedure waitfram-join :
     3641     define input  parameter p-line-1  as character no-undo .
     3642     define input  parameter p-line-2  as character no-undo .
     3643     define input  parameter p-line-3  as character no-undo .
     3644     define output parameter p-message as character no-undo .
     3645     do
     3646     on error undo, return error return-value
     3647     :
     3648       assign
     3649         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     3650                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     3651                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     3652       .
     3653     end.
     3654   end procedure.
     3655   function waitfram-join-function returns character
     3656     (input p-line-1 as character
     3657     ,input p-line-2 as character
     3658     ,input p-line-3 as character
     3659     ).
     3660     define variable v-message as character no-undo .
     3661     run waitfram-join in this-procedure
     3662       (input  p-line-1
     3663       ,input  p-line-2
     3664       ,input  p-line-3
     3665       ,output v-message
     3666       ) .
     3667     return v-message .
     3668   end function .
     3669   define variable parparentproc as widget-handle no-undo .
     3670   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3671     define variable v-cntxp-doc-prt         like ub.store.doc-prt         no-undo.
     3672     define variable v-cntxp-price-calc      like ub.store.price-calc      no-undo.
     3673     define variable v-cntxp-inout-price     like ub.store.inout-price     no-undo.
     3674     define variable v-cntxp-unit-cli-perm   like ub.store.unit-cli-perm   no-undo.
     3675     define variable v-cntxp-out-rate        like ub.store.out-rate        no-undo.
     3676     define variable v-cntxp-out-line-discnt like ub.store.out-line-discnt no-undo.
     3677     define variable v-cntxp-in-ov           like ub.store.in-ov           no-undo.
     3678     define variable v-cntxp-in-perm         like ub.store.in-perm         no-undo.
     3679     define variable v-cntxp-no-eq           like ub.store.no-eq           no-undo.
     3680     define variable v-cntxp-rsrv-time       like ub.store.rsrv-time       no-undo.
     3681     define variable v-cntxp-load-time       like ub.store.load-time       no-undo.
     3682     define variable v-cntxp-holidays        like ub.store.holidays        no-undo.
     3683     define variable v-cntxp-in-pay          like ub.store.in-pay          no-undo.
     3684     define variable v-cntxp-out-pay         like ub.store.out-pay         no-undo.
     3685     define variable v-cntxp-ret-pay         like ub.store.ret-pay         no-undo.
     3686     define variable v-cntxp-ret-sup-pay     like ub.store.ret-sup-pay     no-undo.
     3687     define variable v-cntxp-down-pay        like ub.store.down-pay        no-undo.
     3688     define variable v-cntxp-inv-pay         like ub.store.inv-pay         no-undo.
     3689     define variable v-cntxp-chk-pay         like ub.store.chk-pay         no-undo.
     3690     define variable v-cntxp-retail          like ub.sysconf.ord-prt       no-undo.
     3691     define variable v-cntxp-osn-base        like ub.sysconf.osn-base      no-undo.
     3692     define variable v-cntxp-conf-par        as   character                no-undo.
     3693     define variable v-cntxp-par-type        as   character                no-undo.
     3694     define variable v-cntxp-curr-host-code  like ub.store.host-code       no-undo.
     3695     define variable v-cntxp-obj-type        like ub.clients.obj-type      no-undo.
     3696     define variable v-cntxp-obj-code        like ub.clients.obj-code      no-undo.
     3697     define variable v-cntxp-db-num          as integer   no-undo .
     3698     define variable v-cntxp-userid          as character no-undo .
     3699     define variable v-cntxp-level           as character no-undo .
     3700     define variable v-cntxp-db-num-obj      as integer   no-undo .
     3701     define variable v-cntxp-is-admin        as logical   no-undo .
     3702     define buffer bf-cntxp_store for ub.store.
     3703     define buffer bf-cntxp_shop  for ub.shop.
     3704     define buffer bf-cntxp_sysconf for ub.sysconf.
     3705   DEFINE SHARED VAR      objects     as integer   no-undo.
     3706   DEFINE SHARED VAR      FRAME-TITLE as char      no-undo.
     3707   DEFINE        VARIABLE RS-Method   AS CHARACTER
     3708     VIEW-AS RADIO-SET VERTICAL
     3709     RADIO-BUTTONS
     3710     "с разбивкой по датам", "1",
     3711     "только итоги", "2"
     3712     SIZE 22.63 BY 3.13 NO-UNDO.
     3713   DEFINE RECTANGLE RECT-6
     3714     EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     3715     SIZE 45 BY 4.83.
     3716   DEFINE FRAME F-Main
     3717     RS-Method AT ROW 2.58 COL 7 NO-LABEL
     3718     RECT-6 AT ROW 1.25 COL 2.25
     3719     WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
     3720     SIDE-LABELS NO-UNDERLINE THREE-D
     3721     AT COL 1 ROW 1
     3722     SIZE 47.63 BY 6.63.
     3723   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
     3724   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
     3725   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
     3726   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
     3727   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
     3728   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
     3729   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
     3730   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
     3731       ASSIGN adm-object-hdl = FRAME F-Main:HANDLE.
     3732   RUN ensure-broker.
     3733   THIS-PROCEDURE:ADM-DATA =
     3734        'ADM1.1~`':U +
     3735        'SmartObject~`':U +
     3736        'FRAME~`':U +
     3737        'NO ~`':U +
     3738        '~`':U +
     3739        '~`':U +
     3740        '~`':U +
     3741        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
     3742           + "~`":U +
     3743        'Layout,Hide-on-Init~`':U +
     3744        '~`':U +
     3745        '~`':U +
     3746        '~`~`~`~`~`~`~`~`~`~`~`':U +
     3747        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
     3748            THEN "^^":U
     3749        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
     3750             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
     3751   PROCEDURE adm-apply-entry :
     3752     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     3753   END PROCEDURE.
     3754   PROCEDURE adm-destroy :
     3755    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     3756   END PROCEDURE.
     3757   PROCEDURE adm-disable :
     3758       DISABLE RECT-6 RS-Method WITH FRAME F-Main.
     3759       RUN dispatch ('disable-fields':U).
     3760       RUN set-attribute-list ('ENABLED=no':U).
     3761       RETURN.
     3762   END PROCEDURE.
     3763   PROCEDURE adm-edit-attribute-list :
     3764         RUN adm/support/contnrd.w (INPUT THIS-PROCEDURE).
     3765         RETURN.
     3766   END PROCEDURE.
     3767   PROCEDURE adm-enable :
     3768       ENABLE UNLESS-HIDDEN RECT-6 RS-Method WITH FRAME F-Main.
     3769       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
     3770       RUN set-attribute-list ('ENABLED=yes':U).
     3771       RETURN.
     3772   END PROCEDURE.
     3773   PROCEDURE adm-exit :
     3774        RUN notify ('exit':U).
     3775     RETURN.
     3776   END PROCEDURE.
     3777   PROCEDURE adm-hide :
     3778     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     3779   END PROCEDURE.
     3780   PROCEDURE adm-initialize :
     3781     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     3782   END PROCEDURE.
     3783   PROCEDURE adm-show-errors :
     3784       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
     3785       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
     3786           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
     3787       END.
     3788       RETURN.
     3789   END PROCEDURE.
     3790   PROCEDURE adm-UIB-mode :
     3791     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     3792   END PROCEDURE.
     3793   PROCEDURE adm-view :
     3794     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     3795   END PROCEDURE.
     3796   PROCEDURE dispatch :
     3797       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
     3798       RUN broker-dispatch IN adm-broker-hdl
     3799           (THIS-PROCEDURE, p-method-name) NO-ERROR.
     3800       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
     3801   END PROCEDURE.
     3802   PROCEDURE ensure-broker :
     3803   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
     3804   IF RETURN-VALUE NE "ADM-Broker":U THEN
     3805   DO:
     3806       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
     3807       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
     3808   END.
     3809   END PROCEDURE.
     3810   PROCEDURE get-attribute :
     3811     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
     3812     RUN broker-get-attribute IN adm-broker-hdl
     3813         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
     3814     RETURN RETURN-VALUE.
     3815   END PROCEDURE.
     3816   PROCEDURE get-attribute-list :
     3817     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
     3818     RUN broker-get-attribute-list IN adm-broker-hdl
     3819         (INPUT THIS-PROCEDURE,
     3820          INPUT ?,
     3821          OUTPUT p-attr-list) NO-ERROR.
     3822     RETURN.
     3823   END PROCEDURE.
     3824   PROCEDURE new-state :
     3825     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     3826     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
     3827     RETURN.
     3828   END PROCEDURE.
     3829   PROCEDURE notify :
     3830     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
     3831     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
     3832     IF RETURN-VALUE = "ADM-ERROR":U THEN
     3833         RETURN "ADM-ERROR":U.
     3834     RETURN.
     3835   END PROCEDURE.
     3836   PROCEDURE set-attribute-list :
     3837     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
     3838     RUN ensure-broker.
     3839     RUN broker-set-attribute-list IN adm-broker-hdl
     3840         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
     3841     RETURN.
     3842   END PROCEDURE.
     3843   PROCEDURE set-position :
     3844       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
     3845       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
     3846       IF VALID-HANDLE(adm-object-hdl) THEN
     3847       DO:
     3848           DEFINE VARIABLE parent-hdl AS HANDLE NO-UNDO.
     3849           IF adm-object-hdl:TYPE = "WINDOW":U THEN
     3850           DO:
     3851             IF p-row = 0 THEN p-row =
     3852               (SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2.
     3853             IF p-col = 0 THEN p-col =
     3854               (SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2.
     3855           END.
     3856           ELSE IF adm-object-hdl:TYPE = "DIALOG-BOX":U THEN
     3857           DO:
     3858             parent-hdl = adm-object-hdl:PARENT.
     3859             IF p-row = 0 THEN p-row =
     3860               ((SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2) -
     3861                 parent-hdl:ROW.
     3862             IF p-col = 0 THEN p-col =
     3863               ((SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2) -
     3864                 parent-hdl:COL.
     3865           END.
     3866           IF p-row GE 0 AND p-row < 1 THEN p-row = 1.
     3867           IF p-col GE 0 AND p-col < 1 THEN p-col = 1.
     3868         ASSIGN adm-object-hdl:ROW    =   p-row
     3869                adm-object-hdl:COLUMN =   p-col.
     3870       END.
     3871       RETURN.
     3872   END PROCEDURE.
     3873   RUN set-attribute-list ("CURRENT-PAGE=0,ADM-OBJECT-HANDLE=":U +
     3874       STRING(adm-object-hdl)).
     3875   PAUSE 0 BEFORE-HIDE.
     3876   PROCEDURE adm-change-page :
     3877     RUN broker-change-page IN adm-broker-hdl (INPUT THIS-PROCEDURE) NO-ERROR.
     3878     END PROCEDURE.
     3879   PROCEDURE delete-page :
     3880     DEFINE INPUT PARAMETER p-page# AS INTEGER NO-UNDO.
     3881     RUN broker-delete-page IN adm-broker-hdl
     3882         (INPUT THIS-PROCEDURE, INPUT p-page#).
     3883     END PROCEDURE.
     3884   PROCEDURE init-object :
     3885     DEFINE INPUT PARAMETER  p-proc-name   AS CHARACTER NO-UNDO.
     3886     DEFINE INPUT PARAMETER  p-parent-hdl  AS HANDLE    NO-UNDO.
     3887     DEFINE INPUT PARAMETER  p-attr-list   AS CHARACTER NO-UNDO.
     3888     DEFINE OUTPUT PARAMETER p-proc-hdl    AS HANDLE    NO-UNDO.
     3889     RUN broker-init-object IN adm-broker-hdl
     3890         (INPUT THIS-PROCEDURE, INPUT p-proc-name, INPUT p-parent-hdl,
     3891          INPUT p-attr-list, OUTPUT p-proc-hdl) NO-ERROR.
     3892     RETURN.
     3893   END PROCEDURE.
     3894   PROCEDURE init-pages :
     3895     DEFINE INPUT PARAMETER p-page-list      AS CHARACTER NO-UNDO.
     3896     RUN broker-init-pages IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     3897         INPUT p-page-list) NO-ERROR.
     3898     END PROCEDURE.
     3899   PROCEDURE select-page :
     3900     DEFINE INPUT PARAMETER p-page#     AS INTEGER   NO-UNDO.
     3901     RUN broker-select-page IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     3902         INPUT p-page#) NO-ERROR.
     3903     END PROCEDURE.
     3904   PROCEDURE view-page :
     3905     DEFINE INPUT PARAMETER p-page#      AS INTEGER   NO-UNDO.
     3906     RUN broker-view-page IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     3907         INPUT p-page#).
     3908     END PROCEDURE.
     3909   if not this-procedure :persistent
     3910   then do:
     3911     message
     3912       vss-workfile vss-revision vss-description skip
     3913       "Ошибка при запуске процедуры" skip
     3914       "Данную процедуру следует запускать только с параметром persistent" skip
     3915       view-as alert-box error .
     3916     undo, return error .
     3917   end.
     3918   parparentproc = my-handle.
     3919   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3920     run mainmenu_getcntxt in parparentproc
     3921       (output v-cntxp-db-num
     3922       ,output v-cntxp-userid
     3923       ,output v-cntxp-level
     3924       ,output v-cntxp-curr-host-code
     3925       ,output v-cntxp-obj-type
     3926       ,output v-cntxp-obj-code
     3927       ,output v-cntxp-db-num-obj
     3928       ,output v-cntxp-is-admin
     3929       ) .
     3930     if (v-cntxp-obj-type = 'маг':U or v-cntxp-obj-type = 'скл':U) and
     3931        v-cntxp-obj-code <> 0 then do:
     3932   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     3933     (input  'is-prt'
     3934     ,input  0
     3935     ,input  ''
     3936     ,input  0
     3937     ,input  ''
     3938     ,input  ''
     3939     ,input  ''
     3940     ,input  yes
     3941     ,output v-cntxp-conf-par
     3942     ,output v-cntxp-par-type
     3943     ) no-error .
     3944       case v-cntxp-obj-type :
     3945         when 'скл':U then do:
     3946           find first bf-cntxp_store where bf-cntxp_store.obj-code = v-cntxp-obj-code no-lock.
     3947           find first bf-cntxp_sysconf where bf-cntxp_sysconf.host-code = bf-cntxp_store.host-code no-lock.
     3948           assign
     3949             v-cntxp-doc-prt         = (v-cntxp-conf-par = "yes") and bf-cntxp_store.doc-prt
     3950             v-cntxp-price-calc      = bf-cntxp_store.price-calc
     3951             v-cntxp-inout-price     = bf-cntxp_store.inout-price
     3952             v-cntxp-unit-cli-perm   = bf-cntxp_store.unit-cli-perm
     3953             v-cntxp-out-rate        = bf-cntxp_store.out-rate
     3954             v-cntxp-out-line-discnt = bf-cntxp_store.out-line-discnt
     3955             v-cntxp-in-ov           = bf-cntxp_store.in-ov
     3956             v-cntxp-in-perm         = bf-cntxp_store.in-perm
     3957             v-cntxp-no-eq           = bf-cntxp_store.no-eq
     3958             v-cntxp-rsrv-time       = bf-cntxp_store.rsrv-time
     3959             v-cntxp-load-time       = bf-cntxp_store.load-time
     3960             v-cntxp-holidays        = bf-cntxp_store.holidays
     3961             v-cntxp-in-pay          = bf-cntxp_store.in-pay
     3962             v-cntxp-out-pay         = bf-cntxp_store.out-pay
     3963             v-cntxp-ret-pay         = bf-cntxp_store.ret-pay
     3964             v-cntxp-ret-sup-pay     = bf-cntxp_store.ret-sup-pay
     3965             v-cntxp-down-pay        = bf-cntxp_store.down-pay
     3966             v-cntxp-inv-pay         = bf-cntxp_store.inv-pay
     3967             v-cntxp-chk-pay         = bf-cntxp_store.chk-pay
     3968             v-cntxp-retail          = bf-cntxp_sysconf.ord-prt
     3969             v-cntxp-osn-base        = bf-cntxp_sysconf.osn-base
     3970             .
     3971         end.
     3972         when 'маг':U then do:
     3973           find first bf-cntxp_shop where bf-cntxp_shop.obj-code = v-cntxp-obj-code no-lock.
     3974           find first bf-cntxp_sysconf where bf-cntxp_sysconf.host-code = bf-cntxp_shop.host-code no-lock.
     3975           assign
     3976             v-cntxp-doc-prt         = (v-cntxp-conf-par = "yes") and bf-cntxp_shop.doc-prt
     3977             v-cntxp-price-calc      = bf-cntxp_shop.price-calc
     3978             v-cntxp-inout-price     = bf-cntxp_shop.inout-price
     3979             v-cntxp-unit-cli-perm   = bf-cntxp_shop.unit-cli-perm
     3980             v-cntxp-out-rate        = bf-cntxp_shop.out-rate
     3981             v-cntxp-out-line-discnt = bf-cntxp_shop.out-line-discnt
     3982             v-cntxp-in-ov           = bf-cntxp_shop.in-ov
     3983             v-cntxp-in-perm         = bf-cntxp_shop.in-perm
     3984             v-cntxp-no-eq           = bf-cntxp_shop.no-eq
     3985             v-cntxp-rsrv-time       = bf-cntxp_shop.rsrv-time
     3986             v-cntxp-load-time       = bf-cntxp_shop.load-time
     3987             v-cntxp-holidays        = bf-cntxp_shop.holidays
     3988             v-cntxp-in-pay          = bf-cntxp_shop.in-pay
     3989             v-cntxp-out-pay         = bf-cntxp_shop.out-pay
     3990             v-cntxp-ret-pay         = bf-cntxp_shop.ret-pay
     3991             v-cntxp-ret-sup-pay     = bf-cntxp_shop.ret-sup-pay
     3992             v-cntxp-down-pay        = bf-cntxp_shop.down-pay
     3993             v-cntxp-inv-pay         = bf-cntxp_shop.inv-pay
     3994             v-cntxp-chk-pay         = bf-cntxp_shop.chk-pay
     3995             v-cntxp-retail          = bf-cntxp_sysconf.ord-prt
     3996             v-cntxp-osn-base        = bf-cntxp_sysconf.osn-base
     3997             .
     3998         end.
     3999       end case.
     4000     end.
     4001   PROCEDURE disable_UI :
     4002     HIDE FRAME F-Main.
     4003   END PROCEDURE.
     4004   PROCEDURE enable_UI :
     4005     DISPLAY RS-Method
     4006       WITH FRAME F-Main.
     4007     ENABLE RECT-6 RS-Method
     4008       WITH FRAME F-Main.
     4009   END PROCEDURE.
     4010   PROCEDURE My-report :
     4011     run My-var.
     4012     run waitfram-show in this-procedure ( 'Подождите ...' ) .
     4013     RUN PrintProc.
     4014     run waitfram-hide in this-procedure .
     4015   END PROCEDURE.
     4016   PROCEDURE My-var :
     4017     Assign
     4018       frame F-Main RS-Method
     4019       .
     4020   END PROCEDURE.
     4021   PROCEDURE PrintProc :
     4022     if RS-Method = "1" then
     4023     do:
     4024       run rep/r-toppay.p  no-error .
     4025     end.
     4026     else
     4027     do:
     4028       run rep/e-toppay1.p no-error .
     4029     end.
     4030   END PROCEDURE.
