     3273   procedure clcprtsl_calc-ttable :
     3274   define input parameter paris-doc           as   logical                 no-undo.
     3275   define input parameter paris-cur           as   logical                 no-undo.
     3276   define input parameter parroad-tax         like ub.doc-line.road-tax    no-undo.
     3277   define input parameter parexcise           like ub.doc-line.excise      no-undo.
     3278   define input parameter parvat-pc           like ub.doc-line.vat-pc      no-undo.
     3279   define input parameter parcons-vat-pc      like ub.doc-line.cons-vat-pc no-undo.
     3280   define input parameter parslt-pc           like ub.doc-line.slt-pc      no-undo.
     3281   define input parameter parbase-rate        like ub.trn-doc.base-rate    no-undo.
     3282   define input parameter parbase-scale       like ub.trn-doc.base-scale   no-undo.
     3283   define input parameter parr-b              as   character               no-undo.
     3284   define input parameter parcur-base         like ub.gds-dtl.cur-base     no-undo.
     3285   define input parameter parcur-road-tax     like ub.doc-line.road-tax    no-undo.
     3286   define input parameter parcur-excise       like ub.doc-line.excise      no-undo.
     3287   define input parameter parcur-vat-pc       like ub.doc-line.vat-pc      no-undo.
     3288   define input parameter parcurcons-vat-pc   like ub.doc-line.cons-vat-pc no-undo.
     3289   define input parameter parcurslt-pc        like ub.doc-line.slt-pc      no-undo.
     3290   define buffer bf_tt-allsum      for tt-allsum.
     3291   define buffer bf_tt-clcparts    for tt-clcparts.
     3292   define buffer bf_tt-allsum-line for tt-allsum-line.
     3293   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     3294   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     3295   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     3296   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     3297   define variable varexcise          like ub.price-list.excise     no-undo.
     3298   do on error undo, return error return-value :
     3299   for each bf_tt-allsum-line
     3300   on error undo, return error return-value
     3301    :
     3302     delete bf_tt-allsum-line.
     3303   end.
     3304   for each bf_tt-allsum
     3305   on error undo, return error return-value
     3306   :
     3307     delete bf_tt-allsum.
     3308   end.
     3309   for each bf_tt-clcparts
     3310   on error undo, return error return-value
     3311   :
     3312   if v-calcbypart then do:
     3313             assign
     3314             parcur-base =   bf_tt-clcparts.part-cur-base
     3315             parcur-road-tax = bf_tt-clcparts.part-cur-road-tax
     3316             parcur-excise =   bf_tt-clcparts.part-cur-excise
     3317             .
     3318   end.
     3319      run clcprtsl_calc-parts in this-procedure (
     3320        input recid(bf_tt-clcparts),
     3321        input paris-doc,
     3322        input paris-cur,
     3323        input parroad-tax,
     3324        input parexcise,
     3325        input parvat-pc,
     3326        input parcons-vat-pc,
     3327        input parslt-pc,
     3328        input parbase-rate,
     3329        input parbase-scale,
     3330        input parr-b,
     3331        input parcur-base,
     3332        input parcur-road-tax,
     3333        input parcur-excise,
     3334        input parcur-vat-pc,
     3335        input parcurcons-vat-pc,
     3336        input parcurslt-pc
     3337        ) no-error.
     3338     if error-status:error then do:
     3339       message
     3340         vss-workfile vss-revision vss-description skip
     3341         vss-include-info19 skip
     3342         "Ошибка при обсчете партии" skip
     3343         "Документ партии " bf_tt-clcparts.out-code skip
     3344         "Товар" bf_tt-clcparts.artic bf_tt-clcparts.prod-type bf_tt-clcparts.prod-code skip
     3345         return-value skip
     3346         error-status:get-message(1) skip
     3347         error-status:get-message(2) skip
     3348         error-status:get-message(3) skip
     3349         view-as alert-box error .
     3350       undo, return error .
     3351     end.
     3352     for each bf_tt-allsum on error undo, return error return-value :
     3353       find first bf_tt-allsum-line where bf_tt-allsum-line.sum-type = bf_tt-allsum.sum-type no-error.
     3354       if not available bf_tt-allsum-line then do:
     3355         create bf_tt-allsum-line.
     3356         assign
     3357           bf_tt-allsum-line.sum-type = bf_tt-allsum.sum-type.
     3358       end.
     3359       assign
     3360         bf_tt-allsum-line.fact-qnty              = bf_tt-allsum-line.fact-qnty            + bf_tt-allsum.fact-qnty
     3361         bf_tt-allsum-line.cli-qnty               = bf_tt-allsum-line.cli-qnty             + bf_tt-allsum.cli-qnty
     3362         bf_tt-allsum-line.sum-dsc-base-doc       = bf_tt-allsum-line.sum-dsc-base-doc     + bf_tt-allsum.sum-dsc-base-doc
     3363         bf_tt-allsum-line.sum-dsc-rubl-doc       = bf_tt-allsum-line.sum-dsc-rubl-doc     + bf_tt-allsum.sum-dsc-rubl-doc
     3364         bf_tt-allsum-line.dsc-base-doc           = bf_tt-allsum-line.dsc-base-doc         + bf_tt-allsum.dsc-base-doc
     3365         bf_tt-allsum-line.dsc-rubl-doc           = bf_tt-allsum-line.dsc-rubl-doc         + bf_tt-allsum.dsc-rubl-doc
     3366         bf_tt-allsum-line.vat-base-doc           = bf_tt-allsum-line.vat-base-doc         + bf_tt-allsum.vat-base-doc
     3367         bf_tt-allsum-line.vat-rubl-doc           = bf_tt-allsum-line.vat-rubl-doc         + bf_tt-allsum.vat-rubl-doc
     3368         bf_tt-allsum-line.vat-base-buyer-doc     = bf_tt-allsum-line.vat-base-buyer-doc   + bf_tt-allsum.vat-base-buyer-doc
     3369         bf_tt-allsum-line.vat-rubl-buyer-doc     = bf_tt-allsum-line.vat-rubl-buyer-doc   + bf_tt-allsum.vat-rubl-buyer-doc
     3370         bf_tt-allsum-line.slt-base-doc           = bf_tt-allsum-line.slt-base-doc         + bf_tt-allsum.slt-base-doc
     3371         bf_tt-allsum-line.slt-rubl-doc           = bf_tt-allsum-line.slt-rubl-doc         + bf_tt-allsum.slt-rubl-doc
     3372         bf_tt-allsum-line.road-tax-base-doc      = bf_tt-allsum-line.road-tax-base-doc    + bf_tt-allsum.road-tax-base-doc
     3373         bf_tt-allsum-line.road-tax-rubl-doc      = bf_tt-allsum-line.road-tax-rubl-doc    + bf_tt-allsum.road-tax-rubl-doc
     3374         bf_tt-allsum-line.excise-base-doc        = bf_tt-allsum-line.excise-base-doc      + bf_tt-allsum.excise-base-doc
     3375         bf_tt-allsum-line.excise-rubl-doc        = bf_tt-allsum-line.excise-rubl-doc      + bf_tt-allsum.excise-rubl-doc
     3376         bf_tt-allsum-line.sum-dsc-base-cur       = bf_tt-allsum-line.sum-dsc-base-cur     + bf_tt-allsum.sum-dsc-base-cur
     3377         bf_tt-allsum-line.sum-dsc-rubl-cur       = bf_tt-allsum-line.sum-dsc-rubl-cur     + bf_tt-allsum.sum-dsc-rubl-cur
     3378         bf_tt-allsum-line.dsc-base-cur           = bf_tt-allsum-line.dsc-base-cur         + bf_tt-allsum.dsc-base-cur
     3379         bf_tt-allsum-line.dsc-rubl-cur           = bf_tt-allsum-line.dsc-rubl-cur         + bf_tt-allsum.dsc-rubl-cur
     3380         bf_tt-allsum-line.vat-base-cur           = bf_tt-allsum-line.vat-base-cur         + bf_tt-allsum.vat-base-cur
     3381         bf_tt-allsum-line.vat-rubl-cur           = bf_tt-allsum-line.vat-rubl-cur         + bf_tt-allsum.vat-rubl-cur
