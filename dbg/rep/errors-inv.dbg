        6       field prod-type   as character
        7       field date-report as date
        8       field time-report as INTEGER
        9       field qnty-tsd    as decimal
       10       index pi artic prod-code prod-type.
       11   define input parameter parparentproc    as handle no-undo .
       12   define input parameter table for tt-gds-line-err .
