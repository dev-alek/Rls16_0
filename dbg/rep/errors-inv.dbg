      528   define variable v-report-name       as character no-undo.
      529   define variable v-period            as character no-undo.
      530   define stream OutStr-html.
      531   run get-full-path-RepViewer(output v-full-path-RepView).
      532   run get-report-num in parParentProc(output g#report-num).
      533   run define-full-path-Report(input g#report-num, output v-file-name-rep-htm).
      534   run create-file(v-file-name-rep-htm).
      535   run waitfram-show in this-procedure ("Подождите ...").
      536   output stream OutStr-html to value(v-file-name-rep-htm) convert target 'UTF-8' .
      537   put stream OutStr-html unformatted
      538       "<!DOCTYPE HTML>" skip
      539       ' <html>' skip
      540       '  <head>' skip
      541       '   <meta charset="utf-8">' skip
      542       '    <style type="text/css">' skip
      543       '      table ' + chr(123) + ' border-collapse: collapse; ' + chr(125) skip
      544       '      .class1 ' + chr(123) + ' border-collapse: collapse; ' + chr(125) skip
      545       '      tbody td, th ' + chr(123) + ' border-collapse: collapse; border: 1px solid black; height: 14px;' + chr(125) skip
      546       '   </style>' skip
      547       '  </head>' skip
      548       .
      549   put stream OutStr-html unformatted
      550       '<body>' skip
      551       '<TABLE name="zakaz"  fit_to_page="true" orientation="landscape" CELLSPACING="0" BORDER="0">'skip
      552       '<thead>' skip
      553       .
      554   put stream OutStr-html unformatted
      555       '<tr class="set_columns">' skip
      556       '<td style="width: 500px;"></td>' skip
      557       '</tr>' skip
      558       .
      559   for each tt-gds-line-err:
      560       put stream OutStr-html unformatted
      561           '<tr>' skip
      562           '<td style="text-align: left;">' + string (tt-gds-line-err.date-report,"99/99/9999") + " " + string (tt-gds-line-err.time-report,"HH:MM:SS") + ' Ошибка при загрузке в инвентаризацию товара: ' + string (tt-gds-line-err.gds-name) + ' Артикул: ' + string (tt-gds-line-err.artic) + ' кол-во: ' + string (tt-gds-line-err.qnty-tsd) + '</td>' skip
      563           '</tr>' skip
      564           .
      565   end.
      566   put stream OutStr-html unformatted
      567       '</thead>' skip
      568       '</table>' skip
      569       '</body>' skip
      570       '</html>' skip
      571       .
      572   run prn-lib-reportviewer-report-name in this-procedure (
      573       input THIS-PROCEDURE
      574       ,input v-file-name-rep-htm
      575       ).
      576   procedure get-full-path-RepViewer:
      577       define output parameter p-fill-path-RepView as character no-undo.
      578       if search("exe\ReportViewer\reportviewer.exe") <> ? then
      579       do:
      580           p-fill-path-RepView = search("exe\ReportViewer\reportviewer.exe").
      581       end.
      582       else
      583       do:
      584           message "Не найдена программа просмотра отчёта!" view-as alert-box error.
      585       end.
      586   end procedure.
      587   procedure define-full-path-Report:
      588       define input parameter p-rep-num as integer no-undo.
      589       define output parameter p-file-name-rep-htm as character no-undo.
      590       p-file-name-rep-htm = session:temp-directory + "rpt" + string(p-rep-num) + ".html".
      591   end procedure.
      592   procedure search-full-path-Report:
      593       define input parameter p-file-name as character no-undo.
      594       if search(p-file-name) = ? then
      595       do:
      596           message "Не найден файл отчёта: " p-file-name view-as alert-box error.
      597       end.
      598       else
      599       do:
      600           p-file-name = search(p-file-name).
      601       end.
      602   end procedure.
      603   procedure Report-Viewer:
      604       define input parameter p-full-path-RepView as character no-undo.
      605       define input parameter p-file-name-rep-htm as character no-undo.
      606       os-command no-wait value(p-full-path-RepView + " " + search(p-file-name-rep-htm)).
      607   end procedure.
      608   procedure create-file:
      609       define input parameter p-file-name as character no-undo.
      610       output to value(string(p-file-name)).
      611       output close.
      612   end procedure.
