      345   define  stream PrnLibStream.
      346   procedure prn-lib-prn-file :
      347     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      348     define input parameter p-DIsabledoptions as integer no-undo .
      349     define variable v-report-name as character no-undo .
      350     define variable v-user-action as character no-undo .
      351     define variable v-printed     as logical   no-undo .
