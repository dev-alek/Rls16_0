       91   procedure cur-time :
       92      define output parameter p-today as date      no-undo .
       93      define output parameter p-time  as integer   no-undo .
       94     do
       95     on error undo, return error
       96     :
       97       define variable v-date1 as date      no-undo .
       98       define variable v-date2 as date      no-undo .
       99       define variable v-time  as integer   no-undo .
      100       assign
      101         v-date1 = today
      102         v-time  = time
      103         v-date2 = today
      104       .
      105       if v-date1 <> v-date2
      106       then do:
      107         assign
      108           v-date1 = today
      109           v-time  = v-time
      110         .
      111       end.
      112       assign
      113         p-today = v-date1
      114         p-time  = v-time
      115       .
      116     end.
      117   end.
      118   function cur-time-date returns character
      119   :
      120     return string(today, '99/99/9999':U) .
      121   end.
      122   function cur-time-mjd returns decimal
      123   :
      124     define variable v-date as date      no-undo .
      125     define variable v-time as integer   no-undo .
      126     run cur-time in this-procedure
      127       (output v-date
      128       ,output v-time
      129       ) .
      130     return integer(v-date) - 2400002 + (v-time / 86400) .
      131   end.
      132   function cur-time-get-ending-index returns integer
      133   (input p-number as integer
      134   )
      135   :
      136     if p-number < 0
      137     or p-number = ?
      138     then do:
      139       return 1 .
      140     end.
      141     define variable v-rest as integer   no-undo .
      142     assign
      143       p-number = p-number modulo 100
      144     .
      145     if p-number < 20
      146     then do:
      147       assign
      148         v-rest = p-number
      149       .
      150     end.
      151     else do:
      152       assign
      153         v-rest = p-number modulo 10
      154       .
      155     end.
      156     case v-rest :
      157       when 1
      158       then do:
      159         return 2 .
      160       end.
      161       when 2 or
      162       when 3 or
      163       when 4
      164       then do:
      165         return 3 .
      166       end.
      167       otherwise do:
      168         return 1 .
      169       end.
      170     end case .
      171   end.
      172   procedure cur-time-mjd-to-date :
      173      define input  parameter i-mjd-diff as decimal no-undo.
      174      define output parameter o-Date     as date    no-undo.
      175      define output parameter o-Time     as integer no-undo.
      176      define variable v-day-number as integer   no-undo .
      177      if    i-mjd-diff < 0
      178         or i-mjd-diff = ?
      179      then do:
      180         return "?" .
      181      end.
      182      assign
      183         v-day-number = truncate(i-mjd-diff,0).
      184         o-Date = date(v-day-number + 2400002).
      185         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      186     .
      187   end.
      188   function cur-time-mjd-to-string returns character
      189   (input p-mjd-diff as decimal
      190   )
      191   :
      192     define variable v-day-number as integer   no-undo .
      193     define variable v-seconds    as integer   no-undo .
      194     define variable v-hour       as integer   no-undo .
      195     define variable v-min        as integer   no-undo .
      196     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      197     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      198     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      199     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      200     if p-mjd-diff < 0
      201     or p-mjd-diff = ?
      202     then do:
      203       return "?" .
      204     end.
      205     assign
      206       v-day-number = integer(truncate(p-mjd-diff,0))
      207       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      208     .
      209     if v-seconds > 86400
      210     then do:
      211       assign
      212         v-seconds = 86400 - 1
      213       .
      214     end.
      215     if v-seconds < 0
      216     then do:
      217       assign
      218         v-seconds = 0
      219       .
      220     end.
      221     assign
      222       v-hour = truncate(v-seconds / 3600, 0)
      223     .
      224     assign
      225       v-seconds = v-seconds modulo 3600
      226     .
      227     assign
      228       v-min = truncate(v-seconds / 60, 0)
      229     .
      230     assign
      231       v-seconds = v-seconds modulo 60
      232     .
      233     return
      234         (if v-day-number <> 0
      235           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      236           else ""
      237         )
      238       + (if v-day-number <> 0 or v-hour <> 0
      239           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      240           else ""
      241         )
      242       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      243           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      244           else ""
      245         )
      246       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      247       .
      248   end.
      249   function cur-time-string returns character
      250   :
      251     define variable v-date as date      no-undo .
      252     define variable v-time as integer   no-undo .
      253     run cur-time in this-procedure
      254       (output v-date
      255       ,output v-time
      256       ) .
      257     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      258   end.
      259   function cur-time-string-sec returns character
      260   :
      261     define variable v-date as date      no-undo .
      262     define variable v-time as integer   no-undo .
      263     run cur-time in this-procedure
      264       (output v-date
      265       ,output v-time
      266       ) .
      267     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      268   end.
      269   function cur-time-custom  returns character
      270   (input p-prefix as character
      271   ,input p-date-format as character
      272   ,input p-delimiter as character
      273   ,input p-time-format as character
      274   ,input p-suffix as character
      275   )
      276   :
      277     define variable v-date as date      no-undo .
      278     define variable v-time as integer   no-undo .
      279     run cur-time in this-procedure
      280       (output v-date
      281       ,output v-time
      282       ) .
      283     return
      284       p-prefix
      285       + string(v-date, p-date-format)
      286       + p-delimiter
      287       + string(v-time, p-time-format)
      288       + p-suffix
      289       .
      290   end.
      291   function cur-time-print  returns character
      292   :
      293     define variable v-date as date      no-undo .
      294     define variable v-time as integer   no-undo .
      295     run cur-time in this-procedure
      296       (output v-date
      297       ,output v-time
      298       ) .
      299     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      300   end.
      301   function cur-time-datetime returns datetime
      302   :
      303     define variable v-char as character no-undo .
      304     define variable v-datetime as datetime no-undo .
      305     v-char = cur-time-string().
      306     v-datetime = datetime(v-char).
      307     return  v-datetime.
      308   end.
      309   function cur-time-string-msec returns character
      310   :
      311     define variable v-date as datetime  no-undo .
      312     v-date = now.
      313     return string(v-date) .
      314   end.
      315   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      316   def
      317    shared
      318   temp-table  obj-list no-undo
      319     field obj-type like ub.clients.obj-type
      320     field obj-code like ub.clients.obj-code
      321     field obj-name like ub.clients.obj-name
      322     field obj-id   as integer
      323     field db-num   as integer
      324     index pi is primary unique obj-id
      325     index ie1 obj-type obj-code
      326     index ie2 obj-name
      327   .
      328   procedure create_obj-list :
      329      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      330      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      331      do
      332      on error undo, return error return-value
      333      :
      334         define buffer cli-obj for ub.clients .
      335         define variable p-var as integer no-undo .
      336         define buffer buf_obj-list for obj-list .
      337         find last buf_obj-list  use-index pi no-error .
      338         if available buf_obj-list
      339         then
      340            p-var = buf_obj-list.obj-id + 1.
      341         else
      342            p-var = 1.
      343         find first cli-obj where
      344                   cli-obj.obj-type = p-obj-type
      345               and cli-obj.obj-code = p-obj-code
      346         no-lock no-error.
      347         if available cli-obj
      348         then do:
      349            create buf_obj-list.
      350            assign
      351               buf_obj-list.obj-id   = p-var
      352               buf_obj-list.obj-code = cli-obj.obj-code
      353               buf_obj-list.obj-type = cli-obj.obj-type
      354               buf_obj-list.obj-name = cli-obj.obj-name
      355               buf_obj-list.db-num   = cli-obj.db-num
      356            .
      357         end.
      358      end.
      359   end.
      360   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      361   define new shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      362   define new shared variable RepPathName        as character no-undo .
      363   define new shared variable PrintRubl          as logical   no-undo .
      364   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      365   define  stream PrnLibStream.
      366   procedure prn-lib-prn-file :
      367     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      368     define input parameter p-DIsabledoptions as integer no-undo .
      369     define variable v-report-name as character no-undo .
      370     define variable v-user-action as character no-undo .
      371     define variable v-printed     as logical   no-undo .
      372     define variable v-exist       as logical   no-undo .
      373     do
      374       on error undo, return error
      375       :
      376       run prn-lib-get-report-name  in this-procedure (
      377         input parParentProc
      378         ,output v-report-name
      379         ).
      380   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      381   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      382     (input  v-report-name
      383     ,input  2
      384     ,output v-exist
      385     )  .
      386       if NOT v-exist then
      387       DO:
      388         Message
      389           "Нет заданий на печать ! "
      390           view-as alert-box .
      391         Return  .
      392       End.
      393       run gbl/prnfilen.w
      394         (input  ""
      395         ,input  p-DisabledOptions
      396         ,input  string(v-report-name )
      397         ,input  7
      398         ,output v-user-action
      399         ,output v-printed
      400         ) .
      401       if v-printed then
      402       do:
      403         return "YES" .
      404       end.
      405       else
      406       do:
      407         return "NO" .
      408       end.
      409     end.
      410   end procedure.
      411   procedure prn-lib-open-stream :
      412     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      413     define input parameter p-page-size    as integer no-undo .
      414     define input parameter p-is-stream    as logical no-undo .
      415     define input parameter p-append       as logical no-undo .
      416     define variable v-report-name as character no-undo .
      417     do
      418       on error undo, return error
      419       :
      420       run prn-lib-get-report-name  in this-procedure (
      421         input parParentProc
      422         ,output v-report-name
      423         ).
      424       if p-is-stream then
      425       do:
      426         if p-append then
      427         do:
      428           output stream PrnLibStream to value( v-report-name )
      429             page-size value(p-page-size) append .
      430         end.
      431         if not p-append then
      432         do:
      433           output stream PrnLibStream to value( v-report-name )
      434             page-size value(p-page-size) .
      435         end.
      436       end.
      437       if not p-is-stream then
      438       do:
      439         if p-append then
      440         do:
      441           output to value( v-report-name )
      442             page-size value(p-page-size) append .
      443         end.
      444         if not p-append then
      445         do:
      446           output to value( v-report-name )
      447             page-size value(p-page-size) .
      448         end.
      449       end.
      450     end.
      451   end procedure.
      452   procedure prn-lib-open-exp :
      453     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      454     define input parameter p-is-stream    as logical no-undo .
      455     define input parameter p-is-append    as logical no-undo .
      456     define output parameter p-ReportFileName as char init "report" no-undo.
      457     define output parameter p-process as logical no-undo .
      458     define variable glog as logical no-undo .
      459     do
      460       on error undo, return error
      461       :
      462       SYSTEM-DIALOG GET-FILE p-ReportFileName
      463         TITLE      "Укажите путь"
      464         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      465         ASK-OVERWRITE
      466         CREATE-TEST-FILE
      467         SAVE-AS
      468         USE-FILENAME
      469         DEFAULT-EXTENSION "txt"
      470         UPDATE glog
      471         .
      472       if not glog then  return.
      473       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      474       if p-is-stream then
      475       do:
      476         if p-is-append then
      477         do:
      478           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      479         end.
      480         else
      481         do:
      482           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      483         end.
      484       end.
      485       else
      486       do:
      487         if p-is-append then
      488         do:
      489           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      490         end.
      491         else
      492         do:
      493           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      494         end.
      495       end.
      496       p-process = yes.
      497     end.
      498   end procedure.
      499   procedure prn-lib-get-report-name :
      500     define input parameter parParentProc  as widget-handle no-undo.
      501     define output parameter p-report-name as character no-undo .
      502     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      503   end procedure.
      504   procedure prn-lib-reportviewer-report-name :
      505     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      506     define input parameter p-report-name-html as character no-undo .
      507     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      508   end procedure.
      509   procedure prn-lib-reportviewer :
      510     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      511     define input parameter p-report-name-html as character no-undo .
      512     define input parameter p-param        as character no-undo .
      513     define variable v-excel           as character no-undo init 'TRUE' .
      514     define variable v-value-character as character no-undo .
      515     define variable v-value-integer   as character no-undo .
      516     define variable v-value-date      as date      no-undo .
      517     define variable v-value-decimal   as decimal   no-undo .
      518     define variable rep-excel         as logical   no-undo .
      519     define variable excel-string      as character no-undo .
      520     define variable v-param-type      as character no-undo .
      521     define variable v-tth             as handle    no-undo .
      522     run adm/shattri.p (
      523       input "get":U
      524       ,input  ""
      525       ,input  0
      526       ,input  'report-glob':U
      527       ,input  'rep-excel':U
      528       ,output v-value-character
      529       ,output v-value-date
      530       ,output v-value-decimal
      531       ,output v-value-integer
      532       ,output rep-excel
      533       ,output v-param-type
      534       ,INPUT-OUTPUT table-handle v-tth
      535       )  .
      536     if rep-excel then v-excel = "TRUE" .
      537     else v-excel = "FALSE" .
      538     if p-param eq ""
      539     then
      540        p-param = "EXCEL:" + v-excel.
      541     else
      542        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      543     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      544   end procedure.
