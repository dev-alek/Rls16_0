      568         .
      569   define variable vss-include-info7 as character format "X(65)" no-undo
      570   initial "@(#)$Workfile$ $Revision$".
      571   procedure grplib-get-full-name :
      572      define input parameter p-node-code  as integer      no-undo.
      573      define output parameter p-full-name as character    no-undo.
      574      do
      575   on error undo, return error
      576   :
      577       define variable v-upper-code    as integer           no-undo.
      578       define buffer buf_gds-grp       for ub.gds-grp.
      579       define buffer buf_upper_gds-grp for ub.gds-grp.
      580       find first buf_gds-grp no-lock
      581            where buf_gds-grp.node-code = p-node-code
      582       no-error.
      583       if not available buf_gds-grp
      584       then do:
      585           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
      586       end.
      587       assign
      588           p-full-name  = ""
      589           v-upper-code = 1
      590       .
      591       do while buf_gds-grp.upper-code <> 0
      592       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
      593       :
      594           assign
      595               p-full-name  = buf_gds-grp.node-name
      596                            + (if p-full-name <> "" then chr(47) else "")
      597                            + p-full-name
      598               v-upper-code = buf_gds-grp.upper-code
      599           .
      600           find first buf_gds-grp no-lock
      601                where buf_gds-grp.node-code = v-upper-code
      602           no-error.
      603           if not available buf_gds-grp
      604           then do:
      605               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
      606                                   + string( v-upper-code )
      607                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      608           end.
      609       end.
      610       assign
      611       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
      612       .
      613   end.
      614   end .
      615   procedure grplib-get-node-from-full-name :
      616   define input parameter p-full-name as character no-undo .
      617   define output parameter p-node-code as integer no-undo .
      618   define variable v-ii as integer no-undo .
      619   define variable v-upper-code as integer no-undo .
      620   define variable v-root-code as integer no-undo .
      621   define variable v-entry as character no-undo .
      622   define buffer buf_gds-grp       for ub.gds-grp.
      623   do
      624   on error undo, return error
      625   :
      626     find first buf_gds-grp no-lock
      627         where buf_gds-grp.upper-code = 0
      628     no-error .
      629     if not available buf_gds-grp
      630     then do:
      631         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
      632     end.
      633     else do:
      634       assign
      635       v-root-code = buf_gds-grp.node-code
      636       .
      637     end.
      638     v-upper-code = v-root-code.
      639     do v-ii = 1 to num-entries(p-full-name, chr(47)):
      640       assign
      641       v-entry = entry(v-ii, p-full-name, chr(47)).
      642       if v-entry = '' then leave.
      643       find first buf_gds-grp no-lock where
      644                 buf_gds-grp.node-name = v-entry
      645             and buf_gds-grp.upper-code = v-upper-code
      646             no-error.
      647       if not available buf_gds-grp then do:
      648         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
      649       end.
      650       else do:
      651         p-node-code = buf_gds-grp.node-code.
      652         v-upper-code = buf_gds-grp.node-code.
      653       end.
      654     end.
      655   end.
      656   end .
      657   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      658   define variable v-waitfram-action01         as character   no-undo .
      659   define variable v-waitfram-action02         as character   no-undo .
      660   define variable v-waitfram-action03         as character   no-undo .
      661   define variable mWaitFramTextBeg            as character   no-undo.
      662   define variable mWaitFramTextEnd            as character   no-undo.
      663   define variable mWaitFramView               as logical     no-undo.
      664   define variable mWaitProcEvent              as logical     no-undo init yes.
      665   define variable mWaitFramInterval           as integer     no-undo init 1 .
      666   define variable mWaitFramStop               as logical     no-undo.
      667   define variable mWaitFramStopUser           as logical     no-undo.
      668   define variable mWaitFramStopTimeOut        as logical     no-undo.
      669   define variable mWaitFramStartProc          as datetime-tz no-undo.
      670   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      671   define button B-WaitFramStop auto-end-key
      672        label "Стоп"
      673        size 10 by 1 tooltip "Остоновить процесс".
      674   define button B-viewProcInfo
      675        label "Информация"
      676        size 15 by 1 tooltip "Информация о процесс".
      677   define frame waitfram
      678     v-waitfram-action01 format "x(72)" no-label skip
      679     v-waitfram-action02 format "x(72)" no-label skip
      680     v-waitfram-action03 format "x(72)" no-label skip
      681     B-viewProcInfo
      682     B-WaitFramStop at row 4 col 30
      683     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      684     .
      685   define new global shared variable mBatchMode as logical no-undo init ?.
      686   define variable mFramBachModHandle as handle no-undo.
      687   mFramBachModHandle = frame waitfram:handle.
      688   define variable mFameOldVis as logical no-undo.
      689   define variable mVisCUrentVin as logical no-undo.
      690   if session:batch-mode
      691   then
      692      mBatchMode = yes.
      693   if mBatchMode = ? then do:
      694     mVisCUrentVin = current-window:visible.
      695     mFameOldVis = mFramBachModHandle:visible.
      696     mFramBachModHandle:visible  = yes.
      697     mBatchMode = mFramBachModHandle:visible ne yes.
      698     mFramBachModHandle:visible = mFameOldVis.
      699     current-window:visible = mVisCUrentVin.
      700   end.
      701    if  log-manager:logfile-name ne ?
      702     then DO:
      703         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      704         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      705         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      706     end.
      707   on choose of B-WaitFramStop in frame waitfram
      708   do:
      709     mWaitFramStop = yes.
      710     mWaitFramStopUser = yes.
      711   end.
      712   function waitfram-check-timeout returns logical():
      713      define variable vtime as int64 no-undo.
      714      if mWaitFramStopTimeOut
      715      then
      716         return yes.
      717      vtime = ( now - mWaitFramStartProc ) / 1000 .
      718      if     mWaitFramTimeOut ne ?
      719         and mWaitFramTimeOut ne 0
      720         and mWaitFramTimeOut lt vtime
      721      then do:
      722         mWaitFramStopTimeOut = yes.
      723      end.
      724      return mWaitFramStopTimeOut.
      725   end.
      726   procedure waitfram-hide :
      727     if not session:batch-mode
      728     then do
      729     on error undo, return error return-value
      730     :
      731       pause 0 before-hide .
      732       if not mBatchMode then
      733         hide frame waitfram .
      734     if     not mWaitFramView
      735        and mWaitProcEvent
      736     then
      737       process events .
      738     end.
      739   end procedure.
      740   procedure waitfram-show :
      741     define input  parameter p-message as character no-undo .
      742     define variable v-left-margin as integer   no-undo .
      743     if not session:batch-mode
      744     then do
      745     on error undo, return error return-value
      746     :
      747       if length(p-message) <= 70 then do:
      748         assign
      749           v-left-margin = integer((70 - length(p-message)) / 2)
      750         .
      751         assign
      752           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      753         .
      754         assign
      755           v-waitfram-action01 = " "
      756           v-waitfram-action02 = " "
      757                                    + fill(" ", v-left-margin)
      758                                    + p-message
      759           v-waitfram-action03 = " "
      760         .
      761       end.
      762       else do:
      763         define variable vRindex1 as integer no-undo.
      764         define variable vRindex2 as integer no-undo.
      765         vRindex1 = r-index(p-message," ",70).
      766         if vRindex1 = 0
      767         then
      768            vRindex1 = 70.
      769         if length(p-message)  <= vRindex1 + 70 then do:
      770           assign
      771             v-waitfram-action01 = " "
      772             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      773             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      774           .
      775         end.
      776         else do:
      777           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      778           if vRindex2 <= vRindex1
      779           then
      780              vRindex2 = vRindex1 + 70.
      781           assign
      782             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      783             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      784             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      785           .
      786         end.
      787       end.
      788       B-viewProcInfo:visible   in frame waitfram = no.
      789       B-viewProcInfo:sensitive in frame waitfram = no.
      790       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      791       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      792       if  (   mWaitFramView
      793          or  mWaitProcEvent)
      794          and not mBatchMode
      795       then
      796          display
      797             v-waitfram-action01 skip
      798             v-waitfram-action02 skip
      799             v-waitfram-action03 skip
      800          with frame waitfram .
      801       if     mWaitFramView
      802          then do:
      803             if     mWaitFramInterval ne ?
      804                and not mBatchMode
      805             then
      806                wait-for go of frame waitfram pause mWaitFramInterval.
      807          end.
      808          else
      809             if     mWaitProcEvent
      810                and not mBatchMode
      811             then
      812                process events .
      813     end.
      814   end procedure.
      815      procedure waitfram-show-this:
      816         define input  parameter iInterval as int64 no-undo.
      817         define variable vtime as int64 no-undo.
      818         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      819         mWaitFramInterval = iInterval.
      820         run waitfram-show (substitute("&1&2 &3&4" ,
      821                                       mWaitFramTextBeg ,
      822                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      823                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      824                                       mWaitFramTextEnd
      825                                      )
      826                           ).
      827      end.
      828      procedure WaitFramRunPause:
      829         define input  parameter iInterval as dec no-undo.
      830         define variable vStart  as datetime-tz no-undo.
      831         define variable vend    as datetime-tz no-undo.
      832         define variable vint as int64 no-undo.
      833         define variable vOk as logical no-undo.
      834         vStart = now.
      835         vend   = vStart.
      836         publish "WaitFramPause" (iInterval,output vOk).
      837         vend   =  now.
      838         vint = vend - vStart.
      839         vint = iInterval - vint / 1000.
      840         if     not mWaitFramStop
      841            and (   vint > 0
      842                 or (    not vOk
      843                     and iInterval eq ?
      844                     )
      845                 )
      846         then
      847            run waitfram-show-this (iInterval).
      848         vend   =  now.
      849         vint = vend - vStart.
      850         vint = iInterval - vint / 1000.
      851         if     not mWaitFramStop
      852            and vint > 0
      853         then do:
      854            run gbl/pause.p (vint * 1000).
      855         end.
      856         if iInterval ne ?
      857         then
      858            publish "WaitFramStop".
      859         waitfram-check-timeout().
      860      end.
      861      procedure WaitFramWaitFor:
      862         define input  parameter iInterval as dec no-undo.
      863         assign
      864            mWaitFramStartProc   = now
      865            mWaitFramStopUser    = no
      866            mWaitFramStopTimeOut = no
      867         .
      868         block-wait:
      869         do while not mWaitFramStop:
      870            run WaitFramRunPause (iInterval).
      871            if  waitfram-check-timeout()
      872            then do:
      873               leave block-wait.
      874            end.
      875         end.
      876         run waitfram-hide.
      877      end.
      878   procedure waitfram-join :
      879     define input  parameter p-line-1  as character no-undo .
      880     define input  parameter p-line-2  as character no-undo .
      881     define input  parameter p-line-3  as character no-undo .
      882     define output parameter p-message as character no-undo .
      883     do
      884     on error undo, return error return-value
      885     :
      886       assign
      887         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      888                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      889                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      890       .
      891     end.
      892   end procedure.
      893   function waitfram-join-function returns character
      894     (input p-line-1 as character
      895     ,input p-line-2 as character
      896     ,input p-line-3 as character
      897     ).
      898     define variable v-message as character no-undo .
      899     run waitfram-join in this-procedure
      900       (input  p-line-1
      901       ,input  p-line-2
      902       ,input  p-line-3
      903       ,output v-message
      904       ) .
      905     return v-message .
      906   end function .
      907   DEFINE VARIABLE accum-count as integer no-undo .
      908   define SHARED temp-table temp-dis-card-type no-undo like ub.dis-card-type.
      909   define   shared variable Use-column   as logical extent 256 no-undo .
      910   define buffer for-grp for ub.gds-grp.
      911   define variable LL AS INTEGER.
      912   define variable tot-nc as integer no-undo.
      913   define variable ii as integer no-undo .
      914   define variable kk as integer no-undo .
      915   define variable cycle as integer no-undo .
      916   define variable v-obj-code like ub.clients.obj-code no-undo .
      917   define variable v-obj-name like ub.clients.obj-name no-undo .
      918   define variable accum-sum as decimal extent 24 no-undo .
      919   define variable accum-num-chk as integer extent 24 no-undo .
      920   define variable accum-sum-grp as decimal extent 24 no-undo .
      921   define variable accum-num-chk-grp as integer extent 24 no-undo .
      922   define variable accum-tot-nc as integer no-undo .
      923   define variable accum-tot-nc-grp as integer no-undo format ">>>>>9".
      924   define variable v-title as character no-undo .
      925   define variable accum-obj-list as integer no-undo.
      926   define variable cycle1 as integer no-undo.
      927   define buffer cli-obj for ub.clients .
      928   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      929   define buffer tot_full-grp for full-grp.
      930   for each obj-list no-lock:
      931     assign
      932     accum-obj-list = accum-obj-list + 1.
      933     if accum-obj-list > 1 then LEAVE.
      934   end.
      935   CASE method:
      936     when "LINE":U then do:
      937       run waitfram-show in this-procedure ("Строю дерево групп ...").
      938       for each ub.gds-grp no-lock:
      939         find first for-grp where
      940                   for-grp.upper-code = ub.gds-grp.node-code No-LOCK No-ERROR.
      941         if not avail for-grp then do:
      942           create full-grp.
      943           assign
      944           full-grp.grp-code = ub.gds-grp.node-code.
      945           if tree then
      946           run grplib-get-full-name in this-procedure(input ub.gds-grp.node-code, output full-grp.full-name).
      947           else
      948           full-grp.full-name = ub.gds-grp.node-name.
      949           full-grp.full-name = replace(full-grp.full-name, " ", "_").
      950         end.
      951       end.
      952       run waitfram-hide in this-procedure .
      953     end.
      954     when "pay":U then do:
      955       for each ub.cash-pay No-LOCK:
      956         create full-grp.
      957         assign
      958         full-grp.grp-code = ub.cash-pay.cdpay-code
      959         full-grp.other-code = ub.cash-pay.curr-code
      960         .
      961         FIND FIRST ub.currency No-LOCK WHERE
      962                   ub.currency.curr-code = ub.cash-pay.curr-code no-error.
      963         full-grp.full-name = substitute("&1_Валюта_&2"
      964                                         , ub.cash-pay.obj-name
      965                                         ,(if available ub.currency
      966                                           then ub.currency.curr-abbr
      967                                           else string(ub.cash-pay.curr-code))).
      968       end.
      969     end.
      970   END CASE.
      971   run prn-lib-open-stream  in this-procedure (
      972                                                input parParentProc
      973                                               ,input 62
      974                                               ,input yes
      975                                               ,input no
      976                                               ).
      977   run waitfram-show in this-procedure ("Ждите" ).
      978   PUT stream PrnLibStream UNFORMATTED
      979       "Почасовая статистика розничных продаж" format "x(80)" SKIP(0)
      980       ("( ПО ВЕЛИЧИНЕ СУММ ПРОДАЖ - СТРОКИ ЧЕКОВ) ЗА ПЕРИОД c" +
      981       string( startdate, "99/99/9999" ) + "по" + string( enddate, "99/99/9999" ) + ".")      format "x(80)" SKIP(0)
      982           IF RETS then "ВОЗВРАТЫ УЧТЕНЫ" ELSE "" format "x(80)" SKIP(0).
      983   if t-dis-card then do:
      984     PUT stream PrnLibStream UNFORMATTED
      985     "Только покупки по дисконтным картам" skip.
      986     if rs-dis-card = 1 then do:
      987       for each temp-dis-card-type No-LOCK:
