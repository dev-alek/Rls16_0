     1074   PUT stream PrnLibStream  UNFORMATTED
     1075   "Итого_по_строке" p-XL-delim skip.
     1076   _cycle:
     1077   do cycle = 1 to 0 by -1:
     1078     if byobject and cycle = 0 and accum-obj-list = 1 then LEAVE _cycle.
     1079     _obj-list:
     1080     for each obj-list no-lock:
     1081       if not byobject and cycle = 1 then LEAVE _obj-list.
     1082       if cycle = 1 then v-obj-code = obj-list.obj-code.
     1083       if cycle = 0 then v-obj-code = 0.
     1084       if cycle = 1 then do:
     1085         FIND FIRST ub.clients NO-LOCK WHERE
     1086                   ub.clients.obj-code = v-obj-code AND
     1087                   ub.clients.obj-type = 'маг':U NO-ERROR.
     1088         if available clients then do:
     1089           v-obj-name = replace(ub.clients.obj-name, chr(32), "_").
     1090         end.
     1091         else v-obj-name = string(v-obj-code).
     1092       end.
     1093       if byobject and cycle = 0 then do:
     1094         v-obj-name = "ПО_ВСЕМ_ОБЪЕКТАМ".
     1095       end.
     1096       PUT stream PrnLibStream UNFORMATTED
     1097       v-obj-name skip.
     1098       assign
     1099       tot-nc = 0
     1100       accum-num-chk[1] =  0
     1101       accum-num-chk[2] =  0
     1102       accum-num-chk[3] =  0
     1103       accum-num-chk[4] =  0
     1104       accum-num-chk[5] =  0
     1105       accum-num-chk[6] =  0
     1106       accum-num-chk[7] =  0
     1107       accum-num-chk[8] =  0
     1108       accum-num-chk[9] =  0
     1109       accum-num-chk[10] = 0
     1110       accum-num-chk[11] = 0
     1111       accum-num-chk[12] = 0
     1112       accum-num-chk[13] = 0
     1113       accum-num-chk[14] = 0
     1114       accum-num-chk[15] = 0
     1115       accum-num-chk[16] = 0
     1116       accum-num-chk[17] = 0
     1117       accum-num-chk[18] = 0
     1118       accum-num-chk[19] = 0
     1119       accum-num-chk[20] = 0
     1120       accum-num-chk[21] = 0
     1121       accum-num-chk[22] = 0
     1122       accum-num-chk[23] = 0
     1123       accum-num-chk[24] = 0
     1124       accum-tot-nc = 0
     1125       accum-count = 0
     1126       .
     1127       assign
     1128       accum-num-chk-grp[1] =  0
     1129       accum-num-chk-grp[2] =  0
     1130       accum-num-chk-grp[3] =  0
     1131       accum-num-chk-grp[4] =  0
     1132       accum-num-chk-grp[5] =  0
     1133       accum-num-chk-grp[6] =  0
     1134       accum-num-chk-grp[7] =  0
     1135       accum-num-chk-grp[8] =  0
     1136       accum-num-chk-grp[9] =  0
     1137       accum-num-chk-grp[10] = 0
     1138       accum-num-chk-grp[11] = 0
     1139       accum-num-chk-grp[12] = 0
     1140       accum-num-chk-grp[13] = 0
     1141       accum-num-chk-grp[14] = 0
     1142       accum-num-chk-grp[15] = 0
     1143       accum-num-chk-grp[16] = 0
     1144       accum-num-chk-grp[17] = 0
     1145       accum-num-chk-grp[18] = 0
     1146       accum-num-chk-grp[19] = 0
     1147       accum-num-chk-grp[20] = 0
     1148       accum-num-chk-grp[21] = 0
     1149       accum-num-chk-grp[22] = 0
     1150       accum-num-chk-grp[23] = 0
     1151       accum-num-chk-grp[24] = 0
     1152       accum-tot-nc-grp = 0
     1153       .
     1154       if byobject then do:
     1155         for each sum-vals:
     1156           ASSIGN
     1157           sum-vals.num-chk[1] = 0
     1158           sum-vals.num-chk[2] = 0
     1159           sum-vals.num-chk[3] = 0
     1160           sum-vals.num-chk[4] = 0
     1161           sum-vals.num-chk[5] = 0
     1162           sum-vals.num-chk[6] = 0
     1163           sum-vals.num-chk[7] = 0
     1164           sum-vals.num-chk[8] = 0
     1165           sum-vals.num-chk[9] = 0
     1166           sum-vals.num-chk[10] = 0
     1167           sum-vals.num-chk[11] = 0
     1168           sum-vals.num-chk[12] = 0
     1169           sum-vals.num-chk[13] = 0
     1170           sum-vals.num-chk[14] = 0
     1171           sum-vals.num-chk[15] = 0
     1172           sum-vals.num-chk[16] = 0
     1173           sum-vals.num-chk[17] = 0
     1174           sum-vals.num-chk[18] = 0
     1175           sum-vals.num-chk[19] = 0
     1176           sum-vals.num-chk[20] = 0
     1177           sum-vals.num-chk[21] = 0
     1178           sum-vals.num-chk[22] = 0
     1179           sum-vals.num-chk[23] = 0
     1180           sum-vals.num-chk[24] = 0
     1181           sum-vals.tot         = 0
     1182           .
     1183         end.
     1184       end.
     1185       FOR EACH full-grp No-LOCK,
     1186           EACH grp-h WHERE
     1187                grp-h.obj-code = v-obj-code
     1188            AND grp-h.grp-code = full-grp.grp-code
     1189            AND grp-h.other-code = full-grp.other-code
     1190       BREAK
     1191       BY full-grp.full-name
     1192       BY grp-h.obj-code
     1193       BY grp-h.grp-code
     1194       BY grp-h.other-code
     1195       BY grp-h.sum1:
     1196         if (method = "pay":U and first-of(grp-h.other-code)) OR
     1197           (method <> "pay":U and first-of( grp-h.grp-code )) then do:
     1198           assign
     1199           accum-num-chk-grp[1] =  0
     1200           accum-num-chk-grp[2] =  0
     1201           accum-num-chk-grp[3] =  0
     1202           accum-num-chk-grp[4] =  0
     1203           accum-num-chk-grp[5] =  0
     1204           accum-num-chk-grp[6] =  0
     1205           accum-num-chk-grp[7] =  0
     1206           accum-num-chk-grp[8] =  0
     1207           accum-num-chk-grp[9] =  0
     1208           accum-num-chk-grp[10] = 0
     1209           accum-num-chk-grp[11] = 0
     1210           accum-num-chk-grp[12] = 0
     1211           accum-num-chk-grp[13] = 0
     1212           accum-num-chk-grp[14] = 0
     1213           accum-num-chk-grp[15] = 0
     1214           accum-num-chk-grp[16] = 0
     1215           accum-num-chk-grp[17] = 0
     1216           accum-num-chk-grp[18] = 0
     1217           accum-num-chk-grp[19] = 0
     1218           accum-num-chk-grp[20] = 0
     1219           accum-num-chk-grp[21] = 0
     1220           accum-num-chk-grp[22] = 0
     1221           accum-num-chk-grp[23] = 0
     1222           accum-num-chk-grp[24] = 0
     1223           accum-tot-nc-grp = 0
     1224           accum-count = accum-count + 1
     1225           .
     1226           PUT stream PrnLibStream UNFORMATTED
     1227           full-grp.full-name SKIP    .
     1228         end.
     1229         FIND FIRST sum-vals where
     1230                    sum-vals.sum1 = grp-h.sum1 .
     1231         assign
     1232           tot-nc = 0
     1233         .
     1234         do cycle1 = 1 to 24.
     1235           if use-column[cycle1 + 3] then tot-nc = grp-h.num-chk[cycle1] + tot-nc .
     1236         end.
     1237           PUT stream PrnLibStream UNFORMATTED
     1238           (string(sum-vals.sum1) + "_" + string(sum-vals.sum2) ) p-XL-delim.
     1239           do cycle1 = 1 to 24.
     1240             if use-column[cycle1 + 3] then
     1241               PUT stream PrnLibStream UNFORMATTED
     1242               grp-h.num-ch[cycle1]     p-XL-delim.
     1243           end.
     1244           PUT stream PrnLibStream UNFORMATTED
     1245           tot-nc SKIP
     1246           .
     1247           ASSIGN
     1248           accum-num-chk[1] = accum-num-chk[1] + grp-h.num-chk[1]
     1249           accum-num-chk[2] = accum-num-chk[2] + grp-h.num-chk[2]
     1250           accum-num-chk[3] = accum-num-chk[3] + grp-h.num-chk[3]
     1251           accum-num-chk[4] = accum-num-chk[4] + grp-h.num-chk[4]
     1252           accum-num-chk[5] = accum-num-chk[5] + grp-h.num-chk[5]
     1253           accum-num-chk[6] = accum-num-chk[6] + grp-h.num-chk[6]
     1254           accum-num-chk[7] = accum-num-chk[7] + grp-h.num-chk[7]
     1255           accum-num-chk[8] = accum-num-chk[8] + grp-h.num-chk[8]
     1256           accum-num-chk[9] = accum-num-chk[9] + grp-h.num-chk[9]
     1257           accum-num-chk[10] = accum-num-chk[10] + grp-h.num-chk[10]
     1258           accum-num-chk[11] = accum-num-chk[11] + grp-h.num-chk[11]
     1259           accum-num-chk[12] = accum-num-chk[12] + grp-h.num-chk[12]
     1260           accum-num-chk[13] = accum-num-chk[13] + grp-h.num-chk[13]
     1261           accum-num-chk[14] = accum-num-chk[14] + grp-h.num-chk[14]
     1262           accum-num-chk[15] = accum-num-chk[15] + grp-h.num-chk[15]
     1263           accum-num-chk[16] = accum-num-chk[16] + grp-h.num-chk[16]
     1264           accum-num-chk[17] = accum-num-chk[17] + grp-h.num-chk[17]
     1265           accum-num-chk[18] = accum-num-chk[18] + grp-h.num-chk[18]
     1266           accum-num-chk[19] = accum-num-chk[19] + grp-h.num-chk[19]
     1267           accum-num-chk[20] = accum-num-chk[20] + grp-h.num-chk[20]
     1268           accum-num-chk[21] = accum-num-chk[21] + grp-h.num-chk[21]
     1269           accum-num-chk[22] = accum-num-chk[22] + grp-h.num-chk[22]
     1270           accum-num-chk[23] = accum-num-chk[23] + grp-h.num-chk[23]
     1271           accum-num-chk[24] = accum-num-chk[24] + grp-h.num-chk[24]
     1272           accum-tot-nc = accum-tot-nc + tot-nc
     1273           .
     1274           assign
     1275           accum-num-chk-grp[1] = accum-num-chk-grp[1] + grp-h.num-chk[1]
     1276           accum-num-chk-grp[2] = accum-num-chk-grp[2] + grp-h.num-chk[2]
     1277           accum-num-chk-grp[3] = accum-num-chk-grp[3] + grp-h.num-chk[3]
     1278           accum-num-chk-grp[4] = accum-num-chk-grp[4] + grp-h.num-chk[4]
     1279           accum-num-chk-grp[5] = accum-num-chk-grp[5] + grp-h.num-chk[5]
     1280           accum-num-chk-grp[6] = accum-num-chk-grp[6] + grp-h.num-chk[6]
     1281           accum-num-chk-grp[7] = accum-num-chk-grp[7] + grp-h.num-chk[7]
     1282           accum-num-chk-grp[8] = accum-num-chk-grp[8] + grp-h.num-chk[8]
     1283           accum-num-chk-grp[9] = accum-num-chk-grp[9] + grp-h.num-chk[9]
     1284           accum-num-chk-grp[10] = accum-num-chk-grp[10] + grp-h.num-chk[10]
     1285           accum-num-chk-grp[11] = accum-num-chk-grp[11] + grp-h.num-chk[11]
     1286           accum-num-chk-grp[12] = accum-num-chk-grp[12] + grp-h.num-chk[12]
     1287           accum-num-chk-grp[13] = accum-num-chk-grp[13] + grp-h.num-chk[13]
     1288           accum-num-chk-grp[14] = accum-num-chk-grp[14] + grp-h.num-chk[14]
     1289           accum-num-chk-grp[15] = accum-num-chk-grp[15] + grp-h.num-chk[15]
     1290           accum-num-chk-grp[16] = accum-num-chk-grp[16] + grp-h.num-chk[16]
     1291           accum-num-chk-grp[17] = accum-num-chk-grp[17] + grp-h.num-chk[17]
     1292           accum-num-chk-grp[18] = accum-num-chk-grp[18] + grp-h.num-chk[18]
     1293           accum-num-chk-grp[19] = accum-num-chk-grp[19] + grp-h.num-chk[19]
     1294           accum-num-chk-grp[20] = accum-num-chk-grp[20] + grp-h.num-chk[20]
     1295           accum-num-chk-grp[21] = accum-num-chk-grp[21] + grp-h.num-chk[21]
     1296           accum-num-chk-grp[22] = accum-num-chk-grp[22] + grp-h.num-chk[22]
     1297           accum-num-chk-grp[23] = accum-num-chk-grp[23] + grp-h.num-chk[23]
     1298           accum-num-chk-grp[24] = accum-num-chk-grp[24] + grp-h.num-chk[24]
     1299           accum-tot-nc-grp = accum-tot-nc-grp + tot-nc
     1300           .
     1301           ASSIGN
     1302           sum-vals.num-chk[1] = sum-vals.num-chk[1] + grp-h.num-chk[1]
     1303           sum-vals.num-chk[2] = sum-vals.num-chk[2] + grp-h.num-chk[2]
     1304           sum-vals.num-chk[3] = sum-vals.num-chk[3] + grp-h.num-chk[3]
     1305           sum-vals.num-chk[4] = sum-vals.num-chk[4] + grp-h.num-chk[4]
     1306           sum-vals.num-chk[5] = sum-vals.num-chk[5] + grp-h.num-chk[5]
     1307           sum-vals.num-chk[6] = sum-vals.num-chk[6] + grp-h.num-chk[6]
     1308           sum-vals.num-chk[7] = sum-vals.num-chk[7] + grp-h.num-chk[7]
     1309           sum-vals.num-chk[8] = sum-vals.num-chk[8] + grp-h.num-chk[8]
     1310           sum-vals.num-chk[9] = sum-vals.num-chk[9] + grp-h.num-chk[9]
     1311           sum-vals.num-chk[10] = sum-vals.num-chk[10] + grp-h.num-chk[10]
     1312           sum-vals.num-chk[11] = sum-vals.num-chk[11] + grp-h.num-chk[11]
     1313           sum-vals.num-chk[12] = sum-vals.num-chk[12] + grp-h.num-chk[12]
     1314           sum-vals.num-chk[13] = sum-vals.num-chk[13] + grp-h.num-chk[13]
     1315           sum-vals.num-chk[14] = sum-vals.num-chk[14] + grp-h.num-chk[14]
     1316           sum-vals.num-chk[15] = sum-vals.num-chk[15] + grp-h.num-chk[15]
     1317           sum-vals.num-chk[16] = sum-vals.num-chk[16] + grp-h.num-chk[16]
     1318           sum-vals.num-chk[17] = sum-vals.num-chk[17] + grp-h.num-chk[17]
     1319           sum-vals.num-chk[18] = sum-vals.num-chk[18] + grp-h.num-chk[18]
     1320           sum-vals.num-chk[19] = sum-vals.num-chk[19] + grp-h.num-chk[19]
     1321           sum-vals.num-chk[20] = sum-vals.num-chk[20] + grp-h.num-chk[20]
     1322           sum-vals.num-chk[21] = sum-vals.num-chk[21] + grp-h.num-chk[21]
     1323           sum-vals.num-chk[22] = sum-vals.num-chk[22] + grp-h.num-chk[22]
     1324           sum-vals.num-chk[23] = sum-vals.num-chk[23] + grp-h.num-chk[23]
     1325           sum-vals.num-chk[24] = sum-vals.num-chk[24] + grp-h.num-chk[24]
     1326           sum-vals.tot = sum-vals.tot + tot-nc
     1327           .
     1328           IF (method = "pay":U and LAST-OF(grp-h.other-code))
     1329           or (method <> "PAY":U and LAST-OF(grp-h.grp-code))  then do:
     1330             if method = "pay" then do:
     1331               v-title = substitute('&1_по_виду платежа', v-obj-name).
     1332             end.
     1333             if method = "LINE" then do:
     1334               v-title = substitute('&1_по_группе', v-obj-name).
     1335             end.
     1336             PUT stream PrnLibStream UNFORMATTED
     1337             v-title              p-XL-delim.
     1338             do cycle1 = 1 to 24.
     1339               if use-column[cycle1 + 3] then
     1340                 PUT stream PrnLibStream UNFORMATTED
     1341                 accum-num-chk-grp[cycle1]     p-XL-delim.
     1342             end.
     1343             PUT stream PrnLibStream UNFORMATTED
     1344             accum-tot-nc-grp SKIP  .
     1345           end.
     1346           IF (method = "pay":U and LAST(grp-h.other-code)) OR
     1347             (method <> "PAY":U and LAST(grp-h.grp-code)) then do:
     1348             IF (ACCUM-count)  > 1 then do:
     1349               PUT stream PrnLibStream UNFORMATTED
     1350               (if method = "pay":U
     1351               then  substitute("&1_по_ВСЕМ_ВИДАМ ПЛАТЕЖЕЙ", v-obj-name)
     1352               else  substitute("&1_по_ВСЕМ_ГРУППАМ", v-obj-name)
     1353               ) SKIP.
     1354               FOR EACH sum-vals NO-LOCK where :
     1355                 if v-obj-code > 0 and accum-obj-list > 1 and sum-vals.tot = 0 then next.
     1356                 PUT stream PrnLibStream UNFORMATTED
     1357                 (string(sum-vals.sum1) + "_" + string(sum-vals.sum2) ) p-XL-delim.
     1358                 do cycle1 = 1 to 24.
     1359                   if use-column[cycle1 + 3] then
     1360                     PUT stream PrnLibStream UNFORMATTED
     1361                     sum-vals.num-chk[cycle1]     p-XL-delim.
     1362                 end.
     1363                 PUT stream PrnLibStream UNFORMATTED
     1364                 sum-vals.tot SKIP.
     1365               END.
     1366           end.
     1367         end.
     1368       END .
     1369       PUT stream PrnLibStream UNFORMATTED
     1370       substitute("Итого_&1", v-obj-name)
     1371       p-XL-delim.
     1372       do cycle1 = 1 to 24.
     1373         if use-column[cycle1 + 3] then
     1374           PUT stream PrnLibStream UNFORMATTED
     1375           accum-num-chk[cycle1]     p-XL-delim.
     1376       end.
     1377       PUT stream PrnLibStream UNFORMATTED
     1378       ACCUM-tot-nc SKIP.
     1379       if byobject and cycle = 0 then LEAVE _obj-list.
     1380     end.
     1381   END.
     1382   output stream PrnLibStream CLOSE .
     1383   run waitfram-hide in this-procedure .
