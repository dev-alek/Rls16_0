      803         if varoutvprbcl = "base":u then do:
      804           assign
      805             varcurclprice-base = out-vatp_gds-dtlcl.cur-base
      806             varcurclprice-rubl = out-vatp_gds-dtlcl.cur-base * ((out-vatp_gds-dtlcl.price-rubl - out-vatp_gds-dtlcl.discnt-rubl) / (out-vatp_gds-dtlcl.price-base - out-vatp_gds-dtlcl.discnt-base)).
      807         end.
      808         else do:
      809           assign
      810             varcurclprice-base = out-vatp_gds-dtlcl.cur-base / ((out-vatp_gds-dtlcl.price-rubl - out-vatp_gds-dtlcl.discnt-rubl) / (out-vatp_gds-dtlcl.price-base - out-vatp_gds-dtlcl.discnt-base))
      811             varcurclprice-rubl = out-vatp_gds-dtlcl.cur-base.
