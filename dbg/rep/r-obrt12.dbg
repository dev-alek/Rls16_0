     2045         bf_tt-allsum-line.road-tax-base-doc      = bf_tt-allsum-line.road-tax-base-doc    + bf_tt-allsum.road-tax-base-doc
     2046         bf_tt-allsum-line.road-tax-rubl-doc      = bf_tt-allsum-line.road-tax-rubl-doc    + bf_tt-allsum.road-tax-rubl-doc
     2047         bf_tt-allsum-line.excise-base-doc        = bf_tt-allsum-line.excise-base-doc      + bf_tt-allsum.excise-base-doc
     2048         bf_tt-allsum-line.excise-rubl-doc        = bf_tt-allsum-line.excise-rubl-doc      + bf_tt-allsum.excise-rubl-doc
     2049         bf_tt-allsum-line.sum-dsc-base-cur       = bf_tt-allsum-line.sum-dsc-base-cur     + bf_tt-allsum.sum-dsc-base-cur
     2050         bf_tt-allsum-line.sum-dsc-rubl-cur       = bf_tt-allsum-line.sum-dsc-rubl-cur     + bf_tt-allsum.sum-dsc-rubl-cur
     2051         bf_tt-allsum-line.dsc-base-cur           = bf_tt-allsum-line.dsc-base-cur         + bf_tt-allsum.dsc-base-cur
     2052         bf_tt-allsum-line.dsc-rubl-cur           = bf_tt-allsum-line.dsc-rubl-cur         + bf_tt-allsum.dsc-rubl-cur
     2053         bf_tt-allsum-line.vat-base-cur           = bf_tt-allsum-line.vat-base-cur         + bf_tt-allsum.vat-base-cur
     2054         bf_tt-allsum-line.vat-rubl-cur           = bf_tt-allsum-line.vat-rubl-cur         + bf_tt-allsum.vat-rubl-cur
     2055         bf_tt-allsum-line.vat-base-buyer-cur     = bf_tt-allsum-line.vat-base-buyer-cur   + bf_tt-allsum.vat-base-buyer-cur
     2056         bf_tt-allsum-line.vat-rubl-buyer-cur     = bf_tt-allsum-line.vat-rubl-buyer-cur   + bf_tt-allsum.vat-rubl-buyer-cur
     2057         bf_tt-allsum-line.slt-base-cur           = bf_tt-allsum-line.slt-base-cur         + bf_tt-allsum.slt-base-cur
     2058         bf_tt-allsum-line.slt-rubl-cur           = bf_tt-allsum-line.slt-rubl-cur         + bf_tt-allsum.slt-rubl-cur
     2059         bf_tt-allsum-line.road-tax-base-cur      = bf_tt-allsum-line.road-tax-base-cur    + bf_tt-allsum.road-tax-base-cur
     2060         bf_tt-allsum-line.road-tax-rubl-cur      = bf_tt-allsum-line.road-tax-rubl-cur    + bf_tt-allsum.road-tax-rubl-cur
     2061         bf_tt-allsum-line.excise-base-cur        = bf_tt-allsum-line.excise-base-cur      + bf_tt-allsum.excise-base-cur
     2062         bf_tt-allsum-line.excise-rubl-cur        = bf_tt-allsum-line.excise-rubl-cur      + bf_tt-allsum.excise-rubl-cur
     2063         bf_tt-allsum-line.sum-dsc-base-acc       = bf_tt-allsum-line.sum-dsc-base-acc     + bf_tt-allsum.sum-dsc-base-acc
     2064         bf_tt-allsum-line.sum-dsc-rubl-acc       = bf_tt-allsum-line.sum-dsc-rubl-acc     + bf_tt-allsum.sum-dsc-rubl-acc
     2065         bf_tt-allsum-line.sum-dsc-cli-acc        = bf_tt-allsum-line.sum-dsc-cli-acc      + bf_tt-allsum.sum-dsc-cli-acc
     2066         bf_tt-allsum-line.dsc-base-acc           = bf_tt-allsum-line.dsc-base-acc         + bf_tt-allsum.dsc-base-acc
     2067         bf_tt-allsum-line.dsc-rubl-acc           = bf_tt-allsum-line.dsc-rubl-acc         + bf_tt-allsum.dsc-rubl-acc
     2068         bf_tt-allsum-line.dsc-cli-acc            = bf_tt-allsum-line.dsc-cli-acc          + bf_tt-allsum.dsc-cli-acc
     2069         bf_tt-allsum-line.vat-base-acc           = bf_tt-allsum-line.vat-base-acc         + bf_tt-allsum.vat-base-acc
     2070         bf_tt-allsum-line.vat-rubl-acc           = bf_tt-allsum-line.vat-rubl-acc         + bf_tt-allsum.vat-rubl-acc
     2071         bf_tt-allsum-line.vat-cli-acc            = bf_tt-allsum-line.vat-cli-acc          + bf_tt-allsum.vat-cli-acc
     2072         bf_tt-allsum-line.slt-base-acc           = bf_tt-allsum-line.slt-base-acc         + bf_tt-allsum.slt-base-acc
     2073         bf_tt-allsum-line.slt-rubl-acc           = bf_tt-allsum-line.slt-rubl-acc         + bf_tt-allsum.slt-rubl-acc
     2074         bf_tt-allsum-line.slt-cli-acc            = bf_tt-allsum-line.slt-cli-acc          + bf_tt-allsum.slt-cli-acc
     2075         bf_tt-allsum-line.road-tax-base-acc      = bf_tt-allsum-line.road-tax-base-acc    + bf_tt-allsum.road-tax-base-acc
     2076         bf_tt-allsum-line.road-tax-rubl-acc      = bf_tt-allsum-line.road-tax-rubl-acc    + bf_tt-allsum.road-tax-rubl-acc
     2077         bf_tt-allsum-line.road-tax-cli-acc       = bf_tt-allsum-line.road-tax-cli-acc     + bf_tt-allsum.road-tax-cli-acc
     2078         bf_tt-allsum-line.excise-base-acc        = bf_tt-allsum-line.excise-base-acc      + bf_tt-allsum.excise-base-acc
     2079         bf_tt-allsum-line.excise-rubl-acc        = bf_tt-allsum-line.excise-rubl-acc      + bf_tt-allsum.excise-rubl-acc
     2080         bf_tt-allsum-line.excise-cli-acc         = bf_tt-allsum-line.excise-cli-acc       + bf_tt-allsum.excise-cli-acc
     2081         bf_tt-allsum-line.transport-base-acc     = bf_tt-allsum-line.transport-base-acc   + bf_tt-allsum.transport-base-acc
     2082         bf_tt-allsum-line.transport-rubl-acc     = bf_tt-allsum-line.transport-rubl-acc   + bf_tt-allsum.transport-rubl-acc
     2083         bf_tt-allsum-line.transport-cli-acc      = bf_tt-allsum-line.transport-cli-acc    + bf_tt-allsum.transport-cli-acc
     2084         bf_tt-allsum-line.other-base-acc         = bf_tt-allsum-line.other-base-acc       + bf_tt-allsum.other-base-acc
     2085         bf_tt-allsum-line.other-rubl-acc         = bf_tt-allsum-line.other-rubl-acc       + bf_tt-allsum.other-rubl-acc
     2086         bf_tt-allsum-line.other-cli-acc          = bf_tt-allsum-line.other-cli-acc        + bf_tt-allsum.other-cli-acc
     2087         .
     2088     end.
     2089   end.
     2090   end.
     2091   end procedure.
     2092   define input  parameter x-SET_val_TYPE    as integer   no-undo .
     2093   define input  parameter p-fo              as decimal   no-undo .
     2094   define input  parameter p-free-qnty       as decimal   no-undo .
     2095   define input  parameter p-obj-type  like gds-obj.obj-type     .
     2096   define input  parameter p-obj-code  like gds-obj.obj-code     .
     2097   define input  parameter p-prod-type like gds-obj.prod-type    .
     2098   define input  parameter p-prod-code like gds-obj.prod-code    .
     2099   define input  parameter p-artic     like gds-obj.artic        .
     2100   define input-output parameter p-Free-CostSum    as decimal   no-undo .
     2101   define input-output parameter p-Free-SaleSum    as decimal   no-undo .
     2102   define input-output parameter p-Res-Qnty        as decimal   no-undo .
     2103   define input-output parameter p-Res-CostSum     as decimal   no-undo .
     2104   define input-output parameter p-Res-DocSum      as decimal   no-undo .
     2105   define input-output parameter p-Res-SaleSum     as decimal   no-undo .
     2106   define input-output parameter p-Res-DiscntSum   as decimal   no-undo .
     2107   define buffer buf_stk-line for stk-line.
     2108         find last buf_stk-line no-lock
     2109           where buf_stk-line.obj-type  = p-obj-type
     2110             and buf_stk-line.obj-code  = p-obj-code
     2111             and buf_stk-line.artic     = p-artic
     2112             and buf_stk-line.prod-type = p-prod-type
     2113             and buf_stk-line.prod-code = p-prod-code
     2114             and buf_stk-line.sum-type  = 'crsa':U
     2115             and buf_stk-line.cat-id    = '##,##'
     2116             and buf_stk-line.fact-order <= p-fo
     2117           use-index category no-error .
     2118         if available buf_stk-line then do:
     2119           if x-SET_val_TYPE = 1  then assign p-Free-SaleSum = p-Free-SaleSum + buf_stk-line.sum-rubl * p-free-qnty / buf_stk-line.fact-qnty .
     2120           else                        assign p-Free-SaleSum = p-Free-SaleSum + buf_stk-line.sum-base * p-free-qnty / buf_stk-line.fact-qnty .
     2121         end.
     2122         if p-Free-SaleSum = ? then p-Free-SaleSum = 0.
     2123         find last buf_stk-line no-lock
     2124           where buf_stk-line.obj-type  = p-obj-type
     2125             and buf_stk-line.obj-code  = p-obj-code
     2126             and buf_stk-line.artic     = p-artic
     2127             and buf_stk-line.prod-type = p-prod-type
     2128             and buf_stk-line.prod-code = p-prod-code
     2129             and buf_stk-line.sum-type  = 'cost':U
     2130             and buf_stk-line.cat-id    = '##,##'
     2131             and buf_stk-line.fact-order <= p-fo
     2132           use-index category no-error .
     2133         if available buf_stk-line then do:
     2134           if x-SET_val_TYPE = 1  then assign p-Free-CostSum = p-Free-CostSum + buf_stk-line.sum-rubl * p-free-qnty / buf_stk-line.fact-qnty .
     2135           else                        assign p-Free-CostSum = p-Free-CostSum + buf_stk-line.sum-base * p-free-qnty / buf_stk-line.fact-qnty .
     2136         end.
     2137         if p-Free-CostSum = ? then p-Free-CostSum = 0.
     2138       run CalcWaitQnty (input 'ee':U ) .
     2139       run CalcWaitQnty (input 'ep':U ) .
     2140       run CalcWaitQnty (input 'es':U ) .
     2141       run CalcWaitQnty (input 'we':U ) .
     2142       run CalcWaitQnty (input 'ev':U ) .
     2143       run CalcWaitQnty (input 'em':U ) .
     2144       run CalcWaitQnty (input 'wm':U ) .
     2145       run CalcWaitQnty (input 'vt':U ) .
     2146       run CalcWaitQnty (input 'vp':U ) .
     2147   procedure CalcWaitQnty :
     2148     define input  parameter p-ext-doc-type as character no-undo .
     2149     define buffer buf_doc-line for doc-line .
     2150     for each buf_doc-line no-lock
     2151       where ( buf_doc-line.obj-type         = p-obj-type
     2152               and buf_doc-line.obj-code     = p-obj-code
     2153               and buf_doc-line.prod-type    = p-prod-type
     2154               and buf_doc-line.prod-code    = p-prod-code
     2155               and buf_doc-line.artic        = p-artic
     2156               and buf_doc-line.ext-doc-type = p-ext-doc-type
     2157               and buf_doc-line.status_      = 'накл':U
     2158             )
     2159         or ( buf_doc-line.obj-type         = p-obj-type
     2160              and buf_doc-line.obj-code     = p-obj-code
     2161              and buf_doc-line.prod-type    = p-prod-type
     2162              and buf_doc-line.prod-code    = p-prod-code
     2163              and buf_doc-line.artic        = p-artic
     2164              and buf_doc-line.ext-doc-type = p-ext-doc-type
     2165              and buf_doc-line.status_      = 'разрешен':U
     2166            )
     2167       :
     2168       if ( p-ext-doc-type = 'vt':U or p-ext-doc-type = 'vp':U ) and buf_doc-line.fact-qnty >= 0 then next .
     2169       run clcprtsl_calc-line (recid (buf_doc-line)) .
     2170       find first tt-allsum-line where tt-allsum-line.sum-type = 'основная_сумма':U no-error .
     2171       if available tt-allsum-line then do:
     2172         if x-SET_val_TYPE = 1  then do:
     2173           assign
     2174             p-Res-Qnty      = p-Res-Qnty      + tt-allsum-line.fact-qnty
     2175             p-Res-CostSum   = p-Res-CostSum   + tt-allsum-line.sum-dsc-rubl-acc
     2176             p-Res-DocSum    = p-Res-DocSum    + tt-allsum-line.sum-dsc-rubl-doc
     2177             p-Res-SaleSum   = p-Res-SaleSum   + tt-allsum-line.sum-dsc-rubl-cur
     2178             p-Res-DiscntSum = p-Res-DiscntSum + tt-allsum-line.sum-dsc-rubl-cur - tt-allsum-line.sum-dsc-rubl-doc
     2179           .
     2180         end.
     2181         else do:
     2182           assign
     2183             p-Res-Qnty      = p-Res-Qnty      + tt-allsum-line.fact-qnty
     2184             p-Res-CostSum   = p-Res-CostSum   + tt-allsum-line.sum-dsc-base-acc
     2185             p-Res-DocSum    = p-Res-DocSum    + tt-allsum-line.sum-dsc-base-doc
     2186             p-Res-SaleSum   = p-Res-SaleSum   + tt-allsum-line.sum-dsc-base-cur
     2187             p-Res-DiscntSum = p-Res-DiscntSum + tt-allsum-line.sum-dsc-base-cur - tt-allsum-line.sum-dsc-base-doc
     2188           .
     2189         end.
     2190       end.
     2191     end.
     2192   end procedure.
