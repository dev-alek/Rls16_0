     1807     (input  bf_trn-doc.obj-type
     1808     ,input  bf_trn-doc.obj-code
     1809     ,input  varb-code
     1810     ,input  0
     1811     ,input  bf_trn-doc.fact-order
     1812     ,output vardoc-num
     1813     ,output varprice-sale
     1814     ,output varroad-tax
     1815     ,output varexcise
     1816     )  .
     1817             if varprice-sale = ?
     1818             then do:
     1819               assign
     1820                 varprice-sale = 0
     1821                 varroad-tax   = 0
     1822                 varexcise     = 0
     1823               .
     1824             end.
     1825             assign
     1826               varlastcur-base     = varprice-sale
     1827               varlastcur-road-tax = varroad-tax
     1828               varlastcur-excise   = varexcise
     1829               varcur-base         = varcur-base      + varprice-sale * bf_gds-dtl.fact-qnty
     1830               varcur-road-tax     = varcur-road-tax  + varroad-tax   * bf_gds-dtl.fact-qnty
     1831               varcur-excise       = varcur-excise    + varexcise     * bf_gds-dtl.fact-qnty
     1832               varcur-fact-qnty    = varcur-fact-qnty + bf_gds-dtl.fact-qnty
     1833             .
     1834         end.
     1835       end.
     1836       if varcur-fact-qnty = 0 then do:
     1837         assign
     1838           varcur-base      = varlastcur-base
     1839           varcur-road-tax  = varlastcur-road-tax
     1840           varcur-excise    = varlastcur-excise
     1841         .
     1842       end.
     1843       else do:
     1844         assign
     1845           varcur-base      = varcur-base      / varcur-fact-qnty
     1846           varcur-road-tax  = varcur-road-tax  / varcur-fact-qnty
     1847           varcur-excise    = varcur-excise    / varcur-fact-qnty
     1848         .
     1849       end.
     1850       if varcur-vat-pc = ?
     1851       then do:
     1852         return error substitute ("Нет текущего продажного НДС по товару &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     1853       end.
