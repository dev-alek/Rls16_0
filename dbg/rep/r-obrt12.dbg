     1946   procedure clcprtsl_calc-ttable :
     1947   define input parameter paris-doc           as   logical                 no-undo.
     1948   define input parameter paris-cur           as   logical                 no-undo.
     1949   define input parameter parroad-tax         like ub.doc-line.road-tax    no-undo.
     1950   define input parameter parexcise           like ub.doc-line.excise      no-undo.
     1951   define input parameter parvat-pc           like ub.doc-line.vat-pc      no-undo.
     1952   define input parameter parcons-vat-pc      like ub.doc-line.cons-vat-pc no-undo.
     1953   define input parameter parslt-pc           like ub.doc-line.slt-pc      no-undo.
     1954   define input parameter parbase-rate        like ub.trn-doc.base-rate    no-undo.
     1955   define input parameter parbase-scale       like ub.trn-doc.base-scale   no-undo.
     1956   define input parameter parr-b              as   character               no-undo.
     1957   define input parameter parcur-base         like ub.gds-dtl.cur-base     no-undo.
     1958   define input parameter parcur-road-tax     like ub.doc-line.road-tax    no-undo.
     1959   define input parameter parcur-excise       like ub.doc-line.excise      no-undo.
     1960   define input parameter parcur-vat-pc       like ub.doc-line.vat-pc      no-undo.
     1961   define input parameter parcurcons-vat-pc   like ub.doc-line.cons-vat-pc no-undo.
     1962   define input parameter parcurslt-pc        like ub.doc-line.slt-pc      no-undo.
     1963   define buffer bf_tt-allsum      for tt-allsum.
     1964   define buffer bf_tt-clcparts    for tt-clcparts.
     1965   define buffer bf_tt-allsum-line for tt-allsum-line.
     1966   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     1967   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     1968   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     1969   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     1970   define variable varexcise          like ub.price-list.excise     no-undo.
     1971   do on error undo, return error return-value :
     1972   for each bf_tt-allsum-line
     1973   on error undo, return error return-value
     1974    :
     1975     delete bf_tt-allsum-line.
     1976   end.
     1977   for each bf_tt-allsum
     1978   on error undo, return error return-value
     1979   :
     1980     delete bf_tt-allsum.
     1981   end.
     1982   for each bf_tt-clcparts
     1983   on error undo, return error return-value
     1984   :
     1985   if v-calcbypart then do:
     1986             assign
     1987             parcur-base =   bf_tt-clcparts.part-cur-base
     1988             parcur-road-tax = bf_tt-clcparts.part-cur-road-tax
     1989             parcur-excise =   bf_tt-clcparts.part-cur-excise
     1990             .
     1991   end.
     1992      run clcprtsl_calc-parts in this-procedure (
     1993        input recid(bf_tt-clcparts),
     1994        input paris-doc,
     1995        input paris-cur,
     1996        input parroad-tax,
     1997        input parexcise,
     1998        input parvat-pc,
     1999        input parcons-vat-pc,
     2000        input parslt-pc,
     2001        input parbase-rate,
     2002        input parbase-scale,
     2003        input parr-b,
     2004        input parcur-base,
     2005        input parcur-road-tax,
     2006        input parcur-excise,
     2007        input parcur-vat-pc,
     2008        input parcurcons-vat-pc,
     2009        input parcurslt-pc
     2010        ) no-error.
     2011     if error-status:error then do:
     2012       message
     2013         vss-workfile vss-revision vss-description skip
     2014         vss-include-info0 skip
     2015         "Ошибка при обсчете партии" skip
     2016         "Документ партии " bf_tt-clcparts.out-code skip
     2017         "Товар" bf_tt-clcparts.artic bf_tt-clcparts.prod-type bf_tt-clcparts.prod-code skip
     2018         return-value skip
     2019         error-status:get-message(1) skip
     2020         error-status:get-message(2) skip
     2021         error-status:get-message(3) skip
     2022         view-as alert-box error .
     2023       undo, return error .
     2024     end.
     2025     for each bf_tt-allsum on error undo, return error return-value :
     2026       find first bf_tt-allsum-line where bf_tt-allsum-line.sum-type = bf_tt-allsum.sum-type no-error.
     2027       if not available bf_tt-allsum-line then do:
     2028         create bf_tt-allsum-line.
     2029         assign
     2030           bf_tt-allsum-line.sum-type = bf_tt-allsum.sum-type.
     2031       end.
     2032       assign
     2033         bf_tt-allsum-line.fact-qnty              = bf_tt-allsum-line.fact-qnty            + bf_tt-allsum.fact-qnty
     2034         bf_tt-allsum-line.cli-qnty               = bf_tt-allsum-line.cli-qnty             + bf_tt-allsum.cli-qnty
     2035         bf_tt-allsum-line.sum-dsc-base-doc       = bf_tt-allsum-line.sum-dsc-base-doc     + bf_tt-allsum.sum-dsc-base-doc
     2036         bf_tt-allsum-line.sum-dsc-rubl-doc       = bf_tt-allsum-line.sum-dsc-rubl-doc     + bf_tt-allsum.sum-dsc-rubl-doc
     2037         bf_tt-allsum-line.dsc-base-doc           = bf_tt-allsum-line.dsc-base-doc         + bf_tt-allsum.dsc-base-doc
     2038         bf_tt-allsum-line.dsc-rubl-doc           = bf_tt-allsum-line.dsc-rubl-doc         + bf_tt-allsum.dsc-rubl-doc
     2039         bf_tt-allsum-line.vat-base-doc           = bf_tt-allsum-line.vat-base-doc         + bf_tt-allsum.vat-base-doc
     2040         bf_tt-allsum-line.vat-rubl-doc           = bf_tt-allsum-line.vat-rubl-doc         + bf_tt-allsum.vat-rubl-doc
     2041         bf_tt-allsum-line.vat-base-buyer-doc     = bf_tt-allsum-line.vat-base-buyer-doc   + bf_tt-allsum.vat-base-buyer-doc
     2042         bf_tt-allsum-line.vat-rubl-buyer-doc     = bf_tt-allsum-line.vat-rubl-buyer-doc   + bf_tt-allsum.vat-rubl-buyer-doc
     2043         bf_tt-allsum-line.slt-base-doc           = bf_tt-allsum-line.slt-base-doc         + bf_tt-allsum.slt-base-doc
