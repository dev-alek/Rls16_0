      642   end.
      643   else do:
      644     for each out-vatp_partscl where out-vatp_partscl.out-code   = pardoc-code
      645                                  and out-vatp_partscl.obj-type   = parobj-type
      646                                  and out-vatp_partscl.obj-code   = parobj-code
      647                                  and out-vatp_partscl.artic      = parartic
      648                                  and out-vatp_partscl.prod-type  = parprod-type
      649                                  and out-vatp_partscl.prod-code  = parprod-code no-lock :
      650       if out-vatp_partscl.purch-code = 2 then do:
      651   assign
      652     price-rubl-with-tax-lococl = out-vatp_partscl.price-rubl
      653     price-base-with-tax-lococl = out-vatp_partscl.price-base
      654   .
      655   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      656   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      657     (output varinvprbocl
      658     )  .
      659     if out-vatp_partscl.out-code = 'free-zone':U     or
      660        out-vatp_partscl.out-code = 'out-zone':U   or
      661        out-vatp_partscl.doc-type = 'акт':U then do:
      662       assign
      663         in-vatp-have-vat-sltocl = yes.
      664     end.
      665     else do:
      666       find first in-vatp_doc-attrocl no-lock
      667         where in-vatp_doc-attrocl.doc-code  = out-vatp_partscl.out-code
      668           and in-vatp_doc-attrocl.attr-code = 'envd':U
      669         no-error .
      670       if not available in-vatp_doc-attrocl then do:
      671         assign
      672           in-vatp-have-vat-sltocl = yes.
      673       end.
      674       else do:
      675            in-vatp-have-vat-sltocl = no.
      676       end.
      677     end.
      678     assign
      679      price-cli-with-tax-lococl = out-vatp_partscl.price-cli
      680      cli-base-rateocl          = out-vatp_partscl.cli-base-rate.
      681     ASSIGN   road-tax-base-lococl  = (if out-vatp_partscl.road-tax-base  = ? then 0 else out-vatp_partscl.road-tax-base)
      682              road-tax-rubl-lococl  = (if out-vatp_partscl.road-tax-rubl  = ? then 0 else out-vatp_partscl.road-tax-rubl).
      683     ASSIGN  transport-base-lococl = (if out-vatp_partscl.transport-base = ? then 0 else out-vatp_partscl.transport-base)
      684             transport-rubl-lococl = (if out-vatp_partscl.transport-rubl = ? then 0 else out-vatp_partscl.transport-rubl)
      685             other-base-lococl     = (if out-vatp_partscl.other-base     = ? then 0 else out-vatp_partscl.other-base)
      686             other-rubl-lococl     = (if out-vatp_partscl.other-rubl     = ? then 0 else out-vatp_partscl.other-rubl)
      687             vat-pc-lococl         = (if out-vatp_partscl.vat-pc         = ? then 0 else out-vatp_partscl.vat-pc)
      688             slt-pc-lococl         = (if out-vatp_partscl.slt-pc         = ? then 0 else out-vatp_partscl.slt-pc).
      689             ASSIGN   slt-base-lococl    = (if in-vatp-have-vat-sltocl = no then 0 else (price-base-with-tax-lococl - ((if road-tax-base-lococl  = ? then 0 else road-tax-base-lococl) + (if transport-base-lococl = ? then 0 else transport-base-lococl) + (if other-base-lococl = ? then 0 else other-base-lococl)))                           * slt-pc-lococl / (100 + slt-pc-lococl))                        vat-base-lococl    = (if in-vatp-have-vat-sltocl = no then 0 else (price-base-with-tax-lococl - ((if road-tax-base-lococl  = ? then 0 else road-tax-base-lococl) + (if transport-base-lococl = ? then 0 else transport-base-lococl) + (if other-base-lococl = ? then 0 else other-base-lococl))) * (1 - slt-pc-lococl / (100 + slt-pc-lococl)) * vat-pc-lococl / (100 + vat-pc-lococl)).
      690       ASSIGN   slt-rubl-lococl    = (if in-vatp-have-vat-sltocl = no then 0 else (price-rubl-with-tax-lococl - ((if road-tax-rubl-lococl  = ? then 0 else road-tax-rubl-lococl) + (if transport-rubl-lococl = ? then 0 else transport-rubl-lococl) + (if other-rubl-lococl = ? then 0 else other-rubl-lococl)))                           * slt-pc-lococl / (100 + slt-pc-lococl))                        vat-rubl-lococl    = (if in-vatp-have-vat-sltocl = no then 0 else (price-rubl-with-tax-lococl - ((if road-tax-rubl-lococl  = ? then 0 else road-tax-rubl-lococl) + (if transport-rubl-lococl = ? then 0 else transport-rubl-lococl) + (if other-rubl-lococl = ? then 0 else other-rubl-lococl))) * (1 - slt-pc-lococl / (100 + slt-pc-lococl)) * vat-pc-lococl / (100 + vat-pc-lococl)).
      691     assign
      692       exch-rate-cli-lococl = (out-vatp_partscl.price-rubl - transport-rubl-lococl - other-rubl-lococl - road-tax-rubl-lococl - (if out-vatp_partscl.vat-type <> 'в т. ч.':U then vat-rubl-lococl else 0) - (if out-vatp_partscl.slt-type <> 'в т. ч.':U then slt-rubl-lococl else 0)) / out-vatp_partscl.price-cli .
      693     assign
      694       slt-cli-lococl        = slt-rubl-lococl       / exch-rate-cli-lococl
      695       vat-cli-lococl        = vat-rubl-lococl       / exch-rate-cli-lococl
      696       road-tax-cli-lococl   = road-tax-rubl-lococl  / exch-rate-cli-lococl
      697       transport-cli-lococl  = 0
      698       other-cli-lococl      = 0
      699     .
      700   ASSIGN
