      478   do on error undo, return error return-value :
      479   find first cl_tt-clcparts where recid(cl_tt-clcparts) = parrec-parts no-lock.
      480   for each bf_tt-allsum on error undo, return error return-value :
      481     delete bf_tt-allsum.
      482   end.
      483   assign
      484     price-rubl-with-tax-loccl = cl_tt-clcparts.price-rubl
      485     price-base-with-tax-loccl = cl_tt-clcparts.price-base
      486   .
      487   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      488   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      489     (output varinvprbcl
      490     )  .
      491     if cl_tt-clcparts.out-code = 'free-zone':U     or
      492        cl_tt-clcparts.out-code = 'out-zone':U   or
      493        cl_tt-clcparts.doc-type = 'акт':U then do:
      494       assign
      495         in-vatp-have-vat-sltcl = yes.
      496     end.
      497     else do:
      498       find first in-vatp_doc-attrcl no-lock
      499         where in-vatp_doc-attrcl.doc-code  = cl_tt-clcparts.out-code
      500           and in-vatp_doc-attrcl.attr-code = 'envd':U
      501         no-error .
      502       if not available in-vatp_doc-attrcl then do:
      503         assign
      504           in-vatp-have-vat-sltcl = yes.
      505       end.
      506       else do:
      507            in-vatp-have-vat-sltcl = no.
      508       end.
      509     end.
      510     assign
      511      price-cli-with-tax-loccl = cl_tt-clcparts.price-cli
      512      cli-base-ratecl          = cl_tt-clcparts.cli-base-rate.
      513     ASSIGN   road-tax-base-loccl  = (if cl_tt-clcparts.road-tax-base  = ? then 0 else cl_tt-clcparts.road-tax-base)
      514              road-tax-rubl-loccl  = (if cl_tt-clcparts.road-tax-rubl  = ? then 0 else cl_tt-clcparts.road-tax-rubl).
      515     ASSIGN  transport-base-loccl = (if cl_tt-clcparts.transport-base = ? then 0 else cl_tt-clcparts.transport-base)
      516             transport-rubl-loccl = (if cl_tt-clcparts.transport-rubl = ? then 0 else cl_tt-clcparts.transport-rubl)
      517             other-base-loccl     = (if cl_tt-clcparts.other-base     = ? then 0 else cl_tt-clcparts.other-base)
      518             other-rubl-loccl     = (if cl_tt-clcparts.other-rubl     = ? then 0 else cl_tt-clcparts.other-rubl)
      519             vat-pc-loccl         = (if cl_tt-clcparts.vat-pc         = ? then 0 else cl_tt-clcparts.vat-pc)
      520             slt-pc-loccl         = (if cl_tt-clcparts.slt-pc         = ? then 0 else cl_tt-clcparts.slt-pc).
      521             ASSIGN   slt-base-loccl    = (if in-vatp-have-vat-sltcl = no then 0 else (price-base-with-tax-loccl - ((if road-tax-base-loccl  = ? then 0 else road-tax-base-loccl) + (if transport-base-loccl = ? then 0 else transport-base-loccl) + (if other-base-loccl = ? then 0 else other-base-loccl)))                           * slt-pc-loccl / (100 + slt-pc-loccl))                        vat-base-loccl    = (if in-vatp-have-vat-sltcl = no then 0 else (price-base-with-tax-loccl - ((if road-tax-base-loccl  = ? then 0 else road-tax-base-loccl) + (if transport-base-loccl = ? then 0 else transport-base-loccl) + (if other-base-loccl = ? then 0 else other-base-loccl))) * (1 - slt-pc-loccl / (100 + slt-pc-loccl)) * vat-pc-loccl / (100 + vat-pc-loccl)).
      522       ASSIGN   slt-rubl-loccl    = (if in-vatp-have-vat-sltcl = no then 0 else (price-rubl-with-tax-loccl - ((if road-tax-rubl-loccl  = ? then 0 else road-tax-rubl-loccl) + (if transport-rubl-loccl = ? then 0 else transport-rubl-loccl) + (if other-rubl-loccl = ? then 0 else other-rubl-loccl)))                           * slt-pc-loccl / (100 + slt-pc-loccl))                        vat-rubl-loccl    = (if in-vatp-have-vat-sltcl = no then 0 else (price-rubl-with-tax-loccl - ((if road-tax-rubl-loccl  = ? then 0 else road-tax-rubl-loccl) + (if transport-rubl-loccl = ? then 0 else transport-rubl-loccl) + (if other-rubl-loccl = ? then 0 else other-rubl-loccl))) * (1 - slt-pc-loccl / (100 + slt-pc-loccl)) * vat-pc-loccl / (100 + vat-pc-loccl)).
      523     assign
      524       exch-rate-cli-loccl = (cl_tt-clcparts.price-rubl - transport-rubl-loccl - other-rubl-loccl - road-tax-rubl-loccl - (if cl_tt-clcparts.vat-type <> 'в т. ч.':U then vat-rubl-loccl else 0) - (if cl_tt-clcparts.slt-type <> 'в т. ч.':U then slt-rubl-loccl else 0)) / cl_tt-clcparts.price-cli .
      525     assign
      526       slt-cli-loccl        = slt-rubl-loccl       / exch-rate-cli-loccl
      527       vat-cli-loccl        = vat-rubl-loccl       / exch-rate-cli-loccl
      528       road-tax-cli-loccl   = road-tax-rubl-loccl  / exch-rate-cli-loccl
      529       transport-cli-loccl  = 0
      530       other-cli-loccl      = 0
      531     .
      532   ASSIGN
      533             price-base-without-tax-loccl = price-base-with-tax-loccl - vat-base-loccl - slt-base-loccl - ((if road-tax-base-loccl  = ? then 0 else road-tax-base-loccl) + (if transport-base-loccl = ? then 0 else transport-base-loccl) + (if other-base-loccl = ? then 0 else other-base-loccl))
      534       price-rubl-without-tax-loccl = price-rubl-with-tax-loccl - vat-rubl-loccl - slt-rubl-loccl - ((if road-tax-rubl-loccl  = ? then 0 else road-tax-rubl-loccl) + (if transport-rubl-loccl = ? then 0 else transport-rubl-loccl) + (if other-rubl-loccl = ? then 0 else other-rubl-loccl))
      535   .
      536   if paris-doc then do:
      537     assign
      538       parartic     = cl_tt-clcparts.artic
      539       parprod-type = cl_tt-clcparts.prod-type
      540       parprod-code = cl_tt-clcparts.prod-code
      541       pardoc-type  = cl_tt-clcparts.doc-type
      542       pardoc-code  = cl_tt-clcparts.out-code
      543       parobj-type  = cl_tt-clcparts.obj-type
      544       parobj-code  = cl_tt-clcparts.obj-code.
      545   if parext-doc-type = 'ot':U or
      546      parext-doc-type = ?                 then do:
      547     assign
      548      out-vatp-have-vat-sltcl = yes.
      549   end.
      550   else do:
      551     find first out-vatp_doc-attrcl no-lock
      552       where out-vatp_doc-attrcl.doc-code  = pardoc-code
      553         and out-vatp_doc-attrcl.attr-code = 'envd':U
      554         no-error .
      555     if not available out-vatp_doc-attrcl then do:
      556       assign
      557         out-vatp-have-vat-sltcl = yes.
      558     end.
      559     else do:
      560        out-vatp-have-vat-sltcl = no.
      561     end.
      562   end.
      563   find first out-vatp_goodscl where out-vatp_goodscl.artic     = parartic     and
      564                                      out-vatp_goodscl.prod-type = parprod-type and
      565                                      out-vatp_goodscl.prod-code = parprod-code no-lock.
      566   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      567   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rootnode in g#library
      568     (input  parartic
      569     ,input  parprod-type
      570     ,input  parprod-code
      571     ,output varroot-nodecl
      572     ) no-error .
      573   if error-status :error then do:
      574     message
      575       vss-workfile vss-revision vss-description skip
      576       "Ошибка при определении корневого признака товара" skip
      577       "Артикул" parartic parprod-type parprod-code skip
      578       error-status :get-message(1) skip
      579       return-value skip
      580       view-as alert-box error .
      581     undo, return error .
      582   end.
      583   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prtat in g#library
      584     (input  varroot-nodecl
      585     ,input  'empty-scale=request'
      586     ,output varempty-scalecl
      587     ) no-error .
      588   if error-status :error then do:
      589     message
      590       vss-workfile vss-revision vss-description skip
      591       "Ошибка при определении атрибута признака" skip
      592       "Артикул" parartic parprod-type parprod-code skip
      593       "Признак" varroot-nodecl skip
      594       "Запрашивался атрибут" "empty-scale=request" skip
      595       error-status :get-message(1) skip
      596       return-value skip
      597       view-as alert-box error .
      598     undo, return error .
      599   end.
      600   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      601   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      602     (output varoutvprbcl
      603     )  .
      604   if varoutvprbcl = "base":u then do:
      605     assign
      606           road-tax-base-salecl    =  (if parroad-tax = ? then 0 else parroad-tax * 1)
      607       excise-base-salecl      =  (if parexcise   = ? then 0 else parexcise   * 1)
      608     .
      609   end.
      610   else do:
      611     assign
      612           road-tax-base-salecl    =  (if parroad-tax = ? then 0 else parroad-tax / parbase-rate * parbase-scale)
      613       excise-base-salecl      =  (if parexcise   = ? then 0 else parexcise   / parbase-rate * parbase-scale)
      614     .
      615   end.
      616   if varoutvprbcl = "rubl":u then do:
      617     assign
      618           road-tax-rubl-salecl    = (if parroad-tax = ? then 0 else parroad-tax * 1)
      619       excise-rubl-salecl      = (if parexcise   = ? then 0 else parexcise   * 1) .
      620   end.
      621   else do:
      622     assign
      623           road-tax-rubl-salecl    = (if parroad-tax = ? then 0 else parroad-tax * parbase-rate / parbase-scale)
      624       excise-rubl-salecl      = (if parexcise   = ? then 0 else parexcise   * parbase-rate / parbase-scale) .
      625   end.
      626   assign
      627     varis-cons-parts-havecl =  no.
      628   assign
      629     varfact-qntycl       = 0
      630     varcons-qntycl       = 0
      631     varprice-base-conscl = 0
      632     varprice-rubl-conscl = 0.
      633   find first out-vatp_doc-linecl where
      634              out-vatp_doc-linecl.doc-code   = pardoc-code
      635          and out-vatp_doc-linecl.artic      = parartic
      636          and out-vatp_doc-linecl.prod-type  = parprod-type
      637          and out-vatp_doc-linecl.prod-code  = parprod-code no-lock no-error.
      638   if available out-vatp_doc-linecl           and
      639     (out-vatp_doc-linecl.status_ = 'запрос':U or out-vatp_goodscl.gds-type = 'у':U) then do:
      640     assign
