      733     varslt-base-docovpcl      = 0
      734     varvat-base-docovpcl      = 0
      735     varvatcons-base-docovpcl  = 0
      736     vardsc-base-docovpcl      = 0
      737     varsum-rubl-factovpcl     = 0
      738     varslt-rubl-factovpcl     = 0
      739     varvat-rubl-factovpcl     = 0
      740     varvatcons-rubl-factovpcl = 0
      741     vardsc-rubl-factovpcl     = 0
      742     varsum-rubl-docovpcl      = 0
      743     varslt-rubl-docovpcl      = 0
      744     varvat-rubl-docovpcl      = 0
      745     varvatcons-rubl-docovpcl  = 0
      746     vardsc-rubl-docovpcl      = 0.
      747   assign
      748     varis-one-gds-dtlcl = no.
      749   find first out-vatp_gds-dtlcl where out-vatp_gds-dtlcl.doc-code  = pardoc-code  and
      750                                        out-vatp_gds-dtlcl.artic     = parartic     and
      751                                        out-vatp_gds-dtlcl.prod-type = parprod-type and
      752                                        out-vatp_gds-dtlcl.prod-code = parprod-code no-lock no-error.
      753   if available out-vatp_gds-dtlcl then do:
      754     find first buf_out-vatp_gds-dtlcl where buf_out-vatp_gds-dtlcl.doc-code  =  pardoc-code                and
      755                                              buf_out-vatp_gds-dtlcl.artic     =  parartic                   and
