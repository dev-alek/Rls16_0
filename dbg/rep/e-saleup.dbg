      842          "Object ":U THIS-PROCEDURE:FILE-NAME
      843            "must have at least one Enabled Table to perform Assign.":U
      844              VIEW-AS ALERT-BOX ERROR.
      845      RETURN.
      846     END PROCEDURE.
      847   PROCEDURE adm-assign-statement :
      848     RETURN.
      849   END PROCEDURE.
      850   PROCEDURE adm-cancel-record :
      851      RETURN.
      852     END PROCEDURE.
      853   PROCEDURE adm-copy-record :
      854       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
      855        "must have at least one Enabled Table to perform Copy.":U
      856          VIEW-AS ALERT-BOX ERROR.
      857       RETURN.
      858   END PROCEDURE.
      859   PROCEDURE adm-create-record :
      860      RETURN.
      861   END PROCEDURE.
      862   PROCEDURE adm-current-changed :
      863     RETURN.
      864   END PROCEDURE.
      865   PROCEDURE adm-delete-record :
      866    MESSAGE
      867          "Object ":U THIS-PROCEDURE:FILE-NAME
      868            "must have at least one Enabled Table to perform Delete.":U
      869              VIEW-AS ALERT-BOX ERROR.
      870       RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
      871       RETURN.
