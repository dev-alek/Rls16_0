      877   PROCEDURE adm-enable-fields :
      878       RETURN.
      879   END PROCEDURE.
      880   PROCEDURE adm-end-update :
      881     RETURN.
      882   END PROCEDURE.
      883   PROCEDURE adm-reset-record :
      884       RETURN.
