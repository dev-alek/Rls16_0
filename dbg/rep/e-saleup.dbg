      886   PROCEDURE adm-update-record :
      887       MESSAGE
      888         "Object ":U THIS-PROCEDURE:FILE-NAME
      889           "must have at least one Enabled Table to perform Update.":U
      890             VIEW-AS ALERT-BOX ERROR.
      891      RETURN.
      892   END PROCEDURE.
      893   PROCEDURE check-modified :
      894   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
      895   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
      896   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
      897   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
      898     IF check-state = "check":U THEN
      899     DO:
      900       RUN get-link-handle IN adm-broker-hdl
      901         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
      902            OUTPUT group-target-list).
      903       IF group-target-list NE "":U THEN
      904       DO i = 1 TO NUM-ENTRIES(group-target-list):
      905         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
      906         RUN check-modified IN curr-widget ('group-check':U).
      907         IF RETURN-VALUE NE "":U THEN
      908         DO:
      909           RUN check-modified-message(RETURN-VALUE).
      910           RETURN "":U.
      911         END.
      912       END.
      913     END.
      914     RETURN "":U.
      915   END PROCEDURE.
      916   PROCEDURE check-modified-message :
      917     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
      918        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
      919           'CONTAINER-SOURCE':U, 'HIDDEN':U).
      920        IF RETURN-VALUE = "YES":U THEN
      921           RUN notify ('view,CONTAINER-SOURCE':U).
      922        MESSAGE IF p-changed-table NE ? THEN
      923           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
      924           ELSE "Current values have been changed."
      925           SKIP "  Do you wish to save those changes?"
      926           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
      927        IF ANS THEN
      928        DO:
      929           IF group-assign-target THEN
      930             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
      931           ELSE RUN dispatch('update-record':U).
      932           IF RETURN-VALUE = "ADM-ERROR":U THEN
      933           DO:
      934               MESSAGE "Changes to the previous record were not saved."
      935                 VIEW-AS ALERT-BOX ERROR.
      936               IF group-assign-target THEN
      937                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
      938               ELSE RUN dispatch ('cancel-record':U).
      939           END.
      940        END.
      941        ELSE DO:
      942          IF group-assign-target THEN
      943             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
      944          ELSE RUN dispatch('cancel-record':U).
      945        END.
      946        RETURN.
      947   END PROCEDURE.
      948   PROCEDURE get-rowid :
      949       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
      950       ASSIGN
      951       p-table   =   adm-first-table.
      952       RETURN.
      953   END PROCEDURE.
      954   PROCEDURE init-group-assign :
      955       RUN request-attribute IN adm-broker-hdl
      956         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
      957       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
      958         group-assign-target = yes.
      959       ELSE group-assign-target = no.
      960       RETURN.
      961   END PROCEDURE.
      962   PROCEDURE set-editors :
      963       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
      964       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
      965       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
      966       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
      967       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
      968       DO WHILE VALID-HANDLE (curr-widget):
      969           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
      970              curr-widget:HIDDEN = no THEN DO:
      971             CASE p-field-setting:
      972               WHEN "INITIALIZE":U THEN
      973               DO:
      974                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
      975                     read-only-list +
      976                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
      977                        STRING(curr-widget).
      978               END.
      979               WHEN "DISABLE":U OR
      980               WHEN "ENABLE":U THEN
      981               DO:
      982                   curr-widget:SENSITIVE = yes.
      983                   RUN get-attribute ('Read-Only-Editors':U).
      984                   IF RETURN-VALUE = ? OR
      985                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
      986                       curr-widget:READ-ONLY =
      987                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
      988               END.
      989               WHEN "CLEAR":U THEN
      990                   curr-widget:SCREEN-VALUE = "":U.
      991             END CASE.
      992           END.
      993           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
      994       END.
      995       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
      996         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
      997           + '"':U).
      998       RETURN.
      999   END PROCEDURE.
     1000   PROCEDURE use-check-modified-all :
     1001    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1002     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
     1003     RETURN.
     1004   END PROCEDURE.
     1005   PROCEDURE use-create-on-add :
     1006   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1007      RETURN.
     1008   END PROCEDURE.
     1009   PROCEDURE use-initial-lock :
     1010     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1011     ASSIGN adm-initial-lock = p-attr-value.
     1012     RETURN.
     1013   END PROCEDURE.
     1014     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
     1015   ASSIGN
     1016          FRAME F-Main:SCROLLABLE       = FALSE
     1017          FRAME F-Main:HIDDEN           = TRUE.
     1018   if not this-procedure :persistent
     1019   then do:
     1020     message
     1021       vss-workfile vss-revision vss-description skip
     1022       "Ошибка при запуске процедуры" skip
     1023       "Данную процедуру следует запускать только с параметром persistent" skip
     1024       view-as alert-box error .
     1025     undo, return error .
     1026   end.
     1027   PROCEDURE disable_UI :
     1028     HIDE FRAME F-Main.
     1029     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1030   END PROCEDURE.
     1031   PROCEDURE local-apply-layout :
     1032     RUN dispatch IN THIS-PROCEDURE ( INPUT 'apply-layout':U ) .
     1033   END PROCEDURE.
     1034   PROCEDURE my-report :
     1035     run rep/r-saleup.p (input my-handle, input SortType, input Classify, input tog-razd-obj) .
     1036   END PROCEDURE.
     1037   PROCEDURE my-var :
     1038     Assign frame F-Main  SortType Classify tog-razd-obj .
     1039     Assign
     1040       STR-obj-type = ''
     1041       STR-obj-code = ''
     1042       STR-obj-name = ''
     1043       STR-obj      = ''
     1044       str1 = "Отчет сформирован " + string(TODAY, "99/99/9999")
     1045       str4 = "На дату : "
     1046       str3 = "Классификация : "
     1047     .
     1048     if x-date-start = x-date-end then str4 = str4 + string(x-date-start, "99/99/9999") .
     1049     else                              str4 = str4 + "c " + string(x-date-start, "99/99/9999") + " по " + string(x-date-end, "99/99/9999") .
     1050     For each obj-list no-lock:
     1051       Assign
     1052         STR-obj-type = STR-obj-type + obj-list.obj-type + ','
     1053         STR-obj-code = STR-obj-code + String(obj-list.obj-code) + ','
     1054         STR-obj-name = STR-obj-name + obj-list.obj-name + ','
     1055         STR-obj = STR-obj +  obj-list.obj-type + '#' + string(obj-list.obj-code)  + ','
     1056       .
     1057     End.
     1058     CASE Classify:
     1059       WHEN 1 THEN str3 = str3 + "Без классификации" .
     1060       WHEN 2 THEN str3 = str3 + "Производители"   .
     1061       WHEN 3 THEN str3 = str3 + "Группы товаров"  .
     1062       WHEN 4 THEN str3 = str3 + "Производители/Группы товаров" .
     1063       WHEN 5 THEN str3 = str3 + "Группы товаров/Производители" .
     1064     End case.
     1065     assign  str3 = str3 + "  Сортировка : " .
     1066     CASE SORTtype:
     1067       WHEN 1 THEN str3 = str3 + "по коду" .
     1068       WHEN 2 THEN str3 = str3 + "по артикулу"  .
     1069       WHEN 3 THEN str3 = str3 + "по наименованию".
     1070     End case.
     1071   END PROCEDURE.
     1072   PROCEDURE state-changed :
     1073     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE    NO-UNDO.
     1074     DEFINE INPUT PARAMETER p-state      AS CHARACTER NO-UNDO.
     1075     CASE p-state:
     1076       when "link-changed":U then  DO:
     1077            Run my-var.
     1078            End.
     1079     END CASE.
     1080   END PROCEDURE.
