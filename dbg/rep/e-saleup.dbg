      568   define new global shared variable g#library  as handle no-undo .
      569   define new global shared variable g#library2 as handle no-undo .
      570   define variable var-report-r-b as character no-undo .
      571   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      572   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      573     (output var-report-r-b
      574     )  .
      575   procedure proc-alt-shift-f2:
      576     if not ibs.th.gbl.gbl-var:rcode
      577   then
      578     run gbl\inidebug.p .
      579   end.
      580   procedure proc-alt-shift-f3:
      581     run gbl/prvssinf.p
      582       ( input this-procedure
      583       ) .
      584   end.
      585   define variable v-inform-launched as logical no-undo initial false .
      586   procedure proc-alt-shift-f4:
      587     define variable v-action as character no-undo .
      588     if v-inform-launched = false then do:
      589       assign
      590         v-inform-launched = true
      591       .
      592       run gbl/d-inform.w
      593         (  input self
      594         ,  input this-procedure
      595         , output v-action
      596         ) no-error .
      597       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      598       assign
      599         v-inform-launched = false
      600       .
      601     end.
      602   end.
      603   procedure proc-alt-f1:
      604     run gbl/corrhelp.p
      605       (input this-procedure
      606       ) .
      607   end .
      608   on alt-shift-f2 anywhere do:
      609     run proc-alt-shift-f2.
      610   end.
      611   on alt-shift-f3 anywhere do:
      612     run proc-alt-shift-f3 in this-procedure .
      613   end.
      614   on alt-shift-f4 anywhere do:
      615     run proc-alt-shift-f4 in this-procedure.
      616   end.
      617   on alt-f1 anywhere do:
      618     run proc-alt-f1 in this-procedure .
      619   end.
      620   DEFINE VARIABLE Classify AS INTEGER
      621        VIEW-AS RADIO-SET VERTICAL
      622        RADIO-BUTTONS
      623             "Без классификации", 1,
      624   "Производители", 2,
      625   "Группы товаров", 3,
      626   "Производители/Группы товаров", 4,
      627   "Группы товаров/Производители", 5
      628        SIZE 33.2 BY 6.29 NO-UNDO.
      629   DEFINE VARIABLE SortType AS INTEGER
      630        VIEW-AS RADIO-SET VERTICAL
      631        RADIO-BUTTONS
      632             "по коду", 1,
      633   "по артикулу", 2,
      634   "по наименованию", 3
      635        SIZE 33.2 BY 3.52 NO-UNDO.
      636   DEFINE RECTANGLE RECT-6
      637        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      638        SIZE 34.8 BY 5.5.
      639   DEFINE RECTANGLE RECT-7
      640        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      641        SIZE 38.2 BY 8.1.
      642   DEFINE RECTANGLE RECT-8
      643        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      644        SIZE 38.2 BY 1.8.
      645   DEFINE VARIABLE tog-razd-obj AS LOGICAL INITIAL no
      646        LABEL "Раздельно по объектам"
      647        VIEW-AS TOGGLE-BOX
      648        SIZE 35 BY 1.2 NO-UNDO.
      649   DEFINE FRAME F-Main
      650        Classify AT ROW 2.52 COL 4.4 NO-LABEL
      651        SortType AT ROW 2.52 COL 42.6 NO-LABEL
      652        tog-razd-obj AT ROW 9.81 COL 4.2 WIDGET-ID 2
      653        "Сортировка :" VIEW-AS TEXT
      654             SIZE 13.6 BY .76 AT ROW 1.43 COL 42.6
      655             FGCOLOR 4
      656        "Классификация :" VIEW-AS TEXT
      657             SIZE 35 BY .76 AT ROW 1.43 COL 4.2
      658             FGCOLOR 4
      659        RECT-7 AT ROW 1.15 COL 2.6
      660        RECT-8 AT ROW 9.48 COL 2.6
      661        RECT-6 AT ROW 1.15 COL 41.6
      662       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
      663            SIDE-LABELS NO-UNDERLINE THREE-D
      664            AT COL 1 ROW 1 SCROLLABLE .
      665   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
      666   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
      667   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
      668   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
      669   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
      670   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
      671   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
      672   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
      673         adm-object-hdl = FRAME F-Main:HANDLE.
      674   RUN ensure-broker.
      675   THIS-PROCEDURE:ADM-DATA =
      676        'ADM1.1~`':U +
      677        'SmartObject~`':U +
      678        '~`':U +
      679        'NO ~`':U +
      680        '~`':U +
      681        '~`':U +
      682        '~`':U +
      683        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
      684           + "~`":U +
      685        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add~`':U +
      686        'Record-Source,Record-Target,TableIO-Target~`':U +
      687        '~`':U +
      688        '~`~`~`~`~`~`~`~`~`~`~`':U +
      689        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
      690            THEN "^^":U
      691        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
      692             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
      693   PROCEDURE adm-apply-entry :
      694     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      695   END PROCEDURE.
      696   PROCEDURE adm-destroy :
      697    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      698   END PROCEDURE.
      699   PROCEDURE adm-disable :
      700       DISABLE RECT-7 RECT-8 RECT-6 Classify SortType tog-razd-obj WITH FRAME F-Main.
      701       RUN dispatch ('disable-fields':U).
      702       RUN set-attribute-list ('ENABLED=no':U).
      703       RETURN.
      704   END PROCEDURE.
      705   PROCEDURE adm-edit-attribute-list :
      706         RUN adm/support/viewerd.w (INPUT THIS-PROCEDURE).
      707         RETURN.
      708   END PROCEDURE.
      709   PROCEDURE adm-enable :
      710       ENABLE UNLESS-HIDDEN RECT-7 RECT-8 RECT-6 Classify SortType tog-razd-obj WITH FRAME F-Main.
      711       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
      712       RUN set-attribute-list ('ENABLED=yes':U).
      713       RETURN.
      714   END PROCEDURE.
      715   PROCEDURE adm-exit :
      716        RUN notify ('exit':U).
      717     RETURN.
      718   END PROCEDURE.
      719   PROCEDURE adm-hide :
      720     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      721   END PROCEDURE.
      722   PROCEDURE adm-initialize :
      723     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      724   END PROCEDURE.
      725   PROCEDURE adm-show-errors :
      726       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
      727       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
      728           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
      729       END.
      730       RETURN.
      731   END PROCEDURE.
      732   PROCEDURE adm-UIB-mode :
      733     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      734   END PROCEDURE.
      735   PROCEDURE adm-view :
      736     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      737   END PROCEDURE.
      738   PROCEDURE dispatch :
      739       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
      740       RUN broker-dispatch IN adm-broker-hdl
      741           (THIS-PROCEDURE, p-method-name) NO-ERROR.
      742       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
      743   END PROCEDURE.
      744   PROCEDURE ensure-broker :
      745   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
      746   IF RETURN-VALUE NE "ADM-Broker":U THEN
      747   DO:
      748       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
      749       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
      750   END.
      751   END PROCEDURE.
      752   PROCEDURE get-attribute :
      753     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
      754     RUN broker-get-attribute IN adm-broker-hdl
      755         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
      756     RETURN RETURN-VALUE.
      757   END PROCEDURE.
      758   PROCEDURE get-attribute-list :
      759     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
      760     RUN broker-get-attribute-list IN adm-broker-hdl
      761         (INPUT THIS-PROCEDURE,
      762          INPUT ?,
      763          OUTPUT p-attr-list) NO-ERROR.
      764     RETURN.
      765   END PROCEDURE.
      766   PROCEDURE new-state :
      767     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
      768     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
      769     RETURN.
      770   END PROCEDURE.
      771   PROCEDURE notify :
      772     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
      773     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
      774     IF RETURN-VALUE = "ADM-ERROR":U THEN
      775         RETURN "ADM-ERROR":U.
      776     RETURN.
      777   END PROCEDURE.
      778   PROCEDURE set-attribute-list :
      779     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
      780     RUN ensure-broker.
      781     RUN broker-set-attribute-list IN adm-broker-hdl
      782         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
      783     RETURN.
      784   END PROCEDURE.
      785   PROCEDURE set-position :
      786       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
      787       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
      788       IF VALID-HANDLE(adm-object-hdl) THEN
      789       DO:
      790         ASSIGN adm-object-hdl:ROW    =   p-row
      791                adm-object-hdl:COLUMN =   p-col.
      792       END.
      793       RETURN.
      794   END PROCEDURE.
      795   PROCEDURE adm-display-fields :
      796       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
      797       RETURN.
      798   END PROCEDURE.
      799   PROCEDURE adm-open-query :
      800     RETURN.
      801   END PROCEDURE.
      802   PROCEDURE adm-row-changed :
      803         IF VALID-HANDLE(adm-object-hdl) THEN
      804           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
      805         RUN notify ('row-available':U).
      806         RETURN.
      807   END PROCEDURE.
      808   PROCEDURE reposition-query :
      809       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
      810       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
      811       RETURN.
      812   END PROCEDURE.
      813     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
      814     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
      815     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
      816     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
      817     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
      818     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
      819     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
      820     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
      821     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
      822     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
      823     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
      824     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
      825     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
      826     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
      827     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
      828     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
      829     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
      830     IF "":U = "":U THEN
      831       RUN modify-list-attribute IN adm-broker-hdl
      832         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
      833     RUN use-create-on-add(?).
      834   PROCEDURE adm-add-record :
      835       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
      836          "must have at least one Enabled Table to perform Add.":U
      837          VIEW-AS ALERT-BOX ERROR.
      838       RETURN.
      839   END PROCEDURE.
      840   PROCEDURE adm-assign-record :
