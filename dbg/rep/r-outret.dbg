     5744   define variable gp-doc-num    like ub.price-list.doc-num    no-undo.
     5745   define variable gp-price-sale like ub.price-list.price-sale no-undo.
     5746   define variable gp-road-tax   like ub.price-list.road-tax   no-undo.
     5747   define variable gp-excise     like ub.price-list.excise     no-undo.
     5748   define variable gp-b-code     like ub.bar-code.b-code       no-undo.
     5749   define variable gp-fact-order as decimal   no-undo .
     5750   define variable gp-price-sale-parts as decimal   no-undo .
     5751   do
