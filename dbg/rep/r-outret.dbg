     1078       .
     1079   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1080   empty temp-table thbjattr_thbj-attr.
     1081   run adm/shattri.p (
     1082      input "get":U
     1083     ,input ''
     1084     ,input 0
     1085     ,input 'prt-glob':U
     1086     ,input  ""
     1087     ,output v-value-character
