     1604   procedure torgconf-get-sup-param :
     1605   define input parameter p-obj-type           as character        no-undo.
     1606   define input parameter p-obj-code           as integer          no-undo.
     1607   define input parameter p-curr-code          as integer          no-undo.
     1608       define variable v-host-code    as integer      no-undo.
     1609       define variable v-par-type     as character    no-undo.
     1610   do
     1611   on error undo, return error
     1612   :
     1613       assign
     1614          v-torgconf-sup-host-code = v-host-code
     1615       .
     1616       if v-torgconf-sup-host-code = 0
     1617       then do:
     1618           assign
     1619               v-torgconf-sup-host-name           = "":U
     1620               v-torgconf-sup-host-addres         = "":U
     1621               v-torgconf-sup-host-post-addres    = "":U
     1622               v-torgconf-sup-host-phone          = "":U
     1623               v-torgconf-sup-host-inn            = "":U
     1624               v-torgconf-sup-host-kpp            = "":U
     1625               v-torgconf-sup-host-okpo           = "":U
     1626               v-torgconf-sup-host-egrip-date     = "":U
     1627               v-torgconf-sup-host-egrip-num      = "":U
     1628           .
     1629       end.
     1630       else do:
     1631           run fmtcli-get-client in this-procedure (
     1632                 input 'орг':U
     1633               , input v-torgconf-sup-host-code
     1634           ).
     1635           assign
     1636               v-torgconf-sup-host-name        = v-fmtcli-name
     1637               v-torgconf-sup-host-engl-name   = v-fmtcli-engl-name
     1638               v-torgconf-sup-host-addres      = v-fmtcli-full-addres
     1639               v-torgconf-sup-host-post-addres = v-fmtcli-post-addres
     1640               v-torgconf-sup-host-phone       = v-fmtcli-phone
     1641               v-torgconf-sup-host-inn         = v-fmtcli-inn
     1642               v-torgconf-sup-host-kpp         = v-fmtcli-kpp
     1643               v-torgconf-sup-host-okpo        = v-fmtcli-okpo
     1644           .
     1645           run gbl/clntat-v.p (
     1646                 input 'орг':U
     1647               , input v-torgconf-sup-host-code
     1648               , input 'egrip-date':U
     1649               , output v-torgconf-sup-host-egrip-date
     1650               , output v-par-type
     1651           ).
     1652           run gbl/clntat-v.p (
     1653                 input 'орг':U
     1654               , input v-torgconf-sup-host-code
     1655               , input 'egrip-num':U
     1656               , output v-torgconf-sup-host-egrip-num
     1657               , output v-par-type
     1658           ).
     1659           run fmtcli-get-bank in this-procedure (
     1660                 input v-host-code
     1661               , input 'орг':U
     1662               , input v-torgconf-sup-host-code
     1663               , input p-curr-code
     1664           ).
     1665       end.
     1666       assign
     1667           v-torgconf-sup-schet-exists = v-fmtcli-schet-exists
     1668           v-torgconf-sup-bank-exists  = v-fmtcli-bank-exists
     1669           v-torgconf-sup-bank-r-schet = v-fmtcli-bank-r-schet
     1670           v-torgconf-sup-bank-c-schet = v-fmtcli-bank-c-schet
     1671           v-torgconf-sup-bank-bik     = v-fmtcli-bank-bik
     1672           v-torgconf-sup-bank-name    = v-fmtcli-bank-name
     1673           v-torgconf-sup-bank-addres  = v-fmtcli-bank-addres
     1674           v-torgconf-sup-bank-city    = v-fmtcli-bank-city
     1675       .
     1676       assign
     1677           v-torgconf-sup-obj-type = p-obj-type
     1678           v-torgconf-sup-obj-code = p-obj-code
     1679       .
     1680       if trim(p-obj-type) <> ""
     1681       and p-obj-code <> 0
     1682       then do:
     1683       run fmtcli-get-client in this-procedure (
     1684             input p-obj-type
     1685           , input p-obj-code
     1686       ).
     1687       assign
     1688           v-torgconf-sup-obj-name        = v-fmtcli-name
     1689           v-torgconf-sup-obj-engl-name   = v-fmtcli-engl-name
     1690           v-torgconf-sup-obj-addres      = v-fmtcli-full-addres
     1691           v-torgconf-temp-post-addres    = v-fmtcli-post-addres
     1692           v-torgconf-sup-obj-phone       = v-fmtcli-phone
     1693           v-torgconf-sup-obj-inn         = v-fmtcli-inn
     1694           v-torgconf-sup-obj-okpo        = v-fmtcli-okpo
     1695       .
     1696      end.
     1697      end.
     1698   end procedure.
     1699   procedure torgconf-get-cli-param :
     1700   define input parameter p-host-obj-code      as integer          no-undo.
     1701   define input parameter p-obj-type           as character        no-undo.
     1702   define input parameter p-obj-code           as integer          no-undo.
     1703   define input parameter p-curr-code          as integer          no-undo.
     1704       define variable v-host-code    as integer      no-undo.
     1705   do
     1706   on error undo, return error
     1707   :
     1708       assign
     1709           v-torgconf-cli-type = p-obj-type
     1710           v-torgconf-cli-code = p-obj-code
     1711       .
     1712       run fmtcli-get-client in this-procedure (
     1713             input p-obj-type
     1714           , input p-obj-code
     1715       ).
     1716       assign
     1717           v-torgconf-cli-name         = trim( v-fmtcli-name          )
     1718           v-torgconf-cli-engl-name    = trim( v-fmtcli-engl-name          )
     1719           v-torgconf-cli-addres       = trim( v-fmtcli-full-addres   )
     1720           v-torgconf-cli-post-addres  = trim( v-fmtcli-post-addres   )
     1721           v-torgconf-cli-phone        = trim( v-fmtcli-phone         )
     1722           v-torgconf-cli-inn          = trim( v-fmtcli-inn           )
     1723           v-torgconf-cli-kpp          = trim( v-fmtcli-kpp           )
     1724           v-torgconf-cli-okpo         = trim( v-fmtcli-okpo          )
     1725       .
     1726      run fmtcli-get-bank in this-procedure (
     1727             input p-host-obj-code
     1728           , input p-obj-type
     1729           , input p-obj-code
     1730           , input p-curr-code
     1731       ).
     1732       assign
     1733           v-torgconf-cli-schet-exists = v-fmtcli-schet-exists
     1734           v-torgconf-cli-bank-exists  = v-fmtcli-bank-exists
     1735           v-torgconf-cli-bank-r-schet = v-fmtcli-bank-r-schet
     1736           v-torgconf-cli-bank-c-schet = v-fmtcli-bank-c-schet
     1737           v-torgconf-cli-bank-bik     = v-fmtcli-bank-bik
     1738           v-torgconf-cli-bank-name    = v-fmtcli-bank-name
     1739           v-torgconf-cli-bank-addres  = v-fmtcli-bank-addres
     1740           v-torgconf-cli-bank-city    = v-fmtcli-bank-city
     1741       .
     1742   end.
     1743   end procedure.
     1744   procedure torgconf-get-ship-param :
     1745   define input parameter p-host-obj-code      as integer          no-undo.
     1746   define input parameter p-obj-type           as character        no-undo.
     1747   define input parameter p-obj-code           as integer          no-undo.
     1748   define input parameter p-curr-code          as integer          no-undo.
     1749       define variable v-host-code    as integer      no-undo.
     1750   do
     1751   on error undo, return error
     1752   :
     1753       assign
     1754           v-torgconf-ship-type = p-obj-type
     1755           v-torgconf-ship-code = p-obj-code
     1756       .
     1757       if trim(p-obj-type) = ""
     1758       and p-obj-code = 0
     1759       then do:
     1760       assign
     1761           v-torgconf-ship-name         = "":U
     1762           v-torgconf-ship-addres       = "":U
     1763           v-torgconf-ship-post-addres  = "":U
     1764           v-torgconf-ship-phone        = "":U
     1765           v-torgconf-ship-inn          = "":U
     1766           v-torgconf-ship-kpp          = "":U
     1767           v-torgconf-ship-okpo         = "":U
     1768       .
     1769       end.
     1770       else do:
     1771       run fmtcli-get-client in this-procedure (
     1772             input p-obj-type
     1773           , input p-obj-code
     1774       ).
     1775       assign
     1776           v-torgconf-ship-name         = trim( v-fmtcli-name          )
     1777           v-torgconf-ship-engl-name    = trim( v-fmtcli-engl-name          )
     1778           v-torgconf-ship-addres       = trim( v-fmtcli-full-addres   )
     1779           v-torgconf-ship-post-addres  = trim( v-fmtcli-post-addres   )
     1780           v-torgconf-ship-phone        = trim( v-fmtcli-phone         )
     1781           v-torgconf-ship-inn          = trim( v-fmtcli-inn           )
     1782           v-torgconf-ship-kpp          = trim( v-fmtcli-kpp           )
     1783           v-torgconf-ship-okpo         = trim( v-fmtcli-okpo          )
     1784       .
     1785       end.
     1786           run fmtcli-get-bank in this-procedure (
     1787             input p-host-obj-code
     1788           , input p-obj-type
     1789           , input p-obj-code
     1790           , input p-curr-code
     1791       ).
     1792       assign
     1793           v-torgconf-ship-schet-exists = v-fmtcli-schet-exists
     1794           v-torgconf-ship-bank-exists  = v-fmtcli-bank-exists
     1795           v-torgconf-ship-bank-r-schet = v-fmtcli-bank-r-schet
     1796           v-torgconf-ship-bank-c-schet = v-fmtcli-bank-c-schet
     1797           v-torgconf-ship-bank-bik     = v-fmtcli-bank-bik
     1798           v-torgconf-ship-bank-name    = v-fmtcli-bank-name
     1799           v-torgconf-ship-bank-addres  = v-fmtcli-bank-addres
     1800           v-torgconf-ship-bank-city    = v-fmtcli-bank-city
     1801       .
     1802   end.
     1803   end procedure.
     1804   procedure torgconf-get-holdfirm-code :
     1805   define input parameter p-obj-type   as character        no-undo.
     1806   define input parameter p-obj-code   as integer          no-undo.
     1807   define output parameter p-firm-code as integer          no-undo.
     1808       define variable v-firm-code-str     as character    no-undo.
     1809       define variable v-par-type          as character    no-undo.
     1810       define buffer buf_clients       for ub.clients.
     1811   do
     1812   for buf_clients
     1813   on error undo, return error
     1814   :
     1815       run gbl/clntat-v.p (
     1816             input p-obj-type
     1817           , input p-obj-code
     1818           , input 'holdfirm-code':U
     1819           , output v-firm-code-str
     1820           , output v-par-type
     1821       ).
     1822       assign
     1823           p-firm-code = integer( v-firm-code-str )
     1824       no-error.
     1825       if error-status :error
     1826       then do:
     1827           message
     1828               "Неверно задан код фирмы для печати накладных."
     1829           view-as alert-box warning.
     1830           assign
     1831               p-firm-code = 0
     1832           .
     1833       end.
     1834       else do:
     1835           find first buf_clients no-lock
     1836                where buf_clients.obj-type = 'орг':U
     1837                  and buf_clients.obj-code = p-firm-code
     1838           no-error.
     1839           if not available buf_clients
     1840           then do:
     1841               message
     1842                   "Включен параметр 'Список печатных форм, для которых должна быть задана фирма для печати накладных' (outhold)" skip
     1843                   "Не найдена фирма по заданному коду фирмы для печати накладных."
     1844               view-as alert-box warning.
     1845               assign
     1846                   p-firm-code = 0
     1847               .
     1848           end.
     1849       end.
     1850   end.
     1851   end procedure.
     1852   procedure torgconf-get-post-head:
     1853   define input  parameter p-obj-type             as character        no-undo.
     1854   define input  parameter p-obj-code             as integer          no-undo.
     1855   define output parameter p-torgconf-post-head   as character        no-undo.
     1856      define variable v-host-code         as integer      no-undo.
     1857      define buffer buf_sysconf     for ub.sysconf.
     1858        assign
     1859         p-torgconf-post-head  = ""
     1860        .
     1861   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1862   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1863     (input  p-obj-type
     1864     ,input  p-obj-code
     1865     ,output v-host-code
     1866     )  .
     1867      find first buf_sysconf no-lock
     1868      where buf_sysconf.host-code = v-host-code
     1869      no-error.
     1870      if available buf_sysconf
     1871      then do:
     1872         assign
     1873            p-torgconf-post-head = buf_sysconf.head-position
     1874         .
     1875      end.
     1876   end procedure.
     1877   procedure torgconf-get-storekeeper:
     1878   define input  parameter p-wrkr                   as integer          no-undo.
     1879   define output parameter p-torgconf-wrkr-name     as character        no-undo.
     1880   define output parameter p-torgconf-post          as character        no-undo.
     1881      define buffer buf_sysconf     for ub.sysconf.
     1882      define buffer buf_person      for ub.person.
     1883      define buffer buf_shop        for ub.shop .
     1884      define buffer buf_store       for ub.store .
     1885      if v-torgconf-outC = "no_print"
     1886      then do:
     1887         assign p-torgconf-post = ""
     1888                p-torgconf-wrkr-name = ""
     1889                .
     1890      end.
     1891      if v-torgconf-outC = "clad_doc"
     1892      then do:
     1893         run rep/get-psn.p
     1894               (input  p-wrkr
     1895               ,output p-torgconf-wrkr-name
     1896               ) .
     1897         find first buf_person no-lock
     1898         where buf_person.psn-code = p-wrkr
     1899         no-error.
     1900         if available buf_person
     1901         then do:
     1902           p-torgconf-post = buf_person.position.
     1903         end.
     1904         if p-torgconf-post = "?":U then p-torgconf-post = "".
     1905         if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     1906      end.
     1907      if v-torgconf-outC = "clad_obj"
     1908      then do:
     1909         CASE v-torgconf-self-obj-type:
     1910         WHEN 'маг':U
     1911         THEN DO:
     1912            find first buf_shop no-lock
     1913            where buf_shop.obj-code = v-torgconf-self-obj-code
     1914            .
     1915            assign
     1916               p-torgconf-wrkr-name = buf_shop.store-man
     1917               p-torgconf-post = ""
     1918            .
     1919            if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     1920         END.
     1921         WHEN 'скл':U
     1922         THEN DO:
     1923            find first buf_store no-lock
     1924            where buf_store.obj-code = v-torgconf-self-obj-code
     1925            .
     1926            assign
     1927               p-torgconf-wrkr-name = buf_store.store-man
     1928               p-torgconf-post = ""
     1929            .
     1930            if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     1931         END.
     1932         OTHERWISE DO:
     1933            assign
     1934               p-torgconf-post = "":U
     1935               p-torgconf-wrkr-name = "":U
     1936            .
     1937         END.
     1938         END CASE.
     1939      end.
     1940    end procedure.
     1941   procedure torgconf-get-form-header :
     1942   define input parameter p-for-inverse    as logical          no-undo.
     1943   define input parameter p-doc-code       as character        no-undo.
     1944   define input parameter p-print-doc      as logical          no-undo.
     1945   define input parameter p-doc-date       as date             no-undo.
     1946   define input parameter p-fact-date      as date             no-undo.
     1947   define input parameter p-doc-type       as character        no-undo.
     1948   define input parameter p-status_        as character        no-undo.
     1949   define input parameter p-reverse        as logical          no-undo.
     1950   define input parameter p-sf-par         as logical          no-undo.
     1951       define variable v-attr-type         as character    no-undo.
     1952       define variable v-doc-code-standard as logical      no-undo.
     1953       define variable v-doc-date-standard as logical      no-undo.
     1954       define variable v-par-consignee-addres  as character    no-undo.
     1955       define variable v-host-code         as integer      no-undo.
     1956       define variable v-dcode-attr        as character    no-undo.
     1957       define variable v-ddate-attr        as character    no-undo.
     1958       define variable v-doc-date          as character    no-undo.
     1959       define variable v-doc-code          as character    no-undo.
     1960       define variable v-par-type          as character    no-undo.
     1961       define variable v-attr              as character    no-undo.
     1962       define buffer buf_firm          for ub.firm .
     1963       define buffer buf_clients       for ub.clients .
     1964       define buffer buf_sysconf       for ub.sysconf .
     1965       define buffer buf_shop          for ub.shop .
     1966       define buffer buf_store         for ub.store .
     1967       define buffer buf_person        for ub.person .
     1968       define buffer buf_trn-doc       for ub.trn-doc .
     1969       define buffer buf_wth-doc       for ub.wth-doc .
     1970       do
     1971   for buf_firm
     1972     , buf_clients
     1973     , buf_sysconf
     1974     , buf_shop
     1975     , buf_trn-doc
     1976     , buf_person
     1977     , buf_wth-doc
     1978   on error undo, return error
     1979   :
     1980       if p-doc-type = 'при':U
     1981       or p-doc-type = 'возврат':U
     1982       then do:
     1983           assign
     1984               v-torgconf-supplier         = substitute( "&1&2&3&4&5", v-torgconf-cli-name, ( if v-torgconf-cli-addres = "":U then "":U else ", " ),
     1985                                             v-torgconf-cli-addres, ( if v-torgconf-cli-phone = "":U then "":U else ", " ), v-torgconf-cli-phone )
     1986               v-torgconf-suppi            = substitute( "&1&2&3&4&5", v-torgconf-cli-name, ( if v-torgconf-cli-addres = "":U then "":U else ", " ),
     1987                                             v-torgconf-cli-addres, ( if v-torgconf-cli-phone = "":U then "":U else ", " ), v-torgconf-cli-phone )
     1988               v-torgconf-saler            = substitute( "&1&2&3&4&5", v-torgconf-self-host-name, ( if v-torgconf-self-host-addres = "":U then "":U else ", " ),
     1989                                             v-torgconf-self-host-addres, ( if v-torgconf-self-host-phone = "":U then "":U else ", " ),v-torgconf-self-host-phone )
     1990               v-torgconf-consignee        = substitute( "&1&2&3&4&5", v-torgconf-sup-host-name, ( if v-torgconf-sup-host-addres = "":U then "":U else ", " ),
     1991                                             v-torgconf-sup-host-addres, ( if v-torgconf-sup-host-phone = "":U then "":U else ", " ), v-torgconf-sup-host-phone  )
     1992               v-torgconf-supplier-okpo    = v-torgconf-cli-okpo
     1993               v-torgconf-saler-okpo       = v-torgconf-self-host-okpo
     1994               v-torgconf-consignee-okpo   = v-torgconf-sup-host-okpo
     1995               v-torgconf-supplier-code    = substitute( "&1", v-torgconf-cli-code         )
     1996               v-torgconf-supplier-type    = v-torgconf-cli-type
     1997               v-torgconf-saler-code       = substitute( "&1", v-torgconf-self-host-code   )
     1998               v-torgconf-saler-type       = v-torgconf-self-host-type
     1999               v-torgconf-consignee-code   = substitute( "&1", v-torgconf-sup-host-code   )
     2000               v-torgconf-consignee-type   = v-torgconf-sup-host-type
     2001               v-torgconf-supplier-name    = substitute( "&1", v-torgconf-cli-name         )
     2002               v-torgconf-saler-name       = substitute( "&1", v-torgconf-self-host-name   )
     2003               v-torgconf-consignee-name   = substitute( "&1", v-torgconf-sup-host-name   )
     2004               v-torgconf-supplier-addr    = substitute( "&1", v-torgconf-cli-addres       )
     2005               v-torgconf-saler-addr       = substitute( "&1", v-torgconf-self-host-addres )
     2006               v-torgconf-consignee-addr   = substitute( "&1", v-torgconf-sup-host-addres )
     2007               v-torgconf-supplier-inn     = substitute( "&1", v-torgconf-cli-inn          )
     2008               v-torgconf-supplier-engl-name     = substitute( "&1", v-torgconf-cli-engl-name          )
     2009               v-torgconf-saler-inn        = substitute( "&1", v-torgconf-self-host-inn    )
     2010               v-torgconf-consignee-inn    = substitute( "&1", v-torgconf-sup-host-inn    )
     2011               v-torgconf-supplier-kpp     = substitute( "&1", v-torgconf-cli-kpp          )
     2012               v-torgconf-saler-kpp        = substitute( "&1", v-torgconf-self-host-kpp    )
     2013               v-torgconf-consignee-kpp    = substitute( "&1", v-torgconf-sup-host-kpp    )
     2014           .
     2015           if v-torgconf-cli-schet-exists = yes
     2016           AND v-form-name                  = "torg12":U
     2017           then do:
     2018               assign
     2019                   v-torgconf-supplier = v-torgconf-supplier
     2020                       + substitute( ", р/с &1 к/с &2"
     2021                                   , v-torgconf-cli-bank-r-schet
     2022                                   , v-torgconf-cli-bank-c-schet
     2023                                   )
     2024                   v-torgconf-suppi = v-torgconf-supplier
     2025                       + substitute( ", р/с &1 к/с &2"
     2026                                   , v-torgconf-cli-bank-r-schet
     2027                                   , v-torgconf-cli-bank-c-schet
     2028                                   )
     2029               .
     2030               if v-torgconf-cli-bank-exists = yes
     2031               then do:
     2032                   assign
     2033                       v-torgconf-supplier = v-torgconf-supplier
     2034                           + substitute( " БИК &1 в &2 &3"
     2035                                       , v-torgconf-cli-bank-bik
     2036                                       , v-torgconf-cli-bank-name
     2037                                       ,(if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) )
     2038                                       )
     2039                      v-torgconf-suppi = v-torgconf-supplier
     2040                           + substitute( " БИК &1 в &2 &3"
     2041                                       , v-torgconf-cli-bank-bik
     2042                                       , v-torgconf-cli-bank-name
     2043                                       ,(if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) )
     2044                                       )
     2045                   .
     2046               end.
     2047           end.
     2048           if v-torgconf-self-schet-exists = yes
     2049           AND v-form-name                  = "torg12":U
     2050           then do:
     2051               assign
     2052                   v-torgconf-saler = v-torgconf-saler
     2053                       + substitute( ", р/с &1 к/с &2"
     2054                                   , v-torgconf-self-bank-r-schet
     2055                                   , v-torgconf-self-bank-c-schet
     2056                                   )
     2057               .
     2058               if v-torgconf-self-bank-exists = yes
     2059               then do:
     2060                   assign
     2061                       v-torgconf-saler = v-torgconf-saler
     2062                           + substitute( " БИК &1 в &2 &3"
     2063                                       , v-torgconf-self-bank-bik
     2064                                       , v-torgconf-self-bank-name
     2065                                       , v-torgconf-self-bank-addres
     2066                                       )
     2067                   .
     2068               end.
     2069           end.
     2070           if v-torgconf-sup-schet-exists = yes
     2071           AND v-form-name                  = "torg12":U
     2072           then do:
     2073               assign
     2074                   v-torgconf-consignee = v-torgconf-consignee
     2075                       + substitute( ", р/с &1 к/с &2"
     2076                                   , v-torgconf-sup-bank-r-schet
     2077                                   , v-torgconf-sup-bank-c-schet
     2078                                   )
     2079               .
     2080             if v-torgconf-sup-bank-exists = yes
     2081              then do:
     2082                assign
     2083                   v-torgconf-consignee = v-torgconf-consignee
     2084                           + substitute( " БИК &1 в &2 &3"
     2085                                       , v-torgconf-sup-bank-bik
     2086                                       , v-torgconf-sup-bank-name
     2087                                       , v-torgconf-sup-bank-addres
     2088                                       )
     2089                   .
     2090               end.
     2091           end.
     2092      if v-torgconf-outares = yes  AND v-form-name  = "torg12":U
     2093      then do:
     2094          assign
     2095            v-torgconf-supplier = substitute(  "&1&2&3 &4 &5&6"
     2096                                                   , IF v-form-name = "torg12":U THEN SUBSTITUTE("ИНН &1 КПП &2 ", v-torgconf-cli-inn, v-torgconf-cli-kpp) ELSE "":U
     2097                                                   , v-torgconf-cli-name
     2098                                                   , ( if v-torgconf-outprncd = yes
     2099                                                         then substitute( " (&1)", v-torgconf-cli-code )
     2100                                                         else "":U )
     2101                                                   , v-torgconf-cli-post-addres
     2102                                                   , v-torgconf-cli-phone
     2103                                                   , ( if v-torgconf-cli-bank-r-schet <> "":U
     2104                                                       AND v-form-name                  = "torg12":U
