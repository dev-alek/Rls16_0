     1170           then do:
     1171               assign
     1172                   v-torgconf-outnum   = yes
     1173               .
     1174           end.
     1175           if lookup( p-form-name, v-outprim ) <> 0
     1176           then do:
     1177               assign
     1178                   v-torgconf-outprim  = yes
     1179               .
     1180           end.
     1181           if lookup( p-form-name, v-outdisc ) <> 0
     1182           then do:
     1183               assign
     1184                   v-torgconf-outdisc  = yes
     1185               .
     1186           end.
     1187           if lookup( p-form-name, v-outsubs ) <> 0
     1188           then do:
     1189               assign
     1190                   v-torgconf-outsubs  = yes
     1191               .
     1192           end.
     1193           if lookup( p-form-name, v-outrecv ) <> 0
     1194           then do:
     1195               assign
     1196                   v-torgconf-outrecv  = yes
     1197               .
     1198           end.
     1199           if lookup( p-form-name, v-outegrp ) <> 0
     1200           then do:
     1201               assign
