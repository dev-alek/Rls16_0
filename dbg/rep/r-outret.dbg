     4120   do on error undo, return error return-value :
     4121   find first cl_tt-clcparts where recid(cl_tt-clcparts) = parrec-parts no-lock.
     4122   for each bf_tt-allsum on error undo, return error return-value :
     4123     delete bf_tt-allsum.
     4124   end.
     4125   assign
     4126     price-rubl-with-tax-loccl = cl_tt-clcparts.price-rubl
     4127     price-base-with-tax-loccl = cl_tt-clcparts.price-base
     4128   .
     4129   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     4130   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     4131     (output varinvprbcl
     4132     )  .
     4133     if cl_tt-clcparts.out-code = 'free-zone':U     or
     4134        cl_tt-clcparts.out-code = 'out-zone':U   or
     4135        cl_tt-clcparts.doc-type = 'акт':U then do:
     4136       assign
     4137         in-vatp-have-vat-sltcl = yes.
     4138     end.
     4139     else do:
     4140       find first in-vatp_doc-attrcl no-lock
     4141         where in-vatp_doc-attrcl.doc-code  = cl_tt-clcparts.out-code
     4142           and in-vatp_doc-attrcl.attr-code = 'envd':U
     4143         no-error .
     4144       if not available in-vatp_doc-attrcl then do:
     4145         assign
     4146           in-vatp-have-vat-sltcl = yes.
     4147       end.
     4148       else do:
     4149            in-vatp-have-vat-sltcl = no.
     4150       end.
     4151     end.
     4152     assign
     4153      price-cli-with-tax-loccl = cl_tt-clcparts.price-cli
     4154      cli-base-ratecl          = cl_tt-clcparts.cli-base-rate.
     4155     ASSIGN   road-tax-base-loccl  = (if cl_tt-clcparts.road-tax-base  = ? then 0 else cl_tt-clcparts.road-tax-base)
     4156              road-tax-rubl-loccl  = (if cl_tt-clcparts.road-tax-rubl  = ? then 0 else cl_tt-clcparts.road-tax-rubl).
     4157     ASSIGN  transport-base-loccl = (if cl_tt-clcparts.transport-base = ? then 0 else cl_tt-clcparts.transport-base)
     4158             transport-rubl-loccl = (if cl_tt-clcparts.transport-rubl = ? then 0 else cl_tt-clcparts.transport-rubl)
     4159             other-base-loccl     = (if cl_tt-clcparts.other-base     = ? then 0 else cl_tt-clcparts.other-base)
     4160             other-rubl-loccl     = (if cl_tt-clcparts.other-rubl     = ? then 0 else cl_tt-clcparts.other-rubl)
