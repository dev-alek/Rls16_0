     5449     (input  bf_trn-doc.obj-type
     5450     ,input  bf_trn-doc.obj-code
     5451     ,input  varb-code
     5452     ,input  0
     5453     ,input  bf_trn-doc.fact-order
     5454     ,output vardoc-num
     5455     ,output varprice-sale
     5456     ,output varroad-tax
     5457     ,output varexcise
     5458     )  .
     5459             if varprice-sale = ?
     5460             then do:
     5461               assign
     5462                 varprice-sale = 0
     5463                 varroad-tax   = 0
     5464                 varexcise     = 0
     5465               .
     5466             end.
     5467             assign
     5468               varlastcur-base     = varprice-sale
     5469               varlastcur-road-tax = varroad-tax
     5470               varlastcur-excise   = varexcise
     5471               varcur-base         = varcur-base      + varprice-sale * bf_gds-dtl.fact-qnty
     5472               varcur-road-tax     = varcur-road-tax  + varroad-tax   * bf_gds-dtl.fact-qnty
     5473               varcur-excise       = varcur-excise    + varexcise     * bf_gds-dtl.fact-qnty
     5474               varcur-fact-qnty    = varcur-fact-qnty + bf_gds-dtl.fact-qnty
     5475             .
     5476         end.
     5477       end.
     5478       if varcur-fact-qnty = 0 then do:
     5479         assign
     5480           varcur-base      = varlastcur-base
     5481           varcur-road-tax  = varlastcur-road-tax
     5482           varcur-excise    = varlastcur-excise
     5483         .
     5484       end.
     5485       else do:
     5486         assign
     5487           varcur-base      = varcur-base      / varcur-fact-qnty
     5488           varcur-road-tax  = varcur-road-tax  / varcur-fact-qnty
     5489           varcur-excise    = varcur-excise    / varcur-fact-qnty
     5490         .
     5491       end.
