      947   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      948   procedure wthcattr-sprcli :
      949   define input parameter parparentproc  as widget-handle no-undo.
      950   define input parameter p-mode  as character no-undo.
      951   define input-output parameter p-value as character no-undo .
      952   define output parameter p-setted as logical no-undo .
      953     DEFINE VARIABLE v-value as character no-undo .
      954     define variable v-cli-type as character no-undo .
      955     define variable v-cli-code as integer no-undo .
      956     define buffer buf_clients   for ub.clients.
      957     define variable v_rid as character no-undo.
      958     define variable ref-rec as recid no-undo .
      959     do
      960     on error undo, return error
      961     :
      962         v-value = p-value.
      963      if p-value <> '':U then do:
      964       assign
      965       v-cli-type = substring(p-value, 1, 3)
      966       v-cli-code = integer(substring(p-value, 4))
      967       no-error.
      968       if error-status:error then do:
      969         assign
      970         v-cli-type = '':U
      971         v-cli-code = 0
      972         .
      973       end.
      974      end.
      975      FIND FIRST buf_clients NO-LOCK WHERE
      976               buf_clients.obj-type = v-cli-type AND
      977               buf_clients.obj-code = v-cli-code  NO-ERROR.
      978      IF available(buf_clients) then do:
      979       run ref/cli-all.w (
      980                   input parparentproc
      981                  ,input if p-mode = 'ИЗМЕНЕНИЕ':U then "b-sel":U else "":U
      982                  ,input v-cli-type
      983                  ,input 'все':U
      984                  ,input 'все':U
      985                  ,input RECID( buf_clients )
      986                  ,input ",,,,,,NO"
      987                  ,input ?
      988                  ,OUTPUT v_rid ).
      989     END.
      990     ELSE if p-mode = 'ИЗМЕНЕНИЕ':U then DO:
      991       run ref/cli-all.w (
      992                    input parparentproc
      993                   ,INPUT "b-sel":U
      994                  ,input  v-cli-type
      995                  ,input 'все':U
      996                  ,input 'текущие':U
      997                  ,input ?
      998                  ,input ",,,,,,NO"
      999                  ,input ?
     1000                  ,OUTPUT v_rid ).
     1001     END.
     1002     else do:
     1003       message
     1004       if p-value = "":U then 'Атрибут не задан!'
     1005       else substitute('Не найден клиент &1',p-value)
     1006       view-as alert-box warning.
     1007     end.
     1008     IF v_rid <> ? AND v_rid <> "":U THEN DO:
     1009       ASSIGN ref-rec = INT( v_rid ) NO-ERROR.
     1010       IF ERROR-STATUS:ERROR THEN DO:
     1011           RETURN NO-APPLY.
     1012       END.
     1013       FIND FIRST buf_clients NO-LOCK WHERE
     1014                  RECID( buf_clients ) = ref-rec NO-ERROR.
     1015       IF AVAIL buf_clients THEN DO:
     1016         v-value = buf_clients.obj-type + string(buf_clients.obj-code, ">>>>>>>>9").
     1017       end.
     1018     end.
     1019     if v-value <> p-value then do:
     1020       p-value = v-value.
     1021       p-setted = yes.
     1022     end.
     1023     end.
     1024   end procedure.
     1025     define new global shared variable g#wthcalib as handle no-undo.
     1026   procedure torgconf-read :
