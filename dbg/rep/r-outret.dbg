     5877       .
     5878       run gbl/_tmpfile.p
     5879         (input  "xd"
     5880         ,input  ".txt"
     5881         ,output v-outretxl-data-file-name
     5882         ).
     5883       output stream excel-line to value( v-outretxl-data-file-name ).
     5884       run gbl/_tmpfile.p
     5885         (input "xc"
     5886         ,input ".txt"
     5887         ,output v-outretxl-cell-file-name
     5888         ).
     5889       output stream excel-cell to value( v-outretxl-cell-file-name ).
     5890       if printrubl
     5891       then do:
     5892           run outretxl-write-cell-data in this-procedure
     5893             (input "valutCode":U
     5894             ,input "0":U
     5895             ).
     5896       end.
     5897       else do:
     5898           run outretxl-write-cell-data in this-procedure (
     5899                 input "valutCode":U
     5900               , input "1":U
     5901           ).
     5902       end.
     5903       run outretxl-write-cell-data in this-procedure (
     5904             input "regularExpressions":U
     5905           , input "1":U
     5906       ).
     5907       run outretxl-write-cell-data in this-procedure (
     5908             input "columnList":U
     5909           , input "ID,gdscode,artic,Name,EI,price,qnty,sum":U
     5910       ).
     5911       run outretxl-write-cell-data in this-procedure (
     5912             input "columnType":U
     5913           , input "I,I,S,S,S,D,D,D":U
     5914       ).
     5915       run outretxl-write-cell-data in this-procedure (
     5916             input "columnAmount":U
     5917           , input "8":U
     5918       ).
     5919       run outretxl-write-cell-data in this-procedure (
     5920             input "subtotalList":U
     5921           , input "qnty,sum":U
     5922       ).
     5923       run outretxl-write-cell-data in this-procedure (
     5924             input "subtotalType":U
     5925           , input "D,D":U
     5926       ).
     5927       run outretxl-write-cell-data in this-procedure (
     5928             input "subtotalAmount":U
     5929           , input "2":U
     5930       ).
     5931   end.
     5932   end procedure.
     5933   procedure outretxl-close :
     5934   do
     5935   on error undo, return error
     5936   :
     5937       output stream excel-line close.
     5938       output stream excel-cell close.
     5939       output to value( string( session:temp-directory + "$" + string( g#report-num ) ) + ".txl" ) append.
     5940           export "exe/no_97.xlt":U.
     5941           export "exe/t_97.bas":U.
     5942           export v-outretxl-cell-file-name.
     5943           export v-outretxl-data-file-name.
     5944       output close.
     5945   end.
     5946   end procedure.
     5947   procedure outretxl-write-cell-data :
     5948   define input parameter p-data-key   as character        no-undo.
     5949   define input parameter p-data-value as character        no-undo.
     5950       define buffer buf_temp_cell-data     for temp_cell-data.
     5951   do
     5952   for buf_temp_cell-data
     5953   on error undo, return error
     5954   :
     5955       find first buf_temp_cell-data
     5956            where buf_temp_cell-data.data-key = p-data-key
     5957       no-error.
     5958       if not available buf_temp_cell-data
     5959       then do:
     5960           create buf_temp_cell-data.
     5961           assign
     5962               buf_temp_cell-data.data-key = p-data-key
     5963           .
     5964       end.
     5965       assign
     5966           buf_temp_cell-data.data-value = p-data-value
     5967       .
     5968       put stream excel-cell unformatted
     5969                           buf_temp_cell-data.data-key
     5970           chr(9)   buf_temp_cell-data.data-value
     5971           chr(10)
     5972       .
     5973   end.
     5974   end procedure.
     5975   procedure outretxl-write-line-data :
     5976   define input parameter p-ID             as integer          no-undo.
     5977   define input parameter p-gdscode        as character        no-undo.
     5978   define input parameter p-artic          as character        no-undo.
     5979   define input parameter p-Name           as character        no-undo.
     5980   define input parameter p-EI             as character        no-undo.
     5981   define input parameter p-price          as character        no-undo.
     5982   define input parameter p-qnty           as character        no-undo.
     5983   define input parameter p-sum            as character        no-undo.
     5984       define buffer buf_temp_line-data        for temp_line-data.
     5985   do
     5986   for buf_temp_line-data
     5987   on error undo, return error
     5988   :
     5989       for each buf_temp_line-data
     5990       :
     5991           delete buf_temp_line-data.
     5992       end.
     5993       create buf_temp_line-data.
     5994       assign
     5995           v-outretxl-current-data-row = v-outretxl-current-data-row + 1
     5996       .
     5997       assign
     5998           buf_temp_line-data.data-key     = "LD":U
     5999           buf_temp_line-data.xl-line-id   = v-outretxl-current-data-row
     6000           buf_temp_line-data.id           = p-id
     6001           buf_temp_line-data.gdscode      = p-gdscode
     6002           buf_temp_line-data.artic        = p-artic
     6003           buf_temp_line-data.Name         = p-Name
     6004           buf_temp_line-data.EI           = p-EI
     6005           buf_temp_line-data.price        = p-price
     6006           buf_temp_line-data.qnty         = p-qnty
     6007           buf_temp_line-data.sum          = p-sum
     6008       .
     6009       put stream excel-line unformatted
     6010                           buf_temp_line-data.data-key
     6011           chr(9)   ( if buf_temp_line-data.id = 0 then "":U else string( buf_temp_line-data.id ) )
     6012           chr(9)   buf_temp_line-data.gdscode
     6013           chr(9)   buf_temp_line-data.artic
     6014           chr(9)   buf_temp_line-data.Name
     6015           chr(9)   buf_temp_line-data.EI
     6016           chr(9)   buf_temp_line-data.price
     6017           chr(9)   buf_temp_line-data.qnty
     6018           chr(9)   buf_temp_line-data.sum
     6019           chr(10)
     6020       .
     6021   end.
     6022   end procedure.
     6023   procedure outretxl-run-excel :
     6024     define input parameter p-header-filename    as character        no-undo.
     6025     define input parameter p-data-filename      as character        no-undo.
     6026     define variable v-template-file-name    as character    no-undo.
     6027     define variable v-vb-file-name          as character    no-undo.
     6028     define buffer buf_temp-param for temp-param .
     6029     do for buf_temp-param on error undo, return error :
     6030       create buf_temp-param.
     6031       assign
     6032           v-template-file-name    = search( "exe/no_97.xlt" )
     6033           v-vb-file-name          = search( "exe/t_97.bas")
     6034       .
     6035       if v-template-file-name = ?  or v-template-file-name = "":U  then do:
     6036           message  "Ошибка имени файла шаблона." view-as alert-box error.
     6037       end.
     6038       if v-vb-file-name = ?  or v-vb-file-name = "":U then do:
     6039           message  "Ошибка имени файла кода обработки."   view-as alert-box error.
     6040       end.
     6041       run paramls-write in this-procedure (
     6042             input "template":U
     6043           , input "template-file-name":U
     6044           , input v-template-file-name
     6045       ).
     6046       run paramls-write in this-procedure (
     6047             input "template":U
     6048           , input "vb-file-name":U
     6049           , input v-vb-file-name
     6050       ).
     6051       run paramls-write in this-procedure (
     6052             input "data":U
     6053           , input "data-header-filename":U
     6054           , input p-header-filename
     6055       ).
     6056       run paramls-write in this-procedure (
     6057             input "data":U
     6058           , input "data-filename":U
     6059           , input p-data-filename
     6060       ).
     6061       run gbl/macroxlt.p (
     6062           input-output table buf_temp-param
     6063       ) no-error.
     6064       if error-status :error
     6065       then do:
     6066           message vss-workfile vss-revision vss-description skip(1)
     6067               skip "Ошибка создания файла Excel."
     6068               skip return-value
     6069               skip trim(error-status :get-message(1))
     6070                    trim(error-status :get-message(2))
     6071                    trim(error-status :get-message(3))
     6072           view-as alert-box error.
     6073           undo, return error .
     6074       end.
     6075     end.
     6076   end procedure.
