     1061           v-torgconf-outdisc  = no
     1062           v-torgconf-outsubs  = no
     1063           v-torgconf-outrecv  = no
     1064           v-torgconf-outegrp  = no
     1065           v-torgconf-outt12   = no
     1066           v-torgconf-outappr  = no
     1067           v-torgconf-outrubl  = no
     1068           v-torgconf-outhold  = no
     1069           v-torgconf-outobj   = no
     1070           v-torgconf-outexlst = no
     1071           v-torgconf-outexpas = "":U
     1072           v-torgconf-outprncd = yes
     1073           v-torgconf-outares  = no
     1074           v-torgconf-outsend  = no
