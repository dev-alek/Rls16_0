     3453               find first buf_sysconf no-lock
     3454               where buf_sysconf.host-code = v-host-code
     3455               no-error.
     3456               if available buf_sysconf
     3457               then do:
     3458                  assign
     3459                     v-torgconf-ogr-post = buf_sysconf.head-position
     3460                  .
     3461               end.
     3462               find first buf_clients no-lock
     3463                  where buf_clients.obj-type = 'орг':U
     3464                  and buf_clients.obj-code = v-host-code
     3465               .
     3466               find first buf_firm no-lock
     3467                  where buf_firm.firm-code = buf_clients.obj-code
     3468               .
     3469               assign
     3470                  v-torgconf-ogr-name = buf_firm.director
     3471               .
     3472            end.
     3473            if v-torgconf-outogr = "dir_obj"
     3474               then do:
     3475               find first buf_wth-doc no-lock
     3476               where buf_wth-doc.doc-code = p-doc-code
     3477               no-error.
     3478                  find first buf_shop no-lock
     3479                  where buf_shop.obj-code = buf_wth-doc.obj-code
     3480                  .
     3481                  assign
     3482                     v-torgconf-ogr-name = buf_shop.director
     3483                     v-torgconf-ogr-post = "Директор"
     3484                  .
     3485               end.
     3486         if v-torgconf-outogr = "manag_doc"
     3487            then do:
     3488               find first buf_wth-doc no-lock
     3489               where buf_wth-doc.doc-code = p-doc-code
     3490               no-error.
     3491               if available buf_wth-doc
     3492               then do:
     3493                  run rep/get-psn.p
     3494                  (input buf_wth-doc.deliver
     3495                  ,output v-torgconf-ogr-name
     3496                  ) .
     3497               end.
     3498               find first buf_person no-lock
     3499               where buf_person.psn-code = buf_wth-doc.deliver
     3500               no-error.
     3501               if available buf_person
     3502               then do:
     3503                  v-torgconf-ogr-post = buf_person.position.
     3504               end.
     3505               if v-torgconf-ogr-name = "?":U then v-torgconf-ogr-name = "".
     3506               if v-torgconf-ogr-post = ? then  v-torgconf-ogr-post = "".
     3507            end.
     3508      end.
     3509   end.
     3510   end procedure.
     3511   procedure torgconf-get-outogr-param:
     3512       define input parameter p-form-name  as character    no-undo.
     3513       define input parameter p-host-code  as integer      no-undo.
     3514       define input parameter p-obj-type   as character    no-undo.
     3515       define input parameter p-obj-code   as integer      no-undo.
     3516       define input parameter p-doc-code   as character      no-undo.
     3517       define buffer buf_firm          for ub.firm .
     3518       define buffer buf_clients       for ub.clients .
     3519       define buffer buf_sysconf       for ub.sysconf .
     3520       define buffer buf_shop          for ub.shop .
     3521       define buffer buf_store         for ub.store .
     3522       define buffer buf_person        for ub.person .
     3523       define buffer buf_trn-doc       for ub.trn-doc .
     3524       define buffer buf_wth-doc       for ub.wth-doc .
     3525      if  p-form-name <> 'wthtrg12':U
     3526      and p-form-name <> 'wthfct':U
     3527      and p-form-name <> 'wthm11':U
     3528      then do:
     3529       find first buf_trn-doc no-lock
     3530       where buf_trn-doc.doc-code = p-doc-code
     3531       no-error.
     3532       if v-torgconf-outogr = "no_print"
     3533         then do:
     3534            assign
     3535               v-torgconf-ogr-name = ""
     3536               v-torgconf-ogr-post = ""
     3537            .
     3538         end.
     3539      if v-torgconf-outogr  = "ruk_firm"
     3540            then do:
     3541            find first buf_sysconf no-lock
     3542            where buf_sysconf.host-code = p-host-code
     3543            no-error.
     3544            if available buf_sysconf
     3545            then do:
     3546               assign
     3547                  v-torgconf-ogr-post = buf_sysconf.head-position
     3548               .
     3549            end.
     3550            find first buf_clients no-lock
     3551                where buf_clients.obj-type = 'орг':U
     3552                and buf_clients.obj-code = p-host-code
     3553            .
     3554            find first buf_firm no-lock
     3555                where buf_firm.firm-code = buf_clients.obj-code
     3556            .
     3557            assign
     3558                v-torgconf-ogr-name = buf_firm.director
     3559            .
     3560         end.
     3561         if v-torgconf-outogr = "dir_obj"
     3562            then do:
     3563            find first buf_trn-doc no-lock
     3564            where buf_trn-doc.doc-code = p-doc-code
     3565            no-error.
     3566               CASE buf_trn-doc.obj-type:
     3567               WHEN 'маг':U
     3568               THEN DO:
     3569                  find first buf_shop no-lock
     3570                  where buf_shop.obj-code = buf_trn-doc.obj-code
     3571                  .
     3572                  assign
     3573                     v-torgconf-ogr-name = buf_shop.director
     3574                     v-torgconf-ogr-post = "Директор"
     3575                  .
     3576               END.
     3577               WHEN 'скл':U
     3578               THEN DO:
     3579                  find first buf_store no-lock
     3580                  where buf_store.obj-code = buf_trn-doc.obj-code
     3581                  .
     3582                  assign
     3583                     v-torgconf-ogr-name = buf_store.store-boss
     3584                     v-torgconf-ogr-post = "Директор"
     3585                  .
     3586               END.
     3587               OTHERWISE DO:
     3588                  assign
     3589                     v-torgconf-ogr-name = "":U
     3590                     v-torgconf-ogr-post = "":U
     3591                  .
     3592               END.
     3593               END CASE.
     3594            end.
     3595      if v-torgconf-outogr = "manag_doc"
     3596         then do:
     3597            find first buf_trn-doc no-lock
     3598            where buf_trn-doc.doc-code = p-doc-code
     3599            no-error.
     3600            if available buf_trn-doc
     3601            then do:
     3602               run rep/get-psn.p
     3603               (input buf_trn-doc.boss
     3604               ,output v-torgconf-ogr-name
     3605               ) .
     3606            end.
     3607            find first buf_person no-lock
     3608            where buf_person.psn-code = buf_trn-doc.boss
     3609            no-error.
     3610            if available buf_person
     3611            then do:
     3612               v-torgconf-ogr-post = buf_person.position.
     3613            end.
     3614            if v-torgconf-ogr-name = "?":U then v-torgconf-ogr-name = "".
     3615            if v-torgconf-ogr-post = ? then  v-torgconf-ogr-post = "".
     3616         end.
     3617      end.
     3618      else do:
     3619      find first buf_wth-doc no-lock
     3620         where buf_wth-doc.doc-code = p-doc-code
     3621         no-error.
     3622         if v-torgconf-outogr = "no_print"
     3623            then do:
     3624               assign
     3625                  v-torgconf-ogr-name = ""
     3626                  v-torgconf-ogr-post = ""
     3627               .
     3628            end.
     3629         if v-torgconf-outogr  = "ruk_firm"
     3630               then do:
     3631               find first buf_sysconf no-lock
     3632               where buf_sysconf.host-code = p-host-code
     3633               no-error.
     3634               if available buf_sysconf
     3635               then do:
     3636                  assign
     3637                     v-torgconf-ogr-post = buf_sysconf.head-position
     3638                  .
     3639               end.
     3640               find first buf_clients no-lock
     3641                  where buf_clients.obj-type = 'орг':U
     3642                  and buf_clients.obj-code = p-host-code
     3643               .
     3644               find first buf_firm no-lock
     3645                  where buf_firm.firm-code = buf_clients.obj-code
     3646               .
     3647               assign
     3648                  v-torgconf-ogr-name = buf_firm.director
     3649               .
     3650            end.
     3651            if v-torgconf-outogr = "dir_obj"
     3652               then do:
     3653               find first buf_wth-doc no-lock
     3654               where buf_wth-doc.doc-code = p-doc-code
     3655               no-error.
     3656                  find first buf_shop no-lock
     3657                  where buf_shop.obj-code = buf_wth-doc.obj-code
     3658                  .
     3659                  assign
     3660                     v-torgconf-ogr-name = buf_shop.director
     3661                     v-torgconf-ogr-post = "Директор"
     3662                  .
     3663               end.
     3664         if v-torgconf-outogr = "manag_doc"
     3665            then do:
     3666               find first buf_wth-doc no-lock
     3667               where buf_wth-doc.doc-code = p-doc-code
     3668               no-error.
     3669               if available buf_wth-doc
     3670               then do:
     3671                  run rep/get-psn.p
     3672                  (input buf_wth-doc.deliver
     3673                  ,output v-torgconf-ogr-name
     3674                  ) .
     3675               end.
     3676               find first buf_person no-lock
     3677               where buf_person.psn-code = buf_wth-doc.deliver
     3678               no-error.
     3679               if available buf_person
     3680               then do:
     3681                  v-torgconf-ogr-post = buf_person.position.
     3682               end.
     3683               if v-torgconf-ogr-name = "?":U then v-torgconf-ogr-name = "".
     3684               if v-torgconf-ogr-post = ? then  v-torgconf-ogr-post = "".
     3685            end.
     3686      end.
     3687   end.
     3688   procedure torgconf-get-reason  :
     3689   define input parameter  p-doc-code       as character        no-undo.
     3690   define input parameter  p-reason-code    as integer          no-undo .
     3691   define input parameter  p-doc-type       as character        no-undo.
     3692       if p-reason-code > 0
     3693       then do:
     3694           define buffer buf_trn-reason for ub.trn-reason.
     3695           find first buf_trn-reason no-lock where buf_trn-reason.reason-code = p-reason-code no-error .
     3696           if available buf_trn-reason then assign v-torgconf-reason =  buf_trn-reason.reason-name .
     3697       end.
     3698       else do:
     3699           if p-doc-type = 'при':U
     3700           then  do:
     3701               define variable v-attr-type     as character    no-undo.
     3702               define variable v-attr-value    as character    no-undo.
     3703               run gbl/trdcat-v.p (input p-doc-code,input 'nids':U,output v-attr-value,output v-attr-type) .
     3704               assign v-torgconf-reason = v-attr-value .
     3705               run gbl/trdcat-v.p (input p-doc-code,input 'dids':U,output v-attr-value,output v-attr-type) .
     3706               assign v-torgconf-reason = v-torgconf-reason + " от " + v-attr-value .
     3707           end.
     3708       end.
     3709   end procedure.
