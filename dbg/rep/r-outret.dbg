     5522         buffer-copy bf_parts to buf_tt-clcparts .
     5523         if v-calcbypart = yes   then do:
     5524   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run partbcod in g#library
     5525     (buffer bf_parts
     5526     ,output v-b-pcode
     5527     ) no-error .
     5528   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5529   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     5530     (input  bf_parts.obj-type
     5531     ,input  bf_parts.obj-code
     5532     ,input  v-b-pcode
     5533     ,input  0
     5534     ,input  bf_trn-doc.fact-order
     5535     ,output vardoc-num
     5536     ,output varprice-salef
     5537     ,output varroad-tax
     5538     ,output varexcise
     5539     ) no-error .
     5540             if varprice-sale = ?
     5541             then do:
     5542               assign
     5543                 varprice-salef = 0
     5544                 varroad-tax   = 0
     5545                 varexcise     = 0
     5546               .
     5547             end.
     5548             assign
     5549             part-cur-base  = varprice-salef
     5550             part-cur-road-tax  = varroad-tax
     5551             part-cur-excise = varexcise.
     5552         end.
     5553       end.
     5554       run clcprtsl_calc-ttable in this-procedure
     5555         (input yes,
     5556          input yes,
     5557          input bf_doc-line.road-tax,
     5558          input bf_doc-line.excise,
     5559          input bf_doc-line.vat-pc,
     5560          input bf_doc-line.cons-vat-pc,
     5561          input bf_doc-line.slt-pc,
     5562          input bf_trn-doc.base-rate,
     5563          input bf_trn-doc.base-scale,
     5564          input varr-b,
     5565          input varcur-base,
     5566          input varcur-road-tax,
     5567          input varcur-excise,
     5568          input varcur-vat-pc,
     5569          input varcur-cons-vat-pc,
     5570          input varcur-slt-pc
     5571          ) no-error.
     5572       if error-status:error then do:
     5573         message
     5574           vss-workfile vss-revision vss-description skip
     5575           "Ошибка при вызове процедуры clcprtsl_calc-ttable." skip
     5576           return-value skip
     5577           trim(error-status :get-message(1))
     5578           trim(error-status :get-message(2))
     5579           trim(error-status :get-message(3))
     5580           trim(error-status :get-message(4))
     5581           trim(error-status :get-message(5)) skip
     5582           view-as alert-box error.
     5583         undo, return error .
     5584       end.
     5585     end.
     5586   end.
     5587   end.
     5588   procedure clcprtsl_calc-ttable :
     5589   define input parameter paris-doc           as   logical                 no-undo.
     5590   define input parameter paris-cur           as   logical                 no-undo.
     5591   define input parameter parroad-tax         like ub.doc-line.road-tax    no-undo.
     5592   define input parameter parexcise           like ub.doc-line.excise      no-undo.
     5593   define input parameter parvat-pc           like ub.doc-line.vat-pc      no-undo.
     5594   define input parameter parcons-vat-pc      like ub.doc-line.cons-vat-pc no-undo.
     5595   define input parameter parslt-pc           like ub.doc-line.slt-pc      no-undo.
     5596   define input parameter parbase-rate        like ub.trn-doc.base-rate    no-undo.
     5597   define input parameter parbase-scale       like ub.trn-doc.base-scale   no-undo.
     5598   define input parameter parr-b              as   character               no-undo.
     5599   define input parameter parcur-base         like ub.gds-dtl.cur-base     no-undo.
     5600   define input parameter parcur-road-tax     like ub.doc-line.road-tax    no-undo.
     5601   define input parameter parcur-excise       like ub.doc-line.excise      no-undo.
     5602   define input parameter parcur-vat-pc       like ub.doc-line.vat-pc      no-undo.
     5603   define input parameter parcurcons-vat-pc   like ub.doc-line.cons-vat-pc no-undo.
     5604   define input parameter parcurslt-pc        like ub.doc-line.slt-pc      no-undo.
     5605   define buffer bf_tt-allsum      for tt-allsum.
     5606   define buffer bf_tt-clcparts    for tt-clcparts.
     5607   define buffer bf_tt-allsum-line for tt-allsum-line.
     5608   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     5609   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     5610   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     5611   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     5612   define variable varexcise          like ub.price-list.excise     no-undo.
     5613   do on error undo, return error return-value :
     5614   for each bf_tt-allsum-line
     5615   on error undo, return error return-value
     5616    :
     5617     delete bf_tt-allsum-line.
     5618   end.
     5619   for each bf_tt-allsum
     5620   on error undo, return error return-value
     5621   :
     5622     delete bf_tt-allsum.
     5623   end.
     5624   for each bf_tt-clcparts
     5625   on error undo, return error return-value
     5626   :
     5627   if v-calcbypart then do:
     5628             assign
     5629             parcur-base =   bf_tt-clcparts.part-cur-base
     5630             parcur-road-tax = bf_tt-clcparts.part-cur-road-tax
     5631             parcur-excise =   bf_tt-clcparts.part-cur-excise
     5632             .
     5633   end.
     5634      run clcprtsl_calc-parts in this-procedure (
     5635        input recid(bf_tt-clcparts),
     5636        input paris-doc,
     5637        input paris-cur,
     5638        input parroad-tax,
     5639        input parexcise,
     5640        input parvat-pc,
     5641        input parcons-vat-pc,
     5642        input parslt-pc,
     5643        input parbase-rate,
     5644        input parbase-scale,
     5645        input parr-b,
     5646        input parcur-base,
     5647        input parcur-road-tax,
     5648        input parcur-excise,
     5649        input parcur-vat-pc,
     5650        input parcurcons-vat-pc,
     5651        input parcurslt-pc
     5652        ) no-error.
     5653     if error-status:error then do:
     5654       message
     5655         vss-workfile vss-revision vss-description skip
     5656         vss-include-info14 skip
     5657         "Ошибка при обсчете партии" skip
     5658         "Документ партии " bf_tt-clcparts.out-code skip
     5659         "Товар" bf_tt-clcparts.artic bf_tt-clcparts.prod-type bf_tt-clcparts.prod-code skip
     5660         return-value skip
     5661         error-status:get-message(1) skip
     5662         error-status:get-message(2) skip
     5663         error-status:get-message(3) skip
     5664         view-as alert-box error .
     5665       undo, return error .
     5666     end.
     5667     for each bf_tt-allsum on error undo, return error return-value :
     5668       find first bf_tt-allsum-line where bf_tt-allsum-line.sum-type = bf_tt-allsum.sum-type no-error.
     5669       if not available bf_tt-allsum-line then do:
