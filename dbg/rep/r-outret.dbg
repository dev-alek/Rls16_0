     7068                         , input string( qnty )
     7069                         , input string( stoim )
     7070                 ).
     7071         end.
     7072       end.
     7073       end.
     7074     end.
     7075   end procedure.
     7076   procedure print-titul :
     7077         define variable v-firm-string    as character    no-undo.
     7078     do on error undo, return error return-value :
     7079           if lookup( "SPAR":U, p-mode ) <> 0
     7080            then do:
     7081                   put stream Out_stream space(10)
     7082                   skip "Форма Акта списания,"  at 135
     7083                   skip "Утверждена руководителем, " at 135
     7084                   skip "приказ №120 от 29.12.12г." at 135
     7085                   skip(1) .
     7086          run outretxl-write-cell-data in this-procedure (
     7087          input "h_docName":U
     7088            ,input "Форма Акта списания"
     7089                   ).
     7090          run outretxl-write-cell-data in this-procedure (
     7091             input "h_docCode":U
     7092           , input "Утверждена руководителем : "
     7093       ).
     7094       run outretxl-write-cell-data in this-procedure (
     7095             input "h_cliTo":U
     7096           , input "приказ №120 от 29.12.12г. : " ).
     7097    end.
     7098     if is-chek then do:
     7099       put stream Out_stream  "Т О В А Р Н Ы Й  Ч Е К  N " at 32 format "X(30)" .
     7100       put stream Out_stream
     7101                     v-doc-code                                                                      format "X(14)"
     7102                     "  от  "
     7103                     v-doc-date-string                                                               format "X(28)"
     7104                     skip "Продавец : " at 10 format "X(20)"
     7105                     skip v-torgconf-self-host-inn + " " + Our_Host.obj-name + ", " + Our_Object.obj-name + "(" + string(Our_Object.obj-code) + ")"                     at 12   format "X(108)"
     7106                     skip "Адрес : " at 10 format "X(20)"
     7107                     skip v-torgconf-self-host-addres          at 12   format "X(108)"
     7108                     skip "Покупатель : " at 10 format "X(20)"
     7109                     skip sch_clients.obj-name at 12 format "X(40)"
     7110                     skip(1)
     7111                 .
     7112       run outretxl-write-cell-data in this-procedure (
     7113             input "h_docName":U
     7114           , input string("Т О В А Р Н Ы Й  Ч Е К  N ")
     7115       ).
     7116       run outretxl-write-cell-data in this-procedure (
     7117             input "h_docCode":U
     7118           , input v-doc-code
     7119       ).
     7120       run outretxl-write-cell-data in this-procedure (
     7121             input "h_docDate":U
     7122           , input v-doc-date-string
     7123       ).
     7124       run outretxl-write-cell-data in this-procedure (
     7125             input "h_cliFrom":U
     7126           , input "Продавец : " + v-torgconf-self-host-inn + " " + Our_Host.obj-name + ", " + Our_Object.obj-name + "(" + string(Our_Object.obj-code) + ")"
     7127       ).
     7128       run outretxl-write-cell-data in this-procedure (
     7129             input "h_cliTo":U
     7130           , input "Покупатель : " + sch_clients.obj-name
     7131       ).
     7132     end.
     7133     else do:
     7134       case t-doc.doc-type :
     7135         when 'возврат':U then do:
     7136           if t-doc.internal then put stream Out_stream  "В Н У Т Р Е Н Н Е Е  ПЕРЕМЕЩЕНИЕ - В О З В Р А Т  N " at 22 format "X(60)" .
     7137           else                   put stream Out_stream  "В О З В Р А Т Н А Я   Н А К Л А Д Н А Я   N " at 32 format "X(50)" .
     7138           put stream Out_stream
     7139                     v-doc-code                                                                      format "X(14)"
     7140                     "  от  "
     7141                     v-doc-date-string                                                               format "X(28)"
     7142                     skip(2) "Отправитель :"                                                 at 10   format "X(20)"
     7143                     skip string( sch_clients.obj-name + "(" + string(sch_clients.obj-code) + ")" )  at 12   format "X(108)"
     7144                     skip "Получатель  : " at 10 format "X(20)"
     7145                     skip Our_Host.obj-name + ", " + Our_Object.obj-name                     at 12   format "X(108)"
     7146                     skip(1)
     7147                 .
     7148           if t-doc.internal then
     7149             run outretxl-write-cell-data in this-procedure (
     7150                 input "h_docName":U
     7151               , input "В Н У Т Р Е Н Н Е Е  ПЕРЕМЕЩЕНИЕ - В О З В Р А Т  N "
     7152             ).
     7153           else
     7154             run outretxl-write-cell-data in this-procedure (
     7155                 input "h_docName":U
     7156               , input "В О З В Р А Т Н А Я   Н А К Л А Д Н А Я  N "
     7157             ).
     7158           run outretxl-write-cell-data in this-procedure (
     7159                 input "h_docCode":U
     7160               , input v-doc-code
     7161           ).
     7162           run outretxl-write-cell-data in this-procedure (
     7163                 input "h_docDate":U
     7164               , input v-doc-date-string
     7165           ).
     7166           run outretxl-write-cell-data in this-procedure (
     7167                 input "h_cliFrom":U
     7168               , input string( "Отправитель : " + sch_clients.obj-name + "(" + string(sch_clients.obj-code) + ")" )
     7169           ).
     7170           run outretxl-write-cell-data in this-procedure (
     7171                 input "h_cliTo":U
     7172               , input "Получатель  :" + Our_Host.obj-name + ", " + Our_Object.obj-name
     7173           ).
     7174           if CostPrice then do:
     7175             put stream Out_stream space(10) "Указаны УЧЕТНЫЕ цены"      format "X(50)"  skip(2) .
     7176             run outretxl-write-cell-data in this-procedure (
     7177                 input "h_CostPrice":U
     7178               , input "Указаны УЧЕТНЫЕ цены"
     7179             ).
     7180           end.
     7181         end.
     7182         when 'спи':U then do:
     7183           put stream Out_stream
     7184                     skip(1) "С П И С А Н И Е   N "                                          at 32   format "X(22)"
     7185                     v-doc-code                                                                      format "X(14)"
     7186                     "  от  "
     7187                     v-doc-date-string                                                               format "X(28)"
     7188                     skip(2) "Отправитель  :"                                                at 10   format "X(20)"
     7189                     skip Our_Host.obj-name + ", " + Our_Object.obj-name                     at 12   format "X(108)"
     7190                     skip "Получатель   :"                                                   at 10   format "X(20)"
     7191                     skip sch_clients.obj-name                                                   at 12   format "X(108)"
     7192                 .
     7193           run outretxl-write-cell-data in this-procedure (
     7194                 input "h_docName":U
     7195               , input "С П И С А Н И Е  N "
     7196           ).
     7197           run outretxl-write-cell-data in this-procedure (
     7198                 input "h_docCode":U
     7199               , input v-doc-code
     7200           ).
     7201           run outretxl-write-cell-data in this-procedure (
     7202                 input "h_docDate":U
     7203               , input v-doc-date-string
     7204           ).
     7205           run outretxl-write-cell-data in this-procedure (
     7206                 input "h_cliFrom":U
     7207               , input string( "Отправитель : " + Our_Host.obj-name + ", " + Our_Object.obj-name )
     7208           ).
     7209           run outretxl-write-cell-data in this-procedure (
     7210                 input "h_cliTo":U
     7211               , input "Получатель  :" + sch_clients.obj-name
     7212           ).
     7213         end.
     7214         when 'рас':U then do:
     7215           if  t-doc.internal then do:
     7216             assign
     7217               v-firm-string = substitute( "&1, ", Our_Host.obj-name )
     7218             .
     7219             put stream Out_stream "В Н У Т Р Е Н Н Е Е  ПЕРЕМЕЩЕНИЕ - Р А С Х О Д   N " at 22 format "X(55)"  v-doc-code format "X(14)" .
     7220             run outretxl-write-cell-data in this-procedure (
     7221                 input "h_docName":U
     7222               , input "В Н У Т Р Е Н Н Е Е  ПЕРЕМЕЩЕНИЕ - Р А С Х О Д  N "
     7223             ).
     7224           end.
     7225           else do:
     7226             assign
     7227               v-firm-string = "":U
     7228             .
     7229             if t-doc.office then do:
     7230               put stream Out_stream "А К Т  П Р И Е М К И - П Е Р Е Д А Ч И  Р А Б О Т / У С Л У Г   N " at 22 format "X(70)"  v-doc-code format "X(14)" .
     7231               run outretxl-write-cell-data in this-procedure (
     7232                   input "h_docName":U
     7233                 , input "А К Т  П Р И Е М К И - П Е Р Е Д А Ч И  Р А Б О Т / У С Л У Г  N "
     7234               ).
     7235             end.
     7236             else do:
     7237               put stream Out_stream "Р А С Х О Д Н А Я   Н А К Л А Д Н А Я   N " at 32 format "X(45)" v-doc-code format "X(14)" .
     7238               run outretxl-write-cell-data in this-procedure (
     7239                   input "h_docName":U
     7240                 , input "Р А С Х О Д Н А Я   Н А К Л А Д Н А Я  N "
     7241               ).
     7242             end.
     7243           end.
     7244           put stream Out_stream
     7245                     "  от  "  v-doc-date-string                                                     format "X(28)"
     7246                     skip(1) "Отправитель  :"                                                at 10   format "X(20)"
     7247                     skip Our_Host.obj-name + ", " + Our_Object.obj-name                     at 12   format "X(108)"
     7248                     skip "Получатель   :"                                                   at 10   format "X(20)"
     7249                     skip string( v-firm-string + sch_clients.obj-name + "(" + string(sch_clients.obj-code) + ")" )  at 12   format "X(108)"
     7250                     skip(1)
     7251                 .
     7252           run outretxl-write-cell-data in this-procedure (
     7253                 input "h_docCode":U
     7254               , input v-doc-code
     7255           ).
     7256           run outretxl-write-cell-data in this-procedure (
     7257                 input "h_docDate":U
     7258               , input v-doc-date-string
     7259           ).
     7260           run outretxl-write-cell-data in this-procedure (
     7261                 input "h_cliFrom":U
     7262               , input "Отправитель : " + Our_Host.obj-name + ", " + Our_Object.obj-name
     7263           ).
     7264           run outretxl-write-cell-data in this-procedure (
     7265                 input "h_cliTo":U
     7266               , input string( "Получатель : " + sch_clients.obj-name + "(" + string(sch_clients.obj-code) + ")" )
     7267           ).
     7268           if CostPrice then do:
     7269             put stream Out_stream space(10) "Указаны УЧЕТНЫЕ цены"      format "X(50)"  skip(2) .
     7270             run outretxl-write-cell-data in this-procedure (
     7271                 input "h_CostPrice":U
     7272               , input "Указаны УЧЕТНЫЕ цены"
     7273             ).
     7274           end.
     7275         end.
     7276       end case .
     7277       Find buf_pay-type Where buf_pay-type.Obj-code = T-doc.Pay-code No-lock No-error.
     7278       Put Stream Out_Stream String( "Вид оплаты : " + ( If Available buf_pay-type Then buf_pay-type.Obj-name Else "?" ) ) At 10 Format "X(60)" Skip.
     7279       run outretxl-write-cell-data in this-procedure (
     7280           input "h_PayType":U
     7281         , input ( If Available buf_pay-type Then buf_pay-type.Obj-name Else "?" )
     7282       ).
     7283       If V-torgconf-outprim = No or t-doc.internal Then Do:
     7284         Put Stream Out_Stream  String( "Примечание : " + ( If ( Not Can-do( 'факт':U, T-doc.Status_ ) Or Logres ) And Not ( T-doc.Ps Begins "@" ) Then  T-doc.Ps Else " " ) ) At 10 Format "X(100)" Skip .
     7285         run outretxl-write-cell-data in this-procedure (
     7286             input "h_PS":U
     7287           , input ( If ( Not Can-do( 'факт':U, T-doc.Status_ ) Or Logres ) And Not ( T-doc.Ps Begins "@" ) Then  T-doc.Ps Else " " )
     7288         ).
     7289       End.
     7290       run torgconf-get-reason in this-procedure ( input t-doc.doc-code, input t-doc.reason-code,  input t-doc.doc-type ) .
     7291       put stream Out_Stream
     7292           space(5) string( "Основание: " + v-torgconf-reason ) at 10 format "X(100)" skip
     7293       .
     7294       run outretxl-write-cell-data in this-procedure (
     7295             input "h_reason":U
     7296           , input v-torgconf-reason
     7297       ).
     7298     end.
     7299     end.
     7300   end procedure.
     7301   procedure print-itog :
     7302     do on error undo, return error return-value :
     7303         define variable v-oper-name    as character    no-undo.
     7304       put stream out_stream Line format "X(134)" skip .
     7305       if PrintRubl then do:
     7306         display stream out_stream
     7307           sym1 sym2 sym3 sym4 "ИТОГО: " @ gds_name sym5 sym6 sym7 all-qnty @ qnty sym8 all-stoim @ stoim  sym10
     7308         with frame rubl.
     7309         down stream out_stream with frame rubl .
     7310       end.
     7311       else do:
     7312         display stream out_stream
     7313           sym1 sym2 sym3 sym4 "ИТОГО: " @ gds_name sym5 sym6 sym7 all-qnty @ qnty sym8 all-stoim @ stoim  sym10
     7314         with frame val.
     7315         down stream out_stream with frame val .
     7316       end.
     7317       put stream out_stream Line format "X(134)" skip .
     7318       run outretxl-write-cell-data in this-procedure (
     7319             input "it_qnty":U
     7320           , input string( all-qnty )
     7321       ).
     7322       run outretxl-write-cell-data in this-procedure (
     7323             input "it_sum":U
     7324           , input string( all-stoim )
     7325       ).
     7326       if line-counter( Out_stream ) + 16 > page-size( Out_stream ) then  page stream Out_stream .
     7327       put stream Out_stream skip(1) space(5) "Всего " format "x(8)" all-qnty format ">,>>>,>>9.<<<"
     7328         space(2) "единицы" format "x(8)" space(2) Lines_Counter format ">,>>>,>>9" space(2) "наименований" format "x(13)"
     7329                                                 "на сумму"  all-stoim  format ">,>>>,>>>,>>>,>>9.99"  " "  ( if not PrintRubl then buf_currency.curr-abbr else "РУБ" )
     7330         skip(1).
     7331       run outretxl-write-cell-data in this-procedure (
     7332             input "f_lineAmount":U
     7333           , input string( "Всего " + string(all-qnty,">,>>>,>>9.<<<") + " единицы " + string(Lines_Counter,">,>>>,>>9") + " наименований  на сумму " + string(all-stoim,">,>>>,>>>,>>>,>>9.99") + " " +  ( if not PrintRubl then buf_currency.curr-abbr else "РУБ" ) )
     7334       ).
     7335       if v-torgconf-outdisc = no and not CostPrice then do:
     7336         put stream Out_stream space(5) "Скидка " format "x(8)"
     7337           ( if t-doc.tot-calc <> 0 and t-doc.discnt-pc = 0 then " " else string( string( t-doc.discnt-pc, "->>9.9" ) + "%" ) )
     7338           space(2) "на сумму"                                                        format "x(10)"
     7339           space(2) ( if not PrintRubl then t-doc.tot-calc else t-doc.discnt-rubl )   format "->>>,>>>,>>>,>>9.99"
     7340           space(2) ( if not PrintRubl then buf_currency.curr-abbr else "РУБ" )                    format "x(4)" skip(1)
     7341         .
     7342         if t-doc.discnt-pc <> 0 then
     7343           run outretxl-write-cell-data in this-procedure (
     7344                 input "f_Skidka":U
     7345               , input string( "Скидка " + string( t-doc.discnt-pc, "->>9.9" ) + "%  на сумму  "  + string(( if not PrintRubl then t-doc.tot-calc else t-doc.discnt-rubl ),"->>>,>>>,>>>,>>9.99") )
     7346           ).
     7347       end.
     7348       if can-do( 'факт':U , t-doc.status_ ) or
     7349          ( can-do( 'рас':U , t-doc.doc-type ) and can-do( 'накл,запрос':U , t-doc.status_ ) and
     7350          ( not t-doc.internal ) ) then do:
     7351         if not PrintRubl then run rep/wp.p (     input ParParentProc, input all-stoim, output s1, output s2 ) .
     7352         else                  run rep/wp-rub.p (                      input all-stoim, output s1, output s2 ) .
     7353         if can-do( 'возврат':U , t-doc.doc-type ) then put stream Out_stream space(5) "Итого " format "x(6)" .
     7354         else                                         put stream Out_stream space(5) "Итого к оплате " format "x(17)" .
     7355         if v-torgconf-outdisc = no and not CostPrice then put stream Out_stream "( с учетом скидки ) " format "x(22)" .
     7356         put stream Out_stream all-stoim format "->>>,>>>,>>>,>>9.99" space(1) trim(s2) format "x(4)".
     7357         run outretxl-write-cell-data in this-procedure (
     7358               input "f_SumAll":U
     7359             , input string( all-stoim,"->>>,>>>,>>>,>>9.99")
     7360         ).
     7361         run outretxl-write-cell-data in this-procedure (
     7362               input "f_SumAllLiteral":U
     7363             , input s1
     7364         ).
     7365         put stream Out_stream skip(1) space(10) caps(s1) format "x(126)" skip(1) .
     7366         put stream Out_stream  space(5)  "В том числе: " format "x(25)" skip.
     7367         define variable str-nal as character no-undo .
     7368         for each temp-nalog break by temp-nalog.slt-prc by temp-nalog.vat-prc:
     7369           put stream Out_stream
     7370               string( "НДС " + string( temp-nalog.vat-prc, ">>9.<<%")) at 10 format "X(12)"
     7371               ":"  + string( temp-nalog.VAT-sum , "->>>,>>>,>>9.99" ) at 25 format "X(18)"   trim(s2)  " от суммы " format "X(10)"
     7372                string( temp-nalog.from-sum , "->>>,>>>,>>9.99" )  at 65 format "X(16)"   trim(s2) skip
     7373           .
     7374           if str-nal <> "" then assign str-nal = str-nal + "\n" .
     7375           assign
     7376             str-nal = str-nal +
     7377             string( "НДС " + string( temp-nalog.vat-prc, ">>9.<<%")) +  ":" + string( temp-nalog.VAT-sum , "->>,>>>,>>9.99" ) + " " + trim(s2) + " от суммы "
     7378             + string( temp-nalog.from-sum , "->>>,>>>,>>9.99" ) + " " + trim(s2)
     7379           .
     7380         end.
     7381         run outretxl-write-cell-data in this-procedure (
     7382               input "f_Nalog":U
     7383             , input str-nal
     7384         ).
     7385         if is-chek then do:
     7386           put stream Out_stream space(10)  "М П" format "x(60)"  "Подпись : " format "x(50)" skip(1) .
     7387         end.
     7388         else do:
     7389           if can-do( 'рас':U , t-doc.doc-type ) and ( not t-doc.internal )
     7390               and ( ( can-do( 'запрос':U , t-doc.status_ )
     7391               or ( can-do( 'накл':U , t-doc.status_ ) and t-doc.flag_ ) ) )
     7392               or t-doc.status_ = 'факт':U
     7393           then do:
     7394             if t-doc.office then do:
     7395               put stream Out_stream  "Заказчик :    ______________/_____________ / " space(20)  "Исполнитель : ______________/_____________ /"  .
     7396             end.
     7397             else do:
     7398               put stream Out_stream space(10)  "Сдал : " format "x(60)"  "Принял : " format "x(50)" skip(1) .
     7399             end.
     7400           end.
     7401           else do:
     7402             put stream Out_stream space(30) "--- Н Е   П О Д П И С Ы В А Т Ь ! ---" format "X(75)" skip(1) .
     7403           end.
     7404         end.
     7405       end.
     7406       run rep/get-psn.p
     7407         (input t-doc.boss
     7408         ,output boss-name
     7409         ) .
     7410       run rep/get-psn.p
     7411         (input t-doc.wrkr
     7412         ,output Wrkr_name
     7413         ) .
     7414   define variable vss-include-info46 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7415   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usrnick in g#library
     7416     (input  t-doc.creid
     7417     ,output v-oper-name
     7418     )  .
     7419       if boss-name = ? then boss-name = " " .
     7420       if Wrkr_name = ? then Wrkr_name = " " .
     7421       put stream Out_stream "Документ оформил: " skip  "Оператор: "  v-oper-name  skip "Кладовщик: "  Wrkr_name skip "Менеджер: "  boss-name skip.
     7422       run outretxl-write-cell-data in this-procedure (
     7423             input "f_OperName":U
     7424           , input v-oper-name
     7425       ).
     7426       run outretxl-write-cell-data in this-procedure (
     7427             input "f_KladName":U
     7428           , input Wrkr_name
     7429       ).
     7430       run outretxl-write-cell-data in this-procedure (
     7431             input "f_MngrName":U
     7432           , input boss-name
     7433       ).
     7434       put stream Out_stream space(65) ( if v-torgconf-outdate = no then string( t-doc.fact-date, "99/99/9999" ) else "" )  format "X(10)"  skip .
     7435       run outretxl-write-cell-data in this-procedure (
     7436             input "f_Date":U
     7437           , input ( if v-torgconf-outdate = no then string( t-doc.fact-date, "99/99/9999" ) else "" )
     7438       ).
     7439       hide stream Out_stream frame Bottomframe .
     7440     end.
     7441   end procedure.
