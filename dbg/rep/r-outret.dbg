        1   block-level on error undo, throw.
        2   define input parameter parParentProc     AS WIDGET-HANDLE NO-UNDO.
        3   define input parameter rec_id       as recid        no-undo.
        4   define input  parameter is-chek     as logical   no-undo .
        5   define input parameter p-mode               as character        no-undo.
        6   define variable vss-revision    as character no-undo initial "$Revision: aea5316774be, 0, rls $":U .
        7   define variable vss-author      as character no-undo initial "$Author: expertek $":U .
        8   define variable vss-date        as character no-undo initial "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        9   define variable vss-workfile    as character no-undo initial "$Workfile: r-outret.p $":U .
       10   define variable vss-archive     as character no-undo initial "$Archive: rep/r-outret.p $":U .
       11   define variable vss-description as character no-undo initial "Документ расхода и списания короткий":U .
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define new global shared variable g#library  as handle no-undo .
       71   define new global shared variable g#library2 as handle no-undo .
       72   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       73   define  shared variable PrintCopiesCounter as integer   no-undo initial 1 .
       74   define  shared variable RepPathName        as character no-undo .
       75   define  shared variable PrintRubl          as logical   no-undo .
       76   define variable vss-include-info1 as character format "X(65)" no-undo
       77   initial "@(#)$Workfile$ $Revision$".
       78   define variable v-fmtcli-name          as character    no-undo.
       79   define variable v-fmtcli-engl-name     as character    no-undo.
       80   define variable v-fmtcli-addres        as character    no-undo.
       81   define variable v-fmtcli-post-addres   as character    no-undo.
       82   define variable v-fmtcli-full-addres   as character    no-undo.
       83   define variable v-fmtcli-phone         as character    no-undo.
       84   define variable v-fmtcli-inn           as character    no-undo.
       85   define variable v-fmtcli-kpp           as character    no-undo.
       86   define variable v-fmtcli-okpo          as character    no-undo.
       87   define variable v-fmtcli-country       as character    no-undo.
       88   define variable v-fmtcli-city          as character    no-undo.
       89   define variable v-fmtcli-index         as character    no-undo.
       90   define variable v-fmtcli-schet-exists  as logical      no-undo.
       91   define variable v-fmtcli-bank-exists   as logical      no-undo.
       92   define variable v-fmtcli-bank-r-schet  as character    no-undo.
       93   define variable v-fmtcli-bank-c-schet  as character    no-undo.
       94   define variable v-fmtcli-bank-bik      as character    no-undo.
       95   define variable v-fmtcli-bank-name     as character    no-undo.
       96   define variable v-fmtcli-bank-addres   as character    no-undo.
       97   define variable v-fmtcli-bank-city     as character    no-undo.
       98   procedure fmtcli-get-bank :
       99   define input parameter p-host-code      as integer          no-undo.
      100   define input parameter p-obj-type       as character        no-undo.
      101   define input parameter p-obj-code       as integer          no-undo.
      102   define input parameter p-curr-code      as integer          no-undo.
      103       define buffer buf_fin-schet     for ub.fin-schet.
      104       define buffer buf_fin-bank      for ub.fin-bank.
      105   do
      106   for buf_fin-schet
      107     , buf_fin-bank
      108   on error undo, return error
      109   :
      110       assign
      111           v-fmtcli-schet-exists       = no
      112           v-fmtcli-bank-exists        = no
      113           v-fmtcli-bank-r-schet       = "":U
      114           v-fmtcli-bank-c-schet       = "":U
      115           v-fmtcli-bank-bik           = "":U
      116           v-fmtcli-bank-name          = "":U
      117           v-fmtcli-bank-addres        = "":U
      118           v-fmtcli-bank-city          = "":U
      119       .
      120       search-for-schet:
      121       for each buf_fin-schet no-lock
      122          where buf_fin-schet.host-code = p-host-code
      123            and buf_fin-schet.cli-type  = p-obj-type
      124            and buf_fin-schet.cli-code  = p-obj-code
      125            and buf_fin-schet.curr-code = p-curr-code
      126       on error undo, return error
      127       :
      128           if buf_fin-schet.status_   = 'удал':U
      129           then do:
      130           end.
      131           else do:
      132               assign
      133                   v-fmtcli-schet-exists   = yes
      134                   v-fmtcli-bank-r-schet   = trim( buf_fin-schet.r-schet )
      135                   v-fmtcli-bank-c-schet   = trim( buf_fin-schet.c-schet )
      136               .
      137               find first buf_fin-bank no-lock
      138                    where buf_fin-bank.host-code = p-host-code
      139                      and buf_fin-bank.code-bank = buf_fin-schet.code-bank
      140               no-error.
      141               if available buf_fin-bank
      142               then do:
      143                   assign
      144                       v-fmtcli-bank-exists      = yes
      145                       v-fmtcli-bank-bik         = trim( buf_fin-bank.bik )
      146                       v-fmtcli-bank-name        = trim( buf_fin-bank.bank-name )
      147                       v-fmtcli-bank-addres      = trim(buf_fin-bank.addres)
      148                       v-fmtcli-bank-city      = trim(buf_fin-bank.bank-city)
      149                   .
      150               end.
      151               else do:
      152                   assign
      153                       v-fmtcli-bank-exists    = no
      154                       v-fmtcli-bank-bik       = "":U
      155                       v-fmtcli-bank-name      = "":U
      156                       v-fmtcli-bank-addres    = "":U
      157                       v-fmtcli-bank-city      = "":U
      158                   .
      159               end.
      160               leave search-for-schet.
      161           end.
      162       end.
      163   end.
      164   end procedure.
      165   procedure fmtcli-get-client :
      166   define input parameter p-obj-type       as character    no-undo.
      167   define input parameter p-obj-code       as integer      no-undo.
      168       define variable v-temp-fmtcli-address      as character     no-undo.
      169       define variable v-num-country-city    as integer      no-undo.
      170       define buffer buf_clients   for ub.clients.
      171       define buffer buf_firm      for ub.firm.
      172       define buffer buf_store     for ub.store.
      173       define buffer buf_shop      for ub.shop.
      174       define buffer buf_person    for ub.person.
      175   do
      176   for buf_clients
      177     , buf_firm
      178     , buf_store
      179     , buf_shop
      180     , buf_person
      181   on error undo, return error
      182   :
      183       assign
      184           v-fmtcli-name           = "":U
      185           v-fmtcli-addres         = "":U
      186           v-fmtcli-post-addres    = "":U
      187           v-fmtcli-full-addres    = "":U
      188           v-fmtcli-phone          = "":U
      189           v-fmtcli-inn            = "":U
      190           v-fmtcli-kpp            = "":U
      191           v-fmtcli-okpo           = "":U
      192           v-fmtcli-city           = "":U
      193           v-fmtcli-index          = "":U
      194           v-fmtcli-country        = "":U
      195       .
      196       find first buf_clients no-lock
      197            where buf_clients.obj-type = p-obj-type
      198              and buf_clients.obj-code = p-obj-code
      199       .
      200       assign
      201           v-fmtcli-name = buf_clients.obj-name
      202       .
      203       case buf_clients.obj-type:
      204          when 'орг':U
      205          then do:
      206               find first buf_firm no-lock
      207                    where buf_firm.firm-code = buf_clients.obj-code
      208                    no-error
      209               .
      210               if available buf_firm
      211               then do:
      212                   assign
      213                       v-num-country-city = num-entries( buf_firm.city )
      214                       v-fmtcli-engl-name = buf_firm.engl-name
      215                   .
      216                   if v-num-country-city > 0
      217                   then do:
      218                       assign
      219                           v-fmtcli-country    = trim( entry( 1, buf_firm.city ) )
      220                       .
      221                   end.
      222                   if v-num-country-city > 1
      223                   then do:
      224                       assign
      225                           v-fmtcli-city       = trim( entry( 2, buf_firm.city ) )
      226                       .
      227                   end.
      228                   run fmtcli-concatenate-strings in this-procedure (
      229                         input v-fmtcli-full-addres
      230                       , input v-fmtcli-country
      231                       , input ", ":U
      232                       , input 50
      233                       , output v-fmtcli-full-addres
      234                   ).
      235                   run fmtcli-concatenate-strings in this-procedure (
      236                         input v-fmtcli-full-addres
      237                       , input v-fmtcli-city
      238                       , input ", ":U
      239                       , input 50
      240                       , output v-fmtcli-full-addres
      241                   ).
      242                   run fmtcli-concatenate-strings in this-procedure (
      243                         input v-fmtcli-full-addres
      244                       , input IF buf_firm.ind = 0 THEN "" ELSE string( buf_firm.ind )
      245                       , input ", ":U
      246                       , input 50
      247                       , output v-fmtcli-full-addres
      248                   ).
      249                   run fmtcli-concatenate-strings in this-procedure (
      250                         input v-fmtcli-post-addres
      251                       , input v-fmtcli-country
      252                       , input ", ":U
      253                       , input 50
      254                       , output v-fmtcli-post-addres
      255                   ).
      256                   run fmtcli-concatenate-strings in this-procedure (
      257                         input v-fmtcli-post-addres
      258                       , input v-fmtcli-city
      259                       , input ", ":U
      260                       , input 50
      261                       , output v-fmtcli-post-addres
      262                   ).
      263                   run fmtcli-concatenate-strings in this-procedure (
      264                         input v-fmtcli-post-addres
      265                       , input string( buf_firm.ind )
      266                       , input ", ":U
      267                       , input 50
      268                       , output v-fmtcli-post-addres
      269                   ).
      270                   run fmtcli-concatenate-strings in this-procedure (
      271                         input substring( buf_firm.addres1, 1, 50 )
      272                       , input buf_firm.addres2
      273                       , input " ":U
      274                       , input 50
      275                       , output v-temp-fmtcli-address
      276                   ).
      277                   run fmtcli-concatenate-strings in this-procedure (
      278                         input v-temp-fmtcli-address
      279                       , input substring( buf_firm.addres1, 51, 50 )
      280                       , input " ":U
      281                       , input 50
      282                       , output v-temp-fmtcli-address
      283                   ).
      284                   run fmtcli-concatenate-strings in this-procedure (
      285                         input v-temp-fmtcli-address
      286                       , input substring( buf_firm.addres1, 101, 50 )
      287                       , input " ":U
      288                       , input 50
      289                       , output v-temp-fmtcli-address
      290                   ).
      291                   assign
      292                       v-fmtcli-addres = v-temp-fmtcli-address
      293                   .
      294                   if buf_firm.addres1 <> ?
      295                   then do:
      296                       run fmtcli-concatenate-strings in this-procedure (
      297                             input v-fmtcli-full-addres
      298                           , input v-fmtcli-addres
      299                           , input ", ":U
      300                           , input 0
      301                           , output v-fmtcli-full-addres
      302                       ).
      303                   end.
      304                   run fmtcli-concatenate-strings in this-procedure (
      305                         input substring( buf_firm.post-addr1, 1, 50 )
      306                       , input buf_firm.post-addr2
      307                       , input " ":U
      308                       , input 50
      309                       , output v-fmtcli-post-addres
      310                   ).
      311                   run fmtcli-concatenate-strings in this-procedure (
      312                         input v-fmtcli-post-addres
      313                       , input substring( buf_firm.post-addr1, 51, 50 )
      314                       , input " ":U
      315                       , input 50
      316                       , output v-fmtcli-post-addres
      317                   ).
      318                   run fmtcli-concatenate-strings in this-procedure (
      319                         input v-fmtcli-post-addres
      320                       , input substring( buf_firm.post-addr1, 101, 50 )
      321                       , input " ":U
      322                       , input 50
      323                       , output v-fmtcli-post-addres
      324                   ).
      325                   assign
      326                       v-fmtcli-phone         = buf_firm.phone
      327                       v-fmtcli-inn           = buf_firm.inn
      328                       v-fmtcli-kpp           = buf_firm.kpp
      329                       v-fmtcli-okpo          = buf_firm.okpo
      330                       v-fmtcli-index         = string( buf_firm.ind )
      331                   .
      332               end.
      333          end.
      334          when 'маг':U
      335          then do:
      336               find first buf_shop no-lock
      337                    where buf_shop.obj-code = buf_clients.obj-code
      338               .
      339               if available buf_shop
      340               then do:
      341                   run fmtcli-concatenate-strings in this-procedure (
      342                         input buf_shop.addres1
      343                       , input buf_shop.addres2
      344                       , input " ":U
      345                       , input 50
      346                       , output v-fmtcli-addres
      347                   ).
      348                   assign
      349                       v-fmtcli-full-addres = v-fmtcli-addres
      350                       v-fmtcli-post-addres = v-fmtcli-addres
      351                       v-fmtcli-phone       = buf_shop.phone
      352                       v-fmtcli-inn         = "":U
      353                       v-fmtcli-kpp         = "":U
      354                       v-fmtcli-okpo        = "":U
      355                       v-fmtcli-city        = "":U
      356                       v-fmtcli-index       = "":U
      357                   .
      358               end.
      359          end.
      360          when 'скл':U
      361          then do:
      362               find first buf_store no-lock
      363                    where buf_store.obj-code = buf_clients.obj-code
      364               .
      365               if available buf_store
      366               then do:
      367                   run fmtcli-concatenate-strings in this-procedure (
      368                         input buf_store.addres1
      369                       , input buf_store.addres2
      370                       , input " ":U
      371                       , input 50
      372                       , output v-fmtcli-addres
      373                   ).
      374                   assign
      375                       v-fmtcli-full-addres = v-fmtcli-addres
      376                       v-fmtcli-phone       = buf_store.phone
      377                       v-fmtcli-inn         = "":U
      378                       v-fmtcli-kpp         = "":U
      379                       v-fmtcli-okpo        = "":U
      380                       v-fmtcli-city        = "":U
      381                       v-fmtcli-index       = "":U
      382                   .
      383               end.
      384          end.
      385          when 'чел':U
      386          then do:
      387               find first buf_person no-lock
      388                    where buf_person.psn-code = buf_clients.obj-code
      389               .
      390               if available buf_person
      391               then do:
      392                   run fmtcli-concatenate-strings in this-procedure (
      393                         input ( if buf_person.ind = 0 or buf_person.ind = ?
      394                                 then "":U
      395                                 else string( buf_person.ind, "999999")
      396                                 )
      397                       , input buf_person.city
      398                       , input ", ":U
      399                       , input 0
      400                       , output v-fmtcli-full-addres
      401                   ).
      402                   assign
      403                       v-fmtcli-addres = buf_person.address
      404                   .
      405                   run fmtcli-concatenate-strings in this-procedure (
      406                         input v-fmtcli-full-addres
      407                       , input v-fmtcli-addres
      408                       , input ", ":U
      409                       , input 0
      410                       , output v-fmtcli-full-addres
      411                   ).
      412                   assign
      413                       v-fmtcli-phone     = buf_person.phone1
      414                       v-fmtcli-inn       = buf_person.inn
      415                       v-fmtcli-kpp       = buf_person.kpp
      416                       v-fmtcli-okpo      = buf_person.okpo
      417                       v-fmtcli-city      = buf_person.city
      418                       v-fmtcli-index     = string( buf_person.ind )
      419                   .
      420               end.
      421          end.
      422       end case.
      423   end.
      424   end procedure.
      425   procedure fmtcli-concatenate-strings :
      426   define input parameter p-string-1       as character        no-undo.
      427   define input parameter p-string-2       as character        no-undo.
      428   define input parameter p-delimiter      as character        no-undo.
      429   define input parameter p-length         as integer          no-undo.
      430   define output parameter p-out-string    as character        no-undo.
      431   do
      432   on error undo, return error
      433   :
      434       assign
      435           p-out-string = ( if p-string-1 = ?
      436                            then "":U
      437                            else trim( p-string-1 ) )
      438       .
      439       assign
      440           p-out-string = p-out-string
      441                        + ( if p-out-string = "":U
      442                            or length( p-out-string ) = p-length
      443                            or p-string-2 = ?
      444                            or trim( p-string-2 ) = "":U
      445                            then "":U
      446                            else p-delimiter )
      447                        + ( if p-string-2 = ?
      448                            or trim( p-string-2 ) = "":U
      449                            then "":U
      450                            else trim( p-string-2 ) )
      451       .
      452   end.
      453   end procedure.
      454   def var vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      455   define new global shared variable g#attr-lib  as handle no-undo .
      456   define variable v-attr-lib-variable as handle no-undo .
      457   procedure clntattr-code :
      458     define input  parameter p-code           as character no-undo .
      459     define output parameter p-type           as character no-undo .
      460     define output parameter p-format         as character no-undo .
      461     define output parameter p-label          as character no-undo .
      462     define output parameter p-user-can-edit  as logical   no-undo .
      463     define output parameter p-output-display as logical   no-undo .
      464     define output parameter p-other          as character no-undo .
      465     do
      466     on error undo, return error return-value
      467     :
      468           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run clntattr-code in g#attr-lib
      469         (input  p-code
      470         ,output p-type
      471         ,output p-format
      472         ,output p-label
      473         ,output p-user-can-edit
      474         ,output p-output-display
      475         ,output p-other
      476         ) no-error .
      477       if error-status :error
      478       then do:
      479         undo, return error return-value .
      480       end.
      481     end.
      482   end procedure.
      483   procedure clntattr-tooltip :
      484     define input  parameter p-code    as character no-undo .
      485     define output parameter p-tooltip as character no-undo .
      486     define output parameter p-label   as character no-undo .
      487     do
      488     on error undo, return error return-value
      489     :
      490           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run clntattr-tooltip in g#attr-lib
      491         (input  p-code
      492         ,output p-tooltip
      493         ,output p-label
      494         ) no-error .
      495       if error-status :error
      496       then do:
      497         undo, return error return-value .
      498       end.
      499     end.
      500   end procedure.
      501   procedure clntattr-value :
      502     define input  parameter p-obj-type like ub.clients-attr.obj-type   no-undo .
      503     define input  parameter p-obj-code like ub.clients-attr.obj-code   no-undo .
      504     define input  parameter p-code     like ub.clients-attr.attr-code  no-undo .
      505     define output parameter p-value    like ub.clients-attr.attr-value no-undo .
      506     define output parameter p-type     as character no-undo .
      507     do
      508     on error undo, return error return-value
      509     :
      510           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run clntattr-value in g#attr-lib
      511         (input  p-obj-type
      512         ,input  p-obj-code
      513         ,input  p-code
      514         ,output p-value
      515         ,output p-type
      516         ) no-error .
      517       if error-status :error
      518       then do:
      519         undo, return error return-value .
      520       end.
      521     end.
      522   end procedure.
      523   procedure clntattr-write :
      524     define input  parameter p-obj-type like ub.clients-attr.obj-type   no-undo .
      525     define input  parameter p-obj-code like ub.clients-attr.obj-code   no-undo .
      526     define input  parameter p-code     like ub.clients-attr.attr-code  no-undo .
      527     define input  parameter p-value    like ub.clients-attr.attr-value no-undo .
      528     do
