     1261   end.
     1262   end.
     1263   end procedure.
     1264   procedure torgconf-get-self-param :
     1265   define input parameter p-obj-type           as character        no-undo.
     1266   define input parameter p-obj-code           as integer          no-undo.
     1267   define input parameter p-curr-code          as integer          no-undo.
     1268       define variable v-host-code    as integer      no-undo.
     1269       define variable v-par-type     as character    no-undo.
     1270   do
     1271   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message(1))
     1272   :
     1273   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1274   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1275     (input  p-obj-type
     1276     ,input  p-obj-code
     1277     ,output v-host-code
     1278     )  .
     1279       if v-torgconf-outhold = yes
     1280       then do:
     1281           run torgconf-get-holdfirm-code in this-procedure (
     1282                 input p-obj-type
     1283               , input p-obj-code
     1284               , output v-torgconf-self-host-code
     1285           ).
     1286           if v-torgconf-self-host-code = 0
     1287           then do:
     1288               return error.
     1289           end.
     1290       end.
     1291       else do:
     1292           assign
     1293               v-torgconf-self-host-code = v-host-code
     1294           .
     1295       end.
     1296       if v-torgconf-self-host-code = 0
     1297       then do:
     1298           assign
     1299               v-torgconf-self-host-name           = "":U
     1300               v-torgconf-self-host-addres         = "":U
     1301               v-torgconf-self-host-post-addres    = "":U
     1302               v-torgconf-self-host-phone          = "":U
     1303               v-torgconf-self-host-inn            = "":U
     1304               v-torgconf-self-host-kpp            = "":U
     1305               v-torgconf-self-host-okpo           = "":U
     1306               v-torgconf-self-host-egrip-date     = "":U
     1307               v-torgconf-self-host-egrip-num      = "":U
     1308           .
     1309       end.
     1310       else do:
     1311           run fmtcli-get-client in this-procedure (
     1312                 input 'орг':U
     1313               , input v-torgconf-self-host-code
     1314           ).
     1315           assign
     1316               v-torgconf-self-host-name        = v-fmtcli-name
     1317               v-torgconf-self-host-engl-name   = v-fmtcli-engl-name
     1318               v-torgconf-self-host-addres      = v-fmtcli-full-addres
     1319               v-torgconf-self-host-post-addres = v-fmtcli-post-addres
     1320               v-torgconf-self-host-phone       = v-fmtcli-phone
     1321               v-torgconf-self-host-inn         = v-fmtcli-inn
     1322               v-torgconf-self-host-kpp         = v-fmtcli-kpp
     1323               v-torgconf-self-host-okpo        = v-fmtcli-okpo
     1324           .
     1325           run gbl/clntat-v.p (
     1326                 input 'орг':U
