     5756   def var vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5757   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
     5758   procedure paramls-clear :
     5759     define buffer buf_temp-param for temp-param .
     5760     do
     5761     on error undo, return error return-value
     5762     :
     5763       for each buf_temp-param
     5764       on error undo, return error
     5765       :
     5766         delete buf_temp-param .
     5767       end.
     5768     end.
     5769   end procedure.
     5770   procedure paramls-write :
     5771     define input  parameter p-code     as character no-undo .
     5772     define input  parameter p-sub-code as character no-undo .
     5773     define input  parameter p-value    as character no-undo .
     5774     define buffer buf_temp-param for temp-param .
     5775     do
     5776     on error undo, return error return-value
     5777     :
     5778       find first buf_temp-param
     5779         where buf_temp-param.param-code     = p-code
     5780           and buf_temp-param.param-sub-code = p-sub-code
     5781         no-error .
     5782       if not available buf_temp-param then do:
     5783         create buf_temp-param .
     5784         assign
     5785           buf_temp-param.param-code     = p-code
     5786           buf_temp-param.param-sub-code = p-sub-code
     5787         .
     5788       end.
     5789       assign
     5790         buf_temp-param.param-value = p-value
     5791       .
     5792     end.
     5793   end procedure.
     5794   procedure paramls-read :
     5795     define input  parameter p-code          as character no-undo .
     5796     define input  parameter p-sub-code      as character no-undo .
     5797     define input  parameter p-default-value as character no-undo .
     5798     define output parameter p-value         as character no-undo .
     5799     define buffer buf_temp-param for temp-param .
     5800     do
     5801     on error undo, return error return-value
     5802     :
     5803       find first buf_temp-param
     5804         where buf_temp-param.param-code     = p-code
     5805           and buf_temp-param.param-sub-code = p-sub-code
     5806         no-error .
     5807       if available buf_temp-param then do:
     5808         assign
     5809           p-value = buf_temp-param.param-value
     5810         .
     5811       end.
     5812       else do:
     5813         assign
     5814           p-value = p-default-value
     5815         .
     5816       end.
     5817     end.
     5818   end procedure.
     5819   procedure paramls-append :
     5820     define input  parameter p-code     as character no-undo .
     5821     define input  parameter p-sub-code as character no-undo .
     5822     define input  parameter p-value    as character no-undo .
     5823     define buffer buf_temp-param for temp-param .
     5824     do
     5825     on error undo, return error return-value
     5826     :
     5827       find first buf_temp-param
     5828            where buf_temp-param.param-code     = p-code
     5829              and buf_temp-param.param-sub-code = p-sub-code
     5830         no-error .
     5831       if not available buf_temp-param then do:
     5832         create buf_temp-param .
     5833         assign
     5834           buf_temp-param.param-code     = p-code
     5835           buf_temp-param.param-sub-code = p-sub-code
     5836           buf_temp-param.param-value    = p-value
     5837         .
     5838       end.
     5839       else do:
     5840           assign
     5841               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
     5842           .
     5843       end.
     5844     end.
     5845   end procedure.
