     6637   procedure Print-prod :
     6638     do on error undo, return error return-value :
     6639       find first buf_clients where buf_clients.obj-type = buf_goods.prod-type and buf_clients.obj-code = buf_goods.prod-code no-lock .
     6640       if not printrubl then do:
     6641         display stream out_stream sym1 "Производитель -" @ buf_goods.artic buf_clients.obj-name @ gds_name sym10 with frame val .
     6642         down stream out_stream 1 with frame val .
     6643         underline stream out_stream buf_goods.artic gds_name with frame val .
     6644       end.
     6645       else do:
     6646         display stream out_stream sym1 "Производитель -" @ buf_goods.artic buf_clients.obj-name @ gds_name sym10 with frame rubl .
     6647         down stream out_stream 1 with frame rubl .
     6648         underline stream out_stream buf_goods.artic gds_name with frame rubl .
     6649       end.
     6650     end.
     6651   end procedure.
     6652   procedure print-grp :
     6653     do on error undo, return error return-value :
     6654       if not printrubl then do:
     6655         display stream out_stream sym1 "Группа -" @ buf_goods.artic buf_goods.grp-name @ gds_name sym10 with frame val .
     6656         down stream out_stream 1 with frame val .
     6657         underline stream out_stream buf_goods.artic gds_name with frame val .
     6658       end.
     6659       else do:
     6660         display stream out_stream sym1 "Группа -" @ buf_goods.artic buf_goods.grp-name @ gds_name sym10 with frame rubl .
     6661         down stream out_stream 1 with frame rubl .
     6662         underline stream out_stream buf_goods.artic gds_name with frame rubl .
     6663       end.
     6664     end.
     6665   end procedure.
     6666   procedure print-line :
