     7676           ).
     7677         PUT  STREAM Out-Stream
     7678                 "Итого по описи :" Skip
     7679                   "а) количество порядковых номеров: " + string( num-ln ) + " (" + PropisCount + ")"  format "x(179)"                         at 18 SKIP
     7680                   "б) общее количество единиц фактически: " + string( sum1-a-qnty ) + " (" + PropisQnty + ")"  format "x(179)"  at 18 SKIP
     7681                 "   Все цены, подсчеты итогов по строкам, страницам и в целом по инвентаризационной описи товарно-материальных ценностей проверены." SKIP
     7682                 "Председатель комиссии:: " format "X(25)" AT 10 SKIP
     7683                 string(v-pos-agent) format "X(25)" AT 10 "" format "X(25)" AT 40 string(v-fio-agent) format "X(50)" AT 70 SKIP
     7684                 LineBuf format "X(25)" AT 10 LineBuf format "X(25)" AT 40 LineBuf format "X(50)" AT 70 SKIP
     7685                 "должность" format "X(25)" AT 10 "подпись" format "X(25)" AT 40 "расшифровка подписи" format "X(50)" AT 70 SKIP
     7686                 "Состав комиссии: " format "X(25)" AT 10 SKIP
     7687                 string(v-pos-player1) format "X(25)" AT 10 "" format "X(25)" AT 40 string(v-fio-player1) format "X(50)" AT 70 SKIP
     7688                 LineBuf format "X(25)" AT 10 LineBuf format "X(25)" AT 40 LineBuf format "X(50)" AT 70 SKIP
     7689                 "должность" format "X(25)" AT 10 "подпись" format "X(25)" AT 40 "расшифровка подписи" format "X(50)" AT 70 SKIP
     7690                 string(v-pos-player2) format "X(25)" AT 10 "" format "X(25)" AT 40 string(v-fio-player2) format "X(50)" AT 70 SKIP
     7691                 LineBuf format "X(25)" AT 10 LineBuf format "X(25)" AT 40 LineBuf format "X(50)" AT 70 SKIP
     7692                 "должность" format "X(25)" AT 10 "подпись" format "X(25)" AT 40 "расшифровка подписи" format "X(50)" AT 70 SKIP
     7693                 string(v-pos-player3) format "X(25)" AT 10 "" format "X(25)" AT 40 string(v-fio-player3) format "X(50)" AT 70 SKIP
     7694                 LineBuf format "X(25)" AT 10 LineBuf format "X(25)" AT 40 LineBuf format "X(50)" AT 70 SKIP
     7695                 "должность" format "X(25)" AT 10 "подпись" format "X(25)" AT 40 "расшифровка подписи" format "X(50)" AT 70 skip .
     7696         if PgNPP = 0 then
     7697         do:
     7698           PUT  STREAM Out-Stream
     7699             "   Все товарно-материальные ценности, поименованные  в  настоящей  инвентаризационной  описи  с № 0 по № " + string(PgNPP) format "x(179)" skip.
     7700         end.
     7701         else
     7702         do:
     7703           PUT  STREAM Out-Stream
     7704             "   Все товарно-материальные ценности, поименованные  в  настоящей  инвентаризационной  описи  с № 1 по № " + string(PgNPP) format "x(179)" skip.
     7705         end.
     7706          PUT  STREAM Out-Stream
     7707                    "комиссией проверены в натуре в моем (нашем) личном присутствии  и внесены в опись, в связи с чем претензий к инвентаризационной " SKIP
     7708             "комиссии не имею (не имеем). Товарно-материальные ценности, перечисленные в описи, находятся на моем (нашем) ответственном хранении." SKIP(1)
     7709                 "   Лицо(а), ответственное(ые) за сохранность товарно-материальных ценностей : " SKIP(1)
     7710                 LineBuf format "X(25)" AT 10 LineBuf format "X(25)" AT 40 LineBuf format "X(50)" AT 70 SKIP
     7711                 "должность" format "X(25)" AT 10 "подпись" format "X(25)" AT 40 "расшифровка подписи" format "X(50)" AT 70 SKIP
     7712                 LineBuf format "X(25)" AT 10 LineBuf format "X(25)" AT 40 LineBuf format "X(50)" AT 70 SKIP
     7713                 "должность" format "X(25)" AT 10 "подпись" format "X(25)" AT 40 "расшифровка подписи" format "X(50)" AT 70 SKIP
     7714                 LineBuf format "X(25)" AT 10 LineBuf format "X(25)" AT 40 LineBuf format "X(50)" AT 70 SKIP
     7715                 "должность" format "X(25)" AT 10 "подпись" format "X(25)" AT 40 "расшифровка подписи" format "X(50)" AT 70 SKIP
     7716                 "<<       >> _________________        г. "   SKIP(1)
     7717                 "Указанные в настоящей описи данные и расчеты проверил"
     7718                     LineBuf format "X(25)" AT 10 LineBuf format "X(25)"   AT 40 LineBuf format "X(50)"               AT 70 SKIP
     7719                 "должность" format "X(25)" AT 10 "подпись" format "X(25)" AT 40 "расшифровка подписи" format "X(50)" AT 70 SKIP
     7720                 "<<       >> _________________        г. " SKIP
     7721         .
     7722       End.
     7723       ELSE DO:
     7724         if PrintRubl = yes then do: run rep/wp-rub.p (                      input ( sum1-a-stoim - sum1-b-stoim ), output PropisSumall, output abbr ). end.
     7725                            else do: run rep/wp.p     ( input parParentProc, input ( sum1-a-stoim - sum1-b-stoim ), output PropisSumall, output abbr ). end.
     7726         run rep/wp-qnty.p ( (sum1-a-qnty - sum1-b-qnty), output PropisQnty).
     7727         if PropisQnty  = '' Then PropisQnty = 'Ноль'.
     7728         PUT  STREAM Out-Stream
     7729              "Итого по ведомости :" Skip
     7730              "а) количество порядковых номеров: " + string(num-ln) + " (" + PropisCount + ")"  format "x(179)"                         at 18 SKIP
     7731              "б) общее количество единиц (излишки - недостача): " + string( sum1-a-qnty - sum1-b-qnty ) + " (" + PropisQnty + ")"  format "x(179)"  at 18 SKIP
     7732              "в) на сумму (излишки - недостача) : " + trim(string((sum1-a-stoim - sum1-b-stoim ), "->,>>>,>>>,>>>,>>>,>>>,>>9.99")) + abbr + " (" + PropisSumall + ")"  format "x(179)"    at 18 SKIP(1)
     7733              "С результатами сличения ознакомлен : "  Skip "        Бухгалтер" LineBuf format "X(25)" AT 40 LineBuf format "X(50)" AT 70 SKIP
     7734              "подпись" format "X(25)" AT 40 "расшифровка подписи" format "X(50)" AT 70 SKIP(1) "Материально ответственное(ые)  лицо(а)"  Skip
     7735              LineBuf format "X(25)" AT 10 LineBuf format "X(25)" AT 40 LineBuf format "X(50)" AT 70 SKIP
     7736              "должность" format "X(25)" AT 10 "подпись" format "X(25)" AT 40 "расшифровка подписи" format "X(50)" AT 70 SKIP
     7737              LineBuf format "X(25)" AT 10 LineBuf format "X(25)" AT 40 LineBuf format "X(50)" AT 70 SKIP
     7738              "должность" format "X(25)" AT 10 "подпись" format "X(25)" AT 40 "расшифровка подписи" format "X(50)" AT 70 SKIP(1)
     7739         .
     7740       End.
     7741     end.
     7742   end procedure.
     7743   PROCEDURE on-same-page :
     7744     define input parameter p-line-number as integer  no-undo .
     7745     if p-line-number > page-size( Out-Stream ) then return .
     7746     if line-counter( Out-Stream ) + p-line-number > page-size( Out-Stream ) then  page stream Out-Stream .
     7747   end procedure.
     7748   procedure Check-Doc-Sum :
     7749     do  on error undo, return error return-value  :
     7750       define variable v-attr-value as character no-undo .
     7751       define variable v-attr-type as character no-undo .
     7752       define variable ask as logical   no-undo .
     7753   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input buf_trn-doc.doc-code ,
     7754                           input 'addsum':U ,
     7755                          output v-attr-value ,
     7756                          output v-attr-type )  .
     7757       if buf_trn-doc.status_ = 'факт':U then do:
     7758         case rep-tipe:
     7759           when "invent" then do:
     7760             if lookup( 'bd':U, v-attr-value ) = 0 or
     7761                lookup( 'ad':U, v-attr-value ) = 0  then run utl/uaddsum.p (buf_trn-doc.doc-code, no, no, no) no-error  .
     7762             if error-status :error then  message return-value error-status :GET-MESSAGE( 1 )  view-as alert-box error .
     7763           end.
     7764           when "invent-gold" THEN DO:
     7765             if lookup( 'bd':U, v-attr-value ) = 0 or
     7766                lookup( 'ad':U, v-attr-value ) = 0  or
     7767                lookup( 'bcd':U, v-attr-value ) = 0  or
     7768                lookup( 'acd':U, v-attr-value ) = 0 then run utl/uaddsum.p (buf_trn-doc.doc-code, yes, no, yes) no-error .
     7769             if error-status :error then  message return-value error-status :GET-MESSAGE( 1 )  view-as alert-box error .
     7770           End.
     7771           when  "sl"  or when  "sl-gold" THEN DO:
     7772             if lookup( 'gen':U, v-attr-value ) = 0 or
     7773                lookup( 'wst':U, v-attr-value ) = 0  then run utl/uaddsum.p (buf_trn-doc.doc-code, yes, yes, no) no-error .
     7774             if error-status :error then  message return-value error-status :GET-MESSAGE( 1 )  view-as alert-box error .
     7775           End.
     7776         End.
     7777       end.
     7778       else
     7779         case rep-tipe:
     7780           when "invent" or when "invent-gold" then do:
     7781             if lookup( 'bd':U, v-attr-value ) = 0 then do:
     7782               message "Не рассчитаны данные до начала инвентаризации!" view-as alert-box.
     7783               undo, return error .
     7784             end.
     7785             if lookup( 'ad':U, v-attr-value ) = 0  then do:
     7786               if no-vat then do:
     7787                 message "Не рассчитаны данные после инвентаризации!" view-as alert-box.
     7788                 undo, return error .
     7789               end.
     7790               else assign is-after = no .
     7791             end.
     7792             if rep-tipe = "invent-gold" then do:
     7793               if lookup( 'bcd':U, v-attr-value ) = 0 then do:
     7794                 message "Не рассчитано кол-во в един. изм. поставщика до начала инвентаризации!" view-as alert-box.
     7795                 undo, return error .
     7796               end.
     7797               if lookup( 'acd':U, v-attr-value ) = 0 then assign is-after-cli = no .
     7798             end.
     7799           End.
     7800           when  "sl"  or when  "sl-gold" THEN DO:
     7801             if lookup( 'wst':U, v-attr-value ) = 0  then do:
     7802               message "Не рассчитаны нормы естественной убыли! Напечатать документ без их учета?" view-as alert-box QUESTION BUTTONS YES-NO UPDATE ask.
     7803               if ask then assign is-wastage = no .
     7804               else undo, return error .
     7805             end.
     7806             if lookup( 'gen':U, v-attr-value ) = 0 then assign is-general = no .
     7807           End.
     7808         End.
     7809     end.
     7810   end procedure.
