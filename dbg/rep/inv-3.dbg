     1751               assign
     1752                   v-torgconf-outexlst  = yes
     1753               .
     1754           end.
     1755        assign
     1756         v-name = p-form-name.
     1757   end.
     1758   end.
     1759   end procedure.
     1760   procedure torgconf-get-self-param :
     1761   define input parameter p-obj-type           as character        no-undo.
     1762   define input parameter p-obj-code           as integer          no-undo.
     1763   define input parameter p-curr-code          as integer          no-undo.
     1764       define variable v-host-code    as integer      no-undo.
     1765       define variable v-par-type     as character    no-undo.
     1766   do
     1767   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message(1))
     1768   :
     1769   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1770   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1771     (input  p-obj-type
     1772     ,input  p-obj-code
     1773     ,output v-host-code
     1774     )  .
     1775       if v-torgconf-outhold = yes
     1776       then do:
     1777           run torgconf-get-holdfirm-code in this-procedure (
     1778                 input p-obj-type
     1779               , input p-obj-code
     1780               , output v-torgconf-self-host-code
     1781           ).
     1782           if v-torgconf-self-host-code = 0
     1783           then do:
     1784               return error.
     1785           end.
     1786       end.
     1787       else do:
     1788           assign
     1789               v-torgconf-self-host-code = v-host-code
     1790           .
     1791       end.
     1792       if v-torgconf-self-host-code = 0
     1793       then do:
     1794           assign
     1795               v-torgconf-self-host-name           = "":U
     1796               v-torgconf-self-host-addres         = "":U
     1797               v-torgconf-self-host-post-addres    = "":U
     1798               v-torgconf-self-host-phone          = "":U
     1799               v-torgconf-self-host-inn            = "":U
     1800               v-torgconf-self-host-kpp            = "":U
     1801               v-torgconf-self-host-okpo           = "":U
     1802               v-torgconf-self-host-egrip-date     = "":U
     1803               v-torgconf-self-host-egrip-num      = "":U
     1804           .
     1805       end.
     1806       else do:
     1807           run fmtcli-get-client in this-procedure (
     1808                 input 'орг':U
     1809               , input v-torgconf-self-host-code
     1810           ).
     1811           assign
     1812               v-torgconf-self-host-name        = v-fmtcli-name
     1813               v-torgconf-self-host-engl-name   = v-fmtcli-engl-name
     1814               v-torgconf-self-host-addres      = v-fmtcli-full-addres
     1815               v-torgconf-self-host-post-addres = v-fmtcli-post-addres
     1816               v-torgconf-self-host-phone       = v-fmtcli-phone
     1817               v-torgconf-self-host-inn         = v-fmtcli-inn
     1818               v-torgconf-self-host-kpp         = v-fmtcli-kpp
     1819               v-torgconf-self-host-okpo        = v-fmtcli-okpo
     1820           .
     1821           run gbl/clntat-v.p (
     1822                 input 'орг':U
     1823               , input v-torgconf-self-host-code
     1824               , input 'egrip-date':U
     1825               , output v-torgconf-self-host-egrip-date
     1826               , output v-par-type
     1827           ).
     1828           run gbl/clntat-v.p (
     1829                 input 'орг':U
     1830               , input v-torgconf-self-host-code
     1831               , input 'egrip-num':U
     1832               , output v-torgconf-self-host-egrip-num
     1833               , output v-par-type
     1834           ).
     1835           run fmtcli-get-bank in this-procedure (
     1836                 input v-host-code
     1837               , input 'орг':U
     1838               , input v-torgconf-self-host-code
     1839               , input p-curr-code
     1840           ).
     1841       end.
     1842       assign
     1843           v-torgconf-self-schet-exists = v-fmtcli-schet-exists
     1844           v-torgconf-self-bank-exists  = v-fmtcli-bank-exists
     1845           v-torgconf-self-bank-r-schet = v-fmtcli-bank-r-schet
     1846           v-torgconf-self-bank-c-schet = v-fmtcli-bank-c-schet
     1847           v-torgconf-self-bank-bik     = v-fmtcli-bank-bik
     1848           v-torgconf-self-bank-name    = v-fmtcli-bank-name
     1849           v-torgconf-self-bank-addres  = v-fmtcli-bank-addres
     1850           v-torgconf-self-bank-city    = v-fmtcli-bank-city
     1851       .
     1852       assign
     1853           v-torgconf-self-obj-type = p-obj-type
     1854           v-torgconf-self-obj-code = p-obj-code
     1855       .
     1856       run fmtcli-get-client in this-procedure (
     1857             input p-obj-type
     1858           , input p-obj-code
     1859       ).
     1860       assign
     1861           v-torgconf-self-obj-name       = v-fmtcli-name
     1862           v-torgconf-self-obj-engl-name  = v-fmtcli-engl-name
     1863           v-torgconf-self-obj-addres     = v-fmtcli-full-addres
     1864           v-torgconf-temp-post-addres    = v-fmtcli-post-addres
     1865           v-torgconf-self-obj-phone      = v-fmtcli-phone
     1866           v-torgconf-self-obj-inn        = v-fmtcli-inn
     1867           v-torgconf-self-obj-okpo       = v-fmtcli-okpo
     1868       .
     1869   end.
     1870   end procedure.
     1871   procedure torgconf-get-recepient-param :
     1872   define input parameter torgconfdoc-code   as character                  no-undo.
     1873   define output parameter v-code-rec        as integer                    no-undo .
     1874   define output parameter v-type-rec        as character                  no-undo initial 'C':U.
     1875   define output parameter v-codefirm-rec    as integer                    no-undo .
     1876   define output parameter v-curcode-rec     as integer                    no-undo .
     1877        define variable  v-recipient-code  as character                  no-undo .
     1878        define variable  v-recipient       like ub.doc-attr.attr-value   no-undo.
     1879        define variable  v-trdcattr-type   as character                  no-undo initial 'C':U.
     1880   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input torgconfdoc-code ,
     1881                           input 'Recipient':U ,
     1882                          output v-recipient-code ,
     1883                          output v-trdcattr-type ) no-error .
     1884       if error-status :error then do:
