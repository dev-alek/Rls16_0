     7023                   + ( if rep-tipe = "invent-gold"
     7024                       or rep-tipe = "sl-gold"
     7025                       then gds-str1
     7026                       else temp-str.gds-name )
     7027               , input string( if rep-tipe = "invent-gold"
     7028                               or rep-tipe = "sl-gold"
     7029                               then temp-str.tb-code
     7030                               else temp-str.b-code )
     7031               , input temp-str.unit-base
     7032               , input temp-str.OKEI
     7033               , input temp-str.Price-after
     7034               , input temp-str.a-qnty
     7035               , input temp-str.a-stoim
     7036               , input temp-str.b-qnty
     7037               , input temp-str.b-stoim
     7038           ).
     7039       end.
     7040     if rep-tipe = "invent-gold" OR rep-tipe = "sl-gold" then DO:
     7041       DO WHILE gds-str2 <> "" :
     7042         assign gds-str = gds-str2.
     7043         gds-str1 = breakstr(gds-str, 40, input-output gds-str1, input-output gds-str2).
     7044         DISPLAY STREAM Out-Stream gds-str1 @ temp-str.gds-name sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym10  with frame sl-gold .
     7045         DOWN STREAM Out-Stream 1 with FRAME sl-gold .
     7046           if rep-tipe begins "invent"
     7047           and p-grp = "no"
     7048           then do:
     7049               run inv3xl-write-line-data in this-procedure (
     7050                     input 0
     7051                   , input gds-str1
     7052                   , input "":U
     7053                   , input "":U
     7054                   , input "":U
     7055                   , input "":U
     7056                   , input "":U
     7057                   , input "":U
     7058                   , input "":U
     7059                   , input "":U
     7060               ).
     7061           end.
     7062       END.
     7063     END.
     7064     if PrintScale and temp-str.empty-scale = no THEN DO :
     7065       for each buf_gds-dtl no-lock
     7066         where buf_gds-dtl.doc-code  = buf_trn-doc.doc-code
     7067           and buf_gds-dtl.artic     = temp-str.artic
     7068           and buf_gds-dtl.prod-type = temp-str.prod-type
     7069           and buf_gds-dtl.prod-code = temp-str.prod-code
     7070         :
     7071   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     7072     (input  temp-str.gds-code
     7073     ,input  buf_gds-dtl.prt-code
     7074     ,output b-code
     7075     ) no-error .
     7076         if error-status :error then do:
     7077           message vss-workfile vss-revision vss-description skip "Ошибка при определении бар-кода признака" skip  "Код товара" temp-str.gds-code skip  "Код признака" buf_gds-dtl.prt-code skip
     7078           view-as alert-box error .
     7079         end.
     7080         find first buf_gds-prt where buf_gds-prt.node-code  = buf_gds-dtl.prt-code no-lock no-error .
     7081         assign qnty = buf_gds-dtl.doc-qnty .
     7082         if not CostPrice then do:
     7083           if PrintRubl then assign sum = buf_gds-dtl.price-rubl .
     7084           else              assign sum = buf_gds-dtl.price-base .
     7085         end.
     7086         else assign sum = if temp-str.a-stoim <> 0  or temp-str.a-qnty <> 0 then temp-str.a-stoim / temp-str.a-qnty else temp-str.b-stoim / temp-str.b-qnty .
     7087         if qnty >= 0 then do:
     7088           display stream Out-Stream
     7089             sym1     sym2     sym3     ('  /'+ buf_gds-prt.f-name)  @ temp-str.gds-name
     7090             sym4     if rep-tipe = "sl-gold" then "" else string(b-code) @ temp-str.b-code
     7091             sym5     sym6
     7092             sym7     qnty @ temp-str.a-qnty
     7093                 sym10
     7094           with FRAME sl-gold.
     7095           if rep-tipe begins "invent"
     7096           and p-grp = "no"
     7097           then do:
     7098               run inv3xl-write-line-data in this-procedure (
     7099                     input 0
     7100                   , input ( "  /":U + buf_gds-prt.f-name )
     7101                   , input ( if rep-tipe = "sl-gold":U
     7102                             then "":U
     7103                             else string( b-code ) )
     7104                   , input "":U
     7105                   , input "":U
     7106                   , input "":U
     7107                   , input string( qnty )
     7108                   , input string( sum * qnty )
     7109                   , input "":U
     7110                   , input "":U
     7111               ).
     7112           end.
     7113         end.
     7114         else do:
     7115           assign qnty = - qnty .
     7116           display stream Out-Stream
     7117             sym1     sym2     sym3  ('  /'+ buf_gds-prt.f-name)  @ temp-str.gds-name
     7118             sym4     if rep-tipe = "sl-gold" then "" else string(b-code) @ temp-str.b-code
     7119             sym5     sym6
     7120             sym7     qnty @ temp-str.b-qnty
     7121                  sym10
     7122           with FRAME sl-gold.
     7123           if rep-tipe begins "invent"
     7124           and p-grp = "no"
     7125           then do:
     7126               run inv3xl-write-line-data in this-procedure (
     7127                     input 0
     7128                   , input ( '  /':U + buf_gds-prt.f-name )
     7129                   , input ( if rep-tipe = "sl-gold":U
     7130                             then "":U
     7131                             else string( b-code ) )
     7132                   , input "":U
     7133                   , input "":U
     7134                   , input "":U
     7135                   , input "":U
     7136                   , input "":U
     7137                   , input string( qnty )
     7138                   , input string( sum * qnty )
     7139               ).
     7140           end.
     7141         end.
     7142         DOWN stream Out-Stream 1 with FRAME sl-gold .
     7143       end.
     7144     end.
     7145     if print-graft = false THEN  Put stream Out-Stream LineBuf format "X(196)" SKIP.
     7146   end.
     7147   end.
     7148      End.
     7149       End CASE.
     7150     end.
     7151   end procedure.
     7152   procedure print-grp-itog :
     7153     do on error undo, return error return-value :
     7154       case rep-tipe :
     7155         when "invent" THEN DO:
     7156           display stream Out-Stream
     7157             "ИТОГО"      @  temp-str.artic
     7158             TRIM(CAPS(temp-str.grp-name)) @ temp-str.gds-name
     7159             sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym9 sym10  sym8
     7160             sum-a-qnty   @ temp-str.a-qnty
     7161             sum-b-qnty   @ temp-str.b-qnty
     7162           with FRAME invent.
     7163           DOWN stream Out-Stream 1 with FRAME invent .
     7164           if print-graft = false THEN Put stream Out-Stream LineBuf format "X(185)" SKIP.
     7165         End.
     7166         when  "sl"  THEN DO:
     7167           display stream Out-Stream
     7168             "ИТОГО"      @  temp-str.artic
     7169             TRIM(CAPS(temp-str.grp-name)) @ temp-str.gds-name
     7170             sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym9 sym10 sym12  sym13
     7171             sym14 sum-ubl @ temp-str.UBL
