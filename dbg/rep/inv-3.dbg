     2243   define input parameter p-obj-code           as integer          no-undo.
     2244   define input parameter p-curr-code          as integer          no-undo.
     2245       define variable v-host-code    as integer      no-undo.
     2246   do
     2247   on error undo, return error
     2248   :
     2249       assign
     2250           v-torgconf-ship-type = p-obj-type
     2251           v-torgconf-ship-code = p-obj-code
     2252       .
     2253       if trim(p-obj-type) = ""
     2254       and p-obj-code = 0
     2255       then do:
     2256       assign
     2257           v-torgconf-ship-name         = "":U
     2258           v-torgconf-ship-addres       = "":U
     2259           v-torgconf-ship-post-addres  = "":U
     2260           v-torgconf-ship-phone        = "":U
     2261           v-torgconf-ship-inn          = "":U
     2262           v-torgconf-ship-kpp          = "":U
     2263           v-torgconf-ship-okpo         = "":U
     2264       .
     2265       end.
     2266       else do:
     2267       run fmtcli-get-client in this-procedure (
     2268             input p-obj-type
     2269           , input p-obj-code
     2270       ).
     2271       assign
     2272           v-torgconf-ship-name         = trim( v-fmtcli-name          )
     2273           v-torgconf-ship-engl-name    = trim( v-fmtcli-engl-name          )
     2274           v-torgconf-ship-addres       = trim( v-fmtcli-full-addres   )
     2275           v-torgconf-ship-post-addres  = trim( v-fmtcli-post-addres   )
     2276           v-torgconf-ship-phone        = trim( v-fmtcli-phone         )
     2277           v-torgconf-ship-inn          = trim( v-fmtcli-inn           )
     2278           v-torgconf-ship-kpp          = trim( v-fmtcli-kpp           )
     2279           v-torgconf-ship-okpo         = trim( v-fmtcli-okpo          )
     2280       .
     2281       end.
     2282           run fmtcli-get-bank in this-procedure (
     2283             input p-host-obj-code
     2284           , input p-obj-type
     2285           , input p-obj-code
     2286           , input p-curr-code
     2287       ).
     2288       assign
     2289           v-torgconf-ship-schet-exists = v-fmtcli-schet-exists
     2290           v-torgconf-ship-bank-exists  = v-fmtcli-bank-exists
     2291           v-torgconf-ship-bank-r-schet = v-fmtcli-bank-r-schet
     2292           v-torgconf-ship-bank-c-schet = v-fmtcli-bank-c-schet
     2293           v-torgconf-ship-bank-bik     = v-fmtcli-bank-bik
     2294           v-torgconf-ship-bank-name    = v-fmtcli-bank-name
     2295           v-torgconf-ship-bank-addres  = v-fmtcli-bank-addres
     2296           v-torgconf-ship-bank-city    = v-fmtcli-bank-city
     2297       .
     2298   end.
     2299   end procedure.
     2300   procedure torgconf-get-holdfirm-code :
     2301   define input parameter p-obj-type   as character        no-undo.
     2302   define input parameter p-obj-code   as integer          no-undo.
     2303   define output parameter p-firm-code as integer          no-undo.
     2304       define variable v-firm-code-str     as character    no-undo.
     2305       define variable v-par-type          as character    no-undo.
     2306       define buffer buf_clients       for ub.clients.
     2307   do
     2308   for buf_clients
     2309   on error undo, return error
     2310   :
     2311       run gbl/clntat-v.p (
     2312             input p-obj-type
     2313           , input p-obj-code
     2314           , input 'holdfirm-code':U
     2315           , output v-firm-code-str
     2316           , output v-par-type
     2317       ).
     2318       assign
     2319           p-firm-code = integer( v-firm-code-str )
     2320       no-error.
     2321       if error-status :error
     2322       then do:
     2323           message
     2324               "Неверно задан код фирмы для печати накладных."
     2325           view-as alert-box warning.
     2326           assign
     2327               p-firm-code = 0
     2328           .
     2329       end.
     2330       else do:
     2331           find first buf_clients no-lock
     2332                where buf_clients.obj-type = 'орг':U
     2333                  and buf_clients.obj-code = p-firm-code
     2334           no-error.
     2335           if not available buf_clients
     2336           then do:
     2337               message
     2338                   "Включен параметр 'Список печатных форм, для которых должна быть задана фирма для печати накладных' (outhold)" skip
     2339                   "Не найдена фирма по заданному коду фирмы для печати накладных."
     2340               view-as alert-box warning.
     2341               assign
     2342                   p-firm-code = 0
     2343               .
     2344           end.
     2345       end.
     2346   end.
     2347   end procedure.
     2348   procedure torgconf-get-post-head:
     2349   define input  parameter p-obj-type             as character        no-undo.
     2350   define input  parameter p-obj-code             as integer          no-undo.
     2351   define output parameter p-torgconf-post-head   as character        no-undo.
     2352      define variable v-host-code         as integer      no-undo.
     2353      define buffer buf_sysconf     for ub.sysconf.
     2354        assign
     2355         p-torgconf-post-head  = ""
     2356        .
     2357   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2358   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2359     (input  p-obj-type
     2360     ,input  p-obj-code
     2361     ,output v-host-code
     2362     )  .
     2363      find first buf_sysconf no-lock
     2364      where buf_sysconf.host-code = v-host-code
     2365      no-error.
     2366      if available buf_sysconf
     2367      then do:
     2368         assign
     2369            p-torgconf-post-head = buf_sysconf.head-position
     2370         .
     2371      end.
     2372   end procedure.
     2373   procedure torgconf-get-storekeeper:
     2374   define input  parameter p-wrkr                   as integer          no-undo.
     2375   define output parameter p-torgconf-wrkr-name     as character        no-undo.
     2376   define output parameter p-torgconf-post          as character        no-undo.
     2377      define buffer buf_sysconf     for ub.sysconf.
     2378      define buffer buf_person      for ub.person.
     2379      define buffer buf_shop        for ub.shop .
     2380      define buffer buf_store       for ub.store .
     2381      if v-torgconf-outC = "no_print"
     2382      then do:
     2383         assign p-torgconf-post = ""
     2384                p-torgconf-wrkr-name = ""
     2385                .
     2386      end.
     2387      if v-torgconf-outC = "clad_doc"
     2388      then do:
     2389         run rep/get-psn.p
     2390               (input  p-wrkr
     2391               ,output p-torgconf-wrkr-name
     2392               ) .
     2393         find first buf_person no-lock
     2394         where buf_person.psn-code = p-wrkr
     2395         no-error.
     2396         if available buf_person
     2397         then do:
     2398           p-torgconf-post = buf_person.position.
     2399         end.
     2400         if p-torgconf-post = "?":U then p-torgconf-post = "".
     2401         if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     2402      end.
     2403      if v-torgconf-outC = "clad_obj"
     2404      then do:
     2405         CASE v-torgconf-self-obj-type:
     2406         WHEN 'маг':U
     2407         THEN DO:
     2408            find first buf_shop no-lock
     2409            where buf_shop.obj-code = v-torgconf-self-obj-code
     2410            .
     2411            assign
     2412               p-torgconf-wrkr-name = buf_shop.store-man
     2413               p-torgconf-post = ""
     2414            .
     2415            if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     2416         END.
     2417         WHEN 'скл':U
     2418         THEN DO:
     2419            find first buf_store no-lock
     2420            where buf_store.obj-code = v-torgconf-self-obj-code
     2421            .
     2422            assign
     2423               p-torgconf-wrkr-name = buf_store.store-man
     2424               p-torgconf-post = ""
     2425            .
     2426            if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     2427         END.
     2428         OTHERWISE DO:
     2429            assign
     2430               p-torgconf-post = "":U
     2431               p-torgconf-wrkr-name = "":U
     2432            .
     2433         END.
     2434         END CASE.
     2435      end.
     2436    end procedure.
     2437   procedure torgconf-get-form-header :
     2438   define input parameter p-for-inverse    as logical          no-undo.
     2439   define input parameter p-doc-code       as character        no-undo.
     2440   define input parameter p-print-doc      as logical          no-undo.
     2441   define input parameter p-doc-date       as date             no-undo.
     2442   define input parameter p-fact-date      as date             no-undo.
     2443   define input parameter p-doc-type       as character        no-undo.
     2444   define input parameter p-status_        as character        no-undo.
     2445   define input parameter p-reverse        as logical          no-undo.
     2446   define input parameter p-sf-par         as logical          no-undo.
     2447       define variable v-attr-type         as character    no-undo.
     2448       define variable v-doc-code-standard as logical      no-undo.
     2449       define variable v-doc-date-standard as logical      no-undo.
     2450       define variable v-par-consignee-addres  as character    no-undo.
     2451       define variable v-host-code         as integer      no-undo.
     2452       define variable v-dcode-attr        as character    no-undo.
     2453       define variable v-ddate-attr        as character    no-undo.
     2454       define variable v-doc-date          as character    no-undo.
     2455       define variable v-doc-code          as character    no-undo.
     2456       define variable v-par-type          as character    no-undo.
     2457       define variable v-attr              as character    no-undo.
     2458       define buffer buf_firm          for ub.firm .
     2459       define buffer buf_clients       for ub.clients .
     2460       define buffer buf_sysconf       for ub.sysconf .
     2461       define buffer buf_shop          for ub.shop .
     2462       define buffer buf_store         for ub.store .
     2463       define buffer buf_person        for ub.person .
     2464       define buffer buf_trn-doc       for ub.trn-doc .
     2465       define buffer buf_wth-doc       for ub.wth-doc .
     2466       do
     2467   for buf_firm
     2468     , buf_clients
     2469     , buf_sysconf
     2470     , buf_shop
     2471     , buf_trn-doc
     2472     , buf_person
     2473     , buf_wth-doc
     2474   on error undo, return error
     2475   :
     2476       if p-doc-type = 'при':U
     2477       or p-doc-type = 'возврат':U
     2478       then do:
     2479           assign
     2480               v-torgconf-supplier         = substitute( "&1&2&3&4&5", v-torgconf-cli-name, ( if v-torgconf-cli-addres = "":U then "":U else ", " ),
     2481                                             v-torgconf-cli-addres, ( if v-torgconf-cli-phone = "":U then "":U else ", " ), v-torgconf-cli-phone )
     2482               v-torgconf-suppi            = substitute( "&1&2&3&4&5", v-torgconf-cli-name, ( if v-torgconf-cli-addres = "":U then "":U else ", " ),
     2483                                             v-torgconf-cli-addres, ( if v-torgconf-cli-phone = "":U then "":U else ", " ), v-torgconf-cli-phone )
     2484               v-torgconf-saler            = substitute( "&1&2&3&4&5", v-torgconf-self-host-name, ( if v-torgconf-self-host-addres = "":U then "":U else ", " ),
     2485                                             v-torgconf-self-host-addres, ( if v-torgconf-self-host-phone = "":U then "":U else ", " ),v-torgconf-self-host-phone )
     2486               v-torgconf-consignee        = substitute( "&1&2&3&4&5", v-torgconf-sup-host-name, ( if v-torgconf-sup-host-addres = "":U then "":U else ", " ),
     2487                                             v-torgconf-sup-host-addres, ( if v-torgconf-sup-host-phone = "":U then "":U else ", " ), v-torgconf-sup-host-phone  )
     2488               v-torgconf-supplier-okpo    = v-torgconf-cli-okpo
     2489               v-torgconf-saler-okpo       = v-torgconf-self-host-okpo
     2490               v-torgconf-consignee-okpo   = v-torgconf-sup-host-okpo
     2491               v-torgconf-supplier-code    = substitute( "&1", v-torgconf-cli-code         )
     2492               v-torgconf-supplier-type    = v-torgconf-cli-type
     2493               v-torgconf-saler-code       = substitute( "&1", v-torgconf-self-host-code   )
     2494               v-torgconf-saler-type       = v-torgconf-self-host-type
     2495               v-torgconf-consignee-code   = substitute( "&1", v-torgconf-sup-host-code   )
     2496               v-torgconf-consignee-type   = v-torgconf-sup-host-type
     2497               v-torgconf-supplier-name    = substitute( "&1", v-torgconf-cli-name         )
     2498               v-torgconf-saler-name       = substitute( "&1", v-torgconf-self-host-name   )
     2499               v-torgconf-consignee-name   = substitute( "&1", v-torgconf-sup-host-name   )
     2500               v-torgconf-supplier-addr    = substitute( "&1", v-torgconf-cli-addres       )
     2501               v-torgconf-saler-addr       = substitute( "&1", v-torgconf-self-host-addres )
     2502               v-torgconf-consignee-addr   = substitute( "&1", v-torgconf-sup-host-addres )
     2503               v-torgconf-supplier-inn     = substitute( "&1", v-torgconf-cli-inn          )
     2504               v-torgconf-supplier-engl-name     = substitute( "&1", v-torgconf-cli-engl-name          )
     2505               v-torgconf-saler-inn        = substitute( "&1", v-torgconf-self-host-inn    )
     2506               v-torgconf-consignee-inn    = substitute( "&1", v-torgconf-sup-host-inn    )
     2507               v-torgconf-supplier-kpp     = substitute( "&1", v-torgconf-cli-kpp          )
     2508               v-torgconf-saler-kpp        = substitute( "&1", v-torgconf-self-host-kpp    )
     2509               v-torgconf-consignee-kpp    = substitute( "&1", v-torgconf-sup-host-kpp    )
     2510           .
     2511           if v-torgconf-cli-schet-exists = yes
     2512           AND v-form-name                  = "torg12":U
     2513           then do:
     2514               assign
     2515                   v-torgconf-supplier = v-torgconf-supplier
     2516                       + substitute( ", р/с &1 к/с &2"
     2517                                   , v-torgconf-cli-bank-r-schet
     2518                                   , v-torgconf-cli-bank-c-schet
     2519                                   )
     2520                   v-torgconf-suppi = v-torgconf-supplier
     2521                       + substitute( ", р/с &1 к/с &2"
     2522                                   , v-torgconf-cli-bank-r-schet
     2523                                   , v-torgconf-cli-bank-c-schet
     2524                                   )
     2525               .
     2526               if v-torgconf-cli-bank-exists = yes
     2527               then do:
     2528                   assign
     2529                       v-torgconf-supplier = v-torgconf-supplier
     2530                           + substitute( " БИК &1 в &2 &3"
     2531                                       , v-torgconf-cli-bank-bik
     2532                                       , v-torgconf-cli-bank-name
     2533                                       ,(if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) )
     2534                                       )
     2535                      v-torgconf-suppi = v-torgconf-supplier
     2536                           + substitute( " БИК &1 в &2 &3"
     2537                                       , v-torgconf-cli-bank-bik
     2538                                       , v-torgconf-cli-bank-name
     2539                                       ,(if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) )
     2540                                       )
     2541                   .
     2542               end.
     2543           end.
     2544           if v-torgconf-self-schet-exists = yes
     2545           AND v-form-name                  = "torg12":U
     2546           then do:
     2547               assign
     2548                   v-torgconf-saler = v-torgconf-saler
     2549                       + substitute( ", р/с &1 к/с &2"
     2550                                   , v-torgconf-self-bank-r-schet
     2551                                   , v-torgconf-self-bank-c-schet
     2552                                   )
     2553               .
     2554               if v-torgconf-self-bank-exists = yes
     2555               then do:
     2556                   assign
     2557                       v-torgconf-saler = v-torgconf-saler
     2558                           + substitute( " БИК &1 в &2 &3"
     2559                                       , v-torgconf-self-bank-bik
     2560                                       , v-torgconf-self-bank-name
     2561                                       , v-torgconf-self-bank-addres
     2562                                       )
     2563                   .
     2564               end.
     2565           end.
     2566           if v-torgconf-sup-schet-exists = yes
     2567           AND v-form-name                  = "torg12":U
     2568           then do:
     2569               assign
     2570                   v-torgconf-consignee = v-torgconf-consignee
     2571                       + substitute( ", р/с &1 к/с &2"
     2572                                   , v-torgconf-sup-bank-r-schet
     2573                                   , v-torgconf-sup-bank-c-schet
     2574                                   )
     2575               .
     2576             if v-torgconf-sup-bank-exists = yes
     2577              then do:
     2578                assign
     2579                   v-torgconf-consignee = v-torgconf-consignee
     2580                           + substitute( " БИК &1 в &2 &3"
     2581                                       , v-torgconf-sup-bank-bik
     2582                                       , v-torgconf-sup-bank-name
     2583                                       , v-torgconf-sup-bank-addres
     2584                                       )
     2585                   .
     2586               end.
     2587           end.
     2588      if v-torgconf-outares = yes  AND v-form-name  = "torg12":U
     2589      then do:
     2590          assign
     2591            v-torgconf-supplier = substitute(  "&1&2&3 &4 &5&6"
     2592                                                   , IF v-form-name = "torg12":U THEN SUBSTITUTE("ИНН &1 КПП &2 ", v-torgconf-cli-inn, v-torgconf-cli-kpp) ELSE "":U
     2593                                                   , v-torgconf-cli-name
     2594                                                   , ( if v-torgconf-outprncd = yes
     2595                                                         then substitute( " (&1)", v-torgconf-cli-code )
     2596                                                         else "":U )
     2597                                                   , v-torgconf-cli-post-addres
     2598                                                   , v-torgconf-cli-phone
     2599                                                   , ( if v-torgconf-cli-bank-r-schet <> "":U
     2600                                                       AND v-form-name                  = "torg12":U
     2601                                                         then substitute( ", р/с &1 к/с &2, БИК &3 в &4, &5"
     2602                                                               , v-torgconf-cli-bank-r-schet
     2603                                                               , v-torgconf-cli-bank-c-schet
     2604                                                               , v-torgconf-cli-bank-bik
     2605                                                               , v-torgconf-cli-bank-name
     2606                                                               , (if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) )     )
     2607                                                         else "":U )
     2608                                                )
     2609         .
     2610      end.
     2611       v-torgconf-suppi = substitute(  "&1&2&3 &4 &5&6"
     2612                                        , IF v-form-name = "torg12":U THEN SUBSTITUTE("ИНН &1 КПП &2 ", v-torgconf-cli-inn, v-torgconf-cli-kpp) ELSE "":U
     2613                                        , v-torgconf-cli-name
     2614                                        , ( if v-torgconf-outprncd = yes
     2615                                            then substitute( " (&1)", v-torgconf-cli-code )
     2616                                            else "":U )
     2617                                        , v-torgconf-cli-addres
     2618                                        , v-torgconf-cli-phone
     2619                                        , ( if v-torgconf-cli-bank-r-schet <> "":U
     2620                                            AND v-form-name                  = "torg12":U
     2621                                            then substitute( ", р/с &1 к/с &2, БИК &3 в &4, &5"
     2622                                                           , v-torgconf-cli-bank-r-schet
     2623                                                           , v-torgconf-cli-bank-c-schet
     2624                                                           , v-torgconf-cli-bank-bik
     2625                                                           , v-torgconf-cli-bank-name
     2626                                                           , (if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) ))
     2627                                                   else "":U )
     2628                                        ).
     2629       end.
     2630       else do:
     2631       v-torgconf-suppi = substitute(  "&1&2&3 &4 &5&6"
     2632                                        , IF v-form-name = "torg12":U THEN SUBSTITUTE("ИНН &1 КПП &2 ", v-torgconf-self-host-inn, v-torgconf-self-host-kpp) ELSE "":U
     2633                                        , v-torgconf-self-host-name
     2634                                        , ( if v-torgconf-outprncd = yes
     2635                                            then substitute( " (&1)", v-torgconf-self-host-code )
     2636                                            else "":U )
     2637                                        , v-torgconf-self-host-addres
     2638                                        , v-torgconf-self-host-phone
     2639                                        , ( if v-torgconf-self-bank-r-schet <> "":U
     2640                                            AND v-form-name                  = "torg12":U
     2641                                            then substitute( ", р/с &1 к/с &2, БИК &3 в &4, &5"
     2642                                                           , v-torgconf-self-bank-r-schet
     2643                                                           , v-torgconf-self-bank-c-schet
     2644                                                           , v-torgconf-self-bank-bik
     2645                                                           , v-torgconf-self-bank-name
     2646                                                           , (if v-torgconf-self-bank-city = "":U then "":U else ( "г. " + v-torgconf-self-bank-city) )     )
     2647                                                   else "":U )
     2648                                           ).
     2649         if v-torgconf-outares = yes
     2650         and p-reverse = no
     2651         then do:
     2652            assign
     2653               v-par-consignee-addres = v-torgconf-ship-post-addres
     2654            .
     2655         end.
     2656         if v-torgconf-outares = no
     2657         and p-reverse = no
     2658         then do:
     2659            assign
     2660               v-par-consignee-addres = v-torgconf-ship-addres
     2661            .
     2662         end.
     2663         if p-reverse = yes
     2664         then do:
     2665             assign
     2666               v-par-consignee-addres = v-torgconf-ship-addres
     2667             .
     2668         end.
     2669           assign
