     7265   procedure PrintTitul :
     7266       define variable v-organization  as character    no-undo.
     7267       define variable v-object        as character    no-undo.
     7268   do
     7269   on error undo, return error return-value  :
     7270       case clients.obj-type:
     7271          when 'орг':U
     7272          then do:
     7273               FIND ub.firm WHERE ub.firm.firm-code = clients.obj-code NO-LOCK .
     7274               if available ub.firm
     7275               then do:
     7276                   assign
     7277                       t-addres = ( if ub.firm.ind = 0 or ub.firm.ind = ? then "" else string( ub.firm.ind ) )
     7278                       t-addres = t-addres
     7279                           + ( if ub.firm.city = ? or trim(ub.firm.city) = ""
     7280                               then ""
     7281                               else ( (if t-addres = "" then "" else ", ") + trim( ub.firm.city ) )
     7282                             )
     7283                       t-temp-address = ( if ub.firm.addres1 = ? then "" else trim( substring( ub.firm.addres1, 1, 50 ) ) )
     7284                       t-addres = t-addres + ( if t-addres = "" or t-temp-address = "" then "" else ", " )
     7285                           + ( if t-temp-address = "" then "" else ( trim( t-temp-address ) ) )
     7286                           + ( if  ub.firm.addres2 = ? or trim(ub.firm.addres2) = "" then "" else ( ", " + trim( ub.firm.addres2 ) ) )
     7287                       t-temp-address = ( if ub.firm.addres1 = ? then "" else trim( substring( ub.firm.addres1, 51, 50 ) ) )
     7288                       t-addres = t-addres + ( if t-addres = "" or t-temp-address = "" then "" else ", " )
     7289                           + ( if t-temp-address = "" then "" else ( trim( t-temp-address ) ) )
     7290                       t-temp-address = ( if ub.firm.addres1 = ? then "" else trim( substring( ub.firm.addres1, 101, 50 ) ) )
     7291                       t-addres = t-addres + ( if t-addres = "" or t-temp-address = "" then "" else ", " )
     7292                           + ( if t-temp-address = "" then "" else ( trim( t-temp-address ) ) )
     7293                       t-phone = ub.firm.phone
     7294                       t-inn   = ub.firm.inn
     7295                       t-okpo  = ub.firm.okpo
     7296                   .
     7297               end.
     7298          end.
     7299          when 'маг':U
     7300          then do:
     7301               FIND ub.shop WHERE ub.shop.obj-code = clients.obj-code NO-LOCK .
     7302               if available ub.shop
     7303               then do:
     7304                   assign
     7305                       t-addres = ( if trim( shop.addres1 ) <> "" then ( trim( shop.addres1 ) ) else "" )
     7306                               + ( if trim( shop.addres2 ) <> "" then ( ", " + trim( shop.addres2 ) ) else "" )
     7307                       t-phone = shop.phone
     7308                       t-inn = ""
     7309                       t-okpo = ""
     7310                   .
     7311               end.
     7312          end.
     7313          when 'скл':U
     7314          then do:
     7315               FIND ub.store WHERE ub.store.obj-code = clients.obj-code NO-LOCK .
     7316               if available ub.store
     7317               then do:
     7318                   assign
     7319                       t-addres = ( if trim( ub.store.addres1 ) <> "" then ( trim( ub.store.addres1 ) ) else "" )
     7320                               + ( if trim( ub.store.addres2 ) <> "" then ( ", " + trim( ub.store.addres2 ) ) else "" )
     7321                       t-phone = ub.store.phone
     7322                       t-inn = ""
     7323                       t-okpo = ""
     7324                   .
     7325               end.
     7326          end.
     7327          when 'чел':U
     7328          then do:
     7329               find ub.person where ub.person.psn-code = clients.obj-code no-lock .
     7330               if available ub.person
     7331               then do:
     7332                   assign
     7333                       t-addres = ( if ub.person.ind <> 0 and ub.person.ind <> ? then string( ub.person.ind ) else "" )
     7334                                   + ( if  ub.person.city <> ? and trim(ub.person.city) <> "" then ( ", " + trim( ub.person.city ) ) else "" )
     7335                                   + ( if  ub.person.address <> ? and trim(ub.person.address) <> "" then ( ", " + trim( ub.person.address ) ) else "" )
     7336                       t-phone = ub.person.phone1
     7337                       t-inn = ub.person.inn
     7338                       t-okpo = ub.person.okpo
     7339                   .
     7340               end.
     7341          end.
     7342       end case.
     7343       define variable v-outprncd    as character no-undo.
     7344       define variable v-par-type    as character no-undo.
     7345       define variable v-buh-sum-str as character no-undo .
     7346       define variable v-buh-sum     as decimal   no-undo .
     7347       define variable v-str         as character no-undo .
     7348       define variable v-abbr-str    as character no-undo .
     7349       define variable v-doc-date    as character no-undo .
     7350       define variable v-fact-date   as character no-undo .
     7351       define variable v-frame-str   as character no-undo .
     7352       define variable v-prikaz-num  as character no-undo .
     7353       define variable v-prikaz-date as character no-undo .
     7354       run gbl/conf-rd.p ("outprncd", "":U, "":U, 0, "":U, "":U, "":U, no, output v-outprncd, output v-par-type) no-error.
     7355       if v-outprncd = "yes" then
     7356       do:
     7357         assign
     7358           v-organization = string( "ИНН " + t-inn + " " + CAPS( clients.obj-name ) + " (" + string(clients.obj-code) + ")" + t-addres + t-phone)
     7359           v-object       = string( CAPS( This_Object.obj-name ) + " (" + string(This_Object.obj-code) + ")" )
     7360         .
     7361       end.
     7362       else do:
     7363         assign
     7364           v-organization = string( "ИНН " + t-inn + " " + CAPS( clients.obj-name ) + t-addres + t-phone)
     7365           v-object       =  CAPS( This_Object.obj-name )
     7366         .
     7367       end.
     7368       assign
     7369         v-buh-sum-str = 'К началу проведения инвентаризации все расходные и приходные документы на товарно-материальные ценности сданы в бухгалтерию и все товарно-материальные ценности, поступившие на мою ( нашу ) отвественность, оприходованы, а выбывшие списаны в расход.'
     7370       .
     7371       if v-doc-date = ""
     7372       then do:
     7373         for each temp-str
     7374         :
     7375           assign
     7376             v-buh-sum = v-buh-sum + temp-str.b-stoim
     7377           .
     7378         end.
     7379         if PrintRubl = yes then do: run rep/wp-rub.p (                      input v-buh-sum, output v-str, output v-abbr-str ). end.
     7380                            else do: run rep/wp.p     ( input parParentProc, input v-buh-sum, output v-str, output v-abbr-str ). end.
     7381         assign
     7382           v-buh-sum-str = v-buh-sum-str + " Остаток товара на начало инвентаризации составляет сумму: " + v-str
     7383           v-object      = v-object + ", " + v-torgconf-self-obj-addres
     7384         .
     7385       end.
     7386   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdatinv-val in g#trdcalib (  input buf_trn-doc.doc-code ,
     7387                           input 'trdcattr-inv-date':U ,
     7388                          output v-doc-date ,
     7389                          output p-type ) no-error .
     7390   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdatinv-val in g#trdcalib (  input buf_trn-doc.doc-code ,
