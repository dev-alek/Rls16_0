     3624               assign v-torgconf-vdoc-date = v-torgconf-doc-date-attr
     3625               .
     3626           end.
     3627       end.
     3628      if  v-name <> 'wthtrg12'
     3629      and v-name <> 'wthfct'
     3630      and v-name <> 'wthm11'
     3631      then do:
     3632       run gbl/trdcat-v.p (
     3633                     input p-doc-code
     3634                   , input 'NFinDoc':U
