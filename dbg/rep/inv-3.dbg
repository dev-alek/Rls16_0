     6958                   , input string( sum * qnty )
     6959                   , input "":U
     6960                   , input "":U
     6961               ).
     6962           end.
     6963         end.
     6964         else do:
     6965           assign qnty = - qnty .
     6966           display stream Out-Stream
     6967             sym1     sym2     sym3  ('  /'+ buf_gds-prt.f-name)  @ temp-str.gds-name
     6968             sym4     if rep-tipe = "sl-gold" then "" else string(b-code) @ temp-str.b-code
     6969             sym5     sym6
     6970             sym7     qnty @ temp-str.b-qnty
     6971                  sym10
     6972           with FRAME sl-gold.
     6973           if rep-tipe begins "invent"
     6974           and p-grp = "no"
     6975           then do:
     6976               run inv3xl-write-line-data in this-procedure (
