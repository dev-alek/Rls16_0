     2100   procedure torgconf-get-sup-param :
     2101   define input parameter p-obj-type           as character        no-undo.
     2102   define input parameter p-obj-code           as integer          no-undo.
     2103   define input parameter p-curr-code          as integer          no-undo.
     2104       define variable v-host-code    as integer      no-undo.
     2105       define variable v-par-type     as character    no-undo.
     2106   do
     2107   on error undo, return error
     2108   :
     2109       assign
     2110          v-torgconf-sup-host-code = v-host-code
     2111       .
     2112       if v-torgconf-sup-host-code = 0
     2113       then do:
     2114           assign
     2115               v-torgconf-sup-host-name           = "":U
     2116               v-torgconf-sup-host-addres         = "":U
     2117               v-torgconf-sup-host-post-addres    = "":U
     2118               v-torgconf-sup-host-phone          = "":U
     2119               v-torgconf-sup-host-inn            = "":U
     2120               v-torgconf-sup-host-kpp            = "":U
     2121               v-torgconf-sup-host-okpo           = "":U
     2122               v-torgconf-sup-host-egrip-date     = "":U
     2123               v-torgconf-sup-host-egrip-num      = "":U
     2124           .
     2125       end.
     2126       else do:
     2127           run fmtcli-get-client in this-procedure (
     2128                 input 'орг':U
     2129               , input v-torgconf-sup-host-code
     2130           ).
     2131           assign
     2132               v-torgconf-sup-host-name        = v-fmtcli-name
     2133               v-torgconf-sup-host-engl-name   = v-fmtcli-engl-name
     2134               v-torgconf-sup-host-addres      = v-fmtcli-full-addres
     2135               v-torgconf-sup-host-post-addres = v-fmtcli-post-addres
     2136               v-torgconf-sup-host-phone       = v-fmtcli-phone
     2137               v-torgconf-sup-host-inn         = v-fmtcli-inn
     2138               v-torgconf-sup-host-kpp         = v-fmtcli-kpp
     2139               v-torgconf-sup-host-okpo        = v-fmtcli-okpo
     2140           .
     2141           run gbl/clntat-v.p (
     2142                 input 'орг':U
     2143               , input v-torgconf-sup-host-code
     2144               , input 'egrip-date':U
     2145               , output v-torgconf-sup-host-egrip-date
     2146               , output v-par-type
     2147           ).
     2148           run gbl/clntat-v.p (
     2149                 input 'орг':U
     2150               , input v-torgconf-sup-host-code
     2151               , input 'egrip-num':U
     2152               , output v-torgconf-sup-host-egrip-num
     2153               , output v-par-type
     2154           ).
     2155           run fmtcli-get-bank in this-procedure (
     2156                 input v-host-code
     2157               , input 'орг':U
     2158               , input v-torgconf-sup-host-code
     2159               , input p-curr-code
     2160           ).
     2161       end.
     2162       assign
     2163           v-torgconf-sup-schet-exists = v-fmtcli-schet-exists
     2164           v-torgconf-sup-bank-exists  = v-fmtcli-bank-exists
     2165           v-torgconf-sup-bank-r-schet = v-fmtcli-bank-r-schet
     2166           v-torgconf-sup-bank-c-schet = v-fmtcli-bank-c-schet
     2167           v-torgconf-sup-bank-bik     = v-fmtcli-bank-bik
     2168           v-torgconf-sup-bank-name    = v-fmtcli-bank-name
     2169           v-torgconf-sup-bank-addres  = v-fmtcli-bank-addres
     2170           v-torgconf-sup-bank-city    = v-fmtcli-bank-city
     2171       .
     2172       assign
     2173           v-torgconf-sup-obj-type = p-obj-type
     2174           v-torgconf-sup-obj-code = p-obj-code
     2175       .
     2176       if trim(p-obj-type) <> ""
     2177       and p-obj-code <> 0
     2178       then do:
     2179       run fmtcli-get-client in this-procedure (
     2180             input p-obj-type
     2181           , input p-obj-code
     2182       ).
     2183       assign
     2184           v-torgconf-sup-obj-name        = v-fmtcli-name
     2185           v-torgconf-sup-obj-engl-name   = v-fmtcli-engl-name
     2186           v-torgconf-sup-obj-addres      = v-fmtcli-full-addres
     2187           v-torgconf-temp-post-addres    = v-fmtcli-post-addres
     2188           v-torgconf-sup-obj-phone       = v-fmtcli-phone
     2189           v-torgconf-sup-obj-inn         = v-fmtcli-inn
     2190           v-torgconf-sup-obj-okpo        = v-fmtcli-okpo
     2191       .
     2192      end.
     2193      end.
     2194   end procedure.
