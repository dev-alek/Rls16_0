     3645                   , output v-ddate-attr
     3646                   , output v-par-type
     3647               ) no-error.
     3648       if error-status :error
     3649       then do:
     3650           assign v-ddate-attr = "".
     3651       end.
     3652      end.
     3653      else do:
     3654   if valid-handle( g#wthcalib ) <> yes then do:       run str/wthcalib.p persistent no-error.       if error-status :error or valid-handle( g#wthcalib ) <> yes then do:         message "Error starting wthcalib.p"    skip( 0 )                 g#wthcalib                     skip( 0 )                 g#wthcalib   :type             skip( 0 )                 g#wthcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run wthcalib_wthat-val in g#wthcalib (  input p-doc-code ,
     3655                           input 'wthpaydoc':U ,
