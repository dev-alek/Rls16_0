      857   initial "@(#)$Workfile$ $Revision$".
      858   define variable v-fmtcli-name          as character    no-undo.
      859   define variable v-fmtcli-engl-name     as character    no-undo.
      860   define variable v-fmtcli-addres        as character    no-undo.
      861   define variable v-fmtcli-post-addres   as character    no-undo.
      862   define variable v-fmtcli-full-addres   as character    no-undo.
      863   define variable v-fmtcli-phone         as character    no-undo.
      864   define variable v-fmtcli-inn           as character    no-undo.
      865   define variable v-fmtcli-kpp           as character    no-undo.
      866   define variable v-fmtcli-okpo          as character    no-undo.
      867   define variable v-fmtcli-country       as character    no-undo.
      868   define variable v-fmtcli-city          as character    no-undo.
      869   define variable v-fmtcli-index         as character    no-undo.
      870   define variable v-fmtcli-schet-exists  as logical      no-undo.
      871   define variable v-fmtcli-bank-exists   as logical      no-undo.
      872   define variable v-fmtcli-bank-r-schet  as character    no-undo.
      873   define variable v-fmtcli-bank-c-schet  as character    no-undo.
      874   define variable v-fmtcli-bank-bik      as character    no-undo.
      875   define variable v-fmtcli-bank-name     as character    no-undo.
      876   define variable v-fmtcli-bank-addres   as character    no-undo.
      877   define variable v-fmtcli-bank-city     as character    no-undo.
      878   procedure fmtcli-get-bank :
      879   define input parameter p-host-code      as integer          no-undo.
      880   define input parameter p-obj-type       as character        no-undo.
      881   define input parameter p-obj-code       as integer          no-undo.
      882   define input parameter p-curr-code      as integer          no-undo.
      883       define buffer buf_fin-schet     for ub.fin-schet.
      884       define buffer buf_fin-bank      for ub.fin-bank.
      885   do
      886   for buf_fin-schet
      887     , buf_fin-bank
      888   on error undo, return error
      889   :
      890       assign
      891           v-fmtcli-schet-exists       = no
      892           v-fmtcli-bank-exists        = no
      893           v-fmtcli-bank-r-schet       = "":U
      894           v-fmtcli-bank-c-schet       = "":U
      895           v-fmtcli-bank-bik           = "":U
      896           v-fmtcli-bank-name          = "":U
      897           v-fmtcli-bank-addres        = "":U
      898           v-fmtcli-bank-city          = "":U
      899       .
      900       search-for-schet:
      901       for each buf_fin-schet no-lock
      902          where buf_fin-schet.host-code = p-host-code
      903            and buf_fin-schet.cli-type  = p-obj-type
      904            and buf_fin-schet.cli-code  = p-obj-code
      905            and buf_fin-schet.curr-code = p-curr-code
      906       on error undo, return error
      907       :
      908           if buf_fin-schet.status_   = 'удал':U
      909           then do:
      910           end.
      911           else do:
      912               assign
      913                   v-fmtcli-schet-exists   = yes
      914                   v-fmtcli-bank-r-schet   = trim( buf_fin-schet.r-schet )
      915                   v-fmtcli-bank-c-schet   = trim( buf_fin-schet.c-schet )
      916               .
      917               find first buf_fin-bank no-lock
      918                    where buf_fin-bank.host-code = p-host-code
      919                      and buf_fin-bank.code-bank = buf_fin-schet.code-bank
      920               no-error.
      921               if available buf_fin-bank
      922               then do:
      923                   assign
      924                       v-fmtcli-bank-exists      = yes
      925                       v-fmtcli-bank-bik         = trim( buf_fin-bank.bik )
      926                       v-fmtcli-bank-name        = trim( buf_fin-bank.bank-name )
      927                       v-fmtcli-bank-addres      = trim(buf_fin-bank.addres)
      928                       v-fmtcli-bank-city      = trim(buf_fin-bank.bank-city)
      929                   .
      930               end.
      931               else do:
      932                   assign
      933                       v-fmtcli-bank-exists    = no
      934                       v-fmtcli-bank-bik       = "":U
      935                       v-fmtcli-bank-name      = "":U
      936                       v-fmtcli-bank-addres    = "":U
      937                       v-fmtcli-bank-city      = "":U
      938                   .
      939               end.
      940               leave search-for-schet.
      941           end.
      942       end.
      943   end.
      944   end procedure.
      945   procedure fmtcli-get-client :
      946   define input parameter p-obj-type       as character    no-undo.
      947   define input parameter p-obj-code       as integer      no-undo.
      948       define variable v-temp-fmtcli-address      as character     no-undo.
      949       define variable v-num-country-city    as integer      no-undo.
      950       define buffer buf_clients   for ub.clients.
      951       define buffer buf_firm      for ub.firm.
      952       define buffer buf_store     for ub.store.
      953       define buffer buf_shop      for ub.shop.
      954       define buffer buf_person    for ub.person.
      955   do
      956   for buf_clients
      957     , buf_firm
      958     , buf_store
      959     , buf_shop
      960     , buf_person
      961   on error undo, return error
      962   :
      963       assign
      964           v-fmtcli-name           = "":U
      965           v-fmtcli-addres         = "":U
      966           v-fmtcli-post-addres    = "":U
      967           v-fmtcli-full-addres    = "":U
      968           v-fmtcli-phone          = "":U
      969           v-fmtcli-inn            = "":U
      970           v-fmtcli-kpp            = "":U
      971           v-fmtcli-okpo           = "":U
      972           v-fmtcli-city           = "":U
      973           v-fmtcli-index          = "":U
      974           v-fmtcli-country        = "":U
      975       .
      976       find first buf_clients no-lock
      977            where buf_clients.obj-type = p-obj-type
      978              and buf_clients.obj-code = p-obj-code
      979       .
      980       assign
      981           v-fmtcli-name = buf_clients.obj-name
      982       .
      983       case buf_clients.obj-type:
      984          when 'орг':U
      985          then do:
      986               find first buf_firm no-lock
      987                    where buf_firm.firm-code = buf_clients.obj-code
      988                    no-error
      989               .
      990               if available buf_firm
      991               then do:
      992                   assign
      993                       v-num-country-city = num-entries( buf_firm.city )
      994                       v-fmtcli-engl-name = buf_firm.engl-name
      995                   .
      996                   if v-num-country-city > 0
      997                   then do:
      998                       assign
      999                           v-fmtcli-country    = trim( entry( 1, buf_firm.city ) )
     1000                       .
     1001                   end.
     1002                   if v-num-country-city > 1
     1003                   then do:
     1004                       assign
     1005                           v-fmtcli-city       = trim( entry( 2, buf_firm.city ) )
     1006                       .
     1007                   end.
     1008                   run fmtcli-concatenate-strings in this-procedure (
     1009                         input v-fmtcli-full-addres
     1010                       , input v-fmtcli-country
     1011                       , input ", ":U
     1012                       , input 50
     1013                       , output v-fmtcli-full-addres
     1014                   ).
     1015                   run fmtcli-concatenate-strings in this-procedure (
     1016                         input v-fmtcli-full-addres
     1017                       , input v-fmtcli-city
     1018                       , input ", ":U
     1019                       , input 50
     1020                       , output v-fmtcli-full-addres
     1021                   ).
     1022                   run fmtcli-concatenate-strings in this-procedure (
     1023                         input v-fmtcli-full-addres
     1024                       , input IF buf_firm.ind = 0 THEN "" ELSE string( buf_firm.ind )
     1025                       , input ", ":U
     1026                       , input 50
     1027                       , output v-fmtcli-full-addres
     1028                   ).
     1029                   run fmtcli-concatenate-strings in this-procedure (
     1030                         input v-fmtcli-post-addres
     1031                       , input v-fmtcli-country
     1032                       , input ", ":U
     1033                       , input 50
     1034                       , output v-fmtcli-post-addres
     1035                   ).
     1036                   run fmtcli-concatenate-strings in this-procedure (
     1037                         input v-fmtcli-post-addres
     1038                       , input v-fmtcli-city
     1039                       , input ", ":U
     1040                       , input 50
     1041                       , output v-fmtcli-post-addres
     1042                   ).
     1043                   run fmtcli-concatenate-strings in this-procedure (
     1044                         input v-fmtcli-post-addres
     1045                       , input string( buf_firm.ind )
     1046                       , input ", ":U
     1047                       , input 50
     1048                       , output v-fmtcli-post-addres
     1049                   ).
     1050                   run fmtcli-concatenate-strings in this-procedure (
     1051                         input substring( buf_firm.addres1, 1, 50 )
     1052                       , input buf_firm.addres2
     1053                       , input " ":U
     1054                       , input 50
     1055                       , output v-temp-fmtcli-address
     1056                   ).
     1057                   run fmtcli-concatenate-strings in this-procedure (
     1058                         input v-temp-fmtcli-address
     1059                       , input substring( buf_firm.addres1, 51, 50 )
     1060                       , input " ":U
     1061                       , input 50
     1062                       , output v-temp-fmtcli-address
     1063                   ).
     1064                   run fmtcli-concatenate-strings in this-procedure (
     1065                         input v-temp-fmtcli-address
     1066                       , input substring( buf_firm.addres1, 101, 50 )
     1067                       , input " ":U
     1068                       , input 50
     1069                       , output v-temp-fmtcli-address
     1070                   ).
     1071                   assign
     1072                       v-fmtcli-addres = v-temp-fmtcli-address
     1073                   .
     1074                   if buf_firm.addres1 <> ?
     1075                   then do:
     1076                       run fmtcli-concatenate-strings in this-procedure (
     1077                             input v-fmtcli-full-addres
     1078                           , input v-fmtcli-addres
     1079                           , input ", ":U
     1080                           , input 0
     1081                           , output v-fmtcli-full-addres
     1082                       ).
     1083                   end.
     1084                   run fmtcli-concatenate-strings in this-procedure (
     1085                         input substring( buf_firm.post-addr1, 1, 50 )
     1086                       , input buf_firm.post-addr2
     1087                       , input " ":U
     1088                       , input 50
     1089                       , output v-fmtcli-post-addres
     1090                   ).
     1091                   run fmtcli-concatenate-strings in this-procedure (
     1092                         input v-fmtcli-post-addres
     1093                       , input substring( buf_firm.post-addr1, 51, 50 )
     1094                       , input " ":U
     1095                       , input 50
     1096                       , output v-fmtcli-post-addres
     1097                   ).
     1098                   run fmtcli-concatenate-strings in this-procedure (
     1099                         input v-fmtcli-post-addres
     1100                       , input substring( buf_firm.post-addr1, 101, 50 )
     1101                       , input " ":U
     1102                       , input 50
     1103                       , output v-fmtcli-post-addres
     1104                   ).
     1105                   assign
     1106                       v-fmtcli-phone         = buf_firm.phone
     1107                       v-fmtcli-inn           = buf_firm.inn
     1108                       v-fmtcli-kpp           = buf_firm.kpp
     1109                       v-fmtcli-okpo          = buf_firm.okpo
     1110                       v-fmtcli-index         = string( buf_firm.ind )
     1111                   .
     1112               end.
     1113          end.
     1114          when 'маг':U
     1115          then do:
     1116               find first buf_shop no-lock
     1117                    where buf_shop.obj-code = buf_clients.obj-code
     1118               .
     1119               if available buf_shop
     1120               then do:
     1121                   run fmtcli-concatenate-strings in this-procedure (
     1122                         input buf_shop.addres1
     1123                       , input buf_shop.addres2
     1124                       , input " ":U
     1125                       , input 50
     1126                       , output v-fmtcli-addres
     1127                   ).
     1128                   assign
     1129                       v-fmtcli-full-addres = v-fmtcli-addres
     1130                       v-fmtcli-post-addres = v-fmtcli-addres
     1131                       v-fmtcli-phone       = buf_shop.phone
     1132                       v-fmtcli-inn         = "":U
     1133                       v-fmtcli-kpp         = "":U
     1134                       v-fmtcli-okpo        = "":U
     1135                       v-fmtcli-city        = "":U
     1136                       v-fmtcli-index       = "":U
     1137                   .
     1138               end.
     1139          end.
     1140          when 'скл':U
     1141          then do:
     1142               find first buf_store no-lock
     1143                    where buf_store.obj-code = buf_clients.obj-code
     1144               .
     1145               if available buf_store
     1146               then do:
     1147                   run fmtcli-concatenate-strings in this-procedure (
     1148                         input buf_store.addres1
     1149                       , input buf_store.addres2
     1150                       , input " ":U
     1151                       , input 50
     1152                       , output v-fmtcli-addres
     1153                   ).
     1154                   assign
     1155                       v-fmtcli-full-addres = v-fmtcli-addres
     1156                       v-fmtcli-phone       = buf_store.phone
     1157                       v-fmtcli-inn         = "":U
     1158                       v-fmtcli-kpp         = "":U
     1159                       v-fmtcli-okpo        = "":U
     1160                       v-fmtcli-city        = "":U
     1161                       v-fmtcli-index       = "":U
     1162                   .
     1163               end.
     1164          end.
     1165          when 'чел':U
     1166          then do:
     1167               find first buf_person no-lock
     1168                    where buf_person.psn-code = buf_clients.obj-code
     1169               .
     1170               if available buf_person
     1171               then do:
     1172                   run fmtcli-concatenate-strings in this-procedure (
     1173                         input ( if buf_person.ind = 0 or buf_person.ind = ?
     1174                                 then "":U
     1175                                 else string( buf_person.ind, "999999")
     1176                                 )
     1177                       , input buf_person.city
     1178                       , input ", ":U
     1179                       , input 0
     1180                       , output v-fmtcli-full-addres
     1181                   ).
     1182                   assign
     1183                       v-fmtcli-addres = buf_person.address
     1184                   .
     1185                   run fmtcli-concatenate-strings in this-procedure (
     1186                         input v-fmtcli-full-addres
     1187                       , input v-fmtcli-addres
     1188                       , input ", ":U
     1189                       , input 0
     1190                       , output v-fmtcli-full-addres
     1191                   ).
     1192                   assign
     1193                       v-fmtcli-phone     = buf_person.phone1
     1194                       v-fmtcli-inn       = buf_person.inn
     1195                       v-fmtcli-kpp       = buf_person.kpp
     1196                       v-fmtcli-okpo      = buf_person.okpo
     1197                       v-fmtcli-city      = buf_person.city
     1198                       v-fmtcli-index     = string( buf_person.ind )
     1199                   .
     1200               end.
     1201          end.
     1202       end case.
     1203   end.
     1204   end procedure.
     1205   procedure fmtcli-concatenate-strings :
     1206   define input parameter p-string-1       as character        no-undo.
     1207   define input parameter p-string-2       as character        no-undo.
     1208   define input parameter p-delimiter      as character        no-undo.
     1209   define input parameter p-length         as integer          no-undo.
     1210   define output parameter p-out-string    as character        no-undo.
     1211   do
     1212   on error undo, return error
     1213   :
     1214       assign
     1215           p-out-string = ( if p-string-1 = ?
     1216                            then "":U
     1217                            else trim( p-string-1 ) )
     1218       .
     1219       assign
     1220           p-out-string = p-out-string
     1221                        + ( if p-out-string = "":U
     1222                            or length( p-out-string ) = p-length
     1223                            or p-string-2 = ?
     1224                            or trim( p-string-2 ) = "":U
     1225                            then "":U
     1226                            else p-delimiter )
     1227                        + ( if p-string-2 = ?
     1228                            or trim( p-string-2 ) = "":U
     1229                            then "":U
     1230                            else trim( p-string-2 ) )
     1231       .
     1232   end.
     1233   end procedure.
