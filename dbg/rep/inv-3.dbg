     5334         end.
     5335         assign temp-str.a-qnty      = buf_doc-line-sum.fact-qnty
     5336                temp-str.price-after = temp-str.a-stoim / temp-str.a-qnty.
     5337       end.
     5338       else do:
     5339         if costprice = yes then do:
     5340           if PrintRubl = yes then do: assign sum = buf_doc-line.price-rubl * buf_doc-line.fact-qnty. end.
     5341                              else do: assign sum = buf_doc-line.price-base * buf_doc-line.fact-qnty. end.
     5342         end.
     5343         else do:
     5344           assign sum = 0.
     5345           for each buf_gds-dtl no-lock where
     5346                    buf_gds-dtl.doc-code  = buf_doc-line.doc-code  and
     5347                    buf_gds-dtl.artic     = buf_doc-line.artic     and
     5348                    buf_gds-dtl.prod-type = buf_doc-line.prod-type and
     5349                    buf_gds-dtl.prod-code = buf_doc-line.prod-code :
     5350             if PrintRubl = yes then do: assign sum = sum + buf_gds-dtl.price-rubl * buf_gds-dtl.doc-qnty. end.
     5351                                else do: assign sum = sum + buf_gds-dtl.price-base * buf_gds-dtl.doc-qnty. end.
     5352           end.
     5353         end.
     5354         assign temp-str.a-stoim     = temp-str.b-stoim + sum
     5355                temp-str.a-qnty      = temp-str.b-qnty  + buf_doc-line.fact-qnty
     5356                temp-str.price-after = temp-str.a-stoim / temp-str.a-qnty.
     5357       end.
     5358       if temp-str.price-after = ? then do: assign temp-str.price-after = 0. end.
     5359       if rep-tipe = "invent-gold" then do:
     5360         if is-after-cli = yes then do:
     5361           find first buf_doc-line-sum no-lock where
     5362                      buf_doc-line-sum.doc-code = buf_doc-line.doc-code and
     5363                      buf_doc-line-sum.gds-code = buf_goods.gds-code    and
     5364                      buf_doc-line-sum.sum-type = 'acd':U  no-error.
     5365           if available buf_doc-line-sum then do: assign temp-str.a-qnty1 = buf_doc-line-sum.fact-qnty. end.
     5366         end.
     5367         else do:
     5368           assign temp-str.a-qnty1 = temp-str.b-qnty1 + buf_doc-line.cli-qnty.
     5369         end.
     5370       end.
     5371       if v-prn0 = "no" then do:
     5372         if temp-str.a-qnty = 0 and temp-str.a-stoim = 0 and temp-str.b-qnty = 0 and temp-str.b-stoim = 0 then do:
     5373           delete temp-str.
     5374         end.
     5375       end.
     5376     end.
     5377     else do:
     5378       if costprice = yes then do:
     5379         if is-general = yes then do:
     5380           find first buf_doc-line-sum no-lock where
     5381                      buf_doc-line-sum.doc-code = buf_doc-line.doc-code and
     5382                      buf_doc-line-sum.gds-code = buf_goods.gds-code    and
     5383                      buf_doc-line-sum.sum-type = 'gen':U    no-error.
     5384           if no-vat = no then do:
     5385             if PrintRubl = yes then do: assign sum = buf_doc-line-sum.cost-sum-rubl. end.
     5386                                else do: assign sum = buf_doc-line-sum.cost-sum-base. end.
     5387           end.
     5388           else do:
     5389             if PrintRubl = yes then do: assign sum = buf_doc-line-sum.cost-sum-rubl - buf_doc-line-sum.cost-VAT-rubl. end.
     5390                                else do: assign sum = buf_doc-line-sum.cost-sum-base - buf_doc-line-sum.cost-VAT-base. end.
     5391           end.
     5392         end.
     5393         else do:
     5394           if PrintRubl = yes then do: assign sum = buf_doc-line.price-rubl * buf_doc-line.fact-qnty. end.
     5395                              else do: assign sum = buf_doc-line.price-base * buf_doc-line.fact-qnty. end.
     5396         end.
     5397       end.
     5398       else do:
     5399         assign sum = 0.
     5400         for each buf_gds-dtl no-lock where
     5401                  buf_gds-dtl.doc-code  = buf_doc-line.doc-code  and
     5402                  buf_gds-dtl.artic     = buf_doc-line.artic     and
     5403                  buf_gds-dtl.prod-type = buf_doc-line.prod-type and
     5404                  buf_gds-dtl.prod-code = buf_doc-line.prod-code :
     5405           if PrintRubl = yes then do: assign sum = sum + buf_gds-dtl.price-rubl * buf_gds-dtl.doc-qnty. end.
     5406                              else do: assign sum = sum + buf_gds-dtl.price-base * buf_gds-dtl.doc-qnty. end.
     5407         end.
     5408       end.
     5409       assign qnty = buf_doc-line.fact-qnty.
     5410       if sum >= 0 then do:
     5411         assign temp-str.a-qnty      = qnty
     5412                temp-str.a-stoim     = sum
     5413                temp-str.a-qnty1     = buf_doc-line.cli-qnty
     5414                temp-str.ubl         = 0.
     5415         if temp-str.a-qnty = 0 and temp-str.a-stoim = 0 then do: delete temp-str. end.
     5416       end.
     5417       else do:
     5418         assign temp-str.b-qnty      = - qnty
     5419                temp-str.b-stoim     = - sum
     5420                temp-str.b-qnty1     = - buf_doc-line.cli-qnty
     5421                temp-str.ubl         = 0
     5422                sum                  = - sum.
     5423         if is-wastage = yes then do:
     5424           find first buf_doc-line-sum no-lock where
     5425                      buf_doc-line-sum.doc-code = buf_doc-line.doc-code and
     5426                      buf_doc-line-sum.gds-code = buf_goods.gds-code    and
     5427                      buf_doc-line-sum.sum-type = 'wst':U    no-error.
     5428           if available buf_doc-line-sum then do:
     5429             if costprice = yes then do:
     5430               if PrintRubl = yes then do: assign temp-str.ubl = buf_doc-line-sum.cost-sum-rubl. end.
     5431                                  else do: assign temp-str.ubl = buf_doc-line-sum.cost-sum-base. end.
     5432             end.
     5433             else do:
     5434               if PrintRubl = yes then do: assign temp-str.ubl = buf_doc-line-sum.sale-sum-rubl. end.
     5435                                  else do: assign temp-str.ubl = buf_doc-line-sum.sale-sum-base. end.
     5436             end.
     5437             if sum < temp-str.ubl then do: assign temp-str.ubl = sum. end.
     5438           end.
     5439         end.
     5440         if temp-str.b-qnty = 0 and temp-str.b-stoim = 0 then do: delete temp-str. end.
     5441       end.
     5442     end.
     5443   end.
     5444   procedure t-level :
     5445     define input parameter  p-node-code like ub.gds-grp.node-code no-undo .
     5446     define output parameter p-node-name as character              no-undo .
     5447     define variable         v-is-term   as logical                no-undo .
     5448     define buffer loc-gds-grp for ub.gds-grp .
     5449     v-is-term = false .
     5450     repeat while v-is-term = false :
     5451         find first loc-gds-grp where loc-gds-grp.upper-code = p-node-code no-error .
     5452         run grplib-get-full-name in this-procedure
     5453           (  input loc-gds-grp.node-code
     5454           , output p-node-name
     5455           ) .
     5456           assign
     5457             p-node-code = loc-gds-grp.node-code
     5458             v-is-term = loc-gds-grp.is-term
     5459           .
     5460       end.
     5461   end procedure.
     5462    procedure n-level :
     5463     define input  parameter p-upper-code like ub.gds-grp.upper-code no-undo .
     5464     define input  parameter p-lvl-num    as   integer               no-undo .
     5465     define output parameter p-node-name  as   character             no-undo .
     5466     define variable        v-lvl-num     as   integer               no-undo .
     5467     define variable loc-grp-name         as   character             no-undo .
     5468     define buffer loc-gds-grp for ub.gds-grp .
     5469     v-lvl-num = 0 .
     5470       repeat while p-lvl-num <> v-lvl-num :
     5471         find first loc-gds-grp where loc-gds-grp.node-code = p-upper-code no-error .
     5472         run grplib-get-full-name in this-procedure
     5473           (  input loc-gds-grp.node-code
     5474           , output p-node-name
     5475           ) .
     5476         assign
     5477           v-lvl-num    = loc-gds-grp.lvl-num
     5478           p-upper-code = loc-gds-grp.upper-code
     5479         .
     5480       end.
     5481   end procedure.
     5482    procedure no-classify :
     5483     define input    parameter p-node-code like ub.gds-grp.node-code no-undo .
     5484     define output   parameter p-grp-name  as character              no-undo .
     5485     define variable           v-lvl-num   like ub.gds-grp.lvl-num   no-undo .
     5486     define buffer loc-gds-grp for ub.gds-grp .
     5487     v-lvl-num = 0 .
     5488     repeat while v-lvl-num ne 1 :
     5489         find first loc-gds-grp where loc-gds-grp.node-code = p-node-code no-error .
     5490         assign
     5491             p-node-code = loc-gds-grp.upper-code
     5492             v-lvl-num   = loc-gds-grp.lvl-num
     5493             p-grp-name  = loc-gds-grp.node-name
     5494         .
     5495     end.
     5496   end procedure.
     5497     run PrintTitul in this-procedure .
     5498     if rep-tipe = "invent" THEN  DO:
     5499       FORM with frame invent .    FORM HEADER
     5500         LineBuf format "X(185)" SKIP
     5501         String("        " + "                " + "              " + String(PgQnty ,  "->>>>>>>>>9.<<<" ) + sym8 + "       "+
     5502                String(PgQnty-b,  "->>>>>>>>>>>>9.<<<" ) + sym5 )  at 100 Format "x(90)" skip
     5503         "Итого по странице : " skip
     5504         "а) количество порядковых номеров " + string(PgNPP) + " (" + f-wp-qnty (decimal(PgNPP)) + ")" format "X(185)" AT 18  skip
     5505         "б) общее количество единиц фактически " + string(PgQnty) + " (" + f-wp-qnty (decimal(PgQnty)) + ")"  format "X(185)" AT 18  SKIP
     5506         "Вкладной лист к форме № ИНВ-3 №  " + string( PAGE-NUMBER(Out-Stream) - 1, ">>>>9") format "x(170)" AT 30 SKIP
     5507       with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     5508       VIEW stream Out-Stream FRAME BottomFrame .
     5509     End.
     5510     if rep-tipe = "invent-gold" THEN DO:
     5511       FORM with frame invent-gold .
     5512       FORM HEADER
     5513         LineBuf format "X(194)" SKIP
     5514         String(sym1 + String(PgQnty ,  "->>>>>>>>>9.<<<" ) + String(PgQnty-v ,  "->>>>>>>>>9.<<<" ) + sym2 + String(PgSum , "->>>>>>>>>>9.99"   ) +
     5515                sym6 + "           " + sym3 + String(PgQnty-b,   "->>>>>>>>9.<<<" ) + String(PgQnty-b-v, "->>>>>>>>9.<<<" ) +
     5516                sym4 + String(PgSum-b , "->>>>>>>>>>>>>9.99"   ) + sym5)  at 100 Format "x(98)"       skip
     5517         "Итого по странице : " skip
     5518         "а) количество порядковых номеров " + string(PgNPP) + " (" + f-wp-qnty (decimal(PgNPP)) + ")" format "X(194)" AT 18  skip
     5519         "б) общее количество единиц фактически " + string(PgQnty) + " (" + f-wp-qnty (decimal(PgQnty)) + ")"  format "X(194)" AT 18  SKIP
     5520         "Вкладной лист к форме № ИНВ-3 №  " + string( PAGE-NUMBER(Out-Stream) - 1, ">>>>9") format "x(170)" AT 30 SKIP
     5521       with FRAME BottomFrame2 width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     5522       VIEW stream Out-Stream FRAME BottomFrame2 .
     5523     end.
     5524     if rep-tipe begins "invent" THEN DO:
     5525       PUT stream Out-Stream SPACE(35) string ("Инвентаризационная опись N " + tdoc-code ) format "x(50)" SKIP
     5526         SPACE(10) string (string (This_Object.obj-type , "X(3)") + ": " + trim(This_Object.obj-name) ) format "x(50)"
     5527         string ("дата инвентаризации : " + string (tdoc-date, "99.99.9999") ) format "x(50)" SKIP.
     5528     End.
     5529     if rep-tipe = "sl" THEN  FORM with frame sl .
     5530     if rep-tipe = "sl-gold" THEN  FORM with frame sl-gold .
     5531     if v-sort-prod = "yes" then do:
     5532       if sort-group = yes then do:
     5533         for each temp-str no-lock break by temp-str.prod-type by temp-str.prod-code by temp-str.grp-name by if sort-name then  temp-str.gds-name Else ( if skod then  temp-str.b-code Else temp-str.artic ) :
     5534           if first-of( temp-str.prod-code) then run print-prod in this-procedure .
     5535           if p-grp <> "prod" and first-of( temp-str.grp-name)  then run print-grp in this-procedure .
     5536           run print-line in this-procedure .
     5537           if p-grp <> "prod" and last-of( temp-str.grp-name)   then run print-grp-itog in this-procedure .
     5538           if last-of( temp-str.prod-code)  then run print-prod-itog in this-procedure .
     5539         end.
     5540       end.
     5541       else do:
     5542         for each temp-str no-lock break by temp-str.prod-type by temp-str.prod-code by if sort-name then  temp-str.gds-name Else ( if skod then  temp-str.b-code Else temp-str.artic ) :
     5543           if p-grp <> "prod" and first-of( temp-str.prod-code) then run print-prod in this-procedure .
     5544           run print-line in this-procedure .
     5545           if last-of( temp-str.prod-code)  then run print-prod-itog in this-procedure .
     5546         end.
     5547       end.
     5548     end.
     5549     else do:
     5550       if sort-group = yes then do:
     5551         for each temp-str no-lock break by temp-str.grp-name by if sort-name then  temp-str.gds-name Else ( if skod then  temp-str.b-code Else temp-str.artic ) :
     5552           if p-grp = "no" and first-of( temp-str.grp-name) then run print-grp in this-procedure .
     5553           run print-line in this-procedure .
     5554           if last-of( temp-str.grp-name) then  run print-grp-itog in this-procedure .
     5555         end.
     5556       end.
     5557       else do:
     5558         for each temp-str no-lock break by if sort-name then  temp-str.gds-name Else ( if skod then  temp-str.b-code Else temp-str.artic ) :
     5559           run print-line in this-procedure .
     5560         end.
     5561       end.
     5562     end.
     5563     run print-all-itog in this-procedure .
     5564     run on-same-page in this-procedure (input 14) .
     5565     run PrintPodval in this-procedure .
     5566     output stream Out-Stream CLOSE .
     5567   if mFrameView
     5568   then do:
     5569      HIDE FRAME InfoFrame.
     5570   end.
     5571       if rep-tipe begins "invent"
     5572       and p-grp = "no"
     5573       then do:
     5574           run inv3xl-close in this-procedure .
     5575       end.
     5576   if g#quest-print = false
     5577   then do:
     5578     run adecomm/_osprint.p ( ?, string( session:temp-directory + "rpt" + string( g#report-num ) ),
     5579                                         7, (if 8 >= 8 then 2 else 0), 0, 0,
     5580                                         OUTPUT g#log ).
     5581   end.
     5582   else do:
     5583     os-command silent
     5584       value( "COPY /b " +
     5585         string( session:temp-directory) +  "$" + string( g#report-num ) + " + " +
     5586         string( session:temp-directory) + "rpt" + string( g#report-num ) + " " +
     5587         string( session:temp-directory) +  "$" + string( g#report-num )
     5588                 ) .
     5589     os-command silent
     5590       value( "COPY /b " +
     5591         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl" + " + " +
     5592         string( session:temp-directory) + "rpt" + string( g#report-num ) + ".txl" + " " +
     5593         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl"
     5594                 ) .
     5595   end.
     5596   end.
     5597   procedure print-grp :
     5598     do  on error undo, return error return-value  :
     5599       case rep-tipe :
     5600         when "invent" THEN DO:
     5601           DOWN stream Out-Stream 1 with FRAME invent .
     5602           PUT stream Out-Stream UNFORMATTED String("_______________Группа : " + TRIM(CAPS(temp-str.grp-name)) + UndLine)  FORMAT "X(185)"  skip  .
     5603         End.
     5604         when "invent-gold" THEN DO:
     5605           DOWN stream Out-Stream 1 with FRAME invent-gold .
     5606           PUT stream Out-Stream UNFORMATTED String("_______________Группа : " + TRIM(CAPS(temp-str.grp-name)) + UndLine)  FORMAT "X(194)"  skip  .
     5607         End.
     5608         when  "sl"  THEN DO:
     5609           DOWN stream Out-Stream 1 with FRAME sl .
     5610           PUT stream Out-Stream UNFORMATTED String("_______________Группа : " + TRIM(CAPS(temp-str.grp-name)) + UndLine)  FORMAT "X(162)"  skip  .
     5611         End.
     5612         when  "sl-gold"  THEN DO:
     5613           DOWN stream Out-Stream 1 with FRAME sl-gold .
     5614           PUT stream Out-Stream UNFORMATTED String("_______________Группа : " + TRIM(CAPS(temp-str.grp-name)) + UndLine)  FORMAT "X(196)"  skip  .
     5615         End.
     5616       End.
     5617     end.
     5618   end procedure.
     5619   procedure print-prod :
     5620     do  on error undo, return error return-value  :
     5621       find first buf_clients no-lock
     5622         where buf_clients.obj-type = temp-str.prod-type
     5623           and buf_clients.obj-code = temp-str.prod-code
     5624       .
     5625       if p-grp <> "prod" then do:
     5626         case rep-tipe :
     5627           when "invent" THEN DO:
     5628             DOWN stream Out-Stream 1 with FRAME invent .
     5629             PUT stream Out-Stream UNFORMATTED String("________Производитель : " + TRIM(CAPS(buf_clients.obj-name)) + UndLine)  FORMAT "X(185)"  skip  .
     5630           End.
     5631           when "invent-gold" THEN DO:
     5632             DOWN stream Out-Stream 1 with FRAME invent-gold .
     5633             PUT stream Out-Stream UNFORMATTED String("________Производитель : " + TRIM(CAPS(buf_clients.obj-name)) + UndLine)  FORMAT "X(194)"  skip  .
     5634           End.
     5635           when  "sl"  THEN DO:
     5636             DOWN stream Out-Stream 1 with FRAME sl .
     5637             PUT stream Out-Stream UNFORMATTED String("________Производитель : " + TRIM(CAPS(buf_clients.obj-name)) + UndLine)  FORMAT "X(162)"  skip  .
     5638           End.
     5639           when  "sl-gold"  THEN DO:
     5640             DOWN stream Out-Stream 1 with FRAME sl-gold .
     5641             PUT stream Out-Stream UNFORMATTED String("________Производитель : " + TRIM(CAPS(buf_clients.obj-name)) + UndLine)  FORMAT "X(196)"  skip  .
     5642           End.
     5643         End.
     5644       End.
     5645     end.
     5646   end procedure.
     5647   procedure print-line :
     5648     do on error undo, return error return-value :
     5649       case rep-tipe :
     5650         when "invent"      THEN DO:
     5651   define variable vss-include-info30 as character format "X(65)" no-undo
     5652   initial "@(#)$Workfile$ $Revision$".
     5653     assign Lines_Counter = Lines_Counter + 1  .
     5654     if line-counter( out-stream ) + 2 > page-size( out-stream ) then page stream out-stream.
     5655     if line-counter( Out-Stream ) < Tmp_Counter then
     5656       assign PgNPP = 0  PgQnty = 0 PgSum = 0 PgQnty-b = 0 PgSum-b  = 0  PgQnty-v = 0  PgQnty-b-v = 0 .
     5657     assign
     5658       Tmp_Counter  = line-counter( Out-Stream )
     5659       PgNPP        = PgNPP      + 1
     5660       PgQnty       = PgQnty     + temp-str.a-qnty
     5661       PgQnty-b     = PgQnty-b   + temp-str.b-qnty
     5662       PgQnty-v     = PgQnty-v   + temp-str.a-qnty1
     5663       PgQnty-b-v   = PgQnty-b-v + temp-str.b-qnty1
     5664       PgSum        = PgSum      + temp-str.a-stoim
     5665       PgSum-b      = PgSum-b    + temp-str.b-stoim
     5666       num-ln = num-ln + 1
     5667       sum-a-qnty    = sum-a-qnty    + temp-str.a-qnty
     5668       sum-b-qnty    = sum-b-qnty    + temp-str.b-qnty
     5669       sum-a-qnty1   = sum-a-qnty1   + temp-str.a-qnty1
     5670       sum-b-qnty1   = sum-b-qnty1   + temp-str.b-qnty1
     5671       sum-a-stoim   = sum-a-stoim   + temp-str.a-stoim
     5672       sum-b-stoim   = sum-b-stoim   + temp-str.b-stoim
     5673       sum-ubl       = sum-ubl       + temp-str.ubl
     5674       sum1-a-qnty   = sum1-a-qnty   + temp-str.a-qnty
     5675       sum1-b-qnty   = sum1-b-qnty   + temp-str.b-qnty
     5676       sum1-a-qnty1  = sum1-a-qnty1  + temp-str.a-qnty1
     5677       sum1-b-qnty1  = sum1-b-qnty1  + temp-str.b-qnty1
     5678       sum1-a-stoim  = sum1-a-stoim  + temp-str.a-stoim
     5679       sum1-b-stoim  = sum1-b-stoim  + temp-str.b-stoim
     5680       sum1-ubl      = sum1-ubl      + temp-str.ubl
     5681       sum2-a-qnty   = sum2-a-qnty   + temp-str.a-qnty
     5682       sum2-b-qnty   = sum2-b-qnty   + temp-str.b-qnty
     5683       sum2-a-qnty1  = sum2-a-qnty1  + temp-str.a-qnty1
     5684       sum2-b-qnty1  = sum2-b-qnty1  + temp-str.b-qnty1
     5685       sum2-a-stoim  = sum2-a-stoim  + temp-str.a-stoim
     5686       sum2-b-stoim  = sum2-b-stoim  + temp-str.b-stoim
     5687       sum2-ubl      = sum2-ubl      + temp-str.ubl
     5688     .
     5689     FullNameGds = temp-str.gds-name .
     5690     gds-str1 = breakstr(FullNameGds, 40, input-output  gds-str1, input-output gds-str2).
     5691     assign j = 0.
     5692     DO WHILE gds-str2 <> "" :
     5693       assign gds-str = gds-str2.
     5694       gds-str1 = breakstr(gds-str, 40, input-output gds-str1, input-output gds-str2).
     5695       assign j = j + 1.
     5696     END.
     5697     if line-counter( Out-Stream ) + j > page-size( Out-Stream ) then  PAGE STREAM Out-Stream.
