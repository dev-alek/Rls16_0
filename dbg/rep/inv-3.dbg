     4686     define variable v-host-code as integer   no-undo .
     4687     define variable v-curr-code as integer   no-undo .
     4688   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4689   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     4690     (input  buf_trn-doc.obj-type
     4691     ,input  buf_trn-doc.obj-code
     4692     ,output v-host-code
     4693     )  .
     4694     if printRubl = yes
     4695     then do:
     4696         assign
     4697             v-curr-code = 0
     4698         .
     4699     end.
     4700     else do:
     4701   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4702   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     4703     (input  v-host-code
     4704     ,output v-curr-code
     4705     )  .
     4706     end.
     4707   define variable vss-include-info27 as character format "X(65)" no-undo
     4708   initial "@(#)$Workfile: inv3xl.i $ $Revision: aea5316774be, 0, rls $".
     4709   define stream excel-line.
     4710   define stream excel-cell.
     4711   define temp-table temp_cell-data no-undo
     4712       field data-key as character
     4713       field data-value as character
     4714       index pi is primary unique data-key
     4715   .
     4716   define temp-table temp_line-data no-undo
     4717       field data-key     as character
     4718       field xl-line-id   as integer
     4719       field num          as integer
     4720       field name         as character
     4721       field gdscode      as character
     4722       field EI           as character
     4723       field OKEI         as character
     4724       field price        as character
     4725       field qntyFact     as character
     4726       field sumFact      as character
     4727       field qntyBuh      as character
     4728       field sumBuh       as character
     4729       index pi is primary unique xl-line-id
     4730   .
     4731   define variable v-inv3xl-current-data-row     as integer      no-undo.
     4732   define variable v-inv3xl-cell-file-name       as character    no-undo.
     4733   define variable v-inv3xl-data-file-name       as character    no-undo.
     4734   procedure inv3xl-init :
     4735       define buffer buf_temp_cell-data        for temp_cell-data.
     4736       define buffer buf_usr-flt               for ubflt.usr-flt.
     4737   do
     4738   for buf_temp_cell-data
     4739     , buf_usr-flt
     4740   on error undo, return error
     4741   :
     4742       assign
     4743           v-inv3xl-current-data-row = 0
     4744       .
     4745       run gbl/_tmpfile.p (
     4746             input "xd"
     4747           , input ".txt"
     4748           , output v-inv3xl-data-file-name
     4749       ).
     4750       output stream excel-line to value( v-inv3xl-data-file-name ).
     4751       run gbl/_tmpfile.p (
     4752             input "xc"
     4753           , input ".txt"
     4754           , output v-inv3xl-cell-file-name
     4755       ).
     4756       output stream excel-cell to value( v-inv3xl-cell-file-name ).
     4757       if v-curr-code = 0 then do :
     4758          run inv3xl-write-cell-data in this-procedure (
     4759                input "valutCode":U
     4760              , input 0
     4761          ).
     4762       end.
     4763       else do :
     4764          run inv3xl-write-cell-data in this-procedure (
     4765                input "valutCode":U
     4766              , input 1
     4767          ).
     4768       end.
     4769       run inv3xl-write-cell-data in this-procedure (
     4770             input "columnList":U
     4771           , input "num,name,gdscode,EI,OKEI,price,qntyFact,sumFact,qntyBuh,sumBuh":U
     4772       ).
     4773       run inv3xl-write-cell-data in this-procedure (
     4774             input "columnType":U
     4775           , input "I,S,I,S,S,C,D,C,D,C":U
     4776       ).
     4777       run inv3xl-write-cell-data in this-procedure (
     4778             input "columnAmount":U
     4779           , input "10":U
     4780       ).
     4781       run inv3xl-write-cell-data in this-procedure (
     4782             input "subtotalList":U
     4783           , input "num,qntyFact,qntyBuh":U
     4784       ).
     4785       run inv3xl-write-cell-data in this-procedure (
     4786             input "subtotalType":U
     4787           , input "C,S,S,S,S":U
     4788       ).
     4789       run inv3xl-write-cell-data in this-procedure (
     4790             input "subtotalAmount":U
     4791           , input "5":U
     4792       ).
     4793       run inv3xl-write-cell-data in this-procedure (
     4794           input "subtotalPropisList":U
     4795           , input "num,qntyFact":U
     4796       ).
     4797       run inv3xl-write-cell-data in this-procedure (
     4798           input "subtotalPropisAmount":U
     4799           , input "3":U
     4800       ).
     4801   end.
     4802   end procedure.
     4803   procedure inv3xl-close :
     4804   do
     4805   on error undo, return error
     4806   :
     4807       output stream excel-line close.
     4808       output stream excel-cell close.
     4809       output to value( string( session:temp-directory + "$" + string( g#report-num ) ) + ".txl" ) append.
     4810           export "exe/i3_97.xlt":U.
     4811           export "exe/t_97.bas":U.
     4812           export v-inv3xl-cell-file-name.
     4813           export v-inv3xl-data-file-name.
     4814       output close.
     4815   end.
     4816   end procedure.
     4817   procedure inv3xl-write-cell-data :
     4818   define input parameter p-data-key   as character        no-undo.
     4819   define input parameter p-data-value as character        no-undo.
     4820       define buffer buf_temp_cell-data     for temp_cell-data.
     4821   do
     4822   for buf_temp_cell-data
     4823   on error undo, return error
     4824   :
     4825       find first buf_temp_cell-data
     4826            where buf_temp_cell-data.data-key = p-data-key
     4827       no-error.
     4828       if not available buf_temp_cell-data
     4829       then do:
     4830           create buf_temp_cell-data.
     4831           assign
     4832               buf_temp_cell-data.data-key = p-data-key
     4833           .
     4834       end.
     4835       assign
     4836           buf_temp_cell-data.data-value = p-data-value
     4837       .
     4838       put stream excel-cell unformatted
     4839                           buf_temp_cell-data.data-key
     4840           CHR(9)   buf_temp_cell-data.data-value
     4841           chr(10)
     4842       .
     4843   end.
     4844   end procedure.
     4845   procedure inv3xl-write-line-data :
     4846   define input parameter p-num        as integer          no-undo.
     4847   define input parameter p-name       as character        no-undo.
     4848   define input parameter p-gdscode    as character        no-undo.
     4849   define input parameter p-EI         as character        no-undo.
     4850   define input parameter p-OKEI       as character        no-undo.
     4851   define input parameter p-price      as character        no-undo.
     4852   define input parameter p-qntyFact   as character        no-undo.
     4853   define input parameter p-sumFact    as character        no-undo.
     4854   define input parameter p-qntyBuh    as character        no-undo.
     4855   define input parameter p-sumBuh     as character        no-undo.
     4856       define buffer buf_temp_line-data        for temp_line-data.
     4857   do
     4858   for buf_temp_line-data
     4859   on error undo, return error
     4860   :
     4861       for each buf_temp_line-data
     4862       :
     4863           delete buf_temp_line-data.
     4864       end.
     4865       create buf_temp_line-data.
     4866       assign
     4867           v-inv3xl-current-data-row = v-inv3xl-current-data-row + 1
     4868       .
     4869       assign
     4870           buf_temp_line-data.data-key     = "LD":U
     4871           buf_temp_line-data.xl-line-id   = v-inv3xl-current-data-row
     4872           buf_temp_line-data.num       = p-num
     4873           buf_temp_line-data.name      = p-name
     4874           buf_temp_line-data.gdscode   = p-gdscode
     4875           buf_temp_line-data.EI        = p-EI
     4876           buf_temp_line-data.OKEI      = p-OKEI
     4877           buf_temp_line-data.price     = p-price
     4878           buf_temp_line-data.qntyFact  = p-qntyFact
     4879           buf_temp_line-data.sumFact   = p-sumFact
     4880           buf_temp_line-data.qntyBuh   = p-qntyBuh
     4881           buf_temp_line-data.sumBuh    = p-sumBuh
     4882       .
     4883       put stream excel-line unformatted
     4884                           buf_temp_line-data.data-key
     4885           CHR(9)   ( if buf_temp_line-data.num = 0 then "":U else string( buf_temp_line-data.num ) )
     4886           CHR(9)   buf_temp_line-data.name
     4887           CHR(9)   buf_temp_line-data.gdscode
     4888           CHR(9)   buf_temp_line-data.EI
     4889           CHR(9)   buf_temp_line-data.OKEI
     4890           CHR(9)   buf_temp_line-data.price
     4891           CHR(9)   buf_temp_line-data.qntyFact
     4892           CHR(9)   buf_temp_line-data.sumFact
     4893           CHR(9)   buf_temp_line-data.qntyBuh
     4894           CHR(9)   buf_temp_line-data.sumBuh
     4895           chr(10)
     4896       .
     4897   end.
     4898   end procedure.
     4899   procedure inv3xl-run-excel :
     4900   define input parameter p-header-filename    as character        no-undo.
     4901   define input parameter p-data-filename      as character        no-undo.
     4902       define variable v-template-file-name    as character    no-undo.
     4903       define variable v-vb-file-name          as character    no-undo.
     4904       define buffer buf_temp-param for temp-param .
     4905   do
     4906   for buf_temp-param
     4907   on error undo, return error
     4908   :
     4909       create buf_temp-param.
