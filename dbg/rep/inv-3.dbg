     6993       end.
     6994     end.
     6995     if print-graft = false THEN  Put stream Out-Stream LineBuf format "X(196)" SKIP.
     6996   end.
     6997   end.
     6998   else do:
     6999   if p-grp = "no" then do:
     7000     display stream Out-Stream
     7001       sym1     num-ln @ Lines_Counter
     7002       sym2     temp-str.artic
     7003       sym3     (if rep-tipe = "invent-gold" OR rep-tipe = "sl-gold" then gds-str1         else temp-str.gds-name) @ temp-str.gds-name
     7004       sym4     (if rep-tipe = "invent-gold" OR rep-tipe = "sl-gold" then temp-str.tb-code else temp-str.b-code)   @ temp-str.b-code
     7005       sym5     temp-str.OKEI
     7006       sym6     temp-str.unit-base
     7007       sym14 temp-str.UBL
     7008       sym8 sym11  sym15 UBL-v
     7009       temp-str.a-qnty1 temp-str.b-qnty1
     7010       sym7    temp-str.price-befor
     7011       sym8    temp-str.a-qnty
     7012       sym9     temp-str.a-stoim
     7013       sym9    temp-str.b-qnty
     7014       sym12    temp-str.b-stoim
     7015       sym10  with FRAME sl-gold.
     7016     DOWN stream Out-Stream 1 with FRAME sl-gold .
     7017       if rep-tipe begins "invent"
     7018       and p-grp = "no"
     7019       then do:
     7020           run inv3xl-write-line-data in this-procedure (
     7021               input num-ln
