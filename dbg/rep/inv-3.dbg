     1435   define variable v-doc-code-attr                 as character no-undo.
     1436   define variable v-torgconf-doc-date-attr        as character no-undo.
     1437   define variable v-torgconf-vdoc-date            as character no-undo.
     1438   define variable v-torgconf-main-boss-post       as character no-undo.
     1439   define variable v-torgconf-ogr-name             as character no-undo.
     1440   define variable v-torgconf-ogr-post             as character no-undo.
     1441   define variable v-name                          as character    no-undo.
     1442   define variable v-form-name    as character    no-undo.
     1443   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1444   procedure wthcattr-sprcli :
     1445   define input parameter parparentproc  as widget-handle no-undo.
     1446   define input parameter p-mode  as character no-undo.
     1447   define input-output parameter p-value as character no-undo .
     1448   define output parameter p-setted as logical no-undo .
     1449     DEFINE VARIABLE v-value as character no-undo .
     1450     define variable v-cli-type as character no-undo .
     1451     define variable v-cli-code as integer no-undo .
     1452     define buffer buf_clients   for ub.clients.
     1453     define variable v_rid as character no-undo.
     1454     define variable ref-rec as recid no-undo .
     1455     do
     1456     on error undo, return error
     1457     :
     1458         v-value = p-value.
     1459      if p-value <> '':U then do:
     1460       assign
     1461       v-cli-type = substring(p-value, 1, 3)
     1462       v-cli-code = integer(substring(p-value, 4))
     1463       no-error.
     1464       if error-status:error then do:
     1465         assign
     1466         v-cli-type = '':U
     1467         v-cli-code = 0
     1468         .
     1469       end.
     1470      end.
     1471      FIND FIRST buf_clients NO-LOCK WHERE
     1472               buf_clients.obj-type = v-cli-type AND
     1473               buf_clients.obj-code = v-cli-code  NO-ERROR.
     1474      IF available(buf_clients) then do:
     1475       run ref/cli-all.w (
     1476                   input parparentproc
     1477                  ,input if p-mode = 'ИЗМЕНЕНИЕ':U then "b-sel":U else "":U
     1478                  ,input v-cli-type
     1479                  ,input 'все':U
     1480                  ,input 'все':U
     1481                  ,input RECID( buf_clients )
     1482                  ,input ",,,,,,NO"
     1483                  ,input ?
     1484                  ,OUTPUT v_rid ).
     1485     END.
     1486     ELSE if p-mode = 'ИЗМЕНЕНИЕ':U then DO:
     1487       run ref/cli-all.w (
     1488                    input parparentproc
     1489                   ,INPUT "b-sel":U
     1490                  ,input  v-cli-type
     1491                  ,input 'все':U
     1492                  ,input 'текущие':U
     1493                  ,input ?
     1494                  ,input ",,,,,,NO"
     1495                  ,input ?
     1496                  ,OUTPUT v_rid ).
     1497     END.
     1498     else do:
     1499       message
     1500       if p-value = "":U then 'Атрибут не задан!'
     1501       else substitute('Не найден клиент &1',p-value)
     1502       view-as alert-box warning.
     1503     end.
     1504     IF v_rid <> ? AND v_rid <> "":U THEN DO:
     1505       ASSIGN ref-rec = INT( v_rid ) NO-ERROR.
     1506       IF ERROR-STATUS:ERROR THEN DO:
     1507           RETURN NO-APPLY.
     1508       END.
     1509       FIND FIRST buf_clients NO-LOCK WHERE
     1510                  RECID( buf_clients ) = ref-rec NO-ERROR.
     1511       IF AVAIL buf_clients THEN DO:
     1512         v-value = buf_clients.obj-type + string(buf_clients.obj-code, ">>>>>>>>9").
     1513       end.
     1514     end.
     1515     if v-value <> p-value then do:
     1516       p-value = v-value.
     1517       p-setted = yes.
     1518     end.
     1519     end.
     1520   end procedure.
     1521     define new global shared variable g#wthcalib as handle no-undo.
     1522   procedure torgconf-read :
     1523   do
