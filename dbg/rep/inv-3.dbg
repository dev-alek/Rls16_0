     4045            end.
     4046            find first buf_clients no-lock
     4047                where buf_clients.obj-type = 'орг':U
     4048                and buf_clients.obj-code = p-host-code
     4049            .
     4050            find first buf_firm no-lock
     4051                where buf_firm.firm-code = buf_clients.obj-code
     4052            .
     4053            assign
     4054                v-torgconf-ogr-name = buf_firm.director
     4055            .
     4056         end.
     4057         if v-torgconf-outogr = "dir_obj"
     4058            then do:
     4059            find first buf_trn-doc no-lock
     4060            where buf_trn-doc.doc-code = p-doc-code
     4061            no-error.
     4062               CASE buf_trn-doc.obj-type:
     4063               WHEN 'маг':U
     4064               THEN DO:
     4065                  find first buf_shop no-lock
     4066                  where buf_shop.obj-code = buf_trn-doc.obj-code
     4067                  .
     4068                  assign
     4069                     v-torgconf-ogr-name = buf_shop.director
     4070                     v-torgconf-ogr-post = "Директор"
     4071                  .
     4072               END.
     4073               WHEN 'скл':U
     4074               THEN DO:
     4075                  find first buf_store no-lock
     4076                  where buf_store.obj-code = buf_trn-doc.obj-code
     4077                  .
     4078                  assign
     4079                     v-torgconf-ogr-name = buf_store.store-boss
     4080                     v-torgconf-ogr-post = "Директор"
     4081                  .
     4082               END.
     4083               OTHERWISE DO:
     4084                  assign
     4085                     v-torgconf-ogr-name = "":U
     4086                     v-torgconf-ogr-post = "":U
     4087                  .
     4088               END.
     4089               END CASE.
     4090            end.
     4091      if v-torgconf-outogr = "manag_doc"
     4092         then do:
     4093            find first buf_trn-doc no-lock
     4094            where buf_trn-doc.doc-code = p-doc-code
     4095            no-error.
     4096            if available buf_trn-doc
     4097            then do:
     4098               run rep/get-psn.p
     4099               (input buf_trn-doc.boss
     4100               ,output v-torgconf-ogr-name
     4101               ) .
     4102            end.
     4103            find first buf_person no-lock
     4104            where buf_person.psn-code = buf_trn-doc.boss
     4105            no-error.
     4106            if available buf_person
     4107            then do:
     4108               v-torgconf-ogr-post = buf_person.position.
     4109            end.
     4110            if v-torgconf-ogr-name = "?":U then v-torgconf-ogr-name = "".
     4111            if v-torgconf-ogr-post = ? then  v-torgconf-ogr-post = "".
     4112         end.
     4113      end.
     4114      else do:
     4115      find first buf_wth-doc no-lock
     4116         where buf_wth-doc.doc-code = p-doc-code
     4117         no-error.
     4118         if v-torgconf-outogr = "no_print"
     4119            then do:
     4120               assign
     4121                  v-torgconf-ogr-name = ""
     4122                  v-torgconf-ogr-post = ""
     4123               .
     4124            end.
     4125         if v-torgconf-outogr  = "ruk_firm"
     4126               then do:
     4127               find first buf_sysconf no-lock
     4128               where buf_sysconf.host-code = p-host-code
     4129               no-error.
     4130               if available buf_sysconf
     4131               then do:
     4132                  assign
     4133                     v-torgconf-ogr-post = buf_sysconf.head-position
     4134                  .
     4135               end.
     4136               find first buf_clients no-lock
     4137                  where buf_clients.obj-type = 'орг':U
     4138                  and buf_clients.obj-code = p-host-code
     4139               .
     4140               find first buf_firm no-lock
     4141                  where buf_firm.firm-code = buf_clients.obj-code
     4142               .
     4143               assign
     4144                  v-torgconf-ogr-name = buf_firm.director
     4145               .
     4146            end.
     4147            if v-torgconf-outogr = "dir_obj"
     4148               then do:
     4149               find first buf_wth-doc no-lock
     4150               where buf_wth-doc.doc-code = p-doc-code
     4151               no-error.
     4152                  find first buf_shop no-lock
     4153                  where buf_shop.obj-code = buf_wth-doc.obj-code
     4154                  .
     4155                  assign
     4156                     v-torgconf-ogr-name = buf_shop.director
     4157                     v-torgconf-ogr-post = "Директор"
     4158                  .
     4159               end.
     4160         if v-torgconf-outogr = "manag_doc"
     4161            then do:
     4162               find first buf_wth-doc no-lock
     4163               where buf_wth-doc.doc-code = p-doc-code
     4164               no-error.
     4165               if available buf_wth-doc
     4166               then do:
     4167                  run rep/get-psn.p
     4168                  (input buf_wth-doc.deliver
     4169                  ,output v-torgconf-ogr-name
     4170                  ) .
     4171               end.
     4172               find first buf_person no-lock
     4173               where buf_person.psn-code = buf_wth-doc.deliver
     4174               no-error.
     4175               if available buf_person
     4176               then do:
     4177                  v-torgconf-ogr-post = buf_person.position.
     4178               end.
     4179               if v-torgconf-ogr-name = "?":U then v-torgconf-ogr-name = "".
     4180               if v-torgconf-ogr-post = ? then  v-torgconf-ogr-post = "".
     4181            end.
     4182      end.
     4183   end.
     4184   procedure torgconf-get-reason  :
     4185   define input parameter  p-doc-code       as character        no-undo.
     4186   define input parameter  p-reason-code    as integer          no-undo .
     4187   define input parameter  p-doc-type       as character        no-undo.
     4188       if p-reason-code > 0
     4189       then do:
     4190           define buffer buf_trn-reason for ub.trn-reason.
     4191           find first buf_trn-reason no-lock where buf_trn-reason.reason-code = p-reason-code no-error .
     4192           if available buf_trn-reason then assign v-torgconf-reason =  buf_trn-reason.reason-name .
     4193       end.
     4194       else do:
     4195           if p-doc-type = 'при':U
     4196           then  do:
     4197               define variable v-attr-type     as character    no-undo.
     4198               define variable v-attr-value    as character    no-undo.
     4199               run gbl/trdcat-v.p (input p-doc-code,input 'nids':U,output v-attr-value,output v-attr-type) .
     4200               assign v-torgconf-reason = v-attr-value .
     4201               run gbl/trdcat-v.p (input p-doc-code,input 'dids':U,output v-attr-value,output v-attr-type) .
     4202               assign v-torgconf-reason = v-torgconf-reason + " от " + v-attr-value .
     4203           end.
     4204       end.
     4205   end procedure.
     4206   def var vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4207   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
     4208   procedure paramls-clear :
     4209     define buffer buf_temp-param for temp-param .
     4210     do
     4211     on error undo, return error return-value
     4212     :
     4213       for each buf_temp-param
     4214       on error undo, return error
     4215       :
     4216         delete buf_temp-param .
     4217       end.
     4218     end.
     4219   end procedure.
     4220   procedure paramls-write :
     4221     define input  parameter p-code     as character no-undo .
     4222     define input  parameter p-sub-code as character no-undo .
     4223     define input  parameter p-value    as character no-undo .
     4224     define buffer buf_temp-param for temp-param .
     4225     do
     4226     on error undo, return error return-value
     4227     :
     4228       find first buf_temp-param
     4229         where buf_temp-param.param-code     = p-code
     4230           and buf_temp-param.param-sub-code = p-sub-code
     4231         no-error .
     4232       if not available buf_temp-param then do:
     4233         create buf_temp-param .
     4234         assign
     4235           buf_temp-param.param-code     = p-code
     4236           buf_temp-param.param-sub-code = p-sub-code
     4237         .
     4238       end.
     4239       assign
     4240         buf_temp-param.param-value = p-value
     4241       .
     4242     end.
     4243   end procedure.
     4244   procedure paramls-read :
     4245     define input  parameter p-code          as character no-undo .
     4246     define input  parameter p-sub-code      as character no-undo .
     4247     define input  parameter p-default-value as character no-undo .
     4248     define output parameter p-value         as character no-undo .
     4249     define buffer buf_temp-param for temp-param .
     4250     do
     4251     on error undo, return error return-value
     4252     :
     4253       find first buf_temp-param
     4254         where buf_temp-param.param-code     = p-code
     4255           and buf_temp-param.param-sub-code = p-sub-code
     4256         no-error .
     4257       if available buf_temp-param then do:
     4258         assign
     4259           p-value = buf_temp-param.param-value
     4260         .
     4261       end.
     4262       else do:
     4263         assign
     4264           p-value = p-default-value
     4265         .
     4266       end.
     4267     end.
     4268   end procedure.
     4269   procedure paramls-append :
     4270     define input  parameter p-code     as character no-undo .
     4271     define input  parameter p-sub-code as character no-undo .
     4272     define input  parameter p-value    as character no-undo .
     4273     define buffer buf_temp-param for temp-param .
     4274     do
     4275     on error undo, return error return-value
     4276     :
     4277       find first buf_temp-param
     4278            where buf_temp-param.param-code     = p-code
     4279              and buf_temp-param.param-sub-code = p-sub-code
     4280         no-error .
     4281       if not available buf_temp-param then do:
     4282         create buf_temp-param .
     4283         assign
     4284           buf_temp-param.param-code     = p-code
     4285           buf_temp-param.param-sub-code = p-sub-code
     4286           buf_temp-param.param-value    = p-value
     4287         .
     4288       end.
     4289       else do:
     4290           assign
     4291               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
     4292           .
     4293       end.
     4294     end.
     4295   end procedure.
     4296   define new global shared variable g#lib-trn  as handle no-undo .
     4297   define new global shared variable g#lib-trn2 as handle no-undo .
     4298   define new global shared variable g#lib-trn3 as handle no-undo .
     4299   define new global shared variable g#lib-trn4 as handle no-undo .
     4300     function valid-density returns logical ( input p-density as decimal, input p-unit-base-cli-eq as logical ) :
     4301       define variable v-answ as logical no-undo .
     4302       if ( p-unit-base-cli-eq = true
     4303            and p-density = 1.0
     4304          )
     4305         or ( p-unit-base-cli-eq = false
     4306              and p-density <> ?
     4307              and p-density > 0.0
     4308              and p-density < 1.0
     4309            )
     4310       then do:
     4311         assign
     4312           v-answ = true
     4313         .
     4314       end.
     4315       else do:
     4316         assign
     4317           v-answ = false
     4318         .
     4319       end.
     4320       return v-answ.
     4321     end function.
     4322   define variable vss-include-info23 as character format "X(65)" no-undo
     4323   initial "@(#)$Workfile$ $Revision$".
     4324   procedure grplib-get-full-name :
     4325      define input parameter p-node-code  as integer      no-undo.
     4326      define output parameter p-full-name as character    no-undo.
     4327      do
     4328   on error undo, return error
     4329   :
     4330       define variable v-upper-code    as integer           no-undo.
     4331       define buffer buf_gds-grp       for ub.gds-grp.
     4332       define buffer buf_upper_gds-grp for ub.gds-grp.
     4333       find first buf_gds-grp no-lock
     4334            where buf_gds-grp.node-code = p-node-code
     4335       no-error.
     4336       if not available buf_gds-grp
     4337       then do:
     4338           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
     4339       end.
     4340       assign
     4341           p-full-name  = ""
     4342           v-upper-code = 1
     4343       .
     4344       do while buf_gds-grp.upper-code <> 0
     4345       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
     4346       :
     4347           assign
     4348               p-full-name  = buf_gds-grp.node-name
     4349                            + (if p-full-name <> "" then chr(47) else "")
     4350                            + p-full-name
     4351               v-upper-code = buf_gds-grp.upper-code
     4352           .
     4353           find first buf_gds-grp no-lock
     4354                where buf_gds-grp.node-code = v-upper-code
     4355           no-error.
     4356           if not available buf_gds-grp
     4357           then do:
     4358               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
     4359                                   + string( v-upper-code )
     4360                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     4361           end.
     4362       end.
     4363       assign
     4364       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
     4365       .
     4366   end.
     4367   end .
     4368   procedure grplib-get-node-from-full-name :
     4369   define input parameter p-full-name as character no-undo .
     4370   define output parameter p-node-code as integer no-undo .
     4371   define variable v-ii as integer no-undo .
     4372   define variable v-upper-code as integer no-undo .
     4373   define variable v-root-code as integer no-undo .
     4374   define variable v-entry as character no-undo .
     4375   define buffer buf_gds-grp       for ub.gds-grp.
     4376   do
     4377   on error undo, return error
     4378   :
     4379     find first buf_gds-grp no-lock
     4380         where buf_gds-grp.upper-code = 0
     4381     no-error .
     4382     if not available buf_gds-grp
     4383     then do:
     4384         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
     4385     end.
     4386     else do:
     4387       assign
     4388       v-root-code = buf_gds-grp.node-code
     4389       .
     4390     end.
     4391     v-upper-code = v-root-code.
     4392     do v-ii = 1 to num-entries(p-full-name, chr(47)):
     4393       assign
     4394       v-entry = entry(v-ii, p-full-name, chr(47)).
     4395       if v-entry = '' then leave.
     4396       find first buf_gds-grp no-lock where
     4397                 buf_gds-grp.node-name = v-entry
     4398             and buf_gds-grp.upper-code = v-upper-code
     4399             no-error.
     4400       if not available buf_gds-grp then do:
     4401         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
     4402       end.
     4403       else do:
     4404         p-node-code = buf_gds-grp.node-code.
     4405         v-upper-code = buf_gds-grp.node-code.
     4406       end.
     4407     end.
     4408   end.
     4409   end .
     4410     define variable g#gds-engl as logical   no-undo .
