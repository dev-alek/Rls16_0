     1664           end.
     1665           if lookup( p-form-name, v-outnum  ) <> 0
     1666           then do:
     1667               assign
     1668                   v-torgconf-outnum   = yes
     1669               .
     1670           end.
     1671           if lookup( p-form-name, v-outprim ) <> 0
     1672           then do:
     1673               assign
     1674                   v-torgconf-outprim  = yes
     1675               .
     1676           end.
     1677           if lookup( p-form-name, v-outdisc ) <> 0
     1678           then do:
     1679               assign
     1680                   v-torgconf-outdisc  = yes
     1681               .
     1682           end.
     1683           if lookup( p-form-name, v-outsubs ) <> 0
     1684           then do:
     1685               assign
     1686                   v-torgconf-outsubs  = yes
     1687               .
     1688           end.
     1689           if lookup( p-form-name, v-outrecv ) <> 0
     1690           then do:
     1691               assign
     1692                   v-torgconf-outrecv  = yes
     1693               .
     1694           end.
     1695           if lookup( p-form-name, v-outegrp ) <> 0
     1696           then do:
     1697               assign
     1698                   v-torgconf-outegrp  = yes
     1699               .
     1700           end.
     1701           if lookup( p-form-name, v-outt12  ) <> 0
     1702           then do:
     1703               assign
     1704                   v-torgconf-outt12   = yes
     1705               .
     1706           end.
     1707           if lookup( p-form-name, v-outappr  ) <> 0
     1708           then do:
     1709               assign
     1710                   v-torgconf-outappr   = yes
     1711               .
     1712           end.
     1713           if lookup( p-form-name, v-outrubl  ) <> 0
     1714           then do:
     1715               assign
     1716                   v-torgconf-outrubl   = yes
     1717               .
     1718           end.
     1719           if lookup( p-form-name, v-outhold  ) <> 0
     1720           then do:
     1721               assign
     1722                   v-torgconf-outhold   = yes
     1723               .
     1724           end.
     1725           if lookup( p-form-name, v-outobj   ) <> 0
     1726           then do:
     1727               assign
     1728                   v-torgconf-outobj    = yes
     1729               .
     1730           end.
     1731           if lookup( p-form-name, v-outsend   ) <> 0
     1732           then do:
     1733               assign
     1734                   v-torgconf-outsend    = yes
     1735               .
     1736           end.
     1737           if lookup( p-form-name, v-outasend   ) <> 0
     1738           then do:
     1739               assign
     1740                   v-torgconf-outasend    = yes
     1741               .
     1742           end.
