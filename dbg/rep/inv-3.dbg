     3498                               v-torgconf-doc-code = entry( 1, p-doc-code, "=":U )
     3499                           no-error.
     3500                       end.
     3501                       else do:
     3502                           assign
     3503                               v-torgconf-doc-code = entry( 1, p-doc-code, "-":U )
     3504                           no-error.
     3505                       end.
     3506                       define variable v-doc-code-integer    as integer      no-undo.
     3507                       assign
     3508                           v-doc-code-integer = integer( v-torgconf-doc-code )
     3509                       no-error.
     3510                       if error-status :error
     3511                       then do:
     3512                           assign
     3513                               v-doc-code-integer = 0
     3514                           .
     3515                       end.
     3516                       if v-torgconf-doc-code = ""
     3517                       then do:
     3518                           assign v-torgconf-doc-code = substr( p-doc-code, 1, 2 )
     3519                                               + string( month( p-doc-date ),  "99" )
     3520                                               + string( day( p-doc-date ),    "99" )
     3521                           .
     3522                       end.
     3523                       else do:
     3524                           assign v-torgconf-doc-code = string( month( p-doc-date ), ">9" )
     3525                                               + trim( string( day( p-doc-date ), ">9" ) )
     3526                                               + string( v-doc-code-integer )
     3527                           .
     3528                       end.
     3529                   end.
     3530                   else do:
     3531                       assign
     3532                           v-torgconf-doc-code = p-doc-code
     3533                       .
     3534                   end.
     3535               end.
     3536           end.
     3537       end.
     3538       if v-torgconf-outnum = yes
     3539       then do:
     3540           assign
     3541               v-torgconf-vdoc-code = " "
     3542           .
     3543       end.
     3544       else do:
     3545         assign
     3546            v-torgconf-vdoc-code = p-doc-code
     3547         .
     3548         if p-doc-type = 'при':U
     3549         then do:
     3550            run gbl/trdcat-v.p (
     3551                       input p-doc-code
     3552                     , input 'nids':U
     3553                     , output v-doc-code-attr
     3554                     , output v-attr-type
     3555                  ).
     3556         end.
     3557         if  p-doc-type =  'рас':U
     3558         or  p-doc-type =  'возврат':U
     3559         then do:
     3560            run gbl/trdcat-v.p (
     3561                       input p-doc-code
     3562                     , input 'print-num':U
     3563                     , output v-doc-code-attr
     3564                     , output v-attr-type
     3565                  ).
     3566         end.
     3567         if trim(v-doc-code-attr) <> ""
     3568         then do:
     3569            assign
     3570               v-torgconf-vdoc-code = v-doc-code-attr
     3571            .
     3572         end.
