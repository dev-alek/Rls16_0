     3578            v-torgconf-vdoc-date = "          "
     3579           .
     3580       end.
     3581       else do:
     3582           if lookup( v-torgconf-ext-doc-type, 'ie,ee,ii,ei,ij,ej,fj,jj,pj,oj,we,ci,ce,iy,rj,ip,ep,rp,ff,ef,rf,pc,ps,pz,df,dp,dc,de,xc':u ) <> 0
     3583           then do:
     3584               run gbl/wthat-v.p (
     3585                     input p-doc-code
     3586                   , input 'wthdsf':U
     3587                   , output v-torgconf-doc-date
     3588                   , output v-attr-type
     3589               ).
     3590               assign
     3591                   v-doc-date-standard = ( trim( v-torgconf-doc-date ) = "":U )
     3592               .
     3593           end.
     3594           else do:
     3595               assign
     3596                   v-doc-date-standard = yes
     3597               .
     3598           end.
     3599           if v-doc-date-standard = yes
     3600           then do:
     3601               assign v-torgconf-doc-date =  ( if p-status_ <> 'факт':U
     3602                                               or p-print-doc = yes
     3603                                               then string( p-doc-date, "99/99/9999" )
     3604                                               else string( p-fact-date, "99/99/9999" )
     3605                                           )
     3606               .
     3607           end.
     3608           assign v-torgconf-vdoc-date = ( if p-status_ <> 'факт':U
     3609                                             then string( p-doc-date, "99/99/9999" )
     3610                                             else string( p-fact-date, "99/99/9999" )
     3611                                         )
     3612           .
     3613           if p-doc-type = 'при':U
     3614              then do:
     3615                 run gbl/trdcat-v.p (
     3616                     input p-doc-code
     3617                   , input 'dids':U
     3618                   , output v-torgconf-doc-date-attr
     3619                   , output v-attr-type
     3620                ).
     3621              end.
     3622           if trim(v-torgconf-doc-date-attr) <> ""
