     1556           v-torgconf-outprim  = no
     1557           v-torgconf-outdisc  = no
     1558           v-torgconf-outsubs  = no
     1559           v-torgconf-outrecv  = no
     1560           v-torgconf-outegrp  = no
     1561           v-torgconf-outt12   = no
     1562           v-torgconf-outappr  = no
     1563           v-torgconf-outrubl  = no
     1564           v-torgconf-outhold  = no
     1565           v-torgconf-outobj   = no
     1566           v-torgconf-outexlst = no
     1567           v-torgconf-outexpas = "":U
     1568           v-torgconf-outprncd = yes
     1569           v-torgconf-outares  = no
     1570           v-torgconf-outsend  = no
     1571           v-torgconf-outasend  = no
     1572           v-torgconf-outprops  = no
     1573           v-form-name          = p-form-name
     1574       .
     1575   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1576   empty temp-table thbjattr_thbj-attr.
     1577   run adm/shattri.p (
     1578      input "get":U
     1579     ,input ''
     1580     ,input 0
     1581     ,input 'prt-glob':U
     1582     ,input  ""
     1583     ,output v-value-character
     1584     ,output v-value-date
     1585     ,output v-value-decimal
     1586     ,output v-value-integer
     1587     ,output v-value-logical
     1588     ,output par-type
