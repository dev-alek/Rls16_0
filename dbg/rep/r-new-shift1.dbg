     1932       and ub.rvs-doc.status_    = 'факт':U
     1933       and ub.rvs-doc.rvs-type   = 'смена':U
     1934   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1935   :
     1936     if ub.rvs-doc.shift-date = x-date-Start and ub.rvs-doc.shift-num < x-Shift-Start then next .
     1937     if ub.rvs-doc.shift-date = x-date-End   and ub.rvs-doc.shift-num > x-Shift-End then next .
     1938     for each ub.rvs-line no-lock
     1939       where ub.rvs-line.rvs-code = ub.rvs-doc.rvs-code
     1940     on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1941     :
     1942       find first temp-rvs-line
     1943         where temp-rvs-line.pl-code  = ub.rvs-line.pl-code
     1944           and temp-rvs-line.gds-code = ub.rvs-line.gds-code
     1945         no-error .
     1946       if not available temp-rvs-line then do:
     1947         create temp-rvs-line .
     1948         buffer-copy ub.rvs-line to temp-rvs-line .
     1949         find first ub.goods no-lock
     1950           where ub.goods.gds-code = ub.rvs-line.gds-code
     1951           no-error.
     1952         assign
     1953           temp-rvs-line.gds-name   = ub.goods.gds-name
     1954           temp-rvs-line.artic      = ub.goods.artic
     1955           temp-rvs-line.prod-type  = ub.goods.prod-type
     1956           temp-rvs-line.prod-code  = ub.goods.prod-code
     1957           temp-rvs-line.shift-date = ub.rvs-doc.shift-date
     1958           temp-rvs-line.shift-num  = ub.rvs-doc.shift-num
     1959         .
     1960   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     1961     (input  ub.goods.gds-code
     1962     ,input  ?
     1963     ,output temp-rvs-line.v-bar-code
     1964     )  .
     1965         find first ub.place no-lock
     1966           where ub.place.obj-code = p-obj-code
     1967             and ub.place.obj-type = p-obj-type
     1968             and ub.place.pl-code  = ub.rvs-line.pl-code
     1969           no-error.
