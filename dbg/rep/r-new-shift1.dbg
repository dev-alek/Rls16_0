     2538         and temp-line-pump.pl-code = temp-rvs-line.pl-code :
     2539           assign
     2540               temp-rvs-line.pol8-l = (temp-line-pump.pol6 - temp-line-pump.pol7)
     2541               temp-rvs-line.pol8-kg = temp-rvs-line.pol8-l * temp-rvs-line.state-density
     2542           .
     2543           if v-first then
     2544           do:
     2545             output stream OutStr-html to value(v-report-name-html) append convert target 'UTF-8' .
     2546             put stream OutStr-html unformatted
     2547               substitute (
     2548               '
     2549                   <tr> <!-- Затем идёт наполнение таблицы -->
     2550                   <td rowspan="&1" style="text-align: center;">&2</td>
     2551                   <td rowspan="&1" style="text-align: center;"></td>
     2552                   <td rowspan="&1" ></td>
     2553                   <td style="text-align: center;">&3</td>
     2554                   <td style="text-align: right;">&4</td>
     2555                   <td style="text-align: right;">&5</td>
     2556                   <td style="text-align: right;">&6</td>
     2557                   <td rowspan="&1" style="text-align: center;">&7</td>
     2558                   <td rowspan="&1" ></td>
     2559                   <td rowspan="&1" ></td>
     2560                   <td rowspan="&1" ></td>
     2561                   <td rowspan="&1" ></td>
     2562                   <td rowspan="&1" ></td>
     2563                   <td rowspan="&1" ></td>
     2564                   <td rowspan="&1" ></td>
     2565                   <td rowspan="&1" ></td>
     2566                   <td rowspan="&1" ></td>
     2567                   <td rowspan="&1" ></td>
     2568                   <td rowspan="&1" ></td>
     2569                   <td rowspan="&1" ></td>
     2570                   <td rowspan="&1" ></td>
     2571                   </tr>'
     2572               ,
     2573               temp-rvs-line.num-trk,
     2574               string(temp-rvs-line.gds-name) + ' код:' + string(temp-rvs-line.gds-code),
     2575               string(temp-line-pump.pump-code) + ',' + string(temp-line-pump.nozzle-code),
     2576               string(temp-line-pump.pol6,"->>>>>>>>>>>9.99"),
     2577               string(temp-line-pump.pol7,"->>>>>>>>>>>9.99"),
     2578               string(temp-rvs-line.pol8-l,"->>>>>>>>>>>9.99"),
     2579               temp-rvs-line.place_loc1
     2580               ).
     2581             output stream OutStr-html close.
     2582           end.
     2583           else
     2584           do:
     2585             output stream OutStr-html to value(v-report-name-html) append convert target 'UTF-8' .
     2586             put stream OutStr-html unformatted
     2587               substitute ('
     2588               <tr> 
     2589                   <td style="text-align: center;">&1</td>
     2590                   <td style="text-align: right;">&2</td>
     2591                   <td style="text-align: right;">&3</td>
     2592                   <td style="text-align: right;">&4</td>
     2593               </tr>
     2594               '
     2595               ,
     2596               string(temp-line-pump.pump-code) + ',' + string(temp-line-pump.nozzle-code),
     2597               string(temp-line-pump.pol6,"->>>>>>>>>>>9.99"),
     2598               string(temp-line-pump.pol7,"->>>>>>>>>>>9.99"),
     2599               string(temp-rvs-line.pol8-l,"->>>>>>>>>>>9.99")
     2600               ).
     2601             output stream OutStr-html close.
     2602           end.
     2603             assign
     2604                   num-pol8-l  = temp-rvs-line.pol8-l + num-pol8-l
     2605                   num-pol8-kg = temp-rvs-line.pol8-kg + num-pol8-kg
     2606                   temp-rvs-line.accum-pol8-l   = num-pol8-l
     2607                   temp-rvs-line.accum-pol8-kg  = num-pol8-kg
     2608                   num-pol20-l = temp-line-pump.error-l + num-pol20-l
     2609                   num-pol20-kg = temp-line-pump.error-kg + num-pol20-kg
     2610                   temp-rvs-line.accum-pol20-l = num-pol20-l
     2611                   temp-rvs-line.accum-pol20-kg = num-pol20-kg
     2612                   v-first     = no
     2613             .
     2614           end.
     2615           end.
     2616           if temp-rvs-line.num-trk = 0 then do:
     2617                       output stream OutStr-html to value(v-report-name-html) append convert target 'UTF-8' .
     2618             put stream OutStr-html unformatted
     2619               substitute (
     2620               '
     2621                   <tr> <!-- Затем идёт наполнение таблицы -->
     2622                   <td style="text-align: center;">&1</td>
     2623                   <td style="text-align: center;"></td>
     2624                   <td ></td>
     2625                   <td style="text-align: center;"></td>
     2626                   <td style="text-align: right;"></td>
     2627                   <td style="text-align: right;"></td>
     2628                   <td style="text-align: right;"></td>
     2629                   <td style="text-align: center;">&2</td>
     2630                   <td ></td>
     2631                   <td ></td>
     2632                   <td ></td>
     2633                   <td ></td>
     2634                   <td ></td>
     2635                   <td ></td>
     2636                   <td ></td>
     2637                   <td ></td>
     2638                   <td ></td>
     2639                   <td ></td>
     2640                   <td ></td>
     2641                   <td ></td>
     2642                   <td ></td>
     2643                   </tr>'
     2644               ,
     2645               string(temp-rvs-line.gds-name) + ' код:' + string(temp-rvs-line.gds-code),
     2646               temp-rvs-line.place_loc1
     2647               ).
     2648             output stream OutStr-html close.
     2649             end.
     2650         output stream OutStr-html to value(v-report-name-html) append convert target 'UTF-8' .
     2651         put stream OutStr-html unformatted
     2652           substitute (
     2653                  '<tr> <!-- Затем идёт наполнение таблицы -->
     2654                   <td>Всего по резервуару:</td>
     2655                   <td style="text-align: right;">&1</td>
     2656                   <td style="text-align: right;">&2</td>
     2657                   <td style="text-align: center;"></td>
     2658                   <td style="text-align: right;"></td>
     2659                   <td style="text-align: right;"></td>
     2660                   <td style="text-align: right;">&3</td>
     2661                   <td style="text-align: center;">&4</td>
     2662                   <td style="text-align: right;">&5</td>
     2663                   <td style="text-align: right;">&6</td>
     2664                   <td style="text-align: right;">&7</td>
     2665                   <td style="text-align: right;">&8</td>
     2666                   <td style="text-align: right;">&9</td>'
     2667           ,
     2668           if p-weight = true then string(temp-rvs-line.pol2-kg-system,"->>>>>>>>>>>9.99") else string(temp-rvs-line.pol2-l-system,"->>>>>>>>>>>9.99"),
     2669           if p-weight = true then string(temp-rvs-line.accum-by-pl-code-pol3-kg,"->>>>>>>>>>>9.99") else string(temp-rvs-line.accum-by-pl-code-pol3-l,"->>>>>>>>>>>9.99"),
     2670           string(temp-rvs-line.accum-pol8-l,"->>>>>>>>>>>9.99"),
     2671           temp-rvs-line.place_loc1,
     2672           string(temp-rvs-line.state-level-total,"->>>>>>>>>>>9"),
     2673           string(temp-rvs-line.state-level-water,"->>>>>>>>>>>9"),
     2674           string(temp-rvs-line.state-brutto-qnty,"->>>>>>>>>>>9"),
     2675           string(temp-rvs-line.state-brutto-qnty - temp-rvs-line.state-measure-qnty,"->>>>>>>>>>>9"),
     2676           string(temp-rvs-line.state-add-qnty,"->>>>>>>>>>>9")
     2677           ).
     2678         output stream OutStr-html close.
     2679         output stream OutStr-html to value(v-report-name-html) append convert target 'UTF-8' .
     2680         put stream OutStr-html unformatted
     2681           substitute ('
     2682                   <td style="text-align: right;">&1</td>
     2683                   <td style="text-align: right;">&2</td>
     2684                   <td style="text-align: right;">&3</td>
     2685                   <td style="text-align: right;">&4</td>
     2686                   <td style="text-align: right;">&5</td>
     2687                   <td style="text-align: right;">&6</td>
     2688                   <td style="text-align: right;">&7</td>
     2689                   <td style="text-align: right;">&8</td>
     2690                   </tr>
     2691                     '
     2692           ,
     2693           string(temp-rvs-line.state-measure-qnty,"->>>>>>>>>>>9"),
     2694           string(temp-rvs-line.state-measure-qnty + temp-rvs-line.state-add-qnty,"->>>>>>>>>>>9"),
     2695           string(temp-rvs-line.state-measure-cli-qnty + temp-rvs-line.state-add-qnty * temp-rvs-line.state-density,"->>>>>>>>>>>9"),
     2696           string(temp-rvs-line.pol14,"->>>>>>>>>>>9.9999"),
     2697           string(temp-rvs-line.state-temperature,"->>>>>>>>>>>9"),
     2698           if p-weight = true then string(temp-rvs-line.pol16-kg,"->>>>>>>>>>>9.99") else string(temp-rvs-line.pol16-l,"->>>>>>>>>>>9.99"),
     2699           if p-weight = true then string(temp-rvs-line.pol17-kg,"->>>>>>>>>>>9.99") else string(temp-rvs-line.pol17-l,"->>>>>>>>>>>9.99"),
     2700           if p-weight = true then string(temp-rvs-line.pol18-kg,"->>>>>>>>>>>9.99") else string(temp-rvs-line.pol18-l,"->>>>>>>>>>>9.99")
     2701           ).
     2702         output stream OutStr-html close.
     2703              assign
     2704               num-pol8-l = 0
     2705               num-pol8-kg = 0
     2706               .
     2707       end.
     2708        output stream OutStr-html to value(v-report-name-html) append convert target 'UTF-8' .
     2709        put stream OutStr-html unformatted
     2710           substitute (
     2711           '
     2712           </tbody>
     2713           '
     2714               , chr(123), chr(125)
     2715          ).
     2716         output stream OutStr-html close.
