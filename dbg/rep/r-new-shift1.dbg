     1770                                                     ,input v-report-name-html
     1771                                                     ,input ?
     1772                                                     ,input '3':U
     1773                                                     ,input substitute("&1 &2 &3&4Не найдена сменная сверка&4объект &5&6 смена &7 &8"                                 ,vss-workfile                                 ,vss-revision                                 ,vss-description                                ,chr(10)                                ,p-obj-type                                 ,p-obj-code                                 ,string(x-date-End, "99/99/9999")                                ,x-shift-end )).
     1774     end.
     1775     return error.
     1776   END.
     1777   if available previous-shift-obj then do:
