      909     :
      910           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-tooltip in g#attr-lib
      911         (input  p-code
      912         ,output p-tooltip
      913         ,output p-label
      914         ) no-error .
      915       if error-status :error
      916       then do:
      917         undo, return error return-value .
      918       end.
      919     end.
      920   end procedure.
