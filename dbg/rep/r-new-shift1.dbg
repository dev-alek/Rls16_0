     2007         else i-rvs-code = previous-rvs-doc.rvs-code.
     2008         find first previous-rvs-line where previous-rvs-line.rvs-code = i-rvs-code
     2009                                        and previous-rvs-line.gds-code = temp-rvs-line.gds-code
     2010                                        and previous-rvs-line.obj-code = temp-rvs-line.obj-code
     2011                                        and previous-rvs-line.obj-type = temp-rvs-line.obj-type
     2012                                        and previous-rvs-line.pl-code = temp-rvs-line.pl-code no-lock no-error.
