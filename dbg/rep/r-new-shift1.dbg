     1979                 and temp-rvs-line.shift-num  < ub.rvs-doc.shift-num
     1980               )
     1981         then do:
     1982           buffer-copy ub.rvs-line to temp-rvs-line .
     1983         end.
     1984       end.
     1985     end.
