     1589     procedure on-same-page :
     1590       define input parameter p-line-number as integer no-undo .
     1591       if p-line-number > page-size( PrnLibstream )
     1592       then do:
     1593         return .
     1594       end.
     1595       if line-counter( PrnLibstream ) + p-line-number > page-size( PrnLibstream )
     1596       then do:
     1597         page stream PrnLibstream .
     1598       end.
     1599     end procedure.
