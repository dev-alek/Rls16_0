     1993                                      and buf_rvs-line-attr.obj-type = temp-rvs-line.obj-type
     1994                                      and buf_rvs-line-attr.gds-code = temp-rvs-line.gds-code
     1995                                      and buf_rvs-line-attr.pl-code = temp-rvs-line.pl-code
     1996                                      and buf_rvs-line-attr.rvs-code = temp-rvs-line.rvs-code
     1997                                      and buf_rvs-line-attr.attr-code = "mask" no-lock no-error.
     1998         if not available previous-rvs-doc then do:
     1999             find first buf_control-rvs-doc where buf_control-rvs-doc.obj-type = temp-rvs-line.obj-type
     2000                                              and buf_control-rvs-doc.obj-code = temp-rvs-line.obj-code
     2001                                              and buf_control-rvs-doc.shift-date = temp-rvs-line.shift-date
     2002                                              and buf_control-rvs-doc.shift-num = temp-rvs-line.shift-num
