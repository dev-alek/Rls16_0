      138   procedure create_obj-list :
      139      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      140      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      141      do
      142      on error undo, return error return-value
      143      :
      144         define buffer cli-obj for ub.clients .
      145         define variable p-var as integer no-undo .
      146         define buffer buf_obj-list for obj-list .
      147         find last buf_obj-list  use-index pi no-error .
      148         if available buf_obj-list
      149         then
      150            p-var = buf_obj-list.obj-id + 1.
      151         else
      152            p-var = 1.
      153         find first cli-obj where
      154                   cli-obj.obj-type = p-obj-type
      155               and cli-obj.obj-code = p-obj-code
      156         no-lock no-error.
      157         if available cli-obj
      158         then do:
      159            create buf_obj-list.
      160            assign
      161               buf_obj-list.obj-id   = p-var
      162               buf_obj-list.obj-code = cli-obj.obj-code
      163               buf_obj-list.obj-type = cli-obj.obj-type
      164               buf_obj-list.obj-name = cli-obj.obj-name
      165               buf_obj-list.db-num   = cli-obj.db-num
      166            .
      167         end.
      168      end.
      169   end.
