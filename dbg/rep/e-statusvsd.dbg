     1988   PROCEDURE check-modified :
     1989   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
     1990   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
     1991   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
     1992   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
     1993     IF check-state = "check":U THEN
     1994     DO:
     1995       RUN get-link-handle IN adm-broker-hdl
     1996         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
     1997            OUTPUT group-target-list).
     1998       IF group-target-list NE "":U THEN
     1999       DO i = 1 TO NUM-ENTRIES(group-target-list):
     2000         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
     2001         RUN check-modified IN curr-widget ('group-check':U).
     2002         IF RETURN-VALUE NE "":U THEN
     2003         DO:
     2004           RUN check-modified-message(RETURN-VALUE).
     2005           RETURN "":U.
     2006         END.
     2007       END.
     2008     END.
     2009     RETURN "":U.
     2010   END PROCEDURE.
     2011   PROCEDURE check-modified-message :
     2012     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
     2013        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
     2014           'CONTAINER-SOURCE':U, 'HIDDEN':U).
     2015        IF RETURN-VALUE = "YES":U THEN
     2016           RUN notify ('view,CONTAINER-SOURCE':U).
     2017        MESSAGE IF p-changed-table NE ? THEN
     2018           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
     2019           ELSE "Current values have been changed."
     2020           SKIP "  Do you wish to save those changes?"
     2021           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
     2022        IF ANS THEN
     2023        DO:
     2024           IF group-assign-target THEN
     2025             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
     2026           ELSE RUN dispatch('update-record':U).
     2027           IF RETURN-VALUE = "ADM-ERROR":U THEN
     2028           DO:
     2029               MESSAGE "Changes to the previous record were not saved."
     2030                 VIEW-AS ALERT-BOX ERROR.
     2031               IF group-assign-target THEN
     2032                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     2033               ELSE RUN dispatch ('cancel-record':U).
     2034           END.
     2035        END.
     2036        ELSE DO:
     2037          IF group-assign-target THEN
     2038             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     2039          ELSE RUN dispatch('cancel-record':U).
     2040        END.
     2041        RETURN.
     2042   END PROCEDURE.
     2043   PROCEDURE get-rowid :
     2044       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
     2045       ASSIGN
     2046       p-table   =   adm-first-table.
     2047       RETURN.
     2048   END PROCEDURE.
     2049   PROCEDURE init-group-assign :
     2050       RUN request-attribute IN adm-broker-hdl
     2051         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
     2052       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
     2053         group-assign-target = yes.
     2054       ELSE group-assign-target = no.
     2055       RETURN.
     2056   END PROCEDURE.
     2057   PROCEDURE set-editors :
     2058       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
     2059       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
     2060       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
     2061       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
     2062       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
     2063       DO WHILE VALID-HANDLE (curr-widget):
     2064           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
     2065              curr-widget:HIDDEN = no THEN DO:
     2066             CASE p-field-setting:
     2067               WHEN "INITIALIZE":U THEN
     2068               DO:
     2069                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
     2070                     read-only-list +
     2071                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
     2072                        STRING(curr-widget).
     2073               END.
     2074               WHEN "DISABLE":U OR
     2075               WHEN "ENABLE":U THEN
     2076               DO:
     2077                   curr-widget:SENSITIVE = yes.
     2078                   RUN get-attribute ('Read-Only-Editors':U).
     2079                   IF RETURN-VALUE = ? OR
     2080                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
     2081                       curr-widget:READ-ONLY =
     2082                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
     2083               END.
     2084               WHEN "CLEAR":U THEN
     2085                   curr-widget:SCREEN-VALUE = "":U.
     2086             END CASE.
     2087           END.
     2088           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
     2089       END.
     2090       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
     2091         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
     2092           + '"':U).
     2093       RETURN.
     2094   END PROCEDURE.
     2095   PROCEDURE use-check-modified-all :
     2096    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     2097     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
     2098     RETURN.
     2099   END PROCEDURE.
     2100   PROCEDURE use-create-on-add :
     2101   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     2102      RETURN.
     2103   END PROCEDURE.
     2104   PROCEDURE use-initial-lock :
     2105     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     2106     ASSIGN adm-initial-lock = p-attr-value.
     2107     RETURN.
     2108   END PROCEDURE.
     2109     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
     2110   ASSIGN
     2111          FRAME F-Main:SCROLLABLE       = FALSE
     2112          FRAME F-Main:HIDDEN           = TRUE.
     2113   ASSIGN
     2114          vFalRegis:HIDDEN IN FRAME F-Main           = TRUE.
     2115   ASSIGN
     2116          vRegis:HIDDEN IN FRAME F-Main           = TRUE.
     2117   ASSIGN
     2118          vToRegi:HIDDEN IN FRAME F-Main           = TRUE.
     2119   PROCEDURE disable_UI :
     2120     HIDE FRAME F-Main.
     2121     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     2122   END PROCEDURE.
     2123   PROCEDURE local-initialize :
     2124       RUN dispatch IN THIS-PROCEDURE ( INPUT 'initialize':U ) .
     2125       DO WITH FRAME F-Main:
     2126           ASSIGN
     2127               vTime       :SCREEN-VALUE = "0"
     2128               vReqVerif   :SCREEN-VALUE = "yes"
     2129               vFalVerif   :SCREEN-VALUE = "yes"
     2130               vToExtin    :SCREEN-VALUE = "yes"
     2131               vFalExting  :SCREEN-VALUE = "yes"
     2132               vRep        :SCREEN-VALUE = "yes"
     2133               vSent       :SCREEN-VALUE = "yes"
     2134               .
     2135       END.
     2136   END PROCEDURE.
     2137   PROCEDURE my-report :
     2138   DO WITH FRAME F-Main:
     2139      ASSIGN
     2140         vTime
     2141         vReqVerif
     2142         vFalVerif
     2143         vToExtin
     2144         vFalExting
     2145         vRep
     2146         vSent
     2147      .
     2148      END.
     2149      DEFINE VARIABLE vStatus AS CHARACTER NO-UNDO.
     2150       IF vReqVerif THEN
     2151           vStatus = vStatus + ",0".
     2152       IF vFalVerif THEN
     2153           vStatus = vStatus + ",1".
     2154       IF vToExtin THEN
     2155           vStatus = vStatus + ",2".
     2156       IF vFalExting THEN
     2157           vStatus = vStatus + ",3".
     2158       IF vRep THEN
     2159           vStatus = vStatus + ",4".
     2160       IF vSent THEN
     2161           vStatus = vStatus + ",5".
     2162       vStatus =SUBSTRING(vStatus,2).
     2163      RUN rep/r-statusvsd.p( my-handle,vTime,vStatus).
     2164   END PROCEDURE.
     2165   PROCEDURE My-var :
     2166   ASSIGN
     2167       ReportHeader = "Отчет для получения информации по статусу ВСД".
     2168   END PROCEDURE.
