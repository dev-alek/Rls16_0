     1022   procedure uf-get :
     1023     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
     1024     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
     1025     define output parameter p-List_        like ubflt.usr-flt.List_        no-undo .
     1026     define output parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
     1027     define output parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
     1028     define output parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
     1029     define output parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
     1030     define output parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
     1031     do
     1032     on error undo, return error
     1033     :
     1034       define buffer buf_usr-flt for ubflt.usr-flt .
     1035       define variable v-use-List_     as logical   no-undo .
     1036       define variable v-type-List_     as character no-undo .
     1037       define variable v-format-List_   as character no-undo .
     1038       define variable v-use-Naim      as logical   no-undo .
     1039       define variable v-type-Naim      as character no-undo .
     1040       define variable v-format-Naim    as character no-undo .
     1041       define variable v-use-print-graft as logical   no-undo .
     1042       define variable v-use-sort-gr     as logical   no-undo .
     1043       define variable v-use-type-price  as logical   no-undo .
     1044       define variable v-use-type-val    as logical   no-undo .
     1045       define variable v-label          as character no-undo .
     1046       define variable v-tooltip        as character no-undo .
     1047       define variable v-user-can-edit  as logical   no-undo .
     1048       define variable v-output-display as logical   no-undo .
     1049       define variable v-other          as character no-undo .
     1050       run uf-name in this-procedure
     1051          (input  entry(1, p-code, chr(4))
     1052         ,output v-use-List_
     1053         ,output v-type-List_
     1054         ,output v-format-List_
     1055         ,output v-use-Naim
     1056         ,output v-type-Naim
     1057         ,output v-format-Naim
     1058         ,output v-use-print-graft
     1059         ,output v-use-sort-gr
     1060         ,output v-use-type-price
     1061         ,output v-use-type-val
     1062         ,output v-label
     1063         ,output v-tooltip
     1064         ,output v-user-can-edit
     1065         ,output v-output-display
     1066         ,output v-other
     1067         ) no-error .
     1068       if error-status :error then do:
     1069         undo, return error return-value .
     1070       end.
     1071       find first buf_usr-flt no-lock where
     1072                  buf_usr-flt.Call-point     = p-code AND
     1073                  buf_usr-flt.user-name       = p-user-name
     1074         no-error .
     1075       if avail buf_usr-flt then do:
     1076         assign
     1077         p-List_        = (if v-use-List_       then buf_usr-flt.List_       else ?)
     1078         p-Naim         = (if v-use-Naim        then buf_usr-flt.Naim        else ?)
     1079         p-print-graft  = (if v-use-print-graft then buf_usr-flt.print-graft else ?)
     1080         p-sort-gr      = (if v-use-sort-gr     then buf_usr-flt.sort-gr     else ?)
     1081         p-type-price   = (if v-use-type-price  then buf_usr-flt.type-price  else ?)
     1082         p-type-val     = (if v-use-List_       then buf_usr-flt.type-val    else ?)
     1083         .
     1084       end.
     1085       else do:
     1086         assign
     1087         p-List_        = (if v-use-List_       then "":U                    else ?)
     1088         p-Naim         = (if v-use-Naim        then "":U                    else ?)
     1089         p-print-graft  = (if v-use-print-graft then no                      else ?)
     1090         p-sort-gr      = (if v-use-sort-gr     then no                      else ?)
     1091         p-type-price   = (if v-use-type-price  then no                      else ?)
     1092         p-type-val     = (if v-use-List_       then no                      else ?)
     1093         .
     1094       end.
     1095     end.
     1096   end procedure.
     1097   procedure uf-set :
     1098     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
     1099     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
     1100     define input  parameter p-List_        like ubflt.usr-flt.List_        no-undo .
     1101     define input  parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
     1102     define input  parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
     1103     define input  parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
     1104     define input  parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
     1105     define input  parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
     1106     do
     1107     on error undo, return error
     1108     :
     1109       define buffer buf_usr-flt for ubflt.usr-flt .
     1110       define variable v-use-List_     as logical   no-undo .
     1111       define variable v-type-List_     as character no-undo .
     1112       define variable v-format-List_   as character no-undo .
     1113       define variable v-use-Naim      as logical   no-undo .
     1114       define variable v-type-Naim      as character no-undo .
     1115       define variable v-format-Naim    as character no-undo .
     1116       define variable v-use-print-graft as logical   no-undo .
     1117       define variable v-use-sort-gr   as logical   no-undo .
     1118       define variable v-use-type-price as logical   no-undo .
     1119       define variable v-use-type-val  as logical   no-undo .
     1120       define variable v-tooltip        as character no-undo .
     1121       define variable v-label          as character no-undo .
     1122       define variable v-user-can-edit  as logical   no-undo .
     1123       define variable v-output-display as logical   no-undo .
     1124       define variable v-other          as character no-undo .
     1125       run uf-name in this-procedure
     1126         (input  entry(1, p-code, chr(4))
     1127         ,output v-use-List_
     1128         ,output v-type-List_
     1129         ,output v-format-List_
     1130         ,output v-use-Naim
     1131         ,output v-type-Naim
     1132         ,output v-format-Naim
     1133         ,output v-use-print-graft
     1134         ,output v-use-sort-gr
     1135         ,output v-use-type-price
     1136         ,output v-use-type-val
     1137         ,output v-label
     1138         ,output v-tooltip
     1139         ,output v-user-can-edit
     1140         ,output v-output-display
     1141         ,output v-other
     1142         ) no-error .
     1143       if error-status :error then do:
     1144         undo, return error return-value .
     1145       end.
     1146       find first buf_usr-flt where
     1147                  buf_usr-flt.Call-point     = p-code AND
     1148                  buf_usr-flt.user-name       = p-user-name
     1149         no-error .
     1150       if not avail buf_usr-flt then do:
     1151           create buf_usr-flt .
     1152           assign
     1153           buf_usr-flt.call-point = p-code
     1154           buf_usr-flt.user-name  = p-user-name
     1155           .
     1156       end.
     1157       if avail buf_usr-flt then do:
     1158        assign
     1159        buf_usr-flt.List_       =  (if v-use-List_       then  p-List_        else ?)
     1160        buf_usr-flt.Naim        =  (if v-use-Naim        then  p-Naim         else ?)
     1161        buf_usr-flt.print-graft =  (if v-use-print-graft then  p-print-graft  else ?)
     1162        buf_usr-flt.sort-gr     =  (if v-use-sort-gr     then  p-sort-gr      else ?)
     1163        buf_usr-flt.type-price  =  (if v-use-type-price  then  p-type-price   else ?)
     1164        buf_usr-flt.type-val    =  (if v-use-List_       then  p-type-val     else ?)
     1165       .
     1166       release buf_usr-flt.
     1167       end.
     1168       else undo, return error ("Ошибка при записи usr-flt" + substitute(" call-point=&1, user-name=&2", p-code, p-user-name)).
     1169     end.
     1170   end procedure.
     1171   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1172     run mainmenu_getcntxt in my-handle
     1173       (output v-cntxt-db-num
     1174       ,output v-cntxt-userid
     1175       ,output v-cntxt-level
     1176       ,output v-cntxt-host-code-obj
     1177       ,output v-cntxt-obj-type
     1178       ,output v-cntxt-obj-code
     1179       ,output v-cntxt-db-num-obj
     1180       ,output v-cntxt-is-admin
     1181       ) .
     1182   CREATE WIDGET-POOL.
     1183   def var vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1184   procedure gen-key-rec :
     1185     define input  parameter p-tbl-name    as character no-undo.
     1186     define input  parameter p-bh_tbl-name as handle    no-undo.
     1187     define output parameter p-key-rec     as character no-undo.
     1188     do
     1189     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1190     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
     1191     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
     1192     :
     1193       define variable fh               as handle    no-undo .
     1194       define variable v-ok             as logical   no-undo .
     1195       define variable v-inform         as character no-undo .
     1196       define variable v-ind            as integer   no-undo .
     1197       define variable v-idx-field-qnty as integer   no-undo .
     1198       if p-tbl-name = ?
     1199         or p-tbl-name = "":U
     1200       then do:
     1201         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info16 ).
     1202       end.
     1203       if not p-bh_tbl-name:available then do:
     1204         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info16, p-tbl-name ).
     1205       end.
     1206       assign
     1207         p-key-rec = p-tbl-name
     1208         v-inform  = p-bh_tbl-name:index-information(1)
     1209         v-ind     = 2
     1210       .
     1211       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1212       on error undo, return error
     1213       :
     1214         assign
     1215           v-inform = p-bh_tbl-name:index-information( v-ind )
     1216           v-ind    = v-ind + 1
     1217         .
     1218       end.
     1219       if v-inform = ?
     1220         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1221         or entry( 3, v-inform, ",":U ) <> "1":U
     1222       then do:
     1223         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info16, p-tbl-name ).
     1224       end.
     1225       else do:
     1226         assign
     1227           v-idx-field-qnty = num-entries( v-inform ) - 4
     1228         .
     1229         if v-idx-field-qnty < 2 then do:
     1230           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info16, v-inform, p-tbl-name ).
     1231         end.
     1232         do v-ind = 1 to v-idx-field-qnty by 2
     1233         on error undo, return error
     1234         :
     1235           assign
     1236             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
     1237             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
     1238           .
     1239         end.
     1240       end.
     1241       if p-key-rec = ? then do:
     1242         assign
     1243           p-key-rec = "":U
     1244         .
     1245         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info16, p-tbl-name ).
     1246       end.
     1247     end.
     1248     return.
     1249   end procedure.
     1250   procedure gen-where-keyr-tab :
     1251     define input  parameter i-tableSerach as character no-undo.
     1252     define input  parameter i-tablekey   as character  no-undo.
     1253     define input  parameter p-key-rec    as character  no-undo.
     1254     define input  parameter p-key-handle as handle     no-undo .
     1255     define input  parameter p-db-name    as character  no-undo .
     1256     define input  parameter p-tt-handle  as handle     no-undo .
     1257     define output parameter o-Where      as character  no-undo.
     1258     do
     1259     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1260     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1261     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
     1262     :
     1263       define variable v-full-tbl-name  as character no-undo .
     1264       define variable bh_tbl-name      as handle    no-undo .
     1265       define variable fh_key           as handle    no-undo .
     1266       define variable fh_search        as handle    no-undo .
     1267       define variable v-field-num      as integer   no-undo .
     1268       define variable v-count-fld      as integer   no-undo .
     1269       define variable v-inform         as character no-undo .
     1270       define variable v-ind            as integer   no-undo .
     1271       define variable v-idx-field-qnty as integer   no-undo .
     1272       define variable v-field-name     as character no-undo .
     1273       define variable v-field-val      as character no-undo .
     1274       define variable v-word-link      as character no-undo .
     1275       define variable vTable           as character no-undo.
     1276       define variable bh_tbl-key       as handle    no-undo .
     1277       assign
     1278         p-key-rec = trim( p-key-rec )
     1279       .
     1280       if p-key-handle <> ? then do:
     1281         if not valid-handle(p-key-handle)
     1282            or p-key-handle:type <> "buffer"
     1283         then do:
     1284           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info16 ).
     1285         end.
     1286         if num-entries( p-key-rec, chr(3) ) > 1
     1287           or p-key-rec = ?
     1288           or p-key-rec = "":U
     1289         then do:
     1290           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info16, p-key-rec ).
     1291         end.
     1292       end.
     1293       else do:
     1294         if p-key-rec = ?
     1295           or p-key-rec = "":U
     1296         then do:
     1297           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info16 ).
     1298         end.
     1299       end.
     1300       assign
     1301         vTable = entry( 1 , p-key-rec, chr(3) )
     1302       .
     1303       if p-tt-handle <> ?
     1304         and ( not valid-handle(p-tt-handle)
     1305               or p-tt-handle:type <> "buffer"
     1306             )
     1307       then do:
     1308         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info16, vTable, chr(10) ).
     1309       end.
     1310       if p-tt-handle = ? then do:
     1311         assign
     1312           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
     1313         .
     1314         create buffer bh_tbl-name for table v-full-tbl-name .
     1315       end.
     1316       else do:
     1317         create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1318       end.
     1319       assign
     1320         v-inform = bh_tbl-name:index-information(1)
     1321         v-ind    = 2
     1322       .
     1323       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1324       on error undo, return error
     1325       :
     1326         assign
     1327           v-inform = bh_tbl-name:index-information( v-ind )
     1328           v-ind    = v-ind + 1
     1329         .
     1330       end.
     1331       if v-inform = ?
     1332         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1333         or entry( 3, v-inform, ",":U ) <> "1":U
     1334       then do:
     1335         delete object bh_tbl-name no-error.
     1336         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info16, vTable ).
     1337       end.
     1338       assign
     1339         v-idx-field-qnty = num-entries( v-inform ) - 4
     1340       .
     1341       if v-idx-field-qnty < 2 then do:
     1342         delete object bh_tbl-name no-error.
     1343         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info16, v-inform, vTable ).
     1344       end.
     1345       assign
     1346         o-where     = "where":U
     1347         v-word-link = "":U
     1348         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
     1349         v-count-fld = 0
     1350       .
     1351       if i-tablekey ne "" and i-tablekey ne ?
     1352       then do:
     1353         assign
     1354           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
     1355         .
     1356         create buffer bh_tbl-key for table v-full-tbl-name .
     1357       end.
     1358       if i-tableSerach ne "" and i-tableSerach ne ?
     1359       then do:
     1360         delete object bh_tbl-name no-error.
     1361         assign
     1362           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
     1363         .
     1364         create buffer bh_tbl-name for table v-full-tbl-name .
     1365       end.
     1366       block_where:
     1367       do v-ind = 1 to v-idx-field-qnty by 2
     1368       on error undo, return error
     1369       :
     1370         assign
     1371           v-count-fld = v-count-fld + 1
     1372         .
     1373         if p-key-handle = ?
     1374           and v-count-fld > v-field-num
     1375         then do:
     1376           leave block_where.
     1377         end.
     1378         define variable VfieldKeyTable as handle no-undo.
     1379         assign
     1380           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     1381           fh_search    = bh_tbl-name:buffer-field( v-field-name )
     1382         .
     1383         if     bh_tbl-key ne ?
     1384         then do:
     1385            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
     1386            if VfieldKeyTable eq ?
     1387            then next block_where.
     1388         end.
     1389         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
     1390         then
     1391            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
     1392         else
     1393            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
     1394         if p-key-handle = ? then do:
     1395           assign
     1396             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
     1397           .
     1398         end.
     1399         else do:
     1400           assign
     1401             fh_key = p-key-handle:buffer-field( v-field-name )
     1402           .
     1403           if fh_key = ?
     1404             or not valid-handle( fh_key )
     1405           then do:
     1406             delete object bh_tbl-name.
     1407             if     bh_tbl-key ne ?
     1408             then
     1409                delete object bh_tbl-key.
     1410             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info16, p-key-handle:name, v-field-name ).
     1411           end.
     1412           assign
     1413             v-field-val = fh_key:buffer-value
     1414           .
     1415         end.
     1416         if fh_search:data-type ="character":U then do:
     1417           assign
     1418             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
     1419             v-field-val = replace( v-field-val, '"':U, '~~"':U )
     1420             v-field-val = replace( v-field-val, "'":U, "~~'":U )
     1421             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
     1422             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
     1423             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
     1424             v-field-val = replace( v-field-val, chr(10), '~~n':U )
     1425             v-field-val = replace( v-field-val, chr(9), '~~t':U )
     1426             v-field-val = replace( v-field-val, chr(13), '~~r':U )
     1427             v-field-val = replace( v-field-val, chr(27), '~~E':U )
     1428             v-field-val = replace( v-field-val, chr(8), '~~b':U )
     1429             v-field-val = replace( v-field-val, chr(12), '~~f':U )
     1430             v-field-val = substitute( '"&1"', v-field-val )
     1431           .
     1432         end.
     1433         assign
     1434           o-where = substitute( "&1 &2", o-where, v-field-val )
     1435         .
     1436         if v-word-link = "":U then do:
     1437           assign
     1438             v-word-link = "and":U
     1439           .
     1440         end.
     1441       end.
     1442       delete object bh_tbl-name.
     1443       if     bh_tbl-key ne ?
     1444       then
     1445          delete object bh_tbl-key.
     1446       if p-key-handle = ?
     1447         and v-count-fld <> v-field-num
     1448       then do:
     1449         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info16, vTable ).
     1450       end.
     1451     end.
     1452   end procedure.
     1453   procedure gen-hn-keyr-tab :
     1454     define input  parameter i-tableSerach as character no-undo.
     1455     define input  parameter i-tablekey   as character no-undo.
     1456     define input  parameter p-key-rec    as character no-undo.
     1457     define input  parameter p-key-handle as handle    no-undo .
     1458     define input  parameter p-db-name    as character no-undo .
     1459     define input  parameter p-tt-handle  as handle    no-undo .
     1460     define input  parameter p-stts-lock  as integer   no-undo .
     1461     define output parameter o-hn         as handle    no-undo.
     1462     define variable v-full-tbl-name as character no-undo.
     1463     define variable v-where         as character no-undo.
     1464     define variable bh_tbl-name     as handle    no-undo.
     1465     define variable vTable          as character no-undo.
     1466     do
     1467     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1468     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1469     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
     1470         run gen-where-keyr-tab(i-tableSerach,
     1471                                i-tablekey,
     1472                                p-key-rec,
     1473                                p-key-handle,
     1474                                p-db-name,
     1475                                p-tt-handle,
     1476                                output v-where).
     1477         if i-tableSerach ne "" and i-tableSerach ne ?
     1478         then do:
     1479            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
     1480            create buffer bh_tbl-name for table v-full-tbl-name .
     1481         end.
     1482         else do:
     1483            if p-tt-handle = ? then do:
     1484               assign
     1485                  vTable = entry( 1 , p-key-rec, chr(3) )
     1486               .
     1487               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
     1488               create buffer bh_tbl-name for table v-full-tbl-name .
     1489            end.
     1490            else do:
     1491               create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1492            end.
     1493         end.
     1494         if p-tt-handle = ? then do:
     1495            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
     1496         end.
     1497         else do:
     1498            bh_tbl-name:find-first( v-where ) no-error .
     1499         end.
     1500         o-hn = bh_tbl-name.
     1501      end.
     1502   end procedure.
     1503   procedure gen-hn-keyr :
     1504     define input  parameter p-key-rec    as character no-undo.
     1505     define input  parameter p-key-handle as handle    no-undo .
     1506     define input  parameter p-db-name    as character no-undo .
     1507     define input  parameter p-tt-handle  as handle    no-undo .
     1508     define input  parameter p-stts-lock  as integer   no-undo .
     1509     define output parameter o-hn         as handle    no-undo.
     1510     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
     1511   end.
     1512   procedure gen-row-keyr :
     1513     define input  parameter p-key-rec    as character no-undo.
     1514     define input  parameter p-key-handle as handle    no-undo .
     1515     define input  parameter p-db-name    as character no-undo .
     1516     define input  parameter p-tt-handle  as handle    no-undo .
     1517     define input  parameter p-stts-lock  as integer   no-undo .
     1518     define output parameter p-tbl-row    as rowid     no-undo.
     1519     define output parameter p-tbl-name   as character no-undo.
     1520     define variable vHn as handle no-undo.
     1521       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
     1522       p-tbl-row = if vHn:available then vHn:rowid else ?.
     1523       p-tbl-name =  vHn:table.
     1524       delete object vHn no-error.
     1525     if p-tbl-row = ? then do:
     1526       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info16, p-tbl-name, p-key-rec ).
     1527     end.
     1528     else do:
     1529       return.
     1530     end.
     1531   end procedure.
     1532   procedure gen-key-fv :
     1533     define input  parameter p-key-rec    as character no-undo .
     1534     define output parameter p-field-list as character no-undo .
     1535     define output parameter p-value-list as character no-undo.
     1536     do
     1537     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1538     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1539     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1540     :
     1541       define variable v-full-tbl-name  as character no-undo .
     1542       define variable bh_tbl-name      as handle    no-undo .
     1543       define variable v-tbl-name       as character no-undo .
     1544       define variable v-field-num      as integer   no-undo .
     1545       define variable v-count-fld      as integer   no-undo .
     1546       define variable v-inform         as character no-undo .
     1547       define variable v-ind            as integer   no-undo .
     1548       define variable v-idx-field-qnty as integer   no-undo .
     1549       define variable v-delim-key      as character no-undo .
     1550       if p-key-rec = ?
     1551         or p-key-rec = "":U
     1552       then do:
     1553         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info16 ).
     1554       end.
     1555       assign
     1556         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     1557         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1558       .
     1559       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1560       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info16 ).
     1561       assign
     1562         v-inform = bh_tbl-name:index-information(1)
     1563         v-ind    = 2
     1564       .
     1565       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1566       on error undo, return error
     1567       :
     1568         assign
     1569           v-inform = bh_tbl-name:index-information( v-ind )
     1570           v-ind    = v-ind + 1
     1571         .
     1572       end.
     1573       if v-inform = ?
     1574         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1575         or entry( 3, v-inform, ",":U ) <> "1":U
     1576       then do:
     1577         delete object bh_tbl-name no-error.
     1578         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info16, v-tbl-name ).
     1579       end.
     1580       assign
     1581         v-idx-field-qnty = num-entries( v-inform ) - 4
     1582       .
     1583       if v-idx-field-qnty < 2 then do:
     1584         delete object bh_tbl-name no-error.
     1585         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info16, v-inform, v-tbl-name ).
     1586       end.
     1587       assign
     1588         p-field-list = "":U
     1589         p-value-list = "":U
     1590         v-delim-key  = "":U
     1591         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     1592         v-count-fld  = 0
     1593       .
     1594       block_where:
     1595       do v-ind = 1 to v-idx-field-qnty by 2
     1596       on error undo, return error
     1597       :
     1598         assign
     1599           v-count-fld = v-count-fld + 1
     1600         .
     1601         if v-count-fld > v-field-num then do:
     1602           leave block_where.
     1603         end.
     1604         assign
     1605           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     1606           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     1607         .
     1608         if v-ind = 1 then do:
     1609           assign
     1610             v-delim-key = chr(3)
     1611           .
     1612         end.
     1613       end.
     1614       delete object bh_tbl-name.
     1615       if v-count-fld <> v-field-num then do:
     1616         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info16, v-tbl-name ).
     1617       end.
     1618     end.
     1619   end procedure.
     1620   procedure gen-key-field :
     1621     define input  parameter p-table      as character no-undo .
     1622     define output parameter p-field-list as character no-undo .
     1623     do
     1624     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1625     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1626     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1627     :
     1628       define variable v-full-tbl-name  as character no-undo .
     1629       define variable bh_tbl-name      as handle    no-undo .
     1630       define variable v-tbl-name       as character no-undo .
     1631       define variable v-field-num      as integer   no-undo .
     1632       define variable v-count-fld      as integer   no-undo .
     1633       define variable v-inform         as character no-undo .
     1634       define variable v-ind            as integer   no-undo .
     1635       define variable v-idx-field-qnty as integer   no-undo .
     1636       define variable v-delim-key      as character no-undo .
     1637       if p-table = ?
     1638         or p-table = "":U
     1639       then do:
     1640         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info16 ).
     1641       end.
     1642       assign
     1643         v-tbl-name      = p-table
     1644         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1645       .
     1646       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1647       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info16 ).
     1648       assign
     1649         v-inform = bh_tbl-name:index-information(1)
     1650         v-ind    = 2
     1651       .
     1652       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1653       on error undo, return error
     1654       :
     1655         assign
     1656           v-inform = bh_tbl-name:index-information( v-ind )
     1657           v-ind    = v-ind + 1
     1658         .
     1659       end.
     1660       if v-inform = ?
     1661         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1662         or entry( 3, v-inform, ",":U ) <> "1":U
     1663       then do:
     1664         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info16, v-tbl-name ).
     1665       end.
     1666       assign
     1667         v-idx-field-qnty = num-entries( v-inform ) - 4
     1668       .
     1669       if v-idx-field-qnty < 2 then do:
     1670         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info16, v-inform, v-tbl-name ).
     1671       end.
     1672       assign
     1673         p-field-list = "":U
     1674         v-delim-key  = "":U
     1675         v-count-fld  = 0
     1676       .
     1677       block_where:
     1678       do v-ind = 1 to v-idx-field-qnty by 2
     1679       on error undo, return error
     1680       :
     1681         assign
     1682           v-count-fld = v-count-fld + 1
     1683         .
     1684         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     1685         if v-ind = 1 then do:
     1686           assign
     1687             v-delim-key = chr(3)
     1688           .
     1689         end.
     1690       end.
     1691       delete object bh_tbl-name.
     1692     end.
     1693   end procedure.
     1694   DEFINE VARIABLE vTime AS INTEGER FORMAT ">>>9":U INITIAL 0
     1695        LABEL "Время гашения"
     1696        VIEW-AS FILL-IN
     1697        SIZE 14 BY 1 NO-UNDO.
     1698   DEFINE RECTANGLE RECT-1
     1699        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1700        SIZE 35 BY 10.48 TOOLTIP "Статус ВСД"
     1701        FGCOLOR 0 .
     1702   DEFINE VARIABLE vSent AS LOGICAL INITIAL yes
     1703        LABEL "Отправлен"
     1704        VIEW-AS TOGGLE-BOX
     1705        SIZE 22 BY .81 NO-UNDO.
     1706   DEFINE VARIABLE vFalExting AS LOGICAL INITIAL yes
     1707        LABEL "Ошибка гашения"
     1708        VIEW-AS TOGGLE-BOX
     1709        SIZE 30 BY 1 NO-UNDO.
     1710   DEFINE VARIABLE vFalRegis AS LOGICAL INITIAL no
     1711        LABEL "Ошибка регистрации"
     1712        VIEW-AS TOGGLE-BOX
     1713        SIZE 30 BY 1 NO-UNDO.
     1714   DEFINE VARIABLE vFalVerif AS LOGICAL INITIAL yes
     1715        LABEL "Ошибка проверки ВСД"
     1716        VIEW-AS TOGGLE-BOX
     1717        SIZE 30 BY 1 NO-UNDO.
     1718   DEFINE VARIABLE vRegis AS LOGICAL INITIAL no
     1719        LABEL "Зарегистрирован"
     1720        VIEW-AS TOGGLE-BOX
     1721        SIZE 30 BY 1 NO-UNDO.
     1722   DEFINE VARIABLE vRep AS LOGICAL INITIAL yes
     1723        LABEL "Погашен"
     1724        VIEW-AS TOGGLE-BOX
     1725        SIZE 30 BY 1 NO-UNDO.
     1726   DEFINE VARIABLE vReqVerif AS LOGICAL INITIAL yes
     1727        LABEL "Требует проверки"
     1728        VIEW-AS TOGGLE-BOX
     1729        SIZE 30 BY 1 NO-UNDO.
     1730   DEFINE VARIABLE vToExtin AS LOGICAL INITIAL yes
     1731        LABEL "К гашению"
     1732        VIEW-AS TOGGLE-BOX
     1733        SIZE 30 BY 1 NO-UNDO.
     1734   DEFINE VARIABLE vToRegi AS LOGICAL INITIAL no
     1735        LABEL "К регистрации"
     1736        VIEW-AS TOGGLE-BOX
     1737        SIZE 30 BY 1 NO-UNDO.
     1738   DEFINE FRAME F-Main
     1739        vTime AT ROW 1.95 COL 22 COLON-ALIGNED WIDGET-ID 22
     1740        vReqVerif AT ROW 4.29 COL 5.6 WIDGET-ID 2
     1741        vFalVerif AT ROW 5.29 COL 5.6 WIDGET-ID 4
     1742        vToExtin AT ROW 6.29 COL 5.6 WIDGET-ID 6
     1743        vFalExting AT ROW 7.29 COL 5.6 WIDGET-ID 8
     1744        vRep AT ROW 8.29 COL 5.6 WIDGET-ID 10
     1745        vSent AT ROW 9.29 COL 5.6 WIDGET-ID 24
     1746        vToRegi AT ROW 10.29 COL 5.6 WIDGET-ID 12
     1747        vFalRegis AT ROW 11.29 COL 5.6 WIDGET-ID 14
     1748        vRegis AT ROW 12.29 COL 5.6 WIDGET-ID 16
     1749        "[ Статус ВСД ]" VIEW-AS TEXT
     1750             SIZE 15 BY .62 AT ROW 3.38 COL 13 WIDGET-ID 20
     1751        RECT-1 AT ROW 3.62 COL 4 WIDGET-ID 18
     1752       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
     1753            SIDE-LABELS NO-UNDERLINE THREE-D
     1754            AT COL 1 ROW 1 SCROLLABLE  WIDGET-ID 100.
     1755   IF NOT THIS-PROCEDURE:PERSISTENT THEN DO:
     1756     MESSAGE "c:\tester\Rls_16_0\rc_160_rus\cmpdir\src\rep\e-statusvsd.w should only be RUN PERSISTENT.":U
     1757             VIEW-AS ALERT-BOX ERROR BUTTONS OK.
     1758     RETURN.
     1759   END.
     1760   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
     1761   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
     1762   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
     1763   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
     1764   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
     1765   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
     1766   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
     1767   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
     1768         adm-object-hdl = FRAME F-Main:HANDLE.
     1769   RUN ensure-broker.
     1770   THIS-PROCEDURE:ADM-DATA =
     1771        'ADM1.1~`':U +
     1772        'SmartObject~`':U +
     1773        '~`':U +
     1774        'NO ~`':U +
     1775        '~`':U +
     1776        '~`':U +
     1777        '~`':U +
     1778        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
     1779           + "~`":U +
     1780        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add~`':U +
     1781        '~`':U +
     1782        '~`':U +
     1783        '~`~`~`~`~`~`~`~`~`~`~`':U +
     1784        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
     1785            THEN "^^":U
     1786        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
     1787             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
     1788   PROCEDURE adm-apply-entry :
     1789     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1790   END PROCEDURE.
     1791   PROCEDURE adm-destroy :
     1792    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1793   END PROCEDURE.
     1794   PROCEDURE adm-disable :
     1795       DISABLE vTime vReqVerif vFalVerif vToExtin vFalExting vRep vSent WITH FRAME F-Main.
     1796       RUN dispatch ('disable-fields':U).
     1797       RUN set-attribute-list ('ENABLED=no':U).
     1798       RETURN.
     1799   END PROCEDURE.
     1800   PROCEDURE adm-edit-attribute-list :
     1801         RUN adm/support/viewerd.w (INPUT THIS-PROCEDURE).
     1802         RETURN.
     1803   END PROCEDURE.
     1804   PROCEDURE adm-enable :
     1805       ENABLE UNLESS-HIDDEN vTime vReqVerif vFalVerif vToExtin vFalExting vRep vSent WITH FRAME F-Main.
     1806       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
     1807       RUN set-attribute-list ('ENABLED=yes':U).
     1808       RETURN.
     1809   END PROCEDURE.
     1810   PROCEDURE adm-exit :
     1811        RUN notify ('exit':U).
     1812     RETURN.
     1813   END PROCEDURE.
     1814   PROCEDURE adm-hide :
     1815     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1816   END PROCEDURE.
     1817   PROCEDURE adm-initialize :
     1818     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1819   END PROCEDURE.
     1820   PROCEDURE adm-show-errors :
     1821       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
     1822       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
     1823           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
     1824       END.
     1825       RETURN.
     1826   END PROCEDURE.
     1827   PROCEDURE adm-UIB-mode :
     1828     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1829   END PROCEDURE.
     1830   PROCEDURE adm-view :
     1831     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1832   END PROCEDURE.
     1833   PROCEDURE dispatch :
     1834       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
     1835       RUN broker-dispatch IN adm-broker-hdl
     1836           (THIS-PROCEDURE, p-method-name) NO-ERROR.
     1837       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
     1838   END PROCEDURE.
     1839   PROCEDURE ensure-broker :
     1840   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
     1841   IF RETURN-VALUE NE "ADM-Broker":U THEN
     1842   DO:
     1843       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
     1844       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
     1845   END.
     1846   END PROCEDURE.
     1847   PROCEDURE get-attribute :
     1848     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
     1849     RUN broker-get-attribute IN adm-broker-hdl
     1850         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
     1851     RETURN RETURN-VALUE.
     1852   END PROCEDURE.
     1853   PROCEDURE get-attribute-list :
     1854     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
     1855     RUN broker-get-attribute-list IN adm-broker-hdl
     1856         (INPUT THIS-PROCEDURE,
     1857          INPUT ?,
     1858          OUTPUT p-attr-list) NO-ERROR.
     1859     RETURN.
     1860   END PROCEDURE.
     1861   PROCEDURE new-state :
     1862     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     1863     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
     1864     RETURN.
     1865   END PROCEDURE.
     1866   PROCEDURE notify :
     1867     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
     1868     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
     1869     IF RETURN-VALUE = "ADM-ERROR":U THEN
     1870         RETURN "ADM-ERROR":U.
     1871     RETURN.
     1872   END PROCEDURE.
     1873   PROCEDURE set-attribute-list :
     1874     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
     1875     RUN ensure-broker.
     1876     RUN broker-set-attribute-list IN adm-broker-hdl
     1877         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
     1878     RETURN.
     1879   END PROCEDURE.
     1880   PROCEDURE set-position :
     1881       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
     1882       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
     1883       IF VALID-HANDLE(adm-object-hdl) THEN
     1884       DO:
     1885         ASSIGN adm-object-hdl:ROW    =   p-row
     1886                adm-object-hdl:COLUMN =   p-col.
     1887       END.
     1888       RETURN.
     1889   END PROCEDURE.
     1890   PROCEDURE adm-display-fields :
     1891       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
     1892       RETURN.
     1893   END PROCEDURE.
     1894   PROCEDURE adm-open-query :
     1895     RETURN.
     1896   END PROCEDURE.
     1897   PROCEDURE adm-row-changed :
     1898         IF VALID-HANDLE(adm-object-hdl) THEN
     1899           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     1900         RUN notify ('row-available':U).
     1901         RETURN.
     1902   END PROCEDURE.
