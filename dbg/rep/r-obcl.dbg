     1417           cur-time-print() AT 5 format "X(35)"
     1418           "Цены указаны в" (if tPrintRubl then "РУБ" else x-base-type )
     1419           string( "Страница " + string( PAGE-NUMBER( OutStream ), ">>>>9") ) AT 147 format "X(53)" SKIP
     1420           Line format "X(194)" AT 1
     1421      with width 232 down stream-io use-text NO-BOX.
     1422   procedure create-temp-t-post-stk-line :
     1423       define variable str  as char      format "X(60)" no-undo.
     1424       define variable str2 as char      no-undo.
     1425       define variable v-r  as character no-undo init "" .
     1426       define variable i#i  as int       no-undo.
     1427    do
     1428    on error undo, return error return-value
     1429    :
     1430    if available ub.goods and
     1431       available ub.clients and
     1432       available prod-cli then do:
     1433     create temp-t-post-stk-line .
     1434     BUFFER-COPY post-stk-line  TO temp-t-post-stk-line
     1435     assign
     1436       temp-t-post-stk-line.goods-grp-name    = ub.goods.grp-name
     1437       temp-t-post-stk-line.gds-code          = ub.goods.gds-code
     1438       temp-t-post-stk-line.unit-base         = ub.goods.unit-base
     1439       temp-t-post-stk-line.prt-root          = ub.goods.prt-root
     1440       temp-t-post-stk-line.gds-type          = ub.goods.gds-type
     1441       temp-t-post-stk-line.gds-name          = if g#gds-engl then ub.goods.engl-name else ub.goods.gds-name
     1442       temp-t-post-stk-line.clients-grp-name  = ub.clients.grp-name
     1443       temp-t-post-stk-line.clients-obj-name  = ub.clients.obj-name
     1444       temp-t-post-stk-line.prod-cli-obj-name = prod-cli.obj-name
     1445       temp-t-post-stk-line.prod-cli-obj-code = prod-cli.obj-code
     1446       temp-t-post-stk-line.prod-cli-obj-type = prod-cli.obj-type
     1447     .
     1448               if xlavel > 0 then
     1449               do:
     1450                   repeat i#i =1 to xlavel:
     1451                       if i#i =1 then str   = entry(1,ub.goods.grp-name, chr(47)) .
     1452                       else
     1453                       do:
     1454                           str2 = entry(i#i,ub.goods.grp-name, chr(47)) no-error.
     1455                           if not error-status:error  and str2 <> "":u then
     1456                               str = str +  chr(47) +  entry(i#i,ub.goods.grp-name, chr(47)) no-error .
     1457                       end.
     1458                   end.
     1459                   if str <> ? then
     1460                   do:
     1461                       temp-t-post-stk-line.goods-grp-name = str + chr(47) .
     1462                   end.
     1463               end.
     1464               else
     1465               do :
     1466                   temp-t-post-stk-line.goods-grp-name = ub.goods.grp-name.
     1467               end.
     1468           end.
     1469    end.
     1470   end procedure.
     1471   define temp-table temp-font no-undo
     1472     field fontnum  as integer
     1473     field fontname as character
     1474     field fontsize as character
     1475     field fonttype as character
     1476     field font-h   as integer
     1477     field font-w   as integer
     1478     field v-row    as integer
     1479     field v-col    as integer
     1480     field v-row-lans as integer
     1481     field v-col-lans as integer
     1482   index pi fontnum
     1483   .
     1484   procedure get-font-ini :
     1485     do
     1486     on error undo, return error return-value
     1487     :
     1488   define variable ii as integer   no-undo .
     1489   define variable v-font7 as character no-undo .
     1490   define variable v-font as character no-undo .
     1491   define variable loc-name as character no-undo .
     1492   define variable loc-size as character no-undo .
     1493   define variable loc-type as character no-undo .
     1494   define variable old_H as integer   no-undo .
     1495   define variable old_w as integer   no-undo .
     1496   define variable old-row  as integer   no-undo .
     1497   define variable old-col  as integer   no-undo .
     1498   define variable old-row-lans  as integer   no-undo .
     1499   define variable old-col-lans  as integer   no-undo .
     1500   define variable vv as integer   no-undo .
     1501   empty temp-table temp-font.
     1502     GET-KEY-VALUE SECTION "fonts" KEY "font7" VALUE v-font7 .
     1503       case num-entries (v-font7) :
     1504         when 4 then do:
     1505             assign
     1506               loc-name = entry ( 1 , v-font7 )
     1507               loc-size = entry ( 2 , v-font7 )
     1508               loc-type = entry ( 3 , v-font7 ) + "," +  entry ( 4 , v-font7 )
     1509             .
     1510         end.
     1511         when 3 then do:
     1512             assign
     1513               loc-name = entry ( 1 , v-font7 )
     1514               loc-size = entry ( 2 , v-font7 )
     1515               loc-type = entry ( 3 , v-font7 )
     1516             .
     1517         end.
     1518         when 2 then  do:
     1519             assign
     1520               loc-name = entry ( 1 , v-font7 )
     1521               loc-size = entry ( 2 , v-font7 )
     1522               loc-type = ""
     1523             .
     1524         end.
     1525         when 1 then do:
     1526             assign
     1527               loc-name = trim(entry ( 1 , v-font7 ))
     1528               loc-size = ""
     1529               loc-type = ""
     1530             .
     1531         end.
     1532       end case.
     1533     create temp-font.
     1534     assign
     1535       temp-font.fontnum  = 7
     1536       temp-font.fontname = trim(loc-name)
     1537       temp-font.fontsize = trim(loc-size)
     1538       temp-font.fonttype = trim(loc-type)
     1539       temp-font.v-row    = 62
     1540       temp-font.v-col    = 136
     1541       temp-font.v-row-lans = 43
     1542       temp-font.v-col-lans = 198
     1543     .
     1544     repeat ii = 16 to 100 :
     1545       get-key-value section 'fonts' key 'font' + string(ii)   value v-font  .
     1546       if v-font = "" or v-font = ? then leave.
     1547       case num-entries (v-font) :
     1548         when 4 then do:
     1549             assign
     1550               loc-name = entry ( 1 , v-font )
     1551               loc-size = entry ( 2 , v-font )
     1552               loc-type = entry ( 3 , v-font ) + "," +  entry ( 4 , v-font )
     1553             .
     1554         end.
     1555         when 3 then do:
     1556             assign
     1557               loc-name = entry ( 1 , v-font )
     1558               loc-size = entry ( 2 , v-font )
     1559               loc-type = entry ( 3 , v-font )
     1560             .
     1561         end.
     1562         when 2 then do:
     1563             assign
     1564               loc-name = entry ( 1 , v-font )
     1565               loc-size = entry ( 2 , v-font )
     1566               loc-type = ""
     1567             .
     1568         end.
     1569         when 1 then do:
     1570             assign
     1571               loc-name = trim(entry ( 1 , v-font ))
     1572               loc-size = ""
     1573               loc-type = ""
     1574             .
     1575         end.
     1576       end case.
     1577     create temp-font.
     1578     assign
     1579       temp-font.fontnum  = ii
     1580       temp-font.fontname = trim(loc-name)
     1581       temp-font.fontsize = trim(loc-size)
     1582       temp-font.fonttype = trim(loc-type)
     1583     .
     1584     end.
     1585       for each temp-font :
     1586          vv = integer(entry(2,temp-font.fontsize, "=" )) no-error .
     1587          if  vv = ? then vv =  0 .
     1588           run rep/exfont.p (
     1589             input   temp-font.fontname ,
     1590             input   vv ,
     1591             input   temp-font.fonttype ,
     1592             output  temp-font.font-h   ,
     1593             output  temp-font.font-w   )
     1594           .
     1595       end.
     1596   find first temp-font where  temp-font.fontnum  = 7  .
     1597   old_H = temp-font.font-H .
     1598   old_w = temp-font.font-W .
     1599   old-row = temp-font.v-row .
     1600   old-col = temp-font.v-col .
     1601   old-row-lans = temp-font.v-row-lans .
     1602   old-col-lans = temp-font.v-col-lans .
     1603       for each temp-font where
     1604                temp-font.fontnum  <> 7 :
     1605           assign
     1606               temp-font.v-row    = old_H * old-row / temp-font.font-h
     1607               temp-font.v-col    = old_W * old-col / temp-font.font-W
     1608               temp-font.v-row-lans    = old_H * old-row-lans / temp-font.font-h
     1609               temp-font.v-col-lans    = old_W * old-col-lans / temp-font.font-W
     1610           .
     1611       end.
     1612     end.
     1613   end procedure.
     1614   PROCEDURE How-name :
     1615   define input  parameter h as integer no-undo .
     1616   define input  parameter w as integer no-undo .
     1617   define output parameter n as character  no-undo .
     1618   define variable A4port-H as integer   no-undo init 63.
     1619   define variable A4port-W as integer   no-undo init 136.
     1620   define variable A4lans-H as integer   no-undo init 43.
     1621   define variable A4lans-W as integer   no-undo init 198.
     1622   define variable Strim-W  as integer   no-undo init 278.
     1623   run define-a4-size (
     1624        input ReportFontNum
     1625       ,output A4port-H
     1626       ,output A4port-W
     1627       ,output A4lans-H
     1628       ,output A4lans-W ).
     1629   If w >= 1 and w <= A4port-W Then DO:
     1630     If h >= 1  and h <= A4lans-H Then n = "A4-lans":U.
     1631     If h > A4lans-H  and h <= A4port-H Then n = "A4-port":U.
     1632     If h > A4port-H              Then n = "to-file":U.
     1633   End.
     1634   If w > A4port-W and w <= A4lans-W Then DO:
     1635     If h >= 1  and h <= A4lans-H Then n = "A4-lans":U.
     1636     If h > A4lans-H  and h <= A4port-H Then n = "A3-lans":U.
     1637     If h > A4port-H              Then n = "to-file":U.
     1638   End.
     1639   If w > A4lans-W and w <= Strim-W Then DO:
     1640     If h >= 1  and h <= A4lans-H Then n = "to-file":U.
     1641     If h > A4lans-H  and h <= A4port-H Then n = "A3-lans":U.
     1642     If h > A4port-H              Then n = "to-file":U.
     1643   End.
     1644   If w > Strim-W Then DO:
     1645      n = "to-file":U.
     1646   End.
     1647   END PROCEDURE.
     1648   PROCEDURE define-a4-size :
     1649   define input  parameter p-ReportFontNum as integer   no-undo .
     1650   define output parameter A4port-H as integer   no-undo .
     1651   define output parameter A4port-W as integer   no-undo .
     1652   define output parameter A4lans-H as integer   no-undo .
     1653   define output parameter A4lans-W as integer   no-undo .
     1654   if not can-find (first temp-font ) then do:
     1655      run get-font-ini .
     1656   end.
     1657   find first temp-font where temp-font.fontnum = p-ReportFontNum no-error .
     1658   if available temp-font then do:
     1659   assign
     1660     A4port-H = temp-font.v-row
     1661     A4port-W = temp-font.v-col
     1662     A4lans-H = temp-font.v-row-lans
     1663     A4lans-W = temp-font.v-col-lans
     1664   .
     1665   end.
     1666   else do:
     1667   assign
     1668     A4port-H = 63
     1669     A4port-W = 136
     1670     A4lans-H = 43
     1671     A4lans-W = 198
     1672   .
     1673   end.
     1674   END PROCEDURE.
     1675   define buffer a-clients for ub.clients.
     1676   define stream  outstream2.
     1677   define variable chosedtype   as integer no-undo.
     1678   define variable valtype      as integer no-undo.
     1679   define variable firstline    as logical no-undo.
     1680   define variable tot_tqnty    as decimal no-undo.
     1681   define variable break_group  as logical no-undo init true.
     1682   define variable break_group1 as logical no-undo init true.
