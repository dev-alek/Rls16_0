     1726   define variable  temp-str as char no-undo.
     1727   define variable str as char format "x(60)" no-undo.
     1728   define variable i#i as int no-undo.
     1729   define variable list-field as char no-undo.
     1730   define variable str10 as char no-undo.
     1731        assign
     1732           i=0
     1733           xlavel        = xvar-lavel
     1734           select-good   = x-selectgood
     1735           paytype       = x-set_pay_type
     1736           retclassify   = xclassify
     1737           retsorttype   = xsorttype
     1738           sums-only     = xsumsonly
