     1851   procedure calcitog :
     1852       run ostatok (
     1853           input x-store-code  ,
     1854           input x-store-type  ,x-tog-shift,
     1855           input x-date-start - 1 ,
     1856           input date('')      , x-shift-start,x-shift-end,
     1857           input 'cost':U   ,
     1858           input '##,##':U,
     1859           input xtog-obj ,
     1860           output  quantity1  ,
     1861           output  coast_r1   ,
     1862           output  coast_v1   ,
     1863           output  vat_r1     ,
     1864           output  vat_v1     ,
     1865           output  fact-order-1 ).
     1866       run ostatok (
     1867           input x-store-code  ,
     1868           input x-store-type  , x-tog-shift,
     1869           input x-date-start  ,
     1870           input x-date-end    , x-shift-start,x-shift-end,
     1871           input 'cost':U   ,
     1872           input '##,##':U,
     1873           input xtog-obj ,
     1874           output  quantity1  ,
     1875           output  coast_r1   ,
     1876           output  coast_v1   ,
     1877           output  vat_r1     ,
     1878           output  vat_v1     ,
     1879           output  fact-order-2 ).
     1880             quantity1  = 0.
     1881             coast_r1   = 0.
     1882             coast_v1   = 0.
     1883             vat_r1     = 0.
     1884             vat_v1     = 0.
     1885   end procedure.
     1886   procedure display-bi  :
     1887              run di-qnty("кол-во",1,  "", gds-zap-artic ,"" ,"", "bi":u).
     1888            if show-cost    then do: run di ("учет." , 2 , "","", "", "", "bi":u).  end.
     1889            if show-sale    then do: run di ("док-т." , 8, "","", "", "",  "bi":u).  end.
     1890   end procedure.
