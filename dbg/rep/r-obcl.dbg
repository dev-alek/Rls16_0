     1921   procedure display-title :
     1922      PUT stream  OutStream  UNFORMATTED  string( v-cntxt-host-name-obj +  " , " + x-store-type  +  " " + objname) at 50 format "x(85)" skip(2)
     1923             reportname  at 20 format "x(170)" skip
     1924             trim(str1)  at 35 format "x(75)" skip.
     1925        repeat i = 1 to num-entries(str2,chr(10)) :
     1926         PUT stream  OutStream  UNFORMATTED  entry(i,str2,chr(10))  at 1 format "x(170)" skip.
     1927        end.
     1928       i=0.
     1929          PUT stream  OutStream  UNFORMATTED  trim(str3)  at 35 format "x(75)" skip.
     1930        repeat i = 1 to num-entries(str4,chr(10)) :
     1931         PUT stream  OutStream  UNFORMATTED  entry(i,str4,chr(10))  at 1 format "x(170)" skip.
     1932        end.
     1933       i=0.
     1934        repeat i = 1 to num-entries(reportheader,chr(10)) :
     1935         PUT stream  OutStream  UNFORMATTED  entry(i,reportheader,chr(10))  at 1 format "x(170)" skip.
     1936        end.
     1937       i=0.
     1938       run rep/extitle.p (1) .
     1939   end procedure.
     1940   PROCEDURE ostatok :
     1941   def input parameter x-store-code  like ub.clients.obj-code    no-undo.
     1942   def input parameter x-store-type  like ub.clients.obj-type    no-undo.
     1943   def input parameter x-tog-shift   as   logical             no-undo.
     1944   def input parameter x-date-start  like ub.stk-tot.Fact-date   no-undo.
     1945   def input parameter x-date-end    like ub.stk-tot.Fact-date   no-undo.
     1946   def input parameter x-shift-start as integer               no-undo.
     1947   def input parameter x-shift-end   as integer               no-undo.
     1948   def input parameter x-sum-type    like ub.stk-tot.sum-type    no-undo.
     1949   def input parameter x-cat-id      like ub.stk-tot.cat-id      no-undo.
     1950   def input parameter xTog-obj   as log no-undo.
     1951   def output parameter Quantity    like ub.stk-tot.fact-qnty   no-undo.
     1952   def output parameter Coast_R     like ub.stk-tot.sum-rubl    no-undo.
     1953   def output parameter Coast_V     like ub.stk-tot.sum-rubl    no-undo.
     1954   def output parameter VAT_R       like ub.stk-tot.sum-rubl    no-undo.
     1955   def output parameter VAT_V       like ub.stk-tot.sum-rubl    no-undo.
     1956   def output parameter Fact-order  like ub.stk-tot.Fact-order  no-undo.
     1957   def var              Fact-order#   like ub.stk-tot.Fact-order  no-undo.
     1958   def var              Fact-orderS   as char  no-undo.
     1959   def var x-date-start-t  like ub.stk-tot.shift-date   no-undo.
     1960      Assign
     1961         Fact-order   = 0
     1962         Quantity     = 0
     1963         Coast_R      = 0
     1964         Coast_V      = 0
     1965         VAT_R        = 0
     1966         VAT_V        = 0 .
     1967    x-date-start-t  = x-date-start + 1 .
     1968   IF x-date-end = date('') then DO:
     1969      Fact-order = 0 .
     1970      for each obj-list
     1971          where  ( not xtog-obj or
     1972                 ( x-store-type = obj-list.obj-type and x-store-code = obj-list.obj-code ))
     1973                 no-lock :
     1974         if  x-tog-shift = false then do:
     1975                          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     1976                               ub.stk-tot.Fact-date <=  x-date-start
     1977                               and ub.stk-tot.shift-num = 0
     1978                               USE-INDEX fact-date no-lock no-error .
     1979              if Available ub.stk-tot THEN  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     1980         End.
     1981         Else  DO :
     1982             find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     1983              (ub.stk-tot.shift-date  = x-date-start-t and
     1984               ub.stk-tot.shift-num  < x-shift-start or
     1985               ub.stk-tot.shift-date  < x-date-start-t  )
     1986               and ub.stk-tot.shift-num  > 0
     1987               USE-INDEX Shift-num no-lock no-error .
     1988            If Available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     1989           END.
     1990       If Fact-order < Fact-order#  and Fact-order# <> 0  THEN  Fact-order = Fact-order# .
     1991     End.
     1992   End.
     1993   Else DO:
     1994     For each obj-list  WHERE
     1995        (NOT xTog-obj OR (x-store-type = obj-list.obj-type AND x-store-code = obj-list.obj-code))
     1996         no-lock :
     1997      IF  x-TOG-Shift = False Then DO:
     1998          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     1999               ub.stk-tot.Fact-date <= x-date-end
     2000               and ub.stk-tot.shift-num = 0
     2001               USE-INDEX fact-date no-lock no-error.
     2002          if available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     2003      END.
     2004      Else DO:
     2005           find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     2006               (ub.stk-tot.shift-date  = x-date-end and
     2007               ub.stk-tot.shift-num  <= x-shift-end or
     2008               ub.stk-tot.shift-date  < x-date-end       ) and
     2009               ub.stk-tot.shift-num   > 0      use-index shift-num no-lock no-error.
     2010               if Available ub.stk-tot THEN Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     2011       End.
     2012       if Fact-order < Fact-order#  THEN  Fact-order = Fact-order#.
     2013     End.
     2014   End.
     2015   END PROCEDURE.
     2016   procedure report-exec1  :
     2017      find first a-clients where x-store-type = a-clients.obj-type and
     2018                               x-store-code = a-clients.obj-code no-lock no-error.
     2019              if available a-clients then  objname = a-clients.obj-name. else  objname = "объект не определен".
     2020     run waitfram-show in this-procedure ( objname ) .
     2021     form with frame zapas .
     2022   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2023   form header
     2024     line format "x(194)" at 1 skip
     2025     "Продолжение - на следующей странице" at 30 skip
     2026     with frame bottomframe width 232 page-bottom no-labels no-box .
     2027   view stream outstream frame bottomframe .
     2028     run calcitog .
     2029     run print-header .
     2030     case retsorttype :
     2031         when "sort-article":u  or when "sort-artic":u  then
     2032         if not can-find(first g#post no-lock)
     2033             then   run rep/r-ocli1.p (x-store-code, x-store-type, x-base-type , x-base-code ).
     2034             else   run rep/r-ocli2.p (x-store-code, x-store-type, x-base-type , x-base-code ).
     2035         when "sort-code":u  then
     2036         if not can-find(first g#post no-lock)
     2037             then   run rep/r-ocli3.p (x-store-code, x-store-type, x-base-type , x-base-code ).
     2038             else   run rep/r-ocli4.p (x-store-code, x-store-type, x-base-type , x-base-code ).
     2039     end case.
     2040     hide stream outstream frame bottomframe .
     2041     run print-footer.
     2042     end procedure.
     2043   procedure calc-sub-itog :
     2044   define input parameter tt as int no-undo.
     2045   define variable b as int no-undo.
     2046   repeat b = 1 to 3:
     2047     assign
     2048     b1-prih[b + tt]    = b1-prih[b + tt]    +  prih[b + tt]
     2049     b2-prih[b + tt]    = b2-prih[b + tt]    +  prih[b + tt]
     2050     bi-prih[b + tt]    = bi-prih[b + tt]    +  prih[b + tt]
     2051     b1-rash[b + tt]    = b1-rash[b + tt]    +  rash[b + tt]
     2052     b2-rash[b + tt]    = b2-rash[b + tt]    +  rash[b + tt]
     2053     bi-rash[b + tt]    = bi-rash[b + tt]    +  rash[b + tt]
     2054     b1-vzvr[b + tt]    = b1-vzvr[b + tt]    +  vzvr[b + tt]
     2055     b2-vzvr[b + tt]    = b2-vzvr[b + tt]    +  vzvr[b + tt]
     2056     bi-vzvr[b + tt]    = bi-vzvr[b + tt]    +  vzvr[b + tt]
     2057     b1-vzvr-post[b + tt]    = b1-vzvr-post[b + tt]    +  vzvr-post[b + tt]
     2058     b2-vzvr-post[b + tt]    = b2-vzvr-post[b + tt]    +  vzvr-post[b + tt]
     2059     bi-vzvr-post[b + tt]    = bi-vzvr-post[b + tt]    +  vzvr-post[b + tt]
     2060     b1-discnt[b + tt]    = b1-discnt[b + tt]    +  discnt[b + tt]
     2061     b2-discnt[b + tt]    = b2-discnt[b + tt]    +  discnt[b + tt]
     2062     bi-discnt[b + tt]    = bi-discnt[b + tt]    +  discnt[b + tt] .
     2063   end.
     2064   end procedure.
     2065   procedure clear-item :
     2066   define variable kk as int no-undo.
     2067    repeat kk = 1 to 6:
     2068    assign
     2069       prih             [kk]  = 0
     2070       rash             [kk]  = 0
     2071       vzvr             [kk]  = 0
     2072       vzvr-post        [kk]  = 0
     2073       discnt           [kk]  = 0.
     2074          end.
     2075    end procedure.
