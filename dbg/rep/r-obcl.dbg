        1   block-level on error undo, throw.
        2   define input parameter x-store-code like ub.clients.obj-code   no-undo.
        3   define input parameter x-store-type like ub.clients.obj-type   no-undo.
        4   define input parameter x-base-type  like ub.currency.curr-abbr no-undo.
        5   define input parameter x-base-code  like ub.currency.curr-code no-undo.
        6   define input parameter xserv         as character no-undo .
        7   define input parameter x-date1rash    as date no-undo .
        8   define input parameter x-date2rash    as date no-undo .
        9   define input parameter x-postname     as character no-undo .
       10   define input parameter x-radio-anal   as logical no-undo .
       11   define input parameter x-radpost      as logical no-undo .
       12   define input parameter x-show-discnt  as logical no-undo .
       13   define input parameter x-showparts     as logical no-undo .
       14   define input parameter xclassify  as char no-undo.
       15   define input parameter xsorttype  as char no-undo.
       16   define input parameter xsumsonly  as log  no-undo.
       17   define input parameter xshowzero  as log  no-undo.
       18   define input parameter xtog-obj   as log no-undo.
       19   define input parameter xshowcost as log no-undo.
       20   define input parameter xshowsale as log no-undo.
       21   define input parameter xtog-lavel as log no-undo.
       22   define input parameter xvar-lavel as int no-undo.
       23   define input parameter xtog-lavel-2 as log no-undo.
       24   define input parameter xvar-lavel-2 as int no-undo.
       25   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       26   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       27   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       28   define variable vss-workfile    as character no-undo init "$Workfile: r-obcl.p $":U .
       29   define variable vss-archive     as character no-undo init "$Archive: rep/r-obcl.p $":U .
       30   define variable vss-description as character no-undo init "Оборотная ведомость по контрагентам ".
       31   procedure vss-get-info :
       32     define output parameter p-vss-revision    like vss-revision    no-undo .
       33     define output parameter p-vss-author      like vss-author      no-undo .
       34     define output parameter p-vss-date        like vss-date        no-undo .
       35     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       36     define output parameter p-vss-archive     like vss-archive     no-undo .
       37     define output parameter p-vss-description like vss-description no-undo .
       38     assign
       39       p-vss-revision    = vss-revision
       40       p-vss-author      = vss-author
       41       p-vss-date        = vss-date
       42       p-vss-workfile    = vss-workfile
       43       p-vss-archive     = vss-archive
       44       p-vss-description = vss-description
       45     .
       46   end procedure.
       47   procedure vss-get-parameters :
       48     define output parameter p-vss-parameters as character no-undo .
       49   end procedure.
       50   define new global shared variable g#vssrevis-logger as handle    no-undo .
       51   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       52   define variable v-vssrevis-logger                   as handle    no-undo .
       53   procedure vss-logevent :
       54     define input  parameter p-extra-paramters as character no-undo .
       55     define variable v-vssrevis-parameters as character no-undo .
       56     do
       57     on error undo, return error return-value
       58     :
       59       if  valid-handle(v-vssrevis-logger)
       60       and v-vssrevis-logger :get-signature("logevent") <> ""
       61       then do:
       62         run vss-get-parameters in this-procedure
       63           (output v-vssrevis-parameters
       64           ).
       65         run logevent in v-vssrevis-logger
       66           (input vss-workfile
       67           ,input vss-revision
       68           ,input v-vssrevis-parameters
       69           ,input p-extra-paramters
       70           ).
       71       end.
       72     end.
       73   end procedure.
       74   assign
       75     v-vssrevis-logger = g#vssrevis-logger
       76   .
       77   if  valid-handle(v-vssrevis-logger)
       78   and v-vssrevis-logger :get-signature("logevent") <> ""
       79   then do:
       80     assign
       81       v-vssrevis-logevent = true
       82     .
       83     run vss-logevent in this-procedure (input vss-description) .
       84   end.
       85   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       86   define variable v-waitfram-action01         as character   no-undo .
       87   define variable v-waitfram-action02         as character   no-undo .
       88   define variable v-waitfram-action03         as character   no-undo .
       89   define variable mWaitFramTextBeg            as character   no-undo.
       90   define variable mWaitFramTextEnd            as character   no-undo.
       91   define variable mWaitFramView               as logical     no-undo.
       92   define variable mWaitProcEvent              as logical     no-undo init yes.
       93   define variable mWaitFramInterval           as integer     no-undo init 1 .
       94   define variable mWaitFramStop               as logical     no-undo.
       95   define variable mWaitFramStopUser           as logical     no-undo.
       96   define variable mWaitFramStopTimeOut        as logical     no-undo.
       97   define variable mWaitFramStartProc          as datetime-tz no-undo.
       98   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       99   define button B-WaitFramStop auto-end-key
      100        label "Стоп"
      101        size 10 by 1 tooltip "Остоновить процесс".
      102   define button B-viewProcInfo
      103        label "Информация"
      104        size 15 by 1 tooltip "Информация о процесс".
      105   define frame waitfram
      106     v-waitfram-action01 format "x(72)" no-label skip
      107     v-waitfram-action02 format "x(72)" no-label skip
      108     v-waitfram-action03 format "x(72)" no-label skip
      109     B-viewProcInfo
      110     B-WaitFramStop at row 4 col 30
      111     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      112     .
      113   define new global shared variable mBatchMode as logical no-undo init ?.
      114   define variable mFramBachModHandle as handle no-undo.
      115   mFramBachModHandle = frame waitfram:handle.
      116   define variable mFameOldVis as logical no-undo.
      117   define variable mVisCUrentVin as logical no-undo.
      118   if session:batch-mode
      119   then
      120      mBatchMode = yes.
      121   if mBatchMode = ? then do:
      122     mVisCUrentVin = current-window:visible.
      123     mFameOldVis = mFramBachModHandle:visible.
      124     mFramBachModHandle:visible  = yes.
      125     mBatchMode = mFramBachModHandle:visible ne yes.
      126     mFramBachModHandle:visible = mFameOldVis.
      127     current-window:visible = mVisCUrentVin.
      128   end.
      129    if  log-manager:logfile-name ne ?
      130     then DO:
      131         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      132         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      133         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      134     end.
      135   on choose of B-WaitFramStop in frame waitfram
      136   do:
      137     mWaitFramStop = yes.
      138     mWaitFramStopUser = yes.
      139   end.
      140   function waitfram-check-timeout returns logical():
      141      define variable vtime as int64 no-undo.
      142      if mWaitFramStopTimeOut
      143      then
      144         return yes.
      145      vtime = ( now - mWaitFramStartProc ) / 1000 .
      146      if     mWaitFramTimeOut ne ?
      147         and mWaitFramTimeOut ne 0
      148         and mWaitFramTimeOut lt vtime
      149      then do:
      150         mWaitFramStopTimeOut = yes.
      151      end.
      152      return mWaitFramStopTimeOut.
      153   end.
      154   procedure waitfram-hide :
      155     if not session:batch-mode
      156     then do
      157     on error undo, return error return-value
      158     :
      159       pause 0 before-hide .
      160       if not mBatchMode then
      161         hide frame waitfram .
      162     if     not mWaitFramView
      163        and mWaitProcEvent
      164     then
      165       process events .
      166     end.
      167   end procedure.
      168   procedure waitfram-show :
      169     define input  parameter p-message as character no-undo .
      170     define variable v-left-margin as integer   no-undo .
      171     if not session:batch-mode
      172     then do
      173     on error undo, return error return-value
      174     :
      175       if length(p-message) <= 70 then do:
      176         assign
      177           v-left-margin = integer((70 - length(p-message)) / 2)
      178         .
      179         assign
      180           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      181         .
      182         assign
      183           v-waitfram-action01 = " "
      184           v-waitfram-action02 = " "
      185                                    + fill(" ", v-left-margin)
      186                                    + p-message
      187           v-waitfram-action03 = " "
      188         .
      189       end.
      190       else do:
      191         define variable vRindex1 as integer no-undo.
      192         define variable vRindex2 as integer no-undo.
      193         vRindex1 = r-index(p-message," ",70).
      194         if vRindex1 = 0
      195         then
      196            vRindex1 = 70.
      197         if length(p-message)  <= vRindex1 + 70 then do:
      198           assign
      199             v-waitfram-action01 = " "
      200             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      201             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      202           .
      203         end.
      204         else do:
      205           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      206           if vRindex2 <= vRindex1
      207           then
      208              vRindex2 = vRindex1 + 70.
      209           assign
      210             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      211             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      212             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      213           .
      214         end.
      215       end.
      216       B-viewProcInfo:visible   in frame waitfram = no.
      217       B-viewProcInfo:sensitive in frame waitfram = no.
      218       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      219       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      220       if  (   mWaitFramView
      221          or  mWaitProcEvent)
      222          and not mBatchMode
      223       then
      224          display
      225             v-waitfram-action01 skip
      226             v-waitfram-action02 skip
      227             v-waitfram-action03 skip
      228          with frame waitfram .
      229       if     mWaitFramView
      230          then do:
      231             if     mWaitFramInterval ne ?
      232                and not mBatchMode
      233             then
      234                wait-for go of frame waitfram pause mWaitFramInterval.
      235          end.
      236          else
      237             if     mWaitProcEvent
      238                and not mBatchMode
      239             then
      240                process events .
      241     end.
      242   end procedure.
      243      procedure waitfram-show-this:
      244         define input  parameter iInterval as int64 no-undo.
      245         define variable vtime as int64 no-undo.
      246         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      247         mWaitFramInterval = iInterval.
      248         run waitfram-show (substitute("&1&2 &3&4" ,
      249                                       mWaitFramTextBeg ,
      250                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      251                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      252                                       mWaitFramTextEnd
      253                                      )
      254                           ).
      255      end.
      256      procedure WaitFramRunPause:
      257         define input  parameter iInterval as dec no-undo.
      258         define variable vStart  as datetime-tz no-undo.
      259         define variable vend    as datetime-tz no-undo.
      260         define variable vint as int64 no-undo.
      261         define variable vOk as logical no-undo.
      262         vStart = now.
      263         vend   = vStart.
      264         publish "WaitFramPause" (iInterval,output vOk).
      265         vend   =  now.
      266         vint = vend - vStart.
      267         vint = iInterval - vint / 1000.
      268         if     not mWaitFramStop
      269            and (   vint > 0
      270                 or (    not vOk
      271                     and iInterval eq ?
      272                     )
      273                 )
      274         then
      275            run waitfram-show-this (iInterval).
      276         vend   =  now.
      277         vint = vend - vStart.
      278         vint = iInterval - vint / 1000.
      279         if     not mWaitFramStop
      280            and vint > 0
      281         then do:
      282            run gbl/pause.p (vint * 1000).
      283         end.
      284         if iInterval ne ?
      285         then
      286            publish "WaitFramStop".
      287         waitfram-check-timeout().
      288      end.
      289      procedure WaitFramWaitFor:
      290         define input  parameter iInterval as dec no-undo.
      291         assign
      292            mWaitFramStartProc   = now
      293            mWaitFramStopUser    = no
      294            mWaitFramStopTimeOut = no
      295         .
      296         block-wait:
      297         do while not mWaitFramStop:
      298            run WaitFramRunPause (iInterval).
      299            if  waitfram-check-timeout()
      300            then do:
      301               leave block-wait.
      302            end.
      303         end.
      304         run waitfram-hide.
      305      end.
      306   procedure waitfram-join :
      307     define input  parameter p-line-1  as character no-undo .
      308     define input  parameter p-line-2  as character no-undo .
      309     define input  parameter p-line-3  as character no-undo .
      310     define output parameter p-message as character no-undo .
      311     do
      312     on error undo, return error return-value
      313     :
      314       assign
      315         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      316                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      317                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      318       .
      319     end.
      320   end procedure.
      321   function waitfram-join-function returns character
      322     (input p-line-1 as character
      323     ,input p-line-2 as character
      324     ,input p-line-3 as character
      325     ).
      326     define variable v-message as character no-undo .
      327     run waitfram-join in this-procedure
      328       (input  p-line-1
      329       ,input  p-line-2
      330       ,input  p-line-3
      331       ,output v-message
      332       ) .
      333     return v-message .
      334   end function .
      335   define new global shared variable g#language as character no-undo .
      336   if g#language <> '' and g#language <> 'rus':U then do:
      337     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      338   end.
      339   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      340   procedure cur-time :
      341      define output parameter p-today as date      no-undo .
      342      define output parameter p-time  as integer   no-undo .
      343     do
      344     on error undo, return error
      345     :
      346       define variable v-date1 as date      no-undo .
      347       define variable v-date2 as date      no-undo .
      348       define variable v-time  as integer   no-undo .
      349       assign
      350         v-date1 = today
      351         v-time  = time
      352         v-date2 = today
      353       .
      354       if v-date1 <> v-date2
      355       then do:
      356         assign
      357           v-date1 = today
      358           v-time  = v-time
      359         .
      360       end.
      361       assign
      362         p-today = v-date1
      363         p-time  = v-time
      364       .
      365     end.
      366   end.
      367   function cur-time-date returns character
      368   :
      369     return string(today, '99/99/9999':U) .
      370   end.
      371   function cur-time-mjd returns decimal
      372   :
      373     define variable v-date as date      no-undo .
      374     define variable v-time as integer   no-undo .
      375     run cur-time in this-procedure
      376       (output v-date
      377       ,output v-time
      378       ) .
      379     return integer(v-date) - 2400002 + (v-time / 86400) .
      380   end.
      381   function cur-time-get-ending-index returns integer
      382   (input p-number as integer
      383   )
      384   :
      385     if p-number < 0
      386     or p-number = ?
      387     then do:
      388       return 1 .
      389     end.
      390     define variable v-rest as integer   no-undo .
      391     assign
      392       p-number = p-number modulo 100
      393     .
      394     if p-number < 20
      395     then do:
      396       assign
      397         v-rest = p-number
      398       .
      399     end.
      400     else do:
      401       assign
      402         v-rest = p-number modulo 10
      403       .
      404     end.
      405     case v-rest :
      406       when 1
      407       then do:
      408         return 2 .
      409       end.
      410       when 2 or
      411       when 3 or
      412       when 4
      413       then do:
      414         return 3 .
      415       end.
      416       otherwise do:
      417         return 1 .
      418       end.
      419     end case .
      420   end.
      421   procedure cur-time-mjd-to-date :
      422      define input  parameter i-mjd-diff as decimal no-undo.
      423      define output parameter o-Date     as date    no-undo.
      424      define output parameter o-Time     as integer no-undo.
      425      define variable v-day-number as integer   no-undo .
      426      if    i-mjd-diff < 0
      427         or i-mjd-diff = ?
      428      then do:
      429         return "?" .
      430      end.
      431      assign
      432         v-day-number = truncate(i-mjd-diff,0).
      433         o-Date = date(v-day-number + 2400002).
      434         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      435     .
      436   end.
      437   function cur-time-mjd-to-string returns character
      438   (input p-mjd-diff as decimal
      439   )
      440   :
      441     define variable v-day-number as integer   no-undo .
      442     define variable v-seconds    as integer   no-undo .
      443     define variable v-hour       as integer   no-undo .
      444     define variable v-min        as integer   no-undo .
      445     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      446     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      447     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      448     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      449     if p-mjd-diff < 0
      450     or p-mjd-diff = ?
      451     then do:
      452       return "?" .
      453     end.
      454     assign
      455       v-day-number = integer(truncate(p-mjd-diff,0))
      456       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      457     .
      458     if v-seconds > 86400
      459     then do:
      460       assign
      461         v-seconds = 86400 - 1
      462       .
      463     end.
      464     if v-seconds < 0
      465     then do:
      466       assign
      467         v-seconds = 0
      468       .
      469     end.
      470     assign
      471       v-hour = truncate(v-seconds / 3600, 0)
      472     .
      473     assign
      474       v-seconds = v-seconds modulo 3600
      475     .
      476     assign
      477       v-min = truncate(v-seconds / 60, 0)
      478     .
      479     assign
      480       v-seconds = v-seconds modulo 60
      481     .
      482     return
      483         (if v-day-number <> 0
      484           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      485           else ""
      486         )
      487       + (if v-day-number <> 0 or v-hour <> 0
      488           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      489           else ""
      490         )
      491       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      492           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      493           else ""
      494         )
      495       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      496       .
      497   end.
      498   function cur-time-string returns character
      499   :
      500     define variable v-date as date      no-undo .
      501     define variable v-time as integer   no-undo .
      502     run cur-time in this-procedure
      503       (output v-date
      504       ,output v-time
      505       ) .
      506     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      507   end.
      508   function cur-time-string-sec returns character
      509   :
      510     define variable v-date as date      no-undo .
      511     define variable v-time as integer   no-undo .
      512     run cur-time in this-procedure
      513       (output v-date
      514       ,output v-time
      515       ) .
      516     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      517   end.
      518   function cur-time-custom  returns character
      519   (input p-prefix as character
      520   ,input p-date-format as character
      521   ,input p-delimiter as character
      522   ,input p-time-format as character
      523   ,input p-suffix as character
      524   )
      525   :
      526     define variable v-date as date      no-undo .
      527     define variable v-time as integer   no-undo .
      528     run cur-time in this-procedure
      529       (output v-date
      530       ,output v-time
      531       ) .
      532     return
      533       p-prefix
      534       + string(v-date, p-date-format)
      535       + p-delimiter
      536       + string(v-time, p-time-format)
      537       + p-suffix
      538       .
      539   end.
      540   function cur-time-print  returns character
      541   :
      542     define variable v-date as date      no-undo .
      543     define variable v-time as integer   no-undo .
      544     run cur-time in this-procedure
      545       (output v-date
      546       ,output v-time
      547       ) .
      548     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      549   end.
      550   function cur-time-datetime returns datetime
      551   :
      552     define variable v-char as character no-undo .
      553     define variable v-datetime as datetime no-undo .
      554     v-char = cur-time-string().
      555     v-datetime = datetime(v-char).
      556     return  v-datetime.
      557   end.
      558   function cur-time-string-msec returns character
      559   :
      560     define variable v-date as datetime  no-undo .
      561     v-date = now.
      562     return string(v-date) .
      563   end.
      564   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      565   define  shared variable gdsgrp_recids      as character no-undo.
      566   define  shared variable fin-schet-recid    as character no-undo.
      567   define  shared variable v-d-report-handle  as handle    no-undo .
