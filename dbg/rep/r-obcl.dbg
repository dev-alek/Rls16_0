     1717   define variable  coast     like ub.stk-tot.sum-rubl   no-undo.
     1718   define variable  coast_r   like ub.stk-tot.sum-rubl   no-undo.
     1719   define variable  coast_v   like ub.stk-tot.sum-rubl   no-undo.
     1720   define variable  vat_r     like ub.stk-tot.sum-rubl   no-undo.
     1721   define variable  vat_v     like ub.stk-tot.sum-rubl   no-undo.
