     1745           valtype       = if (paytype = 1) then 0  else x-set_val_type.
     1746           run report-execute.
     1747   FUNCTION n-lavel RETURNS char (INPUT grp-name as char, INPUT lavel# as int ).
     1748   define variable  str  as char format "X(60)"  no-undo.
     1749   define variable  str2 as char no-undo.
     1750   define variable v-r as character no-undo init "" .
     1751   define variable  i#i as int no-undo.
     1752   STR = "".
     1753   repeat i#i =1 to lavel#:
     1754       if i#i =1 then str   = entry(1,grp-name, chr(47)) .
     1755       else do:
     1756           str2 = entry(i#i,grp-name, chr(47)) no-error.
     1757           if not error-status:error  and str2 <> "":u then
     1758                  str = str +  chr(47) +  entry(i#i,grp-name, chr(47)) no-error .
     1759           end.
     1760   end.
     1761   if str <> ? then do:
     1762   v-r = str + chr(47) .
     1763   end.
     1764   RETURN v-r .
     1765   END FUNCTION.
     1766   procedure report-execute :
     1767     if (valtype=0 and x-base-code=0)  or valtype=1
     1768                                   then   assign tprintrubl = yes .
     1769                                   else   assign tprintrubl = no .
     1770     run waitfram-show  in this-procedure ( 'Подождите ...' ) .
     1771   output stream outstream to value( string( session:temp-directory +
     1772                                        "rpt" + string( g#report-num ) ) )
     1773                                        page-size  value(reportpageheight) .
     1774      if xtog-obj  then do:
     1775               for each obj-list no-lock:
     1776                   x-store-type = obj-list.obj-type.
     1777                   x-store-code = obj-list.obj-code.
     1778                   run report-exec1.
     1779               end.
     1780                                                  end.
     1781     else run report-exec1.
     1782     hide   stream outstream frame zapas .
     1783     output stream outstream close.
     1784     run waitfram-hide in this-procedure  .
     1785     if Make-Excel then output stream ForExcel close.
     1786     define variable v-user-action as character no-undo .
     1787     define variable v-printed as logical   no-undo .
     1788     define variable disabledoptions as integer   no-undo .
     1789     define variable v-orient-page as character no-undo .
     1790     run How-name in this-procedure (
     1791         input ReportPageHeight,
     1792         input ReportPageWidth,
     1793         output v-orient-page )
     1794         .
     1795     if v-orient-page = "A4-lans":U then DisabledOptions = 8 .
     1796                                    else DisabledOptions = 0 .
     1797     run gbl/prnfilen.w
     1798       (input  ""
     1799       ,input  disabledoptions
     1800       ,input  string(session :temp-directory) + "rpt" + string( g#report-num )
     1801       ,input ReportFontNum
     1802       ,output v-user-action
     1803       ,output v-printed
     1804       ) .
     1805   end procedure.
     1806   procedure print-header :
     1807   if not firstline then  run display-title.
     1808       firstline = true .
     1809       if xtog-obj and   x-selectobject <> "currency":u   then  do:
     1810             PUT stream  OutStream  UNFORMATTED     "ПО ОБЪЕКТУ : " + caps(objname)  at 30 format "x(170)" skip.
     1811             if Make-Excel then  put   stream ForExcel unformatted   "ПО ОБЪЕКТУ : " + caps(objname) format "x(170)" skip.
     1812             end.
     1813        form with FRAME ZAPAS .  DOWN stream   OutStream 1 with FRAME ZAPAS .
     1814         run clear-b1 .
     1815         run clear-b2.
     1816         run clear-bi .
     1817         break_group = true.
     1818         break_group1 = true.
     1819      end procedure.
     1820   procedure print-footer :
     1821         if retclassify = "no-classify":u  then run u-line.
     1822          gds-zap-artic = "ИТОГО" .
     1823          run display-bi.
     1824          run u-line.
     1825          end procedure.
     1826   procedure u-line :
