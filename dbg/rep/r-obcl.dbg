     1684   define variable inperror as logical  no-undo .
     1685   define variable p        as integer no-undo init 0 .
     1686   define variable kk       as integer no-undo init 0 .
     1687   define variable old-page as integer no-undo .
     1688   define variable new-page as integer no-undo .
     1689   define variable rid-list as character no-undo .
     1690   define variable b1-prih        as   decimal extent 10 format "->>>>>>>>>>>9.<<<" no-undo.
