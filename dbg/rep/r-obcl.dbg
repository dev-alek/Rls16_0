     1700   define variable bi-prih        as   decimal extent 10 format "->>>>>>>>>>>9.<<<" no-undo.
     1701   define variable bi-rash        as   decimal extent 10 format "->>>>>>>>>>>9.<<<" no-undo.
     1702   define variable bi-vzvr        as   decimal extent 10 format "->>>>>>>>>>>9.<<<" no-undo.
     1703   define variable bi-vzvr-post   as   decimal extent 10 format "->>>>>>>>>>>9.<<<" no-undo.
     1704   define variable bi-discnt      as   decimal extent 10 format "->>>>>>>>>>>9.<<<" no-undo.
     1705   define variable  quantity1 like ub.stk-tot.fact-qnty  no-undo.
     1706   define variable  coast_r1  like ub.stk-tot.sum-rubl   no-undo.
     1707   define variable  coast_v1  like ub.stk-tot.sum-rubl   no-undo.
     1708   define variable  vat_r1    like ub.stk-tot.sum-rubl   no-undo.
     1709   define variable  vat_v1    like ub.stk-tot.sum-rubl   no-undo.
     1710   define variable  quantity2 like ub.stk-tot.fact-qnty  no-undo.
     1711   define variable  coast2    like ub.stk-tot.sum-rubl   no-undo.
     1712   define variable  coast_r2  like ub.stk-tot.sum-rubl   no-undo.
     1713   define variable  coast_v2  like ub.stk-tot.sum-rubl   no-undo.
     1714   define variable  vat_r2    like ub.stk-tot.sum-rubl   no-undo.
