      625   def
      626    shared
      627   temp-table  obj-list no-undo
      628     field obj-type like ub.clients.obj-type
      629     field obj-code like ub.clients.obj-code
      630     field obj-name like ub.clients.obj-name
      631     field obj-id   as integer
      632     field db-num   as integer
      633     index pi is primary unique obj-id
      634     index ie1 obj-type obj-code
      635     index ie2 obj-name
      636   .
      637   procedure create_obj-list :
      638      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      639      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      640      do
      641      on error undo, return error return-value
      642      :
      643         define buffer cli-obj for ub.clients .
      644         define variable p-var as integer no-undo .
      645         define buffer buf_obj-list for obj-list .
      646         find last buf_obj-list  use-index pi no-error .
      647         if available buf_obj-list
      648         then
      649            p-var = buf_obj-list.obj-id + 1.
      650         else
      651            p-var = 1.
      652         find first cli-obj where
      653                   cli-obj.obj-type = p-obj-type
      654               and cli-obj.obj-code = p-obj-code
      655         no-lock no-error.
      656         if available cli-obj
      657         then do:
      658            create buf_obj-list.
      659            assign
      660               buf_obj-list.obj-id   = p-var
      661               buf_obj-list.obj-code = cli-obj.obj-code
      662               buf_obj-list.obj-type = cli-obj.obj-type
      663               buf_obj-list.obj-name = cli-obj.obj-name
      664               buf_obj-list.db-num   = cli-obj.db-num
      665            .
      666         end.
      667      end.
      668   end.
