     1848                                     "или включена печать нулевого количества ( " + string( p-print-null-qnty ) + " )".
     1849           run writelog in this-procedure ( input log-file-name, input 3, input v-out-log-string ).
     1850           if v-print-cost-price = yes then do:
     1851             run writelog in this-procedure ( input log-file-name, input 4, input "Включена печать по учетным ценам" ).
     1852             display stream AktStr
     1853                     sym1  trim( string( ub.bar-code.b-code ) )                                 @ v-b-code
     1854                             ub.price-list.artic
