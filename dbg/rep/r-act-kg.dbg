     1718   procedure print-line-fact :
     1719     define variable v-out-log-string as character no-undo.
     1720     do on error undo, return error :
     1721       run writelog in this-procedure ( input log-file-name, input 1, input "Вызов программы печати строки АКТА" ).
     1722       if not can-find( first ub.gds-prt where ub.gds-prt.upper-code = v-gds-prt-node_code ) then do:
     1723         run writelog in this-procedure ( input log-file-name, input 2, "Пустая шкала" ).
     1724         if ( ub.price-list.doc-qnty <> 0 ) or ( p-print-null-qnty = yes ) then do:
     1725           assign v-out-log-string = "Количество по документу > 0 ( = " + string( ub.price-list.doc-qnty ) + " ) " +
     1726                                     "или включена печать нулевого количества ( " + string( p-print-null-qnty ) + " )".
     1727           run writelog in this-procedure ( input log-file-name, input 3, input v-out-log-string ).
     1728           if v-print-cost-price = yes then do:
     1729             run writelog in this-procedure ( input log-file-name, input 4, input "Включена печать по учетным ценам" ).
     1730             if p-sort-by-group = yes then do:
     1731     if v-shift-down = yes then do:
     1732       down stream AktStr 1 with frame Akt-Cost .
     1733       assign v-shift-down = no.
     1734     end.
     1735     if v-print-group = yes then do:
     1736       run writelog in this-procedure ( input log-file-name, input 4, input "r-act-kg.i Печать имени группы ( " + ub.goods.grp-name + " )" ).
     1737       put stream AktStr ub.goods.grp-name format "x(136)":U at 1.
     1738     end.
     1739             end.
     1740             display stream AktStr
     1741                     sym1  trim( string( ub.bar-code.b-code ) )                                 @ v-b-code
     1742                             ub.price-list.artic
     1743                             v-gds-prt-node_name                                                @ ub.goods.gds-name
     1744                             v-price-list_doc-qnty       when v-price-list_doc-qnty <> ?        @ ub.price-list.doc-qnty
     1745                             v-price-list_price-sale_new                                        @ ub.price-list.price-sale
     1746                           ( v-price-list_doc-qnty       * v-price-list_price-sale_new )        @ v-new-sum
     1747                             v-gds-obj_last-price
     1748                           ( v-price-list_doc-qnty       * v-gds-obj_last-price        )        @ v-old-sum
     1749                     100 * ( v-price-list_price-sale_new / v-gds-obj_last-price - 1    )
     1750                                                         when v-gds-obj_last-price <> 0         @ v-up-fact sym6
     1751             with frame Akt-Cost.
     1752             down stream AktStr 1 with frame Akt-Cost.
     1753     if hvrdtax( recid( ub.goods ) ) = yes then do:
     1754       run tax-name in this-procedure ( input 'rdt':U, output v-taxname ).
     1755       assign v-tax     = ub.price-list.road-tax * ub.price-list.doc-qnty
     1756              v-tax-sum = v-tax-sum + v-tax.
     1757       run writelog in this-procedure ( input log-file-name, input 5, input "r-act-kg.i Товар с третьим налогом ( "
     1758                                      + dtm-char( v-taxname ) + " ), определили значение ( " + dtm-char( string( v-tax ) )
     1759                                      + " ) и сумму всего ( " + dtm-char( string( v-tax-sum ) ) + " )" ).
     1760       for each ub.parts where
     1761                ub.parts.obj-type  = ub.price-list.obj-type  and
     1762                ub.parts.obj-code  = ub.price-list.obj-code  and
     1763                ub.parts.artic     = ub.price-list.artic     and
     1764                ub.parts.prod-type = ub.price-list.prod-type and
     1765                ub.parts.prod-code = ub.price-list.prod-code and
     1766                ub.parts.out-code  = ub.price-list.doc-num
     1767       break by ub.parts.road-tax-rubl
     1768       :
     1769         assign v-tax-parts-qnty = v-tax-parts-qnty + ub.parts.fact-qnty / ub.parts.cli-base-rate.
     1770         if last-of( ub.parts.road-tax-rubl ) then do:
     1771           assign v-parts_road-tax-rubl = ub.parts.road-tax-rubl * ub.parts.cli-base-rate.
