     1815                                      + dtm-char( v-taxname ) + " ), определили значение ( " + dtm-char( string( v-tax ) )
     1816                                      + " ) и сумму всего ( " + dtm-char( string( v-tax-sum ) ) + " )" ).
     1817       for each ub.parts where
     1818                ub.parts.obj-type  = ub.price-list.obj-type  and
     1819                ub.parts.obj-code  = ub.price-list.obj-code  and
     1820                ub.parts.artic     = ub.price-list.artic     and
     1821                ub.parts.prod-type = ub.price-list.prod-type and
     1822                ub.parts.prod-code = ub.price-list.prod-code and
     1823                ub.parts.out-code  = ub.price-list.doc-num
     1824       break by ub.parts.road-tax-rubl
     1825       :
     1826         assign v-tax-parts-qnty = v-tax-parts-qnty + ub.parts.fact-qnty / ub.parts.cli-base-rate.
     1827         if last-of( ub.parts.road-tax-rubl ) then do:
     1828           assign v-parts_road-tax-rubl = ub.parts.road-tax-rubl * ub.parts.cli-base-rate.
     1829           display stream AktStr "     В том числе"                            @ ub.price-list.artic
     1830                                 v-taxname                                     @ ub.goods.gds-name
     1831                                 v-tax-parts-qnty   when v-tax-parts-qnty <> ? @ ub.price-list.doc-qnty
     1832                                 v-parts_road-tax-rubl                         @ ub.price-list.price-sale
     1833                                 ub.parts.fact-qnty * ub.parts.road-tax-rubl   @ v-new-sum                sym1 sym6
     1834           with frame  Akt .
     1835           down stream AktStr 1 with frame  Akt .
     1836           assign v-line-counter   = v-line-counter + 1
     1837                  v-tax-parts-qnty = 0.
