     1856                             v-price-list_doc-qnty       when v-price-list_doc-qnty <> ?        @ ub.price-list.doc-qnty
     1857                             v-gds-obj_last-price
     1858                           ( v-price-list_doc-qnty       * v-gds-obj_last-price        )        @ v-old-sum
     1859                             v-price-list_price-sale_new                                        @ ub.price-list.price-sale
     1860                           ( v-price-list_doc-qnty       * v-price-list_price-sale_new )        @ v-new-sum
     1861                     100 * ( v-price-list_price-sale_new / v-gds-obj_last-price - 1    )
     1862                                                         when v-gds-obj_last-price <> 0         @ v-up-fact sym6
     1863             with frame Akt-Cost.
     1864             down stream AktStr 1 with frame Akt-Cost.
     1865     if hvrdtax( recid( ub.goods ) ) = yes then do:
     1866       run tax-name in this-procedure ( input 'rdt':U, output v-taxname ).
     1867       assign v-tax     = ub.price-list.road-tax * ub.price-list.doc-qnty
     1868              v-tax-sum = v-tax-sum + v-tax.
     1869       run writelog in this-procedure ( input log-file-name, input 5, input "r-act-kg.i Товар с третьим налогом ( "
     1870                                      + dtm-char( v-taxname ) + " ), определили значение ( " + dtm-char( string( v-tax ) )
     1871                                      + " ) и сумму всего ( " + dtm-char( string( v-tax-sum ) ) + " )" ).
