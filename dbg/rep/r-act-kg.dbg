        1   block-level on error undo, throw.
        2   define input parameter parparentproc     as widget-handle no-undo.
        3   define input parameter p-rec_id          as recid         no-undo.
        4   define input parameter p-doc-type        as character     no-undo.
        5   define input parameter p-price-celection as integer       no-undo.
        6   define input parameter p-print-null-qnty as logical       no-undo.
        7   define input parameter p-sort-by-group   as logical       no-undo.
        8   define variable vss-revision    as character no-undo initial "$Revision: aea5316774be, 0, rls $":U.
        9   define variable vss-author      as character no-undo initial "$Author: expertek $":U.
       10   define variable vss-date        as character no-undo initial "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U.
       11   define variable vss-workfile    as character no-undo initial "$Workfile: r-act-kg.p $":U.
       12   define variable vss-archive     as character no-undo initial "$Archive: rep/r-act-kg.p $":U.
       13   define variable vss-description as character no-undo initial "Печать акта и протокола переоценки топлива в кг (весовой учет топлива)":U.
       14   procedure vss-get-info :
       15     define output parameter p-vss-revision    like vss-revision    no-undo .
       16     define output parameter p-vss-author      like vss-author      no-undo .
       17     define output parameter p-vss-date        like vss-date        no-undo .
       18     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       19     define output parameter p-vss-archive     like vss-archive     no-undo .
       20     define output parameter p-vss-description like vss-description no-undo .
       21     assign
       22       p-vss-revision    = vss-revision
       23       p-vss-author      = vss-author
       24       p-vss-date        = vss-date
       25       p-vss-workfile    = vss-workfile
       26       p-vss-archive     = vss-archive
       27       p-vss-description = vss-description
       28     .
       29   end procedure.
       30   procedure vss-get-parameters :
       31     define output parameter p-vss-parameters as character no-undo .
       32   end procedure.
       33   define new global shared variable g#vssrevis-logger as handle    no-undo .
       34   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       35   define variable v-vssrevis-logger                   as handle    no-undo .
       36   procedure vss-logevent :
       37     define input  parameter p-extra-paramters as character no-undo .
       38     define variable v-vssrevis-parameters as character no-undo .
       39     do
       40     on error undo, return error return-value
       41     :
       42       if  valid-handle(v-vssrevis-logger)
       43       and v-vssrevis-logger :get-signature("logevent") <> ""
       44       then do:
       45         run vss-get-parameters in this-procedure
       46           (output v-vssrevis-parameters
       47           ).
       48         run logevent in v-vssrevis-logger
       49           (input vss-workfile
       50           ,input vss-revision
       51           ,input v-vssrevis-parameters
       52           ,input p-extra-paramters
       53           ).
       54       end.
       55     end.
       56   end procedure.
       57   assign
       58     v-vssrevis-logger = g#vssrevis-logger
       59   .
       60   if  valid-handle(v-vssrevis-logger)
       61   and v-vssrevis-logger :get-signature("logevent") <> ""
       62   then do:
       63     assign
       64       v-vssrevis-logevent = true
       65     .
       66     run vss-logevent in this-procedure (input vss-description) .
       67   end.
       68   define new global shared variable g#language as character no-undo .
       69   if g#language <> '' and g#language <> 'rus':U then do:
       70     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       71   end.
       72   define new global shared variable g#library  as handle no-undo .
       73   define new global shared variable g#library2 as handle no-undo .
       74   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       75   procedure cur-time :
       76      define output parameter p-today as date      no-undo .
       77      define output parameter p-time  as integer   no-undo .
       78     do
       79     on error undo, return error
       80     :
       81       define variable v-date1 as date      no-undo .
       82       define variable v-date2 as date      no-undo .
       83       define variable v-time  as integer   no-undo .
       84       assign
       85         v-date1 = today
       86         v-time  = time
       87         v-date2 = today
       88       .
       89       if v-date1 <> v-date2
       90       then do:
       91         assign
       92           v-date1 = today
       93           v-time  = v-time
       94         .
       95       end.
       96       assign
       97         p-today = v-date1
       98         p-time  = v-time
       99       .
      100     end.
      101   end.
      102   function cur-time-date returns character
      103   :
      104     return string(today, '99/99/9999':U) .
      105   end.
      106   function cur-time-mjd returns decimal
      107   :
      108     define variable v-date as date      no-undo .
      109     define variable v-time as integer   no-undo .
      110     run cur-time in this-procedure
      111       (output v-date
      112       ,output v-time
      113       ) .
      114     return integer(v-date) - 2400002 + (v-time / 86400) .
      115   end.
      116   function cur-time-get-ending-index returns integer
      117   (input p-number as integer
      118   )
      119   :
      120     if p-number < 0
      121     or p-number = ?
      122     then do:
      123       return 1 .
      124     end.
      125     define variable v-rest as integer   no-undo .
      126     assign
      127       p-number = p-number modulo 100
      128     .
      129     if p-number < 20
      130     then do:
      131       assign
      132         v-rest = p-number
      133       .
      134     end.
      135     else do:
      136       assign
      137         v-rest = p-number modulo 10
      138       .
      139     end.
      140     case v-rest :
      141       when 1
      142       then do:
      143         return 2 .
      144       end.
      145       when 2 or
      146       when 3 or
      147       when 4
      148       then do:
      149         return 3 .
      150       end.
      151       otherwise do:
      152         return 1 .
      153       end.
      154     end case .
      155   end.
      156   procedure cur-time-mjd-to-date :
      157      define input  parameter i-mjd-diff as decimal no-undo.
      158      define output parameter o-Date     as date    no-undo.
      159      define output parameter o-Time     as integer no-undo.
      160      define variable v-day-number as integer   no-undo .
      161      if    i-mjd-diff < 0
      162         or i-mjd-diff = ?
      163      then do:
      164         return "?" .
      165      end.
      166      assign
      167         v-day-number = truncate(i-mjd-diff,0).
      168         o-Date = date(v-day-number + 2400002).
      169         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      170     .
      171   end.
      172   function cur-time-mjd-to-string returns character
      173   (input p-mjd-diff as decimal
      174   )
      175   :
      176     define variable v-day-number as integer   no-undo .
      177     define variable v-seconds    as integer   no-undo .
      178     define variable v-hour       as integer   no-undo .
      179     define variable v-min        as integer   no-undo .
      180     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      181     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      182     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      183     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      184     if p-mjd-diff < 0
      185     or p-mjd-diff = ?
      186     then do:
      187       return "?" .
      188     end.
      189     assign
      190       v-day-number = integer(truncate(p-mjd-diff,0))
      191       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      192     .
      193     if v-seconds > 86400
      194     then do:
      195       assign
      196         v-seconds = 86400 - 1
      197       .
      198     end.
      199     if v-seconds < 0
      200     then do:
      201       assign
      202         v-seconds = 0
      203       .
      204     end.
      205     assign
      206       v-hour = truncate(v-seconds / 3600, 0)
      207     .
      208     assign
      209       v-seconds = v-seconds modulo 3600
      210     .
      211     assign
      212       v-min = truncate(v-seconds / 60, 0)
      213     .
      214     assign
      215       v-seconds = v-seconds modulo 60
      216     .
      217     return
      218         (if v-day-number <> 0
      219           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      220           else ""
      221         )
      222       + (if v-day-number <> 0 or v-hour <> 0
      223           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      224           else ""
      225         )
      226       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      227           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      228           else ""
      229         )
      230       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      231       .
      232   end.
      233   function cur-time-string returns character
      234   :
      235     define variable v-date as date      no-undo .
      236     define variable v-time as integer   no-undo .
      237     run cur-time in this-procedure
      238       (output v-date
      239       ,output v-time
      240       ) .
      241     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      242   end.
      243   function cur-time-string-sec returns character
      244   :
      245     define variable v-date as date      no-undo .
      246     define variable v-time as integer   no-undo .
      247     run cur-time in this-procedure
      248       (output v-date
      249       ,output v-time
      250       ) .
      251     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      252   end.
      253   function cur-time-custom  returns character
      254   (input p-prefix as character
      255   ,input p-date-format as character
      256   ,input p-delimiter as character
      257   ,input p-time-format as character
      258   ,input p-suffix as character
      259   )
      260   :
      261     define variable v-date as date      no-undo .
      262     define variable v-time as integer   no-undo .
      263     run cur-time in this-procedure
      264       (output v-date
      265       ,output v-time
      266       ) .
      267     return
      268       p-prefix
      269       + string(v-date, p-date-format)
      270       + p-delimiter
      271       + string(v-time, p-time-format)
      272       + p-suffix
      273       .
      274   end.
      275   function cur-time-print  returns character
      276   :
      277     define variable v-date as date      no-undo .
      278     define variable v-time as integer   no-undo .
      279     run cur-time in this-procedure
      280       (output v-date
      281       ,output v-time
      282       ) .
      283     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      284   end.
      285   function cur-time-datetime returns datetime
      286   :
      287     define variable v-char as character no-undo .
      288     define variable v-datetime as datetime no-undo .
      289     v-char = cur-time-string().
      290     v-datetime = datetime(v-char).
      291     return  v-datetime.
      292   end.
      293   function cur-time-string-msec returns character
      294   :
      295     define variable v-date as datetime  no-undo .
      296     v-date = now.
      297     return string(v-date) .
      298   end.
      299   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      300   define new shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      301   define new shared variable RepPathName        as character no-undo .
      302   define new shared variable PrintRubl          as logical   no-undo .
      303   function cross-list returns logical (
      304     input parfirst-stream  as character,
      305     input parsecond-stream as character,
      306     input pardelim         as character).
      307     if pardelim = ""
      308     or pardelim = ?
      309     then do:
      310       assign
      311         pardelim = ","
      312       .
      313     end.
      314     define variable vari            as integer no-undo .
      315     define variable varresult-cross as logical no-undo .
      316     assign
      317       varresult-cross = no
      318     .
      319     def var v-num-parfirst-stream as integer no-undo .
      320     assign
      321       v-num-parfirst-stream = num-entries(parfirst-stream, pardelim)
      322     .
      323     do vari = 1 to v-num-parfirst-stream
      324     :
      325       if lookup(entry(vari, parfirst-stream, pardelim)
      326                ,parsecond-stream
      327                ,pardelim
      328                ) > 0 then do:
      329         assign
      330           varresult-cross = yes
      331         .
      332         leave.
      333       end.
      334     end.
      335     return varresult-cross .
      336   end function.
      337   function hvrdtax return logical (input parrecid as recid):
      338   define variable varresult as logical no-undo.
      339   run hvrdtax-proc (input parrecid, output varresult).
      340   return varresult.
      341   end function.
      342   procedure hvrdtax-proc:
      343   define input  parameter parrecid  as recid   no-undo.
      344   define output parameter parresult as logical no-undo.
      345   define buffer bf_goods for ub.goods.
      346   define buffer bf_units for ub.units.
      347   define buffer rt_tax   for ub.tax.
      348   find first rt_tax   where rt_tax.tax-code    = integer('3':U) no-lock no-error.
      349   find first bf_goods where recid(bf_goods)    = parrecid              no-lock.
      350   find first bf_units where bf_units.unit-name = bf_goods.unit-base    no-lock.
      351   if available rt_tax and
      352       can-find(first ub.tax-units No-LOCK WHERE
      353                      ub.tax-units.tax-code = rt_tax.tax-code AND
      354                      LOOKUP(ub.tax-units.type, bf_units.type) > 0) then assign parresult = yes.
      355                                                       else assign parresult = no.
      356   end procedure.
      357   def var vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      358   procedure tax-name:
      359   define input  parameter pardef-tax  as character           no-undo.
      360   define output parameter parname-tax as character initial ? no-undo.
      361   define buffer bf_tax for ub.tax.
      362   do on error undo, return error :
      363      case pardef-tax:
      364         when 'vat':U then do:
      365                     find first bf_tax where bf_tax.tax-code = integer('1':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '1':U(не задействован)".
      366         end.
      367         when 'slt':U then do:
      368                     find first bf_tax where bf_tax.tax-code = integer('2':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '2':U(не задействован)".
      369         end.
      370         when 'rdt':U then do:
      371                     find first bf_tax where bf_tax.tax-code = integer('3':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '3':U(не задействован)".
      372         end.
      373         when 'exc':U then do:
      374                     find first bf_tax where bf_tax.tax-code = integer('4':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '4':U(не задействован)".
      375         end.
      376         otherwise do:
      377            return error "Задан неверный параметр " + pardef-tax + " .".
      378         end.
      379      end case.
      380   end.
      381   end procedure.
      382   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      383   FUNCTION determined RETURNS DECIMAL (INPUT parundefine-var AS DECIMAL):
      384      IF parundefine-var = ? THEN RETURN 0.00.
      385                             ELSE RETURN parundefine-var.
      386   END FUNCTION.
      387   FUNCTION dtm-char RETURNS CHARACTER (INPUT p-undef-char AS CHARACTER):
      388      IF p-undef-char = ? THEN do:
      389        RETURN "?".
      390      end.
      391      ELSE do:
      392        RETURN p-undef-char .
      393      end.
      394   END FUNCTION.
      395   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      396       def var log-file-name as char no-undo.
      397       assign
      398           log-file-name = 'r-act-kg.log'
      399       .
      400       if log-file-name <> "":U
      401       then do:
      402           if search( 'r-act-kg.log' ) = ?
      403           then do:
      404               output to value( 'r-act-kg.log' ).
      405               output close.
      406           end.
      407       end.
      408       DEF STREAM stm-log.
      409       PROCEDURE writelog:
      410       DEF INPUT PARAMETER p-file-name AS CHAR     NO-UNDO.
      411       DEF INPUT PARAMETER p-log-level AS INTEGER  NO-UNDO.
      412       DEF INPUT PARAMETER p-log-string  AS CHAR     NO-UNDO.
      413       if p-file-name <> ""
      414       then do:
      415       OUTPUT STREAM stm-log TO VALUE(p-file-name) APPEND.
      416           PUT STREAM stm-log UNFORMATTED chr(10).
      417           PUT STREAM stm-log UNFORMATTED (IF (p-log-level = 0 OR p-log-string = "&DLine"
      418                                           OR p-log-string = "&Line") THEN "" ELSE
      419                                           cur-time-string-sec() + " ").
      420           PUT STREAM stm-log UNFORMATTED
      421                   (IF p-log-string = "&Line" THEN FILL("-", 80)
      422                   ELSE IF p-log-string = "&DLine" THEN FILL("=", 80)
      423                   ELSE fill(" ", p-log-level * 2) + p-log-string).
      424       OUTPUT STREAM stm-log CLOSE.
      425       end.
      426       END PROCEDURE.
      427   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      428   define variable v-waitfram-action01         as character   no-undo .
      429   define variable v-waitfram-action02         as character   no-undo .
      430   define variable v-waitfram-action03         as character   no-undo .
      431   define variable mWaitFramTextBeg            as character   no-undo.
      432   define variable mWaitFramTextEnd            as character   no-undo.
      433   define variable mWaitFramView               as logical     no-undo.
      434   define variable mWaitProcEvent              as logical     no-undo init yes.
      435   define variable mWaitFramInterval           as integer     no-undo init 1 .
      436   define variable mWaitFramStop               as logical     no-undo.
      437   define variable mWaitFramStopUser           as logical     no-undo.
      438   define variable mWaitFramStopTimeOut        as logical     no-undo.
      439   define variable mWaitFramStartProc          as datetime-tz no-undo.
      440   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      441   define button B-WaitFramStop auto-end-key
      442        label "Стоп"
      443        size 10 by 1 tooltip "Остоновить процесс".
      444   define button B-viewProcInfo
      445        label "Информация"
      446        size 15 by 1 tooltip "Информация о процесс".
      447   define frame waitfram
      448     v-waitfram-action01 format "x(72)" no-label skip
      449     v-waitfram-action02 format "x(72)" no-label skip
      450     v-waitfram-action03 format "x(72)" no-label skip
      451     B-viewProcInfo
      452     B-WaitFramStop at row 4 col 30
      453     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      454     .
      455   define new global shared variable mBatchMode as logical no-undo init ?.
      456   define variable mFramBachModHandle as handle no-undo.
      457   mFramBachModHandle = frame waitfram:handle.
      458   define variable mFameOldVis as logical no-undo.
      459   define variable mVisCUrentVin as logical no-undo.
      460   if session:batch-mode
      461   then
      462      mBatchMode = yes.
      463   if mBatchMode = ? then do:
      464     mVisCUrentVin = current-window:visible.
      465     mFameOldVis = mFramBachModHandle:visible.
      466     mFramBachModHandle:visible  = yes.
      467     mBatchMode = mFramBachModHandle:visible ne yes.
      468     mFramBachModHandle:visible = mFameOldVis.
      469     current-window:visible = mVisCUrentVin.
      470   end.
      471    if  log-manager:logfile-name ne ?
      472     then DO:
      473         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      474         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      475         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      476     end.
      477   on choose of B-WaitFramStop in frame waitfram
      478   do:
      479     mWaitFramStop = yes.
      480     mWaitFramStopUser = yes.
      481   end.
      482   function waitfram-check-timeout returns logical():
      483      define variable vtime as int64 no-undo.
      484      if mWaitFramStopTimeOut
      485      then
      486         return yes.
      487      vtime = ( now - mWaitFramStartProc ) / 1000 .
      488      if     mWaitFramTimeOut ne ?
      489         and mWaitFramTimeOut ne 0
      490         and mWaitFramTimeOut lt vtime
      491      then do:
      492         mWaitFramStopTimeOut = yes.
      493      end.
      494      return mWaitFramStopTimeOut.
      495   end.
      496   procedure waitfram-hide :
      497     if not session:batch-mode
      498     then do
      499     on error undo, return error return-value
      500     :
      501       pause 0 before-hide .
      502       if not mBatchMode then
      503         hide frame waitfram .
      504     if     not mWaitFramView
      505        and mWaitProcEvent
      506     then
      507       process events .
      508     end.
      509   end procedure.
      510   procedure waitfram-show :
      511     define input  parameter p-message as character no-undo .
      512     define variable v-left-margin as integer   no-undo .
      513     if not session:batch-mode
      514     then do
      515     on error undo, return error return-value
      516     :
      517       if length(p-message) <= 70 then do:
      518         assign
      519           v-left-margin = integer((70 - length(p-message)) / 2)
      520         .
      521         assign
      522           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      523         .
      524         assign
      525           v-waitfram-action01 = " "
      526           v-waitfram-action02 = " "
      527                                    + fill(" ", v-left-margin)
      528                                    + p-message
      529           v-waitfram-action03 = " "
      530         .
      531       end.
      532       else do:
      533         define variable vRindex1 as integer no-undo.
      534         define variable vRindex2 as integer no-undo.
      535         vRindex1 = r-index(p-message," ",70).
      536         if vRindex1 = 0
      537         then
      538            vRindex1 = 70.
      539         if length(p-message)  <= vRindex1 + 70 then do:
      540           assign
      541             v-waitfram-action01 = " "
      542             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      543             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      544           .
      545         end.
      546         else do:
      547           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      548           if vRindex2 <= vRindex1
      549           then
      550              vRindex2 = vRindex1 + 70.
      551           assign
      552             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      553             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      554             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      555           .
      556         end.
      557       end.
      558       B-viewProcInfo:visible   in frame waitfram = no.
      559       B-viewProcInfo:sensitive in frame waitfram = no.
      560       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      561       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      562       if  (   mWaitFramView
      563          or  mWaitProcEvent)
      564          and not mBatchMode
      565       then
      566          display
      567             v-waitfram-action01 skip
      568             v-waitfram-action02 skip
      569             v-waitfram-action03 skip
      570          with frame waitfram .
      571       if     mWaitFramView
      572          then do:
      573             if     mWaitFramInterval ne ?
      574                and not mBatchMode
      575             then
      576                wait-for go of frame waitfram pause mWaitFramInterval.
      577          end.
      578          else
      579             if     mWaitProcEvent
      580                and not mBatchMode
      581             then
      582                process events .
      583     end.
      584   end procedure.
      585      procedure waitfram-show-this:
      586         define input  parameter iInterval as int64 no-undo.
      587         define variable vtime as int64 no-undo.
      588         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      589         mWaitFramInterval = iInterval.
      590         run waitfram-show (substitute("&1&2 &3&4" ,
      591                                       mWaitFramTextBeg ,
      592                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      593                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      594                                       mWaitFramTextEnd
      595                                      )
      596                           ).
      597      end.
      598      procedure WaitFramRunPause:
      599         define input  parameter iInterval as dec no-undo.
      600         define variable vStart  as datetime-tz no-undo.
      601         define variable vend    as datetime-tz no-undo.
      602         define variable vint as int64 no-undo.
      603         define variable vOk as logical no-undo.
      604         vStart = now.
      605         vend   = vStart.
      606         publish "WaitFramPause" (iInterval,output vOk).
      607         vend   =  now.
      608         vint = vend - vStart.
      609         vint = iInterval - vint / 1000.
      610         if     not mWaitFramStop
      611            and (   vint > 0
      612                 or (    not vOk
      613                     and iInterval eq ?
      614                     )
      615                 )
      616         then
      617            run waitfram-show-this (iInterval).
      618         vend   =  now.
      619         vint = vend - vStart.
      620         vint = iInterval - vint / 1000.
      621         if     not mWaitFramStop
      622            and vint > 0
      623         then do:
      624            run gbl/pause.p (vint * 1000).
      625         end.
      626         if iInterval ne ?
      627         then
      628            publish "WaitFramStop".
      629         waitfram-check-timeout().
      630      end.
      631      procedure WaitFramWaitFor:
      632         define input  parameter iInterval as dec no-undo.
      633         assign
      634            mWaitFramStartProc   = now
      635            mWaitFramStopUser    = no
      636            mWaitFramStopTimeOut = no
      637         .
      638         block-wait:
      639         do while not mWaitFramStop:
      640            run WaitFramRunPause (iInterval).
      641            if  waitfram-check-timeout()
      642            then do:
      643               leave block-wait.
      644            end.
      645         end.
      646         run waitfram-hide.
      647      end.
      648   procedure waitfram-join :
      649     define input  parameter p-line-1  as character no-undo .
      650     define input  parameter p-line-2  as character no-undo .
      651     define input  parameter p-line-3  as character no-undo .
      652     define output parameter p-message as character no-undo .
      653     do
      654     on error undo, return error return-value
      655     :
      656       assign
      657         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      658                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      659                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      660       .
      661     end.
      662   end procedure.
      663   function waitfram-join-function returns character
      664     (input p-line-1 as character
      665     ,input p-line-2 as character
      666     ,input p-line-3 as character
      667     ).
      668     define variable v-message as character no-undo .
      669     run waitfram-join in this-procedure
      670       (input  p-line-1
      671       ,input  p-line-2
      672       ,input  p-line-3
      673       ,output v-message
      674       ) .
      675     return v-message .
      676   end function .
      677   define new global shared variable g#lib-trn  as handle no-undo .
      678   define new global shared variable g#lib-trn2 as handle no-undo .
      679   define new global shared variable g#lib-trn3 as handle no-undo .
      680   define new global shared variable g#lib-trn4 as handle no-undo .
      681   FUNCTION RedLine RETURNS CHARACTER ( INPUT i-str AS CHARACTER ) :
      682     DEFINE VARIABLE v-str AS CHARACTER NO-UNDO.
      683     RUN get-red-line IN THIS-PROCEDURE ( INPUT i-str, OUTPUT v-str ) NO-ERROR.
      684     RETURN ( IF ERROR-STATUS :ERROR THEN i-str ELSE v-str ).
      685   END FUNCTION.
      686   PROCEDURE get-red-line :
      687     DEFINE  INPUT PARAMETER p-str AS CHARACTER NO-UNDO.
      688     DEFINE OUTPUT PARAMETER p-res AS CHARACTER NO-UNDO.
      689     DO ON ERROR UNDO, RETURN ERROR :
      690       ASSIGN p-res = CAPS( SUBSTRING( p-str, 1, 1 ) ) + LC( SUBSTRING( p-str, 2 ) ).
      691     END.
      692   END PROCEDURE.
      693   FUNCTION Roubles RETURNS CHARACTER ( INPUT i-sum AS DECIMAL ) :
      694     DEFINE VARIABLE Rouble AS CHARACTER NO-UNDO.
      695     RUN get-roubles IN THIS-PROCEDURE ( INPUT i-sum, OUTPUT Rouble ) NO-ERROR.
      696     RETURN ( IF ERROR-STATUS :ERROR THEN "":U ELSE Rouble ).
      697   END FUNCTION.
      698   PROCEDURE get-roubles :
      699     DEFINE  INPUT PARAMETER p-sum AS DECIMAL   NO-UNDO.
      700     DEFINE OUTPUT PARAMETER p-rub AS CHARACTER NO-UNDO.
      701     DEFINE VARIABLE Word   AS CHARACTER NO-UNDO.
      702     DEFINE VARIABLE jj     AS INTEGER   NO-UNDO.
      703     DEFINE VARIABLE j_last AS INTEGER   NO-UNDO.
      704     DEFINE VARIABLE l_prev AS LOGICAL   NO-UNDO.
      705     DO ON ERROR UNDO, RETURN ERROR :
      706       ASSIGN Word   = STRING( ABS( p-sum ), "999999999999999999999999999999.99":U )
      707              jj     = LENGTH( Word )
      708              j_last = INTEGER( SUBSTRING( Word, jj - 3, 1 ) )
      709              l_prev =        ( SUBSTRING( Word, jj - 4, 1 ) = "1" ).
      710       IF      j_last = 1                THEN DO: ASSIGN p-rub = ( IF l_prev = YES THEN "рублей" ELSE "рубль" ).  END.
      711       ELSE IF j_last > 1 AND j_last < 5 THEN DO: ASSIGN p-rub = ( IF l_prev = YES THEN "рублей" ELSE "рубля" ). END.
      712                                         ELSE DO: ASSIGN p-rub = "рублей". END.
      713     END.
      714   END PROCEDURE.
      715   FUNCTION Copecks RETURNS CHARACTER ( INPUT i-sum AS DECIMAL ) :
      716     DEFINE VARIABLE Copeck AS CHARACTER NO-UNDO.
      717     RUN get-copecks IN THIS-PROCEDURE ( INPUT i-sum, OUTPUT Copeck ) NO-ERROR.
      718     RETURN ( IF ERROR-STATUS :ERROR THEN "":U ELSE Copeck ).
      719   END FUNCTION.
      720   PROCEDURE get-copecks :
      721     DEFINE  INPUT PARAMETER p-sum AS DECIMAL   NO-UNDO.
      722     DEFINE OUTPUT PARAMETER p-kop AS CHARACTER NO-UNDO.
      723     DEFINE VARIABLE Word   AS CHARACTER NO-UNDO.
      724     DEFINE VARIABLE jj     AS INTEGER   NO-UNDO.
      725     DEFINE VARIABLE j_last AS INTEGER   NO-UNDO.
      726     DEFINE VARIABLE l_prev AS LOGICAL   NO-UNDO.
      727     DO ON ERROR UNDO, RETURN ERROR :
      728       ASSIGN  Word   = STRING( ABS( p-sum ), "999999999999999999999999999999.99":U )
      729               jj     = LENGTH( Word )
      730               j_last = INTEGER( SUBSTRING( Word, jj,     1 ) )
      731               l_prev =        ( SUBSTRING( Word, jj - 1, 1 ) = "1" ).
      732       IF           j_last = 1                THEN DO:
      733         ASSIGN p-kop = ( IF l_prev = YES THEN "копеек" ELSE "копейка" ).
      734       END. ELSE IF j_last > 1 AND j_last < 5 THEN DO:
      735         ASSIGN p-kop = ( IF l_prev = YES THEN "копеек" ELSE "копейки" ).
      736       END.                                   ELSE DO:
      737         ASSIGN p-kop = "копеек".
      738       END.
      739     END.
      740   END PROCEDURE.
      741   FUNCTION get-decade-word RETURNS CHARACTER ( INPUT i-dec AS INTEGER, INPUT i-num AS INTEGER ) :
      742     DEFINE VARIABLE v-grade AS CHARACTER NO-UNDO.
      743     RUN get-number-grade IN THIS-PROCEDURE ( INPUT i-dec, INPUT i-num, OUTPUT v-grade ) NO-ERROR.
      744     RETURN ( IF ERROR-STATUS :ERROR THEN "":U ELSE v-grade ).
      745   END FUNCTION.
      746   FUNCTION Word-Sum RETURNS CHARACTER ( INPUT i-sum AS DECIMAL ) :
      747     DEFINE VARIABLE OutSum AS CHARACTER NO-UNDO.
      748     RUN conv-sum-to-word IN THIS-PROCEDURE ( INPUT i-sum, OUTPUT OutSum ) NO-ERROR.
      749     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE OutSum ).
      750   END FUNCTION.
      751   PROCEDURE get-number-grade :
      752     DEFINE  INPUT PARAMETER p-dec AS INTEGER   NO-UNDO.
      753     DEFINE  INPUT PARAMETER p-num AS INTEGER   NO-UNDO.
      754     DEFINE OUTPUT PARAMETER p-res AS CHARACTER NO-UNDO.
      755     DEFINE VARIABLE v-list AS CHARACTER NO-UNDO.
      756     DO ON ERROR UNDO, RETURN ERROR :
      757       IF      p-dec = 1 THEN DO: ASSIGN v-list = ",один,два,три,четыре,пять,шесть,семь,восемь,девять".    END.
      758       ELSE IF p-dec = 2 THEN DO: ASSIGN v-list = "десять,одиннадцать,двенадцать,тринадцать,четырнадцать,пятнадцать,шестнадцать,семнадцать,восемнадцать,девятнадцать".    END.
      759       ELSE IF p-dec = 3 THEN DO: ASSIGN v-list = ",,двадцать,тридцать,сорок,пятьдесят,шестьдесят,семьдесят,восемьдесят,девяносто".   END.
      760       ELSE IF p-dec = 4 THEN DO: ASSIGN v-list = ",сто,двести,триста,четыреста,пятьсот,шестьсот,семьсот,восемьсот,девятьсот".  END.
      761                         ELSE DO: ASSIGN v-list = ",,,,,,,,,". END.
      762       ASSIGN p-res = ENTRY( p-num + 1, v-list ).
      763     END.
      764   END PROCEDURE.
      765   PROCEDURE conv-sum-to-word :
      766     DEFINE  INPUT PARAMETER p-sum AS DECIMAL   NO-UNDO.
      767     DEFINE OUTPUT PARAMETER p-res AS CHARACTER NO-UNDO.
      768     DEFINE VARIABLE Formatted  AS CHARACTER NO-UNDO.
      769     DEFINE VARIABLE Word       AS CHARACTER NO-UNDO.
      770     DEFINE VARIABLE OutSum     AS CHARACTER NO-UNDO.
      771     DEFINE VARIABLE jj         AS INTEGER   NO-UNDO.
      772     DO ON ERROR UNDO, RETURN ERROR :
      773       ASSIGN Formatted = STRING( ABS( p-sum ), "999999999999999.99":U ) NO-ERROR.
      774       IF ERROR-STATUS :ERROR THEN DO:
      775         ASSIGN p-res = ?.
      776         UNDO, RETURN ERROR.
      777       END.
      778       DO jj = ( LENGTH( Formatted ) - 3 ) TO 3 BY -3 :
      779         IF SUBSTRING( Formatted, jj - 2, 3 ) = "000" THEN DO: NEXT. END.
      780         IF jj < 15 THEN DO:
      781           ASSIGN Word = ENTRY( jj, ",,триллион,,,миллиард,,,миллион,,,тысяч" ).
      782           IF SUBSTRING( Formatted, jj,     1 )  = "1" AND
      783              SUBSTRING( Formatted, jj - 1, 1 ) <> "1" AND jj = 12 THEN DO: ASSIGN Word = TRIM( Word ) + "а". END.
      784           IF SUBSTRING( Formatted, jj, 1 ) = "2" OR
      785              SUBSTRING( Formatted, jj, 1 ) = "3" OR
      786              SUBSTRING( Formatted, jj, 1 ) = "4" THEN DO:
      787             IF jj = 12 THEN DO:
      788               IF SUBSTRING( Formatted, jj - 1, 1 ) <> "1" THEN DO: ASSIGN Word = TRIM( Word ) + "и". END.
      789             END.       ELSE DO:
      790               IF SUBSTRING( Formatted, jj - 1, 1 ) <> "1" THEN DO: ASSIGN Word = TRIM( Word ) + "а". END.
      791             END.
      792           END.
      793           IF ( SUBSTRING( Formatted, jj,     1 ) <> "1" AND
      794                SUBSTRING( Formatted, jj,     1 ) <> "2" AND
      795                SUBSTRING( Formatted, jj,     1 ) <> "3" AND
      796                SUBSTRING( Formatted, jj,     1 ) <> "4" AND jj <> 12 ) OR
      797              ( SUBSTRING( Formatted, jj - 1, 1 )  = "1" AND jj <  12 ) THEN DO: ASSIGN Word = TRIM( Word ) + "ов". END.
      798           IF Word <> "":U THEN DO: ASSIGN OutSum = TRIM( Word ) + " ":U + TRIM( OutSum ). END.
      799         END.
      800         IF SUBSTRING( Formatted, jj - 1, 1 ) <> "1" THEN DO:
      801           IF      jj = 12 AND SUBSTRING( Formatted, jj, 1 ) = "1" THEN DO: ASSIGN Word = "одна". END.
      802           ELSE IF jj = 12 AND SUBSTRING( Formatted, jj, 1 ) = "2" THEN DO: ASSIGN Word = "две".  END.
      803           ELSE DO: ASSIGN Word = get-decade-word( 1, INTEGER( SUBSTRING( Formatted, jj, 1 ) ) ). END.
      804           IF Word <> "":U THEN DO: ASSIGN OutSum = TRIM( Word ) + " ":U + TRIM( OutSum ). END.
      805           ASSIGN Word = get-decade-word( 3, INTEGER( SUBSTRING( Formatted, jj - 1, 1 ) ) ).
      806         END.                                        ELSE DO:
      807           ASSIGN Word = get-decade-word( 2, INTEGER( SUBSTRING( Formatted, jj,     1 ) ) ).
      808         END.
      809         IF Word <> "":U THEN DO: ASSIGN OutSum = TRIM( Word ) + " ":U + TRIM( OutSum ). END.
      810         ASSIGN Word = get-decade-word( 4, INTEGER( SUBSTRING( Formatted, jj - 2, 1 ) ) ).
      811         IF Word <> "":U THEN DO: ASSIGN OutSum = TRIM( Word ) + " ":U + TRIM( OutSum ). END.
      812       END.
      813       ASSIGN OutSum = CAPS( SUBSTRING( OutSum, 1, 1 ) ) + SUBSTRING( OutSum, 2 ).
      814       IF OutSum = "":U AND TRUNCATE( p-sum, 0 ) = 0 THEN DO: ASSIGN OutSum = "Ноль". END.
      815       ASSIGN p-res = TRIM( OutSum ).
      816     END.
      817   END PROCEDURE.
      818   FUNCTION Total-Word RETURNS CHARACTER ( INPUT i-sum AS DECIMAL, INPUT i-curr AS CHARACTER, INPUT i-part AS CHARACTER ) :
      819     DEFINE VARIABLE word_sum AS CHARACTER NO-UNDO.
      820     RUN get-total-word IN THIS-PROCEDURE ( INPUT i-sum, INPUT i-curr, INPUT i-part, OUTPUT word_sum ) NO-ERROR.
      821     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE word_sum ).
      822   END FUNCTION.
      823   PROCEDURE get-total-word :
      824     DEFINE  INPUT PARAMETER p-sum  AS DECIMAL   NO-UNDO.
      825     DEFINE  INPUT PARAMETER p-curr AS CHARACTER NO-UNDO.
      826     DEFINE  INPUT PARAMETER p-part AS CHARACTER NO-UNDO.
      827     DEFINE OUTPUT PARAMETER p-word AS CHARACTER NO-UNDO.
      828     DO ON ERROR UNDO, RETURN ERROR :
      829       ASSIGN p-word = Word-Sum( p-sum ).
      830                  ASSIGN p-word = ( IF p-sum < 0 THEN "- " ELSE "":U ) + TRIM(
      831                         RedLine( p-word )
      832                  ) +
      833                         " ":U + p-curr + " ":U +
      834                         SUBSTRING( STRING( ABS( p-sum ), "999999999999999999999999999999.99" ), 32, 2 ) +
      835                         " ":U + p-part + ".".
      836                           END.
      837   END PROCEDURE.
