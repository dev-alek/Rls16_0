     1144   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
     1145     (
     1146        input ub.price-list.artic
     1147     ,  input ub.price-list.prod-type
     1148     ,  input ub.price-list.prod-code
     1149     , output is-petrol
     1150     , output is-pieces
     1151     ) no-error.
     1152       if error-status :error or is-petrol <> yes or is-pieces <> no then do: next. end.
     1153       assign v-have-petrolium = yes.
     1154       leave.
     1155     end.
     1156     if v-have-petrolium <> yes then do:
     1157       message "Нет топливных товаров (r-act-kg.p)." view-as alert-box error.
     1158       return.
