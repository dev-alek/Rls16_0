     1192   output stream AktStr to value( string( session:temp-directory +
     1193                                        "rpt" + string( g#report-num ) ) )
     1194                                        page-size 62 .
     1195     find buf_clients no-lock where
     1196          buf_clients.obj-type = 'орг':U and
