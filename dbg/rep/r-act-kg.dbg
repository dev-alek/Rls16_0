      968             v-cntxp-chk-pay         = bf-cntxp_shop.chk-pay
      969             v-cntxp-retail          = bf-cntxp_sysconf.ord-prt
      970             v-cntxp-osn-base        = bf-cntxp_sysconf.osn-base
      971             .
      972         end.
      973       end case.
      974     end.
