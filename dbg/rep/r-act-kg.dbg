     1199     os-delete log-file-name.
     1200     run writelog in this-procedure ( input log-file-name, input 0, input "&Line" ).
     1201     if ub.price-doc.status_ = 'акт':U then do:
     1202       put stream AktStr space( 25 ) string( "А К Т  переоценки  по  остаткам  " +
     1203         ( if available ub.trn-doc then string( "документу N " + ub.trn-doc.doc-code + "  по  " )
     1204                                   else " " ) + ub.clients.obj-name ) format "x(90)":U skip( 1 ).
     1205       run writelog in this-procedure ( input log-file-name, input 1, input "Печать акта № " + string( ub.price-doc.doc-num )
     1206                                      + " по док-ту № " + "  от  " + string( ub.price-doc.doc-date, "99.99.9999":U )
     1207                                      + "  по  " + ub.clients.obj-name ).
     1208     end.
     1209     else do:
     1210       put stream AktStr space( 20 ) string( "П Р И К А З   о  переоценке  товаров  " +
     1211         ( if available ub.trn-doc then string( "по документу N " + ub.trn-doc.doc-code )
     1212                                   else " " ) + "  в  " + ub.clients.obj-name ) format "x(110)":U skip( 1 ).
     1213       run writelog in this-procedure ( input log-file-name, input 1, input "Печать приказа № " + string( ub.price-doc.doc-num )
     1214                                      + " по док-ту № " + "  от  " + string( ub.price-doc.doc-date, "99.99.9999":U )
     1215                                      + "  в  " + ub.clients.obj-name ).
     1216     end.
     1217     put stream AktStr "Номер " ub.price-doc.doc-num "  от  " ub.price-doc.doc-date format "99.99.9999":U skip( 1 ).
     1218     form header v-single-line format "x(136)":U at  1 skip
     1219                 "Продолжение - на следующей странице" at 30 skip
     1220     with frame Bottomframe width 160 page-bottom no-labels no-box.
     1221     view stream AktStr frame bottomframe.
     1222     if ub.price-doc.status_ = 'акт':U then do:
     1223       run writelog in this-procedure ( input log-file-name, input 1, input "Документ закрыт до факта" ).
     1224       if v-print-cost-price = yes then do: form with frame Akt-Cost. end.
     1225                                   else do: form with frame Akt.      end.
