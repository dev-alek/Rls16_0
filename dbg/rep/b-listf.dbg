      574   define variable var-report-r-b as character no-undo .
      575   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      576   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      577     (output var-report-r-b
      578     )  .
      579   procedure proc-alt-shift-f2:
      580     if not ibs.th.gbl.gbl-var:rcode
      581   then
      582     run gbl\inidebug.p .
      583   end.
      584   procedure proc-alt-shift-f3:
      585     run gbl/prvssinf.p
      586       ( input this-procedure
      587       ) .
      588   end.
      589   define variable v-inform-launched as logical no-undo initial false .
      590   procedure proc-alt-shift-f4:
      591     define variable v-action as character no-undo .
      592     if v-inform-launched = false then do:
      593       assign
      594         v-inform-launched = true
      595       .
      596       run gbl/d-inform.w
      597         (  input self
      598         ,  input this-procedure
      599         , output v-action
      600         ) no-error .
      601       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      602       assign
      603         v-inform-launched = false
      604       .
      605     end.
      606   end.
      607   procedure proc-alt-f1:
      608     run gbl/corrhelp.p
      609       (input this-procedure
      610       ) .
      611   end .
      612   on alt-shift-f2 anywhere do:
      613     run proc-alt-shift-f2.
      614   end.
      615   on alt-shift-f3 anywhere do:
      616     run proc-alt-shift-f3 in this-procedure .
      617   end.
      618   on alt-shift-f4 anywhere do:
      619     run proc-alt-shift-f4 in this-procedure.
      620   end.
      621   on alt-f1 anywhere do:
      622     run proc-alt-f1 in this-procedure .
      623   end.
      624   DEFINE TEMP-TABLE List-field NO-UNDO
      625          field id as int
      626          field naim as char
      627          field use as log
      628          field make-correct as log
      629          field w-col as int
      630          .
      631   RUN set-attribute-list (
      632       'Keys-Accepted = "",
      633        Keys-Supplied = ""':U).
      634   RUN set-attribute-list (
      635       'SortBy-Options = ""':U).
      636   DEFINE BUTTON B-demark
      637        LABEL "-"
      638        SIZE 3 BY 1 TOOLTIP "Снять все отметки".
      639   DEFINE BUTTON B-mark
      640        LABEL "+"
      641        SIZE 3 BY 1 TOOLTIP "Отметить все колонки для печати".
      642   DEFINE BUTTON b-mark-2
      643        LABEL "+-":L
      644        SIZE 3 BY 1 TOOLTIP "Отметить текущее поле для печати"
      645        BGCOLOR 8 .
      646   DEFINE VARIABLE w-all AS INTEGER FORMAT ">>>":R3 INITIAL 0
      647        LABEL "Итого ширина отчета"
      648         VIEW-AS TEXT
      649        SIZE 4.38 BY .67
      650        FGCOLOR 4  NO-UNDO.
      651   DEFINE VARIABLE w-all-1 AS INTEGER FORMAT ">>>":R3 INITIAL 0
      652         VIEW-AS TEXT
      653        SIZE 4.25 BY .67 TOOLTIP "Ширина отчета со всеми колонками"
      654        FGCOLOR 1  NO-UNDO.
      655   DEFINE RECTANGLE RECT-1
      656        EDGE-PIXELS 1 GRAPHIC-EDGE
      657        SIZE 30.13 BY .08
      658        BGCOLOR 0 .
      659   DEFINE QUERY br_table FOR
      660         List-field SCROLLING.
      661   DEFINE BROWSE br_table
      662     QUERY br_table NO-LOCK DISPLAY
      663         List-field.use COLUMN-LABEL "П" FORMAT "+/" LABEL-FGCOLOR 4
      664         List-field.Naim COLUMN-LABEL "Наименование":C43 FORMAT "X(43)" LABEL-FGCOLOR 4
      665         List-field.w-col COLUMN-LABEL "Ширина" FORMAT ">>>" LABEL-FGCOLOR 4
      666       WITH NO-ASSIGN SEPARATORS SIZE 56 BY 15.83
      667            BGCOLOR 15 .
      668   DEFINE FRAME F-Main
      669        br_table AT ROW 1 COL 1
      670        B-mark AT ROW 1.08 COL 57.38
      671        B-demark AT ROW 2.08 COL 57.38
      672        b-mark-2 AT ROW 3.08 COL 57.38
      673        w-all AT ROW 17.5 COL 55.01 RIGHT-ALIGNED
      674        w-all-1 AT ROW 17.5 COL 59.38 RIGHT-ALIGNED NO-LABEL
      675        RECT-1 AT ROW 17 COL 30
      676       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
      677            SIDE-LABELS NO-UNDERLINE THREE-D
      678            AT COL 1 ROW 1 SCROLLABLE
      679            BGCOLOR 8 FGCOLOR 0 .
      680   DEFINE VARIABLE adm-sts           AS LOGICAL NO-UNDO.
      681   DEFINE VARIABLE adm-brs-in-update AS LOGICAL NO-UNDO INIT no.
      682   DEFINE VARIABLE adm-brs-initted   AS LOGICAL NO-UNDO INIT no.
      683   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
      684   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
      685   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
      686   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
      687   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
      688   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
      689   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
      690   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
      691         adm-object-hdl = FRAME F-Main:HANDLE.
      692   RUN ensure-broker.
      693   THIS-PROCEDURE:ADM-DATA =
      694        'ADM1.1~`':U +
      695        'SmartObject~`':U +
      696        '~`':U +
      697        'YES~`':U +
      698        '~`':U +
      699        'List-field~`':U +
      700        'List-field~`':U +
      701        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
      702           + "~`":U +
      703        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add,SortBy-Case~`':U +
      704        'Record-Source,Record-Target,TableIO-Target~`':U +
      705        '~`':U +
      706        '~`~`~`~`~`~`~`~`~`~`~`':U +
      707        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
      708            THEN "^^":U
      709        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
      710             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
      711   PROCEDURE adm-apply-entry :
      712     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      713   END PROCEDURE.
      714   PROCEDURE adm-destroy :
      715    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      716   END PROCEDURE.
      717   PROCEDURE adm-disable :
      718       DISABLE br_table B-mark RECT-1 B-demark b-mark-2 w-all w-all-1 WITH FRAME F-Main.
      719       RUN dispatch ('disable-fields':U).
      720       RUN set-attribute-list ('ENABLED=no':U).
      721       RETURN.
      722   END PROCEDURE.
      723   PROCEDURE adm-edit-attribute-list :
      724         RUN adm/support/browserd.w (INPUT THIS-PROCEDURE).
      725         RETURN.
      726   END PROCEDURE.
      727   PROCEDURE adm-enable :
      728       ENABLE UNLESS-HIDDEN br_table B-mark RECT-1 B-demark b-mark-2 w-all w-all-1 WITH FRAME F-Main.
      729       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
      730       RUN set-attribute-list ('ENABLED=yes':U).
      731       RETURN.
      732   END PROCEDURE.
      733   PROCEDURE adm-exit :
      734        RUN notify ('exit':U).
      735     RETURN.
      736   END PROCEDURE.
      737   PROCEDURE adm-hide :
      738     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      739   END PROCEDURE.
      740   PROCEDURE adm-initialize :
      741     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      742   END PROCEDURE.
      743   PROCEDURE adm-show-errors :
      744       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
      745       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
      746           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
      747       END.
      748       RETURN.
      749   END PROCEDURE.
      750   PROCEDURE adm-UIB-mode :
      751     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      752   END PROCEDURE.
      753   PROCEDURE adm-view :
      754     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      755   END PROCEDURE.
      756   PROCEDURE dispatch :
      757       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
      758       RUN broker-dispatch IN adm-broker-hdl
      759           (THIS-PROCEDURE, p-method-name) NO-ERROR.
      760       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
      761   END PROCEDURE.
      762   PROCEDURE ensure-broker :
      763   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
      764   IF RETURN-VALUE NE "ADM-Broker":U THEN
      765   DO:
      766       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
      767       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
      768   END.
      769   END PROCEDURE.
      770   PROCEDURE get-attribute :
      771     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
      772     RUN broker-get-attribute IN adm-broker-hdl
      773         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
      774     RETURN RETURN-VALUE.
      775   END PROCEDURE.
      776   PROCEDURE get-attribute-list :
      777     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
      778     RUN broker-get-attribute-list IN adm-broker-hdl
      779         (INPUT THIS-PROCEDURE,
      780          INPUT ?,
      781          OUTPUT p-attr-list) NO-ERROR.
      782     RETURN.
      783   END PROCEDURE.
      784   PROCEDURE new-state :
      785     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
      786     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
      787     RETURN.
      788   END PROCEDURE.
      789   PROCEDURE notify :
      790     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
      791     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
      792     IF RETURN-VALUE = "ADM-ERROR":U THEN
      793         RETURN "ADM-ERROR":U.
      794     RETURN.
      795   END PROCEDURE.
      796   PROCEDURE set-attribute-list :
      797     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
      798     RUN ensure-broker.
      799     RUN broker-set-attribute-list IN adm-broker-hdl
      800         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
      801     RETURN.
      802   END PROCEDURE.
      803   PROCEDURE set-position :
      804       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
      805       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
      806       IF VALID-HANDLE(adm-object-hdl) THEN
      807       DO:
      808         ASSIGN adm-object-hdl:ROW    =   p-row
      809                adm-object-hdl:COLUMN =   p-col.
      810       END.
      811       RETURN.
      812   END PROCEDURE.
      813     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
      814     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
      815     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
      816     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
      817     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
      818     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
      819     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
      820     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
      821     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
      822     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
      823     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
      824     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
      825     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
      826     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
      827     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
      828     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
      829     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
      830     IF "List-field":U = "":U THEN
      831       RUN modify-list-attribute IN adm-broker-hdl
      832         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
      833     RUN use-create-on-add(?).
      834   PROCEDURE adm-add-record :
      835      DEFINE VARIABLE trans-hdl-string  AS CHARACTER NO-UNDO.
      836      DEFINE VARIABLE cntr              AS INTEGER   NO-UNDO.
      837      DEFINE VARIABLE temp-rowid        AS ROWID     NO-UNDO.
      838      DEFINE VARIABLE saved-dictdb      AS CHARACTER NO-UNDO.
      839         IF group-assign-target = ? THEN
      840           RUN init-group-assign.
      841         IF NOT group-assign-target THEN
      842           RUN check-modified IN THIS-PROCEDURE ('check':U) NO-ERROR.
      843         ASSIGN adm-first-table = ROWID(List-field)
      844                adm-new-record = yes
      845                adm-adding-record = yes
      846                adm-query-empty = IF AVAILABLE(List-field)
      847                                  THEN no ELSE yes.
      848         RUN set-attribute-list ("ADM-NEW-RECORD=yes,ADM-QUERY-EMPTY-ON-ADD=":U +
      849           IF adm-query-empty THEN "yes":U ELSE "no":U).
      850         RUN dispatch('enable-fields':U).
      851         IF (adm-create-on-add = no) AND (adm-first-tmpl-recid = ?) AND
      852            (DBTYPE(LDBNAME(BUFFER List-field)) EQ "PROGRESS":U)
      853         THEN DO:
      854             saved-dictdb = LDBNAME("DICTDB":U).
      855             CREATE ALIAS DICTDB FOR DATABASE
      856               VALUE(LDBNAME(BUFFER List-field)).
      857             RUN adm/objects/get-init.p (INPUT "List-field":U,
      858               OUTPUT adm-first-tmpl-recid).
      859             CREATE ALIAS DICTDB FOR DATABASE
      860               VALUE(saved-dictdb).
      861           END.
      862             DO WITH FRAME F-Main:
      863                IF NUM-RESULTS("br_table":U) = ? OR
      864                 NUM-RESULTS("br_table":U) = 0
      865                  OR BROWSE br_table:NUM-SELECTED-ROWS = 1 THEN
      866                   adm-return-status = br_table:INSERT-ROW("AFTER":U).
      867                 ELSE DO:
      868                   MESSAGE
      869                 "You must select a row after which the new row is to be inserted."
      870                       VIEW-AS ALERT-BOX.
      871                   RETURN.
      872                 END.
      873                 adm-brs-initted = no.
      874             END.
      875         RUN notify ('add-record, GROUP-ASSIGN-TARGET':U).
      876         RUN new-state('update':U).
      877         RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
      878       RETURN.
      879   END PROCEDURE.
      880   PROCEDURE adm-assign-record :
      881           IF group-assign-target = ? THEN
      882             RUN init-group-assign.
      883           adm-updating-record = yes.
      884           IF adm-new-record THEN DO:
      885             IF (NOT adm-adding-record) OR
      886                 (NOT adm-create-on-add) THEN
      887             DO:
      888                RUN dispatch ('create-record':U).
      889                IF RETURN-VALUE = "ADM-ERROR":U THEN UNDO, RETURN "ADM-ERROR":U.
      890             END.
      891             IF adm-create-on-add = yes THEN
      892             DO:
      893               RUN dispatch ('current-changed':U).
      894               IF RETURN-VALUE = "ADM-ERROR":U THEN
      895                  RETURN "ADM-ERROR":U.
      896             END.
      897           END.
      898           ELSE DO:
      899               RUN dispatch ('current-changed':U).
      900               IF RETURN-VALUE = "ADM-ERROR":U THEN
      901                  RETURN "ADM-ERROR":U.
      902           END.
      903           RUN dispatch ('assign-statement':U).
      904           IF RETURN-VALUE = "ADM-ERROR":U THEN
      905               UNDO, RETURN "ADM-ERROR":U.
      906           RUN notify ('assign-record,GROUP-ASSIGN-TARGET':U).
      907           IF RETURN-VALUE = "ADM-ERROR":U THEN UNDO, RETURN "ADM-ERROR":U.
      908           IF adm-new-record THEN
      909           DO:
      910               RUN get-attribute('Query-Position':U).
      911               IF RETURN-VALUE = 'no-record-available':U THEN
      912               DO:
      913                 RUN new-state('record-available':U).
      914                 RUN set-attribute-list('Query-Position = record-available':U).
      915               END.
      916               RUN dispatch('display-fields':U).
      917           END.
      918      RETURN.
      919     END PROCEDURE.
      920   PROCEDURE adm-assign-statement :
      921     RETURN.
      922   END PROCEDURE.
      923   PROCEDURE adm-cancel-record :
      924     DEFINE VARIABLE source-str          AS CHARACTER NO-UNDO.
      925      RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
      926      IF adm-new-record THEN
      927      DO:
      928         IF (adm-adding-record = yes) AND
      929            (adm-create-on-add = no)
      930         THEN DO:
      931           RELEASE List-field NO-ERROR.
      932         END.
      933         ELSE IF (adm-adding-record = yes) AND
      934           (adm-create-on-add = yes) AND
      935             (adm-create-complete = yes)
      936         THEN RUN dispatch ('delete-record':U).
      937           IF (adm-adding-record = no) OR (adm-create-on-add = no) THEN
      938             IF BROWSE br_table:NUM-SELECTED-ROWS = 1 THEN
      939               adm-return-status = br_table:DELETE-CURRENT-ROW()
      940                IN FRAME F-Main.
      941         adm-new-record = no.
      942         RUN set-attribute-list ("ADM-NEW-RECORD=no":U).
      943      END.
      944      ELSE RUN dispatch ('display-fields':U).
      945      RUN notify ('cancel-record, GROUP-ASSIGN-TARGET':U).
      946      RUN dispatch ('apply-entry':U).
      947      RUN get-link-handle IN adm-broker-hdl
      948          (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, OUTPUT source-str).
      949      adm-updating-record = no.
      950      IF source-str EQ "":U THEN
      951        RUN new-state('update-complete':U).
      952        adm-brs-in-update = no.
      953      RETURN.
      954     END PROCEDURE.
      955   PROCEDURE adm-copy-record :
      956      DEFINE VARIABLE trans-hdl-string AS CHARACTER NO-UNDO.
      957         IF group-assign-target = ? THEN
      958           RUN init-group-assign.
      959         IF NOT group-assign-target THEN
      960           RUN check-modified IN THIS-PROCEDURE ('check':U) NO-ERROR.
      961         ASSIGN adm-first-table = ROWID(List-field)
      962                adm-new-record = yes
      963                adm-adding-record = no.
      964         RUN set-attribute-list ("ADM-NEW-RECORD=yes":U).
      965         RUN dispatch('enable-fields':U).
      966             DO WITH FRAME F-Main:
      967               IF NUM-RESULTS("br_table":U) = ? OR
      968                  NUM-RESULTS("br_table":U) = 0 THEN
      969               DO:
      970                   MESSAGE "Cannot perform Copy. There are no browse rows."
      971                       VIEW-AS ALERT-BOX WARNING.
      972                   RUN dispatch ('cancel-record':U).
      973               END.
      974               ELSE DO:
      975                adm-first-prev-rowid = ROWID(List-field).
      976                  IF NUM-RESULTS("br_table":U) = ? OR
      977                   NUM-RESULTS("br_table":U) = 0
      978                    OR BROWSE br_table:NUM-SELECTED-ROWS = 1 THEN
      979                     adm-return-status = br_table:INSERT-ROW("AFTER":U).
      980                  ELSE DO:
      981                     MESSAGE
      982                 "You must select a row after which the new row is to be inserted."
      983                         VIEW-AS ALERT-BOX.
      984                     RETURN.
      985                  END.
      986                  adm-brs-initted = no.
      987               END.
      988             END.
      989         RUN notify ('copy-record, GROUP-ASSIGN-TARGET':U).
      990         RUN new-state('update':U).
      991       RETURN.
      992   END PROCEDURE.
      993   PROCEDURE adm-create-record :
      994       DEFINE VARIABLE source-str          AS CHARACTER NO-UNDO.
      995       DEFINE VARIABLE source-rowid-str    AS CHARACTER NO-UNDO.
      996          IF group-assign-target = yes THEN
      997          DO:
      998            RUN get-link-handle IN adm-broker-hdl
      999              (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U,
     1000                 OUTPUT source-str).
     1001            RUN send-records IN WIDGET-HANDLE (source-str)
     1002                (INPUT "List-field":U,
     1003                 OUTPUT source-rowid-str).
     1004            FIND List-field WHERE
     1005                ROWID (List-field) =
     1006                    TO-ROWID(source-rowid-str) NO-ERROR.
     1007            IF ERROR-STATUS:ERROR THEN
     1008            DO:
     1009              RUN dispatch('show-errors':U).
     1010              UNDO, RETURN "ADM-ERROR":U.
     1011            END.
     1012          END.
     1013          ELSE DO:
     1014              CREATE List-field NO-ERROR.
     1015              IF ERROR-STATUS:ERROR THEN
     1016              DO:
     1017                RUN dispatch('show-errors':U).
     1018                UNDO, RETURN "ADM-ERROR":U.
     1019              END.
     1020          END.
     1021      RETURN.
     1022   END PROCEDURE.
     1023   PROCEDURE adm-current-changed :
     1024      ASSIGN adm-first-table = ROWID(List-field).
     1025     IF NOT group-assign-target THEN
     1026     DO:
     1027       FIND CURRENT List-field EXCLUSIVE-LOCK NO-ERROR NO-WAIT.
     1028       IF NOT AVAILABLE List-field THEN
     1029       DO:
     1030         RUN dispatch('show-errors':U).
     1031         IF ERROR-STATUS:GET-NUMBER(1) = 138 THEN
     1032             RUN dispatch('get-next':U).
     1033         ELSE FIND List-field WHERE
     1034             ROWID(List-field) = adm-first-table NO-LOCK NO-ERROR.
     1035         RETURN "ADM-ERROR":U.
     1036       END.
     1037       ELSE IF CURRENT-CHANGED List-field THEN
     1038       DO:
     1039         MESSAGE  SUBSTITUTE
     1040             ("Sorry, this &1 has been changed by another user. ",
     1041               "List-field") SKIP
     1042               "Please note any differences and re-enter your changes."
     1043                      VIEW-AS ALERT-BOX.
     1044         RUN dispatch ('display-fields':U).
     1045         UNDO, RETURN "ADM-ERROR":U.
     1046       END.
     1047     END.
     1048     RETURN.
     1049   END PROCEDURE.
     1050   PROCEDURE adm-delete-record :
     1051      DEFINE VARIABLE delete-failed AS LOGICAL NO-UNDO INIT no.
     1052      IF group-assign-target = ? THEN
     1053        RUN init-group-assign.
     1054         IF BROWSE br_table:NUM-SELECTED-ROWS NE 1 THEN
     1055         DO:
     1056             MESSAGE "No row has been selected for deletion." VIEW-AS ALERT-BOX.
     1057             RETURN.
     1058         END.
     1059         DO TRANSACTION ON STOP UNDO, LEAVE ON ERROR UNDO, LEAVE:
     1060           IF group-assign-target NE yes THEN
     1061           DO:
     1062             FIND CURRENT List-field EXCLUSIVE-LOCK NO-WAIT
     1063               NO-ERROR.
     1064             IF ERROR-STATUS:ERROR THEN
     1065             DO:
     1066               RUN dispatch('show-errors':U).
     1067               UNDO, RETURN "ADM-ERROR":U.
     1068             END.
     1069             DELETE List-field NO-ERROR.
     1070           END.
     1071           IF ERROR-STATUS:ERROR THEN
     1072           DO:
     1073             RUN dispatch('show-errors':U).
     1074             delete-failed = yes.
     1075           END.
     1076           ELSE
     1077               adm-return-status =
     1078                  br_table:DELETE-CURRENT-ROW() IN FRAME F-Main.
     1079         END.
     1080            IF NOT AVAILABLE (List-field) THEN
     1081            DO:
     1082              RUN new-state ('no-record-available':U).
     1083              RUN set-attribute-list ('Query-Position = no-record-available':U).
     1084              RUN notify ('row-available':U).
     1085            END.
     1086         IF delete-failed THEN
     1087             UNDO, RETURN "ADM-ERROR":U.
     1088       RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
     1089       RETURN.
     1090   END PROCEDURE.
     1091   PROCEDURE adm-disable-fields :
     1092         RUN notify ('disable-fields, GROUP-ASSIGN-TARGET':U).
     1093       RETURN.
     1094   END PROCEDURE.
     1095   PROCEDURE adm-enable-fields :
     1096       RETURN.
     1097   END PROCEDURE.
     1098   PROCEDURE adm-end-update :
     1099     DEFINE VARIABLE source-str          AS CHARACTER NO-UNDO.
     1100      IF ERROR-STATUS:ERROR THEN
     1101          RUN dispatch('show-errors':U).
     1102      RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
     1103      RUN get-link-handle IN adm-broker-hdl
     1104         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, OUTPUT source-str).
     1105      IF adm-new-record AND NOT TRANSACTION THEN DO:
     1106             adm-new-record = no.
     1107             RUN set-attribute-list ("ADM-NEW-RECORD=no":U).
     1108             ASSIGN adm-first-table = ROWID(List-field).
     1109             IF source-str EQ "":U THEN
     1110             DO:
     1111                 RUN set-attribute-list ('REPOSITION-PENDING=yes':U).
     1112                 RUN dispatch('open-query':U).
     1113                 RUN reposition-query (INPUT THIS-PROCEDURE).
     1114                 RUN dispatch('row-changed':U).
     1115             END.
     1116      END.
     1117       FIND CURRENT List-field NO-LOCK NO-ERROR.
     1118       RUN notify('end-update, GROUP-ASSIGN-TARGET':U).
     1119       IF source-str EQ "":U THEN
     1120           RUN new-state('update-complete':U).
     1121         adm-brs-in-update = no.
     1122       adm-updating-record = no.
     1123       RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
     1124     RETURN.
     1125   END PROCEDURE.
     1126   PROCEDURE adm-reset-record :
     1127        RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     1128        RUN notify ('reset-record, GROUP-ASSIGN-TARGET':U).
     1129        RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
     1130       RETURN.
     1131   END PROCEDURE.
     1132   PROCEDURE adm-update-record :
     1133         DEFINE VARIABLE cRecordSrc AS CHARACTER NO-UNDO.
     1134         DEFINE VARIABLE hRecordSrc AS HANDLE     NO-UNDO.
     1135         DEFINE BUFFER bNewRecord FOR List-field.
     1136         DO TRANSACTION ON STOP  UNDO, RETURN "ADM-ERROR":U
     1137                        ON ERROR UNDO, RETURN "ADM-ERROR":U :
     1138           RUN dispatch ('assign-record':U).
     1139           IF  RETURN-VALUE = "ADM-ERROR":U THEN
     1140               RETURN "ADM-ERROR":U.
     1141         END.
     1142         RUN dispatch ('end-update':U).
     1143         FIND FIRST bNewRecord NO-LOCK NO-ERROR.
     1144         IF NOT ERROR-STATUS:ERROR AND ROWID(bNewRecord) = ROWID (List-field) THEN
     1145         DO:
     1146           RUN get-link-handle IN adm-broker-hdl
     1147               (INPUT THIS-PROCEDURE,
     1148                INPUT "RECORD-SOURCE",
     1149                OUTPUT cRecordSrc).
     1150           hRecordSrc = WIDGET-HANDLE(cRecordSrc).
     1151           IF VALID-HANDLE(hRecordSrc) THEN
     1152           DO:
     1153               RUN get-attribute IN hRecordSrc ("TYPE":U).
     1154               IF RETURN-VALUE = "SmartQuery":U AND
     1155                  CAN-DO(hRecordSrc:INTERNAL-ENTRIES,"new-first-record") THEN
     1156                  RUN new-first-record IN hRecordSrc (INPUT ROWID (List-field)).
     1157           END.
     1158         END.
     1159      RETURN.
     1160   END PROCEDURE.
     1161   PROCEDURE check-modified :
     1162   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
     1163   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
     1164   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
     1165   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
     1166     IF NOT VALID-HANDLE(adm-object-hdl) THEN RETURN.
     1167     IF group-assign-target = ? THEN
     1168       RUN init-group-assign.
     1169     IF check-state = "check":U AND group-assign-target THEN
     1170       RETURN "":U.
     1171     ELSE IF check-state = "group-check":U THEN
     1172        check-state = "check":U.
     1173     IF VALID-HANDLE(BROWSE br_table:HANDLE) AND
     1174         AVAILABLE(List-field) THEN
     1175     DO:
     1176       ASSIGN curr-widget = BROWSE br_table:FIRST-COLUMN.
     1177       DO WHILE VALID-HANDLE (curr-widget):
     1178           IF NOT curr-widget:READ-ONLY AND curr-widget:MODIFIED THEN
     1179           DO:
     1180               IF check-state = "check":U THEN
     1181               DO:
     1182                   RUN check-modified-message(curr-widget:TABLE).
     1183                   RETURN.
     1184               END.
     1185               ELSE IF check-state = "clear":U THEN
     1186                   curr-widget:MODIFIED = no.
     1187           END.
     1188           ASSIGN curr-widget = curr-widget:NEXT-COLUMN.
     1189       END.
     1190     END.
     1191     IF check-state = "check":U THEN
     1192     DO:
     1193       RUN get-link-handle IN adm-broker-hdl
     1194         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
     1195            OUTPUT group-target-list).
     1196       IF group-target-list NE "":U THEN
     1197       DO i = 1 TO NUM-ENTRIES(group-target-list):
     1198         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
     1199         RUN check-modified IN curr-widget ('group-check':U).
     1200         IF RETURN-VALUE NE "":U THEN
     1201         DO:
     1202           RUN check-modified-message(RETURN-VALUE).
     1203           RETURN "":U.
     1204         END.
     1205       END.
     1206     END.
     1207     RETURN "":U.
     1208   END PROCEDURE.
     1209   PROCEDURE check-modified-message :
     1210     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
     1211        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
     1212           'CONTAINER-SOURCE':U, 'HIDDEN':U).
     1213        IF RETURN-VALUE = "YES":U THEN
     1214           RUN notify ('view,CONTAINER-SOURCE':U).
     1215        MESSAGE IF p-changed-table NE ? THEN
     1216           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
     1217           ELSE "Current values have been changed."
     1218           SKIP "  Do you wish to save those changes?"
     1219           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
     1220        IF ANS THEN
     1221        DO:
     1222           IF group-assign-target THEN
     1223             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
     1224           ELSE RUN dispatch('update-record':U).
     1225           IF RETURN-VALUE = "ADM-ERROR":U THEN
     1226           DO:
     1227               MESSAGE "Changes to the previous record were not saved."
     1228                 VIEW-AS ALERT-BOX ERROR.
     1229               IF group-assign-target THEN
     1230                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1231               ELSE RUN dispatch ('cancel-record':U).
     1232           END.
     1233        END.
     1234        ELSE DO:
     1235          IF group-assign-target THEN
     1236             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1237          ELSE RUN dispatch('cancel-record':U).
     1238        END.
     1239        RETURN.
     1240   END PROCEDURE.
     1241   PROCEDURE get-rowid :
     1242       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
     1243       ASSIGN
     1244       p-table   =   adm-first-table.
     1245       RETURN.
     1246   END PROCEDURE.
     1247   PROCEDURE init-group-assign :
     1248       RUN request-attribute IN adm-broker-hdl
     1249         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
     1250       IF LOOKUP("List-field":U, RETURN-VALUE, " ":U) NE 0 THEN
     1251         group-assign-target = yes.
     1252       ELSE group-assign-target = no.
     1253       RETURN.
     1254   END PROCEDURE.
     1255   PROCEDURE set-editors :
     1256       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
     1257       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
     1258       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
     1259       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
     1260       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
     1261       DO WHILE VALID-HANDLE (curr-widget):
     1262           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
     1263              curr-widget:HIDDEN = no THEN DO:
     1264             CASE p-field-setting:
     1265               WHEN "INITIALIZE":U THEN
     1266               DO:
     1267                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
     1268                     read-only-list +
     1269                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
     1270                        STRING(curr-widget).
     1271               END.
     1272               WHEN "DISABLE":U OR
     1273               WHEN "ENABLE":U THEN
     1274               DO:
     1275                   curr-widget:SENSITIVE = yes.
     1276                   RUN get-attribute ('Read-Only-Editors':U).
     1277                   IF RETURN-VALUE = ? OR
     1278                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
     1279                       curr-widget:READ-ONLY =
     1280                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
     1281               END.
     1282               WHEN "CLEAR":U THEN
     1283                   curr-widget:SCREEN-VALUE = "":U.
     1284             END CASE.
     1285           END.
     1286           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
     1287       END.
     1288       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
     1289         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
     1290           + '"':U).
     1291       RETURN.
     1292   END PROCEDURE.
     1293   PROCEDURE use-check-modified-all :
     1294    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1295     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
     1296     RETURN.
     1297   END PROCEDURE.
     1298   PROCEDURE use-create-on-add :
     1299   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1300         ASSIGN adm-create-on-add =
     1301             IF (p-attr-value EQ "NO":U) OR
     1302                (p-attr-value NE "YES":U AND
     1303              DBTYPE(LDBNAME(BUFFER List-field)) EQ "PROGRESS":U)
     1304             THEN no ELSE yes.
     1305           IF adm-create-on-add THEN
     1306             BROWSE br_table:CREATE-ON-ADD = yes.
     1307      RETURN.
     1308   END PROCEDURE.
     1309   PROCEDURE use-initial-lock :
     1310     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1311     ASSIGN adm-initial-lock = p-attr-value.
     1312     RETURN.
     1313   END PROCEDURE.
     1314   PROCEDURE adm-display-fields :
     1315         IF AVAILABLE List-field THEN
     1316             DISPLAY List-field.use List-field.Naim List-field.w-col WITH BROWSE br_table
     1317               NO-ERROR.
     1318         DISPLAY UNLESS-HIDDEN w-all w-all-1
     1319             WITH FRAME F-Main NO-ERROR.
     1320       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
     1321       RETURN.
     1322   END PROCEDURE.
     1323   PROCEDURE adm-open-query :
     1324               OPEN QUERY br_table FOR EACH List-field WHERE TRUE NO-LOCK     .
     1325           adm-query-opened = yes.
     1326           IF NUM-RESULTS("br_table":U) = 0 THEN
     1327               RUN new-state ('no-record-available,SELF':U).
     1328           ELSE DO:
     1329               RUN new-state ('record-available,SELF':U).
     1330               RUN new-state ('first-record,SELF':U).
     1331           END.
     1332           IF NOT adm-updating-record THEN
     1333               RUN dispatch IN THIS-PROCEDURE ('row-changed':U).
     1334     RETURN.
     1335   END PROCEDURE.
     1336   PROCEDURE adm-row-changed :
     1337         IF VALID-HANDLE(adm-object-hdl) THEN
     1338           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     1339         RUN notify ('row-available':U).
     1340         RETURN.
     1341   END PROCEDURE.
     1342   PROCEDURE reposition-query :
     1343       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
     1344       DEFINE VARIABLE table-name                 AS ROWID NO-UNDO.
     1345       RUN get-rowid IN p-requestor-hdl (OUTPUT table-name).
     1346       IF table-name <> ? THEN
     1347           REPOSITION br_table TO ROWID table-name NO-ERROR.
     1348       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
     1349       RETURN.
     1350   END PROCEDURE.
     1351     adm-sts = br_table:SET-REPOSITIONED-ROW
     1352       (br_table:DOWN,"CONDITIONAL":U).
     1353     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
     1354   PROCEDURE set-size :
     1355     DEFINE INPUT PARAMETER pd_height AS DECIMAL NO-UNDO.
     1356     DEFINE INPUT PARAMETER pd_width  AS DECIMAL NO-UNDO.
     1357     DEFINE VARIABLE hBrowse     AS HANDLE           NO-UNDO.
     1358     DEFINE VARIABLE hFieldGroup AS HANDLE           NO-UNDO.
     1359     DEFINE VARIABLE hFrame      AS HANDLE           NO-UNDO.
     1360     DEFINE VARIABLE htmpWidget  AS HANDLE           NO-UNDO.
     1361     DEFINE VARIABLE otherWidget AS LOGICAL          NO-UNDO.
     1362     ASSIGN pd_height = MAX(pd_height, 2.0)
     1363            pd_width  = MAX(pd_width, 2.0)
     1364            hBrowse     = br_table:HANDLE IN FRAME F-Main
     1365            hFieldGroup = hBrowse:PARENT
     1366            htmpWidget  = hFieldGroup:FIRST-CHILD
     1367            hFrame      = hFieldGroup:PARENT.
     1368     Search-For-Siblings:
     1369     REPEAT WHILE VALID-HANDLE(htmpWidget):
     1370       IF htmpWidget NE hBrowse THEN DO:
     1371         IF htmpWidget:TYPE NE "BUTTON" OR
     1372            htmpWidget:X    NE 4 OR
     1373            htmpWidget:Y    NE 4 THEN DO:
     1374           RETURN.
     1375         END.
     1376       END.
     1377       htmpWidget = htmpWidget:NEXT-SIBLING.
     1378     END.
     1379     IF pd_width < hBrowse:WIDTH THEN
     1380       ASSIGN hBrowse:WIDTH = pd_width
     1381              hFrame:WIDTH  = pd_width     NO-ERROR.
     1382     ELSE
     1383       ASSIGN hFrame:WIDTH  = pd_width
     1384              hBrowse:WIDTH = pd_width     NO-ERROR.
     1385     IF pd_height < hBrowse:HEIGHT THEN
     1386       ASSIGN hBrowse:HEIGHT = pd_height
     1387              hFrame:HEIGHT  = pd_height     NO-ERROR.
     1388     ELSE
     1389       ASSIGN hFrame:HEIGHT  = pd_height
     1390              hBrowse:HEIGHT = pd_height     NO-ERROR.
     1391   END PROCEDURE.
     1392   ASSIGN
     1393          FRAME F-Main:SCROLLABLE       = FALSE
     1394          FRAME F-Main:HIDDEN           = TRUE.
     1395   ASSIGN
     1396          B-demark:HIDDEN IN FRAME F-Main           = TRUE.
     1397   ASSIGN
     1398          B-mark:HIDDEN IN FRAME F-Main           = TRUE.
     1399   ASSIGN
     1400          b-mark-2:HIDDEN IN FRAME F-Main           = TRUE.
     1401   ASSIGN
     1402          br_table:HIDDEN  IN FRAME F-Main                = TRUE.
     1403   ASSIGN
     1404          RECT-1:HIDDEN IN FRAME F-Main           = TRUE.
     1405   ASSIGN
     1406          w-all:HIDDEN IN FRAME F-Main           = TRUE.
     1407   ASSIGN
     1408          w-all-1:HIDDEN IN FRAME F-Main           = TRUE.
     1409   ON CHOOSE OF B-demark IN FRAME F-Main
     1410   DO:
     1411     For each List-field :
     1412         If List-field.make-correct = true then List-field.use = false.
     1413     End.
     1414     apply "VALUE-CHANGED" to br_table in frame F-Main.
     1415        OPEN QUERY br_table FOR EACH List-field WHERE TRUE NO-LOCK     .
     1416   END.
     1417   ON CHOOSE OF B-mark IN FRAME F-Main
     1418   DO:
     1419     For each List-field  :
     1420       If List-field.make-correct = true then  List-field.use = true.
     1421     End.
     1422     apply "VALUE-CHANGED" to br_table in frame F-Main.
     1423        OPEN QUERY br_table FOR EACH List-field WHERE TRUE NO-LOCK     .
     1424   END.
     1425   ON CHOOSE OF b-mark-2 IN FRAME F-Main
     1426   OR MOUSE-SELECT-DBLCLICK OF br_table IN FRAME F-Main
     1427   DO:
     1428   define variable v-log as logical   no-undo .
     1429   find current List-field no-error.
     1430     if not available List-field then do:
     1431        message "Неправильный выбор строки.".
     1432        return no-apply.
     1433     end.
     1434     If List-field.make-correct = true then DO:
     1435       IF    List-field.use = true THEN DO:
     1436             List-field.use = false.
     1437             disp "" @ List-field.use with browse br_table no-error .
     1438         End.
     1439         Else DO:
     1440              List-field.use = true.
     1441              disp "+" @ List-field.use with browse br_table no-error .
     1442         End.
     1443      End.
     1444        apply "VALUE-CHANGED" to br_table in frame F-Main.
     1445        v-log = br_table:select-next-row () no-error .
     1446   END.
     1447   ON ROW-DISPLAY OF br_table IN FRAME F-Main
     1448   DO:
     1449     if not list-field.make-correct  then
     1450          assign
     1451            list-field.naim  :bgcolor in browse br_table = 8
     1452            list-field.use   :bgcolor in browse br_table = 8
     1453            list-field.w-col :bgcolor in browse br_table = 8
     1454            .
     1455           Else
     1456          assign
     1457            list-field.naim  :bgcolor in browse br_table = ?
     1458            list-field.use   :bgcolor in browse br_table = ?
     1459            list-field.w-col :bgcolor in browse br_table = ?
     1460            .
     1461   END.
     1462   ON ROW-ENTRY OF br_table IN FRAME F-Main
     1463   DO:
     1464      IF br_table:NEW-ROW AND NOT adm-brs-initted THEN
     1465      DO:
     1466        adm-brs-initted = yes.
     1467        IF adm-adding-record THEN
     1468        DO:
     1469          IF adm-create-on-add = no THEN
     1470          DO:
     1471            IF DBTYPE(LDBNAME(BUFFER List-field)) EQ "PROGRESS":U
     1472            THEN DO:
     1473             FIND List-field WHERE
     1474               RECID(List-field)
     1475                 = adm-first-tmpl-recid.
     1476             DISPLAY UNLESS-HIDDEN List-field.use List-field.Naim List-field.w-col
     1477               WITH BROWSE br_table NO-ERROR.
     1478            END.
     1479           END.
     1480           ELSE DO:
     1481            DO TRANSACTION ON STOP  UNDO, RETURN "ADM-ERROR":U
     1482                           ON ERROR UNDO, RETURN "ADM-ERROR":U.
     1483              adm-create-complete = no.
     1484              RUN dispatch ('create-record':U).
     1485              IF RETURN-VALUE = "ADM-ERROR":U THEN UNDO, RETURN "ADM-ERROR":U.
     1486              DISPLAY UNLESS-HIDDEN List-field.use List-field.Naim List-field.w-col
     1487                WITH BROWSE br_table NO-ERROR.
     1488            END.
     1489            adm-create-complete = yes.
     1490           END.
     1491         END.
     1492         ELSE
     1493         DO:
     1494            FIND List-field WHERE
     1495              ROWID(List-field) =
     1496                 adm-first-prev-rowid NO-LOCK.
     1497            DISPLAY UNLESS-HIDDEN List-field.use List-field.Naim List-field.w-col
     1498              WITH BROWSE br_table.
     1499         END.
     1500      END.
     1501   END.
     1502   ON ROW-LEAVE OF br_table IN FRAME F-Main
     1503   DO:
     1504   DEFINE VARIABLE widget-enter  AS HANDLE NO-UNDO.
     1505   DEFINE VARIABLE widget-frame  AS HANDLE NO-UNDO.
     1506   DEFINE VARIABLE widget-parent AS HANDLE NO-UNDO.
     1507     widget-enter = last-event:widget-enter.
     1508     IF VALID-HANDLE(widget-enter) THEN widget-parent = widget-enter:PARENT.
     1509     IF VALID-HANDLE(widget-parent) AND widget-parent:TYPE NE "BROWSE":U
     1510       THEN widget-frame = widget-enter:FRAME.
     1511     IF ((NOT VALID-HANDLE(widget-enter)) OR
     1512         (widget-parent:TYPE = "BROWSE":U) OR
     1513         (NOT VALID-HANDLE(widget-frame)) OR
     1514         (NOT CAN-DO(widget-frame:PRIVATE-DATA, "ADM-PANEL":U)))
     1515     THEN DO:
     1516         IF adm-brs-in-update THEN
     1517         DO:
     1518           MESSAGE
     1519           "You must complete or cancel the update before leaving the current row."
     1520               VIEW-AS ALERT-BOX WARNING.
     1521           RETURN NO-APPLY.
     1522         END.
     1523         IF br_table:CURRENT-ROW-MODIFIED  OR
     1524           (adm-new-record AND BROWSE br_table:NUM-SELECTED-ROWS = 1) THEN
     1525         DO:
     1526           IF VALID-HANDLE (widget-parent) AND widget-parent:TYPE NE "BROWSE":U
     1527           THEN DO:
     1528             MESSAGE
     1529             "Current record has been changed. " SKIP
     1530             "Do you wish to save those changes?"
     1531               VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE l-save AS LOGICAL.
     1532             IF l-save THEN
     1533             DO:
     1534                RUN dispatch('update-record':U).
     1535                IF RETURN-VALUE = "ADM-ERROR":U THEN
     1536                    RETURN NO-APPLY.
     1537             END.
     1538             ELSE RUN dispatch ('cancel-record':U).
     1539           END.
     1540           ELSE DO:
     1541             RUN dispatch('update-record':U).
     1542             IF RETURN-VALUE = "ADM-ERROR":U THEN
     1543                 RETURN NO-APPLY.
     1544           END.
     1545         END.
     1546     END.
     1547   END.
     1548   ON VALUE-CHANGED OF br_table IN FRAME F-Main
     1549   DO:
     1550   RUN get-attribute('ADM-NEW-RECORD':U).
     1551   IF RETURN-VALUE NE "YES":U THEN
     1552     RUN notify ('row-available':U).
     1553     w-all = 0.
     1554     for each List-field no-lock :
     1555         if List-field.use then
     1556          assign
     1557            w-all = w-all + List-field.w-col
     1558            w-all = w-all + 1.
     1559     End.
     1560     if w-all > 0 Then DO:
     1561         display w-all  with frame F-Main.
     1562         RUN get-attribute IN THIS-PROCEDURE ('UIB-MODE').
     1563         IF  RETURN-VALUE NE "DESIGN" THEN DO:
     1564             define variable source-str as character.
     1565             define variable state-source as handle .
     1566             run get-link-handle IN adm-broker-hdl ( THIS-PROCEDURE, 'State':U , OUTPUT source-str ) no-error.
     1567             State-source = WIDGET-HANDLE ( source-str ).
     1568             IF VALID-HANDLE ( State-source ) THEN do :
     1569                run view-how-name in State-source (input w-all) no-error.
     1570                End.
     1571         END.
     1572     End.
     1573   END.
     1574   if not this-procedure :persistent
     1575   then do:
     1576     message
     1577       vss-workfile vss-revision vss-description skip
     1578       "Ошибка при запуске процедуры" skip
     1579       "Данную процедуру следует запускать только с параметром persistent" skip
     1580       view-as alert-box error .
     1581     undo, return error .
     1582   end.
     1583     run load-table in this-procedure   .
     1584     Assign w-all-1 = 0 w-all = 0.
     1585     for each List-field no-lock :
     1586         w-all-1 = w-all-1 + List-field.w-col.
     1587         if List-field.use then
     1588            assign
     1589              w-all   = w-all + List-field.w-col
     1590              w-all-1 = w-all-1 + 1
     1591              w-all   = w-all + 1.
     1592     End.
     1593     display w-all  w-all-1 with frame F-Main .
     1594     if can-find (first  List-field no-lock) then DO :
     1595        display br_table B-demark B-mark b-mark-2 rect-1 w-all w-all-1
     1596                with frame F-Main.
     1597        End.
     1598        OPEN QUERY br_table FOR EACH List-field WHERE TRUE NO-LOCK     .
     1599   PROCEDURE adm-row-available :
     1600     DEFINE VARIABLE tbl-list           AS CHARACTER INIT "":U NO-UNDO.
     1601     DEFINE VARIABLE rowid-list         AS CHARACTER NO-UNDO.
     1602     DEFINE VARIABLE row-avail-cntr     AS INTEGER INIT 0 NO-UNDO.
     1603     DEFINE VARIABLE row-avail-rowid    AS ROWID NO-UNDO.
     1604     DEFINE VARIABLE row-avail-enabled  AS LOGICAL NO-UNDO.
     1605     DEFINE VARIABLE link-handle        AS CHARACTER NO-UNDO.
     1606     DEFINE VARIABLE record-source-hdl  AS HANDLE NO-UNDO.
     1607     DEFINE VARIABLE different-row      AS LOGICAL NO-UNDO INIT no.
     1608     DEFINE VARIABLE key-name           AS CHARACTER INIT ? NO-UNDO.
     1609     DEFINE VARIABLE key-value          AS CHARACTER INIT ? NO-UNDO.
     1610     RUN check-modified IN THIS-PROCEDURE ('check':U) NO-ERROR.
     1611     IF adm-updating-record THEN RETURN.
     1612     RUN get-attribute ('FIELDS-ENABLED':U).
     1613     row-avail-enabled = IF RETURN-VALUE = "YES":U THEN yes ELSE no.
     1614     RUN get-link-handle IN adm-broker-hdl (THIS-PROCEDURE, 'RECORD-SOURCE':U,
     1615         OUTPUT link-handle) NO-ERROR.
     1616     IF link-handle = "":U THEN
     1617         RETURN.
     1618     ASSIGN record-source-hdl = WIDGET-HANDLE(ENTRY(1,link-handle)).
     1619     IF NUM-ENTRIES(link-handle) > 1 THEN
     1620         MESSAGE "row-available in ":U THIS-PROCEDURE:FILE-NAME
     1621             "encountered more than one RECORD-SOURCE.":U SKIP
     1622             "The first - ":U record-source-hdl:file-name " - will be used.":U
     1623                VIEW-AS ALERT-BOX ERROR.
     1624     RUN get-attribute ('Key-Name':U).
     1625     key-name = RETURN-VALUE.
     1626     IF key-name = "":U THEN key-name = ?.
     1627     IF key-name NE ? THEN DO:
     1628       RUN send-key IN record-source-hdl (INPUT key-name, OUTPUT key-value)
     1629         NO-ERROR.
     1630       IF key-value NE ? THEN
     1631         RUN set-attribute-list (SUBSTITUTE ('Key-Value="&1"':U, key-value)).
     1632     END.
     1633   IF VALID-HANDLE (adm-object-hdl) THEN
     1634       RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     1635     IF key-name ne ? OR different-row
     1636     THEN RUN dispatch IN THIS-PROCEDURE ('open-query':U).
     1637     ELSE RUN notify IN THIS-PROCEDURE('row-available':U).
     1638   END PROCEDURE.
     1639   PROCEDURE disable_UI :
     1640     HIDE FRAME F-Main.
     1641     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1642   END PROCEDURE.
     1643   PROCEDURE local-apply-layout :
     1644     RUN dispatch IN THIS-PROCEDURE ( INPUT 'apply-layout':U ) .
     1645   END PROCEDURE.
     1646   PROCEDURE local-create-record :
     1647     RUN dispatch IN THIS-PROCEDURE ( INPUT 'create-record':U ) .
     1648   END PROCEDURE.
     1649   PROCEDURE local-initialize :
     1650     RUN dispatch IN THIS-PROCEDURE ( INPUT 'initialize':U ) .
     1651   END PROCEDURE.
     1652   procedure load-table :
     1653   define variable ki as integer no-undo .
     1654   define variable kj as integer no-undo .
     1655   define variable qnty-col as integer no-undo .
     1656   define variable qnty-row as integer no-undo .
     1657   define variable l-name-field as character no-undo .
     1658   for each list-field  :
     1659      delete  list-field no-error .
     1660   end.
     1661   qnty-col = MINIMUM(num-entries(entry (1,Sheetf.Excel-Column-Lable,CHR(10))),num-entries(Sheetf.sizes)).
     1662   qnty-row = num-entries(Sheetf.Excel-Column-Lable,CHR(10)).
     1663   repeat ki = 1 to qnty-col :
     1664       l-name-field = '' .
     1665       Repeat kj = 1 to  qnty-row :
     1666         l-name-field = l-name-field  +
     1667           if entry(ki, (entry(kJ,Sheetf.Excel-Column-Lable,CHR(10)))) = ""
     1668             Then  fill(" ",10) + (if (kj <> qnty-row)  then  "/"   else " ")
     1669             Else entry(ki, (entry(kJ,Sheetf.Excel-Column-Lable,CHR(10)))) +
     1670               if (kj <> qnty-row)  then  "/"   else " ".
     1671       End.
     1672       if NOT(trim(l-name-field) = "" OR trim(l-name-field) = "/") THEN DO:
     1673           create List-field.
     1674             Repeat kj = 1 to  qnty-row :
     1675               List-field.naim = List-field.naim +
     1676                 if entry(ki, (entry(kJ,Sheetf.Excel-Column-Lable,CHR(10)))) = ""
     1677                   Then  fill(" ",10) + (if (kj <> qnty-row)  then  "/"   else " ")
     1678                   Else entry(ki, (entry(kJ,Sheetf.Excel-Column-Lable,CHR(10)))) +
     1679                     if (kj <> qnty-row)  then  "/"   else " ".
     1680              End.
     1681        if num-entries(Sheetf.make-correct) = qnty-col then DO:
     1682          List-field.make-correct = if entry(ki ,Sheetf.make-correct) = "false":U  or  entry(ki,Sheetf.make-correct) = ""
     1683                                       then false  else true .
     1684          end.
     1685          else do:
     1686                List-field.make-correct = false  .
     1687                end.
     1688          List-field.w-col = integer(entry(ki ,Sheetf.sizes)) no-error  .
     1689          List-field.use = use-column[ki] .
     1690          if List-field.make-correct = false then  List-field.use = true  .
     1691       End.
     1692       if num-entries(Sheetf.Rights-column) = qnty-col then DO :
     1693          if trim(entry(ki ,Sheetf.Rights-column)) = "false":U  then
     1694          assign
     1695              List-field.make-correct = false
     1696              List-field.use = false .
     1697       End.
     1698   end.
     1699    if not can-find ( first   List-field where           List-field.make-correct = true  ) then do:
     1700       for each list-field  :
     1701         delete  list-field no-error .
     1702       end.
     1703    end.
     1704   end  procedure.
     1705   procedure read-table :
     1706   define variable s-i as integer no-undo .
     1707   define variable s-t as character no-undo .
     1708   define buffer buf_usr-flt for ubflt.usr-flt  .
     1709   For each  List-field no-lock :
     1710       s-i = s-i + 1.
     1711       Use-Column[s-i]  = List-field.use.
     1712       s-t =  s-t + string(list-field.use , "true/false")  + ";".
     1713   End.
     1714    find first buf_usr-flt exclusive-lock where
     1715               buf_usr-flt.user-name = g#userid and
     1716               buf_usr-flt.call-point   = ReportProc  no-error .
     1717        if not available  buf_usr-flt then  create buf_usr-flt.
     1718          Assign
     1719            buf_usr-flt.user-name = g#userid
     1720            buf_usr-flt.call-point   = ReportProc
     1721            buf_usr-flt.list_ = buf_usr-flt.list_ + "," + string( "Use-column=" + s-t ) + ","
     1722            .
     1723   end  procedure.
     1724   PROCEDURE op-br :
     1725      run read-table in this-procedure .
     1726      run load-table in this-procedure .
     1727        OPEN QUERY br_table FOR EACH List-field WHERE TRUE NO-LOCK     .
     1728   END PROCEDURE.
     1729   PROCEDURE send-records :
     1730     DEFINE INPUT PARAMETER p-tbl-list AS CHARACTER NO-UNDO.
     1731     DEFINE OUTPUT PARAMETER p-rowid-list AS CHARACTER NO-UNDO.
     1732     DEFINE VARIABLE i            AS INTEGER   NO-UNDO.
     1733     DEFINE VARIABLE link-handle  AS CHARACTER NO-UNDO.
     1734     DEFINE VARIABLE rowid-string AS CHARACTER NO-UNDO.
     1735     DO i = 1 TO NUM-ENTRIES(p-tbl-list):
     1736         IF i > 1 THEN p-rowid-list = p-rowid-list + ",":U.
     1737         CASE ENTRY(i, p-tbl-list):
     1738       WHEN "List-field":U THEN p-rowid-list = p-rowid-list +
     1739           IF AVAILABLE List-field THEN STRING(ROWID(List-field))
     1740           ELSE "?":U.
     1741           OTHERWISE
     1742           DO:
     1743               RUN get-link-handle IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     1744                   INPUT "RECORD-SOURCE":U, OUTPUT link-handle) NO-ERROR.
     1745               IF link-handle NE "":U THEN
     1746               DO:
     1747                   IF NUM-ENTRIES(link-handle) > 1 THEN
     1748                       MESSAGE "send-records in ":U THIS-PROCEDURE:FILE-NAME
     1749                               "encountered more than one RECORD-SOURCE.":U SKIP
     1750                               "The first will be used.":U
     1751                               VIEW-AS ALERT-BOX ERROR.
     1752                   RUN send-records IN WIDGET-HANDLE(ENTRY(1,link-handle))
     1753                       (INPUT ENTRY(i, p-tbl-list), OUTPUT rowid-string).
     1754                   p-rowid-list = p-rowid-list + rowid-string.
     1755               END.
     1756               ELSE
     1757               DO:
     1758                   MESSAGE "Requested table":U ENTRY(i, p-tbl-list)
     1759                           "does not match tables in send-records":U
     1760                           "in procedure":U THIS-PROCEDURE:FILE-NAME ".":U SKIP
     1761                           "Check that objects are linked properly and that":U
     1762                           "database qualification is consistent.":U
     1763                       VIEW-AS ALERT-BOX ERROR.
     1764                   RETURN ERROR.
     1765               END.
     1766           END.
     1767           END CASE.
     1768       END.
     1769   END PROCEDURE.
     1770   PROCEDURE state-changed :
     1771     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE    NO-UNDO.
     1772     DEFINE INPUT PARAMETER p-state      AS CHARACTER NO-UNDO.
     1773     CASE p-state:
     1774       WHEN "update-begin":U THEN
     1775       DO:
     1776           adm-brs-in-update = yes.
     1777           RUN dispatch ('enable-fields':U).
     1778           IF RETURN-VALUE = "ADM-ERROR":U THEN
     1779           DO:
     1780             RUN new-state('update-failed,TABLEIO-SOURCE':U).
     1781             RUN new-state('update-complete':U).
     1782           END.
     1783           ELSE DO:
     1784             RUN dispatch ('apply-entry':U).
     1785             RUN new-state('update':U).
     1786           END.
     1787       END.
     1788       WHEN "update":U THEN
     1789         DO:
     1790           DEFINE VARIABLE group-link AS CHARACTER NO-UNDO INIT "":U.
     1791           RUN get-link-handle IN adm-broker-hdl
     1792               (INPUT THIS-PROCEDURE, 'GROUP-ASSIGN-TARGET':U, OUTPUT group-link)
     1793                   NO-ERROR.
     1794           IF LOOKUP(STRING(p-issuer-hdl), group-link) EQ 0 THEN
     1795             br_table:SENSITIVE IN FRAME F-Main = no.
     1796         END.
     1797       WHEN "update-complete":U THEN DO:
     1798           br_table:SENSITIVE IN FRAME F-Main = yes.
     1799           adm-brs-in-update = no.
     1800           RUN get-attribute IN p-issuer-hdl ('QUERY-OBJECT':U).
     1801           IF RETURN-VALUE NE "YES":U THEN
     1802           DO:
     1803             IF NUM-RESULTS("br_table":U) NE ? AND
     1804                NUM-RESULTS("br_table":U) NE 0
     1805             THEN DO:
     1806               GET CURRENT br_table.
     1807               RUN dispatch ('row-changed':U).
     1808             END.
     1809           END.
     1810           RUN new-state ('update-complete':U).
     1811       END.
     1812       WHEN "delete-complete":U THEN DO:
     1813          DEFINE VARIABLE sts AS LOGICAL NO-UNDO.
     1814          sts = br_table:DELETE-CURRENT-ROW() IN FRAME F-Main.
     1815          IF NUM-RESULTS("br_table":U) = 0 THEN
     1816            RUN notify('row-available':U).
     1817       END.
     1818       WHEN   'first-record':U        OR
     1819         WHEN 'last-record':U         OR
     1820         WHEN 'only-record':U         OR
     1821         WHEN 'not-first-or-last':U   OR
     1822         WHEN 'no-record-available':U OR
     1823         WHEN 'no-external-record-available':U THEN
     1824           RUN set-attribute-list('Query-Position=':U + p-state).
     1825     END CASE.
     1826     Apply "VALUE-CHANGED" to br_table in frame F-Main.
     1827   END PROCEDURE.
