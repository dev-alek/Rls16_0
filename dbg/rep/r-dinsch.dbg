      108   define  stream PrnLibStream.
      109   procedure prn-lib-prn-file :
      110     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      111     define input parameter p-DIsabledoptions as integer no-undo .
      112     define variable v-report-name as character no-undo .
      113     define variable v-user-action as character no-undo .
      114     define variable v-printed     as logical   no-undo .
      115     define variable v-exist       as logical   no-undo .
      116     do
      117       on error undo, return error
      118       :
      119       run prn-lib-get-report-name  in this-procedure (
      120         input parParentProc
      121         ,output v-report-name
      122         ).
      123   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      124   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      125     (input  v-report-name
      126     ,input  2
      127     ,output v-exist
      128     )  .
      129       if NOT v-exist then
      130       DO:
      131         Message
      132           "Нет заданий на печать ! "
      133           view-as alert-box .
      134         Return  .
      135       End.
      136       run gbl/prnfilen.w
      137         (input  ""
      138         ,input  p-DisabledOptions
      139         ,input  string(v-report-name )
      140         ,input  7
      141         ,output v-user-action
      142         ,output v-printed
      143         ) .
      144       if v-printed then
      145       do:
      146         return "YES" .
      147       end.
      148       else
      149       do:
      150         return "NO" .
      151       end.
      152     end.
      153   end procedure.
      154   procedure prn-lib-open-stream :
      155     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      156     define input parameter p-page-size    as integer no-undo .
      157     define input parameter p-is-stream    as logical no-undo .
      158     define input parameter p-append       as logical no-undo .
      159     define variable v-report-name as character no-undo .
      160     do
      161       on error undo, return error
      162       :
      163       run prn-lib-get-report-name  in this-procedure (
      164         input parParentProc
      165         ,output v-report-name
      166         ).
      167       if p-is-stream then
      168       do:
      169         if p-append then
      170         do:
      171           output stream PrnLibStream to value( v-report-name )
      172             page-size value(p-page-size) append .
      173         end.
      174         if not p-append then
      175         do:
      176           output stream PrnLibStream to value( v-report-name )
      177             page-size value(p-page-size) .
      178         end.
      179       end.
      180       if not p-is-stream then
      181       do:
      182         if p-append then
      183         do:
      184           output to value( v-report-name )
      185             page-size value(p-page-size) append .
      186         end.
      187         if not p-append then
      188         do:
      189           output to value( v-report-name )
      190             page-size value(p-page-size) .
      191         end.
      192       end.
      193     end.
      194   end procedure.
      195   procedure prn-lib-open-exp :
      196     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      197     define input parameter p-is-stream    as logical no-undo .
      198     define input parameter p-is-append    as logical no-undo .
      199     define output parameter p-ReportFileName as char init "report" no-undo.
      200     define output parameter p-process as logical no-undo .
      201     define variable glog as logical no-undo .
      202     do
      203       on error undo, return error
      204       :
      205       SYSTEM-DIALOG GET-FILE p-ReportFileName
      206         TITLE      "Укажите путь"
      207         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      208         ASK-OVERWRITE
      209         CREATE-TEST-FILE
      210         SAVE-AS
      211         USE-FILENAME
      212         DEFAULT-EXTENSION "txt"
      213         UPDATE glog
      214         .
      215       if not glog then  return.
      216       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      217       if p-is-stream then
      218       do:
      219         if p-is-append then
      220         do:
      221           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      222         end.
      223         else
      224         do:
      225           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      226         end.
      227       end.
      228       else
      229       do:
      230         if p-is-append then
      231         do:
      232           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      233         end.
      234         else
      235         do:
      236           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      237         end.
      238       end.
      239       p-process = yes.
      240     end.
      241   end procedure.
      242   procedure prn-lib-get-report-name :
      243     define input parameter parParentProc  as widget-handle no-undo.
      244     define output parameter p-report-name as character no-undo .
      245     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      246   end procedure.
      247   procedure prn-lib-reportviewer-report-name :
      248     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      249     define input parameter p-report-name-html as character no-undo .
      250     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      251   end procedure.
      252   procedure prn-lib-reportviewer :
      253     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      254     define input parameter p-report-name-html as character no-undo .
      255     define input parameter p-param        as character no-undo .
      256     define variable v-excel           as character no-undo init 'TRUE' .
      257     define variable v-value-character as character no-undo .
      258     define variable v-value-integer   as character no-undo .
      259     define variable v-value-date      as date      no-undo .
      260     define variable v-value-decimal   as decimal   no-undo .
      261     define variable rep-excel         as logical   no-undo .
      262     define variable excel-string      as character no-undo .
      263     define variable v-param-type      as character no-undo .
      264     define variable v-tth             as handle    no-undo .
      265     run adm/shattri.p (
      266       input "get":U
      267       ,input  ""
      268       ,input  0
      269       ,input  'report-glob':U
      270       ,input  'rep-excel':U
      271       ,output v-value-character
      272       ,output v-value-date
      273       ,output v-value-decimal
      274       ,output v-value-integer
      275       ,output rep-excel
      276       ,output v-param-type
      277       ,INPUT-OUTPUT table-handle v-tth
      278       )  .
      279     if rep-excel then v-excel = "TRUE" .
      280     else v-excel = "FALSE" .
      281     if p-param eq ""
      282     then
      283        p-param = "EXCEL:" + v-excel.
      284     else
      285        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      286     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      287   end procedure.
      288   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      289   procedure factord :
      290     define input  parameter p-fact-date            as date    no-undo .
      291     define input  parameter p-fact-time            as integer no-undo .
      292     define input  parameter p-fact-num             as integer no-undo .
      293     define input  parameter p-shift-date           as date    no-undo .
      294     define input  parameter p-shift-num            as integer no-undo .
      295     define input  parameter p-shift-on             as logical no-undo .
      296     define output parameter p-fact-order           as decimal no-undo .
      297     define output parameter p-shift-end-fact-order as decimal no-undo .
      298     define output parameter p-day-end-fact-order   as decimal no-undo .
      299     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      300     if p-fact-date = ?
      301     then do:
      302       return error "Не указана фактическая дата" .
      303     end.
      304     define variable v-fact-date-num as integer no-undo .
      305     assign
      306       v-fact-date-num = integer(p-fact-date)
      307     .
      308     if p-fact-num = ?
      309     or p-fact-num = 0
      310     then do:
      311       return error "Не задан p-fact-num " + string(p-fact-num) .
      312     end.
      313     if p-fact-num < 0
      314     then do:
      315       return error "Отрицательный fact-num " + string(p-fact-num) .
      316     end.
      317     if p-fact-num >= 100000000
      318     then do:
      319       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      320     end.
      321     if p-shift-on = true
      322     then do:
      323       if p-shift-date = ?
      324       then do:
      325         return error "Не задана дата смены" .
      326       end.
      327       if p-shift-num = ?
      328       or p-shift-num = 0
      329       then do:
      330         return error "Не задан номер смены" .
      331       end.
      332     end.
      333     else do:
      334       assign
      335         p-shift-date = p-fact-date
      336         p-shift-num  = 24
      337       .
      338     end.
      339     define variable v-shift-offset as integer no-undo .
      340     if p-shift-date = p-fact-date
      341     then do:
      342       assign
      343         v-shift-offset = 1
      344       .
      345     end.
      346     if p-shift-date < p-fact-date
      347     then do:
      348       assign
      349         v-shift-offset = 0
      350       .
      351     end.
      352     if p-shift-date > p-fact-date
      353     then do:
      354       message
      355         vss-workfile vss-revision vss-description skip
      356         "Неправильная дата закрытия смены" skip
      357         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      358         view-as alert-box error .
      359       undo, return error
      360         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      361           ,string(p-fact-date, '99/99/9999':U)
      362           ,string(p-shift-date, '99/99/9999':U)
      363           )
      364       .
      365     end.
      366     if p-shift-num < 1
      367     or p-shift-num > 24
      368     then do:
      369       message
      370         vss-workfile vss-revision vss-description skip
      371         "Неправильный номер смены" skip
      372         "p-shift-num" p-shift-num skip
      373         view-as alert-box error .
      374       undo, return error return-value .
      375     end.
      376     assign
      377       p-fact-order           = v-fact-date-num
      378                              + v-shift-offset * 0.5
      379                              + p-shift-num    * 0.02 - 0.01
      380                              + p-fact-num     * 0.0000000001
      381       p-shift-end-fact-order = v-fact-date-num
      382                              + v-shift-offset * 0.5
      383                              + p-shift-num    * 0.02
      384       p-day-end-fact-order   = v-fact-date-num
      385                              + 0.99
      386     .
      387     if p-fact-order           <= v-fact-date-num
      388     or p-shift-end-fact-order <= v-fact-date-num
      389     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      390     or p-shift-end-fact-order >= p-day-end-fact-order
      391     then do:
      392       message
      393         vss-workfile vss-revision vss-description skip
      394         "Внутренняя ошибка при генерации фактического номера" skip
      395         "p-fact-date"            p-fact-date            skip
      396         "p-fact-time"            p-fact-time            skip
      397         "p-fact-num"             p-fact-num             skip
      398         "p-shift-date"           p-shift-date           skip
      399         "p-shift-num"            p-shift-num            skip
      400         "p-shift-on"             p-shift-on             skip
      401         "p-shift-end-fact-order" p-shift-end-fact-order skip
      402         "p-day-end-fact-order"   p-day-end-fact-order   skip
      403         "v-fact-date-num"        v-fact-date-num        skip
      404         view-as alert-box error .
      405       undo, return error return-value .
      406     end.
      407   end procedure.
      408   procedure day-begin-fact-order :
      409     define input  parameter p-fact-date            as date    no-undo .
      410     define output parameter p-day-begin-fact-order as decimal no-undo .
      411     do
      412     on error undo, return error return-value
      413     :
      414       if p-fact-date = ?
      415       then do:
      416         assign
      417           p-day-begin-fact-order = 0
      418         .
      419       end.
      420       else do:
      421         assign
      422           p-day-begin-fact-order = integer(p-fact-date)
      423         .
      424       end.
      425     end.
      426   end procedure.
      427   procedure factord-max-fact-order :
      428     define output parameter p-max-fact-order as decimal   no-undo .
      429     do
      430     on error undo, return error return-value
      431     :
      432       run day-begin-fact-order in this-procedure
      433         (input  date(1, 1, 5000)
      434         ,output p-max-fact-order
      435         ) .
      436     end.
      437   end procedure.
      438   procedure factord-cut-archive :
      439     define input  parameter p-obj-type             as character no-undo .
      440     define input  parameter p-obj-code             as integer   no-undo .
      441     define input  parameter p-fact-date            as date      no-undo .
      442     define output parameter p-shift-on             as logical   no-undo .
      443     define output parameter p-shift-date           as date      no-undo .
      444     define output parameter p-shift-num            as integer   no-undo .
      445     define output parameter p-day-end-fact-order   as decimal   no-undo .
      446     define output parameter p-shift-end-fact-order as decimal   no-undo .
      447     define variable v-fact-order as decimal   no-undo .
      448     define buffer buf_shift-obj for ub.shift-obj .
      449     do
      450     on error undo, return error return-value
      451     :
      452   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      453   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      454     (input  p-obj-type
      455     ,input  p-obj-code
      456     ,input  'shift-on=request'
      457     ,output p-shift-on
      458     ) no-error .
      459       if error-status :error
      460       then do:
      461         message
      462           vss-workfile vss-revision vss-description skip
      463           "Ошибка при определении атрибута объекта" skip
      464           "Объект" p-obj-type p-obj-code skip
      465           error-status :get-message(1) skip
      466           return-value skip
      467           view-as alert-box error .
      468         undo, return error return-value .
      469       end.
      470       if p-shift-on = false
      471       then do:
      472         assign
      473           p-shift-date               = ?
      474           p-shift-num                = 0
      475         .
      476       end.
      477       else do:
      478         find first buf_shift-obj share-lock
      479           where buf_shift-obj.obj-type   = p-obj-type
      480             and buf_shift-obj.obj-code   = p-obj-code
      481             and buf_shift-obj.shift-date > p-fact-date
      482           use-index pi
      483           no-error .
      484         if not available buf_shift-obj
      485         or buf_shift-obj.status_ <> 'зкр':U
      486         then do:
      487           message
      488             vss-workfile vss-revision vss-description skip
      489             "Невозможно вычислить последнюю смену" skip
      490             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      491             "Объект" p-obj-type p-obj-code skip
      492             "Дата" p-fact-date skip
      493             view-as alert-box error .
      494           undo, return error return-value .
      495         end.
      496         find last buf_shift-obj share-lock
      497           where buf_shift-obj.obj-type = p-obj-type
      498             and buf_shift-obj.obj-code = p-obj-code
      499             and buf_shift-obj.shift-date <= p-fact-date
      500           use-index pi
      501           no-error .
      502         if available buf_shift-obj
      503         then do:
      504           if  buf_shift-obj.status_ = 'зкр':U
      505           then do:
      506             assign
      507               p-shift-date = buf_shift-obj.shift-date
      508               p-shift-num  = buf_shift-obj.shift-num
      509             .
      510           end.
      511           else do:
      512             message
      513               vss-workfile vss-revision vss-description skip
      514               "Невозможно вычислить последнюю смену" skip
      515               "Статус смены отличен от статуса" 'зкр':U skip
      516               "Объект" p-obj-type p-obj-code skip
      517               "Дата" p-fact-date skip
      518               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      519               view-as alert-box error .
      520             undo, return error return-value .
      521           end.
      522         end.
      523         else do:
      524           assign
      525             p-shift-date = p-fact-date - 1
      526             p-shift-num  = 1
      527           .
      528         end.
      529       end.
      530       run factord in this-procedure
      531         (input  p-fact-date
      532         ,input  1
      533         ,input  1
      534         ,input  p-shift-date
      535         ,input  p-shift-num
      536         ,input  p-shift-on
      537         ,output v-fact-order
      538         ,output p-shift-end-fact-order
      539         ,output p-day-end-fact-order
      540         ) no-error .
      541       if error-status :error
      542       then do:
      543         message
      544           vss-workfile vss-revision vss-description skip
      545           "Ошибка при вызове процедуры factord"
      546           error-status :get-message(1) skip
      547           return-value skip
      548           view-as alert-box error .
      549         undo, return error return-value .
      550       end.
      551     end.
      552   end procedure.
      553   procedure factord-lock-shift :
      554     define input  parameter p-obj-type  as character no-undo .
      555     define input  parameter p-obj-code  as integer   no-undo .
      556     define input  parameter p-fact-date as date      no-undo .
      557     define parameter buffer buf_shift-obj for ub.shift-obj .
      558     define variable v-shift-on      as logical   no-undo .
      559     define variable v-extra-message as character no-undo .
      560     define variable v-error as character no-undo .
      561     do
      562     on error undo, return error return-value
      563     :
      564   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      565   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      566     (input  p-obj-type
      567     ,input  p-obj-code
      568     ,input  'shift-on=request'
      569     ,output v-shift-on
      570     ) no-error .
      571       if error-status :error
      572       then do:
      573         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
      574         undo, return error v-error .
      575       end.
      576       if v-shift-on = true
      577       then do:
      578         find first buf_shift-obj share-lock
      579           where buf_shift-obj.obj-type   = p-obj-type
      580             and buf_shift-obj.obj-code   = p-obj-code
      581             and buf_shift-obj.shift-date > p-fact-date
      582           use-index pi
      583           no-error .
      584         if not available buf_shift-obj
      585         or buf_shift-obj.status_ <> 'зкр':U
      586         then do:
      587           find last buf_shift-obj
      588             where buf_shift-obj.obj-type = p-obj-type
      589               and buf_shift-obj.obj-code = p-obj-code
      590               and buf_shift-obj.status_  = 'зкр':U
      591             use-index stts
      592             no-error .
      593           if available buf_shift-obj
      594           then do:
      595             assign
      596               v-extra-message =
      597                     substitute("Дата начала последеней закрытой смены на объекте &1"
      598                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
      599                               )
      600             .
      601           end.
      602           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
      603           undo, return error v-error .
      604         end.
      605       end.
      606     end.
      607   end procedure.
      608   procedure factord-end-day :
      609     define input  parameter p-fact-date            as date    no-undo .
      610     define output parameter p-day-end-fact-order   as decimal no-undo .
      611     do
      612     on error undo, return error return-value
      613     :
      614       if p-fact-date = ?
      615       then do:
      616         return error "Не указана фактическая дата" .
      617       end.
      618       assign
      619         p-day-end-fact-order = integer(p-fact-date) + 0.99
      620       .
      621     end.
      622   end procedure.
      623   procedure factord-to-date :
      624     define input  parameter p-fact-order as decimal no-undo .
      625     define output parameter p-fact-date  as date    no-undo .
      626     define variable v-ref-date  as date      no-undo .
      627     define variable v-ref-delta as integer   no-undo .
      628     do
      629     on error undo, return error return-value
      630     :
      631       if p-fact-order = ?
      632       or p-fact-order = 0
      633       then do:
      634         return error "Не указан fact-order" .
      635       end.
      636       assign
      637         v-ref-date  = date(1, 1, 2000)
      638       .
      639       assign
      640         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
      641       .
      642       assign
      643         p-fact-date = v-ref-date + v-ref-delta
      644       .
      645     end.
      646   end procedure.
      647   procedure factord-to-fact-num :
      648     define input  parameter p-fact-order as decimal no-undo .
      649     define output parameter p-fact-num   as integer no-undo .
      650     define variable v-fact-order-trunc as decimal no-undo .
      651     do
      652     on error undo, return error return-value
      653     :
      654       if p-fact-order = ?
      655       or p-fact-order = 0
      656       then do:
      657         return error "Не указан fact-order" .
      658       end.
      659       assign
      660        v-fact-order-trunc = truncate(p-fact-order, 2)
      661       .
      662       assign
      663         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
      664       .
      665     end.
      666   end procedure.
      667   procedure factord-to-shift-num :
      668     define input  parameter p-fact-order as decimal no-undo .
      669     define output parameter p-shift-num   as integer no-undo .
      670     define variable  p-shift-numd  as decimal   no-undo .
      671     define variable v-fact-order-trunc as decimal no-undo .
      672     do
      673     on error undo, return error return-value
      674     :
      675       if p-fact-order = ?
      676       or p-fact-order = 0
      677       then do:
      678         return error "Не указан fact-order" .
      679       end.
      680       assign
      681        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
      682       .
      683       if v-fact-order-trunc < 0.5 then do:
      684         v-fact-order-trunc = v-fact-order-trunc + 0.5.
      685       end.
      686       assign
      687         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
      688         .
      689        assign
      690         p-shift-num = truncate (p-shift-numd , 0)
      691       .
      692     end.
      693   end procedure.
      694   do
      695   on error undo, return error
      696   :
      697     define variable v-ind             as integer   no-undo .
      698     define variable ii as integer initial 0  no-undo .
      699     define variable Counter1               as integer   no-undo .
      700     define variable Line                   as character no-undo .
      701     define variable v-sum1        as decimal   no-undo .
      702     define variable v-sum2        as decimal   no-undo .
      703     define variable v-all-sum1        as decimal   no-undo .
      704     define variable v-all-sum2        as decimal   no-undo .
      705     define variable v-NameString  as character no-undo .
      706     assign  Counter1 = 0 .
      707   define variable v-account as integer init 0 no-undo .
      708   define variable v-account-lavel as character no-undo .
      709   define variable v-button-stop as logical no-undo .
      710   define variable v-kol-spice as integer no-undo .
      711   define variable v-kol-spice2 as integer no-undo .
      712   define variable v-kol-spice3 as integer no-undo .
      713   DEFINE VARIABLE StopProcessing AS LOGICAL NO-UNDO.
      714   DEFINE BUTTON StopBtn AUTO-END-KEY
      715        LABEL "Стоп"
      716        SIZE 10 BY 1.
      717   DEFINE VARIABLE RecordsDone AS INTEGER FORMAT ">,>>>,>>>,>>9":U INITIAL 0
      718        LABEL "Обработано записей"
      719         VIEW-AS TEXT
      720        SIZE 14 BY .67 NO-UNDO.
      721   DEFINE VARIABLE RecordsString AS CHARACTER FORMAT "X(60)"
      722         VIEW-AS TEXT
      723        SIZE 53.25 BY .67
      724        FGCOLOR 1  NO-UNDO.
      725   DEFINE VARIABLE RecordsString2 AS CHARACTER FORMAT "X(60)"
      726         VIEW-AS TEXT
      727        SIZE 53.25 BY .67
      728        FGCOLOR 1  NO-UNDO.
      729   DEFINE VARIABLE RecordsString3 AS CHARACTER FORMAT "X(60)"
      730         VIEW-AS TEXT
      731        SIZE 53.25 BY .67
      732        FGCOLOR 1  NO-UNDO.
      733   DEFINE RECTANGLE RECT-1
      734        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      735        SIZE 55.13 BY 4.46.
      736   DEFINE FRAME InfoFrame
      737        StopBtn AT ROW 4.25 COL 21.75
      738        RecordsString AT ROW 1.21 COL 2 NO-LABEL
      739        RecordsString2 AT ROW 1.96 COL 2 NO-LABEL
      740        RecordsString3 AT ROW 2.58 COL 2 NO-LABEL
      741        RecordsDone AT ROW 3.42 COL 24.88 COLON-ALIGNED
      742        RECT-1 AT ROW 1 COL 1
      743       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      744            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      745            TITLE "Процесс"
      746            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
      747   define variable mFrameView      as logical   no-undo init yes.
      748     define variable mFramHandle as handle no-undo.
      749     mFramHandle = frame InfoFrame:handle.
      750     if  log-manager:logfile-name ne ?
      751     then DO:
      752         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      753         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      754         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
      755     end.
      756     mFrameView = not session:batch-mode and mFramHandle:visible.
      757     if mFrameView
      758     then do:
      759       ASSIGN
      760          FRAME InfoFrame:HIDDEN                           = TRUE
      761          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
      762     end.
      763   ON CHOOSE OF StopBtn IN FRAME InfoFrame
      764   DO:
      765     IF not StopProcessing THEN
      766       Message "Вы действительно хотите прервать" SKIP
      767               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
      768                 UPDATE StopProcessing.
      769     IF StopProcessing THEN do:
      770        if mFrameView
      771        then do:
      772           HIDE FRAME InfoFrame.
      773        end.
      774     End.
      775   END.
      776   assign v-account = ( if integer( 1 ) = 0 then 100 else integer( 1 ) ).
      777     if  log-manager:logfile-name ne ?
      778     then DO:
      779         log-manager:write-message("ON mFrameView=" + string(mFrameView), "frameRepError").
      780     end.
      781     if not session:batch-mode then
      782     do:
      783       VIEW FRAME InfoFrame.
      784       mFrameView = true.
      785     end.
      786      v-button-stop = false .
      787         if mFrameView
      788         then do:
      789         if v-button-stop then view STOPBTN in frame InfoFrame.
      790                          else Hide STOPBTN in frame InfoFrame.
      791         end.
      792     define buffer buf_fin-schet for fin-schet .
      793     define buffer buf_fin-bank  for fin-bank .
      794     define buffer buf_fin-doc   for fin-doc .
      795     define buffer buf_currency  for currency .
      796     define variable  v-fact-order1           as decimal   no-undo .
      797     run day-begin-fact-order in this-procedure ( input p-date1, output v-fact-order1 ).
      798     define variable  v-fact-order2           as decimal   no-undo .
      799     run day-begin-fact-order in this-procedure ( input p-date2 + 1 , output v-fact-order2 ).
      800   if session :set-wait-state( "compiler" ) then.
      801     Line = fill("-", 250).
      802     DEFINE frame f-doc
      803         sym1  buf_fin-doc.doc-date       column-label "Дата! ! "                format "99/99/99"                 space(0)
      804         sym2  buf_fin-doc.cor-acc-value  column-label "Кор.!счет! "             format "X(7)"                     space(0)
      805         sym3  buf_fin-doc.an-uchet-value column-label "Шифр!аналит!учета"       format "X(7)"                     space(0)
      806         sym4  buf_fin-doc.cel-nazn-value column-label "Шифр!целев.!назн."       format "X(7)"                     space(0)
      807         sym5  v-sum1                     column-label "Сумма!поступления! "     format "->>>>,>>>,>>>,>>9.99"     space(0)
      808         sym6  v-sum2                     column-label "Сумма!выбытия! "         format "->>>>,>>>,>>>,>>9.99"     space(0)
      809         sym7  buf_fin-doc.prn-doc-code   column-label "Номер!платеж.!поруч."    format "X(10)"                    space(0)
      810         sym8  buf_fin-doc.payer-name     column-label "Плательщик! ! "          format "X(20)"                    space(0)
      811         sym9  buf_fin-doc.receiver-name  column-label "Получатель! ! "          format "X(20)"                    space(0)
      812         sym10 buf_fin-doc.naznach-plat   column-label "Назначение!платежа! "    format "X(58)"                    space(0)
      813         sym11
      814     HEADER
      815         string( "Дата печати : " + string(TODAY , "99.99.9999") + " , " + string(TIME, "HH:MM") ) AT 5 format "X(50)"
      816         string( "Страница " + string( PAGE-NUMBER( PrnLibStream )  , ">>9") ) AT 100 format "X(15)" SKIP Line format "X(198)" AT 1
      817     with width 235 down stream-io.
      818     run prn-lib-open-stream  in this-procedure (input parParentProc,input 43,input yes,input no).
      819     FORM HEADER
      820         Line format "X(198)" AT 1 SKIP   "Продолжение - на следующей странице" AT 30 SKIP
      821         with FRAME BottomFrame width 235 PAGE-BOTTOM NO-LABELS NO-BOX .
      822     VIEW stream PrnLibStream FRAME BottomFrame .
      823     FORM with FRAME f-doc .
      824     PUT stream PrnLibStream SPACE(30) string( "Динамика финансового движения по счету c " + string(p-date1,"99/99/9999") + "г. по " + string(p-date2,"99/99/9999") + "г.") format "X(120)" SKIP .
      825     find first buf_fin-schet no-lock where recid (buf_fin-schet) = p-code-schet no-error .
      826     find first buf_fin-bank  no-lock where buf_fin-bank.host-code   = buf_fin-schet.host-code and buf_fin-bank.code-bank  = buf_fin-schet.code-bank no-error .
      827     find first buf_currency  no-lock where buf_currency.curr-code   = buf_fin-schet.curr-code .
      828     PUT stream PrnLibStream string("Р/С " + buf_fin-schet.r-schet + " (в.н. " + string(buf_fin-schet.code-schet) + ") в банке " + buf_fin-bank.short-name + " ,валюта: " + buf_currency.curr-abbr) format "X(160)"   skip .
      829     case p-num-key :
      830       when 1 then do:
      831         case entry(1,p-key-list) :
      832           when "buf_fin-doc.doc-date"      then do:
      833   define variable vss-include-info6 as character format "X(65)" no-undo
      834   initial "@(#)$Workfile$ $Revision$".
      835         for each buf_fin-doc no-lock
      836           where buf_fin-doc.host-code = p-curr-host-code
      837             and ( buf_fin-doc.receiver-code-schet = buf_fin-schet.code-schet or buf_fin-doc.payer-code-schet = buf_fin-schet.code-schet )
      838             and buf_fin-doc.status_ = 'факт':U
      839             and buf_fin-doc.fact-order >= v-fact-order1
      840             and buf_fin-doc.fact-order < v-fact-order2
      841             and (buf_fin-doc.fin-doc-type = 'ппп':U or buf_fin-doc.fin-doc-type = 'рпп':U)
      842         break by buf_fin-doc.doc-date :
      843           run prn-line in this-procedure .
      844         end.
      845     end.
      846           when "buf_fin-doc.cor-acc"  then do:
      847   define variable vss-include-info7 as character format "X(65)" no-undo
      848   initial "@(#)$Workfile$ $Revision$".
      849         for each buf_fin-doc no-lock
      850           where buf_fin-doc.host-code = p-curr-host-code
      851             and ( buf_fin-doc.receiver-code-schet = buf_fin-schet.code-schet or buf_fin-doc.payer-code-schet = buf_fin-schet.code-schet )
      852             and buf_fin-doc.status_ = 'факт':U
      853             and buf_fin-doc.fact-order >= v-fact-order1
      854             and buf_fin-doc.fact-order < v-fact-order2
      855             and (buf_fin-doc.fin-doc-type = 'ппп':U or buf_fin-doc.fin-doc-type = 'рпп':U)
      856         break by buf_fin-doc.cor-acc :
      857           run prn-line in this-procedure .
      858         end.
      859     end.
      860           when "buf_fin-doc.an-uchet-code" then do:
      861   define variable vss-include-info8 as character format "X(65)" no-undo
      862   initial "@(#)$Workfile$ $Revision$".
      863         for each buf_fin-doc no-lock
      864           where buf_fin-doc.host-code = p-curr-host-code
      865             and ( buf_fin-doc.receiver-code-schet = buf_fin-schet.code-schet or buf_fin-doc.payer-code-schet = buf_fin-schet.code-schet )
      866             and buf_fin-doc.status_ = 'факт':U
      867             and buf_fin-doc.fact-order >= v-fact-order1
      868             and buf_fin-doc.fact-order < v-fact-order2
      869             and (buf_fin-doc.fin-doc-type = 'ппп':U or buf_fin-doc.fin-doc-type = 'рпп':U)
      870         break by buf_fin-doc.an-uchet-code :
      871           run prn-line in this-procedure .
      872         end.
      873     end.
      874           when "buf_fin-doc.cel-nazn-code" then do:
      875   define variable vss-include-info9 as character format "X(65)" no-undo
      876   initial "@(#)$Workfile$ $Revision$".
      877         for each buf_fin-doc no-lock
      878           where buf_fin-doc.host-code = p-curr-host-code
      879             and ( buf_fin-doc.receiver-code-schet = buf_fin-schet.code-schet or buf_fin-doc.payer-code-schet = buf_fin-schet.code-schet )
      880             and buf_fin-doc.status_ = 'факт':U
      881             and buf_fin-doc.fact-order >= v-fact-order1
      882             and buf_fin-doc.fact-order < v-fact-order2
      883             and (buf_fin-doc.fin-doc-type = 'ппп':U or buf_fin-doc.fin-doc-type = 'рпп':U)
      884         break by buf_fin-doc.cel-nazn-code :
      885           run prn-line in this-procedure .
      886         end.
      887     end.
      888         end.
      889       end.
      890       when 2 then do:
      891         run lavel-2 in this-procedure .
      892       end.
      893       when 3 then do:
      894         run lavel-3 in this-procedure .
      895       end.
      896       when 4 then do:
      897         run lavel-4 in this-procedure .
      898       end.
      899     end.
      900     PUT STREAM PrnLibStream Line format "X(198)".
      901     display stream PrnLibStream
      902       sym1 "Итого" @ buf_fin-doc.cel-nazn-value sym2 sym3 sym4 v-all-sum1 @ v-sum1 v-all-sum2 @ v-sum2 sym5 sym6 sym7 sym8 sym9 sym10 sym11
      903     with frame f-doc.
      904     down stream PrnLibStream with frame f-doc .
      905     PUT STREAM PrnLibStream Line format "X(198)".
      906     HIDE stream PrnLibStream FRAME BottomFrame .
      907     OUTPUT stream PrnLibStream CLOSE.
      908   if mFrameView
      909   then do:
      910      HIDE FRAME InfoFrame.
      911   end.
      912   if session :set-wait-state( "" ) then.
      913     run prn-lib-prn-file in this-procedure (input parParentProc,input 8).
      914   end.
      915   procedure prn-line :
      916     do on error undo, return error return-value :
      917       if buf_fin-doc.fin-doc-type = 'ппп':U then assign v-all-sum1 = v-all-sum1 + buf_fin-doc.sum-doc .
      918       else                                                  assign v-all-sum2 = v-all-sum2 + buf_fin-doc.sum-doc .
      919       display stream PrnLibStream
      920         sym1  buf_fin-doc.doc-date
      921         sym2  buf_fin-doc.cor-acc-value
      922         sym3  buf_fin-doc.an-uchet-value
      923         sym4  buf_fin-doc.cel-nazn-value
      924         sym5  (if buf_fin-doc.fin-doc-type = 'ппп':U then buf_fin-doc.sum-doc else 0) @ v-sum1
      925         sym6  (if buf_fin-doc.fin-doc-type = 'ппп':U then 0 else buf_fin-doc.sum-doc) @ v-sum2
      926         sym7  buf_fin-doc.prn-doc-code
      927         sym8  buf_fin-doc.payer-name
      928         sym9  buf_fin-doc.receiver-name
      929         sym10 buf_fin-doc.naznach-plat
      930         sym11
      931       with frame f-doc.
      932       down stream PrnLibStream with frame f-doc .
      933     end.
      934   end procedure.
      935   procedure PutColumnTitulExcel :
      936     do
      937     on error undo, return error return-value
      938     :
      939      end.
      940   end procedure.
      941   procedure lavel-2 :
      942     do on error undo, return error return-value :
      943         case entry(1,p-key-list) :
      944           when "buf_fin-doc.doc-date"      then do:
      945             case entry(2,p-key-list) :
      946               when "buf_fin-doc.cor-acc"  then do:
      947   define variable vss-include-info10 as character format "X(65)" no-undo
      948   initial "@(#)$Workfile$ $Revision$".
