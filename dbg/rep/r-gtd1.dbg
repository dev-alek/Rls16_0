      142   procedure create_obj-list :
      143      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      144      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      145      do
      146      on error undo, return error return-value
      147      :
      148         define buffer cli-obj for ub.clients .
      149         define variable p-var as integer no-undo .
      150         define buffer buf_obj-list for obj-list .
      151         find last buf_obj-list  use-index pi no-error .
      152         if available buf_obj-list
      153         then
      154            p-var = buf_obj-list.obj-id + 1.
      155         else
      156            p-var = 1.
      157         find first cli-obj where
      158                   cli-obj.obj-type = p-obj-type
      159               and cli-obj.obj-code = p-obj-code
      160         no-lock no-error.
      161         if available cli-obj
      162         then do:
      163            create buf_obj-list.
      164            assign
      165               buf_obj-list.obj-id   = p-var
      166               buf_obj-list.obj-code = cli-obj.obj-code
      167               buf_obj-list.obj-type = cli-obj.obj-type
      168               buf_obj-list.obj-name = cli-obj.obj-name
      169               buf_obj-list.db-num   = cli-obj.db-num
      170            .
      171         end.
      172      end.
      173   end.
