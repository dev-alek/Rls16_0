     1298     ,output varempty-scale
     1299     ) no-error .
     1300   if error-status :error then do:
     1301     message
     1302       vss-workfile vss-revision vss-description skip
     1303       "Ошибка при определении атрибута признака" skip
     1304       "Артикул" buf_doc-line.artic buf_doc-line.prod-type buf_doc-line.prod-code skip
     1305       "Признак" varroot-node skip
     1306       "Запрашивался атрибут" "empty-scale=request" skip
     1307       error-status :get-message(1) skip
     1308       return-value skip
     1309       view-as alert-box error .
     1310     undo, return error .
     1311   end.
     1312   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1313   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1314     (output varoutvprb
     1315     )  .
     1316   if varoutvprb = "base":u then do:
     1317     assign
     1318           road-tax-base-sale    =  (if buf_doc-line.road-tax = ? then 0 else buf_doc-line.road-tax * 1)
     1319       excise-base-sale      =  (if buf_doc-line.excise   = ? then 0 else buf_doc-line.excise   * 1)
     1320     .
     1321   end.
     1322   else do:
     1323     assign
     1324           road-tax-base-sale    =  (if buf_doc-line.road-tax = ? then 0 else buf_doc-line.road-tax / buf_trn-doc.base-rate * buf_trn-doc.base-scale)
     1325       excise-base-sale      =  (if buf_doc-line.excise   = ? then 0 else buf_doc-line.excise   / buf_trn-doc.base-rate * buf_trn-doc.base-scale)
     1326     .
     1327   end.
     1328   if varoutvprb = "rubl":u then do:
     1329     assign
     1330           road-tax-rubl-sale    = (if buf_doc-line.road-tax = ? then 0 else buf_doc-line.road-tax * 1)
     1331       excise-rubl-sale      = (if buf_doc-line.excise   = ? then 0 else buf_doc-line.excise   * 1) .
     1332   end.
     1333   else do:
     1334     assign
     1335           road-tax-rubl-sale    = (if buf_doc-line.road-tax = ? then 0 else buf_doc-line.road-tax * buf_trn-doc.base-rate / buf_trn-doc.base-scale)
     1336       excise-rubl-sale      = (if buf_doc-line.excise   = ? then 0 else buf_doc-line.excise   * buf_trn-doc.base-rate / buf_trn-doc.base-scale) .
     1337   end.
     1338   assign
