     1230           and buf_gds-dtl.artic     = buf_doc-line.artic
     1231           and buf_gds-dtl.prod-type = buf_doc-line.prod-type
     1232           and buf_gds-dtl.prod-code = buf_doc-line.prod-code
     1233       on error undo, return error
     1234       :
     1235           if buf_trn-doc.doc-type <> 'инв':U
     1236           then do:
     1237               if buf_trn-doc.doc-type = 'при':U
     1238               or buf_trn-doc.doc-type = 'возврат':U
     1239               then do:
     1240                   assign
     1241                       v-gds-dtl-fact-qnty = buf_gds-dtl.fact-qnty
     1242                   .
     1243               end.
     1244               else do:
     1245                   assign
     1246                       v-gds-dtl-fact-qnty = - buf_gds-dtl.fact-qnty
     1247                   .
     1248               end.
     1249           end.
     1250           else do:
     1251               assign
     1252                   v-gds-dtl-fact-qnty = buf_gds-dtl.doc-qnty
     1253               .
     1254           end.
     1255           if v-gds-dtl-fact-qnty <> 0
     1256           then do:
     1257   if buf_trn-doc.ext-doc-type = 'ot':U or
     1258      buf_trn-doc.ext-doc-type = ?                 then do:
     1259     assign
     1260      out-vatp-have-vat-slt = yes.
     1261   end.
     1262   else do:
     1263     find first out-vatp_doc-attr no-lock
     1264       where out-vatp_doc-attr.doc-code  = buf_trn-doc.doc-code
     1265         and out-vatp_doc-attr.attr-code = 'envd':U
     1266         no-error .
     1267     if not available out-vatp_doc-attr then do:
     1268       assign
     1269         out-vatp-have-vat-slt = yes.
     1270     end.
     1271     else do:
     1272        out-vatp-have-vat-slt = no.
     1273     end.
