      601   procedure grplib-get-full-name :
      602      define input parameter p-node-code  as integer      no-undo.
      603      define output parameter p-full-name as character    no-undo.
      604      do
      605   on error undo, return error
      606   :
      607       define variable v-upper-code    as integer           no-undo.
      608       define buffer buf_gds-grp       for ub.gds-grp.
      609       define buffer buf_upper_gds-grp for ub.gds-grp.
      610       find first buf_gds-grp no-lock
      611            where buf_gds-grp.node-code = p-node-code
      612       no-error.
      613       if not available buf_gds-grp
      614       then do:
      615           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
      616       end.
      617       assign
      618           p-full-name  = ""
      619           v-upper-code = 1
      620       .
      621       do while buf_gds-grp.upper-code <> 0
      622       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
      623       :
      624           assign
      625               p-full-name  = buf_gds-grp.node-name
      626                            + (if p-full-name <> "" then chr(47) else "")
      627                            + p-full-name
      628               v-upper-code = buf_gds-grp.upper-code
      629           .
      630           find first buf_gds-grp no-lock
      631                where buf_gds-grp.node-code = v-upper-code
      632           no-error.
      633           if not available buf_gds-grp
      634           then do:
      635               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
      636                                   + string( v-upper-code )
      637                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      638           end.
      639       end.
      640       assign
      641       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
      642       .
      643   end.
      644   end .
      645   procedure grplib-get-node-from-full-name :
      646   define input parameter p-full-name as character no-undo .
      647   define output parameter p-node-code as integer no-undo .
      648   define variable v-ii as integer no-undo .
      649   define variable v-upper-code as integer no-undo .
      650   define variable v-root-code as integer no-undo .
      651   define variable v-entry as character no-undo .
      652   define buffer buf_gds-grp       for ub.gds-grp.
      653   do
      654   on error undo, return error
      655   :
      656     find first buf_gds-grp no-lock
      657         where buf_gds-grp.upper-code = 0
      658     no-error .
      659     if not available buf_gds-grp
      660     then do:
      661         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
      662     end.
      663     else do:
      664       assign
      665       v-root-code = buf_gds-grp.node-code
      666       .
      667     end.
      668     v-upper-code = v-root-code.
      669     do v-ii = 1 to num-entries(p-full-name, chr(47)):
      670       assign
      671       v-entry = entry(v-ii, p-full-name, chr(47)).
      672       if v-entry = '' then leave.
      673       find first buf_gds-grp no-lock where
      674                 buf_gds-grp.node-name = v-entry
      675             and buf_gds-grp.upper-code = v-upper-code
      676             no-error.
      677       if not available buf_gds-grp then do:
      678         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
      679       end.
      680       else do:
      681         p-node-code = buf_gds-grp.node-code.
      682         v-upper-code = buf_gds-grp.node-code.
      683       end.
      684     end.
      685   end.
      686   end .
