     1050                   excel-format-dec-to-char(price)              CHR(9)
     1051                   round( price /
     1052                                 (if var-report-r-b = "rubl" then cost-rubl else cost-base )  , 2 )
     1053                          chr(10)
     1054                   .
     1055           end.
     1056       else
     1057           do:
     1058               if Make-Excel then  put   stream ForExcel unformatted
     1059                   gds-list.artic     CHR(9)
     1060                   gds-list.gds-name  CHR(9)
     1061                   excel-format-dec-to-char(qnty)               CHR(9)
     1062                   gds-list.unit-base                           CHR(9)
     1063                   excel-format-dec-to-char(price)              chr(10)
     1064                   .
     1065           end.
     1066   end .
     1067   define variable v-host-code    as integer      no-undo.
     1068   define variable v-host-name    as character    no-undo.
     1069   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1070   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostname in g#library
     1071     (input  v-cntxt-obj-type
     1072     ,input  v-cntxt-obj-code
     1073     ,output v-host-code
     1074     ,output v-host-name
     1075     )  .
     1076   if Make-Excel then  put   stream ForExcel unformatted chr(10) chr(10) CHR(9) "Утверждаю," chr(10)  chr(10)
     1077    CHR(9) "Финансовый директор" chr(10)
     1078    CHR(9) v-host-name CHR(9)  "___________" CHR(9) '"__"_________20___г.'  chr(10)
     1079    CHR(9) CHR(9) CHR(9) CHR(9) CHR(9) "М.П."  chr(10).
     1080   if session:set-wait-state("") then.
     1081    if Make-Excel then output stream ForExcel close.
     1082    run rep/runexcel.p (string( session:temp-directory) + "rpt" + string( g#report-num ) + ".txt").
     1083   os-delete value( string( session:temp-directory ) +
     1084                              "rpt" + string( g#report-num ) + ".txt":u ) .
     1085   PROCEDURE ostatok :
     1086   def input parameter x-store-code  like ub.clients.obj-code    no-undo.
     1087   def input parameter x-store-type  like ub.clients.obj-type    no-undo.
     1088   def input parameter x-tog-shift   as   logical             no-undo.
     1089   def input parameter x-date-start  like ub.stk-tot.Fact-date   no-undo.
     1090   def input parameter x-date-end    like ub.stk-tot.Fact-date   no-undo.
     1091   def input parameter x-shift-start as integer               no-undo.
     1092   def input parameter x-shift-end   as integer               no-undo.
     1093   def input parameter x-sum-type    like ub.stk-tot.sum-type    no-undo.
     1094   def input parameter x-cat-id      like ub.stk-tot.cat-id      no-undo.
     1095   def input parameter xTog-obj   as log no-undo.
     1096   def output parameter Quantity    like ub.stk-tot.fact-qnty   no-undo.
     1097   def output parameter Coast_R     like ub.stk-tot.sum-rubl    no-undo.
     1098   def output parameter Coast_V     like ub.stk-tot.sum-rubl    no-undo.
     1099   def output parameter VAT_R       like ub.stk-tot.sum-rubl    no-undo.
     1100   def output parameter VAT_V       like ub.stk-tot.sum-rubl    no-undo.
     1101   def output parameter Fact-order  like ub.stk-tot.Fact-order  no-undo.
     1102   def var              Fact-order#   like ub.stk-tot.Fact-order  no-undo.
     1103   def var              Fact-orderS   as char  no-undo.
     1104   def var x-date-start-t  like ub.stk-tot.shift-date   no-undo.
     1105      Assign
     1106         Fact-order   = 0
     1107         Quantity     = 0
     1108         Coast_R      = 0
     1109         Coast_V      = 0
     1110         VAT_R        = 0
     1111         VAT_V        = 0 .
     1112    x-date-start-t  = x-date-start + 1 .
     1113   IF x-date-end = date('') then DO:
     1114      Fact-order = 0 .
     1115      for each obj-list
     1116          where  ( not xtog-obj or
     1117                 ( x-store-type = obj-list.obj-type and x-store-code = obj-list.obj-code ))
     1118                 no-lock :
     1119         if  x-tog-shift = false then do:
     1120                          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     1121                               ub.stk-tot.Fact-date <=  x-date-start
     1122                               and ub.stk-tot.shift-num = 0
     1123                               USE-INDEX fact-date no-lock no-error .
     1124              if Available ub.stk-tot THEN  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     1125         End.
     1126         Else  DO :
     1127             find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     1128              (ub.stk-tot.shift-date  = x-date-start-t and
     1129               ub.stk-tot.shift-num  < x-shift-start or
     1130               ub.stk-tot.shift-date  < x-date-start-t  )
     1131               and ub.stk-tot.shift-num  > 0
     1132               USE-INDEX Shift-num no-lock no-error .
     1133            If Available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     1134           END.
     1135       If Fact-order < Fact-order#  and Fact-order# <> 0  THEN  Fact-order = Fact-order# .
     1136     End.
     1137   End.
     1138   Else DO:
     1139     For each obj-list  WHERE
     1140        (NOT xTog-obj OR (x-store-type = obj-list.obj-type AND x-store-code = obj-list.obj-code))
     1141         no-lock :
     1142      IF  x-TOG-Shift = False Then DO:
     1143          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     1144               ub.stk-tot.Fact-date <= x-date-end
     1145               and ub.stk-tot.shift-num = 0
     1146               USE-INDEX fact-date no-lock no-error.
     1147          if available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     1148      END.
     1149      Else DO:
     1150           find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     1151               (ub.stk-tot.shift-date  = x-date-end and
     1152               ub.stk-tot.shift-num  <= x-shift-end or
     1153               ub.stk-tot.shift-date  < x-date-end       ) and
     1154               ub.stk-tot.shift-num   > 0      use-index shift-num no-lock no-error.
     1155               if Available ub.stk-tot THEN Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     1156       End.
     1157       if Fact-order < Fact-order#  THEN  Fact-order = Fact-order#.
     1158     End.
     1159   End.
     1160   END PROCEDURE.
     1161   procedure ost-line :
     1162     define input  parameter x-store-code like ub.clients.obj-code    no-undo .
     1163     define input  parameter x-store-type like ub.clients.obj-type    no-undo .
     1164     define input  parameter x-artic      like ub.stk-line.artic      no-undo .
     1165     define input  parameter x-prod-code  like ub.stk-line.prod-code  no-undo .
     1166     define input  parameter x-prod-type  like ub.stk-line.prod-type  no-undo .
     1167     define input  parameter x-tog-shift  as logical no-undo .
     1168     define input  parameter x-fact-order like ub.stk-line.fact-order no-undo .
     1169     define input  parameter x-sum-type   like ub.stk-line.sum-type   no-undo .
     1170     define input  parameter x-cat-id     like ub.stk-line.cat-id     no-undo .
     1171     define input  parameter xtog-obj     as logical no-undo .
     1172     define output parameter quantity     like ub.stk-line.fact-qnty  no-undo .
     1173     define output parameter coast_r      like ub.stk-line.sum-rubl   no-undo .
     1174     define output parameter coast_v      like ub.stk-line.sum-rubl   no-undo .
     1175     define output parameter vat_r        like ub.stk-line.sum-rubl   no-undo .
     1176     define output parameter vat_v        like ub.stk-line.sum-rubl   no-undo .
     1177     define output parameter slt_r        like ub.stk-line.sum-rubl   no-undo .
     1178     define output parameter slt_v        like ub.stk-line.sum-rubl   no-undo .
     1179     define buffer buff-obj-list  for obj-list .
     1180     define buffer buff-stk-line  for ub.stk-line .
     1181     assign
     1182       Quantity = 0
     1183       Coast_R  = 0
     1184       Coast_V  = 0
     1185       VAT_R    = 0
     1186       VAT_V    = 0
     1187       SLT_R    = 0
     1188       SLT_V    = 0
     1189     .
     1190     if  x-tog-shift = false then do:
     1191       for each buff-obj-list no-lock
     1192         where xtog-obj = false
     1193            or (buff-obj-list.obj-type = x-store-type
     1194               and buff-obj-list.obj-code = x-store-code
     1195               )
     1196       on error undo, return error
     1197       :
     1198         find last buff-stk-line no-lock
     1199           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     1200             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     1201             and buff-stk-line.artic      = x-artic
     1202             and buff-stk-line.prod-type  = x-prod-type
     1203             and buff-stk-line.prod-code  = x-prod-code
     1204             and buff-stk-line.sum-type   = x-sum-type
     1205             and buff-stk-line.cat-id     = '##,##':U
     1206             and buff-stk-line.fact-order <= x-fact-order
     1207             and buff-stk-line.shift-num  = 0
     1208           use-index category
     1209           no-error .
     1210         if available buff-stk-line then do:
     1211           assign
     1212             Quantity = Quantity +  buff-stk-line.fact-qnty
     1213             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     1214             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     1215             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     1216             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     1217             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     1218             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     1219           .
     1220         end.
     1221       end.
     1222     end.
     1223     else do:
     1224       for each buff-obj-list no-lock
     1225         where xtog-obj = false
     1226            or (buff-obj-list.obj-type = x-store-type
     1227               and buff-obj-list.obj-code = x-store-code
     1228               )
     1229       on error undo, return error
     1230       :
     1231         find last buff-stk-line no-lock
     1232           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     1233             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     1234             and buff-stk-line.artic      = x-artic
     1235             and buff-stk-line.prod-type  = x-prod-type
     1236             and buff-stk-line.prod-code  = x-prod-code
     1237             and buff-stk-line.sum-type   = x-sum-type
     1238             and buff-stk-line.cat-id     = '##,##':U
     1239             and buff-stk-line.fact-order <= x-fact-order
     1240             and buff-stk-line.shift-num  > 0
     1241           use-index category
     1242           no-error .
     1243         if available buff-stk-line then do:
     1244           assign
     1245             Quantity = Quantity +  buff-stk-line.fact-qnty
     1246             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     1247             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     1248             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     1249             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     1250             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     1251             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     1252           .
     1253         end.
     1254       end.
     1255     end.
     1256   end procedure.
     1257   procedure ost-lineother-tax :
     1258     define input  parameter x-store-code like ub.clients.obj-code      no-undo.
     1259     define input  parameter x-store-type like ub.clients.obj-type      no-undo.
     1260     define input  parameter x-artic      like ub.stk-line.artic        no-undo.
     1261     define input  parameter x-prod-code  like ub.stk-line.prod-code    no-undo.
     1262     define input  parameter x-prod-type  like ub.stk-line.prod-type    no-undo.
     1263     define input  parameter x-tog-shift  as logical no-undo .
     1264     define input  parameter x-fact-order like ub.stk-line.fact-order   no-undo.
     1265     define input  parameter x-sum-type   like ub.stk-line.sum-type     no-undo.
     1266     define input  parameter x-type-id    like ub.stk-line.cat-id       no-undo.
     1267     define input  parameter xTog-obj     as logical no-undo .
     1268     define output parameter Quantity     like ub.stk-line.fact-qnty   no-undo.
     1269     define output parameter Coast_R      like ub.stk-line.sum-rubl    no-undo.
     1270     define output parameter Coast_V      like ub.stk-line.sum-rubl    no-undo.
     1271     define output parameter VAT_R        like ub.stk-line.sum-rubl    no-undo.
     1272     define output parameter VAT_V        like ub.stk-line.sum-rubl    no-undo.
     1273     define output parameter SLT_R        like ub.stk-line.sum-rubl    no-undo.
     1274     define output parameter SLT_V        like ub.stk-line.sum-rubl    no-undo.
     1275     define output parameter other_R      like ub.stk-line.sum-rubl    no-undo.
     1276     define output parameter other_V      like ub.stk-line.sum-rubl    no-undo.
     1277     define buffer buff-obj-list  for obj-list .
     1278     define buffer buff-stk-line  for ub.stk-line .
     1279     assign
     1280       Quantity = 0
     1281       Coast_R  = 0
     1282       Coast_V  = 0
     1283       VAT_R    = 0
     1284       VAT_V    = 0
     1285       SLT_R    = 0
     1286       SLT_V    = 0
     1287       other_R  = 0
     1288       other_V  = 0
     1289     .
     1290     if  x-tog-shift = false then do:
     1291       for each buff-obj-list no-lock
     1292         where xtog-obj = false
     1293            or (buff-obj-list.obj-type = x-store-type
     1294               and buff-obj-list.obj-code = x-store-code
     1295               )
     1296       on error undo, return error
     1297       :
     1298         find last buff-stk-line no-lock
     1299           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     1300             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     1301             and buff-stk-line.artic      = x-artic
     1302             and buff-stk-line.prod-type  = x-prod-type
     1303             and buff-stk-line.prod-code  = x-prod-code
     1304             and buff-stk-line.sum-type   = x-sum-type
     1305             and buff-stk-line.cat-id     = '##,##':U
     1306             and buff-stk-line.fact-order <= x-fact-order
     1307             and buff-stk-line.shift-num  = 0
     1308           use-index category
     1309           no-error .
     1310         if available buff-stk-line then do:
     1311           assign
     1312             Quantity = Quantity +  buff-stk-line.fact-qnty
     1313             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     1314             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     1315             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     1316             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     1317             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     1318             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     1319             other_R  = other_R  +  buff-stk-line.other-rubl
     1320             other_V  = other_V  +  buff-stk-line.other-base
     1321           .
     1322         end.
     1323       end.
     1324     end.
     1325     else do:
     1326       for each buff-obj-list no-lock
     1327         where xtog-obj = false
     1328            or (buff-obj-list.obj-type = x-store-type
     1329               and buff-obj-list.obj-code = x-store-code
     1330               )
     1331       on error undo, return error
     1332       :
     1333         find last buff-stk-line no-lock
     1334           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     1335             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     1336             and buff-stk-line.artic      = x-artic
     1337             and buff-stk-line.prod-type  = x-prod-type
     1338             and buff-stk-line.prod-code  = x-prod-code
     1339             and buff-stk-line.sum-type   = x-sum-type
     1340             and buff-stk-line.cat-id     = '##,##':U
     1341             and buff-stk-line.fact-order <= x-fact-order
     1342             and buff-stk-line.shift-num  > 0
     1343           use-index category
     1344           no-error .
     1345         if available buff-stk-line then do:
     1346           assign
     1347             Quantity = Quantity +  buff-stk-line.fact-qnty
     1348             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     1349             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     1350             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     1351             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     1352             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     1353             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     1354             other_R = other_R   +  buff-stk-line.other-rubl
     1355             other_V = other_V   +  buff-stk-line.other-base
     1356           .
     1357         end.
     1358       end.
     1359     end.
     1360   end procedure.
     1361   procedure ost-line-kg :
     1362     define  input parameter p-obj-code    like ub.stk-line.obj-code   no-undo .
     1363     define  input parameter p-obj-type    like ub.stk-line.obj-type   no-undo .
     1364     define  input parameter p-artic       like ub.stk-line.artic      no-undo .
     1365     define  input parameter p-prod-code   like ub.stk-line.prod-code  no-undo .
     1366     define  input parameter p-prod-type   like ub.stk-line.prod-type  no-undo .
     1367     define  input parameter p-fact-order  like ub.stk-line.fact-order no-undo .
     1368     define output parameter p-quantity-kg like ub.stk-line.fact-qnty  no-undo initial 0.00 .
     1369     define buffer buff-obj-list  for obj-list .
     1370     define buffer buf_doc-line for ub.doc-line .
     1371     define buffer buf_inv-line for ub.inv-line .
     1372     do
     1373     on error undo, return error
     1374     :
     1375       for each buf_doc-line no-lock where
     1376                buf_doc-line.obj-type    = p-obj-type   and
     1377                buf_doc-line.obj-code    = p-obj-code   and
     1378                buf_doc-line.prod-type   = p-prod-type  and
     1379                buf_doc-line.prod-code   = p-prod-code  and
     1380                buf_doc-line.artic       = p-artic      and
     1381                buf_doc-line.status_     = 'факт':U      and
     1382                buf_doc-line.fact-order <= p-fact-order
     1383             by buf_doc-line.fact-order    descending
     1384       :
     1385         find first buf_inv-line no-lock where
     1386                    buf_inv-line.doc-code  = buf_doc-line.doc-code  and
     1387                    buf_inv-line.artic     = buf_doc-line.artic     and
     1388                    buf_inv-line.prod-type = buf_doc-line.prod-type and
     1389                    buf_inv-line.prod-code = buf_doc-line.prod-code no-error .
     1390         if available buf_inv-line
     1391         then do:
     1392           if buf_inv-line.after-cli-qnty <> ?
     1393           then do:
     1394             assign
     1395               p-quantity-kg = buf_inv-line.after-cli-qnty
     1396             .
     1397             leave .
     1398           end.
     1399         end.
     1400       end.
     1401       if p-quantity-kg = ?
     1402       then do:
     1403         assign
     1404           p-quantity-kg = 0
     1405         .
     1406       end.
     1407     end.
     1408   end procedure.
