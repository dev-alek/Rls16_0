      944     (input  v-cntxt-obj-type
      945     ,input  v-cntxt-obj-code
      946     ,output v-today
      947     )  .
      948     run ostatok  (    input  ? ,    input  ? ,    input  false   ,    input  v-today ,    input  ""        ,
      949       input  ?          ,    input  ?          ,    input  'crsa':U ,    input  '##,##':U ,    input  false     ,
      950       output  tmp#var  ,    output  tmp#var  ,    output  tmp#var  ,    output  tmp#var  ,    output  tmp#var  ,
      951       output  fact-order1 ).
      952   for each gds-list no-lock,
      953           each goods where goods.prod-type = gds-list.prod-type
      954                                              and goods.prod-code = gds-list.prod-code
      955                                              and goods.artic = gds-list.artic
      956                                              no-lock:
      957       if order-rec = ? then
      958           do:
      959            run ost-line (  input   v-cntxt-obj-code  ,
      960                    input   v-cntxt-obj-type  ,
      961                    input   gds-list.artic     ,
      962                    input   gds-list.prod-code ,
      963                    input   gds-list.prod-type ,
      964                    input   false     ,
      965                    input   fact-order1    ,
      966                    input   'crsa':U            ,
      967                    input   '##,##':U    ,
      968                    input   true      ,
      969                    output  qnty       ,
      970                    output  coast_r     ,
      971                    output  coast_v     ,
      972                    output  tmp#var     ,
      973                    output  tmp#var     ,
      974                    output  tmp#var     ,
      975                    output  tmp#var     ).
      976                assign
      977                       cost-rubl = round( coast_r / qnty , 2 )
      978                       cost-base = round( coast_v / qnty , 2 ) .
      979           end.
      980       else do:
      981               find doc-line where doc-line.prod-type = gds-list.prod-type
      982                                                    and doc-line.prod-code = gds-list.prod-code
      983                                                    and doc-line.artic = gds-list.artic
      984                                                    and doc-line.doc-code = trn-doc.doc-code
      985                                                    no-lock.
      986               assign
      987                   cost-rubl = doc-line.price-rubl
      988                   cost-base = doc-line.price-base
      989                   qnty = doc-line.doc-qnty
      990                   .
      991           end.
      992       find gds-prt where gds-prt.upper-code = gds-list.prt-root no-lock.
      993   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      994   gp-fact-order = 0 .
      995   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
      996     (input  goods.gds-code
      997     ,input  gds-prt.node-code
      998     ,output gp-b-code
      999     ) no-error .
     1000   if error-status:error then do:
     1001     message
     1002       error-status :get-message(1) skip
     1003       return-value skip
     1004       view-as alert-box error .
     1005     return error.
     1006   end.
     1007   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1008   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     1009     (input  v-cntxt-obj-type
     1010     ,input  v-cntxt-obj-code
     1011     ,input  gp-b-code
     1012     ,input  0
     1013     ,input  gp-fact-order
     1014     ,output gp-doc-num
     1015     ,output gp-price-sale
     1016     ,output gp-road-tax
     1017     ,output gp-excise
     1018     ) no-error .
     1019   if error-status:error then do:
     1020     return error.
     1021   end.
     1022   gp-price-sale-parts = gp-price-sale.
     1023   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1024   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn3_avprpart in g#lib-trn3
     1025     (input  v-cntxt-obj-type
     1026     ,input  v-cntxt-obj-code
     1027     ,input  gp-b-code
     1028     ,input  0
     1029     ,input  gp-fact-order
     1030     ,output gp-doc-num
     1031     ,output gp-price-sale-parts
     1032     ,output gp-road-tax
     1033     ,output gp-excise
     1034     ) no-error .
     1035   if error-status:error then do:
     1036     return error.
     1037   end.
     1038   if gp-price-sale-parts <> 0 and gp-price-sale-parts <> ? then do:
     1039       gp-price-sale = gp-price-sale-parts.
     1040    end.
     1041           price = gp-price-sale .
     1042       if prn-cost-price then
     1043           do:
     1044               if Make-Excel then  put   stream ForExcel unformatted
     1045                   gds-list.artic     CHR(9)
     1046                   gds-list.gds-name  CHR(9)
