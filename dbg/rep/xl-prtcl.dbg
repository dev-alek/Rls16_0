      722   function excel-format-dec-to-char returns char (input p-dec as decimal ).
      723     if num-entries(string(p-dec), '.') = 2
      724       then return( entry(1, string(p-dec), '.') + v-delim + entry(2, string(p-dec), '.')) .
      725       else return( string(p-dec)) .
      726   end function.
      727   function format-point-to-comma returns char (input orig as char ) .
      728   define variable rtext as character no-undo .
      729   define variable strt as integer no-undo .
      730   define variable leng as integer no-undo .
      731   assign rtext = orig .
      732   repeat:
      733     strt =  index(rtext,'.').
      734     if strt = 0 then leave.
      735     leng = 1.
      736     substring(rtext,strt,leng,"character") = v-delim .
      737   end.
      738   return rtext.
      739   end function.
      740   function format-excel-text returns char ( input start-text as char ) :
      741   def var  i    as int no-undo.
      742   def var  ch   as char no-undo.
      743   def var  n    as int no-undo.
      744   def var  ipos as int no-undo.
      745     n = num-entries(trim(start-text), chr(10)) - 1 .
      746     do i = 1 to n :
      747       ipos = index( start-text, chr(10)).
      748       if ipos > 0 then
      749         substr( start-text, ipos, 1 ) = ' '.
      750     end.
      751     n = num-entries(trim(start-text), chr(13)) - 1 .
      752     do i = 1 to n :
      753       ipos = index( start-text, chr(13)).
      754       if ipos > 0 then
      755         substr( start-text, ipos, 1 ) = ' '.
      756     end.
      757     if index( start-text, '"' ) = 0 then
      758       start-text =  '="'   + trim( start-text) + '"'   .
      759       else do:
      760         n = num-entries(trim(start-text), '"') - 1.
      761         do i = 1 to n :
      762           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
      763         end.
      764         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
      765         start-text = '="'  + ch  + '"' .
      766       end.
      767     return start-text.
      768   end.
      769   function excel-sum returns char (input p-dec as decimal ).
      770     return(format-excel-text(excel-format-dec-to-char(round(p-dec,2)))) .
      771   end function.
      772   function excel-qnty returns char (input p-dec as decimal ).
      773     return(format-excel-text(excel-format-dec-to-char(round(p-dec,3)))) .
      774   end function.
      775   function format-excel-text-macr returns char ( input start-text as char ) :
      776   def var  i    as int no-undo.
      777   def var  ch   as char no-undo.
      778   def var  n    as int no-undo.
      779   def var  ipos as int no-undo.
      780     n = num-entries(trim(start-text), chr(10)) - 1 .
      781     do i = 1 to n :
      782       ipos = index( start-text, chr(10)).
      783       if ipos > 0 then
      784         substring( start-text, ipos , 1 ) = ' '.
      785     end.
      786     n = num-entries(trim(start-text), chr(13)) - 1 .
      787     do i = 1 to n :
      788       ipos = index( start-text, chr(13)).
      789       if ipos > 0 then
      790         substring( start-text, ipos, 1 ) = ' '.
      791     end.
      792     if index( start-text, '"' ) = 0 then
      793       start-text =  '"'   + trim( start-text) + '"'   .
      794       else do:
      795         n = num-entries(trim(start-text), '"') - 1.
      796         do i = 1 to n :
      797           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
      798         end.
      799         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
      800         start-text = '"'  + ch  + '"' .
      801       end.
      802     n = num-entries(trim(start-text), chr(10)) - 1 .
      803     do i = 1 to n :
      804       ipos = index( start-text, chr(10)).
      805       if ipos > 0 then
      806         substring( start-text, ipos , 1 ) = ' '.
      807     end.
      808       if num-entries(trim(start-text), chr(10)) > 1 then  message num-entries(trim(start-text), chr(10)) start-text.
      809     return start-text.
      810   end.
