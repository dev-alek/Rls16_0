      844   rec-grp = "".
      845   if order-rec = ? then
      846       do:
      847            run ref/gds-grp.w (
      848                          input p-mainmenu-handle
      849                         ,input "b-sel"
      850                         ,input v-cntxt-obj-type
      851                         ,input v-cntxt-obj-code
      852                         ,input-output rec-grp).
      853                if rec-grp = "" or rec-grp = ? then  return.
      854            find gds-grp where recid( gds-grp ) = integer( rec-grp ) no-lock .
      855            run grplib-get-full-name in this-procedure( input gds-grp.node-code, output grpname ) .
      856          assign
      857               rec-cli = ""
      858           .
      859           run ref/cli-all.w ( p-mainmenu-handle
      860                          , input "b-sel"
      861                          , 'все':U
      862                          , 'все':U
      863                          , 'текущие':U
      864                          , ?
      865                          , "yes,yes,yes,,,,ИЛИ"
      866                          , ?
      867                          , output rec-cli ) .
      868           if rec-cli = "" or rec-cli = ? then
      869               return.
      870           find clients where recid ( clients ) = integer( rec-cli ) no-lock .
      871           assign cliname = clients.obj-name .
      872           for each gds-obj where gds-obj.grp-name begins grpname
      873                                                        and gds-obj.obj-type = v-cntxt-obj-type
      874                                                        and gds-obj.obj-code = v-cntxt-obj-code
      875                                                        and gds-obj.prod-type = clients.obj-type
      876                                                        and gds-obj.prod-code = clients.obj-code
      877                                                        no-lock,
      878                   each goods where goods.prod-type = gds-obj.prod-type
      879                                                      and goods.prod-code = gds-obj.prod-code
      880                                                      and goods.artic = gds-obj.artic
      881                                                      no-lock :
      882               create gds-list.
      883               buffer-copy goods to gds-list.
      884           end.
      885       end.
      886   else
      887       do:
      888           find trn-doc where recid( trn-doc ) = order-rec no-lock.
      889           for each doc-line where doc-line.doc-code = trn-doc.doc-code no-lock,
      890                   each clients where clients.obj-type = doc-line.prod-type
      891                                                       and clients.obj-code = doc-line.prod-code no-lock,
      892                   each goods where goods.prod-type = doc-line.prod-type
      893                                                      and goods.prod-code = doc-line.prod-code
      894                                                      and goods.artic = doc-line.artic
      895                                                      no-lock :
      896               if cliname = "" then
      897                   assign cliname = clients.obj-name .
      898               else
      899                   do:
      900                       if not can-do(cliname, clients.obj-name) then
      901                           assign cliname = cliname + "," + clients.obj-name .
      902                   end.
      903               create gds-list.
      904               buffer-copy goods to gds-list.
      905           end.
      906       end.
      907      make-excel = true .
      908      os-delete value( string( session:temp-directory ) +
      909                                 "rpt" + string( g#report-num ) + ".txt":u ) .
      910      output stream forexcel to value( string( session:temp-directory ) +
      911                                 "rpt" + string( g#report-num ) + ".txt":u ) .
