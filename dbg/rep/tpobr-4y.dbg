     1661   procedure aht_add-document :
     1662     define input  parameter p-doc-code     like ub.aht-doc.doc-code     no-undo .
     1663     define input  parameter p-obj-type     like ub.aht-doc.obj-type     no-undo .
     1664     define input  parameter p-obj-code     like ub.aht-doc.obj-code     no-undo .
     1665     define input  parameter p-ext-doc-type like ub.aht-doc.ext-doc-type no-undo .
     1666     define input  parameter p-is-trn-doc   like ub.aht-doc.is-trn-doc   no-undo .
     1667     define input  parameter p-fact-order   like ub.aht-doc.fact-order   no-undo .
     1668     define input  parameter p-fact-date    like ub.aht-doc.fact-date    no-undo .
     1669     define input  parameter p-shift-date   like ub.aht-doc.shift-date   no-undo .
     1670     define input  parameter p-shift-num    like ub.aht-doc.shift-num    no-undo .
     1671     define buffer buf_aht-doc for ub.aht-doc .
     1672     do
     1673     on error undo, return error return-value
     1674     :
     1675       find first buf_aht-doc exclusive-lock
     1676         where buf_aht-doc.doc-code = p-doc-code
     1677         no-error .
     1678       if available buf_aht-doc then do:
     1679         message
     1680           vss-workfile vss-revision vss-description skip
     1681           vss-include-info17 skip
     1682           "Попытка повторного создания записи" skip
     1683           "Документ" p-doc-code skip
     1684           view-as alert-box error .
     1685         undo, return error .
     1686       end.
     1687       if p-fact-order = ?
     1688       or p-fact-order = 0
     1689       then do:
     1690         message
     1691           vss-workfile vss-revision vss-description skip
     1692           vss-include-info17 skip
     1693           "Ошибка задания входных параметров" skip
     1694           "Не задан номер документа" skip
     1695           "Документ" p-doc-code skip
     1696           "Номер документа" p-fact-order skip
     1697           view-as alert-box error .
     1698         undo, return error .
     1699       end.
     1700       create buf_aht-doc .
     1701       assign
     1702         buf_aht-doc.doc-code     = p-doc-code
     1703         buf_aht-doc.obj-type     = p-obj-type
     1704         buf_aht-doc.obj-code     = p-obj-code
     1705         buf_aht-doc.ext-doc-type = p-ext-doc-type
     1706         buf_aht-doc.is-trn-doc   = p-is-trn-doc
     1707         buf_aht-doc.fact-order   = p-fact-order
     1708         buf_aht-doc.fact-date    = p-fact-date
     1709         buf_aht-doc.shift-date   = p-shift-date
     1710         buf_aht-doc.shift-num    = p-shift-num
     1711       .
     1712     end.
     1713   end procedure.
     1714   procedure aht_add-date :
     1715     define input  parameter p-obj-type     like ub.aht-stk.obj-type     no-undo .
     1716     define input  parameter p-obj-code     like ub.aht-stk.obj-code     no-undo .
     1717     define input  parameter p-stk-type     like ub.aht-stk.stk-type     no-undo .
     1718     define input  parameter p-fact-order   like ub.aht-stk.fact-order   no-undo .
     1719     define input  parameter p-fact-date    like ub.aht-stk.fact-date    no-undo .
     1720     define input  parameter p-shift-date   like ub.aht-stk.shift-date   no-undo .
     1721     define input  parameter p-shift-num    like ub.aht-stk.shift-num    no-undo .
     1722     define buffer buf_aht-stk for ub.aht-stk .
     1723     do
     1724     on error undo, return error return-value
     1725     :
     1726       find first buf_aht-stk no-lock
     1727         where buf_aht-stk.obj-type   = p-obj-type
     1728           and buf_aht-stk.obj-code   = p-obj-code
     1729           and buf_aht-stk.stk-type   = p-stk-type
     1730           and buf_aht-stk.fact-order = p-fact-order
     1731         no-error .
     1732       if not available buf_aht-stk then do:
     1733         create buf_aht-stk .
     1734         assign
     1735           buf_aht-stk.obj-type   = p-obj-type
     1736           buf_aht-stk.obj-code   = p-obj-code
     1737           buf_aht-stk.stk-type   = p-stk-type
     1738           buf_aht-stk.fact-order = p-fact-order
     1739           buf_aht-stk.fact-date  = p-fact-date
     1740           buf_aht-stk.shift-date = p-shift-date
     1741           buf_aht-stk.shift-num  = p-shift-num
     1742         .
     1743       end.
     1744     end.
     1745   end procedure.
     1746   def var vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1747   PROCEDURE aht-ostatok :
     1748   def input parameter x-store-code  like ub.clients.obj-code    no-undo.
     1749   def input parameter x-store-type  like ub.clients.obj-type    no-undo.
     1750   def input parameter x-tog-shift   as   logical             no-undo.
     1751   def input parameter x-date-start  like ub.aht-stk.Fact-date   no-undo.
     1752   def input parameter x-date-end    like ub.aht-stk.Fact-date   no-undo.
     1753   def input parameter x-shift-start as integer               no-undo.
     1754   def input parameter x-shift-end   as integer               no-undo.
     1755   def input parameter x-sum-type    like ub.aht-stk.stk-type    no-undo.
     1756   def input parameter xTog-obj   as log no-undo.
     1757   def output parameter Fact-order  like ub.aht-stk.Fact-order  no-undo.
     1758   def var              Fact-order#   like ub.aht-stk.Fact-order  no-undo.
     1759   def var              Fact-orderS   as char  no-undo.
     1760   def var x-date-start-t  like ub.aht-stk.shift-date   no-undo.
     1761       Assign
     1762         Fact-order   = 0
     1763        .
     1764    x-date-start-t  = x-date-start + 1 .
     1765   IF x-date-end = date('') then DO:
     1766      Fact-order = 0 .
     1767      For each obj-list
     1768          WHERE  (NOT xTog-obj OR
     1769                 (x-store-type = obj-list.obj-type AND x-store-code = obj-list.obj-code))
     1770                 no-lock :
     1771         IF  x-TOG-Shift = False Then DO:
     1772                          find last ub.aht-stk where ub.aht-stk.obj-type = obj-list.obj-type and                                             ub.aht-stk.obj-code = obj-list.obj-code and                                             ub.aht-stk.stk-type = x-sum-type
     1773                               and ub.aht-stk.Fact-date <=  x-date-start
     1774                               and ub.aht-stk.shift-num = 0
     1775                               USE-INDEX obj-date no-lock no-error .
     1776              if Available ub.aht-stk THEN  Assign  Fact-order#  = ub.aht-stk.Fact-order .
     1777         End.
     1778         Else  DO :
     1779             find last ub.aht-stk where ub.aht-stk.obj-type = obj-list.obj-type and                                             ub.aht-stk.obj-code = obj-list.obj-code and                                             ub.aht-stk.stk-type = x-sum-type and
     1780               (ub.aht-stk.shift-date  = x-date-start-t and
     1781               ub.aht-stk.shift-num  < x-shift-start or
     1782               ub.aht-stk.shift-date  < x-date-start-t  )
     1783               and ub.aht-stk.shift-num  > 0
     1784               USE-INDEX obj-Shift no-lock no-error .
     1785            If Available ub.aht-stk then  Assign  Fact-order#  = ub.aht-stk.Fact-order .
     1786           END.
     1787       If Fact-order < Fact-order#  and Fact-order# <> 0  THEN  Fact-order = Fact-order# .
     1788     End.
     1789   End.
     1790   Else DO:
     1791     For each obj-list  WHERE
     1792        (NOT xTog-obj OR (x-store-type = obj-list.obj-type AND x-store-code = obj-list.obj-code))
     1793         no-lock :
     1794      IF  x-TOG-Shift = False Then DO:
     1795          find last ub.aht-stk where ub.aht-stk.obj-type = obj-list.obj-type and                                             ub.aht-stk.obj-code = obj-list.obj-code and                                             ub.aht-stk.stk-type = x-sum-type and
     1796               ub.aht-stk.Fact-date <= x-date-end
     1797               and ub.aht-stk.shift-num = 0
     1798               USE-INDEX obj-date no-lock no-error.
     1799          If Available ub.aht-stk then  Assign  Fact-order#  = ub.aht-stk.Fact-order .
     1800      END.
     1801      Else DO:
     1802           find last ub.aht-stk where ub.aht-stk.obj-type = obj-list.obj-type and                                             ub.aht-stk.obj-code = obj-list.obj-code and                                             ub.aht-stk.stk-type = x-sum-type and
     1803               (ub.aht-stk.shift-date  = x-date-end and
     1804               ub.aht-stk.shift-num  <= x-shift-end or
     1805               ub.aht-stk.shift-date  < x-date-end       ) and
     1806               ub.aht-stk.shift-num   > 0      use-index obj-Shift no-lock no-error.
     1807               if Available ub.aht-stk THEN Assign  Fact-order#  = ub.aht-stk.Fact-order .
     1808       End.
     1809       if Fact-order < Fact-order#  THEN  Fact-order = Fact-order#.
     1810     End.
     1811   End.
     1812   END PROCEDURE.
     1813   define variable v-account as integer init 0 no-undo .
     1814   define variable v-account-lavel as character no-undo .
     1815   define variable v-button-stop as logical no-undo .
     1816   define variable v-kol-spice as integer no-undo .
     1817   define variable v-kol-spice2 as integer no-undo .
     1818   define variable v-kol-spice3 as integer no-undo .
     1819   DEFINE VARIABLE StopProcessing AS LOGICAL NO-UNDO.
     1820   DEFINE BUTTON StopBtn AUTO-END-KEY
     1821        LABEL "Стоп"
     1822        SIZE 10 BY 1.
     1823   DEFINE VARIABLE RecordsDone AS INTEGER FORMAT ">,>>>,>>>,>>9":U INITIAL 0
     1824        LABEL "Обработано записей"
     1825         VIEW-AS TEXT
     1826        SIZE 14 BY .67 NO-UNDO.
     1827   DEFINE VARIABLE RecordsString AS CHARACTER FORMAT "X(60)"
     1828         VIEW-AS TEXT
     1829        SIZE 53.25 BY .67
     1830        FGCOLOR 1  NO-UNDO.
     1831   DEFINE VARIABLE RecordsString2 AS CHARACTER FORMAT "X(60)"
     1832         VIEW-AS TEXT
     1833        SIZE 53.25 BY .67
     1834        FGCOLOR 1  NO-UNDO.
     1835   DEFINE VARIABLE RecordsString3 AS CHARACTER FORMAT "X(60)"
     1836         VIEW-AS TEXT
     1837        SIZE 53.25 BY .67
     1838        FGCOLOR 1  NO-UNDO.
     1839   DEFINE RECTANGLE RECT-1
     1840        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1841        SIZE 55.13 BY 4.46.
     1842   DEFINE FRAME InfoFrame
     1843        StopBtn AT ROW 4.25 COL 21.75
     1844        RecordsString AT ROW 1.21 COL 2 NO-LABEL
     1845        RecordsString2 AT ROW 1.96 COL 2 NO-LABEL
     1846        RecordsString3 AT ROW 2.58 COL 2 NO-LABEL
     1847        RecordsDone AT ROW 3.42 COL 24.88 COLON-ALIGNED
     1848        RECT-1 AT ROW 1 COL 1
     1849       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1850            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1851            TITLE "Процесс"
     1852            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
     1853   define variable mFrameView      as logical   no-undo init yes.
     1854     define variable mFramHandle as handle no-undo.
     1855     mFramHandle = frame InfoFrame:handle.
     1856     if  log-manager:logfile-name ne ?
     1857     then DO:
     1858         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1859         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1860         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
     1861     end.
     1862     mFrameView = not session:batch-mode and mFramHandle:visible.
     1863     if mFrameView
     1864     then do:
     1865       ASSIGN
     1866          FRAME InfoFrame:HIDDEN                           = TRUE
     1867          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
     1868     end.
     1869   ON CHOOSE OF StopBtn IN FRAME InfoFrame
     1870   DO:
     1871     IF not StopProcessing THEN
     1872       Message "Вы действительно хотите прервать" SKIP
     1873               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
     1874                 UPDATE StopProcessing.
     1875     IF StopProcessing THEN do:
     1876        if mFrameView
     1877        then do:
     1878           HIDE FRAME InfoFrame.
     1879        end.
     1880     End.
     1881   END.
     1882   assign v-account = ( if integer( 50 ) = 0 then 100 else integer( 50 ) ).
     1883     if  log-manager:logfile-name ne ?
     1884     then DO:
     1885         log-manager:write-message("ON mFrameView=" + string(mFrameView), "frameRepError").
     1886     end.
     1887     if not session:batch-mode then
     1888     do:
     1889       VIEW FRAME InfoFrame.
     1890       mFrameView = true.
     1891     end.
     1892      v-button-stop = false .
     1893         if mFrameView
     1894         then do:
     1895         if v-button-stop then view STOPBTN in frame InfoFrame.
     1896                          else Hide STOPBTN in frame InfoFrame.
     1897         end.
     1898   define temp-table temp-font no-undo
     1899     field fontnum  as integer
     1900     field fontname as character
     1901     field fontsize as character
     1902     field fonttype as character
     1903     field font-h   as integer
     1904     field font-w   as integer
     1905     field v-row    as integer
     1906     field v-col    as integer
     1907     field v-row-lans as integer
     1908     field v-col-lans as integer
     1909   index pi fontnum
     1910   .
     1911   procedure get-font-ini :
     1912     do
     1913     on error undo, return error return-value
     1914     :
     1915   define variable ii as integer   no-undo .
     1916   define variable v-font7 as character no-undo .
     1917   define variable v-font as character no-undo .
     1918   define variable loc-name as character no-undo .
     1919   define variable loc-size as character no-undo .
     1920   define variable loc-type as character no-undo .
     1921   define variable old_H as integer   no-undo .
     1922   define variable old_w as integer   no-undo .
     1923   define variable old-row  as integer   no-undo .
     1924   define variable old-col  as integer   no-undo .
     1925   define variable old-row-lans  as integer   no-undo .
     1926   define variable old-col-lans  as integer   no-undo .
     1927   define variable vv as integer   no-undo .
     1928   empty temp-table temp-font.
     1929     GET-KEY-VALUE SECTION "fonts" KEY "font7" VALUE v-font7 .
     1930       case num-entries (v-font7) :
     1931         when 4 then do:
     1932             assign
     1933               loc-name = entry ( 1 , v-font7 )
     1934               loc-size = entry ( 2 , v-font7 )
     1935               loc-type = entry ( 3 , v-font7 ) + "," +  entry ( 4 , v-font7 )
     1936             .
     1937         end.
     1938         when 3 then do:
     1939             assign
     1940               loc-name = entry ( 1 , v-font7 )
     1941               loc-size = entry ( 2 , v-font7 )
     1942               loc-type = entry ( 3 , v-font7 )
     1943             .
     1944         end.
     1945         when 2 then  do:
     1946             assign
     1947               loc-name = entry ( 1 , v-font7 )
     1948               loc-size = entry ( 2 , v-font7 )
     1949               loc-type = ""
     1950             .
     1951         end.
     1952         when 1 then do:
     1953             assign
     1954               loc-name = trim(entry ( 1 , v-font7 ))
     1955               loc-size = ""
     1956               loc-type = ""
     1957             .
     1958         end.
     1959       end case.
     1960     create temp-font.
     1961     assign
     1962       temp-font.fontnum  = 7
     1963       temp-font.fontname = trim(loc-name)
     1964       temp-font.fontsize = trim(loc-size)
     1965       temp-font.fonttype = trim(loc-type)
     1966       temp-font.v-row    = 62
     1967       temp-font.v-col    = 136
     1968       temp-font.v-row-lans = 43
     1969       temp-font.v-col-lans = 198
     1970     .
     1971     repeat ii = 16 to 100 :
     1972       get-key-value section 'fonts' key 'font' + string(ii)   value v-font  .
     1973       if v-font = "" or v-font = ? then leave.
     1974       case num-entries (v-font) :
     1975         when 4 then do:
     1976             assign
     1977               loc-name = entry ( 1 , v-font )
     1978               loc-size = entry ( 2 , v-font )
     1979               loc-type = entry ( 3 , v-font ) + "," +  entry ( 4 , v-font )
     1980             .
     1981         end.
     1982         when 3 then do:
     1983             assign
     1984               loc-name = entry ( 1 , v-font )
     1985               loc-size = entry ( 2 , v-font )
     1986               loc-type = entry ( 3 , v-font )
     1987             .
     1988         end.
     1989         when 2 then do:
     1990             assign
     1991               loc-name = entry ( 1 , v-font )
     1992               loc-size = entry ( 2 , v-font )
     1993               loc-type = ""
     1994             .
     1995         end.
     1996         when 1 then do:
     1997             assign
     1998               loc-name = trim(entry ( 1 , v-font ))
     1999               loc-size = ""
     2000               loc-type = ""
     2001             .
     2002         end.
     2003       end case.
     2004     create temp-font.
     2005     assign
     2006       temp-font.fontnum  = ii
     2007       temp-font.fontname = trim(loc-name)
     2008       temp-font.fontsize = trim(loc-size)
     2009       temp-font.fonttype = trim(loc-type)
     2010     .
     2011     end.
     2012       for each temp-font :
     2013          vv = integer(entry(2,temp-font.fontsize, "=" )) no-error .
     2014          if  vv = ? then vv =  0 .
     2015           run rep/exfont.p (
     2016             input   temp-font.fontname ,
     2017             input   vv ,
     2018             input   temp-font.fonttype ,
     2019             output  temp-font.font-h   ,
     2020             output  temp-font.font-w   )
     2021           .
     2022       end.
     2023   find first temp-font where  temp-font.fontnum  = 7  .
     2024   old_H = temp-font.font-H .
     2025   old_w = temp-font.font-W .
     2026   old-row = temp-font.v-row .
     2027   old-col = temp-font.v-col .
     2028   old-row-lans = temp-font.v-row-lans .
     2029   old-col-lans = temp-font.v-col-lans .
     2030       for each temp-font where
     2031                temp-font.fontnum  <> 7 :
     2032           assign
     2033               temp-font.v-row    = old_H * old-row / temp-font.font-h
     2034               temp-font.v-col    = old_W * old-col / temp-font.font-W
     2035               temp-font.v-row-lans    = old_H * old-row-lans / temp-font.font-h
     2036               temp-font.v-col-lans    = old_W * old-col-lans / temp-font.font-W
     2037           .
     2038       end.
     2039     end.
     2040   end procedure.
     2041   PROCEDURE How-name :
     2042   define input  parameter h as integer no-undo .
     2043   define input  parameter w as integer no-undo .
     2044   define output parameter n as character  no-undo .
     2045   define variable A4port-H as integer   no-undo init 63.
     2046   define variable A4port-W as integer   no-undo init 136.
     2047   define variable A4lans-H as integer   no-undo init 43.
     2048   define variable A4lans-W as integer   no-undo init 198.
     2049   define variable Strim-W  as integer   no-undo init 278.
     2050   run define-a4-size (
     2051        input ReportFontNum
     2052       ,output A4port-H
     2053       ,output A4port-W
     2054       ,output A4lans-H
     2055       ,output A4lans-W ).
     2056   If w >= 1 and w <= A4port-W Then DO:
     2057     If h >= 1  and h <= A4lans-H Then n = "A4-lans":U.
     2058     If h > A4lans-H  and h <= A4port-H Then n = "A4-port":U.
     2059     If h > A4port-H              Then n = "to-file":U.
     2060   End.
     2061   If w > A4port-W and w <= A4lans-W Then DO:
     2062     If h >= 1  and h <= A4lans-H Then n = "A4-lans":U.
     2063     If h > A4lans-H  and h <= A4port-H Then n = "A3-lans":U.
     2064     If h > A4port-H              Then n = "to-file":U.
     2065   End.
     2066   If w > A4lans-W and w <= Strim-W Then DO:
     2067     If h >= 1  and h <= A4lans-H Then n = "to-file":U.
     2068     If h > A4lans-H  and h <= A4port-H Then n = "A3-lans":U.
     2069     If h > A4port-H              Then n = "to-file":U.
     2070   End.
     2071   If w > Strim-W Then DO:
     2072      n = "to-file":U.
     2073   End.
     2074   END PROCEDURE.
     2075   PROCEDURE define-a4-size :
     2076   define input  parameter p-ReportFontNum as integer   no-undo .
     2077   define output parameter A4port-H as integer   no-undo .
     2078   define output parameter A4port-W as integer   no-undo .
     2079   define output parameter A4lans-H as integer   no-undo .
     2080   define output parameter A4lans-W as integer   no-undo .
     2081   if not can-find (first temp-font ) then do:
     2082      run get-font-ini .
     2083   end.
     2084   find first temp-font where temp-font.fontnum = p-ReportFontNum no-error .
     2085   if available temp-font then do:
     2086   assign
     2087     A4port-H = temp-font.v-row
     2088     A4port-W = temp-font.v-col
     2089     A4lans-H = temp-font.v-row-lans
     2090     A4lans-W = temp-font.v-col-lans
     2091   .
     2092   end.
     2093   else do:
     2094   assign
     2095     A4port-H = 63
     2096     A4port-W = 136
     2097     A4lans-H = 43
     2098     A4lans-W = 198
     2099   .
     2100   end.
     2101   END PROCEDURE.
