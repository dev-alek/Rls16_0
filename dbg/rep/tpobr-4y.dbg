     3054               Run Clear-b1 In This-procedure .
     3055               Assign Break_Group = True.
     3056           End.
     3057           If Last-of((substring(clients.obj-name,1,10) + string(gds-list.prod-code))) Then Do:
     3058           If String(Entry(2,"(substring(clients.obj-name,1,10) + string(gds-list.prod-code))",".")) = "Grp-name"
     3059             Then  Assign
     3060                 S-bar-code   = "Итого по "
     3061                 Gds-zap-artic = Substring(
     3062                                      B1-name
     3063                                     ,1,16)
     3064                 Gds-zap-gds-name = Substring(
     3065                                      B1-name
     3066                                     ,17,40)
     3067                               .
     3068             Else Assign
     3069                 S-bar-code = ""
     3070                 Gds-zap-artic = If  ("4" = "4"  Or  "4" = "5") Then "Итого по "
     3071                                                                    Else "  Итого по "
     3072                 Gds-zap-gds-name =   B1-name
     3073                 .
     3074             Run Display-b2 In This-procedure .
     3075             Run Clear-b2 In This-procedure .
     3076             Run Clear-b1 In This-procedure .
     3077             Assign  Break_Group1 = True.
     3078           End.
     3079       End.
     3080     END.
     3081     Else DO:
     3082      For each obj-list no-lock :
     3083                     FOR EACH gds-obj where
     3084                   gds-obj.obj-type = obj-list.obj-type    and
     3085                   gds-obj.obj-code = obj-list.obj-code
     3086                   and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     3087                   no-lock,
     3088             First gds-list  where gds-obj.gds-code  = gds-list.gds-code
     3089                   no-lock :
     3090                   if NOT can-find(First temp-gds-list where temp-gds-list.gds-code = gds-obj.gds-code) Then do:
     3091                       find first goods no-lock  where goods.gds-code  = gds-obj.gds-code .
     3092                       Create temp-gds-list.
     3093                       Assign
     3094                         temp-gds-list.prod-code = gds-obj.prod-code
     3095                         temp-gds-list.grp-name  = gds-obj.grp-name
     3096                         temp-gds-list.gds-name  = goods.gds-name
     3097                         temp-gds-list.gds-code  = gds-obj.gds-code
     3098                         temp-gds-list.artic     = gds-obj.artic
     3099                       .
     3100                   End.
     3101               End.
     3102     End.
     3103     for each temp-gds-list no-lock
     3104       , First gds-list  where gds-list.gds-code  = temp-gds-list.gds-code no-lock
     3105                                        , First clients   where  clients.obj-code = gds-list.prod-code and
     3106                                                                 clients.obj-type = gds-list.prod-type
     3107         BREAK
     3108   BY (substring(clients.obj-name,1,10) + string(gds-list.prod-code))
     3109   BY (gds-list.grp-name)
     3110       BY gds-list.artic :
     3111       run item-goods ( "4" , "gds-list" ) .
     3112         if return-value <> "" then NEXT.
     3113           If Last-of(gds-list.grp-name) Then Do:
     3114           If String(Entry(2,"gds-list.grp-name",".")) = "Grp-name"
     3115             Then  Assign
     3116                     S-bar-code   = " Итого по "
     3117                     Gds-zap-artic = Substring(
     3118                                          B2-name
     3119                                         ,1,16)
     3120                     Gds-zap-gds-name = Substring(
     3121                                          B2-name
     3122                                         ,17,40)
     3123                                   .
     3124             Else  Assign
     3125                     S-bar-code   = ""
     3126                     Gds-zap-artic = "        Итого по "
     3127                     Gds-zap-gds-name =   B2-name
     3128                                   .
     3129               Run Display-b1 In This-procedure .
     3130               Run Clear-b1 In This-procedure .
     3131               Assign Break_Group = True.
     3132           End.
     3133           If Last-of((substring(clients.obj-name,1,10) + string(gds-list.prod-code))) Then Do:
     3134           If String(Entry(2,"(substring(clients.obj-name,1,10) + string(gds-list.prod-code))",".")) = "Grp-name"
     3135             Then  Assign
     3136                 S-bar-code   = "Итого по "
     3137                 Gds-zap-artic = Substring(
     3138                                      B1-name
     3139                                     ,1,16)
     3140                 Gds-zap-gds-name = Substring(
     3141                                      B1-name
     3142                                     ,17,40)
     3143                               .
     3144             Else Assign
     3145                 S-bar-code = ""
     3146                 Gds-zap-artic = If  ("4" = "4"  Or  "4" = "5") Then "Итого по "
     3147                                                                    Else "  Итого по "
     3148                 Gds-zap-gds-name =   B1-name
     3149                 .
     3150             Run Display-b2 In This-procedure .
     3151             Run Clear-b2 In This-procedure .
     3152             Run Clear-b1 In This-procedure .
     3153             Assign  Break_Group1 = True.
     3154           End.
     3155     End.
     3156   End.
     3157            end.
     3158         end case.
     3159   end procedure.
     3160   procedure calcitog :
     3161       run aht-ostatok (
     3162           input x-store-code     ,
     3163           input x-store-type     ,
     3164           input x-tog-shift      ,
     3165           input x-date-start - 1 ,
     3166           input date('')         ,
     3167           input x-shift-start    ,
     3168           input x-shift-end      ,
     3169           input "n"    ,
     3170           input xtog-obj         ,
     3171           output  fact-order-1 ) .
     3172       run aht-ostatok (
     3173           input x-store-code  ,
     3174           input x-store-type  , x-tog-shift,
     3175           input x-date-start  ,
     3176           input x-date-end    , x-shift-start,x-shift-end,
     3177           input "n" ,
     3178           input xtog-obj ,
     3179           output  fact-order-2 ).
     3180   end procedure.
     3181   procedure display-str1  :
     3182              run di-qnty ("кол-во", 1, s-bar-code,gds-zap-artic,gds-zap-gds-name,gds-zap-unit-base,"").
     3183            if xshowcost    then do: run di ( "учет.", 2,"","","","",""). end.
     3184            if xshowcrsa    then do: run di ( "прод.", 5,"","","","","" ).  end.
     3185            if xshowsale    then do: run di ( "док." , 8,"","","","","" ).  end.
     3186            if vat-cost    then do: run di ( "уч.НДС", 3,"","","","","" ). end.
     3187            if vat-crsa    then do: run di ( "пр.НДС", 6,"","","","","" ).  end.
     3188            if vat-sale    then do: run di ( "дк.НДС", 9,"","","","","" ).  end.
     3189   end procedure.
     3190   procedure display-bi  :
     3191              run di-qnty("кол-во",1,  "", gds-zap-artic ,"" ,"", "bi":u).
     3192            if xshowcost    then do: run di ("учет." , 2 , "","", "", "", "bi":u).  end.
     3193            if xshowcrsa    then do: run di ("прод." , 5, "","", "", "",  "bi":u).  end.
     3194            if xshowsale    then do: run di ("док." , 8, "","", "", "",  "bi":u).  end.
     3195            if vat-cost    then do: run di ( "уч.НДС", 3,"","","","","bi":u ). end.
     3196            if vat-crsa    then do: run di ( "пр.НДС", 6,"","","","","bi":u ).  end.
     3197            if vat-sale    then do: run di ( "дк.НДС", 9,"","","","","bi":u ).  end.
     3198   end procedure.
     3199   procedure display-bo  :
     3200              run di-qnty("кол-во",1,  "", "ИТОГО ПО" ,"ОБЪЕКТАМ" ,"", "bo":u).
     3201            if xshowcost    then do: run di ("учет." , 2 , "","", "", "", "bo":u).  end.
     3202            if xshowcrsa    then do: run di ("прод." , 5, "","", "", "",  "bo":u).  end.
     3203            if xshowsale    then do: run di ("док." , 8, "","", "", "",  "bo":u).  end.
     3204            if vat-cost    then do: run di ( "уч.НДС", 3,"","","","","bo":u ). end.
     3205            if vat-crsa    then do: run di ( "пр.НДС", 6,"","","","","bo":u ).  end.
     3206            if vat-sale    then do: run di ( "дк.НДС", 9,"","","","","bo":u ).  end.
     3207   end procedure.
     3208   procedure display-b1  :
     3209           if  not (not show-negativ  and (
     3210                 b1-prih          [1]   = 0 and
     3211                 b1-rash          [1]   = 0 and
     3212                 b1-kassa         [1]   = 0 and
     3213                 b1-inv           [1]   = 0 and
     3214                 b1-overturn      [1]   = 0 and
     3215                 b1-overturn      [5]   = 0 and
     3216                 b1-ostatok-start [1]   = 0 and
     3217                 b1-ostatok-end   [1]   = 0   )) then do:
     3218                 if sums-only then do:
     3219                     if fr0 = true then do:
     3220                         put stream  outstream  tmp#stroka0 format "x(100)" skip.
     3221                         if Make-Excel then  put   stream ForExcel unformatted string(tmp#stroka0) skip.
     3222                         fr0 = false .
     3223                       end.
     3224                  end.
     3225           run di-qnty in this-procedure ("кол-во"  ,1, s-bar-code, gds-zap-artic, gds-zap-gds-name ,"","b1":u).
     3226           if xshowcost    then do: run di in this-procedure ("учет." ,2 ,"","", "", "", "b1":u).  end.
     3227           if xshowcrsa    then do: run di in this-procedure ("прод." , 5, "","", "", "", "b1":u).  end.
     3228           if xshowsale    then do: run di in this-procedure ("док." , 8, "","", "", "", "b1":u).  end.
     3229           if vat-cost    then do: run di in this-procedure ( "уч.НДС", 3,"","","","","b1":u ). end.
     3230           if vat-crsa    then do: run di in this-procedure ( "пр.НДС", 6,"","","","","b1":u ).  end.
     3231           if vat-sale    then do: run di in this-procedure ( "дк.НДС", 9,"","","","","b1":u ).  end.
     3232          if not sums-only then run p-line.
     3233    end.
     3234   end procedure.
     3235   procedure display-b2  :
     3236           if  not (not show-negativ  and (
     3237                 b2-prih          [1]   = 0 and
     3238                 b2-rash          [1]   = 0 and
     3239                 b2-kassa         [1]   = 0 and
     3240                 b2-inv           [1]   = 0 and
     3241                 b2-overturn      [1]   = 0 and
     3242                 b2-overturn      [5]   = 0 and
     3243                 b2-ostatok-start [1]   = 0 and
     3244                 b2-ostatok-end   [1]   = 0   )) then do:
     3245           run di-qnty( "кол-во", 1 ,s-bar-code,gds-zap-artic, gds-zap-gds-name,"", "b2":u).
     3246           if xshowcost    then do: run di ("учет.", 2, "","", "", "", "b2":u).  end.
     3247           if xshowcrsa    then do: run di ("прод.", 5 ,"","", "", "", "b2":u).  end.
     3248           if xshowsale    then do: run di ("док.", 8 ,"","", "", "", "b2":u).  end.
     3249            if vat-cost    then do: run di ( "уч.НДС", 3,"","","","","b2":u ). end.
     3250            if vat-crsa    then do: run di ( "пр.НДС", 6,"","","","","b2":u ).  end.
     3251            if vat-sale    then do: run di ( "дк.НДС", 9,"","","","","b2":u ).  end.
     3252    end.
     3253   end procedure.
     3254   procedure clear-b1  :
     3255    b1-gds-zap-other           = 0.
     3256    repeat kk = 1 to 9 :
     3257    assign
     3258       b1-prih                                            [kk]    = 0
     3259       b1-rash                                            [kk]    = 0
     3260       b1-kassa                                           [kk]    = 0
     3261       b1-inv                                             [kk]    = 0
     3262       b1-overturn                                        [kk]    = 0
     3263       b1-ostatok-end                                     [kk]    = 0
     3264       b1-ostatok-start                                   [kk]    = 0   .
     3265      end.
     3266    end procedure.
     3267   procedure clear-b2  :
     3268    b2-gds-zap-other      = 0.
     3269    repeat kk = 1 to 9 :
     3270    assign
     3271       b2-prih                                            [kk]    = 0
     3272       b2-rash                                            [kk]    = 0
     3273       b2-kassa                                           [kk]    = 0
     3274       b2-inv                                             [kk]    = 0
     3275       b2-overturn                                        [kk]    = 0
     3276       b2-ostatok-end                                     [kk]    = 0
     3277       b2-ostatok-start                                   [kk]    = 0   .
     3278      end.
     3279   end procedure.
     3280   procedure clear-bi  :
     3281    bi-gds-zap-other           = 0.
     3282    repeat kk = 1 to 9 :
     3283    assign
     3284       bi-prih                                            [kk]    = 0
     3285       bi-rash                                            [kk]    = 0
     3286       bi-kassa                                           [kk]    = 0
     3287       bi-inv                                             [kk]    = 0
     3288       bi-overturn                                        [kk]    = 0
     3289       bi-ostatok-end                                     [kk]    = 0
     3290       bi-ostatok-start                                   [kk]    = 0   .
     3291      end.
     3292   end procedure.
     3293   procedure display-title :
     3294   define variable v-nn as integer   no-undo .
     3295      PUT stream  OutStream  UNFORMATTED  string( v-cntxt-host-name-obj +  " , " + x-store-type  +  " " + objname) at 50 format "x(85)" skip(2)
     3296             reportname  at 20 format "x(170)" skip
     3297             trim(str1)  at 35 format "x(75)" skip.
     3298        v-nn = num-entries(str2,chr(10)).
     3299        repeat i = 1 to v-nn :
     3300         PUT stream  OutStream  UNFORMATTED  entry(i,str2,chr(10))  at 1 format "x(170)" skip.
     3301        end.
     3302       i=0.
     3303          PUT stream  OutStream  UNFORMATTED  trim(str3)  at 35 format "x(75)" skip.
     3304        v-nn  = num-entries(str4,chr(10)) .
     3305        repeat i = 1 to v-nn :
     3306         PUT stream  OutStream  UNFORMATTED  entry(i,str4,chr(10))  at 1 format "x(170)" skip.
     3307        end.
     3308       i=0.
     3309        v-nn = num-entries(reportheader,chr(10)) .
     3310        repeat i = 1 to v-nn  :
     3311         PUT stream  OutStream  UNFORMATTED  entry(i,reportheader,chr(10))  at 1 format "x(170)" skip.
     3312        end.
     3313       i=0.
     3314       run rep/extitle.p (1) .
     3315   end procedure.
     3316   procedure ob-line  :
     3317   define input  parameter x-store-code     like ub.clients.obj-code         no-undo .
     3318   define input  parameter x-store-type     like ub.clients.obj-type         no-undo .
     3319   define input  parameter x-gds-code       like ub.aht-ot-line.gds-code     no-undo .
     3320   define input  parameter x-fact-order-1   like ub.aht-ot-line.fact-order   no-undo .
     3321   define input  parameter x-fact-order-2   like ub.aht-ot-line.fact-order   no-undo .
     3322   define input  parameter x-sum-type       like ub.aht-ot-line.sum-type     no-undo .
     3323   define input  parameter xtog-obj         as logical no-undo .
     3324   define variable      tt#              as integer no-undo .
     3325   define variable x-type-pr1 as character no-undo .
     3326   define variable x-type-pr2 as character no-undo .
     3327    if x-sum-type = arh-type-cost then tt# = 0 .
     3328    if x-sum-type = arh-type-crsa then tt# = 3 .
     3329    if x-sum-type = arh-type-sale then tt# = 6 .
     3330   if  x-sum-type = "cb" then
     3331    assign
     3332       x-type-pr1 = "c"
     3333       x-type-pr2 = "b"
     3334    .
     3335   else
     3336    assign
     3337       x-type-pr1 = x-sum-type
     3338       x-type-pr2 = x-sum-type
     3339    .
     3340        for each ub.aht-ot-line where
     3341                     (      ub.aht-ot-line.gds-code     = x-gds-code
     3342                     and   ub.aht-ot-line.fact-order   <= x-fact-order-2
     3343                     and   ub.aht-ot-line.fact-order   >= x-fact-order-1
     3344                     and   ub.aht-ot-line.obj-code     = x-store-code
     3345                     and   ub.aht-ot-line.obj-type     = x-store-type
     3346                     and   ub.aht-ot-line.sum-type     = x-type-pr1)
     3347                     or
     3348                     (     ub.aht-ot-line.gds-code     = x-gds-code
     3349                     and   ub.aht-ot-line.fact-order   <= x-fact-order-2
     3350                     and   ub.aht-ot-line.fact-order   >= x-fact-order-1
     3351                     and   ub.aht-ot-line.obj-code     = x-store-code
     3352                     and   ub.aht-ot-line.obj-type     = x-store-type
     3353                     and   ub.aht-ot-line.sum-type     = x-type-pr2 )
     3354                     no-lock :
     3355       case ub.aht-ot-line.ext-doc-type:
     3356                 when        'ie':U  or
     3357                 when        're':U  or
     3358                 when        'iv':U    or
     3359                 when        'rv':U or
     3360                 when        'im':U     then
     3361                 do:
     3362                 assign
     3363                        prih[1 ]   = prih[1]   + (if ub.aht-ot-line.sum-type <> "b" then round( ub.aht-ot-line.fact-qnty,3) else 0 )
     3364                        prih[2 ]   = prih[2]   +  if tprintrubl then ub.aht-ot-line.cost-sum-rubl else  ub.aht-ot-line.cost-sum-base
     3365                        prih[3 ]   = prih[3]   +  if tprintrubl then ub.aht-ot-line.cost-vat-rubl else  ub.aht-ot-line.cost-vat-base
     3366                        prih[4 ]   = prih[4]
     3367                        prih[5 ]   = prih[5]   +  if tprintrubl then ub.aht-ot-line.crsa-sum-rubl else  ub.aht-ot-line.crsa-sum-base
     3368                        prih[6 ]   = prih[6]   +  if tprintrubl then ub.aht-ot-line.crsa-vat-rubl else  ub.aht-ot-line.crsa-vat-base
     3369                        prih[7 ]   = prih[7]   +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     3370                        prih[8 ]   = prih[8]   +  if tprintrubl then ub.aht-ot-line.sale-sum-rubl else  ub.aht-ot-line.sale-sum-base
     3371                        prih[9 ]   = prih[9]   +  if tprintrubl then ub.aht-ot-line.sale-vat-rubl else  ub.aht-ot-line.sale-vat-base
     3372                        gds-zap-other   = gds-zap-other  +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     3373                  .
     3374                 end.
     3375                 when       'ee':U      or
     3376                 when       'ep':U    or
     3377                 when       'ev':U     or
     3378                 when       'em':U       or
     3379                 when       'wm':U       or
     3380                 when       'we':U     then
     3381                 do:
     3382                   assign
     3383                       rash[1 ]   = rash[1]   +  (if ub.aht-ot-line.sum-type <> "b" then round( ub.aht-ot-line.fact-qnty,3) else 0 )
     3384                       rash[2 ]   = rash[2]   +  if tprintrubl then ub.aht-ot-line.cost-sum-rubl else  ub.aht-ot-line.cost-sum-base
     3385                       rash[3 ]   = rash[3]   +  if tprintrubl then ub.aht-ot-line.cost-vat-rubl else  ub.aht-ot-line.cost-vat-base
     3386                       rash[4 ]   = rash[4]
     3387                       rash[5 ]   = rash[5]   +  if tprintrubl then ub.aht-ot-line.crsa-sum-rubl else  ub.aht-ot-line.crsa-sum-base
     3388                       rash[6 ]   = rash[6]   +  if tprintrubl then ub.aht-ot-line.crsa-vat-rubl else  ub.aht-ot-line.crsa-vat-base
     3389                       rash[7 ]   = rash[7]   +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     3390                       rash[8 ]   = rash[8]   +  if tprintrubl then ub.aht-ot-line.sale-sum-rubl else  ub.aht-ot-line.sale-sum-base
     3391                       rash[9 ]   = rash[9]   +  if tprintrubl then ub.aht-ot-line.sale-vat-rubl else  ub.aht-ot-line.sale-vat-base
     3392                       gds-zap-other   = gds-zap-other  +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     3393                 .
     3394                 end.
     3395                 when       'es':U  or
     3396                 when       'rs':U then
     3397                 do:
     3398                     assign
     3399                       kassa[1 ]   = kassa[1]   +  (if ub.aht-ot-line.sum-type <> "b" then round( ub.aht-ot-line.fact-qnty,3) else 0 )
     3400                       kassa[2 ]   = kassa[2]   +  if tprintrubl then ub.aht-ot-line.cost-sum-rubl else  ub.aht-ot-line.cost-sum-base
     3401                       kassa[3 ]   = kassa[3]   +  if tprintrubl then ub.aht-ot-line.cost-vat-rubl else  ub.aht-ot-line.cost-vat-base
     3402                       kassa[4 ]   = kassa[4]
     3403                       kassa[5 ]   = kassa[5]   +  if tprintrubl then ub.aht-ot-line.crsa-sum-rubl else  ub.aht-ot-line.crsa-sum-base
     3404                       kassa[6 ]   = kassa[6]   +  if tprintrubl then ub.aht-ot-line.crsa-vat-rubl else  ub.aht-ot-line.crsa-vat-base
     3405                       kassa[7 ]   = kassa[7]   +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     3406                       kassa[8 ]   = kassa[8]   +  if tprintrubl then ub.aht-ot-line.sale-sum-rubl else  ub.aht-ot-line.sale-sum-base
     3407                       kassa[9 ]   = kassa[9]   +  if tprintrubl then ub.aht-ot-line.sale-vat-rubl else  ub.aht-ot-line.sale-vat-base
     3408                       gds-zap-other   = gds-zap-other  +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     3409                       .
     3410                 end.
     3411             when       'vt':U            or
     3412             when       'pc':U or
     3413             when       'vp':U       then  do:
     3414                 assign
     3415                   inv[1 ]   = inv[1]   +  (if ub.aht-ot-line.sum-type <> "b" then round( ub.aht-ot-line.fact-qnty,3) else 0 )
     3416                   inv[2 ]   = inv[2]   +  if tprintrubl then ub.aht-ot-line.cost-sum-rubl else  ub.aht-ot-line.cost-sum-base
     3417                   inv[3 ]   = inv[3]   +  if tprintrubl then ub.aht-ot-line.cost-vat-rubl else  ub.aht-ot-line.cost-vat-base
     3418                   inv[4 ]   = inv[4]
     3419                   inv[5 ]   = inv[5]   +  if tprintrubl then ub.aht-ot-line.crsa-sum-rubl else  ub.aht-ot-line.crsa-sum-base
     3420                   inv[6 ]   = inv[6]   +  if tprintrubl then ub.aht-ot-line.crsa-vat-rubl else  ub.aht-ot-line.crsa-vat-base
     3421                   inv[7 ]   = inv[7]   +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     3422                   inv[8 ]   = inv[8]   +  if tprintrubl then ub.aht-ot-line.sale-sum-rubl else  ub.aht-ot-line.sale-sum-base
     3423                   inv[9 ]   = inv[9]   +  if tprintrubl then ub.aht-ot-line.sale-vat-rubl else  ub.aht-ot-line.sale-vat-base
     3424                   gds-zap-other   = gds-zap-other  +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     3425                   .
     3426                 end.
     3427             when       'ot':U or
     3428             when       'ap':U then
     3429                 do:
     3430                    assign
     3431                       overturn[1 ]   = overturn[1]   +  (if ub.aht-ot-line.sum-type <> "b" then round( ub.aht-ot-line.fact-qnty,3) else 0 )
     3432                       overturn[2 ]   = overturn[2]   +  if tprintrubl then ub.aht-ot-line.cost-sum-rubl else  ub.aht-ot-line.cost-sum-base
     3433                       overturn[3 ]   = overturn[3]   +  if tprintrubl then ub.aht-ot-line.cost-vat-rubl else  ub.aht-ot-line.cost-vat-base
     3434                       overturn[4 ]   = overturn[4]
     3435                       overturn[5 ]   = overturn[5]   +  if tprintrubl then ub.aht-ot-line.crsa-sum-rubl else  ub.aht-ot-line.crsa-sum-base
     3436                       overturn[6 ]   = overturn[6]   +  if tprintrubl then ub.aht-ot-line.crsa-vat-rubl else  ub.aht-ot-line.crsa-vat-base
     3437                       overturn[7 ]   = overturn[7]   +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     3438                       overturn[8 ]   = overturn[8]   +  if tprintrubl then ub.aht-ot-line.sale-sum-rubl else  ub.aht-ot-line.sale-sum-base
     3439                       overturn[9 ]   = overturn[9]   +  if tprintrubl then ub.aht-ot-line.sale-vat-rubl else  ub.aht-ot-line.sale-vat-base
     3440                       gds-zap-other   = gds-zap-other  +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     3441                       .
     3442                 end.
     3443         end case.
     3444     end.
     3445     assign
     3446       tt# = 6
     3447       overturn[1 + tt#]   = (ostatok-end[1 + tt#]  - ostatok-start[1 + tt#] )  -  (inv[1 + tt#] + prih[1 + tt#] + kassa[1 + tt#] + rash[1 + tt#]  )
     3448       overturn[2 + tt#]   = (ostatok-end[2 + tt#]  - ostatok-start[2 + tt#] )  -  (inv[2 + tt#] + prih[2 + tt#] + kassa[2 + tt#] + rash[2 + tt#]  )
     3449       overturn[3 + tt#]   = (ostatok-end[3 + tt#]  - ostatok-start[3 + tt#] )  -  (inv[3 + tt#] + prih[3 + tt#] + kassa[3 + tt#] + rash[3 + tt#]  )
     3450     .
     3451   end procedure.
     3452   procedure report-exec1  :
     3453      find first clients where x-store-type = clients.obj-type and
     3454                               x-store-code = clients.obj-code no-lock no-error.
     3455     run calcitog.
     3456     run print-header.
     3457      case retclassify :
     3458         when "prod/grp-goods":u then          run run4 in this-procedure .
     3459         otherwise do:
     3460           message "error" view-as alert-box error .
     3461         end.
     3462      end case.
     3463     run print-footer.
     3464     end procedure.
     3465   procedure calc-sub-itog :
     3466   define variable b  as int no-undo.
     3467   assign
     3468     b1-gds-zap-other = b1-gds-zap-other +  gds-zap-other
     3469     b2-gds-zap-other = b2-gds-zap-other +  gds-zap-other
     3470     bi-gds-zap-other = bi-gds-zap-other +  gds-zap-other
     3471     bo-gds-zap-other = bo-gds-zap-other +  gds-zap-other
     3472     .
     3473   repeat b = 1 to 10 :
     3474     assign
     3475     b1-ostatok-start[b ]    = b1-ostatok-start[b ]    +  ostatok-start[b ]
     3476     b1-ostatok-end  [b ]    = b1-ostatok-end  [b ]    +  ostatok-end  [b ]
     3477     b2-ostatok-start[b ]    = b2-ostatok-start[b ]    +  ostatok-start[b ]
     3478     b2-ostatok-end  [b ]    = b2-ostatok-end  [b ]    +  ostatok-end  [b ]
     3479     bi-ostatok-start[b ]    = bi-ostatok-start[b ]    +  ostatok-start[b ]
     3480     bi-ostatok-end  [b ]    = bi-ostatok-end  [b ]    +  ostatok-end  [b ]
     3481     bo-ostatok-start[b ]    = bo-ostatok-start[b ]    +  ostatok-start[b ]
     3482     bo-ostatok-end  [b ]    = bo-ostatok-end  [b ]    +  ostatok-end  [b ]
     3483     b1-prih[b ]    = b1-prih[b ]    +  prih[b ]
     3484     b2-prih[b ]    = b2-prih[b ]    +  prih[b ]
     3485     bi-prih[b ]    = bi-prih[b ]    +  prih[b ]
     3486     bo-prih[b ]    = bo-prih[b ]    +  prih[b ]
     3487     b1-rash[b ]    = b1-rash[b ]    +  rash[b ]
     3488     b2-rash[b ]    = b2-rash[b ]    +  rash[b ]
     3489     bi-rash[b ]    = bi-rash[b ]    +  rash[b ]
     3490     bo-rash[b ]    = bo-rash[b ]    +  rash[b ]
     3491     b1-kassa[b ]    = b1-kassa[b ]    +  kassa[b ]
     3492     b2-kassa[b ]    = b2-kassa[b ]    +  kassa[b ]
     3493     bi-kassa[b ]    = bi-kassa[b ]    +  kassa[b ]
     3494     bo-kassa[b ]    = bo-kassa[b ]    +  kassa[b ]
     3495     b1-inv[b ]    = b1-inv[b ]    +  inv[b ]
     3496     b2-inv[b ]    = b2-inv[b ]    +  inv[b ]
     3497     bi-inv[b ]    = bi-inv[b ]    +  inv[b ]
     3498     bo-inv[b ]    = bo-inv[b ]    +  inv[b ]
     3499     b1-overturn[b ]    = b1-overturn[b ]    +  overturn[b ]
     3500     b2-overturn[b ]    = b2-overturn[b ]    +  overturn[b ]
     3501     bi-overturn[b ]    = bi-overturn[b ]    +  overturn[b ]
     3502     bo-overturn[b ]    = bo-overturn[b ]    +  overturn[b ]
     3503     .
     3504   end.
     3505   end procedure.
     3506   procedure clear-item :
     3507   define variable kk as int no-undo.
     3508    gds-zap-other = 0 .
     3509    repeat kk = 1 to 9 :
     3510    assign
     3511       prih            [kk]    = 0
     3512       rash            [kk]    = 0
     3513       kassa           [kk]    = 0
     3514       inv             [kk]    = 0
     3515       overturn        [kk]    = 0
     3516       ostatok-end     [kk]    = 0
     3517       ostatok-start   [kk]    = 0 .
     3518          end.
     3519    end procedure.
     3520   procedure item-goods :
     3521      define input parameter  par-3 as char no-undo.
     3522      define input parameter  par-4 as char no-undo.
     3523        if par-4 = "goods":u  then do:
     3524           assign
     3525               gds-zap-unit-base  = goods.unit-base
     3526               gds-zap-prt-root   = goods.prt-root
     3527               gds-zap-prod-type  = goods.prod-type
     3528               gds-zap-prod-code  = goods.prod-code
     3529               gds-zap-artic      = goods.artic
     3530               gds-zap-grp-name   = goods.grp-name
     3531               gds-zap-b-code     = goods.gds-code
     3532               gds-zap-type       = goods.gds-type.
     3533           if g#gds-engl then
     3534               assign gds-zap-gds-name = goods.engl-name.
     3535           else
     3536               assign gds-zap-gds-name = goods.gds-name.
     3537        end.
     3538        if par-4 = "gds-list":u  then do:
     3539           assign
     3540               gds-zap-unit-base  = gds-list.unit-base
     3541               gds-zap-prt-root   = gds-list.prt-root
     3542               gds-zap-prod-type  = gds-list.prod-type
     3543               gds-zap-prod-code  = gds-list.prod-code
     3544               gds-zap-artic      = gds-list.artic
     3545               gds-zap-grp-name   = gds-list.grp-name
     3546               gds-zap-b-code     = gds-list.gds-code
     3547               gds-zap-type       = gds-list.gds-type.
     3548           if g#gds-engl then
     3549               assign gds-zap-gds-name = gds-list.engl-name.
     3550           else
     3551               assign gds-zap-gds-name = gds-list.gds-name.
     3552        end.
     3553       run foreach.
     3554   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     3555     (input  gds-zap-b-code
     3556     ,input  ?
     3557     ,output v-bar-code
     3558     )  .
     3559   s-bar-code = string (v-bar-code,"999999999").
     3560       If  break_group = true  and par-3 <> "1"  then DO :
     3561            FIND FIRST clients WHERE clients.obj-type = gds-zap-prod-type AND clients.obj-code = gds-zap-prod-code use-index pi NO-LOCK .
     3562            gds-zap-prod-name  = clients.obj-name.
     3563             If break_group1 = true  THEN  DO :
     3564               if (par-3 = "3"  OR  par-3 = "5" ) and  par-3 <> "6"
     3565                 then DO: Assign temp-str = string("ГРУППА : " + gds-zap-grp-name )         b1-name = gds-zap-grp-name . end.
     3566                 else DO: Assign temp-str = string("ПРОИЗВОДИТЕЛЬ : " + gds-zap-prod-name ) b1-name = gds-zap-prod-name. end.
     3567               if par-3 = "6"  then  dO:
     3568                  if xTog-obj = true then do:
     3569                    var-vat-pc = func-vat (input gds-zap-b-code , input x-store-type, input x-store-code)
     3570                     .
     3571                   end.
     3572                  else do:
     3573                   var-vat-pc = temp-gds-list.vat-pc .
     3574                   end.
     3575                   assign
     3576                       temp-str = string( "СТАВКА НДС : " + string(var-vat-pc) + "%" )
     3577                       b1-name = temp-str.
     3578                   end.
     3579               if NOT xSumsOnly or (par-3 = "4" Or par-3 = "5" ) THEN DO :
     3580                   fr0 = true .
     3581                   tmp#stroka0 = temp-str.
     3582               End.
     3583             End.
     3584               IF (par-3 = "4"  OR  par-3 = "5")  THEN DO:
     3585                 if par-3 = "4"
     3586                   then Assign temp-str = string("ГРУППА : " + gds-zap-grp-name )          b2-name = gds-zap-grp-name .
     3587                   else Assign temp-str = string("ПРОИЗВОДИТЕЛЬ : " + gds-zap-prod-name )  b2-name = gds-zap-prod-name.
     3588                 if NOT xSumsOnly THEN DO:
     3589                     fr = true .
     3590                 End.
     3591                 break_group1 = false.
     3592               END.
     3593          break_group = false.
     3594       End.
     3595       run display-line.
     3596    end procedure.
     3597   procedure di :
     3598   define input parameter p1 as char no-undo.
     3599   define input parameter p2 as int no-undo.
     3600   define input parameter p3 as char no-undo.
     3601   define input parameter p4 as char no-undo.
     3602   define input parameter p5 as char no-undo.
     3603   define input parameter p6 as char no-undo.
     3604   define input parameter p7 as char no-undo.
     3605    case caps(p7) :
     3606      when "b1":u  then do:
     3607       DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     3608         p3 @ s-bar-code
     3609         p4 @ gds-zap-artic
     3610         p5 @ gds-zap-gds-name
     3611         p6 @ gds-zap-unit-base
     3612         p1 @ gds-type
     3613         b1-ostatok-start [p2] format "->>>>>>>>>>9.<<" @  F-ostatok-start
     3614         b1-Prih          [p2] format "->>>>>>>>>>9.<<" @  F-Prih
     3615         b1-RAsh          [p2] format "->>>>>>>>>>9.<<" @  F-RAsh
     3616         b1-KAssa         [p2] format "->>>>>>>>>>9.<<" @  F-KAssa
     3617         b1-Inv           [p2] format "->>>>>>>>>>9.<<" @  F-Inv
     3618         b1-Overturn      [p2] format "->>>>>>>>>>9.<<" @  F-Overturn
     3619         b1-Ostatok-end   [p2] format "->>>>>>>>>>9.<<" @  F-Ostatok-end
     3620         b1-gds-zap-other      format "->>>>>>>>>>9.<<" when (p2 = 1) @  gds-zap-other
     3621         with FRAME ZAPAS .
     3622                  DOWN stream   OutStream 1 with FRAME ZAPAS.
     3623                   end.
     3624      when "b2":u  then  do:
     3625       DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     3626         p3 @ s-bar-code
     3627         p4 @ gds-zap-artic
     3628         p5 @ gds-zap-gds-name
     3629         p6 @ gds-zap-unit-base
     3630         p1 @ gds-type
     3631         b2-ostatok-start [p2] format "->>>>>>>>>>9.<<" @  F-ostatok-start
     3632         b2-Prih          [p2] format "->>>>>>>>>>9.<<" @  F-Prih
     3633         b2-RAsh          [p2] format "->>>>>>>>>>9.<<" @  F-RAsh
     3634         b2-KAssa         [p2] format "->>>>>>>>>>9.<<" @  F-KAssa
     3635         b2-Inv           [p2] format "->>>>>>>>>>9.<<" @  F-Inv
     3636         b2-Overturn      [p2] format "->>>>>>>>>>9.<<" @  F-Overturn
     3637         b2-Ostatok-end   [p2] format "->>>>>>>>>>9.<<" @  F-Ostatok-end
     3638         b2-gds-zap-other      format "->>>>>>>>>>9.<<" when (p2 = 1) @  gds-zap-other
     3639         with FRAME ZAPAS .
     3640                  DOWN stream   OutStream 1 with FRAME ZAPAS.
     3641                 end.
     3642      when "bi":u then  do:
     3643       DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     3644         p3 @ s-bar-code
     3645         p4 @ gds-zap-artic
     3646         p5 @ gds-zap-gds-name
     3647         p6 @ gds-zap-unit-base
     3648         p1 @ gds-type
     3649         bi-ostatok-start [p2] format "->>>>>>>>>>9.<<" @  F-ostatok-start
     3650         bi-Prih          [p2] format "->>>>>>>>>>9.<<" @  F-Prih
     3651         bi-RAsh          [p2] format "->>>>>>>>>>9.<<" @  F-RAsh
     3652         bi-KAssa         [p2] format "->>>>>>>>>>9.<<" @  F-KAssa
     3653         bi-Inv           [p2] format "->>>>>>>>>>9.<<" @  F-Inv
     3654         bi-Overturn      [p2] format "->>>>>>>>>>9.<<" @  F-Overturn
     3655         bi-Ostatok-end   [p2] format "->>>>>>>>>>9.<<" @  F-Ostatok-end
     3656         bi-gds-zap-other      format "->>>>>>>>>>9.<<" when (p2 = 1) @  gds-zap-other
     3657         with FRAME ZAPAS .
     3658                  DOWN stream   OutStream 1 with FRAME ZAPAS.
     3659                 end.
     3660      when "bo":u then  do:
     3661       DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     3662         p3 @ s-bar-code
     3663         p4 @ gds-zap-artic
     3664         p5 @ gds-zap-gds-name
     3665         p6 @ gds-zap-unit-base
     3666         p1 @ gds-type
     3667         bo-ostatok-start [p2] format "->>>>>>>>>>9.<<" @  F-ostatok-start
     3668         bo-Prih          [p2] format "->>>>>>>>>>9.<<" @  F-Prih
     3669         bo-RAsh          [p2] format "->>>>>>>>>>9.<<" @  F-RAsh
     3670         bo-KAssa         [p2] format "->>>>>>>>>>9.<<" @  F-KAssa
     3671         bo-Inv           [p2] format "->>>>>>>>>>9.<<" @  F-Inv
     3672         bo-Overturn      [p2] format "->>>>>>>>>>9.<<" @  F-Overturn
     3673         bo-Ostatok-end   [p2] format "->>>>>>>>>>9.<<" @  F-Ostatok-end
     3674         bo-gds-zap-other      format "->>>>>>>>>>9.<<" when (p2 = 1) @  gds-zap-other
     3675         with FRAME ZAPAS .
     3676                  DOWN stream   OutStream 1 with FRAME ZAPAS.
     3677                 end.
     3678      when ""  then  do:
     3679       DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     3680         p3 @ s-bar-code
     3681         p4 @ gds-zap-artic
     3682         p5 @ gds-zap-gds-name
     3683         p6 @ gds-zap-unit-base
     3684         p1 @ gds-type
     3685         ostatok-start [p2] format "->>>>>>>>>>9.<<" @  F-ostatok-start
     3686         Prih          [p2] format "->>>>>>>>>>9.<<" @  F-Prih
     3687         RAsh          [p2] format "->>>>>>>>>>9.<<" @  F-RAsh
     3688         KAssa         [p2] format "->>>>>>>>>>9.<<" @  F-KAssa
     3689         Inv           [p2] format "->>>>>>>>>>9.<<" @  F-Inv
     3690         Overturn      [p2] format "->>>>>>>>>>9.<<" @  F-Overturn
     3691         Ostatok-end   [p2] format "->>>>>>>>>>9.<<" @  F-Ostatok-end
     3692         gds-zap-other      format "->>>>>>>>>>9.<<" when (p2 = 1) @  gds-zap-other
     3693         with FRAME ZAPAS .
     3694                  DOWN stream   OutStream 1 with FRAME ZAPAS.
     3695                 end.
     3696      end case.
     3697    end procedure.
     3698   procedure di-qnty :
     3699   define input parameter p1 as char no-undo.
     3700   define input parameter p2 as int no-undo.
     3701   define input parameter p3 as char no-undo.
     3702   define input parameter p4 as char no-undo.
     3703   define input parameter p5 as char no-undo.
     3704   define input parameter p6 as char no-undo.
     3705   define input parameter p7 as char no-undo.
     3706    case caps(p7) :
     3707      when "b1":u  then do :
     3708       DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     3709         p3 @ s-bar-code
     3710         p4 @ gds-zap-artic
     3711         p5 @ gds-zap-gds-name
     3712         p6 @ gds-zap-unit-base
     3713         p1 @ gds-type
     3714         b1-ostatok-start [p2] format "->>>>>>>>>>9.<<<" @  F-ostatok-start
     3715         b1-Prih          [p2] format "->>>>>>>>>>9.<<<" @  F-Prih
     3716         b1-RAsh          [p2] format "->>>>>>>>>>9.<<<" @  F-RAsh
     3717         b1-KAssa         [p2] format "->>>>>>>>>>9.<<<" @  F-KAssa
     3718         b1-Inv           [p2] format "->>>>>>>>>>9.<<<" @  F-Inv
     3719         b1-Overturn      [p2] format "->>>>>>>>>>9.<<<" @  F-Overturn
     3720         b1-Ostatok-end   [p2] format "->>>>>>>>>>9.<<<" @  F-Ostatok-end
     3721         b1-gds-zap-other      format "->>>>>>>>>>9.<<<" when (p2 = 1) @  gds-zap-other
     3722         with FRAME ZAPAS .
     3723   if Make-Excel then  put   stream ForExcel unformatted
     3724     p3 CHR(9)
     3725     p4 CHR(9)
     3726     gds-zap-gds-name CHR(9)
     3727     p6 CHR(9)
     3728     gds-zap-type     CHR(9)
     3729     excel-sum(b1-gds-zap-other   )   CHR(9)
     3730     excel-qnty(b1-ostatok-start[1])  CHR(9)
     3731     excel-sum(b1-ostatok-start[2])  CHR(9)
     3732     excel-sum(b1-ostatok-start[5])  CHR(9)
     3733     excel-sum(b1-ostatok-start[8])  CHR(9)
     3734     excel-sum(b1-ostatok-start[3])  CHR(9)
     3735     excel-sum(b1-ostatok-start[6])  CHR(9)
     3736     excel-sum(b1-ostatok-start[9])  CHR(9)
     3737     excel-qnty(b1-Prih         [1])  CHR(9)
     3738     excel-sum(b1-Prih         [2])  CHR(9)
     3739     excel-sum(b1-Prih         [5])  CHR(9)
     3740     excel-sum(b1-Prih         [8])  CHR(9)
     3741     excel-sum(b1-Prih         [3])  CHR(9)
     3742     excel-sum(b1-Prih         [6])  CHR(9)
     3743     excel-sum(b1-Prih         [9])  CHR(9)
