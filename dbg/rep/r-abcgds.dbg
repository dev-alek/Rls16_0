      822   def var vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      823   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
      824   procedure paramls-clear :
      825     define buffer buf_temp-param for temp-param .
      826     do
      827     on error undo, return error return-value
      828     :
      829       for each buf_temp-param
      830       on error undo, return error
      831       :
      832         delete buf_temp-param .
      833       end.
      834     end.
      835   end procedure.
      836   procedure paramls-write :
      837     define input  parameter p-code     as character no-undo .
      838     define input  parameter p-sub-code as character no-undo .
      839     define input  parameter p-value    as character no-undo .
      840     define buffer buf_temp-param for temp-param .
      841     do
      842     on error undo, return error return-value
      843     :
      844       find first buf_temp-param
      845         where buf_temp-param.param-code     = p-code
      846           and buf_temp-param.param-sub-code = p-sub-code
      847         no-error .
      848       if not available buf_temp-param then do:
      849         create buf_temp-param .
      850         assign
      851           buf_temp-param.param-code     = p-code
      852           buf_temp-param.param-sub-code = p-sub-code
      853         .
      854       end.
      855       assign
      856         buf_temp-param.param-value = p-value
      857       .
      858     end.
      859   end procedure.
      860   procedure paramls-read :
      861     define input  parameter p-code          as character no-undo .
      862     define input  parameter p-sub-code      as character no-undo .
      863     define input  parameter p-default-value as character no-undo .
      864     define output parameter p-value         as character no-undo .
      865     define buffer buf_temp-param for temp-param .
      866     do
      867     on error undo, return error return-value
      868     :
      869       find first buf_temp-param
      870         where buf_temp-param.param-code     = p-code
      871           and buf_temp-param.param-sub-code = p-sub-code
      872         no-error .
      873       if available buf_temp-param then do:
      874         assign
      875           p-value = buf_temp-param.param-value
      876         .
      877       end.
      878       else do:
      879         assign
      880           p-value = p-default-value
      881         .
      882       end.
      883     end.
      884   end procedure.
      885   procedure paramls-append :
      886     define input  parameter p-code     as character no-undo .
      887     define input  parameter p-sub-code as character no-undo .
      888     define input  parameter p-value    as character no-undo .
      889     define buffer buf_temp-param for temp-param .
      890     do
      891     on error undo, return error return-value
      892     :
      893       find first buf_temp-param
      894            where buf_temp-param.param-code     = p-code
      895              and buf_temp-param.param-sub-code = p-sub-code
      896         no-error .
      897       if not available buf_temp-param then do:
      898         create buf_temp-param .
      899         assign
      900           buf_temp-param.param-code     = p-code
      901           buf_temp-param.param-sub-code = p-sub-code
      902           buf_temp-param.param-value    = p-value
      903         .
      904       end.
      905       else do:
      906           assign
      907               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
      908           .
      909       end.
      910     end.
      911   end procedure.
      912   function excel-format-dec-to-char returns char (input p-dec as decimal ).
      913     if num-entries(string(p-dec), '.') = 2
      914       then return( entry(1, string(p-dec), '.') + v-delim + entry(2, string(p-dec), '.')) .
      915       else return( string(p-dec)) .
      916   end function.
      917   function format-point-to-comma returns char (input orig as char ) .
      918   define variable rtext as character no-undo .
      919   define variable strt as integer no-undo .
      920   define variable leng as integer no-undo .
      921   assign rtext = orig .
      922   repeat:
      923     strt =  index(rtext,'.').
      924     if strt = 0 then leave.
      925     leng = 1.
      926     substring(rtext,strt,leng,"character") = v-delim .
      927   end.
      928   return rtext.
      929   end function.
      930   function format-excel-text returns char ( input start-text as char ) :
      931   def var  i    as int no-undo.
      932   def var  ch   as char no-undo.
      933   def var  n    as int no-undo.
      934   def var  ipos as int no-undo.
      935     n = num-entries(trim(start-text), chr(10)) - 1 .
      936     do i = 1 to n :
      937       ipos = index( start-text, chr(10)).
      938       if ipos > 0 then
      939         substr( start-text, ipos, 1 ) = ' '.
      940     end.
      941     n = num-entries(trim(start-text), chr(13)) - 1 .
      942     do i = 1 to n :
      943       ipos = index( start-text, chr(13)).
      944       if ipos > 0 then
      945         substr( start-text, ipos, 1 ) = ' '.
      946     end.
      947     if index( start-text, '"' ) = 0 then
      948       start-text =  '="'   + trim( start-text) + '"'   .
      949       else do:
      950         n = num-entries(trim(start-text), '"') - 1.
      951         do i = 1 to n :
      952           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
      953         end.
      954         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
      955         start-text = '="'  + ch  + '"' .
      956       end.
      957     return start-text.
      958   end.
      959   function excel-sum returns char (input p-dec as decimal ).
      960     return(format-excel-text(excel-format-dec-to-char(round(p-dec,2)))) .
      961   end function.
      962   function excel-qnty returns char (input p-dec as decimal ).
      963     return(format-excel-text(excel-format-dec-to-char(round(p-dec,3)))) .
      964   end function.
      965   function format-excel-text-macr returns char ( input start-text as char ) :
      966   def var  i    as int no-undo.
      967   def var  ch   as char no-undo.
      968   def var  n    as int no-undo.
      969   def var  ipos as int no-undo.
      970     n = num-entries(trim(start-text), chr(10)) - 1 .
      971     do i = 1 to n :
      972       ipos = index( start-text, chr(10)).
      973       if ipos > 0 then
      974         substring( start-text, ipos , 1 ) = ' '.
      975     end.
      976     n = num-entries(trim(start-text), chr(13)) - 1 .
      977     do i = 1 to n :
      978       ipos = index( start-text, chr(13)).
      979       if ipos > 0 then
      980         substring( start-text, ipos, 1 ) = ' '.
      981     end.
      982     if index( start-text, '"' ) = 0 then
      983       start-text =  '"'   + trim( start-text) + '"'   .
      984       else do:
      985         n = num-entries(trim(start-text), '"') - 1.
      986         do i = 1 to n :
      987           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
      988         end.
      989         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
      990         start-text = '"'  + ch  + '"' .
      991       end.
      992     n = num-entries(trim(start-text), chr(10)) - 1 .
      993     do i = 1 to n :
      994       ipos = index( start-text, chr(10)).
      995       if ipos > 0 then
      996         substring( start-text, ipos , 1 ) = ' '.
      997     end.
      998       if num-entries(trim(start-text), chr(10)) > 1 then  message num-entries(trim(start-text), chr(10)) start-text.
      999     return start-text.
     1000   end.
     1001   def var vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1002   function func-get-name-from-ext-type   returns char
     1003     ( p-ext-type as character   ,
     1004       p-caps     as logical ).
     1005   define variable v-ext-name as character no-undo .
     1006   run get-name-from-ext-type in this-procedure (
     1007       input p-ext-type  ,
     1008       input p-caps  ,
     1009       output v-ext-name )
     1010       no-error .
     1011       if error-status :error then do:
     1012          assign
     1013            v-ext-name = p-ext-type
     1014          .
     1015       end.
     1016    return (v-ext-name) .
     1017   end.
     1018   procedure get-name-from-ext-type :
     1019    do
     1020    on error undo, return error return-value
     1021    :
     1022   define input  parameter p-ext-type as character no-undo .
     1023   define input  parameter p-caps     as logical no-undo   .
     1024   define output parameter p-ext-name as character no-undo .
     1025   define variable v-num as integer no-undo .
     1026     if lookup ( p-ext-type , 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U ) = 0 then do :
     1027       message
     1028         vss-include-info10 skip
     1029         "Неправильно задано значение входящего параметра! "
     1030         "Нет такого типа документов " p-ext-type
     1031         view-as alert-box error .
     1032         undo, return error .
     1033     end.
     1034     v-num      = lookup ( p-ext-type , 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U ) .
     1035     p-ext-name = entry  ( v-num , 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U ) .
     1036     if p-caps  = true then do :
     1037        p-ext-name = caps(substring(p-ext-name,1,1) ) + substring(p-ext-name, 2 , length (p-ext-name) - 1 ) .
     1038     end .
     1039     end.
     1040   end procedure.
     1041   Make-Excel      = true.
     1042   Make-Excel-com  = false .
     1043   define buffer buf_abc-analysis            for ub.abc-analysis.
     1044   define buffer buf_abc-analysis-goods      for ub.abc-analysis-goods.
     1045   define buffer buf_abc-analysis-gds-obj    for ub.abc-analysis-gds-obj.
     1046   define buffer buf_abc-analysis-obj        for ub.abc-analysis-obj.
     1047   define buffer buf_assortment-matrix       for ub.assortment-matrix.
     1048   define buffer buf_assortment-matrix-goods for ub.assortment-matrix-goods.
     1049   define buffer buf_gds-obj-prop            for ub.gds-obj-prop .
     1050   define buffer buf_criterion-analysis      for ub.criterion-analysis .
     1051   define buffer buf_abc-analysis-grp        for ub.abc-analysis-grp  .
     1052   define buffer buf_gds-grp                 for ub.gds-grp  .
     1053   define buffer buf2_abc-analysis-goods     for ub.abc-analysis-goods .
     1054   DEFINE temp-table temp-str no-undo
     1055     field   gds-code    as integer
     1056     field   artic       as char
     1057     field   gds-name    as char
     1058     field   grp-code    as int
     1059     field   grp-name    as char
     1060     field   prod-name   as char
     1061     field   prc         as char
     1062   index  pi  IS PRIMARY  prc
     1063   .
     1064   define temp-table temp-abc no-undo
     1065     field  nn         as integer
     1066     field  id         as integer
     1067     field  db-num      like ub.abc-analysis.db-num
     1068     field  type        as character
     1069     field  name        like ub.abc-analysis.abc-name
     1070     field  des         like ub.abc-analysis.abc-des
     1071     field  name-cral   like ub.criterion-analysis.cral-name
     1072     field  A           like ub.abc-analysis.abc-a
     1073     field  B           like ub.abc-analysis.abc-b
     1074     field  C           like ub.abc-analysis.abc-c
     1075     field  D           like ub.abc-analysis.abc-d
     1076     field  E           like ub.abc-analysis.abc-E
     1077     field  F           like ub.abc-analysis.abc-F
     1078     field  date-cr     like ub.abc-analysis.abc-date-create
     1079     field  period       as character
     1080     field  ext-doc-type as character
     1081     field  obj          as character
     1082     index pi nn
     1083     index pi2 id db-num
     1084   .
     1085   define variable var-i as integer   no-undo .
     1086   define variable var-kol as integer   no-undo .
     1087   var-kol = num-entries (p-rez).
     1088   repeat var-i = 1 to var-kol :
     1089      find first buf_abc-analysis no-lock where recid(buf_abc-analysis) = int(entry(var-i,p-rez )) no-error .
     1090      if not available buf_abc-analysis  then next.
     1091      find first  buf_criterion-analysis no-lock where buf_criterion-analysis.cral-id = buf_abc-analysis.cral-id no-error .
     1092      if not available buf_criterion-analysis  then next.
     1093       create temp-abc.
     1094       assign
     1095       temp-abc.nn           = var-i
     1096       temp-abc.id           = buf_abc-analysis.abc-id
     1097       temp-abc.db-num       = buf_abc-analysis.db-num
     1098       temp-abc.type         = if buf_abc-analysis.abc-type = "2"  then "Двухпроходный, ограничение Е <= " + string(buf_abc-analysis.le-proc)  else " "
     1099       temp-abc.name         = buf_abc-analysis.abc-name
     1100       temp-abc.des          = buf_abc-analysis.abc-des
     1101       temp-abc.name-cral   = buf_criterion-analysis.cral-name
     1102       temp-abc.A           = buf_abc-analysis.abc-a
     1103       temp-abc.B           = buf_abc-analysis.abc-b
     1104       temp-abc.C           = buf_abc-analysis.abc-c
     1105       temp-abc.D           = buf_abc-analysis.abc-d
     1106       temp-abc.E           = buf_abc-analysis.abc-E
     1107       temp-abc.F           = buf_abc-analysis.abc-F
     1108       temp-abc.date-cr     = buf_abc-analysis.abc-date-create
     1109       temp-abc.period      = buf_abc-analysis.abc-string-period
     1110       temp-abc.ext-doc-type = ""
     1111       .
     1112       define buffer buf_abc-analysis-doc for ub.abc-analysis-doc.
     1113        for each buf_abc-analysis-doc no-lock where
     1114                 buf_abc-analysis-doc.abc-id = buf_abc-analysis.abc-id and
     1115                 buf_abc-analysis-doc.db-num = buf_abc-analysis.db-num
     1116        :
     1117        temp-abc.ext-doc-type = temp-abc.ext-doc-type + func-get-name-from-ext-type (buf_abc-analysis-doc.abcd-ext-doc-type , true ) + "," .
     1118        end.
     1119        for each buf_abc-analysis-obj no-lock where
     1120                 buf_abc-analysis-obj.abc-id = buf_abc-analysis.abc-id and
     1121                 buf_abc-analysis-obj.db-num = buf_abc-analysis.db-num
     1122        :
     1123        temp-abc.obj = temp-abc.obj +  buf_abc-analysis-obj.obj-type + " " + string(buf_abc-analysis-obj.obj-code) + "," .
     1124        end.
     1125   end.
     1126   define stream  macr_excel .
     1127   define variable g#report-num  as integer   no-undo .
     1128   define variable v-file-name as character no-undo .
     1129   define variable p-file-name as character no-undo .
     1130   define variable v-ind       as integer   no-undo .
     1131   define variable num#col#    as integer no-undo .
     1132   define variable C-c         as integer no-undo .
     1133   define variable C-str       as character no-undo .
     1134   define variable str--1      as character Format "x(60)" no-undo.
     1135   define variable str--2      as integer no-undo .
     1136   define variable C-i         as integer no-undo .
     1137   define variable p-var       as integer no-undo .
     1138   define variable var-1       as integer no-undo .
     1139   define variable var-2       as integer no-undo .
     1140   def buffer buf_clients for ub.clients .
     1141   def buffer This_Object for ub.clients .
     1142   def buffer buf_goods   for ub.goods .
     1143   define variable qnty as decimal   no-undo .
     1144   define variable sum  as decimal   no-undo .
     1145   define variable vv-qnty1 as decimal   no-undo .
     1146   define variable vv-qnty2 as decimal   no-undo .
     1147   define variable num-ln as integer   no-undo .
     1148   def var i as int no-undo.
     1149   def var j as int no-undo.
     1150   define variable Counter1 as integer init 0  no-undo .
     1151   def var LineBuf       as char    no-undo.
     1152   def var Line       as char    no-undo.
     1153   def var UndLine    as char    no-undo.
     1154   def var Lines_Counter as   int  init 0  no-undo.
     1155   def var Tmp_Counter   as   int  init 0  no-undo.
     1156   def var tdoc-date     like ub.fbr-pln.doc-date no-undo.
     1157   def var tdoc-code     like ub.fbr-pln.doc-code no-undo.
     1158   def var  abbr              as  char no-undo.
     1159   def var  pp                as  char no-undo.
     1160     if session:set-wait-state("compiler") then.
     1161     define variable v-prn0 as character no-undo .
     1162     if var-report-r-b = "rubl" then assign pp = "Цены руб.".
     1163                                else assign pp = "Цены  баз.вал." .
     1164   define variable v-account as integer init 0 no-undo .
     1165   define variable v-account-lavel as character no-undo .
     1166   define variable v-button-stop as logical no-undo .
     1167   define variable v-kol-spice as integer no-undo .
     1168   define variable v-kol-spice2 as integer no-undo .
     1169   define variable v-kol-spice3 as integer no-undo .
     1170   DEFINE VARIABLE StopProcessing AS LOGICAL NO-UNDO.
     1171   DEFINE BUTTON StopBtn AUTO-END-KEY
     1172        LABEL "Стоп"
     1173        SIZE 10 BY 1.
     1174   DEFINE VARIABLE RecordsDone AS INTEGER FORMAT ">,>>>,>>>,>>9":U INITIAL 0
     1175        LABEL "Обработано записей"
     1176         VIEW-AS TEXT
     1177        SIZE 14 BY .67 NO-UNDO.
     1178   DEFINE VARIABLE RecordsString AS CHARACTER FORMAT "X(60)"
     1179         VIEW-AS TEXT
     1180        SIZE 53.25 BY .67
     1181        FGCOLOR 1  NO-UNDO.
     1182   DEFINE VARIABLE RecordsString2 AS CHARACTER FORMAT "X(60)"
     1183         VIEW-AS TEXT
     1184        SIZE 53.25 BY .67
     1185        FGCOLOR 1  NO-UNDO.
     1186   DEFINE VARIABLE RecordsString3 AS CHARACTER FORMAT "X(60)"
     1187         VIEW-AS TEXT
     1188        SIZE 53.25 BY .67
     1189        FGCOLOR 1  NO-UNDO.
     1190   DEFINE RECTANGLE RECT-1
     1191        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1192        SIZE 55.13 BY 4.46.
     1193   DEFINE FRAME InfoFrame
     1194        StopBtn AT ROW 4.25 COL 21.75
     1195        RecordsString AT ROW 1.21 COL 2 NO-LABEL
     1196        RecordsString2 AT ROW 1.96 COL 2 NO-LABEL
     1197        RecordsString3 AT ROW 2.58 COL 2 NO-LABEL
     1198        RecordsDone AT ROW 3.42 COL 24.88 COLON-ALIGNED
     1199        RECT-1 AT ROW 1 COL 1
     1200       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1201            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1202            TITLE "Процесс"
     1203            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
     1204   define variable mFrameView      as logical   no-undo init yes.
     1205     define variable mFramHandle as handle no-undo.
     1206     mFramHandle = frame InfoFrame:handle.
     1207     if  log-manager:logfile-name ne ?
     1208     then DO:
     1209         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1210         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1211         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
     1212     end.
     1213     mFrameView = not session:batch-mode and mFramHandle:visible.
     1214     if mFrameView
     1215     then do:
     1216       ASSIGN
     1217          FRAME InfoFrame:HIDDEN                           = TRUE
     1218          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
     1219     end.
     1220   ON CHOOSE OF StopBtn IN FRAME InfoFrame
     1221   DO:
     1222     IF not StopProcessing THEN
     1223       Message "Вы действительно хотите прервать" SKIP
     1224               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
     1225                 UPDATE StopProcessing.
     1226     IF StopProcessing THEN do:
     1227        if mFrameView
     1228        then do:
     1229           HIDE FRAME InfoFrame.
     1230        end.
     1231     End.
     1232   END.
     1233   assign v-account = ( if integer( 25 ) = 0 then 100 else integer( 25 ) ).
     1234     if  log-manager:logfile-name ne ?
     1235     then DO:
     1236         log-manager:write-message("ON mFrameView=" + string(mFrameView), "frameRepError").
     1237     end.
     1238     if not session:batch-mode then
     1239     do:
     1240       VIEW FRAME InfoFrame.
     1241       mFrameView = true.
     1242     end.
     1243      v-button-stop = false .
     1244         if mFrameView
     1245         then do:
     1246         if v-button-stop then view STOPBTN in frame InfoFrame.
     1247                          else Hide STOPBTN in frame InfoFrame.
     1248         end.
     1249   v-ind = 0    .
     1250       Output stream Macr_Excel  close .
     1251       num#str# = 0 .
     1252       run gbl/_tmpfile.p ( "wb", ".txt", output v-file-name) .
     1253       output stream macr_excel to value(v-file-name)   .
     1254       v-ind = v-ind + 1.
     1255    run get-report-num  in parParentProc(output g#report-num).
     1256       define stream  Stream-rpt .
     1257       p-file-name =  string( session:temp-directory +
     1258                     "rpt" + string( g#report-num ) + ".txt" ) .
     1259       output stream stream-rpt to value(p-file-name)   .
     1260       output stream stream-rpt close  .
     1261     run PrintTitul in this-procedure .
     1262     for each temp-str :  delete temp-str.  end.
     1263     run make-tt.
     1264     for each temp-str no-lock :
     1265          run print-line in this-procedure .
     1266     end.
     1267     run PrintPodval in this-procedure .
     1268     run paramls-write in this-procedure
     1269       (input "file"
     1270       ,input string(v-ind)
     1271       ,input v-file-name
     1272       ) .
     1273   Output stream Macr_Excel  close .
     1274   if mFrameView
     1275   then do:
     1276      HIDE FRAME InfoFrame.
     1277   end.
     1278       run paramls-write in this-procedure
     1279           (input "charcol"
     1280           ,input ""
     1281           ,input "1,3,4,5,6"
     1282           ) .
     1283     run end-proc .
     1284     run rep/runexcel.p (p-file-name ).
     1285   procedure print-line :
     1286     do on error undo, return error return-value :
     1287   num#str# = num#str# + 1.
     1288   num#col# = 1.
     1289   run macr_excel_char ( temp-str.artic     , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1290   run macr_excel_char ( temp-str.gds-code  , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1291   run macr_excel_char ( temp-str.gds-name  , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1292   run macr_excel_char ( temp-str.grp-code  , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1293   run macr_excel_char ( temp-str.grp-name  , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1294   run macr_excel_char ( temp-str.prod-name , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1295   for each temp-abc:
     1296     find first ub.abc-analysis-goods no-lock where
     1297                ub.abc-analysis-goods.abc-id = temp-abc.id and
     1298                ub.abc-analysis-goods.db-num = temp-abc.db-num and
     1299                ub.abc-analysis-goods.gds-code = temp-STR.gds-code no-error .
     1300     if available ub.abc-analysis-goods then do:
     1301        run macr_excel_char ( ub.abc-analysis-goods.abcg-abc  + string(ub.abc-analysis-goods.rating)               , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1302        run macr_excel_DEC ( ub.abc-analysis-goods.abcg-prcnt-for-estimate , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1303        run macr_excel_DEC ( ub.abc-analysis-goods.abcg-sum-for-estimate   , num#str# , num#col#   ) .
     1304   define variable v-color as integer   no-undo .
     1305       if ub.abc-analysis-goods.abcg-abc = "A" then
     1306          assign
     1307            v-color = 3
     1308          .
     1309       if ub.abc-analysis-goods.abcg-abc = "C" then
     1310          assign
     1311            v-color = 0
     1312          .
     1313       if ub.abc-analysis-goods.abcg-abc = "B" then
     1314          assign
     1315             v-color = 41
     1316          .
     1317       if ub.abc-analysis-goods.abcg-abc = "D" then
     1318          assign
     1319            v-color = 14
     1320          .
     1321       if ub.abc-analysis-goods.abcg-abc = "E" then
     1322          assign
     1323            v-color = 13
     1324          .
     1325       if ub.abc-analysis-goods.abcg-abc = "F" then
     1326          assign
     1327             v-color = 48
     1328          .
     1329      put  stream macr_excel unformatted
     1330           substitute('select("r&1c&2:r&3c&4 ")' , num#str# , num#col# - 2 , num#str# , num#col# ) + chr(10)
     1331           substitute('font.properties(,,,,,,,,,&1,,,)', v-color ) + chr(10) .
     1332        assign    num#col# = num#col# + 1 .
     1333     end.
     1334     ELSE
     1335     num#col# = num#col# + 3 .
     1336   end.
     1337     end.
     1338   end procedure.
     1339   procedure print-all-itog :
     1340   end procedure.
     1341   procedure PrintTitul :
     1342     do  on error undo, return error return-value  :
     1343     define variable cc as integer no-undo .
     1344     define variable tt as integer no-undo .
     1345       num#str# = num#str# + 1.
     1346       num#col# = 2.
     1347       cc = num#str# .
     1348       run macr_excel_char ( "Сравнение ABC анализов"  , num#str# , num#col#   ) .
     1349       num#str# = num#str# + 1.
     1350       num#col# = 2.
     1351       run macr_excel_char ("Печать " + cur-time-date()  , num#str# , num#col#   ) .
     1352       run macr_cell_format
     1353           ( 12     ,
     1354             true   ,
     1355             false  ,
     1356             ?      ,
     1357             cc     ,
     1358             2      ,
     1359             num#str# ,
     1360             2 ) .
     1361       run pshap in this-procedure .
     1362        num#str# = num#str# + 1.
     1363       num#col# = 1.
     1364       run macr_excel_char ( "Артикул товара"   , num#str# , num#col#   ) .
     1365       run macr_cell_size ( 10 , ? , num#str# , num#col# , ?, ? ) .
     1366       num#col# = 2.
     1367       run macr_excel_char ( "Код"   , num#str# , num#col#   ) .
     1368       run macr_cell_size ( 10 , ? , num#str# , num#col# , ?, ? ) .
     1369       num#col# = 3.
     1370       run macr_excel_char ( "ТМЦ"   , num#str# , num#col#   ) .
     1371       run macr_cell_size ( 25 , ? , num#str# , num#col# , ?, ? ) .
     1372       num#col# = 4.
     1373       run macr_excel_char ( "Код группы"   , num#str# , num#col#   ) .
     1374       run macr_cell_size ( 10 , ? , num#str# , num#col# , ?, ? ) .
     1375       num#col# = 5.
     1376       run macr_excel_char ( "Группа"   , num#str# , num#col#   ) .
     1377       run macr_cell_size ( 32 , ? , num#str# , num#col# , ?, ? ) .
     1378       num#col# = 6.
     1379       run macr_excel_char ( "Производитель"   , num#str# , num#col#   ) .
     1380       run macr_cell_size ( 20 , ? , num#str# , num#col# , ?, ? ) .
     1381       for each temp-abc :
     1382           num#col# = num#col# + 1.
     1383           run macr_excel_char ( "Анализ № " + string(temp-abc.nn) , num#str# , num#col#   ) .
     1384           run macr_cell_size ( 10 , ? , num#str# , num#col# , ?, ? ) .
     1385           num#col# = num#col# + 1.
     1386           run macr_excel_char (  "%"  , num#str# , num#col#   ) .
     1387           run macr_cell_size ( 5 , ? , num#str# , num#col# , ?, ? ) .
     1388           num#col# = num#col# + 1.
     1389           run macr_excel_char ( "Сумма по критерию"  , num#str# , num#col#   ) .
     1390           run macr_cell_size ( 15 , ? , num#str# , num#col# , ?, ? ) .
     1391           if temp-abc.nn modulo 2 = 0 then do:
     1392               run macr_cell_format
     1393               ( 10    ,
     1394                 true  ,
     1395                 false  ,
     1396                 33    ,
     1397                 num#str# ,
     1398                 num#col# - 2 ,
     1399                 num#str# ,
     1400                 num#col# ) .
     1401           end.
     1402           else do:
     1403               run macr_cell_format
     1404               ( 10    ,
     1405                 true  ,
     1406                 false  ,
     1407                 34    ,
     1408                 num#str# ,
     1409                 num#col# - 2 ,
     1410                 num#str# ,
     1411                 num#col# ) .
     1412           end.
     1413       end.
     1414       run macr_cell_format
     1415       ( 10    ,
     1416         true  ,
     1417         false  ,
     1418         ?    ,
     1419         num#str# ,
     1420         1 ,
     1421         num#str# ,
     1422         14 ) .
     1423        put  stream macr_excel unformatted
     1424          substitute('select("r&1c&2:r&3c&4 ")' , num#str# , 1 , num#str# ,  num#col# ) + chr(10)  +
     1425          'BORDER( 2 , 2 , 2 , 2 , 2 , ,0,0,0,0,0) '  + chr(10) +
     1426          'ALIGNMENT(3 , , 4 , 4 ,)'  + chr(10)
     1427          .
     1428     end.
     1429   end procedure.
     1430   procedure PrintPodval :
     1431     do on error undo, return error return-value  :
     1432       num#str# = num#str# + 3.
     1433       num#col# = 1.
     1434       run macr_excel_char ( "Исполнитель"   , num#str# , num#col#   ) .
     1435       num#col# = 3.
     1436       run macr_excel_char ( p-user-name  , num#str# , num#col#   ) .
     1437     end.
     1438   end procedure.
     1439   procedure make-tt :
     1440     do
     1441     on error undo, return error return-value
     1442     :
     1443   define buffer buf_abc-analysis-goods  for ub.abc-analysis-goods.
     1444   define buffer buf_goods               for ub.goods.
     1445   define buffer buf_clients             for ub.clients  .
     1446   define variable  v-izt      as character no-undo .
     1447   define variable  v-acc-mat as character no-undo .
     1448   define variable  v-Amin    as character no-undo .
     1449   for each temp-abc :
     1450     for each buf_abc-analysis-goods no-lock where
     1451              buf_abc-analysis-goods.abc-id = temp-abc.id  and
     1452              buf_abc-analysis-goods.db-num = temp-abc.db-num :
     1453       if not can-find ( first temp-str where temp-str.gds-code  = buf_abc-analysis-goods.gds-code) then do:
     1454           find first buf_goods no-lock where buf_goods.gds-code =  buf_abc-analysis-goods.gds-code no-error .
     1455           find first buf_clients no-lock where buf_clients.obj-type = buf_goods.prod-type and buf_clients.obj-code = buf_goods.prod-code no-error .
     1456           create temp-str .
     1457           assign
     1458               temp-str.prc       = buf_abc-analysis-goods.abcg-abc + string ( buf_abc-analysis-goods.rating , "999999999999" )
     1459               temp-str.gds-code  = buf_abc-analysis-goods.gds-code
     1460               temp-str.artic     = buf_goods.artic
     1461               temp-str.gds-name  = buf_goods.gds-name
     1462               temp-str.grp-code  = buf_goods.grp-code
     1463               temp-str.grp-name  = buf_goods.grp-name
     1464               temp-str.prod-name = buf_clients.obj-name
     1465           .
     1466       end.
     1467     end.
     1468   end.
     1469     end.
     1470    end procedure.
     1471   procedure pshap :
     1472     do
     1473     on error undo, return error return-value
     1474     :
     1475     define variable tt as integer   no-undo .
     1476       num#str# = num#str# + 1.
     1477       num#col# = 1.
     1478       tt = num#str# .
     1479       for each temp-abc :
     1480           run macr_excel_char ( "Анализ № " + string(temp-abc.nn )                , num#str# , num#col#   ) .
     1481               run macr_cell_format
     1482               ( 10    ,
     1483                 true  ,
     1484                 false  ,
     1485                 ?    ,
     1486                 num#str# ,
     1487                 num#col#  ,
     1488                 num#str# ,
     1489                 num#col# ) .
     1490           num#str# = num#str# + 1.
     1491           run macr_excel_char ( temp-abc.name               , num#str# , num#col#   ) . num#str# = num#str# + 1.
     1492           if temp-abc.des <> "" then do:  run macr_excel_char ( temp-abc.des                , num#str# , num#col#   ) . num#str# = num#str# + 1. end.
     1493           run macr_excel_char ( temp-abc.name-cral          , num#str# , num#col#   ) . num#str# = num#str# + 1.
     1494           run macr_excel_char ( "A=" + string( temp-abc.A )                 , num#str# , num#col#   ) . num#str# = num#str# + 1.
     1495           run macr_excel_char ( "B=" + string( temp-abc.B )                 , num#str# , num#col#   ) . num#str# = num#str# + 1.
     1496           run macr_excel_char ( "C=" + string( temp-abc.C )                 , num#str# , num#col#   ) . num#str# = num#str# + 1.
     1497           if temp-abc.D > 0 then do:  run macr_excel_char ( "D=" + string(temp-abc.D )   , num#str# , num#col#   ) .    num#str# = num#str# + 1. end.
     1498           if temp-abc.E > 0 then do:  run macr_excel_char ( "E=" + string(temp-abc.E )   , num#str# , num#col#   ) .    num#str# = num#str# + 1. end.
     1499           if temp-abc.F > 0 then do:  run macr_excel_char ( "F=" + string(temp-abc.F )   , num#str# , num#col#   ) .    num#str# = num#str# + 1. end.
     1500           if temp-abc.type <> " " then do: run macr_excel_char ( temp-abc.type          , num#str# , num#col#   ) .  num#str# = num#str# + 1.    end.
     1501           run macr_excel_char ( "создан : " + string(temp-abc.date-cr , "99/99/9999")            , num#str# , num#col#   ) . num#str# = num#str# + 1.
     1502           run macr_excel_char ( temp-abc.period             , num#str# , num#col#   ) .  num#str# = num#str# + 1.
     1503           run macr_excel_char ( temp-abc.ext-doc-type       , num#str# , num#col#   ) .  num#str# = num#str# + 1.
     1504           run macr_excel_char ( temp-abc.obj                , num#str# , num#col#   ) .  num#str# = num#str# + 1.
     1505       end.
     1506     end.
     1507   end procedure.
     1508   def var vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1509   procedure macr_excel_char :
     1510    do
     1511    on error undo, return error return-value
     1512    :
     1513    define input parameter  p-val as character no-undo .
     1514    define input parameter  p-row as integer no-undo .
     1515    define input parameter  p-col as integer no-undo .
     1516    if p-val = ? then p-val = "" .
     1517       put stream macr_excel unformatted
     1518             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     1519    end.
     1520   end procedure.
     1521   procedure macr_excel_char_with_format :
     1522    do
     1523    on error undo, return error return-value
     1524    :
     1525    define input parameter  p-val as character no-undo .
     1526    define input parameter  p-row as integer no-undo .
     1527    define input parameter  p-col as integer no-undo .
     1528    if p-val = ? then p-val = "" .
     1529       put stream macr_excel unformatted
     1530             substitute('select("r&1c&2")', p-row , p-col ) + chr(10) .
     1531       put stream macr_excel unformatted 'format.number("@")' + chr(10) .
     1532       put stream macr_excel unformatted
     1533             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     1534    end.
     1535   end procedure.
     1536   procedure macr_excel_cell_format :
     1537    do
     1538    on error undo, return error return-value
     1539    :
     1540    define input parameter  p-val    as character no-undo .
     1541    define input parameter  p-row    as integer   no-undo .
     1542    define input parameter  p-col    as integer   no-undo .
     1543    define input parameter  p-format as character no-undo .
     1544    if p-val = ? then p-val = "" .
     1545       put stream macr_excel unformatted
     1546             substitute('select("r&1c&2")', p-row , p-col ) + chr(10) .
     1547       put stream macr_excel unformatted substitute('format.number("&1")', p-format) + chr(10) .
     1548       put stream macr_excel unformatted
     1549             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     1550    end.
     1551   end procedure.
     1552   procedure macr_excel_sum :
     1553    do
     1554    on error undo, return error return-value
     1555    :
     1556    define input parameter  p-row as integer no-undo .
     1557    define input parameter  p-col as integer no-undo .
     1558    define input parameter  p-row1 as integer no-undo .
     1559    define input parameter  p-col1 as integer no-undo .
     1560    define input parameter  p-row2 as integer no-undo .
     1561    define input parameter  p-col2 as integer no-undo .
     1562       put stream macr_excel unformatted
     1563             substitute('formula("=sum(r&3c&4:r&5c&6)","r&1c&2")', p-row , p-col , p-row1 , p-col1 ,p-row2 , p-col2 ) + chr(10)  .
     1564    end.
     1565   end procedure.
     1566   procedure macr_excel_dec :
     1567    do
     1568    on error undo, return error return-value
     1569    :
     1570    define input parameter  p-val as character no-undo .
     1571    define input parameter  p-row as integer   no-undo .
     1572    define input parameter  p-col as integer   no-undo .
     1573     if p-val = ? then p-val =  "" .
     1574      put  stream macr_excel unformatted
     1575           substitute('formula(&3,"r&1c&2")', p-row , p-col ,  p-val )  + chr(10) .
     1576    end.
     1577   end procedure.
     1578   procedure macr_cell_format :
     1579    do
     1580    on error undo, return error return-value
     1581    :
     1582    define input parameter  p-size   as integer   no-undo .
     1583    define input parameter  p-bold   as logical   no-undo .
     1584    define input parameter  p-italic as logical   no-undo .
     1585    define input parameter  p-color  as integer   no-undo .
     1586    define input parameter  p-row    as integer   no-undo .
     1587    define input parameter  p-col    as integer   no-undo .
     1588    define input parameter  p-row-2  as integer   no-undo .
     1589    define input parameter  p-col-2  as integer   no-undo .
     1590     if p-size = ? then p-size = 10 .
     1591     if p-bold = ? then p-bold = false .
     1592     if p-italic = ? then p-italic = false .
     1593     if p-row-2 = ? then p-row-2 = p-row .
     1594     if p-col-2 = ? then p-col-2 = p-col .
     1595     put  stream macr_excel unformatted
     1596      substitute('select("r&1c&2:r&3c&4 ")' , p-row , p-col , p-row-2 , p-col-2 ) + chr(10) .
     1597     if p-color <> ? then do:
     1598        put  stream macr_excel unformatted
     1599          substitute('patterns(1,,&1,true)', p-color ) + chr(10)  .
     1600     end.
     1601     put  stream macr_excel unformatted
     1602          substitute('format.font(,&1,&2,&3)' , p-size,
     1603                                           string ( p-bold  , "true/false" ) ,
     1604                                           string ( p-italic , "true/false" )
     1605                                           ) + chr(10) .
     1606    end.
     1607   end procedure.
     1608   procedure macr_cell_size :
     1609    do
     1610    on error undo, return error return-value
     1611    :
     1612    define input parameter  p-w   as integer   no-undo .
     1613    define input parameter  p-l   as integer   no-undo .
     1614    define input parameter  p-row    as integer   no-undo .
     1615    define input parameter  p-col    as integer   no-undo .
     1616    define input parameter  p-row-2  as integer   no-undo .
     1617    define input parameter  p-col-2  as integer   no-undo .
     1618     if p-row-2 = ? then p-row-2 = p-row .
     1619     if p-col-2 = ? then p-col-2 = p-col .
     1620     if p-w = ? then    p-w = 0 .
     1621     if p-l = ? then    p-l = 0 .
     1622    define variable s-w as character no-undo .
     1623    define variable s-l as character no-undo .
     1624    if p-w = 0 then s-w = "" .
     1625               else s-w = string(p-w)  .
     1626    if p-l = 0 then s-l = "" .
     1627               else s-l = string(p-l)  .
     1628   put  stream macr_excel unformatted
     1629        substitute('select("r&1c&2:r&3c&4 ")' , p-row , p-col , p-row-2 , p-col-2 )  skip .
     1630   put  stream macr_excel unformatted
     1631        substitute('COLUMN.WIDTH(&1,,,,)' , s-w  )  skip.
     1632   put  stream macr_excel unformatted
     1633        'FORMAT.TEXT(2,2,0,,,,,)'  skip.
     1634    end.
     1635   end procedure.
     1636   procedure proc-print-header :
     1637    do
     1638    on error undo, return error return-value
     1639    :
     1640      find first sheetf .
     1641        sheetf.excel-row-heder =  num-entries( c-str ,chr(10)) + 1.
     1642        sheetf.excel-row-title =  num-entries( sheetf.excel-column-lable , chr(10) ).
     1643        var-1 =  num#str# .
     1644        repeat c-c = 1 to sheetf.excel-row-title :
     1645        num#str# = num#str# + 1 .
     1646        p-var = num-entries( entry (c-c, sheetf.excel-column-lable, chr(10)) , chr(44) ) .
     1647        do c-i = 1 to p-var :
     1648           str--1 = entry( c-i, entry (c-c,sheetf.excel-column-lable, chr(10)) , chr(44)) .
     1649           str--2 = integer(entry( c-i, sheetf.sizes )) .
     1650           num#col# = c-i .
     1651           run macr_excel_char_with_format ( str--1  , num#str# , num#col#  ) .
     1652           run macr_cell_size ( str--2 , ? , num#str# , num#col# , ?, ? ) .
     1653        end.
     1654       c-i = 0.
     1655       end.
     1656       run macr_cell_format (
     1657           10       ,
     1658           true     ,
     1659           false    ,
     1660           35       ,
     1661           var-1 + 1,
     1662           1        ,
     1663           num#str# ,
     1664           num#col# )
     1665           .
     1666     put  stream macr_excel unformatted
     1667          substitute('select("r&1c&2:r&3c&4 ")' , var-1 + 1 , 1 , num#str# ,  num#col# ) + chr(10)  +
     1668          'ALIGNMENT(3 , , 4 , 4 ,)'  + chr(10)
     1669          .
     1670    end.
     1671   end procedure.
     1672   procedure end-proc :
     1673    do
     1674    on error undo, return error return-value
     1675    :
     1676     v-file-name = ( string( session:temp-directory + "rpt" + string( g#report-num ) ) + ".t-t").
     1677     OUTPUT to VALUE (v-file-name) .
     1678     for each temp-param :
     1679       export  temp-param  .
     1680     end.
     1681    end.
     1682   end procedure.
