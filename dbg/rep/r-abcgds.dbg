      370   def
      371   new shared
      372   temp-table  obj-list no-undo
      373     field obj-type like ub.clients.obj-type
      374     field obj-code like ub.clients.obj-code
      375     field obj-name like ub.clients.obj-name
      376     field obj-id   as integer
