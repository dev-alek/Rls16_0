      915    :
      916   define input  parameter p-host-code    like ub.c-fin-doc-attr.host-code    no-undo .
      917   define input  parameter p-fin-doc-code like ub.c-fin-doc-attr.fin-doc-code     no-undo .
      918   define input parameter p-corr-user-db-num  like ub.c-fin-doc-attr.corr-user-db-num   no-undo .
      919   define input parameter p-chip-num      like ub.c-fin-doc-attr.chip-num   no-undo .
      920   define input  parameter p-attr-code    like ub.c-fin-doc-attr.attr-code    no-undo .
      921   define output parameter p-attr-value   like ub.c-fin-doc-attr.attr-value   no-undo .
      922   define variable  v-format         as character no-undo .
      923   define variable  v-label          as character no-undo .
      924   define variable  v-user-can-edit  as logical   no-undo .
      925   define variable  v-output-display as logical   no-undo .
      926   define variable  v-other          as character no-undo .
      927   define variable  v-type           as character no-undo .
      928   define buffer buf_c-fin-doc-attr for ub.c-fin-doc-attr.
      929   run fd-attr-code in this-procedure
      930     (input  p-attr-code
      931     ,output v-type
      932     ,output v-format
      933     ,output v-label
      934     ,output v-user-can-edit
      935     ,output v-output-display
      936     ,output v-other
      937     ) no-error .
      938   if error-status :error then do:
      939     undo, return error return-value .
      940   end.
      941   find first buf_c-fin-doc-attr no-lock where
      942             buf_c-fin-doc-attr.attr-code    = p-attr-code
      943         and buf_c-fin-doc-attr.fin-doc-code      = p-fin-doc-code
      944         and buf_c-fin-doc-attr.host-code      = p-host-code
      945         and buf_c-fin-doc-attr.corr-user-db-num = p-corr-user-db-num
      946         and buf_c-fin-doc-attr.chip-num         > p-chip-num      no-error .
      947     if available  buf_c-fin-doc-attr then do:
      948       assign
      949       p-attr-value = buf_c-fin-doc-attr.attr-value
      950       .
      951     end.
      952     else do:
      953       p-attr-value = ? .
      954     end.
      955    end.
      956   end procedure.
      957   define   shared variable g#auto as logical no-undo.
      958   define   shared variable g#news as logical no-undo.
      959   define   shared variable g#oxml as logical no-undo.
      960   define   shared variable g#esys as logical no-undo.
      961   define   shared variable g#news-source-db as integer no-undo.
      962   define   shared variable g#esys-source-esys as integer no-undo.
      963   define   shared variable g#db-num as integer   no-undo .
      964   define   shared variable g#userid as character no-undo .
      965   define   shared variable g#passwd as character no-undo .
      966   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      967   FUNCTION gbclcode-is-this-db-code returns logical ( input p-db-num as integer
      968                                                       ,input p-range-type as character
      969                                                       ,input p-code as integer):
      970   define variable v-seq-val as integer no-undo .
      971   define buffer buf_code-range for ub.code-range.
      972   find first buf_code-range no-lock where
      973             buf_code-range.db-num = p-db-num
      974       and  buf_code-range.range-type = p-range-type
      975       and  buf_code-range.stts = 'u'
      976       and buf_code-range.first-code <= p-code
      977       and buf_code-range.last-code >= p-code no-error .
      978   if available buf_code-range then return yes.
      979   CASE p-range-type:
      980     when 'pngb':U then do:
      981       v-seq-val = current-value(s-pngb-code, ub).
      982     end.
      983     when 'fmgb':U then do:
      984       v-seq-val = current-value(s-fmgb-code, ub).
      985     end.
      986   END CASE.
      987   if p-code <= v-seq-val then do:
      988     find first buf_code-range no-lock where
      989               buf_code-range.db-num = p-db-num
      990         and  buf_code-range.range-type = p-range-type
      991         and  buf_code-range.stts = 'a'
      992         and buf_code-range.first-code <= p-code
      993         no-error .
      994    if available buf_code-range then return yes.
      995   end.
      996   find first buf_code-range no-lock where
      997             buf_code-range.db-num = p-db-num
      998       and  buf_code-range.range-type = p-range-type
      999       and  buf_code-range.stts = 'f'
     1000       and buf_code-range.first-code <= p-code
     1001       and buf_code-range.last-code >= p-code
     1002       no-error .
     1003   if available buf_code-range then return yes.
     1004   return no.
     1005   END FUNCTION.
     1006   FUNCTION gbclcode-is-this-db-code-short returns logical ( input p-db-num as integer
     1007                                                       ,input p-range-type as character
     1008                                                       ,input p-code as integer):
     1009   define variable v-seq-val as integer no-undo .
     1010   define buffer buf_code-range for ub.code-range.
     1011   CASE p-range-type:
     1012     when 'pngb':U then do:
     1013       v-seq-val = current-value(s-pngb-code, ub).
     1014     end.
     1015     when 'fmgb':U then do:
     1016       v-seq-val = current-value(s-fmgb-code, ub).
     1017     end.
     1018   END CASE.
     1019   if p-code <= v-seq-val then do:
     1020     find first buf_code-range no-lock where
     1021               buf_code-range.db-num = p-db-num
     1022         and  buf_code-range.range-type = p-range-type
     1023         and buf_code-range.first-code <= p-code
     1024         and buf_code-range.last-code >= p-code no-error .
     1025     if available buf_code-range then return yes.
     1026   end.
     1027   return no.
     1028   END FUNCTION.
     1029   FUNCTION gbclcode-is-this-db-role returns integer ( input p-role as character
     1030                                                       ,input p-db-num as integer
     1031                                                       ,input p-staff-code as integer
     1032                                                       ,input p-date as date
     1033                                                        ):
     1034   define buffer buf_staff for ub.staff.
     1035   if p-date = ? then do:
     1036     p-date = today .
     1037   end.
     1038   find first buf_staff no-lock where
     1039             buf_staff.role = p-role
     1040         and buf_staff.role-level = 'db':U
     1041         and buf_staff.db-num = p-db-num
     1042         and buf_staff.staff-code = p-staff-code
     1043         and buf_staff.date-end >= p-date use-index pi  no-error .
     1044   if available buf_staff then do:
     1045     return buf_staff.psn-code.
     1046   end.
     1047   return 0.
     1048   end FUNCTION.
     1049   FUNCTION gbclcode-get-this-db-first-role returns integer ( input p-role as character
     1050                                                             ,input p-db-num as integer
     1051                                                             ,input p-date as date
     1052                                                                 ):
     1053   define buffer buf_staff for ub.staff.
     1054   define buffer buf2_staff for ub.staff.
     1055   if p-date = ? then do:
     1056     p-date = today .
     1057   end.
     1058   for each  buf_staff no-lock where
     1059             buf_staff.role = p-role
     1060         and buf_staff.db-num = p-db-num,
     1061   first buf2_staff no-lock where
     1062         buf2_staff.role = p-role
     1063     and buf2_staff.role-level = 'db':U
     1064     and buf2_staff.staff-code = buf_staff.staff-code
     1065     and buf2_staff.date-start <= p-date
     1066     and buf2_staff.date-end >= p-date
     1067   by buf_staff.staff-code
     1068   by date-start descending:
     1069     return buf_staff.staff-code.
     1070   end.
     1071   end FUNCTION.
     1072   FUNCTION gbclcode-get-db-role returns integer ( input p-role as character
     1073                                                  ,input p-db-num as integer
     1074                                                  ,input p-psn-code as integer
     1075                                                  ,input p-date as date
     1076                                                  ,output p-c-password as character
     1077                                                        ):
     1078   define buffer buf_staff for ub.staff.
     1079   if p-date = ? then do:
     1080     p-date = today .
     1081   end.
     1082   find first buf_staff no-lock where
     1083             buf_staff.role = p-role
     1084         and buf_staff.role-level = 'db':U
     1085         and buf_staff.db-num = p-db-num
     1086        and buf_staff.date-end >= p-date
     1087        and buf_staff.psn-code = p-psn-code use-index irole-psn no-error .
     1088   if available buf_staff
     1089   then do:
     1090     assign
     1091     p-c-password = buf_staff.password.
     1092     return buf_staff.staff-code.
     1093   end.
     1094   p-c-password = ''.
     1095   return 0.
     1096   end FUNCTION.
     1097   FUNCTION gbclcode-is-psn-role returns integer (
     1098                                                 input p-role as character
     1099                                                 ,input p-psn-code as integer
     1100                                                 ,input p-date as date
     1101                                                     ):
     1102   define buffer buf_staff for ub.staff.
     1103   if p-date = ? then do:
     1104     p-date = today .
     1105   end.
     1106   for each buf_staff no-lock where
     1107             buf_staff.psn-code = p-psn-code
     1108        and  buf_staff.role = p-role
     1109   by buf_staff.role-level
     1110   by buf_staff.date-start
     1111        :
     1112     if  buf_staff.date-start <= p-date and
     1113     buf_staff.date-end >= p-date  then do:
     1114       return buf_staff.staff-code.
     1115     end.
     1116   end.
     1117   return 0.
     1118   end FUNCTION.
     1119   FUNCTION gbclcode-get-role-name returns character ( input p-role as character):
     1120   define variable v-role-name as character no-undo .
     1121   assign
     1122   v-role-name = entry (lookup (p-role, 'C,S':U) + 1, ',':U + 'Кассир,Продавец':U)
     1123   no-error .
     1124   return v-role-name.
     1125   END.
     1126   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1127   FUNCTION gbclcode-get-position returns character ( input p-role as character
     1128                                                     ,input p-role-level as character
     1129                                                     ,input p-work-place as character
     1130                                                     ,input p-staff-code as integer
     1131                                                                ):
     1132   define variable v-role-name as character no-undo .
     1133   define variable v-role-level as character no-undo .
     1134   define variable v-staff-code as integer no-undo .
     1135   assign
     1136   v-role-name = entry (lookup (p-role, 'C,S':U) + 1, ',':U + 'Кассир,Продавец':U)
     1137   v-role-level = substitute("&1 &2", entry (lookup (p-role-level, 'global,db,firm,object':U) + 1, ',':U + 'Глобально,БД,Фирма,Объект':U) , p-work-place)
     1138   v-staff-code = p-staff-code
     1139   no-error .
     1140   return substitute("&1, &2, Код &3"
     1141                   ,v-role-name
     1142                   ,v-role-level
     1143                   ,(if p-staff-code = 0 then chr(63) else string(p-staff-code))).
     1144   END.
     1145   FUNCTION gbclcode-get-work-place returns character (
     1146                                                   input p-role as character
     1147                                                  ,input p-role-level as character
     1148                                                  ,input p-db-num as integer
     1149                                                  ,input p-host-code as integer
     1150                                                  ,input p-obj-type as character
     1151                                                  ,input p-obj-code as integer
     1152                                                  ) :
     1153   define variable v-work-place as character no-undo .
     1154   define variable v-obj-type as character no-undo .
     1155     case p-role-level:
     1156       when 'db':U then do:
     1157         v-work-place = string(p-db-num, "99999").
     1158       end.
     1159       when 'firm':U then do:
     1160         v-work-place = string(p-host-code, "99999").
     1161       end.
     1162       when 'object':U then do:
     1163         assign
     1164         v-work-place = p-obj-type + string(p-obj-code, "999999999")
     1165         .
     1166       end.
     1167     END CASE.
     1168     return v-work-place.
     1169   END FUNCTION.
     1170   FUNCTION gbclcode-get-level-last-code returns integer (
     1171                                                           input p-role as character
     1172                                                         , input p-role-level as character
     1173                                                         , input p-work-place as character
     1174                                                         , input p-date-start as date
     1175                                                         ):
     1176   DEFINE VARIABLE v-today as date no-undo .
     1177   define buffer buf_staff for ub.staff.
     1178   if p-work-place = chr(63) then return ?.
     1179   if p-date-start = ? then do:
     1180     v-today = today .
     1181   end.
     1182   else do:
     1183     v-today = p-date-start.
     1184   end.
     1185   find last buf_staff no-lock where
     1186             buf_staff.role = p-role
     1187        and  buf_staff.role-level = p-role-level
     1188        and  buf_staff.work-place = p-work-place
     1189        and  buf_staff.date-start <= v-today + 1
     1190        and  buf_staff.date-end >= v-today + 1
     1191        use-index pi  no-error .
     1192   if available buf_staff
     1193   then return buf_staff.staff-code.
     1194   return 0.
     1195   end FUNCTION.
     1196   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1197   define new shared stream PrnLibStream.
     1198   procedure prn-lib-prn-file :
     1199     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1200     define input parameter p-DIsabledoptions as integer no-undo .
     1201     define variable v-report-name as character no-undo .
     1202     define variable v-user-action as character no-undo .
     1203     define variable v-printed     as logical   no-undo .
     1204     define variable v-exist       as logical   no-undo .
     1205     do
     1206       on error undo, return error
     1207       :
     1208       run prn-lib-get-report-name  in this-procedure (
     1209         input parParentProc
     1210         ,output v-report-name
     1211         ).
     1212   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1213   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
     1214     (input  v-report-name
     1215     ,input  2
     1216     ,output v-exist
     1217     )  .
     1218       if NOT v-exist then
     1219       DO:
     1220         Message
     1221           "Нет заданий на печать ! "
     1222           view-as alert-box .
     1223         Return  .
     1224       End.
     1225       run gbl/prnfilen.w
     1226         (input  ""
     1227         ,input  p-DisabledOptions
     1228         ,input  string(v-report-name )
     1229         ,input  7
     1230         ,output v-user-action
     1231         ,output v-printed
     1232         ) .
     1233       if v-printed then
     1234       do:
     1235         return "YES" .
     1236       end.
     1237       else
     1238       do:
     1239         return "NO" .
     1240       end.
     1241     end.
     1242   end procedure.
     1243   procedure prn-lib-open-stream :
     1244     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1245     define input parameter p-page-size    as integer no-undo .
     1246     define input parameter p-is-stream    as logical no-undo .
     1247     define input parameter p-append       as logical no-undo .
     1248     define variable v-report-name as character no-undo .
     1249     do
     1250       on error undo, return error
     1251       :
     1252       run prn-lib-get-report-name  in this-procedure (
     1253         input parParentProc
     1254         ,output v-report-name
     1255         ).
     1256       if p-is-stream then
     1257       do:
     1258         if p-append then
     1259         do:
     1260           output stream PrnLibStream to value( v-report-name )
     1261             page-size value(p-page-size) append .
     1262         end.
     1263         if not p-append then
     1264         do:
     1265           output stream PrnLibStream to value( v-report-name )
     1266             page-size value(p-page-size) .
     1267         end.
     1268       end.
     1269       if not p-is-stream then
     1270       do:
     1271         if p-append then
     1272         do:
     1273           output to value( v-report-name )
     1274             page-size value(p-page-size) append .
     1275         end.
     1276         if not p-append then
     1277         do:
     1278           output to value( v-report-name )
     1279             page-size value(p-page-size) .
     1280         end.
     1281       end.
     1282     end.
     1283   end procedure.
     1284   procedure prn-lib-open-exp :
     1285     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1286     define input parameter p-is-stream    as logical no-undo .
     1287     define input parameter p-is-append    as logical no-undo .
     1288     define output parameter p-ReportFileName as char init "report" no-undo.
     1289     define output parameter p-process as logical no-undo .
     1290     define variable glog as logical no-undo .
     1291     do
     1292       on error undo, return error
     1293       :
     1294       SYSTEM-DIALOG GET-FILE p-ReportFileName
     1295         TITLE      "Укажите путь"
     1296         FILTERS "Текстовый файл (*.txt)"   "*.txt"
     1297         ASK-OVERWRITE
     1298         CREATE-TEST-FILE
     1299         SAVE-AS
     1300         USE-FILENAME
     1301         DEFAULT-EXTENSION "txt"
     1302         UPDATE glog
     1303         .
     1304       if not glog then  return.
     1305       p-ReportFileName = trim( string( p-ReportFileName ) ) .
     1306       if p-is-stream then
     1307       do:
     1308         if p-is-append then
     1309         do:
     1310           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1311         end.
     1312         else
     1313         do:
     1314           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1315         end.
     1316       end.
     1317       else
     1318       do:
     1319         if p-is-append then
     1320         do:
     1321           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1322         end.
     1323         else
     1324         do:
     1325           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1326         end.
     1327       end.
     1328       p-process = yes.
     1329     end.
     1330   end procedure.
     1331   procedure prn-lib-get-report-name :
     1332     define input parameter parParentProc  as widget-handle no-undo.
     1333     define output parameter p-report-name as character no-undo .
     1334     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
     1335   end procedure.
     1336   procedure prn-lib-reportviewer-report-name :
     1337     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1338     define input parameter p-report-name-html as character no-undo .
     1339     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
     1340   end procedure.
     1341   procedure prn-lib-reportviewer :
     1342     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1343     define input parameter p-report-name-html as character no-undo .
     1344     define input parameter p-param        as character no-undo .
     1345     define variable v-excel           as character no-undo init 'TRUE' .
     1346     define variable v-value-character as character no-undo .
     1347     define variable v-value-integer   as character no-undo .
     1348     define variable v-value-date      as date      no-undo .
     1349     define variable v-value-decimal   as decimal   no-undo .
     1350     define variable rep-excel         as logical   no-undo .
     1351     define variable excel-string      as character no-undo .
     1352     define variable v-param-type      as character no-undo .
     1353     define variable v-tth             as handle    no-undo .
     1354     run adm/shattri.p (
     1355       input "get":U
     1356       ,input  ""
     1357       ,input  0
     1358       ,input  'report-glob':U
     1359       ,input  'rep-excel':U
     1360       ,output v-value-character
     1361       ,output v-value-date
     1362       ,output v-value-decimal
     1363       ,output v-value-integer
     1364       ,output rep-excel
     1365       ,output v-param-type
     1366       ,INPUT-OUTPUT table-handle v-tth
     1367       )  .
     1368     if rep-excel then v-excel = "TRUE" .
     1369     else v-excel = "FALSE" .
     1370     if p-param eq ""
     1371     then
     1372        p-param = "EXCEL:" + v-excel.
     1373     else
     1374        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
     1375     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
     1376   end procedure.
     1377   define  temp-table tt-rep no-undo
     1378      field obj-type          as character
     1379      field obj-code          as integer
     1380      field obj-name          as character
     1381      field chk-date          as date
     1382      field chk-time          as integer
     1383      field sort-date         as date
     1384      field sort-time         as integer
     1385      field shift-date        as date
     1386      field shift-name        as character
     1387      field doc-code          as character
     1388      field chk-num           as integer
     1389      field line-num          as integer
     1390      field doc-num2          as character
     1391      field z-number          as integer
     1392      field tran-num          as integer
     1393      field chk-type-desc     as character
     1394      field pay-desk          as character
     1395      field cash-num          as integer
     1396      field cashier           as character
     1397      field trk-num           as integer
     1398      field nozzle-num        as integer
     1399      field fuel-code         as integer
     1400      field gds-name          as character
     1401      field volume            as decimal
     1402      field price             as decimal
     1403      field money             as decimal
     1404      field cash-pay-code     as integer
     1405      field cash-pay-name     as character
     1406      field pay-card          as character
     1407      field datetime-beg      as datetime
     1408      field date-beg          as date
     1409      field time-beg          as integer
     1410      field datetime-end      as datetime
     1411      field date-end          as date
     1412      field time-end          as integer
     1413      field time-length       as integer
     1414      field all-time-length   as integer
     1415      field all-time-length-2 as integer
     1416      field multi-pay         as logical
     1417      field resume-tran       as logical
     1418      field uuid              as character
     1419      field uuid-cheq         as character
     1420      field grp-num           as integer
     1421      field db-num            as integer
     1422   index pi obj-code shift-date shift-name sort-date sort-time pay-desk fuel-code trk-num nozzle-num
     1423   index si1 obj-code grp-num datetime-beg
     1424   index CashPayNname cash-pay-name
     1425   index GrpNum grp-num
     1426   index ChkTypeDesc chk-type-desc
     1427   index iuuid db-num uuid-cheq uuid
     1428   index UuidCheq db-num uuid uuid-cheq
     1429   index UuidCHKType db-num uuid chk-type-desc
     1430   index DateTimeBeg datetime-beg
     1431   index AllTimeLength2 all-time-length-2
     1432   index sort obj-code sort-date sort-time
     1433   .
     1434   define  temp-table tt-all-total-rep no-undo
     1435      field obj-type           as character
     1436      field obj-code           as integer
     1437      field qty-chk            as integer
     1438      field qty-tran           as integer
     1439      field qty-chk-fuel       as integer
     1440      field full-time-tran     as integer
     1441      field avg-time-tran      as integer
     1442      field avg-time-tran-fuel as integer
     1443   index obj obj-type obj-code
     1444   .
     1445   define  temp-table tt-total-rep no-undo like tt-all-total-rep
     1446      field obj-name           as character
     1447   index ObjName obj-type obj-code obj-name
     1448   .
     1449   define  temp-table tt-grp no-undo
     1450      field obj-type           as character
     1451      field obj-code           as integer
     1452      field obj-name           as character
     1453      field grp-num            as integer
     1454      field all-time-length    as integer
     1455      field all-time-length-2  as integer
     1456      field cash-pay-code      as integer
     1457      field cash-pay-name      as character
     1458      field resume-tran        as logical
     1459   index ObjName obj-type obj-code obj-name
     1460   index ResumeTran  resume-tran
     1461   index GrpNum grp-num
     1462   .
     1463   define  temp-table tt-grp-uuid no-undo
     1464      field grp-num            as integer
     1465      field uuid               as character
     1466    index uid uuid grp-num.
     1467   .
     1468   define  temp-table tt-grp-cheq-uuid no-undo
     1469      field grp-num            as integer
     1470      field uuid               as character
     1471    index uid uuid grp-num.
     1472   .
     1473   define  temp-table tt-pay no-undo
     1474      field seq             as integer
     1475      field volume          as decimal
     1476      field money           as decimal
     1477      field cash-pay-code   as integer
     1478      field cash-pay-name   as character
     1479      field pay-card        as character
     1480      field multi-pay       as logical
     1481     index pi seq
     1482     .
     1483   procedure CreateOneRec:
     1484      define parameter buffer obj-list  for obj-list.
     1485      define parameter buffer chk-doc   for chk-doc.
     1486      define parameter buffer tran-fuel for tran-fuel.
     1487      define parameter buffer chk-gds   for chk-gds.
     1488      define parameter buffer goods     for goods.
     1489      define buffer cash-pay    for cash-pay.
     1490      define buffer b-chk-gds   for chk-gds.
     1491      define buffer b-tran-fuel for tran-fuel.
     1492      define variable v-chk-type-desc as character no-undo.
     1493      define variable v-cash-pay-code as integer   no-undo.
     1494      define variable v-cash-pay-name as character no-undo.
     1495      define variable v-pay-card      as character no-undo.
     1496      define variable v-psn-code      as integer   no-undo.
     1497      define variable v-db-num        as integer   no-undo.
     1498      define variable vDateBeg        as datetime  no-undo.
     1499      define variable vDateEnd        as datetime  no-undo.
     1500      define variable vSeq            as integer   no-undo.
     1501      define variable vMoney          as decimal   no-undo.
     1502      define variable vVolume         as decimal   no-undo.
     1503      define variable vTotSum         as decimal   no-undo.
     1504      do:
     1505         vVolume = if can-do("6,14,16", string(chk-doc.chk-type)) then chk-gds.doc-qnty else tran-fuel.volume.
     1506         empty temp-table tt-pay.
     1507         v-chk-type-desc = entry(lookup(string(chk-doc.chk-type), "1,6,8,11,12,13,40,69,96,14,15,16,17,36,101,106,108,111,112,113,169,196,114,115,116,117,136,201,206,208,301,306,2,3,4,5,7,43,44"), "Продажа,Возврат,Аннуляция,Инвентаризация,Z-отчет,Закрытие_смены,Открытие_смены,Списание,ВзврСпис,СбросТрнзкц,Перелив,ПеревТрнзкц,ТехПролив,РазблТрнзкц,_Продажа,_Возврат,_Аннуляция,_Инвентаризация,_Z-отчет,_Закрытие_смены,_Списание,_ВзврСпис,_СбросТрнзкц,_Перелив,_ПеревТрнзкц,_ТехПролив,_РазблТрнзкц,>Продажа,>Возврат,>Аннуляция,>>Продажа,>>Возврат,Инкассация,Касс_фонд,Перевод_опл,Расход_кассы,Декл_ден_ящ,Приход_Корр,Расход_Корр").
     1508         for each chk-pay where
     1509                  chk-pay.doc-code = chk-gds.doc-code
     1510         no-lock
     1511         break
     1512            by chk-pay.doc-code
     1513            by chk-pay.tot-sum:
     1514            if first-of(chk-pay.doc-code) and last-of(chk-pay.doc-code) then
     1515               leave.
     1516            vSeq = vSeq + 1.
     1517            v-pay-card = if chk-pay.pay-card = "0" then "" else chk-pay.pay-card.
     1518            find first cash-pay where
     1519                       cash-pay.cdpay-code = chk-pay.pay-code
     1520            no-lock no-error.
     1521            if avail cash-pay then
     1522               assign
     1523                  v-cash-pay-code = chk-pay.pay-code
     1524                  v-cash-pay-name = cash-pay.obj-name
     1525                  .
     1526            else
     1527               assign
     1528                  v-cash-pay-code = 0
     1529                  v-cash-pay-name = ""
     1530                  .
     1531            vTotSum = chk-pay.tot-sum - (if last-of(chk-pay.doc-code) then
     1532                                            (chk-doc.tot-doc - chk-gds.sum-base)
     1533                                         else 0).
     1534            create tt-pay.
     1535            assign
     1536               tt-pay.seq           = vSeq
     1537               tt-pay.volume        = round(vVolume * vTotSum / chk-gds.sum-base, 2)
     1538               tt-pay.money         = vTotSum
     1539               tt-pay.cash-pay-code = v-cash-pay-code
     1540               tt-pay.cash-pay-name = v-cash-pay-name
     1541               tt-pay.pay-card      = v-pay-card
     1542               tt-pay.multi-pay     = yes
     1543               .
     1544               if tt-pay.volume = ? then
     1545                  tt-pay.volume = 0.0.
     1546         end.
     1547         find first tt-pay no-error.
     1548         if not avail tt-pay then do:
     1549            find first chk-pay where
     1550                       chk-pay.doc-code = chk-gds.doc-code
     1551            no-lock no-error.
     1552            if avail chk-pay then
     1553               assign
     1554                  v-pay-card      = if chk-pay.pay-card = "0" then "" else chk-pay.pay-card
     1555                  vMoney          = chk-gds.sum-base
     1556                  v-cash-pay-code = chk-pay.pay-code
     1557                  .
     1558            else
     1559               assign
     1560                  v-pay-card       = ""
     1561                  vMoney           = tran-fuel.money
     1562                  v-cash-pay-code  = (if chk-doc.chk-type = 8 then 0 else tran-fuel.pay-code)
     1563                  .
     1564            find first cash-pay where
     1565                       cash-pay.cdpay-code = v-cash-pay-code
     1566            no-lock no-error.
     1567            v-cash-pay-name = if avail cash-pay then cash-pay.obj-name else "".
     1568            create tt-pay.
     1569            assign
     1570               tt-pay.seq           = 1
     1571               tt-pay.volume        = vVolume
     1572               tt-pay.money         = if chk-doc.chk-type = 1 then vVolume * tran-fuel.price else vMoney
     1573               tt-pay.cash-pay-code = v-cash-pay-code
     1574               tt-pay.cash-pay-name = v-cash-pay-name
     1575               tt-pay.pay-card      = v-pay-card
     1576               .
     1577         end.
     1578         find first b-tran-fuel where
     1579                    b-tran-fuel.db-num    = tran-fuel.db-num
     1580                and b-tran-fuel.uuid      = tran-fuel.uuid
     1581                and b-tran-fuel.uuid-cheq = ""
     1582         no-lock no-error.
     1583         if avail b-tran-fuel and b-tran-fuel.date-beg < tran-fuel.date-beg then
     1584            vDateBeg = b-tran-fuel.date-beg.
     1585         else
     1586            vDateBeg = tran-fuel.date-beg.
     1587         assign
     1588            vDateBeg = vDateBeg           + timezone * 60000
     1589            vDateEnd = tran-fuel.date-end + timezone * 60000.
     1590            .
     1591         for each tt-pay:
     1592            create tt-rep.
     1593            assign
     1594               tt-rep.obj-type        = obj-list.obj-type
     1595               tt-rep.obj-code        = obj-list.obj-code
     1596               tt-rep.obj-name        = obj-list.obj-name
     1597               tt-rep.chk-date        = chk-doc.chk-date
     1598               tt-rep.chk-time        = chk-doc.chk-time
     1599               tt-rep.sort-date       = chk-doc.chk-date
     1600               tt-rep.sort-time       = chk-doc.chk-time
     1601               tt-rep.shift-date      = chk-doc.shift-date
     1602               tt-rep.shift-name      = chk-doc.shift-name + "(" + string(chk-doc.shift-num) + ")"
     1603               tt-rep.doc-code        = chk-doc.doc-code
     1604               tt-rep.chk-num         = chk-doc.chk-num
     1605               tt-rep.line-num        = chk-gds.line-num
     1606               tt-rep.doc-num2        = (if num-entries(chk-doc.doc-num2, ":") > 1 then entry(1, chk-doc.doc-num2, ":") else "")
     1607               tt-rep.z-number        = chk-doc.z-number
     1608               tt-rep.tran-num        = tran-fuel.tran-num
     1609               tt-rep.chk-type-desc   = v-chk-type-desc
     1610               tt-rep.cash-num        = tran-fuel.cash-num
     1611               tt-rep.trk-num         = tran-fuel.trk-num + 1
     1612               tt-rep.nozzle-num      = tran-fuel.nozzle-num + 1
     1613               tt-rep.fuel-code       = chk-gds.b-code
     1614               tt-rep.gds-name        = goods.gds-name
     1615               tt-rep.volume          = tt-pay.volume
     1616               tt-rep.price           = tran-fuel.price
     1617               tt-rep.money           = if tt-pay.multi-pay then tt-pay.money else tt-pay.volume * tran-fuel.price
     1618               tt-rep.cash-pay-code   = tt-pay.cash-pay-code
     1619               tt-rep.cash-pay-name   = tt-pay.cash-pay-name
     1620               tt-rep.pay-card        = tt-pay.pay-card
     1621               tt-rep.datetime-beg    = vDateBeg
     1622               tt-rep.date-beg        = date(vDateBeg)
     1623               tt-rep.time-beg        = mtime(vDateBeg) / 1000
     1624               tt-rep.datetime-end    = vDateEnd
     1625               tt-rep.date-end        = date(vDateEnd)
     1626               tt-rep.time-end        = mtime(vDateEnd) / 1000
     1627               tt-rep.time-length     = (vDateEnd - vDateBeg) / 1000
     1628               tt-rep.all-time-length = tt-rep.time-length
     1629               tt-rep.multi-pay       = tt-pay.multi-pay
     1630               tt-rep.resume-tran     = no
     1631               tt-rep.uuid            = tran-fuel.uuid
     1632               tt-rep.uuid-cheq       = tran-fuel.uuid-cheq
     1633               tt-rep.db-num          = tran-fuel.db-num
     1634               .
     1635            if chk-doc.chk-type = 16 and chk-gds.src-qnty <= 0 then do:
     1636               find first b-chk-gds where
     1637                          b-chk-gds.doc-code = chk-gds.doc-code
     1638                      and b-chk-gds.b-code   = chk-gds.b-code
     1639                      and b-chk-gds.line-num > chk-gds.line-num
     1640               no-lock no-error.
     1641               if avail b-chk-gds then
     1642                  assign
     1643                     tt-rep.volume     = b-chk-gds.doc-qnty
     1644                     .
     1645            end.
     1646   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1647   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
     1648     (input  obj-list.obj-type
     1649     ,input  obj-list.obj-code
     1650     ,output v-db-num
     1651     )  .
     1652            v-psn-code = gbclcode-is-this-db-role ('C':U,
     1653                                                   v-db-num,
     1654                                                   chk-doc.cashier,
     1655                                                   chk-doc.chk-date
     1656                                                   ).
     1657            find first clients where
     1658                       clients.obj-type = 'чел':U
     1659                   and clients.obj-code = v-psn-code
     1660            no-lock no-error.
     1661            if available clients then
     1662               tt-rep.cashier = clients.obj-name.
     1663         end.
     1664      end.
     1665   end.
     1666   procedure InitTT:
     1667      define input parameter i-tog-shift       as logical   no-undo.
     1668      define input parameter i-date-start      as date      no-undo.
     1669      define input parameter i-date-end        as date      no-undo.
     1670      define input parameter i-Shift-Start     as integer   no-undo.
     1671      define input parameter i-Shift-End       as integer   no-undo.
     1672      define input parameter iChkTypeCodeList  as character no-undo.
     1673      define input parameter iGdsCodeList      as character no-undo.
     1674      define input parameter iTRKList          as character no-undo.
     1675      define buffer chk-doc      for chk-doc.
     1676      define buffer chk-doc-attr for chk-doc-attr.
     1677      define buffer chk-gds      for chk-gds.
     1678      define buffer goods        for goods.
     1679      define buffer cash-pay     for cash-pay.
     1680      define buffer prod-bc      for prod-bc.
     1681      define buffer b-tran-fuel  for tran-fuel.
     1682      define variable v-gds-code as integer  no-undo.
     1683      define variable vDateBeg   as datetime no-undo.
     1684      define variable vDateEnd   as datetime no-undo.
     1685      define variable vCount     as integer  no-undo.
     1686      if i-tog-shift then do:
     1687         for
     1688             each obj-list,
     1689             each chk-doc where
     1690                  chk-doc.obj-type    = obj-list.obj-type
     1691              and chk-doc.obj-code    = obj-list.obj-code
     1692              and
     1693                  chk-doc.shift-date >= i-date-start
     1694              and chk-doc.shift-date <= i-date-end
     1695              and can-do(iChkTypeCodeList, string(chk-doc.chk-type))
     1696         no-lock,
     1697            first chk-doc-attr where
     1698                  chk-doc-attr.doc-code  = chk-doc.doc-code
     1699              and chk-doc-attr.attr-code = "CheckId"
     1700         no-lock,
     1701            each tran-fuel where
     1702                 tran-fuel.uuid-cheq = chk-doc-attr.attr-value
     1703             and can-do(iTRKList, string(tran-fuel.trk-num + 1))
     1704         no-lock:
     1705            v-gds-code = tran-fuel.fuel-code.
     1706            if v-gds-code < 100 then do:
     1707               find first prod-bc where
     1708                          prod-bc.b-str = string(v-gds-code)
     1709               no-lock no-error.
     1710               if avail prod-bc then do:
     1711                  find first chk-gds where
     1712                             chk-gds.doc-code = chk-doc.doc-code
     1713                         and chk-gds.b-code   = prod-bc.b-code
     1714                  no-lock no-error.
     1715                  find first goods where
     1716                             goods.gds-code = prod-bc.b-code
     1717                  no-lock no-error.
     1718                  if not avail chk-gds or not avail goods
     1719                  then
     1720                     next.
     1721                  v-gds-code = goods.gds-code.
     1722               end.
     1723               else next.
     1724            end.
     1725            else do:
     1726               find first chk-gds where
     1727                          chk-gds.doc-code = chk-doc.doc-code
     1728                      and chk-gds.b-code   = v-gds-code
     1729               no-lock no-error.
     1730               find first goods where
     1731                          goods.gds-code = v-gds-code
     1732               no-lock no-error.
     1733               if not avail chk-gds or not avail goods
     1734               then
     1735                  next.
     1736            end.
     1737            if not can-do(iGdsCodeList, string(v-gds-code)) then next.
     1738            if (chk-doc.shift-date = i-date-start and chk-doc.shift-num < i-Shift-Start) or
     1739               (chk-doc.shift-date = i-date-end   and chk-doc.shift-num > i-Shift-End)
     1740            then
     1741               next.
     1742            run CreateOneRec(buffer obj-list,
     1743                             buffer chk-doc,
     1744                             buffer tran-fuel,
     1745                             buffer chk-gds,
     1746                             buffer goods
     1747                             ).
     1748         end.
     1749      end.
     1750      else do:
     1751        TRAN-FUEL:
     1752        for each tran-fuel where
     1753                 tran-fuel.date-beg >= datetime(string(i-date-start) + " 00:00:00") - timezone * 60000
     1754             and tran-fuel.date-beg <= datetime(string(i-date-end + 2) + " 23:59:59") - timezone * 60000
     1755             and can-do(iTRKList, string(tran-fuel.trk-num + 1))
     1756        no-lock:
     1757          release chk-doc-attr.
     1758          if tran-fuel.num-cheq > 0 then do:
     1759   for first chk-doc-attr where
     1760             chk-doc-attr.attr-code  = "CheckId"
     1761         and chk-doc-attr.attr-value = tran-fuel.uuid-cheq
     1762   no-lock,
     1763       first chk-doc where
     1764             chk-doc.doc-code = chk-doc-attr.doc-code
     1765         and can-do(iChkTypeCodeList, string(chk-doc.chk-type))
     1766   no-lock
     1767   ,
     1768       first obj-list where
     1769             obj-list.obj-type = chk-doc.obj-type
     1770         and obj-list.obj-code = chk-doc.obj-code
     1771   no-lock
     1772   :
     1773     v-gds-code = tran-fuel.fuel-code.
     1774     if v-gds-code < 100 then do:
     1775       find first prod-bc where
     1776                  prod-bc.b-str = string(v-gds-code)
     1777       no-lock no-error.
     1778       if avail prod-bc then do:
     1779          find first chk-gds where
     1780                     chk-gds.doc-code = chk-doc.doc-code
     1781                 and chk-gds.b-code   = prod-bc.b-code
     1782          no-lock no-error.
     1783          find first goods where
     1784                     goods.gds-code = prod-bc.b-code
     1785          no-lock no-error.
     1786          if not avail chk-gds or not avail goods
     1787          then
     1788             next TRAN-FUEL.
     1789          v-gds-code = goods.gds-code.
     1790       end.
     1791       else next TRAN-FUEL.
     1792     end.
     1793     else do:
     1794        find first chk-gds where
     1795                   chk-gds.doc-code = chk-doc.doc-code
     1796               and chk-gds.b-code   = v-gds-code
     1797        no-lock no-error.
     1798        find first goods where
     1799                   goods.gds-code = v-gds-code
     1800        no-lock no-error.
     1801        if not avail chk-gds or not avail goods
     1802        then
     1803           next TRAN-FUEL.
     1804     end.
     1805     if not can-do(iGdsCodeList, string(v-gds-code)) then next TRAN-FUEL.
     1806       run CreateOneRec(buffer obj-list,
     1807                        buffer chk-doc,
     1808                        buffer tran-fuel,
     1809                        buffer chk-gds,
     1810                        buffer goods
     1811                        ).
     1812   end.
     1813          end.
     1814          if not available chk-doc-attr then do:
     1815   for first obj-list where
     1816             obj-list.obj-type = 'маг':U
     1817         and obj-list.obj-code = tran-fuel.obj-code
     1818   no-lock:
     1819     for first b-tran-fuel where
     1820               b-tran-fuel.db-num    =  tran-fuel.db-num
     1821           and b-tran-fuel.uuid      =  tran-fuel.uuid
     1822           and b-tran-fuel.uuid-cheq <> tran-fuel.uuid-cheq
     1823     no-lock,
     1824         first chk-doc-attr where
     1825               chk-doc-attr.attr-code  = "CheckId"
     1826           and chk-doc-attr.attr-value = b-tran-fuel.uuid-cheq
     1827     no-lock,
     1828         first chk-doc where
     1829               chk-doc.doc-code = chk-doc-attr.doc-code
     1830           and chk-doc.chk-type = 17
     1831     no-lock:
     1832        next TRAN-FUEL.
     1833     end.
     1834     v-gds-code = tran-fuel.fuel-code.
     1835     if v-gds-code < 100 then do:
     1836       find first prod-bc where
     1837                  prod-bc.b-str = string(v-gds-code)
     1838       no-lock no-error.
     1839       if avail prod-bc then do:
     1840          find first goods where
     1841                     goods.gds-code = prod-bc.b-code
     1842          no-lock no-error.
     1843          if not avail goods then
     1844             next TRAN-FUEL.
     1845          v-gds-code = goods.gds-code.
     1846       end.
     1847     end.
     1848     else do:
     1849        find first goods where
     1850                   goods.gds-code = v-gds-code
     1851        no-lock no-error.
     1852        if not avail goods
     1853        then
     1854           next TRAN-FUEL.
     1855     end.
     1856     if not can-do(iGdsCodeList, string(v-gds-code)) then next TRAN-FUEL.
     1857     assign
     1858       vDateBeg = tran-fuel.date-beg + timezone * 60000
     1859       vDateEnd = tran-fuel.date-end + timezone * 60000
     1860     .
     1861     create tt-rep.
     1862     assign
     1863       tt-rep.obj-type        = obj-list.obj-type
     1864       tt-rep.obj-code        = obj-list.obj-code
     1865       tt-rep.obj-name        = obj-list.obj-name
     1866       tt-rep.sort-date       = date(vDateBeg)
     1867       tt-rep.sort-time       = mtime(vDateBeg) / 1000
     1868       tt-rep.chk-num         = tran-fuel.num-cheq
     1869       tt-rep.tran-num        = tran-fuel.tran-num
     1870       tt-rep.cash-num        = tran-fuel.cash-num
     1871       tt-rep.trk-num         = tran-fuel.trk-num + 1
     1872       tt-rep.nozzle-num      = tran-fuel.nozzle-num + 1
     1873       tt-rep.fuel-code       = goods.gds-code
     1874       tt-rep.gds-name        = goods.gds-name
     1875       tt-rep.volume          = tran-fuel.volume
     1876       tt-rep.price           = tran-fuel.price
     1877       tt-rep.money           = tran-fuel.money
     1878       tt-rep.datetime-beg    = vDateBeg
     1879       tt-rep.date-beg        = date(vDateBeg)
     1880       tt-rep.time-beg        = mtime(vDateBeg) / 1000
     1881       tt-rep.datetime-end    = vDateEnd
     1882       tt-rep.date-end        = date(vDateEnd)
     1883       tt-rep.time-end        = mtime(vDateEnd) / 1000
     1884       tt-rep.time-length     = (vDateEnd - vDateBeg) / 1000
     1885       tt-rep.all-time-length = tt-rep.time-length
     1886       tt-rep.multi-pay       = no
     1887       tt-rep.resume-tran     = no
     1888       tt-rep.uuid            = tran-fuel.uuid
     1889       tt-rep.uuid-cheq       = tran-fuel.uuid-cheq
     1890       tt-rep.db-num          = tran-fuel.db-num
     1891     .
     1892     if tt-rep.uuid-cheq = "" then do:
     1893        vCount = vCount + 1.
     1894        tt-rep.uuid-cheq = "empty-" + string(vCount, "99999999").
     1895     end.
     1896   end.
     1897          end.
     1898        end.
     1899      end.
     1900      release tt-rep.
     1901   end.
     1902   procedure AfterCalc:
     1903      define input parameter i-tog-shift  as logical   no-undo.
     1904      define input parameter i-date-end   as date      no-undo.
     1905      define input parameter iTRKList     as character no-undo.
     1906      define input parameter iCashPayList as character no-undo.
     1907      define input parameter iTranTimeMax as integer   no-undo.
     1908      define buffer b-chk-gds    for chk-gds.
     1909      define buffer b-tt-rep     for tt-rep.
     1910      define buffer b2-tt-rep    for tt-rep.
     1911      define variable vI                   as integer   no-undo.
     1912      define variable vCheck               as logical   no-undo.
     1913      define variable vCheckResumeTran     as logical   no-undo.
     1914      define variable v-all-time-length    as integer   no-undo.
     1915      define variable v-count-grp-num      as integer   no-undo.
     1916      define variable v-prev-datetime-end  as datetime  no-undo.
     1917      define variable v-first-datetime-beg as datetime  no-undo.
     1918      define variable vResumeTran          as logical   no-undo.
     1919      define variable vUuidCheq            as character no-undo.
     1920      define variable vFirstRecId          as recid     no-undo.
     1921      define variable vConfirmResumeTran   as logical   no-undo.
     1922      define variable vRecId               as recid     no-undo.
     1923      define variable vRowId               as rowid     no-undo.
     1924      define variable vRowIdList           as character no-undo.
     1925      define variable v-gds-code           as integer   no-undo.
     1926      define variable vTrkNum              as integer   no-undo.
     1927      for each  tt-grp:
     1928         delete tt-grp.
     1929      end.
     1930      for each  tt-grp-uuid:
     1931         delete tt-grp-uuid.
     1932      end.
     1933      for each  tt-grp-cheq-uuid:
     1934         delete tt-grp-cheq-uuid.
     1935      end.
     1936      for each tt-rep where
     1937               not can-do(iTRKList, string(tt-rep.trk-num)):
     1938         delete tt-rep.
     1939      end.
     1940      for each tt-rep where
     1941               tt-rep.cash-pay-name = "":
     1942         find first tran-fuel where
     1943                    tran-fuel.db-num   = tt-rep.db-num
     1944                and tran-fuel.tran-num = tt-rep.tran-num
     1945                and tran-fuel.num-cheq = integer(tt-rep.doc-num2)
     1946         no-lock no-error.
     1947         if avail tran-fuel then do:
     1948            for first chk-doc-attr where
     1949                      chk-doc-attr.attr-code  = "CheckId"
     1950                  and chk-doc-attr.attr-value = tran-fuel.uuid-cheq
     1951            no-lock,
     1952                first chk-doc where
     1953                      chk-doc.doc-code = chk-doc-attr.doc-code
     1954            no-lock
     1955                  ,
     1956                first obj-list where
     1957                      obj-list.obj-type = chk-doc.obj-type
     1958                  and obj-list.obj-code = chk-doc.obj-code
     1959            no-lock
     1960                  :
     1961               v-gds-code = tran-fuel.fuel-code.
     1962               if v-gds-code < 100 then do:
     1963                  find first prod-bc where
     1964                             prod-bc.b-str = string(tran-fuel.fuel-code)
     1965                  no-lock no-error.
     1966                  if avail prod-bc then do:
     1967                     find first chk-gds where
     1968                                chk-gds.doc-code = chk-doc.doc-code
     1969                            and chk-gds.b-code   = prod-bc.b-code
     1970                     no-lock no-error.
     1971                     find first goods where
     1972                                goods.gds-code = prod-bc.b-code
     1973                     no-lock no-error.
     1974                     if not avail chk-gds or not avail goods
     1975                     then
     1976                        next.
     1977                     v-gds-code = goods.gds-code.
     1978                  end.
     1979               end.
     1980               else do:
     1981                  find first chk-gds where
     1982                             chk-gds.doc-code = chk-doc.doc-code
     1983                         and chk-gds.b-code   = v-gds-code
     1984                  no-lock no-error.
     1985                  find first goods where
     1986                             goods.gds-code = v-gds-code
     1987                  no-lock no-error.
     1988                  if not avail chk-gds or not avail goods
     1989                  then
     1990                     next.
     1991               end.
     1992               find first chk-pay where
     1993                          chk-pay.doc-code = chk-gds.doc-code
     1994               no-lock no-error.
     1995               if avail chk-pay then do:
     1996                  find first cash-pay where
     1997                             cash-pay.cdpay-code = chk-pay.pay-code
     1998                  no-lock no-error.
     1999                  if avail cash-pay then
     2000                     assign
     2001                        tt-rep.cash-pay-code = chk-pay.pay-code
     2002                        tt-rep.cash-pay-name = cash-pay.obj-name.
     2003               end.
     2004            end.
     2005         end.
     2006      end.
     2007      v-count-grp-num = 0.
     2008      for each tt-rep
     2009         by tt-rep.obj-code
     2010         by tt-rep.sort-date
     2011         by tt-rep.sort-time:
     2012         block-grp-uuid:
     2013         for each tt-grp-uuid where  tt-grp-uuid.uuid     = tt-rep.uuid
     2014         no-lock:
     2015            for each tt-grp where
     2016                       tt-grp.obj-type = tt-rep.obj-type
     2017                   and tt-grp.obj-code = tt-rep.obj-code
     2018                   and tt-grp.obj-name = tt-rep.obj-name
     2019                   and tt-grp.grp-num  = tt-grp-uuid.grp-num
     2020                   :
     2021                   find first tt-grp-cheq-uuid where tt-grp-cheq-uuid.grp-num = tt-grp.grp-num
     2022                                                 and tt-grp-cheq-uuid.uuid     = tt-rep.uuid-cheq
     2023                   no-error.
     2024                   leave block-grp-uuid.
     2025                end.
     2026         end.
     2027         if not available tt-grp
     2028         then do:
     2029            block-grp-cheq:
     2030            for each tt-grp-cheq-uuid where  tt-grp-cheq-uuid.uuid     = tt-rep.uuid-cheq
     2031            no-lock:
     2032               for each tt-grp where
     2033                          tt-grp.obj-type = tt-rep.obj-type
     2034                      and tt-grp.obj-code = tt-rep.obj-code
     2035                      and tt-grp.obj-name = tt-rep.obj-name
     2036                      and tt-grp.grp-num  = tt-grp-cheq-uuid.grp-num
     2037                      :
     2038                      find first tt-grp-uuid where tt-grp-uuid.grp-num = tt-grp.grp-num
     2039                                               and tt-grp-uuid.uuid     = tt-rep.uuid
     2040                      no-error.
     2041                      leave block-grp-cheq.
     2042               end.
     2043            end.
     2044         end.
     2045         if     not avail tt-grp
     2046         then do:
     2047            v-count-grp-num = v-count-grp-num + 1.
     2048            create tt-grp.
     2049            assign
     2050               tt-grp.obj-type = tt-rep.obj-type
     2051               tt-grp.obj-code = tt-rep.obj-code
     2052               tt-grp.obj-name = tt-rep.obj-name
     2053               tt-grp.grp-num  = v-count-grp-num
     2054               .
     2055         end.
     2056         if not available tt-grp-cheq-uuid
     2057         then do:
     2058            create tt-grp-cheq-uuid.
     2059            assign
     2060               tt-grp-cheq-uuid.grp-num  = tt-grp.grp-num
     2061               tt-grp-cheq-uuid.uuid     = tt-rep.uuid-cheq
     2062            .
     2063         end.
     2064         if not available tt-grp-uuid
     2065         then do:
     2066            create tt-grp-uuid.
     2067            assign
     2068               tt-grp-uuid.grp-num = tt-grp.grp-num
     2069               tt-grp-uuid.uuid     = tt-rep.uuid
     2070            .
     2071         end.
     2072         tt-rep.grp-num = tt-grp.grp-num.
     2073         if tt-grp.cash-pay-name = "" then
     2074            assign
     2075               tt-grp.cash-pay-code = tt-rep.cash-pay-code
     2076               tt-grp.cash-pay-name = tt-rep.cash-pay-name
     2077               .
     2078         release tt-grp.
     2079      end.
     2080      for each tt-rep
     2081      break
     2082         by tt-rep.obj-code
     2083         by tt-rep.grp-num
     2084         by tt-rep.sort-date
     2085         by tt-rep.sort-time
     2086         by tt-rep.datetime-beg:
     2087         if first-of(tt-rep.grp-num) then do:
     2088            assign
     2089               vUuidCheq          = ""
     2090               vResumeTran        = no
     2091               vConfirmResumeTran = no
     2092               .
     2093            if tt-rep.chk-type-desc = "Продажа" then
     2094               assign
     2095                  vUuidCheq   = tt-rep.uuid-cheq
     2096                  vResumeTran = yes
     2097                  vTrkNum     = tt-rep.trk-num
     2098                  .
     2099            find first b-tt-rep where recid(b-tt-rep) = vFirstRecId no-error.
     2100         end.
     2101         else do:
     2102            if tt-rep.chk-type-desc = "Продажа" and
     2103               tt-rep.uuid-cheq     = vUuidCheq and
     2104               tt-rep.multi-pay     = no        and
     2105               vResumeTran          = yes
     2106            then
     2107               assign
     2108                  tt-rep.resume-tran = yes
     2109                  vConfirmResumeTran = yes
     2110                  .
     2111            else
     2112               if tt-rep.chk-type-desc = "Продажа" and
     2113                  tt-rep.uuid-cheq     = vUuidCheq and
     2114                  tt-rep.multi-pay     = no
     2115               then
     2116                  assign
     2117                     vResumeTran = yes
     2118                     vTrkNum     = tt-rep.trk-num
     2119                  .
     2120               else
     2121                  vResumeTran = no.
     2122            for first b-tt-rep where
     2123                      b-tt-rep.db-num   = tt-rep.db-num
     2124                  and b-tt-rep.uuid     = tt-rep.uuid
     2125                  and b-tt-rep.chk-num = 0:
     2126              assign
     2127                tt-rep.resume-tran = yes
     2128                vConfirmResumeTran = yes
     2129              .
     2130              for first tt-grp-uuid where
     2131                        tt-grp-uuid.uuid = b-tt-rep.uuid:
     2132                 delete tt-grp-uuid.
     2133              end.
     2134              delete b-tt-rep.
     2135            end.
     2136         end.
     2137         if last-of(tt-rep.grp-num) and not first-of(tt-rep.grp-num) and vConfirmResumeTran then do:
     2138            for first tt-grp where tt-grp.grp-num = tt-rep.grp-num:
     2139               tt-grp.resume-tran = yes.
     2140            end.
     2141         end.
     2142      end.
     2143      for each tt-grp where
     2144               tt-grp.resume-tran = yes:
     2145         for each tt-rep where
     2146                  tt-rep.grp-num = tt-grp.grp-num
     2147         break
     2148            by tt-rep.obj-code
     2149            by tt-rep.grp-num
     2150            by tt-rep.datetime-beg
     2151            by tt-rep.sort-date
     2152            by tt-rep.sort-time:
     2153            if not first-of(tt-rep.grp-num) and tt-rep.chk-type-desc = "Продажа" then do:
     2154               find first b-tt-rep where
     2155                          recid(b-tt-rep)        = vRecId
     2156                      and b-tt-rep.chk-type-desc = "Продажа"
     2157               no-error.
     2158               if avail b-tt-rep then do:
     2159                  assign
     2160                     b-tt-rep.datetime-end    = tt-rep.datetime-beg
     2161                     b-tt-rep.date-end        = tt-rep.date-beg
     2162                     b-tt-rep.time-end        = tt-rep.time-beg
     2163                     b-tt-rep.time-length     = (b-tt-rep.datetime-end - b-tt-rep.datetime-beg) / 1000
     2164                     .
     2165               end.
     2166            end.
     2167            vRecId = recid(tt-rep).
     2168         end.
     2169      end.
     2170      repeat preselect each tt-rep where
     2171                            tt-rep.chk-type-desc = "ПеревТрнзкц":
     2172         find next tt-rep.
     2173         find first b-chk-gds where
     2174                    b-chk-gds.doc-code =  tt-rep.doc-code
     2175                and b-chk-gds.line-num <> chk-gds.line-num
     2176         no-lock no-error.
     2177         if avail b-chk-gds then do:
     2178            find first b-tt-rep where
     2179                       b-tt-rep.db-num    =  tt-rep.db-num
     2180                   and b-tt-rep.uuid      =  tt-rep.uuid
     2181                   and b-tt-rep.uuid-cheq <> tt-rep.uuid-cheq
     2182            no-error.
     2183            if avail b-tt-rep then do:
     2184               find first b2-tt-rep where
     2185                          b2-tt-rep.db-num    =  B-tt-rep.db-num
     2186                      and b2-tt-rep.uuid-cheq =  b-tt-rep.uuid-cheq
     2187                      and b2-tt-rep.uuid      <> b-tt-rep.uuid
     2188               no-lock no-error.
     2189               if avail b2-tt-rep then do:
     2190                  create b-tt-rep.
     2191                  buffer-copy b2-tt-rep to b-tt-rep
     2192                     assign
     2193                        b-tt-rep.chk-date        = tt-rep.chk-date
     2194                        b-tt-rep.chk-time        = tt-rep.chk-time
     2195                        b-tt-rep.sort-date       = tt-rep.sort-date
     2196                        b-tt-rep.sort-time       = tt-rep.sort-time
     2197                        b-tt-rep.doc-code        = tt-rep.doc-code
     2198                        b-tt-rep.chk-num         = tt-rep.chk-num
     2199                        b-tt-rep.line-num        = b-chk-gds.line-num
     2200                        b-tt-rep.doc-num2        = tt-rep.doc-num2
     2201                        b-tt-rep.z-number        = tt-rep.z-number
     2202                        b-tt-rep.chk-type-desc   = tt-rep.chk-type-desc
     2203                        b-tt-rep.resume-tran     = no
     2204                        b-tt-rep.uuid-cheq       = tt-rep.uuid-cheq
     2205                        .
     2206               end.
     2207            end.
     2208         end.
     2209      end.
     2210      for each tt-grp:
     2211         for each tt-rep where
     2212                  tt-rep.grp-num = tt-grp.grp-num
     2213         break
     2214            by tt-rep.obj-code
     2215            by tt-rep.grp-num
     2216            by tt-rep.datetime-beg
     2217            by tt-rep.sort-date
     2218            by tt-rep.sort-time:
     2219            if not first-of(tt-rep.grp-num) and tt-rep.chk-type-desc = "ПеревТрнзкц" then do:
     2220               find first b-tt-rep where
     2221                          recid(b-tt-rep)        = vRecId
     2222                      and b-tt-rep.chk-type-desc = "Продажа"
     2223               no-error.
     2224               if avail b-tt-rep then do:
     2225                  assign
     2226                     b-tt-rep.datetime-end    = tt-rep.datetime-end
     2227                     b-tt-rep.date-end        = tt-rep.date-end
     2228                     b-tt-rep.time-end        = tt-rep.time-end
     2229                     b-tt-rep.time-length     = (b-tt-rep.datetime-end - b-tt-rep.datetime-beg) / 1000
     2230                     .
     2231               end.
     2232            end.
     2233            vRecId = recid(tt-rep).
     2234         end.
     2235      end.
     2236      for each tt-rep where
     2237               tt-rep.chk-type-desc = "Возврат":
     2238         find last b-tt-rep where
     2239                   b-tt-rep.DB-NUM        = tt-rep.db-num
     2240               and b-tt-rep.uuid          = tt-rep.uuid
     2241               and b-tt-rep.chk-type-desc = "Продажа"
     2242         no-error.
     2243         if avail b-tt-rep then do:
     2244            assign
     2245               tt-rep.datetime-beg = b-tt-rep.datetime-beg
     2246               tt-rep.date-beg     = b-tt-rep.date-beg
     2247               tt-rep.time-beg     = b-tt-rep.time-beg
     2248               tt-rep.time-length  = (tt-rep.datetime-end - tt-rep.datetime-beg) / 1000
     2249               .
     2250         end.
     2251      end.
     2252      for each tt-rep where
     2253               tt-rep.chk-type-desc = "СбросТрнзкц":
     2254         find last b-tt-rep where
     2255                   b-tt-rep.DB-NUM        = tt-rep.db-num
     2256               and b-tt-rep.uuid          = tt-rep.uuid
     2257               and b-tt-rep.chk-type-desc = "Продажа"
     2258         no-error.
     2259         if avail b-tt-rep then do:
     2260            assign
     2261               tt-rep.datetime-beg = b-tt-rep.datetime-beg
     2262               tt-rep.date-beg     = b-tt-rep.date-beg
     2263               tt-rep.time-beg     = b-tt-rep.time-beg
     2264               tt-rep.time-length  = (tt-rep.datetime-end - tt-rep.datetime-beg) / 1000
     2265               .
     2266         end.
     2267      end.
     2268      for each tt-rep where
     2269               tt-rep.chk-type-desc = "ПеревТрнзкц":
     2270         find first b-tt-rep where
     2271                    b-tt-rep.DB-NUM        = tt-rep.db-num
     2272                and b-tt-rep.uuid          = tt-rep.uuid
     2273                and b-tt-rep.chk-type-desc = "Продажа"
     2274         no-error.
     2275         if avail b-tt-rep then do:
     2276            assign
     2277               tt-rep.datetime-beg = b-tt-rep.datetime-beg
     2278               tt-rep.date-beg     = b-tt-rep.date-beg
     2279               tt-rep.time-beg     = b-tt-rep.time-beg
     2280               tt-rep.time-length  = (tt-rep.datetime-end - tt-rep.datetime-beg) / 1000
     2281               .
     2282         end.
     2283      end.
     2284      for each tt-rep where
     2285               tt-rep.chk-type-desc = "ТехПролив":
     2286         find first tran-fuel where
     2287                    tran-fuel.db-num    =  tt-rep.db-num
     2288                and tran-fuel.uuid      =  tt-rep.uuid
     2289                and tran-fuel.uuid-cheq <> tt-rep.uuid-cheq
     2290         no-lock no-error.
     2291         if avail tran-fuel then do:
     2292            assign
     2293               tt-rep.datetime-beg = tran-fuel.date-beg + timezone * 60000
     2294               tt-rep.date-beg     = date(tt-rep.datetime-beg)
     2295               tt-rep.time-beg     = mtime(tt-rep.datetime-beg) / 1000
     2296               tt-rep.time-length  = (tt-rep.datetime-end - tt-rep.datetime-beg) / 1000
     2297               .
     2298         end.
     2299      end.
     2300      for each tt-rep
     2301      break
     2302         by tt-rep.obj-code
     2303         by tt-rep.grp-num
     2304         by tt-rep.datetime-beg
     2305         by tt-rep.sort-date
     2306         by tt-rep.sort-time:
     2307         if first-of(tt-rep.grp-num) then do:
     2308            vRowId = ?.
     2309         end.
     2310         if can-do("Возврат,СбросТрнзкц", tt-rep.chk-type-desc) and vRowId <> ? then do:
     2311            for first b-tt-rep where rowid(b-tt-rep) = vRowId:
     2312               assign
     2313                  b-tt-rep.datetime-end    = tt-rep.datetime-end
     2314                  b-tt-rep.date-end        = tt-rep.date-end
     2315                  b-tt-rep.time-end        = tt-rep.time-end
     2316                  b-tt-rep.time-length     = (b-tt-rep.datetime-end - b-tt-rep.datetime-beg) / 1000
     2317                  .
     2318            end.
     2319         end.
     2320         vRowId = rowid(tt-rep).
     2321      end.
     2322      for each tt-rep
     2323      break
     2324         by tt-rep.obj-code
     2325         by tt-rep.grp-num
     2326         by tt-rep.datetime-beg
     2327         by tt-rep.sort-date
     2328         by tt-rep.sort-time:
     2329         if first-of(tt-rep.grp-num) then do:
     2330            vRowIdList = "".
     2331         end.
     2332         if tt-rep.chk-type-desc = "Аннуляция" then
     2333            vRowIdList = vRowIdList + (if vRowIdList > "" then "," else "") + string(rowid(tt-rep)).
     2334         else if tt-rep.chk-type-desc = "Продажа" then do:
     2335            do vI = 1 to num-entries(vRowIdList):
     2336               vRowId = to-rowid(entry(vI, vRowIdList)).
     2337               for first b-tt-rep where rowid(b-tt-rep) = vRowId:
     2338                  assign
     2339                     b-tt-rep.datetime-end    = tt-rep.datetime-end
     2340                     b-tt-rep.date-end        = tt-rep.date-end
     2341                     b-tt-rep.time-end        = tt-rep.time-end
     2342                     b-tt-rep.time-length     = (b-tt-rep.datetime-end - b-tt-rep.datetime-beg) / 1000
     2343                     .
     2344               end.
     2345            end.
     2346            vRowIdList = "".
     2347         end.
     2348      end.
     2349      for each tt-rep
     2350      break
     2351         by tt-rep.obj-code
     2352         by tt-rep.grp-num
     2353         by tt-rep.sort-date
     2354         by tt-rep.sort-time
     2355         by tt-rep.datetime-beg:
     2356         if first-of(tt-rep.grp-num) then do:
     2357            vI = 0.
     2358            find first b-tt-rep where
     2359                       rowid(b-tt-rep) = rowid(tt-rep).
     2360         end.
     2361         vI = vI + 1.
     2362         if last-of(tt-rep.grp-num) and vI = 2 then do:
     2363            if b-tt-rep.chk-type-desc  = "Продажа"           and
     2364               b-tt-rep.uuid           = tt-rep.uuid         and
     2365               tt-rep.uuid-cheq        begins "empty-"       and
     2366               b-tt-rep.trk-num        = tt-rep.trk-num      and
     2367               b-tt-rep.nozzle-num     = tt-rep.nozzle-num   and
     2368               b-tt-rep.fuel-code      = tt-rep.fuel-code    and
     2369               b-tt-rep.volume         = tt-rep.volume       and
     2370               b-tt-rep.datetime-beg  <= tt-rep.datetime-beg
     2371            then
     2372               tt-rep.chk-type-desc = "Перелив".
     2373         end.
     2374      end.
     2375      for each tt-rep where
     2376               not can-do(iCashPayList, string(tt-rep.cash-pay-code)):
     2377         delete tt-rep.
     2378      end.
     2379      if i-tog-shift = no then do:
     2380         for each tt-rep where
     2381                  tt-rep.datetime-beg > datetime(string(i-date-end) + " 23:59:59"):
     2382            delete tt-rep.
     2383         end.
     2384      end.
     2385      for each tt-rep
     2386      break
     2387         by tt-rep.obj-code
     2388         by tt-rep.grp-num
     2389         by tt-rep.datetime-beg
     2390         by tt-rep.sort-date
     2391         by tt-rep.sort-time:
     2392         if first-of(tt-rep.grp-num) then do:
     2393            assign
     2394               v-all-time-length    = 0
     2395               v-prev-datetime-end  = datetime("01/01/1990 00:00:00")
     2396               v-first-datetime-beg = tt-rep.datetime-beg
     2397               .
     2398         end.
     2399         if tt-rep.datetime-end > v-prev-datetime-end then
     2400            v-all-time-length = v-all-time-length + (tt-rep.datetime-end - max(tt-rep.datetime-beg, v-prev-datetime-end)) / 1000.
     2401         v-prev-datetime-end = max(tt-rep.datetime-end, v-prev-datetime-end).
     2402         if last-of(tt-rep.grp-num) then do:
     2403            find first tt-grp where
     2404                       tt-grp.grp-num = tt-rep.grp-num
     2405            no-error.
     2406            if avail tt-grp then
     2407               assign
     2408                  tt-grp.all-time-length   = v-all-time-length
     2409                  tt-grp.all-time-length-2 = (tt-rep.datetime-end - v-first-datetime-beg) / 1000
     2410                  .
     2411         end.
     2412      end.
     2413      for each tt-rep:
     2414         find first tt-grp where
     2415                    tt-grp.grp-num = tt-rep.grp-num
     2416         no-error.
     2417         if avail tt-grp then do:
     2418            assign
     2419               tt-rep.all-time-length   = tt-grp.all-time-length
     2420               tt-rep.all-time-length-2 = tt-grp.all-time-length-2
     2421               .
     2422         end.
     2423      end.
     2424      for each tt-rep where
     2425               tt-rep.all-time-length-2 < iTranTimeMax * 60:
     2426         delete tt-rep.
     2427      end.
     2428      for each tt-grp-uuid:
     2429         delete tt-grp-uuid.
     2430      end.
     2431      for each tt-rep
     2432      break
     2433         by tt-rep.obj-type
     2434         by tt-rep.obj-code
     2435         by tt-rep.sort-date
     2436         by tt-rep.sort-time
     2437         by tt-rep.uuid-cheq
     2438         by tt-rep.datetime-beg:
     2439         if first-of(tt-rep.obj-code) then do:
     2440            create tt-total-rep.
     2441            assign
     2442               tt-total-rep.obj-type = tt-rep.obj-type
     2443               tt-total-rep.obj-code = tt-rep.obj-code
     2444               tt-total-rep.obj-name = tt-rep.obj-name
     2445               .
     2446         end.
     2447         if first-of(tt-rep.uuid-cheq) then do:
     2448            vCheck = no.
     2449            tt-total-rep.qty-chk = tt-total-rep.qty-chk + 1.
     2450         end.
     2451         find first tt-grp-uuid where tt-grp-uuid.grp-num = 0
     2452                                  and tt-grp-uuid.uuid     = tt-rep.uuid
     2453         no-error.
     2454         if not available tt-grp-uuid
     2455         then do:
     2456            vCheck = yes.
     2457            create tt-grp-uuid.
     2458            assign
     2459               tt-grp-uuid.grp-num = 0
     2460               tt-grp-uuid.uuid     = tt-rep.uuid
     2461            .
     2462         end.
     2463         if last-of(tt-rep.uuid-cheq) then do:
     2464            if vCheck then
     2465               tt-total-rep.qty-chk-fuel = tt-total-rep.qty-chk-fuel + 1.
     2466         end.
     2467      end.
     2468      release tt-total-rep.
     2469      for each tt-rep,
     2470         first tt-total-rep where
     2471               tt-total-rep.obj-type = tt-rep.obj-type
     2472           and tt-total-rep.obj-code = tt-rep.obj-code
     2473           and tt-total-rep.obj-name = tt-rep.obj-name
     2474      break
     2475         by tt-rep.obj-type
     2476         by tt-rep.obj-code
     2477         by tt-rep.obj-name
     2478         by tt-rep.tran-num:
     2479         if first-of(tt-rep.tran-num) then do:
     2480            tt-total-rep.qty-tran       = tt-total-rep.qty-tran + 1.
     2481            tt-total-rep.full-time-tran = tt-total-rep.full-time-tran + tt-rep.time-length.
     2482         end.
     2483      end.
     2484      for each tt-total-rep:
     2485         tt-total-rep.avg-time-tran      = tt-total-rep.full-time-tran / tt-total-rep.qty-tran.
     2486         tt-total-rep.avg-time-tran-fuel = tt-total-rep.full-time-tran / tt-total-rep.qty-chk-fuel.
     2487      end.
     2488      for each tt-grp-uuid:
     2489         delete tt-grp-uuid.
     2490      end.
     2491      for each tt-rep
     2492      break
     2493         by tt-rep.obj-type
     2494         by tt-rep.obj-code
     2495         by tt-rep.sort-date
     2496         by tt-rep.sort-time
     2497         by tt-rep.uuid-cheq
     2498         by tt-rep.datetime-beg:
     2499         if first-of(tt-rep.obj-code) then do:
     2500            create tt-all-total-rep.
     2501            assign
     2502               tt-all-total-rep.obj-type = tt-rep.obj-type
     2503               tt-all-total-rep.obj-code = tt-rep.obj-code
     2504               .
     2505         end.
     2506         if first-of(tt-rep.uuid-cheq) then do:
     2507            vCheck = no.
     2508            tt-all-total-rep.qty-chk = tt-all-total-rep.qty-chk + 1.
     2509         end.
     2510         find first tt-grp-uuid where tt-grp-uuid.grp-num = 0
     2511                                  and tt-grp-uuid.uuid     = tt-rep.uuid
     2512         no-error.
     2513         if not available tt-grp-uuid
     2514         then do:
     2515            vCheck = yes.
     2516            create tt-grp-uuid.
     2517            assign
     2518               tt-grp-uuid.grp-num = 0
     2519               tt-grp-uuid.uuid     = tt-rep.uuid
     2520            .
     2521         end.
     2522         if last-of(tt-rep.uuid-cheq) then do:
     2523            if vCheck then
     2524               tt-all-total-rep.qty-chk-fuel = tt-all-total-rep.qty-chk-fuel + 1.
     2525         end.
     2526      end.
     2527      release tt-all-total-rep.
     2528      for each tt-rep,
     2529         first tt-all-total-rep where
     2530               tt-all-total-rep.obj-type = tt-rep.obj-type
     2531           and tt-all-total-rep.obj-code = tt-rep.obj-code
     2532      break
     2533         by tt-rep.obj-type
     2534         by tt-rep.obj-code
     2535         by tt-rep.tran-num:
     2536         if first-of(tt-rep.tran-num) then do:
     2537            tt-all-total-rep.qty-tran       = tt-all-total-rep.qty-tran + 1.
     2538            tt-all-total-rep.full-time-tran = tt-all-total-rep.full-time-tran + tt-rep.time-length.
     2539         end.
     2540      end.
     2541      for each tt-all-total-rep:
     2542         tt-all-total-rep.avg-time-tran      = tt-all-total-rep.full-time-tran / tt-all-total-rep.qty-tran.
     2543         tt-all-total-rep.avg-time-tran-fuel = tt-all-total-rep.full-time-tran / tt-all-total-rep.qty-chk-fuel.
     2544      end.
     2545   end.
     2546   define stream sOutStr-html.
     2547   function f_disp_time returns character
     2548      (input iTime as integer):
     2549      define variable vHour    as integer   no-undo.
     2550      define variable vMinute  as integer   no-undo.
     2551      define variable vSec     as integer   no-undo.
     2552      define variable vTimeStr as character no-undo.
     2553      if iTime < 0 then return "".
     2554      vHour = truncate(iTime / 3600, 0).
     2555      vMinute = truncate((iTime - vHour * 3600) / 60, 0).
     2556      vSec = iTime - vHour * 3600 - vMinute * 60.
     2557      vTimeStr = trim(string(vHour, ">>>99")) + ":" +
     2558                 string(vMinute, "99")  + ":" +
     2559                 string(vSec,    "99").
     2560      return vTimeStr.
     2561   end function.
     2562   function fDate2Str returns character
     2563      (input idate as date,
     2564       input iformat as char):
     2565      define variable vdatestr as character no-undo.
     2566      if idate = ? then
     2567         vdatestr = "".
     2568      else
     2569         vdatestr = trim(string(idate, iformat)).
     2570      return vdatestr.
     2571   end function.
     2572   function fDec2Str returns character
     2573      (input idec as decimal,
     2574       input iformat as char):
     2575      define variable vdecstr as character no-undo.
     2576      if idec = ? then
     2577         vdecstr = "".
     2578      else
     2579         vdecstr = trim(string(idec, iformat)).
     2580      return vdecstr.
     2581   end function.
     2582   function fInt2Str returns character
     2583      (input iInt as integer,
     2584       input iformat as char):
     2585      define variable vIntStr as character no-undo.
     2586      if iInt = ? then
     2587         vIntStr = "".
     2588      else
     2589         vIntStr = trim(string(iInt, iformat)).
     2590      return vIntStr.
     2591   end function.
     2592   function fStrNvl returns character
     2593      (input iStr     as character,
     2594       input iDefault as character):
     2595      return if iStr > "" then iStr else iDefault.
     2596   end function.
     2597   run BeforeCalc.
     2598   run initTT(x-tog-shift,
     2599              X-date-start,
     2600              X-date-end,
     2601              X-Shift-Start,
     2602              X-Shift-End,
     2603              iChkTypeCodeList,
     2604              iGdsCodeList,
     2605              iTRKList).
     2606   run AfterCalc(x-tog-shift,
     2607                 X-date-end,
     2608                 iTRKList,
     2609                 iCashPayList,
     2610                 iTranTimeMax).
     2611   run PrintTT.
     2612   procedure BeforeCalc:
     2613      define variable vI       as integer   no-undo.
     2614      define variable vJ       as integer   no-undo.
     2615      define variable vStr     as character no-undo.
     2616      define variable vChkCode as character no-undo.
     2617      if x-tog-shift then do:
     2618         vI = vI + 1.
     2619         if X-shift-start = X-shift-end then
     2620            mParamStr[vI] = "Смена: " + string(X-shift-start).
     2621         else
     2622            mParamStr[vI] = "Смены: c " + string(X-shift-start) + " по " + string(X-shift-end).
     2623      end.
     2624      vI = vI + 1.
     2625      if X-date-start = X-date-end then
     2626         mParamStr[vI] = "За дату : " + string(X-date-start, "99.99.9999").
     2627      else
     2628         mParamStr[vI] = "За период c " + string(X-date-start, "99.99.9999") + " по " + string(X-date-end, "99.99.9999").
     2629      vI = vI + 1.
     2630      mParamStr[vI] = "Выбор объекта: ".
     2631      for each obj-list:
     2632         mParamStr[vI] = mParamStr[vI] + obj-list.obj-name + "," .
     2633      end.
     2634      mParamStr[vI] = trim(mParamStr[vI], ",").
     2635      vI = vI + 1.
     2636      if iGdsCodeList = "*" then do:
     2637         mParamStr[vI] = "Вся номенклатура".
     2638         mProdBcStrList = "*".
     2639      end.
     2640      else do:
     2641         mParamStr[vI] = "Номенклатура: ".
     2642         vStr = "".
     2643         for each goods where
     2644                  can-do(iGdsCodeList, string(goods.gds-code))
     2645         no-lock:
     2646            vStr = vStr + "," + string(goods.gds-code) + "(" + goods.gds-name + ")".
     2647            for each prod-bc where
     2648                     prod-bc.b-code = goods.gds-code
     2649            no-lock:
     2650               mProdBcStrList = mProdBcStrList + "," + prod-bc.b-str.
     2651            end.
     2652         end.
     2653         vStr = trim(vStr, ",").
     2654         mProdBcStrList = trim(mProdBcStrList, ",").
     2655         mParamStr[vI] = mParamStr[vI] + vStr.
     2656      end.
     2657      vI = vI + 1.
     2658      if iTRKList = "*" then
     2659         mParamStr[vI] = "Все ТРК".
     2660      else
     2661         mParamStr[vI] = "ТРК: " + iTRKList.
     2662      mParamStr[vI] = mParamStr[vI] + ", все пистолеты".
     2663      vI = vI + 1.
     2664      if iCashPayList = "*" then
     2665         mParamStr[vI] = "Все типы оплаты".
     2666      else do:
     2667         mParamStr[vI] = "Типы оплаты: ".
     2668         vStr = "".
     2669         for each cash-pay where
     2670                  can-do(iCashPayList, string(cash-pay.cdpay-code))
     2671         no-lock:
     2672            vStr = vStr + "," + cash-pay.obj-name.
     2673         end.
     2674         vStr = trim(vStr, ",").
     2675         mParamStr[vI] = mParamStr[vI] + vStr.
     2676      end.
     2677      vI = vI + 1.
     2678      if iChkTypeCodeList = "*" then
     2679         mParamStr[vI] = "Все типы чеков".
     2680      else do:
     2681         mParamStr[vI] = "Типы чеков: ".
     2682         vStr = "".
     2683         do vJ = 1 to num-entries("1,6,8,11,12,13,40,69,96,14,15,16,17,36,101,106,108,111,112,113,169,196,114,115,116,117,136,201,206,208,301,306,2,3,4,5,7,43,44"):
     2684            vChkCode = entry(vJ, "1,6,8,11,12,13,40,69,96,14,15,16,17,36,101,106,108,111,112,113,169,196,114,115,116,117,136,201,206,208,301,306,2,3,4,5,7,43,44").
     2685            if can-do(iChkTypeCodeList, vChkCode) then
     2686               vStr = vStr + "," + entry(vJ, "Продажа,Возврат,Аннуляция,Инвентаризация,Z-отчет,Закрытие_смены,Открытие_смены,Списание,ВзврСпис,СбросТрнзкц,Перелив,ПеревТрнзкц,ТехПролив,РазблТрнзкц,_Продажа,_Возврат,_Аннуляция,_Инвентаризация,_Z-отчет,_Закрытие_смены,_Списание,_ВзврСпис,_СбросТрнзкц,_Перелив,_ПеревТрнзкц,_ТехПролив,_РазблТрнзкц,>Продажа,>Возврат,>Аннуляция,>>Продажа,>>Возврат,Инкассация,Касс_фонд,Перевод_опл,Расход_кассы,Декл_ден_ящ,Приход_Корр,Расход_Корр").
     2687         end.
     2688         vStr = trim(vStr, ",").
     2689         mParamStr[vI] = mParamStr[vI] + vStr.
     2690      end.
     2691      if iTranTimeMax > 0 then do:
     2692         vI = vI + 1.
     2693         mParamStr[vI] = "Только с жизненным циклом заказа НП более " + string(iTranTimeMax) + " минут".
     2694      end.
     2695      vI = vI + 1.
     2696      if not iGrpChk and not iGrpTran then
     2697         mParamStr[vI] = "Без группировки".
     2698      else do:
     2699         mParamStr[vI] = "С группировкой по ".
     2700         if iGrpChk then
     2701            mParamStr[vI] = mParamStr[vI] + "чекам".
     2702         if iGrpTran then
     2703            mParamStr[vI] = mParamStr[vI] +
     2704                           (if iGrpChk then " и " else "") +
     2705                            "транзакциям".
     2706      end.
     2707   end procedure.
     2708   procedure PrintTT:
     2709      define variable vReportId     as character no-undo.
     2710      define variable vFileNameRep  as character no-undo.
     2711      define variable vLevel        as character no-undo.
     2712      define variable vPrevUuidCheq as character no-undo.
     2713      define variable vPrevUuid     as character no-undo.
     2714      define variable vStr          as character no-undo.
     2715      define variable vI            as integer   no-undo.
     2716      do on error undo, return error return-value:
     2717         run get-report-num(output vReportId).
     2718         vFileNameRep = session:temp-directory + string(vReportId) + ".html".
     2719         output stream sOutStr-html to value(vFileNameRep) convert target 'UTF-8'.
     2720         put stream sOutStr-html unformatted
     2721            "<!DOCTYPE HTML>" skip
     2722               ' <html>' skip
     2723               '  <head>' skip
     2724               '   <meta charset="utf-8">' skip
     2725               '    <style type="text/css">' skip
     2726               '      table ' + chr(123) + ' border-collapse: collapse; ' + chr(125) skip
     2727               '      .class1 ' + chr(123) + ' border-collapse: collapse; ' + chr(125) skip
     2728               '      tbody td, th ' + chr(123) + ' border-collapse: collapse; border: 1px solid black; height: 14px;' + chr(125) skip
     2729               '   </style>' skip
     2730               '  </head>' skip
     2731            .
     2732         put stream sOutStr-html unformatted
     2733              '<body>' skip
     2734              '<TABLE name="1" outline_below="true" fit_to_page="true" orientation="landscape" CELLSPACING="0" BORDER="0">' skip
     2735              '<thead>' skip
     2736              '<TR class="set_columns">' skip
     2737                  '<TD style="width:  68px;"></TD>' skip
     2738                  '<TD style="width: 111px;"></TD>' skip
     2739                  '<TD style="width:  84px;"></TD>' skip
     2740                  '<TD style="width:  78px;"></TD>' skip
     2741                  '<TD style="width:  88px;"></TD>' skip
     2742                  '<TD style="width:  80px;"></TD>' skip
     2743                  '<TD style="width:  95px;"></TD>' skip
     2744                  '<TD style="width:  84px;"></TD>' skip
     2745                  '<TD style="width: 148px;"></TD>' skip
     2746                  '<TD style="width:  64px;"></TD>' skip
     2747                  '<TD style="width: 150px;"></TD>' skip
     2748                  '<TD style="width:  65px;"></TD>' skip
     2749                  '<TD style="width: 108px;"></TD>' skip
     2750                  '<TD style="width:  72px;"></TD>' skip
     2751                  '<TD style="width: 113px;"></TD>' skip
     2752                  '<TD style="width:  79px;"></TD>' skip
     2753                  '<TD style="width:  82px;"></TD>' skip
     2754                  '<TD style="width:  97px;"></TD>' skip
     2755                  '<TD style="width: 150px;"></TD>' skip
     2756                  '<TD style="width: 157px;"></TD>' skip
     2757                  '<TD style="width:  88px;"></TD>' skip
     2758                  '<TD style="width:  81px;"></TD>' skip
     2759                  '<TD style="width:  85px;"></TD>' skip
     2760                  '<TD style="width: 100px;"></TD>' skip
     2761                  '<TD style="width:  91px;"></TD>' skip
     2762                  '<TD style="width:  91px;"></TD>' skip
     2763                  '<TD style="width: 103px;"></TD>' skip
     2764              '</TR>' skip
     2765              '<TR>' skip
     2766                  '<TD colspan="12" STYLE="font-size: 14px;">' + 'Отчет по продолжительности топливных транзакций' + '</TD>'skip
     2767              '</TR>' skip
     2768              .
     2769         do vI = 1 to extent(mParamStr):
     2770            if mParamStr[vI] = "" then leave.
     2771            put stream sOutStr-html unformatted
     2772                 '<TR>' skip
     2773                     '<TD colspan="12" STYLE="font-size: 14px;">' + mParamStr[vI] + '</TD>' skip
     2774                 '</TR>' skip
     2775               .
     2776         end.
     2777         put stream sOutStr-html unformatted
     2778              '<TR>' skip
     2779                  '<TD colspan="12" STYLE="font-size: 14px;">Дата печати: ' + string(today, "99.99.9999") + ' ' + string(time, "HH:MM") + '</TD>' skip
     2780              '</TR>' skip
     2781              '</thead>' skip
     2782            .
     2783         put stream sOutStr-html unformatted
     2784            '<tbody>'
     2785            '<TR >'skip
     2786               '<TH style="text-align: center; font-weight:bold; ">Название АЗС/АЗК</TH>'                 skip
     2787               '<TH style="text-align: center; font-weight:bold; ">Дата чека</TH>'                        skip
     2788               '<TH style="text-align: center; font-weight:bold; ">Время чека</TH>'                       skip
     2789               '<TH style="text-align: center; font-weight:bold; ">Дата смены</TH>'                       skip
     2790               '<TH style="text-align: center; font-weight:bold; ">Номер смены</TH>'                      skip
     2791               '<TH style="text-align: center; font-weight:bold; ">Номер чека</TH>'                       skip
     2792               '<TH style="text-align: center; font-weight:bold; ">Номер Z-отчета</TH>'                   skip
     2793               '<TH style="text-align: center; font-weight:bold; ">Номер топливной транзакции</TH>'       skip
     2794               '<TH style="text-align: center; font-weight:bold; ">Тип чека</TH>'                         skip
     2795               '<TH style="text-align: center; font-weight:bold; ">Номер кассы</TH>'                      skip
     2796               '<TH style="text-align: center; font-weight:bold; ">ФИО кассира</TH>'                      skip
     2797               '<TH style="text-align: center; font-weight:bold; ">Номер ТРК</TH>'                        skip
     2798               '<TH style="text-align: center; font-weight:bold; ">Номер пистолета</TH>'                  skip
     2799               '<TH style="text-align: center; font-weight:bold; ">Код топлива</TH>'                      skip
     2800               '<TH style="text-align: center; font-weight:bold; ">Наименование топлива</TH>'             skip
     2801               '<TH style="text-align: center; font-weight:bold; ">Объем топлива, л</TH>'                 skip
     2802               '<TH style="text-align: center; font-weight:bold; ">Цена топлива, р</TH>'                  skip
     2803               '<TH style="text-align: center; font-weight:bold; ">Сумма, р</TH>'                         skip
     2804               '<TH style="text-align: center; font-weight:bold; ">Тип оплаты</TH>'                       skip
     2805               '<TH style="text-align: center; font-weight:bold; ">Номер карты</TH>'                      skip
     2806               '<TH style="text-align: center; font-weight:bold; ">Дата начала транзакции</TH>'           skip
     2807               '<TH style="text-align: center; font-weight:bold; ">Время начала транзакции</TH>'          skip
     2808               '<TH style="text-align: center; font-weight:bold; ">Дата окончания транзакции</TH>'        skip
     2809               '<TH style="text-align: center; font-weight:bold; ">Время окончания транзакции</TH>'       skip
     2810               '<TH style="text-align: center; font-weight:bold; ">Продолжительность транзакции (*)</TH>' skip
     2811               '<TH style="text-align: center; font-weight:bold; ">Жизненный цикл заказа НП</TH>'         skip
     2812               '<TH style="text-align: center; font-weight:bold; ">Продолжение налива</TH>'               skip
     2813            '</TR>'skip
     2814            .
     2815         for each tt-rep
     2816         break
     2817            by tt-rep.obj-code
     2818            by tt-rep.grp-num
     2819            by tt-rep.sort-date
     2820            by tt-rep.sort-time
     2821            by tt-rep.datetime-beg
     2822            by tt-rep.datetime-end:
     2823            vLevel = "".
     2824            if not first-of(tt-rep.grp-num) then do:
     2825               if iGrpChk or iGrpTran then do:
     2826                  if iGrpChk and iGrpTran then
     2827                     vLevel = 'level="2"'.
     2828                  else if iGrpChk and tt-rep.uuid-cheq = vPrevUuidCheq then
     2829                     vLevel = 'level="2"'.
     2830                  else if iGrpTran and tt-rep.uuid = vPrevUuid then
     2831                     vLevel = 'level="2"'.
     2832               end.
     2833            end.
     2834            assign
     2835               vPrevUuidCheq = tt-rep.uuid-cheq
     2836               vPrevUuid     = tt-rep.uuid
     2837               .
     2838            put stream sOutStr-html unformatted
     2839               '<TR ' vLevel '>' skip
     2840                   '<TD text_wrap="true" style="text-align: center">' fStrNvl(tt-rep.obj-name, "")                                '</TD>' skip
     2841                   '<TD style="text-align: center">'                  fdate2str(tt-rep.chk-date, "99.99.9999")                    '</TD>' skip
     2842                   '<TD style="text-align: center">'                  if tt-rep.chk-date = ? then "" else fStrNvl(string(tt-rep.chk-time, "HH:MM:SS"), "") '</TD>' skip
     2843                   '<TD style="text-align: center">'                  fdate2str(tt-rep.shift-date, "99.99.9999")                  '</TD>' skip
     2844                   '<TD style="text-align: center">'                  fStrNvl(tt-rep.shift-name, "")                              '</TD>' skip
     2845                   '<TD style="text-align: center">'                  fInt2Str(tt-rep.chk-num, ">>>>>>>>>>")                      '</TD>' skip
     2846                   '<TD style="text-align: center">'                  fInt2Str(tt-rep.z-number, ">>>>>>>>>>")                     '</TD>' skip
     2847                   '<TD style="text-align: center">'                  fInt2Str(tt-rep.tran-num, ">>>>>>>>>9")                     '</TD>' skip
     2848                   '<TD text_wrap="true" style="text-align: center">' fStrNvl(tt-rep.chk-type-desc, "")                           '</TD>' skip
     2849                   '<TD style="text-align: center">'                  fInt2Str(tt-rep.cash-num, ">>>>9")                          '</TD>' skip
     2850                   '<TD text_wrap="true" style="text-align: left">' fStrNvl(tt-rep.cashier, "")                                 '</TD>' skip
     2851                   '<TD style="text-align: center">'                  fInt2Str(tt-rep.trk-num, ">>9")                             '</TD>' skip
     2852                   '<TD style="text-align: center">'                  fInt2Str(tt-rep.nozzle-num, ">>9")                          '</TD>' skip
     2853                   '<TD style="text-align: center">'                  fInt2Str(tt-rep.fuel-code, ">>>>>>>>>9")                    '</TD>' skip
     2854                   '<TD text_wrap="true" style="text-align: center">' fStrNvl(tt-rep.gds-name, "")                                '</TD>' skip
     2855                   '<TD num="#,##0.00" val="' + fDec2Str(tt-rep.volume, "->>>>>>>>>>>9.99") + '" style="text-align: right">' + fDec2Str(tt-rep.volume, "->>>>>>>>>>>9.99") + '</TD>' skip
     2856                   '<TD num="#,##0.00" val="' + fDec2Str(tt-rep.price, "->>>>>>>>>>>9.99") + '" style="text-align: right">'  + fDec2Str(tt-rep.price, "->>>>>>>>>>>9.99") + '</TD>' skip
     2857                   '<TD num="#,##0.00" val="' + fDec2Str(tt-rep.money, "->>>>>>>>>>>9.99") + '" style="text-align: right">'  + fDec2Str(tt-rep.money, "->>>>>>>>>>>9.99") + '</TD>' skip
     2858                   '<TD text_wrap="true" style="text-align: center">' fStrNvl(tt-rep.cash-pay-name, "")                           '</TD>' skip
     2859                   '<TD style="text-align: center">'                  fStrNvl(tt-rep.pay-card, "")                                '</TD>' skip
     2860                   '<TD style="text-align: center">'                  fdate2str(tt-rep.date-beg, "99.99.9999")                    '</TD>' skip
     2861                   '<TD style="text-align: center">'                  fStrNvl(string(tt-rep.time-beg, "HH:MM:SS"), "")            '</TD>' skip
     2862                   '<TD style="text-align: center">'                  fdate2str(tt-rep.date-end, "99.99.9999")                    '</TD>' skip
     2863                   '<TD style="text-align: center">'                  fStrNvl(string(tt-rep.time-end, "HH:MM:SS"), "")            '</TD>' skip
     2864                   '<TD style="text-align: center">'                  fStrNvl(f_disp_time(tt-rep.time-length), "")                '</TD>' skip
     2865                   '<TD style="text-align: center">'                  fStrNvl(f_disp_time(tt-rep.all-time-length-2), "")          '</TD>' skip
     2866                   '<TD style="text-align: center">'                  string(tt-rep.resume-tran, "+/-")                           '</TD>' skip
     2867               '</TR>' skip.
     2868            if last-of(tt-rep.obj-code) then do:
     2869               for first tt-total-rep where
     2870                         tt-total-rep.obj-type = tt-rep.obj-type
     2871                     and tt-total-rep.obj-code = tt-rep.obj-code
     2872                     and tt-total-rep.obj-name = tt-rep.obj-name:
     2873                  put stream sOutStr-html unformatted
     2874                     '<TR >' skip
     2875                         '<TD style="text-align: left; font-weight:bold">'                   "Итого по:"                                                '</TD>' skip
     2876                         '<TD style="text-align: left; font-weight:bold">'                   fStrNvl(tt-total-rep.obj-name, "")                         '</TD>' skip
     2877                         '<TD text_wrap="true" style="text-align: left; font-weight:bold">'  "Количество чеков"                                         '</TD>' skip
     2878                         '<TD style="text-align: left; font-weight:bold">'                    fInt2Str(tt-total-rep.qty-chk, ">>>9")                    '</TD>' skip
     2879                         '<TD text_wrap="true" style="text-align: left; font-weight:bold">'  "Количество транзакций"                                    '</TD>' skip
     2880                         '<TD style="text-align: left; font-weight:bold">'                    fInt2Str(tt-total-rep.qty-tran, ">>>9")                   '</TD>' skip
     2881                         '<TD text_wrap="true" style="text-align: left; font-weight:bold">'  "Количество  чеков с транзакциями"                         '</TD>' skip
     2882                         '<TD style="text-align: left; font-weight:bold">'                    fInt2Str(tt-total-rep.qty-chk-fuel, ">>>9")               '</TD>' skip
     2883                         '<TD text_wrap="true" style="text-align: left; font-weight:bold">'  "Общая продолжительность"                                  '</TD>' skip
     2884                         '<TD style="text-align: left; font-weight:bold">'                    fStrNvl(f_disp_time(tt-total-rep.full-time-tran), "")     '</TD>' skip
     2885                         '<TD text_wrap="true" style="text-align: left; font-weight:bold">'  "Средняя продолжительность"                                '</TD>' skip
     2886                         '<TD style="text-align: left; font-weight:bold">'                    fStrNvl(f_disp_time(tt-total-rep.avg-time-tran), "")      '</TD>' skip
     2887                         '<TD text_wrap="true" style="text-align: left; font-weight:bold">'  "Средняя длительность жизненного цикла заказа НП"          '</TD>' skip
     2888                         '<TD style="text-align: left; font-weight:bold">'                    fStrNvl(f_disp_time(tt-total-rep.avg-time-tran-fuel), "") '</TD>' skip
     2889                         .
     2890               end.
     2891               do vI = 1 to 13:
     2892                  put stream sOutStr-html unformatted
     2893                     '<TD style="text-align: right"> </TD>' skip
     2894                     .
     2895               end.
     2896               put stream sOutStr-html unformatted
     2897                     '</TR>' skip.
     2898            end.
     2899         end.
     2900         for first tt-all-total-rep:
     2901            put stream sOutStr-html unformatted
     2902               '<TR >' skip
     2903                   '<TD style="text-align: left; font-weight:bold">'                   "Итого по:"                                                    '</TD>' skip
     2904                   '<TD text_wrap="true" style="text-align: left; font-weight:bold">'  "Всем выбранным объектам"                                      '</TD>' skip
     2905                   '<TD text_wrap="true" style="text-align: left; font-weight:bold">'  "Количество чеков"                                             '</TD>' skip
     2906                   '<TD style="text-align: left; font-weight:bold">'                    fInt2Str(tt-all-total-rep.qty-chk, ">>>9")                    '</TD>' skip
     2907                   '<TD text_wrap="true" style="text-align: left; font-weight:bold">'  "Количество транзакций"                                        '</TD>' skip
     2908                   '<TD style="text-align: left; font-weight:bold">'                    fInt2Str(tt-all-total-rep.qty-tran, ">>>9")                   '</TD>' skip
     2909                   '<TD text_wrap="true" style="text-align: left; font-weight:bold">'  "Количество  чеков с транзакциями"                             '</TD>' skip
     2910                   '<TD style="text-align: left; font-weight:bold">'                    fInt2Str(tt-all-total-rep.qty-chk-fuel, ">>>9")               '</TD>' skip
     2911                   '<TD text_wrap="true" style="text-align: left; font-weight:bold">'  "Общая продолжительность"                                      '</TD>' skip
     2912                   '<TD style="text-align: left; font-weight:bold">'                    fStrNvl(f_disp_time(tt-all-total-rep.full-time-tran), "")     '</TD>' skip
     2913                   '<TD text_wrap="true" style="text-align: left; font-weight:bold">'  "Средняя продолжительность"                                    '</TD>' skip
     2914                   '<TD style="text-align: left; font-weight:bold">'                    fStrNvl(f_disp_time(tt-all-total-rep.avg-time-tran), "")      '</TD>' skip
     2915                   '<TD text_wrap="true" style="text-align: left; font-weight:bold">'  "Средняя длительность жизненного цикла заказа НП"              '</TD>' skip
     2916                   '<TD style="text-align: left; font-weight:bold">'                    fStrNvl(f_disp_time(tt-all-total-rep.avg-time-tran-fuel), "") '</TD>' skip
     2917                   .
     2918            do vI = 1 to 13:
     2919               put stream sOutStr-html unformatted
     2920                  '<TD style="text-align: right"> </TD>' skip
     2921                  .
     2922            end.
     2923            put stream sOutStr-html unformatted
     2924                  '</TR>' skip.
     2925         end.
     2926         vStr = "(*) В отчете для всех строк с транзакцией, связанной с несколькими чеками или строками чеков (при смешанной оплате), " +
     2927                "отображается одинаковая продолжительность. Данное время не определяет длительность выполнения конкретной кассовой операции " +
     2928                "(например, возврат, сброс, аннуляция, смешанная оплата), относящейся к транзакции".
     2929         put stream sOutStr-html unformatted
     2930            '<TR>'  skip
     2931               '<TD colspan="27" STYLE="font-size: 11px;">' + vStr + '</TD>' skip
     2932            '</TR>' skip.
     2933         put stream sOutStr-html unformatted
     2934            '</tbody>' skip
     2935            '</table>' skip
     2936            '</body>' skip
     2937            '</html>' skip
     2938            .
     2939         output stream sOutStr-html close.
     2940         run prn-lib-reportviewer-report-name in this-procedure (
     2941             input parparentproc
     2942             ,input vFileNameRep
     2943             ) no-error.
     2944         if error-status:error then
     2945         do:
     2946             message "error-status:error = " error-status:error skip return-value view-as alert-box.
     2947             return .
     2948         end.
     2949      end.
     2950   end procedure.
     2951   PROCEDURE get-report-num :
     2952   define output parameter p-report-num as integer no-undo .
     2953     do
     2954     on error undo, return error return-value
     2955     :
     2956       run gbl/getrpnum.p (output p-report-num).
     2957     end.
     2958   END PROCEDURE.
