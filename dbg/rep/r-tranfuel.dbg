      582   procedure fd-attr-code :
      583     do
      584     on error undo, return error
      585     :
      586       define input  parameter p-code           as character no-undo .
      587       define output parameter p-type           as character no-undo .
      588       define output parameter p-format         as character no-undo .
      589       define output parameter p-label          as character no-undo .
      590       define output parameter p-user-can-edit  as logical   no-undo .
      591       define output parameter p-output-display as logical   no-undo .
      592       define output parameter p-other          as character no-undo .
      593       case p-code :
      594               when 'shift-date':U then do:     assign     p-label = "Дата смены"     p-type = 'T':U      p-format = "99/99/9999"     p-label = "Дата смены"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
      595               when 'shift-num':U then do:     assign     p-label = "П.смены"     p-type = 'I':U      p-format = "99"     p-label = "П.смены"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
      596               when 'shift-name':U then do:     assign     p-label = "№ смены"     p-type = 'C':U      p-format = "X(2)"     p-label = "№ смены"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
      597               when 'barcode':U then do:     assign     p-label = "Штрих-код"     p-type = 'C':U      p-format = "X(20)"     p-label = "Штрих-код"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
      598               when 'lockid':U then do:     assign     p-label = "ID блокировки чека"     p-type = 'C':U      p-format = "X(2)"     p-label = "ID блокировки чека"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
      599               when 'cover_sheet':U then do:     assign     p-label = "Разбиение по номиналам"     p-type = 'C':U      p-format = "X(4000)"     p-label = "Разбиение по номиналам"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
      600               when 'pre-vedom':U then do:     assign     p-label = "Атрибут для препроводительной ведомости"     p-type = 'C':U      p-format = "X(256)"     p-label = "Атрибут для препроводительной ведомости"     p-user-can-edit  = false     p-output-display = false     p-other = '':u      .   end.
      601               when 'contr-kb':U then do:     assign     p-label = "Код кассовой книги получателя\отправителя при перемещении ДС между кассами"     p-type = 'I':U      p-format = ">>>9"     p-label = "Код кассовой книги получателя\отправителя при перемещении ДС между кассами"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
      602         otherwise do:
      603           undo, return error "неизвестный атрибут платежа" + " " + p-code .
      604         end.
      605       end.
      606     end.
      607   end procedure.
      608   procedure fd-attr-tooltip :
      609     do
      610     on error undo, return error
      611     :
      612       define input  parameter p-code    as character no-undo .
      613       define output parameter p-tooltip as character no-undo .
      614       define output parameter p-label   as character no-undo .
      615       case p-code :
      616               when 'shift-date':U then do:     assign     p-tooltip = "Дата смены"     p-label = "Дата смены" .   end.
      617               when 'shift-num':U then do:     assign     p-tooltip = "П.смены"     p-label = "П.смены" .   end.
      618               when 'shift-name':U then do:     assign     p-tooltip = "№ смены"     p-label = "№ смены" .   end.
      619               when 'barcode':U then do:     assign     p-tooltip = "Штрих-код"     p-label = "Штрих-код" .   end.
      620               when 'lockid':U then do:     assign     p-tooltip = "ID блокировки чека"     p-label = "ID блокировки чека" .   end.
      621               when 'cover_sheet':U then do:     assign     p-tooltip = "Разбиение по номиналам"     p-label = "Разбиение по номиналам" .   end.
      622               when 'pre-vedom':U then do:     assign     p-tooltip = "Атрибут для препроводительной ведомости"     p-label = "Атрибут для препроводительной ведомости" .   end.
      623               when 'contr-kb':U then do:     assign     p-tooltip = "Код кассовой книги получателя\отправителя при перемещении ДС между кассами"     p-label = "Код кассовой книги получателя\отправителя при перемещении ДС между кассами" .   end.
      624         otherwise do:
      625           undo, return error "неизвестный атрибут платежа" + " " + p-code .
      626         end.
      627       end.
      628     end.
      629   end procedure.
      630   procedure fin-doc-attr-write :
      631    do
      632    on error undo, return error return-value
      633    :
      634   define input parameter p-host-code     like ub.fin-doc-attr.host-code  no-undo .
      635   define input parameter p-fin-doc-code  like ub.fin-doc-attr.fin-doc-code   no-undo .
      636   define input parameter p-attr-code     like ub.fin-doc-attr.attr-code  no-undo .
      637   define input parameter p-attr-value    like ub.fin-doc-attr.attr-value no-undo .
      638   define variable  v-format         as character no-undo .
      639   define variable  v-label          as character no-undo .
      640   define variable  v-user-can-edit  as logical   no-undo .
      641   define variable  v-output-display as logical   no-undo .
      642   define variable  v-other          as character no-undo .
      643   define variable  v-type           as character no-undo .
      644   define buffer buf_fin-doc-attr for ub.fin-doc-attr.
      645   run fd-attr-code in this-procedure
      646                                     (input  p-attr-code
      647                                     ,output v-type
      648                                     ,output v-format
      649                                     ,output v-label
      650                                     ,output v-user-can-edit
      651                                     ,output v-output-display
      652                                     ,output v-other
      653                                     ) no-error .
      654   if error-status :error then do:
      655     undo, return error return-value .
      656   end.
      657   find first buf_fin-doc-attr  exclusive-lock  where
      658             buf_fin-doc-attr.attr-code    = p-attr-code
      659         AND buf_fin-doc-attr.host-code    = p-host-code
      660         AND buf_fin-doc-attr.fin-doc-code     = p-fin-doc-code  no-error .
      661     if not available  buf_fin-doc-attr then do:
      662         create buf_fin-doc-attr.
      663         assign
      664         buf_fin-doc-attr.attr-code    = p-attr-code
      665         buf_fin-doc-attr.attr-value   = p-attr-value
      666         buf_fin-doc-attr.host-code    = p-host-code
      667         buf_fin-doc-attr.fin-doc-code     = p-fin-doc-code
      668         .
      669     end.
      670     else do:
      671          assign
      672          buf_fin-doc-attr.attr-value = p-attr-value.
      673     end.
      674    end.
      675   end procedure.
      676   procedure fd-attr-exist :
      677     do
      678     on error undo, return error
      679     :
      680       define input parameter p-host-code     like ub.fin-doc-attr.host-code  no-undo .
      681       define input parameter p-fin-doc-code  like ub.fin-doc-attr.fin-doc-code   no-undo .
      682       define input parameter p-code          like ub.fin-doc-attr.attr-code  no-undo .
      683       define output parameter p-exist   as logical  no-undo .
      684       define buffer buf_fin-doc-attr for ub.fin-doc-attr .
      685       define variable  v-type           as character no-undo .
      686       define variable  v-format         as character no-undo .
      687       define variable  v-label          as character no-undo .
      688       define variable  v-user-can-edit  as logical   no-undo .
      689       define variable  v-output-display as logical   no-undo .
      690       define variable  v-other          as character no-undo .
      691       run fd-attr-code in this-procedure
      692         (input  p-code
      693         ,output v-type
      694         ,output v-format
      695         ,output v-label
      696         ,output v-user-can-edit
      697         ,output v-output-display
      698         ,output v-other
      699         ) no-error .
      700       if error-status :error then do:
      701         undo, return error return-value .
      702       end.
      703       find first buf_fin-doc-attr exclusive-lock
      704         where buf_fin-doc-attr.host-code  = p-host-code
      705           and buf_fin-doc-attr.fin-doc-code  = p-fin-doc-code
      706           and buf_fin-doc-attr.attr-code = p-code
      707         no-error .
      708       if  available buf_fin-doc-attr then do:
      709         p-exist = yes.
      710       end.
      711     end.
      712   end procedure.
      713   procedure fd-attr-delete :
      714     do
      715     on error undo, return error
      716     :
      717     define input parameter p-host-code     like ub.fin-doc-attr.host-code  no-undo .
      718     define input parameter p-fin-doc-code  like ub.fin-doc-attr.fin-doc-code   no-undo .
      719     define input parameter p-code          like ub.fin-doc-attr.attr-code  no-undo .
      720     define output parameter p-deleted  as logical no-undo.
      721       define buffer buf_fin-doc-attr for ub.fin-doc-attr .
      722       define variable  v-type           as character no-undo .
      723       define variable  v-format         as character no-undo .
      724       define variable  v-label          as character no-undo .
      725       define variable  v-user-can-edit  as logical   no-undo .
      726       define variable  v-output-display as logical   no-undo .
      727       define variable  v-other          as character no-undo .
      728       run fd-attr-code in this-procedure
      729         (input  p-code
      730         ,output v-type
      731         ,output v-format
      732         ,output v-label
      733         ,output v-user-can-edit
      734         ,output v-output-display
      735         ,output v-other
      736         ) no-error .
      737       if error-status :error then do:
      738         undo, return error return-value .
      739       end.
      740       find first buf_fin-doc-attr exclusive-lock
      741         where buf_fin-doc-attr.host-code  = p-host-code
      742           and buf_fin-doc-attr.fin-doc-code  = p-fin-doc-code
      743           and buf_fin-doc-attr.attr-code = p-code
      744         no-error NO-WAIT.
      745       if not available buf_fin-doc-attr then do:
      746         p-deleted = no.
      747       end.
      748       else do:
      749         delete buf_fin-doc-attr no-error .
      750         if error-status:error then do:
      751           undo, return error return-value .
      752         end.
      753         p-deleted = yes.
      754       end.
      755     end.
      756   end procedure.
