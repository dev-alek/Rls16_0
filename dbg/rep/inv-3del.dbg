      397   procedure grplib-get-sort-name :
      398   do
      399   on error undo, return error
      400   :
      401   define input parameter p-node-code  as integer      no-undo.
      402   define output parameter p-sort-name as character    no-undo.
      403       define variable v-upper-code    as integer           no-undo.
      404       define buffer buf_gds-grp       for ub.gds-grp.
      405       define buffer buf_upper_gds-grp for ub.gds-grp.
      406       find first buf_gds-grp no-lock
      407            where buf_gds-grp.node-code = p-node-code
      408       no-error.
      409       if not available buf_gds-grp
      410       then do:
      411           undo, return error "grplib-get-sort-name: Не найдена группа товаров с кодом " + string( p-node-code ).
      412       end.
      413       assign
      414           p-sort-name  = ""
      415           v-upper-code = 1
      416       .
      417       do while buf_gds-grp.upper-code <> 0
      418       on error undo, return error "grplib-get-sort-name: Ошибка составления полного имени группы"
      419       :
      420           assign
      421               p-sort-name  = buf_gds-grp.node-name
      422                            + (if p-sort-name <> "" then chr(2) else "")
      423                            + p-sort-name
      424               v-upper-code = buf_gds-grp.upper-code
      425           .
      426           find first buf_gds-grp no-lock
      427                where buf_gds-grp.node-code = v-upper-code
      428           no-error.
      429           if not available buf_gds-grp
      430           then do:
      431               undo, return error "grplib-get-sort-name: Не найдена группа товаров с кодом "
      432                                   + string( v-upper-code )
      433                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      434           end.
      435       end.
      436   end.
      437   end procedure.
      438   define variable vss-include-info5 as character format "X(65)" no-undo
      439   initial "@(#)$Workfile$ $Revision$".
      440   procedure grplib-get-full-name :
      441      define input parameter p-node-code  as integer      no-undo.
      442      define output parameter p-full-name as character    no-undo.
      443      do
      444   on error undo, return error
      445   :
      446       define variable v-upper-code    as integer           no-undo.
      447       define buffer buf_gds-grp       for ub.gds-grp.
      448       define buffer buf_upper_gds-grp for ub.gds-grp.
      449       find first buf_gds-grp no-lock
      450            where buf_gds-grp.node-code = p-node-code
      451       no-error.
      452       if not available buf_gds-grp
      453       then do:
      454           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
      455       end.
      456       assign
      457           p-full-name  = ""
      458           v-upper-code = 1
      459       .
      460       do while buf_gds-grp.upper-code <> 0
      461       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
      462       :
      463           assign
      464               p-full-name  = buf_gds-grp.node-name
      465                            + (if p-full-name <> "" then chr(47) else "")
      466                            + p-full-name
      467               v-upper-code = buf_gds-grp.upper-code
      468           .
      469           find first buf_gds-grp no-lock
      470                where buf_gds-grp.node-code = v-upper-code
      471           no-error.
      472           if not available buf_gds-grp
      473           then do:
      474               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
      475                                   + string( v-upper-code )
      476                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      477           end.
      478       end.
      479       assign
      480       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
      481       .
      482   end.
      483   end .
      484   procedure grplib-get-node-from-full-name :
      485   define input parameter p-full-name as character no-undo .
      486   define output parameter p-node-code as integer no-undo .
      487   define variable v-ii as integer no-undo .
      488   define variable v-upper-code as integer no-undo .
      489   define variable v-root-code as integer no-undo .
      490   define variable v-entry as character no-undo .
      491   define buffer buf_gds-grp       for ub.gds-grp.
      492   do
      493   on error undo, return error
      494   :
      495     find first buf_gds-grp no-lock
      496         where buf_gds-grp.upper-code = 0
      497     no-error .
      498     if not available buf_gds-grp
      499     then do:
      500         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
      501     end.
      502     else do:
      503       assign
      504       v-root-code = buf_gds-grp.node-code
      505       .
      506     end.
      507     v-upper-code = v-root-code.
      508     do v-ii = 1 to num-entries(p-full-name, chr(47)):
      509       assign
      510       v-entry = entry(v-ii, p-full-name, chr(47)).
      511       if v-entry = '' then leave.
      512       find first buf_gds-grp no-lock where
      513                 buf_gds-grp.node-name = v-entry
      514             and buf_gds-grp.upper-code = v-upper-code
      515             no-error.
      516       if not available buf_gds-grp then do:
      517         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
      518       end.
      519       else do:
      520         p-node-code = buf_gds-grp.node-code.
      521         v-upper-code = buf_gds-grp.node-code.
      522       end.
      523     end.
      524   end.
      525   end .
      526   procedure grplib-get-root-code :
      527   do
      528   on error undo, return error
      529   :
      530   define output parameter p-root-code as integer      no-undo.
      531       define buffer buf_gds-grp       for ub.gds-grp.
      532       find first buf_gds-grp no-lock
      533           where buf_gds-grp.upper-code = 0
      534       no-error .
      535       if not available buf_gds-grp
      536       then do:
      537           undo, return error .
      538       end.
      539       else do:
      540           assign
      541               p-root-code = buf_gds-grp.node-code
      542           .
      543       end.
      544   end.
      545   end procedure.
      546   procedure grplib-find-grp-by-full-name :
      547   do
      548   on error undo, return error
      549   :
      550   define input parameter p-search-name  as character    no-undo.
      551   define input parameter p-fill-path    as logical      no-undo.
      552   define output parameter p-found       as logical      no-undo.
      553       define variable v-upper-code    as integer          no-undo.
      554       define variable v-counter       as integer           no-undo.
      555       define variable v-level         as integer           no-undo.
      556       define variable v-full-name     as character         no-undo.
      557       define variable v-sort-name     as character         no-undo.
      558       define buffer buf_gds-grp       for ub.gds-grp.
      559       assign
      560           p-search-name = replace( p-search-name, chr(47), chr(2) )
      561       .
      562       run grplib-get-root-code ( output v-upper-code ) no-error .
      563       if error-status :error
      564       then do:
      565           undo, return error "grplib-expand-name: Ошибка при поиске корневого узла".
      566       end.
      567       assign
      568           v-full-name  = ""
      569           v-level      = num-entries( p-search-name, chr(2) )
      570       .
      571       for each temp_grplib_found-grp
      572       :
      573           delete temp_grplib_found-grp.
      574       end.
      575       start-name-analyze:
      576       do v-counter = 1 to v-level
      577       :
      578           if v-counter < v-level
      579           then do:
      580               find first buf_gds-grp no-lock
      581                    where buf_gds-grp.upper-code = v-upper-code
      582                      and buf_gds-grp.node-name  = entry( v-counter, p-search-name, chr(2) )
      583               no-error .
      584               if not available buf_gds-grp
      585               then do:
      586                   assign
      587                       v-full-name  = p-search-name
      588                       v-sort-name  = p-search-name
      589                   .
      590                   return error "grplib-expand-name: не найдена группа " + entry( v-level, p-search-name, chr(2) ).
      591               end.
      592               else do:
      593                   assign
      594                       v-full-name = v-full-name + ( if v-full-name = "" then "" else chr(47) )        + buf_gds-grp.node-name
      595                       v-sort-name = v-sort-name + ( if v-sort-name = "" then "" else chr(2) ) + buf_gds-grp.node-name
      596                       v-upper-code = buf_gds-grp.node-code
      597                   .
      598                   if p-fill-path = yes
      599                   then do:
      600                       create temp_grplib_found-grp.
      601                       assign
      602                           temp_grplib_found-grp.full-name = v-full-name + chr(47)
      603                           temp_grplib_found-grp.sort-name = v-sort-name
      604                           temp_grplib_found-grp.node-code = v-upper-code
      605                           temp_grplib_found-grp.level     = v-counter
      606                       .
      607                   end.
      608               end.
      609           end.
      610           else do:
      611               for each buf_gds-grp no-lock
      612                  where buf_gds-grp.upper-code = v-upper-code
      613                    and buf_gds-grp.node-name begins entry( v-counter, p-search-name, chr(2) )
      614               :
      615                   assign
      616                       p-found = yes
      617                   .
      618                   create temp_grplib_found-grp.
      619                   assign
      620                       temp_grplib_found-grp.full-name = v-full-name
      621                                                           + (if v-full-name = "" then "" else chr(47) )
      622                                                           + buf_gds-grp.node-name + chr(47)
      623                       temp_grplib_found-grp.sort-name = v-sort-name
      624                                                           + ( if v-sort-name = "" then "" else chr(2) )
      625                                                           + buf_gds-grp.node-name
      626                       temp_grplib_found-grp.node-code = buf_gds-grp.node-code
      627                       temp_grplib_found-grp.level     = v-level
      628                   .
      629               end.
      630               if p-found = no
      631               then do:
      632                   assign
      633                       v-full-name  = p-search-name
      634                       v-sort-name  = p-search-name
      635                   .
      636                   for each temp_grplib_found-grp
      637                   :
      638                       delete temp_grplib_found-grp.
      639                   end.
      640                   assign
      641                       p-found = no
      642                   .
      643               end.
      644           end.
      645       end.
      646   end.
      647   end procedure.
      648   procedure grplib-find-all-subgroup :
      649   do
      650   on error undo, return error
      651   :
      652   define input parameter p-start-node-code    as integer      no-undo.
      653   define input parameter p-terminal-only      as logical      no-undo.
      654       define variable v-start-full-name   as character     no-undo.
      655       define variable v-start-sort-name   as character     no-undo.
      656       define variable v-not-found         as logical       no-undo.
      657       define variable v-is-terminal       as logical       no-undo.
      658       define buffer buf_gds-grp           for ub.gds-grp.
      659       create temp_found-result-nodelist.
      660       assign
      661           temp_found-result-nodelist.node-code = p-start-node-code
      662           temp_found-result-nodelist.processed = no
      663       .
      664       run grplib-get-full-name in this-procedure (
      665             input p-start-node-code
      666           , output v-start-full-name
      667       ).
      668       run grplib-get-full-name in this-procedure (
      669             input p-start-node-code
      670           , output v-start-sort-name
      671       ).
      672       process-nodes:
      673       do while yes
      674       :
      675           find first temp_found-result-nodelist
      676                where temp_found-result-nodelist.node-code = p-start-node-code
      677           .
      678           assign
      679               temp_found-result-nodelist.processed = yes
      680           .
      681           for each buf_gds-grp no-lock
      682              where buf_gds-grp.upper-code = p-start-node-code
      683           on error undo, return error
      684           :
      685               run grplib-is-terminal in this-procedure (
      686                     input buf_gds-grp.node-code
      687                   , output v-is-terminal
      688               ).
      689               if v-is-terminal = yes
      690               then do:
      691                   create temp_grplib_found-grp.
      692                   assign
      693                       temp_grplib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
      694                                                           chr(47) + buf_gds-grp.node-name + chr(47)
      695                       temp_grplib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
      696                                                           chr(2) + buf_gds-grp.node-name + chr(2)
      697                       temp_grplib_found-grp.node-code   = buf_gds-grp.node-code
      698                       temp_grplib_found-grp.is-terminal = yes
      699                   .
      700               end.
      701               else do:
      702                   create temp_found-result-nodelist.
      703                   assign
      704                       temp_found-result-nodelist.node-code = buf_gds-grp.node-code
      705                       temp_found-result-nodelist.full-name = right-trim(v-start-full-name, chr(47)) +
      706                                                              chr(47) + buf_gds-grp.node-name + chr(47)
      707                       temp_found-result-nodelist.sort-name = right-trim(v-start-sort-name, chr(2)) +
      708                                                              chr(2) + buf_gds-grp.node-name + chr(2)
      709                       temp_found-result-nodelist.processed = no
      710                   .
      711                   if p-terminal-only = no
      712                   then do:
      713                       create temp_grplib_found-grp.
      714                       assign
      715                           temp_grplib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
      716                                                               chr(47) + buf_gds-grp.node-name + chr(47)
      717                           temp_grplib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
      718                                                               chr(2) + buf_gds-grp.node-name + chr(2)
      719                           temp_grplib_found-grp.node-code   = buf_gds-grp.node-code
      720                           temp_grplib_found-grp.is-terminal = no
      721                       .
      722                   end.
      723               end.
      724           end.
      725           find first temp_found-result-nodelist
      726                where temp_found-result-nodelist.processed = no
      727           no-error.
      728           if not available temp_found-result-nodelist
      729           then do:
      730               leave process-nodes.
      731           end.
      732           else do:
      733               assign
      734                   p-start-node-code = temp_found-result-nodelist.node-code
      735                   v-start-full-name = temp_found-result-nodelist.full-name
      736                   v-start-sort-name = temp_found-result-nodelist.sort-name
      737               .
      738           end.
      739       end.
      740   end.
      741   end procedure.
      742   procedure grplib-expand-name :
      743   define input parameter p-start-name as character        no-undo.
      744   define output parameter p-end-name  as character        no-undo.
      745       define variable v-is-terminal   as logical      no-undo.
      746       define variable v-found         as character    no-undo.
      747       define buffer buf_temp_grplib_found-grp     for temp_grplib_found-grp.
      748   do
      749   for buf_temp_grplib_found-grp
      750   on error undo, return error
      751   :
      752       run grplib-find-grp-by-full-name in this-procedure (
      753             input p-start-name
      754           , input no
      755           , output v-found
      756       ) no-error.
      757       run grplib-get-max-substring in this-procedure (
      758                   input length( p-start-name )
      759                 , output p-end-name
      760       ) no-error .
      761       if error-status :error
      762       then do:
      763           assign
      764               p-end-name = ""
      765           .
      766       end.
      767       else do:
      768           find first temp_grplib_found-grp
      769               where temp_grplib_found-grp.full-name = p-end-name
      770           no-error.
      771           if available temp_grplib_found-grp
      772           then do:
      773               find first buf_temp_grplib_found-grp
      774                   where buf_temp_grplib_found-grp.full-name begins p-end-name
      775                   and recid( buf_temp_grplib_found-grp ) <> recid( temp_grplib_found-grp )
      776               no-error.
      777               if not available buf_temp_grplib_found-grp
      778               then do:
      779                   run grplib-is-terminal in this-procedure (
      780                       input temp_grplib_found-grp.node-code
      781                       , output v-is-terminal
      782                   ).
      783               end.
      784           end.
      785       end.
      786   end.
      787   end procedure.
      788   procedure grplib-get-max-substring :
      789   do
      790   on error undo, return error
      791   :
      792   define input parameter p-min-substring-length   as integer      no-undo.
      793   define output parameter p-substring             as character    no-undo.
      794           define variable v-char-counter  as integer           no-undo.
      795           define variable v-current-char  as character         no-undo.
      796           define variable v-names-counter  as integer           no-undo.
      797           define variable v-base-string   as character         no-undo.
      798           assign
      799               v-char-counter  = p-min-substring-length
      800           .
      801           find first temp_grplib_found-grp no-error.
      802           if not available temp_grplib_found-grp
      803           then do:
      804               undo, return error "grplib-get-max-substring: Нет строк для вычисления общей подстроки".
      805           end.
      806           else do:
      807               assign
      808                   v-base-string  = temp_grplib_found-grp.full-name
      809                   v-char-counter = 0
      810               .
      811               counter-block:
      812               do while yes
      813               on error undo, return error "grplib-get-max-substring: Ошибка вычисления продолжения имени группы."
      814               :
      815                   assign
      816                       v-char-counter  = v-char-counter + 1
      817                       v-current-char  = substring( v-base-string, v-char-counter, 1 )
      818                       v-names-counter = 0
      819                   .
      820                   compare-block:
      821                   for each temp_grplib_found-grp
      822                   :
      823                       assign
      824                           v-names-counter = v-names-counter + 1
      825                       .
      826                       if v-names-counter = 1
      827                       then do:
      828                           next compare-block.
      829                       end.
      830                       if substring( temp_grplib_found-grp.full-name, v-char-counter, 1 ) <> v-current-char
      831                       then do:
      832                           leave counter-block.
      833                       end.
      834                   end.
      835                   if v-names-counter = 1
      836                   then do:
      837                       assign
      838                           p-substring = v-base-string
      839                       .
      840                       return.
      841                   end.
      842               end.
      843               assign
      844                   p-substring = substring( v-base-string, 1, v-char-counter - 1 )
      845               .
      846           end.
      847   end.
      848   end procedure.
      849   procedure grplib-is-terminal :
      850   do
      851   on error undo, return error "Ошибка процедуры grplib-is-terminal"
      852   :
      853   define input parameter p-node-code      as integer      no-undo.
      854   define output parameter p-is-terminal   as logical      no-undo.
      855       define buffer buf_gds-grp       for ub.gds-grp.
      856       find first buf_gds-grp no-lock
      857           where buf_gds-grp.upper-code = p-node-code
      858       no-error .
      859       if not available buf_gds-grp
      860       then do:
      861           assign
      862               p-is-terminal = yes
      863           .
      864       end.
      865       else do:
      866           assign
      867               p-is-terminal = no
      868           .
      869       end.
      870   end.
      871   end procedure.
      872   procedure grplib-have-goods :
      873   do
      874   on error undo, return error
      875   :
      876   define input parameter p-node-code      as integer      no-undo.
      877   define output parameter p-have-goods   as logical      no-undo.
      878       define buffer buf_goods         for ub.goods.
      879       find first buf_goods no-lock
      880            where buf_goods.grp-code = p-node-code
      881       no-error .
      882       if available buf_goods
      883       then do:
      884           assign
      885               p-have-goods = yes
      886           .
      887       end.
      888       else do:
      889           assign
      890               p-have-goods = no
      891           .
      892       end.
      893   end.
      894   end procedure.
      895   procedure grplib-find-by-substring :
      896   do
      897   on error undo, return error
      898   :
      899   define input parameter p-start-code         as integer      no-undo.
      900   define input parameter p-full-search-string as character    no-undo.
      901   define output parameter p-found-code        as integer      no-undo.
      902   define output parameter p-full-name         as character    no-undo.
      903       define variable v-start-code     as integer           no-undo.
      904       define variable v-found          as logical  init no  no-undo.
      905       define buffer buf_gds-grp       for ub.gds-grp.
      906       search-grp:
      907       for each buf_gds-grp no-lock
      908           where buf_gds-grp.node-code > p-start-code
      909       :
      910           if index( buf_gds-grp.node-name, p-full-search-string ) <> 0
      911           then do:
      912               assign
      913                   p-found-code = buf_gds-grp.node-code
      914                   v-found      = yes
      915               .
      916               run grplib-get-full-name in this-procedure (
      917                     input p-found-code
      918                   , output p-full-name
      919               ) no-error .
      920               if error-status :error
      921               then do:
      922                   undo, return error "grplib-find-by-substring: Ошибка вычисления полного имени группы." + chr(10) + return-value.
      923               end.
      924               leave search-grp.
      925           end.
      926       end.
      927       if v-found = yes
      928       then do:
      929       end.
      930       else do:
      931           assign
      932               p-full-name  = ""
      933               p-found-code = 0
      934           .
      935       end.
      936   end.
      937   end procedure.
      938   procedure grplib-analyze-grp-name :
      939   do
      940   on error undo, return error
      941   :
      942   define input parameter p-grp-name       as character            no-undo.
      943   define input parameter p-upper-code     as integer              no-undo.
      944   define output parameter p-error-message as character init ""    no-undo.
      945       define variable v-char-list     as character    no-undo.
      946       define variable v-char-counter  as integer      no-undo.
      947       define variable v-full-name     as character    no-undo.
      948       if p-grp-name = "" then do:
      949           assign
      950               p-error-message = "Название группы не может быть пустым.".
      951           .
      952       end.
      953       else do:
      954           assign
      955               v-char-list = "47,92,58,63,34,60,62,171,187,183"
      956           .
      957           do v-char-counter = 1 to num-entries( v-char-list )
      958           :
      959               if index( p-grp-name, chr( integer( entry( v-char-counter, v-char-list ) ) ) ) <> 0
      960               then do:
      961                   assign
      962                       p-error-message = 'Название группы не может содержать символы /\:*?"<>|«»·'
      963                   .
      964                   return.
      965               end.
      966           end.
      967           if p-upper-code > 0
      968           then do:
      969               run grplib-get-full-name in this-procedure (
      970                     input p-upper-code
      971                   , output v-full-name
      972               ) no-error .
      973               if error-status :error
      974               then do:
      975                   undo, return error "grplib-analyze-grp-name: Не удалось вычислить полное имя группы." + chr(10) + return-value.
      976               end.
      977               if length( v-full-name ) + 1 + length( p-grp-name ) > 350
      978               then do:
      979                   assign
      980                       p-error-message = 'Полное название группы не может содержать более 350 символов.'
      981                   .
      982               end.
      983           end.
      984       end.
      985   end.
      986   end procedure.
      987   procedure grplib-get-lvl-num :
      988   define input parameter p-node-code  as integer      no-undo.
      989   define output parameter p-lvl-num   as integer      no-undo.
      990       define variable v-full-name    as character    no-undo.
      991   do
      992   on error undo, return error
      993   :
      994       run grplib-get-full-name in this-procedure (
      995             input p-node-code
      996           , output v-full-name
      997       ).
      998       assign
      999           p-lvl-num = num-entries( v-full-name, chr(47) ) - 1
     1000       .
     1001       if p-lvl-num = -1
     1002       then do:
     1003           assign
     1004               p-lvl-num = 0
     1005           .
     1006       end.
     1007   end.
     1008   end procedure.
     1009   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1010     define variable v-cntxt-db-num        as integer   no-undo .
     1011     define variable v-cntxt-userid        as character no-undo .
     1012     define variable v-cntxt-level         as character no-undo .
     1013     define variable v-cntxt-host-code-obj as integer   no-undo .
     1014     define variable v-cntxt-obj-type      as character no-undo .
     1015     define variable v-cntxt-obj-code      as integer   no-undo .
     1016     define variable v-cntxt-db-num-obj    as integer   no-undo .
     1017     define variable v-cntxt-is-admin      as logical   no-undo .
     1018   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1019     run mainmenu_getcntxt in parparentproc
     1020       (output v-cntxt-db-num
     1021       ,output v-cntxt-userid
     1022       ,output v-cntxt-level
     1023       ,output v-cntxt-host-code-obj
     1024       ,output v-cntxt-obj-type
     1025       ,output v-cntxt-obj-code
     1026       ,output v-cntxt-db-num-obj
     1027       ,output v-cntxt-is-admin
     1028       ) .
     1029   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1030   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1031   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
     1032   define variable par-type          as character no-undo.
     1033   define variable v-value-character as character no-undo .
     1034   define variable v-value-date      as date      no-undo .
     1035   define variable v-value-decimal   as decimal   no-undo .
     1036   define variable v-value-integer   as integer   no-undo .
     1037   define variable v-value-logical   as logical   no-undo .
     1038   do
     1039   on error undo, return error
     1040   :
     1041     define variable g#report-num as integer   no-undo .
     1042     run get-report-num  in parParentProc ( output g#report-num ).
     1043     define variable g#gds-engl as logical   no-undo .
     1044     run get-gds-engl  in parParentProc ( output g#gds-engl ).
     1045     define variable g#log as logical   no-undo .
     1046     define variable g#quest-print as logical   no-undo .
     1047     run get-quest-print in parParentProc ( output g#quest-print ).
     1048     define shared variable sort-name   as logical no-undo.
     1049     define shared variable sort-gr     as logical no-undo.
     1050     define shared variable PrintScale  as logical no-undo .
     1051     define variable v-par-type as character no-undo .
     1052     define variable v-sort-prod         as character         no-undo.
     1053   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1054   empty temp-table thbjattr_thbj-attr.
     1055   run adm/shattri.p (
     1056      input "get":U
     1057     ,input ''
     1058     ,input 0
     1059     ,input 'prt-glob':U
     1060     ,input  ""
     1061     ,output v-value-character
     1062     ,output v-value-date
     1063     ,output v-value-decimal
     1064     ,output v-value-integer
     1065     ,output v-value-logical
     1066     ,output par-type
     1067     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     1068     ) no-error .
     1069     for each thbjattr_thbj-attr :
     1070         if thbjattr_thbj-attr.prop-code = 'sort-prd' then v-sort-prod = string( thbjattr_thbj-attr.property-value-logical) .
     1071     end.
     1072     define variable skod as logical   no-undo .
     1073     if sort-name = no then message "Сортировать по коду? (При ответе 'нет' сортировка по артикулу)."  VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE skod.
     1074     DEFINE temp-table temp-str no-undo
     1075       field   grp-name          as  char
     1076       field   gds-name          as  char
     1077       field   gds-code          as  integer
     1078       field   b-code            as character
     1079       field   artic             as  char
     1080       field   prod-type         as  char
     1081       field   prod-code         as  integer
     1082       field   unit-base         as  char
     1083       field   empty-scale       as logical
     1084       field   a-qnty            as decimal
     1085       field   b-qnty            as decimal
     1086       field   delta             as decimal
     1087       INDEX pi  IS PRIMARY   artic prod-type prod-code
     1088       INDEX pi1              gds-name
     1089       INDEX pi2              grp-name
     1090       INDEX pi3              delta DESCENDING
     1091     .
     1092     def stream Out-Stream.
     1093     def buffer buf_clients for  clients .
     1094     def buffer buf_doc-line     for doc-line .
     1095     def buffer buf_goods        for goods .
     1096     def buffer buf_doc-line-sum for doc-line-sum .
     1097     def buffer buf_gds-dtl      for gds-dtl .
     1098     define variable is-after      as logical initial yes no-undo .
     1099     define variable FullNameGds as character no-undo .
     1100     define variable gds-str as char no-undo.
     1101     define variable gds-str1 as char no-undo.
     1102     define variable gds-str2 as char no-undo.
     1103     define variable i as int no-undo.
     1104     define variable j as int no-undo.
     1105     define variable Counter1 as integer init 0  no-undo .
     1106     define variable b-code as integer   no-undo .
     1107     define variable prod as character no-undo .
     1108     define variable bl as character no-undo .
     1109     define variable Line       as char    no-undo.
     1110     define variable     tdoc-date     like trn-doc.doc-date no-undo.
     1111     define variable     tdoc-code     like trn-doc.doc-code no-undo.
     1112     define variable sym1 as char  init ":"   no-undo.
     1113     define variable sym2 as char  init ":"   no-undo.
     1114     define variable sym3 as char  init ":"   no-undo.
     1115     define variable sym4 as char  init ":"   no-undo.
     1116     define variable sym5 as char  init ":"   no-undo.
     1117     define variable sym6 as char  init ":"   no-undo.
     1118     define variable sym7 as char  init ":"   no-undo.
     1119     define variable sym8 as char  init ":"   no-undo.
     1120     define variable sym9 as char  init ":"   no-undo.
     1121     define variable sym10 as char  init ":"   no-undo.
     1122     DEFINE FRAME invent
     1123       sym1               column-label ":!:"                                format "X(1)"
     1124       temp-str.b-code    COLUMN-LABEL "Код товара! "                       format "X(9)" space(0)
     1125       sym2               column-label ":!:"                                format "X(1)"
     1126       temp-str.artic     column-label "  Артикул! "                        format "x(17)"
     1127       sym3               column-label ":!:"                                format "X(1)"
     1128       prod               column-label " Производитель! "                   format "X(18)"
     1129       sym4               column-label ":!:"                                format "X(1)"
     1130       temp-str.gds-name  column-label "       Наименование товара! "       format "X(40)"
     1131       sym5               column-label ":!:"                                format "X(1)"
     1132       temp-str.unit-base COLUMN-LABEL  "Ед.!изм."                          format "X(3)" space(0)
     1133       sym6               column-label ":!:"                                format "X(1)"
     1134       temp-str.b-qnty    column-label "Расчетное!значение по ТН"           format "->>>>>>>>9.<<<"
     1135       sym7               column-label ":!:"                                format "X(1)"
     1136       temp-str.a-qnty    column-label "Посчитаное!значение"                format "->>>>>>>>9.<<<"
     1137       sym8               column-label ":!:"                                format "X(1)"
     1138       temp-str.delta     column-label "Расхождение! "                      format "->>>>>>>>9.<<<"
     1139       sym9               column-label ":!:"                                format "X(1)"
     1140       bl                 column-label "Данные повтор.!пересчета"           format "X(14)"
     1141       sym10              column-label ":!:"                                format "X(1)"
     1142       HEADER
     1143         cur-time-print() AT 5 format "X(35)"
     1144         string( "Сличительная ведомость для пересчета N " + tdoc-code + " от " + string ( tdoc-date , "99/99/9999" ) ) AT 40 format "X(60)"
     1145         string( "Лист " + string( PAGE-NUMBER(Out-Stream) , ">>>>9") ) AT 145 format "X(13)" SKIP
     1146         Line format "X(165)" AT 1
     1147     with width 232 down stream-io use-text NO-BOX.
     1148     find first trn-doc no-lock where recid(trn-doc) = rec_id .
     1149     assign
     1150       tdoc-date = (if trn-doc.status_ <> 'факт':U then trn-doc.doc-date else trn-doc.fact-date)
     1151       tdoc-code = trn-doc.doc-code
     1152     .
     1153     run Check-Doc-Sum in this-procedure no-error  .
     1154     if error-status :error then return error .
     1155   output STREAM Out-Stream to value( string( session:temp-directory +
     1156                                        "rpt" + string( g#report-num ) ) )
     1157                                        page-size  value(43) .
     1158     assign  Line    = fill("-", 230) .
     1159     PUT stream Out-Stream UNFORMATTED  space(50) string( "Сличительная ведомость для пересчета " + tdoc-code + " от " + string( tdoc-date, "99/99/9999")
     1160        + (if trn-doc.status_ <> 'факт':U then string( "(" + CAPS(trn-doc.status_) + ")" ) else "")) format "X(100)" skip .
     1161   define variable v-account as integer init 0 no-undo .
     1162   define variable v-account-lavel as character no-undo .
     1163   define variable v-button-stop as logical no-undo .
     1164   define variable v-kol-spice as integer no-undo .
     1165   define variable v-kol-spice2 as integer no-undo .
     1166   define variable v-kol-spice3 as integer no-undo .
     1167   DEFINE VARIABLE StopProcessing AS LOGICAL NO-UNDO.
     1168   DEFINE BUTTON StopBtn AUTO-END-KEY
     1169        LABEL "Стоп"
     1170        SIZE 10 BY 1.
     1171   DEFINE VARIABLE RecordsDone AS INTEGER FORMAT ">,>>>,>>>,>>9":U INITIAL 0
     1172        LABEL "Обработано записей"
     1173         VIEW-AS TEXT
     1174        SIZE 14 BY .67 NO-UNDO.
     1175   DEFINE VARIABLE RecordsString AS CHARACTER FORMAT "X(60)"
     1176         VIEW-AS TEXT
     1177        SIZE 53.25 BY .67
     1178        FGCOLOR 1  NO-UNDO.
     1179   DEFINE VARIABLE RecordsString2 AS CHARACTER FORMAT "X(60)"
     1180         VIEW-AS TEXT
     1181        SIZE 53.25 BY .67
     1182        FGCOLOR 1  NO-UNDO.
     1183   DEFINE VARIABLE RecordsString3 AS CHARACTER FORMAT "X(60)"
     1184         VIEW-AS TEXT
     1185        SIZE 53.25 BY .67
     1186        FGCOLOR 1  NO-UNDO.
     1187   DEFINE RECTANGLE RECT-1
     1188        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1189        SIZE 55.13 BY 4.46.
     1190   DEFINE FRAME InfoFrame
     1191        StopBtn AT ROW 4.25 COL 21.75
     1192        RecordsString AT ROW 1.21 COL 2 NO-LABEL
     1193        RecordsString2 AT ROW 1.96 COL 2 NO-LABEL
     1194        RecordsString3 AT ROW 2.58 COL 2 NO-LABEL
     1195        RecordsDone AT ROW 3.42 COL 24.88 COLON-ALIGNED
     1196        RECT-1 AT ROW 1 COL 1
     1197       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1198            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1199            TITLE "Процесс"
     1200            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
     1201   define variable mFrameView      as logical   no-undo init yes.
     1202     define variable mFramHandle as handle no-undo.
     1203     mFramHandle = frame InfoFrame:handle.
     1204     if  log-manager:logfile-name ne ?
     1205     then DO:
     1206         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1207         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1208         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
     1209     end.
     1210     mFrameView = not session:batch-mode and mFramHandle:visible.
     1211     if mFrameView
     1212     then do:
     1213       ASSIGN
     1214          FRAME InfoFrame:HIDDEN                           = TRUE
     1215          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
     1216     end.
     1217   ON CHOOSE OF StopBtn IN FRAME InfoFrame
     1218   DO:
     1219     IF not StopProcessing THEN
     1220       Message "Вы действительно хотите прервать" SKIP
     1221               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
     1222                 UPDATE StopProcessing.
     1223     IF StopProcessing THEN do:
     1224        if mFrameView
     1225        then do:
     1226           HIDE FRAME InfoFrame.
     1227        end.
     1228     End.
     1229   END.
     1230   assign v-account = ( if integer( 25 ) = 0 then 100 else integer( 25 ) ).
     1231     if  log-manager:logfile-name ne ?
     1232     then DO:
     1233         log-manager:write-message("ON mFrameView=" + string(mFrameView), "frameRepError").
     1234     end.
     1235     if not session:batch-mode then
     1236     do:
     1237       VIEW FRAME InfoFrame.
     1238       mFrameView = true.
     1239     end.
     1240      v-button-stop = false .
     1241         if mFrameView
     1242         then do:
     1243         if v-button-stop then view STOPBTN in frame InfoFrame.
     1244                          else Hide STOPBTN in frame InfoFrame.
     1245         end.
     1246     define variable a-qnty as decimal   no-undo .
     1247     define variable b-qnty as decimal   no-undo .
     1248     define variable delta as decimal   no-undo .
     1249     for each buf_doc-line no-lock where buf_doc-line.doc-code = trn-doc.doc-code :
     1250       find first buf_goods no-lock
     1251         where buf_goods.prod-type = buf_doc-line.prod-type
     1252           and buf_goods.prod-code = buf_doc-line.prod-code
     1253           and buf_goods.artic     = buf_doc-line.artic
     1254       no-error .
     1255       assign Counter1 = Counter1 + 1.
     1256   IF ( Counter1 modulo v-account = 0 )  then DO:
     1257             if  log-manager:logfile-name ne ?
     1258             then DO:
     1259                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     1260             end.
     1261              if mFrameView
     1262              then do:
     1263               DISPLAY
     1264                 Counter1 @ RecordsDone
     1265                 WITH FRAME InfoFrame.
     1266              end.
     1267   End.
     1268      if v-button-stop then  DO:
     1269            if mFrameView
     1270            then
     1271               PROCESS EVENTS.
     1272            IF StopProcessing THEN DO:
     1273            RETURN error.
     1274            End.
     1275      end.
     1276   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     1277     (input  buf_goods.gds-code
     1278     ,input  ?
     1279     ,output b-code
     1280     ) no-error .
     1281       if error-status :error then do:
     1282         message vss-workfile vss-revision vss-description skip "Ошибка при определении бар-кода товара" skip
     1283           "Артикул товара" skip buf_goods.artic   view-as alert-box error .
     1284       end.
     1285       find first buf_doc-line-sum no-lock
     1286         where buf_doc-line-sum.doc-code = buf_doc-line.doc-code
     1287           and buf_doc-line-sum.gds-code = buf_goods.gds-code
     1288           and buf_doc-line-sum.sum-type = 'bd':U
     1289         no-error .
     1290       assign b-qnty      = buf_doc-line-sum.fact-qnty .
     1291       if is-after then do:
     1292         find first buf_doc-line-sum no-lock
     1293           where buf_doc-line-sum.doc-code = buf_doc-line.doc-code
     1294             and buf_doc-line-sum.gds-code = buf_goods.gds-code
     1295             and buf_doc-line-sum.sum-type = 'ad':U
     1296         no-error .
     1297         assign a-qnty      = buf_doc-line-sum.fact-qnty .
     1298       end.
     1299       else do:
     1300         assign a-qnty      = b-qnty + buf_doc-line.fact-qnty .
     1301       end.
     1302       assign delta = a-qnty - b-qnty .
     1303       if p-nonull = no or delta <> 0 then do:
     1304         create temp-str .
     1305         assign
     1306           temp-str.grp-name    = buf_goods.grp-name
     1307           temp-str.artic       = buf_goods.artic
     1308           temp-str.prod-type   = buf_goods.prod-type
     1309           temp-str.prod-code   = buf_goods.prod-code
     1310           temp-str.gds-code    = buf_goods.gds-code
     1311           temp-str.unit-base   = buf_goods.unit-base
     1312           temp-str.b-code      = string(b-code)
     1313           temp-str.a-qnty      = a-qnty
     1314           temp-str.b-qnty      = b-qnty
     1315           temp-str.delta       = delta
     1316         .
     1317         if g#gds-engl then assign temp-str.gds-name = buf_goods.engl-name.
     1318         else               assign temp-str.gds-name = buf_goods.gds-name.
     1319       end.
     1320     end.
     1321     if v-sort-prod = "yes" then do:
     1322       if sort-gr = yes then do:
     1323         for each temp-str no-lock break by temp-str.prod-type by temp-str.prod-code by temp-str.grp-name by if sort-name then  temp-str.gds-name Else ( if skod then  temp-str.b-code Else temp-str.artic ) :
     1324           if first-of( temp-str.prod-code) then run print-prod in this-procedure .
     1325           if first-of( temp-str.grp-name)  then run print-grp in this-procedure .
     1326           run print-line in this-procedure .
     1327         end.
     1328       end.
     1329       else do:
     1330         for each temp-str no-lock break by temp-str.prod-type by temp-str.prod-code by if sort-name then  temp-str.gds-name Else ( if skod then  temp-str.b-code Else temp-str.artic ) :
     1331           if first-of( temp-str.prod-code) then run print-prod in this-procedure .
     1332           run print-line in this-procedure .
     1333         end.
     1334       end.
     1335     end.
     1336     else do:
     1337       if sort-gr = yes then do:
     1338         for each temp-str no-lock break by temp-str.grp-name by if sort-name then  temp-str.gds-name Else ( if skod then  temp-str.b-code Else temp-str.artic ) :
     1339           if first-of( temp-str.grp-name) then run print-grp in this-procedure .
     1340           run print-line in this-procedure .
     1341         end.
     1342       end.
     1343       else do:
     1344         for each temp-str no-lock break by if sort-name then  temp-str.gds-name Else ( if skod then  temp-str.b-code Else temp-str.artic ) :
     1345           run print-line in this-procedure .
     1346         end.
     1347       end.
     1348     end.
     1349     PUT stream Out-Stream Line  FORMAT "X(165)"  skip  .
     1350     output stream Out-Stream CLOSE .
     1351   if mFrameView
     1352   then do:
     1353      HIDE FRAME InfoFrame.
     1354   end.
     1355   if g#quest-print = false
     1356   then do:
     1357     run adecomm/_osprint.p ( ?, string( session:temp-directory + "rpt" + string( g#report-num ) ),
     1358                                         7, (if 8 >= 8 then 2 else 0), 0, 0,
     1359                                         OUTPUT g#log ).
     1360   end.
     1361   else do:
     1362     os-command silent
     1363       value( "COPY /b " +
     1364         string( session:temp-directory) +  "$" + string( g#report-num ) + " + " +
     1365         string( session:temp-directory) + "rpt" + string( g#report-num ) + " " +
     1366         string( session:temp-directory) +  "$" + string( g#report-num )
     1367                 ) .
     1368     os-command silent
     1369       value( "COPY /b " +
     1370         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl" + " + " +
     1371         string( session:temp-directory) + "rpt" + string( g#report-num ) + ".txl" + " " +
     1372         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl"
     1373                 ) .
     1374   end.
     1375   end.
     1376   procedure print-grp :
     1377     do  on error undo, return error return-value  :
     1378       DOWN stream Out-Stream 1 with FRAME invent .
     1379       PUT stream Out-Stream UNFORMATTED String("_______________Группа : " + TRIM(CAPS(temp-str.grp-name)) + Line)  FORMAT "X(165)"  skip  .
     1380     end.
     1381   end procedure.
     1382   procedure print-prod :
     1383     do  on error undo, return error return-value  :
     1384       find first buf_clients no-lock
     1385         where buf_clients.obj-type = temp-str.prod-type
     1386           and buf_clients.obj-code = temp-str.prod-code
     1387       .
     1388       DOWN stream Out-Stream 1 with FRAME invent .
     1389       PUT stream Out-Stream UNFORMATTED String("________Производитель : " + TRIM(CAPS(buf_clients.obj-name)) + Line)  FORMAT "X(165)"  skip  .
     1390     end.
     1391   end procedure.
     1392   procedure print-line :
     1393     do on error undo, return error return-value :
     1394     if line-counter( out-stream ) + 2 > page-size( out-stream ) then page stream out-stream.
     1395     display stream Out-Stream
     1396       sym1    temp-str.b-code
     1397       sym2    temp-str.artic
     1398       sym3    (temp-str.prod-type + " " + string(temp-str.prod-code)) @ prod
     1399       sym4    temp-str.gds-name
     1400       sym5    temp-str.unit-base
     1401       sym6    temp-str.b-qnty
     1402       sym7    temp-str.a-qnty
     1403       sym8    temp-str.delta
     1404       sym9
     1405       sym10 with FRAME invent.
     1406     DOWN stream Out-Stream 1 with FRAME invent .
     1407     if print-graft = false THEN  Put stream Out-Stream Line format "X(165)" SKIP.
     1408     end.
     1409   end procedure.
     1410   procedure print-grp-itog :
     1411     do on error undo, return error return-value :
     1412     end.
     1413   end procedure.
     1414   procedure Check-Doc-Sum :
     1415     do  on error undo, return error return-value  :
     1416       define variable v-attr-value as character no-undo .
     1417       define variable v-attr-type as character no-undo .
     1418       define variable ask as logical   no-undo .
     1419   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input trn-doc.doc-code ,
     1420                           input 'addsum':U ,
     1421                          output v-attr-value ,
     1422                          output v-attr-type )  .
     1423       if trn-doc.status_ = 'факт':U then do:
     1424         if lookup( 'bd':U, v-attr-value ) = 0 or
     1425            lookup( 'ad':U, v-attr-value ) = 0  then run utl/uaddsum.p (trn-doc.doc-code, no, ?, ?) no-error  .
     1426         if error-status :error then  message return-value error-status :GET-MESSAGE( 1 )  view-as alert-box error .
     1427       end.
     1428       else do:
     1429         if lookup( 'bd':U, v-attr-value ) = 0 then do:
     1430           message "Не рассчитаны данные до начала инвентаризации!" view-as alert-box.
     1431           undo, return error .
     1432         end.
     1433         if lookup( 'ad':U, v-attr-value ) = 0  then assign is-after = no .
     1434       End.
     1435     end.
     1436   end procedure.
