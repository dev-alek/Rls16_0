      483       ,output v-cntxt-userid
      484       ,output v-cntxt-level
      485       ,output v-cntxt-host-code-obj
      486       ,output v-cntxt-obj-type
      487       ,output v-cntxt-obj-code
      488       ,output v-cntxt-db-num-obj
      489       ,output v-cntxt-is-admin
      490       ) .
      491   define variable vss-include-info4 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      492   do:
      493     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      494       (input  v-cntxt-db-num
      495       ,input  v-cntxt-userid
      496       ,input  0
      497       ,input  'actn_cur-obj-proceeds_print':U
      498       ,input  'firm':U
      499       ,input  v-cntxt-host-code-obj
      500       ,input  '':U
      501       ,input  0
      502       ,input  0
      503       ,input  0
      504       ,input  0
      505       ,input  true
      506       ,output glog
      507       )  .
      508   end.
      509   if not glog then return.
      510   custom-par = "shop,4,1" + chr(44) +
      511                custom-par.
      512   run rep/d-report.w (
      513                        input parparentproc
      514                       ,input 'rep/e-ptrlch.w'
      515                       ,input 'Технологический отчет по ТРК'
      516                       ,input 4
      517                       ,input '':U
      518                       ,input "*"
      519                       ,input ""
      520                       ,input '':U
      521                       ,input custom-par
      522                       ,input no).
