     2301   function is-gas returns logical
     2302           (input p-gds-code as integer):
     2303   define variable result as logical no-undo.
     2304   define variable c-value as character no-undo.
     2305   define variable c-type as character no-undo.
     2306   do on error undo, return error:
     2307           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     2308         (input  p-gds-code
     2309         ,input  'fuel-type':U
     2310         ,output c-value
     2311         ,output c-type) no-error.
     2312   end.
     2313   result = logical(c-value = 'metan':U) no-error.
     2314   return result.
     2315   end function.
     2316   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2317   define new global shared variable g#trdcalib as handle no-undo.
     2318   procedure placelib_write-attr:
     2319   define input  parameter p-code     like ub.place-attr.attr-code .
     2320   define input  parameter p-obj-code like ub.place-attr.obj-code .
     2321   define input  parameter p-obj-type like ub.place-attr.obj-type .
     2322   define input  parameter p-pl-code  like ub.place-attr.pl-code .
     2323   define input  parameter p-value    like ub.place-attr.attr-value .
     2324   define output parameter p-ok       as logical.
     2325   define buffer buf_place-attr for ub.place-attr .
     2326     do on error undo, return error return-value :
     2327        p-ok = false.
     2328        find first buf_place-attr exclusive-lock where buf_place-attr.attr-code   = p-code
     2329                                                   and buf_place-attr.obj-code    = p-obj-code
     2330                                                   and buf_place-attr.obj-type    = p-obj-type
     2331                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
     2332        if not available buf_place-attr then do :
     2333           create buf_place-attr.
     2334           assign
     2335             buf_place-attr.attr-code   = p-code
     2336             buf_place-attr.attr-value  = p-value
     2337             buf_place-attr.obj-code    = p-obj-code
     2338             buf_place-attr.obj-type    = p-obj-type
     2339             buf_place-attr.pl-code     = p-pl-code
     2340           .
     2341           p-ok = true.
     2342        end.
     2343        else do:
     2344           buf_place-attr.attr-value  = p-value .
     2345           p-ok = true.
     2346        end.
     2347     end.
     2348   end.
     2349   procedure placelib_get-attr:
     2350   define input  parameter  p-code     like ub.place-attr.attr-code .
     2351   define input  parameter  p-obj-code like ub.place-attr.obj-code .
     2352   define input  parameter  p-obj-type like ub.place-attr.obj-type .
     2353   define input  parameter  p-pl-code  like ub.place-attr.pl-code .
     2354   define output parameter  p-value    like ub.place-attr.attr-value .
     2355   define output parameter  p-ok       as logical.
     2356   define buffer buf_place-attr for ub.place-attr .
     2357     do on error undo, return error return-value :
     2358        p-ok = false.
     2359        find first buf_place-attr no-lock where buf_place-attr.attr-code   = p-code
     2360                                                   and buf_place-attr.obj-code    = p-obj-code
     2361                                                   and buf_place-attr.obj-type    = p-obj-type
     2362                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
     2363        if available buf_place-attr then do :
     2364          p-value = buf_place-attr.attr-value.
     2365          p-ok = true.
     2366        end.
     2367        else do :
     2368          p-ok = false.
     2369        end.
     2370     end.
     2371   end.
     2372   procedure placelib_del-attr:
     2373   define input parameter  p-code     like ub.place-attr.attr-code .
     2374   define input parameter  p-obj-code like ub.place-attr.obj-code .
     2375   define input parameter  p-obj-type like ub.place-attr.obj-type .
     2376   define input parameter  p-pl-code  like ub.place-attr.pl-code .
     2377   define input parameter  p-value    like ub.place-attr.attr-value .
     2378   define output parameter p-ok       as logical.
     2379   define buffer buf_place-attr for ub.place-attr .
     2380     do on error undo, return error return-value :
     2381        p-ok = false.
     2382        find first buf_place-attr exclusive-lock where buf_place-attr.attr-code   = p-code
     2383                                                   and buf_place-attr.obj-code    = p-obj-code
     2384                                                   and buf_place-attr.obj-type    = p-obj-type
     2385                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
     2386        if available buf_place-attr then do :
     2387           delete buf_place-attr.
     2388           p-ok = true.
     2389        end.
     2390     end.
     2391   end.
     2392   define temp-table with-action no-undo
     2393   field f_name as character
     2394   field l_name as character
     2395   field v_old as character
     2396   field v_new as character
     2397   field t_name as character
     2398   field num_ as integer
     2399   field uniq-key-rec as character
     2400   field action as integer
     2401   field fNotChange as logical
     2402   index pi is unique primary
     2403   num_
     2404   t_name
     2405   f_name
     2406   index
     2407   Chan
     2408   fnotChange
     2409   t_name
     2410   f_name
     2411   index imain uniq-key-rec
     2412   .
     2413   procedure c-place_get-attr :
     2414     define input parameter attr-code as character no-undo .
     2415     define input parameter obj-code as integer no-undo .
     2416     define input parameter obj-type as character no-undo .
     2417     define input parameter pl-code as integer no-undo .
     2418     define input parameter endDate as date no-undo .
     2419     define input parameter endTime as integer no-undo .
     2420     define output parameter attr-value as character no-undo .
     2421     define buffer bf_c-place-attr for ub.c-place-attr .
     2422     define variable is-place-attr as logical no-undo .
     2423     find last bf_c-place-attr no-lock where bf_c-place-attr.pl-code = pl-code and
     2424       bf_c-place-attr.obj-code = obj-code and
     2425       bf_c-place-attr.obj-type = obj-type and
     2426       bf_c-place-attr.attr-code = attr-code and
     2427       ((bf_c-place-attr.corr-date = endDate and
     2428       bf_c-place-attr.corr-time < endTime) or
     2429       bf_c-place-attr.corr-date < endDate) no-error .
     2430     if available (bf_c-place-attr) then attr-value = bf_c-place-attr.attr-value .
     2431     else attr-value = "true" .
     2432   end procedure.
     2433   FUNCTION get_max-qnty returns decimal (
     2434     input obj-code as integer,
     2435     input obj-type as character,
     2436     input pl-code as integer,
     2437     input endDate as date,
     2438     input endTime as integer ):
     2439     define buffer bf_c-place     for ub.c-place .
     2440     define buffer buf_c-place    for ub.c-place .
     2441     define buffer bf_place       for ub.place .
     2442     define buffer curr_c-place   for c-place .
     2443     define buffer buf_c-plc-hist for ub.c-plc-hist .
     2444     define variable ii      as integer no-undo init 0.
     2445     define variable is-max-qnty as logical no-undo .
     2446     define variable is-true as logical no-undo .
     2447     find last curr_c-place no-lock where curr_c-place.pl-code = pl-code and
     2448       curr_c-place.obj-code = obj-code and
     2449       curr_c-place.obj-type = obj-type and
     2450       ((curr_c-place.corr-date = endDate and
     2451       curr_c-place.corr-time < endTime) or
     2452       curr_c-place.corr-date < endDate) no-error .
     2453     if available (curr_c-place) then
     2454     do:
     2455       find first buf_c-plc-hist no-lock where
     2456         buf_c-plc-hist.obj-type = obj-type
     2457         AND buf_c-plc-hist.obj-code = obj-code
     2458         AND buf_c-plc-hist.pl-code = pl-code
     2459         AND buf_c-plc-hist.subject  = "place"
     2460         and buf_c-plc-hist.chip-num = curr_c-place.chip-num no-error .
     2461       if available (buf_c-plc-hist) then
     2462       do:
     2463         define variable v-label-param as character no-undo .
     2464         v-label-param =
     2465           "max-qnty" + chr(4) + "Максимальное количество" + chr(4) + "" .
     2466         run proc-full-temp-changes in this-procedure (
     2467           input buf_c-plc-hist.action = integer('1':U)
     2468           ,input buf_c-plc-hist.action = integer('99':U)
     2469           ,input  buffer curr_c-place:handle
     2470           ,input  'place':U
     2471           ,input  "max-qnty"
     2472           ,input  v-label-param).
     2473       end.
     2474     end.
     2475     for each with-action:
     2476       return decimal(with-action.v_new) .
     2477     end.
     2478     if available (curr_c-place) then
     2479     do:
     2480       return curr_c-place.max-qnty .
     2481     end.
     2482     find first bf_place no-lock where bf_place.pl-code = pl-code and
     2483       bf_place.obj-code = obj-code and
     2484       bf_place.obj-type = obj-type no-error .
     2485     return bf_place.max-qnty .
     2486   end function.
     2487   FUNCTION get_meas returns logical (
     2488     input obj-code as integer,
     2489     input obj-type as character,
     2490     input pl-code as integer,
     2491     input endDate as date,
     2492     input endTime as integer ):
     2493     define buffer bf_c-place     for ub.c-place .
     2494     define buffer buf_c-place    for ub.c-place .
     2495     define buffer bf_place       for ub.place .
     2496     define buffer curr_c-place   for c-place .
     2497     define buffer buf_c-plc-hist for ub.c-plc-hist .
     2498     define variable ii      as integer no-undo init 0.
     2499     define variable is-meas as logical no-undo .
     2500     define variable is-true as logical no-undo .
     2501     find last curr_c-place no-lock where curr_c-place.pl-code = pl-code and
     2502       curr_c-place.obj-code = obj-code and
     2503       curr_c-place.obj-type = obj-type and
     2504       ((curr_c-place.corr-date = endDate and
     2505       curr_c-place.corr-time < endTime) or
     2506       curr_c-place.corr-date < endDate) no-error .
     2507     if available (curr_c-place) then
     2508     do:
     2509       find first buf_c-plc-hist no-lock where
     2510         buf_c-plc-hist.obj-type = obj-type
     2511         AND buf_c-plc-hist.obj-code = obj-code
     2512         AND buf_c-plc-hist.pl-code = pl-code
     2513         AND buf_c-plc-hist.subject  = "place"
     2514         and buf_c-plc-hist.chip-num = curr_c-place.chip-num no-error .
     2515       if available (buf_c-plc-hist) then
     2516       do:
     2517         define variable v-label-param as character no-undo .
     2518         v-label-param =
     2519           "is-meas" + chr(4) + "Измеряется приборами" + chr(4) + "" .
     2520         run proc-full-temp-changes in this-procedure (
     2521           input buf_c-plc-hist.action = integer('1':U)
     2522           ,input buf_c-plc-hist.action = integer('99':U)
     2523           ,input  buffer curr_c-place:handle
     2524           ,input  'place':U
     2525           ,input  "is-meas"
     2526           ,input  v-label-param).
     2527       end.
     2528     end.
     2529     for each with-action:
     2530       return logical (with-action.v_new) .
     2531     end.
     2532     find first bf_place no-lock where bf_place.pl-code = pl-code and
     2533       bf_place.obj-code = obj-code and
     2534       bf_place.obj-type = obj-type no-error .
     2535     return bf_place.is-meas .
     2536   end function.
     2537   FUNCTION get_com-vessel returns logical (
     2538     input obj-code as integer,
     2539     input obj-type as character,
     2540     input attr-code as character,
     2541     input pl-code as integer,
     2542     input openDate as date,
     2543     input endDate as date,
     2544     input openTime as integer,
     2545     input endTime as integer ):
     2546     define buffer current_c-place-attr for c-place-attr .
     2547     define buffer buf_c-plc-hist       for ub.c-plc-hist .
     2548     define variable ii      as integer   no-undo init 0.
     2549     define variable is-meas as logical   no-undo .
     2550     define variable is-true as logical   no-undo .
     2551     define variable v-label as character no-undo .
     2552     define variable p-ok    as logical   no-undo .
     2553     find last current_c-place-attr no-lock where
     2554       current_c-place-attr.obj-type = obj-type
     2555       AND current_c-place-attr.obj-code = obj-code
     2556       AND current_c-place-attr.pl-code = pl-code
     2557       and current_c-place-attr.attr-code = attr-code
     2558       and ((current_c-place-attr.corr-date = endDate
     2559       and current_c-place-attr.corr-time < endTime) or
     2560       current_c-place-attr.corr-date < endDate)
     2561       no-error .
     2562     if avail current_c-place-attr then
     2563     do:
     2564       find first buf_c-plc-hist no-lock where
     2565         buf_c-plc-hist.obj-type = obj-type
     2566         AND buf_c-plc-hist.obj-code = obj-code
     2567         AND buf_c-plc-hist.pl-code = pl-code
     2568         AND buf_c-plc-hist.subject  = "place-attr"
     2569         and buf_c-plc-hist.chip-num = current_c-place-attr.chip-num no-error .
     2570       if available (buf_c-plc-hist) then
     2571       do:
     2572         define variable v-label-param as character no-undo .
     2573         if current_c-place-attr.attr-code = "place-SI"
     2574           or current_c-place-attr.attr-code = "place-SI-temp"
     2575           or current_c-place-attr.attr-code = "place-SI-dens"
     2576           or current_c-place-attr.attr-code = "place-SI-level"
     2577           then
     2578         do :
     2579           v-label-param =
     2580             "attr-value" + chr(4) + "Значение атрибута" + chr(4) + "getSIname" + chr(8)
     2581             + "attr-code" + chr(4) + "Код атрибута" + chr(4) + "getPlaceAttrCode"   .
     2582         end .
     2583         else
     2584         do :
     2585           v-label-param =
     2586             "attr-value" + chr(4) + "Значение атрибута" + chr(4) + "getPlaceAttrValue" + chr(8)
     2587             + "attr-code" + chr(4) + "Код атрибута" + chr(4) + "getPlaceAttrCode" + chr(8)
     2588             + "PS" + chr(4) + "Примечание" + chr(4) + "" + chr(8)
     2589             + "status_" + chr(4) + "Статус" + chr(4) + ""  .
     2590         end .
     2591         run proc-full-temp-changes in this-procedure (
     2592           input buf_c-plc-hist.action = integer('1':U)
     2593           ,input buf_c-plc-hist.action = integer('99':U)
     2594           ,input  buffer current_c-place-attr:handle
     2595           ,input  'place-attr':U
     2596           ,input  "attr-code,attr-value,PS,status_"
     2597           ,input  v-label-param).
     2598       end.
     2599     end.
     2600     for each with-action:
     2601       p-ok = logical (with-action.v_new) no-error .
     2602       if error-status:error then p-ok = false .
     2603       return   p-ok .
     2604     end.
     2605     return no .
     2606   end function.
     2607   FUNCTION get_com-tanks returns character (
     2608     input obj-code as integer,
     2609     input obj-type as character,
     2610     input attr-code as character,
     2611     input pl-code as integer,
     2612     input openDate as date,
     2613     input endDate as date,
     2614     input openTime as integer,
     2615     input endTime as integer ):
     2616     define buffer current_c-place-attr for ub.c-place-attr .
     2617       define buffer buf_c-plc-hist       for ub.c-plc-hist .
     2618     define variable ii        as integer   no-undo init 0.
     2619     define variable is-meas   as logical   no-undo .
     2620     define variable is-true   as logical   no-undo .
     2621     define variable v-label   as character no-undo .
     2622     define variable p-ok as character no-undo .
     2623     find last current_c-place-attr no-lock where
     2624       current_c-place-attr.obj-type = obj-type
     2625       AND current_c-place-attr.obj-code = obj-code
     2626       AND current_c-place-attr.pl-code = pl-code
     2627       and current_c-place-attr.attr-code = attr-code
     2628       and ((current_c-place-attr.corr-date = endDate
     2629       and current_c-place-attr.corr-time < endTime) or
     2630       current_c-place-attr.corr-date < endDate)
     2631       no-error .
     2632     if avail current_c-place-attr then
     2633     do:
     2634       find first buf_c-plc-hist no-lock where
     2635         buf_c-plc-hist.obj-type = obj-type
     2636         AND buf_c-plc-hist.obj-code = obj-code
     2637         AND buf_c-plc-hist.pl-code = pl-code
     2638         AND buf_c-plc-hist.subject  = "place-attr"
     2639         and buf_c-plc-hist.chip-num = current_c-place-attr.chip-num no-error .
     2640       if available (buf_c-plc-hist) then
     2641       do:
     2642         define variable v-label-param as character no-undo .
     2643         if current_c-place-attr.attr-code = "place-SI"
     2644           or current_c-place-attr.attr-code = "place-SI-temp"
     2645           or current_c-place-attr.attr-code = "place-SI-dens"
     2646           or current_c-place-attr.attr-code = "place-SI-level"
     2647           then
     2648         do :
     2649           v-label-param =
     2650             "attr-value" + chr(4) + "Значение атрибута" + chr(4) + "getSIname" + chr(8)
     2651             + "attr-code" + chr(4) + "Код атрибута" + chr(4) + "getPlaceAttrCode"   .
     2652         end .
     2653         else
     2654         do :
     2655           v-label-param =
     2656             "attr-value" + chr(4) + "Значение атрибута" + chr(4) + "getPlaceAttrValue" + chr(8)
     2657             + "attr-code" + chr(4) + "Код атрибута" + chr(4) + "getPlaceAttrCode" + chr(8)
     2658             + "PS" + chr(4) + "Примечание" + chr(4) + "" + chr(8)
     2659             + "status_" + chr(4) + "Статус" + chr(4) + ""  .
     2660         end .
     2661         run proc-full-temp-changes in this-procedure (
     2662           input buf_c-plc-hist.action = integer('1':U)
     2663           ,input buf_c-plc-hist.action = integer('99':U)
     2664           ,input  buffer current_c-place-attr:handle
     2665           ,input  'place-attr':U
     2666           ,input  "attr-code,attr-value,PS,status_"
     2667           ,input  v-label-param).
     2668       end.
     2669     end.
     2670     for each with-action:
     2671        p-ok = with-action.v_new no-error .
     2672        if error-status:error then p-ok = "" .
     2673       return   p-ok .
     2674     end.
     2675     return "" .
     2676   end function.
     2677   function getSIname returns character (si-code as char) :
     2678     for first sr-izmerenia no-lock where sr-izmerenia.node-code = integer(si-code) :
     2679       return sr-izmerenia.sr-model .
     2680     end .
     2681   end .
     2682   function  getPlaceAttrCode returns character (istr as char ):
     2683     define variable OStr as character no-undo.
     2684     if istr eq "disable-level-alarm"
     2685       then
     2686       OStr = "Сообщения о переполнении".
     2687     else if istr eq "disable-water-alarm"
     2688         then
     2689         OStr = "Сообщения по воде".
     2690       else if istr eq "place-need-RVD-rvs"
     2691           then
     2692           OStr = "Необходимо сделать сверку с РВД".
     2693         else if istr eq "place-SI-level"
     2694             then
     2695             OStr = "Доп. средство измерения уровня".
     2696           else if istr eq "place-SI-dens"
     2697               then
     2698               OStr = "Доп. средство измерения плотности".
     2699             else if istr eq "place-SI-temp"
     2700                 then
     2701                 OStr = "Доп. средство измерения температуры".
     2702               else if istr eq "place-SI"
     2703                   then
     2704                   OStr = "Основное средство измерения".
     2705                 else
     2706                   OStr = istr.
     2707     return OStr.
     2708   end.
     2709   function  getPlaceAttrValue returns character (istr as char ):
     2710     define variable OStr  as character no-undo.
     2711     define variable vFlag as logical   no-undo.
     2712     if    entry(1,istr,chr(4)) eq "enable"
     2713       then
     2714       assign
     2715         OStr  = "Включено"
     2716         vFlag = yes
     2717         .
     2718     else if    entry(1,istr,chr(4)) eq "disable"
     2719         then
     2720         assign
     2721           OStr  = "Выключено"
     2722           vFlag = yes
     2723           .
     2724       else
     2725         OStr = istr.
     2726     if     vFlag
     2727       and num-entries (istr,chr(4)) > 2
     2728       then
     2729       OStr = OStr + " для смены № " + entry(3,istr,chr(4)) + " Дата " + entry(2,istr,chr(4)).
     2730     return OStr.
     2731   end.
     2732   PROCEDURE proc-full-temp-changes :
     2733     define input  parameter p-act-create as logical   no-undo .
     2734     define input  parameter p-act-delete as logical   no-undo .
     2735     define input  parameter p-hst-handle as handle    no-undo .
     2736     define input  parameter p-main-table as character no-undo .
     2737     define input  parameter p-field-list as character no-undo .
     2738     define input  parameter p-label-form as character no-undo .
     2739     define variable h-new-buf         as handle    no-undo .
     2740     define variable h-main-buf        as handle    no-undo .
     2741     define variable h-for-comp        as handle    no-undo .
     2742     define variable v-inform          as character no-undo .
     2743     define variable v-ind             as integer   no-undo .
     2744     define variable v-idx-field-qnty  as integer   no-undo .
     2745     define variable v-num-entries     as integer   no-undo .
     2746     define variable fh                as handle    no-undo .
     2747     define variable fh-main           as handle    no-undo .
     2748     define variable fh-old            as handle    no-undo .
     2749     define variable fh-new            as handle    no-undo .
     2750     define variable v-field-name      as character no-undo .
     2751     define variable v-field-lvl       as character no-undo .
     2752     define variable v-field-form      as character no-undo .
     2753     define variable v-search-exp      as character no-undo .
     2754     define variable v-srch-main       as character no-undo .
     2755     define variable v-word-link       as character no-undo .
     2756     define variable v-av-chip-num     as logical   no-undo .
     2757     define variable v-main-pi-fld-lst as character no-undo .
     2758     define variable v-main-fld-lst    as character no-undo .
     2759     define variable v-delim-list      as character no-undo .
     2760     define variable v-label           as character no-undo .
     2761     define variable v-old-value       as character no-undo case-sensitive.
     2762     define variable v-new-value       as character no-undo case-sensitive.
     2763     define variable v-chg-fields      as character no-undo.
     2764     for each with-action:
     2765       delete with-action.
     2766     end.
     2767     if not p-hst-handle:available then
     2768     do:
     2769       return .
     2770     end.
     2771     create buffer h-new-buf  for table p-hst-handle .
     2772     create buffer h-main-buf for table p-main-table .
     2773     assign
     2774       v-inform = h-main-buf:index-information(1)
     2775       v-ind    = 2
     2776       .
     2777     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     2778       on error undo, return error
     2779       :
     2780       assign
     2781         v-inform = h-main-buf:index-information( v-ind )
     2782         v-ind    = v-ind + 1
     2783         .
     2784     end.
     2785     if v-inform = ?
     2786       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     2787       or entry( 3, v-inform, ",":U ) <> "1":U
     2788       then
     2789     do:
     2790       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, h-main-buf:name ).
     2791     end.
     2792     assign
     2793       v-idx-field-qnty = num-entries( v-inform ) - 4
     2794       .
     2795     if v-idx-field-qnty < 2 then
     2796     do:
     2797       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, h-main-buf:name ).
     2798     end.
     2799     assign
     2800       v-srch-main   = "where":U
     2801       v-word-link   = "":U
     2802       v-av-chip-num = false
     2803       v-delim-list  = "":U
     2804       .
     2805     do v-ind = 1 to v-idx-field-qnty by 2
     2806       on error undo, return error
     2807       :
     2808       assign
     2809         v-field-name      = entry( 4 + v-ind, v-inform, ",":U )
     2810         fh                = p-hst-handle:buffer-field( v-field-name )
     2811         fh-main           = h-main-buf:buffer-field( v-field-name )
     2812         v-srch-main       = substitute( "&1 &2 &3.&4 =", v-srch-main, v-word-link, fh-main:table, v-field-name )
     2813         v-main-pi-fld-lst = v-main-pi-fld-lst + v-delim-list + v-field-name
     2814         .
     2815       if fh:data-type ="character":U then
     2816       do:
     2817         assign
     2818           v-srch-main = substitute( '&1 "&2"', v-srch-main, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     2819           .
     2820       end.
     2821       else
     2822       do:
     2823         assign
     2824           v-srch-main = substitute( "&1 &2", v-srch-main, fh:buffer-value() )
     2825           .
     2826       end.
     2827       if v-delim-list = "":U then
     2828       do:
     2829         assign
     2830           v-delim-list = ",":U
     2831           .
     2832       end.
     2833       if v-word-link = "":U then
     2834       do:
     2835         assign
     2836           v-word-link = "and":U
     2837           .
     2838       end.
     2839     end.
     2840     assign
     2841       v-delim-list = "":U
     2842       .
     2843     do v-ind = 1 to h-main-buf:num-fields
     2844       on error undo, return error
     2845       :
     2846       assign
     2847         fh-main      = h-main-buf:buffer-field( v-ind )
     2848         v-field-name = fh-main:name
     2849         .
     2850       assign
     2851         v-main-fld-lst = v-main-fld-lst + v-delim-list + v-field-name
     2852         .
     2853       if v-delim-list = "":U then
     2854       do:
     2855         assign
     2856           v-delim-list = ",":U
     2857           .
     2858       end.
     2859     end.
     2860     assign
     2861       v-inform = p-hst-handle:index-information(1)
     2862       v-ind    = 2
     2863       .
     2864     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     2865       on error undo, return error
     2866       :
     2867       assign
     2868         v-inform = p-hst-handle:index-information( v-ind )
     2869         v-ind    = v-ind + 1
     2870         .
     2871     end.
     2872     if v-inform = ?
     2873       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     2874       or entry( 3, v-inform, ",":U ) <> "1":U
     2875       then
     2876     do:
     2877       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, p-hst-handle:name ).
     2878     end.
     2879     assign
     2880       v-idx-field-qnty = num-entries( v-inform ) - 4
     2881       .
     2882     if v-idx-field-qnty < 2 then
     2883     do:
     2884       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, p-hst-handle:name ).
     2885     end.
     2886     assign
     2887       v-search-exp  = "where":U
     2888       v-word-link   = "":U
     2889       v-av-chip-num = false
     2890       .
     2891     do v-ind = 1 to v-idx-field-qnty by 2
     2892       on error undo, return error
     2893       :
     2894       assign
     2895         v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     2896         fh           = p-hst-handle:buffer-field( v-field-name )
     2897         v-search-exp = substitute( "&1 &2 &3.&4", v-search-exp, v-word-link, fh:table, v-field-name )
     2898         .
     2899       if v-field-name = "chip-num":U then
     2900       do:
     2901         assign
     2902           v-search-exp  = substitute( "&1 >", v-search-exp )
     2903           v-av-chip-num = true
     2904           .
     2905       end.
     2906       else
     2907       do:
     2908         assign
     2909           v-search-exp = substitute( "&1 =", v-search-exp )
     2910           .
     2911       end.
     2912       if fh:data-type ="character":U then
     2913       do:
     2914         assign
     2915           v-search-exp = substitute( '&1 "&2"', v-search-exp, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     2916           .
     2917       end.
     2918       else
     2919       do:
     2920         assign
     2921           v-search-exp = substitute( '&1 &2', v-search-exp, fh:buffer-value() )
     2922           .
     2923       end.
     2924       if v-word-link = "":U then
     2925       do:
     2926         assign
     2927           v-word-link = "and":U
     2928           .
     2929       end.
     2930     end.
     2931     if v-av-chip-num = false then
     2932     do:
     2933       message
     2934         vss-workfile vss-revision vss-description skip
     2935         substitute( "Таблица &2 не содержит поля chip-num.", vss-workfile, p-hst-handle:name ) skip
     2936         "Использование данной процедуры невозможно!" skip
     2937         view-as alert-box error .
     2938       return error .
     2939     end.
     2940     h-new-buf:find-first( v-search-exp, no-lock ) no-error .
     2941     if not h-new-buf:available then
     2942     do:
     2943       h-main-buf:find-first( v-srch-main, no-lock ) no-error .
     2944       if not h-main-buf:available then
     2945       do:
     2946         assign
     2947           h-for-comp = ?
     2948           .
     2949       end.
     2950       else
     2951       do:
     2952         assign
     2953           h-for-comp = h-main-buf
     2954           .
     2955       end.
     2956     end.
     2957     else
     2958     do:
     2959       assign
     2960         h-for-comp = h-new-buf
     2961         .
     2962     end.
     2963     assign
     2964       v-num-entries = num-entries( v-main-fld-lst, ",":U )
     2965       .
     2966     do v-ind = 1 to v-num-entries
     2967       on error undo, return error return-value
     2968       :
     2969       assign
     2970         v-field-name = entry( v-ind, v-main-fld-lst )
     2971         fh-old       = p-hst-handle:buffer-field( v-field-name )
     2972         v-old-value  = fh-old:buffer-value()
     2973         v-label      = trim( fh-old:label )
     2974         .
     2975       if ( trim( p-field-list ) <> "":U
     2976         and lookup( v-field-name, p-field-list ) > 0
     2977         )
     2978         or trim( p-field-list ) = "":U
     2979         then
     2980       do:
     2981         if h-for-comp <> ? then
     2982         do:
     2983           assign
     2984             fh-new      = h-for-comp:buffer-field( v-field-name )
     2985             v-new-value = fh-new:buffer-value()
     2986             .
     2987         end.
     2988         else
     2989         do:
     2990           assign
     2991             v-new-value = "":U
     2992             .
     2993         end.
     2994         if p-act-create = true then
     2995         do:
     2996           assign
     2997             v-old-value = "":U
     2998             .
     2999         end.
     3000         if p-act-delete = true then
     3001         do:
     3002           assign
     3003             v-new-value = "":U
     3004             .
     3005         end.
     3006         if v-old-value <> v-new-value
     3007           then
     3008         do:
     3009           create with-action.
     3010           assign
     3011             with-action.t_name     = p-main-table
     3012             with-action.f_name     = v-field-name
     3013             with-action.l_name     = replace( v-label, "&":U, "":U )
     3014             with-action.v_old      = trim( v-old-value )
     3015             with-action.v_new      = trim( v-new-value )
     3016             with-action.num_       = 0
     3017             with-action.fNotChange = v-old-value eq v-new-value
     3018             .
     3019         end.
     3020       end.
     3021     end.
     3022     assign
     3023       v-num-entries = num-entries( p-label-form, chr(8) )
     3024       .
     3025     do v-ind = 1 to v-num-entries
     3026       on error undo, return error return-value
     3027       :
     3028       if num-entries( entry( v-ind, p-label-form, chr(8) ), chr(4) ) = 3 then
     3029       do:
     3030         assign
     3031           v-field-name = entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     3032           v-field-lvl  = entry( 2, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     3033           v-field-form = entry( 3, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     3034           .
     3035         find first with-action
     3036           where with-action.f_name = v-field-name
     3037           no-error .
     3038         if available with-action then
     3039         do:
     3040           if trim( v-field-lvl ) <> "":U then
     3041           do:
     3042             assign
     3043               with-action.l_name = v-field-lvl
     3044               .
     3045           end.
     3046           if trim( v-field-form ) <> "":U then
     3047           do:
     3048             assign
     3049               with-action.v_old = dynamic-function( v-field-form, with-action.v_old )
     3050               .
     3051             if h-for-comp <> ? then
     3052             do:
     3053               assign
     3054                 with-action.v_new = dynamic-function( v-field-form, with-action.v_new )
     3055                 .
     3056             end.
     3057           end.
     3058         end.
     3059       end.
     3060       else
     3061       do:
     3062         message
     3063           vss-workfile vss-revision vss-description skip
     3064           "Ошибка! Список должен содержать три поля с разделителем delim-par!" skip
     3065           substitute( "список для поля '&1': '&2'"
     3066           ,entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     3067           ,entry( v-ind, p-label-form, chr(8) )
     3068           ) skip
     3069           substitute( "полный список: &2", p-label-form ) skip
     3070           view-as alert-box error .
     3071       end.
     3072     end.
     3073     delete object h-new-buf .
     3074     delete object h-main-buf .
     3075   END PROCEDURE.
     3076   define variable var-report-num      as character no-undo .
     3077   define variable v-file-name-rep-htm as character no-undo .
     3078   define variable is-petrol           as logical   no-undo .
     3079   define variable is-pieces           as logical   no-undo .
     3080   define variable v-value             as character no-undo.
     3081   define variable v-ok                as logical   no-undo.
     3082   define stream OutStr-html.
     3083   define temp-table tt-goods no-undo like ub.goods
     3084      field b-code as integer.
     3085   define temp-table tt-report no-undo
     3086      field obj-code             as integer
     3087      field obj-type             as character
     3088      field obj-name             as character
     3089      field user-open            as character
     3090      field user-close           as character
     3091      field gds-name             as character
     3092      field gds-code             as integer
     3093      field loc1                 as character
     3094      field pl-code              as integer
     3095      field is-before            as character init "НЕТ"
     3096      field is-after             as character init "НЕТ"
     3097      field doc-code             as character
     3098      field TTH-doc              as character
     3099      field fact-calc-vol_before as decimal
     3100      field fact-calc-vol_after  as decimal
     3101      field doc-qnty             as decimal
     3102      field fact-vol-TTH         as decimal
     3103      field max-vol-pl           as decimal
     3104      field proc-vol-pl          as decimal
     3105      index pi obj-type obj-code doc-code gds-code pl-code.
     3106      .
     3107   run get-report-num in parParentProc (
     3108      output var-report-num
     3109      ).
     3110   v-file-name-rep-htm = session:temp-directory + "rpt" + string(var-report-num) + ".html".
     3111   output to value(v-file-name-rep-htm).
     3112   output close.
     3113   def var v-first-time as int  no-undo.
     3114   def var v-first-date as date no-undo.
     3115   def var v-last-date  as date no-undo.
     3116   def var v-last-time  as int  no-undo.
     3117   output stream OutStr-html to value(v-file-name-rep-htm) convert target 'UTF-8' .
     3118   define variable v-gds as character no-undo.
     3119   define buffer buf_goods       for ub.goods.
     3120   define buffer buf_cli-gds     for ub.cli-gds.
     3121   define buffer buf_doc-pl-attr for ub.doc-pl-attr .
     3122   define buffer buf_trn-doc     for ub.trn-doc .
     3123   define buffer buf_rvs-line    for ub.rvs-line .
     3124   define buffer buf_rvs-doc     for ub.rvs-doc .
     3125   define variable v-gds-counter   as integer   no-undo.
     3126   define variable v-attr-value    as character no-undo.
     3127   define variable v-attr-type     as character no-undo.
     3128   define variable v-curr-grp-name as character no-undo .
     3129   define variable v-host-code     like ub.clients.host-code no-undo .
     3130   define variable v-obj-list      as character no-undo .
     3131   define variable curr-date as date no-undo .
     3132   define variable curr-time as integer no-undo .
     3133   do on error undo, return error return-value:
     3134      if   X-SelectObject = 'все':U then
     3135      do:
     3136         v-obj-list = "Все".
     3137      end.
     3138      else
     3139      do:
     3140         for each obj-list:
     3141            v-obj-list = v-obj-list + "," + obj-list.obj-name .
     3142            v-obj-list =     left-trim(v-obj-list, ",").
     3143         end.
     3144      end.
     3145      empty temp-table tt-goods.
     3146      case x-SelectGood:
     3147         when 1 then
     3148            do:
     3149               v-gds = 'Все'.
     3150               for each buf_goods no-lock where
     3151                  buf_goods.stts = 0:
     3152   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
     3153     (
     3154        input buf_goods.artic
     3155     ,  input buf_goods.prod-type
     3156     ,  input buf_goods.prod-code
     3157     , output is-petrol
     3158     , output is-pieces
     3159     ) no-error.
     3160                  if is-petrol = yes
     3161                     and not is-gas(buf_goods.gds-code)   then
     3162                  do:
     3163                     create tt-goods.
     3164                     buffer-copy buf_goods to tt-goods.
     3165                     find first bar-code where bar-code.gds-code eq buf_goods.gds-code no-lock no-error.
     3166                     IF AVAILABLE bar-code THEN  tt-goods.b-code = bar-code.b-code.
     3167                     v-gds-counter = v-gds-counter + 1.
     3168                  END.
     3169               end.
     3170            end.
     3171         when 4 or
     3172         when 5 then
     3173            do:
     3174               v-gds = 'Выборочно'.
     3175               for each gds-list:
     3176                  find first buf_goods no-lock
     3177                     where buf_goods.gds-code = gds-list.gds-code no-error.
     3178                  if available buf_goods then
     3179                  do:
     3180   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
     3181     (
     3182        input buf_goods.artic
     3183     ,  input buf_goods.prod-type
     3184     ,  input buf_goods.prod-code
     3185     , output is-petrol
     3186     , output is-pieces
     3187     ) no-error.
     3188                     if is-petrol = yes
     3189                        and not is-gas(buf_goods.gds-code)   then
     3190                     do:
     3191                        create tt-goods.
     3192                        buffer-copy buf_goods to tt-goods.
     3193                        find first bar-code where bar-code.gds-code eq buf_goods.gds-code no-lock no-error.
     3194                        IF AVAILABLE bar-code THEN  tt-goods.b-code = bar-code.b-code.
     3195                        v-gds-counter = v-gds-counter + 1.
     3196                     end.
     3197                  end.
     3198               end.
     3199            end.
     3200      end case.
     3201   end.
     3202   run shapka .
     3203   FOR EACH obj-list  NO-LOCK:
     3204      if x-tog-shift then
     3205      do:
     3206         for each buf_trn-doc no-lock where buf_trn-doc.obj-code = obj-list.obj-code and
     3207            buf_trn-doc.obj-type = obj-list.obj-type and
     3208            buf_trn-doc.ext-doc-type = 'ie':U and
     3209            buf_trn-doc.reason-code <> 98 and
     3210            buf_trn-doc.shift-date >= X-date-Start and
     3211            buf_trn-doc.shift-date <= x-Date-End:
     3212            if buf_trn-doc.shift-date = X-date-Start and buf_trn-doc.shift-num < X-Shift-Start then next .
     3213            if buf_trn-doc.shift-date = X-date-End   and buf_trn-doc.shift-num > X-Shift-End then next .
     3214            FOR EACH buf_doc-pl-attr no-lock where buf_doc-pl-attr.obj-code = buf_trn-doc.obj-code and
     3215               buf_doc-pl-attr.obj-type = buf_trn-doc.obj-type and
     3216               buf_doc-pl-attr.out-code = buf_trn-doc.doc-code and
     3217               (buf_doc-pl-attr.attr-code = "free-vol-exceed" or
     3218               buf_doc-pl-attr.attr-code = "free-vol-exceed-after") and
     3219               buf_doc-pl-attr.attr-value = string(yes):
     3220               if p-pl <> "" then
     3221               do:
     3222                  find first ub.place no-lock where ub.place.obj-code = buf_doc-pl-attr.obj-code and
     3223                     ub.place.obj-type = buf_doc-pl-attr.obj-type and
     3224                     ub.place.pl-code = buf_doc-pl-attr.pl-code no-error .
     3225                  if available (ub.place) then
     3226                     if lookup(string(recid(ub.place)),p-pl,",") = 0 then next .
     3227               end.
     3228               if not can-find (first tt-goods where tt-goods.gds-code = buf_doc-pl-attr.gds-code) then next .
     3229               run proc-report .
     3230            end.
     3231         end.
     3232      end.
     3233      else
     3234      do:
     3235         for each buf_trn-doc no-lock where buf_trn-doc.obj-code = obj-list.obj-code and
     3236            buf_trn-doc.obj-type = obj-list.obj-type and
     3237            buf_trn-doc.ext-doc-type = 'ie':U and
     3238            buf_trn-doc.reason-code <> 98 and
     3239            buf_trn-doc.doc-date >= X-date-Start and
     3240            buf_trn-doc.doc-date <= x-Date-End:
     3241            FOR EACH buf_doc-pl-attr no-lock where buf_doc-pl-attr.obj-code = buf_trn-doc.obj-code and
     3242               buf_doc-pl-attr.obj-type = buf_trn-doc.obj-type and
     3243               buf_doc-pl-attr.out-code = buf_trn-doc.doc-code and
     3244               (buf_doc-pl-attr.attr-code = "free-vol-exceed" or
     3245               buf_doc-pl-attr.attr-code = "free-vol-exceed-after") and
     3246               buf_doc-pl-attr.attr-value = string(yes):
     3247               if p-pl <> "" then
     3248               do:
     3249                  find first ub.place no-lock where ub.place.obj-code = buf_doc-pl-attr.obj-code and
     3250                     ub.place.obj-type = buf_doc-pl-attr.obj-type and
     3251                     ub.place.pl-code = buf_doc-pl-attr.pl-code no-error .
     3252                  if available (ub.place) then
     3253                     if lookup(string(recid(ub.place)),p-pl,",") = 0 then next .
     3254               end.
     3255               if not can-find (first tt-goods where tt-goods.gds-code = buf_doc-pl-attr.gds-code) then next .
     3256               run proc-report .
     3257            end.
     3258         end.
     3259      end.
     3260   END.
     3261   run print .
     3262   procedure shapka:
     3263      define variable v-period as character no-undo .
     3264      if x-tog-shift then
     3265         v-period = "смена с " + string(x-Shift-Start) + " от " + string(x-Date-Start, "99.99.9999") + " по " + string(x-Shift-End) + " от " + string(X-date-End, "99.99.9999") .
     3266      else v-period = " от " + string(x-Date-Start, "99.99.9999") + " по " + string(X-date-End, "99.99.9999") .
     3267      put stream OutStr-html unformatted
     3268   "<!DOCTYPE HTML>" skip
     3269   ' <html>' skip
     3270   '  <head>' skip
     3271   '   <meta charset="utf-8">' skip
     3272   '    <style type="text/css">' skip
     3273   '      table ' + chr(123) + ' border-collapse: collapse; ' + chr(125) skip
     3274   '      .class1 ' + chr(123) + ' border-collapse: collapse; ' + chr(125) skip
     3275   '      tbody td, th ' + chr(123) + ' border-collapse: collapse; border: 1px solid black;' + chr(125) skip
     3276   '   </style>' skip
     3277   '  </head>' skip
     3278         '<body> <table orientation = "landscape" name = "Прием топлива с превышением предельно допустимого объема резервуара" fit_to_page="true">'.
     3279      put stream OutStr-html unformatted
     3280         '<thead>' skip
     3281         '<tr class="set_columns">' skip
     3282         '<td style="width:100px"></td>' skip
     3283         '<td style="width:150px"></td>' skip
     3284         '<td style="width:150px"></td>' skip
     3285         '<td style="width:100px"></td>' skip
     3286         '<td style="width:100px"></td>' skip
     3287         '<td style="width:80px"></td>' skip
     3288         '<td style="width:80px"></td>' skip
     3289         '<td style="width:80px"></td>' skip
     3290         '<td style="width:80px"></td>' skip
     3291         '<td style="width:100px"></td>' skip
     3292         '<td style="width:100px"></td>' skip
     3293         '<td style="width:100px"></td>' skip
     3294         '<td style="width:100px"></td>' skip
     3295         '<td style="width:100px"></td>' skip
     3296         '<td style="width:100px"></td>' skip
     3297         '</tr>' skip
     3298         '<tr>' skip
     3299         '<td colspan="15" style="text-align: center; text-align: bold;">ПРИЕМ ТОПЛИВА С ПРЕВЫШЕНИЕМ ПРЕДЕЛЬНО ДОПУСТИМОГО ОБЪЕМА РЕЗЕРВУАРА</td>' skip
     3300         '</tr>' skip
     3301         '<tr>' skip
     3302         '<td style="text-align:left; text-align: bold;">Период:</td>' skip
     3303         '<td colspan="14" style="text-align:left;">' + v-period + '</td>' skip
     3304         '</tr>' skip
     3305         '<tr>' skip
     3306         '<td style="text-align:left; text-align: bold;">Объекты:</td>' skip
     3307         '<td colspan="14" style="text-align:left;">' + v-obj-list + '</td>' skip
     3308         '</tr>' skip
     3309         '<tr>' skip
     3310         '<td style="text-align:left; text-align: bold;">Резервуары:</td>' skip
     3311         '<td colspan="14" style="text-align:left;">' + if p-pl-name <> "" then p-pl-name else "Все" + '</td>' skip
     3312         '</tr>' skip
     3313         '<tr>' skip
     3314         '<td colspan="15" ></td>' skip
     3315         '</tr>' skip
     3316         '</thead>' skip
     3317         '<tbody>' skip
     3318         '<tr>' skip
     3319         '<th text_wrap="true" rowspan="1" style="text-align: center;">Название АЗС/АЗК</th>' skip
     3320         '<th text_wrap="true" rowspan="1" style="text-align: center;">ФИО работника, осуществляющего приемку</th>' skip
     3321         '<th text_wrap="true" rowspan="1" style="text-align: center;">ФИО сотрудника, закрывшего ПН</th>' skip
     3322         '<th text_wrap="true" rowspan="1" style="text-align: center;">Марка топлива</th>' skip
     3323         '<th text_wrap="true" rowspan="1" style="text-align: center;">№ резервуара</th>' skip
     3324         '<th text_wrap="true" rowspan="1" style="text-align: center;">Наличие предупреждения перед сливом об отсутствии свободного объема в резервуаре</th>' skip
     3325         '<th text_wrap="true" rowspan="1" style="text-align: center;">Превышение допустимого объема резервуара после слива АЦ</th>' skip
     3326         '<th text_wrap="true" rowspan="1" style="text-align: center;">Системный номер документа</th>' skip
     3327         '<th text_wrap="true" rowspan="1" style="text-align: center;">Накладная, номер</th>' skip
     3328         '<th text_wrap="true" rowspan="1" style="text-align: center;">Измер. объем топлива в резервуаре до слива АЦ, л</th>' skip
     3329         '<th text_wrap="true" rowspan="1" style="text-align: center;">Объем по ТТН, л</th>' skip
     3330         '<th text_wrap="true" rowspan="1" style="text-align: center;">Измер. объем топлива в резервуаре после слива АЦ, л</th>' skip
     3331         '<th text_wrap="true" rowspan="1" style="text-align: center;">Рассч. объем топлива в резервуаре после слива АЦ, л</th>' skip
     3332         '<th text_wrap="true" rowspan="1" style="text-align: center;">Объем резервуара 100%, л</th>' skip
     3333         '<th text_wrap="true" rowspan="1" style="text-align: center;">% заполнения резервуара после слива (факт)</th>' skip
     3334         '</tr>' skip
     3335         '<tr>' skip
     3336         '<th text_wrap="true" rowspan="1" style="text-align: center;">1</th>' skip
     3337         '<th text_wrap="true" rowspan="1" style="text-align: center;">2</th>' skip
     3338         '<th text_wrap="true" rowspan="1" style="text-align: center;">3</th>' skip
     3339         '<th text_wrap="true" rowspan="1" style="text-align: center;">4</th>' skip
     3340         '<th text_wrap="true" rowspan="1" style="text-align: center;">5</th>' skip
     3341         '<th text_wrap="true" rowspan="1" style="text-align: center;">6</th>' skip
     3342         '<th text_wrap="true" rowspan="1" style="text-align: center;">7</th>' skip
     3343         '<th text_wrap="true" rowspan="1" style="text-align: center;">8</th>' skip
     3344         '<th text_wrap="true" rowspan="1" style="text-align: center;">9</th>' skip
     3345         '<th text_wrap="true" rowspan="1" style="text-align: center;">10</th>' skip
     3346         '<th text_wrap="true" rowspan="1" style="text-align: center;">11</th>' skip
     3347         '<th text_wrap="true" rowspan="1" style="text-align: center;">12</th>' skip
     3348         '<th text_wrap="true" rowspan="1" style="text-align: center;">13</th>' skip
     3349         '<th text_wrap="true" rowspan="1" style="text-align: center;">14</th>' skip
     3350         '<th text_wrap="true" rowspan="1" style="text-align: center;">15</th>' skip
     3351         '</tr>' skip .
     3352   end.
     3353   procedure proc-report:
     3354      find first tt-report where tt-report.obj-code = obj-list.obj-code and
     3355         tt-report.obj-type = obj-list.obj-type and
     3356         tt-report.doc-code = buf_trn-doc.doc-code and
     3357         tt-report.gds-code = buf_doc-pl-attr.gds-code and
     3358         tt-report.pl-code = buf_doc-pl-attr.pl-code no-error .
     3359      if not available (tt-report) then
     3360      do:
     3361         create tt-report .
     3362         assign
     3363            tt-report.obj-code = obj-list.obj-code
     3364            tt-report.obj-type = obj-list.obj-type
     3365            tt-report.obj-name = obj-list.obj-name
     3366            tt-report.doc-code = buf_trn-doc.doc-code
     3367            tt-report.gds-code = buf_doc-pl-attr.gds-code
     3368            tt-report.pl-code  = buf_doc-pl-attr.pl-code
     3369            .
     3370         find first ub.goods no-lock where ub.goods.gds-code = tt-report.gds-code no-error .
     3371         if available (ub.goods) then tt-report.gds-name = ub.goods.gds-name .
     3372     tt-report.max-vol-pl = get_max-qnty(tt-report.obj-code, tt-report.obj-type, tt-report.pl-code, buf_trn-doc.fact-date, buf_trn-doc.fact-time) .
     3373         find first ub.place no-lock where ub.place.obj-code = tt-report.obj-code and
     3374            ub.place.obj-type = tt-report.obj-type and
     3375            ub.place.pl-code = tt-report.pl-code no-error .
     3376         if available (ub.place) then
     3377         do:
     3378            run placelib_get-attr in this-procedure  (
     3379               input "place-twice-code"
     3380               ,input ub.place.obj-code
     3381               ,input ub.place.obj-type
     3382               ,input ub.place.pl-code
     3383               ,output v-value
     3384               ,output v-ok      ) no-error.
     3385            if v-ok and v-value <> "" then tt-report.loc1 = ub.place.loc1 + "(" + v-value + ")".
     3386            else tt-report.loc1       = ub.place.loc1 .
     3387         end.
     3388   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input buf_trn-doc.doc-code ,
     3389                           input 'nids':U ,
     3390                          output v-attr-value ,
     3391                          output v-attr-type )  .
     3392         tt-report.TTH-doc = v-attr-value .
     3393         find first ub.c-trn-doc no-lock where ub.c-trn-doc.doc-code = buf_trn-doc.doc-code and
     3394            ub.c-trn-doc.obj-code = buf_trn-doc.obj-code and
     3395            ub.c-trn-doc.obj-type = buf_trn-doc.obj-type and
     3396            ub.c-trn-doc.status_ = 'накл':U  and
     3397            ub.c-trn-doc.flag_ = false no-error .
     3398         if available (ub.c-trn-doc) then
     3399         do:
     3400            find first ub.user-account no-lock where ub.user-account.user-id = ub.c-trn-doc.user-name no-error .
     3401            if available(ub.user-account) then tt-report.user-open = ub.user-account.last-name + " " + ub.user-account.first-name + " " + ub.user-account.second-name .
     3402         end.
     3403         find first ub.c-trn-doc no-lock where ub.c-trn-doc.doc-code = buf_trn-doc.doc-code and
     3404            ub.c-trn-doc.obj-code = buf_trn-doc.obj-code and
     3405            ub.c-trn-doc.obj-type = buf_trn-doc.obj-type and
     3406            ub.c-trn-doc.status_ = 'накл':U and
     3407            ub.c-trn-doc.flag_ = true  and
     3408            ub.c-trn-doc.action = "Закрытие документа" no-error .
     3409         if available (ub.c-trn-doc) then
     3410         do:
     3411            find first ub.user-account no-lock where ub.user-account.user-id = ub.c-trn-doc.corr-user-name no-error .
     3412            if available(ub.user-account) then tt-report.user-close = ub.user-account.last-name + " " + ub.user-account.first-name + " " + ub.user-account.second-name .
     3413         end.
     3414         for each buf_rvs-doc no-lock where buf_rvs-doc.obj-code = buf_doc-pl-attr.obj-code and
     3415            buf_rvs-doc.obj-type = buf_doc-pl-attr.obj-type and
     3416            buf_rvs-doc.out-code = buf_trn-doc.doc-code and
     3417            buf_rvs-doc.rvs-type = 'после_док':U,
     3418            first buf_rvs-line no-lock where buf_rvs-line.obj-code = buf_rvs-doc.obj-code and
     3419            buf_rvs-line.obj-type = buf_rvs-doc.obj-type and
     3420            buf_rvs-line.gds-code = buf_doc-pl-attr.gds-code and
     3421            buf_rvs-line.pl-code = buf_doc-pl-attr.pl-code and
     3422            buf_rvs-line.rvs-code = buf_rvs-doc.rvs-code
     3423         :
     3424            if buf_rvs-line.state-measure-qnty > tt-report.fact-calc-vol_after
     3425            then do :
     3426              tt-report.fact-calc-vol_after = buf_rvs-line.state-measure-qnty .
     3427              tt-report.fact-calc-vol_before = buf_rvs-line.state-measure-qnty .
     3428            end .
     3429         end.
     3430         for each buf_rvs-doc no-lock where buf_rvs-doc.obj-code = buf_doc-pl-attr.obj-code and
     3431            buf_rvs-doc.obj-type = buf_doc-pl-attr.obj-type and
     3432            buf_rvs-doc.out-code = buf_trn-doc.doc-code and
     3433            buf_rvs-doc.rvs-type = 'перед_док':U,
     3434            first buf_rvs-line no-lock where buf_rvs-line.obj-code = buf_rvs-doc.obj-code and
     3435            buf_rvs-line.obj-type = buf_rvs-doc.obj-type and
     3436            buf_rvs-line.gds-code = buf_doc-pl-attr.gds-code and
     3437            buf_rvs-line.pl-code = buf_doc-pl-attr.pl-code and
     3438            buf_rvs-line.rvs-code = buf_rvs-doc.rvs-code
     3439         :
     3440            if buf_rvs-line.state-measure-qnty < tt-report.fact-calc-vol_before
     3441            then
     3442              tt-report.fact-calc-vol_before = buf_rvs-line.state-measure-qnty .
     3443         end.
     3444         find first ub.goods no-lock where ub.goods.gds-code = buf_doc-pl-attr.gds-code no-error .
     3445         if available (ub.goods) then
     3446         do:
     3447            find first ub.doc-line no-lock where ub.doc-line.doc-code = buf_trn-doc.doc-code and
     3448               ub.doc-line.obj-code = buf_trn-doc.obj-code and
     3449               ub.doc-line.obj-type = buf_trn-doc.obj-type and
     3450               ub.doc-line.artic = ub.goods.artic and
     3451               ub.doc-line.prod-code = ub.goods.prod-code and
     3452               ub.doc-line.prod-type = ub.goods.prod-type no-error .
     3453            if available (ub.doc-line) then tt-report.doc-qnty = ub.doc-line.doc-qnty .
     3454         end.
     3455         tt-report.fact-vol-TTH = tt-report.fact-calc-vol_before + tt-report.doc-qnty .
     3456         tt-report.proc-vol-pl = (tt-report.fact-calc-vol_after * 100) / tt-report.max-vol-pl .
     3457      end.
     3458      if buf_doc-pl-attr.attr-code = "free-vol-exceed-after" then
     3459      do:
     3460         if buf_doc-pl-attr.attr-value = string(yes) then tt-report.is-after = "ДА" .
     3461         else tt-report.is-after = "НЕТ" .
     3462      end.
     3463      if buf_doc-pl-attr.attr-code = "free-vol-exceed" then
     3464      do:
     3465         if buf_doc-pl-attr.attr-value = string(yes) then tt-report.is-before = "ДА" .
     3466         else tt-report.is-before = "НЕТ" .
     3467      end.
     3468   end.
     3469   procedure print:
     3470      for each tt-report by tt-report.obj-code by tt-report.pl-code:
     3471         put stream OutStr-html unformatted
     3472            '<tr>' skip
     3473            '<td text_wrap="true" style="text-align:center;">' tt-report.obj-name '</td>' skip
     3474            '<td text_wrap="true" style="text-align:center;">' tt-report.user-open '</td>' skip
     3475            '<td text_wrap="true" style="text-align:center;">' tt-report.user-close '</td>' skip
     3476            '<td text_wrap="true" style="text-align:center;">' tt-report.gds-name '</td>' skip
     3477            '<td text_wrap="true" style="text-align:center;">' tt-report.loc1 '</td>' skip
     3478            '<td text_wrap="true" style="text-align:center;">' string(tt-report.is-before) '</td>' skip
     3479            '<td text_wrap="true" style="text-align:center;">' string(tt-report.is-after) '</td>' skip
     3480            '<td text_wrap="true" style="text-align:center;">' string(tt-report.doc-code)   '</td>' skip
     3481            '<td text_wrap="true" style="text-align:center;">' string(tt-report.TTH-doc)   '</td>' skip
     3482            '<td text_wrap="true" style="text-align:right;">' if tt-report.fact-calc-vol_before <> ? then string(ABSOLUTE(tt-report.fact-calc-vol_before),"->>>>>>>>>>>>9") else "" '</td>' skip
     3483            '<td text_wrap="true" style="text-align:right;">' if tt-report.doc-qnty <> ? then string(ABSOLUTE(tt-report.doc-qnty),"->>>>>>>>>>>>>9") else ""  '</td>' skip
     3484            '<td text_wrap="true" style="text-align:right;">' if tt-report.fact-calc-vol_after <> ? then string(ABSOLUTE(tt-report.fact-calc-vol_after),"->>>>>>>>9") else "" '</td>' skip
     3485            '<td text_wrap="true" style="text-align:right;">' if tt-report.fact-vol-TTH <> ? then string(ABSOLUTE(tt-report.fact-vol-TTH),"->>>>>>>>9") else "" '</td>' skip
     3486            '<td text_wrap="true" style="text-align:right;">' if tt-report.max-vol-pl <> ? then string(ABSOLUTE(tt-report.max-vol-pl),"->>>>>>>>9") else "" '</td>' skip
     3487            '<td text_wrap="true" style="text-align:right;">' if tt-report.proc-vol-pl <> ? then string(ABSOLUTE(tt-report.proc-vol-pl),"->>>>>>>>9.9") else "" '</td>' skip
     3488            '</tr>' skip .
     3489      end.
     3490   end procedure .
     3491   put stream OutStr-html unformatted
     3492      substitute (' </tbody></table> </body> </html>  ').
     3493   output stream OutStr-html close.
     3494   run prn-lib-reportviewer in this-procedure (
     3495      input parparentproc
     3496      ,input v-file-name-rep-htm
     3497      ,input ""
     3498      ) no-error.
     3499   if error-status:error then
     3500   do:
     3501      message return-value view-as alert-box.
     3502      return .
     3503   end.
