      578   define  stream PrnLibStream.
      579   procedure prn-lib-prn-file :
      580     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      581     define input parameter p-DIsabledoptions as integer no-undo .
      582     define variable v-report-name as character no-undo .
      583     define variable v-user-action as character no-undo .
      584     define variable v-printed     as logical   no-undo .
      585     define variable v-exist       as logical   no-undo .
      586     do
      587       on error undo, return error
      588       :
      589       run prn-lib-get-report-name  in this-procedure (
      590         input parParentProc
      591         ,output v-report-name
      592         ).
      593   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      594   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      595     (input  v-report-name
      596     ,input  2
      597     ,output v-exist
      598     )  .
      599       if NOT v-exist then
      600       DO:
      601         Message
      602           "Нет заданий на печать ! "
      603           view-as alert-box .
      604         Return  .
      605       End.
      606       run gbl/prnfilen.w
      607         (input  ""
      608         ,input  p-DisabledOptions
      609         ,input  string(v-report-name )
      610         ,input  7
      611         ,output v-user-action
      612         ,output v-printed
      613         ) .
      614       if v-printed then
      615       do:
      616         return "YES" .
      617       end.
      618       else
      619       do:
      620         return "NO" .
      621       end.
      622     end.
      623   end procedure.
      624   procedure prn-lib-open-stream :
      625     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      626     define input parameter p-page-size    as integer no-undo .
      627     define input parameter p-is-stream    as logical no-undo .
      628     define input parameter p-append       as logical no-undo .
      629     define variable v-report-name as character no-undo .
      630     do
      631       on error undo, return error
      632       :
      633       run prn-lib-get-report-name  in this-procedure (
      634         input parParentProc
      635         ,output v-report-name
      636         ).
      637       if p-is-stream then
      638       do:
      639         if p-append then
      640         do:
      641           output stream PrnLibStream to value( v-report-name )
      642             page-size value(p-page-size) append .
      643         end.
      644         if not p-append then
      645         do:
      646           output stream PrnLibStream to value( v-report-name )
      647             page-size value(p-page-size) .
      648         end.
      649       end.
      650       if not p-is-stream then
      651       do:
      652         if p-append then
      653         do:
      654           output to value( v-report-name )
      655             page-size value(p-page-size) append .
      656         end.
      657         if not p-append then
      658         do:
      659           output to value( v-report-name )
      660             page-size value(p-page-size) .
      661         end.
      662       end.
      663     end.
      664   end procedure.
      665   procedure prn-lib-open-exp :
      666     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      667     define input parameter p-is-stream    as logical no-undo .
      668     define input parameter p-is-append    as logical no-undo .
      669     define output parameter p-ReportFileName as char init "report" no-undo.
      670     define output parameter p-process as logical no-undo .
      671     define variable glog as logical no-undo .
      672     do
      673       on error undo, return error
      674       :
      675       SYSTEM-DIALOG GET-FILE p-ReportFileName
      676         TITLE      "Укажите путь"
      677         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      678         ASK-OVERWRITE
      679         CREATE-TEST-FILE
      680         SAVE-AS
      681         USE-FILENAME
      682         DEFAULT-EXTENSION "txt"
      683         UPDATE glog
      684         .
      685       if not glog then  return.
      686       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      687       if p-is-stream then
      688       do:
      689         if p-is-append then
      690         do:
      691           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      692         end.
      693         else
      694         do:
      695           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      696         end.
      697       end.
      698       else
      699       do:
      700         if p-is-append then
      701         do:
      702           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      703         end.
      704         else
      705         do:
      706           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      707         end.
      708       end.
      709       p-process = yes.
      710     end.
      711   end procedure.
      712   procedure prn-lib-get-report-name :
      713     define input parameter parParentProc  as widget-handle no-undo.
      714     define output parameter p-report-name as character no-undo .
      715     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      716   end procedure.
      717   procedure prn-lib-reportviewer-report-name :
      718     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      719     define input parameter p-report-name-html as character no-undo .
      720     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      721   end procedure.
      722   procedure prn-lib-reportviewer :
      723     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      724     define input parameter p-report-name-html as character no-undo .
      725     define input parameter p-param        as character no-undo .
      726     define variable v-excel           as character no-undo init 'TRUE' .
      727     define variable v-value-character as character no-undo .
      728     define variable v-value-integer   as character no-undo .
      729     define variable v-value-date      as date      no-undo .
      730     define variable v-value-decimal   as decimal   no-undo .
      731     define variable rep-excel         as logical   no-undo .
      732     define variable excel-string      as character no-undo .
      733     define variable v-param-type      as character no-undo .
      734     define variable v-tth             as handle    no-undo .
      735     run adm/shattri.p (
      736       input "get":U
      737       ,input  ""
      738       ,input  0
      739       ,input  'report-glob':U
      740       ,input  'rep-excel':U
      741       ,output v-value-character
      742       ,output v-value-date
      743       ,output v-value-decimal
      744       ,output v-value-integer
      745       ,output rep-excel
      746       ,output v-param-type
      747       ,INPUT-OUTPUT table-handle v-tth
      748       )  .
      749     if rep-excel then v-excel = "TRUE" .
      750     else v-excel = "FALSE" .
      751     if p-param eq ""
      752     then
      753        p-param = "EXCEL:" + v-excel.
      754     else
      755        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      756     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      757   end procedure.
      758   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      759   PROCEDURE LastDate:
      760       def input parameter in-date as date no-undo.
      761       def output parameter LastDate as date no-undo.
      762       LastDate = ((DATE(MONTH(in-date),28,YEAR(in-date)) + 4) - DAY(DATE(MONTH(in-date),28,YEAR(in-date)) + 4)).
      763   END PROCEDURE.
      764   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      765   procedure cur-time :
      766      define output parameter p-today as date      no-undo .
      767      define output parameter p-time  as integer   no-undo .
      768     do
      769     on error undo, return error
      770     :
      771       define variable v-date1 as date      no-undo .
      772       define variable v-date2 as date      no-undo .
      773       define variable v-time  as integer   no-undo .
      774       assign
      775         v-date1 = today
      776         v-time  = time
      777         v-date2 = today
      778       .
      779       if v-date1 <> v-date2
      780       then do:
      781         assign
      782           v-date1 = today
      783           v-time  = v-time
      784         .
      785       end.
      786       assign
      787         p-today = v-date1
      788         p-time  = v-time
      789       .
      790     end.
      791   end.
      792   function cur-time-date returns character
      793   :
      794     return string(today, '99/99/9999':U) .
      795   end.
      796   function cur-time-mjd returns decimal
      797   :
      798     define variable v-date as date      no-undo .
      799     define variable v-time as integer   no-undo .
      800     run cur-time in this-procedure
      801       (output v-date
      802       ,output v-time
      803       ) .
      804     return integer(v-date) - 2400002 + (v-time / 86400) .
      805   end.
      806   function cur-time-get-ending-index returns integer
      807   (input p-number as integer
      808   )
      809   :
      810     if p-number < 0
      811     or p-number = ?
      812     then do:
      813       return 1 .
      814     end.
      815     define variable v-rest as integer   no-undo .
      816     assign
      817       p-number = p-number modulo 100
      818     .
      819     if p-number < 20
      820     then do:
      821       assign
      822         v-rest = p-number
      823       .
      824     end.
      825     else do:
      826       assign
      827         v-rest = p-number modulo 10
      828       .
      829     end.
      830     case v-rest :
      831       when 1
      832       then do:
      833         return 2 .
      834       end.
      835       when 2 or
      836       when 3 or
      837       when 4
      838       then do:
      839         return 3 .
      840       end.
      841       otherwise do:
      842         return 1 .
      843       end.
      844     end case .
      845   end.
      846   procedure cur-time-mjd-to-date :
      847      define input  parameter i-mjd-diff as decimal no-undo.
      848      define output parameter o-Date     as date    no-undo.
      849      define output parameter o-Time     as integer no-undo.
      850      define variable v-day-number as integer   no-undo .
      851      if    i-mjd-diff < 0
      852         or i-mjd-diff = ?
      853      then do:
      854         return "?" .
      855      end.
      856      assign
      857         v-day-number = truncate(i-mjd-diff,0).
      858         o-Date = date(v-day-number + 2400002).
      859         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      860     .
      861   end.
      862   function cur-time-mjd-to-string returns character
      863   (input p-mjd-diff as decimal
      864   )
      865   :
      866     define variable v-day-number as integer   no-undo .
      867     define variable v-seconds    as integer   no-undo .
      868     define variable v-hour       as integer   no-undo .
      869     define variable v-min        as integer   no-undo .
      870     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      871     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      872     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      873     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      874     if p-mjd-diff < 0
      875     or p-mjd-diff = ?
      876     then do:
      877       return "?" .
      878     end.
      879     assign
      880       v-day-number = integer(truncate(p-mjd-diff,0))
      881       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      882     .
      883     if v-seconds > 86400
      884     then do:
      885       assign
      886         v-seconds = 86400 - 1
      887       .
      888     end.
      889     if v-seconds < 0
      890     then do:
      891       assign
      892         v-seconds = 0
      893       .
      894     end.
      895     assign
      896       v-hour = truncate(v-seconds / 3600, 0)
      897     .
      898     assign
      899       v-seconds = v-seconds modulo 3600
      900     .
      901     assign
      902       v-min = truncate(v-seconds / 60, 0)
      903     .
      904     assign
      905       v-seconds = v-seconds modulo 60
      906     .
      907     return
      908         (if v-day-number <> 0
      909           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      910           else ""
      911         )
      912       + (if v-day-number <> 0 or v-hour <> 0
      913           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      914           else ""
      915         )
      916       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      917           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      918           else ""
      919         )
      920       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      921       .
      922   end.
      923   function cur-time-string returns character
      924   :
      925     define variable v-date as date      no-undo .
      926     define variable v-time as integer   no-undo .
      927     run cur-time in this-procedure
      928       (output v-date
      929       ,output v-time
      930       ) .
      931     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      932   end.
      933   function cur-time-string-sec returns character
      934   :
      935     define variable v-date as date      no-undo .
      936     define variable v-time as integer   no-undo .
      937     run cur-time in this-procedure
      938       (output v-date
      939       ,output v-time
      940       ) .
      941     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      942   end.
      943   function cur-time-custom  returns character
      944   (input p-prefix as character
      945   ,input p-date-format as character
      946   ,input p-delimiter as character
      947   ,input p-time-format as character
      948   ,input p-suffix as character
      949   )
      950   :
      951     define variable v-date as date      no-undo .
      952     define variable v-time as integer   no-undo .
      953     run cur-time in this-procedure
      954       (output v-date
      955       ,output v-time
      956       ) .
      957     return
      958       p-prefix
      959       + string(v-date, p-date-format)
      960       + p-delimiter
      961       + string(v-time, p-time-format)
      962       + p-suffix
      963       .
      964   end.
      965   function cur-time-print  returns character
      966   :
      967     define variable v-date as date      no-undo .
      968     define variable v-time as integer   no-undo .
      969     run cur-time in this-procedure
      970       (output v-date
      971       ,output v-time
      972       ) .
      973     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      974   end.
      975   function cur-time-datetime returns datetime
      976   :
      977     define variable v-char as character no-undo .
      978     define variable v-datetime as datetime no-undo .
      979     v-char = cur-time-string().
      980     v-datetime = datetime(v-char).
      981     return  v-datetime.
      982   end.
      983   function cur-time-string-msec returns character
      984   :
      985     define variable v-date as datetime  no-undo .
      986     v-date = now.
      987     return string(v-date) .
      988   end.
      989   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      990   define variable v-waitfram-action01         as character   no-undo .
      991   define variable v-waitfram-action02         as character   no-undo .
      992   define variable v-waitfram-action03         as character   no-undo .
      993   define variable mWaitFramTextBeg            as character   no-undo.
      994   define variable mWaitFramTextEnd            as character   no-undo.
      995   define variable mWaitFramView               as logical     no-undo.
      996   define variable mWaitProcEvent              as logical     no-undo init yes.
      997   define variable mWaitFramInterval           as integer     no-undo init 1 .
      998   define variable mWaitFramStop               as logical     no-undo.
      999   define variable mWaitFramStopUser           as logical     no-undo.
     1000   define variable mWaitFramStopTimeOut        as logical     no-undo.
     1001   define variable mWaitFramStartProc          as datetime-tz no-undo.
     1002   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     1003   define button B-WaitFramStop auto-end-key
     1004        label "Стоп"
     1005        size 10 by 1 tooltip "Остоновить процесс".
     1006   define button B-viewProcInfo
     1007        label "Информация"
     1008        size 15 by 1 tooltip "Информация о процесс".
     1009   define frame waitfram
     1010     v-waitfram-action01 format "x(72)" no-label skip
     1011     v-waitfram-action02 format "x(72)" no-label skip
     1012     v-waitfram-action03 format "x(72)" no-label skip
     1013     B-viewProcInfo
     1014     B-WaitFramStop at row 4 col 30
     1015     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1016     .
     1017   define new global shared variable mBatchMode as logical no-undo init ?.
     1018   define variable mFramBachModHandle as handle no-undo.
     1019   mFramBachModHandle = frame waitfram:handle.
     1020   define variable mFameOldVis as logical no-undo.
     1021   define variable mVisCUrentVin as logical no-undo.
     1022   if session:batch-mode
     1023   then
     1024      mBatchMode = yes.
     1025   if mBatchMode = ? then do:
     1026     mVisCUrentVin = current-window:visible.
     1027     mFameOldVis = mFramBachModHandle:visible.
     1028     mFramBachModHandle:visible  = yes.
     1029     mBatchMode = mFramBachModHandle:visible ne yes.
     1030     mFramBachModHandle:visible = mFameOldVis.
     1031     current-window:visible = mVisCUrentVin.
     1032   end.
     1033    if  log-manager:logfile-name ne ?
     1034     then DO:
     1035         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1036         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1037         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1038     end.
     1039   on choose of B-WaitFramStop in frame waitfram
     1040   do:
     1041     mWaitFramStop = yes.
     1042     mWaitFramStopUser = yes.
     1043   end.
     1044   function waitfram-check-timeout returns logical():
     1045      define variable vtime as int64 no-undo.
     1046      if mWaitFramStopTimeOut
     1047      then
     1048         return yes.
     1049      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1050      if     mWaitFramTimeOut ne ?
     1051         and mWaitFramTimeOut ne 0
     1052         and mWaitFramTimeOut lt vtime
     1053      then do:
     1054         mWaitFramStopTimeOut = yes.
     1055      end.
     1056      return mWaitFramStopTimeOut.
     1057   end.
     1058   procedure waitfram-hide :
     1059     if not session:batch-mode
     1060     then do
     1061     on error undo, return error return-value
     1062     :
     1063       pause 0 before-hide .
     1064       if not mBatchMode then
     1065         hide frame waitfram .
     1066     if     not mWaitFramView
     1067        and mWaitProcEvent
     1068     then
     1069       process events .
     1070     end.
     1071   end procedure.
     1072   procedure waitfram-show :
     1073     define input  parameter p-message as character no-undo .
     1074     define variable v-left-margin as integer   no-undo .
     1075     if not session:batch-mode
     1076     then do
     1077     on error undo, return error return-value
     1078     :
     1079       if length(p-message) <= 70 then do:
     1080         assign
     1081           v-left-margin = integer((70 - length(p-message)) / 2)
     1082         .
     1083         assign
     1084           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1085         .
     1086         assign
     1087           v-waitfram-action01 = " "
     1088           v-waitfram-action02 = " "
     1089                                    + fill(" ", v-left-margin)
     1090                                    + p-message
     1091           v-waitfram-action03 = " "
     1092         .
     1093       end.
     1094       else do:
     1095         define variable vRindex1 as integer no-undo.
     1096         define variable vRindex2 as integer no-undo.
     1097         vRindex1 = r-index(p-message," ",70).
     1098         if vRindex1 = 0
     1099         then
     1100            vRindex1 = 70.
     1101         if length(p-message)  <= vRindex1 + 70 then do:
     1102           assign
     1103             v-waitfram-action01 = " "
     1104             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1105             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1106           .
     1107         end.
     1108         else do:
     1109           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1110           if vRindex2 <= vRindex1
     1111           then
     1112              vRindex2 = vRindex1 + 70.
     1113           assign
     1114             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1115             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1116             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1117           .
     1118         end.
     1119       end.
     1120       B-viewProcInfo:visible   in frame waitfram = no.
     1121       B-viewProcInfo:sensitive in frame waitfram = no.
     1122       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1123       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1124       if  (   mWaitFramView
     1125          or  mWaitProcEvent)
     1126          and not mBatchMode
     1127       then
     1128          display
     1129             v-waitfram-action01 skip
     1130             v-waitfram-action02 skip
     1131             v-waitfram-action03 skip
     1132          with frame waitfram .
     1133       if     mWaitFramView
     1134          then do:
     1135             if     mWaitFramInterval ne ?
     1136                and not mBatchMode
     1137             then
     1138                wait-for go of frame waitfram pause mWaitFramInterval.
     1139          end.
     1140          else
     1141             if     mWaitProcEvent
     1142                and not mBatchMode
     1143             then
     1144                process events .
     1145     end.
     1146   end procedure.
     1147      procedure waitfram-show-this:
     1148         define input  parameter iInterval as int64 no-undo.
     1149         define variable vtime as int64 no-undo.
     1150         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1151         mWaitFramInterval = iInterval.
     1152         run waitfram-show (substitute("&1&2 &3&4" ,
     1153                                       mWaitFramTextBeg ,
     1154                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1155                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1156                                       mWaitFramTextEnd
     1157                                      )
     1158                           ).
     1159      end.
     1160      procedure WaitFramRunPause:
     1161         define input  parameter iInterval as dec no-undo.
     1162         define variable vStart  as datetime-tz no-undo.
     1163         define variable vend    as datetime-tz no-undo.
     1164         define variable vint as int64 no-undo.
     1165         define variable vOk as logical no-undo.
     1166         vStart = now.
     1167         vend   = vStart.
     1168         publish "WaitFramPause" (iInterval,output vOk).
     1169         vend   =  now.
     1170         vint = vend - vStart.
     1171         vint = iInterval - vint / 1000.
     1172         if     not mWaitFramStop
     1173            and (   vint > 0
     1174                 or (    not vOk
     1175                     and iInterval eq ?
     1176                     )
     1177                 )
     1178         then
     1179            run waitfram-show-this (iInterval).
     1180         vend   =  now.
     1181         vint = vend - vStart.
     1182         vint = iInterval - vint / 1000.
     1183         if     not mWaitFramStop
     1184            and vint > 0
     1185         then do:
     1186            run gbl/pause.p (vint * 1000).
     1187         end.
     1188         if iInterval ne ?
     1189         then
     1190            publish "WaitFramStop".
     1191         waitfram-check-timeout().
     1192      end.
     1193      procedure WaitFramWaitFor:
     1194         define input  parameter iInterval as dec no-undo.
     1195         assign
     1196            mWaitFramStartProc   = now
     1197            mWaitFramStopUser    = no
     1198            mWaitFramStopTimeOut = no
     1199         .
     1200         block-wait:
     1201         do while not mWaitFramStop:
     1202            run WaitFramRunPause (iInterval).
     1203            if  waitfram-check-timeout()
     1204            then do:
     1205               leave block-wait.
     1206            end.
     1207         end.
     1208         run waitfram-hide.
     1209      end.
     1210   procedure waitfram-join :
     1211     define input  parameter p-line-1  as character no-undo .
     1212     define input  parameter p-line-2  as character no-undo .
     1213     define input  parameter p-line-3  as character no-undo .
     1214     define output parameter p-message as character no-undo .
     1215     do
     1216     on error undo, return error return-value
     1217     :
     1218       assign
     1219         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1220                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1221                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1222       .
     1223     end.
     1224   end procedure.
     1225   function waitfram-join-function returns character
     1226     (input p-line-1 as character
     1227     ,input p-line-2 as character
     1228     ,input p-line-3 as character
     1229     ).
     1230     define variable v-message as character no-undo .
     1231     run waitfram-join in this-procedure
     1232       (input  p-line-1
     1233       ,input  p-line-2
     1234       ,input  p-line-3
     1235       ,output v-message
     1236       ) .
     1237     return v-message .
     1238   end function .
     1239   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1240   procedure sys-time_get-sys :
     1241     define output parameter p-year         as integer   no-undo .
     1242     define output parameter p-month        as integer   no-undo .
     1243     define output parameter p-day          as integer   no-undo .
     1244     define output parameter p-hour         as integer   no-undo .
     1245     define output parameter p-minute       as integer   no-undo .
     1246     define output parameter p-second       as integer   no-undo .
     1247     define output parameter p-milliseconds as integer   no-undo .
     1248     define variable v-system-time-structure as memptr    no-undo.
     1249     do
     1250     on error undo, return error return-value
     1251     :
     1252       assign
     1253         set-size(v-system-time-structure) = 16
     1254       .
     1255       run GetSystemTime
     1256         (input  get-pointer-value(v-system-time-structure)
     1257         ) .
     1258       assign
     1259         p-year         = get-short(v-system-time-structure,  1)
     1260         p-month        = get-short(v-system-time-structure,  3)
     1261         p-day          = get-short(v-system-time-structure,  7)
     1262         p-hour         = get-short(v-system-time-structure,  9)
     1263         p-minute       = get-short(v-system-time-structure, 11)
     1264         p-second       = get-short(v-system-time-structure, 13)
     1265         p-milliseconds = get-short(v-system-time-structure, 15)
     1266       .
     1267       assign
     1268         set-size(v-system-time-structure) = 0
     1269       .
     1270     end.
     1271   end procedure.
     1272   procedure sys-time_get-comp-user-name :
     1273     define output parameter p-computer-name as character no-undo .
     1274     define output parameter p-user-name     as character no-undo .
     1275     define output parameter p-process-pid   as integer   no-undo .
     1276     define variable v-return-value  as integer   no-undo .
     1277     define variable v-buffer-length as integer   no-undo .
     1278     define variable v-buffer-memptr as memptr    no-undo .
     1279     do
     1280     on error undo, return error return-value
     1281     :
     1282       assign
     1283         v-buffer-length = 1024
     1284         set-size(v-buffer-memptr) = v-buffer-length + 4
     1285       .
     1286       assign
     1287         put-long(v-buffer-memptr, 1) = v-buffer-length
     1288       .
     1289       run GetComputerNameA
     1290         (input  get-pointer-value(v-buffer-memptr) + 4
     1291         ,input  get-pointer-value(v-buffer-memptr)
     1292         ,output v-return-value
     1293         ) .
     1294       if v-return-value <> 0
     1295       then do:
     1296         assign
     1297           p-computer-name = get-string(v-buffer-memptr, 5)
     1298         .
     1299       end.
     1300       assign
     1301         put-long(v-buffer-memptr, 1) = v-buffer-length
     1302       .
     1303       run GetUserNameA
     1304         (input  get-pointer-value(v-buffer-memptr) + 4
     1305         ,input  get-pointer-value(v-buffer-memptr)
     1306         ,output v-return-value
     1307         ) .
     1308       if v-return-value <> 0
     1309       then do:
     1310         assign
     1311           p-user-name = get-string(v-buffer-memptr, 5)
     1312         .
     1313       end.
     1314       run GetCurrentProcessId
     1315         (output p-process-pid
     1316         ) .
     1317       assign
     1318         set-size(v-buffer-memptr) = 0
     1319       .
     1320     end.
     1321   end procedure.
     1322   procedure sys-time_get-http :
     1323     define output parameter p-http-time as character no-undo .
     1324     define variable v-year         as integer   no-undo .
     1325     define variable v-month        as integer   no-undo .
     1326     define variable v-day-of-week  as integer   no-undo .
     1327     define variable v-day          as integer   no-undo .
     1328     define variable v-hour         as integer   no-undo .
     1329     define variable v-minute       as integer   no-undo .
     1330     define variable v-second       as integer   no-undo .
     1331     define variable v-milliseconds as integer   no-undo .
     1332     do
     1333     on error undo, return error return-value
     1334     :
     1335       run sys-time_get-sys in this-procedure
     1336         (output v-year
     1337         ,output v-month
     1338         ,output v-day
     1339         ,output v-hour
     1340         ,output v-minute
     1341         ,output v-second
     1342         ,output v-milliseconds
     1343         ) .
     1344       assign
     1345         v-day-of-week = weekday(date(v-month, v-day, v-year))
     1346         p-http-time = entry(v-day-of-week, 'Sun,Mon,Tue,Wed,Thu,Fri,Sat')
     1347                     + ', ':u
     1348                     + string(v-day, '99':u)
     1349                     + ' ':u
     1350                     + entry(v-month, 'Jan,Feb,Mar,Apr,May,Jun,Jul,Aug,Sep,Oct,Nov,Dec':u)
     1351                     + ' ':u
     1352                     + string(v-year, '9999':u)
     1353                     + ' ':u
     1354                     + string(v-hour, '99':u)
     1355                     + ':':u
     1356                     + string(v-minute, '99':u)
     1357                     + ':':u
     1358                     + string(v-second, '99':u)
     1359                     + ' ':u
     1360                     + 'GMT':u
     1361       .
     1362     end.
     1363   end procedure.
     1364   procedure sys-time_set-sys :
     1365     define input  parameter p-year         as integer   no-undo .
     1366     define input  parameter p-month        as integer   no-undo .
     1367     define input  parameter p-day          as integer   no-undo .
     1368     define input  parameter p-hour         as integer   no-undo .
     1369     define input  parameter p-minute       as integer   no-undo .
     1370     define input  parameter p-second       as integer   no-undo .
     1371     define input  parameter p-milliseconds as integer   no-undo .
     1372     define variable v-system-time-structure as memptr    no-undo.
     1373     define variable v-return-value as integer   no-undo .
     1374     define variable v-day-of-week  as integer   no-undo .
     1375     do
     1376     on error undo, return error return-value
     1377     :
     1378       assign
     1379         v-day-of-week = weekday(date(p-month, p-day, p-year))
     1380       .
     1381       assign
     1382         set-size(v-system-time-structure) = 16
     1383       .
     1384       assign
     1385         put-short(v-system-time-structure,  1) = p-year
     1386         put-short(v-system-time-structure,  3) = p-month
     1387         put-short(v-system-time-structure,  5) = v-day-of-week
     1388         put-short(v-system-time-structure,  7) = p-day
     1389         put-short(v-system-time-structure,  9) = p-hour
     1390         put-short(v-system-time-structure, 11) = p-minute
     1391         put-short(v-system-time-structure, 13) = p-second
     1392         put-short(v-system-time-structure, 15) = p-milliseconds
     1393       .
     1394       run SetSystemTime
     1395         (input  get-pointer-value(v-system-time-structure)
     1396         ,output v-return-value
     1397         ) .
     1398       assign
     1399         set-size(v-system-time-structure) = 0
     1400       .
     1401       if v-return-value = 0
     1402       then do:
     1403         undo, return error "sys-time_set-sys: Ошибка при установке даты" .
     1404       end.
     1405     end.
     1406   end procedure.
     1407   procedure sys-time_sys-to-mjd :
     1408     define input  parameter p-year         as integer   no-undo .
     1409     define input  parameter p-month        as integer   no-undo .
     1410     define input  parameter p-day          as integer   no-undo .
     1411     define input  parameter p-hour         as integer   no-undo .
     1412     define input  parameter p-minute       as integer   no-undo .
     1413     define input  parameter p-second       as integer   no-undo .
     1414     define input  parameter p-milliseconds as integer   no-undo .
     1415     define output parameter p-mjd          as decimal   no-undo .
     1416     define variable v-year-correction as decimal   no-undo .
     1417     define variable v-shift-year as decimal   no-undo .
     1418     do
     1419     on error undo, return error return-value
     1420     :
     1421       assign
     1422         v-year-correction = truncate((decimal(p-month) - 14.0) / 12, 0)
     1423         v-shift-year      = decimal(p-year) + v-year-correction
     1424         p-mjd = truncate( (1461.0 * (v-shift-year + 4800.0 ) ) / 4, 0)
     1425               + truncate( (367.0 * (decimal(p-month) - 2.0 - v-year-correction * 12) ) / 12, 0)
     1426               - truncate( (3 * truncate((v-shift-year + 4900 ) / 100,0) ) / 4, 0)
     1427               + decimal(p-day) - 2432076.0
     1428               + p-hour / 24.0
     1429               + p-minute / 1440.0
     1430               + p-second / 86400.0
     1431               + p-milliseconds / 86400000.0
     1432       .
     1433     end.
     1434   end procedure.
     1435   procedure sys-time_sys-to-loc :
     1436     define input  parameter p-sys-year         as integer   no-undo .
     1437     define input  parameter p-sys-month        as integer   no-undo .
     1438     define input  parameter p-sys-day          as integer   no-undo .
     1439     define input  parameter p-sys-hour         as integer   no-undo .
     1440     define input  parameter p-sys-minute       as integer   no-undo .
     1441     define input  parameter p-sys-second       as integer   no-undo .
     1442     define input  parameter p-sys-milliseconds as integer   no-undo .
     1443     define output parameter p-loc-year         as integer   no-undo .
     1444     define output parameter p-loc-month        as integer   no-undo .
     1445     define output parameter p-loc-day          as integer   no-undo .
     1446     define output parameter p-loc-hour         as integer   no-undo .
     1447     define output parameter p-loc-minute       as integer   no-undo .
     1448     define output parameter p-loc-second       as integer   no-undo .
     1449     define output parameter p-loc-milliseconds as integer   no-undo .
     1450     define variable v-system-time-structure as memptr    no-undo.
     1451     define variable v-return-value          as integer   no-undo .
     1452     define variable v-sys-day-of-week       as integer   no-undo .
     1453     do
     1454     on error undo, return error return-value
     1455     :
     1456       assign
     1457         v-sys-day-of-week = weekday(date(p-sys-month, p-sys-day, p-sys-year))
     1458       .
     1459       assign
     1460         set-size(v-system-time-structure) = 32
     1461       .
     1462       assign
     1463         put-short(v-system-time-structure,  1) = p-sys-year
     1464         put-short(v-system-time-structure,  3) = p-sys-month
     1465         put-short(v-system-time-structure,  5) = v-sys-day-of-week
     1466         put-short(v-system-time-structure,  7) = p-sys-day
     1467         put-short(v-system-time-structure,  9) = p-sys-hour
     1468         put-short(v-system-time-structure, 11) = p-sys-minute
     1469         put-short(v-system-time-structure, 13) = p-sys-second
     1470         put-short(v-system-time-structure, 15) = p-sys-milliseconds
     1471       .
     1472       run SystemTimeToTzSpecificLocalTime
     1473         (input  0
     1474         ,input  get-pointer-value(v-system-time-structure)
     1475         ,input  get-pointer-value(v-system-time-structure) + 16
     1476         ,output v-return-value
     1477         ) .
     1478       assign
     1479         p-loc-year         = get-short(v-system-time-structure,  1 + 16)
     1480         p-loc-month        = get-short(v-system-time-structure,  3 + 16)
     1481         p-loc-day          = get-short(v-system-time-structure,  7 + 16)
     1482         p-loc-hour         = get-short(v-system-time-structure,  9 + 16)
     1483         p-loc-minute       = get-short(v-system-time-structure, 11 + 16)
     1484         p-loc-second       = get-short(v-system-time-structure, 13 + 16)
     1485         p-loc-milliseconds = get-short(v-system-time-structure, 15 + 16)
     1486       .
     1487       assign
     1488         set-size(v-system-time-structure) = 0
     1489       .
     1490       if v-return-value = 0
     1491       then do:
     1492         undo, return error "sys-time_set-sys: Ошибка при установке даты" .
     1493       end.
     1494     end.
     1495   end procedure.
     1496   procedure sys-time_mjd-to-sys :
     1497     define input  parameter p-mjd          as decimal   no-undo .
     1498     define output parameter p-year         as integer   no-undo .
     1499     define output parameter p-month        as integer   no-undo .
     1500     define output parameter p-day          as integer   no-undo .
     1501     define output parameter p-hour         as integer   no-undo .
     1502     define output parameter p-minute       as integer   no-undo .
     1503     define output parameter p-second       as integer   no-undo .
     1504     define output parameter p-milliseconds as integer   no-undo .
     1505     define variable v-year-correction as decimal   no-undo .
     1506     define variable v-shift-year      as decimal   no-undo .
     1507     define variable v-conv-date     as date      no-undo .
     1508     define variable v-int-part      as integer   no-undo .
     1509     define variable v-fraction-part as decimal   no-undo .
     1510     do
     1511     on error undo, return error return-value
     1512     :
     1513       assign
     1514         v-int-part      = integer(truncate(p-mjd, 0))
     1515         v-fraction-part = p-mjd - v-int-part
     1516         v-conv-date     = date(11, 17, 1858) + v-int-part
     1517         p-year          = year(v-conv-date)
     1518         p-month         = month(v-conv-date)
     1519         p-day           = day(v-conv-date)
     1520         v-fraction-part = v-fraction-part * 24.0
     1521         p-hour          = integer(truncate(v-fraction-part, 0))
     1522         v-fraction-part = (v-fraction-part - p-hour) * 60.0
     1523         p-minute        = integer(truncate(v-fraction-part, 0))
     1524         v-fraction-part = (v-fraction-part - p-minute) * 60.0
     1525         p-second        = integer(truncate(v-fraction-part, 0))
     1526         v-fraction-part = (v-fraction-part - p-second) * 1000.0
     1527         p-milliseconds  = integer(v-fraction-part)
     1528       .
     1529     end.
     1530   end procedure.
     1531   procedure sys-time_mjd-to-loc :
     1532     define input  parameter p-mjd              as decimal   no-undo .
     1533     define output parameter p-loc-year         as integer   no-undo .
     1534     define output parameter p-loc-month        as integer   no-undo .
     1535     define output parameter p-loc-day          as integer   no-undo .
     1536     define output parameter p-loc-hour         as integer   no-undo .
     1537     define output parameter p-loc-minute       as integer   no-undo .
     1538     define output parameter p-loc-second       as integer   no-undo .
     1539     define output parameter p-loc-milliseconds as integer   no-undo .
     1540     define variable v-sys-year         as integer   no-undo .
     1541     define variable v-sys-month        as integer   no-undo .
     1542     define variable v-sys-day          as integer   no-undo .
     1543     define variable v-sys-hour         as integer   no-undo .
     1544     define variable v-sys-minute       as integer   no-undo .
     1545     define variable v-sys-second       as integer   no-undo .
     1546     define variable v-sys-milliseconds as integer   no-undo .
     1547     do
     1548     on error undo, return error return-value
     1549     :
     1550       run sys-time_mjd-to-sys
     1551         (input  p-mjd
     1552         ,output v-sys-year
     1553         ,output v-sys-month
     1554         ,output v-sys-day
     1555         ,output v-sys-hour
     1556         ,output v-sys-minute
     1557         ,output v-sys-second
     1558         ,output v-sys-milliseconds
     1559         ) .
