     1578   function sys-time_get-mjd-func returns decimal
     1579   :
     1580     define variable v-year         as integer   no-undo .
     1581     define variable v-month        as integer   no-undo .
     1582     define variable v-day          as integer   no-undo .
     1583     define variable v-hour         as integer   no-undo .
     1584     define variable v-minute       as integer   no-undo .
     1585     define variable v-second       as integer   no-undo .
     1586     define variable v-milliseconds as integer   no-undo .
     1587     define variable v-mjd          as decimal   no-undo .
     1588     run sys-time_get-sys in this-procedure
     1589       (output v-year
     1590       ,output v-month
     1591       ,output v-day
     1592       ,output v-hour
     1593       ,output v-minute
     1594       ,output v-second
     1595       ,output v-milliseconds
     1596       ) .
     1597     run sys-time_sys-to-mjd in this-procedure
     1598       (input  v-year
     1599       ,input  v-month
     1600       ,input  v-day
     1601       ,input  v-hour
     1602       ,input  v-minute
     1603       ,input  v-second
     1604       ,input  v-milliseconds
     1605       ,output v-mjd
     1606       ) .
     1607     return v-mjd .
     1608   end function .
     1609   function sys-time_get-sys-str-func returns character
     1610   :
     1611     define variable v-utc-time as character no-undo .
     1612     define variable v-year         as integer   no-undo .
     1613     define variable v-month        as integer   no-undo .
     1614     define variable v-day          as integer   no-undo .
     1615     define variable v-hour         as integer   no-undo .
     1616     define variable v-minute       as integer   no-undo .
     1617     define variable v-second       as integer   no-undo .
     1618     define variable v-milliseconds as integer   no-undo .
     1619     run sys-time_get-sys in this-procedure
     1620       (output v-year
     1621       ,output v-month
     1622       ,output v-day
     1623       ,output v-hour
     1624       ,output v-minute
     1625       ,output v-second
     1626       ,output v-milliseconds
     1627       ) .
     1628     assign
     1629       v-utc-time  = 'UTC ':u
     1630                   + string(v-year,         '9999':u)
     1631                   + '/':u
     1632                   + string(v-month,        '99':u)
     1633                   + '/':u
     1634                   + string(v-day,          '99':u)
     1635                   + ' ':u
     1636                   + string(v-hour,         '99':u)
     1637                   + ':':u
     1638                   + string(v-minute,       '99':u)
     1639                   + ':':u
     1640                   + string(v-second,       '99':u)
     1641                   + ' ':u
     1642                   + string(v-milliseconds, '999':u)
     1643     .
     1644     return v-utc-time.
     1645   end function .
     1646   function sys-time_mjd-to-loc-str-func returns character
     1647     (v-sys-mjd as decimal)
     1648   :
     1649     define variable v-loc-str          as character no-undo .
     1650     define variable v-loc-year         as integer   no-undo .
     1651     define variable v-loc-month        as integer   no-undo .
     1652     define variable v-loc-day          as integer   no-undo .
     1653     define variable v-loc-hour         as integer   no-undo .
     1654     define variable v-loc-minute       as integer   no-undo .
     1655     define variable v-loc-second       as integer   no-undo .
     1656     define variable v-loc-milliseconds as integer   no-undo .
     1657     run sys-time_mjd-to-loc in this-procedure
     1658       (input  v-sys-mjd
     1659       ,output v-loc-year
     1660       ,output v-loc-month
     1661       ,output v-loc-day
     1662       ,output v-loc-hour
     1663       ,output v-loc-minute
     1664       ,output v-loc-second
     1665       ,output v-loc-milliseconds
     1666       ) .
     1667     assign
     1668       v-loc-str = substitute('&1/&2/&3 &4:&5'
     1669                             ,string(v-loc-day,    '99':U)
     1670                             ,string(v-loc-month,  '99':U)
     1671                             ,string(v-loc-year,   '9999':U)
     1672                             ,string(v-loc-hour,   '99':U)
     1673                             ,string(v-loc-minute, '99':U)
     1674                             )
     1675     .
     1676     return v-loc-str .
     1677   end function .
