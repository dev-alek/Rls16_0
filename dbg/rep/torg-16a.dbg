     4533             slt-pc-loc         = (if parts.slt-pc         = ? then 0 else parts.slt-pc).
     4534             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     4535       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     4536     assign
     4537       exch-rate-cli-loc = (parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / parts.price-cli .
     4538     assign
     4539       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
     4540       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
     4541       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
     4542       transport-cli-loc  = 0
     4543       other-cli-loc      = 0
     4544     .
     4545   ASSIGN
     4546             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     4547       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     4548   .
     4549                   assign
     4550                       v-parts-qnty      = parts.fact-qnty
     4551                       v-parts-price     = ( if PrintRubl then price-rubl-with-tax-loc else price-base-with-tax-loc )
     4552                                           - ( if PrintRubl then vat-rubl-loc else vat-base-loc )
     4553                       v-parts-sum-price = v-parts-qnty * v-parts-price
     4554                       v-qnty            = v-parts-qnty
     4555                       v-sum-price       = v-parts-qnty * v-price
     4556                   .
     4557                   display stream Out-stream
     4558                       v-line-counter
     4559                       goods.artic      @ v-artic
     4560                       goods.gds-name   @ v-gds-name
     4561                       v-unit-base
     4562                       v-parts-qnty
     4563                       v-parts-price
     4564                       v-parts-sum-price
     4565                       v-qnty
     4566                       v-price
     4567                       v-sum-price
     4568                       sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     4569                       with frame f-doc .
     4570                   down stream Out-stream 1 with frame f-doc .
     4571   define variable vss-include-info24 as character format "X(65)" no-undo
     4572   initial "@(#)$Workfile$ $Revision$".
     4573       if page-number( Out-Stream ) > PrevPage
     4574       then do:
     4575           assign
     4576               Pg-tqnty        = 0
     4577               Pg-stoim        = 0
     4578               Pg-stoim-VAT    = 0
     4579           .
     4580       end.
     4581               assign
     4582                   PrevPage = page-number( Out-Stream )
     4583                   Pg-tqnty = Pg-tqnty + v-qnty
     4584                   Pg-stoim = Pg-stoim + v-sum-price
     4585               .
     4586           if line-counter( Out-Stream ) + 1 > page-size( Out-Stream ) then
     4587           do:
     4588               PUT STREAM Out-Stream v-line-string format "X(198)" SKIP.
     4589               if v-line-counter <> 1
     4590               then do:
     4591                   DISPLAY STREAM Out-Stream
     4592                       "Итого"         @ v-gds-name
     4593                       Pg-tqnty        @ v-qnty
     4594                       Pg-stoim        @ v-sum-price
     4595                       with frame f-doc .
     4596                   DOWN STREAM Out-Stream 1 with FRAME f-doc .
     4597                       put stream out-stream
     4598                           string( "Цены и суммы " + (if CostPrice then "(учетные)" else "") + " указаны в " + trim( val-str ) ) format "X(40)"
     4599                           string( "Документ N: " + v-doc-code + " от " + v-doc-date-string ) at 45 format "X(50)"
     4600                           ( if t-doc.status_ <> 'факт':U then
     4601                               string( "Статус документа: " + t-doc.status_ + " " + string( t-doc.flag_, "+/-" ) )
     4602                           else
     4603                               " " ) at 100 format "X(30)"
     4604                           string( "Страница " + string( PAGE-NUMBER( Out-stream ), ">>9" ) ) at 180 format "X(13)" skip
     4605                       .
     4606                       run write-header in this-procedure (
     4607                           input no
     4608                       ).
     4609               end.
     4610               else do:
     4611                   page stream Out-Stream.
     4612               end.
     4613           end.
     4614               end.
     4615       end.
     4616       accumulate
     4617           v-qnty (total)
     4618           v-sum-price (total)
     4619       .
     4620       assign
     4621           v-line-counter = v-line-counter + 1
     4622       .
     4623   end.
     4624   if line-counter( Out-stream ) + 12 > page-size( Out-stream )
     4625   then do:
     4626   define variable vss-include-info25 as character format "X(65)" no-undo
     4627   initial "@(#)$Workfile$ $Revision$".
     4628       if page-number( Out-Stream ) > PrevPage
     4629       then do:
     4630           assign
     4631               Pg-tqnty        = 0
     4632               Pg-stoim        = 0
     4633               Pg-stoim-VAT    = 0
     4634           .
     4635       end.
     4636           do:
     4637               PUT STREAM Out-Stream v-line-string format "X(198)" SKIP.
     4638               if v-line-counter <> 1
     4639               then do:
     4640                   DISPLAY STREAM Out-Stream
     4641                       "Итого"         @ v-gds-name
     4642                       Pg-tqnty        @ v-qnty
     4643                       Pg-stoim        @ v-sum-price
     4644                       with frame f-doc .
     4645                   DOWN STREAM Out-Stream 1 with FRAME f-doc .
     4646               end.
     4647               else do:
     4648                   page stream Out-Stream.
     4649               end.
     4650           end.
     4651       page stream Out-stream .
     4652   end.
     4653   hide stream Out-stream frame Bottomframe .
     4654   define variable vss-include-info26 as character format "X(65)" no-undo
     4655   initial "@(#)$Workfile$ $Revision$".
     4656       if page-number( Out-Stream ) > PrevPage
     4657       then do:
     4658           assign
     4659               Pg-tqnty        = 0
     4660               Pg-stoim        = 0
     4661               Pg-stoim-VAT    = 0
     4662           .
     4663       end.
     4664           do:
     4665               PUT STREAM Out-Stream v-line-string format "X(198)" SKIP.
     4666               if v-line-counter <> 1
     4667               then do:
     4668                   DISPLAY STREAM Out-Stream
     4669                       "Итого"         @ v-gds-name
     4670                       Pg-tqnty        @ v-qnty
     4671                       Pg-stoim        @ v-sum-price
     4672                       with frame f-doc .
     4673                   DOWN STREAM Out-Stream 1 with FRAME f-doc .
     4674               end.
     4675               else do:
     4676                   page stream Out-Stream.
     4677               end.
     4678           end.
     4679       display stream Out-stream
     4680           "Итого по всем"             @ v-gds-name
     4681           t-doc.fact-qnty             @ v-qnty
     4682           ( accum total v-sum-price ) @ v-sum-price
     4683           with frame f-doc
     4684       .
     4685   put stream Out-stream " " skip.
     4686   if PrintRubl then
     4687       run rep/wp-rub.p ( (accum total v-sum-price), output s1, output s2 ) .
     4688   else
     4689       run rep/wp.p ( input p-mainmenu-handle, (accum total v-sum-price), output s1, output s2 ) .
     4690   put stream Out-stream
     4691       string( "Сумма списания: " + caps(s1) ) format "X(198)"
     4692       skip(1)
     4693       skip "Вышеперечисленные материалы израсходованы:"
     4694            v-underline-string format "X(156)"
     4695       skip(1)
     4696       skip v-underline-string format "X(198)"
     4697       skip(1)
     4698       skip "Комиссия в составе:"
     4699       skip "Начальник Управления технического обеспечения:"
     4700            v-underline-string format "X(20)"      at 80
     4701            v-underline-string format "X(30)"      at 103
     4702       skip(1)
     4703       skip "Инженер:"
     4704            v-underline-string format "X(20)"      at 80
     4705            v-underline-string format "X(30)"      at 103
     4706   .
     4707   output stream Out-stream close.
     4708   if g#quest-print = false
     4709   then do:
     4710     run adecomm/_osprint.p ( ?, string( session:temp-directory + "rpt" + string( g#report-num ) ),
     4711                                         7, (if 8 >= 8 then 2 else 0), 0, 0,
     4712                                         OUTPUT g#log ).
     4713   end.
     4714   else do:
     4715     os-command silent
     4716       value( "COPY /b " +
     4717         string( session:temp-directory) +  "$" + string( g#report-num ) + " + " +
     4718         string( session:temp-directory) + "rpt" + string( g#report-num ) + " " +
     4719         string( session:temp-directory) +  "$" + string( g#report-num )
     4720                 ) .
     4721     os-command silent
     4722       value( "COPY /b " +
     4723         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl" + " + " +
     4724         string( session:temp-directory) + "rpt" + string( g#report-num ) + ".txl" + " " +
     4725         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl"
     4726                 ) .
     4727   end.
     4728   end.
     4729   procedure write-header :
     4730   do
     4731   on error undo, return error
     4732   :
     4733   define input parameter p-print-line-after   as logical      no-undo.
     4734       put stream out-stream
     4735           skip v-line-string format "X(198)"
     4736           skip ": N"
     4737               ": Артикул"                          at 8
     4738               ": Наименование "                    at 26
     4739               ":Ед."                               at 66
     4740               ":                Приход "           at 71
     4741               ":                Расход "           at 116
     4742               ": Объект "                          at 161
     4743               ":"                                  at 198
     4744           skip ": пп"
     4745               ": Артикул"                          at 8
     4746               ": материала "                       at 26
     4747               ":изм."                              at 66
     4748               ":--------------------------------------------:--------------------------------------------"                          at 71
     4749               ": расхода материала "               at 161
     4750               ":"                                  at 198
     4751           skip ": "
     4752               ": "                                 at 8
     4753               ": "                                 at 26
     4754               ": "                                 at 66
     4755               ": Кол"                              at 71
     4756               ": Цена"                             at 83
     4757               ": Сумма"                            at 98
     4758               ": Кол"                              at 116
     4759               ": Цена"                             at 128
     4760               ": Сумма"                            at 143
     4761               ": "                                 at 161
     4762               ":"                                  at 198
     4763       .
     4764       if p-print-line-after = yes
     4765       then do:
     4766           put stream out-stream
     4767               skip v-line-string format "X(198)"
     4768           .
     4769       end.
     4770   end.
     4771   end procedure.
