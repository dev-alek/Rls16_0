      953   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      954   procedure wthcattr-sprcli :
      955   define input parameter parparentproc  as widget-handle no-undo.
      956   define input parameter p-mode  as character no-undo.
      957   define input-output parameter p-value as character no-undo .
      958   define output parameter p-setted as logical no-undo .
      959     DEFINE VARIABLE v-value as character no-undo .
      960     define variable v-cli-type as character no-undo .
      961     define variable v-cli-code as integer no-undo .
      962     define buffer buf_clients   for ub.clients.
      963     define variable v_rid as character no-undo.
      964     define variable ref-rec as recid no-undo .
      965     do
      966     on error undo, return error
      967     :
      968         v-value = p-value.
      969      if p-value <> '':U then do:
      970       assign
      971       v-cli-type = substring(p-value, 1, 3)
      972       v-cli-code = integer(substring(p-value, 4))
      973       no-error.
      974       if error-status:error then do:
      975         assign
      976         v-cli-type = '':U
      977         v-cli-code = 0
      978         .
      979       end.
      980      end.
      981      FIND FIRST buf_clients NO-LOCK WHERE
      982               buf_clients.obj-type = v-cli-type AND
      983               buf_clients.obj-code = v-cli-code  NO-ERROR.
      984      IF available(buf_clients) then do:
      985       run ref/cli-all.w (
      986                   input parparentproc
      987                  ,input if p-mode = 'ИЗМЕНЕНИЕ':U then "b-sel":U else "":U
      988                  ,input v-cli-type
      989                  ,input 'все':U
      990                  ,input 'все':U
      991                  ,input RECID( buf_clients )
      992                  ,input ",,,,,,NO"
      993                  ,input ?
      994                  ,OUTPUT v_rid ).
      995     END.
      996     ELSE if p-mode = 'ИЗМЕНЕНИЕ':U then DO:
      997       run ref/cli-all.w (
      998                    input parparentproc
      999                   ,INPUT "b-sel":U
     1000                  ,input  v-cli-type
     1001                  ,input 'все':U
     1002                  ,input 'текущие':U
     1003                  ,input ?
     1004                  ,input ",,,,,,NO"
     1005                  ,input ?
     1006                  ,OUTPUT v_rid ).
     1007     END.
     1008     else do:
     1009       message
     1010       if p-value = "":U then 'Атрибут не задан!'
     1011       else substitute('Не найден клиент &1',p-value)
     1012       view-as alert-box warning.
     1013     end.
     1014     IF v_rid <> ? AND v_rid <> "":U THEN DO:
     1015       ASSIGN ref-rec = INT( v_rid ) NO-ERROR.
     1016       IF ERROR-STATUS:ERROR THEN DO:
     1017           RETURN NO-APPLY.
     1018       END.
     1019       FIND FIRST buf_clients NO-LOCK WHERE
     1020                  RECID( buf_clients ) = ref-rec NO-ERROR.
     1021       IF AVAIL buf_clients THEN DO:
     1022         v-value = buf_clients.obj-type + string(buf_clients.obj-code, ">>>>>>>>9").
     1023       end.
     1024     end.
     1025     if v-value <> p-value then do:
     1026       p-value = v-value.
     1027       p-setted = yes.
     1028     end.
     1029     end.
     1030   end procedure.
     1031     define new global shared variable g#wthcalib as handle no-undo.
     1032   procedure torgconf-read :
     1033   do
