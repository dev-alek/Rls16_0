        1   block-level on error undo, throw.
        2   do
        3   on error undo, return error
        4   :
        5   define input parameter p-mainmenu-handle    as handle           no-undo.
        6   define input parameter rec_id               as recid            no-undo.
        7   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        8   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        9   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       10   define variable vss-workfile    as character no-undo init "$Workfile: torg-16a.p $":U .
       11   define variable vss-archive     as character no-undo init "$Archive: rep/torg-16a.p $":U .
       12   define variable vss-description as character no-undo init "Печатные формы. Торг-16 для списания.".
       13   procedure vss-get-info :
       14     define output parameter p-vss-revision    like vss-revision    no-undo .
       15     define output parameter p-vss-author      like vss-author      no-undo .
       16     define output parameter p-vss-date        like vss-date        no-undo .
       17     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       18     define output parameter p-vss-archive     like vss-archive     no-undo .
       19     define output parameter p-vss-description like vss-description no-undo .
       20     assign
       21       p-vss-revision    = vss-revision
       22       p-vss-author      = vss-author
       23       p-vss-date        = vss-date
       24       p-vss-workfile    = vss-workfile
       25       p-vss-archive     = vss-archive
       26       p-vss-description = vss-description
       27     .
       28   end procedure.
       29   procedure vss-get-parameters :
       30     define output parameter p-vss-parameters as character no-undo .
       31   end procedure.
       32   define new global shared variable g#vssrevis-logger as handle    no-undo .
       33   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       34   define variable v-vssrevis-logger                   as handle    no-undo .
       35   procedure vss-logevent :
       36     define input  parameter p-extra-paramters as character no-undo .
       37     define variable v-vssrevis-parameters as character no-undo .
       38     do
       39     on error undo, return error return-value
       40     :
       41       if  valid-handle(v-vssrevis-logger)
       42       and v-vssrevis-logger :get-signature("logevent") <> ""
       43       then do:
       44         run vss-get-parameters in this-procedure
       45           (output v-vssrevis-parameters
       46           ).
       47         run logevent in v-vssrevis-logger
       48           (input vss-workfile
       49           ,input vss-revision
       50           ,input v-vssrevis-parameters
       51           ,input p-extra-paramters
       52           ).
       53       end.
       54     end.
       55   end procedure.
       56   assign
       57     v-vssrevis-logger = g#vssrevis-logger
       58   .
       59   if  valid-handle(v-vssrevis-logger)
       60   and v-vssrevis-logger :get-signature("logevent") <> ""
       61   then do:
       62     assign
       63       v-vssrevis-logevent = true
       64     .
       65     run vss-logevent in this-procedure (input vss-description) .
       66   end.
       67   define new global shared variable g#language as character no-undo .
       68   if g#language <> '' and g#language <> 'rus':U then do:
       69     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       70   end.
       71   define new global shared variable g#library  as handle no-undo .
       72   define new global shared variable g#library2 as handle no-undo .
       73   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       74   define  shared variable PrintCopiesCounter as integer   no-undo initial 1 .
       75   define  shared variable RepPathName        as character no-undo .
       76   define  shared variable PrintRubl          as logical   no-undo .
       77       def var t-addres        like ub.firm.addres1   no-undo.
       78       def var t-phone         like ub.firm.phone     no-undo.
       79       def var t-inn           like ub.firm.inn       no-undo.
       80       def var t-okpo          like ub.firm.okpo      no-undo.
       81       def var t-temp-address  like ub.firm.addres1   no-undo.
       82   define variable vss-include-info1 as character format "X(65)" no-undo
       83   initial "@(#)$Workfile$ $Revision$".
       84   define variable v-fmtcli-name          as character    no-undo.
       85   define variable v-fmtcli-engl-name     as character    no-undo.
       86   define variable v-fmtcli-addres        as character    no-undo.
       87   define variable v-fmtcli-post-addres   as character    no-undo.
       88   define variable v-fmtcli-full-addres   as character    no-undo.
       89   define variable v-fmtcli-phone         as character    no-undo.
       90   define variable v-fmtcli-inn           as character    no-undo.
       91   define variable v-fmtcli-kpp           as character    no-undo.
       92   define variable v-fmtcli-okpo          as character    no-undo.
       93   define variable v-fmtcli-country       as character    no-undo.
       94   define variable v-fmtcli-city          as character    no-undo.
       95   define variable v-fmtcli-index         as character    no-undo.
       96   define variable v-fmtcli-schet-exists  as logical      no-undo.
       97   define variable v-fmtcli-bank-exists   as logical      no-undo.
       98   define variable v-fmtcli-bank-r-schet  as character    no-undo.
       99   define variable v-fmtcli-bank-c-schet  as character    no-undo.
      100   define variable v-fmtcli-bank-bik      as character    no-undo.
      101   define variable v-fmtcli-bank-name     as character    no-undo.
      102   define variable v-fmtcli-bank-addres   as character    no-undo.
      103   define variable v-fmtcli-bank-city     as character    no-undo.
      104   procedure fmtcli-get-bank :
      105   define input parameter p-host-code      as integer          no-undo.
      106   define input parameter p-obj-type       as character        no-undo.
      107   define input parameter p-obj-code       as integer          no-undo.
      108   define input parameter p-curr-code      as integer          no-undo.
      109       define buffer buf_fin-schet     for ub.fin-schet.
      110       define buffer buf_fin-bank      for ub.fin-bank.
      111   do
      112   for buf_fin-schet
      113     , buf_fin-bank
      114   on error undo, return error
      115   :
      116       assign
      117           v-fmtcli-schet-exists       = no
      118           v-fmtcli-bank-exists        = no
      119           v-fmtcli-bank-r-schet       = "":U
      120           v-fmtcli-bank-c-schet       = "":U
      121           v-fmtcli-bank-bik           = "":U
      122           v-fmtcli-bank-name          = "":U
      123           v-fmtcli-bank-addres        = "":U
      124           v-fmtcli-bank-city          = "":U
      125       .
      126       search-for-schet:
      127       for each buf_fin-schet no-lock
      128          where buf_fin-schet.host-code = p-host-code
      129            and buf_fin-schet.cli-type  = p-obj-type
      130            and buf_fin-schet.cli-code  = p-obj-code
      131            and buf_fin-schet.curr-code = p-curr-code
      132       on error undo, return error
      133       :
      134           if buf_fin-schet.status_   = 'удал':U
      135           then do:
      136           end.
      137           else do:
      138               assign
      139                   v-fmtcli-schet-exists   = yes
      140                   v-fmtcli-bank-r-schet   = trim( buf_fin-schet.r-schet )
      141                   v-fmtcli-bank-c-schet   = trim( buf_fin-schet.c-schet )
      142               .
      143               find first buf_fin-bank no-lock
      144                    where buf_fin-bank.host-code = p-host-code
      145                      and buf_fin-bank.code-bank = buf_fin-schet.code-bank
      146               no-error.
      147               if available buf_fin-bank
      148               then do:
      149                   assign
      150                       v-fmtcli-bank-exists      = yes
      151                       v-fmtcli-bank-bik         = trim( buf_fin-bank.bik )
      152                       v-fmtcli-bank-name        = trim( buf_fin-bank.bank-name )
      153                       v-fmtcli-bank-addres      = trim(buf_fin-bank.addres)
      154                       v-fmtcli-bank-city      = trim(buf_fin-bank.bank-city)
      155                   .
      156               end.
      157               else do:
      158                   assign
      159                       v-fmtcli-bank-exists    = no
      160                       v-fmtcli-bank-bik       = "":U
      161                       v-fmtcli-bank-name      = "":U
      162                       v-fmtcli-bank-addres    = "":U
      163                       v-fmtcli-bank-city      = "":U
      164                   .
      165               end.
      166               leave search-for-schet.
      167           end.
      168       end.
      169   end.
      170   end procedure.
      171   procedure fmtcli-get-client :
      172   define input parameter p-obj-type       as character    no-undo.
      173   define input parameter p-obj-code       as integer      no-undo.
      174       define variable v-temp-fmtcli-address      as character     no-undo.
      175       define variable v-num-country-city    as integer      no-undo.
      176       define buffer buf_clients   for ub.clients.
      177       define buffer buf_firm      for ub.firm.
      178       define buffer buf_store     for ub.store.
      179       define buffer buf_shop      for ub.shop.
      180       define buffer buf_person    for ub.person.
      181   do
      182   for buf_clients
      183     , buf_firm
      184     , buf_store
      185     , buf_shop
      186     , buf_person
      187   on error undo, return error
      188   :
      189       assign
      190           v-fmtcli-name           = "":U
      191           v-fmtcli-addres         = "":U
      192           v-fmtcli-post-addres    = "":U
      193           v-fmtcli-full-addres    = "":U
      194           v-fmtcli-phone          = "":U
      195           v-fmtcli-inn            = "":U
      196           v-fmtcli-kpp            = "":U
      197           v-fmtcli-okpo           = "":U
      198           v-fmtcli-city           = "":U
      199           v-fmtcli-index          = "":U
      200           v-fmtcli-country        = "":U
      201       .
      202       find first buf_clients no-lock
      203            where buf_clients.obj-type = p-obj-type
      204              and buf_clients.obj-code = p-obj-code
      205       .
      206       assign
      207           v-fmtcli-name = buf_clients.obj-name
      208       .
      209       case buf_clients.obj-type:
      210          when 'орг':U
      211          then do:
      212               find first buf_firm no-lock
      213                    where buf_firm.firm-code = buf_clients.obj-code
      214                    no-error
      215               .
      216               if available buf_firm
      217               then do:
      218                   assign
      219                       v-num-country-city = num-entries( buf_firm.city )
      220                       v-fmtcli-engl-name = buf_firm.engl-name
      221                   .
      222                   if v-num-country-city > 0
      223                   then do:
      224                       assign
      225                           v-fmtcli-country    = trim( entry( 1, buf_firm.city ) )
      226                       .
      227                   end.
      228                   if v-num-country-city > 1
      229                   then do:
      230                       assign
      231                           v-fmtcli-city       = trim( entry( 2, buf_firm.city ) )
      232                       .
      233                   end.
      234                   run fmtcli-concatenate-strings in this-procedure (
      235                         input v-fmtcli-full-addres
      236                       , input v-fmtcli-country
      237                       , input ", ":U
      238                       , input 50
      239                       , output v-fmtcli-full-addres
      240                   ).
      241                   run fmtcli-concatenate-strings in this-procedure (
      242                         input v-fmtcli-full-addres
      243                       , input v-fmtcli-city
      244                       , input ", ":U
      245                       , input 50
      246                       , output v-fmtcli-full-addres
      247                   ).
      248                   run fmtcli-concatenate-strings in this-procedure (
      249                         input v-fmtcli-full-addres
      250                       , input IF buf_firm.ind = 0 THEN "" ELSE string( buf_firm.ind )
      251                       , input ", ":U
      252                       , input 50
      253                       , output v-fmtcli-full-addres
      254                   ).
      255                   run fmtcli-concatenate-strings in this-procedure (
      256                         input v-fmtcli-post-addres
      257                       , input v-fmtcli-country
      258                       , input ", ":U
      259                       , input 50
      260                       , output v-fmtcli-post-addres
      261                   ).
      262                   run fmtcli-concatenate-strings in this-procedure (
      263                         input v-fmtcli-post-addres
      264                       , input v-fmtcli-city
      265                       , input ", ":U
      266                       , input 50
      267                       , output v-fmtcli-post-addres
      268                   ).
      269                   run fmtcli-concatenate-strings in this-procedure (
      270                         input v-fmtcli-post-addres
      271                       , input string( buf_firm.ind )
      272                       , input ", ":U
      273                       , input 50
      274                       , output v-fmtcli-post-addres
      275                   ).
      276                   run fmtcli-concatenate-strings in this-procedure (
      277                         input substring( buf_firm.addres1, 1, 50 )
      278                       , input buf_firm.addres2
      279                       , input " ":U
      280                       , input 50
      281                       , output v-temp-fmtcli-address
      282                   ).
      283                   run fmtcli-concatenate-strings in this-procedure (
      284                         input v-temp-fmtcli-address
      285                       , input substring( buf_firm.addres1, 51, 50 )
      286                       , input " ":U
      287                       , input 50
      288                       , output v-temp-fmtcli-address
      289                   ).
      290                   run fmtcli-concatenate-strings in this-procedure (
      291                         input v-temp-fmtcli-address
      292                       , input substring( buf_firm.addres1, 101, 50 )
      293                       , input " ":U
      294                       , input 50
      295                       , output v-temp-fmtcli-address
      296                   ).
      297                   assign
      298                       v-fmtcli-addres = v-temp-fmtcli-address
      299                   .
      300                   if buf_firm.addres1 <> ?
      301                   then do:
      302                       run fmtcli-concatenate-strings in this-procedure (
      303                             input v-fmtcli-full-addres
      304                           , input v-fmtcli-addres
      305                           , input ", ":U
      306                           , input 0
      307                           , output v-fmtcli-full-addres
      308                       ).
      309                   end.
      310                   run fmtcli-concatenate-strings in this-procedure (
      311                         input substring( buf_firm.post-addr1, 1, 50 )
      312                       , input buf_firm.post-addr2
      313                       , input " ":U
      314                       , input 50
      315                       , output v-fmtcli-post-addres
      316                   ).
      317                   run fmtcli-concatenate-strings in this-procedure (
      318                         input v-fmtcli-post-addres
      319                       , input substring( buf_firm.post-addr1, 51, 50 )
      320                       , input " ":U
      321                       , input 50
      322                       , output v-fmtcli-post-addres
      323                   ).
      324                   run fmtcli-concatenate-strings in this-procedure (
      325                         input v-fmtcli-post-addres
      326                       , input substring( buf_firm.post-addr1, 101, 50 )
      327                       , input " ":U
      328                       , input 50
      329                       , output v-fmtcli-post-addres
      330                   ).
      331                   assign
      332                       v-fmtcli-phone         = buf_firm.phone
      333                       v-fmtcli-inn           = buf_firm.inn
      334                       v-fmtcli-kpp           = buf_firm.kpp
      335                       v-fmtcli-okpo          = buf_firm.okpo
      336                       v-fmtcli-index         = string( buf_firm.ind )
      337                   .
      338               end.
      339          end.
      340          when 'маг':U
      341          then do:
      342               find first buf_shop no-lock
      343                    where buf_shop.obj-code = buf_clients.obj-code
      344               .
      345               if available buf_shop
      346               then do:
      347                   run fmtcli-concatenate-strings in this-procedure (
      348                         input buf_shop.addres1
      349                       , input buf_shop.addres2
      350                       , input " ":U
      351                       , input 50
      352                       , output v-fmtcli-addres
      353                   ).
      354                   assign
      355                       v-fmtcli-full-addres = v-fmtcli-addres
      356                       v-fmtcli-post-addres = v-fmtcli-addres
      357                       v-fmtcli-phone       = buf_shop.phone
      358                       v-fmtcli-inn         = "":U
      359                       v-fmtcli-kpp         = "":U
      360                       v-fmtcli-okpo        = "":U
      361                       v-fmtcli-city        = "":U
      362                       v-fmtcli-index       = "":U
      363                   .
      364               end.
      365          end.
      366          when 'скл':U
      367          then do:
      368               find first buf_store no-lock
      369                    where buf_store.obj-code = buf_clients.obj-code
      370               .
      371               if available buf_store
      372               then do:
      373                   run fmtcli-concatenate-strings in this-procedure (
      374                         input buf_store.addres1
      375                       , input buf_store.addres2
      376                       , input " ":U
      377                       , input 50
      378                       , output v-fmtcli-addres
      379                   ).
      380                   assign
      381                       v-fmtcli-full-addres = v-fmtcli-addres
      382                       v-fmtcli-phone       = buf_store.phone
      383                       v-fmtcli-inn         = "":U
      384                       v-fmtcli-kpp         = "":U
      385                       v-fmtcli-okpo        = "":U
      386                       v-fmtcli-city        = "":U
      387                       v-fmtcli-index       = "":U
      388                   .
      389               end.
      390          end.
      391          when 'чел':U
      392          then do:
      393               find first buf_person no-lock
      394                    where buf_person.psn-code = buf_clients.obj-code
      395               .
      396               if available buf_person
      397               then do:
      398                   run fmtcli-concatenate-strings in this-procedure (
      399                         input ( if buf_person.ind = 0 or buf_person.ind = ?
      400                                 then "":U
      401                                 else string( buf_person.ind, "999999")
      402                                 )
      403                       , input buf_person.city
      404                       , input ", ":U
      405                       , input 0
      406                       , output v-fmtcli-full-addres
      407                   ).
      408                   assign
      409                       v-fmtcli-addres = buf_person.address
      410                   .
      411                   run fmtcli-concatenate-strings in this-procedure (
      412                         input v-fmtcli-full-addres
      413                       , input v-fmtcli-addres
      414                       , input ", ":U
      415                       , input 0
      416                       , output v-fmtcli-full-addres
      417                   ).
      418                   assign
      419                       v-fmtcli-phone     = buf_person.phone1
      420                       v-fmtcli-inn       = buf_person.inn
      421                       v-fmtcli-kpp       = buf_person.kpp
      422                       v-fmtcli-okpo      = buf_person.okpo
      423                       v-fmtcli-city      = buf_person.city
      424                       v-fmtcli-index     = string( buf_person.ind )
      425                   .
      426               end.
      427          end.
      428       end case.
      429   end.
      430   end procedure.
      431   procedure fmtcli-concatenate-strings :
      432   define input parameter p-string-1       as character        no-undo.
      433   define input parameter p-string-2       as character        no-undo.
      434   define input parameter p-delimiter      as character        no-undo.
      435   define input parameter p-length         as integer          no-undo.
      436   define output parameter p-out-string    as character        no-undo.
      437   do
      438   on error undo, return error
      439   :
      440       assign
      441           p-out-string = ( if p-string-1 = ?
      442                            then "":U
      443                            else trim( p-string-1 ) )
      444       .
      445       assign
      446           p-out-string = p-out-string
      447                        + ( if p-out-string = "":U
      448                            or length( p-out-string ) = p-length
      449                            or p-string-2 = ?
      450                            or trim( p-string-2 ) = "":U
      451                            then "":U
      452                            else p-delimiter )
      453                        + ( if p-string-2 = ?
      454                            or trim( p-string-2 ) = "":U
      455                            then "":U
      456                            else trim( p-string-2 ) )
      457       .
      458   end.
      459   end procedure.
      460   def var vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      461   define new global shared variable g#attr-lib  as handle no-undo .
      462   define variable v-attr-lib-variable as handle no-undo .
      463   procedure clntattr-code :
      464     define input  parameter p-code           as character no-undo .
      465     define output parameter p-type           as character no-undo .
      466     define output parameter p-format         as character no-undo .
      467     define output parameter p-label          as character no-undo .
      468     define output parameter p-user-can-edit  as logical   no-undo .
      469     define output parameter p-output-display as logical   no-undo .
      470     define output parameter p-other          as character no-undo .
      471     do
      472     on error undo, return error return-value
      473     :
      474           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run clntattr-code in g#attr-lib
      475         (input  p-code
      476         ,output p-type
      477         ,output p-format
      478         ,output p-label
      479         ,output p-user-can-edit
      480         ,output p-output-display
      481         ,output p-other
      482         ) no-error .
      483       if error-status :error
      484       then do:
      485         undo, return error return-value .
      486       end.
      487     end.
      488   end procedure.
      489   procedure clntattr-tooltip :
      490     define input  parameter p-code    as character no-undo .
      491     define output parameter p-tooltip as character no-undo .
      492     define output parameter p-label   as character no-undo .
      493     do
      494     on error undo, return error return-value
      495     :
      496           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run clntattr-tooltip in g#attr-lib
      497         (input  p-code
      498         ,output p-tooltip
      499         ,output p-label
      500         ) no-error .
      501       if error-status :error
      502       then do:
      503         undo, return error return-value .
      504       end.
      505     end.
      506   end procedure.
      507   procedure clntattr-value :
      508     define input  parameter p-obj-type like ub.clients-attr.obj-type   no-undo .
      509     define input  parameter p-obj-code like ub.clients-attr.obj-code   no-undo .
      510     define input  parameter p-code     like ub.clients-attr.attr-code  no-undo .
      511     define output parameter p-value    like ub.clients-attr.attr-value no-undo .
      512     define output parameter p-type     as character no-undo .
      513     do
      514     on error undo, return error return-value
      515     :
      516           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run clntattr-value in g#attr-lib
      517         (input  p-obj-type
      518         ,input  p-obj-code
      519         ,input  p-code
      520         ,output p-value
      521         ,output p-type
      522         ) no-error .
      523       if error-status :error
      524       then do:
      525         undo, return error return-value .
      526       end.
      527     end.
      528   end procedure.
      529   procedure clntattr-write :
      530     define input  parameter p-obj-type like ub.clients-attr.obj-type   no-undo .
      531     define input  parameter p-obj-code like ub.clients-attr.obj-code   no-undo .
      532     define input  parameter p-code     like ub.clients-attr.attr-code  no-undo .
      533     define input  parameter p-value    like ub.clients-attr.attr-value no-undo .
