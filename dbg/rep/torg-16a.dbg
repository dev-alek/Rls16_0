     1610   procedure torgconf-get-sup-param :
     1611   define input parameter p-obj-type           as character        no-undo.
     1612   define input parameter p-obj-code           as integer          no-undo.
     1613   define input parameter p-curr-code          as integer          no-undo.
     1614       define variable v-host-code    as integer      no-undo.
     1615       define variable v-par-type     as character    no-undo.
     1616   do
     1617   on error undo, return error
     1618   :
     1619       assign
     1620          v-torgconf-sup-host-code = v-host-code
     1621       .
     1622       if v-torgconf-sup-host-code = 0
     1623       then do:
     1624           assign
     1625               v-torgconf-sup-host-name           = "":U
     1626               v-torgconf-sup-host-addres         = "":U
     1627               v-torgconf-sup-host-post-addres    = "":U
     1628               v-torgconf-sup-host-phone          = "":U
     1629               v-torgconf-sup-host-inn            = "":U
     1630               v-torgconf-sup-host-kpp            = "":U
     1631               v-torgconf-sup-host-okpo           = "":U
     1632               v-torgconf-sup-host-egrip-date     = "":U
     1633               v-torgconf-sup-host-egrip-num      = "":U
     1634           .
     1635       end.
     1636       else do:
     1637           run fmtcli-get-client in this-procedure (
     1638                 input 'орг':U
     1639               , input v-torgconf-sup-host-code
     1640           ).
     1641           assign
     1642               v-torgconf-sup-host-name        = v-fmtcli-name
     1643               v-torgconf-sup-host-engl-name   = v-fmtcli-engl-name
     1644               v-torgconf-sup-host-addres      = v-fmtcli-full-addres
     1645               v-torgconf-sup-host-post-addres = v-fmtcli-post-addres
     1646               v-torgconf-sup-host-phone       = v-fmtcli-phone
     1647               v-torgconf-sup-host-inn         = v-fmtcli-inn
     1648               v-torgconf-sup-host-kpp         = v-fmtcli-kpp
     1649               v-torgconf-sup-host-okpo        = v-fmtcli-okpo
     1650           .
     1651           run gbl/clntat-v.p (
     1652                 input 'орг':U
     1653               , input v-torgconf-sup-host-code
     1654               , input 'egrip-date':U
     1655               , output v-torgconf-sup-host-egrip-date
     1656               , output v-par-type
     1657           ).
     1658           run gbl/clntat-v.p (
     1659                 input 'орг':U
     1660               , input v-torgconf-sup-host-code
     1661               , input 'egrip-num':U
     1662               , output v-torgconf-sup-host-egrip-num
     1663               , output v-par-type
     1664           ).
     1665           run fmtcli-get-bank in this-procedure (
     1666                 input v-host-code
     1667               , input 'орг':U
     1668               , input v-torgconf-sup-host-code
     1669               , input p-curr-code
     1670           ).
     1671       end.
     1672       assign
     1673           v-torgconf-sup-schet-exists = v-fmtcli-schet-exists
     1674           v-torgconf-sup-bank-exists  = v-fmtcli-bank-exists
     1675           v-torgconf-sup-bank-r-schet = v-fmtcli-bank-r-schet
     1676           v-torgconf-sup-bank-c-schet = v-fmtcli-bank-c-schet
     1677           v-torgconf-sup-bank-bik     = v-fmtcli-bank-bik
     1678           v-torgconf-sup-bank-name    = v-fmtcli-bank-name
     1679           v-torgconf-sup-bank-addres  = v-fmtcli-bank-addres
     1680           v-torgconf-sup-bank-city    = v-fmtcli-bank-city
     1681       .
     1682       assign
     1683           v-torgconf-sup-obj-type = p-obj-type
     1684           v-torgconf-sup-obj-code = p-obj-code
     1685       .
     1686       if trim(p-obj-type) <> ""
     1687       and p-obj-code <> 0
     1688       then do:
     1689       run fmtcli-get-client in this-procedure (
     1690             input p-obj-type
     1691           , input p-obj-code
     1692       ).
     1693       assign
     1694           v-torgconf-sup-obj-name        = v-fmtcli-name
     1695           v-torgconf-sup-obj-engl-name   = v-fmtcli-engl-name
     1696           v-torgconf-sup-obj-addres      = v-fmtcli-full-addres
     1697           v-torgconf-temp-post-addres    = v-fmtcli-post-addres
     1698           v-torgconf-sup-obj-phone       = v-fmtcli-phone
     1699           v-torgconf-sup-obj-inn         = v-fmtcli-inn
     1700           v-torgconf-sup-obj-okpo        = v-fmtcli-okpo
     1701       .
     1702      end.
     1703      end.
     1704   end procedure.
     1705   procedure torgconf-get-cli-param :
     1706   define input parameter p-host-obj-code      as integer          no-undo.
     1707   define input parameter p-obj-type           as character        no-undo.
     1708   define input parameter p-obj-code           as integer          no-undo.
     1709   define input parameter p-curr-code          as integer          no-undo.
     1710       define variable v-host-code    as integer      no-undo.
     1711   do
     1712   on error undo, return error
     1713   :
     1714       assign
     1715           v-torgconf-cli-type = p-obj-type
     1716           v-torgconf-cli-code = p-obj-code
     1717       .
     1718       run fmtcli-get-client in this-procedure (
     1719             input p-obj-type
     1720           , input p-obj-code
     1721       ).
     1722       assign
     1723           v-torgconf-cli-name         = trim( v-fmtcli-name          )
     1724           v-torgconf-cli-engl-name    = trim( v-fmtcli-engl-name          )
     1725           v-torgconf-cli-addres       = trim( v-fmtcli-full-addres   )
     1726           v-torgconf-cli-post-addres  = trim( v-fmtcli-post-addres   )
     1727           v-torgconf-cli-phone        = trim( v-fmtcli-phone         )
     1728           v-torgconf-cli-inn          = trim( v-fmtcli-inn           )
     1729           v-torgconf-cli-kpp          = trim( v-fmtcli-kpp           )
     1730           v-torgconf-cli-okpo         = trim( v-fmtcli-okpo          )
     1731       .
     1732      run fmtcli-get-bank in this-procedure (
     1733             input p-host-obj-code
     1734           , input p-obj-type
     1735           , input p-obj-code
     1736           , input p-curr-code
     1737       ).
     1738       assign
     1739           v-torgconf-cli-schet-exists = v-fmtcli-schet-exists
     1740           v-torgconf-cli-bank-exists  = v-fmtcli-bank-exists
     1741           v-torgconf-cli-bank-r-schet = v-fmtcli-bank-r-schet
     1742           v-torgconf-cli-bank-c-schet = v-fmtcli-bank-c-schet
     1743           v-torgconf-cli-bank-bik     = v-fmtcli-bank-bik
     1744           v-torgconf-cli-bank-name    = v-fmtcli-bank-name
     1745           v-torgconf-cli-bank-addres  = v-fmtcli-bank-addres
     1746           v-torgconf-cli-bank-city    = v-fmtcli-bank-city
     1747       .
     1748   end.
     1749   end procedure.
     1750   procedure torgconf-get-ship-param :
     1751   define input parameter p-host-obj-code      as integer          no-undo.
     1752   define input parameter p-obj-type           as character        no-undo.
     1753   define input parameter p-obj-code           as integer          no-undo.
     1754   define input parameter p-curr-code          as integer          no-undo.
     1755       define variable v-host-code    as integer      no-undo.
     1756   do
     1757   on error undo, return error
     1758   :
     1759       assign
     1760           v-torgconf-ship-type = p-obj-type
     1761           v-torgconf-ship-code = p-obj-code
     1762       .
     1763       if trim(p-obj-type) = ""
     1764       and p-obj-code = 0
     1765       then do:
     1766       assign
     1767           v-torgconf-ship-name         = "":U
     1768           v-torgconf-ship-addres       = "":U
     1769           v-torgconf-ship-post-addres  = "":U
     1770           v-torgconf-ship-phone        = "":U
     1771           v-torgconf-ship-inn          = "":U
     1772           v-torgconf-ship-kpp          = "":U
     1773           v-torgconf-ship-okpo         = "":U
     1774       .
     1775       end.
     1776       else do:
     1777       run fmtcli-get-client in this-procedure (
     1778             input p-obj-type
     1779           , input p-obj-code
     1780       ).
     1781       assign
     1782           v-torgconf-ship-name         = trim( v-fmtcli-name          )
     1783           v-torgconf-ship-engl-name    = trim( v-fmtcli-engl-name          )
     1784           v-torgconf-ship-addres       = trim( v-fmtcli-full-addres   )
     1785           v-torgconf-ship-post-addres  = trim( v-fmtcli-post-addres   )
     1786           v-torgconf-ship-phone        = trim( v-fmtcli-phone         )
     1787           v-torgconf-ship-inn          = trim( v-fmtcli-inn           )
     1788           v-torgconf-ship-kpp          = trim( v-fmtcli-kpp           )
     1789           v-torgconf-ship-okpo         = trim( v-fmtcli-okpo          )
     1790       .
     1791       end.
     1792           run fmtcli-get-bank in this-procedure (
     1793             input p-host-obj-code
     1794           , input p-obj-type
     1795           , input p-obj-code
     1796           , input p-curr-code
     1797       ).
     1798       assign
     1799           v-torgconf-ship-schet-exists = v-fmtcli-schet-exists
     1800           v-torgconf-ship-bank-exists  = v-fmtcli-bank-exists
     1801           v-torgconf-ship-bank-r-schet = v-fmtcli-bank-r-schet
     1802           v-torgconf-ship-bank-c-schet = v-fmtcli-bank-c-schet
     1803           v-torgconf-ship-bank-bik     = v-fmtcli-bank-bik
     1804           v-torgconf-ship-bank-name    = v-fmtcli-bank-name
     1805           v-torgconf-ship-bank-addres  = v-fmtcli-bank-addres
     1806           v-torgconf-ship-bank-city    = v-fmtcli-bank-city
     1807       .
     1808   end.
     1809   end procedure.
     1810   procedure torgconf-get-holdfirm-code :
     1811   define input parameter p-obj-type   as character        no-undo.
     1812   define input parameter p-obj-code   as integer          no-undo.
     1813   define output parameter p-firm-code as integer          no-undo.
     1814       define variable v-firm-code-str     as character    no-undo.
     1815       define variable v-par-type          as character    no-undo.
     1816       define buffer buf_clients       for ub.clients.
     1817   do
     1818   for buf_clients
     1819   on error undo, return error
     1820   :
     1821       run gbl/clntat-v.p (
     1822             input p-obj-type
     1823           , input p-obj-code
     1824           , input 'holdfirm-code':U
     1825           , output v-firm-code-str
     1826           , output v-par-type
     1827       ).
     1828       assign
     1829           p-firm-code = integer( v-firm-code-str )
     1830       no-error.
     1831       if error-status :error
     1832       then do:
     1833           message
     1834               "Неверно задан код фирмы для печати накладных."
     1835           view-as alert-box warning.
     1836           assign
     1837               p-firm-code = 0
     1838           .
     1839       end.
     1840       else do:
     1841           find first buf_clients no-lock
     1842                where buf_clients.obj-type = 'орг':U
     1843                  and buf_clients.obj-code = p-firm-code
     1844           no-error.
     1845           if not available buf_clients
     1846           then do:
     1847               message
     1848                   "Включен параметр 'Список печатных форм, для которых должна быть задана фирма для печати накладных' (outhold)" skip
     1849                   "Не найдена фирма по заданному коду фирмы для печати накладных."
     1850               view-as alert-box warning.
     1851               assign
     1852                   p-firm-code = 0
     1853               .
     1854           end.
     1855       end.
     1856   end.
     1857   end procedure.
     1858   procedure torgconf-get-post-head:
     1859   define input  parameter p-obj-type             as character        no-undo.
     1860   define input  parameter p-obj-code             as integer          no-undo.
     1861   define output parameter p-torgconf-post-head   as character        no-undo.
     1862      define variable v-host-code         as integer      no-undo.
     1863      define buffer buf_sysconf     for ub.sysconf.
     1864        assign
     1865         p-torgconf-post-head  = ""
     1866        .
     1867   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1868   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1869     (input  p-obj-type
     1870     ,input  p-obj-code
     1871     ,output v-host-code
     1872     )  .
     1873      find first buf_sysconf no-lock
     1874      where buf_sysconf.host-code = v-host-code
     1875      no-error.
     1876      if available buf_sysconf
     1877      then do:
     1878         assign
     1879            p-torgconf-post-head = buf_sysconf.head-position
     1880         .
     1881      end.
     1882   end procedure.
     1883   procedure torgconf-get-storekeeper:
     1884   define input  parameter p-wrkr                   as integer          no-undo.
     1885   define output parameter p-torgconf-wrkr-name     as character        no-undo.
     1886   define output parameter p-torgconf-post          as character        no-undo.
     1887      define buffer buf_sysconf     for ub.sysconf.
     1888      define buffer buf_person      for ub.person.
     1889      define buffer buf_shop        for ub.shop .
     1890      define buffer buf_store       for ub.store .
     1891      if v-torgconf-outC = "no_print"
     1892      then do:
     1893         assign p-torgconf-post = ""
     1894                p-torgconf-wrkr-name = ""
     1895                .
     1896      end.
     1897      if v-torgconf-outC = "clad_doc"
     1898      then do:
     1899         run rep/get-psn.p
     1900               (input  p-wrkr
     1901               ,output p-torgconf-wrkr-name
     1902               ) .
     1903         find first buf_person no-lock
     1904         where buf_person.psn-code = p-wrkr
     1905         no-error.
     1906         if available buf_person
     1907         then do:
     1908           p-torgconf-post = buf_person.position.
     1909         end.
     1910         if p-torgconf-post = "?":U then p-torgconf-post = "".
     1911         if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     1912      end.
     1913      if v-torgconf-outC = "clad_obj"
     1914      then do:
     1915         CASE v-torgconf-self-obj-type:
     1916         WHEN 'маг':U
     1917         THEN DO:
     1918            find first buf_shop no-lock
     1919            where buf_shop.obj-code = v-torgconf-self-obj-code
     1920            .
     1921            assign
     1922               p-torgconf-wrkr-name = buf_shop.store-man
     1923               p-torgconf-post = ""
     1924            .
     1925            if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     1926         END.
     1927         WHEN 'скл':U
     1928         THEN DO:
     1929            find first buf_store no-lock
     1930            where buf_store.obj-code = v-torgconf-self-obj-code
     1931            .
     1932            assign
     1933               p-torgconf-wrkr-name = buf_store.store-man
     1934               p-torgconf-post = ""
     1935            .
     1936            if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     1937         END.
     1938         OTHERWISE DO:
     1939            assign
     1940               p-torgconf-post = "":U
     1941               p-torgconf-wrkr-name = "":U
     1942            .
     1943         END.
     1944         END CASE.
     1945      end.
     1946    end procedure.
     1947   procedure torgconf-get-form-header :
     1948   define input parameter p-for-inverse    as logical          no-undo.
     1949   define input parameter p-doc-code       as character        no-undo.
     1950   define input parameter p-print-doc      as logical          no-undo.
     1951   define input parameter p-doc-date       as date             no-undo.
     1952   define input parameter p-fact-date      as date             no-undo.
     1953   define input parameter p-doc-type       as character        no-undo.
     1954   define input parameter p-status_        as character        no-undo.
     1955   define input parameter p-reverse        as logical          no-undo.
     1956   define input parameter p-sf-par         as logical          no-undo.
     1957       define variable v-attr-type         as character    no-undo.
     1958       define variable v-doc-code-standard as logical      no-undo.
     1959       define variable v-doc-date-standard as logical      no-undo.
     1960       define variable v-par-consignee-addres  as character    no-undo.
     1961       define variable v-host-code         as integer      no-undo.
     1962       define variable v-dcode-attr        as character    no-undo.
     1963       define variable v-ddate-attr        as character    no-undo.
     1964       define variable v-doc-date          as character    no-undo.
     1965       define variable v-doc-code          as character    no-undo.
     1966       define variable v-par-type          as character    no-undo.
     1967       define variable v-attr              as character    no-undo.
     1968       define buffer buf_firm          for ub.firm .
     1969       define buffer buf_clients       for ub.clients .
     1970       define buffer buf_sysconf       for ub.sysconf .
     1971       define buffer buf_shop          for ub.shop .
     1972       define buffer buf_store         for ub.store .
     1973       define buffer buf_person        for ub.person .
     1974       define buffer buf_trn-doc       for ub.trn-doc .
     1975       define buffer buf_wth-doc       for ub.wth-doc .
     1976       do
     1977   for buf_firm
     1978     , buf_clients
     1979     , buf_sysconf
     1980     , buf_shop
     1981     , buf_trn-doc
     1982     , buf_person
     1983     , buf_wth-doc
     1984   on error undo, return error
     1985   :
     1986       if p-doc-type = 'при':U
     1987       or p-doc-type = 'возврат':U
     1988       then do:
     1989           assign
     1990               v-torgconf-supplier         = substitute( "&1&2&3&4&5", v-torgconf-cli-name, ( if v-torgconf-cli-addres = "":U then "":U else ", " ),
     1991                                             v-torgconf-cli-addres, ( if v-torgconf-cli-phone = "":U then "":U else ", " ), v-torgconf-cli-phone )
     1992               v-torgconf-suppi            = substitute( "&1&2&3&4&5", v-torgconf-cli-name, ( if v-torgconf-cli-addres = "":U then "":U else ", " ),
     1993                                             v-torgconf-cli-addres, ( if v-torgconf-cli-phone = "":U then "":U else ", " ), v-torgconf-cli-phone )
     1994               v-torgconf-saler            = substitute( "&1&2&3&4&5", v-torgconf-self-host-name, ( if v-torgconf-self-host-addres = "":U then "":U else ", " ),
     1995                                             v-torgconf-self-host-addres, ( if v-torgconf-self-host-phone = "":U then "":U else ", " ),v-torgconf-self-host-phone )
     1996               v-torgconf-consignee        = substitute( "&1&2&3&4&5", v-torgconf-sup-host-name, ( if v-torgconf-sup-host-addres = "":U then "":U else ", " ),
     1997                                             v-torgconf-sup-host-addres, ( if v-torgconf-sup-host-phone = "":U then "":U else ", " ), v-torgconf-sup-host-phone  )
     1998               v-torgconf-supplier-okpo    = v-torgconf-cli-okpo
     1999               v-torgconf-saler-okpo       = v-torgconf-self-host-okpo
     2000               v-torgconf-consignee-okpo   = v-torgconf-sup-host-okpo
     2001               v-torgconf-supplier-code    = substitute( "&1", v-torgconf-cli-code         )
     2002               v-torgconf-supplier-type    = v-torgconf-cli-type
     2003               v-torgconf-saler-code       = substitute( "&1", v-torgconf-self-host-code   )
     2004               v-torgconf-saler-type       = v-torgconf-self-host-type
     2005               v-torgconf-consignee-code   = substitute( "&1", v-torgconf-sup-host-code   )
     2006               v-torgconf-consignee-type   = v-torgconf-sup-host-type
     2007               v-torgconf-supplier-name    = substitute( "&1", v-torgconf-cli-name         )
     2008               v-torgconf-saler-name       = substitute( "&1", v-torgconf-self-host-name   )
     2009               v-torgconf-consignee-name   = substitute( "&1", v-torgconf-sup-host-name   )
     2010               v-torgconf-supplier-addr    = substitute( "&1", v-torgconf-cli-addres       )
     2011               v-torgconf-saler-addr       = substitute( "&1", v-torgconf-self-host-addres )
     2012               v-torgconf-consignee-addr   = substitute( "&1", v-torgconf-sup-host-addres )
     2013               v-torgconf-supplier-inn     = substitute( "&1", v-torgconf-cli-inn          )
     2014               v-torgconf-supplier-engl-name     = substitute( "&1", v-torgconf-cli-engl-name          )
     2015               v-torgconf-saler-inn        = substitute( "&1", v-torgconf-self-host-inn    )
     2016               v-torgconf-consignee-inn    = substitute( "&1", v-torgconf-sup-host-inn    )
     2017               v-torgconf-supplier-kpp     = substitute( "&1", v-torgconf-cli-kpp          )
     2018               v-torgconf-saler-kpp        = substitute( "&1", v-torgconf-self-host-kpp    )
     2019               v-torgconf-consignee-kpp    = substitute( "&1", v-torgconf-sup-host-kpp    )
     2020           .
     2021           if v-torgconf-cli-schet-exists = yes
     2022           AND v-form-name                  = "torg12":U
     2023           then do:
     2024               assign
     2025                   v-torgconf-supplier = v-torgconf-supplier
     2026                       + substitute( ", р/с &1 к/с &2"
     2027                                   , v-torgconf-cli-bank-r-schet
     2028                                   , v-torgconf-cli-bank-c-schet
     2029                                   )
     2030                   v-torgconf-suppi = v-torgconf-supplier
     2031                       + substitute( ", р/с &1 к/с &2"
     2032                                   , v-torgconf-cli-bank-r-schet
     2033                                   , v-torgconf-cli-bank-c-schet
     2034                                   )
     2035               .
     2036               if v-torgconf-cli-bank-exists = yes
     2037               then do:
     2038                   assign
     2039                       v-torgconf-supplier = v-torgconf-supplier
     2040                           + substitute( " БИК &1 в &2 &3"
     2041                                       , v-torgconf-cli-bank-bik
     2042                                       , v-torgconf-cli-bank-name
     2043                                       ,(if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) )
     2044                                       )
     2045                      v-torgconf-suppi = v-torgconf-supplier
     2046                           + substitute( " БИК &1 в &2 &3"
     2047                                       , v-torgconf-cli-bank-bik
     2048                                       , v-torgconf-cli-bank-name
     2049                                       ,(if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) )
     2050                                       )
     2051                   .
     2052               end.
     2053           end.
     2054           if v-torgconf-self-schet-exists = yes
     2055           AND v-form-name                  = "torg12":U
     2056           then do:
     2057               assign
     2058                   v-torgconf-saler = v-torgconf-saler
     2059                       + substitute( ", р/с &1 к/с &2"
     2060                                   , v-torgconf-self-bank-r-schet
     2061                                   , v-torgconf-self-bank-c-schet
     2062                                   )
     2063               .
     2064               if v-torgconf-self-bank-exists = yes
     2065               then do:
     2066                   assign
     2067                       v-torgconf-saler = v-torgconf-saler
     2068                           + substitute( " БИК &1 в &2 &3"
     2069                                       , v-torgconf-self-bank-bik
     2070                                       , v-torgconf-self-bank-name
     2071                                       , v-torgconf-self-bank-addres
     2072                                       )
     2073                   .
     2074               end.
     2075           end.
     2076           if v-torgconf-sup-schet-exists = yes
     2077           AND v-form-name                  = "torg12":U
     2078           then do:
     2079               assign
     2080                   v-torgconf-consignee = v-torgconf-consignee
     2081                       + substitute( ", р/с &1 к/с &2"
     2082                                   , v-torgconf-sup-bank-r-schet
     2083                                   , v-torgconf-sup-bank-c-schet
     2084                                   )
     2085               .
     2086             if v-torgconf-sup-bank-exists = yes
     2087              then do:
     2088                assign
     2089                   v-torgconf-consignee = v-torgconf-consignee
     2090                           + substitute( " БИК &1 в &2 &3"
     2091                                       , v-torgconf-sup-bank-bik
     2092                                       , v-torgconf-sup-bank-name
     2093                                       , v-torgconf-sup-bank-addres
     2094                                       )
     2095                   .
     2096               end.
     2097           end.
     2098      if v-torgconf-outares = yes  AND v-form-name  = "torg12":U
     2099      then do:
     2100          assign
     2101            v-torgconf-supplier = substitute(  "&1&2&3 &4 &5&6"
     2102                                                   , IF v-form-name = "torg12":U THEN SUBSTITUTE("ИНН &1 КПП &2 ", v-torgconf-cli-inn, v-torgconf-cli-kpp) ELSE "":U
     2103                                                   , v-torgconf-cli-name
     2104                                                   , ( if v-torgconf-outprncd = yes
     2105                                                         then substitute( " (&1)", v-torgconf-cli-code )
     2106                                                         else "":U )
     2107                                                   , v-torgconf-cli-post-addres
     2108                                                   , v-torgconf-cli-phone
     2109                                                   , ( if v-torgconf-cli-bank-r-schet <> "":U
     2110                                                       AND v-form-name                  = "torg12":U
