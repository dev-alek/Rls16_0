     1107   empty temp-table thbjattr_thbj-attr.
     1108   run adm/shattri.p (
     1109      input "get":U
     1110     ,input p-obj-type
     1111     ,input p-obj-code
     1112     ,input 'prt-obj':U
     1113     ,input  ""
     1114     ,output v-value-character
     1115     ,output v-value-date
     1116     ,output v-value-decimal
     1117     ,output v-value-integer
     1118     ,output v-value-logical
     1119     ,output par-type
     1120     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     1121     ) no-error .
     1122   for each thbjattr_thbj-attr :
     1123       if thbjattr_thbj-attr.prop-code = 'outdate':U  then v-outdate  =  thbjattr_thbj-attr.property-value-character .
     1124       if thbjattr_thbj-attr.prop-code = 'outares':U  then v-outares  =  thbjattr_thbj-attr.property-value-character .
     1125       if thbjattr_thbj-attr.prop-code = 'outnum':U   then v-outnum   =  thbjattr_thbj-attr.property-value-character .
     1126       if thbjattr_thbj-attr.prop-code = 'outprim':U  then v-outprim  =  thbjattr_thbj-attr.property-value-character .
     1127       if thbjattr_thbj-attr.prop-code = 'outdisc':U  then v-outdisc  =  thbjattr_thbj-attr.property-value-character .
     1128       if thbjattr_thbj-attr.prop-code = 'outsubs':U  then v-outsubs  =  thbjattr_thbj-attr.property-value-character .
     1129       if thbjattr_thbj-attr.prop-code = 'outegrp':U  then v-outegrp  =  thbjattr_thbj-attr.property-value-character .
     1130       if thbjattr_thbj-attr.prop-code = 'outt12':U   then v-outt12   =  thbjattr_thbj-attr.property-value-character .
     1131       if thbjattr_thbj-attr.prop-code = 'outappr':U  then v-outappr  =  thbjattr_thbj-attr.property-value-character .
     1132       if thbjattr_thbj-attr.prop-code = 'outrubl':U  then v-outrubl  =  thbjattr_thbj-attr.property-value-character .
     1133       if thbjattr_thbj-attr.prop-code = 'outhold':U  then v-outhold  =  thbjattr_thbj-attr.property-value-character .
     1134       if thbjattr_thbj-attr.prop-code = 'outobj':U   then v-outobj   =  thbjattr_thbj-attr.property-value-character .
     1135       if thbjattr_thbj-attr.prop-code = 'outsend':U  then v-outsend  =  thbjattr_thbj-attr.property-value-character .
     1136       if thbjattr_thbj-attr.prop-code = 'outasend':U then v-outasend =  thbjattr_thbj-attr.property-value-character .
     1137       if thbjattr_thbj-attr.prop-code = 'outogr':U   then v-torgconf-outogr   =  thbjattr_thbj-attr.property-value-character .
     1138       if thbjattr_thbj-attr.prop-code = 'outR':U     then v-torgconf-outR     =  thbjattr_thbj-attr.property-value-character .
     1139       if thbjattr_thbj-attr.prop-code = 'outB':U     then v-torgconf-outB     =  thbjattr_thbj-attr.property-value-character .
     1140       if thbjattr_thbj-attr.prop-code = 'outssdoc':U then v-torgconf-outssdoc =  thbjattr_thbj-attr.property-value-character .
     1141       if thbjattr_thbj-attr.prop-code = 'outC':U     then v-torgconf-outC     =  thbjattr_thbj-attr.property-value-character .
     1142   end.
     1143       run gbl/conf-rd.p ("outexpas", "":U, "":U, 0, "":U, "":U, "":U, no, output v-torgconf-outexpas, output v-par-type) no-error.
     1144       if error-status :error
     1145       then do:
     1146           assign
     1147               v-torgconf-outexpas = "":U
     1148           .
     1149       end.
     1150       assign
     1151           v-torgconf-outprncd = ( v-outprncd = "yes":U )
     1152       .
     1153       if p-form-name <> ""
     1154       and p-form-name <> ?
     1155       then do:
     1156           run gbl/conf-rd.p ("outexlst" , p-host-code, p-obj-type, p-obj-code, "", "", "", no, output v-outexlst , output v-par-type) no-error.
     1157           if error-status :error
     1158           then do:
     1159               assign
     1160                   v-outexlst           = ""
     1161               .
     1162           end.
     1163           if lookup( p-form-name, v-outdate ) <> 0
     1164           then do:
     1165               assign
     1166                   v-torgconf-outdate  = yes
     1167               .
     1168           end.
     1169           if lookup( p-form-name, v-outares ) <> 0
     1170           then do:
     1171               assign
     1172                   v-torgconf-outares  = yes
     1173               .
     1174           end.
     1175           if lookup( p-form-name, v-outnum  ) <> 0
     1176           then do:
     1177               assign
     1178                   v-torgconf-outnum   = yes
     1179               .
     1180           end.
     1181           if lookup( p-form-name, v-outprim ) <> 0
     1182           then do:
     1183               assign
     1184                   v-torgconf-outprim  = yes
     1185               .
     1186           end.
     1187           if lookup( p-form-name, v-outdisc ) <> 0
     1188           then do:
     1189               assign
     1190                   v-torgconf-outdisc  = yes
     1191               .
     1192           end.
     1193           if lookup( p-form-name, v-outsubs ) <> 0
     1194           then do:
     1195               assign
     1196                   v-torgconf-outsubs  = yes
     1197               .
     1198           end.
     1199           if lookup( p-form-name, v-outrecv ) <> 0
     1200           then do:
     1201               assign
     1202                   v-torgconf-outrecv  = yes
     1203               .
     1204           end.
     1205           if lookup( p-form-name, v-outegrp ) <> 0
     1206           then do:
     1207               assign
     1208                   v-torgconf-outegrp  = yes
     1209               .
     1210           end.
     1211           if lookup( p-form-name, v-outt12  ) <> 0
     1212           then do:
     1213               assign
     1214                   v-torgconf-outt12   = yes
     1215               .
     1216           end.
     1217           if lookup( p-form-name, v-outappr  ) <> 0
     1218           then do:
     1219               assign
     1220                   v-torgconf-outappr   = yes
     1221               .
     1222           end.
     1223           if lookup( p-form-name, v-outrubl  ) <> 0
     1224           then do:
     1225               assign
     1226                   v-torgconf-outrubl   = yes
     1227               .
     1228           end.
     1229           if lookup( p-form-name, v-outhold  ) <> 0
     1230           then do:
     1231               assign
     1232                   v-torgconf-outhold   = yes
     1233               .
     1234           end.
     1235           if lookup( p-form-name, v-outobj   ) <> 0
     1236           then do:
     1237               assign
     1238                   v-torgconf-outobj    = yes
     1239               .
     1240           end.
     1241           if lookup( p-form-name, v-outsend   ) <> 0
     1242           then do:
     1243               assign
     1244                   v-torgconf-outsend    = yes
     1245               .
     1246           end.
     1247           if lookup( p-form-name, v-outasend   ) <> 0
     1248           then do:
     1249               assign
     1250                   v-torgconf-outasend    = yes
     1251               .
     1252           end.
     1253           if lookup( p-form-name, v-outprops   ) <> 0
     1254           then do:
     1255               assign
     1256                   v-torgconf-outprops    = yes
     1257               .
     1258           end.
     1259           if lookup( p-form-name, v-outexlst ) <> 0
     1260           then do:
     1261               assign
     1262                   v-torgconf-outexlst  = yes
     1263               .
     1264           end.
     1265        assign
     1266         v-name = p-form-name.
     1267   end.
     1268   end.
     1269   end procedure.
     1270   procedure torgconf-get-self-param :
     1271   define input parameter p-obj-type           as character        no-undo.
     1272   define input parameter p-obj-code           as integer          no-undo.
     1273   define input parameter p-curr-code          as integer          no-undo.
     1274       define variable v-host-code    as integer      no-undo.
     1275       define variable v-par-type     as character    no-undo.
     1276   do
     1277   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message(1))
     1278   :
     1279   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1280   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1281     (input  p-obj-type
     1282     ,input  p-obj-code
     1283     ,output v-host-code
     1284     )  .
     1285       if v-torgconf-outhold = yes
     1286       then do:
     1287           run torgconf-get-holdfirm-code in this-procedure (
     1288                 input p-obj-type
     1289               , input p-obj-code
     1290               , output v-torgconf-self-host-code
     1291           ).
     1292           if v-torgconf-self-host-code = 0
     1293           then do:
     1294               return error.
     1295           end.
     1296       end.
     1297       else do:
     1298           assign
     1299               v-torgconf-self-host-code = v-host-code
     1300           .
     1301       end.
     1302       if v-torgconf-self-host-code = 0
     1303       then do:
     1304           assign
     1305               v-torgconf-self-host-name           = "":U
     1306               v-torgconf-self-host-addres         = "":U
     1307               v-torgconf-self-host-post-addres    = "":U
     1308               v-torgconf-self-host-phone          = "":U
     1309               v-torgconf-self-host-inn            = "":U
     1310               v-torgconf-self-host-kpp            = "":U
     1311               v-torgconf-self-host-okpo           = "":U
     1312               v-torgconf-self-host-egrip-date     = "":U
     1313               v-torgconf-self-host-egrip-num      = "":U
     1314           .
     1315       end.
     1316       else do:
     1317           run fmtcli-get-client in this-procedure (
     1318                 input 'орг':U
     1319               , input v-torgconf-self-host-code
     1320           ).
     1321           assign
     1322               v-torgconf-self-host-name        = v-fmtcli-name
     1323               v-torgconf-self-host-engl-name   = v-fmtcli-engl-name
     1324               v-torgconf-self-host-addres      = v-fmtcli-full-addres
     1325               v-torgconf-self-host-post-addres = v-fmtcli-post-addres
     1326               v-torgconf-self-host-phone       = v-fmtcli-phone
     1327               v-torgconf-self-host-inn         = v-fmtcli-inn
     1328               v-torgconf-self-host-kpp         = v-fmtcli-kpp
     1329               v-torgconf-self-host-okpo        = v-fmtcli-okpo
     1330           .
     1331           run gbl/clntat-v.p (
     1332                 input 'орг':U
