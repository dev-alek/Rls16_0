     1061       define variable v-outB      as character     no-undo.
     1062       define variable v-outC      as character     no-undo.
     1063       assign
     1064           v-torgconf-outdate  = no
     1065           v-torgconf-outnum   = no
     1066           v-torgconf-outprim  = no
     1067           v-torgconf-outdisc  = no
     1068           v-torgconf-outsubs  = no
     1069           v-torgconf-outrecv  = no
     1070           v-torgconf-outegrp  = no
     1071           v-torgconf-outt12   = no
     1072           v-torgconf-outappr  = no
     1073           v-torgconf-outrubl  = no
     1074           v-torgconf-outhold  = no
     1075           v-torgconf-outobj   = no
     1076           v-torgconf-outexlst = no
     1077           v-torgconf-outexpas = "":U
     1078           v-torgconf-outprncd = yes
     1079           v-torgconf-outares  = no
     1080           v-torgconf-outsend  = no
     1081           v-torgconf-outasend  = no
     1082           v-torgconf-outprops  = no
     1083           v-form-name          = p-form-name
     1084       .
     1085   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1086   empty temp-table thbjattr_thbj-attr.
     1087   run adm/shattri.p (
     1088      input "get":U
     1089     ,input ''
     1090     ,input 0
     1091     ,input 'prt-glob':U
     1092     ,input  ""
     1093     ,output v-value-character
     1094     ,output v-value-date
     1095     ,output v-value-decimal
     1096     ,output v-value-integer
     1097     ,output v-value-logical
     1098     ,output par-type
     1099     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     1100     ) no-error .
     1101   for each thbjattr_thbj-attr :
     1102       if thbjattr_thbj-attr.prop-code = 'outprncd':U then v-outprncd =  string(thbjattr_thbj-attr.property-value-logical) .
     1103       if thbjattr_thbj-attr.prop-code = 'outrecv':U  then v-outrecv  =  thbjattr_thbj-attr.property-value-character .
