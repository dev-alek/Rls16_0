     3461               no-error.
     3462               if available buf_sysconf
     3463               then do:
     3464                  assign
     3465                     v-torgconf-ogr-post = buf_sysconf.head-position
     3466                  .
     3467               end.
     3468               find first buf_clients no-lock
     3469                  where buf_clients.obj-type = 'орг':U
     3470                  and buf_clients.obj-code = v-host-code
     3471               .
     3472               find first buf_firm no-lock
     3473                  where buf_firm.firm-code = buf_clients.obj-code
     3474               .
     3475               assign
     3476                  v-torgconf-ogr-name = buf_firm.director
     3477               .
     3478            end.
     3479            if v-torgconf-outogr = "dir_obj"
     3480               then do:
     3481               find first buf_wth-doc no-lock
     3482               where buf_wth-doc.doc-code = p-doc-code
     3483               no-error.
     3484                  find first buf_shop no-lock
     3485                  where buf_shop.obj-code = buf_wth-doc.obj-code
     3486                  .
     3487                  assign
     3488                     v-torgconf-ogr-name = buf_shop.director
     3489                     v-torgconf-ogr-post = "Директор"
     3490                  .
     3491               end.
     3492         if v-torgconf-outogr = "manag_doc"
     3493            then do:
     3494               find first buf_wth-doc no-lock
     3495               where buf_wth-doc.doc-code = p-doc-code
     3496               no-error.
     3497               if available buf_wth-doc
     3498               then do:
     3499                  run rep/get-psn.p
     3500                  (input buf_wth-doc.deliver
     3501                  ,output v-torgconf-ogr-name
     3502                  ) .
     3503               end.
     3504               find first buf_person no-lock
     3505               where buf_person.psn-code = buf_wth-doc.deliver
     3506               no-error.
     3507               if available buf_person
     3508               then do:
     3509                  v-torgconf-ogr-post = buf_person.position.
     3510               end.
     3511               if v-torgconf-ogr-name = "?":U then v-torgconf-ogr-name = "".
     3512               if v-torgconf-ogr-post = ? then  v-torgconf-ogr-post = "".
     3513            end.
     3514      end.
     3515   end.
     3516   end procedure.
     3517   procedure torgconf-get-outogr-param:
     3518       define input parameter p-form-name  as character    no-undo.
     3519       define input parameter p-host-code  as integer      no-undo.
     3520       define input parameter p-obj-type   as character    no-undo.
     3521       define input parameter p-obj-code   as integer      no-undo.
     3522       define input parameter p-doc-code   as character      no-undo.
     3523       define buffer buf_firm          for ub.firm .
     3524       define buffer buf_clients       for ub.clients .
     3525       define buffer buf_sysconf       for ub.sysconf .
     3526       define buffer buf_shop          for ub.shop .
     3527       define buffer buf_store         for ub.store .
     3528       define buffer buf_person        for ub.person .
     3529       define buffer buf_trn-doc       for ub.trn-doc .
     3530       define buffer buf_wth-doc       for ub.wth-doc .
     3531      if  p-form-name <> 'wthtrg12':U
     3532      and p-form-name <> 'wthfct':U
     3533      and p-form-name <> 'wthm11':U
     3534      then do:
     3535       find first buf_trn-doc no-lock
     3536       where buf_trn-doc.doc-code = p-doc-code
     3537       no-error.
     3538       if v-torgconf-outogr = "no_print"
     3539         then do:
     3540            assign
     3541               v-torgconf-ogr-name = ""
     3542               v-torgconf-ogr-post = ""
     3543            .
     3544         end.
     3545      if v-torgconf-outogr  = "ruk_firm"
     3546            then do:
     3547            find first buf_sysconf no-lock
     3548            where buf_sysconf.host-code = p-host-code
     3549            no-error.
     3550            if available buf_sysconf
     3551            then do:
     3552               assign
     3553                  v-torgconf-ogr-post = buf_sysconf.head-position
     3554               .
     3555            end.
     3556            find first buf_clients no-lock
     3557                where buf_clients.obj-type = 'орг':U
     3558                and buf_clients.obj-code = p-host-code
     3559            .
     3560            find first buf_firm no-lock
     3561                where buf_firm.firm-code = buf_clients.obj-code
     3562            .
     3563            assign
     3564                v-torgconf-ogr-name = buf_firm.director
     3565            .
     3566         end.
     3567         if v-torgconf-outogr = "dir_obj"
     3568            then do:
     3569            find first buf_trn-doc no-lock
     3570            where buf_trn-doc.doc-code = p-doc-code
     3571            no-error.
     3572               CASE buf_trn-doc.obj-type:
     3573               WHEN 'маг':U
     3574               THEN DO:
     3575                  find first buf_shop no-lock
     3576                  where buf_shop.obj-code = buf_trn-doc.obj-code
     3577                  .
     3578                  assign
     3579                     v-torgconf-ogr-name = buf_shop.director
     3580                     v-torgconf-ogr-post = "Директор"
     3581                  .
     3582               END.
     3583               WHEN 'скл':U
     3584               THEN DO:
     3585                  find first buf_store no-lock
     3586                  where buf_store.obj-code = buf_trn-doc.obj-code
     3587                  .
     3588                  assign
     3589                     v-torgconf-ogr-name = buf_store.store-boss
     3590                     v-torgconf-ogr-post = "Директор"
     3591                  .
     3592               END.
     3593               OTHERWISE DO:
     3594                  assign
     3595                     v-torgconf-ogr-name = "":U
     3596                     v-torgconf-ogr-post = "":U
     3597                  .
     3598               END.
     3599               END CASE.
     3600            end.
     3601      if v-torgconf-outogr = "manag_doc"
     3602         then do:
     3603            find first buf_trn-doc no-lock
     3604            where buf_trn-doc.doc-code = p-doc-code
     3605            no-error.
     3606            if available buf_trn-doc
     3607            then do:
     3608               run rep/get-psn.p
     3609               (input buf_trn-doc.boss
     3610               ,output v-torgconf-ogr-name
     3611               ) .
     3612            end.
     3613            find first buf_person no-lock
     3614            where buf_person.psn-code = buf_trn-doc.boss
     3615            no-error.
     3616            if available buf_person
     3617            then do:
     3618               v-torgconf-ogr-post = buf_person.position.
     3619            end.
     3620            if v-torgconf-ogr-name = "?":U then v-torgconf-ogr-name = "".
     3621            if v-torgconf-ogr-post = ? then  v-torgconf-ogr-post = "".
     3622         end.
     3623      end.
     3624      else do:
     3625      find first buf_wth-doc no-lock
     3626         where buf_wth-doc.doc-code = p-doc-code
     3627         no-error.
     3628         if v-torgconf-outogr = "no_print"
     3629            then do:
     3630               assign
     3631                  v-torgconf-ogr-name = ""
     3632                  v-torgconf-ogr-post = ""
     3633               .
     3634            end.
     3635         if v-torgconf-outogr  = "ruk_firm"
     3636               then do:
     3637               find first buf_sysconf no-lock
     3638               where buf_sysconf.host-code = p-host-code
     3639               no-error.
     3640               if available buf_sysconf
     3641               then do:
     3642                  assign
     3643                     v-torgconf-ogr-post = buf_sysconf.head-position
     3644                  .
     3645               end.
     3646               find first buf_clients no-lock
     3647                  where buf_clients.obj-type = 'орг':U
     3648                  and buf_clients.obj-code = p-host-code
     3649               .
     3650               find first buf_firm no-lock
     3651                  where buf_firm.firm-code = buf_clients.obj-code
     3652               .
     3653               assign
     3654                  v-torgconf-ogr-name = buf_firm.director
     3655               .
     3656            end.
     3657            if v-torgconf-outogr = "dir_obj"
     3658               then do:
     3659               find first buf_wth-doc no-lock
     3660               where buf_wth-doc.doc-code = p-doc-code
     3661               no-error.
     3662                  find first buf_shop no-lock
     3663                  where buf_shop.obj-code = buf_wth-doc.obj-code
     3664                  .
     3665                  assign
     3666                     v-torgconf-ogr-name = buf_shop.director
     3667                     v-torgconf-ogr-post = "Директор"
     3668                  .
     3669               end.
     3670         if v-torgconf-outogr = "manag_doc"
     3671            then do:
     3672               find first buf_wth-doc no-lock
     3673               where buf_wth-doc.doc-code = p-doc-code
     3674               no-error.
     3675               if available buf_wth-doc
     3676               then do:
     3677                  run rep/get-psn.p
     3678                  (input buf_wth-doc.deliver
     3679                  ,output v-torgconf-ogr-name
     3680                  ) .
     3681               end.
     3682               find first buf_person no-lock
     3683               where buf_person.psn-code = buf_wth-doc.deliver
     3684               no-error.
     3685               if available buf_person
     3686               then do:
     3687                  v-torgconf-ogr-post = buf_person.position.
     3688               end.
     3689               if v-torgconf-ogr-name = "?":U then v-torgconf-ogr-name = "".
     3690               if v-torgconf-ogr-post = ? then  v-torgconf-ogr-post = "".
     3691            end.
     3692      end.
     3693   end.
     3694   procedure torgconf-get-reason  :
     3695   define input parameter  p-doc-code       as character        no-undo.
     3696   define input parameter  p-reason-code    as integer          no-undo .
     3697   define input parameter  p-doc-type       as character        no-undo.
     3698       if p-reason-code > 0
     3699       then do:
     3700           define buffer buf_trn-reason for ub.trn-reason.
     3701           find first buf_trn-reason no-lock where buf_trn-reason.reason-code = p-reason-code no-error .
     3702           if available buf_trn-reason then assign v-torgconf-reason =  buf_trn-reason.reason-name .
     3703       end.
     3704       else do:
     3705           if p-doc-type = 'при':U
     3706           then  do:
     3707               define variable v-attr-type     as character    no-undo.
     3708               define variable v-attr-value    as character    no-undo.
     3709               run gbl/trdcat-v.p (input p-doc-code,input 'nids':U,output v-attr-value,output v-attr-type) .
     3710               assign v-torgconf-reason = v-attr-value .
     3711               run gbl/trdcat-v.p (input p-doc-code,input 'dids':U,output v-attr-value,output v-attr-type) .
     3712               assign v-torgconf-reason = v-torgconf-reason + " от " + v-attr-value .
     3713           end.
     3714       end.
     3715   end procedure.
