     1381   procedure torgconf-get-recepient-param :
     1382   define input parameter torgconfdoc-code   as character                  no-undo.
     1383   define output parameter v-code-rec        as integer                    no-undo .
     1384   define output parameter v-type-rec        as character                  no-undo initial 'C':U.
     1385   define output parameter v-codefirm-rec    as integer                    no-undo .
     1386   define output parameter v-curcode-rec     as integer                    no-undo .
     1387        define variable  v-recipient-code  as character                  no-undo .
     1388        define variable  v-recipient       like ub.doc-attr.attr-value   no-undo.
     1389        define variable  v-trdcattr-type   as character                  no-undo initial 'C':U.
     1390   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input torgconfdoc-code ,
     1391                           input 'Recipient':U ,
     1392                          output v-recipient-code ,
     1393                          output v-trdcattr-type ) no-error .
     1394       if error-status :error then do:
     1395        message
