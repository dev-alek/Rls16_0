     1267   PROCEDURE dispatch :
     1268       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
     1269       RUN broker-dispatch IN adm-broker-hdl
     1270           (THIS-PROCEDURE, p-method-name) NO-ERROR.
     1271       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
     1272   END PROCEDURE.
     1273   PROCEDURE ensure-broker :
     1274   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
     1275   IF RETURN-VALUE NE "ADM-Broker":U THEN
     1276   DO:
     1277       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
     1278       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
     1279   END.
     1280   END PROCEDURE.
     1281   PROCEDURE get-attribute :
     1282     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
     1283     RUN broker-get-attribute IN adm-broker-hdl
     1284         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
     1285     RETURN RETURN-VALUE.
     1286   END PROCEDURE.
     1287   PROCEDURE get-attribute-list :
     1288     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
     1289     RUN broker-get-attribute-list IN adm-broker-hdl
     1290         (INPUT THIS-PROCEDURE,
     1291          INPUT ?,
     1292          OUTPUT p-attr-list) NO-ERROR.
     1293     RETURN.
     1294   END PROCEDURE.
     1295   PROCEDURE new-state :
     1296     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     1297     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
     1298     RETURN.
     1299   END PROCEDURE.
     1300   PROCEDURE notify :
     1301     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
     1302     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
     1303     IF RETURN-VALUE = "ADM-ERROR":U THEN
     1304         RETURN "ADM-ERROR":U.
     1305     RETURN.
     1306   END PROCEDURE.
     1307   PROCEDURE set-attribute-list :
     1308     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
     1309     RUN ensure-broker.
     1310     RUN broker-set-attribute-list IN adm-broker-hdl
     1311         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
     1312     RETURN.
     1313   END PROCEDURE.
     1314   PROCEDURE set-position :
     1315       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
     1316       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
     1317       IF VALID-HANDLE(adm-object-hdl) THEN
     1318       DO:
