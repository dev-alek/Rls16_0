     1705   PROCEDURE my-var :
     1706   define variable v-today as date      no-undo.
     1707   define variable v-time  as integer   no-undo.
     1708   assign frame F-Main
     1709    Classify itog show-zero  SortType show-qnty Rs-qnty-type .
     1710   run cur-time in this-procedure ( output v-today
     1711                                  , output v-time
     1712                                  ).
     1713   x-date-start = v-today.
     1714   x-date-end   = v-today.
     1715        ReportHeader = "Альтернативные объекты : " + chr(10).
     1716        for each alt-obj-list no-lock :
     1717           ReportHeader = ReportHeader + Fill(" ",5) + alt-obj-list.obj-name  + chr(10).
     1718        End.
     1719   IF Rs-qnty-type = 2 THEN do:
     1720      ReportHeader = ReportHeader + "Свободный остаток" .
     1721   end.
     1722   ELSE do:
     1723    ReportHeader = ReportHeader + "Фактическое количество" .
     1724   end.
     1725   if not show-zero then do:
     1726     ReportHeader = ReportHeader +  chr(10) + "Не показывать нулевые строки".
     1727   end.
     1728   else do:
     1729     ReportHeader = ReportHeader +  chr(10) + "Показывать нулевые строки".
     1730   end.
     1731        IF show-qnty THEN DO:
     1732           ReportHeader = ReportHeader +  chr(10) + "Товары , у которых есть положительные остатки по первому объекту".
     1733        END.
     1734   Sheetf.ColFOrmat = "2=@;3=@;4=@;5=@;"  .
     1735   Sheetf.Excel-Column-Lable = "N п\п,Код,Артикул,Название товара ,Признак товара,".
     1736   Sheetf.Sizes = "9,10,16,40,20,".
     1737   define variable v-var as integer   no-undo init 1.
     1738   repeat v-var = 1 to 2 :
     1739     Sheetf.Excel-Column-Lable = Sheetf.Excel-Column-Lable + " Объект " + string( v-var )  + "," .
     1740             Sheetf.Excel-Column-Lable = Sheetf.Excel-Column-Lable +     ",".
     1741             Sheetf.Excel-Column-Lable = Sheetf.Excel-Column-Lable +     "," .
     1742             Sheetf.Excel-Column-Lable = Sheetf.Excel-Column-Lable +     "," .
     1743        Sheetf.Sizes = Sheetf.Sizes + "12," .
     1744             Sheetf.Sizes = Sheetf.Sizes +     "13," .
     1745             Sheetf.Sizes = Sheetf.Sizes +     "13," .
     1746             Sheetf.Sizes  = Sheetf.Sizes +     "7," .
     1747   End.
     1748        Sheetf.Excel-Column-Lable = Sheetf.Excel-Column-Lable  + chr(10) +  ",,,,,".
     1749   repeat v-var = 1 to 2 :
     1750        Sheetf.Excel-Column-Lable = Sheetf.Excel-Column-Lable + "Количество,".
     1751              Sheetf.Excel-Column-Lable = Sheetf.Excel-Column-Lable +     "Учетные цены с НДС,".
     1752              Sheetf.Excel-Column-Lable = Sheetf.Excel-Column-Lable +     "Суммы в продажных ценах," .
     1753             Sheetf.Excel-Column-Lable = Sheetf.Excel-Column-Lable +     "% наценки," .
     1754   End.
     1755    make-correct = Fill("true,", 13).
     1756   END PROCEDURE.
     1757   PROCEDURE select-objects-proc :
     1758   define variable v-all-object as logical   no-undo .
     1759   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1760   for each alt-obj-list :
     1761    delete alt-obj-list.
     1762   end.
     1763   str-obj#  = "" .
     1764   str-obj2# = "" .
     1765   str-obj3# = "" .
     1766   case selectobject :
     1767   when "currency":U then do:
     1768    run verify-check.
     1769   end.
     1770   when 'все':U then   do:
     1771    run sss.
     1772   end.
     1773   when "all" then   do:
     1774    run sss.
     1775   end.
     1776   when "firm":U then   do:
     1777    run sss.
     1778   end.
     1779   when "choice":U then do:
     1780     for each alt-obj-list :
     1781         delete alt-obj-list.
     1782     end.
     1783     define variable v-object-exist as logical   no-undo .
     1784   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1785   run userobjs_object-exist in this-procedure
     1786     (output v-object-exist
     1787     )  .
     1788     if my-request     = false
     1789     or v-object-exist = false
     1790     then do:
     1791       define variable v-user-select as logical   no-undo .
     1792       define variable v-recids as character no-undo .
     1793       if params-only then do:
     1794       run ref/thobjs.w
     1795           ( input my-handle
     1796           , input this-procedure:handle
     1797           , input (if params-only-mode = 'ПРОСМОТР':U then "b-mark-hidden" else "b-mark,b-sel")
     1798           , input 'все':U
     1799           , input ''
     1800           , input ?
     1801           , input ?
     1802           , input-output v-recids ) no-error .
     1803        end.
     1804        else do:
     1805   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1806   run userobjs_select-many in this-procedure
     1807     (input  my-handle
     1808     ,input  v-cntxt-db-num
     1809     ,input  v-cntxt-userid
     1810     ,input  v-cntxt-host-code-obj
     1811     ,input  v-cntxt-obj-type
     1812     ,input  v-cntxt-obj-code
     1813     ,output v-user-select
     1814     )  .
     1815        end.
     1816     end.
     1817     my-request = true .
     1818   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1819   run userobjs_object-exist in this-procedure
     1820     (output v-object-exist
     1821     )  .
     1822     if v-object-exist = false
     1823     then do:
     1824       if temp-param-obj-type = 'shop':u or temp-param-obj-type = 'stock':u then do:
     1825         assign selectobject = "firm":U .
     1826       end.
     1827       else do:
     1828         assign selectobject = "not":u .
     1829       end.
     1830       display selectobject with frame F-Main .
     1831       disable button-obj   with frame F-Main .
     1832       find cli-obj where cli-obj.obj-type = v-cntxt-obj-type and
     1833                           cli-obj.obj-code = v-cntxt-obj-code no-lock .
     1834       if temp-param-obj-type = 'shop':u or temp-param-obj-type = 'stock':u
     1835       then do:
     1836         run sss.
     1837       end.
     1838       else do:
     1839       end.
     1840     end.
     1841     else do:
     1842         define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     1843         define buffer buf_clients for ub.clients .
     1844         define buffer buf_db for ub.db .
     1845         define buffer buf_shop for ub.shop .
     1846         define buffer buf_store for ub.store .
     1847         define buffer buf_sysconf for ub.sysconf .
     1848         for each buf_userobjs_temp-user-obj
     1849         :
     1850           find first buf_clients no-lock
     1851             where buf_clients.obj-type = buf_userobjs_temp-user-obj.obj-type
     1852               and buf_clients.obj-code = buf_userobjs_temp-user-obj.obj-code
     1853             .
     1854             if verify-send-check  and buf_clients.db-num <> v-cntxt-db-num  and v-all-object = false then do:
     1855                   find first buf_db where buf_db.db-num = buf_clients.db-num no-lock.
     1856                   if buf_db.send-check = false then do:
     1857                     str-obj2# = str-obj2#  + " " + buf_clients.obj-name + ",".
     1858                     next.
     1859                   end.
     1860             end.
     1861             if temp-param-obj-type = 'shop':u and v-all-object = false then do:
     1862                 if buf_userobjs_temp-user-obj.obj-type = 'скл':U then do:
     1863                     str-obj# = str-obj#  +  " " +  buf_clients.obj-name  .
     1864                     next.
     1865                   end.
     1866             end.
     1867             if temp-param-obj-type = 'stock':u and v-all-object = false then do:
     1868                 if buf_userobjs_temp-user-obj.obj-type = 'маг':U then do:
     1869                     str-obj# = str-obj#  +  " " +  buf_clients.obj-name  .
     1870                     next.
     1871                 end.
     1872             end.
     1873             case buf_userobjs_temp-user-obj.obj-type:
     1874                 when 'скл':U then
     1875                     do:
     1876                         find buf_store where buf_store.obj-code = buf_userobjs_temp-user-obj.obj-code no-lock.
     1877                         find first buf_sysconf no-lock where buf_sysconf.host-code = buf_store.host-code no-error.
     1878                         find first buf_clients no-lock where
     1879                                     buf_clients.obj-type = buf_userobjs_temp-user-obj.obj-type and
     1880                                     buf_clients.obj-code = buf_userobjs_temp-user-obj.obj-code
     1881                             .
     1882                         if buf_sysconf.base-code = base-code or v-all-object = true
     1883                             then do:
     1884                                 create alt-obj-list.
     1885                                 assign
     1886                                     alt-obj-list.obj-name = buf_clients.obj-name
     1887                                     alt-obj-list.obj-type = buf_userobjs_temp-user-obj.obj-type
     1888                                     alt-obj-list.obj-code = buf_userobjs_temp-user-obj.obj-code.
     1889                             end.
     1890                             else do:
     1891                               str-obj# = str-obj#  +  " " +  buf_clients.obj-name + "," .
     1892                             end.
     1893                     end.
     1894                 when 'маг':U then
     1895                     do:
     1896                         find first buf_shop where buf_shop.obj-code = buf_userobjs_temp-user-obj.obj-code no-lock.
     1897                         find first buf_sysconf no-lock where buf_sysconf.host-code = buf_shop.host-code no-error.
     1898                         find first buf_clients no-lock where
     1899                                     buf_clients.obj-type = buf_userobjs_temp-user-obj.obj-type and
     1900                                     buf_clients.obj-code = buf_userobjs_temp-user-obj.obj-code no-error.
     1901                         if buf_sysconf.base-code = base-code or v-all-object = true
     1902                               then do:
     1903                                 create alt-obj-list.
     1904                                 assign
     1905                                     alt-obj-list.obj-name = buf_clients.obj-name
     1906                                     alt-obj-list.obj-type = buf_userobjs_temp-user-obj.obj-type
     1907                                     alt-obj-list.obj-code = buf_userobjs_temp-user-obj.obj-code.
     1908                             end.
     1909                             else do:
     1910                               str-obj# = str-obj#  +  " " +  buf_clients.obj-name + "," .
     1911                             end.
     1912                     end.
     1913             end case.
     1914           end.
     1915       end.
     1916   end.
     1917   end case.
     1918   END PROCEDURE.
     1919   PROCEDURE sss :
     1920     define buffer buf_user-obj for ub.user-obj .
     1921     do
     1922     on error undo, return error return-value
     1923     :
     1924       FOR EACH alt-obj-list
     1925       :
     1926           delete alt-obj-list.
     1927       END.
     1928       assign
     1929         str-obj#  = ''
     1930         str-obj2# = ''
     1931       .
     1932       for each buf_user-obj no-lock
     1933         where buf_user-obj.db-num  = v-cntxt-db-num
     1934           and buf_user-obj.user-id = v-cntxt-userid
     1935       ,EACH cli-obj WHERE cli-obj.obj-type = buf_user-obj.obj-type AND
     1936                                       cli-obj.obj-code = buf_user-obj.obj-code AND
     1937                                       ( ( cli-obj.db-num = v-cntxt-db-num ) OR v-cntxt-db-num = 0 ) NO-LOCK :
     1938                                         Find first ub.clients no-lock where
     1939                                                     ub.clients.obj-type = buf_user-obj.obj-type AND
     1940                                                     ub.clients.obj-code = buf_user-obj.obj-code No-ERROR.
     1941               If Verify-send-check  and ub.clients.db-num <> v-cntxt-db-num  THEN DO:
     1942                 Find first ub.db where ub.db.db-num = ub.clients.db-num no-lock.
     1943                 if ub.db.send-check = false then DO:
     1944                                             str-obj2# = str-obj2#  + " " + ub.clients.obj-name + ",".
     1945                                             NEXT. End.
     1946               END.
     1947               if temp-param-obj-type = 'shop':U then
     1948                                       if buf_user-obj.obj-type = 'скл':U then DO:
     1949                                       str-obj# = str-obj#  +  " " + ub.clients.obj-name + ",".
     1950                                       NEXT.
     1951                                       End.
     1952               if temp-param-obj-type = 'stock':U then
     1953                                       if buf_user-obj.obj-type = 'маг':U then DO:
     1954                                     str-obj# = str-obj#  +  " " +  ub.clients.obj-name + "," .
     1955                                       NEXT.
     1956                                       End.
     1957                             CASE buf_user-obj.obj-type
     1958                             :
     1959                                 when 'скл':U
     1960                                 then do:
     1961                                   find ub.store where ub.store.obj-code = buf_user-obj.obj-code no-lock.
     1962                                   find first ub.sysconf no-lock where ub.sysconf.host-code = ub.store.host-code no-error.
     1963                                   find first ub.clients no-lock
     1964                                     where ub.clients.obj-type = buf_user-obj.obj-type
     1965                                       and ub.clients.obj-code = buf_user-obj.obj-code
     1966                                     no-error.
     1967                                   if ub.sysconf.base-code = base-code
     1968                                   then do:
     1969                                       CREATE alt-obj-list.
     1970                                       assign
     1971                                         alt-obj-list.obj-name = ub.clients.obj-name
     1972                                         alt-obj-list.obj-type = buf_user-obj.obj-type
     1973                                         alt-obj-list.obj-code = buf_user-obj.obj-code
     1974                                       .
     1975                                   end.
     1976                                   else do:
     1977                                     assign
     1978                                       str-obj# = str-obj#  +  " " +   ub.clients.obj-name + ","
     1979                                     .
     1980                                   end.
     1981                                 end.
     1982                                 when 'маг':U
     1983                                 then do:
     1984                                   find ub.shop where ub.shop.obj-code = buf_user-obj.obj-code no-lock.
     1985                                   find first ub.sysconf no-lock where ub.sysconf.host-code = ub.shop.host-code no-error.
     1986                                   find first ub.clients no-lock
     1987                                     where ub.clients.obj-type = buf_user-obj.obj-type
     1988                                       and ub.clients.obj-code = buf_user-obj.obj-code
     1989                                     no-error.
     1990                                   if ub.sysconf.base-code = base-code
     1991                                   then do:
     1992                                     create alt-obj-list .
     1993                                     assign
     1994                                         alt-obj-list.obj-name = ub.clients.obj-name
     1995                                         alt-obj-list.obj-type = buf_user-obj.obj-type
     1996                                         alt-obj-list.obj-code = buf_user-obj.obj-code
     1997                                     .
     1998                                   end.
     1999                                   else do:
     2000                                     assign
     2001                                       str-obj# = str-obj#  +  " " +  ub.clients.obj-name +  ","
     2002                                     .
     2003                                   end.
     2004                                 end.
     2005                             END CASE.
     2006                     END.
     2007     end.
     2008   END PROCEDURE.
