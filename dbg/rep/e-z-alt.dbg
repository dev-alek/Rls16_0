     1650     End.
     1651   end.
     1652   else do:
     1653     if x-SelectGood = 1 Then DO:
     1654         If x-SET_val_TYPE = 1
     1655           then
     1656           run rep/r-z-alt5.p
     1657               (input v-cntxt-obj-code ,
     1658                input v-cntxt-obj-type ,
     1659                input base-type ,
     1660                input base-code ,
     1661                input Classify,
     1662                input itog ,
     1663                input show-zero ,
     1664                input sorttype,
     1665                input show-qnty) .
     1666           Else
     1667           run rep/r-z-alt6.p
     1668               (input v-cntxt-obj-code ,
     1669               input v-cntxt-obj-type ,
     1670               input base-type ,
     1671               input base-code ,
     1672               input Classify,
     1673               input itog,
