     1199   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
     1200   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
     1201   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
     1202         adm-object-hdl = FRAME F-Main:HANDLE.
     1203   RUN ensure-broker.
     1204   THIS-PROCEDURE:ADM-DATA =
     1205        'ADM1.1~`':U +
     1206        'SmartViewer~`':U +
     1207        '~`':U +
     1208        'NO ~`':U +
     1209        '~`':U +
     1210        '~`':U +
     1211        '~`':U +
     1212        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
     1213           + "~`":U +
     1214        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add~`':U +
     1215        'Record-Source,Record-Target,TableIO-Target~`':U +
     1216        '~`':U +
     1217        '~`~`~`~`~`~`~`~`~`~`~`':U +
     1218        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
     1219            THEN "^^":U
     1220        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
     1221             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
     1222   PROCEDURE adm-apply-entry :
     1223     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1224   END PROCEDURE.
     1225   PROCEDURE adm-destroy :
     1226    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1227   END PROCEDURE.
     1228   PROCEDURE adm-disable :
     1229       DISABLE RECT-12 RECT-3 Classify SelectObject BUTTON-obj Itog show-zero show-qnty Rs-qnty-type SortType TEXT-3-alt Obj-count WITH FRAME F-Main.
     1230       RUN dispatch ('disable-fields':U).
     1231       RUN set-attribute-list ('ENABLED=no':U).
     1232       RETURN.
     1233   END PROCEDURE.
