     1422   PROCEDURE check-modified :
     1423   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
     1424   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
     1425   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
     1426   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
     1427     IF check-state = "check":U THEN
     1428     DO:
     1429       RUN get-link-handle IN adm-broker-hdl
     1430         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
     1431            OUTPUT group-target-list).
     1432       IF group-target-list NE "":U THEN
     1433       DO i = 1 TO NUM-ENTRIES(group-target-list):
     1434         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
     1435         RUN check-modified IN curr-widget ('group-check':U).
     1436         IF RETURN-VALUE NE "":U THEN
     1437         DO:
     1438           RUN check-modified-message(RETURN-VALUE).
     1439           RETURN "":U.
     1440         END.
     1441       END.
     1442     END.
     1443     RETURN "":U.
     1444   END PROCEDURE.
     1445   PROCEDURE check-modified-message :
     1446     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
     1447        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
     1448           'CONTAINER-SOURCE':U, 'HIDDEN':U).
     1449        IF RETURN-VALUE = "YES":U THEN
     1450           RUN notify ('view,CONTAINER-SOURCE':U).
     1451        MESSAGE IF p-changed-table NE ? THEN
     1452           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
     1453           ELSE "Current values have been changed."
     1454           SKIP "  Do you wish to save those changes?"
     1455           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
     1456        IF ANS THEN
     1457        DO:
     1458           IF group-assign-target THEN
     1459             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
     1460           ELSE RUN dispatch('update-record':U).
     1461           IF RETURN-VALUE = "ADM-ERROR":U THEN
     1462           DO:
     1463               MESSAGE "Changes to the previous record were not saved."
     1464                 VIEW-AS ALERT-BOX ERROR.
     1465               IF group-assign-target THEN
     1466                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1467               ELSE RUN dispatch ('cancel-record':U).
     1468           END.
     1469        END.
     1470        ELSE DO:
     1471          IF group-assign-target THEN
     1472             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1473          ELSE RUN dispatch('cancel-record':U).
     1474        END.
     1475        RETURN.
     1476   END PROCEDURE.
     1477   PROCEDURE get-rowid :
     1478       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
     1479       ASSIGN
     1480       p-table   =   adm-first-table.
     1481       RETURN.
     1482   END PROCEDURE.
     1483   PROCEDURE init-group-assign :
     1484       RUN request-attribute IN adm-broker-hdl
     1485         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
     1486       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
     1487         group-assign-target = yes.
     1488       ELSE group-assign-target = no.
     1489       RETURN.
     1490   END PROCEDURE.
     1491   PROCEDURE set-editors :
     1492       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
     1493       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
     1494       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
     1495       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
     1496       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
     1497       DO WHILE VALID-HANDLE (curr-widget):
     1498           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
     1499              curr-widget:HIDDEN = no THEN DO:
     1500             CASE p-field-setting:
     1501               WHEN "INITIALIZE":U THEN
     1502               DO:
     1503                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
     1504                     read-only-list +
     1505                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
     1506                        STRING(curr-widget).
     1507               END.
     1508               WHEN "DISABLE":U OR
     1509               WHEN "ENABLE":U THEN
     1510               DO:
     1511                   curr-widget:SENSITIVE = yes.
     1512                   RUN get-attribute ('Read-Only-Editors':U).
     1513                   IF RETURN-VALUE = ? OR
     1514                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
     1515                       curr-widget:READ-ONLY =
     1516                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
     1517               END.
     1518               WHEN "CLEAR":U THEN
     1519                   curr-widget:SCREEN-VALUE = "":U.
     1520             END CASE.
     1521           END.
     1522           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
     1523       END.
     1524       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
     1525         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
     1526           + '"':U).
     1527       RETURN.
     1528   END PROCEDURE.
     1529   PROCEDURE use-check-modified-all :
     1530    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1531     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
     1532     RETURN.
     1533   END PROCEDURE.
     1534   PROCEDURE use-create-on-add :
     1535   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1536      RETURN.
     1537   END PROCEDURE.
     1538   PROCEDURE use-initial-lock :
     1539     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1540     ASSIGN adm-initial-lock = p-attr-value.
     1541     RETURN.
     1542   END PROCEDURE.
     1543     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
     1544   ASSIGN
     1545          FRAME F-Main:SCROLLABLE       = FALSE
     1546          FRAME F-Main:HIDDEN           = TRUE.
     1547   ON CHOOSE OF BUTTON-obj IN FRAME F-Main
     1548   DO:
     1549     assign SelectObject.
     1550     my-request = no.
     1551     run select-objects-proc in this-procedure .
     1552   END.
     1553   ON VALUE-CHANGED OF Rs-qnty-type IN FRAME F-Main
     1554   DO:
     1555     ASSIGN Rs-qnty-type .
     1556   END.
     1557   ON VALUE-CHANGED OF SelectObject IN FRAME F-Main
     1558   DO:
     1559   Assign SelectObject.
     1560   run select-objects-proc in this-procedure .
     1561   END.
     1562   do with frame F-Main
     1563   :
     1564     assign
     1565       selectobject :radio-buttons =
     1566               "Нет" + chr(44) + "not":U + chr(44) +
     1567     "Все" + chr(44) + 'все':U + chr(44) +
     1568     "Выборочно" + chr(44) + "choice":U
     1569     .
     1570   end.
     1571   PROCEDURE disable_UI :
     1572     HIDE FRAME F-Main.
     1573     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1574   END PROCEDURE.
     1575   PROCEDURE enable_UI :
     1576     DISPLAY Classify SelectObject Itog show-zero show-qnty Rs-qnty-type SortType
     1577             TEXT-3-alt Obj-count
     1578         WITH FRAME F-Main.
     1579     ENABLE RECT-12 RECT-3 Classify SelectObject BUTTON-obj Itog show-zero
     1580            show-qnty Rs-qnty-type SortType TEXT-3-alt Obj-count
     1581         WITH FRAME F-Main.
     1582   END PROCEDURE.
     1583   PROCEDURE my-report :
     1584   define variable v-ii as integer no-undo .
     1585   define variable v-ok as logical no-undo .
     1586   do v-ii = 1 to 256:
     1587     if use-column[v-ii] = yes then do:
     1588        leave.
     1589     end.
     1590   end.
     1591   if v-ii > 256
     1592   and use-column[256] = no then do:
     1593     message
     1594     "Не выбрана ни одна колонка для печати в текст!" skip
     1595     "тело отчета при печати в текст будет пустым!" skip
     1596     "Все равно выполнить отчет?"
     1597     view-as alert-box question buttons yes-no update v-ok.
     1598     if not v-ok then return.
     1599   end.
     1600    IF Rs-qnty-type = 1 THEN do:
     1601     if x-SelectGood = 1 Then DO:
     1602         If x-SET_val_TYPE = 1
     1603           then
