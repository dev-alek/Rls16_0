      678   procedure cur-time :
      679      define output parameter p-today as date      no-undo .
      680      define output parameter p-time  as integer   no-undo .
      681     do
      682     on error undo, return error
      683     :
      684       define variable v-date1 as date      no-undo .
      685       define variable v-date2 as date      no-undo .
      686       define variable v-time  as integer   no-undo .
      687       assign
      688         v-date1 = today
      689         v-time  = time
      690         v-date2 = today
      691       .
      692       if v-date1 <> v-date2
      693       then do:
      694         assign
      695           v-date1 = today
      696           v-time  = v-time
      697         .
      698       end.
      699       assign
      700         p-today = v-date1
      701         p-time  = v-time
      702       .
      703     end.
      704   end.
      705   function cur-time-date returns character
      706   :
      707     return string(today, '99/99/9999':U) .
      708   end.
      709   function cur-time-mjd returns decimal
      710   :
      711     define variable v-date as date      no-undo .
      712     define variable v-time as integer   no-undo .
      713     run cur-time in this-procedure
      714       (output v-date
      715       ,output v-time
      716       ) .
      717     return integer(v-date) - 2400002 + (v-time / 86400) .
      718   end.
      719   function cur-time-get-ending-index returns integer
      720   (input p-number as integer
      721   )
      722   :
      723     if p-number < 0
      724     or p-number = ?
      725     then do:
      726       return 1 .
      727     end.
      728     define variable v-rest as integer   no-undo .
      729     assign
      730       p-number = p-number modulo 100
      731     .
      732     if p-number < 20
      733     then do:
      734       assign
      735         v-rest = p-number
      736       .
      737     end.
      738     else do:
      739       assign
      740         v-rest = p-number modulo 10
      741       .
      742     end.
      743     case v-rest :
      744       when 1
      745       then do:
      746         return 2 .
      747       end.
      748       when 2 or
      749       when 3 or
      750       when 4
      751       then do:
      752         return 3 .
      753       end.
      754       otherwise do:
      755         return 1 .
      756       end.
      757     end case .
      758   end.
      759   procedure cur-time-mjd-to-date :
      760      define input  parameter i-mjd-diff as decimal no-undo.
      761      define output parameter o-Date     as date    no-undo.
      762      define output parameter o-Time     as integer no-undo.
      763      define variable v-day-number as integer   no-undo .
      764      if    i-mjd-diff < 0
      765         or i-mjd-diff = ?
      766      then do:
      767         return "?" .
      768      end.
      769      assign
      770         v-day-number = truncate(i-mjd-diff,0).
      771         o-Date = date(v-day-number + 2400002).
      772         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      773     .
      774   end.
      775   function cur-time-mjd-to-string returns character
      776   (input p-mjd-diff as decimal
      777   )
      778   :
      779     define variable v-day-number as integer   no-undo .
      780     define variable v-seconds    as integer   no-undo .
      781     define variable v-hour       as integer   no-undo .
      782     define variable v-min        as integer   no-undo .
      783     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      784     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      785     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      786     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      787     if p-mjd-diff < 0
      788     or p-mjd-diff = ?
      789     then do:
      790       return "?" .
      791     end.
      792     assign
      793       v-day-number = integer(truncate(p-mjd-diff,0))
      794       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      795     .
      796     if v-seconds > 86400
      797     then do:
      798       assign
      799         v-seconds = 86400 - 1
      800       .
      801     end.
      802     if v-seconds < 0
      803     then do:
      804       assign
      805         v-seconds = 0
      806       .
      807     end.
      808     assign
      809       v-hour = truncate(v-seconds / 3600, 0)
      810     .
      811     assign
      812       v-seconds = v-seconds modulo 3600
      813     .
      814     assign
      815       v-min = truncate(v-seconds / 60, 0)
      816     .
      817     assign
      818       v-seconds = v-seconds modulo 60
      819     .
      820     return
      821         (if v-day-number <> 0
      822           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      823           else ""
      824         )
      825       + (if v-day-number <> 0 or v-hour <> 0
      826           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      827           else ""
      828         )
      829       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      830           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      831           else ""
      832         )
      833       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      834       .
      835   end.
      836   function cur-time-string returns character
      837   :
      838     define variable v-date as date      no-undo .
      839     define variable v-time as integer   no-undo .
      840     run cur-time in this-procedure
      841       (output v-date
      842       ,output v-time
      843       ) .
      844     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      845   end.
      846   function cur-time-string-sec returns character
      847   :
      848     define variable v-date as date      no-undo .
      849     define variable v-time as integer   no-undo .
      850     run cur-time in this-procedure
      851       (output v-date
      852       ,output v-time
      853       ) .
      854     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      855   end.
      856   function cur-time-custom  returns character
      857   (input p-prefix as character
      858   ,input p-date-format as character
      859   ,input p-delimiter as character
      860   ,input p-time-format as character
      861   ,input p-suffix as character
      862   )
      863   :
      864     define variable v-date as date      no-undo .
      865     define variable v-time as integer   no-undo .
      866     run cur-time in this-procedure
      867       (output v-date
      868       ,output v-time
      869       ) .
      870     return
      871       p-prefix
      872       + string(v-date, p-date-format)
      873       + p-delimiter
      874       + string(v-time, p-time-format)
      875       + p-suffix
      876       .
      877   end.
      878   function cur-time-print  returns character
      879   :
      880     define variable v-date as date      no-undo .
      881     define variable v-time as integer   no-undo .
      882     run cur-time in this-procedure
      883       (output v-date
      884       ,output v-time
      885       ) .
      886     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      887   end.
      888   function cur-time-datetime returns datetime
      889   :
      890     define variable v-char as character no-undo .
      891     define variable v-datetime as datetime no-undo .
      892     v-char = cur-time-string().
      893     v-datetime = datetime(v-char).
      894     return  v-datetime.
      895   end.
      896   function cur-time-string-msec returns character
      897   :
      898     define variable v-date as datetime  no-undo .
      899     v-date = now.
      900     return string(v-date) .
      901   end.
      902   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      903   define temp-table userobjs_temp-user-obj no-undo
      904     field obj-type as character
      905     field obj-code as integer
      906     index xpk is primary unique obj-type obj-code
      907     .
      908   procedure userobjs_clear :
      909     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      910     do
      911     on error undo, return error return-value
      912     :
      913       for each buf_userobjs_temp-user-obj
      914       on error undo, return error return-value
      915       :
      916         delete buf_userobjs_temp-user-obj .
      917       end.
      918     end.
      919   end .
      920   procedure userobjs_object-count :
      921     define output parameter p-total-count as integer   no-undo .
      922     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      923     do
      924     on error undo, return error return-value
      925     :
      926       assign
      927         p-total-count = 0
      928       .
      929       for each buf_userobjs_temp-user-obj
      930       on error undo, return error return-value
      931       :
      932         assign
      933           p-total-count = p-total-count + 1
      934         .
      935       end.
      936     end.
      937   end.
      938   procedure userobjs_append :
      939      define input  parameter p-obj-type as character no-undo .
      940      define input  parameter p-obj-code as integer   no-undo .
      941     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      942     do
      943     on error undo, return error return-value
      944     :
      945       find first buf_userobjs_temp-user-obj
      946         where buf_userobjs_temp-user-obj.obj-type = p-obj-type
      947           and buf_userobjs_temp-user-obj.obj-code = p-obj-code
      948         no-error .
      949       if not available buf_userobjs_temp-user-obj
      950       then do:
      951         create buf_userobjs_temp-user-obj .
      952         assign
      953           buf_userobjs_temp-user-obj.obj-type = p-obj-type
      954           buf_userobjs_temp-user-obj.obj-code = p-obj-code
      955         .
      956       end.
      957     end.
      958   end.
      959   procedure userobjs_object-exist :
      960     define output parameter p-object-exist as logical   no-undo .
      961     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      962     do
      963     on error undo, return error return-value
      964     :
      965       find first buf_userobjs_temp-user-obj
      966         no-error .
      967       if not available buf_userobjs_temp-user-obj
      968       then do:
      969         assign
      970           p-object-exist = false
      971         .
      972       end.
      973       else do:
      974         assign
      975           p-object-exist = true
      976         .
      977       end.
      978     end.
      979   end.
      980   procedure userobjs_transfer :
      981     define input  parameter p-callback-handle as handle no-undo .
      982     define variable vss-description as character no-undo init "userobjs_transfer: Передача списка объектов".
      983     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      984     do
      985     on error undo, return error return-value
      986     :
      987       if valid-handle(p-callback-handle) <> true
      988       then do:
      989         message
      990           vss-workfile vss-revision vss-description skip
      991           "Ошибка задания входных параметров" skip
      992           "Неизвестный указатель на процедуру" skip
      993           view-as alert-box error .
      994         undo, return error return-value .
      995       end.
      996       if p-callback-handle :get-signature("userobjs_append") = ""
      997       then do:
      998         message
      999           vss-workfile vss-revision vss-description skip
     1000           "Ошибка задания входных параметров" skip
     1001           substitute("В процедуре &1 не найдена внутренняя процедура userobjs_append"
     1002                     ,p-callback-handle :file-name
     1003                     ) skip
     1004           view-as alert-box error .
     1005         undo, return error return-value .
     1006       end.
     1007       for each buf_userobjs_temp-user-obj
     1008       on error undo, return error return-value
     1009       :
     1010         run userobjs_append in p-callback-handle
     1011           (input  buf_userobjs_temp-user-obj.obj-type
     1012           ,input  buf_userobjs_temp-user-obj.obj-code
     1013           ) .
     1014       end.
     1015     end.
     1016   end procedure.
     1017   procedure userobjs_select-one :
     1018      define input  parameter parparentproc     as widget-handle no-undo .
     1019      define input  parameter p-db-num          as integer   no-undo .
     1020      define input  parameter p-user-id         as character no-undo .
     1021      define input  parameter p-host-code-obj   as integer   no-undo .
     1022      define input  parameter p-obj-type        as character no-undo .
     1023      define input  parameter p-obj-code        as integer   no-undo .
     1024      define output parameter p-user-select     as logical   no-undo .
     1025      define output parameter p-select-obj-type as character no-undo .
     1026      define output parameter p-select-obj-code as character no-undo .
     1027     do
     1028     on error undo, return error return-value
     1029     :
     1030       run gbl/userobjs.w
     1031         (input  parparentproc
     1032         ,input  this-procedure :handle
     1033         ,input  p-db-num
     1034         ,input  p-user-id
     1035         ,input  p-host-code-obj
     1036         ,input  p-obj-type
     1037         ,input  p-obj-code
