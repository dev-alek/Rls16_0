     1045   procedure userobjs_select-many :
     1046     define input  parameter parparentproc   as widget-handle no-undo .
     1047     define input  parameter p-db-num        as integer   no-undo .
     1048     define input  parameter p-user-id       as character no-undo .
     1049     define input  parameter p-host-code-obj as integer   no-undo .
     1050     define input  parameter p-obj-type      as character no-undo .
     1051     define input  parameter p-obj-code      as integer   no-undo .
     1052     define output parameter p-user-select   as logical   no-undo .
     1053     define variable v-select-obj-type as character no-undo .
     1054     define variable v-select-obj-code as integer   no-undo .
     1055     do
     1056     on error undo, return error return-value
     1057     :
     1058       run gbl/userobjs.w
     1059         (input  parparentproc
     1060         ,input  this-procedure :handle
     1061         ,input  p-db-num
     1062         ,input  p-user-id
     1063         ,input  p-host-code-obj
     1064         ,input  p-obj-type
     1065         ,input  p-obj-code
     1066         ,INPUT  "b-sel,b-mark"
     1067         ,output p-user-select
     1068         ,output v-select-obj-type
     1069         ,output v-select-obj-code
     1070         ) .
     1071     end.
     1072   end.
     1073   procedure thobjs :
