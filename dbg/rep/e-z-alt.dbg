     1077      define input        parameter i-obj-type        as character     no-undo.
     1078      define input        parameter i-db-num          as integer       no-undo.
     1079      define input        parameter i-host-code       as integer       no-undo.
     1080      define input-output parameter p-rid-list        as character     no-undo .
