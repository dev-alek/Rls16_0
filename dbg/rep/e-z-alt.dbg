     1676               input show-qnty) .
     1677     End.
     1678     Else DO:
     1679         If x-SET_val_TYPE = 1
     1680           then
     1681         run rep/r-z-alt7.p
     1682           (input v-cntxt-obj-code ,
     1683           input v-cntxt-obj-type ,
     1684           input base-type ,
     1685           input base-code ,
     1686           input Classify,
