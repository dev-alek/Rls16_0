     1194   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
     1195   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
     1196   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
     1197   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
