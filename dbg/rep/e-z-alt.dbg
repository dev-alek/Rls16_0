     1342     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
     1343     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
     1344     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
     1345     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
     1346     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
     1347     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
     1348     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
     1349     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
     1350     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1351     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
     1352     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1353     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
     1354     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
     1355     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
     1356     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
     1357     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
     1358     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
     1359     IF "":U = "":U THEN
     1360       RUN modify-list-attribute IN adm-broker-hdl
     1361         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
     1362     RUN use-create-on-add(?).
