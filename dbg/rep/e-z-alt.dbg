     1624               input show-qnty) .
     1625     End.
     1626     Else DO:
     1627         If x-SET_val_TYPE = 1
     1628           then
     1629         run rep/r-z-alt3.p
     1630           (input v-cntxt-obj-code ,
     1631           input v-cntxt-obj-type ,
     1632           input base-type ,
     1633           input base-code ,
     1634           input Classify,
     1635           input itog ,
     1636           input show-zero,
     1637           input sorttype,
     1638           input show-qnty) .
     1639         Else
