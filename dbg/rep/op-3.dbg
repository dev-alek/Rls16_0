     1313                                       or buf_trn-doc.doc-type = 'возврат':U
     1314                                       or buf_trn-doc.doc-type = 'инв':U
     1315                                       then buf_parts.fact-qnty
     1316                                       else - buf_parts.fact-qnty
     1317                                      )
     1318               .
     1319               assign
     1320                 v-fact-qnty           = v-fact-qnty      + v-parts-fact-qnty
     1321                 v-sum-base            = v-sum-base       +  ( price-base-with-tax-loc * v-parts-fact-qnty )
     1322                 v-sum-rubl            = v-sum-rubl       +  ( price-rubl-with-tax-loc * v-parts-fact-qnty )
     1323                 v-vat-base            = v-vat-base       +  ( vat-base-loc            * v-parts-fact-qnty )
