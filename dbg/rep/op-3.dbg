     1133   define variable vss-include-info9 as character format "X(65)" no-undo
     1134   initial "@(#)$Workfile$ $Revision$".
     1135   def var vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1136   procedure r-cost :
     1137     define input  parameter v-doc-code       like ub.doc-line.doc-code          no-undo .
     1138     define input  parameter v-artic          like ub.doc-line.artic             no-undo .
     1139     define input  parameter v-prod-type      like ub.doc-line.prod-type         no-undo .
     1140     define input  parameter v-prod-code      like ub.doc-line.prod-code         no-undo .
     1141     define output parameter v-fact-qnty      like ub.ot-line.fact-qnty       no-undo .
     1142     define output parameter v-vat-pc         like ub.doc-line.vat-pc         no-undo .
     1143     define output parameter v-slt-pc         like ub.doc-line.slt-pc         no-undo .
     1144     define output parameter v-sum-base       like ub.ot-line.sum-base        no-undo .
     1145     define output parameter v-sum-rubl       like ub.ot-line.sum-rubl        no-undo .
     1146     define output parameter v-vat-base       like ub.ot-line.vat-base        no-undo .
     1147     define output parameter v-vat-rubl       like ub.ot-line.vat-rubl        no-undo .
     1148     define output parameter v-slt-base       like ub.ot-line.slt-base        no-undo .
     1149     define output parameter v-slt-rubl       like ub.ot-line.slt-rubl        no-undo .
     1150     define output parameter v-road-tax-base  like ub.ot-line.road-tax-base   no-undo .
     1151     define output parameter v-road-tax-rubl  like ub.ot-line.road-tax-rubl   no-undo .
     1152     define output parameter v-transport-base like ub.ot-line.transport-base  no-undo .
     1153     define output parameter v-transport-rubl like ub.ot-line.transport-rubl  no-undo .
     1154     define output parameter v-other-base     like ub.ot-line.other-base      no-undo .
     1155     define output parameter v-other-rubl     like ub.ot-line.other-rubl      no-undo .
     1156     define output parameter v-excise-base    like ub.ot-line.excise-base     no-undo .
     1157     define output parameter v-excise-rubl    like ub.ot-line.excise-rubl     no-undo .
     1158     do
     1159     on error undo, return error
     1160     :
     1161       define buffer   in-vatp-trn-doc  for ub.trn-doc .
     1162       define buffer   in-vatp-parts    for ub.parts   .
     1163       define buffer   in-vatp-doc      for ub.trn-doc .
     1164       define buffer   in-vatp-goods    for ub.goods   .
     1165       define buffer   in-vatp-sysconf  for ub.sysconf .
     1166       define buffer   in-vatp_doc-attr for ub.doc-attr.
     1167       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
     1168       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
     1169       define variable varinvprb                  as   character              no-undo.
     1170       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
     1171       define variable cli-base-rate              as   decimal                no-undo.
     1172       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
     1173       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
     1174       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
     1175       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
     1176       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
     1177       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
     1178       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
     1179       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
     1180       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
     1181       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
     1182       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
     1183       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
     1184       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
     1185       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
     1186       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
     1187       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
     1188       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
     1189       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
     1190       define variable other-base-loc             like ub.doc-line.price-base no-undo.
     1191       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
     1192       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
     1193       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
     1194       define variable varinvatp-envd             as   character              no-undo.
     1195       define variable varinvatp-type             as   character              no-undo.
     1196       def var v-parts-fact-qnty as decimal   no-undo .
     1197       define buffer buf_parts    for ub.parts    .
     1198       define buffer buf_goods    for ub.goods    .
     1199       define buffer buf_trn-doc  for ub.trn-doc  .
     1200       define buffer buf_doc-line for ub.doc-line .
     1201       find first buf_doc-line no-lock
     1202         where buf_doc-line.doc-code  = v-doc-code
     1203           and buf_doc-line.artic     = v-artic
     1204           and buf_doc-line.prod-type = v-prod-type
     1205           and buf_doc-line.prod-code = v-prod-code
     1206         no-error .
     1207       if not available buf_doc-line then do:
     1208         message
     1209           vss-workfile vss-revision vss-description skip
     1210           vss-include-info10 skip
     1211           "Ошибка задания входных параметров" skip
     1212           "Не найдена строка документа"  skip
     1213           "Документ" v-doc-code skip
     1214           "Артикул" v-artic v-prod-type v-prod-code skip
     1215           view-as alert-box error .
     1216         return error .
     1217       end.
     1218       find first buf_trn-doc no-lock
     1219         where buf_trn-doc.doc-code = v-doc-code
     1220         no-error .
     1221       if not available buf_trn-doc then do:
     1222         message
     1223           vss-workfile vss-revision vss-description skip
     1224           vss-include-info10 skip
     1225           "Ошибка задания входных параметров" skip
     1226           "Не найден документ" skip
     1227           "Документ" v-doc-code skip
     1228           "Артикул" v-artic v-prod-type v-prod-code skip
     1229           view-as alert-box error .
     1230         undo, return error .
     1231       end.
     1232       find first buf_goods no-lock
     1233         where buf_goods.artic     = buf_doc-line.artic
     1234           and buf_goods.prod-type = buf_doc-line.prod-type
     1235           and buf_goods.prod-code = buf_doc-line.prod-code
     1236         no-error .
     1237       if not available buf_goods then do:
     1238         message
     1239           vss-workfile vss-revision vss-description skip
     1240           vss-include-info10 skip
     1241           "Ошибка задания входных параметров" skip
     1242           "Не найден товар" skip
     1243           "Документ" v-doc-code skip
     1244           "Артикул" v-artic v-prod-type v-prod-code skip
     1245           view-as alert-box error .
     1246         undo, return error .
     1247       end.
     1248       if buf_goods.gds-type = 'т':U then do:
     1249             for each buf_parts no-lock
     1250               where buf_parts.out-code  = buf_trn-doc.doc-code
     1251                 and buf_parts.obj-type  = buf_trn-doc.obj-type
     1252                 and buf_parts.obj-code  = buf_trn-doc.obj-code
     1253                 and buf_parts.artic     = buf_doc-line.artic
     1254                 and buf_parts.prod-type = buf_doc-line.prod-type
     1255                 and buf_parts.prod-code = buf_doc-line.prod-code
     1256             on error undo, return error
     1257             :
     1258   assign
     1259     price-rubl-with-tax-loc = buf_parts.price-rubl
     1260     price-base-with-tax-loc = buf_parts.price-base
     1261   .
     1262   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1263   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1264     (output varinvprb
     1265     )  .
     1266     if buf_parts.out-code = 'free-zone':U     or
     1267        buf_parts.out-code = 'out-zone':U   or
     1268        buf_parts.doc-type = 'акт':U then do:
     1269       assign
     1270         in-vatp-have-vat-slt = yes.
     1271     end.
     1272     else do:
     1273       find first in-vatp_doc-attr no-lock
     1274         where in-vatp_doc-attr.doc-code  = buf_parts.out-code
     1275           and in-vatp_doc-attr.attr-code = 'envd':U
     1276         no-error .
     1277       if not available in-vatp_doc-attr then do:
     1278         assign
     1279           in-vatp-have-vat-slt = yes.
     1280       end.
     1281       else do:
     1282            in-vatp-have-vat-slt = no.
     1283       end.
     1284     end.
     1285     assign
     1286      price-cli-with-tax-loc = buf_parts.price-cli
     1287      cli-base-rate          = buf_parts.cli-base-rate.
     1288     ASSIGN   road-tax-base-loc  = (if buf_parts.road-tax-base  = ? then 0 else buf_parts.road-tax-base)
     1289              road-tax-rubl-loc  = (if buf_parts.road-tax-rubl  = ? then 0 else buf_parts.road-tax-rubl).
     1290     ASSIGN  transport-base-loc = (if buf_parts.transport-base = ? then 0 else buf_parts.transport-base)
     1291             transport-rubl-loc = (if buf_parts.transport-rubl = ? then 0 else buf_parts.transport-rubl)
     1292             other-base-loc     = (if buf_parts.other-base     = ? then 0 else buf_parts.other-base)
     1293             other-rubl-loc     = (if buf_parts.other-rubl     = ? then 0 else buf_parts.other-rubl)
     1294             vat-pc-loc         = (if buf_parts.vat-pc         = ? then 0 else buf_parts.vat-pc)
     1295             slt-pc-loc         = (if buf_parts.slt-pc         = ? then 0 else buf_parts.slt-pc).
     1296             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     1297       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     1298     assign
     1299       exch-rate-cli-loc = (buf_parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if buf_parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if buf_parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / buf_parts.price-cli .
     1300     assign
     1301       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
     1302       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
     1303       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
     1304       transport-cli-loc  = 0
     1305       other-cli-loc      = 0
     1306     .
