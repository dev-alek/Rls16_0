     1328                 v-road-tax-rubl       = v-road-tax-rubl  +  ( road-tax-rubl-loc       * v-parts-fact-qnty )
     1329                 v-excise-base         =   0
     1330                 v-excise-rubl         =   0
     1331                 v-transport-base      = v-transport-base +   (transport-base-loc      * v-parts-fact-qnty )
     1332                 v-transport-rubl      = v-transport-rubl +   (transport-rubl-loc      * v-parts-fact-qnty )
     1333                 v-other-base          = v-other-base     +   (other-base-loc          * v-parts-fact-qnty )
     1334                 v-other-rubl          = v-other-rubl     +   (other-rubl-loc          * v-parts-fact-qnty )
     1335               .
     1336           end.
