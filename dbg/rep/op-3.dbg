     1484      find first in-vatp-goods where in-vatp-goods.artic     = buf_doc-line.artic     and
     1485                                        in-vatp-goods.prod-type = buf_doc-line.prod-type and
     1486                                        in-vatp-goods.prod-code = buf_doc-line.prod-code no-lock.
     1487      if (not buf_trn-doc.internal and
     1488              buf_trn-doc.doc-type = 'при':U) or
     1489         in-vatp-goods.gds-type = 'у':U then do:
     1490         if varinvprb = "base":u then do:
     1491           assign
     1492             road-tax-base-loc = buf_doc-line.road-tax
     1493             road-tax-rubl-loc = buf_doc-line.road-tax * buf_trn-doc.base-rate / buf_trn-doc.base-scale.
     1494         end.
     1495         else do:
     1496           ASSIGN
     1497             road-tax-rubl-loc = buf_doc-line.road-tax
     1498             road-tax-base-loc = buf_doc-line.road-tax / buf_trn-doc.base-rate * buf_trn-doc.base-scale.
     1499         end.
     1500         if road-tax-base-loc = ? then road-tax-base-loc = 0.
     1501         if road-tax-rubl-loc = ? then road-tax-rubl-loc = 0.
     1502         assign
     1503           road-tax-cli-loc = ?.
     1504         ASSIGN
     1505           transport-base-loc = (if buf_doc-line.transport-base = ? then 0 else buf_doc-line.transport-base)
     1506           transport-rubl-loc = (if buf_doc-line.transport-rubl = ? then 0 else buf_doc-line.transport-rubl)
     1507           transport-cli-loc  = 0
     1508           other-base-loc     = (if buf_doc-line.other-base     = ? then 0 else buf_doc-line.other-base)
     1509           other-rubl-loc     = (if buf_doc-line.other-rubl     = ? then 0 else buf_doc-line.other-rubl)
     1510           other-cli-loc      = 0
     1511           vat-pc-loc         = (if buf_doc-line.vat-pc         = ? then 0 else buf_doc-line.vat-pc)
     1512           slt-pc-loc         = (if buf_doc-line.slt-pc         = ? then 0 else buf_doc-line.slt-pc).
     1513                                 ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     1514               ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     1515         assign
     1516           vat-cli-loc            = ?
     1517           slt-cli-loc            = ?
     1518           price-cli-with-tax-loc = ?.
     1519      end.
     1520      else do:
     1521                                                   for each in-vatp-parts where in-vatp-parts.out-code  = buf_doc-line.doc-code  and
     1522                                         in-vatp-parts.obj-type  = buf_doc-line.obj-type  and
     1523                                         in-vatp-parts.obj-code  = buf_doc-line.obj-code  and
     1524                                         in-vatp-parts.artic     = buf_doc-line.artic     and
     1525                                         in-vatp-parts.prod-type = buf_doc-line.prod-type and
     1526                                         in-vatp-parts.prod-code = buf_doc-line.prod-code
     1527                            use-index out-code no-lock:
     1528             accumulate  in-vatp-parts.road-tax-base  * in-vatp-parts.fact-qnty (total)
     1529                         in-vatp-parts.road-tax-rubl  * in-vatp-parts.fact-qnty (total)
     1530                         in-vatp-parts.transport-base * in-vatp-parts.fact-qnty (total)
     1531                         in-vatp-parts.transport-rubl * in-vatp-parts.fact-qnty (total)
     1532                         in-vatp-parts.other-base     * in-vatp-parts.fact-qnty (total)
     1533                         in-vatp-parts.other-rubl     * in-vatp-parts.fact-qnty (total)
     1534                                                                                                                 (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  (total)
     1535                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))  (total)
     1536                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))  (total)
     1537                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc))  (total)
     1538                                               (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  (total)
     1539                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))  (total)
     1540                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))  (total)
     1541                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc))  (total)
     1542                         .
     1543         end.
     1544         ASSIGN
     1545           road-tax-base-loc   = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.road-tax-base  * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
     1546           road-tax-rubl-loc   = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.road-tax-rubl  * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
     1547           transport-base-loc  = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.transport-base * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
     1548           transport-rubl-loc  = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.transport-rubl * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
     1549           other-base-loc      = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.other-base     * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
     1550           other-rubl-loc      = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.other-rubl     * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
     1551                                           vat-base-loc        = if buf_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / buf_doc-line.fact-qnty   else 0
     1552           slt-base-loc        = if buf_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / buf_doc-line.fact-qnty   else 0
     1553                   vat-rubl-loc        = if buf_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / buf_doc-line.fact-qnty   else 0
     1554           slt-rubl-loc        = if buf_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / buf_doc-line.fact-qnty   else 0
     1555           vat-pc-loc          = (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc)))
     1556           slt-pc-loc          = (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))).
     1557         if road-tax-base-loc  = ? then road-tax-base-loc  = 0.
     1558         if road-tax-rubl-loc  = ? then road-tax-rubl-loc  = 0.
     1559         if transport-base-loc = ? then transport-base-loc = 0.
     1560         if transport-rubl-loc = ? then transport-rubl-loc = 0.
     1561         if other-base-loc     = ? then other-base-loc     = 0.
     1562         if other-rubl-loc     = ? then other-rubl-loc     = 0.
     1563         assign
     1564           transport-cli-loc      = 0
     1565           other-cli-loc          = 0
     1566           road-tax-cli-loc       = ?
     1567           vat-cli-loc            = ?
     1568           slt-cli-loc            = ?
     1569           price-cli-with-tax-loc = ?.
     1570      end.
     1571   ASSIGN
     1572             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     1573       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     1574   .
     1575             assign
     1576               v-fact-qnty           = v-fact-qnty      + v-parts-fact-qnty
     1577               v-vat-pc              = vat-pc-loc
     1578               v-slt-pc              = slt-pc-loc
     1579               v-sum-base            = v-sum-base       + (price-base-with-tax-loc * v-parts-fact-qnty)
     1580               v-sum-rubl            = v-sum-rubl       + (price-rubl-with-tax-loc * v-parts-fact-qnty)
     1581               v-vat-base            = v-vat-base       + (vat-base-loc            * v-parts-fact-qnty)
     1582               v-vat-rubl            = v-vat-rubl       + (vat-rubl-loc            * v-parts-fact-qnty)
     1583               v-slt-base            = v-slt-base       + (slt-base-loc            * v-parts-fact-qnty)
     1584               v-slt-rubl            = v-slt-rubl       + (slt-rubl-loc            * v-parts-fact-qnty)
     1585               v-road-tax-base       =  0
     1586               v-road-tax-rubl       =  0
     1587               v-excise-base         =  0
     1588               v-excise-rubl         =  0
     1589               v-transport-base      =  0
     1590               v-transport-rubl      =  0
     1591               v-other-base          =  0
     1592               v-other-rubl          =  0
     1593             .
     1594       end.
     1595     end.
     1596   end procedure.
     1597   procedure fbrrep-fill-qnty-and-prices :
     1598   do
     1599   on error undo, return error
     1600   :
     1601   define input parameter p-fbr-doc-doc-code  as character    no-undo.
     1602       define variable v-gds-code  as integer       no-undo.
     1603       define variable v-gds-name  as character     no-undo.
     1604       define variable v-sign      as decimal       no-undo.
     1605       define buffer buf_fbr-line          for ub.fbr-line.
     1606       define buffer buf_temp_fbrrep-goods for temp_fbrrep-goods.
     1607       for each buf_fbr-line no-lock
     1608          where buf_fbr-line.doc-code = p-fbr-doc-doc-code
     1609       on error undo, return error
     1610       :
     1611           find first buf_temp_fbrrep-goods
     1612                where buf_temp_fbrrep-goods.artic     = buf_fbr-line.artic
     1613                  and buf_temp_fbrrep-goods.prod-type = buf_fbr-line.prod-type
     1614                  and buf_temp_fbrrep-goods.prod-code = buf_fbr-line.prod-code
     1615           use-index ar
     1616           no-error.
     1617           if not available buf_temp_fbrrep-goods
     1618           then do:
     1619               create buf_temp_fbrrep-goods.
     1620   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1621   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
     1622     (input  buf_fbr-line.artic
     1623     ,input  buf_fbr-line.prod-type
     1624     ,input  buf_fbr-line.prod-code
     1625     ,output v-gds-code
     1626     )  .
     1627   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1628   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-arnm in g#library
     1629     (input  buf_fbr-line.artic
     1630     ,input  buf_fbr-line.prod-type
     1631     ,input  buf_fbr-line.prod-code
     1632     ,output v-gds-name
     1633     )  .
     1634   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1635   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     1636     (input  buf_fbr-line.artic
     1637     ,input  buf_fbr-line.prod-type
     1638     ,input  buf_fbr-line.prod-code
     1639     ,input  'gds-goods=request':u
     1640     ,output buf_temp_fbrrep-goods.is-not-office
     1641     )  .
     1642               assign
     1643                   buf_temp_fbrrep-goods.gds-code             = v-gds-code
     1644                   buf_temp_fbrrep-goods.artic                = buf_fbr-line.artic
     1645                   buf_temp_fbrrep-goods.prod-type            = buf_fbr-line.prod-type
     1646                   buf_temp_fbrrep-goods.prod-code            = buf_fbr-line.prod-code
     1647                   buf_temp_fbrrep-goods.gds-name             = v-gds-name
     1648                   buf_temp_fbrrep-goods.is-waste             = buf_fbr-line.is-waste
     1649                   buf_temp_fbrrep-goods.fact-qnty            = 0
     1650                   buf_temp_fbrrep-goods.write-off-rsrv-qnty  = 0
     1651                   buf_temp_fbrrep-goods.write-off-qnty       = 0
     1652                   buf_temp_fbrrep-goods.income-qnty          = 0
     1653                   buf_temp_fbrrep-goods.income-rsrv-qnty     = 0
     1654                   buf_temp_fbrrep-goods.cost-rubl            = 0
     1655                   buf_temp_fbrrep-goods.cost-base            = 0
     1656                   buf_temp_fbrrep-goods.sum-cost-rubl        = 0
     1657                   buf_temp_fbrrep-goods.sum-cost-base        = 0
     1658                   buf_temp_fbrrep-goods.vat-cost-rubl        = 0
     1659                   buf_temp_fbrrep-goods.vat-cost-base        = 0
     1660                   buf_temp_fbrrep-goods.sum-vat-cost-rubl    = 0
     1661                   buf_temp_fbrrep-goods.sum-vat-cost-base    = 0
     1662                   buf_temp_fbrrep-goods.price-sale           = buf_fbr-line.price-sale
     1663                   buf_temp_fbrrep-goods.deleted              = no
     1664               .
     1665   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1666   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run unitbase in g#library
     1667     (input  v-gds-code
     1668     ,output buf_temp_fbrrep-goods.unit-base
     1669     )  .
     1670           end.
     1671           case buf_fbr-line.trn-type
     1672           :
     1673               when 'при':U
     1674               then do:
     1675                   assign
     1676                       v-sign                                  = 1
     1677                       buf_temp_fbrrep-goods.income-qnty       = buf_temp_fbrrep-goods.income-qnty     + buf_fbr-line.fact-qnty
     1678                   .
     1679                   if buf_fbr-line.rsrv-qnty <> ?
     1680                   then do:
     1681                       assign
     1682                           buf_temp_fbrrep-goods.income-rsrv-qnty = buf_temp_fbrrep-goods.income-rsrv-qnty   + buf_fbr-line.rsrv-qnty
     1683                       .
     1684                   end.
     1685               end.
     1686               when 'спи':U
     1687               then do:
     1688                   assign
     1689                       v-sign                                  = -1
     1690                       buf_temp_fbrrep-goods.write-off-qnty    = buf_temp_fbrrep-goods.write-off-qnty  + buf_fbr-line.fact-qnty
     1691                   .
     1692                   if buf_fbr-line.rsrv-qnty <> ?
     1693                   then do:
     1694                       assign
     1695                           buf_temp_fbrrep-goods.write-off-rsrv-qnty = buf_temp_fbrrep-goods.write-off-rsrv-qnty   + buf_fbr-line.rsrv-qnty
     1696                       .
     1697                   end.
     1698               end.
     1699           end case.
     1700           assign
     1701               buf_temp_fbrrep-goods.sum-cost-rubl        = buf_temp_fbrrep-goods.sum-cost-rubl     + v-sign * buf_fbr-line.price-sum-rubl
     1702               buf_temp_fbrrep-goods.sum-cost-base        = buf_temp_fbrrep-goods.sum-cost-base     + v-sign * buf_fbr-line.price-sum-base
     1703               buf_temp_fbrrep-goods.sum-vat-cost-rubl    = buf_temp_fbrrep-goods.sum-vat-cost-rubl + v-sign * buf_fbr-line.price-sum-vat-rubl
     1704               buf_temp_fbrrep-goods.sum-vat-cost-base    = buf_temp_fbrrep-goods.sum-vat-cost-base + v-sign * buf_fbr-line.price-sum-vat-base
     1705           .
     1706       end.
     1707       run test-temp-tables in this-procedure .
     1708   end.
     1709   end procedure.
     1710   procedure fbrrep-fill-for-fbr-actp :
     1711   do
     1712   on error undo, return error
     1713   :
     1714   define input parameter p-fbr-doc-doc-code  as character    no-undo.
     1715       define buffer buf_temp_fbrrep-goods for temp_fbrrep-goods.
     1716       define buffer buf_fbr-line          for ub.fbr-line.
     1717       run fbrrep-fill-qnty-and-prices in this-procedure (
     1718           input p-fbr-doc-doc-code
     1719       ).
     1720       for each buf_temp_fbrrep-goods
     1721       :
     1722           assign
     1723               buf_temp_fbrrep-goods.sum-cost-rubl     = 0
     1724               buf_temp_fbrrep-goods.sum-cost-base     = 0
     1725               buf_temp_fbrrep-goods.sum-vat-cost-rubl = 0
     1726               buf_temp_fbrrep-goods.sum-vat-cost-base = 0
     1727               buf_temp_fbrrep-goods.cost-rubl     = 0
     1728               buf_temp_fbrrep-goods.cost-base     = 0
     1729               buf_temp_fbrrep-goods.vat-cost-rubl = 0
     1730               buf_temp_fbrrep-goods.vat-cost-base = 0
     1731           .
     1732           if buf_temp_fbrrep-goods.income-qnty = 0
     1733           or buf_temp_fbrrep-goods.write-off-qnty = 0
     1734           then do:
     1735               assign
     1736                   buf_temp_fbrrep-goods.deleted   = yes
     1737                   buf_temp_fbrrep-goods.fact-qnty = 0
     1738               .
     1739           end.
     1740           else do:
     1741               if buf_temp_fbrrep-goods.income-qnty <= buf_temp_fbrrep-goods.write-off-qnty
     1742               then do:
     1743                   assign
     1744                       buf_temp_fbrrep-goods.fact-qnty = buf_temp_fbrrep-goods.income-qnty
     1745                   .
     1746                   for each buf_fbr-line no-lock
     1747                      where buf_fbr-line.doc-code  = p-fbr-doc-doc-code
     1748                        and buf_fbr-line.artic     = buf_temp_fbrrep-goods.artic
     1749                        and buf_fbr-line.prod-type = buf_temp_fbrrep-goods.prod-type
     1750                        and buf_fbr-line.prod-code = buf_temp_fbrrep-goods.prod-code
     1751                        and buf_fbr-line.trn-type  = 'при':U
     1752                   :
     1753                       assign
     1754                           buf_temp_fbrrep-goods.sum-cost-rubl     = buf_temp_fbrrep-goods.sum-cost-rubl     + buf_fbr-line.price-sum-rubl
     1755                           buf_temp_fbrrep-goods.sum-cost-base     = buf_temp_fbrrep-goods.sum-cost-base     + buf_fbr-line.price-sum-base
     1756                           buf_temp_fbrrep-goods.sum-vat-cost-rubl = buf_temp_fbrrep-goods.sum-vat-cost-rubl + buf_fbr-line.price-sum-vat-rubl
     1757                           buf_temp_fbrrep-goods.sum-vat-cost-base = buf_temp_fbrrep-goods.sum-vat-cost-base + buf_fbr-line.price-sum-vat-base
     1758                       .
     1759                   end.
     1760                   assign
     1761                       buf_temp_fbrrep-goods.cost-rubl     = buf_temp_fbrrep-goods.sum-cost-rubl     / buf_temp_fbrrep-goods.fact-qnty
     1762                       buf_temp_fbrrep-goods.cost-base     = buf_temp_fbrrep-goods.sum-cost-base     / buf_temp_fbrrep-goods.fact-qnty
     1763                       buf_temp_fbrrep-goods.vat-cost-rubl = buf_temp_fbrrep-goods.sum-vat-cost-rubl / buf_temp_fbrrep-goods.fact-qnty
     1764                       buf_temp_fbrrep-goods.vat-cost-base = buf_temp_fbrrep-goods.sum-vat-cost-base / buf_temp_fbrrep-goods.fact-qnty
     1765                   .
     1766               end.
     1767               else do:
     1768                   assign
     1769                       buf_temp_fbrrep-goods.fact-qnty = buf_temp_fbrrep-goods.write-off-qnty
     1770                   .
     1771                   for each buf_fbr-line no-lock
     1772                      where buf_fbr-line.doc-code  = p-fbr-doc-doc-code
     1773                        and buf_fbr-line.artic     = buf_temp_fbrrep-goods.artic
     1774                        and buf_fbr-line.prod-type = buf_temp_fbrrep-goods.prod-type
     1775                        and buf_fbr-line.prod-code = buf_temp_fbrrep-goods.prod-code
     1776                        and buf_fbr-line.trn-type  = 'спи':U
     1777                   :
     1778                       assign
     1779                           buf_temp_fbrrep-goods.sum-cost-rubl     = buf_temp_fbrrep-goods.sum-cost-rubl     + buf_fbr-line.price-sum-rubl
     1780                           buf_temp_fbrrep-goods.sum-cost-base     = buf_temp_fbrrep-goods.sum-cost-base     + buf_fbr-line.price-sum-base
     1781                           buf_temp_fbrrep-goods.sum-vat-cost-rubl = buf_temp_fbrrep-goods.sum-vat-cost-rubl + buf_fbr-line.price-sum-vat-rubl
     1782                           buf_temp_fbrrep-goods.sum-vat-cost-base = buf_temp_fbrrep-goods.sum-vat-cost-base + buf_fbr-line.price-sum-vat-base
     1783                       .
     1784                   end.
     1785                   assign
     1786                       buf_temp_fbrrep-goods.cost-rubl     = buf_temp_fbrrep-goods.sum-cost-rubl     / buf_temp_fbrrep-goods.fact-qnty
     1787                       buf_temp_fbrrep-goods.cost-base     = buf_temp_fbrrep-goods.sum-cost-base     / buf_temp_fbrrep-goods.fact-qnty
     1788                       buf_temp_fbrrep-goods.vat-cost-rubl = buf_temp_fbrrep-goods.sum-vat-cost-rubl / buf_temp_fbrrep-goods.fact-qnty
     1789                       buf_temp_fbrrep-goods.vat-cost-base = buf_temp_fbrrep-goods.sum-vat-cost-base / buf_temp_fbrrep-goods.fact-qnty
     1790                   .
     1791               end.
     1792           end.
     1793       end.
     1794       for each buf_temp_fbrrep-goods
     1795          where buf_temp_fbrrep-goods.deleted = yes
     1796       on error undo, return error
     1797       :
     1798           delete buf_temp_fbrrep-goods.
     1799       end.
     1800       run test-temp-tables in this-procedure .
     1801   end.
     1802   end procedure.
     1803   procedure fbrrep-fill-for-op-del :
     1804   do
     1805   on error undo, return error
     1806   :
     1807   define input parameter p-fbr-doc-doc-code   as character    no-undo.
     1808   define input parameter p-db-remote          as logical          no-undo.
     1809       define variable v-serv-code as character    no-undo.
     1810       define variable v-in-code   as character    no-undo.
     1811       define variable v-out-code  as character    no-undo.
     1812       define variable v-trn-qnty  as decimal       no-undo.
     1813       define variable v-sign      as decimal       no-undo.
     1814       define variable v-qnty      as decimal       no-undo.
     1815       define buffer buf_fbr-doc           for ub.fbr-doc.
     1816       define buffer buf_fbr-line          for ub.fbr-line.
     1817       define buffer buf_goods             for ub.goods .
     1818       define buffer buf_doc-line          for ub.doc-line .
     1819       define buffer buf_temp_fbrrep-goods for temp_fbrrep-goods .
     1820       run fbrrep-fill-qnty-and-prices in this-procedure (
     1821           input p-fbr-doc-doc-code
     1822       ).
     1823       for each buf_temp_fbrrep-goods
     1824       on error undo, return error
     1825       :
     1826           if buf_temp_fbrrep-goods.income-qnty <> 0
     1827           or buf_temp_fbrrep-goods.write-off-qnty <> 0
     1828           then do:
     1829               assign
     1830                   v-qnty  = ( buf_temp_fbrrep-goods.write-off-qnty - buf_temp_fbrrep-goods.income-qnty )
     1831               .
     1832               if v-qnty = 0
     1833               then do:
     1834                   find first buf_fbr-line no-lock
     1835                        where buf_fbr-line.doc-code    = p-fbr-doc-doc-code
     1836                          and buf_fbr-line.artic       = buf_temp_fbrrep-goods.artic
     1837                          and buf_fbr-line.prod-type   = buf_temp_fbrrep-goods.prod-type
     1838                          and buf_fbr-line.prod-code   = buf_temp_fbrrep-goods.prod-code
     1839                          and buf_fbr-line.fact-qnty   <> 0
     1840                   no-error.
     1841                   if available buf_fbr-line
     1842                   then do:
     1843                       assign
     1844                           buf_temp_fbrrep-goods.cost-rubl     = buf_fbr-line.price-rubl
     1845                           buf_temp_fbrrep-goods.cost-base     = buf_fbr-line.price-base
     1846                           buf_temp_fbrrep-goods.vat-cost-rubl = buf_fbr-line.price-sum-vat-rubl / buf_fbr-line.fact-qnty
     1847                           buf_temp_fbrrep-goods.vat-cost-base = buf_fbr-line.price-sum-vat-base / buf_fbr-line.fact-qnty
     1848                       .
     1849                   end.
     1850                   else do:
     1851                       assign
     1852                           buf_temp_fbrrep-goods.cost-rubl     = 0
     1853                           buf_temp_fbrrep-goods.cost-base     = 0
     1854                           buf_temp_fbrrep-goods.vat-cost-rubl = 0
     1855                           buf_temp_fbrrep-goods.vat-cost-base = 0
     1856                       .
     1857                   end.
     1858               end.
     1859               else do:
     1860                   assign
     1861                       buf_temp_fbrrep-goods.cost-rubl     = buf_temp_fbrrep-goods.sum-cost-rubl     / v-qnty
     1862                       buf_temp_fbrrep-goods.cost-base     = buf_temp_fbrrep-goods.sum-cost-base     / v-qnty
     1863                       buf_temp_fbrrep-goods.vat-cost-rubl = buf_temp_fbrrep-goods.sum-vat-cost-rubl / v-qnty
     1864                       buf_temp_fbrrep-goods.vat-cost-base = buf_temp_fbrrep-goods.sum-vat-cost-base / v-qnty
     1865                   .
     1866               end.
     1867           end.
     1868           else do:
     1869               assign
     1870                   buf_temp_fbrrep-goods.cost-rubl     = 0
     1871                   buf_temp_fbrrep-goods.cost-base     = 0
     1872                   buf_temp_fbrrep-goods.vat-cost-rubl = 0
     1873                   buf_temp_fbrrep-goods.vat-cost-base = 0
     1874               .
     1875           end.
     1876       end.
     1877       for each buf_temp_fbrrep-goods
     1878       :
     1879           if buf_temp_fbrrep-goods.is-waste = yes
     1880           then do:
     1881               assign
     1882                   buf_temp_fbrrep-goods.deleted = yes
     1883               .
     1884           end.
     1885           else do:
     1886               if buf_temp_fbrrep-goods.write-off-qnty <> 0
     1887               and buf_temp_fbrrep-goods.income-qnty <> 0
     1888               then do:
     1889                   if buf_temp_fbrrep-goods.write-off-qnty = buf_temp_fbrrep-goods.income-qnty
     1890                   then do:
     1891                       assign
     1892                           buf_temp_fbrrep-goods.deleted = yes
     1893                       .
     1894                   end.
     1895                   else do:
     1896                       if buf_temp_fbrrep-goods.write-off-qnty > buf_temp_fbrrep-goods.income-qnty
     1897                       then do:
     1898                           assign
     1899                               buf_temp_fbrrep-goods.write-off-qnty    = buf_temp_fbrrep-goods.write-off-qnty - buf_temp_fbrrep-goods.income-qnty
     1900                               buf_temp_fbrrep-goods.income-qnty       = 0
     1901                           .
     1902                       end.
     1903                       else do:
     1904                           assign
     1905                               buf_temp_fbrrep-goods.income-qnty       = buf_temp_fbrrep-goods.income-qnty - buf_temp_fbrrep-goods.write-off-qnty
     1906                               buf_temp_fbrrep-goods.write-off-qnty    = 0
     1907                           .
     1908                       end.
     1909                   end.
     1910               end.
     1911           end.
     1912       end.
     1913       for each buf_temp_fbrrep-goods
     1914          where buf_temp_fbrrep-goods.deleted = yes
     1915       on error undo, return error
     1916       :
     1917           delete buf_temp_fbrrep-goods.
     1918       end.
     1919       run test-temp-tables in this-procedure .
     1920       find first buf_fbr-doc no-lock
     1921            where buf_fbr-doc.doc-code = p-fbr-doc-doc-code
     1922       .
     1923       assign
     1924           v-out-code = p-fbr-doc-doc-code
     1925       .
     1926       run doc-code in this-procedure (
     1927             input  "pair"
     1928           , input  buf_fbr-doc.obj-type
     1929           , input  buf_fbr-doc.obj-code
     1930           , input  v-out-code
     1931           , output v-in-code
     1932       ) no-error.
     1933       if error-status:error
     1934       then do:
     1935           message
     1936                    vss-workfile vss-revision vss-description
     1937               skip "Ошибка вычисления номера приходной накладной."
     1938               skip return-value
     1939               skip trim(error-status :get-message(1))
     1940                    trim(error-status :get-message(2))
     1941                    trim(error-status :get-message(3))
     1942           view-as alert-box error.
     1943           undo, return error .
     1944       end.
     1945       run doc-code in this-procedure (
     1946             input  "trio"
     1947           , input  buf_fbr-doc.obj-type
     1948           , input  buf_fbr-doc.obj-code
     1949           , input  v-in-code
     1950           , output v-serv-code
     1951       ) no-error.
     1952       if error-status:error
     1953       then do:
     1954           message
     1955                    vss-workfile vss-revision vss-description
     1956               skip "Ошибка вычисления номера накладной расхода."
     1957               skip return-value
     1958               skip trim(error-status :get-message(1))
     1959                    trim(error-status :get-message(2))
     1960                    trim(error-status :get-message(3))
     1961           view-as alert-box error.
     1962           undo, return error .
     1963       end.
     1964       for each buf_temp_fbrrep-goods
     1965       on error undo, return error
     1966       :
     1967           if buf_temp_fbrrep-goods.income-qnty > buf_temp_fbrrep-goods.write-off-qnty
     1968           then do:
     1969               find first buf_doc-line no-lock
     1970                    where buf_doc-line.doc-code  = v-in-code
     1971                      and buf_doc-line.artic     = buf_temp_fbrrep-goods.artic
     1972                      and buf_doc-line.prod-type = buf_temp_fbrrep-goods.prod-type
     1973                      and buf_doc-line.prod-code = buf_temp_fbrrep-goods.prod-code
     1974               no-error.
     1975               if available buf_doc-line
     1976               then do:
     1977                   assign
     1978                       buf_temp_fbrrep-goods.fact-qnty = buf_temp_fbrrep-goods.income-qnty - buf_doc-line.doc-qnty
     1979                   .
     1980               end.
     1981               else do:
     1982                   assign
     1983                       buf_temp_fbrrep-goods.fact-qnty = buf_temp_fbrrep-goods.income-qnty
     1984                   .
     1985               end.
     1986           end.
     1987           else do:
     1988               if buf_temp_fbrrep-goods.is-not-office = no
     1989               then do:
     1990                   find first buf_doc-line no-lock
     1991                        where buf_doc-line.doc-code  = v-serv-code
     1992                          and buf_doc-line.artic     = buf_temp_fbrrep-goods.artic
     1993                          and buf_doc-line.prod-type = buf_temp_fbrrep-goods.prod-type
     1994                          and buf_doc-line.prod-code = buf_temp_fbrrep-goods.prod-code
     1995                   no-error.
     1996               end.
     1997               else do:
     1998                   find first buf_doc-line no-lock
     1999                        where buf_doc-line.doc-code  = v-out-code
     2000                          and buf_doc-line.artic     = buf_temp_fbrrep-goods.artic
     2001                          and buf_doc-line.prod-type = buf_temp_fbrrep-goods.prod-type
     2002                          and buf_doc-line.prod-code = buf_temp_fbrrep-goods.prod-code
     2003                   no-error.
     2004               end.
     2005               if available buf_doc-line
     2006               then do:
     2007                   assign
     2008                       buf_temp_fbrrep-goods.fact-qnty = buf_temp_fbrrep-goods.write-off-qnty - buf_doc-line.doc-qnty
     2009                   .
     2010               end.
     2011               else do:
     2012                   assign
     2013                       buf_temp_fbrrep-goods.fact-qnty = buf_temp_fbrrep-goods.write-off-qnty
     2014                   .
     2015               end.
     2016           end.
     2017           if available buf_doc-line
     2018           then do:
     2019               define variable v-void              as decimal       no-undo.
     2020               define variable v-fact-qnty         as decimal       no-undo.
     2021               define variable v-sum-base          as decimal       no-undo.
     2022               define variable v-sum-rubl          as decimal       no-undo.
     2023               define variable v-vat-base          as decimal       no-undo.
     2024               define variable v-vat-rubl          as decimal       no-undo.
     2025               define variable v-slt-base          as decimal       no-undo.
     2026               define variable v-slt-rubl          as decimal       no-undo.
     2027               define variable v-road-tax-base     as decimal       no-undo.
     2028               define variable v-road-tax-rubl     as decimal       no-undo.
     2029               define variable v-transport-base    as decimal       no-undo.
     2030               define variable v-transport-rubl    as decimal       no-undo.
     2031               define variable v-other-base        as decimal       no-undo.
     2032               define variable v-other-rubl        as decimal       no-undo.
     2033               define variable v-excise-base       as decimal       no-undo.
     2034               define variable v-excise-rubl       as decimal       no-undo.
     2035               run r-cost in this-procedure (
     2036                     input buf_doc-line.doc-code
     2037                   , input buf_doc-line.artic
     2038                   , input buf_doc-line.prod-type
     2039                   , input buf_doc-line.prod-code
     2040                   , output v-fact-qnty
     2041                   , output v-void
     2042                   , output v-void
     2043                   , output v-sum-base
     2044                   , output v-sum-rubl
     2045                   , output v-vat-base
     2046                   , output v-vat-rubl
     2047                   , output v-slt-base
     2048                   , output v-slt-rubl
     2049                   , output v-road-tax-base
     2050                   , output v-road-tax-rubl
     2051                   , output v-transport-base
     2052                   , output v-transport-rubl
     2053                   , output v-other-base
     2054                   , output v-other-rubl
     2055                   , output v-excise-base
     2056                   , output v-excise-rubl
     2057               ).
     2058               assign
     2059                   v-sign = ( if v-fact-qnty >= 0 then 1 else -1 )
     2060               .
     2061               assign
     2062                   v-sum-rubl = v-sum-rubl - v-vat-rubl - v-slt-rubl - v-road-tax-rubl - v-transport-rubl - v-other-rubl - v-excise-rubl
     2063                   v-sum-base = v-sum-base - v-vat-base - v-slt-base - v-road-tax-base - v-transport-base - v-other-base - v-excise-base
     2064                   v-sum-rubl = v-sum-rubl   * v-sign
     2065                   v-sum-base = v-sum-base   * v-sign
     2066                   v-vat-rubl = v-vat-rubl   * v-sign
     2067                   v-vat-base = v-vat-base   * v-sign
     2068                   v-fact-qnty = v-fact-qnty * v-sign
     2069               .
     2070               output to "fbrrep.txt" append .
     2071               put unformatted skip(1) v-fact-qnty "   " v-sum-rubl "    " v-vat-rubl.
     2072               output close.
     2073               assign
     2074                   buf_temp_fbrrep-goods.sum-cost-rubl     = absolute( buf_temp_fbrrep-goods.cost-rubl     * v-fact-qnty ) - absolute( v-sum-rubl )
     2075                   buf_temp_fbrrep-goods.sum-cost-base     = absolute( buf_temp_fbrrep-goods.cost-base     * v-fact-qnty ) - absolute( v-sum-base )
     2076                   buf_temp_fbrrep-goods.sum-vat-cost-rubl = absolute( buf_temp_fbrrep-goods.vat-cost-rubl * v-fact-qnty ) - absolute( v-vat-rubl )
     2077                   buf_temp_fbrrep-goods.sum-vat-cost-base = absolute( buf_temp_fbrrep-goods.vat-cost-base * v-fact-qnty ) - absolute( v-vat-base )
     2078               .
     2079               if buf_temp_fbrrep-goods.fact-qnty          = 0
     2080               and buf_temp_fbrrep-goods.sum-cost-rubl     = 0
     2081               and buf_temp_fbrrep-goods.sum-cost-base     = 0
     2082               and buf_temp_fbrrep-goods.sum-vat-cost-rubl = 0
     2083               and buf_temp_fbrrep-goods.sum-vat-cost-base = 0
     2084               then do:
     2085                   assign
     2086                       buf_temp_fbrrep-goods.deleted = yes
     2087                   .
     2088               end.
     2089           end.
     2090       end.
     2091       for each buf_temp_fbrrep-goods
     2092          where buf_temp_fbrrep-goods.deleted = yes
     2093       on error undo, return error
     2094       :
     2095           delete buf_temp_fbrrep-goods.
     2096       end.
     2097       run test-temp-tables in this-procedure .
     2098   end.
     2099   end procedure.
     2100   procedure test-temp-tables :
     2101   do
     2102   on error undo, return error
     2103   :
     2104       define variable v-str   as character     no-undo.
     2105       assign
     2106           v-str = ""
     2107       .
     2108       for each temp_fbrrep-goods
     2109       :
     2110           assign
     2111               v-str = v-str
     2112                   + chr(10) + temp_fbrrep-goods.artic
     2113                   + chr(9) + string( temp_fbrrep-goods.income-qnty )
     2114                   + chr(9) + string( temp_fbrrep-goods.write-off-qnty )
     2115                   + chr(9) + string( temp_fbrrep-goods.cost-rubl )
     2116                   + chr(9) + string( temp_fbrrep-goods.vat-cost-rubl )
     2117                   + chr(9) + string( temp_fbrrep-goods.sum-cost-rubl )
     2118                   + chr(9) + string( temp_fbrrep-goods.sum-vat-cost-rubl )
     2119                   + chr(9) + string( temp_fbrrep-goods.gds-name )
     2120           .
     2121       end.
     2122       output to "fbrrep.txt" append .
     2123       put unformatted skip(2) v-str.
     2124       output close.
     2125   end.
     2126   end procedure.
     2127   procedure fbrrep-test-fbrdoc-for-fact :
     2128   do
     2129   on error undo, return error
     2130   :
     2131   define output parameter p-have-error        as logical      no-undo.
     2132       define buffer buf_fbr-line          for ub.fbr-line.
     2133       define buffer buf_temp_fbrrep-goods for temp_fbrrep-goods.
     2134       for each buf_temp_fbrrep-goods
     2135       on error undo, return error
     2136       :
     2137       end.
     2138   end.
     2139   end procedure.
     2140   procedure fbrrep-fill-qnty-and-prices-gds :
     2141   do
     2142   on error undo, return error
     2143   :
     2144   define input parameter p-fbr-doc-doc-code   as character    no-undo.
     2145   define input parameter p-gds-code           as integer      no-undo.
     2146       define variable v-sign      as decimal       no-undo.
     2147       define buffer buf_fbr-line          for ub.fbr-line.
     2148       define buffer buf_goods             for ub.goods.
     2149       define buffer buf_temp_fbrrep-goods for temp_fbrrep-goods.
     2150       find first buf_goods no-lock
     2151            where buf_goods.gds-code = p-gds-code
     2152       .
     2153       find first buf_temp_fbrrep-goods
     2154            where buf_temp_fbrrep-goods.artic     = buf_goods.artic
     2155              and buf_temp_fbrrep-goods.prod-type = buf_goods.prod-type
     2156              and buf_temp_fbrrep-goods.prod-code = buf_goods.prod-code
     2157       use-index ar
     2158       no-error.
     2159       if available buf_temp_fbrrep-goods
     2160       then do:
     2161           delete buf_temp_fbrrep-goods.
     2162       end.
     2163       create buf_temp_fbrrep-goods.
     2164   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2165   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     2166     (input  buf_goods.artic
     2167     ,input  buf_goods.prod-type
     2168     ,input  buf_goods.prod-code
     2169     ,input  'gds-goods=request':u
     2170     ,output buf_temp_fbrrep-goods.is-not-office
     2171     )  .
     2172       assign
     2173           buf_temp_fbrrep-goods.gds-code             = p-gds-code
     2174           buf_temp_fbrrep-goods.artic                = buf_goods.artic
     2175           buf_temp_fbrrep-goods.prod-type            = buf_goods.prod-type
     2176           buf_temp_fbrrep-goods.prod-code            = buf_goods.prod-code
     2177           buf_temp_fbrrep-goods.gds-name             = buf_goods.gds-name
     2178           buf_temp_fbrrep-goods.is-waste             = no
     2179           buf_temp_fbrrep-goods.fact-qnty            = 0
     2180           buf_temp_fbrrep-goods.write-off-rsrv-qnty  = 0
     2181           buf_temp_fbrrep-goods.write-off-qnty       = 0
     2182           buf_temp_fbrrep-goods.income-qnty          = 0
     2183           buf_temp_fbrrep-goods.income-rsrv-qnty     = 0
     2184           buf_temp_fbrrep-goods.cost-rubl            = 0
     2185           buf_temp_fbrrep-goods.cost-base            = 0
     2186           buf_temp_fbrrep-goods.sum-cost-rubl        = 0
     2187           buf_temp_fbrrep-goods.sum-cost-base        = 0
     2188           buf_temp_fbrrep-goods.vat-cost-rubl        = 0
     2189           buf_temp_fbrrep-goods.vat-cost-base        = 0
     2190           buf_temp_fbrrep-goods.sum-vat-cost-rubl    = 0
     2191           buf_temp_fbrrep-goods.sum-vat-cost-base    = 0
     2192           buf_temp_fbrrep-goods.price-sale           = 0
     2193           buf_temp_fbrrep-goods.deleted              = no
     2194       .
     2195   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2196   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run unitbase in g#library
     2197     (input  p-gds-code
     2198     ,output buf_temp_fbrrep-goods.unit-base
     2199     )  .
     2200       for each buf_fbr-line no-lock
     2201          where buf_fbr-line.prod-type = buf_goods.prod-type
     2202            and buf_fbr-line.prod-code = buf_goods.prod-code
     2203            and buf_fbr-line.artic     = buf_goods.artic
     2204            and buf_fbr-line.doc-code  = p-fbr-doc-doc-code
     2205       on error undo, return error
     2206       :
     2207           case buf_fbr-line.trn-type
     2208           :
     2209               when 'при':U
     2210               then do:
     2211                   assign
     2212                       v-sign                                          = 1
     2213                       buf_temp_fbrrep-goods.income-qnty               = buf_temp_fbrrep-goods.income-qnty                 + buf_fbr-line.fact-qnty
     2214                       buf_temp_fbrrep-goods.sum-cost-income-rubl      = buf_temp_fbrrep-goods.sum-cost-income-rubl        + ( if buf_fbr-line.price-sum-rubl <> ? then buf_fbr-line.price-sum-rubl        else 0 )
     2215                       buf_temp_fbrrep-goods.sum-cost-income-base      = buf_temp_fbrrep-goods.sum-cost-income-base        + ( if buf_fbr-line.price-sum-rubl <> ? then buf_fbr-line.price-sum-base        else 0 )
     2216                       buf_temp_fbrrep-goods.sum-vat-cost-income-rubl  = buf_temp_fbrrep-goods.sum-vat-cost-income-rubl    + ( if buf_fbr-line.price-sum-rubl <> ? then buf_fbr-line.price-sum-vat-rubl    else 0 )
     2217                       buf_temp_fbrrep-goods.sum-vat-cost-income-base  = buf_temp_fbrrep-goods.sum-vat-cost-income-base    + ( if buf_fbr-line.price-sum-rubl <> ? then buf_fbr-line.price-sum-vat-base    else 0 )
     2218                   .
     2219                   if buf_fbr-line.rsrv-qnty <> ?
     2220                   then do:
     2221                       assign
     2222                           buf_temp_fbrrep-goods.income-rsrv-qnty = buf_temp_fbrrep-goods.income-rsrv-qnty   + buf_fbr-line.rsrv-qnty
     2223                       .
     2224                   end.
     2225               end.
     2226               when 'спи':U
     2227               then do:
     2228                   assign
     2229                       v-sign                                  = -1
     2230                       buf_temp_fbrrep-goods.write-off-qnty    = buf_temp_fbrrep-goods.write-off-qnty      + buf_fbr-line.fact-qnty
     2231                       buf_temp_fbrrep-goods.sum-cost-rubl     = buf_temp_fbrrep-goods.sum-cost-rubl       + ( if buf_fbr-line.price-sum-rubl <> ? then buf_fbr-line.price-sum-rubl        else 0 )
     2232                       buf_temp_fbrrep-goods.sum-cost-base     = buf_temp_fbrrep-goods.sum-cost-base       + ( if buf_fbr-line.price-sum-rubl <> ? then buf_fbr-line.price-sum-base        else 0 )
     2233                       buf_temp_fbrrep-goods.sum-vat-cost-rubl = buf_temp_fbrrep-goods.sum-vat-cost-rubl   + ( if buf_fbr-line.price-sum-rubl <> ? then buf_fbr-line.price-sum-vat-rubl    else 0 )
     2234                       buf_temp_fbrrep-goods.sum-vat-cost-base = buf_temp_fbrrep-goods.sum-vat-cost-base   + ( if buf_fbr-line.price-sum-rubl <> ? then buf_fbr-line.price-sum-vat-base    else 0 )
     2235                   .
     2236                   if buf_fbr-line.rsrv-qnty <> ?
     2237                   then do:
     2238                       assign
     2239                           buf_temp_fbrrep-goods.write-off-rsrv-qnty           = buf_temp_fbrrep-goods.write-off-rsrv-qnty           + buf_fbr-line.rsrv-qnty
     2240                           buf_temp_fbrrep-goods.sum-write-off-rsrv-rubl       = buf_temp_fbrrep-goods.sum-write-off-rsrv-rubl       + ( if buf_fbr-line.price-sum-rubl <> ? then buf_fbr-line.price-sum-rubl        else 0 )
     2241                           buf_temp_fbrrep-goods.sum-write-off-rsrv-base       = buf_temp_fbrrep-goods.sum-write-off-rsrv-base       + ( if buf_fbr-line.price-sum-rubl <> ? then buf_fbr-line.price-sum-base        else 0 )
     2242                           buf_temp_fbrrep-goods.sum-write-off-rsrv-vat-rubl   = buf_temp_fbrrep-goods.sum-write-off-rsrv-vat-rubl   + ( if buf_fbr-line.price-sum-rubl <> ? then buf_fbr-line.price-sum-vat-rubl    else 0 )
     2243                           buf_temp_fbrrep-goods.sum-write-off-rsrv-vat-base   = buf_temp_fbrrep-goods.sum-write-off-rsrv-vat-base   + ( if buf_fbr-line.price-sum-rubl <> ? then buf_fbr-line.price-sum-vat-base    else 0 )
     2244                       .
     2245                   end.
     2246               end.
     2247           end case.
     2248           assign
     2249               buf_temp_fbrrep-goods.is-waste             = buf_fbr-line.is-waste
     2250               buf_temp_fbrrep-goods.price-sale           = buf_fbr-line.price-sale
     2251               buf_temp_fbrrep-goods.cost-income-rubl     = ( if buf_temp_fbrrep-goods.income-qnty     = 0 then 0 else buf_temp_fbrrep-goods.sum-cost-income-rubl      / buf_temp_fbrrep-goods.income-qnty    )
     2252               buf_temp_fbrrep-goods.cost-income-base     = ( if buf_temp_fbrrep-goods.income-qnty     = 0 then 0 else buf_temp_fbrrep-goods.sum-cost-income-base      / buf_temp_fbrrep-goods.income-qnty    )
     2253               buf_temp_fbrrep-goods.vat-cost-income-rubl = ( if buf_temp_fbrrep-goods.income-qnty     = 0 then 0 else buf_temp_fbrrep-goods.sum-vat-cost-income-rubl  / buf_temp_fbrrep-goods.income-qnty    )
     2254               buf_temp_fbrrep-goods.vat-cost-income-base = ( if buf_temp_fbrrep-goods.income-qnty     = 0 then 0 else buf_temp_fbrrep-goods.sum-vat-cost-income-base  / buf_temp_fbrrep-goods.income-qnty    )
     2255               buf_temp_fbrrep-goods.cost-rubl            = ( if buf_temp_fbrrep-goods.write-off-qnty  = 0 then 0 else buf_temp_fbrrep-goods.sum-cost-rubl             / buf_temp_fbrrep-goods.write-off-qnty )
     2256               buf_temp_fbrrep-goods.cost-base            = ( if buf_temp_fbrrep-goods.write-off-qnty  = 0 then 0 else buf_temp_fbrrep-goods.sum-cost-base             / buf_temp_fbrrep-goods.write-off-qnty )
     2257               buf_temp_fbrrep-goods.vat-cost-rubl        = ( if buf_temp_fbrrep-goods.write-off-qnty  = 0 then 0 else buf_temp_fbrrep-goods.sum-vat-cost-rubl         / buf_temp_fbrrep-goods.write-off-qnty )
     2258               buf_temp_fbrrep-goods.vat-cost-base        = ( if buf_temp_fbrrep-goods.write-off-qnty  = 0 then 0 else buf_temp_fbrrep-goods.sum-vat-cost-base         / buf_temp_fbrrep-goods.write-off-qnty )
     2259           .
     2260       end.
     2261       run test-temp-tables in this-procedure .
     2262   end.
     2263   end procedure.
     2264   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2265   define new shared variable PrintCopiesCounter as integer   no-undo initial 1 .
     2266   define new shared variable RepPathName        as character no-undo .
     2267   define new shared variable PrintRubl          as logical   no-undo .
     2268   do
     2269   on error undo, return error return-value
     2270   :
     2271       define temp-table temp_fbr-objects no-undo
     2272           field obj-type  as character
     2273           field obj-code  as integer
     2274           index pi is primary unique obj-type obj-code
     2275       .
     2276       define variable v-doc-code                  as character        no-undo.
     2277       define variable v-doc-date                  as date             no-undo.
     2278       define variable v-counter                   as integer          no-undo.
     2279       define variable v-line-string               as character        no-undo.
     2280       define variable v-base-code                 as integer          no-undo.
     2281       define variable v-units-okei                as integer          no-undo.
     2282       define variable v-sum-qnty                  as decimal          no-undo.
     2283       define variable v-free-qnty                 as decimal        no-undo.
     2284       define variable v-need-qnty                 as decimal        no-undo.
     2285       define variable v-prim                      as character     no-undo.
     2286       define variable v-artic                     as character     no-undo.
     2287       define variable v-gds-name                  as character     no-undo.
     2288       define variable v-unit-base                 as character     no-undo.
     2289       define variable v-barcode                   as character     no-undo.
     2290       define variable v-have-goods-for-inquiry    as logical        no-undo.
     2291       define variable v-first-page                as logical        no-undo.
     2292       define variable v-store-obj-type            as character      no-undo.
     2293       define variable v-store-obj-code            as integer        no-undo.
     2294       define variable sym1 as character init ":"   no-undo.
     2295       define variable sym2 as character init ":"   no-undo.
     2296       define variable sym3 as character init ":"   no-undo.
     2297       define variable sym4 as character init ":"   no-undo.
     2298       define variable sym5 as character init ":"   no-undo.
     2299       define variable sym6 as character init ":"   no-undo.
     2300       define variable sym7 as character init ":"   no-undo.
     2301       define variable sym8 as character init ":"   no-undo.
     2302       define variable g#report-num    as integer      no-undo.
     2303       define variable g#quest-print   as logical      no-undo.
     2304       define variable g#log           as logical      no-undo.
     2305       define buffer buf_fbr-pln       for fbr-pln.
     2306       define buffer buf_fbr-pln-line  for fbr-pln-line.
     2307       define buffer buf_fbr-doc       for fbr-doc.
     2308       define buffer buf_fbr-line      for fbr-line.
     2309       define buffer buf_goods         for goods.
     2310       define buffer buf_units         for units.
     2311       define buffer buf_store_clients for clients.
     2312       define stream Outstream.
     2313       define frame fbr-not-in-rb
     2314           sym1                    column-label "|!|!|!|!|!|"                                format "X(1)"           space(0)
     2315           v-counter               column-label "!п/п  ! ! !------!1  !"                        format ">>9"            space(0)
     2316           sym2                    column-label "|!|!|!|!|!|"                                format "X(1)"           space(0)
     2317           v-gds-name              column-label "                   Продукты        и !-----------------------------------------!           Наименование!-----------------------------------------!              2" format "X(41)"          space(0)
     2318           sym3                    column-label "!|!|!|!"                                 format "X(1)"           space(0)
     2319           v-barcode               column-label "товары    !-----------!    Код!-----------!   3  "                 format "X(10)" space(0)
     2320           sym4                    column-label "|!|!|!|!|!|"                                format "X(1)"           space(0)
     2321           v-unit-base             column-label "   Единица!-------------!    Наиме-!   нование!-------------!      4"                   format "X(3)"           space(0)
     2322           sym5                    column-label "!|!|!|!|"                                format "X(1)"           space(0)
     2323           v-units-okei            column-label "измерения  !-------------!Код по  ! ОКЕИ   !-------------!5      "       format ">>>"          space(0)
     2324           sym6                    column-label "|!|!|!|!|!|"                                format "X(1)"           space(0)
     2325           v-sum-qnty              column-label " !Количество !--------------!6       "                   format ">>,>>9.999"     space(0)
     2326           sym7                    column-label "|!|!|!|!|!|"                                format "X(1)"          space(0)
     2327           v-prim                  column-label " !    Примечание!---------------------!        7"                   format "X(4)"          space(0)
     2328           sym8                    column-label "|!|!|!|!|!|"                                format "X(1)"          space(0)
     2329       HEADER
     2330       skip v-line-string format  "X(127)" AT 1
     2331       with width 136 down stream-io NO-BOX.
     2332       run get-report-num in p-mainmenu-handle (
     2333           output g#report-num
     2334       ).
     2335       run get-quest-print in p-mainmenu-handle (
     2336           output g#quest-print
     2337       ).
     2338       find first buf_fbr-pln no-lock
     2339            where recid( buf_fbr-pln ) = p-fbr-pln-recid
     2340       no-error.
     2341       if not available buf_fbr-pln
     2342       then do:
     2343           message
     2344               "Не найден документ для печати."
     2345           view-as alert-box error.
     2346           undo, return error.
     2347       end.
     2348       assign
     2349           v-line-string = fill( "-", 127 )
     2350       .
     2351   output stream Outstream to value( string( session:temp-directory +
     2352                                        "rpt" + string( g#report-num ) ) )
     2353                                        page-size  value(62) .
     2354   if session :set-wait-state( "compiler" ) then.
     2355       for each buf_fbr-pln-line no-lock
     2356          where buf_fbr-pln-line.doc-code     = buf_fbr-pln.doc-code
     2357       on error undo, return error
     2358       :
     2359           if buf_fbr-pln-line.recipe-code <> ""
     2360           and buf_fbr-pln-line.recipe-code <> ?
     2361           then do:
     2362               if buf_fbr-pln-line.fbr-obj-type <> 'маг':U
     2363               then do:
     2364                   find first buf_goods no-lock
     2365                        where buf_goods.gds-code = buf_fbr-pln-line.gds-code
     2366                   .
     2367                   message
     2368                            "Для производства товара указан объект"
     2369                       skip "недопустимого типа. Производство"
     2370                       skip "может быть только на объекте типа магазин."
     2371                       skip(1)
     2372                       skip "Товар:" buf_goods.artic buf_goods.gds-name
     2373                       skip "Объект:" buf_fbr-pln-line.fbr-obj-type buf_fbr-pln-line.fbr-obj-code
     2374                       skip(1)
     2375                       skip "Измените данные плана-меню."
     2376                   view-as alert-box error.
     2377                   undo, return error.
     2378               end.
     2379               find first temp_fbr-objects
     2380                    where temp_fbr-objects.obj-type = buf_fbr-pln-line.fbr-obj-type
     2381                      and temp_fbr-objects.obj-code = buf_fbr-pln-line.fbr-obj-code
     2382               no-error.
     2383               if not available temp_fbr-objects
     2384               then do:
     2385                   create temp_fbr-objects.
     2386                   assign
     2387                       temp_fbr-objects.obj-type = buf_fbr-pln-line.fbr-obj-type
     2388                       temp_fbr-objects.obj-code = buf_fbr-pln-line.fbr-obj-code
     2389                   .
     2390               end.
     2391           end.
     2392       end.
     2393       assign
     2394           v-first-page = yes
     2395       .
     2396       print-for-object:
     2397       for each temp_fbr-objects
     2398       on error undo, return error
     2399       :
     2400           for each temp_fbrrep-goods
     2401           on error undo, return error
     2402           :
     2403               delete temp_fbrrep-goods.
     2404           end.
     2405           if v-first-page = no
     2406           then do:
     2407               page stream Outstream .
     2408           end.
     2409           else do:
     2410               assign
     2411                   v-first-page = no
     2412               .
     2413           end.
     2414           run fbrrest-get-catering-object in this-procedure (
     2415                 input temp_fbr-objects.obj-code
     2416               , output v-store-obj-type
     2417               , output v-store-obj-code
     2418           ).
     2419           find first buf_fbr-doc no-lock
     2420                where buf_fbr-doc.out-code = buf_fbr-pln.doc-code
     2421                  and buf_fbr-doc.obj-type = temp_fbr-objects.obj-type
     2422                  and buf_fbr-doc.obj-code = temp_fbr-objects.obj-code
     2423           .
     2424           run fbrrep-fill-qnty-and-prices in this-procedure (
     2425               input buf_fbr-doc.doc-code
     2426           ).
     2427           assign
     2428               v-have-goods-for-inquiry = no
     2429           .
     2430           for each temp_fbrrep-goods
     2431           on error undo, return error
     2432           :
     2433               if temp_fbrrep-goods.is-not-office = yes
     2434               and temp_fbrrep-goods.is-waste     = no
     2435               and temp_fbrrep-goods.write-off-qnty > temp_fbrrep-goods.income-qnty
     2436               then do:
     2437                   run fbrrest-get-free-qnty in this-procedure (
     2438                         input buf_fbr-doc.obj-type
     2439                       , input buf_fbr-doc.obj-code
     2440                       , input temp_fbrrep-goods.gds-code
     2441                       , input yes
     2442                       , output v-free-qnty
     2443                   ).
     2444                   assign
     2445                       v-need-qnty = temp_fbrrep-goods.write-off-qnty - temp_fbrrep-goods.income-qnty - v-free-qnty
     2446                   .
     2447                   if v-need-qnty > 0
     2448                   then do:
     2449                       assign
     2450                           v-have-goods-for-inquiry = yes
     2451                       .
     2452                   end.
     2453               end.
     2454           end.
     2455           if v-have-goods-for-inquiry = no
     2456           then do:
     2457               undo print-for-object, next print-for-object.
     2458           end.
     2459           assign
     2460               v-doc-code      = buf_fbr-doc.doc-code
     2461               v-doc-date      = buf_fbr-doc.doc-date
     2462           .
     2463           find first clients no-lock
     2464                where clients.obj-type = buf_fbr-doc.obj-type
     2465                  and clients.obj-code = buf_fbr-doc.obj-code
     2466           .
     2467           find first buf_store_clients no-lock
     2468                where buf_store_clients.obj-type = v-store-obj-type
     2469                  and buf_store_clients.obj-code = v-store-obj-code
     2470           .
     2471           put stream Outstream
     2472               "Унифицированная форма №ОП-3"
     2473               skip
     2474               "Утверждена постановлением Госкомстата" space (63) "_ _ _ _ _ _ _ _ _ _ _ _"
     2475               skip
     2476               "России от 25.12.98 № 132" space (75)  "|_ _ _ _ _ Код _ _ _ _ _|"
     2477               skip
     2478                                   "Форма по ОКУД|_ _ _ _ _0330503_ _ _ _|" at 87
     2479               skip
     2480                                                               "|_ _ _ _ _ _ _ _ _ _ _ _|" at 100
     2481               skip
     2482               string(  '"' + trim(buf_store_clients.obj-name) + '"' ) format "X(40)"  at 35    "по ОКПО |_ _ _ _ _ _ _ _ _ _ _ _|" at 92
     2483               skip
     2484                   "____________________________________"   at 29   "|_ _ _ _ _ _ _ _ _ _ _ _|" at 100
     2485               skip
     2486                   "предприятие (организация)" at 31       "Вид деятельности по ОКДП|_ _ _ _ _ _ _ _ _ _ _ _|" at 76
     2487               skip
     2488               string( buf_store_clients.obj-type + " " + string( buf_store_clients.obj-code ) ) format "X(40)" at 10   "|_ _ _ _ _ _ _ _ _ _ _ _|" at 100
     2489               skip
     2490               "____________________________________"    "Вид операции|_ _ _ _ _ _ _ _ _ _ _ _|" at 88
     2491               skip
     2492               "подразделение"
     2493               skip
     2494               string(  string(clients.obj-name) ) format "X(40)"  at 10
     2495               skip
     2496                           "___________________________"
     2497               skip
     2498                   "подразделение получатель "
     2499               skip
     2500               "_ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _"   at 90
     2501               skip
     2502               "|           Номер |Дата             |" at 89
     2503               skip
     2504               "|_ _ _ _документа |составления _ _ _|"   at 89
     2505               skip
     2506                       "Требование в кладовую" at 50 space(18) "|_ _ _ _ _" (string(v-doc-code)) format "X(8)" at 99 "|_"   string( v-doc-date, "99/99/9999" ) format "x(10)"  at 110 "_ _ _|"
     2507               skip(1)
     2508               "Через кого___________________________________________________________" at 55
     2509               skip
     2510               "фамилия, имя, отчество" at 80
     2511           .
     2512           form with frame fbr-not-in-rb.
     2513           for each temp_fbrrep-goods
     2514           on error undo, return error
     2515           :
     2516               if temp_fbrrep-goods.is-not-office = yes
     2517               and temp_fbrrep-goods.is-waste     = no
     2518               and temp_fbrrep-goods.write-off-qnty > temp_fbrrep-goods.income-qnty
     2519               then do:
     2520                   run fbrrest-get-free-qnty in this-procedure (
     2521                         input buf_fbr-doc.obj-type
     2522                       , input buf_fbr-doc.obj-code
     2523                       , input temp_fbrrep-goods.gds-code
     2524                       , input yes
     2525                       , output v-free-qnty
     2526                   ).
     2527                   assign
     2528                       v-need-qnty = temp_fbrrep-goods.write-off-qnty - temp_fbrrep-goods.income-qnty - v-free-qnty
     2529                   .
     2530                   if v-need-qnty > 0
     2531                   then do:
     2532                       assign
     2533                           v-counter = v-counter + 1
     2534                       .
     2535                       run print-line in this-procedure (
     2536                             input v-counter
     2537                           , input temp_fbrrep-goods.gds-code
     2538                           , input v-need-qnty
     2539                           , input v-prim
     2540                       ).
     2541                   end.
     2542               end.
     2543           end.
     2544           put stream outstream
     2545               v-line-string format "X(127)"
     2546               skip (2)
     2547               "Затребовал заведующий производством:                ____________________                   //_________________"
     2548               skip
     2549               "подпись" at 60 "расшифровка подписи" at 95
     2550               skip(1)
     2551               "Отпуск разрешил:                                    ____________________ "
     2552                       skip(1)
     2553               "Руководитель организации:         _____________              _________                    //_________________ "
     2554               skip
     2555               "должность" at 36  "подпись" at 64     "расшифровка подписи"  at 95
     2556               skip(1)
     2557               .
     2558           hide stream Outstream frame Bottomframe .
     2559       end.
     2560       output stream Outstream close.
     2561   if session :set-wait-state( "" ) then.
     2562   if g#quest-print = false
     2563   then do:
     2564     run adecomm/_osprint.p ( ?, string( session:temp-directory + "rpt" + string( g#report-num ) ),
     2565                                         7, (if 4 >= 8 then 2 else 0), 0, 0,
     2566                                         OUTPUT g#log ).
     2567   end.
     2568   else do:
     2569     os-command silent
     2570       value( "COPY /b " +
     2571         string( session:temp-directory) +  "$" + string( g#report-num ) + " + " +
     2572         string( session:temp-directory) + "rpt" + string( g#report-num ) + " " +
     2573         string( session:temp-directory) +  "$" + string( g#report-num )
     2574                 ) .
     2575     os-command silent
     2576       value( "COPY /b " +
     2577         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl" + " + " +
     2578         string( session:temp-directory) + "rpt" + string( g#report-num ) + ".txl" + " " +
     2579         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl"
     2580                 ) .
     2581   end.
     2582     end.
     2583   procedure print-line :
     2584   do
     2585   on error undo, return error
     2586   :
     2587   define input parameter p-counter    as integer      no-undo.
     2588   define input parameter p-gds-code   as integer      no-undo.
     2589   define input parameter p-fact-qnty  as decimal      no-undo.
     2590   define input parameter p-prim       as character    no-undo.
     2591   define variable v-bar-code          as character        no-undo.
     2592   define buffer buf_doc-line  for doc-line.
     2593   define buffer buf_goods     for goods.
     2594       find first buf_goods no-lock
     2595            where buf_goods.gds-code = p-gds-code
     2596       .
     2597   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     2598     (input  buf_goods.gds-code
     2599     ,input  ?
     2600     ,output v-bar-code
     2601     ) no-error .
     2602    .
     2603       display stream OutStream
     2604       sym1 p-counter                                                  @ v-counter
     2605       sym2 buf_goods.gds-name                                         @ v-gds-name
     2606       sym3 string( v-bar-code )                                       @ v-barcode
     2607       sym4 buf_goods.unit-base                                        @ v-unit-base
     2608       sym5
     2609       sym6 p-fact-qnty                                                @ v-sum-qnty
     2610       sym7 p-prim                                                     @ v-prim
     2611       sym8
     2612       with frame fbr-not-in-rb.
     2613       down stream OutStream 1 with frame fbr-not-in-rb.
     2614       if line-counter( Outstream ) + 2 > page-size( Outstream )
     2615       then do:
     2616           page stream Outstream .
     2617       end.
     2618   end.
     2619   end procedure.
