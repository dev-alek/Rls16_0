        1   block-level on error undo, throw.
        2   define input parameter p-mainmenu-handle    as handle           no-undo.
        3   define input parameter p-fbr-pln-recid      as recid            no-undo.
        4   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        5   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        6   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile: op-3.p $":U .
        8   define variable vss-archive     as character no-undo init "$Archive: rep/op-3.p $":U .
        9   define variable vss-description as character no-undo init "Требование в кладовую".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define new global shared variable g#library  as handle no-undo .
       69   define new global shared variable g#library2 as handle no-undo .
       70   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       71   procedure cur-time :
       72      define output parameter p-today as date      no-undo .
       73      define output parameter p-time  as integer   no-undo .
       74     do
       75     on error undo, return error
       76     :
       77       define variable v-date1 as date      no-undo .
       78       define variable v-date2 as date      no-undo .
       79       define variable v-time  as integer   no-undo .
       80       assign
       81         v-date1 = today
       82         v-time  = time
       83         v-date2 = today
       84       .
       85       if v-date1 <> v-date2
       86       then do:
       87         assign
       88           v-date1 = today
       89           v-time  = v-time
       90         .
       91       end.
       92       assign
       93         p-today = v-date1
       94         p-time  = v-time
       95       .
       96     end.
       97   end.
       98   function cur-time-date returns character
       99   :
      100     return string(today, '99/99/9999':U) .
      101   end.
      102   function cur-time-mjd returns decimal
      103   :
      104     define variable v-date as date      no-undo .
      105     define variable v-time as integer   no-undo .
      106     run cur-time in this-procedure
      107       (output v-date
      108       ,output v-time
      109       ) .
      110     return integer(v-date) - 2400002 + (v-time / 86400) .
      111   end.
      112   function cur-time-get-ending-index returns integer
      113   (input p-number as integer
      114   )
      115   :
      116     if p-number < 0
      117     or p-number = ?
      118     then do:
      119       return 1 .
      120     end.
      121     define variable v-rest as integer   no-undo .
      122     assign
      123       p-number = p-number modulo 100
      124     .
      125     if p-number < 20
      126     then do:
      127       assign
      128         v-rest = p-number
      129       .
      130     end.
      131     else do:
      132       assign
      133         v-rest = p-number modulo 10
      134       .
      135     end.
      136     case v-rest :
      137       when 1
      138       then do:
      139         return 2 .
      140       end.
      141       when 2 or
      142       when 3 or
      143       when 4
      144       then do:
      145         return 3 .
      146       end.
      147       otherwise do:
      148         return 1 .
      149       end.
      150     end case .
      151   end.
      152   procedure cur-time-mjd-to-date :
      153      define input  parameter i-mjd-diff as decimal no-undo.
      154      define output parameter o-Date     as date    no-undo.
      155      define output parameter o-Time     as integer no-undo.
      156      define variable v-day-number as integer   no-undo .
      157      if    i-mjd-diff < 0
      158         or i-mjd-diff = ?
      159      then do:
      160         return "?" .
      161      end.
      162      assign
      163         v-day-number = truncate(i-mjd-diff,0).
      164         o-Date = date(v-day-number + 2400002).
      165         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      166     .
      167   end.
      168   function cur-time-mjd-to-string returns character
      169   (input p-mjd-diff as decimal
      170   )
      171   :
      172     define variable v-day-number as integer   no-undo .
      173     define variable v-seconds    as integer   no-undo .
      174     define variable v-hour       as integer   no-undo .
      175     define variable v-min        as integer   no-undo .
      176     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      177     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      178     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      179     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      180     if p-mjd-diff < 0
      181     or p-mjd-diff = ?
      182     then do:
      183       return "?" .
      184     end.
      185     assign
      186       v-day-number = integer(truncate(p-mjd-diff,0))
      187       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      188     .
      189     if v-seconds > 86400
      190     then do:
      191       assign
      192         v-seconds = 86400 - 1
      193       .
      194     end.
      195     if v-seconds < 0
      196     then do:
      197       assign
      198         v-seconds = 0
      199       .
      200     end.
      201     assign
      202       v-hour = truncate(v-seconds / 3600, 0)
      203     .
      204     assign
      205       v-seconds = v-seconds modulo 3600
      206     .
      207     assign
      208       v-min = truncate(v-seconds / 60, 0)
      209     .
      210     assign
      211       v-seconds = v-seconds modulo 60
      212     .
      213     return
      214         (if v-day-number <> 0
      215           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      216           else ""
      217         )
      218       + (if v-day-number <> 0 or v-hour <> 0
      219           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      220           else ""
      221         )
      222       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      223           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      224           else ""
      225         )
      226       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      227       .
      228   end.
      229   function cur-time-string returns character
      230   :
      231     define variable v-date as date      no-undo .
      232     define variable v-time as integer   no-undo .
      233     run cur-time in this-procedure
      234       (output v-date
      235       ,output v-time
      236       ) .
      237     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      238   end.
      239   function cur-time-string-sec returns character
      240   :
      241     define variable v-date as date      no-undo .
      242     define variable v-time as integer   no-undo .
      243     run cur-time in this-procedure
      244       (output v-date
      245       ,output v-time
      246       ) .
      247     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      248   end.
      249   function cur-time-custom  returns character
      250   (input p-prefix as character
      251   ,input p-date-format as character
      252   ,input p-delimiter as character
      253   ,input p-time-format as character
      254   ,input p-suffix as character
      255   )
      256   :
      257     define variable v-date as date      no-undo .
      258     define variable v-time as integer   no-undo .
      259     run cur-time in this-procedure
      260       (output v-date
      261       ,output v-time
      262       ) .
      263     return
      264       p-prefix
      265       + string(v-date, p-date-format)
      266       + p-delimiter
      267       + string(v-time, p-time-format)
      268       + p-suffix
      269       .
      270   end.
      271   function cur-time-print  returns character
      272   :
      273     define variable v-date as date      no-undo .
      274     define variable v-time as integer   no-undo .
      275     run cur-time in this-procedure
      276       (output v-date
      277       ,output v-time
      278       ) .
      279     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      280   end.
      281   function cur-time-datetime returns datetime
      282   :
      283     define variable v-char as character no-undo .
      284     define variable v-datetime as datetime no-undo .
      285     v-char = cur-time-string().
      286     v-datetime = datetime(v-char).
      287     return  v-datetime.
      288   end.
      289   function cur-time-string-msec returns character
      290   :
      291     define variable v-date as datetime  no-undo .
      292     v-date = now.
      293     return string(v-date) .
      294   end.
      295   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      296   define temp-table temp-parts no-undo   like ub.parts   field free-qnty as decimal   field free-cli-qnty as decimal .
      297   procedure partslib-clear-temp-parts :
      298     define buffer buf_temp-parts for temp-parts .
      299     do
      300     on error undo, return error
      301     :
      302       for each buf_temp-parts
      303       on error undo, return error
      304       :
      305         delete buf_temp-parts .
      306       end.
      307     end.
      308   end procedure.
      309   procedure partslib-create-temp-parts :
      310     define parameter buffer buf_parts       for ub.parts .
      311     define parameter buffer buf_temp-parts  for temp-parts .
      312     define input  parameter p-goods-twounit as logical   no-undo .
      313     define variable v-base-part-code as character no-undo .
      314     do
      315     on error undo, return error
      316     :
      317       if p-goods-twounit = true
      318       then do:
      319         assign
      320           v-base-part-code = entry(1, buf_parts.part-code, '#':U)
      321         .
      322       end.
      323       else do:
      324         assign
      325           v-base-part-code = buf_parts.part-code
      326         .
      327       end.
      328       find first buf_temp-parts exclusive-lock
      329         where buf_temp-parts.obj-type  = buf_parts.obj-type
      330           and buf_temp-parts.obj-code  = buf_parts.obj-code
      331           and buf_temp-parts.artic     = buf_parts.artic
      332           and buf_temp-parts.prod-type = buf_parts.prod-type
      333           and buf_temp-parts.prod-code = buf_parts.prod-code
      334           and buf_temp-parts.in-code   = buf_parts.in-code
      335           and buf_temp-parts.out-code  = 'free-zone':U
      336           and buf_temp-parts.part-code = v-base-part-code
      337         no-error.
      338       if not available buf_temp-parts
      339       then do:
      340         create buf_temp-parts .
      341         buffer-copy buf_parts to buf_temp-parts
      342         assign
      343           buf_temp-parts.out-code  = 'free-zone':U
      344           buf_temp-parts.part-code = v-base-part-code
      345           buf_temp-parts.rsrv-free = yes
      346           buf_temp-parts.status_   = no
      347           buf_temp-parts.qnty      = 0
      348           buf_temp-parts.fact-qnty = 0
      349           buf_temp-parts.real-qnty = 0
      350           buf_temp-parts.cli-qnty  = 0
      351         .
      352       end.
      353     end.
      354   end procedure.
      355   procedure partslib-init-temp-parts :
      356     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
      357     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
      358     define input parameter p-artic           like ub.parts.artic     no-undo .
      359     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
      360     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
      361     define buffer buf_parts      for ub.parts .
      362     define buffer buf_temp-parts for temp-parts .
      363     define variable v-goods-twounit    as logical   no-undo .
      364     do
      365     on error undo, return error
      366     :
      367   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      368   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
      369     (input  p-artic
      370     ,input  p-prod-type
      371     ,input  p-prod-code
      372     ,input  'twounit=request':u
      373     ,output v-goods-twounit
      374     ) no-error .
      375       if error-status :error
      376       then do:
      377         message
      378           vss-workfile vss-revision vss-description skip
      379           vss-include-info1 skip
      380           "Ошибка при определении атрибута товара" skip
      381           "Артикул" p-artic p-prod-type p-prod-code skip
      382           "twounit=request" skip
      383           error-status :get-message(1) skip
      384           return-value skip
      385           view-as alert-box error .
      386         undo, return error return-value .
      387       end.
      388       run partslib-clear-temp-parts in this-procedure .
      389       for each buf_parts
      390         where buf_parts.obj-type  = p-obj-type
      391           and buf_parts.obj-code  = p-obj-code
      392           and buf_parts.artic     = p-artic
      393           and buf_parts.prod-type = p-prod-type
      394           and buf_parts.prod-code = p-prod-code
      395           and buf_parts.rsrv-free = yes
      396           and buf_parts.status_   = no
      397           and buf_parts.in-code   <> buf_parts.out-code
      398       on error undo, return error
      399       :
      400         run partslib-create-temp-parts in this-procedure
      401           (buffer buf_parts
      402           ,buffer buf_temp-parts
      403           ,input  v-goods-twounit
      404           ) .
      405         define variable v-parts-qnty          as decimal   no-undo .
      406         define variable v-parts-cli-qnty      as decimal   no-undo .
      407         define variable v-parts-free-qnty     as decimal   no-undo .
      408         define variable v-parts-free-cli-qnty as decimal   no-undo .
      409         if buf_parts.out-code = 'free-zone':U
      410         then do:
      411           assign
      412             v-parts-qnty          = buf_parts.qnty
      413             v-parts-cli-qnty      = buf_parts.cli-qnty
      414             v-parts-free-qnty     = buf_parts.qnty
      415             v-parts-free-cli-qnty = buf_parts.cli-qnty
      416           .
      417         end.
      418         else do:
      419           assign
      420             v-parts-qnty          = abs(buf_parts.qnty)
      421             v-parts-cli-qnty      = abs(buf_parts.cli-qnty)
      422             v-parts-free-qnty     = 0
      423             v-parts-free-cli-qnty = 0
      424           .
      425         end.
      426         assign
      427           buf_temp-parts.qnty          = buf_temp-parts.qnty          + v-parts-qnty
      428           buf_temp-parts.fact-qnty     = buf_temp-parts.fact-qnty     + v-parts-qnty
      429           buf_temp-parts.real-qnty     = 0
      430           buf_temp-parts.cli-qnty      = buf_temp-parts.cli-qnty      + v-parts-cli-qnty
      431           buf_temp-parts.free-qnty     = buf_temp-parts.free-qnty     + v-parts-free-qnty
      432           buf_temp-parts.free-cli-qnty = buf_temp-parts.free-cli-qnty + v-parts-free-cli-qnty
      433         .
      434       end.
      435     end.
      436   end procedure.
      437   procedure partslib-init-temp-parts-by-factord :
      438     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
      439     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
      440     define input parameter p-artic              like ub.parts.artic     no-undo .
      441     define input parameter p-prod-type          like ub.parts.prod-type no-undo .
      442     define input parameter p-prod-code          like ub.parts.prod-code no-undo .
      443     define input parameter p-fact-order         as decimal   no-undo .
      444     define input parameter p-include-fact-order as logical   no-undo .
      445     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-factord: определение партий свободной зоны на любую дату".
      446     define buffer buf_gds-obj  for ub.gds-obj .
      447     do
      448     on error undo, return error
      449     :
      450       do transaction
      451       on error undo, return error
      452       :
      453   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      454   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
      455     (input  p-obj-type
      456     ,input  p-obj-code
      457     ,input  p-artic
      458     ,input  p-prod-type
      459     ,input  p-prod-code
      460     ,buffer buf_gds-obj
      461     ) no-error .
      462         if error-status :error
      463         then do:
      464           message
      465             vss-workfile vss-revision vss-description skip
      466             vss-include-info1 skip
      467             "Невозможно найти товар на объекте" skip
      468             "Объект" p-obj-type p-obj-code skip
      469             "Артикул" p-artic p-prod-type p-prod-code skip
      470             error-status :get-message(1) skip
      471             return-value skip
      472             view-as alert-box error .
      473           undo, return error .
      474         end.
      475         find current buf_gds-obj exclusive-lock .
      476       end.
      477       run partslib-init-temp-parts in this-procedure
      478         (input p-obj-type
      479         ,input p-obj-code
      480         ,input p-artic
      481         ,input p-prod-type
      482         ,input p-prod-code
      483         ) no-error .
      484       if error-status :error
      485       then do:
      486         message
      487           vss-workfile vss-revision vss-description skip
      488           vss-include-info1 skip
      489           "Ошибка при инициализации текущего остатка по партиям свободной зоны" skip
      490           "Объект" p-obj-type p-obj-code skip
      491           "Артикул" p-artic p-prod-type p-prod-code skip
      492           "p-fact-order" p-fact-order skip
      493           view-as alert-box error .
      494         undo, return error .
      495       end.
      496       if p-include-fact-order = true
      497       then do:
      498         assign
      499           p-fact-order = p-fact-order - 0.0000000001
      500         .
      501       end.
      502       define variable v-max-fact-order as character no-undo .
      503       run factord-max-fact-order in this-procedure
      504         (output v-max-fact-order
      505         ) no-error .
      506       if error-status :error
      507       then do:
      508         message
      509           vss-workfile vss-revision vss-description skip
      510           vss-include-info1 skip
      511           "Ошибка при вызове процедуры factord-max-fact-order" skip
      512           "Объект" p-obj-type p-obj-code skip
      513           "Артикул" p-artic p-prod-type p-prod-code skip
      514           "p-fact-order" p-fact-order skip
      515           view-as alert-box error .
      516         undo, return error .
      517       end.
      518       run partslib-update-by-factord in this-procedure
      519         (input p-obj-type
      520         ,input p-obj-code
      521         ,input p-artic
      522         ,input p-prod-type
      523         ,input p-prod-code
      524         ,input p-fact-order
      525         ,input v-max-fact-order
      526         ,input false
      527         ) no-error .
      528       if error-status :error
      529       then do:
      530         message
      531           vss-workfile vss-revision vss-description skip
      532           vss-include-info1 skip
      533           "Ошибка при вызове процедуры partslib-update-by-factord" skip
      534           "Объект" p-obj-type p-obj-code skip
      535           "Артикул" p-artic p-prod-type p-prod-code skip
      536           "p-fact-order" p-fact-order skip
      537           "v-max-fact-order" v-max-fact-order skip
      538           view-as alert-box error .
      539         undo, return error .
      540       end.
      541     end.
      542   end procedure.
      543   procedure partslib-update-by-factord :
      544     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
      545     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
      546     define input parameter p-artic              like ub.parts.artic     no-undo .
      547     define input parameter p-prod-type          like ub.parts.prod-type no-undo .
      548     define input parameter p-prod-code          like ub.parts.prod-code no-undo .
      549     define input parameter p-start-fact-order   as decimal   no-undo .
      550     define input parameter p-end-fact-order     as decimal   no-undo .
      551     define input parameter p-lock-gds-obj       as logical   no-undo .
      552     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-factord: определение партий свободной зоны на любую дату".
      553     define buffer buf_gds-obj  for ub.gds-obj .
      554     define buffer buf_doc-line for ub.doc-line .
      555     define variable v-total-parts-qnty as decimal   no-undo .
      556     define variable v-goods-gds-goods  as logical   no-undo .
      557     define variable v-goods-twounit    as logical   no-undo .
      558     do
      559     on error undo, return error
      560     :
      561       if p-start-fact-order > p-end-fact-order
      562       then do:
      563         message
      564           vss-workfile vss-revision vss-description skip
      565           vss-include-info1 skip
      566           "Ошибка задания входных параметров" skip
      567           "Начало интервала превышает конец интервала" skip
      568           "Объект" p-obj-type p-obj-code skip
      569           "Артикул" p-artic p-prod-type p-prod-code skip
      570           "p-start-fact-order" p-start-fact-order skip
      571           "p-end-fact-order"   p-end-fact-order skip
      572           view-as alert-box error .
      573         undo, return error .
      574       end.
      575       if p-lock-gds-obj = true
      576       then do:
      577         do transaction
      578         on error undo, return error
      579         :
      580   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      581   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
      582     (input  p-obj-type
      583     ,input  p-obj-code
      584     ,input  p-artic
      585     ,input  p-prod-type
      586     ,input  p-prod-code
      587     ,buffer buf_gds-obj
      588     ) no-error .
      589           if error-status :error
      590           then do:
      591             message
      592               vss-workfile vss-revision vss-description skip
      593               vss-include-info1 skip
      594               "Невозможно найти gds-obj" skip
      595               error-status :get-message(1) skip
      596               return-value skip
      597               view-as alert-box error .
      598             undo, return error .
      599           end.
      600           find current buf_gds-obj exclusive-lock .
      601         end.
      602       end.
      603   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      604   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
      605     (input  p-artic
      606     ,input  p-prod-type
      607     ,input  p-prod-code
      608     ,input  'gds-goods=request':u
      609     ,output v-goods-gds-goods
      610     ) no-error .
      611       if error-status :error
      612       then do:
      613         message
      614           vss-workfile vss-revision vss-description skip
      615           vss-include-info1 skip
      616           "Ошибка при определении атрибута товара" skip
      617           "Артикул" p-artic p-prod-type p-prod-code skip
      618           "gds-goods=request" skip
      619           error-status :get-message(1) skip
      620           return-value skip
      621           view-as alert-box error .
      622         undo, return error return-value .
      623       end.
      624   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      625   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
      626     (input  p-artic
      627     ,input  p-prod-type
      628     ,input  p-prod-code
      629     ,input  'twounit=request':u
      630     ,output v-goods-twounit
      631     ) no-error .
      632       if error-status :error
      633       then do:
      634         message
      635           vss-workfile vss-revision vss-description skip
      636           vss-include-info1 skip
      637           "Ошибка при определении атрибута товара" skip
      638           "Артикул" p-artic p-prod-type p-prod-code skip
      639           "twounit=request" skip
      640           error-status :get-message(1) skip
      641           return-value skip
      642           view-as alert-box error .
      643         undo, return error return-value .
      644       end.
      645       for each buf_doc-line no-lock
      646         where buf_doc-line.obj-type   = p-obj-type
      647           and buf_doc-line.obj-code   = p-obj-code
      648           and buf_doc-line.artic      = p-artic
      649           and buf_doc-line.prod-type  = p-prod-type
      650           and buf_doc-line.prod-code  = p-prod-code
      651           and buf_doc-line.status_    = 'факт':U
      652           and buf_doc-line.fact-order > p-start-fact-order
      653           and buf_doc-line.fact-order <= p-end-fact-order
      654       on error undo, return error
      655       :
      656         run partslib-process-document in this-procedure
      657           (input  buf_doc-line.doc-code
      658           ,input  p-obj-type
      659           ,input  p-obj-code
      660           ,input  p-artic
      661           ,input  p-prod-type
      662           ,input  p-prod-code
      663           ,input  v-goods-gds-goods
      664           ,input  v-goods-twounit
      665           ,output v-total-parts-qnty
      666           ) no-error .
      667         if error-status :error
      668         then do:
      669           message
      670             vss-workfile vss-revision vss-description skip
      671             vss-include-info1 skip
      672             "Ошибка при вызове процедуры partslib-process-document" skip
      673             "Документ" buf_doc-line.doc-code skip
      674             "Объект" p-obj-type p-obj-code skip
      675             "Артикул" p-artic p-prod-type p-prod-code skip
      676             "p-start-fact-order" p-start-fact-order skip
      677             "p-end-fact-order" p-end-fact-order skip
      678             error-status :get-message(1) skip
      679             return-value skip
      680             view-as alert-box error .
      681           undo, return error return-value .
      682         end.
      683       end.
      684     end.
      685   end procedure.
      686   procedure partslib-process-document :
      687     define input  parameter p-doc-code         as character no-undo .
      688     define input  parameter p-obj-type         as character no-undo .
      689     define input  parameter p-obj-code         as integer   no-undo .
      690     define input  parameter p-artic            as character no-undo .
      691     define input  parameter p-prod-type        as character no-undo .
      692     define input  parameter p-prod-code        as integer   no-undo .
      693     define input  parameter p-goods-gds-goods  as logical   no-undo .
      694     define input  parameter p-goods-twounit    as logical   no-undo .
      695     define output parameter p-total-parts-qnty as decimal   no-undo .
      696     define variable v-parts-sign as integer   no-undo .
      697     define buffer buf_trn-doc    for ub.trn-doc .
      698     define buffer buf_doc-line   for ub.doc-line .
      699     define buffer buf_parts      for ub.parts .
      700     define buffer buf_temp-parts for temp-parts .
      701     do
      702     on error undo, return error return-value
      703     :
      704       find first buf_trn-doc no-lock
      705         where buf_trn-doc.doc-code = p-doc-code
      706         no-error .
      707       if not available buf_trn-doc
      708       then do:
      709         undo, return error substitute("Ошибка при поиске документа. Документ &1"
      710                                      ,p-doc-code
      711                                      ) .
      712       end.
      713       case buf_trn-doc.doc-type
      714       :
      715         when 'при':U or
      716         when 'возврат':U or
      717         when 'инв':U
      718         then do:
      719           assign
      720             v-parts-sign = -1
      721           .
      722         end.
      723         when 'рас':U or
      724         when 'спи':U
      725         then do:
      726           assign
      727             v-parts-sign = 1
      728           .
      729         end.
      730         otherwise do:
      731           undo, return error substitute("Неизвестный тип документа &1"
      732                                       ,buf_trn-doc.doc-type
      733                                       ) .
      734         end.
      735       end.
      736       find first buf_doc-line no-lock
      737         where buf_doc-line.doc-code  = p-doc-code
      738           and buf_doc-line.artic     = p-artic
      739           and buf_doc-line.prod-type = p-prod-type
      740           and buf_doc-line.prod-code = p-prod-code
      741         no-error .
      742       if not available buf_doc-line
      743       then do:
      744         undo, return error substitute("Ошибка при поиске строки документа. Документ &1. Артикул &2 &3 &4"
      745                                      ,p-doc-code
      746                                      ,artic
      747                                      ,prod-type
      748                                      ,prod-code
      749                                      ) .
      750       end.
      751       assign
      752         p-total-parts-qnty = 0
      753       .
      754       if p-goods-gds-goods = true
      755       then do:
      756         for each buf_parts no-lock
      757           where buf_parts.out-code  = p-doc-code
      758             and buf_parts.obj-type  = p-obj-type
      759             and buf_parts.obj-code  = p-obj-code
      760             and buf_parts.artic     = p-artic
      761             and buf_parts.prod-type = p-prod-type
      762             and buf_parts.prod-code = p-prod-code
      763         on error undo, return error
      764         :
      765           run partslib-create-temp-parts in this-procedure
      766             (buffer buf_parts
      767             ,buffer buf_temp-parts
      768             ,input  p-goods-twounit
      769             ) .
      770           assign
      771             p-total-parts-qnty        = p-total-parts-qnty
      772                                       + v-parts-sign * buf_parts.fact-qnty
      773             buf_temp-parts.qnty       = buf_temp-parts.qnty
      774                                       + v-parts-sign * buf_parts.fact-qnty
      775             buf_temp-parts.fact-qnty  = buf_temp-parts.fact-qnty
      776                                       + v-parts-sign * buf_parts.fact-qnty
      777             buf_temp-parts.cli-qnty   = buf_temp-parts.cli-qnty
      778                                       + v-parts-sign * buf_parts.cli-qnty
      779           .
      780           if buf_temp-parts.qnty = 0
      781           then do:
      782             delete buf_temp-parts .
      783           end.
      784         end.
      785       end.
      786       else do:
      787         assign
      788           p-total-parts-qnty = p-total-parts-qnty
      789                              + v-parts-sign * buf_doc-line.fact-qnty
      790         .
      791       end.
      792     end.
      793   end procedure.
      794   procedure partslib-init-temp-parts-by-date :
      795     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
      796     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
      797     define input parameter p-artic           like ub.parts.artic     no-undo .
      798     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
      799     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
      800     define input parameter p-fact-date       as date      no-undo .
      801     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-date: определение партий свободной зоны на любую дату".
      802     do
      803     on error undo, return error
      804     :
      805       define variable v-fact-order                as decimal   no-undo .
      806       define variable v-shift-end-fact-order      as decimal   no-undo .
      807       define variable v-day-end-fact-order        as decimal   no-undo .
      808       run factord in this-procedure
      809         (input  p-fact-date
      810         ,input  1
      811         ,input  1
      812         ,input  ?
      813         ,input  0
      814         ,input  false
      815         ,output v-fact-order
      816         ,output v-shift-end-fact-order
      817         ,output v-day-end-fact-order
      818         ) no-error .
      819       if error-status :error
      820       then do:
      821         message
      822           vss-workfile vss-revision vss-description skip
      823           vss-include-info1 skip
      824           "Ошибка при определении момента времени, на который требуется остаток" skip
      825           "Объект" p-obj-type p-obj-code skip
      826           "Артикул" p-artic p-prod-type p-prod-code skip
      827           "Дата" p-fact-date skip
      828           view-as alert-box error .
      829         undo, return error .
      830       end.
      831       run partslib-init-temp-parts-by-factord in this-procedure
      832         (input p-obj-type
      833         ,input p-obj-code
      834         ,input p-artic
      835         ,input p-prod-type
      836         ,input p-prod-code
      837         ,input v-day-end-fact-order
      838         ,input false
      839         ) no-error .
      840       if error-status :error
      841       then do:
      842         message
      843           vss-workfile vss-revision vss-description skip
      844           vss-include-info1 skip
      845           "Ошибка при вызове метода partslib-init-temp-parts-by-factord" skip
      846           "Объект" p-obj-type p-obj-code skip
      847           "Артикул" p-artic p-prod-type p-prod-code skip
      848           "Дата" p-fact-date skip
      849           view-as alert-box error .
      850         undo, return error .
      851       end.
      852     end.
      853   end procedure.
      854   procedure partslib-calc-cost :
      855     define output parameter p-fact-qnty      as decimal   no-undo .
      856     define output parameter p-vat-pc         as decimal   no-undo .
      857     define output parameter p-slt-pc         as decimal   no-undo .
      858     define output parameter p-sum-base       as decimal   no-undo .
      859     define output parameter p-sum-rubl       as decimal   no-undo .
      860     define output parameter p-vat-base       as decimal   no-undo .
      861     define output parameter p-vat-rubl       as decimal   no-undo .
      862     define output parameter p-slt-base       as decimal   no-undo .
      863     define output parameter p-slt-rubl       as decimal   no-undo .
      864     define output parameter p-road-tax-base  as decimal   no-undo .
      865     define output parameter p-road-tax-rubl  as decimal   no-undo .
      866     define output parameter p-transport-base as decimal   no-undo .
      867     define output parameter p-transport-rubl as decimal   no-undo .
      868     define output parameter p-other-base     as decimal   no-undo .
      869     define output parameter p-other-rubl     as decimal   no-undo .
      870     define output parameter p-excise-base    as decimal   no-undo .
      871     define output parameter p-excise-rubl    as decimal   no-undo .
      872     define variable vss-description as character no-undo init "partslib-calc-cost: расчет сумм в учетных ценах".
      873     do
      874     on error undo, return error return-value
      875     :
      876       define buffer buf_temp-parts for temp-parts .
      877       define buffer   in-vatp-trn-doc  for ub.trn-doc .
      878       define buffer   in-vatp-parts    for ub.parts   .
      879       define buffer   in-vatp-doc      for ub.trn-doc .
      880       define buffer   in-vatp-goods    for ub.goods   .
      881       define buffer   in-vatp-sysconf  for ub.sysconf .
      882       define buffer   in-vatp_doc-attr for ub.doc-attr.
      883       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
      884       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
      885       define variable varinvprb                  as   character              no-undo.
      886       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
      887       define variable cli-base-rate              as   decimal                no-undo.
      888       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
      889       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
      890       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
      891       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
      892       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
      893       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
      894       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
      895       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
      896       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
      897       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
      898       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
      899       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
      900       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
      901       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
      902       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
      903       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
      904       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
      905       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
      906       define variable other-base-loc             like ub.doc-line.price-base no-undo.
      907       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
      908       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
      909       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
      910       define variable varinvatp-envd             as   character              no-undo.
      911       define variable varinvatp-type             as   character              no-undo.
      912       for each buf_temp-parts
      913       on error undo, return error
      914       :
      915   assign
      916     price-rubl-with-tax-loc = buf_temp-parts.price-rubl
      917     price-base-with-tax-loc = buf_temp-parts.price-base
      918   .
      919   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      920   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      921     (output varinvprb
      922     )  .
      923     if buf_temp-parts.out-code = 'free-zone':U     or
      924        buf_temp-parts.out-code = 'out-zone':U   or
      925        buf_temp-parts.doc-type = 'акт':U then do:
      926       assign
      927         in-vatp-have-vat-slt = yes.
      928     end.
      929     else do:
      930       find first in-vatp_doc-attr no-lock
      931         where in-vatp_doc-attr.doc-code  = buf_temp-parts.out-code
      932           and in-vatp_doc-attr.attr-code = 'envd':U
      933         no-error .
      934       if not available in-vatp_doc-attr then do:
      935         assign
      936           in-vatp-have-vat-slt = yes.
      937       end.
      938       else do:
      939            in-vatp-have-vat-slt = no.
      940       end.
      941     end.
      942     assign
      943      price-cli-with-tax-loc = buf_temp-parts.price-cli
      944      cli-base-rate          = buf_temp-parts.cli-base-rate.
      945     ASSIGN   road-tax-base-loc  = (if buf_temp-parts.road-tax-base  = ? then 0 else buf_temp-parts.road-tax-base)
      946              road-tax-rubl-loc  = (if buf_temp-parts.road-tax-rubl  = ? then 0 else buf_temp-parts.road-tax-rubl).
      947     ASSIGN  transport-base-loc = (if buf_temp-parts.transport-base = ? then 0 else buf_temp-parts.transport-base)
      948             transport-rubl-loc = (if buf_temp-parts.transport-rubl = ? then 0 else buf_temp-parts.transport-rubl)
      949             other-base-loc     = (if buf_temp-parts.other-base     = ? then 0 else buf_temp-parts.other-base)
      950             other-rubl-loc     = (if buf_temp-parts.other-rubl     = ? then 0 else buf_temp-parts.other-rubl)
      951             vat-pc-loc         = (if buf_temp-parts.vat-pc         = ? then 0 else buf_temp-parts.vat-pc)
      952             slt-pc-loc         = (if buf_temp-parts.slt-pc         = ? then 0 else buf_temp-parts.slt-pc).
      953             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
      954       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
      955     assign
      956       exch-rate-cli-loc = (buf_temp-parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if buf_temp-parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if buf_temp-parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / buf_temp-parts.price-cli .
      957     assign
      958       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
      959       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
      960       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
      961       transport-cli-loc  = 0
      962       other-cli-loc      = 0
      963     .
      964   ASSIGN
      965             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
      966       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
      967   .
      968         assign
      969           p-fact-qnty      = p-fact-qnty      + buf_temp-parts.fact-qnty
      970           p-vat-pc         = p-vat-pc         + vat-pc-loc
      971           p-slt-pc         = p-slt-pc         + slt-pc-loc
      972           p-sum-base       = p-sum-base       + price-base-with-tax-loc * buf_temp-parts.fact-qnty
      973           p-sum-rubl       = p-sum-rubl       + price-rubl-with-tax-loc * buf_temp-parts.fact-qnty
      974           p-vat-base       = p-vat-base       + vat-base-loc            * buf_temp-parts.fact-qnty
      975           p-vat-rubl       = p-vat-rubl       + vat-rubl-loc            * buf_temp-parts.fact-qnty
      976           p-slt-base       = p-slt-base       + slt-base-loc            * buf_temp-parts.fact-qnty
      977           p-slt-rubl       = p-slt-rubl       + slt-rubl-loc            * buf_temp-parts.fact-qnty
      978           p-road-tax-base  = p-road-tax-base  + road-tax-base-loc       * buf_temp-parts.fact-qnty
      979           p-road-tax-rubl  = p-road-tax-rubl  + road-tax-rubl-loc       * buf_temp-parts.fact-qnty
      980           p-transport-base = p-transport-base + transport-base-loc      * buf_temp-parts.fact-qnty
      981           p-transport-rubl = p-transport-rubl + transport-rubl-loc      * buf_temp-parts.fact-qnty
      982           p-other-base     = p-other-base     + other-base-loc          * buf_temp-parts.fact-qnty
      983           p-other-rubl     = p-other-rubl     + other-rubl-loc          * buf_temp-parts.fact-qnty
      984           p-excise-base    = p-excise-base    + 0
      985           p-excise-rubl    = p-excise-rubl    + 0
      986         .
      987       end.
      988       if p-fact-qnty      = ?
      989       or p-sum-base       = ?
      990       or p-sum-rubl       = ?
      991       or p-vat-base       = ?
      992       or p-vat-rubl       = ?
      993       or p-slt-base       = ?
      994       or p-slt-rubl       = ?
      995       or p-road-tax-base  = ?
      996       or p-road-tax-rubl  = ?
      997       or p-transport-base = ?
      998       or p-transport-rubl = ?
      999       or p-other-base     = ?
     1000       or p-other-rubl     = ?
     1001       or p-excise-base    = ?
     1002       or p-excise-rubl    = ?
     1003       then do:
     1004         message
     1005           vss-workfile vss-revision vss-description skip
     1006           vss-include-info1 skip
     1007           "Программа in-vatp.i вернула неопределенные значения" skip
     1008           "p-fact-qnty"      p-fact-qnty      skip
     1009           "p-sum-base"       p-sum-base       skip
     1010           "p-sum-rubl"       p-sum-rubl       skip
     1011           "p-vat-base"       p-vat-base       skip
     1012           "p-vat-rubl"       p-vat-rubl       skip
     1013           "p-slt-base"       p-slt-base       skip
     1014           "p-slt-rubl"       p-slt-rubl       skip
     1015           "p-road-tax-base"  p-road-tax-base  skip
     1016           "p-road-tax-rubl"  p-road-tax-rubl  skip
     1017           "p-transport-base" p-transport-base skip
     1018           "p-transport-rubl" p-transport-rubl skip
     1019           "p-other-base"     p-other-base     skip
     1020           "p-other-rubl"     p-other-rubl     skip
     1021           "p-excise-base"    p-excise-base    skip
     1022           "p-excise-rubl"    p-excise-rubl    skip
     1023           view-as alert-box error .
     1024         undo, return error .
     1025       end.
     1026     end.
     1027   end procedure.
     1028   procedure fbrrest-get-free-qnty :
     1029   do
     1030   on error undo, return error
     1031   :
     1032   define input parameter p-obj-type       as character            no-undo.
     1033   define input parameter p-obj-code       as integer              no-undo.
     1034   define input parameter p-gds-code       as integer              no-undo.
     1035   define input parameter p-autofbr        as logical              no-undo.
     1036   define output parameter p-avail-qnty    as decimal              no-undo.
     1037       define variable v-req-qnty  like ub.fbr-line.fact-qnty no-undo.
     1038       define variable v-free-qnty as decimal       no-undo.
     1039       define buffer buf_goods         for ub.goods.
     1040       define buffer buf_gds-obj       for ub.gds-obj.
     1041       define buffer buf_temp-parts    for temp-parts.
     1042       find first buf_goods no-lock
     1043            where buf_goods.gds-code = p-gds-code
     1044       .
     1045       assign
     1046           p-avail-qnty = 0
     1047       .
     1048       run partslib-init-temp-parts in this-procedure (
     1049             input p-obj-type
     1050           , input p-obj-code
     1051           , input buf_goods.artic
     1052           , input buf_goods.prod-type
     1053           , input buf_goods.prod-code
     1054       ).
     1055       assign
     1056           v-free-qnty = 0
     1057       .
     1058       for each buf_temp-parts
     1059       on error undo, return error
     1060       :
     1061           if buf_temp-parts.qnty > 0
     1062           then do:
     1063               assign
     1064                   v-free-qnty = v-free-qnty + buf_temp-parts.free-qnty
     1065               .
     1066           end.
     1067       end.
     1068       assign
     1069           p-avail-qnty = ( if v-free-qnty > 0 then v-free-qnty else 0 )
     1070       .
     1071   end.
     1072   end procedure.
     1073   procedure fbrrest-get-catering-object :
     1074   do
     1075   on error undo, return error
     1076   :
     1077   define input parameter p-obj-code            as integer      no-undo.
     1078   define output parameter p-catering-obj-type  as character    no-undo.
     1079   define output parameter p-catering-obj-code  as integer      no-undo.
     1080       define buffer buf_shop              for ub.shop.
     1081       find first buf_shop no-lock
     1082            where buf_shop.obj-code = p-obj-code
     1083       .
     1084       assign
     1085           p-catering-obj-type = buf_shop.kitchen-store-type
     1086           p-catering-obj-code = buf_shop.kitchen-store-code
     1087       .
     1088   end.
     1089   end procedure.
     1090   define variable vss-include-info8 as character format "X(65)" no-undo
     1091   initial "@(#)$Workfile$ $Revision$".
