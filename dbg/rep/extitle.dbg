      500     Col-name[196]= 'GN':U
      501     Col-name[197]= 'GO':U
      502     Col-name[198]= 'GP':U
      503     Col-name[199]= 'GQ':U
      504     Col-name[200]=   'GR':U
      505     Col-name[201]=   'GS':U
      506     Col-name[202]=   'GT':U
      507     Col-name[203]=   'GU':U
      508     Col-name[204]=   'GV':U
      509     Col-name[205]=   'GW':U
      510     Col-name[206]=   'GX':U
      511     Col-name[207]=   'GY':U
      512     Col-name[208]=   'GZ':U
      513     Col-name[209]=   'HA':U
      514     Col-name[210]=   'HB':U
      515     Col-name[211]=   'HC':U
      516     Col-name[212]=   'HD':U
      517     Col-name[213]=   'HE':U
      518     Col-name[214]=   'HF':U
      519     Col-name[215]=   'HG':U
      520     Col-name[216]=   'HH':U
      521     Col-name[217]=   'HI':U
      522     Col-name[218]=   'HJ':U
      523     Col-name[219]=   'HK':U
      524     Col-name[220]=   'HL':U
      525     Col-name[221]=   'HM':U
      526     Col-name[222]=   'HN':U
      527     Col-name[223]=   'HO':U
      528     Col-name[224]=   'HP':U
      529     Col-name[225]=   'HQ':U
      530     Col-name[226]=   'HR':U
      531     Col-name[227]=   'HS':U
      532     Col-name[228]=   'HT':U
      533     Col-name[229]=   'HU':U
      534     Col-name[230]=   'HV':U
      535     Col-name[231]=   'HW':U
      536     Col-name[232]=   'HX':U
      537     Col-name[233]=   'HY':U
      538     Col-name[234]=   'HZ':U
      539     Col-name[235]=   'IA':U
      540     Col-name[236]=   'IB':U
      541     Col-name[237]=   'IC':U
      542     Col-name[238]=   'ID':U
      543     Col-name[239]=   'IE':U
      544     Col-name[240]=   'IF':U
      545     Col-name[241]=   'IG':U
      546     Col-name[242]=   'IH':U
      547     Col-name[243]=   'II':U
      548     Col-name[244]=   'IJ':U
      549     Col-name[245]=   'IK':U
      550     Col-name[246]=   'IL':U
      551     Col-name[247]=   'IM':U
      552     Col-name[248]=   'IN':U
      553     Col-name[249]=   'IO':U
      554     Col-name[250]=   'IP':U
      555     Col-name[251]=   'IQ':U
      556     Col-name[252]=   'IR':U
      557     Col-name[253]=   'IS':U
      558     Col-name[254]=   'IT':U
      559     Col-name[255]=   'IU':U
      560     Col-name[256]=   'IV':U
      561     .
      562    end.
      563   end procedure.
      564   define new global shared variable g#library  as handle no-undo .
      565   define new global shared variable g#library2 as handle no-undo .
      566   define variable var-report-r-b as character no-undo .
      567   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      568   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      569     (output var-report-r-b
      570     )  .
      571   define variable div# as char no-undo.
      572   define variable fr as logical no-undo .
      573   define variable fr0 as logical no-undo .
      574   define variable tmp#stroka as character no-undo .
      575   define variable tmp#stroka0 as character no-undo .
      576   define variable v-bar-code    like ub.bar-code.b-code no-undo  .
      577   define variable s-bar-code   as character format "x(9)" no-undo .
      578   define temp-table tmp-gds no-undo
      579     field id as integer
      580     field name      as character  format "x(256)"
      581     field f-name    as character  format "x(256)"
      582     field node-code as integer
      583     field lvl       as integer
      584    index pi id
      585   .
      586   define variable NEW-vat        like ub.doc-line.vat-pc    no-undo.
      587   define variable LAST-vat       like ub.doc-line.vat-pc    no-undo.
      588   define variable  var-vat-pc    like ub.doc-line.vat-pc    no-undo.
      589   define variable g-ll as integer no-undo .
      590   define variable id as integer no-undo .
      591   define temp-table temp-gds-list no-undo
      592     field gds-code  like ub.goods.gds-code
      593     field prod-code like ub.goods.prod-code
      594     field grp-name  like ub.goods.grp-name
      595     field gds-name  like ub.goods.gds-name
      596     field artic     like ub.goods.artic
      597     field vat-pc    as decimal
      598      index pi is primary unique gds-code ascending
      599      index i1 artic     ascending
      600      index i2 prod-code ascending
      601      index i3 grp-name  ascending
      602      index i33 gds-name  ascending
      603      index i4 vat-pc    ascending
      604      index i5 prod-code grp-name   ascending
      605      index i6 grp-name  prod-code   ascending
      606      .
      607   define variable sum_1     as   decimal  format "->>>>>>>>>>>9.<<<" no-undo.
      608   define variable sum_2     as   decimal  format "->>>>>>>>>>>9.<<<" no-undo.
      609   define variable b1-sum_1  as   decimal  format "->>>>>>>>>>>9.<<<" no-undo.
      610   define variable b1-sum_2  as   decimal  format "->>>>>>>>>>>9.<<<" no-undo.
      611   define variable b2-sum_1  as   decimal  format "->>>>>>>>>>>9.<<<" no-undo.
      612   define variable b2-sum_2  as   decimal  format "->>>>>>>>>>>9.<<<" no-undo.
      613   define variable bi-sum_1  as   decimal  format "->>>>>>>>>>>9.<<<" no-undo.
      614   define variable bi-sum_2  as   decimal  format "->>>>>>>>>>>9.<<<" no-undo.
      615   define variable bo-sum_1  as   decimal  format "->>>>>>>>>>>9.<<<" no-undo.
      616   define variable bo-sum_2  as   decimal  format "->>>>>>>>>>>9.<<<" no-undo.
      617   define variable C-c as int no-undo.
      618   define variable C-str as char no-undo.
      619   define variable str--1 as char Format "x(60)" no-undo.
      620   define variable C-i as int no-undo.
      621   define variable M        AS INTEGER no-undo.
      622   define variable L        AS INTEGER no-undo.
      623   define variable iColumn  AS INTEGER no-undo.
      624   define variable cColumn  AS CHARACTER no-undo.
      625   define variable cRange   AS CHARACTER no-undo.
      626   define variable cRange2  AS CHARACTER no-undo.
      627   define variable g#report-num as integer no-undo .
      628   define variable AllCol   AS Int no-undo.
      629   DEFINE VARIABLE v-bas-file as character no-undo .
      630   IF Make-Excel THEN DO:
      631     IF NOT Make-Excel-com THEN DO:
      632       FIND FIRST sheetf NO-LOCK WHERE
      633                   sheetf.sheet-num = current-sheet No-ERROR.
      634       if not avail sheetf then do:
      635         message vss-workfile vss-revision vss-description skip
      636           "Отсутствуют параметры форматирования для листов книги Excel"
      637         view-as alert-box error.
      638         return.
      639       end.
      640       C-str= ReportNAme + chr(10) + str1
      641                          + chr(10) + str2
      642                          + chr(10) + str3
      643                          + chr(10) + str4
      644                          + chr(10) + ReportHeader .
      645       C-str = replace(c-str, (chr(10) + chr(10)), chr(10)).
      646       PUT stream FORExcel UNFORMATTED   C-str skip.
      647       sheetf.Excel-Row-Heder =  NUM-ENTRIES(C-str ,chr(10)) + 1.
      648       sheetf.Excel-Row-Title =  NUM-ENTRIES(sheetf.Excel-Column-Lable ,chr(10)).
      649       Repeat C-c = 1 to sheetf.Excel-Row-Title :
      650         Repeat C-i = 1 to NUM-ENTRIES(Entry(c-c,sheetf.Excel-Column-Lable,chr(10)), chr(44)) :
      651           str--1 = Entry( C-i ,Entry(c-c,sheetf.Excel-Column-Lable,chr(10)), chr(44)).
      652           Put stream ForExcel UNFORMATTED
      653                       Trim(Str--1)  Format "x(60)"
      654                     CHR(9)  .
      655         End.
      656         C-i = 0.
      657         Put stream ForExcel UNFORMATTED skip.
      658       End.
      659       if Sheetf.Bas-FIle <> "":U then do:
      660         run get-report-num in my-handle (output G#report-num).
      661         assign
      662         v-bas-file = string( session:temp-directory) +
      663                      string( g#report-num)  + ".b8s":U + string(current-sheet)
      664         .
      665         define variable v-full-path        as character no-undo .
      666         define variable v-path             as character no-undo .
      667         define variable v-file-name        as character no-undo .
      668         define variable v-file-name-no-ext as character no-undo .
      669         define variable v-file-name-ext    as character no-undo .
      670         run gbl/filename.p
      671           (input  Sheetf.Bas-file
      672           ,output v-full-path
      673           ,output v-path
      674           ,output v-file-name
      675           ,output v-file-name-no-ext
      676           ,output v-file-name-ext
      677           ) no-error  .
      678         run gbl/fileattr.p
      679         (input v-bas-file
      680         ,input "readonly-clear"
      681         ) no-error .
      682         OS-delete value(v-bas-file).
      683         OS-COPY value(v-full-path) value(v-bas-file).
      684         if os-error <> 0 or search(v-bas-file) = ? then do:
      685           assign
      686           Sheetf.Bas-file = "":U
      687           .
      688         end.
      689         else do:
      690           assign
      691           Sheetf.Bas-file = v-bas-file
      692           .
      693         end.
      694       end.
      695     END.
      696   End.
      697   IF Make-Excel THEN DO:
      698     IF Make-Excel-com THEN DO:
      699        C-str= ReportNAme + chr(10) + str1
      700                          + chr(10) + str2
      701                          + chr(10) + str3
      702                          + chr(10) + str4
      703                          + chr(10) + ReportHeader .
      704       sheetf.Excel-Row-Heder =  NUM-ENTRIES(C-str ,chr(10) ).
      705       sheetf.Excel-Row-Title =  NUM-ENTRIES(sheetf.Excel-Column-Lable ,chr(10) ).
      706   If Make-Excel-com THEN DO:
      707   Num#str# = Num#str# + 1. ch#workSheet:Range(COL-name[1] + string(Num#str#)):Value = ReportNAme .
      708   End.
      709   If Make-Excel-com THEN DO:
      710   Num#str# = Num#str# + 1. ch#workSheet:Range(COL-name[1] + string(Num#str#)):Value = str1 .
      711   End.
      712   If Make-Excel-com THEN DO:
      713   Num#str# = Num#str# + 1. ch#workSheet:Range(COL-name[1] + string(Num#str#)):Value = str2 .
      714   End.
      715   If Make-Excel-com THEN DO:
      716   Num#str# = Num#str# + 1. ch#workSheet:Range(COL-name[1] + string(Num#str#)):Value = str3 .
      717   End.
      718   If Make-Excel-com THEN DO:
      719   Num#str# = Num#str# + 1. ch#workSheet:Range(COL-name[1] + string(Num#str#)):Value = str4 .
      720   End.
      721        Repeat C-c = 1 to sheetf.Excel-Row-Title :
      722           Repeat C-i = 1 to NUM-ENTRIES(Entry(c-c,sheetf.Excel-Column-Lable,chr(10)), chr(44)) :
      723               str--1 = Entry( C-i ,Entry(c-c,sheetf.Excel-Column-Lable,chr(10)), chr(44)).
      724   If Make-Excel-com THEN DO:
      725   if c-i = 1 THEN  Num#str# = Num#str# + 1. ch#workSheet:Range(COL-name[C-i] + string(Num#str#)):Value = Trim(Str--1) .
      726   End.
      727           End.
      728           C-i = 0.
      729        End.
      730     AllCol = NUM-ENTRIES(Sizes) - 1 no-error.
      731     iF  AllCol > 1 THEN DO :
      732       repeat l = 1 TO  NUM-ENTRIES(Sizes) :
      733        Assign
      734             ch#WorkSheet:Columns (Col-name[L]):ColumnWidth  = Integer(Entry(L,Sizes))
      735             ch#WorkSheet:Columns (Col-name[L]):NumberFormat = "@":U no-error.
      736       End.
      737           sheetf.Excel-Row-Heder =  6.
      738      REPEAT L = 1 TO  sheetf.Excel-Row-Heder - 1  :
      739          cRange = "A" + String(L) + chr(58) + Col-name[AllCol + 1] + string(L) no-error.
      740          ch#WorkSheet:Range (cRange):MergeCells = True no-error.
      741          if L > 1 Then DO:
      742             ch#WorkSheet:Range (cRange):Font:Bold = false no-error.
      743             ch#WorkSheet:Range (cRange):Font:Size = 10    no-error.
      744             ch#WorkSheet:Range (cRange):HorizontalAlignment = -4131  no-error.
      745             ch#WorkSheet:Range (cRange):VerticalAlignment = -4160     no-error.
      746          End.
      747      End.
      748       repeat M = sheetf.Excel-Row-Heder TO sheetf.Excel-Row-Heder + sheetf.Excel-Row-Title - 2 :
      749           repeat l = 2 TO ALLCOL :
      750              IF  ch#workSheet:Range (Col-name[L] + STRING(M)):value = "" THEN DO:
      751                  ch#workSheet:Range (Col-name[L] + STRING(M)):value = ? .
      752                  ch#workSheet:Range (Col-name[L - 1] + STRING(M) + chr(58) + Col-name[L] + STRING(M)):MergeCells = True no-error.
      753              End.
      754           END.
      755       End.
      756        If Excel-Row-Title > 1 Then DO:
      757           repeat M = Excel-Row-Heder + 1 TO Excel-Row-Heder + Excel-Row-Title - 1 :
      758             repeat l = 1 TO ALLCOL :
      759               IF  ch#workSheet:Range (Col-name[L] + STRING(M)):value = ""
      760                   OR ch#workSheet:Range (Col-name[L] + STRING(M)):value = ? THEN DO :
      761               ch#workSheet:Range (Col-name[L] + STRING(M)):value =  ?  no-error.
      762               ch#workSheet:Range (Col-name[L] + STRING(M) + chr(58) + Col-name[L] + STRING(M - 1)):MergeCells = True no-error.
      763               End.
      764             End.
      765           End.
      766        End.
      767      ASSIGN
      768      cRange = "A" + STRING(Excel-Row-Heder) + chr(58) + Col-name[AllCol + 1] + STRING(Excel-Row-Heder + Excel-Row-Title - 1)
      769      ch#workSheet:Range (cRange):Font:Bold = TRUE
      770      ch#workSheet:Range (cRange):Interior:ColorIndex = 35
      771      ch#workSheet:Range (cRange):HorizontalAlignment = -4108
      772      ch#workSheet:Range (cRange):VerticalAlignment   = -4160
      773      ch#workSheet:Range (cRange):WrapText = true
      774      ch#workSheet:Range (cRange):Orientation = 0 no-error.
      775      Assign
      776      ch#workSheet:Range (cRange):Borders(5):LineStyle = -4142
      777      ch#workSheet:Range (cRange):Borders(6):LineStyle   = -4142
      778      ch#workSheet:Range (cRange):Borders(7):LineStyle  = 1
      779      ch#workSheet:Range (cRange):Borders(7):Weight     = 2
      780      ch#workSheet:Range (cRange):Borders(7):ColorIndex = -4105
      781      ch#workSheet:Range (cRange):Borders(8):LineStyle  = 1
      782      ch#workSheet:Range (cRange):Borders(8):Weight     = 2
      783      ch#workSheet:Range (cRange):Borders(8):ColorIndex = -4105
      784      ch#workSheet:Range (cRange):Borders(9):LineStyle  = 1
      785      ch#workSheet:Range (cRange):Borders(9):Weight     = 2
      786      ch#workSheet:Range (cRange):Borders(9):ColorIndex = -4105
      787      ch#workSheet:Range (cRange):Borders(10):LineStyle  = 1
      788      ch#workSheet:Range (cRange):Borders(10):Weight     = 2
      789      ch#workSheet:Range (cRange):Borders(10):ColorIndex = -4105
      790      ch#workSheet:Range (cRange):Borders(11):LineStyle  = 1
      791      ch#workSheet:Range (cRange):Borders(11):Weight     = 2
      792      ch#workSheet:Range (cRange):Borders(11):ColorIndex = -4105 no-error.
      793      IF Excel-Row-Title > 1 THEN
      794      Assign
      795      ch#workSheet:Range (cRange):Borders(12):LineStyle  = 1
      796      ch#workSheet:Range (cRange):Borders(12):Weight     = 2
      797      ch#workSheet:Range (cRange):Borders(12):ColorIndex = -4105
      798      ch#workSheet:PageSetup:PrintTitleRows = cRange
      799      no-error
      800     .
      801       End.
      802      end.
      803     End.
