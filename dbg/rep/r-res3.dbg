     1140   def var vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1141   procedure r-cost :
     1142     define input  parameter v-doc-code       like ub.doc-line.doc-code          no-undo .
     1143     define input  parameter v-artic          like ub.doc-line.artic             no-undo .
     1144     define input  parameter v-prod-type      like ub.doc-line.prod-type         no-undo .
     1145     define input  parameter v-prod-code      like ub.doc-line.prod-code         no-undo .
     1146     define output parameter v-fact-qnty      like ub.ot-line.fact-qnty       no-undo .
     1147     define output parameter v-vat-pc         like ub.doc-line.vat-pc         no-undo .
     1148     define output parameter v-slt-pc         like ub.doc-line.slt-pc         no-undo .
     1149     define output parameter v-sum-base       like ub.ot-line.sum-base        no-undo .
     1150     define output parameter v-sum-rubl       like ub.ot-line.sum-rubl        no-undo .
     1151     define output parameter v-vat-base       like ub.ot-line.vat-base        no-undo .
     1152     define output parameter v-vat-rubl       like ub.ot-line.vat-rubl        no-undo .
     1153     define output parameter v-slt-base       like ub.ot-line.slt-base        no-undo .
     1154     define output parameter v-slt-rubl       like ub.ot-line.slt-rubl        no-undo .
     1155     define output parameter v-road-tax-base  like ub.ot-line.road-tax-base   no-undo .
     1156     define output parameter v-road-tax-rubl  like ub.ot-line.road-tax-rubl   no-undo .
     1157     define output parameter v-transport-base like ub.ot-line.transport-base  no-undo .
     1158     define output parameter v-transport-rubl like ub.ot-line.transport-rubl  no-undo .
     1159     define output parameter v-other-base     like ub.ot-line.other-base      no-undo .
     1160     define output parameter v-other-rubl     like ub.ot-line.other-rubl      no-undo .
     1161     define output parameter v-excise-base    like ub.ot-line.excise-base     no-undo .
     1162     define output parameter v-excise-rubl    like ub.ot-line.excise-rubl     no-undo .
     1163     do
     1164     on error undo, return error
     1165     :
     1166       define buffer   in-vatp-trn-doc  for ub.trn-doc .
     1167       define buffer   in-vatp-parts    for ub.parts   .
     1168       define buffer   in-vatp-doc      for ub.trn-doc .
     1169       define buffer   in-vatp-goods    for ub.goods   .
     1170       define buffer   in-vatp-sysconf  for ub.sysconf .
     1171       define buffer   in-vatp_doc-attr for ub.doc-attr.
     1172       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
     1173       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
     1174       define variable varinvprb                  as   character              no-undo.
     1175       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
     1176       define variable cli-base-rate              as   decimal                no-undo.
     1177       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
     1178       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
     1179       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
     1180       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
     1181       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
     1182       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
     1183       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
     1184       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
     1185       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
     1186       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
     1187       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
     1188       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
     1189       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
     1190       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
     1191       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
     1192       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
     1193       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
     1194       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
     1195       define variable other-base-loc             like ub.doc-line.price-base no-undo.
     1196       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
     1197       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
     1198       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
     1199       define variable varinvatp-envd             as   character              no-undo.
     1200       define variable varinvatp-type             as   character              no-undo.
     1201       def var v-parts-fact-qnty as decimal   no-undo .
     1202       define buffer buf_parts    for ub.parts    .
     1203       define buffer buf_goods    for ub.goods    .
     1204       define buffer buf_trn-doc  for ub.trn-doc  .
     1205       define buffer buf_doc-line for ub.doc-line .
     1206       find first buf_doc-line no-lock
     1207         where buf_doc-line.doc-code  = v-doc-code
     1208           and buf_doc-line.artic     = v-artic
     1209           and buf_doc-line.prod-type = v-prod-type
     1210           and buf_doc-line.prod-code = v-prod-code
     1211         no-error .
     1212       if not available buf_doc-line then do:
     1213         message
     1214           vss-workfile vss-revision vss-description skip
     1215           vss-include-info10 skip
     1216           "Ошибка задания входных параметров" skip
     1217           "Не найдена строка документа"  skip
     1218           "Документ" v-doc-code skip
     1219           "Артикул" v-artic v-prod-type v-prod-code skip
     1220           view-as alert-box error .
     1221         return error .
     1222       end.
     1223       find first buf_trn-doc no-lock
     1224         where buf_trn-doc.doc-code = v-doc-code
     1225         no-error .
     1226       if not available buf_trn-doc then do:
     1227         message
     1228           vss-workfile vss-revision vss-description skip
     1229           vss-include-info10 skip
     1230           "Ошибка задания входных параметров" skip
     1231           "Не найден документ" skip
     1232           "Документ" v-doc-code skip
     1233           "Артикул" v-artic v-prod-type v-prod-code skip
     1234           view-as alert-box error .
     1235         undo, return error .
     1236       end.
     1237       find first buf_goods no-lock
     1238         where buf_goods.artic     = buf_doc-line.artic
     1239           and buf_goods.prod-type = buf_doc-line.prod-type
     1240           and buf_goods.prod-code = buf_doc-line.prod-code
     1241         no-error .
     1242       if not available buf_goods then do:
     1243         message
     1244           vss-workfile vss-revision vss-description skip
     1245           vss-include-info10 skip
     1246           "Ошибка задания входных параметров" skip
     1247           "Не найден товар" skip
     1248           "Документ" v-doc-code skip
     1249           "Артикул" v-artic v-prod-type v-prod-code skip
     1250           view-as alert-box error .
     1251         undo, return error .
     1252       end.
     1253       if buf_goods.gds-type = 'т':U then do:
     1254             for each buf_parts no-lock
     1255               where buf_parts.out-code  = buf_trn-doc.doc-code
     1256                 and buf_parts.obj-type  = buf_trn-doc.obj-type
     1257                 and buf_parts.obj-code  = buf_trn-doc.obj-code
     1258                 and buf_parts.artic     = buf_doc-line.artic
     1259                 and buf_parts.prod-type = buf_doc-line.prod-type
     1260                 and buf_parts.prod-code = buf_doc-line.prod-code
     1261             on error undo, return error
     1262             :
     1263   assign
     1264     price-rubl-with-tax-loc = buf_parts.price-rubl
     1265     price-base-with-tax-loc = buf_parts.price-base
     1266   .
     1267   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1268   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1269     (output varinvprb
     1270     )  .
     1271     if buf_parts.out-code = 'free-zone':U     or
     1272        buf_parts.out-code = 'out-zone':U   or
     1273        buf_parts.doc-type = 'акт':U then do:
     1274       assign
     1275         in-vatp-have-vat-slt = yes.
     1276     end.
     1277     else do:
     1278       find first in-vatp_doc-attr no-lock
     1279         where in-vatp_doc-attr.doc-code  = buf_parts.out-code
     1280           and in-vatp_doc-attr.attr-code = 'envd':U
     1281         no-error .
     1282       if not available in-vatp_doc-attr then do:
     1283         assign
     1284           in-vatp-have-vat-slt = yes.
     1285       end.
     1286       else do:
     1287            in-vatp-have-vat-slt = no.
     1288       end.
     1289     end.
     1290     assign
     1291      price-cli-with-tax-loc = buf_parts.price-cli
     1292      cli-base-rate          = buf_parts.cli-base-rate.
     1293     ASSIGN   road-tax-base-loc  = (if buf_parts.road-tax-base  = ? then 0 else buf_parts.road-tax-base)
     1294              road-tax-rubl-loc  = (if buf_parts.road-tax-rubl  = ? then 0 else buf_parts.road-tax-rubl).
     1295     ASSIGN  transport-base-loc = (if buf_parts.transport-base = ? then 0 else buf_parts.transport-base)
     1296             transport-rubl-loc = (if buf_parts.transport-rubl = ? then 0 else buf_parts.transport-rubl)
     1297             other-base-loc     = (if buf_parts.other-base     = ? then 0 else buf_parts.other-base)
     1298             other-rubl-loc     = (if buf_parts.other-rubl     = ? then 0 else buf_parts.other-rubl)
     1299             vat-pc-loc         = (if buf_parts.vat-pc         = ? then 0 else buf_parts.vat-pc)
     1300             slt-pc-loc         = (if buf_parts.slt-pc         = ? then 0 else buf_parts.slt-pc).
     1301             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     1302       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     1303     assign
     1304       exch-rate-cli-loc = (buf_parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if buf_parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if buf_parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / buf_parts.price-cli .
     1305     assign
