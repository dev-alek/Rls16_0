     2350       with width 136 down stream-io NO-BOX.
     2351   do
     2352   on error undo, return error return-value
     2353   :
     2354   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2355     run mainmenu_getcntxt in p-mainmenu-handle
     2356       (output v-cntxt-db-num
     2357       ,output v-cntxt-userid
     2358       ,output v-cntxt-level
     2359       ,output v-cntxt-host-code-obj
     2360       ,output v-cntxt-obj-type
     2361       ,output v-cntxt-obj-code
     2362       ,output v-cntxt-db-num-obj
     2363       ,output v-cntxt-is-admin
     2364       ) .
     2365       run get-report-num in p-mainmenu-handle (
     2366           output g#report-num
     2367       ).
     2368       run get-quest-print in p-mainmenu-handle (
     2369           output g#quest-print
     2370       ).
     2371       find first buf_fbr-pln no-lock
     2372            where recid( buf_fbr-pln ) = p-fbr-pln-recid
     2373       no-error.
     2374       if not available buf_fbr-pln
     2375       then do:
     2376           message
     2377               "Не найден документ для печати."
     2378           view-as alert-box error.
     2379           undo, return error.
     2380       end.
     2381       assign
     2382           v-line-string = fill( "-", 126 )
     2383       .
     2384   output stream Outstream to value( string( session:temp-directory +
     2385                                        "rpt" + string( g#report-num ) ) )
     2386                                        page-size  value(62) .
     2387   if session :set-wait-state( "compiler" ) then.
     2388       assign
     2389       v-pln-mn-doc-code = buf_fbr-pln.doc-code
     2390       v-pln-mn-doc-date = buf_fbr-pln.doc-date
     2391       v-pln-mn-obj-type = buf_fbr-pln.obj-type
     2392       v-pln-mn-obj-code = buf_fbr-pln.obj-code
     2393       .
     2394       find first buf_pln_clients no-lock
     2395            where buf_pln_clients.obj-type = buf_fbr-pln.obj-type
     2396              and buf_pln_clients.obj-code = buf_fbr-pln.obj-code
     2397       .
     2398       assign
     2399           v-pln-mn-obj-name = buf_pln_clients.obj-name
     2400       .
     2401       for each buf_fbr-pln-line no-lock
     2402          where buf_fbr-pln-line.doc-code     = buf_fbr-pln.doc-code
     2403       on error undo, return error
     2404       :
     2405           if buf_fbr-pln-line.recipe-code <> ""
     2406           and buf_fbr-pln-line.recipe-code <> ?
     2407           then do:
     2408               if buf_fbr-pln-line.fbr-obj-type <> 'маг':U
     2409               then do:
     2410                   find first buf_goods no-lock
     2411                        where buf_goods.gds-code = buf_fbr-pln-line.gds-code
     2412                   .
     2413                   message
     2414                            "Для производства товара указан объект"
     2415                       skip "недопустимого типа. Производство"
     2416                       skip "может быть только на объекте типа магазин."
     2417                       skip(1)
     2418                       skip "Товар:" buf_goods.artic buf_goods.gds-name
     2419                       skip "Объект:" buf_fbr-pln-line.fbr-obj-type buf_fbr-pln-line.fbr-obj-code
     2420                       skip(1)
     2421                       skip "Измените данные плана-меню."
     2422                   view-as alert-box error.
     2423                   undo, return error.
     2424               end.
     2425               find first temp_fbr-objects
     2426                    where temp_fbr-objects.obj-type = buf_fbr-pln-line.fbr-obj-type
     2427                      and temp_fbr-objects.obj-code = buf_fbr-pln-line.fbr-obj-code
     2428               no-error.
     2429               if not available temp_fbr-objects
     2430               then do:
     2431                   create temp_fbr-objects.
     2432                   assign
     2433                       temp_fbr-objects.obj-type = buf_fbr-pln-line.fbr-obj-type
     2434                       temp_fbr-objects.obj-code = buf_fbr-pln-line.fbr-obj-code
     2435                   .
     2436               end.
     2437           end.
     2438       end.
     2439       assign
     2440           v-first-page = yes
     2441       .
     2442       print-for-object:
     2443       for each temp_fbr-objects
     2444       on error undo, return error
     2445       :
     2446           for each temp_fbrrep-goods
     2447           on error undo, return error
     2448           :
     2449               delete temp_fbrrep-goods.
     2450           end.
     2451           if v-first-page = no
     2452           then do:
     2453               page stream Outstream .
     2454           end.
     2455           else do:
     2456               assign
     2457                   v-first-page = no
     2458               .
     2459           end.
     2460           run fbrrest-get-catering-object in this-procedure (
     2461                 input temp_fbr-objects.obj-code
     2462               , output v-store-obj-type
     2463               , output v-store-obj-code
     2464           ).
     2465           find first buf_fbr-doc no-lock
     2466                where buf_fbr-doc.out-code = buf_fbr-pln.doc-code
     2467                  and buf_fbr-doc.obj-type = temp_fbr-objects.obj-type
     2468                  and buf_fbr-doc.obj-code = temp_fbr-objects.obj-code
     2469           .
     2470           if buf_fbr-doc.obj-type = v-store-obj-type
     2471           and buf_fbr-doc.obj-code = v-store-obj-code
     2472           then do:
     2473               assign
     2474                   v-store-is-same-as-kitchen = yes
     2475               .
     2476           end.
     2477           else do:
     2478               assign
     2479                   v-store-is-same-as-kitchen = no
     2480               .
     2481           end.
     2482           run fbrrep-fill-qnty-and-prices in this-procedure (
     2483               input buf_fbr-doc.doc-code
     2484           ).
     2485           assign
     2486               v-have-goods-for-inquiry = no
     2487           .
     2488           check-have-lines:
     2489           for each temp_fbrrep-goods
     2490           on error undo, return error
     2491           :
     2492               if temp_fbrrep-goods.is-not-office = yes
     2493                   and temp_fbrrep-goods.is-waste     = no
     2494                   and temp_fbrrep-goods.write-off-qnty > temp_fbrrep-goods.income-qnty
     2495               then do:
     2496               run fbrrest-get-free-qnty in this-procedure (
     2497                         input buf_fbr-doc.obj-type
     2498                       , input buf_fbr-doc.obj-code
     2499                       , input temp_fbrrep-goods.gds-code
     2500                       , input yes
     2501                       , output v-free-qnty
     2502                   ).
     2503                   if v-store-is-same-as-kitchen = yes
     2504                   then do:
     2505                       assign
     2506                           v-kh-qnty = 0
     2507                       .
     2508                   end.
     2509                   else do:
     2510                       run fbrrest-get-free-qnty in this-procedure (
     2511                             input v-store-obj-type
     2512                           , input v-store-obj-code
     2513                           , input temp_fbrrep-goods.gds-code
     2514                           , input yes
     2515                           , output v-kh-qnty
     2516                       ).
     2517                   end.
     2518                   assign
     2519                       v-need-qnty = temp_fbrrep-goods.write-off-qnty
     2520                                   - temp_fbrrep-goods.income-qnty
     2521                                   - v-free-qnty
     2522                                   - v-kh-qnty
     2523                   .
     2524                   if v-need-qnty > 0
     2525                   then do:
     2526                       assign
     2527                           v-have-goods-for-inquiry = yes
     2528                       .
     2529                       leave check-have-lines.
     2530                   end.
     2531               end.
     2532           end.
     2533           if v-have-goods-for-inquiry = no
     2534           then do:
     2535               undo print-for-object, next print-for-object.
     2536           end.
     2537           assign
     2538               v-doc-code      = buf_fbr-doc.doc-code
     2539               v-doc-date      = buf_fbr-doc.doc-date
     2540           .
     2541           find first buf_pln_clients no-lock
     2542                where buf_pln_clients.obj-type = buf_fbr-doc.obj-type
     2543                  and buf_pln_clients.obj-code = buf_fbr-doc.obj-code
     2544           .
     2545           find first buf_store_clients no-lock
     2546                where buf_store_clients.obj-type = v-store-obj-type
     2547                  and buf_store_clients.obj-code = v-store-obj-code
     2548           .
     2549           define variable v-host-code    as integer      no-undo.
     2550           define variable v-host-name    as character    no-undo.
     2551   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2552   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostname in g#library
     2553     (input  v-cntxt-obj-type
     2554     ,input  v-cntxt-obj-code
     2555     ,output v-host-code
     2556     ,output v-host-name
     2557     )  .
     2558           put stream Outstream
     2559               string( v-host-name  ) format "X(40)"  at 35 skip
     2560               string( v-pln-mn-obj-name  + " (" + v-pln-mn-obj-type + " " + string( v-pln-mn-obj-code ) + ")"  ) format "X(60)"  at 35
     2561               skip  fill("_",60) format "X(60)"  at 35
     2562               skip "предприятие (организация)" at 35
     2563               skip  string(buf_store_clients.obj-name + " (" + buf_store_clients.obj-type + " " + string( buf_store_clients.obj-code ) + ")" ) format "X(60)"   "+------------------+----------+"                                         format "X(31)" at 90
     2564               skip fill("_",60) format "X(60)"                                                                                                                  "|Номер плана-меню  |" + string(v-pln-mn-doc-code, "X(10)")         + "|" format "X(31)" at 90
     2565               skip "подразделение"                                                                                                                              "|Дата составления  |"  + string( v-pln-mn-doc-date, "99/99/9999" ) + "|" format "X(31)" at 90
     2566               skip  string(buf_pln_clients.obj-name + " (" + buf_pln_clients.obj-type + " " + string( buf_pln_clients.obj-code ) + ")" ) format "X(60)"                                 "|Номер документа   |" + string( v-doc-code, "X(10)")               + "|" format "X(31)" at 90
     2567               skip  fill("_",60) format "X(60)"                                                                                                                 "|Дата документа    |"  + string( v-doc-date, "99/99/9999" )        + "|" format "X(31)" at 90
     2568               skip "подразделение получатель "                                                                                                                  "+------------------+----------+"                                         format "X(31)" at 90
     2569               skip " "
     2570               skip  CAPS("Н е х в а т к а   п р о д у к т о в")                        format "X(60)" at 50 space(18)
     2571               skip
     2572           .
     2573           form with frame fbr-not-in-rb.
     2574           for each temp_fbrrep-goods
     2575           on error undo, return error
     2576           :
     2577               if temp_fbrrep-goods.is-not-office = yes
     2578               and temp_fbrrep-goods.is-waste     = no
     2579               and temp_fbrrep-goods.write-off-qnty > temp_fbrrep-goods.income-qnty
     2580               then do:
     2581                   run fbrrest-get-free-qnty in this-procedure (
     2582                         input buf_fbr-doc.obj-type
     2583                       , input buf_fbr-doc.obj-code
     2584                       , input temp_fbrrep-goods.gds-code
     2585                       , input yes
     2586                       , output v-free-qnty
     2587                   ).
     2588                   if v-store-is-same-as-kitchen = yes
     2589                   then do:
     2590                       assign
     2591                           v-kh-qnty = 0
     2592                       .
     2593                   end.
     2594                   else do:
     2595                       run fbrrest-get-free-qnty in this-procedure (
     2596                             input v-store-obj-type
     2597                           , input v-store-obj-code
     2598                           , input temp_fbrrep-goods.gds-code
     2599                           , input yes
     2600                           , output v-kh-qnty
     2601                       ).
     2602                   end.
     2603                   assign
     2604                       v-need-qnty = temp_fbrrep-goods.write-off-qnty
     2605                                   - temp_fbrrep-goods.income-qnty
     2606                                   - v-free-qnty
     2607                                   - v-kh-qnty
     2608                   .
     2609                   assign
     2610                       v-counter = v-counter + 1
     2611                   .
     2612                   run print-line in this-procedure (
     2613                         input v-counter
     2614                       , input temp_fbrrep-goods.gds-code
     2615                       , input temp_fbrrep-goods.write-off-qnty - temp_fbrrep-goods.income-qnty
     2616                       , input v-free-qnty + v-kh-qnty
     2617                       , input v-need-qnty
     2618                   ).
     2619               end.
     2620           end.
     2621           put stream outstream
     2622               v-line-string format "X(126)"
     2623               skip (2)
     2624               "Затребовал заведующий производством:                ____________________                   /_________________ /"
     2625               skip
     2626               "подпись" at 60 "расшифровка подписи" at 95
     2627               skip(1)
     2628               "Отпуск разрешил:                                    ____________________ "
     2629                       skip(1)
     2630               "Руководитель организации:         _____________              _________                    /_________________/ "
     2631               skip
     2632               "должность" at 36  "подпись" at 64     "расшифровка подписи"  at 95
     2633               skip(1)
     2634               .
     2635           hide stream Outstream frame Bottomframe .
     2636       end.
     2637       output stream Outstream close.
     2638   if session :set-wait-state( "" ) then.
     2639   if g#quest-print = false
     2640   then do:
     2641     run adecomm/_osprint.p ( ?, string( session:temp-directory + "rpt" + string( g#report-num ) ),
     2642                                         7, (if 4 >= 8 then 2 else 0), 0, 0,
     2643                                         OUTPUT g#log ).
     2644   end.
     2645   else do:
     2646     os-command silent
     2647       value( "COPY /b " +
     2648         string( session:temp-directory) +  "$" + string( g#report-num ) + " + " +
     2649         string( session:temp-directory) + "rpt" + string( g#report-num ) + " " +
     2650         string( session:temp-directory) +  "$" + string( g#report-num )
     2651                 ) .
     2652     os-command silent
     2653       value( "COPY /b " +
     2654         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl" + " + " +
     2655         string( session:temp-directory) + "rpt" + string( g#report-num ) + ".txl" + " " +
     2656         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl"
     2657                 ) .
     2658   end.
     2659     end.
     2660   procedure print-line :
     2661   do
     2662   on error undo, return error
     2663   :
     2664   define input parameter p-counter    as integer      no-undo.
     2665   define input parameter p-gds-code   as integer      no-undo.
     2666   define input parameter p-fact-plan  as decimal      no-undo.
     2667   define input parameter p-fact-fact  as decimal      no-undo.
     2668   define input parameter p-fact-need  as decimal      no-undo.
     2669   define variable v-bar-code          as character        no-undo.
     2670   define buffer buf_doc-line  for doc-line.
     2671   define buffer buf_goods     for goods.
     2672       find first buf_goods no-lock
     2673            where buf_goods.gds-code = p-gds-code
     2674       .
     2675   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     2676     (input  buf_goods.gds-code
     2677     ,input  ?
     2678     ,output v-bar-code
     2679     ) no-error .
     2680    .
     2681       find first buf_units no-lock
     2682            where buf_units.unit-name = buf_goods.unit-base
     2683       no-error.
     2684       assign
     2685           v-sum-need   = p-fact-need
     2686           v-units-okei = buf_units.okei
     2687       .
     2688       display stream OutStream
     2689       sym1 p-counter                     @ v-counter
     2690       sym2 buf_goods.gds-name            @ v-gds-name
     2691       sym3 string( v-bar-code )          @ v-barcode
     2692       sym4 buf_goods.unit-base           @ v-unit-base
     2693       sym5 v-units-okei                  when integer(v-units-okei) > 0
     2694       sym6 p-fact-plan                   @ v-sum-plan
     2695       sym7 p-fact-fact                   @ v-sum-fact
     2696       sym8 v-sum-need                    when round(v-sum-need,3) > 0
     2697       sym9
     2698       with frame fbr-not-in-rb.
     2699       down stream OutStream 1 with frame fbr-not-in-rb.
     2700       if line-counter( Outstream ) + 2 > page-size( Outstream )
     2701       then do:
     2702           page stream Outstream .
     2703       end.
     2704   end.
     2705   end procedure.
