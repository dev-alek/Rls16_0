     1489      find first in-vatp-goods where in-vatp-goods.artic     = buf_doc-line.artic     and
     1490                                        in-vatp-goods.prod-type = buf_doc-line.prod-type and
     1491                                        in-vatp-goods.prod-code = buf_doc-line.prod-code no-lock.
     1492      if (not buf_trn-doc.internal and
     1493              buf_trn-doc.doc-type = 'при':U) or
     1494         in-vatp-goods.gds-type = 'у':U then do:
     1495         if varinvprb = "base":u then do:
     1496           assign
     1497             road-tax-base-loc = buf_doc-line.road-tax
     1498             road-tax-rubl-loc = buf_doc-line.road-tax * buf_trn-doc.base-rate / buf_trn-doc.base-scale.
     1499         end.
     1500         else do:
     1501           ASSIGN
     1502             road-tax-rubl-loc = buf_doc-line.road-tax
     1503             road-tax-base-loc = buf_doc-line.road-tax / buf_trn-doc.base-rate * buf_trn-doc.base-scale.
     1504         end.
     1505         if road-tax-base-loc = ? then road-tax-base-loc = 0.
     1506         if road-tax-rubl-loc = ? then road-tax-rubl-loc = 0.
     1507         assign
     1508           road-tax-cli-loc = ?.
     1509         ASSIGN
     1510           transport-base-loc = (if buf_doc-line.transport-base = ? then 0 else buf_doc-line.transport-base)
     1511           transport-rubl-loc = (if buf_doc-line.transport-rubl = ? then 0 else buf_doc-line.transport-rubl)
     1512           transport-cli-loc  = 0
     1513           other-base-loc     = (if buf_doc-line.other-base     = ? then 0 else buf_doc-line.other-base)
     1514           other-rubl-loc     = (if buf_doc-line.other-rubl     = ? then 0 else buf_doc-line.other-rubl)
     1515           other-cli-loc      = 0
     1516           vat-pc-loc         = (if buf_doc-line.vat-pc         = ? then 0 else buf_doc-line.vat-pc)
     1517           slt-pc-loc         = (if buf_doc-line.slt-pc         = ? then 0 else buf_doc-line.slt-pc).
     1518                                 ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     1519               ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     1520         assign
     1521           vat-cli-loc            = ?
     1522           slt-cli-loc            = ?
     1523           price-cli-with-tax-loc = ?.
     1524      end.
     1525      else do:
     1526                                                   for each in-vatp-parts where in-vatp-parts.out-code  = buf_doc-line.doc-code  and
     1527                                         in-vatp-parts.obj-type  = buf_doc-line.obj-type  and
     1528                                         in-vatp-parts.obj-code  = buf_doc-line.obj-code  and
     1529                                         in-vatp-parts.artic     = buf_doc-line.artic     and
     1530                                         in-vatp-parts.prod-type = buf_doc-line.prod-type and
     1531                                         in-vatp-parts.prod-code = buf_doc-line.prod-code
     1532                            use-index out-code no-lock:
     1533             accumulate  in-vatp-parts.road-tax-base  * in-vatp-parts.fact-qnty (total)
     1534                         in-vatp-parts.road-tax-rubl  * in-vatp-parts.fact-qnty (total)
     1535                         in-vatp-parts.transport-base * in-vatp-parts.fact-qnty (total)
     1536                         in-vatp-parts.transport-rubl * in-vatp-parts.fact-qnty (total)
     1537                         in-vatp-parts.other-base     * in-vatp-parts.fact-qnty (total)
     1538                         in-vatp-parts.other-rubl     * in-vatp-parts.fact-qnty (total)
     1539                                                                                                                 (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  (total)
     1540                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))  (total)
     1541                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))  (total)
     1542                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc))  (total)
     1543                                               (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  (total)
     1544                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))  (total)
     1545                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))  (total)
     1546                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc))  (total)
     1547                         .
     1548         end.
     1549         ASSIGN
     1550           road-tax-base-loc   = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.road-tax-base  * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
     1551           road-tax-rubl-loc   = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.road-tax-rubl  * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
     1552           transport-base-loc  = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.transport-base * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
     1553           transport-rubl-loc  = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.transport-rubl * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
     1554           other-base-loc      = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.other-base     * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
     1555           other-rubl-loc      = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.other-rubl     * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
     1556                                           vat-base-loc        = if buf_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / buf_doc-line.fact-qnty   else 0
     1557           slt-base-loc        = if buf_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / buf_doc-line.fact-qnty   else 0
     1558                   vat-rubl-loc        = if buf_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / buf_doc-line.fact-qnty   else 0
     1559           slt-rubl-loc        = if buf_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / buf_doc-line.fact-qnty   else 0
     1560           vat-pc-loc          = (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc)))
     1561           slt-pc-loc          = (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))).
     1562         if road-tax-base-loc  = ? then road-tax-base-loc  = 0.
     1563         if road-tax-rubl-loc  = ? then road-tax-rubl-loc  = 0.
     1564         if transport-base-loc = ? then transport-base-loc = 0.
     1565         if transport-rubl-loc = ? then transport-rubl-loc = 0.
     1566         if other-base-loc     = ? then other-base-loc     = 0.
     1567         if other-rubl-loc     = ? then other-rubl-loc     = 0.
     1568         assign
     1569           transport-cli-loc      = 0
     1570           other-cli-loc          = 0
     1571           road-tax-cli-loc       = ?
     1572           vat-cli-loc            = ?
     1573           slt-cli-loc            = ?
     1574           price-cli-with-tax-loc = ?.
     1575      end.
     1576   ASSIGN
     1577             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     1578       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     1579   .
     1580             assign
     1581               v-fact-qnty           = v-fact-qnty      + v-parts-fact-qnty
     1582               v-vat-pc              = vat-pc-loc
     1583               v-slt-pc              = slt-pc-loc
     1584               v-sum-base            = v-sum-base       + (price-base-with-tax-loc * v-parts-fact-qnty)
     1585               v-sum-rubl            = v-sum-rubl       + (price-rubl-with-tax-loc * v-parts-fact-qnty)
     1586               v-vat-base            = v-vat-base       + (vat-base-loc            * v-parts-fact-qnty)
     1587               v-vat-rubl            = v-vat-rubl       + (vat-rubl-loc            * v-parts-fact-qnty)
     1588               v-slt-base            = v-slt-base       + (slt-base-loc            * v-parts-fact-qnty)
     1589               v-slt-rubl            = v-slt-rubl       + (slt-rubl-loc            * v-parts-fact-qnty)
     1590               v-road-tax-base       =  0
     1591               v-road-tax-rubl       =  0
     1592               v-excise-base         =  0
     1593               v-excise-rubl         =  0
     1594               v-transport-base      =  0
     1595               v-transport-rubl      =  0
     1596               v-other-base          =  0
     1597               v-other-rubl          =  0
     1598             .
     1599       end.
     1600     end.
     1601   end procedure.
     1602   procedure fbrrep-fill-qnty-and-prices :
     1603   do
     1604   on error undo, return error
     1605   :
     1606   define input parameter p-fbr-doc-doc-code  as character    no-undo.
     1607       define variable v-gds-code  as integer       no-undo.
     1608       define variable v-gds-name  as character     no-undo.
     1609       define variable v-sign      as decimal       no-undo.
     1610       define buffer buf_fbr-line          for ub.fbr-line.
     1611       define buffer buf_temp_fbrrep-goods for temp_fbrrep-goods.
     1612       for each buf_fbr-line no-lock
     1613          where buf_fbr-line.doc-code = p-fbr-doc-doc-code
     1614       on error undo, return error
     1615       :
     1616           find first buf_temp_fbrrep-goods
     1617                where buf_temp_fbrrep-goods.artic     = buf_fbr-line.artic
     1618                  and buf_temp_fbrrep-goods.prod-type = buf_fbr-line.prod-type
     1619                  and buf_temp_fbrrep-goods.prod-code = buf_fbr-line.prod-code
     1620           use-index ar
     1621           no-error.
     1622           if not available buf_temp_fbrrep-goods
     1623           then do:
     1624               create buf_temp_fbrrep-goods.
     1625   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1626   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
     1627     (input  buf_fbr-line.artic
     1628     ,input  buf_fbr-line.prod-type
     1629     ,input  buf_fbr-line.prod-code
     1630     ,output v-gds-code
     1631     )  .
     1632   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1633   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-arnm in g#library
     1634     (input  buf_fbr-line.artic
     1635     ,input  buf_fbr-line.prod-type
     1636     ,input  buf_fbr-line.prod-code
     1637     ,output v-gds-name
     1638     )  .
     1639   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1640   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     1641     (input  buf_fbr-line.artic
     1642     ,input  buf_fbr-line.prod-type
     1643     ,input  buf_fbr-line.prod-code
     1644     ,input  'gds-goods=request':u
     1645     ,output buf_temp_fbrrep-goods.is-not-office
     1646     )  .
     1647               assign
     1648                   buf_temp_fbrrep-goods.gds-code             = v-gds-code
     1649                   buf_temp_fbrrep-goods.artic                = buf_fbr-line.artic
     1650                   buf_temp_fbrrep-goods.prod-type            = buf_fbr-line.prod-type
     1651                   buf_temp_fbrrep-goods.prod-code            = buf_fbr-line.prod-code
     1652                   buf_temp_fbrrep-goods.gds-name             = v-gds-name
     1653                   buf_temp_fbrrep-goods.is-waste             = buf_fbr-line.is-waste
     1654                   buf_temp_fbrrep-goods.fact-qnty            = 0
     1655                   buf_temp_fbrrep-goods.write-off-rsrv-qnty  = 0
     1656                   buf_temp_fbrrep-goods.write-off-qnty       = 0
     1657                   buf_temp_fbrrep-goods.income-qnty          = 0
     1658                   buf_temp_fbrrep-goods.income-rsrv-qnty     = 0
     1659                   buf_temp_fbrrep-goods.cost-rubl            = 0
     1660                   buf_temp_fbrrep-goods.cost-base            = 0
     1661                   buf_temp_fbrrep-goods.sum-cost-rubl        = 0
     1662                   buf_temp_fbrrep-goods.sum-cost-base        = 0
     1663                   buf_temp_fbrrep-goods.vat-cost-rubl        = 0
     1664                   buf_temp_fbrrep-goods.vat-cost-base        = 0
     1665                   buf_temp_fbrrep-goods.sum-vat-cost-rubl    = 0
     1666                   buf_temp_fbrrep-goods.sum-vat-cost-base    = 0
     1667                   buf_temp_fbrrep-goods.price-sale           = buf_fbr-line.price-sale
     1668                   buf_temp_fbrrep-goods.deleted              = no
     1669               .
     1670   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1671   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run unitbase in g#library
     1672     (input  v-gds-code
     1673     ,output buf_temp_fbrrep-goods.unit-base
     1674     )  .
     1675           end.
     1676           case buf_fbr-line.trn-type
     1677           :
     1678               when 'при':U
     1679               then do:
     1680                   assign
     1681                       v-sign                                  = 1
     1682                       buf_temp_fbrrep-goods.income-qnty       = buf_temp_fbrrep-goods.income-qnty     + buf_fbr-line.fact-qnty
     1683                   .
     1684                   if buf_fbr-line.rsrv-qnty <> ?
     1685                   then do:
     1686                       assign
     1687                           buf_temp_fbrrep-goods.income-rsrv-qnty = buf_temp_fbrrep-goods.income-rsrv-qnty   + buf_fbr-line.rsrv-qnty
     1688                       .
     1689                   end.
     1690               end.
     1691               when 'спи':U
     1692               then do:
     1693                   assign
     1694                       v-sign                                  = -1
     1695                       buf_temp_fbrrep-goods.write-off-qnty    = buf_temp_fbrrep-goods.write-off-qnty  + buf_fbr-line.fact-qnty
     1696                   .
     1697                   if buf_fbr-line.rsrv-qnty <> ?
     1698                   then do:
     1699                       assign
     1700                           buf_temp_fbrrep-goods.write-off-rsrv-qnty = buf_temp_fbrrep-goods.write-off-rsrv-qnty   + buf_fbr-line.rsrv-qnty
     1701                       .
     1702                   end.
     1703               end.
     1704           end case.
     1705           assign
     1706               buf_temp_fbrrep-goods.sum-cost-rubl        = buf_temp_fbrrep-goods.sum-cost-rubl     + v-sign * buf_fbr-line.price-sum-rubl
     1707               buf_temp_fbrrep-goods.sum-cost-base        = buf_temp_fbrrep-goods.sum-cost-base     + v-sign * buf_fbr-line.price-sum-base
     1708               buf_temp_fbrrep-goods.sum-vat-cost-rubl    = buf_temp_fbrrep-goods.sum-vat-cost-rubl + v-sign * buf_fbr-line.price-sum-vat-rubl
     1709               buf_temp_fbrrep-goods.sum-vat-cost-base    = buf_temp_fbrrep-goods.sum-vat-cost-base + v-sign * buf_fbr-line.price-sum-vat-base
     1710           .
     1711       end.
     1712       run test-temp-tables in this-procedure .
     1713   end.
     1714   end procedure.
     1715   procedure fbrrep-fill-for-fbr-actp :
     1716   do
     1717   on error undo, return error
     1718   :
     1719   define input parameter p-fbr-doc-doc-code  as character    no-undo.
     1720       define buffer buf_temp_fbrrep-goods for temp_fbrrep-goods.
     1721       define buffer buf_fbr-line          for ub.fbr-line.
     1722       run fbrrep-fill-qnty-and-prices in this-procedure (
     1723           input p-fbr-doc-doc-code
     1724       ).
     1725       for each buf_temp_fbrrep-goods
     1726       :
     1727           assign
     1728               buf_temp_fbrrep-goods.sum-cost-rubl     = 0
     1729               buf_temp_fbrrep-goods.sum-cost-base     = 0
     1730               buf_temp_fbrrep-goods.sum-vat-cost-rubl = 0
     1731               buf_temp_fbrrep-goods.sum-vat-cost-base = 0
     1732               buf_temp_fbrrep-goods.cost-rubl     = 0
     1733               buf_temp_fbrrep-goods.cost-base     = 0
     1734               buf_temp_fbrrep-goods.vat-cost-rubl = 0
     1735               buf_temp_fbrrep-goods.vat-cost-base = 0
     1736           .
     1737           if buf_temp_fbrrep-goods.income-qnty = 0
     1738           or buf_temp_fbrrep-goods.write-off-qnty = 0
     1739           then do:
     1740               assign
     1741                   buf_temp_fbrrep-goods.deleted   = yes
     1742                   buf_temp_fbrrep-goods.fact-qnty = 0
     1743               .
     1744           end.
     1745           else do:
     1746               if buf_temp_fbrrep-goods.income-qnty <= buf_temp_fbrrep-goods.write-off-qnty
     1747               then do:
     1748                   assign
     1749                       buf_temp_fbrrep-goods.fact-qnty = buf_temp_fbrrep-goods.income-qnty
     1750                   .
     1751                   for each buf_fbr-line no-lock
     1752                      where buf_fbr-line.doc-code  = p-fbr-doc-doc-code
     1753                        and buf_fbr-line.artic     = buf_temp_fbrrep-goods.artic
     1754                        and buf_fbr-line.prod-type = buf_temp_fbrrep-goods.prod-type
     1755                        and buf_fbr-line.prod-code = buf_temp_fbrrep-goods.prod-code
     1756                        and buf_fbr-line.trn-type  = 'при':U
     1757                   :
     1758                       assign
     1759                           buf_temp_fbrrep-goods.sum-cost-rubl     = buf_temp_fbrrep-goods.sum-cost-rubl     + buf_fbr-line.price-sum-rubl
     1760                           buf_temp_fbrrep-goods.sum-cost-base     = buf_temp_fbrrep-goods.sum-cost-base     + buf_fbr-line.price-sum-base
     1761                           buf_temp_fbrrep-goods.sum-vat-cost-rubl = buf_temp_fbrrep-goods.sum-vat-cost-rubl + buf_fbr-line.price-sum-vat-rubl
     1762                           buf_temp_fbrrep-goods.sum-vat-cost-base = buf_temp_fbrrep-goods.sum-vat-cost-base + buf_fbr-line.price-sum-vat-base
     1763                       .
     1764                   end.
     1765                   assign
     1766                       buf_temp_fbrrep-goods.cost-rubl     = buf_temp_fbrrep-goods.sum-cost-rubl     / buf_temp_fbrrep-goods.fact-qnty
     1767                       buf_temp_fbrrep-goods.cost-base     = buf_temp_fbrrep-goods.sum-cost-base     / buf_temp_fbrrep-goods.fact-qnty
     1768                       buf_temp_fbrrep-goods.vat-cost-rubl = buf_temp_fbrrep-goods.sum-vat-cost-rubl / buf_temp_fbrrep-goods.fact-qnty
     1769                       buf_temp_fbrrep-goods.vat-cost-base = buf_temp_fbrrep-goods.sum-vat-cost-base / buf_temp_fbrrep-goods.fact-qnty
     1770                   .
     1771               end.
     1772               else do:
     1773                   assign
     1774                       buf_temp_fbrrep-goods.fact-qnty = buf_temp_fbrrep-goods.write-off-qnty
     1775                   .
     1776                   for each buf_fbr-line no-lock
     1777                      where buf_fbr-line.doc-code  = p-fbr-doc-doc-code
     1778                        and buf_fbr-line.artic     = buf_temp_fbrrep-goods.artic
     1779                        and buf_fbr-line.prod-type = buf_temp_fbrrep-goods.prod-type
     1780                        and buf_fbr-line.prod-code = buf_temp_fbrrep-goods.prod-code
     1781                        and buf_fbr-line.trn-type  = 'спи':U
     1782                   :
     1783                       assign
     1784                           buf_temp_fbrrep-goods.sum-cost-rubl     = buf_temp_fbrrep-goods.sum-cost-rubl     + buf_fbr-line.price-sum-rubl
     1785                           buf_temp_fbrrep-goods.sum-cost-base     = buf_temp_fbrrep-goods.sum-cost-base     + buf_fbr-line.price-sum-base
     1786                           buf_temp_fbrrep-goods.sum-vat-cost-rubl = buf_temp_fbrrep-goods.sum-vat-cost-rubl + buf_fbr-line.price-sum-vat-rubl
     1787                           buf_temp_fbrrep-goods.sum-vat-cost-base = buf_temp_fbrrep-goods.sum-vat-cost-base + buf_fbr-line.price-sum-vat-base
     1788                       .
     1789                   end.
     1790                   assign
     1791                       buf_temp_fbrrep-goods.cost-rubl     = buf_temp_fbrrep-goods.sum-cost-rubl     / buf_temp_fbrrep-goods.fact-qnty
     1792                       buf_temp_fbrrep-goods.cost-base     = buf_temp_fbrrep-goods.sum-cost-base     / buf_temp_fbrrep-goods.fact-qnty
     1793                       buf_temp_fbrrep-goods.vat-cost-rubl = buf_temp_fbrrep-goods.sum-vat-cost-rubl / buf_temp_fbrrep-goods.fact-qnty
     1794                       buf_temp_fbrrep-goods.vat-cost-base = buf_temp_fbrrep-goods.sum-vat-cost-base / buf_temp_fbrrep-goods.fact-qnty
     1795                   .
     1796               end.
     1797           end.
     1798       end.
     1799       for each buf_temp_fbrrep-goods
     1800          where buf_temp_fbrrep-goods.deleted = yes
     1801       on error undo, return error
     1802       :
     1803           delete buf_temp_fbrrep-goods.
     1804       end.
     1805       run test-temp-tables in this-procedure .
     1806   end.
     1807   end procedure.
     1808   procedure fbrrep-fill-for-op-del :
     1809   do
     1810   on error undo, return error
     1811   :
     1812   define input parameter p-fbr-doc-doc-code   as character    no-undo.
     1813   define input parameter p-db-remote          as logical          no-undo.
     1814       define variable v-serv-code as character    no-undo.
     1815       define variable v-in-code   as character    no-undo.
     1816       define variable v-out-code  as character    no-undo.
     1817       define variable v-trn-qnty  as decimal       no-undo.
     1818       define variable v-sign      as decimal       no-undo.
     1819       define variable v-qnty      as decimal       no-undo.
     1820       define buffer buf_fbr-doc           for ub.fbr-doc.
     1821       define buffer buf_fbr-line          for ub.fbr-line.
     1822       define buffer buf_goods             for ub.goods .
     1823       define buffer buf_doc-line          for ub.doc-line .
     1824       define buffer buf_temp_fbrrep-goods for temp_fbrrep-goods .
     1825       run fbrrep-fill-qnty-and-prices in this-procedure (
     1826           input p-fbr-doc-doc-code
     1827       ).
     1828       for each buf_temp_fbrrep-goods
     1829       on error undo, return error
     1830       :
     1831           if buf_temp_fbrrep-goods.income-qnty <> 0
     1832           or buf_temp_fbrrep-goods.write-off-qnty <> 0
     1833           then do:
     1834               assign
     1835                   v-qnty  = ( buf_temp_fbrrep-goods.write-off-qnty - buf_temp_fbrrep-goods.income-qnty )
     1836               .
     1837               if v-qnty = 0
     1838               then do:
     1839                   find first buf_fbr-line no-lock
     1840                        where buf_fbr-line.doc-code    = p-fbr-doc-doc-code
     1841                          and buf_fbr-line.artic       = buf_temp_fbrrep-goods.artic
     1842                          and buf_fbr-line.prod-type   = buf_temp_fbrrep-goods.prod-type
     1843                          and buf_fbr-line.prod-code   = buf_temp_fbrrep-goods.prod-code
     1844                          and buf_fbr-line.fact-qnty   <> 0
     1845                   no-error.
     1846                   if available buf_fbr-line
     1847                   then do:
     1848                       assign
     1849                           buf_temp_fbrrep-goods.cost-rubl     = buf_fbr-line.price-rubl
     1850                           buf_temp_fbrrep-goods.cost-base     = buf_fbr-line.price-base
     1851                           buf_temp_fbrrep-goods.vat-cost-rubl = buf_fbr-line.price-sum-vat-rubl / buf_fbr-line.fact-qnty
     1852                           buf_temp_fbrrep-goods.vat-cost-base = buf_fbr-line.price-sum-vat-base / buf_fbr-line.fact-qnty
     1853                       .
     1854                   end.
     1855                   else do:
     1856                       assign
     1857                           buf_temp_fbrrep-goods.cost-rubl     = 0
     1858                           buf_temp_fbrrep-goods.cost-base     = 0
     1859                           buf_temp_fbrrep-goods.vat-cost-rubl = 0
     1860                           buf_temp_fbrrep-goods.vat-cost-base = 0
     1861                       .
     1862                   end.
     1863               end.
     1864               else do:
     1865                   assign
     1866                       buf_temp_fbrrep-goods.cost-rubl     = buf_temp_fbrrep-goods.sum-cost-rubl     / v-qnty
     1867                       buf_temp_fbrrep-goods.cost-base     = buf_temp_fbrrep-goods.sum-cost-base     / v-qnty
     1868                       buf_temp_fbrrep-goods.vat-cost-rubl = buf_temp_fbrrep-goods.sum-vat-cost-rubl / v-qnty
     1869                       buf_temp_fbrrep-goods.vat-cost-base = buf_temp_fbrrep-goods.sum-vat-cost-base / v-qnty
     1870                   .
     1871               end.
     1872           end.
     1873           else do:
     1874               assign
     1875                   buf_temp_fbrrep-goods.cost-rubl     = 0
     1876                   buf_temp_fbrrep-goods.cost-base     = 0
     1877                   buf_temp_fbrrep-goods.vat-cost-rubl = 0
     1878                   buf_temp_fbrrep-goods.vat-cost-base = 0
     1879               .
     1880           end.
     1881       end.
     1882       for each buf_temp_fbrrep-goods
     1883       :
     1884           if buf_temp_fbrrep-goods.is-waste = yes
     1885           then do:
     1886               assign
     1887                   buf_temp_fbrrep-goods.deleted = yes
     1888               .
     1889           end.
     1890           else do:
     1891               if buf_temp_fbrrep-goods.write-off-qnty <> 0
     1892               and buf_temp_fbrrep-goods.income-qnty <> 0
     1893               then do:
     1894                   if buf_temp_fbrrep-goods.write-off-qnty = buf_temp_fbrrep-goods.income-qnty
     1895                   then do:
     1896                       assign
     1897                           buf_temp_fbrrep-goods.deleted = yes
     1898                       .
     1899                   end.
     1900                   else do:
     1901                       if buf_temp_fbrrep-goods.write-off-qnty > buf_temp_fbrrep-goods.income-qnty
     1902                       then do:
     1903                           assign
     1904                               buf_temp_fbrrep-goods.write-off-qnty    = buf_temp_fbrrep-goods.write-off-qnty - buf_temp_fbrrep-goods.income-qnty
     1905                               buf_temp_fbrrep-goods.income-qnty       = 0
     1906                           .
     1907                       end.
     1908                       else do:
     1909                           assign
     1910                               buf_temp_fbrrep-goods.income-qnty       = buf_temp_fbrrep-goods.income-qnty - buf_temp_fbrrep-goods.write-off-qnty
     1911                               buf_temp_fbrrep-goods.write-off-qnty    = 0
     1912                           .
     1913                       end.
     1914                   end.
     1915               end.
     1916           end.
     1917       end.
     1918       for each buf_temp_fbrrep-goods
     1919          where buf_temp_fbrrep-goods.deleted = yes
     1920       on error undo, return error
     1921       :
     1922           delete buf_temp_fbrrep-goods.
     1923       end.
     1924       run test-temp-tables in this-procedure .
     1925       find first buf_fbr-doc no-lock
     1926            where buf_fbr-doc.doc-code = p-fbr-doc-doc-code
     1927       .
     1928       assign
     1929           v-out-code = p-fbr-doc-doc-code
     1930       .
     1931       run doc-code in this-procedure (
     1932             input  "pair"
     1933           , input  buf_fbr-doc.obj-type
     1934           , input  buf_fbr-doc.obj-code
     1935           , input  v-out-code
     1936           , output v-in-code
     1937       ) no-error.
     1938       if error-status:error
     1939       then do:
     1940           message
     1941                    vss-workfile vss-revision vss-description
     1942               skip "Ошибка вычисления номера приходной накладной."
     1943               skip return-value
     1944               skip trim(error-status :get-message(1))
     1945                    trim(error-status :get-message(2))
     1946                    trim(error-status :get-message(3))
     1947           view-as alert-box error.
     1948           undo, return error .
     1949       end.
     1950       run doc-code in this-procedure (
     1951             input  "trio"
     1952           , input  buf_fbr-doc.obj-type
     1953           , input  buf_fbr-doc.obj-code
     1954           , input  v-in-code
     1955           , output v-serv-code
     1956       ) no-error.
     1957       if error-status:error
     1958       then do:
     1959           message
     1960                    vss-workfile vss-revision vss-description
     1961               skip "Ошибка вычисления номера накладной расхода."
     1962               skip return-value
     1963               skip trim(error-status :get-message(1))
     1964                    trim(error-status :get-message(2))
     1965                    trim(error-status :get-message(3))
     1966           view-as alert-box error.
     1967           undo, return error .
     1968       end.
     1969       for each buf_temp_fbrrep-goods
     1970       on error undo, return error
     1971       :
     1972           if buf_temp_fbrrep-goods.income-qnty > buf_temp_fbrrep-goods.write-off-qnty
     1973           then do:
     1974               find first buf_doc-line no-lock
     1975                    where buf_doc-line.doc-code  = v-in-code
     1976                      and buf_doc-line.artic     = buf_temp_fbrrep-goods.artic
     1977                      and buf_doc-line.prod-type = buf_temp_fbrrep-goods.prod-type
     1978                      and buf_doc-line.prod-code = buf_temp_fbrrep-goods.prod-code
     1979               no-error.
     1980               if available buf_doc-line
     1981               then do:
     1982                   assign
     1983                       buf_temp_fbrrep-goods.fact-qnty = buf_temp_fbrrep-goods.income-qnty - buf_doc-line.doc-qnty
     1984                   .
     1985               end.
     1986               else do:
     1987                   assign
     1988                       buf_temp_fbrrep-goods.fact-qnty = buf_temp_fbrrep-goods.income-qnty
     1989                   .
     1990               end.
     1991           end.
     1992           else do:
     1993               if buf_temp_fbrrep-goods.is-not-office = no
     1994               then do:
     1995                   find first buf_doc-line no-lock
     1996                        where buf_doc-line.doc-code  = v-serv-code
     1997                          and buf_doc-line.artic     = buf_temp_fbrrep-goods.artic
     1998                          and buf_doc-line.prod-type = buf_temp_fbrrep-goods.prod-type
     1999                          and buf_doc-line.prod-code = buf_temp_fbrrep-goods.prod-code
     2000                   no-error.
     2001               end.
     2002               else do:
     2003                   find first buf_doc-line no-lock
     2004                        where buf_doc-line.doc-code  = v-out-code
     2005                          and buf_doc-line.artic     = buf_temp_fbrrep-goods.artic
     2006                          and buf_doc-line.prod-type = buf_temp_fbrrep-goods.prod-type
     2007                          and buf_doc-line.prod-code = buf_temp_fbrrep-goods.prod-code
     2008                   no-error.
     2009               end.
     2010               if available buf_doc-line
     2011               then do:
     2012                   assign
     2013                       buf_temp_fbrrep-goods.fact-qnty = buf_temp_fbrrep-goods.write-off-qnty - buf_doc-line.doc-qnty
     2014                   .
     2015               end.
     2016               else do:
     2017                   assign
     2018                       buf_temp_fbrrep-goods.fact-qnty = buf_temp_fbrrep-goods.write-off-qnty
     2019                   .
     2020               end.
     2021           end.
     2022           if available buf_doc-line
     2023           then do:
     2024               define variable v-void              as decimal       no-undo.
     2025               define variable v-fact-qnty         as decimal       no-undo.
     2026               define variable v-sum-base          as decimal       no-undo.
     2027               define variable v-sum-rubl          as decimal       no-undo.
     2028               define variable v-vat-base          as decimal       no-undo.
     2029               define variable v-vat-rubl          as decimal       no-undo.
     2030               define variable v-slt-base          as decimal       no-undo.
     2031               define variable v-slt-rubl          as decimal       no-undo.
     2032               define variable v-road-tax-base     as decimal       no-undo.
     2033               define variable v-road-tax-rubl     as decimal       no-undo.
     2034               define variable v-transport-base    as decimal       no-undo.
     2035               define variable v-transport-rubl    as decimal       no-undo.
     2036               define variable v-other-base        as decimal       no-undo.
     2037               define variable v-other-rubl        as decimal       no-undo.
     2038               define variable v-excise-base       as decimal       no-undo.
     2039               define variable v-excise-rubl       as decimal       no-undo.
     2040               run r-cost in this-procedure (
     2041                     input buf_doc-line.doc-code
     2042                   , input buf_doc-line.artic
     2043                   , input buf_doc-line.prod-type
     2044                   , input buf_doc-line.prod-code
     2045                   , output v-fact-qnty
     2046                   , output v-void
     2047                   , output v-void
     2048                   , output v-sum-base
     2049                   , output v-sum-rubl
     2050                   , output v-vat-base
     2051                   , output v-vat-rubl
     2052                   , output v-slt-base
     2053                   , output v-slt-rubl
     2054                   , output v-road-tax-base
     2055                   , output v-road-tax-rubl
     2056                   , output v-transport-base
     2057                   , output v-transport-rubl
     2058                   , output v-other-base
     2059                   , output v-other-rubl
     2060                   , output v-excise-base
     2061                   , output v-excise-rubl
     2062               ).
     2063               assign
     2064                   v-sign = ( if v-fact-qnty >= 0 then 1 else -1 )
     2065               .
     2066               assign
     2067                   v-sum-rubl = v-sum-rubl - v-vat-rubl - v-slt-rubl - v-road-tax-rubl - v-transport-rubl - v-other-rubl - v-excise-rubl
     2068                   v-sum-base = v-sum-base - v-vat-base - v-slt-base - v-road-tax-base - v-transport-base - v-other-base - v-excise-base
     2069                   v-sum-rubl = v-sum-rubl   * v-sign
     2070                   v-sum-base = v-sum-base   * v-sign
     2071                   v-vat-rubl = v-vat-rubl   * v-sign
     2072                   v-vat-base = v-vat-base   * v-sign
     2073                   v-fact-qnty = v-fact-qnty * v-sign
     2074               .
     2075               output to "fbrrep.txt" append .
     2076               put unformatted skip(1) v-fact-qnty "   " v-sum-rubl "    " v-vat-rubl.
     2077               output close.
     2078               assign
     2079                   buf_temp_fbrrep-goods.sum-cost-rubl     = absolute( buf_temp_fbrrep-goods.cost-rubl     * v-fact-qnty ) - absolute( v-sum-rubl )
     2080                   buf_temp_fbrrep-goods.sum-cost-base     = absolute( buf_temp_fbrrep-goods.cost-base     * v-fact-qnty ) - absolute( v-sum-base )
     2081                   buf_temp_fbrrep-goods.sum-vat-cost-rubl = absolute( buf_temp_fbrrep-goods.vat-cost-rubl * v-fact-qnty ) - absolute( v-vat-rubl )
     2082                   buf_temp_fbrrep-goods.sum-vat-cost-base = absolute( buf_temp_fbrrep-goods.vat-cost-base * v-fact-qnty ) - absolute( v-vat-base )
     2083               .
     2084               if buf_temp_fbrrep-goods.fact-qnty          = 0
     2085               and buf_temp_fbrrep-goods.sum-cost-rubl     = 0
     2086               and buf_temp_fbrrep-goods.sum-cost-base     = 0
     2087               and buf_temp_fbrrep-goods.sum-vat-cost-rubl = 0
     2088               and buf_temp_fbrrep-goods.sum-vat-cost-base = 0
     2089               then do:
     2090                   assign
     2091                       buf_temp_fbrrep-goods.deleted = yes
     2092                   .
     2093               end.
     2094           end.
     2095       end.
     2096       for each buf_temp_fbrrep-goods
     2097          where buf_temp_fbrrep-goods.deleted = yes
     2098       on error undo, return error
     2099       :
     2100           delete buf_temp_fbrrep-goods.
     2101       end.
     2102       run test-temp-tables in this-procedure .
     2103   end.
     2104   end procedure.
     2105   procedure test-temp-tables :
     2106   do
     2107   on error undo, return error
     2108   :
     2109       define variable v-str   as character     no-undo.
     2110       assign
     2111           v-str = ""
     2112       .
     2113       for each temp_fbrrep-goods
     2114       :
     2115           assign
     2116               v-str = v-str
     2117                   + chr(10) + temp_fbrrep-goods.artic
     2118                   + chr(9) + string( temp_fbrrep-goods.income-qnty )
     2119                   + chr(9) + string( temp_fbrrep-goods.write-off-qnty )
     2120                   + chr(9) + string( temp_fbrrep-goods.cost-rubl )
     2121                   + chr(9) + string( temp_fbrrep-goods.vat-cost-rubl )
     2122                   + chr(9) + string( temp_fbrrep-goods.sum-cost-rubl )
     2123                   + chr(9) + string( temp_fbrrep-goods.sum-vat-cost-rubl )
     2124                   + chr(9) + string( temp_fbrrep-goods.gds-name )
     2125           .
     2126       end.
     2127       output to "fbrrep.txt" append .
     2128       put unformatted skip(2) v-str.
     2129       output close.
     2130   end.
     2131   end procedure.
     2132   procedure fbrrep-test-fbrdoc-for-fact :
     2133   do
     2134   on error undo, return error
     2135   :
     2136   define output parameter p-have-error        as logical      no-undo.
