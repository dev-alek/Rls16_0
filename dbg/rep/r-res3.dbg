        1   block-level on error undo, throw.
        2   define temp-table temp_fbr-objects no-undo
        3       field obj-type  as character
        4       field obj-code  as integer
        5       index pi is primary unique obj-type obj-code
        6   .
        7   define input parameter p-mainmenu-handle    as handle           no-undo.
        8   define input parameter p-fbr-pln-recid      as recid            no-undo.
        9   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       10   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       11   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       12   define variable vss-workfile    as character no-undo init "$Workfile: r-res3.p $":U .
       13   define variable vss-archive     as character no-undo init "$Archive: rep/r-res3.p $":U .
       14   define variable vss-description as character no-undo init "Нехватка продуктов".
       15   procedure vss-get-info :
       16     define output parameter p-vss-revision    like vss-revision    no-undo .
       17     define output parameter p-vss-author      like vss-author      no-undo .
       18     define output parameter p-vss-date        like vss-date        no-undo .
       19     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       20     define output parameter p-vss-archive     like vss-archive     no-undo .
       21     define output parameter p-vss-description like vss-description no-undo .
       22     assign
       23       p-vss-revision    = vss-revision
       24       p-vss-author      = vss-author
       25       p-vss-date        = vss-date
       26       p-vss-workfile    = vss-workfile
       27       p-vss-archive     = vss-archive
       28       p-vss-description = vss-description
       29     .
       30   end procedure.
       31   procedure vss-get-parameters :
       32     define output parameter p-vss-parameters as character no-undo .
       33   end procedure.
       34   define new global shared variable g#vssrevis-logger as handle    no-undo .
       35   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       36   define variable v-vssrevis-logger                   as handle    no-undo .
       37   procedure vss-logevent :
       38     define input  parameter p-extra-paramters as character no-undo .
       39     define variable v-vssrevis-parameters as character no-undo .
       40     do
       41     on error undo, return error return-value
       42     :
       43       if  valid-handle(v-vssrevis-logger)
       44       and v-vssrevis-logger :get-signature("logevent") <> ""
       45       then do:
       46         run vss-get-parameters in this-procedure
       47           (output v-vssrevis-parameters
       48           ).
       49         run logevent in v-vssrevis-logger
       50           (input vss-workfile
       51           ,input vss-revision
       52           ,input v-vssrevis-parameters
       53           ,input p-extra-paramters
       54           ).
       55       end.
       56     end.
       57   end procedure.
       58   assign
       59     v-vssrevis-logger = g#vssrevis-logger
       60   .
       61   if  valid-handle(v-vssrevis-logger)
       62   and v-vssrevis-logger :get-signature("logevent") <> ""
       63   then do:
       64     assign
       65       v-vssrevis-logevent = true
       66     .
       67     run vss-logevent in this-procedure (input vss-description) .
       68   end.
       69   define new global shared variable g#language as character no-undo .
       70   if g#language <> '' and g#language <> 'rus':U then do:
       71     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       72   end.
       73   define new global shared variable g#library  as handle no-undo .
       74   define new global shared variable g#library2 as handle no-undo .
       75   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       76   procedure cur-time :
       77      define output parameter p-today as date      no-undo .
       78      define output parameter p-time  as integer   no-undo .
       79     do
       80     on error undo, return error
       81     :
       82       define variable v-date1 as date      no-undo .
       83       define variable v-date2 as date      no-undo .
       84       define variable v-time  as integer   no-undo .
       85       assign
       86         v-date1 = today
       87         v-time  = time
       88         v-date2 = today
       89       .
       90       if v-date1 <> v-date2
       91       then do:
       92         assign
       93           v-date1 = today
       94           v-time  = v-time
       95         .
       96       end.
       97       assign
       98         p-today = v-date1
       99         p-time  = v-time
      100       .
      101     end.
      102   end.
      103   function cur-time-date returns character
      104   :
      105     return string(today, '99/99/9999':U) .
      106   end.
      107   function cur-time-mjd returns decimal
      108   :
      109     define variable v-date as date      no-undo .
      110     define variable v-time as integer   no-undo .
      111     run cur-time in this-procedure
      112       (output v-date
      113       ,output v-time
      114       ) .
      115     return integer(v-date) - 2400002 + (v-time / 86400) .
      116   end.
      117   function cur-time-get-ending-index returns integer
      118   (input p-number as integer
      119   )
      120   :
      121     if p-number < 0
      122     or p-number = ?
      123     then do:
      124       return 1 .
      125     end.
      126     define variable v-rest as integer   no-undo .
      127     assign
      128       p-number = p-number modulo 100
      129     .
      130     if p-number < 20
      131     then do:
      132       assign
      133         v-rest = p-number
      134       .
      135     end.
      136     else do:
      137       assign
      138         v-rest = p-number modulo 10
      139       .
      140     end.
      141     case v-rest :
      142       when 1
      143       then do:
      144         return 2 .
      145       end.
      146       when 2 or
      147       when 3 or
      148       when 4
      149       then do:
      150         return 3 .
      151       end.
      152       otherwise do:
      153         return 1 .
      154       end.
      155     end case .
      156   end.
      157   procedure cur-time-mjd-to-date :
      158      define input  parameter i-mjd-diff as decimal no-undo.
      159      define output parameter o-Date     as date    no-undo.
      160      define output parameter o-Time     as integer no-undo.
      161      define variable v-day-number as integer   no-undo .
      162      if    i-mjd-diff < 0
      163         or i-mjd-diff = ?
      164      then do:
      165         return "?" .
      166      end.
      167      assign
      168         v-day-number = truncate(i-mjd-diff,0).
      169         o-Date = date(v-day-number + 2400002).
      170         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      171     .
      172   end.
      173   function cur-time-mjd-to-string returns character
      174   (input p-mjd-diff as decimal
      175   )
      176   :
      177     define variable v-day-number as integer   no-undo .
      178     define variable v-seconds    as integer   no-undo .
      179     define variable v-hour       as integer   no-undo .
      180     define variable v-min        as integer   no-undo .
      181     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      182     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      183     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      184     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      185     if p-mjd-diff < 0
      186     or p-mjd-diff = ?
      187     then do:
      188       return "?" .
      189     end.
      190     assign
      191       v-day-number = integer(truncate(p-mjd-diff,0))
      192       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      193     .
      194     if v-seconds > 86400
      195     then do:
      196       assign
      197         v-seconds = 86400 - 1
      198       .
      199     end.
      200     if v-seconds < 0
      201     then do:
      202       assign
      203         v-seconds = 0
      204       .
      205     end.
      206     assign
      207       v-hour = truncate(v-seconds / 3600, 0)
      208     .
      209     assign
      210       v-seconds = v-seconds modulo 3600
      211     .
      212     assign
      213       v-min = truncate(v-seconds / 60, 0)
      214     .
      215     assign
      216       v-seconds = v-seconds modulo 60
      217     .
      218     return
      219         (if v-day-number <> 0
      220           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      221           else ""
      222         )
      223       + (if v-day-number <> 0 or v-hour <> 0
      224           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      225           else ""
      226         )
      227       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      228           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      229           else ""
      230         )
      231       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      232       .
      233   end.
      234   function cur-time-string returns character
      235   :
      236     define variable v-date as date      no-undo .
      237     define variable v-time as integer   no-undo .
      238     run cur-time in this-procedure
      239       (output v-date
      240       ,output v-time
      241       ) .
      242     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      243   end.
      244   function cur-time-string-sec returns character
      245   :
      246     define variable v-date as date      no-undo .
      247     define variable v-time as integer   no-undo .
      248     run cur-time in this-procedure
      249       (output v-date
      250       ,output v-time
      251       ) .
      252     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      253   end.
      254   function cur-time-custom  returns character
      255   (input p-prefix as character
      256   ,input p-date-format as character
      257   ,input p-delimiter as character
      258   ,input p-time-format as character
      259   ,input p-suffix as character
      260   )
      261   :
      262     define variable v-date as date      no-undo .
      263     define variable v-time as integer   no-undo .
      264     run cur-time in this-procedure
      265       (output v-date
      266       ,output v-time
      267       ) .
      268     return
      269       p-prefix
      270       + string(v-date, p-date-format)
      271       + p-delimiter
      272       + string(v-time, p-time-format)
      273       + p-suffix
      274       .
      275   end.
      276   function cur-time-print  returns character
      277   :
      278     define variable v-date as date      no-undo .
      279     define variable v-time as integer   no-undo .
      280     run cur-time in this-procedure
      281       (output v-date
      282       ,output v-time
      283       ) .
      284     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      285   end.
      286   function cur-time-datetime returns datetime
      287   :
      288     define variable v-char as character no-undo .
      289     define variable v-datetime as datetime no-undo .
      290     v-char = cur-time-string().
      291     v-datetime = datetime(v-char).
      292     return  v-datetime.
      293   end.
      294   function cur-time-string-msec returns character
      295   :
      296     define variable v-date as datetime  no-undo .
      297     v-date = now.
      298     return string(v-date) .
      299   end.
      300   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      301   define temp-table temp-parts no-undo   like ub.parts   field free-qnty as decimal   field free-cli-qnty as decimal .
      302   procedure partslib-clear-temp-parts :
      303     define buffer buf_temp-parts for temp-parts .
      304     do
      305     on error undo, return error
      306     :
      307       for each buf_temp-parts
      308       on error undo, return error
      309       :
      310         delete buf_temp-parts .
      311       end.
      312     end.
      313   end procedure.
      314   procedure partslib-create-temp-parts :
      315     define parameter buffer buf_parts       for ub.parts .
      316     define parameter buffer buf_temp-parts  for temp-parts .
      317     define input  parameter p-goods-twounit as logical   no-undo .
      318     define variable v-base-part-code as character no-undo .
      319     do
      320     on error undo, return error
      321     :
      322       if p-goods-twounit = true
      323       then do:
      324         assign
      325           v-base-part-code = entry(1, buf_parts.part-code, '#':U)
      326         .
      327       end.
      328       else do:
      329         assign
      330           v-base-part-code = buf_parts.part-code
      331         .
      332       end.
      333       find first buf_temp-parts exclusive-lock
      334         where buf_temp-parts.obj-type  = buf_parts.obj-type
      335           and buf_temp-parts.obj-code  = buf_parts.obj-code
      336           and buf_temp-parts.artic     = buf_parts.artic
      337           and buf_temp-parts.prod-type = buf_parts.prod-type
      338           and buf_temp-parts.prod-code = buf_parts.prod-code
      339           and buf_temp-parts.in-code   = buf_parts.in-code
      340           and buf_temp-parts.out-code  = 'free-zone':U
      341           and buf_temp-parts.part-code = v-base-part-code
      342         no-error.
      343       if not available buf_temp-parts
      344       then do:
      345         create buf_temp-parts .
      346         buffer-copy buf_parts to buf_temp-parts
      347         assign
      348           buf_temp-parts.out-code  = 'free-zone':U
      349           buf_temp-parts.part-code = v-base-part-code
      350           buf_temp-parts.rsrv-free = yes
      351           buf_temp-parts.status_   = no
      352           buf_temp-parts.qnty      = 0
      353           buf_temp-parts.fact-qnty = 0
      354           buf_temp-parts.real-qnty = 0
      355           buf_temp-parts.cli-qnty  = 0
      356         .
      357       end.
      358     end.
      359   end procedure.
      360   procedure partslib-init-temp-parts :
      361     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
      362     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
      363     define input parameter p-artic           like ub.parts.artic     no-undo .
      364     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
      365     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
      366     define buffer buf_parts      for ub.parts .
      367     define buffer buf_temp-parts for temp-parts .
      368     define variable v-goods-twounit    as logical   no-undo .
      369     do
      370     on error undo, return error
      371     :
      372   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      373   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
      374     (input  p-artic
      375     ,input  p-prod-type
      376     ,input  p-prod-code
      377     ,input  'twounit=request':u
      378     ,output v-goods-twounit
      379     ) no-error .
      380       if error-status :error
      381       then do:
      382         message
      383           vss-workfile vss-revision vss-description skip
      384           vss-include-info1 skip
      385           "Ошибка при определении атрибута товара" skip
      386           "Артикул" p-artic p-prod-type p-prod-code skip
      387           "twounit=request" skip
      388           error-status :get-message(1) skip
      389           return-value skip
      390           view-as alert-box error .
      391         undo, return error return-value .
      392       end.
      393       run partslib-clear-temp-parts in this-procedure .
      394       for each buf_parts
      395         where buf_parts.obj-type  = p-obj-type
      396           and buf_parts.obj-code  = p-obj-code
      397           and buf_parts.artic     = p-artic
      398           and buf_parts.prod-type = p-prod-type
      399           and buf_parts.prod-code = p-prod-code
      400           and buf_parts.rsrv-free = yes
      401           and buf_parts.status_   = no
      402           and buf_parts.in-code   <> buf_parts.out-code
      403       on error undo, return error
      404       :
      405         run partslib-create-temp-parts in this-procedure
      406           (buffer buf_parts
      407           ,buffer buf_temp-parts
      408           ,input  v-goods-twounit
      409           ) .
      410         define variable v-parts-qnty          as decimal   no-undo .
      411         define variable v-parts-cli-qnty      as decimal   no-undo .
      412         define variable v-parts-free-qnty     as decimal   no-undo .
      413         define variable v-parts-free-cli-qnty as decimal   no-undo .
      414         if buf_parts.out-code = 'free-zone':U
      415         then do:
      416           assign
      417             v-parts-qnty          = buf_parts.qnty
      418             v-parts-cli-qnty      = buf_parts.cli-qnty
      419             v-parts-free-qnty     = buf_parts.qnty
      420             v-parts-free-cli-qnty = buf_parts.cli-qnty
      421           .
      422         end.
      423         else do:
      424           assign
      425             v-parts-qnty          = abs(buf_parts.qnty)
      426             v-parts-cli-qnty      = abs(buf_parts.cli-qnty)
      427             v-parts-free-qnty     = 0
      428             v-parts-free-cli-qnty = 0
      429           .
      430         end.
      431         assign
      432           buf_temp-parts.qnty          = buf_temp-parts.qnty          + v-parts-qnty
      433           buf_temp-parts.fact-qnty     = buf_temp-parts.fact-qnty     + v-parts-qnty
      434           buf_temp-parts.real-qnty     = 0
      435           buf_temp-parts.cli-qnty      = buf_temp-parts.cli-qnty      + v-parts-cli-qnty
      436           buf_temp-parts.free-qnty     = buf_temp-parts.free-qnty     + v-parts-free-qnty
      437           buf_temp-parts.free-cli-qnty = buf_temp-parts.free-cli-qnty + v-parts-free-cli-qnty
      438         .
      439       end.
      440     end.
      441   end procedure.
      442   procedure partslib-init-temp-parts-by-factord :
      443     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
      444     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
      445     define input parameter p-artic              like ub.parts.artic     no-undo .
      446     define input parameter p-prod-type          like ub.parts.prod-type no-undo .
      447     define input parameter p-prod-code          like ub.parts.prod-code no-undo .
      448     define input parameter p-fact-order         as decimal   no-undo .
      449     define input parameter p-include-fact-order as logical   no-undo .
      450     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-factord: определение партий свободной зоны на любую дату".
      451     define buffer buf_gds-obj  for ub.gds-obj .
      452     do
      453     on error undo, return error
      454     :
      455       do transaction
      456       on error undo, return error
      457       :
      458   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      459   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
      460     (input  p-obj-type
      461     ,input  p-obj-code
      462     ,input  p-artic
      463     ,input  p-prod-type
      464     ,input  p-prod-code
      465     ,buffer buf_gds-obj
      466     ) no-error .
      467         if error-status :error
      468         then do:
      469           message
      470             vss-workfile vss-revision vss-description skip
      471             vss-include-info1 skip
      472             "Невозможно найти товар на объекте" skip
      473             "Объект" p-obj-type p-obj-code skip
      474             "Артикул" p-artic p-prod-type p-prod-code skip
      475             error-status :get-message(1) skip
      476             return-value skip
      477             view-as alert-box error .
      478           undo, return error .
      479         end.
      480         find current buf_gds-obj exclusive-lock .
      481       end.
      482       run partslib-init-temp-parts in this-procedure
      483         (input p-obj-type
      484         ,input p-obj-code
      485         ,input p-artic
      486         ,input p-prod-type
      487         ,input p-prod-code
      488         ) no-error .
      489       if error-status :error
      490       then do:
      491         message
      492           vss-workfile vss-revision vss-description skip
      493           vss-include-info1 skip
      494           "Ошибка при инициализации текущего остатка по партиям свободной зоны" skip
      495           "Объект" p-obj-type p-obj-code skip
      496           "Артикул" p-artic p-prod-type p-prod-code skip
      497           "p-fact-order" p-fact-order skip
      498           view-as alert-box error .
      499         undo, return error .
      500       end.
      501       if p-include-fact-order = true
      502       then do:
      503         assign
      504           p-fact-order = p-fact-order - 0.0000000001
      505         .
      506       end.
      507       define variable v-max-fact-order as character no-undo .
      508       run factord-max-fact-order in this-procedure
      509         (output v-max-fact-order
      510         ) no-error .
      511       if error-status :error
      512       then do:
      513         message
      514           vss-workfile vss-revision vss-description skip
      515           vss-include-info1 skip
      516           "Ошибка при вызове процедуры factord-max-fact-order" skip
      517           "Объект" p-obj-type p-obj-code skip
      518           "Артикул" p-artic p-prod-type p-prod-code skip
      519           "p-fact-order" p-fact-order skip
      520           view-as alert-box error .
      521         undo, return error .
      522       end.
      523       run partslib-update-by-factord in this-procedure
      524         (input p-obj-type
      525         ,input p-obj-code
      526         ,input p-artic
      527         ,input p-prod-type
      528         ,input p-prod-code
      529         ,input p-fact-order
      530         ,input v-max-fact-order
      531         ,input false
      532         ) no-error .
      533       if error-status :error
      534       then do:
      535         message
      536           vss-workfile vss-revision vss-description skip
      537           vss-include-info1 skip
      538           "Ошибка при вызове процедуры partslib-update-by-factord" skip
      539           "Объект" p-obj-type p-obj-code skip
      540           "Артикул" p-artic p-prod-type p-prod-code skip
      541           "p-fact-order" p-fact-order skip
      542           "v-max-fact-order" v-max-fact-order skip
      543           view-as alert-box error .
      544         undo, return error .
      545       end.
      546     end.
      547   end procedure.
      548   procedure partslib-update-by-factord :
      549     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
      550     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
      551     define input parameter p-artic              like ub.parts.artic     no-undo .
      552     define input parameter p-prod-type          like ub.parts.prod-type no-undo .
      553     define input parameter p-prod-code          like ub.parts.prod-code no-undo .
      554     define input parameter p-start-fact-order   as decimal   no-undo .
      555     define input parameter p-end-fact-order     as decimal   no-undo .
      556     define input parameter p-lock-gds-obj       as logical   no-undo .
      557     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-factord: определение партий свободной зоны на любую дату".
      558     define buffer buf_gds-obj  for ub.gds-obj .
      559     define buffer buf_doc-line for ub.doc-line .
      560     define variable v-total-parts-qnty as decimal   no-undo .
      561     define variable v-goods-gds-goods  as logical   no-undo .
      562     define variable v-goods-twounit    as logical   no-undo .
      563     do
      564     on error undo, return error
      565     :
      566       if p-start-fact-order > p-end-fact-order
      567       then do:
      568         message
      569           vss-workfile vss-revision vss-description skip
      570           vss-include-info1 skip
      571           "Ошибка задания входных параметров" skip
      572           "Начало интервала превышает конец интервала" skip
      573           "Объект" p-obj-type p-obj-code skip
      574           "Артикул" p-artic p-prod-type p-prod-code skip
      575           "p-start-fact-order" p-start-fact-order skip
      576           "p-end-fact-order"   p-end-fact-order skip
      577           view-as alert-box error .
      578         undo, return error .
      579       end.
      580       if p-lock-gds-obj = true
      581       then do:
      582         do transaction
      583         on error undo, return error
      584         :
      585   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      586   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
      587     (input  p-obj-type
      588     ,input  p-obj-code
      589     ,input  p-artic
      590     ,input  p-prod-type
      591     ,input  p-prod-code
      592     ,buffer buf_gds-obj
      593     ) no-error .
      594           if error-status :error
      595           then do:
      596             message
      597               vss-workfile vss-revision vss-description skip
      598               vss-include-info1 skip
      599               "Невозможно найти gds-obj" skip
      600               error-status :get-message(1) skip
      601               return-value skip
      602               view-as alert-box error .
      603             undo, return error .
      604           end.
      605           find current buf_gds-obj exclusive-lock .
      606         end.
      607       end.
      608   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      609   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
      610     (input  p-artic
      611     ,input  p-prod-type
      612     ,input  p-prod-code
      613     ,input  'gds-goods=request':u
      614     ,output v-goods-gds-goods
      615     ) no-error .
      616       if error-status :error
      617       then do:
      618         message
      619           vss-workfile vss-revision vss-description skip
      620           vss-include-info1 skip
      621           "Ошибка при определении атрибута товара" skip
      622           "Артикул" p-artic p-prod-type p-prod-code skip
      623           "gds-goods=request" skip
      624           error-status :get-message(1) skip
      625           return-value skip
      626           view-as alert-box error .
      627         undo, return error return-value .
      628       end.
      629   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      630   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
      631     (input  p-artic
      632     ,input  p-prod-type
      633     ,input  p-prod-code
      634     ,input  'twounit=request':u
      635     ,output v-goods-twounit
      636     ) no-error .
      637       if error-status :error
      638       then do:
      639         message
      640           vss-workfile vss-revision vss-description skip
      641           vss-include-info1 skip
      642           "Ошибка при определении атрибута товара" skip
      643           "Артикул" p-artic p-prod-type p-prod-code skip
      644           "twounit=request" skip
      645           error-status :get-message(1) skip
      646           return-value skip
      647           view-as alert-box error .
      648         undo, return error return-value .
      649       end.
      650       for each buf_doc-line no-lock
      651         where buf_doc-line.obj-type   = p-obj-type
      652           and buf_doc-line.obj-code   = p-obj-code
      653           and buf_doc-line.artic      = p-artic
      654           and buf_doc-line.prod-type  = p-prod-type
      655           and buf_doc-line.prod-code  = p-prod-code
      656           and buf_doc-line.status_    = 'факт':U
      657           and buf_doc-line.fact-order > p-start-fact-order
      658           and buf_doc-line.fact-order <= p-end-fact-order
      659       on error undo, return error
      660       :
      661         run partslib-process-document in this-procedure
      662           (input  buf_doc-line.doc-code
      663           ,input  p-obj-type
      664           ,input  p-obj-code
      665           ,input  p-artic
      666           ,input  p-prod-type
      667           ,input  p-prod-code
      668           ,input  v-goods-gds-goods
      669           ,input  v-goods-twounit
      670           ,output v-total-parts-qnty
      671           ) no-error .
      672         if error-status :error
      673         then do:
      674           message
      675             vss-workfile vss-revision vss-description skip
      676             vss-include-info1 skip
      677             "Ошибка при вызове процедуры partslib-process-document" skip
      678             "Документ" buf_doc-line.doc-code skip
      679             "Объект" p-obj-type p-obj-code skip
      680             "Артикул" p-artic p-prod-type p-prod-code skip
      681             "p-start-fact-order" p-start-fact-order skip
      682             "p-end-fact-order" p-end-fact-order skip
      683             error-status :get-message(1) skip
      684             return-value skip
      685             view-as alert-box error .
      686           undo, return error return-value .
      687         end.
      688       end.
      689     end.
      690   end procedure.
      691   procedure partslib-process-document :
      692     define input  parameter p-doc-code         as character no-undo .
      693     define input  parameter p-obj-type         as character no-undo .
      694     define input  parameter p-obj-code         as integer   no-undo .
      695     define input  parameter p-artic            as character no-undo .
      696     define input  parameter p-prod-type        as character no-undo .
      697     define input  parameter p-prod-code        as integer   no-undo .
      698     define input  parameter p-goods-gds-goods  as logical   no-undo .
      699     define input  parameter p-goods-twounit    as logical   no-undo .
      700     define output parameter p-total-parts-qnty as decimal   no-undo .
      701     define variable v-parts-sign as integer   no-undo .
      702     define buffer buf_trn-doc    for ub.trn-doc .
      703     define buffer buf_doc-line   for ub.doc-line .
      704     define buffer buf_parts      for ub.parts .
      705     define buffer buf_temp-parts for temp-parts .
      706     do
      707     on error undo, return error return-value
      708     :
      709       find first buf_trn-doc no-lock
      710         where buf_trn-doc.doc-code = p-doc-code
      711         no-error .
      712       if not available buf_trn-doc
      713       then do:
      714         undo, return error substitute("Ошибка при поиске документа. Документ &1"
      715                                      ,p-doc-code
      716                                      ) .
      717       end.
      718       case buf_trn-doc.doc-type
      719       :
      720         when 'при':U or
      721         when 'возврат':U or
      722         when 'инв':U
      723         then do:
      724           assign
      725             v-parts-sign = -1
      726           .
      727         end.
      728         when 'рас':U or
      729         when 'спи':U
      730         then do:
      731           assign
      732             v-parts-sign = 1
      733           .
      734         end.
      735         otherwise do:
      736           undo, return error substitute("Неизвестный тип документа &1"
      737                                       ,buf_trn-doc.doc-type
      738                                       ) .
      739         end.
      740       end.
      741       find first buf_doc-line no-lock
      742         where buf_doc-line.doc-code  = p-doc-code
      743           and buf_doc-line.artic     = p-artic
      744           and buf_doc-line.prod-type = p-prod-type
      745           and buf_doc-line.prod-code = p-prod-code
      746         no-error .
      747       if not available buf_doc-line
      748       then do:
      749         undo, return error substitute("Ошибка при поиске строки документа. Документ &1. Артикул &2 &3 &4"
      750                                      ,p-doc-code
      751                                      ,artic
      752                                      ,prod-type
      753                                      ,prod-code
      754                                      ) .
      755       end.
      756       assign
      757         p-total-parts-qnty = 0
      758       .
      759       if p-goods-gds-goods = true
      760       then do:
      761         for each buf_parts no-lock
      762           where buf_parts.out-code  = p-doc-code
      763             and buf_parts.obj-type  = p-obj-type
      764             and buf_parts.obj-code  = p-obj-code
      765             and buf_parts.artic     = p-artic
      766             and buf_parts.prod-type = p-prod-type
      767             and buf_parts.prod-code = p-prod-code
      768         on error undo, return error
      769         :
      770           run partslib-create-temp-parts in this-procedure
      771             (buffer buf_parts
      772             ,buffer buf_temp-parts
      773             ,input  p-goods-twounit
      774             ) .
      775           assign
      776             p-total-parts-qnty        = p-total-parts-qnty
      777                                       + v-parts-sign * buf_parts.fact-qnty
      778             buf_temp-parts.qnty       = buf_temp-parts.qnty
      779                                       + v-parts-sign * buf_parts.fact-qnty
      780             buf_temp-parts.fact-qnty  = buf_temp-parts.fact-qnty
      781                                       + v-parts-sign * buf_parts.fact-qnty
      782             buf_temp-parts.cli-qnty   = buf_temp-parts.cli-qnty
      783                                       + v-parts-sign * buf_parts.cli-qnty
      784           .
      785           if buf_temp-parts.qnty = 0
      786           then do:
      787             delete buf_temp-parts .
      788           end.
      789         end.
      790       end.
      791       else do:
      792         assign
      793           p-total-parts-qnty = p-total-parts-qnty
      794                              + v-parts-sign * buf_doc-line.fact-qnty
      795         .
      796       end.
      797     end.
      798   end procedure.
      799   procedure partslib-init-temp-parts-by-date :
      800     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
      801     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
      802     define input parameter p-artic           like ub.parts.artic     no-undo .
      803     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
      804     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
      805     define input parameter p-fact-date       as date      no-undo .
      806     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-date: определение партий свободной зоны на любую дату".
      807     do
      808     on error undo, return error
      809     :
      810       define variable v-fact-order                as decimal   no-undo .
      811       define variable v-shift-end-fact-order      as decimal   no-undo .
      812       define variable v-day-end-fact-order        as decimal   no-undo .
      813       run factord in this-procedure
      814         (input  p-fact-date
      815         ,input  1
      816         ,input  1
      817         ,input  ?
      818         ,input  0
      819         ,input  false
      820         ,output v-fact-order
      821         ,output v-shift-end-fact-order
      822         ,output v-day-end-fact-order
      823         ) no-error .
      824       if error-status :error
      825       then do:
      826         message
      827           vss-workfile vss-revision vss-description skip
      828           vss-include-info1 skip
      829           "Ошибка при определении момента времени, на который требуется остаток" skip
      830           "Объект" p-obj-type p-obj-code skip
      831           "Артикул" p-artic p-prod-type p-prod-code skip
      832           "Дата" p-fact-date skip
      833           view-as alert-box error .
      834         undo, return error .
      835       end.
      836       run partslib-init-temp-parts-by-factord in this-procedure
      837         (input p-obj-type
      838         ,input p-obj-code
      839         ,input p-artic
      840         ,input p-prod-type
      841         ,input p-prod-code
      842         ,input v-day-end-fact-order
      843         ,input false
      844         ) no-error .
      845       if error-status :error
      846       then do:
      847         message
      848           vss-workfile vss-revision vss-description skip
      849           vss-include-info1 skip
      850           "Ошибка при вызове метода partslib-init-temp-parts-by-factord" skip
      851           "Объект" p-obj-type p-obj-code skip
      852           "Артикул" p-artic p-prod-type p-prod-code skip
      853           "Дата" p-fact-date skip
      854           view-as alert-box error .
      855         undo, return error .
      856       end.
      857     end.
      858   end procedure.
      859   procedure partslib-calc-cost :
      860     define output parameter p-fact-qnty      as decimal   no-undo .
      861     define output parameter p-vat-pc         as decimal   no-undo .
      862     define output parameter p-slt-pc         as decimal   no-undo .
      863     define output parameter p-sum-base       as decimal   no-undo .
      864     define output parameter p-sum-rubl       as decimal   no-undo .
      865     define output parameter p-vat-base       as decimal   no-undo .
      866     define output parameter p-vat-rubl       as decimal   no-undo .
      867     define output parameter p-slt-base       as decimal   no-undo .
      868     define output parameter p-slt-rubl       as decimal   no-undo .
      869     define output parameter p-road-tax-base  as decimal   no-undo .
      870     define output parameter p-road-tax-rubl  as decimal   no-undo .
      871     define output parameter p-transport-base as decimal   no-undo .
      872     define output parameter p-transport-rubl as decimal   no-undo .
      873     define output parameter p-other-base     as decimal   no-undo .
      874     define output parameter p-other-rubl     as decimal   no-undo .
      875     define output parameter p-excise-base    as decimal   no-undo .
      876     define output parameter p-excise-rubl    as decimal   no-undo .
      877     define variable vss-description as character no-undo init "partslib-calc-cost: расчет сумм в учетных ценах".
      878     do
      879     on error undo, return error return-value
      880     :
      881       define buffer buf_temp-parts for temp-parts .
      882       define buffer   in-vatp-trn-doc  for ub.trn-doc .
      883       define buffer   in-vatp-parts    for ub.parts   .
      884       define buffer   in-vatp-doc      for ub.trn-doc .
      885       define buffer   in-vatp-goods    for ub.goods   .
      886       define buffer   in-vatp-sysconf  for ub.sysconf .
      887       define buffer   in-vatp_doc-attr for ub.doc-attr.
      888       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
      889       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
      890       define variable varinvprb                  as   character              no-undo.
      891       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
      892       define variable cli-base-rate              as   decimal                no-undo.
      893       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
      894       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
      895       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
      896       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
      897       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
      898       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
      899       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
      900       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
      901       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
      902       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
      903       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
      904       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
      905       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
      906       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
      907       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
      908       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
      909       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
      910       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
      911       define variable other-base-loc             like ub.doc-line.price-base no-undo.
      912       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
      913       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
      914       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
      915       define variable varinvatp-envd             as   character              no-undo.
      916       define variable varinvatp-type             as   character              no-undo.
      917       for each buf_temp-parts
      918       on error undo, return error
      919       :
      920   assign
      921     price-rubl-with-tax-loc = buf_temp-parts.price-rubl
      922     price-base-with-tax-loc = buf_temp-parts.price-base
      923   .
      924   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      925   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      926     (output varinvprb
      927     )  .
      928     if buf_temp-parts.out-code = 'free-zone':U     or
      929        buf_temp-parts.out-code = 'out-zone':U   or
      930        buf_temp-parts.doc-type = 'акт':U then do:
      931       assign
      932         in-vatp-have-vat-slt = yes.
      933     end.
      934     else do:
      935       find first in-vatp_doc-attr no-lock
      936         where in-vatp_doc-attr.doc-code  = buf_temp-parts.out-code
      937           and in-vatp_doc-attr.attr-code = 'envd':U
      938         no-error .
      939       if not available in-vatp_doc-attr then do:
      940         assign
      941           in-vatp-have-vat-slt = yes.
      942       end.
      943       else do:
      944            in-vatp-have-vat-slt = no.
      945       end.
      946     end.
      947     assign
      948      price-cli-with-tax-loc = buf_temp-parts.price-cli
      949      cli-base-rate          = buf_temp-parts.cli-base-rate.
      950     ASSIGN   road-tax-base-loc  = (if buf_temp-parts.road-tax-base  = ? then 0 else buf_temp-parts.road-tax-base)
      951              road-tax-rubl-loc  = (if buf_temp-parts.road-tax-rubl  = ? then 0 else buf_temp-parts.road-tax-rubl).
      952     ASSIGN  transport-base-loc = (if buf_temp-parts.transport-base = ? then 0 else buf_temp-parts.transport-base)
      953             transport-rubl-loc = (if buf_temp-parts.transport-rubl = ? then 0 else buf_temp-parts.transport-rubl)
      954             other-base-loc     = (if buf_temp-parts.other-base     = ? then 0 else buf_temp-parts.other-base)
      955             other-rubl-loc     = (if buf_temp-parts.other-rubl     = ? then 0 else buf_temp-parts.other-rubl)
      956             vat-pc-loc         = (if buf_temp-parts.vat-pc         = ? then 0 else buf_temp-parts.vat-pc)
      957             slt-pc-loc         = (if buf_temp-parts.slt-pc         = ? then 0 else buf_temp-parts.slt-pc).
      958             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
      959       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
      960     assign
      961       exch-rate-cli-loc = (buf_temp-parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if buf_temp-parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if buf_temp-parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / buf_temp-parts.price-cli .
      962     assign
      963       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
      964       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
      965       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
      966       transport-cli-loc  = 0
      967       other-cli-loc      = 0
      968     .
      969   ASSIGN
      970             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
      971       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
      972   .
      973         assign
      974           p-fact-qnty      = p-fact-qnty      + buf_temp-parts.fact-qnty
      975           p-vat-pc         = p-vat-pc         + vat-pc-loc
      976           p-slt-pc         = p-slt-pc         + slt-pc-loc
      977           p-sum-base       = p-sum-base       + price-base-with-tax-loc * buf_temp-parts.fact-qnty
      978           p-sum-rubl       = p-sum-rubl       + price-rubl-with-tax-loc * buf_temp-parts.fact-qnty
      979           p-vat-base       = p-vat-base       + vat-base-loc            * buf_temp-parts.fact-qnty
      980           p-vat-rubl       = p-vat-rubl       + vat-rubl-loc            * buf_temp-parts.fact-qnty
      981           p-slt-base       = p-slt-base       + slt-base-loc            * buf_temp-parts.fact-qnty
      982           p-slt-rubl       = p-slt-rubl       + slt-rubl-loc            * buf_temp-parts.fact-qnty
      983           p-road-tax-base  = p-road-tax-base  + road-tax-base-loc       * buf_temp-parts.fact-qnty
      984           p-road-tax-rubl  = p-road-tax-rubl  + road-tax-rubl-loc       * buf_temp-parts.fact-qnty
      985           p-transport-base = p-transport-base + transport-base-loc      * buf_temp-parts.fact-qnty
      986           p-transport-rubl = p-transport-rubl + transport-rubl-loc      * buf_temp-parts.fact-qnty
      987           p-other-base     = p-other-base     + other-base-loc          * buf_temp-parts.fact-qnty
      988           p-other-rubl     = p-other-rubl     + other-rubl-loc          * buf_temp-parts.fact-qnty
      989           p-excise-base    = p-excise-base    + 0
      990           p-excise-rubl    = p-excise-rubl    + 0
      991         .
      992       end.
      993       if p-fact-qnty      = ?
      994       or p-sum-base       = ?
      995       or p-sum-rubl       = ?
      996       or p-vat-base       = ?
      997       or p-vat-rubl       = ?
      998       or p-slt-base       = ?
      999       or p-slt-rubl       = ?
     1000       or p-road-tax-base  = ?
     1001       or p-road-tax-rubl  = ?
     1002       or p-transport-base = ?
     1003       or p-transport-rubl = ?
     1004       or p-other-base     = ?
     1005       or p-other-rubl     = ?
     1006       or p-excise-base    = ?
     1007       or p-excise-rubl    = ?
     1008       then do:
     1009         message
     1010           vss-workfile vss-revision vss-description skip
     1011           vss-include-info1 skip
     1012           "Программа in-vatp.i вернула неопределенные значения" skip
     1013           "p-fact-qnty"      p-fact-qnty      skip
     1014           "p-sum-base"       p-sum-base       skip
     1015           "p-sum-rubl"       p-sum-rubl       skip
     1016           "p-vat-base"       p-vat-base       skip
     1017           "p-vat-rubl"       p-vat-rubl       skip
     1018           "p-slt-base"       p-slt-base       skip
     1019           "p-slt-rubl"       p-slt-rubl       skip
     1020           "p-road-tax-base"  p-road-tax-base  skip
     1021           "p-road-tax-rubl"  p-road-tax-rubl  skip
     1022           "p-transport-base" p-transport-base skip
     1023           "p-transport-rubl" p-transport-rubl skip
     1024           "p-other-base"     p-other-base     skip
     1025           "p-other-rubl"     p-other-rubl     skip
     1026           "p-excise-base"    p-excise-base    skip
     1027           "p-excise-rubl"    p-excise-rubl    skip
     1028           view-as alert-box error .
     1029         undo, return error .
     1030       end.
     1031     end.
     1032   end procedure.
     1033   procedure fbrrest-get-free-qnty :
     1034   do
     1035   on error undo, return error
     1036   :
     1037   define input parameter p-obj-type       as character            no-undo.
     1038   define input parameter p-obj-code       as integer              no-undo.
     1039   define input parameter p-gds-code       as integer              no-undo.
     1040   define input parameter p-autofbr        as logical              no-undo.
     1041   define output parameter p-avail-qnty    as decimal              no-undo.
     1042       define variable v-req-qnty  like ub.fbr-line.fact-qnty no-undo.
     1043       define variable v-free-qnty as decimal       no-undo.
     1044       define buffer buf_goods         for ub.goods.
     1045       define buffer buf_gds-obj       for ub.gds-obj.
     1046       define buffer buf_temp-parts    for temp-parts.
     1047       find first buf_goods no-lock
     1048            where buf_goods.gds-code = p-gds-code
     1049       .
     1050       assign
     1051           p-avail-qnty = 0
     1052       .
     1053       run partslib-init-temp-parts in this-procedure (
     1054             input p-obj-type
     1055           , input p-obj-code
     1056           , input buf_goods.artic
     1057           , input buf_goods.prod-type
     1058           , input buf_goods.prod-code
     1059       ).
     1060       assign
     1061           v-free-qnty = 0
     1062       .
     1063       for each buf_temp-parts
     1064       on error undo, return error
     1065       :
     1066           if buf_temp-parts.qnty > 0
     1067           then do:
     1068               assign
     1069                   v-free-qnty = v-free-qnty + buf_temp-parts.free-qnty
     1070               .
     1071           end.
     1072       end.
     1073       assign
     1074           p-avail-qnty = ( if v-free-qnty > 0 then v-free-qnty else 0 )
     1075       .
     1076   end.
     1077   end procedure.
     1078   procedure fbrrest-get-catering-object :
     1079   do
     1080   on error undo, return error
     1081   :
     1082   define input parameter p-obj-code            as integer      no-undo.
     1083   define output parameter p-catering-obj-type  as character    no-undo.
     1084   define output parameter p-catering-obj-code  as integer      no-undo.
     1085       define buffer buf_shop              for ub.shop.
     1086       find first buf_shop no-lock
     1087            where buf_shop.obj-code = p-obj-code
     1088       .
     1089       assign
     1090           p-catering-obj-type = buf_shop.kitchen-store-type
     1091           p-catering-obj-code = buf_shop.kitchen-store-code
     1092       .
     1093   end.
     1094   end procedure.
     1095   define variable vss-include-info8 as character format "X(65)" no-undo
