     2138       define buffer buf_temp_fbrrep-goods for temp_fbrrep-goods.
     2139       for each buf_temp_fbrrep-goods
     2140       on error undo, return error
     2141       :
     2142       end.
     2143   end.
     2144   end procedure.
     2145   procedure fbrrep-fill-qnty-and-prices-gds :
     2146   do
     2147   on error undo, return error
     2148   :
     2149   define input parameter p-fbr-doc-doc-code   as character    no-undo.
     2150   define input parameter p-gds-code           as integer      no-undo.
     2151       define variable v-sign      as decimal       no-undo.
     2152       define buffer buf_fbr-line          for ub.fbr-line.
     2153       define buffer buf_goods             for ub.goods.
     2154       define buffer buf_temp_fbrrep-goods for temp_fbrrep-goods.
     2155       find first buf_goods no-lock
     2156            where buf_goods.gds-code = p-gds-code
     2157       .
     2158       find first buf_temp_fbrrep-goods
     2159            where buf_temp_fbrrep-goods.artic     = buf_goods.artic
     2160              and buf_temp_fbrrep-goods.prod-type = buf_goods.prod-type
     2161              and buf_temp_fbrrep-goods.prod-code = buf_goods.prod-code
     2162       use-index ar
     2163       no-error.
     2164       if available buf_temp_fbrrep-goods
     2165       then do:
     2166           delete buf_temp_fbrrep-goods.
     2167       end.
     2168       create buf_temp_fbrrep-goods.
     2169   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2170   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     2171     (input  buf_goods.artic
     2172     ,input  buf_goods.prod-type
     2173     ,input  buf_goods.prod-code
     2174     ,input  'gds-goods=request':u
     2175     ,output buf_temp_fbrrep-goods.is-not-office
     2176     )  .
     2177       assign
     2178           buf_temp_fbrrep-goods.gds-code             = p-gds-code
     2179           buf_temp_fbrrep-goods.artic                = buf_goods.artic
     2180           buf_temp_fbrrep-goods.prod-type            = buf_goods.prod-type
     2181           buf_temp_fbrrep-goods.prod-code            = buf_goods.prod-code
     2182           buf_temp_fbrrep-goods.gds-name             = buf_goods.gds-name
     2183           buf_temp_fbrrep-goods.is-waste             = no
     2184           buf_temp_fbrrep-goods.fact-qnty            = 0
     2185           buf_temp_fbrrep-goods.write-off-rsrv-qnty  = 0
     2186           buf_temp_fbrrep-goods.write-off-qnty       = 0
     2187           buf_temp_fbrrep-goods.income-qnty          = 0
     2188           buf_temp_fbrrep-goods.income-rsrv-qnty     = 0
     2189           buf_temp_fbrrep-goods.cost-rubl            = 0
     2190           buf_temp_fbrrep-goods.cost-base            = 0
     2191           buf_temp_fbrrep-goods.sum-cost-rubl        = 0
     2192           buf_temp_fbrrep-goods.sum-cost-base        = 0
     2193           buf_temp_fbrrep-goods.vat-cost-rubl        = 0
     2194           buf_temp_fbrrep-goods.vat-cost-base        = 0
     2195           buf_temp_fbrrep-goods.sum-vat-cost-rubl    = 0
     2196           buf_temp_fbrrep-goods.sum-vat-cost-base    = 0
     2197           buf_temp_fbrrep-goods.price-sale           = 0
     2198           buf_temp_fbrrep-goods.deleted              = no
     2199       .
     2200   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2201   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run unitbase in g#library
     2202     (input  p-gds-code
     2203     ,output buf_temp_fbrrep-goods.unit-base
     2204     )  .
     2205       for each buf_fbr-line no-lock
     2206          where buf_fbr-line.prod-type = buf_goods.prod-type
     2207            and buf_fbr-line.prod-code = buf_goods.prod-code
     2208            and buf_fbr-line.artic     = buf_goods.artic
     2209            and buf_fbr-line.doc-code  = p-fbr-doc-doc-code
     2210       on error undo, return error
     2211       :
     2212           case buf_fbr-line.trn-type
     2213           :
     2214               when 'при':U
     2215               then do:
     2216                   assign
     2217                       v-sign                                          = 1
     2218                       buf_temp_fbrrep-goods.income-qnty               = buf_temp_fbrrep-goods.income-qnty                 + buf_fbr-line.fact-qnty
     2219                       buf_temp_fbrrep-goods.sum-cost-income-rubl      = buf_temp_fbrrep-goods.sum-cost-income-rubl        + ( if buf_fbr-line.price-sum-rubl <> ? then buf_fbr-line.price-sum-rubl        else 0 )
     2220                       buf_temp_fbrrep-goods.sum-cost-income-base      = buf_temp_fbrrep-goods.sum-cost-income-base        + ( if buf_fbr-line.price-sum-rubl <> ? then buf_fbr-line.price-sum-base        else 0 )
     2221                       buf_temp_fbrrep-goods.sum-vat-cost-income-rubl  = buf_temp_fbrrep-goods.sum-vat-cost-income-rubl    + ( if buf_fbr-line.price-sum-rubl <> ? then buf_fbr-line.price-sum-vat-rubl    else 0 )
     2222                       buf_temp_fbrrep-goods.sum-vat-cost-income-base  = buf_temp_fbrrep-goods.sum-vat-cost-income-base    + ( if buf_fbr-line.price-sum-rubl <> ? then buf_fbr-line.price-sum-vat-base    else 0 )
     2223                   .
     2224                   if buf_fbr-line.rsrv-qnty <> ?
     2225                   then do:
     2226                       assign
     2227                           buf_temp_fbrrep-goods.income-rsrv-qnty = buf_temp_fbrrep-goods.income-rsrv-qnty   + buf_fbr-line.rsrv-qnty
     2228                       .
     2229                   end.
     2230               end.
     2231               when 'спи':U
     2232               then do:
     2233                   assign
     2234                       v-sign                                  = -1
     2235                       buf_temp_fbrrep-goods.write-off-qnty    = buf_temp_fbrrep-goods.write-off-qnty      + buf_fbr-line.fact-qnty
     2236                       buf_temp_fbrrep-goods.sum-cost-rubl     = buf_temp_fbrrep-goods.sum-cost-rubl       + ( if buf_fbr-line.price-sum-rubl <> ? then buf_fbr-line.price-sum-rubl        else 0 )
     2237                       buf_temp_fbrrep-goods.sum-cost-base     = buf_temp_fbrrep-goods.sum-cost-base       + ( if buf_fbr-line.price-sum-rubl <> ? then buf_fbr-line.price-sum-base        else 0 )
     2238                       buf_temp_fbrrep-goods.sum-vat-cost-rubl = buf_temp_fbrrep-goods.sum-vat-cost-rubl   + ( if buf_fbr-line.price-sum-rubl <> ? then buf_fbr-line.price-sum-vat-rubl    else 0 )
     2239                       buf_temp_fbrrep-goods.sum-vat-cost-base = buf_temp_fbrrep-goods.sum-vat-cost-base   + ( if buf_fbr-line.price-sum-rubl <> ? then buf_fbr-line.price-sum-vat-base    else 0 )
     2240                   .
     2241                   if buf_fbr-line.rsrv-qnty <> ?
     2242                   then do:
     2243                       assign
     2244                           buf_temp_fbrrep-goods.write-off-rsrv-qnty           = buf_temp_fbrrep-goods.write-off-rsrv-qnty           + buf_fbr-line.rsrv-qnty
     2245                           buf_temp_fbrrep-goods.sum-write-off-rsrv-rubl       = buf_temp_fbrrep-goods.sum-write-off-rsrv-rubl       + ( if buf_fbr-line.price-sum-rubl <> ? then buf_fbr-line.price-sum-rubl        else 0 )
     2246                           buf_temp_fbrrep-goods.sum-write-off-rsrv-base       = buf_temp_fbrrep-goods.sum-write-off-rsrv-base       + ( if buf_fbr-line.price-sum-rubl <> ? then buf_fbr-line.price-sum-base        else 0 )
     2247                           buf_temp_fbrrep-goods.sum-write-off-rsrv-vat-rubl   = buf_temp_fbrrep-goods.sum-write-off-rsrv-vat-rubl   + ( if buf_fbr-line.price-sum-rubl <> ? then buf_fbr-line.price-sum-vat-rubl    else 0 )
     2248                           buf_temp_fbrrep-goods.sum-write-off-rsrv-vat-base   = buf_temp_fbrrep-goods.sum-write-off-rsrv-vat-base   + ( if buf_fbr-line.price-sum-rubl <> ? then buf_fbr-line.price-sum-vat-base    else 0 )
     2249                       .
     2250                   end.
     2251               end.
     2252           end case.
     2253           assign
     2254               buf_temp_fbrrep-goods.is-waste             = buf_fbr-line.is-waste
     2255               buf_temp_fbrrep-goods.price-sale           = buf_fbr-line.price-sale
     2256               buf_temp_fbrrep-goods.cost-income-rubl     = ( if buf_temp_fbrrep-goods.income-qnty     = 0 then 0 else buf_temp_fbrrep-goods.sum-cost-income-rubl      / buf_temp_fbrrep-goods.income-qnty    )
     2257               buf_temp_fbrrep-goods.cost-income-base     = ( if buf_temp_fbrrep-goods.income-qnty     = 0 then 0 else buf_temp_fbrrep-goods.sum-cost-income-base      / buf_temp_fbrrep-goods.income-qnty    )
     2258               buf_temp_fbrrep-goods.vat-cost-income-rubl = ( if buf_temp_fbrrep-goods.income-qnty     = 0 then 0 else buf_temp_fbrrep-goods.sum-vat-cost-income-rubl  / buf_temp_fbrrep-goods.income-qnty    )
     2259               buf_temp_fbrrep-goods.vat-cost-income-base = ( if buf_temp_fbrrep-goods.income-qnty     = 0 then 0 else buf_temp_fbrrep-goods.sum-vat-cost-income-base  / buf_temp_fbrrep-goods.income-qnty    )
     2260               buf_temp_fbrrep-goods.cost-rubl            = ( if buf_temp_fbrrep-goods.write-off-qnty  = 0 then 0 else buf_temp_fbrrep-goods.sum-cost-rubl             / buf_temp_fbrrep-goods.write-off-qnty )
     2261               buf_temp_fbrrep-goods.cost-base            = ( if buf_temp_fbrrep-goods.write-off-qnty  = 0 then 0 else buf_temp_fbrrep-goods.sum-cost-base             / buf_temp_fbrrep-goods.write-off-qnty )
     2262               buf_temp_fbrrep-goods.vat-cost-rubl        = ( if buf_temp_fbrrep-goods.write-off-qnty  = 0 then 0 else buf_temp_fbrrep-goods.sum-vat-cost-rubl         / buf_temp_fbrrep-goods.write-off-qnty )
     2263               buf_temp_fbrrep-goods.vat-cost-base        = ( if buf_temp_fbrrep-goods.write-off-qnty  = 0 then 0 else buf_temp_fbrrep-goods.sum-vat-cost-base         / buf_temp_fbrrep-goods.write-off-qnty )
     2264           .
     2265       end.
     2266       run test-temp-tables in this-procedure .
     2267   end.
     2268   end procedure.
