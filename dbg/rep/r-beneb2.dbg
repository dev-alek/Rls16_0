        5   define variable vss-revision    as character no-undo init "$Revision: f583e59b1ab4, 3461, rls $":U .
        6   define variable vss-author      as character no-undo init "$Author: VSpiridonov $":U .
        7   define variable vss-date        as character no-undo init "$Date: 2023/10/16 15:13:34 $":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile: r-beneb2.p $":U .
