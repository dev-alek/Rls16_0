      621       end.
      622     end.
      623   end procedure.
      624   procedure prn-lib-open-stream :
      625     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      626     define input parameter p-page-size    as integer no-undo .
      627     define input parameter p-is-stream    as logical no-undo .
      628     define input parameter p-append       as logical no-undo .
      629     define variable v-report-name as character no-undo .
      630     do
      631       on error undo, return error
      632       :
      633       run prn-lib-get-report-name  in this-procedure (
      634         input parParentProc
      635         ,output v-report-name
      636         ).
      637       if p-is-stream then
      638       do:
      639         if p-append then
      640         do:
      641           output stream PrnLibStream to value( v-report-name )
      642             page-size value(p-page-size) append .
      643         end.
      644         if not p-append then
      645         do:
      646           output stream PrnLibStream to value( v-report-name )
      647             page-size value(p-page-size) .
      648         end.
      649       end.
      650       if not p-is-stream then
      651       do:
      652         if p-append then
      653         do:
      654           output to value( v-report-name )
      655             page-size value(p-page-size) append .
      656         end.
      657         if not p-append then
      658         do:
      659           output to value( v-report-name )
      660             page-size value(p-page-size) .
      661         end.
      662       end.
      663     end.
      664   end procedure.
      665   procedure prn-lib-open-exp :
      666     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      667     define input parameter p-is-stream    as logical no-undo .
      668     define input parameter p-is-append    as logical no-undo .
      669     define output parameter p-ReportFileName as char init "report" no-undo.
      670     define output parameter p-process as logical no-undo .
      671     define variable glog as logical no-undo .
      672     do
      673       on error undo, return error
      674       :
      675       SYSTEM-DIALOG GET-FILE p-ReportFileName
      676         TITLE      "Укажите путь"
      677         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      678         ASK-OVERWRITE
      679         CREATE-TEST-FILE
      680         SAVE-AS
      681         USE-FILENAME
      682         DEFAULT-EXTENSION "txt"
      683         UPDATE glog
      684         .
      685       if not glog then  return.
      686       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      687       if p-is-stream then
      688       do:
      689         if p-is-append then
      690         do:
      691           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      692         end.
      693         else
      694         do:
      695           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      696         end.
      697       end.
      698       else
      699       do:
      700         if p-is-append then
      701         do:
      702           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      703         end.
      704         else
      705         do:
      706           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      707         end.
      708       end.
      709       p-process = yes.
      710     end.
      711   end procedure.
      712   procedure prn-lib-get-report-name :
      713     define input parameter parParentProc  as widget-handle no-undo.
      714     define output parameter p-report-name as character no-undo .
      715     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      716   end procedure.
      717   procedure prn-lib-reportviewer-report-name :
      718     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      719     define input parameter p-report-name-html as character no-undo .
      720     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      721   end procedure.
      722   procedure prn-lib-reportviewer :
      723     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      724     define input parameter p-report-name-html as character no-undo .
      725     define input parameter p-param        as character no-undo .
      726     define variable v-excel           as character no-undo init 'TRUE' .
      727     define variable v-value-character as character no-undo .
      728     define variable v-value-integer   as character no-undo .
      729     define variable v-value-date      as date      no-undo .
      730     define variable v-value-decimal   as decimal   no-undo .
      731     define variable rep-excel         as logical   no-undo .
      732     define variable excel-string      as character no-undo .
      733     define variable v-param-type      as character no-undo .
      734     define variable v-tth             as handle    no-undo .
      735     run adm/shattri.p (
      736       input "get":U
      737       ,input  ""
      738       ,input  0
      739       ,input  'report-glob':U
      740       ,input  'rep-excel':U
      741       ,output v-value-character
      742       ,output v-value-date
      743       ,output v-value-decimal
      744       ,output v-value-integer
      745       ,output rep-excel
      746       ,output v-param-type
      747       ,INPUT-OUTPUT table-handle v-tth
      748       )  .
      749     if rep-excel then v-excel = "TRUE" .
      750     else v-excel = "FALSE" .
      751     if p-param eq ""
      752     then
      753        p-param = "EXCEL:" + v-excel.
      754     else
      755        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      756     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      757   end procedure.
