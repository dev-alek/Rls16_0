     1297   procedure cur-time :
     1298      define output parameter p-today as date      no-undo .
     1299      define output parameter p-time  as integer   no-undo .
     1300     do
     1301     on error undo, return error
     1302     :
     1303       define variable v-date1 as date      no-undo .
     1304       define variable v-date2 as date      no-undo .
     1305       define variable v-time  as integer   no-undo .
     1306       assign
     1307         v-date1 = today
     1308         v-time  = time
     1309         v-date2 = today
     1310       .
     1311       if v-date1 <> v-date2
     1312       then do:
     1313         assign
     1314           v-date1 = today
     1315           v-time  = v-time
     1316         .
     1317       end.
     1318       assign
     1319         p-today = v-date1
     1320         p-time  = v-time
     1321       .
     1322     end.
     1323   end.
     1324   function cur-time-date returns character
     1325   :
     1326     return string(today, '99/99/9999':U) .
     1327   end.
     1328   function cur-time-mjd returns decimal
     1329   :
     1330     define variable v-date as date      no-undo .
     1331     define variable v-time as integer   no-undo .
     1332     run cur-time in this-procedure
     1333       (output v-date
     1334       ,output v-time
     1335       ) .
     1336     return integer(v-date) - 2400002 + (v-time / 86400) .
     1337   end.
     1338   function cur-time-get-ending-index returns integer
     1339   (input p-number as integer
     1340   )
     1341   :
     1342     if p-number < 0
     1343     or p-number = ?
     1344     then do:
     1345       return 1 .
     1346     end.
     1347     define variable v-rest as integer   no-undo .
     1348     assign
     1349       p-number = p-number modulo 100
     1350     .
     1351     if p-number < 20
     1352     then do:
     1353       assign
     1354         v-rest = p-number
     1355       .
     1356     end.
     1357     else do:
     1358       assign
     1359         v-rest = p-number modulo 10
     1360       .
     1361     end.
     1362     case v-rest :
     1363       when 1
     1364       then do:
     1365         return 2 .
     1366       end.
     1367       when 2 or
     1368       when 3 or
     1369       when 4
     1370       then do:
     1371         return 3 .
     1372       end.
     1373       otherwise do:
     1374         return 1 .
     1375       end.
     1376     end case .
     1377   end.
     1378   procedure cur-time-mjd-to-date :
     1379      define input  parameter i-mjd-diff as decimal no-undo.
     1380      define output parameter o-Date     as date    no-undo.
     1381      define output parameter o-Time     as integer no-undo.
     1382      define variable v-day-number as integer   no-undo .
     1383      if    i-mjd-diff < 0
     1384         or i-mjd-diff = ?
     1385      then do:
     1386         return "?" .
     1387      end.
     1388      assign
     1389         v-day-number = truncate(i-mjd-diff,0).
     1390         o-Date = date(v-day-number + 2400002).
     1391         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     1392     .
     1393   end.
     1394   function cur-time-mjd-to-string returns character
     1395   (input p-mjd-diff as decimal
     1396   )
     1397   :
     1398     define variable v-day-number as integer   no-undo .
     1399     define variable v-seconds    as integer   no-undo .
     1400     define variable v-hour       as integer   no-undo .
     1401     define variable v-min        as integer   no-undo .
     1402     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     1403     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     1404     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     1405     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1406     if p-mjd-diff < 0
     1407     or p-mjd-diff = ?
     1408     then do:
     1409       return "?" .
     1410     end.
     1411     assign
     1412       v-day-number = integer(truncate(p-mjd-diff,0))
     1413       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1414     .
     1415     if v-seconds > 86400
     1416     then do:
     1417       assign
     1418         v-seconds = 86400 - 1
     1419       .
     1420     end.
     1421     if v-seconds < 0
     1422     then do:
     1423       assign
     1424         v-seconds = 0
     1425       .
     1426     end.
     1427     assign
     1428       v-hour = truncate(v-seconds / 3600, 0)
     1429     .
     1430     assign
     1431       v-seconds = v-seconds modulo 3600
     1432     .
     1433     assign
     1434       v-min = truncate(v-seconds / 60, 0)
     1435     .
     1436     assign
     1437       v-seconds = v-seconds modulo 60
     1438     .
     1439     return
     1440         (if v-day-number <> 0
     1441           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1442           else ""
     1443         )
     1444       + (if v-day-number <> 0 or v-hour <> 0
     1445           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1446           else ""
     1447         )
     1448       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1449           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1450           else ""
     1451         )
     1452       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1453       .
     1454   end.
     1455   function cur-time-string returns character
     1456   :
     1457     define variable v-date as date      no-undo .
     1458     define variable v-time as integer   no-undo .
     1459     run cur-time in this-procedure
     1460       (output v-date
     1461       ,output v-time
     1462       ) .
     1463     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1464   end.
     1465   function cur-time-string-sec returns character
     1466   :
     1467     define variable v-date as date      no-undo .
     1468     define variable v-time as integer   no-undo .
     1469     run cur-time in this-procedure
     1470       (output v-date
     1471       ,output v-time
     1472       ) .
     1473     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1474   end.
     1475   function cur-time-custom  returns character
     1476   (input p-prefix as character
     1477   ,input p-date-format as character
     1478   ,input p-delimiter as character
     1479   ,input p-time-format as character
     1480   ,input p-suffix as character
     1481   )
     1482   :
     1483     define variable v-date as date      no-undo .
     1484     define variable v-time as integer   no-undo .
     1485     run cur-time in this-procedure
     1486       (output v-date
     1487       ,output v-time
     1488       ) .
     1489     return
     1490       p-prefix
     1491       + string(v-date, p-date-format)
     1492       + p-delimiter
     1493       + string(v-time, p-time-format)
     1494       + p-suffix
     1495       .
     1496   end.
     1497   function cur-time-print  returns character
     1498   :
     1499     define variable v-date as date      no-undo .
     1500     define variable v-time as integer   no-undo .
     1501     run cur-time in this-procedure
     1502       (output v-date
     1503       ,output v-time
     1504       ) .
     1505     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1506   end.
     1507   function cur-time-datetime returns datetime
     1508   :
     1509     define variable v-char as character no-undo .
     1510     define variable v-datetime as datetime no-undo .
     1511     v-char = cur-time-string().
     1512     v-datetime = datetime(v-char).
     1513     return  v-datetime.
     1514   end.
     1515   function cur-time-string-msec returns character
     1516   :
     1517     define variable v-date as datetime  no-undo .
     1518     v-date = now.
     1519     return string(v-date) .
     1520   end.
     1521   function fnc-convert-dot-to-colon returns character
     1522       (input p-data as decimal, input p-accur as character, input p-num as integer) forward.
     1523   function fnc-convert-dot-to-colon returns character
     1524   (input p-data as decimal, input p-accur as character, input p-num as integer):
     1525       define variable result as character no-undo.
     1526       define variable v-str-result as character no-undo.
     1527       if p-data = ? then p-data = 0 .
     1528       p-data = round(p-data, p-num).
     1529       v-str-result = trim(replace(string(p-data, p-accur), ".", ",")).
     1530       return v-str-result.
     1531   END FUNCTION.
     1532   function putRowAmount1 returns character private
     1533   (input p-curr-name as character
     1534   ,input p-total1    as decimal
     1535   ) :
     1536   define variable v-row-amount as character no-undo .
     1537   define variable v-curr-name  as character no-undo .
     1538     v-curr-name = if p-curr-name > "" then p-curr-name else "<br />":U .
     1539     v-row-amount = substitute (
     1540         '<td>&1</td><td num="0.00" val="&2">&2</td><td><br /></td><td><br /></td>'
     1541         , v-curr-name
     1542         , fnc-convert-dot-to-colon(p-total1, "->>>>>>>>>>>9.99", 2)
     1543     ) .
     1544     return v-row-amount .
     1545   end function .
     1546   function putRowAmount returns character private
     1547   (input p-curr-name as character
     1548   ,input p-total1    as decimal
     1549   ,input p-total2    as decimal
     1550   ,input p-total3    as decimal
     1551   ) :
     1552   define variable v-row-amount as character no-undo .
     1553   define variable v-curr-name  as character no-undo .
     1554     v-curr-name = if p-curr-name > "" then p-curr-name else "<br />":U .
     1555     v-row-amount = substitute (
     1556         '<td>&1</td><td num="0.00" val="&2">&2</td><td num="0.00" val="&3">&3</td><td num="0.00" val="&4">&4</td>'
     1557         , v-curr-name
     1558         , fnc-convert-dot-to-colon(p-total1, "->>>>>>>>>>>9.99", 2)
     1559         , fnc-convert-dot-to-colon(p-total2, "->>>>>>>>>>>9.99", 2)
     1560         , fnc-convert-dot-to-colon(p-total3, "->>>>>>>>>>>9.99", 2)
     1561     ) .
     1562     return v-row-amount .
     1563   end function .
     1564   procedure CreateBenefits2 private :
     1565   define input parameter p-obj-type  as character no-undo .
     1566   define input parameter p-obj-code  as integer no-undo .
     1567   define input parameter p-pay-code  as integer no-undo .
     1568   define input parameter p-curr-code as integer no-undo .
     1569   define input parameter p-pay-desk  as integer no-undo .
     1570   define input parameter p-sum       as decimal no-undo .
     1571   define input parameter p-base      as decimal no-undo .
     1572   define input parameter p-rubl      as decimal no-undo .
     1573   define buffer buf_benefits for benefits .
     1574   define buffer buf_cash-pay for ub.cash-pay .
     1575   define buffer buf_currency for ub.currency .
     1576     find first buf_benefits
     1577          where buf_benefits.obj-type  = p-obj-type
     1578            and buf_benefits.obj-code  = p-obj-code
     1579            and buf_benefits.pay-code  = p-pay-code
     1580            and buf_benefits.curr-code = p-curr-code
     1581     and buf_benefits.pay-desk  = p-pay-desk no-error .
     1582     if not available buf_benefits then do:
     1583       FIND FIRST buf_cash-pay NO-LOCK
     1584            WHERE buf_cash-pay.cdpay-code = p-pay-code
     1585              AND buf_cash-pay.curr-code  = p-curr-code NO-ERROR.
     1586       FIND FIRST buf_currency NO-LOCK
     1587            WHERE buf_currency.curr-code = p-curr-code NO-ERROR.
     1588       create buf_benefits.
     1589       assign
     1590         buf_benefits.pay-desk  = p-pay-desk
     1591         buf_benefits.obj-type  = p-obj-type
     1592         buf_benefits.obj-code  = p-obj-code
     1593         buf_benefits.pay-code  = p-pay-code
     1594         buf_benefits.pay-name  = if available buf_cash-pay then buf_cash-pay.obj-name  else "Неопознанная оплата"
     1595         buf_benefits.curr-code = p-curr-code
     1596         buf_benefits.curr-name = if available buf_currency then buf_currency.curr-name else "Неопознанная валюта"
     1597         buf_benefits.tot-sum   = p-sum
     1598         buf_benefits.tot-base  = p-base
     1599         buf_benefits.tot-rubl  = p-rubl
     1600       .
     1601     end .
     1602     else assign
     1603       buf_benefits.tot-sum  = buf_benefits.tot-sum  + p-sum
     1604       buf_benefits.tot-base = buf_benefits.tot-base + p-base
     1605       buf_benefits.tot-rubl = buf_benefits.tot-rubl + p-rubl
     1606     .
     1607   end procedure .
     1608   empty temp-table benefits .
     1609   empty temp-table inkas-num .
     1610   empty temp-table day_sum .
     1611   empty temp-table all-days_sum .
     1612   empty temp-table ben-chk-count .
     1613   assign
     1614   date_string = cur-time-print()
     1615   .
     1616   assign
     1617   ChkAmount = 0
     1618   ObjAmount = 0
     1619   AllDay-BaseSum = 0
     1620   AllDay-RublSum = 0
     1621     acc-count-ln = 0
     1622     acc-count-step = 0
     1623   .
     1624   FOR EACH obj-list WHERE obj-list.obj-type = 'маг':U NO-LOCK :
     1625     ACCUMULATE obj-list.obj-code ( COUNT ).
     1626     assign
     1627     acc-day-base = 0
     1628     acc-day-rubl = 0
     1629     acc-day-cnt = 0
     1630     acc-day-nf  = 0
     1631     .
     1632     CASE X-radio-Task > 1 :
     1633       WHEN YES THEN DO:
     1634         _chk-doc3:
     1635         FOR EACH chk-doc WHERE
     1636                   chk-doc.obj-type = obj-list.obj-type AND
     1637                 chk-doc.obj-code = obj-list.obj-code AND
     1638                 chk-doc.shift-date >= x-date-start AND
     1639                 chk-doc.shift-date <= x-date-end AND
     1640                 (IF cas-num > 0 then chk-doc.pay-desk = cas-num else TRUE) NO-LOCK
     1641         BREAK
     1642         by chk-doc.obj-type
     1643         by chk-doc.obj-code
     1644         by chk-doc.pay-desk :
     1645           IF FIRST-OF(chk-doc.pay-desk) then assign
     1646             acc-desk-rubl = 0
     1647             acc-desk-base = 0
     1648             acc-desk-count = 0
     1649             acc-desk-count-nf = 0
     1650           .
     1651           v-skip-line =
     1652           (
     1653                X-Radio-task = 3 AND
     1654                ((chk-doc.shift-date = x-date-start AND chk-doc.shift-num < X-shift-start) OR
     1655                 (chk-doc.shift-date = x-date-end   AND chk-doc.shift-num > X-shift-end))
     1656           ) OR (
     1657                X-radio-task = 4 AND
     1658                chk-doc.shift-num <> X-Shift-Alone
     1659           ) .
     1660           if not v-skip-line then do :
     1661             v-is-sub-count = (  lookup(string(chk-doc.chk-type), '14,15,16,36,17,8,11,12,13,40,101,106,108,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U) > 0  ).
     1662             found = false .
     1663             if v-is-sub-count then do :
     1664               for EACH chk-pay NO-LOCK
     1665                  WHERE chk-pay.doc-code = chk-doc.doc-code :
     1666                 if chk-pay.tot-sum <> 0 then do :
     1667                   found = true .
     1668                   leave .
     1669                 end .
     1670               END .
     1671             end .
     1672             else do :
     1673               for EACH chk-pay NO-LOCK
     1674                  WHERE chk-pay.doc-code = chk-doc.doc-code
     1675               BREAK
     1676               BY chk-pay.pay-code
     1677               BY chk-pay.curr-code:
     1678                 if chk-pay.tot-sum <> 0 then do :
     1679                   found = true .
     1680   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1681           acc-count-ln = acc-count-ln + 1.
     1682   if acc-count-ln > acc-count-step then do:
     1683     run waitfram-show in this-procedure ( obj-list.obj-type + string( obj-list.obj-code ) +
     1684                                     ", обработано строк чеков : " +
     1685                                     string( ACC-count-ln) ) .
     1686     acc-count-step = acc-count-ln + 96 .
     1687   end.
     1688           if FIRST-of( chk-pay.curr-code ) then assign
     1689             acc-curr-sum  = 0
     1690             acc-curr-base = 0
     1691             acc-curr-rubl = 0
     1692           .
     1693         assign
     1694             acc-curr-sum  = acc-curr-sum  + chk-pay.tot-sum
     1695             acc-curr-base = acc-curr-base + chk-pay.tot-base
     1696             acc-curr-rubl = acc-curr-rubl + chk-pay.tot-rubl
     1697             acc-desk-base = acc-desk-base + chk-pay.tot-base
     1698             acc-desk-rubl = acc-desk-rubl + chk-pay.tot-rubl
     1699         .
     1700   if last-of( chk-pay.curr-code ) then do:
     1701     run CreateBenefits2 in this-procedure
     1702     ( obj-list.obj-type
     1703     , obj-list.obj-code
     1704     , chk-pay.pay-code
     1705     , chk-pay.curr-code
     1706     , chk-doc.pay-desk
     1707     , acc-curr-sum
     1708     , acc-curr-base
     1709     , acc-curr-rubl
     1710     ) .
     1711     if not can-find (first ben-chk-count where ben-chk-count.doc-code  = chk-pay.doc-code
     1712                                            and ben-chk-count.obj-type  = obj-list.obj-type
     1713                                            and ben-chk-count.obj-code  = obj-list.obj-code
     1714                                            and ben-chk-count.pay-desk  = chk-doc.pay-desk
     1715                                            and ben-chk-count.pay-code  = chk-pay.pay-code
     1716                                            and ben-chk-count.curr-code = chk-pay.curr-code) then do:
     1717       create ben-chk-count.
     1718       assign
     1719         ben-chk-count.doc-code  = chk-pay.doc-code
     1720         ben-chk-count.obj-type  = obj-list.obj-type
     1721         ben-chk-count.obj-code  = obj-list.obj-code
     1722         ben-chk-count.pay-desk  = chk-doc.pay-desk
     1723         ben-chk-count.pay-code  = chk-pay.pay-code
     1724         ben-chk-count.curr-code = chk-pay.curr-code
     1725       .
     1726     end.
     1727   end.
     1728                 end .
     1729               END .
     1730             end .
     1731             if found then assign
     1732               acc-desk-count    = acc-desk-count    + 1
     1733               acc-desk-count-nf = acc-desk-count-nf + 1 when (v-is-sub-count)
     1734             .
     1735           end .
     1736           if last-of( chk-doc.pay-desk ) then do:
     1737             create day_sum.
     1738             assign
     1739               day_sum.obj-type = obj-list.obj-type
     1740               day_sum.obj-code = obj-list.obj-code
     1741               day_sum.pay-desk = chk-doc.pay-desk
     1742               day_sum.tot-rubl = acc-desk-rubl
     1743               day_sum.tot-base = acc-desk-base
     1744               day_sum.chk-cnt-all =  acc-desk-count
     1745               day_sum.chk-cnt-nf  =  acc-desk-count-nf
     1746             .
     1747             assign
     1748               acc-day-rubl = acc-day-rubl + day_sum.tot-rubl
     1749               acc-day-base = acc-day-base + day_sum.tot-base
     1750               acc-day-cnt  = acc-day-cnt  + day_sum.chk-cnt-all
     1751               acc-day-nf   = acc-day-nf   + day_sum.chk-cnt-nf
     1752             .
     1753           end.
     1754         END.
     1755       END.
     1756       WHEN NO THEN DO:
     1757         _chk-doc4:
     1758         FOR EACH chk-doc WHERE
     1759                     chk-doc.obj-type = obj-list.obj-type AND
     1760                   chk-doc.obj-code = obj-list.obj-code AND
     1761                   chk-doc.chk-date >= x-date-start AND
     1762                   chk-doc.chk-date <= x-date-end AND
     1763                   (IF cas-num > 0 then chk-doc.pay-desk = cas-num else TRUE) NO-LOCK
     1764           BREAK
     1765           by chk-doc.obj-type
     1766           by chk-doc.obj-code
     1767           by chk-doc.pay-desk :
     1768           IF FIRST-OF(chk-doc.pay-desk) then assign
     1769             acc-desk-rubl = 0
     1770             acc-desk-base = 0
     1771             acc-desk-count = 0
     1772             acc-desk-count-nf = 0
     1773           .
     1774           v-skip-line = false .
     1775           if not v-skip-line then do :
     1776             v-is-sub-count = (  lookup(string(chk-doc.chk-type), '14,15,16,36,17,8,11,12,13,40,101,106,108,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U) > 0  ).
     1777             found = false .
     1778             if v-is-sub-count then do :
     1779               for EACH chk-pay NO-LOCK
     1780                  WHERE chk-pay.doc-code = chk-doc.doc-code :
     1781                 if chk-pay.tot-sum <> 0 then do :
     1782                   found = true .
     1783                   leave .
     1784                 end .
     1785               END .
     1786             end .
     1787             else do :
     1788               for EACH chk-pay NO-LOCK
     1789                  WHERE chk-pay.doc-code = chk-doc.doc-code
     1790               BREAK
     1791               BY chk-pay.pay-code
     1792               BY chk-pay.curr-code:
     1793                 if chk-pay.tot-sum <> 0 then do :
     1794                   found = true .
     1795   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1796           acc-count-ln = acc-count-ln + 1.
     1797   if acc-count-ln > acc-count-step then do:
     1798     run waitfram-show in this-procedure ( obj-list.obj-type + string( obj-list.obj-code ) +
     1799                                     ", обработано строк чеков : " +
     1800                                     string( ACC-count-ln) ) .
     1801     acc-count-step = acc-count-ln + 96 .
     1802   end.
     1803           if FIRST-of( chk-pay.curr-code ) then assign
     1804             acc-curr-sum  = 0
     1805             acc-curr-base = 0
     1806             acc-curr-rubl = 0
     1807           .
     1808         assign
     1809             acc-curr-sum  = acc-curr-sum  + chk-pay.tot-sum
     1810             acc-curr-base = acc-curr-base + chk-pay.tot-base
     1811             acc-curr-rubl = acc-curr-rubl + chk-pay.tot-rubl
     1812             acc-desk-base = acc-desk-base + chk-pay.tot-base
     1813             acc-desk-rubl = acc-desk-rubl + chk-pay.tot-rubl
     1814         .
     1815   if last-of( chk-pay.curr-code ) then do:
     1816     run CreateBenefits2 in this-procedure
     1817     ( obj-list.obj-type
     1818     , obj-list.obj-code
     1819     , chk-pay.pay-code
     1820     , chk-pay.curr-code
     1821     , chk-doc.pay-desk
     1822     , acc-curr-sum
     1823     , acc-curr-base
     1824     , acc-curr-rubl
     1825     ) .
     1826     if not can-find (first ben-chk-count where ben-chk-count.doc-code  = chk-pay.doc-code
     1827                                            and ben-chk-count.obj-type  = obj-list.obj-type
     1828                                            and ben-chk-count.obj-code  = obj-list.obj-code
     1829                                            and ben-chk-count.pay-desk  = chk-doc.pay-desk
     1830                                            and ben-chk-count.pay-code  = chk-pay.pay-code
     1831                                            and ben-chk-count.curr-code = chk-pay.curr-code) then do:
     1832       create ben-chk-count.
     1833       assign
     1834         ben-chk-count.doc-code  = chk-pay.doc-code
     1835         ben-chk-count.obj-type  = obj-list.obj-type
     1836         ben-chk-count.obj-code  = obj-list.obj-code
     1837         ben-chk-count.pay-desk  = chk-doc.pay-desk
     1838         ben-chk-count.pay-code  = chk-pay.pay-code
     1839         ben-chk-count.curr-code = chk-pay.curr-code
     1840       .
     1841     end.
     1842   end.
     1843                 end .
     1844               END .
     1845             end .
     1846             if found then assign
     1847               acc-desk-count    = acc-desk-count    + 1
     1848               acc-desk-count-nf = acc-desk-count-nf + 1 when (v-is-sub-count)
     1849             .
     1850           end .
     1851           if last-of( chk-doc.pay-desk ) then do:
     1852             create day_sum.
     1853             assign
     1854               day_sum.obj-type = obj-list.obj-type
     1855               day_sum.obj-code = obj-list.obj-code
     1856               day_sum.pay-desk = chk-doc.pay-desk
     1857               day_sum.tot-rubl = acc-desk-rubl
     1858               day_sum.tot-base = acc-desk-base
     1859               day_sum.chk-cnt-all =  acc-desk-count
     1860               day_sum.chk-cnt-nf  =  acc-desk-count-nf
     1861             .
     1862             assign
     1863               acc-day-rubl = acc-day-rubl + day_sum.tot-rubl
     1864               acc-day-base = acc-day-base + day_sum.tot-base
     1865               acc-day-cnt  = acc-day-cnt  + day_sum.chk-cnt-all
     1866               acc-day-nf   = acc-day-nf   + day_sum.chk-cnt-nf
     1867             .
     1868           end.
     1869         END.
     1870       END.
     1871     END CASE.
     1872     CREATE all-days_sum .
     1873     assign
     1874       all-days_sum.obj-type = obj-list.obj-type
     1875       all-days_sum.obj-code = obj-list.obj-code
     1876       all-days_sum.tot-base = acc-day-base
     1877       all-days_sum.tot-rubl = acc-day-rubl
     1878       all-days_sum.chk-cnt-all  = acc-day-cnt
     1879       all-days_sum.chk-cnt-nf   = acc-day-nf
     1880     .
     1881     assign
     1882       AllDay-BaseSum = AllDay-BaseSum + acc-day-base
     1883       AllDay-RublSum = AllDay-RublSum + acc-day-rubl
     1884       ObjAmount      = ObjAmount + 1
     1885       ChkAmount      = ChkAmount + (all-days_sum.chk-cnt-all - all-days_sum.chk-cnt-nf)
     1886     .
     1887   END.
     1888   if not can-find (first benefits) then do:
     1889     message "Не было никакой выручки на выбранных объектах в течение заданного Вами периода времени." view-as alert-box information .
     1890     return.
     1891   end.
     1892   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1893   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1894     (output v-curr-r-b
     1895     )  .
     1896   if v-curr-r-b = 'base':U then do:
     1897   sale-price-type = base-type.
     1898   end.
     1899   else sale-price-type = "рублей".
     1900   for each benefits :
     1901     benefits.tot-r-b = if v-curr-r-b = 'base':U then benefits.tot-base else benefits.tot-rubl .
     1902   end .
     1903   for each day_sum :
     1904     day_sum.tot-r-b = if v-curr-r-b = 'base':U then day_sum.tot-base else day_sum.tot-rubl .
     1905   end .
     1906   for each all-days_sum :
     1907     all-days_sum.tot-r-b = if v-curr-r-b = 'rubl':U then all-days_sum.tot-rubl else all-days_sum.tot-base .
     1908   end .
     1909   run waitfram-hide in this-procedure .
     1910       run prn-lib-get-report-name  in this-procedure (
     1911                                                          input parParentProc
     1912                                                         ,output v-report-name
     1913                                                       ).
     1914     assign
     1915       v-file-name-rep-htm = v-report-name + ".html"
     1916       v-vsex-cas = IF cas-num = 0 then "ВСЕХ КАСС" ELSE ("КАССЫ " + string(cas-num))
     1917       v-avg-chk  = if ChkAmount > 0 then round(
     1918         (if v-curr-r-b = 'rubl':U then AllDay-RublSum else AllDay-BaseSum)  /  ChkAmount
     1919                                                , 2 ) else 0
     1920     .
     1921   do :
     1922     output stream OutStr-html to value(v-file-name-rep-htm) convert target 'UTF-8' .
     1923     put stream OutStr-html unformatted
     1924       "<!DOCTYPE HTML>" skip
     1925       '<html>' skip
     1926       '<head>' skip
     1927       '  <meta charset="utf-8">' skip
     1928       '  <style type="text/css">' skip
     1929       '      table ~{border-collapse: collapse~;~}' skip
     1930       '      tbody td, th ~{border: 1px solid black~; height: 14px~;}' skip
     1931       '      tbody td:nth-child(4), tbody td:nth-child(5), tbody td:nth-child(6) ~{text-align: right~; padding-right: 4px~;~}' skip
     1932       '      tfoot td ~{height: 14px~;}' skip
     1933       '      .sumtotal ~{text-align: right~; padding-right: 4px~;~}' skip
     1934       '  </style>' skip
     1935       '</head>' skip
     1936       '<body>' skip
     1937       '<TABLE name="1" fit_to_page="true" orientation="portrait">' skip
     1938       '<thead>' skip
     1939       '  <tr>' skip
     1940       '    <td style="width:  35px;"></td>' skip
     1941       '    <td style="width: 124px;"></td>' skip
     1942       '    <td style="width: 31px;"></td>' skip
     1943       '    <td style="width: 71px;"></td>' skip
     1944       '    <td style="width: 63px;"></td>' skip
     1945       '    <td style="width: 63px;"></td>' skip
     1946       '    <td style="width: 49px;"></td>' skip
     1947       '    <td style="width: 41px;"></td>' skip
     1948       '  </tr>' skip
     1949       '  <tr>' skip
     1950       '    <td colspan="8">' + date_string + '</td>' skip
     1951       '  </tr>' skip
     1952       '  <tr>' skip
     1953       '    <td colspan="8">ОТЧЕТ  О  ВЫРУЧКЕ ' + str1
     1954            + '<br />' + str4
     1955            + '<br />( сформирован по ВСЕМ ЧЕКАМ '
     1956            + (IF NotInc then v-vsex-cas + ", включая невошедшие в отчеты о продажах" else v-vsex-cas)
     1957            + ' )'
     1958            + '<br />'
     1959            + substitute("( всего чеков : &1, в среднем &2 &3 / чек )",  ChkAmount,  v-avg-chk,  sale-price-type  )
     1960            + '</td>' skip
     1961       '  </tr>' skip
     1962     .
     1963     put stream OutStr-html unformatted
     1964       '</thead>' skip
     1965       '<tbody>' skip
     1966       '  <tr>' skip
     1967       '    <th>Касса</th>' skip
     1968       '    <th>Вид оплаты</th>' skip
     1969       '    <th></th>' skip
     1970       '    <th>Сумма в ' (if v-curr-r-b = 'base':U then 'Б.Вал.' else 'рублях') '</th>' skip
     1971       '    <th></th>' skip
     1972       '    <th></th>' skip
     1973       '    <th>~% от суммы</th>' skip
     1974       '    <th>Кол-во фиск. чеков</th>' skip
     1975       '  </tr>' skip
     1976     .
     1977   end .
     1978   FOR EACH obj-list WHERE
     1979             obj-list.obj-type = 'маг':U ,
     1980       EACH all-days_sum WHERE
     1981             all-days_sum.obj-type = obj-list.obj-type AND
     1982             all-days_sum.obj-code = obj-list.obj-code
     1983   BREAK
     1984   BY obj-list.obj-type
     1985   BY obj-list.obj-code :
     1986     ACCUMULATE
     1987     all-days_sum.tot-base ( TOTAL )
     1988     all-days_sum.tot-rubl ( TOTAL )
     1989     all-days_sum.tot-r-b ( TOTAL )
     1990     all-days_sum.chk-cnt-all ( TOTAL )
     1991     all-days_sum.chk-cnt-nf  ( TOTAL )
     1992     obj-list.obj-code ( COUNT ) .
     1993       if first-of( obj-list.obj-code ) then do:
     1994         FIND FIRST clients WHERE
     1995                      clients.obj-type = obj-list.obj-type  AND
     1996                      clients.obj-code = obj-list.obj-code  NO-LOCK no-error .
     1997         put stream OutStr-html unformatted
     1998             '  <tr><td colspan="8">'
     1999             if available clients then clients.obj-name else '<br />'
     2000             '</td></tr>'
     2001         .
     2002       end.
     2003     FOR EACH benefits WHERE
     2004                 benefits.obj-type = obj-list.obj-type AND
     2005                 benefits.obj-code = obj-list.obj-code
     2006     BREAK
     2007     BY benefits.obj-type
     2008     BY benefits.obj-code
     2009     BY benefits.pay-desk
     2010     BY benefits.pay-code
     2011     BY benefits.curr-code :
     2012       if first-of( benefits.pay-desk ) then do:
     2013           FIND FIRST day_sum WHERE
     2014                       day_sum.obj-type = obj-list.obj-type AND
     2015                       day_sum.obj-code = obj-list.obj-code AND
     2016                       day_sum.pay-desk = benefits.pay-desk NO-ERROR.
     2017           DatePrinted = FALSE .
     2018       end.
     2019       benefits.pcnt = round( benefits.tot-r-b / day_sum.tot-r-b * 100 , 2 ) .
     2020       if benefits.tot-base  <> 0
     2021       or (day_sum.chk-cnt-all > day_sum.chk-cnt-nf)
     2022       then do:
     2023         if DatePrinted then assign
     2024           v-td-date = '<br />'
     2025         .
     2026         else assign
     2027           v-td-date   = string(benefits.pay-desk)
     2028           DatePrinted = TRUE
     2029         .
     2030         open query qben-chk-count
     2031          preselect each ben-chk-count
     2032                   where ben-chk-count.obj-type  = obj-list.obj-type
     2033                     and ben-chk-count.obj-code  = obj-list.obj-code
     2034                     and ben-chk-count.pay-desk  = benefits.pay-desk
     2035                     and ben-chk-count.pay-code  = benefits.pay-code
     2036                     and ben-chk-count.curr-code = benefits.curr-code.
     2037         v-chk-count = query qben-chk-count:num-results .
     2038         close query qben-chk-count.
     2039         put stream OutStr-html unformatted
     2040           '  <tr>'
     2041           '<td>' + v-td-date + '</td>'
     2042           '<td>' + benefits.pay-name + '</td>'
     2043           putRowAmount1 ("", benefits.tot-r-b)
     2044           substitute(  '<td num="0.00" val="&1">&1</td>',  fnc-convert-dot-to-colon(benefits.pcnt,    "->>9.99",2)  )
     2045           substitute(  '<td num="0" val="&1" class="sumtotal">&1</td>',  v-chk-count  )
     2046           '</tr>' skip
     2047         .
     2048       end.
     2049       if last-of( benefits.pay-desk ) then do:
     2050         if day_sum.chk-cnt-all > day_sum.chk-cnt-nf then do:
     2051           put stream OutStr-html unformatted
     2052             substitute(  '  <td colspan="3">средн.чек: &1</td>',
     2053               ROUND(day_sum.tot-r-b  / (day_sum.chk-cnt-all - day_sum.chk-cnt-nf) , 2)  )
     2054             substitute(  '<td num="0.00" val="&1" class="sumtotal">&1</td>',  fnc-convert-dot-to-colon(day_sum.tot-r-b,"->>>>>>>>>>>9.99",2)  )
     2055             '<td></td>'
     2056             '<td></td>'
     2057             '<td>100.00%</td>'
     2058             substitute(  '<td num="0" val="&1" class="sumtotal">&1</td>',  day_sum.chk-cnt-all - day_sum.chk-cnt-nf  )
     2059             '</tr>' skip
     2060           .
     2061         end.
     2062       end.
     2063       if last-of( benefits.obj-code ) then do:
     2064         put stream OutStr-html unformatted
     2065           '  <tr><td colspan="3">ИТОГО:</td>'
     2066           substitute(  '<td num="0.00" val="&1" class="sumtotal">&1</td>',  fnc-convert-dot-to-colon(all-days_sum.tot-r-b,"->>>>>>>>>>>9.99",2)  )
     2067           '<td></td>'
     2068           '<td></td>'
     2069           '<td></td>'
     2070           substitute(  '<td num="0" val="&1" class="sumtotal">&1</td>',  all-days_sum.chk-cnt-all - all-days_sum.chk-cnt-nf  )
     2071           '</tr>' skip
     2072         .
     2073       end.
     2074     END.
     2075     if last( obj-list.obj-code ) AND ( ACCUM COUNT obj-list.obj-code ) > 1 then do:
     2076       put stream OutStr-html unformatted
     2077         '  <tr><td colspan="3">ИТОГО по всем</td>'
     2078         substitute(  '<td num="0.00" val="&1" class="sumtotal">&1</td>',  fnc-convert-dot-to-colon(ACCUM TOTAL all-days_sum.tot-r-b,"->>>>>>>>>>>9.99",2)  )
     2079         '<td></td>'
     2080         '<td></td>'
     2081         '<td></td>'
     2082         substitute(  '<td num="0" val="&1" class="sumtotal">&1</td>',
     2083           (ACCUM TOTAL all-days_sum.chk-cnt-all) - (ACCUM TOTAL all-days_sum.chk-cnt-nf)  )
     2084         '</tr>' skip
     2085       .
     2086     end.
     2087   END.
     2088   if  ObjAmount > 1  then do:
     2089     FOR EACH benefits
     2090     BREAK
     2091     BY benefits.pay-code :
     2092       ACCUMULATE
     2093       benefits.tot-base ( SUB-TOTAL BY benefits.pay-code )
     2094       benefits.tot-rubl ( SUB-TOTAL BY benefits.pay-code )
     2095       benefits.tot-r-b  ( SUB-TOTAL BY benefits.pay-code )
     2096       .
     2097       if last-of( benefits.pay-code ) AND
     2098           ( ACCUM SUB-TOTAL BY benefits.pay-code benefits.tot-base ) <> 0 then do:
     2099         open query qben-chk-count
     2100          preselect each ben-chk-count
     2101                   where ben-chk-count.pay-code  = benefits.pay-code.
     2102         v-chk-count = query qben-chk-count:num-results .
     2103         close query qben-chk-count.
     2104         put stream OutStr-html unformatted
     2105           substitute(  '  <tr><td colspan="3">/итого по &1</td>',  benefits.pay-name  )
     2106           substitute(  '<td num="0.00" val="&1" class="sumtotal">&1</td>',  fnc-convert-dot-to-colon(ACCUM SUB-TOTAL BY benefits.pay-code benefits.tot-r-b,"->>>>>>>>>>>9.99",2)  )
     2107           '<td></td>'
     2108           '<td></td>'
     2109           '<td></td>'
     2110           substitute(  '<td num="0" val="&1" class="sumtotal">&1</td>',  v-chk-count  )
     2111           '</tr>' skip
     2112         .
     2113       end.
     2114     END.
     2115   end.
     2116   put stream OutStr-html unformatted
     2117     '</tbody>' skip
     2118     '<tfoot>' skip
     2119   .
     2120   if ( ACCUM COUNT obj-list.obj-code ) < 2 then do:
     2121     put stream OutStr-html unformatted
     2122       '  <tr><td colspan="8"><br /></td></tr>' skip
     2123       '  <tr><td colspan="4">Директор _______________</td><td colspan="4">Старший продавец ______________</td></tr>' skip
     2124       '  <tr><td colspan="8"><br /></td></tr>' skip
     2125       '  <tr><td colspan="4">Бухгалтер ______________</td><td colspan="4">Кассир ________________________</td></tr>' skip
     2126     .
     2127   end.
     2128   put stream OutStr-html unformatted
     2129     '</tfoot>' skip
     2130     '</table>' skip
     2131     '</body>' skip
     2132     '</html>' skip
     2133   .
     2134   output stream OutStr-html close.
     2135   run prn-lib-reportviewer in this-procedure (
     2136       input this-procedure
     2137       ,input v-file-name-rep-htm
     2138       ,input ""
     2139       ) no-error.
     2140   if error-status:error then
     2141   do:
     2142       message return-value view-as alert-box.
     2143       return .
     2144   end.
