     2024       define input  parameter p-fact-order    as decimal   no-undo .
     2025       define input  parameter p-type          as character no-undo .
     2026       define output parameter p-sum-exp       as decimal   no-undo .
     2027       define output parameter p-sum-inc       as decimal   no-undo .
     2028       define buffer buf_contract                    for ub.contract .
     2029       define buffer buf_arh-fin-doc-contr-schet-nal for ub.arh-fin-doc-contr-schet-nal .
     2030       for each buf_contract no-lock
     2031         where buf_contract.host-code = p-host-code-obj
     2032           and buf_contract.cli-type  = p-cli-type
     2033           and buf_contract.cli-code  = p-cli-code
     2034           and buf_contract.doc-type  = 'рас':U
     2035       :
     2036         find last buf_arh-fin-doc-contr-schet-nal no-lock
     2037           where buf_arh-fin-doc-contr-schet-nal.host-code        = p-host-code-obj
     2038             and buf_arh-fin-doc-contr-schet-nal.contract-code    = buf_contract.contract-code
     2039             and buf_arh-fin-doc-contr-schet-nal.cli-code         = p-cli-code
     2040             and buf_arh-fin-doc-contr-schet-nal.cli-type         = p-cli-type
     2041             and buf_arh-fin-doc-contr-schet-nal.fin-code-acc     = 0
     2042             and buf_arh-fin-doc-contr-schet-nal.fin-ext-doc-type = p-type
     2043             and buf_arh-fin-doc-contr-schet-nal.curr-code        = p-curr-r-b
     2044             and buf_arh-fin-doc-contr-schet-nal.calc-curr-code   = p-curr-r-b
     2045             and buf_arh-fin-doc-contr-schet-nal.sum-type         = "sum-contract"
     2046             and buf_arh-fin-doc-contr-schet-nal.fact-order       < p-fact-order
     2047         no-error .
     2048         if available buf_arh-fin-doc-contr-schet-nal then
     2049           assign
     2050             p-sum-exp = p-sum-exp + buf_arh-fin-doc-contr-schet-nal.expense
     2051             p-sum-inc = p-sum-inc + buf_arh-fin-doc-contr-schet-nal.income
     2052           .
     2053         end.
     2054       end.
     2055   end procedure.
