     2345       substitute( "Взаиморасчеты по контрагенту &1 за период с &2 по &3"
     2346                 , tt-report-head.obj-name
     2347                 , x-Date-Start
     2348                 , X-Date-end
     2349                 ) skip(1)
     2350         "------------------------------------------------------------------------------------------------":U skip
     2351         ":          Операция            :    Дата  :  Номер д-та    :       Дт        :        Кт       :":U skip
     2352         "------------------------------------------------------------------------------------------------":U
     2353     skip.
     2354   end.
     2355   end procedure.
     2356   procedure calc-fin-pri :
     2357   define input  parameter p-cli-type like ub.clients.obj-type no-undo .
     2358   define input  parameter p-cli-code like ub.clients.obj-code no-undo .
     2359   define input  parameter p-host-code-obj like ub.clients.obj-code no-undo .
     2360   do
     2361   on error undo, return error return-value
     2362   :
     2363       define buffer buf_fin-doc   for ub.fin-doc.
     2364       for each buf_fin-doc no-lock
     2365         where buf_fin-doc.host-code     = p-host-code-obj
     2366           and buf_fin-doc.status_       = 'факт':U
     2367           and buf_fin-doc.fact-order    >= v-fact-order-start
     2368           and buf_fin-doc.fact-order    <  v-fact-order-end
     2369           and buf_fin-doc.payer-type    = p-cli-type
     2370           and buf_fin-doc.payer-code    = p-cli-code
     2371       :
     2372           create tt-report.
     2373           assign
     2374             tt-report.obj-type      = p-cli-type
     2375             tt-report.obj-code      = p-cli-code
     2376             tt-report.op-type       = 1
     2377             tt-report.op-date       = buf_fin-doc.fact-date
     2378             tt-report.doc-code      = buf_fin-doc.prn-doc-code
     2379             tt-report.sum           = if v-print-rubl then buf_fin-doc.sum-rubl
     2380                                       else                 buf_fin-doc.sum-base
     2381           .
     2382       end.
     2383   end.
     2384   end procedure.
     2385   procedure calc-talon-oborot :
     2386   define input  parameter p-cli-type      like ub.clients.obj-type no-undo .
     2387   define input  parameter p-cli-code      like ub.clients.obj-code no-undo .
     2388   define input  parameter p-host-code-obj like ub.clients.obj-code no-undo .
     2389   do
     2390   on error undo, return error return-value
     2391   :
     2392     define buffer buf_wth-doc for ub.wth-doc.
     2393     for each buf_wth-doc no-lock
     2394         where buf_wth-doc.host-code =  p-host-code-obj
     2395           and buf_wth-doc.cli-type  =  p-cli-type
     2396           and buf_wth-doc.cli-code  =  p-cli-code
     2397           and buf_wth-doc.fact-date >= x-date-start
     2398           and buf_wth-doc.fact-date <= x-date-end
     2399     :
     2400       case buf_wth-doc.ext-doc-type :
     2401         when 'ee':U then do:
     2402           create tt-report.
     2403           assign
     2404             tt-report.obj-type      = p-cli-type
     2405             tt-report.obj-code      = p-cli-code
     2406             tt-report.op-type       = 2
     2407             tt-report.op-date       = buf_wth-doc.fact-date
     2408             tt-report.doc-code      = buf_wth-doc.doc-code
     2409             tt-report.sum           = - ( if v-print-rubl then buf_wth-doc.sum-gds-rubl
     2410                                           else                 buf_wth-doc.sum-gds-base
     2411                                         )
     2412           .
     2413         end.
     2414         when 'pc':U or when 'ps':U then do:
     2415         end.
     2416         when 'pz':U then do:
     2417           create tt-report.
     2418           assign
     2419             tt-report.obj-type      = p-cli-type
     2420             tt-report.obj-code      = p-cli-code
     2421             tt-report.op-type       = 3
     2422             tt-report.op-date       = buf_wth-doc.fact-date
     2423             tt-report.doc-code      = buf_wth-doc.doc-code
     2424             tt-report.sum           = if v-print-rubl then buf_wth-doc.sum-gds-rubl
     2425                                       else                 buf_wth-doc.sum-gds-base
     2426           .
     2427         end.
     2428       end case.
     2429     end.
     2430   end.
     2431   end procedure.
     2432   procedure print-cli-report :
     2433   do
     2434   on error undo, return error return-value
     2435   :
     2436     for each tt-report by tt-report.op-date :
     2437       assign
     2438         v-debet-sum   = abs(tt-report.sum)
     2439         v-credit-sum  = abs(tt-report.sum)
     2440       .
     2441       display stream out-stream
     2442         sym1
     2443         op-name(tt-report.op-type) @ tt-report.op-name
     2444         sym2
     2445         tt-report.op-date
     2446         sym3
     2447         tt-report.doc-code
     2448         sym4
     2449         v-debet-sum when tt-report.sum < 0
     2450         sym5
     2451         v-credit-sum when tt-report.sum >= 0
     2452         sym6
     2453       with frame fincl3.
     2454       down stream out-stream with frame fincl3.
     2455     end.
     2456   end.
     2457   end procedure.
     2458   function op-name returns character (p-op-type as integer):
     2459     define variable v-op-name as character no-undo .
     2460     case p-op-type :
     2461       when 1 then do:
     2462         assign
     2463           v-op-name = "Приход денег от клиента":U
     2464         .
     2465       end.
     2466       when 2 then do:
     2467         assign
     2468           v-op-name = "Отпущены талоны":U
     2469         .
     2470       end.
     2471       when 3 then do:
     2472         assign
     2473           v-op-name = "Возврат талонов":U
     2474         .
     2475       end.
     2476     end case .
     2477     return v-op-name.
     2478   end .
