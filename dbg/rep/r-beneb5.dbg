     1228   PROCEDURE no-benq.
     1229   DEFINE OUTPUT PARAMETER found as logical init no.
     1230   define buffer buf_chk-doc for ub.chk-doc.
     1231   FOR EACH obj-list WHERE
     1232           obj-list.obj-type = 'маг':U NO-LOCK :
     1233     CASE X-Radio-Task > 1 :
     1234       WHEN YES THEN DO:
     1235         FOR EACH buf_chk-doc NO-LOCK WHERE
     1236                 buf_chk-doc.obj-type = obj-list.obj-type AND
     1237                 buf_chk-doc.obj-code = obj-list.obj-code AND
     1238                 (
     1239                   buf_chk-doc.shift-date >= X-date-start AND
     1240                   buf_chk-doc.shift-date <= X-date-end)
     1241                   AND
     1242                   (IF cas-num > 0 then buf_chk-doc.pay-desk = cas-num ELSE TRUE):
     1243           IF X-Radio-Task = 3 AND
     1244           ((buf_chk-doc.shift-date = X-date-start AND buf_chk-doc.shift-num < X-shift-Start) OR
     1245             (buf_chk-doc.shift-date = X-date-end AND  buf_chk-doc.shift-num > X-shift-End) ) THEN NEXT.
     1246           IF X-Radio-Task = 4 AND
     1247           (buf_chk-doc.shift-num <> X-shift-Alone ) THEN NEXT.
     1248           found = yes.
     1249           return.
     1250         END.
     1251       END.
     1252       WHEN NO THEN DO:
     1253         FOR EACH buf_chk-doc NO-LOCK WHERE
     1254               buf_chk-doc.obj-type = obj-list.obj-type AND
     1255               buf_chk-doc.obj-code = obj-list.obj-code AND
     1256               buf_chk-doc.chk-date >= X-date-start AND
     1257               buf_chk-doc.chk-date <= X-date-end   AND
     1258               (IF cas-num > 0 then buf_chk-doc.pay-desk = cas-num ELSE TRUE):
     1259           found = yes.
     1260           return.
     1261         END.
     1262        END.
     1263      END CASE.
     1264    END.
     1265   END PROCEDURE.
     1266   PROCEDURE no-benqi.
     1267   DEFINE OUTPUT PARAMETER found as logical init no.
     1268   define buffer buf_chk-doc for ub.chk-doc.
     1269   define buffer buf_inkas for ub.inkas.
     1270   FOR EACH obj-list WHERE
     1271         obj-list.obj-type = 'маг':U NO-LOCK :
     1272     CASE X-Radio-Task > 1 :
     1273       WHEN YES THEN DO:
     1274         FOR EACH buf_chk-doc No-LOCK WHERE
     1275                 buf_chk-doc.obj-type = obj-list.obj-type AND
     1276                 buf_chk-doc.obj-code = obj-list.obj-code AND
     1277                 (
     1278                   buf_chk-doc.shift-date >= X-date-start AND
     1279                   buf_chk-doc.shift-date <= X-date-end)
     1280                   AND
     1281                   buf_Chk-doc.out-code = ? AND
     1282                   (IF cas-num > 0 then buf_chk-doc.pay-desk = cas-num ELSE TRUE):
     1283           IF X-Radio-Task = 3 AND
     1284           ((buf_chk-doc.shift-date = X-date-start AND buf_chk-doc.shift-num < X-shift-Start) OR
     1285             (buf_chk-doc.shift-date = X-date-end AND  buf_chk-doc.shift-num > X-shift-End) ) THEN NEXT.
     1286           IF X-Radio-Task = 4 AND
     1287           (buf_chk-doc.shift-num <> X-shift-Alone ) THEN NEXT.
     1288           found = yes.
     1289           return.
     1290         END.
     1291         FOR EACH buf_inkas No-LOCK WHERE
     1292                   buf_inkas.obj-type = obj-list.obj-type AND
     1293                   buf_inkas.obj-code = obj-list.obj-code AND
     1294                   (
     1295                   buf_inkas.shift-date >= X-date-start AND
     1296                   buf_inkas.shift-date <= X-date-end):
     1297           if buf_inkas.status_ = 'факт':U
     1298           or buf_inkas.status_ = 'запрос':U then next.
     1299           IF X-Radio-Task = 3 AND
     1300           ((buf_inkas.shift-date = X-date-start AND buf_inkas.shift-num < X-shift-Start) OR
     1301             (buf_inkas.shift-date = X-date-end AND  buf_inkas.shift-num > X-shift-End) ) THEN NEXT.
     1302           IF X-Radio-Task = 4 AND
     1303           (buf_inkas.shift-num <> X-shift-Alone ) THEN NEXT.
     1304           found = yes.
     1305           return.
     1306         END.
     1307       END.
     1308       WHEN NO THEN DO:
     1309         FOR EACH buf_chk-doc NO-LOCK WHERE
     1310                 buf_chk-doc.obj-type = obj-list.obj-type AND
     1311                 buf_chk-doc.obj-code = obj-list.obj-code AND
     1312                 buf_chk-doc.chk-date >= X-date-start AND
     1313                 buf_chk-doc.chk-date <= X-date-end   AND
     1314                 buf_Chk-doc.out-code = ? AND
     1315                 (IF cas-num > 0 then buf_chk-doc.pay-desk = cas-num ELSE TRUE):
     1316           found = yes.
     1317           return.
     1318         END.
     1319         FOR EACH buf_inkas NO-LOCK WHERE
     1320                 buf_inkas.obj-type = obj-list.obj-type AND
     1321                 buf_inkas.obj-code = obj-list.obj-code AND
     1322                 buf_inkas.doc-date >= X-date-start AND
     1323                 buf_inkas.doc-date <= X-date-end :
     1324           if buf_inkas.status_ = 'факт':U
     1325           or buf_inkas.status_ = 'запрос':U then next.
     1326           found = yes.
     1327           return.
     1328         END.
     1329       END.
     1330     END CASE.
     1331   END.
     1332   END PROCEDURE.
