     1467   define stream OutStr-html.
     1468   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1469   procedure cur-time :
     1470      define output parameter p-today as date      no-undo .
     1471      define output parameter p-time  as integer   no-undo .
     1472     do
     1473     on error undo, return error
     1474     :
     1475       define variable v-date1 as date      no-undo .
     1476       define variable v-date2 as date      no-undo .
     1477       define variable v-time  as integer   no-undo .
     1478       assign
     1479         v-date1 = today
     1480         v-time  = time
     1481         v-date2 = today
     1482       .
     1483       if v-date1 <> v-date2
     1484       then do:
     1485         assign
     1486           v-date1 = today
     1487           v-time  = v-time
     1488         .
     1489       end.
     1490       assign
     1491         p-today = v-date1
     1492         p-time  = v-time
     1493       .
     1494     end.
     1495   end.
     1496   function cur-time-date returns character
     1497   :
     1498     return string(today, '99/99/9999':U) .
     1499   end.
     1500   function cur-time-mjd returns decimal
     1501   :
     1502     define variable v-date as date      no-undo .
     1503     define variable v-time as integer   no-undo .
     1504     run cur-time in this-procedure
     1505       (output v-date
     1506       ,output v-time
     1507       ) .
     1508     return integer(v-date) - 2400002 + (v-time / 86400) .
     1509   end.
     1510   function cur-time-get-ending-index returns integer
     1511   (input p-number as integer
     1512   )
     1513   :
     1514     if p-number < 0
     1515     or p-number = ?
     1516     then do:
     1517       return 1 .
     1518     end.
     1519     define variable v-rest as integer   no-undo .
     1520     assign
     1521       p-number = p-number modulo 100
     1522     .
     1523     if p-number < 20
     1524     then do:
     1525       assign
     1526         v-rest = p-number
     1527       .
     1528     end.
     1529     else do:
     1530       assign
     1531         v-rest = p-number modulo 10
     1532       .
     1533     end.
     1534     case v-rest :
     1535       when 1
     1536       then do:
     1537         return 2 .
     1538       end.
     1539       when 2 or
     1540       when 3 or
     1541       when 4
     1542       then do:
     1543         return 3 .
     1544       end.
     1545       otherwise do:
     1546         return 1 .
     1547       end.
     1548     end case .
     1549   end.
     1550   procedure cur-time-mjd-to-date :
     1551      define input  parameter i-mjd-diff as decimal no-undo.
     1552      define output parameter o-Date     as date    no-undo.
     1553      define output parameter o-Time     as integer no-undo.
     1554      define variable v-day-number as integer   no-undo .
     1555      if    i-mjd-diff < 0
     1556         or i-mjd-diff = ?
     1557      then do:
     1558         return "?" .
     1559      end.
     1560      assign
     1561         v-day-number = truncate(i-mjd-diff,0).
     1562         o-Date = date(v-day-number + 2400002).
     1563         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     1564     .
     1565   end.
     1566   function cur-time-mjd-to-string returns character
     1567   (input p-mjd-diff as decimal
     1568   )
     1569   :
     1570     define variable v-day-number as integer   no-undo .
     1571     define variable v-seconds    as integer   no-undo .
     1572     define variable v-hour       as integer   no-undo .
     1573     define variable v-min        as integer   no-undo .
     1574     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     1575     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     1576     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     1577     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1578     if p-mjd-diff < 0
     1579     or p-mjd-diff = ?
     1580     then do:
     1581       return "?" .
     1582     end.
     1583     assign
     1584       v-day-number = integer(truncate(p-mjd-diff,0))
     1585       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1586     .
     1587     if v-seconds > 86400
     1588     then do:
     1589       assign
     1590         v-seconds = 86400 - 1
     1591       .
     1592     end.
     1593     if v-seconds < 0
     1594     then do:
     1595       assign
     1596         v-seconds = 0
     1597       .
     1598     end.
     1599     assign
     1600       v-hour = truncate(v-seconds / 3600, 0)
     1601     .
     1602     assign
     1603       v-seconds = v-seconds modulo 3600
     1604     .
     1605     assign
     1606       v-min = truncate(v-seconds / 60, 0)
     1607     .
     1608     assign
     1609       v-seconds = v-seconds modulo 60
     1610     .
     1611     return
     1612         (if v-day-number <> 0
     1613           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1614           else ""
     1615         )
     1616       + (if v-day-number <> 0 or v-hour <> 0
     1617           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1618           else ""
     1619         )
     1620       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1621           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1622           else ""
     1623         )
     1624       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1625       .
     1626   end.
     1627   function cur-time-string returns character
     1628   :
     1629     define variable v-date as date      no-undo .
     1630     define variable v-time as integer   no-undo .
     1631     run cur-time in this-procedure
     1632       (output v-date
     1633       ,output v-time
     1634       ) .
     1635     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1636   end.
     1637   function cur-time-string-sec returns character
     1638   :
     1639     define variable v-date as date      no-undo .
     1640     define variable v-time as integer   no-undo .
     1641     run cur-time in this-procedure
     1642       (output v-date
     1643       ,output v-time
     1644       ) .
     1645     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1646   end.
     1647   function cur-time-custom  returns character
     1648   (input p-prefix as character
     1649   ,input p-date-format as character
     1650   ,input p-delimiter as character
     1651   ,input p-time-format as character
     1652   ,input p-suffix as character
     1653   )
     1654   :
     1655     define variable v-date as date      no-undo .
     1656     define variable v-time as integer   no-undo .
     1657     run cur-time in this-procedure
     1658       (output v-date
     1659       ,output v-time
     1660       ) .
     1661     return
     1662       p-prefix
     1663       + string(v-date, p-date-format)
     1664       + p-delimiter
     1665       + string(v-time, p-time-format)
     1666       + p-suffix
     1667       .
     1668   end.
     1669   function cur-time-print  returns character
     1670   :
     1671     define variable v-date as date      no-undo .
     1672     define variable v-time as integer   no-undo .
     1673     run cur-time in this-procedure
     1674       (output v-date
     1675       ,output v-time
     1676       ) .
     1677     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1678   end.
     1679   function cur-time-datetime returns datetime
     1680   :
     1681     define variable v-char as character no-undo .
     1682     define variable v-datetime as datetime no-undo .
     1683     v-char = cur-time-string().
     1684     v-datetime = datetime(v-char).
     1685     return  v-datetime.
     1686   end.
     1687   function cur-time-string-msec returns character
     1688   :
     1689     define variable v-date as datetime  no-undo .
     1690     v-date = now.
     1691     return string(v-date) .
     1692   end.
     1693   function fnc-convert-dot-to-colon returns character
     1694       (input p-data as decimal, input p-accur as character, input p-num as integer) forward.
     1695   function fnc-convert-dot-to-colon returns character
     1696   (input p-data as decimal, input p-accur as character, input p-num as integer):
     1697       define variable result as character no-undo.
     1698       define variable v-str-result as character no-undo.
     1699       if p-data = ? then p-data = 0 .
     1700       p-data = round(p-data, p-num).
     1701       v-str-result = trim(replace(string(p-data, p-accur), ".", ",")).
     1702       return v-str-result.
     1703   END FUNCTION.
     1704   procedure grp-agregator private :
     1705   define input  parameter p-obj-code   as integer no-undo .
     1706   define input  parameter p-obj-type   as character no-undo .
     1707   define input  parameter p-pay-code   as integer no-undo .
     1708   define input  parameter p-curr-code  as integer no-undo .
     1709   define input  parameter p-upper-code as integer no-undo .
     1710   define output parameter p-tot-r-b    as decimal no-undo .
     1711   define variable v-tot-r-b as decimal no-undo .
     1712   define buffer buf_tt-grp-sum for tt-grp-sum .
     1713   define buffer buf_help-chk   for help-chk .
     1714   define buffer buf2_help-chk  for help-chk .
     1715     p-tot-r-b = 0 .
     1716     for each buf_tt-grp-sum where buf_tt-grp-sum.obj-code   = p-obj-code
     1717                               and buf_tt-grp-sum.pay-code   = p-pay-code
     1718                               and buf_tt-grp-sum.curr-code  = p-curr-code
     1719                               and buf_tt-grp-sum.upper-code = p-upper-code
     1720                               and buf_tt-grp-sum.obj-type   = p-obj-type :
     1721       if buf_tt-grp-sum.grp-lvl = 1 then do :
     1722         v-tot-r-b = buf_tt-grp-sum.tot-r-b .
     1723       end .
     1724       else do :
     1725         run grp-agregator in this-procedure
     1726         ( buf_tt-grp-sum.obj-code
     1727         , buf_tt-grp-sum.obj-type
     1728         , buf_tt-grp-sum.pay-code
     1729         , buf_tt-grp-sum.curr-code
     1730         , buf_tt-grp-sum.def-code
     1731         , output v-tot-r-b
     1732         ) .
     1733         buf_tt-grp-sum.tot-r-b = v-tot-r-b .
     1734       end .
     1735       p-tot-r-b = p-tot-r-b + v-tot-r-b .
     1736       for each buf_help-chk where buf_help-chk.obj-code  = buf_tt-grp-sum.obj-code
     1737                               and buf_help-chk.pay-code  = buf_tt-grp-sum.pay-code
     1738                               and buf_help-chk.curr-code = buf_tt-grp-sum.curr-code
     1739                               and buf_help-chk.group-chk = buf_tt-grp-sum.def-code :
     1740         buf_tt-grp-sum.chk-cnt-all = buf_tt-grp-sum.chk-cnt-all + 1.
     1741         if buf_tt-grp-sum.upper-code > 0 then do:
     1742           if not can-find (first buf2_help-chk where buf2_help-chk.obj-code  = buf_tt-grp-sum.obj-code
     1743                                                  and buf2_help-chk.pay-code  = buf_tt-grp-sum.pay-code
     1744                                                  and buf2_help-chk.curr-code = buf_tt-grp-sum.curr-code
     1745                                                  and buf2_help-chk.doc-code  = buf_help-chk.doc-code
     1746                                                  and buf2_help-chk.group-chk = buf_tt-grp-sum.upper-code) then do:
     1747             create buf2_help-chk.
     1748             assign
     1749               buf2_help-chk.obj-code  = buf_tt-grp-sum.obj-code
     1750               buf2_help-chk.pay-code  = buf_tt-grp-sum.pay-code
     1751               buf2_help-chk.curr-code = buf_tt-grp-sum.curr-code
     1752               buf2_help-chk.doc-code  = buf_help-chk.doc-code
     1753               buf2_help-chk.group-chk = buf_tt-grp-sum.upper-code
     1754             .
     1755           end.
     1756         end.
     1757         delete buf_help-chk.
     1758       end.
     1759     end .
     1760   end procedure .
     1761   empty temp-table all-days_sum .
     1762   empty temp-table ben-chk-count .
     1763   empty temp-table help-chk .
     1764   empty temp-table tt-gds-sum .
     1765   empty temp-table tt-grp-sum .
     1766   run no-benq(output found).
     1767   if not found then do:
     1768     message "Не было никакой выручки на выбранных объектах в течение заданного Вами периода времени." view-as alert-box information .
     1769     return.
     1770   end.
     1771   run rep/GetAlgoNum.p (output v-algo-num).
     1772   assign
     1773     AllDay-RublSum = 0
     1774     AllDay-BaseSum = 0
     1775     ChkAmount = 0
     1776     acc-count-ln = 0
     1777   .
     1778   FOR EACH obj-list WHERE obj-list.obj-type = 'маг':U NO-LOCK :
     1779     run waitfram-show in this-procedure ( obj-list.obj-type + string(obj-list.obj-code) +
     1780                                           ", отнесение оплат к товарам чека" ) .
     1781     CASE X-radio-Task :
     1782       when 1 then do:
     1783         run rep/rpychk0.p (input "r-autocu"
     1784                           ,input obj-list.obj-type
     1785                           ,input obj-list.obj-code
     1786                           ,input x-date-start
     1787                           ,input x-date-end
     1788                           ,input ?
     1789                           ,input ?
     1790                           ,input 0
     1791                           ,input 99
     1792                           ,input ?
     1793                           ) no-error.
     1794         if error-status:error then .
     1795       end.
     1796       when 2 then do:
     1797         run rep/rpychk0.p (input "r-shft3f"
     1798                           ,input obj-list.obj-type
     1799                           ,input obj-list.obj-code
     1800                           ,input ?
     1801                           ,input ?
     1802                           ,input x-date-start
     1803                           ,input x-date-end
     1804                           ,input 0
     1805                           ,input 99
     1806                           ,input ?
     1807                           ) no-error.
     1808         if error-status:error then .
     1809       end.
     1810       when 3 then do:
     1811         run rep/rpychk0.p (input "r-shft3f"
     1812                           ,input obj-list.obj-type
     1813                           ,input obj-list.obj-code
     1814                           ,input ?
     1815                           ,input ?
     1816                           ,input x-date-start
     1817                           ,input x-date-end
     1818                           ,input X-shift-Start
     1819                           ,input X-shift-Start
     1820                           ,input ?
     1821                           ) no-error.
     1822         if error-status:error then .
     1823       end.
     1824       when 4 then do:
     1825         run rep/rpychk0.p (input "r-ptrsp2"
     1826                           ,input obj-list.obj-type
     1827                           ,input obj-list.obj-code
     1828                           ,input ?
     1829                           ,input ?
     1830                           ,input x-date-start
     1831                           ,input ?
     1832                           ,input X-shift-Alone
     1833                           ,input 99
     1834                           ,input ?
     1835                           ) no-error.
     1836         if error-status:error then .
     1837       end.
     1838       otherwise .
     1839     END CASE.
     1840     assign
     1841       acc-day-base = 0
     1842       acc-day-rubl = 0
     1843       acc-day-cnt = 0
     1844       acc-day-nf  = 0
     1845     .
     1846     CASE X-radio-Task :
     1847       when 1 then do:
     1848         FOR EACH buf-chk-doc NO-LOCK WHERE
     1849                  buf-chk-doc.obj-type = obj-list.obj-type AND
     1850                  buf-chk-doc.obj-code = obj-list.obj-code AND
     1851                  buf-chk-doc.chk-date >= x-date-start AND
     1852                  buf-chk-doc.chk-date <= x-date-end AND
     1853                 (IF cas-num > 0 then buf-chk-doc.pay-desk = cas-num else TRUE):
     1854           do:
     1855             acc-count-ln = acc-count-ln + 1.
     1856             if ( acc-count-ln modulo 25 ) = 0 then
     1857               run waitfram-show in this-procedure ( obj-list.obj-type + string(obj-list.obj-code) +
     1858                                                     ", обработано строк чеков : " + string(acc-count-ln) ) .
     1859           end.
     1860             v-skip-line = false .
     1861           if not v-skip-line then do :
     1862             v-is-sub-count = (  lookup(string(buf-chk-doc.chk-type), '14,15,16,36,17,8,11,12,13,40,101,106,108,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U) > 0  ).
     1863             if not v-is-sub-count then do :
     1864   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1865   for EACH buf-chk-pay no-lock
     1866      WHERE buf-chk-pay.doc-code = buf-chk-doc.doc-code
     1867        AND buf-chk-pay.tot-sum <> 0
     1868   BREAK by buf-chk-pay.doc-code
     1869         BY buf-chk-pay.pay-code
     1870         BY buf-chk-pay.curr-code:
     1871     if first-of( buf-chk-pay.doc-code ) then do:
     1872       assign
     1873         acc-day-cnt = acc-day-cnt  + 1
     1874       .
     1875     end.
     1876     for each buf-chk-gds-pay no-lock
     1877        where buf-chk-gds-pay.doc-code   = buf-chk-pay.doc-code
     1878          and buf-chk-gds-pay.algo-num   = v-algo-num
     1879          and buf-chk-gds-pay.cpline-num = buf-chk-pay.line-num
     1880     :
     1881       if not can-find (first ben-chk-count where ben-chk-count.doc-code  = buf-chk-pay.doc-code
     1882                                              and ben-chk-count.obj-type  = obj-list.obj-type
     1883                                              and ben-chk-count.obj-code  = obj-list.obj-code
     1884                                              and ben-chk-count.b-code    = buf-chk-gds-pay.b-code
     1885                                              and ben-chk-count.pay-code  = buf-chk-pay.pay-code
     1886                                              and ben-chk-count.curr-code = buf-chk-pay.curr-code) then do:
     1887         create ben-chk-count.
     1888         assign
     1889           ben-chk-count.doc-code  = buf-chk-pay.doc-code
     1890           ben-chk-count.obj-type  = obj-list.obj-type
     1891           ben-chk-count.obj-code  = obj-list.obj-code
     1892           ben-chk-count.b-code    = buf-chk-gds-pay.b-code
     1893           ben-chk-count.pay-code  = buf-chk-pay.pay-code
     1894           ben-chk-count.curr-code = buf-chk-pay.curr-code
     1895         .
     1896       end.
     1897       find first tt-gds-sum where tt-gds-sum.b-code    = buf-chk-gds-pay.b-code
     1898                               and tt-gds-sum.obj-type  = obj-list.obj-type
     1899                               and tt-gds-sum.obj-code  = obj-list.obj-code
     1900                               and tt-gds-sum.pay-code  = buf-chk-pay.pay-code
     1901                               and tt-gds-sum.curr-code = buf-chk-pay.curr-code no-error.
     1902       if not available tt-gds-sum then do:
     1903         create tt-gds-sum.
     1904         assign
     1905           tt-gds-sum.obj-type  = obj-list.obj-type
     1906           tt-gds-sum.obj-code  = obj-list.obj-code
     1907           tt-gds-sum.pay-code  = buf-chk-pay.pay-code
     1908           tt-gds-sum.curr-code = buf-chk-pay.curr-code
     1909           tt-gds-sum.b-code    = buf-chk-gds-pay.b-code
     1910           tt-gds-sum.gds-code  = 0
     1911           tt-gds-sum.tot-r-b   = buf-chk-gds-pay.tot-r-b
     1912         .
     1913       end.
     1914       else assign
     1915         tt-gds-sum.tot-r-b   = tt-gds-sum.tot-r-b + buf-chk-gds-pay.tot-r-b
     1916       .
     1917     end.
     1918     assign
     1919       acc-day-rubl = acc-day-rubl + buf-chk-pay.tot-rubl
     1920       acc-day-base = acc-day-base + buf-chk-pay.tot-base
     1921     .
     1922   END.
     1923             end .
     1924           end .
     1925         END.
     1926       end.
     1927       otherwise do:
     1928         FOR EACH buf-chk-doc NO-LOCK WHERE
     1929                  buf-chk-doc.obj-type = obj-list.obj-type AND
     1930                  buf-chk-doc.obj-code = obj-list.obj-code AND
     1931                  buf-chk-doc.shift-date >= x-date-start AND
     1932                  buf-chk-doc.shift-date <= x-date-end AND
     1933                 (IF cas-num > 0 then buf-chk-doc.pay-desk = cas-num else TRUE):
     1934           do:
     1935             acc-count-ln = acc-count-ln + 1.
     1936             if ( acc-count-ln modulo 25 ) = 0 then
     1937               run waitfram-show in this-procedure ( obj-list.obj-type + string(obj-list.obj-code) +
     1938                                                     ", обработано строк чеков : " + string(acc-count-ln) ) .
     1939           end.
     1940             v-skip-line = (
     1941                X-Radio-task = 3 AND
     1942               ((buf-chk-doc.shift-date = X-date-start AND buf-chk-doc.shift-num < X-shift-Start) OR
     1943                (buf-chk-doc.shift-date = X-date-end   AND buf-chk-doc.shift-num > X-shift-End))
     1944             ) OR (
     1945                X-radio-task = 4 AND
     1946                (buf-chk-doc.shift-num <> X-shift-Alone)
     1947             ) .
     1948           if not v-skip-line then do :
     1949             v-is-sub-count = (  lookup(string(buf-chk-doc.chk-type), '14,15,16,36,17,8,11,12,13,40,101,106,108,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U) > 0  ).
     1950             if not v-is-sub-count then do :
     1951   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1952   for EACH buf-chk-pay no-lock
     1953      WHERE buf-chk-pay.doc-code = buf-chk-doc.doc-code
     1954        AND buf-chk-pay.tot-sum <> 0
     1955   BREAK by buf-chk-pay.doc-code
     1956         BY buf-chk-pay.pay-code
     1957         BY buf-chk-pay.curr-code:
     1958     if first-of( buf-chk-pay.doc-code ) then do:
     1959       assign
     1960         acc-day-cnt = acc-day-cnt  + 1
     1961       .
     1962     end.
     1963     for each buf-chk-gds-pay no-lock
     1964        where buf-chk-gds-pay.doc-code   = buf-chk-pay.doc-code
     1965          and buf-chk-gds-pay.algo-num   = v-algo-num
     1966          and buf-chk-gds-pay.cpline-num = buf-chk-pay.line-num
     1967     :
     1968       if not can-find (first ben-chk-count where ben-chk-count.doc-code  = buf-chk-pay.doc-code
     1969                                              and ben-chk-count.obj-type  = obj-list.obj-type
     1970                                              and ben-chk-count.obj-code  = obj-list.obj-code
     1971                                              and ben-chk-count.b-code    = buf-chk-gds-pay.b-code
     1972                                              and ben-chk-count.pay-code  = buf-chk-pay.pay-code
     1973                                              and ben-chk-count.curr-code = buf-chk-pay.curr-code) then do:
     1974         create ben-chk-count.
     1975         assign
     1976           ben-chk-count.doc-code  = buf-chk-pay.doc-code
     1977           ben-chk-count.obj-type  = obj-list.obj-type
     1978           ben-chk-count.obj-code  = obj-list.obj-code
     1979           ben-chk-count.b-code    = buf-chk-gds-pay.b-code
     1980           ben-chk-count.pay-code  = buf-chk-pay.pay-code
     1981           ben-chk-count.curr-code = buf-chk-pay.curr-code
     1982         .
     1983       end.
     1984       find first tt-gds-sum where tt-gds-sum.b-code    = buf-chk-gds-pay.b-code
     1985                               and tt-gds-sum.obj-type  = obj-list.obj-type
     1986                               and tt-gds-sum.obj-code  = obj-list.obj-code
     1987                               and tt-gds-sum.pay-code  = buf-chk-pay.pay-code
     1988                               and tt-gds-sum.curr-code = buf-chk-pay.curr-code no-error.
     1989       if not available tt-gds-sum then do:
     1990         create tt-gds-sum.
     1991         assign
     1992           tt-gds-sum.obj-type  = obj-list.obj-type
     1993           tt-gds-sum.obj-code  = obj-list.obj-code
     1994           tt-gds-sum.pay-code  = buf-chk-pay.pay-code
     1995           tt-gds-sum.curr-code = buf-chk-pay.curr-code
     1996           tt-gds-sum.b-code    = buf-chk-gds-pay.b-code
     1997           tt-gds-sum.gds-code  = 0
     1998           tt-gds-sum.tot-r-b   = buf-chk-gds-pay.tot-r-b
     1999         .
     2000       end.
     2001       else assign
     2002         tt-gds-sum.tot-r-b   = tt-gds-sum.tot-r-b + buf-chk-gds-pay.tot-r-b
     2003       .
     2004     end.
     2005     assign
     2006       acc-day-rubl = acc-day-rubl + buf-chk-pay.tot-rubl
     2007       acc-day-base = acc-day-base + buf-chk-pay.tot-base
     2008     .
     2009   END.
     2010             end .
     2011           end .
     2012         END.
     2013       end.
     2014     END CASE.
     2015     CREATE all-days_sum .
     2016     assign
     2017       all-days_sum.obj-type = obj-list.obj-type
     2018       all-days_sum.obj-code = obj-list.obj-code
     2019       all-days_sum.tot-base = acc-day-base
     2020       all-days_sum.tot-rubl = acc-day-rubl
     2021       all-days_sum.tot-r-b = (if v-curr-r-b = 'rubl':U then acc-day-rubl
     2022                                                           else acc-day-base)
     2023       all-days_sum.chk-cnt-all  = acc-day-cnt
     2024       all-days_sum.chk-cnt-nf   = acc-day-nf
     2025     .
     2026     assign
     2027       AllDay-RublSum = AllDay-RublSum + acc-day-rubl
     2028       AllDay-BaseSum = AllDay-BaseSum + acc-day-base
     2029       ChkAmount      = ChkAmount + (all-days_sum.chk-cnt-all - all-days_sum.chk-cnt-nf)
     2030     .
     2031   END.
     2032   run waitfram-show in this-procedure ("сведение штрих-кодов к товарам" ) .
     2033   for each tt-gds-sum break by tt-gds-sum.b-code:
     2034     if first-of (tt-gds-sum.b-code) then do:
     2035       find first buf-bar-code no-lock where buf-bar-code.b-code = tt-gds-sum.b-code no-error.
     2036       v-gds-code = if available buf-bar-code then buf-bar-code.gds-code else 0.
     2037     end.
     2038     tt-gds-sum.gds-code = v-gds-code.
     2039   end.
     2040   for each tt-gds-sum break by tt-gds-sum.obj-code
     2041                             by tt-gds-sum.pay-code
     2042                             by tt-gds-sum.curr-code
     2043                             by tt-gds-sum.gds-code:
     2044     if first-of (tt-gds-sum.obj-code) then do:
     2045       FIND FIRST buf-clients no-lock
     2046            WHERE buf-clients.obj-type = tt-gds-sum.obj-type
     2047              AND buf-clients.obj-code = tt-gds-sum.obj-code no-error .
     2048       v-obj-name = if available buf-clients then buf-clients.obj-name else "".
     2049     end.
     2050     if first-of (tt-gds-sum.pay-code) then do:
     2051       FIND FIRST buf-cash-pay no-lock
     2052            WHERE buf-cash-pay.cdpay-code = tt-gds-sum.pay-code
     2053              AND buf-cash-pay.curr-code  = tt-gds-sum.curr-code NO-ERROR.
     2054       v-pay-name = if available buf-cash-pay then buf-cash-pay.obj-name else "Неопознанная оплата".
     2055     end.
     2056     if first-of (tt-gds-sum.curr-code) then do:
     2057       FIND FIRST buf-currency no-lock
     2058            WHERE buf-currency.curr-code = tt-gds-sum.curr-code NO-ERROR.
     2059       v-curr-name = if available buf-currency then buf-currency.curr-name else "Неопознанная валюта".
     2060     end.
     2061     if first-of (tt-gds-sum.gds-code) then do:
     2062       run waitfram-show in this-procedure ("подсчёт количества чеков по группам: товар " + string(tt-gds-sum.gds-code)) .
     2063       find first buf-goods no-lock where buf-goods.gds-code = tt-gds-sum.gds-code no-error.
     2064       if available buf-goods then assign
     2065         v-gds-name = buf-goods.gds-name
     2066         v-grp-code = buf-goods.grp-code
     2067       .
     2068       else assign
     2069         v-gds-name = ""
     2070         v-grp-code = 0
     2071       .
     2072       find first tt-grp-sum4 where tt-grp-sum4.obj-code = tt-gds-sum.obj-code
     2073                                and tt-grp-sum4.obj-type = tt-gds-sum.obj-type
     2074                                and tt-grp-sum4.pay-code = tt-gds-sum.pay-code
     2075                                and tt-grp-sum4.curr-code = tt-gds-sum.curr-code
     2076                                and tt-grp-sum4.def-code = v-grp-code no-error.
     2077       if not available tt-grp-sum4 then do:
     2078         find first buf-gds-grp no-lock where buf-gds-grp.node-code = v-grp-code no-error.
     2079         if available buf-gds-grp then assign
     2080           v-grp-name = buf-gds-grp.node-name
     2081           v-upr-code = buf-gds-grp.upper-code
     2082         .
     2083         else assign
     2084           v-grp-name = ""
     2085           v-upr-code = 0
     2086         .
     2087         create tt-grp-sum4.
     2088         assign
     2089           tt-grp-sum4.obj-type  = tt-gds-sum.obj-type
     2090           tt-grp-sum4.obj-code  = tt-gds-sum.obj-code
     2091           tt-grp-sum4.obj-name  = v-obj-name
     2092           tt-grp-sum4.pay-code  = tt-gds-sum.pay-code
     2093           tt-grp-sum4.pay-name  = v-pay-name
     2094           tt-grp-sum4.curr-code = tt-gds-sum.curr-code
     2095           tt-grp-sum4.curr-name = v-curr-name
     2096           tt-grp-sum4.is-group  = true
     2097           tt-grp-sum4.upper-code = v-upr-code
     2098           tt-grp-sum4.grp-lvl    = 1
     2099           tt-grp-sum4.def-code   = v-grp-code
     2100           tt-grp-sum4.def-name   = v-grp-name
     2101           tt-grp-sum4.def-level = 0
     2102           tt-grp-sum4.tot-r-b     = 0
     2103           tt-grp-sum4.chk-cnt-all = 0
     2104           tt-grp-sum4.chk-cnt-nf  = 0
     2105         .
     2106       end.
     2107       create tt-grp-sum.
     2108       assign
     2109         tt-grp-sum.obj-type  = tt-gds-sum.obj-type
     2110         tt-grp-sum.obj-code  = tt-gds-sum.obj-code
     2111         tt-grp-sum.obj-name  = v-obj-name
     2112         tt-grp-sum.pay-code  = tt-gds-sum.pay-code
     2113         tt-grp-sum.pay-name  = v-pay-name
     2114         tt-grp-sum.curr-code = tt-gds-sum.curr-code
     2115         tt-grp-sum.curr-name = v-curr-name
     2116         tt-grp-sum.is-group  = false
     2117         tt-grp-sum.upper-code = v-grp-code
     2118         tt-grp-sum.grp-lvl    = 0
     2119         tt-grp-sum.def-code   = tt-gds-sum.gds-code
     2120         tt-grp-sum.def-name   = v-gds-name
     2121         tt-grp-sum.def-level = 0
     2122         tt-grp-sum.tot-r-b     = 0
     2123         tt-grp-sum.chk-cnt-all = 0
     2124         tt-grp-sum.chk-cnt-nf  = 0
     2125       .
     2126     end.
     2127     v-chk-count = 0.
     2128     for each ben-chk-count
     2129        where ben-chk-count.obj-type  = tt-gds-sum.obj-type
     2130          and ben-chk-count.obj-code  = tt-gds-sum.obj-code
     2131          and ben-chk-count.b-code    = tt-gds-sum.b-code
     2132          and ben-chk-count.pay-code  = tt-gds-sum.pay-code
     2133          and ben-chk-count.curr-code = tt-gds-sum.curr-code
     2134     break by ben-chk-count.doc-code:
     2135       if first-of (ben-chk-count.doc-code) then do:
     2136         v-chk-count = v-chk-count + 1.
     2137         if not can-find (first help-chk where help-chk.obj-code = tt-gds-sum.obj-code
     2138                                           and help-chk.pay-code = tt-gds-sum.pay-code
     2139                                           and help-chk.curr-code = tt-gds-sum.curr-code
     2140                                           and help-chk.doc-code  = ben-chk-count.doc-code
     2141                                           and help-chk.group-chk = v-grp-code) then do:
     2142           create help-chk.
     2143           assign
     2144             help-chk.obj-code  = tt-gds-sum.obj-code
     2145             help-chk.pay-code  = tt-gds-sum.pay-code
     2146             help-chk.curr-code = tt-gds-sum.curr-code
     2147             help-chk.doc-code  = ben-chk-count.doc-code
     2148             help-chk.group-chk = v-grp-code
     2149           .
     2150         end.
     2151       end.
     2152     end.
     2153     assign
     2154       tt-grp-sum4.tot-r-b    = tt-grp-sum4.tot-r-b    + tt-gds-sum.tot-r-b
     2155       tt-grp-sum.tot-r-b     = tt-grp-sum.tot-r-b     + tt-gds-sum.tot-r-b
     2156       tt-grp-sum.chk-cnt-all = tt-grp-sum.chk-cnt-all + v-chk-count
     2157       tt-grp-sum.chk-cnt-nf  = tt-grp-sum.chk-cnt-nf  + 0
     2158     .
     2159   end.
     2160   run waitfram-show in this-procedure ("добавление вышестоящих групп") .
     2161   v-level = 0.
     2162   repeat:
     2163     assign
     2164       v-level = v-level + 1
     2165       v-has-up-lvl = false
     2166     .
     2167     for each tt-grp-sum where tt-grp-sum.grp-lvl = v-level
     2168                           and tt-grp-sum.upper-code > 0 :
     2169       find first tt-grp-sum4 where tt-grp-sum4.obj-code = tt-grp-sum.obj-code
     2170                                and tt-grp-sum4.pay-code = tt-grp-sum.pay-code
     2171                                and tt-grp-sum4.curr-code = tt-grp-sum.curr-code
     2172                                and tt-grp-sum4.def-code = tt-grp-sum.upper-code
     2173                                and tt-grp-sum4.obj-type = tt-grp-sum.obj-type no-error.
     2174       if available tt-grp-sum4 then do:
     2175         v-level5 = v-level + 1.
     2176         if tt-grp-sum4.grp-lvl < v-level5 then do:
     2177           find first tt-grp-sum6 where rowid(tt-grp-sum6) = rowid(tt-grp-sum4) no-error.
     2178           repeat while available tt-grp-sum6:
     2179             if tt-grp-sum6.grp-lvl < v-level5 then tt-grp-sum6.grp-lvl = v-level5.
     2180             find first tt-grp-sum5 where rowid(tt-grp-sum5) = rowid(tt-grp-sum6) no-error.
     2181             if tt-grp-sum5.upper-code > 0 then do:
     2182               v-level5 = v-level5 + 1.
     2183               find first tt-grp-sum6 where tt-grp-sum6.obj-code = tt-grp-sum5.obj-code
     2184                                        and tt-grp-sum6.pay-code = tt-grp-sum5.pay-code
     2185                                        and tt-grp-sum6.curr-code = tt-grp-sum5.curr-code
     2186                                        and tt-grp-sum6.def-code = tt-grp-sum5.upper-code
     2187                                        and tt-grp-sum6.obj-type = tt-grp-sum5.obj-type no-error.
     2188             end.
     2189             else leave.
     2190           end.
     2191         end.
     2192       end.
     2193       else do:
     2194         v-has-up-lvl = true.
     2195         find first buf-gds-grp no-lock where buf-gds-grp.node-code = tt-grp-sum.upper-code no-error.
     2196         if available buf-gds-grp then assign
     2197           v-grp-name = buf-gds-grp.node-name
     2198           v-upr-code = buf-gds-grp.upper-code
     2199         .
     2200         else assign
     2201           v-grp-name = ""
     2202           v-upr-code = 0
     2203         .
     2204         create tt-grp-sum4.
     2205         assign
     2206           tt-grp-sum4.obj-type  = tt-grp-sum.obj-type
     2207           tt-grp-sum4.obj-code  = tt-grp-sum.obj-code
     2208           tt-grp-sum4.obj-name  = tt-grp-sum.obj-name
     2209           tt-grp-sum4.pay-code  = tt-grp-sum.pay-code
     2210           tt-grp-sum4.pay-name  = tt-grp-sum.pay-name
     2211           tt-grp-sum4.curr-code = tt-grp-sum.curr-code
     2212           tt-grp-sum4.curr-name = tt-grp-sum.curr-name
     2213           tt-grp-sum4.is-group  = true
     2214           tt-grp-sum4.upper-code = v-upr-code
     2215           tt-grp-sum4.grp-lvl    = v-level + 1
     2216           tt-grp-sum4.def-code   = tt-grp-sum.upper-code
     2217           tt-grp-sum4.def-name   = v-grp-name
     2218           tt-grp-sum4.def-level = 0
     2219           tt-grp-sum4.tot-r-b     = 0
     2220           tt-grp-sum4.chk-cnt-all = 0
     2221           tt-grp-sum4.chk-cnt-nf  = 0
     2222         .
     2223       end.
     2224     end.
     2225     if not v-has-up-lvl then leave.
     2226   end.
     2227     for each tt-grp-sum where tt-grp-sum.upper-code = 0 :
     2228       run grp-agregator in this-procedure
     2229       ( tt-grp-sum.obj-code
     2230       , tt-grp-sum.obj-type
     2231       , tt-grp-sum.pay-code
     2232       , tt-grp-sum.curr-code
     2233       , tt-grp-sum.upper-code
     2234       , output v-tot-r-b
     2235       ) .
     2236       tt-grp-sum.tot-r-b = v-tot-r-b .
     2237       for each help-chk where help-chk.obj-code = tt-grp-sum.obj-code
     2238                           and help-chk.pay-code = tt-grp-sum.pay-code
     2239                           and help-chk.curr-code = tt-grp-sum.curr-code
     2240                           and help-chk.group-chk = tt-grp-sum.def-code :
     2241         tt-grp-sum.chk-cnt-all = tt-grp-sum.chk-cnt-all + 1.
     2242         delete help-chk.
     2243       end.
     2244     end .
     2245   define work-table w-pay-sum no-undo
     2246     field obj-code  as integer
     2247     field pay-code  as integer
     2248     field curr-code as integer
     2249     field tot-r-b   as decimal decimals 10
     2250   .
     2251   for each tt-grp-sum where tt-grp-sum.upper-code = 0
     2252   break by tt-grp-sum.obj-code
     2253         by tt-grp-sum.pay-code
     2254         by tt-grp-sum.curr-code:
     2255     if first-of (tt-grp-sum.curr-code) then do:
     2256       create w-pay-sum.
     2257       assign
     2258         w-pay-sum.obj-code  = tt-grp-sum.obj-code
     2259         w-pay-sum.pay-code  = tt-grp-sum.pay-code
     2260         w-pay-sum.curr-code = tt-grp-sum.curr-code
     2261         w-pay-sum.tot-r-b   = 0
     2262       .
     2263     end.
     2264     w-pay-sum.tot-r-b = w-pay-sum.tot-r-b + tt-grp-sum.tot-r-b.
     2265   end.
     2266     run waitfram-show in this-procedure ("вывод на печать") .
     2267     run waitfram-hide in this-procedure .
     2268     run prn-lib-get-report-name in this-procedure ( input parParentProc, output v-report-name ).
     2269     assign
     2270       v-file-name-rep-htm = v-report-name + ".html"
     2271       v-vsex-cas = IF cas-num = 0 then "ВСЕХ КАСС" ELSE ("КАССЫ " + string(cas-num))
     2272       v-avg-chk  = if ChkAmount > 0 then round(
     2273         (if v-curr-r-b = 'rubl':U then AllDay-RublSum else AllDay-BaseSum)  /  ChkAmount
     2274                                                , 2 ) else 0
     2275       date_string     = cur-time-print()
     2276       sale-price-type = if v-curr-r-b = 'base':U then
     2277          base-type
     2278                                                     else "рублей"
     2279       ObjAmount = 0
     2280     .
     2281   define variable v-str4   as character no-undo .
     2282   define variable v-count4 as integer no-undo.
     2283     output stream OutStr-html to value(v-file-name-rep-htm) convert target 'UTF-8' .
     2284   do:
     2285     if length(str4) > 115 then do:
     2286       v-str4 = entry(1, str4, chr(10)).
     2287       do v-count4 = 2 to num-entries(str4, chr(10)) while length(v-str4) < 115:
     2288         v-str4 = v-str4 + chr(10) + entry(v-count4, str4, chr(10)).
     2289       end.
     2290       v-str4 = v-str4 + chr(10) + "...".
     2291     end.
     2292     else v-str4 = str4.
     2293     put stream OutStr-html unformatted
     2294       "<!DOCTYPE HTML>" skip
     2295       '<html>' skip
     2296       '<head>' skip
     2297       '  <meta charset="utf-8">' skip
     2298       '  <style type="text/css">' skip
     2299       '      table ~{border-collapse: collapse~;~}' skip
     2300       '      tbody td, th ~{border: 1px solid black~; height: 14px~;~}' skip
     2301       '      tbody td:nth-child(3), tbody td:nth-child(4), tbody td:nth-child(5) ~{text-align: right~; padding-right: 4px~;~}' skip
     2302       '      tbody tr[level="1"] td ~{font-weight: bold~;~}' skip
     2303       '      tbody tr[level="3"] td:nth-child(1) ~{padding-left: 30px~;~}' skip
     2304       '      tbody tr[level="4"] td:nth-child(1) ~{padding-left: 40px~;~}' skip
     2305       '      tbody tr[level="5"] td ~{display: none~;~}' skip
     2306       '      tbody tr[level="5"] td:nth-child(1) ~{padding-left: 50px~;~}' skip
     2307       '      tbody tr[level="6"] td ~{display: none~;~}' skip
     2308       '      tbody tr[level="6"] td:nth-child(1) ~{padding-left: 60px~;~}' skip
     2309       '      tbody tr[level="7"] td ~{display: none~;~}' skip
     2310       '      tbody tr[level="7"] td:nth-child(1) ~{padding-left: 70px~;~}' skip
     2311       '      tbody tr[level="8"] td ~{display: none~;~}' skip
     2312       '      tbody tr[level="8"] td:nth-child(1) ~{padding-left: 80px~;~}' skip
     2313       '      tfoot td ~{height: 14px~;~}' skip
     2314       '      .sumtotal ~{text-align: right~; padding-right: 4px~;~}' skip
     2315       '  </style>' skip
     2316       '</head>' skip
     2317       '<body>' skip
     2318       '<TABLE name="exp' + string(day(x-date-start), "99") + 'g" fit_to_page="true" orientation="portrait" repeat_rows="1:4" outline_below="false">' skip
     2319       '<thead>' skip
     2320       '  <tr class="set_columns">' skip
     2321       '    <td style="width: 103px;"></td>' skip
     2322       '    <td style="width: 336px;"></td>' skip
     2323       '    <td style="width: 93px;"></td>' skip
     2324       '    <td style="width: 49px;"></td>' skip
     2325       '    <td style="width: 41px;"></td>' skip
     2326       '  </tr>' skip
     2327       '  <tr>' skip
     2328       '    <td colspan="5">' + date_string + '</td>' skip
     2329       '  </tr>' skip
     2330       '  <tr>' skip
     2331       '    <td colspan="5">ОТЧЕТ  О  ВЫРУЧКЕ ' + str1 + '<br />' skip
     2332            v-str4 + '<br />( сформирован по ВСЕМ ЧЕКАМ '
     2333            + (IF NotInc then v-vsex-cas + ", включая невошедшие в отчеты о продажах" else v-vsex-cas)
     2334            + ' )'
     2335            + '<br />' skip
     2336            substitute("( всего чеков : &1, в среднем &2 &3 / чек )",  ChkAmount,  v-avg-chk,  sale-price-type  )
     2337     .
     2338     put stream OutStr-html unformatted
     2339            '</td>' skip
     2340       '  </tr>' skip
     2341       '</thead>' skip
     2342       '<tbody>' skip
     2343       '  <tr>' skip
     2344       '    <th>Код</th>' skip
     2345       '    <th>Наименование</th>' skip
     2346       '    <th>Сумма в ' (if v-curr-r-b = 'base':U then 'Б.Вал.' else 'рублях') '</th>' skip
     2347       '    <th>~% от суммы</th>' skip
     2348       '    <th>Кол-во фиск. чеков</th>' skip
     2349       '  </tr>' skip
     2350     .
     2351   end.
     2352   define work-table w-upr-stack no-undo
     2353     field flevel   as integer
     2354     field def-code as integer
     2355     field tot-r-b  as decimal decimals 2
     2356   .
     2357   FOR EACH obj-list WHERE obj-list.obj-type = 'маг':U,
     2358       EACH all-days_sum WHERE
     2359             all-days_sum.obj-type = obj-list.obj-type AND
     2360             all-days_sum.obj-code = obj-list.obj-code
     2361   BREAK BY obj-list.obj-type
     2362         BY obj-list.obj-code :
     2363     ACCUMULATE
     2364       all-days_sum.tot-base ( TOTAL )
     2365       all-days_sum.tot-rubl ( TOTAL )
     2366       all-days_sum.tot-r-b ( TOTAL )
     2367       all-days_sum.chk-cnt-all ( TOTAL )
     2368       all-days_sum.chk-cnt-nf  ( TOTAL )
     2369     .
     2370     ObjAmount = ObjAmount + 1.
     2371     for each tt-grp-sum
     2372        where tt-grp-sum.obj-code = obj-list.obj-code
     2373          and tt-grp-sum.obj-type = obj-list.obj-type
     2374          and tt-grp-sum.upper-code = 0
     2375     break by tt-grp-sum.pay-code
     2376           by tt-grp-sum.curr-code
     2377           by tt-grp-sum.def-code:
     2378       if first( tt-grp-sum.pay-code ) then do:
     2379         put stream OutStr-html unformatted
     2380           '  <tr level="1">'
     2381           '<td>' + tt-grp-sum.obj-type + '</td>'
     2382           '<td>' + tt-grp-sum.obj-name + '</td>'
     2383           substitute(  '<td num="0.00" val="&1">&1</td>',  fnc-convert-dot-to-colon(all-days_sum.tot-r-b,"->>>>>>>>>>>9.99",2)  )
     2384           '<td></td>'
     2385           substitute(  '<td num="0" val="&1">&1</td>',  all-days_sum.chk-cnt-all - all-days_sum.chk-cnt-nf  )
     2386           '</tr>' skip
     2387         .
     2388       end.
     2389       if first-of(tt-grp-sum.curr-code) then do:
     2390         find first w-pay-sum where w-pay-sum.obj-code  = tt-grp-sum.obj-code
     2391                                and w-pay-sum.pay-code  = tt-grp-sum.pay-code
     2392                                and w-pay-sum.curr-code = tt-grp-sum.curr-code no-error.
     2393         v-pcnt = if available w-pay-sum then round( w-pay-sum.tot-r-b / all-days_sum.tot-r-b * 100 , 2 ) else 0.
     2394         put stream OutStr-html unformatted
     2395           '  <tr level="2">'
     2396           '<td></td>'
     2397           '<td style="padding-left: 10px">' + tt-grp-sum.pay-name + '</td>'
     2398           '<td></td>'
     2399           substitute(  '<td num="0.00" val="&1">&1</td>',  fnc-convert-dot-to-colon(v-pcnt,"->>9.99",2)  )
     2400           '<td></td>'
     2401           '</tr>' skip
     2402         .
     2403       end.
     2404       v-level = 3.
     2405       v-pcnt = round( tt-grp-sum.tot-r-b / all-days_sum.tot-r-b * 100 , 2 ) .
     2406       put stream OutStr-html unformatted
     2407         substitute('  <tr level="&1">', v-level)
     2408         substitute('<td>&1</td>', tt-grp-sum.def-code)
     2409         '<td>' + tt-grp-sum.def-name + '</td>'
     2410         substitute(  '<td num="0.00" val="&1">&1</td>',  fnc-convert-dot-to-colon(tt-grp-sum.tot-r-b,"->>>>>>>>>>>9.99",2)  )
     2411         substitute(  '<td num="0.00" val="&1">&1</td>',  fnc-convert-dot-to-colon(v-pcnt,"->>9.99",2)  )
     2412         substitute(  '<td num="0" val="&1">&1</td>',  tt-grp-sum.chk-cnt-all - tt-grp-sum.chk-cnt-nf  )
     2413         '</tr>' skip
     2414       .
     2415       create w-upr-stack.
     2416       assign
     2417         w-upr-stack.flevel   = v-level
     2418         w-upr-stack.def-code = tt-grp-sum.def-code
     2419         w-upr-stack.tot-r-b  = tt-grp-sum.tot-r-b
     2420       .
     2421       repeat:
     2422         find first tt-grp-sum4 use-index dc
     2423              where tt-grp-sum4.obj-code = obj-list.obj-code
     2424                and tt-grp-sum4.obj-type = obj-list.obj-type
     2425                and tt-grp-sum4.pay-code = tt-grp-sum.pay-code
     2426                and tt-grp-sum4.curr-code = tt-grp-sum.curr-code
     2427                and tt-grp-sum4.upper-code = w-upr-stack.def-code no-error.
     2428         if available tt-grp-sum4 then do:
     2429           v-pcnt = round( tt-grp-sum4.tot-r-b / all-days_sum.tot-r-b * 100 , 2 ) .
     2430           put stream OutStr-html unformatted
     2431             substitute('  <tr level="&1">',  minimum(w-upr-stack.flevel + 1, 8)  )
     2432             substitute('<td>&1</td>',  tt-grp-sum4.def-code)
     2433             '<td>' + tt-grp-sum4.def-name + '</td>'
     2434             substitute(  '<td num="0.00" val="&1">&1</td>',  fnc-convert-dot-to-colon(tt-grp-sum4.tot-r-b,"->>>>>>>>>>>9.99",2)  )
     2435             substitute(  '<td num="0.00" val="&1">&1</td>',  fnc-convert-dot-to-colon(v-pcnt,"->>9.99",2)  )
     2436             substitute(  '<td num="0" val="&1">&1</td>',  tt-grp-sum4.chk-cnt-all - tt-grp-sum4.chk-cnt-nf  )
     2437             '</tr>' skip
     2438           .
     2439           if tt-grp-sum4.is-group then do:
     2440             v-level = w-upr-stack.flevel + 1.
     2441             create w-upr-stack.
     2442             assign
     2443               w-upr-stack.flevel   = v-level
     2444               w-upr-stack.def-code = tt-grp-sum4.def-code
     2445               w-upr-stack.tot-r-b  = tt-grp-sum4.tot-r-b
     2446             .
     2447           end.
     2448           delete tt-grp-sum4.
     2449         end.
     2450         else do:
     2451           v-level = w-upr-stack.flevel - 1.
     2452           if v-level < 3 then leave.
     2453           delete w-upr-stack.
     2454           find first w-upr-stack where w-upr-stack.flevel = v-level.
     2455         end.
     2456       end.
     2457     end.
     2458     if last( obj-list.obj-code ) AND ( ObjAmount > 1 ) then do:
     2459       put stream OutStr-html unformatted
     2460         '  <tr level="1"><td colspan="2">ИТОГО по всем</td>'
     2461         substitute(  '<td num="0.00" val="&1" class="sumtotal">&1</td>',  fnc-convert-dot-to-colon(ACCUM TOTAL all-days_sum.tot-r-b,"->>>>>>>>>>>9.99",2)  )
     2462         '<td></td>'
     2463         substitute(  '<td num="0" val="&1" class="sumtotal">&1</td>',
     2464                      (ACCUM TOTAL all-days_sum.chk-cnt-all) - (ACCUM TOTAL all-days_sum.chk-cnt-nf)
     2465                   )
     2466         '</tr>' skip
     2467       .
     2468     end.
     2469   END.
     2470   if  ObjAmount > 1  then do:
     2471     for each tt-gds-sum break by tt-gds-sum.pay-code:
     2472       ACCUMULATE
     2473         tt-gds-sum.tot-r-b  ( SUB-TOTAL BY tt-gds-sum.pay-code )
     2474       .
     2475       if last-of( tt-gds-sum.pay-code ) AND
     2476          ( ACCUM SUB-TOTAL BY tt-gds-sum.pay-code tt-gds-sum.tot-r-b ) <> 0 then do:
     2477         v-chk-count = 0.
     2478         for each ben-chk-count
     2479            where ben-chk-count.pay-code = tt-gds-sum.pay-code
     2480         break by ben-chk-count.doc-code:
     2481           if first-of (ben-chk-count.doc-code) then v-chk-count = v-chk-count + 1.
     2482         end.
     2483         FIND FIRST buf-cash-pay no-lock
     2484              WHERE buf-cash-pay.cdpay-code = tt-gds-sum.pay-code
     2485                AND buf-cash-pay.curr-code  = tt-gds-sum.curr-code NO-ERROR.
     2486         v-pay-name = if available buf-cash-pay then buf-cash-pay.obj-name else "Неопознанная оплата".
     2487         put stream OutStr-html unformatted
     2488           substitute(  '  <tr level="2"><td colspan="2">/итого по &1</td>',  v-pay-name  )
     2489           substitute(  '<td num="0.00" val="&1" class="sumtotal">&1</td>',  fnc-convert-dot-to-colon(ACCUM SUB-TOTAL BY tt-gds-sum.pay-code tt-gds-sum.tot-r-b,"->>>>>>>>>>>9.99",2)  )
     2490           '<td></td>'
     2491           substitute(  '<td num="0" val="&1" class="sumtotal">&1</td>',  v-chk-count  )
     2492           '</tr>' skip
     2493         .
     2494       end.
     2495     end.
     2496   end.
     2497   put stream OutStr-html unformatted
     2498     '</tbody>' skip
     2499     '<tfoot>' skip
     2500   .
     2501   if  ObjAmount < 2 then do:
     2502     put stream OutStr-html unformatted
     2503       '  <tr><td colspan="5"><br /></td></tr>' skip
     2504       '  <tr><td colspan="2">Директор _______________</td><td colspan="3">Старший продавец ______________</td></tr>' skip
     2505       '  <tr><td colspan="5"><br /></td></tr>' skip
     2506       '  <tr><td colspan="2">Бухгалтер ______________</td><td colspan="3">Кассир ________________________</td></tr>' skip
     2507     .
     2508   end.
     2509   put stream OutStr-html unformatted
     2510     '</tfoot>' skip
     2511     '</table>' skip
     2512     '</body>' skip
     2513     '</html>' skip
     2514   .
     2515   output stream OutStr-html close.
     2516   run prn-lib-reportviewer in this-procedure (
     2517       input this-procedure
     2518       ,input v-file-name-rep-htm
     2519       ,input ""
     2520       ) no-error.
     2521   if error-status:error then
     2522   do:
     2523       message return-value view-as alert-box.
     2524       return .
     2525   end.
