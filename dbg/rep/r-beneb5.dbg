        6   define variable vss-author      as character no-undo init "$Author: VSpiridonov $":U .
        7   define variable vss-date        as character no-undo init "$Date: 2023/10/16 15:13:33 $":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile: r-beneb5.p $":U .
