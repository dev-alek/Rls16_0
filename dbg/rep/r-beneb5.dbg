     1454   define buffer buf-chk-pay     for ub.chk-pay .
     1455   define buffer buf-chk-gds-pay for ub.chk-gds-pay .
     1456   define buffer buf-cash-pay for ub.cash-pay .
     1457   define buffer buf-currency for ub.currency .
     1458   define buffer buf-bar-code for ub.bar-code .
     1459   define buffer buf-goods    for ub.goods .
     1460   define buffer buf-gds-grp  for ub.gds-grp .
     1461   define buffer buf-clients  for ub.clients .
     1462   define buffer tt-grp-sum4  for tt-grp-sum .
     1463   define buffer tt-grp-sum5  for tt-grp-sum .
     1464   define buffer tt-grp-sum6  for tt-grp-sum .
     1465   define buffer buf2_help-chk for help-chk .
