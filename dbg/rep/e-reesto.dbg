     1628   PROCEDURE my-var :
     1629   assign frame F-Main ie ee ep es re rs we vt iv ev rv em wm im ot ap pc
     1630    VAT-SLT VAT-SLT-s
     1631    CostSum DispUpFact
     1632    Serv  NullPer CalcRest.
     1633   ReportNAme = "Р Е Е С Т Р   Д О К У М Е Н Т О В  ( Т О В А Р Н Ы Й   О Т Ч Е Т )".
     1634   VAT-SLT  = NO .
     1635       VAT-SLT-s = NO.
     1636   ReportHeader =  "" .
     1637   ReportHeader = (ReportHeader) + IF CostSum     THEN CostSum:label + chr(10) Else "".
     1638   ReportHeader = (ReportHeader) + IF DispUpFact  THEN DispUpFact:label + chr(10) Else "" .
     1639   ReportHeader = (ReportHeader) + IF  Serv       THEN Serv:label + chr(10) Else "" .
     1640   ReportHeader = (ReportHeader) + IF  NullPer    THEN NullPer:label + chr(10) Else "без нулевых остатков по переоценке" + chr(10) .
     1641   ReportHeader = (ReportHeader) + IF  CalcRest   THEN CalcRest:label + chr(10) Else ""  .
     1642   ReportHeader = (ReportHeader) + "документы : "  + chr(10).
     1643   ReportHeader = (ReportHeader)               + IF  ie THen      (ie:label) + ","  else " " .
     1644   ReportHeader = (ReportHeader)               + IF  ee then      (ee:label) + ","  else " ".
     1645   ReportHeader = (ReportHeader)               + IF  ep then      (ep:label) + ","  else " ".
     1646   ReportHeader = (ReportHeader)               + IF  es THen      (es:label) + ","  else " ".
     1647   ReportHeader = (ReportHeader)               + IF  re then      (re:label) + ","  else " ".
     1648   ReportHeader = (ReportHeader) +  chr(10).
     1649   ReportHeader = (ReportHeader)               + IF  rs then      (rs:label) + ","  else " ".
     1650   ReportHeader = (ReportHeader)               + IF  we THen      (we:label) + ","  else " ".
     1651   ReportHeader = (ReportHeader)               + IF  vt then      (vt:label) + ","  else " ".
     1652   ReportHeader = (ReportHeader)               + IF  iv then      (iv:label) + ","  else " ".
     1653   ReportHeader = (ReportHeader)               + IF  ev THen      (ev:label) + ","  else " ".
     1654   ReportHeader = (ReportHeader) +  chr(10).
     1655   ReportHeader = (ReportHeader)               + IF  rv then      (rv:label) + ","  else " ".
     1656   ReportHeader = (ReportHeader)               + IF  em then      (em:label) + ","  else " " .
     1657   ReportHeader = (ReportHeader)               + IF  wm THen      wm:label + ","  else " " .
     1658   ReportHeader = (ReportHeader)               + IF  im then      im:label + ","  else " ".
     1659   ReportHeader = (ReportHeader)               + IF  ap then      ap:label + ","  else " ".
     1660   ReportHeader = (ReportHeader)               + IF  pc then      pc:label + ","  else " ".
     1661   ReportHeader = (ReportHeader)               + IF  ot then      ot:label        else " " .
     1662   END PROCEDURE.
