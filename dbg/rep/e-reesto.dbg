     1100   PROCEDURE adm-update-record :
     1101       MESSAGE
     1102         "Object ":U THIS-PROCEDURE:FILE-NAME
     1103           "must have at least one Enabled Table to perform Update.":U
     1104             VIEW-AS ALERT-BOX ERROR.
     1105      RETURN.
     1106   END PROCEDURE.
     1107   PROCEDURE check-modified :
     1108   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
     1109   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
     1110   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
     1111   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
     1112     IF check-state = "check":U THEN
     1113     DO:
     1114       RUN get-link-handle IN adm-broker-hdl
     1115         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
     1116            OUTPUT group-target-list).
     1117       IF group-target-list NE "":U THEN
     1118       DO i = 1 TO NUM-ENTRIES(group-target-list):
     1119         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
     1120         RUN check-modified IN curr-widget ('group-check':U).
     1121         IF RETURN-VALUE NE "":U THEN
     1122         DO:
     1123           RUN check-modified-message(RETURN-VALUE).
     1124           RETURN "":U.
     1125         END.
     1126       END.
     1127     END.
     1128     RETURN "":U.
     1129   END PROCEDURE.
     1130   PROCEDURE check-modified-message :
     1131     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
     1132        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
     1133           'CONTAINER-SOURCE':U, 'HIDDEN':U).
     1134        IF RETURN-VALUE = "YES":U THEN
     1135           RUN notify ('view,CONTAINER-SOURCE':U).
     1136        MESSAGE IF p-changed-table NE ? THEN
     1137           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
     1138           ELSE "Current values have been changed."
     1139           SKIP "  Do you wish to save those changes?"
     1140           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
     1141        IF ANS THEN
     1142        DO:
     1143           IF group-assign-target THEN
     1144             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
     1145           ELSE RUN dispatch('update-record':U).
     1146           IF RETURN-VALUE = "ADM-ERROR":U THEN
     1147           DO:
     1148               MESSAGE "Changes to the previous record were not saved."
     1149                 VIEW-AS ALERT-BOX ERROR.
     1150               IF group-assign-target THEN
     1151                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1152               ELSE RUN dispatch ('cancel-record':U).
     1153           END.
     1154        END.
     1155        ELSE DO:
     1156          IF group-assign-target THEN
     1157             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1158          ELSE RUN dispatch('cancel-record':U).
     1159        END.
     1160        RETURN.
     1161   END PROCEDURE.
     1162   PROCEDURE get-rowid :
     1163       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
     1164       ASSIGN
     1165       p-table   =   adm-first-table.
     1166       RETURN.
     1167   END PROCEDURE.
     1168   PROCEDURE init-group-assign :
     1169       RUN request-attribute IN adm-broker-hdl
     1170         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
     1171       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
     1172         group-assign-target = yes.
     1173       ELSE group-assign-target = no.
     1174       RETURN.
     1175   END PROCEDURE.
     1176   PROCEDURE set-editors :
     1177       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
     1178       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
     1179       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
     1180       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
     1181       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
     1182       DO WHILE VALID-HANDLE (curr-widget):
     1183           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
     1184              curr-widget:HIDDEN = no THEN DO:
     1185             CASE p-field-setting:
     1186               WHEN "INITIALIZE":U THEN
     1187               DO:
     1188                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
     1189                     read-only-list +
     1190                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
     1191                        STRING(curr-widget).
     1192               END.
     1193               WHEN "DISABLE":U OR
     1194               WHEN "ENABLE":U THEN
     1195               DO:
     1196                   curr-widget:SENSITIVE = yes.
     1197                   RUN get-attribute ('Read-Only-Editors':U).
     1198                   IF RETURN-VALUE = ? OR
     1199                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
     1200                       curr-widget:READ-ONLY =
     1201                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
     1202               END.
     1203               WHEN "CLEAR":U THEN
     1204                   curr-widget:SCREEN-VALUE = "":U.
     1205             END CASE.
     1206           END.
     1207           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
     1208       END.
     1209       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
     1210         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
     1211           + '"':U).
     1212       RETURN.
     1213   END PROCEDURE.
     1214   PROCEDURE use-check-modified-all :
     1215    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1216     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
     1217     RETURN.
     1218   END PROCEDURE.
     1219   PROCEDURE use-create-on-add :
     1220   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1221      RETURN.
     1222   END PROCEDURE.
     1223   PROCEDURE use-initial-lock :
     1224     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1225     ASSIGN adm-initial-lock = p-attr-value.
     1226     RETURN.
     1227   END PROCEDURE.
     1228     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
     1229   ASSIGN
     1230          FRAME F-Main:SCROLLABLE       = FALSE
     1231          FRAME F-Main:HIDDEN           = TRUE.
     1232   ASSIGN
     1233          VAT-SLT:HIDDEN IN FRAME F-Main           = TRUE.
     1234   ASSIGN
     1235          VAT-SLT-s:HIDDEN IN FRAME F-Main           = TRUE.
     1236   ON VALUE-CHANGED OF ap IN FRAME F-Main
     1237   DO:
     1238     run calc-rest in this-procedure .
     1239   END.
     1240   ON VALUE-CHANGED OF ee IN FRAME F-Main
     1241   DO:
     1242     run calc-rest in this-procedure .
     1243   END.
     1244   ON VALUE-CHANGED OF em IN FRAME F-Main
     1245   DO:
     1246     run calc-rest in this-procedure .
     1247   END.
     1248   ON VALUE-CHANGED OF ep IN FRAME F-Main
     1249   DO:
     1250     run calc-rest in this-procedure .
     1251   END.
     1252   ON VALUE-CHANGED OF es IN FRAME F-Main
     1253   DO:
     1254       run calc-rest in this-procedure .
     1255   END.
     1256   ON VALUE-CHANGED OF ev IN FRAME F-Main
     1257   DO:
     1258     run calc-rest in this-procedure .
     1259   END.
     1260   ON VALUE-CHANGED OF ie IN FRAME F-Main
     1261   DO:
     1262     run calc-rest in this-procedure .
     1263   END.
     1264   ON VALUE-CHANGED OF im IN FRAME F-Main
     1265   DO:
     1266     run calc-rest in this-procedure .
     1267   END.
     1268   ON VALUE-CHANGED OF iv IN FRAME F-Main
     1269   DO:
     1270     run calc-rest in this-procedure .
     1271   END.
     1272   ON VALUE-CHANGED OF ot IN FRAME F-Main
     1273   DO:
     1274     run calc-rest in this-procedure .
     1275   END.
     1276   ON VALUE-CHANGED OF pc IN FRAME F-Main
     1277   DO:
     1278     run calc-rest in this-procedure .
     1279   END.
     1280   ON VALUE-CHANGED OF re IN FRAME F-Main
     1281   DO:
     1282     run calc-rest in this-procedure .
     1283   END.
     1284   ON VALUE-CHANGED OF rs IN FRAME F-Main
     1285   DO:
     1286     run calc-rest in this-procedure .
     1287   END.
     1288   ON VALUE-CHANGED OF rv IN FRAME F-Main
     1289   DO:
     1290     run calc-rest in this-procedure .
     1291   END.
     1292   ON VALUE-CHANGED OF Serv IN FRAME F-Main
     1293   DO:
     1294     assign serv.
     1295     if serv then DO:
     1296          CalcRest = false.
     1297          disable CalcRest with frame F-Main.
     1298          display CalcRest with frame F-Main.
     1299          End.
     1300        Else do:
     1301          enable CalcRest with frame F-Main.
     1302          display CalcRest with frame F-Main.
     1303          End.
     1304   END.
     1305   ON VALUE-CHANGED OF vt IN FRAME F-Main
     1306   DO:
     1307       run calc-rest in this-procedure .
     1308   END.
     1309   ON VALUE-CHANGED OF we IN FRAME F-Main
     1310   DO:
     1311     run calc-rest in this-procedure .
     1312   END.
     1313   ON VALUE-CHANGED OF wm IN FRAME F-Main
     1314   DO:
     1315     run calc-rest in this-procedure .
     1316   END.
     1317   define variable  list-com-hand as character no-undo .
     1318   list-com-hand = "" .
     1319   list-com-hand = list-com-hand + string(ie:handle) + "," .
     1320   list-com-hand = list-com-hand + string(ee:handle) + "," .
     1321   list-com-hand = list-com-hand + string(ep:handle) + "," .
     1322   list-com-hand = list-com-hand + string(es:handle) + "," .
     1323   list-com-hand = list-com-hand + string(re:handle) + "," .
     1324   list-com-hand = list-com-hand + string(rs:handle) + "," .
     1325   list-com-hand = list-com-hand + string(we:handle) + "," .
     1326   list-com-hand = list-com-hand + string(vt:handle) + "," .
     1327   list-com-hand = list-com-hand + string(iv:handle) + "," .
     1328   list-com-hand = list-com-hand + string(ev:handle) + "," .
     1329   list-com-hand = list-com-hand + string(rv:handle) + "," .
     1330   list-com-hand = list-com-hand + string(em:handle) + "," .
     1331   list-com-hand = list-com-hand + string(wm:handle) + "," .
     1332   list-com-hand = list-com-hand + string(im:handle) + "," .
     1333   list-com-hand = list-com-hand + string(ot:handle) + "," .
     1334   list-com-hand = list-com-hand + string(ap:handle) + "," .
     1335   list-com-hand = list-com-hand + string(pc:handle) + "," .
     1336   PROCEDURE calc-rest :
     1337   assign FRAME F-Main ie ee ep es re rs we vt iv ev rv em wm im ot ap pc    .
     1338   if  ie
     1339   AND ee
     1340   AND  ep
     1341   AND  es
     1342   AND  re
     1343   AND  rs
     1344   AND  we
     1345   AND  vt
     1346   AND  iv
     1347   AND  ev
     1348   AND  rv
     1349   AND  em
     1350   AND  wm
     1351   AND  im
     1352   AND  ot
     1353   AND  ap
     1354   AND  pc
     1355      then
     1356       do:
     1357           assign CalcRest = yes.
     1358           DISPLAY CalcRest WITH FRAME F-Main.
     1359           ENABLE CalcRest WITH FRAME F-Main.
     1360       end.
     1361   else
     1362       do:
     1363           assign CalcRest = no.
     1364           DISPLAY CalcRest WITH FRAME F-Main.
     1365           DISABLE CalcRest WITH FRAME F-Main.
     1366       end.
     1367   END PROCEDURE.
     1368   PROCEDURE disable_UI :
     1369     HIDE FRAME F-Main.
     1370     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1371   END PROCEDURE.
     1372   PROCEDURE enable_UI :
     1373     DISPLAY ie ee CostSum ep DispUpFact es re Serv rs NullPer we vt iv CalcRest ev
     1374             rv em wm im ot ap pc
     1375         WITH FRAME F-Main.
     1376     ENABLE RECT-14 RECT-15 RECT-16 RECT-12 ie ee CostSum ep DispUpFact es re Serv
     1377            rs NullPer we vt iv CalcRest ev rv em wm im ot ap pc
     1378         WITH FRAME F-Main.
     1379   END PROCEDURE.
     1380   PROCEDURE local-initialize :
     1381     run dispatch IN THIS-PROCEDURE ( INPUT 'initialize':U ) .
     1382   define variable vss-include-info14 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1383   do:
     1384     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1385       (input  v-cntxt-db-num
     1386       ,input  v-cntxt-userid
     1387       ,input  0
     1388       ,input  'actn_reports_lookup-cost':U
     1389       ,input  'object':U
     1390       ,input  v-cntxt-host-code-obj
     1391       ,input  v-cntxt-obj-type
     1392       ,input  v-cntxt-obj-code
     1393       ,input  0
     1394       ,input  0
     1395       ,input  0
     1396       ,input  false
     1397       ,output g#log
     1398       )  .
     1399   end.
     1400      if not  g#log then do :
     1401      CostSum = false .
     1402      DispUpFact = false .
     1403      disable CostSum DispUpFact  with frame F-Main .
     1404      display CostSum  DispUpFact with frame F-Main .
     1405    end.
     1406   define variable lab-handle as handle no-undo .
     1407   define variable i as integer no-undo .
     1408   define variable v-code as character no-undo .
     1409   define variable v-nn as integer   no-undo .
     1410   v-nn = num-entries (list-com-hand) .
     1411   do i = 1 to v-nn :
     1412    lab-handle = widget-handle (entry( i , list-com-hand) ) no-error .
     1413    if valid-handle(lab-handle) = true and  error-status :error = false   then do:
     1414       v-code = lab-handle:name.
     1415       lab-handle:label = func-get-name-from-ext-type ( v-code, true  ) .
     1416       end.
     1417   end.
     1418   END PROCEDURE.
     1419   PROCEDURE my-report :
     1420   for each tdedt: delete tdedt. end.
     1421   IF ie then  do:
     1422   create tdedt.
     1423   assign tdedt.id =  'ie':U
     1424          tdedt.n  = "01"
     1425   .
     1426   run get-name-from-ext-type in this-procedure (
     1427       input tdedt.id  ,
     1428       input false  ,
     1429       output tdedt.name )
     1430        .
     1431                          end.
     1432   IF ee then  do:
     1433   create tdedt.
     1434   assign tdedt.id =  'ee':U
     1435          tdedt.n  = "02"
     1436   .
     1437   run get-name-from-ext-type in this-procedure (
     1438       input tdedt.id  ,
     1439       input false  ,
     1440       output tdedt.name )
     1441        .
     1442                          end.
     1443   IF ep then  do:
     1444   create tdedt.
     1445   assign tdedt.id =  'ep':U
     1446          tdedt.n  = "03"
     1447   .
     1448   run get-name-from-ext-type in this-procedure (
