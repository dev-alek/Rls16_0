      879   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
      880   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
      881   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
      882   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
      883   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
      884   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
      885   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
      886   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
      887         adm-object-hdl = FRAME F-Main:HANDLE.
      888   RUN ensure-broker.
      889   THIS-PROCEDURE:ADM-DATA =
      890        'ADM1.1~`':U +
      891        'SmartViewer~`':U +
      892        '~`':U +
      893        'NO ~`':U +
      894        '~`':U +
      895        '~`':U +
      896        '~`':U +
      897        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
      898           + "~`":U +
      899        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add~`':U +
      900        'Record-Source,Record-Target,TableIO-Target~`':U +
      901        '~`':U +
      902        '~`~`~`~`~`~`~`~`~`~`~`':U +
      903        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
      904            THEN "^^":U
      905        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
      906             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
      907   PROCEDURE adm-apply-entry :
      908     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      909   END PROCEDURE.
      910   PROCEDURE adm-destroy :
      911    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      912   END PROCEDURE.
      913   PROCEDURE adm-disable :
      914       DISABLE RECT-14 RECT-15 RECT-16 RECT-12 ie ee CostSum ep DispUpFact es re Serv rs NullPer we vt iv CalcRest ev rv em wm im ot ap pc WITH FRAME F-Main.
      915       RUN dispatch ('disable-fields':U).
      916       RUN set-attribute-list ('ENABLED=no':U).
      917       RETURN.
      918   END PROCEDURE.
      919   PROCEDURE adm-edit-attribute-list :
      920         RUN adm/support/viewerd.w (INPUT THIS-PROCEDURE).
      921         RETURN.
      922   END PROCEDURE.
      923   PROCEDURE adm-enable :
      924       ENABLE UNLESS-HIDDEN RECT-14 RECT-15 RECT-16 RECT-12 ie ee CostSum ep DispUpFact es re Serv rs NullPer we vt iv CalcRest ev rv em wm im ot ap pc WITH FRAME F-Main.
      925       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
      926       RUN set-attribute-list ('ENABLED=yes':U).
      927       RETURN.
      928   END PROCEDURE.
      929   PROCEDURE adm-exit :
      930        RUN notify ('exit':U).
      931     RETURN.
      932   END PROCEDURE.
      933   PROCEDURE adm-hide :
      934     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      935   END PROCEDURE.
      936   PROCEDURE adm-initialize :
      937     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      938   END PROCEDURE.
      939   PROCEDURE adm-show-errors :
      940       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
      941       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
      942           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
      943       END.
      944       RETURN.
      945   END PROCEDURE.
      946   PROCEDURE adm-UIB-mode :
      947     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      948   END PROCEDURE.
      949   PROCEDURE adm-view :
      950     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      951   END PROCEDURE.
      952   PROCEDURE dispatch :
      953       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
      954       RUN broker-dispatch IN adm-broker-hdl
      955           (THIS-PROCEDURE, p-method-name) NO-ERROR.
      956       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
      957   END PROCEDURE.
      958   PROCEDURE ensure-broker :
      959   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
      960   IF RETURN-VALUE NE "ADM-Broker":U THEN
      961   DO:
      962       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
      963       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
      964   END.
      965   END PROCEDURE.
      966   PROCEDURE get-attribute :
      967     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
      968     RUN broker-get-attribute IN adm-broker-hdl
      969         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
      970     RETURN RETURN-VALUE.
      971   END PROCEDURE.
      972   PROCEDURE get-attribute-list :
      973     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
      974     RUN broker-get-attribute-list IN adm-broker-hdl
      975         (INPUT THIS-PROCEDURE,
      976          INPUT ?,
      977          OUTPUT p-attr-list) NO-ERROR.
      978     RETURN.
      979   END PROCEDURE.
      980   PROCEDURE new-state :
      981     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
      982     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
      983     RETURN.
      984   END PROCEDURE.
      985   PROCEDURE notify :
      986     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
      987     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
      988     IF RETURN-VALUE = "ADM-ERROR":U THEN
      989         RETURN "ADM-ERROR":U.
      990     RETURN.
      991   END PROCEDURE.
      992   PROCEDURE set-attribute-list :
      993     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
      994     RUN ensure-broker.
      995     RUN broker-set-attribute-list IN adm-broker-hdl
      996         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
      997     RETURN.
      998   END PROCEDURE.
      999   PROCEDURE set-position :
     1000       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
     1001       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
     1002       IF VALID-HANDLE(adm-object-hdl) THEN
     1003       DO:
     1004         ASSIGN adm-object-hdl:ROW    =   p-row
     1005                adm-object-hdl:COLUMN =   p-col.
     1006       END.
     1007       RETURN.
     1008   END PROCEDURE.
     1009   PROCEDURE adm-display-fields :
     1010       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
     1011       RETURN.
     1012   END PROCEDURE.
     1013   PROCEDURE adm-open-query :
     1014     RETURN.
     1015   END PROCEDURE.
     1016   PROCEDURE adm-row-changed :
     1017         IF VALID-HANDLE(adm-object-hdl) THEN
     1018           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     1019         RUN notify ('row-available':U).
     1020         RETURN.
     1021   END PROCEDURE.
     1022   PROCEDURE reposition-query :
     1023       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
     1024       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
     1025       RETURN.
     1026   END PROCEDURE.
     1027     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
     1028     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
     1029     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
     1030     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
     1031     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
     1032     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
     1033     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
     1034     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
     1035     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1036     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
     1037     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1038     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
     1039     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
     1040     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
     1041     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
     1042     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
     1043     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
     1044     IF "":U = "":U THEN
     1045       RUN modify-list-attribute IN adm-broker-hdl
     1046         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
     1047     RUN use-create-on-add(?).
     1048   PROCEDURE adm-add-record :
     1049       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     1050          "must have at least one Enabled Table to perform Add.":U
     1051          VIEW-AS ALERT-BOX ERROR.
