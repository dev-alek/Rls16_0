     1064   PROCEDURE adm-cancel-record :
     1065      RETURN.
     1066     END PROCEDURE.
     1067   PROCEDURE adm-copy-record :
     1068       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     1069        "must have at least one Enabled Table to perform Copy.":U
     1070          VIEW-AS ALERT-BOX ERROR.
     1071       RETURN.
     1072   END PROCEDURE.
     1073   PROCEDURE adm-create-record :
     1074      RETURN.
     1075   END PROCEDURE.
     1076   PROCEDURE adm-current-changed :
     1077     RETURN.
     1078   END PROCEDURE.
     1079   PROCEDURE adm-delete-record :
     1080    MESSAGE
     1081          "Object ":U THIS-PROCEDURE:FILE-NAME
     1082            "must have at least one Enabled Table to perform Delete.":U
     1083              VIEW-AS ALERT-BOX ERROR.
     1084       RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
     1085       RETURN.
