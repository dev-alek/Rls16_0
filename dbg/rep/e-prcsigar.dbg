      678   def var   ChosedType    as   integer no-undo.
      679   def var   name-Type     as   integer no-undo.
      680   def var State-source as  WIDGET-HANDLE.
      681   def var stat                as      log       init no           no-undo.
      682   RUN set-attribute-list (
      683       'Keys-Accepted = "",
      684        Keys-Supplied = ""':U).
      685   DEFINE VARIABLE MainTypes AS INTEGER
      686        VIEW-AS RADIO-SET VERTICAL
      687        RADIO-BUTTONS
      688             "Фактическое наличие", 1,
      689   "Только цены", 2
      690        SIZE 24 BY 2.33 NO-UNDO.
      691   DEFINE VARIABLE Rs-name AS INTEGER
      692        VIEW-AS RADIO-SET VERTICAL
      693        RADIO-BUTTONS
      694             "Полное название товара", 1,
      695   "Название на этикетке", 2
      696        SIZE 32 BY 2.5 NO-UNDO.
      697   DEFINE RECTANGLE RECT-1
      698        EDGE-PIXELS 3 GRAPHIC-EDGE  NO-FILL
      699        SIZE 40 BY 3.17.
      700   DEFINE RECTANGLE RECT-3
      701        EDGE-PIXELS 3 GRAPHIC-EDGE  NO-FILL
      702        SIZE 40 BY 3.58.
      703   DEFINE FRAME F-Main
      704        MainTypes AT ROW 1.75 COL 3.5 NO-LABEL
      705        Rs-name AT ROW 4.75 COL 3.5 NO-LABEL WIDGET-ID 2
      706        RECT-1 AT ROW 1.25 COL 2
      707        RECT-3 AT ROW 4.42 COL 2
      708       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
      709            SIDE-LABELS NO-UNDERLINE THREE-D
      710            AT COL 1 ROW 1 SCROLLABLE .
      711   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
      712   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
      713   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
      714   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
      715   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
      716   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
      717   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
      718   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
      719         adm-object-hdl = FRAME F-Main:HANDLE.
      720   RUN ensure-broker.
      721   THIS-PROCEDURE:ADM-DATA =
      722        'ADM1.1~`':U +
      723        'SmartObject~`':U +
      724        '~`':U +
      725        'NO ~`':U +
      726        '~`':U +
      727        '~`':U +
      728        '~`':U +
      729        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
      730           + "~`":U +
      731        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add~`':U +
      732        'Record-Source,Record-Target,TableIO-Target~`':U +
      733        '~`':U +
      734        '~`~`~`~`~`~`~`~`~`~`~`':U +
      735        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
      736            THEN "^^":U
      737        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
      738             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
      739   PROCEDURE adm-apply-entry :
      740     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      741   END PROCEDURE.
      742   PROCEDURE adm-destroy :
      743    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      744   END PROCEDURE.
      745   PROCEDURE adm-disable :
      746       DISABLE RECT-1 RECT-3 MainTypes Rs-name WITH FRAME F-Main.
      747       RUN dispatch ('disable-fields':U).
      748       RUN set-attribute-list ('ENABLED=no':U).
      749       RETURN.
      750   END PROCEDURE.
      751   PROCEDURE adm-edit-attribute-list :
      752         RUN adm/support/viewerd.w (INPUT THIS-PROCEDURE).
      753         RETURN.
      754   END PROCEDURE.
      755   PROCEDURE adm-enable :
      756       ENABLE UNLESS-HIDDEN RECT-1 RECT-3 MainTypes Rs-name WITH FRAME F-Main.
      757       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
      758       RUN set-attribute-list ('ENABLED=yes':U).
      759       RETURN.
      760   END PROCEDURE.
      761   PROCEDURE adm-exit :
      762        RUN notify ('exit':U).
      763     RETURN.
      764   END PROCEDURE.
      765   PROCEDURE adm-hide :
      766     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      767   END PROCEDURE.
      768   PROCEDURE adm-initialize :
      769     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      770   END PROCEDURE.
      771   PROCEDURE adm-show-errors :
      772       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
      773       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
      774           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
      775       END.
      776       RETURN.
      777   END PROCEDURE.
      778   PROCEDURE adm-UIB-mode :
      779     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      780   END PROCEDURE.
      781   PROCEDURE adm-view :
      782     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      783   END PROCEDURE.
      784   PROCEDURE dispatch :
      785       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
      786       RUN broker-dispatch IN adm-broker-hdl
      787           (THIS-PROCEDURE, p-method-name) NO-ERROR.
      788       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
      789   END PROCEDURE.
      790   PROCEDURE ensure-broker :
      791   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
      792   IF RETURN-VALUE NE "ADM-Broker":U THEN
      793   DO:
      794       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
      795       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
      796   END.
      797   END PROCEDURE.
      798   PROCEDURE get-attribute :
      799     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
      800     RUN broker-get-attribute IN adm-broker-hdl
      801         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
      802     RETURN RETURN-VALUE.
      803   END PROCEDURE.
      804   PROCEDURE get-attribute-list :
      805     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
      806     RUN broker-get-attribute-list IN adm-broker-hdl
      807         (INPUT THIS-PROCEDURE,
      808          INPUT ?,
      809          OUTPUT p-attr-list) NO-ERROR.
      810     RETURN.
      811   END PROCEDURE.
      812   PROCEDURE new-state :
      813     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
      814     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
      815     RETURN.
      816   END PROCEDURE.
      817   PROCEDURE notify :
      818     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
      819     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
      820     IF RETURN-VALUE = "ADM-ERROR":U THEN
      821         RETURN "ADM-ERROR":U.
      822     RETURN.
      823   END PROCEDURE.
      824   PROCEDURE set-attribute-list :
      825     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
      826     RUN ensure-broker.
      827     RUN broker-set-attribute-list IN adm-broker-hdl
      828         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
      829     RETURN.
      830   END PROCEDURE.
      831   PROCEDURE set-position :
      832       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
      833       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
      834       IF VALID-HANDLE(adm-object-hdl) THEN
      835       DO:
      836         ASSIGN adm-object-hdl:ROW    =   p-row
      837                adm-object-hdl:COLUMN =   p-col.
      838       END.
      839       RETURN.
      840   END PROCEDURE.
      841   PROCEDURE adm-display-fields :
      842       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
      843       RETURN.
      844   END PROCEDURE.
      845   PROCEDURE adm-open-query :
      846     RETURN.
      847   END PROCEDURE.
      848   PROCEDURE adm-row-changed :
      849         IF VALID-HANDLE(adm-object-hdl) THEN
      850           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
      851         RUN notify ('row-available':U).
      852         RETURN.
      853   END PROCEDURE.
      854   PROCEDURE reposition-query :
      855       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
      856       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
      857       RETURN.
      858   END PROCEDURE.
      859     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
      860     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
      861     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
      862     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
      863     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
      864     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
      865     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
      866     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
      867     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
      868     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
      869     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
      870     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
      871     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
      872     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
      873     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
      874     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
      875     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
      876     IF "":U = "":U THEN
      877       RUN modify-list-attribute IN adm-broker-hdl
      878         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
      879     RUN use-create-on-add(?).
      880   PROCEDURE adm-add-record :
