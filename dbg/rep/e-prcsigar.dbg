      932   PROCEDURE adm-update-record :
      933       MESSAGE
      934         "Object ":U THIS-PROCEDURE:FILE-NAME
      935           "must have at least one Enabled Table to perform Update.":U
      936             VIEW-AS ALERT-BOX ERROR.
      937      RETURN.
      938   END PROCEDURE.
      939   PROCEDURE check-modified :
      940   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
      941   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
      942   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
      943   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
      944     IF check-state = "check":U THEN
      945     DO:
      946       RUN get-link-handle IN adm-broker-hdl
      947         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
      948            OUTPUT group-target-list).
      949       IF group-target-list NE "":U THEN
      950       DO i = 1 TO NUM-ENTRIES(group-target-list):
      951         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
      952         RUN check-modified IN curr-widget ('group-check':U).
      953         IF RETURN-VALUE NE "":U THEN
      954         DO:
      955           RUN check-modified-message(RETURN-VALUE).
      956           RETURN "":U.
      957         END.
      958       END.
      959     END.
      960     RETURN "":U.
      961   END PROCEDURE.
      962   PROCEDURE check-modified-message :
      963     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
      964        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
      965           'CONTAINER-SOURCE':U, 'HIDDEN':U).
      966        IF RETURN-VALUE = "YES":U THEN
      967           RUN notify ('view,CONTAINER-SOURCE':U).
      968        MESSAGE IF p-changed-table NE ? THEN
      969           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
      970           ELSE "Current values have been changed."
      971           SKIP "  Do you wish to save those changes?"
      972           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
      973        IF ANS THEN
      974        DO:
      975           IF group-assign-target THEN
      976             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
      977           ELSE RUN dispatch('update-record':U).
      978           IF RETURN-VALUE = "ADM-ERROR":U THEN
      979           DO:
      980               MESSAGE "Changes to the previous record were not saved."
      981                 VIEW-AS ALERT-BOX ERROR.
      982               IF group-assign-target THEN
      983                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
      984               ELSE RUN dispatch ('cancel-record':U).
      985           END.
      986        END.
      987        ELSE DO:
      988          IF group-assign-target THEN
      989             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
      990          ELSE RUN dispatch('cancel-record':U).
      991        END.
      992        RETURN.
      993   END PROCEDURE.
      994   PROCEDURE get-rowid :
      995       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
      996       ASSIGN
      997       p-table   =   adm-first-table.
      998       RETURN.
      999   END PROCEDURE.
     1000   PROCEDURE init-group-assign :
     1001       RUN request-attribute IN adm-broker-hdl
     1002         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
     1003       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
     1004         group-assign-target = yes.
     1005       ELSE group-assign-target = no.
     1006       RETURN.
     1007   END PROCEDURE.
     1008   PROCEDURE set-editors :
     1009       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
     1010       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
     1011       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
     1012       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
     1013       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
     1014       DO WHILE VALID-HANDLE (curr-widget):
     1015           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
     1016              curr-widget:HIDDEN = no THEN DO:
     1017             CASE p-field-setting:
     1018               WHEN "INITIALIZE":U THEN
     1019               DO:
     1020                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
     1021                     read-only-list +
     1022                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
     1023                        STRING(curr-widget).
     1024               END.
     1025               WHEN "DISABLE":U OR
     1026               WHEN "ENABLE":U THEN
     1027               DO:
     1028                   curr-widget:SENSITIVE = yes.
     1029                   RUN get-attribute ('Read-Only-Editors':U).
     1030                   IF RETURN-VALUE = ? OR
     1031                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
     1032                       curr-widget:READ-ONLY =
     1033                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
     1034               END.
     1035               WHEN "CLEAR":U THEN
     1036                   curr-widget:SCREEN-VALUE = "":U.
     1037             END CASE.
     1038           END.
     1039           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
     1040       END.
     1041       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
     1042         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
     1043           + '"':U).
     1044       RETURN.
     1045   END PROCEDURE.
     1046   PROCEDURE use-check-modified-all :
     1047    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1048     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
     1049     RETURN.
     1050   END PROCEDURE.
     1051   PROCEDURE use-create-on-add :
     1052   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1053      RETURN.
     1054   END PROCEDURE.
     1055   PROCEDURE use-initial-lock :
     1056     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1057     ASSIGN adm-initial-lock = p-attr-value.
     1058     RETURN.
     1059   END PROCEDURE.
     1060     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
     1061   ASSIGN
     1062          FRAME F-Main:SCROLLABLE       = FALSE
     1063          FRAME F-Main:HIDDEN           = TRUE.
     1064   if not this-procedure :persistent
     1065   then do:
     1066     message
     1067       vss-workfile vss-revision vss-description skip
     1068       "Ошибка при запуске процедуры" skip
     1069       "Данную процедуру следует запускать только с параметром persistent" skip
     1070       view-as alert-box error .
     1071     undo, return error .
     1072   end.
     1073   PROCEDURE adm-row-available :
     1074     DEFINE VARIABLE tbl-list           AS CHARACTER INIT "":U NO-UNDO.
     1075     DEFINE VARIABLE rowid-list         AS CHARACTER NO-UNDO.
     1076     DEFINE VARIABLE row-avail-cntr     AS INTEGER INIT 0 NO-UNDO.
     1077     DEFINE VARIABLE row-avail-rowid    AS ROWID NO-UNDO.
     1078     DEFINE VARIABLE row-avail-enabled  AS LOGICAL NO-UNDO.
     1079     DEFINE VARIABLE link-handle        AS CHARACTER NO-UNDO.
     1080     DEFINE VARIABLE record-source-hdl  AS HANDLE NO-UNDO.
     1081     DEFINE VARIABLE different-row      AS LOGICAL NO-UNDO INIT no.
     1082     DEFINE VARIABLE key-name           AS CHARACTER INIT ? NO-UNDO.
     1083     DEFINE VARIABLE key-value          AS CHARACTER INIT ? NO-UNDO.
     1084     RUN check-modified IN THIS-PROCEDURE ('check':U) NO-ERROR.
     1085     IF adm-updating-record THEN RETURN.
     1086     RUN get-attribute ('FIELDS-ENABLED':U).
     1087     row-avail-enabled = IF RETURN-VALUE = "YES":U THEN yes ELSE no.
     1088     RUN get-link-handle IN adm-broker-hdl (THIS-PROCEDURE, 'RECORD-SOURCE':U,
     1089         OUTPUT link-handle) NO-ERROR.
     1090     IF link-handle = "":U THEN
     1091         RETURN.
     1092     ASSIGN record-source-hdl = WIDGET-HANDLE(ENTRY(1,link-handle)).
     1093     IF NUM-ENTRIES(link-handle) > 1 THEN
     1094         MESSAGE "row-available in ":U THIS-PROCEDURE:FILE-NAME
     1095             "encountered more than one RECORD-SOURCE.":U SKIP
     1096             "The first - ":U record-source-hdl:file-name " - will be used.":U
     1097                VIEW-AS ALERT-BOX ERROR.
     1098     RUN get-attribute ('Key-Name':U).
     1099     key-name = RETURN-VALUE.
     1100     IF key-name = "":U THEN key-name = ?.
     1101     IF key-name NE ? THEN DO:
     1102       RUN send-key IN record-source-hdl (INPUT key-name, OUTPUT key-value)
     1103         NO-ERROR.
     1104       IF key-value NE ? THEN
     1105         RUN set-attribute-list (SUBSTITUTE ('Key-Value="&1"':U, key-value)).
     1106     END.
     1107   IF VALID-HANDLE (adm-object-hdl) THEN
     1108       RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     1109   RUN notify IN THIS-PROCEDURE ('row-available':U).
     1110   END PROCEDURE.
     1111   PROCEDURE disable_UI :
     1112     HIDE FRAME F-Main.
     1113     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1114   END PROCEDURE.
     1115   PROCEDURE local-initialize :
     1116     RUN dispatch IN THIS-PROCEDURE ( INPUT 'initialize':U ) .
     1117   END PROCEDURE.
     1118   PROCEDURE my-report :
     1119   run rep/r-prcsigar.p
     1120       ( ChosedType ,
     1121         name-Type   ).
     1122   END PROCEDURE.
     1123   PROCEDURE my-var :
     1124       ChosedType = integer(MainTypes:screen-value in frame F-Main).
     1125       name-type = int(rs-name:screen-value) .
     1126   END PROCEDURE.
     1127   PROCEDURE send-records :
     1128   END PROCEDURE.
     1129   PROCEDURE state-changed :
     1130     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE    NO-UNDO.
     1131     DEFINE INPUT PARAMETER p-state      AS CHARACTER NO-UNDO.
     1132     CASE p-state:
     1133       WHEN 'update-begin':U THEN DO:
     1134           RUN dispatch('enable-fields':U).
     1135           IF RETURN-VALUE = "ADM-ERROR":U THEN
     1136           DO:
     1137             RUN new-state('update-failed,TABLEIO-SOURCE':U).
     1138             RUN new-state('update-complete':U).
     1139           END.
     1140           ELSE RUN new-state ('update':U).
     1141       END.
     1142       WHEN 'update-complete':U THEN DO:
     1143           RUN new-state ('update-complete':U).
     1144       END.
     1145     END CASE.
     1146   END PROCEDURE.
