     1135       End.
     1136       run gbl/prnfilen.w
     1137         (input  ""
     1138         ,input  p-DisabledOptions
     1139         ,input  string(v-report-name )
     1140         ,input  7
     1141         ,output v-user-action
     1142         ,output v-printed
     1143         ) .
