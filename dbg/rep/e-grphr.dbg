     1377   END PROCEDURE.
     1378   PROCEDURE adm-disable :
     1379       DISABLE T-dis-card BR-dis-card-type WithGoods T-scale RS-OPTION WITH FRAME F-Main.
     1380       RUN dispatch ('disable-fields':U).
     1381       RUN set-attribute-list ('ENABLED=no':U).
     1382       RETURN.
     1383   END PROCEDURE.
     1384   PROCEDURE adm-edit-attribute-list :
     1385         RUN adm/support/contnrd.w (INPUT THIS-PROCEDURE).
     1386         RETURN.
     1387   END PROCEDURE.
     1388   PROCEDURE adm-enable :
     1389       ENABLE UNLESS-HIDDEN T-dis-card BR-dis-card-type WithGoods T-scale RS-OPTION WITH FRAME F-Main.
     1390       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
     1391       RUN set-attribute-list ('ENABLED=yes':U).
     1392       RETURN.
     1393   END PROCEDURE.
     1394   PROCEDURE adm-exit :
     1395        RUN notify ('exit':U).
     1396     RETURN.
     1397   END PROCEDURE.
     1398   PROCEDURE adm-hide :
     1399     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1400   END PROCEDURE.
     1401   PROCEDURE adm-initialize :
     1402     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1403   END PROCEDURE.
     1404   PROCEDURE adm-show-errors :
     1405       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
     1406       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
     1407           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
     1408       END.
     1409       RETURN.
     1410   END PROCEDURE.
     1411   PROCEDURE adm-UIB-mode :
     1412     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1413   END PROCEDURE.
     1414   PROCEDURE adm-view :
     1415     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1416   END PROCEDURE.
     1417   PROCEDURE dispatch :
     1418       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
     1419       RUN broker-dispatch IN adm-broker-hdl
     1420           (THIS-PROCEDURE, p-method-name) NO-ERROR.
     1421       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
     1422   END PROCEDURE.
     1423   PROCEDURE ensure-broker :
     1424   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
     1425   IF RETURN-VALUE NE "ADM-Broker":U THEN
     1426   DO:
     1427       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
     1428       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
     1429   END.
     1430   END PROCEDURE.
     1431   PROCEDURE get-attribute :
     1432     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
     1433     RUN broker-get-attribute IN adm-broker-hdl
     1434         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
     1435     RETURN RETURN-VALUE.
     1436   END PROCEDURE.
     1437   PROCEDURE get-attribute-list :
     1438     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
     1439     RUN broker-get-attribute-list IN adm-broker-hdl
     1440         (INPUT THIS-PROCEDURE,
     1441          INPUT ?,
     1442          OUTPUT p-attr-list) NO-ERROR.
     1443     RETURN.
     1444   END PROCEDURE.
     1445   PROCEDURE new-state :
     1446     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     1447     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
     1448     RETURN.
     1449   END PROCEDURE.
     1450   PROCEDURE notify :
     1451     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
     1452     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
     1453     IF RETURN-VALUE = "ADM-ERROR":U THEN
     1454         RETURN "ADM-ERROR":U.
     1455     RETURN.
     1456   END PROCEDURE.
     1457   PROCEDURE set-attribute-list :
     1458     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
     1459     RUN ensure-broker.
     1460     RUN broker-set-attribute-list IN adm-broker-hdl
     1461         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
     1462     RETURN.
     1463   END PROCEDURE.
     1464   PROCEDURE set-position :
     1465       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
     1466       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
     1467       IF VALID-HANDLE(adm-object-hdl) THEN
     1468       DO:
     1469           DEFINE VARIABLE parent-hdl AS HANDLE NO-UNDO.
     1470           IF adm-object-hdl:TYPE = "WINDOW":U THEN
     1471           DO:
     1472             IF p-row = 0 THEN p-row =
     1473               (SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2.
     1474             IF p-col = 0 THEN p-col =
     1475               (SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2.
     1476           END.
     1477           ELSE IF adm-object-hdl:TYPE = "DIALOG-BOX":U THEN
     1478           DO:
     1479             parent-hdl = adm-object-hdl:PARENT.
     1480             IF p-row = 0 THEN p-row =
     1481               ((SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2) -
     1482                 parent-hdl:ROW.
     1483             IF p-col = 0 THEN p-col =
     1484               ((SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2) -
     1485                 parent-hdl:COL.
     1486           END.
     1487           IF p-row GE 0 AND p-row < 1 THEN p-row = 1.
     1488           IF p-col GE 0 AND p-col < 1 THEN p-col = 1.
     1489         ASSIGN adm-object-hdl:ROW    =   p-row
     1490                adm-object-hdl:COLUMN =   p-col.
     1491       END.
     1492       RETURN.
     1493   END PROCEDURE.
     1494   RUN set-attribute-list ("CURRENT-PAGE=0,ADM-OBJECT-HANDLE=":U +
     1495       STRING(adm-object-hdl)).
     1496   PAUSE 0 BEFORE-HIDE.
     1497   PROCEDURE adm-change-page :
     1498     RUN broker-change-page IN adm-broker-hdl (INPUT THIS-PROCEDURE) NO-ERROR.
     1499     END PROCEDURE.
     1500   PROCEDURE delete-page :
     1501     DEFINE INPUT PARAMETER p-page# AS INTEGER NO-UNDO.
     1502     RUN broker-delete-page IN adm-broker-hdl
     1503         (INPUT THIS-PROCEDURE, INPUT p-page#).
     1504     END PROCEDURE.
     1505   PROCEDURE init-object :
     1506     DEFINE INPUT PARAMETER  p-proc-name   AS CHARACTER NO-UNDO.
     1507     DEFINE INPUT PARAMETER  p-parent-hdl  AS HANDLE    NO-UNDO.
     1508     DEFINE INPUT PARAMETER  p-attr-list   AS CHARACTER NO-UNDO.
     1509     DEFINE OUTPUT PARAMETER p-proc-hdl    AS HANDLE    NO-UNDO.
     1510     RUN broker-init-object IN adm-broker-hdl
     1511         (INPUT THIS-PROCEDURE, INPUT p-proc-name, INPUT p-parent-hdl,
     1512          INPUT p-attr-list, OUTPUT p-proc-hdl) NO-ERROR.
     1513     RETURN.
     1514   END PROCEDURE.
     1515   PROCEDURE init-pages :
     1516     DEFINE INPUT PARAMETER p-page-list      AS CHARACTER NO-UNDO.
     1517     RUN broker-init-pages IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     1518         INPUT p-page-list) NO-ERROR.
     1519     END PROCEDURE.
     1520   PROCEDURE select-page :
     1521     DEFINE INPUT PARAMETER p-page#     AS INTEGER   NO-UNDO.
     1522     RUN broker-select-page IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     1523         INPUT p-page#) NO-ERROR.
     1524     END PROCEDURE.
     1525   PROCEDURE view-page :
     1526     DEFINE INPUT PARAMETER p-page#      AS INTEGER   NO-UNDO.
     1527     RUN broker-view-page IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     1528         INPUT p-page#).
     1529     END PROCEDURE.
     1530   ASSIGN
     1531          BR-dis-card-type:HIDDEN  IN FRAME F-Main                = TRUE.
     1532   ASSIGN
     1533          T-scale:HIDDEN IN FRAME F-Main           = TRUE.
     1534   ON VALUE-CHANGED OF RS-dis-card IN FRAME F-Main
     1535   DO:
     1536   DEFINE VARIABLE varrid-list as character no-undo.
     1537     ASSIGN
     1538     RS-dis-card.
     1539     CASE RS-dis-card:
     1540       when 1 then do:
     1541           run ref/dc-types.w (
     1542                          input my-handle
     1543                         ,INPUT "":U
     1544                         ,INPUT "b-sel,b-mark":U
     1545                         ,INPUT 0
     1546                         ,INPUT v-cntxt-host-code-obj
     1547                         ,INPUT v-cntxt-obj-type
     1548                         ,INPUT v-cntxt-obj-code
     1549                         ,input-OUTPUT varrid-list).
     1550           if varrid-list = "" then do:
     1551               for each temp-dis-card-type:
     1552                   delete temp-dis-card-type.
     1553               end.
     1554               rs-dis-card = 0.
     1555               OPEN QUERY BR-dis-card-type FOR EACH temp-dis-card-type NO-LOCK.
     1556               DISPLAY
     1557               rs-dis-card
     1558               with frame F-Main.
     1559               HIDE
     1560               br-dis-card-type
     1561               in frame F-Main.
     1562           end.
     1563           else dO:
     1564             DO ii = 1 to num-entries(varrid-list):
     1565               FIND FIRST ub.dis-card-type No-LOCK WHERE
     1566                                 recid(ub.dis-card-type) = integer(entry(ii, varrid-list)) No-ERROR.
     1567             if avail ub.dis-card-type then dO:
     1568               create temp-dis-card-type.
     1569               buffer-copy ub.dis-card-type to temp-dis-card-type.
     1570             END.
     1571           END.
     1572           OPEN QUERY BR-dis-card-type FOR EACH temp-dis-card-type NO-LOCK.
     1573           DISPLAY
     1574           br-dis-card-type
     1575           with frame F-Main .
     1576         end.
     1577       end.
     1578       when 0 then do:
     1579         for each temp-dis-card-type:
     1580           delete temp-dis-card-type.
     1581         end.
     1582        OPEN QUERY BR-dis-card-type FOR EACH temp-dis-card-type NO-LOCK.
     1583         HIDE
     1584         br-dis-card-type
     1585         in frame F-Main.
     1586       end.
     1587     END CASE.
     1588   END.
     1589   ON VALUE-CHANGED OF RS-OPTION IN FRAME F-Main
     1590   DO:
     1591       assign RS-OPTION .
     1592       IF RS-OPTION = 3 then do:
     1593           WithGoods = no.
     1594           t-scale = no.
     1595           Display WithGoods t-scale With frame F-Main.
     1596           Disable WithGoods t-scale with frame F-Main.
     1597           hide t-scale
     1598           in frame F-Main .
     1599       end.
     1600       else do:
     1601           ENABLE WithGoods with frame F-Main.
     1602       end.
     1603   END.
     1604   ON VALUE-CHANGED OF T-dis-card IN FRAME F-Main
     1605   DO:
     1606     assign
     1607     t-dis-card.
     1608     CASE t-dis-card:
     1609       when yes then do:
     1610           assign
     1611           Rs-dis-card = 0.
     1612           DISPLAY
     1613           RS-dis-card
     1614           with frame F-Main.
     1615           ENABLE
     1616           RS-dis-card
     1617           with frame F-Main.
     1618       end.
     1619       when no then do:
     1620           assign
     1621           Rs-dis-card = 0.
     1622           DISABLE
     1623           RS-dis-card
     1624           with frame F-Main.
     1625       end.
     1626     END CASE.
     1627   END.
     1628   ON VALUE-CHANGED OF WithGoods IN FRAME F-Main
     1629   DO:
     1630       run ini-t-scale in this-procedure.
     1631   END.
     1632   if not this-procedure :persistent
     1633   then do:
     1634     message
     1635       vss-workfile vss-revision vss-description skip
     1636       "Ошибка при запуске процедуры" skip
     1637       "Данную процедуру следует запускать только с параметром persistent" skip
     1638       view-as alert-box error .
     1639     undo, return error .
     1640   end.
     1641   assign
     1642   loc#db-num = v-cntxt-db-num
     1643   loc#host-code = v-cntxt-host-code-obj
     1644   loc#store-code = v-cntxt-obj-code
     1645   .
     1646   PROCEDURE adm-create-objects :
     1647     DEFINE VARIABLE adm-current-page  AS INTEGER NO-UNDO.
     1648     RUN get-attribute IN THIS-PROCEDURE ('Current-Page':U).
     1649     ASSIGN adm-current-page = INTEGER(RETURN-VALUE).
     1650     CASE adm-current-page:
     1651       WHEN 0 THEN DO:
     1652          RUN init-object IN THIS-PROCEDURE (
     1653                INPUT  'rep/s-hour.w':U ,
     1654                INPUT  FRAME F-Main:HANDLE ,
     1655                INPUT  '':U ,
     1656                OUTPUT h_s-hour ).
     1657          RUN add-link IN adm-broker-hdl ( h_s-hour , 'State':U , THIS-PROCEDURE ).
     1658          RUN adjust-tab-order IN adm-broker-hdl ( h_s-hour ,
     1659                T-dis-card:HANDLE IN FRAME F-Main , 'BEFORE':U ).
     1660       END.
     1661     END CASE.
     1662   END PROCEDURE.
     1663   PROCEDURE adm-row-available :
     1664     DEFINE VARIABLE tbl-list           AS CHARACTER INIT "":U NO-UNDO.
     1665     DEFINE VARIABLE rowid-list         AS CHARACTER NO-UNDO.
     1666     DEFINE VARIABLE row-avail-cntr     AS INTEGER INIT 0 NO-UNDO.
     1667     DEFINE VARIABLE row-avail-rowid    AS ROWID NO-UNDO.
     1668     DEFINE VARIABLE row-avail-enabled  AS LOGICAL NO-UNDO.
     1669     DEFINE VARIABLE link-handle        AS CHARACTER NO-UNDO.
     1670     DEFINE VARIABLE record-source-hdl  AS HANDLE NO-UNDO.
     1671     DEFINE VARIABLE different-row      AS LOGICAL NO-UNDO INIT no.
     1672     DEFINE VARIABLE key-name           AS CHARACTER INIT ? NO-UNDO.
     1673     DEFINE VARIABLE key-value          AS CHARACTER INIT ? NO-UNDO.
     1674     RUN check-modified IN THIS-PROCEDURE ('check':U) NO-ERROR.
     1675     IF adm-updating-record THEN RETURN.
     1676     RUN get-attribute ('FIELDS-ENABLED':U).
     1677     row-avail-enabled = IF RETURN-VALUE = "YES":U THEN yes ELSE no.
     1678     RUN get-link-handle IN adm-broker-hdl (THIS-PROCEDURE, 'RECORD-SOURCE':U,
     1679         OUTPUT link-handle) NO-ERROR.
     1680     IF link-handle = "":U THEN
     1681         RETURN.
     1682     ASSIGN record-source-hdl = WIDGET-HANDLE(ENTRY(1,link-handle)).
     1683     IF NUM-ENTRIES(link-handle) > 1 THEN
     1684         MESSAGE "row-available in ":U THIS-PROCEDURE:FILE-NAME
     1685             "encountered more than one RECORD-SOURCE.":U SKIP
     1686             "The first - ":U record-source-hdl:file-name " - will be used.":U
     1687                VIEW-AS ALERT-BOX ERROR.
     1688     RUN get-attribute ('Key-Name':U).
     1689     key-name = RETURN-VALUE.
     1690     IF key-name = "":U THEN key-name = ?.
     1691     IF key-name NE ? THEN DO:
     1692       RUN send-key IN record-source-hdl (INPUT key-name, OUTPUT key-value)
     1693         NO-ERROR.
     1694       IF key-value NE ? THEN
     1695         RUN set-attribute-list (SUBSTITUTE ('Key-Value="&1"':U, key-value)).
     1696     END.
     1697   IF VALID-HANDLE (adm-object-hdl) THEN
     1698       RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     1699   RUN notify IN THIS-PROCEDURE ('row-available':U).
     1700   END PROCEDURE.
     1701   PROCEDURE disable_UI :
     1702     HIDE FRAME F-Main.
     1703     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1704   END PROCEDURE.
     1705   PROCEDURE enable_UI :
     1706     DISPLAY T-dis-card RS-dis-card WithGoods T-scale RS-OPTION
     1707         WITH FRAME F-Main.
     1708     ENABLE T-dis-card BR-dis-card-type WithGoods T-scale RS-OPTION
     1709         WITH FRAME F-Main.
     1710     OPEN QUERY BR-dis-card-type FOR EACH temp-dis-card-type NO-LOCK.
     1711   END PROCEDURE.
     1712   PROCEDURE ini-from-selobj :
     1713   DEFINE INPUT PARAMETER myp-state as character no-undo.
     1714       CASE myp-state:
     1715           WHEN 'все':U then do:
     1716                   ENABLE RS-OPTION with frame F-Main.
     1717           END.
     1718           WHEN "Текущий" then do:
     1719                   assign
     1720                    RS-OPTION = 1.
     1721                    Display RS-OPTION with frame F-Main.
     1722                    DISABLE RS-OPTION with frame F-Main.
     1723           END.
     1724           WHEN "Выборочно" then do:
     1725               if can-find(FIRST obj-list) then ENABLE RS-OPTION WITH FRAME F-Main.
     1726           END.
     1727       END CASE.
     1728   END PROCEDURE.
     1729   PROCEDURE ini-t-scale :
     1730   assign
     1731        frame F-Main
     1732         WithGoods
     1733         .
     1734        CASE WithGoods:
     1735           when yes then do:
     1736               display
     1737               t-scale
     1738               with frame F-Main.
     1739           end.
     1740           WHEN NO THEN do:
     1741               ASSIGN
     1742               T-SCALE = NO.
     1743               hIDE
     1744               T-SCALE
     1745               iN FRAME F-Main.
     1746           end.
     1747        END case.
     1748   END PROCEDURE.
     1749   PROCEDURE local-initialize :
     1750     RUN dispatch IN THIS-PROCEDURE ( INPUT 'initialize':U ) .
     1751     run ini-from-selobj in h_s-hour.
     1752     APPLY "VALUE-CHANGED" to T-dis-card in frame F-Main.
     1753     APPLY "VALUE-CHANGED" to RS-dis-card in frame F-Main.
     1754    run ini-t-scale in this-procedure.
     1755    parparentproc = my-handle.
     1756   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1757     run mainmenu_getcntxt in parparentproc
     1758       (output v-cntxt-db-num
     1759       ,output v-cntxt-userid
     1760       ,output v-cntxt-level
     1761       ,output v-cntxt-host-code-obj
     1762       ,output v-cntxt-obj-type
     1763       ,output v-cntxt-obj-code
     1764       ,output v-cntxt-db-num-obj
     1765       ,output v-cntxt-is-admin
     1766       ) .
     1767   END PROCEDURE.
     1768   PROCEDURE My-report :
     1769   define variable num-cols as integer.
     1770   define variable choice as integer.
     1771   define variable for-h as logical extent 24 no-undo.
     1772   DEFINE VARIABLE for-h-str as character no-undo .
     1773   define variable glog as logical no-undo .
     1774   run Assign-Frame in h_s-hour.
     1775   assign
     1776   FRAME F-Main RS-OPTION
     1777   FRAME F-Main WithGoods
     1778   .
     1779   run My-var.
     1780   if vH-0 then for-h[1] = yes. else for-h[1] = no.
     1781   if vH-1 then for-h[2] = yes. else for-h[2] = no.
     1782   if vH-2 then for-h[3] = yes. else for-h[3] = no.
     1783   if vH-3 then for-h[4] = yes. else for-h[4] = no.
     1784   if vH-4 then for-h[5] = yes. else for-h[5] = no.
     1785   if vH-5 then for-h[6] = yes. else for-h[6] = no.
     1786   if vH-6 then for-h[7] = yes. else for-h[7] = no.
     1787   if vH-7 then for-h[8] = yes. else for-h[8] = no.
     1788   if vH-8 then for-h[9] = yes. else for-h[9] = no.
     1789   if vH-9 then for-h[10] = yes. else for-h[10] = no.
     1790   if vH-10 then for-h[11] = yes. else for-h[11] = no.
     1791   if vH-11 then for-h[12] = yes. else for-h[12] = no.
     1792   if vH-12 then for-h[13] = yes. else for-h[13] = no.
     1793   if vH-13 then for-h[14] = yes. else for-h[14] = no.
     1794   if vH-14 then for-h[15] = yes. else for-h[15] = no.
     1795   if vH-15 then for-h[16] = yes. else for-h[16] = no.
     1796   if vH-16 then for-h[17] = yes. else for-h[17] = no.
     1797   if vH-17 then for-h[18] = yes. else for-h[18] = no.
     1798   if vH-18 then for-h[19] = yes. else for-h[19] = no.
     1799   if vH-19 then for-h[20] = yes. else for-h[20] = no.
     1800   if vH-20 then for-h[21] = yes. else for-h[21] = no.
     1801   if vH-21 then for-h[22] = yes. else for-h[22] = no.
     1802   if vH-22 then for-h[23] = yes. else for-h[23] = no.
     1803   if vH-23 then for-h[24] = yes. else for-h[24] = no.
     1804   num-cols = ( integer( vH-0 ) + integer( vH-1 ) + integer( vH-2 ) + integer( vH-3 ) + integer( vH-4 ) +
     1805                integer( vH-5 ) + integer( vH-6 ) + integer( vH-7 ) + integer( vH-8 ) + integer( vH-9 ) +
     1806                integer( vH-10 ) + integer( vH-11 ) + integer( vH-12 ) + integer( vH-13 ) + integer( vH-14 ) +
     1807                integer( vH-15 ) + integer( vH-16 ) + integer( vH-17 ) + integer( vH-18 ) + integer( vH-19 ) +
     1808                integer( vH-20 ) + integer( vH-21 ) + integer( vH-22 ) + integer( vH-23 ) ).
     1809   glog = ?.
     1810   if ((num-cols > 10 AND num-cols < 14 AND RS-OPTION < 3) OR (num-cols > 11 AND num-cols < 15 AND RS-OPTION =3 ) ) and NOT vXL
     1811   then do:
     1812     run gbl/d-askw.w (input "Формат вывода",
     1813                  input ("Количество интересующих Вас интервалов времени больше 10 :" + chr(10) +
     1814                         "отчет не уместится на бумаге формата А4 (ориентация альбомная)"
     1815                         ),
     1816                  input "|",
     1817                  input ("Выводить в Excel|" +
     1818                         "Формат А3 (ориентация альбомная)|" +
     1819                         "Уменьшить количество интервалов"),
     1820                  input "||",
     1821                  input 1,
     1822                  input 3,
     1823                  output choice).
     1824     if choice = 3 then return no-apply.
     1825     if choice = 1 then vxl = yes.
     1826     run display_ in h_s-hour.
     1827   end.
     1828   else if ((num-cols >=14 AND RS-OPTION < 3) OR (num-cols >=15 AND RS-OPTION = 3)) AND NOT vXL then do:
     1829       run gbl/d-askw.w (input "Формат вывода",
     1830                    input ("Количество интересующих Вас интервалов времени больше 13 :" + chr(10) +
     1831                           "отчет не уместится на бумаге формата А3 (ориентация альбомная)"
     1832                          ),
     1833                    input "|",
     1834                    input ("Выводить в Excel|" +
     1835                           "Уменьшить количество интервалов"),
     1836                    input "|",
     1837                    input 1,
     1838                    input 2,
     1839                    output choice).
     1840       if choice = 2 then return no-apply.
     1841       vxl = yes.
     1842       run display_ in h_s-hour.
     1843   end.
     1844   if ( integer( vH-0 ) + integer( vH-1 ) + integer( vH-2 ) + integer( vH-3 ) + integer( vH-4 ) +
     1845        integer( vH-5 ) + integer( vH-6 ) + integer( vH-7 ) + integer( vH-8 ) + integer( vH-9 ) +
     1846        integer( vH-10 ) + integer( vH-11 ) + integer( vH-12 ) + integer( vH-13 ) + integer( vH-14 ) +
     1847        integer( vH-15 ) + integer( vH-16 ) + integer( vH-17 ) + integer( vH-18 ) + integer( vH-19 ) +
     1848        integer( vH-20 ) + integer( vH-21 ) + integer( vH-22 ) + integer( vH-23 ) ) = 0
     1849   then do:
     1850       message "Вы не определили," skip
     1851                       "какие интервалы времени" skip
     1852                       "Вас интересуют."     view-as alert-box ERROR .
     1853       return no-apply.
     1854   end.
     1855   else do:
     1856   run waitfram-show in this-procedure ( "Подождите ..." ).
     1857     do ii = 1 to 24:
     1858       for-h-str = for-h-str + string(for-h[ii]) + chr(44).
     1859     end.
     1860     for-h-str = right-trim(for-h-str, chr(44)).
     1861     run rep/r-grphr.p (
     1862                   input for-h-str
     1863                   ,input RS-option
     1864                   ,input WithGoods
     1865                   ,input T-dis-card
     1866                   ,input Rs-dis-card
     1867                   ,input t-scale
     1868                   ,input X-selectGood
     1869                   )  no-error .
     1870     if error-status:error then do:
     1871       run waitfram-hide in this-procedure .
     1872       message
     1873       vss-workfile vss-revision vss-description skip
     1874       error-status:get-message(1) skip
     1875       return-value
     1876       view-as alert-box error .
     1877       return.
     1878     end.
     1879     run waitfram-hide in this-procedure .
     1880     if can-find( first grp-h ) then do:
     1881       if vXL then do:
     1882         define variable p-XL-delim as character no-undo .
     1883         define variable type-par1 as character no-undo .
     1884         define variable tmp-var1  as character no-undo .
     1885   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1886   empty temp-table thbjattr_thbj-attr.
     1887   run adm/shattri.p (
     1888      input "get":U
     1889     ,input v-cntxt-obj-type
     1890     ,input v-cntxt-obj-code
     1891     ,input 'report-firm':U
     1892     ,input  ""
     1893     ,output v-value-character
     1894     ,output v-value-date
     1895     ,output v-value-decimal
     1896     ,output v-value-integer
     1897     ,output v-value-logical
     1898     ,output par-type
     1899     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     1900     ) no-error .
     1901         for each thbjattr_thbj-attr :
     1902             if thbjattr_thbj-attr.prop-code = 'XL-delim'  then tmp-var1   = thbjattr_thbj-attr.property-value-character.
     1903         end.
     1904         IF tmp-var1 = "" then p-XL-delim = ";".
     1905         else p-XL-delim = tmp-var1.
     1906         run rep/dxgrp-h2.p (
     1907                          input my-handle
     1908                        , input p-xl-delim
     1909                        , input x-Date-Start
     1910                        , input x-Date-End
     1911                        , input str4
     1912                        , input RS-option
     1913                        , input (radio-label(string(Rs-Option), RS-Option:radio-buttons))
     1914                        , input WithGoods
     1915                        , input t-scale
     1916                        , input integer( WH-Start )
     1917                        , input integer( WH-End )
     1918                        , input t-dis-card
     1919                        , input rs-dis-card
     1920                        , input X-selectGood
     1921                        )   no-error .
     1922       END.
     1923       ELSE DO:
     1924         run rep/d-grp-h2.p (
     1925                         input my-handle
     1926                       , input x-Date-Start
     1927                       , input x-Date-End
     1928                       , input str4
     1929                       , input RS-option
     1930                       , input (radio-label(string(Rs-Option), RS-Option:radio-buttons))
     1931                       , input WithGoods
     1932                       , input t-scale
     1933                       , input integer( WH-Start )
     1934                       , input integer( WH-End )
     1935                       , input t-dis-card
     1936                       , input rs-dis-card
     1937                       , input X-selectGood
     1938                       ) no-error.
     1939     END.
     1940     if error-status:error then do:
     1941       run waitfram-hide in this-procedure .
     1942       message
     1943       vss-workfile vss-revision vss-description skip
     1944       error-status:get-message(1) skip
     1945       return-value
     1946       view-as alert-box error .
     1947       return.
     1948     end.
     1949     if vXL then
     1950     run prn-lib-prn-file in this-procedure (
     1951                                               input parParentProc
     1952                                               ,input 3
     1953                                               ).
     1954     else
     1955     run prn-lib-prn-file in this-procedure (
     1956                                               input parParentProc
     1957                                               ,input 8
     1958                                               ).
     1959     FOR EACH grp-h :
     1960         delete grp-h .
     1961     END .
     1962     FOR EACH gds-h :
     1963         delete gds-h .
     1964     END .
     1965   end.
     1966   else
     1967   message "В указанный Вами период времени" skip
     1968           "на интересующих Вас объектах" skip
     1969           "не было НИКАКИХ продаж."
     1970   view-as alert-box INFORMATION .
     1971   end.
     1972   END PROCEDURE.
     1973   PROCEDURE My-var :
     1974   assign frame F-Main
     1975   WithGoods Rs-Option t-scale
     1976   rs-dis-card t-dis-card
     1977   .
     1978   Assign
     1979    STR-obj-type = ''
     1980    STR-obj-code = ''
     1981    STR-obj-name = ''
     1982    STR-obj      = ''.
     1983   For each obj-list no-lock:
     1984    Assign
     1985    STR-obj-type = STR-obj-type + obj-list.obj-type + ','
     1986    STR-obj-code = STR-obj-code + String(obj-list.obj-code) + ','
     1987    STR-obj-name = STR-obj-name + obj-list.obj-name + ','
     1988    STR-obj = STR-obj +  obj-list.obj-type + '#' + string(obj-list.obj-code)  + ',' .
     1989   End.
     1990   ReportNAme = "Почасовая статистика розничных продаж по КОЛИЧЕСТВУ ТОВАРОВ".
     1991   ReportHeader =  radio-label(string(Rs-Option), RS-Option:radio-buttons) +
     1992                               if WithGoods then (", " +  WithGoods:label) else ""+
     1993                               string(if vXl then ", Вывод в Excel" else "").
     1994   assign
     1995   use-column[4] = vH-0
     1996   use-column[5] = vH-1
     1997   use-column[6] = vh-2
     1998   use-column[7] = vh-3
     1999   use-column[8] = vh-4
     2000   use-column[9] = vH-5
     2001   use-column[10] = vH-6
     2002   use-column[11] = vh-7
     2003   use-column[12] = vh-8
     2004   use-column[13] = vh-9
     2005   use-column[14] = vH-10
     2006   use-column[15] = vH-11
     2007   use-column[16] = vh-12
     2008   use-column[17] = vh-13
     2009   use-column[18] = vh-14
     2010   use-column[19] = vH-15
     2011   use-column[20] = vH-16
     2012   use-column[21] = vh-17
     2013   use-column[22] = vh-18
     2014   use-column[23] = vh-19
     2015   use-column[24] = vH-20
     2016   use-column[25] = vH-21
     2017   use-column[26] = vh-22
     2018   use-column[27] = vh-23
     2019   .
     2020   END PROCEDURE.
     2021   PROCEDURE send-records :
     2022     DEFINE INPUT PARAMETER p-tbl-list AS CHARACTER NO-UNDO.
     2023     DEFINE OUTPUT PARAMETER p-rowid-list AS CHARACTER NO-UNDO.
     2024     DEFINE VARIABLE i            AS INTEGER   NO-UNDO.
     2025     DEFINE VARIABLE link-handle  AS CHARACTER NO-UNDO.
     2026     DEFINE VARIABLE rowid-string AS CHARACTER NO-UNDO.
     2027     DO i = 1 TO NUM-ENTRIES(p-tbl-list):
     2028         IF i > 1 THEN p-rowid-list = p-rowid-list + ",":U.
     2029         CASE ENTRY(i, p-tbl-list):
     2030       WHEN "temp-dis-card-type":U THEN p-rowid-list = p-rowid-list +
     2031           IF AVAILABLE temp-dis-card-type THEN STRING(ROWID(temp-dis-card-type))
     2032           ELSE "?":U.
     2033           OTHERWISE
     2034           DO:
     2035               RUN get-link-handle IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     2036                   INPUT "RECORD-SOURCE":U, OUTPUT link-handle) NO-ERROR.
     2037               IF link-handle NE "":U THEN
     2038               DO:
     2039                   IF NUM-ENTRIES(link-handle) > 1 THEN
     2040                       MESSAGE "send-records in ":U THIS-PROCEDURE:FILE-NAME
     2041                               "encountered more than one RECORD-SOURCE.":U SKIP
     2042                               "The first will be used.":U
     2043                               VIEW-AS ALERT-BOX ERROR.
     2044                   RUN send-records IN WIDGET-HANDLE(ENTRY(1,link-handle))
     2045                       (INPUT ENTRY(i, p-tbl-list), OUTPUT rowid-string).
     2046                   p-rowid-list = p-rowid-list + rowid-string.
     2047               END.
     2048               ELSE
     2049               DO:
     2050                   MESSAGE "Requested table":U ENTRY(i, p-tbl-list)
     2051                           "does not match tables in send-records":U
     2052                           "in procedure":U THIS-PROCEDURE:FILE-NAME ".":U SKIP
     2053                           "Check that objects are linked properly and that":U
     2054                           "database qualification is consistent.":U
     2055                       VIEW-AS ALERT-BOX ERROR.
     2056                   RETURN ERROR.
     2057               END.
     2058           END.
     2059           END CASE.
     2060       END.
     2061   END PROCEDURE.
     2062   PROCEDURE state-changed :
     2063     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE NO-UNDO.
     2064     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     2065     CASE p-state:
     2066       WHEN "link-changed" then do:
     2067           run ini-from-selobj(X-Selectobject).
     2068       end.
     2069     END CASE.
     2070     IF INDEX(p-state, "SELECTOBJECT=") > 0 then do:
     2071           RUn ini-from-selobj in h_s-hour.
     2072     end.
     2073   END PROCEDURE.
