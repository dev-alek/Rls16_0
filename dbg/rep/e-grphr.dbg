     1330         temp-dis-card-type.emitent-host-code COLUMN-LABEL "Код эмитента" FORMAT "99999":U
     1331       WITH NO-ROW-MARKERS SEPARATORS SIZE 23.63 BY 8.04
     1332            TITLE "Выбранные типы карт".
     1333   DEFINE FRAME F-Main
     1334        T-dis-card AT ROW 1.25 COL 49
     1335        RS-dis-card AT ROW 2.92 COL 49.13 NO-LABEL
     1336        BR-dis-card-type AT ROW 5.67 COL 48.38
     1337        WithGoods AT ROW 12.71 COL 1.75
