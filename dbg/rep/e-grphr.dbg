     1343            SIZE 77.38 BY 16.21.
     1344   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
     1345   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
     1346   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
     1347   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
     1348   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
     1349   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
     1350   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
     1351   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
     1352       ASSIGN adm-object-hdl = FRAME F-Main:HANDLE.
     1353   RUN ensure-broker.
     1354   THIS-PROCEDURE:ADM-DATA =
     1355        'ADM1.1~`':U +
     1356        'SmartObject~`':U +
     1357        'FRAME~`':U +
     1358        'NO ~`':U +
     1359        '~`':U +
     1360        'temp-dis-card-type~`':U +
     1361        '~`':U +
     1362        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
     1363           + "~`":U +
     1364        'Layout,Hide-on-Init~`':U +
     1365        '~`':U +
     1366        '~`':U +
     1367        '~`~`~`~`~`~`~`~`~`~`~`':U +
     1368        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
     1369            THEN "^^":U
     1370        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
     1371             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
     1372   PROCEDURE adm-apply-entry :
     1373     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1374   END PROCEDURE.
     1375   PROCEDURE adm-destroy :
