     1154   procedure prn-lib-open-stream :
     1155     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1156     define input parameter p-page-size    as integer no-undo .
     1157     define input parameter p-is-stream    as logical no-undo .
     1158     define input parameter p-append       as logical no-undo .
     1159     define variable v-report-name as character no-undo .
     1160     do
     1161       on error undo, return error
     1162       :
     1163       run prn-lib-get-report-name  in this-procedure (
     1164         input parParentProc
     1165         ,output v-report-name
     1166         ).
     1167       if p-is-stream then
     1168       do:
     1169         if p-append then
     1170         do:
     1171           output stream PrnLibStream to value( v-report-name )
     1172             page-size value(p-page-size) append .
     1173         end.
     1174         if not p-append then
     1175         do:
     1176           output stream PrnLibStream to value( v-report-name )
     1177             page-size value(p-page-size) .
     1178         end.
     1179       end.
     1180       if not p-is-stream then
     1181       do:
     1182         if p-append then
     1183         do:
     1184           output to value( v-report-name )
     1185             page-size value(p-page-size) append .
     1186         end.
     1187         if not p-append then
     1188         do:
     1189           output to value( v-report-name )
     1190             page-size value(p-page-size) .
     1191         end.
     1192       end.
     1193     end.
     1194   end procedure.
     1195   procedure prn-lib-open-exp :
     1196     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1197     define input parameter p-is-stream    as logical no-undo .
     1198     define input parameter p-is-append    as logical no-undo .
     1199     define output parameter p-ReportFileName as char init "report" no-undo.
     1200     define output parameter p-process as logical no-undo .
     1201     define variable glog as logical no-undo .
     1202     do
     1203       on error undo, return error
     1204       :
     1205       SYSTEM-DIALOG GET-FILE p-ReportFileName
     1206         TITLE      "Укажите путь"
     1207         FILTERS "Текстовый файл (*.txt)"   "*.txt"
     1208         ASK-OVERWRITE
     1209         CREATE-TEST-FILE
     1210         SAVE-AS
     1211         USE-FILENAME
     1212         DEFAULT-EXTENSION "txt"
     1213         UPDATE glog
     1214         .
     1215       if not glog then  return.
     1216       p-ReportFileName = trim( string( p-ReportFileName ) ) .
     1217       if p-is-stream then
     1218       do:
     1219         if p-is-append then
     1220         do:
     1221           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1222         end.
     1223         else
     1224         do:
     1225           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1226         end.
     1227       end.
     1228       else
     1229       do:
     1230         if p-is-append then
     1231         do:
     1232           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1233         end.
     1234         else
     1235         do:
     1236           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1237         end.
     1238       end.
     1239       p-process = yes.
     1240     end.
     1241   end procedure.
     1242   procedure prn-lib-get-report-name :
     1243     define input parameter parParentProc  as widget-handle no-undo.
     1244     define output parameter p-report-name as character no-undo .
     1245     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
     1246   end procedure.
     1247   procedure prn-lib-reportviewer-report-name :
     1248     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1249     define input parameter p-report-name-html as character no-undo .
