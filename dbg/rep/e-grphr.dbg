     1252   procedure prn-lib-reportviewer :
     1253     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1254     define input parameter p-report-name-html as character no-undo .
     1255     define input parameter p-param        as character no-undo .
     1256     define variable v-excel           as character no-undo init 'TRUE' .
     1257     define variable v-value-character as character no-undo .
     1258     define variable v-value-integer   as character no-undo .
     1259     define variable v-value-date      as date      no-undo .
     1260     define variable v-value-decimal   as decimal   no-undo .
     1261     define variable rep-excel         as logical   no-undo .
     1262     define variable excel-string      as character no-undo .
     1263     define variable v-param-type      as character no-undo .
     1264     define variable v-tth             as handle    no-undo .
     1265     run adm/shattri.p (
     1266       input "get":U
     1267       ,input  ""
     1268       ,input  0
     1269       ,input  'report-glob':U
     1270       ,input  'rep-excel':U
     1271       ,output v-value-character
     1272       ,output v-value-date
     1273       ,output v-value-decimal
     1274       ,output v-value-integer
     1275       ,output rep-excel
     1276       ,output v-param-type
     1277       ,INPUT-OUTPUT table-handle v-tth
     1278       )  .
     1279     if rep-excel then v-excel = "TRUE" .
     1280     else v-excel = "FALSE" .
     1281     if p-param eq ""
     1282     then
     1283        p-param = "EXCEL:" + v-excel.
     1284     else
     1285        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
     1286     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
     1287   end procedure.
