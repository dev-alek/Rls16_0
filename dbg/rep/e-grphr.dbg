      175   def
      176    shared
      177   temp-table  obj-list no-undo
      178     field obj-type like ub.clients.obj-type
      179     field obj-code like ub.clients.obj-code
      180     field obj-name like ub.clients.obj-name
      181     field obj-id   as integer
