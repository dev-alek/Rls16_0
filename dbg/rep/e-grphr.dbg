      847   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      848   define variable v-waitfram-action01         as character   no-undo .
      849   define variable v-waitfram-action02         as character   no-undo .
      850   define variable v-waitfram-action03         as character   no-undo .
      851   define variable mWaitFramTextBeg            as character   no-undo.
      852   define variable mWaitFramTextEnd            as character   no-undo.
      853   define variable mWaitFramView               as logical     no-undo.
      854   define variable mWaitProcEvent              as logical     no-undo init yes.
      855   define variable mWaitFramInterval           as integer     no-undo init 1 .
      856   define variable mWaitFramStop               as logical     no-undo.
      857   define variable mWaitFramStopUser           as logical     no-undo.
      858   define variable mWaitFramStopTimeOut        as logical     no-undo.
      859   define variable mWaitFramStartProc          as datetime-tz no-undo.
      860   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      861   define button B-WaitFramStop auto-end-key
      862        label "Стоп"
      863        size 10 by 1 tooltip "Остоновить процесс".
      864   define button B-viewProcInfo
      865        label "Информация"
      866        size 15 by 1 tooltip "Информация о процесс".
      867   define frame waitfram
      868     v-waitfram-action01 format "x(72)" no-label skip
      869     v-waitfram-action02 format "x(72)" no-label skip
      870     v-waitfram-action03 format "x(72)" no-label skip
      871     B-viewProcInfo
      872     B-WaitFramStop at row 4 col 30
      873     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      874     .
      875   define new global shared variable mBatchMode as logical no-undo init ?.
      876   define variable mFramBachModHandle as handle no-undo.
      877   mFramBachModHandle = frame waitfram:handle.
      878   define variable mFameOldVis as logical no-undo.
      879   define variable mVisCUrentVin as logical no-undo.
      880   if session:batch-mode
      881   then
      882      mBatchMode = yes.
      883   if mBatchMode = ? then do:
      884     mVisCUrentVin = current-window:visible.
      885     mFameOldVis = mFramBachModHandle:visible.
      886     mFramBachModHandle:visible  = yes.
      887     mBatchMode = mFramBachModHandle:visible ne yes.
      888     mFramBachModHandle:visible = mFameOldVis.
      889     current-window:visible = mVisCUrentVin.
      890   end.
      891    if  log-manager:logfile-name ne ?
      892     then DO:
      893         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      894         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      895         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      896     end.
      897   on choose of B-WaitFramStop in frame waitfram
      898   do:
      899     mWaitFramStop = yes.
      900     mWaitFramStopUser = yes.
      901   end.
      902   function waitfram-check-timeout returns logical():
      903      define variable vtime as int64 no-undo.
      904      if mWaitFramStopTimeOut
      905      then
      906         return yes.
      907      vtime = ( now - mWaitFramStartProc ) / 1000 .
      908      if     mWaitFramTimeOut ne ?
      909         and mWaitFramTimeOut ne 0
      910         and mWaitFramTimeOut lt vtime
      911      then do:
      912         mWaitFramStopTimeOut = yes.
      913      end.
      914      return mWaitFramStopTimeOut.
      915   end.
      916   procedure waitfram-hide :
      917     if not session:batch-mode
      918     then do
      919     on error undo, return error return-value
      920     :
      921       pause 0 before-hide .
      922       if not mBatchMode then
      923         hide frame waitfram .
      924     if     not mWaitFramView
      925        and mWaitProcEvent
      926     then
      927       process events .
      928     end.
      929   end procedure.
      930   procedure waitfram-show :
      931     define input  parameter p-message as character no-undo .
      932     define variable v-left-margin as integer   no-undo .
      933     if not session:batch-mode
      934     then do
      935     on error undo, return error return-value
      936     :
      937       if length(p-message) <= 70 then do:
      938         assign
      939           v-left-margin = integer((70 - length(p-message)) / 2)
      940         .
      941         assign
      942           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      943         .
      944         assign
      945           v-waitfram-action01 = " "
      946           v-waitfram-action02 = " "
      947                                    + fill(" ", v-left-margin)
      948                                    + p-message
      949           v-waitfram-action03 = " "
      950         .
      951       end.
      952       else do:
      953         define variable vRindex1 as integer no-undo.
      954         define variable vRindex2 as integer no-undo.
      955         vRindex1 = r-index(p-message," ",70).
      956         if vRindex1 = 0
      957         then
      958            vRindex1 = 70.
      959         if length(p-message)  <= vRindex1 + 70 then do:
      960           assign
      961             v-waitfram-action01 = " "
      962             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      963             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      964           .
      965         end.
      966         else do:
      967           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      968           if vRindex2 <= vRindex1
      969           then
      970              vRindex2 = vRindex1 + 70.
      971           assign
      972             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      973             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      974             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      975           .
      976         end.
      977       end.
      978       B-viewProcInfo:visible   in frame waitfram = no.
      979       B-viewProcInfo:sensitive in frame waitfram = no.
      980       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      981       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      982       if  (   mWaitFramView
      983          or  mWaitProcEvent)
      984          and not mBatchMode
      985       then
      986          display
      987             v-waitfram-action01 skip
      988             v-waitfram-action02 skip
      989             v-waitfram-action03 skip
      990          with frame waitfram .
      991       if     mWaitFramView
      992          then do:
      993             if     mWaitFramInterval ne ?
      994                and not mBatchMode
      995             then
      996                wait-for go of frame waitfram pause mWaitFramInterval.
      997          end.
      998          else
      999             if     mWaitProcEvent
     1000                and not mBatchMode
     1001             then
     1002                process events .
     1003     end.
     1004   end procedure.
     1005      procedure waitfram-show-this:
     1006         define input  parameter iInterval as int64 no-undo.
     1007         define variable vtime as int64 no-undo.
     1008         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1009         mWaitFramInterval = iInterval.
     1010         run waitfram-show (substitute("&1&2 &3&4" ,
     1011                                       mWaitFramTextBeg ,
     1012                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1013                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1014                                       mWaitFramTextEnd
     1015                                      )
     1016                           ).
     1017      end.
     1018      procedure WaitFramRunPause:
     1019         define input  parameter iInterval as dec no-undo.
     1020         define variable vStart  as datetime-tz no-undo.
     1021         define variable vend    as datetime-tz no-undo.
     1022         define variable vint as int64 no-undo.
     1023         define variable vOk as logical no-undo.
     1024         vStart = now.
     1025         vend   = vStart.
     1026         publish "WaitFramPause" (iInterval,output vOk).
     1027         vend   =  now.
     1028         vint = vend - vStart.
     1029         vint = iInterval - vint / 1000.
     1030         if     not mWaitFramStop
     1031            and (   vint > 0
     1032                 or (    not vOk
     1033                     and iInterval eq ?
     1034                     )
     1035                 )
     1036         then
     1037            run waitfram-show-this (iInterval).
     1038         vend   =  now.
     1039         vint = vend - vStart.
     1040         vint = iInterval - vint / 1000.
     1041         if     not mWaitFramStop
     1042            and vint > 0
     1043         then do:
     1044            run gbl/pause.p (vint * 1000).
     1045         end.
     1046         if iInterval ne ?
     1047         then
     1048            publish "WaitFramStop".
     1049         waitfram-check-timeout().
     1050      end.
     1051      procedure WaitFramWaitFor:
     1052         define input  parameter iInterval as dec no-undo.
     1053         assign
     1054            mWaitFramStartProc   = now
     1055            mWaitFramStopUser    = no
     1056            mWaitFramStopTimeOut = no
     1057         .
     1058         block-wait:
     1059         do while not mWaitFramStop:
     1060            run WaitFramRunPause (iInterval).
     1061            if  waitfram-check-timeout()
     1062            then do:
     1063               leave block-wait.
     1064            end.
     1065         end.
     1066         run waitfram-hide.
     1067      end.
     1068   procedure waitfram-join :
     1069     define input  parameter p-line-1  as character no-undo .
     1070     define input  parameter p-line-2  as character no-undo .
     1071     define input  parameter p-line-3  as character no-undo .
     1072     define output parameter p-message as character no-undo .
     1073     do
     1074     on error undo, return error return-value
     1075     :
     1076       assign
     1077         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1078                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1079                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1080       .
     1081     end.
     1082   end procedure.
     1083   function waitfram-join-function returns character
     1084     (input p-line-1 as character
     1085     ,input p-line-2 as character
     1086     ,input p-line-3 as character
     1087     ).
     1088     define variable v-message as character no-undo .
     1089     run waitfram-join in this-procedure
     1090       (input  p-line-1
     1091       ,input  p-line-2
     1092       ,input  p-line-3
     1093       ,output v-message
     1094       ) .
     1095     return v-message .
     1096   end function .
