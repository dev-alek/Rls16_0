     1635     define variable time-start as integer no-undo .
     1636     Run init-proc in this-procedure .
     1637     if f-flag = false then RETURN .
     1638     Run report-execute   in this-procedure .
     1639   FUNCTION n-lavel RETURNS char (INPUT grp-name as char, INPUT lavel# as int ).
     1640   define variable  str  as char format "X(60)"  no-undo.
     1641   define variable  str2 as char no-undo.
     1642   define variable v-r as character no-undo init "" .
     1643   define variable  i#i as int no-undo.
     1644   STR = "".
     1645   repeat i#i =1 to lavel#:
     1646       if i#i =1 then str   = entry(1,grp-name, chr(47)) .
     1647       else do:
     1648           str2 = entry(i#i,grp-name, chr(47)) no-error.
     1649           if not error-status:error  and str2 <> "":u then
     1650                  str = str +  chr(47) +  entry(i#i,grp-name, chr(47)) no-error .
     1651           end.
     1652   end.
     1653   if str <> ? then do:
     1654   v-r = str + chr(47) .
     1655   end.
     1656   RETURN v-r .
     1657   END FUNCTION.
     1658   procedure init-proc :
     1659    time-start = time.
     1660   assign
     1661     i               = 0
     1662     xlavel          = xvar-lavel
     1663     Select-Good     = x-SelectGood
     1664     PayType         = x-SET_PAY_TYPE
     1665     RetClassify     = xClassify
     1666     RetSortType     = xSortType
     1667     Sums-Only       = xSumsOnly
     1668     Show-Negativ    = xShowZero
     1669     Show-Negativ-2  = xShowZero-2
     1670     FirstLine       = FALSE
     1671     line            = fill('-', MINIMUM(l-col-pos,189))
     1672     line2            = fill('-', l-col-pos - 1)
     1673     .
     1674     if p-is-petrol = true  then
     1675     assign
     1676       Select-Good  = 4
     1677       x-SelectGood = 4
     1678     .
     1679     if  x-date-end  - x-date-start > 400
     1680         then long-p = true    .
     1681         else  long-p = false     .
     1682     x-SelectObject = "".
     1683     find first ub.gds-grp where  ub.gds-grp.upper-code = 0 no-lock no-error .
     1684     if avail ub.gds-grp then   first-lavel = ub.gds-grp.node-code.
     1685                      else first-lavel = 0.
     1686     ValType         = IF (PayType = 1) Then 0  else x-SET_val_TYPE.
     1687     If (ValType=0 and x-base-code=0)  Or ValType=1
     1688       then assign tPrintRubl = yes .
     1689       else assign tPrintRubl = no .
     1690     run rep/ob-sumtp.p (output table temp#sum-type ).
     1691     Run find-mediator  in this-procedure  ( INPUT v-cntxt-host-code-obj ,input xShowmediator, OUTPUT mediator-host-code, OUTPUT f-flag) .
     1692   end procedure.
     1693   PROCEDURE report-execute :
     1694     Case print-o :
     1695     when "A4-lansc":U then DO:
     1696   output stream OutStream to value( string( session:temp-directory +
     1697                                        "rpt" + string( g#report-num ) ) )
     1698                                        page-size  value(43) .
     1699     end.
     1700     when "A4-port":U then DO:
     1701   output stream OutStream to value( string( session:temp-directory +
     1702                                        "rpt" + string( g#report-num ) ) )
     1703                                        page-size  value(63) .
     1704     end.
     1705     when "A3-lansc":U then DO:
     1706   output stream OutStream to value( string( session:temp-directory +
     1707                                        "rpt" + string( g#report-num ) ) )
     1708                                        page-size  value(63) .
     1709     end.
     1710     OTHERWISE DO:
     1711   output stream OutStream to value( string( session:temp-directory +
     1712                                        "rpt" + string( g#report-num ) ) )
     1713                                        page-size  value(43) .
     1714     end.
     1715     end case.
     1716    define variable gj as integer no-undo init 0.
     1717      if xTog-obj  Then DO:
     1718               FOR each obj-list no-lock:
     1719                   x-store-type = obj-list.obj-type.
     1720                   x-store-code = obj-list.obj-code.
     1721                   gj = gj + 1 .
     1722                   Run report-exec1   in this-procedure .
     1723               End.
     1724              if gj > 1 then DO :
     1725                 run display-bo   in this-procedure .
     1726                 run u-line  in this-procedure .
     1727              End.
     1728             End.
     1729     Else  Run report-exec1   in this-procedure .
     1730     put stream outstream " Время составления отчета " string((time - time-start),"hh:mm:ss" ) .
     1731     HIDE   STREAM OutStream FRAME ZAPAS .
     1732     HIDE   STREAM OutStream FRAME top-Frame .
     1733     Output stream OutStream close.
     1734   if mFrameView
     1735   then do:
     1736      HIDE FRAME InfoFrame.
     1737   end.
     1738     DELETE WIDGET-POOL "My-pool".
     1739      define variable v-user-action as character no-undo .
     1740      define variable v-printed as logical   no-undo .
     1741      define variable DisabledOptions as integer   no-undo .
     1742     Case print-o :
     1743     when "A4-lansc":U then DO:
     1744         DisabledOptions = 8 .
     1745        end.
     1746     when "A4-port":U then DO:
     1747         DisabledOptions = 0 .
     1748        end.
     1749     when "A3-lansc":U then DO:
     1750         DisabledOptions = 8 .
     1751                         end.
     1752     OTHERWISE DO:
     1753         DisabledOptions = 1 .
     1754         end.
     1755      End case.
     1756      run gbl/prnfilen.w
     1757        (input  ""
     1758        ,input  DisabledOptions
     1759        ,input  string(session :temp-directory) + "rpt" + string( g#report-num )
     1760        ,input  7
     1761        ,output v-user-action
     1762        ,output v-printed
     1763        ) .
     1764   END PROCEDURE.
     1765   PROCEDURE foreach :
