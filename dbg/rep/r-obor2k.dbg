     4031   PROCEDURE Display-title :
     4032      PUT stream  OutStream  UNFORMATTED  string( v-cntxt-host-name-obj +  " , " + x-store-type  +  " " + ObjName) AT 50 format "X(85)" SKIP(2)
     4033             REPORTNAME  AT 1 format "X(133)" SKIP
     4034             Trim(str1)  AT 35 format "X(75)" SKIP.
     4035        Repeat i = 1 to NUM-ENTRIES(str2,chr(10)) :
     4036         PUT stream  OutStream  UNFORMATTED  Entry(i,str2,chr(10))  AT 1 format "X(130)" SKIP.
     4037        End.
     4038       i=0.
     4039        Repeat i = 1 to NUM-ENTRIES(str3,chr(10)) :
     4040         PUT stream  OutStream  UNFORMATTED  Entry(i,str3,chr(10))  AT 1 format "X(130)" SKIP.
     4041        End.
     4042       i=0.
     4043        Repeat i = 1 to NUM-ENTRIES(str4,chr(10)) :
     4044         PUT stream  OutStream  UNFORMATTED  Entry(i,str4,chr(10))  AT 1 format "X(130)" SKIP.
     4045        End.
     4046       i=0.
     4047        Repeat i = 1 to NUM-ENTRIES(ReportHeader,chr(10)) :
     4048         PUT stream  OutStream  UNFORMATTED  Entry(i,ReportHeader,chr(10))  AT 1 format "X(130)" SKIP.
     4049        End.
     4050       i=0.
     4051   END PROCEDURE.
     4052   PROCEDURE ob-line  :
     4053   define input  parameter x-store-code     like ub.clients.obj-code     no-undo.
     4054   define input  parameter x-store-type     like ub.clients.obj-type     no-undo.
     4055   define input  parameter x-artic          like ub.ot-line.artic        no-undo.
     4056   define input  parameter x-prod-code      like ub.ot-line.prod-code    no-undo.
     4057   define input  parameter x-prod-type      like ub.ot-line.prod-type    no-undo.
     4058   define input  parameter x-fact-order-1   like ub.ot-line.fact-order   no-undo.
     4059   define input  parameter x-fact-order-2   like ub.ot-line.fact-order   no-undo.
     4060   define input  parameter x-sum-type       like ub.ot-line.sum-type     no-undo.
     4061   define input  parameter x-cat-id         like ub.ot-line.cat-id       no-undo.
     4062   define input  parameter x-ext-doc-type   like ub.ot-line.ext-doc-type no-undo.
     4063   define input  parameter xtog-obj           as log no-undo.
     4064   define variable  quantity#    like ub.ot-line.fact-qnty   no-undo.
     4065   define variable  coast_r#     like ub.ot-line.sum-rubl    no-undo.
     4066   define variable  coast_v#     like ub.ot-line.sum-rubl    no-undo.
     4067   define variable  vat_r#       like ub.ot-line.sum-rubl    no-undo.
     4068   define variable  vat_v#       like ub.ot-line.sum-rubl    no-undo.
     4069   define variable  slt_r#       like ub.ot-line.sum-rubl    no-undo.
     4070   define variable  slt_v#       like ub.ot-line.sum-rubl    no-undo.
     4071   define variable  v-summa  as decimal extent 4 no-undo .
     4072   define variable  tt#          as int no-undo.
     4073   define variable v-ii as integer no-undo .
     4074   define variable slt  as decimal no-undo .
     4075   define variable disc  as decimal no-undo .
     4076   define variable xi as integer no-undo .
     4077   define variable v-tt as integer no-undo .
     4078    if (x-sum-type = 'cost':U  or x-sum-type = 'cssr':U) then assign tt# = 0 v-tt = 0.
     4079       else
     4080       if (x-sum-type = 'crsa':U  or x-sum-type = 'cgsr':U) then assign tt# = 3  v-tt = 100.
     4081       else
     4082       assign tt# = 6  v-tt = 200.
     4083     if long-p = false then do :
     4084     for each obj-list no-lock:
     4085      if  xtog-obj then
     4086          if   not(x-store-type     = obj-list.obj-type
     4087               and x-store-code    = obj-list.obj-code ) then next.
     4088           for each ub.ot-line where
     4089                     ub.ot-line.artic         = x-artic
     4090               and   ub.ot-line.prod-code    = x-prod-code
     4091               and   ub.ot-line.prod-type    = x-prod-type
     4092               and   ub.ot-line.fact-order   <= x-fact-order-2
     4093               and   ub.ot-line.fact-order   >= x-fact-order-1
     4094               and   ub.ot-line.obj-code     = obj-list.obj-code
     4095               and   ub.ot-line.obj-type     = obj-list.obj-type
     4096               and   ub.ot-line.sum-type     = x-sum-type
     4097               no-lock :
     4098               case ub.ot-line.ext-doc-type:
     4099     WHEN 'ie':U THEN DO:
     4100       ASSIGN oborot-ie[1 + tt#]   = oborot-ie[1 + tt#]   +  ub.ot-line.fact-qnty
     4101             oborot-ie[2 + tt#]   = oborot-ie[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     4102             oborot-ie[3 + tt#]   = oborot-ie[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     4103         if tt# = 6 Then   assign
     4104             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     4105             oborot-ie[10]   = oborot-ie[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     4106             End.
     4107     WHEN 'ee':U THEN DO:
     4108       ASSIGN oborot-ee[1 + tt#]   = oborot-ee[1 + tt#]   +  ub.ot-line.fact-qnty
     4109             oborot-ee[2 + tt#]   = oborot-ee[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     4110             oborot-ee[3 + tt#]   = oborot-ee[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     4111         if tt# = 6 Then   assign
     4112             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     4113             oborot-ee[10]   = oborot-ee[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     4114             End.
     4115     WHEN 'ep':U THEN DO:
     4116       ASSIGN oborot-ep[1 + tt#]   = oborot-ep[1 + tt#]   +  ub.ot-line.fact-qnty
     4117             oborot-ep[2 + tt#]   = oborot-ep[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     4118             oborot-ep[3 + tt#]   = oborot-ep[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     4119         if tt# = 6 Then   assign
     4120             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     4121             oborot-ep[10]   = oborot-ep[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     4122             End.
     4123     WHEN 'es':U THEN DO:
     4124       ASSIGN oborot-es[1 + tt#]   = oborot-es[1 + tt#]   +  ub.ot-line.fact-qnty
     4125             oborot-es[2 + tt#]   = oborot-es[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     4126             oborot-es[3 + tt#]   = oborot-es[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     4127         if tt# = 6 Then   assign
     4128             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     4129             oborot-es[10]   = oborot-es[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     4130             End.
     4131     WHEN 're':U THEN DO:
     4132       ASSIGN oborot-re[1 + tt#]   = oborot-re[1 + tt#]   +  ub.ot-line.fact-qnty
     4133             oborot-re[2 + tt#]   = oborot-re[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     4134             oborot-re[3 + tt#]   = oborot-re[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     4135         if tt# = 6 Then   assign
     4136             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     4137             oborot-re[10]   = oborot-re[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     4138             End.
     4139     WHEN 'rs':U THEN DO:
     4140       ASSIGN oborot-rs[1 + tt#]   = oborot-rs[1 + tt#]   +  ub.ot-line.fact-qnty
     4141             oborot-rs[2 + tt#]   = oborot-rs[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     4142             oborot-rs[3 + tt#]   = oborot-rs[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     4143         if tt# = 6 Then   assign
     4144             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     4145             oborot-rs[10]   = oborot-rs[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     4146             End.
     4147     WHEN 'we':U THEN DO:
     4148       ASSIGN oborot-we[1 + tt#]   = oborot-we[1 + tt#]   +  ub.ot-line.fact-qnty
     4149             oborot-we[2 + tt#]   = oborot-we[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     4150             oborot-we[3 + tt#]   = oborot-we[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     4151         if tt# = 6 Then   assign
     4152             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     4153             oborot-we[10]   = oborot-we[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     4154             End.
     4155     WHEN 'vt':U  OR  WHEN 'mp':U OR WHEN 'vp':U THEN DO:
     4156       ASSIGN oborot-vt[1 + tt#]   = oborot-vt[1 + tt#]   +  ub.ot-line.fact-qnty
     4157             oborot-vt[2 + tt#]   = oborot-vt[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     4158             oborot-vt[3 + tt#]   = oborot-vt[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     4159           if tt# = 6 Then  assign
     4160             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     4161             oborot-vt[10]   = oborot-vt[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     4162             End.
     4163     WHEN 'iv':U THEN DO:
     4164       ASSIGN oborot-iv[1 + tt#]   = oborot-iv[1 + tt#]   +  ub.ot-line.fact-qnty
     4165             oborot-iv[2 + tt#]   = oborot-iv[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     4166             oborot-iv[3 + tt#]   = oborot-iv[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     4167         if tt# = 6 Then   assign
     4168             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     4169             oborot-iv[10]   = oborot-iv[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     4170             End.
     4171     WHEN 'ev':U THEN DO:
     4172       ASSIGN oborot-ev[1 + tt#]   = oborot-ev[1 + tt#]   +  ub.ot-line.fact-qnty
     4173             oborot-ev[2 + tt#]   = oborot-ev[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     4174             oborot-ev[3 + tt#]   = oborot-ev[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     4175         if tt# = 6 Then   assign
     4176             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     4177             oborot-ev[10]   = oborot-ev[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     4178             End.
     4179     WHEN 'rv':U THEN DO:
     4180       ASSIGN oborot-rv[1 + tt#]   = oborot-rv[1 + tt#]   +  ub.ot-line.fact-qnty
     4181             oborot-rv[2 + tt#]   = oborot-rv[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     4182             oborot-rv[3 + tt#]   = oborot-rv[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     4183         if tt# = 6 Then   assign
     4184             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     4185             oborot-rv[10]   = oborot-rv[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     4186             End.
     4187     WHEN 'wm':U  OR  WHEN 'em':U THEN DO:
     4188       ASSIGN oborot-em[1 + tt#]   = oborot-em[1 + tt#]   +  ub.ot-line.fact-qnty
     4189             oborot-em[2 + tt#]   = oborot-em[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     4190             oborot-em[3 + tt#]   = oborot-em[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     4191           if tt# = 6 Then  assign
     4192             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     4193             oborot-em[10]   = oborot-em[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     4194             End.
     4195     WHEN 'im':U THEN DO:
     4196       ASSIGN oborot-im[1 + tt#]   = oborot-im[1 + tt#]   +  ub.ot-line.fact-qnty
     4197             oborot-im[2 + tt#]   = oborot-im[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     4198             oborot-im[3 + tt#]   = oborot-im[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     4199         if tt# = 6 Then   assign
     4200             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     4201             oborot-im[10]   = oborot-im[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     4202             End.
     4203     WHEN 'ot':U THEN DO:
     4204       ASSIGN oborot-ot[1 + tt#]   = oborot-ot[1 + tt#]   +  ub.ot-line.fact-qnty
     4205             oborot-ot[2 + tt#]   = oborot-ot[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     4206             oborot-ot[3 + tt#]   = oborot-ot[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     4207         if tt# = 6 Then   assign
     4208             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     4209             oborot-ot[10]   = oborot-ot[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     4210             End.
     4211     WHEN 'ap':U THEN DO:
     4212       ASSIGN oborot-ap[1 + tt#]   = oborot-ap[1 + tt#]   +  ub.ot-line.fact-qnty
     4213             oborot-ap[2 + tt#]   = oborot-ap[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     4214             oborot-ap[3 + tt#]   = oborot-ap[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     4215         if tt# = 6 Then   assign
     4216             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     4217             oborot-ap[10]   = oborot-ap[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     4218             End.
     4219     WHEN 'pc':U THEN DO:
     4220       ASSIGN oborot-pc[1 + tt#]   = oborot-pc[1 + tt#]   +  ub.ot-line.fact-qnty
     4221             oborot-pc[2 + tt#]   = oborot-pc[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     4222             oborot-pc[3 + tt#]   = oborot-pc[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     4223         if tt# = 6 Then   assign
     4224             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     4225             oborot-pc[10]   = oborot-pc[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     4226             End.
     4227               end case.
     4228           end.
     4229      end.
     4230   end.
     4231   else do:
     4232   xi = 1 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-ie [1 + tt#] ,output  oborot-ie [2 + tt#] ,output  oborot-ie [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-ie[10]    = oborot-ie[10]    + slt  .
     4233   xi = 2 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-ee [1 + tt#] ,output  oborot-ee [2 + tt#] ,output  oborot-ee [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-ee[10]    = oborot-ee[10]    + slt  .
     4234   xi = 3 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-ep [1 + tt#] ,output  oborot-ep [2 + tt#] ,output  oborot-ep [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-ep[10]    = oborot-ep[10]    + slt  .
     4235   xi = 4 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-es [1 + tt#] ,output  oborot-es [2 + tt#] ,output  oborot-es [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-es[10]    = oborot-es[10]    + slt  .
     4236   xi = 5 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-re [1 + tt#] ,output  oborot-re [2 + tt#] ,output  oborot-re [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-re[10]    = oborot-re[10]    + slt  .
     4237   xi = 6 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-rs [1 + tt#] ,output  oborot-rs [2 + tt#] ,output  oborot-rs [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-rs[10]    = oborot-rs[10]    + slt  .
     4238   xi = 7 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-we [1 + tt#] ,output  oborot-we [2 + tt#] ,output  oborot-we [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-we[10]    = oborot-we[10]    + slt  .
     4239   xi = 8 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-vt [1 + tt#] ,output  oborot-vt [2 + tt#] ,output  oborot-vt [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-vt[10]    = oborot-vt[10]    + slt  .
     4240   xi = 9 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-iv [1 + tt#] ,output  oborot-iv [2 + tt#] ,output  oborot-iv [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-iv[10]    = oborot-iv[10]    + slt  .
     4241   xi = 10 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-ev [1 + tt#] ,output  oborot-ev [2 + tt#] ,output  oborot-ev [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-ev[10]    = oborot-ev[10]    + slt  .
     4242   xi = 11 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-rv [1 + tt#] ,output  oborot-rv [2 + tt#] ,output  oborot-rv [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-rv[10]    = oborot-rv[10]    + slt  .
     4243   xi = 12 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-em [1 + tt#] ,output  oborot-em [2 + tt#] ,output  oborot-em [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-em[10]    = oborot-em[10]    + slt  .
     4244   xi = 13 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-im [1 + tt#] ,output  oborot-im [2 + tt#] ,output  oborot-im [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-im[10]    = oborot-im[10]    + slt  .
     4245   xi = 14 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-ot [1 + tt#] ,output  oborot-ot [2 + tt#] ,output  oborot-ot [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-ot[10]    = oborot-ot[10]    + slt  .
     4246   xi = 15 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-ap [1 + tt#] ,output  oborot-ap [2 + tt#] ,output  oborot-ap [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-ap[10]    = oborot-ap[10]    + slt  .
     4247   xi = 16 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-pc [1 + tt#] ,output  oborot-pc [2 + tt#] ,output  oborot-pc [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-pc[10]    = oborot-pc[10]    + slt  .
     4248   end.
     4249     if tt# = 6 then do:
     4250     if  xshowmediator = false then
     4251         oborot-sum-cost[1] =
     4252         oborot-ee[2]      +
     4253         oborot-es[2] +
     4254         oborot-re[2]  +
     4255         oborot-rs[2]
     4256         .
     4257         else
     4258         oborot-sum-cost[1] =
     4259         oborot-ee[4]      +
     4260         oborot-es[4] +
     4261         oborot-re[4]  +
     4262         oborot-rs[4]
     4263         .
     4264        repeat v-ii = 1 to 1 :
     4265        v-summa[v-ii ]  =
     4266           oborot-ie[v-ii ] + oborot-ee[v-ii ] + oborot-ep[v-ii ] +
     4267           oborot-es[v-ii ] + oborot-re[v-ii ] + oborot-rs[v-ii ] +
     4268           oborot-we[v-ii ] + oborot-vt[v-ii ] + oborot-iv[v-ii ] +
     4269           oborot-ev[v-ii ] + oborot-rv[v-ii ] + oborot-em[v-ii ] +
     4270           oborot-im[v-ii ] .
     4271        end.
     4272        repeat v-ii = 2 to 4 :
     4273        v-summa[v-ii ]  =
     4274           oborot-ie[v-ii + tt#] + oborot-ee[v-ii + tt#] + oborot-ep[v-ii + tt#] +
     4275           oborot-es[v-ii + tt#] + oborot-re[v-ii + tt#] + oborot-rs[v-ii + tt#] +
     4276           oborot-we[v-ii + tt#] + oborot-vt[v-ii + tt#] + oborot-iv[v-ii + tt#] +
     4277           oborot-ev[v-ii + tt#] + oborot-rv[v-ii + tt#] + oborot-em[v-ii + tt#] +
     4278           oborot-im[v-ii + tt#] .
     4279        end.
     4280         oborot-sum-sale[1] =
     4281         oborot-ee[2 + tt#] +
     4282         oborot-es[2 + tt#] +
     4283         oborot-re[2 + tt#] +
     4284         oborot-rs[2 + tt#]
     4285         .
     4286          assign oborot-ot[1 + tt#] = (ostatok-end[1 + tt#]  - ostatok-start[1 + tt#])  -  (v-summa[1])
     4287           oborot-ot[2 + tt#] = (ostatok-end[2 + tt#]  - ostatok-start[2 + tt#])  -  (v-summa[2])
     4288                                                                                                     -  oborot-disc[1]
     4289           oborot-ot[3 + tt#] = (ostatok-end[3 + tt#]  - ostatok-start[3 + tt#])  -  (v-summa[3])
     4290           oborot-ot[10] = (ostatok-end[10]  - ostatok-start[10])                 -  (v-summa[4])
     4291           .
     4292           oborot-eff[1] = -1 * (oborot-sum-sale[1] - oborot-sum-cost[1]) .
     4293           if oborot-sum-cost[1] <>  0 then
     4294             oborot-prc[1] = 100 * (oborot-sum-sale[1] - oborot-sum-cost[1] ) / oborot-sum-cost[1].
     4295             else oborot-prc[1] = 0.
     4296     end.
     4297   oborot-ie[4]   = Round(oborot-ie[1]   *  p-price-med , 2) .
     4298   oborot-ee[4]   = Round(oborot-ee[1]   *  p-price-med , 2) .
     4299   oborot-ep[4]   = Round(oborot-ep[1]   *  p-price-med , 2) .
     4300   oborot-es[4]   = Round(oborot-es[1]   *  p-price-med , 2) .
     4301   oborot-re[4]   = Round(oborot-re[1]   *  p-price-med , 2) .
     4302   oborot-rs[4]   = Round(oborot-rs[1]   *  p-price-med , 2) .
     4303   oborot-we[4]   = Round(oborot-we[1]   *  p-price-med , 2) .
     4304   oborot-vt[4]   = Round(oborot-vt[1]   *  p-price-med , 2) .
     4305   oborot-iv[4]   = Round(oborot-iv[1]   *  p-price-med , 2) .
     4306   oborot-ev[4]   = Round(oborot-ev[1]   *  p-price-med , 2) .
     4307   oborot-rv[4]   = Round(oborot-rv[1]   *  p-price-med , 2) .
     4308   oborot-em[4]   = Round(oborot-em[1]   *  p-price-med , 2) .
     4309   oborot-im[4]   = Round(oborot-im[1]   *  p-price-med , 2) .
     4310   oborot-ot[4]   = Round(oborot-ot[1]   *  p-price-med , 2) .
     4311   oborot-ap[4]   = Round(oborot-ap[1]   *  p-price-med , 2) .
     4312   oborot-pc[4]   = Round(oborot-pc[1]   *  p-price-med , 2) .
     4313   END PROCEDURE.
     4314   PROCEDURE report-exec1  :
     4315      FIND FIRST clients where x-store-type = clients.obj-type AND
     4316                               x-store-code = clients.obj-code no-lock no-error.
     4317              If available clients then  ObjName = clients.obj-name.
     4318                                            else  ObjName="объект не определен".
     4319     FORM with FRAME zapas .
     4320   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4321   form header
     4322     line format "X(197)" at 1 skip
     4323     "Продолжение - на следующей странице" at 30 skip
     4324     with frame bottomframe width 340 page-bottom no-labels no-box .
     4325   view stream outstream frame bottomframe .
     4326     Run CalcItog  in this-procedure .
     4327     Run Print-Header  in this-procedure .
     4328      CASE RetClassify :
     4329         when "grp-goods":U then       Run Run2  in this-procedure .
     4330         otherwise do:
     4331           message "" view-as alert-box error .
     4332         end.
     4333      End case.
     4334     HIDE stream OutStream FRAME BottomFrame .
     4335     Run Print-footer  in this-procedure .
     4336     END PROCEDURE.
     4337   PROCEDURE Calc-Sub-itog :
     4338   define input parameter tt as int no-undo.
     4339   define variable tt2 as integer no-undo .
     4340   define variable ji as integer no-undo .
     4341     if tt = 6 then tt2 = 7 .
     4342               else tt2 = tt.
     4343   Repeat i# = 1 + tt to 3 + tt2 :
     4344   run sum-i (
     4345    input oborot-vt[i#]
     4346   ,input tt
     4347   ,input-output b1-oborot-vt[i#]
     4348   ,input-output b2-oborot-vt[i#]
     4349   ,input-output bi-oborot-vt[i#]
     4350   ,input-output bo-oborot-vt[i#]
     4351   ,input oborot-ie[i#]
     4352   ,input-output b1-oborot-ie[i#]
     4353   ,input-output b2-oborot-ie[i#]
     4354   ,input-output bi-oborot-ie[i#]
     4355   ,input-output bo-oborot-ie[i#]
     4356   ) .
     4357   run sum-i (
     4358    input oborot-iv[i#]
     4359   ,input tt
     4360   ,input-output b1-oborot-iv[i#]
     4361   ,input-output b2-oborot-iv[i#]
     4362   ,input-output bi-oborot-iv[i#]
     4363   ,input-output bo-oborot-iv[i#]
     4364   ,input oborot-ee[i#]
     4365   ,input-output b1-oborot-ee[i#]
     4366   ,input-output b2-oborot-ee[i#]
     4367   ,input-output bi-oborot-ee[i#]
     4368   ,input-output bo-oborot-ee[i#]
     4369   ) .
     4370   run sum-i (
     4371    input oborot-ev[i#]
     4372   ,input tt
     4373   ,input-output b1-oborot-ev[i#]
     4374   ,input-output b2-oborot-ev[i#]
     4375   ,input-output bi-oborot-ev[i#]
     4376   ,input-output bo-oborot-ev[i#]
     4377   ,input oborot-ep[i#]
     4378   ,input-output b1-oborot-ep[i#]
     4379   ,input-output b2-oborot-ep[i#]
     4380   ,input-output bi-oborot-ep[i#]
     4381   ,input-output bo-oborot-ep[i#]
     4382   ) .
     4383   run sum-i (
     4384    input oborot-rv[i#]
     4385   ,input tt
     4386   ,input-output b1-oborot-rv[i#]
     4387   ,input-output b2-oborot-rv[i#]
     4388   ,input-output bi-oborot-rv[i#]
     4389   ,input-output bo-oborot-rv[i#]
     4390   ,input oborot-es[i#]
     4391   ,input-output b1-oborot-es[i#]
     4392   ,input-output b2-oborot-es[i#]
     4393   ,input-output bi-oborot-es[i#]
     4394   ,input-output bo-oborot-es[i#]
     4395   ) .
     4396   run sum-i (
     4397    input oborot-em[i#]
     4398   ,input tt
     4399   ,input-output b1-oborot-em[i#]
     4400   ,input-output b2-oborot-em[i#]
     4401   ,input-output bi-oborot-em[i#]
     4402   ,input-output bo-oborot-em[i#]
     4403   ,input oborot-re[i#]
     4404   ,input-output b1-oborot-re[i#]
     4405   ,input-output b2-oborot-re[i#]
     4406   ,input-output bi-oborot-re[i#]
     4407   ,input-output bo-oborot-re[i#]
     4408   ) .
     4409   run sum-i (
     4410    input oborot-im[i#]
     4411   ,input tt
     4412   ,input-output b1-oborot-im[i#]
     4413   ,input-output b2-oborot-im[i#]
     4414   ,input-output bi-oborot-im[i#]
     4415   ,input-output bo-oborot-im[i#]
     4416   ,input oborot-rs[i#]
     4417   ,input-output b1-oborot-rs[i#]
     4418   ,input-output b2-oborot-rs[i#]
     4419   ,input-output bi-oborot-rs[i#]
     4420   ,input-output bo-oborot-rs[i#]
     4421   ) .
     4422   run sum-i (
     4423    input oborot-ap[i#]
     4424   ,input tt
     4425   ,input-output b1-oborot-ap[i#]
     4426   ,input-output b2-oborot-ap[i#]
     4427   ,input-output bi-oborot-ap[i#]
     4428   ,input-output bo-oborot-ap[i#]
     4429   ,input oborot-pc[i#]
     4430   ,input-output b1-oborot-pc[i#]
     4431   ,input-output b2-oborot-pc[i#]
     4432   ,input-output bi-oborot-pc[i#]
     4433   ,input-output bo-oborot-pc[i#]
     4434   ) .
     4435   run sum-i (
     4436    input oborot-ot[i#]
     4437   ,input tt
     4438   ,input-output b1-oborot-ot[i#]
     4439   ,input-output b2-oborot-ot[i#]
     4440   ,input-output bi-oborot-ot[i#]
     4441   ,input-output bo-oborot-ot[i#]
     4442   ,input oborot-we[i#]
     4443   ,input-output b1-oborot-we[i#]
     4444   ,input-output b2-oborot-we[i#]
     4445   ,input-output bi-oborot-we[i#]
     4446   ,input-output bo-oborot-we[i#]
     4447   ) .
     4448     B1-oborot-em[ i#] = B1-oborot-em[ i#] + oborot-wm[ i#].
     4449     B2-oborot-em[ i#] = B2-oborot-em[ i#] + oborot-wm[ i#].
     4450     Bi-oborot-em[ i#] = Bi-oborot-em[ i#] + oborot-wm[ i#].
     4451     Bo-oborot-em[ i#] = Bo-oborot-em[ i#] + oborot-wm[ i#].
     4452     Bo-ostatok-start[ i#]  = Bo-ostatok-start[i#]  + ostatok-start[ i#]  .
     4453     Bo-ostatok-end[ i#]    = Bo-ostatok-end[i#]    + ostatok-end[ i#]    .
     4454     if i# = 7 then B1-oborot-disc[1 ]  = B1-oborot-disc[1]  + oborot-disc[1]  .
     4455     if i# = 7 then B2-oborot-disc[1 ]  = B2-oborot-disc[1]  + oborot-disc[1]  .
     4456     if i# = 7 then Bi-oborot-disc[1 ]  = Bi-oborot-disc[1]  + oborot-disc[1]  .
     4457     if i# = 7 then Bo-oborot-disc[1 ]  = Bo-oborot-disc[1]  + oborot-disc[1]  .
     4458     if i# = 8 then
     4459       assign
     4460         bi-oborot-sum-Sale[ i#]  = Bi-oborot-ee[ i#] +
     4461                                 Bi-oborot-re[ i#]         +
     4462                                 Bi-oborot-rs[ i#]    +
     4463                                 Bi-oborot-es[ i#]
     4464         b1-oborot-sum-Sale[ i#]  = B1-oborot-ee[ i#] +
     4465                                 B1-oborot-re[ i#]         +
     4466                                 B1-oborot-rs[ i#]    +
     4467                                 B1-oborot-es[ i#]
     4468         b2-oborot-sum-Sale[ i#]  = B2-oborot-ee[ i#] +
     4469                                 B2-oborot-re[ i#]         +
     4470                                 B2-oborot-rs[ i#]    +
     4471                                 B2-oborot-es[ i#]
     4472         bo-oborot-sum-Sale[ i#]  = Bo-oborot-ee[ i#] +
     4473                                 Bo-oborot-re[ i#]         +
     4474                                 Bo-oborot-rs[ i#]    +
     4475                                 Bo-oborot-es[ i#]
     4476         .
     4477     if i# = 2 and  xShowmediator = false   then do:
     4478         ji = 2.
     4479         assign
     4480           bi-oborot-sum-cost[ i#]  = Bi-oborot-ee[ ji] +
     4481                                   Bi-oborot-re[ ji]         +
     4482                                   Bi-oborot-rs[ ji]    +
     4483                                   Bi-oborot-es[ ji]
     4484           b1-oborot-sum-cost[ i#]  = B1-oborot-ee[ ji] +
     4485                                   B1-oborot-re[ ji]         +
     4486                                   B1-oborot-rs[ ji]    +
     4487                                   B1-oborot-es[ ji]
     4488           b2-oborot-sum-cost[ i#]  = B2-oborot-ee[ ji] +
     4489                                   B2-oborot-re[ ji]         +
     4490                                   B2-oborot-rs[ ji]    +
     4491                                   B2-oborot-es[ ji]
     4492           bo-oborot-sum-cost[ i#]  = Bo-oborot-ee[ ji] +
     4493                                   Bo-oborot-re[ ji]         +
     4494                                   Bo-oborot-rs[ ji]    +
     4495                                   Bo-oborot-es[ ji]
     4496           .
     4497     end.
     4498     if  xShowmediator = true  then do:
     4499     if i# = 8 then B1-oborot-sum-cost[2 ]  = B1-oborot-sum-cost[2]  + oborot-sum-cost[1]  .
     4500     if i# = 8 then B2-oborot-sum-cost[2 ]  = B2-oborot-sum-cost[2]  + oborot-sum-cost[1]  .
     4501     if i# = 8 then Bi-oborot-sum-cost[2 ]  = Bi-oborot-sum-cost[2]  + oborot-sum-cost[1]  .
     4502     if i# = 8 then Bo-oborot-sum-cost[2 ]  = Bo-oborot-sum-cost[2]  + oborot-sum-cost[1]  .
     4503     end.
     4504     if i# = 8 then B1-oborot-eff[1 ]  = B1-oborot-eff[1]  + oborot-eff[1]  .
     4505     if i# = 8 then B2-oborot-eff[1 ]  = B2-oborot-eff[1]  + oborot-eff[1]  .
     4506     if i# = 8 then Bi-oborot-eff[1 ]  = Bi-oborot-eff[1]  + oborot-eff[1]  .
     4507     if i# = 8 then Bo-oborot-eff[1 ]  = Bo-oborot-eff[1]  + oborot-eff[1]  .
     4508     if i# = 8 then    if  Bi-oborot-sum-cost[2] <>  0 then
     4509                           Bi-oborot-prc[1] = 100 * (BI-oborot-sum-sale[8] - BI-oborot-sum-cost[2] ) / Bi-oborot-sum-cost[2] .
     4510                      else Bi-oborot-prc[1] = 0.
     4511     if i# = 8 then    if  Bo-oborot-sum-cost[2] <>  0 then
     4512                           BO-oborot-prc[1] = 100 * (Bo-oborot-sum-sale[8] - Bo-oborot-sum-cost[2] ) / Bo-oborot-sum-cost[2] .
     4513                      else BO-oborot-prc[1] = 0.
     4514     if i# = 8 then    if  B1-oborot-sum-cost[2] <>  0 then
     4515                           B1-oborot-prc[1] = 100 * (B1-oborot-sum-sale[8] - B1-oborot-sum-cost[2] ) / B1-oborot-sum-cost[2] .
     4516                      else B1-oborot-prc[1] = 0.
     4517     if i# = 8 then    if  B2-oborot-sum-cost[2] <>  0 then
     4518                           B2-oborot-prc[1] = 100 * (B2-oborot-sum-sale[8] - B2-oborot-sum-cost[2] ) / B2-oborot-sum-cost[2] .
     4519                      else B2-oborot-prc[1] = 0.
     4520    End.
     4521   END PROCEDURE.
     4522   PROCEDURE Sum-i :
     4523   define input parameter ob like oborot-ot[1] no-undo.
     4524   define input parameter tt as int  no-undo.
     4525   define input-output parameter b1 like b1-oborot-ot[1] no-undo.
     4526   define input-output parameter b2 like b1-oborot-ot[1] no-undo.
     4527   define input-output parameter bi like b1-oborot-ot[1] no-undo.
     4528   define input-output parameter bo like b1-oborot-ot[1] no-undo.
     4529   define input parameter ob2 like oborot-ot[1] no-undo.
     4530   define input-output parameter b1- like b1-oborot-ot[1] no-undo.
     4531   define input-output parameter b2- like b1-oborot-ot[1] no-undo.
     4532   define input-output parameter bi- like b1-oborot-ot[1] no-undo.
     4533   define input-output parameter bo- like b1-oborot-ot[1] no-undo.
     4534   Assign
     4535     B1 = B1 + ob
     4536     B2 = B2 + ob
     4537     B1- = B1- + ob2
     4538     B2- = B2- + ob2
     4539     Bi = Bi + ob
     4540     Bo = Bo + ob
     4541     Bi- = Bi- + ob2
     4542     Bo- = Bo- + ob2
     4543   .
     4544   END PROCEDURE.
     4545   PROCEDURE Clear-item :
     4546   define variable kk as int no-undo.
     4547    REPEAT kk = 1 to 12 :
     4548    Assign
     4549       oborot-ie                 [kk]    = 0
     4550       oborot-ee                 [kk]    = 0
     4551       oborot-ep              [kk]    = 0
     4552       oborot-es            [kk]    = 0
     4553       oborot-re             [kk]    = 0
     4554       oborot-rs        [kk]    = 0
     4555       oborot-we                 [kk]    = 0
     4556       oborot-vt                       [kk]    = 0
     4557       oborot-iv                 [kk]    = 0
     4558       oborot-ev                 [kk]    = 0
     4559       oborot-rv             [kk]    = 0
     4560       oborot-em                  [kk]    = 0
     4561       oborot-wm                  [kk]    = 0
     4562       oborot-im                  [kk]    = 0
     4563       oborot-ot                  [kk]    = 0
     4564       oborot-disc                            [kk]    = 0
     4565       oborot-eff                            [kk]    = 0
     4566       oborot-prc                            [kk]    = 0
     4567       oborot-ap            [kk]    = 0
     4568       oborot-pc            [kk]    = 0
     4569       oborot-r-v                                    [kk]    = 0
     4570       ostatok-end      [kk] =   0
     4571       ostatok-start    [kk] =   0   .
     4572          End.
     4573    END PROCEDURE.
     4574   PROCEDURE Item-Goods :
     4575    define input parameter  par-3 as char no-undo.
     4576    define input parameter  par-4 as char no-undo.
     4577    if line-counter( OutStream )  > page-size( OutStream ) then DO :
     4578                    display STREAM OutStream    with frame top-frame .
     4579                    display STREAM OutStream    with frame top-2 .
     4580                    end.
     4581        if par-4 = "goods":U  Then  assign
     4582                   gds-zap-unit-base  = goods.unit-base
     4583                   gds-zap-prt-root   = Goods.prt-root
     4584                   gds-zap-prod-type  = Goods.prod-type
     4585                   gds-zap-prod-code  = Goods.prod-code
     4586                   gds-zap-artic      = Goods.artic
     4587                   gds-zap-type       = Goods.gds-type
     4588                   gds-zap-grp-name   = Goods.grp-name
     4589                   gds-zap-b-code     = Goods.gds-code
     4590                   gds-zap-gds-name   = if g#gds-engl then Goods.engl-name
     4591                                                       else Goods.gds-name.
     4592        if par-4 = "gds-list":U  Then  assign
     4593                     gds-zap-unit-base  = gds-list.unit-base
     4594                     gds-zap-prt-root   = gds-list.prt-root
     4595                     gds-zap-prod-type  = gds-list.prod-type
     4596                     gds-zap-prod-code  = gds-list.prod-code
     4597                     gds-zap-artic      = gds-list.artic
     4598                     gds-zap-type       = gds-list.gds-type
     4599                     gds-zap-grp-name   = gds-list.grp-name
     4600                     gds-zap-b-code     = gds-list.gds-code
     4601                     gds-zap-gds-name   = if g#gds-engl then Gds-list.engl-name
     4602                                                         else Gds-list.gds-name.
     4603     Run foreach  in this-procedure .
     4604   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     4605     (input  gds-zap-b-code
     4606     ,input  ?
     4607     ,output v-bar-code
     4608     )  .
     4609   s-bar-code = string (v-bar-code,"999999999").
     4610       If  break_group = true  and par-3 <> "1"  then DO :
     4611            FIND FIRST clients WHERE clients.obj-type = gds-zap-prod-type AND clients.obj-code = gds-zap-prod-code use-index pi NO-LOCK .
     4612            gds-zap-prod-name  = clients.obj-name.
     4613             If break_group1 = true  THEN  DO :
     4614               if (par-3 = "3"  OR  par-3 = "5" ) and  par-3 <> "6"
     4615                 then DO: Assign temp-str = string("ГРУППА : " + gds-zap-grp-name )         b1-name = gds-zap-grp-name . end.
     4616                 else DO: Assign temp-str = string("ПРОИЗВОДИТЕЛЬ : " + gds-zap-prod-name ) b1-name = gds-zap-prod-name. end.
     4617               if par-3 = "6"  then  dO:
     4618                  if xTog-obj = true then do:
     4619                    var-vat-pc = func-vat (input gds-zap-b-code , input x-store-type, input x-store-code)
     4620                     .
     4621                   end.
     4622                  else do:
     4623                   var-vat-pc = temp-gds-list.vat-pc .
     4624                   end.
     4625                   assign
     4626                       temp-str = string( "СТАВКА НДС : " + string(var-vat-pc) + "%" )
     4627                       b1-name = temp-str.
     4628                   end.
     4629               if NOT xSumsOnly or (par-3 = "4" Or par-3 = "5" ) THEN DO :
     4630                   fr0 = true .
     4631                   tmp#stroka0 = temp-str.
     4632               End.
     4633             End.
     4634               IF (par-3 = "4"  OR  par-3 = "5")  THEN DO:
     4635                 if par-3 = "4"
     4636                   then Assign temp-str = string("ГРУППА : " + gds-zap-grp-name )          b2-name = gds-zap-grp-name .
     4637                   else Assign temp-str = string("ПРОИЗВОДИТЕЛЬ : " + gds-zap-prod-name )  b2-name = gds-zap-prod-name.
     4638                 if NOT xSumsOnly THEN DO:
     4639                     fr = true .
     4640                 End.
     4641                 break_group1 = false.
     4642               END.
     4643          break_group = false.
     4644       End.
     4645     Run display-line   in this-procedure .
     4646   END PROCEDURE.
