     4767   Procedure b1-Null-str-pr2 :
     4768    if (
     4769        b1-oborot-im                 [1] = 0 and
     4770        b1-oborot-wm                 [1] = 0 and
     4771        b1-oborot-em                 [1] = 0 and
     4772        b1-oborot-ie                 [1] = 0  and
     4773        b1-oborot-ee                 [1] = 0  and
