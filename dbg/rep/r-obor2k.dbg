     2225   PROCEDURE display-line :
     2226     i = i + 1.
     2227      IF NOT  (NOT Show-Negativ   AND Null-Str#  = 0  ) then DO:
     2228         IF NOT  (NOT Show-Negativ-2 AND Null-Str2# = 0  ) then DO:
     2229           new-page = PAGE-NUMBER( OutStream).
     2230           If old-page <> new-page then p = 0.
     2231           IF NOT Sums-Only then  do:
     2232               if fr0 = true then do:
     2233                 PUT stream  OutStream  tmp#stroka0 format "X(100)" SKIP.
     2234                 fr0 = false .
     2235               end.
     2236               if fr = true then dO:
     2237                 PUT stream OutStream space(6) temp-str format "X(100)" SKIP.
     2238                 fr = false .
     2239               end.
     2240               Run Display-str1  in this-procedure .
     2241               end.
     2242         End.
     2243       END.
     2244       old-page = new-page.
     2245   END PROCEDURE.
     2246   PROCEDURE print-header :
     2247   if NOT FirstLine Then  Run Display-Title  in this-procedure .
     2248       FirstLine = TRUE .
     2249       if xTog-obj and   x-SelectObject <> "currency":U   Then  DO:
     2250             PUT stream  OutStream  UNFORMATTED
     2251             string(  "ПО ОБЪЕКТУ : (" + x-store-type  + string(x-store-code)  +  ") " + ObjName)
     2252             AT 30 format "X(170)" SKIP.
     2253             End.
     2254             FORM with FRAME ZAPAS .   DOWN stream   OutStream 1 with FRAME ZAPAS .
     2255         RUN Clear-B1  in this-procedure .
     2256         RUN Clear-B2  in this-procedure .
     2257         RUN Clear-Bi  in this-procedure .
     2258         break_group = true.
     2259         break_group1 = true.
     2260         display STREAM OutStream     with frame top-Frame .
     2261         display STREAM OutStream     with frame top-2 .
     2262   END PROCEDURE.
     2263   PROCEDURE Print-Footer :
     2264         If RetClassify = "no-classify":U  then Run U-line  in this-procedure .
     2265          gds-zap-artic = "ИТОГО" .
     2266          Run display-BI  in this-procedure .
     2267          Run U-line  in this-procedure .
     2268          END PROCEDURE.
     2269   PROCEDURE U-LINE :
     2270           PUT stream  OutStream  UNFORMATTED  line2 SKIP.
     2271   END PROCEDURE.
     2272   PROCEDURE P-LINE :
     2273           END PROCEDURE.
     2274   PROCEDURE CalcItog :
     2275       run ostatok   in this-procedure (
     2276           input x-store-code  ,
     2277           input x-store-type  , x-TOG-Shift,
     2278           input x-date-start - 1 ,
     2279           input date('')      , x-Shift-Start,x-Shift-End,
     2280           input 'crsa':U   ,
     2281           input '##,##':U,
     2282           input xTog-obj ,
     2283           output  Quantity1  ,
     2284           output  Coast_R1   ,
     2285           output  Coast_V1   ,
     2286           output  VAT_R1     ,
     2287           output  VAT_V1     ,
     2288           output  Fact-order-1 ).
     2289       run ostatok   in this-procedure (
     2290           input x-store-code  ,
     2291           input x-store-type  , x-TOG-Shift,
     2292           input x-date-start  ,
     2293           input x-date-end    , x-Shift-Start,x-Shift-End,
     2294           input 'crsa':U   ,
     2295           input '##,##':U,
     2296           input xTog-obj ,
     2297           output  Quantity1  ,
     2298           output  Coast_R1   ,
     2299           output  Coast_V1   ,
     2300           output  VAT_R1     ,
     2301           output  VAT_V1     ,
     2302           output  Fact-order-2 ).
     2303             Quantity1  = 0.
     2304             Coast_R1   = 0.
     2305             Coast_V1   = 0.
     2306             VAT_R1     = 0.
     2307             VAT_V1     = 0.
     2308   END PROCEDURE.
     2309   PROCEDURE display-str1  :
     2310     assign
     2311       v-gds-num = v-gds-num + 1
     2312     .
     2313    if line-counter( OutStream )  > page-size( OutStream ) then DO : display STREAM OutStream    with frame top-frame. end.
     2314     p = p + 1.
     2315     if use-column[28] then c-str-num:screen-value           =  string( v-gds-num ) .
     2316     if use-column[1] then  c-s-bar-code:screen-value        = s-bar-code.
     2317     if use-column[2] then  c-gds-zap-artic:screen-value     = gds-zap-artic.
     2318     if use-column[3] then  c-gds-zap-gds-name:screen-value  = gds-zap-gds-name.
     2319     if use-column[4] then  c-gds-zap-unit-base:screen-value = gds-zap-unit-base.
