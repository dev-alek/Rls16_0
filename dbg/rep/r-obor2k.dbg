     5018                                                                                           Bo-oborot-es    [3] +
     5019                                                                                           Bo-oborot-rs[3] )
     5020                                                                                            ).
     5021   DISPLAY stream OutStream with FRAME ZAPAS.  DOWN stream   OutStream 1 with FRAME ZAPAS.
     5022     End.
     5023   run PRICE-VAT-3(pp).
     5024   END PROCEDURE.
     5025   PROCEDURE PRICE-VAT-3 :
     5026   define input parameter PP as character no-undo .
     5027   if pp =  'B1' THEN DO:
     5028   if line-counter( OutStream ) > page-size( OutStream ) then DO: display STREAM OutStream with frame top-frame. end.
     5029   p = p + 1.
     5030   if use-column[1] then  c-s-bar-code:screen-value        = ''.
     5031   if use-column[2] then  c-gds-zap-artic:screen-value     = ''.
     5032   if use-column[3] then  c-gds-zap-gds-name:screen-value  = ''.
     5033   if use-column[4] then  c-gds-zap-unit-base:screen-value = ''.
     5034   if use-column[5] then  c-gds-type:screen-value          = v-name-type.
     5035   if use-column[6]  then C-ostatok-start:screen-value                          = if x-vat then  string( B1-ostatok-start  [2]                         ) else  string( B1-ostatok-start  [2]                        - B1-ostatok-start  [3]                       )  .
     5036   if use-column[7]  then C-oborot-ie:screen-value          = if x-vat then  string( B1-oborot-ie [2]          ) else  string( B1-oborot-ie [2]         - B1-oborot-ie [3]        )  .
     5037   if use-column[8]  then C-oborot-iv:screen-value          = if x-vat then  string( B1-oborot-iv [2]          ) else  string( B1-oborot-iv [2]         - B1-oborot-iv [3]        )  .
     5038   if use-column[9]  then C-oborot-im:screen-value           = if x-vat then  string( B1-oborot-im  [2]          ) else  string( B1-oborot-im  [2]         - B1-oborot-im  [3]        )  .
     5039   if use-column[10] then C-oborot-ee:screen-value          = if x-vat then  string( B1-oborot-ee [2]          ) else  string( B1-oborot-ee [2]         - B1-oborot-ee [3]        )  .
     5040   if use-column[11] then C-oborot-ev:screen-value          = if x-vat then  string( B1-oborot-ev [2]          ) else  string( B1-oborot-ev [2]         - B1-oborot-ev [3]        )  .
     5041   if use-column[12] then C-oborot-em:screen-value           = if x-vat then  string( B1-oborot-em  [2]          ) else  string( B1-oborot-em  [2]         - B1-oborot-em  [3]        )  .
     5042   if use-column[13] then C-oborot-we:screen-value          = if x-vat then  string( B1-oborot-we         [2]  ) else  string( B1-oborot-we         [2] - B1-oborot-we         [3])  .
     5043   if use-column[14] then C-oborot-es:screen-value     = if x-vat then  string( B1-oborot-es    [2]  ) else  string( B1-oborot-es    [2] - B1-oborot-es    [3])  .
     5044   if use-column[15] then C-oborot-rs:screen-value = if x-vat then  string( B1-oborot-rs[2]  ) else  string( B1-oborot-rs[2] - B1-oborot-rs[3])  .
     5045   if use-column[16] then C-oborot-re:screen-value      = if x-vat then  string( B1-oborot-re     [2]  ) else  string( B1-oborot-re     [2] - B1-oborot-re     [3])  .
     5046   if use-column[17] then C-oborot-ep:screen-value       = if x-vat then  string( B1-oborot-ep      [2]  ) else  string( B1-oborot-ep      [2] - B1-oborot-ep      [3])  .
     5047   if use-column[18] then C-oborot-rv:screen-value      = if x-vat then  string( B1-oborot-rv     [2]  ) else  string( B1-oborot-rv     [2] - B1-oborot-rv     [3])  .
     5048   if use-column[19] then C-oborot-vt:screen-value                = if x-vat then  string( B1-oborot-vt               [2]  ) else  string( B1-oborot-vt               [2] - B1-oborot-vt               [3])  .
     5049   if use-column[20] then C-oborot-ot:screen-value           = if x-vat then  string( B1-oborot-ot          [2]  ) else  string( B1-oborot-ot          [2] - B1-oborot-ot          [3])  .
     5050   if use-column[22] then C-ostatok-end:screen-value                            = if x-vat then  string( B1-ostatok-end                           [2]  ) else  string( B1-ostatok-end                           [2] - B1-ostatok-end                           [3])  .
     5051   if use-column[25] then C-oborot-ap:screen-value     = if x-vat then  string( B1-oborot-ap    [2])   else  string( B1-oborot-ap [2]    - B1-oborot-ap [3]   )  .
     5052   if use-column[26] then C-oborot-pc:screen-value     = if x-vat then  string( B1-oborot-pc    [2])   else  string( B1-oborot-pc [2]    - B1-oborot-pc [3]   )  .
     5053   if use-column[27] then C-oborot-r-v:screen-value                             = if x-vat then  string(
     5054                                                                                           B1-oborot-ee         [2] +
     5055                                                                                           B1-oborot-re     [2] +
     5056                                                                                           B1-oborot-es    [2] +
     5057                                                                                           B1-oborot-rs[2]
     5058                                                                                           )
     5059                                                                                            else  string(
     5060                                                                                          (B1-oborot-ee         [2] +
     5061                                                                                           B1-oborot-re     [2] +
     5062                                                                                           B1-oborot-es    [2] +
     5063                                                                                           B1-oborot-rs[2]) -
     5064                                                                                          (B1-oborot-ee         [3] +
     5065                                                                                           B1-oborot-re     [3] +
     5066                                                                                           B1-oborot-es    [3] +
     5067                                                                                           B1-oborot-rs[3] )
     5068                                                                                            ).
     5069   DISPLAY stream OutStream with FRAME ZAPAS.  DOWN stream   OutStream 1 with FRAME ZAPAS.
     5070     End.
     5071   run PRICE-VAT-4(pp).
     5072   END PROCEDURE.
     5073   PROCEDURE PRICE-VAT-4 :
     5074   define input parameter PP as character no-undo .
     5075   if pp =   'B2' THEN DO:
     5076   if line-counter( OutStream ) > page-size( OutStream ) then DO: display STREAM OutStream with frame top-frame. end.
     5077   p = p + 1.
     5078   if use-column[1] then  c-s-bar-code:screen-value        = ''.
     5079   if use-column[2] then  c-gds-zap-artic:screen-value     = ''.
     5080   if use-column[3] then  c-gds-zap-gds-name:screen-value  = ''.
     5081   if use-column[4] then  c-gds-zap-unit-base:screen-value = ''.
     5082   if use-column[5] then  c-gds-type:screen-value          = v-name-type.
     5083   if use-column[6]  then C-ostatok-start:screen-value                          = if x-vat then  string( B2-ostatok-start  [2]                         ) else  string( B2-ostatok-start  [2]                        - B2-ostatok-start  [3]                       )  .
     5084   if use-column[7]  then C-oborot-ie:screen-value          = if x-vat then  string( B2-oborot-ie [2]          ) else  string( B2-oborot-ie [2]         - B2-oborot-ie [3]        )  .
     5085   if use-column[8]  then C-oborot-iv:screen-value          = if x-vat then  string( B2-oborot-iv [2]          ) else  string( B2-oborot-iv [2]         - B2-oborot-iv [3]        )  .
     5086   if use-column[9]  then C-oborot-im:screen-value           = if x-vat then  string( B2-oborot-im  [2]          ) else  string( B2-oborot-im  [2]         - B2-oborot-im  [3]        )  .
     5087   if use-column[10] then C-oborot-ee:screen-value          = if x-vat then  string( B2-oborot-ee [2]          ) else  string( B2-oborot-ee [2]         - B2-oborot-ee [3]        )  .
     5088   if use-column[11] then C-oborot-ev:screen-value          = if x-vat then  string( B2-oborot-ev [2]          ) else  string( B2-oborot-ev [2]         - B2-oborot-ev [3]        )  .
     5089   if use-column[12] then C-oborot-em:screen-value           = if x-vat then  string( B2-oborot-em  [2]          ) else  string( B2-oborot-em  [2]         - B2-oborot-em  [3]        )  .
     5090   if use-column[13] then C-oborot-we:screen-value          = if x-vat then  string( B2-oborot-we         [2]  ) else  string( B2-oborot-we         [2] - B2-oborot-we         [3])  .
     5091   if use-column[14] then C-oborot-es:screen-value     = if x-vat then  string( B2-oborot-es    [2]  ) else  string( B2-oborot-es    [2] - B2-oborot-es    [3])  .
     5092   if use-column[15] then C-oborot-rs:screen-value = if x-vat then  string( B2-oborot-rs[2]  ) else  string( B2-oborot-rs[2] - B2-oborot-rs[3])  .
     5093   if use-column[16] then C-oborot-re:screen-value      = if x-vat then  string( B2-oborot-re     [2]  ) else  string( B2-oborot-re     [2] - B2-oborot-re     [3])  .
     5094   if use-column[17] then C-oborot-ep:screen-value       = if x-vat then  string( B2-oborot-ep      [2]  ) else  string( B2-oborot-ep      [2] - B2-oborot-ep      [3])  .
     5095   if use-column[18] then C-oborot-rv:screen-value      = if x-vat then  string( B2-oborot-rv     [2]  ) else  string( B2-oborot-rv     [2] - B2-oborot-rv     [3])  .
     5096   if use-column[19] then C-oborot-vt:screen-value                = if x-vat then  string( B2-oborot-vt               [2]  ) else  string( B2-oborot-vt               [2] - B2-oborot-vt               [3])  .
     5097   if use-column[20] then C-oborot-ot:screen-value           = if x-vat then  string( B2-oborot-ot          [2]  ) else  string( B2-oborot-ot          [2] - B2-oborot-ot          [3])  .
     5098   if use-column[22] then C-ostatok-end:screen-value                            = if x-vat then  string( B2-ostatok-end                           [2]  ) else  string( B2-ostatok-end                           [2] - B2-ostatok-end                           [3])  .
     5099   if use-column[25] then C-oborot-ap:screen-value     = if x-vat then  string( B2-oborot-ap    [2])   else  string( B2-oborot-ap [2]    - B2-oborot-ap [3]   )  .
     5100   if use-column[26] then C-oborot-pc:screen-value     = if x-vat then  string( B2-oborot-pc    [2])   else  string( B2-oborot-pc [2]    - B2-oborot-pc [3]   )  .
     5101   if use-column[27] then C-oborot-r-v:screen-value                             = if x-vat then  string(
     5102                                                                                           B2-oborot-ee         [2] +
     5103                                                                                           B2-oborot-re     [2] +
     5104                                                                                           B2-oborot-es    [2] +
     5105                                                                                           B2-oborot-rs[2]
     5106                                                                                           )
     5107                                                                                            else  string(
     5108                                                                                          (B2-oborot-ee         [2] +
     5109                                                                                           B2-oborot-re     [2] +
     5110                                                                                           B2-oborot-es    [2] +
     5111                                                                                           B2-oborot-rs[2]) -
     5112                                                                                          (B2-oborot-ee         [3] +
     5113                                                                                           B2-oborot-re     [3] +
     5114                                                                                           B2-oborot-es    [3] +
     5115                                                                                           B2-oborot-rs[3] )
     5116                                                                                            ).
     5117   DISPLAY stream OutStream with FRAME ZAPAS.  DOWN stream   OutStream 1 with FRAME ZAPAS.
     5118   End.
     5119   END PROCEDURE.
     5120   procedure pp :
     5121   define input parameter ll as integer no-undo .
     5122   define input parameter uu as integer no-undo .
     5123   define input parameter ff as character no-undo .
     5124   End procedure.
     5125   procedure find-last-prise-med :
     5126   define input parameter p-artic     like ub.goods.artic no-undo .
     5127   define input parameter p-prod-type like ub.goods.prod-type no-undo .
     5128   define input parameter p-prod-code like ub.goods.prod-code no-undo .
     5129   define input parameter p-host-code like ub.gds-obj.host-code no-undo .
     5130   define output parameter  p-price   like ub.gds-obj.last-base no-undo .
     5131   define buffer p-gds-obj   for  ub.gds-obj .
     5132   define buffer buf_trn-doc for  ub.trn-doc .
     5133   define variable v-fact-order as decimal no-undo .
     5134   p-price = 0 .
     5135     define variable v-in-date as date      no-undo .
     5136     define variable fl as logical no-undo .
     5137     fl = yes.
     5138     v-fact-order = 0 .
     5139     for each tt-obj-list no-lock break by tt-obj-list.obj-type by tt-obj-list.obj-code
     5140     :
     5141       find first p-gds-obj no-lock
     5142         where p-gds-obj.artic     = p-artic         and
     5143                 p-gds-obj.prod-type = p-prod-type     and
     5144                 p-gds-obj.prod-code = p-prod-code     and
     5145                 p-gds-obj.obj-code  = tt-obj-list.obj-code and
     5146                 p-gds-obj.obj-type  = tt-obj-list.obj-type
     5147         no-error .
     5148       if available p-gds-obj then do:
     5149       if p-gds-obj.in-date = ?  then next .
     5150       if fl = yes then do:
     5151         assign
     5152           v-in-date = p-gds-obj.in-date
     5153           p-price   =  if tPrintRubl then  p-gds-obj.last-rubl else  p-gds-obj.last-base
     5154           fl = no
     5155       .
     5156        find first buf_trn-doc no-lock  where buf_trn-doc.doc-code = p-gds-obj.in-code no-error  .
     5157        if available buf_trn-doc  then  v-fact-order = buf_trn-doc.fact-order .
     5158       end.
     5159         if p-gds-obj.in-date >= v-in-date   then do:
     5160            if p-gds-obj.in-date = v-in-date then do:
     5161               find first buf_trn-doc no-lock  where buf_trn-doc.doc-code = p-gds-obj.in-code no-error .
     5162               if available buf_trn-doc  then
     5163                   if buf_trn-doc.fact-order >  v-fact-order   then do:
     5164                     assign
     5165                       v-fact-order = buf_trn-doc.fact-order
     5166                       p-price   =  if tPrintRubl then  p-gds-obj.last-rubl else  p-gds-obj.last-base
     5167                       v-in-date =   p-gds-obj.in-date
     5168                     .
     5169                   end.
     5170            end.
     5171            else do:
     5172             find first buf_trn-doc no-lock  where buf_trn-doc.doc-code = p-gds-obj.in-code no-error .
     5173             if available buf_trn-doc  then
     5174                 assign
     5175                   p-price   =    if tPrintRubl then  p-gds-obj.last-rubl else  p-gds-obj.last-base
     5176                   v-in-date =    p-gds-obj.in-date
     5177                   v-fact-order = buf_trn-doc.fact-order .
     5178                 .
     5179             end.
     5180           if p-price = ? then   p-price  = 0 .
     5181         end.
     5182       end.
     5183     End .
     5184     if p-price = ? then   p-price  = 0 .
     5185   end procedure.
     5186   procedure find-mediator :
     5187   define input  parameter c-host-code as integer no-undo .
     5188   define input  parameter p-Showmediatr as logical no-undo .
     5189   define output parameter p-host-code as integer no-undo .
     5190   define output parameter p-flag as logical no-undo .
     5191   define buffer b-sysconf  for ub.sysconf.
     5192    p-host-code = 0 .
     5193    p-flag  = true .
     5194       if p-Showmediatr = true then do:
     5195       find first ub.sysconf where ub.sysconf.avrg-price = true no-lock no-error .
     5196             if avail ub.sysconf then DO :
     5197               p-host-code = ub.sysconf.host-code.
     5198               if tPrintRubl = false then do:
     5199                     find first b-sysconf where b-sysconf.host-code = c-host-code no-lock no-error .
     5200                           if  ub.sysconf.base-code <> b-sysconf.base-code then DO:
     5201                                 p-flag  = false  .
     5202                                 message "Базовая валюта посредника и базовая валюта текущей фирмы не совпадает . Нельзя получить отчет в валюте !"
     5203                                 view-as alert-box error.
     5204                           end.
     5205               end.
     5206             end.
     5207             for each ub.shop no-lock where ub.shop.host-code = p-host-code :
     5208                 create tt-obj-list no-error .
     5209                 assign tt-obj-list.obj-type = 'маг':U
     5210                        tt-obj-list.obj-code = ub.shop.obj-code no-error .
     5211             end.
     5212             for each ub.store no-lock where ub.store.host-code = p-host-code :
     5213                 create tt-obj-list no-error .
     5214                 assign tt-obj-list.obj-type = 'скл':U
     5215                        tt-obj-list.obj-code = ub.store.obj-code no-error .
     5216             end.
     5217       End.
     5218    End procedure .
     5219   procedure ost-line :
     5220     define input  parameter x-store-code like ub.clients.obj-code    no-undo .
     5221     define input  parameter x-store-type like ub.clients.obj-type    no-undo .
     5222     define input  parameter x-artic      like ub.stk-line.artic      no-undo .
     5223     define input  parameter x-prod-code  like ub.stk-line.prod-code  no-undo .
     5224     define input  parameter x-prod-type  like ub.stk-line.prod-type  no-undo .
     5225     define input  parameter x-tog-shift  as logical no-undo .
     5226     define input  parameter x-fact-order like ub.stk-line.fact-order no-undo .
     5227     define input  parameter x-sum-type   like ub.stk-line.sum-type   no-undo .
     5228     define input  parameter x-cat-id     like ub.stk-line.cat-id     no-undo .
     5229     define input  parameter xtog-obj     as logical no-undo .
     5230     define output parameter quantity     like ub.stk-line.fact-qnty  no-undo .
     5231     define output parameter coast_r      like ub.stk-line.sum-rubl   no-undo .
     5232     define output parameter coast_v      like ub.stk-line.sum-rubl   no-undo .
     5233     define output parameter vat_r        like ub.stk-line.sum-rubl   no-undo .
     5234     define output parameter vat_v        like ub.stk-line.sum-rubl   no-undo .
     5235     define output parameter slt_r        like ub.stk-line.sum-rubl   no-undo .
     5236     define output parameter slt_v        like ub.stk-line.sum-rubl   no-undo .
     5237     define buffer buff-obj-list  for obj-list .
     5238     define buffer buff-stk-line  for ub.stk-line .
     5239     assign
     5240       Quantity = 0
     5241       Coast_R  = 0
     5242       Coast_V  = 0
     5243       VAT_R    = 0
     5244       VAT_V    = 0
     5245       SLT_R    = 0
     5246       SLT_V    = 0
     5247     .
     5248     if  x-tog-shift = false then do:
     5249       for each buff-obj-list no-lock
     5250       on error undo, return error
     5251       :
     5252         find last buff-stk-line no-lock
     5253           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     5254             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     5255             and buff-stk-line.artic      = x-artic
     5256             and buff-stk-line.prod-type  = x-prod-type
     5257             and buff-stk-line.prod-code  = x-prod-code
     5258             and buff-stk-line.sum-type   = x-sum-type
     5259             and buff-stk-line.cat-id     = '##,##':U
     5260             and buff-stk-line.fact-order <= x-fact-order
     5261             and buff-stk-line.shift-num  = 0
     5262           use-index category
     5263           no-error .
     5264         if available buff-stk-line then do:
     5265           assign
     5266             Quantity = Quantity +  buff-stk-line.fact-qnty
     5267             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     5268             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     5269             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     5270             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     5271             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     5272             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     5273           .
     5274         end.
     5275       end.
     5276     end.
     5277     else do:
     5278       for each buff-obj-list no-lock
     5279         where xtog-obj = false
     5280            or (buff-obj-list.obj-type = x-store-type
     5281               and buff-obj-list.obj-code = x-store-code
     5282               )
     5283       on error undo, return error
     5284       :
     5285         find last buff-stk-line no-lock
     5286           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     5287             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     5288             and buff-stk-line.artic      = x-artic
     5289             and buff-stk-line.prod-type  = x-prod-type
     5290             and buff-stk-line.prod-code  = x-prod-code
     5291             and buff-stk-line.sum-type   = x-sum-type
     5292             and buff-stk-line.cat-id     = '##,##':U
     5293             and buff-stk-line.fact-order <= x-fact-order
     5294             and buff-stk-line.shift-num  > 0
     5295           use-index category
     5296           no-error .
     5297         if available buff-stk-line then do:
     5298           assign
     5299             Quantity = Quantity +  buff-stk-line.fact-qnty
     5300             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     5301             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     5302             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     5303             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     5304             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     5305             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     5306           .
     5307         end.
     5308       end.
     5309     end.
     5310   end procedure.
     5311   procedure ost-lineother-tax :
     5312     define input  parameter x-store-code like ub.clients.obj-code      no-undo.
     5313     define input  parameter x-store-type like ub.clients.obj-type      no-undo.
     5314     define input  parameter x-artic      like ub.stk-line.artic        no-undo.
     5315     define input  parameter x-prod-code  like ub.stk-line.prod-code    no-undo.
     5316     define input  parameter x-prod-type  like ub.stk-line.prod-type    no-undo.
     5317     define input  parameter x-tog-shift  as logical no-undo .
     5318     define input  parameter x-fact-order like ub.stk-line.fact-order   no-undo.
     5319     define input  parameter x-sum-type   like ub.stk-line.sum-type     no-undo.
     5320     define input  parameter x-type-id    like ub.stk-line.cat-id       no-undo.
     5321     define input  parameter xTog-obj     as logical no-undo .
     5322     define output parameter Quantity     like ub.stk-line.fact-qnty   no-undo.
     5323     define output parameter Coast_R      like ub.stk-line.sum-rubl    no-undo.
     5324     define output parameter Coast_V      like ub.stk-line.sum-rubl    no-undo.
     5325     define output parameter VAT_R        like ub.stk-line.sum-rubl    no-undo.
     5326     define output parameter VAT_V        like ub.stk-line.sum-rubl    no-undo.
     5327     define output parameter SLT_R        like ub.stk-line.sum-rubl    no-undo.
     5328     define output parameter SLT_V        like ub.stk-line.sum-rubl    no-undo.
     5329     define output parameter other_R      like ub.stk-line.sum-rubl    no-undo.
     5330     define output parameter other_V      like ub.stk-line.sum-rubl    no-undo.
     5331     define buffer buff-obj-list  for obj-list .
     5332     define buffer buff-stk-line  for ub.stk-line .
     5333     assign
     5334       Quantity = 0
     5335       Coast_R  = 0
     5336       Coast_V  = 0
     5337       VAT_R    = 0
     5338       VAT_V    = 0
     5339       SLT_R    = 0
     5340       SLT_V    = 0
     5341       other_R  = 0
     5342       other_V  = 0
     5343     .
     5344     if  x-tog-shift = false then do:
     5345       for each buff-obj-list no-lock
     5346       on error undo, return error
     5347       :
     5348         find last buff-stk-line no-lock
     5349           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     5350             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     5351             and buff-stk-line.artic      = x-artic
     5352             and buff-stk-line.prod-type  = x-prod-type
     5353             and buff-stk-line.prod-code  = x-prod-code
     5354             and buff-stk-line.sum-type   = x-sum-type
     5355             and buff-stk-line.cat-id     = '##,##':U
     5356             and buff-stk-line.fact-order <= x-fact-order
     5357             and buff-stk-line.shift-num  = 0
     5358           use-index category
     5359           no-error .
     5360         if available buff-stk-line then do:
     5361           assign
     5362             Quantity = Quantity +  buff-stk-line.fact-qnty
     5363             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     5364             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     5365             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     5366             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     5367             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     5368             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     5369             other_R  = other_R  +  buff-stk-line.other-rubl
     5370             other_V  = other_V  +  buff-stk-line.other-base
     5371           .
     5372         end.
     5373       end.
     5374     end.
     5375     else do:
     5376       for each buff-obj-list no-lock
     5377         where xtog-obj = false
     5378            or (buff-obj-list.obj-type = x-store-type
     5379               and buff-obj-list.obj-code = x-store-code
     5380               )
     5381       on error undo, return error
     5382       :
     5383         find last buff-stk-line no-lock
     5384           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     5385             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     5386             and buff-stk-line.artic      = x-artic
     5387             and buff-stk-line.prod-type  = x-prod-type
     5388             and buff-stk-line.prod-code  = x-prod-code
     5389             and buff-stk-line.sum-type   = x-sum-type
     5390             and buff-stk-line.cat-id     = '##,##':U
     5391             and buff-stk-line.fact-order <= x-fact-order
     5392             and buff-stk-line.shift-num  > 0
     5393           use-index category
     5394           no-error .
     5395         if available buff-stk-line then do:
     5396           assign
     5397             Quantity = Quantity +  buff-stk-line.fact-qnty
     5398             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     5399             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     5400             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     5401             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     5402             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     5403             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     5404             other_R = other_R   +  buff-stk-line.other-rubl
     5405             other_V = other_V   +  buff-stk-line.other-base
     5406           .
     5407         end.
     5408       end.
     5409     end.
     5410   end procedure.
     5411   procedure ost-line-kg :
     5412     define  input parameter p-obj-code    like ub.stk-line.obj-code   no-undo .
     5413     define  input parameter p-obj-type    like ub.stk-line.obj-type   no-undo .
     5414     define  input parameter p-artic       like ub.stk-line.artic      no-undo .
     5415     define  input parameter p-prod-code   like ub.stk-line.prod-code  no-undo .
     5416     define  input parameter p-prod-type   like ub.stk-line.prod-type  no-undo .
     5417     define  input parameter p-fact-order  like ub.stk-line.fact-order no-undo .
     5418     define output parameter p-quantity-kg like ub.stk-line.fact-qnty  no-undo initial 0.00 .
     5419     define buffer buff-obj-list  for obj-list .
     5420     define buffer buf_doc-line for ub.doc-line .
     5421     define buffer buf_inv-line for ub.inv-line .
     5422     do
     5423     on error undo, return error
     5424     :
     5425       for each buf_doc-line no-lock where
     5426                buf_doc-line.obj-type    = p-obj-type   and
     5427                buf_doc-line.obj-code    = p-obj-code   and
     5428                buf_doc-line.prod-type   = p-prod-type  and
     5429                buf_doc-line.prod-code   = p-prod-code  and
     5430                buf_doc-line.artic       = p-artic      and
     5431                buf_doc-line.status_     = 'факт':U      and
     5432                buf_doc-line.fact-order <= p-fact-order
     5433             by buf_doc-line.fact-order    descending
     5434       :
     5435         find first buf_inv-line no-lock where
     5436                    buf_inv-line.doc-code  = buf_doc-line.doc-code  and
     5437                    buf_inv-line.artic     = buf_doc-line.artic     and
     5438                    buf_inv-line.prod-type = buf_doc-line.prod-type and
     5439                    buf_inv-line.prod-code = buf_doc-line.prod-code no-error .
     5440         if available buf_inv-line
     5441         then do:
     5442           if buf_inv-line.after-cli-qnty <> ?
     5443           then do:
     5444             assign
     5445               p-quantity-kg = buf_inv-line.after-cli-qnty
     5446             .
     5447             leave .
     5448           end.
     5449         end.
     5450       end.
     5451       if p-quantity-kg = ?
     5452       then do:
     5453         assign
     5454           p-quantity-kg = 0
     5455         .
     5456       end.
     5457     end.
     5458   end procedure.
     5459   PROCEDURE ostatok :
     5460   def input parameter x-store-code  like ub.clients.obj-code    no-undo.
     5461   def input parameter x-store-type  like ub.clients.obj-type    no-undo.
     5462   def input parameter x-tog-shift   as   logical             no-undo.
     5463   def input parameter x-date-start  like ub.stk-tot.Fact-date   no-undo.
     5464   def input parameter x-date-end    like ub.stk-tot.Fact-date   no-undo.
     5465   def input parameter x-shift-start as integer               no-undo.
     5466   def input parameter x-shift-end   as integer               no-undo.
     5467   def input parameter x-sum-type    like ub.stk-tot.sum-type    no-undo.
     5468   def input parameter x-cat-id      like ub.stk-tot.cat-id      no-undo.
     5469   def input parameter xTog-obj   as log no-undo.
     5470   def output parameter Quantity    like ub.stk-tot.fact-qnty   no-undo.
     5471   def output parameter Coast_R     like ub.stk-tot.sum-rubl    no-undo.
     5472   def output parameter Coast_V     like ub.stk-tot.sum-rubl    no-undo.
     5473   def output parameter VAT_R       like ub.stk-tot.sum-rubl    no-undo.
     5474   def output parameter VAT_V       like ub.stk-tot.sum-rubl    no-undo.
     5475   def output parameter Fact-order  like ub.stk-tot.Fact-order  no-undo.
     5476   def var              Fact-order#   like ub.stk-tot.Fact-order  no-undo.
     5477   def var              Fact-orderS   as char  no-undo.
     5478   def var x-date-start-t  like ub.stk-tot.shift-date   no-undo.
     5479      Assign
     5480         Fact-order   = 0
     5481         Quantity     = 0
     5482         Coast_R      = 0
     5483         Coast_V      = 0
     5484         VAT_R        = 0
     5485         VAT_V        = 0 .
     5486    x-date-start-t  = x-date-start + 1 .
     5487   IF x-date-end = date('') then DO:
     5488      Fact-order = 0 .
     5489      for each obj-list
     5490          where  ( not xtog-obj or
     5491                 ( x-store-type = obj-list.obj-type and x-store-code = obj-list.obj-code ))
     5492                 no-lock :
     5493         if  x-tog-shift = false then do:
     5494                          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     5495                               ub.stk-tot.Fact-date <=  x-date-start
     5496                               and ub.stk-tot.shift-num = 0
     5497                               USE-INDEX fact-date no-lock no-error .
     5498              if Available ub.stk-tot THEN  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     5499         End.
     5500         Else  DO :
     5501             find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     5502              (ub.stk-tot.shift-date  = x-date-start-t and
     5503               ub.stk-tot.shift-num  < x-shift-start or
     5504               ub.stk-tot.shift-date  < x-date-start-t  )
     5505               and ub.stk-tot.shift-num  > 0
     5506               USE-INDEX Shift-num no-lock no-error .
     5507            If Available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     5508           END.
     5509       If Fact-order < Fact-order#  and Fact-order# <> 0  THEN  Fact-order = Fact-order# .
     5510     End.
     5511   End.
     5512   Else DO:
     5513     For each obj-list  WHERE
     5514        (NOT xTog-obj OR (x-store-type = obj-list.obj-type AND x-store-code = obj-list.obj-code))
     5515         no-lock :
     5516      IF  x-TOG-Shift = False Then DO:
     5517          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     5518               ub.stk-tot.Fact-date <= x-date-end
     5519               and ub.stk-tot.shift-num = 0
     5520               USE-INDEX fact-date no-lock no-error.
     5521          if available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     5522      END.
     5523      Else DO:
     5524           find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     5525               (ub.stk-tot.shift-date  = x-date-end and
     5526               ub.stk-tot.shift-num  <= x-shift-end or
     5527               ub.stk-tot.shift-date  < x-date-end       ) and
     5528               ub.stk-tot.shift-num   > 0      use-index shift-num no-lock no-error.
     5529               if Available ub.stk-tot THEN Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     5530       End.
     5531       if Fact-order < Fact-order#  THEN  Fact-order = Fact-order#.
     5532     End.
     5533   End.
     5534   END PROCEDURE.
     5535   procedure run2 :
     5536       case select-good :
     5537           when 1  then do:
     5538       define buffer buf_obj-list17 for obj-list.
     5539     for each buf_obj-list17 no-lock :
     5540         if xtog-obj and  not (buf_obj-list17.obj-type = x-store-type  and
     5541                               buf_obj-list17.obj-code = x-store-code )
     5542         then next.
     5543           for  each gds-obj   where
     5544                               gds-obj.obj-type = buf_obj-list17.obj-type    and
     5545                               gds-obj.obj-code = buf_obj-list17.obj-code
     5546                               and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     5547                               no-lock ,
     5548           first goods where gds-obj.gds-code  = goods.gds-code
     5549                               no-lock :
     5550               if not can-find(first temp-gds-list where temp-gds-list.gds-code = gds-obj.gds-code) then do:
     5551                   create temp-gds-list.
     5552                   assign
     5553                     temp-gds-list.prod-code = gds-obj.prod-code
     5554                     temp-gds-list.grp-name  = ""
     5555                     temp-gds-list.gds-code  = gds-obj.gds-code
     5556                     temp-gds-list.artic     = gds-obj.artic
     5557                     temp-gds-list.gds-name  = goods.gds-name
     5558                     .
     5559                     temp-gds-list.grp-name  = n-lavel(input gds-obj.grp-name, input xlavel )
     5560                     .
     5561               end.
     5562           end.
     5563    end.
     5564     for each temp-gds-list no-lock
     5565       , first goods  where goods.gds-code  = temp-gds-list.gds-code no-lock
     5566         break
     5567           by  temp-gds-list.grp-name
     5568           by temp-gds-list.artic :
     5569           str = n-lavel(input goods.grp-name, input xlavel ) no-error .
     5570   find clients where clients.obj-type = goods.prod-type and
     5571                      clients.obj-code = goods.prod-code no-lock .
     5572     assign
     5573         gds-zap-unit-base  = goods.unit-base
     5574         gds-zap-prt-root   = goods.prt-root
     5575         gds-zap-prod-type  = goods.prod-type
     5576         gds-zap-prod-code  = goods.prod-code
     5577         gds-zap-artic      = goods.artic
     5578         gds-zap-type       = goods.gds-type
     5579         gds-zap-grp-name   = goods.grp-name
     5580         gds-zap-b-code     = goods.gds-code
     5581         gds-zap-prod-name  = clients.obj-name .
     5582     if g#gds-engl then
     5583         assign gds-zap-gds-name = goods.engl-name.
     5584     else
     5585         assign gds-zap-gds-name = goods.gds-name.
     5586   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     5587     (input  gds-zap-b-code
     5588     ,input  ?
     5589     ,output v-bar-code
     5590     )  .
     5591     s-bar-code = string (v-bar-code,"999999999").
     5592     run foreach in this-procedure .
     5593       if  first-of ( temp-gds-list.grp-name )  then do:
     5594           fr = true .
     5595           l-stroka = "ГРУППА : " + str .
     5596           temp-str = l-stroka.
     5597       end.
     5598      run display-line in this-procedure .
     5599      if last-of( temp-gds-list.grp-name ) then do:
     5600         s-bar-code = "Итого по " .
     5601         gds-zap-artic = substring(str,1,16) .
     5602         gds-zap-gds-name = substring(str,17,250) .
     5603         run display-b1 in this-procedure .
     5604         run clear-b1 in this-procedure .
     5605         run clear-b2 in this-procedure .
     5606      end.
     5607     end.
     5608      end.
     5609           when 2  then do:
     5610       define buffer buf_obj-list18 for obj-list.
     5611     for each buf_obj-list18 no-lock :
     5612         if xtog-obj and  not (buf_obj-list18.obj-type = x-store-type  and
     5613                               buf_obj-list18.obj-code = x-store-code )
     5614         then next.
     5615           for  each gds-obj   where
     5616                               gds-obj.obj-type = buf_obj-list18.obj-type    and
     5617                               gds-obj.obj-code = buf_obj-list18.obj-code
     5618                               and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     5619                                 no-lock ,
     5620           first  tmp#grp
     5621                 where  gds-obj.grp-name   begins tmp#grp.grp-name
     5622                     no-lock ,
     5623           first goods where gds-obj.gds-code  = goods.gds-code
     5624                               no-lock :
     5625               if not can-find(first temp-gds-list where temp-gds-list.gds-code = gds-obj.gds-code) then do:
     5626                   create temp-gds-list.
     5627                   assign
     5628                     temp-gds-list.prod-code = gds-obj.prod-code
     5629                     temp-gds-list.grp-name  = ""
     5630                     temp-gds-list.gds-code  = gds-obj.gds-code
     5631                     temp-gds-list.artic     = gds-obj.artic
     5632                     temp-gds-list.gds-name  = goods.gds-name
     5633                     .
     5634                     temp-gds-list.grp-name  = n-lavel(input gds-obj.grp-name, input xlavel )
     5635                     .
     5636               end.
     5637           end.
     5638    end.
     5639     for each temp-gds-list no-lock
     5640       , first goods  where goods.gds-code  = temp-gds-list.gds-code no-lock
     5641         break
     5642           by  temp-gds-list.grp-name
     5643           by temp-gds-list.artic :
     5644           str = n-lavel(input goods.grp-name, input xlavel ) no-error .
     5645   find clients where clients.obj-type = goods.prod-type and
     5646                      clients.obj-code = goods.prod-code no-lock .
     5647     assign
     5648         gds-zap-unit-base  = goods.unit-base
     5649         gds-zap-prt-root   = goods.prt-root
     5650         gds-zap-prod-type  = goods.prod-type
     5651         gds-zap-prod-code  = goods.prod-code
     5652         gds-zap-artic      = goods.artic
     5653         gds-zap-type       = goods.gds-type
     5654         gds-zap-grp-name   = goods.grp-name
     5655         gds-zap-b-code     = goods.gds-code
     5656         gds-zap-prod-name  = clients.obj-name .
     5657     if g#gds-engl then
     5658         assign gds-zap-gds-name = goods.engl-name.
     5659     else
     5660         assign gds-zap-gds-name = goods.gds-name.
     5661   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     5662     (input  gds-zap-b-code
     5663     ,input  ?
     5664     ,output v-bar-code
     5665     )  .
     5666     s-bar-code = string (v-bar-code,"999999999").
     5667     run foreach in this-procedure .
     5668       if  first-of ( temp-gds-list.grp-name )  then do:
     5669           fr = true .
     5670           l-stroka = "ГРУППА : " + str .
     5671           temp-str = l-stroka.
     5672       end.
     5673      run display-line in this-procedure .
     5674      if last-of( temp-gds-list.grp-name ) then do:
     5675         s-bar-code = "Итого по " .
     5676         gds-zap-artic = substring(str,1,16) .
     5677         gds-zap-gds-name = substring(str,17,250) .
     5678         run display-b1 in this-procedure .
     5679         run clear-b1 in this-procedure .
     5680         run clear-b2 in this-procedure .
     5681      end.
     5682     end.
     5683      end.
     5684           when 3 then do:
     5685       define buffer buf_obj-list19 for obj-list.
     5686     for each buf_obj-list19 no-lock :
     5687         if xtog-obj and  not (buf_obj-list19.obj-type = x-store-type  and
     5688                               buf_obj-list19.obj-code = x-store-code )
     5689         then next.
     5690           for  each gds-obj   where
     5691                     gds-obj.obj-type = buf_obj-list19.obj-type    and
     5692                     gds-obj.obj-code = buf_obj-list19.obj-code
     5693                     and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     5694                       no-lock ,
     5695           first g#cli
     5696                 where    g#cli.obj-code = gds-obj.prod-code
     5697                 and      g#cli.obj-type = gds-obj.prod-type
     5698                          no-lock ,
     5699           first goods where goods.gds-code = gds-obj.gds-code
     5700                               no-lock :
     5701               if not can-find ( first temp-gds-list where temp-gds-list.gds-code = gds-obj.gds-code) then do:
     5702                   create temp-gds-list.
     5703                   assign
     5704                     temp-gds-list.prod-code = gds-obj.prod-code
     5705                     temp-gds-list.grp-name  = ""
     5706                     temp-gds-list.gds-code  = gds-obj.gds-code
     5707                     temp-gds-list.artic     = gds-obj.artic
     5708                     temp-gds-list.gds-name  = goods.gds-name
     5709                     .
     5710                     temp-gds-list.grp-name  = n-lavel(input gds-obj.grp-name, input xlavel )
     5711                     .
     5712               end.
     5713           end.
     5714    end.
     5715     for each temp-gds-list no-lock
     5716       , first goods     where goods.gds-code     = temp-gds-list.gds-code no-lock
     5717         break
     5718           by  temp-gds-list.grp-name
     5719           by temp-gds-list.artic :
     5720           str = n-lavel(input goods.grp-name, input xlavel ) no-error .
     5721   find clients where clients.obj-type = goods.prod-type and
     5722                      clients.obj-code = goods.prod-code no-lock .
     5723     assign
     5724         gds-zap-unit-base  = goods.unit-base
     5725         gds-zap-prt-root   = goods.prt-root
     5726         gds-zap-prod-type  = goods.prod-type
     5727         gds-zap-prod-code  = goods.prod-code
     5728         gds-zap-artic      = goods.artic
     5729         gds-zap-type       = goods.gds-type
     5730         gds-zap-grp-name   = goods.grp-name
     5731         gds-zap-b-code     = goods.gds-code
     5732         gds-zap-prod-name  = clients.obj-name .
     5733     if g#gds-engl then
     5734         assign gds-zap-gds-name = goods.engl-name.
     5735     else
     5736         assign gds-zap-gds-name = goods.gds-name.
     5737   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     5738     (input  gds-zap-b-code
     5739     ,input  ?
     5740     ,output v-bar-code
     5741     )  .
     5742     s-bar-code = string (v-bar-code,"999999999").
     5743     run foreach in this-procedure .
     5744       if  first-of ( temp-gds-list.grp-name )  then do:
     5745           fr = true .
     5746           l-stroka = "ГРУППА : " + str .
     5747           temp-str = l-stroka.
     5748       end.
     5749      run display-line in this-procedure .
     5750      if last-of( temp-gds-list.grp-name ) then do:
     5751         s-bar-code = "Итого по " .
     5752         gds-zap-artic = substring(str,1,16) .
     5753         gds-zap-gds-name = substring(str,17,250) .
     5754         run display-b1 in this-procedure .
     5755         run clear-b1 in this-procedure .
     5756         run clear-b2 in this-procedure .
     5757      end.
     5758     end.
     5759      end.
     5760           otherwise do:
     5761       define buffer buf_obj-list20 for obj-list.
     5762     for each buf_obj-list20 no-lock :
     5763         if xtog-obj and  not (buf_obj-list20.obj-type = x-store-type  and
     5764                               buf_obj-list20.obj-code = x-store-code )
     5765         then next.
     5766           for  each gds-obj   where
     5767                               gds-obj.obj-type = buf_obj-list20.obj-type    and
     5768                               gds-obj.obj-code = buf_obj-list20.obj-code
     5769                               and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     5770                               no-lock ,
     5771           first gds-list where gds-obj.gds-code  = gds-list.gds-code
     5772                               no-lock :
     5773               if not can-find(first temp-gds-list where temp-gds-list.gds-code = gds-obj.gds-code) then do:
     5774                   create temp-gds-list.
     5775                   assign
     5776                     temp-gds-list.prod-code = gds-obj.prod-code
     5777                     temp-gds-list.grp-name  = ""
     5778                     temp-gds-list.gds-code  = gds-obj.gds-code
     5779                     temp-gds-list.artic     = gds-obj.artic
     5780                     temp-gds-list.gds-name  = gds-list.gds-name
     5781                     .
     5782                     temp-gds-list.grp-name  = n-lavel(input gds-obj.grp-name, input xlavel )
     5783                     .
     5784               end.
     5785           end.
     5786    end.
     5787     for each temp-gds-list no-lock
     5788       , first gds-list  where gds-list.gds-code  = temp-gds-list.gds-code no-lock
     5789         break
     5790           by  temp-gds-list.grp-name
     5791           by gds-list.artic :
     5792           str = n-lavel(input gds-list.grp-name, input xlavel ) no-error .
     5793   find clients where clients.obj-type = gds-list.prod-type and
     5794                      clients.obj-code = gds-list.prod-code no-lock .
     5795     assign
     5796         gds-zap-unit-base  = gds-list.unit-base
     5797         gds-zap-prt-root   = gds-list.prt-root
     5798         gds-zap-prod-type  = gds-list.prod-type
     5799         gds-zap-prod-code  = gds-list.prod-code
     5800         gds-zap-artic      = gds-list.artic
     5801         gds-zap-type       = gds-list.gds-type
     5802         gds-zap-grp-name   = gds-list.grp-name
     5803         gds-zap-b-code     = gds-list.gds-code
     5804         gds-zap-prod-name  = clients.obj-name .
     5805     if g#gds-engl then
     5806         assign gds-zap-gds-name = gds-list.engl-name.
     5807     else
     5808         assign gds-zap-gds-name = gds-list.gds-name.
     5809   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     5810     (input  gds-zap-b-code
     5811     ,input  ?
     5812     ,output v-bar-code
     5813     )  .
     5814     s-bar-code = string (v-bar-code,"999999999").
     5815     run foreach in this-procedure .
     5816       if  first-of ( temp-gds-list.grp-name )  then do:
     5817           fr = true .
     5818           l-stroka = "ГРУППА : " + str .
     5819           temp-str = l-stroka.
     5820       end.
     5821      run display-line in this-procedure .
     5822      if last-of( temp-gds-list.grp-name ) then do:
     5823         s-bar-code = "Итого по " .
     5824         gds-zap-artic = substring(str,1,16) .
     5825         gds-zap-gds-name = substring(str,17,250) .
     5826         run display-b1 in this-procedure .
     5827         run clear-b1 in this-procedure .
     5828         run clear-b2 in this-procedure .
     5829      end.
     5830     end.
     5831           end.
     5832       end case.
     5833   end procedure.
     5834   PROCEDURE ob-line-stk  :
     5835   define input  parameter x-store-code     like ub.clients.obj-code      no-undo.
     5836   define input  parameter x-store-type     like ub.clients.obj-type      no-undo.
     5837   define INPUT  parameter x-artic          like ub.stk-line.artic        no-undo.
     5838   define INPUT  parameter x-prod-code      like ub.stk-line.prod-code    no-undo.
     5839   define INPUT  parameter x-prod-type      like ub.stk-line.prod-type    no-undo.
     5840   define INPUT  parameter x-Fact-order-1   like ub.stk-line.Fact-order   no-undo.
     5841   define INPUT  parameter x-Fact-order-2   like ub.stk-line.Fact-order   no-undo.
     5842   define input  parameter x-sum-type       like ub.stk-line.sum-type     no-undo.
     5843   define input  parameter x-cat-id         like ub.stk-line.cat-id       no-undo.
     5844   define input  parameter x-ext-doc-type   like ub.ot-line.ext-doc-type  no-undo.
     5845   define input  parameter xTog-obj         as log                     no-undo.
     5846   define input  parameter xi               as int                     no-undo.
     5847   define output  parameter Quntity         like ub.stk-line.fact-qnty   no-undo.
     5848   define output  parameter sum             like ub.stk-line.sum-base    no-undo.
     5849   define output  parameter vat             like ub.stk-line.sum-base    no-undo.
     5850   define output  parameter slt             like ub.stk-line.sum-base    no-undo.
     5851   define output  parameter disc            like ub.stk-line.sum-base    no-undo.
     5852   define variable  First-qnty   like ub.stk-line.fact-qnty   no-undo.
     5853   define variable  Second-qnty  like ub.stk-line.fact-qnty   no-undo.
     5854   define variable  First-sum   like ub.stk-line.sum-base   no-undo.
     5855   define variable  Second-sum  like ub.stk-line.sum-base   no-undo.
     5856   define variable  First-vat   like ub.stk-line.sum-base   no-undo.
     5857   define variable  Second-vat  like ub.stk-line.sum-base   no-undo.
     5858   define variable  First-slt   like ub.stk-line.sum-base   no-undo.
     5859   define variable  Second-slt  like ub.stk-line.sum-base   no-undo.
     5860   define variable  First-disc   like ub.stk-line.sum-base   no-undo.
     5861   define variable  Second-disc  like ub.stk-line.sum-base   no-undo.
     5862   define buffer stk-line2 for ub.stk-line .
     5863   if x-Fact-order-2 < x-Fact-order-1 Then x-Fact-order-2 = x-Fact-order-1.
     5864    Assign
     5865      First-qnty  = 0
     5866      Second-qnty = 0
     5867      Quntity     = 0
     5868      First-sum  = 0
     5869      Second-sum = 0
     5870      sum        = 0
     5871      First-vat  = 0
     5872      Second-vat = 0
     5873      vat        = 0
     5874      First-slt   = 0
     5875      Second-slt  = 0
     5876      slt         = 0
     5877      First-disc  = 0
     5878      Second-disc = 0
     5879      disc        = 0
     5880     .
     5881     For each obj-list  no-lock :
     5882      if  xTog-obj THEN
     5883          if   NOT(    x-store-type     = obj-list.obj-type
     5884               AND    x-store-code      = obj-list.obj-code ) Then NEXT.
     5885      FOR each temp#sum-type where temp#sum-type.xi = xi no-lock :
     5886         find last ub.stk-line no-lock
     5887           where ub.stk-line.obj-type   = obj-list.obj-type
     5888             and ub.stk-line.obj-code   = obj-list.obj-code
     5889             and ub.stk-line.artic      = x-artic
     5890             and ub.stk-line.prod-type  = x-prod-type
     5891             and ub.stk-line.prod-code  = x-prod-code
     5892             and ub.stk-line.sum-type   = temp#sum-type.sum-type
     5893             and ub.stk-line.cat-id     = '##,##':U
     5894             and ub.stk-line.fact-order <= x-fact-order-1
     5895           use-index category
     5896           no-error .
     5897         if available ub.stk-line then do:
     5898           assign
     5899             First-qnty = First-qnty + ub.stk-line.fact-qnty
     5900             First-sum  = First-sum  + (if tprintrubl then ub.stk-line.sum-rubl   else ub.stk-line.sum-base  )
     5901             First-vat  = First-vat  + (if tprintrubl then ub.stk-line.vat-rubl   else ub.stk-line.vat-base  )
     5902             First-disc = First-disc + (if tprintrubl then ub.stk-line.other-rubl else ub.stk-line.other-base )
     5903             First-slt  = First-slt  + (if tprintrubl then ub.stk-line.slt-rubl   else ub.stk-line.slt-base   )
     5904           .
     5905         end.
     5906         find last stk-line2 no-lock
     5907           where stk-line2.obj-code   = obj-list.obj-code
     5908             and stk-line2.obj-type   = obj-list.obj-type
     5909             and stk-line2.artic      = x-artic
     5910             and stk-line2.prod-type  = x-prod-type
     5911             and stk-line2.prod-code  = x-prod-code
     5912             and stk-line2.sum-type   = temp#sum-type.sum-type
     5913             and stk-line2.cat-id     = '##,##':U
     5914             and stk-line2.fact-order <= x-fact-order-2
     5915           use-index category
     5916           no-error .
     5917         if available stk-line2 then do:
     5918           assign
     5919             Second-qnty = Second-qnty + Stk-line2.fact-qnty
     5920             Second-sum  = Second-sum  + (if tprintrubl then stk-line2.sum-rubl else stk-line2.sum-base    )
     5921             Second-vat  = Second-vat  + (if tprintrubl then stk-line2.vat-rubl else stk-line2.vat-base    )
     5922             second-disc = second-disc + (if tprintrubl then stk-line2.other-rubl else stk-line2.other-base )
     5923             second-slt  = second-slt  + (if tprintrubl then stk-line2.slt-rubl   else stk-line2.slt-base   )
     5924           .
     5925         end.
     5926      end.
     5927    end.
     5928    Assign
     5929      Quntity = Second-qnty - first-qnty
     5930      sum     = Second-sum  - first-sum
     5931      vat     = Second-vat  - first-vat
     5932      slt     = Second-slt  - first-slt
     5933      disc    = Second-disc  - first-disc
     5934      .
     5935   END PROCEDURE.
     5936   procedure create-pul:
     5937   end procedure.
     5938   procedure calc-ms-wt :
     5939   define input        parameter p-oborot-num      as decimal   no-undo .
     5940   define input        parameter p-gds-wt-ms-base  as decimal   no-undo .
     5941   define input-output parameter p-oborot          as decimal   no-undo .
     5942   define input-output parameter p-bi-oborot       as decimal   no-undo .
     5943   define input-output parameter p-bo-oborot       as decimal   no-undo .
     5944   define input-output parameter p-b1-oborot       as decimal   no-undo .
     5945   define input-output parameter p-b2-oborot       as decimal   no-undo .
     5946   do
     5947   on error undo, return error return-value
     5948   :
     5949   if p-is-petrol = true then return .
     5950     assign
     5951       p-oborot    = p-oborot-num * p-gds-wt-ms-base
     5952       p-bi-oborot = p-bi-oborot + p-oborot
     5953       p-bo-oborot = p-bo-oborot + p-oborot
     5954       p-b1-oborot = p-b1-oborot + p-oborot
     5955       p-b2-oborot = p-b2-oborot + p-oborot
     5956     .
     5957   end.
     5958   end procedure.
     5959   procedure calc-pt-ob :
     5960   define input  parameter p-ext-doc-type  as character no-undo .
     5961   define input  parameter x-store-type as character no-undo .
     5962   define input  parameter x-store-code as integer   no-undo .
     5963   define input  parameter p-artic         as character no-undo .
     5964   define input  parameter p-prod-type     as character no-undo .
     5965   define input  parameter p-prod-code     as integer   no-undo .
     5966   define input-output parameter p-oborot          as decimal   no-undo .
     5967   define input-output parameter p-bi-oborot       as decimal   no-undo .
     5968   define input-output parameter p-bo-oborot       as decimal   no-undo .
     5969   define input-output parameter p-b1-oborot       as decimal   no-undo .
     5970   define input-output parameter p-b2-oborot       as decimal   no-undo .
     5971     do
     5972     on error undo, return error return-value
     5973     :
     5974   define variable v-oborot as decimal   no-undo .
     5975   define buffer buf_inv-line for ub.inv-line  .
     5976   define buffer buf_doc-line for ub.doc-line  .
     5977   define buffer buf1_obj-list for obj-list .
     5978   v-oborot = 0 .
     5979   if p-is-petrol = false   then return .
     5980     for each buf1_obj-list no-lock :
     5981      if  xtog-obj then
     5982          if   not(x-store-type     = buf1_obj-list.obj-type
     5983               and x-store-code     = buf1_obj-list.obj-code ) then next.
     5984       for each buf_doc-line  no-lock where
     5985             buf_doc-line.obj-type     = buf1_obj-list.obj-type and
     5986             buf_doc-line.obj-code     = buf1_obj-list.obj-code and
     5987             buf_doc-line.artic        = p-artic and
     5988             buf_doc-line.prod-type    = p-prod-type and
     5989             buf_doc-line.prod-code    = p-prod-code and
     5990             buf_doc-line.ext-doc-type = p-ext-doc-type and
     5991             buf_doc-line.status_      = 'факт':U        and
     5992             buf_doc-line.fact-order   <= fact-order-2  and
     5993             buf_doc-line.fact-order   >= fact-order-1
     5994             :
     5995             for each buf_inv-line no-lock where
     5996                     buf_inv-line.doc-code  =  buf_doc-line.doc-code  and
     5997                     buf_inv-line.artic     =  buf_doc-line.artic     and
     5998                     buf_inv-line.prod-type =  buf_doc-line.prod-type and
     5999                     buf_inv-line.prod-code =  buf_doc-line.prod-code
     6000                     :
     6001                     if p-ext-doc-type = 'vt':U  then v-oborot = v-oborot + buf_doc-line.cli-qnty .
     6002                         else do:
     6003                         if p-ext-doc-type = 'we':U    or
     6004                            p-ext-doc-type = 'ee':U    or
     6005                            p-ext-doc-type = 'ev':U    or
     6006                            p-ext-doc-type = 'ep':U or
     6007                            p-ext-doc-type = 'em':U     or
     6008                            p-ext-doc-type = 'wm':U     or
     6009                            p-ext-doc-type = 'es':U   then
     6010                              v-oborot = v-oborot - buf_inv-line.wast-cli-qnty .
     6011                              else v-oborot = v-oborot + buf_inv-line.wast-cli-qnty .
     6012                         end.
     6013             end.
     6014       end.
     6015       assign
     6016         p-oborot    = v-oborot
     6017         p-bi-oborot = p-bi-oborot + p-oborot
     6018         p-bo-oborot = p-bo-oborot + p-oborot
     6019         p-b1-oborot = p-b1-oborot + p-oborot
     6020         p-b2-oborot = p-b2-oborot + p-oborot
     6021       .
     6022   end.
     6023   end.
     6024   end procedure.
