     3914     if use-column[7]  then C-oborot-ie:screen-value          = string( B2-oborot-ie [4]        )  .
     3915     if use-column[8]  then C-oborot-iv:screen-value          = string( B2-oborot-iv [4]        )  .
     3916     if use-column[9]  then C-oborot-im:screen-value           = string( B2-oborot-im  [4]        )  .
     3917     if use-column[10] then C-oborot-ee:screen-value          = string( B2-oborot-ee [4]        )  .
     3918     if use-column[11] then C-oborot-ev:screen-value          = string( B2-oborot-ev [4]        )  .
     3919     if use-column[12] then C-oborot-em:screen-value           = string( B2-oborot-em  [4]        )  .
     3920     if use-column[13] then C-oborot-we:screen-value          = string( B2-oborot-we         [4])  .
     3921     if use-column[14] then C-oborot-es:screen-value     = string( B2-oborot-es    [4])  .
     3922     if use-column[15] then C-oborot-rs:screen-value = string( B2-oborot-rs[4])  .
     3923     if use-column[16] then C-oborot-re:screen-value      = string( B2-oborot-re     [4])  .
     3924     if use-column[17] then C-oborot-ep:screen-value       = string( B2-oborot-ep      [4])  .
     3925     if use-column[18] then C-oborot-rv:screen-value      = string( B2-oborot-rv     [4])  .
     3926     if use-column[19] then C-oborot-vt:screen-value                = string( B2-oborot-vt               [4])  .
     3927     if use-column[20] then C-oborot-ot:screen-value           = string( B2-oborot-ot          [4])  .
     3928     if use-column[22] then C-ostatok-end:screen-value                            = string( B2-ostatok-end                           [4])  .
     3929     if use-column[25] then C-oborot-ap:screen-value     = string( B2-oborot-ap    [4])  .
     3930     if use-column[26] then C-oborot-pc:screen-value     = string( B2-oborot-pc    [4])  .
     3931     if use-column[27] then C-oborot-r-v:screen-value                      = string( B2-oborot-ee         [4] +
     3932                                                                                            B2-oborot-re     [4] +
     3933                                                                                            B2-oborot-es    [4] +
     3934                                                                                            B2-oborot-rs[4] ).
     3935     DISPLAY stream  OutStream  with FRAME ZAPAS .  DOWN stream   OutStream 1 with FRAME ZAPAS.
     3936     End.
     3937     if NOT xSumsOnly THEN Run u-line  in this-procedure .
     3938   end.
     3939   end.
     3940   END PROCEDURE.
