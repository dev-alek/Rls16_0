     4531   procedure PrintTitul :
     4532     define variable ss1 as character no-undo .
     4533     PUT stream OutStream SPACE(30) ReportNAme format "X(100)" SKIP .
     4534     assign  ss1 = 'X(' + string(length (ReportHeader)) + ')' .
     4535     PUT stream OutStream ReportHeader format ss1 SKIP.
     4536     assign
     4537       str4 = "Выбранные объекты: " + str4
     4538       ss1 = 'X(' + string(length (str4)) + ')'
     4539     .
     4540     PUT stream OutStream str4 format ss1 SKIP.
     4541     if RADIO-AltObj > 2 then do:
     4542       assign ss1 = 'X(' + string(length (str3)) + ')' .
     4543       PUT stream OutStream str3 format ss1 SKIP.
     4544     end.
     4545     define variable frm-qnty as character no-undo .
     4546     if sz-qnty = 3 then assign frm-qnty = "->>>>>>>>9.999" .
     4547     else                       frm-qnty = "->>>>>>>>>>>>9" .
     4548     assign
     4549       ii  = 1
     4550       beg = 1
     4551     .
     4552     if use-column[1] = yes then do:
     4553       create line-frm .
     4554       assign
     4555         line-frm.num    = ii
     4556         line-frm.beg    = beg
     4557         line-frm.titul  = " Код"
     4558         line-frm.titul1 = ""
     4559         line-frm.titul2 = ""
     4560         line-frm.frm    = ">>>>>>>>>>>>9"
     4561         line-frm.frmt   = "X(6)"
     4562         ii  = ii + 1
     4563         beg = beg + 14
     4564       .
     4565     end.
