     1841   end.
     1842   if v-cntxt-level = 'firm':U then do:
     1843     find first ub.clients no-lock where
     1844                ub.clients.obj-type = 'орг':U and
     1845                ub.clients.obj-code = v-cntxt-host-code-obj no-error .
     1846   if error-status :error then v-cntxt-host-name-obj = ? .
     1847      else v-cntxt-host-name-obj = ub.clients.obj-name.
     1848   end.
     1849   if v-cntxt-level = 'object':U
     1850   or v-cntxt-level = 'firm':U
     1851   then do:
     1852   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
