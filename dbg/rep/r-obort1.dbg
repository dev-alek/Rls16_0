     4048     end.
     4049    end.
     4050   end procedure.
     4051   procedure PutColumnTitulExcel :
     4052     do
     4053     on error undo, return error return-value
     4054     :
     4055     assign
     4056       v-col = 1
     4057       v-row = 1
     4058       line1 = ReportNAme
     4059     .
     4060     run macr_excel_char (line1, v-row, 4) .
     4061     run macr_cell_format ( 11, yes, no, ?, v-row, 4, v-row, 4) .
     4062     assign v-row = v-row + 1 .
     4063     if length (str4 ) > 210 then assign str4 = substring (str4, 1, 210) + " ..." .
     4064     run macr_excel_char (str4, v-row, v-col) .
     4065     assign v-row = v-row + 1 .
     4066   def var t-class as char no-undo.
     4067   def var t-sort as char no-undo.
     4068     case classify:
     4069       when "no-classify":u    then t-class =   "Без классификации" .
     4070       when "prod":u           then t-class =   "Производители"   .
     4071       when "post":u           then t-class =   "Поставщики"   .
     4072       when "grp-goods":u      then t-class =   "Группы товаров"  .
     4073       when "post/grp-goods":u then t-class =   "Поставщики/Группы товаров" .
     4074       when "prod/grp-goods":u then t-class =   "Производители/Группы товаров" .
     4075       when "grp-goods/prod":u then t-class =   "Группы товаров/Производители" .
     4076       when "grp-goods/post":u then t-class =   "Группы товаров/Поставщики" .
     4077       when  "vat-ps":u        then t-class =   "Ставка НДС" .
