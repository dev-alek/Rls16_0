     1760   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1761   procedure proc-alt-shift-f2:
     1762     if not ibs.th.gbl.gbl-var:rcode
     1763   then
     1764     run gbl\inidebug.p .
     1765   end.
     1766   procedure proc-alt-shift-f3:
     1767     run gbl/prvssinf.p
     1768       ( input this-procedure
     1769       ) .
     1770   end.
     1771   define variable v-inform-launched as logical no-undo initial false .
     1772   procedure proc-alt-shift-f4:
     1773     define variable v-action as character no-undo .
     1774     if v-inform-launched = false then do:
     1775       assign
     1776         v-inform-launched = true
     1777       .
     1778       run gbl/d-inform.w
     1779         (  input self
     1780         ,  input this-procedure
     1781         , output v-action
     1782         ) no-error .
     1783       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
     1784       assign
     1785         v-inform-launched = false
     1786       .
     1787     end.
     1788   end.
     1789   procedure proc-alt-f1:
     1790     run gbl/corrhelp.p
     1791       (input this-procedure
     1792       ) .
     1793   end .
     1794   on alt-shift-f2 anywhere do:
     1795     run proc-alt-shift-f2.
     1796   end.
     1797   on alt-shift-f3 anywhere do:
     1798     run proc-alt-shift-f3 in this-procedure .
     1799   end.
     1800   on alt-shift-f4 anywhere do:
     1801     run proc-alt-shift-f4 in this-procedure.
     1802   end.
     1803   on alt-f1 anywhere do:
     1804     run proc-alt-f1 in this-procedure .
     1805   end.
     1806   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
