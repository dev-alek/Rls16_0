     7202     buf_gds-sum.Spi-CostSum           = buf_gds-sum.Spi-CostSum            +  gds-prop.Spi-CostSum
     7203     buf_gds-sum.Spi-SaleSum           = buf_gds-sum.Spi-SaleSum            +  gds-prop.Spi-SaleSum
     7204     buf_gds-sum.InProiz-Qnty          = buf_gds-sum.InProiz-Qnty           +  gds-prop.InProiz-Qnty
     7205     buf_gds-sum.InProiz-CostSum       = buf_gds-sum.InProiz-CostSum        +  gds-prop.InProiz-CostSum
     7206     buf_gds-sum.InProiz-SaleSum       = buf_gds-sum.InProiz-SaleSum        +  gds-prop.InProiz-SaleSum
     7207     buf_gds-sum.OutProiz-Qnty         = buf_gds-sum.OutProiz-Qnty          +  gds-prop.OutProiz-Qnty
     7208     buf_gds-sum.OutProiz-CostSum      = buf_gds-sum.OutProiz-CostSum       +  gds-prop.OutProiz-CostSum
     7209     buf_gds-sum.OutProiz-SaleSum      = buf_gds-sum.OutProiz-SaleSum       +  gds-prop.OutProiz-SaleSum
     7210     buf_gds-sum.Per-SaleSum           = buf_gds-sum.Per-SaleSum            +  gds-prop.Per-SaleSum
     7211     buf_gds-sum.Alt-RestEnd-Qnty      = buf_gds-sum.Alt-RestEnd-Qnty       +  gds-prop.Alt-RestEnd-Qnty
     7212     buf_gds-sum.Effect-Value          = buf_gds-sum.Effect-Value           +  gds-prop.Effect-Value
     7213     buf_gds-sum.Free-Qnty             = buf_gds-sum.Free-Qnty              +  gds-prop.Free-Qnty
     7214     buf_gds-sum.Free-CostSum          = buf_gds-sum.Free-CostSum           +  gds-prop.Free-CostSum
     7215     buf_gds-sum.Free-SaleSum          = buf_gds-sum.Free-SaleSum           +  gds-prop.Free-SaleSum
     7216     buf_gds-sum.Res-Qnty              = buf_gds-sum.Res-Qnty               +  gds-prop.Res-Qnty
     7217     buf_gds-sum.Res-CostSum           = buf_gds-sum.Res-CostSum            +  gds-prop.Res-CostSum
     7218     buf_gds-sum.Res-DocSum            = buf_gds-sum.Res-DocSum             +  gds-prop.Res-DocSum
     7219     buf_gds-sum.Res-SaleSum           = buf_gds-sum.Res-SaleSum            +  gds-prop.Res-SaleSum
     7220     buf_gds-sum.Res-DiscntSum         = buf_gds-sum.Res-DiscntSum          +  gds-prop.Res-DiscntSum
     7221   .
     7222   end procedure.
     7223   procedure Create-gds-sum :
     7224     define input  parameter p-num as integer   no-undo .
     7225     define buffer buf_gds-sum for gds-sum .
     7226     find first buf_gds-sum where buf_gds-sum.num = p-num no-error .
     7227     if not available buf_gds-sum then do:
     7228       create buf_gds-sum .
     7229       assign
     7230         buf_gds-sum.num = p-num
     7231       .
     7232     end.
     7233   define variable vss-include-info32 as character format "X(65)" no-undo
     7234   initial "@(#)$Workfile$".
     7235   assign
     7236     buf_gds-sum.StartWay-Qnty         = 0
     7237     buf_gds-sum.StartWay-CostSum      = 0
     7238     buf_gds-sum.StartWay-SaleSum      = 0
     7239     buf_gds-sum.EndWay-Qnty           = 0
     7240     buf_gds-sum.EndWay-CostSum        = 0
     7241     buf_gds-sum.EndWay-SaleSum        = 0
     7242     buf_gds-sum.Free-Qnty             = 0
     7243     buf_gds-sum.Free-CostSum          = 0
     7244     buf_gds-sum.Free-SaleSum          = 0
     7245     buf_gds-sum.Res-Qnty              = 0
     7246     buf_gds-sum.Res-CostSum           = 0
     7247     buf_gds-sum.Res-SaleSum           = 0
     7248     buf_gds-sum.Res-DiscntSum         = 0
     7249     buf_gds-sum.InExt-Qnty            = 0
     7250     buf_gds-sum.InExt-CostSum         = 0
     7251     buf_gds-sum.RetPost-Qnty          = 0
     7252     buf_gds-sum.RetPost-CostSum       = 0
     7253     buf_gds-sum.OutExt-Qnty           = 0
     7254     buf_gds-sum.OutExt-CostSum        = 0
     7255     buf_gds-sum.OutExt-SaleSum        = 0
     7256     buf_gds-sum.OutExt-DiscntSum      = 0
     7257     buf_gds-sum.RetOut-Qnty           = 0
     7258     buf_gds-sum.RetOut-CostSum        = 0
     7259     buf_gds-sum.RetOut-SaleSum        = 0
     7260     buf_gds-sum.RetOut-DiscntSum      = 0
     7261     buf_gds-sum.OutExtKass-Qnty       = 0
     7262     buf_gds-sum.OutExtKass-CostSum    = 0
     7263     buf_gds-sum.OutExtKass-SaleSum    = 0
     7264     buf_gds-sum.OutExtKass-DiscntSum  = 0
     7265     buf_gds-sum.RetOutKass-Qnty       = 0
     7266     buf_gds-sum.RetOutKass-CostSum    = 0
     7267     buf_gds-sum.RetOutKass-SaleSum    = 0
     7268     buf_gds-sum.RetOutKass-DiscntSum  = 0
     7269     buf_gds-sum.InInt-Qnty            = 0
     7270     buf_gds-sum.InInt-CostSum         = 0
     7271     buf_gds-sum.InInt-SaleSum         = 0
     7272     buf_gds-sum.OutInt-Qnty           = 0
     7273     buf_gds-sum.OutInt-CostSum        = 0
     7274     buf_gds-sum.OutInt-SaleSum        = 0
     7275     buf_gds-sum.RetInt-Qnty           = 0
     7276     buf_gds-sum.RetInt-CostSum        = 0
     7277     buf_gds-sum.RetInt-SaleSum        = 0
     7278     buf_gds-sum.Inv-Qnty              = 0
     7279     buf_gds-sum.Inv-CostSum           = 0
     7280     buf_gds-sum.Inv-SaleSum           = 0
     7281     buf_gds-sum.Spi-Qnty              = 0
     7282     buf_gds-sum.Spi-CostSum           = 0
     7283     buf_gds-sum.Spi-SaleSum           = 0
     7284     buf_gds-sum.InProiz-Qnty          = 0
     7285     buf_gds-sum.InProiz-CostSum       = 0
     7286     buf_gds-sum.InProiz-SaleSum       = 0
     7287     buf_gds-sum.OutProiz-Qnty         = 0
     7288     buf_gds-sum.OutProiz-CostSum      = 0
     7289     buf_gds-sum.OutProiz-SaleSum      = 0
     7290     buf_gds-sum.Per-SaleSum           = 0
     7291     buf_gds-sum.Effect-Value          = 0
     7292     buf_gds-sum.Alt-RestEnd-Qnty      = 0
     7293   .
     7294   end procedure.
     7295   procedure PrintLine :
     7296     if SumsOnly = no then do:
     7297         if sys-key = "parts" then do:
     7298            run macr_cell_format ( 10 , yes, no, ?, v-row, 1, v-row, 100) .
     7299         end.
     7300         assign v-col = 1 .
     7301         if use-column[1]  = yes then do: run macr_excel_char ( string (gds-prop.b-code), v-row, v-col) . assign v-col = v-col + 1 . end.
     7302         if use-column[2]  = yes then do: run macr_excel_char ( gds-prop.artic     , v-row, v-col) . assign v-col = v-col + 1 . end.
     7303         if use-column[3]  = yes then do: run macr_excel_char ( gds-prop.gds-name  , v-row, v-col) . assign v-col = v-col + 1 . end.
     7304         if use-column[4]  = yes then do: run macr_excel_char ( gds-prop.unit-base , v-row, v-col) . assign v-col = v-col + 1 . end.
     7305         if use-column[5]  = yes then do: run macr_excel_sum  ( gds-prop.Cost-Price, v-row, v-col, 2) . assign v-col = v-col + 1 . end.
     7306         if use-column[6]  = yes then do:
     7307           if prod-zen = yes then do:
     7308             run macr_excel_sum  ( gds-prop.Avrg-Sale-Price, v-row, v-col, 2) .
     7309           end.
     7310           else do:
     7311             run macr_excel_sum  ( gds-prop.Last-Sale-Price, v-row, v-col, 2) .
     7312           end.
     7313           assign v-col = v-col + 1 .
     7314         end.
     7315         if use-column[7]  = yes then do: run macr_excel_sum  ( gds-prop.Up-Plan, v-row, v-col, 2) . assign v-col = v-col + 1 . end.
     7316         if use-column[8]  = yes then do:
     7317           if gds-prop.LastPer-Date <> ? then do: run macr_excel_char (string(gds-prop.LastPer-Date,"99.99.9999"), v-row, v-col) .  end.
     7318           assign v-col = v-col + 1 .
     7319         end.
     7320         if use-column[9]  = yes then do: run macr_excel_char (gds-prop.LastPer-Num, v-row, v-col) . assign v-col = v-col + 1 . end.
     7321         if use-column[12] = yes then  do: run macr_excel_sum ( gds-prop.StartWay-Qnty, v-row, v-col, sz-qnty) . assign v-col = v-col + 1 . end.
     7322         if use-column[31] = yes then  do: run macr_excel_sum ( gds-prop.StartWay-CostSum, v-row, v-col, 2) . assign v-col = v-col + 1 . end.
     7323         if use-column[50] = yes then  do: run macr_excel_sum ( gds-prop.StartWay-SaleSum, v-row, v-col, 2) . assign v-col = v-col + 1 . end.
     7324         if use-column[14] = yes then  do: run macr_excel_sum ( gds-prop.InExt-Qnty, v-row, v-col, sz-qnty) . assign v-col = v-col + 1 . end.
     7325         if use-column[33] = yes then  do: run macr_excel_sum ( gds-prop.InExt-CostSum, v-row, v-col, 2) . assign v-col = v-col + 1 . end.
     7326         if use-column[15] = yes then  do: run macr_excel_sum ( gds-prop.RetPost-Qnty, v-row, v-col, sz-qnty) . assign v-col = v-col + 1 . end.
     7327         if use-column[34] = yes then  do: run macr_excel_sum ( gds-prop.RetPost-CostSum, v-row, v-col, 2) . assign v-col = v-col + 1 . end.
     7328         if use-column[16] = yes then  do: run macr_excel_sum ( gds-prop.OutExt-Qnty, v-row, v-col, sz-qnty) . assign v-col = v-col + 1 . end.
     7329         if use-column[35] = yes then  do: run macr_excel_sum ( gds-prop.OutExt-CostSum, v-row, v-col, 2) . assign v-col = v-col + 1 . end.
     7330         if use-column[52] = yes then  do: run macr_excel_sum ( gds-prop.OutExt-SaleSum, v-row, v-col, 2) . assign v-col = v-col + 1 . end.
     7331         if use-column[68] = yes then  do: run macr_excel_sum ( gds-prop.OutExt-DiscntSum, v-row, v-col, 2) . assign v-col = v-col + 1 . end.
     7332         if use-column[77] = yes then  do: run macr_excel_sum ( gds-prop.OutExt-DiscntSum * 100 / gds-prop.OutExt-SaleSum, v-row, v-col, 2) . assign v-col = v-col + 1 . end.
     7333         if use-column[17] = yes then  do: run macr_excel_sum ( gds-prop.RetOut-Qnty, v-row, v-col, sz-qnty) . assign v-col = v-col + 1 . end.
     7334         if use-column[36] = yes then  do: run macr_excel_sum ( gds-prop.RetOut-CostSum, v-row, v-col, 2) . assign v-col = v-col + 1 . end.
     7335         if use-column[53] = yes then  do: run macr_excel_sum ( gds-prop.RetOut-SaleSum, v-row, v-col, 2) . assign v-col = v-col + 1 . end.
     7336         if use-column[69] = yes then  do: run macr_excel_sum ( gds-prop.RetOut-DiscntSum, v-row, v-col, 2) . assign v-col = v-col + 1 . end.
     7337         if use-column[78] = yes then  do: run macr_excel_sum ( gds-prop.RetOut-DiscntSum * 100 / gds-prop.RetOut-SaleSum, v-row, v-col, 2) . assign v-col = v-col + 1 . end.
     7338         if use-column[18] = yes then  do: run macr_excel_sum ( gds-prop.OutExt-Qnty    - gds-prop.RetOut-Qnty, v-row, v-col, sz-qnty) . assign v-col = v-col + 1 . end.
     7339         if use-column[37] = yes then  do: run macr_excel_sum ( gds-prop.OutExt-CostSum - gds-prop.RetOut-CostSum, v-row, v-col, 2) . assign v-col = v-col + 1 . end.
     7340         if use-column[54] = yes then  do: run macr_excel_sum ( gds-prop.OutExt-SaleSum - gds-prop.RetOut-SaleSum - gds-prop.OutExt-DiscntSum + gds-prop.RetOut-DiscntSum, v-row, v-col, 2) . assign v-col = v-col + 1 . end.
     7341         if use-column[70] = yes then  do: run macr_excel_sum ( gds-prop.OutExt-DiscntSum - gds-prop.RetOut-DiscntSum, v-row, v-col, 2) . assign v-col = v-col + 1 . end.
     7342         if use-column[79] = yes then  do: run macr_excel_sum ( ( gds-prop.OutExt-DiscntSum - gds-prop.RetOut-DiscntSum ) * 100 / ( gds-prop.OutExt-SaleSum - gds-prop.RetOut-SaleSum ), v-row, v-col, 2) . assign v-col = v-col + 1 . end.
     7343         if use-column[19] = yes then  do: run macr_excel_sum ( gds-prop.OutExtKass-Qnty, v-row, v-col, sz-qnty) . assign v-col = v-col + 1 . end.
     7344         if use-column[38] = yes then  do: run macr_excel_sum ( gds-prop.OutExtKass-CostSum, v-row, v-col, 2) . assign v-col = v-col + 1 . end.
     7345         if use-column[55] = yes then  do: run macr_excel_sum ( gds-prop.OutExtKass-SaleSum, v-row, v-col, 2) . assign v-col = v-col + 1 . end.
     7346         if use-column[71] = yes then  do: run macr_excel_sum ( gds-prop.OutExtKass-DiscntSum, v-row, v-col, 2) . assign v-col = v-col + 1 . end.
     7347         if use-column[80] = yes then  do: run macr_excel_sum ( gds-prop.OutExtKass-DiscntSum * 100 / gds-prop.OutExtKass-SaleSum, v-row, v-col, 2) . assign v-col = v-col + 1 . end.
     7348         if use-column[20] = yes then  do: run macr_excel_sum ( gds-prop.RetOutKass-Qnty, v-row, v-col, sz-qnty) . assign v-col = v-col + 1 . end.
     7349         if use-column[39] = yes then  do: run macr_excel_sum ( gds-prop.RetOutKass-CostSum, v-row, v-col, 2) . assign v-col = v-col + 1 . end.
     7350         if use-column[56] = yes then  do: run macr_excel_sum ( gds-prop.RetOutKass-SaleSum, v-row, v-col, 2) . assign v-col = v-col + 1 . end.
     7351         if use-column[72] = yes then  do: run macr_excel_sum ( gds-prop.RetOutKass-DiscntSum, v-row, v-col, 2) . assign v-col = v-col + 1 . end.
     7352         if use-column[81] = yes then  do: run macr_excel_sum ( gds-prop.RetOutKass-DiscntSum * 100 / gds-prop.RetOutKass-SaleSum, v-row, v-col, 2) . assign v-col = v-col + 1 . end.
     7353         if use-column[21] = yes then  do: run macr_excel_sum ( gds-prop.OutExtKass-Qnty    - gds-prop.RetOutKass-Qnty , v-row, v-col, sz-qnty) . assign v-col = v-col + 1 . end.
     7354         if use-column[40] = yes then  do: run macr_excel_sum ( gds-prop.OutExtKass-CostSum - gds-prop.RetOutKass-CostSum, v-row, v-col, 2) . assign v-col = v-col + 1 . end.
     7355         if use-column[57] = yes then  do: run macr_excel_sum ( gds-prop.OutExtKass-SaleSum - gds-prop.RetOutKass-SaleSum - gds-prop.OutExtKass-DiscntSum + gds-prop.RetOutKass-DiscntSum, v-row, v-col, 2) . assign v-col = v-col + 1 . end.
     7356         if use-column[73] = yes then  do: run macr_excel_sum ( gds-prop.OutExtKass-DiscntSum - gds-prop.RetOutKass-DiscntSum, v-row, v-col, 2) . assign v-col = v-col + 1 . end.
     7357         if use-column[82] = yes then  do: run macr_excel_sum ( ( gds-prop.OutExtKass-DiscntSum - gds-prop.RetOutKass-DiscntSum ) * 100 / ( gds-prop.OutExtKass-SaleSum - gds-prop.RetOutKass-SaleSum ), v-row, v-col, 2) . assign v-col = v-col + 1 . end.
     7358         if use-column[22] = yes then  do: run macr_excel_sum ( gds-prop.OutExt-Qnty      + gds-prop.OutExtKass-Qnty, v-row, v-col, sz-qnty) . assign v-col = v-col + 1 . end.
     7359         if use-column[41] = yes then  do: run macr_excel_sum ( gds-prop.OutExt-CostSum   + gds-prop.OutExtKass-CostSum, v-row, v-col, 2) . assign v-col = v-col + 1 . end.
     7360         if use-column[58] = yes then  do: run macr_excel_sum ( gds-prop.OutExt-SaleSum   + gds-prop.OutExtKass-SaleSum, v-row, v-col, 2) . assign v-col = v-col + 1 . end.
     7361         if use-column[74] = yes then  do: run macr_excel_sum ( gds-prop.OutExt-DiscntSum + gds-prop.OutExtKass-DiscntSum, v-row, v-col, 2) . assign v-col = v-col + 1 . end.
     7362         if use-column[83] = yes then  do: run macr_excel_sum ( ( gds-prop.OutExt-DiscntSum + gds-prop.OutExtKass-DiscntSum ) * 100 / ( gds-prop.OutExt-SaleSum + gds-prop.OutExtKass-SaleSum ) , v-row, v-col, 2) . assign v-col = v-col + 1 . end.
     7363         if use-column[23] = yes then  do: run macr_excel_sum ( gds-prop.RetOut-Qnty      + gds-prop.RetOutKass-Qnty, v-row, v-col, sz-qnty) . assign v-col = v-col + 1 . end.
     7364         if use-column[42] = yes then  do: run macr_excel_sum ( gds-prop.RetOut-CostSum   + gds-prop.RetOutKass-CostSum, v-row, v-col, 2) . assign v-col = v-col + 1 . end.
     7365         if use-column[59] = yes then  do: run macr_excel_sum ( gds-prop.RetOut-SaleSum   + gds-prop.RetOutKass-SaleSum, v-row, v-col, 2) . assign v-col = v-col + 1 . end.
     7366         if use-column[75] = yes then  do: run macr_excel_sum ( gds-prop.RetOut-DiscntSum + gds-prop.RetOutKass-DiscntSum, v-row, v-col, 2) . assign v-col = v-col + 1 . end.
     7367         if use-column[84] = yes then  do: run macr_excel_sum ( ( gds-prop.RetOut-DiscntSum + gds-prop.RetOutKass-DiscntSum  ) * 100 / ( gds-prop.RetOut-SaleSum + gds-prop.RetOutKass-SaleSum ), v-row, v-col, 2) . assign v-col = v-col + 1 . end.
     7368         if use-column[24] = yes then  do: run macr_excel_sum ( gds-prop.OutExt-Qnty    - gds-prop.RetOut-Qnty + gds-prop.OutExtKass-Qnty - gds-prop.RetOutKass-Qnty, v-row, v-col, sz-qnty) . assign v-col = v-col + 1 . end.
     7369         if use-column[43] = yes then  do: run macr_excel_sum ( gds-prop.OutExt-CostSum - gds-prop.RetOut-CostSum + gds-prop.OutExtKass-CostSum - gds-prop.RetOutKass-CostSum, v-row, v-col, 2) . assign v-col = v-col + 1 . end.
     7370         if use-column[60] = yes then  do: run macr_excel_sum ( gds-prop.OutExt-SaleSum - gds-prop.RetOut-SaleSum + gds-prop.OutExtKass-SaleSum - gds-prop.RetOutKass-SaleSum - gds-prop.OutExt-DiscntSum + gds-prop.RetOut-DiscntSum - gds-prop.OutExtKass-DiscntSum + gds-prop.RetOutKass-DiscntSum, v-row, v-col, 2) . assign v-col = v-col + 1 . end.
     7371         if use-column[76] = yes then  do: run macr_excel_sum ( gds-prop.OutExt-DiscntSum - gds-prop.RetOut-DiscntSum + gds-prop.OutExtKass-DiscntSum - gds-prop.RetOutKass-DiscntSum, v-row, v-col, 2) . assign v-col = v-col + 1 . end.
     7372         if use-column[85] = yes then  do: run macr_excel_sum ( ( gds-prop.OutExt-DiscntSum - gds-prop.RetOut-DiscntSum + gds-prop.OutExtKass-DiscntSum - gds-prop.RetOutKass-DiscntSum ) * 100 / ( gds-prop.OutExt-SaleSum - gds-prop.RetOut-SaleSum + gds-prop.OutExtKass-SaleSum - gds-prop.RetOutKass-SaleSum  ), v-row, v-col, 2) . assign v-col = v-col + 1 . end.
     7373         if use-column[25] = yes then  do: run macr_excel_sum ( gds-prop.Inv-Qnty, v-row, v-col, sz-qnty) . assign v-col = v-col + 1 . end.
     7374         if use-column[44] = yes then  do: run macr_excel_sum ( gds-prop.Inv-CostSum, v-row, v-col, 2) . assign v-col = v-col + 1 . end.
     7375         if use-column[61] = yes then  do: run macr_excel_sum ( gds-prop.Inv-SaleSum, v-row, v-col, 2) . assign v-col = v-col + 1 . end.
     7376         if use-column[26] = yes then  do: run macr_excel_sum ( gds-prop.Spi-Qnty, v-row, v-col, sz-qnty) . assign v-col = v-col + 1 . end.
     7377         if use-column[45] = yes then  do: run macr_excel_sum ( gds-prop.Spi-CostSum, v-row, v-col, 2) . assign v-col = v-col + 1 . end.
     7378         if use-column[62] = yes then  do: run macr_excel_sum ( gds-prop.Spi-SaleSum, v-row, v-col, 2) . assign v-col = v-col + 1 . end.
     7379         if use-column[27] = yes then  do: run macr_excel_sum ( gds-prop.InInt-Qnty, v-row, v-col, sz-qnty) . assign v-col = v-col + 1 . end.
     7380         if use-column[46] = yes then  do: run macr_excel_sum ( gds-prop.InInt-CostSum, v-row, v-col, 2) . assign v-col = v-col + 1 . end.
     7381         if use-column[63] = yes then  do: run macr_excel_sum ( gds-prop.InInt-SaleSum, v-row, v-col, 2) . assign v-col = v-col + 1 . end.
     7382         if use-column[28] = yes then  do: run macr_excel_sum ( gds-prop.OutInt-Qnty, v-row, v-col, sz-qnty) . assign v-col = v-col + 1 . end.
