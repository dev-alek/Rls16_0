     3574     ,input  '1':U
     3575     ,input  bf_trn-doc.fact-date
     3576     ,input  bf_trn-doc.host-code
     3577     ,input  bf_trn-doc.obj-type
     3578     ,input  bf_trn-doc.obj-code
     3579     ,output varcur-vat-pc
     3580     ) no-error .
     3581       if varcur-vat-pc = ?
     3582       then do:
     3583         return error substitute ("Ошибка при поиске НДС для товара &1 &2 &3 документ &4", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code, bf_trn-doc.doc-code).
     3584       end.
     3585       if varcur-slt-pc = ?
     3586       then do:
     3587         return error substitute ("Ошибка при поиске НДС для товара &1 &2 &3 документ &4", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code, bf_trn-doc.doc-code).
     3588       end.
     3589       v-calcbypart = no.
     3590       if bf_doc-line.whole-send-news = integer('1':U)   then
     3591       v-calcbypart = yes.
     3592       else do:
     3593       for each bf_gds-dtl no-lock
     3594         where bf_gds-dtl.doc-code  = bf_doc-line.doc-code
     3595           and bf_gds-dtl.artic     = bf_doc-line.artic
     3596           and bf_gds-dtl.prod-type = bf_doc-line.prod-type
     3597           and bf_gds-dtl.prod-code = bf_doc-line.prod-code
     3598       on error undo, return error return-value
     3599       :
     3600   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     3601     (input  bf_goods.gds-code
     3602     ,input  bf_gds-dtl.prt-code
     3603     ,output varb-code
     3604     ) no-error .
     3605   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3606   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     3607     (input  bf_trn-doc.obj-type
     3608     ,input  bf_trn-doc.obj-code
     3609     ,input  varb-code
     3610     ,input  0
     3611     ,input  bf_trn-doc.fact-order
     3612     ,output vardoc-num
     3613     ,output varprice-sale
     3614     ,output varroad-tax
     3615     ,output varexcise
     3616     )  .
     3617             if varprice-sale = ?
     3618             then do:
     3619               assign
     3620                 varprice-sale = 0
     3621                 varroad-tax   = 0
     3622                 varexcise     = 0
     3623               .
     3624             end.
     3625             assign
     3626               varlastcur-base     = varprice-sale
     3627               varlastcur-road-tax = varroad-tax
     3628               varlastcur-excise   = varexcise
     3629               varcur-base         = varcur-base      + varprice-sale * bf_gds-dtl.fact-qnty
     3630               varcur-road-tax     = varcur-road-tax  + varroad-tax   * bf_gds-dtl.fact-qnty
     3631               varcur-excise       = varcur-excise    + varexcise     * bf_gds-dtl.fact-qnty
     3632               varcur-fact-qnty    = varcur-fact-qnty + bf_gds-dtl.fact-qnty
     3633             .
     3634         end.
     3635       end.
     3636       if varcur-fact-qnty = 0 then do:
     3637         assign
     3638           varcur-base      = varlastcur-base
     3639           varcur-road-tax  = varlastcur-road-tax
     3640           varcur-excise    = varlastcur-excise
     3641         .
     3642       end.
     3643       else do:
     3644         assign
     3645           varcur-base      = varcur-base      / varcur-fact-qnty
     3646           varcur-road-tax  = varcur-road-tax  / varcur-fact-qnty
     3647           varcur-excise    = varcur-excise    / varcur-fact-qnty
     3648         .
     3649       end.
     3650       if varcur-vat-pc = ?
     3651       then do:
     3652         return error substitute ("Нет текущего продажного НДС по товару &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     3653       end.
     3654       if varcur-slt-pc = ?
     3655       then do:
     3656         return error substitute ("Нет текущего продажного НП по товару &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     3657       end.
     3658       find first bf_sysconf where bf_sysconf.host-code = bf_trn-doc.host-code no-lock.
     3659       assign
     3660         varcur-cons-vat-pc = bf_sysconf.cons-vat-pc.
     3661       if varcur-cons-vat-pc = ? then do:
     3662         return error substitute ("Нет текущего продажного консигнационного НДС по фирме &1", bf_trn-doc.host-code).
     3663       end.
     3664       define buffer buf_tt-clcparts for tt-clcparts .
     3665       for each buf_tt-clcparts
     3666       on error undo, return error return-value
     3667       :
     3668         delete buf_tt-clcparts.
     3669       end.
     3670       for each bf_parts no-lock
     3671         where bf_parts.out-code  = bf_doc-line.doc-code
     3672           and bf_parts.obj-type  = bf_doc-line.obj-type
     3673           and bf_parts.obj-code  = bf_doc-line.obj-code
     3674           and bf_parts.artic     = bf_doc-line.artic
     3675           and bf_parts.prod-type = bf_doc-line.prod-type
     3676           and bf_parts.prod-code = bf_doc-line.prod-code
     3677       on error undo, return error return-value
     3678       :
     3679         create buf_tt-clcparts .
     3680         buffer-copy bf_parts to buf_tt-clcparts .
     3681         if v-calcbypart = yes   then do:
     3682   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run partbcod in g#library
     3683     (buffer bf_parts
     3684     ,output v-b-pcode
     3685     ) no-error .
     3686   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3687   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     3688     (input  bf_parts.obj-type
     3689     ,input  bf_parts.obj-code
     3690     ,input  v-b-pcode
     3691     ,input  0
     3692     ,input  bf_trn-doc.fact-order
     3693     ,output vardoc-num
     3694     ,output varprice-salef
     3695     ,output varroad-tax
     3696     ,output varexcise
     3697     ) no-error .
     3698             if varprice-sale = ?
     3699             then do:
     3700               assign
     3701                 varprice-salef = 0
     3702                 varroad-tax   = 0
     3703                 varexcise     = 0
     3704               .
     3705             end.
     3706             assign
     3707             part-cur-base  = varprice-salef
     3708             part-cur-road-tax  = varroad-tax
     3709             part-cur-excise = varexcise.
     3710         end.
     3711       end.
     3712       run clcprtsl_calc-ttable in this-procedure
     3713         (input yes,
     3714          input yes,
     3715          input bf_doc-line.road-tax,
     3716          input bf_doc-line.excise,
     3717          input bf_doc-line.vat-pc,
     3718          input bf_doc-line.cons-vat-pc,
     3719          input bf_doc-line.slt-pc,
     3720          input bf_trn-doc.base-rate,
     3721          input bf_trn-doc.base-scale,
     3722          input varr-b,
     3723          input varcur-base,
     3724          input varcur-road-tax,
     3725          input varcur-excise,
     3726          input varcur-vat-pc,
     3727          input varcur-cons-vat-pc,
     3728          input varcur-slt-pc
     3729          ) no-error.
     3730       if error-status:error then do:
     3731         message
     3732           vss-workfile vss-revision vss-description skip
     3733           "Ошибка при вызове процедуры clcprtsl_calc-ttable." skip
     3734           return-value skip
     3735           trim(error-status :get-message(1))
     3736           trim(error-status :get-message(2))
     3737           trim(error-status :get-message(3))
     3738           trim(error-status :get-message(4))
     3739           trim(error-status :get-message(5)) skip
     3740           view-as alert-box error.
     3741         undo, return error .
     3742       end.
     3743     end.
     3744   end.
     3745   end.
     3746   procedure clcprtsl_calc-ttable :
     3747   define input parameter paris-doc           as   logical                 no-undo.
     3748   define input parameter paris-cur           as   logical                 no-undo.
     3749   define input parameter parroad-tax         like ub.doc-line.road-tax    no-undo.
     3750   define input parameter parexcise           like ub.doc-line.excise      no-undo.
     3751   define input parameter parvat-pc           like ub.doc-line.vat-pc      no-undo.
     3752   define input parameter parcons-vat-pc      like ub.doc-line.cons-vat-pc no-undo.
     3753   define input parameter parslt-pc           like ub.doc-line.slt-pc      no-undo.
     3754   define input parameter parbase-rate        like ub.trn-doc.base-rate    no-undo.
     3755   define input parameter parbase-scale       like ub.trn-doc.base-scale   no-undo.
     3756   define input parameter parr-b              as   character               no-undo.
     3757   define input parameter parcur-base         like ub.gds-dtl.cur-base     no-undo.
     3758   define input parameter parcur-road-tax     like ub.doc-line.road-tax    no-undo.
     3759   define input parameter parcur-excise       like ub.doc-line.excise      no-undo.
     3760   define input parameter parcur-vat-pc       like ub.doc-line.vat-pc      no-undo.
     3761   define input parameter parcurcons-vat-pc   like ub.doc-line.cons-vat-pc no-undo.
     3762   define input parameter parcurslt-pc        like ub.doc-line.slt-pc      no-undo.
     3763   define buffer bf_tt-allsum      for tt-allsum.
     3764   define buffer bf_tt-clcparts    for tt-clcparts.
     3765   define buffer bf_tt-allsum-line for tt-allsum-line.
     3766   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     3767   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     3768   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     3769   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     3770   define variable varexcise          like ub.price-list.excise     no-undo.
     3771   do on error undo, return error return-value :
     3772   for each bf_tt-allsum-line
     3773   on error undo, return error return-value
     3774    :
     3775     delete bf_tt-allsum-line.
     3776   end.
     3777   for each bf_tt-allsum
     3778   on error undo, return error return-value
     3779   :
     3780     delete bf_tt-allsum.
     3781   end.
     3782   for each bf_tt-clcparts
     3783   on error undo, return error return-value
     3784   :
     3785   if v-calcbypart then do:
     3786             assign
     3787             parcur-base =   bf_tt-clcparts.part-cur-base
     3788             parcur-road-tax = bf_tt-clcparts.part-cur-road-tax
     3789             parcur-excise =   bf_tt-clcparts.part-cur-excise
     3790             .
     3791   end.
     3792      run clcprtsl_calc-parts in this-procedure (
     3793        input recid(bf_tt-clcparts),
     3794        input paris-doc,
     3795        input paris-cur,
     3796        input parroad-tax,
     3797        input parexcise,
     3798        input parvat-pc,
     3799        input parcons-vat-pc,
     3800        input parslt-pc,
     3801        input parbase-rate,
     3802        input parbase-scale,
     3803        input parr-b,
     3804        input parcur-base,
     3805        input parcur-road-tax,
     3806        input parcur-excise,
     3807        input parcur-vat-pc,
     3808        input parcurcons-vat-pc,
     3809        input parcurslt-pc
     3810        ) no-error.
     3811     if error-status:error then do:
     3812       message
     3813         vss-workfile vss-revision vss-description skip
     3814         vss-include-info17 skip
     3815         "Ошибка при обсчете партии" skip
     3816         "Документ партии " bf_tt-clcparts.out-code skip
     3817         "Товар" bf_tt-clcparts.artic bf_tt-clcparts.prod-type bf_tt-clcparts.prod-code skip
     3818         return-value skip
     3819         error-status:get-message(1) skip
     3820         error-status:get-message(2) skip
     3821         error-status:get-message(3) skip
     3822         view-as alert-box error .
     3823       undo, return error .
     3824     end.
     3825     for each bf_tt-allsum on error undo, return error return-value :
     3826       find first bf_tt-allsum-line where bf_tt-allsum-line.sum-type = bf_tt-allsum.sum-type no-error.
     3827       if not available bf_tt-allsum-line then do:
     3828         create bf_tt-allsum-line.
     3829         assign
     3830           bf_tt-allsum-line.sum-type = bf_tt-allsum.sum-type.
     3831       end.
     3832       assign
     3833         bf_tt-allsum-line.fact-qnty              = bf_tt-allsum-line.fact-qnty            + bf_tt-allsum.fact-qnty
     3834         bf_tt-allsum-line.cli-qnty               = bf_tt-allsum-line.cli-qnty             + bf_tt-allsum.cli-qnty
     3835         bf_tt-allsum-line.sum-dsc-base-doc       = bf_tt-allsum-line.sum-dsc-base-doc     + bf_tt-allsum.sum-dsc-base-doc
     3836         bf_tt-allsum-line.sum-dsc-rubl-doc       = bf_tt-allsum-line.sum-dsc-rubl-doc     + bf_tt-allsum.sum-dsc-rubl-doc
     3837         bf_tt-allsum-line.dsc-base-doc           = bf_tt-allsum-line.dsc-base-doc         + bf_tt-allsum.dsc-base-doc
     3838         bf_tt-allsum-line.dsc-rubl-doc           = bf_tt-allsum-line.dsc-rubl-doc         + bf_tt-allsum.dsc-rubl-doc
     3839         bf_tt-allsum-line.vat-base-doc           = bf_tt-allsum-line.vat-base-doc         + bf_tt-allsum.vat-base-doc
     3840         bf_tt-allsum-line.vat-rubl-doc           = bf_tt-allsum-line.vat-rubl-doc         + bf_tt-allsum.vat-rubl-doc
     3841         bf_tt-allsum-line.vat-base-buyer-doc     = bf_tt-allsum-line.vat-base-buyer-doc   + bf_tt-allsum.vat-base-buyer-doc
     3842         bf_tt-allsum-line.vat-rubl-buyer-doc     = bf_tt-allsum-line.vat-rubl-buyer-doc   + bf_tt-allsum.vat-rubl-buyer-doc
     3843         bf_tt-allsum-line.slt-base-doc           = bf_tt-allsum-line.slt-base-doc         + bf_tt-allsum.slt-base-doc
     3844         bf_tt-allsum-line.slt-rubl-doc           = bf_tt-allsum-line.slt-rubl-doc         + bf_tt-allsum.slt-rubl-doc
     3845         bf_tt-allsum-line.road-tax-base-doc      = bf_tt-allsum-line.road-tax-base-doc    + bf_tt-allsum.road-tax-base-doc
     3846         bf_tt-allsum-line.road-tax-rubl-doc      = bf_tt-allsum-line.road-tax-rubl-doc    + bf_tt-allsum.road-tax-rubl-doc
     3847         bf_tt-allsum-line.excise-base-doc        = bf_tt-allsum-line.excise-base-doc      + bf_tt-allsum.excise-base-doc
     3848         bf_tt-allsum-line.excise-rubl-doc        = bf_tt-allsum-line.excise-rubl-doc      + bf_tt-allsum.excise-rubl-doc
     3849         bf_tt-allsum-line.sum-dsc-base-cur       = bf_tt-allsum-line.sum-dsc-base-cur     + bf_tt-allsum.sum-dsc-base-cur
     3850         bf_tt-allsum-line.sum-dsc-rubl-cur       = bf_tt-allsum-line.sum-dsc-rubl-cur     + bf_tt-allsum.sum-dsc-rubl-cur
     3851         bf_tt-allsum-line.dsc-base-cur           = bf_tt-allsum-line.dsc-base-cur         + bf_tt-allsum.dsc-base-cur
     3852         bf_tt-allsum-line.dsc-rubl-cur           = bf_tt-allsum-line.dsc-rubl-cur         + bf_tt-allsum.dsc-rubl-cur
     3853         bf_tt-allsum-line.vat-base-cur           = bf_tt-allsum-line.vat-base-cur         + bf_tt-allsum.vat-base-cur
     3854         bf_tt-allsum-line.vat-rubl-cur           = bf_tt-allsum-line.vat-rubl-cur         + bf_tt-allsum.vat-rubl-cur
     3855         bf_tt-allsum-line.vat-base-buyer-cur     = bf_tt-allsum-line.vat-base-buyer-cur   + bf_tt-allsum.vat-base-buyer-cur
     3856         bf_tt-allsum-line.vat-rubl-buyer-cur     = bf_tt-allsum-line.vat-rubl-buyer-cur   + bf_tt-allsum.vat-rubl-buyer-cur
     3857         bf_tt-allsum-line.slt-base-cur           = bf_tt-allsum-line.slt-base-cur         + bf_tt-allsum.slt-base-cur
     3858         bf_tt-allsum-line.slt-rubl-cur           = bf_tt-allsum-line.slt-rubl-cur         + bf_tt-allsum.slt-rubl-cur
     3859         bf_tt-allsum-line.road-tax-base-cur      = bf_tt-allsum-line.road-tax-base-cur    + bf_tt-allsum.road-tax-base-cur
     3860         bf_tt-allsum-line.road-tax-rubl-cur      = bf_tt-allsum-line.road-tax-rubl-cur    + bf_tt-allsum.road-tax-rubl-cur
     3861         bf_tt-allsum-line.excise-base-cur        = bf_tt-allsum-line.excise-base-cur      + bf_tt-allsum.excise-base-cur
     3862         bf_tt-allsum-line.excise-rubl-cur        = bf_tt-allsum-line.excise-rubl-cur      + bf_tt-allsum.excise-rubl-cur
     3863         bf_tt-allsum-line.sum-dsc-base-acc       = bf_tt-allsum-line.sum-dsc-base-acc     + bf_tt-allsum.sum-dsc-base-acc
     3864         bf_tt-allsum-line.sum-dsc-rubl-acc       = bf_tt-allsum-line.sum-dsc-rubl-acc     + bf_tt-allsum.sum-dsc-rubl-acc
     3865         bf_tt-allsum-line.sum-dsc-cli-acc        = bf_tt-allsum-line.sum-dsc-cli-acc      + bf_tt-allsum.sum-dsc-cli-acc
     3866         bf_tt-allsum-line.dsc-base-acc           = bf_tt-allsum-line.dsc-base-acc         + bf_tt-allsum.dsc-base-acc
     3867         bf_tt-allsum-line.dsc-rubl-acc           = bf_tt-allsum-line.dsc-rubl-acc         + bf_tt-allsum.dsc-rubl-acc
     3868         bf_tt-allsum-line.dsc-cli-acc            = bf_tt-allsum-line.dsc-cli-acc          + bf_tt-allsum.dsc-cli-acc
     3869         bf_tt-allsum-line.vat-base-acc           = bf_tt-allsum-line.vat-base-acc         + bf_tt-allsum.vat-base-acc
     3870         bf_tt-allsum-line.vat-rubl-acc           = bf_tt-allsum-line.vat-rubl-acc         + bf_tt-allsum.vat-rubl-acc
     3871         bf_tt-allsum-line.vat-cli-acc            = bf_tt-allsum-line.vat-cli-acc          + bf_tt-allsum.vat-cli-acc
     3872         bf_tt-allsum-line.slt-base-acc           = bf_tt-allsum-line.slt-base-acc         + bf_tt-allsum.slt-base-acc
     3873         bf_tt-allsum-line.slt-rubl-acc           = bf_tt-allsum-line.slt-rubl-acc         + bf_tt-allsum.slt-rubl-acc
     3874         bf_tt-allsum-line.slt-cli-acc            = bf_tt-allsum-line.slt-cli-acc          + bf_tt-allsum.slt-cli-acc
     3875         bf_tt-allsum-line.road-tax-base-acc      = bf_tt-allsum-line.road-tax-base-acc    + bf_tt-allsum.road-tax-base-acc
     3876         bf_tt-allsum-line.road-tax-rubl-acc      = bf_tt-allsum-line.road-tax-rubl-acc    + bf_tt-allsum.road-tax-rubl-acc
     3877         bf_tt-allsum-line.road-tax-cli-acc       = bf_tt-allsum-line.road-tax-cli-acc     + bf_tt-allsum.road-tax-cli-acc
     3878         bf_tt-allsum-line.excise-base-acc        = bf_tt-allsum-line.excise-base-acc      + bf_tt-allsum.excise-base-acc
     3879         bf_tt-allsum-line.excise-rubl-acc        = bf_tt-allsum-line.excise-rubl-acc      + bf_tt-allsum.excise-rubl-acc
     3880         bf_tt-allsum-line.excise-cli-acc         = bf_tt-allsum-line.excise-cli-acc       + bf_tt-allsum.excise-cli-acc
     3881         bf_tt-allsum-line.transport-base-acc     = bf_tt-allsum-line.transport-base-acc   + bf_tt-allsum.transport-base-acc
     3882         bf_tt-allsum-line.transport-rubl-acc     = bf_tt-allsum-line.transport-rubl-acc   + bf_tt-allsum.transport-rubl-acc
     3883         bf_tt-allsum-line.transport-cli-acc      = bf_tt-allsum-line.transport-cli-acc    + bf_tt-allsum.transport-cli-acc
     3884         bf_tt-allsum-line.other-base-acc         = bf_tt-allsum-line.other-base-acc       + bf_tt-allsum.other-base-acc
     3885         bf_tt-allsum-line.other-rubl-acc         = bf_tt-allsum-line.other-rubl-acc       + bf_tt-allsum.other-rubl-acc
     3886         bf_tt-allsum-line.other-cli-acc          = bf_tt-allsum-line.other-cli-acc        + bf_tt-allsum.other-cli-acc
     3887         .
     3888     end.
     3889   end.
     3890   end.
     3891   end procedure.
     3892   define variable g#host-code as integer   no-undo .
     3893   assign g#host-code = v-cntxt-host-code-obj .
     3894   do
     3895   on error undo, return error
     3896   :
     3897   define variable var-client   as character initial "" no-undo .
