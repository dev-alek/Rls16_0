     9533   procedure PrintParts :
     9534   define input  parameter p-artic     as character no-undo .
     9535   define input  parameter p-prod-type as character no-undo .
     9536   define input  parameter p-prod-code as integer   no-undo .
     9537   define input  parameter p-obj-type  as character no-undo .
     9538   define input  parameter p-obj-code  as integer   no-undo .
     9539     do
     9540     on error undo, return error return-value
     9541     :
     9542     for each o_temp-parts where
     9543              o_temp-parts.artic     = p-artic        and
     9544              o_temp-parts.prod-type = p-prod-type    and
     9545              o_temp-parts.prod-code = p-prod-code    and
     9546              o_temp-parts.obj-type  = p-obj-type     and
     9547              o_temp-parts.obj-code  = p-obj-code      by o_temp-parts.fact-date by  o_temp-parts.b-code :
     9548   define variable vss-include-info53 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9549         assign v-col = 1 .
     9550         if use-column[1]  = yes then do: run macr_excel_char ( string ( o_temp-parts.b-code ) , v-row, v-col) . assign v-col = v-col + 1 . end.
     9551         if use-column[2]  = yes then do: run macr_excel_char ( o_temp-parts.part-code  , v-row, v-col) . assign v-col = v-col + 1 . end.
     9552         if use-column[3]  = yes then do: run macr_excel_char ( o_temp-parts.gds-name, v-row, v-col) . assign v-col = v-col + 1 . end.
     9553         if use-column[4]  = yes then do: run macr_excel_char ( o_temp-parts.unit-base, v-row, v-col) . assign v-col = v-col + 1 . end.
     9554         if use-column[5]  = yes then do: run macr_excel_sum  ( o_temp-parts.Cost-Price, v-row, v-col, 2) . assign v-col = v-col + 1 . end.
     9555         if use-column[6]  = yes then do:
     9556           if prod-zen = yes then do:
     9557             run macr_excel_sum  ( o_temp-parts.Avrg-Sale-Price, v-row, v-col, 2) .
     9558           end.
     9559           else do:
     9560             run macr_excel_sum  ( o_temp-parts.Last-Sale-Price, v-row, v-col, 2) .
     9561           end.
     9562           assign v-col = v-col + 1 .
     9563         end.
     9564         if use-column[7]  = yes then do: run macr_excel_sum  ( o_temp-parts.Up-Plan, v-row, v-col, 2) . assign v-col = v-col + 1 . end.
     9565         if use-column[8]  = yes then do:
     9566           if o_temp-parts.LastPer-Date <> ? then do: run macr_excel_char (string(o_temp-parts.LastPer-Date,"99.99.9999"), v-row, v-col) .  end.
     9567           assign v-col = v-col + 1 .
     9568         end.
     9569         if use-column[9]  = yes then do: run macr_excel_char (o_temp-parts.LastPer-Num, v-row, v-col) . assign v-col = v-col + 1 . end.
     9570         if use-column[12] = yes then  do: run macr_excel_sum ( o_temp-parts.StartWay-Qnty, v-row, v-col, sz-qnty) . assign v-col = v-col + 1 . end.
     9571         if use-column[31] = yes then  do: run macr_excel_sum ( o_temp-parts.StartWay-CostSum, v-row, v-col, 2) . assign v-col = v-col + 1 . end.
     9572         if use-column[50] = yes then  do: run macr_excel_sum ( o_temp-parts.StartWay-SaleSum, v-row, v-col, 2) . assign v-col = v-col + 1 . end.
     9573         if use-column[14] = yes then  do: run macr_excel_sum ( o_temp-parts.InExt-Qnty, v-row, v-col, sz-qnty) . assign v-col = v-col + 1 . end.
     9574         if use-column[33] = yes then  do: run macr_excel_sum ( o_temp-parts.InExt-CostSum, v-row, v-col, 2) . assign v-col = v-col + 1 . end.
     9575         if use-column[15] = yes then  do: run macr_excel_sum ( o_temp-parts.RetPost-Qnty, v-row, v-col, sz-qnty) . assign v-col = v-col + 1 . end.
     9576         if use-column[34] = yes then  do: run macr_excel_sum ( o_temp-parts.RetPost-CostSum, v-row, v-col, 2) . assign v-col = v-col + 1 . end.
     9577         if use-column[16] = yes then  do: run macr_excel_sum ( o_temp-parts.OutExt-Qnty, v-row, v-col, sz-qnty) . assign v-col = v-col + 1 . end.
     9578         if use-column[35] = yes then  do: run macr_excel_sum ( o_temp-parts.OutExt-CostSum, v-row, v-col, 2) . assign v-col = v-col + 1 . end.
     9579         if use-column[52] = yes then  do: run macr_excel_sum ( o_temp-parts.OutExt-SaleSum, v-row, v-col, 2) . assign v-col = v-col + 1 . end.
     9580         if use-column[68] = yes then  do: run macr_excel_sum ( o_temp-parts.OutExt-DiscntSum, v-row, v-col, 2) . assign v-col = v-col + 1 . end.
     9581         if use-column[77] = yes then  do: run macr_excel_sum ( o_temp-parts.OutExt-DiscntSum * 100 / o_temp-parts.OutExt-SaleSum, v-row, v-col, 2) . assign v-col = v-col + 1 . end.
     9582         if use-column[17] = yes then  do: run macr_excel_sum ( o_temp-parts.RetOut-Qnty, v-row, v-col, sz-qnty) . assign v-col = v-col + 1 . end.
     9583         if use-column[36] = yes then  do: run macr_excel_sum ( o_temp-parts.RetOut-CostSum, v-row, v-col, 2) . assign v-col = v-col + 1 . end.
     9584         if use-column[53] = yes then  do: run macr_excel_sum ( o_temp-parts.RetOut-SaleSum, v-row, v-col, 2) . assign v-col = v-col + 1 . end.
     9585         if use-column[69] = yes then  do: run macr_excel_sum ( o_temp-parts.RetOut-DiscntSum, v-row, v-col, 2) . assign v-col = v-col + 1 . end.
     9586         if use-column[78] = yes then  do: run macr_excel_sum ( o_temp-parts.RetOut-DiscntSum * 100 / o_temp-parts.RetOut-SaleSum, v-row, v-col, 2) . assign v-col = v-col + 1 . end.
     9587         if use-column[18] = yes then  do: run macr_excel_sum ( o_temp-parts.OutExt-Qnty    - o_temp-parts.RetOut-Qnty, v-row, v-col, sz-qnty) . assign v-col = v-col + 1 . end.
     9588         if use-column[37] = yes then  do: run macr_excel_sum ( o_temp-parts.OutExt-CostSum - o_temp-parts.RetOut-CostSum, v-row, v-col, 2) . assign v-col = v-col + 1 . end.
     9589         if use-column[54] = yes then  do: run macr_excel_sum ( o_temp-parts.OutExt-SaleSum - o_temp-parts.RetOut-SaleSum - o_temp-parts.OutExt-DiscntSum + o_temp-parts.RetOut-DiscntSum, v-row, v-col, 2) . assign v-col = v-col + 1 . end.
     9590         if use-column[70] = yes then  do: run macr_excel_sum ( o_temp-parts.OutExt-DiscntSum - o_temp-parts.RetOut-DiscntSum, v-row, v-col, 2) . assign v-col = v-col + 1 . end.
     9591         if use-column[79] = yes then  do: run macr_excel_sum ( ( o_temp-parts.OutExt-DiscntSum - o_temp-parts.RetOut-DiscntSum ) * 100 / ( o_temp-parts.OutExt-SaleSum - o_temp-parts.RetOut-SaleSum ), v-row, v-col, 2) . assign v-col = v-col + 1 . end.
     9592         if use-column[19] = yes then  do: run macr_excel_sum ( o_temp-parts.OutExtKass-Qnty, v-row, v-col, sz-qnty) . assign v-col = v-col + 1 . end.
     9593         if use-column[38] = yes then  do: run macr_excel_sum ( o_temp-parts.OutExtKass-CostSum, v-row, v-col, 2) . assign v-col = v-col + 1 . end.
     9594         if use-column[55] = yes then  do: run macr_excel_sum ( o_temp-parts.OutExtKass-SaleSum, v-row, v-col, 2) . assign v-col = v-col + 1 . end.
     9595         if use-column[71] = yes then  do: run macr_excel_sum ( o_temp-parts.OutExtKass-DiscntSum, v-row, v-col, 2) . assign v-col = v-col + 1 . end.
     9596         if use-column[80] = yes then  do: run macr_excel_sum ( o_temp-parts.OutExtKass-DiscntSum * 100 / o_temp-parts.OutExtKass-SaleSum, v-row, v-col, 2) . assign v-col = v-col + 1 . end.
     9597         if use-column[20] = yes then  do: run macr_excel_sum ( o_temp-parts.RetOutKass-Qnty, v-row, v-col, sz-qnty) . assign v-col = v-col + 1 . end.
     9598         if use-column[39] = yes then  do: run macr_excel_sum ( o_temp-parts.RetOutKass-CostSum, v-row, v-col, 2) . assign v-col = v-col + 1 . end.
     9599         if use-column[56] = yes then  do: run macr_excel_sum ( o_temp-parts.RetOutKass-SaleSum, v-row, v-col, 2) . assign v-col = v-col + 1 . end.
     9600         if use-column[72] = yes then  do: run macr_excel_sum ( o_temp-parts.RetOutKass-DiscntSum, v-row, v-col, 2) . assign v-col = v-col + 1 . end.
     9601         if use-column[81] = yes then  do: run macr_excel_sum ( o_temp-parts.RetOutKass-DiscntSum * 100 / o_temp-parts.RetOutKass-SaleSum, v-row, v-col, 2) . assign v-col = v-col + 1 . end.
     9602         if use-column[21] = yes then  do: run macr_excel_sum ( o_temp-parts.OutExtKass-Qnty    - o_temp-parts.RetOutKass-Qnty , v-row, v-col, sz-qnty) . assign v-col = v-col + 1 . end.
     9603         if use-column[40] = yes then  do: run macr_excel_sum ( o_temp-parts.OutExtKass-CostSum - o_temp-parts.RetOutKass-CostSum, v-row, v-col, 2) . assign v-col = v-col + 1 . end.
     9604         if use-column[57] = yes then  do: run macr_excel_sum ( o_temp-parts.OutExtKass-SaleSum - o_temp-parts.RetOutKass-SaleSum - o_temp-parts.OutExtKass-DiscntSum + o_temp-parts.RetOutKass-DiscntSum, v-row, v-col, 2) . assign v-col = v-col + 1 . end.
     9605         if use-column[73] = yes then  do: run macr_excel_sum ( o_temp-parts.OutExtKass-DiscntSum - o_temp-parts.RetOutKass-DiscntSum, v-row, v-col, 2) . assign v-col = v-col + 1 . end.
