     8239   procedure PutTitul :
     8240     if titul = 0 and tog-obj = true then do:
     8241       assign
     8242         line1 = ""
     8243         titul = 1
     8244       .
     8245       if available obj-list then assign  line1 = "По объекту: " + obj-list.obj-name + " (" + obj-list.obj-type + '#' + string(obj-list.obj-code) + ")" .
     8246       run macr_excel_char (line1, v-row, 1) .
     8247       assign v-row = v-row + 1 .
     8248       put stream outstream   Line format frmt skip .
     8249       PUT stream OutStream "| " line1 format "X(60)" "|" at beg  SKIP .
     8250     end.
     8251     if SumsOnly = no then do:
     8252       if var-client <> "" then do:
     8253         run macr_excel_char (var-client, v-row, 1) .
     8254         assign v-row = v-row + 1 .
     8255         PUT stream OutStream "| " var-client format "X(60)" "|" at beg  SKIP .
     8256         assign  var-client = "" .
     8257       end.
     8258       if var-client1 <> "" then do:
     8259         run macr_excel_char (var-client1, v-row, 1) .
     8260         assign v-row = v-row + 1 .
     8261         PUT stream OutStream "| " var-client1 format "X(60)" "|" at beg  SKIP .
     8262         assign  var-client1 = "" .
     8263       end.
     8264     end.
     8265   end procedure.
     8266   procedure macr_excel_char :
     8267    do
     8268    on error undo, return error return-value
     8269    :
     8270    define input parameter  p-val as character no-undo .
     8271    define input parameter  p-row as integer no-undo .
     8272    define input parameter  p-col as integer no-undo .
     8273         put  stream macr_excel unformatted
     8274           substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) skip  .
     8275    end.
     8276   end procedure.
     8277   procedure macr_excel_sum :
     8278    do
     8279    on error undo, return error return-value
     8280    :
     8281    define input parameter  p-val as decimal   no-undo .
     8282    define input parameter  p-row as integer   no-undo .
     8283    define input parameter  p-col as integer   no-undo .
     8284    define input parameter  p-typ as integer   no-undo .
     8285    if p-val = ? then assign p-val = 0 .
     8286    define variable ss as character no-undo .
     8287    assign
     8288      ss = string( Round( p-val, p-typ) )
     8289    .
     8290    put  stream macr_excel unformatted
     8291         substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( ss ) ) skip  .
     8292    end.
     8293   END procedure.
     8294   procedure macr_cell_format :
     8295    do
     8296    on error undo, return error return-value
     8297    :
     8298    define input parameter  p-size   as integer   no-undo .
     8299    define input parameter  p-bold   as logical   no-undo .
     8300    define input parameter  p-italic as logical   no-undo .
     8301    define input parameter  p-color  as integer   no-undo .
     8302    define input parameter  p-row    as integer   no-undo .
     8303    define input parameter  p-col    as integer   no-undo .
     8304    define input parameter  p-row-2  as integer   no-undo .
     8305    define input parameter  p-col-2  as integer   no-undo .
     8306     if p-size = ? then p-size = 10 .
     8307     if p-bold = ? then p-bold = false .
     8308     if p-italic = ? then p-italic = false .
     8309     if p-row-2 = ? then p-row-2 = p-row .
     8310     if p-col-2 = ? then p-col-2 = p-col .
     8311     put  stream macr_excel unformatted
     8312      substitute('select("r&1c&2:r&3c&4 ")' , p-row , p-col , p-row-2 , p-col-2 ) skip .
     8313     if p-color <> ? then do:
     8314        put  stream macr_excel unformatted
     8315          substitute('patterns(1,,&1,true)', p-color )  skip  .
     8316     end.
     8317     put  stream macr_excel unformatted
     8318          substitute('format.font(,&1,&2,&3)' , p-size,
     8319                                           string ( p-bold  , "true/false" ) ,
     8320                                           string ( p-italic , "true/false" )
     8321                                           ) skip .
     8322    end.
     8323   end procedure.
     8324   procedure macr_cell_bordur :
     8325    do
     8326    on error undo, return error return-value
     8327    :
     8328    define input parameter  p-row    as integer   no-undo .
     8329    define input parameter  p-col    as integer   no-undo .
     8330    define input parameter  p-row-2  as integer   no-undo .
     8331    define input parameter  p-col-2  as integer   no-undo .
     8332     if p-row-2 = ? then p-row-2 = p-row .
     8333     if p-col-2 = ? then p-col-2 = p-col .
     8334     put  stream macr_excel unformatted
     8335      substitute('select("r&1c&2:r&3c&4 ")' , p-row , p-col , p-row-2 , p-col-2 ) skip .
     8336     put  stream macr_excel unformatted
     8337          'BORDER( 2 , 2 , 2 , 2 , 2 , ,0,0,0,0,0) '  skip
     8338          'ALIGNMENT(3 , , 4 , 4 ,)'   skip
     8339          .
     8340    end.
     8341   end procedure.
     8342   procedure macr_cell_size :
     8343    do
     8344    on error undo, return error return-value
     8345    :
     8346    define input parameter  p-w   as integer   no-undo .
     8347    define input parameter  p-l   as integer   no-undo .
     8348    define input parameter  p-row    as integer   no-undo .
     8349    define input parameter  p-col    as integer   no-undo .
     8350    define input parameter  p-row-2  as integer   no-undo .
     8351    define input parameter  p-col-2  as integer   no-undo .
     8352     if p-row-2 = ? then p-row-2 = p-row .
     8353     if p-col-2 = ? then p-col-2 = p-col .
     8354     if p-w = ? then    p-w = 0 .
     8355     if p-l = ? then    p-l = 0 .
     8356    define variable s-w as character no-undo .
     8357    define variable s-l as character no-undo .
     8358    if p-w = 0 then s-w = "" .
     8359               else s-w = string(p-w)  .
     8360    if p-l = 0 then s-l = "" .
     8361               else s-l = string(p-l)  .
     8362   put  stream macr_excel unformatted
     8363        substitute('select("r&1c&2:r&3c&4 ")' , p-row , p-col , p-row-2 , p-col-2 )  skip .
     8364   put  stream macr_excel unformatted
     8365        substitute('COLUMN.WIDTH(&1,,,,)' , s-w  )  skip.
     8366   put  stream macr_excel unformatted
     8367        'FORMAT.TEXT(2,2,0,,,,,)'  skip.
     8368    end.
     8369   end procedure.
