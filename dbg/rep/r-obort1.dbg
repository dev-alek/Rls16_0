     8552   PROCEDURE foreach3 :
     8553     if tog-obj = true then do:
     8554       for each obj-list no-lock :
     8555         assign
     8556           LastGroup   = ""
     8557           CurrGrpName = ""
     8558           titul       = 0
     8559         .
     8560         run Create-gds-sum in this-procedure (2) .
     8561         if SortType = "sort-code":U then do:
     8562           for each gds-prop
     8563             where gds-prop.obj-type = obj-list.obj-type
     8564               and gds-prop.obj-code = obj-list.obj-code
     8565             break by gds-prop.grp-name
     8566                   by gds-prop.b-code :
     8567   define variable vss-include-info37 as character format "X(65)" no-undo
     8568   initial "@(#)$Workfile$".
     8569         if tog-tree = no then do:
     8570           if first-of(gds-prop.grp-name) then do:
     8571             if tog-lavel = yes then do:
     8572               assign
     8573                 lvel = num-entries( right-trim(gds-prop.grp-name, chr(47)), chr(47) )
     8574               .
     8575               if var-lavel < lvel then do:
     8576                 assign CurrGrpName = "" .
     8577                 do ii = 1 to var-lavel :
     8578                   assign CurrGrpName = CurrGrpName + entry ( ii, gds-prop.grp-name, chr(47) )  + chr(47) .
     8579                 end.
     8580                 if LastGroup <> CurrGrpName then do:
     8581                   if LastGroup <> "" then do:
     8582                     assign ItogStr = "Итого по " + LastGroup + ":"   .
     8583                     run PutItogSum in this-procedure (3) .
     8584                   end.
     8585                   assign
     8586                     LastGroup  = CurrGrpName
     8587                     var-client = "Группа " + CurrGrpName
     8588                   .
     8589                   run Create-gds-sum in this-procedure (3) .
     8590                 end.
     8591               end.
     8592               else do:
     8593                 if LastGroup <> "" then do:
     8594                   assign ItogStr = "Итого по " + LastGroup + ":"   .
     8595                   run PutItogSum in this-procedure (3) .
     8596                 end.
     8597                 assign
     8598                   LastGroup  = gds-prop.grp-name
     8599                   var-client = "Группа " + gds-prop.grp-name
     8600                 .
     8601                 run Create-gds-sum in this-procedure (3) .
     8602               end.
     8603             end .
     8604             else do:
     8605               assign var-client = "Группа " + gds-prop.grp-name .
     8606               run Create-gds-sum in this-procedure (3) .
     8607             end .
     8608           End .
     8609           run CheckNullOborot in this-procedure .
     8610           if NullStr < 1 then do:
     8611               run PutTitul in this-procedure .
     8612               run PrintLine in this-procedure .
     8613             run CalculSum in this-procedure (1) .
     8614             if tog-obj = true then run CalculSum in this-procedure (2) .
     8615             run CalculSum in this-procedure (3) .
     8616           end.
     8617           if last-of(gds-prop.grp-name) and tog-lavel = no then do:
     8618             assign
     8619               ItogStr = "Итого по " + gds-prop.grp-name + ":"
     8620             .
     8621             run PutItogSum in this-procedure (3) .
     8622           End.
     8623         End.
     8624         else do:
     8625           if first-of(gds-prop.grp-name) then do:
     8626             assign
     8627               lvel = num-entries( right-trim(gds-prop.grp-name, chr(47)), chr(47) )
     8628             .
     8629             assign CurrGrpName = "" .
     8630             do ind = 1 to lvel :
     8631               assign CurrGrpName = CurrGrpName + entry ( ind, gds-prop.grp-name, chr(47) )  + chr(47) .
     8632               find first tt-grp-tree
     8633                 where tt-grp-tree.full = CurrGrpName
     8634               no-error .
     8635               if not available tt-grp-tree then LEAVE.
     8636             end.
     8637             do ij = old-lvel to ind by -1 :
     8638               find first tt-grp-tree
     8639                 where tt-grp-tree.num = (ij + 3) .
     8640               assign ItogStr = "" .
     8641               do jj = 1 to ij : assign ItogStr = ItogStr + "  " . end.
     8642               assign ItogStr = ItogStr + tt-grp-tree.name .
     8643               if ij <= var-lavel then do:
     8644                 run PutItogSum in this-procedure (tt-grp-tree.num) .
     8645               end.
     8646               delete tt-grp-tree .
     8647             end.
     8648             assign old-lvel = lvel .
     8649             do ij = ind to lvel :
     8650               create tt-grp-tree .
     8651               if ij > ind then do:
     8652                 assign CurrGrpName = CurrGrpName + entry ( ij, gds-prop.grp-name, chr(47) )  + chr(47) .
     8653               end.
     8654               assign
     8655                 tt-grp-tree.num  = ij + 3
     8656                 tt-grp-tree.full = CurrGrpName
     8657                 tt-grp-tree.name = entry ( ij, gds-prop.grp-name, chr(47) )
     8658                 var-client = "Группа " + tt-grp-tree.name
     8659               .
     8660               run Create-gds-sum in this-procedure (tt-grp-tree.num) .
     8661             end.
     8662           end.
     8663           run CheckNullOborot in this-procedure .
     8664           if NullStr < 1 then do:
     8665               run PutTitul in this-procedure .
     8666               run PrintLine in this-procedure .
     8667             run CalculSum in this-procedure (1) .
     8668             if tog-obj = true then run CalculSum in this-procedure (2) .
     8669             for each tt-grp-tree :
     8670               run CalculSum in this-procedure (tt-grp-tree.num) .
     8671             end.
     8672           end.
     8673         End.
     8674           End.
     8675         end.
     8676         else do:
     8677           for each gds-prop
     8678             where gds-prop.obj-type = obj-list.obj-type
     8679               and gds-prop.obj-code = obj-list.obj-code
     8680             break by gds-prop.grp-name
     8681                   by gds-prop.artic :
