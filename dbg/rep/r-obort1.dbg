     4079       when  "n-level":u       then t-class =   "Группы с уровнем вложенности " .
     4080       when  "t-level":u       then t-class =   "Терминальные группы" .
     4081    end case.
     4082     case sorttype:
     4083       when "sort-pp":u               then t-sort =   "по порядку" .
     4084       when "sort-code":u             then t-sort =   "по коду" .
     4085       when "sort-artic":u            then t-sort =   "по артикулу"  .
     4086       when "sort-qunty":u            then t-sort =   "по реализации".
     4087       when "sort-name":u             then t-sort =   "по наименованию".
     4088       when "sort-type":u             then t-sort =   "по типу ткани".
     4089       when "sort-doc-code":u         then t-sort =   "по номеру документа".
     4090       when "sort-recipe-code":u      then t-sort =   "по номеру рецепта".
     4091    end case.
