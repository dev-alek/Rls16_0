     3912   define variable old-lvel     as integer initial 0 no-undo .
     3913   define variable ind          as integer   no-undo .
     3914   define variable ij           as integer   no-undo .
     3915   define variable ObS          as integer initial 1  no-undo .
     3916   define variable vvv1         as decimal   no-undo .
     3917   define variable vvv2         as decimal   no-undo .
     3918   define variable v-qntyp      as decimal   no-undo .
     3919     define variable frm-qnty1 as character no-undo .
     3920     define variable frm-sum1  as character no-undo .
     3921     if sz-qnty = 3 then assign frm-qnty1 = "->>>>>>>>9.999" .
     3922     else                       frm-qnty1 = "->>>>>>>>>>>9" .
     3923     assign frm-sum1 = "->>>>>>>>>9.99" .
     3924     define Stream OutStream.
     3925     def stream txt-file.
     3926     define stream macr_excel .
     3927     define variable v-row       as integer   no-undo .
     3928     define variable v-col       as integer   no-undo .
     3929     define variable v-ind       as integer   no-undo initial 1 .
     3930     define variable v-file-name as character no-undo .
     3931     run rep/r-obrt11.p
     3932                    ( input RADIO-Nomenkl
     3933                    , input Tog-obj
     3934                    , input name-tov
     3935                    , input no-nds
     3936                    , input RADIO-AltObj
     3937                    , input AltObj-list
     3938                    , input sys-key
     3939                    , input prod-zen
     3940                    , input ShowZero
     3941                    , input ShowZero-2
     3942                    , input-output table gds-prop
     3943                    , input-output table o_temp-parts) .
     3944   if session :set-wait-state( "compiler" ) then.
     3945     assign
     3946       make-excel = yes
     3947       v-file-name = string(session :temp-directory) + "rpt" + string( g#report-num ) + ".txt"
     3948     .
     3949     output stream macr_excel to value(v-file-name) .
     3950     assign v-ind = v-ind + 1 .
     3951     case print-o :
     3952       when "A3-lansc":U then
     3953   output stream OutStream to value( string( session:temp-directory +
     3954                                        "rpt" + string( g#report-num ) ) )
     3955                                        page-size  value(62) .
     3956       when "A4-lansc":U then
     3957   output stream OutStream to value( string( session:temp-directory +
     3958                                        "rpt" + string( g#report-num ) ) )
     3959                                        page-size  value(43) .
     3960       when "A4-port":U  then
     3961   output stream OutStream to value( string( session:temp-directory +
     3962                                        "rpt" + string( g#report-num ) ) )
     3963                                        page-size  value(62) .
     3964       when "to-file":U  then
     3965   output stream OutStream to value( string( session:temp-directory +
     3966                                        "rpt" + string( g#report-num ) ) )
     3967                                        page-size  value(62) .
     3968     end case .
     3969     run PrintTitul in this-procedure .
     3970     run PutColumnTitul in this-procedure .
     3971     run PutColumnTitulExcel in this-procedure .
     3972     if ExportZUM then do:
     3973       output stream txt-file to value(string(session :temp-directory) + "rpz" + string( g#report-num ) + ".txt").
     3974       run rep/r-ob2-ex.p (input tog-obj,input RADIO-AltObj,input no, output CurrGrpName) .
     3975       put stream txt-file ReportNAme format "X(80)"  chr(10) .
     3976       define variable ss1 as character no-undo .
     3977       assign  ss1 = 'X(' + string(length (CurrGrpName)) + ')' .
     3978       put stream txt-file CurrGrpName format ss1 chr(10) .
     3979     end.
     3980     for each gds-sum :
     3981       delete gds-sum .
     3982     end.
     3983     create gds-sum .
     3984     assign gds-sum.num = 1 .
     3985     case classify:
     3986       when "no-classify":u    then do:
     3987         run foreach1 in this-procedure.
     3988       end.
     3989       when "prod":u then do:
     3990         Run Foreach2 in this-procedure.
     3991       end.
     3992       when "grp-goods":u then do:
     3993         Run Foreach3 in this-procedure.
     3994       end.
     3995       when "prod/grp-goods":u then do:
     3996         Run Foreach4 in this-procedure.
     3997       end.
     3998       when "grp-goods/prod":u then do:
     3999         Run Foreach5 in this-procedure.
     4000       end.
     4001       when "vat-ps":u then do:
     4002         Run Foreach6 in this-procedure.
     4003       end.
     4004     end case.
     4005     if ExportZUM then do:
     4006       output stream txt-file close.
     4007     end.
     4008     output stream macr_excel close .
     4009     run paramls-write in this-procedure (input "file",input string(v-ind),input v-file-name) .
     4010     HIDE stream OutStream FRAME BottomFrame .
     4011     OUTPUT stream OutStream CLOSE.
     4012     run end-proc .
     4013   if session :set-wait-state( "" ) then.
     4014     define variable disop as integer   no-undo .
     4015     case print-o :
     4016       when "A3-lansc":U then assign disop = 8.
     4017       when "A4-lansc":U then assign disop = 8.
     4018       when "A4-port":U then  assign disop = 0.
     4019       when "to-file":U then do:
     4020         if beg > 550 then assign disop = 3.
     4021         else              assign disop = 1.
     4022       end.
     4023     end.
     4024     define variable v-user-action as character no-undo .
     4025     define variable v-printed as logical   no-undo .
     4026     if sys-key = "parts" then do:
     4027        run rep/runexcel.p (string( session:temp-directory) + "rpt" + string( g#report-num ) + ".txt").
     4028     end.
     4029     else do:
     4030       run gbl/prnfilen.w
     4031         (input  ""
     4032         ,input  disop
     4033         ,input  string(session :temp-directory) + "rpt" + string( g#report-num )
     4034         ,input 7
     4035         ,output v-user-action
     4036         ,output v-printed
     4037         ) .
     4038     end.
     4039   end.
     4040   procedure end-proc :
     4041    do
     4042    on error undo, return error return-value
     4043    :
     4044     v-file-name = ( string( session:temp-directory + "rpt" + string( g#report-num ) ) + ".t-t").
     4045     OUTPUT to VALUE (v-file-name) .
