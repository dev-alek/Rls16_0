     6223   procedure CheckNullOborot :
     6224     do
     6225     on error undo, return error return-value
     6226     :
     6227     if line-counter( Outstream ) + 5 > page-size( Outstream ) then do:
     6228       put stream outstream  skip Line format frmt skip "продолжение - на следующей странице" AT 30 SKIP .
     6229       page stream OutStream .
     6230       run PutColumnTitul in this-procedure .
     6231     end.
     6232     if  ( v-row ) >= 63000 then do:
     6233       Output stream Macr_Excel  close .
     6234       run paramls-write in this-procedure (input "file",input string(v-ind),input v-file-name ) .
     6235       run gbl/_tmpfile.p ("wb", ".txt", output v-file-name) .
     6236       output stream  Macr_Excel to value(v-file-name) .
     6237       v-ind = v-ind + 1 .
     6238       run PutColumnTitulExcel in this-procedure .
     6239     end.
     6240     assign
     6241       NullStr = 0
     6242     .
     6243     define variable null-ost as integer initial 0 no-undo .
     6244     if ShowZero = no then do:
     6245       if use-column[12] = yes or use-column[13] = yes or use-column[31] = yes or use-column[32] = yes or use-column[50] = yes or use-column[51] = yes then do:
     6246         if ( gds-prop.StartWay-Qnty = 0    or gds-prop.StartWay-Qnty = ? )    and
     6247            ( gds-prop.StartWay-CostSum = 0 or gds-prop.StartWay-CostSum = ? ) and
     6248            ( gds-prop.StartWay-SaleSum = 0 or gds-prop.StartWay-SaleSum = ? ) and
     6249            ( gds-prop.EndWay-Qnty = 0    or gds-prop.EndWay-Qnty = ? )        and
     6250            ( gds-prop.EndWay-CostSum = 0 or gds-prop.EndWay-CostSum = ? )     and
     6251            ( gds-prop.EndWay-SaleSum = 0 or gds-prop.EndWay-SaleSum = ? )
     6252          then assign null-ost = 1 .
     6253       end.
     6254     end.
     6255       if (( gds-prop.EndWay-Qnty - gds-prop.StartWay-Qnty ) = 0 )    and
     6256          ( gds-prop.InExt-Qnty           = 0 or gds-prop.InExt-Qnty = ? )    and
     6257          ( gds-prop.InExt-CostSum        = 0 or gds-prop.InExt-CostSum = ? ) and
     6258          ( gds-prop.RetPost-Qnty         = 0 or gds-prop.RetPost-Qnty = ? ) and
     6259          ( gds-prop.RetPost-CostSum      = 0 or gds-prop.RetPost-CostSum = ? )      and
     6260          ( gds-prop.OutExt-Qnty          = 0 or gds-prop.OutExt-Qnty = ? )   and
     6261          ( gds-prop.OutExt-CostSum       = 0 or gds-prop.OutExt-CostSum = ? ) and
     6262          ( gds-prop.OutExt-SaleSum       = 0 or gds-prop.OutExt-SaleSum = ? ) and
     6263          ( gds-prop.OutExt-DiscntSum     = 0 or gds-prop.OutExt-DiscntSum = ? )      and
     6264          ( gds-prop.RetOut-Qnty          = 0 or gds-prop.RetOut-Qnty = ? )   and
     6265          ( gds-prop.RetOut-CostSum       = 0 or gds-prop.RetOut-CostSum = ? ) and
     6266          ( gds-prop.RetOut-SaleSum       = 0 or gds-prop.RetOut-SaleSum = ? ) and
     6267          ( gds-prop.RetOut-DiscntSum     = 0 or gds-prop.RetOut-DiscntSum = ? )      and
     6268          ( gds-prop.OutExtKass-Qnty      = 0 or gds-prop.OutExtKass-Qnty = ? )   and
     6269          ( gds-prop.OutExtKass-CostSum   = 0 or gds-prop.OutExtKass-CostSum = ? ) and
     6270          ( gds-prop.OutExtKass-SaleSum   = 0 or gds-prop.OutExtKass-SaleSum = ? ) and
     6271          ( gds-prop.OutExtKass-DiscntSum = 0 or gds-prop.OutExtKass-DiscntSum = ? )      and
     6272          ( gds-prop.RetOutKass-Qnty      = 0 or gds-prop.RetOutKass-Qnty = ? )   and
     6273          ( gds-prop.RetOutKass-CostSum   = 0 or gds-prop.RetOutKass-CostSum = ? ) and
     6274          ( gds-prop.RetOutKass-SaleSum   = 0 or gds-prop.RetOutKass-SaleSum = ? ) and
     6275          ( gds-prop.RetOutKass-DiscntSum = 0 or gds-prop.RetOutKass-DiscntSum = ? )      and
     6276          ( gds-prop.Inv-Qnty             = 0 or gds-prop.Inv-Qnty = ? )   and
     6277          ( gds-prop.Inv-CostSum          = 0 or gds-prop.Inv-CostSum = ? ) and
     6278          ( gds-prop.Inv-SaleSum          = 0 or gds-prop.Inv-SaleSum = ? ) and
     6279          ( gds-prop.Spi-Qnty             = 0 or gds-prop.Spi-Qnty = ? )      and
     6280          ( gds-prop.Spi-CostSum          = 0 or gds-prop.Spi-CostSum = ? )   and
     6281          ( gds-prop.Spi-SaleSum          = 0 or gds-prop.Spi-SaleSum = ? ) and
     6282          ( gds-prop.InInt-Qnty           = 0 or gds-prop.InInt-Qnty = ? )      and
     6283          ( gds-prop.InInt-CostSum        = 0 or gds-prop.InInt-CostSum = ? )   and
     6284          ( gds-prop.InInt-SaleSum        = 0 or gds-prop.InInt-SaleSum = ? ) and
     6285          ( gds-prop.OutInt-Qnty          = 0 or gds-prop.OutInt-Qnty = ? )      and
     6286          ( gds-prop.OutInt-CostSum       = 0 or gds-prop.OutInt-CostSum = ? )   and
     6287          ( gds-prop.OutInt-SaleSum       = 0 or gds-prop.OutInt-SaleSum = ? ) and
     6288          ( gds-prop.RetInt-Qnty          = 0 or gds-prop.RetInt-Qnty = ? )      and
     6289          ( gds-prop.RetInt-CostSum       = 0 or gds-prop.RetInt-CostSum = ? )   and
     6290          ( gds-prop.RetInt-SaleSum       = 0 or gds-prop.RetInt-SaleSum = ? ) and
     6291          ( gds-prop.InProiz-Qnty         = 0 or gds-prop.InProiz-Qnty = ? )      and
     6292          ( gds-prop.InProiz-CostSum      = 0 or gds-prop.InProiz-CostSum = ? )   and
     6293          ( gds-prop.InProiz-SaleSum      = 0 or gds-prop.InProiz-SaleSum = ? ) and
     6294          ( gds-prop.OutProiz-Qnty        = 0 or gds-prop.OutProiz-Qnty = ? )      and
     6295          ( gds-prop.OutProiz-CostSum     = 0 or gds-prop.OutProiz-CostSum = ? )   and
     6296          ( gds-prop.OutProiz-SaleSum     = 0 or gds-prop.OutProiz-SaleSum = ? )
     6297         then do:
     6298           if null-ost = 0 then do:
     6299             if ShowZero-2 = no then NullStr = 1 .
     6300           end.
     6301           else do:
     6302             NullStr = 2 .
     6303           end.
     6304         end.
     6305       end.
     6306   end procedure.
     6307   PROCEDURE PutColumnTitul :
     6308     put stream outstream  skip
     6309       string( "Дата печати :" ) AT 5 format "x(15)" TODAY format "99.99.9999"
     6310       string( " , " ) format "X(3)" string(TIME, "HH:MM")
     6311       string( "Страница" ) AT 45 PAGE-NUMBER( outstream ) AT 55 FORMAT ">>>>9" SKIP
     6312      Line format frmt skip .
     6313     for each line-frm :
     6314       put stream outstream  "|" at line-frm.beg  line-frm.titul format line-frm.frmt .
     6315     end.
     6316     put stream outstream    "|" skip .
     6317     for each line-frm :
     6318       put stream outstream  "|" at line-frm.beg  line-frm.titul1 format line-frm.frmt .
     6319     end.
     6320     put stream outstream    "|" skip .
     6321     for each line-frm :
     6322       put stream outstream  "|" at line-frm.beg  line-frm.titul2 format line-frm.frmt .
     6323     end.
     6324     put stream outstream    "|"  skip  Line format frmt skip .
     6325   END PROCEDURE.
     6326   procedure PutItogSum :
     6327     define input  parameter p-num as integer   no-undo .
     6328     define buffer buf_gds-sum for gds-sum .
     6329     if p-num = 2 then do:
     6330        if available obj-list then assign ItogStr = "Итого по объекту " + obj-list.obj-name + " (" + obj-list.obj-type + '#' + string(obj-list.obj-code) + ") :" .
     6331        else assign ItogStr = "" .
     6332     end.
     6333     else if p-num = 1 then assign  ItogStr = "ИТОГО: " .
     6334     find first buf_gds-sum where buf_gds-sum.num = p-num no-error .
     6335     if buf_gds-sum.StartWay-Qnty  <> 0 or buf_gds-sum.StartWay-CostSum <> 0 or buf_gds-sum.StartWay-SaleSum <> 0 or buf_gds-sum.EndWay-Qnty   <> 0 or
     6336        buf_gds-sum.EndWay-CostSum <> 0 or buf_gds-sum.EndWay-SaleSum   <> 0 or buf_gds-sum.InExt-Qnty       <> 0 or buf_gds-sum.InExt-CostSum <> 0 or
     6337        buf_gds-sum.RetPost-Qnty   <> 0 or buf_gds-sum.RetPost-CostSum  <> 0 or buf_gds-sum.OutExt-Qnty      <> 0 or buf_gds-sum.OutExt-CostSum <> 0 or
     6338        buf_gds-sum.OutExt-SaleSum <> 0 or buf_gds-sum.OutExt-DiscntSum <> 0 or buf_gds-sum.RetOut-Qnty      <> 0 or buf_gds-sum.RetOut-CostSum <> 0 or
     6339        buf_gds-sum.RetOut-SaleSum <> 0 or buf_gds-sum.RetOut-DiscntSum <> 0 or buf_gds-sum.OutExtKass-Qnty  <> 0 or buf_gds-sum.OutExtKass-CostSum  <> 0 or
     6340        buf_gds-sum.OutExtKass-SaleSum <> 0 or buf_gds-sum.OutExtKass-DiscntSum <> 0 or buf_gds-sum.RetOutKass-Qnty <> 0 or buf_gds-sum.RetOutKass-CostSum <> 0 or
     6341        buf_gds-sum.RetOutKass-SaleSum <> 0 or buf_gds-sum.RetOutKass-DiscntSum <> 0 or buf_gds-sum.InInt-Qnty      <> 0 or buf_gds-sum.InInt-CostSum      <> 0 or
     6342        buf_gds-sum.InInt-SaleSum      <> 0 or buf_gds-sum.OutInt-Qnty          <> 0 or buf_gds-sum.OutInt-CostSum  <> 0 or buf_gds-sum.OutInt-SaleSum     <> 0 or
     6343        buf_gds-sum.RetInt-Qnty        <> 0 or buf_gds-sum.RetInt-CostSum       <> 0 or buf_gds-sum.RetInt-SaleSum  <> 0 or buf_gds-sum.Inv-Qnty           <> 0 or
     6344        buf_gds-sum.Inv-CostSum        <> 0 or buf_gds-sum.Inv-SaleSum          <> 0 or buf_gds-sum.Spi-Qnty        <> 0 or buf_gds-sum.Spi-CostSum        <> 0 or
     6345        buf_gds-sum.Spi-SaleSum        <> 0 or buf_gds-sum.InProiz-Qnty         <> 0 or buf_gds-sum.InProiz-CostSum <> 0 or buf_gds-sum.InProiz-SaleSum    <> 0 or
     6346        buf_gds-sum.OutProiz-Qnty      <> 0 or buf_gds-sum.OutProiz-CostSum     <> 0 or buf_gds-sum.OutProiz-SaleSum <> 0 or buf_gds-sum.Per-SaleSum       <> 0 or
     6347        buf_gds-sum.Free-Qnty          <> 0 or buf_gds-sum.Res-Qnty             <> 0
     6348     then do:
     6349       run PutTitul in this-procedure .
     6350       if p-num = 4 and SumsOnly then do:
     6351         if var-client <> "" then do:
     6352           run macr_excel_char (var-client, v-row, 1) .
     6353           assign v-row = v-row + 1 .
     6354           PUT stream OutStream "| " var-client format "X(60)" "|" at beg  SKIP .
     6355           assign  var-client = "" .
     6356         end.
     6357       end.
     6358         assign v-col = 1 .
     6359         run macr_excel_char (ItogStr, v-row, v-col) .
     6360         if use-column[1]  = yes then assign v-col = v-col + 1 .
     6361         if use-column[2]  = yes then assign v-col = v-col + 1 .
     6362         if use-column[3]  = yes then assign v-col = v-col + 1 .
     6363         if use-column[4]  = yes then assign v-col = v-col + 1 .
     6364         if use-column[5]  = yes then assign v-col = v-col + 1 .
     6365         if use-column[6]  = yes then assign v-col = v-col + 1 .
     6366         if use-column[7]  = yes then assign v-col = v-col + 1 .
     6367         if use-column[8]  = yes then assign v-col = v-col + 1 .
     6368         if use-column[9]  = yes then assign v-col = v-col + 1 .
     6369         if use-column[12] = yes then  do: run macr_excel_sum ( buf_gds-sum.StartWay-Qnty, v-row, v-col, sz-qnty) . assign v-col = v-col + 1 . end.
     6370         if use-column[31] = yes then  do: run macr_excel_sum ( buf_gds-sum.StartWay-CostSum, v-row, v-col, 2) . assign v-col = v-col + 1 . end.
     6371         if use-column[50] = yes then  do: run macr_excel_sum ( buf_gds-sum.StartWay-SaleSum, v-row, v-col, 2) . assign v-col = v-col + 1 . end.
     6372         if use-column[14] = yes then  do: run macr_excel_sum ( buf_gds-sum.InExt-Qnty, v-row, v-col, sz-qnty) . assign v-col = v-col + 1 . end.
     6373         if use-column[33] = yes then  do: run macr_excel_sum ( buf_gds-sum.InExt-CostSum, v-row, v-col, 2) . assign v-col = v-col + 1 . end.
     6374         if use-column[15] = yes then  do: run macr_excel_sum ( buf_gds-sum.RetPost-Qnty, v-row, v-col, sz-qnty) . assign v-col = v-col + 1 . end.
     6375         if use-column[34] = yes then  do: run macr_excel_sum ( buf_gds-sum.RetPost-CostSum, v-row, v-col, 2) . assign v-col = v-col + 1 . end.
     6376         if use-column[16] = yes then  do: run macr_excel_sum ( buf_gds-sum.OutExt-Qnty, v-row, v-col, sz-qnty) . assign v-col = v-col + 1 . end.
     6377         if use-column[35] = yes then  do: run macr_excel_sum ( buf_gds-sum.OutExt-CostSum, v-row, v-col, 2) . assign v-col = v-col + 1 . end.
     6378         if use-column[52] = yes then  do: run macr_excel_sum ( buf_gds-sum.OutExt-SaleSum, v-row, v-col, 2) . assign v-col = v-col + 1 . end.
     6379         if use-column[68] = yes then  do: run macr_excel_sum ( buf_gds-sum.OutExt-DiscntSum, v-row, v-col, 2) . assign v-col = v-col + 1 . end.
     6380         if use-column[77] = yes then  do: run macr_excel_sum ( buf_gds-sum.OutExt-DiscntSum * 100 / buf_gds-sum.OutExt-SaleSum, v-row, v-col, 2) . assign v-col = v-col + 1 . end.
     6381         if use-column[17] = yes then  do: run macr_excel_sum ( buf_gds-sum.RetOut-Qnty, v-row, v-col, sz-qnty) . assign v-col = v-col + 1 . end.
     6382         if use-column[36] = yes then  do: run macr_excel_sum ( buf_gds-sum.RetOut-CostSum, v-row, v-col, 2) . assign v-col = v-col + 1 . end.
     6383         if use-column[53] = yes then  do: run macr_excel_sum ( buf_gds-sum.RetOut-SaleSum, v-row, v-col, 2) . assign v-col = v-col + 1 . end.
     6384         if use-column[69] = yes then  do: run macr_excel_sum ( buf_gds-sum.RetOut-DiscntSum, v-row, v-col, 2) . assign v-col = v-col + 1 . end.
     6385         if use-column[78] = yes then  do: run macr_excel_sum ( buf_gds-sum.RetOut-DiscntSum * 100 / buf_gds-sum.RetOut-SaleSum, v-row, v-col, 2) . assign v-col = v-col + 1 . end.
     6386         if use-column[18] = yes then  do: run macr_excel_sum ( buf_gds-sum.OutExt-Qnty    - buf_gds-sum.RetOut-Qnty, v-row, v-col, sz-qnty) . assign v-col = v-col + 1 . end.
     6387         if use-column[37] = yes then  do: run macr_excel_sum ( buf_gds-sum.OutExt-CostSum - buf_gds-sum.RetOut-CostSum, v-row, v-col, 2) . assign v-col = v-col + 1 . end.
     6388         if use-column[54] = yes then  do: run macr_excel_sum ( buf_gds-sum.OutExt-SaleSum - buf_gds-sum.RetOut-SaleSum - (buf_gds-sum.OutExt-DiscntSum - buf_gds-sum.RetOut-DiscntSum), v-row, v-col, 2) . assign v-col = v-col + 1 . end.
     6389         if use-column[70] = yes then  do: run macr_excel_sum ( buf_gds-sum.OutExt-DiscntSum - buf_gds-sum.RetOut-DiscntSum, v-row, v-col, 2) . assign v-col = v-col + 1 . end.
     6390         if use-column[79] = yes then  do: run macr_excel_sum ( ( buf_gds-sum.OutExt-DiscntSum - buf_gds-sum.RetOut-DiscntSum ) * 100 / ( buf_gds-sum.OutExt-SaleSum - buf_gds-sum.RetOut-SaleSum ), v-row, v-col, 2) . assign v-col = v-col + 1 . end.
     6391         if use-column[19] = yes then  do: run macr_excel_sum ( buf_gds-sum.OutExtKass-Qnty, v-row, v-col, sz-qnty) . assign v-col = v-col + 1 . end.
     6392         if use-column[38] = yes then  do: run macr_excel_sum ( buf_gds-sum.OutExtKass-CostSum, v-row, v-col, 2) . assign v-col = v-col + 1 . end.
     6393         if use-column[55] = yes then  do: run macr_excel_sum ( buf_gds-sum.OutExtKass-SaleSum, v-row, v-col, 2) . assign v-col = v-col + 1 . end.
     6394         if use-column[71] = yes then  do: run macr_excel_sum ( buf_gds-sum.OutExtKass-DiscntSum, v-row, v-col, 2) . assign v-col = v-col + 1 . end.
     6395         if use-column[80] = yes then  do: run macr_excel_sum ( buf_gds-sum.OutExtKass-DiscntSum * 100 / buf_gds-sum.OutExtKass-SaleSum, v-row, v-col, 2) . assign v-col = v-col + 1 . end.
     6396         if use-column[20] = yes then  do: run macr_excel_sum ( buf_gds-sum.RetOutKass-Qnty, v-row, v-col, sz-qnty) . assign v-col = v-col + 1 . end.
     6397         if use-column[39] = yes then  do: run macr_excel_sum ( buf_gds-sum.RetOutKass-CostSum, v-row, v-col, 2) . assign v-col = v-col + 1 . end.
     6398         if use-column[56] = yes then  do: run macr_excel_sum ( buf_gds-sum.RetOutKass-SaleSum, v-row, v-col, 2) . assign v-col = v-col + 1 . end.
     6399         if use-column[72] = yes then  do: run macr_excel_sum ( buf_gds-sum.RetOutKass-DiscntSum, v-row, v-col, 2) . assign v-col = v-col + 1 . end.
     6400         if use-column[81] = yes then  do: run macr_excel_sum ( buf_gds-sum.RetOutKass-DiscntSum * 100 / buf_gds-sum.RetOutKass-SaleSum, v-row, v-col, 2) . assign v-col = v-col + 1 . end.
     6401         if use-column[21] = yes then  do: run macr_excel_sum ( buf_gds-sum.OutExtKass-Qnty    - buf_gds-sum.RetOutKass-Qnty , v-row, v-col, sz-qnty) . assign v-col = v-col + 1 . end.
     6402         if use-column[40] = yes then  do: run macr_excel_sum ( buf_gds-sum.OutExtKass-CostSum - buf_gds-sum.RetOutKass-CostSum, v-row, v-col, 2) . assign v-col = v-col + 1 . end.
     6403         if use-column[57] = yes then  do: run macr_excel_sum ( buf_gds-sum.OutExtKass-SaleSum - buf_gds-sum.RetOutKass-SaleSum - (buf_gds-sum.OutExtKass-DiscntSum - buf_gds-sum.RetOutKass-DiscntSum), v-row, v-col, 2) . assign v-col = v-col + 1 . end.
     6404         if use-column[73] = yes then  do: run macr_excel_sum ( buf_gds-sum.OutExtKass-DiscntSum - buf_gds-sum.RetOutKass-DiscntSum, v-row, v-col, 2) . assign v-col = v-col + 1 . end.
     6405         if use-column[82] = yes then  do: run macr_excel_sum ( ( buf_gds-sum.OutExtKass-DiscntSum - buf_gds-sum.RetOutKass-DiscntSum ) * 100 / ( buf_gds-sum.OutExtKass-SaleSum - buf_gds-sum.RetOutKass-SaleSum ), v-row, v-col, 2) . assign v-col = v-col + 1 . end.
     6406         if use-column[22] = yes then  do: run macr_excel_sum ( buf_gds-sum.OutExt-Qnty      + buf_gds-sum.OutExtKass-Qnty, v-row, v-col, sz-qnty) . assign v-col = v-col + 1 . end.
     6407         if use-column[41] = yes then  do: run macr_excel_sum ( buf_gds-sum.OutExt-CostSum   + buf_gds-sum.OutExtKass-CostSum, v-row, v-col, 2) . assign v-col = v-col + 1 . end.
     6408         if use-column[58] = yes then  do: run macr_excel_sum ( buf_gds-sum.OutExt-SaleSum   + buf_gds-sum.OutExtKass-SaleSum, v-row, v-col, 2) . assign v-col = v-col + 1 . end.
     6409         if use-column[74] = yes then  do: run macr_excel_sum ( buf_gds-sum.OutExt-DiscntSum + buf_gds-sum.OutExtKass-DiscntSum, v-row, v-col, 2) . assign v-col = v-col + 1 . end.
     6410         if use-column[83] = yes then  do: run macr_excel_sum ( ( buf_gds-sum.OutExt-DiscntSum + buf_gds-sum.OutExtKass-DiscntSum ) * 100 / ( buf_gds-sum.OutExt-SaleSum + buf_gds-sum.OutExtKass-SaleSum ) , v-row, v-col, 2) . assign v-col = v-col + 1 . end.
     6411         if use-column[23] = yes then  do: run macr_excel_sum ( buf_gds-sum.RetOut-Qnty      + buf_gds-sum.RetOutKass-Qnty, v-row, v-col, sz-qnty) . assign v-col = v-col + 1 . end.
     6412         if use-column[42] = yes then  do: run macr_excel_sum ( buf_gds-sum.RetOut-CostSum   + buf_gds-sum.RetOutKass-CostSum, v-row, v-col, 2) . assign v-col = v-col + 1 . end.
     6413         if use-column[59] = yes then  do: run macr_excel_sum ( buf_gds-sum.RetOut-SaleSum   + buf_gds-sum.RetOutKass-SaleSum, v-row, v-col, 2) . assign v-col = v-col + 1 . end.
     6414         if use-column[75] = yes then  do: run macr_excel_sum ( buf_gds-sum.RetOut-DiscntSum + buf_gds-sum.RetOutKass-DiscntSum, v-row, v-col, 2) . assign v-col = v-col + 1 . end.
     6415         if use-column[84] = yes then  do: run macr_excel_sum ( ( buf_gds-sum.RetOut-DiscntSum + buf_gds-sum.RetOutKass-DiscntSum  ) * 100 / ( buf_gds-sum.RetOut-SaleSum + buf_gds-sum.RetOutKass-SaleSum ), v-row, v-col, 2) . assign v-col = v-col + 1 . end.
     6416         if use-column[24] = yes then  do: run macr_excel_sum ( buf_gds-sum.OutExt-Qnty    - buf_gds-sum.RetOut-Qnty + buf_gds-sum.OutExtKass-Qnty - buf_gds-sum.RetOutKass-Qnty, v-row, v-col, sz-qnty) . assign v-col = v-col + 1 . end.
     6417         if use-column[43] = yes then  do: run macr_excel_sum ( buf_gds-sum.OutExt-CostSum - buf_gds-sum.RetOut-CostSum + buf_gds-sum.OutExtKass-CostSum - buf_gds-sum.RetOutKass-CostSum, v-row, v-col, 2) . assign v-col = v-col + 1 . end.
     6418         if use-column[60] = yes then  do: run macr_excel_sum ( buf_gds-sum.OutExt-SaleSum - buf_gds-sum.RetOut-SaleSum + buf_gds-sum.OutExtKass-SaleSum - buf_gds-sum.RetOutKass-SaleSum - ( buf_gds-sum.OutExt-DiscntSum - buf_gds-sum.RetOut-DiscntSum + buf_gds-sum.OutExtKass-DiscntSum - buf_gds-sum.RetOutKass-DiscntSum), v-row, v-col, 2) . assign v-col = v-col + 1 . end.
     6419         if use-column[76] = yes then  do: run macr_excel_sum ( buf_gds-sum.OutExt-DiscntSum - buf_gds-sum.RetOut-DiscntSum + buf_gds-sum.OutExtKass-DiscntSum - buf_gds-sum.RetOutKass-DiscntSum, v-row, v-col, 2) . assign v-col = v-col + 1 . end.
     6420         if use-column[85] = yes then  do: run macr_excel_sum ( ( buf_gds-sum.OutExt-DiscntSum - buf_gds-sum.RetOut-DiscntSum + buf_gds-sum.OutExtKass-DiscntSum - buf_gds-sum.RetOutKass-DiscntSum ) * 100 / ( buf_gds-sum.OutExt-SaleSum - buf_gds-sum.RetOut-SaleSum + buf_gds-sum.OutExtKass-SaleSum - buf_gds-sum.RetOutKass-SaleSum  ), v-row, v-col, 2) . assign v-col = v-col + 1 . end.
     6421         if use-column[25] = yes then  do: run macr_excel_sum ( buf_gds-sum.Inv-Qnty, v-row, v-col, sz-qnty) . assign v-col = v-col + 1 . end.
