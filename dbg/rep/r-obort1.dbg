      582   define new global shared variable g#library  as handle no-undo .
      583   define new global shared variable g#library2 as handle no-undo .
      584   define variable var-report-r-b as character no-undo .
      585   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      586   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      587     (output var-report-r-b
      588     )  .
      589   define variable vss-include-info7 as character format "X(65)" no-undo
      590   initial "@(#)$Workfile$ $Revision$".
      591   define temp-table temp_grplib_grp no-undo
      592       field sel           as character
      593       field nabor         as character
      594       field full-name     as character
      595       field print-code    as character
      596       field sort-name     as character
      597       field node-code     as integer
      598       field upper-code    as integer
      599       field calc-method   as character
      600       field round-method  as character
      601       field increase-pc   as decimal
      602       field min-marg      as character
      603       field max-marg      as character
      604       field cli-type      as character
      605       field cli-code      as integer
      606       field notcorr      as character
      607       field name          as character
      608       field level         as integer
      609       field mark          as character
      610       index pi is primary unique sort-name
      611       index fn full-name
      612       index nc is unique node-code
      613       index sl sel
      614       index uc upper-code
      615   .
      616   define temp-table temp_grplib_found-grp no-undo
      617       field full-name   as character
      618       field sort-name   as character
      619       field node-code   as integer
      620       field level       as integer
      621       field is-terminal as logical
      622       index pi is primary unique sort-name
      623       index fn full-name
      624       index lv level
      625       index it is-terminal
      626   .
      627   define temp-table temp_found-result-nodelist no-undo
      628       field node-code     as recid
      629       field processed     as logical
      630       field sort-name     as character
      631       field full-name     as character
      632       index pi is primary unique node-code
      633       index ps processed
      634   .
      635   define variable v-grplib-not-fill-extra-info        as logical      no-undo.
      636   define variable v-grplib-no-warning-grp-amount      as logical      no-undo.
      637   define variable v-grplib-grp-amount-for-load        as integer      no-undo.
      638   procedure grplib-get-parameters :
      639   define input parameter p-store-type     as character        no-undo.
      640   define input parameter p-store-code     as integer          no-undo.
      641   do
      642   on error undo, return error
      643   :
      644       assign
      645           v-grplib-not-fill-extra-info = no
      646       .
      647   end.
      648   end procedure.
      649   procedure grplib-get-sort-name :
      650   do
      651   on error undo, return error
      652   :
      653   define input parameter p-node-code  as integer      no-undo.
      654   define output parameter p-sort-name as character    no-undo.
      655       define variable v-upper-code    as integer           no-undo.
      656       define buffer buf_gds-grp       for ub.gds-grp.
      657       define buffer buf_upper_gds-grp for ub.gds-grp.
      658       find first buf_gds-grp no-lock
      659            where buf_gds-grp.node-code = p-node-code
      660       no-error.
      661       if not available buf_gds-grp
      662       then do:
      663           undo, return error "grplib-get-sort-name: Не найдена группа товаров с кодом " + string( p-node-code ).
      664       end.
      665       assign
      666           p-sort-name  = ""
      667           v-upper-code = 1
      668       .
      669       do while buf_gds-grp.upper-code <> 0
      670       on error undo, return error "grplib-get-sort-name: Ошибка составления полного имени группы"
      671       :
      672           assign
      673               p-sort-name  = buf_gds-grp.node-name
      674                            + (if p-sort-name <> "" then chr(2) else "")
      675                            + p-sort-name
      676               v-upper-code = buf_gds-grp.upper-code
      677           .
      678           find first buf_gds-grp no-lock
      679                where buf_gds-grp.node-code = v-upper-code
      680           no-error.
      681           if not available buf_gds-grp
      682           then do:
      683               undo, return error "grplib-get-sort-name: Не найдена группа товаров с кодом "
      684                                   + string( v-upper-code )
      685                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      686           end.
      687       end.
      688   end.
      689   end procedure.
      690   define variable vss-include-info8 as character format "X(65)" no-undo
      691   initial "@(#)$Workfile$ $Revision$".
      692   procedure grplib-get-full-name :
      693      define input parameter p-node-code  as integer      no-undo.
      694      define output parameter p-full-name as character    no-undo.
      695      do
      696   on error undo, return error
      697   :
      698       define variable v-upper-code    as integer           no-undo.
      699       define buffer buf_gds-grp       for ub.gds-grp.
      700       define buffer buf_upper_gds-grp for ub.gds-grp.
      701       find first buf_gds-grp no-lock
      702            where buf_gds-grp.node-code = p-node-code
      703       no-error.
      704       if not available buf_gds-grp
      705       then do:
      706           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
      707       end.
      708       assign
      709           p-full-name  = ""
      710           v-upper-code = 1
      711       .
      712       do while buf_gds-grp.upper-code <> 0
      713       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
      714       :
      715           assign
      716               p-full-name  = buf_gds-grp.node-name
      717                            + (if p-full-name <> "" then chr(47) else "")
      718                            + p-full-name
      719               v-upper-code = buf_gds-grp.upper-code
      720           .
      721           find first buf_gds-grp no-lock
      722                where buf_gds-grp.node-code = v-upper-code
      723           no-error.
      724           if not available buf_gds-grp
      725           then do:
      726               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
      727                                   + string( v-upper-code )
      728                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      729           end.
      730       end.
      731       assign
      732       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
      733       .
      734   end.
      735   end .
      736   procedure grplib-get-node-from-full-name :
      737   define input parameter p-full-name as character no-undo .
      738   define output parameter p-node-code as integer no-undo .
      739   define variable v-ii as integer no-undo .
      740   define variable v-upper-code as integer no-undo .
      741   define variable v-root-code as integer no-undo .
      742   define variable v-entry as character no-undo .
      743   define buffer buf_gds-grp       for ub.gds-grp.
      744   do
      745   on error undo, return error
      746   :
      747     find first buf_gds-grp no-lock
      748         where buf_gds-grp.upper-code = 0
      749     no-error .
      750     if not available buf_gds-grp
      751     then do:
      752         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
      753     end.
      754     else do:
      755       assign
      756       v-root-code = buf_gds-grp.node-code
      757       .
      758     end.
      759     v-upper-code = v-root-code.
      760     do v-ii = 1 to num-entries(p-full-name, chr(47)):
      761       assign
      762       v-entry = entry(v-ii, p-full-name, chr(47)).
      763       if v-entry = '' then leave.
      764       find first buf_gds-grp no-lock where
      765                 buf_gds-grp.node-name = v-entry
      766             and buf_gds-grp.upper-code = v-upper-code
      767             no-error.
      768       if not available buf_gds-grp then do:
      769         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
      770       end.
      771       else do:
      772         p-node-code = buf_gds-grp.node-code.
      773         v-upper-code = buf_gds-grp.node-code.
      774       end.
      775     end.
      776   end.
      777   end .
      778   procedure grplib-get-root-code :
      779   do
      780   on error undo, return error
      781   :
      782   define output parameter p-root-code as integer      no-undo.
      783       define buffer buf_gds-grp       for ub.gds-grp.
      784       find first buf_gds-grp no-lock
      785           where buf_gds-grp.upper-code = 0
      786       no-error .
      787       if not available buf_gds-grp
      788       then do:
      789           undo, return error .
      790       end.
      791       else do:
      792           assign
      793               p-root-code = buf_gds-grp.node-code
      794           .
      795       end.
      796   end.
      797   end procedure.
      798   procedure grplib-find-grp-by-full-name :
      799   do
      800   on error undo, return error
      801   :
      802   define input parameter p-search-name  as character    no-undo.
      803   define input parameter p-fill-path    as logical      no-undo.
      804   define output parameter p-found       as logical      no-undo.
      805       define variable v-upper-code    as integer          no-undo.
      806       define variable v-counter       as integer           no-undo.
      807       define variable v-level         as integer           no-undo.
      808       define variable v-full-name     as character         no-undo.
      809       define variable v-sort-name     as character         no-undo.
      810       define buffer buf_gds-grp       for ub.gds-grp.
      811       assign
      812           p-search-name = replace( p-search-name, chr(47), chr(2) )
      813       .
      814       run grplib-get-root-code ( output v-upper-code ) no-error .
      815       if error-status :error
      816       then do:
      817           undo, return error "grplib-expand-name: Ошибка при поиске корневого узла".
      818       end.
      819       assign
      820           v-full-name  = ""
      821           v-level      = num-entries( p-search-name, chr(2) )
      822       .
      823       for each temp_grplib_found-grp
      824       :
      825           delete temp_grplib_found-grp.
      826       end.
      827       start-name-analyze:
      828       do v-counter = 1 to v-level
      829       :
      830           if v-counter < v-level
      831           then do:
      832               find first buf_gds-grp no-lock
      833                    where buf_gds-grp.upper-code = v-upper-code
      834                      and buf_gds-grp.node-name  = entry( v-counter, p-search-name, chr(2) )
      835               no-error .
      836               if not available buf_gds-grp
      837               then do:
      838                   assign
      839                       v-full-name  = p-search-name
      840                       v-sort-name  = p-search-name
      841                   .
      842                   return error "grplib-expand-name: не найдена группа " + entry( v-level, p-search-name, chr(2) ).
      843               end.
      844               else do:
      845                   assign
      846                       v-full-name = v-full-name + ( if v-full-name = "" then "" else chr(47) )        + buf_gds-grp.node-name
      847                       v-sort-name = v-sort-name + ( if v-sort-name = "" then "" else chr(2) ) + buf_gds-grp.node-name
      848                       v-upper-code = buf_gds-grp.node-code
      849                   .
      850                   if p-fill-path = yes
      851                   then do:
      852                       create temp_grplib_found-grp.
      853                       assign
      854                           temp_grplib_found-grp.full-name = v-full-name + chr(47)
      855                           temp_grplib_found-grp.sort-name = v-sort-name
      856                           temp_grplib_found-grp.node-code = v-upper-code
      857                           temp_grplib_found-grp.level     = v-counter
      858                       .
      859                   end.
      860               end.
      861           end.
      862           else do:
      863               for each buf_gds-grp no-lock
      864                  where buf_gds-grp.upper-code = v-upper-code
      865                    and buf_gds-grp.node-name begins entry( v-counter, p-search-name, chr(2) )
      866               :
      867                   assign
      868                       p-found = yes
      869                   .
      870                   create temp_grplib_found-grp.
      871                   assign
      872                       temp_grplib_found-grp.full-name = v-full-name
      873                                                           + (if v-full-name = "" then "" else chr(47) )
      874                                                           + buf_gds-grp.node-name + chr(47)
      875                       temp_grplib_found-grp.sort-name = v-sort-name
      876                                                           + ( if v-sort-name = "" then "" else chr(2) )
      877                                                           + buf_gds-grp.node-name
      878                       temp_grplib_found-grp.node-code = buf_gds-grp.node-code
      879                       temp_grplib_found-grp.level     = v-level
      880                   .
      881               end.
      882               if p-found = no
      883               then do:
      884                   assign
      885                       v-full-name  = p-search-name
      886                       v-sort-name  = p-search-name
      887                   .
      888                   for each temp_grplib_found-grp
      889                   :
      890                       delete temp_grplib_found-grp.
      891                   end.
      892                   assign
      893                       p-found = no
      894                   .
      895               end.
      896           end.
      897       end.
      898   end.
      899   end procedure.
      900   procedure grplib-find-all-subgroup :
      901   do
      902   on error undo, return error
      903   :
      904   define input parameter p-start-node-code    as integer      no-undo.
      905   define input parameter p-terminal-only      as logical      no-undo.
      906       define variable v-start-full-name   as character     no-undo.
      907       define variable v-start-sort-name   as character     no-undo.
      908       define variable v-not-found         as logical       no-undo.
      909       define variable v-is-terminal       as logical       no-undo.
      910       define buffer buf_gds-grp           for ub.gds-grp.
      911       create temp_found-result-nodelist.
      912       assign
      913           temp_found-result-nodelist.node-code = p-start-node-code
      914           temp_found-result-nodelist.processed = no
      915       .
      916       run grplib-get-full-name in this-procedure (
      917             input p-start-node-code
      918           , output v-start-full-name
      919       ).
      920       run grplib-get-full-name in this-procedure (
      921             input p-start-node-code
      922           , output v-start-sort-name
      923       ).
      924       process-nodes:
      925       do while yes
      926       :
      927           find first temp_found-result-nodelist
      928                where temp_found-result-nodelist.node-code = p-start-node-code
      929           .
      930           assign
      931               temp_found-result-nodelist.processed = yes
      932           .
      933           for each buf_gds-grp no-lock
      934              where buf_gds-grp.upper-code = p-start-node-code
      935           on error undo, return error
      936           :
      937               run grplib-is-terminal in this-procedure (
      938                     input buf_gds-grp.node-code
      939                   , output v-is-terminal
      940               ).
      941               if v-is-terminal = yes
      942               then do:
      943                   create temp_grplib_found-grp.
      944                   assign
      945                       temp_grplib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
      946                                                           chr(47) + buf_gds-grp.node-name + chr(47)
      947                       temp_grplib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
      948                                                           chr(2) + buf_gds-grp.node-name + chr(2)
      949                       temp_grplib_found-grp.node-code   = buf_gds-grp.node-code
      950                       temp_grplib_found-grp.is-terminal = yes
      951                   .
      952               end.
      953               else do:
      954                   create temp_found-result-nodelist.
      955                   assign
      956                       temp_found-result-nodelist.node-code = buf_gds-grp.node-code
      957                       temp_found-result-nodelist.full-name = right-trim(v-start-full-name, chr(47)) +
      958                                                              chr(47) + buf_gds-grp.node-name + chr(47)
      959                       temp_found-result-nodelist.sort-name = right-trim(v-start-sort-name, chr(2)) +
      960                                                              chr(2) + buf_gds-grp.node-name + chr(2)
      961                       temp_found-result-nodelist.processed = no
      962                   .
      963                   if p-terminal-only = no
      964                   then do:
      965                       create temp_grplib_found-grp.
      966                       assign
      967                           temp_grplib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
      968                                                               chr(47) + buf_gds-grp.node-name + chr(47)
      969                           temp_grplib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
      970                                                               chr(2) + buf_gds-grp.node-name + chr(2)
      971                           temp_grplib_found-grp.node-code   = buf_gds-grp.node-code
      972                           temp_grplib_found-grp.is-terminal = no
      973                       .
      974                   end.
      975               end.
      976           end.
      977           find first temp_found-result-nodelist
      978                where temp_found-result-nodelist.processed = no
      979           no-error.
      980           if not available temp_found-result-nodelist
      981           then do:
      982               leave process-nodes.
      983           end.
      984           else do:
      985               assign
      986                   p-start-node-code = temp_found-result-nodelist.node-code
      987                   v-start-full-name = temp_found-result-nodelist.full-name
      988                   v-start-sort-name = temp_found-result-nodelist.sort-name
      989               .
      990           end.
      991       end.
      992   end.
      993   end procedure.
      994   procedure grplib-expand-name :
      995   define input parameter p-start-name as character        no-undo.
      996   define output parameter p-end-name  as character        no-undo.
      997       define variable v-is-terminal   as logical      no-undo.
      998       define variable v-found         as character    no-undo.
      999       define buffer buf_temp_grplib_found-grp     for temp_grplib_found-grp.
     1000   do
     1001   for buf_temp_grplib_found-grp
     1002   on error undo, return error
     1003   :
     1004       run grplib-find-grp-by-full-name in this-procedure (
     1005             input p-start-name
     1006           , input no
     1007           , output v-found
     1008       ) no-error.
     1009       run grplib-get-max-substring in this-procedure (
     1010                   input length( p-start-name )
     1011                 , output p-end-name
     1012       ) no-error .
     1013       if error-status :error
     1014       then do:
     1015           assign
     1016               p-end-name = ""
     1017           .
     1018       end.
     1019       else do:
     1020           find first temp_grplib_found-grp
     1021               where temp_grplib_found-grp.full-name = p-end-name
     1022           no-error.
     1023           if available temp_grplib_found-grp
     1024           then do:
     1025               find first buf_temp_grplib_found-grp
     1026                   where buf_temp_grplib_found-grp.full-name begins p-end-name
     1027                   and recid( buf_temp_grplib_found-grp ) <> recid( temp_grplib_found-grp )
     1028               no-error.
     1029               if not available buf_temp_grplib_found-grp
     1030               then do:
     1031                   run grplib-is-terminal in this-procedure (
     1032                       input temp_grplib_found-grp.node-code
     1033                       , output v-is-terminal
     1034                   ).
     1035               end.
     1036           end.
     1037       end.
     1038   end.
     1039   end procedure.
     1040   procedure grplib-get-max-substring :
     1041   do
     1042   on error undo, return error
     1043   :
     1044   define input parameter p-min-substring-length   as integer      no-undo.
     1045   define output parameter p-substring             as character    no-undo.
     1046           define variable v-char-counter  as integer           no-undo.
     1047           define variable v-current-char  as character         no-undo.
     1048           define variable v-names-counter  as integer           no-undo.
     1049           define variable v-base-string   as character         no-undo.
     1050           assign
     1051               v-char-counter  = p-min-substring-length
     1052           .
     1053           find first temp_grplib_found-grp no-error.
     1054           if not available temp_grplib_found-grp
     1055           then do:
     1056               undo, return error "grplib-get-max-substring: Нет строк для вычисления общей подстроки".
     1057           end.
     1058           else do:
     1059               assign
     1060                   v-base-string  = temp_grplib_found-grp.full-name
     1061                   v-char-counter = 0
     1062               .
     1063               counter-block:
     1064               do while yes
     1065               on error undo, return error "grplib-get-max-substring: Ошибка вычисления продолжения имени группы."
     1066               :
     1067                   assign
     1068                       v-char-counter  = v-char-counter + 1
     1069                       v-current-char  = substring( v-base-string, v-char-counter, 1 )
     1070                       v-names-counter = 0
     1071                   .
     1072                   compare-block:
     1073                   for each temp_grplib_found-grp
     1074                   :
     1075                       assign
     1076                           v-names-counter = v-names-counter + 1
     1077                       .
     1078                       if v-names-counter = 1
     1079                       then do:
     1080                           next compare-block.
     1081                       end.
     1082                       if substring( temp_grplib_found-grp.full-name, v-char-counter, 1 ) <> v-current-char
     1083                       then do:
     1084                           leave counter-block.
     1085                       end.
     1086                   end.
     1087                   if v-names-counter = 1
     1088                   then do:
     1089                       assign
     1090                           p-substring = v-base-string
     1091                       .
     1092                       return.
     1093                   end.
     1094               end.
     1095               assign
     1096                   p-substring = substring( v-base-string, 1, v-char-counter - 1 )
     1097               .
     1098           end.
     1099   end.
     1100   end procedure.
     1101   procedure grplib-is-terminal :
     1102   do
     1103   on error undo, return error "Ошибка процедуры grplib-is-terminal"
     1104   :
     1105   define input parameter p-node-code      as integer      no-undo.
     1106   define output parameter p-is-terminal   as logical      no-undo.
     1107       define buffer buf_gds-grp       for ub.gds-grp.
     1108       find first buf_gds-grp no-lock
     1109           where buf_gds-grp.upper-code = p-node-code
     1110       no-error .
     1111       if not available buf_gds-grp
     1112       then do:
     1113           assign
     1114               p-is-terminal = yes
     1115           .
     1116       end.
     1117       else do:
     1118           assign
     1119               p-is-terminal = no
     1120           .
     1121       end.
     1122   end.
     1123   end procedure.
     1124   procedure grplib-have-goods :
     1125   do
     1126   on error undo, return error
     1127   :
     1128   define input parameter p-node-code      as integer      no-undo.
     1129   define output parameter p-have-goods   as logical      no-undo.
     1130       define buffer buf_goods         for ub.goods.
     1131       find first buf_goods no-lock
     1132            where buf_goods.grp-code = p-node-code
     1133       no-error .
     1134       if available buf_goods
     1135       then do:
     1136           assign
     1137               p-have-goods = yes
     1138           .
     1139       end.
     1140       else do:
     1141           assign
     1142               p-have-goods = no
     1143           .
     1144       end.
     1145   end.
     1146   end procedure.
     1147   procedure grplib-find-by-substring :
     1148   do
     1149   on error undo, return error
     1150   :
     1151   define input parameter p-start-code         as integer      no-undo.
     1152   define input parameter p-full-search-string as character    no-undo.
     1153   define output parameter p-found-code        as integer      no-undo.
     1154   define output parameter p-full-name         as character    no-undo.
     1155       define variable v-start-code     as integer           no-undo.
     1156       define variable v-found          as logical  init no  no-undo.
     1157       define buffer buf_gds-grp       for ub.gds-grp.
     1158       search-grp:
     1159       for each buf_gds-grp no-lock
     1160           where buf_gds-grp.node-code > p-start-code
     1161       :
     1162           if index( buf_gds-grp.node-name, p-full-search-string ) <> 0
     1163           then do:
     1164               assign
     1165                   p-found-code = buf_gds-grp.node-code
     1166                   v-found      = yes
     1167               .
     1168               run grplib-get-full-name in this-procedure (
     1169                     input p-found-code
     1170                   , output p-full-name
     1171               ) no-error .
     1172               if error-status :error
     1173               then do:
     1174                   undo, return error "grplib-find-by-substring: Ошибка вычисления полного имени группы." + chr(10) + return-value.
     1175               end.
     1176               leave search-grp.
     1177           end.
     1178       end.
     1179       if v-found = yes
     1180       then do:
     1181       end.
     1182       else do:
     1183           assign
     1184               p-full-name  = ""
     1185               p-found-code = 0
     1186           .
     1187       end.
     1188   end.
     1189   end procedure.
     1190   procedure grplib-analyze-grp-name :
     1191   do
     1192   on error undo, return error
     1193   :
     1194   define input parameter p-grp-name       as character            no-undo.
     1195   define input parameter p-upper-code     as integer              no-undo.
     1196   define output parameter p-error-message as character init ""    no-undo.
     1197       define variable v-char-list     as character    no-undo.
     1198       define variable v-char-counter  as integer      no-undo.
     1199       define variable v-full-name     as character    no-undo.
     1200       if p-grp-name = "" then do:
     1201           assign
     1202               p-error-message = "Название группы не может быть пустым.".
     1203           .
     1204       end.
     1205       else do:
     1206           assign
     1207               v-char-list = "47,92,58,63,34,60,62,171,187,183"
     1208           .
     1209           do v-char-counter = 1 to num-entries( v-char-list )
     1210           :
     1211               if index( p-grp-name, chr( integer( entry( v-char-counter, v-char-list ) ) ) ) <> 0
     1212               then do:
     1213                   assign
     1214                       p-error-message = 'Название группы не может содержать символы /\:*?"<>|«»·'
     1215                   .
     1216                   return.
     1217               end.
     1218           end.
     1219           if p-upper-code > 0
     1220           then do:
     1221               run grplib-get-full-name in this-procedure (
     1222                     input p-upper-code
     1223                   , output v-full-name
     1224               ) no-error .
     1225               if error-status :error
     1226               then do:
     1227                   undo, return error "grplib-analyze-grp-name: Не удалось вычислить полное имя группы." + chr(10) + return-value.
     1228               end.
     1229               if length( v-full-name ) + 1 + length( p-grp-name ) > 350
     1230               then do:
     1231                   assign
     1232                       p-error-message = 'Полное название группы не может содержать более 350 символов.'
     1233                   .
     1234               end.
     1235           end.
     1236       end.
     1237   end.
     1238   end procedure.
     1239   procedure grplib-get-lvl-num :
     1240   define input parameter p-node-code  as integer      no-undo.
     1241   define output parameter p-lvl-num   as integer      no-undo.
     1242       define variable v-full-name    as character    no-undo.
     1243   do
     1244   on error undo, return error
     1245   :
     1246       run grplib-get-full-name in this-procedure (
     1247             input p-node-code
     1248           , output v-full-name
     1249       ).
     1250       assign
     1251           p-lvl-num = num-entries( v-full-name, chr(47) ) - 1
     1252       .
     1253       if p-lvl-num = -1
     1254       then do:
     1255           assign
     1256               p-lvl-num = 0
     1257           .
     1258       end.
     1259   end.
     1260   end procedure.
     1261   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1262   define  shared variable PrintCopiesCounter as integer   no-undo initial 1 .
     1263   define  shared variable RepPathName        as character no-undo .
     1264   define  shared variable PrintRubl          as logical   no-undo .
     1265   function excel-format-dec-to-char returns char (input p-dec as decimal ).
     1266     if num-entries(string(p-dec), '.') = 2
     1267       then return( entry(1, string(p-dec), '.') + v-delim + entry(2, string(p-dec), '.')) .
     1268       else return( string(p-dec)) .
     1269   end function.
     1270   function format-point-to-comma returns char (input orig as char ) .
     1271   define variable rtext as character no-undo .
     1272   define variable strt as integer no-undo .
     1273   define variable leng as integer no-undo .
     1274   assign rtext = orig .
     1275   repeat:
     1276     strt =  index(rtext,'.').
     1277     if strt = 0 then leave.
     1278     leng = 1.
     1279     substring(rtext,strt,leng,"character") = v-delim .
     1280   end.
     1281   return rtext.
     1282   end function.
     1283   function format-excel-text returns char ( input start-text as char ) :
     1284   def var  i    as int no-undo.
     1285   def var  ch   as char no-undo.
     1286   def var  n    as int no-undo.
     1287   def var  ipos as int no-undo.
     1288     n = num-entries(trim(start-text), chr(10)) - 1 .
     1289     do i = 1 to n :
     1290       ipos = index( start-text, chr(10)).
     1291       if ipos > 0 then
     1292         substr( start-text, ipos, 1 ) = ' '.
     1293     end.
     1294     n = num-entries(trim(start-text), chr(13)) - 1 .
     1295     do i = 1 to n :
     1296       ipos = index( start-text, chr(13)).
     1297       if ipos > 0 then
     1298         substr( start-text, ipos, 1 ) = ' '.
     1299     end.
     1300     if index( start-text, '"' ) = 0 then
     1301       start-text =  '="'   + trim( start-text) + '"'   .
     1302       else do:
     1303         n = num-entries(trim(start-text), '"') - 1.
     1304         do i = 1 to n :
     1305           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
     1306         end.
     1307         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
     1308         start-text = '="'  + ch  + '"' .
     1309       end.
     1310     return start-text.
     1311   end.
     1312   function excel-sum returns char (input p-dec as decimal ).
     1313     return(format-excel-text(excel-format-dec-to-char(round(p-dec,2)))) .
     1314   end function.
     1315   function excel-qnty returns char (input p-dec as decimal ).
     1316     return(format-excel-text(excel-format-dec-to-char(round(p-dec,3)))) .
     1317   end function.
     1318   function format-excel-text-macr returns char ( input start-text as char ) :
     1319   def var  i    as int no-undo.
     1320   def var  ch   as char no-undo.
     1321   def var  n    as int no-undo.
     1322   def var  ipos as int no-undo.
     1323     n = num-entries(trim(start-text), chr(10)) - 1 .
     1324     do i = 1 to n :
     1325       ipos = index( start-text, chr(10)).
     1326       if ipos > 0 then
     1327         substring( start-text, ipos , 1 ) = ' '.
     1328     end.
     1329     n = num-entries(trim(start-text), chr(13)) - 1 .
     1330     do i = 1 to n :
     1331       ipos = index( start-text, chr(13)).
     1332       if ipos > 0 then
     1333         substring( start-text, ipos, 1 ) = ' '.
     1334     end.
     1335     if index( start-text, '"' ) = 0 then
     1336       start-text =  '"'   + trim( start-text) + '"'   .
     1337       else do:
     1338         n = num-entries(trim(start-text), '"') - 1.
     1339         do i = 1 to n :
     1340           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
     1341         end.
     1342         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
     1343         start-text = '"'  + ch  + '"' .
     1344       end.
     1345     n = num-entries(trim(start-text), chr(10)) - 1 .
     1346     do i = 1 to n :
     1347       ipos = index( start-text, chr(10)).
     1348       if ipos > 0 then
     1349         substring( start-text, ipos , 1 ) = ' '.
     1350     end.
     1351       if num-entries(trim(start-text), chr(10)) > 1 then  message num-entries(trim(start-text), chr(10)) start-text.
     1352     return start-text.
     1353   end.
     1354   def var vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1355   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
     1356   procedure paramls-clear :
     1357     define buffer buf_temp-param for temp-param .
     1358     do
     1359     on error undo, return error return-value
     1360     :
     1361       for each buf_temp-param
     1362       on error undo, return error
     1363       :
     1364         delete buf_temp-param .
     1365       end.
     1366     end.
     1367   end procedure.
     1368   procedure paramls-write :
     1369     define input  parameter p-code     as character no-undo .
     1370     define input  parameter p-sub-code as character no-undo .
     1371     define input  parameter p-value    as character no-undo .
     1372     define buffer buf_temp-param for temp-param .
     1373     do
     1374     on error undo, return error return-value
     1375     :
     1376       find first buf_temp-param
     1377         where buf_temp-param.param-code     = p-code
     1378           and buf_temp-param.param-sub-code = p-sub-code
     1379         no-error .
     1380       if not available buf_temp-param then do:
     1381         create buf_temp-param .
     1382         assign
     1383           buf_temp-param.param-code     = p-code
     1384           buf_temp-param.param-sub-code = p-sub-code
     1385         .
     1386       end.
     1387       assign
     1388         buf_temp-param.param-value = p-value
     1389       .
     1390     end.
     1391   end procedure.
     1392   procedure paramls-read :
     1393     define input  parameter p-code          as character no-undo .
     1394     define input  parameter p-sub-code      as character no-undo .
     1395     define input  parameter p-default-value as character no-undo .
     1396     define output parameter p-value         as character no-undo .
     1397     define buffer buf_temp-param for temp-param .
     1398     do
     1399     on error undo, return error return-value
     1400     :
     1401       find first buf_temp-param
     1402         where buf_temp-param.param-code     = p-code
     1403           and buf_temp-param.param-sub-code = p-sub-code
     1404         no-error .
     1405       if available buf_temp-param then do:
     1406         assign
     1407           p-value = buf_temp-param.param-value
     1408         .
     1409       end.
     1410       else do:
     1411         assign
     1412           p-value = p-default-value
     1413         .
     1414       end.
     1415     end.
     1416   end procedure.
     1417   procedure paramls-append :
     1418     define input  parameter p-code     as character no-undo .
     1419     define input  parameter p-sub-code as character no-undo .
     1420     define input  parameter p-value    as character no-undo .
     1421     define buffer buf_temp-param for temp-param .
     1422     do
     1423     on error undo, return error return-value
     1424     :
     1425       find first buf_temp-param
     1426            where buf_temp-param.param-code     = p-code
     1427              and buf_temp-param.param-sub-code = p-sub-code
     1428         no-error .
     1429       if not available buf_temp-param then do:
     1430         create buf_temp-param .
     1431         assign
     1432           buf_temp-param.param-code     = p-code
     1433           buf_temp-param.param-sub-code = p-sub-code
     1434           buf_temp-param.param-value    = p-value
     1435         .
     1436       end.
     1437       else do:
     1438           assign
     1439               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
     1440           .
     1441       end.
     1442     end.
     1443   end procedure.
