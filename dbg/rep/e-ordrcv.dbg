      883   procedure twowin_clear :
      884       define buffer buf_temp_twowin_items        for temp_twowin_items.
      885   do
      886   for buf_temp_twowin_items
      887   on error undo, return error
      888   :
      889       empty temp-table buf_temp_twowin_items.
      890   end.
      891   end procedure.
      892   procedure twowin_add-item :
      893   define input parameter p-ext-key   as character        no-undo.
      894   define input parameter p-item-name as character        no-undo.
      895   define input parameter p-item-desc as character        no-undo.
      896   define input parameter p-selected  as logical          no-undo.
      897       define buffer buf_temp_twowin_items        for temp_twowin_items.
      898   do
      899   for buf_temp_twowin_items
      900   on error undo, return error
      901   :
      902       assign
      903           v-twowin13-itm-key = v-twowin13-itm-key + 1
      904       .
      905       create temp_twowin_items.
      906       assign
      907           temp_twowin_items.itm-key      = v-twowin13-itm-key
      908           temp_twowin_items.itmExtKey    = p-ext-key
      909           temp_twowin_items.itmName      = p-item-name
      910           temp_twowin_items.itmDesc      = p-item-desc
      911           temp_twowin_items.itmSelected  = p-selected
      912           temp_twowin_items.selLeft      = no
      913           temp_twowin_items.selRight     = no
      914       .
      915   end.
      916   end procedure.
      917   CREATE WIDGET-POOL.
      918   def var vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      919   procedure gen-key-rec :
      920     define input  parameter p-tbl-name    as character no-undo.
      921     define input  parameter p-bh_tbl-name as handle    no-undo.
      922     define output parameter p-key-rec     as character no-undo.
      923     do
      924     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      925     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      926     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      927     :
      928       define variable fh               as handle    no-undo .
      929       define variable v-ok             as logical   no-undo .
      930       define variable v-inform         as character no-undo .
      931       define variable v-ind            as integer   no-undo .
      932       define variable v-idx-field-qnty as integer   no-undo .
      933       if p-tbl-name = ?
      934         or p-tbl-name = "":U
      935       then do:
      936         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info14 ).
      937       end.
      938       if not p-bh_tbl-name:available then do:
      939         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info14, p-tbl-name ).
      940       end.
      941       assign
      942         p-key-rec = p-tbl-name
      943         v-inform  = p-bh_tbl-name:index-information(1)
      944         v-ind     = 2
      945       .
      946       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      947       on error undo, return error
      948       :
      949         assign
      950           v-inform = p-bh_tbl-name:index-information( v-ind )
      951           v-ind    = v-ind + 1
      952         .
      953       end.
      954       if v-inform = ?
      955         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      956         or entry( 3, v-inform, ",":U ) <> "1":U
      957       then do:
      958         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info14, p-tbl-name ).
      959       end.
      960       else do:
      961         assign
      962           v-idx-field-qnty = num-entries( v-inform ) - 4
      963         .
      964         if v-idx-field-qnty < 2 then do:
      965           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info14, v-inform, p-tbl-name ).
      966         end.
      967         do v-ind = 1 to v-idx-field-qnty by 2
      968         on error undo, return error
      969         :
      970           assign
      971             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      972             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      973           .
      974         end.
      975       end.
      976       if p-key-rec = ? then do:
      977         assign
      978           p-key-rec = "":U
      979         .
      980         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info14, p-tbl-name ).
      981       end.
      982     end.
      983     return.
      984   end procedure.
      985   procedure gen-where-keyr-tab :
      986     define input  parameter i-tableSerach as character no-undo.
      987     define input  parameter i-tablekey   as character  no-undo.
      988     define input  parameter p-key-rec    as character  no-undo.
      989     define input  parameter p-key-handle as handle     no-undo .
      990     define input  parameter p-db-name    as character  no-undo .
      991     define input  parameter p-tt-handle  as handle     no-undo .
      992     define output parameter o-Where      as character  no-undo.
      993     do
      994     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      995     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      996     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      997     :
      998       define variable v-full-tbl-name  as character no-undo .
      999       define variable bh_tbl-name      as handle    no-undo .
     1000       define variable fh_key           as handle    no-undo .
     1001       define variable fh_search        as handle    no-undo .
     1002       define variable v-field-num      as integer   no-undo .
     1003       define variable v-count-fld      as integer   no-undo .
     1004       define variable v-inform         as character no-undo .
     1005       define variable v-ind            as integer   no-undo .
     1006       define variable v-idx-field-qnty as integer   no-undo .
     1007       define variable v-field-name     as character no-undo .
     1008       define variable v-field-val      as character no-undo .
     1009       define variable v-word-link      as character no-undo .
     1010       define variable vTable           as character no-undo.
     1011       define variable bh_tbl-key       as handle    no-undo .
     1012       assign
     1013         p-key-rec = trim( p-key-rec )
     1014       .
     1015       if p-key-handle <> ? then do:
     1016         if not valid-handle(p-key-handle)
     1017            or p-key-handle:type <> "buffer"
     1018         then do:
     1019           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info14 ).
     1020         end.
     1021         if num-entries( p-key-rec, chr(3) ) > 1
     1022           or p-key-rec = ?
     1023           or p-key-rec = "":U
     1024         then do:
     1025           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info14, p-key-rec ).
     1026         end.
     1027       end.
     1028       else do:
     1029         if p-key-rec = ?
     1030           or p-key-rec = "":U
     1031         then do:
     1032           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info14 ).
     1033         end.
     1034       end.
     1035       assign
     1036         vTable = entry( 1 , p-key-rec, chr(3) )
     1037       .
     1038       if p-tt-handle <> ?
     1039         and ( not valid-handle(p-tt-handle)
     1040               or p-tt-handle:type <> "buffer"
     1041             )
     1042       then do:
     1043         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info14, vTable, chr(10) ).
     1044       end.
     1045       if p-tt-handle = ? then do:
     1046         assign
     1047           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
     1048         .
     1049         create buffer bh_tbl-name for table v-full-tbl-name .
     1050       end.
     1051       else do:
     1052         create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1053       end.
     1054       assign
     1055         v-inform = bh_tbl-name:index-information(1)
     1056         v-ind    = 2
     1057       .
     1058       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1059       on error undo, return error
     1060       :
     1061         assign
     1062           v-inform = bh_tbl-name:index-information( v-ind )
     1063           v-ind    = v-ind + 1
     1064         .
     1065       end.
     1066       if v-inform = ?
     1067         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1068         or entry( 3, v-inform, ",":U ) <> "1":U
     1069       then do:
     1070         delete object bh_tbl-name no-error.
     1071         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info14, vTable ).
     1072       end.
     1073       assign
     1074         v-idx-field-qnty = num-entries( v-inform ) - 4
     1075       .
     1076       if v-idx-field-qnty < 2 then do:
     1077         delete object bh_tbl-name no-error.
     1078         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info14, v-inform, vTable ).
     1079       end.
     1080       assign
     1081         o-where     = "where":U
     1082         v-word-link = "":U
     1083         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
     1084         v-count-fld = 0
     1085       .
     1086       if i-tablekey ne "" and i-tablekey ne ?
     1087       then do:
     1088         assign
     1089           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
     1090         .
     1091         create buffer bh_tbl-key for table v-full-tbl-name .
     1092       end.
     1093       if i-tableSerach ne "" and i-tableSerach ne ?
     1094       then do:
     1095         delete object bh_tbl-name no-error.
     1096         assign
     1097           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
     1098         .
     1099         create buffer bh_tbl-name for table v-full-tbl-name .
     1100       end.
     1101       block_where:
     1102       do v-ind = 1 to v-idx-field-qnty by 2
     1103       on error undo, return error
     1104       :
     1105         assign
     1106           v-count-fld = v-count-fld + 1
     1107         .
     1108         if p-key-handle = ?
     1109           and v-count-fld > v-field-num
     1110         then do:
     1111           leave block_where.
     1112         end.
     1113         define variable VfieldKeyTable as handle no-undo.
     1114         assign
     1115           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     1116           fh_search    = bh_tbl-name:buffer-field( v-field-name )
     1117         .
     1118         if     bh_tbl-key ne ?
     1119         then do:
     1120            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
     1121            if VfieldKeyTable eq ?
     1122            then next block_where.
     1123         end.
     1124         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
     1125         then
     1126            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
     1127         else
     1128            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
     1129         if p-key-handle = ? then do:
     1130           assign
     1131             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
     1132           .
     1133         end.
     1134         else do:
     1135           assign
     1136             fh_key = p-key-handle:buffer-field( v-field-name )
     1137           .
     1138           if fh_key = ?
     1139             or not valid-handle( fh_key )
     1140           then do:
     1141             delete object bh_tbl-name.
     1142             if     bh_tbl-key ne ?
     1143             then
     1144                delete object bh_tbl-key.
     1145             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info14, p-key-handle:name, v-field-name ).
     1146           end.
     1147           assign
     1148             v-field-val = fh_key:buffer-value
     1149           .
     1150         end.
     1151         if fh_search:data-type ="character":U then do:
     1152           assign
     1153             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
     1154             v-field-val = replace( v-field-val, '"':U, '~~"':U )
     1155             v-field-val = replace( v-field-val, "'":U, "~~'":U )
     1156             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
     1157             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
     1158             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
     1159             v-field-val = replace( v-field-val, chr(10), '~~n':U )
     1160             v-field-val = replace( v-field-val, chr(9), '~~t':U )
     1161             v-field-val = replace( v-field-val, chr(13), '~~r':U )
     1162             v-field-val = replace( v-field-val, chr(27), '~~E':U )
     1163             v-field-val = replace( v-field-val, chr(8), '~~b':U )
     1164             v-field-val = replace( v-field-val, chr(12), '~~f':U )
     1165             v-field-val = substitute( '"&1"', v-field-val )
     1166           .
     1167         end.
     1168         assign
     1169           o-where = substitute( "&1 &2", o-where, v-field-val )
     1170         .
     1171         if v-word-link = "":U then do:
     1172           assign
     1173             v-word-link = "and":U
     1174           .
     1175         end.
     1176       end.
     1177       delete object bh_tbl-name.
     1178       if     bh_tbl-key ne ?
     1179       then
     1180          delete object bh_tbl-key.
     1181       if p-key-handle = ?
     1182         and v-count-fld <> v-field-num
     1183       then do:
     1184         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info14, vTable ).
     1185       end.
     1186     end.
     1187   end procedure.
     1188   procedure gen-hn-keyr-tab :
     1189     define input  parameter i-tableSerach as character no-undo.
     1190     define input  parameter i-tablekey   as character no-undo.
     1191     define input  parameter p-key-rec    as character no-undo.
     1192     define input  parameter p-key-handle as handle    no-undo .
     1193     define input  parameter p-db-name    as character no-undo .
     1194     define input  parameter p-tt-handle  as handle    no-undo .
     1195     define input  parameter p-stts-lock  as integer   no-undo .
     1196     define output parameter o-hn         as handle    no-undo.
     1197     define variable v-full-tbl-name as character no-undo.
     1198     define variable v-where         as character no-undo.
     1199     define variable bh_tbl-name     as handle    no-undo.
     1200     define variable vTable          as character no-undo.
     1201     do
     1202     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1203     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1204     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
     1205         run gen-where-keyr-tab(i-tableSerach,
     1206                                i-tablekey,
     1207                                p-key-rec,
     1208                                p-key-handle,
     1209                                p-db-name,
     1210                                p-tt-handle,
     1211                                output v-where).
     1212         if i-tableSerach ne "" and i-tableSerach ne ?
     1213         then do:
     1214            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
     1215            create buffer bh_tbl-name for table v-full-tbl-name .
     1216         end.
     1217         else do:
     1218            if p-tt-handle = ? then do:
     1219               assign
     1220                  vTable = entry( 1 , p-key-rec, chr(3) )
     1221               .
     1222               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
     1223               create buffer bh_tbl-name for table v-full-tbl-name .
     1224            end.
     1225            else do:
     1226               create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1227            end.
     1228         end.
     1229         if p-tt-handle = ? then do:
     1230            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
     1231         end.
     1232         else do:
     1233            bh_tbl-name:find-first( v-where ) no-error .
     1234         end.
     1235         o-hn = bh_tbl-name.
     1236      end.
     1237   end procedure.
     1238   procedure gen-hn-keyr :
     1239     define input  parameter p-key-rec    as character no-undo.
     1240     define input  parameter p-key-handle as handle    no-undo .
     1241     define input  parameter p-db-name    as character no-undo .
     1242     define input  parameter p-tt-handle  as handle    no-undo .
     1243     define input  parameter p-stts-lock  as integer   no-undo .
     1244     define output parameter o-hn         as handle    no-undo.
     1245     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
     1246   end.
     1247   procedure gen-row-keyr :
     1248     define input  parameter p-key-rec    as character no-undo.
     1249     define input  parameter p-key-handle as handle    no-undo .
     1250     define input  parameter p-db-name    as character no-undo .
     1251     define input  parameter p-tt-handle  as handle    no-undo .
     1252     define input  parameter p-stts-lock  as integer   no-undo .
     1253     define output parameter p-tbl-row    as rowid     no-undo.
     1254     define output parameter p-tbl-name   as character no-undo.
     1255     define variable vHn as handle no-undo.
     1256       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
     1257       p-tbl-row = if vHn:available then vHn:rowid else ?.
     1258       p-tbl-name =  vHn:table.
     1259       delete object vHn no-error.
     1260     if p-tbl-row = ? then do:
     1261       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info14, p-tbl-name, p-key-rec ).
     1262     end.
     1263     else do:
     1264       return.
     1265     end.
     1266   end procedure.
     1267   procedure gen-key-fv :
     1268     define input  parameter p-key-rec    as character no-undo .
     1269     define output parameter p-field-list as character no-undo .
     1270     define output parameter p-value-list as character no-undo.
     1271     do
     1272     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1273     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1274     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1275     :
     1276       define variable v-full-tbl-name  as character no-undo .
     1277       define variable bh_tbl-name      as handle    no-undo .
     1278       define variable v-tbl-name       as character no-undo .
     1279       define variable v-field-num      as integer   no-undo .
     1280       define variable v-count-fld      as integer   no-undo .
     1281       define variable v-inform         as character no-undo .
     1282       define variable v-ind            as integer   no-undo .
     1283       define variable v-idx-field-qnty as integer   no-undo .
     1284       define variable v-delim-key      as character no-undo .
     1285       if p-key-rec = ?
     1286         or p-key-rec = "":U
     1287       then do:
     1288         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info14 ).
     1289       end.
     1290       assign
     1291         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     1292         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1293       .
     1294       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1295       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info14 ).
     1296       assign
     1297         v-inform = bh_tbl-name:index-information(1)
     1298         v-ind    = 2
     1299       .
     1300       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1301       on error undo, return error
     1302       :
     1303         assign
     1304           v-inform = bh_tbl-name:index-information( v-ind )
     1305           v-ind    = v-ind + 1
     1306         .
     1307       end.
     1308       if v-inform = ?
     1309         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1310         or entry( 3, v-inform, ",":U ) <> "1":U
     1311       then do:
     1312         delete object bh_tbl-name no-error.
     1313         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info14, v-tbl-name ).
     1314       end.
     1315       assign
     1316         v-idx-field-qnty = num-entries( v-inform ) - 4
     1317       .
     1318       if v-idx-field-qnty < 2 then do:
     1319         delete object bh_tbl-name no-error.
     1320         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info14, v-inform, v-tbl-name ).
     1321       end.
     1322       assign
     1323         p-field-list = "":U
     1324         p-value-list = "":U
     1325         v-delim-key  = "":U
     1326         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     1327         v-count-fld  = 0
     1328       .
     1329       block_where:
     1330       do v-ind = 1 to v-idx-field-qnty by 2
     1331       on error undo, return error
     1332       :
     1333         assign
     1334           v-count-fld = v-count-fld + 1
     1335         .
     1336         if v-count-fld > v-field-num then do:
     1337           leave block_where.
     1338         end.
     1339         assign
     1340           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     1341           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     1342         .
     1343         if v-ind = 1 then do:
     1344           assign
     1345             v-delim-key = chr(3)
     1346           .
     1347         end.
     1348       end.
     1349       delete object bh_tbl-name.
     1350       if v-count-fld <> v-field-num then do:
     1351         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info14, v-tbl-name ).
     1352       end.
     1353     end.
     1354   end procedure.
     1355   procedure gen-key-field :
     1356     define input  parameter p-table      as character no-undo .
     1357     define output parameter p-field-list as character no-undo .
     1358     do
     1359     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1360     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1361     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1362     :
     1363       define variable v-full-tbl-name  as character no-undo .
     1364       define variable bh_tbl-name      as handle    no-undo .
     1365       define variable v-tbl-name       as character no-undo .
     1366       define variable v-field-num      as integer   no-undo .
     1367       define variable v-count-fld      as integer   no-undo .
     1368       define variable v-inform         as character no-undo .
     1369       define variable v-ind            as integer   no-undo .
     1370       define variable v-idx-field-qnty as integer   no-undo .
     1371       define variable v-delim-key      as character no-undo .
     1372       if p-table = ?
     1373         or p-table = "":U
     1374       then do:
     1375         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info14 ).
     1376       end.
     1377       assign
     1378         v-tbl-name      = p-table
     1379         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1380       .
     1381       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1382       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info14 ).
     1383       assign
     1384         v-inform = bh_tbl-name:index-information(1)
     1385         v-ind    = 2
     1386       .
     1387       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1388       on error undo, return error
     1389       :
     1390         assign
     1391           v-inform = bh_tbl-name:index-information( v-ind )
     1392           v-ind    = v-ind + 1
     1393         .
     1394       end.
     1395       if v-inform = ?
     1396         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1397         or entry( 3, v-inform, ",":U ) <> "1":U
     1398       then do:
     1399         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info14, v-tbl-name ).
     1400       end.
     1401       assign
     1402         v-idx-field-qnty = num-entries( v-inform ) - 4
     1403       .
     1404       if v-idx-field-qnty < 2 then do:
     1405         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info14, v-inform, v-tbl-name ).
     1406       end.
     1407       assign
     1408         p-field-list = "":U
     1409         v-delim-key  = "":U
     1410         v-count-fld  = 0
     1411       .
     1412       block_where:
     1413       do v-ind = 1 to v-idx-field-qnty by 2
     1414       on error undo, return error
     1415       :
     1416         assign
     1417           v-count-fld = v-count-fld + 1
     1418         .
     1419         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     1420         if v-ind = 1 then do:
     1421           assign
     1422             v-delim-key = chr(3)
     1423           .
     1424         end.
     1425       end.
     1426       delete object bh_tbl-name.
     1427     end.
     1428   end procedure.
     1429   define variable State-source as  WIDGET-HANDLE.
     1430   define variable v-nn            as integer   no-undo .
     1431   define variable g#log           as logical   no-undo .
     1432   define variable post-grp_recids as character no-undo .
     1433   define variable ii              as integer   no-undo .
     1434   def buffer cli-post for clients .
     1435   def new  SHARED temp-table g#post NO-UNDO
     1436       field obj-type like ub.clients.obj-type
     1437       field obj-code like ub.clients.obj-code
     1438       field obj-name like ub.clients.obj-name
     1439       INDEX pi IS UNIQUE PRIMARY obj-type obj-code.
     1440   def New SHARED temp-table g#post-f NO-UNDO
     1441       field obj-type like ub.clients.obj-type
     1442       field obj-code like ub.clients.obj-code
     1443       field obj-name like ub.clients.obj-name
     1444       field grp-code like ub.clients.grp-code
     1445       field grp-name like ub.clients.grp-name
     1446       field lvl-num like  ub.cli-grp.lvl-num
     1447       INDEX pi IS UNIQUE PRIMARY obj-type obj-code
     1448       INDEX p1  obj-name
     1449       .
     1450   DEFINE VARIABLE PostName AS CHARACTER
     1451        VIEW-AS EDITOR SCROLLBAR-VERTICAL
     1452        SIZE 31 BY 2.17 TOOLTIP "Список выбранных Поставщиков"
     1453        FONT 4 NO-UNDO.
     1454   DEFINE VARIABLE RADPost AS INTEGER INITIAL 1
     1455        VIEW-AS RADIO-SET VERTICAL
     1456        RADIO-BUTTONS
     1457             "все", 1,
     1458   "Выборочно", 2
     1459        SIZE 12 BY 2.17 NO-UNDO.
     1460   DEFINE VARIABLE show-rcv AS LOGICAL INITIAL no
     1461        LABEL "Показывать поставки"
     1462        VIEW-AS TOGGLE-BOX
     1463        SIZE 38 BY .83 TOOLTIP "Выводит информацию по поставкам" NO-UNDO.
     1464   DEFINE VARIABLE sort-by-name AS LOGICAL INITIAL no
     1465        LABEL "Сортировать поставщиков по имени"
     1466        VIEW-AS TOGGLE-BOX
     1467        SIZE 38 BY .83 TOOLTIP "Выводит поставщиков по алфавиту" NO-UNDO.
     1468   DEFINE FRAME F-Main
     1469        RADPost AT ROW 2 COL 3 NO-LABEL WIDGET-ID 22
     1470        PostName AT ROW 2 COL 15.38 NO-LABEL WIDGET-ID 20
     1471        sort-by-name AT ROW 5.25 COL 3 WIDGET-ID 28
     1472        show-rcv AT ROW 6.5 COL 3 WIDGET-ID 30
     1473        "Выбор поставщика:" VIEW-AS TEXT
     1474             SIZE 19.38 BY .67 AT ROW 1.25 COL 7.13 WIDGET-ID 26
     1475             FGCOLOR 4
     1476       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
     1477            SIDE-LABELS NO-UNDERLINE THREE-D
     1478            AT COL 1 ROW 1 SCROLLABLE .
     1479   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
     1480   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
     1481   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
     1482   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
     1483   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
     1484   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
     1485   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
     1486   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
     1487         adm-object-hdl = FRAME F-Main:HANDLE.
     1488   RUN ensure-broker.
     1489   THIS-PROCEDURE:ADM-DATA =
     1490        'ADM1.1~`':U +
     1491        'SmartObject~`':U +
     1492        '~`':U +
     1493        'NO ~`':U +
     1494        '~`':U +
     1495        '~`':U +
     1496        '~`':U +
     1497        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
     1498           + "~`":U +
     1499        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add~`':U +
     1500        'Record-Source,Record-Target,TableIO-Target~`':U +
     1501        '~`':U +
     1502        '~`~`~`~`~`~`~`~`~`~`~`':U +
     1503        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
     1504            THEN "^^":U
     1505        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
     1506             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
     1507   PROCEDURE adm-apply-entry :
     1508     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1509   END PROCEDURE.
     1510   PROCEDURE adm-destroy :
     1511    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1512   END PROCEDURE.
     1513   PROCEDURE adm-disable :
     1514       DISABLE RADPost PostName sort-by-name show-rcv WITH FRAME F-Main.
     1515       RUN dispatch ('disable-fields':U).
     1516       RUN set-attribute-list ('ENABLED=no':U).
     1517       RETURN.
     1518   END PROCEDURE.
     1519   PROCEDURE adm-edit-attribute-list :
     1520         RUN adm/support/viewerd.w (INPUT THIS-PROCEDURE).
     1521         RETURN.
     1522   END PROCEDURE.
     1523   PROCEDURE adm-enable :
     1524       ENABLE UNLESS-HIDDEN RADPost PostName sort-by-name show-rcv WITH FRAME F-Main.
     1525       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
     1526       RUN set-attribute-list ('ENABLED=yes':U).
     1527       RETURN.
     1528   END PROCEDURE.
     1529   PROCEDURE adm-exit :
     1530        RUN notify ('exit':U).
     1531     RETURN.
     1532   END PROCEDURE.
     1533   PROCEDURE adm-hide :
     1534     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1535   END PROCEDURE.
     1536   PROCEDURE adm-initialize :
     1537     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1538   END PROCEDURE.
     1539   PROCEDURE adm-show-errors :
     1540       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
     1541       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
     1542           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
     1543       END.
     1544       RETURN.
     1545   END PROCEDURE.
     1546   PROCEDURE adm-UIB-mode :
     1547     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1548   END PROCEDURE.
     1549   PROCEDURE adm-view :
     1550     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1551   END PROCEDURE.
     1552   PROCEDURE dispatch :
     1553       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
     1554       RUN broker-dispatch IN adm-broker-hdl
     1555           (THIS-PROCEDURE, p-method-name) NO-ERROR.
     1556       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
     1557   END PROCEDURE.
     1558   PROCEDURE ensure-broker :
     1559   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
     1560   IF RETURN-VALUE NE "ADM-Broker":U THEN
     1561   DO:
     1562       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
     1563       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
     1564   END.
     1565   END PROCEDURE.
     1566   PROCEDURE get-attribute :
     1567     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
     1568     RUN broker-get-attribute IN adm-broker-hdl
     1569         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
     1570     RETURN RETURN-VALUE.
     1571   END PROCEDURE.
     1572   PROCEDURE get-attribute-list :
     1573     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
     1574     RUN broker-get-attribute-list IN adm-broker-hdl
     1575         (INPUT THIS-PROCEDURE,
     1576          INPUT ?,
     1577          OUTPUT p-attr-list) NO-ERROR.
     1578     RETURN.
     1579   END PROCEDURE.
     1580   PROCEDURE new-state :
     1581     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     1582     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
     1583     RETURN.
     1584   END PROCEDURE.
     1585   PROCEDURE notify :
     1586     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
     1587     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
     1588     IF RETURN-VALUE = "ADM-ERROR":U THEN
     1589         RETURN "ADM-ERROR":U.
     1590     RETURN.
     1591   END PROCEDURE.
     1592   PROCEDURE set-attribute-list :
     1593     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
     1594     RUN ensure-broker.
     1595     RUN broker-set-attribute-list IN adm-broker-hdl
     1596         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
     1597     RETURN.
     1598   END PROCEDURE.
     1599   PROCEDURE set-position :
     1600       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
     1601       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
     1602       IF VALID-HANDLE(adm-object-hdl) THEN
     1603       DO:
     1604         ASSIGN adm-object-hdl:ROW    =   p-row
     1605                adm-object-hdl:COLUMN =   p-col.
     1606       END.
     1607       RETURN.
     1608   END PROCEDURE.
     1609   PROCEDURE adm-display-fields :
     1610       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
     1611       RETURN.
     1612   END PROCEDURE.
     1613   PROCEDURE adm-open-query :
     1614     RETURN.
     1615   END PROCEDURE.
     1616   PROCEDURE adm-row-changed :
     1617         IF VALID-HANDLE(adm-object-hdl) THEN
     1618           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     1619         RUN notify ('row-available':U).
     1620         RETURN.
     1621   END PROCEDURE.
     1622   PROCEDURE reposition-query :
     1623       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
     1624       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
     1625       RETURN.
     1626   END PROCEDURE.
     1627     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
     1628     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
     1629     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
     1630     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
     1631     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
     1632     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
     1633     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
     1634     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
     1635     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1636     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
     1637     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1638     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
     1639     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
     1640     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
     1641     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
     1642     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
     1643     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
     1644     IF "":U = "":U THEN
     1645       RUN modify-list-attribute IN adm-broker-hdl
     1646         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
     1647     RUN use-create-on-add(?).
     1648   PROCEDURE adm-add-record :
     1649       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     1650          "must have at least one Enabled Table to perform Add.":U
     1651          VIEW-AS ALERT-BOX ERROR.
     1652       RETURN.
     1653   END PROCEDURE.
     1654   PROCEDURE adm-assign-record :
     1655    MESSAGE
     1656          "Object ":U THIS-PROCEDURE:FILE-NAME
     1657            "must have at least one Enabled Table to perform Assign.":U
     1658              VIEW-AS ALERT-BOX ERROR.
     1659      RETURN.
     1660     END PROCEDURE.
     1661   PROCEDURE adm-assign-statement :
     1662     RETURN.
     1663   END PROCEDURE.
     1664   PROCEDURE adm-cancel-record :
     1665      RETURN.
     1666     END PROCEDURE.
     1667   PROCEDURE adm-copy-record :
     1668       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     1669        "must have at least one Enabled Table to perform Copy.":U
     1670          VIEW-AS ALERT-BOX ERROR.
     1671       RETURN.
     1672   END PROCEDURE.
     1673   PROCEDURE adm-create-record :
     1674      RETURN.
     1675   END PROCEDURE.
     1676   PROCEDURE adm-current-changed :
     1677     RETURN.
     1678   END PROCEDURE.
     1679   PROCEDURE adm-delete-record :
     1680    MESSAGE
     1681          "Object ":U THIS-PROCEDURE:FILE-NAME
     1682            "must have at least one Enabled Table to perform Delete.":U
     1683              VIEW-AS ALERT-BOX ERROR.
     1684       RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
     1685       RETURN.
     1686   END PROCEDURE.
     1687   PROCEDURE adm-disable-fields :
     1688         RUN notify ('disable-fields, GROUP-ASSIGN-TARGET':U).
     1689       RETURN.
     1690   END PROCEDURE.
     1691   PROCEDURE adm-enable-fields :
     1692       RETURN.
     1693   END PROCEDURE.
     1694   PROCEDURE adm-end-update :
     1695     RETURN.
     1696   END PROCEDURE.
     1697   PROCEDURE adm-reset-record :
     1698       RETURN.
     1699   END PROCEDURE.
     1700   PROCEDURE adm-update-record :
     1701       MESSAGE
     1702         "Object ":U THIS-PROCEDURE:FILE-NAME
     1703           "must have at least one Enabled Table to perform Update.":U
     1704             VIEW-AS ALERT-BOX ERROR.
     1705      RETURN.
     1706   END PROCEDURE.
     1707   PROCEDURE check-modified :
     1708   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
     1709   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
     1710   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
     1711   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
     1712     IF check-state = "check":U THEN
     1713     DO:
     1714       RUN get-link-handle IN adm-broker-hdl
     1715         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
     1716            OUTPUT group-target-list).
     1717       IF group-target-list NE "":U THEN
     1718       DO i = 1 TO NUM-ENTRIES(group-target-list):
     1719         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
     1720         RUN check-modified IN curr-widget ('group-check':U).
     1721         IF RETURN-VALUE NE "":U THEN
     1722         DO:
     1723           RUN check-modified-message(RETURN-VALUE).
     1724           RETURN "":U.
     1725         END.
     1726       END.
     1727     END.
     1728     RETURN "":U.
     1729   END PROCEDURE.
     1730   PROCEDURE check-modified-message :
     1731     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
     1732        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
     1733           'CONTAINER-SOURCE':U, 'HIDDEN':U).
     1734        IF RETURN-VALUE = "YES":U THEN
     1735           RUN notify ('view,CONTAINER-SOURCE':U).
     1736        MESSAGE IF p-changed-table NE ? THEN
     1737           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
     1738           ELSE "Current values have been changed."
     1739           SKIP "  Do you wish to save those changes?"
     1740           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
     1741        IF ANS THEN
     1742        DO:
     1743           IF group-assign-target THEN
     1744             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
     1745           ELSE RUN dispatch('update-record':U).
     1746           IF RETURN-VALUE = "ADM-ERROR":U THEN
     1747           DO:
     1748               MESSAGE "Changes to the previous record were not saved."
     1749                 VIEW-AS ALERT-BOX ERROR.
     1750               IF group-assign-target THEN
     1751                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1752               ELSE RUN dispatch ('cancel-record':U).
     1753           END.
     1754        END.
     1755        ELSE DO:
     1756          IF group-assign-target THEN
     1757             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1758          ELSE RUN dispatch('cancel-record':U).
     1759        END.
     1760        RETURN.
     1761   END PROCEDURE.
     1762   PROCEDURE get-rowid :
     1763       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
     1764       ASSIGN
     1765       p-table   =   adm-first-table.
     1766       RETURN.
     1767   END PROCEDURE.
     1768   PROCEDURE init-group-assign :
     1769       RUN request-attribute IN adm-broker-hdl
     1770         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
     1771       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
     1772         group-assign-target = yes.
     1773       ELSE group-assign-target = no.
     1774       RETURN.
     1775   END PROCEDURE.
     1776   PROCEDURE set-editors :
     1777       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
     1778       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
     1779       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
     1780       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
     1781       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
     1782       DO WHILE VALID-HANDLE (curr-widget):
     1783           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
     1784              curr-widget:HIDDEN = no THEN DO:
     1785             CASE p-field-setting:
     1786               WHEN "INITIALIZE":U THEN
     1787               DO:
     1788                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
     1789                     read-only-list +
     1790                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
     1791                        STRING(curr-widget).
     1792               END.
     1793               WHEN "DISABLE":U OR
     1794               WHEN "ENABLE":U THEN
     1795               DO:
     1796                   curr-widget:SENSITIVE = yes.
     1797                   RUN get-attribute ('Read-Only-Editors':U).
     1798                   IF RETURN-VALUE = ? OR
     1799                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
     1800                       curr-widget:READ-ONLY =
     1801                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
     1802               END.
     1803               WHEN "CLEAR":U THEN
     1804                   curr-widget:SCREEN-VALUE = "":U.
     1805             END CASE.
     1806           END.
     1807           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
     1808       END.
     1809       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
     1810         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
     1811           + '"':U).
     1812       RETURN.
     1813   END PROCEDURE.
     1814   PROCEDURE use-check-modified-all :
     1815    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1816     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
     1817     RETURN.
     1818   END PROCEDURE.
     1819   PROCEDURE use-create-on-add :
     1820   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1821      RETURN.
     1822   END PROCEDURE.
     1823   PROCEDURE use-initial-lock :
     1824     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1825     ASSIGN adm-initial-lock = p-attr-value.
     1826     RETURN.
     1827   END PROCEDURE.
     1828     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
     1829   ASSIGN
     1830          FRAME F-Main:SCROLLABLE       = FALSE
     1831          FRAME F-Main:HIDDEN           = TRUE
     1832          FRAME F-Main:PRIVATE-DATA     =
     1833                   "DLGCLOSE".
     1834   ASSIGN
     1835          PostName:READ-ONLY IN FRAME F-Main        = TRUE.
     1836   ON VALUE-CHANGED OF RADPost IN FRAME F-Main
     1837   DO:
     1838     Assign RadPost.
     1839     for each g#post-f : delete g#post-f. end.
     1840     Case RAdPost :
     1841       when 1 then do:
     1842           Assign  Postname = 'все':U.
     1843           Display PostName with frame F-Main .
     1844       end.
     1845       when 2 then do:
     1846           run ref/cli-all.w
     1847               ( my-handle
     1848               , "b-sel,b-mark"
     1849               , 'про':U
     1850               , 'все':U
     1851               , 'текущие':U
     1852               , ?
     1853               , ",,,,,,NO,,"
     1854               ,?
     1855               , output post-grp_recids ) .
     1856           if post-grp_recids = "" then do:
     1857               Assign  Postname = 'все':U radpost = 1.
     1858               Display PostName radpost with frame F-Main .
     1859           end.
     1860           else do:
     1861               assign
     1862                 Postname = ''
     1863                 v-nn  = num-entries( post-grp_recids )
     1864               .
     1865               do ii = 1 to v-nn :
     1866                   find cli-post where recid( cli-post ) = int(entry( ii, post-grp_recids )) no-lock no-error .
     1867                   find first cli-grp where cli-grp.node-code = cli-post.grp-code no-lock no-error .
     1868                   if available cli-post and available cli-grp then do:
     1869                       create g#post-f.
     1870                       assign
     1871                         g#post-f.obj-type = cli-post.obj-type
     1872                         g#post-f.obj-code = cli-post.obj-code
     1873                         g#post-f.obj-name = cli-post.obj-name
     1874                         g#post-f.grp-code = cli-post.grp-code
     1875                         g#post-f.grp-name = cli-post.grp-name
     1876                         g#post-f.lvl-num  = cli-grp.lvl-num
     1877                         Postname = PostName + cli-post.obj-name + chr(10)
     1878                       .
     1879                   end.
     1880               end.
     1881               display PostName with frame F-Main .
     1882           end.
     1883       end.
     1884     End case.
     1885   END.
     1886   if not this-procedure :persistent
     1887   then do:
     1888     message
     1889       vss-workfile vss-revision vss-description skip
     1890       "Ошибка при запуске процедуры" skip
     1891       "Данную процедуру следует запускать только с параметром persistent" skip
     1892       view-as alert-box error .
     1893     undo, return error .
     1894   end.
     1895   PROCEDURE disable_UI :
     1896     HIDE FRAME F-Main.
     1897     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1898   END PROCEDURE.
     1899   PROCEDURE local-initialize :
     1900     RUN dispatch IN THIS-PROCEDURE ( INPUT 'initialize':U ) .
     1901   assign frame F-Main PostName RADPost sort-by-name show-rcv .
     1902   END PROCEDURE.
     1903   PROCEDURE my-report :
     1904   run rep/r-ordrcv.p
     1905       (
     1906        input my-handle
     1907       ,input show-rcv
     1908       ,input sort-by-name
     1909       ,input Radpost
     1910       ,input Postname
     1911       ) .
     1912   END PROCEDURE.
     1913   PROCEDURE my-var :
     1914   assign frame F-Main RADPost sort-by-name show-rcv .
     1915   if RADPost = 0 or RADPost = 1 then PostName = 'все':U.
     1916     assign
     1917       ReportHeader = "Отчет сформирован: " + string(today, "99/99/9999") + chr(10) +
     1918       "Сортировать поставщиков: " + (if sort-by-name then "по имени" else "по коду") + chr(10) +
     1919       (if show-rcv then "Показывать поставки" else "Не показывать поставки")         + chr(10) +
     1920       "Поставщики: " + chr(10) + PostName
     1921     .
     1922   END PROCEDURE.
