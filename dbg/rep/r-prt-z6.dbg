     5766                       trn-doc.flag_           = true              and
     5767                       trn-doc.Fact-order      <= fact-order-2     and
     5768                       trn-doc.ext-doc-type    = 'ie':U :
     5769                       for each doc-line no-lock where
     5770                           doc-line.doc-code   = trn-doc.doc-code   and
     5771                           doc-line.artic      = goods.artic        and
     5772                           doc-line.prod-code  = goods.prod-code    and
     5773                           doc-line.prod-type  = goods.prod-type    :
     5774                               Assign
     5775                                 f-wait-qnty   = f-wait-qnty     + doc-line.fact-qnty.
     5776                       end.
     5777                   End.
     5778                 End.
     5779                if itog = false and
     5780                   ( p-zero-ost = true or
     5781                   not(f-qnty         = 0 and
     5782                       f-cost-sum     = 0 and
     5783                       f-sale-sum     = 0 and
     5784                       f-sale-other   = 0 and
     5785                       f-free-qnty    = 0 and
     5786                       f-wait-qnty    = 0  ))
     5787                   Then DO:
