     5660                   output  Coast_R1  ,
     5661                   output  Coast_V1  ,
     5662                   output  VAT_R1    ,
     5663                   output  VAT_V1    ,
     5664                   output  SLT_R1    ,
     5665                   output  SLT_V1    ).
     5666                Assign
     5667                   f-cost-sum   = if tprintrubl then Coast_R1 else Coast_V1
     5668                   f-cost-pr    = if Quantity1 = 0 then 0 else ( f-cost-sum / Quantity1 )
     5669                   .
     5670   end.
     5671   else do:
     5672        if v-prizn <> "" and goods.prt-root <> Prtroot then do:
     5673           pr-cursor = 0.
     5674                    f-qnty = 0.
     5675            do while pr-cursor < num-entries(v-prizn,","):
     5676                pr-cursor = pr-cursor + 1.
     5677                if entry(pr-cursor,v-prizn,",") <> "" then do:
     5678                    for each prt-obj no-lock where prt-obj.prt-code = integer(entry(pr-cursor,v-prizn,","))
     5679                    and prt-obj.artic = gds-obj.artic
     5680                    and prt-obj.obj-code = gds-obj.obj-code
     5681                    and prt-obj.obj-type = gds-obj.obj-type
     5682                    and prt-obj.is-term   =  true
     5683                    :
     5684                    assign
     5685                       f-qnty       =  f-qnty + prt-obj.fact-qnty
     5686                       f-cost-sum   = f-cost-sum + if gds-obj.fact-qnty = 0 then 0 else prt-obj.fact-qnty * determined(gds-obj.fact-base) / gds-obj.fact-qnty
     5687                       f-sale-sum   = f-sale-sum + if gds-obj.fact-qnty = 0 then 0 else prt-obj.fact-qnty * gds-obj.fact-sale / gds-obj.fact-qnty
     5688                       f-free-qnty  = f-free-qnty + prt-obj.free-qnty
     5689                       f-cost-pr   = if prt-obj.fact-qnty  = 0 then 0 else determined(gds-obj.fact-base) / gds-obj.fact-qnty
     5690                       f-sale-pr   = if prt-obj.fact-qnty  = 0 then 0 else prt-obj.price-sale
     5691                       .
     5692                    end.
     5693                end.
     5694            end.
     5695        end.
     5696        else do:
     5697            Assign
     5698               f-qnty       = gds-obj.fact-qnty
     5699               f-cost-sum   = determined(gds-obj.fact-base)
     5700               f-sale-sum   = gds-obj.fact-sale
     5701               f-free-qnty  = gds-obj.free-qnty
     5702               f-cost-pr   = if f-qnty = 0 then 0 else f-cost-sum / f-qnty
     5703               f-sale-pr   = if f-qnty = 0 then 0 else f-sale-sum / f-qnty
     5704             .
     5705         end.
     5706        end.
     5707                 if c-f-rez-qnty     <> ? or
     5708                    c-f-rez-cost     <> ? or
     5709                    c-f-rez-sale     <> ? then do:
     5710                    empty temp-table t-trn-doc .
     5711                    empty temp-table temp_gds-dtl .
     5712                         for each buf_parts no-lock where
     5713                                  buf_parts.artic      = gds-obj.artic       and
     5714                                  buf_parts.prod-type  = gds-obj.prod-type   and
     5715                                  buf_parts.prod-code  = gds-obj.prod-code   and
     5716                                  buf_parts.obj-type   = gds-obj.obj-type    and
     5717                                  buf_parts.obj-code   = gds-obj.obj-code    and
     5718                                  buf_parts.status_    = false               and
     5719                                  buf_parts.rsrv-free  = true    ,
     5720                           first bufi_trn-doc no-lock where
     5721                                 bufi_trn-doc.doc-code = buf_parts.out-code
     5722                                 and
     5723                               ( bufi_trn-doc.doc-type = 'рас':U or
     5724                                 bufi_trn-doc.doc-type = 'спи':U )
     5725                                 :
     5726                                 if not can-find( first t-trn-doc where t-trn-doc.doc-code = bufi_trn-doc.doc-code) then do:
     5727                                     create t-trn-doc.
     5728                                     assign
     5729                                     t-trn-doc.doc-code = bufi_trn-doc.doc-code .
     5730                   .
     5731   end.
     5732                             end.
     5733                             for each t-trn-doc :
     5734                                 for each  bufd_gds-dtl no-lock where
     5735                                           bufd_gds-dtl.doc-code   = t-trn-doc.doc-code  and
     5736                                           bufd_gds-dtl.artic      = gds-obj.artic       and
     5737                                           bufd_gds-dtl.prod-type  = gds-obj.prod-type   and
     5738                                           bufd_gds-dtl.prod-code  = gds-obj.prod-code ,
     5739                                     first buff_doc-line no-lock where
     5740                                           buff_doc-line.doc-code   = bufd_gds-dtl.doc-code  and
     5741                                           buff_doc-line.artic      = bufd_gds-dtl.artic     and
     5742                                           buff_doc-line.prod-type  = bufd_gds-dtl.prod-type and
     5743                                           buff_doc-line.prod-code  = bufd_gds-dtl.prod-code
     5744                                           :
     5745                                           assign
     5746                                             f-rez-qnty = f-rez-qnty  + bufd_gds-dtl.doc-qnty
     5747                                             f-rez-cost = f-rez-cost  + ( bufd_gds-dtl.doc-qnty * buff_doc-line.price-base )
     5748                                             f-rez-sale = f-rez-sale  + ( bufd_gds-dtl.doc-qnty * bufd_gds-dtl.price-base )
     5749                                             f-rez-cost-pr = ( if f-rez-qnty = 0 then 0 else f-rez-cost / f-rez-qnty )
     5750                                           .
     5751                                           create temp_gds-dtl.
     5752                                           buffer-copy bufd_gds-dtl to temp_gds-dtl
     5753                                           assign
     5754                                              temp_gds-dtl.cost-sum = bufd_gds-dtl.doc-qnty * buff_doc-line.price-base
     5755                                              temp_gds-dtl.sale-sum = bufd_gds-dtl.doc-qnty * bufd_gds-dtl.price-base
     5756                                           .
     5757                                 end.
     5758                            end.
     5759                 end.
     5760                 f-sale-other = 100 * determined((f-sale-sum - f-cost-sum) / f-cost-sum).
     5761                 if c-f-wait-qnty <> ? Then DO :
     5762                   for each trn-doc no-lock  where
