     8302                   output  VAT_R1    ,
     8303                   output  VAT_V1    ,
     8304                   output  SLT_R1    ,
     8305                   output  SLT_V1    ).
     8306                Assign
     8307                   f-cost-sum   = if tprintrubl then Coast_R1 else Coast_V1
     8308                   f-cost-pr    = if Quantity1 = 0 then 0 else ( f-cost-sum / Quantity1 )
     8309                   .
     8310   end.
     8311   else do:
