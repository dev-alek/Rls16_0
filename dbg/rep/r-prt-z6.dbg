     6425                     End.
     6426             End.
     6427   if last-of(gds-obj.artic) then DO:
     6428    IF v-var = "no-today" then DO:
     6429                  RUN ost-line in this-procedure
     6430                  (
     6431                   input   gds-obj.obj-code  ,
     6432                   input   gds-obj.obj-type  ,
     6433                   INPUT   gds-obj.artic     ,
     6434                   INPUT   gds-obj.prod-code ,
     6435                   INPUT   gds-obj.prod-type ,
     6436                   input   0                 ,
     6437                   INPUT   fact-order-2      ,
     6438                   input   'crsa':U       ,
     6439                   input   '##,##':U    ,
     6440                   input   yes               ,
     6441                   output  Quantity1         ,
     6442                   output  Coast_R1          ,
     6443                   output  Coast_V1          ,
     6444                   output  VAT_R1            ,
     6445                   output  VAT_V1            ,
     6446                   output  SLT_R1            ,
     6447                   output  SLT_V1            ).
     6448                Assign
     6449                   f-qnty       = Quantity1
     6450                   f-sale-sum   = if tprintrubl then Coast_R1 else Coast_V1
     6451                   f-sale-pr    = if f-qnty = 0 then 0 else f-sale-sum / f-qnty
     6452                   .
     6453                  RUN ost-line in this-procedure
     6454                  (
     6455                   input   gds-obj.obj-code  ,
     6456                   input   gds-obj.obj-type  ,
     6457                   INPUT   gds-obj.artic     ,
     6458                   INPUT   gds-obj.prod-code ,
     6459                   INPUT   gds-obj.prod-type ,
     6460                   input   0                 ,
     6461                   INPUT   fact-order-2      ,
     6462                   input   'cost':U       ,
     6463                   input   '##,##':U    ,
     6464                   input   yes      ,
     6465                   output  Quantity1   ,
     6466                   output  Coast_R1  ,
     6467                   output  Coast_V1  ,
     6468                   output  VAT_R1    ,
     6469                   output  VAT_V1    ,
     6470                   output  SLT_R1    ,
     6471                   output  SLT_V1    ).
     6472                Assign
     6473                   f-cost-sum   = if tprintrubl then Coast_R1 else Coast_V1
     6474                   f-cost-pr    = if Quantity1 = 0 then 0 else ( f-cost-sum / Quantity1 )
     6475                   .
     6476   end.
     6477   else do:
     6478        if v-prizn <> "" and goods.prt-root <> Prtroot then do:
     6479           pr-cursor = 0.
     6480                    f-qnty = 0.
     6481            do while pr-cursor < num-entries(v-prizn,","):
     6482                pr-cursor = pr-cursor + 1.
     6483                if entry(pr-cursor,v-prizn,",") <> "" then do:
     6484                    for each prt-obj no-lock where prt-obj.prt-code = integer(entry(pr-cursor,v-prizn,","))
     6485                    and prt-obj.artic = gds-obj.artic
     6486                    and prt-obj.obj-code = gds-obj.obj-code
     6487                    and prt-obj.obj-type = gds-obj.obj-type
     6488                    and prt-obj.is-term   =  true
     6489                    :
     6490                    assign
     6491                       f-qnty       =  f-qnty + prt-obj.fact-qnty
     6492                       f-cost-sum   = f-cost-sum + if gds-obj.fact-qnty = 0 then 0 else prt-obj.fact-qnty * determined(gds-obj.fact-base) / gds-obj.fact-qnty
     6493                       f-sale-sum   = f-sale-sum + if gds-obj.fact-qnty = 0 then 0 else prt-obj.fact-qnty * gds-obj.fact-sale / gds-obj.fact-qnty
     6494                       f-free-qnty  = f-free-qnty + prt-obj.free-qnty
     6495                       f-cost-pr   = if prt-obj.fact-qnty  = 0 then 0 else determined(gds-obj.fact-base) / gds-obj.fact-qnty
     6496                       f-sale-pr   = if prt-obj.fact-qnty  = 0 then 0 else prt-obj.price-sale
     6497                       .
     6498                    end.
     6499                end.
     6500            end.
     6501        end.
     6502        else do:
     6503            Assign
     6504               f-qnty       = gds-obj.fact-qnty
     6505               f-cost-sum   = determined(gds-obj.fact-base)
     6506               f-sale-sum   = gds-obj.fact-sale
     6507               f-free-qnty  = gds-obj.free-qnty
     6508               f-cost-pr   = if f-qnty = 0 then 0 else f-cost-sum / f-qnty
     6509               f-sale-pr   = if f-qnty = 0 then 0 else f-sale-sum / f-qnty
     6510             .
     6511         end.
     6512        end.
     6513                 if c-f-rez-qnty     <> ? or
     6514                    c-f-rez-cost     <> ? or
     6515                    c-f-rez-sale     <> ? then do:
     6516                    empty temp-table t-trn-doc .
     6517                    empty temp-table temp_gds-dtl .
     6518                         for each buf_parts no-lock where
     6519                                  buf_parts.artic      = gds-obj.artic       and
     6520                                  buf_parts.prod-type  = gds-obj.prod-type   and
     6521                                  buf_parts.prod-code  = gds-obj.prod-code   and
     6522                                  buf_parts.obj-type   = gds-obj.obj-type    and
     6523                                  buf_parts.obj-code   = gds-obj.obj-code    and
     6524                                  buf_parts.status_    = false               and
     6525                                  buf_parts.rsrv-free  = true    ,
     6526                           first bufi_trn-doc no-lock where
     6527                                 bufi_trn-doc.doc-code = buf_parts.out-code
     6528                                 and
     6529                               ( bufi_trn-doc.doc-type = 'рас':U or
     6530                                 bufi_trn-doc.doc-type = 'спи':U )
     6531                                 :
     6532                                 if not can-find( first t-trn-doc where t-trn-doc.doc-code = bufi_trn-doc.doc-code) then do:
     6533                                     create t-trn-doc.
     6534                                     assign
     6535                                     t-trn-doc.doc-code = bufi_trn-doc.doc-code .
     6536                   .
     6537   end.
     6538                             end.
     6539                             for each t-trn-doc :
     6540                                 for each  bufd_gds-dtl no-lock where
     6541                                           bufd_gds-dtl.doc-code   = t-trn-doc.doc-code  and
     6542                                           bufd_gds-dtl.artic      = gds-obj.artic       and
     6543                                           bufd_gds-dtl.prod-type  = gds-obj.prod-type   and
     6544                                           bufd_gds-dtl.prod-code  = gds-obj.prod-code ,
     6545                                     first buff_doc-line no-lock where
     6546                                           buff_doc-line.doc-code   = bufd_gds-dtl.doc-code  and
     6547                                           buff_doc-line.artic      = bufd_gds-dtl.artic     and
     6548                                           buff_doc-line.prod-type  = bufd_gds-dtl.prod-type and
     6549                                           buff_doc-line.prod-code  = bufd_gds-dtl.prod-code
     6550                                           :
     6551                                           assign
     6552                                             f-rez-qnty = f-rez-qnty  + bufd_gds-dtl.doc-qnty
     6553                                             f-rez-cost = f-rez-cost  + ( bufd_gds-dtl.doc-qnty * buff_doc-line.price-base )
     6554                                             f-rez-sale = f-rez-sale  + ( bufd_gds-dtl.doc-qnty * bufd_gds-dtl.price-base )
     6555                                             f-rez-cost-pr = ( if f-rez-qnty = 0 then 0 else f-rez-cost / f-rez-qnty )
     6556                                           .
     6557                                           create temp_gds-dtl.
     6558                                           buffer-copy bufd_gds-dtl to temp_gds-dtl
     6559                                           assign
     6560                                              temp_gds-dtl.cost-sum = bufd_gds-dtl.doc-qnty * buff_doc-line.price-base
     6561                                              temp_gds-dtl.sale-sum = bufd_gds-dtl.doc-qnty * bufd_gds-dtl.price-base
     6562                                           .
     6563                                 end.
     6564                            end.
     6565                 end.
     6566                 f-sale-other = 100 * determined((f-sale-sum - f-cost-sum) / f-cost-sum).
     6567                 if c-f-wait-qnty <> ? Then DO :
     6568                   for each trn-doc no-lock  where
     6569                       trn-doc.obj-code        = obj-list.obj-code and
