     8159   .
     8160    For Each gds-obj where
     8161             gds-obj.obj-code    = obj-list.obj-code and
     8162             gds-obj.obj-type    = obj-list.obj-type
     8163             no-lock,
     8164             first goods where
     8165                   goods.prod-type = gds-obj.prod-type and
     8166                   goods.prod-code = gds-obj.prod-code and
     8167                   goods.artic     = gds-obj.artic  and
     8168                   goods.gds-type    = 'т':U
     8169                                 no-lock
     8170             , first gds-list where
     8171                     gds-list.prod-type =  gds-obj.prod-type and
     8172                     gds-list.prod-code =  gds-obj.prod-code and
     8173                     gds-list.artic     =  gds-obj.artic
     8174                     no-lock
     8175               break
     8176                   by gds-list.qnty
     8177                   by ( gds-obj.artic + gds-obj.prod-type + string ( gds-obj.prod-code ))
     8178                   by gds-obj.artic
     8179                   with FRAME Zapas :
     8180                        pr-cursor = 0.
     8181                        go-work = false.
     8182                        if v-prizn = "" then do:
     8183                           go-work = true.
     8184                        end.
     8185                        else do:
     8186                             if goods.prt-root <> Prtroot then
     8187                             do while pr-cursor < num-entries(v-prizn,","):
     8188                             pr-cursor = pr-cursor + 1.
     8189                                 if entry(pr-cursor,v-prizn,",") <> "" then do:
     8190                                     for first prt-obj where
     8191                                     prt-obj.artic     = goods.artic     and
     8192                                     prt-obj.prod-type = goods.prod-type and
     8193                                     prt-obj.prod-code = goods.prod-code and
     8194                                     prt-obj.obj-code  = obj-list.obj-code and
     8195                                     prt-obj.obj-type  = obj-list.obj-type and
     8196                                     prt-obj.is-term   =  true  and
     8197                                     prt-obj.prt-code  = integer(entry(pr-cursor,v-prizn,","))
     8198                                     no-lock:
     8199                                         pr-cursor = num-entries(v-prizn,",").
     8200                                         go-work = true.
     8201                                         v-tmp-prt = integer(entry(pr-cursor,v-prizn,",")).
     8202                                     end.
     8203                                 end.
     8204                             end.
     8205                         end.
     8206                   if go-work then do:
     8207                   n-nm = n-nm + 1.
     8208   IF ( n-nm modulo v-account = 0 )  then DO:
     8209             if  log-manager:logfile-name ne ?
