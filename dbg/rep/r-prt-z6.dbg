     6326      if Make-Excel then  put   stream ForExcel unformatted  obj-list.obj-name chr(10).
     6327     end.
     6328             n-nn = 0.
     6329             n-no = n-no + 1 .
     6330   .
     6331    For Each gds-obj where
     6332             gds-obj.obj-code    = obj-list.obj-code and
     6333             gds-obj.obj-type    = obj-list.obj-type
     6334             no-lock,
     6335             first goods where
     6336                   goods.prod-type = gds-obj.prod-type and
     6337                   goods.prod-code = gds-obj.prod-code and
     6338                   goods.artic     = gds-obj.artic  and
     6339                   goods.gds-type    = 'т':U
     6340                                 no-lock
     6341               break
     6342                   by gds-obj.prod-type By gds-obj.prod-code by gds-obj.artic
     6343                   with FRAME Zapas :
     6344                        pr-cursor = 0.
     6345                        go-work = false.
     6346                        if v-prizn = "" then do:
     6347                           go-work = true.
     6348                        end.
     6349                        else do:
     6350                             if goods.prt-root <> Prtroot then
     6351                             do while pr-cursor < num-entries(v-prizn,","):
     6352                             pr-cursor = pr-cursor + 1.
     6353                                 if entry(pr-cursor,v-prizn,",") <> "" then do:
     6354                                     for first prt-obj where
     6355                                     prt-obj.artic     = goods.artic     and
     6356                                     prt-obj.prod-type = goods.prod-type and
     6357                                     prt-obj.prod-code = goods.prod-code and
     6358                                     prt-obj.obj-code  = obj-list.obj-code and
     6359                                     prt-obj.obj-type  = obj-list.obj-type and
     6360                                     prt-obj.is-term   =  true  and
     6361                                     prt-obj.prt-code  = integer(entry(pr-cursor,v-prizn,","))
     6362                                     no-lock:
     6363                                         pr-cursor = num-entries(v-prizn,",").
     6364                                         go-work = true.
     6365                                         v-tmp-prt = integer(entry(pr-cursor,v-prizn,",")).
     6366                                     end.
     6367                                 end.
     6368                             end.
     6369                         end.
     6370                   if go-work then do:
     6371                   n-nm = n-nm + 1.
     6372   IF ( n-nm modulo v-account = 0 )  then DO:
     6373             if  log-manager:logfile-name ne ?
     6374             then DO:
     6375                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     6376             end.
     6377              if mFrameView
     6378              then do:
     6379               DISPLAY
     6380                 n-nm @ RecordsDone
     6381                 WITH FRAME InfoFrame.
     6382              end.
     6383   End.
     6384      if v-button-stop then  DO:
     6385            if mFrameView
     6386            then
     6387               PROCESS EVENTS.
     6388            IF StopProcessing THEN DO:
     6389            RETURN error.
     6390            End.
     6391      end.
     6392                   IF first-of(gds-obj.artic) then DO:
     6393                   assign
     6394                     f-qnty         = 0
     6395                     f-cost-sum     = 0
     6396                     f-sale-sum     = 0
     6397                     f-cost-pr      = 0
     6398                     f-sale-pr      = 0
     6399                     f-sale-other   = 0
     6400                     f-free-qnty    = 0
     6401                     f-wait-qnty    = 0
     6402                     f-rez-qnty     = 0
     6403                     f-rez-cost     = 0
     6404                     f-rez-sale     = 0
     6405                     f-rez-cost-pr  = 0
     6406                     tot-v-sale-sum = 0
     6407                     tot-v-cost-sum = 0
     6408                     .
     6409                   End.
     6410             if first-of(gds-obj.prod-code)  and classify = 2 then DO:
     6411                 FIND FIRST clients-p where  gds-obj.prod-type = clients-p.obj-type AND
     6412                                             gds-obj.prod-code = clients-p.obj-code no-lock no-error.
     6413                  if avail clients-p then var-client = Clients-p.obj-name.
     6414                     if  Itog = false Then do:
     6415     if c-f-gds-name <>  ?  then do :
     6416       c-f-gds-name:screen-value = string(var-client) .
     6417       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     6418           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
