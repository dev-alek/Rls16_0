     8294                   input   0                 ,
     8295                   INPUT   fact-order-2      ,
     8296                   input   'cost':U       ,
     8297                   input   '##,##':U    ,
     8298                   input   yes      ,
     8299                   output  Quantity1   ,
     8300                   output  Coast_R1  ,
