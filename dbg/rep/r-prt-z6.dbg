     8905   procedure display-prt :
     8906   define variable pr-cursor as integer no-undo init 0.
     8907   define variable go-work   as logical no-undo init no.
     8908   define variable v-tmp-prt like gds-prt.node-code init -1.
     8909   IF goods.prt-root <> Prtroot Then DO:
     8910       If v-var = "no-today"  then do:
     8911   run  prdoclib-init-prt-obj-by-factord in this-procedure
     8912   ( input gds-obj.obj-type  ,
     8913     input gds-obj.obj-code  ,
     8914     input gds-obj.artic     ,
     8915     input gds-obj.prod-type ,
     8916     input gds-obj.prod-code ,
     8917     input fact-order-2 ,
     8918     input false ) .
     8919       end.
     8920     for each prt-obj where
     8921         prt-obj.artic     = goods.artic     and
     8922         prt-obj.prod-type = goods.prod-type and
     8923         prt-obj.prod-code = goods.prod-code and
     8924         prt-obj.obj-code  = obj-list.obj-code and
     8925         prt-obj.obj-type  = obj-list.obj-type and
     8926         prt-obj.is-term   =  true no-lock
     8927         BREAK BY prt-obj.prt-code with FRAME Zapas :
     8928         pr-cursor = 0.
     8929         go-work = false.
     8930         if v-prizn = "" then do:
     8931           go-work = true.
     8932         end.
     8933         else do:
     8934             do while pr-cursor < num-entries(v-prizn,","):
     8935                 pr-cursor = pr-cursor + 1.
     8936                 if entry(pr-cursor,v-prizn,",") <> "" then do:
     8937                     if integer(entry(pr-cursor,v-prizn,",")) = prt-obj.prt-code then do:
     8938                         pr-cursor = num-entries(v-prizn,",").
     8939                         go-work = true.
     8940                     end.
     8941                 end.
     8942             end.
     8943         end.
     8944         if go-work then do:
     8945             if v-var <> "no-today" then do:
     8946                 Assign
     8947                   p-qnty      = p-qnty       + prt-obj.fact-qnty
     8948                   p-free-qnty = p-free-qnty  + prt-obj.free-qnty
     8949                   p-sale-sum  = p-sale-sum   + prt-obj.fact-qnty * prt-obj.price-sale
     8950                   p-sale-pr   = if p-qnty = 0 then 0 else p-sale-sum / p-qnty
     8951                   .
     8952             End.
     8953             IF last-of(prt-obj.prt-code) THEN DO:
     8954   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     8955     (input  gds-obj.gds-code
     8956     ,input  prt-obj.prt-code
     8957     ,output v-bar-code
     8958     )  .
     8959                 if v-var = "no-today" then do:
     8960                   find first temp-prt-obj no-lock
     8961                        where temp-prt-obj.prt-obj-recid   = recid (prt-obj) no-error .
     8962                        if avail temp-prt-obj then do :
     8963                           run  calc-price-sale-for-prt in this-procedure  (output v-price-sale) .
     8964                           Assign
     8965                             p-qnty      = temp-prt-obj.fact-qnty
     8966                             p-free-qnty = 0
     8967                             p-sale-sum  = temp-prt-obj.fact-qnty * v-price-sale
     8968                             p-sale-pr   = if p-qnty = 0 then 0 else p-sale-sum / p-qnty
     8969                             .
     8970                         End.
     8971                         Else
     8972                           Assign
     8973                             p-qnty      = 0
     8974                             p-free-qnty = 0
     8975                             p-sale-sum  = 0   .
     8976                 End.
     8977           FIND first gds-prt  where gds-prt.node-code = prt-obj.prt-code NO-LOCK no-error .
     8978           if c-f-wait-qnty <> ? Then DO :
     8979             for each trn-doc no-lock  where
     8980                 trn-doc.obj-code        = obj-list.obj-code and
     8981                 trn-doc.obj-type        = obj-list.obj-type and
     8982                 trn-doc.status_         = 'накл':U           and
     8983                 trn-doc.flag_           = true              and
     8984                 trn-doc.ext-doc-type    = 'ie':U :
     8985                 for each gds-dtl no-lock where
     8986                     gds-dtl.doc-code   = trn-doc.doc-code   and
     8987                     gds-dtl.artic      = goods.artic        and
     8988                     gds-dtl.prod-code  = goods.prod-code    and
     8989                     gds-dtl.prod-type  = goods.prod-type    and
     8990                     gds-dtl.prt-code   = prt-obj.prt-code   and
     8991                     gds-dtl.obj-code   = obj-list.obj-code  and
     8992                     gds-dtl.obj-type   = obj-list.obj-type :
     8993                     Assign
     8994                     p-wait-qnty   = p-wait-qnty     + gds-dtl.fact-qnty.
     8995                 end.
     8996             End.
     8997           End.
     8998           if ( f-rez-qnty <> ? or
     8999               f-rez-cost <> ? or
     9000               f-rez-sale <> ? ) and  v-var <> "no-today"
     9001           then do:
     9002                 for each temp_gds-dtl where
     9003                           temp_gds-dtl.prt-code   = prt-obj.prt-code  :
     9004                     assign
     9005                       p-rez-qnty = p-rez-qnty  + temp_gds-dtl.doc-qnty
     9006                       p-rez-cost = p-rez-cost  + temp_gds-dtl.cost-sum
     9007                       p-rez-sale = p-rez-sale  + temp_gds-dtl.sale-sum
     9008                       p-rez-cost-pr = ( if p-rez-qnty = 0 then 0 else p-rez-cost / p-rez-qnty )
     9009                     .
     9010                 end.
     9011           end.
     9012           Assign
     9013           p-cost-sum     = determined( f-cost-sum * p-qnty  / f-qnty)
     9014           p-sale-other   = 100 * determined((p-sale-sum - p-cost-sum) / p-cost-sum)
     9015           p-cost-pr      = if p-qnty = 0 then 0 else p-cost-sum   / p-qnty
     9016           .
     9017           if not (p-zero = false  and
     9018                (p-qnty        =  0  and
     9019                 p-cost-sum    =  0  and
     9020                 p-sale-sum    =  0  and
     9021                 p-sale-other  =  0  and
     9022                 p-free-qnty   =  0  and
     9023                     p-wait-qnty  = 0  ) ) then do:
     9024     if c-nn <>  ?  then do :
     9025       c-nn:screen-value = string('') .
     9026       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     9027           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     9028           display STREAM OutStream    with frame top-frame .
     9029       End.
     9030     End.
     9031     if c-f-artic <>  ?  then do :
     9032       c-f-artic:screen-value = string('') .
     9033       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     9034           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     9035           display STREAM OutStream    with frame top-frame .
     9036       End.
     9037     End.
     9038     if c-f-b-code <>  ?  then do :
     9039       c-f-b-code:screen-value = string(string(v-bar-code,'999999999')) .
     9040       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     9041           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     9042           display STREAM OutStream    with frame top-frame .
     9043       End.
     9044     End.
     9045     if c-f-prt-name <>  ?  then do :
     9046       c-f-prt-name:screen-value = string(gds-prt.f-name) .
     9047       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     9048           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     9049           display STREAM OutStream    with frame top-frame .
     9050       End.
     9051     End.
     9052     if c-f-qnty <>  ?  then do :
     9053       c-f-qnty:screen-value = string(p-qnty) .
     9054       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     9055           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     9056           display STREAM OutStream    with frame top-frame .
     9057       End.
     9058     End.
     9059     if c-f-cost-pr <>  ?  then do :
     9060       c-f-cost-pr:screen-value = string(p-cost-pr) .
     9061       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     9062           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     9063           display STREAM OutStream    with frame top-frame .
     9064       End.
     9065     End.
     9066     if c-f-cost-sum <>  ?  then do :
     9067       c-f-cost-sum:screen-value = string(p-cost-sum) .
     9068       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     9069           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     9070           display STREAM OutStream    with frame top-frame .
     9071       End.
     9072     End.
     9073     if c-f-sale-pr <>  ?  then do :
     9074       c-f-sale-pr:screen-value = string(p-sale-pr) .
     9075       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     9076           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     9077           display STREAM OutStream    with frame top-frame .
     9078       End.
     9079     End.
     9080     if c-f-sale-sum <>  ?  then do :
     9081       c-f-sale-sum:screen-value = string(p-sale-sum) .
     9082       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     9083           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     9084           display STREAM OutStream    with frame top-frame .
     9085       End.
     9086     End.
     9087     if c-f-sale-other <>  ?  then do :
     9088       c-f-sale-other:screen-value = string(p-sale-other) .
     9089       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     9090           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     9091           display STREAM OutStream    with frame top-frame .
     9092       End.
     9093     End.
     9094     if c-f-free-qnty <>  ?  then do :
     9095       c-f-free-qnty:screen-value = string(p-free-qnty) .
     9096       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     9097           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     9098           display STREAM OutStream    with frame top-frame .
     9099       End.
     9100     End.
     9101     if c-f-wait-qnty <>  ?  then do :
     9102       c-f-wait-qnty:screen-value = string(p-wait-qnty) .
     9103       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     9104           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     9105           display STREAM OutStream    with frame top-frame .
     9106       End.
     9107     End.
     9108     if c-f-rez-qnty <>  ?  then do :
     9109       c-f-rez-qnty:screen-value = string(p-rez-qnty) .
     9110       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     9111           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     9112           display STREAM OutStream    with frame top-frame .
     9113       End.
     9114     End.
     9115     if c-f-rez-cost <>  ?  then do :
     9116       c-f-rez-cost:screen-value = string(p-rez-cost) .
     9117       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     9118           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     9119           display STREAM OutStream    with frame top-frame .
     9120       End.
     9121     End.
     9122     if c-f-rez-sale <>  ?  then do :
     9123       c-f-rez-sale:screen-value = string(p-rez-sale) .
     9124       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     9125           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     9126           display STREAM OutStream    with frame top-frame .
     9127       End.
     9128     End.
     9129     if c-f-rez-cost-pr <>  ?  then do :
     9130       c-f-rez-cost-pr:screen-value = string(p-rez-cost-pr) .
     9131       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     9132           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     9133           display STREAM OutStream    with frame top-frame .
     9134       End.
     9135     End.
     9136               Display stream OutStream no-error.
     9137               DOWN stream OutStream .
     9138               if Make-Excel then  put   stream ForExcel unformatted
     9139               CHR(9)
     9140               string(v-bar-code,"999999999") CHR(9)
     9141                            CHR(9)
     9142                            CHR(9)
     9143                gds-prt.f-name                    CHR(9)
     9144                excel-qnty(p-qnty)                            CHR(9)
     9145                excel-sum(p-cost-pr)                        CHR(9)
     9146                excel-sum(p-cost-sum)                        CHR(9)
     9147                excel-sum(p-sale-pr)                        CHR(9)
     9148                excel-sum(p-sale-sum)                        CHR(9)
     9149                excel-sum(p-sale-other)                      CHR(9)
     9150                excel-sum(p-free-qnty)                       CHR(9)
     9151               excel-sum(p-wait-qnty)   CHR(9)
     9152               excel-sum(p-rez-qnty   ) CHR(9)
     9153               excel-sum(p-rez-cost   ) CHR(9)
     9154               excel-sum(p-rez-sale   ) CHR(9)
     9155               excel-sum(p-rez-cost-pr) CHR(9)
     9156               chr(10) .
     9157           End.
     9158           Assign
     9159             p-qnty        =  0
     9160             p-cost-sum    =  0
     9161             p-sale-sum    =  0
     9162             p-sale-other  =  0
     9163             p-free-qnty   =  0
     9164             p-wait-qnty   =  0
     9165             p-rez-qnty     = 0
     9166             p-rez-cost     = 0
     9167             p-rez-sale     = 0
     9168             p-rez-cost-pr  = 0
     9169             .
     9170       End.
     9171     End.
     9172     end.
     9173   End.
     9174   end procedure.
     9175   PROCEDURE on-same-page :
     9176     define input parameter p-line-number as integer  no-undo .
     9177     if p-line-number > page-size( OutStream ) then do:
     9178       return .
     9179     end.
     9180     if line-counter( OutStream ) + p-line-number > page-size( OutStream ) then do:
     9181       page stream OutStream .
     9182     end.
     9183   end procedure.
     9184   PROCEDURE ostatok :
     9185   def input parameter x-store-code  like ub.clients.obj-code    no-undo.
     9186   def input parameter x-store-type  like ub.clients.obj-type    no-undo.
     9187   def input parameter x-tog-shift   as   logical             no-undo.
     9188   def input parameter x-date-start  like ub.stk-tot.Fact-date   no-undo.
     9189   def input parameter x-date-end    like ub.stk-tot.Fact-date   no-undo.
     9190   def input parameter x-shift-start as integer               no-undo.
     9191   def input parameter x-shift-end   as integer               no-undo.
     9192   def input parameter x-sum-type    like ub.stk-tot.sum-type    no-undo.
     9193   def input parameter x-cat-id      like ub.stk-tot.cat-id      no-undo.
     9194   def input parameter xTog-obj   as log no-undo.
     9195   def output parameter Quantity    like ub.stk-tot.fact-qnty   no-undo.
     9196   def output parameter Coast_R     like ub.stk-tot.sum-rubl    no-undo.
     9197   def output parameter Coast_V     like ub.stk-tot.sum-rubl    no-undo.
     9198   def output parameter VAT_R       like ub.stk-tot.sum-rubl    no-undo.
     9199   def output parameter VAT_V       like ub.stk-tot.sum-rubl    no-undo.
     9200   def output parameter Fact-order  like ub.stk-tot.Fact-order  no-undo.
     9201   def var              Fact-order#   like ub.stk-tot.Fact-order  no-undo.
     9202   def var              Fact-orderS   as char  no-undo.
     9203   def var x-date-start-t  like ub.stk-tot.shift-date   no-undo.
     9204      Assign
     9205         Fact-order   = 0
     9206         Quantity     = 0
     9207         Coast_R      = 0
     9208         Coast_V      = 0
     9209         VAT_R        = 0
     9210         VAT_V        = 0 .
     9211    x-date-start-t  = x-date-start + 1 .
     9212   IF x-date-end = date('') then DO:
     9213      Fact-order = 0 .
     9214      for each obj-list
     9215          where  ( not xtog-obj or
     9216                 ( x-store-type = obj-list.obj-type and x-store-code = obj-list.obj-code ))
     9217                 no-lock :
     9218         if  x-tog-shift = false then do:
     9219                          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     9220                               ub.stk-tot.Fact-date <=  x-date-start
     9221                               and ub.stk-tot.shift-num = 0
     9222                               USE-INDEX fact-date no-lock no-error .
     9223              if Available ub.stk-tot THEN  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     9224         End.
     9225         Else  DO :
     9226             find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     9227              (ub.stk-tot.shift-date  = x-date-start-t and
     9228               ub.stk-tot.shift-num  < x-shift-start or
     9229               ub.stk-tot.shift-date  < x-date-start-t  )
     9230               and ub.stk-tot.shift-num  > 0
     9231               USE-INDEX Shift-num no-lock no-error .
     9232            If Available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     9233           END.
     9234       If Fact-order < Fact-order#  and Fact-order# <> 0  THEN  Fact-order = Fact-order# .
     9235     End.
     9236   End.
     9237   Else DO:
     9238     For each obj-list  WHERE
     9239        (NOT xTog-obj OR (x-store-type = obj-list.obj-type AND x-store-code = obj-list.obj-code))
     9240         no-lock :
     9241      IF  x-TOG-Shift = False Then DO:
     9242          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     9243               ub.stk-tot.Fact-date <= x-date-end
     9244               and ub.stk-tot.shift-num = 0
     9245               USE-INDEX fact-date no-lock no-error.
     9246          if available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     9247      END.
     9248      Else DO:
     9249           find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     9250               (ub.stk-tot.shift-date  = x-date-end and
     9251               ub.stk-tot.shift-num  <= x-shift-end or
     9252               ub.stk-tot.shift-date  < x-date-end       ) and
     9253               ub.stk-tot.shift-num   > 0      use-index shift-num no-lock no-error.
     9254               if Available ub.stk-tot THEN Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     9255       End.
     9256       if Fact-order < Fact-order#  THEN  Fact-order = Fact-order#.
     9257     End.
     9258   End.
     9259   END PROCEDURE.
     9260   procedure ost-line :
     9261     define input  parameter x-store-code like ub.clients.obj-code    no-undo .
     9262     define input  parameter x-store-type like ub.clients.obj-type    no-undo .
     9263     define input  parameter x-artic      like ub.stk-line.artic      no-undo .
     9264     define input  parameter x-prod-code  like ub.stk-line.prod-code  no-undo .
     9265     define input  parameter x-prod-type  like ub.stk-line.prod-type  no-undo .
     9266     define input  parameter x-tog-shift  as logical no-undo .
     9267     define input  parameter x-fact-order like ub.stk-line.fact-order no-undo .
     9268     define input  parameter x-sum-type   like ub.stk-line.sum-type   no-undo .
     9269     define input  parameter x-cat-id     like ub.stk-line.cat-id     no-undo .
     9270     define input  parameter xtog-obj     as logical no-undo .
     9271     define output parameter quantity     like ub.stk-line.fact-qnty  no-undo .
     9272     define output parameter coast_r      like ub.stk-line.sum-rubl   no-undo .
     9273     define output parameter coast_v      like ub.stk-line.sum-rubl   no-undo .
     9274     define output parameter vat_r        like ub.stk-line.sum-rubl   no-undo .
     9275     define output parameter vat_v        like ub.stk-line.sum-rubl   no-undo .
     9276     define output parameter slt_r        like ub.stk-line.sum-rubl   no-undo .
     9277     define output parameter slt_v        like ub.stk-line.sum-rubl   no-undo .
     9278     define buffer buff-obj-list  for obj-list .
     9279     define buffer buff-stk-line  for ub.stk-line .
     9280     assign
     9281       Quantity = 0
     9282       Coast_R  = 0
     9283       Coast_V  = 0
     9284       VAT_R    = 0
     9285       VAT_V    = 0
     9286       SLT_R    = 0
     9287       SLT_V    = 0
     9288     .
     9289     if  x-tog-shift = false then do:
     9290       for each buff-obj-list no-lock
     9291         where xtog-obj = false
     9292            or (buff-obj-list.obj-type = x-store-type
     9293               and buff-obj-list.obj-code = x-store-code
     9294               )
     9295       on error undo, return error
     9296       :
     9297       find last buff-stk-line no-lock
     9298         where buff-stk-line.obj-type   = buff-obj-list.obj-type
     9299           and buff-stk-line.obj-code   = buff-obj-list.obj-code
     9300           and buff-stk-line.artic      = x-artic
     9301           and buff-stk-line.prod-type  = x-prod-type
     9302           and buff-stk-line.prod-code  = x-prod-code
     9303           and buff-stk-line.sum-type   = x-sum-type
     9304           and buff-stk-line.cat-id     = '##,##':U
     9305           and buff-stk-line.fact-order <= x-fact-order
     9306           and buff-stk-line.shift-num  = 0
     9307         use-index category
     9308         no-error .
     9309       if available buff-stk-line then do:
     9310         assign
     9311           Quantity = Quantity + buff-stk-line.fact-qnty
     9312           Coast_R  = Coast_R  + buff-stk-line.sum-rubl
     9313           Coast_V  = Coast_V  + buff-stk-line.sum-base
     9314           VAT_R    = VAT_R    + buff-stk-line.VAT-rubl
     9315           VAT_V    = VAT_V    + buff-stk-line.VAT-base
     9316           SLT_R    = SLT_R    + buff-stk-line.SLT-rubl
     9317           SLT_V    = SLT_V    + buff-stk-line.SLT-base
     9318         .
     9319       end.
     9320      end.
     9321     end.
     9322     else do:
     9323       for each buff-obj-list no-lock
     9324         where xtog-obj = false
     9325            or (buff-obj-list.obj-type = x-store-type
     9326               and buff-obj-list.obj-code = x-store-code
     9327               )
     9328       on error undo, return error
     9329       :
     9330         find last buff-stk-line no-lock
     9331           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     9332             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     9333             and buff-stk-line.artic      = x-artic
     9334             and buff-stk-line.prod-type  = x-prod-type
     9335             and buff-stk-line.prod-code  = x-prod-code
     9336             and buff-stk-line.sum-type   = x-sum-type
     9337             and buff-stk-line.cat-id     = '##,##':U
     9338             and buff-stk-line.fact-order <= x-fact-order
     9339             and buff-stk-line.shift-num  > 0
     9340           use-index category
     9341           no-error .
     9342         if available buff-stk-line then do:
     9343           assign
     9344             Quantity = Quantity +  buff-stk-line.fact-qnty
     9345             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     9346             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     9347             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     9348             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     9349             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     9350             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     9351           .
     9352         end.
     9353       end.
     9354     end.
     9355   end procedure.
     9356   procedure ost-lineother-tax :
     9357     define input  parameter x-store-code like ub.clients.obj-code      no-undo.
     9358     define input  parameter x-store-type like ub.clients.obj-type      no-undo.
     9359     define input  parameter x-artic      like ub.stk-line.artic        no-undo.
     9360     define input  parameter x-prod-code  like ub.stk-line.prod-code    no-undo.
     9361     define input  parameter x-prod-type  like ub.stk-line.prod-type    no-undo.
     9362     define input  parameter x-tog-shift  as logical no-undo .
     9363     define input  parameter x-fact-order like ub.stk-line.fact-order   no-undo.
     9364     define input  parameter x-sum-type   like ub.stk-line.sum-type     no-undo.
     9365     define input  parameter x-type-id    like ub.stk-line.cat-id       no-undo.
     9366     define input  parameter xTog-obj     as logical no-undo .
     9367     define output parameter Quantity     like ub.stk-line.fact-qnty   no-undo.
     9368     define output parameter Coast_R      like ub.stk-line.sum-rubl    no-undo.
     9369     define output parameter Coast_V      like ub.stk-line.sum-rubl    no-undo.
     9370     define output parameter VAT_R        like ub.stk-line.sum-rubl    no-undo.
     9371     define output parameter VAT_V        like ub.stk-line.sum-rubl    no-undo.
     9372     define output parameter SLT_R        like ub.stk-line.sum-rubl    no-undo.
     9373     define output parameter SLT_V        like ub.stk-line.sum-rubl    no-undo.
     9374     define output parameter other_R      like ub.stk-line.sum-rubl    no-undo.
     9375     define output parameter other_V      like ub.stk-line.sum-rubl    no-undo.
     9376     define buffer buff-obj-list  for obj-list .
     9377     define buffer buff-stk-line  for ub.stk-line .
     9378     assign
     9379       Quantity = 0
     9380       Coast_R  = 0
     9381       Coast_V  = 0
     9382       VAT_R    = 0
     9383       VAT_V    = 0
     9384       SLT_R    = 0
     9385       SLT_V    = 0
     9386       other_R  = 0
     9387       other_V  = 0
     9388     .
     9389     if  x-tog-shift = false then do:
     9390       for each buff-obj-list no-lock
     9391         where xtog-obj = false
     9392            or (buff-obj-list.obj-type = x-store-type
     9393               and buff-obj-list.obj-code = x-store-code
     9394               )
     9395       on error undo, return error
     9396       :
     9397       find last buff-stk-line no-lock
     9398         where buff-stk-line.obj-type   = buff-obj-list.obj-type
     9399           and buff-stk-line.obj-code   = buff-obj-list.obj-code
     9400           and buff-stk-line.artic      = x-artic
     9401           and buff-stk-line.prod-type  = x-prod-type
     9402           and buff-stk-line.prod-code  = x-prod-code
     9403           and buff-stk-line.sum-type   = x-sum-type
     9404           and buff-stk-line.cat-id     = '##,##':U
     9405           and buff-stk-line.fact-order <= x-fact-order
     9406           and buff-stk-line.shift-num  = 0
     9407         use-index category
     9408         no-error .
     9409       if available buff-stk-line then do:
     9410         assign
     9411           Quantity = Quantity + buff-stk-line.fact-qnty
     9412           Coast_R  = Coast_R  + buff-stk-line.sum-rubl
     9413           Coast_V  = Coast_V  + buff-stk-line.sum-base
     9414           VAT_R    = VAT_R    + buff-stk-line.VAT-rubl
     9415           VAT_V    = VAT_V    + buff-stk-line.VAT-base
     9416           SLT_R    = SLT_R    + buff-stk-line.SLT-rubl
     9417           SLT_V    = SLT_V    + buff-stk-line.SLT-base
     9418           other_R  = other_R  + buff-stk-line.other-rubl
     9419           other_V  = other_V  + buff-stk-line.other-base
     9420         .
     9421       end.
     9422    end.
     9423     end.
     9424     else do:
     9425       for each buff-obj-list no-lock
     9426         where xtog-obj = false
     9427            or (buff-obj-list.obj-type = x-store-type
     9428               and buff-obj-list.obj-code = x-store-code
     9429               )
     9430       on error undo, return error
     9431       :
     9432         find last buff-stk-line no-lock
     9433           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     9434             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     9435             and buff-stk-line.artic      = x-artic
     9436             and buff-stk-line.prod-type  = x-prod-type
     9437             and buff-stk-line.prod-code  = x-prod-code
     9438             and buff-stk-line.sum-type   = x-sum-type
     9439             and buff-stk-line.cat-id     = '##,##':U
     9440             and buff-stk-line.fact-order <= x-fact-order
     9441             and buff-stk-line.shift-num  > 0
     9442           use-index category
     9443           no-error .
     9444         if available buff-stk-line then do:
     9445           assign
     9446             Quantity = Quantity +  buff-stk-line.fact-qnty
     9447             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     9448             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     9449             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     9450             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     9451             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     9452             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     9453             other_R = other_R   +  buff-stk-line.other-rubl
     9454             other_V = other_V   +  buff-stk-line.other-base
     9455           .
     9456         end.
     9457       end.
     9458     end.
     9459   end procedure.
     9460   procedure ost-line-kg :
     9461     define  input parameter p-obj-code    like ub.stk-line.obj-code   no-undo .
     9462     define  input parameter p-obj-type    like ub.stk-line.obj-type   no-undo .
     9463     define  input parameter p-artic       like ub.stk-line.artic      no-undo .
     9464     define  input parameter p-prod-code   like ub.stk-line.prod-code  no-undo .
     9465     define  input parameter p-prod-type   like ub.stk-line.prod-type  no-undo .
     9466     define  input parameter p-fact-order  like ub.stk-line.fact-order no-undo .
     9467     define output parameter p-quantity-kg like ub.stk-line.fact-qnty  no-undo initial 0.00 .
     9468     define buffer buff-obj-list  for obj-list .
     9469     define buffer buf_doc-line for ub.doc-line .
     9470     define buffer buf_inv-line for ub.inv-line .
     9471     do
     9472     on error undo, return error
     9473     :
     9474       for each buf_doc-line no-lock where
     9475                buf_doc-line.obj-type    = p-obj-type   and
     9476                buf_doc-line.obj-code    = p-obj-code   and
     9477                buf_doc-line.prod-type   = p-prod-type  and
     9478                buf_doc-line.prod-code   = p-prod-code  and
     9479                buf_doc-line.artic       = p-artic      and
     9480                buf_doc-line.status_     = 'факт':U      and
     9481                buf_doc-line.fact-order <= p-fact-order
     9482             by buf_doc-line.fact-order    descending
     9483       :
     9484         find first buf_inv-line no-lock where
     9485                    buf_inv-line.doc-code  = buf_doc-line.doc-code  and
     9486                    buf_inv-line.artic     = buf_doc-line.artic     and
     9487                    buf_inv-line.prod-type = buf_doc-line.prod-type and
     9488                    buf_inv-line.prod-code = buf_doc-line.prod-code no-error .
     9489         if available buf_inv-line
     9490         then do:
     9491           if buf_inv-line.after-cli-qnty <> ?
     9492           then do:
     9493             assign
     9494               p-quantity-kg = buf_inv-line.after-cli-qnty
     9495             .
     9496             leave .
     9497           end.
     9498         end.
     9499       end.
     9500       if p-quantity-kg = ?
     9501       then do:
     9502         assign
     9503           p-quantity-kg = 0
     9504         .
     9505       end.
     9506     end.
     9507   end procedure.
     9508   procedure calc-price-sale-for-prt :
