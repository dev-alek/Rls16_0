     5536      if Make-Excel then  put   stream ForExcel unformatted  obj-list.obj-name chr(10).
     5537     end.
     5538             n-nn = 0.
     5539             n-no = n-no + 1 .
     5540   .
     5541    For Each gds-obj where
     5542             gds-obj.obj-code    = obj-list.obj-code and
     5543             gds-obj.obj-type    = obj-list.obj-type
     5544             no-lock,
     5545             first goods where
     5546                   goods.prod-type = gds-obj.prod-type and
     5547                   goods.prod-code = gds-obj.prod-code and
     5548                   goods.artic     = gds-obj.artic  and
     5549                   goods.gds-type    = 'т':U
     5550                                 no-lock
     5551               break
     5552                   by ( gds-obj.artic + gds-obj.prod-type + string ( gds-obj.prod-code ))
     5553                   by gds-obj.prod-type By gds-obj.prod-code by gds-obj.artic
     5554                   with FRAME Zapas :
     5555                        pr-cursor = 0.
     5556                        go-work = false.
     5557                        if v-prizn = "" then do:
     5558                           go-work = true.
     5559                        end.
     5560                        else do:
     5561                             if goods.prt-root <> Prtroot then
     5562                             do while pr-cursor < num-entries(v-prizn,","):
     5563                             pr-cursor = pr-cursor + 1.
     5564                                 if entry(pr-cursor,v-prizn,",") <> "" then do:
     5565                                     for first prt-obj where
     5566                                     prt-obj.artic     = goods.artic     and
     5567                                     prt-obj.prod-type = goods.prod-type and
     5568                                     prt-obj.prod-code = goods.prod-code and
     5569                                     prt-obj.obj-code  = obj-list.obj-code and
     5570                                     prt-obj.obj-type  = obj-list.obj-type and
     5571                                     prt-obj.is-term   =  true  and
     5572                                     prt-obj.prt-code  = integer(entry(pr-cursor,v-prizn,","))
     5573                                     no-lock:
     5574                                         pr-cursor = num-entries(v-prizn,",").
     5575                                         go-work = true.
     5576                                         v-tmp-prt = integer(entry(pr-cursor,v-prizn,",")).
     5577                                     end.
     5578                                 end.
     5579                             end.
     5580                         end.
     5581                   if go-work then do:
     5582                   n-nm = n-nm + 1.
     5583   IF ( n-nm modulo v-account = 0 )  then DO:
     5584             if  log-manager:logfile-name ne ?
     5585             then DO:
     5586                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     5587             end.
     5588              if mFrameView
     5589              then do:
     5590               DISPLAY
     5591                 n-nm @ RecordsDone
     5592                 WITH FRAME InfoFrame.
     5593              end.
     5594   End.
     5595      if v-button-stop then  DO:
     5596            if mFrameView
     5597            then
     5598               PROCESS EVENTS.
     5599            IF StopProcessing THEN DO:
     5600            RETURN error.
     5601            End.
     5602      end.
     5603                   IF first-of(gds-obj.artic) then DO:
     5604                   assign
     5605                     f-qnty         = 0
     5606                     f-cost-sum     = 0
     5607                     f-sale-sum     = 0
     5608                     f-cost-pr      = 0
     5609                     f-sale-pr      = 0
     5610                     f-sale-other   = 0
     5611                     f-free-qnty    = 0
     5612                     f-wait-qnty    = 0
     5613                     f-rez-qnty     = 0
     5614                     f-rez-cost     = 0
     5615                     f-rez-sale     = 0
     5616                     f-rez-cost-pr  = 0
     5617                     tot-v-sale-sum = 0
     5618                     tot-v-cost-sum = 0
     5619                     .
     5620                   End.
     5621   if last-of(gds-obj.artic) then DO:
     5622    IF v-var = "no-today" then DO:
     5623                  RUN ost-line in this-procedure
     5624                  (
     5625                   input   gds-obj.obj-code  ,
     5626                   input   gds-obj.obj-type  ,
     5627                   INPUT   gds-obj.artic     ,
     5628                   INPUT   gds-obj.prod-code ,
     5629                   INPUT   gds-obj.prod-type ,
     5630                   input   0                 ,
     5631                   INPUT   fact-order-2      ,
     5632                   input   'crsa':U       ,
     5633                   input   '##,##':U    ,
     5634                   input   yes               ,
     5635                   output  Quantity1         ,
     5636                   output  Coast_R1          ,
     5637                   output  Coast_V1          ,
     5638                   output  VAT_R1            ,
     5639                   output  VAT_V1            ,
     5640                   output  SLT_R1            ,
     5641                   output  SLT_V1            ).
     5642                Assign
     5643                   f-qnty       = Quantity1
     5644                   f-sale-sum   = if tprintrubl then Coast_R1 else Coast_V1
     5645                   f-sale-pr    = if f-qnty = 0 then 0 else f-sale-sum / f-qnty
     5646                   .
     5647                  RUN ost-line in this-procedure
     5648                  (
     5649                   input   gds-obj.obj-code  ,
     5650                   input   gds-obj.obj-type  ,
     5651                   INPUT   gds-obj.artic     ,
     5652                   INPUT   gds-obj.prod-code ,
     5653                   INPUT   gds-obj.prod-type ,
     5654                   input   0                 ,
     5655                   INPUT   fact-order-2      ,
     5656                   input   'cost':U       ,
     5657                   input   '##,##':U    ,
     5658                   input   yes      ,
