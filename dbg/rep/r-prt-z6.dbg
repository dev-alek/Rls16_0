     9585       define variable price-cli-with-tax-loco-prl     like ub.doc-line.price-cli  no-undo.
     9586       define variable price-rubl-without-tax-loco-prl like ub.doc-line.price-rubl no-undo.
     9587       define variable price-base-without-tax-loco-prl like ub.doc-line.price-base no-undo.
     9588       define variable price-cli-without-tax-loco-prl  like ub.doc-line.price-base no-undo.
     9589       define variable vat-base-loco-prl               like ub.doc-line.price-base no-undo.
     9590       define variable vat-rubl-loco-prl               like ub.doc-line.price-rubl no-undo.
     9591       define variable vat-cli-loco-prl                like ub.doc-line.price-rubl no-undo.
     9592       define variable slt-base-loco-prl               like ub.doc-line.price-base no-undo.
     9593       define variable slt-rubl-loco-prl               like ub.doc-line.price-rubl no-undo.
     9594       define variable slt-cli-loco-prl                like ub.doc-line.price-rubl no-undo.
     9595       define variable road-tax-base-loco-prl          like ub.doc-line.road-tax   no-undo.
     9596       define variable road-tax-rubl-loco-prl          like ub.doc-line.road-tax   no-undo.
     9597       define variable road-tax-cli-loco-prl           like ub.doc-line.road-tax   no-undo.
     9598       define variable transport-base-loco-prl         like ub.doc-line.price-base no-undo.
     9599       define variable transport-rubl-loco-prl         like ub.doc-line.price-rubl no-undo.
     9600       define variable transport-cli-loco-prl          like ub.doc-line.price-rubl no-undo.
     9601       define variable other-base-loco-prl             like ub.doc-line.price-base no-undo.
     9602       define variable other-rubl-loco-prl             like ub.doc-line.price-rubl no-undo.
     9603       define variable other-cli-loco-prl              like ub.doc-line.price-rubl no-undo.
     9604       define variable exch-rate-cli-loco-prl          like ub.trn-doc.exch-rate   no-undo.
     9605       define variable varinvatp-envdo-prl             as   character              no-undo.
     9606       define variable varinvatp-typeo-prl             as   character              no-undo.
     9607   define variable vss-include-info40 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9608   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodepls in g#library
     9609     (input  gds-obj.obj-type
     9610     ,input  gds-obj.obj-code
     9611     ,input  v-bar-code
     9612     ,input  0
     9613     ,input  fact-order-2
     9614     ,output parrecid-prl
     9615     ,output v-cli-base-rate
     9616     ) no-error .
     9617                 if error-status :error then do:
     9618                   message
     9619                     vss-workfile vss-revision vss-description skip
     9620                     "Ошибка при определении цены бар-кода" skip
     9621                     "Объект" gds-obj.obj-type gds-obj.obj-code skip
     9622                     "Бар-код" v-bar-code skip
     9623                     "fact-order" fact-order-2 skip
     9624                     error-status :get-message(1) skip
     9625                     return-value skip
     9626                     view-as alert-box error .
     9627                 end.
     9628           if parrecid-prl <> ? then do:
     9629             run prl-vat in this-procedure
     9630               (input  parrecid-prl
     9631               ,output price-rubl-with-tax-sale-prl
     9632               ,output price-base-with-tax-sale-prl
     9633               ,output price-rubl-without-tax-sale-prl
     9634               ,output price-base-without-tax-sale-prl
     9635               ,output vat-base-sale-prl
     9636               ,output vat-rubl-sale-prl
     9637               ,output vat-base-buyer-prl
     9638               ,output vat-rubl-buyer-prl
     9639               ,output slt-base-sale-prl
     9640               ,output slt-rubl-sale-prl
     9641               ,output road-tax-base-sale-prl
     9642               ,output road-tax-rubl-sale-prl
     9643               ,output excise-base-sale-prl
     9644               ,output excise-rubl-sale-prl
     9645               ,output discnt-base-sale-prl
     9646               ,output discnt-rubl-sale-prl
     9647               ) no-error .
     9648                   if error-status :error then do:
     9649                     message
     9650                       vss-workfile vss-revision vss-description skip
     9651                       "Ошибка при вызове процеды prl-vat" skip
     9652                       "Документ" ub.doc-line.doc-code skip
     9653                       "Артикул" ub.doc-line.artic ub.doc-line.prod-type ub.doc-line.prod-code skip
     9654                       error-status :get-message(1) skip
     9655                       return-value skip
     9656                       view-as alert-box error .
     9657                   end.
     9658           end.
     9659           else do:
     9660             assign
     9661               price-rubl-with-tax-sale-prl    = 0
     9662               price-base-with-tax-sale-prl    = 0
     9663             .
     9664           end.
     9665     assign
     9666       v-cur-base = price-base-with-tax-sale-prl
     9667     .
     9668   end procedure.
