     8142             n-nn = 0.
     8143             n-no = n-no + 1 .
     8144       For Each gds-obj no-lock  where
     8145             gds-obj.obj-code    = obj-list.obj-code and
     8146             gds-obj.obj-type    = obj-list.obj-type,
     8147             first goods no-lock where
     8148                   goods.prod-type = gds-obj.prod-type and
     8149                   goods.prod-code = gds-obj.prod-code and
     8150                   goods.artic     = gds-obj.artic
     8151                   :
     8152         find first gds-list where gds-list.gds-code = gds-obj.gds-code  no-error .
     8153         if not available  gds-list then create gds-list .
     8154         buffer-copy goods to gds-list
     8155         assign
     8156           gds-list.qnty = func-vat ( input gds-obj.gds-code , input gds-obj.obj-type, input gds-obj.obj-code)
     8157         .
