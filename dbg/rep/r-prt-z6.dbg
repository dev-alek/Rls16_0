     9556       define variable varvatcons-rubl-factovp-prl  like ub.gds-dtl.price-base               no-undo.
     9557       define variable vardsc-rubl-factovp-prl      like ub.gds-dtl.price-base               no-undo.
     9558       define variable varsum-rubl-docovp-prl       like ub.gds-dtl.price-base               no-undo.
     9559       define variable varslt-rubl-docovp-prl       like ub.gds-dtl.price-base               no-undo.
     9560       define variable varvat-rubl-docovp-prl       like ub.gds-dtl.price-base               no-undo.
     9561       define variable varvatcons-rubl-docovp-prl   like ub.gds-dtl.price-base               no-undo.
     9562       define variable vardsc-rubl-docovp-prl       like ub.gds-dtl.price-base               no-undo.
     9563       define variable varfact-qnty-prl             like ub.parts.fact-qnty                  no-undo.
     9564       define variable varcons-qnty-prl             like ub.parts.fact-qnty                  no-undo.
     9565       define variable varis-one-gds-dtl-prl        as   logical                             no-undo.
     9566       define variable varcur-prlprice-base         like ub.gds-dtl.cur-base                 no-undo.
