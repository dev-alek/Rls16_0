     9571       define variable out-vatp-have-vat-slt-prl    as   logical initial yes                 no-undo.
     9572       define buffer   in-vatp-trn-doco-prl  for ub.trn-doc .
     9573       define buffer   in-vatp-partso-prl    for ub.parts   .
     9574       define buffer   in-vatp-doco-prl      for ub.trn-doc .
     9575       define buffer   in-vatp-goodso-prl    for ub.goods   .
     9576       define buffer   in-vatp-sysconfo-prl  for ub.sysconf .
