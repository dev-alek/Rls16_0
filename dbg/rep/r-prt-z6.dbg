     8282                Assign
     8283                   f-qnty       = Quantity1
     8284                   f-sale-sum   = if tprintrubl then Coast_R1 else Coast_V1
     8285                   f-sale-pr    = if f-qnty = 0 then 0 else f-sale-sum / f-qnty
     8286                   .
     8287                  RUN ost-line in this-procedure
     8288                  (
     8289                   input   gds-obj.obj-code  ,
     8290                   input   gds-obj.obj-type  ,
