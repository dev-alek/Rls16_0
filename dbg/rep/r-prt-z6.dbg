     7241   .
     7242    For Each gds-obj where
     7243             gds-obj.obj-code    = obj-list.obj-code and
     7244             gds-obj.obj-type    = obj-list.obj-type
     7245             no-lock,
     7246             first goods where
     7247                   goods.prod-type = gds-obj.prod-type and
     7248                   goods.prod-code = gds-obj.prod-code and
     7249                   goods.artic     = gds-obj.artic  and
     7250                   goods.gds-type    = 'т':U
     7251                                 no-lock
     7252               break
     7253                   by goods.grp-name by ( gds-obj.artic + gds-obj.prod-type + string ( gds-obj.prod-code ))
     7254                   by gds-obj.artic
     7255                   with FRAME Zapas :
     7256                        pr-cursor = 0.
     7257                        go-work = false.
     7258                        if v-prizn = "" then do:
     7259                           go-work = true.
     7260                        end.
     7261                        else do:
     7262                             if goods.prt-root <> Prtroot then
     7263                             do while pr-cursor < num-entries(v-prizn,","):
     7264                             pr-cursor = pr-cursor + 1.
     7265                                 if entry(pr-cursor,v-prizn,",") <> "" then do:
     7266                                     for first prt-obj where
     7267                                     prt-obj.artic     = goods.artic     and
     7268                                     prt-obj.prod-type = goods.prod-type and
     7269                                     prt-obj.prod-code = goods.prod-code and
     7270                                     prt-obj.obj-code  = obj-list.obj-code and
     7271                                     prt-obj.obj-type  = obj-list.obj-type and
     7272                                     prt-obj.is-term   =  true  and
     7273                                     prt-obj.prt-code  = integer(entry(pr-cursor,v-prizn,","))
     7274                                     no-lock:
     7275                                         pr-cursor = num-entries(v-prizn,",").
     7276                                         go-work = true.
     7277                                         v-tmp-prt = integer(entry(pr-cursor,v-prizn,",")).
     7278                                     end.
     7279                                 end.
     7280                             end.
     7281                         end.
     7282                   if go-work then do:
