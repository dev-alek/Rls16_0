     8317                if entry(pr-cursor,v-prizn,",") <> "" then do:
     8318                    for each prt-obj no-lock where prt-obj.prt-code = integer(entry(pr-cursor,v-prizn,","))
     8319                    and prt-obj.artic = gds-obj.artic
     8320                    and prt-obj.obj-code = gds-obj.obj-code
     8321                    and prt-obj.obj-type = gds-obj.obj-type
     8322                    and prt-obj.is-term   =  true
     8323                    :
     8324                    assign
     8325                       f-qnty       =  f-qnty + prt-obj.fact-qnty
     8326                       f-cost-sum   = f-cost-sum + if gds-obj.fact-qnty = 0 then 0 else prt-obj.fact-qnty * determined(gds-obj.fact-base) / gds-obj.fact-qnty
     8327                       f-sale-sum   = f-sale-sum + if gds-obj.fact-qnty = 0 then 0 else prt-obj.fact-qnty * gds-obj.fact-sale / gds-obj.fact-qnty
     8328                       f-free-qnty  = f-free-qnty + prt-obj.free-qnty
     8329                       f-cost-pr   = if prt-obj.fact-qnty  = 0 then 0 else determined(gds-obj.fact-base) / gds-obj.fact-qnty
     8330                       f-sale-pr   = if prt-obj.fact-qnty  = 0 then 0 else prt-obj.price-sale
     8331                       .
     8332                    end.
     8333                end.
     8334            end.
     8335        end.
     8336        else do:
     8337            Assign
     8338               f-qnty       = gds-obj.fact-qnty
     8339               f-cost-sum   = determined(gds-obj.fact-base)
     8340               f-sale-sum   = gds-obj.fact-sale
     8341               f-free-qnty  = gds-obj.free-qnty
     8342               f-cost-pr   = if f-qnty = 0 then 0 else f-cost-sum / f-qnty
     8343               f-sale-pr   = if f-qnty = 0 then 0 else f-sale-sum / f-qnty
     8344             .
     8345         end.
     8346        end.
     8347                 if c-f-rez-qnty     <> ? or
     8348                    c-f-rez-cost     <> ? or
