     8267                   INPUT   gds-obj.artic     ,
     8268                   INPUT   gds-obj.prod-code ,
     8269                   INPUT   gds-obj.prod-type ,
     8270                   input   0                 ,
     8271                   INPUT   fact-order-2      ,
     8272                   input   'crsa':U       ,
