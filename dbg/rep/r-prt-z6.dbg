     7345                   output  Coast_R1          ,
     7346                   output  Coast_V1          ,
     7347                   output  VAT_R1            ,
     7348                   output  VAT_V1            ,
     7349                   output  SLT_R1            ,
     7350                   output  SLT_V1            ).
     7351                Assign
     7352                   f-qnty       = Quantity1
     7353                   f-sale-sum   = if tprintrubl then Coast_R1 else Coast_V1
     7354                   f-sale-pr    = if f-qnty = 0 then 0 else f-sale-sum / f-qnty
     7355                   .
     7356                  RUN ost-line in this-procedure
     7357                  (
     7358                   input   gds-obj.obj-code  ,
     7359                   input   gds-obj.obj-type  ,
     7360                   INPUT   gds-obj.artic     ,
     7361                   INPUT   gds-obj.prod-code ,
     7362                   INPUT   gds-obj.prod-type ,
     7363                   input   0                 ,
     7364                   INPUT   fact-order-2      ,
     7365                   input   'cost':U       ,
     7366                   input   '##,##':U    ,
     7367                   input   yes      ,
     7368                   output  Quantity1   ,
     7369                   output  Coast_R1  ,
     7370                   output  Coast_V1  ,
     7371                   output  VAT_R1    ,
     7372                   output  VAT_V1    ,
     7373                   output  SLT_R1    ,
     7374                   output  SLT_V1    ).
     7375                Assign
     7376                   f-cost-sum   = if tprintrubl then Coast_R1 else Coast_V1
     7377                   f-cost-pr    = if Quantity1 = 0 then 0 else ( f-cost-sum / Quantity1 )
     7378                   .
     7379   end.
     7380   else do:
     7381        if v-prizn <> "" and goods.prt-root <> Prtroot then do:
     7382           pr-cursor = 0.
     7383                    f-qnty = 0.
     7384            do while pr-cursor < num-entries(v-prizn,","):
     7385                pr-cursor = pr-cursor + 1.
     7386                if entry(pr-cursor,v-prizn,",") <> "" then do:
     7387                    for each prt-obj no-lock where prt-obj.prt-code = integer(entry(pr-cursor,v-prizn,","))
     7388                    and prt-obj.artic = gds-obj.artic
     7389                    and prt-obj.obj-code = gds-obj.obj-code
     7390                    and prt-obj.obj-type = gds-obj.obj-type
     7391                    and prt-obj.is-term   =  true
     7392                    :
     7393                    assign
     7394                       f-qnty       =  f-qnty + prt-obj.fact-qnty
     7395                       f-cost-sum   = f-cost-sum + if gds-obj.fact-qnty = 0 then 0 else prt-obj.fact-qnty * determined(gds-obj.fact-base) / gds-obj.fact-qnty
     7396                       f-sale-sum   = f-sale-sum + if gds-obj.fact-qnty = 0 then 0 else prt-obj.fact-qnty * gds-obj.fact-sale / gds-obj.fact-qnty
     7397                       f-free-qnty  = f-free-qnty + prt-obj.free-qnty
     7398                       f-cost-pr   = if prt-obj.fact-qnty  = 0 then 0 else determined(gds-obj.fact-base) / gds-obj.fact-qnty
     7399                       f-sale-pr   = if prt-obj.fact-qnty  = 0 then 0 else prt-obj.price-sale
     7400                       .
     7401                    end.
     7402                end.
     7403            end.
     7404        end.
     7405        else do:
     7406            Assign
     7407               f-qnty       = gds-obj.fact-qnty
     7408               f-cost-sum   = determined(gds-obj.fact-base)
     7409               f-sale-sum   = gds-obj.fact-sale
     7410               f-free-qnty  = gds-obj.free-qnty
     7411               f-cost-pr   = if f-qnty = 0 then 0 else f-cost-sum / f-qnty
     7412               f-sale-pr   = if f-qnty = 0 then 0 else f-sale-sum / f-qnty
     7413             .
     7414         end.
     7415        end.
     7416                 if c-f-rez-qnty     <> ? or
     7417                    c-f-rez-cost     <> ? or
     7418                    c-f-rez-sale     <> ? then do:
     7419                    empty temp-table t-trn-doc .
     7420                    empty temp-table temp_gds-dtl .
     7421                         for each buf_parts no-lock where
     7422                                  buf_parts.artic      = gds-obj.artic       and
     7423                                  buf_parts.prod-type  = gds-obj.prod-type   and
     7424                                  buf_parts.prod-code  = gds-obj.prod-code   and
     7425                                  buf_parts.obj-type   = gds-obj.obj-type    and
     7426                                  buf_parts.obj-code   = gds-obj.obj-code    and
     7427                                  buf_parts.status_    = false               and
     7428                                  buf_parts.rsrv-free  = true    ,
     7429                           first bufi_trn-doc no-lock where
     7430                                 bufi_trn-doc.doc-code = buf_parts.out-code
     7431                                 and
     7432                               ( bufi_trn-doc.doc-type = 'рас':U or
     7433                                 bufi_trn-doc.doc-type = 'спи':U )
     7434                                 :
     7435                                 if not can-find( first t-trn-doc where t-trn-doc.doc-code = bufi_trn-doc.doc-code) then do:
     7436                                     create t-trn-doc.
     7437                                     assign
     7438                                     t-trn-doc.doc-code = bufi_trn-doc.doc-code .
     7439                   .
     7440   end.
     7441                             end.
     7442                             for each t-trn-doc :
     7443                                 for each  bufd_gds-dtl no-lock where
     7444                                           bufd_gds-dtl.doc-code   = t-trn-doc.doc-code  and
     7445                                           bufd_gds-dtl.artic      = gds-obj.artic       and
     7446                                           bufd_gds-dtl.prod-type  = gds-obj.prod-type   and
     7447                                           bufd_gds-dtl.prod-code  = gds-obj.prod-code ,
     7448                                     first buff_doc-line no-lock where
     7449                                           buff_doc-line.doc-code   = bufd_gds-dtl.doc-code  and
     7450                                           buff_doc-line.artic      = bufd_gds-dtl.artic     and
     7451                                           buff_doc-line.prod-type  = bufd_gds-dtl.prod-type and
     7452                                           buff_doc-line.prod-code  = bufd_gds-dtl.prod-code
     7453                                           :
     7454                                           assign
     7455                                             f-rez-qnty = f-rez-qnty  + bufd_gds-dtl.doc-qnty
     7456                                             f-rez-cost = f-rez-cost  + ( bufd_gds-dtl.doc-qnty * buff_doc-line.price-base )
     7457                                             f-rez-sale = f-rez-sale  + ( bufd_gds-dtl.doc-qnty * bufd_gds-dtl.price-base )
     7458                                             f-rez-cost-pr = ( if f-rez-qnty = 0 then 0 else f-rez-cost / f-rez-qnty )
     7459                                           .
     7460                                           create temp_gds-dtl.
     7461                                           buffer-copy bufd_gds-dtl to temp_gds-dtl
     7462                                           assign
     7463                                              temp_gds-dtl.cost-sum = bufd_gds-dtl.doc-qnty * buff_doc-line.price-base
     7464                                              temp_gds-dtl.sale-sum = bufd_gds-dtl.doc-qnty * bufd_gds-dtl.price-base
     7465                                           .
     7466                                 end.
     7467                            end.
     7468                 end.
     7469                 f-sale-other = 100 * determined((f-sale-sum - f-cost-sum) / f-cost-sum).
     7470                 if c-f-wait-qnty <> ? Then DO :
     7471                   for each trn-doc no-lock  where
     7472                       trn-doc.obj-code        = obj-list.obj-code and
     7473                       trn-doc.obj-type        = obj-list.obj-type and
     7474                       trn-doc.status_         = 'накл':U           and
     7475                       trn-doc.flag_           = true              and
     7476                       trn-doc.Fact-order      <= fact-order-2     and
     7477                       trn-doc.ext-doc-type    = 'ie':U :
     7478                       for each doc-line no-lock where
     7479                           doc-line.doc-code   = trn-doc.doc-code   and
     7480                           doc-line.artic      = goods.artic        and
     7481                           doc-line.prod-code  = goods.prod-code    and
     7482                           doc-line.prod-type  = goods.prod-type    :
     7483                               Assign
     7484                                 f-wait-qnty   = f-wait-qnty     + doc-line.fact-qnty.
     7485                       end.
     7486                   End.
     7487                 End.
     7488                if itog = false and
     7489                   ( p-zero-ost = true or
     7490                   not(f-qnty         = 0 and
     7491                       f-cost-sum     = 0 and
     7492                       f-sale-sum     = 0 and
     7493                       f-sale-other   = 0 and
     7494                       f-free-qnty    = 0 and
     7495                       f-wait-qnty    = 0  ))
     7496                   Then DO:
     7497                       n-nn = n-nn + 1 .
