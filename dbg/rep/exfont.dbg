        1   block-level on error undo, throw.
        2   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
        3      DEFINE NEW GLOBAL SHARED VARIABLE hpApi AS HANDLE NO-UNDO.
        4      IF NOT VALID-HANDLE(hpApi) THEN run gbl/windows.p PERSISTENT SET hpApi.
        5   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
        6   DEFINE NEW GLOBAL SHARED VARIABLE hpWinFunc AS HANDLE NO-UNDO.
        7     IF NOT VALID-HANDLE(hpWinFunc) THEN run gbl/winfunc.p PERSISTENT SET hpWinFunc.
        8   FUNCTION GetLastError
        9            RETURNS INTEGER
       10            ()
       11            IN hpWinFunc.
       12   FUNCTION GetParent
       13            RETURNS INTEGER
       14            (input hwnd as INTEGER)
       15            IN hpWinFunc.
       16   FUNCTION ShowLastError
       17            RETURNS INTEGER
       18            ()
       19            IN hpWinFunc.
       20   FUNCTION CreateProcess
       21            RETURNS INTEGER
       22            (input CommandLine as CHAR,
       23             input CurrentDir  as CHAR,
       24             input wShowWindow as INTEGER)
       25            in hpWinFunc.
       26   PROCEDURE CreateDCA EXTERNAL "gdi32" :
       27     DEFINE INPUT  PARAMETER lpszDriver   AS CHARACTER.
       28     DEFINE INPUT  PARAMETER lpszDevice   AS CHARACTER.
       29     DEFINE INPUT  PARAMETER lpszOutput   AS long.
       30     DEFINE INPUT  PARAMETER lpInitData   AS long.
       31     DEFINE RETURN PARAMETER hDC          AS long.
       32   END PROCEDURE.
       33   PROCEDURE DeleteDC EXTERNAL "gdi32" :
       34      DEFINE INPUT  PARAMETER hdc         AS LONG.
       35      DEFINE RETURN PARAMETER ReturnValue AS LONG.
       36   END PROCEDURE.
       37   PROCEDURE DocumentPropertiesA EXTERNAL "winspool.drv" :
       38     DEFINE INPUT  PARAMETER HWND           AS LONG.
       39     DEFINE INPUT  PARAMETER hPrinter       AS LONG.
       40     DEFINE INPUT  PARAMETER pDeviceName    AS CHARACTER.
       41     DEFINE INPUT  PARAMETER pDevmodeOutput AS LONG.
       42     DEFINE INPUT  PARAMETER pDevmodeInput  AS LONG.
       43     DEFINE INPUT  PARAMETER fMode          AS LONG.
       44     DEFINE RETURN PARAMETER ReturnValue    AS LONG.
       45   END PROCEDURE.
       46   PROCEDURE GetProfileStringA EXTERNAL "kernel32" :
       47     DEFINE INPUT  PARAMETER lpAppName        AS CHAR.
       48     DEFINE INPUT  PARAMETER lpKeyName        AS CHAR.
       49     DEFINE INPUT  PARAMETER lpDefault        AS CHAR.
       50     DEFINE OUTPUT PARAMETER lpReturnedString AS CHAR.
       51     DEFINE INPUT  PARAMETER nSize            AS LONG.
       52     DEFINE RETURN PARAMETER nReturnedChars   AS LONG.
       53   END PROCEDURE.
       54   PROCEDURE StartDocA EXTERNAL "gdi32" :
       55     DEFINE INPUT  PARAMETER hdc   AS LONG.
       56     DEFINE INPUT  PARAMETER lpdi  AS LONG.
       57     DEFINE RETURN PARAMETER JobId AS LONG.
       58   END PROCEDURE.
       59   PROCEDURE EndDoc EXTERNAL "gdi32" :
       60     DEFINE INPUT  PARAMETER hdc         AS LONG.
       61     DEFINE RETURN PARAMETER ReturnValue AS LONG.
       62   END PROCEDURE.
       63   PROCEDURE StartPage EXTERNAL "gdi32" :
       64     DEFINE INPUT  PARAMETER hdc         AS LONG.
       65     DEFINE RETURN PARAMETER ReturnValue AS LONG.
       66   END PROCEDURE.
       67   PROCEDURE EndPage EXTERNAL "gdi32" :
       68     DEFINE INPUT  PARAMETER hdc         AS LONG.
       69     DEFINE RETURN PARAMETER ReturnValue AS LONG.
       70   END PROCEDURE.
       71   PROCEDURE TextOutA EXTERNAL "gdi32" :
       72     DEFINE INPUT  PARAMETER hdc         AS LONG.
       73     DEFINE INPUT  PARAMETER nXstart     AS LONG.
       74     DEFINE INPUT  PARAMETER nYstart     AS LONG.
       75     DEFINE INPUT  PARAMETER lpString    AS CHAR.
       76     DEFINE INPUT  PARAMETER cbString    AS LONG.
       77     DEFINE RETURN PARAMETER ReturnValue AS LONG.
       78   END PROCEDURE.
       79   PROCEDURE SetTextAlign EXTERNAL "gdi32" :
       80     DEFINE INPUT  PARAMETER hdc           AS LONG.
       81     DEFINE INPUT  PARAMETER fMode         AS LONG.
       82     DEFINE RETURN PARAMETER fPreviousMode AS LONG.
       83   END PROCEDURE.
       84   PROCEDURE GetDeviceCaps EXTERNAL "GDI32" :
       85      DEFINE INPUT  PARAMETER hdc    AS LONG.
       86      DEFINE INPUT  PARAMETER nIndex AS LONG.
       87      DEFINE RETURN PARAMETER dwCaps AS LONG.
       88   END PROCEDURE.
       89   PROCEDURE MoveToEx EXTERNAL "gdi32" :
       90      DEFINE INPUT  PARAMETER hdc         AS LONG.
       91      DEFINE INPUT  PARAMETER X           AS LONG.
       92      DEFINE INPUT  PARAMETER Y           AS LONG.
       93      DEFINE INPUT  PARAMETER lpPoint     AS LONG.
       94      DEFINE RETURN PARAMETER ReturnValue AS LONG.
       95   END PROCEDURE.
       96   PROCEDURE LineTo EXTERNAL "gdi32" :
       97      DEFINE INPUT  PARAMETER hdc         AS LONG.
       98      DEFINE INPUT  PARAMETER X           AS LONG.
       99      DEFINE INPUT  PARAMETER Y           AS LONG.
      100      DEFINE RETURN PARAMETER ReturnValue AS LONG.
      101   END PROCEDURE.
      102   PROCEDURE SelectObject EXTERNAL "gdi32" :
      103      DEFINE INPUT  PARAMETER hdc         AS LONG.
      104      DEFINE INPUT  PARAMETER hgdiobj     AS LONG.
      105      DEFINE RETURN PARAMETER ReturnValue AS LONG.
      106   END PROCEDURE.
      107   PROCEDURE DeleteObject EXTERNAL "gdi32" :
      108      DEFINE INPUT  PARAMETER hObject     AS LONG.
      109      DEFINE RETURN PARAMETER ReturnValue AS LONG.
      110   END PROCEDURE.
      111   PROCEDURE GetTextMetricsA EXTERNAL "gdi32" :
      112     DEFINE INPUT  PARAMETER hdc         AS LONG.
      113     DEFINE INPUT  PARAMETER lpTm        AS LONG.
      114     DEFINE RETURN PARAMETER ReturnValue AS LONG.
      115   END PROCEDURE.
      116   PROCEDURE CreateFontA EXTERNAL "gdi32" :
      117     DEFINE INPUT  PARAMETER nHeight            AS LONG.
      118     DEFINE INPUT  PARAMETER nWidth             AS LONG.
      119     DEFINE INPUT  PARAMETER nEscapement        AS LONG.
      120     DEFINE INPUT  PARAMETER nOrientation       AS LONG.
      121     DEFINE INPUT  PARAMETER fnWeight           AS LONG.
      122     DEFINE INPUT  PARAMETER fdwItalic          AS LONG.
      123     DEFINE INPUT  PARAMETER fdwUnderline       AS LONG.
      124     DEFINE INPUT  PARAMETER fdwStrikeOut       AS LONG.
      125     DEFINE INPUT  PARAMETER fdwCharSet         AS LONG.
      126     DEFINE INPUT  PARAMETER fdwOutputPrecision AS LONG.
      127     DEFINE INPUT  PARAMETER fdwClipPrecision   AS LONG.
      128     DEFINE INPUT  PARAMETER fdwQuality         AS LONG.
      129     DEFINE INPUT  PARAMETER fdwPitchAndFamily  AS LONG.
      130     DEFINE INPUT  PARAMETER lpszFace           AS CHAR.
      131     DEFINE RETURN PARAMETER hFont              AS LONG.
      132   END PROCEDURE.
      133   PROCEDURE MulDiv EXTERNAL "kernel32" :
      134     DEFINE INPUT  PARAMETER nNumber      AS LONG.
      135     DEFINE INPUT  PARAMETER nNumerator   AS LONG.
      136     DEFINE INPUT  PARAMETER nDenominator AS LONG.
      137     DEFINE RETURN PARAMETER ReturnValue  AS LONG.
      138   END PROCEDURE.
      139   define input  parameter  p-fontname as character no-undo .
      140   define input  parameter  p-fontsize as integer   no-undo .
      141   define input  parameter  p-fonttype as character no-undo .
      142   define output parameter  p-LineHeight as integer no-undo .
      143   define output parameter  p-LineWidth  as integer no-undo .
      144   define variable devcap           as integer no-undo.
      145   define variable emheight         as integer no-undo.
      146   define variable hPrinterDC       as integer no-undo.
      147   define variable hBodyFont        as integer no-undo.
      148   define variable ReturnValue      as integer no-undo.
      149   define variable p-Devicename     as character    no-undo init "" .
      150   define variable lpDevmode        as memptr  no-undo.
      151   define variable devicespecs      as character    no-undo.
      152   define variable p-docname        as character no-undo .
      153   define variable lpdocname        as memptr  no-undo.
      154   define variable lpdocinfo        as memptr  no-undo.
      155   define variable lpDefaultDevmode as memptr  no-undo.
      156   define variable p-Landscape      as logical   no-undo init false .
      157   define variable hStockFont       as integer no-undo.
      158   define variable v-ft as integer   no-undo .
      159   define variable v-italic as integer   no-undo init 0.
      160   define stream fontt .
      161   p-docname = "font.ttt" .
      162   output stream fontt to value (p-docname) .
      163   put stream fontt unformatted "":U skip.
      164   output stream fontt close.
      165     FILE-INFO:FILE-NAME = p-docname .
      166     IF FILE-INFO:FULL-PATHNAME = ? THEN RETURN error "file_not_found" .
      167       if p-devicename = "" then do:
      168           devicespecs = fill("x", 255).
      169           run GetProfileStringA
      170             ( "windows":U,
      171               "device":U,
      172               "-unknown-,,":U,
      173               output devicespecs,
      174               length (devicespecs),
      175               output ReturnValue )
      176               .
      177           p-devicename = entry (1, devicespecs).
      178       end.
      179       SET-SIZE(lpdocname)     = LENGTH(p-docname) + 1.
      180       PUT-STRING(lpdocname,1) = p-docname.
      181       SET-SIZE(lpdocinfo)     = 12.
      182       PUT-LONG(lpdocinfo, 1)  = GET-SIZE(lpdocinfo).
      183       PUT-LONG(lpdocinfo, 5)  = GET-POINTER-VALUE(lpdocname).
      184       PUT-LONG(lpdocinfo, 9)  = 0.
      185       run DocumentPropertiesA
      186         ( 0,
      187           0,
      188           p-devicename,
      189           0,
      190           0,
      191           0,
      192           output ReturnValue)
      193           .
      194       SET-SIZE(lpDefaultDevMode) = ReturnValue.
      195       SET-SIZE(lpDevMode)        = ReturnValue.
      196       RUN DocumentPropertiesA
      197          (0,
      198           0,
      199           p-devicename,
      200           GET-POINTER-VALUE(lpDefaultDevMode),
      201           0,
      202           2,
      203           output ReturnValue )
      204           .
      205       PUT-LONG (lpDefaultDevMode, 32 +  9) = 1.
      206       IF p-Landscape THEN
      207          PUT-SHORT(lpDefaultDevMode, 32 + 13) = 2.
      208       ELSE
      209          PUT-SHORT(lpDefaultDevMode, 32 + 13) = 1.
      210       RUN DocumentPropertiesA
      211          (0,
      212           0,
      213           p-devicename,
      214           GET-POINTER-VALUE(lpDevMode),
      215           GET-POINTER-VALUE(lpDefaultDevMode),
      216           8 + 2,
      217           output ReturnValue)
      218           .
      219       RUN CreateDCA
      220         ("WINSPOOL":U,
      221           p-devicename,
      222           0,
      223           GET-POINTER-VALUE(lpDevMode),
      224           OUTPUT hPrinterDC)
      225           .
      226       SET-SIZE(lpDefaultDevMode)    = 0.
      227       SET-SIZE(lpDevMode) = 0.
      228       SET-SIZE(lpdocinfo) = 0.
      229       SET-SIZE(lpdocname) = 0.
      230     run GetDeviceCaps (hPrinterDC, 90, OUTPUT devcap).
      231     run MulDiv (p-fontsize, devcap, 72, OUTPUT emheight).
      232     emheight = 0 - emheight.
      233     if caps (p-fonttype) = "BOLD" or caps (p-fonttype) begins "BOLD"
      234       then  v-ft = 700 .
      235       else  v-ft = 400 .
      236     if lookup ( "ITALIC" , caps(p-fonttype)) > 0 then v-italic = 1.
      237     RUN CreateFontA
      238       ( emheight,
      239         0,
      240         0,
      241         0,
      242         v-ft,
      243         v-italic,
      244         0,
      245         0,
      246         0,
      247         0,
      248         0,
      249         2,
      250         1 + 0,
      251         p-fontname ,
      252         OUTPUT hBodyFont)
      253         .
      254     IF hBodyFont <> 0 then do:
      255        run SelectObject  ( input  hPrinterDC, input  hBodyFont, output hStockFont ).
      256        run GetSimbolSize ( output p-LineHeight , output p-LineWidth ).
      257     end.
      258     run DeleteObject (input hBodyFont,  OUTPUT ReturnValue ).
      259     run DeleteDC     (input hPrinterDC, OUTPUT ReturnValue ).
      260     hPrinterDC = 0.
      261     os-delete value( p-docname  ) .
      262   PROCEDURE GetSimbolSize :
      263   define output parameter p-h as integer.
      264   define output parameter p-w as integer.
      265   define variable  lpTm AS MEMPTR NO-UNDO.
      266     SET-SIZE(lpTM) = 15 * 4 + 5.
      267     run GetTextMetricsA
      268          (INPUT  hPrinterDC,
      269           INPUT  GET-POINTER-VALUE(lpTM),
      270           OUTPUT ReturnValue)
      271           .
      272     p-h  = GET-LONG(lpTM, 1).
      273     p-w  = GET-LONG(lpTM, 21).
      274     SET-SIZE(lpTM)=0.
      275   END PROCEDURE.
