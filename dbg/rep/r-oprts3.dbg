     3998       l2f-cost-sum  = c-f-cost-sum:FORMAT
     3999       c-f-cost-sum:DATA-TYPE = "CHARACTER"
     4000       c-f-cost-sum:FORMAT    = "x(" + string(C-f-cost-sum:WIDTH-CHARS) + ")"
     4001       c-f-cost-sum:screen-value = string(ff)  .
     4002   End.
     4003   if c-f-sale-sum <>  ?  then do : assign
     4004       l1f-sale-sum  = c-f-sale-sum:DATA-TYPE
     4005       l2f-sale-sum  = c-f-sale-sum:FORMAT
     4006       c-f-sale-sum:DATA-TYPE = "CHARACTER"
     4007       c-f-sale-sum:FORMAT    = "x(" + string(C-f-sale-sum:WIDTH-CHARS) + ")"
     4008       c-f-sale-sum:screen-value = string(ff)  .
     4009   End.
     4010   if c-f-sale-other <>  ?  then do : assign
     4011       l1f-sale-other  = c-f-sale-other:DATA-TYPE
     4012       l2f-sale-other  = c-f-sale-other:FORMAT
     4013       c-f-sale-other:DATA-TYPE = "CHARACTER"
     4014       c-f-sale-other:FORMAT    = "x(" + string(C-f-sale-other:WIDTH-CHARS) + ")"
     4015       c-f-sale-other:screen-value = string(ff)  .
     4016   End.
     4017   if c-f-crsa-sum <>  ?  then do : assign
     4018       l1f-crsa-sum  = c-f-crsa-sum:DATA-TYPE
     4019       l2f-crsa-sum  = c-f-crsa-sum:FORMAT
     4020       c-f-crsa-sum:DATA-TYPE = "CHARACTER"
     4021       c-f-crsa-sum:FORMAT    = "x(" + string(C-f-crsa-sum:WIDTH-CHARS) + ")"
     4022       c-f-crsa-sum:screen-value = string(ff)  .
     4023   End.
     4024   if c-f-qnty-all <>  ?  then do : assign
