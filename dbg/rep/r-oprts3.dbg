       24   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       25   procedure cur-time :
       26      define output parameter p-today as date      no-undo .
       27      define output parameter p-time  as integer   no-undo .
       28     do
       29     on error undo, return error
       30     :
       31       define variable v-date1 as date      no-undo .
       32       define variable v-date2 as date      no-undo .
       33       define variable v-time  as integer   no-undo .
       34       assign
       35         v-date1 = today
       36         v-time  = time
       37         v-date2 = today
       38       .
       39       if v-date1 <> v-date2
       40       then do:
       41         assign
       42           v-date1 = today
       43           v-time  = v-time
       44         .
       45       end.
       46       assign
       47         p-today = v-date1
       48         p-time  = v-time
       49       .
       50     end.
       51   end.
       52   function cur-time-date returns character
       53   :
       54     return string(today, '99/99/9999':U) .
       55   end.
       56   function cur-time-mjd returns decimal
       57   :
       58     define variable v-date as date      no-undo .
       59     define variable v-time as integer   no-undo .
       60     run cur-time in this-procedure
       61       (output v-date
       62       ,output v-time
       63       ) .
       64     return integer(v-date) - 2400002 + (v-time / 86400) .
       65   end.
       66   function cur-time-get-ending-index returns integer
       67   (input p-number as integer
       68   )
       69   :
       70     if p-number < 0
       71     or p-number = ?
       72     then do:
       73       return 1 .
       74     end.
       75     define variable v-rest as integer   no-undo .
       76     assign
       77       p-number = p-number modulo 100
       78     .
       79     if p-number < 20
       80     then do:
       81       assign
       82         v-rest = p-number
       83       .
       84     end.
       85     else do:
       86       assign
       87         v-rest = p-number modulo 10
       88       .
       89     end.
       90     case v-rest :
       91       when 1
       92       then do:
       93         return 2 .
       94       end.
       95       when 2 or
       96       when 3 or
       97       when 4
       98       then do:
       99         return 3 .
      100       end.
      101       otherwise do:
      102         return 1 .
      103       end.
      104     end case .
      105   end.
      106   procedure cur-time-mjd-to-date :
      107      define input  parameter i-mjd-diff as decimal no-undo.
      108      define output parameter o-Date     as date    no-undo.
      109      define output parameter o-Time     as integer no-undo.
      110      define variable v-day-number as integer   no-undo .
      111      if    i-mjd-diff < 0
      112         or i-mjd-diff = ?
      113      then do:
      114         return "?" .
      115      end.
      116      assign
      117         v-day-number = truncate(i-mjd-diff,0).
      118         o-Date = date(v-day-number + 2400002).
      119         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      120     .
      121   end.
      122   function cur-time-mjd-to-string returns character
      123   (input p-mjd-diff as decimal
      124   )
      125   :
      126     define variable v-day-number as integer   no-undo .
      127     define variable v-seconds    as integer   no-undo .
      128     define variable v-hour       as integer   no-undo .
      129     define variable v-min        as integer   no-undo .
      130     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      131     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      132     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      133     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      134     if p-mjd-diff < 0
      135     or p-mjd-diff = ?
      136     then do:
      137       return "?" .
      138     end.
      139     assign
      140       v-day-number = integer(truncate(p-mjd-diff,0))
      141       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      142     .
      143     if v-seconds > 86400
      144     then do:
      145       assign
      146         v-seconds = 86400 - 1
      147       .
      148     end.
      149     if v-seconds < 0
      150     then do:
      151       assign
      152         v-seconds = 0
      153       .
      154     end.
      155     assign
      156       v-hour = truncate(v-seconds / 3600, 0)
      157     .
      158     assign
      159       v-seconds = v-seconds modulo 3600
      160     .
      161     assign
      162       v-min = truncate(v-seconds / 60, 0)
      163     .
      164     assign
      165       v-seconds = v-seconds modulo 60
      166     .
      167     return
      168         (if v-day-number <> 0
      169           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      170           else ""
      171         )
      172       + (if v-day-number <> 0 or v-hour <> 0
      173           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      174           else ""
      175         )
      176       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      177           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      178           else ""
      179         )
      180       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      181       .
      182   end.
      183   function cur-time-string returns character
      184   :
      185     define variable v-date as date      no-undo .
      186     define variable v-time as integer   no-undo .
      187     run cur-time in this-procedure
      188       (output v-date
      189       ,output v-time
      190       ) .
      191     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      192   end.
      193   function cur-time-string-sec returns character
      194   :
      195     define variable v-date as date      no-undo .
      196     define variable v-time as integer   no-undo .
      197     run cur-time in this-procedure
      198       (output v-date
      199       ,output v-time
      200       ) .
      201     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      202   end.
      203   function cur-time-custom  returns character
      204   (input p-prefix as character
      205   ,input p-date-format as character
      206   ,input p-delimiter as character
      207   ,input p-time-format as character
      208   ,input p-suffix as character
      209   )
      210   :
      211     define variable v-date as date      no-undo .
      212     define variable v-time as integer   no-undo .
      213     run cur-time in this-procedure
      214       (output v-date
      215       ,output v-time
      216       ) .
      217     return
      218       p-prefix
      219       + string(v-date, p-date-format)
      220       + p-delimiter
      221       + string(v-time, p-time-format)
      222       + p-suffix
      223       .
      224   end.
      225   function cur-time-print  returns character
      226   :
      227     define variable v-date as date      no-undo .
      228     define variable v-time as integer   no-undo .
      229     run cur-time in this-procedure
      230       (output v-date
      231       ,output v-time
      232       ) .
      233     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      234   end.
      235   function cur-time-datetime returns datetime
      236   :
      237     define variable v-char as character no-undo .
      238     define variable v-datetime as datetime no-undo .
      239     v-char = cur-time-string().
      240     v-datetime = datetime(v-char).
      241     return  v-datetime.
      242   end.
      243   function cur-time-string-msec returns character
      244   :
      245     define variable v-date as datetime  no-undo .
      246     v-date = now.
      247     return string(v-date) .
      248   end.
