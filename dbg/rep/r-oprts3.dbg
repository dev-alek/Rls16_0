     5902                       end.
     5903                       when  'crsa':U then do:
     5904                         f-crsa-sum-all = f-crsa-sum-all + ub.ot-line.sum-rubl  .
     5905                         f-qnty-all     = f-qnty-all     + ub.ot-line.fact-qnty .
     5906                       end.
