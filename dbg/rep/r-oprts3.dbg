     3711                                  and out-vatp_partsprl.obj-type   = varobj-type
     3712                                  and out-vatp_partsprl.obj-code   = varobj-code
     3713                                  and out-vatp_partsprl.artic      = varartic
     3714                                  and out-vatp_partsprl.prod-type  = varprod-type
     3715                                  and out-vatp_partsprl.prod-code  = varprod-code no-lock :
     3716       if out-vatp_partsprl.purch-code = 2 then do:
