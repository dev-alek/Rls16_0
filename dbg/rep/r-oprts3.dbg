      310   def
      311    shared
      312   temp-table  obj-list no-undo
      313     field obj-type like ub.clients.obj-type
      314     field obj-code like ub.clients.obj-code
      315     field obj-name like ub.clients.obj-name
      316     field obj-id   as integer
