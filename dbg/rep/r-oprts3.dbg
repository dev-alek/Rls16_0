     5005             n-nn = 0.
     5006             n-no = n-no + 1 .
     5007         for each tt-season no-lock with FRAME Zapas:
     5008             if not ("grp-goods" = "no-classify" and itog = true ) then do:
     5009                 put stream outstream tt-season.sea-name  at 1 format "x(160)" skip.  down stream outstream .
     5010                 if Make-Excel then  put   stream ForExcel unformatted tt-season.sea-name chr(10) .
     5011             end.
     5012                 for each ub.gds-season no-lock where
     5013                          ub.gds-season.sea-code = tt-season.sea-code and
     5014                          ub.gds-season.db-num   = tt-season.db-num
     5015                          ,
     5016                     each goods no-lock where
     5017                          goods.gds-code    = ub.gds-season.gds-code and
     5018                          goods.gds-type   = 'т':U ,
     5019                     Each ub.ot-line where
     5020                             ub.ot-line.fact-order <= fact-order-2 and
     5021                             ub.ot-line.fact-order >= fact-order-1 and
     5022                             ub.ot-line.obj-code    = obj-list.obj-code and
     5023                             ub.ot-line.obj-type    = obj-list.obj-type  and
     5024                             ub.ot-line.prod-type   = goods.prod-type and
     5025                             ub.ot-line.prod-code   = goods.prod-code and
     5026                             ub.ot-line.artic       = goods.artic  and
     5027                             (ub.ot-line.sum-type   = 'sale':U OR
     5028                               ub.ot-line.sum-type  = 'crsa':U OR
     5029                               ub.ot-line.sum-type  = 'cost':U )
     5030                   ,
     5031                     each gds-list where
     5032                         gds-list.gds-code = ub.gds-season.gds-code
     5033                         break
     5034                             by goods.grp-name by (ub.gds-season.gds-code)
     5035                             with FRAME Zapas :
     5036                n-nm = n-nm + 1.
     5037               IF first-of(ub.gds-season.gds-code) then DO:
     5038                   assign
     5039                     f-qnty         = 0
     5040                     f-cost-sum     = 0
     5041                     f-sale-sum     = 0
     5042                     f-sale-other   = 0
     5043                     f-crsa-sum     = 0
     5044                     f-qnty-all     = 0
     5045                     f-cost-sum-all = 0
     5046                     f-crsa-sum-all = 0
     5047                     f-qnty-o       = 0
     5048                     f-cost-sum-o   = 0
     5049                     f-crsa-sum-o   = 0.
     5050                  For Each temp-doc-code  : delete temp-doc-code . end.
     5051                  For Each temp-doc-code-all  : delete temp-doc-code-all . end.
     5052               End.
     5053               if can-find( first tdedt where  ub.ot-line.ext-doc-type = tdedt.id no-lock ) then DO:
     5054                   Case  ub.ot-line.sum-type :
     5055                       When 'cost':U then do:
     5056                           f-cost-sum = f-cost-sum + ub.ot-line.sum-rubl .
     5057                       End.
     5058                       When 'sale':U then do:
     5059                           f-sale-sum   = f-sale-sum   +  ub.ot-line.sum-rubl .
     5060                           f-sale-other = f-sale-other + ub.ot-line.other-rubl .
     5061                       End.
     5062                       When  'crsa':U then do:
     5063                           f-crsa-sum = f-crsa-sum + ub.ot-line.sum-rubl  .
     5064                           f-qnty     = f-qnty     + ub.ot-line.fact-qnty .
     5065                           IF itog = false then do:
     5066                               Create temp-doc-code .
     5067                               Assign
     5068                                  temp-doc-code.doc-code = ub.ot-line.doc-code
     5069                                  temp-doc-code.ext-doc-type = ub.ot-line.ext-doc-type
     5070                                  temp-doc-code.si  = if  ub.ot-line.fact-qnty < 0 then -1 else 1
     5071                                  temp-doc-code.si2 = if  ub.ot-line.other-rubl < 0 then -1 else 1
     5072                                  .
     5073                           End.
     5074                       End.
     5075                   End case.
     5076                 End.
     5077                   Case  ub.ot-line.sum-type :
     5078                       when 'cost':U then do:
     5079                         f-cost-sum-all = f-cost-sum-all + ub.ot-line.sum-rubl .
