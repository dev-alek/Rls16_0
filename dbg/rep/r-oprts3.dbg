     3985           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     3986           display STREAM OutStream    with frame top-frame .
     3987       End.
     3988     End.
     3989   if c-f-qnty <>  ?  then do : assign
     3990       l1f-qnty  = c-f-qnty:DATA-TYPE
     3991       l2f-qnty  = c-f-qnty:FORMAT
     3992       c-f-qnty:DATA-TYPE = "CHARACTER"
