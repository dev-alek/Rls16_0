     2307               "Переоценка" buf_price-list.doc-num skip
     2308               "Артикул" buf_price-list.artic buf_price-list.prod-type buf_price-list.prod-code skip
     2309               "Бар-код" buf_price-list.b-code skip
     2310               view-as alert-box error .
