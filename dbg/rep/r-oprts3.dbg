     8533   END PROCEDURE.
     8534   PROCEDURE Display-prt :
     8535   if goods.prt-root <> Prtroot Then DO:
     8536   If v-var = "no-today"  then
     8537   run prdoclib-init-prt-obj-by-factord in this-procedure
     8538   ( input gds-obj.obj-type  ,
     8539   input gds-obj.obj-code  ,
     8540   input gds-obj.artic     ,
     8541   input gds-obj.prod-type ,
     8542   input gds-obj.prod-code ,
     8543   input fact-order-2 ,
     8544   input false ) .
     8545   for each ub.prt-obj where
     8546     ub.prt-obj.artic     = goods.artic         and
     8547     ub.prt-obj.prod-type = goods.prod-type and
     8548     ub.prt-obj.prod-code = goods.prod-code and
     8549     ub.prt-obj.obj-code  = obj-list.obj-code   and
     8550     ub.prt-obj.obj-type  = obj-list.obj-type   and
     8551     ub.prt-obj.IS-term   =  true no-lock
     8552           BREAK BY ub.prt-obj.prt-code with FRAME Zapas:
     8553                 if v-var <> "no-today" then do:
     8554                   Assign
     8555                     p-qnty-o     = p-qnty-o     + ub.prt-obj.fact-qnty
     8556                     p-crsa-sum-o = p-crsa-sum-o + ub.prt-obj.fact-qnty * ub.prt-obj.price-sale .
     8557                 End.
     8558   IF last-of(prt-obj.prt-code) THEN DO:
     8559   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     8560     (input  gds-obj.gds-code
     8561     ,input  ub.prt-obj.prt-code
     8562     ,output v-bar-code
     8563     )  .
     8564             if v-var = "no-today" then do:
     8565               find first temp-prt-obj no-lock
     8566                     where temp-prt-obj.prt-obj-recid   = recid (prt-obj) no-error .
     8567                     if avail temp-prt-obj then do :
     8568                       run calc-price-sale-for-prt in this-procedure  (output v-price-sale) .
     8569                       Assign
     8570                         p-qnty-o      = temp-prt-obj.fact-qnty
     8571                         p-crsa-sum-o  = temp-prt-obj.fact-qnty * v-price-sale      .
     8572                     End.
     8573                     Else
     8574                       Assign
     8575                         p-qnty-o      = 0
     8576                         p-crsa-sum-o  = 0   .
     8577             End.
     8578       FIND first ub.gds-prt  where ub.gds-prt.node-code = ub.prt-obj.prt-code NO-LOCK no-error .
     8579       for each ub.gds-dtl no-lock where
     8580           ub.gds-dtl.artic      = goods.artic     and
     8581           ub.gds-dtl.prod-code  = goods.prod-code and
     8582           ub.gds-dtl.prod-type  = goods.prod-type and
     8583           ub.gds-dtl.prt-code   = ub.prt-obj.prt-code  and
     8584           ub.gds-dtl.obj-code   = obj-list.obj-code  and
     8585           ub.gds-dtl.obj-type   = obj-list.obj-type :
     8586               find first temp-doc-code where temp-doc-code.doc-code = ub.gds-dtl.doc-code no-lock no-error .
     8587                 if avail temp-doc-code then DO:
     8588                 Assign
     8589                     t-qnty = if temp-doc-code.ext-doc-type = 'vt':U
     8590                                 then ub.gds-dtl.doc-qnty
     8591                                 else ( ub.gds-dtl.fact-qnty * temp-doc-code.si )
     8592                     p-qnty       = p-qnty       + t-qnty
     8593                     p-sale-sum   = p-sale-sum   + (gds-dtl.price-rubl * t-qnty)
     8594                     p-sale-other = p-sale-other + (gds-dtl.discnt-rubl * temp-doc-code.si2)
     8595                     p-crsa-sum   = p-crsa-sum   + (gds-dtl.cur-base * t-qnty)
     8596                     .
     8597               End.
     8598               find first temp-doc-code-all where temp-doc-code-all.doc-code = ub.gds-dtl.doc-code no-lock no-error .
     8599                 if avail temp-doc-code-all then DO:
     8600                     Assign
     8601                     t-qnty-all = if temp-doc-code-all.ext-doc-type = 'vt':U
     8602                                       then ub.gds-dtl.doc-qnty
     8603                                       else ( ub.gds-dtl.fact-qnty * temp-doc-code-all.si )
     8604                       p-qnty-all       = p-qnty-all  + t-qnty-all
     8605                       p-crsa-sum-all   = p-crsa-sum-all   + (gds-dtl.cur-base * t-qnty-all ).
     8606                 End.
     8607       end.
     8608       if f-qnty <> ? and f-qnty <> 0 then
     8609           Assign
     8610             p-cost-sum     = f-cost-sum      * p-qnty     / f-qnty
     8611           .
     8612       else
     8613           Assign
     8614               p-cost-sum     = 0
     8615           .
     8616       if f-qnty-all <> ? and f-qnty-all <> 0 then
     8617           Assign
     8618             p-cost-sum-all = f-cost-sum-all  * p-qnty-all / f-qnty-all
     8619           .
     8620       else
     8621           Assign
     8622               p-cost-sum-all = 0
     8623             .
     8624       if f-qnty-o <> ? and f-qnty-o <> 0 then
     8625           Assign
     8626             p-cost-sum-o   = f-cost-sum-o    * p-qnty-o   / f-qnty-o
     8627           .
     8628       else
     8629           Assign
     8630               p-cost-sum-o   = 0
     8631           .
     8632       if  NOT(p-qnty      =  0 and
     8633             p-cost-sum    =  0     and
     8634             p-sale-sum    =  0     and
     8635             p-sale-other  =  0     and
     8636             p-crsa-sum    =  0     and
     8637             p-qnty-all    =  0     and
     8638             p-cost-sum-all = 0     and
     8639             p-crsa-sum-all=  0    ) then dO:
     8640     if c-nn <>  ?  then do :
     8641       c-nn:screen-value = string('') .
     8642       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     8643           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     8644           display STREAM OutStream    with frame top-frame .
     8645       End.
     8646     End.
     8647     if c-f-artic <>  ?  then do :
     8648       c-f-artic:screen-value = string('') .
     8649       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     8650           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     8651           display STREAM OutStream    with frame top-frame .
     8652       End.
     8653     End.
     8654     if c-f-b-code <>  ?  then do :
     8655       c-f-b-code:screen-value = string(string(v-bar-code,'999999999')) .
     8656       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     8657           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     8658           display STREAM OutStream    with frame top-frame .
     8659       End.
     8660     End.
     8661     if c-f-gds-name <>  ?  then do :
     8662       c-f-gds-name:screen-value = string(ub.gds-prt.f-name) .
     8663       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     8664           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     8665           display STREAM OutStream    with frame top-frame .
     8666       End.
     8667     End.
     8668     if c-f-qnty <>  ?  then do :
     8669       c-f-qnty:screen-value = string(p-qnty) .
     8670       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     8671           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     8672           display STREAM OutStream    with frame top-frame .
     8673       End.
     8674     End.
     8675     if c-f-cost-sum <>  ?  then do :
     8676       c-f-cost-sum:screen-value = string(p-cost-sum) .
     8677       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     8678           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     8679           display STREAM OutStream    with frame top-frame .
     8680       End.
     8681     End.
     8682     if c-f-sale-sum <>  ?  then do :
     8683       c-f-sale-sum:screen-value = string(p-sale-sum) .
     8684       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     8685           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     8686           display STREAM OutStream    with frame top-frame .
     8687       End.
     8688     End.
     8689     if c-f-sale-other <>  ?  then do :
     8690       c-f-sale-other:screen-value = string(p-sale-other) .
     8691       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     8692           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     8693           display STREAM OutStream    with frame top-frame .
     8694       End.
     8695     End.
     8696     if c-f-crsa-sum <>  ?  then do :
     8697       c-f-crsa-sum:screen-value = string(p-crsa-sum) .
     8698       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     8699           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     8700           display STREAM OutStream    with frame top-frame .
     8701       End.
     8702     End.
     8703     if c-f-qnty-all <>  ?  then do :
     8704       c-f-qnty-all:screen-value = string(p-qnty-all) .
     8705       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     8706           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     8707           display STREAM OutStream    with frame top-frame .
     8708       End.
     8709     End.
     8710     if c-f-cost-sum-all <>  ?  then do :
