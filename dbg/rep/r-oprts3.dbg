     4370                                  temp-doc-code.ext-doc-type = ub.ot-line.ext-doc-type
     4371                                  temp-doc-code.si  = if  ub.ot-line.fact-qnty < 0 then -1 else 1
     4372                                  temp-doc-code.si2 = if  ub.ot-line.other-rubl < 0 then -1 else 1
     4373                                  .
     4374                           End.
     4375                       End.
     4376                   End case.
     4377                 End.
     4378                   Case  ub.ot-line.sum-type :
