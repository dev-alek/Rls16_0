      799   PROCEDURE ostatok :
      800   def input parameter x-store-code  like ub.clients.obj-code    no-undo.
      801   def input parameter x-store-type  like ub.clients.obj-type    no-undo.
      802   def input parameter x-tog-shift   as   logical             no-undo.
      803   def input parameter x-date-start  like ub.stk-tot.Fact-date   no-undo.
      804   def input parameter x-date-end    like ub.stk-tot.Fact-date   no-undo.
      805   def input parameter x-shift-start as integer               no-undo.
      806   def input parameter x-shift-end   as integer               no-undo.
      807   def input parameter x-sum-type    like ub.stk-tot.sum-type    no-undo.
      808   def input parameter x-cat-id      like ub.stk-tot.cat-id      no-undo.
      809   def input parameter xTog-obj   as log no-undo.
      810   def output parameter Quantity    like ub.stk-tot.fact-qnty   no-undo.
      811   def output parameter Coast_R     like ub.stk-tot.sum-rubl    no-undo.
      812   def output parameter Coast_V     like ub.stk-tot.sum-rubl    no-undo.
      813   def output parameter VAT_R       like ub.stk-tot.sum-rubl    no-undo.
      814   def output parameter VAT_V       like ub.stk-tot.sum-rubl    no-undo.
      815   def output parameter Fact-order  like ub.stk-tot.Fact-order  no-undo.
      816   def var              Fact-order#   like ub.stk-tot.Fact-order  no-undo.
      817   def var              Fact-orderS   as char  no-undo.
      818   def var x-date-start-t  like ub.stk-tot.shift-date   no-undo.
      819      Assign
      820         Fact-order   = 0
      821         Quantity     = 0
      822         Coast_R      = 0
      823         Coast_V      = 0
      824         VAT_R        = 0
      825         VAT_V        = 0 .
      826    x-date-start-t  = x-date-start + 1 .
      827   IF x-date-end = date('') then DO:
      828      Fact-order = 0 .
      829      for each obj-list
      830          where  ( not xtog-obj or
      831                 ( x-store-type = obj-list.obj-type and x-store-code = obj-list.obj-code ))
      832                 no-lock :
      833         if  x-tog-shift = false then do:
      834                          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
      835                               ub.stk-tot.Fact-date <=  x-date-start
      836                               and ub.stk-tot.shift-num = 0
      837                               USE-INDEX fact-date no-lock no-error .
      838              if Available ub.stk-tot THEN  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
      839         End.
      840         Else  DO :
      841             find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
      842              (ub.stk-tot.shift-date  = x-date-start-t and
      843               ub.stk-tot.shift-num  < x-shift-start or
      844               ub.stk-tot.shift-date  < x-date-start-t  )
      845               and ub.stk-tot.shift-num  > 0
      846               USE-INDEX Shift-num no-lock no-error .
      847            If Available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
      848           END.
      849       If Fact-order < Fact-order#  and Fact-order# <> 0  THEN  Fact-order = Fact-order# .
      850     End.
      851   End.
      852   Else DO:
      853     For each obj-list  WHERE
      854        (NOT xTog-obj OR (x-store-type = obj-list.obj-type AND x-store-code = obj-list.obj-code))
      855         no-lock :
      856      IF  x-TOG-Shift = False Then DO:
      857          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
      858               ub.stk-tot.Fact-date <= x-date-end
      859               and ub.stk-tot.shift-num = 0
      860               USE-INDEX fact-date no-lock no-error.
      861          if available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
      862      END.
      863      Else DO:
      864           find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
      865               (ub.stk-tot.shift-date  = x-date-end and
      866               ub.stk-tot.shift-num  <= x-shift-end or
      867               ub.stk-tot.shift-date  < x-date-end       ) and
      868               ub.stk-tot.shift-num   > 0      use-index shift-num no-lock no-error.
      869               if Available ub.stk-tot THEN Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
      870       End.
      871       if Fact-order < Fact-order#  THEN  Fact-order = Fact-order#.
      872     End.
      873   End.
      874   END PROCEDURE.
      875   define temp-table temp-font no-undo
      876     field fontnum  as integer
      877     field fontname as character
      878     field fontsize as character
      879     field fonttype as character
