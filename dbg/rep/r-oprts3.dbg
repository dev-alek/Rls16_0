     4310                 put stream outstream tt-season.sea-name  at 1 format "x(160)" skip.  down stream outstream .
     4311                 if Make-Excel then  put   stream ForExcel unformatted tt-season.sea-name chr(10) .
     4312             end.
     4313                 for each ub.gds-season no-lock where
     4314                          ub.gds-season.sea-code = tt-season.sea-code and
     4315                          ub.gds-season.db-num   = tt-season.db-num
     4316                          ,
     4317                     each goods no-lock where
     4318                          goods.gds-code    = ub.gds-season.gds-code and
     4319                          goods.gds-type   = 'т':U ,
     4320                     Each ub.ot-line where
     4321                             ub.ot-line.fact-order <= fact-order-2 and
     4322                             ub.ot-line.fact-order >= fact-order-1 and
     4323                             ub.ot-line.obj-code    = obj-list.obj-code and
     4324                             ub.ot-line.obj-type    = obj-list.obj-type  and
     4325                             ub.ot-line.prod-type   = goods.prod-type and
     4326                             ub.ot-line.prod-code   = goods.prod-code and
     4327                             ub.ot-line.artic       = goods.artic  and
     4328                             (ub.ot-line.sum-type   = 'sale':U OR
     4329                               ub.ot-line.sum-type  = 'crsa':U OR
     4330                               ub.ot-line.sum-type  = 'cost':U )
     4331                   ,
     4332                     each gds-list where
     4333                         gds-list.gds-code = ub.gds-season.gds-code
     4334                         break
     4335                             by (ub.gds-season.gds-code ) by goods.grp-name
     4336                             with FRAME Zapas :
     4337                n-nm = n-nm + 1.
     4338               IF first-of(ub.gds-season.gds-code) then DO:
     4339                   assign
     4340                     f-qnty         = 0
     4341                     f-cost-sum     = 0
     4342                     f-sale-sum     = 0
     4343                     f-sale-other   = 0
     4344                     f-crsa-sum     = 0
     4345                     f-qnty-all     = 0
     4346                     f-cost-sum-all = 0
     4347                     f-crsa-sum-all = 0
     4348                     f-qnty-o       = 0
     4349                     f-cost-sum-o   = 0
     4350                     f-crsa-sum-o   = 0.
     4351                  For Each temp-doc-code  : delete temp-doc-code . end.
     4352                  For Each temp-doc-code-all  : delete temp-doc-code-all . end.
     4353               End.
     4354               if can-find( first tdedt where  ub.ot-line.ext-doc-type = tdedt.id no-lock ) then DO:
     4355                   Case  ub.ot-line.sum-type :
     4356                       When 'cost':U then do:
     4357                           f-cost-sum = f-cost-sum + ub.ot-line.sum-rubl .
     4358                       End.
     4359                       When 'sale':U then do:
     4360                           f-sale-sum   = f-sale-sum   +  ub.ot-line.sum-rubl .
     4361                           f-sale-other = f-sale-other + ub.ot-line.other-rubl .
     4362                       End.
     4363                       When  'crsa':U then do:
     4364                           f-crsa-sum = f-crsa-sum + ub.ot-line.sum-rubl  .
     4365                           f-qnty     = f-qnty     + ub.ot-line.fact-qnty .
     4366                           IF itog = false then do:
