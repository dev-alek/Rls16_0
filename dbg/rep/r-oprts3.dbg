     8735           display STREAM OutStream    with frame top-frame .
     8736       End.
     8737     End.
     8738     if c-f-crsa-sum-o <>  ?  then do :
     8739       c-f-crsa-sum-o:screen-value = string(p-crsa-sum-o) .
     8740       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     8741           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     8742           display STREAM OutStream    with frame top-frame .
     8743       End.
     8744     End.
     8745           Display stream OutStream no-error.
     8746           DOWN stream OutStream .
     8747       if Make-Excel then  put   stream ForExcel unformatted
     8748             " "                             CHR(9)
     8749             " "                             CHR(9)
     8750             format-excel-text(string(v-bar-code,"999999999"))  CHR(9)
     8751             ub.gds-prt.f-name                 CHR(9)
     8752             round(p-qnty,3)                CHR(9)
     8753             round(p-cost-sum,2)            CHR(9)
     8754             round(p-sale-sum,2)            CHR(9)
     8755             round(p-sale-other,2)          CHR(9)
     8756             round(p-crsa-sum,2)            CHR(9)
     8757             round(p-qnty-all,3)            CHR(9)
     8758             round(p-cost-sum-all,2)        CHR(9)
     8759             round(p-crsa-sum-all,2)        CHR(9)
     8760             round(p-qnty-o,3)              CHR(9)
     8761             round(p-cost-sum-o,2)          CHR(9)
     8762             round(p-crsa-sum-o,2)          chr(10) .
     8763       End.
     8764       Assign
     8765         p-qnty        =  0
     8766         p-cost-sum    =  0
     8767         p-sale-sum    =  0
     8768         p-sale-other  =  0
     8769         p-crsa-sum    =  0
     8770         p-qnty-all    =  0
     8771         p-cost-sum-all = 0
     8772         p-crsa-sum-all=  0
     8773         p-qnty-o      =  0
     8774         p-cost-sum-o  =  0
     8775         p-crsa-sum-o  =  0 .
     8776   End.
     8777   End.
     8778   End.
     8779   END PROCEDURE.
     8780   PROCEDURE on-same-page :
     8781     define input parameter p-line-number as integer  no-undo .
     8782     if p-line-number > page-size( OutStream ) then do:
     8783       return .
     8784     end.
     8785     if line-counter( OutStream ) + p-line-number > page-size( OutStream ) then do:
     8786       page stream OutStream .
     8787     end.
     8788   end procedure.
     8789   procedure ost-line :
     8790     define input  parameter x-store-code like ub.clients.obj-code    no-undo .
     8791     define input  parameter x-store-type like ub.clients.obj-type    no-undo .
     8792     define input  parameter x-artic      like ub.stk-line.artic      no-undo .
     8793     define input  parameter x-prod-code  like ub.stk-line.prod-code  no-undo .
     8794     define input  parameter x-prod-type  like ub.stk-line.prod-type  no-undo .
     8795     define input  parameter x-tog-shift  as logical no-undo .
     8796     define input  parameter x-fact-order like ub.stk-line.fact-order no-undo .
     8797     define input  parameter x-sum-type   like ub.stk-line.sum-type   no-undo .
     8798     define input  parameter x-cat-id     like ub.stk-line.cat-id     no-undo .
     8799     define input  parameter xtog-obj     as logical no-undo .
     8800     define output parameter quantity     like ub.stk-line.fact-qnty  no-undo .
     8801     define output parameter coast_r      like ub.stk-line.sum-rubl   no-undo .
     8802     define output parameter coast_v      like ub.stk-line.sum-rubl   no-undo .
     8803     define output parameter vat_r        like ub.stk-line.sum-rubl   no-undo .
     8804     define output parameter vat_v        like ub.stk-line.sum-rubl   no-undo .
     8805     define output parameter slt_r        like ub.stk-line.sum-rubl   no-undo .
     8806     define output parameter slt_v        like ub.stk-line.sum-rubl   no-undo .
     8807     define buffer buff-obj-list  for obj-list .
     8808     define buffer buff-stk-line  for ub.stk-line .
     8809     assign
     8810       Quantity = 0
     8811       Coast_R  = 0
     8812       Coast_V  = 0
     8813       VAT_R    = 0
     8814       VAT_V    = 0
     8815       SLT_R    = 0
     8816       SLT_V    = 0
     8817     .
     8818     if  x-tog-shift = false then do:
     8819       for each buff-obj-list no-lock
     8820         where xtog-obj = false
     8821            or (buff-obj-list.obj-type = x-store-type
     8822               and buff-obj-list.obj-code = x-store-code
     8823               )
     8824       on error undo, return error
     8825       :
     8826       find last buff-stk-line no-lock
     8827         where buff-stk-line.obj-type   = buff-obj-list.obj-type
     8828           and buff-stk-line.obj-code   = buff-obj-list.obj-code
     8829           and buff-stk-line.artic      = x-artic
     8830           and buff-stk-line.prod-type  = x-prod-type
     8831           and buff-stk-line.prod-code  = x-prod-code
     8832           and buff-stk-line.sum-type   = x-sum-type
     8833           and buff-stk-line.cat-id     = '##,##':U
     8834           and buff-stk-line.fact-order <= x-fact-order
     8835           and buff-stk-line.shift-num  = 0
     8836         use-index category
     8837         no-error .
     8838       if available buff-stk-line then do:
     8839         assign
     8840           Quantity = Quantity + buff-stk-line.fact-qnty
     8841           Coast_R  = Coast_R  + buff-stk-line.sum-rubl
     8842           Coast_V  = Coast_V  + buff-stk-line.sum-base
     8843           VAT_R    = VAT_R    + buff-stk-line.VAT-rubl
     8844           VAT_V    = VAT_V    + buff-stk-line.VAT-base
     8845           SLT_R    = SLT_R    + buff-stk-line.SLT-rubl
     8846           SLT_V    = SLT_V    + buff-stk-line.SLT-base
     8847         .
     8848       end.
     8849      end.
     8850     end.
     8851     else do:
     8852       for each buff-obj-list no-lock
     8853         where xtog-obj = false
     8854            or (buff-obj-list.obj-type = x-store-type
     8855               and buff-obj-list.obj-code = x-store-code
     8856               )
     8857       on error undo, return error
     8858       :
     8859         find last buff-stk-line no-lock
     8860           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     8861             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     8862             and buff-stk-line.artic      = x-artic
     8863             and buff-stk-line.prod-type  = x-prod-type
     8864             and buff-stk-line.prod-code  = x-prod-code
     8865             and buff-stk-line.sum-type   = x-sum-type
     8866             and buff-stk-line.cat-id     = '##,##':U
     8867             and buff-stk-line.fact-order <= x-fact-order
     8868             and buff-stk-line.shift-num  > 0
     8869           use-index category
     8870           no-error .
     8871         if available buff-stk-line then do:
     8872           assign
     8873             Quantity = Quantity +  buff-stk-line.fact-qnty
     8874             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     8875             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     8876             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     8877             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     8878             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     8879             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     8880           .
     8881         end.
     8882       end.
     8883     end.
     8884   end procedure.
     8885   procedure ost-lineother-tax :
     8886     define input  parameter x-store-code like ub.clients.obj-code      no-undo.
     8887     define input  parameter x-store-type like ub.clients.obj-type      no-undo.
     8888     define input  parameter x-artic      like ub.stk-line.artic        no-undo.
     8889     define input  parameter x-prod-code  like ub.stk-line.prod-code    no-undo.
     8890     define input  parameter x-prod-type  like ub.stk-line.prod-type    no-undo.
     8891     define input  parameter x-tog-shift  as logical no-undo .
     8892     define input  parameter x-fact-order like ub.stk-line.fact-order   no-undo.
     8893     define input  parameter x-sum-type   like ub.stk-line.sum-type     no-undo.
     8894     define input  parameter x-type-id    like ub.stk-line.cat-id       no-undo.
     8895     define input  parameter xTog-obj     as logical no-undo .
     8896     define output parameter Quantity     like ub.stk-line.fact-qnty   no-undo.
     8897     define output parameter Coast_R      like ub.stk-line.sum-rubl    no-undo.
     8898     define output parameter Coast_V      like ub.stk-line.sum-rubl    no-undo.
     8899     define output parameter VAT_R        like ub.stk-line.sum-rubl    no-undo.
     8900     define output parameter VAT_V        like ub.stk-line.sum-rubl    no-undo.
     8901     define output parameter SLT_R        like ub.stk-line.sum-rubl    no-undo.
     8902     define output parameter SLT_V        like ub.stk-line.sum-rubl    no-undo.
     8903     define output parameter other_R      like ub.stk-line.sum-rubl    no-undo.
     8904     define output parameter other_V      like ub.stk-line.sum-rubl    no-undo.
     8905     define buffer buff-obj-list  for obj-list .
     8906     define buffer buff-stk-line  for ub.stk-line .
     8907     assign
     8908       Quantity = 0
     8909       Coast_R  = 0
     8910       Coast_V  = 0
     8911       VAT_R    = 0
     8912       VAT_V    = 0
     8913       SLT_R    = 0
     8914       SLT_V    = 0
     8915       other_R  = 0
     8916       other_V  = 0
     8917     .
     8918     if  x-tog-shift = false then do:
     8919       for each buff-obj-list no-lock
     8920         where xtog-obj = false
     8921            or (buff-obj-list.obj-type = x-store-type
     8922               and buff-obj-list.obj-code = x-store-code
     8923               )
     8924       on error undo, return error
     8925       :
     8926       find last buff-stk-line no-lock
     8927         where buff-stk-line.obj-type   = buff-obj-list.obj-type
     8928           and buff-stk-line.obj-code   = buff-obj-list.obj-code
     8929           and buff-stk-line.artic      = x-artic
     8930           and buff-stk-line.prod-type  = x-prod-type
     8931           and buff-stk-line.prod-code  = x-prod-code
     8932           and buff-stk-line.sum-type   = x-sum-type
     8933           and buff-stk-line.cat-id     = '##,##':U
     8934           and buff-stk-line.fact-order <= x-fact-order
     8935           and buff-stk-line.shift-num  = 0
     8936         use-index category
     8937         no-error .
     8938       if available buff-stk-line then do:
     8939         assign
     8940           Quantity = Quantity + buff-stk-line.fact-qnty
     8941           Coast_R  = Coast_R  + buff-stk-line.sum-rubl
     8942           Coast_V  = Coast_V  + buff-stk-line.sum-base
     8943           VAT_R    = VAT_R    + buff-stk-line.VAT-rubl
     8944           VAT_V    = VAT_V    + buff-stk-line.VAT-base
     8945           SLT_R    = SLT_R    + buff-stk-line.SLT-rubl
     8946           SLT_V    = SLT_V    + buff-stk-line.SLT-base
     8947           other_R  = other_R  + buff-stk-line.other-rubl
     8948           other_V  = other_V  + buff-stk-line.other-base
     8949         .
     8950       end.
     8951    end.
     8952     end.
     8953     else do:
     8954       for each buff-obj-list no-lock
     8955         where xtog-obj = false
     8956            or (buff-obj-list.obj-type = x-store-type
     8957               and buff-obj-list.obj-code = x-store-code
     8958               )
     8959       on error undo, return error
     8960       :
     8961         find last buff-stk-line no-lock
     8962           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     8963             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     8964             and buff-stk-line.artic      = x-artic
     8965             and buff-stk-line.prod-type  = x-prod-type
     8966             and buff-stk-line.prod-code  = x-prod-code
     8967             and buff-stk-line.sum-type   = x-sum-type
     8968             and buff-stk-line.cat-id     = '##,##':U
     8969             and buff-stk-line.fact-order <= x-fact-order
     8970             and buff-stk-line.shift-num  > 0
     8971           use-index category
     8972           no-error .
     8973         if available buff-stk-line then do:
     8974           assign
     8975             Quantity = Quantity +  buff-stk-line.fact-qnty
     8976             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     8977             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     8978             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     8979             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     8980             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     8981             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     8982             other_R = other_R   +  buff-stk-line.other-rubl
     8983             other_V = other_V   +  buff-stk-line.other-base
     8984           .
     8985         end.
     8986       end.
     8987     end.
     8988   end procedure.
     8989   procedure ost-line-kg :
     8990     define  input parameter p-obj-code    like ub.stk-line.obj-code   no-undo .
     8991     define  input parameter p-obj-type    like ub.stk-line.obj-type   no-undo .
     8992     define  input parameter p-artic       like ub.stk-line.artic      no-undo .
     8993     define  input parameter p-prod-code   like ub.stk-line.prod-code  no-undo .
     8994     define  input parameter p-prod-type   like ub.stk-line.prod-type  no-undo .
     8995     define  input parameter p-fact-order  like ub.stk-line.fact-order no-undo .
     8996     define output parameter p-quantity-kg like ub.stk-line.fact-qnty  no-undo initial 0.00 .
     8997     define buffer buff-obj-list  for obj-list .
     8998     define buffer buf_doc-line for ub.doc-line .
     8999     define buffer buf_inv-line for ub.inv-line .
     9000     do
     9001     on error undo, return error
     9002     :
     9003       for each buf_doc-line no-lock where
     9004                buf_doc-line.obj-type    = p-obj-type   and
     9005                buf_doc-line.obj-code    = p-obj-code   and
     9006                buf_doc-line.prod-type   = p-prod-type  and
     9007                buf_doc-line.prod-code   = p-prod-code  and
     9008                buf_doc-line.artic       = p-artic      and
     9009                buf_doc-line.status_     = 'факт':U      and
     9010                buf_doc-line.fact-order <= p-fact-order
     9011             by buf_doc-line.fact-order    descending
     9012       :
     9013         find first buf_inv-line no-lock where
     9014                    buf_inv-line.doc-code  = buf_doc-line.doc-code  and
     9015                    buf_inv-line.artic     = buf_doc-line.artic     and
     9016                    buf_inv-line.prod-type = buf_doc-line.prod-type and
     9017                    buf_inv-line.prod-code = buf_doc-line.prod-code no-error .
     9018         if available buf_inv-line
     9019         then do:
     9020           if buf_inv-line.after-cli-qnty <> ?
     9021           then do:
     9022             assign
     9023               p-quantity-kg = buf_inv-line.after-cli-qnty
     9024             .
     9025             leave .
     9026           end.
     9027         end.
     9028       end.
     9029       if p-quantity-kg = ?
     9030       then do:
     9031         assign
     9032           p-quantity-kg = 0
     9033         .
     9034       end.
     9035     end.
     9036   end procedure.
     9037   procedure calc-price-sale-for-prt :
     9038   define output parameter v-cur-base as decimal no-undo .
     9039   end procedure.
     9040   Procedure display-str-cr :
     9041     if c-nn <>  ?  then do :
     9042       c-nn:screen-value = string(string(n-nn)) .
     9043       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     9044           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     9045           display STREAM OutStream    with frame top-frame .
     9046       End.
     9047     End.
     9048     if c-f-artic <>  ?  then do :
     9049       c-f-artic:screen-value = string(ub.ot-line.artic) .
     9050       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     9051           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     9052           display STREAM OutStream    with frame top-frame .
     9053       End.
     9054     End.
     9055     if c-f-b-code <>  ?  then do :
     9056       c-f-b-code:screen-value = string(string(v-bar-code,'999999999')) .
     9057       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     9058           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     9059           display STREAM OutStream    with frame top-frame .
     9060       End.
     9061     End.
     9062     if c-f-gds-name <>  ?  then do :
     9063       c-f-gds-name:screen-value = string(goods.gds-name) .
     9064       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     9065           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     9066           display STREAM OutStream    with frame top-frame .
     9067       End.
     9068     End.
     9069     if c-f-qnty <>  ?  then do :
     9070       c-f-qnty:screen-value = string(f-qnty) .
     9071       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     9072           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     9073           display STREAM OutStream    with frame top-frame .
     9074       End.
     9075     End.
     9076     if c-f-cost-sum <>  ?  then do :
     9077       c-f-cost-sum:screen-value = string(f-cost-sum) .
     9078       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     9079           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     9080           display STREAM OutStream    with frame top-frame .
     9081       End.
     9082     End.
     9083     if c-f-sale-sum <>  ?  then do :
     9084       c-f-sale-sum:screen-value = string(f-sale-sum) .
     9085       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     9086           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     9087           display STREAM OutStream    with frame top-frame .
     9088       End.
     9089     End.
     9090     if c-f-sale-other <>  ?  then do :
     9091       c-f-sale-other:screen-value = string(f-sale-other) .
     9092       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     9093           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     9094           display STREAM OutStream    with frame top-frame .
     9095       End.
     9096     End.
     9097     if c-f-crsa-sum <>  ?  then do :
     9098       c-f-crsa-sum:screen-value = string(f-crsa-sum) .
     9099       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     9100           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     9101           display STREAM OutStream    with frame top-frame .
     9102       End.
     9103     End.
     9104     if c-f-qnty-all <>  ?  then do :
     9105       c-f-qnty-all:screen-value = string(f-qnty-all) .
     9106       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     9107           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     9108           display STREAM OutStream    with frame top-frame .
     9109       End.
     9110     End.
     9111     if c-f-cost-sum-all <>  ?  then do :
     9112       c-f-cost-sum-all:screen-value = string(f-cost-sum-all) .
     9113       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     9114           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     9115           display STREAM OutStream    with frame top-frame .
     9116       End.
     9117     End.
     9118     if c-f-crsa-sum-all <>  ?  then do :
     9119       c-f-crsa-sum-all:screen-value = string(f-crsa-sum-all) .
     9120       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     9121           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     9122           display STREAM OutStream    with frame top-frame .
     9123       End.
     9124     End.
     9125     if c-f-qnty-o <>  ?  then do :
     9126       c-f-qnty-o:screen-value = string(f-qnty-o) .
     9127       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     9128           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     9129           display STREAM OutStream    with frame top-frame .
     9130       End.
     9131     End.
     9132     if c-f-cost-sum-o <>  ?  then do :
     9133       c-f-cost-sum-o:screen-value = string(f-cost-sum-o) .
     9134       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     9135           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     9136           display STREAM OutStream    with frame top-frame .
     9137       End.
     9138     End.
     9139     if c-f-crsa-sum-o <>  ?  then do :
     9140       c-f-crsa-sum-o:screen-value = string(f-crsa-sum-o) .
     9141       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     9142           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     9143           display STREAM OutStream    with frame top-frame .
     9144       End.
     9145     End.
     9146     display stream OutStream   with frame zapas  no-error  .
     9147     DOWN stream OutStream  with frame zapas .
     9148     if Make-Excel then  put   stream ForExcel unformatted
     9149       string(n-nn)                      CHR(9)
     9150       v-bar-code                        CHR(9)
     9151       (ub.ot-line.artic)  CHR(9)
     9152       goods.gds-name                    CHR(9)
     9153       excel-qnty(f-qnty        )        CHR(9)
     9154       excel-sum (f-cost-sum    )        CHR(9)
     9155       excel-sum (f-sale-sum    )        CHR(9)
     9156       excel-sum (f-sale-other  )        CHR(9)
     9157       excel-sum (f-crsa-sum    )        CHR(9)
     9158       excel-sum (f-qnty-all    )        CHR(9)
     9159       excel-sum (f-cost-sum-all)        CHR(9)
     9160       excel-sum (f-crsa-sum-all)        CHR(9)
     9161       excel-sum (f-qnty-o      )        CHR(9)
     9162       excel-qnty(f-cost-sum-o  )        CHR(9)
     9163       excel-qnty(f-crsa-sum-o  )        chr(10) .
     9164   end procedure.
     9165   procedure init-p2 :
     9166   run cur-time in this-procedure ( output v-today
     9167                               , output x-time
     9168                               ).
     9169   find last ub.ot-tot  no-lock use-index pi .
     9170   if avail  ub.ot-tot then fix-doc-code = ub.ot-tot.doc-code.
     9171                 else fix-doc-code = "".
     9172   FIND first clients where x-store-type = clients.obj-type AND
     9173           x-store-code = clients.obj-code no-lock no-error.
     9174           If available clients then  ObjName = clients.obj-name.
     9175                                         else  ObjName="объект не определен".
     9176     assign
     9177       i=0
     9178       startdate     = x-date-start
     9179       enddate       = x-date-end
     9180       PayType       = x-SET_PAY_TYPE
     9181       v-var         = string("")
     9182       ValType       = IF (PayType = 1) Then 0  else x-SET_val_TYPE.
     9183       Find first ub.gds-prt where ub.gds-prt.node-name = '_Пустая шкала':U no-lock no-error.
     9184       If available  ub.gds-prt then   Prtroot = ub.gds-prt.prt-root.
     9185                             Else   Prtroot = 0.
     9186   end procedure.
     9187   procedure in-proc:
     9188     if can-find( first tdedt where  ub.ot-line.ext-doc-type = tdedt.id no-lock ) then DO:
     9189         Case  ub.ot-line.sum-type :
     9190             When 'cost':U then do:
     9191                 f-cost-sum = f-cost-sum + ub.ot-line.sum-rubl .
     9192             End.
     9193             When 'sale':U then do:
     9194                 f-sale-sum   = f-sale-sum   +  ub.ot-line.sum-rubl .
     9195                 f-sale-other = f-sale-other + ub.ot-line.other-rubl .
     9196             End.
     9197             When  'crsa':U then do:
     9198                 f-crsa-sum = f-crsa-sum + ub.ot-line.sum-rubl  .
     9199                 f-qnty     = f-qnty     + ub.ot-line.fact-qnty .
     9200                 IF itog = false then do:
     9201                     Create temp-doc-code .
     9202                     Assign  temp-doc-code.doc-code = ub.ot-line.doc-code
     9203                             temp-doc-code.ext-doc-type = ub.ot-line.ext-doc-type
     9204                     .
     9205                 End.
     9206             End.
     9207         End case.
     9208       End.
     9209         Case  ub.ot-line.sum-type :
     9210             when 'cost':U then do:
     9211               f-cost-sum-all = f-cost-sum-all + ub.ot-line.sum-rubl .
     9212             end.
     9213             when  'crsa':U then do:
     9214               f-crsa-sum-all = f-crsa-sum-all + ub.ot-line.sum-rubl  .
     9215               f-qnty-all     = f-qnty-all     + ub.ot-line.fact-qnty .
     9216             end.
     9217         End case.
     9218   end procedure.
     9219   procedure last-of-artic :
     9220           n-nm = n-nm + 1.
     9221           Assign
     9222             f-qnty-o     = gds-obj.fact-qnty
     9223             f-cost-sum-o = gds-obj.fact-rubl
     9224             f-crsa-sum-o = gds-obj.fact-sale.
     9225           if itog = false and
     9226             ( x-zero  or
     9227             not(f-qnty        = 0 and
     9228                 f-cost-sum    = 0 and
     9229                 f-sale-sum    = 0 and
     9230                 f-sale-other  = 0 and
     9231                 f-crsa-sum    = 0 and
     9232                 f-qnty-all    = 0 and
     9233                 f-cost-sum-all =0 and
     9234                 f-crsa-sum-all =0 and
     9235                 f-qnty-o       =0 and
     9236                 f-cost-sum-o   =0 and
     9237                 f-crsa-sum-o   =0 ))
     9238             Then DO:
     9239             if x-zero = true and v-show-all-goods = false and
     9240                (f-qnty        = 0 and
     9241                 f-cost-sum    = 0 and
     9242                 f-sale-sum    = 0 and
     9243                 f-sale-other  = 0 and
     9244                 f-crsa-sum    = 0 and
     9245                 f-qnty-all    = 0 and
     9246                 f-cost-sum-all =0 and
     9247                 f-crsa-sum-all =0 and
     9248                 f-qnty-o       =0 and
     9249                 f-cost-sum-o   =0 and
     9250                 f-crsa-sum-o   =0 ) then next.
     9251                 n-nn = n-nn + 1 .
     9252   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     9253     (input  gds-obj.gds-code
     9254     ,input  ?
     9255     ,output v-bar-code
     9256     )  .
     9257     if c-nn <>  ?  then do :
     9258       c-nn:screen-value = string(string(n-nn)) .
     9259       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     9260           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     9261           display STREAM OutStream    with frame top-frame .
     9262       End.
     9263     End.
     9264     if c-f-artic <>  ?  then do :
     9265       c-f-artic:screen-value = string(gds-obj.artic) .
     9266       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     9267           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     9268           display STREAM OutStream    with frame top-frame .
     9269       End.
     9270     End.
     9271     if c-f-b-code <>  ?  then do :
     9272       c-f-b-code:screen-value = string(string(v-bar-code,'999999999')) .
     9273       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     9274           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     9275           display STREAM OutStream    with frame top-frame .
     9276       End.
     9277     End.
     9278     if c-f-gds-name <>  ?  then do :
     9279       c-f-gds-name:screen-value = string(goods.gds-name) .
     9280       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     9281           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     9282           display STREAM OutStream    with frame top-frame .
     9283       End.
     9284     End.
     9285     if c-f-qnty <>  ?  then do :
     9286       c-f-qnty:screen-value = string(f-qnty) .
     9287       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     9288           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     9289           display STREAM OutStream    with frame top-frame .
     9290       End.
     9291     End.
     9292     if c-f-cost-sum <>  ?  then do :
     9293       c-f-cost-sum:screen-value = string(f-cost-sum) .
     9294       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     9295           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     9296           display STREAM OutStream    with frame top-frame .
     9297       End.
     9298     End.
     9299     if c-f-sale-sum <>  ?  then do :
     9300       c-f-sale-sum:screen-value = string(f-sale-sum) .
     9301       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     9302           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     9303           display STREAM OutStream    with frame top-frame .
     9304       End.
     9305     End.
     9306     if c-f-sale-other <>  ?  then do :
     9307       c-f-sale-other:screen-value = string(f-sale-other) .
     9308       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     9309           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     9310           display STREAM OutStream    with frame top-frame .
     9311       End.
     9312     End.
     9313     if c-f-crsa-sum <>  ?  then do :
     9314       c-f-crsa-sum:screen-value = string(f-crsa-sum) .
     9315       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     9316           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     9317           display STREAM OutStream    with frame top-frame .
     9318       End.
     9319     End.
     9320     if c-f-qnty-all <>  ?  then do :
     9321       c-f-qnty-all:screen-value = string(f-qnty-all) .
     9322       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     9323           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     9324           display STREAM OutStream    with frame top-frame .
     9325       End.
     9326     End.
     9327     if c-f-cost-sum-all <>  ?  then do :
     9328       c-f-cost-sum-all:screen-value = string(f-cost-sum-all) .
     9329       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     9330           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     9331           display STREAM OutStream    with frame top-frame .
     9332       End.
     9333     End.
     9334     if c-f-crsa-sum-all <>  ?  then do :
     9335       c-f-crsa-sum-all:screen-value = string(f-crsa-sum-all) .
     9336       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     9337           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     9338           display STREAM OutStream    with frame top-frame .
     9339       End.
     9340     End.
     9341     if c-f-qnty-o <>  ?  then do :
     9342       c-f-qnty-o:screen-value = string(f-qnty-o) .
     9343       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     9344           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     9345           display STREAM OutStream    with frame top-frame .
     9346       End.
     9347     End.
     9348     if c-f-cost-sum-o <>  ?  then do :
     9349       c-f-cost-sum-o:screen-value = string(f-cost-sum-o) .
     9350       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     9351           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     9352           display STREAM OutStream    with frame top-frame .
     9353       End.
     9354     End.
     9355     if c-f-crsa-sum-o <>  ?  then do :
     9356       c-f-crsa-sum-o:screen-value = string(f-crsa-sum-o) .
     9357       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     9358           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     9359           display STREAM OutStream    with frame top-frame .
     9360       End.
     9361     End.
     9362                 display stream OutStream with FRAME Zapas  no-error .
     9363                 DOWN stream OutStream with FRAME Zapas.
     9364                 if Make-Excel then  put   stream ForExcel unformatted
     9365                   string(n-nn)                      CHR(9)
     9366                   v-bar-code                        CHR(9)
     9367                   (gds-obj.artic)                   CHR(9)
     9368                   goods.gds-name                    CHR(9)
     9369                   excel-qnty(f-qnty        )        CHR(9)
     9370                   excel-sum (f-cost-sum    )        CHR(9)
     9371                   excel-sum (f-sale-sum    )        CHR(9)
     9372                   excel-sum (f-sale-other  )        CHR(9)
     9373                   excel-sum (f-crsa-sum    )        CHR(9)
     9374                   excel-sum (f-qnty-all    )        CHR(9)
     9375                   excel-sum (f-cost-sum-all)        CHR(9)
     9376                   excel-sum (f-crsa-sum-all)        CHR(9)
     9377                   excel-sum (f-qnty-o      )        CHR(9)
     9378                   excel-qnty(f-cost-sum-o  )        CHR(9)
     9379                   excel-qnty(f-crsa-sum-o  )        chr(10) .
     9380                   run display-prt in this-procedure .
     9381            End.
     9382   end procedure.
