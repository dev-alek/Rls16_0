     2289                 "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     2290                 "Количество" buf_price-list.doc-qnty skip
     2291                 "Основная единица измерения" v-unit-base skip
     2292                 "Единица измерения бар-кода" buf_bar-code.unit-cli skip
     2293                 view-as alert-box error .
     2294               undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     2295             end.
     2296             next .
     2297           end.
     2298           if not can-find
     2299             (first buf_bar-code
     2300             where buf_bar-code.b-code = buf_price-list.b-code
     2301             )
