     5840                             ub.ot-line.fact-order <= fact-order-2 and
     5841                             ub.ot-line.fact-order >= fact-order-1 and
     5842                             ub.ot-line.obj-code    = obj-list.obj-code and
     5843                             ub.ot-line.obj-type    = obj-list.obj-type  and
     5844                             ub.ot-line.prod-type   = goods.prod-type and
     5845                             ub.ot-line.prod-code   = goods.prod-code and
     5846                             ub.ot-line.artic       = goods.artic  and
     5847                             (ub.ot-line.sum-type   = 'sale':U OR
     5848                               ub.ot-line.sum-type  = 'crsa':U OR
     5849                               ub.ot-line.sum-type  = 'cost':U )
     5850                   ,
     5851                     each gds-list where
     5852                         gds-list.gds-code = ub.gds-season.gds-code
     5853                         break
     5854                           by goods.grp-name
     5855                           by ub.gds-season.db-num
     5856                           by ub.gds-season.sea-code
     5857                           by ub.gds-season.gds-code
     5858                           with FRAME Zapas :
     5859                n-nm = n-nm + 1.
     5860               IF first-of(ub.gds-season.gds-code) then DO:
     5861                   assign
     5862                     f-qnty         = 0
     5863                     f-cost-sum     = 0
     5864                     f-sale-sum     = 0
     5865                     f-sale-other   = 0
     5866                     f-crsa-sum     = 0
     5867                     f-qnty-all     = 0
     5868                     f-cost-sum-all = 0
     5869                     f-crsa-sum-all = 0
     5870                     f-qnty-o       = 0
     5871                     f-cost-sum-o   = 0
     5872                     f-crsa-sum-o   = 0.
     5873                  For Each temp-doc-code  : delete temp-doc-code . end.
     5874                  For Each temp-doc-code-all  : delete temp-doc-code-all . end.
     5875               End.
     5876               if can-find( first tdedt where  ub.ot-line.ext-doc-type = tdedt.id no-lock ) then DO:
     5877                   Case  ub.ot-line.sum-type :
     5878                       When 'cost':U then do:
     5879                           f-cost-sum = f-cost-sum + ub.ot-line.sum-rubl .
     5880                       End.
     5881                       When 'sale':U then do:
     5882                           f-sale-sum   = f-sale-sum   +  ub.ot-line.sum-rubl .
     5883                           f-sale-other = f-sale-other + ub.ot-line.other-rubl .
     5884                       End.
     5885                       When  'crsa':U then do:
     5886                           f-crsa-sum = f-crsa-sum + ub.ot-line.sum-rubl  .
     5887                           f-qnty     = f-qnty     + ub.ot-line.fact-qnty .
     5888                           IF itog = false then do:
     5889                               Create temp-doc-code .
     5890                               Assign
     5891                                  temp-doc-code.doc-code = ub.ot-line.doc-code
     5892                                  temp-doc-code.si  = if  ub.ot-line.fact-qnty < 0 then -1 else 1
     5893                                  temp-doc-code.si2 = if  ub.ot-line.other-rubl < 0 then -1 else 1
     5894                                  .
     5895                           End.
     5896                       End.
     5897                   End case.
     5898                 End.
     5899                   Case  ub.ot-line.sum-type :
     5900                       when 'cost':U then do:
