     8712       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     8713           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     8714           display STREAM OutStream    with frame top-frame .
     8715       End.
     8716     End.
     8717     if c-f-crsa-sum-all <>  ?  then do :
     8718       c-f-crsa-sum-all:screen-value = string(p-crsa-sum-all) .
     8719       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     8720           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     8721           display STREAM OutStream    with frame top-frame .
     8722       End.
     8723     End.
     8724     if c-f-qnty-o <>  ?  then do :
     8725       c-f-qnty-o:screen-value = string(p-qnty-o) .
     8726       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
