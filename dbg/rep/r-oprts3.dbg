     7962             n-nn = 0.
     7963             n-no = n-no + 1 .
     7964   for each tt-season no-lock ,
     7965       each ub.gds-season no-lock where
     7966            ub.gds-season.db-num   = tt-season.db-num and
     7967            ub.gds-season.sea-code = tt-season.sea-code ,
     7968       each gds-obj where
     7969             gds-obj.gds-code    = ub.gds-season.gds-code and
     7970             gds-obj.obj-code    = obj-list.obj-code and
     7971             gds-obj.obj-type    = obj-list.obj-type
     7972             and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     7973             no-lock,
     7974             first goods where   gds-obj.gds-code  = goods.gds-code and
