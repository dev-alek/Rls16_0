     5834                          ub.gds-season.sea-code = tt-season.sea-code and
     5835                          ub.gds-season.db-num   = tt-season.db-num ,
     5836                     each goods no-lock where
     5837                          goods.gds-code    = ub.gds-season.gds-code and
