     1145   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1146   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
     1147     (input  v-report-name
     1148     ,input  2
     1149     ,output v-exist
     1150     )  .
     1151       if NOT v-exist then
     1152       DO:
     1153         Message
     1154           "Нет заданий на печать ! "
     1155           view-as alert-box .
     1156         Return  .
     1157       End.
     1158       run gbl/prnfilen.w
     1159         (input  ""
     1160         ,input  p-DisabledOptions
     1161         ,input  string(v-report-name )
     1162         ,input  7
     1163         ,output v-user-action
     1164         ,output v-printed
     1165         ) .
     1166       if v-printed then
