     6795   PROCEDURE treegrp :
     6796   def input parameter c like ub.cli-grp.node-code.
     6797   def param buffer b-cli-grp for ub.cli-grp.
     6798   def buffer up-cli-grp for ub.cli-grp.
     6799   define variable no-nodes as logical initial yes.
     6800   FOR EACH b-cli-grp where b-cli-grp.upper-code = c  NO-LOCK:
     6801           no-nodes = no.
     6802           RUN treegrp ( ub.cli-grp.node-code, buffer b-cli-grp ).
     6803   END .
     6804   if no-nodes then do:
     6805           FIND FIRST up-cli-grp NO-LOCK where up-cli-grp.node-code = c NO-ERROR.
     6806                   create sj-groups.
     6807                   assign
     6808                   sj-groups.g-code = up-cli-grp.node-code
     6809                   sj-groups.g-name = up-cli-grp.node-name
     6810                   .
     6811   end.
     6812   END PROCEDURE.
