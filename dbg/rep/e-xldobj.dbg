     1176   procedure prn-lib-open-stream :
     1177     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1178     define input parameter p-page-size    as integer no-undo .
     1179     define input parameter p-is-stream    as logical no-undo .
     1180     define input parameter p-append       as logical no-undo .
     1181     define variable v-report-name as character no-undo .
     1182     do
     1183       on error undo, return error
     1184       :
     1185       run prn-lib-get-report-name  in this-procedure (
     1186         input parParentProc
     1187         ,output v-report-name
     1188         ).
     1189       if p-is-stream then
     1190       do:
     1191         if p-append then
     1192         do:
     1193           output stream PrnLibStream to value( v-report-name )
     1194             page-size value(p-page-size) append .
     1195         end.
     1196         if not p-append then
     1197         do:
     1198           output stream PrnLibStream to value( v-report-name )
     1199             page-size value(p-page-size) .
     1200         end.
     1201       end.
     1202       if not p-is-stream then
     1203       do:
     1204         if p-append then
     1205         do:
     1206           output to value( v-report-name )
     1207             page-size value(p-page-size) append .
     1208         end.
     1209         if not p-append then
     1210         do:
     1211           output to value( v-report-name )
     1212             page-size value(p-page-size) .
     1213         end.
     1214       end.
     1215     end.
     1216   end procedure.
     1217   procedure prn-lib-open-exp :
     1218     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1219     define input parameter p-is-stream    as logical no-undo .
     1220     define input parameter p-is-append    as logical no-undo .
     1221     define output parameter p-ReportFileName as char init "report" no-undo.
     1222     define output parameter p-process as logical no-undo .
     1223     define variable glog as logical no-undo .
     1224     do
     1225       on error undo, return error
     1226       :
     1227       SYSTEM-DIALOG GET-FILE p-ReportFileName
     1228         TITLE      "Укажите путь"
     1229         FILTERS "Текстовый файл (*.txt)"   "*.txt"
     1230         ASK-OVERWRITE
     1231         CREATE-TEST-FILE
     1232         SAVE-AS
     1233         USE-FILENAME
     1234         DEFAULT-EXTENSION "txt"
     1235         UPDATE glog
     1236         .
     1237       if not glog then  return.
     1238       p-ReportFileName = trim( string( p-ReportFileName ) ) .
     1239       if p-is-stream then
     1240       do:
     1241         if p-is-append then
     1242         do:
     1243           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1244         end.
     1245         else
     1246         do:
     1247           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1248         end.
     1249       end.
     1250       else
     1251       do:
     1252         if p-is-append then
     1253         do:
     1254           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1255         end.
     1256         else
     1257         do:
     1258           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1259         end.
     1260       end.
     1261       p-process = yes.
     1262     end.
     1263   end procedure.
     1264   procedure prn-lib-get-report-name :
     1265     define input parameter parParentProc  as widget-handle no-undo.
