     6113   (dis-obj.gds-tot-base + dis-obj.sum-tot-base) @ TotalSum
     6114   (dis-obj.gds-dis-base +  dis-obj.sum-dis-base) @ DiscSum
     6115   ((dis-obj.gds-tot-base + dis-obj.sum-tot-base) -
     6116    (dis-obj.gds-dis-base +  dis-obj.sum-dis-base)) @ NettoSum
     6117     dis-obj.pay-tot-base @ InstantPaySum
