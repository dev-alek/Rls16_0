     3444     DISPLAY STREAM PrnLibStream
     3445     "ИТОГО по маг-ну" @ ub.dis-obj.d-card
     3446     (string(ACCUM COUNT by ub.dis-obj.obj-code ub.dis-obj.d-card) + " карт ") @ sj-cards.cli-name
     3447     "" @ for-d-pcnt
     3448     ACCUM TOTAL by ub.dis-obj.obj-code (ub.dis-obj.gds-tot-rubl + ub.dis-obj.sum-tot-rubl) @ TotalSum
     3449     ACCUM TOTAL by ub.dis-obj.obj-code (ub.dis-obj.gds-dis-rubl + ub.dis-obj.sum-dis-rubl) @ DiscSum
     3450     ACCUM TOTAL by ub.dis-obj.obj-code
     3451     ((ub.dis-obj.gds-tot-rubl + ub.dis-obj.sum-tot-rubl) -
     3452      (ub.dis-obj.gds-dis-rubl + ub.dis-obj.sum-dis-rubl))  @ NettoSum
     3453     ACCUM TOTAL by ub.dis-obj.obj-code ub.dis-obj.pay-tot-rubl @ InstantPaySum
     3454     ACCUM TOTAL by ub.dis-obj.obj-code
     3455     ((ub.dis-obj.gds-tot-rubl + ub.dis-obj.sum-tot-rubl) -
     3456      (ub.dis-obj.gds-dis-rubl + ub.dis-obj.sum-dis-rubl) -
     3457       ub.dis-obj.pay-tot-rubl) @ CreditSum
     3458     ACCUM TOTAL by ub.dis-obj.obj-code ub.dis-obj.num-chk @ ub.dis-obj.num-chk
     3459     with frame X123 .
     3460     UNDERLINE stream PrnLibStream   ub.dis-obj.d-card   ub.dis-obj.obj-code   sj-cards.cli-name   FOR-d-pcnt   TotalSum   DiscSum   NettoSum   InstantPaySUm   CreditSum   PaySUmStr   SaldoSumStr   MustPayStr   ub.dis-obj.num-chk   With frame X123.
     3461     DOWN stream PrnLibStream   with frame X123.
     3462   end.
     3463   If last(ub.dis-obj.obj-code)  then do:
     3464     assign
     3465       TotalSum = 0
     3466       DiscSum = 0
     3467       NettoSum = 0
     3468       CreditSum = 0
     3469       InstantPaySum = 0
     3470       CreditSum = 0
     3471       vPaySum = 0
     3472       vMustPay = 0
     3473       vSaldoSUm = 0
     3474       vnum-chk = 0
     3475     .
     3476     FOR EACH sj-groups No-LOCK WHERE
     3477              sj-groups.obj-code = 0:
     3478       DISPLAY STREAM PrnLibStream
     3479       "Итого по объектам" @ ub.dis-obj.d-card
     3480       sj-groups.g-name @ sj-cards.cli-name
     3481       sj-groups.g-name @ sj-cards.cli-name
     3482       sj-groups.tot @ TotalSum
     3483       sj-groups.disc @ DiscSum
     3484       sj-groups.netto @ NettoSum
     3485       sj-groups.instant-pay @ InstantPaySum
     3486       sj-groups.credit-pay @ CreditSum
     3487       sj-groups.pay @ PaySumStr
     3488       sj-groups.must-pay @  MustPayStr
     3489       sj-groups.saldo @  SaldoSUmStr
     3490       sj-groups.num-chk @ ub.dis-obj.num-chk
     3491       WITH FRAME X123.
     3492       DOWN stream PrnLibStream   with frame X123.
     3493       assign
     3494         TotalSum      = TotalSum      + sj-groups.tot
     3495         DiscSum       = DiscSum       + sj-groups.disc
     3496         NettoSum      = NettoSum      + sj-groups.netto
     3497         InstantPaySum = InstantPaySum + sj-groups.instant-pay
     3498         CreditSum     = CreditSum     + sj-groups.credit-pay
     3499         vPaySum       = vPaySum       + sj-groups.pay
     3500         vMustPay      = vMustPay      + sj-groups.must-pay
     3501         vSaldoSUm     = vSaldoSUm     + sj-groups.saldo
     3502         vnum-chk      = vnum-chk      + sj-groups.num-chk
     3503       .
     3504     END.
     3505     UNDERLINE stream PrnLibStream   ub.dis-obj.d-card   ub.dis-obj.obj-code   sj-cards.cli-name   FOR-d-pcnt   TotalSum   DiscSum   NettoSum   InstantPaySUm   CreditSum   PaySUmStr   SaldoSumStr   MustPayStr   ub.dis-obj.num-chk   With frame X123.
     3506     DOWN stream PrnLibStream   with frame X123.
     3507   END.
     3508   if last(ub.dis-obj.obj-code) then do:
     3509     FIND FIRST sj-cards where sj-cards.d-card = ? NO-ERROR.
     3510     DISPLAY STREAM PrnLibStream
     3511     "ИТОГО" @ ub.dis-obj.d-card
     3512     (string(sj-cards.obj-qnty) + " карт") @ sj-cards.cli-name
     3513     TotalSum
     3514     DiscSum
     3515     NettoSum
     3516     InstantPaySum
     3517     CreditSum
     3518     vnum-chk @ ub.dis-obj.num-chk
     3519     vPaySum   @ PaySumStr
     3520     vMustPay  @ MustPayStr
     3521     vSaldoSUm @ SaldoSumStr
     3522     with frame X123 .
     3523     UNDERLINE stream PrnLibStream   ub.dis-obj.d-card   ub.dis-obj.obj-code   sj-cards.cli-name   FOR-d-pcnt   TotalSum   DiscSum   NettoSum   InstantPaySUm   CreditSum   PaySUmStr   SaldoSumStr   MustPayStr   ub.dis-obj.num-chk   With frame X123.
     3524   end.
     3525       ENd.
     3526     END.
     3527   end.
     3528   END PROCEDURE.
     3529   PROCEDURE local-initialize :
     3530     RUN dispatch IN THIS-PROCEDURE ( INPUT 'initialize':U ) .
     3531   define variable v-conf-type as character no-undo .
     3532   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     3533     (input  'dcoveris'
     3534     ,input  0
     3535     ,input  '':U
     3536     ,input  0
     3537     ,input  '':U
     3538     ,input  '':U
     3539     ,input  '':U
     3540     ,input  NO
     3541     ,output v-dcoveris
     3542     ,output v-conf-type
     3543     ) NO-ERROR .
     3544     IF ERROR-STATUS:ERROR OR
     3545       v-conf-type <> 'L':U THEN
     3546       v-dcoveris = "no".
     3547      if v-dcoveris <> "yes" then disable
     3548      t-legacy with
     3549      frame F-Main .
     3550   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3551     run mainmenu_getcntxt in my-handle
     3552       (output v-cntxt-db-num
     3553       ,output v-cntxt-userid
     3554       ,output v-cntxt-level
     3555       ,output v-cntxt-host-code-obj
     3556       ,output v-cntxt-obj-type
     3557       ,output v-cntxt-obj-code
     3558       ,output v-cntxt-db-num-obj
     3559       ,output v-cntxt-is-admin
     3560       ) .
     3561   END PROCEDURE.
     3562   PROCEDURE My-report :
     3563   define variable current-group like ub.cli-grp.node-name.
     3564   define variable host-name like ub.clients.obj-name.
     3565   define variable up-current-group like ub.cli-grp.node-name.
     3566   define variable jj as integer no-undo.
     3567   define variable v-ii as integer no-undo .
     3568   define variable v-d-card like ub.dis-card.d-card no-undo .
     3569   define variable last-card like ub.dis-card.d-card no-undo .
     3570   define variable last-card-d-pcntchr as character no-undo .
     3571   define variable accum-must-pay      as decimal no-undo .
     3572   define variable accum-saldo         as decimal no-undo .
     3573   define variable accum-pay           as decimal no-undo .
     3574   define variable accum-tot           as decimal no-undo .
     3575   define variable accum-disc          as decimal no-undo .
     3576   define variable accum-netto         as decimal no-undo .
     3577   define variable accum-instant-pay   as decimal no-undo .
     3578   define variable accum-credit-pay    as decimal no-undo .
     3579   define variable accum-num-chk       as integer no-undo .
     3580   def buffer bsj-cards for sj-cards.
     3581   def buffer bsj-groups for sj-groups.
     3582   define buffer buf_dis-card for ub.dis-card.
     3583   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     3584   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     3585     (output v-curr-r-b
     3586     )  .
     3587   run My-var.
     3588   if dis-obj-found then do:
     3589      for each sj-cards:
     3590       delete sj-cards.
     3591      end.
     3592      for each legacy-obj:
     3593       delete legacy-obj.
     3594      end.
     3595      for each sj-groups:
     3596       delete sj-groups.
     3597      end.
     3598       dis-obj-found = no.
     3599      if DcardMode = "GROUP-LIST":U then do:
     3600         FIND FIRST ub.cli-grp where
     3601                     ub.cli-grp.node-code = current-gcode NO-LOCK NO-ERROR.
     3602         up-current-group = ub.cli-grp.node-name.
     3603         RUN treegrp(ub.cli-grp.node-code, buffer cli-grp).
     3604      end.
     3605       run rep/e-xldbj.p (
     3606                       input v-cntxt-host-code-obj
     3607                      ,input DCardMode
     3608                      ,input FixDcard
     3609                      ,input current-gcode
     3610                      ,input cli-str
     3611                      ,input Filter-name
     3612                      ,input TotalOnly
     3613                      ,INPUT t-legacy
     3614                      ,input t-subsid
     3615                      ,input (if one-firm and v-curr-r-b = 'base':U
     3616                             then 'base':U
     3617                             else 'rubl':U)
     3618                      ,input (if RS-sort = "group"
     3619                              OR dcardmode = "group":U
     3620                              then "group"
     3621                              else "")
     3622                      ,input (if current-gcode = 0
     3623                             then "ALL"
     3624                             else  (IF DCARDmode = "GROUP"
     3625                                     then "ONE"
     3626                                     else "LIST")
     3627                                   )
     3628                      )
     3629                      no-error
     3630                      .
     3631     if error-status:error then do:
     3632       message
     3633       vss-workfile vss-revision vss-description skip
     3634       "Ошибки при сборе информации для отчета" skip
     3635       error-status:get-message(1) skip
     3636       return-value
     3637       view-as alert-box .
     3638       return.
     3639     end.
     3640     if NOT dis-obj-found then do:
     3641       run waitfram-hide in this-procedure .
     3642       message "На выбранных Вами объектах" skip
     3643               "нет итогов по дисконтным картам" skip
     3644               "постоянных клиентов" skip
     3645               "либо объекты принадлежат нетекущей фирме"
     3646       view-as alert-box INFORMATION .
     3647       return.
     3648     end.
     3649     IF t-legacy
     3650     or t-subsid
     3651     THEN DO:
     3652       FOR EACH sj-cards NO-LOCK WHERE
     3653              sj-cards.is-sum = no
     3654       BREAK
     3655       BY sj-cards.card-num-chr
     3656       :
     3657          IF FIRST-OF (sj-cards.card-num-chr) THEN DO:
     3658             ASSIGN
     3659             accum-must-pay      = 0
     3660             accum-saldo         = 0
     3661             accum-pay           = 0
     3662             accum-tot           = 0
     3663             accum-disc          = 0
     3664             accum-netto         = 0
     3665             accum-instant-pay   = 0
     3666             accum-credit-pay    = 0
     3667             accum-num-chk       = 0
     3668             .
     3669          END.
     3670           ASSIGN
     3671           accum-must-pay      = accum-must-pay       +            sj-cards.must-pay
     3672           accum-saldo         = accum-saldo          +            sj-cards.saldo
     3673           accum-pay           = accum-pay            +            sj-cards.pay
     3674           accum-tot           = accum-tot            +            sj-cards.tot
     3675           accum-disc          = accum-disc           +            sj-cards.disc
     3676           accum-netto         = accum-netto          +            sj-cards.netto
     3677           accum-instant-pay   = accum-instant-pay    +            sj-cards.instant-pay
     3678           accum-credit-pay    = accum-credit-pay     +            sj-cards.credit-pay
     3679           accum-num-chk       = accum-num-chk        +            sj-cards.num-chk
     3680           .
     3681          IF last-OF (sj-cards.card-num-chr) THEN DO:
     3682            create bsj-cards.
     3683            buffer-copy sj-cards except
     3684            must-pay
     3685            saldo
     3686            pay
     3687            tot
     3688            disc
     3689            netto
     3690            instant-pay
     3691            credit-pay
     3692            num-chk
     3693            to bsj-cards
     3694            assign
     3695            bsj-cards.d-card           =  sj-cards.last-card
     3696            bsj-cards.is-sum = yes
     3697            bsj-cards.must-pay         = accum-must-pay
     3698            bsj-cards.saldo            = accum-saldo
     3699            bsj-cards.pay              = accum-pay
     3700            bsj-cards.tot              = accum-tot
     3701            bsj-cards.disc             = accum-disc
     3702            bsj-cards.netto            = accum-netto
     3703            bsj-cards.instant-pay      = accum-instant-pay
     3704            bsj-cards.credit-pay       = accum-credit-pay
     3705            bsj-cards.num-chk          = accum-num-chk
     3706            .
     3707            release bsj-cards.
     3708          end.
     3709       END.
     3710     END.
     3711     Line = fill( "-", 200 ) .
     3712     FIND FIRST ub.clients NO-LOCK WHERE
     3713               ub.clients.obj-type = 'орг':U AND
     3714              ub.clients.obj-code = v-cntxt-host-code-obj NO-ERROR.
     3715     IF AVAIL ub.clients then
     3716     host-name = ub.clients.obj-name.
     3717      run prn-lib-open-stream  in this-procedure (
     3718                                                   input my-handle
     3719                                                   ,input 43
     3720                                                   ,input yes
     3721                                                   ,input no
     3722                                                   ).
     3723     FORM HEADER
     3724     Line format "X(198)" AT 1 SKIP
     3725     "Продолжение - на следующей странице" AT 30 SKIP
     3726     with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     3727     VIEW stream PrnLibStream FRAME BottomFrame .
     3728     PUT stream PrnLibStream space(40)
     3729     "Итоги по дисконтным картам постоянныx клиентов" skip
     3730     space(20) "По объектам :  " .
     3731     FOR EACH obj-list NO-LOCK
     3732     :
     3733         FIND FIRST cli-obj WHERE
     3734                   cli-obj.obj-type = obj-list.obj-type AND
     3735                   cli-obj.obj-code = obj-list.obj-code NO-LOCK .
     3736         FIND FIRST ub.db WHERE
     3737                   ub.db.db-num = cli-obj.db-num NO-LOCK .
     3738         PUT stream PrnLibStream
     3739             string( trim( string( db.db-name, "x(30)" ) ) + " / " + cli-obj.obj-name )
     3740             format "x(100)"     skip(0)  space(35).
     3741         ACCUMULATE obj-list.obj-code (COUNT).
     3742     END.
     3743     num-objs = ACCUM COUNT obj-list.obj-code.
     3744     PUT stream PrnLibStream "" skip .
     3745     CASE DcardMode:
     3746         when "ALL":U then do:
     3747             PUT stream PrnLibStream space(20) "По ВСЕМ клиентам." format "x(40)" skip(0).
     3748         end.
     3749         when "GROUP":U then do:
     3750             FIND FIRST cli-grp where
     3751                        cli-grp.node-code = current-gcode NO-LOCK NO-ERROR.
     3752             PUT stream PrnLibStream
     3753             space(20) ( "По группе : " + cli-grp.node-name ) format "x(80)" skip(0).
     3754         end.
     3755         when "GROUP-LIST":U then do:
     3756             FIND FIRST cli-grp where
     3757                        cli-grp.node-code = current-gcode NO-LOCK NO-ERROR.
     3758             up-current-group = cli-grp.node-name.
     3759             PUT stream PrnLibStream
     3760             space(20) ( "По группе   : " + cli-grp.node-name ) format "x(80)" skip(0).
     3761             PUT stream PrnLibStream
     3762             space(20) ("Подгруппы :") skip(0).
     3763             FOR EACH bsj-groups WHERE
     3764                      bsj-groups.obj-code = 0:
     3765               PUT stream PrnLibStream
     3766               space(35) bsj-groups.g-name format "X(80)" SKIP.
     3767             END.
     3768         end.
     3769         when "LIST":U then do:
     3770          PUT stream PrnLibStream space(10) string("По сформированному списку карт") format "x(50)" skip.
     3771          for each dc-list no-lock:
     3772             ii = ii + 1.
     3773             PUT stream PrnLibStream unformatted
     3774             string(dc-list.d-card + chr(44) + chr(32), "X(21)") .
     3775             if ii = 9 then do:
     3776               PUT stream PrnLibStream unformatted skip.
     3777               ii = 0.
     3778             end.
     3779          end.
     3780          PUT stream PrnLibStream unformatted skip.
     3781         end.
     3782         when "ONE":U then do:
     3783             PUT stream PrnLibStream
     3784             space(20) ("По дисконтной карте N " + FixDcard) format "x(80)" skip(0).
     3785         end.
     3786     END CASE.
     3787     if t-legacy then do:
     3788       PUT stream PrnLibStream
     3789       "С учетом перевыпуска карт (указаны номера, % скидки для карт ПОСЛЕДНЕГО ВЫПУСКА," skip
     3790       "остальные суммы и количества по картам включают суммы и количества по картам предыдущих выпусков"
     3791       skip(0).
     3792     end.
     3793     if one-firm and v-curr-r-b = 'base':U then
     3794        PUT stream PrnLibStream space(49) string( "( Все цены указаны в баз.вал. )" ) format "X(40)" Skip(0).
     3795     else do:
     3796         PUT stream PrnLibStream space(49) string( "( Все цены указаны в РУБ )" ) format "X(40)" Skip(0).
     3797     end.
     3798     CASE RS-Sort:
     3799       WHEN "shop":U then do:
     3800         run SHopcycle no-error.
     3801       END.
     3802       WHEN "card":U then do:
     3803         run Cardcycle no-error.
     3804       end.
     3805       when "group":U then do:
     3806         run Groupcycle no-error.
     3807       end.
     3808       when "sum":U then do:
     3809         IF num-objs > 1 then do:
     3810           run SumCycleMulti no-error.
     3811         end.
     3812         else do:
     3813           run SUmCycleSingle no-error.
     3814         end.
     3815       end.
     3816       when "tot":U then do:
     3817         IF num-objs > 1 then do:
     3818           run TotCycleMulti no-error.
     3819         end.
     3820         else do:
     3821           run TotCycleSingle no-error.
     3822         end.
     3823       end.
     3824     END CASE.
     3825     run waitfram-hide in this-procedure .
     3826     PUT stream PrnLibStream " " SKIP.
     3827     HIDE stream PrnLibStream FRAME BottomFrame .
     3828     if Print-List-hist
     3829     and selectclient = 'card' then do:
     3830       run lhistprex-print-dc-list-hist-excel  in this-procedure (input yes, input no, 2).
     3831     end.
     3832     output stream PrnLibStream CLOSE .
     3833   run prn-lib-prn-file in this-procedure (
     3834                                             input my-handle
     3835                                             ,input 8
     3836                                             ).
     3837   end.
     3838   else
     3839   message "На выбранных Вами объектах" skip
     3840           "нет итогов по дисконтным картам" skip
     3841           "постоянных клиентов" skip
     3842           "либо объекты принадлежат нетекущей фирме"
     3843   view-as alert-box INFORMATION .
     3844   END PROCEDURE.
     3845   PROCEDURE My-var :
     3846   define variable v-base-code-0 like ub.sysconf.host-code no-undo init ?.
     3847   define variable v-base-code like ub.sysconf.host-code no-undo init ?.
     3848   assign
     3849   frame F-Main TotalOnly
     3850   frame F-Main SELECTCLIENT
     3851   frame F-Main RS-sort
     3852   frame F-Main t-legacy
     3853   .
     3854   assign
     3855   num-objs = 0
     3856   one-firm = yes.
     3857   FOR EACH obj-list :
     3858       if can-find( FIRST ub.dis-obj WHERE
     3859                          ub.dis-obj.obj-type = obj-list.obj-type AND
     3860                          ub.dis-obj.obj-code = obj-list.obj-code ) then do:
     3861          dis-obj-found = yes.
     3862          num-objs = num-objs + 1.
     3863          FIND FIRST ub.shop No-LOCK WHERE ub.Shop.obj-code = obj-list.obj-code No-ERROR.
     3864   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3865   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     3866     (input  shop.host-code
     3867     ,output v-base-code
     3868     )  .
     3869          if num-objs = 1 then do:
     3870           assign
     3871           v-base-code-0 = v-base-code
     3872           .
     3873          end.
     3874          if one-firm and NOT (v-base-code-0 = v-base-code) and num-objs > 1 then one-firm = no.
     3875       end.
     3876   end.
     3877   Assign
     3878    STR-obj-type = ''
     3879    STR-obj-code = ''
     3880    STR-obj-name = ''
     3881    STR-obj      = ''.
     3882   For each obj-list no-lock:
     3883    Assign
     3884    STR-obj-type = STR-obj-type + obj-list.obj-type + ','
     3885    STR-obj-code = STR-obj-code + String(obj-list.obj-code) + ','
     3886    STR-obj-name = STR-obj-name + obj-list.obj-name + ','
     3887    STR-obj = STR-obj +  obj-list.obj-type + '#' + string(obj-list.obj-code)  + ',' .
     3888   End.
     3889   Reportname = "ИТОГИ ПО ДИСКОНТНЫМ КАРТАМ".
     3890   ReportHeader = "Покупатели: " +
     3891                   radio-label(string(SelectClient), SelectClient:radio-buttons) + chr(10) +
     3892                   "Сортировка: " +
     3893                   radio-label(string(rs-sort), rs-sort:radio-buttons) + chr(10) +
     3894                   (if TotalOnly then totalOnly:label else "") + chr(10) +
     3895                   (if T-legacy  then t-legacy:label else "")
     3896                  .
     3897   END PROCEDURE.
     3898   PROCEDURE send-records :
