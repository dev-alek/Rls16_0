     6126   with frame X123 .
     6127   DOWN stream PrnLibStream   with frame X123.
     6128   END.
     6129   if last(Legacy-obj.obj-code) then do:
     6130     FIND FIRST sj-cards where sj-cards.d-card = ? NO-ERROR.
     6131     UNDERLINE stream PrnLibStream   ub.dis-obj.d-card   ub.dis-obj.obj-code   sj-cards.cli-name   FOR-d-pcnt   TotalSum   DiscSum   NettoSum   InstantPaySUm   CreditSum   PaySUmStr   SaldoSumStr   MustPayStr   ub.dis-obj.num-chk   With frame X123.
     6132     DOWN stream PrnLibStream   with frame X123.
     6133     if t-legacy
     6134     or t-subsid
     6135     then
     6136     DISPLAY STREAM PrnLibStream
     6137     "ИТОГО" @ dis-obj.d-card
     6138     (string(sj-cards.obj-qnty) + " карт") @ sj-cards.cli-name
     6139     ACCUM TOTAL (bsj-cards.tot) @ TotalSum
     6140     ACCUM TOTAL (bsj-cards.disc) @ DiscSum
     6141     ACCUM TOTAL (bsj-cards.netto)  @ NettoSum
     6142     ACCUM TOTAL (bsj-cards.instant-pay) @ InstantPaySum
     6143     ACCUM TOTAL (bsj-cards.credit-pay) @ CreditSum
     6144     ACCUM TOTAL (bsj-cards.num-chk) @ dis-obj.num-chk
     6145     sj-cards.pay @ PaySumStr
     6146     sj-cards.Must-pay @ MustPayStr
     6147     sj-cards.saldo @ SaldoSumStr
     6148     with frame X123 .
     6149     else
     6150     DISPLAY STREAM PrnLibStream
     6151     "ИТОГО" @ dis-obj.d-card
     6152     (string(sj-cards.obj-qnty) + " карт") @ sj-cards.cli-name
     6153     ACCUM TOTAL (dis-obj.gds-tot-base + dis-obj.sum-tot-base) @ TotalSum
     6154     ACCUM TOTAL (dis-obj.gds-dis-base + dis-obj.sum-dis-base) @ DiscSum
     6155     ACCUM TOTAL
     6156     ((dis-obj.gds-tot-base + dis-obj.sum-tot-base) -
     6157      (dis-obj.gds-dis-base + dis-obj.sum-dis-base))  @ NettoSum
     6158     ACCUM TOTAL dis-obj.pay-tot-base @ InstantPaySum
     6159     ACCUM TOTAL
     6160     ((dis-obj.gds-tot-base + dis-obj.sum-tot-base) -
     6161      (dis-obj.gds-dis-base + dis-obj.sum-dis-base) -
     6162       dis-obj.pay-tot-base) @ CreditSum
     6163     ACCUM TOTAL dis-obj.num-chk @ dis-obj.num-chk
     6164     string(sj-cards.pay,      "->>>,>>>,>>9.99") @ PaySumStr
     6165     string(sj-cards.Must-pay, "->>>,>>>,>>9.99") @ MustPayStr
