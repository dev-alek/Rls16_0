     3900   PROCEDURE shopcycle :
     3901   def buffer bsj-cards for sj-cards.
     3902   if t-legacy or t-subsid then do:
     3903     FOR EACH obj-list no-lock ,
     3904         EACH legacy-obj no-lock WHERE
     3905              legacy-obj.obj-type = obj-list.obj-type AND
     3906              legacy-obj.obj-code = obj-list.obj-code,
     3907         FIRST bsj-cards No-LOCK WHERE
     3908               bsj-cards.card-num-chr = legacy-obj.card-num-chr
     3909           AND bsj-cards.is-sum = yes
     3910         BREAK
     3911         by legacy-obj.d-card
     3912         by legacy-obj.obj-type
     3913         by legacy-obj.obj-code:
     3914       if one-firm and v-curr-r-b = 'base':U then do:
     3915   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3916   IF NOT TOTALONLY then do:
