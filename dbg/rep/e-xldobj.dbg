     3957             THEN STRING(bsj-cards.pay, "->>>,>>>,>>9.99")
     3958             ELSE "")
     3959   MustPayStr = (IF BSJ-CARDS.OBJ-QNTY >= 0
     3960             THEN STRING(bsj-cards.Must-Pay, "->>>,>>>,>>9.99")
     3961             ELSE "")
